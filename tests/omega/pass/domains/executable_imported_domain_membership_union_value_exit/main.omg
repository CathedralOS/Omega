use omega::language::std::console;

data Player {
    health: i32;
}

domain Player::Valid
requires
    self.health >= 0;

domain Player::Alive
requires
    self in Player::Valid;
    self.health > 0;

domain Player::Critical
requires
    self.health <= 5;

data Main {
    console: Console;
    player: Player;
}

machine Main::main(&mut self) {
    self.player.health = 3;

    let ok: bool = self.player in Player::Alive | Player::Critical;

    transition ok {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(215);
    }

    state bad(&mut self) {
        self.console.exit_process(216);
    }
}
