// Fact: an issued linear claim can gain a route-free label without losing its issued qualification.
// Expected exit: 0
use omega::language::core::drop;

data Claim [linear] { value: u64; }
domain Claim::Issued established by issue;
domain Claim::Label;
domain Claim::Tagged = Claim::Issued & Claim::Label;
machine Claim::drop(claim: &mut Claim) { claim.value = 0; }
machine issue(value: u64) -> Claim in Issued { Claim { value: value } }
machine consume(claim: Claim in Issued & Label) -> u64 {
    let observed: u64 = claim.value;
    drop(claim);
    observed
}
data Holder { claim: Claim in Issued; sibling: Claim in Issued; }
machine exercise(select: bool) -> u64 {
    let holder: Holder = Holder { claim: issue(29), sibling: issue(31) };
    let tagged: Claim in Tagged = holder.claim as Claim in Tagged;
    let remaining: Claim in Tagged = holder.sibling as Claim in Tagged;
    let first: u64 = consume(tagged);
    let second: u64 = consume(remaining);
    transition first == 29 && second == 31 { true -> correct() _ -> wrong() }
    machine correct() -> u64 { 60 }
    machine wrong() -> u64 { 0 }
}

machine main() crashes Trap {
    let first: u64 = exercise(true);
    let second: u64 = exercise(false);
    transition first == 60 && second == 60 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
