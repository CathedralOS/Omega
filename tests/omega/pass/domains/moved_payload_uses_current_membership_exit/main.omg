// Expected exit: 0
// Owned transport observes writes and a subsequently restored issued child.
data Cell { value: u32; }
data Box { cell: Cell; }
domain Cell::Issued established by issue;
domain Box::Tagged;
domain Cell::Tagged;
machine issue() -> Cell ensures result in Cell::Issued { Cell { value: 73 } }
machine read_issued(cell: Cell in Issued) -> u32 { cell.value ^ 0 }
machine main() crashes Trap {
    let mut whole: Box = Box { cell: issue() };
    whole.cell.value = 0;
    let moved: Box in Tagged = whole as Box in Tagged;
    let mut projected: Box = Box { cell: issue() };
    projected.cell.value = 0;
    let child: Cell in Tagged = projected.cell as Cell in Tagged;
    let mut restored: Box = Box { cell: issue() };
    restored.cell.value = 0;
    restored.cell = issue();
    let renewed: Box = restored;
    let renewed_value: u32 = read_issued(renewed.cell);
    transition moved.cell.value == 0 && child.value == 0 && renewed_value == 73 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
