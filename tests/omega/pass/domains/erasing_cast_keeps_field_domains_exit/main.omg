// Erasing a record's own issued domain does not erase a field's declared
// domain: `g.ticket` is still a `Ticket::Held`, and the copy reads the same
// ticket as `h`.
// Expected exit: 0.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine consume(t: Ticket in Ticket::Held) -> u64 { t.number }
data Holder [copy] { lead: u64; ticket: Ticket in Ticket::Held; tail: u64; }
domain Holder::Good established by wrap;
machine wrap() -> Holder in Holder::Good { Holder { lead: 5, ticket: issue(), tail: 9 } }

machine main() crashes Trap {
    let h: Holder in Holder::Good = wrap();
    let g: Holder = h as Holder;
    let seen: u64 = consume(g.ticket);
    transition seen == 17 && g.lead == 5 && g.tail == 9 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
