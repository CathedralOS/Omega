data Item [copy] {
    value: i32;
    tag: i32;
}

domain Item::Valid(item)
requires
    item.value > 0;

data Main {
    items: [Item; 2];
}

machine Main::mark_valid(item: &mut Item)
ensures
    item in Item::Valid
{
    item.value = 1;
}

machine Main::accept(item: Item)
requires
    item in Item::Valid
{
}

machine Main::identity_index(index: u64) -> u64 {
    index
}

machine Main::main(main: &mut Main) {
    let index: u64 = Main::identity_index(1);
    Main::mark_valid(&mut main.items[0]);
    main.items[index].value = 0;
    Main::accept(main.items[0]);
}

// Expected exit: 0
// The original alleged unknown index above is exactly identity_index(1).
// Execute that unchanged path and observe the still-valid disjoint element.
machine entry_start() crashes Trap {
    let main: Main = Main {
        items: [Item { value: 0, tag: 0 }, Item { value: 0, tag: 0 }]
    };
    Main::main(&mut main);
    transition main.items[0].value == 1 && main.items[1].value == 0 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
