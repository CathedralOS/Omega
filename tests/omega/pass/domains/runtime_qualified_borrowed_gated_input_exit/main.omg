domain u64::Positive(value) requires 1 <= value;

data Token { value: u64 in Positive; byte: i32; }
data Bundle { token: Token; }

// Qualification does not turn this caller-established input into fresh storage.
machine Token::read(token: &Token) -> i32 { token.byte }
machine Bundle::read(bundle: &Bundle) -> i32 { bundle.token.byte }

machine verify(token: &Token, bundle: &Bundle) crashes Trap {
    let observed: i32 = Token::read(token);
    let nested: i32 = Bundle::read(bundle);
    transition observed == 77 && nested == 78 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let token: Token = Token { value: 42, byte: 77 };
    let bundle: Bundle = Bundle { token: Token { value: 43, byte: 78 } };
    verify(&token, &bundle);
}
