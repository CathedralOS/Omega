// A domain parameterized by a const generic axis attached to a scalar:
// `domain<const Axis: u64> i64::Coord<Axis>` — `Coord<7>` and `Coord<9>`
// are distinct nominal domains over the same carrier.
domain<const Axis: u64> i64::Coord<Axis>;

machine mark(value: i64) -> i64 in Coord<7> {
    value as i64 in Coord<7>
}

machine relay(value: i64 in Coord<7>) -> i64 in Coord<7> { value }

machine choose(select_left: bool, left: i64, right: i64) -> i64 {
    let picked: i64 = match select_left {
        true -> mark(left),
        false -> mark(right)
    } as i64;
    relay(picked as i64 in Coord<7>) as i64
}

machine main() -> i64 {
    transition { _ -> choose(true, 7, 9) }
}
