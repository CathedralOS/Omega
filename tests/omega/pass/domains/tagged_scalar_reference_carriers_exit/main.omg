// Expected exit: 0
data Cell { value: u32; }
data Nested { cell: Cell; }
domain u32::Controlled;
domain u32::Label;
domain u32::Both = Controlled & Label;
domain<const Axis: u64> u32::Coordinate<Axis>;
machine read(value: &u32 in Controlled) -> u32 { value ^ 0 }
machine read_both(value: &u32 in Both) -> u32 { value ^ 0 }
machine read_coordinate(value: &u32 in Coordinate<7>) -> u32 { value ^ 0 }
machine main() crashes Trap {
    let scalar: u32 = 73;
    let direct: &u32 in Controlled = &scalar;
    let direct_value: u32 = read(direct);
    let nested: Nested = Nested { cell: Cell { value: 73 } };
    let selected: &u32 in Controlled = &nested.cell.value;
    let nested_value: u32 = read(selected);
    let both: &u32 in Both = &nested.cell.value;
    let both_value: u32 = read_both(both);
    let coordinate: &u32 in Coordinate<7> = &nested.cell.value;
    let coordinate_value: u32 = read_coordinate(coordinate);
    transition direct_value == 73 && nested_value == 73 && both_value == 73 && coordinate_value == 73 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
