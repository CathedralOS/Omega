// A write-only whole-leaf replacement discharges the incoming value's
// domain fact on the write side: `tagged.label = label` proves
// `in Utf8` against the stored value exactly as a `&mut` target would.
// `in Wrapping` fields are behaviour tags on the carrier — every value
// is already a member, no range proof owed.
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Tagged {
    label: [u8; 3] in Utf8;
}
data Policy {
    damage: i32 in Wrapping;
    count: u32 in Wrapping;
}
machine rename(tagged: &write Tagged, label: [u8; 3] in Utf8)
{
    tagged.label = label;
}
machine bump(policy: &write Policy, damage: i32 in Wrapping) {
    policy.damage = damage;
    policy.count = 1;
}
data Main {
}
machine Main::main(main: &mut Main) {
    let mut tagged: Tagged;
    let mut policy: Policy;
    rename(&write tagged, "abc");
    bump(&write policy, 7);
}
