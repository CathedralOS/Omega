data Password {
    length: i32;
    score: i32;
}

domain Password::Valid(password)
requires
    password.length > 0;

data Main {
    password: Password;
}

machine Main::accept(length: i32)
requires
    length > 0
{
}

machine Main::main(main: &mut Main)
requires
    main.password in Password::Valid
{
    main.accept(main.password.length);
}
