// RUN CANARY (exit 70). A Unit machine may promise domain membership of its
// post-state (`ensures main.name in Utf8`). The checker proves the clause on
// every normal exit and the caller imports it as checked domain evidence.
// Terminal Psi's Unit contract states scalar propositions only, so the
// post-state publication passes over the membership clause and still
// publishes the scalar guarantee beside it: `set_label`'s `main.count < 4`
// is what discharges `accept`'s requirement at the call.
//
// Exit 71 = wrong name, 72 = wrong label, 73 = wrong count.
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    name: [u8; 5] in Utf8;
    label: Buffer16;
    count: i32;
}

machine Main::set_name(main: &mut Main)
ensures
    main.name in Utf8
{
    main.name = "Alpha";
}

machine Main::set_label(main: &mut Main) crashes Trap
ensures
    main.label.storage in Utf8;
ensures
    main.count < 4
{
    let prefix: Buffer16 = Buffer16::join("[", &main.name);
    main.label = Buffer16::join(Buffer16::view(&prefix), "]");
    main.count = 3;
}

machine Main::accept(main: &mut Main)
requires
    main.count < 4
{
    main.count = main.count + 1;
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    Main::set_name(main);
    Main::set_label(main);
    Main::accept(main);

    transition main.name == "Alpha" {
        true -> check_label(main)
        _ -> bad_name(main)
    }

    state bad_name(main: &mut Main) {
        Console::exit_process(71);
    }

    state check_label(main: &mut Main) {
        transition Buffer16::equal(&main.label, "[Alpha]") {
            true -> check_count(main)
            _ -> bad_label(main)
        }
    }

    state bad_label(main: &mut Main) {
        Console::exit_process(72);
    }

    state check_count(main: &mut Main) {
        transition main.count == 4 {
            true -> good(main)
            _ -> bad_count(main)
        }
    }

    state bad_count(main: &mut Main) {
        Console::exit_process(73);
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }
}

// Qualification applies to actual storage; live-prefix validity is checked separately.
data Buffer16 [copy] where used <= 16 { storage: [u8; 16] in Utf8; used: u64; }
machine Buffer16::view(buffer: &Buffer16) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine Buffer16::equal(buffer: &Buffer16, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = Buffer16::view(buffer);
    bytes == expected
}

machine Buffer16::copy(storage: &mut [u8; 16], bytes: &[u8], start: u64)
requires start <= 16; bytes.len <= 16 - start {
    transition { _ -> copying(storage, bytes, start, 0) }
    state copying(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index <= 16 {
        transition index < bytes.len && start + index < 16 {
            true -> writing(storage, bytes, start, index)
            _ -> done()
        }
    }
    state writing(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index < 16; index < bytes.len; start + index < 16 {
        storage[start + index] = bytes[index];
        transition { _ -> copying(storage, bytes, start, index + 1) }
    }
    state done() {}
}
machine Buffer16::join(left: &[u8], right: &[u8]) -> Buffer16 crashes Trap {
    transition left.len <= 16 && right.len <= 16 - left.len {
        true -> joining(left, right)
        false -> bad()
    }
    state joining(left: &[u8], right: &[u8]) -> Buffer16
    requires left.len <= 16; right.len <= 16 - left.len {
        let mut storage: [u8; 16];
        Buffer16::copy(&mut storage, left, 0);
        Buffer16::copy(&mut storage, right, left.len);
        let total: u64 = left.len + right.len;
        transition valid_utf8(&storage) && total <= 16 {
            true -> checked(storage, total)
            false -> bad()
        }
    }
    state checked(storage: [u8; 16] in Utf8, total: u64) -> Buffer16
    requires total <= 16 { Buffer16 { storage: storage, used: total } }
    state bad() { crash Trap; }
}
