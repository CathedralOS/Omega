// RUN CANARY (exit 70). A Unit machine may promise domain membership of its
// post-state (`ensures main.name in Utf8`). The checker proves the clause on
// every normal exit and the caller imports it as checked domain evidence.
// Terminal Psi's Unit contract states scalar propositions only, so the
// post-state publication passes over the membership clause and still
// publishes the scalar guarantee beside it: `set_label`'s `main.count < 4`
// is what discharges `accept`'s requirement at the call.
//
// Exit 71 = wrong name, 72 = wrong label, 73 = wrong count.
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    name: [u8; 5] in Utf8;
    label: [u8; 16] in Utf8;
    count: i32;
}

machine Main::set_name(main: &mut Main)
ensures
    main.name in Utf8
{
    main.name = "Alpha";
}

machine Main::set_label(main: &mut Main)
ensures
    main.label in Utf8;
ensures
    main.count < 4
{
    main.label = "[" + main.name + "]";
    main.count = 3;
}

machine Main::accept(main: &mut Main)
requires
    main.count < 4
{
    main.count = main.count + 1;
}

machine Main::main(main: &mut Main) reaches Console {
    Main::set_name(main);
    Main::set_label(main);
    Main::accept(main);

    transition main.name == "Alpha" {
        true -> check_label(main)
        _ -> bad_name(main)
    }

    state bad_name(main: &mut Main) {
        main.console.exit_process(71);
    }

    state check_label(main: &mut Main) {
        transition main.label == "[Alpha]" {
            true -> check_count(main)
            _ -> bad_label(main)
        }
    }

    state bad_label(main: &mut Main) {
        main.console.exit_process(72);
    }

    state check_count(main: &mut Main) {
        transition main.count == 4 {
            true -> good(main)
            _ -> bad_count(main)
        }
    }

    state bad_count(main: &mut Main) {
        main.console.exit_process(73);
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }
}
