// RUN CANARY (exit 70). A Unit machine may promise domain membership of its
// post-state (`ensures self.name in Utf8`). The checker proves the clause on
// every normal exit and the caller imports it as checked domain evidence.
// Terminal Psi's Unit contract states scalar propositions only, so the
// post-state publication passes over the membership clause and still
// publishes the scalar guarantee beside it: `set_label`'s `self.count < 4`
// is what discharges `accept`'s requirement at the call.
//
// Exit 71 = wrong name, 72 = wrong label, 73 = wrong count.
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    name: [u8; 5] in Utf8;
    label: [u8; 16] in Utf8;
    count: i32;
}

machine Main::set_name(&mut self)
ensures
    self.name in Utf8
{
    self.name = "Alpha";
}

machine Main::set_label(&mut self)
ensures
    self.label in Utf8;
ensures
    self.count < 4
{
    self.label = "[" + self.name + "]";
    self.count = 3;
}

machine Main::accept(&mut self)
requires
    self.count < 4
{
    self.count = self.count + 1;
}

machine Main::main(&mut self) reaches Console {
    self.set_name();
    self.set_label();
    self.accept();

    transition self.name == "Alpha" {
        true -> check_label()
        _ -> bad_name()
    }

    state bad_name(&mut self) {
        self.console.exit_process(71);
    }

    state check_label(&mut self) {
        transition self.label == "[Alpha]" {
            true -> check_count()
            _ -> bad_label()
        }
    }

    state bad_label(&mut self) {
        self.console.exit_process(72);
    }

    state check_count(&mut self) {
        transition self.count == 4 {
            true -> good()
            _ -> bad_count()
        }
    }

    state bad_count(&mut self) {
        self.console.exit_process(73);
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
}
