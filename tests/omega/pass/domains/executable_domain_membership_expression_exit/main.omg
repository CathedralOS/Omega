use omega_language_std::console;

data Player {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    console: Console;
    alive: Player;
    fallen: Player;
}

machine Main::main(&mut self) {
    self.alive.health = 10;
    self.fallen.health = 0;

    transition (self.alive in Player::Alive, self.fallen in Player::Alive) {
        (true, false) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(81);
    }

    state bad(&mut self) {
        self.console.exit_process(82);
    }
}
