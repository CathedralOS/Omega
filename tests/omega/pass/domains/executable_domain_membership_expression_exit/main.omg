use omega_language_std::console;

data Player {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    alive: Player;
    fallen: Player;
}

machine Main::main(main: &mut Main) reaches Console {
    main.alive.health = 10;
    main.fallen.health = 0;

    transition (main.alive in Player::Alive, main.fallen in Player::Alive) {
        (true, false) -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(81);
    }

    state bad(main: &mut Main) {
        Console::exit_process(82);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
