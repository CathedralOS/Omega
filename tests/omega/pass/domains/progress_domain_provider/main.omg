// A domain declares its progress profile and grant route:
// `domain SchedulerHandle::WeakFair satisfies ProgressProfile
// established by Scheduler::grant` — the boundary's `-> SchedulerHandle
// in WeakFair` return issues the admission token qualified; each
// target body implements the requirement via its own foreign route
// (`ForeignBinding::Syscall(1)` / `VtableField(notify)`).
use omega::language::core::binding;
// The opaque receipt has a native wire carrier; only the grant route
// establishes WeakFair membership.
pub data SchedulerHandle [copy] { identity: u64; }
pub domain SchedulerHandle::WeakFair
satisfies ProgressProfile
established by Scheduler::grant;
pub boundary trait Scheduler {
    machine notify(value: i32)
    terminates;
    machine grant(provider: &SchedulerProvider, handle: SchedulerHandle) -> SchedulerHandle in WeakFair;
}
pub data SchedulerProvider { grant: addr; notify: addr; }
linux_x86_64 machine SchedulerProvider::notify(value: i32)
satisfies Scheduler::notify
via ForeignBinding::Syscall(1);
linux_x86_64 machine SchedulerProvider::grant(provider: &SchedulerProvider, handle: SchedulerHandle) -> SchedulerHandle in WeakFair
satisfies Scheduler::grant
via ForeignBinding::VtableField(grant);
data Main {
}
machine Main::main(main: &mut Main) { }
