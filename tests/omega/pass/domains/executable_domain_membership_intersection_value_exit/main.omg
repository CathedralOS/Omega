use omega_language_std::console;
use omega::language::core::binding;

data Password {
    length: i32;
    score: i32;
}

domain Password::Valid
requires
    self.length > 0;

domain Password::Secure
requires
    self.score >= 8;

data Main {
    console: Binding<Console>;
    password: Password;
}

machine Main::main(&mut self) reaches Console {
    self.password.length = 12;
    self.password.score = 10;

    let ok: bool = self.password in Password::Valid & Password::Secure;

    transition ok {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(233);
    }

    state bad(&mut self) {
        self.console.exit_process(234);
    }
}
