// A private nested machine reached only under a caller guard owes the guard's
// fact on every arrival; here its single arrival is guarded by `value > 0`, so
// the qualification cast inside it proves `Positive`. Both arms run: 4 takes
// the qualified path and -2 the fallback, so a swapped arm traps.
// Expected exit: 0
domain i32::Positive requires self > 0;

machine guarded(value: i32) -> i32 {
    transition value > 0 { true -> positive(value) false -> empty() }
    machine positive(value: i32) -> i32 { (value as i32 in Positive) as i32 }
    machine empty() -> i32 { 0 }
}

machine main() crashes Trap {
    let taken: i32 = guarded(4);
    let fallback: i32 = guarded(-2);
    transition taken == 4 && fallback == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
