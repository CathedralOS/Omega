// Declaring a domain operator does NOT replace ordinary integer `+`. No
// declaration, mint, or signature `requires` selects `i32::Degrees` for
// `value`, so the builtin scalar addition stays selected (evidence records a
// builtin fallback). Flow proof state is irrelevant to this choice.

domain i32::Degrees
requires
    self >= 0;

machine + i32::Degrees::add(left: i32, right: i32) -> i32 {
    ((left as i32 in Wrapping) + (right as i32 in Wrapping)) as i32
}

data Main {
}

machine Main::rotate(&self, value: i32 in Wrapping, delta: i32 in Wrapping) {
    let sum: i32 in Wrapping = value + delta;
}

machine Main::main(&mut self) {
}
