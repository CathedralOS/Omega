// Expected exit: 0.
// Selected copyable payloads preserve whole and nested memberships into
// ordinary state arrivals, whether the sum came from a parameter or a call.
data Range [copy] { start: u64; length: u64; }
domain Range::Nonempty(range) requires range.length > 0;
data Outcome { case Ready(range: Range in Nonempty); case Rejected; }
data Wrapper [copy] { range: Range in Nonempty; }
data Nested { case Ready(wrapper: Wrapper); case Rejected; }

machine classify(range: Range) -> Outcome {
    transition range.length > 0 {
        true -> Outcome::Ready { range: range }
        _ -> Outcome::Rejected
    }
}
machine observe(range: Range in Nonempty) -> u64 { range.length - 1 }
machine inspect(range: Range) -> u64 {
    transition classify(range) {
        Outcome::Ready { range } -> consume(range)
        Outcome::Rejected -> 0
    }
    machine consume(range: Range in Nonempty) -> u64 { range.length - 1 }
}
machine inspect_parameter(outcome: Outcome) -> u64 {
    transition outcome {
        Outcome::Ready { range } -> consume(range)
        Outcome::Rejected -> 0
    }
    machine consume(range: Range in Nonempty) -> u64 { range.length - 1 }
}
machine nest(range: Range in Nonempty) -> Nested {
    Nested::Ready { wrapper: Wrapper { range: range } }
}
machine inspect_nested(nested: Nested) -> u64 {
    transition nested {
        Nested::Ready { wrapper } -> consume(wrapper)
        Nested::Rejected -> 0
    }
    machine consume(wrapper: Wrapper) -> u64 { observe(wrapper.range) }
}
machine main() crashes Trap {
    let first: u64 = inspect(Range { start: 17, length: 3 });
    let second: u64 = inspect_parameter(classify(Range { start: 19, length: 5 }));
    let third: u64 = inspect_nested(nest(Range { start: 23, length: 7 }));
    let rejected: u64 = inspect(Range { start: 29, length: 0 });
    transition first == 2 && second == 4 && third == 6 && rejected == 0 {
        true -> done() _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
