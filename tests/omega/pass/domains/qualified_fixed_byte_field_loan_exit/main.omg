// Expected exit: 0
data Frame { prefix: u8; bytes: [u8; 4]; suffix: u8; }
domain [u8; 4]::Pinned;
machine consume(bytes: &[u8; 4] in Pinned) -> u32 {
    transition bytes.len == 4 && bytes[0] == 11 && bytes[3] == 44 {
        true -> 0
        _ -> 1
    }
}
machine main() crashes Trap {
    let frame: Frame = Frame { prefix: 7, bytes: [11, 22, 33, 44], suffix: 9 };
    let selected: &[u8; 4] in Pinned = &frame.bytes;
    let result: u32 = consume(selected);
    transition result == 0 && frame.prefix == 7 && frame.suffix == 9 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
