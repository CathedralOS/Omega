// A domain-owned binary operator meaning discharged at the use site:
// `machine + Quantity::Additive::add` requires its right operand
// `in Quantity::Additive`, and the caller's comma-list requires
// (`a in ..., b in ...`) proves both the domain's operand premise and
// the operator's instantiated contract.
data Quantity {
    value: i32;
}
domain Quantity::Additive
requires
    self.value >= 0;
machine + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity
requires
    right in Quantity::Additive
{
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}
machine combine(a: Quantity, b: Quantity)
requires
    a in Quantity::Additive,
    b in Quantity::Additive
{
    let sum: Quantity = a + b;
}

data Main {}
machine Main::main(main: &mut Main) { }
