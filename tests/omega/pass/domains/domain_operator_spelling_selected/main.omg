// A domain-selected operator (chapter 8). The `Quantity::Additive` domain
// classifies `Quantity` values whose `value` field is non-negative, and binds
// the `+` spelling to a single `add` meaning for `(Quantity, Quantity)`. Because
// no competing domain meaning exists for that spelling + operand types over the
// same target type, the meaning is uniquely selectable and must compile.

data Quantity {
    value: i32;
}

domain Quantity::Additive
requires
    self.value >= 0;

machine + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity {
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}

data Main {
}

machine Main::main(&mut self) {
}
