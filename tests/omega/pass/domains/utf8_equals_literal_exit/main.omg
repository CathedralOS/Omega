// RUN CANARY (exit 70). #66: a `&[u8] in Utf8` value `==` a string literal is
// CONTENT equality, lowered through the SAME TextEquals leaf String uses (length
// + bounded byte loop) -- NOT a scalar compare of the descriptor's pointer words.
// `classify("quit")` matches "quit" and exits 70. A `&[u8] in Utf8` view shares
// String's identical 16-byte `{ptr, len}` descriptor, so the text leaf applies
// once the slice-descriptor place is recognized as text-comparable.
// (Counter-variant: passing "look" takes the `_` arm and exits 71 -- proving the
// compare reads genuine content, not an always-true descriptor-word match.)
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
}

machine Main::classify(main: &Main, text: &[u8] in Utf8) reaches Console {
    transition text == "quit" {
        true -> finished(main)
        _ -> other(main)
    }

    state finished(main: &Main) { Console::exit_process(70); }
    state other(main: &Main) { Console::exit_process(71); }
}

machine Main::main(main: &mut Main) {
    Main::classify(main, "quit");
}
