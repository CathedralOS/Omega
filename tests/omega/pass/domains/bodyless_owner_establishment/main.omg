// P1b: a checked conformance may establish a routed qualification only through
// the exact trait requirement named by the domain. The call-result fact must
// follow the returned value into the local so the next call can consume it.

data Token {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token
    ensures
        result in Token::Issued;
}

machine Token::issue(value: u64) -> Token
satisfies TokenIssuer::issue
ensures
    result in Token::Issued
{
    Token { value: value }
}

data Main {
}

machine Main::consume(&self, token: Token in Issued) {
}

// A constrained bodyless parameter is an implicit call requirement and an
// entry fact in the callee. Forwarding must retain the owner's evidence rather
// than treating the matching runtime carrier as sufficient.
machine Main::forward(&self, token: Token in Issued) {
    self.consume(token);
}

machine Main::main(&mut self) {
    let token: Token = Token::issue(7);
    self.forward(token);
}
