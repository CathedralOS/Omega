// RUN CANARY (exit 70). A record literal assigned to a record field through
// an exclusive receiver constructs all operands before whole replacement:
// each quoted `&[u8] in Utf8` member contributes an image-backed descriptor,
// and each scalar contributes its computed value. The second
// literal names its members in reverse declaration order. Both records are
// read back through their stored descriptors and scalars, and both texts are
// written out. exits: 71 = left record wrong; 72 = right record wrong.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Tag {
    label: &[u8] in Utf8;
    weight: i32;
}

data Main {
    left: Tag;
    right: Tag;
}

machine Main::main(main: &mut Main) reaches Console {
    main.left = Tag { label: "amulet", weight: 3 };
    main.right = Tag { weight: 4, label: "ring" };
    Console::write_line(main.left.label);
    Console::write_line(main.right.label);
    transition main.left.label == "amulet" && main.left.weight == 3 {
        true -> right_record(main)
        _ -> wrong_left(main)
    }

    machine right_record(main: &mut Main) {
        transition main.right.label == "ring" && main.right.weight == 4 {
            true -> good(main)
            _ -> wrong_right(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine wrong_left(main: &mut Main) {
        Console::exit_process(71);
    }

    machine wrong_right(main: &mut Main) {
        Console::exit_process(72);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
