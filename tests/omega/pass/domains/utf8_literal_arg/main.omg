// #66 B1: a string literal passed to a `&[u8] in Utf8` parameter. The literal is
// valid UTF-8 by construction, so it should satisfy the param's `in Utf8` domain.
domain [u8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;
data Main {
    console: Console;
}
machine Main::consume(&self, text: &[u8] in Utf8) {
}
machine Main::main(&mut self) {
    self.consume("hi");
}
