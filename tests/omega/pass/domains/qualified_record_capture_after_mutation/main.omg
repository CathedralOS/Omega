data Handle { value: u64; changed: u64; }
domain Handle::Open(handle) requires handle.value != 0 established by issue_handle;
machine replace(value: &mut u64) -> u64 ensures value == 1 {
    value = 1;
    0
}
machine issue_handle() -> Handle in Open {
    let mut value: u64 = 0;
    Handle { changed: replace(&mut value), value: value }
}
