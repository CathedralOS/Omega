// Expected exit: 0
// Both spellings select one shared structural return; neither evaluates an
// unselected operand, and covered payloads are observations, not copies.
data Choice { case Stop; case First(payload: u64); case Second; }
data Packet { value: u64; }
machine argument(counter: &mut u64) -> u64 {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    counter
}
machine produce(counter: &mut u64, value: u64) -> Packet {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Packet { value: value }
}
machine selected_value(choice: &Choice, bodies: &mut u64, operands: &mut u64) -> Packet {
    transition choice {
        Choice::Stop -> (Packet { value: 0 })
        _ -> (produce(bodies, argument(operands)))
    }
}
machine selected_call(choice: &Choice, bodies: &mut u64, operands: &mut u64) -> Packet {
    transition choice {
        Choice::Stop -> (Packet { value: 0 })
        _ -> produce(bodies, argument(operands))
    }
}
machine main() crashes Trap {
    let stop: Choice = Choice::Stop;
    let first: Choice = Choice::First { payload: 97 };
    let second: Choice = Choice::Second;
    let mut bodies: u64 = 0;
    let mut operands: u64 = 0;
    let skipped_value: Packet = selected_value(&stop, &mut bodies, &mut operands);
    let first_value: Packet = selected_value(&first, &mut bodies, &mut operands);
    let second_value: Packet = selected_value(&second, &mut bodies, &mut operands);
    let skipped_call: Packet = selected_call(&stop, &mut bodies, &mut operands);
    let first_call: Packet = selected_call(&first, &mut bodies, &mut operands);
    let second_call: Packet = selected_call(&second, &mut bodies, &mut operands);
    transition skipped_value.value == 0 && first_value.value == 1 && second_value.value == 2
        && skipped_call.value == 0 && first_call.value == 3 && second_call.value == 4
        && bodies == 4 && operands == 4 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
