// A state body sequences ordinary calls before its terminal transition:
// `seed` runs a store and a machine call, then dispatches on the computed
// value — control flow and computation interleave freely inside a state.
data Main { answer: u64; }

machine Main::bump(value: u64) -> u64
requires value <= 10
{
    value + 1
}

machine Main::main(main: &mut Main) {
    transition 1 {
        1 -> seed(main)
        _ -> miss(main)
    }

    machine seed(main: &mut Main) {
        let grown: u64 = Main::bump(4);
        transition grown {
            5 -> done(main)
            _ -> miss(main)
        }
    }

    machine done(main: &mut Main) { main.answer = 70; }
    machine miss(main: &mut Main) { main.answer = 71; }
}
