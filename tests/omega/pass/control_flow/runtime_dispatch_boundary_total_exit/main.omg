// Complete dispatches retain their terminal results; later dispatch work
// cannot execute before them. Expected exit: 0; empty output in both engines.
data Node { value: u64; }
data Choice [copy] { case First; case Second; }
machine mark(node: &mut Node) -> bool { node.value = 99; true }
machine identity(take: bool) -> bool { take }
machine choose(take: bool, node: &mut Node) -> u64 crashes Trap {
    transition take { true -> (70) false -> (71) }
    transition mark(node) { true -> (72) false -> (73) }
    crash Trap;
}
machine generic<T [copy]>(value: T, take: bool) -> T crashes Trap {
    transition take { true -> (value) false -> (value) }
    crash Trap;
}
machine tuple(first: bool, second: bool) -> u64 crashes Trap {
    transition (first, second) {
        (true, _) -> seventy()
        (false, true) -> seventy_one()
        (false, false) -> seventy_two()
    }
    crash Trap;
    machine seventy() -> u64 { 70 }
    machine seventy_one() -> u64 { 71 }
    machine seventy_two() -> u64 { 72 }
}
machine computed(take: bool) -> u64 crashes Trap {
    transition identity(take) { true -> (70) false -> (71) }
    crash Trap;
}
machine case_result(choice: Choice) -> u64 crashes Trap {
    transition choice {
        Choice::First -> seventy()
        Choice::Second -> seventy_one()
    }
    crash Trap;
    machine seventy() -> u64 { 70 }
    machine seventy_one() -> u64 { 71 }
}
machine reference(node: &mut Node, take: bool) -> &mut Node crashes Trap {
    transition take { true -> (node) false -> first_failure(node) }
    machine first_failure(node: &mut Node) -> &mut Node { transition { _ -> failed(node) } }
    machine failed(node: &mut Node) -> &mut Node {
        crash Trap;
        let inactive: u64 = 7;
        node
    }
}
machine main() crashes Trap {
    let mut node: Node = Node { value: 7 };
    let first: u64 = choose(true, &mut node);
    let second: u64 = choose(false, &mut node);
    let copied: u64 = generic(70, false);
    let combined: u64 = tuple(false, false);
    let from_call: u64 = computed(false);
    let from_case: u64 = case_result(Choice::Second);
    let returned: &mut Node = reference(&mut node, true);
    let from_reference: u64 = returned.value;
    transition first == 70 && second == 71 && copied == 70 && combined == 72
        && from_call == 71 && from_case == 71 && from_reference == 7 && node.value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
