use omega::language::core::float_operations;
use omega_language_std::console;

data Sample32 { case Reading(value: f32); case Empty; }
data Sample64 { case Reading(value: f64); case Empty; }
data Context32 { sample: Sample32; }
data Context64 { sample: Sample64; }
data Main { }

machine read32(context: &Context32) -> bool {
    transition context.sample {
        Sample32::Reading { value } -> check(value)
        Sample32::Empty -> (false)
    }
    state check(value: f32) -> bool { value == 2.5 }
}
machine read64(context: &Context64) -> bool {
    transition context.sample {
        Sample64::Reading { value } -> check(value)
        Sample64::Empty -> (false)
    }
    state check(value: f64) -> bool { value == -3.75 }
}
machine Main::main(main: &mut Main) reaches Console {
    let first_context: Context32 = Context32 { sample: Sample32::Reading { value: 2.5 } };
    let second_context: Context64 = Context64 { sample: Sample64::Reading { value: -3.75 } };
    let first: bool = read32(&first_context);
    let second: bool = read64(&second_context);
    transition first && second {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
