use omega_language_std::console;

data Tag [copy] { case Empty; case First; case Second; }
data Slot [copy] { prefix: u64; tag: Tag; suffix: u32; }
data Main { slots: [Slot; 3]; }

// The view transports a descriptor; membership observes the selected element,
// including its field offset, not the pointer/length words of that descriptor.
machine matches(slots: &[Slot], position: u64, expected: Tag) -> bool {
    transition position < slots.len {
        true -> observe(slots, position, expected)
        false -> false
    }
    state observe(slots: &[Slot], position: u64, expected: Tag) -> bool {
        let same: bool = slots[position].tag == expected;
        (same)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.slots[0].prefix = 17;
    main.slots[0].tag = Tag::First;
    main.slots[1].prefix = 29;
    main.slots[1].tag = Tag::Second;
    let view: &[Slot] = &main.slots[..];
    let first: bool = matches(view, 0, Tag::First);
    let different: bool = matches(view, 1, Tag::First);
    let tail: &[Slot] = view[1..];
    let shifted: bool = matches(tail, 0, Tag::Second);
    let zero: bool = matches(tail, 1, Tag::Empty);
    transition first && !different && shifted && zero {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
