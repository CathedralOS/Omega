domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::service;
data CommandKind {
    case Quit;
    case Look;
    case Invalid;
}

data Command {
    kind: CommandKind;
}

data Main {
    console: Service<Console>;
    command: Command;
}

machine Main::result_code(&mut self) -> i32 reaches Console {
    self.command.kind = CommandKind::Look;

    transition self.command.kind {
        CommandKind::Look -> look()
        CommandKind::Quit -> quit()
        _ -> invalid()
    }
    

    state look(&mut self) {
        self.console.write_line("look");
        0
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        0
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        1
    }
}

machine Main::main(&mut self) reaches Console {
    let result: i32 = self.result_code();
    self.console.exit_process(result);
}
