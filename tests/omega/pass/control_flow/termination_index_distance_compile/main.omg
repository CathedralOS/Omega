data Main {
}

machine Main::main(main: &mut Main) {
    _ = Main::evaluate(main);
}

machine Main::evaluate(main: &mut Main) -> u64 {
    transition {
        _ -> Main::walk(main, 4, 0)
    }
}

machine Main::walk(main: &mut Main, limit: u64, index: u64)
terminates by (index, limit) -> Nat::BoundedDistance;
-> u64
{
    transition index < limit {
        true -> walk(main, limit, index + 1)
        false -> index
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
