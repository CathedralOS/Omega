// A case arm's `if` guard is evaluated after the case pattern binds: a
// `Count{c}` arm guarded by `c > 10` falls through to the `_` arm when the
// payload is small. Guards filter inside one case without splitting it.
data Step {
    case Count(count: u64);
    case Idle;
}

data Main {
    step: Step;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.step = Step::Count { count: 4 };
    transition main.step {
        Step::Count { count } if count > 10 -> big(main)
        _ -> small(main)
    }

    machine big(main: &mut Main) { main.answer = 70; }
    machine small(main: &mut Main) { main.answer = 71; }
}
