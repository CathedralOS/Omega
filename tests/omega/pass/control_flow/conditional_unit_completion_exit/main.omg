use omega_language_std::console;

data Output { value: i32; }
data Payload { value: i32; }

machine select(stop: bool, output: &mut Output) {
    output.value = 5;
    let payload: Payload = Payload { value: 7 };
    transition stop {
        true -> {}
        false -> write(output, payload)
    }
    machine write(output: &mut Output, payload: Payload) {
        output.value = payload.value;
    }
}

data Main {
    stopped: Output;
    continued: Output;
}

machine Main::main(main: &mut Main) reaches Console {
    select(true, &mut main.stopped);
    select(false, &mut main.continued);
    transition main.stopped.value == 5 && main.continued.value == 7 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
