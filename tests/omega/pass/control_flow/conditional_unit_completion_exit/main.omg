use omega_language_std::console;

data Output { value: i32; }
data Payload { value: i32; }

machine select(stop: bool, output: &mut Output) {
    output.value = 5;
    let payload: Payload = Payload { value: 7 };
    transition stop {
        true -> {}
        false -> write(output, payload)
    }
    state write(output: &mut Output, payload: Payload) {
        output.value = payload.value;
    }
}

data Main {
    stopped: Output;
    continued: Output;
}

machine Main::main(main: &mut Main) reaches Console {
    select(true, &mut main.stopped);
    select(false, &mut main.continued);
    transition main.stopped.value == 5 && main.continued.value == 7 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
