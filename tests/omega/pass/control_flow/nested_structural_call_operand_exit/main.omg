use omega_language_std::console;

data Pair [copy] {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
}

data Owned {
    value: i32 in Wrapping;
}

data Counter {
    calls: i32 in Wrapping;
}

data Main {
    counter: Counter;
    seeds: Counter;
    total: i32 in Wrapping;
}

machine Main::shift(counter: &mut Counter, pair: Pair, by: i32 in Wrapping) -> Pair {
    counter.calls = counter.calls + 1;
    Pair { a: pair.a + by, b: pair.b + by }
}

machine Main::seed(counter: &mut Counter, value: i32 in Wrapping) -> i32 in Wrapping {
    counter.calls = counter.calls + 1;
    value
}

machine Main::own(counter: &mut Counter, value: i32 in Wrapping) -> Owned {
    counter.calls = counter.calls + 1;
    Owned { value: value }
}

machine Main::settle(counter: &mut Counter, owned: Owned) -> Pair {
    counter.calls = counter.calls + 1;
    Pair { a: owned.value, b: owned.value + 2 }
}

machine Main::main(context: &mut Main) reaches Console {
    context.counter.calls = 0;
    context.seeds.calls = 0;
    context.total = 0;
    transition { _ -> body(context) }

    state body(context: &mut Main) {
        let p: Pair = Main::shift(&mut context.counter, Pair { a: 1, b: 2 }, 10);
        let q: Pair = Main::shift(&mut context.counter, Pair { a: Main::seed(&mut context.seeds, 3), b: 2 }, 5);
        let s: Pair = Main::settle(&mut context.counter, Owned { value: 7 });
        context.total = p.a + p.b + q.a + q.b + s.a + s.b;
        transition { _ -> finish((context.total + context.counter.calls + context.seeds.calls) as i32, context) }
    }

    state finish(code: i32, context: &mut Main) {
        Console::exit_process(code);
    }
}
