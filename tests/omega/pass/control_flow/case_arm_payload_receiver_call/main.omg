// Reproducer: `transition subject { Case { p } -> (p.method()) }` — a method call
// on an arm-bound payload inside the transition's result expression. The
// payload is itself a union (the Squalr ScanResultsResponse shape), so the
// arm result needs custody/binding rows that name the arm binder, and the
// payload's own case dispatch must lower under that borrowed receiver.
// Exits 70 only when the payload receiver call lowers and dispatches.

use omega_language_std::console;

data Payload {
    case Leaf(value: u64);
    case Empty;
}

machine Payload::read(payload: &Payload) -> u64 {
    transition payload {
        Payload::Leaf { value } -> (value)
        Payload::Empty -> (0)
    }
}

data Sum {
    case Found(p: Payload);
    case Missing;
}

machine Sum::probe(sum: &Sum) -> u64 {
    transition sum {
        Sum::Found { p } -> (Payload::read(&p))
        Sum::Missing -> (0)
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let s: Sum = Sum::Found { p: Payload::Leaf { value: 70 } };

    transition Sum::probe(&s) == 70 {
        true -> done(main)
        _ -> missed(main)
    }

    machine done(main: &mut Main) {
        Console::exit_process(70);
    }

    machine missed(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
