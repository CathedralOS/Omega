// A case dispatch on a FIELD subject with three or more named-case arms and
// no authored `_`. This omitted at `state graph: terminator: unsupported
// tail: transition chain` until 2026-09-27, taking
// `samples/cli/basics/brightness_control` with it.
//
// ALL THREE conditions had to hold at once, and removing any one made the
// identical program check, so a guard that keeps only some of them guards
// nothing:
//
//   the subject is a FIELD place        (a local subject always checked)
//   THREE OR MORE named-case arms       (two always checked)
//   no authored `_` arm                 (adding one always checked)
//
// Measured NOT to matter, in both directions, so do not "simplify" them away:
// payload bindings, arithmetic in an arm target, which arm carries a payload,
// being the machine body's tail, a constant versus a dynamic subject, the
// sum's case count on its own, and whether the arms share one successor.
//
// The `reaches Console` here and the `Build::bind(builder, ...ProgramEntry...)` lines
// in `build.omg` are equally load-bearing: a machine with no terminal effect
// demands no unit plan, so this program would check VACUOUSLY without them.
use omega_language_std::console;

data Command {
    case A;
    case B;
    case C;
}

data Main {
    command: Command;
}

machine Main::main(main: &mut Main) reaches Console {
    main.command = Command::A;

    transition main.command {
        Command::A -> done(main)
        Command::B -> done(main)
        Command::C -> done(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }
}
