use omega_language_std::console;

data Kind [copy] { case First; case Second; }
data Item [copy] { kind: Kind; value: u64; }
data Output { kind: Kind; value: u64; }
data Main { items: [Item; 2]; output: Output; }

machine select(items: &[Item], index: u64, output: &mut Output)
{
    transition index < items.len {
        true -> write(items[index], output)
        false -> {}
    }
    state write(item: Item, output: &mut Output) {
        output.kind = item.kind;
        output.value = item.value;
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Item { kind: Kind::First, value: 11 };
    main.items[1] = Item { kind: Kind::Second, value: 22 };
    let entries: &[Item] = &main.items[..];
    select(entries, 1, &mut main.output);
    // An unselected edge must not evaluate its out-of-bounds copy.
    select(entries, 99, &mut main.output);
    transition main.output.kind {
        Kind::First -> finish(main, 1)
        Kind::Second -> check_value(main)
    }
    state check_value(main: &mut Main) {
        transition main.output.value == 22 {
            true -> finish(main, 70)
            false -> finish(main, 2)
        }
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
