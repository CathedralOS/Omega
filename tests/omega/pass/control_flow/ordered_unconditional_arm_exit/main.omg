// The first unconditional arm ends selection. Earlier guards still execute;
// later guards and destinations must not, including an effectful operand.
use omega_language_std::console;

data Main { calls: u32 in Wrapping; }

machine observed(main: &mut Main) -> i32 {
    main.calls = main.calls + 1;
    99
}

machine Main::main(main: &mut Main) reaches Console {
    main.calls = 0;
    transition { _ -> guarded(main) _ -> bad(main) }

    state guarded(main: &mut Main) {
        transition {
            main.calls == 1 -> bad(main)
            main.calls == 2 -> bad(main)
            _ -> verify(main)
            _ -> skipped(observed(main), main)
        }
    }
    state verify(main: &mut Main) {
        transition main.calls == 0 { true -> good(main) _ -> bad(main) }
    }
    state skipped(value: i32, main: &mut Main) { Console::exit_process(value); }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
