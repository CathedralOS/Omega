// `transition` arms mix signs freely: an `i32` subject dispatches
// negative, positive, and wildcard arms in one list — the literal's sign
// is part of the arm's identity.
data Main {
    level: i32;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.level = 0 - 2;
    transition main.level {
        -2 -> below(main)
        3 -> above(main)
        _ -> even(main)
    }

    machine below(main: &mut Main) { main.answer = 70; }
    machine above(main: &mut Main) { main.answer = 71; }
    machine even(main: &mut Main) { main.answer = 72; }
}
