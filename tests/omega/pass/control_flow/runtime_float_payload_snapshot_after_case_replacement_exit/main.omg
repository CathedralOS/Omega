use omega::language::core::float_operations;
use omega_language_std::console;

data Sample { case Reading(value: f64); case Empty; }
data Context { sample: Sample; }
data Main { }

machine clear(context: &mut Context) -> bool {
    context.sample = Sample::Empty {};
    true
}

machine compare(value: f64, cleared: bool) -> bool {
    value == 2.5 && cleared
}

machine read(context: &mut Context) -> bool
requires context.sample in Sample::Reading;
{
    // The first operand copies the payload before the second replaces its
    // source. The detached scalar keeps its value without retaining a loan.
    compare(context.sample.value, clear(context))
}

machine Main::main(main: &mut Main) reaches Console {
    let mut context: Context = Context { sample: Sample::Reading { value: 2.5 } };
    let correct: bool = (context.sample in Sample::Reading) && read(&mut context);
    transition correct {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
