// A computed case-dispatch subject is evaluated once, before arm selection.
// `Main::pick` counts its calls and returns the case its argument selects.
// Every arm's guard and the selected arm's payload read that one result, so
// the first dispatch (first arm selected) and the second dispatch (second arm
// selected) each add exactly one call. Native and interpreter both exit 70;
// exit 2 or 3 exposes a repeated evaluation, 4 a wrong payload, and 71 a
// wrong arm.
use omega_language_std::console;

data Pick {
    case First(v: i32);
    case Second(v: i32);
}

data Main { calls: u32 in Wrapping; }

machine Main::pick(main: &mut Main, second: bool) -> Pick {
    main.calls = main.calls + 1;
    transition second {
        true -> (Pick::Second { v: 20 })
        _ -> (Pick::First { v: 10 })
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.calls = 0;
    transition Main::pick(main, false) {
        Pick::First { v } -> first(main, v)
        Pick::Second { .. } -> wrong_arm(main)
    }
    state first(main: &mut Main, v: i32) {
        transition main.calls {
            1 -> first_payload(main, v)
            2 -> exit_two(main)
            _ -> exit_three(main)
        }
    }
    state first_payload(main: &mut Main, v: i32) {
        transition v == 10 { true -> again(main) _ -> wrong_payload(main) }
    }
    state again(main: &mut Main) {
        transition Main::pick(main, true) {
            Pick::First { .. } -> wrong_arm(main)
            Pick::Second { v } -> second(main, v)
        }
    }
    state second(main: &mut Main, v: i32) {
        transition main.calls {
            2 -> second_payload(main, v)
            3 -> exit_two(main)
            _ -> exit_three(main)
        }
    }
    state second_payload(main: &mut Main, v: i32) {
        transition v == 20 { true -> good(main) _ -> wrong_payload(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state exit_two(main: &mut Main) { Console::exit_process(2); }
    state exit_three(main: &mut Main) { Console::exit_process(3); }
    state wrong_payload(main: &mut Main) { Console::exit_process(4); }
    state wrong_arm(main: &mut Main) { Console::exit_process(71); }
}
