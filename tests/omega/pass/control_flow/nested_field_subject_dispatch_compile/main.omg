// `transition` subjects project as deep as member paths go:
// `main.outer.inner.count` evaluates the nested field once and dispatches —
// no need to bind each level into a local first.
data Inner { count: u64; }

data Outer { inner: Inner; }

data Main {
    outer: Outer;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.outer = Outer { inner: Inner { count: 7 } };
    transition main.outer.inner.count {
        7 -> lucky(main)
        _ -> plain(main)
    }

    machine lucky(main: &mut Main) { main.answer = 70; }
    machine plain(main: &mut Main) { main.answer = 71; }
}
