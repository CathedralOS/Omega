// The dispatch subject stays readable inside the selected arm: `transition
// main.count` evaluates the field once, then the arm forwards the same
// field to its target state — the subject isn't consumed by matching.
data Main {
    count: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.count = 3;
    transition main.count {
        3 -> three(main, main.count)
        _ -> other(main)
    }

    machine three(main: &mut Main, kept: u64) { main.answer = kept; }
    machine other(main: &mut Main) { main.answer = 0; }
}
