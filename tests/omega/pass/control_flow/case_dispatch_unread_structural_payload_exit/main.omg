// A case dispatch over an owned call result whose other case carries a
// structural payload. `FillResult::Failed` holds a `FillError` sum, the
// `IoResult::Error { kind: ErrorKind }` shape of the std filesystem results;
// `FillResult::Filled` holds a primitive count. The `Filled` arm forwards its
// count into a scalar successor parameter, and the `Failed` arm binds `kind`
// without reading it. The dispatch disposes the whole result on every arm, so
// the unread structural payload needs no separate cleanup.
//
// `first` fills a four-byte local array and takes the `Filled` arm with count
// 4; `second` asks for nine bytes and takes the `Failed` arm. Exits 70 only
// when the forwarded count, the passed tally and the filled byte all arrive.

use omega_language_std::console;

data FillError {
    case Other;
    case Short;
}

data FillResult {
    case Failed(kind: FillError);
    case Filled(count: u64);
}

data Main {
    head: u8;
}

machine fill(bytes: &mut [u8], wanted: u64) -> FillResult {
    transition bytes.len >= 4 && wanted <= bytes.len {
        true -> write(bytes, wanted)
        _ -> refuse()
    }
    state write(bytes: &mut [u8], wanted: u64) -> FillResult {
        bytes[0] = 70;
        FillResult::Filled { count: wanted }
    }
    state refuse() -> FillResult {
        FillResult::Failed { kind: FillError::Short }
    }
}

machine Main::main(context: &mut Main) reaches Console {
    let passed: i32 in Wrapping = 0;
    transition { _ -> first(context, passed) }

    state first(context: &mut Main, passed: i32 in Wrapping) {
        let mut buffer: [u8; 4];
        let next_passed: i32 in Wrapping = passed + 1;
        let outcome: FillResult = fill(&mut buffer, 4);
        context.head = buffer[0];
        transition outcome {
            FillResult::Filled { count } -> second(context, next_passed, count)
            _ -> done(context, 71)
        }
    }

    state second(context: &mut Main, passed: i32 in Wrapping, filled: u64) {
        let mut buffer: [u8; 4];
        let next_passed: i32 in Wrapping = passed + 1;
        let outcome: FillResult = fill(&mut buffer, 9);
        transition outcome {
            FillResult::Filled { count } -> done(context, 72)
            FillResult::Failed { kind } -> verify(context, next_passed, filled)
        }
    }

    state verify(context: &mut Main, passed: i32 in Wrapping, filled: u64) {
        transition passed == 2 && filled == 4 && context.head == 70 {
            true -> done(context, 70)
            _ -> done(context, 73)
        }
    }

    state done(context: &mut Main, code: i32) { Console::exit_process(code); }
}
