// `transition` arms may carry negative signed literals: `-1 ->` matches a
// subject holding minus one and selects beside non-negative arms. Signed
// subjects and signed literals share the same value space.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let reading: i64 = 0 - 1;
    transition reading {
        -1 -> frozen(main)
        0 -> zero(main)
        _ -> warm(main)
    }

    machine frozen(main: &mut Main) { main.answer = 70; }
    machine zero(main: &mut Main) { main.answer = 71; }
    machine warm(main: &mut Main) { main.answer = 72; }
}
