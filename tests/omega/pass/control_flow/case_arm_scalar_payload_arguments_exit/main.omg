// Arm-bound payload scalars as successor arguments: `Case { p } ->
// target(p, ...)` arms mint scalar expression rows for their bound payload
// fields so the successor's scalar-argument guard admits them — alongside
// literal actuals, on both the machine's own receiver sum (the api
// `at(response, position)` shape) and a call-produced local subject (the
// cli `got_line(count, false)` shape). An arm may forward one binding to
// several parameters: each parameter then reads the same payload field, on
// a borrowed subject and on a local one. Exits 70 only when every arm's
// payload scalars arrive at their named states.

use omega_language_std::console;

data NextToken {
    case Token(start: u64, end: u64);
    case End;
}

// Self-subject scalar payload arm: the receiver sum binds `start`/`end` and
// forwards both through a named state, `end` twice.
machine NextToken::span(next_token: &NextToken) -> u64 {
    transition next_token {
        NextToken::Token { start, end } -> at(start, end, end)
        _ -> (0)
    }
    state at(start: u64, end: u64, again: u64) -> u64 {
        transition end == again {
            true -> (again)
            _ -> (0)
        }
    }
}

data LineRead {
    case LineComplete(count: u64);
    case EndOfInput(count: u64);
    case Empty;
}

data Main {
}

machine next_token() -> NextToken {
    transition { _ -> (NextToken::Token { start: 2, end: 3 }) }
}

machine line_read() -> LineRead {
    transition { _ -> (LineRead::LineComplete { count: 30 }) }
}

machine Main::main(main: &mut Main) reaches Console {
    let root: NextToken = next_token();
    transition root {
        NextToken::Token { start, end } -> root_token(main, start, end, start)
        _ -> refused(main)
    }

    state root_token(main: &mut Main, start: u64, end: u64, again: u64) {
        transition start == 2 && end == 3 && again == 2 {
            true -> attached(main)
            _ -> refused(main)
        }
    }
    state attached(main: &mut Main) {
        let token: NextToken = NextToken::Token { start: 5, end: 7 };
        transition NextToken::span(&token) == 7 {
            true -> read_line(main)
            _ -> refused(main)
        }
    }
    state read_line(main: &mut Main) {
        let result: LineRead = line_read();
        transition result {
            LineRead::LineComplete { count } -> got_line(main, count, false)
            LineRead::EndOfInput { count } -> got_line(main, count, true)
            _ -> refused(main)
        }
    }
    state got_line(main: &mut Main, count: u64, end_after: bool) {
        transition end_after {
            true -> refused(main)
            false -> check_count(main, count)
        }
    }
    state check_count(main: &mut Main, count: u64) {
        transition count == 30 {
            true -> done(main)
            _ -> refused(main)
        }
    }
    state done(main: &mut Main) {
        Console::exit_process(70);
    }
    state refused(main: &mut Main) {
        Console::exit_process(71);
    }
}
