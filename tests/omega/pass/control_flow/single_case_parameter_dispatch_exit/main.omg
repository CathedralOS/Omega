// A transition over a one-case sum selects its sole case without testing the
// tag: a dispatch over n cases needs n - 1 tests. Each owned parameter shape
// reaches that dispatch through its own home. A payload-less sum and a
// register-carried payload sum are copied into an activation-local home; a
// sum wider than the register ABI is observed through the address of its
// argument copy. The case edge still loads every payload it binds.
// Exits 70 when 30 + 30 + 10 arrive.
use omega_language_std::console;

data Only [copy] {
    case Sole;
}

data Carried [copy] {
    case Value(handle: u64 in Wrapping);
}

data Wide {
    case Four(first: u64 in Wrapping, second: u64 in Wrapping, third: u64 in Wrapping, fourth: u64 in Wrapping);
}

data Main {
}

machine Only::code(only: Only) -> u64 in Wrapping {
    transition only {
        Only::Sole -> value(30)
    }

    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

machine Carried::code(carried: Carried) -> u64 in Wrapping {
    transition carried {
        Carried::Value { handle } -> value(handle)
    }

    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

machine Wide::code(wide: Wide) -> u64 in Wrapping {
    transition wide {
        Wide::Four { first, second, third, fourth } -> value(first + second + third + fourth)
    }

    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let first: u64 in Wrapping = Only::code(Only::Sole);
    let carried: Carried = Carried::Value { handle: 30 };
    let second: u64 in Wrapping = Carried::code(carried);
    let wide: Wide = Wide::Four { first: 1, second: 2, third: 3, fourth: 4 };
    let third: u64 in Wrapping = Wide::code(wide);
    transition first + second + third == 70 {
        true -> done(main, 70)
        _ -> done(main, 71)
    }

    machine done(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
