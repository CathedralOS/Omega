use omega_language_std::console;

data Output { value: u64; }
data Main { output: Output; }

machine fallback(output: &mut Output, first: bool, second: bool) {
    transition {
        first -> one(output)
        second -> two(output)
        _ -> {}
    }
    state one(output: &mut Output) { output.value = 11; }
    state two(output: &mut Output) { output.value = 22; }
}

machine middle(output: &mut Output, first: bool, second: bool) {
    transition {
        first -> one(output)
        second -> {}
        _ -> two(output)
    }
    state one(output: &mut Output) { output.value = 11; }
    state two(output: &mut Output) { output.value = 22; }
}

machine Main::main(main: &mut Main) reaches Console {
    main.output.value = 7;
    fallback(&mut main.output, false, false);
    let unchanged_fallback: bool = main.output.value == 7;
    fallback(&mut main.output, true, true);
    let first_wins: bool = main.output.value == 11;
    fallback(&mut main.output, false, true);
    let second_runs: bool = main.output.value == 22;
    middle(&mut main.output, false, true);
    let unchanged_middle: bool = main.output.value == 22;
    middle(&mut main.output, true, true);
    let first_before_unit: bool = main.output.value == 11;
    middle(&mut main.output, false, false);
    let fallback_runs: bool = main.output.value == 22;
    transition unchanged_fallback && first_wins && second_runs
        && unchanged_middle && first_before_unit && fallback_runs {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
