// `transition` arms match narrow unsigned literals: a `u8` subject
// dispatches on `200` — literal arms carry their own width, so narrow
// members need no widening step.
data Main {
    tag: u8;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.tag = 200;
    transition main.tag {
        200 -> high(main)
        _ -> other(main)
    }

    machine high(main: &mut Main) { main.answer = 70; }
    machine other(main: &mut Main) { main.answer = 71; }
}
