// Renamed namespace, later-state storage, and shared whole-array presentation.
// An uninitialized local can be lent once for initialization.
data Tally { total: u64; }

machine Workshop::main() crashes Trap {
    transition { _ -> prepare() }
    machine prepare() {
        let tally: Tally;
        let cells: [u8; 16];
        transition { _ -> fill(&mut tally, &cells) }
    }
    machine fill(tally: &mut Tally, cells: &[u8]) {
        tally.total = 91;
        transition tally.total == 91 && cells.len == 16 {
            true -> done()
            false -> failed()
        }
    }
    machine done() {}
    machine failed() { crash Trap; }
}
