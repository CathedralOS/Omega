// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_later_state_shared_array_loan");
    builder.roots.bind(windows_x86_64::ProgramEntry, Workshop::main);
    builder.roots.bind(linux_x86_64::ProgramEntry, Workshop::main);
    builder.roots.bind(linux_arm64::ProgramEntry, Workshop::main);
    builder.roots.bind(macos_arm64::ProgramEntry, Workshop::main);
}
