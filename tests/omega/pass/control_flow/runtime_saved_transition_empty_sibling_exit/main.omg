// Expected exit: 0. Both linear payloads leave one evaluated provider result.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Extracted<Value> { case Moved(storage: Token, value: Value, padding: [u8; 0]); }
data Returned<Value> { storage: Token; value: Value; }
boundary trait Extract<Value> {
    machine take(storage: Token, value: Value) -> Extracted<Value> reaches;
}
Provider satisfies Extract<Token> {
    machine take(storage: Token, value: Token) -> Extracted<Token> {
        Extracted::Moved { storage: storage, value: value, padding: [] }
    }
}
machine extract<Value>(storage: Token, value: Value) -> Returned<Value> reaches Extract {
    transition Extract<Value>::take(storage, value) {
        Extracted::Moved { storage, value, padding as _ } -> Returned { storage: storage, value: value }
    }
}
machine main() reaches Extract crashes Trap {
    let returned: Returned<Token> = extract<Token>(Token { value: 17 }, Token { value: 29 });
    let correct: bool = returned.storage.value == 17 && returned.value.value == 29;
    drop(returned.storage);
    drop(returned.value);
    transition correct { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
