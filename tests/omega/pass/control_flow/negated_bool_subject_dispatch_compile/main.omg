// A `transition` subject may negate a bool member: `!main.flag` computes
// the inverse in place — unary operators work in subjects like any other
// expression position.
data Main {
    flag: bool;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.flag = false;
    transition !main.flag {
        true -> inverted(main)
        _ -> kept(main)
    }

    machine inverted(main: &mut Main) { main.answer = 70; }
    machine kept(main: &mut Main) { main.answer = 71; }
}
