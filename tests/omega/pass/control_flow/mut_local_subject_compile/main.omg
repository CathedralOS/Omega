// A `transition` subject may read a `let mut` local after rebinding:
// `x = 9` then `transition x` — the current value dispatches, not the
// initializer's.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let mut x: u64 = 1;
    x = 9;
    transition x {
        9 -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { main.answer = 70; }
    state bad(main: &mut Main) { main.answer = 71; }
}
