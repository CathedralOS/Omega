use omega_language_std::console;

data Main {
    console: Console;
    number: i32;
    flag: bool;
}

machine Main::main(&mut self) {
    self.number = 2;
    self.flag = false;

    let number_ok: bool = self.number == 2;
    let flag_ok: bool = self.flag == false;
    let ok: bool = number_ok && flag_ok;

    transition ok {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(76);
    }

    state bad(&mut self) {
        self.console.exit_process(77);
    }
}
