// PASS canary: a guarded transition roster of 3+ arms where every arm
// produces a structural value — `transition pick { 0 -> (..), 1 -> (..),
// _ -> (..) }`. The composed state-graph terminator routes guarded rosters
// through `returns::guarded`, which already admits `Value` targets on
// `When` and `Always` arms; this fixture exercises the whole chain so the
// roster cannot silently fall back to the Jump-only guarded-roster arm.
//
// The arms spell guards as `subject == literal` patterns (the transition
// subject `counter.n` compared to each integer literal), matching the same
// guarded-roster desugar the corpus' guarded_jump fixtures use. A
// comparison written as a *pattern* (e.g. `counter.n < 4 -> ..`) would bind
// `subject == (counter.n < 4)` — an ill-typed nested equality — which is a
// pattern-grammar spelling distinction, not a state-graph admission wall.

use omega_language_std::console;
use omega::language::core::binding;

data Msg {
    case Small(v: i32);
    case Mid(v: i32);
    case Big(v: i32);
}

data Counter {
    n: i32;
}

machine Counter::pick(counter: &mut Counter) -> Msg {
    transition counter.n > 0 {
        true -> choose(counter)
        _ -> choose(counter)
    }

    state choose(counter: &mut Counter) -> Msg {
        transition counter.n {
            0 -> (Msg::Small { v: counter.n })
            1 -> (Msg::Mid { v: counter.n + 10 })
            _ -> (Msg::Big { v: counter.n })
        }
    }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut counter: Counter = Counter { n: 1 };

    transition Counter::pick(&mut counter) {
        Msg::Small { v } -> small(main, v)
        Msg::Mid { v } -> mid(main, v)
        Msg::Big { v } -> big(main, v)
    }

    state small(main: &mut Main, v: i32) {
        main.console.exit_process(v);
    }

    state mid(main: &mut Main, v: i32) {
        main.console.exit_process(v);
    }

    state big(main: &mut Main, v: i32) {
        main.console.exit_process(v);
    }
}
