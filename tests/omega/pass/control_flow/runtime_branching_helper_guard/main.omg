data Main {
}

machine Main::main(&mut self) {
    let flag: bool = true;

    let picked: bool = self.pick(flag);
    transition picked == true {
        true -> done()
        false -> done()
    }
    


    state done(&mut self) {}
}

machine Main::pick(&mut self, flag: bool) -> bool {
    transition flag {
        true -> true
        false -> false
    }
    
}
