// A `transition` subject may compare a bool member to a literal:
// `main.flag == false` — bool equality composes in subjects like
// numeric comparisons.
data Main {
    flag: bool;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.flag = false;
    transition main.flag == false {
        true -> clear(main)
        _ -> set(main)
    }

    machine clear(main: &mut Main) { main.answer = 70; }
    machine set(main: &mut Main) { main.answer = 71; }
}
