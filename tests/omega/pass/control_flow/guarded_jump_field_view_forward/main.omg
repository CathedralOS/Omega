data LineBuf {
    case Active(text: [u8; 512]);
    case Empty;
    case Closed;
}

data Score {
    value: u64;
}

machine Main::main() {
    let mut line_buffer: [u8; 512];
    let cells: [u8; 512];
    let buf: LineBuf = LineBuf::Empty;
    let mut score: Score = Score { value: 0 };
    transition { _ -> begin(&mut score, &mut line_buffer, &cells, &buf, 8) }
    machine begin(score: &mut Score, line: &mut [u8], cells: &[u8; 512], buf: &LineBuf, count: u64) {
        transition buf {
            LineBuf::Active { text } -> parse(score, line, cells, &text[0..count])
            LineBuf::Empty -> empty(score, line)
            _ -> wrong(score)
        }
    }
    machine parse(score: &mut Score, line: &mut [u8], cells: &[u8; 512], text: &[u8]) {
        transition text.len {
            text.len == 0 -> empty(score, line)
            text.len < 8 -> take(score, line, &cells[0..8])
            _ -> wrong(score)
        }
    }
    machine take(score: &mut Score, line: &mut [u8], whole: &[u8]) {
        transition whole.len >= 8 { true -> good(score) _ -> wrong(score) }
    }
    machine empty(score: &mut Score, line: &mut [u8]) {
        transition { _ -> good(score) }
    }
    machine good(score: &mut Score) {
        score.value = 70;
    }
    machine wrong(score: &mut Score) {
        score.value = 71;
    }
}
