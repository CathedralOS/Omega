data LineBuf {
    case Active(text: [u8; 512]);
    case Empty;
    case Closed;
}

data Main {
    line_buffer: [u8; 512];
    cells: [u8; 512];
    buf: LineBuf;
    score: u64;
}

machine Main::main(&mut self) {
    self.buf = LineBuf::Empty;
    self.score = 0;
    transition { _ -> begin(&mut self, &mut self.line_buffer, &self.buf, 8) }
    state begin(main: &mut Main, line: &mut [u8], buf: &LineBuf, count: u64) {
        transition buf {
            LineBuf::Active { text } -> parse(main, line, &text[0..count])
            LineBuf::Empty -> empty(main, line)
            _ -> wrong(main)
        }
    }
    state parse(main: &mut Main, line: &mut [u8], text: &[u8]) {
        transition text.len {
            text.len == 0 -> empty(main, line)
            text.len < 8 -> take(main, line, &main.cells[0..8])
            _ -> wrong(main)
        }
    }
    state take(main: &mut Main, line: &mut [u8], whole: &[u8]) {
        transition whole.len >= 8 { true -> good(main) _ -> wrong(main) }
    }
    state empty(main: &mut Main, line: &mut [u8]) {
        transition { _ -> good(main) }
    }
    state good(main: &mut Main) {
        main.score = 70;
    }
    state wrong(main: &mut Main) {
        main.score = 71;
    }
}
