// Expected exit: 0. One saved dispatch subject owns both selected linear fields.
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Extracted<Value> {
    case Moved(storage: Token, value: Value);
    case Held(storage: Token, value: Value);
}
data Returned<Value> { storage: Token; value: Value; }

machine produce<Value>(storage: Token, value: Value, moved: bool,
    calls: &mut u64 in Wrapping) -> Extracted<Value>
{
    calls = calls + 1;
    transition moved {
        true -> Extracted::Moved { storage: storage, value: value }
        false -> Extracted::Held { storage: storage, value: value }
    }
}
boundary trait Extract<Value> {
    machine take(storage: Token, value: Value, calls: &mut u64 in Wrapping)
        -> Extracted<Value> reaches;
}
Provider satisfies Extract<Token> {
    machine take(storage: Token, value: Token, calls: &mut u64 in Wrapping)
        -> Extracted<Token>
    {
        produce<Token>(storage, value, true, calls)
    }
}
machine extract<Value>(storage: Token, value: Value, calls: &mut u64 in Wrapping)
    -> Returned<Value> reaches Extract
{
    transition Extract<Value>::take(storage, value, calls) {
        Extracted::Moved { storage, value } -> Returned { storage: storage, value: value }
        Extracted::Held { storage, value } -> Returned { storage: storage, value: value }
    }
}
machine extract_later(storage: Token, value: Token, calls: &mut u64 in Wrapping)
    -> Returned<Token>
{
    transition { _ -> later(storage, value, calls) }
    state later(storage: Token, value: Token, calls: &mut u64 in Wrapping) -> Returned<Token> {
        transition produce<Token>(storage, value, false, calls) {
            Extracted::Moved { storage, value } -> Returned { storage: storage, value: value }
            Extracted::Held { storage, value } -> Returned { storage: storage, value: value }
        }
    }
}
machine tick(calls: &mut u64 in Wrapping) -> u64 in Wrapping {
    calls = calls + 1;
    calls
}
machine scalar(calls: &mut u64 in Wrapping) -> bool {
    transition tick(calls) == 3 { true -> true false -> false }
}
machine main() reaches Extract crashes Trap {
    let mut calls: u64 in Wrapping = 0;
    let first: Returned<Token> = extract<Token>(Token { value: 17 }, Token { value: 29 }, &mut calls);
    let second: Returned<Token> = extract_later(Token { value: 31 }, Token { value: 43 }, &mut calls);
    let correct: bool = first.storage.value == 17 && first.value.value == 29
        && second.storage.value == 31 && second.value.value == 43
        && scalar(&mut calls) && calls == 3;
    drop(first.storage);
    drop(first.value);
    drop(second.storage);
    drop(second.value);
    transition correct { true -> {} false -> bad() }
    state bad() { crash Trap; }
}
