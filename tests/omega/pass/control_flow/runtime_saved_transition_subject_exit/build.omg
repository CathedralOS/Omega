machine build(builder: &mut Build) {
    Build::application(builder, "saved_transition_subject");
    Build::accept_boundary<Extract>(builder);
    Build::select_provider<Extract, Provider>(builder, linux_arm64);
    Build::select_provider<Extract, Provider>(builder, linux_x86_64);
    Build::select_provider<Extract, Provider>(builder, macos_arm64);
    Build::select_provider<Extract, Provider>(builder, macos_x86_64);
    Build::select_provider<Extract, Provider>(builder, windows_x86_64);
    Build::select_provider<Extract, Provider>(builder, uefi_x86_64);
    Build::select_provider<Extract, Provider>(builder, cross_platform_cli);
    Build::select_provider<Extract, Provider>(builder, local_unchecked);
    Build::select_provider<Extract, Provider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
