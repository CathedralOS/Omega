// A case arm may rename its payload binding and guard on the renamed name:
// `Count{count as c} if c > 10` binds `c`, tests it, and falls to the next
// arm when the guard fails. Renaming and guarding compose in one arm.
data Step {
    case Count(count: u64);
    case Idle;
}

data Main {
    step: Step;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.step = Step::Count { count: 42 };
    transition main.step {
        Step::Count { count as c } if c > 10 -> big(main, c)
        Step::Idle -> idle(main)
        _ -> small(main)
    }

    machine big(main: &mut Main, captured: u64) { main.answer = captured; }
    machine idle(main: &mut Main) { main.answer = 70; }
    machine small(main: &mut Main) { main.answer = 71; }
}
