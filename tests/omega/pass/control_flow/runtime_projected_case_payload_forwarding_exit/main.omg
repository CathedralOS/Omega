use omega_language_std::console;

data Pair { case Both(a: u64 in Wrapping, b: u64 in Wrapping); }
data Reading [copy] { case Full(value: u64 in Wrapping); case Empty; }
data Holder {
    marker: u64 in Wrapping;
    first: Pair;
    second: Pair;
    readings: [Reading; 2];
}
data Main { }

machine read_pair(holder: &Holder) -> u64 in Wrapping {
    transition holder.second {
        Pair::Both { a, b } -> add(holder, a, b)
    }
    state add(holder: &Holder, a: u64 in Wrapping, b: u64 in Wrapping) -> u64 in Wrapping {
        holder.marker + a + b
    }
}
machine read_array(holder: &Holder) -> u64 in Wrapping {
    transition holder.readings[1] {
        Reading::Full { value } -> result(value)
        Reading::Empty -> (1)
    }
    state result(value: u64 in Wrapping) -> u64 in Wrapping { value }
}
machine Main::main(main: &mut Main) reaches Console {
    let holder: Holder = Holder {
        marker: 10,
        first: Pair::Both { a: 1, b: 2 },
        second: Pair::Both { a: 20, b: 30 },
        readings: [Reading::Empty {}, Reading::Full { value: 10 }]
    };
    let pair: u64 in Wrapping = read_pair(&holder);
    let array: u64 in Wrapping = read_array(&holder);
    transition pair + array == 70 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
