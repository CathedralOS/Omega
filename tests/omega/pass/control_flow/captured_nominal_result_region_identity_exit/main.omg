// Nominal result arguments retain callable regions, including repeated and permuted ones.
// Expected exit: 0
data Cell { value: u64; }
data Message<'payload> {
    stamp: u64;
    case Missing;
    case Received(cell: &'payload Cell);
}
data Pair<'first, 'second> {
    stamp: u64;
    case Missing;
    case Received(left: &'first Cell, right: &'second Cell);
}
machine returned<'loan>(cell: &'loan Cell) -> Message<'loan> {
    Message::Received { stamp: 73, cell: cell }
}
machine permuted<'left, 'right>(left: &'left Cell, right: &'right Cell) -> Pair<'right, 'left> {
    Pair::Received { stamp: 41, left: right, right: left }
}
machine repeated<'loan>(cell: &'loan Cell) -> Pair<'loan, 'loan> {
    Pair::Received { stamp: 29, left: cell, right: cell }
}
machine observe_one(cell: &Cell) -> u64 {
    transition returned(cell) {
        Message::Missing { stamp, .. } -> stamp
        Message::Received { stamp, .. } -> stamp
    }
}
machine observe_permuted(left: &Cell, right: &Cell) -> u64 {
    transition permuted(left, right) {
        Pair::Missing { stamp, .. } -> stamp
        Pair::Received { stamp, .. } -> stamp
    }
}
machine observe_repeated(cell: &Cell) -> u64 {
    transition repeated(cell) {
        Pair::Missing { stamp, .. } -> stamp
        Pair::Received { stamp, .. } -> stamp
    }
}
machine main() crashes Trap {
    let left: Cell = Cell { value: 19 };
    let right: Cell = Cell { value: 23 };
    transition observe_one(&left) == 73
        && observe_permuted(&left, &right) == 41
        && observe_repeated(&right) == 29 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
