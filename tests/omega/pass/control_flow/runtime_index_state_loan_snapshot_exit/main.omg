data Cell [copy] { value:u32 in Wrapping; }
data Cursor where position < 2 { position:u64; calls:u32 in Wrapping; }
machine select(cursor:&mut Cursor)->u64 ensures result < 2 {
 let chosen:u64=cursor.position;
 cursor.calls=cursor.calls+1;
 cursor.position=1;
 chosen
}
machine mark(cell:&mut Cell,amount:u32 in Wrapping)->u32 in Wrapping {
 cell.value=cell.value+amount;
 cell.value
}
machine observe(value:u32 in Wrapping,cell:&Cell,cursor:&Cursor)->u32 in Wrapping {
 value*100+cell.value*10+cursor.calls
}
machine report(value:u32 in Wrapping,cursor:&Cursor)->u32 in Wrapping {
 value*100+cursor.calls*10
}
machine pack(prefix:u32 in Wrapping,value:u32 in Wrapping)->u32 in Wrapping {prefix*10000+value}
machine advance(cursor:&mut Cursor)->u32 in Wrapping {cursor.calls=cursor.calls+10;cursor.position=1;99}
machine update(cells:&[Cell;2],cursor:&mut Cursor)->u32 in Wrapping {
 transition {_ -> audit(&cells[select(cursor)],advance(cursor))}
 machine audit(cell:&Cell,ignored:u32 in Wrapping)->u32 in Wrapping {cell.value*100+ignored}
}
machine main() crashes Trap {
 let mut cells:[Cell;2]=[Cell{value:7},Cell{value:3}];
 let mut cursor:Cursor=Cursor{position:0,calls:0};
 let observed:u32 in Wrapping=update(&cells,&mut cursor);
 transition observed==799 && cells[0].value==7 && cells[1].value==3 && cursor.calls==11 && cursor.position==1 {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
