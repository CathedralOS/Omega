data Sample { value: u64; }
data Reply {
    case Values(first: Sample, second: Sample, extra: u64);
    case Empty;
}

machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}

machine combine(first: u64, order: u64, second: u64, extra: u64) -> u64 {
    (((first as u64 in Wrapping) * 1000)
        + ((order as u64 in Wrapping) * 100)
        + ((second as u64 in Wrapping) * 10)
        + (extra as u64 in Wrapping)) as u64
}

machine read(reply: Reply, count: &mut u64) -> u64 {
    transition reply {
        Reply::Values { first, second, extra } ->
            combine(first.value, tick(count), second.value, extra)
        Reply::Empty -> 0
    }
}

machine forward(reply: Reply) -> Reply { reply }

// The computed subject has no named source-owner exit row. Its temporary
// still lives until the selected returning call finishes its observations.
machine read_computed(reply: Reply, count: &mut u64) -> u64 {
    transition forward(reply) {
        Reply::Values { first, second, extra } ->
            combine(first.value, tick(count), second.value, extra)
        Reply::Empty -> 0
    }
}

machine main() crashes Trap {
    let mut count: u64 = 0;
    let result: u64 = read(Reply::Values {
        second: Sample { value: 2 },
        extra: 5,
        first: Sample { value: 1 }
    }, &mut count);
    let empty: u64 = read(Reply::Empty, &mut count);
    let computed: u64 = read_computed(Reply::Values {
        first: Sample { value: 1 },
        second: Sample { value: 2 },
        extra: 5
    }, &mut count);
    let computed_empty: u64 = read_computed(Reply::Empty, &mut count);
    transition result == 1125 && empty == 0
        && computed == 1225 && computed_empty == 0 && count == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
