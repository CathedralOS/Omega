// A `transition` subject may compare two elements of one array:
// `main.cells[0] > main.cells[1]` — index projections compose inside
// relational subjects.
data Main {
    cells: [u64; 2];
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.cells = [8, 3];
    transition main.cells[0] > main.cells[1] {
        true -> leads(main)
        _ -> trails(main)
    }

    machine leads(main: &mut Main) { main.answer = 70; }
    machine trails(main: &mut Main) { main.answer = 71; }
}
