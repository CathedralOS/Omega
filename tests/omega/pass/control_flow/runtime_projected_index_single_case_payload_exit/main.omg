use omega_language_std::console;

data Pair { case Both(a: u64 in Wrapping, b: u64 in Wrapping); }
data Main where selected <= 1 {
    items: [Pair; 2];
    selected: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Pair::Both { a: 1, b: 2 };
    main.items[1] = Pair::Both { a: 30, b: 40 };
    main.selected = 1;
    transition main.items[main.selected] {
        Pair::Both { a, b } -> total(main, a + b)
    }
    machine total(main: &mut Main, value: u64 in Wrapping) {
        transition value == 70 {
            true -> good(main)
            false -> bad(main)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
