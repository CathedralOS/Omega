use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Binding<Console>;
    left: bool;
    right: bool;
}

machine Main::main(&mut self) reaches Console {
    self.left = true;
    self.right = false;

    transition {
        _ -> check()
    }

    state check(&mut self) {
        let ok: bool = self.left || self.right;

        transition ok {
            (true) -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(251);
    }

    state bad(&mut self) {
        self.console.exit_process(252);
    }
}
