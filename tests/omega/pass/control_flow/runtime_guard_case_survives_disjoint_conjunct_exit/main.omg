use omega_language_std::console;

data Sample { case Reading(value: u64); case Empty; }
data Main { }

machine mark(flag: &mut bool) -> bool {
    flag = true;
    true
}

machine read(sample: Sample, flag: &mut bool) -> u64 {
    // The second conjunct writes only `flag`. The first conjunct's selected
    // case of `sample` survives guard completion and licenses the read.
    transition (sample in Sample::Reading) && mark(flag) {
        true -> (sample.value)
        false -> (0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut flag: bool = false;
    let value: u64 = read(Sample::Reading { value: 69 }, &mut flag);
    transition value == 69 && flag {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
