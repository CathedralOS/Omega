// A computed record-pattern subject is captured once before arm dispatch.
// `make` increments `calls`; reading both x and y must use that one captured
// Point, not evaluate the call once per extracted field. `[copy]` is the
// current eligibility fence for extracting fields from a non-place subject.
// Native and interpreter both exit 70; exit 2/3 exposes repeated evaluation.
use omega_language_std::console;
data Point [copy] { x: i32; y: i32; }
data Main { calls: u32 in Wrapping; }

machine Main::make(main: &mut Main) -> Point {
    main.calls = main.calls + 1;
    transition { _ -> Point { x: 30, y: 40 } }
}

machine Main::main(main: &mut Main) reaches Console {
    main.calls = 0;
    transition Main::make(main) {
        Point { x, y } -> check(main, x, y)
        _ -> bad(main)
    }
    state check(main: &mut Main, x: i32, y: i32) {
        transition main.calls {
            1 -> check_values(main, x, y)
            2 -> exit_two(main)
            3 -> exit_three(main)
            _ -> bad(main)
        }
    }
    state check_values(main: &mut Main, x: i32, y: i32) {
        transition x == 30 && y == 40 { true -> good(main) _ -> exit_values(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state exit_two(main: &mut Main) { Console::exit_process(2); }
    state exit_three(main: &mut Main) { Console::exit_process(3); }
    state exit_values(main: &mut Main) { Console::exit_process(4); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
