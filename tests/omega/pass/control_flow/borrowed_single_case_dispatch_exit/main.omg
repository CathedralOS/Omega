// A transition over a borrowed one-case sum selects its sole case without
// testing the tag, as an owned subject does: the case edge binds the payload
// the arm forwards and the loan stays the caller's. Exits 70 when 30 + 40
// arrive.
use omega_language_std::console;

data Pair {
    case Both(a: u64 in Wrapping, b: u64 in Wrapping);
}

machine Pair::code(pair: &Pair) -> u64 in Wrapping {
    transition pair {
        Pair::Both { a, b } -> value(a + b)
    }

    state value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let pair: Pair = Pair::Both { a: 30, b: 40 };
    let total: u64 in Wrapping = Pair::code(&pair);
    transition total == 70 {
        true -> done(main, 70)
        _ -> done(main, 71)
    }

    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
