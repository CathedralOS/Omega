// A computed case-dispatch subject whose own operand calls is evaluated once,
// operand first, before arm selection. `Counter::flag` and `Main::pick` each
// count their calls; exits 70 when the dispatch selects Second with payload 20
// after exactly one call to each.
use omega_language_std::console;

data Pick {
    case First(v: i32);
    case Second(v: i32);
}

data Counter { flags: u32 in Wrapping; }

data Main { picks: u32 in Wrapping; }

machine Counter::flag(counter: &mut Counter) -> bool {
    counter.flags = counter.flags + 1;
    true
}

machine Main::pick(main: &mut Main, second: bool) -> Pick {
    main.picks = main.picks + 1;
    transition second {
        true -> (Pick::Second { v: 20 })
        _ -> (Pick::First { v: 10 })
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.picks = 0;
    let mut counter: Counter = Counter { flags: 0 };
    transition Main::pick(main, Counter::flag(&mut counter)) {
        Pick::First { .. } -> done(main, 71)
        Pick::Second { v } -> second(main, v, counter.flags)
    }
    state second(main: &mut Main, v: i32, flags: u32 in Wrapping) {
        transition v == 20 && flags == 1 && main.picks == 1 {
            true -> done(main, 70)
            _ -> done(main, 72)
        }
    }
    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
