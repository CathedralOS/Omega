use omega_language_std::console;
data Item { value: i32; }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> step(0) }
    state step(position: u8) {
        let item: Item = Item { value: 70 };
        transition position < 2 {
            true -> step(position + 1)
            false -> finish(item)
        }
    }
    state finish(item: Item) {
        transition item.value == 70 { true -> good() false -> bad() }
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}
