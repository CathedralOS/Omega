// A case dispatch whose subject is a RUNTIME-selected element:
// `transition main.items[main.w] { Color::Red -> .. }` over a payload-free
// `[Color; 3]`. Symbol resolution hoists the subject into one shared
// `let __hoist = &main.items[main.w];` so the arms stay one exhaustive
// dispatch; the Unit plan erases that borrow and each arm observes the
// element itself, one Terminal `StructuralCaseMembership` whose path selects
// it with a `RuntimeIndex` segment. The verifier bounds the selector against
// the array's declared extent at every arm, the observation keys no case
// fact, and Omega loads the tag at the element's declared offset plus `w`
// times the element stride.
//
// This is the case-array sibling of
// `tests/omega/pass/collections/runtime_indexed_record_field_read_exit`.
// The three elements hold three different cases and `w` selects the last,
// so reading the wrong element or stride dispatches to another arm.
// `items[2]` is `White` -> exit 2.
use omega_language_std::console;

data Color { case Red; case White; case Blue; }

data Main {
    items: [Color; 3];
    w: u64 [0..=2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Color::Blue;
    main.items[2] = Color::White;
    main.w = 2;
    transition main.items[main.w] {
        Color::Red -> red(main)
        Color::White -> white(main)
        _ -> other(main)
    }
    state red(main: &mut Main) { Console::exit_process(1); }
    state white(main: &mut Main) { Console::exit_process(2); }
    state other(main: &mut Main) { Console::exit_process(3); }
}
