// A returned owner goes through a second local before an internal backedge.
// Both linear ticket custody and the affine/reference-bearing siblings survive.
use omega::language::core::drop;

data Worker { identifier: u32; last_round: u32; }
data Workers { first: Worker; second: Worker; }
pub data Ticket [linear] { number: u32; }
machine Ticket::drop(ticket: &mut Ticket) {}
data Label { number: u32; }
data Job { ticket: Ticket; label: Label; worker: &Worker; }

machine hand_over(job: Job) -> Job { job }
machine complete_ticket(ticket: Ticket) -> u32 {
    let number: u32 = ticket.number;
    drop(ticket);
    number
}

machine complete_jobs(selected: Job, waiting: Job) -> u32 {
    let worker: u32 = selected.worker.identifier;
    let label: u32 = selected.label.number;
    let number: u32 = complete_ticket(selected.ticket);
    let unused: u32 = complete_ticket(waiting.ticket);
    transition (number == 9 && label == 10 && worker == 1)
        || (number == 8 && label == 20 && worker == 2) {
        true -> (((number as u32 in Wrapping) + (label as u32 in Wrapping))
            + (worker as u32 in Wrapping)) as u32
        false -> 0
    }
}

machine dispatch(first: Job, second: Job, remaining: u32) -> u32
terminates by remaining;
requires remaining <= 5
{
    transition { _ -> cycle(first, second, remaining) }
    state cycle(current: Job, waiting: Job, left: u32) -> u32
    requires left <= 5
    {
        let returned: Job = hand_over(current);
        let received: Job = returned;
        transition left > 0 {
            true -> cycle(waiting, received, left - 1)
            false -> (complete_jobs(received, waiting))
        }
    }
}

machine main() crashes Trap {
    let workers: Workers = Workers {
        first: Worker { identifier: 1, last_round: 0 },
        second: Worker { identifier: 2, last_round: 0 }
    };
    let odd: u32 = dispatch(
        Job { ticket: Ticket { number: 9 }, label: Label { number: 10 }, worker: &workers.first },
        Job { ticket: Ticket { number: 8 }, label: Label { number: 20 }, worker: &workers.second }, 3);
    let even: u32 = dispatch(
        Job { ticket: Ticket { number: 9 }, label: Label { number: 10 }, worker: &workers.first },
        Job { ticket: Ticket { number: 8 }, label: Label { number: 20 }, worker: &workers.second }, 4);
    transition odd == 30 && even == 20 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
