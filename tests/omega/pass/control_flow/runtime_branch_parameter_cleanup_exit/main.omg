data Item { value: u64; }

// Each selected edge forwards a different owner. The middle owner always
// dies here; the others die only on the edge that does not forward them.
machine choose(take_last: bool, first: Item, middle: Item, last: Item) -> u64 {
    transition take_last {
        true -> finish(last)
        _ -> finish(first)
    }
    machine finish(selected: Item) -> u64 { selected.value }
}

machine main() crashes Trap {
    let first: u64 = choose(true, Item { value: 11 }, Item { value: 12 }, Item { value: 13 });
    let second: u64 = choose(false, Item { value: 21 }, Item { value: 22 }, Item { value: 23 });
    transition first == 13 && second == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
