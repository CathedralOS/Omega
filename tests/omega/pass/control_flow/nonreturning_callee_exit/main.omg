// A Unit result promises the shape of a return, not that a return occurs.
machine wait_forever() {
    transition { _ -> waiting() }
    machine waiting() { transition { _ -> waiting() } }
}

data Main { wait: bool; }

machine Main::run(context: &mut Main) {
    transition context.wait {
        true -> wait()
        _ -> finish()
    }
    machine wait() { wait_forever(); }
    machine finish() {}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::run(&mut entry_storage);
}
