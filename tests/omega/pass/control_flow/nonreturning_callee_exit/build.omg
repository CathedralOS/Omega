machine build(builder: &mut Build) {
    Build::application(builder, "nonreturning_callee_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, Main::run);
    Build::bind(builder, macos_x86_64::ProgramEntry, Main::run);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::run);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::run);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::run);
}
