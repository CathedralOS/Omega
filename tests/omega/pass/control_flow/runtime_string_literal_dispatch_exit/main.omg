domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Binding<Console>;
    input: &[u8] in Utf8;
}

machine Main::main(&mut self) reaches Console {
    self.input = "look";

    transition self.input {
        "quit" -> finished()
        "look" -> look()
        _ -> invalid()
    }

    state finished(&mut self) {
        self.console.exit_process(10);
    }

    state look(&mut self) {
        self.console.exit_process(11);
    }

    state invalid(&mut self) {
        self.console.exit_process(12);
    }
}
