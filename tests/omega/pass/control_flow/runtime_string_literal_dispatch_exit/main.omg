domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    input: &[u8] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.input = "look";

    transition main.input {
        "quit" -> finished(main)
        "look" -> look(main)
        _ -> invalid(main)
    }

    state finished(main: &mut Main) {
        main.console.exit_process(10);
    }

    state look(main: &mut Main) {
        main.console.exit_process(11);
    }

    state invalid(main: &mut Main) {
        main.console.exit_process(12);
    }
}
