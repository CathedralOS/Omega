domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    input: &[u8] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.input = "look";

    transition main.input {
        "quit" -> finished(main)
        "look" -> look(main)
        _ -> invalid(main)
    }

    state finished(main: &mut Main) {
        Console::exit_process(10);
    }

    state look(main: &mut Main) {
        Console::exit_process(11);
    }

    state invalid(main: &mut Main) {
        Console::exit_process(12);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
