// A `transition` subject composes two conjuncts: `a == 1 && b == 2`
// evaluates to a bool that decides the arm — compound subjects break onto
// continuation lines under the `&&`.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let a: u64 = 1;
    let b: u64 = 2;
    transition a == 1
        && b == 2
    {
        true -> both(main)
        _ -> partial(main)
    }

    machine both(main: &mut Main) { main.answer = 70; }
    machine partial(main: &mut Main) { main.answer = 71; }
}
