// RUN CANARY (exit 70) + interpreter differential. A sum value STORED in a field
// (`main.stored = Msg::Pong { y, z }`) then READ and dispatched across a machine
// call must carry its TAG and PAYLOAD intact through the storage round-trip: the
// Pong arm fires (not Ping), and both payload fields read back (y=10, z=20).
// Distinct from the construct-and-immediately-dispatch sum canaries -- this pins
// the sum representation surviving a field store + field read. exit 71 = wrong
// variant dispatched (tag corrupted); 72 = a payload field read the wrong value.

use omega_language_std::console;
data Msg { case Ping(x: i32); case Pong(y: i32, z: i32); }
data Main { stored: Msg; }

machine Main::main(main: &mut Main) {
    main.stored = Msg::Pong { y: 10, z: 20 };
    Main::dispatch(main);
}

machine Main::dispatch(main: &mut Main) reaches Console {
    transition main.stored {
        Msg::Pong { y, z } -> chk(main, y, z)
        Msg::Ping { x } -> bad(main)
        _ -> bad(main)
    }
    state chk(main: &mut Main, y: i32, z: i32) {
        transition y == 10 {
            true -> chk2(main, z)
            _ -> wrong(main)
        }
    }
    state chk2(main: &mut Main, z: i32) {
        transition z == 20 {
            true -> good(main)
            _ -> wrong(main)
        }
    }
    state good(main: &mut Main)  { Console::exit_process(70); }
    state wrong(main: &mut Main) { Console::exit_process(72); }
    state bad(main: &mut Main)   { Console::exit_process(71); }
}
