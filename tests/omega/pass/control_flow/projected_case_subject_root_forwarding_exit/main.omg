// A case dispatch on a field of a local record (`item.kind`) observes that
// field; it does not consume the record. An arm may still forward the whole
// record (`data_item`, `trait_item`) or a nested record field
// (`reject(tally, item.location)`), the `_` arm leaves the copy to its edge
// cleanup, and a returning arm retires it at the return (`weight_or`).
// Counting the field dispatch as the record's consumer gave a forwarding
// arm's record no owner, and both machines had no executable body
// ("structural result has no selected disposition").
// Data adds 7, Trait adds its location source 3, Definition stops the walk
// and adds its span end 60 -> total 70; walking past it adds 50.
use omega_language_std::console;
use omega::language::core::binding;

data Span [copy] { start: u64 in Trapping; end: u64 in Trapping; }
data Location [copy] { source: u64 in Trapping; span: Span; }
data ItemKind [copy] { case Use; case Data; case Trait; case Definition; }
data Item [copy] { kind: ItemKind; weight: u64 in Trapping; location: Location; }
data Table { items: [Item; 5]; count: u64 in Trapping; }
data Tally { accepted: bool; total: u64 in Trapping; }

machine Table::item(table: &Table, index: u64 in Trapping) -> Item
crashes Trap
{
    transition index < 5 {
        true -> read(table, index)
        _ -> invalid()
    }
    state read(table: &Table, index: u64 in Trapping) { table.items[index] }
    state invalid() -> Item { crash Trap; }
}

machine Tally::walk(tally: &mut Tally, table: &Table)
crashes Trap
{
    transition { _ -> next(tally, table, 0) }

    state next(tally: &mut Tally, table: &Table, index: u64 in Trapping) {
        transition index < table.count && tally.accepted {
            true -> classify(tally, table, index)
            _ -> done()
        }
    }

    state classify(tally: &mut Tally, table: &Table, index: u64 in Trapping) {
        let item: Item = Table::item(table, index);
        transition item.kind {
            ItemKind::Definition -> reject(tally, item.location)
            ItemKind::Trait -> trait_item(tally, table, index, item)
            ItemKind::Data -> data_item(tally, table, index, item)
            _ -> next(tally, table, index + 1)
        }
    }

    state data_item(tally: &mut Tally, table: &Table, index: u64 in Trapping, item: Item) {
        tally.total = tally.total + item.weight;
        transition { _ -> next(tally, table, index + 1) }
    }

    state trait_item(tally: &mut Tally, table: &Table, index: u64 in Trapping, item: Item) {
        tally.total = tally.total + item.location.source;
        transition item.weight > 9 {
            true -> reject(tally, item.location)
            _ -> next(tally, table, index + 1)
        }
    }

    state reject(tally: &mut Tally, location: Location) {
        tally.accepted = false;
        tally.total = tally.total + location.span.end;
    }

    state done() {}
}

machine weight_or(kind: ItemKind, weight: u64 in Trapping, fallback: u64 in Trapping) -> u64 in Trapping {
    transition { _ -> select(kind, weight, fallback) }

    state select(kind: ItemKind, weight: u64 in Trapping, fallback: u64 in Trapping) -> u64 in Trapping {
        let here: Location = Location { source: 0, span: Span { start: 0, end: 0 } };
        let item: Item = Item { kind: kind, weight: weight, location: here };
        transition item.kind {
            ItemKind::Data -> weighed(item)
            _ -> (fallback)
        }
    }

    state weighed(item: Item) -> u64 in Trapping { item.weight }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let here: Location = Location { source: 3, span: Span { start: 2, end: 60 } };
    let table: Table = Table {
        items: [
            Item { kind: ItemKind::Data, weight: 7, location: here },
            Item { kind: ItemKind::Use, weight: 1, location: here },
            Item { kind: ItemKind::Trait, weight: 2, location: here },
            Item { kind: ItemKind::Definition, weight: 4, location: here },
            Item { kind: ItemKind::Data, weight: 50, location: here }
        ],
        count: 5,
    };
    let tally: Tally = Tally { accepted: true, total: 0 };
    Tally::walk(&mut tally, &table);
    let data_weight: u64 in Trapping = weight_or(ItemKind::Data, 9, 1);
    let use_weight: u64 in Trapping = weight_or(ItemKind::Use, 9, 1);
    transition tally.accepted == false && tally.total == 70 && data_weight == 9 && use_weight == 1 {
        true -> good(&main.console)
        _ -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 72); }
}
