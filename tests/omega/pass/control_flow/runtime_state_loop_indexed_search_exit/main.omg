use omega::language::std::console;

data Room {
    id: i32;
    tag: i32;
}

data Main {
    console: Console;
    rooms: [Room; 4];
}

machine Main::main(&mut self) {
    self.rooms[0].id = 10; self.rooms[0].tag = 100;
    self.rooms[1].id = 11; self.rooms[1].tag = 111;
    self.rooms[2].id = 12; self.rooms[2].tag = 122;
    self.rooms[3].id = 13; self.rooms[3].tag = 133;
    let view: &[Room] = self.rooms.as_slice();

    transition {
        _ -> find_at(view, 0)
    }

    state find_at(&mut self, view: &[Room], index: u64) {
        let matched: bool = view[index].id == 12;
        let next_index: u64 = index + 1;
        let has_next: bool = next_index < 4;
        transition {
            matched -> done(view[index].tag)
            has_next -> find_at(view, next_index)
            _ -> done(0)
        }
    }

    state done(&mut self, result: i32) {
        transition result == 122 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
