use omega_language_std::console;

// A back edge reuses both arrival homes. All bytes of both inputs must be
// snapshotted before either destination changes, including the narrow tail.
data Packet { bytes: [u8; 13]; }
data Main { }

machine swap(first: Packet, second: Packet) -> bool {
    transition { _ -> rotate(first, second, 3) }
    machine rotate(first: Packet, second: Packet, remaining: u64) -> bool
    requires remaining <= 3
    {
        transition remaining == 0 {
            true -> inspect(first, second)
            false -> rotate(second, first, remaining - 1)
        }
    }
    machine inspect(first: Packet, second: Packet) -> bool {
        first.bytes[0] == 7 && first.bytes[12] == 11
            && second.bytes[0] == 3 && second.bytes[12] == 9
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut first: Packet;
    first.bytes[0] = 3;
    first.bytes[12] = 9;
    let mut second: Packet;
    second.bytes[0] = 7;
    second.bytes[12] = 11;
    let correct: bool = swap(first, second);
    transition correct { true -> good(main) false -> bad(main) }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
