// One arm carries a copied local twice; the other carries it beside an inline
// call result. Every selected edge has one source-home disposition.
use omega_language_std::console;
data Fraction [copy] { value: u64 in Wrapping; }
machine make(value: u64 in Wrapping) -> Fraction { Fraction { value: value } }
machine select(flag: bool, value: u64 in Wrapping) -> u64 in Wrapping {
    let initial: Fraction = make(value);
    transition flag {
        true -> sum(initial, make(value + 1))
        false -> sum(initial, initial)
    }
    state sum(first: Fraction, second: Fraction) -> u64 in Wrapping {
        first.value + second.value
    }
}
data Main { }
machine Main::main(context: &mut Main) reaches Console {
    let first: u64 in Wrapping = select(true, 7);
    let second: u64 in Wrapping = select(false, 7);
    transition first == 15 && second == 14 { true -> done(context) false -> bad(context) }
    state done(context: &mut Main) { Console::exit_process(0); }
    state bad(context: &mut Main) { Console::exit_process(1); }
}
