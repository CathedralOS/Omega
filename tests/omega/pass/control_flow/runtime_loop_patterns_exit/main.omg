// Loop patterns via self-transition (state recursion) -- the workhorse of serious
// apps. Locks the two non-obvious properties:
//   1. A LARGE counting loop (1..10000) stays ITERATIVE -- 10000 self-transitions
//      without stack growth (a recursive lowering would overflow). sum == 50005000.
//   2. NESTED loops -- an inner loop re-initialized each outer iteration; sum of i*j
//      for i,j in 1..10 == (1+..+10)^2 == 55*55 == 3025.
// Exits 70.

use omega_language_std::console;

data Main {
    i: i32 in Wrapping;
    j: i32 in Wrapping;
    sum: i32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.i = 1;
    main.sum = 0;
    transition { _ -> sum_loop(main) }

    // --- 1: large counting accumulation ---
    state sum_loop(main: &mut Main) {
        transition main.i > 10000 { true -> check_sum(main) _ -> sum_body(main) }
    }
    state sum_body(main: &mut Main) {
        main.sum = main.sum + main.i;
        main.i = main.i + 1;
        transition { _ -> sum_loop(main) }
    }
    state check_sum(main: &mut Main) {
        transition main.sum == 50005000 { true -> nested_init(main) _ -> bad(main) }
    }

    // --- 2: nested loop ---
    state nested_init(main: &mut Main) {
        main.i = 1;
        main.sum = 0;
        transition { _ -> outer(main) }
    }
    state outer(main: &mut Main) {
        transition main.i > 10 { true -> check_nested(main) _ -> inner_init(main) }
    }
    state inner_init(main: &mut Main) {
        main.j = 1;
        transition { _ -> inner(main) }
    }
    state inner(main: &mut Main) {
        transition main.j > 10 { true -> next_i(main) _ -> inner_body(main) }
    }
    state inner_body(main: &mut Main) {
        main.sum = main.sum + main.i * main.j;
        main.j = main.j + 1;
        transition { _ -> inner(main) }
    }
    state next_i(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> outer(main) }
    }
    state check_nested(main: &mut Main) {
        transition main.sum == 3025 { true -> good(main) _ -> bad(main) }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
