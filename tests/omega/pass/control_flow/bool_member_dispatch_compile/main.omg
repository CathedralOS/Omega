// A bool member serves as a transition subject: `transition main.armed`
// with `true`/`false` literal arms — boolean fields dispatch like
// scalar subjects.
data Main {
    armed: bool;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.armed = true;
    transition main.armed {
        true -> good(main)
        false -> bad(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
