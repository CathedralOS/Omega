// Expected exit: 0.
use omega::language::core::drop;
pub data Token [linear] { value: u32; }
machine Token::drop(token: &mut Token) {}
machine consume(token: Token) -> u32 { let value: u32 = token.value; drop(token); value }
data Marker [copy] { value: u32; }
machine make_marker() -> Marker { Marker { value: 7 } }
machine pair(first: Marker, second: Marker) -> u32 { ((first.value as u32 in Wrapping) + (second.value as u32 in Wrapping)) as u32 }
pub boundary trait Selection { machine select(token: Token, choose: bool) -> u32; }
Selector satisfies Selection { Selection::select = select_adapter; }
data Main { }
machine select_adapter(token: Token, choose: bool) -> u32
satisfies Selection::select
{
    let ignored: u32 = consume(token);
    let marker: Marker = make_marker();
    transition choose { true -> (pair(marker, marker)) false -> 0 }
}
machine Main::main(context: &mut Main) reaches Selection crashes Trap {
    let first: u32 = Selection::select(Token { value: 9 }, true);
    let second: u32 = Selection::select(Token { value: 8 }, false);
    transition first == 14 && second == 0 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
