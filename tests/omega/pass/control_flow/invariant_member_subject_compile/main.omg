// A `transition` subject may read a `data where` member: `main.band.b`
// dispatches while the record's `a >= 1, b >= a, b <= 9` invariant holds —
// subjects see constrained fields like any other.
data Band
where
    a >= 1,
    b >= a,
    b <= 9,
{
    a: u64;
    b: u64;
}

data Main {
    band: Band;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.band = Band { a: 3, b: 7 };
    transition main.band.b {
        7 -> hit(main)
        _ -> miss(main)
    }

    machine hit(main: &mut Main) { main.answer = 70; }
    machine miss(main: &mut Main) { main.answer = 71; }
}
