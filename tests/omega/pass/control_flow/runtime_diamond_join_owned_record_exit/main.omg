// An owned affine record crosses either branch of a diamond and is disposed
// once at the join, whichever branch carried it.
use omega_language_std::console;

data Token { id: u32; }
data Main { }

machine route(token: Token, flag: bool) {
    transition flag {
        true -> left(token)
        false -> right(token)
    }
    machine left(held: Token) { transition { _ -> join(held) } }
    machine right(held: Token) { transition { _ -> join(held) } }
    machine join(finished: Token) {}
}

machine Main::main(main: &mut Main) reaches Console {
    route(Token { id: 9 }, true);
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
