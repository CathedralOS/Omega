// Linear search with EARLY EXIT: scan an array for the first element equal to `target`, and the
// instant it is found, leave the loop (transition straight to `done`) rather than iterating to the
// end. Each element is read into a field first, then compared (the sound pattern for a runtime-
// indexed comparison). arr = [3,7,12,18,5], target = 12 -> found at index 2; exits 70 iff the
// search stops there. A wrong index, or failing to stop, would miss 2.
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    arr: [i32; 5] in Wrapping;
    target: i32 in Wrapping;
    i: u32 in Wrapping;
    v: i32 in Wrapping;
    found: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.arr = [3, 7, 12, 18, 5];
    self.target = 12;
    self.i = 0;
    self.found = 0 - 1;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.i < 5 {
            true -> check()
            _ -> done()
        }
    }
    state check(&mut self) {
        self.v = self.arr[self.i];
        transition self.v == self.target {
            true -> got_it()
            _ -> next()
        }
    }
    state got_it(&mut self) {
        self.found = narrow_u32_to_i32_trapping(self.i as u32) as i32 in Wrapping;
        transition { _ -> done() }
    }
    state next(&mut self) {
        self.i = self.i + 1;
        transition { _ -> step() }
    }
    state done(&mut self) {
        transition self.found == 2 {
            true -> ok()
            _ -> bad()
        }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
