// Respelled from the retired nested self-call shape (`main.out = Main::pick(flag)`);
// the direct let-call root is the admitted surface. Both spellings must reach one
// verdict: `pick` returns only string literals, so the loan outlives every state
// and the persistent-field store is admitted whether the call is written inline or
// bound to an immutable local first (checks/borrows/persistent.rs).
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    out: &[u8] in Utf8;
}

machine Main::main(main: &mut Main) {
    let flag: bool = true;
    let picked: &[u8] in Utf8 = Main::pick(flag);
    main.out = picked;
}

machine Main::pick(flag: bool) -> &[u8] in Utf8 {
    transition flag {
        true -> "Gate"
        false -> "Branch Room"
    }
}
