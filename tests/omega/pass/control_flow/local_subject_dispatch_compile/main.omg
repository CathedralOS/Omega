// A `transition` subject may name a plain local: `let pick = 9` then
// `transition pick` — the local's value decides the arm, no member
// projection needed.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let pick: u64 = 9;
    transition pick {
        9 -> nine(main)
        _ -> other(main)
    }

    machine nine(main: &mut Main) { main.answer = 70; }
    machine other(main: &mut Main) { main.answer = 71; }
}
