// A machine-call result may be the dispatch subject of a `transition`: the
// callee runs once, its returned value is matched against the authored arms,
// and the wildcard arm absorbs everything the literal arms leave out.
data Main { answer: u64; }

machine Main::pick(input: u64) -> u64 {
    input % 3
}

machine Main::main(main: &mut Main) {
    transition Main::pick(14) {
        0 -> zero(main)
        1 -> one(main)
        _ -> rest(main)
    }

    machine zero(main: &mut Main) { main.answer = 70; }
    machine one(main: &mut Main) { main.answer = 71; }
    machine rest(main: &mut Main) { main.answer = 72; }
}
