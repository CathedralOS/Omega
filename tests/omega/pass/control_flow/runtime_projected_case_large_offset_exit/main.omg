use omega_language_std::console;

data Reading [copy] {
    case Empty;
    case Full(value: u64 in Wrapping);
    case Other;
}
data Holder { padding: [u8; 32768]; reading: Reading; }
data Main { }

machine read(holder: &Holder) -> u64 in Wrapping {
    transition holder.reading {
        Reading::Empty -> (1)
        Reading::Full { value } -> result(value)
        Reading::Other -> (2)
    }
    machine result(value: u64 in Wrapping) -> u64 in Wrapping { value }
}

machine Main::main(main: &mut Main) reaches Console {
    let holder: Holder = Holder { reading: Reading::Full { value: 70 } };
    let result: u64 in Wrapping = read(&holder);
    transition result == 70 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
