// A transition over a one-case sum selects its sole case without testing the
// tag, whichever activation-local home holds the dispatched value: a call
// result dispatched in place, the same result carried into a state as a block
// parameter, and an immutable local whose arm renames its payload reads. The
// helper builds the sum on two runtime paths, so no dispatch folds away.
// Exits 70 when left = 9 + 1 + 101 = 111 and right = 1 + 2 = 3 arrive.
use omega_language_std::console;

data Pair {
    case Both(left: u64 in Wrapping, right: i32 in Wrapping);
}

data Main {
    seed: u64 in Wrapping;
}

machine build_pair(seed: u64 in Wrapping) -> Pair {
    transition seed > 3 {
        true -> large(seed)
        _ -> small(seed)
    }

    state large(seed: u64 in Wrapping) -> Pair {
        Pair::Both { left: seed, right: 1 }
    }

    state small(seed: u64 in Wrapping) -> Pair {
        Pair::Both { left: seed + 100, right: 2 }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.seed = 9;
    transition build_pair(main.seed) {
        Pair::Both { left, right } -> carried(main, left, right)
    }

    state carried(main: &mut Main, left: u64 in Wrapping, right: i32 in Wrapping) {
        let joined: Pair = build_pair(left + 1);
        transition { _ -> arrival(main, joined) }
    }

    state arrival(main: &mut Main, joined: Pair) {
        transition joined {
            Pair::Both { left, right } -> local(main, left, right)
        }
    }

    state local(main: &mut Main, left: u64 in Wrapping, right: i32 in Wrapping) {
        let kept: Pair = build_pair(left - 9);
        transition kept {
            Pair::Both { left as more, right as other } -> check(main, left + more, right + other)
        }
    }

    state check(main: &mut Main, left: u64 in Wrapping, right: i32 in Wrapping) {
        transition left == 111 && right == 3 {
            true -> done(main, 70)
            _ -> done(main, 71)
        }
    }

    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
