use omega_language_std::console;

data Choice { case Both(a: u64 in Wrapping, b: u64 in Wrapping); case Empty; }
data Main {
    items: [Choice; 2];
    selected: u64 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Choice::Empty;
    main.items[1] = Choice::Both { a: 30, b: 40 };
    main.selected = 1;
    transition main.items[main.selected] {
        Choice::Both { a, b } -> total(main, a, b)
        Choice::Empty -> bad(main)
    }
    state total(main: &mut Main, first: u64 in Wrapping, second: u64 in Wrapping) {
        // Snapshots survive changing both the selector and selected storage.
        main.selected = 0;
        main.items[1] = Choice::Empty;
        transition first + second == 70 {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
