// A two-case `transition` on the subject match where BOTH arms return their own case's
// payload lowers as one structural split: each case edge binds its payload
// parameter and the arm returns it. The mc_self2 wall left the else arm's
// deferred read unsubstituted on the shared field carrier. Exits 70 only when
// both arms observe their own payload.

use omega_language_std::console;
use omega::language::core::binding;

data Sum {
    case Left(v: u64);
    case Right(w: u64);
}

machine Sum::pick(sum: &Sum) -> u64 {
    transition sum {
        Sum::Left { v } -> (v)
        Sum::Right { w } -> (w)
    }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let left: Sum = Sum::Left { v: 41 };
    let right: Sum = Sum::Right { w: 29 };

    transition Sum::pick(&left) == 41 {
        true -> first(main, right)
        _ -> missed(main)
    }

    state first(main: &mut Main, right: Sum) {
        transition Sum::pick(&right) == 29 {
            true -> matched(main)
            _ -> missed(main)
        }
    }

    state matched(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}
