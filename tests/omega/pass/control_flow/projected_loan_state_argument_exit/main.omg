// A `&self.<field>` successor argument loans the projected field into the
// successor's borrowed parameter: the loan's root is the `&mut self`
// receiver, and the state reads the field through the view.
// exits: view.a, which the entry stores as 11.

use omega_language_std::console;
use omega::language::core::binding;

data Pair [copy] { a: i32; }

data Main {
    pair: Pair;
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    self.pair = Pair { a: 11 };
    transition { _ -> inspect(&self.pair) }

    state inspect(&mut self, view: &Pair) {
        self.console.exit_process(view.a);
    }
}
