// A branching helper's value lands through local guards: `pick` folds
// `depth`/`roll` into a case ladder and `main` stores it in the carrier. The
// deployable shape matches the sibling runtime canaries: the stored case is
// checked in a guard ladder and the process exits 70 only when exact.

use omega_language_std::console;
use omega::language::core::service;
use omega::language::core::numeric_conversion;

data RandomState {
    seed: u64 in Wrapping;
    calls: UInt;
}

data Random {
}

machine Random::next_u32(&mut self, state: &mut RandomState) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;
    narrow_u64_to_u32_wrapping(state.seed >> 32)
}

machine Random::range(&mut self, state: &mut RandomState, exclusive_max: u32) -> u32 {
    let raw: u32 = self.next_u32(state);
    raw % exclusive_max
}

data ItemKind {
    case RustedDagger;
    case EarlyBuckler;
    case HealingCharm;
    case EmberBlade;
    case DeepKey;
}

data Reward {
    item: ItemKind;
}

data Main {
    console: Binding<Console>;
    rng: Random;
    reward: Reward;
}

machine Main::main(&mut self) reaches Console {
    let mut state: RandomState = RandomState { seed: 0, calls: 0 };
    self.reward.item = self.pick(1, &mut state);

    transition self.reward.item == ItemKind::RustedDagger {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::pick(
    &mut self,
    depth: u32,
    random: &mut RandomState
    ) -> ItemKind {
    let roll: u32 = self.rng.range(random, 100);
    let is_early_dagger: bool = depth <= 2 && roll < 50;
    let is_early_buckler: bool = depth <= 3 && roll < 75;
    let is_healing_charm: bool = roll < 85;
    let is_ember_blade: bool = depth >= 5 && roll < 96;
    let is_deep_key: bool = depth >= 8;

    transition {
        is_early_dagger -> ItemKind::RustedDagger
        is_early_buckler -> ItemKind::EarlyBuckler
        is_healing_charm -> ItemKind::HealingCharm
        is_ember_blade -> ItemKind::EmberBlade
        is_deep_key -> ItemKind::DeepKey
        _ -> ItemKind::RustedDagger
    }
}
