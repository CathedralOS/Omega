// RUN CANARY (exit 2). A case dispatch whose tag lies far past the start of
// its home: 20,000 bytes of padding precede a runtime-indexed `[Color; 3]`,
// so the tag load's displacement is past the reach of an AArch64 scaled
// immediate (16,380 bytes for a word). Selection forms the address first,
// exactly as other far accesses do, and the load reads the selected element.
// `items[2]` is `White` -> exit 2.
use omega_language_std::console;

data Color { case Red; case White; case Blue; }

data Main {
    padding: [u8; 20000];
    items: [Color; 3];
    w: u64 [0..=2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Color::Blue;
    main.items[2] = Color::White;
    main.w = 2;
    transition main.items[main.w] {
        Color::Red -> red(main)
        Color::White -> white(main)
        _ -> other(main)
    }
    state red(main: &mut Main) { Console::exit_process(1); }
    state white(main: &mut Main) { Console::exit_process(2); }
    state other(main: &mut Main) { Console::exit_process(3); }
}
