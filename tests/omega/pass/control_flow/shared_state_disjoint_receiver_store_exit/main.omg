// Composite values supplied directly as internal state arguments. Each source
// family arrives in a fresh owned parameter and is observed there:
//
//   literal    take_literal(Pair { a: 1, b: 2 }, 3)   unconditional edge
//   field      take_field(main.pair)                    guarded edge
//   call       take_call(make(&mut main.counter, 5), 6, main)
//                                                       guarded edge; the
//                                                       unselected arm's call
//                                                       must leave no effect
//   local      take_local(local)                        unconditional edge
//   affine     take_owned(settle(3))                    guarded edge; the
//                                                       non-copy result dies
//                                                       at the target's exits
//   reference  take_view(&main.pair)                    borrowed control
//
// The scalar arguments beside the composites keep their own policy. The call
// arm pins once-only evaluation after edge selection: `counter.made` counts
// every `make`, and only the selected arm's call may run. Checksum:
//   literal 1 + 2 + 3, field 10 + 20, call 5 + 50 + 6 = 97; the local's
//   7 + 8 and the affine 3 each return to 97 after their own offsets; less
//   the view's 10 + 20, plus three per `made` call: 97 - 30 + 3 = 70.
// Arguments evaluate left to right, so the call that borrows `main.counter`
// precedes forwarding `main` itself; forwarding `main` first would hold it
// while `make` forms a second exclusive loan
// (fail/borrows/state_argument_borrows_forwarded_reference).
use omega_language_std::console;
use omega::language::core::binding;

data Pair [copy] {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
}

data Owned {
    value: i32 in Wrapping;
}

data Counter {
    made: i32 in Wrapping;
}

data Main {
    console: Binding<Console>;
    pair: Pair;
    counter: Counter;
    total: i32 in Wrapping;
}

machine make(counter: &mut Counter, seed: i32 in Wrapping) -> Pair {
    counter.made = counter.made + 1;
    Pair { a: seed, b: seed * 10 }
}

machine settle(value: i32 in Wrapping) -> Owned {
    Owned { value: value }
}

machine Main::main(main: &mut Main) reaches Console {
    main.pair = Pair { a: 10, b: 20 };
    main.counter.made = 0;
    main.total = 0;
    transition { _ -> take_literal(main, Pair { a: 1, b: 2 }, 3) }

    state take_literal(main: &mut Main, pair: Pair, extra: i32 in Wrapping) {
        main.total = main.total + pair.a + pair.b + extra;
        transition main.total == 6 {
            true -> take_field(main, main.pair)
            false -> bad(main, 71)
        }
    }

    state take_field(main: &mut Main, pair: Pair) {
        main.total = main.total + pair.a + pair.b;
        transition main.total == 36 {
            true -> take_call(make(&mut main.counter, 5), 6, main)
            false -> take_call(make(&mut main.counter, 9), 0, main)
        }
    }

    state take_call(pair: Pair, extra: i32 in Wrapping, main: &mut Main) {
        main.total = main.total + pair.a + pair.b + extra;
        let local: Pair = Pair { a: 7, b: 8 };
        transition main.counter.made == 1 && main.total == 97 {
            true -> take_local(main, local)
            false -> bad(main, 72)
        }
    }

    state take_local(main: &mut Main, pair: Pair) {
        main.total = main.total + pair.a + pair.b - 15;
        transition main.total == 97 {
            true -> take_owned(main, settle(3))
            false -> bad(main, 73)
        }
    }

    state take_owned(main: &mut Main, owned: Owned) {
        main.total = main.total + owned.value - 3;
        transition main.total == 97 {
            true -> take_view(main, &main.pair)
            false -> bad(main, 75)
        }
    }

    state take_view(main: &mut Main, pair: &Pair) {
        main.total = main.total - pair.a - pair.b + main.counter.made * 3;
        transition main.total == 70 && pair.a == 10 && pair.b == 20 {
            true -> good(main)
            false -> bad(main, 74)
        }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
