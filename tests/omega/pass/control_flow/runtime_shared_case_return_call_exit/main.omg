// One returning arm that calls a machine and covers several cases — a `_`
// over payload-free and payload-carrying cases — lowers its call once: every
// covered case enters the arm's single completion block over its own edge,
// so the call's source coordinate stays unique. Each case is dispatched at
// runtime, through both an owned subject and a borrowed one. Exits 70 only
// when every arm returns its own value.

use omega_language_std::console;

data Main {
}

data Shape {
    case Leaf(value: u64 in Wrapping);
    case Pair(left: u64 in Wrapping, right: u64 in Wrapping);
    case Empty;
    case Other;
}

machine Shape::fallback(base: u64 in Wrapping) -> u64 in Wrapping {
    base + 1
}

machine Shape::leaf(value: u64 in Wrapping, base: u64 in Wrapping) -> u64 in Wrapping {
    value + base
}

// An owned subject: each covered case disposes it on its own edge.
machine Shape::score(shape: Shape, base: u64 in Wrapping) -> u64 in Wrapping {
    transition shape {
        Shape::Leaf { value } -> Shape::leaf(value, base)
        _ -> Shape::fallback(base)
    }
}

// A borrowed subject: the shared arm also reads nothing of the payload.
machine Shape::score_borrowed(shape: &Shape, base: u64 in Wrapping) -> u64 in Wrapping {
    transition shape {
        Shape::Empty -> Shape::leaf(0, base)
        _ -> Shape::fallback(base)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let leaf: u64 in Wrapping = Shape::score(Shape::Leaf { value: 5 }, 10);
    let pair: u64 in Wrapping = Shape::score(Shape::Pair { left: 1, right: 2 }, 10);
    let empty: u64 in Wrapping = Shape::score(Shape::Empty, 10);
    let other: u64 in Wrapping = Shape::score(Shape::Other, 10);
    let borrowed_empty: Shape = Shape::Empty;
    let borrowed_pair: Shape = Shape::Pair { left: 3, right: 4 };
    let first: u64 in Wrapping = Shape::score_borrowed(&borrowed_empty, 7);
    let second: u64 in Wrapping = Shape::score_borrowed(&borrowed_pair, 7);
    // 15 + 11 + 11 + 11 + 7 + 8 = 63, plus 7 for 70.
    transition leaf + pair + empty + other + first + second + 7 == 70 {
        true -> ok(main)
        _ -> bad(main)
    }

    state ok(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
