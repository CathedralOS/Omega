// Each Boolean equality emits the RHS on either left outcome. Literal and
// copied aggregate arguments need independent whole-result storage per emitted
// producer instance, while exactly one RHS executes for each source equality.
// [copy] preserves the source packet (language/ownership.md: Multiplicity).
use omega_language_std::console;

data Packet [copy] { value: bool; stamp: u64; }
data Main {
    calls: u64 in Wrapping;
    flag: bool;
    packet: Packet;
}

machine inspect_array(values: [u64; 2], calls: &mut u64 in Wrapping) -> bool {
    calls = calls + 1;
    values[0] == 11 && values[1] == 29
}
machine inspect_copy(packet: Packet, calls: &mut u64 in Wrapping) -> bool {
    calls = calls + 1;
    packet.value && packet.stamp == 40
}

machine Main::main(main: &mut Main) reaches Console {
    main.calls = 0;
    main.flag = true;
    main.packet.value = true;
    main.packet.stamp = 40;
    transition main.flag == inspect_array([11, 29], &mut main.calls) {
        true -> false_literal(main)
        false -> bad(main)
    }
    machine false_literal(main: &mut Main) {
        main.flag = false;
        transition main.flag == inspect_array([11, 29], &mut main.calls) {
            false -> true_copy(main)
            true -> bad(main)
        }
    }
    machine true_copy(main: &mut Main) {
        main.flag = true;
        transition main.flag == inspect_copy(main.packet, &mut main.calls) {
            true -> false_copy(main)
            false -> bad(main)
        }
    }
    machine false_copy(main: &mut Main) {
        main.flag = false;
        transition main.flag == inspect_copy(main.packet, &mut main.calls) {
            false -> verify(main)
            true -> bad(main)
        }
    }
    machine verify(main: &mut Main) {
        transition main.calls == 4 && main.packet.value && main.packet.stamp == 40 {
            true -> good(main)
            false -> bad(main)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
