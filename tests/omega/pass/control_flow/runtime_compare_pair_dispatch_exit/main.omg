// The complement-pair closure: `x == k ->` plus `x != k ->` over one subject
// and value is TOTAL, so the dispatch provably closes without `_` (the
// dungeon's resolve_navigation shape). Exits 70 through the `!=` arm.
use omega_language_std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
}
machine Main::main(&mut self) reaches Console {
    let mut x: i32 = 5;
    transition {
        x == 3 -> bad(&mut self)
        x != 3 -> good(&mut self)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
