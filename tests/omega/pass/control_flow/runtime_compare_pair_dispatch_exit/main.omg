// The complement-pair closure: `x == k ->` plus `x != k ->` over one subject
// and value is TOTAL, so the dispatch provably closes without `_` (the
// dungeon's resolve_navigation shape). Exits 70 through the `!=` arm.
use omega_language_std::console;
data Main {
}
machine Main::main(main: &mut Main) reaches Console {
    let mut x: i32 = 5;
    transition {
        x == 3 -> bad(main)
        x != 3 -> good(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
