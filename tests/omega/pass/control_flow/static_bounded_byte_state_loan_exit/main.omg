// Whole bounded-byte storage keeps its canonical backing through state loans.
machine main() crashes Trap {
    let mut bytes: [u8; 2] = "ab";
    transition bytes[0] == 97 {
        true -> selected(&mut bytes)
        _ -> bad()
    }
    state selected(bytes: &mut [u8; 2]) {
        bytes[1] = 90;
        transition { _ -> observed(bytes) }
    }
    state observed(bytes: &[u8; 2]) {
        transition bytes[0] == 97 && bytes[1] == 90 {
            true -> done()
            _ -> bad()
        }
    }
    state done() { }
    state bad() { crash Trap; }
}
