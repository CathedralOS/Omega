// A `transition` subject may index an array member: `main.cells[2]`
// evaluates the element in place — index projections dispatch without a
// binding step.
data Main {
    cells: [u64; 3];
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.cells = [4, 5, 6];
    transition main.cells[2] {
        6 -> third(main)
        _ -> other(main)
    }

    machine third(main: &mut Main) { main.answer = 70; }
    machine other(main: &mut Main) { main.answer = 71; }
}
