// An owned affine record transfers into whichever successor a guard selects.
// One successor reads it into a borrowed record, the other discards it; the
// cleanup frontier differs per edge.
use omega_language_std::console;

data Token { id: u32; }
data Tally { count: u64; }
data Main { tally: Tally; }

machine relay(token: Token, tally: &mut Tally) {
    tally.count = token.id as u64;
    transition token.id > 4 {
        true -> high(token, tally)
        false -> low(token, tally)
    }
    state high(kept: Token, out: &mut Tally) { out.count = (kept.id as u64) * 2; }
    state low(dropped: Token, out: &mut Tally) { out.count = 1; }
}

machine Main::main(main: &mut Main) reaches Console {
    relay(Token { id: 35 }, &mut main.tally);
    transition main.tally.count == 70 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
