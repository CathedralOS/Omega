machine build(builder:&mut Build){Build::application(builder,"state_two_computed_shared_entries");Build::bind(builder,macos_arm64::ProgramEntry,main);Build::bind(builder,linux_arm64::ProgramEntry,main);Build::bind(builder,windows_x86_64::ProgramEntry,main);Build::bind(builder,linux_x86_64::ProgramEntry,main);}
