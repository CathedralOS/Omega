use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Binding<Console>;
    roll: i32;
}

machine Main::main(&mut self) reaches Console {
    self.roll = 3;

    transition ((self.roll >= 5) == false) {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(75);
    }

    state bad(&mut self) {
        self.console.exit_process(76);
    }
}
