// RUN CANARY (exit 70) + interpreter differential. Multi-subject case
// exhaustiveness is a CARTESIAN proof: these three boxes cover every
// (Direction, Outcome, bool) triple without a `_` arm. A pure case-union
// domain is a finite subset on one axis; the held triple selects its SECOND
// member, pinning mixed-domain lowering as well as the proof.
use omega_language_std::console;

data Direction {
    case Left;
    case Right;
    case Up;
}

domain Direction::Horizontal(direction)
requires
    direction in Direction::Left | Direction::Right;
data Outcome {
    case Miss;
    case Hit;
}

data Main {
    direction: Direction;
    result: Outcome;
}

machine Main::main(main: &mut Main) reaches Console {
    main.direction = Direction::Right;
    main.result = Outcome::Hit;
    let mut approved: bool = false;
    transition (main.direction, main.result, approved) {
        (Direction::Horizontal, _, _) -> right(main)
        (Direction::Up, Outcome::Hit, true) -> wrong(main)
        (Direction::Up, Outcome::Hit, false) -> wrong(main)
        (Direction::Up, Outcome::Miss, true) -> wrong(main)
        (Direction::Up, Outcome::Miss, false) -> wrong(main)
    }

    state right(main: &mut Main) { Console::exit_process(70); }
    state wrong(main: &mut Main) { Console::exit_process(71); }
}
