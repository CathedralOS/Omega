// `..` is the arm-only explicit opt-out from the exhaustiveness law: the
// same partial pattern that refuses without it compiles and runs with it
// (no marker is minted). The runtime self-check accepts only 30 + 40 = 70.
// Arm-position record binding SHARES the LET record-pattern grammar (owner
// spec 2026-07-18): `dx as step` renames the binding (uses of `step`
// rewrite to the subject's payload read), `dy as _` waives the field
// (spelled, no binding). Case arm keeps its tag guard; the `if` guard and
// target arguments see the renamed binding.
use omega_language_std::console;
data Msg requires (self in Msg::Stop) || ((self in Msg::Move) && 0 <= self.dx && self.dx <= 50 && 0 <= self.dy && self.dy <= 50) {
    case Move(dx: i32, dy: i32);
    case Stop(code: i32);
}
data Main { }
machine Main::main(main: &mut Main) {
    Main::apply(main, Msg::Move { dx: 30, dy: 40 });
}
machine Main::apply(main: &mut Main, m: Msg) reaches Console {
    transition m {
        Msg::Move { dx as step, .. } if step == 30 -> good(main, step)
        _ -> bad(main)
    }
    machine good(main: &mut Main, step: i32) requires 0 <= step && step <= 50 { let code: i32 = step + 40; Console::exit_process(code); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
