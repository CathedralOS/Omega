// `..` is the arm-only explicit opt-out from the exhaustiveness law: the
// same partial pattern that refuses without it compiles and runs with it
// (no marker is minted). The runtime self-check accepts only 30 + 40 = 70.
// Arm-position record binding SHARES the LET record-pattern grammar (owner
// spec 2026-07-18): `dx as step` renames the binding (uses of `step`
// rewrite to the subject's payload read), `dy as _` waives the field
// (spelled, no binding). Case arm keeps its tag guard; the `if` guard and
// target arguments see the renamed binding. The runtime self-check accepts only 30 + 40 = 70.
use omega_language_std::console;
data Msg {
    case Move(dx: i32 [0..=50], dy: i32 [0..=50]);
    case Stop(code: i32);
}
data Main { console: Console; }
machine Main::main(&mut self) {
    self.apply(Msg::Move { dx: 30, dy: 40 });
}
machine Main::apply(&mut self, m: Msg) {
    transition m {
        Msg::Move { dx as step, .. } if step == 30 -> good(step)
        _ -> bad()
    }
    state good(&mut self, step: i32 [0..=50]) { let code: i32 = step + 40; self.console.exit_process(code); }
    state bad(&mut self) { self.console.exit_process(1); }
}
