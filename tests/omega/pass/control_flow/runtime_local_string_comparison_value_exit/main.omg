domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    text: &[u8] in Utf8;
}

machine Main::main(&mut self) reaches Console {
    self.text = "deep room";

    let text_ok: bool = self.text == "deep room";

    transition text_ok {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(78);
    }

    state bad(&mut self) {
        self.console.exit_process(79);
    }
}