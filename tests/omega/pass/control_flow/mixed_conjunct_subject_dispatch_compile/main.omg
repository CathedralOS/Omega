// A `transition` subject mixes indexed and plain members in one conjunct:
// `main.cells[0] == 4 && main.tag == 7` — compound subjects read across
// projections without a binding step.
data Main {
    cells: [u64; 2];
    tag: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.cells = [4, 9];
    main.tag = 7;
    transition main.cells[0] == 4
        && main.tag == 7
    {
        true -> both(main)
        _ -> partial(main)
    }

    machine both(main: &mut Main) { main.answer = 70; }
    machine partial(main: &mut Main) { main.answer = 71; }
}
