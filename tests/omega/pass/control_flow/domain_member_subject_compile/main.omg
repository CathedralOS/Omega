// A `transition` subject may read a domain-qualified member:
// `main.pair.n` is `u64 in Tiny` — the bounded field dispatches like a
// plain scalar while its qualification rides along.
domain u64::Tiny(value)
requires
    value <= 4;

data Pair {
    n: u64 in Tiny;
    tag: u64;
}

data Main {
    pair: Pair;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.pair = Pair { n: 3, tag: 7 };
    transition main.pair.n {
        3 -> hit(main)
        _ -> miss(main)
    }

    machine hit(main: &mut Main) { main.answer = 70; }
    machine miss(main: &mut Main) { main.answer = 71; }
}
