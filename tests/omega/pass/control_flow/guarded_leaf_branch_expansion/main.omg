// COMPILE CANARY: a nested OWNED field's declared ZII-admitting domain remains
// a valid write source after the enclosing record crosses a mutable
// out-parameter call. Alias invalidation may discard transient facts, but it
// must not discard the enforced declared-domain invariant of `Cell::label`.
// Persistent room/line text uses bounded ownership; a borrowed view would need
// an explicit outlives relation and retained loan, which this canary does not
// exercise.
pub domain [u8; 2]::Utf8(bytes)
requires
    valid_utf8(bytes);
data CellId {
    case Empty;
    case A1;
    case A2;
}

data Cell {
    id: CellId;
    label: [u8; 2] in Utf8;
}

data CellLine {
    text: [u8; 2] in Utf8;
}

pub boundary trait Console {
    machine write_line(text: [u8; 2] in Utf8);
}

data Main {
    selected: Cell;
    line: CellLine;
    first: Cell;
    second: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.id = CellId::A1;
    main.first.label = "A1";
    main.second.id = CellId::A2;
    main.second.label = "A2";
    // `scan`'s `cell` parameter takes ownership of its argument, and these
    // calls sit inside a machine that reaches Console: a move out of `&mut
    // main` storage must be repaired before any service-reaching call or exit
    // edge. Each cell therefore crosses to the call through a local while an
    // equal value reseats its field, keeping `main` complete throughout.
    let first_cell: Cell = main.first;
    main.first = Cell { id: CellId::A1, label: "A1" };
    let second_cell: Cell = main.second;
    main.second = Cell { id: CellId::A2, label: "A2" };
    transition { _ -> scan(first_cell, CellId::A2, &mut main.selected) }
    transition { _ -> scan(second_cell, CellId::A2, &mut main.selected) }
    main.line.text = main.selected.label;
    Console::write_line(main.line.text);

    transition {
        _ -> main
    }


    state scan(cell: Cell, id: CellId, out_cell: &mut Cell) {
        transition {
            cell.id == id -> apply(cell, &mut out_cell)
            _ -> {}
        }
    }

    state apply(cell: Cell, out_cell: &mut Cell) {
        out_cell = cell;
    }
}
