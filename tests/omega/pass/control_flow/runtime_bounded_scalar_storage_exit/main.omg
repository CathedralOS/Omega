machine bump(mut value: u32) -> u32 requires value <= 4 {
    value = 4;
    (value)
}
machine local_value() -> u32 {
    let mut value: u32 = 1;
    value = 3;
    (value)
}
machine named_value(value: u32) -> u32 requires value <= 4 {
    transition { _ -> step(value) }
    machine step(mut current: u32) -> u32 requires current <= 4 {
        current = 2;
        (current)
    }
}
machine main() crashes Trap {
    let a: u32 = bump(3);
    let b: u32 = local_value();
    let c: u32 = named_value(4);
    transition a == 4 && b == 3 && c == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
