data Inner { value: u64; }
machine Inner::inspect(inner: &Inner) {}

data Outer { inner: Inner; }

// A nested argument path's head names this state's own binding. The path's
// last member symbol has `Outer` as its declaration parent, so recovering the
// head from that symbol's declaration chain never reaches the parameter. Both
// the entry parameter and a forwarded state parameter must lend a nested
// field explicitly.
machine inspect(outer: &Outer) {
    Inner::inspect(&outer.inner);
    transition { _ -> finish(outer) }
    machine finish(forwarded: &Outer) {
        Inner::inspect(&forwarded.inner);
    }
}
