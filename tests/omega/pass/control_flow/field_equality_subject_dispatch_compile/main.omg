// A `transition` subject may compare two members of the same record:
// `main.left == main.right` reads both fields and dispatches on their
// equality — member-member subjects compose like any expression.
data Main {
    left: u64;
    right: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.left = 5;
    main.right = 5;
    transition main.left == main.right {
        true -> same(main)
        _ -> differ(main)
    }

    machine same(main: &mut Main) { main.answer = 70; }
    machine differ(main: &mut Main) { main.answer = 71; }
}
