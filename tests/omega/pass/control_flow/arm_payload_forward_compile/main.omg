// Arm-bound payload names forward to the arm's target state:
// `Msg::Move { dx } -> use(main, dx)` hands the destructured field to `use`
// as its numeric parameter — pattern bindings are call arguments.
data Msg {
    case Move(dx: u64);
    case Stay;
}

data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let m: Msg = Msg::Move { dx: 70 };
    transition m {
        Msg::Move { dx } -> use(main, dx)
        _ -> bad(main)
    }

    machine use(main: &mut Main, amount: u64) { main.answer = amount; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
