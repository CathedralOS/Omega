// A hosted entry keeps `self` and lends the whole receiver into its states,
// the shape every migrated sample uses (`step(&mut self)` into
// `state step(main: &mut Main)`). `Main` holds a service binding, a plain byte
// array and a domain-qualified byte field, so it is not a plain record carrier.
// Every state receives the entry's receiver, directly or forwarded through
// `main`, so each keeps the invocation's own storage rather than declaring a
// borrowed block parameter Terminal admits only over plain carriers. The loop
// writes through the forwarded loan three times and stores a byte; exits 70
// only when the entry's storage holds both writes.

use omega_language_std::console;

domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    count: u64 in Wrapping;
    pause: [u8; 8];
    out: [u8; 4] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 3;
    transition { _ -> step(main) }

    state step(main: &mut Main) {
        main.count = main.count + 1;
        main.pause[2] = 7;
        transition main.count < 6 {
            true -> step(main)
            _ -> finish(main)
        }
    }

    state finish(main: &mut Main) {
        transition main.count == 6 && main.pause[2] == 7 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
