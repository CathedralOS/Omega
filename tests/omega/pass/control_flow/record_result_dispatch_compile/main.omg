// A state machine may return a record: `pick` reaches `u64` then hands
// the numeric answer to `wrap`, whose `done` state yields a `Pair` —
// dispatch results need not be scalars.
data Pair {
    a: u64;
    b: u64;
}

data Main { pair: Pair; }

machine Main::pick(n: u64) -> Pair
requires n <= 9
{
    transition n {
        9 -> wrap(n)
        _ -> flat(n)
    }
    machine wrap(n: u64) -> Pair { Pair { a: n, b: n } }
    machine flat(n: u64) -> Pair { Pair { a: n, b: 0 } }
}

machine Main::main(main: &mut Main) {
    main.pair = Main::pick(9);
}
