// `transition` dispatches on a bool subject with `true`/`false` literal
// arms — booleans are a two-case value space and need no wildcard when both
// arms are authored.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let ready: bool = 5 > 3;
    transition ready {
        true -> go(main)
        false -> stop(main)
    }

    machine go(main: &mut Main) { main.answer = 70; }
    machine stop(main: &mut Main) { main.answer = 71; }
}
