// A final `_` arm after the authored arms already cover every case is
// admitted and never selected (first-match order): it contributes no case
// edge, so a one-case dispatch still selects its sole case without a test.
// The never-selected arm may name a state no other edge reaches. Owned and
// borrowed subjects take the same route. Exits 70 when 30 + 40 arrive.
use omega_language_std::console;

data Only [copy] {
    case Sole;
}

data Pair {
    case Both(first: u64 in Wrapping, second: u64 in Wrapping);
}

machine Only::code(only: Only) -> u64 in Wrapping {
    transition only {
        Only::Sole -> value(30)
        _ -> value(31)
    }

    state value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

machine Pair::code(pair: &Pair) -> u64 in Wrapping {
    transition pair {
        Pair::Both { first, second } -> value(first + second)
        _ -> unselected()
    }

    state value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }

    state unselected() -> u64 in Wrapping {
        41
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let first: u64 in Wrapping = Only::code(Only::Sole);
    let pair: Pair = Pair::Both { first: 15, second: 25 };
    let second: u64 in Wrapping = Pair::code(&pair);
    transition first + second == 70 {
        true -> done(main, 70)
        _ -> done(main, 71)
    }

    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
