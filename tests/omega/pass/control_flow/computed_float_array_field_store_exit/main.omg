use omega::language::core::float_operations;
data Trace { a: [f64; 2]; b: [f64; 2]; observed: [f64; 2]; }
data Fit { amount_a: f64; amount_b: f64; reconstruction: [f64; 2]; residual: [f64; 2]; }
machine finish(trace: &Trace, fit: &mut Fit) {
 transition { _ -> scan(trace, fit, 0) }
 machine scan(trace: &Trace, fit: &mut Fit, index: i32 in Wrapping) {
  transition index >= 0 && index < 2 {
   true -> write(trace, fit, index)
   _ -> done()
  }
 }
 machine write(trace: &Trace, fit: &mut Fit, index: i32 in Wrapping) {
  let value: f64 = fit.amount_a * trace.a[index] + fit.amount_b * trace.b[index];
  fit.reconstruction[index] = value;
  fit.residual[index] = trace.observed[index] - value;
  transition { _ -> scan(trace, fit, index + 1) }
 }
 machine done() { }
}
machine main() crashes Trap {
 let trace: Trace = Trace { a: [1.0, 2.0], b: [0.0, 1.0], observed: [2.0, 7.0] };
 let mut fit: Fit;
 fit.amount_a = 2.0; fit.amount_b = 3.0;
 finish(&trace, &mut fit);
 transition fit.reconstruction[0] == 2.0 && fit.reconstruction[1] == 7.0
  && fit.residual[0] == 0.0 && fit.residual[1] == 0.0 {
  true -> done()
  _ -> bad()
 }
 machine done() { }
 machine bad() { crash Trap; }
}
