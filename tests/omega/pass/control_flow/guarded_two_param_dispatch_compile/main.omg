// A guarded arm may bind two payload fields and dispatch on one:
// `Count{lo, hi} if lo < hi` selects the in-order case while `Count{..}`
// catches the rest — guard projection on multi-field payloads.
data Count {
    case Ascending(lo: u64, hi: u64);
    case Flat(v: u64);
}

data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let count: Count = Count::Ascending { lo: 2, hi: 9 };
    transition count {
        Count::Ascending { lo, hi } if hi > lo -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
