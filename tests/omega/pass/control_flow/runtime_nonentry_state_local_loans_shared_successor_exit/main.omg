// Two different non-entry states each lend their own local record `&mut` to
// the same successor. Arrivals from the two lenders would join different
// live homes, so the successor's parameter holds whichever lender's storage
// moved in, and that storage dies where the successor leaves.
//
//   start = 3 selects `second`: closing.value = 3 + 1 = 4
//   settle: closing.bonus = 4 + 66 = 70
//
// exits: 70 = the second lender's storage reached the successor; 71 = the
// first lender ran instead; 72 = the successor read the wrong total.

use omega_language_std::console;
use omega::language::core::binding;

data Score { value: u64 in Wrapping; bonus: u64 in Wrapping; }

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let start: u64 = 3;
    transition start > 5 {
        true -> first(&main.console, start)
        _ -> second(&main.console, start)
    }

    state first(console: &Binding<Console>, start: u64) {
        let mut opening: Score;
        opening.value = start as u64 in Wrapping;
        transition { _ -> settle(console, &mut opening, 71) }
    }

    state second(console: &Binding<Console>, start: u64) {
        let mut closing: Score;
        closing.value = start as u64 in Wrapping;
        closing.value = closing.value + 1;
        transition { _ -> settle(console, &mut closing, 70) }
    }

    state settle(console: &Binding<Console>, score: &mut Score, code: i32) {
        score.bonus = score.value + 66;
        transition score.bonus == 70 {
            true -> refused(console, code)
            _ -> refused(console, 72)
        }
    }

    state refused(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
