// RUN CANARY (exit 70) + interpreter differential. Tuple case patterns bind
// payloads from more than one subject, keep those names in scope for the arm
// target, validate both payload spellings, and remain Cartesian-exhaustive
// without a `_` arm. The first arm binds two same-named payload fields under
// distinct aliases and passes both to the selected state. A second tuple arm
// destructures two computed copy-record subjects, proving each is captured
// exactly once before any field projection.
use omega_language_std::console;

data Cell {
    case Empty;
    case Value(n: i32);
}

data Point [copy] { x: i32; y: i32; }

data Main {
    left: Cell;
    right: Cell;
    calls: u32 in Wrapping;
}

machine Main::make(main: &mut Main, base: i32) -> Point {
    main.calls = main.calls + 1;
    transition { _ -> Point { x: base, y: 20 } }
}

machine Main::main(main: &mut Main) reaches Console {
    main.left = Cell::Value { n: 30 };
    main.right = Cell::Value { n: 40 };
    main.calls = 0;
    transition (main.left, main.right) {
        (Cell::Value { n as left_n }, Cell::Value { n as right_n }) -> sum(main, left_n, right_n)
        (Cell::Value { n as left_n }, Cell::Empty) -> wrong(main)
        (Cell::Empty, Cell::Value { n as right_n }) -> wrong(main)
        (Cell::Empty, Cell::Empty) -> wrong(main)
    }

    state sum(main: &mut Main, left_n: i32, right_n: i32) {
        transition (main.left, main.right) {
            (Cell::Value { n as guard_left }, Cell::Value { n as guard_right }) if (guard_left as i64) + (guard_right as i64) == (left_n as i64) + (right_n as i64) -> records(main)
            _ -> wrong(main)
        }
    }
    state records(main: &mut Main) {
        transition (Main::make(main, 10), Main::make(main, 20)) {
            (Point { x as ax, y as ay }, Point { x as bx, y as by }) -> check_points(main, ax, ay, bx, by)
            _ -> wrong(main)
        }
    }
    state check_points(main: &mut Main, ax: i32, ay: i32, bx: i32, by: i32) {
        transition main.calls == 2 && (ax as i64) + (ay as i64) + (bx as i64) + (by as i64) == 70 {
            true -> good(main)
            _ -> wrong(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state wrong(main: &mut Main) { Console::exit_process(71); }
}
