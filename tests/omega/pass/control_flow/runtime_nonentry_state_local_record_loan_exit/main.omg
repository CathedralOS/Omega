// A non-entry state declares its own local record and lends it `&mut` to a
// successor state. The transition is a tail jump, so the loan carries the
// local's storage with it; the successor writes through the loan, reads the
// write back, and the storage dies when the successor leaves. The entry's
// refused arm never visits the lender, so it has no storage to dispose.
//
// exits: 70 = the successor observed its own write over the lender's value;
// 71 = the entry guard failed; 72 = the successor read the wrong total.

use omega_language_std::console;
use omega::language::core::binding;

data Score { value: u64 in Wrapping; bonus: u64 in Wrapping; }

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let start: u64 = 3;
    transition start > 2 {
        true -> prepare(&main.console, start)
        _ -> refused(&main.console, 71)
    }

    state prepare(console: &Binding<Console>, start: u64) {
        let mut score: Score;
        score.value = start as u64 in Wrapping;
        transition { _ -> bump(console, &mut score) }
    }

    state bump(console: &Binding<Console>, score: &mut Score) {
        score.bonus = score.value + 67;
        transition score.bonus == 70 {
            true -> done(console)
            _ -> refused(console, 72)
        }
    }

    state done(console: &Binding<Console>) {
        Console::exit_process(console, 70);
    }

    state refused(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
