// Selected Boolean and restricted integer payloads keep their own cells and
// declared types. Arm snapshots survive replacing both selector and source.
data Choice { case Full(value: u32, ready: bool) where value < 100; case Empty; }
data Frame where selected < 2 { prefix: u64; items: [Choice; 2]; selected: u64; }
machine inspect(choice: &Choice) -> u32 ensures result < 100 {
    transition choice {
        Choice::Full { value, ready } -> selected(value, ready)
        Choice::Empty -> (0)
    }
    machine selected(value: u32, ready: bool) -> u32 requires value < 100 {
        transition ready { true -> (value) _ -> (0) }
    }
}
machine inspect_view(choices: &[Choice], index: u64) -> u32
requires index < choices.len
ensures result < 100 {
    transition choices[index] {
        Choice::Full { value, ready } -> selected(value, ready)
        Choice::Empty -> (0)
    }
    machine selected(value: u32, ready: bool) -> u32 requires value < 100 {
        transition ready { true -> (value) _ -> (0) }
    }
}
machine main() crashes Trap {
    let mut frame: Frame;
    frame.prefix = 19;
    frame.items[0] = Choice::Empty;
    frame.items[1] = Choice::Full { value: 70, ready: true };
    frame.selected = 1;
    let observed: u32 = inspect(&frame.items[frame.selected]);
    let viewed: u32 = inspect_view(&frame.items[..], frame.selected);
    transition frame.items[frame.selected] {
        Choice::Full { value, ready } -> saved(&mut frame, value, ready, observed, viewed)
        Choice::Empty -> bad()
    }
    machine saved(frame: &mut Frame, value: u32, ready: bool, observed: u32, viewed: u32)
    requires value < 100, observed < 100, viewed < 100 {
        frame.selected = 0;
        frame.items[1] = Choice::Empty;
        transition value == 70 && ready && observed == 70 && viewed == 70 && frame.prefix == 19 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
