// Selected Boolean and restricted integer payloads keep their own cells and
// declared types. Arm snapshots survive replacing both selector and source.
data Choice { case Full(value: u32[0..100], ready: bool); case Empty; }
data Frame { prefix: u64; items: [Choice; 2]; selected: u64[0..2]; }
machine inspect(choice: &Choice) -> u32[0..100] {
    transition choice {
        Choice::Full { value, ready } -> selected(value, ready)
        Choice::Empty -> (0)
    }
    state selected(value: u32[0..100], ready: bool) -> u32[0..100] {
        transition ready { true -> (value) _ -> (0) }
    }
}
machine inspect_view(choices: &[Choice], index: u64) -> u32[0..100]
requires index < choices.len {
    transition choices[index] {
        Choice::Full { value, ready } -> selected(value, ready)
        Choice::Empty -> (0)
    }
    state selected(value: u32[0..100], ready: bool) -> u32[0..100] {
        transition ready { true -> (value) _ -> (0) }
    }
}
machine main() crashes Trap {
    let mut frame: Frame;
    frame.prefix = 19;
    frame.items[0] = Choice::Empty;
    frame.items[1] = Choice::Full { value: 70, ready: true };
    frame.selected = 1;
    let observed: u32[0..100] = inspect(&frame.items[frame.selected]);
    let viewed: u32[0..100] = inspect_view(&frame.items[..], frame.selected);
    transition frame.items[frame.selected] {
        Choice::Full { value, ready } -> saved(&mut frame, value, ready, observed, viewed)
        Choice::Empty -> bad()
    }
    state saved(frame: &mut Frame, value: u32[0..100], ready: bool, observed: u32[0..100], viewed: u32[0..100]) {
        frame.selected = 0;
        frame.items[1] = Choice::Empty;
        transition value == 70 && ready && observed == 70 && viewed == 70 && frame.prefix == 19 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
