// PASS canary: a multi-state machine returning a SUM type, where each state
// closes on a `transition { _ -> (expr) }` tail — a value-returning
// transition arm at Unit level. Before this leg the composed state-graph
// route declined: the terminator only routed `Always -> Named` arms to a
// jump successor, and the lowering pairings refused an
// EstablishStructuralValue operation attached to the transition statement.
//
// pong additionally witnesses a conditional value pair — `When -> (expr)`
// beside the `Always -> (expr)` fallback on one transition.

use omega_language_std::console;

data Msg {
    case Ping(x: i32);
    case Pong(y: i32);
}

data Counter {
    n: i32;
}

machine Counter::pick(counter: &mut Counter) -> Msg {
    transition counter.n > 0 {
        true -> ping(counter)
        _ -> pong(counter)
    }

    state ping(counter: &mut Counter) -> Msg {
        transition {
            _ -> (Msg::Ping { x: counter.n })
        }
    }

    state pong(counter: &mut Counter) -> Msg {
        transition counter.n > 5 {
            true -> (Msg::Pong { y: 1 })
            _ -> (Msg::Pong { y: 0 })
        }
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut counter: Counter = Counter { n: 10 };

    transition Counter::pick(&mut counter) {
        Msg::Ping { x } -> pinged(main, x)
        Msg::Pong { y } -> ponged(main, y)
    }

    state pinged(main: &mut Main, x: i32) {
        Console::exit_process(x);
    }

    state ponged(main: &mut Main, y: i32) {
        Console::exit_process(y);
    }
}
