// Both selected cases have nonzero tags; their payload is constructed by a
// runtime helper, not inferred from zero storage or a known caller case.
data Base [copy] { case Decimal; case Hex; }
data Token [copy] {
    case Word;
    case Integer(base: Base, empty: bool, count: u64);
}

machine make(base: Base, count: u64) -> Token {
    Token::Integer { base: base, empty: false, count: count }
}

machine observe(token: Token) -> u64 {
    // Matching the nested enum must preserve the enclosing Integer fact for
    // the later scalar payload tests and the selected arm's payload read.
    transition token {
        Token::Integer { base: Base::Hex, empty: false, count: 70 } -> (token.count)
        _ -> (1)
    }
}

machine main() crashes Trap {
    let matched: u64 = observe(make(Base::Hex, 70));
    let wrong_outer: u64 = observe(Token::Word {});
    let wrong_nested: u64 = observe(make(Base::Decimal, 70));
    let wrong_payload: u64 = observe(make(Base::Hex, 71));
    transition matched == 70 && wrong_outer == 1
        && wrong_nested == 1 && wrong_payload == 1 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
