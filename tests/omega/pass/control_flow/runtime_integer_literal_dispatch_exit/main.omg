use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let mut choice: i32 = 2;

    transition choice {
        1 -> one(&mut self)
        2 -> two(&mut self)
        _ -> other(&mut self)
    }

    state one(main: &mut Main) {
        main.console.exit_process(21);
    }

    state two(main: &mut Main) {
        main.console.exit_process(22);
    }

    state other(main: &mut Main) {
        main.console.exit_process(29);
    }
}
