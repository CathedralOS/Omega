use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let mut choice: i32 = 2;

    transition choice {
        1 -> one()
        2 -> two()
        _ -> other()
    }

    state one(&mut self) {
        self.console.exit_process(21);
    }

    state two(&mut self) {
        self.console.exit_process(22);
    }

    state other(&mut self) {
        self.console.exit_process(29);
    }
}
