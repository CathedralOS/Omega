use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut choice: i32 = 2;

    transition choice {
        1 -> one(main)
        2 -> two(main)
        _ -> other(main)
    }

    state one(main: &mut Main) {
        main.console.exit_process(21);
    }

    state two(main: &mut Main) {
        main.console.exit_process(22);
    }

    state other(main: &mut Main) {
        main.console.exit_process(29);
    }
}
