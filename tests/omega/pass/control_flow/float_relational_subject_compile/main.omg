// A `transition` subject may compare a float member to a literal bound:
// `main.rate >= 1.0` — relational subjects evaluate on floats as on
// integers.
data Main {
    rate: f64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 1.5;
    transition main.rate >= 1.0 {
        true -> enough(main)
        _ -> low(main)
    }

    machine enough(main: &mut Main) { main.answer = 70; }
    machine low(main: &mut Main) { main.answer = 71; }
}
