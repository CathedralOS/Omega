// A named state receives an entry-local struct through an explicit transition
// argument, then resolves nested member and indexed-field accesses on its own
// parameter.

data Header {
    room_id: u32;
}

data Packet {
    header: Header;
    samples: [i32; 4];
}

data Main {
}

machine Main::main(&mut self) {
    let packet: Packet = Packet {
        header: Header { room_id: 300 },
        samples: [150, 0 - 2, 0, 0]
    };

    transition {
        _ -> check_packet(packet)
    }

    state check_packet(&mut self, packet: Packet) {
        transition packet.header.room_id == 300 && packet.samples[0] == 150 {
            true -> {}
            _ -> {}
        }
    }
}
