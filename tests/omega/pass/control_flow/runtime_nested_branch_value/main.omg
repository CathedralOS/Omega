data Main {
    out: u32;
}

machine Main::main(&mut self) {
    let flag: bool = true;
    self.out = self.pick(flag);
}

machine Main::pick(&mut self, flag: bool) -> u32 {
    transition {
        flag -> self.branch(flag)
        _ -> 0
    }
}

machine Main::branch(&mut self, flag: bool) -> u32 {
    transition {
        flag -> 1
        _ -> 2
    }
}
