// A `transition` may dispatch on a float subject with float literal arms:
// `1.5 ->` matches the exact bit pattern, and the wildcard absorbs the rest.
// Float equality is bitwise, so `0.0` and `-0.0` are distinct arm values.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let rate: f64 = 1.5;
    transition rate {
        0.5 -> half(main)
        1.5 -> full(main)
        _ -> miss(main)
    }

    machine half(main: &mut Main) { main.answer = 70; }
    machine full(main: &mut Main) { main.answer = 71; }
    machine miss(main: &mut Main) { main.answer = 72; }
}
