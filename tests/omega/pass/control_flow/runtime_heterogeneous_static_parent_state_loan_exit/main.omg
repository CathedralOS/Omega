data Payload [copy] { value:u32 in Wrapping; }
data Cell [copy] { payload:Payload; }
data OtherCell [copy] { payload:Payload; spare:u8; }
data Cursor where position < 2 { position:u64; calls:u32 in Wrapping; }
machine select(cursor:&mut Cursor)->u64 ensures result < 2 {
 let chosen:u64=cursor.position;
 cursor.calls=cursor.calls+1;
 cursor.position=1;
 chosen
}
machine mark(cell:&mut Cell,amount:u32 in Wrapping)->u32 in Wrapping {
 cell.payload.value=cell.payload.value+amount;
 cell.payload.value
}
machine observe(value:u32 in Wrapping,cell:&Payload,cursor:&Cursor)->u32 in Wrapping {
 value*100+cell.value*10+cursor.calls
}
machine mark_other(cell:&mut OtherCell,amount:u32 in Wrapping)->u32 in Wrapping { cell.payload.value=cell.payload.value+amount; cell.payload.value }
machine report(value:u32 in Wrapping,cursor:&Cursor)->u32 in Wrapping {
 value*100+cursor.calls*10
}
machine pack(prefix:u32 in Wrapping,value:u32 in Wrapping)->u32 in Wrapping {prefix*10000+value}
machine update(cells:&mut [Cell;2],others:&mut [OtherCell;2],cursor:&mut Cursor,flag:bool)->u32 in Wrapping {
 transition flag { true -> choose_first(&mut cells[0],cursor) _ -> choose_second(&mut others[0],cursor) }
 machine choose_first(cell:&mut Cell,cursor:&Cursor)->u32 in Wrapping {
  let changed:u32 in Wrapping=mark(cell,5);
  transition { _ -> audit(changed,&cell.payload,cursor) }
 }
 machine choose_second(cell:&mut OtherCell,cursor:&Cursor)->u32 in Wrapping {
  let changed:u32 in Wrapping=mark_other(cell,5);
  transition { _ -> audit(changed,&cell.payload,cursor) }
 }
 machine audit(changed:u32 in Wrapping,cell:&Payload,cursor:&Cursor)->u32 in Wrapping { observe(changed,cell,cursor) }
}
machine main() crashes Trap {
 let mut cells:[Cell;2]=[Cell{payload:Payload{value:7}},Cell{payload:Payload{value:3}}];
 let mut others:[OtherCell;2]=[OtherCell{payload:Payload{value:7},spare:0},OtherCell{payload:Payload{value:3},spare:0}];
 let mut cursor:Cursor=Cursor{position:0,calls:0};
 let observed:u32 in Wrapping=update(&mut cells,&mut others,&mut cursor,true);
 let second:u32 in Wrapping=update(&mut cells,&mut others,&mut cursor,false);
 transition observed==1320 && second==1320 && cells[0].payload.value==12 && cells[1].payload.value==3 && others[0].payload.value==12 && others[1].payload.value==3 && cursor.calls==0 && cursor.position==0 {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
