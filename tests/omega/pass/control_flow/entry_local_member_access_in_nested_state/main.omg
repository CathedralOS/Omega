// A named state reads a field of an entry-local struct explicitly passed as
// a transition argument. Member resolution uses the target state's parameter.

data Header {
    room_id: u32;
}

data Main {
}

machine Main::main(&mut self) {
    let header: Header = Header { room_id: 300 };

    transition {
        _ -> check_header(header)
    }

    state check_header(&mut self, header: Header) {
        transition header.room_id == 300 {
            true -> {}
            _ -> {}
        }
    }
}
