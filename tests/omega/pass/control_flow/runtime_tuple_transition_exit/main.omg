// Tuple dispatch forwards its explicit context through the selected state
// edge. The scalar result completes the invocation and returns to the caller.
// Expected exit: 22.
use omega_language_std::console;

data Main {
}

machine Main::run(context: &mut Main) -> i32 {
    transition {
        _ -> classify(context, false, true)
    }

    machine classify(context: &mut Main, left: bool, right: bool) -> i32 {
        transition (left, right) {
            (true, _) -> done_11(context)
            (false, true) -> done_22(context)
            // The final arm is the (false, false) case, spelled `_` so the
            // dispatch provably closes (tuple-conjunction coverage is not
            // counted by the exhaustiveness pass).
            _ -> done_33(context)
        }
    }

    machine done_11(context: &mut Main) -> i32 {
        11
    }

    machine done_22(context: &mut Main) -> i32 {
        22
    }

    machine done_33(context: &mut Main) -> i32 {
        33
    }
}

machine Main::main(context: &mut Main) reaches Console {
    let result: i32 = Main::run(context);
    Console::exit_process(result);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
