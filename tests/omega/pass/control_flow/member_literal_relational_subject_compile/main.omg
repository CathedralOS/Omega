// A `transition` subject may compare a member to a literal bound:
// `main.count < 10` — relational subjects evaluate the projection and
// dispatch on the result.
data Main {
    count: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.count = 7;
    transition main.count < 10 {
        true -> few(main)
        _ -> many(main)
    }

    machine few(main: &mut Main) { main.answer = 70; }
    machine many(main: &mut Main) { main.answer = 71; }
}
