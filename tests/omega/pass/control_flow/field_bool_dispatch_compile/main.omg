// `transition` dispatches on a record's bool FIELD: `transition main.ready`
// evaluates the member once and selects — no local copy needed. Field
// subjects and local subjects share the same dispatch.
data Main {
    ready: bool;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.ready = true;
    transition main.ready {
        true -> go(main)
        false -> stop(main)
    }

    machine go(main: &mut Main) { main.answer = 70; }
    machine stop(main: &mut Main) { main.answer = 71; }
}
