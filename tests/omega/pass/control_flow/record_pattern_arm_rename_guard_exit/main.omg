// The record (non-case) arm face of the shared grammar: `Point { x, y as
// vertical } if x + vertical == 70` -- no tag compare (the subject IS the
// type); the renamed binding participates in the if-guard rewrite.
// Run-verified: 30 + 40 = 70.
use omega_language_std::console;
data Point { x: i32; y: i32; }
data Main { console: Console; }
machine Main::main(&mut self) {
    self.judge(Point { x: 30, y: 40 });
}
machine Main::judge(&mut self, p: Point) {
    transition p {
        Point { x, y as vertical } if x + vertical == 70 -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(1); }
}
