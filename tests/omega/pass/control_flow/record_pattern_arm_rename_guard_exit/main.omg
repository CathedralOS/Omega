// The record (non-case) arm face of the shared grammar: `Point { x, y as
// vertical } if x + vertical == 70` -- no tag compare (the subject IS the
// type); the renamed binding participates in the if-guard rewrite. The
// guard widens before adding: exact i32 addition owes its own range proof.
// Run-verified: 30 + 40 = 70.
use omega_language_std::console;
data Point { x: i32; y: i32; }
data Main { }
machine Main::main(main: &mut Main) {
    Main::judge(main, Point { x: 30, y: 40 });
}
machine Main::judge(main: &mut Main, p: Point) reaches Console {
    transition p {
        Point { x, y as vertical } if x as i64 + vertical as i64 == 70 -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
