// A non-entry state lends its own local record `&mut` to a successor, which
// writes through the loan and forwards it whole to a second state. The second
// state writes again and reads both writes back; the storage moves along the
// whole loan chain and dies where the second state leaves.
//
//   prepare   score.value = 3
//   bump      score.bonus = 3 + 60 = 63, forwards the loan
//   settle    tally.value = 63 + 7 = 70
//
// exits: 70 = both writes reached the shared storage; 71 = the entry guard
// failed; 72 = bump read the wrong value; 73 = settle read the wrong value.

use omega_language_std::console;

data Score { value: u64 in Wrapping; bonus: u64 in Wrapping; }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let start: u64 = 3;
    transition start > 2 {
        true -> prepare(start)
        _ -> refused(71)
    }

    state prepare(start: u64) {
        let mut score: Score;
        score.value = start as u64 in Wrapping;
        transition { _ -> bump(&mut score) }
    }

    state bump(score: &mut Score) {
        score.bonus = score.value + 60;
        transition score.bonus == 63 {
            true -> settle(score)
            _ -> refused(72)
        }
    }

    state settle(tally: &mut Score) {
        tally.value = tally.bonus + 7;
        transition tally.value == 70 {
            true -> done()
            _ -> refused(73)
        }
    }

    state done() {
        Console::exit_process(70);
    }

    state refused(code: i32) {
        Console::exit_process(code);
    }
}
