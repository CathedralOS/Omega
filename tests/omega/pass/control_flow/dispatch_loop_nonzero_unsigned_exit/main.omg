machine countdown(output: &mut u32, eax: u32) requires eax > 0 {
 transition { _ -> loop(output, eax) }
 machine loop(output: &mut u32, eax: u32) requires eax > 0 {
  let next: u32 = (((eax as u32 in Wrapping) - (1 as u32 in Wrapping)) as u32);
  let next_flag: bool = next == 0;
  transition { !next_flag -> loop(output, next) _ -> done(output, next) }
 }
 machine done(output: &mut u32, eax: u32) requires eax == 0 { output = eax; transition { _ -> {} } }
}
machine main() crashes Trap {
 let mut output: u32 = 99;
 countdown(&mut output, 2);
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
