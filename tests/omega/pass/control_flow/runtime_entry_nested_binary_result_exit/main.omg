// Nested runtime arithmetic at an ordinary value-machine terminal is
// represented as recursive value operands before the final result-scratch
// write. The Unit entry consumes that result before exiting explicitly.
use omega_language_std::console;

data Main { console: Console; a: i32; b: i32; c: i32; }

machine Main::computed(&mut self) -> i32 {
    self.a = 10;
    self.b = 20;
    self.c = 30;
    transition { _ -> (self.a + ((self.b * self.c) / 10)) }
}

machine Main::main(&mut self) {
    let result: i32 = self.computed();
    self.console.exit_process(result);
}
