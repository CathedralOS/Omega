use omega_language_std::console;

data Payload { value: i32; }

machine identity(payload: Payload) -> Payload { payload }

machine forward(payload: Payload, selected: bool) -> i32 {
    transition selected {
        true -> take(identity(payload))
        false -> take(Payload { value: 71 })
    }
    state take(payload: Payload) -> i32 { payload.value }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let first: Payload = Payload { value: 70 };
    let second: Payload = Payload { value: 12 };
    let selected: i32 = forward(first, true);
    let unselected: i32 = forward(second, false);
    transition selected == 70 && unselected == 71 {
        true -> good()
        false -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(72); }
}
