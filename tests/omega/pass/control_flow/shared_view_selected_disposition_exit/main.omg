data Choice [copy] { case Forward; case End; case Return; }
data Holder { bytes: [u8; 2]; calls: u64; }

machine observe(bytes: &[u8]) -> u64 { bytes.len }

machine select(bytes: &[u8; 2], choice: Choice) -> u64 {
    let view: &[u8] = &bytes[..];
    let observed: u64 = observe(view);
    transition choice {
        Choice::Forward -> forwarded(view)
        Choice::End -> ended(observed)
        Choice::Return -> observed
    }
    machine forwarded(view: &[u8]) -> u64 { view.len }
    machine ended(observed: u64) -> u64 { observed }
}

machine narrowed(holder: &mut Holder) -> &[u8] {
    holder.calls = ((holder.calls as u64 in Wrapping) + 1) as u64;
    holder.bytes[1..2]
}

machine returned_view(holder: &mut Holder, choice: Choice) -> u64 {
    let view: &[u8] = narrowed(holder);
    let observed: u64 = observe(view);
    transition choice {
        Choice::Forward -> forwarded(view)
        Choice::End -> ended(observed)
        Choice::Return -> observed
    }
    machine forwarded(view: &[u8]) -> u64 { view.len }
    machine ended(observed: u64) -> u64 { observed }
}

machine main() crashes Trap {
    let bytes: [u8; 2] = [11, 22];
    let forwarded: u64 = select(&bytes, Choice::Forward);
    let ended: u64 = select(&bytes, Choice::End);
    let returned: u64 = select(&bytes, Choice::Return);
    let mut holder: Holder = Holder { bytes: [11, 22], calls: 0 };
    let narrowed_forward: u64 = returned_view(&mut holder, Choice::Forward);
    let narrowed_end: u64 = returned_view(&mut holder, Choice::End);
    let narrowed_return: u64 = returned_view(&mut holder, Choice::Return);
    transition forwarded == 2 && ended == 2 && returned == 2
        && narrowed_forward == 1 && narrowed_end == 1 && narrowed_return == 1
        && holder.calls == 3 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
