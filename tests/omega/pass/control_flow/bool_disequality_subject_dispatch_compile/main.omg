// A `transition` subject may compare a bool member by disequality:
// `main.flag != true` — the same dispatch logic as `==`, inverted.
data Main {
    flag: bool;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.flag = false;
    transition main.flag != true {
        true -> clear(main)
        _ -> set(main)
    }

    machine clear(main: &mut Main) { main.answer = 70; }
    machine set(main: &mut Main) { main.answer = 71; }
}
