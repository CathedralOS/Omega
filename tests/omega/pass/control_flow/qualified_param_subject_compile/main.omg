// A `transition` subject may be a domain-qualified parameter:
// `check(n: u64 in Tiny)` receives the bounded value and dispatches on
// it — the qualification rides along into the callee's arms.
domain u64::Tiny(value)
requires
    value <= 4;

data Main { answer: u64; }

machine Main::check(n: u64 in Tiny) -> u64 {
    transition n {
        3 -> hit()
        _ -> miss()
    }
    machine hit() -> u64 { 70 }
    machine miss() -> u64 { 71 }
}

machine Main::main(main: &mut Main) {
    main.answer = Main::check(3);
}
