data Leaf [copy] { value:u32 in Wrapping; }
data Payload [copy] { leaf:Leaf; }
data Cell [copy] { payload:Payload; }
data Cursor where position < 2 { position:u64; calls:u32 in Wrapping; }
machine select(cursor:&mut Cursor)->u64 ensures result < 2 {
 let chosen:u64=cursor.position;
 cursor.calls=cursor.calls+1;
 cursor.position=1;
 chosen
}
machine mark(cell:&mut Cell,amount:u32 in Wrapping)->u32 in Wrapping {
 cell.payload.leaf.value=cell.payload.leaf.value+amount;
 cell.payload.leaf.value
}
machine observe(value:u32 in Wrapping,cell:&Leaf,cursor:&Cursor)->u32 in Wrapping {
 value*100+cell.value*10+cursor.calls
}
machine report(value:u32 in Wrapping,cursor:&Cursor)->u32 in Wrapping {
 value*100+cursor.calls*10
}
machine pack(prefix:u32 in Wrapping,value:u32 in Wrapping)->u32 in Wrapping {prefix*10000+value}
machine update(cells:&mut [Cell;2],cursor:&mut Cursor)->u32 in Wrapping {
 transition { _ -> apply(&mut cells[select(cursor)],cursor) }
 machine apply(cell:&mut Cell,cursor:&Cursor)->u32 in Wrapping {
  let changed:u32 in Wrapping=mark(cell,5);
  transition { _ -> audit(changed,&cell.payload,cursor) }
 }
 machine audit(changed:u32 in Wrapping,cell:&Payload,cursor:&Cursor)->u32 in Wrapping {
  transition { _ -> leaf(changed,&cell.leaf,cursor) }
 }
 machine leaf(changed:u32 in Wrapping,cell:&Leaf,cursor:&Cursor)->u32 in Wrapping {
  observe(changed,cell,cursor)
 }
}
machine main() crashes Trap {
 let mut cells:[Cell;2]=[Cell{payload:Payload{leaf:Leaf{value:7}}},Cell{payload:Payload{leaf:Leaf{value:3}}}];
 let mut cursor:Cursor=Cursor{position:0,calls:0};
 let observed:u32 in Wrapping=update(&mut cells,&mut cursor);
 transition observed==1321 && cells[0].payload.leaf.value==12 && cells[1].payload.leaf.value==3 && cursor.calls==1 && cursor.position==1 {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
