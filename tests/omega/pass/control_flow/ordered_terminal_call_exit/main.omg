// The selected terminal call runs once and completes its invocation. Later
// authored arms remain checked but execute neither their arguments nor targets.
data Counter { calls: u64 in Wrapping; }
data Item { value: u64; }
machine increment(counter: &mut Counter) -> u64 {
    counter.calls = counter.calls + 1;
    37
}
machine issue(value: u64) -> Item { Item { value: value } }
machine identity(value: u64) -> u64 { value }
machine observe(counter: &mut Counter) { counter.calls = counter.calls + 1; }
machine forbidden_value() -> u64 crashes Trap { crash Trap; }
machine forbidden_item() -> Item crashes Trap { crash Trap; }
machine forbidden_unit() crashes Trap { crash Trap; }
machine record(counter: &mut Counter) -> Item crashes Trap {
    transition {
        _ -> issue(increment(counter))
        _ -> forbidden_item()
    }
}
machine scalar(counter: &mut Counter) -> u64 crashes Trap {
    transition {
        _ -> identity(increment(counter))
        _ -> identity(forbidden_value())
    }
}
machine unit(counter: &mut Counter) crashes Trap {
    transition { _ -> observe(counter) _ -> forbidden_unit() }
}
machine arrived(counter: &mut Counter) -> Item crashes Trap {
    transition { _ -> selected(counter) }
    state selected(current: &mut Counter) -> Item {
        transition { _ -> issue(increment(current)) _ -> forbidden_item() }
    }
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { calls: 0 };
    let item: Item = record(&mut counter);
    let value: u64 = scalar(&mut counter);
    unit(&mut counter);
    let other: Item = arrived(&mut counter);
    transition item.value == 37 && value == 37 && other.value == 37 && counter.calls == 4 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
