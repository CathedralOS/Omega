use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    count: i32;
}

machine Main::terminal_field(&mut self) -> i32 {
    self.count = 70;
    self.count
}

machine Main::main(&mut self) reaches Console {
    let result: i32 = self.terminal_field();
    self.console.exit_process(result);
}
