use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Service<Console>;
    flag: bool;
}

machine Main::main(&mut self) reaches Console {
    self.flag = false;

    transition {
        _ -> check(self.flag == false)
    }

    state check(&mut self, flag_ok: bool) {
        transition flag_ok {
            (true) -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(211);
    }

    state bad(&mut self) {
        self.console.exit_process(212);
    }
}
