use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Service<Console>;
    left: bool;
    right: bool;
}

machine Main::main(&mut self) reaches Console {
    self.left = true;
    self.right = false;

    transition (self.left == false || self.right == false) {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(71);
    }

    state bad(&mut self) {
        self.console.exit_process(72);
    }
}
