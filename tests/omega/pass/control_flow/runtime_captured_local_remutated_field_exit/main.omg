// A `let`-local that CAPTURES a field-reading expression, where the field is
// reassigned BEFORE the local is forwarded through a nested dispatch.
//
//   let new_sp = main.vm.sp + 1;   // capture (sp was 0 -> new_sp = 1)
//   main.vm.sp = new_sp;           // main.vm.sp is now 1
//   transition new_sp == 0 { _ -> try_push1(new_sp, value) }
//   // try_push1: transition new_sp == 1 { true -> push1(value) ... }
//
// Regression: argument materialization inline-FOLDED `new_sp` back into its
// initializer `main.vm.sp + 1` and re-evaluated it at the transition -- but by
// then `main.vm.sp` had been overwritten with new_sp, so the fold yielded
// new_sp + 1 = 2. try_push1's guard `new_sp == 1` then saw 2, took the wrong arm
// (push2 instead of push1), and stack[1] was never written. The fix keeps the
// captured slot (which holds the correct pre-mutation 1) instead of re-folding.
// Pushes 3 then 4; if both land (stack[0]=3, stack[1]=4) exits 70.

use omega_language_std::console;
use omega::language::core::binding;

data Vm [copy] {
    stack: [i32 in Wrapping; 8];
    sp: i32 in Wrapping;
}

data Main {
    console: Binding<Console>;
    vm: Vm;
}

machine Main::init(main: &mut Main) {
    main.vm.sp = 0 - 1;
}

machine Main::push(main: &mut Main, value: i32 in Wrapping) {
    let new_sp: i32 in Wrapping = main.vm.sp + 1;
    main.vm.sp = new_sp;
    transition new_sp == 0 {
        true -> push0(main, value)
        _ -> try_push1(main, new_sp, value)
    }
    state push0(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[0] = value; }
    state try_push1(main: &mut Main, new_sp: i32 in Wrapping, value: i32 in Wrapping) {
        transition new_sp == 1 {
            true -> push1(main, value)
            _ -> push2(main, value)
        }
    }
    state push1(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[1] = value; }
    state push2(main: &mut Main, value: i32 in Wrapping) { main.vm.stack[2] = value; }
}

machine Main::main(main: &mut Main) reaches Console {
    Main::init(main);
    Main::push(main, 3);
    Main::push(main, 4);

    transition main.vm.stack[1] == 4 {
        true -> check0(main)
        _ -> bad(main)
    }
    state check0(main: &mut Main) {
        transition main.vm.stack[0] == 3 {
            true -> good(main)
            _ -> bad0(main)
        }
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
    state bad0(main: &mut Main) { main.console.exit_process(72); }
}
