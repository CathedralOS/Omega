data Token { case Invalid; case Values(tiny: i8, short: i16, word: i32, positive: u16); }
machine values() -> Token {
 Token::Values { tiny: -7, short: -257, word: -1, positive: 65535 }
}
machine main() crashes Trap {
 let item: Token = values();
 transition item {
  Token::Values { tiny, short, word, positive } -> verify(tiny, short, word, positive)
  _ -> bad()
 }
 machine verify(tiny: i8, short: i16, word: i32, positive: u16) {
  transition tiny < 0 && short < 0 && word < 0 && positive == 65535
   && tiny == -7 && short == -257 && word == -1 {
   true -> done()
   _ -> bad()
  }
 }
 machine done() {}
 machine bad() { crash Trap; }
}
