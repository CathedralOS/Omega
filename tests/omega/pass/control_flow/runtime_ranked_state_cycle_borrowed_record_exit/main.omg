// A Unit machine's ranked state cycle carries a borrowed record through each
// step and writes it. The composed state graph lowers the cycle under its
// natural rank; the caller observes the last step's write.
use omega_language_std::console;

data Tally { count: u64; }
data Main { tally: Tally; }

machine drain(remaining: u32, tally: &mut Tally)
terminates by remaining;
requires remaining <= 5
{
    transition remaining > 0 {
        true -> step(remaining - 1, tally)
        false -> finish(tally)
    }
    machine step(left: u32, counted: &mut Tally)
    requires left <= 5
    {
        counted.count = (left as u64) * 10 + 5;
        transition left > 0 {
            true -> step(left - 1, counted)
            false -> finish(counted)
        }
    }
    machine finish(done: &mut Tally) {}
}

machine Main::main(main: &mut Main) reaches Console {
    drain(3, &mut main.tally);
    transition main.tally.count == 5 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
