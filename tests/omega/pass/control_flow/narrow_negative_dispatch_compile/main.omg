// `transition` arms match narrow signed literals: an `i16` subject
// dispatches on `-7` — literal arms carry their own width, so narrow
// negatives need no widening step.
data Main {
    small: i16;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.small = 0 - 7;
    transition main.small {
        -7 -> below(main)
        _ -> other(main)
    }

    machine below(main: &mut Main) { main.answer = 70; }
    machine other(main: &mut Main) { main.answer = 71; }
}
