use omega_language_std::console;

data Choice { case Full(n: u64 in Wrapping); case Empty; }
data Main where selected <= 1 {
    items: [Choice; 2];
    selected: u64;
}

machine inspect(items: &[Choice; 2], index: u64) -> u64 in Wrapping requires index <= 1 {
    let selected: &Choice = &items[index];
    transition selected {
        // This reborrow is evaluated in the selected arm, not in its guard.
        Choice::Full { n } -> forward(&selected, n)
        Choice::Empty -> (0)
    }
    machine forward(choice: &Choice, snapshot: u64 in Wrapping) -> u64 in Wrapping {
        // The forwarded descriptor must still denote the captured referent.
        transition choice {
            Choice::Full { n } -> (snapshot + n)
            Choice::Empty -> (0)
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Choice::Empty;
    main.items[1] = Choice::Full { n: 35 };
    main.selected = 1;
    let present: u64 in Wrapping = inspect(&main.items, main.selected);
    let absent: u64 in Wrapping = inspect(&main.items, 0);
    transition present == 70 && absent == 0 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
