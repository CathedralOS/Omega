// An exhaustive case dispatch with no `_` arm whose subject is a field
// projection: of a local record copied out of a borrowed array
// (`item.kind`), and of the borrowed element itself
// (`output.items[index].shape`). Each arm's guard compares that place with
// one known payload-free case, which is the place's membership in that case,
// so coverage proves the last arm is the dispatch's else. Comparing whole
// case rosters instead hid the case from coverage, and both states had no
// executable body ("guarded pair without exact false fallback").
// The two-case dispatch takes the guarded-pair route, the three-case one the
// ordered roster; element 2 holds `Data`/`Plane` -> exit 70.
use omega_language_std::console;

data Kind [copy] { case Use; case Data; }
data Shape [copy] { case Point; case Line; case Plane; }
data Item [copy] { kind: Kind; shape: Shape; }
data Output { items: [Item; 4]; }

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut output: Output;
    output.items[2] = Item { kind: Kind::Data, shape: Shape::Plane };
    transition { _ -> classify(main, &output, 2) }

    state classify(main: &mut Main, output: &Output, index: u64 [0..=3]) {
        let item: Item = output.items[index];
        transition item.kind {
            Kind::Use -> wrong(main)
            Kind::Data -> shape(main, output, index)
        }
    }

    state shape(main: &mut Main, output: &Output, index: u64 [0..=3]) {
        transition output.items[index].shape {
            Shape::Point -> wrong(main)
            Shape::Line -> wrong(main)
            Shape::Plane -> found(main)
        }
    }

    state wrong(main: &mut Main) { Console::exit_process(1); }
    state found(main: &mut Main) { Console::exit_process(70); }
}
