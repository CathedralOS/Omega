// A transition arm may forward several values into the next state:
// `-> weigh(main, 2, 4)` carries two payload arguments alongside `main` —
// the arm's argument list is a positional tuple of the state's params.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    transition 7 {
        7 -> weigh(main, 2, 4)
        _ -> miss(main)
    }

    machine weigh(main: &mut Main, first: u64, second: u64) {
        transition first + second {
            6 -> even(main)
            _ -> odd(main)
        }
    }

    machine even(main: &mut Main) { main.answer = 70; }
    machine odd(main: &mut Main) { main.answer = 71; }
    machine miss(main: &mut Main) { main.answer = 72; }
}
