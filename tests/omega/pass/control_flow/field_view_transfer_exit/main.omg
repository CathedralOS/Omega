// PASS canary: transition edges forward slice-view FIELDS of the receiver —
// `-> state(store.names, store.cells)` where both fields are stored views —
// not just a whole parameter. The state-graph transfer gate only admitted
// empty-place sources before this leg; a record field spelled directly
// declined "parameter transfer: no source place".
//
// Two admissions witnessed together on one edge:
//   1. a `&'ext [u8]` field into a `&[u8]` state parameter (shared view),
//   2. a `&'ext mut [u8]` field into a `&mut [u8]` parameter (mutable
//      re-borrow of the descriptor the field stores).
// The edge forwards disjoint fields rather than the record beside its own
// field: `&mut store` and `store.cells` would be two live mutable paths to the
// same view.

use omega_language_std::console;

data Store<'ext> {
    names: &'ext [u8];
    cells: &'ext mut [u8];
}

machine Store::probe<'ext>(store: &mut Store) -> u64 {
    transition store.cells.len > 0 && store.names.len > 0 {
        true -> write(store.names, store.cells)
        _ -> missed()
    }

    // Shared and mutable field views forwarded into `&` / `&mut` parameters.
    state write(names: &'ext [u8], cells: &'ext mut [u8]) -> u64
        requires cells.len > 0
    {
        cells[0] = 70;
        transition names.len > 0 {
            true -> share(names)
            _ -> missed()
        }
    }

    // The shared view parameter forwarded again across the next edge.
    state share(names: &'ext [u8]) -> u64
        requires names.len > 0
    {
        transition names[0] == 7 {
            true -> done()
            _ -> missed()
        }
    }

    state done() -> u64 {
        transition { _ -> (70) }
    }

    state missed() -> u64 {
        transition { _ -> (9) }
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(0);
}
