// One transition may carry several case arms with payload bindings and
// a wildcard: `Act` offers `Push{v}` and `Drop`, each destructured by
// its own pattern arm — multi-case dispatch in a single decision.
data Act {
    case Push(v: u64);
    case Drop;
}

data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let act: Act = Act::Push { v: 70 };
    transition act {
        Act::Push { v } -> push(main, v)
        Act::Drop -> drop(main)
        _ -> bad(main)
    }

    machine push(main: &mut Main, v: u64) { main.answer = v; }
    machine drop(main: &mut Main) { main.answer = 71; }
    machine bad(main: &mut Main) { main.answer = 72; }
}
