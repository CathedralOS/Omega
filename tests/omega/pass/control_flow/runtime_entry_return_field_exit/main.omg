// A raw COMPUTED terminal in an ordinary value machine must pass through its
// normalized result placement rather than silently leaving the return register
// untouched. The Unit entry consumes that result and exits explicitly.
// Exit = 200, native==interp.
use omega_language_std::console;

data Main { console: Console; a: i32; }
machine Main::computed(&mut self) -> i32 {
    self.a = 100;
    transition { _ -> (self.a + 100) }
}

machine Main::main(&mut self) {
    let result: i32 = self.computed();
    self.console.exit_process(result);
}
