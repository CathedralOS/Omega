// RUN CANARY (exit 70). A NO-PAYLOAD case variant declared AFTER payload-bearing
// variants must be reachable when dispatched. Regression guard for the native
// miscompile where `AlarmEvent::Trigger` (a bare variant path, ordinal 3) was
// materialized as a place-copy instead of a tag-writing construction, so the
// argument slot held ZII 0 and only ever matched the ordinal-0 variant. Native
// exited 71 (the Trigger arm never ran, fire_count stayed 0); the interpreter
// was always correct. Fixed by constructing a bare-variant call argument:
// argument materialization now writes the variant's tag ordinal when the
// argument resolves to a case variant (see argument_materialization.rs).

use omega_language_std::console;

data AlarmEvent {
    case Set(hour: i32 in Wrapping, minute: i32 in Wrapping);
    case Snooze(minutes: i32 in Wrapping);
    case Cancel;
    case Trigger;
    case Dismiss;
}

data Main {
}

data Alarm {
    fire_count: i32 in Wrapping;
}

machine Alarm::dispatch(alarm: &mut Alarm, event: AlarmEvent) {
    transition event {
        AlarmEvent::Set { hour, minute } -> do_set(hour, minute)
        AlarmEvent::Snooze { minutes } -> do_snooze(minutes)
        AlarmEvent::Cancel -> do_cancel()
        AlarmEvent::Trigger -> do_trigger(alarm)
        AlarmEvent::Dismiss -> do_dismiss()
        _ -> done()
    }

    state do_set(hour: i32 in Wrapping, minute: i32 in Wrapping) {}
    state do_snooze(minutes: i32 in Wrapping) {}
    state do_cancel() {}
    state do_trigger(alarm: &mut Alarm) { alarm.fire_count = alarm.fire_count + 1; }
    state do_dismiss() {}
    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    let mut alarm: Alarm;
    let mut other_alarm: Alarm;
    Alarm::dispatch(&mut alarm, AlarmEvent::Trigger);
    Alarm::dispatch(&mut other_alarm, AlarmEvent::Trigger);
    Alarm::dispatch(&mut alarm, AlarmEvent::Trigger);

    transition alarm.fire_count == 2 && other_alarm.fire_count == 1 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
