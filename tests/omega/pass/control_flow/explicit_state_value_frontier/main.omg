data Packet { value: u64; }
machine Packet::inspect(packet: &Packet) {}
machine inspect(packet: &Packet, output: &mut u64) {
    let saved: u64 = 7;
    transition { _ -> finish(packet, output, saved) }
    machine finish(value: &Packet, destination: &mut u64, result: u64) {
        Packet::inspect(value);
        destination = result;
    }
}
