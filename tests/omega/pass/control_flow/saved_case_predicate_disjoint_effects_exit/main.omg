// A saved case decision crosses Boolean aliases, ordinary locals and disjoint writes.
// Expected exit: 0
domain u64::Divisor(value) requires value > 0;
data Choice [copy] { case Empty; case Full(amount: u64 in Divisor); }
machine mark(marker: &mut bool) { marker = true; }
machine quotient(choice: &Choice, marker: &mut bool) -> u64 {
    let saved: bool = choice in Choice::Full;
    let alias: bool = saved;
    mark(marker);
    let ordinary: u64 = 9;
    transition alias {
        true -> 490 / choice.amount
        false -> 0
    }
}
machine main() crashes Trap {
    let choice: Choice = Choice::Full { amount: 7 };
    let mut marker: bool = false;
    let observed: u64 = quotient(&choice, &mut marker);
    transition observed == 70 && marker { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
