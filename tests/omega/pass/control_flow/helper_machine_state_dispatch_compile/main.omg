// A helper machine carries its own transition graph: `classify` enters at a
// dispatch on its parameter, runs internal states, and returns a value to
// the caller. State machines compose — every machine is a graph, not just
// the entry.
data Main { answer: u64; }

machine Main::classify(input: u64) -> u64 {
    transition input {
        0 -> none()
        _ -> some(input)
    }

    machine none() -> u64 {
        0
    }

    machine some(value: u64) -> u64 {
        value
    }
}

machine Main::main(main: &mut Main) {
    main.answer = Main::classify(41);
}
