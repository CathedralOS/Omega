// Arm-position record binding SHARES the LET record-pattern grammar (owner
// spec 2026-07-18): `dx as step` renames the binding (uses of `step`
// rewrite to the subject's payload read), `dy as _` waives the field
// (spelled, no binding). Case arm keeps its tag guard; the `if` guard and
// target arguments see the renamed binding. The runtime self-check accepts only 30 + 40 = 70.
use omega_language_std::console;
domain i32::Step(value) requires 0 <= value && value <= 50;
data Msg {
    case Move(dx: i32 in Step, dy: i32 in Step);
    case Stop(code: i32);
}
data Main { }
machine Main::main(main: &mut Main) {
    Main::apply(main, Msg::Move { dx: 30, dy: 40 });
}
machine Main::apply(main: &mut Main, m: Msg) reaches Console {
    transition m {
        Msg::Move { dx as step, dy as _ } if step == 30 -> good(main, step)
        _ -> bad(main)
    }
    state good(main: &mut Main, step: i32 in Step) { let code: i32 = step + 40; Console::exit_process(code); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
