use omega::language::core::float_operations;
use omega_language_std::console;

data Sample32 { case Reading(value: f32); case Empty; }
data Sample64 { case Reading(value: f64); case Empty; }
data Main { }

machine read32(sample: Sample32) -> bool {
    transition sample {
        Sample32::Reading { value } -> check(value)
        Sample32::Empty -> (false)
    }
    state check(value: f32) -> bool { value == 2.5 }
}
machine read64(sample: Sample64) -> bool {
    transition sample {
        Sample64::Reading { value } -> check(value)
        Sample64::Empty -> (false)
    }
    state check(value: f64) -> bool { value == -3.75 }
}
machine Main::main(main: &mut Main) reaches Console {
    let first: bool = read32(Sample32::Reading { value: 2.5 });
    let second: bool = read64(Sample64::Reading { value: -3.75 });
    transition first && second {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
