use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }

machine terminal_local() -> i32 {
    let exit_code: i32 = 70;
    exit_code
}

machine Main::main(&mut self) reaches Console {
    let result: i32 = terminal_local();
    self.console.exit_process(result);
}
