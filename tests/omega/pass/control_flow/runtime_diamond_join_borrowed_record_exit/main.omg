// Two branches rejoin one state carrying the same borrowed record. The join
// observes the write of whichever branch ran.
use omega_language_std::console;

data Tally { count: u64; }
data Main { tally: Tally; }

machine diamond(flag: bool, tally: &mut Tally) {
    transition flag {
        true -> left(tally)
        false -> right(tally)
    }
    machine left(out: &mut Tally) {
        out.count = 30;
        transition { _ -> join(out) }
    }
    machine right(out: &mut Tally) {
        out.count = 1;
        transition { _ -> join(out) }
    }
    machine join(out: &mut Tally) { out.count = out.count + 40; }
}

machine Main::main(main: &mut Main) reaches Console {
    diamond(true, &mut main.tally);
    transition main.tally.count == 70 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
