// A state may transition back to itself: `spin` decrements its count each
// visit and re-enters `spin` while count > 0 — compile-only evidence that
// the transition graph permits self-loops (a real run needs a progress
// story, which compile doesn't ask for).
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    transition 1 {
        1 -> spin(main, 3)
        _ -> miss(main)
    }

    machine spin(main: &mut Main, count: u64) {
        transition count == 0 {
            true -> done(main)
            _ -> again(main, count)
        }
    }

    machine again(main: &mut Main, count: u64)
    requires count >= 1
    {
        transition 1 {
            1 -> spin(main, count - 1)
            _ -> miss(main)
        }
    }

    machine done(main: &mut Main) { main.answer = 70; }
    machine miss(main: &mut Main) { main.answer = 71; }
}
