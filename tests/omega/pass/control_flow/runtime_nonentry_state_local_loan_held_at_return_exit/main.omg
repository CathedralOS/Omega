// A non-entry state lends its own local record `&mut` to a successor that
// completes the machine while still holding the loan: it writes through the
// loan, lends it shared to an ordinary call that reports what it reads, and
// then returns, so the lender's storage dies at that return rather than on
// an edge. The entry's refused arm never visits the lender.
//
// exits: 70 = the call observed the successor's write over the lender's
// value; 71 = the entry guard failed; 72 = the call read the wrong total.

use omega_language_std::console;
use omega::language::core::binding;

data Score { value: u64 in Wrapping; bonus: u64 in Wrapping; }

machine report(console: &Binding<Console>, score: &Score) reaches Console {
    transition score.bonus == 70 {
        true -> passed(console)
        _ -> failed(console)
    }

    state passed(console: &Binding<Console>) {
        Console::exit_process(console, 70);
    }

    state failed(console: &Binding<Console>) {
        Console::exit_process(console, 72);
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let start: u64 = 3;
    transition start > 2 {
        true -> prepare(&main.console, start)
        _ -> refused(&main.console, 71)
    }

    state prepare(console: &Binding<Console>, start: u64) {
        let mut score: Score;
        score.value = start as u64 in Wrapping;
        transition { _ -> finish(console, &mut score) }
    }

    state finish(console: &Binding<Console>, score: &mut Score) {
        score.bonus = score.value + 67;
        report(console, score);
    }

    state refused(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
