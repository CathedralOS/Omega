// A static entry lends its local record `&mut` to `fill`, which writes through
// the loan on each of three rounds and then hands the same storage on as
// `&Tally`. A transition never resumes `fill`, so the shared successor holds
// the loan's only remaining name. `check` reads what `fill` stored and passes
// the shared view on to `confirm`, which reads nested array elements.
//
//   rounds 0, 1, 2 store first = round + 5 and grid[round][1] = round + 1:
//   first = 7, grid[2][1] = 3, grid[0][1] = 1
//
// exits: 70 = every read saw the last writes; 71 = `check` read a stale
// field; 72 = `confirm` read a stale element.

use omega_language_std::console;
use omega::language::core::binding;

data Tally { first: u64; grid: [[u64; 2]; 3]; }

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut tally: Tally;
    transition { _ -> fill(&main.console, &mut tally, 0) }

    state fill(console: &Binding<Console>, tally: &mut Tally, round: u64) requires round <= 2 {
        tally.first = round + 5;
        tally.grid[round][1] = round + 1;
        let next: u64 = round + 1;
        transition next <= 2 {
            true -> fill(console, tally, next)
            _ -> check(console, tally)
        }
    }

    state check(console: &Binding<Console>, tally: &Tally) {
        transition tally.first == 7 {
            true -> confirm(console, tally)
            _ -> refused(console, 71)
        }
    }

    state confirm(console: &Binding<Console>, tally: &Tally) {
        let last: u64 = tally.grid[2][1];
        let earliest: u64 = tally.grid[0][1];
        transition last == 3 && earliest == 1 {
            true -> refused(console, 70)
            _ -> refused(console, 72)
        }
    }

    state refused(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
