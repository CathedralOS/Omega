// Expected exit: 0
// Selected<Base + 4> at Base = 3 supplies at least seven before exact value - 7.
use support::main;
const VALUE: u64 = construct<3>();
machine main() crashes Trap {
    let value: u64 = VALUE;
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
