use leaf::values;

data Main { first: leaf::values::Window<u64>; second: leaf::values::Window<bool>; }

machine Main::main(main: &mut Main) crashes Trap {
    main.first.len = 4;
    main.second.len = 7;
    let number: u64 = main.first[1..3];
    let enabled: u64 = main.second[..];
    let again: u64 = main.first[0..2];
    transition number == 43 && enabled == 77 && again == 42 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
