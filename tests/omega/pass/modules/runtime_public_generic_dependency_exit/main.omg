use leaf::values;

data Wrapper<Value> { value: Value; }
data Main {
    first: leaf::values::Window<u64>;
    second: leaf::values::Window<bool>;
    nested: Wrapper<Wrapper<leaf::values::Window<u64>>>;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.first.len = 4;
    main.second.len = 7;
    main.nested.value.value.len = 9;
    let number: u64 = main.first[1..3];
    let enabled: u64 = main.second[..];
    let again: u64 = main.first[0..2];
    let nested: u64 = main.nested.value.value[0..1];
    transition number == 43 && enabled == 77 && again == 42 && nested == 91 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
