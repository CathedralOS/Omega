use settings::VALUE;
// Same-spelled local carriers cannot redirect the imported constant's fields.
data Inner [copy] { other: bool; }
data Middle [copy] { inner: Inner; }
data Outer [copy] { middle: Middle; }
const SIZE: u64 = VALUE.middle.inner.value;
const SAME: u64 = settings::VALUE.middle.inner.value;
data Buffer<const N: u64> { value: [u8; N]; }
machine keep(value: Buffer<SIZE>) -> Buffer<7> { value }
machine same(value: Buffer<SAME>) -> Buffer<7> { value }
machine main() {}
