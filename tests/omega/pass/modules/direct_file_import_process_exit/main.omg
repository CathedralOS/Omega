// Supplemental no-Console witness: preserve direct imports and exit 7.
use m::b;
use m::a;
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Main { }
machine Main::main(main: &mut Main) reaches ProcessExit {
    let item: A = A { value: 7 };
    ProcessExit::exit_process(item.value);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
