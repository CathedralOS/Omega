use omega_language_std::console;
use sizes;

// Declare the observer first: its evaluation depends on Count through Storage,
// even though the observer body never names Count as an expression.
const Observed: u64 = extent();
const Count: u64 = count();
data Storage { bytes: [u8; Count]; }
const Storage::Width: u64 = 4;
data Scoped { bytes: [u8; Storage::Width]; }
data Imported { bytes: [u8; sizes::Count]; }
data Generic<const Count: u64> { bytes: [u8; Count]; }
data Main {
    storage: Storage;
    imported: Imported;
    scoped: Scoped;
    generic: Generic<2>;
}

machine count() -> u64 { 8 }
machine extent() -> u64 {
    let storage: Storage = Storage { bytes: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8] };
    storage.bytes.len
}

machine Main::main(main: &mut Main) reaches Console {
    main.storage.bytes[7] = 70;
    main.imported.bytes[2] = 31;
    main.generic.bytes[1] = 19;
    main.scoped.bytes[3] = 23;
    transition Observed == 8 && main.storage.bytes.len == 8 && main.storage.bytes[7] == 70
        && main.imported.bytes.len == 3 && main.imported.bytes[2] == 31
        && main.generic.bytes.len == 2 && main.generic.bytes[1] == 19
        && main.scoped.bytes.len == 4 && main.scoped.bytes[3] == 23 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
