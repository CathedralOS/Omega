use omega::language::core::ProcessExit;
public const SIZE:u64=1+0;
public const SOURCE:[i32;SIZE]=[7];
const STATUS:i32=read_source();
machine read_source()->i32{SOURCE[0]}
data Main {}
machine Main::main(main:&mut Main) reaches ProcessExit {ProcessExit::exit_process(STATUS);}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
