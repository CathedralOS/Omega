// A consumer's same-spelled extent cannot reinterpret the selected array owner.
// Expected exit: 0
use values::ALIAS;
const SIZE: u64 = 2 + 0;
const SELECTED: [u64; 1] = ALIAS;
machine main() crashes Trap {
    transition SELECTED[0] == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
