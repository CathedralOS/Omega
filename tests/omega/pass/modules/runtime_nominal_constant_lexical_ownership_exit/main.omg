use foreign::SELECTED;

// Consumer lookalikes cannot reinterpret a selected constant's constructor.
data Token [copy] { value: i32; }
const ALIAS: foreign::Token = SELECTED;
const AGAIN: foreign::Token = ALIAS;
const CALLED: foreign::Token = foreign::get();
const MATCHED: foreign::Token = match true { true -> AGAIN, false -> CALLED };
const STATUS: i32 = MATCHED.value;

data Indexed<const N: foreign::Token> { value: u8; }
machine keep_index(value: Indexed<AGAIN>) -> Indexed<SELECTED> { value }

// Ordinary parameters and prior locals shadow the imported constant. A later
// local does not capture an earlier occurrence, and a value named Token does
// not redirect the constructor retained inside the foreign constant.
machine keep(SELECTED: foreign::Token) -> foreign::Token { SELECTED }
machine local_token(input: foreign::Token) -> foreign::Token {
    let SELECTED: foreign::Token = input;
    SELECTED
}
machine later_token(input: foreign::Token) -> foreign::Token {
    let selected: foreign::Token = SELECTED;
    let SELECTED: foreign::Token = input;
    selected
}
machine selected_token(Token: u64) -> foreign::Token { SELECTED }

machine main() crashes Trap {
    let input: foreign::Token = foreign::Token { value: 19 };
    let kept: foreign::Token = keep(input);
    let local: foreign::Token = local_token(input);
    let earlier: foreign::Token = later_token(input);
    let selected: foreign::Token = selected_token(41);
    let indexed: Indexed<AGAIN> = Indexed { value: 11 };
    let forwarded: Indexed<SELECTED> = keep_index(indexed);
    transition STATUS == 7 && kept.value == 19 && local.value == 19
        && earlier.value == 7 && selected.value == 7 && forwarded.value == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
