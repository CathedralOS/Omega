use helpers;
use omega_language_std::console;

machine result() -> i32 {
    let mut value: i32 = 0;
    helpers::Counter::write(&mut value);
    helpers::Counter::read(&value)
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let observed: i32 = result();
    Console::exit_process(observed);
}
