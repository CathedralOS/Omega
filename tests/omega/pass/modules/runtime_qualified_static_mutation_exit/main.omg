use helpers;
use omega_language_std::console;
use omega::language::core::binding;

machine result() -> i32 {
    let mut value: i32 = 0;
    helpers::Counter::write(&mut value);
    helpers::Counter::read(&value)
}

data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let observed: i32 = result();
    main.console.exit_process(observed);
}
