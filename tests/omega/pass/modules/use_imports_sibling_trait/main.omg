use contracts::drawable;

data Canvas {
    width: i32;
}

data Sprite {
    id: i32;
}

data Main {}

machine Sprite::draw(sprite: &Sprite, canvas: &mut Canvas) satisfies Drawable::draw {
    canvas.width = 80;
}

machine Main::main() {
    let sprite: Sprite;
    let mut canvas: Canvas;
    Sprite::draw(&sprite, &mut canvas);
}
