machine build(builder: &mut Build) {
    Build::application(builder, "generic_constant_probe");
    let mut values_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "values" });
    dependency::with_alias(&mut values_dependency, "values");
    let values_registration: DependencyRegistration = Build::dependency(builder, values_dependency);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
