module left;

use omega_language_std::Console;

public boundary trait Sink {
    machine emit(byte: i32)
    reaches
        Console
    invokes Console;
}
public data Provider {}
machine Provider::emit(byte: i32) satisfies Sink::emit
reaches
    Console
{
    Console::exit_process(66);
}

public data Runner { }
// The hosted entry takes no arrival parameters; it owns the runner storage
// and passes it to `Runner::execute` explicitly.
public machine Runner::run() reaches Sink, Console
invokes Sink
invokes Console
{
    let mut runner: Runner = Runner {};
    Runner::execute(&mut runner);
}

machine Runner::execute(runner: &mut Runner) reaches Sink, Console
invokes Sink
invokes Console
{
    Sink::emit(76);
    transition { _ -> deliver(runner, 65) }
    machine deliver(runner: &mut Runner, code: i32) {
        Sink::emit(10);
        Console::exit_process(code);
    }
}
