module left;

use omega_language_std::console;

pub boundary trait Sink {
    machine emit(byte: i32)
    reaches
        Console
    invokes Console;
}
pub data Provider {}
machine Provider::emit(byte: i32) satisfies Sink::emit
reaches
    Console
{
    Console::exit_process(66);
}

pub data Runner { }
pub machine Runner::run(runner: &mut Runner) reaches Sink, Console
invokes Sink;
invokes Console;
{
    Sink::emit(76);
    transition { _ -> deliver(runner, 65) }
    state deliver(runner: &mut Runner, code: i32) {
        Sink::emit(10);
        Console::exit_process(code);
    }
}
