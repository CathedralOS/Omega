// Deployable native canary: every hosted target binds `right::Runner::run`
// through a compiler-issued product-entry description. Both modules declare
// a boundary trait `Sink` with a requirement `emit`, and the build selects
// each module's own provider for its own `Sink`.

machine build(builder: &mut Build) {
    Build::application(builder, "same_name_requirement_calls_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<left::Sink, left::Provider>(builder);
    Build::select_provider<right::Sink, right::Provider>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, choose(builder, "macos_arm64::ProgramEntry"));
    Build::bind(builder, linux_arm64::ProgramEntry, choose(builder, "linux_arm64::ProgramEntry"));
    Build::bind(builder, linux_x86_64::ProgramEntry, choose(builder, "linux_x86_64::ProgramEntry"));
    Build::bind(builder, windows_x86_64::ProgramEntry, choose(builder, "windows_x86_64::ProgramEntry"));
}

machine choose(builder: &mut Build, slot: &[u8]) -> ProductEntryRef {
    BuildProduct::entry(&builder.product, "right::Runner::run", slot)
}
