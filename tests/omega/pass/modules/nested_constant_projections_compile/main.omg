data Inner [copy] { value: u64; }
data Outer [copy] { inner: Inner; }
machine make() -> Outer { Outer { inner: Inner { value: 7 } } }
const VALUE: Outer = make();
const SIZE: u64 = VALUE.inner.value;
data Buffer<const N: u64> { value: [u8; N]; }
machine keep(value: Buffer<SIZE>) -> Buffer<7> { value }
machine main() {}
