use combat::Damage;
use combat::damage;

data Attack {
    local: Damage;
    qualified: combat::Damage;
}

machine score() -> u32 { damage() }
machine qualified_score() -> u32 { combat::damage() }

data Main {}
machine Main::main(&mut self) {}

machine qualified_record() -> combat::Damage {
    combat::Damage { amount: 7 }
}

machine qualified_case() -> combat::DamageResult {
    combat::DamageResult::Hit { amount: 7 }
}

machine qualified_empty_case() -> combat::DamageResult {
    combat::DamageResult::Miss
}
