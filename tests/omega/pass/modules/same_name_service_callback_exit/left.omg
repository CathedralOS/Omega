module left;

public boundary trait Sink { machine observe() reaches; }

machine apply<machine Selected, machine Unused>(value: u64) -> u64
where machine Selected(value: u64) -> u64 reaches Sink;
where machine Unused(value: u64) -> u64 reaches Sink;
{ Selected(value) }

machine identity(value: u64) -> u64 { value }
machine unused(value: u64) -> u64 { value }

public machine run(value: u64) -> u64 { apply<identity, unused>(value) }
