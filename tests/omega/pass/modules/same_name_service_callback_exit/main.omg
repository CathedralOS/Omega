// Same-spelled callback reach ceilings retain distinct module declarations,
// including a bound on an unused callback. They are not runtime providers.
use left;
use right;

machine main() crashes Trap {
    let first: u64 = left::run(11u64);
    let second: u64 = right::run(37u64);
    transition first == 11u64 && second == 37u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
