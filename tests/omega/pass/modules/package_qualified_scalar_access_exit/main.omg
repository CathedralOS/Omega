// Expected exit: 0
// A package-qualified call selects the imported operation and preserves its access rules.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::Access;
use omega::language::core::Access::view_mut;
use omega::language::core::write;

public data Value { before: u64; number: u64; after: u64; }
public data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 16 } };
    let layout: LayoutPlan = LayoutPlan {
        entries: entries, entry_count: 3, size_fixed: 24, size_is_dynamic: false, align: 8,
    };
    let before: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let number: AccessPlan = AccessPlan::with(
        before, schema.fields[1].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let after: AccessPlan = AccessPlan::with(
        number, schema.fields[2].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let services: [u64; 32];
    AccessPlan::with_reach(after, BoundaryReach { services: services, service_count: 0 })
}

machine main() crashes Trap {
    let local: u64 = read(7);
    let mut value: Value = Value { before: 43, number: 17, after: 61 };
    let view: &mut Access<StablePlacement, Value> = Access::view_mut<StablePlacement, Value>(&mut value);
    omega::language::write(&mut view.number, 29u64);
    let observed: u64 = omega::language::read(&view.number);
    transition local == 7 && observed == 29 && value.number == 29 && value.before == 43 && value.after == 61 {
        true -> done()
        _ -> wrong()
    }
    machine read(value: u64) -> u64 { value }
    machine done() {}
    machine wrong() { crash Trap; }
}
