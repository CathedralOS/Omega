// A source that merely loaded with the compilation exposes nothing to a file
// that never imported it (modules spec, "Import scope and exposure"). Every
// compile loads the targets' entry contracts, and through them std's
// `calling`, core's `extent`, `nat` and the Float operator spellings. This
// file imports none of them: its own `Nat` is the only `Nat` its `==`
// resolves, `<=` over anonymous integers stays builtin although core's
// `Nat::less_or_equal` is loaded, and `(6 + 1) - 0` stays builtin although
// `Float::subtract` is loaded.
trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

data Nat {
    tag: u8;
}

NatEquatable: Nat satisfies Equatable;

machine bounded(value: i32)
requires value <= 7
{}

machine within() {
    bounded((6 + 1) - 0);
}

data Main {
}

machine Main::main(&mut self) {
    let left: Nat = Nat { tag: 1 };
    let right: Nat = Nat { tag: 1 };
    let same: bool = left == right;
}
