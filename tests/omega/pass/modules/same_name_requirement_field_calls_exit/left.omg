module left;

use omega_language_std::console;
use omega::language::core::binding;

pub boundary trait Sink {
    machine emit(byte: i32)
    reaches
        Console
    invokes Console;
}
pub data Provider {}
machine Provider::emit(byte: i32) satisfies Sink::emit
reaches
    Console
{
    Console::exit_process(66);
}

pub data Runner { sink: Binding<Sink>; console: Binding<Console>; }
pub machine Runner::run(&mut self) reaches Sink, Console
invokes Sink;
invokes Console;
blocks;
{
    block self.sink.emit(76);
    transition { _ -> deliver(65) }
    state deliver(&mut self, code: i32) {
        block self.sink.emit(10);
        self.console.exit_process(code);
    }
}
