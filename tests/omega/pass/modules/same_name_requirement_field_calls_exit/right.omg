module right;

use omega_language_std::console;
use omega::language::core::binding;

pub boundary trait Sink {
    machine emit(byte: i32)
    reaches
        Console
    invokes Console;
}
pub data Provider {}
machine Provider::emit(byte: i32) satisfies Sink::emit
reaches
    Console
{
    Console::write_byte(byte);
}

pub data Runner { sink: Binding<Sink>; console: Binding<Console>; }
pub machine Runner::run(runner: &mut Runner) reaches Sink, Console
invokes Sink;
invokes Console;
{
    runner.sink.emit(82);
    transition { _ -> deliver(runner, 70) }
    state deliver(runner: &mut Runner, code: i32) {
        runner.sink.emit(10);
        runner.console.exit_process(code);
    }
}
