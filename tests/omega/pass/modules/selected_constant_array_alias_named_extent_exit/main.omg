use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega::language::core::binding;
const SIZE:u64=1;
const SOURCE:[i32;SIZE]=[7];
const ALIAS:[i32;1]=SOURCE;
data Main {exit:Binding<ProcessExit>;}
machine Main::main(main:&mut Main) reaches ProcessExit {main.exit.exit_process(ALIAS[0]);}
