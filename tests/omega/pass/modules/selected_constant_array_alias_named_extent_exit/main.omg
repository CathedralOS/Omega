use omega::language::core::process_exit;
use omega_language_std::process_exit;
const SIZE:u64=1;
const SOURCE:[i32;SIZE]=[7];
const ALIAS:[i32;1]=SOURCE;
const REFINED:[i32 [0..=7];1]=ALIAS;
data Main {}
machine Main::main(main:&mut Main) reaches ProcessExit {ProcessExit::exit_process(REFINED[0]);}
