// Typing finalizes the carrier-selected domain in an authored continuation.
// Expected exit: 0.
domain [u8; 4]::Ascii requires ascii_only(self);
domain [u8]::Ascii requires ascii_only(self);

machine preserve(bytes: &mut [u8; 4] in Ascii)
ensures bytes in Ascii
{
}

machine main() crashes Trap {
    let mut bytes: [u8; 4] = [65u8, 0u8, 0u8, 0u8];
    preserve(&mut bytes);
    transition bytes[0] == 65 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
