pub data Buffer<const Size: u64> { value: [u8; Size]; }
pub data Flag<const Enabled: bool> { value: u8; }
pub data SignedIndex<const Value: i32> { value: u8; }

machine integral_quotient(value: SignedIndex<((match true { true -> 14, false -> 28 }) / (match false { true -> -2, false -> 2 }))>) -> SignedIndex<7> {
    value
}

const ENABLED: bool = true;

machine choose(value: Buffer<((match ENABLED { true -> 7 / 2, false -> 0 }) * 2)>) -> Buffer<7> {
    value
}

machine selective(value: Flag<(match ENABLED { true -> true, false -> (1u64 / 0 == 0) })>) -> Flag<true> {
    value
}

machine ordered(value: Buffer<(match 3u64 { 3 -> 7, 3 -> (1u64 / 0), _ -> 9 })>) -> Buffer<7> {
    value
}

machine divided(value: Flag<(1 / ((match true { true -> 1, false -> 2 }) + 1) == 0.5)>) -> Flag<true> {
    value
}

machine signed_divisor(value: Flag<(1 / ((match true { true -> -1, false -> 1 }) + 0) == -1)>) -> Flag<true> {
    value
}

// Anonymous match operands carry no recoverable type, so a `-` operand tuple
// still matches the prelude's declared `Nat::subtract` and requires authored
// selection. The same shifted point set is written as a sum of a negative arm.
machine spaced_divisor(value: Flag<(1 / ((match true { true -> 1, false -> 3 }) + -2) == -1)>) -> Flag<true> {
    value
}

machine lattice_divisors(value: SignedIndex<((match true { true -> 24, false -> 48 }) / (match false { true -> 2, false -> 4 }))>) -> SignedIndex<6> {
    value
}

machine hull_gap_divisor(value: SignedIndex<(840 / ((match true { true -> (match true { true -> -5, false -> -1 }), false -> 2 }) + (match true { true -> 4, false -> -3 })))>) -> SignedIndex<-840> {
    value
}

machine pair_gap_divisor(value: Flag<(1 / ((match 0u8 { 0 -> -3, 1 -> -1, 2 -> 4, _ -> 8 }) + (match 0u8 { 0 -> -6, 1 -> -2, 2 -> 2, _ -> 4 })) < 0)>) -> Flag<true> {
    value
}

machine collapsed_quotient(value: SignedIndex<(0 / (8 / (match true { true -> 2, false -> (match true { true -> 4, false -> 600 }) })))>) -> SignedIndex<0> {
    value
}

machine product_divisor(value: SignedIndex<(48 / ((match true { true -> 2, false -> 3 }) * (match true { true -> 2, false -> 4 })))>) -> SignedIndex<12> {
    value
}

// The difference point set {1,4} - {2,3} = {-2,-1,1,2} is spelled with
// negated arms for the same `Nat::subtract` reason as `spaced_divisor`: its
// merged lattice reaches zero, so only the exact operand points prove the
// divisor nonzero.
machine exact_points_divisor(value: Flag<(1 / ((match true { true -> 1, false -> 4 }) + (match true { true -> -2, false -> -3 })) == -1)>) -> Flag<true> {
    value
}
