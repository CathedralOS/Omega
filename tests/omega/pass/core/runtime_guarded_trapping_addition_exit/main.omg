// A Trapping sum traps exactly when its exact result leaves the carrier. The
// two routes together bound both addends, so `total + step` stays inside u8
// whenever neither route holds: every trap the addition can reach is a
// declared route. The caller's arguments disprove both routes.
use omega_language_std::console;

machine accumulate(total: u8, step: u8) -> u8
crashes Trap
    total > 200u8
    step > 55u8
{
    ((total as u8 in Trapping) + (step as u8 in Trapping)) as u8
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: u8 = accumulate(60u8, 10u8);
    transition result == 70u8 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
