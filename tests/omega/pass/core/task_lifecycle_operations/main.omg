use omega::language::core::task;
use omega::language::core::drop;

// TR4 lifecycle conservation: the checked helper operations model the borrow
// and consume shapes published by the bodyless runtime requirements. Exact
// generic provider coverage remains a separate installation/runtime rung.
machine TaskOutcome::settle<T>(task_outcome: TaskOutcome<T>) {
    drop(task_outcome);
}

machine Task::observe_claim<T>(task: &Task<T>) {}

machine Task::settle_claim<T>(task: Task<T>) -> TaskOutcome<T> {
    suspend block Task::finish(task)
}

data Main {}

machine Main::settle(task: Task<i32>) {
    Task::observe_claim(&task);
    let outcome: TaskOutcome<i32> = suspend block Task::settle_claim(task);
    TaskOutcome::settle(outcome);
}

machine Main::main() {
    let task: Task<i32> = Task { provider: 1, activation: 7 };
    suspend block Main::settle(task);
}
