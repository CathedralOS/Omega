use omega::language::core::task;
use omega::language::core::drop;

// TR4 lifecycle conservation: the checked helper operations call the borrow
// and consume requirements of `TaskLifecycle` from generic callers. Exact
// generic provider coverage remains a separate installation/runtime rung.
machine TaskOutcome::settle<T>(task_outcome: TaskOutcome<T>) {
    drop(task_outcome);
}

machine observe_claim<T>(task: &Task<T>) {
    TaskLifecycle::request_cancel<T>(task);
}

machine settle_claim<T>(task: Task<T>) -> TaskOutcome<T> {
    suspend block TaskLifecycle::finish<T>(task)
}

data Main {}

machine Main::settle(task: Task<i32>) {
    observe_claim(&task);
    let outcome: TaskOutcome<i32> = suspend block settle_claim(task);
    TaskOutcome::settle(outcome);
}

machine Main::main() {
    let task: Task<i32> = Task { provider: 1, activation: 7 };
    suspend block Main::settle(task);
}
