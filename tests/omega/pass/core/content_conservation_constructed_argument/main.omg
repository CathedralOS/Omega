use omega::language::core::content;
use omega::language::core::nat;

public data ByteUnit {}
public data Chunk [linear] { length: u64; }
public domain Chunk::Held established by ChunkRoot::grant;
public machine Held::content(value: &Chunk) -> CountedQuantity<ByteUnit>
satisfies Content<Chunk, CountedQuantity<ByteUnit>>::project
{ CountedQuantity { magnitude: embed(value.length) as Nat } }
public boundary trait ChunkRoot {
    machine grant(value: Chunk) -> Chunk in Held reaches;
}
public data Pair { left: Chunk in Held; right: Chunk in Held; }
public boundary trait Join {
    machine merge(parts: Pair) -> Chunk in Held
    reaches
    ensures separate(Held::content(old(&parts.left)), Held::content(old(&parts.right)))
        == Held::content(&result);
}
public boundary trait Sink { machine accept(value: Chunk in Held) reaches; }
public machine combine(left: Chunk in Held, right: Chunk in Held)
reaches Join, Sink
    invokes Join;
    invokes Sink;
{
    let joined: Chunk in Held = Join::merge(Pair { left: left, right: right });
    Sink::accept(joined);
}
machine main() {}

public data Shell { parts: Pair; }
public boundary trait NestedJoin {
    machine merge(shell: Shell) -> Chunk in Held
    reaches
    ensures separate(Held::content(old(&shell.parts.left)), Held::content(old(&shell.parts.right)))
        == Held::content(&result);
}
public machine nested(left: Chunk in Held, right: Chunk in Held)
reaches NestedJoin, Sink
    invokes NestedJoin;
    invokes Sink;
{
    let joined: Chunk in Held = NestedJoin::merge(Shell { parts: Pair { left: left, right: right } });
    Sink::accept(joined);
}
