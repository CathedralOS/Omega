// Each completed call retains its own captured argument interval.
// Expected exit: 0
machine identity(value: u64) -> u64 ensures result == value { value }
machine main() crashes Trap {
    let first: u64 = identity(7u64);
    let second: u64 = identity(11u64);
    let first_difference: u64 = first - 7u64;
    let second_difference: u64 = second - 11u64;
    transition first_difference == 0u64 && second_difference == 0u64 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
