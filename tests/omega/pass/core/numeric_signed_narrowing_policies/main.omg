// Same-sign signed narrowing through the public numeric_conversion surface:
// every i16/i32/i64 source to every narrower signed target under Exact,
// Wrapping, Saturating and Trapping. Exact and Trapping keep both target
// extremes; Wrapping reduces the two's-complement value modulo the target
// width (maximum + 1 becomes the minimum and minimum - 1 the maximum);
// Saturating clamps on both sides and passes in-range negatives through.
// `literal_checks` passes constants, `runtime_checks` reads the boundaries
// through a borrowed record, and `named_conversion_checks` checks conversions
// on typed literals and on loaded operands.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    min_i16: i16;
    past_i8_in_i16: i16;
    below_i8_in_i16: i16;
    max_i32: i32;
    min_i32: i32;
    max_i64: i64;
    min_i64: i64;
    past_i32_in_i64: i64;
    below_i32_in_i64: i64;
    min_i32_in_i64: i64;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: i8 = narrow_i16_to_i8_exact(-128);
    let held_l1: bool = l1 == -128;
    let l2: i8 = narrow_i16_to_i8_exact(127);
    let held_l2: bool = also(held_l1, l2 == 127);
    let l3: i8 = narrow_i16_to_i8_wrapping(128);
    let held_l3: bool = also(held_l2, l3 == -128);
    let l4: i8 = narrow_i16_to_i8_wrapping(-129);
    let held_l4: bool = also(held_l3, l4 == 127);
    let l5: i8 = narrow_i16_to_i8_wrapping(-32768);
    let held_l5: bool = also(held_l4, l5 == 0);
    let l6: i8 = narrow_i16_to_i8_saturating(-129);
    let held_l6: bool = also(held_l5, l6 == -128);
    let l7: i8 = narrow_i16_to_i8_saturating(128);
    let held_l7: bool = also(held_l6, l7 == 127);
    let l8: i8 = narrow_i16_to_i8_saturating(-5);
    let held_l8: bool = also(held_l7, l8 == -5);
    let l9: i8 = narrow_i16_to_i8_trapping(-128);
    let held_l9: bool = also(held_l8, l9 == -128);
    let l10: i8 = narrow_i16_to_i8_trapping(127);
    let held_l10: bool = also(held_l9, l10 == 127);
    let l11: i8 = narrow_i32_to_i8_exact(-128);
    let held_l11: bool = also(held_l10, l11 == -128);
    let l12: i8 = narrow_i32_to_i8_wrapping(200);
    let held_l12: bool = also(held_l11, l12 == -56);
    let l13: i8 = narrow_i32_to_i8_wrapping(2147483647);
    let held_l13: bool = also(held_l12, l13 == -1);
    let l14: i8 = narrow_i32_to_i8_saturating(-2147483648);
    let held_l14: bool = also(held_l13, l14 == -128);
    let l15: i8 = narrow_i32_to_i8_saturating(2147483647);
    let held_l15: bool = also(held_l14, l15 == 127);
    let l16: i8 = narrow_i32_to_i8_trapping(-1);
    let held_l16: bool = also(held_l15, l16 == -1);
    let l17: i16 = narrow_i32_to_i16_exact(-32768);
    let held_l17: bool = also(held_l16, l17 == -32768);
    let l18: i16 = narrow_i32_to_i16_wrapping(32768);
    let held_l18: bool = also(held_l17, l18 == -32768);
    let l19: i16 = narrow_i32_to_i16_wrapping(-32769);
    let held_l19: bool = also(held_l18, l19 == 32767);
    let l20: i16 = narrow_i32_to_i16_saturating(40000);
    let held_l20: bool = also(held_l19, l20 == 32767);
    let l21: i16 = narrow_i32_to_i16_saturating(-40000);
    let held_l21: bool = also(held_l20, l21 == -32768);
    let l22: i16 = narrow_i32_to_i16_trapping(32767);
    let held_l22: bool = also(held_l21, l22 == 32767);
    let l23: i8 = narrow_i64_to_i8_exact(127);
    let held_l23: bool = also(held_l22, l23 == 127);
    let l24: i8 = narrow_i64_to_i8_wrapping(-9223372036854775808);
    let held_l24: bool = also(held_l23, l24 == 0);
    let l25: i8 = narrow_i64_to_i8_wrapping(9223372036854775807);
    let held_l25: bool = also(held_l24, l25 == -1);
    let l26: i8 = narrow_i64_to_i8_saturating(9223372036854775807);
    let held_l26: bool = also(held_l25, l26 == 127);
    let l27: i8 = narrow_i64_to_i8_saturating(-9223372036854775808);
    let held_l27: bool = also(held_l26, l27 == -128);
    let l28: i8 = narrow_i64_to_i8_trapping(-128);
    let held_l28: bool = also(held_l27, l28 == -128);
    let l29: i16 = narrow_i64_to_i16_exact(32767);
    let held_l29: bool = also(held_l28, l29 == 32767);
    let l30: i16 = narrow_i64_to_i16_wrapping(-32769);
    let held_l30: bool = also(held_l29, l30 == 32767);
    let l31: i16 = narrow_i64_to_i16_saturating(-9223372036854775808);
    let held_l31: bool = also(held_l30, l31 == -32768);
    let l32: i16 = narrow_i64_to_i16_trapping(-32768);
    let held_l32: bool = also(held_l31, l32 == -32768);
    let l33: i32 = narrow_i64_to_i32_exact(-2147483648);
    let held_l33: bool = also(held_l32, l33 == -2147483648);
    let l34: i32 = narrow_i64_to_i32_wrapping(2147483648);
    let held_l34: bool = also(held_l33, l34 == -2147483648);
    let l35: i32 = narrow_i64_to_i32_wrapping(-2147483649);
    let held_l35: bool = also(held_l34, l35 == 2147483647);
    let l36: i32 = narrow_i64_to_i32_wrapping(4294967297);
    let held_l36: bool = also(held_l35, l36 == 1);
    let l37: i32 = narrow_i64_to_i32_saturating(9223372036854775807);
    let held_l37: bool = also(held_l36, l37 == 2147483647);
    let l38: i32 = narrow_i64_to_i32_saturating(-2147483649);
    let held_l38: bool = also(held_l37, l38 == -2147483648);
    let l39: i32 = narrow_i64_to_i32_trapping(2147483647);
    let held_l39: bool = also(held_l38, l39 == 2147483647);
    held_l39
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: i8 = narrow_i16_to_i8_wrapping(inputs.min_i16);
    let held_r1: bool = r1 == 0;
    let r2: i8 = narrow_i16_to_i8_saturating(inputs.min_i16);
    let held_r2: bool = also(held_r1, r2 == -128);
    let r3: i8 = narrow_i16_to_i8_wrapping(inputs.past_i8_in_i16);
    let held_r3: bool = also(held_r2, r3 == -128);
    let r4: i8 = narrow_i16_to_i8_saturating(inputs.past_i8_in_i16);
    let held_r4: bool = also(held_r3, r4 == 127);
    let r5: i8 = narrow_i16_to_i8_wrapping(inputs.below_i8_in_i16);
    let held_r5: bool = also(held_r4, r5 == 127);
    let r6: i8 = narrow_i16_to_i8_saturating(inputs.below_i8_in_i16);
    let held_r6: bool = also(held_r5, r6 == -128);
    let r7: i8 = narrow_i32_to_i8_wrapping(inputs.max_i32);
    let held_r7: bool = also(held_r6, r7 == -1);
    let r8: i16 = narrow_i32_to_i16_saturating(inputs.min_i32);
    let held_r8: bool = also(held_r7, r8 == -32768);
    let r9: i16 = narrow_i32_to_i16_wrapping(inputs.min_i32);
    let held_r9: bool = also(held_r8, r9 == 0);
    let r10: i8 = narrow_i64_to_i8_saturating(inputs.max_i64);
    let held_r10: bool = also(held_r9, r10 == 127);
    let r11: i8 = narrow_i64_to_i8_saturating(inputs.min_i64);
    let held_r11: bool = also(held_r10, r11 == -128);
    let r12: i16 = narrow_i64_to_i16_wrapping(inputs.max_i64);
    let held_r12: bool = also(held_r11, r12 == -1);
    let r13: i32 = narrow_i64_to_i32_wrapping(inputs.past_i32_in_i64);
    let held_r13: bool = also(held_r12, r13 == -2147483648);
    let r14: i32 = narrow_i64_to_i32_saturating(inputs.below_i32_in_i64);
    let held_r14: bool = also(held_r13, r14 == -2147483648);
    let r15: i32 = narrow_i64_to_i32_saturating(inputs.max_i64);
    let held_r15: bool = also(held_r14, r15 == 2147483647);
    let r16: i32 = narrow_i64_to_i32_wrapping(inputs.min_i64);
    let held_r16: bool = also(held_r15, r16 == 0);
    let r17: i32 = narrow_i64_to_i32_trapping(inputs.min_i32_in_i64);
    let held_r17: bool = also(held_r16, r17 == -2147483648);
    held_r17
}

machine named_conversion_checks(inputs: &Inputs) -> bool {
    let d1: i8 = narrow_i32_to_i8_wrapping(200i32);
    let held_d1: bool = d1 == -56;
    let d2: i16 = narrow_i64_to_i16_trapping(32767i64);
    let held_d2: bool = also(held_d1, d2 == 32767);
    let d3: i32 = narrow_i64_to_i32_wrapping(inputs.past_i32_in_i64);
    let held_d3: bool = also(held_d2, d3 == -2147483648);
    let d4: i32 = narrow_i64_to_i32_trapping(inputs.min_i32_in_i64);
    let held_d4: bool = also(held_d3, d4 == -2147483648);
    held_d4
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        min_i16: -32768,
        past_i8_in_i16: 128,
        below_i8_in_i16: -129,
        max_i32: 2147483647,
        min_i32: -2147483648,
        max_i64: 9223372036854775807,
        min_i64: -9223372036854775808,
        past_i32_in_i64: 2147483648,
        below_i32_in_i64: -2147483649,
        min_i32_in_i64: -2147483648,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    let named_conversion_checks_held: bool = named_conversion_checks(&inputs);
    transition literal_checks_held && runtime_checks_held && named_conversion_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
