machine build(builder: &mut Build) {
    Build::application(builder, "extent_root_provider_adapter");
    Ordinary::accept_boundary<u32>(7);
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, ExtentRootProviderImpl>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}

data Ordinary {}
machine Ordinary::accept_boundary<Element>(value: Element) {}
