use omega::language::core::extent;

// A checked adapter may realize the owner-authored provider requirement, but
// it does not mint `Granted` when called directly. The selected boundary slot
// and its admission receipt authorize the exact qualified result.
data ExtentRootProviderImpl {}

machine ExtentRootProviderImpl::grant_root(root: Extent) -> Extent
satisfies ExtentRootProvider::grant
{
    root
}

machine consume_granted(root: Extent in Granted) -> Extent {
    root as Extent
}

data Harness {
    provider: ExtentRootProvider;
}

machine Harness::forward(&self, root: Extent) -> Extent
reaches ExtentRootProvider
{
    let granted: Extent = self.provider.grant(root);
    transition { _ -> (consume_granted(granted)) }
}

data Main {}

machine Main::main(&mut self) {}
