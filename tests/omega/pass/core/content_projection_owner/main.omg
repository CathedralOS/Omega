use omega::language::core::content;

data ByteUnit {}

data Region [linear] {
    remaining: u64;
}

domain Region::Owned;

machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

data Main {}

machine Main::main(&mut self) {}
