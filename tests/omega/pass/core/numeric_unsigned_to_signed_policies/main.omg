// Unsigned-to-signed conversion through the public numeric_conversion
// surface for u8, u16 and u32 sources into every signed target that
// cannot hold the whole source range (including the same-width pairs),
// under Exact, Wrapping, Saturating and Trapping. Wrapping reinterprets
// the low bits as two's complement (128 -> -128, 255 -> -1); Saturating
// caps at the signed maximum and never produces a negative result.
// `literal_checks` passes constants, `runtime_checks` reads the
// boundaries through a borrowed record, and `named_conversion_checks` checks conversions
// on typed literals and on loaded operands.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    max_u8: u8;
    half_u8: u8;
    max_u16: u16;
    half_u16: u16;
    max_u32: u32;
    half_u32: u32;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: i8 = narrow_u8_to_i8_exact(127);
    let held_l1: bool = l1 == 127;
    let l2: i8 = narrow_u8_to_i8_exact(0);
    let held_l2: bool = also(held_l1, l2 == 0);
    let l3: i8 = narrow_u8_to_i8_wrapping(128);
    let held_l3: bool = also(held_l2, l3 == -128);
    let l4: i8 = narrow_u8_to_i8_wrapping(255);
    let held_l4: bool = also(held_l3, l4 == -1);
    let l5: i8 = narrow_u8_to_i8_saturating(128);
    let held_l5: bool = also(held_l4, l5 == 127);
    let l6: i8 = narrow_u8_to_i8_saturating(5);
    let held_l6: bool = also(held_l5, l6 == 5);
    let l7: i8 = narrow_u8_to_i8_trapping(127);
    let held_l7: bool = also(held_l6, l7 == 127);
    let l8: i8 = narrow_u16_to_i8_exact(127);
    let held_l8: bool = also(held_l7, l8 == 127);
    let l9: i8 = narrow_u16_to_i8_wrapping(384);
    let held_l9: bool = also(held_l8, l9 == -128);
    let l10: i8 = narrow_u16_to_i8_saturating(65535);
    let held_l10: bool = also(held_l9, l10 == 127);
    let l11: i8 = narrow_u16_to_i8_trapping(0);
    let held_l11: bool = also(held_l10, l11 == 0);
    let l12: i16 = narrow_u16_to_i16_exact(32767);
    let held_l12: bool = also(held_l11, l12 == 32767);
    let l13: i16 = narrow_u16_to_i16_wrapping(32768);
    let held_l13: bool = also(held_l12, l13 == -32768);
    let l14: i16 = narrow_u16_to_i16_saturating(32768);
    let held_l14: bool = also(held_l13, l14 == 32767);
    let l15: i16 = narrow_u16_to_i16_trapping(32767);
    let held_l15: bool = also(held_l14, l15 == 32767);
    let l16: i8 = narrow_u32_to_i8_exact(127);
    let held_l16: bool = also(held_l15, l16 == 127);
    let l17: i8 = narrow_u32_to_i8_wrapping(4294967295);
    let held_l17: bool = also(held_l16, l17 == -1);
    let l18: i8 = narrow_u32_to_i8_saturating(4294967295);
    let held_l18: bool = also(held_l17, l18 == 127);
    let l19: i8 = narrow_u32_to_i8_trapping(127);
    let held_l19: bool = also(held_l18, l19 == 127);
    let l20: i16 = narrow_u32_to_i16_exact(0);
    let held_l20: bool = also(held_l19, l20 == 0);
    let l21: i16 = narrow_u32_to_i16_wrapping(4294934528);
    let held_l21: bool = also(held_l20, l21 == -32768);
    let l22: i16 = narrow_u32_to_i16_saturating(32768);
    let held_l22: bool = also(held_l21, l22 == 32767);
    let l23: i16 = narrow_u32_to_i16_trapping(32767);
    let held_l23: bool = also(held_l22, l23 == 32767);
    let l24: i32 = narrow_u32_to_i32_exact(2147483647);
    let held_l24: bool = also(held_l23, l24 == 2147483647);
    let l25: i32 = narrow_u32_to_i32_wrapping(2147483648);
    let held_l25: bool = also(held_l24, l25 == -2147483648);
    let l26: i32 = narrow_u32_to_i32_saturating(4294967295);
    let held_l26: bool = also(held_l25, l26 == 2147483647);
    let l27: i32 = narrow_u32_to_i32_trapping(2147483647);
    let held_l27: bool = also(held_l26, l27 == 2147483647);
    held_l27
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: i8 = narrow_u8_to_i8_wrapping(inputs.half_u8);
    let held_r1: bool = r1 == -128;
    let r2: i8 = narrow_u8_to_i8_saturating(inputs.max_u8);
    let held_r2: bool = also(held_r1, r2 == 127);
    let r3: i8 = narrow_u16_to_i8_wrapping(inputs.max_u16);
    let held_r3: bool = also(held_r2, r3 == -1);
    let r4: i16 = narrow_u16_to_i16_wrapping(inputs.half_u16);
    let held_r4: bool = also(held_r3, r4 == -32768);
    let r5: i16 = narrow_u16_to_i16_saturating(inputs.max_u16);
    let held_r5: bool = also(held_r4, r5 == 32767);
    let r6: i8 = narrow_u32_to_i8_saturating(inputs.half_u32);
    let held_r6: bool = also(held_r5, r6 == 127);
    let r7: i16 = narrow_u32_to_i16_wrapping(inputs.max_u32);
    let held_r7: bool = also(held_r6, r7 == -1);
    let r8: i32 = narrow_u32_to_i32_wrapping(inputs.max_u32);
    let held_r8: bool = also(held_r7, r8 == -1);
    let r9: i32 = narrow_u32_to_i32_wrapping(inputs.half_u32);
    let held_r9: bool = also(held_r8, r9 == -2147483648);
    let r10: i32 = narrow_u32_to_i32_saturating(inputs.half_u32);
    let held_r10: bool = also(held_r9, r10 == 2147483647);
    held_r10
}

machine named_conversion_checks(inputs: &Inputs) -> bool {
    let d1: i8 = narrow_u8_to_i8_wrapping(200u8);
    let held_d1: bool = d1 == -56;
    let d2: i16 = narrow_u32_to_i16_trapping(32767u32);
    let held_d2: bool = also(held_d1, d2 == 32767);
    let d3: i32 = narrow_u32_to_i32_wrapping(inputs.max_u32);
    let held_d3: bool = also(held_d2, d3 == -1);
    held_d3
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        max_u8: 255,
        half_u8: 128,
        max_u16: 65535,
        half_u16: 32768,
        max_u32: 4294967295,
        half_u32: 2147483648,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    let named_conversion_checks_held: bool = named_conversion_checks(&inputs);
    transition literal_checks_held && runtime_checks_held && named_conversion_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
