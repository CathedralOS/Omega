// Exact content claims move through projected provider arguments and a
// projected retained result. The authored partition and custody contracts
// remain unchanged; native and Terminal execution must both exit 70.
use omega::language::core::content;
use omega::language::core::drop;
use omega_language_std::console;

public data ByteUnit {}

public data Region [linear] {
    remaining: u64;
}

machine Region::drop(region: &mut Region) {}

public domain Region::Owned;

public machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

public data SplitResult {
    left: Region in Owned;
    right: Region in Owned;
}

public boundary trait RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    reaches
    requires head <= whole.remaining
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        );
}

public boundary trait RegionSink {
    machine accept(piece: Region in Owned) reaches;
}


data Main {
}

machine Main::partition_and_retain(main: &mut Main, whole: Region in Owned, head: u64) -> Region in Owned
requires head <= whole.remaining
reaches RegionSplit, RegionSink
{
    let split: SplitResult = RegionSplit::split(whole, head);
    RegionSink::accept(split.left);
    split.right
}

machine Main::main(main: &mut Main) reaches Console, RegionSplit, RegionSink {
    let whole: Region in Owned = Region { remaining: 8 };
    let retained: Region in Owned = Main::partition_and_retain(main, whole, 2);
    let correct: bool = retained.remaining == 6;
    RegionSink::accept(retained);
    transition correct {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(72); }
}

RegionSplitImplementation satisfies RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    requires head <= whole.remaining
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        )
    {
        let left: Region in Owned = Region { remaining: head };
        let right: Region in Owned = Region { remaining: whole.remaining - head };
        drop(whole);
        SplitResult { left: left, right: right }
    }
}

RegionSinkImplementation satisfies RegionSink {
    machine accept(piece: Region in Owned)
    {
        drop(piece);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console, RegionSplit, RegionSink {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
