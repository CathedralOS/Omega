// u64-to-signed conversion through the public numeric_conversion surface:
// u64 into i8, i16, i32 and i64 under Exact, Wrapping, Saturating and
// Trapping, with sources above i64::MAX. Those values must stay unsigned
// until a policy selects the result: Wrapping maps 2^63 to i64::MIN and
// u64::MAX to -1, and Saturating maps every value from 2^63 upward to the
// target maximum rather than reading the high bit as a sign.
// `literal_checks` passes constants, `runtime_checks` reads the
// boundaries through a borrowed record, and `named_conversion_checks` checks conversions
// on typed literals and on loaded operands.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    max_u64: u64;
    past_i64_in_u64: u64;
    max_i64_in_u64: u64;
    zero_u64: u64;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: i8 = narrow_u64_to_i8_exact(127);
    let held_l1: bool = l1 == 127;
    let l2: i8 = narrow_u64_to_i8_wrapping(18446744073709551615);
    let held_l2: bool = also(held_l1, l2 == -1);
    let l3: i8 = narrow_u64_to_i8_saturating(9223372036854775808);
    let held_l3: bool = also(held_l2, l3 == 127);
    let l4: i8 = narrow_u64_to_i8_trapping(127);
    let held_l4: bool = also(held_l3, l4 == 127);
    let l5: i16 = narrow_u64_to_i16_exact(32767);
    let held_l5: bool = also(held_l4, l5 == 32767);
    let l6: i16 = narrow_u64_to_i16_wrapping(9223372036854808576);
    let held_l6: bool = also(held_l5, l6 == -32768);
    let l7: i16 = narrow_u64_to_i16_saturating(18446744073709551615);
    let held_l7: bool = also(held_l6, l7 == 32767);
    let l8: i16 = narrow_u64_to_i16_trapping(0);
    let held_l8: bool = also(held_l7, l8 == 0);
    let l9: i32 = narrow_u64_to_i32_exact(2147483647);
    let held_l9: bool = also(held_l8, l9 == 2147483647);
    let l10: i32 = narrow_u64_to_i32_wrapping(9223372036854775807);
    let held_l10: bool = also(held_l9, l10 == -1);
    let l11: i32 = narrow_u64_to_i32_saturating(4294967296);
    let held_l11: bool = also(held_l10, l11 == 2147483647);
    let l12: i32 = narrow_u64_to_i32_trapping(2147483647);
    let held_l12: bool = also(held_l11, l12 == 2147483647);
    let l13: i64 = narrow_u64_to_i64_exact(9223372036854775807);
    let held_l13: bool = also(held_l12, l13 == 9223372036854775807);
    let l14: i64 = narrow_u64_to_i64_wrapping(9223372036854775808);
    let held_l14: bool = also(held_l13, l14 == -9223372036854775808);
    let l15: i64 = narrow_u64_to_i64_wrapping(18446744073709551615);
    let held_l15: bool = also(held_l14, l15 == -1);
    let l16: i64 = narrow_u64_to_i64_saturating(9223372036854775808);
    let held_l16: bool = also(held_l15, l16 == 9223372036854775807);
    let l17: i64 = narrow_u64_to_i64_saturating(9223372036854775807);
    let held_l17: bool = also(held_l16, l17 == 9223372036854775807);
    let l18: i64 = narrow_u64_to_i64_saturating(12345);
    let held_l18: bool = also(held_l17, l18 == 12345);
    let l19: i64 = narrow_u64_to_i64_trapping(9223372036854775807);
    let held_l19: bool = also(held_l18, l19 == 9223372036854775807);
    held_l19
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: i64 = narrow_u64_to_i64_wrapping(inputs.past_i64_in_u64);
    let held_r1: bool = r1 == -9223372036854775808;
    let r2: i64 = narrow_u64_to_i64_saturating(inputs.max_u64);
    let held_r2: bool = also(held_r1, r2 == 9223372036854775807);
    let r3: i64 = narrow_u64_to_i64_saturating(inputs.past_i64_in_u64);
    let held_r3: bool = also(held_r2, r3 == 9223372036854775807);
    let r4: i64 = narrow_u64_to_i64_saturating(inputs.max_i64_in_u64);
    let held_r4: bool = also(held_r3, r4 == 9223372036854775807);
    let r5: i64 = narrow_u64_to_i64_saturating(inputs.zero_u64);
    let held_r5: bool = also(held_r4, r5 == 0);
    let r6: i64 = narrow_u64_to_i64_trapping(inputs.max_i64_in_u64);
    let held_r6: bool = also(held_r5, r6 == 9223372036854775807);
    let r7: i32 = narrow_u64_to_i32_saturating(inputs.max_u64);
    let held_r7: bool = also(held_r6, r7 == 2147483647);
    let r8: i32 = narrow_u64_to_i32_wrapping(inputs.max_u64);
    let held_r8: bool = also(held_r7, r8 == -1);
    let r9: i16 = narrow_u64_to_i16_saturating(inputs.past_i64_in_u64);
    let held_r9: bool = also(held_r8, r9 == 32767);
    let r10: i8 = narrow_u64_to_i8_saturating(inputs.max_u64);
    let held_r10: bool = also(held_r9, r10 == 127);
    let r11: i8 = narrow_u64_to_i8_wrapping(inputs.past_i64_in_u64);
    let held_r11: bool = also(held_r10, r11 == 0);
    held_r11
}

machine named_conversion_checks(inputs: &Inputs) -> bool {
    let d1: i64 = narrow_u64_to_i64_trapping(9223372036854775807u64);
    let held_d1: bool = d1 == 9223372036854775807;
    let d2: i64 = narrow_u64_to_i64_wrapping(inputs.max_u64);
    let held_d2: bool = also(held_d1, d2 == -1);
    let d3: i64 = narrow_u64_to_i64_wrapping(inputs.past_i64_in_u64);
    let held_d3: bool = also(held_d2, d3 == -9223372036854775808);
    held_d3
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        max_u64: 18446744073709551615,
        past_i64_in_u64: 9223372036854775808,
        max_i64_in_u64: 9223372036854775807,
        zero_u64: 0,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    let named_conversion_checks_held: bool = named_conversion_checks(&inputs);
    transition literal_checks_held && runtime_checks_held && named_conversion_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
