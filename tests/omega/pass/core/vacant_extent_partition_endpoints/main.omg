// Source-contract endpoints only; this fixture supplies no physical backing.
use omega::language::core::extent;
machine empty_request(whole: Extent in Granted & Vacant) -> VacantExtentParts
ensures result.taken.base == whole.base,
        result.taken.length == 0, result.rest.length == whole.length
{ split_vacant_extent(whole, 0) }

machine full_request(whole: Extent in Granted & Vacant) -> VacantExtentParts
ensures result.taken.base == whole.base,
        result.taken.length == whole.length, result.rest.length == 0
{
    let length: u64 = whole.length;
    split_vacant_extent(whole, length)
}

machine exclusive_upper_bound(whole: Extent in Granted & Vacant) -> VacantExtentParts
requires embed(whole.base) + embed(whole.length) == addr::Bound
ensures result.taken.base == whole.base,
        result.taken.length == whole.length, result.rest.length == 0
{
    let length: u64 = whole.length;
    split_vacant_extent(whole, length)
}
machine main() {}
