// A checked partition derives authority from the consumed input, not from an
// issuer or a destructor. The result's nominal carrier claims already exist;
// the conservation transaction must give them the parent's backing lineage.
use omega::language::core::extent;
use omega::language::core::content;

data Pieces {
    left: Extent in Granted;
    right: Extent in Granted;
}

machine split(whole: Extent in Granted, requested: u64) -> Pieces
requires requested < whole.length
ensures Granted::content(old(&whole)) == separate(
    Granted::content(&result.left), Granted::content(&result.right))
{
    let left: Extent = Extent { base: whole.base, length: requested };
    let right: Extent = Extent {
        base: whole.base + requested,
        length: whole.length - requested
    };
    Pieces { left: left, right: right }
}
