// The named conversion rejects a negative signed source before producing a
// u8 result. Both engines must trap rather than wrap -1 to 255.
use omega::language::core::numeric_conversion;

data Inputs { source: i16; }

machine main() {
    let inputs: Inputs = Inputs { source: -1 };
    let converted: u8 = narrow_i16_to_u8_trapping(inputs.source);
    transition converted == 255 {
        true -> wrapped()
        _ -> other()
    }

    machine wrapped() {}
    machine other() {}
}
