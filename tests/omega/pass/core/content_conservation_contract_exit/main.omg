// An established owned input is partitioned through an INVOKED boundary
// requirement, and `Main::main` runs it natively: `split` hands `whole` to
// the authored `separate` theorem, both residual claims leave through a
// custody-exit boundary, and the retained half's magnitude selects the exit
// code. Until this fixture gained executable providers it declared the
// contract, called it, and refused native realization, so owned-content
// custody had no executed coverage anywhere in the corpus.
//
// The partition primitive is called DIRECTLY. Routing it through a checked
// wrapper machine instead -- `forward(partition, whole)` calling
// `RegionSplit::split(whole)` -- is what the earlier shape did, and it does not
// check: the partition composition is recorded against the wrapper that
// calls the boundary, so the wrapper's own caller sees a linear result with
// no conserved claim mapping. That is the transitive derivation chain
// `ContentPartitionCompositionFact::source_derivation_depth` documents
// Terminal cannot yet replay. A wrapper-composed exit is still owed.
//
// Both halves of the contract are exercised. `partition_and_retain` is the
// caller-retains half: the boundary accepts the exact residual and the
// machine keeps the rest, returning it to its own caller. Returning `right`
// directly is what makes that legal -- a path-aligned source place. An entry
// cannot host this half itself, because a program entry returns nothing, so
// `main` drives it and disposes of what comes back.
use omega::language::core::content;
use omega::language::core::drop;
use omega_language_std::console;

pub data ByteUnit {}

pub data Region [linear] {
    remaining: u64;
}

// The type owner authorizes the only cleanup plan; linear custody still
// has to be transferred or dropped exactly once.
machine Region::drop(region: &mut Region) {}

pub domain Region::Owned;

pub machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

pub data SplitResult {
    left: Region in Owned;
    right: Region in Owned;
}

pub boundary trait RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    requires head <= whole.remaining
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        );
}

// The custody exit: a selected boundary accepts a residual outright. It
// admits acceptance of custody, never the partition arithmetic.
pub boundary trait RegionSink {
    machine accept(piece: Region in Owned);
}

// The selected provider pair the entry's `Binding` fields demand. The
// partition primitive is a checked body that authors its own theorem: it
// carves `head` units off the input into a fresh owned piece, reissues the
// remainder as the second piece, and retires the consumed input through the
// owner's cleanup plan. The checker proves the authored `separate` law from
// that body -- the entry magnitude equals the sum of the two issued
// magnitudes -- so the provider is admitted on evidence, not trust. The
// custody exit below admits acceptance of custody only.
data RegionSplitProvider { }

machine RegionSplitProvider::split(whole: Region in Owned, head: u64) -> SplitResult
satisfies RegionSplit::split
requires head <= whole.remaining
ensures
    Owned::content(old(&whole))
    == separate(
        Owned::content(&result.left),
        Owned::content(&result.right),
    )
{
    let left: Region in Owned = Region { remaining: head };
    let right: Region in Owned = Region { remaining: whole.remaining - head };
    drop(whole);
    SplitResult { left: left, right: right }
}

data RegionSinkProvider { }

machine RegionSinkProvider::accept(piece: Region in Owned)
satisfies RegionSink::accept
{
    drop(piece);
}

data Main {
}

machine Main::partition_and_retain(main: &mut Main, whole: Region in Owned, head: u64) -> Region in Owned
requires head <= whole.remaining
reaches RegionSplit, RegionSink
{
    let split: SplitResult = RegionSplit::split(whole, head);
    let { left, right } = split;
    RegionSink::accept(left);
    right
}

machine Main::main(main: &mut Main) reaches Console, RegionSplit, RegionSink {
    let whole: Region in Owned = Region { remaining: 8 };
    let retained: Region in Owned = Main::partition_and_retain(main, whole, 2);
    let correct: bool = retained.remaining == 6;
    RegionSink::accept(retained);
    transition correct {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}

RegionSplitImplementation satisfies RegionSplit {
    RegionSplit::split = RegionSplitProvider::split;
}
RegionSinkImplementation satisfies RegionSink {
    RegionSink::accept = RegionSinkProvider::accept;
}
