// Expected exit: 0
use omega::language::core::content;
use omega::language::core::drop;
data Units {}
data Payload {}
data Region [linear] { amount: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<Units>
satisfies Content<Region, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(region.amount) as Nat }
}
trait Transfer<T> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures Owned::content(old(&region)) == Owned::content(&result);
}
machine retain(region: Region in Owned) -> Region in Owned
satisfies Transfer<Payload>::transfer
ensures Owned::content(old(&region)) == Owned::content(&result)
{ region }
machine apply<machine Callback>(region: Region in Owned) -> Region in Owned
where machine Callback(region: Region in Owned) -> Region in Owned
    ensures Owned::content(old(&region)) == Owned::content(&result);
{ Callback(region) }
machine main() crashes Trap {
    let original: Region in Owned = Region { amount: 29 };
    let returned: Region in Owned = apply<retain>(original);
    let correct: bool = returned.amount == 29;
    drop(returned);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
