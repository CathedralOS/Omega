// Same-sign unsigned narrowing through the public numeric_conversion surface:
// every u16/u32/u64 source to every narrower unsigned target under Exact,
// Wrapping, Saturating and Trapping, at 0, the target maximum, the first
// value past it, and u64 sources above i64::MAX. Wrapping reduces modulo
// the target width, Saturating clamps to the target maximum, and an
// in-range Trapping conversion returns its value. `literal_checks` passes
// constants, `runtime_checks` reads the boundaries through a borrowed
// record, and `named_conversion_checks` checks conversions on typed literals
// and on loaded operands.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    max_u16: u16;
    past_u8_in_u16: u16;
    max_u32: u32;
    past_u16_in_u32: u32;
    max_u64: u64;
    past_u32_in_u64: u64;
    past_i64_in_u64: u64;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: u8 = narrow_u16_to_u8_exact(255);
    let held_l1: bool = l1 == 255;
    let l2: u8 = narrow_u16_to_u8_exact(0);
    let held_l2: bool = also(held_l1, l2 == 0);
    let l3: u8 = narrow_u16_to_u8_wrapping(256);
    let held_l3: bool = also(held_l2, l3 == 0);
    let l4: u8 = narrow_u16_to_u8_wrapping(300);
    let held_l4: bool = also(held_l3, l4 == 44);
    let l5: u8 = narrow_u16_to_u8_saturating(256);
    let held_l5: bool = also(held_l4, l5 == 255);
    let l6: u8 = narrow_u16_to_u8_saturating(200);
    let held_l6: bool = also(held_l5, l6 == 200);
    let l7: u8 = narrow_u16_to_u8_trapping(255);
    let held_l7: bool = also(held_l6, l7 == 255);
    let l8: u8 = narrow_u32_to_u8_exact(255);
    let held_l8: bool = also(held_l7, l8 == 255);
    let l9: u8 = narrow_u32_to_u8_wrapping(257);
    let held_l9: bool = also(held_l8, l9 == 1);
    let l10: u8 = narrow_u32_to_u8_saturating(256);
    let held_l10: bool = also(held_l9, l10 == 255);
    let l11: u8 = narrow_u32_to_u8_trapping(0);
    let held_l11: bool = also(held_l10, l11 == 0);
    let l12: u16 = narrow_u32_to_u16_exact(65535);
    let held_l12: bool = also(held_l11, l12 == 65535);
    let l13: u16 = narrow_u32_to_u16_wrapping(70000);
    let held_l13: bool = also(held_l12, l13 == 4464);
    let l14: u16 = narrow_u32_to_u16_saturating(65536);
    let held_l14: bool = also(held_l13, l14 == 65535);
    let l15: u16 = narrow_u32_to_u16_saturating(65535);
    let held_l15: bool = also(held_l14, l15 == 65535);
    let l16: u16 = narrow_u32_to_u16_trapping(65535);
    let held_l16: bool = also(held_l15, l16 == 65535);
    let l17: u8 = narrow_u64_to_u8_exact(255);
    let held_l17: bool = also(held_l16, l17 == 255);
    let l18: u8 = narrow_u64_to_u8_wrapping(9223372036854775808);
    let held_l18: bool = also(held_l17, l18 == 0);
    let l19: u8 = narrow_u64_to_u8_saturating(9223372036854775808);
    let held_l19: bool = also(held_l18, l19 == 255);
    let l20: u8 = narrow_u64_to_u8_trapping(255);
    let held_l20: bool = also(held_l19, l20 == 255);
    let l21: u16 = narrow_u64_to_u16_exact(65535);
    let held_l21: bool = also(held_l20, l21 == 65535);
    let l22: u16 = narrow_u64_to_u16_wrapping(4295032833);
    let held_l22: bool = also(held_l21, l22 == 1);
    let l23: u16 = narrow_u64_to_u16_saturating(18446744073709551615);
    let held_l23: bool = also(held_l22, l23 == 65535);
    let l24: u16 = narrow_u64_to_u16_trapping(1);
    let held_l24: bool = also(held_l23, l24 == 1);
    let l25: u32 = narrow_u64_to_u32_exact(4294967295);
    let held_l25: bool = also(held_l24, l25 == 4294967295);
    let l26: u32 = narrow_u64_to_u32_wrapping(9223372036854775809);
    let held_l26: bool = also(held_l25, l26 == 1);
    let l27: u32 = narrow_u64_to_u32_saturating(4294967296);
    let held_l27: bool = also(held_l26, l27 == 4294967295);
    let l28: u32 = narrow_u64_to_u32_trapping(4294967295);
    let held_l28: bool = also(held_l27, l28 == 4294967295);
    held_l28
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: u8 = narrow_u16_to_u8_wrapping(inputs.max_u16);
    let held_r1: bool = r1 == 255;
    let r2: u8 = narrow_u16_to_u8_wrapping(inputs.past_u8_in_u16);
    let held_r2: bool = also(held_r1, r2 == 0);
    let r3: u8 = narrow_u16_to_u8_saturating(inputs.max_u16);
    let held_r3: bool = also(held_r2, r3 == 255);
    let r4: u8 = narrow_u16_to_u8_saturating(inputs.past_u8_in_u16);
    let held_r4: bool = also(held_r3, r4 == 255);
    let r5: u8 = narrow_u32_to_u8_wrapping(inputs.max_u32);
    let held_r5: bool = also(held_r4, r5 == 255);
    let r6: u8 = narrow_u32_to_u8_saturating(inputs.max_u32);
    let held_r6: bool = also(held_r5, r6 == 255);
    let r7: u16 = narrow_u32_to_u16_wrapping(inputs.past_u16_in_u32);
    let held_r7: bool = also(held_r6, r7 == 0);
    let r8: u16 = narrow_u32_to_u16_saturating(inputs.past_u16_in_u32);
    let held_r8: bool = also(held_r7, r8 == 65535);
    let r9: u8 = narrow_u64_to_u8_wrapping(inputs.max_u64);
    let held_r9: bool = also(held_r8, r9 == 255);
    let r10: u8 = narrow_u64_to_u8_saturating(inputs.past_i64_in_u64);
    let held_r10: bool = also(held_r9, r10 == 255);
    let r11: u16 = narrow_u64_to_u16_wrapping(inputs.max_u64);
    let held_r11: bool = also(held_r10, r11 == 65535);
    let r12: u16 = narrow_u64_to_u16_saturating(inputs.past_u32_in_u64);
    let held_r12: bool = also(held_r11, r12 == 65535);
    let r13: u32 = narrow_u64_to_u32_wrapping(inputs.past_u32_in_u64);
    let held_r13: bool = also(held_r12, r13 == 0);
    let r14: u32 = narrow_u64_to_u32_wrapping(inputs.max_u64);
    let held_r14: bool = also(held_r13, r14 == 4294967295);
    let r15: u32 = narrow_u64_to_u32_saturating(inputs.past_i64_in_u64);
    let held_r15: bool = also(held_r14, r15 == 4294967295);
    let r16: u32 = narrow_u64_to_u32_saturating(inputs.max_u64);
    let held_r16: bool = also(held_r15, r16 == 4294967295);
    held_r16
}

machine named_conversion_checks(inputs: &Inputs) -> bool {
    let d1: u8 = narrow_u16_to_u8_wrapping(300u16);
    let held_d1: bool = d1 == 44;
    let d2: u16 = narrow_u32_to_u16_saturating(70000u32);
    let held_d2: bool = also(held_d1, d2 == 65535);
    let d3: u32 = narrow_u64_to_u32_trapping(4294967295u64);
    let held_d3: bool = also(held_d2, d3 == 4294967295);
    let d4: u32 = narrow_u64_to_u32_wrapping(inputs.past_i64_in_u64);
    let held_d4: bool = also(held_d3, d4 == 0);
    let d5: u8 = narrow_u64_to_u8_saturating(inputs.max_u64);
    let held_d5: bool = also(held_d4, d5 == 255);
    held_d5
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        max_u16: 65535,
        past_u8_in_u16: 256,
        max_u32: 4294967295,
        past_u16_in_u32: 65536,
        max_u64: 18446744073709551615,
        past_u32_in_u64: 4294967296,
        past_i64_in_u64: 9223372036854775808,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    let named_conversion_checks_held: bool = named_conversion_checks(&inputs);
    transition literal_checks_held && runtime_checks_held && named_conversion_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
