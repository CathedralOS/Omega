// Expected exit: 0. A materialized owned entry record can be updated and returned.
data Word { value: u32; }
machine update(mut input: Word) -> Word ensures result.value == 7 {
    input.value = 7;
    input
}
data Box { word: Word; }
machine pack(input: Word) -> Word {
    let box: Box = Box { word: input };
    box.word
}
machine main() crashes Trap {
    let result: Word = update(pack(Word { value: 1 }));
    transition result.value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
