// Signed-to-unsigned conversion through the public numeric_conversion
// surface for i32 and i64 sources into every unsigned target, under Exact,
// Wrapping, Saturating and Trapping. Negative sources wrap modulo the
// target width (i64::MIN -> u64 2^63, above i64::MAX) and saturate to 0;
// positive sources saturate at the target maximum. `literal_checks` passes
// constants, `runtime_checks` reads the boundaries through a borrowed
// record, and `named_conversion_checks` checks conversions on typed literals
// and on loaded operands.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    min_i32: i32;
    negative_one_i32: i32;
    max_i32: i32;
    min_i64: i64;
    negative_one_i64: i64;
    max_i64: i64;
    past_u32_in_i64: i64;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: u8 = narrow_i32_to_u8_exact(255);
    let held_l1: bool = l1 == 255;
    let l2: u8 = narrow_i32_to_u8_wrapping(-1);
    let held_l2: bool = also(held_l1, l2 == 255);
    let l3: u8 = narrow_i32_to_u8_saturating(2147483647);
    let held_l3: bool = also(held_l2, l3 == 255);
    let l4: u8 = narrow_i32_to_u8_saturating(-2147483648);
    let held_l4: bool = also(held_l3, l4 == 0);
    let l5: u8 = narrow_i32_to_u8_trapping(255);
    let held_l5: bool = also(held_l4, l5 == 255);
    let l6: u16 = narrow_i32_to_u16_exact(65535);
    let held_l6: bool = also(held_l5, l6 == 65535);
    let l7: u16 = narrow_i32_to_u16_wrapping(65536);
    let held_l7: bool = also(held_l6, l7 == 0);
    let l8: u16 = narrow_i32_to_u16_saturating(65536);
    let held_l8: bool = also(held_l7, l8 == 65535);
    let l9: u16 = narrow_i32_to_u16_saturating(-5);
    let held_l9: bool = also(held_l8, l9 == 0);
    let l10: u16 = narrow_i32_to_u16_trapping(65535);
    let held_l10: bool = also(held_l9, l10 == 65535);
    let l11: u32 = narrow_i32_to_u32_exact(2147483647);
    let held_l11: bool = also(held_l10, l11 == 2147483647);
    let l12: u32 = narrow_i32_to_u32_wrapping(-2147483648);
    let held_l12: bool = also(held_l11, l12 == 2147483648);
    let l13: u32 = narrow_i32_to_u32_saturating(-1);
    let held_l13: bool = also(held_l12, l13 == 0);
    let l14: u32 = narrow_i32_to_u32_trapping(2147483647);
    let held_l14: bool = also(held_l13, l14 == 2147483647);
    let l15: u64 = narrow_i32_to_u64_exact(2147483647);
    let held_l15: bool = also(held_l14, l15 == 2147483647);
    let l16: u64 = narrow_i32_to_u64_wrapping(-2147483648);
    let held_l16: bool = also(held_l15, l16 == 18446744071562067968);
    let l17: u64 = narrow_i32_to_u64_saturating(-1);
    let held_l17: bool = also(held_l16, l17 == 0);
    let l18: u64 = narrow_i32_to_u64_trapping(0);
    let held_l18: bool = also(held_l17, l18 == 0);
    let l19: u8 = narrow_i64_to_u8_exact(255);
    let held_l19: bool = also(held_l18, l19 == 255);
    let l20: u8 = narrow_i64_to_u8_wrapping(-1);
    let held_l20: bool = also(held_l19, l20 == 255);
    let l21: u8 = narrow_i64_to_u8_saturating(9223372036854775807);
    let held_l21: bool = also(held_l20, l21 == 255);
    let l22: u8 = narrow_i64_to_u8_trapping(0);
    let held_l22: bool = also(held_l21, l22 == 0);
    let l23: u16 = narrow_i64_to_u16_exact(65535);
    let held_l23: bool = also(held_l22, l23 == 65535);
    let l24: u16 = narrow_i64_to_u16_wrapping(-65536);
    let held_l24: bool = also(held_l23, l24 == 0);
    let l25: u16 = narrow_i64_to_u16_saturating(65536);
    let held_l25: bool = also(held_l24, l25 == 65535);
    let l26: u16 = narrow_i64_to_u16_trapping(65535);
    let held_l26: bool = also(held_l25, l26 == 65535);
    let l27: u32 = narrow_i64_to_u32_exact(4294967295);
    let held_l27: bool = also(held_l26, l27 == 4294967295);
    let l28: u32 = narrow_i64_to_u32_wrapping(4294967296);
    let held_l28: bool = also(held_l27, l28 == 0);
    let l29: u32 = narrow_i64_to_u32_saturating(4294967296);
    let held_l29: bool = also(held_l28, l29 == 4294967295);
    let l30: u32 = narrow_i64_to_u32_saturating(-1);
    let held_l30: bool = also(held_l29, l30 == 0);
    let l31: u32 = narrow_i64_to_u32_trapping(4294967295);
    let held_l31: bool = also(held_l30, l31 == 4294967295);
    let l32: u64 = narrow_i64_to_u64_exact(9223372036854775807);
    let held_l32: bool = also(held_l31, l32 == 9223372036854775807);
    let l33: u64 = narrow_i64_to_u64_wrapping(-1);
    let held_l33: bool = also(held_l32, l33 == 18446744073709551615);
    let l34: u64 = narrow_i64_to_u64_wrapping(-9223372036854775808);
    let held_l34: bool = also(held_l33, l34 == 9223372036854775808);
    let l35: u64 = narrow_i64_to_u64_saturating(-9223372036854775808);
    let held_l35: bool = also(held_l34, l35 == 0);
    let l36: u64 = narrow_i64_to_u64_saturating(9223372036854775807);
    let held_l36: bool = also(held_l35, l36 == 9223372036854775807);
    let l37: u64 = narrow_i64_to_u64_trapping(9223372036854775807);
    let held_l37: bool = also(held_l36, l37 == 9223372036854775807);
    held_l37
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: u8 = narrow_i32_to_u8_wrapping(inputs.min_i32);
    let held_r1: bool = r1 == 0;
    let r2: u16 = narrow_i32_to_u16_wrapping(inputs.negative_one_i32);
    let held_r2: bool = also(held_r1, r2 == 65535);
    let r3: u32 = narrow_i32_to_u32_wrapping(inputs.min_i32);
    let held_r3: bool = also(held_r2, r3 == 2147483648);
    let r4: u32 = narrow_i32_to_u32_saturating(inputs.max_i32);
    let held_r4: bool = also(held_r3, r4 == 2147483647);
    let r5: u64 = narrow_i32_to_u64_wrapping(inputs.negative_one_i32);
    let held_r5: bool = also(held_r4, r5 == 18446744073709551615);
    let r6: u64 = narrow_i32_to_u64_saturating(inputs.min_i32);
    let held_r6: bool = also(held_r5, r6 == 0);
    let r7: u8 = narrow_i64_to_u8_saturating(inputs.min_i64);
    let held_r7: bool = also(held_r6, r7 == 0);
    let r8: u16 = narrow_i64_to_u16_saturating(inputs.max_i64);
    let held_r8: bool = also(held_r7, r8 == 65535);
    let r9: u32 = narrow_i64_to_u32_saturating(inputs.past_u32_in_i64);
    let held_r9: bool = also(held_r8, r9 == 4294967295);
    let r10: u32 = narrow_i64_to_u32_wrapping(inputs.negative_one_i64);
    let held_r10: bool = also(held_r9, r10 == 4294967295);
    let r11: u64 = narrow_i64_to_u64_wrapping(inputs.min_i64);
    let held_r11: bool = also(held_r10, r11 == 9223372036854775808);
    let r12: u64 = narrow_i64_to_u64_saturating(inputs.negative_one_i64);
    let held_r12: bool = also(held_r11, r12 == 0);
    let r13: u64 = narrow_i64_to_u64_trapping(inputs.max_i64);
    let held_r13: bool = also(held_r12, r13 == 9223372036854775807);
    held_r13
}

machine named_conversion_checks(inputs: &Inputs) -> bool {
    let d1: u64 = narrow_i64_to_u64_trapping(9223372036854775807i64);
    let held_d1: bool = d1 == 9223372036854775807;
    let d2: u32 = narrow_i64_to_u32_wrapping(inputs.negative_one_i64);
    let held_d2: bool = also(held_d1, d2 == 4294967295);
    let d3: u64 = narrow_i64_to_u64_wrapping(inputs.min_i64);
    let held_d3: bool = also(held_d2, d3 == 9223372036854775808);
    held_d3
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        min_i32: -2147483648,
        negative_one_i32: -1,
        max_i32: 2147483647,
        min_i64: -9223372036854775808,
        negative_one_i64: -1,
        max_i64: 9223372036854775807,
        past_u32_in_i64: 4294967296,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    let named_conversion_checks_held: bool = named_conversion_checks(&inputs);
    transition literal_checks_held && runtime_checks_held && named_conversion_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
