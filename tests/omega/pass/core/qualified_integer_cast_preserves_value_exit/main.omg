// Computed sources and selected results retain their declared carriers in Prop.
domain i16::Identity(value)
    requires ((value + 0i16) as i16 in Wrapping) == value {}
proposition same(value: i16) = (value as i16 in Trapping) == value;
machine identity(value: i16) -> i16
ensures (result as i16 in Trapping) == result, result == value { value }
machine same_call(value: i16) -> i16
ensures (identity(value) as i16 in Saturating) == result { value }

// Carrier coercion preserves the source value. The selected target policy
// governs arithmetic performed after that exact coercion.
machine wrapping(value: u16) -> u8 requires value <= 255 {
    let narrowed: u8 in Wrapping = value as u8 in Wrapping;
    (narrowed + 100) as u8
}
machine saturating(value: i16) -> i8
requires value >= -128 && value <= 127 {
    let narrowed: i8 in Saturating = value as i8 in Saturating;
    (narrowed + 20) as i8
}
machine trapping(value: i16) -> i8 in Trapping
requires value >= -128 && value <= 127 {
    // A proved coercion introduces no crash site or ceiling obligation.
    value as i8 in Trapping
}
machine bounded() -> u16 ensures result <= 255 { 200u16 }
// Invocation bounds retain copied locals and complete named state transfers.
machine forwarded(value: u16) -> u16 {
    let copied: u16 = value;
    transition { _ -> finish(copied) }
    machine finish(value: u16) -> u16 { value & 255u16 }
}
machine accept(value: u8 in Wrapping) -> u8 { (value + 100) as u8 }
machine main() crashes Trap {
    let identity_result: i16 = same_call(-100i16);
    let wrapped: u8 = wrapping(200u16);
    let saturated: i8 = saturating(120i16);
    let exact: i8 = trapping(-100i16) as i8;
    // The call result and the nested argument retain their own carriers.
    let nested: u8 = accept(bounded() as u8 in Wrapping);
    let forwarded_result: u8 = accept(forwarded(456u16) as u8 in Wrapping);
    transition identity_result == -100i16 && wrapped == 44u8 && saturated == 127i8 && exact == -100i8 && nested == 44u8 && forwarded_result == 44u8 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
