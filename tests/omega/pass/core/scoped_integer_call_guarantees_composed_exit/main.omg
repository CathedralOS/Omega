machine identity(value: i16) -> i16 ensures result == value { value }
machine composed(value: i16) -> i16
requires value >= -100i16 && value <= 100i16
ensures (identity(identity(value + 3i16)) as i16 in Saturating) == result {
    value + 3i16
}
// A noninteger input stays opaque while an independent integer guarantee
// remains available. Its type does not become a polynomial source recognizer.
machine constant(flag: bool) -> i16 ensures result == 7i16 { 7i16 }
machine with_boolean(flag: bool) -> i16
ensures (constant(flag) as i16 in Wrapping) == result { 7i16 }
machine main() crashes Trap {
    let value: i16 = composed(6i16);
    let other: i16 = with_boolean(true);
    transition value == 9i16 && other == 7i16 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
