// A signed Trapping narrowing traps on the low side too: i32 -129 is one
// below i8's minimum. The operand is loaded through a borrowed record in a
// separate machine, so the trap is the runtime check rather than a folded
// constant. Ending normally (exit 0) means the trap was lost.
use omega::language::core::numeric_conversion;

data Inputs { source: i32; }

machine convert(inputs: &Inputs) -> i8 {
    narrow_i32_to_i8_trapping(inputs.source)
}

machine main() {
    let inputs: Inputs = Inputs { source: -129 };
    let converted: i8 = convert(&inputs);
    transition converted < 0 {
        true -> negative()
        _ -> nonnegative()
    }

    machine negative() {}
    machine nonnegative() {}
}
