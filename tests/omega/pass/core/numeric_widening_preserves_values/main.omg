// Every widening conversion in the public numeric_conversion surface keeps
// its value: signed sources sign-extend (-128, -32768 and i32::MIN stay
// negative) and unsigned sources zero-extend into both unsigned and
// signed targets (u8 255 -> i16 255, never -1). `literal_checks` passes
// constants; `runtime_checks` reads the extremes through a borrowed
// record.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    max_u8: u8;
    max_u16: u16;
    max_u32: u32;
    min_i8: i8;
    min_i16: i16;
    min_i32: i32;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: u16 = widen_u8_to_u16(255);
    let held_l1: bool = l1 == 255;
    let l2: u32 = widen_u8_to_u32(255);
    let held_l2: bool = also(held_l1, l2 == 255);
    let l3: u64 = widen_u8_to_u64(0);
    let held_l3: bool = also(held_l2, l3 == 0);
    let l4: u32 = widen_u16_to_u32(65535);
    let held_l4: bool = also(held_l3, l4 == 65535);
    let l5: u64 = widen_u16_to_u64(65535);
    let held_l5: bool = also(held_l4, l5 == 65535);
    let l6: u64 = widen_u32_to_u64(4294967295);
    let held_l6: bool = also(held_l5, l6 == 4294967295);
    let l7: i16 = widen_i8_to_i16(-128);
    let held_l7: bool = also(held_l6, l7 == -128);
    let l8: i32 = widen_i8_to_i32(-1);
    let held_l8: bool = also(held_l7, l8 == -1);
    let l9: i64 = widen_i8_to_i64(127);
    let held_l9: bool = also(held_l8, l9 == 127);
    let l10: i32 = widen_i16_to_i32(-32768);
    let held_l10: bool = also(held_l9, l10 == -32768);
    let l11: i64 = widen_i16_to_i64(32767);
    let held_l11: bool = also(held_l10, l11 == 32767);
    let l12: i64 = widen_i32_to_i64(-2147483648);
    let held_l12: bool = also(held_l11, l12 == -2147483648);
    let l13: i16 = widen_u8_to_i16(255);
    let held_l13: bool = also(held_l12, l13 == 255);
    let l14: i32 = widen_u8_to_i32(128);
    let held_l14: bool = also(held_l13, l14 == 128);
    let l15: i64 = widen_u8_to_i64(255);
    let held_l15: bool = also(held_l14, l15 == 255);
    let l16: i32 = widen_u16_to_i32(65535);
    let held_l16: bool = also(held_l15, l16 == 65535);
    let l17: i64 = widen_u16_to_i64(32768);
    let held_l17: bool = also(held_l16, l17 == 32768);
    let l18: i64 = widen_u32_to_i64(4294967295);
    let held_l18: bool = also(held_l17, l18 == 4294967295);
    held_l18
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: i16 = widen_i8_to_i16(inputs.min_i8);
    let held_r1: bool = r1 == -128;
    let r2: i64 = widen_i8_to_i64(inputs.min_i8);
    let held_r2: bool = also(held_r1, r2 == -128);
    let r3: i32 = widen_i16_to_i32(inputs.min_i16);
    let held_r3: bool = also(held_r2, r3 == -32768);
    let r4: i64 = widen_i16_to_i64(inputs.min_i16);
    let held_r4: bool = also(held_r3, r4 == -32768);
    let r5: i64 = widen_i32_to_i64(inputs.min_i32);
    let held_r5: bool = also(held_r4, r5 == -2147483648);
    let r6: i16 = widen_u8_to_i16(inputs.max_u8);
    let held_r6: bool = also(held_r5, r6 == 255);
    let r7: i64 = widen_u8_to_i64(inputs.max_u8);
    let held_r7: bool = also(held_r6, r7 == 255);
    let r8: i32 = widen_u16_to_i32(inputs.max_u16);
    let held_r8: bool = also(held_r7, r8 == 65535);
    let r9: i64 = widen_u32_to_i64(inputs.max_u32);
    let held_r9: bool = also(held_r8, r9 == 4294967295);
    let r10: u64 = widen_u32_to_u64(inputs.max_u32);
    let held_r10: bool = also(held_r9, r10 == 4294967295);
    let r11: u32 = widen_u8_to_u32(inputs.max_u8);
    let held_r11: bool = also(held_r10, r11 == 255);
    held_r11
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        max_u8: 255,
        max_u16: 65535,
        max_u32: 4294967295,
        min_i8: -128,
        min_i16: -32768,
        min_i32: -2147483648,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    transition literal_checks_held && runtime_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
