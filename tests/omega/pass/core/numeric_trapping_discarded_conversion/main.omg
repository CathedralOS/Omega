// A discarded Trapping conversion result is dead, but the conversion is not:
// its trap is an effect, so `_ = ...` must still execute the check. u64
// 4294967296 is one past u32's maximum. Ending normally (exit 0) means the
// discarded call was removed with its result.
use omega::language::core::numeric_conversion;

data Inputs { source: u64; }

machine discard(inputs: &Inputs) {
    _ = narrow_u64_to_u32_trapping(inputs.source);
}

machine main() {
    let inputs: Inputs = Inputs { source: 4294967296 };
    discard(&inputs);
}
