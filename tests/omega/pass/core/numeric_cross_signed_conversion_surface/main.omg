use omega::language::core::numeric_conversion;
use omega_language_std::console;

data Main {
    unsigned_exact: i8;
    unsigned_exact_wide: i64;
    unsigned_wrapping: i8;
    unsigned_saturating: i8;
    unsigned_saturating_wide: i64;
    unsigned_trapping: i32;
    unsigned_widening: i32;
    signed_exact: u8;
    signed_exact_wide: u64;
    signed_wrapping: u8;
    signed_wrapping_wide: u64;
    signed_saturating_low: u8;
    signed_saturating_high: u8;
    signed_trapping: u32;
    expected_i64: i64;
    expected_u64: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    let negative_i8: i8 = 0 - 1;
    let negative_i16: i16 = 0 - 1;
    let high_i16: i16 = 300;
    let max_u64: u64 = 18446744073709551615;

    main.unsigned_exact = narrow_u8_to_i8_exact(100);
    main.unsigned_exact_wide = narrow_u64_to_i64_exact(5000000000);
    main.unsigned_wrapping = narrow_u8_to_i8_wrapping(255);
    main.unsigned_saturating = narrow_u16_to_i8_saturating(300);
    main.unsigned_saturating_wide = narrow_u64_to_i64_saturating(max_u64);
    main.unsigned_trapping = narrow_u32_to_i32_trapping(70);
    main.unsigned_widening = widen_u16_to_i32(65535);

    main.signed_exact = narrow_i16_to_u8_exact(200);
    main.signed_exact_wide = narrow_i64_to_u64_exact(5000000000);
    main.signed_wrapping = narrow_i16_to_u8_wrapping(negative_i16);
    main.signed_wrapping_wide = narrow_i8_to_u64_wrapping(negative_i8);
    main.signed_saturating_low = narrow_i16_to_u8_saturating(negative_i16);
    main.signed_saturating_high = narrow_i16_to_u8_saturating(high_i16);
    main.signed_trapping = narrow_i32_to_u32_trapping(70);
    main.expected_i64 = 9223372036854775807;
    main.expected_u64 = max_u64;

    transition main.unsigned_exact == 100 {
        true -> check_unsigned_exact_wide(main)
        _ -> bad1(main)
    }

    state check_unsigned_exact_wide(main: &mut Main) {
        transition main.unsigned_exact_wide == 5000000000 {
            true -> check_unsigned_wrapping(main)
            _ -> bad2(main)
        }
    }

    state check_unsigned_wrapping(main: &mut Main) {
        transition main.unsigned_wrapping == 0 - 1 {
            true -> check_unsigned_saturating(main)
            _ -> bad3(main)
        }
    }

    state check_unsigned_saturating(main: &mut Main) {
        transition main.unsigned_saturating == 127 {
            true -> check_unsigned_saturating_wide(main)
            _ -> bad4(main)
        }
    }

    state check_unsigned_saturating_wide(main: &mut Main) {
        transition main.unsigned_saturating_wide == main.expected_i64 {
            true -> check_unsigned_trapping(main)
            _ -> bad5(main)
        }
    }

    state check_unsigned_trapping(main: &mut Main) {
        transition main.unsigned_trapping == 70 {
            true -> check_unsigned_widening(main)
            _ -> bad6(main)
        }
    }

    state check_unsigned_widening(main: &mut Main) {
        transition main.unsigned_widening == 65535 {
            true -> check_signed_exact(main)
            _ -> bad7(main)
        }
    }

    state check_signed_exact(main: &mut Main) {
        transition main.signed_exact == 200 {
            true -> check_signed_exact_wide(main)
            _ -> bad8(main)
        }
    }

    state check_signed_exact_wide(main: &mut Main) {
        transition main.signed_exact_wide == 5000000000 {
            true -> check_signed_wrapping(main)
            _ -> bad9(main)
        }
    }

    state check_signed_wrapping(main: &mut Main) {
        transition main.signed_wrapping == 255 {
            true -> check_signed_wrapping_wide(main)
            _ -> bad10(main)
        }
    }

    state check_signed_wrapping_wide(main: &mut Main) {
        transition main.signed_wrapping_wide == main.expected_u64 {
            true -> check_signed_saturating_low(main)
            _ -> bad11(main)
        }
    }

    state check_signed_saturating_low(main: &mut Main) {
        transition main.signed_saturating_low == 0 {
            true -> check_signed_saturating_high(main)
            _ -> bad12(main)
        }
    }

    state check_signed_saturating_high(main: &mut Main) {
        transition main.signed_saturating_high == 255 {
            true -> check_signed_trapping(main)
            _ -> bad13(main)
        }
    }

    state check_signed_trapping(main: &mut Main) {
        transition main.signed_trapping == 70 {
            true -> good(main)
            _ -> bad14(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad1(main: &mut Main) { Console::exit_process(81); }
    state bad2(main: &mut Main) { Console::exit_process(82); }
    state bad3(main: &mut Main) { Console::exit_process(83); }
    state bad4(main: &mut Main) { Console::exit_process(84); }
    state bad5(main: &mut Main) { Console::exit_process(85); }
    state bad6(main: &mut Main) { Console::exit_process(86); }
    state bad7(main: &mut Main) { Console::exit_process(87); }
    state bad8(main: &mut Main) { Console::exit_process(88); }
    state bad9(main: &mut Main) { Console::exit_process(89); }
    state bad10(main: &mut Main) { Console::exit_process(90); }
    state bad11(main: &mut Main) { Console::exit_process(91); }
    state bad12(main: &mut Main) { Console::exit_process(92); }
    state bad13(main: &mut Main) { Console::exit_process(93); }
    state bad14(main: &mut Main) { Console::exit_process(94); }
}
