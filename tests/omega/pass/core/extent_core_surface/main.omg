use omega::language::core::extent;

// Extent exposes ordinary runtime geometry while `Granted` remains a bodyless
// authority fact. Its zero-usable container is an ordinary debt-free-first
// sum; only the Live path carries the conditional linear obligation.
data Holder {
    slot: ExtentSlot;
}

// Granted's geometry is a transparent mathematical value, not a runtime call.
machine no_wrap_is_geometry(base: addr, length: u64)
requires no_wrap(base, length)
ensures embed(base) + embed(length) <= addr::Bound
{}

machine main() {
}
