// An unsigned widening publishes its source interval as a postcondition
// (`widen_u8_to_u16` ensures `result >= 0 && result <= 255`, and
// `widen_u32_to_u64` also `result == (value as u64)`). Callers rely on that
// interval to discharge Exact arithmetic on the result: each shift or
// multiply here reaches exactly the target maximum or stays just below it,
// which only the source's own interval proves, never the wider target's.
// Operands are read through a borrowed record, so every bound comes from the
// published postcondition rather than a folded constant.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    max_u8: u8;
    max_u16: u16;
    max_u32: u32;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine unsigned_shifts(inputs: &Inputs) -> bool {
    let u1: u16 = widen_u8_to_u16(inputs.max_u8) << 8;
    let held_u1: bool = u1 == 65280;
    let u2: u32 = widen_u16_to_u32(inputs.max_u16) << 16;
    let held_u2: bool = also(held_u1, u2 == 4294901760);
    let u3: u64 = widen_u32_to_u64(inputs.max_u32) << 32;
    let held_u3: bool = also(held_u2, u3 == 18446744069414584320);
    held_u3
}

machine unsigned_products(inputs: &Inputs) -> bool {
    let u1: u32 = widen_u8_to_u32(inputs.max_u8) * 16843009;
    let held_u1: bool = u1 == 4294967295;
    let u2: u64 = widen_u8_to_u64(inputs.max_u8) * 72340172838076673;
    let held_u2: bool = also(held_u1, u2 == 18446744073709551615);
    let u3: u64 = widen_u16_to_u64(inputs.max_u16) * 281479271743489;
    let held_u3: bool = also(held_u2, u3 == 18446744073709551615);
    held_u3
}

machine signed_shifts(inputs: &Inputs) -> bool {
    let s1: i16 = widen_u8_to_i16(inputs.max_u8) << 7;
    let held_s1: bool = s1 == 32640;
    let s2: i32 = widen_u8_to_i32(inputs.max_u8) << 23;
    let held_s2: bool = also(held_s1, s2 == 2139095040);
    let s3: i64 = widen_u8_to_i64(inputs.max_u8) << 55;
    let held_s3: bool = also(held_s2, s3 == 9187343239835811840);
    held_s3
}

machine signed_wide(inputs: &Inputs) -> bool {
    let s1: i32 = widen_u16_to_i32(inputs.max_u16) << 15;
    let held_s1: bool = s1 == 2147450880;
    let s2: i64 = widen_u16_to_i64(inputs.max_u16) * 140737488355328;
    let held_s2: bool = also(held_s1, s2 == 9223231299366420480);
    let s3: i64 = widen_u32_to_i64(inputs.max_u32) << 31;
    let held_s3: bool = also(held_s2, s3 == 9223372034707292160);
    held_s3
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        max_u8: 255,
        max_u16: 65535,
        max_u32: 4294967295,
    };
    let unsigned_shifts_held: bool = unsigned_shifts(&inputs);
    let unsigned_products_held: bool = unsigned_products(&inputs);
    let signed_shifts_held: bool = signed_shifts(&inputs);
    let signed_wide_held: bool = signed_wide(&inputs);
    transition unsigned_shifts_held && unsigned_products_held && signed_shifts_held && signed_wide_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
