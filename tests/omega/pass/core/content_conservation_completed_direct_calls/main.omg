use omega::language::core::extent;
Adapter satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
    ensures result in Granted,
            Granted::content(old(&storage)) == Granted::content(&result)
    { storage }
}
machine direct(storage: Extent in Granted) -> Extent
ensures result in Granted,
        Granted::content(old(&storage)) == Granted::content(&result)
{ Adapter::transfer(storage) }
machine forwarded(storage: Extent in Granted) -> Extent
ensures result in Granted,
        Granted::content(old(&storage)) == Granted::content(&result)
{ direct(storage) }
machine main() {}
