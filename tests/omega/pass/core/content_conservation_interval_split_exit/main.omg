// A checked interval provider partitions [10,18) at 12. Both pieces leave
// custody exactly once; native and Terminal execution retain [10,12).
use omega::language::core::content;
use omega::language::core::drop;
use omega_language_std::console;

public data ByteUnit {}

public data Region [linear] {
    start: u64;
    end: u64;
}

// The type owner authorizes the only cleanup plan; linear custody still
// has to be transferred or dropped exactly once.
machine Region::drop(region: &mut Region) {}

public domain Region::Owned;

public machine Owned::content(region: &Region) -> IntervalSet<ByteUnit>
satisfies Content<Region, IntervalSet<ByteUnit>>::project
{
    IntervalSet { start: embed(region.start) as Nat, end: embed(region.end) as Nat }
}

public data SplitResult {
    left: Region in Owned;
    right: Region in Owned;
}

public boundary trait RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    requires whole.start <= head && head <= whole.end
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        );
}

// The custody exit: a selected boundary accepts a residual outright. It
// admits acceptance of custody, never the partition arithmetic.
public boundary trait RegionSink {
    machine accept(piece: Region in Owned);
}

// The checked provider must prove the interval partition from its body.
RegionSplitImplementation satisfies RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    requires whole.start <= head && head <= whole.end
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        )
    {
        let left: Region in Owned = Region { start: whole.start, end: head };
        let right: Region in Owned = Region { start: head, end: whole.end };
        drop(whole);
        // Result field order does not impose an interval ordering.
        SplitResult { left: right, right: left }
    }
}

RegionSinkImplementation satisfies RegionSink {
    machine accept(piece: Region in Owned)
    {
        drop(piece);
    }
}

data Main {
}

machine Main::partition_and_retain(main: &mut Main, whole: Region in Owned, head: u64) -> Region in Owned
requires whole.start <= head && head <= whole.end
reaches RegionSplit, RegionSink
{
    let split: SplitResult = RegionSplit::split(whole, head);
    let { left, right } = split;
    RegionSink::accept(left);
    right
}

machine Main::main(main: &mut Main) reaches Console, RegionSplit, RegionSink {
    let whole: Region in Owned = Region { start: 10, end: 18 };
    let retained: Region in Owned = Main::partition_and_retain(main, whole, 12);
    let middle_correct: bool = retained.start == 10 && retained.end == 12;
    RegionSink::accept(retained);
    let empty_source: Region in Owned = Region { start: 10, end: 18 };
    let empty: Region in Owned = Main::partition_and_retain(main, empty_source, 10);
    let empty_correct: bool = empty.start == 10 && empty.end == 10;
    RegionSink::accept(empty);
    let whole_source: Region in Owned = Region { start: 10, end: 18 };
    let whole_retained: Region in Owned = Main::partition_and_retain(main, whole_source, 18);
    let whole_correct: bool = whole_retained.start == 10 && whole_retained.end == 18;
    RegionSink::accept(whole_retained);
    transition (middle_correct && empty_correct && whole_correct) {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console, RegionSplit, RegionSink {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
