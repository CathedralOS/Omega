use omega_language_std::console;

machine narrow(input: u16) -> u8
crashes Trap input > 255u16 {
    transition input > 255u16 {
        true -> invalid(input)
        _ -> (input as u8)
    }
    state invalid(input: u16) -> u8 { crash Trap; }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: u8 = narrow(255u16);
    transition result == 255u8 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
