// An established owned input is partitioned through an invoked boundary
// requirement: `forward` hands `whole` to the authored `separate` theorem, and
// the caller retains both residual claims in `SplitResult`.

use omega::language::core::content;

data ByteUnit {}

data Region [linear] {
    remaining: u64;
}

domain Region::Owned;

machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

data SplitResult {
    left: Region in Owned;
    right: Region in Owned;
}

boundary trait RegionSplit {
    machine split(whole: Region in Owned) -> SplitResult
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        );
}

machine forward(partition: &RegionSplit, whole: Region in Owned) -> SplitResult
reaches RegionSplit
{
    partition.split(whole)
}

data Main {}

machine Main::main(&mut self) {}
