use omega::language::core::InterruptMaskGuard;
use omega::language::core::InterruptAcknowledgement;
use omega::language::core::InterruptMaskGuard::Active;
use omega::language::core::InterruptAcknowledgement::Pending;
use omega::language::core::InterruptMaskRestore;
use omega::language::core::InterruptAcknowledgementCompletion;

// Provider code supplies the opaque values. Checked handlers can only settle
// them through the consuming operations whose reaches remain explicit. Each
// consumer declares the plain carrier and states its domain as a `requires`
// premise, so the caller's qualified binding discharges that premise at the
// call occurrence and the argument is spelled without an `as`.
machine settle(
    guard: InterruptMaskGuard in Active,
    acknowledgement: InterruptAcknowledgement in Pending
)
reaches MachineControl + PortIo
{
    InterruptMaskRestore::restore(guard);
    InterruptAcknowledgementCompletion::complete(acknowledgement);
}
