// A sign-changing Trapping conversion traps on a negative source even when
// the unsigned target is wider: i8 -1 has no u64 value. Wrapping would give
// 18446744073709551615; Trapping must stop instead of ending normally.
use omega::language::core::numeric_conversion;

data Inputs { source: i8; }

machine convert(inputs: &Inputs) -> u64 {
    narrow_i8_to_u64_trapping(inputs.source)
}

machine main() {
    let inputs: Inputs = Inputs { source: -1 };
    let converted: u64 = convert(&inputs);
    transition converted == 18446744073709551615 {
        true -> wrapped()
        _ -> other()
    }

    machine wrapped() {}
    machine other() {}
}
