// A signed Trapping narrowing traps one past the target maximum: i64 32768
// does not fit i16. The constant argument still executes the conversion at
// runtime; the result is used, and ending normally (exit 0) means the trap
// was lost.
use omega::language::core::numeric_conversion;

machine main() {
    let converted: i16 = narrow_i64_to_i16_trapping(32768);
    transition converted < 0 {
        true -> negative()
        _ -> nonnegative()
    }

    machine negative() {}
    machine nonnegative() {}
}
