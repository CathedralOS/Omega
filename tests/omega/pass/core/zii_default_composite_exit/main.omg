// RUN CANARY (exit 70) + interpreter differential. ZII (zero-is-
// initialization) through COMPOSITE reads, never-written on every leg:
// (1) a ZII SUM dispatches as its FIRST case with ZII payload (tag 0 ->
// Msg::Ping { x: 0 }) -- the designed semantic, agreed by both engines;
// (2) a runtime-indexed element of a never-written array reads 0;
// (3) a nested struct-in-struct field reads 0. ZII is a Tier-1 Cathedral
// guarantee: these are the shapes a partial-zeroing or wrong-offset
// regression would corrupt first. exits: 71 = ZII sum took a non-first
// variant; 72 = ZII sum matched nothing; 73 = ZII payload nonzero;
// 74 = ZII array element nonzero; 75 = ZII nested field nonzero.
use omega_language_std::console;
data Msg { case Ping(x: i32); case Pong(y: i32, z: i32); }
data Inner { a: u32; b: u32; }
data Outer { first: Inner; second: Inner; }
data Main where 0 <= i, i <= 3 {
    never: Msg;
    arr: [u32; 4];
    nested: Outer;
    i: u64;
}
machine Main::main(main: &mut Main)
{
    main.i = 2;
    Main::build(main);
}
machine Main::build(main: &mut Main) reaches Console
{
    transition main.never {
        Msg::Ping { x } -> chk(main, x)
        Msg::Pong { y, z } -> wrong_variant(main)
        _ -> wrong_no_match(main)
    }
    state chk(main: &mut Main, x: i32)
    {
        transition x == 0 {
            true -> leg2(main)
            _ -> wrong_payload(main)
        }
    }
    state leg2(main: &mut Main)
    {
        let e: u32 = main.arr[main.i];
        transition e == 0 {
            true -> leg3(main)
            _ -> wrong_elem(main)
        }
    }
    state leg3(main: &mut Main)
    {
        let n: u32 = main.nested.second.b;
        transition n == 0 {
            true -> good(main)
            _ -> wrong_nested(main)
        }
    }
    state good(main: &mut Main)
    { Console::exit_process(70); }
    state wrong_variant(main: &mut Main)
    { Console::exit_process(71); }
    state wrong_no_match(main: &mut Main)
    { Console::exit_process(72); }
    state wrong_payload(main: &mut Main)
    { Console::exit_process(73); }
    state wrong_elem(main: &mut Main)
    { Console::exit_process(74); }
    state wrong_nested(main: &mut Main)
    { Console::exit_process(75); }
}
