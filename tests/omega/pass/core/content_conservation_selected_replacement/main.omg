// Exact content claims move through projected provider arguments and a
// projected retained result. The authored partition and custody contracts
// remain unchanged; native and Terminal execution must both exit 70.
use omega::language::core::content;
use omega::language::core::drop;
use omega_language_std::console;

public data ByteUnit {}

public data Region [linear] {
    remaining: u64;
}

machine Region::drop(region: &mut Region) {}

public domain Region::Owned;

public machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

public data SplitResult {
    left: Region in Owned;
    right: Region in Owned;
}

public boundary trait RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    requires head <= whole.remaining
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        );
}

public boundary trait RegionSink {
    machine accept(piece: Region in Owned);
}


data Main {
}

machine Main::split_once(main: &mut Main, whole: Region in Owned, head: u64) -> SplitResult
requires head <= whole.remaining
reaches RegionSplit
{
    RegionSplit::split(whole, head)
}

machine Main::split_twice(main: &mut Main, whole: Region in Owned, head: u64) -> SplitResult
requires head <= whole.remaining
reaches RegionSplit
{
    let pieces: SplitResult = Main::split_once(main, whole, head);
    pieces
}

machine Main::split_proved(main: &mut Main, whole: Region in Owned, head: u64) -> SplitResult
requires head <= whole.remaining
ensures
    Owned::content(old(&whole))
    == separate(Owned::content(&result.left), Owned::content(&result.right))
reaches RegionSplit
{
    let pieces: SplitResult = match head {
        0 -> RegionSplit::split(whole, head),
        _ -> RegionSplit::split(whole, head),
    };
    pieces
}

machine Main::partition_and_retain(main: &mut Main, whole: Region in Owned, head: u64) -> Region in Owned
requires head <= whole.remaining
reaches RegionSplit, RegionSink
{
    let split: SplitResult = Main::split_proved(main, whole, head);
    RegionSink::accept(split.left);
    split.right
}

machine Main::replacement(main: &mut Main, head: u64) -> bool
requires head <= 2
reaches RegionSplit, RegionSink
{
    let first: Region in Owned = Region { remaining: 8 };
    let mut pieces: SplitResult = match head {
        0 -> RegionSplit::split(first, 1),
        _ -> RegionSplit::split(first, 1),
    };
    RegionSink::accept(pieces.left);
    RegionSink::accept(pieces.right);
    let second: Region in Owned = Region { remaining: 13 };
    pieces = match head {
        0 -> RegionSplit::split(second, 2),
        _ -> RegionSplit::split(second, 2),
    };
    let correct: bool = pieces.left.remaining == 2 && pieces.right.remaining == 11;
    RegionSink::accept(pieces.left);
    RegionSink::accept(pieces.right);
    let third: Region in Owned = Region { remaining: 21 };
    pieces = match head {
        0 -> RegionSplit::split(third, 3),
        _ -> RegionSplit::split(third, 3),
    };
    let moved: SplitResult = pieces;
    let last: SplitResult = match head {
        0 -> moved,
        _ -> moved,
    };
    let third_correct: bool = last.left.remaining == 3 && last.right.remaining == 18;
    RegionSink::accept(last.left);
    RegionSink::accept(last.right);
    correct && third_correct
}

machine Main::main(main: &mut Main) reaches Console, RegionSplit, RegionSink {
    let first: bool = Main::replacement(main, 0);
    let second: bool = Main::replacement(main, 2);
    let correct: bool = first && second;
    transition correct {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}

RegionSplitImplementation satisfies RegionSplit {
    machine split(whole: Region in Owned, head: u64) -> SplitResult
    requires head <= whole.remaining
    ensures
        Owned::content(old(&whole))
        == separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        )
    {
        let left: Region in Owned = Region { remaining: head };
        let right: Region in Owned = Region { remaining: whole.remaining - head };
        drop(whole);
        SplitResult { left: left, right: right }
    }
}

RegionSinkImplementation satisfies RegionSink {
    machine accept(piece: Region in Owned)
    {
        drop(piece);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console, RegionSplit, RegionSink {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
