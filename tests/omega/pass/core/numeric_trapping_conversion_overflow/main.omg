// A trapping conversion is an explicit runtime event. An out-of-range source
// must trap inside the named conversion before the caller reaches exit 7.
use omega::language::core::numeric_conversion;
use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let converted: u8 = narrow_u16_to_u8_trapping(300);
    Console::exit_process(7);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
