// F7: IEEE binary32/64 are ordinary target-independent records in
// omega::core.  This canary makes both permanent constants, their nested
// special-value policy, and the rounding fact pass through the frontend.

use omega::language::core::float_format;

data Main {
}

machine Main::main(&mut self) {
    let binary32: FloatFormat = FloatFormat::BINARY32;
    let binary64: FloatFormat = FloatFormat::BINARY64;
    let ieee_specials: bool = binary32.specials.signed_zero
        && binary32.specials.subnormals
        && binary32.specials.infinity
        && binary32.specials.nan;

    verify(
        binary32.precision,
        binary64.precision,
        ieee_specials,
        binary32.rounds_to_nearest_ties_to_even
    );

    state verify(
        &mut self,
        binary32_precision: u32,
        binary64_precision: u32,
        specials: bool,
        rounding: bool
    ) {
        transition binary32_precision == 24 && binary64_precision == 53 && specials && rounding {
            true -> done()
            false -> done()
        }
    }

    state done(&mut self) {
    }
}
