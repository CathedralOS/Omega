// Fact: Two independent routed interval claims on one owned region remain independently conserved by one checked split.
// Expected exit: 0
// Numeric custody model only; no physical backing or access is granted.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { base: u64; length: u64; }
domain Region::First established by issue;
domain Region::Second established by issue;
machine First::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat }
}
machine Second::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat }
}
machine issue() -> Region in First & Second
ensures result.base == 10, result.length == 48
{ Region { base: 10, length: 48 } }
machine Region::drop(region: &mut Region) {}
data IssuedBox { item: Region in First & Second; }
boundary trait Factory { machine acquire(regions: [Region in First & Second; 1], index: u64) -> Region in First & Second reaches requires index == 0u64, regions[index] in Region::First, regions[index] in Region::Second; }

machine main() {}
