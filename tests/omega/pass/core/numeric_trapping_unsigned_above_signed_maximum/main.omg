// A same-width sign change traps for u64 values above i64::MAX: 2^63 is the
// first u64 with no i64 value. A signed reading of the source would see a
// negative number; the conversion must compare the unsigned value and stop
// instead of ending normally.
use omega::language::core::numeric_conversion;

data Inputs { source: u64; }

machine convert(inputs: &Inputs) -> i64 {
    narrow_u64_to_i64_trapping(inputs.source)
}

machine main() {
    let inputs: Inputs = Inputs { source: 9223372036854775808 };
    let converted: i64 = convert(&inputs);
    transition converted < 0 {
        true -> negative()
        _ -> nonnegative()
    }

    machine negative() {}
    machine nonnegative() {}
}
