// Native coverage uses an authored, target-specific program entry. The
// conservation boundaries are supplied by the checked providers below:
// `select_provider` names each one, and every hosted target binds the entry.
machine build(builder: &mut Build) {
    Build::application(builder, "content_selected_field_replacement");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, linux_arm64);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, linux_x86_64);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, macos_arm64);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, macos_x86_64);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, windows_x86_64);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, uefi_x86_64);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, cross_platform_cli);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, local_unchecked);
    Build::select_provider<RegionSplit, RegionSplitImplementation>(builder, alpha_bootstrap);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, linux_arm64);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, linux_x86_64);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, macos_arm64);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, macos_x86_64);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, windows_x86_64);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, uefi_x86_64);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, cross_platform_cli);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, local_unchecked);
    Build::select_provider<RegionSink, RegionSinkImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
