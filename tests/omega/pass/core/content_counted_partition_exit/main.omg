// Expected exit: 0. Quantity conservation shares the captured-integer judge
// with interval conservation, without granting address identity or backing.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { remaining: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<Nat>
satisfies Content<Region, CountedQuantity<Nat>>::project {
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, length: u64) -> Pieces
requires length <= whole.remaining
ensures Owned::content(old(&whole)) == separate(
    Owned::content(&result.left), Owned::content(&result.right))
{
    let left: Region in Owned = Region { remaining: length };
    let right: Region in Owned = Region { remaining: whole.remaining - length };
    drop(whole);
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let whole: Region in Owned = Region { remaining: 80 };
    let pieces: Pieces = split(whole, 20);
    let correct: bool = pieces.left.remaining == 20 && pieces.right.remaining == 60;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
