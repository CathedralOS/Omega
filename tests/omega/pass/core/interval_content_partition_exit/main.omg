// Exact interval partition prerequisite for backed kernel allocation.
// Expected exit: 0
// These locally owned coordinates exercise conservation, not physical backing.
// Region::Owned is not Extent::Granted and its drop hook releases no memory.
use omega::language::core::content;
use omega::language::core::drop;

data Region [linear] { start: u64; end: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.start) as Nat, end: embed(region.end) as Nat }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, cut: u64) -> Pieces
requires whole.start <= cut && cut <= whole.end
ensures Owned::content(old(&whole)) == separate(
    Owned::content(&result.left), Owned::content(&result.right))
{
    let left: Region in Owned = Region { start: whole.start, end: cut };
    let right: Region in Owned = Region { start: cut, end: whole.end };
    drop(whole);
    Pieces { left: left, right: right }
}
data ThreePieces { first: Region in Owned; middle: Region in Owned; last: Region in Owned; }
machine split_three(whole: Region in Owned, first_cut: u64, second_cut: u64) -> ThreePieces
requires whole.start <= first_cut && first_cut <= second_cut && second_cut <= whole.end
ensures Owned::content(old(&whole)) == separate(
    Owned::content(&result.last), separate(Owned::content(&result.first), Owned::content(&result.middle)))
{
    let first: Region in Owned = Region { start: whole.start, end: first_cut };
    let middle: Region in Owned = Region { start: first_cut, end: second_cut };
    let last: Region in Owned = Region { start: second_cut, end: whole.end };
    drop(whole);
    ThreePieces { first: first, middle: middle, last: last }
}
machine verify_cut(cut: u64) -> bool
requires 10 <= cut && cut <= 90
{
    let whole: Region in Owned = Region { start: 10, end: 90 };
    let pieces: Pieces = split(whole, cut);
    let correct: bool = pieces.left.start == 10 && pieces.left.end == cut
        && pieces.right.start == cut && pieces.right.end == 90;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    correct
}
machine main() crashes Trap {
    let lower_empty: bool = verify_cut(10);
    let interior: bool = verify_cut(30);
    let upper_empty: bool = verify_cut(90);
    let whole: Region in Owned = Region { start: 10, end: 90 };
    let pieces: ThreePieces = split_three(whole, 30, 60);
    let correct: bool = lower_empty && interior && upper_empty
        && pieces.first.start == 10 && pieces.first.end == 30
        && pieces.middle.start == 30 && pieces.middle.end == 60
        && pieces.last.start == 60 && pieces.last.end == 90;
    let { first, middle, last } = pieces;
    drop(first);
    drop(middle);
    drop(last);
    let empty: Region in Owned = Region { start: 50, end: 50 };
    let empty_pieces: Pieces = split(empty, 50);
    let empty_correct: bool = empty_pieces.left.start == 50 && empty_pieces.left.end == 50
        && empty_pieces.right.start == 50 && empty_pieces.right.end == 50;
    let { left, right } = empty_pieces;
    drop(left);
    drop(right);
    transition correct && empty_correct {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
