// Signed-to-unsigned conversion through the public numeric_conversion
// surface for i8 and i16 sources into every unsigned target, under Exact,
// Wrapping, Saturating and Trapping. Every pair is range-narrowing because
// negative values have no unsigned value, even when the target is wider.
// Wrapping reduces the two's-complement value modulo the target width
// (i8 -1 -> u64 18446744073709551615); Saturating maps every negative
// source to 0 and caps at the target maximum. `literal_checks` passes
// constants, `runtime_checks` reads the boundaries through a borrowed
// record, and `named_conversion_checks` checks conversions on typed literals
// and on loaded operands.
//
// Exit 0 when every result holds; a wrong result executes `crash Trap;`.
// `main` takes no arguments and reaches no service, so the Terminal
// interpreter runs the same program beside the native product.
use omega::language::core::numeric_conversion;

data Inputs {
    min_i8: i8;
    negative_one_i8: i8;
    max_i8: i8;
    min_i16: i16;
    negative_one_i16: i16;
    max_i16: i16;
}

// Folds one check into the running verdict. Each fold is a call rather
// than an inline `&&`, so the checking machines stay straight-line code.
machine also(held: bool, check: bool) -> bool {
    held && check
}

machine literal_checks() -> bool {
    let l1: u8 = narrow_i8_to_u8_exact(127);
    let held_l1: bool = l1 == 127;
    let l2: u8 = narrow_i8_to_u8_exact(0);
    let held_l2: bool = also(held_l1, l2 == 0);
    let l3: u8 = narrow_i8_to_u8_wrapping(-1);
    let held_l3: bool = also(held_l2, l3 == 255);
    let l4: u8 = narrow_i8_to_u8_wrapping(-128);
    let held_l4: bool = also(held_l3, l4 == 128);
    let l5: u8 = narrow_i8_to_u8_saturating(-1);
    let held_l5: bool = also(held_l4, l5 == 0);
    let l6: u8 = narrow_i8_to_u8_saturating(127);
    let held_l6: bool = also(held_l5, l6 == 127);
    let l7: u8 = narrow_i8_to_u8_trapping(0);
    let held_l7: bool = also(held_l6, l7 == 0);
    let l8: u16 = narrow_i8_to_u16_exact(127);
    let held_l8: bool = also(held_l7, l8 == 127);
    let l9: u16 = narrow_i8_to_u16_wrapping(-128);
    let held_l9: bool = also(held_l8, l9 == 65408);
    let l10: u16 = narrow_i8_to_u16_saturating(-128);
    let held_l10: bool = also(held_l9, l10 == 0);
    let l11: u16 = narrow_i8_to_u16_trapping(127);
    let held_l11: bool = also(held_l10, l11 == 127);
    let l12: u32 = narrow_i8_to_u32_exact(5);
    let held_l12: bool = also(held_l11, l12 == 5);
    let l13: u32 = narrow_i8_to_u32_wrapping(-2);
    let held_l13: bool = also(held_l12, l13 == 4294967294);
    let l14: u32 = narrow_i8_to_u32_saturating(-1);
    let held_l14: bool = also(held_l13, l14 == 0);
    let l15: u32 = narrow_i8_to_u32_trapping(127);
    let held_l15: bool = also(held_l14, l15 == 127);
    let l16: u64 = narrow_i8_to_u64_exact(127);
    let held_l16: bool = also(held_l15, l16 == 127);
    let l17: u64 = narrow_i8_to_u64_wrapping(-1);
    let held_l17: bool = also(held_l16, l17 == 18446744073709551615);
    let l18: u64 = narrow_i8_to_u64_wrapping(-128);
    let held_l18: bool = also(held_l17, l18 == 18446744073709551488);
    let l19: u64 = narrow_i8_to_u64_saturating(-128);
    let held_l19: bool = also(held_l18, l19 == 0);
    let l20: u64 = narrow_i8_to_u64_trapping(0);
    let held_l20: bool = also(held_l19, l20 == 0);
    let l21: u8 = narrow_i16_to_u8_exact(255);
    let held_l21: bool = also(held_l20, l21 == 255);
    let l22: u8 = narrow_i16_to_u8_wrapping(256);
    let held_l22: bool = also(held_l21, l22 == 0);
    let l23: u8 = narrow_i16_to_u8_wrapping(-32768);
    let held_l23: bool = also(held_l22, l23 == 0);
    let l24: u8 = narrow_i16_to_u8_saturating(256);
    let held_l24: bool = also(held_l23, l24 == 255);
    let l25: u8 = narrow_i16_to_u8_saturating(-1);
    let held_l25: bool = also(held_l24, l25 == 0);
    let l26: u8 = narrow_i16_to_u8_trapping(255);
    let held_l26: bool = also(held_l25, l26 == 255);
    let l27: u16 = narrow_i16_to_u16_exact(32767);
    let held_l27: bool = also(held_l26, l27 == 32767);
    let l28: u16 = narrow_i16_to_u16_wrapping(-32768);
    let held_l28: bool = also(held_l27, l28 == 32768);
    let l29: u16 = narrow_i16_to_u16_saturating(-1);
    let held_l29: bool = also(held_l28, l29 == 0);
    let l30: u16 = narrow_i16_to_u16_trapping(32767);
    let held_l30: bool = also(held_l29, l30 == 32767);
    let l31: u32 = narrow_i16_to_u32_exact(32767);
    let held_l31: bool = also(held_l30, l31 == 32767);
    let l32: u32 = narrow_i16_to_u32_wrapping(-1);
    let held_l32: bool = also(held_l31, l32 == 4294967295);
    let l33: u32 = narrow_i16_to_u32_saturating(-32768);
    let held_l33: bool = also(held_l32, l33 == 0);
    let l34: u32 = narrow_i16_to_u32_trapping(0);
    let held_l34: bool = also(held_l33, l34 == 0);
    let l35: u64 = narrow_i16_to_u64_exact(32767);
    let held_l35: bool = also(held_l34, l35 == 32767);
    let l36: u64 = narrow_i16_to_u64_wrapping(-1);
    let held_l36: bool = also(held_l35, l36 == 18446744073709551615);
    let l37: u64 = narrow_i16_to_u64_saturating(-1);
    let held_l37: bool = also(held_l36, l37 == 0);
    let l38: u64 = narrow_i16_to_u64_trapping(32767);
    let held_l38: bool = also(held_l37, l38 == 32767);
    held_l38
}

machine runtime_checks(inputs: &Inputs) -> bool {
    let r1: u8 = narrow_i8_to_u8_wrapping(inputs.min_i8);
    let held_r1: bool = r1 == 128;
    let r2: u8 = narrow_i8_to_u8_saturating(inputs.min_i8);
    let held_r2: bool = also(held_r1, r2 == 0);
    let r3: u8 = narrow_i8_to_u8_saturating(inputs.max_i8);
    let held_r3: bool = also(held_r2, r3 == 127);
    let r4: u16 = narrow_i8_to_u16_wrapping(inputs.negative_one_i8);
    let held_r4: bool = also(held_r3, r4 == 65535);
    let r5: u32 = narrow_i8_to_u32_wrapping(inputs.negative_one_i8);
    let held_r5: bool = also(held_r4, r5 == 4294967295);
    let r6: u64 = narrow_i8_to_u64_wrapping(inputs.min_i8);
    let held_r6: bool = also(held_r5, r6 == 18446744073709551488);
    let r7: u64 = narrow_i8_to_u64_saturating(inputs.negative_one_i8);
    let held_r7: bool = also(held_r6, r7 == 0);
    let r8: u8 = narrow_i16_to_u8_saturating(inputs.max_i16);
    let held_r8: bool = also(held_r7, r8 == 255);
    let r9: u8 = narrow_i16_to_u8_wrapping(inputs.negative_one_i16);
    let held_r9: bool = also(held_r8, r9 == 255);
    let r10: u16 = narrow_i16_to_u16_wrapping(inputs.negative_one_i16);
    let held_r10: bool = also(held_r9, r10 == 65535);
    let r11: u16 = narrow_i16_to_u16_saturating(inputs.min_i16);
    let held_r11: bool = also(held_r10, r11 == 0);
    let r12: u64 = narrow_i16_to_u64_wrapping(inputs.min_i16);
    let held_r12: bool = also(held_r11, r12 == 18446744073709518848);
    let r13: u32 = narrow_i16_to_u32_trapping(inputs.max_i16);
    let held_r13: bool = also(held_r12, r13 == 32767);
    held_r13
}

machine named_conversion_checks(inputs: &Inputs) -> bool {
    let d1: u8 = narrow_i16_to_u8_trapping(200i16);
    let held_d1: bool = d1 == 200;
    let d2: u64 = narrow_i16_to_u64_wrapping(inputs.negative_one_i16);
    let held_d2: bool = also(held_d1, d2 == 18446744073709551615);
    let d3: u16 = narrow_i16_to_u16_trapping(inputs.max_i16);
    let held_d3: bool = also(held_d2, d3 == 32767);
    held_d3
}

machine main() crashes Trap {
    let inputs: Inputs = Inputs {
        min_i8: -128,
        negative_one_i8: -1,
        max_i8: 127,
        min_i16: -32768,
        negative_one_i16: -1,
        max_i16: 32767,
    };
    let literal_checks_held: bool = literal_checks();
    let runtime_checks_held: bool = runtime_checks(&inputs);
    let named_conversion_checks_held: bool = named_conversion_checks(&inputs);
    transition literal_checks_held && runtime_checks_held && named_conversion_checks_held {
        true -> passed()
        _ -> failed()
    }

    machine passed() {}
    machine failed() { crash Trap; }
}
