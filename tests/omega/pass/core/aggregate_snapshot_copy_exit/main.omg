// Expected exit: 0. An owned copy preserves the old value while the source changes.
data Reading [copy] { value: u64; }
data Readings { captured: Reading; current: Reading; }
machine mutate(mut whole: Reading) -> Readings
ensures result.current.value == 0
{
    let captured: Reading = whole;
    whole.value = 0;
    Readings { captured: captured, current: whole }
}
machine main() crashes Trap {
    let result: Readings = mutate(Reading { value: 42 });
    transition result.captured.value == 42 && result.current.value == 0 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
