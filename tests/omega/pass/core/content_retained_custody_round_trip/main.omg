// ENT2c: foreign use that survives return is ordinary conserved custody, not a
// long borrow. `submit` consumes one owned Buffer into a linear PendingWrite;
// only the correlated terminal operation can redeem that claim as Buffer
// custody again. Both directions retain the same core Content algebra.

use omega::language::core::content;

data ByteUnit {}

pub data Buffer [linear] {}

pub domain Buffer::Owned
established by Writer::complete;

machine Owned::content(buffer: &Buffer) -> CountedQuantity<ByteUnit>
satisfies Content<Buffer, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}

pub data PendingWrite [linear] {}

pub domain PendingWrite::Retained
established by Writer::submit;

machine Retained::content(pending: &PendingWrite) -> CountedQuantity<ByteUnit>
satisfies Content<PendingWrite, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}

pub boundary trait Writer {
    machine submit(buffer: Buffer in Buffer::Owned) -> PendingWrite
    ensures
        result in PendingWrite::Retained;

    machine complete(pending: PendingWrite in PendingWrite::Retained) -> Buffer
    ensures
        result in Buffer::Owned;
}

machine round_trip(buffer: Buffer in Buffer::Owned) -> Buffer
reaches Writer
ensures
    result in Buffer::Owned
{
    let pending: PendingWrite in PendingWrite::Retained = Writer::submit(buffer);
    Writer::complete(pending)
}

machine main() {}
