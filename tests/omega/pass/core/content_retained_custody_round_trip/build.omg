machine build(builder: &mut Build) {
    Build::application(builder, "content_retained_custody_round_trip_supply_probe");
    Build::accept_boundary<InitialSupply>(builder);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder);
    Build::accept_boundary<Writer>(builder);
    Build::select_provider<Writer, WriterProvider>(builder);
    Build::accept_boundary<NativeBytes>(builder);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
