// Checking probe: lifecycle result contracts retain the original schema's
// nested domain qualification. No executed initialization is claimed.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

data Word { value: u64; }
domain Word::Tagged;
data Payload { word: Word in Tagged; }
data PayloadPlacement {}

machine PayloadPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        },
        access: AccessPlan::inaccessible(&schema),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine initialize(storage: Extent in Granted & Vacant, value: Payload)
    -> PlacementOutcome<
        Extent in Granted & Resident<PayloadPlacement, Payload>,
        PlacementReturn<Extent in Granted & Vacant, Payload>,
        PlacementInitializationFailure
    >
reaches ResourceProfileSupply
{
    NativePlacement<PayloadPlacement, Payload, TestMemory>::initialize(storage, value)
}

machine extract(storage: Extent in Granted & Resident<PayloadPlacement, Payload>)
    -> PlacementExtraction<Extent in Granted & Vacant, Payload>
reaches ResourceProfileSupply
{
    NativePlacement<PayloadPlacement, Payload, TestMemory>::move_out(storage)
}
