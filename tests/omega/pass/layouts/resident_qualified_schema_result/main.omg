// Checking probe: lifecycle result contracts retain the original schema's
// nested domain qualification. No executed initialization is claimed.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

data Word { value: u64; }
domain Word::Tagged;
data Payload { word: Word in Tagged; }
data PayloadPlacement {}

machine PayloadPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::inaccessible(layout),
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine initialize(storage: Extent in Granted & Vacant, value: Payload)
    -> AccessOutcome<
        Extent in Granted & Resident<PayloadPlacement, Payload>,
        AccessReturn<Extent in Granted & Vacant, Payload>,
        AccessInitializationFailure
    >
reaches ResourceProfileSupply
{
    NativeAccess<PayloadPlacement, Payload, TestMemory>::initialize(storage, value)
}

machine extract(storage: Extent in Granted & Resident<PayloadPlacement, Payload>)
    -> AccessExtraction<Extent in Granted & Vacant, Payload>
reaches ResourceProfileSupply
{
    NativeAccess<PayloadPlacement, Payload, TestMemory>::move_out(storage)
}
