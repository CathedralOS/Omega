// COMPILE CANARY. Private-layout receipts describe executed build-time
// operations, not syntactic call sites in untaken policy branches.
use omega::language::core::layout;

boundary trait Callback {
    machine call(value: u64) -> u64 reaches;
}


CallbackSlot satisfies PrivateCallbackSlot<ForeignRecord, Spread, Callback::call> { }

Spread satisfies FixedLayout<ForeignRecord> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    transition {
        false -> with_private(schema)
        _ -> plain(schema)
    }

    machine with_private(schema: Schema) -> LayoutPlan {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry {
            key: schema.fields[0].key,
            representation: FieldPlan::At { offset: 0 },
        };
        let plan: LayoutPlan = LayoutPlan {
            entries: entries,
            entry_count: 1,
            size_fixed: 16,
            size_is_dynamic: false,
            align: 8,
        };
        LayoutPlan::place_private<CallbackSlot>(plan, 8)
    }

    machine plain(schema: Schema) -> LayoutPlan {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry {
            key: schema.fields[0].key,
            representation: FieldPlan::At { offset: 0 },
        };
        LayoutPlan {
            entries: entries,
            entry_count: 1,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 8,
        }
    }
}
}

data ForeignRecord { payload: u64; }
data Main { value: LayoutStorage<ForeignRecord, Spread>; }
machine Main::main() { }
