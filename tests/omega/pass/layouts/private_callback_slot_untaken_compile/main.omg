// COMPILE CANARY. Private-layout receipts describe executed build-time
// operations, not syntactic call sites in untaken policy branches.
use omega::language::core::layout;

boundary trait Callback {
    machine call(value: u64) -> u64;
}

data Spread {
    entries: [FieldEntry; 64];
}

CallbackSlot: Spread satisfies PrivateCallbackSlot<Callback::call>;

machine Spread::plan(&mut self, schema: Schema) -> Plan {
    transition {
        false -> with_private(schema)
        _ -> plain(schema)
    }

    state with_private(&mut self, schema: Schema) -> Plan {
        self.entries[0] = FieldEntry {
            key: schema.fields[0].key,
            placement: FieldPlan::At { offset: 0 },
        };
        let plan: Plan = Plan {
            entries: self.entries,
            entry_count: 1,
            size_fixed: 16,
            size_is_dynamic: false,
            align: 8,
        };
        Plan::place_private<CallbackSlot>(plan, 8)
    }

    state plain(&mut self, schema: Schema) -> Plan {
        self.entries[0] = FieldEntry {
            key: schema.fields[0].key,
            placement: FieldPlan::At { offset: 0 },
        };
        Plan {
            entries: self.entries,
            entry_count: 1,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 8,
        }
    }
}

data ForeignRecord { payload: u64; }
data Main { value: Spread<ForeignRecord>; }
machine Main::main(&mut self) { }
