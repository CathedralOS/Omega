// A fixed array of fixed records remains one aggregate `Repeated` schema
// field. Its whole extent follows the policy's `At` placement, while each
// element uses compiler-derived record padding and field offsets.
use omega_language_std::console;
use omega::language::core::layout;

data SpreadRecordArray { }

machine SpreadRecordArray::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 24 },
    };
    Plan {
        entries: entries,
        entry_count: 2,
        size_fixed: 32,
        size_is_dynamic: false,
        align: 8,
    }
}

data Pair {
    low: u16;
    high: u32;
}

data RecordArray {
    pairs: [Pair; 2];
    marker: u8;
}

data RecordArrayView { value: SpreadRecordArray<RecordArray>; }

data Main {
    bytes: [u8; 32];
}

machine Main::main(main: &mut Main) reaches Console {
    let view: &mut RecordArrayView = &mut main.bytes[0] as &mut RecordArrayView;
    view.value.pairs[0].low = 0x0201;
    view.value.pairs[0].high = 0x06050403;
    view.value.pairs[1].low = 0x0807;
    view.value.pairs[1].high = 0x0c0b0a09;
    view.value.marker = 13;
    // `view` suspends the bytes it covers until its last use, so the owner's
    // bytes are read after it.
    transition view.value.pairs[0].low == 0x0201
        && view.value.pairs[0].high == 0x06050403
        && view.value.pairs[1].low == 0x0807
        && view.value.pairs[1].high == 0x0c0b0a09
        && view.value.marker == 13
        && main.bytes[8] == 1 && main.bytes[9] == 2
        && main.bytes[12] == 3 && main.bytes[13] == 4
        && main.bytes[14] == 5 && main.bytes[15] == 6
        && main.bytes[16] == 7 && main.bytes[17] == 8
        && main.bytes[20] == 9 && main.bytes[21] == 10
        && main.bytes[22] == 11 && main.bytes[23] == 12
        && main.bytes[24] == 13 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
