// An odd-sized array followed by a same-alignment member needs no
// padding: `Blob` holds `[u8; 7]` then `u8` — the folded size is 8 at
// align 1, members packed contiguously.
data Blob {
    bytes: [u8; 7];
    tag: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Blob>();
}
