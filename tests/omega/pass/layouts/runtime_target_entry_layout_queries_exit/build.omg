machine build(builder: &mut Build) {
    Build::application(builder, "runtime_target_entry_layout_queries_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, eight);
    Build::bind(builder, linux_arm64::ProgramEntry, eight);
    Build::bind(builder, linux_x86_64::ProgramEntry, four);
    Build::bind(builder, windows_x86_64::ProgramEntry, four);
    Build::bind(builder, macos_x86_64::ProgramEntry, four);
}
