// An array member of a sum type repeats the sum's whole geometry:
// `Bag` holds `[Choice; 2]` — two discriminant-plus-widest-payload
// slots — then a trailing byte tag.
data Pair {
    a: u64;
    b: u64;
}

data Choice {
    case Empty;
    case Single(v: u64);
    case Both(pair: Pair);
}

data Bag {
    choices: [Choice; 2];
    tag: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Bag>();
}
