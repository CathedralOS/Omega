// COMPILE CANARY. `Placed<Policy, Schema>` in a parameter position derives a
// compiler-owned view record whose fields are generated `PlacedField<P,S,f>`
// accessor carriers. Each field's admitted access clones exact
// `PlacedField::{read,take,write}` boundary targets onto that carrier, and a
// source `view.field.op()` call must resolve through the published boundary
// roster -- the generated accessor machines are real checked boundary
// declarations, not silently dropped opaque attachments.
//
// `Main::main` declares the same `&mut Placed` input a hosted `ProgramEntry`
// binding lends: the parameter is a custody input, not an arrival parameter,
// so it checks here and binds a root only once native admission can carry
// its establishment. The `inspect(view)` call exercises call-bound custody
// at the source surface the same roster row authorizes.
use omega::language::core::layout;
use omega_language_std::console;
use omega::language::core::binding;

pub data Registers {
    status: u32;
    transmit: u8;
}

pub data RegPlacement {}

machine RegPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 4 },
    };
    let access: AccessPlan = AccessPlan::inaccessible(&schema);
    transition { _ -> place_status(schema, access, entries) }

    state place_status(
        schema: Schema,
        access: AccessPlan,
        entries: [FieldEntry; 64]
    ) -> PlacementPlan {
        transition { _ -> place_transmit(
            schema,
            AccessPlan::with(
                access,
                schema.fields[0].key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            ),
            entries
        ) }
    }

    state place_transmit(
        schema: Schema,
        access: AccessPlan,
        entries: [FieldEntry; 64]
    ) -> PlacementPlan {
        transition { _ -> finish(
            AccessPlan::with(
                access,
                schema.fields[1].key,
                FieldAccess::External {
                    read: ExternalRead::None,
                    write: true,
                    exposure: Exposure::Exported,
                },
            ),
            entries
        ) }
    }

    state finish(
        access: AccessPlan,
        entries: [FieldEntry; 64]
    ) -> PlacementPlan {
        let mut services: [u64; 32];
        services[0] = 7;
        PlacementPlan {
            layout: Plan {
                entries: entries,
                entry_count: 2,
                size_fixed: 8,
                size_is_dynamic: false,
                align: 4,
            },
            access: access,
            reach: BoundaryReach {
                services: services,
                service_count: 0,
            },
        }
    }
}

machine inspect(view: &mut Placed<RegPlacement, Registers>) -> u32 {
    view.transmit.write(&mut view.transmit, 9);
    view.status.read(&view.status)
}

machine inspect_bound(view: &mut Placed<RegPlacement, Registers>) -> u32 {
    let status: u32 = view.status.read(&view.status);
    status
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main, view: &mut Placed<RegPlacement, Registers>) reaches Console {
    let status: u32 = inspect(view);
    let code: i32 = (((status & 127) as u8 in Wrapping) as i32) + 9;
    main.console.exit_process(code);
}
