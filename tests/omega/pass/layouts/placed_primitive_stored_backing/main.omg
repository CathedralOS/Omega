// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use omega::language::core::layout;

public data Value { number: u64; }
public data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let mut services: [u64; 32];
    AccessPlan::with_reach(
        access,
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine retain<'storage>(value: &'storage mut Value) -> &'storage mut Value { value }

data Holder<'storage> { value: &'storage mut Value; }

machine through_holder(holder: &mut Holder) {
    let view: &mut Access<StablePlacement, Value> =
        Access::view_mut<StablePlacement, Value>(&mut holder.value);
    write(&mut view.number, 29u64);
}

machine update(value: &mut Value, choose: bool) {
    let mut holder: Holder = Holder { value: retain(value) };
    through_holder(&mut holder);
}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    update(&mut value, true);
    update(&mut value, false);
    transition value.number == 29 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
