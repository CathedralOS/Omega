use omega::language::core::layout;
// A plan-laid owned value whose three logical fields share one byte. The
// `code` field is itself split across two fragments. Ordinary field writes
// must use masked RMW so later writes preserve siblings; reads must reconstruct
// the logical scalar from every fragment. Exit 70 pins both behaviors.
use omega_language_std::console;


CompactBits satisfies FixedLayout<PackedFlags> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 0,
            source_lsb: 0,
            width: 1,
        },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 1,
            source_lsb: 0,
            width: 3,
        },
    };
    entries[2] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 4,
            source_lsb: 0,
            width: 2,
        },
    };
    entries[3] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 6,
            source_lsb: 2,
            width: 2,
        },
    };
    Plan {
        entries: entries,
        entry_count: 4,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}

data PackedFlags where mode <= 7, code <= 15 {
    present: bool;
    mode: u8;
    code: u8;
}

data Main {
    packed: LayoutStorage<PackedFlags, CompactBits>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.packed.present = true;
    main.packed.mode = 5;
    main.packed.code = 10;

    transition main.packed.present == true {
        true -> check_mode(main)
        false -> bad(main)
    }

    machine check_mode(main: &mut Main) {
        transition main.packed.mode == 5 {
            true -> check_code(main)
            false -> bad(main)
        }
    }

    machine check_code(main: &mut Main) {
        transition main.packed.code == 10 {
            true -> good(main)
            false -> bad(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
