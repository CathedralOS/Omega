// Expected exit: 0. Placed reads and writes keep their permissions and array
// bounds when the array length is computed and size_of waits for target layout.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::ExternalRead;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::Access;
use omega::language::core::Access::view_mut;
use omega::language::core::read;
use omega::language::core::write;
public machine row_size() -> u64 { 2 }
public data Values { words: [[u64; row_size()]; 2]; }
public data ExternalPlacement {}
machine ExternalPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 32, size_is_dynamic: false, align: 8 };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: true, exposure: Exposure::Exported }),
        BoundaryReach { services: services, service_count: 0 }
    )
}
machine replace(view: &mut Access<ExternalPlacement, Values>, row: u64, column: u64, value: u64)
requires row < 2 && column < 2
{
    write(&mut view.words[row][column], value);
}
machine exchange(view: &mut Access<ExternalPlacement, Values>) -> bool {
    let first: u64 = read(&view.words[0][1]);
    let second: u64 = read(&view.words[1][0]);
    replace(view, 0, 1, 29);
    replace(view, 1, 0, 73);
    let updated_first: u64 = read(&view.words[0][1]);
    let updated_second: u64 = read(&view.words[1][0]);
    first == 17 && second == 41 && updated_first == 29 && updated_second == 73
}
const VALUE_BYTES: u64 = size_of<Values>();
machine main() crashes Trap {
    let mut value: Values = Values { words: [[5, 17], [41, 11]] };
    let observed: bool = exchange(Access::view_mut<ExternalPlacement, Values>(&mut value));
    transition VALUE_BYTES == 32 && observed && value.words[0][0] == 5 && value.words[0][1] == 29 &&
               value.words[1][0] == 73 && value.words[1][1] == 11 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
