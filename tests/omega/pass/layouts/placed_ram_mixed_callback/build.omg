use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::package(builder, "placed_ram_mixed_callback_source");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });

 Build::bind<SortRegistrar::sort>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "qsort", version: "GLIBC_2.2.5" } });
}
