// Layout queries fold a zero-length array member: `Zeros` carries
// `[u8; 0]` — zero extent at byte alignment — beside an ordinary scalar,
// and its folded size is just the scalar's.
data Zeros {
    tag: u64;
    bytes: [u8; 0];
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Zeros>() - size_of<u64>();
}
