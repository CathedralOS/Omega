// Nested fixed primitive arrays remain one aggregate layout field. A mutable
// byte-region view must apply both array strides below the field's validated
// whole-extent `At` placement.
use omega_language_std::console;
use omega::language::core::layout;

data SpreadArray { }

machine SpreadArray::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 24 },
    };
    Plan {
        entries: entries,
        entry_count: 2,
        size_fixed: 32,
        size_is_dynamic: false,
        align: 8,
    }
}

data MatrixRecord {
    values: [[u16; 2]; 2];
    marker: u8;
}

data MatrixView { value: SpreadArray<MatrixRecord>; }

data Main {
    bytes: [u8; 32];
}

machine Main::main(main: &mut Main) reaches Console {
    let view: &mut MatrixView = &mut main.bytes[0] as &mut MatrixView;
    view.value.values[0][0] = 0x0201;
    view.value.values[0][1] = 0x0403;
    view.value.values[1][0] = 0x0605;
    view.value.values[1][1] = 0x0807;
    view.value.marker = 9;
    // `view` suspends the bytes it covers until its last use, so the owner's
    // bytes are read after it.
    transition view.value.values[0][0] == 0x0201
        && view.value.values[0][1] == 0x0403
        && view.value.values[1][0] == 0x0605
        && view.value.values[1][1] == 0x0807
        && main.bytes[8] == 1 && main.bytes[9] == 2
        && main.bytes[10] == 3 && main.bytes[11] == 4
        && main.bytes[12] == 5 && main.bytes[13] == 6
        && main.bytes[14] == 7 && main.bytes[15] == 8
        && main.bytes[24] == 9 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
