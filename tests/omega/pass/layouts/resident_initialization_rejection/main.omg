// Embedding probe: an admitted Granted/Vacant entry supplies real backing.
// The source returns the ordinary outcome; this is not a hosted boot witness.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

data Word { value: u64; }
data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 },
        access: AccessPlan::inaccessible(&schema),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

machine attempt(storage: Extent in Granted & Vacant, expected_reason: u64)
    -> PlacementReturn<Extent in Granted & Vacant, Word>
reaches ResourceProfileSupply crashes Trap
{
    transition NativePlacement<WordPlacement, Word, TestMemory>::initialize(storage, Word { value: 17 }) {
        PlacementOutcome::Ready { view } -> unexpected(view)
        PlacementOutcome::Rejected { returned, reason } -> check_reason(returned, reason, expected_reason)
    }
    machine unexpected(storage: Extent in Granted & Resident<WordPlacement, Word>) -> PlacementReturn<Extent in Granted & Vacant, Word> {
        crash Trap;
    }
    machine check_reason(returned: PlacementReturn<Extent in Granted & Vacant, Word>, reason: PlacementInitializationFailure, expected: u64) -> PlacementReturn<Extent in Granted & Vacant, Word> {
        transition reason {
            PlacementInitializationFailure::RangeTooSmall { required, available } -> finish(returned, expected == 1 && required == 8 && available == 4)
            PlacementInitializationFailure::Misaligned { modulus, residue } -> finish(returned, expected == 2 && modulus == 8 && residue == 0)
            PlacementInitializationFailure::IncompatibleSupply -> finish(returned, expected == 3)
        }
    }
    machine finish(returned: PlacementReturn<Extent in Granted & Vacant, Word>, reason_ok: bool) -> PlacementReturn<Extent in Granted & Vacant, Word> {
        transition reason_ok && returned.custody.value == 17 {
            true -> done(returned)
            false -> bad(returned)
        }
    }
    machine done(returned: PlacementReturn<Extent in Granted & Vacant, Word>) -> PlacementReturn<Extent in Granted & Vacant, Word> { returned }
    machine bad(returned: PlacementReturn<Extent in Granted & Vacant, Word>) -> PlacementReturn<Extent in Granted & Vacant, Word> { crash Trap; }
}
