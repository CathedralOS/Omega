// Embedding probe: an admitted Granted/Vacant entry supplies real backing.
// The source returns the ordinary outcome; this is not a hosted boot witness.
use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Resident;
use omega::language::core::Extent::Granted;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::RelativeRange;
use omega::language::core::StableCapability;
use omega::language::core::ExternalCapability;
use omega::language::core::AtomicCapability;
use omega::language::core::PeerWritability;
use omega::language::core::ResourceRegion;
use omega::language::core::ResourceProfile;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::AccessOutcome;
use omega::language::core::AccessReturn;
use omega::language::core::AccessInitializationFailure;

data TestMemory {}

data Word { value: u64; }
data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::inaccessible(layout),
        BoundaryReach { services: services, service_count: 0 }
    )
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

machine attempt(storage: Extent in Granted & Vacant, expected_reason: u64)
    -> AccessReturn<Extent in Granted & Vacant, Word>
reaches ResourceProfileSupply crashes Trap
{
    transition NativeAccess<WordPlacement, Word, TestMemory>::initialize(storage, Word { value: 17 }) {
        AccessOutcome::Ready { view } -> unexpected(view)
        AccessOutcome::Rejected { returned, reason } -> check_reason(returned, reason, expected_reason)
    }
    machine unexpected(storage: Extent in Granted & Resident<WordPlacement, Word>) -> AccessReturn<Extent in Granted & Vacant, Word> {
        crash Trap;
    }
    machine check_reason(returned: AccessReturn<Extent in Granted & Vacant, Word>, reason: AccessInitializationFailure, expected: u64) -> AccessReturn<Extent in Granted & Vacant, Word> {
        transition reason {
            AccessInitializationFailure::RangeTooSmall { required, available } -> finish(returned, expected == 1 && required == 8 && available == 4)
            AccessInitializationFailure::Misaligned { modulus, residue } -> finish(returned, expected == 2 && modulus == 8 && residue == 0)
            AccessInitializationFailure::IncompatibleSupply -> finish(returned, expected == 3)
        }
    }
    machine finish(returned: AccessReturn<Extent in Granted & Vacant, Word>, reason_ok: bool) -> AccessReturn<Extent in Granted & Vacant, Word> {
        transition reason_ok && returned.custody.value == 17 {
            true -> done(returned)
            false -> bad(returned)
        }
    }
    machine done(returned: AccessReturn<Extent in Granted & Vacant, Word>) -> AccessReturn<Extent in Granted & Vacant, Word> { returned }
    machine bad(returned: AccessReturn<Extent in Granted & Vacant, Word>) -> AccessReturn<Extent in Granted & Vacant, Word> { crash Trap; }
}
