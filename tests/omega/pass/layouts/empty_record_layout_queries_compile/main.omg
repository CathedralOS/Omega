// An empty record is a real carrier for layout queries: `size_of<Marker>()`
// folds its zero extent and `align_of<Marker>()` its trivial alignment, and
// both usable in ordinary scalar positions.
data Marker { }

data Padded {
    tag: u64;
    marker: Marker;
}

data Main { total: u64; }

machine Main::main(main: &mut Main) {
    let marker_size: u64 = size_of<Marker>();
    let padded_size: u64 = size_of<Padded>();
    main.total = padded_size - marker_size;
}
