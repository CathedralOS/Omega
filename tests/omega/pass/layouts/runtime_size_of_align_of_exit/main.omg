// RUNTIME DATA-LAYOUT QUERIES (wiki/spec/layouts/, DATA-LAYOUT-QUERIES):
// `size_of<T>()` and `align_of<T>()` are authored as ordinary calls, not
// keywords. Their portable query must consume the selected validated layout
// without changing source checking per target. Queries close only after
// checking, under the selected target. Exits 70 when every answer matches
// the layout the program also depends on:
//   Row        -- native record, u64 + u32 pads to size 16, align 8
//   Pair       -- two u8s: size 2, align 1 (no padding)
//   Empty      -- validated zero-sized layout: size 0, align 1; distinct
//                 from the unresolved-array fallback that shares (0, 1)
//   &Row       -- reference storage (8/8 on every bound 64-bit target), not
//                 the referent's 16
//   CompactBits<PackedFlags> -- the installed plan places three logical
//                 fields in one byte, so the custom layout answers 1/1 where
//                 the native rule would give 3/1
use omega_language_std::console;

data Row { a: u64; b: u32; }
data Pair { a: u8; b: u8; }
data Empty {}

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField {
    key: u64;
    size: u64 [0..=4096];
    align: u64 [1..=16];
    number: i64;
    kind: FieldKind;
}
data Schema {
    fields: [SchemaField; 32];
    field_count: u64 [0..=32];
}
data FieldPlan {
    case At(offset: u64);
    case Bits(
        container: u64,
        container_width: u64,
        destination_lsb: u64,
        source_lsb: u64,
        width: u64
    );
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data CompactBits { }
machine CompactBits::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 0,
            source_lsb: 0,
            width: 1,
        },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 1,
            source_lsb: 0,
            width: 3,
        },
    };
    entries[2] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 4,
            source_lsb: 0,
            width: 2,
        },
    };
    entries[3] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0,
            container_width: 8,
            destination_lsb: 6,
            source_lsb: 2,
            width: 2,
        },
    };
    Plan {
        entries: entries,
        entry_count: 4,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}

data PackedFlags {
    present: bool;
    mode: u8 [0..=7];
    code: u8 [0..=15];
}

const ROW_BYTES: u64 = size_of<Row>();
const ROW_ALIGN: u64 = align_of<Row>();
const EMPTY_BYTES: u64 = size_of<Empty>();
const REF_BYTES: u64 = size_of<&Row>();

data Main {
    row: Row;
    packed: CompactBits<PackedFlags>;
}

machine Main::main(main: &mut Main) reaches Console {
    // Runtime and const observations must agree under the exact selected layout.
    let row_bytes: u64 = size_of<Row>();
    let pair_bytes: u64 = size_of<Pair>();
    let packed_bytes: u64 = size_of<CompactBits<PackedFlags>>();
    let packed_align: u64 = align_of<CompactBits<PackedFlags>>();
    main.row = Row { a: row_bytes, b: 7 };

    transition row_bytes == ROW_BYTES && ROW_ALIGN == 8 && pair_bytes == 2
        && main.row.a == 16 {
        true -> check_zero_sized(main, row_bytes, packed_bytes, packed_align)
        false -> bad_padding(main)
    }

    state check_zero_sized(main: &mut Main, row_bytes: u64, packed_bytes: u64, packed_align: u64) {
        transition EMPTY_BYTES == 0 && size_of<Empty>() == 0 && row_bytes == 16 {
            true -> check_reference(main, packed_bytes, packed_align)
            false -> bad_zero(main)
        }
    }

    state check_reference(main: &mut Main, packed_bytes: u64, packed_align: u64) {
        transition REF_BYTES == 8 && size_of<&Row>() == 8 && align_of<&Row>() == 8 {
            true -> check_plan(main, packed_bytes, packed_align)
            false -> bad_reference(main)
        }
    }

    state check_plan(main: &mut Main, packed_bytes: u64, packed_align: u64) {
        transition packed_bytes == 1 && packed_align == 1 {
            true -> good(main)
            false -> bad_plan(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad_padding(main: &mut Main) {
        Console::exit_process(71);
    }

    state bad_zero(main: &mut Main) {
        Console::exit_process(72);
    }

    state bad_reference(main: &mut Main) {
        Console::exit_process(73);
    }

    state bad_plan(main: &mut Main) {
        Console::exit_process(74);
    }
}
