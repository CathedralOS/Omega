// A where-constrained record works as a sum payload: `Event` carries
// `Span` (valid only while `lo <= hi`) — the invariant travels inside
// the discriminant's layout like any other record payload.
data Span
requires
    lo <= hi,
{
    lo: u64;
    hi: u64;
}

data Event {
    case Empty;
    case Range(span: Span);
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Event>();
}
