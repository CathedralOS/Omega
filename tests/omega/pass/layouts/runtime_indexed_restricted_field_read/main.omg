// A nonconstant checked selector reads a constrained scalar field through a call.
data Byte where value >= 0 && value <= 1 { value: u8; }
data Main { bytes: [Byte; 4]; }
machine take(value: &u8) -> u8 { value }
machine inspect(main: &Main, position: u64) -> u8 {
    transition position < 4 {
        true -> selected(main, position)
        _ -> 0
    }
    state selected(main: &Main, position: u64) -> u8 {
        take(&main.bytes[position].value)
    }
}
machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[2].value = 1;
    let chosen: u8 = inspect(main, 2);
    let neighbor: u8 = inspect(main, 1);
    let outside: u8 = inspect(main, 4);
    transition chosen == 1 && neighbor == 0 && outside == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
