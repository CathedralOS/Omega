// Layout queries fold through nested records: `Outer` contains `Inner`,
// so `size_of<Outer>()` accounts for the member's own size and alignment —
// a u16-lead outer record pads to the inner u64 alignment before the
// member.
data Inner {
    wide: u64;
    small: u8;
}

data Outer {
    tag: u16;
    inner: Inner;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Outer>() - size_of<Inner>();
}
