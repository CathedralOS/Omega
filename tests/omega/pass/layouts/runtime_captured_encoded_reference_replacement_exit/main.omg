// Replacing a moved reference container cannot retarget its returned loan.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where size <= 4096, 1 <= align, align <= 16,
{ key: u64; size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
data PortableByte [copy] { value: i64; }
data RawView { value: SignedByte<PortableByte>; }
data Sources<'storage> {
    first: &'storage mut i64;
    second: &'storage mut i64;
}
data Main { bytes: [u8; 2]; ordinary: i64; third: i64; fourth: i64; }

machine choose<'storage>(sources: Sources<'storage>, second: bool) -> &'storage mut i64 {
    transition second {
        true -> sources.second
        _ -> sources.first
    }
}
machine update(first: &mut i64, second: &mut i64, third: &mut i64, fourth: &mut i64) {
    let mut sources: Sources = Sources { first: first, second: second };
    let captured: &mut i64 = choose(sources, false);
    sources = Sources { first: third, second: fourth };
    captured = 127;
    let replacement: &mut i64 = choose(sources, true);
    replacement = 42;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[0] = 0;
    main.bytes[1] = 85;
    main.ordinary = 257;
    main.third = 17;
    main.fourth = 34;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    update(&mut view.value.value, &mut main.ordinary, &mut main.third, &mut main.fourth);
    transition main.bytes[0] == 127 && main.bytes[1] == 85
        && main.ordinary == 257 && main.third == 17 && main.fourth == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
