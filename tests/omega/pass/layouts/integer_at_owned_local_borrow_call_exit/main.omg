// A program that holds a plan-laid IntegerAt layout checks every effectful
// invocation's writes against physical storage. A later state that lends one
// of its own owned locals to a callee writes only that local: its origin is
// the local, not unknown storage, so the call needs no IntegerAt fit and the
// program runs. Declaring the plan-laid `RawView` is what enables the check.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where
    size <= 4096,
    1 <= align,
    align <= 16,
{
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}
data Schema
where
    field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}

data PortableByte [copy] { value: i64; }
data RawView { value: SignedByte<PortableByte>; }
data Main { bytes: [u8; 2]; }

machine set(dst: &mut i64, value: i64) { dst = value; }
machine forward(dst: &mut i64, value: i64) { set(dst, value); }

machine set_sentinel(main: &mut Main) { main.bytes[1] = 85; }

data Instant { seconds: i64; nanoseconds: i64; }

machine fill(instant: &mut Instant, seconds: i64) -> i64 {
    instant.seconds = seconds;
    0
}

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[0] = 100;
    transition { _ -> measure(main) }
    state measure(main: &mut Main) {
        let mut instant: Instant = Instant { seconds: 0, nanoseconds: 0 };
        let status: i64 = fill(&mut instant, 7);
        transition status == 0 && instant.seconds == 7 && main.bytes[0] == 100 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
