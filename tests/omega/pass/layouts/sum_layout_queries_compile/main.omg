// `size_of` and `align_of` fold on sum carriers: a `Step` sum's layout is
// its discriminant plus the widest payload, and its alignment is the
// largest member alignment. The folded results are ordinary scalars.
data Step {
    case Count(count: u64);
    case Pair(first: u32, second: u32);
    case Idle;
}

data Main { span: u64; }

machine Main::main(main: &mut Main) {
    let size: u64 = size_of<Step>();
    let aligned: u64 = align_of<Step>();
    main.span = size + aligned;
}
