use omega::language::core::layout;
// PLAN-LAID VALUE TYPES (wiki/spec/layouts/plans.md):
// `gdt: LayoutStorage<Gdtish, Spread16>` applies a layout POLICY to a schema in TYPE
// position. The policy here is deliberately NOT the native packing rule --
// every field is placed on its own 16-byte slot (offsets 0/16/32/48, size 64,
// align 16), so the plan-laid value's placement disagrees with native packing
// at every field but the first. All field writes, reads, and the whole-value
// copy must go through the SAME baked plan offsets: if any downstream
// consumer recomputed native offsets independently, the reads below would see
// zeros from the padding gaps and the program exits 71. Exits 70 only when
// every value written through the plan placement survives the copy and reads
// back intact.
use omega_language_std::console;

data Spread16State {
    index: u64 in Wrapping;
    slot: u64 in Wrapping;
}
machine Spread16State::make_plan(spread16: &mut Spread16State, schema: Schema) -> LayoutPlan {
    Spread16State::evaluate(spread16, schema, 256)
}

machine Spread16State::evaluate(spread16: &mut Spread16State, schema: Schema, fuel: u64) -> LayoutPlan
requires 1 <= fuel
requires fuel <= 256
terminates by fuel
{
    let mut entries: [FieldEntry; 64];
    spread16.index = 0;
    transition { _ -> fill_loop(spread16, schema, fuel, entries) }

    machine fill_loop(spread16: &mut Spread16State, schema: Schema, fuel: u64, entries: [FieldEntry; 64]) -> LayoutPlan
    requires 1 <= fuel
    requires fuel <= 256 {
        transition fuel > 1 && spread16.index < 32 && spread16.index < schema.field_count {
            true -> place_field(spread16, schema, fuel - 1, entries)
            _ -> done(schema, entries)
        }
    }
    machine place_field(spread16: &mut Spread16State, schema: Schema, fuel: u64, entries: [FieldEntry; 64]) -> LayoutPlan
    requires 1 <= fuel
    requires fuel <= 256 {
        spread16.slot = spread16.index * 16;
        transition fuel > 1 && spread16.index < 32 {
            true -> write_field(spread16, schema, fuel - 1, entries)
            _ -> done(schema, entries)
        }
    }
    machine write_field(spread16: &mut Spread16State, schema: Schema, fuel: u64, entries: [FieldEntry; 64]) -> LayoutPlan
    requires 1 <= fuel
    requires fuel <= 256 {
        let mut updated: [FieldEntry; 64] = entries;
        let offset: u64 = spread16.slot as u64;
        updated[spread16.index] = FieldEntry {
            key: schema.fields[spread16.index].key,
            representation: FieldPlan::At { offset: offset },
        };
        spread16.index = spread16.index + 1;
        transition fuel > 1 {
            true -> fill_loop(spread16, schema, fuel - 1, updated)
            _ -> done(schema, updated)
        }
    }
    machine done(schema: Schema, entries: [FieldEntry; 64]) -> LayoutPlan {
        LayoutPlan {
            entries: entries,
            entry_count: schema.field_count,
            size_fixed: schema.field_count * 16,
            size_is_dynamic: false,
            align: 16,
        }
    }
}

// The selected policy uses ordinary scratch state while computing the same
// sixteen-byte field slots. Stored values use the validated layout directly.
Spread16 satisfies FixedLayout<Gdtish> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan
    reaches none terminates {
        let mut scratch: Spread16State = Spread16State { index: 0u64, slot: 0u64 };
        Spread16State::make_plan(&mut scratch, schema)
    }
}

// A UEFI-descriptor-ish schema: mixed widths so native packing (0/4/8/16)
// and the spread plan (0/16/32/48) disagree everywhere past field 0.
data Gdtish [copy] {
    limit_low: u16;
    base_low: u32;
    flags: u8;
    base_high: u64;
}

data Main {
    gdt: LayoutStorage<Gdtish, Spread16>;
    twin: LayoutStorage<Gdtish, Spread16>;
    v: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.gdt.limit_low = 7;
    main.gdt.base_low = 20;
    main.gdt.flags = 3;
    main.gdt.base_high = 40;
    main.twin = main.gdt;

    transition main.twin.limit_low == 7 {
        true -> check_low(main)
        false -> bad(main)
    }

    machine check_low(main: &mut Main) {
        transition main.twin.base_low == 20 {
            true -> check_flags(main)
            false -> bad(main)
        }
    }

    machine check_flags(main: &mut Main) {
        transition main.twin.flags == 3 {
            true -> check_high(main)
            false -> bad(main)
        }
    }

    machine check_high(main: &mut Main) {
        transition main.twin.base_high == 40 {
            true -> good(main)
            false -> bad(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
