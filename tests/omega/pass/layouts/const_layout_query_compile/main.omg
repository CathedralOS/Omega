// A layout query folds at module scope: `const WIDTH` initialized from
// `size_of<Cell>()` evaluates the query in const position, and later code
// reads the constant like any other folded value.
data Cell {
    value: u64;
    index: u32;
}

const WIDTH: u64 = size_of<Cell>();
const TIGHT: u64 = align_of<Cell>();

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = WIDTH + TIGHT;
}
