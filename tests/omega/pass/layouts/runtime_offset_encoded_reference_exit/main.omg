// Scalar loans retain both the nonzero byte offset and unsigned stored width.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where size <= 4096, 1 <= align, align <= 16,
{ key: u64; size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
data OffsetWord { }
machine OffsetWord::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 1,
            stored_width: 16,
            interpretation: IntegerInterpretation::Unsigned,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 4,
        size_is_dynamic: false,
        align: 1,
    }
}
data PortableWord [copy] { value: i64; }
data RawView { value: OffsetWord<PortableWord>; }
data Main { bytes: [u8; 6]; }

machine retain<'a>(value: &'a mut i64) -> &'a mut i64 { &mut value }
machine set(value: &mut i64, replacement: i64) { value = replacement; }
machine forward(value: &mut i64, replacement: i64) { set(value, replacement); }

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[0] = 85;
    main.bytes[1] = 17;
    main.bytes[2] = 0;
    main.bytes[3] = 128;
    main.bytes[4] = 34;
    main.bytes[5] = 90;
    let view: &mut RawView = &mut main.bytes[1] as &mut RawView;
    let leaf: &mut i64 = &mut view.value.value;
    let returned: &mut i64 = retain(leaf);
    let before: i64 = returned;
    forward(returned, 65535);
    let after: i64 = returned;
    transition before == 32768 && after == 65535
        && main.bytes[0] == 85 && main.bytes[1] == 17
        && main.bytes[2] == 255 && main.bytes[3] == 255
        && main.bytes[4] == 34 && main.bytes[5] == 90 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
