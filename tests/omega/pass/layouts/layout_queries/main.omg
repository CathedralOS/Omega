// Portable data layout queries are const-foldable builtins:
// `size_of<Pair>()` and `align_of<Pair>()` answer the authored
// layout's byte size and alignment as u64 constants — usable in
// const initializers, guards, and interval endpoints.
data Pair { left: u64; right: u32; }
const BYTES: u64 = size_of<Pair>();
data Main { }
machine Main::main(main: &mut Main) {
    let alignment: u64 = align_of<Pair>();
    transition BYTES == 16 && alignment == 8 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
