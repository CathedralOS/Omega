// Canonical schema reflection preserves the exact optional stable identity.
use omega::language::core::layout;
use omega::language::core::option;

data Payload { #6 value: u32; }

Contiguous satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let identity_matches: bool = match schema.fields[0].identity {
            Optional::Some { value } -> value == 6u64
            Optional::None -> false
        };
        let selected_align: u64 = match identity_matches {
            true -> 4u64
            false -> 0u64
        };
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
        Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: selected_align }
    }
}

data View { payload: LayoutStorage<Payload, Contiguous>; }
machine main() { let view: View; }
