// A recursively fixed record remains one compiler-sized element when its
// outer array is placed through one `At` per element. The twelve-byte physical
// stride is distinct from Pair's eight-byte semantic width; Pair's own padding
// and field offsets remain compiler-derived inside each destination extent.
use omega_language_std::console;
use omega::language::core::layout;

data TiledRecordArray { entries: [FieldEntry; 64]; }

machine TiledRecordArray::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 16 },
    };
    self.entries[1] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 4 },
    };
    Plan {
        entries: self.entries,
        entry_count: 2,
        size_fixed: 24,
        size_is_dynamic: false,
        align: 4,
    }
}

data Pair {
    low: u16;
    high: u32;
}

data Samples { pairs: [Pair; 2]; }
data TiledRecordView { value: TiledRecordArray<Samples>; }

machine make_samples() -> Samples {
    let pairs: [Pair; 2];
    pairs[0] = Pair { low: 0x0201, high: 0x06050403 };
    pairs[1] = Pair { low: 0x0807, high: 0x0c0b0a09 };
    Samples { pairs: pairs }
}

data Main {
    console: Console;
    bytes: [u8; 24];
    index: u64;
    observed_low: u16;
    observed_high: u32;
}

machine Main::main(&mut self) {
    let view: &mut TiledRecordView = &mut self.bytes[0] as &mut TiledRecordView;
    self.index = 0;
    view.value.pairs[self.index].low = 0x0201;
    view.value.pairs[self.index].high = 0x06050403;
    self.index = 1;
    view.value.pairs[self.index].low = 0x0807;
    view.value.pairs[self.index].high = 0x0c0b0a09;
    self.observed_low = view.value.pairs[self.index].low;
    self.observed_high = view.value.pairs[self.index].high;
    transition self.bytes[4] == 1 && self.bytes[5] == 2
        && self.bytes[6] == 0 && self.bytes[7] == 0
        && self.bytes[8] == 3 && self.bytes[9] == 4
        && self.bytes[10] == 5 && self.bytes[11] == 6
        && self.bytes[12] == 0 && self.bytes[13] == 0
        && self.bytes[14] == 0 && self.bytes[15] == 0
        && self.bytes[16] == 7 && self.bytes[17] == 8
        && self.bytes[18] == 0 && self.bytes[19] == 0
        && self.bytes[20] == 9 && self.bytes[21] == 10
        && self.bytes[22] == 11 && self.bytes[23] == 12
        && self.observed_low == 0x0807
        && self.observed_high == 0x0c0b0a09 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
