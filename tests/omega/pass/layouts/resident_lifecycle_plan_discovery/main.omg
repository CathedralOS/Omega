// Checking probe: lifecycle calls retain geometry without a later placed view.
// No allocation or executed initialization is claimed by this fixture.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

public data Word { value: u64; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::inaccessible(layout),
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine initialize<P, T>(storage: Extent in Granted & Vacant, value: T)
    -> AccessOutcome<
        Extent in Granted & Resident<P, T>,
        AccessReturn<Extent in Granted & Vacant, T>,
        AccessInitializationFailure
    >
reaches AccessLifecycle + ResourceProfileSupply
{
    Access::initialize_owned<P, T>(storage, value)
}

machine wrapped(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
reaches AccessLifecycle + ResourceProfileSupply
{
    initialize<WordPlacement, Word>(storage, value)
}

machine direct(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
reaches AccessLifecycle + ResourceProfileSupply
{
    AccessLifecycle<WordPlacement, Word>::initialize(storage, value)
}

machine extract(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> AccessReturn<Extent in Granted & Vacant, Word>
reaches AccessLifecycle + ResourceProfileSupply
{
    Access::move_out_owned<WordPlacement, Word>(storage)
}

machine native_provider(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
reaches ResourceProfileSupply
{
    NativeAccess<WordPlacement, Word, TestMemory>::initialize(storage, value)
}

machine decline(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
{
    AccessOutcome::Rejected {
        returned: AccessReturn { source: storage, custody: value },
        reason: AccessInitializationFailure::IncompatibleSupply,
    }
}

boundary machine uncalled_extraction(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> AccessExtraction<Extent in Granted & Vacant, Word>;

Selected satisfies AccessLifecycle<WordPlacement, Word> {
    AccessLifecycle::initialize = decline;
    AccessLifecycle::move_out = uncalled_extraction;
}

machine selected(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
reaches AccessLifecycle + ResourceProfileSupply
{
    Selected::initialize(storage, value)
}

// The false branch exercises ordinary owned forwarding through helper calls
// and nested result construction without pretending initialization executed.
machine transport(storage: Extent in Granted & Vacant, value: Word, initialize: bool)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
reaches AccessLifecycle + ResourceProfileSupply
{
    transition initialize {
        true -> wrapped(storage, value)
        false -> decline(storage, value)
    }
}
