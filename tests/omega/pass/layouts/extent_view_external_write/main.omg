// Embedding oracle: update the second original external word from 41 to 73,
// preserve the first word 17, and return the same Granted & Vacant extent.
// Vacancy is supplied on entry, never introduced by a scalar write. Mutation
// requires an exclusive storage loan and preserves the issuer's registration.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

// A checked issuer qualifies this exact descriptor, not the external bytes.
// Changing those bytes must neither manufacture nor lose this provenance.
domain Extent::Registered established by register;

machine register(storage: Extent in Granted & Vacant) -> Extent in Granted & Vacant
ensures result in Registered
{
    storage
}

public data Words { entries: [u64; 2]; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: fields, entry_count: 1, size_fixed: 16, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine update_existing(storage: &mut Extent in Granted) -> bool
requires storage in Registered & Vacant
ensures storage in Registered & Vacant
reaches ResourceProfileSupply
{
    transition Placed::view_extent_mut<WordPlacement, Words, TestMemory>(storage) {
        PlacementOutcome::Ready { view } -> check(view)
        PlacementOutcome::Rejected { returned, reason } -> false
    }
    machine check(view: &mut Placed<WordPlacement, Words>) -> bool {
        let first: u64 = placed_read(&view.entries[0]);
        let second: u64 = placed_read(&view.entries[1]);
        transition first == 17 && second == 41 {
            true -> write(view, 0)
            _ -> false
        }
    }
    machine write(view: &mut Placed<WordPlacement, Words>, next: u64) -> bool
    requires next <= 1
    {
        transition next < 1 {
            true -> store(view, next)
            _ -> verify(view)
        }
    }
    machine store(view: &mut Placed<WordPlacement, Words>, next: u64) -> bool
    requires next < 1
    {
        placed_write(&mut view.entries[next + 1], 73u64);
        transition { _ -> write(view, next + 1) }
    }
    machine verify(view: &mut Placed<WordPlacement, Words>) -> bool {
        let first: u64 = placed_read(&view.entries[0]);
        let second: u64 = placed_read(&view.entries[1]);
        first == 17 && second == 73
    }
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut transfers: [TransferRule; 16];
        transfers[0] = TransferRule { width_bits: 64, alignment_bytes: 8 };
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::HostileShared,
            stable: StableCapability::None,
            external: ExternalCapability::Access {
                read: ExternalReadBehavior::Repeatable, write: true,
                transfers: TransferRules { entries: transfers, rule_count: 1 },
            },
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

machine attempt(storage: Extent in Granted & Vacant) -> Extent in Granted & Vacant
ensures result in Registered
reaches ResourceProfileSupply crashes Trap
{
    let mut retained: Extent in Granted & Vacant = register(storage);
    let written: bool = update_existing(&mut retained);
    transition written {
        true -> verify(retained)
        _ -> fail(retained)
    }
    machine verify(storage: Extent in Granted & Vacant) -> Extent in Granted & Vacant {
        let observed: bool = observe_existing(&storage);
        transition observed {
            true -> (storage)
            _ -> fail(storage)
        }
    }
    machine fail(storage: Extent in Granted & Vacant) -> Extent in Granted & Vacant { crash Trap; }
}

machine observe_existing(storage: &Extent in Granted & Vacant) -> bool
reaches ResourceProfileSupply
{
    transition Placed::view_extent<WordPlacement, Words, TestMemory>(storage as &Extent in Granted) {
        PlacementOutcome::Ready { view } -> check(view)
        PlacementOutcome::Rejected { returned, reason } -> false
    }
    machine check(view: &Placed<WordPlacement, Words>) -> bool {
        let first: u64 = placed_read(&view.entries[0]);
        let second: u64 = placed_read(&view.entries[1]);
        first == 17 && second == 73
    }
}
