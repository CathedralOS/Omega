// Expected exit: 0
machine placed_read<Accessor, Value>(field: &Accessor, value: Value) -> Value { value }
machine main() crashes Trap {
    let value: u64 = 17;
    let result: u64 = placed_read(&value, 29u64);
    transition result == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
