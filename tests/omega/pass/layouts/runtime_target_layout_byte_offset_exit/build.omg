machine build(builder: &mut Build) {
    Build::application(builder, "runtime_target_layout_byte_offset_exit");
    Build::select_provider<LayoutExpected, MacosArm64LayoutExpected>(builder, macos_arm64);
    Build::select_provider<LayoutExpected, LinuxX8664LayoutExpected>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, program);
    Build::bind(builder, linux_x86_64::ProgramEntry, program);
}
