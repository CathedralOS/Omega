// Layout queries reflect member alignment: `Mixed` pairs a `u8` with a
// `u64`, so its folded size carries padding to the wider member's alignment
// — 16 bytes at align 8, not 9 bytes.
data Mixed {
    flag: u8;
    count: u64;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    let size: u64 = size_of<Mixed>();
    let aligned: u64 = align_of<Mixed>();
    main.extent = size - aligned;
}
