// Embedding oracle: returns the original Granted extent only after reading 41
// from its second external u64. A different value must crash. The provider
// supplies no Stable observation, Vacant qualification, or resident custody.
// The range is already qualified. The view must retain that exact loan, not
// interpret the descriptor's two integers as the external bytes.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

public data Words { entries: [u64; 2]; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: fields, entry_count: 1, size_fixed: 16, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: false, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine read_existing(storage: &Extent in Granted) -> u64
reaches ResourceProfileSupply
{
    transition Placed::view_extent<WordPlacement, Words, TestMemory>(storage) {
        PlacementOutcome::Ready { view } -> (placed_read(&view.entries[1]))
        PlacementOutcome::Rejected { returned, reason } -> 0
    }
}

machine forward<T>(value: T) -> T { value }

machine read_stored(storage: &Extent in Granted) -> u64
reaches ResourceProfileSupply
{
    let outcome: PlacementOutcome<&Placed<WordPlacement, Words>, PlacementBorrowReturn, PlacementInitializationFailure> =
        Placed::view_extent<WordPlacement, Words, TestMemory>(storage);
    let forwarded: PlacementOutcome<&Placed<WordPlacement, Words>, PlacementBorrowReturn, PlacementInitializationFailure> = forward(outcome);
    transition forwarded {
        PlacementOutcome::Ready { view } -> (placed_read(&view.entries[1]))
        PlacementOutcome::Rejected { returned, reason } -> 0
    }
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut transfers: [TransferRule; 16];
        transfers[0] = TransferRule { width_bits: 64, alignment_bytes: 8 };
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::HostileShared,
            stable: StableCapability::None,
            external: ExternalCapability::Access {
                read: ExternalReadBehavior::Repeatable, write: false,
                transfers: TransferRules { entries: transfers, rule_count: 1 },
            },
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}
machine attempt(storage: Extent in Granted) -> Extent in Granted
reaches ResourceProfileSupply crashes Trap
{
    let observed: u64 = read_existing(&storage);
    let stored: u64 = read_stored(&storage);
    transition observed == 41 && stored == 41 {
        true -> (storage)
        _ -> fail(storage)
    }
    machine fail(storage: Extent in Granted) -> Extent in Granted { crash Trap; }
}
