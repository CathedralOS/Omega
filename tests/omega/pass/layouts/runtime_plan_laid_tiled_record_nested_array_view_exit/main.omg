// A recursively fixed record containing a fixed primitive array remains one
// compiler-sized element when its outer array is tiled through `At`. The
// physical outer stride is plan-derived; the record-member offset and inner
// array stride remain compiler-derived between and below two runtime indices.
use omega_language_std::console;
use omega::language::core::layout;

data TiledRecordNestedArray { }

machine TiledRecordNestedArray::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 16 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 4 },
    };
    Plan {
        entries: entries,
        entry_count: 2,
        size_fixed: 28,
        size_is_dynamic: false,
        align: 4,
    }
}

data Cell {
    tag: u32;
    values: [u16; 2];
}

data Samples { cells: [Cell; 2]; }
data TiledRecordNestedArrayView { value: TiledRecordNestedArray<Samples>; }

machine make_samples() -> Samples {
    let cells: [Cell; 2];
    cells[0] = Cell {
        tag: 0x04030201,
        values: [0x0605, 0x0807],
    };
    cells[1] = Cell {
        tag: 0x0c0b0a09,
        values: [0x0e0d, 0x100f],
    };
    Samples { cells: cells }
}

data Main {
    bytes: [u8; 28];
    outer: u64;
    inner: u64;
    observed: u16;
}

machine Main::main(main: &mut Main) reaches Console {
    let view: &mut TiledRecordNestedArrayView =
        &mut main.bytes[0] as &mut TiledRecordNestedArrayView;
    main.outer = 0;
    view.value.cells[main.outer].tag = 0x04030201;
    main.inner = 0;
    view.value.cells[main.outer].values[main.inner] = 0x0605;
    main.inner = 1;
    view.value.cells[main.outer].values[main.inner] = 0x0807;
    main.outer = 1;
    view.value.cells[main.outer].tag = 0x0c0b0a09;
    main.inner = 0;
    view.value.cells[main.outer].values[main.inner] = 0x0e0d;
    main.inner = 1;
    view.value.cells[main.outer].values[main.inner] = 0x100f;
    main.observed = view.value.cells[main.outer].values[main.inner];
    transition main.bytes[0] == 0 && main.bytes[1] == 0
        && main.bytes[2] == 0 && main.bytes[3] == 0
        && main.bytes[4] == 1 && main.bytes[5] == 2
        && main.bytes[6] == 3 && main.bytes[7] == 4
        && main.bytes[8] == 5 && main.bytes[9] == 6
        && main.bytes[10] == 7 && main.bytes[11] == 8
        && main.bytes[12] == 0 && main.bytes[13] == 0
        && main.bytes[14] == 0 && main.bytes[15] == 0
        && main.bytes[16] == 9 && main.bytes[17] == 10
        && main.bytes[18] == 11 && main.bytes[19] == 12
        && main.bytes[20] == 13 && main.bytes[21] == 14
        && main.bytes[22] == 15 && main.bytes[23] == 16
        && main.bytes[24] == 0 && main.bytes[25] == 0
        && main.bytes[26] == 0 && main.bytes[27] == 0
        && main.observed == 0x100f {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
