// A byte member followed by an f64 pads to the double's alignment: `Q`
// holds u8 then f64 — 7 pad bytes before the wide member, folding to 16
// at align 8.
data Q {
    tag: u8;
    value: f64;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Q>();
}
