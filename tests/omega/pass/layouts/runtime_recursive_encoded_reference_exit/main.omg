// Ranked tail recursion retains the original bytes and authored integer encoding.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where size <= 4096, 1 <= align, align <= 16,
{ key: u64; size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
data PortableByte [copy] { value: i64; }
data RawView { value: SignedByte<PortableByte>; }
data Main { bytes: [u8; 2]; ordinary: i64; }

machine retain<'storage>(value: &'storage mut i64, remaining: u64)
    requires remaining <= 4
terminates by remaining -> Nat::Descending in 0..=4;
-> &'storage mut i64 {
    transition remaining > 0 {
        true -> retain(value, remaining - 1)
        false -> value
    }
}
machine set(value: &mut i64, replacement: i64) { value = replacement; }
machine choose<'storage>(first: &'storage mut i64, second: &'storage mut i64, choose_second: bool) -> &'storage mut i64 {
    transition choose_second {
        true -> second
        _ -> first
    }
}
machine select_recursive<'storage>(first: &'storage mut i64, second: &'storage mut i64, remaining: u64, choose_second: bool)
    requires remaining <= 4
terminates by remaining -> Nat::Descending in 0..=4;
-> &'storage mut i64 {
    transition remaining > 0 {
        true -> select_recursive(first, second, remaining - 1, choose_second)
        _ -> choose(first, second, choose_second)
    }
}
machine forward(value: &mut i64, replacement: i64) { set(value, replacement); }
machine write_returned(value: &mut i64, replacement: i64) {
    let returned: &mut i64 = retain(value, 4);
    forward(returned, replacement);
}
machine write_repeatedly(value: &mut i64, remaining: u64)
    requires remaining <= 4
terminates by remaining -> Nat::Descending in 0..=4; {
    // The helper's actual value proves fit inside the cycle, on every arrival.
    set(value, 127);
    transition remaining > 0 {
        true -> write_repeatedly(value, remaining - 1)
        _ -> done(value, remaining)
    }
    state done(value: &mut i64, remaining: u64) {}
}

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[0] = 0;
    main.bytes[1] = 85;
    main.ordinary = 257;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let leaf: &mut i64 = &mut view.value.value;
    write_returned(leaf, -128);
    let minimum: i64 = leaf;
    write_returned(leaf, 127);
    write_repeatedly(leaf, 4);
    let maximum: i64 = leaf;
    let encoded: &mut i64 = select_recursive(leaf, &mut main.ordinary, 4, false);
    encoded = -128;
    let ordinary: &mut i64 = select_recursive(leaf, &mut main.ordinary, 4, true);
    let original_ordinary: i64 = ordinary;
    // The declared source union requires a value that fits both candidates.
    ordinary = 127;
    transition minimum == -128 && maximum == 127 && original_ordinary == 257 && main.bytes[0] == 128 && main.ordinary == 127 && main.bytes[1] == 85 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
