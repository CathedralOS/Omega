// A checked adapter exposes the encoded record's exact byte-shaped foreign ABI.
use omega::language::core::external_binding;
use omega::language::core::binding;
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where size <= 4096, 1 <= align, align <= 16,
{ key: u64; size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
pub data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
pub data PortableByte [copy] { value: i64; }
pub data RawView { value: SignedByte<PortableByte>; }
pub data ForeignByte { value: i8; }

pub boundary trait ClearByte {
    machine clear(value: &mut ForeignByte, count: u64);
}
macos_arm64 machine clear_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_bzero",
        },
    }
}

linux_x86_64 machine linux_x86_64_clear_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "bzero", version: "GLIBC_2.2.5",
        },
    }
}
macos_arm64 machine clear_bytes(value: &mut ForeignByte, count: u64)
    satisfies ClearByte::clear via clear_binding();

linux_x86_64 machine clear_bytes(value: &mut ForeignByte, count: u64)
    satisfies ClearByte::clear via linux_x86_64_clear_binding();
machine clear(clear_byte: &Binding<ClearByte>, value: &mut RawView) reaches ClearByte {
    let physical: &mut ForeignByte = value as &mut ForeignByte;
    ClearByte::clear(clear_byte, physical, 1);
}

pub boundary trait CompareByte {
    machine compare(left: &RawView, right: &RawView, count: u64) -> i32;
}
macos_arm64 machine compare_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp",
        },
    }
}

linux_x86_64 machine linux_x86_64_compare_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5",
        },
    }
}
macos_arm64 machine compare_bytes(left: &RawView, right: &RawView, count: u64) -> i32
    satisfies CompareByte::compare via compare_binding();

linux_x86_64 machine compare_bytes(left: &RawView, right: &RawView, count: u64) -> i32
    satisfies CompareByte::compare via linux_x86_64_compare_binding();
machine compare(compare_byte: &Binding<CompareByte>, left: &RawView, right: &RawView) -> i32 reaches CompareByte {
    CompareByte::compare(compare_byte, left, right, 1)
}
data Main { bytes: [u8; 2]; expected: [u8; 1]; compare_byte: Binding<CompareByte>; clear_byte: Binding<ClearByte>; }
machine Main::main(main: &mut Main) reaches CompareByte + ClearByte crashes Trap {
    main.bytes[0] = 128;
    main.bytes[1] = 85;
    main.expected[0] = 128;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let expected: &RawView = &main.expected[0] as &RawView;
    let result: i32 = compare(&main.compare_byte, view, expected);
    let initial: i64 = view.value.value;
    clear(&main.clear_byte, view);
    transition result == 0 && initial == -128 && view.value.value == 0 && main.bytes[1] == 85 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
