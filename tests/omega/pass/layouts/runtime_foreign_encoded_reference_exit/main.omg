// A checked adapter exposes the encoded record's exact byte-shaped foreign ABI.
use omega::language::core::external_binding;
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where size <= 4096, 1 <= align, align <= 16,
{ key: u64; size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
public data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
public data PortableByte [copy] { value: i64; }
public data RawView { value: SignedByte<PortableByte>; }
public data ForeignByte { value: i8; }

public boundary trait ClearByte {
    machine clear(value: &mut ForeignByte, count: u64) reaches;
}


machine clear(value: &mut RawView) reaches ClearByte {
    let physical: &mut ForeignByte = value as &mut ForeignByte;
    ClearByte::clear(physical, 1);
}

public boundary trait CompareByte {
    machine compare(left: &RawView, right: &RawView, count: u64) -> i32 reaches;
}


machine compare(left: &RawView, right: &RawView) -> i32 reaches CompareByte {
    CompareByte::compare(left, right, 1)
}
data Main { bytes: [u8; 2]; expected: [u8; 1]; }
machine Main::main(main: &mut Main) reaches CompareByte + ClearByte crashes Trap {
    main.bytes[0] = 128;
    main.bytes[1] = 85;
    main.expected[0] = 128;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let expected: &RawView = &main.expected[0] as &RawView;
    let result: i32 = compare(view, expected);
    let initial: i64 = view.value.value;
    clear(view);
    transition result == 0 && initial == -128 && view.value.value == 0 && main.bytes[1] == 85 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches CompareByte + ClearByte crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
