use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_foreign_encoded_reference_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind<ClearByte::clear>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_bzero",
        },
    });
 Build::bind<ClearByte::clear>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "bzero", version: "GLIBC_2.2.5",
        },
    });
 Build::bind<CompareByte::compare>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp",
        },
    });
 Build::bind<CompareByte::compare>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5",
        },
    });
}
