// `size_of`/`align_of` fold array members by count × element size: `Table`
// holds `[u16; 8]`, so its extent is 16 bytes under u16 alignment, and its
// answers differ from a scalar-only sibling record.
data Table {
    entries: [u16; 8];
}

data Main { total: u64; }

machine Main::main(main: &mut Main) {
    let array_bytes: u64 = size_of<Table>();
    let array_align: u64 = align_of<Table>();
    main.total = array_bytes + array_align;
}
