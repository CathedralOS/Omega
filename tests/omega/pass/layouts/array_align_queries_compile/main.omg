// `align_of` folds array carriers as well as records: `[u64; 3]` aligns
// to its element (8) — array type syntax serves as a query argument
// directly.
data Main {
    wide: u64;
    narrow: u64;
}

machine Main::main(main: &mut Main) {
    main.wide = align_of<[u64; 3]>();
    main.narrow = align_of<[u8; 3]>();
}
