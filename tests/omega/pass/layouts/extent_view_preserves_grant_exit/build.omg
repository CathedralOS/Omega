use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "extent_view_preserves_grant");
    Build::accept_boundary<ResourceProfileSupply<TestMemory>>(builder);
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, RootProvider>(builder, windows_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<ExtentRootProvider, RootProvider>(builder, linux_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<ExtentRootProvider, RootProvider>(builder, macos_arm64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<ExtentRootProvider, RootProvider>(builder, linux_arm64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind<NativeAllocation::allocate>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "msvcrt.dll", export: "calloc" } });
    Build::bind<ProcessExit::exit_process>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "ExitProcess" } });
    Build::bind<NativeAllocation::allocate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5" } });
    Build::bind<ProcessExit::exit_process>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "exit", version: "GLIBC_2.2.5" } });
    Build::bind<NativeAllocation::allocate>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.17" } });
    Build::bind<ProcessExit::exit_process>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "exit", version: "GLIBC_2.17" } });
    Build::bind<NativeAllocation::allocate>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_calloc" } });
    Build::bind<ProcessExit::exit_process>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_exit" } });
}
