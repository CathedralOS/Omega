// Three members of mixed width pad as expected: `T` holds u8, u64, u8 —
// the u64 forces 7 padding bytes after the first member and 7 after the
// last, for a folded size of 24 at align 8.
data T {
    a: u8;
    b: u64;
    c: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<T>();
}
