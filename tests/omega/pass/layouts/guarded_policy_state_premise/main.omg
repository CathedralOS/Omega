// An unconditional policy enters a helper whose later state premise is
// discharged by a real guard; reflected policy admission must retain it.
use omega::language::core::layout;
use omega::language::core::float_operations;

public data Register { value: u64; }
public data CheckedPolicy {}
machine CheckedPolicy::limit(value: u64) -> u64 {
    transition value < 9 { true -> bounded(value)
        false -> 0 }
    machine bounded(value: u64) -> u64 requires value <= 8 { value }
}

machine CheckedPolicy::plan(schema: Schema) -> PlacementPlan {
    let size: u64 = CheckedPolicy::limit(8);
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let mut reach: BoundaryReach;
    PlacementPlan {
        layout: Plan {
            entries: entries, entry_count: 1,
            size_fixed: size, size_is_dynamic: false, align: 8,
        },
        access: AccessPlan::inaccessible(&schema),
        reach: reach,
    }
}
machine inspect(view: &mut Placed<CheckedPolicy, Register>) {}
machine main() {}

// This body is outside the demanded plan closure. Nested anonymous literal
// operations still belong to this body after contextual numeric coercion.
machine unrelated_reciprocal(value: f64) -> f64 {
    let inverse: f64 = 1.0 / value;
    let square: f64 = inverse * inverse;
    let series: f64 = inverse * (1.0 / 12.0 + square * (0.0 - 1.0 / 360.0 + square * (1.0 / 1260.0 + square * (0.0 - 1.0 / 1680.0 + square * (1.0 / 1188.0 - square * 691.0 / 360360.0)))));
    series
}
