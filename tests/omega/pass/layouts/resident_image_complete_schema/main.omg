// Checking probe: whole-value placement retains all represented fields,
// including inaccessible children, independently of accessor discovery.
// This does not assert that initialization has executed.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

data Empty {}
data Pair { low: u16; high: i16; }
data Payload {
    empty: Empty;
    tail: u32;
    values: [u16; 3];
    nested: Pair;
    flag: bool;
}
data PayloadPlacement {}

machine PayloadPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    // Empty has no physical slot. Authored entry order intentionally differs
    // from declaration order; the retained identity joins must survive it.
    entries[0] = FieldEntry {
        key: schema.fields[3].key,
        placement: FieldPlan::At { offset: 14 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 4 },
    };
    entries[2] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    entries[3] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::At { offset: 10 },
    };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan {
            entries: entries, entry_count: 4, size_fixed: 16,
            size_is_dynamic: false, align: 4,
        },
        access: AccessPlan::inaccessible(&schema),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine initialize(storage: Extent in Granted & Vacant, value: Payload)
    -> PlacementOutcome<
        Extent in Granted & Resident<PayloadPlacement, Payload>,
        PlacementReturn<Extent in Granted & Vacant, Payload>,
        PlacementInitializationFailure
    >
reaches ResourceProfileSupply
{
    NativePlacement<PayloadPlacement, Payload, TestMemory>::initialize(storage, value)
}

machine extract(storage: Extent in Granted & Resident<PayloadPlacement, Payload>)
    -> PlacementExtraction<Extent in Granted & Vacant, Payload>
reaches ResourceProfileSupply
{
    NativePlacement<PayloadPlacement, Payload, TestMemory>::move_out(storage)
}
