// A zero-length array member contributes nothing before a byte member:
// `Z` holds `[u8; 0]` then `u8` — the folded size is 1 byte at align 1,
// the empty array costing no padding either.
data Z {
    empty: [u8; 0];
    tag: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Z>();
}
