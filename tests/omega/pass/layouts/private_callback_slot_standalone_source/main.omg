// Standalone source is reconciled to an immutable anonymous package. A named
// FixedLayout policy and its exact private callback slot need no extra per-layout
// Build registration. Actual callback placement and publication still validate
// retained hermetic identities, exact policy/requirement joins and destination.
use omega::language::core::layout;

boundary trait WindowProcedure {
    machine call(message: u64) -> u64 reaches;
}


WndClassWindowProcedureSlot satisfies PrivateCallbackSlot<
    ForeignRecord, Spread,
    WindowProcedure::call
> { }

Spread satisfies FixedLayout<ForeignRecord> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let plan: LayoutPlan = LayoutPlan {
        entries: entries,
        entry_count: 1,
        size_fixed: 16,
        size_is_dynamic: false,
        align: 8,
    };
    LayoutPlan::place_private<WndClassWindowProcedureSlot>(plan, 8)
}
}

data ForeignRecord {
    payload: u64;
}

data Main {
    value: LayoutStorage<ForeignRecord, Spread>;
}

machine Main::main() {
}
