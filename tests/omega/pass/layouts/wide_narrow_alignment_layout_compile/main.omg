// Layout queries place narrow members after wide ones: `After` puts a
// `u8` trailing a `u64`, so the record is 16 bytes — the trailing member
// doesn't shrink the footprint.
data After {
    wide: u64;
    narrow: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<After>() - align_of<After>();
}
