use omega::language::core::layout;
// The code's low and high bits occupy different containers 299 bytes apart.
// Entries deliberately arrive out of source-bit order. The distant container
// is three bytes wide; a write must preserve its neighboring mode bits.
use omega_language_std::console;


SparseBits satisfies FixedLayout<PackedFlags> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 299, container_width: 24,
            destination_lsb: 16, source_lsb: 2, width: 2,
        },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::Bits {
            container: 299, container_width: 24,
            destination_lsb: 19, source_lsb: 0, width: 3,
        },
    };
    entries[2] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::Bits {
            container: 0, container_width: 8,
            destination_lsb: 7, source_lsb: 0, width: 1,
        },
    };
    entries[3] = FieldEntry {
        key: schema.fields[2].key,
        placement: FieldPlan::Bits {
            container: 0, container_width: 8,
            destination_lsb: 4, source_lsb: 0, width: 2,
        },
    };
    Plan {
        entries: entries, entry_count: 4,
        size_fixed: 302, size_is_dynamic: false, align: 1,
    }
}
}

data PackedFlags where mode <= 7, code <= 15 { present: bool; mode: u8; code: u8; }
data Main { packed: LayoutStorage<PackedFlags, SparseBits>; }

machine Main::main(main: &mut Main) reaches Console {
    main.packed.present = true;
    main.packed.mode = 5;
    main.packed.code = 15;
    main.packed.code = 2;
    transition main.packed.present == true {
        true -> check_mode(main)
        false -> bad(main)
    }
    machine check_mode(main: &mut Main) {
        transition main.packed.mode == 5 {
            true -> check_code(main)
            false -> bad(main)
        }
    }
    machine check_code(main: &mut Main) {
        transition main.packed.code == 2 {
            true -> good(main)
            false -> bad(main)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
