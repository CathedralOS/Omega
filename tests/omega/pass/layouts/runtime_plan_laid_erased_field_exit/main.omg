// Plan-laid relevance: `proof` remains a semantic field of Certified but is
// absent from reflected Schema and physical placement. The policy therefore
// sees two fields and places `right` at byte 16. Interpreter and native reads
// must agree after a whole-value copy.
use omega_language_std::console;

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField where size >= 0 && size <= 4096 && align >= 1 && align <= 16 {
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}
data Schema where field_count >= 0 && field_count <= 32 {
    fields: [SchemaField; 32];
    field_count: u64;
}
data FieldPlan {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, destination_lsb: u64, source_lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data Spread16 { index: u64 in Wrapping; }
machine Spread16::plan(spread16: &mut Spread16, schema: Schema) -> Plan {
    Spread16::evaluate(spread16, schema, 128)
}
machine Spread16::evaluate(spread16: &mut Spread16, schema: Schema, fuel: u64) -> Plan
requires fuel >= 1 && fuel <= 128
terminates by fuel;
{
    let mut entries: [FieldEntry; 64];
    spread16.index = 0;
    transition { _ -> fill(spread16, schema, fuel, entries) }
    state fill(spread16: &mut Spread16, schema: Schema, fuel: u64, entries: [FieldEntry; 64])
    requires fuel >= 1 && fuel <= 128 {
        transition fuel > 1 && spread16.index < schema.field_count {
            true -> place(spread16, schema, fuel - 1, entries)
            _ -> done(schema, entries)
        }
    }
    state place(spread16: &mut Spread16, schema: Schema, fuel: u64, entries: [FieldEntry; 64])
    requires fuel >= 1 && fuel <= 128 {
        let mut updated: [FieldEntry; 64] = entries;
        let offset: u64 = (spread16.index * 16) as u64;
        updated[spread16.index] = FieldEntry {
            key: schema.fields[spread16.index].key,
            placement: FieldPlan::At { offset: offset },
        };
        spread16.index = spread16.index + 1;
        transition fuel > 1 { true -> fill(spread16, schema, fuel - 1, updated) _ -> done(schema, updated) }
    }
    state done(schema: Schema, entries: [FieldEntry; 64]) -> Plan {
        Plan {
            entries: entries,
            entry_count: schema.field_count,
            size_fixed: schema.field_count * 16,
            size_is_dynamic: false,
            align: 16,
        }
    }
}

data Evidence [copy] { case Only; }
data Certified [copy] {
    left: u16;
    proof [erased]: Evidence;
    right: u32;
}

data Main {
    value: Spread16<Certified>;
    twin: Spread16<Certified>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.value.left = 7;
    main.value.right = 63;
    main.twin = main.value;
    transition main.twin.left == 7 && main.twin.right == 63 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
