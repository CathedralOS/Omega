// Alternating narrow and wide members pad repeatedly: `W` holds u8, u64,
// u8, u64 — each u64 forces 7 padding bytes after its predecessor, for a
// folded size of 32 at align 8.
data W {
    a: u8;
    b: u64;
    c: u8;
    d: u64;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<W>();
}
