// A returned placed view retains its original backing and interpretation.
// Expected exit: 0
use omega::language::core::layout;

public data Value { number: u64; }
public data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let mut services: [u64; 32];
    AccessPlan::with_reach(
        access,
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine borrow_view(value: &mut Value) -> &mut Access<StablePlacement, Value> {
    Access::view_mut<StablePlacement, Value>(value)
}

machine observe(view: &mut Access<StablePlacement, Value>) -> u64 {
    write(&mut view.number, 29u64);
    read(&view.number)
}

machine require_seventeen(value: u64)
requires value == 17
{}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    transition value.number == 17 {
        true -> inspect(value)
        _ -> wrong()
    }
    machine inspect(mut value: Value)
    requires value.number == 17
    {
        let observed: u64 = observe(borrow_view(&mut value));
        transition observed == 29 {
        true -> done()
        _ -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
