// Two f32 members pack without padding: `Pair` folds to 8 bytes at
// align 4 — the record's alignment follows its widest member, not the
// f64 default.
data Pair {
    first: f32;
    second: f32;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Pair>() - align_of<Pair>();
}
