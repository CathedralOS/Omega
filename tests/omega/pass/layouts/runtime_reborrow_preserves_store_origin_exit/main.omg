use omega::language::core::layout;
use omega_language_std::console;


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}

data PortableByte [copy] { value: i64; }
data Options { enabled: bool; }
data Record { options: Options; computed: i32; saved: i32; }
data Main { record: Record; packed: LayoutStorage<PortableByte, SignedByte>; }

machine encode(record: &mut Record) { record.computed = 70; }
machine prepare(record: &mut Record) {
    record.options = Options { enabled: false };
    encode(&mut record);
    record.saved = record.computed;
}

machine Main::main(context: &mut Main) reaches Console {
    prepare(&mut context.record);
    transition context.record.saved == 70 {
        true -> done(context)
        _ -> bad(context)
    }
    machine done(context: &mut Main) { Console::exit_process(70); }
    machine bad(context: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
