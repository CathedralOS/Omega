// Retaining a policy catalog does not demand its geometry on another target.
// The macOS member reads its actual authored offset; Windows never uses it.
// Expected exit: 0. The bad physical observation traps.
use omega::language::core::layout;

data Policy {}
data Payload [copy] { value: u32; }
data View { payload: Policy<Payload>; }

macos_arm64 machine Policy::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 4 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 4 }
}

machine observe(view: &View) -> u32 { view.payload.value }
machine program() crashes Trap { platform(); }
macos_arm64 machine platform() crashes Trap {
    let bytes: [u8; 8] = [17, 0, 0, 0, 34, 0, 0, 0];
    let view: &View = &bytes[0] as &View;
    transition observe(view) == 34 { true -> good() false -> bad() }
    state good() {}
    state bad() { crash Trap; }
}
windows_x86_64 machine platform() crashes Trap {}
