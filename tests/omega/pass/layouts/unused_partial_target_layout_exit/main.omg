// Retaining a policy catalog does not demand its geometry on another target.
// The macOS member reads its actual authored offset; Windows and Linux never use it.
// Expected exit: 0. The bad physical observation traps.
use omega::language::core::layout;

data Payload [copy] { value: u32; }
data View { payload: LayoutStorage<Payload, Policy>; }

Policy satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
        let facts: LayoutTargetFacts = layout_target_facts(&target);
        transition {
            facts.profile == "macos_arm64" -> on_macos_arm64(schema)
            _ -> unsupported_target()
        }
        machine on_macos_arm64(schema: Schema) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 4 } };
    LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 4 }
}
        machine unsupported_target() -> LayoutPlan reaches terminates; {
            let entries: [FieldEntry; 64];
            LayoutPlan { entries: entries, entry_count: 0, size_fixed: 0, size_is_dynamic: false, align: 0 }
        }
    }
}

machine observe(view: &View) -> u32 { view.payload.value }
machine program() crashes Trap { LayoutPlatform::platform(); }
boundary trait LayoutPlatform { machine platform() reaches crashes Trap; }
MacosArm64LayoutPlatform satisfies LayoutPlatform {
    machine platform() crashes Trap {
    let bytes: [u8; 8] = [17, 0, 0, 0, 34, 0, 0, 0];
    let view: &View = &bytes[0] as &View;
    transition observe(view) == 34 { true -> good() false -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
}
WindowsX8664LayoutPlatform satisfies LayoutPlatform {
    machine platform() crashes Trap {}
}
LinuxX8664LayoutPlatform satisfies LayoutPlatform {
    machine platform() crashes Trap {}
}
