// A `data where` clause adds no storage: `Band` declares three conjuncts
// and two u64 members — the invariant lives in the type's facts, not its
// bytes, so size_of folds to the plain record geometry.
data Band
requires
    a >= 1,
    b >= a,
    b <= 9,
{
    a: u64;
    b: u64;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Band>();
}
