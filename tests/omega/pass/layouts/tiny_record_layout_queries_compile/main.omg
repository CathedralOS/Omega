// Layout queries fold the narrowest members exactly: two `u8` fields give
// `Tiny` size 2 at align 1 — no padding, no wider member to lift the
// alignment.
data Tiny {
    first: u8;
    second: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Tiny>() - align_of<Tiny>();
}
