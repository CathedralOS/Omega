// A `[u64; 3]` member folds to 24 bytes at align 8 with no padding: the
// array's extent is count × element and the record inherits the member's
// own alignment.
data Triple {
    values: [u64; 3];
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Triple>();
}
