// A u8, u64, u8, u8 sequence pads twice: `Seq` lands its u64 at offset 8
// (7 pad bytes) and trails with two contiguous bytes — folded size 24 at
// align 8.
data Seq {
    a: u8;
    b: u64;
    c: u8;
    d: u8;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Seq>();
}
