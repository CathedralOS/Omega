// Layout queries fold inside contracts: `store` declares
// `requires size_of<Cell>() >= 8` — the extent of a record is a
// compile-time fact a `requires` clause can constrain against.
data Cell {
    code: u64;
    tag: u64;
}

data Main { stored: u64; }

machine Main::store(n: u64) -> u64
requires size_of<Cell>() >= 8
{
    n
}

machine Main::main(main: &mut Main) {
    main.stored = Main::store(70);
}
