// Transport of an existing indexed claim does not interpret its storage.
// No placement policy body or executable allocation is needed by this probe.
use omega::language::core::extent;

public data Word { value: u64; }
public data WordPlacement {}

machine forward<P, T>(storage: Extent in Granted & Resident<P, T>)
    -> Extent in Granted & Resident<P, T>
{
    storage
}

machine exercise(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> Extent in Granted & Resident<WordPlacement, Word>
{
    forward<WordPlacement, Word>(storage)
}
