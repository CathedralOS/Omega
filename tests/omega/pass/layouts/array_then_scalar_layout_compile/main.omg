// A `[u8; 3]` member doesn't force the record's trailing scalar into byte
// alignment: `Row` lays its `u32` at the next 4-aligned offset, so the
// folded size carries padding between the members.
data Row {
    flags: [u8; 3];
    count: u32;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Row>() - align_of<Row>();
}
