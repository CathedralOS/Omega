// A sum whose cases carry arrays folds each payload's full geometry:
// `Signal` chooses between `[u8; 4]` and `[u64; 1]` — its extent covers
// the discriminant plus the widest array (8 bytes either way, aligned
// by the u64 case).
data Signal {
    case Bytes(parts: [u8; 4]);
    case Word(parts: [u64; 1]);
}

data Main {
    extent: u64;
    alignment: u64;
}

machine Main::main(main: &mut Main) {
    main.extent = size_of<Signal>();
    main.alignment = align_of<Signal>();
}
