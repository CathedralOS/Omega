data Pair { left: u64; right: u32; }
machine size_of<Value>() -> u64 { 7 }
machine align_of() -> u64 { 3 }
machine main() crashes Trap {
    let size: u64 = size_of<Pair>();
    let alignment: u64 = align_of();
    transition size == 7 && alignment == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
