// Two i32 members pack contiguously: `Pair` folds to 8 bytes at align 4 —
// signed members carry the same width and alignment as their unsigned
// counterparts.
data Pair {
    first: i32;
    second: i32;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Pair>();
}
