// The ordinary policy checks the canonical identity payload's original <7
// bound. The reflection ABI remains Core's Optional<u64>; a false check
// supplies no required field placement and cannot establish LayoutStorage.
use omega::language::core::layout;
use omega::language::core::option;
Contiguous satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let allowed: bool = match schema.fields[0].identity {
            Optional::Some { value } -> value < 7u64
            Optional::None -> false
        };
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
        let count: u64 = match allowed { true -> 1u64 _ -> 0u64 };
        Plan { entries: entries, entry_count: count, size_fixed: 4, size_is_dynamic: false, align: 4 }
    }
}
data Payload { #6 value: u32; }
data View { payload: LayoutStorage<Payload, Contiguous>; }
machine main() { let view: View; }
