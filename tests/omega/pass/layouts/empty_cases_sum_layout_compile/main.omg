// Layout queries on a payload-free sum fold the discriminant alone:
// `Phase` has three empty cases, so its footprint is its tag — no payload
// contributes extent.
data Phase {
    case First;
    case Second;
    case Third;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Phase>() + align_of<Phase>();
}
