// RUN CANARY (exit 70) + interpreter differential. A shared record recast may
// contain a plan-laid subrecord: validation sizes the complete planned shape,
// native projection follows the baked field offsets, and the interpreter
// decodes the same offsets. The policy deliberately leaves gaps and disagrees
// with native packing (low @8, high @24); reading either field through native
// layout would observe zero and exit 71. This is the foreign-record view bridge
// used by the filesystem struct-stat migration.
use omega::language::std::console;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;

data Spread {
    entries: [FieldEntry; 64];
}

machine Spread::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    self.entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 24 },
    };
    Plan {
        entries: self.entries,
        entry_count: 2,
        size_fixed: 32,
        size_is_dynamic: false,
        align: 8,
    }
}

data ForeignRecord {
    low: u16;
    high: u64;
}

// The wrapper gives the recast a plain source-visible name while the inner
// value remains the policy-applied semantic record.
data ForeignView {
    value: Spread<ForeignRecord>;
}

data Main {
    console: Console;
    bytes: [u8; 32];
}

machine Main::main(&mut self) {
    self.bytes[8] = 30;
    self.bytes[24] = 40;
    let view: &ForeignView = &self.bytes[0] as &ForeignView;
    // Both uses occur in later local initializers. The native liveness pass
    // must still retain and initialize the recast's address-bearing slot.
    // Windows `struct stat` exposes narrow u16 fields that the portable
    // metadata record stores at a wider integer width. Pin both directions:
    // projected plan-laid scalars remain typed pointee loads through widening
    // and explicit narrowing conversions.
    let low: u64 = view.value.low as u64;
    let high: u16 = narrow_u64_to_u16_wrapping(view.value.high);
    transition low == 30 && high == 40 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
