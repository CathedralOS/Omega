// Two checked runtime selectors preserve nested record strides and field offsets.
data Byte where value >= 0 && value <= 1 { prefix: u64; value: u8; suffix: u32; }
data Row { cells: [Byte; 3]; tag: u64; }
data Main { rows: [Row; 2]; }
machine take(value: &u8) -> u8 { value }
machine inspect(main: &Main, row: u64, column: u64) -> u8 {
    transition row < 2 && column < 3 {
        true -> selected(main, row, column)
        _ -> 0
    }
    machine selected(main: &Main, row: u64, column: u64) -> u8 {
        take(&main.rows[row].cells[column].value)
    }
}
machine Main::main(main: &mut Main) crashes Trap {
    main.rows[1].cells[2].prefix = 123;
    main.rows[1].cells[2].value = 1;
    main.rows[1].cells[2].suffix = 456;
    main.rows[1].tag = 789;
    let chosen: u8 = inspect(main, 1, 2);
    let neighbor: u8 = inspect(main, 1, 1);
    let other_row: u8 = inspect(main, 0, 2);
    let outside: u8 = inspect(main, 1, 3);
    transition chosen == 1 && neighbor == 0 && other_row == 0 && outside == 0
        && main.rows[1].cells[2].prefix == 123
        && main.rows[1].cells[2].suffix == 456 && main.rows[1].tag == 789 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
