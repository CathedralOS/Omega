machine build(builder: &mut Build) {
    Build::package(builder, "resident_aggregate_extraction");
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, linux_arm64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, linux_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, macos_arm64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, macos_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, windows_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, uefi_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, cross_platform_cli);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, local_unchecked);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, alpha_bootstrap);
}
