// Embedding entry: extraction restores array and nested record cells from bytes.
// The host verifies the same vacant allocation and an unchanged unused tail.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

data Inner [linear] { number: u64; }
data Word [linear] { value: u64; values: [u64; 2]; nested: Inner; }
data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 24 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 3, size_fixed: 32, size_is_dynamic: false, align: 8 };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::inaccessible(layout),
        BoundaryReach { services: services, service_count: 0 }
    )
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

machine carry(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> Extent in Granted & Resident<WordPlacement, Word> { storage }

machine attempt(storage: Extent in Granted & Vacant, expected_reason: u64)
    -> AccessReturn<Extent in Granted & Vacant, Word>
reaches ResourceProfileSupply crashes Trap
{
    transition NativeAccess<WordPlacement, Word, TestMemory>::initialize(
        storage, Word { value: 17, values: [23, 29], nested: Inner { number: 31 } }
    ) {
        AccessOutcome::Ready { view } -> extract(view)
        AccessOutcome::Rejected { returned, reason } -> unexpected(returned)
    }
    machine extract(storage: Extent in Granted & Resident<WordPlacement, Word>)
        -> AccessReturn<Extent in Granted & Vacant, Word> {
        let retained: Extent in Granted & Resident<WordPlacement, Word> = carry(storage);
        transition NativeAccess<WordPlacement, Word, TestMemory>::move_out(retained) {
            AccessExtraction::Moved { storage, value } -> check_value(storage, value)
        }
    }
    machine check_value(storage: Extent in Granted & Vacant, value: Word)
        -> AccessReturn<Extent in Granted & Vacant, Word> {
        transition value.value == 17 && value.values[0] == 23 && value.values[1] == 29 && value.nested.number == 31 {
            true -> done(storage, value)
            false -> unexpected(AccessReturn { source: storage, custody: value })
        }
    }
    machine done(storage: Extent in Granted & Vacant, value: Word)
        -> AccessReturn<Extent in Granted & Vacant, Word> {
        AccessReturn { source: storage, custody: value }
    }
    machine unexpected(returned: AccessReturn<Extent in Granted & Vacant, Word>)
        -> AccessReturn<Extent in Granted & Vacant, Word> { crash Trap; }
}
