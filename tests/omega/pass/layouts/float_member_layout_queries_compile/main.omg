// Layout queries fold float members: `Reading` holds an f32 (4 bytes at
// align 4) and an f64 (8 bytes at align 8) — padding lands between them,
// folding to 16 bytes at align 8.
data Reading {
    precise: f64;
    rough: f32;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Reading>();
}
