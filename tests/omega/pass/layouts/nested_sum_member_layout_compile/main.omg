// Layout queries fold through member sums: `Holder` contains a `Step` sum
// plus a tag, so `size_of<Holder>()` is tag + discriminant + widest payload
// under the sum's own alignment — not just the tag.
data Step {
    case Count(count: u64);
    case Idle;
}

data Holder {
    tag: u32;
    step: Step;
}

data Main { extent: u64; }

machine Main::main(main: &mut Main) {
    main.extent = size_of<Holder>() + align_of<Holder>();
}
