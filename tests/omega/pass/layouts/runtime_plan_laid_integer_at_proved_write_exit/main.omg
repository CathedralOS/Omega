// The semantic field admits every i64, so its signed-byte encoding is not
// total. This concrete write is nevertheless safe because the source carries
// a checked declaration range wholly contained by signed 8-bit storage.
use omega_language_std::console;

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where
    size <= 4096,
    1 <= align,
    align <= 16,
{
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}
data Schema
where
    field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}

data PortableByte [copy] { value: i64; }
data RawView { value: SignedByte<PortableByte>; }
data Main
where
    -128 <= source,
    source <= 127,
{
    packed: SignedByte<PortableByte>;
    source: i64;
    flow_source: i64;
    bytes: [u8; 1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.source = -9;
    main.packed.value = main.source;
    transition main.flow_source >= -128 && main.flow_source <= 127 {
        true -> guarded_write(main)
        _ -> bad(main)
    }

    state guarded_write(main: &mut Main) {
        main.packed.value = main.flow_source;
        let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
        view.value.value = main.source;
        // `view` suspends the byte it covers until its last use, so the
        // owner's byte is read after it.
        transition main.packed.value == 0
            && view.value.value == -9
            && main.bytes[0] == 247 {
            true -> check_by_value(main)
            _ -> bad(main)
        }
    }

    state check_by_value(main: &mut Main) {
        transition main.packed.value == 0 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(72); }
    state bad(main: &mut Main) { Console::exit_process(73); }
}
