// A selected reference pins both immediate reborrow parents until its last use.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where size <= 4096, 1 <= align, align <= 16,
{ key: u64; size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
data PortableByte [copy] { value: i64; }
data RawView { value: SignedByte<PortableByte>; }
data Main { bytes: [u8; 2]; ordinary: i64; }

machine choose<'storage>(first: &'storage mut i64, second: &'storage mut i64, choose_second: bool) -> &'storage mut i64 {
    transition choose_second {
        true -> second
        _ -> first
    }
}
machine write_selected(first: &mut i64, second: &mut i64, choose_second: bool, value: i64) -> bool {
    let first_view: &mut i64 = &mut first;
    let second_view: &mut i64 = &mut second;
    let selected: &mut i64 = choose(first_view, second_view, choose_second);
    selected = value;
    // Both original parameters become readable after the selected child ends.
    first == -128 && (second == 257 || second == 127)
}

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[0] = 0;
    main.bytes[1] = 85;
    main.ordinary = 257;
    let first_view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let first: &mut i64 = &mut first_view.value.value;
    let first_restored: bool = write_selected(first, &mut main.ordinary, false, -128);
    let minimum: i64 = first;
    let untouched: i64 = main.ordinary;
    let second_restored: bool = write_selected(first, &mut main.ordinary, true, 127);
    transition first_restored && second_restored && minimum == -128 && untouched == 257 && main.bytes[0] == 128 && main.ordinary == 127 && main.bytes[1] == 85 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
