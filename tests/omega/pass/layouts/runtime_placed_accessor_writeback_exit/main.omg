// Expected exit: 0. Placed accessor writes affect their original RAM backing.
use omega::language::core::layout;

public data Registers where transmit <= 10 {
    status: u32;
    transmit: u8;
}

public data RegPlacement {}

machine RegPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        representation: FieldPlan::At { offset: 4 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries,
            entry_count: 2,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 4,
        };
    let access: AccessPlan = AccessPlan::inaccessible(layout);
    transition { _ -> place_status(schema, access) }

    machine place_status(
        schema: Schema,
        access: AccessPlan
    ) -> AccessPlan {
        let status_key: u64 = schema.fields[0].key;
        transition { _ -> place_transmit(
            schema,
            AccessPlan::with(
                access,
                status_key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            )) }
    }

    machine place_transmit(
        schema: Schema,
        access: AccessPlan
    ) -> AccessPlan {
        transition { _ -> finish(
            AccessPlan::with(
                access,
                schema.fields[1].key,
                FieldAccess::External {
                    read: ExternalRead::None,
                    write: true,
                    exposure: Exposure::Exported,
                },
            )) }
    }

    machine finish(
        access: AccessPlan
    ) -> AccessPlan {
        let mut services: [u64; 32];
        services[0] = 7;
        AccessPlan::with_reach(
            access,
            BoundaryReach {
                services: services,
                service_count: 0,
            }
        )
    }
}


machine mutate(view: &mut Access<RegPlacement, Registers>) -> u32 {
    transition { _ -> access(view) }
    machine access(view: &mut Access<RegPlacement, Registers>) -> u32 {
        view.transmit.write(&mut view.transmit, 9);
        view.status.read(&view.status)
    }
}
machine choose<'a>(left: &'a mut Access<RegPlacement, Registers>,
                   right: &'a mut Access<RegPlacement, Registers>,
                   first: bool) -> &'a mut Access<RegPlacement, Registers> {
    transition first {
        true -> left
        _ -> right
    }
}

machine exercise(first: bool) crashes Trap {
    let mut left: Registers = Registers { status: 41, transmit: 3 };
    let mut right: Registers = Registers { status: 73, transmit: 5 };
    let left_view: &mut Access<RegPlacement, Registers> = Access::view_mut<RegPlacement, Registers>(&mut left);
    let right_view: &mut Access<RegPlacement, Registers> = Access::view_mut<RegPlacement, Registers>(&mut right);
    let selected: &mut Access<RegPlacement, Registers> = choose(left_view, right_view, first);
    let observed: u32 = mutate(selected);
    transition first {
        true -> check(observed == 41 && left.transmit == 9 && right.transmit == 5)
        _ -> check(observed == 73 && left.transmit == 3 && right.transmit == 9)
    }
    machine check(correct: bool) {
        transition correct { true -> done() _ -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

machine main() crashes Trap {
    exercise(true);
    exercise(false);
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let view: &mut Access<RegPlacement, Registers> = Access::view_mut<RegPlacement, Registers>(&mut registers);
    let observed: u32 = mutate(view);
    transition observed == 41 && registers.transmit == 9 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
