// Each target closes layout queries against its own validated policy plan.
// Queries flow through a const, a returned value, a field, and a state
// parameter. Expected native exit: 0 on every bound target.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField where size <= 4096, 1 <= align, align <= 16 {
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}
data Schema where field_count <= 32 {
    fields: [SchemaField; 32];
    field_count: u64;
}
data FieldPlan {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, destination_lsb: u64, source_lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data Policy {}
data Payload [copy] { value: u32; }
macos_arm64 machine Policy::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 4 }
}
macos_arm64 machine expected_size() -> u64 { 8 }
linux_x86_64 machine Policy::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
}
linux_x86_64 machine expected_size() -> u64 { 4 }
linux_arm64 machine Policy::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 4 }
}
linux_arm64 machine expected_size() -> u64 { 8 }
windows_x86_64 machine Policy::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
}
windows_x86_64 machine expected_size() -> u64 { 4 }

const BYTES: u64 = size_of<Policy<Payload>>();
data View { payload: Policy<Payload>; observed: u64; }
machine query_size() -> u64 { size_of<Policy<Payload>>() }
// The same portable helper contract has applications in different authored
// target bodies. Every body is checked, even for a single-target product.
machine demand_eight() requires size_of<Policy<Payload>>() == 8 {}
machine demand_four() requires size_of<Policy<Payload>>() == 4 {}
macos_arm64 machine demand_layout() { demand_eight(); }
linux_arm64 machine demand_layout() { demand_eight(); }
linux_x86_64 machine demand_layout() { demand_four(); }
windows_x86_64 machine demand_layout() { demand_four(); }
machine program() crashes Trap {
    demand_layout();
    let mut view: View;
    view.observed = query_size();
    transition { _ -> inspect(&view, size_of<Policy<Payload>>()) }
    machine inspect(view: &View, extent: u64) {
        transition view.observed == expected_size() && extent == expected_size()
            && BYTES == expected_size() && align_of<Policy<Payload>>() == 4 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
