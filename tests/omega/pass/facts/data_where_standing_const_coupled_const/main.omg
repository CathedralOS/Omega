// The complete coupled predicate is discharged from the actual constant fields.
// Expected exit: 0
data Counter [copy]
where self.value <= self.ceiling && self.ceiling <= 60
{ value: i32; ceiling: i32; }
const NAMED: Counter = Counter { value: 40, ceiling: 60 };
public machine main() crashes Trap {
    transition NAMED.value == 40 && NAMED.ceiling == 60 { true -> done() false -> bad() }

    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
