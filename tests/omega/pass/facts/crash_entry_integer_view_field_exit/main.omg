// Expected exit: 0
machine maybe_zero(value: i64) -> i64
crashes Trap value == 0
{
    transition value == 0 { true -> bad() false -> (value) }
    machine bad() -> i64 { crash Trap; }
}
public data Packet { bits: u64; marker: u64; }
public machine read_bits(packet: &Packet) -> i64
requires packet.bits == 7
{
    let view: &i64 = &packet.bits as &i64;
    let observed: i64 = view;
    maybe_zero(observed)
}
machine main() crashes Trap {
    let packet: Packet = Packet { bits: 7, marker: 11 };
    let observed: i64 = read_bits(&packet);
    transition observed == 7 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
