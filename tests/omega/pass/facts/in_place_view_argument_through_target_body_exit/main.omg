// A shared byte view formed inside a constructed call argument borrows the caller's exact backing array for that invocation, so the callee proves its extent requirement from the formation and reads the authored bytes.
// Place: A Build-selected implementation receives the constructed argument.
// Expected exit: 0
data Input<'input> { tag: u8; bytes: &'input [u8]; tail: u8; }
boundary trait Reader {
    machine read_third<'input>(packet: Input<'input>) -> u8 reaches
    requires packet.bytes.len >= 4;
}
X86Reader satisfies Reader {
    machine read_third<'input>(packet: Input<'input>) -> u8
    requires packet.bytes.len >= 4 {
        transition packet.tag == 5 && packet.tail == 9 {
            true -> third(packet.bytes)
            false -> zero()
        }
        machine third(bytes: &[u8]) -> u8 requires bytes.len >= 4 { bytes[2] }
        machine zero() -> u8 { 0 }
    }
}
ArmReader satisfies Reader {
    machine read_third<'input>(packet: Input<'input>) -> u8
    requires packet.bytes.len >= 4 {
        transition packet.tag == 5 && packet.tail == 9 {
            true -> third(packet.bytes)
            false -> zero()
        }
        machine third(bytes: &[u8]) -> u8 requires bytes.len >= 4 { bytes[2] }
        machine zero() -> u8 { 0 }
    }
}
machine main() reaches Reader crashes Trap {
    let mut packet: [u8; 4];
    packet[0] = 11;
    packet[2] = 29;
    let third: u8 = Reader::read_third(Input { tag: 5, bytes: &packet, tail: 9 });
    let other: u8 = Reader::read_third(Input { tag: 6, bytes: &packet, tail: 9 });
    transition third == 29 && other == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
