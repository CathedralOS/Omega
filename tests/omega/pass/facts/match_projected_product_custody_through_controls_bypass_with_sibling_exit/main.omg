// An owned match carries its selected Payload, exact captured source and field projection, and complete residual cleanup roster through transport, then consumes the result with (left >> 4) ^ right.
// Place: local.
// Expected exit: 0
data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }

machine supply(first: u64, second: u64) -> Pair {
    Pair {
        first: Payload { left: first, right: second },
        second: Payload { left: second, right: first }
    }
}

machine fold(value: Payload) -> u64 {
    (value.left >> 4) ^ value.right
}

data Counter { value: u64 in Wrapping; }
data Watch dropped by release_watch { counter: &mut Counter; }
machine release_watch(watch: &mut Watch) {
    watch.counter.value = watch.counter.value + 1;
}
machine consume(pair: Pair, sibling: Watch, take: bool, selected: u64) -> bool {
    take && fold(match selected {
        0 -> pair.first,
        _ -> supply(4u64 ^ 255u64, 6u64 ^ 255u64).second
    }) == match selected { 0 -> 6 _ -> 244 }
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 0 };
    let skipped: bool = consume(supply(4, 6), Watch { counter: &mut counter }, false, 0);
    let selected_local: bool = consume(supply(4, 6), Watch { counter: &mut counter }, true, 0);
    let selected_call: bool = consume(supply(4, 6), Watch { counter: &mut counter }, true, 1);
    let skipped_call: bool = consume(supply(4, 6), Watch { counter: &mut counter }, false, 1);
    transition !skipped && selected_local && selected_call && !skipped_call && counter.value == 4 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
