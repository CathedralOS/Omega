machine build(builder: &mut Build) {
    Build::select_provider<SelectedExercise, CheckedExercise>(builder, linux_x86_64);
    Build::select_provider<SelectedExercise, CheckedExercise>(builder, linux_arm64);
    Build::select_provider<SelectedExercise, CheckedExercise>(builder, macos_arm64);
    Build::select_provider<SelectedExercise, CheckedExercise>(builder, windows_x86_64);

    Build::application(builder, "disjoint_field_borrow_windows_through_target_body_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
