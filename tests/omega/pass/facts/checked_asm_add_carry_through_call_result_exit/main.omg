// Expected exit: 0.
// Adding one to the all-ones u32 establishes addition flags 85 under mask 2261; a structured snapshot carries that image to a label.
machine capture() -> u64 ensures (result & 2261u64) == 85u64 {
 let mut snapshot: u64 = 0;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 4294967295;
  add eax, 1;
  pushfq snapshot;
  jmp observed;
 observed requires (snapshot & 2261u64) == 85u64:
  nop
 }
 snapshot
}

machine main() crashes Trap {
 let snapshot: u64 = capture();
 asm { observed requires (snapshot & 2261u64) == 85u64: nop }
 transition (snapshot & 2261u64) == 85u64 { true -> done() false -> bad() }
 state done() {}
 state bad() { crash Trap; }
}
