// Fact: adding two bounded unsigned u64 values (lhs >= 15u64 && lhs <= 40u64 and rhs >= 25u64 && rhs <= 50u64) establishes sum >= 40u64 && sum <= 90u64, discharging both 90u64 - sum and sum - 40u64 across all nine places.
// Place: const_name. Named constants establish the sum before discharging the subtraction bounds.
// Expected exit: 0

const LHS: u64 = 25u64;
const RHS: u64 = 35u64;
const SUM: u64 = LHS + RHS;

machine probe() -> i32 {
    let sum: u64 = SUM;
    let headroom: u64 = 90u64 - sum;
    let margin: u64 = sum - 40u64;
    0i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
