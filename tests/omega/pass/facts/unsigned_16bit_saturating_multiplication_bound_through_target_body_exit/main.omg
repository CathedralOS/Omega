windows_x86_64 machine sat_target(lhs: u16, rhs: u16) -> u16
requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
{
    let a: u16 in Saturating = lhs as u16 in Saturating;
    let b: u16 in Saturating = rhs as u16 in Saturating;
    let sat_prod: u16 in Saturating = a * b;
    let prod: u16 = sat_prod as u16;
    verify_prod(prod)
}

machine probe() -> u16 {
    sat_target(15u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
