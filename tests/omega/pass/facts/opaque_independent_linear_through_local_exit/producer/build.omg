machine build(builder: &mut Build) {
 Build::package(builder, "opaque_linear_address_producer");
 Build::select_representation<InternetAddress, AddressRepresentation>(builder);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, linux_arm64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, linux_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, macos_arm64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, macos_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, windows_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, uefi_x86_64);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, cross_platform_cli);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, local_unchecked);
 Build::select_provider<AddressBridge, AddressBridgeProvider>(builder, alpha_bootstrap);
 Build::bind(builder, linux_x86_64::ProgramEntry, component_entry);
 Build::bind(builder, linux_arm64::ProgramEntry, component_entry);
 Build::bind(builder, macos_arm64::ProgramEntry, component_entry);
 Build::bind(builder, windows_x86_64::ProgramEntry, component_entry);
}
