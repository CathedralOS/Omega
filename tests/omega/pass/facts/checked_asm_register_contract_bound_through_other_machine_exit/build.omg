machine build(builder: &mut Build) {
    Build::select_provider<SelectedReadAsm, LinuxX8664ReadAsm>(builder, linux_x86_64);
    Build::select_provider<SelectedReadAsm, LinuxX8664ReadAsm>(builder, windows_x86_64);
    Build::select_provider<SelectedReadAsm, LinuxArm64ReadAsm>(builder, linux_arm64);
    Build::select_provider<SelectedReadAsm, LinuxArm64ReadAsm>(builder, macos_arm64);

    Build::application(builder, "checked_asm_register_contract_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
