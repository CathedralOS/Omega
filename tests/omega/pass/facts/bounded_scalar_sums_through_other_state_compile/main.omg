// Another state receives u64 [0..=50] parameters and the sum still cannot overflow.
// Compile-checked only: no ProcessExit provider.
machine add(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=100] {
    transition { _ -> sum(a, b) }
    state sum(left: u64 [0..=50], right: u64 [0..=50]) -> u64 [0..=100] {
        left + right
    }
}

machine main() {
    let total: u64 [0..=100] = add(30, 40);
    transition total == 70 { true -> pass() _ -> fail() }
    state pass() {}
    state fail() {}
}
