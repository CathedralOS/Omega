// A finite-family method on a borrowed record returns a descriptor of the original backing, and reading its first byte yields 11.
// Expected exit: 0
// Place: parameter.
data Packet<'bytes> [copy] { bytes: &'bytes [u8]; }
trait Windowing {
    machine window<Width: u32>(source: &Packet) -> Packet
    requires Width == 16 || Width == 32;
}
Header satisfies Windowing {
    machine window<Width: u32>(source: &Packet) -> Packet
    requires Width == 16 || Width == 32 { Packet { bytes: source.bytes } }
}
machine dispatch(selected: dyn Windowing, source: &Packet, width: u32) -> Packet
requires width == 16 || width == 32 {
    Windowing::window<width>(selected, source)
}
machine check(packet: &Packet, width: u32, last: u8) crashes Trap
requires width == 16 || width == 32
{
    let selected: dyn Windowing = Header as dyn Windowing;
    let result: Packet = dispatch(selected, packet, width);
    transition result.bytes.len == 3 { true -> read(result, last) false -> bad() }
    machine read(result: Packet, last: u8) requires result.bytes.len == 3 {
        transition result.bytes[0] == 11 && result.bytes[2] == last { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine forward(packet: Packet, last: u8) crashes Trap { check(&packet, 16, last); check(&packet, 32, last); }
machine main() crashes Trap {
    let backing: [u8; 3] = [11, 22, 33];
    let alternate: [u8; 3] = [11, 44, 55];
    let packet: Packet = Packet { bytes: &backing[..] };
    let second: Packet = Packet { bytes: &alternate[..] };
    forward(packet, 33);
    forward(second, 55);
}
