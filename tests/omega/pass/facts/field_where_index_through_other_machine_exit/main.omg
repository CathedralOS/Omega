// Another machine receives the standing field and still discharges
// `arr[index + 1]`. `produced` ensures the where bound; `consumed`
// indexes under that bound.
//
// Expected exit: 0

data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine produced(main: &Main) -> u64
ensures 0 <= result && result <= 3
{
    main.k
}

machine consumed(main: &Main, index: u64) -> i32 in Wrapping
requires 0 <= index && index <= 3
{
    main.arr[index + 1]
}

machine use(main: &Main) -> i32 in Wrapping {
    consumed(main, produced(main))
}

machine Main::main(main: &mut Main) crashes Trap {
    main.arr = [10, 20, 30, 40, 50];
    main.k = 2;
    let first: i32 in Wrapping = use(main);
    transition { _ -> successor(main, first) }
    machine successor(main: &mut Main, first: i32 in Wrapping) {
        main.k = 3;
        let second: i32 in Wrapping = use(main);
        transition first == 40 && second == 50 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() {
        crash Trap;
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
