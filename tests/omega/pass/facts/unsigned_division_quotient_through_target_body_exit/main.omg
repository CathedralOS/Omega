// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Place: target_body. Ordinary named implementations selected by Build preserve the quotient bound.
// Expected exit: 0

boundary trait SelectedComputation {
    machine verify_target() -> i32;
}

X86Computation satisfies SelectedComputation {
    machine verify_target() -> i32 {
    let q: u64 = 400u64 / 4u64;
    let quotient: u64 = q;
    let diff: u64 = quotient - 100u64;
    diff as i32
}
}

ArmComputation satisfies SelectedComputation {
    machine verify_target() -> i32 {
    let q: u64 = 400u64 / 4u64;
    let quotient: u64 = q;
    let diff: u64 = quotient - 100u64;
    diff as i32
}
}



machine probe() -> i32 reaches SelectedComputation {
    SelectedComputation::verify_target()
}

machine main() reaches SelectedComputation crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
