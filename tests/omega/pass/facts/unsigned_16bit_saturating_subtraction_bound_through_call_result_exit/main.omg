// Fact: 16-bit unsigned saturating subtraction lhs -| rhs with bounded interval 200u16 <= diff <= 450u16 establishes 200u16 <= diff <= 450u16 across all nine places so exact subtractions 450u16 - diff and diff - 200u16 are safe.
// Expected exit: 0

machine verify_diff(diff: u16) -> i32
    requires diff >= 200 && diff <= 450
{
    let headroom: u16 = 450 - diff;
    let margin: u16 = diff - 200;
    let total: u16 = headroom + margin;
    let check: i32 = (total as i32) - 250;
    check
}

machine produce_diff(lhs: u16 in Saturating, rhs: u16 in Saturating) -> u16
    requires lhs as u16 >= 300 && lhs as u16 <= 500, rhs as u16 >= 50 && rhs as u16 <= 100
    ensures result >= 200 && result <= 450
{
    let sat: u16 in Saturating = lhs - rhs;
    sat as u16
}

machine main() crashes Trap {
    let lhs: u16 in Saturating = 400;
    let rhs: u16 in Saturating = 80;
    let diff: u16 = produce_diff(lhs, rhs);
    let check: i32 = verify_diff(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
