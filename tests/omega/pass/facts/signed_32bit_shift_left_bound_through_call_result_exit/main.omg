// Fact: a 32-bit signed i32 left shift of a bounded input (val >= 15i32 && val <= 15i32) by 2u32 bits establishes shifted >= 60i32 && shifted <= 60i32 so exact 32-bit signed subtraction shifted - 60i32 is proved overflow-free across all nine places.
// Place: call_result. The left-shifted result is returned from a callee invocation.
// Expected exit: 0
machine verify_shifted(shifted: i32) -> i32
    requires shifted >= 60 && shifted <= 60
{
    shifted - 60
}

machine shift_helper(v: i32) -> i32
    requires v >= 15 && v <= 15
    ensures result >= 60 && result <= 60
{
    v << 2u32
}

machine compute_call_result(val: i32) -> i32
    requires val >= 15 && val <= 15
{
    let shifted: i32 = shift_helper(val);
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_call_result(15)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
