// Fact: 8-bit unsigned bitwise XOR raw ^ 15u8 with bounded interval 40u8 <= xored <= 63u8 establishes 40u8 <= xored <= 63u8 across all nine places so exact subtractions 63u8 - xored and xored - 40u8 are safe.
// Place: parameter. The bitwise XOR result is forwarded as a machine parameter.
// Expected exit: 0
machine verify_xored(res: u8) -> i32
    requires res >= 40 && res <= 63
{
    let head: u8 = 63 - res;
    let tail: u8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

machine forward_param(s: u8) -> u8
    ensures result == s
{
    s
}

machine compute_parameter(raw: u8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = raw ^ 15;
    let transported: u8 = forward_param(xored);
    verify_xored(transported)
}

machine evaluate() -> i32 {
    compute_parameter(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
