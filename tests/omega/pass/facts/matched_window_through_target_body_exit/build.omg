machine build(builder: &mut Build) {
    Build::select_provider<SelectedFromTarget, CheckedFromTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedFromTarget, CheckedFromTarget>(builder, linux_arm64);
    Build::select_provider<SelectedFromTarget, CheckedFromTarget>(builder, macos_arm64);
    Build::select_provider<SelectedFromTarget, CheckedFromTarget>(builder, windows_x86_64);

    Build::application(builder, "matched_window_through_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
