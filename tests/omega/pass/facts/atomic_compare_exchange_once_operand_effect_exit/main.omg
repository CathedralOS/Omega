// Expected exit: 0.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::layout;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine replacement(cells: &Cells) -> u32 {
    cells.selected.store(20, NoOrdering);
    99
}
machine attempt(cells: &Cells) -> AtomicCompareExchangeOnceOutcome<u32> {
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(10, replacement(cells), ReceivePublish, Receive);
    outcome
}
machine probe(cells: &Cells) -> bool {
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    let snapshot: u32 = cells.selected.load(NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u32> = attempt(cells);
    let after: u32 = cells.selected.load(NoOrdering);
    let sibling: u32 = cells.untouched.load(NoOrdering);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == 20 && snapshot == 10 && after == 20 && sibling == 17)
        AtomicCompareExchangeOnceOutcome::Exchanged -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
