// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use omega::language::core::layout;
use omega::language::core::reflect;

public data Value { number: u64; }
public domain Value::StableAccess
    access StablePlacement;

StablePlacement satisfies AccessPolicy {
    machine plan(schema: reflect::TypeSchema) -> AccessPlan
    reaches
    terminates
    {
        let mut plan: AccessPlan = AccessPlan::new(&schema);
        AccessPlan::observe(
            &mut plan,
            reflect::field(Value::number),
            FieldAccess::Stable {
                read: true,
                take: false,
                write: true,
                swap: false,
                exposure: Exposure::Exported
            }
        );
        plan
    }
}


public boundary trait SelectedStableUpdate {
    machine update(view: &mut Value in StableAccess, other: &mut Value in StableAccess)
    reaches;
}

MacosStableUpdate satisfies SelectedStableUpdate {
    machine update(view: &mut Value in StableAccess, other: &mut Value in StableAccess) { write_pair(view, other); }
}

LinuxArmStableUpdate satisfies SelectedStableUpdate {
    machine update(view: &mut Value in StableAccess, other: &mut Value in StableAccess) { write_pair(view, other); }
}

LinuxX86StableUpdate satisfies SelectedStableUpdate {
    machine update(view: &mut Value in StableAccess, other: &mut Value in StableAccess) { write_pair(view, other); }
}

WindowsStableUpdate satisfies SelectedStableUpdate {
    machine update(view: &mut Value in StableAccess, other: &mut Value in StableAccess) { write_pair(view, other); }
}

machine write_pair(view: &mut Value in StableAccess, other: &mut Value in StableAccess) {
    let observed: u64 = other.number;
    view.number = 29u64;
}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    let mut companion: Value = Value { number: 43 };
    let companion_view: &mut Value in StableAccess = (&mut companion) as &mut Value in StableAccess;
    let view: &mut Value in StableAccess = (&mut value) as &mut Value in StableAccess;
    SelectedStableUpdate::update(view, companion_view);
    transition value.number == 29 && companion.number == 43 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
