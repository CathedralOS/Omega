// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u16 (narrow as u16) preserves the exact interval (wide >= 40u16 && wide <= 160u16), discharging exact 16-bit subtractions 160u16 - wide and wide - 40u16 across all nine places.
// Expected exit: 0

machine consume_wide(forwarded: u16) -> u16
    requires forwarded >= 40u16 && forwarded <= 160u16
{
    let headroom: u16 = 160u16 - forwarded;
    let margin: u16 = forwarded - 40u16;
    headroom + margin
}

machine probe(narrow: u8) -> u16
    requires narrow >= 40u8 && narrow <= 160u8
{
    let wide: u16 = narrow as u16;
    consume_wide(wide)
}

machine main() crashes Trap {
    let combined: u16 = probe(100u8);
    transition combined == 120u16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
