// Equal f64-in-Marked carriers. The selected body returns false, the direct comparison is false, and the match arm misses with result 11.
// Place: match_join.
// Expected exit: 0
domain f64::Marked;

machine == f64::Marked::same(left: f64 in Marked, right: f64 in Marked) -> bool {
    false
}

machine compare(left: f64 in Marked, right: f64 in Marked) -> bool {
    left == right
}

machine choose(value: f64 in Marked, pattern: f64 in Marked) -> u64 {
    match value { pattern -> 7, _ -> 11 }
}

machine hold(direct: bool) -> bool
requires direct == false
{
    true
}

machine main() crashes Trap {
    let flag: bool = true;
    let left: f64 in Marked = match flag { true -> 1.0, false -> 1.0 };
    let right: f64 in Marked = match flag { true -> 1.0, false -> 1.0 };
    let direct: bool = compare(left, right);
    let matched: u64 = choose(left, right);
    transition hold(direct) && matched == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
