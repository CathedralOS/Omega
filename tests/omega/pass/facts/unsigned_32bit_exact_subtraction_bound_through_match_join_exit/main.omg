// Fact: subtracting two bounded 32-bit unsigned u32 values (lhs >= 80u32 && lhs <= 120u32, rhs >= 20u32 && rhs <= 40u32) establishes the exact post-subtraction interval (diff >= 40u32 && diff <= 100u32), discharging exact 32-bit subtractions 100u32 - diff and diff - 40u32 across all nine places.
// Expected exit: 0

machine compute_diff(lhs: u32, rhs: u32) -> u32
    requires lhs >= 80 && lhs <= 120, rhs >= 20 && rhs <= 40
{
    lhs - rhs
}

machine verify_diff(diff: u32) -> i32
    requires diff >= 40 && diff <= 100
{
    let headroom: u32 = 100 - diff;
    let margin: u32 = diff - 40;
    let sum: i32 = (headroom as i32) + (margin as i32);
    let check: i32 = sum - 60;
    check
}

machine main() crashes Trap {
    let lhs: u32 = 100;
    let rhs: u32 = 30;
    let diff: u32 = compute_diff(lhs, rhs);
    let joined: u32 = match true {
        true -> diff
        _ -> diff
    };
    let check: i32 = verify_diff(joined);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
