machine build(builder: &mut Build) {
    Build::select_provider<SelectedRelay, CheckedRelay>(builder, linux_x86_64);
    Build::select_provider<SelectedRelay, CheckedRelay>(builder, linux_arm64);
    Build::select_provider<SelectedRelay, CheckedRelay>(builder, macos_arm64);
    Build::select_provider<SelectedRelay, CheckedRelay>(builder, windows_x86_64);

    Build::application(builder, "nominal_callback_reach_through_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
