// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Counter { spare: u64; count: u64; }
data Remaining { canary: u64; payload: Counter; }
machine count(counter: &mut u64, remaining: Remaining) crashes Trap
terminates;
terminates by remaining.payload.count;
requires remaining.payload.count <= 7;
{
    transition remaining.payload.count > 0 {
        true -> forward(remaining, counter)
        false -> finish(remaining.canary, remaining.payload.spare)
    }
    machine forward(pending: Remaining, counter: &mut u64) crashes Trap
    requires pending.payload.count > 0 && pending.payload.count <= 7;
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Remaining = Remaining { canary: pending.canary, payload: Counter { spare: pending.payload.spare, count: pending.payload.count - 1 } };
        transition { _ -> count(counter, next) }
    }
    machine finish(canary: u64, spare: u64) crashes Trap {
        transition canary == 641 && spare == 827 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let remaining: Remaining = match select {
        true -> Remaining { canary: 641, payload: Counter { spare: 827, count: 7 } }
        false -> Remaining { canary: 641, payload: Counter { spare: 827, count: 0 } }
    };
    count(counter, remaining);
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
