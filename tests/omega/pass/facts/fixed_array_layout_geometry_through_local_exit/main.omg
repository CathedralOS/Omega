// Fact: querying size_of and align_of on a four-element u64 fixed-size array ([u64; 4]) establishes its exact layout geometry (size == 32u64 and align == 8u64), discharging exact subtraction size - (align * 4u64) across all nine places.
// Place: local. The size and alignment queries are copied into locals before subtracting.
// Expected exit: 0

machine main() crashes Trap {
    let s: u64 = size_of<[u64; 4]>();
    let a: u64 = align_of<[u64; 4]>();
    let local_size: u64 = s;
    let local_align: u64 = a;
    let diff: u64 = local_size - (local_align * 4u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
