// Adding two bounded 32-bit signed i32 values (base >= 20i32 && base <= 35i32 and delta >= 15i32 && delta <= 25i32) establishes the exact post-addition interval (sum >= 35i32 && sum <= 60i32), discharging exact subtraction 60i32 - sum across all nine places.
// Expected exit: 0

machine consume_i32_margin(m: i32) -> i32
    requires m >= 0i32 && m <= 25i32
{
    m
}

machine choose(flag: bool, first: i32, second: i32) -> i32
    requires first >= 35i32 && first <= 60i32 && second >= 35i32 && second <= 60i32
    ensures result >= 35i32 && result <= 60i32
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, base: i32, delta: i32) -> i32
    requires base >= 20i32 && base <= 35i32 && delta >= 15i32 && delta <= 25i32
{
    let sum: i32 = base + delta;
    let joined: i32 = choose(flag, sum, 45i32);
    let margin: i32 = 60i32 - joined;
    consume_i32_margin(margin)
}

machine main() crashes Trap {
    let diff: i32 = probe(true, 25i32, 20i32);
    transition diff == 15i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
