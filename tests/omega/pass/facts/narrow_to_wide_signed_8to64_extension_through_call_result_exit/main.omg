// Fact: sign-extending a bounded 8-bit signed i8 value (narrow >= 30i8 && narrow <= 100i8) to i64 (narrow as i64) preserves the exact interval (wide >= 30i64 && wide <= 100i64), discharging exact 64-bit signed subtractions 100i64 - wide and wide - 30i64 across all nine places.
// Place: call_result. The sign-extended i64 value is returned from a callee invocation.
// Expected exit: 0
machine verify_wide(wide: i64) -> i32
    requires wide >= 30 && wide <= 100
{
    let headroom: i64 = 100 - wide;
    let margin: i64 = wide - 30;
    let diff: i64 = headroom - margin;
    (diff - 10) as i32
}

machine get_wide(narrow: i8) -> i64
    requires narrow >= 30 && narrow <= 100
    ensures result >= 30 && result <= 100
{
    narrow as i64
}

machine compute_call_result(narrow: i8) -> i32
    requires narrow >= 30 && narrow <= 100
{
    let transported: i64 = get_wide(narrow);
    verify_wide(transported)
}

machine evaluate() -> i32 {
    compute_call_result(60)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
