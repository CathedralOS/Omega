// Fact: sign-extending -28i8 to i64 and adding zero-extended 128u8 as i64 yields 100u64 when subtracting 100u64.
// Place: match join. Both arms produce the extended sum so the joined value preserves exact subtraction.
// Expected exit: 0

machine evaluate(flag: bool) -> i32 {
    let s: i64 = ((-28i8 as i16) as i32) as i64;
    let u: i64 = (((128u8 as u16) as u32) as u64) as i64;
    let sum: i64 = s + u;
    let val: u64 = sum as u64;
    let extended: u64 = match flag {
        true -> val
        false -> val
    };
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate(true);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
