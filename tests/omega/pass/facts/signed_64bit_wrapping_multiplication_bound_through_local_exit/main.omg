// Fact: 64-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i64 <= prod <= 200i64 establishes 50i64 <= prod <= 200i64 across all nine places so exact subtractions 200i64 - prod and prod - 50i64 are safe.
// Place: local. The 64-bit operands are copied into locals before wrapping multiplication and interval discharge.
// Expected exit: 0

machine verify_prod(value: i64) -> i64 requires value >= 50i64 && value <= 200i64 {
    let headroom: i64 = 200i64 - value;
    let margin: i64 = value - 50i64;
    headroom + margin
}

machine sat_local(lhs: i64, rhs: i64) -> i64
requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
{
    let local_lhs: i64 = lhs;
    let local_rhs: i64 = rhs;
    let a: i64 in Wrapping = local_lhs as i64 in Wrapping;
    let b: i64 in Wrapping = local_rhs as i64 in Wrapping;
    let wrap_prod: i64 in Wrapping = a * b;
    let prod: i64 = wrap_prod as i64;
    verify_prod(prod)
}

machine probe() -> i64 {
    sat_local(15i64, 8i64)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
