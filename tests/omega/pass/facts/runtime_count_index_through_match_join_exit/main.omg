// A match join of two copies of a runtime count still indexes a byte view.
// Expected exit: 0
machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

machine indexed(items: &[u8], count: u32, flag: bool) -> u8
requires count == 1 && count < items.len;
{
    let copy: u32 = count;
    let index: u32 = match flag { true -> count, false -> copy };
    read_at<index>(items)
}

machine main() crashes Trap {
    let bytes: [u8; 4] = [9, 8, 7, 6];
    transition indexed(&bytes[..], 1, true) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
