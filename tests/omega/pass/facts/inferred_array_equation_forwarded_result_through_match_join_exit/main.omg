// Fact: an omitted Capacity is inferred as 2 from the actual [u8; 2] type and Length == [u8; Capacity], independently of element values.
// Expected exit: 0
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine joined(flag: bool) -> u64 {
    let left: [u8; 2] = [7, 11];
    let right: [u8; 2] = [19, 23];
    let items: [u8; 2] = match flag { true -> left, false -> right };
    capacity(forward(items))
}
machine forward<Value [copy]>(value: Value) -> Value { value }
machine main() crashes Trap {
    let left_result: u64 = joined(true);
    let right_result: u64 = joined(false);
    transition left_result == 2 && right_result == 2 { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
