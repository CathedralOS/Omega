// A selected checked provider closes limit() to 7; requires value <= limit() carries that bound into exact subtraction 7 - value.
// Expected exit: 0
public boundary trait Endpoint {
    machine upper<const Nonce: u64>() -> u64 reaches terminates;
}
public Actual satisfies Endpoint {
    machine upper<const Nonce: u64>() -> u64 { 7 }
}
machine selected_limit<const Unused: u64>() -> u64 {
    Endpoint::upper<13u64>()
}
machine limit() -> u64 {
    selected_limit<0u64>()
}
machine bounded(value: u64) -> u64
requires value <= limit()
ensures result <= limit()
{ value }
public machine main() crashes Trap {
    let value: u64 = bounded(7);
    let difference: u64 = 7u64 - value;
    transition difference == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
