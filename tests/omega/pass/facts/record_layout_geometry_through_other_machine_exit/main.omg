// Fact: the validated byte size and alignment of a padded structural record and fixed array combine to 100u64 when subtracting 100u64.
// Expected exit: 0

data PaddedFrame {
    tag: u8;
    word: u64;
    tail: [u64; 9];
}

machine query_geometry() -> u64 {
    size_of<PaddedFrame>() + align_of<PaddedFrame>() + align_of<u32>()
}

machine runner() -> u64 {
    query_geometry() - 100u64
}

machine main() crashes Trap {
    let diff: u64 = runner();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
