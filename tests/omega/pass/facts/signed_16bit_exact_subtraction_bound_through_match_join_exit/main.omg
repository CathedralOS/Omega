// Fact: 16-bit signed exact subtraction lhs - rhs with 300i16 <= lhs <= 500i16 and 50i16 <= rhs <= 100i16 establishes 200i16 <= diff <= 450i16 so 450i16 - diff and diff - 200i16 are safe.
// Place: match join. The difference is synthesized across conditional match branches.
// Expected exit: 0

machine subtract_match_join(lhs: i16, rhs: i16, choose: bool) -> i32
    requires lhs >= 300i16 && lhs <= 500i16;
    requires rhs >= 50i16 && rhs <= 100i16;
{
    let diff: i16 = match choose {
        true -> lhs - rhs,
        false -> lhs - rhs
    };
    let headroom: i16 = 450i16 - diff;
    let margin: i16 = diff - 200i16;
    let check_h: u16 = headroom as u16;
    let check_m: u16 = margin as u16;
    transition diff == 320i16 && headroom + margin == 250i16 && check_h + check_m == 250u16 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = subtract_match_join(400i16, 80i16, true);
    let res2: i32 = subtract_match_join(400i16, 80i16, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
