// Fact: a runtime dyn trait selector dispatches an inline conformance member over explicit data arguments to establish 100u64 when subtracting 100u64.
// Place: local.
// Expected exit: 0

trait WeightedCombine {
    machine combine(left: u64, right: u64, observation: &mut u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
}

UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64, observation: &mut u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        observation = left;
        left + right
    }
}

OtherCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64, observation: &mut u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        observation = right;
        left + right
    }
}


machine probe(selected: dyn WeightedCombine, a: u64, b: u64, observation: &mut u64) -> u64
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
ensures result >= 100u64 && result <= 100u64
{
    let selector: dyn WeightedCombine = selected;
    WeightedCombine::combine(selector, a, b, observation)
}

machine main() crashes Trap {
    let first_selector: dyn WeightedCombine = UnitCombine as dyn WeightedCombine;
    let second_selector: dyn WeightedCombine = OtherCombine as dyn WeightedCombine;
    let mut first_observation: u64 = 0;
    let mut second_observation: u64 = 0;
    let first: u64 = probe(first_selector, 60u64, 40u64, &mut first_observation);
    let second: u64 = probe(second_selector, 60u64, 40u64, &mut second_observation);
    let first_difference: u64 = first - 100u64;
    let second_difference: u64 = second - 100u64;
    transition first_difference == 0u64 && second_difference == 0u64
        && first_observation == 60u64 && second_observation == 40u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
