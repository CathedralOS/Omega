// Fact: 8-bit signed bitwise AND mask raw & 63i8 with bounded interval 40i8 <= masked <= 63i8 establishes 40i8 <= masked <= 63i8 across all nine places so exact subtractions 63i8 - masked and masked - 40i8 are safe.
// Place: local. The masked value is transported through intermediate local bindings.
// Expected exit: 0

machine mask_local(raw: i8) -> i32
requires raw >= 116i8 && raw <= 116i8
{
    let r: i8 = raw;
    let m: i8 = r & 63i8;
    let masked: i8 = m;
    let headroom: i8 = 63i8 - masked;
    let margin: i8 = masked - 40i8;
    let check_h: u8 = headroom as u8;
    let check_m: u8 = margin as u8;
    transition masked == 52i8 && headroom + margin == 23i8 && check_h + check_m == 23u8 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine probe() -> i32 {
    mask_local(116i8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
