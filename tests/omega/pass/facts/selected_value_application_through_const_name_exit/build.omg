machine build(builder: &mut Build) {
    Build::application(builder, "selected_value_application");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::accept_boundary<SelectedValue>(builder);
    Build::select_provider<SelectedValue, SelectionAdapter>(builder, windows_x86_64);
    Build::select_provider<SelectedValue, SelectionAdapter>(builder, linux_x86_64);
    Build::select_provider<SelectedValue, SelectionAdapter>(builder, macos_arm64);
    Build::select_provider<SelectedValue, SelectionAdapter>(builder, linux_arm64);
}
