// An erased &i32 witness whose referent is 7 discharges witness == 7 at keep without a runtime witness argument, read, storage or cleanup.
// Expected exit: 0
machine keep(runtime: i32, witness [erased]: &i32) -> i32
requires witness == 7 { runtime }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSelected {
    machine selected(flag: bool) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Selected satisfies SelectedSelected {
    machine selected(flag: bool) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let runtime: i32 = match flag { true -> 41, false -> 42 };
        let value: i32 = 7;
        keep(runtime, &value)
    }
}

ArmSelected satisfies SelectedSelected {
    machine selected(flag: bool) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let runtime: i32 = match flag { true -> 41, false -> 42 };
        let value: i32 = 7;
        keep(runtime, &value)
    }
}


machine exercise(flag: bool) -> i32 {
    SelectedSelected::selected(flag)
}
machine verify(result: i32, flag: bool) crashes Trap {
    transition (flag && result == 41) || (!flag && result == 42) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine run(flag: bool) crashes Trap {
    let result: i32 = exercise(flag);
    verify(result, flag);
}
machine main() crashes Trap { run(true); run(false); }
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
