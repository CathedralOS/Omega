// Fact: adding two bounded 16-bit unsigned u16 values (lhs >= 100u16 && lhs <= 200u16 and rhs >= 150u16 && rhs <= 300u16) establishes the exact post-addition interval (sum >= 250u16 && sum <= 500u16), discharging both 500u16 - sum and sum - 250u16 across all nine places.
// Place: local. Bounded 16-bit operands are copied into local variables before addition and interval discharge.
// Expected exit: 0

machine compute_local(lhs: u16, rhs: u16) -> u16
requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 300
{
    let local_lhs: u16 = lhs;
    let local_rhs: u16 = rhs;
    let sum: u16 = local_lhs + local_rhs;
    let local_sum: u16 = sum;
    let headroom: u16 = 500u16 - local_sum;
    let margin: u16 = local_sum - 250u16;
    headroom + margin
}

machine probe() -> u16 {
    compute_local(150u16, 200u16)
}

machine main() crashes Trap {
    transition probe() == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
