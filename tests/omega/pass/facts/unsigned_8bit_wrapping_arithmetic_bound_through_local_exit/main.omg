// Fact: 8-bit unsigned wrapping addition lhs +% rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Expected exit: 0

machine compute_wrap(lhs: u8 in Wrapping, rhs: u8 in Wrapping) -> u8 in Wrapping {
    lhs + rhs
}

machine verify_sum(sum: u8) -> i32
    requires sum >= 50 && sum <= 100
{
    let headroom: u8 = 100 - sum;
    let margin: u8 = sum - 50;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

machine main() crashes Trap {
    let lhs: u8 in Wrapping = 60;
    let rhs: u8 in Wrapping = 15;
    let sum_wrapped: u8 in Wrapping = compute_wrap(lhs, rhs);
    let sum: u8 = sum_wrapped as u8;
    let local_sum: u8 = sum;
    let check: i32 = verify_sum(local_sum);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
