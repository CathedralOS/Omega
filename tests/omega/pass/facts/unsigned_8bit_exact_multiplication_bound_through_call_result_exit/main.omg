// Fact: an 8-bit unsigned u8 exact multiplication of bounded inputs (lhs >= 10u8 && lhs <= 15u8, rhs >= 8u8 && rhs <= 12u8) establishes prod >= 80u8 && prod <= 180u8 so exact 8-bit subtractions 180u8 - prod and prod - 80u8 are proved overflow-free across all nine places.
// Expected exit: 0

machine compute_prod(l: u8, r: u8) -> u8
    requires l >= 10u8 && l <= 15u8 && r >= 8u8 && r <= 12u8
    ensures result >= 80u8 && result <= 180u8
{
    l * r
}

machine probe(lhs: u8, rhs: u8) -> u8
    requires lhs >= 10u8 && lhs <= 15u8 && rhs >= 8u8 && rhs <= 12u8
{
    let prod: u8 = compute_prod(lhs, rhs);
    let headroom: u8 = 180u8 - prod;
    let margin: u8 = prod - 80u8;
    headroom + margin
}

machine main() crashes Trap {
    let combined: u8 = probe(12u8, 10u8);
    transition combined == 100u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
