// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u16 (narrow as u16) preserves the exact interval (wide >= 40u16 && wide <= 160u16), discharging exact 16-bit subtractions 160u16 - wide and wide - 40u16 across all nine places.
// Expected exit: 0

machine choose(flag: bool, first: u16, second: u16) -> u16
    requires first >= 40u16 && first <= 160u16 && second >= 40u16 && second <= 160u16
    ensures result >= 40u16 && result <= 160u16
{
    transition flag {
        true -> first
        false -> second
    }
}

machine probe(flag: bool, narrow: u8) -> u16
    requires narrow >= 40u8 && narrow <= 160u8
{
    let wide: u16 = narrow as u16;
    let joined: u16 = choose(flag, wide, 100u16);
    let headroom: u16 = 160u16 - joined;
    let margin: u16 = joined - 40u16;
    headroom + margin
}

machine main() crashes Trap {
    let combined: u16 = probe(true, 100u8);
    transition combined == 120u16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
