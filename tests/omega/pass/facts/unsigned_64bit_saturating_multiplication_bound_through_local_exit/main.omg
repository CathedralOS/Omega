// Fact: 64-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u64 <= prod <= 200u64 establishes 50u64 <= prod <= 200u64 across all nine places so exact subtractions 200u64 - prod and prod - 50u64 are safe.
// Place: local. The product is stored within an intermediate local variable before arithmetic interval checks.
// Expected exit: 0

machine multiply_local(lhs: u64, rhs: u64) -> i32
    requires lhs >= 10u64 && lhs <= 20u64;
    requires rhs >= 5u64 && rhs <= 10u64;
{
    let a: u64 in Saturating = lhs as u64 in Saturating;
    let b: u64 in Saturating = rhs as u64 in Saturating;
    let p_sat: u64 in Saturating = a * b;
    let prod: u64 = p_sat as u64;
    let stored_prod: u64 = prod;
    let headroom: u64 = 200u64 - stored_prod;
    let margin: u64 = stored_prod - 50u64;
    transition stored_prod == 120u64 && headroom + margin == 150u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_local(15u64, 8u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
