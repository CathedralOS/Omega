machine build(builder: &mut Build) {
    Build::select_provider<SelectedSplit, CheckedSplit>(builder, macos_arm64);
    Build::select_provider<SelectedSplit, CheckedSplit>(builder, linux_arm64);
    Build::select_provider<SelectedSplit, CheckedSplit>(builder, linux_x86_64);
    Build::select_provider<SelectedSplit, CheckedSplit>(builder, windows_x86_64);

    Build::application(builder, "address_interval_partition_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
