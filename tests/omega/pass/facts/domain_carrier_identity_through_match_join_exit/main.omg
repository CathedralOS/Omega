// Expected exit: 0
// A u16 value is a member of the u16 domain Small (self <= 10) only on its own u16 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

machine pick(high: bool) -> u16 ensures result in Small {
    transition high {
        true -> 7
        _ -> 2
    }
}

machine headroom(value: u16) -> u16 requires value in Small {
    10 - value
}

machine main() crashes Trap {
    transition headroom(pick(true)) == 3 && headroom(pick(false)) == 8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
