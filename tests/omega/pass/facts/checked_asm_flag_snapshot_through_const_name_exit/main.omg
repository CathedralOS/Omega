// Expected exit: 0.
// Subtraction establishes ZF; a structured snapshot carries that bit to a label.
const ZF_MASK: u64 = 64u64;

machine main() crashes Trap {
 let mut snapshot: u64 = 0;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 1;
  sub eax, 1;
  pushfq snapshot;
  jmp observed;
 observed requires (snapshot & ZF_MASK) == ZF_MASK:
  nop
 }
 transition (snapshot & ZF_MASK) == ZF_MASK { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
