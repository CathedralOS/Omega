// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
data Counter [copy]
where value <= 60,
{ value: i32; }
machine compute(counter: &Counter) -> i32 {
    let value: i32 = counter.value;
    70 + value
}
machine main() crashes Trap {
    let counter: Counter = Counter { value: 60 };
    let low: Counter = Counter { value: -2147483648 };
    transition compute(&counter) == 130 && compute(&low) == -2147483578 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
