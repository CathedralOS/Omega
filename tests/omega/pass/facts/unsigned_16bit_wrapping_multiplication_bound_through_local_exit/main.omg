// Fact: 16-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Place: local. The wrapping product is copied into a local before discharging subtraction bounds.
// Expected exit: 0

machine compute_local(lhs: u16, rhs: u16) -> i32
requires lhs >= 10u16 && lhs <= 20u16 && rhs >= 5u16 && rhs <= 10u16
{
    let w_lhs: u16 in Wrapping = lhs as u16 in Wrapping;
    let w_rhs: u16 in Wrapping = rhs as u16 in Wrapping;
    let prod_wrap: u16 in Wrapping = w_lhs * w_rhs;
    let prod: u16 = prod_wrap as u16;
    let p: u16 = prod;
    let headroom: u16 = 200u16 - p;
    let margin: u16 = p - 50u16;
    0i32
}

machine probe() -> i32 {
    compute_local(15u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
