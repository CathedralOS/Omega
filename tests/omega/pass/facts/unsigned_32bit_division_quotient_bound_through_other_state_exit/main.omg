// Fact: A 32-bit unsigned u32 division of bounded inputs (dividend >= 200u32 && dividend <= 200u32, divisor >= 4u32 && divisor <= 4u32) establishes quotient >= 50u32 && quotient <= 50u32 so exact 32-bit subtraction quotient - 50u32 is proved underflow-free across all nine places.
// Place: another state. A successor state receives the quotient and verifies the arithmetic interval.
// Expected exit: 0

machine divide_other_state(dividend: u32, divisor: u32) -> i32
    requires dividend >= 200u32 && dividend <= 200u32;
    requires divisor >= 4u32 && divisor <= 4u32;
{
    let quotient: u32 = dividend / divisor;
    transition {
        _ -> check_state(quotient)
    }
    machine check_state(q: u32) -> i32
        requires q >= 50u32 && q <= 50u32;
    {
        let check: u32 = q - 50u32;
        transition q == 50u32 && check == 0u32 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_other_state(200u32, 4u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
