// Expected exit: 0.
// A single-attempt exchange reports success or the instruction-observed failure value at its exact atomic cell.
use omega::language::core::layout;
data Cells { selected: AtomicU64; untouched: AtomicU64; }
machine attempt64(cells: &Cells, expected: u64) -> AtomicCompareExchangeOnceOutcome<u64> {
    let outcome: AtomicCompareExchangeOnceOutcome<u64> = cells.selected.compare_exchange_once(expected, 8589934691u64, ReceivePublish, Receive);
    outcome
}
machine probe(cells: &Cells) -> bool {
    cells.selected.store(4294967306u64, NoOrdering);
    cells.untouched.store(4294967313u64, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u64> = attempt64(cells, 4294967306u64);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Exchanged -> (cells.selected.load(NoOrdering) == 8589934691u64 && cells.untouched.load(NoOrdering) == 4294967313u64)
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (observed == 4294967306u64 && cells.selected.load(NoOrdering) == 4294967306u64 && cells.untouched.load(NoOrdering) == 4294967313u64)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(4294967306u64, NoOrdering);
    cells.untouched.store(4294967313u64, NoOrdering);
    let outcome: AtomicCompareExchangeOnceOutcome<u64> = attempt64(cells, 4294967305u64);
    transition outcome {
        AtomicCompareExchangeOnceOutcome::Mismatched { observed } -> (observed == 4294967306u64 && cells.selected.load(NoOrdering) == 4294967306u64 && cells.untouched.load(NoOrdering) == 4294967313u64)
        AtomicCompareExchangeOnceOutcome::Exchanged -> (false)
        AtomicCompareExchangeOnceOutcome::Uncommitted { observed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
