// Matching `Value::Integer` or `Value::Boolean` recovers `T == i32` or `T == bool` from the data's default domain, so the generic extractor `extract<T>(v: Value<T>) -> T` returns each payload as `T`, and the specialization for `Value<i32>` or `Value<bool>` keeps only the arm its instance admits.
// Expected exit: 0.
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine extract<T>(v: Value<T>) -> T {
    match v {
        Value::Integer { value } -> value
        Value::Boolean { value } -> value
    }
}
data Carrier [copy] { number: Value<i32>; flag: Value<bool>; }
machine number_of(carrier: Carrier) -> i32 { extract(carrier.number) }
machine flag_of(carrier: Carrier) -> bool { extract(carrier.flag) }
machine main() crashes Trap {
    let carrier: Carrier = Carrier {
        number: Value::Integer { value: 7 },
        flag: Value::Boolean { value: true }
    };
    let other: Carrier = Carrier {
        number: Value::Integer { value: 9 },
        flag: Value::Boolean { value: false }
    };
    transition number_of(carrier) == 7 && flag_of(carrier) == true
        && number_of(other) == 9 && flag_of(other) == false {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
