// Fact: a ten-argument weighted scalar call preserves exact positional argument order across register and stack ABI slots when subtracting 100u64.
// Place: const name. Named constants define the register and stack arguments.
// Expected exit: 0

const C1: u64 = 1;
const C2: u64 = 2;
const C3: u64 = 3;
const C4: u64 = 4;
const C5: u64 = 5;
const C6: u64 = 6;
const C7: u64 = 7;
const C8: u64 = 8;
const C9: u64 = 24;
const C10: u64 = 40;

machine weighted_ten_sum(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64
) -> u64
requires
    a1 == C1 && a2 == C2 && a3 == C3 && a4 == C4 && a5 == C5 &&
    a6 == C6 && a7 == C7 && a8 == C8 && a9 == C9 && a10 == C10
ensures
    result == 100u64
{
    a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10
}

machine probe() -> u64
ensures
    result == 0u64
{
    let total: u64 = weighted_ten_sum(C1, C2, C3, C4, C5, C6, C7, C8, C9, C10);
    total - 100
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
