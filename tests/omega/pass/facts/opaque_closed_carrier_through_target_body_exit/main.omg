linux_arm64 machine linux_arm64_host_binding() -> ForeignBinding<9, 10, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_lnaof", version: "GLIBC_2.17" } }
