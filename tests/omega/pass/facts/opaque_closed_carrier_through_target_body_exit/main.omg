}
windows_x86_64 machine host(address: InternetAddress) -> u32
    satisfies AddressParts::host via windows_x86_64_host_binding();


public data AddressBox { value: InternetAddress; }
public data AddressPair { first: InternetAddress; second: InternetAddress; }

machine consume(first: InternetAddress, second: InternetAddress) -> bool reaches AddressParts {
    let mut pair: AddressPair = AddressPair { first: first, second: second };
    let old_host: u32 = AddressParts::host(pair.first);
    pair.first = AddressParts::make(10, 1027);
    let sibling_host: u32 = AddressParts::host(pair.second);
    let replacement_host: u32 = AddressParts::host(pair.first);
    old_host == 66051 && sibling_host == 513 && replacement_host == 1027
}
linux_x86_64 machine observe() -> bool reaches AddressParts { consume(AddressParts::make(10, 66051), AddressParts::make(44048, 513)) }
linux_arm64 machine observe() -> bool reaches AddressParts { consume(AddressParts::make(10, 66051), AddressParts::make(44048, 513)) }
windows_x86_64 machine observe() -> bool reaches AddressParts { consume(AddressParts::make(10, 66051), AddressParts::make(44048, 513)) }
macos_arm64 machine observe() -> bool reaches AddressParts { consume(AddressParts::make(10, 66051), AddressParts::make(44048, 513)) }

machine main() reaches AddressParts crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 state done() {}
 state failed() { crash Trap; }
}
