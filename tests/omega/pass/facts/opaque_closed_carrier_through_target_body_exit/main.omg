windows_x86_64 machine windows_x86_64_make_binding() -> ForeignBinding<14, 13, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } }
}
windows_x86_64 machine make(network: u32, host: u32) -> InternetAddress
