// Fact: adding two bounded unsigned u64 values (lhs >= 15u64 && lhs <= 40u64 and rhs >= 25u64 && rhs <= 50u64) establishes sum >= 40u64 && sum <= 90u64, discharging both 90u64 - sum and sum - 40u64 across all nine places.
// Place: other_state. A successor state receives the sum and discharges the subtraction bounds.
// Expected exit: 0

machine verify_state(lhs: u64, rhs: u64) -> i32
requires lhs >= 15 && lhs <= 40 && rhs >= 25 && rhs <= 50
{
    transition {
        _ -> step(lhs + rhs)
    }
    state step(sum: u64) -> i32
    requires sum >= 40 && sum <= 90
    {
        let headroom: u64 = 90u64 - sum;
        let margin: u64 = sum - 40u64;
        0i32
    }
}

machine probe() -> i32 {
    verify_state(25u64, 35u64)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
