    let transported: DarwinFileTimes = times;
    transition transported[0].seconds == -17i64 && transported[0].nanoseconds == -2i64 && transported[1].seconds == 42i64 && transported[1].nanoseconds == -1i64 && FileTimesExchange::check(&transported) == 0u64 && size_of<DarwinFileTimes>() == 32u64 && align_of<DarwinFileTimes>() == 8u64 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
