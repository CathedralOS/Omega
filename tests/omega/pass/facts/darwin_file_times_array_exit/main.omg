    machine check(value: &DarwinFileTimes) -> u64 reaches;
}
machine main() reaches FileTimesExchange crashes Trap {
    let mut times: DarwinFileTimes;
    times[0].seconds = -17i64;
    times[0].nanoseconds = -2i64;
    times[1].seconds = 42i64;
