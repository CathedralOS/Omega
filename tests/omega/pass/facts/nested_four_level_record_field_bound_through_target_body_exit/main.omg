// Fact: a 4-level nested structural record RootRec { outer: Outer { mid: Middle { inner: Inner { val: u64 } } } } preserves the leaf field bound 40u64 <= root.outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: target_body. Each of four target bodies performs projection from nested record and discharges subtraction bounds.
// Expected exit: 0

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

data RootRec [copy] {
    outer: Outer;
}

machine verify_rec(r: RootRec) -> i32
requires r.outer.mid.inner.val >= 40u64 && r.outer.mid.inner.val <= 80u64
{
    let res: u64 = r.outer.mid.inner.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    0i32
}

linux_x86_64 machine verify_target() -> i32 {
    let r: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 60u64,
                },
            },
        },
    };
    verify_rec(r)
}

linux_arm64 machine verify_target() -> i32 {
    let r: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 60u64,
                },
            },
        },
    };
    verify_rec(r)
}

macos_arm64 machine verify_target() -> i32 {
    let r: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 60u64,
                },
            },
        },
    };
    verify_rec(r)
}

windows_x86_64 machine verify_target() -> i32 {
    let r: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 60u64,
                },
            },
        },
    };
    verify_rec(r)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
