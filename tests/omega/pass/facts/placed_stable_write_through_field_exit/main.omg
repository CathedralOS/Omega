// Fact: an exact permitted Stable field operation writes its original storage.
// Expected exit: 0
use omega::language::core::layout;

public data Value { number: u64; }
public data StablePlacement {}

machine StablePlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let mut services: [u64; 32];
    AccessPlan::with_reach(
        access,
        BoundaryReach { services: services, service_count: 0 }
    )
}

data Saved<'storage> { view: &'storage mut Access<StablePlacement, Value>; }

machine write_pair(view: &mut Access<StablePlacement, Value>, other: &mut Access<StablePlacement, Value>) {
    let observed: u64 = read(&other.number);
    write(&mut view.number, 29u64);
}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    let mut companion: Value = Value { number: 43 };
    let companion_view: &mut Access<StablePlacement, Value> = Access::view_mut<StablePlacement, Value>(&mut companion);
    let saved: Saved = Saved { view: Access::view_mut<StablePlacement, Value>(&mut value) };
    let view: &mut Access<StablePlacement, Value> = saved.view;
    write_pair(view, companion_view);
    transition value.number == 29 && companion.number == 43 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
