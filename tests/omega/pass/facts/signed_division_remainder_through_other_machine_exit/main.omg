// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Place: another machine. An intermediate machine forwards the operands to the indexing machine.
// Expected exit: 0

machine index_array(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 4i64
{
    let rem: i64 = dividend % divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

machine forward(dividend: i64, divisor: i64) -> u8
requires dividend >= 0i64 && divisor == 4i64
{
    index_array(dividend, divisor)
}

machine probe() -> u8 {
    forward(14i64, 4i64)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
