// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
machine count(counter: &mut u64, remaining: u64)
terminates
terminates by remaining
{
    transition remaining > 0 {
        true -> forward(counter, remaining)
        false -> done()
    }
    machine forward(counter: &mut u64, pending: u64)
    requires pending > 0
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        transition { _ -> count(counter, pending - 1) }
    }
    machine done() {}
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedPerform {
    machine perform(counter: &mut u64, select: bool)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Perform satisfies SelectedPerform {
    machine perform(counter: &mut u64, select: bool)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let remaining: u64 = match select { true -> 7 false -> 0 };
        count(counter, remaining);
    }
}

ArmPerform satisfies SelectedPerform {
    machine perform(counter: &mut u64, select: bool)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let remaining: u64 = match select { true -> 7 false -> 0 };
        count(counter, remaining);
    }
}


machine main() crashes Trap {
    let mut counted: u64 = 3;
    SelectedPerform::perform(&mut counted, true);
    let matched: bool = counted == 10;
    SelectedPerform::perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
