// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Place: match join. Both match arms yield bounded 16-bit operands and join before remainder and subtraction.
// Expected exit: 0

machine choose_divisor(flag: bool) -> u16
ensures result >= 16 && result <= 16
{
    match flag {
        true -> 16u16,
        false -> 16u16,
    }
}

machine rem_match_join(dividend: u16) -> u16
requires dividend >= 43 && dividend <= 43
{
    let divisor: u16 = choose_divisor(true);
    let rem: u16 = dividend % divisor;
    15u16 - rem
}

machine probe() -> u16 {
    rem_match_join(43u16)
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
