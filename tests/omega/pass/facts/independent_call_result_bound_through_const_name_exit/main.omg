// An independent completed call guarantees value == 7, so exact value - 7 is safe.
// Expected exit: 0
windows_x86_64 machine source(input: u64) -> u64 ensures result == FLOOR {
    7
}
linux_x86_64 machine source(input: u64) -> u64 ensures result == FLOOR {
    7
}
macos_arm64 machine source(input: u64) -> u64 ensures result == FLOOR {
    7
}
linux_arm64 machine source(input: u64) -> u64 ensures result == FLOOR {
    7
}
reserved_target machine source(input: u64) -> u64 ensures result == FLOOR {
    7
}
machine forwarded(input: u64) -> u64 ensures result == FLOOR { source(input) }
const FLOOR: u64 = 7;
machine evaluate() -> u64 { forwarded(3) - FLOOR }
machine main() crashes Trap {
    let difference: u64 = evaluate();
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
