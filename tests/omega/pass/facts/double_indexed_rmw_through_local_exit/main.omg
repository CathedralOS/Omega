// A const write of 41 at grid[1][2] becomes 42 after grid[i][j] = grid[i][j] + 1 with i == 1 and j == 2, and rows[2].data[1] becomes 42 after the same increment while rows[2].tag stays 7.
// Expected exit: 0
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
machine main() crashes Trap {
    let mut grid: [[i32 in Wrapping; 4]; 3];
    transition { _ -> grid_rmw(&mut grid, 1, 2) }
    machine grid_rmw(grid: &mut [[i32 in Wrapping; 4]; 3], i: u64, j: u64)
    requires i <= 2
    requires j <= 3 {
        grid[1][2] = 41;
        grid[i][j] = grid[i][j] + 1;
        let got: i32 in Wrapping = grid[1][2];
        transition got == 42 {
            true -> prepare_rows()
            false -> bad()
        }
    }
    machine prepare_rows() {
        let mut rows: [Row; 3];
        transition { _ -> member_rmw(&mut rows, 2, 1) }
    }
    machine member_rmw(rows: &mut [Row; 3], i: u64, rj: u64)
    requires i <= 2
    requires rj <= 1 {
        rows[2].data[1] = 41;
        rows[2].tag = 7;
        rows[i].data[rj] = rows[i].data[rj] + 1;
        let got: i32 in Wrapping = rows[2].data[1] + rows[2].tag;
        transition got == 49 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
