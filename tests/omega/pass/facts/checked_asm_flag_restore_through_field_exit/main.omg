// Expected exit: 0.
// Structured popfq restores a saved u64 flags place; the following label reads that place.
use omega::language::core::assembly;

data Flags { saved: u64; }

machine main() reaches MachineControl crashes Trap {
    let mut holder: Flags = Flags { saved: 0 };
    restore(&mut holder);
    transition (holder.saved & 64u64) == 64u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine restore(holder: &mut Flags) reaches MachineControl crashes Trap {
    asm where clobbers rax, rflags, r10, r15 {
        entry:
            mov eax, 1;
            sub eax, 1;
            pushfq holder.saved;
    }
    asm where clobbers r10, r15 {
        entry:
            popfq holder.saved;
        observed requires (holder.saved & 64u64) == 64u64:
            nop
    }
}
