// Fact: 64-bit signed bitwise XOR raw ^ 15i64 with bounded interval 40i64 <= xored <= 63i64 establishes 40i64 <= xored <= 63i64 across all nine places so exact subtractions 63i64 - xored and xored - 40i64 are safe.
// Place: match_join. Both match arms yield the bitwise XOR result so the joined binding preserves the bounds.
// Expected exit: 0
machine verify_xored(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

machine compute_match_join(raw: i64, flag: bool) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i64 = raw ^ 15;
    let joined: i64 = match flag {
        true -> xored
        false -> xored
    };
    verify_xored(joined)
}

machine evaluate() -> i32 {
    compute_match_join(59, true)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
