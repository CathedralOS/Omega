// Fact: a runtime dyn trait selector dispatches an inline conformance member over explicit data arguments to establish 100u64 when subtracting 100u64.
// Place: match_join.
// Expected exit: 0

trait WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
    machine marker() -> u64;
}
UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64 { left + right }
    machine marker() -> u64 { 11 }
}
OtherCombine satisfies WeightedCombine {
    machine combine(p: u64, q: u64) -> u64
    requires p >= 60u64 && p <= 60u64
    requires q >= 40u64 && q <= 40u64
    ensures result >= 100u64 && result <= 100u64 { q + p }
    machine marker() -> u64 { 13 }
}
machine accept(value: u64) requires value >= 100u64 && value <= 100u64 {}
machine probe(selected: dyn WeightedCombine, a: u64, b: u64) -> u64
requires a >= 59u64 && a <= 60u64
requires a + 1u64 >= 61u64
requires b >= 40u64 && b <= 40u64
ensures result >= 100u64 && result <= 100u64
{ WeightedCombine::combine(selected, a, b) }

machine choose(choice: u64) -> dyn WeightedCombine {
    match choice { 1 -> UnitCombine as dyn WeightedCombine _ -> OtherCombine as dyn WeightedCombine }
}
machine main() crashes Trap {
    let first: dyn WeightedCombine = choose(1);
    let second: dyn WeightedCombine = choose(2);
    let observed_first: u64 = probe(first, 60u64, 40u64);
    let observed_second: u64 = probe(second, 60u64, 40u64);
    accept(observed_first);
    let observed_first_difference: u64 = observed_first - 100u64;
    accept(observed_second);
    let observed_second_difference: u64 = observed_second - 100u64;
    let first_marker: u64 = WeightedCombine::marker(first);
    let second_marker: u64 = WeightedCombine::marker(second);
    transition observed_first_difference == 0u64 && observed_second_difference == 0u64 && first_marker == 11 && second_marker == 13 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
