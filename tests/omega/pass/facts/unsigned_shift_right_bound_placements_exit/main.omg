// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Placements: field, match_join, const_name.
// Each `<place>_placement` machine is the `main` of the former `unsigned_shift_right_bound_through_<place>_exit` fixture; `main` runs them in that order.
// Kept in its own fixture: target_body (`unsigned_shift_right_bound_through_target_body_exit`), which has its own build.omg.
// Kept in their own fixtures because they did not check on their own when this was written: local, parameter, call_result, other_state, other_machine.
// Expected exit: 0

// Placement: field.
// Place: field. Bounded record fields carry the u64 value and shift count into the shift.

data ShiftPayload requires val >= 400 && val <= 400 && shift >= 2 && shift <= 2 {
    val: u64;
    shift: u64;
}

machine shift_right_field(payload: ShiftPayload) -> u64
ensures result == 0
{
    let shifted: u64 = payload.val >> payload.shift;
    shifted - 100
}

machine field_placement() crashes Trap {
    let payload: ShiftPayload = ShiftPayload { val: 400, shift: 2 };
    let res: u64 = shift_right_field(payload);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// Placement: match_join.
// Place: match join. Both arms produce operands within bounds so the joined operands shift safely.

machine shift_right_match_join(flag: bool) -> u64
ensures result == 0
{
    let val: u64 = match flag {
        true -> 400
        false -> 400
    };
    let shift: u64 = match flag {
        true -> 2
        false -> 2
    };
    let shifted: u64 = val >> shift;
    shifted - 100
}

machine match_join_placement() crashes Trap {
    let res: u64 = shift_right_match_join(true);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// Placement: const_name.
// Place: const name. Named constants provide the bounded operand and shift count.

const BASE_VAL: u64 = 400;
const SHIFT_AMT: u64 = 2;

machine shift_right_const() -> u64
ensures result == 0
{
    let shifted: u64 = BASE_VAL >> SHIFT_AMT;
    shifted - 100
}

machine const_name_placement() crashes Trap {
    let res: u64 = shift_right_const();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    field_placement();
    match_join_placement();
    const_name_placement();
}
