// Fact: 8-bit signed bitwise XOR raw ^ 15i8 with bounded interval 40i8 <= xored <= 63i8 establishes 40i8 <= xored <= 63i8 across all nine places so exact subtractions 63i8 - xored and xored - 40i8 are safe.
// Place: target_body. Each hosted target body computes the 8-bit signed bitwise XOR and verifies the bounds.
// Expected exit: 0
machine verify_xored(res: i8) -> i32
    requires res >= 40 && res <= 63
{
    let head: i8 = 63 - res;
    let tail: i8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

linux_x86_64 machine compute_target_body(raw: i8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i8 = raw ^ 15;
    verify_xored(xored)
}

linux_arm64 machine compute_target_body(raw: i8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i8 = raw ^ 15;
    verify_xored(xored)
}

macos_arm64 machine compute_target_body(raw: i8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i8 = raw ^ 15;
    verify_xored(xored)
}

windows_x86_64 machine compute_target_body(raw: i8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i8 = raw ^ 15;
    verify_xored(xored)
}

machine evaluate() -> i32 {
    compute_target_body(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
