machine build(builder: &mut Build) {
    Build::select_provider<SelectedTake, CheckedTake>(builder, linux_x86_64);
    Build::select_provider<SelectedTake, CheckedTake>(builder, linux_arm64);
    Build::select_provider<SelectedTake, CheckedTake>(builder, macos_arm64);
    Build::select_provider<SelectedTake, CheckedTake>(builder, windows_x86_64);

    Build::application(builder, "call_result_bound_discharge_through_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
