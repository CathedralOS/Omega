// Every target body discharges a callee `requires` on a closed call
// result. `take` is the target-scoped callee; `opaque()`'s result 4
// proves `scale <= 5` in each body, which still discharges `echo`.
//
// Expected exit: 0

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

linux_x86_64 machine take(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}

linux_arm64 machine take(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}

macos_arm64 machine take(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}

windows_x86_64 machine take(scale: u64) -> u64
requires scale <= 5
{
    echo(scale)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;

    let s: u64 = opaque();
    let r: u64 = take(s);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
