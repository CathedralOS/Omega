// Fact: an unconsumed nominal resource whose drop contract requires valid == 1u64 executes deterministic affine scope-exit cleanup while preserving result <= 50u64 so 50u64 - result succeeds.
// Expected exit: 0

data Resource {
    valid: u64;
    value: u64;
}

machine Resource::drop(resource: &mut Resource)
requires resource.valid == 1u64
{
    resource.valid = 0u64;
}

machine verify(result: u64)
requires result <= 50u64
crashes Trap
{
    let diff: u64 = 50u64 - result;
    transition diff == 20u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

linux_x86_64 machine exercise(res: Resource)
requires res.valid == 1u64 && res.value <= 50u64
crashes Trap
{
    let val: u64 = res.value;
    verify(val);
}

linux_arm64 machine exercise(res: Resource)
requires res.valid == 1u64 && res.value <= 50u64
crashes Trap
{
    let val: u64 = res.value;
    verify(val);
}

macos_arm64 machine exercise(res: Resource)
requires res.valid == 1u64 && res.value <= 50u64
crashes Trap
{
    let val: u64 = res.value;
    verify(val);
}

windows_x86_64 machine exercise(res: Resource)
requires res.valid == 1u64 && res.value <= 50u64
crashes Trap
{
    let val: u64 = res.value;
    verify(val);
}

machine main() crashes Trap {
    let res: Resource = Resource { valid: 1u64, value: 30u64 };
    exercise(res);
}
