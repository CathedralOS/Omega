// Fact: zero-extending narrow unsigned 100u8 through u16 and u32 to u64 preserves the exact interval 100u64, discharging exact subtraction widened - 100u64 with exit code 0.
// Place: const name. A named constant provides the exact subtrahend for the zero-extended value.
// Expected exit: 0

const SUBTRAHEND: u64 = 100;

machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let extended: u64 = ((narrow as u16) as u32) as u64;
    let sub: u64 = extended - SUBTRAHEND;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
