// Fact: 32-bit unsigned saturating subtraction lhs -| rhs with bounded interval 40u32 <= diff <= 100u32 establishes 40u32 <= diff <= 100u32 across all nine places so exact subtractions 100u32 - diff and diff - 40u32 are safe.
// Place: another state. A successor state receives bounded 32-bit operands before saturating subtraction and interval discharge.
// Expected exit: 0

machine verify_diff(value: u32) -> u32 requires value >= 40u32 && value <= 100u32 {
    let headroom: u32 = 100u32 - value;
    let margin: u32 = value - 40u32;
    headroom + margin
}

machine sat_state(lhs: u32, rhs: u32) -> u32
requires lhs >= 80 && lhs <= 120 && rhs >= 20 && rhs <= 40
{
    transition {
        _ -> step(lhs, rhs)
    }
    machine step(l: u32, r: u32) -> u32
    requires l >= 80 && l <= 120 && r >= 20 && r <= 40
    {
        let a: u32 in Saturating = l as u32 in Saturating;
        let b: u32 in Saturating = r as u32 in Saturating;
        let sat_diff: u32 in Saturating = a - b;
        let diff: u32 = sat_diff as u32;
        verify_diff(diff)
    }
}

machine probe() -> u32 {
    sat_state(100u32, 30u32)
}

machine main() crashes Trap {
    transition probe() == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
