// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Place: call result. Contracted helper calls return bounded 16-bit operands before remainder and subtraction.
// Expected exit: 0

machine get_dividend() -> u16
ensures result >= 43 && result <= 43
{
    43u16
}

machine get_divisor() -> u16
ensures result >= 16 && result <= 16
{
    16u16
}

machine rem_call_result() -> u16 {
    let d: u16 = get_dividend();
    let s: u16 = get_divisor();
    let rem: u16 = d % s;
    15u16 - rem
}

machine probe() -> u16 {
    rem_call_result()
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
