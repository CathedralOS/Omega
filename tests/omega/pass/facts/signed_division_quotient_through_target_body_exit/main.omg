// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Place: target_body. Each of four target bodies performs the division and verifies the quotient.
// Expected exit: 0

linux_x86_64 machine verify_target() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    let quotient: i64 = q;
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

linux_arm64 machine verify_target() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    let quotient: i64 = q;
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

macos_arm64 machine verify_target() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    let quotient: i64 = q;
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

windows_x86_64 machine verify_target() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    let quotient: i64 = q;
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

machine probe() -> i32 {
    verify_target()
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
