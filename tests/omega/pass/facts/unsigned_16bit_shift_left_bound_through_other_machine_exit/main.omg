// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: another machine. The shifted value is forwarded to another machine for interval verification.
// Expected exit: 0

machine forward_eval(s: u16) -> i32
    requires s >= 120u16 && s <= 120u16;
{
    let check: u16 = s - 120u16;
    transition s == 120u16 && check == 0u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine shift_other_machine(val: u16) -> i32
    requires val >= 30u16 && val <= 30u16;
{
    let shifted: u16 = val << 2u16;
    forward_eval(shifted)
}

machine main() crashes Trap {
    let res: i32 = shift_other_machine(30u16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
