// Fact: querying size_of and align_of on a 64-bit slice view (&[u64]) establishes its exact two-word (ptr, len) descriptor geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: field. An enclosing structural carrier record holds the size and alignment in fields before subtracting.
// Expected exit: 0

data GeometryCarrier {
    size: u64;
    align: u64;
}

machine main() crashes Trap {
    let s: u64 = size_of<&[u64]>();
    let a: u64 = align_of<&[u64]>();
    let carrier: GeometryCarrier = GeometryCarrier { size: s, align: a };
    let diff: u64 = carrier.size - (carrier.align * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
