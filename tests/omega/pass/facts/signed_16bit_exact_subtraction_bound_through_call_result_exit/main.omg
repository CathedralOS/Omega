// Fact: 16-bit signed exact subtraction lhs - rhs with 300i16 <= lhs <= 500i16 and 50i16 <= rhs <= 100i16 establishes 200i16 <= diff <= 450i16 so 450i16 - diff and diff - 200i16 are safe.
// Place: call result. The difference is received from a helper call returning the subtraction result.
// Expected exit: 0

machine compute_diff(l: i16, r: i16) -> i16
    requires l >= 300i16 && l <= 500i16;
    requires r >= 50i16 && r <= 100i16;
    ensures result >= 200i16 && result <= 450i16;
{
    l - r
}

machine subtract_call_result(lhs: i16, rhs: i16) -> i32
    requires lhs >= 300i16 && lhs <= 500i16;
    requires rhs >= 50i16 && rhs <= 100i16;
{
    let diff: i16 = compute_diff(lhs, rhs);
    let headroom: i16 = 450i16 - diff;
    let margin: i16 = diff - 200i16;
    let check_h: u16 = headroom as u16;
    let check_m: u16 = margin as u16;
    transition diff == 320i16 && headroom + margin == 250i16 && check_h + check_m == 250u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = subtract_call_result(400i16, 80i16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
