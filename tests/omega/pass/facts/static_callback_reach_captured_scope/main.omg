// A static callback retains its exact selection and bounded reach through a conformance invocation; its transported result discharges 37 - result.
// Expected exit: 0
public boundary trait Console {}
public boundary trait Extra {}
public trait StepContract<Value> {
    machine step(value: u64) -> u64
    reaches Console terminates;
    requires value <= 37
    ensures result <= 37;
}
machine quiet(value: u64) -> u64
satisfies StepContract<u64>::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine second(value: u64) -> u64
satisfies StepContract<u64>::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine console_step(value: u64) -> u64
satisfies StepContract<u64>::step
reaches Console terminates;
requires value <= 37
ensures result <= 37
{ value }
trait Getter<Value> {
    machine get<machine Inner>(value: u64) -> u64
    where machine Inner satisfies StepContract<Value>::step;
    reaches Console blocks; terminates;
    requires value <= 37
    ensures result <= 37;
}
Selected<Value, machine Step> satisfies Getter<Value>
where machine Step satisfies StepContract<Value>::step;
{
    machine get<machine Inner>(value: u64) -> u64
    where machine Inner satisfies StepContract<Value>::step;
    requires value <= 37
    ensures result <= 37
    { let prefix: u64 = Step(value); Inner(prefix) }
}
machine choose<Operations satisfies Getter<u64>>(value: u64) -> u64
reaches Console blocks; terminates;
requires value <= 37
ensures result <= 37
{ block Operations::get<quiet>(value) }
machine main() reaches Console blocks; crashes Trap {
    let value: u64 = block choose<Selected<u64, quiet>>(37);
    let margin: u64 = 37 - value;
    let declared: u64 = block choose<Selected<u64, console_step>>(37);
    transition margin == 0 && declared == 37 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
