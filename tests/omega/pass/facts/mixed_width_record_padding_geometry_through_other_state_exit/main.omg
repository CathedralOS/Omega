// Fact: querying size_of and align_of on a mixed-width structural record (Padded { tag: u8, value: u64 }) establishes its exact 16-byte alignment-padded layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: another state. A successor state receives the size and alignment queries before subtracting.
// Expected exit: 0

data Padded {
    tag: u8;
    value: u64;
}

machine main() crashes Trap {
    let s: u64 = size_of<Padded>();
    let a: u64 = align_of<Padded>();
    transition true {
        true -> compute(s, a)
        _ -> bad()
    }
    machine compute(size: u64, align: u64) {
        let diff: u64 = size - (align * 2u64);
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
