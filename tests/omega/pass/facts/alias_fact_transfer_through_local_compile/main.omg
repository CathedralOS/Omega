// An entry requires on main.player transfers through a local alias.
// `let mut copy: Player` carries Alive into inspect's requires.
// Compile-checked only: no ProcessExit provider.

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive
{
    let mut copy: Player = main.player;
    Main::inspect(copy);
}
