// Expected exit: 0
data Carrier<'storage> { marker: i32; reference: &'storage i32; }
data Holder<'storage> { carrier: Carrier<'storage>; }
domain Carrier::Ready(carrier) requires carrier.marker == 41;
machine qualify<'storage>(holder: Holder<'storage>) -> Carrier<'storage> in Ready
requires holder.carrier.marker == 41
{
    let qualified: Carrier<'storage> in Ready = holder.carrier;
    qualified
}
machine qualified_same_source(choice: bool) crashes Trap {
    let backing: i32 = 42;
    let raw: Carrier = Carrier { marker: 41, reference: &backing };
    let qualified: Carrier in Ready = qualify(Holder { carrier: match choice {
        true -> raw as Carrier in Ready
        false -> raw as Carrier in Ready
    } });
    let observed: i32 = qualified.reference;
    transition observed == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine plain_same_source(choice: bool) crashes Trap {
    let backing: i32 = 42;
    let raw: Carrier = Carrier { marker: 41, reference: &backing };
    let qualified: Carrier in Ready = qualify(Holder { carrier: match choice {
        true -> raw
        false -> raw
    } });
    let observed: i32 = qualified.reference;
    transition observed == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine distinct_sources(choice: bool) crashes Trap {
    let backing: i32 = 42;
    let other_backing: i32 = 43;
    let other: Carrier = Carrier { marker: 41, reference: &other_backing };
    let raw: Carrier = Carrier { marker: 41, reference: &backing };
    let qualified: Carrier in Ready = qualify(Holder { carrier: match choice {
        true -> raw as Carrier in Ready
        false -> other as Carrier in Ready
    } });
    let observed: i32 = qualified.reference;
    transition observed == (match choice { true -> 42 false -> 43 }) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    qualified_same_source(true);
    qualified_same_source(false);
    plain_same_source(true);
    plain_same_source(false);
    distinct_sources(true);
    distinct_sources(false);
}
