// Expected exit: 0
// A two-child Tree constructor preserves Total <= 10 * Nodes; Nodes <= 8 proves exact 80u64 - Total.
data Tree<Nodes: u64, Total: u64> {
    case Empty where Nodes == 0 && Total == 0;
    case Fork(left_nodes: u64, left_total: u64, right_nodes: u64, right_total: u64, head: u64,
              left [erased]: Tree<left_nodes, left_total>, right [erased]: Tree<right_nodes, right_total>)
        where head <= 10 && embed(left_nodes) + embed(right_nodes) + 1 == embed(Nodes)
              && embed(left_total) + embed(right_total) + embed(head) == embed(Total);
}
machine tree_bound<Nodes: u64, Total: u64>(evidence [erased]: Tree<Nodes, Total>)
terminates by Nodes;
ensures embed(Total) <= 10 * embed(Nodes)
{
    transition evidence {
        Tree::Empty { .. } -> done()
        Tree::Fork { left_nodes, left_total, right_nodes, right_total, head, left, right, .. }
            -> step(left_nodes, left_total, right_nodes, right_total, head, left, right)
    }
    machine done() requires Nodes == 0 && Total == 0 {}
    machine step(left_nodes: u64, left_total: u64, right_nodes: u64, right_total: u64, head: u64,
               left [erased]: Tree<left_nodes, left_total>, right [erased]: Tree<right_nodes, right_total>)
    requires head <= 10 && embed(left_nodes) + embed(right_nodes) + 1 == embed(Nodes)
             && embed(left_total) + embed(right_total) + embed(head) == embed(Total)
    {
        tree_bound<left_nodes, left_total>(left);
        tree_bound<right_nodes, right_total>(right);
    }
}
machine bounded<Nodes: u64, Total: u64>(evidence [erased]: Tree<Nodes, Total>) -> u64
requires Nodes <= 8
{
    tree_bound<Nodes, Total>(evidence);
    80u64 - Total
}
machine joined(left [erased]: Tree<1, 2>, right [erased]: Tree<1, 4>) -> u64 {
    let fork [erased]: Tree<3, 7> = Tree::Fork {
        left_nodes: 1, left_total: 2, right_nodes: 1, right_total: 4, head: 1, left: left, right: right
    };
    bounded<3, 7>(fork)
}
machine main() crashes Trap {
    let left_zero_a [erased]: Tree<0, 0> = Tree::Empty;
    let left_zero_b [erased]: Tree<0, 0> = Tree::Empty;
    let right_zero_a [erased]: Tree<0, 0> = Tree::Empty;
    let right_zero_b [erased]: Tree<0, 0> = Tree::Empty;
    let left [erased]: Tree<1, 2> = Tree::Fork {
        left_nodes: 0, left_total: 0, right_nodes: 0, right_total: 0, head: 2, left: left_zero_a, right: left_zero_b
    };
    let right [erased]: Tree<1, 4> = Tree::Fork {
        left_nodes: 0, left_total: 0, right_nodes: 0, right_total: 0, head: 4, left: right_zero_a, right: right_zero_b
    };
    let result: u64 = joined(left, right);
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
