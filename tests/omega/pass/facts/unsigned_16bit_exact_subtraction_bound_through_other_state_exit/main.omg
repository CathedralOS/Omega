// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Place: other_state. A successor state receives the difference and discharges subtraction bounds.
// Expected exit: 0

machine verify_state(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 500u16 && rhs >= 50u16 && rhs <= 100u16
{
    transition {
        _ -> step(lhs - rhs)
    }
    state step(diff: u16) -> i32
    requires diff >= 200u16 && diff <= 450u16
    {
        let headroom: u16 = 450u16 - diff;
        let margin: u16 = diff - 200u16;
        0i32
    }
}

machine probe() -> i32 {
    verify_state(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
