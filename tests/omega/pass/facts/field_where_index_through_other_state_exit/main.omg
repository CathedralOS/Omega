// Another state receives the standing field and still discharges
// `arr[index + 1]`. The arrival requires is proved from `main.k`.
//
// Expected exit: 0

data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine use(main: &Main) -> i32 in Wrapping {
    transition { _ -> pick(main, main.k) }
    state pick(main: &Main, index: u64) -> i32 in Wrapping
    requires 0 <= index && index <= 3
    {
        main.arr[index + 1]
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.arr = [10, 20, 30, 40, 50];
    main.k = 2;
    let first: i32 in Wrapping = use(main);
    transition { _ -> successor(main, first) }
    state successor(main: &mut Main, first: i32 in Wrapping) {
        main.k = 3;
        let second: i32 in Wrapping = use(main);
        transition first == 40 && second == 50 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() {
        crash Trap;
    }
}
