// Fact: Adding two bounded 32-bit unsigned u32 values (lhs >= 20u32 && lhs <= 40u32 and rhs >= 30u32 && rhs <= 50u32) establishes the exact post-addition interval (sum >= 50u32 && sum <= 90u32), discharging both 90u32 - sum and sum - 50u32 across all nine places.
// Place: local. The bounded u32 operands and sum are transported through intermediate local bindings.
// Expected exit: 0

machine evaluate(lhs: u32, rhs: u32) -> i32
    requires lhs >= 20u32 && lhs <= 40u32;
    requires rhs >= 30u32 && rhs <= 50u32;
{
    let a: u32 = lhs;
    let b: u32 = rhs;
    let sum: u32 = a + b;
    let res: u32 = sum;
    let headroom: u32 = 90u32 - res;
    let margin: u32 = res - 50u32;
    transition res == 70u32 && headroom == 20u32 && margin == 20u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = evaluate(30u32, 40u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
