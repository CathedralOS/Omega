// Selection is unused; Inert admission still checks every closed payload.
use omega::language::core::representation;
use omega_language_std::console;
public boundary data Token;
public data Leaf { value: u32; }
public data Carrier<T> { case Empty; case Full(value: T); }
public Selected satisfies OpaqueRepresentation<Token, Carrier<Leaf>> {}
data Main {}
machine Main::main(main: &mut Main) reaches Console { Console::exit_process(70); }
