// Every target body indexes with the same proved parameter bound.
// Expected exit: 0.
boundary trait SelectedReadTarget {
    machine read_target(index: u64) -> u8 reaches
requires index < 3;
}
CheckedReadTarget satisfies SelectedReadTarget {
    machine read_target(index: u64) -> u8
requires index < 3
{
    let values: [u8; 3] = [7, 8, 9];
    values[index]
}
}




machine main() crashes Trap {
    transition SelectedReadTarget::read_target(1) == 8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
