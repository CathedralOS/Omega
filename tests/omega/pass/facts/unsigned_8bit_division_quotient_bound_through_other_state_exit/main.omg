// Fact: an 8-bit unsigned u8 division of bounded inputs (dividend >= 120u8 && dividend <= 120u8, divisor >= 4u8 && divisor <= 4u8) establishes quotient >= 30u8 && quotient <= 30u8 so exact 8-bit subtraction quotient - 30u8 is proved underflow-free across all nine places.
// Place: another state. A successor state receives the quotient and verifies the arithmetic interval.
// Expected exit: 0

machine divide_other_state(dividend: u8, divisor: u8) -> i32
    requires dividend >= 120u8 && dividend <= 120u8;
    requires divisor >= 4u8 && divisor <= 4u8;
{
    let quotient: u8 = dividend / divisor;
    transition {
        _ -> check_state(quotient)
    }
    machine check_state(q: u8) -> i32
        requires q >= 30u8 && q <= 30u8;
    {
        let check: u8 = q - 30u8;
        transition q == 30u8 && check == 0u8 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_other_state(120u8, 4u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
