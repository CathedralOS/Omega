// Expected exit: 0
// A u16 value is a member of the u16 domain Small (self <= 10) only on its own u16 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

data Reading [copy] { before: u16; level: u16; after: u16; }

machine headroom(reading: Reading) -> u16 requires reading.level in Small {
    10 - reading.level
}

machine main() crashes Trap {
    let reading: Reading = Reading { before: 41, level: 7, after: 43 };
    let other: Reading = Reading { before: 41, level: 2, after: 43 };
    transition headroom(reading) == 3 && headroom(other) == 8
        && reading.before == 41 && reading.after == 43 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
