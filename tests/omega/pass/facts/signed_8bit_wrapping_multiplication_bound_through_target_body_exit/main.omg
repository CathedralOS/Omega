windows_x86_64 machine compute_target_body(lhs: i8, rhs: i8) -> i8
    requires lhs >= 8 && lhs <= 12 && rhs >= 5 && rhs <= 8
{
    let a: i8 in Wrapping = lhs as i8 in Wrapping;
    let b: i8 in Wrapping = rhs as i8 in Wrapping;
    let wrapped: i8 in Wrapping = a * b;
    let prod: i8 = wrapped as i8;
    verify_prod(prod)
}

machine evaluate() -> i8 {
    compute_target_body(10, 7)
}

machine main() crashes Trap {
    let res: i8 = evaluate();
    transition res == 56 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
