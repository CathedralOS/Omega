// Fact: Initializing a destination storage slot through a write-only borrow (&write) establishes definite initialization and the post-write upper bound (written <= 95u64), discharging exact subtraction 95u64 - written across all nine places.
// Expected exit: 0

domain u64::WrittenBound
requires
    self <= 95u64;

data DestinationSlot {
    written: u64 in WrittenBound;
}

machine initialize_destination(destination: &write DestinationSlot) {
    destination.written = 35u64;
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine target_probe() -> u64
        reaches SelectedBodyCheck crashes Trap
        ensures
        result <= 95u64;
}

X86Probe satisfies SelectedProbe {
    machine target_probe() -> u64
        reaches SelectedBodyCheck crashes Trap
        ensures
        result <= 95u64
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut slot: DestinationSlot = DestinationSlot { written: 0u64 };
        initialize_destination(&write slot);
        95u64 - slot.written
    }
}

ArmProbe satisfies SelectedProbe {
    machine target_probe() -> u64
        reaches SelectedBodyCheck crashes Trap
        ensures
        result <= 95u64
    {
        SelectedBodyCheck::require_tag(29u64);
        let mut slot: DestinationSlot = DestinationSlot { written: 0u64 };
        initialize_destination(&write slot);
        95u64 - slot.written
    }
}









machine probe() -> u64
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
    ensures
    result <= 95u64
{
    SelectedProbe::target_probe()
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let diff: u64 = probe();
    transition diff == 60u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
