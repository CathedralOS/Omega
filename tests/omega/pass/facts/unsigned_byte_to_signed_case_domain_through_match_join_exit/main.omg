// Fact: widening an observed u8 to an i32 payload preserves 0..255 in ByteParcel::Byte, so 255 - value remains exact through transport.
// Place: match_join
// Expected exit: 0

public data ByteParcel [copy]
requires (self in ByteParcel::Empty) || ((self in ByteParcel::Byte) && self.value >= 0 && self.value <= 255)
{
    case Empty;
    case Byte(value: i32);
}
public machine make(byte: u8) -> ByteParcel {
    ByteParcel::Byte { value: byte as i32 }
}
public machine consume(parcel: ByteParcel) -> i32 {
    transition parcel {
        ByteParcel::Byte { value } -> (255 - value)
        ByteParcel::Empty -> (-1)
    }
}
public machine choose(selected: bool, byte: u8) -> ByteParcel {
    match selected { true -> make(byte) false -> ByteParcel::Empty }
}
machine main() crashes Trap {
    let first: i32 = consume(choose(true, 128u8));
    let second: i32 = consume(choose(true, 255u8));
    transition first == 127 && second == 0 && consume(choose(false, 128u8)) == -1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
