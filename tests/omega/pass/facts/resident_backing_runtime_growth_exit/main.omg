// Expected exit: 0
// A granted vacant extent retains actual backing through transport, initialization, permitted writes, and extraction.
// Runtime-sized cell partitions preserve the descriptor, not the old contents.
use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::VacantContentTransfer;
use omega::language::core::VacantExtentParts;
use omega::language::core::split_vacant_extent;
use omega::language::core::merge_vacant_extents;
use omega::language::core::Extent::Granted;
use omega::language::core::Granted::content;
use omega::language::core::ExtentRootProvider;
use omega::language::core::IntervalSet;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::RelativeRange;
use omega::language::core::StableCapability;
use omega::language::core::ExternalCapability;
use omega::language::core::AtomicCapability;
use omega::language::core::PeerWritability;
use omega::language::core::ResourceRegion;
use omega::language::core::ResourceProfile;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::Access;
use omega::language::core::AccessOutcome;
use omega::language::core::Access::view_extent;
use omega::language::core::Access::view_extent_mut;
use omega::language::core::read;
use omega::language::core::write;
use omega::language::core::ProcessExit;
use alloc::bump;
use omega::language::core::Nat;


data TestMemory {}
public data Word { value: u32; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 };
    AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported })
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

boundary trait NativeAllocation {
    machine allocate(count: u64, width: u64) -> addr reaches;
}
TestRoots satisfies ExtentRootProvider {
    machine grant(root: Extent) -> Extent { root }
}
TestVacant satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
        ensures result in Granted,
            core::Identity<IntervalSet<Nat>>(
                Granted::content(old(&storage)),
                Granted::content(&result)
            )
    { storage as Extent }
}

data Observed { storage: Extent in Granted & Vacant; value: u32; }

machine exchange_cell(storage: &mut Extent in Granted & Vacant, value: u32) -> u32
crashes Trap
{
    transition Access::view_extent_mut<WordPlacement, Word, TestMemory>(storage as &mut Extent in Granted) {
        AccessOutcome::Ready { view } -> change(view, value)
        AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine change(view: &mut Access<WordPlacement, Word>, value: u32) -> u32 {
        let previous: u32 = read(&view.value);
        write(&mut view.value, value);
        previous
    }
    machine bad() -> u32 { crash Trap; }
}

machine exchange(storage: Extent in Granted & Vacant, offset: u64, value: u32) -> Observed
requires storage.length >= 4, offset <= storage.length - 4
ensures result.storage.base == storage.base, result.storage.length == storage.length
crashes Trap
{
    let prefix: VacantExtentParts = split_vacant_extent(storage, offset);
    let element: VacantExtentParts = split_vacant_extent(prefix.rest, 4);
    let mut cell: Extent in Granted & Vacant = element.taken;
    let previous: u32 = exchange_cell(&mut cell, value);
    let suffix: Extent in Granted & Vacant = merge_vacant_extents(cell, element.rest);
    let whole: Extent in Granted & Vacant = merge_vacant_extents(prefix.taken, suffix);
    Observed { storage: whole, value: previous }
}


data Vec
requires self.len <= self.capacity, self.capacity <= 4611686018427387903,
    self.storage.length == self.capacity * 4
{
    storage: Extent in Granted & Vacant;
    len: u64;
    capacity: u64;
}

machine Vec::open(storage: Extent in Granted & Vacant, capacity: u64) -> Vec
requires capacity <= 4611686018427387903, storage.length == capacity * 4
ensures result.len == 0, result.capacity == capacity,
    result.storage.base == storage.base, result.storage.length == storage.length
{ Vec { storage: storage, len: 0, capacity: capacity } }

machine Vec::push(vec: Vec, value: u32) -> Vec
requires vec.len < vec.capacity
ensures result.len == vec.len + 1, result.capacity == vec.capacity,
    result.storage.base == vec.storage.base, result.storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.len;
    let capacity: u64 = vec.capacity;
    let storage: Extent in Granted & Vacant = vec.storage;
    let changed: Observed = exchange(storage, length * 4, value);
    Vec { storage: changed.storage, len: length + 1, capacity: capacity }
}

machine inspect_cell(storage: &Extent in Granted & Vacant) -> u32 crashes Trap {
    transition Access::view_extent<WordPlacement, Word, TestMemory>(storage as &Extent in Granted) {
        AccessOutcome::Ready { view } -> read(&view.value)
        AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine bad() -> u32 { crash Trap; }
}

machine inspect(storage: Extent in Granted & Vacant, offset: u64) -> Observed
requires storage.length >= 4, offset <= storage.length - 4
ensures result.storage.base == storage.base, result.storage.length == storage.length
crashes Trap
{
    let prefix: VacantExtentParts = split_vacant_extent(storage, offset);
    let element: VacantExtentParts = split_vacant_extent(prefix.rest, 4);
    let cell: Extent in Granted & Vacant = element.taken;
    let value: u32 = inspect_cell(&cell);
    let suffix: Extent in Granted & Vacant = merge_vacant_extents(cell, element.rest);
    let whole: Extent in Granted & Vacant = merge_vacant_extents(prefix.taken, suffix);
    Observed { storage: whole, value: value }
}

data Read { vec: Vec; value: u32; }
machine Vec::get(vec: Vec, index: u64) -> Read
requires index < vec.len
ensures result.vec.len == vec.len, result.vec.capacity == vec.capacity,
    result.vec.storage.base == vec.storage.base, result.vec.storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.len;
    let capacity: u64 = vec.capacity;
    let storage: Extent in Granted & Vacant = vec.storage;
    let observed: Observed = inspect(storage, index * 4);
    Read { vec: Vec { storage: observed.storage, len: length, capacity: capacity }, value: observed.value }
}

data Copied {
    original: Extent in Granted & Vacant;
    replacement: Extent in Granted & Vacant;
}

machine copy_prefix(original: Extent in Granted & Vacant, replacement: Extent in Granted & Vacant,
    count: u64, remaining: u64) -> Copied
requires count <= 4611686018427387903, remaining <= count,
    original.length >= count * 4, replacement.length >= count * 4
ensures result.original.base == original.base, result.original.length == original.length,
    result.replacement.base == replacement.base, result.replacement.length == replacement.length
terminates by remaining
crashes Trap
{
    transition remaining > 0 {
        true -> step(original, replacement, count, remaining)
        false -> Copied { original: original, replacement: replacement }
    }
    machine step(original: Extent in Granted & Vacant, replacement: Extent in Granted & Vacant,
        count: u64, remaining: u64) -> Copied
    requires remaining > 0, count <= 4611686018427387903, remaining <= count,
        original.length >= count * 4, replacement.length >= count * 4
    ensures result.original.base == original.base, result.original.length == original.length,
        result.replacement.base == replacement.base, result.replacement.length == replacement.length
    {
        let offset: u64 = (count - remaining) * 4;
        let observed: Observed = inspect(original, offset);
        let changed: Observed = exchange(replacement, offset, observed.value);
        transition { _ -> copy_prefix(observed.storage, changed.storage, count, remaining - 1) }
    }
}

data Growth { vec: Vec; retired_storage: Extent in Granted & Vacant; }
machine verify_vector(storage: &Extent in Granted & Vacant, length: u64, capacity: u64)
requires length <= capacity, capacity <= 4611686018427387903, storage.length == capacity * 4 {}
machine Vec::grow(vec: Vec, replacement: Extent in Granted & Vacant, capacity: u64)
    -> Growth
requires capacity <= 4611686018427387903, capacity >= vec.len,
    replacement.length == capacity * 4
ensures result.vec.len == vec.len, result.vec.capacity == capacity,
    result.vec.storage.base == replacement.base, result.vec.storage.length == replacement.length,
    result.retired_storage.base == vec.storage.base, result.retired_storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.len;
    let original: Extent in Granted & Vacant = vec.storage;
    let copied: Copied = copy_prefix(original, replacement, length, length);
    verify_vector(&copied.replacement, length, capacity);
    let grown: Vec = Vec { storage: copied.replacement, len: length, capacity: capacity };
    Growth { vec: grown, retired_storage: copied.original }
}

machine Vec::close(vec: Vec) -> Extent in Granted & Vacant
ensures result.base == vec.storage.base, result.length == vec.storage.length
{ vec.storage }

machine main() crashes Trap {
    let address: addr = NativeAllocation::allocate(1, 48);
    transition address != 0 { true -> allocated(address) false -> bad() }
    machine allocated(address: addr) {
        let grant: Extent in Granted = ExtentRootProvider::grant(Extent { base: address, length: 48 });
        let storage: Extent in Granted & Vacant = VacantContentTransfer::transfer(grant);
        transition storage.length == 48 { true -> exercise(storage) false -> bad() }
    }
    machine exercise(storage: Extent in Granted & Vacant)
    requires storage.length == 48 {
        let mut strategy: Bump = Bump::open(storage);
        let first: Extent in Granted & Vacant = allocate(&mut strategy, 8, 48);
        let vector: Vec = Vec::open(first, 2);
        let one: Vec = Vec::push(vector, 17);
        let two: Vec = Vec::push(one, 29);
        let fresh: Extent in Granted & Vacant = allocate(&mut strategy, 20, 40);
        let grown: Growth = Vec::grow(two, fresh, 5);
        let three: Vec = Vec::push(grown.vec, 43);
        let a: Read = Vec::get(three, 0);
        let b: Read = Vec::get(a.vec, 1);
        let c: Read = Vec::get(b.vec, 2);
        transition a.value == 17 && b.value == 29 && c.value == 43 && grown.retired_storage.length == 8 && c.vec.capacity == 5 && c.vec.len == 3 {
            true -> finish(strategy, c.vec, grown.retired_storage)
            false -> bad()
        }
    }
    machine finish(strategy: Bump, vector: Vec, old: Extent in Granted & Vacant)
    requires old.base == strategy.base, old.length == 8,
        vector.storage.length == 20,
        embed(vector.storage.base) == embed(old.base) + embed(old.length),
        strategy.remaining == 20, strategy.capacity == 48 {
        let returned: Extent in Granted & Vacant = Vec::close(vector);
        let returned_old: Released = release(strategy, old);
        let returned_new: Released = release(returned_old.strategy, returned);
        let prefix: Extent in Granted & Vacant = merge_vacant_extents(returned_old.retired_storage, returned_new.retired_storage);
        let mut restored: Bump = reset(returned_new.strategy, prefix);
        let reused: Extent in Granted & Vacant = allocate(&mut restored, 48, 48);
        let new_vector: Vec = Vec::open(reused, 12);
        let pushed: Vec = Vec::push(new_vector, 97);
        let read_back: Read = Vec::get(pushed, 0);
        transition read_back.value == 97 && read_back.vec.capacity == 12 && restored.remaining == 0 {
            true -> exit(restored, read_back.vec)
            false -> bad()
        }
    }
    machine exit(strategy: Bump, vector: Vec)
    requires vector.storage.base == strategy.base, vector.storage.length == strategy.capacity,
        strategy.remaining == 0 {
        let returned: Extent in Granted & Vacant = Vec::close(vector);
        let released: Released = release(strategy, returned);
        let whole: Bump = reset(released.strategy, released.retired_storage);
        ProcessExit::exit_process(0);
    }
    machine bad() { crash Trap; }
}
