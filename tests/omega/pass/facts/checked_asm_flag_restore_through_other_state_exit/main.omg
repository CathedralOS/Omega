// Expected exit: 0.
// Structured popfq restores a saved u64 flags place; the following label reads that place.
use omega::language::core::assembly;

machine main() reaches MachineControl crashes Trap {
    let mut saved: u64 = 0;
    asm where clobbers rax, rflags, r10, r15 {
        entry:
            mov eax, 1;
            sub eax, 1;
            pushfq saved;
    }
    transition { _ -> carried(saved) }
    machine carried(saved: u64) requires (saved & 64u64) == 64u64 {
        asm where clobbers r10, r15 {
            entry:
                popfq saved;
            observed requires (saved & 64u64) == 64u64:
                nop
        }
        transition (saved & 64u64) == 64u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
