// Fact: a provider-settled boundary call whose contract establishes result >= 100u64 && result <= 100u64 discharges exact subtraction result - 100u64.
// Place: target_body. The boundary call consumed across target-scoped machine bodies.
// Expected exit: 0
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 100u64 && result <= 100u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 100u64 && result <= 100u64 {
        100
    }
}

machine run() -> u64 reaches Provider {
    compute()
}

linux_x86_64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

linux_arm64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

windows_x86_64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

macos_arm64 machine compute() -> u64 reaches Provider {
    Provider::get() - 100u64
}

machine main() crashes Trap {
    transition run() == 0u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
