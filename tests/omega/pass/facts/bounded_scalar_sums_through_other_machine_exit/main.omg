// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: another machine. A forwarding machine transports both bounded operands
// to the adding machine.
// Expected exit: 0
machine combine(left: u64, right: u64) -> u64
    requires left <= 50 && right <= 50
    ensures result <= 100
{
    left + right
}

machine add(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    combine(a, b)
}

machine probe(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    add(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 70 && probe(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
