// Fact: an active case selected on an owned result retains the source place needed to borrow its payload without changing the returned slice's input provenance.
// Placements: local, field, parameter, call_result, match_join, const_name, other_state, other_machine.
// Each `<place>_placement` machine is the `main` of the former `borrowed_case_result_through_<place>_exit` fixture; `main` runs them in that order.
// Kept in its own fixture: target_body (`borrowed_case_result_through_target_body_exit`), which has its own build.omg.
// Expected exit: 0

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
data BorrowedCase<'input> { case Missing; case Bytes(value: &'input [u8]); }

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
machine produce<'input>(input: &'input [u8]) -> BorrowedCase<'input> {
    transition input.len > 0u64 {
        true -> header(input)
        false -> BorrowedCase::Missing
    }
    machine header(input: &'input [u8]) -> BorrowedCase<'input>
    requires input.len > 0u64
    {
        let length: u64 = input[0u64] as u64;
        transition length < input.len {
            true -> BorrowedCase::Bytes { value: &input[1u64..length + 1u64] }
            false -> BorrowedCase::Missing
        }
    }
}

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
machine forward<'input>(input: &'input [u8]) -> BorrowedCase<'input> { produce(input) }

// Placement: local.
// Renamed, because another placement uses the name: inspect -> local_inspect.

machine local_inspect(input: &[u8]) -> u64 {
    transition forward(input) {
        BorrowedCase::Bytes { value } -> length(value)
        BorrowedCase::Missing -> 0u64
    }
    machine length(bytes: &[u8]) -> u64 {
        transition bytes.len == 3u64 {
            true -> content(bytes)
            false -> 0u64
        }
    }
    machine content(bytes: &[u8]) -> u64
    requires bytes.len == 3u64
    {
        transition bytes[0u64] == 11u8 && bytes[1u64] == 29u8 && bytes[2u64] == 47u8 {
            true -> 3u64
            false -> 0u64
        }
    }
}
machine local_placement() crashes Trap {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    transition local_inspect(&bytes[..]) == 3u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// Placement: field.
// Renamed, because another placement uses the name: inspect -> field_inspect.

data Holder<'input> { result: BorrowedCase<'input>; }
machine field_inspect(input: &[u8]) -> u64 {
    let holder: Holder = Holder { result: forward(input) };
    transition holder.result {
        BorrowedCase::Bytes { value } -> length(value)
        BorrowedCase::Missing -> 0u64
    }
    machine length(bytes: &[u8]) -> u64 {
        transition bytes.len == 3u64 {
            true -> content(bytes)
            false -> 0u64
        }
    }
    machine content(bytes: &[u8]) -> u64
    requires bytes.len == 3u64
    {
        transition bytes[0u64] == 11u8 && bytes[1u64] == 29u8 && bytes[2u64] == 47u8 {
            true -> 3u64
            false -> 0u64
        }
    }
}
machine field_placement() crashes Trap {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    transition field_inspect(&bytes[..]) == 3u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

