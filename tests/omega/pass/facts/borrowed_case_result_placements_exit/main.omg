// Placement: match_join.
// Renamed, because another placement uses the name: inspect -> match_join_inspect.

machine match_join_inspect(input: &[u8]) -> u64 {
    let result: BorrowedCase = match input.len > 0u64 {
        true -> forward(input)
        false -> BorrowedCase::Missing
    };
    transition result {
        BorrowedCase::Bytes { value } -> length(value)
        BorrowedCase::Missing -> 0u64
    }
    machine length(bytes: &[u8]) -> u64 {
        transition bytes.len == 3u64 {
            true -> content(bytes)
            false -> 0u64
        }
    }
    machine content(bytes: &[u8]) -> u64
    requires bytes.len == 3u64
    {
        transition bytes[0u64] == 11u8 && bytes[1u64] == 29u8 && bytes[2u64] == 47u8 {
            true -> 3u64
            false -> 0u64
        }
    }
}
machine match_join_placement() crashes Trap {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    transition match_join_inspect(&bytes[..]) == 3u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

