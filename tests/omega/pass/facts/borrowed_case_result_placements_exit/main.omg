        }
    }
}
machine observed() -> u64 {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    const_name_inspect(&bytes[..])
}
const OBSERVED: u64 = observed();
machine const_name_placement() crashes Trap {
    transition OBSERVED == 3u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// Placement: other_state.
// Renamed, because another placement uses the name: inspect -> other_state_inspect.

machine other_state_inspect(input: &[u8]) -> u64 {
    select(forward(input))
    machine select<'input>(result: BorrowedCase<'input>) -> u64 {
    transition result {
        BorrowedCase::Bytes { value } -> length(value)
        BorrowedCase::Missing -> 0u64
    }
    machine length(bytes: &[u8]) -> u64 {
        transition bytes.len == 3u64 {
            true -> content(bytes)
            false -> 0u64
        }
    }
    machine content(bytes: &[u8]) -> u64
    requires bytes.len == 3u64
    {
        transition bytes[0u64] == 11u8 && bytes[1u64] == 29u8 && bytes[2u64] == 47u8 {
            true -> 3u64
            false -> 0u64
        }
    }
}
}
machine other_state_placement() crashes Trap {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    transition other_state_inspect(&bytes[..]) == 3u64 {
