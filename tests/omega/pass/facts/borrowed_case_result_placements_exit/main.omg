            false -> 0u64
        }
    }
}
machine other_machine_inspect(input: &[u8]) -> u64 { selected(forward(input)) }
machine other_machine_placement() crashes Trap {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    transition other_machine_inspect(&bytes[..]) == 3u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    local_placement();
    field_placement();
    parameter_placement();
    call_result_placement();
    match_join_placement();
    const_name_placement();
    other_state_placement();
    other_machine_placement();
}
