    }
    machine content(bytes: &[u8]) -> u64
    requires bytes.len == 3u64
    {
        transition bytes[0u64] == 11u8 && bytes[1u64] == 29u8 && bytes[2u64] == 47u8 {
            true -> 3u64
            false -> 0u64
        }
    }
}
machine parameter_inspect(input: &[u8]) -> u64 { inspect_result(forward(input)) }
machine parameter_placement() crashes Trap {
    let bytes: [u8; 4] = [3u8, 11u8, 29u8, 47u8];
    transition parameter_inspect(&bytes[..]) == 3u64 {
