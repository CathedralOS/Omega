// Expected exit: 0
// Reader in the middle slot of Carrier<u64, Reader, i32> supplies at least seven before exact value - 7.
trait Reading {
    machine floor() -> u64 ensures result >= 7;
}

Seven satisfies Reading {
    machine floor() -> u64 ensures result >= 7 { 7 }
}

trait Loose {
    machine floor() -> u64 ensures result >= 6;
}

Other satisfies Loose {
    machine floor() -> u64 ensures result >= 6 { 6 }
}

trait Carrier<Mark, Reader satisfies Reading, Tag> {
    machine floor() -> u64 ensures result >= 7 {
        Reading::floor<Reader>()
    }
}

Chosen satisfies Carrier<u64, Seven, i32> { }

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTargetValue {
    machine target_value() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result >= 7;
}

X86TargetValue satisfies SelectedTargetValue {
    machine target_value() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result >= 7
    {
        SelectedBodyCheck::require_tag(17u64);
     Chosen::floor() 
    }
}

ArmTargetValue satisfies SelectedTargetValue {
    machine target_value() -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result >= 7
    {
        SelectedBodyCheck::require_tag(29u64);
     Chosen::floor() 
    }
}

machine main() crashes Trap {
    let value: u64 = SelectedTargetValue::target_value();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
