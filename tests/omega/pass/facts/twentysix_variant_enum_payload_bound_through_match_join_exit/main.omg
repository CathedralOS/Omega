// Fact: matching a 26-variant tagged enum payload TwentySixChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64), V20(u64), V21(u64), V22(u64), V23(u64), V24(u64), V25(u64), V26(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Expected exit: 0

data TwentySixChoice [copy] {
    case V1(v: u64) where v >= 40u64 && v <= 80u64;
    case V2(v: u64) where v >= 40u64 && v <= 80u64;
    case V3(v: u64) where v >= 40u64 && v <= 80u64;
    case V4(v: u64) where v >= 40u64 && v <= 80u64;
    case V5(v: u64) where v >= 40u64 && v <= 80u64;
    case V6(v: u64) where v >= 40u64 && v <= 80u64;
    case V7(v: u64) where v >= 40u64 && v <= 80u64;
    case V8(v: u64) where v >= 40u64 && v <= 80u64;
    case V9(v: u64) where v >= 40u64 && v <= 80u64;
    case V10(v: u64) where v >= 40u64 && v <= 80u64;
    case V11(v: u64) where v >= 40u64 && v <= 80u64;
    case V12(v: u64) where v >= 40u64 && v <= 80u64;
    case V13(v: u64) where v >= 40u64 && v <= 80u64;
    case V14(v: u64) where v >= 40u64 && v <= 80u64;
    case V15(v: u64) where v >= 40u64 && v <= 80u64;
    case V16(v: u64) where v >= 40u64 && v <= 80u64;
    case V17(v: u64) where v >= 40u64 && v <= 80u64;
    case V18(v: u64) where v >= 40u64 && v <= 80u64;
    case V19(v: u64) where v >= 40u64 && v <= 80u64;
    case V20(v: u64) where v >= 40u64 && v <= 80u64;
    case V21(v: u64) where v >= 40u64 && v <= 80u64;
    case V22(v: u64) where v >= 40u64 && v <= 80u64;
    case V23(v: u64) where v >= 40u64 && v <= 80u64;
    case V24(v: u64) where v >= 40u64 && v <= 80u64;
    case V25(v: u64) where v >= 40u64 && v <= 80u64;
    case V26(v: u64) where v >= 40u64 && v <= 80u64;
}

machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine choose(flag: bool, first: u64, second: u64) -> u64
    requires first >= 40u64 && first <= 80u64 && second >= 40u64 && second <= 80u64
    ensures result >= 40u64 && result <= 80u64
{
    transition flag {
        true -> first
        false -> second
    }
}

machine extract(choice: TwentySixChoice) -> u64 {
    transition choice {
        TwentySixChoice::V1 { v } -> v
        TwentySixChoice::V2 { v } -> v
        TwentySixChoice::V3 { v } -> v
        TwentySixChoice::V4 { v } -> v
        TwentySixChoice::V5 { v } -> v
        TwentySixChoice::V6 { v } -> v
        TwentySixChoice::V7 { v } -> v
        TwentySixChoice::V8 { v } -> v
        TwentySixChoice::V9 { v } -> v
        TwentySixChoice::V10 { v } -> v
        TwentySixChoice::V11 { v } -> v
        TwentySixChoice::V12 { v } -> v
        TwentySixChoice::V13 { v } -> v
        TwentySixChoice::V14 { v } -> v
        TwentySixChoice::V15 { v } -> v
        TwentySixChoice::V16 { v } -> v
        TwentySixChoice::V17 { v } -> v
        TwentySixChoice::V18 { v } -> v
        TwentySixChoice::V19 { v } -> v
        TwentySixChoice::V20 { v } -> v
        TwentySixChoice::V21 { v } -> v
        TwentySixChoice::V22 { v } -> v
        TwentySixChoice::V23 { v } -> v
        TwentySixChoice::V24 { v } -> v
        TwentySixChoice::V25 { v } -> v
        TwentySixChoice::V26 { v } -> v
    }
}

machine probe(flag: bool, choice: TwentySixChoice) -> u64 {
    let res: u64 = extract(choice);
    let joined: u64 = choose(flag, res, 60u64);
    verify_payload(joined)
}

machine main() crashes Trap {
    let p: TwentySixChoice = TwentySixChoice::V26 { v: 60u64 };
    let combined: u64 = probe(true, p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
