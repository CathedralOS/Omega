// Fact: align_of(value) observes the storage location of a live u64 place, or the referent of a &u64, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Place: match join. Each arm observes a different u64 location and the joined result feeds the subtraction.
// Expected exit: 0

machine slack_after_join(flag: bool) -> u64 {
    let near: u64 = 41u64;
    let far: u64 = 43u64;
    let alignment: u64 = match flag {
        true -> align_of(near),
        false -> align_of(far) + align_of(far),
    };
    alignment - 8u64
}

machine main() crashes Trap {
    let taken: u64 = slack_after_join(true);
    let fallback: u64 = slack_after_join(false);
    transition taken == 0u64 && fallback == 8u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
