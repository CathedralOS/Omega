// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
public machine read_service() -> u64 invokes Mark; { Mark::read() }
machine call_mark() -> u64 { read_service() }

machine take() -> u64 {
    call_mark()
}
machine check(value: u64) crashes Trap {
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    check(take());
}
