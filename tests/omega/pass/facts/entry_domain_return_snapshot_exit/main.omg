// Expected exit: 0
data Counter { value: u64; }
domain Counter::One(counter) requires counter.value == 1;
machine clear(counter: &mut Counter) { counter.value = 0; }
machine snapshot(counter: &mut Counter) -> u64
requires counter in Counter::One
ensures result == 1
{
    let saved: u64 = counter.value;
    clear(counter);
    saved
}
machine main() crashes Trap {
    let counter: Counter = Counter { value: 1 };
    let saved: u64 = snapshot(&mut counter);
    transition saved == 1 && counter.value == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
