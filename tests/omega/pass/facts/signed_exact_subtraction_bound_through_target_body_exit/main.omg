// Fact: subtracting two bounded signed i64 values establishes the exact post-subtraction interval, discharging a downstream contract requiring diff >= 50i64 && diff <= 80i64 across all nine places.
// Place: target_body. Each hosted target body computes the signed exact subtraction and satisfies the downstream contract.
// Expected exit: 0
machine consume(diff: i64) -> i32
    requires diff >= 50 && diff <= 80
{
    let u: u64 = diff as u64;
    let sub: u64 = u - 50u64;
    sub as i32
}

linux_x86_64 machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
    requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: i64 = minuend - subtrahend;
    consume(diff)
}

linux_arm64 machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
    requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: i64 = minuend - subtrahend;
    consume(diff)
}

macos_arm64 machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
    requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: i64 = minuend - subtrahend;
    consume(diff)
}

windows_x86_64 machine subtract_signed(minuend: i64, subtrahend: i64) -> i32
    requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: i64 = minuend - subtrahend;
    consume(diff)
}

machine evaluate() -> i32 {
    subtract_signed(90, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 15 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
