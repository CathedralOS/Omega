machine build(builder: &mut Build) {
    Build::select_provider<SelectedSubtractSigned, CheckedSubtractSigned>(builder, linux_x86_64);
    Build::select_provider<SelectedSubtractSigned, CheckedSubtractSigned>(builder, linux_arm64);
    Build::select_provider<SelectedSubtractSigned, CheckedSubtractSigned>(builder, macos_arm64);
    Build::select_provider<SelectedSubtractSigned, CheckedSubtractSigned>(builder, windows_x86_64);

    Build::application(builder, "signed_exact_subtraction_bound_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
