// Fact: a ten-argument weighted scalar call preserves exact positional argument order across register and stack ABI slots when subtracting 100u64.
// Place: local. Ten distinct arguments are held in locals before passing to the call.
// Expected exit: 0

machine weighted_ten_sum(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64
) -> u64
requires
    a1 == 1u64 && a2 == 2u64 && a3 == 3u64 && a4 == 4u64 && a5 == 5u64 &&
    a6 == 6u64 && a7 == 7u64 && a8 == 8u64 && a9 == 24u64 && a10 == 40u64
ensures
    result == 100u64
{
    a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10
}

machine probe() -> u64
ensures
    result == 0u64
{
    let v1: u64 = 1;
    let v2: u64 = 2;
    let v3: u64 = 3;
    let v4: u64 = 4;
    let v5: u64 = 5;
    let v6: u64 = 6;
    let v7: u64 = 7;
    let v8: u64 = 8;
    let v9: u64 = 24;
    let v10: u64 = 40;
    let total: u64 = weighted_ten_sum(v1, v2, v3, v4, v5, v6, v7, v8, v9, v10);
    total - 100
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
