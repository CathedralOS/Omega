// Fact: a copyable C quotient/remainder record preserves both signed fields and independent earlier-call contents through transport and copying into the consuming operation.
// Expected exit: 0
public data Division [copy] { quotient: i64; remainder: i64; }
public boundary trait IntegerDivision {
 machine divide(numerator: i64, denominator: i64) -> Division reaches;
}

machine consume(first: Division, copied: Division) -> bool reaches IntegerDivision {
 let second: Division = IntegerDivision::divide(70000000000, 9);
 first.quotient == -23333333333 && first.remainder == -1
 && copied.quotient == -23333333333 && copied.remainder == -1
 && second.quotient == 7777777777 && second.remainder == 7
}
machine receive(value: Division) -> bool reaches IntegerDivision { consume(value, value) }
machine marked_result(marker: &mut u64, selected: u64) -> Division reaches IntegerDivision {
 marker = selected;
 IntegerDivision::divide(-70000000000, 3)
}
machine select(choice: bool, marker: &mut u64) -> Division reaches IntegerDivision {
 match choice {
  true -> marked_result(marker, 17u64)
  _ -> marked_result(marker, 29u64)
 }
}
machine observe() -> bool reaches IntegerDivision {
 let mut marker: u64 = 0u64;
 let first: Division = select(true, &mut marker);
 let first_agrees: bool = marker == 17u64 && receive(first);
 let second: Division = select(false, &mut marker);
 first_agrees && marker == 29u64 && receive(second)
}

machine main() reaches IntegerDivision crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
