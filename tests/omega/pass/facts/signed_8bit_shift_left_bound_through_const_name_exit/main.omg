// Fact: an 8-bit signed i8 left shift of a bounded input (val >= 25i8 && val <= 25i8) by 2u32 bits establishes shifted >= 100i8 && shifted <= 100i8 so exact 8-bit signed subtraction shifted - 100i8 is proved overflow-free across all nine places.
// Expected exit: 0

const BASE_VAL: i8 = 25i8;
const SHIFT_BITS: u32 = 2u32;

machine verify_i8_shifted(s: i8) -> i32
requires s >= 100i8 && s <= 100i8
{
    let diff: i8 = s - 100i8;
    transition diff == 0i8 {
        true -> 0i32
        _ -> 1i32
    }
}

machine exercise() -> i32 {
    let val: i8 = BASE_VAL;
    let shifted: i8 = val << SHIFT_BITS;
    verify_i8_shifted(shifted)
}

machine main() crashes Trap {
    let exit_code: i32 = exercise();
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
