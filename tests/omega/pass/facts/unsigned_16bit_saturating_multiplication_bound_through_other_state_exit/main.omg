// Fact: 16-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Place: another state. A successor state receives bounded 16-bit operands before saturating multiplication and interval discharge.
// Expected exit: 0

machine verify_prod(value: u16) -> u16 requires value >= 50u16 && value <= 200u16 {
    let headroom: u16 = 200u16 - value;
    let margin: u16 = value - 50u16;
    headroom + margin
}

machine sat_state(lhs: u16, rhs: u16) -> u16
requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
{
    transition {
        _ -> step(lhs, rhs)
    }
    machine step(l: u16, r: u16) -> u16
    requires l >= 10 && l <= 20 && r >= 5 && r <= 10
    {
        let a: u16 in Saturating = l as u16 in Saturating;
        let b: u16 in Saturating = r as u16 in Saturating;
        let sat_prod: u16 in Saturating = a * b;
        let prod: u16 = sat_prod as u16;
        verify_prod(prod)
    }
}

machine probe() -> u16 {
    sat_state(15u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
