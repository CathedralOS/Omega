// A match selects a primitive local, the join records that local as the origin, and the consumer reads the recorded value.
// Place: field.
// Expected exit: 0

data Seed { chosen: i64; spare: i64; }

machine choose() -> bool
ensures result == true
{
    true
}

machine read_origin(value: i64) -> i64
requires value == 17
{
    value
}

machine main() crashes Trap {
    let seed: Seed = Seed { chosen: 17, spare: 5 };
    let joined: i64 = match choose() {
        true -> seed.chosen
        false -> seed.spare
    };
    let observed: i64 = read_origin(joined);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
