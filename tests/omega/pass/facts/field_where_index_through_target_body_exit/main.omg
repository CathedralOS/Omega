// Every target body indexes through the standing field fact
// `k <= 3`, so `main.arr[main.k + 1]` compiles with no guard.
//
// Expected exit: 0

data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

linux_x86_64 machine read_target(main: &Main) -> i32 in Wrapping {
    main.arr[main.k + 1]
}
linux_arm64 machine read_target(main: &Main) -> i32 in Wrapping {
    main.arr[main.k + 1]
}
macos_arm64 machine read_target(main: &Main) -> i32 in Wrapping {
    main.arr[main.k + 1]
}
windows_x86_64 machine read_target(main: &Main) -> i32 in Wrapping {
    main.arr[main.k + 1]
}

machine Main::main(main: &mut Main) crashes Trap {
    main.arr = [10, 20, 30, 40, 50];
    main.k = 2;
    let first: i32 in Wrapping = read_target(main);
    transition { _ -> successor(main, first) }
    state successor(main: &mut Main, first: i32 in Wrapping) {
        main.k = 3;
        let second: i32 in Wrapping = read_target(main);
        transition first == 40 && second == 50 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() {
        crash Trap;
    }
}
