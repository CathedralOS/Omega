// A match join keeps Alive when every arm copies an Alive player.
// The joined alias carries that fact into inspect's requires.
// Expected exit: 0

data Player [copy] {
    health: i32;
}

domain Player::Alive(player)
requires
    player.health > 0;

data Main {
    player: Player;
    spare: Player;
    observed: i32;
}

machine Main::inspect(player: Player) -> i32
requires
    player in Player::Alive
{
    player.health
}

machine Main::choose(main: &Main, flag: bool) -> i32
requires
    main.player in Player::Alive,
    main.spare in Player::Alive
{
    let mut copy: Player = match flag {
        true -> main.player,
        false -> main.spare,
    };
    Main::inspect(copy)
}

machine Main::main(main: &mut Main)
requires
    main.player in Player::Alive,
    main.spare in Player::Alive
{
    main.observed = Main::choose(main, true);
}

machine entry() crashes Trap {
    let mut a: Main = Main { player: Player { health: 42 }, spare: Player { health: 99 }, observed: 0 };
    Main::main(&mut a);
    let mut b: Main = Main { player: Player { health: 1 }, spare: Player { health: 99 }, observed: 0 };
    Main::main(&mut b);
    transition a.observed == 42 && b.observed == 1 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() {
        crash Trap;
    }
}
