// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Place: match_join. Both match arms produce the quotient and join into the subtraction check.
// Expected exit: 0

machine choose_quotient(flag: bool) -> u64
ensures result >= 100 && result <= 100
{
    match flag {
        true -> 400u64 / 4u64,
        false -> 400u64 / 4u64,
    }
}

machine probe() -> i32 {
    let quotient: u64 = choose_quotient(true);
    let diff: u64 = quotient - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
