// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: another state. A successor state receives both bounded operands and
// adds them there.
// Expected exit: 0
machine add(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    transition { _ -> sum(a, b) }
    machine sum(left: u64, right: u64) -> u64
        requires left <= 50 && right <= 50
    {
        left + right
    }
}

machine probe(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    add(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 70 && probe(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
