// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Place: call result. A contracted helper call returns the bounded 8-bit operand before left shift and subtraction.
// Expected exit: 0

machine get_val() -> u8
ensures result >= 25 && result <= 25
{
    25u8
}

machine shift_call_result(shift: u32) -> u8
requires shift == 2
{
    let val: u8 = get_val();
    let shifted: u8 = val << shift;
    shifted - 100u8
}

machine probe() -> u8 {
    shift_call_result(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
