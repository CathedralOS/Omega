// Fact: 8-bit unsigned bitwise XOR raw ^ 15u8 with bounded interval 40u8 <= xored <= 63u8 establishes 40u8 <= xored <= 63u8 across all nine places so exact subtractions 63u8 - xored and xored - 40u8 are safe.
// Place: match_join. Both match arms yield the bitwise XOR result so the joined binding preserves the bounds.
// Expected exit: 0
machine verify_xored(res: u8) -> i32
    requires res >= 40 && res <= 63
{
    let head: u8 = 63 - res;
    let tail: u8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

machine compute_match_join(raw: u8, flag: bool) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = raw ^ 15;
    let joined: u8 = match flag {
        true -> xored
        false -> xored
    };
    verify_xored(joined)
}

machine evaluate() -> i32 {
    compute_match_join(59, true)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
