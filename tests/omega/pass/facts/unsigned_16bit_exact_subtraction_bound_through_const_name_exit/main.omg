// Fact: 16-bit unsigned exact subtraction lhs - rhs with 300u16 <= lhs <= 500u16 and 50u16 <= rhs <= 100u16 establishes 200u16 <= diff <= 450u16 so 450u16 - diff and diff - 200u16 are safe.
// Place: const_name. Named constants supply operands for exact 16-bit subtraction.
// Expected exit: 0

const LHS: u16 = 400u16;
const RHS: u16 = 80u16;

machine compute_const() -> i32 {
    let diff: u16 = LHS - RHS;
    let headroom: u16 = 450u16 - diff;
    let margin: u16 = diff - 200u16;
    0i32
}

machine probe() -> i32 {
    compute_const()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
