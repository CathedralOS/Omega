// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Place: const name. A named constant supplies the divisor before remainder and indexing.
// Expected exit: 0

const DIVISOR: i64 = 4i64;

machine compute_const(dividend: i64) -> u8
requires dividend >= 0i64
{
    let rem: i64 = dividend % DIVISOR;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

machine probe() -> u8 {
    compute_const(14i64)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
