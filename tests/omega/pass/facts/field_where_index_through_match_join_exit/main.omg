// A match join of two copies of the standing field still discharges
// `arr[index + 1]`. Both arms carry `k <= 3`, so the joined local does.
//
// Expected exit: 0

data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine joined(main: &Main, flag: bool) -> i32 in Wrapping {
    let index: u64 = match flag { true -> main.k, false -> main.k };
    main.arr[index + 1]
}

machine Main::main(main: &mut Main) crashes Trap {
    main.arr = [10, 20, 30, 40, 50];
    main.k = 2;
    let first: i32 in Wrapping = joined(main, true);
    transition { _ -> successor(main, first) }
    state successor(main: &mut Main, first: i32 in Wrapping) {
        main.k = 3;
        let second: i32 in Wrapping = joined(main, true);
        transition first == 40 && second == 50 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() {
        crash Trap;
    }
}
