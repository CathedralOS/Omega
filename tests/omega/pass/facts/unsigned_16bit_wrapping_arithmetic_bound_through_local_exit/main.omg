// Fact: 16-bit unsigned wrapping addition lhs +% rhs with bounded interval 350u16 <= sum <= 600u16 establishes 350u16 <= sum <= 600u16 across all nine places so exact subtractions 600u16 - sum and sum - 350u16 are safe.
// Place: local. The wrapping sum is copied into a local before discharging subtraction bounds.
// Expected exit: 0

machine compute_local(lhs: u16, rhs: u16) -> i32
requires lhs >= 300u16 && lhs <= 500u16 && rhs >= 50u16 && rhs <= 100u16
{
    let w_lhs: u16 in Wrapping = lhs as u16 in Wrapping;
    let w_rhs: u16 in Wrapping = rhs as u16 in Wrapping;
    let sum_wrap: u16 in Wrapping = w_lhs + w_rhs;
    let sum: u16 = sum_wrap as u16;
    let s: u16 = sum;
    let headroom: u16 = 600u16 - s;
    let margin: u16 = s - 350u16;
    0i32
}

machine probe() -> i32 {
    compute_local(400u16, 80u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
