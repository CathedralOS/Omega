// A const write of 41 at grid[1][2] becomes 42 after grid[i][j] = grid[i][j] + 1 with i == 1 and j == 2, and rows[2].data[1] becomes 42 after the same increment while rows[2].tag stays 7.
// The operation is that pair of read-modify-writes through borrowed caller storage.
// Expected exit: 0
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Holder { grid: [[i32 in Wrapping; 4]; 3]; rows: [Row; 3]; }

machine main() crashes Trap {
    let mut holder: Holder;
    transition { _ -> rmw(&mut holder, 1, 2, 2, 1) }
    machine rmw(holder: &mut Holder, i: u64, j: u64, ri: u64, rj: u64)
    requires i <= 2
    requires j <= 3
    requires ri <= 2
    requires rj <= 1 {
        holder.grid[1][2] = 41;
        holder.grid[i][j] = holder.grid[i][j] + 1;
        let grid_got: i32 in Wrapping = holder.grid[1][2];
        holder.rows[2].data[1] = 41;
        holder.rows[2].tag = 7;
        holder.rows[ri].data[rj] = holder.rows[ri].data[rj] + 1;
        let rows_got: i32 in Wrapping = holder.rows[2].data[1] + holder.rows[2].tag;
        transition grid_got == 42 && rows_got == 49 { true -> done() _ -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
