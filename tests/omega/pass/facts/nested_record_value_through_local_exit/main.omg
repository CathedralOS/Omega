// A nested record Envelope preserves its inner Header bound header.limit <= 50 and sibling payload across value transport so header.limit + payload <= 100 in all nine places.
// Place: local. An envelope is copied to a local value before adding.
// Expected exit: 0

data Header [copy] {
    tag: u64;
    limit: u64;
}

data Envelope [copy] {
    header: Header;
    payload: u64;
}

machine sum_envelope(envelope: Envelope) -> u64
requires envelope.header.limit <= 50 && envelope.payload <= 50
ensures result <= 100
{
    let local: Envelope = envelope;
    local.header.limit + local.payload
}

machine probe(envelope: Envelope) -> u64
requires envelope.header.limit <= 50 && envelope.payload <= 50
ensures result <= 100
{
    sum_envelope(envelope)
}

machine main() crashes Trap {
    let envelope: Envelope = Envelope {
        header: Header { tag: 7, limit: 20 },
        payload: 22,
    };
    let sum: u64 = probe(envelope);
    transition envelope.header.tag == 7 && sum == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
