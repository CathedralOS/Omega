// Fact: 16-bit signed bitwise XOR raw ^ 15i16 with bounded interval 40i16 <= xored <= 63i16 establishes 40i16 <= xored <= 63i16 across all nine places so exact subtractions 63i16 - xored and xored - 40i16 are safe.
// Expected exit: 0

machine verify_xored(xored: i16) -> i32
    requires xored >= 40 && xored <= 63
{
    let headroom: i16 = 63 - xored;
    let margin: i16 = xored - 40;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

machine produce_xored(raw: i16) -> i16
    requires raw >= 59 && raw <= 59
    ensures result >= 40 && result <= 63
{
    raw ^ 15i16
}

machine main() crashes Trap {
    let raw: i16 = 59;
    let xored: i16 = produce_xored(raw);
    let check: i32 = verify_xored(xored);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
