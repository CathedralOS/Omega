machine build(builder: &mut Build) {
    Build::application(builder, "coupled_requires_construction_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Advance, X86Advance>(builder, windows_x86_64);
    Build::select_provider<Advance, X86Advance>(builder, linux_x86_64);
    Build::select_provider<Advance, ArmAdvance>(builder, macos_arm64);
    Build::select_provider<Advance, ArmAdvance>(builder, linux_arm64);
}
