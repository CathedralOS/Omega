// A whole-array shared view of four noncopy Entries has length 4; reading its extent satisfies require_four(view.len).
// Expected exit: 0
use omega::language::core::slice;
data Entry { value: i32; }
machine require_four(length: u64) -> u64
requires length == 4
{ length }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedExtent {
    machine extent(view: &[Entry]) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires view.len == 4;
}

X86Extent satisfies SelectedExtent {
    machine extent(view: &[Entry]) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires view.len == 4
    {
        SelectedBodyCheck::require_tag(17u64);
     require_four(view.len) 
    }
}

ArmExtent satisfies SelectedExtent {
    machine extent(view: &[Entry]) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires view.len == 4
    {
        SelectedBodyCheck::require_tag(29u64);
     require_four(view.len) 
    }
}


machine main() crashes Trap {
    let entries: [Entry; 4] = [Entry { value: 7 }, Entry { value: 8 }, Entry { value: 9 }, Entry { value: 10 }];
    transition SelectedExtent::extent(&entries[..]) == 4 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
