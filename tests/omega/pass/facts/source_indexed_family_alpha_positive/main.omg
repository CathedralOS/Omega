// Expected exit: 0
// Chain constructors bind their exact length and sum. Induction proves the
// sum bound used by the executing consumer; proof payloads remain erased.
data Chain<Count: u64, Weight: u64> {
    case Empty where Count == 0 && Weight == 0;
    case Link(prior: u64, prior_weight: u64, item: u64,
              rest [erased]: Chain<prior, prior_weight>)
        where item <= 10 && embed(prior) + 1 == embed(Count)
              && embed(prior_weight) + embed(item) == embed(Weight);
}
let preserve<Count: u64, Weight: u64>(value: Chain<Count, Weight>): Chain<Count, Weight> = value;

machine chain_bound<Count: u64, Weight: u64>(evidence [erased]: Chain<Count, Weight>)
terminates by Count;
ensures embed(Weight) <= 10 * embed(Count)
{
    transition evidence {
        Chain::Empty { .. } -> done()
        Chain::Link { prior, prior_weight, item, rest, .. } -> step(prior, prior_weight, item, rest)
    }
    machine done() requires Count == 0 && Weight == 0 {}
    machine step(prior: u64, prior_weight: u64, item: u64, rest [erased]: Chain<prior, prior_weight>)
    requires item <= 10 && embed(prior) + 1 == embed(Count)
             && embed(prior_weight) + embed(item) == embed(Weight)
    {
        chain_bound<prior, prior_weight>(rest);
    }
}

machine consume<Count: u64, Weight: u64>(evidence [erased]: Chain<Count, Weight>) -> u64
requires Count <= 8
{
    chain_bound<Count, Weight>(evidence);
    80u64 - Weight
}
machine main() crashes Trap {
    let empty [erased]: Chain<0, 0> = Chain::Empty;
    let single [erased]: Chain<1, 7> = Chain::Link { prior: 0, prior_weight: 0, item: 7, rest: empty };
    let saved [erased]: Chain<1, 7> = preserve<1, 7>(single);
    let result: u64 = consume<1, 7>(saved);
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
