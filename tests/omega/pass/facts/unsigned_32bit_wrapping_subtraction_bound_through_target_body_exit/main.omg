// Fact: 32-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 40u32 <= diff <= 100u32 establishes 40u32 <= diff <= 100u32 across all nine places so exact subtractions 100u32 - diff and diff - 40u32 are safe.
// Place: target body. Dedicated target-scoped machine bodies evaluate the bounded wrapping difference on each hosted target.
// Expected exit: 0

machine compute_diff(lhs: u32, rhs: u32) -> u32
requires lhs >= 80u32 && lhs <= 120u32
    && rhs >= 20u32 && rhs <= 40u32
ensures result >= 40u32 && result <= 100u32
{
    let wrap_lhs: u32 in Wrapping = lhs as u32 in Wrapping;
    let wrap_rhs: u32 in Wrapping = rhs as u32 in Wrapping;
    let wrap_diff: u32 in Wrapping = wrap_lhs - wrap_rhs;
    wrap_diff as u32
}

machine verify_diff(diff: u32) -> u32 crashes Trap
requires diff >= 40u32 && diff <= 100u32
ensures result == 0u32
{
    let headroom: u32 = 100u32 - diff;
    let margin: u32 = diff - 40u32;
    transition headroom == 30u32 && margin == 30u32 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> u32 {
        0u32
    }
    machine bad() -> u32 {
        crash Trap;
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluateDiff {
    machine evaluate_diff() -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 0u32;
}

X86EvaluateDiff satisfies SelectedEvaluateDiff {
    machine evaluate_diff() -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 0u32
    {
        SelectedBodyCheck::require_tag(17u64);
        let diff: u32 = compute_diff(100u32, 30u32);
        verify_diff(diff)
    }
}

ArmEvaluateDiff satisfies SelectedEvaluateDiff {
    machine evaluate_diff() -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result == 0u32
    {
        SelectedBodyCheck::require_tag(29u64);
        let diff: u32 = compute_diff(100u32, 30u32);
        verify_diff(diff)
    }
}

machine probe() -> u32 crashes Trap
ensures result == 0u32
{
    SelectedEvaluateDiff::evaluate_diff()
}

machine main() crashes Trap {
    transition probe() == 0u32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
