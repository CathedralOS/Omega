// Fact: Adding two bounded 32-bit unsigned u32 values (lhs >= 20u32 && lhs <= 40u32 and rhs >= 30u32 && rhs <= 50u32) establishes the exact post-addition interval (sum >= 50u32 && sum <= 90u32), discharging both 90u32 - sum and sum - 50u32 across all nine places.
// Place: match join. The addition result is synthesized across conditional match branches.
// Expected exit: 0

machine evaluate(lhs: u32, rhs: u32, choose: bool) -> i32
    requires lhs >= 20u32 && lhs <= 40u32;
    requires rhs >= 30u32 && rhs <= 50u32;
{
    let sum: u32 = match choose {
        true -> lhs + rhs,
        false -> rhs + lhs
    };
    let headroom: u32 = 90u32 - sum;
    let margin: u32 = sum - 50u32;
    transition sum == 70u32 && headroom == 20u32 && margin == 20u32 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = evaluate(30u32, 40u32, true);
    let res2: i32 = evaluate(30u32, 40u32, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
