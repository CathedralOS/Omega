// A nested scalar array construction [a, b] flattens fixed-array rows into row-major element reads of their storage, preserving each row's element values across all nine places.
// Place: const name. A named constant supplies one row of the construction.
// Expected exit: 0
const FIRST: [u64; 2] = [3, 5];

machine pair(b: [u64; 2]) -> [[u64; 2]; 2] {
    [FIRST, b]
}

machine main() crashes Trap {
    let result: [[u64; 2]; 2] = pair([7, 11]);
    transition result[0][0] == 3 && result[0][1] == 5 && result[1][0] == 7 && result[1][1] == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
