// A saved observation that kept is 7 stays valid across a complete non-writing exclusive call.
// Expected exit: 0
data Ends { kept: f64; other: f64; }
data Observation [copy] { saved: f64; route: u64; }
machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0 { observed }
machine expose(slot: &mut f64) -> f64 {
    slot
}
machine probe(item: &mut Ends, choice: bool) -> u64
requires item.kept == 7.0 {
    let joined: Observation = match choice {
        true -> Observation { saved: item.kept, route: 17 },
        false -> Observation { saved: item.kept, route: 23 },
    };
    let held: f64 = expose(&mut item.kept);
    let agreed: f64 = agree(joined.saved, item.kept);
    transition agreed == 7.0 && held == 7.0 {
        true -> joined.route
        false -> 0
    }
}
machine main() crashes Trap {
    let mut first: Ends = Ends { kept: 7.0, other: 1.0 };
    let mut second: Ends = Ends { kept: 7.0, other: 1.0 };
    let first_route: u64 = probe(&mut first, true);
    let second_route: u64 = probe(&mut second, false);
    transition first_route == 17 && second_route == 23
        && first.kept == 7.0 && second.kept == 7.0
        && first.other == 1.0 && second.other == 1.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
