// Fact: masking an unsigned 64-bit integer to 5 bits and narrowing through u8 ((x & 31u64) as u8 as u64) preserves the exact upper bound (truncated <= 31u64), discharging exact subtraction 31u64 - truncated across all nine places.
// Expected exit: 0

machine exercise(truncated: u64) -> u64
requires truncated <= 31u64
ensures result <= 31u64
{
    let diff: u64 = 31u64 - truncated;
    diff
}

machine main() crashes Trap {
    let x: u64 = 466u64;
    let diff: u64 = exercise((x & 31u64) as u8 as u64);
    transition diff == 13u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
