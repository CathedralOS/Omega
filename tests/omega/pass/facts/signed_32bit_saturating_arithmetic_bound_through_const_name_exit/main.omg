// Fact: 32-bit signed saturating addition lhs +| rhs with bounded interval 50i32 <= sum <= 100i32 establishes 50i32 <= sum <= 100i32 across all nine places so exact subtractions 100i32 - sum and sum - 50i32 are safe.
// Place: const name. Named constants supply bounded 32-bit operands before saturating addition and verification.
// Expected exit: 0

const LHS_VAL: i32 = 60i32;
const RHS_VAL: i32 = 15i32;

machine verify_sum(sum: i32) -> i32 requires sum >= 50i32 && sum <= 100i32 {
    let headroom: i32 = 100i32 - sum;
    let margin: i32 = sum - 50i32;
    let total: i32 = headroom + margin;
    let check: i32 = total - 50i32;
    check
}

machine sat_const() -> i32 {
    let a: i32 in Saturating = LHS_VAL as i32 in Saturating;
    let b: i32 in Saturating = RHS_VAL as i32 in Saturating;
    let sat_sum: i32 in Saturating = a + b;
    let sum: i32 = sat_sum as i32;
    verify_sum(sum)
}

machine probe() -> i32 {
    sat_const()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
