// Expected exit: 0
// A predicate on the actual incoming value survives owned selection.
data Region { base: addr; length: u64; }
let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;
domain Region::Bounded(region)
requires no_wrap(region.base, region.length);
machine region(base: addr, length: u64, endpoint: addr) -> Region in Bounded
requires embed(base) + embed(length) <= embed(endpoint)
ensures result.base == base && result.length == length
{ Region { base: base, length: length } }
machine choose(left: Region in Bounded, right: Region in Bounded, requested: u64, flag: bool) -> addr
requires requested < left.length && requested < right.length
{
    let selected: Region in Bounded = match flag { true -> left, false -> right };
    selected.base + requested
}
machine nested(whole: Region in Bounded, requested: u64, flag: bool, inner: bool) -> addr
requires requested < whole.length
{
    let local: Region in Bounded = whole;
    let selected: Region in Bounded = match flag {
        true -> match inner { true -> local, false -> local },
        false -> local
    };
    selected.base + requested
}
machine choose_three(left: Region in Bounded, middle: Region in Bounded, right: Region in Bounded,
                     requested: u64, first: bool, second: bool) -> addr
requires requested < left.length && requested < middle.length && requested < right.length
{
    let selected: Region in Bounded = match first {
        true -> middle,
        false -> match second { true -> right, false -> left }
    };
    selected.base + requested
}
machine main() crashes Trap {
    let left: addr = choose(region(10, 80, 100), region(20, 80, 100), 20, true);
    let right: addr = choose(region(10, 80, 100), region(20, 80, 100), 20, false);
    let first: addr = nested(region(30, 60, 100), 20, true, false);
    let second: addr = nested(region(40, 50, 100), 20, false, true);
    let third: addr = choose_three(region(10, 80, 100), region(20, 80, 100), region(30, 60, 100), 20, true, false);
    let fourth: addr = choose_three(region(10, 80, 100), region(20, 80, 100), region(30, 60, 100), 20, false, true);
    let fifth: addr = choose_three(region(10, 80, 100), region(20, 80, 100), region(30, 60, 100), 20, false, false);
    transition left == 30 && right == 40 && first == 50 && second == 60 && third == 40 && fourth == 50 && fifth == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
