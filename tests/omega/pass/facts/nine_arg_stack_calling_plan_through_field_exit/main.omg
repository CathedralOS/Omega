// Fact: passing nine bounded integer arguments (`a1` through `a9` with `a9 <= 92u64`) across register and stack ABI slots on all four hosted targets (including AArch64 stack overflow past `X0–X7`) preserves the 9th argument's static bound (`a9 <= 92u64`), discharging exact subtraction `92u64 - a9` across all nine places.
// Place: field. The nine arguments are stored in and read from record fields.
// Expected exit: 0

data NineArgs where
    f1 == 10u64, f2 == 20u64, f3 == 30u64, f4 == 40u64, f5 == 50u64,
    f6 == 60u64, f7 == 70u64, f8 == 80u64, f9 == 92u64
{
    f1: u64;
    f2: u64;
    f3: u64;
    f4: u64;
    f5: u64;
    f6: u64;
    f7: u64;
    f8: u64;
    f9: u64;
}

machine calling_plan_nine(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 == 70u64 && a8 == 80u64 && a9 <= 92u64
ensures
    result <= 92u64 && result == a9
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
    (prefix - 360) + a9
}

machine probe(args: NineArgs) -> u64
ensures
    result == 0u64
{
    let val: u64 = calling_plan_nine(
        args.f1, args.f2, args.f3, args.f4, args.f5,
        args.f6, args.f7, args.f8, args.f9
    );
    92u64 - val
}

machine main() crashes Trap {
    let args: NineArgs = NineArgs {
        f1: 10, f2: 20, f3: 30, f4: 40, f5: 50,
        f6: 60, f7: 70, f8: 80, f9: 92
    };
    transition probe(args) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
