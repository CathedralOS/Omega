// Fact: retiring a borrow restoration window restores full owner access and post-borrow invariant value >= 100u64 && value <= 100u64 for exact subtraction value - 100u64.
// Place: const name. A named constant supplies the written value and subtraction bound.
// Expected exit: 0

const TARGET: u64 = 100u64;

data Cell {
    value: u64;
}

machine write_cell(cell: &mut Cell) {
    cell.value = TARGET;
}

machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 0u64 };
    write_cell(&mut cell);
    let val: u64 = cell.value;
    transition val >= TARGET && val <= TARGET {
        true -> done(val)
        _ -> bad()
    }
    machine done(v: u64) {
        let diff: u64 = v - TARGET;
    }
    machine bad() {
        crash Trap;
    }
}
