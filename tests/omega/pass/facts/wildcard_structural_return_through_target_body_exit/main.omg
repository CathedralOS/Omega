// One authored wildcard structural return carries payload <= 7 into exact subtraction 7 - payload, evaluating its selected call once.
// Expected exit: 0

data Choice [copy] { case Stop; case First; case Second; }
data Packet [copy] 
    requires ((self in Packet::Value) && (self.payload <= 7u64))
{ case Value(payload: u64); }

machine produce(counter: &mut u64) -> Packet {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Packet::Value { payload: 7u64 }
}

machine select(choice: Choice, counter: &mut u64) -> Packet {
    transition choice {
        Choice::Stop -> (Packet::Value { payload: 0u64 })
        _ -> (produce(counter))
    }
}
machine consume(packet: Packet) -> u64 {
    transition packet { Packet::Value { payload } -> (7u64 - payload) }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEvaluate {
    machine evaluate(packet: Packet) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Evaluate satisfies SelectedEvaluate {
    machine evaluate(packet: Packet) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     consume(packet) 
    }
}

ArmEvaluate satisfies SelectedEvaluate {
    machine evaluate(packet: Packet) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     consume(packet) 
    }
}


machine main() crashes Trap {
    let mut counter: u64 = 0;
    let first: u64 = SelectedEvaluate::evaluate(select(Choice::First, &mut counter));
    let second: u64 = SelectedEvaluate::evaluate(select(Choice::Second, &mut counter));
    let stopped: u64 = SelectedEvaluate::evaluate(select(Choice::Stop, &mut counter));
    transition first == 0 && second == 0 && stopped == 7 && counter == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
