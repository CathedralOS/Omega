// Ordered scalar reads observe the replaced descriptor; detached scalars retain their earlier value.
// Expected exit: 0
data Cell { value: u64; }
data Holder<'storage> { child: &'storage mut Cell; }
machine retarget<'storage>(output: &mut Holder<'storage>, incoming: &'storage mut Cell) -> u64
requires incoming.value > 0
ensures output.child.value > 0
{
    output.child = incoming;
    0
}
machine observe(ignored: u64, value: u64) -> u64
ensures result == value
{ value }
machine clear(value: &mut Cell) { value.value = 0; }
machine require_positive(value: u64)
requires value > 0
{}
machine main() crashes Trap {
    let mut first: Cell = Cell { value: 7 };
    let mut second: Cell = Cell { value: 8 };
    let mut cursor: Holder = Holder { child: &mut first };
    let saved: u64 = cursor.child.value;
    let current: u64 = observe(retarget(&mut cursor, &mut second), cursor.child.value);
    clear(cursor.child);
    transition saved == 7 && current == 8 && cursor.child.value == 0 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
