// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: match join. The remainder is synthesized across conditional match branches.
// Expected exit: 0

machine remainder_match_join(dividend: u64, divisor: u64, choose: bool) -> i32
    requires divisor >= 64u64 && divisor <= 64u64;
{
    let rem: u64 = match choose {
        true -> dividend % divisor,
        false -> dividend % divisor
    };
    let headroom: u64 = 63u64 - rem;
    transition rem == 13u64 && headroom == 50u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = remainder_match_join(205u64, 64u64, true);
    let res2: i32 = remainder_match_join(205u64, 64u64, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
