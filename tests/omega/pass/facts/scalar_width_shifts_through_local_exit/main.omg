// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: local. Both the Wrapping u32 value and bounded shift count are copied into locals.
// Expected exit: 0
machine shift_round_trip(val: u32 in Wrapping, shift: u32) -> u32 in Wrapping
    requires shift < 4
{
    let v: u32 in Wrapping = val;
    let s: u32 = shift;
    let shifted: u32 in Wrapping = v << s;
    shifted >> s
}

machine probe(val: u32 in Wrapping, shift: u32) -> u32 in Wrapping
    requires shift < 4
{
    shift_round_trip(val, shift)
}

machine main() crashes Trap {
    let val: u32 in Wrapping = 21 as u32 in Wrapping;
    let shift: u32 = 1;
    let recovered: u32 in Wrapping = probe(val, shift);
    let shifted: u32 in Wrapping = val << shift;
    transition (shifted as u32) == 42 && (recovered as u32) == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
