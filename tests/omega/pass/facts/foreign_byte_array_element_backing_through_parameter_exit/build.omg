use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_byte_array_element_backing_parameter");
    Build::bind(builder, windows_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_arm64::ProgramEntry, start);
    Build::bind(builder, macos_arm64::ProgramEntry, start);
    Build::bind<Text::length>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "msvcrt.dll", export: "strlen" }
    });
    Build::bind<Text::length>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.2.5"
        }
    });
    Build::bind<Text::length>(builder, linux_arm64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.17"
        }
    });
    Build::bind<Text::length>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_strlen"
        }
    });
}
