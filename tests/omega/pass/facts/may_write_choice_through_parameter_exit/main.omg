// Choosing one of two mutable inputs and writing through that result preserves a disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: parameter.

machine choose<'storage>(chosen: &'storage mut u64, other: &'storage mut u64, pick_chosen: bool) -> &'storage mut u64 {
    transition pick_chosen {
        true -> chosen
        _ -> other
    }
}

machine overwrite(slot: &mut u64) -> u64 in Wrapping {
    slot = 9;
    (1 as u64 in Wrapping)
}

machine add(first: u64 in Wrapping, second: u64 in Wrapping) -> u64 in Wrapping {
    first + second
}

machine probe(chosen: &mut u64, other: &mut u64, items: &[u8; 4]) -> u8
requires chosen < 4 && other < 4
{
    let zero: u64 in Wrapping = 0;
    let marker: u64 in Wrapping = add(overwrite(choose(chosen, other, true)), zero);
    let index: u64 = other;
    transition (marker as u64) == 1 && items[index] == 7 {
        true -> (items[index])
        _ -> 0
    }
}

machine main() crashes Trap {
    let mut chosen: u64 = 0;
    let mut other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    let found: u8 = probe(&mut chosen, &mut other, &items);
    transition found == 7 && chosen == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
