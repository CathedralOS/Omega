// Fact: 8-bit unsigned saturating multiplication lhs *| rhs with bounded interval 40u8 <= prod <= 150u8 establishes 40u8 <= prod <= 150u8 across all nine places so exact subtractions 150u8 - prod and prod - 40u8 are safe.
// Expected exit: 0

machine compute_sat(lhs: u8 in Saturating, rhs: u8 in Saturating) -> u8 in Saturating {
    lhs * rhs
}

machine verify_prod(prod: u8) -> i32
    requires prod >= 40 && prod <= 150
{
    let headroom: u8 = 150 - prod;
    let margin: u8 = prod - 40;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 110;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 150;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 150
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_prod(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 150
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_prod(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: u8 in Saturating = 12;
    let rhs: u8 in Saturating = 8;
    let prod_sat: u8 in Saturating = compute_sat(lhs, rhs);
    let prod: u8 = prod_sat as u8;
    let check: i32 = SelectedProbe::exercise(prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
