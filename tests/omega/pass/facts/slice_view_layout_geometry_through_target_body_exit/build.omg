machine build(builder: &mut Build) {
    Build::select_provider<SelectedComputeGeometry, CheckedComputeGeometry>(builder, linux_x86_64);
    Build::select_provider<SelectedComputeGeometry, CheckedComputeGeometry>(builder, linux_arm64);
    Build::select_provider<SelectedComputeGeometry, CheckedComputeGeometry>(builder, macos_arm64);
    Build::select_provider<SelectedComputeGeometry, CheckedComputeGeometry>(builder, windows_x86_64);

    Build::application(builder, "slice_view_layout_geometry_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
