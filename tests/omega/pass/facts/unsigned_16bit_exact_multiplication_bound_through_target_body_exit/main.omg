// Fact: a 16-bit unsigned u16 exact multiplication of bounded inputs (lhs >= 20u16 && lhs <= 30u16, rhs >= 15u16 && rhs <= 25u16) establishes prod >= 300u16 && prod <= 750u16 so exact 16-bit subtractions 750u16 - prod and prod - 300u16 are proved overflow-free across all nine places.
// Place: another target body. Each of four target-scoped machine bodies multiplies bounded 16-bit operands and subtracts.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedMulTarget {
    machine mul_target(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 20 && lhs <= 30 && rhs >= 15 && rhs <= 25;
}

X86MulTarget satisfies SelectedMulTarget {
    machine mul_target(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 20 && lhs <= 30 && rhs >= 15 && rhs <= 25
    {
        SelectedBodyCheck::require_tag(17u64);
        let prod: u16 = lhs * rhs;
        let headroom: u16 = 750u16 - prod;
        let margin: u16 = prod - 300u16;
        headroom + margin
    }
}

ArmMulTarget satisfies SelectedMulTarget {
    machine mul_target(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 20 && lhs <= 30 && rhs >= 15 && rhs <= 25
    {
        SelectedBodyCheck::require_tag(29u64);
        let prod: u16 = lhs * rhs;
        let headroom: u16 = 750u16 - prod;
        let margin: u16 = prod - 300u16;
        headroom + margin
    }
}

machine probe() -> u16 {
    SelectedMulTarget::mul_target(25u16, 20u16)
}

machine main() crashes Trap {
    transition probe() == 450 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
