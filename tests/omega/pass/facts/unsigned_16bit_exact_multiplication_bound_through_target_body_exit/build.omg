machine build(builder: &mut Build) {
    Build::select_provider<SelectedMulTarget, CheckedMulTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedMulTarget, CheckedMulTarget>(builder, linux_arm64);
    Build::select_provider<SelectedMulTarget, CheckedMulTarget>(builder, macos_arm64);
    Build::select_provider<SelectedMulTarget, CheckedMulTarget>(builder, windows_x86_64);

    Build::application(builder, "unsigned_16bit_exact_multiplication_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
