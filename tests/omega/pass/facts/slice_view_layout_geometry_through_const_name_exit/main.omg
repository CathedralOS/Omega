// Fact: querying size_of and align_of on a 64-bit slice view (&[u64]) establishes its exact two-word (ptr, len) descriptor geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: const name. Named constants evaluate size_of and align_of before subtracting.
// Expected exit: 0

const SLICE_SIZE: u64 = size_of<&[u64]>();
const SLICE_ALIGN: u64 = align_of<&[u64]>();

machine main() crashes Trap {
    let diff: u64 = SLICE_SIZE - (SLICE_ALIGN * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
