// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public data Child [copy] requires self.number >= 1 { number: i32; }
public data Counter [copy] requires self.value <= 60 && self.peer <= 60 { before: i32; value: i32; peer: i32; after: i32; child: Child; }
public machine fill(counter: &mut Counter, replacement: i32) crashes Trap
requires replacement <= 60
{
    counter.value = 61;
    let saved: i32 = counter.value;
    let peer_total: i32 = 70 + counter.peer;
    counter.value = replacement;
    transition saved == 61 && peer_total == 70 + counter.peer { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine produce(replacement: i32) -> Counter crashes Trap
requires replacement <= 60
{
    let mut counter: Counter = Counter { before: 31, value: 0, peer: 13, after: 47, child: Child { number: 19 } };
    fill(&mut counter, replacement);
    counter
}

machine compute(counter: &Counter) -> i32 {
    let value: i32 = counter.value;
    70 + value
}
machine main() crashes Trap {
    let counter: Counter = produce(60);
    let low: Counter = produce(-2147483648);
    transition compute(&counter) == 130 && compute(&low) == -2147483578 && counter.before == 31 && counter.peer == 13 && counter.after == 47 && low.before == 31 && low.peer == 13 && low.after == 47 && counter.child.number == 19 && low.child.number == 19 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
