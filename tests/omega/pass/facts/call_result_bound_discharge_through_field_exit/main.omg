// A callee's `requires` discharges on a bound stored in a field.
// `reading.scale` binds `opaque()`'s closed result 4, so `echo`
// proves `scale <= 5` structurally.
//
// Expected exit: 0

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

data Reading { scale: u64; }

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) crashes Trap {
    main.hits = 0;

    let reading: Reading = Reading { scale: opaque() };
    let r: u64 = echo(reading.scale);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
