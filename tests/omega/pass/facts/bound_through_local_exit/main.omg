// A proved bound copied into a local still indexes the array.
// Expected exit: 0.
machine read_local(index: u64) -> u8
requires index < 3
{
    let values: [u8; 3] = [7, 8, 9];
    let chosen: u64 = index;
    values[chosen]
}
machine main() crashes Trap {
    transition read_local(1) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
