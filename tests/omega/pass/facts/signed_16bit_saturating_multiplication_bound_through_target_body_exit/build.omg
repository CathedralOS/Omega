machine build(builder: &mut Build) {
    Build::select_provider<SelectedVerifyTarget, CheckedVerifyTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedVerifyTarget, CheckedVerifyTarget>(builder, linux_arm64);
    Build::select_provider<SelectedVerifyTarget, CheckedVerifyTarget>(builder, macos_arm64);
    Build::select_provider<SelectedVerifyTarget, CheckedVerifyTarget>(builder, windows_x86_64);

    Build::application(builder, "signed_16bit_saturating_multiplication_bound_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
