// Fact: an 8-bit signed i8 exact multiplication of bounded inputs (lhs >= 5i8 && lhs <= 10i8, rhs >= 6i8 && rhs <= 10i8) establishes prod >= 30i8 && prod <= 100i8 so exact 8-bit signed subtraction 100i8 - prod is proved overflow-free across all nine places.
// Place: call_result. The product result is returned from a callee invocation.
// Expected exit: 0
machine verify_prod(prod: i8) -> i32
    requires prod >= 30 && prod <= 100
{
    let headroom: i8 = 100 - prod;
    (headroom - 28) as i32
}

machine mul_helper(l: i8, r: i8) -> i8
    requires l >= 5 && l <= 10 && r >= 6 && r <= 10
    ensures result >= 30 && result <= 100
{
    l * r
}

machine compute_call_result(lhs: i8, rhs: i8) -> i32
    requires lhs >= 5 && lhs <= 10 && rhs >= 6 && rhs <= 10
{
    let prod: i8 = mul_helper(lhs, rhs);
    verify_prod(prod)
}

machine evaluate() -> i32 {
    compute_call_result(8, 9)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
