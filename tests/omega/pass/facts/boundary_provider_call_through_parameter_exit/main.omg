// Fact: a provider-settled boundary call whose contract establishes result >= 100u64 && result <= 100u64 discharges exact subtraction result - 100u64.
// Place: parameter. The boundary call result passed as an explicit machine parameter.
// Expected exit: 0
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 100u64 && result <= 100u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 100u64 && result <= 100u64 {
        100
    }
}

machine run() -> u64 reaches Provider {
    compute(Provider::get())
}

machine compute(result: u64) -> u64
requires result >= 100u64 && result <= 100u64
{
    result - 100u64
}

machine main() crashes Trap {
    transition run() == 0u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
