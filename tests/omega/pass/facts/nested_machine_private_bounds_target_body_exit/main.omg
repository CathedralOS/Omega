// Every private arrival carries index < items.len, so the helper can read items[index].
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine probe(items: &[u8], index: u64, select: bool) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine probe(items: &[u8], index: u64, select: bool) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        transition index < items.len {
            true -> get(items, index)
            false -> (0)
        }
        machine get(items: &[u8], index: u64) -> u8 { items[index] }
    }
}

ArmProbe satisfies SelectedProbe {
    machine probe(items: &[u8], index: u64, select: bool) -> u8
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        transition index < items.len {
            true -> get(items, index)
            false -> (0)
        }
        machine get(items: &[u8], index: u64) -> u8 { items[index] }
    }
}


machine main() crashes Trap {
    let items: [u8; 4] = [4, 7, 8, 9];
    let first: u8 = SelectedProbe::probe(&items[..], 2, true);
    let second: u8 = SelectedProbe::probe(&items[..], 3, false);
    let outside: u8 = SelectedProbe::probe(&items[..2], 2, true);
    let empty: u8 = SelectedProbe::probe(&items[..0], 0, false);
    transition first == 8 && second == 9 && outside == 0 && empty == 0 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
