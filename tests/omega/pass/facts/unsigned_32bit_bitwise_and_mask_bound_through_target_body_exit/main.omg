// Fact: 32-bit unsigned bitwise AND mask raw & 63u32 with bounded interval 40u32 <= masked <= 63u32 establishes 40u32 <= masked <= 63u32 across all nine places so exact subtractions 63u32 - masked and masked - 40u32 are safe.
// Place: another target body. Each of four target-scoped machine bodies masks the bounded 32-bit operand and performs exact subtractions.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedMaskTarget {
    machine mask_target(raw: u32, mask: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 116u32 && raw <= 116u32 && mask == 63u32;
}

X86MaskTarget satisfies SelectedMaskTarget {
    machine mask_target(raw: u32, mask: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 116u32 && raw <= 116u32 && mask == 63u32
    {
        SelectedBodyCheck::require_tag(17u64);
        let masked: u32 = raw & mask;
        let check: u32 = (63u32 - masked) + (masked - 40u32) - 23u32;
        transition masked == 52u32 && check == 0u32 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

ArmMaskTarget satisfies SelectedMaskTarget {
    machine mask_target(raw: u32, mask: u32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires raw >= 116u32 && raw <= 116u32 && mask == 63u32
    {
        SelectedBodyCheck::require_tag(29u64);
        let masked: u32 = raw & mask;
        let check: u32 = (63u32 - masked) + (masked - 40u32) - 23u32;
        transition masked == 52u32 && check == 0u32 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

machine probe() -> i32 {
    SelectedMaskTarget::mask_target(116u32, 63u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
