// Fact: the exact selected element items[index] == 7 discharges the callee's indexed zero crash guard and returns that same 7 without a caller crash ceiling.
// Expected exit: 0
// Place: match_join.
machine maybe_zero(items: &[u64; 2], index: u64) -> u64
requires index < 2
crashes Trap items[index] == 0
{
    transition items[index] == 0 { true -> bad() false -> (items[index]) }
    machine bad() -> u64 { crash Trap; }
}
public machine read_seven(items: &[u64; 2], index: u64, flag: bool) -> u64
requires index < 2
requires items[index] == 7
{
    let selected: u64 = match flag { true -> index, false -> index };
    maybe_zero(items, selected)
}
machine main() crashes Trap {
    let items: [u64; 2] = [7, 11];
    transition items[0] == 7 { true -> finish(read_seven(&items, 0, true), &items) _ -> bad() }
    machine finish(observed: u64, items: &[u64; 2]) {
        transition observed == 7 && read_seven(items, 0, false) == 7 { true -> done() _ -> bad() }
    }
    machine done() {} machine bad() { crash Trap; }
}
