// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Place: const_name. Named constants supply operands for bitwise AND mask.
// Expected exit: 0

const RAW: u16 = 116u16;
const MASK: u16 = 63u16;

machine compute_const() -> i32 {
    let res: u16 = RAW & MASK;
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

machine probe() -> i32 {
    compute_const()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
