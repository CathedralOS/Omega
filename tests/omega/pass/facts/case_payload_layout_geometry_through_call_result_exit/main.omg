// Fact: querying size_of and align_of on a multi-variant case type establishes its exact
// discriminant-plus-payload layout geometry (size 16, align 8), discharging exact
// subtraction size - (align * 2u64) == 0u64.
// Place: call_result.
// Expected exit: 0

data Packet {
    case Empty;
    case Payload(value: u64);
}

machine get_size() -> u64 {
    size_of<Packet>()
}

machine get_align() -> u64 {
    align_of<Packet>()
}

machine main() crashes Trap {
    let diff: u64 = get_size() - (get_align() * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
