// Fact: 64-bit unsigned bitwise OR base | 32u64 with bounded interval 40u64 <= combined <= 63u64 establishes 40u64 <= combined <= 63u64 across all nine places so exact subtractions 63u64 - combined and combined - 40u64 are safe.
// Place: another state. A successor state receives bounded 64-bit operands before bitwise OR and interval discharge.
// Expected exit: 0

machine verify_combined(combined: u64) -> u64
requires combined >= 40 && combined <= 63
{
    let headroom: u64 = 63u64 - combined;
    let margin: u64 = combined - 40u64;
    headroom + margin
}

machine bitwise_or_state(base: u64) -> u64
requires base >= 16 && base <= 31
{
    transition {
        _ -> step(base)
    }
    machine step(b: u64) -> u64
    requires b >= 16 && b <= 31
    {
        let combined: u64 = b | 32u64;
        verify_combined(combined)
    }
}

machine probe() -> u64 {
    bitwise_or_state(20u64)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
