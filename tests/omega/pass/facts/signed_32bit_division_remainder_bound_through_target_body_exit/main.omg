// Fact: a 32-bit signed i32 remainder operation (dividend % divisor where dividend >= 0i32 && dividend <= 100i32, divisor >= 16i32 && divisor <= 16i32) establishes rem >= 0i32 && rem <= 15i32 so exact 32-bit signed subtraction 15i32 - rem is proved overflow-free across all nine places.
// Place: target_body. Each of four target bodies performs 32-bit remainder and verifies the bound.
// Expected exit: 0

machine verify_rem(rem: i32) -> i32
requires rem >= 0i32 && rem <= 15i32
{
    let headroom: i32 = 15i32 - rem;
    0i32
}

linux_x86_64 machine verify_target() -> i32 {
    let dividend: i32 = 43i32;
    let divisor: i32 = 16i32;
    let rem: i32 = dividend % divisor;
    verify_rem(rem)
}

linux_arm64 machine verify_target() -> i32 {
    let dividend: i32 = 43i32;
    let divisor: i32 = 16i32;
    let rem: i32 = dividend % divisor;
    verify_rem(rem)
}

macos_arm64 machine verify_target() -> i32 {
    let dividend: i32 = 43i32;
    let divisor: i32 = 16i32;
    let rem: i32 = dividend % divisor;
    verify_rem(rem)
}

windows_x86_64 machine verify_target() -> i32 {
    let dividend: i32 = 43i32;
    let divisor: i32 = 16i32;
    let rem: i32 = dividend % divisor;
    verify_rem(rem)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
