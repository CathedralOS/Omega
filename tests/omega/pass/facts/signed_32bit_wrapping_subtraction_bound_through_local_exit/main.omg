// Fact: 32-bit signed wrapping subtraction lhs -% rhs with bounded interval 40i32 <= diff <= 100i32 establishes 40i32 <= diff <= 100i32 across all nine places so exact subtractions 100i32 - diff and diff - 40i32 are safe.
// Expected exit: 0

machine verify_diff(value: i32) -> i32
requires value >= 40i32 && value <= 100i32
{
    let sub_hi: i32 = 100i32 - value;
    let sub_lo: i32 = value - 40i32;
    let diff: i32 = (sub_hi + sub_lo) - 60i32;
    transition diff == 0i32 {
        true -> 0i32
        _ -> 1i32
    }
}

machine exercise(lhs: i32 in Wrapping, rhs: i32 in Wrapping) -> i32 crashes Trap {
    let diff_wrap: i32 in Wrapping = lhs - rhs;
    let diff: i32 = diff_wrap as i32;
    transition diff >= 40i32 && diff <= 100i32 {
        true -> step(diff)
        _ -> bad()
    }
    machine step(d: i32) -> i32 {
        let val: i32 = d;
        let v: i32 = val;
        verify_diff(v)
    }
    machine bad() -> i32 { crash Trap; }
}

machine main() crashes Trap {
    let rc: i32 = exercise(100i32, 30i32);
    transition rc == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
