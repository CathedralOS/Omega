// Fact: zero-extending narrow unsigned 100u8 through u16 and u32 to u64 preserves the exact interval 100u64, discharging exact subtraction widened - 100u64 with exit code 0.
// Place: another state. A successor state receives the zero-extended value and performs exact subtraction there.
// Expected exit: 0

machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let val: u64 = ((narrow as u16) as u32) as u64;
    transition { _ -> compute(val) }
    state compute(extended: u64) -> i32 {
        let sub: u64 = extended - 100u64;
        sub as i32
    }
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
