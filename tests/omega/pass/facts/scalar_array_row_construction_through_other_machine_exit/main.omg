// A nested scalar array construction [a, b] flattens fixed-array rows into row-major element reads of their storage, preserving each row's element values across all nine places.
// Place: another machine. A forwarding machine transports the rows to the constructing machine.
// Expected exit: 0
machine pair(first: [u64; 2], second: [u64; 2]) -> [[u64; 2]; 2] {
    [first, second]
}

machine combine(a: [u64; 2], b: [u64; 2]) -> [[u64; 2]; 2] {
    pair(a, b)
}

machine main() crashes Trap {
    let result: [[u64; 2]; 2] = combine([3, 5], [7, 11]);
    transition result[0][0] == 3 && result[0][1] == 5 && result[1][0] == 7 && result[1][1] == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
