// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64 reaches Mark invokes Backend; invokes Forbidden;
}
public boundary trait Backend { machine read() -> u64 reaches Mark; }
public boundary trait Forbidden { machine read() -> u64 reaches Forbidden; }
BackendProvider satisfies Backend { machine read() -> u64 { 7 } }
ForbiddenProvider satisfies Forbidden { machine read() -> u64 { 7 } }
MarkerMark satisfies Mark { machine read() -> u64 { Backend::read() } }
data Hold { value: u64; }
machine main() crashes Trap {
    let hold: Hold = Hold { value: Mark::read() };
    transition hold.value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
