    }
    machine second(first: ActivationClaim, second: ActivationClaim) {
        ActivationClaim::release(second);
        ActivationClaim::release(first);
    }
    machine rejected(first: ActivationClaim) { ActivationClaim::release(first); crash Trap; }
    machine bad() { crash Trap; }
