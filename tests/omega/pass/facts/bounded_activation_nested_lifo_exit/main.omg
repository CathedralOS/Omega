use omega::language::core::ActivationClaim::release;
machine main() crashes Trap {
    transition Activation::try_claim<8>(3) {
        ActivationClaimAttempt::Established { claim } -> first(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    machine first(first: ActivationClaim) {
        transition Activation::try_claim<8>(3) {
            ActivationClaimAttempt::Established { claim } -> second(first, claim)
            ActivationClaimAttempt::Rejected -> rejected(first)
