// Fact: projecting a bounded field through a shared borrow preserves its exact static upper bound without moving the backing record, discharging exact subtraction 90u64 - used across all nine places.
// Place: target_body. Each hosted target body computes the shared borrow field projection and exact subtraction.
// Expected exit: 0
data Window where used <= 90, {
    used: u64;
}

linux_x86_64 machine evaluate() -> u64 {
    let window: Window = Window { used: 40 };
    let view: &Window = &window;
    let used: u64 = view.used;
    let diff: u64 = 90u64 - used;
    diff
}

linux_arm64 machine evaluate() -> u64 {
    let window: Window = Window { used: 40 };
    let view: &Window = &window;
    let used: u64 = view.used;
    let diff: u64 = 90u64 - used;
    diff
}

macos_arm64 machine evaluate() -> u64 {
    let window: Window = Window { used: 40 };
    let view: &Window = &window;
    let used: u64 = view.used;
    let diff: u64 = 90u64 - used;
    diff
}

windows_x86_64 machine evaluate() -> u64 {
    let window: Window = Window { used: 40 };
    let view: &Window = &window;
    let used: u64 = view.used;
    let diff: u64 = 90u64 - used;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate();
    transition diff == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
