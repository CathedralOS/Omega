// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.
// Expected exit: 0

data Outcome [copy] 
    requires (self in Outcome::Empty) || ((self in Outcome::Ready) && (self.value <= 50))
{
    case Empty;
    case Ready(value: u64);
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedEval {
    machine eval(outcome: Outcome) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 60;
}

X86Eval satisfies SelectedEval {
    machine eval(outcome: Outcome) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 60
    {
        SelectedBodyCheck::require_tag(17u64);
        transition outcome {
            Outcome::Ready { value } -> (value + 10)
            Outcome::Empty {} -> 0
        }
    }
}

ArmEval satisfies SelectedEval {
    machine eval(outcome: Outcome) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap ensures result <= 60
    {
        SelectedBodyCheck::require_tag(29u64);
        transition outcome {
            Outcome::Ready { value } -> (value + 10)
            Outcome::Empty {} -> 0
        }
    }
}

machine main() crashes Trap {
    let a: Outcome = Outcome::Ready { value: 32 };
    let b: Outcome = Outcome::Empty {};
    transition SelectedEval::eval(a) == 42 && SelectedEval::eval(b) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
