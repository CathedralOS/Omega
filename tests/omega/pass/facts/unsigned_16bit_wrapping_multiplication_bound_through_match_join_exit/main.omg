// Fact: 16-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u16 <= prod <= 200u16 establishes 50u16 <= prod <= 200u16 across all nine places so exact subtractions 200u16 - prod and prod - 50u16 are safe.
// Place: match_join. Both match arms produce the wrapping product joining into subtraction bounds.
// Expected exit: 0

machine choose_wrapping(flag: bool, lhs: u16, rhs: u16) -> u16
requires lhs >= 10u16 && lhs <= 20u16 && rhs >= 5u16 && rhs <= 10u16
ensures result >= 50u16 && result <= 200u16
{
    let w_lhs: u16 in Wrapping = lhs as u16 in Wrapping;
    let w_rhs: u16 in Wrapping = rhs as u16 in Wrapping;
    let prod_wrap: u16 in Wrapping = w_lhs * w_rhs;
    let prod: u16 = prod_wrap as u16;
    match flag {
        true -> prod,
        false -> prod,
    }
}

machine compute_join(lhs: u16, rhs: u16) -> i32
requires lhs >= 10u16 && lhs <= 20u16 && rhs >= 5u16 && rhs <= 10u16
{
    let prod: u16 = choose_wrapping(true, lhs, rhs);
    let headroom: u16 = 200u16 - prod;
    let margin: u16 = prod - 50u16;
    0i32
}

machine probe() -> i32 {
    compute_join(15u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
