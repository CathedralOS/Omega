// A nested scalar array construction [a, b] flattens fixed-array rows into row-major element reads of their storage, preserving each row's element values across all nine places.
// Place: another target body. Each of four target bodies constructs the same row result.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedPair {
    machine pair(a: [u64; 2], b: [u64; 2]) -> [[u64; 2]; 2]
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Pair satisfies SelectedPair {
    machine pair(a: [u64; 2], b: [u64; 2]) -> [[u64; 2]; 2]
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        [a, b]
    }
}

ArmPair satisfies SelectedPair {
    machine pair(a: [u64; 2], b: [u64; 2]) -> [[u64; 2]; 2]
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        [a, b]
    }
}


machine main() crashes Trap {
    let result: [[u64; 2]; 2] = SelectedPair::pair([3, 5], [7, 11]);
    transition result[0][0] == 3 && result[0][1] == 5 && result[1][0] == 7 && result[1][1] == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
