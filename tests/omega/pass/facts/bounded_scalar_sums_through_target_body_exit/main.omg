// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: another target body. Every target body adds the bounded operands.
// Expected exit: 0
linux_x86_64 machine add(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    a + b
}

linux_arm64 machine add(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    a + b
}

macos_arm64 machine add(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    a + b
}

windows_x86_64 machine add(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
    ensures result <= 100
{
    a + b
}

machine probe(a: u64, b: u64) -> u64
    requires a <= 50 && b <= 50
{
    add(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 70 && probe(50, 50) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
