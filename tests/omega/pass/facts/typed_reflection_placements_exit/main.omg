// Fact: authorized typed visitation borrows each non-erased field with its exact type and invokes the selected callback once in declaration order.
// Placements: local, field, parameter, call_result, match_join, const_name, other_state, other_machine.
// Each `<place>_placement` machine is the `main` of the former `typed_reflection_through_<place>_exit` fixture; `main` runs them in that order.
// Kept in its own fixture: target_body (`typed_reflection_through_target_body_exit`), which has its own build.omg.
// Expected exit: 0

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
use omega::language::core::reflect;

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
data FortyFields [copy] {
    field_0: u8;
    field_1: u16;
    field_2: u32;
    field_3: u64;
    field_4: bool;
    field_5: u8;
    field_6: u16;
    field_7: u32;
    field_8: u64;
    field_9: bool;
    field_10: u8;
    field_11: u16;
    field_12: u32;
    field_13: u64;
    field_14: bool;
    field_15: u8;
    field_16: u16;
    field_17: u32;
    field_18: u64;
    field_19: bool;
    field_20: u8;
    field_21: u16;
    field_22: u32;
    field_23: u64;
    field_24: bool;
    field_25: u8;
    field_26: u16;
    field_27: u32;
    field_28: u64;
    field_29: bool;
    field_30: u8;
    field_31: u16;
    field_32: u32;
    field_33: u64;
    field_34: bool;
    field_35: u8;
    field_36: u16;
    field_37: u32;
    field_38: u64;
    field_39: bool;
}

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
data Totals { calls: u64; sum: u64; order: u64; }

// Shared: placements local, field, parameter, call_result, match_join, const_name, other_state, other_machine state this declaration identically; it is written once.
machine observe<Kind [copy]>(context: &mut Totals, field: &reflect::FieldInfo, value: &Kind) crashes Trap
requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
{
    let number: u64 = scalar<Kind>(value);
    context.calls = ((context.calls as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
    context.sum = ((context.sum as u64 in Wrapping) + (number as u64 in Wrapping)) as u64;
    context.order = ((context.order as u64 in Wrapping) * (131u64 as u64 in Wrapping) + (number as u64 in Wrapping)) as u64;
    transition (((field.declaration_position as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64) == context.calls && field.name.len > 0u64 && field.qualified_type.len > 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
    machine scalar<Kind [copy]>(value: &Kind) -> u64
    requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
    {
        transition {
            Kind == bool -> boolean(value)
            _ -> unsigned(value)
        }
        machine unsigned(value: &Kind) -> u64
        requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64
        { value as u64 }
        machine boolean(value: &bool) -> u64 { transition value { true -> 1u64 false -> 0u64 } }
    }
}

