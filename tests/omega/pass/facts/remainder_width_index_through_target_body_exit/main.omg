// The remainder `value % width` is below `width`, so when `width` is proved
// equal to a view's length it indexes that view.
// Place: another target body. Every target body obtains the width from a
// declared measurement and selects the element.
// Expected exit: 0
machine measure(buckets: &[u8]) -> u64
requires buckets.len > 0
ensures result == buckets.len as u64
{
    buckets.len as u64
}

boundary trait SelectedReadAt {
    machine read_at(value: u64, buckets: &[u8]) -> u8 reaches
requires buckets.len > 0;
}
CheckedReadAt satisfies SelectedReadAt {
    machine read_at(value: u64, buckets: &[u8]) -> u8
requires buckets.len > 0
{
    let width: u64 = measure(buckets);
    buckets[value % width]
}
}







machine main() crashes Trap {
    let buckets: [u8; 4] = [7, 8, 9, 6];
    transition SelectedReadAt::read_at(10, &buckets[..]) == 9 && SelectedReadAt::read_at(15, &buckets[..]) == 6 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
