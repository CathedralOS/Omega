// Every private arrival supplies an integer from 0 through 255, so exact narrowing to u8 preserves its value.
// Expected exit: 0
data Note { value: u8; tag: u64; }
data Frame { prefix: u64; observed: i32; suffix: u64; }
machine probe(frame: &Frame, select: bool) -> Note {
    transition frame.observed >= 0 && frame.observed <= 255 { true -> apply(frame.observed, select) false -> Note { value: 0, tag: 0 } }
    machine apply(value: i32, select: bool) -> Note {
        let result: u8 = value as u8;
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: result, tag: tag }
    }
}
machine main() crashes Trap {
    let first_frame: Frame = Frame { prefix: 17, observed: 7, suffix: 19 };
    let second_frame: Frame = Frame { prefix: 23, observed: 231, suffix: 29 };
    let outside_frame: Frame = Frame { prefix: 31, observed: 256, suffix: 37 };
    let first: Note = probe(&first_frame, true);
    let second: Note = probe(&second_frame, false);
    let out_of_range: Note = probe(&outside_frame, true);
    transition out_of_range.value == 0 && out_of_range.tag == 0 && outside_frame.prefix == 31 && outside_frame.suffix == 37 && first.value == 7 && first.tag == 11 && second.value == 231 && second.tag == 13 && first_frame.prefix == 17 && first_frame.suffix == 19 && second_frame.prefix == 23 && second_frame.suffix == 29 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
