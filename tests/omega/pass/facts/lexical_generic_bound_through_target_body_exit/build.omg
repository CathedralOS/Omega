machine build(builder: &mut Build) {
    Build::select_provider<SelectedObtain, CheckedObtain>(builder, windows_x86_64);
    Build::select_provider<SelectedObtain, CheckedObtain>(builder, linux_x86_64);
    Build::select_provider<SelectedObtain, CheckedObtain>(builder, macos_arm64);
    Build::select_provider<SelectedObtain, CheckedObtain>(builder, linux_arm64);

    Build::application(builder, "lexical_generic_bound_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
