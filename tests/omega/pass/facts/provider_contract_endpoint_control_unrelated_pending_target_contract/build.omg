machine build(builder: &mut Build) {
    Build::application(builder, "provider_contract_endpoint_probe");
    Build::select_provider<Endpoint, Actual>(builder, linux_arm64);
    Build::select_provider<Endpoint, Actual>(builder, linux_x86_64);
    Build::select_provider<Endpoint, Actual>(builder, macos_arm64);
    Build::select_provider<Endpoint, Actual>(builder, macos_x86_64);
    Build::select_provider<Endpoint, Actual>(builder, windows_x86_64);
    Build::select_provider<Endpoint, Actual>(builder, uefi_x86_64);
    Build::select_provider<Endpoint, Actual>(builder, cross_platform_cli);
    Build::select_provider<Endpoint, Actual>(builder, local_unchecked);
    Build::select_provider<Endpoint, Actual>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedTransfer, X86Transfer>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedTransfer, ArmTransfer>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedTransfer, ArmTransfer>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedTransfer, X86Transfer>(builder, windows_x86_64);
}
