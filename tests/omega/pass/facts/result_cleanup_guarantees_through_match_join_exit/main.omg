// The shared Seed.ready == true observation survives each place into make_token(&seed), whose completed result is ready for normal shared-call cleanup.
// Expected exit: 0
data Seed [copy] { ready: bool; }
data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready { token.ready = false; }
machine make_token(seed: &Seed) -> Token
ensures result.ready == seed.ready { Token { ready: seed.ready, value: 7 } }
machine read(token: &Token) -> u64 { token.value }
machine choose(flag: bool) -> Seed ensures result.ready {
    match flag { true -> Seed { ready: true }, false -> Seed { ready: true } }
}
machine main() crashes Trap {
    let first_seed: Seed = choose(true);
    let first: u64 = read(&make_token(&first_seed));
    let seed: Seed = choose(false);
    let answer: u64 = read(&make_token(&seed));
    transition first == 7 { true -> finish(answer) false -> bad() }
    machine finish(answer: u64) {
        transition answer == 7 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
