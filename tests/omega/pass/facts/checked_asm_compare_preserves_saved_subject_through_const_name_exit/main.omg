    output.value
}

linux_arm64 machine compare(seed: u32) -> u32 requires seed == 37 ensures result == 37 {
    let mut output: AsmSavedOutput = AsmSavedOutput { value: 0 };
    asm where clobbers x0, nzcv {
    entry:
        mov w0, seed;
        cmp w0, w0;
        b.eq equal;
    different requires false:
        mov output.value, 1;
        b done;
    equal requires w0 == 37:
        mov output.value, w0;
    done requires output.value == 37 ensures (match output { AsmSavedOutput { value } -> value == 37 }):
        nop
    }
    output.value
}

macos_arm64 machine compare(seed: u32) -> u32 requires seed == 37 ensures result == 37 {
    let mut output: AsmSavedOutput = AsmSavedOutput { value: 0 };
    asm where clobbers x0, nzcv {
    entry:
        mov w0, seed;
        cmp w0, w0;
        b.eq equal;
    different requires false:
        mov output.value, 1;
        b done;
    equal requires w0 == 37:
        mov output.value, w0;
    done requires output.value == 37 ensures (match output { AsmSavedOutput { value } -> value == 37 }):
        nop
    }
    output.value
}

const SEED: u32 = 37;
machine finished() {}
machine failed() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let value: u32 = compare(SEED);
    transition value == 37 { true -> finished() false -> failed() }
}
