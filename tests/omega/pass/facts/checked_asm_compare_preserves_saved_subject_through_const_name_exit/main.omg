    let mut output: AsmSavedOutput = AsmSavedOutput { value: 0 };
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        cmp eax, eax;
        jz equal;
    different requires false:
        mov output.value, 1;
        jmp done;
    equal requires eax == 37:
        mov output.value, eax;
    done requires output.value == 37 ensures (match output { AsmSavedOutput { value } -> value == 37 }):
