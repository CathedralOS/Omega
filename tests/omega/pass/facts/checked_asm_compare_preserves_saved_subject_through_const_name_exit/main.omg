data AsmSavedOutput { value: u32; }
// Expected exit: 0.
// Comparing a register with itself establishes the zero flag without changing its value; both label edges preserve the original register.
linux_x86_64 machine compare(seed: u32) -> u32 requires seed == 37 ensures result == 37 {
    let mut output: AsmSavedOutput = AsmSavedOutput { value: 0 };
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        cmp eax, eax;
        jz equal;
    different requires false:
        mov output.value, 1;
        jmp done;
    equal requires eax == 37:
        mov output.value, eax;
    done requires output.value == 37 ensures (match output { AsmSavedOutput { value } -> value == 37 }):
        nop
    }
    output.value
}

