// Fact: 32-bit unsigned bitwise AND mask raw & 63u32 with bounded interval 40u32 <= masked <= 63u32 establishes 40u32 <= masked <= 63u32 across all nine places so exact subtractions 63u32 - masked and masked - 40u32 are safe.
// Place: local. The masked value is transported through intermediate local bindings.
// Expected exit: 0

machine mask_local(raw: u32) -> i32
requires raw >= 116u32 && raw <= 116u32
{
    let r: u32 = raw;
    let m: u32 = r & 63u32;
    let masked: u32 = m;
    let check: u32 = (63u32 - masked) + (masked - 40u32) - 23u32;
    transition masked == 52u32 && check == 0u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine probe() -> i32 {
    mask_local(116u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
