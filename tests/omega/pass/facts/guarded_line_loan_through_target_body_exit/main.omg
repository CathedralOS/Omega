// A byte owner written through a mutable loan and read through a shared loan after a selected case edge observes the written byte.
// Place: another target body.
// Expected exit: 0.
data ReadOutcome {
    case Complete(count: u64);
    case End(count: u64);
    case Full(count: u64);
    case Invalid;
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedReceive {
    machine receive(line: &mut [u8; 64]) -> ReadOutcome
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Receive satisfies SelectedReceive {
    machine receive(line: &mut [u8; 64]) -> ReadOutcome
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        line[0] = 37;
        ReadOutcome::Complete { count: 5 }
    }
}

ArmReceive satisfies SelectedReceive {
    machine receive(line: &mut [u8; 64]) -> ReadOutcome
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        line[0] = 37;
        ReadOutcome::Complete { count: 5 }
    }
}


machine observe(line: &[u8; 64], count: u64) -> u64 in Wrapping {
    (line[0] as u64 in Wrapping + count as u64 in Wrapping)
}
machine main() crashes Trap {
    let mut line: [u8; 64];
    let result: ReadOutcome = SelectedReceive::receive(&mut line);
    transition result {
        ReadOutcome::Complete { count } -> evaluate(observe(&line, count))
        ReadOutcome::End { count } -> evaluate(observe(&line, count))
        ReadOutcome::Full { count } -> done()
        ReadOutcome::Invalid -> done()
    }
    machine evaluate(value: u64 in Wrapping) {
        transition value == 42 {
            true -> done()
            false -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
