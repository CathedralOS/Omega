// Fact: 64-bit unsigned bitwise AND mask raw & 63u64 with bounded interval 40u64 <= masked <= 63u64 establishes 40u64 <= masked <= 63u64 across all nine places so exact subtractions 63u64 - masked and masked - 40u64 are safe.
// Expected exit: 0

machine verify_masked(value: u64) -> u64
requires value >= 40u64 && value <= 63u64
{
    let headroom: u64 = 63u64 - value;
    let margin: u64 = value - 40u64;
    transition headroom == 11u64 && margin == 12u64 {
        true -> 0u64
        _ -> 1u64
    }
}

machine compute_masked(raw: u64) -> u64 crashes Trap
ensures result >= 40u64 && result <= 63u64
{
    let masked: u64 = raw & 63u64;
    transition masked >= 40u64 && masked <= 63u64 {
        true -> pass(masked)
        _ -> bad()
    }
    machine pass(m: u64) -> u64 { m }
    machine bad() -> u64 { crash Trap; }
}

machine exercise(raw: u64) -> u64 crashes Trap {
    let masked: u64 = compute_masked(raw);
    verify_masked(masked)
}

machine main() crashes Trap {
    let rc: u64 = exercise(116u64);
    transition rc == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
