// Expected exit: 0
// An admitted no-wrap domain predicate proves base + requested fits addr when requested < length.
// Geometry is numeric evidence, not a storage claim.
data Region { base: addr; length: u64; }
let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;
domain Region::Bounded
requires no_wrap(self.base, self.length);
machine region(base: addr, length: u64, endpoint: addr) -> Region in Bounded
requires embed(base) + embed(length) <= embed(endpoint)
ensures result.base == base && result.length == length
{ Region { base: base, length: length } }
boundary trait SelectedCut {
    machine cut(whole: Region in Bounded, requested: u64) -> addr reaches
requires requested < whole.length;
}
CheckedCut satisfies SelectedCut {
    machine cut(whole: Region in Bounded, requested: u64) -> addr
requires requested < whole.length
{ whole.base + requested }
}






machine main() crashes Trap {
    let whole: Region in Bounded = region(10, 80, 100);
    let address: addr = SelectedCut::cut(whole, 20);
    transition address == 30 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
