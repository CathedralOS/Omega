// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 50u8 && narrow <= 180u8) to u64 (narrow as u64) preserves the exact interval (wide >= 50u64 && wide <= 180u64), discharging exact 64-bit subtractions 180u64 - wide and wide - 50u64 across all nine places.
// Expected exit: 0

linux_x86_64 machine target_probe(narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    let wide: u64 = narrow as u64;
    let headroom: u64 = 180u64 - wide;
    let margin: u64 = wide - 50u64;
    headroom + margin
}

linux_arm64 machine target_probe(narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    let wide: u64 = narrow as u64;
    let headroom: u64 = 180u64 - wide;
    let margin: u64 = wide - 50u64;
    headroom + margin
}

macos_arm64 machine target_probe(narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    let wide: u64 = narrow as u64;
    let headroom: u64 = 180u64 - wide;
    let margin: u64 = wide - 50u64;
    headroom + margin
}

windows_x86_64 machine target_probe(narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    let wide: u64 = narrow as u64;
    let headroom: u64 = 180u64 - wide;
    let margin: u64 = wide - 50u64;
    headroom + margin
}

machine probe(narrow: u8) -> u64
    requires narrow >= 50u8 && narrow <= 180u8
{
    target_probe(narrow)
}

machine main() crashes Trap {
    let combined: u64 = probe(110u8);
    transition combined == 130u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
