windows_x86_64 machine observe(item: &mut Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.other);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> finish(agreed, held) }
    machine finish(agreed: f64, held: f64) -> f64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

machine main() crashes Trap {
    let mut item: Ends = Ends { kept: 7.0, other: 1.0 };
    transition observe(&mut item) == 7.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
