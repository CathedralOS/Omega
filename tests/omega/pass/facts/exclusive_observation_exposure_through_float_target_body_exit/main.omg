// A saved observation that the kept float is 7 stays provable across an exclusive loan of a different float.
// Expected exit: 0
data Ends { kept: f64; other: f64; }
machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}

machine expose(slot: &mut f64) -> f64 {
    slot
}

linux_x86_64 machine observe(item: &mut Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.other);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> finish(agreed, held) }
    machine finish(agreed: f64, held: f64) -> f64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

linux_arm64 machine observe(item: &mut Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.other);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> finish(agreed, held) }
    machine finish(agreed: f64, held: f64) -> f64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

macos_arm64 machine observe(item: &mut Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.other);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> finish(agreed, held) }
    machine finish(agreed: f64, held: f64) -> f64 {
