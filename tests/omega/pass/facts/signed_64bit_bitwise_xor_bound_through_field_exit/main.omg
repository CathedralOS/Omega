// Fact: 64-bit signed bitwise XOR raw ^ 15i64 with bounded interval 40i64 <= xored <= 63i64 establishes 40i64 <= xored <= 63i64 across all nine places so exact subtractions 63i64 - xored and xored - 40i64 are safe.
// Place: field. The bitwise XOR result is stored and loaded through a record field.
// Expected exit: 0
machine verify_xored(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

data Carrier {
    xored: i64;
}

machine compute_field(raw: i64) -> i32
    requires raw >= 59 && raw <= 59
{
    let c: Carrier = Carrier { xored: raw ^ 15 };
    verify_xored(c.xored)
}

machine evaluate() -> i32 {
    compute_field(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
