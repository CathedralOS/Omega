// Expected exit: 0
machine positive_divisor(value: i64, divisor: i64) -> i64
requires value >= -7 && value <= -5 && divisor >= 4 && divisor <= 5;
ensures result == value + divisor;
{ value % divisor }
machine negative_divisor(value: i64, divisor: i64) -> i64
requires value >= -7 && value <= -5 && divisor >= -5 && divisor <= -4;
ensures result == value - divisor;
{ value % divisor }
machine main() crashes Trap {
    let a: i64 = positive_divisor(-7, 4);
    let b: i64 = positive_divisor(-7, 5);
    let c: i64 = positive_divisor(-5, 5);
    let d: i64 = negative_divisor(-7, -4);
    let e: i64 = negative_divisor(-7, -5);
    let f: i64 = negative_divisor(-5, -5);
    transition a == -3 && b == -2 && c == 0 && d == -3 && e == -2 && f == 0 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
