use omega::language::core::CountedQuantity;
use omega::language::core::Content;
public data Unit {}
public data Token [linear] { value: u64; }
public domain Token::Owned established by issue;
machine issue() -> Token in Owned { Token { value: 17 } }
machine Owned::content(token: &Token) -> CountedQuantity<Unit>
satisfies Content<Token, CountedQuantity<Unit>>::project {
    CountedQuantity { magnitude: embed(token.value) as Nat }
}
public data Envelope [linear] { token: Token in Owned; }
boundary trait Carrier {
    machine wrap(token: Token in Owned) -> Envelope reaches;
    machine unwrap(envelope: Envelope) -> Token in Owned reaches;
}
machine roundtrip(token: Token in Owned) -> Token in Owned {
    let envelope: Envelope = Carrier::wrap(token);
    Carrier::unwrap(envelope)
}
machine main() {}
