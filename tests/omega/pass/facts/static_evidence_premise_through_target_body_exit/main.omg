// A call premise is a static evidence argument. The call records that
// evidence, and the caller reads the record. A supplied witness does
// not discharge a Boolean premise by itself.
// Place: target_body.
// Expected exit: 0
trait Kept {
    machine holds(value: bool) -> bool terminates;
}

data Yes {}
machine Yes::holds(value: bool) -> bool terminates { true }

YesKept satisfies Kept {
    machine holds(value: bool) -> bool terminates { Yes::holds(value) }
}

data No {}
machine No::holds(value: bool) -> bool terminates { false }

NoKept satisfies Kept {
    machine holds(value: bool) -> bool terminates { No::holds(value) }
}

machine project<Proof satisfies Kept>(kept: bool) -> bool
requires kept == true
requires Proof::holds(kept)
{
    Proof::holds(kept)
}

machine hold(direct: bool) -> bool
requires direct == true
{
    true
}


boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedObserve {
    machine observe() -> bool reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86Observe satisfies SelectedObserve {
    machine observe() -> bool reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let kept: bool = true;
        let direct: bool = project<YesKept>(kept);
        hold(direct)
    }
}
ArmObserve satisfies SelectedObserve {
    machine observe() -> bool reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let kept: bool = true;
        let direct: bool = project<YesKept>(kept);
        hold(direct)
    }
}


machine main() crashes Trap {
    transition SelectedObserve::observe() {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
