// Case membership and the complete predicate recover the payload type and ordered bounds through the transported value.
// Expected exit: 0.
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
        || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
data NamedValue [copy] {
    case Integer(value: i32);
    case Boolean(value: bool);
}
domain<T> NamedValue::Typed<T>
    requires ((self in NamedValue::Integer) && T == i32)
        || ((self in NamedValue::Boolean) && T == bool);
data Interval<const Bound: u64> [copy]
    requires (self in Interval::Empty)
        || ((self in Interval::Range) && self.lo <= self.hi && self.hi <= Bound)
{
    case Empty;
    case Range(lo: u64, hi: u64);
}
data NamedInterval [copy] {
    case Empty;
    case Range(lo: u64, hi: u64);
}
domain<const Bound: u64> NamedInterval::Ordered<Bound>
    requires (self in NamedInterval::Empty)
        || ((self in NamedInterval::Range) && self.lo <= self.hi && self.hi <= Bound);
domain<const Bound: u64> u64::AtMost<Bound> requires self <= Bound;
machine pick<T>(value: Value<T>) -> T {
    match value {
        Value::Integer { value } -> value
        Value::Boolean { value } -> value
    }
}
machine pick_named<T>(value: NamedValue in Typed<T>) -> T {
    match value {
        NamedValue::Integer { value } -> value
        NamedValue::Boolean { value } -> value
    }
}
machine width(span: Interval<32>) -> u64 {
    match span {
        Interval::Empty -> 77
        Interval::Range { lo, hi } -> width_range(lo, hi)
    }
}
machine width_named(span: NamedInterval in Ordered<32>) -> u64 {
    match span {
        NamedInterval::Empty -> 77
        NamedInterval::Range { lo, hi } -> width_range(lo, hi)
    }
}
machine width_range(lo: u64, hi: u64) -> u64 requires lo <= hi && hi <= 32 {
    let qualified: u64 in AtMost<32> = lo as u64 in AtMost<32>;
    hi - (qualified as u64)
}
data Bundle [copy] {
    front: u64;
    number: Value<i32>;
    flag: Value<bool>;
    span: Interval<32>;
    named_number: NamedValue in Typed<i32>;
    named_flag: NamedValue in Typed<bool>;
    named_span: NamedInterval in Ordered<32>;
    back: u64;
}
machine observe(value: Bundle, expected_number: i32, expected_flag: bool, expected_width: u64, expected_named_number: i32, expected_named_flag: bool, expected_named_width: u64) -> bool {
    value.front == 0x0123_4567 && value.back == 0xFEDC_BA98
        && pick<i32>(value.number) == expected_number
        && pick<bool>(value.flag) == expected_flag
        && width(value.span) == expected_width
        && pick_named<i32>(value.named_number) == expected_named_number
        && pick_named<bool>(value.named_flag) == expected_named_flag
        && width_named(value.named_span) == expected_named_width
        && raw_case(value.named_number as NamedValue) == 1
        && raw_case(value.named_flag as NamedValue) == 2
}
machine first() -> Bundle { Bundle {
    front: 0x0123_4567,
    number: Value::Integer { value: 42 },
    flag: Value::Boolean { value: true },
    span: Interval::Range { lo: 17, hi: 21 },
    named_number: (NamedValue::Integer { value: -7 }) as NamedValue in Typed<i32>,
    named_flag: (NamedValue::Boolean { value: false }) as NamedValue in Typed<bool>,
    named_span: (NamedInterval::Range { lo: 3, hi: 9 }) as NamedInterval in Ordered<32>,
    back: 0xFEDC_BA98
} }
machine second() -> Bundle { Bundle {
    front: 0x0123_4567,
    number: Value::Integer { value: -13 },
    flag: Value::Boolean { value: false },
    span: Interval::Empty,
    named_number: (NamedValue::Integer { value: 23 }) as NamedValue in Typed<i32>,
    named_flag: (NamedValue::Boolean { value: true }) as NamedValue in Typed<bool>,
    named_span: NamedInterval::Empty as NamedInterval in Ordered<32>,
    back: 0xFEDC_BA98
} }
machine raw_case(value: NamedValue) -> u64 {
    match value {
        NamedValue::Integer { .. } -> 1
        NamedValue::Boolean { .. } -> 2
    }
}
machine transport(held: Bundle) -> Bundle { held }
machine main() crashes Trap {
    let left: Bundle = transport(first());
    let right: Bundle = transport(second());
    transition observe(left, 42, true, 4, -7, false, 6) && observe(right, -13, false, 77, 23, true, 77) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
