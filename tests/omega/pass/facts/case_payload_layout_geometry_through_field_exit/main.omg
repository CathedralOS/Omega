// Fact: querying size_of and align_of on a multi-variant case type establishes its exact
// discriminant-plus-payload layout geometry (size 16, align 8), discharging exact
// subtraction size - (align * 2u64) == 0u64.
// Place: field.
// Expected exit: 0

data Packet {
    case Empty;
    case Payload(value: u64);
}

data GeometryCarrier {
    size: u64;
    align: u64;
}

machine main() crashes Trap {
    let carrier: GeometryCarrier = GeometryCarrier {
        size: size_of<Packet>(),
        align: align_of<Packet>(),
    };
    let diff: u64 = carrier.size - (carrier.align * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
