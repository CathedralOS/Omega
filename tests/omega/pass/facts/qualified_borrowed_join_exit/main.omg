// Expected exit: 0
// Incoming membership survives a shared-reference join without widening access.
data Region { base: addr; length: u64; }
let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;
domain Region::Bounded(region) requires no_wrap(region.base, region.length);
machine region(base: addr, length: u64, endpoint: addr) -> Region in Bounded
requires embed(base) + embed(length) <= embed(endpoint)
ensures result.base == base && result.length == length
{ Region { base: base, length: length } }
machine choose(left: &Region in Bounded, right: &Region in Bounded,
               requested: u64, flag: bool) -> addr
requires requested < left.length && requested < right.length
{
    let selected: &Region in Bounded = match flag { true -> left, false -> right };
    selected.base + requested
}
machine main() crashes Trap {
    let left: Region in Bounded = region(10, 80, 100);
    let right: Region in Bounded = region(20, 80, 100);
    let first: addr = choose(&left, &right, 20, true);
    let second: addr = choose(&left, &right, 20, false);
    transition first == 30 && second == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
