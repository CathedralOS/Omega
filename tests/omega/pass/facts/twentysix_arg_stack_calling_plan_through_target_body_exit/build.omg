machine build(builder: &mut Build) {
    Build::select_provider<SelectedEvaluate26, CheckedEvaluate26>(builder, linux_x86_64);
    Build::select_provider<SelectedEvaluate26, CheckedEvaluate26>(builder, linux_arm64);
    Build::select_provider<SelectedEvaluate26, CheckedEvaluate26>(builder, macos_arm64);
    Build::select_provider<SelectedEvaluate26, CheckedEvaluate26>(builder, windows_x86_64);

    Build::application(builder, "twentysix_arg_stack_calling_plan_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
