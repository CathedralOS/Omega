// Fact: subtracting two bounded 32-bit unsigned u32 values (lhs >= 80u32 && lhs <= 120u32, rhs >= 20u32 && rhs <= 40u32) establishes the exact post-subtraction interval (diff >= 40u32 && diff <= 100u32), discharging exact 32-bit subtractions 100u32 - diff and diff - 40u32 across all nine places.
// Expected exit: 0

machine compute_diff(lhs: u32, rhs: u32) -> u32
    requires lhs >= 80 && lhs <= 120, rhs >= 20 && rhs <= 40
{
    lhs - rhs
}

machine verify_diff(diff: u32) -> i32
    requires diff >= 40 && diff <= 100
{
    let headroom: u32 = 100 - diff;
    let margin: u32 = diff - 40;
    let sum: i32 = (headroom as i32) + (margin as i32);
    let check: i32 = sum - 60;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u32) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 100;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u32) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_diff(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u32) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_diff(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: u32 = 100;
    let rhs: u32 = 30;
    let diff: u32 = compute_diff(lhs, rhs);
    let check: i32 = SelectedProbe::exercise(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
