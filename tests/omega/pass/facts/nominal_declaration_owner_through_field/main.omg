// A library Token retains its declaring owner when it reaches library::read.
// Expected exit: 0
use shared::library::Token;
use shared::library::read;
data Holder { token: Token; }
machine transported() -> u8 { let holder: Holder = Holder { token: Token { value: 7 } }; read(holder.token) }
machine main() crashes Trap {
    transition transported() == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
