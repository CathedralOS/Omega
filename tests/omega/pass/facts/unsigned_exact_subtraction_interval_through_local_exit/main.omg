// Fact: Subtracting two bounded unsigned u64 values (minuend >= 80u64 && minuend <= 100u64 and subtrahend >= 20u64 && subtrahend <= 30u64) establishes the exact post-subtraction interval (diff >= 50u64 && diff <= 80u64), discharging both diff - 50u64 and 80u64 - diff across all nine places.
// Place: local. Both bounded unsigned u64 operands and their difference are transported through local bindings.
// Expected exit: 0
machine subtract_local(minuend: u64, subtrahend: u64) -> i32
    requires minuend >= 80 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: u64 = minuend - subtrahend;
    let val: u64 = diff;
    let transported: u64 = val;
    let lower: u64 = transported - 50;
    let upper: u64 = 80 - transported;
    let sum: u64 = lower + upper;
    sum as i32
}

machine evaluate() -> i32 {
    subtract_local(90, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
