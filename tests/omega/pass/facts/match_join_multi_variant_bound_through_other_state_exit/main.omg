// Exhaustively matching a three-variant case value where every arm establishes joined >= 20u64 && joined <= 60u64 preserves the joined interval bound across all nine places, discharging exact subtraction 60u64 - joined and joined - 20u64.
// Expected exit: 0

data Mode [copy] 
    requires ((self in Mode::Low) && (self.val >= 20 && self.val <= 60)) || ((self in Mode::Mid) && (self.val >= 20 && self.val <= 60)) || ((self in Mode::High) && (self.val >= 20 && self.val <= 60))
{
    case Low(val: u64);
    case Mid(val: u64);
    case High(val: u64);
}

machine evaluate(mode: Mode) -> u64 {
    transition mode {
        Mode::Low { val } -> val
        Mode::Mid { val } -> val
        Mode::High { val } -> val
    }
}

// `run` receives `mode` as a parameter, so the payload is known only through
// `Mode`'s requirement. The joined result reaches the nested `step` through its
// one private arrival, which must carry the recorded [20, 60] bound.
machine run(mode: Mode) crashes Trap {
    let joined: u64 = evaluate(mode);
    transition true {
        true -> step(joined)
        _ -> bad()
    }
    machine step(val: u64) {
        let diff1: u64 = 60u64 - val;
        let diff2: u64 = val - 20u64;
        transition diff1 == 20 && diff2 == 20 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    run(Mode::Mid { val: 40 });
}
