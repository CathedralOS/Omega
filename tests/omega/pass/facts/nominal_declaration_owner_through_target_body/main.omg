// A library Token retains its declaring owner when it reaches library::read.
// Expected exit: 0
use shared::library::Token;
use shared::library::read;
boundary trait SelectedReceive {
    machine receive(token: Token) -> u8 reaches
;
}
CheckedReceive satisfies SelectedReceive {
    machine receive(token: Token) -> u8
{ read(token) }
}



machine transported() -> u8 { SelectedReceive::receive(Token { value: 7 }) }
machine main() crashes Trap {
    transition transported() == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
