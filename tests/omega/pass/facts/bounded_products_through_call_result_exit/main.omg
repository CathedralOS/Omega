// Bounded u64 factors a <= 50 and b <= 50 make a * b fit in result <= 2500 without a domain or widening.
// Place: call result. Both operands arrive from calls with declared result ranges.
// Expected exit: 0
machine supply(value: u64) -> u64
requires value <= 50
ensures result <= 50
{
    value
}

machine mul(left: u64, right: u64) -> u64
requires left <= 50 && right <= 50
ensures result <= 2500
{
    supply(left) * supply(right)
}

machine probe(a: u64, b: u64) -> u64
requires a <= 50 && b <= 50
ensures result <= 2500
{
    mul(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
