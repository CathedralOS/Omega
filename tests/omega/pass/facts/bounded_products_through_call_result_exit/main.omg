// Bounded u64 operands `a [0..=50]` and `b [0..=50]` make the exact product
// `a * b` fit `u64 [0..=2500]`; no Wrapping domain and no `as`.
// Place: call result. Both operands arrive from calls with declared result ranges.
// Expected exit: 0
machine supply(value: u64 [0..=50]) -> u64 [0..=50] {
    value
}

machine mul(left: u64 [0..=50], right: u64 [0..=50]) -> u64 [0..=2500] {
    supply(left) * supply(right)
}

machine probe(a: u64 [0..=50], b: u64 [0..=50]) -> u64 [0..=2500] {
    mul(a, b)
}

machine main() crashes Trap {
    transition probe(30, 40) == 1200 && probe(50, 50) == 2500 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
