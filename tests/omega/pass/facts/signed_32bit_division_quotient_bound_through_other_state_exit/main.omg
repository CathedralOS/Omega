// Fact: a 32-bit signed i32 division of bounded inputs (dividend >= 200i32 && dividend <= 200i32, divisor >= 5i32 && divisor <= 5i32) establishes quotient >= 40i32 && quotient <= 40i32 so exact 32-bit signed subtraction quotient - 40i32 is proved overflow-free across all nine places.
// Place: other_state. A successor state receives the 32-bit quotient and verifies the subtraction contract.
// Expected exit: 0

machine verify_quotient(quotient: i32) -> i32
requires quotient >= 40i32 && quotient <= 40i32
{
    quotient - 40i32
}

machine verify_state(dividend: i32, divisor: i32) -> i32
requires dividend >= 200i32 && dividend <= 200i32 && divisor >= 5i32 && divisor <= 5i32
{
    transition {
        _ -> step(dividend / divisor)
    }
    machine step(quotient: i32) -> i32
    requires quotient >= 40i32 && quotient <= 40i32
    {
        verify_quotient(quotient)
    }
}

machine probe() -> i32 {
    verify_state(200i32, 5i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
