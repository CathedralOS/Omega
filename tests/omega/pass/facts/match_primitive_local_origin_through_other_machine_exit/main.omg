// A match selects a primitive local, the join records that local as the origin, and the consumer reads the recorded value.
// Place: other_machine.
// Expected exit: 0

machine choose() -> bool
ensures result == true
{
    true
}

machine read_origin(value: i64) -> i64
requires value == 17
{
    value
}

machine apply(chosen: i64, spare: i64) -> i64 {
    let joined: i64 = match choose() {
        true -> chosen
        false -> spare
    };

    read_origin(joined)
}

machine forward(chosen: i64, spare: i64) -> i64 {
    apply(chosen, spare)
}

machine main() crashes Trap {
    let observed: i64 = forward(17, 5);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
