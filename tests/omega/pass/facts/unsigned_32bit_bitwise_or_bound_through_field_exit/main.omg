// Fact: 32-bit unsigned bitwise OR base | 32u32 with bounded interval 40u32 <= combined <= 63u32 establishes 40u32 <= combined <= 63u32 across all nine places so exact subtractions 63u32 - combined and combined - 40u32 are safe.
// Place: field. The bitwise OR result is stored and loaded through a record field.
// Expected exit: 0
machine verify_combined(res: u32) -> u32
    requires res >= 40 && res <= 63
{
    let head: u32 = 63 - res;
    let tail: u32 = res - 40;
    head + tail
}

data Carrier {
    combined: u32;
}

machine compute_field(base: u32) -> u32
    requires base >= 20 && base <= 20
{
    let c: Carrier = Carrier { combined: base | 32 };
    verify_combined(c.combined)
}

machine evaluate() -> u32 {
    compute_field(20)
}

machine main() crashes Trap {
    let res: u32 = evaluate();
    transition res == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
