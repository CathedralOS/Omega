// A match subject is one evaluation of a computed root, the selected exclusive loan records that root, and the consumer writes 41 through that recorded loan.
// Place: match_join.
// Expected exit: 0


machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = 1;
    0
}

machine main() crashes Trap {
    let mut chosen: [i64; 2] = [17, 5];
    let mut other: [i64; 2] = [0, 8];
    let mut visits: u64 = 0;
    let flag: bool = true;
    let index: u64 = match flag {
        true -> compute(&mut visits)
        false -> 0
    };
    let selected: &mut i64 = match chosen[index] {
        17 -> &mut chosen[0]
        _ -> &mut other[0]
    };
    selected = 41;
    transition chosen[0] == 41 && chosen[1] == 5 && other[0] == 0 && visits == 1 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
