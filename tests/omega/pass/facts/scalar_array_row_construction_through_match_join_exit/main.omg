// A nested scalar array construction [a, b] flattens fixed-array rows into row-major element reads of their storage, preserving each row's element values across all nine places.
// Place: match join. A match join binds one row before construction.
// Expected exit: 0
machine pair(flag: bool, b: [u64; 2]) -> [[u64; 2]; 2] {
    let a: [u64; 2] = match flag { true -> [3, 5], false -> [3, 5] };
    [a, b]
}

machine main() crashes Trap {
    let result: [[u64; 2]; 2] = pair(true, [7, 11]);
    transition result[0][0] == 3 && result[0][1] == 5 && result[1][0] == 7 && result[1][1] == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
