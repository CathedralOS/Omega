// Fact: a ten-argument weighted scalar call preserves exact positional argument order across register and stack ABI slots when subtracting 100u64.
// Place: another state. Successor state receives arguments and evaluates the call.
// Expected exit: 0

machine weighted_ten_sum(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64
) -> u64
requires
    a1 == 1u64 && a2 == 2u64 && a3 == 3u64 && a4 == 4u64 && a5 == 5u64 &&
    a6 == 6u64 && a7 == 7u64 && a8 == 8u64 && a9 == 24u64 && a10 == 40u64
ensures
    result == 100u64
{
    a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10
}

machine probe() -> u64
ensures
    result == 0u64
{
    transition {
        _ -> step(1, 2, 3, 4, 5, 6, 7, 8, 24, 40)
    }
    machine step(
        s1: u64, s2: u64, s3: u64, s4: u64, s5: u64,
        s6: u64, s7: u64, s8: u64, s9: u64, s10: u64
    ) -> u64
    requires
        s1 == 1u64 && s2 == 2u64 && s3 == 3u64 && s4 == 4u64 && s5 == 5u64 &&
        s6 == 6u64 && s7 == 7u64 && s8 == 8u64 && s9 == 24u64 && s10 == 40u64
    {
        let total: u64 = weighted_ten_sum(s1, s2, s3, s4, s5, s6, s7, s8, s9, s10);
        total - 100
    }
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
