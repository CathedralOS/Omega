machine build(builder: &mut Build) {
    Build::select_provider<SelectedPayloadTarget, CheckedPayloadTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedPayloadTarget, CheckedPayloadTarget>(builder, linux_arm64);
    Build::select_provider<SelectedPayloadTarget, CheckedPayloadTarget>(builder, macos_arm64);
    Build::select_provider<SelectedPayloadTarget, CheckedPayloadTarget>(builder, windows_x86_64);

    Build::application(builder, "five_variant_enum_payload_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
