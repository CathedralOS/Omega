// The case-dependent default domain admits only `Boolean` on `Value<bool>`
// and establishes `lo <= hi` with `hi <= 32` on `Range`, so the typed
// extractor consumes the Boolean payload and `hi - lo` is exact — the same
// `<=` bound predicate re-admitted as the named generic domain
// `u64::AtMost<32>` on the guarded `lo`.
// Expected exit: 0.
domain<const Bound: u64> u64::AtMost<Bound> requires self <= Bound;
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
data Interval [copy]
    requires (self in Interval::Empty)
       || ((self in Interval::Range) && self.lo <= self.hi && self.hi <= 32)
{
    case Empty;
    case Range(lo: u64, hi: u64);
}
machine pick(v: Value<bool>) -> bool {
    match v {
        Value::Boolean { value } -> value
    }
}
machine width_range(lo: u64, hi: u64) -> u64 requires lo <= hi && hi <= 32 {
    let qualified_lo: u64 in AtMost<32> = lo as u64 in AtMost<32>;
    hi - (qualified_lo as u64)
}
machine width(span: Interval) -> u64 {
    match span {
        Interval::Range { lo, hi } -> width_range(lo, hi)
        Interval::Empty -> 0
    }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedConsume {
    machine consume(marked: Value<bool>, span: Interval) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Consume satisfies SelectedConsume {
    machine consume(marked: Value<bool>, span: Interval) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     pick(marked) && width(span) == 4 
    }
}

ArmConsume satisfies SelectedConsume {
    machine consume(marked: Value<bool>, span: Interval) -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     pick(marked) && width(span) == 4 
    }
}


machine probe() -> bool {
    SelectedConsume::consume(Value::Boolean { value: true }, Interval::Range { lo: 17, hi: 21 })
}
machine main() crashes Trap {
    transition probe() == true {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
