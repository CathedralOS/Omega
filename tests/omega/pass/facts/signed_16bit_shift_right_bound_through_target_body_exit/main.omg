// Fact: a 16-bit signed i16 arithmetic right shift of a bounded input (val >= 480i16 && val <= 480i16) by 2u32 bits establishes shifted >= 120i16 && shifted <= 120i16 so exact 16-bit signed subtraction shifted - 120i16 is proved overflow-free across all nine places.
// Place: target_body. Each hosted target body computes the 16-bit signed arithmetic right shift and verifies the bounds.
// Expected exit: 0
machine verify_shifted(shifted: i16) -> i32
    requires shifted >= 120 && shifted <= 120
{
    let sub: i16 = shifted - 120;
    sub as i32
}

linux_x86_64 machine compute_target_body(val: i16) -> i32
    requires val >= 480 && val <= 480
{
    let shifted: i16 = val >> 2u32;
    verify_shifted(shifted)
}

linux_arm64 machine compute_target_body(val: i16) -> i32
    requires val >= 480 && val <= 480
{
    let shifted: i16 = val >> 2u32;
    verify_shifted(shifted)
}

macos_arm64 machine compute_target_body(val: i16) -> i32
    requires val >= 480 && val <= 480
{
    let shifted: i16 = val >> 2u32;
    verify_shifted(shifted)
}

windows_x86_64 machine compute_target_body(val: i16) -> i32
    requires val >= 480 && val <= 480
{
    let shifted: i16 = val >> 2u32;
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_target_body(480)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
