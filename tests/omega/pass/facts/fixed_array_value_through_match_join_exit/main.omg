// A fixed-extent array [u64; 2] preserves its in-bounds index contract index < 2 and independent element values across all nine places.
// Place: match join. Both branches of a match expression produce in-bounds indices.
// Expected exit: 0
machine read_element(values: [u64; 2], index: u64, flag: bool) -> u64
requires index < 2
{
    let joined_index: u64 = match flag { true -> index, false -> 0 };
    values[joined_index]
}

machine main() crashes Trap {
    let values: [u64; 2] = [19, 42];
    transition values[0] == 19 && values[1] == 42 && read_element(values, 1, true) == 42 && read_element(values, 1, false) == 19 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
