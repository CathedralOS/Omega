// A statement-position call of the generic boundary requirement `Mark::record<T>` from a generic
// caller applies the caller's open `T` to the requirement's formals, so the provider's write of
// `label` into `hits` is observed after the call.
// Place: target_body.
// Expected exit: 0
boundary trait Mark {
    machine record<T>(value: &T, label: u64, hits: &mut u64) reaches;
}

LinuxX8664Counting satisfies Mark {
    machine record<T>(value: &T, label: u64, hits: &mut u64) { hits = label; }
}

LinuxArm64Counting satisfies Mark {
    machine record<T>(subject: &T, mark: u64, cell: &mut u64) { cell = mark; }
}

MacosArm64Counting satisfies Mark {
    machine record<T>(item: &T, code: u64, slot: &mut u64) { slot = code; }
}

WindowsX8664Counting satisfies Mark {
    machine record<T>(operand: &T, tag: u64, target: &mut u64) { target = tag; }
}

machine notify<T>(value: &T, label: u64, hits: &mut u64) {
    Mark::record<T>(value, label, hits);
}

machine main() crashes Trap {
    let subject: i32 = 7;
    let other: u8 = 3;
    let mut first: u64 = 0;
    let mut second: u64 = 0;
    notify<i32>(&subject, 9, &mut first);
    notify<u8>(&other, 5, &mut second);
    transition first == 9 && second == 5 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
