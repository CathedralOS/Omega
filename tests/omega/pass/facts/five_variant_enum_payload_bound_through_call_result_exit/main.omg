// Fact: matching a 5-variant tagged enum payload Packet { Alpha(u64), Beta(u64), Gamma(u64), Delta(u64), Epsilon(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: call result. A contracted helper call returns the 5-variant packet before matching and interval discharge.
// Expected exit: 0

data Packet [copy] {
    case Alpha(v: u64) where v >= 40 && v <= 80;
    case Beta(v: u64) where v >= 40 && v <= 80;
    case Gamma(v: u64) where v >= 40 && v <= 80;
    case Delta(v: u64) where v >= 40 && v <= 80;
    case Epsilon(v: u64) where v >= 40 && v <= 80;
}

machine extract_payload(p: Packet) -> u64
ensures result >= 40 && result <= 80
{
    transition p {
        Packet::Alpha { v } -> v
        Packet::Beta { v } -> v
        Packet::Gamma { v } -> v
        Packet::Delta { v } -> v
        Packet::Epsilon { v } -> v
    }
}

machine verify_payload(res: u64) -> u64
requires res >= 40 && res <= 80
{
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine make_packet() -> Packet {
    Packet::Epsilon { v: 60u64 }
}

machine payload_call() -> u64 {
    let p: Packet = make_packet();
    let res: u64 = extract_payload(p);
    verify_payload(res)
}

machine probe() -> u64 {
    payload_call()
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

