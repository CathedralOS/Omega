// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Place: other machine. A forwarding machine transports operands to the shift machine.
// Expected exit: 0

machine perform_shift(val: u64, shift: u64) -> u64
requires val >= 400 && val <= 400 && shift >= 2 && shift <= 2
ensures result == 0
{
    let shifted: u64 = val >> shift;
    shifted - 100
}

machine forward(val: u64, shift: u64) -> u64
requires val >= 400 && val <= 400 && shift >= 2 && shift <= 2
ensures result == 0
{
    perform_shift(val, shift)
}

machine main() crashes Trap {
    let res: u64 = forward(400, 2);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
