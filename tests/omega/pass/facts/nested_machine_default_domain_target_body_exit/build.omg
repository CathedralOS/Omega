machine build(builder: &mut Build) {
    Build::select_provider<HostedProbe, HostedProbeBody>(builder, windows_x86_64);
    Build::select_provider<HostedProbe, HostedProbeBody>(builder, linux_x86_64);
    Build::select_provider<HostedProbe, HostedProbeBody>(builder, linux_arm64);
    Build::select_provider<HostedProbe, HostedProbeBody>(builder, macos_arm64);
    Build::application(builder, "default_domain_increment_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
