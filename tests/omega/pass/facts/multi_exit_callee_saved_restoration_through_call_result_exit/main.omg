// Fact: a multi-return callee with interior call pressure restores callee-saved registers on every exit path to preserve 100u64 when subtracting 100u64.

// Place: call_result. The post-probe combined value is returned from a dedicated helper call before exact subtraction.

// Expected exit: 0

machine touch_registers(seed: u64) -> u64
    requires seed == 1u64
    ensures result == 0u64
{
    let a: u64 = seed + 10u64;
    let b: u64 = a * 2u64;
    let c: u64 = b - 22u64;
    c
}

machine multi_exit_probe(selector: u64, x: u64) -> u64
    requires selector <= 2u64 && x == 40u64
    ensures result >= 40u64 && result <= 40u64
{
    transition selector {
        0u64 -> path_zero(x)
        1u64 -> path_one(x)
        _ -> path_two(x)
    }

    machine path_zero(x: u64) -> u64 {
        let a1: u64 = 5u64;
        let a2: u64 = 5u64;
        let a3: u64 = 5u64;
        let a4: u64 = 5u64;
        let a5: u64 = 5u64;
        let a6: u64 = 5u64;
        let a7: u64 = 5u64;
        let a8: u64 = 5u64;
        let clobber: u64 = touch_registers(1u64);
        let sum: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + clobber;
        sum
    }

    machine path_one(x: u64) -> u64 {
        let b1: u64 = 4u64;
        let b2: u64 = 6u64;
        let b3: u64 = 4u64;
        let b4: u64 = 6u64;
        let b5: u64 = 4u64;
        let b6: u64 = 6u64;
        let b7: u64 = 4u64;
        let b8: u64 = 6u64;
        let clobber: u64 = touch_registers(1u64);
        let sum: u64 = b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + clobber;
        sum
    }

    machine path_two(x: u64) -> u64 {
        let c1: u64 = 1u64;
        let c2: u64 = 9u64;
        let c3: u64 = 2u64;
        let c4: u64 = 8u64;
        let c5: u64 = 3u64;
        let c6: u64 = 7u64;
        let c7: u64 = 4u64;
        let c8: u64 = 6u64;
        let clobber: u64 = touch_registers(1u64);
        let sum: u64 = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + clobber;
        sum
    }
}

machine supply(total: u64) -> u64
    ensures result == total
{
    total
}

machine run() -> i32 {
    let k1: u64 = 10u64;
    let k2: u64 = 20u64;
    let k3: u64 = 30u64;
    let r0: u64 = multi_exit_probe(0u64, 40u64);
    let r1: u64 = multi_exit_probe(1u64, 40u64);
    let r2: u64 = multi_exit_probe(2u64, 40u64);
    let caller_live: u64 = k1 + k2 + k3;
    let probe_out: u64 = (r0 + r1 + r2) - 80u64;
    let total: u64 = caller_live + probe_out;
    let preserved: u64 = supply(total);
    let diff: u64 = preserved - 100u64;
    diff as i32
}

machine main() crashes Trap {
    let outcome: i32 = run();
    transition outcome == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
