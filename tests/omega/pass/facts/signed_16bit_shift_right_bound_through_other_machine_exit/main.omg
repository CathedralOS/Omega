// Fact: a 16-bit signed i16 arithmetic right shift of a bounded input (val >= 480i16 && val <= 480i16) by 2u32 bits establishes shifted >= 120i16 && shifted <= 120i16 so exact 16-bit signed subtraction shifted - 120i16 is proved overflow-free across all nine places.
// Place: other_machine. A forwarding machine transports the arithmetic right-shifted result through an intermediate machine call.
// Expected exit: 0
machine verify_shifted(shifted: i16) -> i32
    requires shifted >= 120 && shifted <= 120
{
    let sub: i16 = shifted - 120;
    sub as i32
}

machine target_machine(val: i16) -> i16
    ensures result == val
{
    val
}

machine forwarder(val: i16) -> i16
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(val: i16) -> i32
    requires val >= 480 && val <= 480
{
    let shifted: i16 = forwarder(val >> 2u32);
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_other_machine(480)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
