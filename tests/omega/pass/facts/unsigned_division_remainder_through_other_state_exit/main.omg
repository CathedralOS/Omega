// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Place: other_state. A successor state receives the remainder and performs the subtraction check.
// Expected exit: 0

machine remainder(dividend: u64, divisor: u64) -> u64
requires dividend >= 500 && dividend <= 500 && divisor >= 200 && divisor <= 200
ensures result >= 100 && result <= 100
{
    dividend % divisor
}

machine verify_state(r: u64) -> i32
requires r >= 100 && r <= 100
{
    transition {
        _ -> step(r)
    }
    machine step(rem: u64) -> i32
    requires rem >= 100 && rem <= 100
    {
        let diff: u64 = rem - 100u64;
        diff as i32
    }
}

machine probe() -> i32 {
    let r: u64 = remainder(500u64, 200u64);
    verify_state(r)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
