// Expected exit: 0
public boundary trait Handler { machine read(value: u64) -> u64 reaches; }
trait Forwarding {
 machine run<machine Callback>(prefix: u64, value: u64) -> u64
 requires machine Callback satisfies Handler::read;
 invokes Handler;
 reaches;
}
Forwarder satisfies Forwarding {
 machine run<machine Action>(tag: u64, value: u64) -> u64
 requires machine Action satisfies Handler::read;
 { forward<Action>(tag, value) }
}
machine forward<machine Selected>(tag: u64, value: u64) -> u64
requires machine Selected satisfies Handler::read;
invokes Handler;
{
 transition tag == 11u64 { true -> invoke(value) false -> wrong_tag() }
 machine invoke(value: u64) -> u64 { Selected(value) }
 machine wrong_tag() -> u64 { 0 }
}
machine echo(value: u64) -> u64 satisfies Handler::read { value }
machine other(value: u64) -> u64 satisfies Handler::read { 231 }
machine main() crashes Trap {
 let first: u64 = Forwarder::run<echo>(11, 7);
 let second: u64 = Forwarder::run<other>(11, 7);
 transition first == 7 && second == 231 { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
