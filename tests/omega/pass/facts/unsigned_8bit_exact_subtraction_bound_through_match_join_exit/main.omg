// Fact: 8-bit unsigned exact subtraction lhs - rhs with 100u8 <= lhs <= 180u8 and 20u8 <= rhs <= 40u8 establishes 60u8 <= diff <= 160u8 so 160u8 - diff and diff - 60u8 are safe.
// Place: match join. Both match arms yield bounded 8-bit operands and join before subtraction and interval discharge.
// Expected exit: 0

machine choose_lhs(flag: bool) -> u8
ensures result >= 100 && result <= 180
{
    match flag {
        true -> 140u8,
        false -> 120u8,
    }
}

machine sub_match_join(rhs: u8) -> u8
requires rhs >= 20 && rhs <= 40
{
    let lhs: u8 = choose_lhs(true);
    let diff: u8 = lhs - rhs;
    let headroom: u8 = 160u8 - diff;
    let margin: u8 = diff - 60u8;
    headroom + margin
}

machine probe() -> u8 {
    sub_match_join(30u8)
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
