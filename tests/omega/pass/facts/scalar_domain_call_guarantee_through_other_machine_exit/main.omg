// A completed query guarantees a nonnegative result; routed domain introduction preserves that fact.
// Expected exit: 0.
const FLOOR: i64 = 0;
domain i64::Nonnegative(value) requires value >= 0 established by issue;
boundary trait Query { machine read(input: i64) -> i64 ensures result >= FLOOR; }
Actual satisfies Query {
    machine read(input: i64) -> i64 ensures result >= FLOOR {
        transition input >= FLOOR { true -> (input) _ -> (FLOOR) }
    }
}

machine forwarded(value: i64) -> i64 requires value >= 0 ensures result >= 0 { value }
machine issue(input: i64) -> i64 in Nonnegative {
    let captured: i64 = Query::read(input);
    let value: i64 = forwarded(captured);
    value
}

machine main() crashes Trap {
    let value: i64 in Nonnegative = issue(17);
    transition value == 17 { true -> done() _ -> wrong() }
    state done() {}
    state wrong() { crash Trap; }
}
