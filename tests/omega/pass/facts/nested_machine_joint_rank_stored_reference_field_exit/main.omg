// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Payload { count: u64; guard: u64; }
data Remaining { canary: u64; child: &mut Payload; }
data Envelope { prefix: u64; value: Payload; }
machine count(counter: &mut u64, remaining: &mut Remaining) crashes Trap
terminates;
terminates by remaining.child.count;
requires remaining.child.count <= 7;
{
    transition remaining.child.count > 0 {
        true -> forward(remaining, counter)
        false -> finish(remaining.canary)
    }
    machine forward(pending: &mut Remaining, counter: &mut u64) crashes Trap
    requires pending.child.count > 0 && pending.child.count <= 7;
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.child.count = pending.child.count - 1;
        transition { _ -> count(counter, pending) }
    }
    machine finish(canary: u64) crashes Trap {
        transition canary == 641 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine invoke(counter: &mut u64, payload: &mut Payload) crashes Trap
requires payload.count <= 7;
{
    let mut remaining: Remaining = Remaining { canary: 641, child: payload };
    count(counter, &mut remaining);
    transition remaining.canary == 641 && remaining.child.count == 0 && remaining.child.guard == 827 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let mut envelope: Envelope = Envelope { prefix: 207, value: match select {
        true -> Payload { guard: 827, count: 7 }
        false -> Payload { guard: 827, count: 0 }
    } };
    invoke(counter, &mut envelope.value);
    transition envelope.prefix == 207 && envelope.value.count == 0 && envelope.value.guard == 827 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
