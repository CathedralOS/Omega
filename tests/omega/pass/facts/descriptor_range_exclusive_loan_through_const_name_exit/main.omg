// A match on one evaluation of a copyable flag selects a subrange of the chosen descriptor payload, the join records that selected range, and the consumer writes 41 through the first element of that recorded range, leaving the unselected payload unchanged.
// Place: const_name.
// Expected exit: 0
data Slot { case Absent; case Present(value: [i64; 4]); }

machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    true
}

const CHOSEN: [i64; 4] = [17, 0, 5, 6];
const UNSELECTED: [i64; 4] = [0, 0, 8, 9];

machine main() crashes Trap {
    let mut chosen: Slot = Slot::Present { value: CHOSEN };
    let mut other: Slot = Slot::Present { value: UNSELECTED };
    let mut visits: u64 = 0;
    let selected: &mut [i64] = match choose(&mut visits) {
        true -> &mut chosen.value[0..2]
        false -> &mut other.value[2..4]
    };
    selected[0] = 41;
    let observed: i64 = selected[0];
    transition observed == 41 && visits == 1 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
