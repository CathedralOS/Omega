// Fact: a bounded value held live across two sequential machine calls preserves its static bound and value across callee-saved restoration when subtracting from 70u64.
// Place: local. The bounded value is stored in a local binding held live across two sequential calls before exact subtraction.
// Expected exit: 0

machine clobber(seed: u64) -> u64
    requires seed == 1u64
    ensures result == 0u64
{
    let a: u64 = seed + 10u64;
    let b: u64 = a * 2u64;
    let c: u64 = b - 22u64;
    c
}

machine step_one(x: u64) -> u64
    requires x == 10u64
    ensures result == 15u64
{
    let s1: u64 = 2u64;
    let s2: u64 = 3u64;
    let s3: u64 = 4u64;
    let s4: u64 = 6u64;
    let clobber_out: u64 = clobber(1u64);
    let sum: u64 = s1 + s2 + s3 + s4 + clobber_out;
    sum
}

machine step_two(y: u64) -> u64
    requires y == 15u64
    ensures result == 15u64
{
    let t1: u64 = 1u64;
    let t2: u64 = 2u64;
    let t3: u64 = 5u64;
    let t4: u64 = 7u64;
    let clobber_out: u64 = clobber(1u64);
    let sum: u64 = t1 + t2 + t3 + t4 + clobber_out;
    sum
}

machine run() -> i32 {
    let saved: u64 = 40u64;
    let r1: u64 = step_one(10u64);
    let r2: u64 = step_two(r1);
    let remaining: u64 = 70u64 - saved;
    let calls_sum: u64 = r1 + r2;
    let diff: u64 = remaining - calls_sum;
    diff as i32
}

machine probe() -> i32 { run() }

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
