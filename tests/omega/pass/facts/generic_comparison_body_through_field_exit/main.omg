// A generic comparison body returns false. The call records that boolean,
// and the caller reads the record.
// Place: field.
// Expected exit: 0
machine same<T>(left: T, right: T) -> bool {
    false
}

machine compare<T>(left: T, right: T) -> bool {
    same<T>(left, right)
}

machine hold(direct: bool) -> bool
requires direct == false
{
    true
}

data Pair [copy] { left: u64; right: u64; }

machine main() crashes Trap {
    let pair: Pair = Pair { left: 1u64, right: 1u64 };
    let direct: bool = compare<u64>(pair.left, pair.right);
    transition hold(direct) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
