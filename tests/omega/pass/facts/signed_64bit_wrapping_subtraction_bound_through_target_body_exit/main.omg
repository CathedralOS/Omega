// Fact: 64-bit signed wrapping subtraction lhs -% rhs with bounded interval 40i64 <= diff <= 100i64 establishes 40i64 <= diff <= 100i64 across all nine places so exact subtractions 100i64 - diff and diff - 40i64 are safe.
// Expected exit: 0

machine compute_wrap(lhs: i64 in Wrapping, rhs: i64 in Wrapping) -> i64 in Wrapping {
    lhs - rhs
}

machine verify_diff(diff: i64) -> i32
    requires diff >= 40 && diff <= 100
{
    let headroom: i64 = 100 - diff;
    let margin: i64 = diff - 40;
    let total: i64 = headroom + margin;
    let check: i64 = total - 60;
    check as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 100;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_diff(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_diff(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: i64 in Wrapping = 100;
    let rhs: i64 in Wrapping = 30;
    let diff_wrapped: i64 in Wrapping = compute_wrap(lhs, rhs);
    let diff: i64 = diff_wrapped as i64;
    let check: i32 = SelectedProbe::exercise(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
