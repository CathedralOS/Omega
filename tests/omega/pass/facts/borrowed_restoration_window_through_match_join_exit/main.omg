// Fact: retiring a borrow restoration window restores full owner access and post-borrow invariant value >= 100u64 && value <= 100u64 for exact subtraction value - 100u64.
// Place: match join. Both arms of a match expression read the value of the restored cell.
// Expected exit: 0

data Cell {
    value: u64;
}

machine write_cell(cell: &mut Cell) {
    cell.value = 100u64;
}

machine select_val(cell: &Cell, cond: bool) -> u64 {
    match cond {
        true -> cell.value
        false -> cell.value
    }
}

machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 0u64 };
    write_cell(&mut cell);
    let val: u64 = select_val(&cell, true);
    transition val >= 100u64 && val <= 100u64 {
        true -> done(val)
        _ -> bad()
    }
    machine done(v: u64) {
        let diff: u64 = v - 100u64;
    }
    machine bad() {
        crash Trap;
    }
}
