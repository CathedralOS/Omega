// A target-keyed provider call establishes total >= 1000, so exact subtraction total - 1000 preserves the selected provider result.
// Expected exit: 0
boundary trait Reading {
    machine total() -> u64 reaches ensures result >= 1000u64;
}
FirstReading satisfies Reading {
    machine total() -> u64 ensures result >= 1000u64 { 1100u64 }
}
SecondReading satisfies Reading {
    machine total() -> u64 ensures result >= 1000u64 { 2100u64 }
}
trait Calculation { machine consume() -> u64 reaches Reading; }
CalculationBody satisfies Calculation {
    machine consume() -> u64 reaches Reading { Reading::total() - 1000u64 }
}
machine journey(expected: u64) reaches Reading crashes Trap {
    let difference: u64 = CalculationBody::consume();
    transition difference == expected { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine first_entry() reaches Reading crashes Trap { journey(100u64); }
machine second_entry() reaches Reading crashes Trap { journey(1100u64); }
