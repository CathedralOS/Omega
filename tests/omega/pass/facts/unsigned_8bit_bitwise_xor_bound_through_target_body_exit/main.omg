// Fact: 8-bit unsigned bitwise XOR raw ^ 15u8 with bounded interval 40u8 <= xored <= 63u8 establishes 40u8 <= xored <= 63u8 across all nine places so exact subtractions 63u8 - xored and xored - 40u8 are safe.
// Place: target_body. Each hosted target body computes the 8-bit unsigned bitwise XOR and verifies the bounds.
// Expected exit: 0
machine verify_xored(res: u8) -> i32
    requires res >= 40 && res <= 63
{
    let head: u8 = 63 - res;
    let tail: u8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

linux_x86_64 machine compute_target_body(raw: u8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = raw ^ 15;
    verify_xored(xored)
}

linux_arm64 machine compute_target_body(raw: u8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = raw ^ 15;
    verify_xored(xored)
}

macos_arm64 machine compute_target_body(raw: u8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = raw ^ 15;
    verify_xored(xored)
}

windows_x86_64 machine compute_target_body(raw: u8) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: u8 = raw ^ 15;
    verify_xored(xored)
}

machine evaluate() -> i32 {
    compute_target_body(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
