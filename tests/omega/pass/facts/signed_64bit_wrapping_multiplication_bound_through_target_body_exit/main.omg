windows_x86_64 machine sat_target(lhs: i64, rhs: i64) -> i64
requires lhs >= 10 && lhs <= 20 && rhs >= 5 && rhs <= 10
{
    let a: i64 in Wrapping = lhs as i64 in Wrapping;
    let b: i64 in Wrapping = rhs as i64 in Wrapping;
    let wrap_prod: i64 in Wrapping = a * b;
    let prod: i64 = wrap_prod as i64;
    verify_prod(prod)
}

machine probe() -> i64 {
    sat_target(15i64, 8i64)
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
