// Fact: a 16-bit unsigned u16 division of bounded inputs (dividend >= 400u16 && dividend <= 400u16, divisor >= 8u16 && divisor <= 8u16) establishes quotient >= 50u16 && quotient <= 50u16 so exact 16-bit subtraction quotient - 50u16 is proved underflow-free across all nine places.
// Place: another state. A successor state receives bounded 16-bit operands before division and subtraction.
// Expected exit: 0

machine div_state(dividend: u16, divisor: u16) -> u16
requires dividend >= 400 && dividend <= 400 && divisor >= 8 && divisor <= 8
{
    transition {
        _ -> step(dividend, divisor)
    }
    machine step(d: u16, s: u16) -> u16
    requires d >= 400 && d <= 400 && s >= 8 && s <= 8
    {
        let quotient: u16 = d / s;
        quotient - 50u16
    }
}

machine probe() -> u16 {
    div_state(400u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
