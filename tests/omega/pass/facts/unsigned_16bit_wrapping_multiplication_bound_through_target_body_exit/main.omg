windows_x86_64 machine verify_target() -> i32 {
    let lhs: u16 = 15u16;
    let rhs: u16 = 8u16;
    let w_lhs: u16 in Wrapping = lhs as u16 in Wrapping;
    let w_rhs: u16 in Wrapping = rhs as u16 in Wrapping;
    let prod_wrap: u16 in Wrapping = w_lhs * w_rhs;
