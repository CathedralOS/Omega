// Every target body uses a runtime count to index a byte view.
// Expected exit: 0
boundary trait SelectedReadAt {
    machine read_at<Index: u32>(items: &[u8]) -> u8 reaches
requires Index < items.len;
}
CheckedReadAt satisfies SelectedReadAt {
    machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}
}







machine main() crashes Trap {
    let bytes: [u8; 4] = [9, 8, 7, 6];
    let count: u32 = 1;
    transition SelectedReadAt::read_at<count>(&bytes[..]) == 8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
