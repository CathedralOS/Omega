use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, macos_arm64);
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, linux_x86_64);
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, linux_arm64);
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, windows_x86_64);

 Build::application(builder, "foreign_nested_scalar_record_result");
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, windows_x86_64::ProgramEntry, main);

 Build::bind<IntegerDivision::divide>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libomega_nesteddiv_fixture.dylib", symbol: "_nesteddiv_lldiv" } });
 Build::bind<IntegerDivision::divide>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libomega_nesteddiv_fixture.so", symbol: "nesteddiv_lldiv", version: "NESTDIV_1.0" } });
 Build::bind<IntegerDivision::divide>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libomega_nesteddiv_fixture.so", symbol: "nesteddiv_lldiv", version: "NESTDIV_1.0" } });
 Build::bind<IntegerDivision::divide>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_nesteddiv_fixture.dll", export: "nesteddiv_lldiv" } });
 Build::bind<IntegerDivision::verify>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libomega_nesteddiv_fixture.dylib", symbol: "_nesteddiv_verify" } });
 Build::bind<IntegerDivision::verify>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libomega_nesteddiv_fixture.so", symbol: "nesteddiv_verify", version: "NESTDIV_1.0" } });
 Build::bind<IntegerDivision::verify>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libomega_nesteddiv_fixture.so", symbol: "nesteddiv_verify", version: "NESTDIV_1.0" } });
 Build::bind<IntegerDivision::verify>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_nesteddiv_fixture.dll", export: "nesteddiv_verify" } });
}
