// Expected exit: 0
// A u16 value is a member of the u16 domain Small (self <= 10) only on its own u16 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

const LEVEL: u16 = 7;

machine headroom() -> u16 requires LEVEL in Small {
    10 - LEVEL
}

machine main() crashes Trap {
    transition headroom() == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
