machine build(builder: &mut Build) {
    Build::application(builder, "write_only_reference_store_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::accept_boundary<SelectedLend>(builder);
    Build::select_provider<SelectedLend, WindowsLend>(builder, windows_x86_64);
    Build::select_provider<SelectedLend, LinuxX86Lend>(builder, linux_x86_64);
    Build::select_provider<SelectedLend, MacosLend>(builder, macos_arm64);
    Build::select_provider<SelectedLend, LinuxArmLend>(builder, linux_arm64);
}
