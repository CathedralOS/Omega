machine build(builder: &mut Build) {
    Build::application(builder, "affine_joint_rank_target_body");
    Build::select_provider<HostedAffine, HostedAffineBody>(builder, windows_x86_64);
    Build::select_provider<HostedAffine, HostedAffineBody>(builder, linux_x86_64);
    Build::select_provider<HostedAffine, HostedAffineBody>(builder, macos_arm64);
    Build::select_provider<HostedAffine, HostedAffineBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
