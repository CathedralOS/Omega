// Fact: adding two bounded 16-bit unsigned u16 values (lhs >= 100u16 && lhs <= 200u16 and rhs >= 150u16 && rhs <= 300u16) establishes the exact post-addition interval (sum >= 250u16 && sum <= 500u16), discharging both 500u16 - sum and sum - 250u16 across all nine places.
// Place: field. Bounded 16-bit operands are stored in record fields before addition and interval discharge.
// Expected exit: 0

data OperandPacket {
    lhs: u16;
    rhs: u16;
}

machine compute_field(packet: OperandPacket) -> u16
requires packet.lhs >= 100 && packet.lhs <= 200 && packet.rhs >= 150 && packet.rhs <= 300
{
    let sum: u16 = packet.lhs + packet.rhs;
    let headroom: u16 = 500u16 - sum;
    let margin: u16 = sum - 250u16;
    headroom + margin
}

machine probe() -> u16 {
    let packet: OperandPacket = OperandPacket { lhs: 150u16, rhs: 200u16 };
    compute_field(packet)
}

machine main() crashes Trap {
    transition probe() == 250 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
