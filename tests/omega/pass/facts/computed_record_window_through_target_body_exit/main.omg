// In the which == 0 arm, [0..which + 2] has length 2; hold preserves that
// extent in its returned Held.values, through which write_pair writes the backing.
// Expected exit: 0

data Held<'samples> { values: &'samples mut [f64]; }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedWindow {
    machine window<'samples>(samples: &'samples mut [f64; 4], which: i64) -> &'samples mut [f64] reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    ensures result.len == 2;
}
X86Window satisfies SelectedWindow {
    machine window<'samples>(samples: &'samples mut [f64; 4], which: i64) -> &'samples mut [f64] reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    ensures result.len == 2
    {
        SelectedBodyCheck::require_tag(17u64);
        match which {
        0 -> &mut samples[0..which + 2]
        _ -> &mut samples[2..4]
        }
    }
}
ArmWindow satisfies SelectedWindow {
    machine window<'samples>(samples: &'samples mut [f64; 4], which: i64) -> &'samples mut [f64] reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    ensures result.len == 2
    {
        SelectedBodyCheck::require_tag(29u64);
        match which {
        0 -> &mut samples[0..which + 2]
        _ -> &mut samples[2..4]
        }
    }
}
machine hold<'samples>(samples: &'samples mut [f64]) -> Held<'samples>
requires samples.len == 2
ensures result.values.len == 2
{
    Held { values: samples }
}

machine write_pair(window: &mut [f64])
requires window.len >= 2 {
    window[0] = 0.0;
    window[1] = 1.0;
}

machine exercise(which: i64) crashes Trap {
    let mut samples: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let view: &mut [f64] = SelectedWindow::window(&mut samples, which);
    let leading: Held = hold(view);
    write_pair(leading.values);
    let first: f64 = samples[0];
    let second: f64 = samples[1];
    let third: f64 = samples[2];
    let fourth: f64 = samples[3];
    transition (which == 0 && first == 0.0 && second == 1.0 && third == 9.0 && fourth == 9.0)
        || (which != 0 && first == 9.0 && second == 9.0 && third == 0.0 && fourth == 1.0) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    exercise(0);
    exercise(1);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
