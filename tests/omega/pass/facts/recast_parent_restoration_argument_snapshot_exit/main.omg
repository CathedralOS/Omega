// A scalar store of zero through the u32 view restores Pair.start and its mixed parent predicate before returning the parent.
// Expected exit: 0
public data Pair [copy]
requires self.start >= 0 && self.start <= self.end,
{
    before: u32;
    start: i32;
    end: i32;
    after: u32;
    marker: u32;
    origin: u32;
}
machine retain_view<'storage>(view: &'storage mut u32) -> &'storage mut u32 { view }
machine overwrite(value: &mut u32, next: u32, count: &mut u32) -> u32
requires count <= 1,
ensures value == next && count <= 2 && result == 7,
{ value = next; count = count + 1; 7 }
machine restore(view: &mut u32, replacement: u32, event: u32)
ensures view == replacement,
{ view = 0xFFFFFFFFu32; view = replacement; }
public machine inspect(pair: &mut Pair) -> u32
{
    let mut replacement: u32 = 0u32;
    let mut count: u32 = 0;
    pair.marker = 11;
    let formed: &mut u32 = &mut pair.start as &mut u32;
    let view: &mut u32 = retain_view(formed);
    restore(&mut view, replacement, overwrite(&mut replacement, 0xFFFFFFFFu32, &mut count));
    pair.marker = replacement;
    pair.end = 10;
    count
}
machine main() crashes Trap {
    let mut first: Pair = Pair { before: 0x13579BDF, start: 3, end: 10, after: 0x2468ACE0, marker: 0, origin: 11 };
    let first_event: u32 = inspect(&mut first);
    let mut second: Pair = Pair { before: 0x13579BDF, start: 5, end: 10, after: 0x2468ACE0, marker: 0, origin: 13 };
    let second_event: u32 = inspect(&mut second);
    transition first_event == 1 && second_event == 1 && first.start == 0 && first.end == 10 && first.marker == 0xFFFFFFFF && first.origin == 11
        && second.start == 0 && second.end == 10 && second.marker == 0xFFFFFFFF && second.origin == 13
        && first.before == 0x13579BDF && first.after == 0x2468ACE0
        && second.before == 0x13579BDF && second.after == 0x2468ACE0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
