// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Place: call_result. A function call returns the masked result before discharging subtraction bounds.
// Expected exit: 0

machine verify_masked(masked: i32) -> i32
requires masked >= 40i32 && masked <= 63i32
{
    let headroom: i32 = 63i32 - masked;
    let margin: i32 = masked - 40i32;
    0i32
}

machine mask_op(raw: i32) -> i32
requires raw == 116i32
ensures result >= 40i32 && result <= 63i32
{
    raw & 63i32
}

machine compute_call(raw: i32) -> i32
requires raw == 116i32
{
    let res: i32 = mask_op(raw);
    verify_masked(res)
}

machine probe() -> i32 {
    compute_call(116i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
