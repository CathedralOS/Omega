// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: target_body.
// Expected exit: 0
windows_x86_64 machine observe(windows: [&mut [u8]; 1]) -> bool
requires windows[0].len == 1
{
    let length: u64 = windows[0].len;
    let observed: bool = windows[0][0] == 19 && length == 1;
    observed
}

linux_x86_64 machine observe(windows: [&mut [u8]; 1]) -> bool
requires windows[0].len == 1
{
    let length: u64 = windows[0].len;
    let observed: bool = windows[0][0] == 19 && length == 1;
    observed
}

macos_arm64 machine observe(windows: [&mut [u8]; 1]) -> bool
requires windows[0].len == 1
{
    let length: u64 = windows[0].len;
    let observed: bool = windows[0][0] == 19 && length == 1;
    observed
}

linux_arm64 machine observe(windows: [&mut [u8]; 1]) -> bool
requires windows[0].len == 1
{
    let length: u64 = windows[0].len;
    let observed: bool = windows[0][0] == 19 && length == 1;
    observed
}

machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut backing[..]];
    let observed: bool = observe(windows);
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
