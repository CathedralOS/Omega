// Fact: 64-bit signed bitwise XOR raw ^ 15i64 with bounded interval 40i64 <= xored <= 63i64 establishes 40i64 <= xored <= 63i64 across all nine places so exact subtractions 63i64 - xored and xored - 40i64 are safe.
// Place: local. Both the bounded signed i64 operand and its bitwise XOR result are transported through local bindings.
// Expected exit: 0
machine verify_xored(res: i64) -> i32
    requires res >= 40 && res <= 63
{
    let head: i64 = 63 - res;
    let tail: i64 = res - 40;
    let sum: i64 = head + tail;
    let diff: i64 = sum - 23;
    diff as i32
}

machine compute_local(raw: i64) -> i32
    requires raw >= 59 && raw <= 59
{
    let xored: i64 = raw ^ 15;
    let v: i64 = xored;
    let transported: i64 = v;
    verify_xored(transported)
}

machine evaluate() -> i32 {
    compute_local(59)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
