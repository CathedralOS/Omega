// A match on one evaluation of a copyable flag returns the exclusive loan of the selected case payload's descriptor, writes 41 through that loan, and leaves the unselected descriptor unchanged.
// Place: const_name.
// Expected exit: 0
data Slot { case Absent; case Present(value: [i64; 2]); }

const CHOSEN: [i64; 2] = [17, 0];
const UNSELECTED: [i64; 2] = [0, 0];

machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    true
}

machine main() crashes Trap {
    let mut chosen: Slot = Slot::Present { value: CHOSEN };
    let mut other: Slot = Slot::Present { value: UNSELECTED };
    let mut visits: u64 = 0;
    let selected: &mut [i64] = match choose(&mut visits) {
        true -> &mut chosen.value[..]
        false -> &mut other.value[..]
    };
    selected[0] = 41;
    let observed: i64 = selected[0];
    transition observed == 41 && visits == 1 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
