// Fact: Generic callback operands retain exact declaration identities through explicit requirements and selected implementations; a call with 42 satisfies the common <=64 contract and preserves Item callback behavior.
// Expected exit: 0

boundary trait Choosing {
    machine choose<Value, machine Callback>(value: &Value, number: u64) -> bool reaches
    requires machine Callback(argument: &Value, count: u64) -> bool requires count <= 512;
    requires number <= 64;
}

ArmChoice satisfies Choosing {
    machine choose<Value, machine Selected>(value: &Value, number: u64) -> bool
requires machine Selected(argument: &Value, count: u64) -> bool requires count <= 64;
requires number <= 64
{ Selected(value, number) }
}
X64Choice satisfies Choosing {
    machine choose<Element, machine Callback>(element: &Element, amount: u64) -> bool
requires machine Callback(argument: &Element, count: u64) -> bool requires count <= 128;
requires amount <= 128
{ Callback(element, amount) }
}
DarwinChoice satisfies Choosing {
    machine choose<Payload, machine Operation>(payload: &Payload, quantity: u64) -> bool
requires machine Operation(argument: &Payload, count: u64) -> bool requires count <= 256;
requires quantity <= 256
{ Operation(payload, quantity) }
}
WindowsChoice satisfies Choosing {
    machine choose<Datum, machine Action>(datum: &Datum, input: u64) -> bool
requires machine Action(argument: &Datum, count: u64) -> bool requires count <= 512;
requires input <= 512
{ Action(datum, input) }
}

data Item { code: u64; }
machine matches(item: &Item, number: u64) -> bool {
    item.code == 42 && number == 42
}

// The forwarded contract is total. Every member checks it using its own
// generic symbols, not the first declaration's spelling or inference row.
machine forward<Value, machine Callback>(value: &Value) -> bool
reaches Choosing
requires machine Callback(argument: &Value, count: u64) -> bool;
{ Choosing::choose<Value, Callback>(value, 42) }

machine run_case(item_code: u64, expected: bool, choose: bool, expected_route: u64) reaches Choosing crashes Trap {
    let item: Item = Item { code: item_code };
    let mut route: u64 = 0;
    let number: u64 = match choose {
        true -> mark_number(42, &mut route, 11),
        false -> mark_number(42, &mut route, 22)
    };
    let direct: bool = Choosing::choose<Item, matches>(&item, number);
    let forwarded: bool = forward<Item, matches>(&item);
    transition direct == expected && forwarded == expected && route == expected_route {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

machine mark_number(number: u64, route: &mut u64, tag: u64) -> u64
ensures result == number { route = tag; number }

machine main() reaches Choosing crashes Trap {
    run_case(42, true, true, 11);
    run_case(43, false, false, 22);
}
