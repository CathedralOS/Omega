// Fact: a 16-bit unsigned u16 division of bounded inputs (dividend >= 400u16 && dividend <= 400u16, divisor >= 8u16 && divisor <= 8u16) establishes quotient >= 50u16 && quotient <= 50u16 so exact 16-bit subtraction quotient - 50u16 is proved underflow-free across all nine places.
// Place: another target body. Each of four target-scoped machine bodies divides bounded 16-bit operands and subtracts 50u16.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedDivTarget {
    machine div_target(dividend: u16, divisor: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 400 && dividend <= 400 && divisor >= 8 && divisor <= 8;
}

X86DivTarget satisfies SelectedDivTarget {
    machine div_target(dividend: u16, divisor: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 400 && dividend <= 400 && divisor >= 8 && divisor <= 8
    {
        SelectedBodyCheck::require_tag(17u64);
        let quotient: u16 = dividend / divisor;
        quotient - 50u16
    }
}

ArmDivTarget satisfies SelectedDivTarget {
    machine div_target(dividend: u16, divisor: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires dividend >= 400 && dividend <= 400 && divisor >= 8 && divisor <= 8
    {
        SelectedBodyCheck::require_tag(29u64);
        let quotient: u16 = dividend / divisor;
        quotient - 50u16
    }
}

machine probe() -> u16 {
    SelectedDivTarget::div_target(400u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
