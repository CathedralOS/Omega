machine build(builder: &mut Build) {
    Build::select_provider<SelectedCallingPlanSeven, CheckedCallingPlanSeven>(builder, linux_x86_64);
    Build::select_provider<SelectedCallingPlanSeven, CheckedCallingPlanSeven>(builder, linux_arm64);
    Build::select_provider<SelectedCallingPlanSeven, CheckedCallingPlanSeven>(builder, macos_arm64);
    Build::select_provider<SelectedCallingPlanSeven, CheckedCallingPlanSeven>(builder, windows_x86_64);

    Build::application(builder, "register_stack_arg_calling_plan_through_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
