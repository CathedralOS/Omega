// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Place: another state. A successor state receives the bounded 8-bit operand and shift count before left shift and subtraction.
// Expected exit: 0

machine shift_state(val: u8, shift: u32) -> u8
requires val >= 25 && val <= 25 && shift == 2
{
    transition {
        _ -> step(val, shift)
    }
    machine step(v: u8, s: u32) -> u8
    requires v >= 25 && v <= 25 && s == 2
    {
        let shifted: u8 = v << s;
        shifted - 100u8
    }
}

machine probe() -> u8 {
    shift_state(25u8, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
