// Fact: a 4-level nested structural record RootRec { outer: Outer { mid: Middle { inner: Inner { val: u64 } } } } preserves the leaf field bound 40u64 <= root.outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: match_join. Both match arms return the nested record joining into subtraction bounds.
// Expected exit: 0

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

data RootRec [copy] {
    outer: Outer;
}

machine choose_record(first: RootRec, second: RootRec, flag: bool) -> RootRec
requires first.outer.mid.inner.val >= 40u64 && first.outer.mid.inner.val <= 80u64
    && second.outer.mid.inner.val >= 40u64 && second.outer.mid.inner.val <= 80u64
ensures result.outer.mid.inner.val >= 40u64 && result.outer.mid.inner.val <= 80u64
{
    match flag {
        true -> first,
        false -> second,
    }
}

machine compute_join(first: RootRec, second: RootRec, flag: bool) -> i32
requires first.outer.mid.inner.val >= 40u64 && first.outer.mid.inner.val <= 80u64
    && second.outer.mid.inner.val >= 40u64 && second.outer.mid.inner.val <= 80u64
{
    let r: RootRec = choose_record(first, second, flag);
    let res: u64 = r.outer.mid.inner.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    0i32
}

machine probe() -> i32 {
    let r1: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 50u64,
                },
            },
        },
    };
    let r2: RootRec = RootRec {
        outer: Outer {
            mid: Middle {
                inner: Inner {
                    val: 70u64,
                },
            },
        },
    };
    compute_join(r1, r2, true)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
