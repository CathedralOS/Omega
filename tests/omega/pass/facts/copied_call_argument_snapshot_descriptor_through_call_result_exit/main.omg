// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: call_result.
// Expected exit: 0
data Cell { value: u64; }
data View<'storage> [copy] { target: &'storage Cell; }
machine overwrite<'storage>(slot: &mut View<'storage>, replacement: &'storage Cell) -> u64 {
    slot.target = replacement;
    0
}
machine seven(value: u64) -> u64
requires value == 7
ensures result == 7
{ value }
machine echo<'storage>(value: View<'storage>) -> View<'storage>
requires value.target.value == 7
ensures result.target.value == 7
{ value }
machine receive<'storage>(selected: View<'storage>, ignored: u64) -> u64
requires selected.target.value == 7
ensures result == 7
{
    let saved: View = echo(selected);
    seven(saved.target.value)
}

machine main() crashes Trap {
    let first: Cell = Cell { value: 7 };
    let second: Cell = Cell { value: 9 };
    let mut original: View = View { target: &first };
    let observed: u64 = receive(original, overwrite(&mut original, &second));
    let difference: u64 = observed - 7;
    transition difference == 0 && original.target.value == 9 {
        true -> done() false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
