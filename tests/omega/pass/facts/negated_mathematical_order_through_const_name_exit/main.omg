// Fact: a named negated integer-order predicate establishes value <= 5 for exact 5u64 - value.
// Expected exit: 0
let within(limit: u64, value: u64): core::Strict<0> = !(value > limit);
domain u64::Small(value) requires within(5, value);
const INITIAL: u64 = 3;
machine establish() -> u64 in Small {
    let mut value: u64 in Small = 0;
    value = INITIAL;
    value
}
machine probe() -> u64 { let value: u64 in Small = establish(); 5u64 - value }
machine main() crashes Trap {
    transition probe() == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
