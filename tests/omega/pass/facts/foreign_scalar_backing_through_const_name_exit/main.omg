machine demand(result: bool) crashes Trap {
    transition result { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
macos_arm64 machine main() crashes Trap {
    let mut backing: Cell = INITIAL;
    let selected: &u32 = &backing.word;
    let written: i64 = Words::write(1, selected, 4);
    demand(written == 4 && backing.prefix == 1650614882 && backing.word == WORD && backing.suffix == 1684300900);
}
