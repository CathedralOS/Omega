    } }
}
windows_x86_64 machine windows_set_descriptor_mode(descriptor: i32, mode: i32) -> i32
    satisfies WindowsDescriptorMode::set_mode via windows_descriptor_mode_binding();
windows_x86_64 machine windows_write() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
