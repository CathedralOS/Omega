// A shared inline scalar-field loan exports its original backing through the thin foreign ABI without changing adjacent fields.
// Expected exit: 0
use omega::language::core::external_binding;
const WORD: u32 = 172180033;
const INITIAL: Cell = Cell { prefix: 1650614882, word: WORD, suffix: 1684300900 };
data Cell [copy] { prefix: u32; word: u32; suffix: u32; }
data Envelope [copy] { cell: Cell; }
public boundary trait Words {
    machine write(descriptor: i32, word: &u32, count: u64) -> i64 reaches;
}
public boundary trait WindowsWords {
    machine write(descriptor: i32, word: &u32, count: u32) -> i32 reaches;
}
macos_arm64 machine macos_write() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
macos_arm64 machine write(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies Words::write via macos_write();
linux_x86_64 machine linux_write() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
linux_x86_64 machine write(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies Words::write via linux_write();
linux_arm64 machine arm_write() -> ForeignBinding<9, 5, 10> {
