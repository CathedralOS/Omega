        object: "libc.so.6", symbol: "write", version: "GLIBC_2.17"
    } }
}
linux_arm64 machine write(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies Words::write via arm_write();
// This witness exports exact bytes; MSVCRT stdout must not translate LF.
public boundary trait WindowsDescriptorMode {
    machine set_mode(descriptor: i32, mode: i32) -> i32 reaches;
