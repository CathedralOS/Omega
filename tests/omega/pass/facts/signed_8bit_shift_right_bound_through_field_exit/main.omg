// Fact: an 8-bit signed i8 arithmetic right shift of a bounded input (val >= 100i8 && val <= 100i8) by 2u32 bits establishes shifted >= 25i8 && shifted <= 25i8 so exact 8-bit signed subtraction shifted - 25i8 is proved overflow-free across all nine places.
// Place: field. The shifted result is carried in a record field before discharging the contract.
// Expected exit: 0

data ShiftContainer {
    shifted: i8;
}

machine verify_shifted(shifted: i8) -> i32
requires shifted >= 25i8 && shifted <= 25i8
{
    let check: i8 = shifted - 25i8;
    0i32
}

machine compute_field(val: i8, shift: u32) -> i32
requires val >= 100i8 && val <= 100i8 && shift == 2u32
{
    let container: ShiftContainer = ShiftContainer { shifted: val >> shift };
    verify_shifted(container.shifted)
}

machine probe() -> i32 {
    compute_field(100i8, 2u32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
