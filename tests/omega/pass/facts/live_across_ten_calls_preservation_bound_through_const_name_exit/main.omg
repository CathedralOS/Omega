// Fact: a value live across ten sequential machine calls preserves its static bound 40u64 <= saved <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: const name. A named constant value is preserved across the ten sequential calls.
// Expected exit: 0
machine step1(x: u64) -> u64
    requires x == 10
    ensures result == 11
{
    11
}

machine step2(x: u64) -> u64
    requires x == 11
    ensures result == 12
{
    12
}

machine step3(x: u64) -> u64
    requires x == 12
    ensures result == 13
{
    13
}

machine step4(x: u64) -> u64
    requires x == 13
    ensures result == 14
{
    14
}

machine step5(x: u64) -> u64
    requires x == 14
    ensures result == 15
{
    15
}

machine step6(x: u64) -> u64
    requires x == 15
    ensures result == 16
{
    16
}

machine step7(x: u64) -> u64
    requires x == 16
    ensures result == 17
{
    17
}

machine step8(x: u64) -> u64
    requires x == 17
    ensures result == 18
{
    18
}

machine step9(x: u64) -> u64
    requires x == 18
    ensures result == 19
{
    19
}

machine step10(x: u64) -> u64
    requires x == 19
    ensures result == 20
{
    20
}

const SAVED: u64 = 60;

machine compute_const() -> i32 {
    let c1: u64 = step1(10);
    let c2: u64 = step2(c1);
    let c3: u64 = step3(c2);
    let c4: u64 = step4(c3);
    let c5: u64 = step5(c4);
    let c6: u64 = step6(c5);
    let c7: u64 = step7(c6);
    let c8: u64 = step8(c7);
    let c9: u64 = step9(c8);
    let c10: u64 = step10(c9);
    let res: u64 = SAVED;
    let head: u64 = 80 - res;
    let underflow: u64 = res - 40;
    transition head + underflow == 40 && c10 == 20 {
        true -> done()
        _ -> bad()
    }
    state done() -> i32 { 0 }
    state bad() -> i32 { 1 }
}

machine evaluate() -> i32 {
    compute_const()
}

machine main() crashes Trap {
    let outcome: i32 = evaluate();
    transition outcome == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
