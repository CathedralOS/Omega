// Fact: a 5-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { val: u64 } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: call result. Contracted helper calls return the 5-level nested record before leaf projection and interval discharge.
// Expected exit: 0

data Level4 [copy] {
    val: u64;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

machine make_root() -> RootRec
ensures result.l1.l2.l3.l4.val >= 40 && result.l1.l2.l3.l4.val <= 80
{
    RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        val: 60u64,
                    },
                },
            },
        },
    }
}

machine check_call_result() -> u64 {
    let root: RootRec = make_root();
    let res: u64 = root.l1.l2.l3.l4.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine probe() -> u64 {
    check_call_result()
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
