// An affine case temporary retains zero common fields and ordered payload/common values through its shared consumer, then follows its normal cleanup edge.
// Expected exit: 0
data Bonus [copy] { value: u64; }
data Event {
    omitted: u64;
    details: Bonus;
    case Treasure(gold: u64);
}

machine tick(count: &mut u64) -> Bonus {
    count = ((count as u64 in Wrapping) + 1) as u64;
    Bonus { value: count }
}

machine observe(event: &Event) -> bool {
    event.omitted == 0 && event.details.value == 2
}

machine selected(enabled: bool, count: &mut u64) -> bool {
    enabled && observe(Event::Treasure {
        gold: tick(count).value,
        details: tick(count)
    })
}

machine main() crashes Trap {
    let mut count: u64 = 0;
    let skipped: bool = selected(false, &mut count);
    let completed: bool = selected(true, &mut count);
    transition skipped == false && completed && count == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
