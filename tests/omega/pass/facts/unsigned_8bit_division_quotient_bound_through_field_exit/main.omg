// Fact: an 8-bit unsigned u8 division of bounded inputs (dividend >= 120u8 && dividend <= 120u8, divisor >= 4u8 && divisor <= 4u8) establishes quotient >= 30u8 && quotient <= 30u8 so exact 8-bit subtraction quotient - 30u8 is proved underflow-free across all nine places.
// Place: field. The bounded operands are stored within a nominal record field.
// Expected exit: 0

data Operands {
    dividend: u8;
    divisor: u8;
}

machine divide_field(dividend: u8, divisor: u8) -> i32
    requires dividend >= 120u8 && dividend <= 120u8;
    requires divisor >= 4u8 && divisor <= 4u8;
{
    let ops: Operands = Operands { dividend: dividend, divisor: divisor };
    let quotient: u8 = ops.dividend / ops.divisor;
    let check: u8 = quotient - 30u8;
    transition quotient == 30u8 && check == 0u8 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_field(120u8, 4u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
