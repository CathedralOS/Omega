// Expected exit: 0.
// Fact: a target-selected layout query contributes to a derived constant whose result discharges exact subtraction and agrees with execution.
boundary trait Answer { machine get() -> u64 reaches terminates; }
Small satisfies Answer { machine get() -> u64 { 4 } }
Large satisfies Answer { machine get() -> u64 { 8 } }
Same satisfies Answer { machine get() -> u64 { 4 } }
machine limit() -> u64 { Answer::get() }
data Main { values: [u8; limit()]; }
const OBSERVED_SIZE: u64 = size_of<Main>() + 1u64;
boundary trait ExpectedExtent {
    machine expected() -> u64 reaches terminates
    ensures result == 4u64 || result == 8u64;
}
FourByteExpectation satisfies ExpectedExtent {
    machine expected() -> u64 ensures result == 4u64 || result == 8u64 { 4 }
}
EightByteExpectation satisfies ExpectedExtent {
    machine expected() -> u64 ensures result == 4u64 || result == 8u64 { 8 }
}
machine mark_size(value: u64, route: &mut u64, marker: u64) -> u64
ensures result == value { route = marker; value }
machine main() crashes Trap {
    let mut route: u64 = 0;
    let branch: bool = true;
    let observed: u64 = match branch {
        true -> mark_size(OBSERVED_SIZE, &mut route, 17)
        _ -> mark_size(OBSERVED_SIZE, &mut route, 23)
    };
    let slack: u64 = observed - 5u64;
    let first_route: u64 = route;
    let other_branch: bool = false;
    let second: u64 = match other_branch {
        true -> mark_size(OBSERVED_SIZE, &mut route, 17)
        _ -> mark_size(OBSERVED_SIZE, &mut route, 23)
    };
    let second_slack: u64 = second - 5u64;
    transition observed == ExpectedExtent::expected() + 1u64 && slack == ExpectedExtent::expected() - 4u64 && second == ExpectedExtent::expected() + 1u64 && second_slack == ExpectedExtent::expected() - 4u64 && first_route == 17 && route == 23 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
