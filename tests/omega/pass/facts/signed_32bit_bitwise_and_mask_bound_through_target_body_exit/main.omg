// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Place: target_body. Each of four target bodies performs 32-bit signed bitwise AND mask and discharges subtraction bounds.
// Expected exit: 0

machine verify_masked(masked: i32) -> i32
requires masked >= 40i32 && masked <= 63i32
{
    let headroom: i32 = 63i32 - masked;
    let margin: i32 = masked - 40i32;
    0i32
}

linux_x86_64 machine verify_target() -> i32 {
    let raw: i32 = 116i32;
    let res: i32 = raw & 63i32;
    verify_masked(res)
}

linux_arm64 machine verify_target() -> i32 {
    let raw: i32 = 116i32;
    let res: i32 = raw & 63i32;
    verify_masked(res)
}

macos_arm64 machine verify_target() -> i32 {
    let raw: i32 = 116i32;
    let res: i32 = raw & 63i32;
    verify_masked(res)
}

windows_x86_64 machine verify_target() -> i32 {
    let raw: i32 = 116i32;
    let res: i32 = raw & 63i32;
    verify_masked(res)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
