// Fact: three co-resident stack-backed record homes mutated independently through exclusive borrows preserve disjoint field values summing to 100u64 when subtracting 100u64.
// Expected exit: 0

data SlotPair {
    left: u64;
    right: u64;
}

machine write_slot(target: &mut SlotPair, next_left: u64, next_right: u64)
ensures target.left == next_left && target.right == next_right
{
    target.left = next_left;
    target.right = next_right;
}

machine evaluate(isolated: u64) -> u64
requires isolated == 100
ensures result == 0
{
    let local_sum: u64 = isolated;
    local_sum - 100
}

machine main() crashes Trap {
    let mut slot_a: SlotPair = SlotPair { left: 10, right: 20 };
    let mut slot_b: SlotPair = SlotPair { left: 0, right: 0 };
    let mut slot_c: SlotPair = SlotPair { left: 10, right: 20 };

    write_slot(&mut slot_b, 15, 25);

    transition slot_a.left == 10 && slot_a.right == 20 && slot_b.left == 15 && slot_b.right == 25 && slot_c.left == 10 && slot_c.right == 20 {
        true -> run_check(slot_a, slot_b, slot_c)
        _ -> bad()
    }
    machine run_check(a: SlotPair, b: SlotPair, c: SlotPair)
    requires a.left == 10 && a.right == 20 && b.left == 15 && b.right == 25 && c.left == 10 && c.right == 20
    {
        let sum: u64 = a.left + a.right + b.left + b.right + c.left + c.right;
        let res: u64 = evaluate(sum);
        transition res == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
