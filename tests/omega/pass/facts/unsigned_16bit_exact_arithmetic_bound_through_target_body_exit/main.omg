// Fact: adding two bounded 16-bit unsigned u16 values (lhs >= 100u16 && lhs <= 200u16 and rhs >= 150u16 && rhs <= 300u16) establishes the exact post-addition interval (sum >= 250u16 && sum <= 500u16), discharging both 500u16 - sum and sum - 250u16 across all nine places.
// Place: another target body. Each of four target-scoped machine bodies adds bounded 16-bit operands and discharges the interval.
// Expected exit: 0

linux_x86_64 machine compute_target(lhs: u16, rhs: u16) -> u16
requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 300
{
    let sum: u16 = lhs + rhs;
    let headroom: u16 = 500u16 - sum;
    let margin: u16 = sum - 250u16;
    headroom + margin
}

linux_arm64 machine compute_target(lhs: u16, rhs: u16) -> u16
requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 300
{
    let sum: u16 = lhs + rhs;
    let headroom: u16 = 500u16 - sum;
    let margin: u16 = sum - 250u16;
    headroom + margin
}

macos_arm64 machine compute_target(lhs: u16, rhs: u16) -> u16
requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 300
{
    let sum: u16 = lhs + rhs;
    let headroom: u16 = 500u16 - sum;
    let margin: u16 = sum - 250u16;
    headroom + margin
}

windows_x86_64 machine compute_target(lhs: u16, rhs: u16) -> u16
requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 300
{
    let sum: u16 = lhs + rhs;
    let headroom: u16 = 500u16 - sum;
    let margin: u16 = sum - 250u16;
    headroom + margin
}

machine probe() -> u16 {
    compute_target(150u16, 200u16)
}

machine main() crashes Trap {
    transition probe() == 250 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
