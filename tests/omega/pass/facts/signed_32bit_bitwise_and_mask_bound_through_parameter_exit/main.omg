// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Place: parameter. The masked result is passed as an explicit machine parameter.
// Expected exit: 0

machine verify_parameter(res: i32) -> i32
requires res >= 40i32 && res <= 63i32
{
    let headroom: i32 = 63i32 - res;
    let margin: i32 = res - 40i32;
    0i32
}

machine compute_param(raw: i32) -> i32
requires raw == 116i32
{
    let masked: i32 = raw & 63i32;
    verify_parameter(masked)
}

machine probe() -> i32 {
    compute_param(116i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
