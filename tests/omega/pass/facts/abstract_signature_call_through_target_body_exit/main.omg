// A call inside an abstract signature is the premise. The signature
// records that call's result, and the caller reads the record.
// Place: target_body.
// Expected exit: 0
machine premise(kept: bool) -> bool {
    true
}

machine hold(direct: bool) -> bool
requires direct == true
{
    true
}

machine witness(kept: bool) -> bool
requires premise(kept)
{
    premise(kept)
}

machine apply<machine Observe>(kept: bool) -> bool
requires machine Observe(kept: bool) -> bool
requires premise(kept);
requires premise(kept)
{
    Observe(kept)
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Observe satisfies SelectedObserve {
    machine observe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let kept: bool = true;
        let direct: bool = apply<witness>(kept);
        hold(direct)
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let kept: bool = true;
        let direct: bool = apply<witness>(kept);
        hold(direct)
    }
}

machine main() crashes Trap {
    transition SelectedObserve::observe() {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
