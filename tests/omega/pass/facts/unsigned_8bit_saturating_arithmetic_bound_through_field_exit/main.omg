// Fact: 8-bit unsigned saturating addition lhs +| rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Place: field. The bounded operands are stored within a nominal record field.
// Expected exit: 0

data Operands {
    lhs: u8;
    rhs: u8;
}

machine add_field(lhs: u8, rhs: u8) -> i32
    requires lhs >= 40u8 && lhs <= 80u8;
    requires rhs >= 10u8 && rhs <= 20u8;
{
    let ops: Operands = Operands { lhs: lhs, rhs: rhs };
    let a: u8 in Saturating = ops.lhs as u8 in Saturating;
    let b: u8 in Saturating = ops.rhs as u8 in Saturating;
    let s_sat: u8 in Saturating = a + b;
    let sum: u8 = s_sat as u8;
    let headroom: u8 = 100u8 - sum;
    let margin: u8 = sum - 50u8;
    transition sum == 75u8 && headroom + margin == 50u8 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = add_field(60u8, 15u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
