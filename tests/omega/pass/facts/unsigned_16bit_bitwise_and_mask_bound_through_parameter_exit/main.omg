// Fact: 16-bit unsigned bitwise AND mask raw & 63u16 with bounded interval 40u16 <= masked <= 63u16 establishes 40u16 <= masked <= 63u16 across all nine places so exact subtractions 63u16 - masked and masked - 40u16 are safe.
// Place: parameter. The masked result is passed as an explicit machine parameter.
// Expected exit: 0

machine verify_parameter(res: u16) -> i32
requires res >= 40u16 && res <= 63u16
{
    let headroom: u16 = 63u16 - res;
    let margin: u16 = res - 40u16;
    0i32
}

machine compute_param(raw: u16) -> i32
requires raw == 116u16
{
    let masked: u16 = raw & 63u16;
    verify_parameter(masked)
}

machine probe() -> i32 {
    compute_param(116u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
