// Fact: eight simultaneously live scalar bindings preserved across an interior call sum to 100u64 when subtracting 100u64.
// Place: const_name. A named constant supplies the initial live scalar value held in a local across clobber_call before exact subtraction.
// Expected exit: 0
machine clobber_call(seed: u64) -> u64
    requires seed == 1u64
    ensures result == 0u64
{
    let a: u64 = seed + 10u64;
    let b: u64 = a * 2u64;
    let c: u64 = b - 22u64;
    c
}

const BASE_V1: u64 = 5u64;

machine run() -> i32 {
    let v1: u64 = BASE_V1;
    let v2: u64 = 10u64;
    let v3: u64 = 12u64;
    let v4: u64 = 13u64;
    let v5: u64 = 14u64;
    let v6: u64 = 15u64;
    let v7: u64 = 16u64;
    let v8: u64 = 15u64;
    let call_out: u64 = clobber_call(1u64);
    let preserved: u64 = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + call_out;
    let diff: u64 = preserved - 100u64;
    diff as i32
}

machine main() crashes Trap {
    let outcome: i32 = run();
    transition outcome == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
