// Fact: Commit three bytes under bound eight, write/read the committed region, release it, and observe checked rejection of a request for nine bytes.
// Expected exit: 0
use omega::language::core::activation;

machine write_read(bytes: &mut [u8]) -> u8 {
    transition bytes.len >= 3 {
        true -> access(bytes)
        false -> (0u8)
    }
    machine access(bytes: &mut [u8]) -> u8
    requires bytes.len >= 3 {
        bytes[2] = 37u8;
        bytes[2]
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTargetExercise {
    machine target_exercise() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86TargetExercise satisfies SelectedTargetExercise {
    machine target_exercise() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        transition Activation::try_claim<8>(3) {
            ActivationClaimAttempt::Established { claim } -> established(claim)
            ActivationClaimAttempt::Rejected -> (false)
        }
        machine established(claim: ActivationClaim) -> bool {
            let mut live: ActivationClaim = claim;
            let bytes: &mut [u8] = ActivationClaim::bytes(&mut live);
            let length: u64 = bytes.len;
            let observed: u8 = write_read(bytes);
            ActivationClaim::release(live);
            transition length == 3 && observed == 37u8 {
                true -> over_bound()
                false -> (false)
            }
        }
        machine over_bound() -> bool {
            transition Activation::try_claim<8>(9) {
                ActivationClaimAttempt::Rejected -> (true)
                ActivationClaimAttempt::Established { claim } -> unexpectedly_established(claim)
            }
        }
        machine unexpectedly_established(claim: ActivationClaim) -> bool {
            ActivationClaim::release(claim);
            false
        }
    }
}

ArmTargetExercise satisfies SelectedTargetExercise {
    machine target_exercise() -> bool
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        transition Activation::try_claim<8>(3) {
            ActivationClaimAttempt::Established { claim } -> established(claim)
            ActivationClaimAttempt::Rejected -> (false)
        }
        machine established(claim: ActivationClaim) -> bool {
            let mut live: ActivationClaim = claim;
            let bytes: &mut [u8] = ActivationClaim::bytes(&mut live);
            let length: u64 = bytes.len;
            let observed: u8 = write_read(bytes);
            ActivationClaim::release(live);
            transition length == 3 && observed == 37u8 {
                true -> over_bound()
                false -> (false)
            }
        }
        machine over_bound() -> bool {
            transition Activation::try_claim<8>(9) {
                ActivationClaimAttempt::Rejected -> (true)
                ActivationClaimAttempt::Established { claim } -> unexpectedly_established(claim)
            }
        }
        machine unexpectedly_established(claim: ActivationClaim) -> bool {
            ActivationClaim::release(claim);
            false
        }
    }
}

machine main() crashes Trap {
    transition SelectedTargetExercise::target_exercise() {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
