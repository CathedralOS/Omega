// Expected exit: 0
domain u8::Small requires self < 16;
data Packet[copy] { bytes: [u8; 0]; }
machine produce() -> Packet { Packet { bytes: "" } }
machine main() crashes Trap {
 let packet: Packet = produce();
 transition true { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
