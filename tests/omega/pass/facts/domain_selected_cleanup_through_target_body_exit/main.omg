// The selected cleanup application retains code == 7 and its exclusive output reference through transport, then writes 7 to the original backing exactly once.
// Place: target_body.
// Expected exit: 0.
data Seed [copy] { code: u64; }
data Counter { value: u64; invocations: u64 in Wrapping; }
data Keeper<'storage> dropped by release_keeper<'storage> { output: &'storage mut Counter; code: u64; }
machine release_keeper<'storage>(keeper: &mut Keeper<'storage>) requires keeper.code == 7 {
    keeper.output.value = keeper.code;
    keeper.output.invocations = keeper.output.invocations + 1;
}
machine observe(keeper: &Keeper) {}
machine check(output: &Counter) crashes Trap {
    transition output.value == 7 && output.invocations == 1 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
windows_x86_64 machine consume(keeper: Keeper) requires keeper.code == 7 {}
linux_x86_64 machine consume(keeper: Keeper) requires keeper.code == 7 {}
macos_arm64 machine consume(keeper: Keeper) requires keeper.code == 7 {}
linux_arm64 machine consume(keeper: Keeper) requires keeper.code == 7 {}
machine main() crashes Trap {
    let mut output: Counter = Counter { value: 0, invocations: 0 };
    consume(Keeper { output: &mut output, code: 7 });
    check(&output);
}
