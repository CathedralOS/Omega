// An independent completed call guarantees value == 7, so exact value - 7 is safe.
// Expected exit: 0
boundary trait IndependentSource<const Tag: u64> {
    machine source(input: u64) -> u64 reaches ensures result == 7;
}
WindowsSource<const Tag: u64> satisfies IndependentSource<Tag> {
    machine source(input: u64) -> u64 reaches ensures result == 7 {
        7
    }
}
LinuxSource<const Tag: u64> satisfies IndependentSource<Tag> {
    machine source(input: u64) -> u64 reaches ensures result == 7 {
        7
    }
}
MacosSource<const Tag: u64> satisfies IndependentSource<Tag> {
    machine source(input: u64) -> u64 reaches ensures result == 7 {
        7
    }
}
LinuxArmSource<const Tag: u64> satisfies IndependentSource<Tag> {
    machine source(input: u64) -> u64 reaches ensures result == 7 {
        7
    }
}
ReservedSource<const Tag: u64> satisfies IndependentSource<Tag> {
    machine source(input: u64) -> u64 reaches ensures result == 7 {
        7
    }
}
machine forwarded(input: u64) -> u64 ensures result == 7 { IndependentSource<17u64>::source(input) }
machine evaluate() -> u64 {
    let value: u64 = forwarded(3);
    let copied: u64 = value;
    copied - 7
}
machine main() crashes Trap {
    let difference: u64 = evaluate();
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
