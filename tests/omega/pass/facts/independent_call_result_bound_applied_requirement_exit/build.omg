machine build(builder: &mut Build) {
    Build::application(builder, "independent_call_result_bound");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<IndependentSource<17u64>, WindowsSource<17u64>>(builder, windows_x86_64);
    Build::select_provider<IndependentSource<17u64>, LinuxSource<17u64>>(builder, linux_x86_64);
    Build::select_provider<IndependentSource<17u64>, MacosSource<17u64>>(builder, macos_arm64);
    Build::select_provider<IndependentSource<17u64>, LinuxArmSource<17u64>>(builder, linux_arm64);
}
