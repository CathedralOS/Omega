// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Place: local. Both the bounded u64 value and bounded shift count are copied into locals.
// Expected exit: 0

machine shift_right_local(val: u64, shift: u64) -> u64
requires val >= 400 && val <= 400 && shift >= 2 && shift <= 2
ensures result == 0
{
    let local_val: u64 = val;
    let local_shift: u64 = shift;
    let shifted: u64 = local_val >> local_shift;
    shifted - 100
}

machine main() crashes Trap {
    let res: u64 = shift_right_local(400, 2);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
