machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left _ -> right }
}
machine replace_ceiling(limit: &mut u64, ceiling: u64) -> u64
ensures limit <= ceiling && result == 2147483647 {
    limit = 0;
    2147483647
}
machine trial(buffer: &mut [u8], count: u64) -> u64 {
    let mut limit: u64 = buffer.len;
    let saved_limit: u64 = limit;
    let capacity: u64 = minimum(minimum(count, saved_limit), replace_ceiling(&mut limit, buffer.len));
    let prefix: &mut [u8] = &mut buffer[0..capacity];
    let observed: u64 = prefix.len;
    transition limit == 0 { true -> observed _ -> 0 }
}
machine main() crashes Trap {
    let mut bytes: [u8; 8];
    let observed: u64 = trial(&mut bytes[..], 13);
    transition observed == 8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
