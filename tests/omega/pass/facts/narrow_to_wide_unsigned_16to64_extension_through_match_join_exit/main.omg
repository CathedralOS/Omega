// Fact: zero-extending a bounded 16-bit unsigned u16 value (narrow >= 300u16 && narrow <= 500u16) to u64 (narrow as u64) preserves the exact interval (wide >= 300u64 && wide <= 500u64), discharging exact 64-bit subtractions 500u64 - wide and wide - 300u64 across all nine places.
// Expected exit: 0

machine choose(narrow: u16, flag: bool) -> u64
requires narrow >= 300u16 && narrow <= 500u16
ensures result >= 300u64 && result <= 500u64
{
    match flag {
        true -> narrow as u64,
        false -> narrow as u64,
    }
}

machine exercise(narrow: u16, flag: bool) -> i32
requires narrow >= 300u16 && narrow <= 500u16
{
    let wide: u64 = choose(narrow, flag);
    let diff1: u64 = 500u64 - wide;
    let diff2: u64 = wide - 300u64;
    transition diff1 == 100u64 && diff2 == 100u64 {
        true -> 0i32
        _ -> 1i32
    }
}

machine main() crashes Trap {
    let exit_code: i32 = exercise(400u16, true);
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
