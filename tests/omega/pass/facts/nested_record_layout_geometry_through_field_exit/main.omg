// Fact: querying size_of and align_of on a nested structural record (Outer { inner: Inner, tag: u64 } with Inner { a: u64, b: u64 }) establishes its exact 24-byte composite layout geometry (size == 24u64 and align == 8u64), discharging exact subtraction size - (align * 3u64) across all nine places.
// Place: field. An enclosing structural carrier record holds the size and alignment in fields before subtracting.
// Expected exit: 0

data Inner {
    a: u64;
    b: u64;
}

data Outer {
    inner: Inner;
    tag: u64;
}

data GeometryCarrier {
    size: u64;
    align: u64;
}

machine main() crashes Trap {
    let s: u64 = size_of<Outer>();
    let a: u64 = align_of<Outer>();
    let carrier: GeometryCarrier = GeometryCarrier { size: s, align: a };
    let diff: u64 = carrier.size - (carrier.align * 3u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
