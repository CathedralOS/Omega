// A selected checked provider closes limit() to 7; requires value <= limit() carries that bound into exact subtraction 7 - value.
// Expected exit: 0
public boundary trait Endpoint {
    machine upper() -> u64 reaches terminates;
}
public Actual satisfies Endpoint {
    machine upper() -> u64 { 7 }
}
machine limit() -> u64 {
    Endpoint::upper()
}
machine bounded(value: u64) -> u64
requires value <= limit()
ensures result <= limit()
{ value }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedTransfer {
    machine transfer(input: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires input <= limit() ensures result <= limit();
}

X86Transfer satisfies SelectedTransfer {
    machine transfer(input: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires input <= limit() ensures result <= limit()
    {
        SelectedBodyCheck::require_tag(17u64);
     input 
    }
}

ArmTransfer satisfies SelectedTransfer {
    machine transfer(input: u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires input <= limit() ensures result <= limit()
    {
        SelectedBodyCheck::require_tag(29u64);
     input 
    }
}


public machine main() crashes Trap {
    let produced: u64 = bounded(7);
    let value: u64 = SelectedTransfer::transfer(produced);
    let difference: u64 = 7u64 - value;
    transition difference == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
