// Fact: zero-extending narrow unsigned 100u8 through u16 and u32 to u64 preserves the exact interval 100u64, discharging exact subtraction widened - 100u64 with exit code 0.
// Place: parameter. The zero-extended value is passed through a machine parameter.
// Expected exit: 0

machine pass_through(param: u64) -> u64
    ensures result == param
{
    param
}

machine evaluate() -> i32 {
    let narrow: u8 = 100u8;
    let widened: u64 = ((narrow as u16) as u32) as u64;
    let extended: u64 = pass_through(widened);
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
