// Fact: an IEEE f64 ordered comparison guard (reading >= 1.5 && reading <= 2.5) establishes a finite, non-NaN sub-interval that satisfies a downstream contract requiring reading >= 1.0 && reading <= 3.0 across all nine places.
// Place: match_join. Both match arms produce the bounded reading joining into window verification.
// Expected exit: 0

data Reading [copy] where value >= 1.5 && value <= 2.5 {
    value: f64;
}

machine verify_window(reading: f64) -> i32
requires reading >= 1.0 && reading <= 3.0
{
    0i32
}

machine probe(left: Reading, right: Reading, choice: bool) -> i32 {
    let value: f64 = match choice {
        true -> left.value,
        false -> right.value,
    };
    verify_window(value)
}

machine main() crashes Trap {
    let low: Reading = Reading { value: 1.75 };
    let high: Reading = Reading { value: 2.25 };
    transition probe(high, low, true) == 0 && probe(high, low, false) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
