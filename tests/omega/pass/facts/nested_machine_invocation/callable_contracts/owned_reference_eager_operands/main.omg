// Expected exit: 0
// Earlier scalar operands retain their read before an owned borrow writes.
data Holder { pointer: &mut u64; }
machine setter(holder: Holder) -> u64
ensures result == 9
{ let pointer: &mut u64 = holder.pointer; pointer = 9; 9 }
machine pair(before: u64, after: u64) -> u64
requires before == 5
requires after == 9
ensures result == 14
{ before + after }
machine main() crashes Trap {
    let mut value: u64 = 5;
    let result: u64 = pair(value, setter(Holder { pointer: &mut value }));
    transition result == 14 && value == 9 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
