// Expected exit: 0
// Owned containers retain loans of their mutable referenced storage.
data Holder { pointer: &mut u64; }
machine provider(holder: Holder)
requires holder.pointer == 5
ensures holder.pointer == 9
{ let pointer: &mut u64 = holder.pointer; pointer = 9; }
machine apply<machine Change>(holder: Holder)
requires machine Change(item: Holder) requires item.pointer == 5 ensures item.pointer == 9;
requires holder.pointer == 5
{
    inner(holder);
    machine inner(item: Holder)
    requires item.pointer == 5
    { Change(item); }
}
machine main() crashes Trap {
    let mut value: u64 = 5;
    let holder: Holder = Holder { pointer: &mut value };
    apply<provider>(holder);
    transition value == 9 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
