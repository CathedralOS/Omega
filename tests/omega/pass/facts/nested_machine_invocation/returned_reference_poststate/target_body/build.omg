machine build(builder: &mut Build) {
    Build::application(builder, "returned_view_poststate");
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedView, X86View>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedView, X86View>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::select_provider<SelectedView, ArmView>(builder, macos_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::select_provider<SelectedView, ArmView>(builder, linux_arm64);
}
