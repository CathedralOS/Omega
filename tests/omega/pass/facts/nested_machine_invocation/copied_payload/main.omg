// Expected exit: 0
// A copied case payload ends its source observation before the helper mutates that source.
data Item [copy] { case Empty; case Ready(count: u64); }

machine take(item: &mut Item) -> u64 {
    transition item {
        Item::Ready { count } -> clear(item, count)
        Item::Empty -> 0
    }
    machine clear(item: &mut Item, count: u64) -> u64 {
        item = Item::Empty;
        count
    }
}

machine main() crashes Trap {
    let mut item: Item = Item::Ready { count: 42 };
    let count: u64 = take(&mut item);
    let empty: u64 = take(&mut item);
    transition count == 42 && empty == 0 {
        true -> done()
        false -> failed()
    }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
