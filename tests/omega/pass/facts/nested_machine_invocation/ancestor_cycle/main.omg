// Nested terminal cycles retain explicitly supplied borrowed backing without growing the stack.
// Expected exit: 0.
machine count(value: &mut u64, remaining: u64) {
    transition remaining == 0 {
        true -> done()
        false -> step(value, remaining)
    }
    machine step(value: &mut u64, remaining: u64)
    requires remaining > 0;
    {
        value = (value as u64 in Wrapping + 1) as u64;
        transition { _ -> count(value, remaining - 1) }
    }
    machine done() {}
}
machine main() crashes Trap {
    let mut value: u64 = 0;
    count(&mut value, 100000);
    transition value == 100000 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
