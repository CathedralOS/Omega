// Fact: mutating or borrowing one field (pair.left) of a structural record (Pair { left: u64, right: u64 }) preserves the static bound on its provably disjoint sibling field (pair.right <= 75u64), discharging exact subtraction 75u64 - pair.right across all nine places.
// Expected exit: 0

data Pair {
    left: u64;
    right: u64;
}

data Holder {
    pair: Pair;
}

machine touch_left(left: &mut u64) {
    left = 999u64;
}

machine exercise() -> u64
ensures result == 50u64
{
    let mut holder: Holder = Holder {
        pair: Pair { left: 10u64, right: 25u64 }
    };
    touch_left(&mut holder.pair.left);
    let diff: u64 = 75u64 - holder.pair.right;
    diff
}

machine main() crashes Trap {
    let diff: u64 = exercise();
    transition diff == 50u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
