machine build(builder: &mut Build) {
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, linux_x86_64);
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, windows_x86_64);
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, macos_x86_64);

    Build::application(builder, "checked_asm_rank_decrease_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
}
