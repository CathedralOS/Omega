// Fact: 8-bit signed saturating multiplication lhs *| rhs with bounded interval 40i8 <= prod <= 96i8 establishes 40i8 <= prod <= 96i8 across all nine places so exact subtractions 96i8 - prod and prod - 40i8 are safe.
// Place: another state. A successor state receives bounded 8-bit operands before saturating multiplication and interval discharge.
// Expected exit: 0

machine verify_prod(value: i8) -> i8 requires value >= 40i8 && value <= 96i8 {
    let headroom: i8 = 96i8 - value;
    let margin: i8 = value - 40i8;
    headroom + margin
}

machine sat_state(lhs: i8, rhs: i8) -> i8
requires lhs >= 8 && lhs <= 12 && rhs >= 5 && rhs <= 8
{
    transition {
        _ -> step(lhs, rhs)
    }
    state step(l: i8, r: i8) -> i8
    requires l >= 8 && l <= 12 && r >= 5 && r <= 8
    {
        let a: i8 in Saturating = l as i8 in Saturating;
        let b: i8 in Saturating = r as i8 in Saturating;
        let sat_prod: i8 in Saturating = a * b;
        let prod: i8 = sat_prod as i8;
        verify_prod(prod)
    }
}

machine probe() -> i8 {
    sat_state(10i8, 7i8)
}

machine main() crashes Trap {
    transition probe() == 56 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
