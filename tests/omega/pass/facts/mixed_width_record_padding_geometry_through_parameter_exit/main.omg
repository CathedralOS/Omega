// Fact: querying size_of and align_of on a mixed-width structural record (Padded { tag: u8, value: u64 }) establishes its exact 16-byte alignment-padded layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: parameter. Helper machines receive the queried size and alignment directly as explicit parameters.
// Expected exit: 0

data Padded {
    tag: u8;
    value: u64;
}

machine receive_size(s: u64) -> u64 {
    s
}

machine receive_align(a: u64) -> u64 {
    a
}

machine main() crashes Trap {
    let s: u64 = size_of<Padded>();
    let a: u64 = align_of<Padded>();
    let diff: u64 = receive_size(s) - (receive_align(a) * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
