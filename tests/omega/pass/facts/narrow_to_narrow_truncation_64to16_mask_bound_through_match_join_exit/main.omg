// Fact: narrowing a masked unsigned 64-bit integer to u16 and zero-extending back to u64 ((val & 63u64) as u16 as u64) preserves the exact mask upper bound (truncated <= 63u64), discharging exact subtraction 63u64 - truncated across all nine places.
// Expected exit: 0

machine choose(val: u64, flag: bool) -> u64
ensures result <= 63u64
{
    match flag {
        true -> (val & 63u64) as u16 as u64,
        false -> (val & 15u64) as u16 as u64,
    }
}

machine exercise(val: u64, flag: bool) -> u64 {
    let truncated: u64 = choose(val, flag);
    let diff: u64 = 63u64 - truncated;
    diff
}

machine main() crashes Trap {
    let diff1: u64 = exercise(466u64, true);
    let diff2: u64 = exercise(466u64, false);
    transition diff1 == 45u64 && diff2 == 61u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
