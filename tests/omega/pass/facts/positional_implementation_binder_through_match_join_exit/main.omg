// Expected exit: 0
// Reader in the middle slot of Carrier<u64, Reader, i32> supplies at least seven before exact value - 7.
trait Reading {
    machine floor() -> u64 ensures result >= 7;
}

Seven satisfies Reading {
    machine floor() -> u64 ensures result >= 7 { 7 }
}

trait Loose {
    machine floor() -> u64 ensures result >= 6;
}

Other satisfies Loose {
    machine floor() -> u64 ensures result >= 6 { 6 }
}

trait Carrier<Mark, Reader satisfies Reading, Tag> {
    machine floor() -> u64 ensures result >= 7 {
        Reading::floor<Reader>()
    }
}

Chosen satisfies Carrier<u64, Seven, i32> { }

machine choose(left: bool) -> u64
ensures result >= 7
{ match left { true -> Chosen::floor(), false -> Chosen::floor() } }
machine main() crashes Trap {
    let value: u64 = choose(true);
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
