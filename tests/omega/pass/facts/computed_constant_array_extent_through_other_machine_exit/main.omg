// Computed constant array extents preserve the selected value 3 through an alias.
// Expected exit: 0
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
data Inspector {}
machine Inspector::check(arr: &[u64; SIZE]) -> bool {
    arr[0] == 3
}
machine main() crashes Trap {
    let local_arr: [u64; SIZE] = ALIAS;
    transition Inspector::check(&local_arr) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
