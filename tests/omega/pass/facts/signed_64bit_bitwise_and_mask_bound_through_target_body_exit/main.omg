// Fact: 64-bit signed bitwise AND mask raw & 63i64 with bounded interval 40i64 <= masked <= 63i64 establishes 40i64 <= masked <= 63i64 across all nine places so exact subtractions 63i64 - masked and masked - 40i64 are safe.
// Place: another target body. Each of four target-scoped machine bodies performs 64-bit bitwise AND and discharges interval.
// Expected exit: 0

machine verify_masked(masked: i64) -> i64
requires masked >= 40 && masked <= 63
{
    let headroom: i64 = 63i64 - masked;
    let margin: i64 = masked - 40i64;
    headroom + margin
}

linux_x86_64 machine bitwise_and_target(raw: i64) -> i64
requires raw >= 112 && raw <= 127
{
    let masked: i64 = raw & 63i64;
    verify_masked(masked)
}

linux_arm64 machine bitwise_and_target(raw: i64) -> i64
requires raw >= 112 && raw <= 127
{
    let masked: i64 = raw & 63i64;
    verify_masked(masked)
}

macos_arm64 machine bitwise_and_target(raw: i64) -> i64
requires raw >= 112 && raw <= 127
{
    let masked: i64 = raw & 63i64;
    verify_masked(masked)
}

windows_x86_64 machine bitwise_and_target(raw: i64) -> i64
requires raw >= 112 && raw <= 127
{
    let masked: i64 = raw & 63i64;
    verify_masked(masked)
}

machine probe() -> i64 {
    bitwise_and_target(116i64)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
