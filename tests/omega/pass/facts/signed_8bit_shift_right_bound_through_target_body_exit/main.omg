// Fact: an 8-bit signed i8 arithmetic right shift of a bounded input (val >= 100i8 && val <= 100i8) by 2u32 bits establishes shifted >= 25i8 && shifted <= 25i8 so exact 8-bit signed subtraction shifted - 25i8 is proved overflow-free across all nine places.
// Place: target_body. Each of four target bodies performs 8-bit signed arithmetic right shift and verifies the bound.
// Expected exit: 0

machine verify_shifted(shifted: i8) -> i32
requires shifted >= 25i8 && shifted <= 25i8
{
    let check: i8 = shifted - 25i8;
    0i32
}

linux_x86_64 machine verify_target() -> i32 {
    let val: i8 = 100i8;
    let shift: u32 = 2u32;
    let shifted: i8 = val >> shift;
    verify_shifted(shifted)
}

linux_arm64 machine verify_target() -> i32 {
    let val: i8 = 100i8;
    let shift: u32 = 2u32;
    let shifted: i8 = val >> shift;
    verify_shifted(shifted)
}

macos_arm64 machine verify_target() -> i32 {
    let val: i8 = 100i8;
    let shift: u32 = 2u32;
    let shifted: i8 = val >> shift;
    verify_shifted(shifted)
}

windows_x86_64 machine verify_target() -> i32 {
    let val: i8 = 100i8;
    let shift: u32 = 2u32;
    let shifted: i8 = val >> shift;
    verify_shifted(shifted)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
