// Fact: 8-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 60u8 <= diff <= 160u8 establishes 60u8 <= diff <= 160u8 across all nine places so exact subtractions 160u8 - diff and diff - 60u8 are safe.
// Place: const name. Named constants supply bounded 8-bit operands before wrapping subtraction and verification.
// Expected exit: 0

const LHS_VAL: u8 = 140u8;
const RHS_VAL: u8 = 30u8;

machine verify_diff(value: u8) -> u8 requires value >= 60u8 && value <= 160u8 {
    let headroom: u8 = 160u8 - value;
    let margin: u8 = value - 60u8;
    headroom + margin
}

machine wrap_const() -> u8 {
    let a: u8 in Wrapping = LHS_VAL as u8 in Wrapping;
    let b: u8 in Wrapping = RHS_VAL as u8 in Wrapping;
    let wrap_diff: u8 in Wrapping = a - b;
    let diff: u8 = wrap_diff as u8;
    verify_diff(diff)
}

machine probe() -> u8 {
    wrap_const()
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
