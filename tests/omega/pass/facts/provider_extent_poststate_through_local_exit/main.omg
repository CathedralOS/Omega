// A copied first argument equal to 7 stays 7 when the second argument overwrites its former home with 9.
// Place: local.
// Expected exit: 0
public data View<'storage> [copy] { bytes: &'storage [u8]; }
data Counter { value: bool; }
data Counted<Count: u64> [copy] where value == Count { value: u64; }
public trait Installing {
    machine install<'storage>(slot: &mut View<'storage>, replacement: &'storage [u8]) -> u64 ensures slot.bytes.len == replacement.len;
}
Installer satisfies Installing {
    machine install<'storage>(destination: &mut View<'storage>, incoming: &'storage [u8]) -> u64
    ensures destination.bytes.len == incoming.len
    { destination.bytes = incoming; 0 }
}
machine snapshot(source: u64, counter: &mut Counter) -> Counted<(source)>
{ counter.value = !counter.value; Counted { value: source } }
machine overwrite<'storage>(slot: &mut View<'storage>) -> u64 { slot.bytes = "123456789"; 0 }
machine seven(value: u64) -> u64 requires value == 7 ensures result == 7 { value }
machine receive(selected: Counted<7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<7> = selected; seven(saved.value) }
machine receive_ordered(earlier: u64, selected: Counted<7>, ignored: u64) -> u64
ensures result == 7
{ receive(selected, ignored) }
machine main() crashes Trap {
    let storage: [u8; 7] = [49, 50, 51, 52, 53, 54, 55];
    let mut source: View = View { bytes: &storage[..1] };
    let mut counter: Counter = Counter { value: false };
    let observed: u64 = receive_ordered(Installing::install(Installer as dyn Installing, &mut source, &storage[..]), snapshot(source.bytes.len, &mut counter), overwrite(&mut source));
    let difference: u64 = observed - 7;
    transition counter.value && difference == 0 && source.bytes.len == 9 { true -> done() false -> wrong() }
    state done() {} state wrong() { crash Trap; }
}
