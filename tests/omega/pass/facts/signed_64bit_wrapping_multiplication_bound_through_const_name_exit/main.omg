// Fact: 64-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i64 <= prod <= 200i64 establishes 50i64 <= prod <= 200i64 across all nine places so exact subtractions 200i64 - prod and prod - 50i64 are safe.
// Place: const name. Named constants supply bounded 64-bit operands before wrapping multiplication and interval discharge.
// Expected exit: 0

machine verify_prod(value: i64) -> i64 requires value >= 50i64 && value <= 200i64 {
    let headroom: i64 = 200i64 - value;
    let margin: i64 = value - 50i64;
    headroom + margin
}

const LHS_VAL: i64 = 15i64;
const RHS_VAL: i64 = 8i64;

machine sat_const() -> i64 {
    let a: i64 in Wrapping = LHS_VAL as i64 in Wrapping;
    let b: i64 in Wrapping = RHS_VAL as i64 in Wrapping;
    let wrap_prod: i64 in Wrapping = a * b;
    let prod: i64 = wrap_prod as i64;
    verify_prod(prod)
}

machine probe() -> i64 {
    sat_const()
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
