// Fact: A 32-bit unsigned u32 division of bounded inputs (dividend >= 200u32 && dividend <= 200u32, divisor >= 4u32 && divisor <= 4u32) establishes quotient >= 50u32 && quotient <= 50u32 so exact 32-bit subtraction quotient - 50u32 is proved underflow-free across all nine places.
// Place: field. The bounded operands are stored within a nominal record field.
// Expected exit: 0

data Operands {
    dividend: u32;
    divisor: u32;
}

machine divide_field(dividend: u32, divisor: u32) -> i32
    requires dividend >= 200u32 && dividend <= 200u32;
    requires divisor >= 4u32 && divisor <= 4u32;
{
    let ops: Operands = Operands { dividend: dividend, divisor: divisor };
    let quotient: u32 = ops.dividend / ops.divisor;
    let check: u32 = quotient - 50u32;
    transition quotient == 50u32 && check == 0u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_field(200u32, 4u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
