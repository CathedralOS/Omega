machine build(builder: &mut Build) {
    Build::select_provider<SelectedTrial, CheckedTrial>(builder, linux_x86_64);
    Build::select_provider<SelectedTrial, CheckedTrial>(builder, linux_arm64);
    Build::select_provider<SelectedTrial, CheckedTrial>(builder, macos_arm64);
    Build::select_provider<SelectedTrial, CheckedTrial>(builder, windows_x86_64);

    Build::application(builder, "nested_result_extent_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
