// Expected exit: 0.
// A non-observing single attempt returns the proposed u32 on failure and the displaced u32 on commit.
// This control checks the same payload rule for the u64 native carrier.
use omega::language::core::AtomicTryExchangeOnceOutcome;
data Cells { selected: AtomicU64; untouched: AtomicU64; }
machine attempt64(cells: &Cells, expected: u64) -> AtomicTryExchangeOnceOutcome<u64> {
    let outcome: AtomicTryExchangeOnceOutcome<u64> = cells.selected.try_exchange_once(expected, 8589934691u64, ReceivePublish, Receive);
    outcome
}
machine probe(cells: &Cells) -> bool {
    cells.selected.store(4294967306u64, NoOrdering);
    cells.untouched.store(4294967313u64, NoOrdering);
    let outcome: AtomicTryExchangeOnceOutcome<u64> = attempt64(cells, 4294967306u64);
    transition outcome {
        AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (displaced == 4294967306u64 && cells.selected.load(NoOrdering) == 8589934691u64 && cells.untouched.load(NoOrdering) == 4294967313u64)
        AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (false)
        AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (proposed == 8589934691u64 && cells.selected.load(NoOrdering) == 4294967306u64 && cells.untouched.load(NoOrdering) == 4294967313u64)
    }
}
machine mismatch(cells: &Cells) -> bool {
    cells.selected.store(4294967306u64, NoOrdering);
    cells.untouched.store(4294967313u64, NoOrdering);
    let outcome: AtomicTryExchangeOnceOutcome<u64> = attempt64(cells, 4294967305u64);
    transition outcome {
        AtomicTryExchangeOnceOutcome::Mismatched { proposed } -> (proposed == 8589934691u64 && cells.selected.load(NoOrdering) == 4294967306u64 && cells.untouched.load(NoOrdering) == 4294967313u64)
        AtomicTryExchangeOnceOutcome::Exchanged { displaced } -> (false)
        AtomicTryExchangeOnceOutcome::Uncommitted { proposed } -> (false)
    }
}
machine main() crashes Trap {
    let cells: Cells;
    transition probe(&cells) && mismatch(&cells) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
