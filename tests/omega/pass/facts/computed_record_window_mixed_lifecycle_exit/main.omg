// In the which == 0 arm, [0..which + 2] has length 2; hold preserves that
// extent in its returned Held.values, through which write_pair writes the backing.
// Expected exit: 0
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

data Held<'samples> { values: &'samples mut [f64]; }
machine select_window<'samples>(samples: &'samples mut [f64; 4], which: i64) -> &'samples mut [f64]
ensures result.len == 2
{
    match which {
        0 -> &mut samples[0..which + 2]
        _ -> &mut samples[2..4]
    }
}
machine hold<'samples>(samples: &'samples mut [f64]) -> Held<'samples>
requires samples.len == 2
ensures result.values.len == 2
{
    Held { values: samples }
}

machine write_pair(window: &mut [f64])
requires window.len >= 2 {
    window[0] = 0.0;
    window[1] = 1.0;
}

machine consume<'samples>(samples: &'samples mut [f64; 4], which: i64, direct: bool, carry: bool) {
    let selected: &mut [f64] = match direct {
        true -> match which {
            0 -> &mut samples[0..which + 2]
            _ -> &mut samples[2..4]
        }
        false -> select_window(samples, which)
    };
    transition carry {
        true -> write(selected)
        false -> done()
    }
    state write(selected: &'samples mut [f64])
    requires selected.len == 2 {
        let leading: Held = hold(selected);
        write_pair(leading.values);
    }
    state done() {}
}
machine exercise(which: i64, direct: bool, carry: bool) crashes Trap {
    let mut samples: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    consume(&mut samples, which, direct, carry);
    transition (carry && which == 0 && samples[0] == 0.0 && samples[1] == 1.0 && samples[2] == 9.0 && samples[3] == 9.0)
        || (carry && which != 0 && samples[0] == 9.0 && samples[1] == 9.0 && samples[2] == 0.0 && samples[3] == 1.0)
        || (!carry && samples[0] == 9.0 && samples[1] == 9.0 && samples[2] == 9.0 && samples[3] == 9.0) {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
machine main() crashes Trap {
    exercise(0, true, true);
    exercise(0, true, false);
    exercise(0, false, true);
    exercise(0, false, false);
    exercise(1, true, true);
    exercise(1, true, false);
    exercise(1, false, true);
    exercise(1, false, false);
}
