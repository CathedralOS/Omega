// A literal selection of a const-only finite-family method keeps its declaring roster and returns the selected row's value.
// Expected exit: 0
// Place: call_result.
trait Family {
    machine row<const Width: u32>() -> u32 where Width == 16 || Width == 32;
}
Selected satisfies Family {
    machine row<const Width: u32>() -> u32 where Width == 16 || Width == 32 { Width }
}
Other satisfies Family {
    machine row<const Width: u32>() -> u32 where Width == 16 || Width == 32 { Width }
}
machine selected_width(selection: dyn Family) -> u32 { Family::row<16>(selection) }

machine choose() -> dyn Family { Selected as dyn Family }
machine main() crashes Trap {
    let observed: u32 = selected_width(choose());
    transition observed == 16 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
