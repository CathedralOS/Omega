// A literal selection of a const-only finite-family method keeps its declaring roster and returns the selected row's value.
// Expected exit: 0
// Place: target_body.
trait Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32;
}
Selected satisfies Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32 { Width }
}
Other satisfies Family {
    machine row<const Width: u32>() -> u32
    requires Width == 16 || Width == 32 {
        transition Width == 16 { true -> 17 false -> 33 }
    }
}
machine selected_width(selection: dyn Family) -> u32 { Family::row<16>(selection) }

boundary trait FamilyForward {
    machine forward(selected: dyn Family) -> u32 reaches;
}
HostedFamily satisfies FamilyForward {
    machine forward(selected: dyn Family) -> u32 { selected_width(selected) }
}
machine main() crashes Trap invokes FamilyForward {
    let first: u32 = FamilyForward::forward(Selected as dyn Family);
    let second: u32 = FamilyForward::forward(Other as dyn Family);
    transition first == 16 && second == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
