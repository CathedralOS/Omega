machine build(builder: &mut Build) {
    Build::application(builder, "finite_const_roster_target_body");
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::accept_boundary<FamilyForward>(builder);
    Build::select_provider<FamilyForward, HostedFamily>(builder, macos_x86_64);
    Build::select_provider<FamilyForward, HostedFamily>(builder, windows_x86_64);
    Build::select_provider<FamilyForward, HostedFamily>(builder, linux_x86_64);
    Build::select_provider<FamilyForward, HostedFamily>(builder, macos_arm64);
    Build::select_provider<FamilyForward, HostedFamily>(builder, linux_arm64);
    Build::select_provider<WideRowTarget, HostedWideRow>(builder, linux_x86_64);
    Build::select_provider<WideRowTarget, HostedWideRow>(builder, linux_arm64);
    Build::select_provider<WideRowTarget, HostedWideRow>(builder, macos_arm64);
    Build::select_provider<WideRowTarget, HostedWideRow>(builder, windows_x86_64);
    Build::select_provider<WideRowTarget, HostedWideRow>(builder, macos_x86_64);
}
