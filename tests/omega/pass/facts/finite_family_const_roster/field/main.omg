// A literal selection of a const-only finite-family method keeps its declaring roster and returns the selected row's value.
// Expected exit: 0
// Place: field.
trait Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32;
}
Selected satisfies Family {
    machine row<const Width: u32>() -> u32 requires Width == 16 || Width == 32 { Width }
}
Other satisfies Family {
    machine row<const Width: u32>() -> u32
    requires Width == 16 || Width == 32 {
        transition Width == 16 { true -> 17 false -> 33 }
    }
}
machine selected_width(selection: dyn Family) -> u32 { Family::row<16>(selection) }

data Choice { before: u32; selected: dyn Family; after: u32; }
machine main() crashes Trap {
    let selected: Choice = Choice { before: 17, selected: Selected as dyn Family, after: 23 };
    let other: Choice = Choice { before: 17, selected: Other as dyn Family, after: 23 };
    let first: u32 = selected_width(selected.selected);
    let second: u32 = selected_width(other.selected);
    transition first == 16 && second == 17 && selected.before == 17 && selected.after == 23
        && other.before == 17 && other.after == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
