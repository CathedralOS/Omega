// Fact: 64-bit unsigned wrapping subtraction lhs -% rhs with bounded interval 40u64 <= diff <= 100u64 establishes 40u64 <= diff <= 100u64 across all nine places so exact subtractions 100u64 - diff and diff - 40u64 are safe.
// Place: target_body. Each of four target bodies performs 64-bit wrapping subtraction and discharges subtraction bounds.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86VerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let lhs: u64 = 100u64;
        let rhs: u64 = 30u64;
        let w_lhs: u64 in Wrapping = lhs as u64 in Wrapping;
        let w_rhs: u64 in Wrapping = rhs as u64 in Wrapping;
        let diff_wrap: u64 in Wrapping = w_lhs - w_rhs;
        let diff: u64 = diff_wrap as u64;
        let headroom: u64 = 100u64 - diff;
        let margin: u64 = diff - 40u64;
        0i32
    }
}

ArmVerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let lhs: u64 = 100u64;
        let rhs: u64 = 30u64;
        let w_lhs: u64 in Wrapping = lhs as u64 in Wrapping;
        let w_rhs: u64 in Wrapping = rhs as u64 in Wrapping;
        let diff_wrap: u64 in Wrapping = w_lhs - w_rhs;
        let diff: u64 = diff_wrap as u64;
        let headroom: u64 = 100u64 - diff;
        let margin: u64 = diff - 40u64;
        0i32
    }
}

machine probe() -> i32 {
    SelectedVerifyTarget::verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
