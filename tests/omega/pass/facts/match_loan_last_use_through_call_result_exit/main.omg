// A match on one evaluation of a copyable flag selects an exclusive loan, that loan dies at its last use, and the source is usable again after that death.
// Place: call_result.
// Expected exit: 0

data Slot { case Absent; case Present(value: [i64; 4]); }

machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    true
}

machine select<'a>(chosen: &'a mut Slot, other: &'a mut Slot, visits: &mut u64) -> &'a mut [i64]
requires chosen in Slot::Present, other in Slot::Present, visits == 0
{
    match choose(visits) {
        true -> &mut chosen.value[0..2]
        false -> &mut other.value[2..4]
    }
}

machine main() crashes Trap {
    let mut chosen: Slot = Slot::Present { value: [17, 0, 5, 6] };
    let mut other: Slot = Slot::Present { value: [0, 0, 8, 9] };
    let mut visits: u64 = 0;
    let selected: &mut [i64] = select(&mut chosen, &mut other, &mut visits);
    selected[0] = 41;
    let written: i64 = selected[0];
    chosen = Slot::Present { value: [7, 0, 7, 0] };
    transition chosen {
        Slot::Present { value } -> kept(written, value[0], visits)
        Slot::Absent -> wrong()
    }
    machine kept(written: i64, restored: i64, visits: u64) {
        transition written == 41 && restored == 7 && visits == 1 {
            true -> done()
            false -> wrong()
        }
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
