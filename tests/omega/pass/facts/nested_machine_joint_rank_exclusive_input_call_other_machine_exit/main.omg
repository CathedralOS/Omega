// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Guard { before: u64; value: u64; after: u64; }
data Progress { lower: u64; upper: u64; canary: u64; guard: &mut Guard; }
machine distance(value: &Progress) -> u64
requires value.lower <= value.upper
ensures result == value.upper - value.lower
terminates
{ value.upper - value.lower }
measure Progress::Remaining(value: Progress) -> u64 { distance(&value) }
machine count(counter: &mut u64, remaining: Progress) crashes Trap
requires remaining.lower <= remaining.upper && remaining.upper <= 7
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.lower < remaining.upper {
        true -> forward(remaining, counter)
        false -> finish(remaining.lower, remaining.upper, remaining.canary, remaining.guard)
    }
    machine forward(pending: Progress, counter: &mut u64) crashes Trap
    requires pending.lower < pending.upper && pending.upper <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Progress = Progress { lower: pending.lower + 1, upper: pending.upper, canary: pending.canary, guard: pending.guard };
        transition { _ -> count(counter, next) }
    }
    machine finish(lower: u64, upper: u64, canary: u64, guard: &mut Guard) crashes Trap {
        transition lower == upper && canary == 641 && guard.before == 919 && guard.value == 827 && guard.after == 923 { true -> stamp(guard) false -> bad() }
    }
    machine stamp(guard: &mut Guard) { guard.value = 828; }
    machine bad() crashes Trap { crash Trap; }
}
machine input(select: bool, guard: &mut Guard) -> Progress
ensures result.lower <= result.upper && result.upper <= 7
{ match select { true -> Progress { lower: 0, upper: 7, canary: 641, guard: guard } false -> Progress { lower: 7, upper: 7, canary: 641, guard: guard } } }
machine perform(counter: &mut u64, select: bool, guard: &mut Guard) crashes Trap {
    relay(counter, input(select, guard));
}
machine relay(counter: &mut u64, received: Progress) crashes Trap
requires received.lower <= received.upper && received.upper <= 7
{ transition { _ -> count(counter, received) } }
machine main() crashes Trap {
    let mut guard: Guard = Guard { before: 919, value: 827, after: 923 };
    let mut counted: u64 = 3;
    perform(&mut counted, true, &mut guard);
    let matched: bool = counted == 10 && guard.value == 828 && guard.before == 919 && guard.after == 923;
    guard.value = 827;
    perform(&mut counted, false, &mut guard);
    transition matched && counted == 10 && guard.value == 828 && guard.before == 919 && guard.after == 923 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
