// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: match join. The shifted value is synthesized across conditional match branches.
// Expected exit: 0

machine shift_match_join(val: u16, choose: bool) -> i32
    requires val >= 30u16 && val <= 30u16;
{
    let shifted: u16 = match choose {
        true -> val << 2u16,
        false -> val << 2u16
    };
    let check: u16 = shifted - 120u16;
    transition shifted == 120u16 && check == 0u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = shift_match_join(30u16, true);
    let res2: i32 = shift_match_join(30u16, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
