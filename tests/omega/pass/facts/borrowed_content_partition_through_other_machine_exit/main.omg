// Expected exit: 0
// A brief exclusive borrow returns detached owned content and restores its source.
// Numeric custody only; this does not supply physical backing.
use borrowed_partition_support::main;

data Allocator {}
machine Allocator::take(strategy: &mut Strategy, remaining: u64, requested: u64) -> Region in Owned
requires remaining == strategy.tail.length && requested <= remaining
ensures result.length == requested,
    strategy.tail.length == remaining - requested,
    strategy.remaining == remaining - requested
{ carve(strategy, remaining, requested) }
machine exercise(select: bool) -> bool {
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let first: Region in Owned = Allocator::take(&mut strategy, 48, 16);
    let second: Region in Owned = Allocator::take(&mut strategy, 32, 8);
    finish(strategy, first, second)
}

machine main() crashes Trap {
    let first: bool = exercise(true);
    let second: bool = exercise(false);
    transition first && second { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
