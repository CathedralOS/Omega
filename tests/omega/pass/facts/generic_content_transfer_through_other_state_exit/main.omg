// Fact: a generic transfer conserves the complete counted content of its owned input.
// Expected exit: 0
// Counted model only; this carrier grants no access to physical storage.
use omega::language::core::content;
use omega::language::core::drop;
data Units {}
data Payload {}
data Region [linear] { amount: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<Units>
satisfies Content<Region, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(region.amount) as Nat }
}
trait Transfer<T> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures Owned::content(old(&region)) == Owned::content(&result);
}
machine retain(region: Region in Owned) -> Region in Owned
satisfies Transfer<Payload>::transfer
ensures Owned::content(old(&region)) == Owned::content(&result)
{ region }
machine observe(region: Region in Owned) -> u64 {
    let observed: u64 = region.amount;
    drop(region);
    observed
}
machine exercise(select: bool) -> u64 {
    transition { _ -> retained(retain(Region { amount: 29 })) }
    state retained(region: Region in Owned) -> u64 { observe(region) }
}
machine main() crashes Trap {
    let first: u64 = exercise(true);
    let second: u64 = exercise(false);
    transition first == 29 && second == 29 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
