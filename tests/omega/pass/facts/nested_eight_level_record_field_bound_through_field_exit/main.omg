// Fact: a 8-level nested structural record RootRec { l1: Level1 { l2: Level2 { l3: Level3 { l4: Level4 { l5: Level5 { l6: Level6 { l7: Level7 { val: u64 } } } } } } } preserves the leaf field bound 40u64 <= root.l1.l2.l3.l4.l5.l6.l7.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: field. The 8-level nested record is stored in a container record field before leaf projection and interval discharge.
// Expected exit: 0

data Level7 [copy] {
    val: u64;
}

data Level6 [copy] {
    l7: Level7;
}

data Level5 [copy] {
    l6: Level6;
}

data Level4 [copy] {
    l5: Level5;
}

data Level3 [copy] {
    l4: Level4;
}

data Level2 [copy] {
    l3: Level3;
}

data Level1 [copy] {
    l2: Level2;
}

data RootRec [copy] {
    l1: Level1;
}

data Holder [copy] {
    record: RootRec;
}

machine check_field(holder: Holder) -> u64
requires holder.record.l1.l2.l3.l4.l5.l6.l7.val >= 40 && holder.record.l1.l2.l3.l4.l5.l6.l7.val <= 80
{
    let res: u64 = holder.record.l1.l2.l3.l4.l5.l6.l7.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine probe() -> u64 {
    let holder: Holder = Holder {
        record: RootRec {
        l1: Level1 {
            l2: Level2 {
                l3: Level3 {
                    l4: Level4 {
                        l5: Level5 {
                            l6: Level6 {
                                l7: Level7 {
                                    val: 60u64,
                                },
                            },
                        },
                    },
                },
            },
        },
    },
    };
    check_field(holder)
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
