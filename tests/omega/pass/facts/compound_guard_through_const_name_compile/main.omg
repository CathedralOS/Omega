// The live fact 0 <= b * 20 + a < 200 permits storing 7 at grid[b * 20 + a].
// Compile-checked only: no ProgramEntry and no native oracle.
const STRIDE: i32 in Wrapping = 20;
const LIMIT: i32 in Wrapping = 200;
data Main {
    hits: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    grid: [i32; 200] in Wrapping;
}
machine Main::main(main: &mut Main) {
    transition main.b * STRIDE + main.a >= 0 && main.b * STRIDE + main.a < LIMIT {
        true -> put(main)
        _ -> done(main)
    }
    state put(main: &mut Main) {
        main.grid[main.b * STRIDE + main.a] = 7;
        main.hits = 1;
    }
    state done(main: &mut Main) { main.hits = -1; }
}
