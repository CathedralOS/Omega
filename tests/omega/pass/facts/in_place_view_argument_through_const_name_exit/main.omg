// A shared byte view formed inside a constructed call argument borrows the caller's exact backing array for that invocation, so the callee proves its extent requirement from the formation and reads the authored bytes.
// Place: Named constants supply the backing extent and the bytes it holds.
// Expected exit: 0
data Input<'input> { tag: u8; bytes: &'input [u8]; tail: u8; }
machine read_third<'input>(packet: Input<'input>) -> u8
requires packet.bytes.len >= 4 {
    transition packet.tag == 5 && packet.tail == 9 {
        true -> third(packet.bytes)
        false -> zero()
    }
    machine third(bytes: &[u8]) -> u8 requires bytes.len >= 4 { bytes[2] }
    machine zero() -> u8 { 0 }
}
const EXTENT: u64 = 4;
const THIRD: u8 = 29;
machine main() crashes Trap {
    let mut packet: [u8; EXTENT];
    packet[0] = 11;
    packet[2] = THIRD;
    let third: u8 = read_third(Input { tag: 5, bytes: &packet, tail: 9 });
    let other: u8 = read_third(Input { tag: 6, bytes: &packet, tail: 9 });
    transition third == THIRD && other == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
