// Expected exit: 0.
machine main() crashes Trap {
 let mut before:u64=0; let mut after:u64=0;
 asm {entry:pushfq before; mov eax,1; sub eax,1; pushfq after; jmp observed;
 observed requires (after&64u64)==64u64: nop }
 transition (before&2u64)==2u64 && (before&196608u64)==0u64 && (after&64u64)==64u64 {true ->done() false->bad()}
 machine done(){} machine bad(){crash Trap;}
}
