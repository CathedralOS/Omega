// Fact: a signed i64 quotient from -300i64 divided by -3i64 equals 100i64 when subtracting 100i64.
// Place: local. The quotient is copied into a local before verifying exact subtraction.
// Expected exit: 0

machine divide_local() -> i32 {
    let q: i64 = (-300i64) / (-3i64);
    let quotient: i64 = q;
    let verified: u64 = quotient as u64;
    let diff: u64 = verified - 100u64;
    diff as i32
}

machine probe() -> i32 {
    divide_local()
}


machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
