// Fact: narrow-to-wide sign-extending -25i8, -35i16, and 160i32 to i64 yields 100u64 when subtracting 100u64.
// Place: other_machine. A forwarding machine transports the narrow-to-wide sign-extended sum through an intermediate machine call.
// Expected exit: 0
machine target_machine(val: u64) -> u64
    ensures result == val
{
    val
}

machine forwarder(val: u64) -> u64
    ensures result == val
{
    target_machine(val)
}

machine evaluate() -> i32 {
    let s8: i64 = -25i8 as i64;
    let s16: i64 = -35i16 as i64;
    let s32: i64 = 160i32 as i64;
    let sum: i64 = s8 + s16 + s32;
    let extended: u64 = forwarder(sum as u64);
    let sub: u64 = extended - 100u64;
    sub as i32
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
