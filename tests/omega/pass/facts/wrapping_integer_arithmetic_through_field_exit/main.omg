// Masking an unsigned scalar with a constant bitmask (val & 63u64) establishes the upper bound (masked <= 63u64), discharging exact subtraction 63u64 - masked.
// Expected exit: 0.
data Carrier [copy] {
    masked: u64;
}

machine main() crashes Trap {
    let val: u64 = 100u64;
    let c: Carrier = Carrier { masked: val & 63u64 };
    let diff: u64 = 63u64 - c.masked;
    transition diff == 27u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
