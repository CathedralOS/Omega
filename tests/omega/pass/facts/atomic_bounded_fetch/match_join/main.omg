// Expected exit: 0.
// A shared atomic fetch preserves its resident bound and ordering, and a load carries that bound into Exact subtraction.
data Cell requires value <= 100 { value: AtomicU32; }
machine mutate(cell: &Cell, mask: u32) -> u32 requires mask <= 63 {
    let prior: u32 = cell.value.fetch_and(mask, NoOrdering);
    prior
}
machine marked(value: u32, path: &write u64) -> u32
requires value <= 100
ensures result <= 100
{
    path = 1u64;
    value
}
machine join(value: u32, branch: bool, path: &write u64) -> u32
requires value <= 100
ensures result <= 100
{
    let joined: u32 = match branch { true -> marked(value, path), false -> value, };
    joined
}
machine run_case(branch: bool, expected_path: u64) -> bool {
    let cell: Cell;
    cell.value.store(99, NoOrdering);
    let prior: u32 = mutate(&cell, 63);
    let mut path: u64 = 0u64;
    let observed: u32 = join(cell.value.load(NoOrdering), branch, &write path);
    let remaining: u32 = 100 - observed;
    prior == 99 && observed == 35 && remaining == 65 && path == expected_path
}
machine main() crashes Trap {
    transition run_case(true, 1u64) && run_case(false, 0u64) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
