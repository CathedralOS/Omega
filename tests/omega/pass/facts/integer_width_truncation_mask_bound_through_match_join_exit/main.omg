// Fact: masking an unsigned 64-bit integer to its low byte (val & 255u64) establishes the exact byte-width upper bound (masked <= 255u64), discharging exact subtraction 255u64 - masked across all nine places.
// Expected exit: 0

machine choose(val: u64, flag: bool) -> u64
ensures result <= 255u64
{
    match flag {
        true -> val & 255u64,
        false -> val & 127u64,
    }
}

machine exercise(val: u64, flag: bool) -> u64 {
    let masked: u64 = choose(val, flag);
    let diff: u64 = 255u64 - masked;
    diff
}

machine main() crashes Trap {
    let diff1: u64 = exercise(466u64, true);
    let diff2: u64 = exercise(466u64, false);
    transition diff1 == 45u64 && diff2 == 173u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
