// Fact: a 3-level nested structural record Outer { mid: Middle { inner: Inner { val: u64 } } } preserves the leaf field bound 40u64 <= outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: call result. Contracted helper calls return the 3-level nested record before leaf projection and interval discharge.
// Expected exit: 0

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

machine make_outer() -> Outer
ensures result.mid.inner.val >= 40 && result.mid.inner.val <= 80
{
    Outer {
        mid: Middle {
            inner: Inner {
                val: 60u64,
            },
        },
    }
}

machine check_call_result() -> u64 {
    let outer: Outer = make_outer();
    let res: u64 = outer.mid.inner.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    headroom + margin
}

machine probe() -> u64 {
    check_call_result()
}

machine main() crashes Trap {
    transition probe() == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
