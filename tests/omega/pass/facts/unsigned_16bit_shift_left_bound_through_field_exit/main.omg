// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: field. The bounded input operand is stored within a nominal record field.
// Expected exit: 0

data Operands {
    val: u16;
}

machine shift_field(val: u16) -> i32
    requires val >= 30u16 && val <= 30u16;
{
    let ops: Operands = Operands { val: val };
    let shifted: u16 = ops.val << 2u16;
    let check: u16 = shifted - 120u16;
    transition shifted == 120u16 && check == 0u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = shift_field(30u16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
