// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Place: another state. A successor state receives the bounded operand and shift count before left shift and subtraction.
// Expected exit: 0

machine shift_state(val: u64, shift: u32) -> u64
requires val >= 25 && val <= 25 && shift == 2
{
    transition {
        _ -> step(val, shift)
    }
    state step(v: u64, s: u32) -> u64
    requires v >= 25 && v <= 25 && s == 2
    {
        let shifted: u64 = v << s;
        shifted - 100u64
    }
}

machine probe() -> u64 {
    shift_state(25u64, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
