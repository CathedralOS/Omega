windows_x86_64 machine verify_target() -> i32 {
    let lhs: u8 = 50u8;
    let rhs: u8 = 70u8;
    let sum: u8 = lhs + rhs;
    let headroom: u8 = 180u8 - sum;
    let margin: u8 = sum - 70u8;
    let total: u8 = headroom + margin;
    match total == 110u8 {
        true -> 0i32,
        false -> 1i32,
    }
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
