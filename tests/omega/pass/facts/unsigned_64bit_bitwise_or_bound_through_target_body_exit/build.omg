machine build(builder: &mut Build) {
    Build::select_provider<SelectedBitwiseOrTarget, CheckedBitwiseOrTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedBitwiseOrTarget, CheckedBitwiseOrTarget>(builder, linux_arm64);
    Build::select_provider<SelectedBitwiseOrTarget, CheckedBitwiseOrTarget>(builder, macos_arm64);
    Build::select_provider<SelectedBitwiseOrTarget, CheckedBitwiseOrTarget>(builder, windows_x86_64);

    Build::application(builder, "unsigned_64bit_bitwise_or_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
