// A static callback retains its exact selection and bounded reach through a conformance invocation; its transported result discharges 37 - result.
// Expected exit: 0
public boundary trait Console {}
public boundary trait Extra {}
public trait StepContract {
    machine step(value: u64) -> u64
    reaches Console terminates;
    requires value <= 37
    ensures result <= 37;
}
machine quiet(value: u64) -> u64
satisfies StepContract::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine second(value: u64) -> u64
satisfies StepContract::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine private_helper<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
terminates;
requires value <= 37
ensures result <= 37
{ transition { _ -> Step(value) } }
machine note(value: u64) -> u64 reaches Console terminates;
requires value <= 37 ensures result <= 37
{ value }
machine traverse<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
terminates;
requires value <= 37
ensures result <= 37
{ private_helper<Step>(value) }
machine with_note<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
terminates;
requires value <= 37
ensures result <= 37
{ let observed: u64 = private_helper<Step>(value); note(observed) }
machine pure_observer() -> u64 reaches
ensures result <= 37
{ traverse<quiet>(37) }
machine note_observer() -> u64 reaches Console
ensures result <= 37
{ with_note<quiet>(37) }
machine main() reaches Console crashes Trap {
    let value: u64 = traverse<quiet>(37);
    let margin: u64 = 37 - value;
    let pure: u64 = pure_observer();
    let fixed: u64 = note_observer();
    transition margin == 0 && pure == 37 && fixed == 37 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
