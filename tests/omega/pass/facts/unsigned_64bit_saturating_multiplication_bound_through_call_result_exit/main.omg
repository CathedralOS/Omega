// Fact: 64-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u64 <= prod <= 200u64 establishes 50u64 <= prod <= 200u64 across all nine places so exact subtractions 200u64 - prod and prod - 50u64 are safe.
// Place: call result. The product is received from a helper call returning the saturating multiplication result.
// Expected exit: 0

machine compute_sat_prod(l: u64, r: u64) -> u64
    requires l >= 10u64 && l <= 20u64;
    requires r >= 5u64 && r <= 10u64;
    ensures result >= 50u64 && result <= 200u64;
{
    let a: u64 in Saturating = l as u64 in Saturating;
    let b: u64 in Saturating = r as u64 in Saturating;
    let p_sat: u64 in Saturating = a * b;
    p_sat as u64
}

machine multiply_call_result(lhs: u64, rhs: u64) -> i32
    requires lhs >= 10u64 && lhs <= 20u64;
    requires rhs >= 5u64 && rhs <= 10u64;
{
    let prod: u64 = compute_sat_prod(lhs, rhs);
    let headroom: u64 = 200u64 - prod;
    let margin: u64 = prod - 50u64;
    transition prod == 120u64 && headroom + margin == 150u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = multiply_call_result(15u64, 8u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
