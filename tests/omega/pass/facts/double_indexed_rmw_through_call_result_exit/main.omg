// A const write of 41 at grid[1][2] becomes 42 after grid[i][j] = grid[i][j] + 1 with i == 1 and j == 2, and rows[2].data[1] becomes 42 after the same increment while rows[2].tag stays 7.
// The operation is that pair of read-modify-writes through borrowed caller storage.
// Expected exit: 0
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
machine new_grid() -> [[i32 in Wrapping; 4]; 3] {
    let mut grid: [[i32 in Wrapping; 4]; 3];
    grid
}

machine new_rows() -> [Row; 3] {
    let mut rows: [Row; 3];
    rows
}

machine main() crashes Trap {
    let mut grid: [[i32 in Wrapping; 4]; 3] = new_grid();
    let mut rows: [Row; 3] = new_rows();
    transition { _ -> rmw(&mut grid, &mut rows, 1, 2, 2, 1) }
    machine rmw(grid: &mut [[i32 in Wrapping; 4]; 3], rows: &mut [Row; 3], i: u64, j: u64, ri: u64, rj: u64)
    requires i <= 2
    requires j <= 3
    requires ri <= 2
    requires rj <= 1 {
        grid[1][2] = 41;
        grid[i][j] = grid[i][j] + 1;
        let grid_got: i32 in Wrapping = grid[1][2];
        rows[2].data[1] = 41;
        rows[2].tag = 7;
        rows[ri].data[rj] = rows[ri].data[rj] + 1;
        let rows_got: i32 in Wrapping = rows[2].data[1] + rows[2].tag;
        transition grid_got == 42 && rows_got == 49 { true -> done() _ -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
