// A private helper preserves a signed invocation rank, and every complete cycle strictly descends through zero while advancing the explicit counter once.
// Expected exit: 0
data Remaining { canary: u64; values: [i64; 2]; }
machine rank(value: i64) -> i8
terminates
requires value >= -1 && value <= 2
ensures (result as i64) == 0i64 - value
{ (0i64 - value) as i8 }
measure Remaining::Complement(value: i64) -> i8 { rank(value) }
machine count(counter: &mut u64, remaining: &mut Remaining, slot: u64) crashes Trap
terminates
terminates by remaining.values[slot] -> Remaining::Complement in -128..=127
requires slot < 2 && remaining.values[slot] >= -1 && remaining.values[slot] <= 2
{
    transition remaining.values[slot] < 2 {
        true -> forward(remaining, slot, counter)
        false -> finish(remaining.canary)
    }
    machine forward(pending: &mut Remaining, selected: u64, counter: &mut u64) crashes Trap
    terminates
    terminates by pending.values[selected] -> Remaining::Complement in -128..=127
    requires selected < 2 && pending.values[selected] >= -1 && pending.values[selected] < 2
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.values[selected] = pending.values[selected] + 1;
        transition { _ -> count(counter, pending, selected) }
    }
    machine finish(canary: u64) crashes Trap {
        transition canary == 641 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, active: bool, second: bool) crashes Trap {
    let amount: i64 = match active { true -> -1 false -> 2 };
    let slot: u64 = match second { true -> 1 false -> 0 };
    let mut remaining: Remaining = Remaining { canary: 641, values: [amount, amount] };
    invoke(counter, &mut remaining, slot);
    let preserved: bool = match second {
        true -> remaining.values[0] == amount && remaining.values[1] == 2
        false -> remaining.values[0] == 2 && remaining.values[1] == amount
    };
    transition preserved && remaining.canary == 641 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine invoke(counter: &mut u64, received: &mut Remaining, slot: u64) crashes Trap
requires slot < 2 && received.values[slot] >= -1 && received.values[slot] <= 2
{ count(counter, received, slot); }
machine check_rank(value: i64, expected: i64) crashes Trap
requires value >= -1 && value <= 2
{
    let observed: i64 = rank(value) as i64;
    transition observed == expected { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    check_rank(-1i64, 1i64);
    check_rank(0i64, 0i64);
    check_rank(1i64, -1i64);
    check_rank(2i64, -2i64);
    let mut first_count: u64 = 3;
    perform(&mut first_count, true, false);
    let first: bool = first_count == 6;
    perform(&mut first_count, false, false);
    let mut second_count: u64 = 3;
    perform(&mut second_count, true, true);
    let second: bool = second_count == 6;
    perform(&mut second_count, false, true);
    transition first && second && first_count == 6 && second_count == 6 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
