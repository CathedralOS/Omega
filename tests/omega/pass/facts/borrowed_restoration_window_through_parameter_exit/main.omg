// Fact: retiring a borrow restoration window restores full owner access and post-borrow invariant value >= 100u64 && value <= 100u64 for exact subtraction value - 100u64.
// Place: parameter. The restored cell is passed as an immutable borrow to an observer machine.
// Expected exit: 0

data Cell {
    value: u64;
}

machine write_cell(cell: &mut Cell) {
    cell.value = 100u64;
}

machine observe(c: &Cell) -> u64 {
    c.value
}

machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 0u64 };
    write_cell(&mut cell);
    let val: u64 = observe(&cell);
    transition val >= 100u64 && val <= 100u64 {
        true -> done(val)
        _ -> bad()
    }
    machine done(v: u64) {
        let diff: u64 = v - 100u64;
    }
    machine bad() {
        crash Trap;
    }
}
