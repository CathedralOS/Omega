// Fact: 64-bit signed bitwise AND mask raw & 63i64 with bounded interval 40i64 <= masked <= 63i64 establishes 40i64 <= masked <= 63i64 across all nine places so exact subtractions 63i64 - masked and masked - 40i64 are safe.
// Place: parameter. Explicit machine parameters receive bounded 64-bit operands before bitwise AND and interval discharge.
// Expected exit: 0

machine verify_masked(masked: i64) -> i64
requires masked >= 40 && masked <= 63
{
    let headroom: i64 = 63i64 - masked;
    let margin: i64 = masked - 40i64;
    headroom + margin
}

machine bitwise_and_param(raw: i64, mask: i64) -> i64
requires raw >= 112 && raw <= 127 && mask == 63
{
    let masked: i64 = raw & mask;
    verify_masked(masked)
}

machine probe() -> i64 {
    bitwise_and_param(116i64, 63i64)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
