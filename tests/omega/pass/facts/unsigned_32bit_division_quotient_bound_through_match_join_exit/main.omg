// Fact: A 32-bit unsigned u32 division of bounded inputs (dividend >= 200u32 && dividend <= 200u32, divisor >= 4u32 && divisor <= 4u32) establishes quotient >= 50u32 && quotient <= 50u32 so exact 32-bit subtraction quotient - 50u32 is proved underflow-free across all nine places.
// Place: match join. The quotient is synthesized across conditional match branches.
// Expected exit: 0

machine divide_match_join(dividend: u32, divisor: u32, choose: bool) -> i32
    requires dividend >= 200u32 && dividend <= 200u32;
    requires divisor >= 4u32 && divisor <= 4u32;
{
    let quotient: u32 = match choose {
        true -> dividend / divisor,
        false -> dividend / divisor
    };
    let check: u32 = quotient - 50u32;
    transition quotient == 50u32 && check == 0u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = divide_match_join(200u32, 4u32, true);
    let res2: i32 = divide_match_join(200u32, 4u32, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
