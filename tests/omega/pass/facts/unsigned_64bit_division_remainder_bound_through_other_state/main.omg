// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: another state. A successor state receives the remainder and verifies the arithmetic interval.
// Expected exit: 0

machine remainder_other_state(dividend: u64, divisor: u64) -> i32
    requires divisor >= 64u64 && divisor <= 64u64;
{
    let rem: u64 = dividend % divisor;
    transition {
        _ -> check_state(rem)
    }
    machine check_state(r: u64) -> i32
        requires r <= 63u64;
    {
        let headroom: u64 = 63u64 - r;
        transition r == 13u64 && headroom == 50u64 {
            true -> pass()
            _ -> fail()
        }
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_other_state(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
