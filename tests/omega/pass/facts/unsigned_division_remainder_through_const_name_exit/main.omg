// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Place: const_name. A named constant carries the remainder into the subtraction check.
// Expected exit: 0

const REMAINDER: u64 = 500u64 % 200u64;

machine probe() -> i32 {
    let remainder: u64 = REMAINDER;
    let diff: u64 = remainder - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
