// The remainder `value % width` is below `width`, so when `width` is proved
// equal to a view's length it indexes that view.
// Place: parameter. The width arrives as an explicit parameter.
// Expected exit: 0
machine pick(value: u64, buckets: &[u8], width: u64) -> u8
requires buckets.len > 0 && width == buckets.len as u64
{
    buckets[value % width]
}

machine main() crashes Trap {
    let buckets: [u8; 4] = [7, 8, 9, 6];
    transition pick(10, &buckets[..], 4) == 9 && pick(15, &buckets[..], 4) == 6 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
