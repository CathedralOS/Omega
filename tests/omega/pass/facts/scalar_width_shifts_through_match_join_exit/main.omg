// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: match join. Both arms keep the operands inside Wrapping and bounds, so the joined operands shift safely.
// Expected exit: 0
machine shift_round_trip(val: u32 in Wrapping, alt_val: u32 in Wrapping, shift: u32, flag: bool) -> u32 in Wrapping
    requires shift < 4
{
    let v: u32 in Wrapping = match flag { true -> val, false -> alt_val };
    let s: u32 = match flag { true -> shift, false -> shift };
    let shifted: u32 in Wrapping = v << s;
    shifted >> s
}

machine probe(val: u32 in Wrapping, shift: u32) -> u32 in Wrapping
    requires shift < 4
{
    shift_round_trip(val, val, shift, true)
}

machine main() crashes Trap {
    let val: u32 in Wrapping = 21 as u32 in Wrapping;
    let shift: u32 = 1;
    let recovered: u32 in Wrapping = probe(val, shift);
    let shifted: u32 in Wrapping = val << shift;
    transition (shifted as u32) == 42 && (recovered as u32) == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
