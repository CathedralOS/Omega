// A returned write-only loan permits replacing caller storage 7 with 42 while preserving neighboring 19.
// Expected exit: 0.
const INDEX: u64 = 0;
machine lend_write(destination: &write i32) -> &write i32 { &write destination }
machine main() crashes Trap {
 let mut values: [i32; 2] = [7, 19];
 let destination: &write i32 = lend_write(&write values[INDEX]);
 destination = 42;
 transition values[INDEX] == 42 && values[1] == 19 { true -> done() false -> wrong() }
 state done() {} state wrong() { crash Trap; }
}
