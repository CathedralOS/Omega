// Fact: 16-bit signed exact subtraction lhs - rhs with 300i16 <= lhs <= 500i16 and 50i16 <= rhs <= 100i16 establishes 200i16 <= diff <= 450i16 so 450i16 - diff and diff - 200i16 are safe.
// Place: another target body. Target-scoped implementations across all four platforms verify the bounds.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSubtractTarget {
    machine subtract_target(lhs: i16, rhs: i16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 300i16 && lhs <= 500i16 requires rhs >= 50i16 && rhs <= 100i16;
}

X86SubtractTarget satisfies SelectedSubtractTarget {
    machine subtract_target(lhs: i16, rhs: i16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 300i16 && lhs <= 500i16 requires rhs >= 50i16 && rhs <= 100i16
    {
        SelectedBodyCheck::require_tag(17u64);
        let diff: i16 = lhs - rhs;
        let headroom: i16 = 450i16 - diff;
        let margin: i16 = diff - 200i16;
        let check_h: u16 = headroom as u16;
        let check_m: u16 = margin as u16;
        transition diff == 320i16 && headroom + margin == 250i16 && check_h + check_m == 250u16 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

ArmSubtractTarget satisfies SelectedSubtractTarget {
    machine subtract_target(lhs: i16, rhs: i16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 300i16 && lhs <= 500i16 requires rhs >= 50i16 && rhs <= 100i16
    {
        SelectedBodyCheck::require_tag(29u64);
        let diff: i16 = lhs - rhs;
        let headroom: i16 = 450i16 - diff;
        let margin: i16 = diff - 200i16;
        let check_h: u16 = headroom as u16;
        let check_m: u16 = margin as u16;
        transition diff == 320i16 && headroom + margin == 250i16 && check_h + check_m == 250u16 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

machine main() crashes Trap {
    let res: i32 = SelectedSubtractTarget::subtract_target(400i16, 80i16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
