// A match join of two closed call results still discharges a callee
// `requires`. Both arms return `opaque()`'s 4, so the joined `scale`
// proves `scale <= 5` at `echo`.
//
// Compile-checked only: no standard-library dependency and no
// ProcessExit provider. The check is the oracle.

machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine opaque() -> u64 { 4u64 }

machine choose(flag: bool) -> u64 {
    let scale: u64 = match flag { true -> opaque(), false -> opaque() };
    echo(scale)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;

    let r: u64 = choose(true);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
