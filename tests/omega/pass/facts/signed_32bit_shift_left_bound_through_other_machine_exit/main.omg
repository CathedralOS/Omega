// Fact: a 32-bit signed i32 left shift of a bounded input (val >= 15i32 && val <= 15i32) by 2u32 bits establishes shifted >= 60i32 && shifted <= 60i32 so exact 32-bit signed subtraction shifted - 60i32 is proved overflow-free across all nine places.
// Place: other_machine. A forwarding machine transports the left-shifted result through an intermediate machine call.
// Expected exit: 0
machine verify_shifted(shifted: i32) -> i32
    requires shifted >= 60 && shifted <= 60
{
    shifted - 60
}

machine target_machine(val: i32) -> i32
    ensures result == val
{
    val
}

machine forwarder(val: i32) -> i32
    ensures result == val
{
    target_machine(val)
}

machine compute_other_machine(val: i32) -> i32
    requires val >= 15 && val <= 15
{
    let shifted: i32 = forwarder(val << 2u32);
    verify_shifted(shifted)
}

machine evaluate() -> i32 {
    compute_other_machine(15)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
