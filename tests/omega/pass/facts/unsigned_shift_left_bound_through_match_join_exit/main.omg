// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Place: match join. Both arms yield the bounded operand before left shift and subtraction.
// Expected exit: 0

machine choose_val(flag: bool) -> u64
ensures result >= 25 && result <= 25
{
    match flag {
        true -> 25u64,
        false -> 25u64,
    }
}

machine shift_match_join(shift: u32) -> u64
requires shift == 2
{
    let val: u64 = choose_val(true);
    let shifted: u64 = val << shift;
    shifted - 100u64
}

machine probe() -> u64 {
    shift_match_join(2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
