// Exhaustively matching a three-variant case value where every arm establishes joined >= 20u64 && joined <= 60u64 preserves the joined interval bound across all nine places, discharging exact subtraction 60u64 - joined and joined - 20u64.
// Expected exit: 0

data Mode [copy] {
    case Low(val: u64) where val >= 20 && val <= 60;
    case Mid(val: u64) where val >= 20 && val <= 60;
    case High(val: u64) where val >= 20 && val <= 60;
}

const UPPER: u64 = 60u64;
const LOWER: u64 = 20u64;
const MODE: Mode = Mode::Mid { val: 40 };

machine evaluate(mode: Mode) -> u64 {
    transition mode {
        Mode::Low { val } -> val
        Mode::Mid { val } -> val
        Mode::High { val } -> val
    }
}

machine main() crashes Trap {
    let joined: u64 = evaluate(MODE);
    let diff1: u64 = UPPER - joined;
    let diff2: u64 = joined - LOWER;
    transition diff1 == 20 && diff2 == 20 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
