// Fact: 16-bit signed exact subtraction lhs - rhs with 300i16 <= lhs <= 500i16 and 50i16 <= rhs <= 100i16 establishes 200i16 <= diff <= 450i16 so 450i16 - diff and diff - 200i16 are safe.
// Place: const name. The bounds and difference limits reference declared symbolic constants.
// Expected exit: 0

const LHS_MIN: i16 = 300i16;
const LHS_MAX: i16 = 500i16;
const RHS_MIN: i16 = 50i16;
const RHS_MAX: i16 = 100i16;
const DIFF_MIN: i16 = 200i16;
const DIFF_MAX: i16 = 450i16;

machine subtract_const(lhs: i16, rhs: i16) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let diff: i16 = lhs - rhs;
    let headroom: i16 = DIFF_MAX - diff;
    let margin: i16 = diff - DIFF_MIN;
    let check_h: u16 = headroom as u16;
    let check_m: u16 = margin as u16;
    transition diff == 320i16 && headroom + margin == 250i16 && check_h + check_m == 250u16 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = subtract_const(400i16, 80i16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
