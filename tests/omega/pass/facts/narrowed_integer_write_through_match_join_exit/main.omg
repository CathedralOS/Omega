// A completed write of 70 through a signed eight-bit field retains its i64 meaning and leaves the adjacent byte unchanged.
// Place: match_join.
// Expected exit: 0
use omega::language::core::layout;

data SignedByte {}
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0, stored_width: 8, interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan { entries: entries, entry_count: 1, size_fixed: 1, size_is_dynamic: false, align: 1 }
}
data PortableByte [copy] { value: i64; }
data Memory { bytes: [u8; 2]; }
machine store(destination: &mut i64, value: i64) { destination = value; }
machine choose(value: i64, flag: bool) -> i64 ensures result == value {
    transition flag { true -> first(value) false -> second(value) }
    machine first(value: i64) -> i64 { value }
    machine second(value: i64) -> i64 { value }
}
machine main(memory: &mut Memory) crashes Trap {
    memory.bytes[1] = 85;
    let packed: &mut SignedByte<PortableByte> = &mut memory.bytes[0] as &mut SignedByte<PortableByte>;
    let value: i64 = choose(70, true);
    store(&mut packed.value, value);
    store(&mut packed.value, choose(70, false));
    transition memory.bytes[0] == 70 && memory.bytes[1] == 85 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Memory;
    main(&mut entry_storage);
}
