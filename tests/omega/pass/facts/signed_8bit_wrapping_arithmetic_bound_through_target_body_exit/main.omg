windows_x86_64 machine verify_target() -> i32 {
    let lhs: i8 = 60i8;
    let rhs: i8 = 15i8;
    let w_lhs: i8 in Wrapping = lhs as i8 in Wrapping;
    let w_rhs: i8 in Wrapping = rhs as i8 in Wrapping;
    let sum_wrap: i8 in Wrapping = w_lhs + w_rhs;
    let sum: i8 = sum_wrap as i8;
    verify_sum(sum)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
