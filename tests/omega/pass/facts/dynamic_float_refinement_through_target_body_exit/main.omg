// Inline exact IEEE value 0.25 guarantee refines public inclusive f64 interval [0, 0.5]; the dyn call observes 0.25.
// Place: target_body.
// Expected exit: 0.
trait Fraction {
    machine get() -> f64 ensures result >= 0.0 && result <= 0.5;
}
Quarter satisfies Fraction {
    machine get() -> f64 ensures result >= 0.25 && result <= 0.25 { 0.25 }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedInvoke {
    machine invoke(selected: dyn Fraction) -> f64 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86Invoke satisfies SelectedInvoke {
    machine invoke(selected: dyn Fraction) -> f64 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap {
        SelectedBodyCheck::require_tag(17u64);
        Fraction::get(selected)
    }
}
ArmInvoke satisfies SelectedInvoke {
    machine invoke(selected: dyn Fraction) -> f64 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap {
        SelectedBodyCheck::require_tag(29u64);
        Fraction::get(selected)
    }
}
machine main() crashes Trap {
    let selected: dyn Fraction = Quarter as dyn Fraction;
    let observed: f64 = SelectedInvoke::invoke(selected);
    transition observed == 0.25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
