// A completed query guarantees a nonnegative result; routed domain introduction preserves that fact.
// Expected exit: 0.
const FLOOR: i64 = 0;
domain i64::Nonnegative(value) requires value >= 0 established by issue;
boundary trait Query { machine read(input: i64) -> i64 reaches ensures result >= FLOOR; }
Actual satisfies Query {
    machine read(input: i64) -> i64 ensures result >= FLOOR {
        transition input >= FLOOR { true -> (input) _ -> (FLOOR) }
    }
}

machine issue(value: i64) -> i64 in Nonnegative requires value >= 0 { value }
machine transport(input: i64) -> i64 in Nonnegative {
    let value: i64 = Query::read(input);
    let issued: i64 in Nonnegative = issue(value);
    issued
}

machine main() crashes Trap {
    let value: i64 in Nonnegative = transport(17);
    transition value == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
