machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine extract(choice: ThirtyThreeChoice) -> u64 {
    transition choice {
        ThirtyThreeChoice::V1 { v } -> v
        ThirtyThreeChoice::V2 { v } -> v
        ThirtyThreeChoice::V3 { v } -> v
        ThirtyThreeChoice::V4 { v } -> v
