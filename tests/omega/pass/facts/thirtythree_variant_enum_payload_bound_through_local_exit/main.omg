machine probe(choice: ThirtyThreeChoice) -> u64 {
    let res: u64 = extract(choice);
    let local_res: u64 = res;
    verify_payload(local_res)
}

machine main() crashes Trap {
    let p: ThirtyThreeChoice = ThirtyThreeChoice::V33 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
