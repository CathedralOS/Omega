// Fact: a 16-bit unsigned u16 exact multiplication of bounded inputs (lhs >= 20u16 && lhs <= 30u16, rhs >= 15u16 && rhs <= 25u16) establishes prod >= 300u16 && prod <= 750u16 so exact 16-bit subtractions 750u16 - prod and prod - 300u16 are proved overflow-free across all nine places.
// Place: another state. A successor state receives bounded 16-bit operands before multiplication and subtractions.
// Expected exit: 0

machine mul_state(lhs: u16, rhs: u16) -> u16
requires lhs >= 20 && lhs <= 30 && rhs >= 15 && rhs <= 25
{
    transition {
        _ -> step(lhs, rhs)
    }
    machine step(l: u16, r: u16) -> u16
    requires l >= 20 && l <= 30 && r >= 15 && r <= 25
    {
        let prod: u16 = l * r;
        let headroom: u16 = 750u16 - prod;
        let margin: u16 = prod - 300u16;
        headroom + margin
    }
}

machine probe() -> u16 {
    mul_state(25u16, 20u16)
}

machine main() crashes Trap {
    transition probe() == 450 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
