// Fact: a checked subslice of an immutable byte-view literal preserves its exact window length of 10u64 when multiplied by 10u64 and subtracting 100u64.
// Place: match join. Both branches of a pattern match evaluate the literal subslice and join before multiplying.
// Expected exit: 0

machine measure_subslice() -> u64
ensures result == 10u64
{
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..12u64];
    window.len
}

machine probe(flag: bool) -> u64
ensures result == 0u64
{
    let window_len: u64 = match flag {
        true -> measure_subslice(),
        false -> measure_subslice(),
    };
    let total: u64 = window_len * 10u64;
    total - 100u64
}

machine main() crashes Trap {
    transition probe(true) == 0 && probe(false) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
