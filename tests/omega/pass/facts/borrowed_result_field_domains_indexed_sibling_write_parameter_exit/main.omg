// Borrowed results retain their checked field domains and selected element, so inspection reads that element.
// Expected exit: 0
public domain [u8; 4]::Ascii requires ascii_only(self);
public data Cell [copy] { storage: [u8; 4] in Ascii; stamps: [u64; 2]; }
public data Table [copy] { cells: [Cell; 2]; }
public machine choose(table: &mut Table, index: u64) -> &mut Cell
requires index < 2 {
    let cells: &mut [Cell] = &mut table.cells[..];
    &mut cells[index]
}
public machine relay(table: &mut Table, index: u64) -> &mut Cell
requires index < 2 { choose(table, index) }
machine inspect(cell: &Cell) -> u8 { cell.storage[0] }
machine consume(selected: &mut Cell, stamp_index: u64) -> u8
requires stamp_index < 2 {
    selected.stamps[stamp_index] = 0xF1;
    inspect(selected)
}
machine observe(table: &mut Table, index: u64, stamp_index: u64) -> u8
requires index < 2, stamp_index < 2 {
    consume(relay(table, index), stamp_index)
}
machine main() crashes Trap {
    let mut table: Table = Table { cells: [Cell { storage: [65u8, 0u8, 0u8, 0u8], stamps: [11, 17] }, Cell { storage: [66u8, 0u8, 0u8, 0u8], stamps: [13, 19] }] };
    let first: u8 = observe(&mut table, 0, 1);
    let first_written: u64 = table.cells[0].stamps[0];
    let first_neighbor: u64 = table.cells[0].stamps[1];
    let first_other_start: u64 = table.cells[1].stamps[0];
    let first_other_end: u64 = table.cells[1].stamps[1];
    let second: u8 = observe(&mut table, 1, 0);
    transition first == 65 && second == 66
        && first_written == 11 && first_neighbor == 0xF1
        && first_other_start == 13 && first_other_end == 19
        && table.cells[0].stamps[0] == 11 && table.cells[0].stamps[1] == 0xF1
        && table.cells[1].stamps[0] == 0xF1 && table.cells[1].stamps[1] == 19
        && table.cells[0].storage[0] == 65 && table.cells[1].storage[0] == 66
        && table.cells[0].storage[1] == 0 && table.cells[0].storage[2] == 0 && table.cells[0].storage[3] == 0
        && table.cells[1].storage[1] == 0 && table.cells[1].storage[2] == 0 && table.cells[1].storage[3] == 0 {
        true -> {} false -> bad()
    }
    machine bad() crashes Trap { crash Trap; }
}
