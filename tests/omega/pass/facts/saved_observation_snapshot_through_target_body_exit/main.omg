// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine capture<'source, View>(source: View, marker: &mut u64, event: u64) -> View where View == &'source u64 { marker = event; source }

machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe(items: &mut [u64; 2], marker: &mut u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires items[0] == 7;
}

X86Observe satisfies SelectedObserve {
    machine observe(items: &mut [u64; 2], marker: &mut u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires items[0] == 7
    {
        SelectedBodyCheck::require_tag(17u64);
        let saved: u64 = capture<&u64>(&items[0], marker, 11);
        items[1] = 4;
        agree(saved, items[0])
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe(items: &mut [u64; 2], marker: &mut u64) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires items[0] == 7
    {
        SelectedBodyCheck::require_tag(29u64);
        let saved: u64 = capture<&u64>(&items[0], marker, 11);
        items[1] = 4;
        agree(saved, items[0])
    }
}

machine main() crashes Trap {
    let mut marker: u64 = 0;
    let mut items: [u64; 2] = [7, 1];
    transition SelectedObserve::observe(&mut items, &mut marker) == 7 && items[1] == 4 && marker == 11 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
