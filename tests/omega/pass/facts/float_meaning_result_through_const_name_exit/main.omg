// The minimum call's checked IEEE meaning survives transport and discharges require_min for its exact captured result.
// Expected exit: 0
// Place: const_name.

use omega::language::core::float_operations;

machine forward(left: f32, right: f32) -> f32
ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(left), F32::meaning(right))
{
    F32::minimum(left, right)
}

machine require_min(value: f32) -> f32
requires F32::meaning(value) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0))
ensures F32::meaning(result) == FloatSemantics::minimum(F32::meaning(1.0), F32::meaning(2.0))
{ value }

const LEFT: f32 = 1.0;
const RIGHT: f32 = 2.0;

machine main() crashes Trap {
    let result: f32 = require_min(forward(LEFT, RIGHT));
    transition result == 1.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
