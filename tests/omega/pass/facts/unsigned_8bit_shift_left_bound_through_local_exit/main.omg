// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Place: local. The 8-bit operand and shift count are copied into locals before left shift and subtraction.
// Expected exit: 0

machine shift_local(val: u8, shift: u32) -> u8
requires val >= 25 && val <= 25 && shift == 2
{
    let local_val: u8 = val;
    let local_shift: u32 = shift;
    let shifted: u8 = local_val << local_shift;
    shifted - 100u8
}

machine probe() -> u8 {
    shift_local(25u8, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
