// Expected exit: 0
// Preserve scalar parent membership while adding structural inherited-domain metadata.
domain u64::Tag;
domain u64::Tag::Child;
machine consume(value: u64 in Tag::Child) -> u64 { value as u64 }
machine main() crashes Trap {
 let value: u64 in Tag::Child = 3u64;
 transition consume(value) == 3u64 { true -> done() _ -> wrong() }
 state done() {}
 state wrong() { crash Trap; }
}
