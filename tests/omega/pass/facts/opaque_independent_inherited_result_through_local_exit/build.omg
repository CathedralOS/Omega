use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::application(builder, "independent_opaque_local");
 Build::depend_as(builder, "renamed", Source::Path { location: "producer" });
 Build::select_representation<renamed::InternetAddress, renamed::AddressRepresentation>(builder);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, linux_arm64, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, linux_x86_64, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, macos_arm64, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, macos_x86_64, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, windows_x86_64, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, uefi_x86_64, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, cross_platform_cli, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, local_unchecked, CompositionMode::Independent);
 Build::select_provider<renamed::AddressBridge, renamed::AddressBridgeProvider>(builder, alpha_bootstrap, CompositionMode::Independent);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::bind(builder, windows_x86_64::ProgramEntry, main);

 Build::bind<producer::AddressParts::make>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_makeaddr",
        },
    });
 Build::bind<producer::AddressParts::make>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_makeaddr", version: "GLIBC_2.2.5",
        },
    });
 Build::bind<producer::AddressParts::host>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_inet_lnaof",
        },
    });
 Build::bind<producer::AddressParts::host>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "inet_lnaof", version: "GLIBC_2.2.5",
        },
    });
 Build::bind<producer::AddressParts::make>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_makeaddr", version: "GLIBC_2.17" } });
 Build::bind<producer::AddressParts::host>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "inet_lnaof", version: "GLIBC_2.17" } });
 Build::bind<producer::AddressParts::make>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_host.dll", export: "inet_makeaddr" } });
 Build::bind<producer::AddressParts::host>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "omega_host.dll", export: "inet_lnaof" } });
}
