// Fact: Authorized sum visitation reports one exact active case, then common fields and only that case payload in declaration order using ordinary field loans.
// Expected exit: 0
use omega::language::core::reflect;
data Subject [copy] { #0 common: u64; #7 case Idle; #8 case Ready; #9 case Item(#0 payload: u64); }
data Holder { value: Subject; }
data Seen [copy] { cases: u64; tag: u64; fields: u64; sum: u64; }
machine selected(seen: &mut Seen, info: &reflect::CaseInfo) {
    seen.cases = ((seen.cases as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
    seen.tag = info.stable_number;
    seen.sum = ((info.stable_number as u64 in Wrapping) * (1000u64 as u64 in Wrapping)) as u64;
}
machine field<Kind>(seen: &mut Seen, info: &reflect::FieldInfo, value: &Kind)
requires Kind == u64
{ collect(seen, value); }
machine collect(seen: &mut Seen, value: &u64) {
    seen.fields = ((seen.fields as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
    seen.sum = (((seen.sum as u64 in Wrapping) * (101u64 as u64 in Wrapping)) + (value as u64 in Wrapping)) as u64;
}
machine visit(value: &Subject, seen: &mut Seen) {
    reflect::visit_active_fields<Subject, selected, field>(value, seen);
}
machine main() crashes Trap {
    let subject: Subject = Subject::Item { common: 11u64, payload: 22u64 };
    let mut seen: Seen;
    visit(&subject, &mut seen);
    transition seen.cases == 1u64 && seen.tag == 9u64 && seen.fields == 2u64 && seen.sum == 91810133u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
