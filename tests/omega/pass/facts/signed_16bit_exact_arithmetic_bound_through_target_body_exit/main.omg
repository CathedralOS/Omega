// Fact: adding two bounded 16-bit signed i16 values (lhs >= 100i16 && lhs <= 200i16 and rhs >= 150i16 && rhs <= 250i16) establishes the exact post-addition interval (sum >= 250i16 && sum <= 450i16), discharging a downstream contract requiring sum >= 250i16 && sum <= 450i16 (and exact subtraction 450i16 - sum) across all nine places.
// Expected exit: 0

machine verify_i16_margin(v: i16) -> i32
requires v >= 0i16 && v <= 200i16
{
    transition v == 100i16 {
        true -> 0i32
        _ -> 1i32
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(lhs: i16, rhs: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 100i16 && lhs <= 200i16
    requires rhs >= 150i16 && rhs <= 250i16;
}

X86Probe satisfies SelectedProbe {
    machine exercise(lhs: i16, rhs: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 100i16 && lhs <= 200i16
    requires rhs >= 150i16 && rhs <= 250i16
    {
        SelectedBodyCheck::require_tag(17u64);
        let sum: i16 = lhs + rhs;
        let margin: i16 = 450i16 - sum;
        verify_i16_margin(margin)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(lhs: i16, rhs: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 100i16 && lhs <= 200i16
    requires rhs >= 150i16 && rhs <= 250i16
    {
        SelectedBodyCheck::require_tag(29u64);
        let sum: i16 = lhs + rhs;
        let margin: i16 = 450i16 - sum;
        verify_i16_margin(margin)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let exit_code: i32 = SelectedProbe::exercise(150i16, 200i16);
    transition exit_code == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
