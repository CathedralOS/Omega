// Expected exit: 0
machine maybe_zero(value: u32) -> u32
crashes Trap value == 0
{
    transition value == 0 { true -> bad() false -> (value) }
    state bad() { crash Trap; }
}
public machine read_bits(value: i32) -> u32
requires value == -1
{
    let view: &u32 = &value as &u32;
    let observed: u32 = view;
    maybe_zero(observed)
}
machine main() crashes Trap {
    let observed: u32 = read_bits(-1);
    transition observed == 4294967295 { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
