// A fixed-extent array [u64; 2] preserves its in-bounds index contract index < 2 and independent element values across all nine places.
// Place: const name. A named constant bounds the index contract for the fixed-extent array.
// Expected exit: 0
const LIMIT: u64 = 2;

machine read_element(values: [u64; 2], index: u64) -> u64
requires index < LIMIT
{
    values[index]
}

machine main() crashes Trap {
    let values: [u64; 2] = [19, 42];
    transition values[0] == 19 && values[1] == 42 && read_element(values, 1) == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
