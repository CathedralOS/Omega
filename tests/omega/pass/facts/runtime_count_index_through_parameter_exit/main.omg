// A runtime count passed as a parameter still indexes a byte view.
// Expected exit: 0
machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

machine indexed(index: u32, items: &[u8]) -> u8
requires index < items.len;
{
    read_at<index>(items)
}

machine main() crashes Trap {
    let bytes: [u8; 4] = [9, 8, 7, 6];
    transition indexed(1, &bytes[..]) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
