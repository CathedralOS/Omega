machine build(builder: &mut Build) {
    Build::application(builder, "write_only_recast");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::accept_boundary<SelectedOverwrite>(builder);
    Build::select_provider<SelectedOverwrite, WindowsOverwrite>(builder, windows_x86_64);
    Build::select_provider<SelectedOverwrite, LinuxX86Overwrite>(builder, linux_x86_64);
    Build::select_provider<SelectedOverwrite, MacosOverwrite>(builder, macos_arm64);
    Build::select_provider<SelectedOverwrite, LinuxArmOverwrite>(builder, linux_arm64);
}
