// Fact: an unsigned u64 remainder from 500u64 % 200u64 equals 100u64 when subtracting 100u64.
// Place: match_join. Both match arms produce the remainder and join into the subtraction check.
// Expected exit: 0

machine remainder(dividend: u64, divisor: u64) -> u64
requires dividend >= 500 && dividend <= 500 && divisor >= 200 && divisor <= 200
ensures result >= 100 && result <= 100
{
    dividend % divisor
}

machine choose_remainder(flag: bool) -> u64
ensures result >= 100 && result <= 100
{
    match flag {
        true -> remainder(500u64, 200u64),
        false -> remainder(500u64, 200u64),
    }
}

machine probe() -> i32 {
    let rem: u64 = choose_remainder(true);
    let diff: u64 = rem - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
