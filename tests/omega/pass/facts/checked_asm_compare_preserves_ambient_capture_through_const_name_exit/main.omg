data AsmSavedOutput { value: u32; }
// Expected exit: 0.
// Comparing a register with itself establishes the zero flag without changing its value; both label edges preserve the original register.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedCompare {
    machine compare(seed: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed == 37 ensures result == 37;
}

X86Compare satisfies SelectedCompare {
    machine compare(seed: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed == 37 ensures result == 37
    {
        SelectedBodyCheck::require_tag(17u64);
        let mut output: AsmSavedOutput = AsmSavedOutput { value: 0 };
        asm where clobbers rax, rflags {
        entry:
            mov eax, seed;
            cmp eax, eax;
            jz equal;
        different requires false:
            mov output.value, 1;
            jmp done;
        equal requires eax == 37:
            mov output.value, eax;
        done requires output.value == seed ensures (match output { AsmSavedOutput { value } -> value == seed }):
            nop
        }
        output.value
    }
}

ArmCompare satisfies SelectedCompare {
    machine compare(seed: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires seed == 37 ensures result == 37
    {
        SelectedBodyCheck::require_tag(29u64);
        let mut output: AsmSavedOutput = AsmSavedOutput { value: 0 };
        asm where clobbers x0, nzcv {
        entry:
            mov w0, seed;
            cmp w0, w0;
            b.eq equal;
        different requires false:
            mov output.value, 1;
            b done;
        equal requires w0 == 37:
            mov output.value, w0;
        done requires output.value == seed ensures (match output { AsmSavedOutput { value } -> value == seed }):
            nop
        }
        output.value
    }
}


const SEED: u32 = 37;
machine finished() {}
machine failed() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let value: u32 = SelectedCompare::compare(SEED);
    transition value == 37 { true -> finished() false -> failed() }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
