// Fact: a provider-settled boundary call whose contract establishes result >= 100u64 && result <= 100u64 discharges exact subtraction result - 100u64.
// Place: other_state. The boundary call result passed as an argument across a state machine transition.
// Expected exit: 0
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 100u64 && result <= 100u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 100u64 && result <= 100u64 {
        100
    }
}

machine run() -> u64 reaches Provider {
    transition { _ -> evaluate(Provider::get()) }
    machine evaluate(val: u64) -> u64 requires val >= 100u64 && val <= 100u64 {
        transition { _ -> finish(val - 100u64) }
    }
    machine finish(outcome: u64) -> u64 { outcome }
}

machine main() crashes Trap {
    transition run() == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
