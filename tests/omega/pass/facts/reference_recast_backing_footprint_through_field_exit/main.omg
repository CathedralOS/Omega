// A shared two-byte Pair view starting at byte 1 of live [u8; 4] preserves the original first-byte address and full two-byte loan while its second field reads 37.
// Expected exit: 0
// Place: field.
use omega::language::core::layout;
data Pair { first: u8; second: u8; }

PairLayout satisfies FixedLayout<Pair> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 1 } };
        Plan { entries: entries, entry_count: 2, size_fixed: 2, size_is_dynamic: false, align: 1 }
    }
}

data Holder<'storage> { view: &'storage LayoutStorage<Pair, PairLayout>; }
machine probe() -> bool {
    let mut bytes: [u8; 4] = [11, 23, 37, 41];
    let original: addr = address_of(&bytes[1]);
    let formed: &LayoutStorage<Pair, PairLayout> = &bytes[1] as &LayoutStorage<Pair, PairLayout>;
    let holder: Holder = Holder { view: formed };
    address_of(&holder.view.first) == original && holder.view.second == 37
}
machine main() crashes Trap {
    let accepted: bool = probe();
    transition accepted { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
