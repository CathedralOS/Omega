// Fact: multiplying two bounded signed i64 values (factor >= 10i64 && factor <= 15i64 and scale >= 4i64 && scale <= 6i64) establishes product >= 40i64 && product <= 90i64, discharging a downstream contract requiring product >= 40i64 && product <= 90i64 across all nine places.
// Place: match_join. Both branches of a match compute the product and join into the downstream verifier.
// Expected exit: 0

machine verify_product(product: i64) -> i32
requires product >= 40 && product <= 90
{
    0i32
}

machine choose_product(flag: bool, factor: i64, scale: i64) -> i64
requires factor >= 10 && factor <= 15 && scale >= 4 && scale <= 6
ensures result >= 40 && result <= 90
{
    match flag {
        true -> factor * scale,
        false -> scale * factor,
    }
}

machine probe() -> i32 {
    let product: i64 = choose_product(true, 12i64, 5i64);
    verify_product(product)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
