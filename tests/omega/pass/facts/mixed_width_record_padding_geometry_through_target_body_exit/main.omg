// Fact: querying size_of and align_of on a mixed-width structural record (Padded { tag: u8, value: u64 }) establishes its exact 16-byte alignment-padded layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Place: another target body. Each of four target bodies evaluates size_of and align_of and subtracts.
// Expected exit: 0

data Padded {
    tag: u8;
    value: u64;
}

linux_x86_64 machine compute_geometry() -> u64 {
    size_of<Padded>() - (align_of<Padded>() * 2u64)
}

linux_arm64 machine compute_geometry() -> u64 {
    size_of<Padded>() - (align_of<Padded>() * 2u64)
}

macos_arm64 machine compute_geometry() -> u64 {
    size_of<Padded>() - (align_of<Padded>() * 2u64)
}

windows_x86_64 machine compute_geometry() -> u64 {
    size_of<Padded>() - (align_of<Padded>() * 2u64)
}

machine probe() -> u64 {
    compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
