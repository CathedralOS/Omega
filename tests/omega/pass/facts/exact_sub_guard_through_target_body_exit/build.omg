machine build(builder: &mut Build) {
    Build::select_provider<SelectedDeduct, CheckedDeduct>(builder, linux_x86_64);
    Build::select_provider<SelectedDeduct, CheckedDeduct>(builder, linux_arm64);
    Build::select_provider<SelectedDeduct, CheckedDeduct>(builder, macos_arm64);
    Build::select_provider<SelectedDeduct, CheckedDeduct>(builder, windows_x86_64);

    Build::application(builder, "exact_sub_guard_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
