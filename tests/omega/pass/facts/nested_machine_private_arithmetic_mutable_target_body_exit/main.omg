// Every private arrival carries a positive value, so the helper can form value - 1.
// Expected exit: 0
data Storage { touched: u64; canary: u64; }
data Note { value: u64; tag: u64; }
windows_x86_64 machine probe(value: u64, select: bool, output: &mut Storage) -> Note {
    transition value > 0 {
        true -> apply(value, select, output)
        false -> Note { value: 0, tag: 0 }
    }
    machine apply(value: u64, select: bool, output: &mut Storage) -> Note {
        output.touched = 5;
        let result: u64 = value - 1;
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: result, tag: tag }
    }
}
linux_x86_64 machine probe(value: u64, select: bool, output: &mut Storage) -> Note {
    transition value > 0 {
        true -> apply(value, select, output)
        false -> Note { value: 0, tag: 0 }
    }
    machine apply(value: u64, select: bool, output: &mut Storage) -> Note {
        output.touched = 5;
        let result: u64 = value - 1;
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: result, tag: tag }
    }
}
linux_arm64 machine probe(value: u64, select: bool, output: &mut Storage) -> Note {
    transition value > 0 {
        true -> apply(value, select, output)
        false -> Note { value: 0, tag: 0 }
    }
    machine apply(value: u64, select: bool, output: &mut Storage) -> Note {
        output.touched = 5;
        let result: u64 = value - 1;
        let tag: u64 = match select { true -> 11, false -> 13 };
