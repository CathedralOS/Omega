// Fact: an entry f32 that is NaN makes value == value false, so maybe_ordered's Trap guard drops without a caller crash ceiling, because the guard reads recorded IEEE equality and NaN is unordered.
// Expected exit: 0
use omega::language::core::float_operations;
machine maybe_ordered(value: f32) -> f32
crashes Trap value == value
{
    transition value == value { true -> bad() false -> (value) }
    state bad() { crash Trap; }
}
machine identity(value: f32) -> f32 { value }
public machine read_nan() -> f32
{
    let nan: f32 = 0.0f32 / 0.0f32;
    let carried: f32 = identity(nan);
    maybe_ordered(carried)
}
machine main() crashes Trap {
    let observed: f32 = read_nan();
    transition observed != observed { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
