// Fact: a 17-argument calling plan across register and stack slots preserves the 17th stack argument bound 40u64 <= a17 <= 80u64 to justify 80u64 - res and res - 40u64.
// Place: const name. Named constants supply arguments to the multi-argument call.
// Expected exit: 0

const C1: u64 = 1;
const C2: u64 = 2;
const C3: u64 = 3;
const C4: u64 = 4;
const C5: u64 = 5;
const C6: u64 = 6;
const C7: u64 = 7;
const C8: u64 = 8;
const C9: u64 = 9;
const C10: u64 = 10;
const C11: u64 = 11;
const C12: u64 = 12;
const C13: u64 = 13;
const C14: u64 = 14;
const C15: u64 = 15;
const C16: u64 = 16;
const C17: u64 = 60;

machine pick17(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64,
    a11: u64,
    a12: u64,
    a13: u64,
    a14: u64,
    a15: u64,
    a16: u64,
    a17: u64
) -> u64
requires
    a1 == 1u64 && a2 == 2u64 && a3 == 3u64 && a4 == 4u64 &&
    a5 == 5u64 && a6 == 6u64 && a7 == 7u64 && a8 == 8u64 &&
    a9 == 9u64 && a10 == 10u64 && a11 == 11u64 && a12 == 12u64 &&
    a13 == 13u64 && a14 == 14u64 && a15 == 15u64 && a16 == 16u64 &&
    a17 >= 40u64 && a17 <= 80u64
ensures
    result >= 40u64 && result <= 80u64 && result == a17
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16;
    (prefix - 136u64) + a17
}

machine probe() -> i32 crashes Trap
ensures result == 0i32
{
    let res: u64 = pick17(C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16, C17);
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    let diff: u64 = (headroom + margin) - 40u64;
    transition diff == 0u64 && headroom == 20u64 && margin == 20u64 {
        true -> ok()
        _ -> bad()
    }
    machine ok() -> i32 {
        0i32
    }
    machine bad() -> i32 {
        crash Trap;
    }
}

machine main() crashes Trap {
    transition probe() == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
