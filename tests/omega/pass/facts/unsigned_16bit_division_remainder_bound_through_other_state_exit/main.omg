// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Place: another state. A successor state receives bounded 16-bit operands before remainder and subtraction.
// Expected exit: 0

machine rem_state(dividend: u16, divisor: u16) -> u16
requires dividend >= 43 && dividend <= 43 && divisor >= 16 && divisor <= 16
{
    transition {
        _ -> step(dividend, divisor)
    }
    machine step(d: u16, s: u16) -> u16
    requires d >= 43 && d <= 43 && s >= 16 && s <= 16
    {
        let rem: u16 = d % s;
        15u16 - rem
    }
}

machine probe() -> u16 {
    rem_state(43u16, 16u16)
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
