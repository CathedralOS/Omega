machine build(builder: &mut Build) {
    Build::package(builder, "same_spelling_chosen");
    let mut api_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../api" });
    dependency::with_alias(&mut api_dependency, "api");
    let api_registration: DependencyRegistration = Build::dependency(builder, api_dependency);
    let mut other_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../other" });
    dependency::with_alias(&mut other_dependency, "other");
    let other_registration: DependencyRegistration = Build::dependency(builder, other_dependency);
    Build::select_provider<api::main::Value, main::Provider>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main::component_entry);
    Build::select_provider<api::main::Value, main::Provider>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main::component_entry);
    Build::select_provider<api::main::Value, main::Provider>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main::component_entry);
    Build::select_provider<api::main::Value, main::Provider>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main::component_entry);
}
