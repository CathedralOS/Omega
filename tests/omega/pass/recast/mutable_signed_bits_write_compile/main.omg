// A mutable equal-width recast writes signed bits through an unsigned
// view's twin: `&mut main.word as &mut i32` stores -1 into the u32's four
// bytes, and reading the original field sees 4294967295.
data Main {
    word: u32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.word = 0;
    let view: &mut i32 = &mut main.word as &mut i32;
    view = 0 - 1;
    transition main.word == 4294967295 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
