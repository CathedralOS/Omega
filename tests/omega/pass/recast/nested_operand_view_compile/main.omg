// PASS CANARY (checked route): representation recasts compose as nested
// operands inside an ordinary binary expression, in both shared (`as &`)
// and mutable (`as &mut`) spellings. A mutable view read through an
// expression position re-reads the same backing place; no reference-typed
// `let` binding is required.
data Bits { x: i32; y: u32; }

machine Bits::go(bits: &mut Bits) {
    bits.y = ((bits.x & 0xffff) as u32) & (&bits.x as &u32);
    bits.y = bits.y & (&mut bits.x as &mut u32);
}
