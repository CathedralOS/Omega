// RUN CANARY (exit 70) + interpreter differential. Record recast tiling
// descends through fixed arrays and nested records. Both array indices and the
// outer byte-region offset are runtime values; writes must land in the live
// backing bytes and reads must reconstruct the same nested values.
// `i` is deliberately a four-byte slot adjacent to later frame data: native
// address lowering must read exactly its declared width rather than splicing
// neighboring bytes into the index.
use omega_language_std::console;

data Pair {
    low: u16;
    high: u16;
}

data Packet {
    tag: u16;
    entries: [Pair; 2];
}

data Main {
    console: Console;
    bytes: [u8; 14];
    k: u32 [0..=4];
    i: u32 [0..=1];
}

machine Main::main(&mut self) {
    self.k = 4;
    self.i = 1;
    let view: &mut Packet = &mut self.bytes[self.k] as &mut Packet;
    view.tag = 0x0201;
    view.entries[0].low = 0x0403;
    view.entries[self.i].high = 0x0605;
    transition self.bytes[4] == 1 && self.bytes[5] == 2
        && self.bytes[6] == 3 && self.bytes[7] == 4
        && self.bytes[12] == 5 && self.bytes[13] == 6
        && view.tag == 0x0201
        && view.entries[0].low == 0x0403
        && view.entries[self.i].high == 0x0605 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
