// RUN CANARY (exit 70) + interpreter differential. Record recast tiling
// descends through fixed arrays and nested records. Both array indices and the
// outer byte-region offset are runtime values; writes must land in the live
// backing bytes and reads must reconstruct the same nested values.
// `i` is deliberately a four-byte slot adjacent to later frame data: native
// address lowering must read exactly its declared width rather than splicing
// neighboring bytes into the index.
use omega_language_std::console;
use omega::language::core::binding;

data Pair {
    low: u16;
    high: u16;
}

data Packet {
    tag: u16;
    entries: [Pair; 2];
}

data Main
where k <= 4 && i <= 1,
{
    console: Binding<Console>;
    bytes: [u8; 14];
    k: u32;
    i: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.k = 4;
    main.i = 1;
    let view: &mut Packet = &mut main.bytes[main.k] as &mut Packet;
    view.tag = 0x0201;
    view.entries[0].low = 0x0403;
    view.entries[main.i].high = 0x0605;
    // `view` suspends the bytes its runtime offset may cover until its last
    // use, so the owner's bytes are read after it.
    transition view.tag == 0x0201
        && view.entries[0].low == 0x0403
        && view.entries[main.i].high == 0x0605
        && main.bytes[4] == 1 && main.bytes[5] == 2
        && main.bytes[6] == 3 && main.bytes[7] == 4
        && main.bytes[12] == 5 && main.bytes[13] == 6 {
        true -> good(&main.console, main)
        _ -> bad(&main.console, main)
    }
    state good(console: &Binding<Console>, main: &mut Main) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>, main: &mut Main) { Console::exit_process(console, 71); }
}
