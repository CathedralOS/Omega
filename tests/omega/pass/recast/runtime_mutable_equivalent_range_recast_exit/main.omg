// RUN CANARY (exit 70) + interpreter differential. Mutable aliases may cross
// integer carriers when their declared ranges denote exactly the same stored
// bit patterns. The second pair pins canonicalization: a signed range covering
// its complete carrier is one contiguous bit set even though crossing signed
// zero initially describes it as two adjacent intervals.
use omega_language_std::console;

data SignedBounded
where
    value >= 0 && value <= 100,
{
    value: i32;
}

data UnsignedBounded
where
    value <= 100,
{
    value: u32;
}

data SignedWhole
where
    value >= -128 && value <= 127,
{
    value: i8;
}

data UnsignedWhole {
    value: u8;
}

data Main {
    value: SignedBounded;
    whole: SignedWhole;
}

machine Main::main(main: &mut Main) reaches Console {
    let view: &mut UnsignedBounded = &mut main.value as &mut UnsignedBounded;
    let whole_bits: &mut UnsignedWhole = &mut main.whole as &mut UnsignedWhole;
    view.value = 42;
    whole_bits.value = 70;
    // Each view suspends the field it covers until its last use, so the
    // owner's fields are read after both views.
    let seen_value: u32 = view.value;
    let seen_whole: u8 = whole_bits.value;
    transition seen_value == 42
        && seen_whole == 70
        && main.value.value == 42
        && main.whole.value == 70 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
