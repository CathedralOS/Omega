// RUN CANARY (exit 70) + interpreter differential. An unsized slice recast
// derives its element count from exact byte tiling, and its descriptor keeps
// pointer identity so indexed writes reach the original byte array.
use omega_language_std::console;

data Main {
    console: Console;
    bytes: [u8; 8];
}

machine Main::main(&mut self) {
    self.bytes[0] = 1;
    self.bytes[1] = 2;
    self.bytes[6] = 7;
    self.bytes[7] = 8;

    let words: &mut [u16] = &mut self.bytes as &mut [u16];
    transition words.len > 3 {
        true -> check(words)
        false -> bad()
    }

    state check(&mut self, words: &mut [u16]) {
    words[1] = 0x0403;
    transition words.len == 4
        && words[0] == 0x0201
        && words[1] == 0x0403
        && words[3] == 0x0807
        && self.bytes[2] == 3
        && self.bytes[3] == 4 {
        true -> good()
        _ -> bad()
    }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
