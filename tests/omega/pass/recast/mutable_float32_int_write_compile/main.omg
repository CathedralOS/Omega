// A mutable recast writes integer bits through an unsigned view of a
// float field: `&mut main.rate as &mut u32` stores the raw pattern
// 0x40400000 — read back as f32 it is 3.0.
data Main {
    rate: f32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 0.0;
    let view: &mut u32 = &mut main.rate as &mut u32;
    view = 1077936128;
    transition main.rate == 3.0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
