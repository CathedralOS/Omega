use omega_language_std::console;

data Main {
    bytes: [u8; 6];
}

machine inspect(words: &[u16]) -> i32 {
    transition words.len == 2 {
        true -> read(words)
        _ -> 71
    }

    machine read(words: &[u16]) -> i32 {
        transition words[0] == 0x0201 && words[1] == 0x0403 {
            true -> 70
            _ -> 72
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[2] = 1;
    main.bytes[3] = 2;
    main.bytes[4] = 3;
    main.bytes[5] = 4;
    let words: &mut [u16] = &mut main.bytes[2] as &mut [u16];
    Console::exit_process(inspect(words));
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
