// RUN CANARY (exit 70) + interpreter differential. A typed fixed array may be
// re-viewed as an unsized slice of a differently named aggregate when every
// repeated element preserves layout geometry and leaf representation facts.
// The shared view weakens the field predicate; the mutable view uses the exact
// same bit-pattern set in both directions. The trailing bool leaves one byte
// of native padding per element, so success also proves element stride rather
// than densely repacking scalar leaves.
use omega_language_std::console;

data Narrow
where signed_value >= 0 && signed_value <= 100,
{
    signed_value: i16;
    enabled: bool;
}

data Wide
where unsigned_value <= 200,
{
    unsigned_value: u16;
    active: bool;
}

data Exact
where unsigned_value <= 100,
{
    unsigned_value: u16;
    active: bool;
}

data Main {
    source: [Narrow; 2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.source[0].signed_value = 7;
    main.source[0].enabled = false;
    main.source[1].signed_value = 11;
    main.source[1].enabled = true;

    let read: &[Wide] = &main.source as &[Wide];
    transition read.len > 1 {
        true -> inspect(main, read)
        _ -> bad(main)
    }

    state inspect(main: &mut Main, read: &[Wide]) {
    transition read[0].unsigned_value == 7
        && !read[0].active
        && read[1].unsigned_value == 11
        && read[1].active {
        true -> mutate(main)
        _ -> bad(main)
    }
    }

    state mutate(main: &mut Main) {
    let write: &mut [Exact] = &mut main.source as &mut [Exact];
    transition write.len > 1 {
        true -> write_values(main, write)
        _ -> bad(main)
    }
    }

    state write_values(main: &mut Main, write: &mut [Exact]) {
    write[1].unsigned_value = 99;
    write[0].active = true;
    transition write[0].unsigned_value == 7
        && write[0].active
        && write[1].unsigned_value == 99
        && write[1].active {
        true -> verify(main)
        _ -> bad(main)
    }
    }

    // `write` holds `main.source` exclusively until `write_values` ends, so
    // the receiver observes the stores only after that edge.
    state verify(main: &mut Main) {
    transition main.source[0].signed_value == 7
        && main.source[0].enabled
        && main.source[1].signed_value == 99
        && main.source[1].enabled {
        true -> good(main)
        _ -> bad(main)
    }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
