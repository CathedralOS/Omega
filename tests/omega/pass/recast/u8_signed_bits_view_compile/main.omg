// An unsigned byte views as its signed counterpart: `&tag as &i8` reads
// 200's bits as -56 — the top bit becoming the sign bit in the 8-bit
// pair, mirroring the writable direction.
data Main {
    tag: u8;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.tag = 200;
    transition (&main.tag as &i8) == 0 - 56 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
