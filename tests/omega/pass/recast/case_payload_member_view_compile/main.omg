// A case payload member may be viewed through an equal-width recast loan:
// `&captured as &i64` reinterprets the payload word's bits as a signed
// value while the sum lives in a record field. Reading through the view
// observes the same bytes under the signed interpretation.
data Step {
    case Count(count: u64);
}

data Main {
    step: Step;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.step = Step::Count { count: 258 };
    transition main.step {
        Step::Count { count } -> measure(main, count)
        _ -> miss(main)
    }

    machine measure(main: &mut Main, captured: u64) {
        transition (&captured as &i64) == 258 {
            true -> good(main)
            _ -> low(main)
        }
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine low(main: &mut Main) { main.verdict = 71; }
    machine miss(main: &mut Main) { main.verdict = 72; }
}
