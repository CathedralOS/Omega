// Equal-width recast works at every scalar width: `&small as &u8` views an
// i8 holding -1 as 255. The view borrows the byte — no sign extension, no
// widening, just the raw pattern under the unsigned interpretation.
data Main {
    small: i8;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.small = 0 - 1;
    transition (&main.small as &u8) == 255 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
