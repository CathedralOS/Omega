// A float views as a signed integer too: `&rate as &i64` reads the f64's
// raw pattern as a signed word — 2.0's bits are a large positive integer.
data Main {
    rate: f64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 2.0;
    transition (&main.rate as &i64) == 4611686018427387904 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
