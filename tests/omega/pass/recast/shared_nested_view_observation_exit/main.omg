// Expected exit: 0. Reading a nested shared view observes the same backing;
// it does not transfer the view's custody a second time at normal completion.
data Header { left: u64; right: u64; }
data View { value: Header; }
data Source { first: u64; second: u64; }
data Main { source: Source; observed: u64; }

machine Main::main(main: &mut Main) crashes Trap {
    main.source.first = 37u64;
    main.source.second = 9u64;
    let view: &View = &main.source as &View;
    main.observed = view.value.left;
    transition main.observed == 37u64 && view.value.right == 9u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
