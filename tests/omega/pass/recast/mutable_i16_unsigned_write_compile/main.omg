// A mutable recast writes unsigned bits through an i16 view: `&mut
// main.half as &mut u16` stores 65535 — read back as the signed member
// it is -1, the all-ones pattern in both directions.
data Main {
    half: i16;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.half = 0;
    let view: &mut u16 = &mut main.half as &mut u16;
    view = 65535;
    transition main.half == 0 - 1 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { main.verdict = 70; }
    state bad(main: &mut Main) { main.verdict = 71; }
}
