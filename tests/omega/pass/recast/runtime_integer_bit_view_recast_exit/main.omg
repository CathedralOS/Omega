// RUN CANARY (exit 70) + interpreter differential. Equal-width integer
// re-views read the viewed place's two's-complement bits on the view carrier:
// a negative i32 read through `&u32` is its modular image, an inline `&u8`
// view of an i8 guard operand likewise, and a `u8` byte region at a
// guard-bounded runtime offset re-viewed as `&i16` assembles its bytes
// little-endian before the signed image. The same region selected by a
// literal index reads identically as an inline guard operand: an element
// source is a selection whichever way its index is spelled. The viewed
// fields keep their declared carriers; each byte of the region owes its own
// index proof.
use omega_language_std::console;

data Main {
    value: i32;
    small: i8;
    bytes: [u8; 6];
    k: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.value = -2;
    main.small = -56;
    main.bytes[3] = 254;
    main.bytes[4] = 255;
    main.k = 3;
    let bits: &u32 = &main.value as &u32;
    transition bits == 4294967294 && (&main.small as &u8) == 200 && main.k <= 4 {
        true -> region(main, main.k)
        _ -> bad(main)
    }

    state region(main: &mut Main, offset: u32) {
        let pair: &i16 = &main.bytes[offset] as &i16;
        transition pair == -2 && (&main.bytes[3] as &i16) == -2
            && (&main.bytes[offset] as &i16) == (&main.bytes[3] as &i16) {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
