// A signed 16-bit value re-views as unsigned bits: `&main.reading as
// &u16` exposes the i16 storage's raw interpretation — `-1` reads as
// 65535 through the shared view.
data Main {
    reading: i16;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.reading = 0 - 1;
    transition (&main.reading as &u16) == 65535 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
