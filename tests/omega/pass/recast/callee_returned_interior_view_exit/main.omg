// Expected exit: 0. Returned middle window spans original sibling fields.
data Header { left: u64; right: u64; }
data View { prefix: u64; middle: Header; tail: u64; }
data Source { first: u64; second: u64; third: u64; fourth: u64; }
data Main { source: Source; }
data Envelope { middle: &Header; }

machine Source::middle(source: &Source) -> &Header {
    let view: &View = source as &View;
    let middle: &Header = &view.middle;
    middle
}

machine Source::middle_direct(source: &Source) -> &Header {
    let view: &View = source as &View;
    &view.middle
}

machine Source::packed_middle(source: &Source) -> Envelope {
    let view: &View = source as &View;
    Envelope { middle: &view.middle }
}

machine Source::forward_middle(source: &Source) -> &Header {
    transition { _ -> next(source) }
    machine next(source: &Source) -> &Header { Source::middle_direct(source) }
}

machine View::middle(view: &View) -> &Header { &view.middle }

machine Source::forward_view(source: &Source) -> &Header {
    let view: &View = source as &View;
    View::middle(view)
}

machine Main::main(main: &mut Main) crashes Trap {
    main.source.first = 7u64;
    main.source.second = 37u64;
    main.source.third = 9u64;
    main.source.fourth = 11u64;
    let middle: &Header = Source::middle(&main.source);
    let direct: &Header = Source::middle_direct(&main.source);
    let packed: Envelope = Source::packed_middle(&main.source);
    let forwarded: &Header = Source::forward_middle(&main.source);
    let parameter: &Header = Source::forward_view(&main.source);
    transition middle.left == 37u64 && middle.right == 9u64
        && direct.left == 37u64 && direct.right == 9u64
        && packed.middle.left == 37u64 && packed.middle.right == 9u64
        && forwarded.left == 37u64 && forwarded.right == 9u64
        && parameter.left == 37u64 && parameter.right == 9u64
        && main.source.first == 7u64 && main.source.fourth == 11u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
