// An additional non-owning input qualification may be explicitly erased.
// It is not a declared field obligation or an automatic return promise.
data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket in Ticket::Issued { Ticket { number: 17 } }
machine weaken(ticket: &mut Ticket in Ticket::Issued) {
    let view: &mut Ticket = ticket as &mut Ticket;
}
