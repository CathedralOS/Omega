// A mutable recast writes a negative value through a signed view of a
// u32 field: `&mut main.raw as &mut i32` stores -3 — read back as u32,
// those bits are 4294967293.
data Main {
    raw: u32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 0;
    let view: &mut i32 = &mut main.raw as &mut i32;
    view = 0 - 3;
    transition main.raw == 4294967293 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
