// Authored data may shadow a toolchain declaration without sharing its carrier.
// Build's Source is a sum; this Source is a zero-initialized record.
// A borrowed recast must retain the record's namespace for its field load.
data Source { entries: [u16; 2]; tag: u32; }
data View { entries: [u16; 2]; tag: u32; }

machine main() crashes Trap {
    let mut source: Source;
    let view: &mut View = &mut source as &mut View;
    let observed: u32 = view.tag;
    transition observed == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
