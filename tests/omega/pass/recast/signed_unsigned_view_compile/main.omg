// An equal-width recast between signed and unsigned of the same size sees
// the same bits: `&score as &u32` on an i32 holding -1 observes 4294967295.
// The view borrows; the source's type is unchanged for later reads.
data Main {
    score: i32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.score = 0 - 1;
    transition (&main.score as &u32) == 4294967295 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
