// A signed integer views as a float: `&raw as &f64` reads the i64's bits
// as an IEEE-754 double — the value is only the bit pattern, so -1's all-
// ones pattern is NaN and any comparison falls to the false arm. The view
// itself is what the probe pins.
data Main {
    raw: i64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 0 - 1;
    transition (&main.raw as &f64) == 1.5 {
        true -> seen(main)
        _ -> nan(main)
    }

    machine seen(main: &mut Main) { main.verdict = 70; }
    machine nan(main: &mut Main) { main.verdict = 71; }
}
