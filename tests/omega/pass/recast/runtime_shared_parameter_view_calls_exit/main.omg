// Two views borrow one original scalar home and survive ordinary helper calls.
machine signed_value(value: &i32) -> i32 { value }
machine unsigned_value(value: &u32) -> u32 { value }

data SignedRecord { value: i32; }
data UnsignedRecord { value: u32; }
data Envelope<'storage> { item: &'storage UnsignedRecord; }

machine inspect_stored(envelopes: &[Envelope]) -> u32 {
    transition envelopes.len >= 1 {
        true -> (envelopes[0].item.value)
        _ -> (0)
    }
}

machine inspect(value: i32) -> u32 {
    let signed: &i32 = &value;
    let unsigned: &u32 = &value as &u32;
    let observed: i32 = signed_value(signed);
    transition observed == -17 {
        true -> unsigned_value(unsigned)
        _ -> 0
    }
}

machine main() crashes Trap {
    let bits: u32 = inspect(-17);
    let other: u32 = inspect(-16);
    let source: SignedRecord = SignedRecord { value: -17 };
    let viewed: &UnsignedRecord = &source as &UnsignedRecord;
    let envelopes: [Envelope; 1] = [Envelope { item: viewed }];
    let window: &[Envelope] = &envelopes[..];
    let stored: u32 = inspect_stored(window);
    transition bits == 4294967279 && other == 0 && stored == 4294967279 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
