// Equal-width recast at 16 bits: `&short as &i16` views a u16 holding
// 65535 as -1 — the same two bytes under the signed interpretation.
data Main {
    short: u16;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.short = 65535;
    transition (&main.short as &i16) == (0 - 1) {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
