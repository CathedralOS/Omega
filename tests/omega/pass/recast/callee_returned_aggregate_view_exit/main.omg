// Expected exit: 0. A callee's admitted re-view returns the original bytes,
// not a renamed source path or a separate copy of its referent.
data Header { left: u64; right: u64; }
data AliasHeader { first: u64; second: u64; }
data Main { header: Header; }

machine Header::as_alias(header: &Header) -> &AliasHeader {
    let alias: &AliasHeader = header as &AliasHeader;
    alias
}

machine Main::main(main: &mut Main) crashes Trap {
    main.header.left = 37u64;
    main.header.right = 9u64;
    let alias: &AliasHeader = Header::as_alias(&main.header);
    transition alias.first == 37u64 && alias.second == 9u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
