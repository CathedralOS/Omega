// Expected exit: 0. Scalar loans through a nested re-view retain their original
// cell and signed/unsigned codec through helper calls and returned references.
data SignedHeader { left: i16; right: i16; }
data UnsignedHeader { left: u16; right: u16; }
data View { prefix: u16; value: UnsignedHeader; tail: u16; }
data Source { prefix: u16; value: SignedHeader; tail: u16; }
data Main { source: Source; }

machine read(value: &u16) -> u16 { value }
machine identity(value: &u16) -> &u16 { value }
machine write(value: &mut u16) { value = 65534u16; }

machine Main::main(main: &mut Main) crashes Trap {
    main.source.prefix = 7u16;
    main.source.value.left = -1i16;
    main.source.value.right = 42i16;
    main.source.tail = 11u16;
    let view: &mut View = &mut main.source as &mut View;
    let initial: u16 = read(&view.value.left);
    write(&mut view.value.left);
    let returned: &u16 = identity(&view.value.left);
    let observed: u16 = read(returned);
    transition initial == 65535u16 && observed == 65534u16
        && main.source.prefix == 7u16 && main.source.value.left == -2i16
        && main.source.value.right == 42i16 && main.source.tail == 11u16 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
