use omega::language::core::float_operations;

// RUN CANARY (exit 70) + interpreter differential. Record-wide shared recasts
// apply the scalar implication law leaf by leaf: the same f32 carrier's 0..=1
// interval establishes the wider 0..=2 target fact without changing bytes.
use omega_language_std::console;

data NarrowReading {
    value: f32 [0..=1];
}

data WideReading {
    value: f32 [0..=2];
}

data Main {
    console: Console;
    reading: NarrowReading;
}

machine Main::main(&mut self) {
    let view: &WideReading = &self.reading as &WideReading;
    transition view.value == self.reading.value {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
