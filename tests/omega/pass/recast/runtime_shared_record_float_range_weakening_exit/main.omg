use omega::language::core::float_operations;

// RUN CANARY (exit 70) + interpreter differential. Record-wide shared recasts
// apply the scalar implication law leaf by leaf: the same f32 carrier's
// `0 <= value <= 1` data `where` fact establishes the wider `0 <= value <= 2`
// target fact without changing bytes.
use omega_language_std::console;

data NarrowReading
where
    value >= 0.0 && value <= 1.0,
{
    value: f32;
}

data WideReading
where
    value >= 0.0 && value <= 2.0,
{
    value: f32;
}

data Main {
    reading: NarrowReading;
}

machine Main::main(context: &mut Main) reaches Console {
    let view: &WideReading = &context.reading as &WideReading;
    transition view.value == context.reading.value {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
