// A mutable recast writes float bits through a signed view: `&mut
// main.raw as &mut f32` stores 0.5's pattern — read back as i32 it is
// 0x3F000000 = 1056964608.
data Main {
    raw: i32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 0;
    let view: &mut f32 = &mut main.raw as &mut f32;
    view = 0.5;
    transition main.raw == 1056964608 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
