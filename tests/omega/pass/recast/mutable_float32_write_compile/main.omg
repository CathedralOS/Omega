// A mutable recast writes f32 bits through a u32 view: `&mut main.raw as
// &mut f32` stores 3.25's IEEE-754 single pattern — read back as the
// integer, it is 0x40500000 = 1079197696.
data Main {
    raw: u32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 0;
    let view: &mut f32 = &mut main.raw as &mut f32;
    view = 3.25;
    transition main.raw == 1079197696 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
