// A recast view may name an array element: `&main.cells[1] as &i64`
// reinterprets the second slot's bits — indexed places recast like
// member places.
data Main {
    cells: [u64; 2];
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.cells = [1, 18446744073709551615];
    transition (&main.cells[1] as &i64) == 0 - 1 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
