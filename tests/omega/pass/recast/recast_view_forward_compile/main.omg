// A recast `&mut` view forwards as a call argument: `let bits: &mut i64
// = &mut main.raw as &mut i64` binds the view, then `neg(bits)` uses it
// like any exclusive loan — the recast's loan semantics don't end at the
// binding.
data Main {
    raw: u64;
    verdict: u64;
}

machine Main::neg(bits: &mut i64) {
    bits = 0 - 9;
}

machine Main::main(main: &mut Main) {
    main.raw = 0;
    let bits: &mut i64 = &mut main.raw as &mut i64;
    Main::neg(bits);
    transition main.raw == 18446744073709551607 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
