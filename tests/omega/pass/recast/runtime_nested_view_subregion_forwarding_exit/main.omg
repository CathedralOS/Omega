// Expected exit: 0. A nested re-view's middle window retains the original
// cells through reborrowing, a helper call and a state edge, including writes.
data Header { left: u64; right: u64; }
data AliasHeader { first: u64; second: u64; }
data View { prefix: u64; value: Header; tail: u64; }
data Source { first: u64; second: u64; third: u64; fourth: u64; }
data ArraySource { cells: [u64; 4]; }
data Main { source: Source; array: ArraySource; }

machine Header::write(header: &mut Header) {
    transition true { _ -> update(header) }
    state update(header: &mut Header) {
        header.left = 61u64;
        header.right = 19u64;
    }
}

machine Header::read(header: &Header) -> u64 {
    transition true { _ -> observe(header) }
    state observe(header: &Header) { header.left }
}

machine AliasHeader::read(header: &AliasHeader) -> u64 { header.first }
machine Header::identity(header: &Header) -> &Header { header }

machine Main::main(main: &mut Main) crashes Trap {
    main.source.first = 7u64;
    main.source.second = 37u64;
    main.source.third = 9u64;
    main.source.fourth = 11u64;
    let view: &mut View = &mut main.source as &mut View;
    let child: &mut Header = &mut view.value;
    Header::write(child);
    let observed: u64 = Header::read(&view.value);
    let returned: &Header = Header::identity(&view.value);
    let returned_observed: u64 = Header::read(returned);
    let recast: &AliasHeader = &view.value as &AliasHeader;
    let recast_observed: u64 = AliasHeader::read(recast);
    transition observed == 61u64 && returned_observed == 61u64 && recast_observed == 61u64
        && main.source.first == 7u64 && main.source.second == 61u64
        && main.source.third == 19u64 && main.source.fourth == 11u64 {
        true -> array(main)
        _ -> bad()
    }
    state array(main: &mut Main) {
        main.array.cells[0] = 7u64;
        main.array.cells[1] = 37u64;
        main.array.cells[2] = 9u64;
        main.array.cells[3] = 11u64;
        let view: &mut View = &mut main.array as &mut View;
        Header::write(&mut view.value);
        let observed: u64 = Header::read(&view.value);
        transition observed == 61u64
            && main.array.cells[0] == 7u64 && main.array.cells[1] == 61u64
            && main.array.cells[2] == 19u64 && main.array.cells[3] == 11u64 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
