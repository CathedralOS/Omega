// Equal-width float recast works at f32 width too: `&rate as &u32` views
// an f32 holding 2.0 as 0x40000000 — the raw IEEE-754 pattern of the
// single-precision value.
data Main {
    rate: f32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 2.0;
    transition (&main.rate as &u32) == 1073741824 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
