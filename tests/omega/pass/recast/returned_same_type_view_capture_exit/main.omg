// Expected exit: 0. Rebinding a view cannot retarget an already captured alias.
data Header { left: u64; right: u64; }
data AliasHeader { first: u64; second: u64; }
data Carrier { view: &Header; }
data Main { first: Header; second: Header; }

machine capture<'input>(first: &'input Header, second: &'input Header) -> &'input Header {
    let mut view: &Header = first as &Header;
    let child: &Header = view;
    view = second as &Header;
    child
}

machine roundtrip<'input>(first: &'input Header, second: &'input Header) -> &'input Header {
    let alternate: &AliasHeader = first as &AliasHeader;
    let mut view: &Header = alternate as &Header;
    let child: &Header = view;
    view = second as &Header;
    child
}

machine replace_from_old<'input>(first: &'input Header) -> &'input Header {
    let mut view: &Header = first as &Header;
    view = view as &Header;
    view
}

machine replace_twice<'input>(first: &'input Header) -> &'input Header {
    let mut view: &Header = first as &Header;
    view = view as &Header;
    let child: &Header = view as &Header;
    view = view as &Header;
    child
}

machine carry_replacement<'input>(first: &'input Header) -> &'input Header {
    let mut view: &Header = first as &Header;
    view = view as &Header;
    transition { _ -> retained(view) }
    machine retained(held: &'input Header) -> &'input Header { held }
}

machine return_replacement_view<'input>(first: &'input Header) -> &'input Header {
    let mut view: &Header = first as &Header;
    view = view as &Header;
    view as &Header
}

machine return_stored_view<'input>(first: &'input Header) -> &'input AliasHeader {
    let view: &Header = first as &Header;
    let carrier: Carrier = Carrier { view: view };
    carrier.view as &AliasHeader
}

machine Main::main(main: &mut Main) crashes Trap {
    main.first.left = 37u64;
    main.first.right = 9u64;
    main.second.left = 71u64;
    main.second.right = 13u64;
    let direct: &Header = capture(&main.first, &main.second);
    let restored: &Header = roundtrip(&main.first, &main.second);
    let replaced: &Header = replace_from_old(&main.first);
    let repeated: &Header = replace_twice(&main.first);
    let carried: &Header = carry_replacement(&main.first);
    let returned: &Header = return_replacement_view(&main.first);
    let stored: &AliasHeader = return_stored_view(&main.first);
    transition direct.left == 37u64 && direct.right == 9u64
        && restored.left == 37u64 && restored.right == 9u64
        && replaced.left == 37u64 && replaced.right == 9u64
        && repeated.left == 37u64 && repeated.right == 9u64
        && carried.left == 37u64 && carried.right == 9u64
        && returned.left == 37u64 && returned.right == 9u64
        && stored.first == 37u64 && stored.second == 9u64 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
