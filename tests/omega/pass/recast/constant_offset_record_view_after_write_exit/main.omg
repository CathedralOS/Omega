// RUN CANARY (exit 70) + interpreter differential. A constant-offset record
// view must observe runtime writes to its backing bytes. Constant folding may
// know the displacement, but it must not replace the view's field reads with
// values from the zero-initialized static image.
use omega_language_std::console;
data Desc { a: u32; b: u64; }
data Main { console: Console; buf: [u8; 24]; }

machine Main::main(&mut self) {
    self.buf[8] = 7;
    self.buf[16] = 9;
    let d: &Desc = &self.buf[8] as &Desc;
    transition d.a == 7 && d.b == 9 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
