// A mutable recast may name a plain local: `&mut local as &mut i64`
// reinterprets the local's bytes — the signed view writes -11, and the
// unsigned local reads back the all-but-3-bits pattern.
data Main {
    raw: u64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 0;
    let local: u64 = 0;
    let view: &mut i64 = &mut local as &mut i64;
    view = 0 - 11;
    transition local == 18446744073709551605 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
