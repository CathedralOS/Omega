// RUN CANARY (exit 70) + interpreter differential. Interior unsized slices
// may start at a COMPOSITE runtime offset when the bound walk and the
// residue proof agree: `k * 2` bounds at 6 (below the eight-byte region)
// and is always even, so the remaining `8 - k * 2` bytes exactly tile
// `u16` elements. Mutable projected writes must reach the backing bytes.
use omega_language_std::console;
use omega::language::core::binding;

data Main where k <= 3 {
    console: Binding<Console>;
    bytes: [u8; 8];
    k: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.k = 2;
    let words: &mut [u16] = &mut main.bytes[main.k * 2] as &mut [u16];
    transition words.len > 1 {
        true -> write_words(main, words)
        _ -> bad_length(main)
    }

    state write_words(main: &mut Main, words: &mut [u16]) {
    words[0] = 0x0201;
    words[1] = 0x0403;
    transition words.len == 2 {
        true -> check_backing(main)
        _ -> bad_length(main)
    }
    }

    // The edge drops the mutable slice before observing its original backing.
    state check_backing(main: &mut Main) {
    transition main.bytes[4] == 1 && main.bytes[5] == 2
        && main.bytes[6] == 3 && main.bytes[7] == 4 {
        true -> good(main)
        _ -> bad_write(main)
    }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad_length(main: &mut Main) { main.console.exit_process(71); }
    state bad_write(main: &mut Main) { main.console.exit_process(72); }
}
