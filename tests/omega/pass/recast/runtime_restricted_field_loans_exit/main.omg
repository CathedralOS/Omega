// RUN CANARY (exit 0) + interpreter differential. A field bounded by its
// owner's `where` facts lends no reference carrier: Terminal keeps the
// restriction on the record field. A plain shared loan, a total shared view
// and a mutable Boolean alias of that field each keep the place observation,
// so reads transport the 0/1 bound and the write re-proves it.
data Byte where value >= 0 && value <= 1 { value: u8; }

machine plain(byte: &Byte) -> u8 {
    let view: &u8 = &byte.value;
    view
}

machine signed(byte: &Byte) -> i8 {
    let view: &i8 = &byte.value as &i8;
    view
}

machine set(byte: &mut Byte) {
    let flag: &mut bool = &mut byte.value as &mut bool;
    flag = true;
}

machine main() crashes Trap {
    let mut byte: Byte = Byte { value: 0 };
    set(&mut byte);
    let observed: u8 = plain(&byte);
    let viewed: i8 = signed(&byte);
    transition observed == 1 && viewed == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
