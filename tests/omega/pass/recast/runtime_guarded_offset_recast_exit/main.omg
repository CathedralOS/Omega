// RUN CANARY (exit 70) + interpreter differential. RUNG C1+ of the §5b
// recast ladder -- the GUARD-DISCHARGED runtime offset (Cathedral M2 gap
// #4): the offset param `off: u32` carries NO enforced interval; the
// bound arrives from the caller's dominating transition guard
// (`main.k <= 8` on the single incoming edge's guarded arm). The recast
// judgment walks incoming edges, extracts the argument at the param's
// position, and reads the guard's literal upper bound; the footprint
// then discharges as `8 + size(u32) <= 12`. The checker's element-index
// prover SKIPS the recast's direct Indexed operand (the footprint check
// is strictly stronger than `off < 12`); nested reads inside the offset
// expression keep their own obligations. A weaker guard (`main.k <= 9`)
// refuses at the recast (fail/recast/guarded_offset_footprint_rejected).
use omega_language_std::console;
data Main { buf: [u8; 12]; k: u32; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.buf[4] = 1;
    main.buf[5] = 2;
    main.buf[6] = 3;
    main.buf[7] = 4;
    main.k = 4;
    transition main.k <= 8 { true -> read(main, main.k) _ -> bad(main) }
    state read(main: &mut Main, off: u32) {
        let v: &u32 = &main.buf[off] as &u32;
        transition v == 67305985 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main)  { Console::exit_process(71); }
}
