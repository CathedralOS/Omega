// A mutable recast may name an array element: `&mut main.cells[0] as
// &mut i64` forwards the slot's bytes to `flip`, whose `v = 0 - 1`
// store writes through the borrow — a sign flip repair that leaves the
// element holding a live value.
data Main {
    cells: [u64; 2];
    verdict: u64;
}

machine Main::flip(v: &mut i64) {
    v = 0 - 1;
}

machine Main::main(main: &mut Main) {
    main.cells = [5, 5];
    Main::flip(&mut main.cells[0] as &mut i64);
    transition main.cells[0] == 18446744073709551615 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
