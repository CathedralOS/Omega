// A mutable recast writes float bits through an integer view: `&mut
// main.bits as &mut f64` stores an IEEE-754 pattern into the u64's bytes,
// and the field reads back as the integer interpretation of those bits.
data Main {
    bits: u64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.bits = 0;
    let view: &mut f64 = &mut main.bits as &mut f64;
    view = 1.5;
    transition main.bits == 4609434218613702656 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
