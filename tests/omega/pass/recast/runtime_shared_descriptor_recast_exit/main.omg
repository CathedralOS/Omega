// Expected exit: 0
use omega_language_std::console;
machine inspect(pixels: &[i32]) -> bool
requires pixels.len == 6
{
    let bytes: &[u8] = pixels as &[u8];
    transition bytes.len == 24 {
        true -> read(bytes)
        _ -> false
    }
    machine read(bytes: &[u8]) -> bool
    requires bytes.len == 24 {
        bytes[0] == 0x33 && bytes[12] == 0x66 && bytes[22] == 0x77
    }
}
machine empty(pixels: &[i32]) -> bool
requires pixels.len == 0
{
    let bytes: &[u8] = pixels as &[u8];
    bytes.len == 0
}
machine main() reaches Console {
    let pixels: [i32; 6] = [0x00112233, 0, 0, 0x00445566, 0, 0x00778899];
    let guarded: [i32; 8] = [0x007f7f7f, 0x00112233, 0, 0, 0x00445566, 0, 0x00778899, 0x007e7e7e];
    let whole: bool = inspect(&pixels[..]);
    let narrowed: bool = inspect(&guarded[1..7]);
    let none: [i32; 0];
    let empty_view: bool = empty(&none[..]);
    transition whole && narrowed && empty_view {
        true -> passed()
        _ -> failed()
    }
    machine passed() { Console::exit_process(0); }
    machine failed() { Console::exit_process(1); }
}
