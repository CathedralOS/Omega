use omega::language::core::float_operations;

// RUN CANARY (exit 70) + interpreter differential. Numeric range inclusion is
// representation implication when both views use the same IEEE carrier. A
// shared view may forget the field's `0 <= value <= 1` data `where` fact,
// including into an unconstrained equal-width bit carrier (`&u32` reads the
// stored binary32 bits), and a same-carrier mutable view is legal. Local
// references cannot spell ranges, so the shared `&f32` view weakens the fact
// by forgetting it; the mutable view keeps the field's declared facts.
// Mutable cross-carrier aliasing remains forbidden.
use omega_language_std::console;

data Main
where
    value >= 0.0 && value <= 1.0,
{
    value: f32;
}

machine Main::main(context: &mut Main) reaches Console {
    let wide: &f32 = &context.value as &f32;
    let bits: &u32 = &context.value as &u32;
    transition wide == 0.0f32 && bits == 0 {
        true -> mutate(context)
        _ -> bad(context)
    }

    machine mutate(context: &mut Main) {
        let exact: &mut f32 = &mut context.value as &mut f32;
        transition exact == context.value {
            true -> good(context)
            _ -> bad(context)
        }
    }

    machine good(context: &mut Main) { Console::exit_process(70); }
    machine bad(context: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
