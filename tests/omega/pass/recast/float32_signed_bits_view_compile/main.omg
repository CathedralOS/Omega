// A 32-bit float views as a signed integer too: `&rate as &i32` reads
// the f32's bits — -1.0's pattern 0xBF800000 is the signed value
// -1082130432.
data Main {
    rate: f32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 0.0 - 1.0;
    transition (&main.rate as &i32) == 0 - 1082130432 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
