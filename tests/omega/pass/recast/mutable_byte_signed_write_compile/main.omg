// A mutable recast writes a signed value through a byte view: `&mut
// main.raw as &mut i8` stores -1 — read back as the unsigned byte it is
// 255, the same two's-complement reinterpretation.
data Main {
    raw: u8;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 0;
    let view: &mut i8 = &mut main.raw as &mut i8;
    view = 0 - 1;
    transition main.raw == 255 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
