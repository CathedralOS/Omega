// Expected exit: 0
data Ticket [copy] { number: u64; }
domain<const Batch: u64> Ticket::Issued<Batch> established by issue;
machine issue() -> Ticket in Issued<7> { Ticket { number: 17 } }
machine retain<'storage>(ticket: &'storage Ticket in Issued<7>) -> &'storage Ticket in Issued<7> {
    ticket as &Ticket in Issued<7>
}
machine main() crashes Trap {
    let ticket: Ticket in Issued<7> = issue();
    let view: &Ticket in Issued<7> = retain(&ticket);
    transition view.number == 17 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
