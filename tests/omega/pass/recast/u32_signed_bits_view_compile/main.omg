// An unsigned value views as its signed counterpart in the 32-bit pair:
// `&raw as &i32` reads u32's maximum as -1 — the sign bit flips the
// interpretation of the same bits.
data Main {
    raw: u32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 4294967295;
    transition (&main.raw as &i32) == 0 - 1 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
