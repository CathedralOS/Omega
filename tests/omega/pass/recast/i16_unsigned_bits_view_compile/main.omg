// A narrow signed value views as its unsigned counterpart: `&half as &u16`
// reads -2's two bytes as 0xFFFE = 65534 — the same reinterpretation the
// 8-bit and 64-bit views show.
data Main {
    half: i16;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.half = 0 - 2;
    transition (&main.half as &u16) == 65534 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
