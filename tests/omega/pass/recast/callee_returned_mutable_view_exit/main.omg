// Expected exit: 0. A returned mutable view writes the original backing.
data Header { left: u64; right: u64; }
data AliasHeader { first: u64; second: u64; }
data Source { first: u64; second: u64; third: u64; fourth: u64; }
data Layout { prefix: u64; middle: Header; tail: u64; }
data Main { header: Header; source: Source; }

machine alias(header: &mut Header) -> &mut AliasHeader {
    let view: &mut AliasHeader = header as &mut AliasHeader;
    view
}

machine middle(source: &mut Source) -> &mut Header {
    let view: &mut Layout = source as &mut Layout;
    let selected: &mut Header = &mut view.middle;
    selected
}

machine Main::main(main: &mut Main) crashes Trap {
    main.header.left = 37u64;
    main.header.right = 9u64;
    let view: &mut AliasHeader = alias(&mut main.header);
    view.first = 41u64;
    view.second = 13u64;
    main.source.first = 7u64;
    main.source.second = 37u64;
    main.source.third = 9u64;
    main.source.fourth = 11u64;
    let selected: &mut Header = middle(&mut main.source);
    selected.left = 43u64;
    selected.right = 17u64;
    transition main.header.left == 41u64 && main.header.right == 13u64
        && main.source.first == 7u64 && main.source.second == 43u64
        && main.source.third == 17u64 && main.source.fourth == 11u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
