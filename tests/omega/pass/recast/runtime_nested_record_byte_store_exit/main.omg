// The record view is used only for stores. Its nested field geometry must
// reach the byte backing without relying on a subsequent record read.
use omega_language_std::console;

data Cell { value: u16; }
data Pair { first: Cell; second: Cell; }
data Main { bytes: [u8; 8]; }

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[1] = 9;
    main.bytes[6] = 8;
    let view: &mut Pair = &mut main.bytes[2] as &mut Pair;
    view.first.value = 257;
    view.second.value = 513;
    transition main.bytes[1] == 9 && main.bytes[2] == 1
        && main.bytes[3] == 1 && main.bytes[4] == 1
        && main.bytes[5] == 2 && main.bytes[6] == 8 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
