// The record view is used only for stores. Its nested field geometry must
// reach the byte backing without relying on a subsequent record read.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: u16; }
data Pair { first: Cell; second: Cell; }
data Main { console: Binding<Console>; bytes: [u8; 8]; }

machine Main::main(&mut self) reaches Console {
    self.bytes[1] = 9;
    self.bytes[6] = 8;
    let view: &mut Pair = &mut self.bytes[2] as &mut Pair;
    view.first.value = 257;
    view.second.value = 513;
    transition self.bytes[1] == 9 && self.bytes[2] == 1
        && self.bytes[3] == 1 && self.bytes[4] == 1
        && self.bytes[5] == 2 && self.bytes[6] == 8 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
