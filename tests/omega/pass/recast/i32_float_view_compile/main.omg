// A signed integer re-views as float bits at equal width: `&main.code
// as &f32` exposes the i32 storage's IEEE-754 reading — bit pattern
// `0x40000000` (1073741824) decodes to 2.0.
data Main {
    code: i32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.code = 1073741824;
    transition (&main.code as &f32) == 2.0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
