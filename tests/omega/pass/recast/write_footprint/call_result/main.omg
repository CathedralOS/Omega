// Expected exit: 0
data Value { number: u64; }
data Alternate { number: u64; }

machine borrow_view(value: &mut Value) -> &mut Alternate {
    value as &mut Alternate
}

machine observe(view: &mut Alternate) -> u64 {
    view.number
}

machine require_seventeen(value: u64)
requires value == 17
{}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    transition value.number == 17 {
        true -> inspect(value)
        _ -> wrong()
    }
    machine inspect(mut value: Value)
    requires value.number == 17
    {
        let observed: u64 = observe(borrow_view(&mut value));
        require_seventeen(value.number);
        transition observed == 17 {
            true -> done()
            _ -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
