// A mutable recast writes a negative value through a signed view of a
// u16 field: `&mut main.half as &mut i16` stores -5 — read back as u16,
// those bits are 65531.
data Main {
    half: u16;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.half = 0;
    let view: &mut i16 = &mut main.half as &mut i16;
    view = 0 - 5;
    transition main.half == 65531 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
