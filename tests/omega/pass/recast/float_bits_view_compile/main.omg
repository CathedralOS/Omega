// A float may be viewed through an equal-width scalar recast loan:
// `&rate as &u64` reinterprets the f64 payload's IEEE-754 bits as an
// unsigned word. Reading through the view observes the raw bit pattern —
// 1.5 is 0x3FF8000000000000.
data Main {
    rate: f64;
    bits: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 1.5;
    transition (&main.rate as &u64) == 4609434218613702656 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.bits = 70; }
    machine bad(main: &mut Main) { main.bits = 71; }
}
