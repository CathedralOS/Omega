// A signed integer views as a float in the 32-bit pair: `&raw as &f32`
// reads the i32's bits as an IEEE-754 single — the value 0x3F800000 is
// 1.0 regardless of the source's signedness.
data Main {
    raw: i32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 1065353216;
    transition (&main.raw as &f32) == 1.0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
