// RUN CANARY (exit 70) + interpreter differential. A mutable recast may retain
// facts when both views carry the same normalized domain. Either u32 view
// therefore denotes the same established value set. Cross-carrier predicates
// that merely LOOK equal remain fenced until their bit-pattern sets can be
// proved equivalent. Other canaries independently pin mutable write-through.
use omega_language_std::console;

domain u32::Small(value)
requires
    value <= 100;

data Main {
    value: u32 in Small;
}

machine Main::main(main: &mut Main) reaches Console {
    let view: &mut u32 in Small = &mut main.value as &mut u32;
    // `view` suspends `main.value` until its last use, so the owner is read
    // after it.
    transition view == 0 && main.value == 0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
