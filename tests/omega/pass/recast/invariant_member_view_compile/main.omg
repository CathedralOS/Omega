// A recast view may name a `data where` member: `&main.cap.v as &i64`
// reads the constrained u64's bits — the field's invariant doesn't change
// what a view may reinterpret.
data Cap
where
    v <= 5,
    v >= 1,
{
    v: u64;
}

data Main {
    cap: Cap;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.cap = Cap { v: 3 };
    transition (&main.cap.v as &i64) == 3 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
