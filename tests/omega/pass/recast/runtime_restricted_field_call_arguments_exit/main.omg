// Shared field loans into calls preserve the owner's standing invariant.
data Byte where value >= 0 && value <= 1 { value: u8; }
data Wrapped { byte: Byte; }

machine take(value: &u8) -> u8 { value }

machine inspect(byte: &Byte) -> u8 { take(&byte.value) }
machine clear(byte: &mut Byte) -> u8 { byte.value = 0; 1 }
machine combine(prefix: u8, value: &u8) -> bool { prefix == 1 && value == 0 }

machine main() crashes Trap {
    let mut byte: Byte = Byte { value: 1 };
    let direct: u8 = take(&byte.value);
    let forwarded: u8 = inspect(&byte);
    let ordered: bool = combine(clear(&mut byte), &byte.value);
    let wrapped: Wrapped = Wrapped { byte: Byte { value: 1 } };
    let nested: u8 = take(&wrapped.byte.value);
    transition direct == 1 && forwarded == 1 && ordered && nested == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
