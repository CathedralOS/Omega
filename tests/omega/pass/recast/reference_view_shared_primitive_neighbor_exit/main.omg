// Expected exit: 0. An unrelated primitive loan cannot alter aggregate ingress.
data Counter { count: u64; pad: u64; }
data Source { first: u64; count: u64; }
data Main { source: Source; neighbor: u64; }
machine read(counter: &Counter, neighbor: &u64) -> bool {
    counter.count == 37u64 && neighbor == 2u64
}
machine Main::main(main: &mut Main) crashes Trap {
    main.source.first = 37u64;
    main.source.count = 8u64;
    main.neighbor = 2u64;
    let observed: bool = read(&mut main.source as &mut Counter, &main.neighbor);
    transition observed && main.source.count == 8u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
