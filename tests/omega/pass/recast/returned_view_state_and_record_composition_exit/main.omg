// Expected exit: 0. Returned presentations compose through records, calls and states.
data Header { left: u64; right: u64; }
data AliasHeader { first: u64; second: u64; }
data Envelope { alias: &AliasHeader; }
data Main { header: Header; }

machine alias(header: &Header) -> &AliasHeader {
    let view: &AliasHeader = header as &AliasHeader;
    view
}

machine forward(header: &Header) -> &AliasHeader {
    transition { _ -> next(header) }
    machine next(header: &Header) -> &AliasHeader { alias(header) }
}

machine packed(header: &Header) -> Envelope {
    let view: &AliasHeader = alias(header);
    Envelope { alias: view }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.header.left = 37u64;
    main.header.right = 9u64;
    let view: &AliasHeader = forward(&main.header);
    let envelope: Envelope = packed(&main.header);
    transition view.first == 37u64 && view.second == 9u64
        && envelope.alias.first == 37u64 && envelope.alias.second == 9u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
