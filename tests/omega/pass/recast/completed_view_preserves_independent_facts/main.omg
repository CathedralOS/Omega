// Expected exit: 0. A completed view preserves independent model and scalar facts.
data Word [copy] { value: u64; }

machine read(buffer: &[u8; 16], offset: u64 in Trapping, retry: u64) -> u64
requires addr::Bound == 18446744073709551616 && offset <= 8 && retry <= 1
{
    let word: &Word = &buffer[offset] as &Word;
    let address: addr = 18446744073709551615 as addr;
    let count: u64 = address as u64;
    transition word.value > 0 && count == 18446744073709551615 {
        true -> finish(word.value, retry)
        _ -> finish(0, retry)
    }
    machine finish(value: u64, retry: u64) -> u64
    requires addr::Bound == 18446744073709551616 && retry <= 1
    { value }
}

machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let bytes: [u8; 16] = [0, 0, 0, 0, 0, 0, 0, 0, 42, 0, 0, 0, 0, 0, 0, 0];
    let value: u64 = read(&bytes, 8, 0);
    let empty: u64 = read(&bytes, 0, 1);
    transition value == 42 && empty == 0 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
