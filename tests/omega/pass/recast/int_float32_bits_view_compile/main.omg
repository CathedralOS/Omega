// An integer views as a float in the 32-bit pair too: `&raw as &f32`
// reads the u32's bits as an IEEE-754 single — 0x3FC00000 is 1.5.
data Main {
    raw: u32;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.raw = 1069547520;
    transition (&main.raw as &f32) == 1.5 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
