// RUN CANARY (exit 70) + interpreter differential. A mutable scalar view at a
// runtime offset preserves the whole proven byte-region footprint. Writing
// 0x04030201 through `&mut u32` updates bytes k..k+4 little-endian, leaves the
// surrounding sentinels untouched, and a subsequent view read observes the
// same bits. The owning data predicate proves k + 4 <= 8.
use omega_language_std::console;

data Main
where k <= 4,
{
    buf: [u8; 8];
    k: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[0] = 9;
    main.buf[1] = 8;
    main.buf[6] = 7;
    main.buf[7] = 6;
    main.k = 2;

    let view: &mut u32 = &mut main.buf[main.k] as &mut u32;
    view = 67305985;
    // `view` suspends the buffer its runtime offset may cover until its last
    // use, so the owner's bytes are read after it.
    transition view == 67305985
        && main.buf[0] == 9
        && main.buf[1] == 8
        && main.buf[2] == 1
        && main.buf[3] == 2
        && main.buf[4] == 3
        && main.buf[5] == 4
        && main.buf[6] == 7
        && main.buf[7] == 6 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main)  { Console::exit_process(71); }
}
