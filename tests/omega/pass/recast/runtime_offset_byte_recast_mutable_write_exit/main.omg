// RUN CANARY (exit 70) + interpreter differential. A mutable scalar view at a
// runtime offset preserves the whole proven byte-region footprint. Writing
// 0x04030201 through `&mut u32` updates bytes k..k+4 little-endian, leaves the
// surrounding sentinels untouched, and a subsequent view read observes the
// same bits. The declared offset range proves k + 4 <= 8.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    buf: [u8; 8];
    k: u32 [0..=4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[0] = 9;
    main.buf[1] = 8;
    main.buf[6] = 7;
    main.buf[7] = 6;
    main.k = 2;

    let view: &mut u32 = &mut main.buf[main.k] as &mut u32;
    view = 67305985;
    transition main.buf[0] == 9
        && main.buf[1] == 8
        && main.buf[2] == 1
        && main.buf[3] == 2
        && main.buf[4] == 3
        && main.buf[5] == 4
        && main.buf[6] == 7
        && main.buf[7] == 6
        && view == 67305985 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main)  { main.console.exit_process(71); }
}
