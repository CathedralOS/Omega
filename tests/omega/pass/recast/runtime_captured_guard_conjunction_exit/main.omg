// Expected exit: 0.
// A captured reference predicate and an independent entry bound establish one
// arrival conjunction. Recast storage retains its declared field observation;
// a successful check of the whole guard is not the only admissible shape.
data Descriptor { pages: u64; base: u64; }

machine inspect(bytes: &[u8; 24], offset: u64) -> u64
requires offset <= 8
{
    let descriptor: &Descriptor = &bytes[offset] as &Descriptor;
    transition descriptor.pages <= 4503599627370495 &&
        descriptor.base <= 18446744073709551615 - descriptor.pages * 4096 {
        true -> consume(bytes, offset, descriptor)
        _ -> 0
    }
    machine consume(bytes: &[u8; 24], offset: u64, descriptor: &Descriptor) -> u64
    requires offset <= 8 && descriptor.pages <= 4503599627370495 &&
        descriptor.base <= 18446744073709551615 - descriptor.pages * 4096
    {
        descriptor.base + descriptor.pages * 4096
    }
}

machine main() crashes Trap {
    let bytes: [u8; 24] = [91, 0, 0, 0, 0, 0, 0, 0,
                          3, 0, 0, 0, 0, 0, 0, 0,
                          17, 0, 0, 0, 0, 0, 0, 0];
    let end: u64 = inspect(&bytes, 8);
    transition end == 12305 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
