// A mutable recast writes a negative value through a signed view of an
// unsigned field: `&mut main.big as &mut i64` stores -7 — read back as
// u64, those bits are 18446744073709551609.
data Main {
    big: u64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.big = 0;
    let view: &mut i64 = &mut main.big as &mut i64;
    view = 0 - 7;
    transition main.big == 18446744073709551609 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
