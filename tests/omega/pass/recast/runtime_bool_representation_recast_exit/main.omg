// RUN CANARY (exit 70) + interpreter differential. `bool` is ordinary typed
// storage with the exact representation set {0, 1}: a shared view may forget
// that fact (`&u8` reads the stored byte), a byte whose data `where` fact
// bounds it to {0, 1} may establish it for a shared `&bool` view, and a
// mutable alias is legal when both sides preserve the same set, as the byte's
// fact and `bool` do.
//
// The revoked spelling also aliased the Boolean field mutably as
// `&mut u8 [0..=1]`. A local reference cannot spell a range, so its only
// canonical target is an unconstrained `&mut u8`, which could store 2 into
// the Boolean; `fail/recast/recast_mut_bool_as_unconstrained_byte` pins that
// rejection instead.
use omega_language_std::console;
use omega::language::core::binding;

data Main
where
    byte >= 0 && byte <= 1,
{
    console: Binding<Console>;
    flag: bool;
    byte: u8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.flag = true;
    main.byte = 1;
    let flag_bits: &u8 = &main.flag as &u8;
    let byte_flag: &bool = &main.byte as &bool;
    transition flag_bits == 1 && byte_flag {
        true -> mutate(main)
        _ -> bad(main)
    }

    state mutate(main: &mut Main) {
        let byte_flag: &mut bool = &mut main.byte as &mut bool;
        byte_flag = false;
        transition main.flag && main.byte == 0 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
