// RUN CANARY (exit 70) + interpreter differential. `bool` is ordinary typed
// storage with the exact representation set {0, 1}: a shared view may forget
// that fact, a typed {0,1} byte may establish it for a shared view, and mutable
// aliases are legal only when both sides preserve the same set.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    flag: bool;
    byte: u8 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.flag = true;
    main.byte = 1;
    let flag_bits: &u8 = &main.flag as &u8;
    let byte_flag: &bool = &main.byte as &bool;
    transition flag_bits == 1 && byte_flag {
        true -> mutate(main)
        _ -> bad(main)
    }

    state mutate(main: &mut Main) {
        let flag_bits: &mut u8 [0..=1] = &mut main.flag as &mut u8;
        flag_bits = 0;
        let byte_flag: &mut bool = &mut main.byte as &mut bool;
        byte_flag = false;
        transition !main.flag && main.byte == 0 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
