use omega::language::core::layout;
// Expected exit: 0. A typed-cell re-view composes its signed byte encoding
// with the unsigned observation, rather than narrowing the logical i64 directly.


SignedByte satisfies FixedLayout<NarrowByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}


data NarrowByte [copy] where -128 <= value, value <= 127 { value: i64; }
data ByteView { value: u8; }
data Main { encoded: LayoutStorage<NarrowByte, SignedByte>; }

machine read(value: &u8) -> u8 { value }
machine identity(value: &u8) -> &u8 { value }
machine write(value: &mut u8) { value = 255u8; }

machine Main::main(main: &mut Main) crashes Trap {
    main.encoded.value = -9i64;
    let view: &mut ByteView = &mut main.encoded as &mut ByteView;
    let before: u8 = read(&view.value);
    write(&mut view.value);
    let returned: &u8 = identity(&view.value);
    let after: u8 = read(returned);
    transition before == 247u8 && after == 255u8 && main.encoded.value == -1i64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
