// A bool may be viewed as a byte: `&flag as &u8` reads the 0/1 storage —
// bool's {0,1} value space makes every bit pattern meaningful, so no `where`
// is needed on the target.
data Main {
    flag: bool;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.flag = true;
    transition (&main.flag as &u8) == 1 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
