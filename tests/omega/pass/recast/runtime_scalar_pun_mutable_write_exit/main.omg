use omega::language::core::float_operations;

// RUN CANARY (exit 70) + interpreter differential. A fact-free equal-width
// mutable scalar recast keeps address identity: writing the u32 IEEE-754 bit
// pattern 0x3F800000 through the view makes the f32 source read as 1.0, and a
// subsequent view read still observes the raw bits. This distinguishes write-through
// from the shared scalar recast's content snapshot.
use omega::language::std::console;

data Main {
    console: Console;
    value: f32;
}

machine Main::main(&mut self) {
    self.value = 0.0f32;
    let view: &mut u32 = &mut self.value as &mut u32;
    view = 1065353216;
    transition self.value == 1.0f32 && view == 1065353216 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
