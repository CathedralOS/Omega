// Expected exit: 0
data Storage { value: u32; }
domain Storage::Issued established by issue;
machine issue(value: u32) -> Storage in Issued { Storage { value: value } }
data Holder { slot: Storage in Issued; }
machine preserve(storage: &write Storage in Issued) {}
machine update(holder: &write Holder) { preserve(&write holder.slot); }
machine main() crashes Trap {
    let mut holder: Holder = Holder { slot: issue(0) };
    update(&write holder);
    transition holder.slot.value == 0 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
