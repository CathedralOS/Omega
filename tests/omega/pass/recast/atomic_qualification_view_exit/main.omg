// Expected exit: 0
// Forgetting a vacuous label preserves declaration-owned atomic operations.
data Cell { value: AtomicU64; }
domain Cell::Label;
machine make() -> Cell in Cell::Label { Cell { value: 31 } }
machine main() crashes Trap {
    let cell: Cell in Cell::Label = make();
    let shared: &Cell = (&cell) as &Cell;
    shared.value.store(47, NoOrdering);
    let observed_atomic_observed: u64 = shared.value.load(NoOrdering);
    let observed: u64 in Wrapping = observed_atomic_observed as u64 in Wrapping;
    transition observed == 47 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
