// An integer may be viewed through an equal-width float recast loan:
// `&bits as &f64` reinterprets a u64's pattern as an IEEE-754 value — the
// bit pattern of 1.0 reads back as exactly 1.0.
data Main {
    bits: u64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.bits = 4607182418800017408;
    transition (&main.bits as &f64) == 1.0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
