// Expected exit: 0
// Forgetting a label must retain an earlier representation view and its backing.
data Raw { bits: u64; }
data Signed { bits: i64; }
domain Signed::Label;
machine retain<'storage>(view: &'storage mut Signed in Signed::Label) -> &'storage mut Signed {
    view as &mut Signed
}
machine main() crashes Trap {
    let mut raw: Raw = Raw { bits: 17 };
    let first: &mut Signed = &mut raw as &mut Signed;
    let labelled: &mut Signed in Signed::Label = first as &mut Signed in Signed::Label;
    let second: &mut Signed = retain(labelled);
    second.bits = -1;
    transition raw.bits == 18446744073709551615 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
