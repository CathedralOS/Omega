// A mutable recast writes integer bits through a signed view of a float
// field: `&mut main.rate as &mut i64` stores the raw pattern
// 0x4008000000000000 — read back as f64 it is 3.0.
data Main {
    rate: f64;
    verdict: u64;
}

machine Main::main(main: &mut Main) {
    main.rate = 0.0;
    let view: &mut i64 = &mut main.rate as &mut i64;
    view = 4613937818241073152;
    transition main.rate == 3.0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
