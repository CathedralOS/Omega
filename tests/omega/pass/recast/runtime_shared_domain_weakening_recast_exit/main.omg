// RUN CANARY (exit 70) + interpreter differential. A shared recast may expose
// fewer facts: Narrow explicitly implies Wide, so the target view cannot admit
// any representation that the established source value did not already admit.
use omega_language_std::console;

domain u32::Wide
requires
    self <= 100;

domain u32::Narrow
requires
    self in u32::Wide;
    self <= 10;

data Main {
    console: Console;
    value: u32 in Narrow;
}

machine Main::main(&mut self) {
    let view: &u32 in Wide = &self.value as &u32;
    transition view == 0 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
