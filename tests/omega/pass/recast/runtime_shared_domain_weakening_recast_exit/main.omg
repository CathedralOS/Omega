// RUN CANARY (exit 70) + interpreter differential. A shared recast may expose
// fewer facts: Narrow explicitly implies Wide, so the target view cannot admit
// any representation that the established source value did not already admit.
use omega_language_std::console;

domain u32::Wide(value)
requires
    value <= 100;

domain u32::Narrow(value)
requires
    value in u32::Wide;
    value <= 10;

data Main {
    value: u32 in Narrow;
}

machine Main::main(main: &mut Main) reaches Console {
    let view: &u32 in Wide = &main.value as &u32;
    transition view == 0 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
