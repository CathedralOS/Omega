use omega::language::core::float_operations;

// RUN CANARY (exit 70) + interpreter differential. A mutable alias between
// established typed records may retain facts when both layouts have identical
// geometry and each corresponding leaf admits the same stored bit patterns.
// The field names deliberately differ: representation, not nominal spelling,
// owns the judgment.
use omega_language_std::console;
use omega::language::core::binding;

data SignedRecord {
    signed_value: i16 [0..=100];
    signed_tag: i16 [0..=2];
    enabled: bool;
    signed_ratio: f32 [0..=1];
}

data UnsignedRecord {
    unsigned_value: u16 [0..=100];
    unsigned_tag: u16 [0..=2];
    active: bool;
    unsigned_ratio: f32 [0..=1];
}

data Main {
    console: Binding<Console>;
    source: SignedRecord;
}

machine Main::main(&mut self) reaches Console {
    self.source.signed_value = 7;
    self.source.signed_tag = 2;
    let view: &mut UnsignedRecord =
        &mut self.source as &mut UnsignedRecord;
    view.unsigned_value = 99;
    view.active = true;
    // `view` holds an EXCLUSIVE loan of `self.source`, and exclusivity
    // prevents reading the original while that loan is live (ownership:
    // "&mut T | Exclusive observation and mutation" and "Exclusivity
    // prevents reading old contents through a second alias"). Reading both
    // spellings inside one guard did that, and only compiled because a plain
    // operand read bypassed the check that a call argument enforces -- so the
    // guard stopped compiling the moment `f32 ==` became a call to
    // `Float::equal`. Observing through the view FIRST ends the loan at its
    // last use, and the original is then read on its own authority. The
    // subject is unchanged: values written through the recast view are the
    // values the original reports.
    let seen_value: u16 = view.unsigned_value;
    let seen_tag: u16 = view.unsigned_tag;
    let seen_active: bool = view.active;
    let seen_ratio: f32 = view.unsigned_ratio;
    transition self.source.signed_value == 99
        && seen_value == 99
        && self.source.signed_tag == 2
        && seen_tag == 2
        && self.source.enabled
        && seen_active
        && seen_ratio == self.source.signed_ratio {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
