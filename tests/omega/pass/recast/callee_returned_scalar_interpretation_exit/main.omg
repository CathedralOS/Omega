// Expected exit: 0. Returned interpretation keeps the signed original cell.
data SignedHeader { value: i16; }
data UnsignedHeader { value: u16; }
data Main { header: SignedHeader; }
machine read(value: &u16) -> u16 { value }

machine unsigned_cell(value: &i16) -> &u16 {
    let view: &u16 = value as &u16;
    view
}

machine unsigned_view(header: &SignedHeader) -> &u16 {
    let view: &UnsignedHeader = header as &UnsignedHeader;
    let cell: &u16 = &view.value;
    cell
}

machine Main::main(main: &mut Main) crashes Trap {
    main.header.value = -1i16;
    let view: &u16 = unsigned_view(&main.header);
    let observed: u16 = read(view);
    let direct: &u16 = unsigned_cell(&main.header.value);
    let direct_observed: u16 = read(direct);
    transition observed == 65535u16 && direct_observed == 65535u16
        && main.header.value == -1i16 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
