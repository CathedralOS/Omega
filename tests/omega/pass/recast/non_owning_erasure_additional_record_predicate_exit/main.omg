// Expected exit: 0
data Storage { value: u32; }
domain Storage::Before(storage) requires storage.value == 0;
machine overwrite(storage: &write Storage in Before) {
    let view: &write Storage = storage as &write Storage;
    view.value = 73;
}
machine main() crashes Trap {
    let mut storage: Storage = Storage { value: 0 };
    overwrite(&write storage);
    transition storage.value == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
