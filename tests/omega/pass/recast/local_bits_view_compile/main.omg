// A recast view may name a local place, not only a member: `&v as
// &i64` reinterprets the `let`-bound u64's bits — locals recast like
// fields and elements.
data Main { verdict: u64; }

machine Main::main(main: &mut Main) {
    let v: u64 = 18446744073709551615;
    transition (&v as &i64) == 0 - 1 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.verdict = 70; }
    machine bad(main: &mut Main) { main.verdict = 71; }
}
