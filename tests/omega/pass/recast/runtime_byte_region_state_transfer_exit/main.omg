// Expected exit: 0. A recast keeps its byte-region backing across named states,
// both through an incoming owner and through a copied local descriptor.
use omega::language::core::layout;

data Record { number: i64; }
data RecordLayout {}
data RecordView { value: RecordLayout<Record>; }
data Host { bytes: [u8; 8]; }
data Window<'storage> { bytes: &'storage [u8; 8]; }

machine RecordLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 }
}

machine decode_record(value: &RecordLayout<Record>) -> i64 { value.number }
machine decode_view(view: &RecordView) -> i64 { decode_record(&view.value) }

machine read(host: &Host) -> i64 {
    let view: &RecordView = &host.bytes[0] as &RecordView;
    let number: i64 = view.value.number;
    transition number >= 0 { true -> decode(view) _ -> -1 }
    machine decode(view: &RecordView) -> i64 { transition { _ -> finish(view) } }
    machine finish(view: &RecordView) -> i64 { decode_view(view) }
}

machine read_owned() -> i64 {
    let host: Host = Host { bytes: [29, 0, 0, 0, 0, 0, 0, 0] };
    let view: &RecordView = &host.bytes[0] as &RecordView;
    let copied: &RecordView = view;
    transition copied.value.number >= 0 { true -> decode(copied) _ -> -1 }
    machine decode(view: &RecordView) -> i64 { transition { _ -> finish(view) } }
    machine finish(view: &RecordView) -> i64 { decode_view(view) }
}

machine read_stored() -> u64 {
    let bytes: [u8; 8] = [37, 0, 0, 0, 0, 0, 0, 0];
    let window: Window = Window { bytes: &bytes };
    let view: &u64 = &window.bytes[0] as &u64;
    transition { _ -> decode(view) }
    machine decode(value: &u64) -> u64 { value }
}

machine main() crashes Trap {
    let host: Host = Host { bytes: [17, 0, 0, 0, 0, 0, 0, 0] };
    let incoming: i64 = read(&host);
    let owned: i64 = read_owned();
    let stored: u64 = read_stored();
    transition incoming == 17 && owned == 29 && stored == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
