// Match arms yield references: `let selected: &i32 = match ...` binds a
// borrowed local chosen between two referents; the loan ends when a
// snapshot is read, freeing both sources for mutation.
machine read(value: &i32) -> i32 { value }

machine choose(first: &i32, second: &i32, take_first: bool) -> i32 {
    let selected: &i32 = match take_first {
        true -> first,
        _ -> second,
    };
    read(selected)
}

data Main {}

machine Main::main(main: &mut Main) crashes Trap {
    let mut first: i32 = 40;
    let mut second: i32 = 42;
    let from_first: i32 = choose(&first, &second, true);
    let from_second: i32 = choose(&first, &second, false);
    let selected: &i32 = match from_first == 40 {
        true -> &first,
        _ -> &second,
    };
    let observed: i32 = read(selected);
    first = 41;
    second = 43;
    transition observed == 40 && first == 41 && second == 43 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
