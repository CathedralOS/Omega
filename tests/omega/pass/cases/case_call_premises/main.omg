// Case-payload call premises inside `ensures`: `empty_only(...)` and
// `node_only(...)` carry `requires value in Tree::Empty` / `in
// Tree::Node`, and each ensures clause discharges the tag
// precondition on its literal or symbolic subject. Tag
// preconditions do not constrain common or payload field VALUES.
// `terminates;` stands alone as an axis declaration.
data Tree {
    marked: bool;
    case Empty;
    case Node(child: Tree);
}
machine empty_only(value: Tree) -> Tree
requires value in Tree::Empty
terminates
{ value }
machine node_only(value: Tree) -> Tree
requires value in Tree::Node
terminates
{ value }
machine concrete()
ensures empty_only(Tree::Empty { marked: true }) == empty_only(Tree::Empty { marked: true })
ensures node_only(Tree::Node { marked: true, child: Tree::Empty })
    == node_only(Tree::Node { marked: true, child: Tree::Empty })
{}
machine symbolic(value: Tree)
requires value in Tree::Empty
ensures empty_only(value) == empty_only(value)
{}
data Main {}
machine Main::main(main: &mut Main) { }
