// `case Integer(value: T) where T == i32` is refuted on `Value<bool>`, so a
// dispatch covering only `Boolean` is exhaustive without a `_` arm. Typing
// counts the refuted case as impossible; the terminal unit's closed-sum
// dispatch must roster the same possible cases, or the state planned no body
// ("unsupported tail: single guarded transition").
use omega_language_std::console;

data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let v: Value<bool> = Value::Boolean { value: true };
    transition v {
        Value::Boolean { value } -> done(main, value)
    }
    machine done(main: &mut Main, value: bool) {
        transition value == true {
            true -> good(main)
            _ -> bad(main)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
