// Case-subset domains count toward exhaustiveness: a PURE case
// union `requires command in Command::Move | Command::Say` declares
// a domain covering exactly those tags, so its arm plus the
// remaining case arms dispatch exhaustively — no `_` needed.
data Command {
    case None;
    case Quit;
    case Move(dx: i32);
    case Say(volume: i32);
}
domain Command::Interactive(command)
requires
    command in Command::Move | Command::Say;
data Main { cmd: Command; }
machine Main::main(main: &mut Main) {
    main.cmd = Command::Say { volume: 3 };
    transition main.cmd {
        Command::Interactive -> interactive()
        Command::None -> none_state()
        Command::Quit -> quit_state()
    }
    machine interactive() { }
    machine none_state() { }
    machine quit_state() { }
}
