// Match nested inside a record literal field, and match composed inside
// an operand chain: `(match ...) | (8u64 | 16u64)` evaluates the match
// once as one operand.
data Category { case Other; case Missing; }
data Record { category: Category; number: u64; }

machine record(code: u64) -> Record {
    match code {
        2 -> Record { category: Category::Missing, number: 7 },
        _ -> Record {
            category: match code { 3 -> Category::Missing, _ -> Category::Other },
            number: code
        }
    }
}

machine composed(flag: bool) -> u64 {
    (match flag {
        true -> 18446744073709551616 / 18446744073709551616
        false -> 7 / 2 * 2
    }) | (8u64 | 16u64)
}

data Main {}

machine Main::main(main: &mut Main) {
    let r: Record = record(3);
    transition r.number == 3 && composed(false) == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
