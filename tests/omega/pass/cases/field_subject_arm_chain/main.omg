// Case dispatch on a FIELD subject with three named-case arms and no
// authored `_`: the field place, the arm count, and the missing wildcard
// each used to matter; now the roster checks as an ordinary closed
// dispatch.
data Command {
    case A;
    case B;
    case C;
}

data Main { command: Command; }

machine Main::main(main: &mut Main) {
    main.command = Command::B;
    transition main.command {
        Command::A -> done()
        Command::B -> done()
        Command::C -> done()
    }
    machine done() {}
}
