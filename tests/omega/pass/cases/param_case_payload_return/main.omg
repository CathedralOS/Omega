// A returned case payload taken from an owned structural STATE
// PARAMETER: `pc_err` carries `kind: Kind` as a formal and returns
// `Res::Error { kind: kind }` — a formal is a Parameter source whose
// consumption is the call's own transfer (not a result-binding
// roster entry).
data Kind { case Other; case NotFound; }
data Res { case Error(kind: Kind); case Empty; }
data Probe { seen: i32; }
machine Probe::classify(probe: &mut Probe, flag: bool) -> Res {
    probe.seen = 1;
    transition flag {
        true -> pc_empty(probe)
        _ -> pc_err(probe, Kind::NotFound)
    }
    machine pc_empty(probe: &mut Probe) -> Res { Res::Empty }
    machine pc_err(probe: &mut Probe, kind: Kind) -> Res { Res::Error { kind: kind } }
}
data Main { probe: Probe; result: Res; }
machine Main::main(main: &mut Main) {
    main.result = Probe::classify(&mut main.probe, false);
    transition main.result {
        Res::Empty -> bad()
        _ -> good()
    }
    machine good() { }
    machine bad() { crash Trap; }
}
