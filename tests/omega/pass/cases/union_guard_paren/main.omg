// Decision 11: a parenthesized union of implicit case domains as the
// transition guard subject — `(main.cmd in Command::Quit | Command::Move)`
// is a tag-only test even for the payload-bearing `Move` arm.
data Command {
    case None;
    case Quit;
    case Move(dx: i32);
}

data Main { cmd: Command; }

machine Main::main(main: &mut Main) {
    main.cmd = Command::Move { dx: 2 };
    transition (main.cmd in Command::Quit | Command::Move) {
        (true) -> matched()
        _ -> missed()
    }
    machine matched() {}
    machine missed() {}
}
