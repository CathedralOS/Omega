// A bare machine call names the machine rather than its entry state, and
// the claim a caller binds must not depend on that spelling: `pack`
// places its linear inputs in different fields on its two arms, and the
// caller still discharges every member through the external sink.
use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}

linux_x86_64 machine linux_x86_64_receipt_sink_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    }
}

linux_x86_64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via linux_x86_64_receipt_sink_binding();

data Pair {
    left: Receipt;
    right: Receipt;
}

machine pack(swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition swap {
        false -> (Pair { left: left, right: right })
        true -> (Pair { left: right, right: left })
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    let kept: Pair = pack(false, Receipt { code: 1 }, Receipt { code: 2 });
    let swapped: Pair = pack(true, Receipt { code: 3 }, Receipt { code: 4 });
    ReceiptSink::ack_leaf(kept.left);
    ReceiptSink::ack_leaf(kept.right);
    ReceiptSink::ack_leaf(swapped.left);
    ReceiptSink::ack_leaf(swapped.right);
}
