use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "arm_field_placement");
    builder.freestanding = true;

 Build::bind<Receipt::ack>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    });
}
