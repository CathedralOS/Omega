use omega::language::core::float_operations;

machine identity(value: f32) -> f32 { value }

// Call-result patterns: `identity(first)` in arm position matches when the
// subject equals that call's result — ordered first-match with `_` fallback.
machine choose(value: f32, first: f32, second: f32) -> u64 {
    match identity(value) {
        identity(first) -> 7,
        identity(second) -> 9,
        _ -> 11
    }
}

machine main() -> u64 {
    let hit: u64 = choose(2.0f32, 2.0f32, 2.0f32);
    let miss: u64 = choose(3.0f32, 1.0f32, 2.0f32);
    let zeros: u64 = choose(-0.0f32, 0.0f32, 0.0f32);
    let total: u64 = hit + miss + zeros;
    transition { _ -> total }
}
