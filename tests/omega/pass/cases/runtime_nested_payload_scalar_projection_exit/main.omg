// Expected exit: 0
// A scalar below a structural case payload retains every enclosing field and
// case coordinate, rather than interpreting its sum as a payload record.
data Details [copy] { prefix: u64; mode: u32; }
data Outcome [copy] { case Error; case Ok(details: Details); }
data Envelope [copy] { prefix: u64; outcome: Outcome; }

machine read_mode(envelope: Envelope) -> u32 {
    transition envelope.outcome {
        Outcome::Ok { details } -> (details.mode & 511)
        Outcome::Error -> 0
    }
}

data Nested [copy] { case Empty; case Present(envelope: Envelope); }
data ArrayEnvelope [copy] { prefix: u64; values: [Nested; 2]; }

machine read_nested(value: &ArrayEnvelope) -> u32 {
    transition value.values[1] {
        Nested::Present { envelope } -> nested_payload(envelope)
        Nested::Empty -> 0
    }
    machine nested_payload(envelope: Envelope) -> u32 {
        transition envelope.outcome {
            Outcome::Ok { details } -> (details.mode & 511)
            Outcome::Error -> 0
        }
    }
}

machine main() crashes Trap {
    let value: Envelope = Envelope {
        prefix: 85,
        outcome: Outcome::Ok { details: Details { prefix: 86, mode: 1444 } }
    };
    transition read_mode(value) == 420 {
        true -> nested(value)
        false -> bad()
    }
    machine nested(value: Envelope) {
        let array_envelope: ArrayEnvelope = ArrayEnvelope {
            prefix: 87,
            values: [Nested::Empty, Nested::Present { envelope: value }]
        };
        transition read_nested(&array_envelope) == 420 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
