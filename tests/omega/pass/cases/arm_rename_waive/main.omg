// Arm-position record binding shares the LET record-pattern grammar:
// `dx as step` renames the binding, `dy as _` waives the field, and
// `..` opts out of the exhaustiveness law outright. The `if` guard and
// target arguments see the renamed binding.
domain i32::Step(value) requires 0 <= value && value <= 50;

data Msg {
    case Move(dx: i32 in Step, dy: i32 in Step);
    case Stop(code: i32);
}

data Main {}

machine Main::main(main: &mut Main) {
    Main::apply(main, Msg::Move { dx: 30, dy: 40 });
    Main::rest(main, Msg::Move { dx: 10, dy: 20 });
}

machine Main::apply(main: &mut Main, m: Msg) {
    transition m {
        Msg::Move { dx as step, dy as _ } if step == 30 -> good(step)
        _ -> bad()
    }
    machine good(step: i32 in Step) {}
    machine bad() {}
}

machine Main::rest(main: &mut Main, m: Msg) {
    transition m {
        Msg::Move { dx as step, .. } if step == 10 -> good(step)
        _ -> bad()
    }
    machine good(step: i32 in Step) {}
    machine bad() {}
}
