data Choice [copy] { case Value(value: i32); case Empty; }
data Context { choice: Choice; first: i32; second: i32; third: i32; }
machine produce(value: i32) -> Choice { Choice::Value { value: value } }
machine computed(context: &mut Context) crashes Trap {
 transition produce(-7) {
  Choice::Empty -> bad()
  Choice::Value { value } -> save(context, value as i32 in Wrapping)
 }
 machine save(context: &mut Context, value: i32 in Wrapping) { context.first = value as i32; context.choice = Choice::Value { value: value as i32 }; }
 machine bad() { crash Trap; }
}
machine parameter(context: &mut Context, choice: Choice) crashes Trap {
 transition choice {
  Choice::Value { value } -> save(context, (value as i32 in Saturating) as i32 in Wrapping)
  Choice::Empty -> bad()
 }
 machine save(context: &mut Context, value: i32 in Wrapping) { context.second = value as i32; context.choice = Choice::Value { value: value as i32 }; }
 machine bad() { crash Trap; }
}
machine local(context: &mut Context) crashes Trap {
 let choice: Choice = produce(9);
 transition choice {
  Choice::Empty -> bad()
  Choice::Value { value } -> save(context, value as i32 in Wrapping)
 }
 machine save(context: &mut Context, value: i32 in Wrapping) { context.third = value as i32; context.choice = Choice::Value { value: value as i32 }; }
 machine bad() { crash Trap; }
}
machine main(context: &mut Context) crashes Trap {
 computed(context);
 parameter(context, Choice::Value { value: 8 });
 local(context);
 transition context.first == -7 && context.second == 8 && context.third == 9 { true -> field(context) _ -> bad() }
 machine field(context: &Context) {
 transition context.choice {
  Choice::Value { value } -> verify(value as i32 in Wrapping)
  Choice::Empty -> bad()
 }
 }
 machine verify(value: i32 in Wrapping) {
  transition value == 9 { true -> done() _ -> bad() }
 }
 machine done() {}
 machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
