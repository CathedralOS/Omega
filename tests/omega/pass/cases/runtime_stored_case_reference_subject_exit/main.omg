// Expected exit: 0
data Message { case Active(value: u32); case Empty; }
data Envelope { stamp: u32; message: &Message; }

machine identity<'input>(message: &'input Message) -> &'input Message { message }
machine active(message: &Message) -> bool { message in Message::Active }
machine computed(message: &Message) -> u32 {
    match identity(message) {
        Message::Active { value } -> value
        Message::Empty -> 0
    }
}
machine stored(envelope: &Envelope) -> u32 {
    match envelope.message {
        Message::Active { value } -> value
        Message::Empty -> 0
    }
}
machine exercise() -> bool {
    let message: Message = Message::Active { value: 73 };
    let envelope: Envelope = Envelope { stamp: 19, message: &message };
    let first: u32 = computed(&message);
    let second: u32 = stored(&envelope);
    let empty: Message = Message::Empty;
    let missing: u32 = computed(&empty);
    first == 73 && second == 73 && envelope.stamp == 19 && active(&message) && missing == 0
}
machine main() crashes Trap {
    transition exercise() { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
