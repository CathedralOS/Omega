// A mixed record carries common fields beside its cases: 	oken.start
// reads like a record field on every case, while a payload field is
// observed through its case step.
data Kind [copy] { case A; case B; }
data Token [copy] where start <= 100, end <= 100 {
    start: u64;
    end: u64;
    case Word;
    case Mark(kind: Kind);
}
data Stream { tokens: [Token; 8]; }

machine classify(stream: &Stream, at: u64) -> u64
requires at < 8
ensures result <= 100
{
    let token: Token = stream.tokens[at];
    transition token {
        Token::Mark { start as _, end as _, kind: Kind::B } -> (token.start)
        Token::Word -> (token.end)
        Token::Mark { start as _, end as _, kind: Kind::A } -> (token.end)
        _ -> (0)
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    let mut stream: Stream;
    stream.tokens[2] = Token::Mark { kind: Kind::B };
    stream.tokens[2].start = 30;
    stream.tokens[3] = Token::Word;
    stream.tokens[3].end = 25;
    transition classify(&stream, 2) == 30 && classify(&stream, 3) == 25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
