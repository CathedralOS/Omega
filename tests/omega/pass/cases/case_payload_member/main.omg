// Case arms READ a bound record payload's member field:
// `Shape::Boxed { inner } -> emit(main, inner.x)` — the nested read
// resolves through a copy of the record member staged under the
// selecting case edge.
data Inner {
    x: i32 in Wrapping;
}
data Shape {
    case Circle(r: i32 in Wrapping);
    case Boxed(inner: Inner);
}
data Main { seen: i32; }

machine Main::run(main: &mut Main, s: Shape) {
    transition s {
        Shape::Circle { r } -> emit(main, r * 7)
        Shape::Boxed { inner } -> emit(main, inner.x)
    }
    machine emit(main: &mut Main, v: i32 in Wrapping) {
        main.seen = v as i32;
    }
}
machine Main::main(main: &mut Main) {
    Main::run(main, Shape::Boxed { inner: Inner { x: 70 } });
}
