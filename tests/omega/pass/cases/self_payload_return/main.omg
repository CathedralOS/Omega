// A two-case transition where BOTH arms return their own case's
// payload: each case edge binds its payload and the arm returns it —
// one structural split.
data Sum {
    case Left(v: u64);
    case Right(w: u64);
}

machine Sum::pick(sum: &Sum) -> u64 {
    transition sum {
        Sum::Left { v } -> (v)
        Sum::Right { w } -> (w)
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    let left: Sum = Sum::Left { v: 41 };
    let right: Sum = Sum::Right { w: 29 };
    transition Sum::pick(&left) == 41 && Sum::pick(&right) == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
