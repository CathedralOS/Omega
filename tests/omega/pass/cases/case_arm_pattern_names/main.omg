domain i32::Step(value) requires 0 <= value && value <= 50;

data Msg {
    case Move(dx: i32 in Step, dy: i32 in Step);
    case Stop(code: i32) where code >= -100 && code <= 100;
}

machine apply(m: Msg) -> i32 ensures result >= -100 && result <= 140 {
    transition m {
        Msg::Move { dx as step, dy as _ } if step == 30 -> hit(step)
        Msg::Move { dx as _, .. } -> miss()
        Msg::Stop { code } -> stopped(code)
    }

    machine hit(step: i32 in Step) -> i32 {
        let code: i32 = step + 40;
        transition { _ -> code }
    }

    machine miss() -> i32 {
        transition { _ -> -1 }
    }

    machine stopped(code: i32) -> i32 requires code >= -100 && code <= 100 {
        transition { _ -> code }
    }
}

machine main() -> i32 {
    let moved: i32 = apply(Msg::Move { dx: 30, dy: 40 });
    let stopped: i32 = apply(Msg::Stop { code: 5 });
    let sum: i32 = moved + stopped;
    transition { _ -> sum }
}
