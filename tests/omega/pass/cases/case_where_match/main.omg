// Under the `Interval::Range` arm the selected case's `where` fact
// (`lo <= hi`) is a branch-local proposition on the exact subject,
// so the target state's `requires lo <= hi` proves at arrival with
// no extra evidence. The destructured bindings rewrite to
// `main.interval.lo`/`.hi` — the contributed fact carries that
// canonical identity.
data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { interval: Interval; }
machine Main::main(main: &mut Main) {
    transition main.interval {
        Interval::Range { lo, hi } -> take(lo, hi)
        Interval::Empty -> done()
    }
    machine take(lo: u64, hi: u64)
    requires
        lo <= hi
    {
    }
    machine done() { }
}
