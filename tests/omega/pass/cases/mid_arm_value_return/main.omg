// A guarded transition roster whose MID-CHAIN arm returns a value:
// `true -> bounds, false -> (0), _ -> (0)` — the checked plan carries
// each arm's outcome (Successor or Return) and emission mints the
// return arm's private block on its own guard decision.
data Probe { enabled: bool; limit: u64; }

machine Probe::classify(probe: &Probe, value: u64) -> u64 {
    let ready: bool = probe.enabled;
    transition ready {
        true -> bounds(probe, value)
        false -> (0)
        _ -> (0)
    }
    machine bounds(probe: &Probe, value: u64) -> u64 {
        transition value < probe.limit {
            true -> (1)
            _ -> (0)
        }
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    let probe: Probe = Probe { enabled: true, limit: 10 };
    let class: u64 = Probe::classify(probe, 5);
    transition class == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
