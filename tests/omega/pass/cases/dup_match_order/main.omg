// Repeated value patterns retain authored first-match order: the second
// `0` arm is unreachable but compiles — first match wins.
machine choose(subject: u64) -> u64 {
    match subject {
        0 -> 7,
        0 -> 99,
        _ -> 9
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    transition choose(0) == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
