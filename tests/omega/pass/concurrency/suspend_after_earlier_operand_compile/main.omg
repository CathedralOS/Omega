use omega::language::core::service;
data Cell {
    value: i32;
}

data Message {
    body: &Cell;
}

pub boundary trait Scheduler {
    machine park() -> i32 suspends;
}

data Main {
    scheduler: Binding<Scheduler>;
    cell: Cell;
}

machine Main::read(&mut self, cell: &Cell) -> i32 {
    transition { _ -> cell.value }
}

machine Main::main(&mut self) suspends; reaches Scheduler {
    let message: Message = Message { body: &self.cell };
    let prior: i32 = self.read(message.body);
    let parked: i32 = suspend self.scheduler.park();
    let values: [i32; 2] = [prior, parked];
}
