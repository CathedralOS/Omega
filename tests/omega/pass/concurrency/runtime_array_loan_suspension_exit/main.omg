
pub boundary trait Scheduler {
    machine read(references: &[&i32; 2]) -> i64 suspends;
}

data InlineScheduler {}
machine InlineScheduler::read(references: &[&i32; 2]) -> i64
satisfies Scheduler::read {
    (references[0] as i64) + (references[1] as i64)
}

machine observe(reference: &i32) -> i32 { reference }
machine read_at(references: &[&i32; 2], selected: u64 [0..=1]) -> i32 {
    references[selected]
}

data Main { }
machine Main::main(main: &mut Main) reaches Scheduler crashes Trap {
    let first: i32 = 42;
    let second: i32 = 19;
    let references: [&i32; 2] = [&first, &second];
    let result: i64 = suspend Scheduler::read(&references);
    let first_observation: i32 = observe(references[0]);
    let second_observation: i32 = observe(references[1]);
    let selected_observation: i32 = read_at(&references, 1);
    transition result == 61 && first_observation == 42
        && second_observation == 19 && selected_observation == 19 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
