
pub boundary trait Scheduler {
    machine read(carrier: &Envelope<&i32>, nested: &Envelope<&i32>) -> i64 suspends;
}

data InlineScheduler {}
machine InlineScheduler::read(carrier: &Envelope<&i32>, nested: &Envelope<&i32>) -> i64
satisfies Scheduler::read {
    (carrier.first as i64) + (carrier.second as i64)
        + (nested.first as i64) + (nested.second as i64)
}

pub data Envelope<T> { marker: i32; first: T; second: T; }
data Wrapper<T> { padding: i32; payload: T; }
machine produce<'storage>(first: &'storage i32, second: &'storage i32)
-> Envelope<&'storage i32> {
    Envelope { marker: 7, first: first, second: second }
}
machine observe(reference: &i32) -> i32 { reference }

data Main { }
machine Main::main(main: &mut Main) reaches Scheduler crashes Trap {
    let first: i32 = 42;
    let second: i32 = 19;
    let carrier: Envelope<&i32> = produce(&first, &second);
    let projected: &i32 = produce(&first, &second).second;
    let wrapped: Wrapper<Envelope<&i32>> = Wrapper {
        padding: 11,
        payload: produce(&first, &second)
    };
    let result: i64 = suspend Scheduler::read(&carrier, &wrapped.payload);
    let first_observation: i32 = observe(carrier.first);
    let second_observation: i32 = observe(carrier.second);
    let nested_observation: i32 = observe(wrapped.payload.second);
    let projected_observation: i32 = observe(projected);
    transition result == 122 && carrier.marker == 7
        && wrapped.padding == 11
        && first_observation == 42 && second_observation == 19
        && nested_observation == 19 && projected_observation == 19 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
