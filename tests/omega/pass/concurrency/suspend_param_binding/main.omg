// Suspend through an exact boundary-trait requirement:
// `inspect(message) suspends; reaches Scheduler` — the explicit message
// parameter stops contributing after its last field read, then
// `suspend Scheduler::park()` parks.
//
//   * `boundary data Lease` opaque boundary payload.
//   * `machine inspect(...) suspends;` on an ordinary
//     machine — no carrier needed.
//
// Compile-checked only: no provider selection at --check.

boundary data Lease;

data Message {
    lease: Lease;
    value: i32;
}

public boundary trait Scheduler { machine park() reaches suspends; }

machine inspect(message: Message)
suspends; reaches Scheduler {
    let value: i32 = message.value;
    suspend Scheduler::park();
}

machine main() {}
