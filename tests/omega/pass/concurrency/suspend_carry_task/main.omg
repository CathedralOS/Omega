// Suspend-carry surface (consumer side): a `suspends;` machine body
// suspends through a boundary machine and a `Token in
// Carry::AcrossSuspend` value survives the suspend edge.
public boundary data Sleeper;
boundary machine Sleeper::park(token: i32) suspends;
public data Token {
    id: u64;
}
data Worker { }
machine Worker::run(token: Token in Carry::AcrossSuspend) -> Token suspends; {
    let carried: Token = token;
    suspend Sleeper::park(7);
    carried
}
data Main {
}
machine Main::main(main: &mut Main) { }
