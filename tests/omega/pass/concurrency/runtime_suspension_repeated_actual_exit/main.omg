
public boundary trait Scheduler {
    machine advance(first: i32, second: i32, left: Marker, right: Marker) -> i32 reaches suspends;
}

public data Marker [copy] { value: i32; }

InlineSchedulerImplementation satisfies Scheduler {
    machine advance(first: i32, second: i32, left: Marker, right: Marker) -> i32 {
        first
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Scheduler crashes Trap {
    let value: i32 = 42;
    let marker: Marker = Marker { value: 19 };
    let result: i32 = suspend Scheduler::advance(value, value, marker, marker);
    transition result == 42 && marker.value == 19 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Scheduler crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
