
pub boundary trait Scheduler {
    machine advance(first: i32, second: i32, left: Marker, right: Marker) -> i32 suspends;
}

pub data Marker [copy] { value: i32; }

data InlineScheduler {}

machine InlineScheduler::advance(first: i32, second: i32, left: Marker, right: Marker) -> i32
    satisfies Scheduler::advance {
    first
}

data Main {
}

machine Main::main(main: &mut Main) reaches Scheduler crashes Trap {
    let value: i32 = 42;
    let marker: Marker = Marker { value: 19 };
    let result: i32 = suspend Scheduler::advance(value, value, marker, marker);
    transition result == 42 && marker.value == 19 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

InlineSchedulerImplementation satisfies Scheduler {
    Scheduler::advance = InlineScheduler::advance;
}
