use omega::language::core::drop;

// A possibly-suspending requirement may complete inline. Its call still needs
// an exact suspension crossing; this is not a park/resume runtime witness.
pub boundary trait Scheduler {
    machine advance(value: i32, inventory: Inventory) -> i32 suspends;
}

data InlineScheduler {}
machine InlineScheduler::advance(value: i32, inventory: Inventory) -> i32
satisfies Scheduler::advance
{
    drop(inventory);
    value
}

pub data Inventory [linear] { value: i32; }
machine Inventory::drop(inventory: &mut Inventory) {}
machine Inventory::forward(inventory: Inventory) -> Inventory { inventory }
machine observe(value: &i32) -> bool { value == 40 }
machine replace(value: &mut i32) { value = 47; }
data Marker { value: i32; }
data Main { }
machine Main::main(main: &mut Main) reaches Scheduler crashes Trap {
    transition { _ -> work(main, 39) }
    state work(main: &mut Main, mut input: i32) {
        input = 40;
        let marker: Marker = Marker { value: 19 };
        let alias: i32 = input;
        let preserved: i32 = marker.value;
        let addressed: i32 = input;
        let observed: bool = observe(&addressed);
        let mut mutable: i32 = 31;
        replace(&mut mutable);
        let inventory: Inventory = Inventory { value: 19 };
        let transferred: Inventory = Inventory::forward(inventory);
        let retained: Inventory = Inventory { value: 23 };
        let result: i32 = suspend Scheduler::advance(input + 2, transferred);
        let retained_value: i32 = retained.value;
        drop(retained);
        transition result == 42 && input == 40 && alias == 40 && preserved == 19 && marker.value == 19 && retained_value == 23 && observed && addressed == 40 && mutable == 47 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
