// An empty stored extent contributes no loan or carry demand.
data Empty [carry(suspension: allowed, cpu: any, thread: any, address: movable)] {
    elements: [&i32; 0];
    marker: i32;
}

data Portable<T [carry(suspension: allowed, cpu: any, thread: any, address: movable)]>
[carry(suspension: allowed, cpu: any, thread: any, address: movable)] {
    payload: T;
}

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let portable: Portable<Empty> = Portable {
        payload: Empty { elements: [], marker: 42 },
    };
    transition portable.payload.marker == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
