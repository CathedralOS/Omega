// An explicit parameter stops contributing after its last field read:
// `message` is consumed for `value` before the suspend edge, so only
// the scalar crosses — the record needs no suspend carry.
use omega::language::core::binding;
boundary data Lease;
data Message {
    lease: Lease;
    value: i32;
}
pub boundary trait Scheduler { machine park() suspends; }
machine inspect(message: Message, scheduler: Binding<Scheduler>)
suspends; reaches Scheduler {
    let value: i32 = message.value;
    suspend scheduler.park();
}
data Main { }
machine Main::main(main: &mut Main) { }
