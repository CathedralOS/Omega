
boundary data Lease;

data Message {
    lease: Lease;
    value: i32;
}
pub boundary trait Scheduler { machine park() suspends; }

// The same explicit parameter stops contributing after its last field read.
machine inspect(message: Message)
suspends; reaches Scheduler {
    let value: i32 = message.value;
    suspend Scheduler::park();
}

machine main() {}
