
boundary data Lease;

data Cell {
    value: i32;
}

data Message {
    body: &Cell;
}

pub boundary trait Scheduler {
    machine park() suspends;
}

data Main {
    cell: Cell;
}

machine read(cell: &Cell) -> i32 {
    transition { _ -> cell.value }
}

// The record's borrowed member contributes until its last read; the lease
// operand stops contributing when the call transfers it.
machine inspect(message: Message, lease: Lease) suspends; reaches Scheduler {
    let value: i32 = read(message.body);
    suspend Scheduler::park();
}

machine Main::main(main: &mut Main) suspends; reaches Scheduler {
    let message: Message = Message { body: &main.cell };
    let value: i32 = read(message.body);
    suspend Scheduler::park();
}
