// The raw destination stays fixed. Emit all storage (including the untouched
// tail), the next unread byte, then expose the stop reason/count in the exit.
use omega_language_std::console;

data Main {
    line: [u8; 4];
}

machine Main::main(main: &mut Main)
reaches Console
{
    main.line[0] = 165;
    main.line[1] = 165;
    main.line[2] = 165;
    main.line[3] = 165;
    let empty: LineReadResult = block Console::read_line(&mut main.line[0..0]);
    transition empty {
        LineReadResult::Full { count } -> empty_result(main, count)
        _ -> invalid(main)
    }
    state empty_result(main: &mut Main, count: u64) {
        transition count == 0 { true -> read(main) false -> invalid(main) }
    }
    state read(main: &mut Main) {
        let result: LineReadResult = block Console::read_line(&mut main.line);
        transition result {
            LineReadResult::LineComplete { count } -> report(main, 10, count)
            LineReadResult::EndOfInput { count } -> report(main, 20, count)
            LineReadResult::Full { count } -> report(main, 30, count)
            LineReadResult::Invalid -> invalid(main)
        }
    }
    state report(main: &mut Main, reason: i32, count: u64)
    requires 0 <= reason && reason <= 100
    {
        Console::write(&main.line);
        let next: ByteRead = block Console::read_byte();
        transition next {
            ByteRead::Byte { value } -> suffix(main, reason, count, value)
            ByteRead::Eof -> done(main, reason, count)
        }
    }
    state suffix(main: &mut Main, reason: i32, count: u64, value: i32)
    requires 0 <= reason && reason <= 100 && 0 <= value && value <= 255
    {
        Console::write_byte(value);
        transition { _ -> done(main, reason, count) }
    }
    state done(main: &mut Main, reason: i32, count: u64)
    requires 0 <= reason && reason <= 100
    {
        // `LineReadResult.count` is an unbounded u64: the contract carries no
        // upper bound, so the exact `i32` cast needs a dominating premise.
        // The four-byte line caps count at 4; `finish` declares that bound.
        transition count <= 4 {
            true -> finish(main, reason, count)
            _ -> invalid(main)
        }
    }
    state finish(main: &mut Main, reason: i32, count: u64)
    requires 0 <= reason && reason <= 100 && count <= 4
    {
        Console::exit_process(reason + count as i32);
    }
    state invalid(main: &mut Main) { Console::exit_process(99); }
}

// Reuse a middle window: the second read resumes after Full and leaves the
// previous suffix intact. The outer bytes are never part of either loan.
machine Main::repeat(main: &mut Main)
reaches Console
{
    main.line[0] = 165;
    main.line[1] = 165;
    main.line[2] = 165;
    main.line[3] = 165;
    let first: LineReadResult = block Console::read_line(&mut main.line[1..3]);
    transition first {
        LineReadResult::Full { count } -> first_count(main, count)
        _ -> invalid(main)
    }
    state first_count(main: &mut Main, count: u64) {
        transition count == 2 { true -> again(main) false -> invalid(main) }
    }
    state again(main: &mut Main) {
        Console::write(&main.line);
        let second: LineReadResult = block Console::read_line(&mut main.line[1..3]);
        transition second {
            LineReadResult::LineComplete { count } -> completed(main, count)
            _ -> invalid(main)
        }
    }
    state completed(main: &mut Main, count: u64) {
        Console::write(&main.line);
        transition count == 1 { true -> done(main) false -> invalid(main) }
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state invalid(main: &mut Main) { Console::exit_process(99); }
}
