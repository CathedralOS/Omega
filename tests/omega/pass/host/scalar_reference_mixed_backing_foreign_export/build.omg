use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "scalar_reference_mixed_backing_foreign_export");
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind<Compare::compare>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5",
    } });
}
