machine build(builder: &mut Build) {
    builder.application("runtime_console_bounded_line_middle_window_exit");
    builder.depend(Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::repeat);
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::repeat);
    builder.roots.bind(linux_arm64::ProgramEntry, Main::repeat);
    builder.roots.bind(macos_arm64::ProgramEntry, Main::repeat);
    builder.roots.bind(macos_x86_64::ProgramEntry, Main::repeat);
}
