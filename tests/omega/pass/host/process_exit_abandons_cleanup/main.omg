// Expected exit: 0. Expected output contains: P
// Argument construction runs, but no following effect runs after the canonical
// domain-ending invocation. A nominally owned temporary supplies its status.
use omega::language::core::drop;
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega_language_std::console;
data Note { status: i32; }
machine Note::drop(note: &mut Note) {
    note.status = 99;
}
machine make_note() -> Note reaches Console {
    Console::write_line("P");
    Note { status: 0 }
}
machine main() reaches Console + ProcessExit {
    let remaining: Note = Note { status: 0 };
    ProcessExit::exit_process(make_note().status);
    Console::write_line("unreachable");
}
