// Each returning arm owns a distinct uninspected result from its second read.
use omega::language::core::service;
use omega_language_std::console;

data Main {
    console: Service<Console>;
}

machine Main::main(&mut self)
reaches Console
{
    let first: ByteRead = block self.console.read_byte();
    transition first {
        ByteRead::Byte { value } -> byte(value)
        ByteRead::Eof -> eof()
    }

    state byte(&mut self, value: i32) {
        self.console.write_byte(value);
        let second: ByteRead = block self.console.read_byte();
    }

    state eof(&mut self) {
        let second: ByteRead = block self.console.read_byte();
    }
}
