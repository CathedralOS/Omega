use omega::language::core::binding;
use omega::language::core::external_binding;

pub boundary trait DescriptorIo {
    machine read(descriptor: i32, words: &mut [u16; 3], count: u64) -> i64 blocks;
    machine write(descriptor: i32, words: &[u16; 3], count: u64) -> i64;
}
pub data DescriptorImports {}
pub data Receipt [copy] { moved: i64; }
data Main { io: Binding<DescriptorIo>; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}

pub linux_x86_64 machine linux_x86_64_read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

pub linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine DescriptorImports::read(descriptor: i32, words: &mut [u16; 3], count: u64) -> i64
    satisfies DescriptorIo::read via read_binding();

linux_x86_64 boundary machine DescriptorImports::read(descriptor: i32, words: &mut [u16; 3], count: u64) -> i64
    satisfies DescriptorIo::read via linux_x86_64_read_binding();
macos_arm64 boundary machine DescriptorImports::write(descriptor: i32, words: &[u16; 3], count: u64) -> i64
    satisfies DescriptorIo::write via write_binding();

linux_x86_64 boundary machine DescriptorImports::write(descriptor: i32, words: &[u16; 3], count: u64) -> i64
    satisfies DescriptorIo::write via linux_x86_64_write_binding();

machine receive(io: &Binding<DescriptorIo>, words: &mut [u16; 3]) -> Receipt reaches DescriptorIo blocks; {
    transition { _ -> read(io, words) }
    state read(io: &Binding<DescriptorIo>, words: &mut [u16; 3]) {
        let moved: i64 = block io.read(0, words, 6);
        Receipt { moved: moved }
    }
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    let mut words: [u16; 3] = [21845, 21845, 11442];
    let receipt: Receipt = block receive(&main.io, &mut words);
    let at_end: i64 = block main.io.read(0, &mut words, 6);
    let written: i64 = main.io.write(1, &words, 4);
    transition receipt.moved == 4 && at_end == 0 && written == 4
        && words[0] == 25185 && words[1] == 2659 && words[2] == 11442 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
