// The import accesses only header bytes. Stored reference custody and the
// scalar after that pointer-sized hole remain with the original record.
// Lend the header prefix explicitly: an opaque writer must not receive mutable
// authority over the stored reference or the atomic fields beyond that prefix.
use omega::language::core::external_binding;

pub data Cell { value: u64; counter: AtomicU64; }
pub data Header { value: u64; }
pub data Packet { header: Header; reference: &Cell; counter: AtomicU64; tail: u64; }
pub boundary trait DescriptorIo {
    machine read(descriptor: i32, packet: &mut Header, count: u64) -> i64 blocks;
    machine write(descriptor: i32, packet: &Packet, count: u64) -> i64;
}
pub data DescriptorImports {}
data Main { cell: Cell; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}

pub linux_x86_64 machine linux_x86_64_read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

pub linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine DescriptorImports::read(descriptor: i32, packet: &mut Header, count: u64) -> i64
    satisfies DescriptorIo::read via read_binding();

linux_x86_64 boundary machine DescriptorImports::read(descriptor: i32, packet: &mut Header, count: u64) -> i64
    satisfies DescriptorIo::read via linux_x86_64_read_binding();
macos_arm64 boundary machine DescriptorImports::write(descriptor: i32, packet: &Packet, count: u64) -> i64
    satisfies DescriptorIo::write via write_binding();

linux_x86_64 boundary machine DescriptorImports::write(descriptor: i32, packet: &Packet, count: u64) -> i64
    satisfies DescriptorIo::write via linux_x86_64_write_binding();

machine receive(packet: &mut Header, count: u64) -> i64
    reaches DescriptorIo blocks; {
    block DescriptorIo::read(0, packet, count)
}

machine publish(cell: &Cell) {
    cell.counter.store(23, NoOrdering);
}

machine observe(cell: &Cell) -> u64 in Wrapping {
    let resident: u64 in Wrapping = cell.counter.load(NoOrdering);
    transition { _ -> (resident) }
}

machine publish_packet(packet: &Packet) {
    packet.counter.store(11, NoOrdering);
}

machine observe_packet(packet: &Packet) -> u64 in Wrapping {
    let resident: u64 in Wrapping = packet.counter.load(NoOrdering);
    transition { _ -> (resident) }
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    main.cell.value = 31;
    let packet: Packet = Packet { header: Header { value: 16706 }, reference: &main.cell, counter: 7, tail: 29 };
    let before: i64 = DescriptorIo::write(1, &packet, 1);
    let zero: i64 = block receive(&mut packet.header, 0);
    let moved: i64 = block receive(&mut packet.header, 1);
    let saved: u64 = packet.header.value;
    let after: i64 = DescriptorIo::write(1, &packet, 1);
    let line: i64 = block receive(&mut packet.header, 1);
    let end: i64 = block receive(&mut packet.header, 1);
    let newline: i64 = DescriptorIo::write(1, &packet, 1);
    publish(packet.reference);
    let resident: u64 in Wrapping = observe(&main.cell);
    let untouched: u64 in Wrapping = observe_packet(&packet);
    publish_packet(&packet);
    let published: u64 in Wrapping = observe_packet(&packet);
    transition before == 1 && zero == 0 && moved == 1 && after == 1
        && line == 1 && end == 0 && newline == 1 && saved == 16707
        && packet.header.value == 16650 && packet.reference.value == 31 && packet.tail == 29
        && resident == 23 && untouched == 7 && published == 11 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
