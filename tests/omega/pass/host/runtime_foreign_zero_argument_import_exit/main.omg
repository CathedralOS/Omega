use omega::language::core::presentation_authority;
use omega::language::core::time_authority;
use omega::language::core::native_execution_authority;
use omega::language::core::filesystem_authority;
use omega::language::core::process_authority;
use omega::language::core::process_exit;
// Expected Windows exit: 70. Exercise a returning import without pointer arguments.
use omega_language_std::console;
use omega_language_std::windows_gui_host;

data Main { }
machine Main::main(main: &mut Main) reaches
    Console + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    GlobalInputObservation + ClockObservation + ExecutionDelay +
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit {
    let foreground: u64 = WindowsGuiHost::foreground_window();
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches
    Console + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    GlobalInputObservation + ClockObservation + ExecutionDelay +
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
