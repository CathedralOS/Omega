use omega::language::core::WindowManagement;
use omega::language::core::SurfacePresentation;
use omega::language::core::WindowEventObservation;
use omega::language::core::WindowEventDispatch;
use omega::language::core::GlobalInputObservation;
use omega::language::core::ClockObservation;
use omega::language::core::ExecutionDelay;
use omega::language::core::NativeCodeExecution;
use omega::language::core::FilesystemContentRead;
use omega::language::core::FilesystemContentWrite;
use omega::language::core::FilesystemMetadataQuery;
use omega::language::core::FilesystemMetadataMutation;
use omega::language::core::DirectoryEnumeration;
use omega::language::core::FilesystemNamespaceMutation;
use omega::language::core::ProcessInput;
use omega::language::core::ProcessOutput;
use omega::language::core::ProcessExit;
// Expected Windows exit: 70. Exercise a returning import without pointer arguments.
use omega_language_std::Console;
use omega_language_std::WindowsGuiHost;

data Main { }
machine Main::main(main: &mut Main) reaches
    Console + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    GlobalInputObservation + ClockObservation + ExecutionDelay +
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit {
    let foreground: u64 = WindowsGuiHost::foreground_window();
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches
    Console + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    GlobalInputObservation + ClockObservation + ExecutionDelay +
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
