// Direct array-to-view transport and a projected scalar loan use the same
// foreign ABI as forwarded views and whole scalar locals. Readonly writes
// must leave the source field, including bytes beyond the count, unchanged.
use omega::language::core::external_binding;

public data DescriptorProbe { }
public boundary requirement DescriptorProbe::write_bytes(descriptor: i32, bytes: &[u8]) -> i64;
public boundary requirement DescriptorProbe::write_word(descriptor: i32, word: &u32, count: u64) -> i64;
data DescriptorImports { }
data Header { word: u32; }


machine main() crashes Trap {
    let output: [u8; 4] = [100, 105, 114, 10];
    let header: Header = Header { word: 112u32 | (10u32 << 8) | (85u32 << 16) };
    let first: i64 = DescriptorProbe::write_bytes(1, &output);
    let second: i64 = DescriptorProbe::write_word(2, &header.word, 2);
    let third: i64 = DescriptorProbe::write_bytes(1, &output[1..4]);
    transition first == 4 && second == 2 && third == 3 && output[0] == 100
        && header.word == (112u32 | (10u32 << 8) | (85u32 << 16)) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
