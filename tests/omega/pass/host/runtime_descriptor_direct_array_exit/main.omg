// Each entry uses its exact native calling policy and the same write/backing oracle.
// The two ordinary entry bodies differ only in their concrete native ABI facet.
use omega_language_std::calling;
use omega_language_std::posix_byte_view_calling;

public boundary trait LinuxDescriptorProbe: Calling<SystemVByteViewCalling> {
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
    machine write_word(descriptor: i32, word: &u32, count: u64) -> i64 reaches;
}
public boundary trait DarwinDescriptorProbe: Calling<DarwinArm64ByteViewCalling> {
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
    machine write_word(descriptor: i32, word: &u32, count: u64) -> i64 reaches;
}
data Header { word: u32; }

machine linux_main() crashes Trap {
    let output: [u8; 4] = [100, 105, 114, 10];
    let header: Header = Header { word: 112u32 | (10u32 << 8) | (85u32 << 16) };
    let first: i64 = LinuxDescriptorProbe::write_bytes(1, &output);
    let second: i64 = LinuxDescriptorProbe::write_word(2, &header.word, 2);
    let third: i64 = LinuxDescriptorProbe::write_bytes(1, &output[1..4]);
    transition first == 4 && second == 2 && third == 3 && output[0] == 100
        && header.word == (112u32 | (10u32 << 8) | (85u32 << 16)) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine darwin_main() crashes Trap {
    let output: [u8; 4] = [100, 105, 114, 10];
    let header: Header = Header { word: 112u32 | (10u32 << 8) | (85u32 << 16) };
    let first: i64 = DarwinDescriptorProbe::write_bytes(1, &output);
    let second: i64 = DarwinDescriptorProbe::write_word(2, &header.word, 2);
    let third: i64 = DarwinDescriptorProbe::write_bytes(1, &output[1..4]);
    transition first == 4 && second == 2 && third == 3 && output[0] == 100
        && header.word == (112u32 | (10u32 << 8) | (85u32 << 16)) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
