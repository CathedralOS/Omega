use omega_language_std::console;

machine payload(observed: ByteRead) -> u8 {
    transition observed {
        ByteRead::Byte { value } -> store(value)
        ByteRead::Eof -> 0
    }
    state store(value: i32) -> u8 requires value >= 0, value <= 255 {
        value as u8
    }
}
machine is_byte(observed: &ByteRead) -> bool {
    transition observed {
        ByteRead::Byte { value as _ } -> true
        ByteRead::Eof -> false
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let zero: ByteRead = ByteRead::Byte { value: 0 };
    let maximum: ByteRead = ByteRead::Byte { value: 255 };
    let absent: ByteRead;
    let zero_is_byte: bool = is_byte(&zero);
    let absent_is_byte: bool = is_byte(&absent);
    let zero_value: u8 = payload(zero);
    let maximum_value: u8 = payload(maximum);
    transition zero_is_byte && !absent_is_byte && zero_value == 0 && maximum_value == 255 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
