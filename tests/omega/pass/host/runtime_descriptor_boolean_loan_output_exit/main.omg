use omega::language::core::external_binding;

public boundary trait ScalarOutput {
    machine flag(descriptor: i32, value: &bool, count: u64) -> i64 reaches;
    machine byte(descriptor: i32, value: &u8, count: u64) -> i64 reaches;
}
public data ScalarImports {}
data Main { }

public macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

public linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine ScalarImports::flag(descriptor: i32, value: &bool, count: u64) -> i64
    satisfies ScalarOutput::flag via write_binding();

linux_x86_64 boundary machine ScalarImports::flag(descriptor: i32, value: &bool, count: u64) -> i64
    satisfies ScalarOutput::flag via linux_x86_64_write_binding();
macos_arm64 boundary machine ScalarImports::byte(descriptor: i32, value: &u8, count: u64) -> i64
    satisfies ScalarOutput::byte via write_binding();

linux_x86_64 boundary machine ScalarImports::byte(descriptor: i32, value: &u8, count: u64) -> i64
    satisfies ScalarOutput::byte via linux_x86_64_write_binding();

machine set(value: &mut bool) { value = true; }
machine emit(value: &bool) -> i64 reaches ScalarOutput {
    transition { _ -> write(value) }
    state write(value: &bool) {
        ScalarOutput::flag(1, value, 1)
    }
}
machine Main::main(main: &mut Main) reaches ScalarOutput crashes Trap {
    let mut flag: bool = false;
    set(&mut flag);
    let written: i64 = emit(&flag);
    let mut newline: u8 = 10;
    let ended: i64 = ScalarOutput::byte(1, &newline, 1);
    transition flag && written == 1 && ended == 1 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ScalarOutput crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
