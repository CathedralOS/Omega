use omega::language::core::external_binding;

public boundary trait ScalarOutput {
    machine flag(descriptor: i32, value: &bool, count: u64) -> i64 reaches;
    machine byte(descriptor: i32, value: &u8, count: u64) -> i64 reaches;
}
public data ScalarImports {}
data Main { }


machine set(value: &mut bool) { value = true; }
machine emit(value: &bool) -> i64 reaches ScalarOutput {
    transition { _ -> write(value) }
    machine write(value: &bool) -> i64 {
        ScalarOutput::flag(1, value, 1)
    }
}
machine Main::main(main: &mut Main) reaches ScalarOutput crashes Trap {
    let mut flag: bool = false;
    set(&mut flag);
    let written: i64 = emit(&flag);
    let mut newline: u8 = 10;
    let ended: i64 = ScalarOutput::byte(1, &newline, 1);
    transition flag && written == 1 && ended == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ScalarOutput crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
