// A foreign read borrows the record itself, not a copied field or byte view.
use omega::language::core::external_binding;

public data Words [copy] { first: u32; second: u32; }
public boundary trait DescriptorIo {
    machine read(descriptor: i32, words: &mut Words, count: u64) -> i64 reaches blocks;
    machine write(descriptor: i32, words: &Words, count: u64) -> i64 reaches;
}
public data DescriptorImports {}
data Holder { prefix: u32; words: Words; suffix: u32; }
data Main { holder: Holder; }


machine receive(words: &mut Words, count: u64) -> i64
    reaches DescriptorIo blocks; {
    block DescriptorIo::read(0, words, count)
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    main.holder.prefix = 17;
    main.holder.words.first = 287454020;
    main.holder.words.second = 1144201745;
    main.holder.suffix = 29;
    let zero: i64 = block receive(&mut main.holder.words, 0);
    let moved: i64 = block receive(&mut main.holder.words, 7);
    let at_end: i64 = block receive(&mut main.holder.words, 8);
    let written: i64 = DescriptorIo::write(1, &main.holder.words, 4);
    transition zero == 0 && moved == 4 && at_end == 0 && written == 4
        && main.holder.words.first == 174285409
        && main.holder.words.second == 1144201745
        && main.holder.prefix == 17 && main.holder.suffix == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches DescriptorIo blocks; crashes Trap {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
