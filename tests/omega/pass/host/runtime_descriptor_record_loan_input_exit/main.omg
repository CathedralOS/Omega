// A foreign read borrows the record itself, not a copied field or byte view.
use omega::language::core::binding;
use omega::language::core::external_binding;

pub data Words [copy] { first: u32; second: u32; }
pub boundary trait DescriptorIo {
    machine read(descriptor: i32, words: &mut Words, count: u64) -> i64 blocks;
    machine write(descriptor: i32, words: &Words, count: u64) -> i64;
}
pub data DescriptorImports {}
data Holder { prefix: u32; words: Words; suffix: u32; }
data Main { io: Binding<DescriptorIo>; holder: Holder; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}

pub linux_x86_64 machine linux_x86_64_read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

pub linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine DescriptorImports::read(descriptor: i32, words: &mut Words, count: u64) -> i64
    satisfies DescriptorIo::read via read_binding();

linux_x86_64 boundary machine DescriptorImports::read(descriptor: i32, words: &mut Words, count: u64) -> i64
    satisfies DescriptorIo::read via linux_x86_64_read_binding();
macos_arm64 boundary machine DescriptorImports::write(descriptor: i32, words: &Words, count: u64) -> i64
    satisfies DescriptorIo::write via write_binding();

linux_x86_64 boundary machine DescriptorImports::write(descriptor: i32, words: &Words, count: u64) -> i64
    satisfies DescriptorIo::write via linux_x86_64_write_binding();

machine receive(io: &Binding<DescriptorIo>, words: &mut Words, count: u64) -> i64
    reaches DescriptorIo blocks; {
    block io.read(0, words, count)
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    main.holder.prefix = 17;
    main.holder.words.first = 287454020;
    main.holder.words.second = 1144201745;
    main.holder.suffix = 29;
    let zero: i64 = block receive(&main.io, &mut main.holder.words, 0);
    let moved: i64 = block receive(&main.io, &mut main.holder.words, 7);
    let at_end: i64 = block receive(&main.io, &mut main.holder.words, 8);
    let written: i64 = main.io.write(1, &main.holder.words, 4);
    transition zero == 0 && moved == 4 && at_end == 0 && written == 4
        && main.holder.words.first == 174285409
        && main.holder.words.second == 1144201745
        && main.holder.prefix == 17 && main.holder.suffix == 29 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
