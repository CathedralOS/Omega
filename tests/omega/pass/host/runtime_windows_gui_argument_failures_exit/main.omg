// Expected Windows exit: 70. Unterminated/empty C strings refuse creation;
// NULL is never a live window and cannot be successfully destroyed.
use omega_language_std::windows_gui_host;
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console + WindowsGuiHost {
    let empty: u64 = WindowsGuiHost::window_create("", "\0", 0, 0, 0, 20, 20);
    let class_name: u64 = WindowsGuiHost::window_create("STATIC", "\0", 0, 0, 0, 20, 20);
    let title: u64 = WindowsGuiHost::window_create("STATIC\0", "unterminated", 0, 0, 0, 20, 20);
    let alive: bool = WindowsGuiHost::is_window(0);
    let destroyed: bool = WindowsGuiHost::window_destroy(0);
    transition empty == 0 && class_name == 0 && title == 0 && !alive && !destroyed {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
