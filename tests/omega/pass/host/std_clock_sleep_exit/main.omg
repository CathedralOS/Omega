// The canonical std `Clock::sleep` blocks its caller and then returns: the
// program sleeps 200 milliseconds through the selected std Clock provider and
// then exits 70. Reaching the exit proves the hosted sleep returned; the
// process's wall time must cover the requested 200 milliseconds.
// Expected exit: 70.
use omega_language_std::console;
use omega_language_std::clock;

data Main {
}

machine Main::main(context: &mut Main) reaches Console + Clock {
    Clock::sleep(200);
    Console::exit_process(70);
}
