use omega::language::core::binding;
use omega::language::core::external_binding;

pub data Packet { value: AtomicU32; neighbor: u32; }
pub data Header { prefix: u32; tail: AtomicU32; }
pub boundary trait DescriptorIo {
    machine read(descriptor: i32, packet: &mut Packet, count: u64) -> i64 blocks;
    machine write(descriptor: i32, packet: &mut Packet, count: u64) -> i64;
    machine write_header(descriptor: i32, header: &Header, count: u64) -> i64;
}
pub data DescriptorImports {}
data Holder { prefix: u32; packet: Packet; suffix: u32; }
data Main { io: Binding<DescriptorIo>; holder: Holder; header: Header; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}

pub linux_x86_64 machine linux_x86_64_read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

pub linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
pub macos_arm64 machine header_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

pub linux_x86_64 machine linux_x86_64_header_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine DescriptorImports::read(descriptor: i32, packet: &mut Packet, count: u64) -> i64
    satisfies DescriptorIo::read via read_binding();

linux_x86_64 boundary machine DescriptorImports::read(descriptor: i32, packet: &mut Packet, count: u64) -> i64
    satisfies DescriptorIo::read via linux_x86_64_read_binding();
macos_arm64 boundary machine DescriptorImports::write(descriptor: i32, packet: &mut Packet, count: u64) -> i64
    satisfies DescriptorIo::write via write_binding();

linux_x86_64 boundary machine DescriptorImports::write(descriptor: i32, packet: &mut Packet, count: u64) -> i64
    satisfies DescriptorIo::write via linux_x86_64_write_binding();
macos_arm64 boundary machine DescriptorImports::write_header(descriptor: i32, header: &Header, count: u64) -> i64
    satisfies DescriptorIo::write_header via header_binding();

linux_x86_64 boundary machine DescriptorImports::write_header(descriptor: i32, header: &Header, count: u64) -> i64
    satisfies DescriptorIo::write_header via linux_x86_64_header_binding();

machine receive(io: &Binding<DescriptorIo>, packet: &mut Packet, count: u64) -> i64
    reaches DescriptorIo blocks; {
    block io.read(0, packet, count)
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    main.holder.prefix = 17;
    main.holder.packet.value.store(287454020, NoOrdering);
    main.holder.packet.neighbor = 1144201745;
    main.holder.suffix = 29;
    main.header.prefix = 2625;
    main.header.tail.store(77, NoOrdering);
    let zero: i64 = block receive(&main.io, &mut main.holder.packet, 0);
    let moved: i64 = block receive(&main.io, &mut main.holder.packet, 7);
    let at_end: i64 = block receive(&main.io, &mut main.holder.packet, 8);
    let observed: u32 = main.holder.packet.value.fetch_or(0, NoOrdering);
    let written: i64 = main.io.write(1, &mut main.holder.packet, 2);
    let prefix_written: i64 = main.io.write_header(1, &main.header, 2);
    let tail: u32 = main.header.tail.load(NoOrdering);
    transition zero == 0 && moved == 2 && at_end == 0 && written == 2
        && observed == 287443521 && prefix_written == 2 && tail == 77
        && main.holder.packet.neighbor == 1144201745
        && main.holder.prefix == 17 && main.holder.suffix == 29 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
