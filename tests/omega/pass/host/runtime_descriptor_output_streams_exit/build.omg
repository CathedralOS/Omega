use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_descriptor_output_streams_exit");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::bind(builder, macos_arm64::ProgramEntry, darwin_main);
    Build::bind(builder, linux_x86_64::ProgramEntry, linux_main);
    Build::bind<LinuxDescriptorProbe::write_bytes>(builder, linux_x86_64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
        } });
    Build::bind<DarwinDescriptorProbe::write_bytes>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
        } });
    Build::bind<LinuxDescriptorProbe::write_word>(builder, linux_x86_64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
        } });
    Build::bind<DarwinDescriptorProbe::write_word>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
        } });
}
