// Exact descriptor calls preserve borrowed extents, stream separation and
// ordering across differently typed import slots. No process-exit authority
// is needed: a normal Unit entry returns zero after checking write results.
use omega::language::core::external_binding;

pub data DescriptorProbe { }
// A byte view supplies the two native words (pointer, length) of write's
// buffer and count. A primitive loan supplies only its pointer, so that
// declaration carries the separate bounded count.
pub boundary requirement DescriptorProbe::write_bytes(descriptor: i32, bytes: &[u8]) -> i64;
pub boundary requirement DescriptorProbe::write_word(descriptor: i32, word: &u32, count: u64) -> i64;
data DescriptorImports { }

macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 machine DescriptorImports::write_bytes(descriptor: i32, bytes: &[u8]) -> i64
    satisfies DescriptorProbe::write_bytes via write_binding();

linux_x86_64 machine DescriptorImports::write_bytes(descriptor: i32, bytes: &[u8]) -> i64
    satisfies DescriptorProbe::write_bytes via linux_x86_64_write_binding();
macos_arm64 machine DescriptorImports::write_word(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies DescriptorProbe::write_word via write_binding();

linux_x86_64 machine DescriptorImports::write_word(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies DescriptorProbe::write_word via linux_x86_64_write_binding();

machine emit_bytes(descriptor: i32, bytes: &[u8]) -> bool {
    let written: i64 = DescriptorProbe::write_bytes(descriptor, bytes);
    written == 4
}

machine main() crashes Trap {
    let output: [u8; 4] = [111, 117, 116, 10];
    let error: [u8; 4] = [101, 114, 114, 10];
    let word: u32 = 111u32 | (107u32 << 8) | (10u32 << 16);
    let first: bool = emit_bytes(1, &output);
    let second: bool = emit_bytes(2, &error);
    let written: i64 = DescriptorProbe::write_word(1, &word, 3);
    transition first && second && written == 3 && output[0] == 111 && error[0] == 101 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
