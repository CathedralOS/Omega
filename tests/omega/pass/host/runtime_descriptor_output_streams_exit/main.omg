// Each entry uses its exact native calling policy and the same write/backing oracle.
// The two ordinary entry bodies differ only in their concrete native ABI facet.
use omega_language_std::calling;
use omega_language_std::posix_byte_view_calling;

public boundary trait LinuxDescriptorProbe: Calling<SystemVByteViewCalling> {
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
    machine write_word(descriptor: i32, word: &u32, count: u64) -> i64 reaches;
}
public boundary trait DarwinDescriptorProbe: Calling<DarwinArm64ByteViewCalling> {
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
    machine write_word(descriptor: i32, word: &u32, count: u64) -> i64 reaches;
}

machine linux_emit_bytes(descriptor: i32, bytes: &[u8]) -> bool {
    let written: i64 = LinuxDescriptorProbe::write_bytes(descriptor, bytes);
    written == 4
}

machine linux_main() crashes Trap {
    let output: [u8; 4] = [111, 117, 116, 10];
    let error: [u8; 4] = [101, 114, 114, 10];
    let word: u32 = 111u32 | (107u32 << 8) | (10u32 << 16);
    let first: bool = linux_emit_bytes(1, &output);
    let second: bool = linux_emit_bytes(2, &error);
    let written: i64 = LinuxDescriptorProbe::write_word(1, &word, 3);
    transition first && second && written == 3 && output[0] == 111 && error[0] == 101 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine darwin_emit_bytes(descriptor: i32, bytes: &[u8]) -> bool {
    let written: i64 = DarwinDescriptorProbe::write_bytes(descriptor, bytes);
    written == 4
}

machine darwin_main() crashes Trap {
    let output: [u8; 4] = [111, 117, 116, 10];
    let error: [u8; 4] = [101, 114, 114, 10];
    let word: u32 = 111u32 | (107u32 << 8) | (10u32 << 16);
    let first: bool = darwin_emit_bytes(1, &output);
    let second: bool = darwin_emit_bytes(2, &error);
    let written: i64 = DarwinDescriptorProbe::write_word(1, &word, 3);
    transition first && second && written == 3 && output[0] == 111 && error[0] == 101 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
