// Expected exit: 0
use omega_language_std::macos_gui;
use omega_language_std::console;

macos_arm64 machine main()
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit + Console
{
    let class_name: [u8; 7] = "#32770\0";
    let title: [u8; 12] = "Omega reach\0";
    let window: Window = macos_window_create(class_name, &title[0], 0, 0, 0, 96, 96);
    transition window.window != 0 {
        true -> present(window)
        false -> failed(window)
    }

    machine present(mut window: Window) {
        let mut pixels: [i32; 4];
        pixels[0] = 16711680;
        pixels[1] = 65280;
        pixels[2] = 255;
        pixels[3] = 16777215;
        let copied: u32 = macos_window_present(&window, 2, 2, &mut pixels[..4]);
        let available: u32 = macos_window_msg_peek(&mut window, [0, 0, 0, 0, 0, 0]);
        let dispatched: u64 = macos_window_msg_dispatch(&window, [0, 0, 0, 0, 0, 0]);
        let visible: u32 = macos_window_is_window(&window, window.window);
        let observed: u64 = macos_perf_counter();
        let key: u64 = macos_key_state(27);
        macos_sleep(0);
        macos_window_destroy(window);
        transition copied == 2 && visible != 0 && observed > 0 {
            true -> passed()
            false -> rejected()
        }
    }

    machine failed(window: Window) {
        macos_window_destroy(window);
        Console::exit_process(70);
    }
    machine passed() { Console::exit_process(0); }
    machine rejected() { Console::exit_process(71); }
}