// Canonical `ProcessExit::exit_process` behind ordered console output and a
// conditional helper chain, observed natively and by the checked interpreter.
//
// `Main` declares `reaches Console + ProcessExit`: Console grants output
// authority only, and the terminal outcome still passes through the exact
// canonical ProcessExit requirement with its exact i32 status. The ordered
// `write_line` bytes precede the terminal event; the conditional helper
// states each exit with their own exact status and no continuation runs.
//
// Both legs exit 70 after printing exactly one line; `Console` and
// `ProcessExit` are separate provider-backed carriers on the same root.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega_language_std::console;

data Main {
}

machine dbl(x: i32) -> i32
requires
    0 <= x && x <= 1000;
{
    transition { _ -> (x + x) }
}

machine pick(x: i32) -> i32
requires
    0 <= x && x <= 1000;
{
    transition x > 50 {
        true -> (dbl(x))
        _ -> (x)
    }
}

machine Main::main(main: &mut Main)
reaches
    Console + ProcessExit
{
    let hot: i32 = pick(60);
    Console::write_line("process-exit canary");
    transition hot == 120 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        ProcessExit::exit_process(70);
    }

    state bad(main: &mut Main) {
        ProcessExit::exit_process(1);
    }
}
