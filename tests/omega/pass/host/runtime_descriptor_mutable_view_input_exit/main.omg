// A foreign read borrows an existing window, never spare capacity. Direct and
// forwarded calls must write original storage without changing its extent.
use omega::language::core::external_binding;
use omega_language_std::calling;
use byte_view_calling;

public boundary trait DescriptorIo: Calling<ByteViewCallingPolicy> {
    machine read_bytes(descriptor: i32, bytes: &mut [u8]) -> i64 reaches blocks;
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
}
public data DescriptorImports { }
data Main { }


machine receive(main: &mut Main, bytes: &mut [u8]) -> i64 reaches DescriptorIo blocks; {
    block DescriptorIo::read_bytes(0, bytes)
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    let mut output: [u8; 7] = [60, 88, 88, 88, 88, 33, 10];
    let empty: i64 = block DescriptorIo::read_bytes(0, &mut output[7..7]);
    let received: i64 = block receive(main, &mut output[1..6]);
    let at_end: i64 = block DescriptorIo::read_bytes(0, &mut output[0..1]);
    let written: i64 = DescriptorIo::write_bytes(1, &output);
    transition empty == 0 && received == 4 && at_end == 0 && written == 7
        && output[0] == 60 && output[1] == 97 && output[2] == 98
        && output[3] == 99 && output[4] == 10 && output[5] == 33 && output[6] == 10 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches DescriptorIo blocks; crashes Trap {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
