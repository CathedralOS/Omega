machine build(builder: &mut Build) {
    Build::application(builder, "clock_explicit_override");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<omega_language_std::Clock, NoWaitClock>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, program);
    Build::select_provider<omega_language_std::Clock, NoWaitClock>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, program);
    Build::select_provider<omega_language_std::Clock, NoWaitClock>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, program);
    Build::select_provider<omega_language_std::Clock, NoWaitClock>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, program);
}
