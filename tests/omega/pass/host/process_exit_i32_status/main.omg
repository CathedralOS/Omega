// Canonical `ProcessExit::exit_process` i32 status through helper states.
//
// `Main` carries the single admitted ProcessExit service carrier; console I/O
// grants no exit authority and no console receiver participates here. The
// entry's declared `reaches ProcessExit` is the authored ceiling the checked
// body is verified against: each conditional helper branch terminates the
// containing process domain through the exact canonical requirement with its
// own exact i32 status, not through the transitional Console Unit call.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega::language::core::service;

data Main {
    exit: Service<ProcessExit>;
}

machine Main::main(&mut self)
reaches
    ProcessExit
{
    transition 120 == 120 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.exit.exit_process(70);
    }

    state bad(&mut self) {
        self.exit.exit_process(1);
    }
}
