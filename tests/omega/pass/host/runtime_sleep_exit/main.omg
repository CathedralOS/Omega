// Clock.sleep is a hosted millisecond sleep with target-specific realizations:
// Win32 Sleep, Linux nanosleep, and Darwin poll. It pauses with both an IMMEDIATE
// arg and a RUNTIME (field) arg, then exits 70; reaching `exit_process(70)` proves
// both call forms obey the selected hosted ABI and return cleanly.
use omega_language_std::console;
boundary trait Clock { machine sleep(milliseconds: u32); }
data Main { console: Console; clock: Clock; delay: u32 in Wrapping; }
machine Main::main(&mut self) {
    self.clock.sleep(2);
    self.delay = 1;
    self.clock.sleep(self.delay as u32);
    transition { _ -> done() }
    state done(&mut self) { self.console.exit_process(70); }
}
