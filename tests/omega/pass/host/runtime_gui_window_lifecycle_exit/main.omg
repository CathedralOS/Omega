// Expected Windows exit: 70. Create an invisible STATIC window, drain at
// most eight real thread messages through caller-owned MSG storage, then
// require IsWindow(live), successful destruction, and !IsWindow(destroyed).
use omega_language_std::console;
use omega_language_std::windows_gui_host;

data Main {
    cls: [u8; 7];
    title: [u8; 6];
    message: WindowsMessage;
    hwnd: u64;
    have: bool;
    drains: u32 in Wrapping;
    alive_before: bool;
    killed: bool;
    alive_after: bool;
}
machine Main::main(main: &mut Main)
reaches Console + WindowsGuiHost
{
    main.cls[0] = 83;
    main.cls[1] = 84;
    main.cls[2] = 65;
    main.cls[3] = 84;
    main.cls[4] = 73;
    main.cls[5] = 67;
    main.cls[6] = 0;
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 0;
    main.hwnd = WindowsGuiHost::window_create(&main.cls, &main.title, 0, 10, 10, 64, 64);
    main.drains = 0;
    transition main.hwnd > 0 { true -> drain_loop(main) _ -> bad(main) }
    state drain_loop(main: &mut Main) {
        transition main.drains < 8 { true -> drain_peek(main) _ -> liveness(main) }
    }
    state drain_peek(main: &mut Main) {
        main.have = WindowsGuiHost::pump_message(&mut main.message);
        main.drains = main.drains + 1;
        transition main.have { true -> drain_loop(main) _ -> liveness(main) }
    }
    state liveness(main: &mut Main) {
        main.alive_before = WindowsGuiHost::is_window(main.hwnd);
        transition main.alive_before { true -> destroy(main) _ -> bad(main) }
    }
    state destroy(main: &mut Main) {
        main.killed = WindowsGuiHost::window_destroy(main.hwnd);
        transition main.killed { true -> recheck(main) _ -> bad(main) }
    }
    state recheck(main: &mut Main) {
        main.alive_after = WindowsGuiHost::is_window(main.hwnd);
        transition !main.alive_after { true -> ok(main) _ -> bad(main) }
    }
    state ok(main: &mut Main)  { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
