// The window LIFECYCLE + MESSAGE PUMP proof: create a real (invisible, CI-safe) window, drain
// its message queue through PeekMessageW(PM_REMOVE) into a caller-owned [u64;6] MSG buffer (a
// fresh invisible window has ~1 pending message natively, 0 in the virtual host -- the drain is
// BOUNDED and its count deliberately unasserted), then assert the liveness transitions the probe
// pinned exactly: IsWindow(live) > 0, DestroyWindow > 0, IsWindow(destroyed) == 0. These five
// user32 imports (PeekMessageW/TranslateMessage/DispatchMessageW dispatch through the built-in
// STATIC class's DefWindowProc) are what make a long-lived window draggable and closable -- the
// standalone-app gap. The interpreter's virtual window system mints live handle tokens and
// mirrors the same liveness answers. Exit 70. Differential.
use omega_language_std::console;
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: [u8; 6], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64;
    machine msg_peek(message: [u64; 6]) -> u32;
    machine is_window(window: u64) -> u32;
    machine window_destroy(window: u64) -> u32;
}
data Main {
    cls: [u8; 7];
    title: [u8; 6];
    message: [u64; 6];
    hwnd: u64;
    have: u32;
    drains: u32 in Wrapping;
    alive_before: u32;
    killed: u32;
    alive_after: u32;
}
machine Main::main(main: &mut Main)
reaches Console, Gui
{
    main.cls[0] = 83;
    main.cls[1] = 84;
    main.cls[2] = 65;
    main.cls[3] = 84;
    main.cls[4] = 73;
    main.cls[5] = 67;
    main.cls[6] = 0;
    main.title[0] = 111;
    main.title[1] = 109;
    main.title[2] = 101;
    main.title[3] = 103;
    main.title[4] = 97;
    main.title[5] = 0;
    main.hwnd = Gui::window_create(main.cls, main.title, 0, 10, 10, 64, 64);
    main.drains = 0;
    transition main.hwnd > 0 { true -> drain_loop(main) _ -> bad(main) }
    state drain_loop(main: &mut Main) {
        transition main.drains < 8 { true -> drain_peek(main) _ -> liveness(main) }
    }
    state drain_peek(main: &mut Main) {
        main.have = Gui::msg_peek(main.message);
        main.drains = main.drains + 1;
        transition main.have > 0 { true -> drain_loop(main) _ -> liveness(main) }
    }
    state liveness(main: &mut Main) {
        main.alive_before = Gui::is_window(main.hwnd);
        transition main.alive_before > 0 { true -> destroy(main) _ -> bad(main) }
    }
    state destroy(main: &mut Main) {
        main.killed = Gui::window_destroy(main.hwnd);
        transition main.killed > 0 { true -> recheck(main) _ -> bad(main) }
    }
    state recheck(main: &mut Main) {
        main.alive_after = Gui::is_window(main.hwnd);
        transition main.alive_after == 0 { true -> ok(main) _ -> bad(main) }
    }
    state ok(main: &mut Main)  { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
