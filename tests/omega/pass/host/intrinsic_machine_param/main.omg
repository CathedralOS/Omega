
// A worker-execution provider bound by the compiler itself: `execute` is
// generic over a machine symbol and satisfies the trait row through
// `ForeignBinding::CompilerIntrinsic` — no authored body.
pub boundary trait WorkerProvider {
    machine execute<T, Arguments, machine Target>(
        arguments: Arguments
    ) -> T
    where machine Target(arguments: Arguments) -> T suspends; blocks;
    ensures true;
}

data IntrinsicWorkerProvider { }

machine IntrinsicWorkerProvider::execute<T, Arguments, machine Target>(
    arguments: Arguments
) -> T
where machine Target(arguments: Arguments) -> T suspends; blocks;
satisfies WorkerProvider::execute
via ForeignBinding::CompilerIntrinsic;

data Main {
}

machine Main::main(main: &mut Main) -> u64 {
    transition { _ -> 0 }
}
