use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_multiregister");
    builder.freestanding = true;

 Build::bind<IntegerDivision::divide>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_lldiv",
        },
    });
}
