// libc `lldiv` returns two 64-bit fields in separate Darwin result
// registers — the record result arrives as two i64 slots.
use omega::language::core::external_binding;

public data Division {
    quotient: i64;
    remainder: i64;
}
public boundary trait IntegerDivision {
    machine divide(numerator: i64, denominator: i64) -> Division reaches;
}


data Main {
    negative: Division;
}

machine Main::main(main: &mut Main) reaches IntegerDivision {
    main.negative = IntegerDivision::divide(-70000000000, 3);
}
