// Expected Windows exit: 70. Create an invisible system dialog window,
// call the real GetForegroundWindow, then destroy the owned window. The
// focused HWND is deliberately unasserted: CI may focus another application.
use omega_language_std::console;
use omega_language_std::windows_gui_host;

data Main {
    cls: [u8; 7];
    title: [u8; 10];
    hwnd: u64;
    fw: u64;
    killed: bool;
}
machine Main::main(main: &mut Main)
reaches Console + WindowsGuiHost
{
    // "#32770\0"
    main.cls[0] = 35; main.cls[1] = 51; main.cls[2] = 50; main.cls[3] = 55;
    main.cls[4] = 55; main.cls[5] = 48; main.cls[6] = 0;
    // "fgwin\0"
    main.title[0] = 102; main.title[1] = 103; main.title[2] = 119; main.title[3] = 105;
    main.title[4] = 110; main.title[5] = 0;
    main.hwnd = WindowsGuiHost::window_create(&main.cls, &main.title, 0, 10, 10, 50, 50);
    transition main.hwnd > 0 { true -> probe(main) _ -> bad(main, 71) }
    state probe(main: &mut Main) {
        main.fw = WindowsGuiHost::foreground_window();
        main.killed = WindowsGuiHost::window_destroy(main.hwnd);
        transition main.killed { true -> good(main) _ -> bad(main, 72) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
