pub boundary trait TextOutput { machine output_string(this: addr, text: &[u16; 19]); }
data EfiTextOutputProtocol { reset: addr; output_string: addr; }
uefi_x86_64 machine EfiTextOutputProtocol::text_output_leaf(this: addr, text: &[u16; 19]) satisfies TextOutput::output_string via ForeignBinding::VtableField(output_string);
pub data EfiSystemTable {
    hdr_signature: u64; hdr_revision: u32; hdr_header_size: u32; hdr_crc: u32; hdr_reserved: u32;
    firmware_vendor: addr; firmware_revision: u32; fw_pad: u32;
    console_in_handle: addr; con_in: addr; console_out_handle: addr; con_out: addr;
}
pub data Main { msg: [u16; 19]; }
boundary machine Main::main(main: &mut Main, handle: addr, table: &EfiSystemTable) -> i32
reaches TextOutput
invokes TextOutput;
{
    main.msg = utf16"Hello, Omega world!";
    TextOutput::output_string(table.con_out, &main.msg);
    transition { _ -> (0) }
}
