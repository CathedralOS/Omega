use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_foreign_scalar_loan_writeback_exit");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::bind<DescriptorIo::read>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "msvcrt.dll", export: "_read" },
    });
    Build::bind<DescriptorIo::write>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "msvcrt.dll", export: "_write" },
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
