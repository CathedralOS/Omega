// Exact descriptor imports borrow the original field/array cell through a
// helper. A short read preserves every byte beyond its transferred prefix.
use omega::language::core::external_binding;
use omega_language_std::console;

pub data DescriptorIo {}
pub boundary requirement DescriptorIo::read(descriptor: i32, buffer: &mut i32, count: u32) -> i32
reaches Console
blocks;
pub boundary requirement DescriptorIo::write(descriptor: i32, buffer: &i32, count: u32) -> i32
reaches Console;

windows_x86_64 machine read_binding() -> ForeignBinding<10, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "msvcrt.dll", export: "_read" },
    }
}
windows_x86_64 machine write_binding() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "msvcrt.dll", export: "_write" },
    }
}
data DescriptorImports {}
windows_x86_64 machine DescriptorImports::read(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    satisfies DescriptorIo::read via read_binding();
windows_x86_64 machine DescriptorImports::write(descriptor: i32, buffer: &i32, count: u32) -> i32
    satisfies DescriptorIo::write via write_binding();

machine receive(buffer: &mut i32, count: u32) -> i32 reaches Console blocks; {
    block DescriptorIo::read(0, buffer, count)
}

data Main { cell: i32; cells: [i32; 2]; }
machine Main::main(main: &mut Main) reaches Console {
    main.cell = 256;
    main.cells[0] = 7;
    main.cells[1] = 16909060;
    let mut local: [i32; 2] = [7, 256];
    let zero: i32 = block receive(&mut main.cell, 0);
    let first: i32 = block receive(&mut main.cell, 1);
    let local_zero: i32 = block receive(&mut local[1], 0);
    let stored: &mut i32 = &mut local[1];
    let local_count: i32 = block receive(stored, 1);
    let second: i32 = block receive(&mut main.cells[1], 4);
    let empty: i32 = block receive(&mut main.cell, 1);
    // Foreign and checked Console output share one ordered private sink.
    let written: i32 = DescriptorIo::write(1, &main.cell, 1);
    Console::write_byte(33);
    Console::write_byte(10);
    transition zero == 0 && first == 1 && local_zero == 0 && local_count == 1 && second == 1 && empty == 0 && written == 1
        && main.cell == 321 && local[0] == 7 && local[1] == 322
        && main.cells[0] == 7 && main.cells[1] == 16909066 {
        true -> done(main, 70)
        _ -> done(main, 71)
    }
    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
