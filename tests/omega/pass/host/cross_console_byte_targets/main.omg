// std Console BYTE OPS, natively (ByteRead has no sentinel):
// `read_byte()` mints `ByteRead::Byte { value }` per stdin byte and
// `ByteRead::Eof` at end-of-input -- Eof is ORDINAL 0, so the composite
// instruction's PRE-ZEROED result slot IS the Eof case (ZII: the read writes
// the payload byte + tag 1 only when a byte arrived; EOF leaves the zeroes).
// `write_byte(b)` writes the argument place's low byte to stdout (LE).
//
// The program echoes stdin while summing byte values, then exits 70 + sum:
//   empty stdin -> 70 (the Eof-first path; what the suite + differential run)
//   "AB"        -> 70 + 65 + 66 = 201, stdout "AB" (the suite pipes this)
use omega::language::std::console;

data Main {
    console: Console;
    sum: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.sum = 70 as i32 in Wrapping;
    transition { _ -> rd() }

    state rd(&mut self) {
        let r: ByteRead = self.console.read_byte();
        transition r {
            ByteRead::Byte { value } -> acc(value)
            _ -> fin()
        }
    }

    state acc(&mut self, value: i32) {
        let b: i32 in Wrapping = value as i32 in Wrapping;
        self.sum = self.sum + b;
        self.console.write_byte(value);
        transition { _ -> rd() }
    }

    state fin(&mut self) {
        self.console.exit_process(self.sum as i32);
    }
}
