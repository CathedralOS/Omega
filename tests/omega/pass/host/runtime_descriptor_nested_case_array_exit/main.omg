use omega::language::core::binding;
use omega::language::core::external_binding;
use omega_language_std::calling;
use byte_view_calling;

pub data Bytes { values: [u8; 4]; }
pub data Variant {
    revision: u32;
    case Left(value: u32, bytes: Bytes);
    case Right(value: u32, bytes: Bytes);
    case Empty;
}
pub boundary trait PacketIo {
    machine read(descriptor: i32, variant: &mut Variant, count: u64) -> i64 blocks;
}
pub boundary trait ByteIo: Calling<ByteViewCallingPolicy<u8>> {
    machine write(descriptor: i32, bytes: &[u8]) -> i64;
}
pub data Imports {}
data Envelope { prefix: u32; variant: Variant; suffix: u32; }
data Main { input: Binding<PacketIo>; output: Binding<ByteIo>; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}

pub linux_x86_64 machine linux_x86_64_read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

pub linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine Imports::read(descriptor: i32, variant: &mut Variant, count: u64) -> i64
    satisfies PacketIo::read via read_binding();

linux_x86_64 boundary machine Imports::read(descriptor: i32, variant: &mut Variant, count: u64) -> i64
    satisfies PacketIo::read via linux_x86_64_read_binding();
macos_arm64 boundary machine Imports::write(descriptor: i32, bytes: &[u8]) -> i64
    satisfies ByteIo::write via write_binding();

linux_x86_64 boundary machine Imports::write(descriptor: i32, bytes: &[u8]) -> i64
    satisfies ByteIo::write via linux_x86_64_write_binding();

machine observe(variant: &Variant) -> bool {
    transition variant {
        Variant::Right { value, bytes } -> check(variant, value, bytes)
        _ -> (false)
    }
    state check(variant: &Variant, value: u32, bytes: &Bytes) -> bool {
        variant.revision == 7 && value == 9 && bytes.values[0] == 65
            && bytes.values[1] == 66 && bytes.values[2] == 67 && bytes.values[3] == 10
    }
}
machine publish(output: &Binding<ByteIo>, variant: &Variant) -> i64 reaches ByteIo {
    transition variant {
        Variant::Right { value as _, bytes } -> write(output, bytes)
        _ -> (-1)
    }
    state write(output: &Binding<ByteIo>, bytes: &Bytes) -> i64 {
        output.write(1, &bytes.values)
    }
}
machine Main::main(main: &mut Main) reaches PacketIo, ByteIo blocks; crashes Trap {
    let mut envelope: Envelope = Envelope {
        prefix: 17,
        variant: Variant::Left { revision: 7, value: 9, bytes: Bytes { values: [65, 66, 67, 10] } },
        suffix: 29
    };
    let moved: i64 = block main.input.read(0, &mut envelope.variant, 4);
    let observed: bool = observe(&envelope.variant);
    let written: i64 = publish(&main.output, &envelope.variant);
    transition moved == 4 && observed && written == 4 && envelope.prefix == 17 && envelope.suffix == 29 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
