// Expected exit: 0. Only the selected external edge abandons its frontier;
// its argument must still observe the live value before domain completion.
use omega::language::core::ProcessExit;

data Token [linear] { value: i32; }

machine main() reaches ProcessExit {
    let token: Token = Token { value: 0 };
    finish(token, false);
}

machine finish(token: Token, choose_first: bool) reaches ProcessExit {
    let another: Token = Token { value: 1 };
    transition choose_first {
        true -> ProcessExit::exit_process(another.value)
        _ -> ProcessExit::exit_process(token.value)
    }
}
