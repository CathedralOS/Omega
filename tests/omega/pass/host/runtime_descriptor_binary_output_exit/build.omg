use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_descriptor_binary_output_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);

 Build::bind<DescriptorProbe::write_word>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind<DescriptorProbe::write_word>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } });
}
