use omega::language::core::external_binding;

public boundary trait DescriptorIo {
    machine read(descriptor: i32, words: &mut [u16; 3], count: u64) -> i64 reaches blocks;
    machine write(descriptor: i32, words: &[u16; 3], count: u64) -> i64 reaches;
}
public data DescriptorImports {}
data Main { }


machine receive(words: &mut [u16; 3]) -> i64 reaches DescriptorIo blocks; {
    block DescriptorIo::read(0, words, 6)
}

machine retained_tail(words: &mut [u16; 3]) -> u16 {
    transition { _ -> observe(words) }
    machine observe(words: &mut [u16; 3]) -> u16 {
        words[2] = 11442;
        words[2]
    }
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    let mut words: [u16; 3] = [21845, 21845, 11442];
    let tail: u16 = retained_tail(&mut words);
    let moved: i64 = block receive(&mut words);
    let at_end: i64 = block DescriptorIo::read(0, &mut words, 6);
    let written: i64 = DescriptorIo::write(1, &words, 4);
    transition tail == 11442 && moved == 4 && at_end == 0 && written == 4
        && words[0] == 25185 && words[1] == 2659 && words[2] == 11442 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches DescriptorIo blocks; crashes Trap {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
