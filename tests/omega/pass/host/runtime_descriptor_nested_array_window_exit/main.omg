// Each entry uses its exact native calling policy and the same write/backing oracle.
// The two ordinary entry bodies differ only in their concrete native ABI facet.
use omega_language_std::calling;
use omega_language_std::posix_byte_view_calling;

public boundary trait LinuxDescriptorProbe: Calling<SystemVByteViewCalling> {
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
}
public boundary trait DarwinDescriptorProbe: Calling<DarwinArm64ByteViewCalling> {
    machine write_bytes(descriptor: i32, bytes: &[u8]) -> i64 reaches;
}
data Payload { bytes: [u8; 4]; }
data Envelope { payload: Payload; }

machine linux_emit(envelope: &Envelope) -> bool {
    let written: i64 = LinuxDescriptorProbe::write_bytes(1, &envelope.payload.bytes[1..4]);
    let empty: i64 = LinuxDescriptorProbe::write_bytes(1, &envelope.payload.bytes[4..4]);
    written == 3 && empty == 0
}

machine linux_main() crashes Trap {
    let envelope: Envelope = Envelope { payload: Payload { bytes: [100, 105, 114, 10] } };
    let written: bool = linux_emit(&envelope);
    transition written && envelope.payload.bytes[0] == 100
        && envelope.payload.bytes[1] == 105 && envelope.payload.bytes[3] == 10 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine darwin_emit(envelope: &Envelope) -> bool {
    let written: i64 = DarwinDescriptorProbe::write_bytes(1, &envelope.payload.bytes[1..4]);
    let empty: i64 = DarwinDescriptorProbe::write_bytes(1, &envelope.payload.bytes[4..4]);
    written == 3 && empty == 0
}

machine darwin_main() crashes Trap {
    let envelope: Envelope = Envelope { payload: Payload { bytes: [100, 105, 114, 10] } };
    let written: bool = darwin_emit(&envelope);
    transition written && envelope.payload.bytes[0] == 100
        && envelope.payload.bytes[1] == 105 && envelope.payload.bytes[3] == 10 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
