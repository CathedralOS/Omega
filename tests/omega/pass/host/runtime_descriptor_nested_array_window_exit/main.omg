// A helper lends nonzero and empty windows of nested caller-owned backing.
// Neither window creates a new owner or changes the bytes outside its extent.
use omega::language::core::external_binding;

public data DescriptorProbe { }
public boundary requirement DescriptorProbe::write_bytes(descriptor: i32, bytes: &[u8]) -> i64;
data DescriptorImports { }
data Payload { bytes: [u8; 4]; }
data Envelope { payload: Payload; }


machine emit(envelope: &Envelope) -> bool {
    let written: i64 = DescriptorProbe::write_bytes(1, &envelope.payload.bytes[1..4]);
    let empty: i64 = DescriptorProbe::write_bytes(1, &envelope.payload.bytes[4..4]);
    written == 3 && empty == 0
}

machine main() crashes Trap {
    let envelope: Envelope = Envelope { payload: Payload { bytes: [100, 105, 114, 10] } };
    let written: bool = emit(&envelope);
    transition written && envelope.payload.bytes[0] == 100
        && envelope.payload.bytes[1] == 105 && envelope.payload.bytes[3] == 10 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
