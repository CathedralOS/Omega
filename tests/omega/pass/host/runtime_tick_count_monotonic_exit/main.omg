// Hosted `Clock.tick_count()` and `Clock.sleep()` use each target's selected realization:
// Windows `GetTickCount64`/`Sleep`, Darwin `clock_gettime_nsec_np`/`poll`, and Linux
// `clock_gettime`/`nanosleep`. Assignment from a value-returning boundary call records the result
// place, and each backend stores the returned ticks there. The check is monotonicity (`t2 >= t1`
// across a sleep): native ticks are nondeterministic, while the interpreter advances a deterministic
// virtual clock. Both must exit 70 with matching behavior.
use omega_language_std::console;
boundary trait Clock { machine sleep(milliseconds: u32); machine tick_count() -> u64; }
data Main { console: Console; clock: Clock; t1: u64; t2: u64; }
machine Main::main(&mut self) {
    self.t1 = self.clock.tick_count();
    self.clock.sleep(30);
    self.t2 = self.clock.tick_count();
    transition self.t2 >= self.t1 { true -> ok() _ -> bad() }
    state ok(&mut self)  { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
