// A zero-storage establishment still owns its source position and logical cost.
// Native ABI marshaling may carry that charge before the exact completion edge;
// it must not turn the constructor into the foreign invocation's owner.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega::language::core::binding;

data Marker {}
data Main { exit: Binding<ProcessExit>; }

machine Main::main(main: &mut Main)
reaches
    ProcessExit
{
    let marker: Marker = Marker {};
    main.exit.exit_process(70);
}
