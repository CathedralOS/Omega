// EOF is stable, not one-shot: a second read_line after EndOfInput(0) reports
// EndOfInput(0) again rather than Invalid or a failure. Exit 21 = two clean
// empty reads; 99 = any other stop reason or count.
use omega_language_std::console;

data Main {
    line: [u8; 4];
}

machine Main::main(main: &mut Main)
reaches Console
{
    main.line[0] = 35;
    main.line[1] = 35;
    main.line[2] = 35;
    main.line[3] = 35;
    let first: LineReadResult = block Console::read_line(&mut main.line);
    transition first {
        LineReadResult::EndOfInput { count } -> first_count(main, count)
        _ -> invalid(main)
    }
    state first_count(main: &mut Main, count: u64) {
        transition count == 0 { true -> second(main) false -> invalid(main) }
    }
    state second(main: &mut Main) {
        let result: LineReadResult = block Console::read_line(&mut main.line);
        transition result {
            LineReadResult::EndOfInput { count } -> second_count(main, count)
            _ -> invalid(main)
        }
    }
    state second_count(main: &mut Main, count: u64) {
        transition count == 0 { true -> done(main) false -> invalid(main) }
    }
    state done(main: &mut Main) { Console::exit_process(21); }
    state invalid(main: &mut Main) { Console::exit_process(99); }
}
