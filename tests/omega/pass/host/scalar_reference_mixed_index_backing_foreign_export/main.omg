use omega::language::core::layout;
// A shared logical i64 may observe one stored byte; exporting eight bytes must refuse.


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}

data PortableByte [copy] { value: i64; }
data RawView { value: LayoutStorage<PortableByte, SignedByte>; }
use omega::language::core::external_binding;
public boundary trait Compare { machine compare(left: &i64, right: &i64, count: u64) -> i32 reaches; }


data Main where index < 2 { bytes: [u8; 2]; index: u64; }
machine Main::main(main: &mut Main) reaches Compare {
    let view: &RawView = &main.bytes[0] as &RawView;
    let narrow: &i64 = &view.value.value;
    let wide: i64 = 7;
    let alternatives: [&i64; 2] = [narrow, &wide];
    let selected: &i64 = alternatives[main.index];
    let result: i32 = Compare::compare(selected, &wide, 8);
}

// The hosted entry owns its ordinary local state; no context is supplied.
machine entry_start() reaches Compare {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
