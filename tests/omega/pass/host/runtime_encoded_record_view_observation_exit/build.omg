use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_encoded_record_view_observation_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);

 Build::bind<ByteOutput::write>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });

 Build::bind<ByteOutput::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
 Build::bind<ByteOutput::write>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
}
