// Expected exit: 0. Expected output contains: A.
// A foreign scalar snapshot checks the original signed
// predicate through its captured codec, not against the observed u8 carrier.
use omega::language::core::external_binding;
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where
    size <= 4096,
    1 <= align,
    align <= 16,
{
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}
data Schema
where
    field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}


data NarrowByte [copy] where -128 <= value, value <= 127 { value: i64; }
data ByteView { value: u8; }
pub boundary trait ByteOutput {
    machine write(descriptor: i32, value: &u8, count: u64) -> i64;
}
pub data ByteImports {}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
macos_arm64 boundary machine ByteImports::write(descriptor: i32, value: &u8, count: u64) -> i64
    satisfies ByteOutput::write via write_binding();
linux_x86_64 boundary machine ByteImports::write(descriptor: i32, value: &u8, count: u64) -> i64
    satisfies ByteOutput::write via ForeignBinding::Syscall(1);
linux_arm64 boundary machine ByteImports::write(descriptor: i32, value: &u8, count: u64) -> i64
    satisfies ByteOutput::write via ForeignBinding::Syscall(64);

data Main { encoded: SignedByte<NarrowByte>; }

machine read(value: &u8) -> u8 { value }
machine identity(value: &u8) -> &u8 { value }
machine write(value: &mut u8) { value = 255u8; }

machine Main::main(main: &mut Main) reaches ByteOutput crashes Trap {
    main.encoded.value = -9i64;
    let view: &mut ByteView = &mut main.encoded as &mut ByteView;
    let before: u8 = read(&view.value);
    write(&mut view.value);
    let returned: &u8 = identity(&view.value);
    let after: u8 = read(returned);
    view.value = 65u8;
    let written: i64 = ByteOutput::write(1, &view.value, 1);
    view.value = 10u8;
    let newline: i64 = ByteOutput::write(1, &view.value, 1);
    write(&mut view.value);
    let empty: i64 = ByteOutput::write(1, &view.value, 0);
    transition written == 1 && newline == 1 && empty == 0 && before == 247u8 && after == 255u8 && main.encoded.value == -1i64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
