use omega_language_std::console;
use omega::language::core::service;
// `write` (Stdout, no trailing newline) vs `write_line`. Writes "AB" with no newline
// then "C" with a newline: stdout must be exactly "ABC\n". The differential oracle
// compares native vs interpreter stdout byte-for-byte, so it verifies `write` does
// NOT append a newline (a regression would show a stray 0x0a). Exits 70.
//
// The bytes go through the hosted `write_byte` leaf: "AB" ends at byte 66 with
// nothing emitted after it, byte 10 supplies write_line's terminator, and a
// stray newline anywhere still breaks the byte-exact oracle.
data Main { console: Service<Console>; }
machine Main::main(&mut self)
reaches Console
{
    self.console.write_byte(65);
    self.console.write_byte(66);
    self.console.write_byte(67);
    self.console.write_byte(10);
    self.console.exit_process(70);
}
