use omega::language::core::binding;
use omega::language::core::external_binding;

pub data Choice { case Cell(counter: AtomicU32); case Empty; }
pub boundary trait DescriptorIo {
    machine read(descriptor: i32, choice: &mut Choice, count: u64) -> i64 blocks;
    machine write(descriptor: i32, choice: &mut Choice, count: u64) -> i64;
    machine write_tag(descriptor: i32, choice: &Choice, count: u64) -> i64;
}
pub data Imports {}
data Main { io: Binding<DescriptorIo>; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
pub macos_arm64 machine tag_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
macos_arm64 boundary machine Imports::read(descriptor: i32, choice: &mut Choice, count: u64) -> i64
    satisfies DescriptorIo::read via read_binding();
macos_arm64 boundary machine Imports::write(descriptor: i32, choice: &mut Choice, count: u64) -> i64
    satisfies DescriptorIo::write via write_binding();
macos_arm64 boundary machine Imports::write_tag(descriptor: i32, choice: &Choice, count: u64) -> i64
    satisfies DescriptorIo::write_tag via tag_binding();

machine make() -> Choice { Choice::Empty {} }
machine receive(io: &Binding<DescriptorIo>, choice: &mut Choice) -> i64 reaches DescriptorIo blocks; {
    block io.read(0, choice, 8)
}
machine observe(choice: &Choice) -> u32 in Wrapping {
    transition choice {
        Choice::Cell { counter as _ } -> cell(choice)
        _ -> (0)
    }
    state cell(choice: &Choice) -> u32 in Wrapping requires choice in Choice::Cell {
        let resident: u32 in Wrapping = choice.counter.fetch_or(0, NoOrdering);
        transition { _ -> (resident) }
    }
}
machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    let mut choice: Choice = make();
    let received: i64 = block receive(&main.io, &mut choice);
    let resident: u32 in Wrapping = observe(&choice);
    let tag: i64 = main.io.write_tag(1, &choice, 4);
    let written: i64 = main.io.write(1, &mut choice, 6);
    transition received == 8 && resident == 167774785 && tag == 4 && written == 6 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
