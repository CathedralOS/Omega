use omega::language::core::external_binding;

public data Choice { case Cell(counter: AtomicU32); case Empty; }
public boundary trait DescriptorIo {
    machine read(descriptor: i32, choice: &mut Choice, count: u64) -> i64 reaches blocks;
    machine write(descriptor: i32, choice: &mut Choice, count: u64) -> i64 reaches;
    machine write_tag(descriptor: i32, choice: &Choice, count: u64) -> i64 reaches;
}
public data Imports {}
data Main { }

public macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}

public linux_x86_64 machine linux_x86_64_read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5"
    } }
}
public macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

public linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
public macos_arm64 machine tag_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}

public linux_x86_64 machine linux_x86_64_tag_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine Imports::read(descriptor: i32, choice: &mut Choice, count: u64) -> i64
    satisfies DescriptorIo::read via read_binding();

linux_x86_64 boundary machine Imports::read(descriptor: i32, choice: &mut Choice, count: u64) -> i64
    satisfies DescriptorIo::read via linux_x86_64_read_binding();
macos_arm64 boundary machine Imports::write(descriptor: i32, choice: &mut Choice, count: u64) -> i64
    satisfies DescriptorIo::write via write_binding();

linux_x86_64 boundary machine Imports::write(descriptor: i32, choice: &mut Choice, count: u64) -> i64
    satisfies DescriptorIo::write via linux_x86_64_write_binding();
macos_arm64 boundary machine Imports::write_tag(descriptor: i32, choice: &Choice, count: u64) -> i64
    satisfies DescriptorIo::write_tag via tag_binding();

linux_x86_64 boundary machine Imports::write_tag(descriptor: i32, choice: &Choice, count: u64) -> i64
    satisfies DescriptorIo::write_tag via linux_x86_64_tag_binding();

machine make() -> Choice { Choice::Empty {} }
machine receive(choice: &mut Choice) -> i64 reaches DescriptorIo blocks; {
    block DescriptorIo::read(0, choice, 8)
}
machine observe(choice: &Choice) -> u32 in Wrapping {
    transition choice {
        Choice::Cell { counter as _ } -> cell(choice)
        _ -> (0)
    }
    machine cell(choice: &Choice) -> u32 in Wrapping requires choice in Choice::Cell {
        let resident: u32 in Wrapping = choice.counter.fetch_or(0, NoOrdering);
        transition { _ -> (resident) }
    }
}
machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    let mut choice: Choice = make();
    let received: i64 = block receive(&mut choice);
    let resident: u32 in Wrapping = observe(&choice);
    let tag: i64 = DescriptorIo::write_tag(1, &choice, 4);
    let written: i64 = DescriptorIo::write(1, &mut choice, 6);
    transition received == 8 && resident == 167774785 && tag == 4 && written == 6 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches DescriptorIo blocks; crashes Trap {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
