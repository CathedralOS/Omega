use omega::language::core::external_binding;
use omega::language::core::layout;
use omega::language::core::binding;
// A plan-laid record recasts to its exact byte-shaped foreign ABI:
// `value as &mut ForeignByte` hands `&mut SignedByte<PortableByte>` storage
// to the `i8` view `bzero`/`memcmp` consume — `reaches A + B` unions both
// service ceilings.
pub data SignedByte2 {}
machine SignedByte2::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
pub data PortableByte [copy] { value: i64; }
pub data RawView { value: SignedByte2<PortableByte>; }
pub data ForeignByte { value: i8; }
pub boundary trait ClearByte {
    machine clear(value: &mut ForeignByte, count: u64);
}
macos_arm64 machine clear_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_bzero",
        },
    }
}
macos_arm64 machine clear_bytes(value: &mut ForeignByte, count: u64)
    satisfies ClearByte::clear via clear_binding();
pub boundary trait CompareByte {
    machine compare(left: &RawView, right: &RawView, count: u64) -> i32;
}
macos_arm64 machine compare_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp",
        },
    }
}
macos_arm64 machine compare_bytes(left: &RawView, right: &RawView, count: u64) -> i32
    satisfies CompareByte::compare via compare_binding();
machine compare(compare_byte: &Binding<CompareByte>, left: &RawView, right: &RawView) -> i32 reaches CompareByte {
    CompareByte::compare(compare_byte, left, right, 1)
}
machine clear(clear_byte: &Binding<ClearByte>, value: &mut RawView) reaches ClearByte {
    let physical: &ForeignByte = value as &ForeignByte;
    ClearByte::clear(clear_byte, &mut value.value as &mut ForeignByte, 1);
}
data Main { bytes: [u8; 2]; expected: [u8; 1]; compare_byte: Binding<CompareByte>; }
machine Main::main(main: &mut Main) reaches CompareByte + ClearByte {
    main.bytes[0] = 128;
    main.bytes[1] = 85;
    main.expected[0] = 128;
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let expected: &RawView = &main.expected[0] as &RawView;
    let result: i32 = compare(&main.compare_byte, view, expected);
    transition result == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() {}
}
