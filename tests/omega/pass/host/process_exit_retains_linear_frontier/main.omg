// Expected exit: 0. The canonical external outcome abandons these claims;
// it does not invent cleanup or consumption receipts for them.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
data Token [linear] { value: u64; }
data Owner { token: Token; }
machine main() reaches ProcessExit {
    let owner: Owner = Owner { token: Token { value: 42 } };
    transition owner.token.value == 42 {
        true -> finish(owner, 0)
        _ -> finish(owner, 1)
    }
    machine finish(owner: Owner, status: i32) {
        let additional: Token = Token { value: 7 };
        ProcessExit::exit_process(status);
    }
}
