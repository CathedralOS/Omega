// Read into original caller storage. Different import slots share one finite
// stream; zero-byte calls and short reads must preserve the untouched bytes.
use omega::language::core::external_binding;

pub boundary trait DescriptorIo {
    machine read_word(descriptor: i32, word: &mut u32, count: u64) -> i64 blocks;
    machine read_half(descriptor: i32, half: &mut u16, count: u64) -> i64 blocks;
    machine write_word(descriptor: i32, word: &u32, count: u64) -> i64;
    machine write_half(descriptor: i32, half: &u16, count: u64) -> i64;
    machine write_discarded(descriptor: i32, word: &u32, count: u64);
}
pub data DescriptorImports { }
data Main { word: u32; half: u16; }

pub macos_arm64 machine read_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } }
}
pub macos_arm64 machine write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
macos_arm64 boundary machine DescriptorImports::read_word(descriptor: i32, word: &mut u32, count: u64) -> i64
    satisfies DescriptorIo::read_word via read_binding();
macos_arm64 boundary machine DescriptorImports::read_half(descriptor: i32, half: &mut u16, count: u64) -> i64
    satisfies DescriptorIo::read_half via read_binding();
macos_arm64 boundary machine DescriptorImports::write_word(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies DescriptorIo::write_word via write_binding();
macos_arm64 boundary machine DescriptorImports::write_half(descriptor: i32, half: &u16, count: u64) -> i64
    satisfies DescriptorIo::write_half via write_binding();
macos_arm64 boundary machine DescriptorImports::write_discarded(descriptor: i32, word: &u32, count: u64)
    satisfies DescriptorIo::write_discarded via write_binding();

linux_x86_64 boundary machine DescriptorImports::read_word(descriptor: i32, word: &mut u32, count: u64) -> i64
    satisfies DescriptorIo::read_word via ForeignBinding::Syscall(0);
linux_arm64 boundary machine DescriptorImports::read_word(descriptor: i32, word: &mut u32, count: u64) -> i64
    satisfies DescriptorIo::read_word via ForeignBinding::Syscall(63);
linux_x86_64 boundary machine DescriptorImports::read_half(descriptor: i32, half: &mut u16, count: u64) -> i64
    satisfies DescriptorIo::read_half via ForeignBinding::Syscall(0);
linux_arm64 boundary machine DescriptorImports::read_half(descriptor: i32, half: &mut u16, count: u64) -> i64
    satisfies DescriptorIo::read_half via ForeignBinding::Syscall(63);
linux_x86_64 boundary machine DescriptorImports::write_word(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies DescriptorIo::write_word via ForeignBinding::Syscall(1);
linux_arm64 boundary machine DescriptorImports::write_word(descriptor: i32, word: &u32, count: u64) -> i64
    satisfies DescriptorIo::write_word via ForeignBinding::Syscall(64);
linux_x86_64 boundary machine DescriptorImports::write_half(descriptor: i32, half: &u16, count: u64) -> i64
    satisfies DescriptorIo::write_half via ForeignBinding::Syscall(1);
linux_arm64 boundary machine DescriptorImports::write_half(descriptor: i32, half: &u16, count: u64) -> i64
    satisfies DescriptorIo::write_half via ForeignBinding::Syscall(64);
linux_x86_64 boundary machine DescriptorImports::write_discarded(descriptor: i32, word: &u32, count: u64)
    satisfies DescriptorIo::write_discarded via ForeignBinding::Syscall(1);
linux_arm64 boundary machine DescriptorImports::write_discarded(descriptor: i32, word: &u32, count: u64)
    satisfies DescriptorIo::write_discarded via ForeignBinding::Syscall(64);

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    main.word = 1144201745;
    main.half = 21828;
    let empty: i64 = block DescriptorIo::read_word(0, &mut main.word, 0);
    let first: i64 = block DescriptorIo::read_word(0, &mut main.word, 3);
    let second: i64 = block DescriptorIo::read_half(0, &mut main.half, 2);
    let at_end: i64 = block DescriptorIo::read_word(0, &mut main.word, 2);
    let written: i64 = DescriptorIo::write_word(1, &main.word, 3);
    DescriptorIo::write_discarded(1, &main.word, 0);
    // Discarding the count must still perform the original storage transfer.
    let diagnostic: u32 = 174285409;
    DescriptorIo::write_discarded(2, &diagnostic, 4);
    let newline: i64 = DescriptorIo::write_half(1, &main.half, 1);
    transition empty == 0 && first == 3 && second == 1 && at_end == 0
        && written == 3 && newline == 1 && main.word == 1147363937 && main.half == 21770 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
