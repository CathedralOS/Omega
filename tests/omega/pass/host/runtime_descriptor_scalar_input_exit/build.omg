use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_descriptor_scalar_input_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);

 Build::bind<DescriptorIo::read_word>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } });
 Build::bind<DescriptorIo::read_half>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
    } });
 Build::bind<DescriptorIo::write_word>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind<DescriptorIo::write_half>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind<DescriptorIo::write_discarded>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });

 Build::bind<DescriptorIo::read_word>(builder, linux_x86_64, ForeignBinding::Syscall { number: 0 });
 Build::bind<DescriptorIo::read_word>(builder, linux_arm64, ForeignBinding::Syscall { number: 63 });
 Build::bind<DescriptorIo::read_half>(builder, linux_x86_64, ForeignBinding::Syscall { number: 0 });
 Build::bind<DescriptorIo::read_half>(builder, linux_arm64, ForeignBinding::Syscall { number: 63 });
 Build::bind<DescriptorIo::write_word>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
 Build::bind<DescriptorIo::write_word>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
 Build::bind<DescriptorIo::write_half>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
 Build::bind<DescriptorIo::write_half>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
 Build::bind<DescriptorIo::write_discarded>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
 Build::bind<DescriptorIo::write_discarded>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
}
