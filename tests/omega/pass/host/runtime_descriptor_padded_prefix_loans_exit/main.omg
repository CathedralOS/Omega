// The demanded prefix has scalar backing; later interior/trailing padding is
// outside the foreign read/write interval and must not acquire invented bytes.
use omega::language::core::external_binding;

public data Packet [copy] { header: u16; payload: u64; ending: u8; }
public boundary trait DescriptorIo {
    machine read(descriptor: i32, packet: &mut Packet, count: u64) -> i64 reaches blocks;
    machine write(descriptor: i32, packet: &Packet, count: u64) -> i64 reaches;
}
public data DescriptorImports {}
data Holder { before: u64; packet: Packet; after: u64; }
data Main { holder: Holder; }


machine receive(packet: &mut Packet, count: u64) -> i64
    reaches DescriptorIo blocks; {
    block DescriptorIo::read(0, packet, count)
}

machine Main::main(main: &mut Main) reaches DescriptorIo blocks; crashes Trap {
    main.holder.before = 17;
    main.holder.packet.header = 16706;
    main.holder.packet.payload = 123456789;
    main.holder.packet.ending = 29;
    main.holder.after = 31;
    let zero: i64 = block receive(&mut main.holder.packet, 0);
    let moved: i64 = block receive(&mut main.holder.packet, 1);
    let saved: u16 = main.holder.packet.header;
    let written: i64 = DescriptorIo::write(1, &main.holder.packet, 2);
    let tail: i64 = block receive(&mut main.holder.packet, 1);
    let at_end: i64 = block receive(&mut main.holder.packet, 2);
    let newline: i64 = DescriptorIo::write(1, &main.holder.packet, 1);
    transition zero == 0 && moved == 1 && tail == 1 && at_end == 0
        && written == 2 && newline == 1 && saved == 16707
        && main.holder.packet.header == 16650
        && main.holder.packet.payload == 123456789 && main.holder.packet.ending == 29
        && main.holder.before == 17 && main.holder.after == 31 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches DescriptorIo blocks; crashes Trap {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
