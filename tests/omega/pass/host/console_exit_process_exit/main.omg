// One console line, then termination through `Console::exit_process` with
// status 70. `write_line` is checked std code over the `write_byte`
// intrinsic; `exit_process` ends the process, so nothing after it runs.
use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main)
reaches Console
{
    Console::write_line("console-exit-process");
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
