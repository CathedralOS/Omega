// A line ending in LF fits: LineComplete counts and stores the LF, the
// untouched tail keeps its `#` sentinel, and the next unread byte follows.
// Variant of runtime_console_bounded_line_exit with an ASCII `#` (35)
// sentinel so expected_stdout.txt can compare the exact bytes.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    line: [u8; 4];
}

machine Main::main(&mut self)
reaches Console
{
    self.line[0] = 35;
    self.line[1] = 35;
    self.line[2] = 35;
    self.line[3] = 35;
    let empty: LineReadResult = block self.console.read_line(&mut self.line[0..0]);
    transition empty {
        LineReadResult::Full { count } -> empty_result(count)
        _ -> invalid()
    }
    state empty_result(&mut self, count: u64) {
        transition count == 0 { true -> read() false -> invalid() }
    }
    state read(&mut self) {
        let result: LineReadResult = block self.console.read_line(&mut self.line);
        transition result {
            LineReadResult::LineComplete { count } -> report(10, count)
            LineReadResult::EndOfInput { count } -> report(20, count)
            LineReadResult::Full { count } -> report(30, count)
            LineReadResult::Invalid -> invalid()
        }
    }
    state report(&mut self, reason: i32, count: u64)
    requires 0 <= reason && reason <= 100
    {
        self.console.write(&self.line);
        let next: ByteRead = block self.console.read_byte();
        transition next {
            ByteRead::Byte { value } -> suffix(reason, count, value)
            ByteRead::Eof -> done(reason, count)
        }
    }
    state suffix(&mut self, reason: i32, count: u64, value: i32)
    requires 0 <= reason && reason <= 100 && 0 <= value && value <= 255
    {
        self.console.write_byte(value);
        transition { _ -> done(reason, count) }
    }
    state done(&mut self, reason: i32, count: u64)
    requires 0 <= reason && reason <= 100
    {
        // `LineReadResult.count` is an unbounded u64: the contract carries no
        // upper bound, so the exact `i32` cast needs a dominating premise.
        // The four-byte line caps count at 4; `finish` declares that bound.
        transition count <= 4 {
            true -> finish(reason, count)
            _ -> invalid()
        }
    }
    state finish(&mut self, reason: i32, count: u64)
    requires 0 <= reason && reason <= 100 && count <= 4
    {
        self.console.exit_process(reason + count as i32);
    }
    state invalid(&mut self) { self.console.exit_process(99); }
}
