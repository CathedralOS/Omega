use omega::language::core::numeric_conversion;
// Timespec and scalar reads share one supplied clock model. Out-parameters
// retain the original record/array backing through helpers and captures.
use omega::language::core::binding;
use omega::language::core::external_binding;

pub data Instant [copy] { seconds: i64; nanoseconds: i64; marker: i64; }
data Holder { prefix: i64; instant: Instant; suffix: i64; }
data Main { clock: Binding<ClockProbe>; holder: Holder; pair: [i64; 2]; request: Instant; }
pub boundary trait ClockProbe {
    machine read(selector: i32, instant: &mut Instant) -> i32;
    machine read_pair(selector: u32, pair: &mut [i64; 2]) -> i32;
    machine nanoseconds(selector: i32) -> u64;
    machine wait(pointer: u64, count: u32, milliseconds: i32) -> i32;
    machine sleep(request: &Instant, remainder: u64) -> i32;
    machine sleep_unit(request: &Instant, remainder: u64);
}
data ClockImports {}

macos_arm64 machine timespec_binding() -> ForeignBinding<26, 14, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime"
    } }
}

linux_x86_64 machine linux_timespec_binding() -> ForeignBinding<9, 13, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "clock_gettime", version: "GLIBC_2.17"
    } }
}
macos_arm64 machine nanoseconds_binding() -> ForeignBinding<26, 22, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime_nsec_np"
    } }
}
macos_arm64 machine poll_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_poll"
    } }
}

linux_x86_64 machine linux_poll_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "poll", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 machine nanosleep_binding() -> ForeignBinding<26, 10, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_nanosleep"
    } }
}

linux_x86_64 machine linux_nanosleep_binding() -> ForeignBinding<9, 9, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "nanosleep", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 machine ClockImports::read(selector: i32, instant: &mut Instant) -> i32
    satisfies ClockProbe::read via timespec_binding();

linux_x86_64 machine ClockImports::read(selector: i32, instant: &mut Instant) -> i32
    satisfies ClockProbe::read via linux_timespec_binding();
macos_arm64 machine ClockImports::read_pair(selector: u32, pair: &mut [i64; 2]) -> i32
    satisfies ClockProbe::read_pair via timespec_binding();

linux_x86_64 machine ClockImports::read_pair(selector: u32, pair: &mut [i64; 2]) -> i32
    satisfies ClockProbe::read_pair via linux_timespec_binding();
macos_arm64 machine ClockImports::nanoseconds(selector: i32) -> u64
    satisfies ClockProbe::nanoseconds via nanoseconds_binding();
macos_arm64 machine ClockImports::wait(pointer: u64, count: u32, milliseconds: i32) -> i32
    satisfies ClockProbe::wait via poll_binding();

linux_x86_64 machine ClockImports::wait(pointer: u64, count: u32, milliseconds: i32) -> i32
    satisfies ClockProbe::wait via linux_poll_binding();
macos_arm64 machine ClockImports::sleep(request: &Instant, remainder: u64) -> i32
    satisfies ClockProbe::sleep via nanosleep_binding();

linux_x86_64 machine ClockImports::sleep(request: &Instant, remainder: u64) -> i32
    satisfies ClockProbe::sleep via linux_nanosleep_binding();
macos_arm64 machine ClockImports::sleep_unit(request: &Instant, remainder: u64)
    satisfies ClockProbe::sleep_unit via nanosleep_binding();

linux_x86_64 machine ClockImports::sleep_unit(request: &Instant, remainder: u64)
    satisfies ClockProbe::sleep_unit via linux_nanosleep_binding();

machine read(clock: &Binding<ClockProbe>, selector: i32, instant: &mut Instant) -> i32
    reaches ClockProbe { clock.read(selector, instant) }
machine sleep(clock: &Binding<ClockProbe>, request: &Instant) -> i32
    reaches ClockProbe { clock.sleep(request, 1) }

machine Main::main(main: &mut Main) reaches ClockProbe crashes Trap {
    main.holder.prefix = 17;
    main.holder.suffix = 29;
    main.holder.instant.seconds = -1;
    main.holder.instant.nanoseconds = -1;
    main.holder.instant.marker = 31;
    main.pair[0] = -1;
    main.pair[1] = -1;
    main.request.seconds = 0;
    main.request.nanoseconds = 3000000;
    main.request.marker = 41;
    let first_status: i32 = read(&main.clock, 6, &mut main.holder.instant);
    let before_seconds: i64 = main.holder.instant.seconds;
    let before_nanoseconds: i64 = main.holder.instant.nanoseconds;
    let before: u64 = main.clock.nanoseconds(6);
    let waited: i32 = main.clock.wait(0, 0, 3);
    let after_poll: u64 = main.clock.nanoseconds(6);
    let request: &Instant = &main.request;
    let slept: i32 = sleep(&main.clock, request);
    let after_sleep: u64 = main.clock.nanoseconds(6);
    main.clock.sleep_unit(&main.request, 1);
    let after_unit_sleep: u64 = main.clock.nanoseconds(6);
    let captured: &mut Instant = &mut main.holder.instant;
    let second_status: i32 = read(&main.clock, 6, captured);
    let after: u64 = main.clock.nanoseconds(6);
    let wall_status: i32 = main.clock.read_pair(0, &mut main.pair);
    transition first_status == 0 && second_status == 0 && wall_status == 0 && waited == 0
        && slept == 0 && after_sleep > after_poll && after_unit_sleep > after_sleep
        && main.request.seconds == 0 && main.request.nanoseconds == 3000000
        && main.request.marker == 41
        && before_seconds >= 0 && before_nanoseconds >= 0 && before_nanoseconds < 1000000000
        && main.holder.instant.nanoseconds >= 0 && main.holder.instant.nanoseconds < 1000000000
        && (main.holder.instant.seconds > before_seconds
            || (main.holder.instant.seconds == before_seconds
                && main.holder.instant.nanoseconds > before_nanoseconds))
        && after > before && main.holder.prefix == 17 && main.holder.suffix == 29
        && main.holder.instant.marker == 31
        && main.pair[0] > 1767225600 && main.pair[0] < 3350000000
        && main.pair[1] >= 0 && main.pair[1] < 1000000000 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// Linux exposes clock_gettime through an out-parameter. Preserve the scalar
// clock operation with a checked adapter over that same admitted import.
linux_x86_64 machine ClockImports::nanoseconds(selector: i32) -> u64
    satisfies ClockProbe::nanoseconds {
    let mut instant: Instant = Instant { seconds: 0, nanoseconds: 0, marker: 0 };
    let status: i32 = ClockImports::read(1, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        false -> failed()
    }
    state measured(seconds: i64, nanoseconds: i64) -> u64 {
        let whole: u64 = narrow_i64_to_u64_saturating(seconds);
        let fraction: u64 = narrow_i64_to_u64_saturating(nanoseconds);
        let scaled: u64 in Wrapping = (whole as u64 in Wrapping) * 1000000000;
        let total: u64 in Wrapping = scaled + (fraction as u64 in Wrapping);
        total as u64
    }
    state failed() -> u64 { 0 }
}
