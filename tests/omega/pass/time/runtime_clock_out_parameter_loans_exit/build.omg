use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_clock_out_parameter_loans_exit");
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, linux_arm64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, linux_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, macos_arm64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, macos_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, windows_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, uefi_x86_64);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, cross_platform_cli);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, local_unchecked);
    Build::select_provider<ClockProbe, ClockImportsClockProbeImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind<ClockProbe::read>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime"
    } });
 Build::bind<ClockProbe::read>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "clock_gettime", version: "GLIBC_2.17"
    } });
 Build::bind<ClockProbe::read_pair>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime"
    } });
 Build::bind<ClockProbe::read_pair>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "clock_gettime", version: "GLIBC_2.17"
    } });
 Build::bind<ClockProbe::nanoseconds>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime_nsec_np"
    } });
 Build::bind<ClockProbe::wait>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_poll"
    } });
 Build::bind<ClockProbe::wait>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "poll", version: "GLIBC_2.2.5"
    } });
 Build::bind<ClockProbe::sleep>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_nanosleep"
    } });
 Build::bind<ClockProbe::sleep>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "nanosleep", version: "GLIBC_2.2.5"
    } });
 Build::bind<ClockProbe::sleep_unit>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_nanosleep"
    } });
 Build::bind<ClockProbe::sleep_unit>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "nanosleep", version: "GLIBC_2.2.5"
    } });
}
