// std::time rung 4: the TimeHost seam over the interpreter's VIRTUAL clock,
// EXACT values (D12): monotonic_ticks does not advance on read and `sleep(30)`
// advances it by exactly 30; the calibration constants are 1000/1000/0; the
// wall clock reads 2026-01-01T00:00:00Z + elapsed in milliseconds.
// INTERPRETER-ONLY until rung 5 binds the ops natively (windows QPC/QPF +
// GetSystemTimePreciseAsFileTime; native canaries then assert inequalities,
// not exact values).
// Expected exit: 70.
use omega_language_std::time_host;

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    host: Binding<TimeHost>;
    second_ticks: u64;
}

machine Main::main(&mut self) reaches Console + TimeHost {
    let mut first_ticks: u64 = self.host.monotonic_ticks();
    self.host.sleep(30);
    self.second_ticks = self.host.monotonic_ticks();
    transition (self.second_ticks as u64 in Wrapping) == (first_ticks as u64 in Wrapping) + 30 {
        true -> check_frequency()
        false -> fail_delta()
    }
    state check_frequency(&mut self) {
        let mut frequency: u64 = self.host.monotonic_ticks_per_second();
        transition frequency == 1000 { true -> check_wall() false -> fail_frequency() }
    }
    state check_wall(&mut self) {
        let mut wall_raw: u64 = self.host.wall_clock_raw();
        transition (wall_raw as u64 in Wrapping) == (self.second_ticks as u64 in Wrapping) + 1767225600000 {
            true -> check_wall_units()
            false -> fail_wall()
        }
    }
    state check_wall_units(&mut self) {
        let mut wall_units: u64 = self.host.wall_clock_units_per_second();
        let mut wall_offset: u64 = self.host.wall_clock_epoch_offset_seconds();
        transition wall_units == 1000 && wall_offset == 0 {
            true -> good()
            false -> fail_wall_units()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state fail_delta(&mut self) { self.console.exit_process(1); }
    state fail_frequency(&mut self) { self.console.exit_process(2); }
    state fail_wall(&mut self) { self.console.exit_process(3); }
    state fail_wall_units(&mut self) { self.console.exit_process(4); }
}
