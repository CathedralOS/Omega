// clock_gettime writes its two-word prefix, not the larger loan's tail padding.
use omega::language::core::external_binding;

public data Instant { seconds: i64; nanoseconds: i64; marker: u8; }
public boundary trait ClockProbe {
    machine read(selector: u32, instant: &mut Instant) -> i32 reaches;
}
data ClockImports {}
data Holder { before: i64; instant: Instant; after: i64; }
data Main { holder: Holder; }


machine read(instant: &mut Instant) -> i32
    reaches ClockProbe { ClockProbe::read(6, instant) }

machine Main::main(main: &mut Main) reaches ClockProbe crashes Trap {
    main.holder.before = 17;
    main.holder.instant.seconds = -1;
    main.holder.instant.nanoseconds = -1;
    main.holder.instant.marker = 31;
    main.holder.after = 29;
    let status: i32 = read(&mut main.holder.instant);
    transition status == 0 && main.holder.instant.seconds >= 0
        && main.holder.instant.nanoseconds >= 0 && main.holder.instant.nanoseconds < 1000000000
        && main.holder.instant.marker == 31 && main.holder.before == 17 && main.holder.after == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ClockProbe crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
