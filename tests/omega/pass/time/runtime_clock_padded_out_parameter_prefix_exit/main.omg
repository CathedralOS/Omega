// clock_gettime writes its two-word prefix, not the larger loan's tail padding.
use omega::language::core::binding;
use omega::language::core::external_binding;

pub data Instant { seconds: i64; nanoseconds: i64; marker: u8; }
pub boundary trait ClockProbe {
    machine read(selector: u32, instant: &mut Instant) -> i32;
}
data ClockImports {}
data Holder { before: i64; instant: Instant; after: i64; }
data Main { clock: Binding<ClockProbe>; holder: Holder; }

macos_arm64 machine timespec_binding() -> ForeignBinding<26, 14, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime"
    } }
}

linux_x86_64 machine linux_x86_64_timespec_binding() -> ForeignBinding<9, 13, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "clock_gettime", version: "GLIBC_2.17"
    } }
}
macos_arm64 machine ClockImports::read(selector: u32, instant: &mut Instant) -> i32
    satisfies ClockProbe::read via timespec_binding();

linux_x86_64 machine ClockImports::read(selector: u32, instant: &mut Instant) -> i32
    satisfies ClockProbe::read via linux_x86_64_timespec_binding();

machine read(clock: &Binding<ClockProbe>, instant: &mut Instant) -> i32
    reaches ClockProbe { clock.read(6, instant) }

machine Main::main(main: &mut Main) reaches ClockProbe crashes Trap {
    main.holder.before = 17;
    main.holder.instant.seconds = -1;
    main.holder.instant.nanoseconds = -1;
    main.holder.instant.marker = 31;
    main.holder.after = 29;
    let status: i32 = read(&main.clock, &mut main.holder.instant);
    transition status == 0 && main.holder.instant.seconds >= 0
        && main.holder.instant.nanoseconds >= 0 && main.holder.instant.nanoseconds < 1000000000
        && main.holder.instant.marker == 31 && main.holder.before == 17 && main.holder.after == 29 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
