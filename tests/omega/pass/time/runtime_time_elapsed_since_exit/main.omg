// Time::elapsed_since receives the clock capability explicitly. The start
// and elapsed values are local; sleep(30) must measure at least 30ms.
// Exits: 70 ok; 1 = under 30ms / zeroed.
use omega_language_std::time;

use omega_language_std::console;
use omega_language_std::clock;

data Main {
    time: Time;
}

machine Main::main(context: &mut Main) reaches Console + Clock {
    let start: Instant = Time::now(&mut context.time);
    Clock::sleep(30);
    let elapsed: Duration = Time::elapsed_since(&mut context.time, start);
    transition elapsed.seconds == 0 {
        true -> check_subsecond(context, elapsed.subsecond_nanoseconds)
        false -> good(context)
    }
    state check_subsecond(context: &mut Main, subsecond_nanoseconds: u32) {
        transition subsecond_nanoseconds >= 30000000 {
            true -> good(context)
            false -> fail_short(context)
        }
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state fail_short(context: &mut Main) { Console::exit_process(1); }
}
