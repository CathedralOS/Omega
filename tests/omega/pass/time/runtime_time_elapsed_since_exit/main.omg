// Time::elapsed_since receives the clock capability explicitly. The start
// and elapsed values are local; sleep(30) must measure at least 30ms.
// Exits: 70 ok; 1 = under 30ms / zeroed.
use omega_language_std::time;

use omega_language_std::console;
use omega_language_std::clock;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    clock: Binding<Clock>;
    time: Time;
}

machine Main::main(&mut self) reaches Console + Clock {
    let start: Instant = self.time.now();
    self.clock.sleep(30);
    let elapsed: Duration = Time::elapsed_since(&mut self.time, start);
    transition elapsed.seconds == 0 {
        true -> check_subsecond(elapsed.subsecond_nanoseconds)
        false -> good()
    }
    state check_subsecond(&mut self, subsecond_nanoseconds: u32) {
        transition subsecond_nanoseconds >= 30000000 {
            true -> good()
            false -> fail_short()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state fail_short(&mut self) { self.console.exit_process(1); }
}
