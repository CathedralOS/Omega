// std::time from_* unit constructors (receiverless type-scoped value calls),
// exact values: from_seconds(2) = {2, 0}; from_milliseconds(3500) =
// {3, 500000000} (exercises the division/remainder conversion).
// Native since 2026-07-10: the constructors construct from LETS (every field
// value a local), the shape whose 16-byte result delivery works. An INLINE
// BINARY field expression in the struct literal still mis-sizes the write to
// the whole struct and hits the loud 16-byte fence (TASKS).
// Expected exit: 70.
use omega_language_std::time;

use omega_language_std::console;

data Main {
    console: Console;
    a: Duration;
    b: Duration;
}

machine Main::main(&mut self) {
    self.a = Duration::from_seconds(2);
    transition self.a.seconds == 2 && self.a.subsecond_nanoseconds == 0 {
        true -> check_milliseconds()
        false -> fail_seconds()
    }
    state check_milliseconds(&mut self) {
        self.b = Duration::from_milliseconds(3500);
        transition self.b.seconds == 3 && self.b.subsecond_nanoseconds == 500000000 {
            true -> check_microseconds()
            false -> fail_milliseconds()
        }
    }
    state check_microseconds(&mut self) {
        self.b = Duration::from_microseconds(2500001);
        transition self.b.seconds == 2 && self.b.subsecond_nanoseconds == 500001000 {
            true -> check_nanoseconds()
            false -> fail_microseconds()
        }
    }
    state check_nanoseconds(&mut self) {
        self.b = Duration::from_nanoseconds(1999999999);
        transition self.b.seconds == 1 && self.b.subsecond_nanoseconds == 999999999 {
            true -> good()
            false -> fail_nanoseconds()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state fail_seconds(&mut self) { self.console.exit_process(1); }
    state fail_milliseconds(&mut self) { self.console.exit_process(2); }
    state fail_microseconds(&mut self) { self.console.exit_process(3); }
    state fail_nanoseconds(&mut self) { self.console.exit_process(4); }
}
