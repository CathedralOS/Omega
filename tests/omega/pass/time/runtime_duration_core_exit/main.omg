// std::time Duration core (TASKS_TIME.md rung 3): exact-value assertions over
// the pure-value API on both engines. Exercises the CARRY path of checked_add
// (2.6s + 3.5s = 6.1s), the BORROW path of checked_subtract (6.1s - 3.5s =
// 2.6s), the ZERO clamp of saturating_subtract (2.6s - 3.5s), ordering, and
// the underflow arm. Every failure exits a distinct code.
// Expected exit: 70.
use omega_language_std::time;

use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    let first: Duration = Duration { seconds: 2, subsecond_nanoseconds: 600000000 };
    let second: Duration = Duration { seconds: 3, subsecond_nanoseconds: 500000000 };
    let sum_result: DurationResult = Duration::checked_add(&first, second);
    transition sum_result {
        DurationResult::Ok { duration } -> check_sum(context, second, duration)
        DurationResult::Overflow -> fail_add(context)
    }

    state check_sum(context: &mut Main, second: Duration, sum: Duration) {
        transition sum.seconds == 6 && sum.subsecond_nanoseconds == 100000000 {
            true -> do_subtract(context, second, sum)
            false -> fail_sum_value(context)
        }
    }
    state do_subtract(context: &mut Main, second: Duration, sum: Duration) {
        // The explicit first argument is the computed sum, not either input.
        let difference_result: DurationResult = Duration::checked_subtract(&sum, second);
        transition difference_result {
            DurationResult::Ok { duration } -> check_difference(context, second, duration)
            DurationResult::Overflow -> fail_subtract(context)
        }
    }
    state check_difference(context: &mut Main, second: Duration, difference: Duration) {
        transition difference.seconds == 2 {
            true -> check_difference_nanoseconds(context, second, difference)
            false -> probe_difference_seconds(context, difference)
        }
    }
    state check_difference_nanoseconds(context: &mut Main, second: Duration, difference: Duration) {
        transition difference.subsecond_nanoseconds == 600000000 {
            true -> do_saturate(context, second)
            false -> fail_difference_value(context)
        }
    }
    state do_saturate(context: &mut Main, second: Duration) {
        let first: Duration = Duration { seconds: 2, subsecond_nanoseconds: 600000000 };
        let clamped: Duration = Duration::saturating_subtract(&first, second);
        transition clamped.seconds == 0 && clamped.subsecond_nanoseconds == 0 {
            true -> do_compare(context, first, second)
            false -> fail_saturate(context)
        }
    }
    state do_compare(context: &mut Main, first: Duration, second: Duration) {
        let first_is_less: bool = Duration::is_less_than(&first, second);
        transition first_is_less {
            true -> check_underflow(context, second)
            false -> fail_compare(context)
        }
    }
    state check_underflow(context: &mut Main, second: Duration) {
        let first: Duration = Duration { seconds: 2, subsecond_nanoseconds: 600000000 };
        let difference_result: DurationResult = Duration::checked_subtract(&first, second);
        transition difference_result {
            DurationResult::Overflow -> check_max(context, second)
            DurationResult::Ok { duration } -> fail_underflow(context, duration)
        }
    }
    state check_max(context: &mut Main, second: Duration) {
        // Duration::MAX round-trips full-width: u64::MAX + 1 wraps to exactly
        // 0 only if every bit was set (const -> local record -> projection).
        let maximum: Duration = Duration::MAX;
        let mask: u64 in Wrapping = (maximum.seconds as u64 in Wrapping) + 1;
        transition mask == 0 && maximum.subsecond_nanoseconds == 999999999 {
            true -> check_saturating_add(context, maximum, second)
            false -> fail_max(context)
        }
    }
    state check_saturating_add(context: &mut Main, maximum: Duration, second: Duration) {
        // MAX + anything clamps at MAX (checked_add's Overflow arm).
        let clamped: Duration = Duration::saturating_add(&maximum, second);
        let mask: u64 in Wrapping = (clamped.seconds as u64 in Wrapping) + 1;
        transition mask == 0 && clamped.subsecond_nanoseconds == 999999999 {
            true -> good(context)
            false -> fail_saturating_add(context)
        }
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state fail_add(context: &mut Main) { Console::exit_process(1); }
    state fail_sum_value(context: &mut Main) { Console::exit_process(2); }
    state fail_subtract(context: &mut Main) { Console::exit_process(3); }
    state fail_difference_value(context: &mut Main) { Console::exit_process(4); }
    state fail_difference_seconds(context: &mut Main) { Console::exit_process(8); }
    state probe_difference_seconds(context: &mut Main, difference: Duration) {
        // PROBE: which wrong value arrived? 6 => direct-emit ran with
        // other-fields-as-zero; 5 => borrow-emit ran with other.seconds 0.
        transition difference.seconds == 6 {
            true -> probe_six(context)
            false -> probe_not_six(context, difference)
        }
    }
    state probe_six(context: &mut Main) { Console::exit_process(20); }
    state probe_not_six(context: &mut Main, difference: Duration) {
        transition difference.seconds == 5 {
            true -> probe_five(context)
            false -> fail_difference_seconds(context)
        }
    }
    state probe_five(context: &mut Main) { Console::exit_process(21); }
    state fail_saturate(context: &mut Main) { Console::exit_process(5); }
    state fail_compare(context: &mut Main) { Console::exit_process(6); }
    state fail_underflow(context: &mut Main, duration: Duration) { Console::exit_process(7); }
    state fail_max(context: &mut Main) { Console::exit_process(9); }
    state fail_saturating_add(context: &mut Main) { Console::exit_process(10); }
}
