// std::time rung 10 NATIVE CONFIRMATION on darwin/aarch64 (claimed by the
// fs lane 2026-07-10g -- it has the Mac; see TASKS_FS.md "Stolen work"):
// `_clock_gettime_nsec_np` serves BOTH reads via clockid injection
// (monotonic CLOCK_UPTIME_RAW = 8, wall CLOCK_REALTIME = 0), and the
// aarch64 CONSTANT-RESULT encoder serves frequency/units with no call at
// all. The darwin calibration constants are asserted EXACTLY -- they are
// the darwin lowering rows themselves: nanosecond units (10^9 for both
// monotonic frequency and wall units) and a unix epoch offset of 0.
// The sibling runtime_time_host_native_exit asserts the WINDOWS rows
// (FILETIME 10^7 / 11_644_473_600) and is #[cfg(windows)]-gated; this one
// is #[cfg(target_os = "macos")]-gated.
//
// Real-clock assertions are INEQUALITIES: monotonic strictly advances
// across a 30ms sleep; wall-clock sanity brackets unix SECONDS between
// 2026-01-01 (1_767_225_600) and ~2076 (3_350_000_000) -- a zeroed result
// fails low, an undivided nanosecond raw (~10^18) fails high.
// Expected exit: 70.
use omega_language_std::time_host;

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    host: Binding<TimeHost>;
}

machine Main::main(context: &mut Main) reaches Console + TimeHost {
    let first_ticks: u64 = context.host.monotonic_ticks();
    context.host.sleep(30);
    let second_ticks: u64 = context.host.monotonic_ticks();
    // 30ms of CLOCK_UPTIME_RAW nanoseconds: strictly greater, never equal.
    transition second_ticks > first_ticks {
        true -> check_frequency(&mut context)
        false -> fail_monotonic(&mut context)
    }
    state check_frequency(context: &mut Main) {
        let frequency: u64 = context.host.monotonic_ticks_per_second();
        transition frequency == 1000000000 {
            true -> check_units(&mut context)
            false -> fail_frequency(&mut context)
        }
    }
    state check_units(context: &mut Main) {
        let wall_units: u64 = context.host.wall_clock_units_per_second();
        transition wall_units == 1000000000 {
            true -> check_offset(&mut context)
            false -> fail_units(&mut context)
        }
    }
    state check_offset(context: &mut Main) {
        let wall_offset: u64 = context.host.wall_clock_epoch_offset_seconds();
        transition wall_offset == 0 {
            true -> check_wall_lower(&mut context)
            false -> fail_offset(&mut context)
        }
    }
    state check_wall_lower(context: &mut Main) {
        let wall_raw: u64 = context.host.wall_clock_raw();
        let unix_seconds: u64 = wall_raw / 1000000000;
        transition unix_seconds > 1767225600 {
            true -> check_wall_upper(&mut context, unix_seconds)
            false -> fail_wall_low(&mut context)
        }
    }
    state check_wall_upper(context: &mut Main, unix_seconds: u64) {
        transition unix_seconds < 3350000000 {
            true -> good(&mut context)
            false -> fail_wall_high(&mut context)
        }
    }
    state good(context: &mut Main) { context.console.exit_process(70); }
    state fail_monotonic(context: &mut Main) { context.console.exit_process(1); }
    state fail_frequency(context: &mut Main) { context.console.exit_process(2); }
    state fail_units(context: &mut Main) { context.console.exit_process(3); }
    state fail_offset(context: &mut Main) { context.console.exit_process(4); }
    state fail_wall_low(context: &mut Main) { context.console.exit_process(5); }
    state fail_wall_high(context: &mut Main) { context.console.exit_process(6); }
}
