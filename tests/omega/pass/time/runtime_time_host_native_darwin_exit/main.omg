// Exercise all six operations of the reviewed macOS TimeHost provider.
// Ordinary checked adapters supply clock selectors, sleep retry control and
// calibration constants; only the clock read and poll are foreign imports.
// build.omg selects macos_arm64, whose units and epoch this fixture asserts.
//
// Real-clock assertions are INEQUALITIES: monotonic strictly advances
// by at least 30ms across sleep; wall-clock sanity brackets unix SECONDS between
// 2026-01-01 (1_767_225_600) and ~2076 (3_350_000_000) -- a zeroed result
// fails low, an undivided nanosecond raw (~10^18) fails high.
// Expected exit: 70.
use omega_language_std::time_host;

use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console + TimeHost {
    let first_ticks: u64 = TimeHost::monotonic_ticks();
    block TimeHost::sleep(30);
    let second_ticks: u64 = TimeHost::monotonic_ticks();
    // 30ms of CLOCK_UPTIME_RAW nanoseconds: strictly greater, never equal.
    transition second_ticks > first_ticks {
        true -> check_sleep(&mut context, second_ticks - first_ticks)
        false -> fail_monotonic(&mut context)
    }
    state check_sleep(context: &mut Main, elapsed_ticks: u64) {
        transition elapsed_ticks >= 30000000 {
            true -> check_frequency(context)
            false -> fail_monotonic(context)
        }
    }
    state check_frequency(context: &mut Main) {
        let frequency: u64 = TimeHost::monotonic_ticks_per_second();
        transition frequency == 1000000000 {
            true -> check_units(&mut context)
            false -> fail_frequency(&mut context)
        }
    }
    state check_units(context: &mut Main) {
        let wall_units: u64 = TimeHost::wall_clock_units_per_second();
        transition wall_units == 1000000000 {
            true -> check_offset(&mut context)
            false -> fail_units(&mut context)
        }
    }
    state check_offset(context: &mut Main) {
        let wall_offset: u64 = TimeHost::wall_clock_epoch_offset_seconds();
        transition wall_offset == 0 {
            true -> check_wall_lower(&mut context)
            false -> fail_offset(&mut context)
        }
    }
    state check_wall_lower(context: &mut Main) {
        let wall_raw: u64 = TimeHost::wall_clock_raw();
        let unix_seconds: u64 = wall_raw / 1000000000;
        transition unix_seconds > 1767225600 {
            true -> check_wall_upper(&mut context, unix_seconds)
            false -> fail_wall_low(&mut context)
        }
    }
    state check_wall_upper(context: &mut Main, unix_seconds: u64) {
        transition unix_seconds < 3350000000 {
            true -> good(&mut context)
            false -> fail_wall_high(&mut context)
        }
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state fail_monotonic(context: &mut Main) { Console::exit_process(1); }
    state fail_frequency(context: &mut Main) { Console::exit_process(2); }
    state fail_units(context: &mut Main) { Console::exit_process(3); }
    state fail_offset(context: &mut Main) { Console::exit_process(4); }
    state fail_wall_low(context: &mut Main) { Console::exit_process(5); }
    state fail_wall_high(context: &mut Main) { Console::exit_process(6); }
}
