// std::time rung 6 slice 3: Instant and SystemTime checked arithmetic,
// exact values on both engines (pure value machines, no clock).
//
// Legs (each Ok leg is a NON-ZII arm; the Overflow legs pin the detection):
//  1. Instant checked_add with nanosecond CARRY: {5s,800M} + {2s,300M} =
//     {8s,100M}
//  2. Instant checked_subtract with BORROW: {5s,100M} - {2s,300M} = {2s,800M}
//  3. Instant checked_add at u64::MAX seconds -> Overflow
//  4. SystemTime checked_add crossing NEGATIVE->positive with carry:
//     {-5s,800M} + {2s,300M} = {-2s,100M}
//  5. SystemTime checked_subtract with borrow: {-2s,100M} - {0s,300M} =
//     {-3s,800M}
//  6. SystemTime checked_add at i64::MAX -> Overflow
//  7. SystemTime checked_subtract at i64::MIN -> Overflow
//  8. SystemTime checked_add of duration seconds ABOVE i64::MAX -> Overflow
//     (pins the biased-space detection for the huge-addend half)
//
// Expected exit: 70.
use omega_language_std::time;
use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    let instant: Instant = Instant { seconds: 5, subsecond_nanoseconds: 800000000 };
    let duration: Duration = Duration { seconds: 2, subsecond_nanoseconds: 300000000 };
    let result: InstantResult = Instant::checked_add(&instant, duration);
    transition result {
        InstantResult::Ok { instant } -> check_add_carry(context, duration, instant)
        InstantResult::Overflow -> fail_leg(context, 1)
    }
    state check_add_carry(context: &mut Main, duration: Duration, instant: Instant) {
        transition instant.seconds == 8 && instant.subsecond_nanoseconds == 100000000 {
            true -> leg2(context, duration)
            false -> fail_leg(context, 1)
        }
    }
    state leg2(context: &mut Main, duration: Duration) {
        let instant: Instant = Instant { seconds: 5, subsecond_nanoseconds: 100000000 };
        let result: InstantResult = Instant::checked_subtract(&instant, duration);
        transition result {
            InstantResult::Ok { instant } -> check_sub_borrow(context, duration, instant)
            InstantResult::Overflow -> fail_leg(context, 2)
        }
    }
    state check_sub_borrow(context: &mut Main, duration: Duration, instant: Instant) {
        transition instant.seconds == 2 && instant.subsecond_nanoseconds == 800000000 {
            true -> leg3(context, duration)
            false -> fail_leg(context, 2)
        }
    }
    state leg3(context: &mut Main, duration: Duration) {
        let instant: Instant = Instant { seconds: 18446744073709551615, subsecond_nanoseconds: 0 };
        let result: InstantResult = Instant::checked_add(&instant, duration);
        transition result {
            InstantResult::Overflow -> leg4(context, duration)
            InstantResult::Ok { instant } -> fail_leg(context, 3)
        }
    }
    state leg4(context: &mut Main, duration: Duration) {
        let time: SystemTime = SystemTime { seconds_since_unix_epoch: 0 - 5, subsecond_nanoseconds: 800000000 };
        let result: SystemTimeResult = SystemTime::checked_add(&time, duration);
        transition result {
            SystemTimeResult::Ok { time } -> check_wall_add(context, time)
            SystemTimeResult::Overflow -> fail_leg(context, 4)
        }
    }
    state check_wall_add(context: &mut Main, time: SystemTime) {
        transition time.seconds_since_unix_epoch == 0 - 2 && time.subsecond_nanoseconds == 100000000 {
            true -> leg5(context)
            false -> fail_leg(context, 4)
        }
    }
    state leg5(context: &mut Main) {
        let time: SystemTime = SystemTime { seconds_since_unix_epoch: 0 - 2, subsecond_nanoseconds: 100000000 };
        let duration: Duration = Duration { seconds: 0, subsecond_nanoseconds: 300000000 };
        let result: SystemTimeResult = SystemTime::checked_subtract(&time, duration);
        transition result {
            SystemTimeResult::Ok { time } -> check_wall_sub(context, time)
            SystemTimeResult::Overflow -> fail_leg(context, 5)
        }
    }
    state check_wall_sub(context: &mut Main, time: SystemTime) {
        transition time.seconds_since_unix_epoch == 0 - 3 && time.subsecond_nanoseconds == 800000000 {
            true -> leg6(context)
            false -> fail_leg(context, 5)
        }
    }
    state leg6(context: &mut Main) {
        let time: SystemTime = SystemTime { seconds_since_unix_epoch: 9223372036854775807, subsecond_nanoseconds: 0 };
        let duration: Duration = Duration { seconds: 1, subsecond_nanoseconds: 0 };
        let result: SystemTimeResult = SystemTime::checked_add(&time, duration);
        transition result {
            SystemTimeResult::Overflow -> leg7(context, duration)
            SystemTimeResult::Ok { time } -> fail_leg(context, 6)
        }
    }
    state leg7(context: &mut Main, duration: Duration) {
        let time: SystemTime = SystemTime { seconds_since_unix_epoch: 0 - 9223372036854775807 - 1, subsecond_nanoseconds: 0 };
        let result: SystemTimeResult = SystemTime::checked_subtract(&time, duration);
        transition result {
            SystemTimeResult::Overflow -> leg8(context)
            SystemTimeResult::Ok { time } -> fail_leg(context, 7)
        }
    }
    state leg8(context: &mut Main) {
        let time: SystemTime = SystemTime { seconds_since_unix_epoch: 0, subsecond_nanoseconds: 0 };
        let duration: Duration = Duration { seconds: 9300000000000000000, subsecond_nanoseconds: 0 };
        let result: SystemTimeResult = SystemTime::checked_add(&time, duration);
        transition result {
            SystemTimeResult::Overflow -> good(context)
            SystemTimeResult::Ok { time } -> fail_leg(context, 8)
        }
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state fail_leg(context: &mut Main, leg: i32) { Console::exit_process(leg); }
}
