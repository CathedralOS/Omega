// Exact Linux syscall offers share one clock domain. Requests are read-only
// original loans; clock writes cover only the native 16-byte prefix.
use omega::language::core::external_binding;

pub data Instant [copy] { seconds: i64; nanoseconds: i64; marker: i64; }
data Holder { prefix: i64; instant: Instant; suffix: i64; }
data Main { holder: Holder; request: Instant; }
pub boundary trait ClockProbe {
    machine read(selector: i32, instant: &mut Instant) -> i64;
    machine sleep(request: &Instant, remainder: u64) -> i64;
    machine sleep_unit(request: &Instant, remainder: u64);
}
data ClockImports {}

linux_x86_64 machine ClockImports::read(selector: i32, instant: &mut Instant) -> i64
    satisfies ClockProbe::read via ForeignBinding::Syscall(228);
linux_arm64 machine ClockImports::read(selector: i32, instant: &mut Instant) -> i64
    satisfies ClockProbe::read via ForeignBinding::Syscall(113);
linux_x86_64 machine ClockImports::sleep(request: &Instant, remainder: u64) -> i64
    satisfies ClockProbe::sleep via ForeignBinding::Syscall(35);
linux_arm64 machine ClockImports::sleep(request: &Instant, remainder: u64) -> i64
    satisfies ClockProbe::sleep via ForeignBinding::Syscall(101);
linux_x86_64 machine ClockImports::sleep_unit(request: &Instant, remainder: u64)
    satisfies ClockProbe::sleep_unit via ForeignBinding::Syscall(35);
linux_arm64 machine ClockImports::sleep_unit(request: &Instant, remainder: u64)
    satisfies ClockProbe::sleep_unit via ForeignBinding::Syscall(101);

machine read(instant: &mut Instant) -> i64
    reaches ClockProbe { ClockProbe::read(1, instant) }
machine sleep(request: &Instant) -> i64
    reaches ClockProbe { ClockProbe::sleep(request, 1) }

machine Main::main(main: &mut Main) reaches ClockProbe crashes Trap {
    main.holder.prefix = 17;
    main.holder.suffix = 29;
    main.holder.instant.seconds = -1;
    main.holder.instant.nanoseconds = -1;
    main.holder.instant.marker = 31;
    main.request.seconds = -1;
    main.request.nanoseconds = 0;
    main.request.marker = 41;
    let negative_status: i64 = sleep(&main.request);
    main.request.seconds = 0;
    main.request.nanoseconds = 1000000000;
    let unnormalized_status: i64 = sleep(&main.request);
    main.request.nanoseconds = 3000000;
    let first_status: i64 = read(&mut main.holder.instant);
    let before_seconds: i64 = main.holder.instant.seconds;
    let before_nanoseconds: i64 = main.holder.instant.nanoseconds;
    let captured: &Instant = &main.request;
    // The signal-free successful native operation never accesses remainder.
    // A non-null numerical carrier must not invent a null precondition.
    let waited: i64 = sleep(captured);
    ClockProbe::sleep_unit(&main.request, 1);
    let output: &mut Instant = &mut main.holder.instant;
    let second_status: i64 = read(output);
    transition negative_status == -22 && unnormalized_status == -22
        && first_status == 0 && second_status == 0 && waited == 0
        && before_seconds >= 0 && before_nanoseconds >= 0 && before_nanoseconds < 1000000000
        && main.holder.instant.nanoseconds >= 0 && main.holder.instant.nanoseconds < 1000000000
        && (main.holder.instant.seconds > before_seconds
            || (main.holder.instant.seconds == before_seconds
                && main.holder.instant.nanoseconds > before_nanoseconds))
        && main.holder.prefix == 17 && main.holder.suffix == 29
        && main.holder.instant.marker == 31
        && main.request.seconds == 0 && main.request.nanoseconds == 3000000
        && main.request.marker == 41 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
