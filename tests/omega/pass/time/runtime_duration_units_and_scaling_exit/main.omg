use omega_language_std::time;

machine unit_constructors() -> bool {
    let milliseconds: Duration = Duration::from_milliseconds(2001);
    let microseconds: Duration = Duration::from_microseconds(2000001);
    let nanoseconds: Duration = Duration::from_nanoseconds(2000000001);
    let maximum: Duration = Duration::from_milliseconds(Duration::MAX.seconds);
    milliseconds.seconds == 2 && milliseconds.subsecond_nanoseconds == 1000000
        && microseconds.seconds == 2 && microseconds.subsecond_nanoseconds == 1000
        && nanoseconds.seconds == 2 && nanoseconds.subsecond_nanoseconds == 1
        && maximum.seconds == 18446744073709551
        && maximum.subsecond_nanoseconds == 615000000
}

machine multiply() -> bool {
    let duration: Duration = Duration { seconds: 2, subsecond_nanoseconds: 800000000 };
    let result: DurationResult = Duration::checked_multiply(&duration, 3);
    transition result {
        DurationResult::Ok { duration } -> product(duration)
        DurationResult::Overflow -> no()
    }
    machine product(duration: Duration) -> bool {
        transition duration.seconds == 8 && duration.subsecond_nanoseconds == 400000000 {
            true -> zero()
            false -> no()
        }
    }
    machine zero() -> bool {
        let maximum: Duration = Duration::MAX;
        let result: DurationResult = Duration::checked_multiply(&maximum, 0);
        transition result {
            DurationResult::Ok { duration } -> check_zero(duration)
            DurationResult::Overflow -> no()
        }
    }
    machine check_zero(duration: Duration) -> bool {
        transition duration.seconds == 0 && duration.subsecond_nanoseconds == 0 {
            true -> overflow()
            false -> no()
        }
    }
    machine overflow() -> bool {
        let maximum: Duration = Duration::MAX;
        let result: DurationResult = Duration::checked_multiply(&maximum, 2);
        transition result {
            DurationResult::Overflow -> yes()
            DurationResult::Ok { duration } -> no()
        }
    }
    machine yes() -> bool { true }
    machine no() -> bool { false }
}

machine divide() -> bool {
    let duration: Duration = Duration { seconds: 5, subsecond_nanoseconds: 500000000 };
    let result: DurationResult = Duration::divide(&duration, 2);
    transition result {
        DurationResult::Ok { duration } -> quotient(duration)
        DurationResult::Overflow -> no()
    }
    machine quotient(duration: Duration) -> bool {
        transition duration.seconds == 2 && duration.subsecond_nanoseconds == 750000000 {
            true -> zero_divisor(duration)
            false -> no()
        }
    }
    machine zero_divisor(duration: Duration) -> bool {
        let result: DurationResult = Duration::divide(&duration, 0);
        transition result {
            DurationResult::Overflow -> yes()
            DurationResult::Ok { duration } -> no()
        }
    }
    machine yes() -> bool { true }
    machine no() -> bool { false }
}

machine main() crashes Trap {
    let units: bool = unit_constructors();
    let multiplied: bool = multiply();
    let divided: bool = divide();
    transition units && multiplied && divided {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
