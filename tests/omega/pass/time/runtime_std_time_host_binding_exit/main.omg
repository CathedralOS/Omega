// The raw time-host seams are boundary traits selected under `TimeHost`.
// `Time::now` reads the monotonic clock and `Time::sleep_for` waits 50ms.
// The interpreter's virtual clock advances by exactly that wait; a host
// clock measures at least 50ms. Exit 70 when both observations hold.
//
// Expected exit: 70.
use omega_language_std::console;
use omega_language_std::time;
use omega_language_std::time_host;

data Main {
    time: Time;
}

machine entry_start() reaches Console + TimeHost {
    let mut entry: Main;
    let start: Instant = Time::now(&mut entry.time);
    let pause: Duration = Duration { seconds: 0, subsecond_nanoseconds: 50000000 };
    let slept: u32 = block Time::sleep_for(&mut entry.time, pause);
    let elapsed: Duration = Time::elapsed_since(&mut entry.time, start);
    let long_enough: bool = elapsed.seconds > 0 || elapsed.subsecond_nanoseconds >= 50000000;
    transition slept == 50 && long_enough {
        true -> pass()
        _ -> fail()
    }
    machine pass() { Console::exit_process(70); }
    machine fail() { Console::exit_process(1); }
}
