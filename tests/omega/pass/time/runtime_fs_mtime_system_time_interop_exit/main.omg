// fs <-> time INTEROP (TASKS_TIME #9's ready leg, claimed by the fs lane
// 2026-07-10g): a real file's Metadata mtime, decoded at the darwin stat
// offset (st_mtimespec.tv_sec, i64 @48 -- the native_metadata_modified
// idiom) and bridged through SystemTime::from_unix_seconds, is comparable
// with Time::system_time_now(): SystemTime::duration_since must be Ok
// (a just-created file is never in the future), the gap must be sane, and
// the bridged mtime must be a real timestamp (>= the virtual model's
// 10^9 constant; a zeroed decode fails).
//
// ENGINE-AGNOSTIC assertions so BOTH engines exit 70 on a macOS host: the
// interpreter's virtual fs stamps mtime = 10^9 (2001) and its virtual
// wall clock reads 2026-01-01, so the gap is ~767M seconds; native's gap
// is ~0. Both are Ok, < 10^9 seconds, with mtime >= 10^9. The decode
// offset is DARWIN's, so the canary is macos-gated in the suite and
// differential-excluded with a reason (the windows leg waits on fs
// open-work #2's stat rows, exactly as TASKS_TIME #9 records).
// Expected exit: 70.
use omega_language_std::posix_filesystem_host;
use omega_language_std::time;

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    time: Time;
}

machine Main::main(context: &mut Main) reaches Console + PosixFilesystemHost {
    let mode: i32 = 438;
    let mut buffer: [u8; 144];
    let descriptor: i32 = PosixFilesystemHost::create("/tmp/omega_time_interop.txt", mode);
    let written: i64 = PosixFilesystemHost::write(descriptor, "interop");
    let closed: i32 = PosixFilesystemHost::close(descriptor);
    let metadata_status: i32 = PosixFilesystemHost::read_metadata("/tmp/omega_time_interop.txt", &mut buffer);
    let removed: i32 = PosixFilesystemHost::remove("/tmp/omega_time_interop.txt");
    transition metadata_status == 0 { true -> decode(context, buffer) _ -> bad(context, 71) }
    state decode(context: &mut Main, buffer: [u8; 144]) {
        // carrier note: the little-endian field is assembled in `u64` and
        // reinterpreted once at the landing, so every shifted byte is
        // Exact-representable: 255 << 56 is 18374686479671623680 against a u64
        // ceiling of 18446744073709551615. Shifting in `i64` reaches the same
        // 18374686479671623680 against a ceiling of 9223372036854775807, which
        // is a decision-17 obligation no return range can discharge.
        let modified_seconds: i64 = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(buffer[48])
                | (widen_u8_to_u64(buffer[49]) << 8)
                | (widen_u8_to_u64(buffer[50]) << 16)
                | (widen_u8_to_u64(buffer[51]) << 24)
                | (widen_u8_to_u64(buffer[52]) << 32)
                | (widen_u8_to_u64(buffer[53]) << 40)
                | (widen_u8_to_u64(buffer[54]) << 48)
                | (widen_u8_to_u64(buffer[55]) << 56));
        let modified: SystemTime = SystemTime::from_unix_seconds(modified_seconds);
        let now: SystemTime = Time::system_time_now(&mut context.time);
        let difference: SystemTimeDifference = SystemTime::duration_since(&now, modified);
        transition difference {
            SystemTimeDifference::Ok { duration } -> check_gap(context, modified_seconds, duration)
            SystemTimeDifference::Backwards { amount } -> bad_backwards(context, amount)
            SystemTimeDifference::Unmeasured -> bad(context, 73)
        }
    }
    state check_gap(context: &mut Main, modified_seconds: i64, duration: Duration) {
        // Native: ~0s (just created). Interp: ~767M s (2001 -> 2026 virtual
        // constants). Both < 10^9; a garbage decode blows the bound.
        transition duration.seconds < 1000000000 { true -> check_mtime(context, modified_seconds) _ -> bad(context, 74) }
    }
    state check_mtime(context: &mut Main, modified_seconds: i64) {
        // A real timestamp: >= the virtual model's 10^9 (2001) constant;
        // native darwin is ~1.77e9. A zeroed decode fails here.
        transition modified_seconds >= 1000000000 { true -> good(context) _ -> bad(context, 75) }
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main, code: i32) { Console::exit_process(code); }
    state bad_backwards(context: &mut Main, amount: Duration) { Console::exit_process(72); }
}
