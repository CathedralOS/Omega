// Deployable filesystem-time interop canary: the Darwin host selects its exact entry.

machine build(builder: &mut Build) {
    builder.application("runtime-fs-mtime-system-time-interop-exit");
    builder.depend(Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
}
