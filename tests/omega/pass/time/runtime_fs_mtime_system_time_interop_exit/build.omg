// Deployable filesystem-time interop canary: the Darwin host selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_fs_mtime_system_time_interop_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
}
