machine build(builder: &mut Build) {
    Build::depend(builder, Source::Path { location: "/Users/zcanann/Documents/Projects/Omega/.agents/worktree/product-front/source/library/std" });
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder);
    Build::application(builder, "terminal_reference_snapshot");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
