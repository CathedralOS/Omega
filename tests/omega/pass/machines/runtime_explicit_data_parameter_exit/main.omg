// Expected exit: 0. Explicit borrowed arguments retain access and writeback.
data Dice { state: u32; }
machine Dice::roll(dice: &mut Dice) -> u32 {
    dice.state = 42;
    dice.state
}
machine main() crashes Trap {
    let mut dice: Dice;
    let result: u32 = Dice::roll(&mut dice);
    transition result == 42 && dice.state == 42 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
