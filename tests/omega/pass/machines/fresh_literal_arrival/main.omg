// A state may be reached only by a fresh record literal arrival:
// `iterate(Countdown { remaining: 3, limit: 5 })` constructs a new
// ranked subject at the hop — the state's own descent continues from
// the literal's proven coordinates.
data Countdown where 0 <= remaining, remaining <= 5, 0 <= limit, limit <= 5 {
    remaining: u64;
    limit: u64;
}
measure Countdown::Remaining(countdown: Countdown) -> u64
{ countdown.remaining }
machine walk(countdown: Countdown)
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition countdown.remaining > 3 {
        true -> iterate(Countdown { remaining: 3, limit: 5 })
        false -> countdown.remaining
    }
    machine iterate(pending: Countdown) -> u64
    {
        transition pending.remaining > 0 {
            true -> iterate(Countdown {
                remaining: pending.remaining - 1,
                limit: pending.limit
            })
            false -> pending.remaining
        }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
