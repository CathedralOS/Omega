// A `where` clause may carry a TYPE EQUATION, not just predicates:
// `where Length == u64[0..=Capacity]` binds the type argument to a
// declared structure — no runtime value supplies layout. The caller
// closes it with a concrete interval `u64[0..257]`.
machine capacity<Length, const Capacity: u64>() -> u64
where Length == u64[0..=Capacity]
{ Capacity }
data Main { size: u64; }
machine Main::main(main: &mut Main) {
    main.size = capacity<u64[0..257]>();
}
