// A named state reached only through a computed arrival: the state's
// auxiliary payload `base + step` combines two entry inputs — the rank
// and its endpoints stay exact.
machine walk(remaining: u32, base: u32, step: u32)
    requires 0 <= remaining && remaining <= 5 && 0 <= base && base <= 5 && 0 <= step && step <= 5
terminates by remaining in 0..=5;
-> u32 {
    transition { _ -> tally(remaining, base + step) }
    machine tally(count: u32, total: u32) -> u32
        requires 0 <= count && count <= 5 && 0 <= total && total <= 10
    {
        transition count > 0 {
            true -> tally(count - 1, total)
            false -> total
        }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
