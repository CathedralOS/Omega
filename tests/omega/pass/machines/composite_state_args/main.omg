// Composite values supplied directly as internal state arguments:
// literal, field, call result, and local each arrive in a fresh owned
// parameter; the guarded edge's call arm runs exactly once. States take
// their own `main` param — enclosing locals don't reach inside states.
// Arguments evaluate left to right, so the call that borrows
// `main.counter` precedes forwarding `main` itself: its loan has ended
// before the exclusive reference moves into the arrival.
data Pair [copy] { a: i32; b: i32; }
data Counter { made: i32; }

machine make(counter: &mut Counter, seed: i32) -> Pair {
    counter.made = ((counter.made as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    Pair { a: seed, b: ((seed as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32 }
}

data Main { pair: Pair; counter: Counter; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { a: 10, b: 20 };
    main.counter = Counter { made: 0 };
    let local: Pair = Pair { a: 7, b: 8 };
    transition {
        _ -> take_literal(main, Pair { a: 1, b: 2 }, local)
    }
    state take_literal(main: &mut Main, pair: Pair, local: Pair) {
        transition pair.a == 1 {
            true -> take_call(make(&mut main.counter, 5), main, local)
            _ -> bad()
        }
    }
    state take_call(pair: Pair, main: &mut Main, local: Pair) {
        transition pair.a == 5 && main.counter.made == 1 {
            true -> take_local(main, local)
            _ -> bad()
        }
    }
    state take_local(main: &mut Main, pair: Pair) {
        transition pair.b == 8 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() {}
}
