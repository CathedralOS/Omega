// A proof-only data family indexed by a compile-time machine symbol:
// `data Stream<machine S> where machine S(index: Index) -> Index`
// — the family contract is checked at a concrete use (`Stream<sample>`)
// while a recursive occurrence forwards its own static parameter
// without storing a callable value.
public data Index {
    case Zero;
    case Next(previous: Index);
}
data Stream<machine S>
where machine S(index: Index) -> Index;
{
    case Empty;
    case More(sample: Index, tail: Stream<S>);
}
boundary machine sample(index: Index) -> Index;
machine accepts_concrete_stream(value: Stream<sample>) { }
data Main {}
machine Main::main(main: &mut Main) { }
