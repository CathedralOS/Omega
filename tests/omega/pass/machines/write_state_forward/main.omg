// A `&write` loan forwarded through a subordinate state param:
// `forward` lends `destination` to `write_value`, which hands it to
// `replace` — the write-only capability survives each hop with no
// observation added.
machine replace(destination: &write i32, value: i32) {
    destination = value;
}
machine forward(destination: &write i32, value: i32) {
    transition { _ -> write_value(&write destination, value) }
    machine write_value(destination: &write i32, value: i32) {
        replace(&write destination, value);
    }
}
data Main {
    value: i32;
    neighbor: i32;
}
machine Main::main(main: &mut Main) {
    main.value = 7;
    main.neighbor = 19;
    forward(&write main.value, 42);
    transition main.value == 42 && main.neighbor == 19 {
        true -> good()
        _ -> bad()
    }
    machine good() { }
    machine bad() { crash Trap; }
}
