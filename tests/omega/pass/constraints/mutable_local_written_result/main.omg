// The passing twin of mutable_local_value_invalidated: a call that promises the
// value it writes lets the caller prove the written result, not the old one.
machine replace(value: &mut u8) ensures value == 8 { value = 8; }

machine produce() -> u8
ensures result == 8
{
    let mut saved: u8 = 3 + 4;
    replace(&mut saved);
    saved
}

machine main() { _ = produce(); }
