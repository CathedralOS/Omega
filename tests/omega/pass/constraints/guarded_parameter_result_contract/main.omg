machine bounded(ignored: bool, input: u16 [0..256]) -> u16
requires input <= 255u16
ensures result == input || result < input
{
    transition { _ -> finish(input) }
    state finish(saved: u16) -> u16 { saved }
}

machine value(selected: bool, input: u16) -> bool
requires true == true
ensures true == true
{
    transition selected {
        true -> finish(selected && ((bounded(!selected, input % 256u16) as u8) == 7u8))
        false -> finish(false)
    }
    state finish(result: bool) -> bool { result }
}
