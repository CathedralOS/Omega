// Chapters 7/9/10 spell multi-fact contracts with one fact per line and no
// separator, e.g. the clamp `ensures out in min..=max` shape and the
// compare_swap example:
//
//     requires
//         index + 1 < items.len
//         Bag(items) == Bag(before)
//
// Newlines between facts are accepted as proof-fact separators.

data Items {
    count: u64;
}

machine Items::check(&self, index: u64)
requires
    index < self.count
    index + 1 < self.count
{
}

data Main {
    items: Items;
}

machine Main::main(&mut self) {
}
