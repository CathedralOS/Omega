// RUN CANARY (exit 70) + interpreter differential. The LEGAL half of the
// addr algebra (index/count/address model): `addr - count -> addr` offsets
// backward, `addr - addr -> count` measures the distance between two
// addresses, and addresses ORDER (`<`). The illegal half (addr + addr,
// addr * anything, shifts) rejects at compile -- see
// fail/types/addr_plus_addr_rejected.
// exits: 71 = addr - count wrong; 72 = addr - addr wrong; 73 = ordering wrong.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let a: addr = 4096;
    let b: addr = 4000;
    let back: addr = a - 16;
    transition back == 4080 {
        true  -> diff_leg(main)
        false -> bad_sub(main)
    }
    state diff_leg(main: &mut Main) {
        let a2: addr = 4096;
        let b2: addr = 4000;
        let d: u64 = a2 - b2;
        transition d == 96 {
            true  -> order_leg(main)
            false -> bad_diff(main)
        }
    }
    state order_leg(main: &mut Main) {
        let a3: addr = 4096;
        let b3: addr = 4000;
        let o: bool = b3 < a3;
        transition o == true {
            true  -> good(main)
            false -> bad_order(main)
        }
    }
    state good(main: &mut Main)     { Console::exit_process(70); }
    state bad_sub(main: &mut Main)  { Console::exit_process(71); }
    state bad_diff(main: &mut Main) { Console::exit_process(72); }
    state bad_order(main: &mut Main){ Console::exit_process(73); }
}
