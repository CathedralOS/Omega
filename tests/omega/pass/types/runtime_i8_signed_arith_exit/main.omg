// i8 fields: SIGNED store, arithmetic, and compare against a negative literal.
// Exercises that i8 is wired as a 1-byte SIGNED primitive (is_signed_integer):
// -10 + 4 == -6 -> exit 70. A wrong (unsigned) treatment would mis-compare.
use omega::language::std::console;

data Main {
    console: Console;
    v: i8;
}

machine Main::main(&mut self) {
    self.v = -10;
    self.v = self.v + 4;
    transition self.v == -6 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
