// i16 fields: SIGNED 2-byte store, arithmetic, and ordered comparison.
// -1000 + 400 == -600 needs the full 16-bit width (does not fit in 1 byte)
// and sign (-600 as unsigned 16-bit is 64936). The second transition checks
// a signed ordered guard (`< 0`) at 2-byte width: a wrong unsigned treatment
// would see 64936 > 0 and take the bad arm. Exit 70 on success.
use omega_language_std::console;

data Main {
    v: i16;
}

machine Main::main(main: &mut Main) reaches Console {
    main.v = -1000;
    main.v = main.v + 400;
    transition main.v == -600 {
        true -> check_negative(main)
        _ -> bad(main)
    }

    state check_negative(main: &mut Main) {
        transition main.v < 0 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
