// Expected exit: 0. Explicit model premises, never the producer's pointer width.
data Image [copy] { base: addr; }

machine direct(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{ value as u64 }

machine field(image: &Image) -> u64
requires addr::Bound == 18446744073709551616
{ image.base as u64 }

machine identity(value: addr) -> addr ensures result == value { value }

machine result(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{ identity(value) as u64 }

machine local(image: &Image) -> u64
requires addr::Bound == 18446744073709551616
{
    let saved: addr = image.base;
    saved as u64
}

machine via_state(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    transition { _ -> convert(value) }
    state convert(value: addr) -> u64
    requires addr::Bound == 18446744073709551616
    { value as u64 }
}

machine bounded(value: addr) -> u64
requires addr::Bound <= 18446744073709551616
{ value as u64 }

machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let image: Image = Image { base: 18446744073709551615 as addr };
    let parameter_value: u64 = direct(image.base);
    let field_value: u64 = field(&image);
    let result_value: u64 = result(image.base);
    let local_value: u64 = local(&image);
    let state_value: u64 = via_state(image.base);
    let bounded_value: u64 = bounded(image.base);
    transition parameter_value == 18446744073709551615 &&
        field_value == parameter_value && result_value == parameter_value &&
        local_value == parameter_value && state_value == parameter_value &&
        bounded_value == parameter_value && direct(0 as addr) == 0 {
        true -> done()
        _ -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
