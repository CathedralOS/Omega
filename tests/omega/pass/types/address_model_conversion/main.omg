// Expected exit: 0. Explicit model premises, never the producer's pointer width.
data Image [copy] { base: addr; }

machine direct(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{ value as u64 }

machine field(image: &Image) -> u64
requires addr::Bound == 18446744073709551616
{ image.base as u64 }

machine identity(value: addr) -> addr ensures result == value { value }

machine result(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{ identity(value) as u64 }

machine local(image: &Image) -> u64
requires addr::Bound == 18446744073709551616
{
    let saved: addr = image.base;
    saved as u64
}

machine via_state(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    transition { _ -> convert(value) }
    machine convert(value: addr) -> u64
    requires addr::Bound == 18446744073709551616
    { value as u64 }
}

machine bounded(value: addr) -> u64
requires addr::Bound <= 18446744073709551616
{ value as u64 }

// Implicit zero storage is a declaration without an initializer expression.
// It must not erase an unrelated address-model premise later in the state.
machine after_zero_record(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    let empty: Image;
    value as u64
}

machine after_zero_array(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    let empty: [u8; 8];
    value as u64
}

data Pending where number > 0 { number: u64; }
machine after_unestablished_storage(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    let pending: Pending;
    value as u64
}

data ImageView<'image> { image: &'image Image; }
machine replace_image<'image>(view: &mut ImageView<'image>, replacement: &'image Image) -> u64 {
    view.image = replacement;
    0
}

// Replacing a stored reference invalidates its captured origin. An unknown
// write frame cannot erase the immutable model or an earlier scalar snapshot.
machine after_reference_replacement(value: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    let first: Image = Image { base: value };
    let second: Image = Image { base: 0 as addr };
    let mut view: ImageView = ImageView { image: &first };
    let saved: addr = view.image.base;
    let status: u64 = replace_image(&mut view, &second);
    saved as u64
}

machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let image: Image = Image { base: 18446744073709551615 as addr };
    let parameter_value: u64 = direct(image.base);
    let field_value: u64 = field(&image);
    let result_value: u64 = result(image.base);
    let local_value: u64 = local(&image);
    let state_value: u64 = via_state(image.base);
    let bounded_value: u64 = bounded(image.base);
    let zero_record_value: u64 = after_zero_record(image.base);
    let zero_array_value: u64 = after_zero_array(image.base);
    let unestablished_value: u64 = after_unestablished_storage(image.base);
    let replaced_value: u64 = after_reference_replacement(image.base);
    transition parameter_value == 18446744073709551615 &&
        field_value == parameter_value && result_value == parameter_value &&
        local_value == parameter_value && state_value == parameter_value &&
        bounded_value == parameter_value && zero_record_value == parameter_value &&
        zero_array_value == parameter_value && unestablished_value == parameter_value &&
        replaced_value == parameter_value &&
        direct(0 as addr) == 0 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
