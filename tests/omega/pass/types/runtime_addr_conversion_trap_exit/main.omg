// A dynamically received address whose numeric value exceeds i32 traps at
// an explicit guard before exact coercion. Address storage grants no count identity.
use omega_language_std::console;

data Main { address: addr; result: i32; }

machine convert(input: addr) -> i32
crashes Trap
{
    transition input > 2147483647 {
        true -> invalid(input)
        _ -> (input as i32)
    }
    state invalid(input: addr) -> i32
    requires input > 2147483647
    { crash Trap; }
}

machine Main::main(context: &mut Main) reaches Console {
    context.address = 2147483648;
    context.result = convert(context.address);
    Console::exit_process(context.result);
}
