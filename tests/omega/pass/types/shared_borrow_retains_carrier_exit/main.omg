// Expected exit: 0.
machine read(value: &u64) -> u64 { value }
machine read_address(value: &addr) -> addr { value }
machine main() crashes Trap {
    let value: u64 = 7;
    let raw: addr = address_of(&value);
    let observed: u64 = read(value);
    let address: addr = read_address(raw);
    transition observed == value && address == raw { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
