// Exact address offsets and distances retain their carriers; address order is unsigned.
// This uses static calls and receiver-free states. Exit 70 is the authored oracle.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let address: addr = 4096;
    let offset: addr = address - 16;
    transition offset == 4080 {
        true -> distance(&main.console)
        false -> bad_offset(&main.console)
    }
    state distance(console: &Binding<Console>) {
        let left: addr = 4096;
        let right: addr = 4000;
        let count: u64 = left - right;
        transition count == 96 {
            true -> order(console)
            false -> bad_distance(console)
        }
    }
    state order(console: &Binding<Console>) {
        let left: addr = 4000;
        let right: addr = 4096;
        let ordered: bool = left < right;
        transition ordered == true {
            true -> good(console)
            false -> bad_order(console)
        }
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad_offset(console: &Binding<Console>) { Console::exit_process(console, 71); }
    state bad_distance(console: &Binding<Console>) { Console::exit_process(console, 72); }
    state bad_order(console: &Binding<Console>) { Console::exit_process(console, 73); }
}
