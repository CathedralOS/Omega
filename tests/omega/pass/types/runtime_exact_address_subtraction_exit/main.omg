// Exact address offsets and distances retain their carriers; address order is unsigned.
// This uses static calls and receiver-free states. Exit 70 is the authored oracle.
use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let address: addr = 4096;
    let offset: addr = address - 16;
    transition offset == 4080 {
        true -> distance()
        false -> bad_offset()
    }
    state distance() {
        let left: addr = 4096;
        let right: addr = 4000;
        let count: u64 = left - right;
        transition count == 96 {
            true -> order()
            false -> bad_distance()
        }
    }
    state order() {
        let left: addr = 4000;
        let right: addr = 4096;
        let ordered: bool = left < right;
        transition ordered == true {
            true -> good()
            false -> bad_order()
        }
    }
    state good() { Console::exit_process(70); }
    state bad_offset() { Console::exit_process(71); }
    state bad_distance() { Console::exit_process(72); }
    state bad_order() { Console::exit_process(73); }
}
