// Signed 64-bit field arithmetic: -42 - 8 == -50 -> exit 70. REWRITTEN from
// the retired `isize` (usize-retirement stage 2, 2026-07-15: "we have addr,
// we have primitives" -- the pointer-width-signed spelling dies with its
// unsigned twin; this canary's original purpose was pinning that isize
// reached layout at all).
use omega::language::std::console;

data Main {
    console: Console;
    v: i64;
}

machine Main::main(&mut self) {
    self.v = -42;
    self.v = self.v - 8;
    transition self.v == -50 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
