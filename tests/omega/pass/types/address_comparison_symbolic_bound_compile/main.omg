// Compile-only: anonymous peers land in addr using prior target-model facts.
data AddressCell { pointer: addr; }
machine parameter(value: addr) -> bool requires value == 0; { value == 0 }
machine field(cell: AddressCell) -> bool requires cell.pointer == 0; { cell.pointer == 0 }
machine typed(left: addr, right: addr) -> bool { left == right }
machine permitted(value: addr) -> bool
requires addr::Bound == 16
requires value == 15; { value == 15 }

// The first requirement has its own conditional model-fit recipe. The later
// requirement does not retroactively form it or supply its missing premise.
machine future_bound(value: addr) -> bool
requires value == 15
requires addr::Bound == 16; { true }

machine admitted(witness: addr) -> bool
requires embed(witness) == 15; { true }
machine local_admission() -> bool
requires addr::Bound == 16
{
    let witness: addr = 15;
    admitted(witness)
}
machine computed_landing() -> bool
requires addr::Bound == 16
{
    let value: addr = (1 + 2);
    value == (1 + 2)
}

machine accepts(value: addr) -> bool { true }
machine specification_argument() -> bool
requires addr::Bound == 16
requires accepts(15); { true }
