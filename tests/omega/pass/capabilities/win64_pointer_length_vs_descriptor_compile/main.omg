// ENT2c: identical scalar members do not make these foreign declarations ABI
// equivalent. Microsoft x64 passes the separate pointer and length in two
// positional registers, while the 16-byte descriptor is one indirect
// aggregate argument backed by a caller-owned copy.
// Each hosted target binds its own evaluated typed locator through a
// target-scoped producer: PE by-name on Windows, versioned ELF on Linux,
// and one Mach-O dylib symbol on macOS AArch64.
use omega::language::core::external_binding;

public data ByteDescriptor {
    pointer: addr;
    length: u64;
}

public boundary trait NativeByteShapes {
    machine take_separate(pointer: addr, length: u64) -> i32 reaches;
    machine take_descriptor(value: ByteDescriptor) -> i32 reaches;
}


data Main {
    pointer: addr;
    length: u64;
    status: i32;
}

machine Main::main(main: &mut Main) reaches NativeByteShapes {
    main.status = NativeByteShapes::take_separate(main.pointer, main.length);
    let d: ByteDescriptor = ByteDescriptor { pointer: main.pointer, length: main.length };
    main.status = NativeByteShapes::take_descriptor(d);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches NativeByteShapes {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
