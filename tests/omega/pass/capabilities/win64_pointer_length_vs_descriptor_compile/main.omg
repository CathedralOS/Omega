// ENT2c: identical scalar members do not make these foreign declarations ABI
// equivalent. Microsoft x64 passes the separate pointer and length in two
// positional registers, while the 16-byte descriptor is one indirect
// aggregate argument backed by a caller-owned copy.
// Each hosted target binds its own evaluated typed locator through a
// target-scoped producer: PE by-name on Windows, versioned ELF on Linux,
// and one Mach-O dylib symbol on macOS AArch64.
use omega::language::core::external_binding;
use omega::language::core::binding;

pub data ByteDescriptor {
    pointer: addr;
    length: u64;
}

pub boundary trait NativeByteShapes {
    machine take_separate(pointer: addr, length: u64) -> i32;
    machine take_descriptor(value: ByteDescriptor) -> i32;
}

windows_x86_64 machine take_separate_binding() -> ForeignBinding<19, 25, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_win64_take_separate",
        },
    }
}

linux_x86_64 machine take_separate_binding() -> ForeignBinding<21, 25, 7> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libomega_abi_probe.so",
            symbol: "omega_win64_take_separate",
            version: "OMEGA_1",
        },
    }
}

macos_arm64 machine take_separate_binding() -> ForeignBinding<24, 26, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libomega_abi_probe.dylib",
            symbol: "_omega_win64_take_separate",
        },
    }
}

windows_x86_64 machine take_descriptor_binding() -> ForeignBinding<19, 27, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_win64_take_descriptor",
        },
    }
}

linux_x86_64 machine take_descriptor_binding() -> ForeignBinding<21, 27, 7> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libomega_abi_probe.so",
            symbol: "omega_win64_take_descriptor",
            version: "OMEGA_1",
        },
    }
}

macos_arm64 machine take_descriptor_binding() -> ForeignBinding<24, 28, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libomega_abi_probe.dylib",
            symbol: "_omega_win64_take_descriptor",
        },
    }
}

machine take_separate(pointer: addr, length: u64) -> i32 satisfies NativeByteShapes::take_separate via take_separate_binding();
machine take_descriptor(value: ByteDescriptor) -> i32 satisfies NativeByteShapes::take_descriptor via take_descriptor_binding();

data Main {
    foreign: Binding<NativeByteShapes>;
    pointer: addr;
    length: u64;
    descriptor: ByteDescriptor;
    status: i32;
}

machine Main::main(&mut self) reaches NativeByteShapes {
    self.status = self.foreign.take_separate(self.pointer, self.length);
    self.status = self.foreign.take_descriptor(self.descriptor);
}
