// A fixed 16-byte non-HFA record is returned by value in x0/x1. The compiler
// test verifies that both fragments spill into one aggregate result place.
use omega::language::core::external_binding;
use omega::language::core::service;

pub data Pair {
    first: u64;
    second: u64;
}

pub boundary trait AggregateResultImport {
    machine call(seed: i64) -> Pair;
}

macos_arm64 machine aggregate_result_binding() -> ForeignBinding<17, 34, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "omega_small_aggregate_result_probe",
        },
    }
}

macos_arm64 machine aggregate_result_import(seed: i64) -> Pair satisfies AggregateResultImport::call via aggregate_result_binding();

data Main { foreign: Binding<AggregateResultImport>; seed: i64; pair: Pair; }
machine Main::main(&mut self) reaches AggregateResultImport {
    self.seed = 7;
    self.pair = self.foreign.call(self.seed);
}
