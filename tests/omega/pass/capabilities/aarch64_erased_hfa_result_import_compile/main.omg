use omega::language::core::float_operations;

// An erased result field has no AAPCS64 transfer operation. The stripped Pair
// remains an HFA result whose two physical members spill from d0/d1.
data Evidence {
    case Only;
}

data Pair {
    first: f64;
    proof [erased]: Evidence;
    second: f64;
}

boundary trait HfaResultImport {
    machine call(seed: i64) -> Pair;
}

machine hfa_result_import(seed: i64) -> Pair satisfies HfaResultImport::call via Binding::DllImport("libSystem.B.dylib", "omega_hfa_result_probe");

data Main {
    foreign: HfaResultImport;
    seed: i64;
    pair: Pair;
}

machine Main::main(&mut self) {
    self.seed = 7;
    self.pair = self.foreign.call(self.seed);
}
