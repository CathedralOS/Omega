use omega::language::core::external_binding;
use omega::language::core::float_operations;
use omega::language::core::service;

// An erased result field has no AAPCS64 transfer operation. The stripped Pair
// remains an HFA result whose two physical members spill from d0/d1.
pub data Evidence {
    case Only;
}

pub data Pair {
    first: f64;
    proof [erased]: Evidence;
    second: f64;
}

pub boundary trait HfaResultImport {
    machine call(seed: i64) -> Pair;
}

macos_arm64 machine hfa_result_binding() -> Binding<17, 22, 0> {
    Binding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "omega_hfa_result_probe",
        },
    }
}

macos_arm64 machine hfa_result_import(seed: i64) -> Pair satisfies HfaResultImport::call via hfa_result_binding();

data Main {
    foreign: Service<HfaResultImport>;
    seed: i64;
    pair: Pair;
}

machine Main::main(&mut self) reaches HfaResultImport {
    self.seed = 7;
    self.pair = self.foreign.call(self.seed);
}
