machine build(builder: &mut Build) {
    Build::application(builder, "runtime_qualified_record_return_exit");
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, linux_arm64);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, linux_x86_64);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, macos_arm64);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, macos_x86_64);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, windows_x86_64);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, uefi_x86_64);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, cross_platform_cli);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, local_unchecked);
    Build::select_provider<Issuer, IssuerProviderIssuerImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
