domain [u8]::Utf8
requires
    valid_utf8(self);
// Service reach propagates through the call graph. A private helper omits its
// `reaches` row (the compiler infers its reached services), and the caller
// declares the inferred `Console` as its ceiling. The
// transitively-reached effect satisfies the declared ceiling.

boundary trait Console {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Console;
}

data App {
    console: Console;
}

machine App::greet(&mut self)
reaches
    Console
{
    self.helper();
}

machine App::helper(&mut self) {
    self.console.write_line("hi");
}

data Main {
    app: App;
}

machine Main::main(&mut self) {
    self.app.greet();
}
