domain [u8]::Utf8
requires
    valid_utf8(self);
// The direct boundary caller declares Console. Ordinary wrappers propagate
// that reach without repeating the declaration.

boundary trait Console {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Console;
}

data App {
    console: Console;
}

machine App::greet(&mut self) {
    self.helper();
}

machine App::helper(&mut self) reaches Console {
    self.console.write_line("hi");
}

data Main {
    app: App;
}

machine Main::main(&mut self) {
    self.app.greet();
}
