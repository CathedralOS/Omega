// Expected exit: 0
// These checked providers would cycle only if a consumer selected them together.
// Independent source checking admits both bodies; this product selects neither.

public data Services {
}

public boundary trait Alpha {
    machine alpha(services: &Services)
    reaches Alpha + Beta
    invokes Beta;
}

public boundary trait Beta {
    machine beta(services: &Services)
    reaches Alpha + Beta
    invokes Alpha;
}

machine alpha_checked(services: &Services)
satisfies Alpha::alpha
reaches Alpha + Beta
{
    Beta::beta(services);
}

machine beta_checked(services: &Services)
satisfies Beta::beta
reaches Alpha + Beta
{
    Alpha::alpha(services);
}

// An unrelated root makes the unselected library declarations executable.
machine main() {}
