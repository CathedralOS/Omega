// A fixed aggregate above 16 bytes crosses AAPCS64 indirectly: the caller
// passes a pointer to a stack copy in x0 and the result destination in x8.
use omega::language::core::external_binding;
use omega::language::core::binding;

pub data Triple {
    first: u64;
    second: u64;
    third: u64;
}

pub boundary trait LargeAggregateImport {
    machine call(value: Triple) -> Triple;
}

macos_arm64 machine large_aggregate_binding() -> ForeignBinding<17, 27, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "omega_large_aggregate_probe",
        },
    }
}

macos_arm64 machine large_aggregate_import(value: Triple) -> Triple satisfies LargeAggregateImport::call via large_aggregate_binding();

data Main { foreign: Binding<LargeAggregateImport>; input: Triple; result: Triple; }
machine Main::main(&mut self) reaches LargeAggregateImport {
    self.input = Triple { first: 1, second: 2, third: 3 };
    self.result = self.foreign.call(self.input);
}
