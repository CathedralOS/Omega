use omega::language::core::external_binding;

machine build(builder: &mut Build) {
    Build::application(builder, "win64_large_aggregate_result_import_compile");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);

 Build::bind<LargeAggregateResultImport::receive>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_win64_large_result_probe",
        },
    });
}
