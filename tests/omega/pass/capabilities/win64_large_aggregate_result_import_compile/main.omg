// Microsoft x64 returns larger records through a caller-owned destination in
// hidden RCX. The declared seed argument therefore shifts to RDX.
data Triple {
    first: u64;
    second: u64;
    third: u64;
}

boundary trait LargeAggregateResultImport {
    machine receive(seed: u64) -> Triple;
}

machine large_aggregate_result_import(seed: u64) -> Triple satisfies LargeAggregateResultImport::receive via Binding::DllImport("omega_abi_probe.dll", "omega_win64_large_result_probe");

data Main {
    foreign: LargeAggregateResultImport;
    seed: u64;
    result: Triple;
}
machine Main::main(&mut self) {
    self.seed = 7;
    self.result = self.foreign.receive(self.seed);
}
