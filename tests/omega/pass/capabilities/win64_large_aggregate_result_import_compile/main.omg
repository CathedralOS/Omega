// Microsoft x64 returns larger records through a caller-owned destination in
// hidden RCX. The declared seed argument therefore shifts to RDX.
use omega::language::core::external_binding;

public data Triple {
    first: u64;
    second: u64;
    third: u64;
}

public boundary trait LargeAggregateResultImport {
    machine receive(seed: u64) -> Triple reaches;
}


data Main {
    seed: u64;
    result: Triple;
}
machine Main::main(main: &mut Main) reaches LargeAggregateResultImport {
    main.seed = 7;
    main.result = LargeAggregateResultImport::receive(main.seed);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches LargeAggregateResultImport {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
