// Microsoft x64 returns larger records through a caller-owned destination in
// hidden RCX. The declared seed argument therefore shifts to RDX.
use omega::language::core::external_binding;
use omega::language::core::binding;

pub data Triple {
    first: u64;
    second: u64;
    third: u64;
}

pub boundary trait LargeAggregateResultImport {
    machine receive(seed: u64) -> Triple;
}

windows_x86_64 machine large_aggregate_result_binding() -> ForeignBinding<19, 30, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_win64_large_result_probe",
        },
    }
}

windows_x86_64 machine large_aggregate_result_import(seed: u64) -> Triple satisfies LargeAggregateResultImport::receive via large_aggregate_result_binding();

data Main {
    foreign: Binding<LargeAggregateResultImport>;
    seed: u64;
    result: Triple;
}
machine Main::main(&mut self) reaches LargeAggregateResultImport {
    self.seed = 7;
    self.result = self.foreign.receive(self.seed);
}
