// A native binding names the application it supplies. `Magnitude<Value>` is a
// generic boundary, so it has one slot per closed application; build.omg binds
// `Magnitude<i32>::of` to msvcrt `abs`, and the call below uses that same
// application. abs(-42) must come back as 42 through the result place (a
// missing delivery would read 0 and exit 71). The negative twin
// fail/capabilities/windows_applied_requirement_import_mismatch calls
// `Magnitude<u32>::of` against the same binding and must find no supply.
use omega_language_std::console;
public boundary trait Magnitude<Value> { machine of(value: i32) -> i32 reaches; }
data Main { m: i32; v: i32; }
machine Main::main(main: &mut Main) reaches Magnitude + Console {
    main.v = 0 - 42;
    main.m = Magnitude<i32>::of(main.v);
    transition main.m == 42 { true -> good(main) _ -> bad(main, 71) }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Magnitude + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
