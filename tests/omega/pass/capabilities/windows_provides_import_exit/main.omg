// EXTERNAL-LEAF import, END TO END on hosted windows_x86_64 (extern brief §12,
// hosted-consumption rung 2): a bodyless satisfying machine binds the boundary
// requirement through the typed compile-time producer `beeper_binding`, whose
// evaluated `ForeignBinding::DllImport { import: DllImport::PeByName { library:
// "msvcrt.dll", export: "abs" } }` value normalizes to the exact PE import
// locator at provider selection -- raw foreign bytes stay data, never ambient
// lookup strings. The call rides the GENERAL value-returning Win64 import
// encoder with the import table naming the BINDING's DLL (msvcrt.dll, never
// the KERNEL32 catalog default). Discriminating: abs(-42) must deliver 42
// through the result place (ZII would read 0 -> exit 71). FIELD-store
// discipline throughout (main.v arg, main.m result): host-call operands that
// are frame LOCALS fail under multi-dispatch selection (the parked
// pending/host/host_local_operand_dual_dispatch face -- catalog ops too).
// NATIVE-ONLY: the interpreter has no provider for authored bindings.
use omega::language::core::external_binding;
use omega_language_std::console;
use omega::language::core::binding;
pub boundary trait Beeper { machine beep(value: i32) -> i32; }
data Main { console: Binding<Console>; beeper: Binding<Beeper>; m: i32; v: i32; }
windows_x86_64 machine beeper_binding() -> ForeignBinding<10, 3, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    }
}
machine beeper_abs(value: i32) -> i32 satisfies Beeper::beep via beeper_binding();
machine Main::main(main: &mut Main) reaches Beeper + Console {
    main.v = 0 - 42;
    main.m = main.beeper.beep(main.v);
    transition main.m == 42 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
