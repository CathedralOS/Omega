use omega::language::core::float_operations;

// ENT2c: one by-value flat f64 record is one AAPCS64 HFA parameter. The
// compiler test verifies that its two fragments reach v0/v1 from the same
// storage place instead of selection degrading the record to a pointer.
data Pair {
    first: f64;
    second: f64;
}

boundary trait HfaImport {
    machine call(pair: Pair) -> i64;
}

machine hfa_import(pair: Pair) -> i64 satisfies HfaImport::call via Binding::DllImport("libSystem.B.dylib", "omega_hfa_probe");

data Main { foreign: HfaImport; pair: Pair; result: i64; }
machine Main::main(&mut self) {
    self.pair = Pair { first: 1.0, second: 2.0 };
    self.result = self.foreign.call(self.pair);
}
