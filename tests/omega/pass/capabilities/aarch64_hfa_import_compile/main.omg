use omega::language::core::external_binding;
use omega::language::core::float_operations;

// ENT2c: one by-value flat f64 record is one AAPCS64 HFA parameter. The
// compiler test verifies that its two fragments reach v0/v1 from the same
// storage place instead of selection degrading the record to a pointer.
public data Pair {
    first: f64;
    second: f64;
}

public boundary trait HfaImport {
    machine call(pair: Pair) -> i64 reaches;
}


data Main { pair: Pair; result: i64; }
machine Main::main(main: &mut Main) reaches HfaImport {
    main.pair = Pair { first: 1.0, second: 2.0 };
    main.result = HfaImport::call(main.pair);
}
