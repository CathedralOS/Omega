// Seven scalar arguments consume x0..x6. The following two-register record
// must move wholly to the normalized outgoing stack area, never split at x7.
use omega::language::core::external_binding;
use omega::language::core::binding;

pub data Pair { first: u64; second: u64; }

pub boundary trait AggregateStackImport {
    machine call(
        a0: u64,
        a1: u64,
        a2: u64,
        a3: u64,
        a4: u64,
        a5: u64,
        a6: u64,
        pair: Pair
    ) -> i64;
}

macos_arm64 machine aggregate_stack_binding() -> ForeignBinding<17, 33, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "omega_small_aggregate_stack_probe",
        },
    }
}

macos_arm64 machine aggregate_stack_import(
    a0: u64,
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    pair: Pair
) -> i64 satisfies AggregateStackImport::call via aggregate_stack_binding();

data Main { foreign: Binding<AggregateStackImport>; pair: Pair; result: i64; }
machine Main::main(&mut self) reaches AggregateStackImport {
    self.pair = Pair { first: 8, second: 9 };
    self.result = self.foreign.call(1, 2, 3, 4, 5, 6, 7, self.pair);
}
