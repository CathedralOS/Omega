use omega::language::core::external_binding;
use omega::language::core::float_operations;
use omega::language::core::binding;

// Evidence is semantic-only. The erased-stripped Pair is still a two-member
// AAPCS64 HFA and must feed d0/d1 from one aggregate source place.
pub data Evidence {
    case Only;
}

pub data Pair {
    first: f64;
    proof [erased]: Evidence;
    second: f64;
}

pub boundary trait HfaImport {
    machine call(pair: Pair) -> i64;
}

macos_arm64 machine hfa_binding() -> ForeignBinding<17, 15, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "omega_hfa_probe",
        },
    }
}

macos_arm64 machine hfa_import(pair: Pair) -> i64 satisfies HfaImport::call via hfa_binding();

data Main {
    foreign: Binding<HfaImport>;
    pair: Pair;
    result: i64;
}

machine Main::main(&mut self) reaches HfaImport {
    self.pair = Pair { first: 1.0, second: 2.0 };
    self.result = self.foreign.call(self.pair);
}
