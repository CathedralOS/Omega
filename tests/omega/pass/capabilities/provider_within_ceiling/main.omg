// The admission fixtures' positive twin: a provider declaring within its
// requirement's ceiling (and reaching nothing beyond) conforms and the
// program RUNS exit 70.
use omega::language::std::console;
data Main { console: Console; }

boundary trait Clock {
}

trait Meter {
    machine read_value(a: u64) -> u64 reaches Clock;
}

machine honest(a: u64) -> u64
satisfies Meter::read_value
reaches Clock
{
    transition { _ -> (a) }
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
