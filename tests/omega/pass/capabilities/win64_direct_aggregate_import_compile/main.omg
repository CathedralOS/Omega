// Microsoft x64 passes 1/2/4/8-byte records by value in the argument's
// positional integer register or stack slot. This eight-byte record sits
// between scalar arguments and therefore occupies RDX.
use omega::language::core::external_binding;
use omega::language::core::service;

pub data Pair32 {
    first: u32;
    second: u32;
}

pub boundary trait DirectAggregateImport {
    machine send(before: u64, value: Pair32, after: u64) -> i32;
}

windows_x86_64 machine direct_aggregate_binding() -> Binding<19, 34, 0> {
    Binding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_win64_direct_aggregate_probe",
        },
    }
}

windows_x86_64 machine direct_aggregate_import(before: u64, value: Pair32, after: u64) -> i32 satisfies DirectAggregateImport::send via direct_aggregate_binding();

data Main {
    foreign: Service<DirectAggregateImport>;
    before: u64;
    input: Pair32;
    after: u64;
    status: i32;
}
machine Main::main(&mut self) reaches DirectAggregateImport {
    self.before = 7;
    self.input = Pair32 { first: 1, second: 2 };
    self.after = 9;
    self.status = self.foreign.send(self.before, self.input, self.after);
}
