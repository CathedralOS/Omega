// Microsoft x64 returns 1/2/4/8-byte records by value in RAX. The compiler
// test pins the eight-byte spill into the aggregate result place.
use omega::language::core::external_binding;
use omega::language::core::service;

pub data Pair32 {
    first: u32;
    second: u32;
}

pub boundary trait DirectAggregateResultImport {
    machine receive(seed: u64) -> Pair32;
}

windows_x86_64 machine direct_aggregate_result_binding() -> ForeignBinding<19, 31, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_win64_direct_result_probe",
        },
    }
}

windows_x86_64 machine direct_aggregate_result_import(seed: u64) -> Pair32 satisfies DirectAggregateResultImport::receive via direct_aggregate_result_binding();

data Main {
    foreign: Binding<DirectAggregateResultImport>;
    seed: u64;
    result: Pair32;
}
machine Main::main(&mut self) reaches DirectAggregateResultImport {
    self.seed = 7;
    self.result = self.foreign.receive(self.seed);
}
