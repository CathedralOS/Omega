machine build(builder: &mut Build) {
    Build::application(builder, "selected_synchronous_chain");
    Build::select_provider<Alpha, SelectedAlpha>(builder, macos_arm64);
    Build::select_provider<Beta, SelectedBeta>(builder, macos_arm64);
    Build::select_provider<Alpha, SelectedAlpha>(builder, windows_x86_64);
    Build::select_provider<Beta, SelectedBeta>(builder, windows_x86_64);
    Build::select_provider<Alpha, SelectedAlpha>(builder, linux_x86_64);
    Build::select_provider<Beta, SelectedBeta>(builder, linux_x86_64);
    Build::select_provider<Alpha, SelectedAlpha>(builder, linux_arm64);
    Build::select_provider<Beta, SelectedBeta>(builder, linux_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
