// Expected exit: 0
// A selected whole provider contributes its checked direct invocation edges,
// not every edge permitted by its published ceiling.
public boundary trait Alpha {
    machine read() -> u64 reaches Alpha + Beta invokes Beta;
}
public boundary trait Beta {
    machine read() -> u64 reaches Alpha + Beta invokes Alpha;
}

SelectedAlpha satisfies Alpha {
    machine read() -> u64 { Beta::read() }
}
SelectedBeta satisfies Beta {
    machine read() -> u64 { 73 }
}

machine main() reaches Alpha + Beta crashes Trap {
    let value: u64 = Alpha::read();
    transition value == 73 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
