// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "acquires_through_helper_return");
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, linux_arm64);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, linux_x86_64);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, macos_arm64);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, macos_x86_64);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, windows_x86_64);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, uefi_x86_64);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, cross_platform_cli);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, local_unchecked);
    Build::select_provider<Desktop, DesktopProviderDesktopImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
