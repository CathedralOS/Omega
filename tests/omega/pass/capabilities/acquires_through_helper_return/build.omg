// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    builder.application("acquires-through-helper-return");
    builder.select_provider<Desktop, DesktopProvider>();
    builder.roots.bind(windows_x86_64::ProgramEntry, Probe::enter);
    builder.roots.bind(linux_x86_64::ProgramEntry, Probe::enter);
    builder.roots.bind(linux_arm64::ProgramEntry, Probe::enter);
    builder.roots.bind(macos_arm64::ProgramEntry, Probe::enter);
}
