// Chapter 18 "Invariant Parameters": imported signatures lean on domain-
// qualified slice types such as `&mut [u8] in Writable & Initialized`. The
// domain qualifiers on a slice parameter are parsed and retained in the
// boundary requirement.

domain [u8]::Writable;
domain [u8]::Initialized;

boundary trait WindowsFile {
    machine read(buffer: &mut [u8] in Writable & Initialized, n: u64) -> bool
    reaches
        WindowsFile;
}

data Main {
}

machine Main::main(&mut self) {
}
