use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;

machine build(builder: &mut Build) {
    Build::application(builder, "sysv_small_aggregate_import_compile");
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind<AggregateImport::call>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libomega-probes.so",
            symbol: "omega_sysv_small_aggregate_probe",
            version: "OMEGA_1",
        },
    });
}
