use omega::language::core::external_binding;
use omega::language::core::float_operations;
use omega::language::core::service;

// ENT2c: fixed arrays are by-value aggregate shapes. They never decay to a
// pointer merely because a native external leaf consumes them. The explicit
// `&[u8; 16]` parameter is the distinct pointer form. Its ordinary shared loan
// lasts only through the synchronous call: the owner is mutable again after
// the foreign leaf returns.
// Each hosted target binds its own evaluated typed locator through a
// target-scoped producer: PE by-name on Windows, versioned ELF on Linux,
// and one Mach-O dylib symbol on macOS AArch64.
pub boundary trait NativeFixedArrays {
    machine take_bytes(value: [u8; 16]) -> i32;
    machine take_floats(value: [f32; 4]) -> i32;
    machine take_pointer(value: &[u8; 16]) -> i32;
}

windows_x86_64 machine take_bytes_binding() -> ForeignBinding<19, 19, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_take_bytes_16",
        },
    }
}

linux_x86_64 machine take_bytes_binding() -> ForeignBinding<21, 19, 7> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libomega_abi_probe.so",
            symbol: "omega_take_bytes_16",
            version: "OMEGA_1",
        },
    }
}

macos_arm64 machine take_bytes_binding() -> ForeignBinding<24, 20, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libomega_abi_probe.dylib",
            symbol: "_omega_take_bytes_16",
        },
    }
}

windows_x86_64 machine take_floats_binding() -> ForeignBinding<19, 19, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_take_floats_4",
        },
    }
}

linux_x86_64 machine take_floats_binding() -> ForeignBinding<21, 19, 7> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libomega_abi_probe.so",
            symbol: "omega_take_floats_4",
            version: "OMEGA_1",
        },
    }
}

macos_arm64 machine take_floats_binding() -> ForeignBinding<24, 20, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libomega_abi_probe.dylib",
            symbol: "_omega_take_floats_4",
        },
    }
}

windows_x86_64 machine take_pointer_binding() -> ForeignBinding<19, 24, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "omega_abi_probe.dll",
            export: "omega_take_bytes_pointer",
        },
    }
}

linux_x86_64 machine take_pointer_binding() -> ForeignBinding<21, 24, 7> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libomega_abi_probe.so",
            symbol: "omega_take_bytes_pointer",
            version: "OMEGA_1",
        },
    }
}

macos_arm64 machine take_pointer_binding() -> ForeignBinding<24, 25, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libomega_abi_probe.dylib",
            symbol: "_omega_take_bytes_pointer",
        },
    }
}

machine take_bytes(value: [u8; 16]) -> i32 satisfies NativeFixedArrays::take_bytes via take_bytes_binding();
machine take_floats(value: [f32; 4]) -> i32 satisfies NativeFixedArrays::take_floats via take_floats_binding();
machine take_pointer(value: &[u8; 16]) -> i32 satisfies NativeFixedArrays::take_pointer via take_pointer_binding();

data Main {
    foreign: Binding<NativeFixedArrays>;
    bytes: [u8; 16];
    floats: [f32; 4];
    status: i32;
}

machine Main::main(&mut self) reaches NativeFixedArrays {
    self.status = self.foreign.take_bytes(self.bytes);
    self.status = self.foreign.take_floats(self.floats);
    self.status = self.foreign.take_pointer(&self.bytes);
    self.bytes[0] = 70;
}
