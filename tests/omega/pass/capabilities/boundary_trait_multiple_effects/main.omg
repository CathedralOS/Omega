pub domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
// A single boundary machine may declare more than one service identity; the
// declared set is the ceiling for that surface. This fetch reaches both `Net`
// and `Allocator`, exercising a multi-service boundary declaration.

boundary trait Allocator {
}

pub boundary trait Net {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Net
        Allocator;
}

data Client {
}

machine Client::run(client: &mut Client) reaches Net + Allocator {
    Net::write_line("payload");
}

data Main {
    client: Client;
}

machine Main::main(main: &mut Main) {
    Client::run(&mut main.client);
}
