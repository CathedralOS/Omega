// A fixed 16-byte non-HFA record remains one by-value AAPCS64 operand. The
// leading scalar consumes x0 and the record fragments load into x1/x2.
use omega::language::core::external_binding;
use omega::language::core::service;

pub data Pair {
    first: u64;
    second: u64;
}

pub boundary trait AggregateImport {
    machine call(tag: u64, pair: Pair) -> i64;
}

macos_arm64 machine aggregate_binding() -> ForeignBinding<17, 27, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "omega_small_aggregate_probe",
        },
    }
}

macos_arm64 machine aggregate_import(tag: u64, pair: Pair) -> i64 satisfies AggregateImport::call via aggregate_binding();

data Main { foreign: Binding<AggregateImport>; pair: Pair; result: i64; }
machine Main::main(&mut self) reaches AggregateImport {
    self.pair = Pair { first: 1, second: 2 };
    self.result = self.foreign.call(7, self.pair);
}
