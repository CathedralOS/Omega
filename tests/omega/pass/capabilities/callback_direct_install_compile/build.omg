use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "callback_direct_install_compile");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, linux_x86_64::ProgramEntry, main);

 Build::bind<HookRegistrar::install>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "omega_probe_install",
            version: "OMEGA_1",
        },
    });
}
