// A ProgramEntry receiver establishes a Binding field reached through a
// nested record whose data `where` facts its zero value satisfies. The facts
// constrain the record's scalar field; they do not hide the record's service
// field from establishment. Exit 70.
use omega_language_std::console;

data Session where retries <= 3 {
    retries: u64;
}

data Main {
    session: Session;
}

machine Main::main(main: &mut Main)
reaches Console
{
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
