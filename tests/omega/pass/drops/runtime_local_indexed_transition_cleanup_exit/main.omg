use omega_language_std::console;

data Leaf { value: i32 [0..=100]; }
data Pair { left: Leaf; right: Leaf; }
data Bundle { pairs: [Pair; 2]; }
data Main { }

// Local establishments and parameters carry the same projected custody.
// The path crosses a field, an array index and another field; both roots
// have surviving siblings that must not overwrite either captured value.
machine select(first: Bundle) -> i32 {
    let second: Pair = Pair { left: Leaf { value: 9 }, right: Leaf { value: 23 } };
    transition { _ -> finish(first.pairs[1].left, second.right) }
    state finish(left: Leaf, right: Leaf) -> i32 {
        left.value + right.value
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let first: Bundle = Bundle { pairs: [
        Pair { left: Leaf { value: 3 }, right: Leaf { value: 4 } },
        Pair { left: Leaf { value: 19 }, right: Leaf { value: 8 } }
    ] };
    let result: i32 = select(first);
    transition result == 42 {
        true -> finish(main, 0)
        _ -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
