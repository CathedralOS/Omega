use omega::language::core::binding;
use omega::language::core::external_binding;

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
pub boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;

    machine exit_process(return_code: i32)
    reaches Console;
}

pub data ConsoleNativeProvider {}

macos_arm64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
macos_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;
linux_x86_64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
linux_x86_64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;
linux_arm64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
linux_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;

// Windows writes the byte to stdout through MSVCRT `_write`, one byte from
// the low byte of an i32 cell.
data WindowsConsoleIo { }
boundary requirement WindowsConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
terminates;
reaches Console;
data WindowsConsoleImports { }
windows_x86_64 machine console_write_binding() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "_write",
        },
    }
}
windows_x86_64 machine WindowsConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    satisfies WindowsConsoleIo::write
    via console_write_binding();
windows_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}
windows_x86_64 machine exit_process_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "ExitProcess",
        },
    }
}
windows_x86_64 machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process
    via exit_process_binding();

// A consumed owner drops during the selected call. A skipped owner remains
// behind younger B and C until normal completion, including nested selection.
data Token<'binding> { console: &'binding Binding<Console>; value: u64; byte: i32; }
data Wrapped { token: Token; }

machine Token::drop(token: &mut Token<'binding>) reaches Console {
    Console::write_byte(token.console, token.byte);
}
machine consume(value: Wrapped) -> u64 reaches Console { value.token.value }

machine and_transfer(console: &Binding<Console>, enabled: bool) -> bool reaches Console {
    let token: Token = Token { console: console, value: 9, byte: 65 };
    let survivor: Token = Token { console: console, value: 10, byte: 66 };
    let observed: bool = enabled && consume(Wrapped { token: token }) == 9;
    let youngest: Token = Token { console: console, value: 11, byte: 67 };
    (observed == enabled) && survivor.value == 10 && youngest.value == 11
}

machine or_transfer(console: &Binding<Console>, enabled: bool) -> bool reaches Console {
    let token: Token = Token { console: console, value: 9, byte: 65 };
    let survivor: Token = Token { console: console, value: 10, byte: 66 };
    let observed: bool = enabled || consume(Wrapped { token: token }) == 9;
    let youngest: Token = Token { console: console, value: 11, byte: 67 };
    observed && survivor.value == 10 && youngest.value == 11
}

machine nested_transfer(console: &Binding<Console>, outer: bool, inner: bool) -> bool reaches Console {
    let token: Token = Token { console: console, value: 9, byte: 65 };
    let survivor: Token = Token { console: console, value: 10, byte: 66 };
    let observed: bool = outer && (inner || consume(Wrapped { token: token }) == 9);
    let youngest: Token = Token { console: console, value: 11, byte: 67 };
    (observed == outer) && survivor.value == 10 && youngest.value == 11
}

machine branch_birth(console: &Binding<Console>, enabled: bool) -> bool reaches Console {
    let survivor: Token = Token { console: console, value: 10, byte: 66 };
    let observed: bool = enabled && consume(Wrapped {
        token: Token { console: console, value: 9, byte: 65 }
    }) == 9;
    let youngest: Token = Token { console: console, value: 11, byte: 67 };
    (observed == enabled) && survivor.value == 10 && youngest.value == 11
}

machine overwritten_condition(console: &Binding<Console>, enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let token: Token = Token { console: console, value: 9, byte: 65 };
    let survivor: Token = Token { console: console, value: 10, byte: 66 };
    let observed: bool = selected && consume(Wrapped { token: token }) == 9;
    selected = !selected;
    let youngest: Token = Token { console: console, value: 11, byte: 67 };
    (observed == enabled) && selected != enabled
        && survivor.value == 10 && youngest.value == 11
}

data Receipt [linear] { value: u64; }
data ReceiptEnvelope { receipt: Receipt; }
machine Receipt::drop(receipt: &mut Receipt) {
    receipt.value = 0;
}
machine mint_receipt() -> Receipt { Receipt { value: 11 } }
machine consume_receipt(receipt: Receipt) -> u64 { receipt.value }
machine linear_selection(enabled: bool) -> bool {
    let receipt: Receipt = mint_receipt();
    let observed: bool = enabled && consume_receipt(receipt) == 11;
    observed == enabled
}
machine forward_receipt(envelope: ReceiptEnvelope) -> ReceiptEnvelope { envelope }
machine extract_receipt(envelope: ReceiptEnvelope) -> Receipt { envelope.receipt }
machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}
machine combine(observed: bool, expected: bool, count: u64) -> bool {
    (observed == expected) && count == 1
}

// The suffix starts inside the argument schedule. Its mutation runs once;
// a later call establishes a new linear receipt and construction forwards it.
machine mid_argument(console: &Binding<Console>, enabled: bool) -> bool reaches Console {
    let token: Token = Token { console: console, value: 9, byte: 65 };
    let survivor: Token = Token { console: console, value: 10, byte: 66 };
    let mut count: u64 = 0;
    let observed: bool = combine(
        enabled && consume(Wrapped { token: token }) == 9,
        enabled,
        tick(&mut count)
    );
    let receipt: Receipt = mint_receipt();
    let envelope: ReceiptEnvelope = ReceiptEnvelope { receipt: receipt };
    let extracted: Receipt = extract_receipt(envelope);
    let nested: ReceiptEnvelope = ReceiptEnvelope {
        receipt: Receipt { value: 12 }
    };
    let forwarded: ReceiptEnvelope = forward_receipt(nested);
    let extracted_nested: Receipt = extract_receipt(forwarded);
    let youngest: Token = Token { console: console, value: 13, byte: 67 };
    observed && count == 1 && survivor.value == 10
        && extracted.value == 11 && extracted_nested.value == 12 && youngest.value == 13
        && linear_selection(enabled)
}

machine verify(console: &Binding<Console>, accepted: bool) reaches Console crashes Trap {
    Console::write_byte(console, 10);
    transition accepted { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    verify(&main.console, and_transfer(&main.console, false));
    verify(&main.console, and_transfer(&main.console, true));
    verify(&main.console, or_transfer(&main.console, true));
    verify(&main.console, or_transfer(&main.console, false));
    verify(&main.console, nested_transfer(&main.console, false, false));
    verify(&main.console, nested_transfer(&main.console, true, true));
    verify(&main.console, nested_transfer(&main.console, true, false));
    verify(&main.console, branch_birth(&main.console, false));
    verify(&main.console, branch_birth(&main.console, true));
    verify(&main.console, overwritten_condition(&main.console, false));
    verify(&main.console, overwritten_condition(&main.console, true));
    verify(&main.console, mid_argument(&main.console, false));
    verify(&main.console, mid_argument(&main.console, true));
}
