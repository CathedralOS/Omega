use omega::language::core::external_binding;

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
pub boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}
pub data ConsoleNativeProvider {}
data PosixConsoleIo {}
boundary requirement PosixConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
terminates;
reaches Console;
data PosixConsoleImports {}
macos_arm64 machine macos_arm64_write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
linux_arm64 machine linux_arm64_write_binding() -> ForeignBinding<9, 5, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.17"
    } }
}
macos_arm64 machine PosixConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    satisfies PosixConsoleIo::write via macos_arm64_write_binding();
macos_arm64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
linux_x86_64 machine PosixConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    satisfies PosixConsoleIo::write via linux_x86_64_write_binding();
linux_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
linux_arm64 machine PosixConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    satisfies PosixConsoleIo::write via linux_arm64_write_binding();
linux_arm64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
// All bound targets are little-endian: the low byte is the first byte.
data WindowsConsoleIo {}
boundary requirement WindowsConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
terminates;
reaches Console;
data WindowsConsoleImports {}
windows_x86_64 machine windows_x86_64_write_binding() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "_write"
    } }
}
windows_x86_64 machine WindowsConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    satisfies WindowsConsoleIo::write via windows_x86_64_write_binding();
windows_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}

// Each selected transfer consumes its exact region. The skipped region stays
// behind younger roots until normal death, including after condition mutation.
data Token { value: u64; byte: i32; }
data Pair<Value> { first: Value; second: Value; }
machine Token::drop(token: &mut Token) reaches Console { Console::write_byte(token.byte); }
machine consume(token: Token) -> u64 reaches Console { token.value }

machine partial_record(enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let pair: Pair<Token> = Pair { first: Token { value: 9, byte: 65 }, second: Token { value: 10, byte: 66 } };
    let observed: bool = selected && consume(pair.first) == 9;
    selected = !selected;
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && pair.second.value == 10 && youngest.value == 11
}

machine partial_array(enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let tokens: [Token; 2] = [Token { value: 9, byte: 65 }, Token { value: 10, byte: 66 }];
    let observed: bool = selected && consume(tokens[0]) == 9;
    selected = !selected;
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && tokens[1].value == 10 && youngest.value == 11
}

machine replaced_field(enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let mut pair: Pair<Token> = Pair { first: Token { value: 9, byte: 65 }, second: Token { value: 10, byte: 66 } };
    let observed: bool = selected && consume(pair.first) == 9;
    selected = !selected;
    Console::write_byte(88);
    pair.first = Token { value: 12, byte: 68 };
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && pair.first.value == 12
        && pair.second.value == 10 && youngest.value == 11
}

machine replaced_element(enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let mut tokens: [Token; 2] = [Token { value: 9, byte: 65 }, Token { value: 10, byte: 66 }];
    let observed: bool = selected && consume(tokens[0]) == 9;
    selected = !selected;
    Console::write_byte(88);
    tokens[0] = Token { value: 12, byte: 68 };
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && tokens[0].value == 12
        && tokens[1].value == 10 && youngest.value == 11
}

machine replaced_owner(enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let mut token: Token = Token { value: 9, byte: 65 };
    let observed: bool = selected && consume(token) == 9;
    selected = !selected;
    Console::write_byte(88);
    token = Token { value: 12, byte: 68 };
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && token.value == 12 && youngest.value == 11
}

machine multiple_regions(enabled: bool) -> bool reaches Console {
    let pair: Pair<Token> = Pair { first: Token { value: 9, byte: 65 }, second: Token { value: 10, byte: 66 } };
    let first: bool = enabled && consume(pair.first) == 9;
    let second: bool = !enabled && consume(pair.second) == 10;
    let youngest: Token = Token { value: 11, byte: 67 };
    (first == enabled) && (second != enabled) && youngest.value == 11
}

machine replaced_container(enabled: bool) -> bool reaches Console {
    let mut pair: Pair<Token> = Pair { first: Token { value: 9, byte: 65 }, second: Token { value: 10, byte: 66 } };
    let observed: bool = enabled && consume(pair.first) == 9;
    Console::write_byte(88);
    pair = Pair { first: Token { value: 12, byte: 68 }, second: Token { value: 13, byte: 69 } };
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && pair.first.value == 12 && pair.second.value == 13 && youngest.value == 11
}

// An ordinary complement surrounds the selected subtree in declaration order.
data Triple { first: Token; middle: Token; last: Token; }
machine middle_region(enabled: bool) -> bool reaches Console {
    let triple: Triple = Triple {
        first: Token { value: 9, byte: 65 }, middle: Token { value: 10, byte: 66 },
        last: Token { value: 12, byte: 68 }
    };
    let observed: bool = enabled && consume(triple.middle) == 10;
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && triple.first.value == 9 && triple.last.value == 12 && youngest.value == 11
}

// Moving the affine slot also moves its optional linear payload, when present.
data ReceiptChoice { case Empty; case Held(receipt: Receipt, token: Token); }
data ReceiptHolder { slot: ReceiptChoice; }
machine consume_choice(choice: ReceiptChoice) -> u64 reaches Console {
    transition choice {
        ReceiptChoice::Empty -> 0
        ReceiptChoice::Held { receipt, token } -> finish(receipt, token)
    }
    state finish(receipt: Receipt, token: Token) -> u64 { receipt.value }
}
machine optional_record(enabled: bool, slot: ReceiptChoice, expected: u64) -> bool reaches Console {
    let holder: ReceiptHolder = ReceiptHolder { slot: slot };
    let observed: bool = enabled && consume_choice(holder.slot) == expected;
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && youngest.value == 11
}

// Old optional claims and newly established claims share the home, not identity.
data Receipt [linear] { value: u64; }
machine Receipt::drop(receipt: &mut Receipt) { receipt.value = 0; }
machine consume_receipt(receipt: Receipt) -> u64 { receipt.value }
machine linear_replacement(enabled: bool) -> bool {
    let mut pair: Pair<Receipt> = Pair {
        first: Receipt { value: 9 }, second: Receipt { value: 10 }
    };
    let observed: bool = enabled && consume_receipt(pair.first) == 9;
    pair.first = Receipt { value: 12 };
    (observed == enabled) && pair.first.value == 12 && pair.second.value == 10
}

machine verify(accepted: bool) reaches Console crashes Trap {
    Console::write_byte(10);
    transition accepted { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    verify(partial_record(false));
    verify(partial_record(true));
    verify(partial_array(false));
    verify(partial_array(true));
    verify(replaced_field(false));
    verify(replaced_field(true));
    verify(replaced_element(false));
    verify(replaced_element(true));
    verify(replaced_owner(false));
    verify(replaced_owner(true));
    verify(multiple_regions(false));
    verify(multiple_regions(true));
    verify(replaced_container(false));
    verify(replaced_container(true));
    verify(middle_region(false));
    verify(middle_region(true));
    verify(optional_record(false, ReceiptChoice::Empty, 0));
    verify(optional_record(true, ReceiptChoice::Empty, 0));
    verify(optional_record(false, ReceiptChoice::Held { receipt: Receipt { value: 9 }, token: Token { value: 9, byte: 65 } }, 9));
    verify(optional_record(true, ReceiptChoice::Held { receipt: Receipt { value: 9 }, token: Token { value: 9, byte: 65 } }, 9));
    verify(linear_replacement(false));
    verify(linear_replacement(true));
}
