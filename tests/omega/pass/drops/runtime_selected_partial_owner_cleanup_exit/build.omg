use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_selected_partial_owner_cleanup_exit");
    Build::select_provider<Console, NativeConsole>(builder, linux_arm64);
    Build::select_provider<Console, NativeConsole>(builder, linux_x86_64);
    Build::select_provider<Console, NativeConsole>(builder, macos_arm64);
    Build::select_provider<Console, NativeConsole>(builder, macos_x86_64);
    Build::select_provider<Console, NativeConsole>(builder, windows_x86_64);
    Build::select_provider<Console, NativeConsole>(builder, uefi_x86_64);
    Build::select_provider<Console, NativeConsole>(builder, cross_platform_cli);
    Build::select_provider<Console, NativeConsole>(builder, local_unchecked);
    Build::select_provider<Console, NativeConsole>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);

 Build::bind<PosixConsoleIo::write>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind<PosixConsoleIo::write>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } });
 Build::bind<PosixConsoleIo::write>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.17"
    } });
 Build::bind<WindowsConsoleIo::write>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "_write"
    } });
}
