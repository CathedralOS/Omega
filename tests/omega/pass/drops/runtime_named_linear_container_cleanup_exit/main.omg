data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) { receipt.code = 0; }
data Pair<Left, Right> { first: Left; second: Right; }
data Envelope<Contents> { contents: Contents; }
data PartlyZero { receipt: Receipt; marker: u64; }

machine consume(receipt: Receipt) -> u64 { receipt.code }
machine inspect(package: &Envelope<Pair<Receipt, Receipt>>) -> bool {
    package.contents.first.code == 7 && package.contents.second.code == 13
}
machine whole() -> bool {
    let package: Envelope<Pair<Receipt, Receipt>> = Envelope {
        contents: Pair { first: Receipt { code: 7 }, second: Receipt { code: 13 } }
    };
    let zero: Envelope<Receipt> = Envelope { contents: Receipt { code: 0 } };
    inspect(&package) && zero.contents.code == 0
}
machine residual() -> bool {
    let package: Envelope<Pair<Receipt, Receipt>> = Envelope {
        contents: Pair { first: Receipt { code: 7 }, second: Receipt { code: 13 } }
    };
    let moved: u64 = consume(package.contents.second);
    moved == 13 && package.contents.first.code == 7
}
machine parameter(package: Envelope<Pair<Receipt, Receipt>>) -> bool {
    inspect(&package)
}
machine array() -> bool {
    let package: Envelope<[Receipt; 2]> = Envelope {
        contents: [Receipt { code: 7 }, Receipt { code: 13 }]
    };
    package.contents[0].code == 7 && package.contents[1].code == 13
}
machine make_receipt(code: u64) -> Receipt { Receipt { code: code } }
machine returned() -> bool {
    let package: Envelope<Receipt>;
    package.contents = make_receipt(17);
    package.contents.code == 17
}
machine unfinished() -> bool {
    let untouched: Envelope<Receipt>;
    let mixed: PartlyZero;
    let package: Envelope<Pair<Receipt, Receipt>>;
    package.contents.first = Receipt { code: 7 };
    package.contents.first.code == 7 && mixed.marker == 0
}
machine main() crashes Trap {
    let first: bool = whole();
    let second: bool = residual();
    let third: bool = parameter(Envelope {
        contents: Pair { first: Receipt { code: 7 }, second: Receipt { code: 13 } }
    });
    let fourth: bool = array();
    let fifth: bool = unfinished();
    let sixth: bool = returned();
    transition first && second && third && fourth && fifth && sixth {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
