data Token { value: u64; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine main() crashes Trap {
    let mut tokens: [Token; 2] = [Token { value: 7 }, Token { value: 11 }];
    // Both RHS operands observe old values before any old-value hook runs.
    // Each selected hook must then operate on its own displaced element.
    tokens = [Token { value: tokens[1].value }, Token { value: tokens[0].value }];
    transition tokens[0].value == 11 && tokens[1].value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
