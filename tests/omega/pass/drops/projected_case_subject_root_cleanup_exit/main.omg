// A case dispatch on a field of an affine local (`item.kind`) observes that
// field; the record keeps its own custody. Each case disposes of it once: an
// arm that forwards it leaves its hook to the successor's return (P, then A),
// the `_` arm runs it on the edge before its successor starts (B, then S), and
// a returning arm runs it at the return (C). Counting the field dispatch as
// the record's consumer refused every forwarding arm ("structural result has
// no selected disposition").
use omega::language::core::binding;
use omega::language::core::external_binding;

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
pub boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;

    // The existing Console role review nominates output through a complete
    // provider with an exit row. This program never calls that row.
    machine exit_process(return_code: i32)
    reaches Console;
}

pub data ConsoleNativeProvider {}

macos_arm64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
macos_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;
linux_x86_64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
linux_x86_64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;
linux_arm64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
linux_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;

// Windows uses the existing authored import route for process exit.
// Windows writes the byte to stdout through MSVCRT `_write`, one byte from
// the low byte of an i32 cell.
data WindowsConsoleIo { }
boundary requirement WindowsConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
terminates;
reaches Console;
data WindowsConsoleImports { }
windows_x86_64 machine console_write_binding() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "_write",
        },
    }
}
windows_x86_64 machine WindowsConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    satisfies WindowsConsoleIo::write
    via console_write_binding();
windows_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}
windows_x86_64 machine exit_process_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "ExitProcess",
        },
    }
}
windows_x86_64 machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process
    via exit_process_binding();



data Kind [copy] { case Keep; case Pass; }
data Item<'binding> { console: &'binding Binding<Console>; ready: bool; kind: Kind; byte: i32; }

machine Item::drop(item: &mut Item<'binding>)
requires item.ready
reaches Console
{
    Console::write_byte(item.console, item.byte);
    item.ready = false;
}

machine route(console: &Binding<Console>, kind: Kind, byte: i32) reaches Console {
    let item: Item = Item { console: console, ready: true, kind: kind, byte: byte };
    transition item.kind {
        Kind::Pass -> take(console, item)
        _ -> skip(console)
    }
    state take(console: &Binding<Console>, item: Item)
    requires item.ready
    {
        Console::write_byte(console, 80);
    }
    state skip(console: &Binding<Console>) { Console::write_byte(console, 83); }
}

machine pick(console: &Binding<Console>, kind: Kind, byte: i32) -> i32 reaches Console {
    let item: Item = Item { console: console, ready: true, kind: kind, byte: byte };
    transition item.kind {
        Kind::Pass -> take(console, item)
        Kind::Keep -> (71)
    }
    state take(console: &Binding<Console>, item: Item) -> i32
    requires item.ready
    {
        Console::write_byte(console, 80);
        70
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    route(&main.console, Kind::Pass, 65);
    route(&main.console, Kind::Keep, 66);
    let kept: i32 = pick(&main.console, Kind::Keep, 67);
    let passed: i32 = pick(&main.console, Kind::Pass, 68);
    main.console.write_byte(kept);
    main.console.write_byte(passed);
    main.console.write_byte(10);
}
