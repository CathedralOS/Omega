// A case dispatch on a field of an affine local (`item.kind`) observes that
// field; the record keeps its own custody. Each case disposes of it once: an
// arm that forwards it leaves its hook to the successor's return (P, then A),
// the `_` arm runs it on the edge before its successor starts (B, then S), and
// a returning arm runs it at the return (C). Counting the field dispatch as
// the record's consumer refused every forwarding arm ("structural result has
// no selected disposition").

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.

public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}

PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
    }
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
    }
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    terminates;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    terminates;
}



data Kind [copy] { case Keep; case Pass; }
data Item { ready: bool; kind: Kind; byte: i32; }

machine Item::drop(item: &mut Item)
requires item.ready
reaches Console
{
    Console::write_byte(item.byte);
    item.ready = false;
}

machine route(kind: Kind, byte: i32) reaches Console {
    let item: Item = Item { ready: true, kind: kind, byte: byte };
    transition item.kind {
        Kind::Pass -> take(item)
        _ -> skip()
    }
    machine take(item: Item)
    requires item.ready
    {
        Console::write_byte(80);
    }
    machine skip() { Console::write_byte(83); }
}

machine pick(kind: Kind, byte: i32) -> i32 reaches Console {
    let item: Item = Item { ready: true, kind: kind, byte: byte };
    transition item.kind {
        Kind::Pass -> take(item)
        Kind::Keep -> (71)
    }
    machine take(item: Item) -> i32
    requires item.ready
    {
        Console::write_byte(80);
        70
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    route(Kind::Pass, 65);
    route(Kind::Keep, 66);
    let kept: i32 = pick(Kind::Keep, 67);
    let passed: i32 = pick(Kind::Pass, 68);
    Console::write_byte(kept);
    Console::write_byte(passed);
    Console::write_byte(10);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
