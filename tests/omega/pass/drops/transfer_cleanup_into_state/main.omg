// Chapter 17: a resource-owning
// value is moved into a target state through a transition argument. The source
// state hands its owned `Guard` to `hold(...)`, transferring the cleanup
// obligation; the receiving state owns it and lets it die. Move-into-target on a
// transition edge type-checks cleanly (moves are implicit in the ownership lane).

data Guard {
    handle: i32;
}

machine Guard::drop(&mut self) {
}

data Main {
}

machine Main::main(&mut self) {
    let g: Guard = Guard { handle: 1 };

    transition {
        _ -> hold(g)
    }

    state hold(&mut self, guard: Guard) {
        transition {
            _ -> done()
        }
    }

    state done(&mut self) {
    }
}
