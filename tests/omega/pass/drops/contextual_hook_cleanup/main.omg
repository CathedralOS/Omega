// Contextual cleanup: temporaries constructed as call arguments owe the
// selected hook's prerequisite at the exact owner. Two owners share the
// same hook shape but retain distinct cleanup actions, run in reverse
// argument order after the call.
data Guard { handle: i32; }
machine Guard::drop(guard: &mut Guard) {
    guard.handle = 0;
}
data Token { serial: i32; }
machine Token::drop(token: &mut Token) {
    token.serial = 0;
}

machine spend(guard: Guard, token: Token) -> i32 {
    ((guard.handle as i32 in Wrapping) + (token.serial as i32 in Wrapping)) as i32
}

data Main { spent: i32; }

machine Main::main(main: &mut Main) {
    main.spent = spend(Guard { handle: 30 }, Token { serial: 40 });
}
