data Token { ready: bool; value: u64; }
data Bundle { tokens: [Token; 2]; }

machine Token::drop(token: &mut Token)
requires token.ready
{
    token.ready = false;
}

machine clear(flag: &mut bool) -> u64 {
    flag = false;
    7
}

machine read(bundle: &Bundle) -> u64 { bundle.tokens[0].value }

machine main() crashes Trap {
    let mut flag: bool = true;
    // The first ready member captures true before its sibling changes flag.
    // Nested record/array assembly preserves that established value, not the
    // current value of its former source when the consumer returns.
    let answer: u64 = read(&Bundle { tokens: [
        Token { ready: flag, value: clear(&mut flag) },
        Token { ready: true, value: 8 }
    ] });
    transition answer == 7 && !flag {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
