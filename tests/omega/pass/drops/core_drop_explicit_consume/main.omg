// Chapter 17 explicit early disposal: `omega::language::core::drop` is the
// ordinary generic consuming machine. `drop(g)` moves the whole value into
// the callee, so the caller's path is proved by transfer; inside the machine
// `value` reaches its checked cleanup edge, which selects the exact
// `dropped by` hook `drop_guard` for the instantiated type. Erased fields
// remain semantically present but carry no runtime representation, so
// `Carrier`'s erased `Evidence` member never produces runtime cleanup — not
// even its own `drop_evidence` attachment — and `drop(c)` consumes the
// record without requiring a `dropped by` hook on `Carrier`.

use omega::language::core::drop;

data Evidence dropped by drop_evidence {
    tag: i32;
}

machine drop_evidence(evidence: &mut Evidence) {
}

data Guard dropped by drop_guard {
    handle: i32;
}

machine drop_guard(guard: &mut Guard) {
}

data Carrier {
    payload: i32;
    proof [erased]: Evidence;
}

machine main() {
    let g: Guard = Guard { handle: 7 };
    let c: Carrier = Carrier { payload: 1, proof: Evidence { tag: 0 } };
    drop(g);
    drop(c);
}
