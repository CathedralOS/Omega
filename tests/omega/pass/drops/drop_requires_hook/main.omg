// A drop hook carrying `requires`: `Token::drop` demands
// `token.value == 42` on the cleanup edge. A partially-constructed
// record constructs only `pair.right` — the untouched `left` storage has
// no valid Token and receives neither replacement nor exit cleanup.
domain u64::Positive(value) requires 1 <= value;
data Token { value: u64 in Positive; }
data Pair { left: Token; right: Token; }
machine Token::drop(token: &mut Token)
    requires token.value == 42
{
    token.value = 1;
}
machine main() {
    let mut pair: Pair;
    pair.right = Token { value: 42 };
    transition { _ -> done() }
    machine done() {}
}
