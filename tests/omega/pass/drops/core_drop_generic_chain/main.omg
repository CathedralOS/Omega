// Contextual cleanup crosses an explicit core `drop` and an unrelated
// generic call chain: the exact ready owner supplies each hook's
// prerequisite, and the identity-generic forward does not disturb it.
use omega::language::core::drop;

data Guard dropped by drop_guard { handle: i32; }
machine drop_guard(guard: &mut Guard) {
    guard.handle = 0;
}

machine id<T>(value: T) -> T {
    value
}

data Main { }

machine Main::main(main: &mut Main) {
    let g: Guard = id<Guard>(Guard { handle: 3 });
    drop(g);
}
