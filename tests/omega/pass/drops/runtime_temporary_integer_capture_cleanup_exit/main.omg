data Token { value: u64; marker: u64; }
machine Token::drop(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}
machine replace(source: &mut u64) -> u64 { source = 8; 0 }
machine read(token: &Token) -> u64 { token.value }
machine main() crashes Trap {
    let mut source: u64 = 7;
    let answer: u64 = read(&Token { value: source, marker: replace(&mut source) });
    transition answer == 7 && source == 8 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
