data Token { ready: bool; value: u64; }

machine Token::drop(token: &mut Token)
requires token.ready
{
    token.ready = false;
}

machine read(token: &Token) -> u64 { token.value }

// The hook is selected only by this helper's temporary action roster, not
// by an explicit Unit call in the entry machine or the helper's body.
machine evaluate() -> u64 { read(&Token { ready: true, value: 7 }) }

machine main() crashes Trap {
    let answer: u64 = evaluate();
    transition answer == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
