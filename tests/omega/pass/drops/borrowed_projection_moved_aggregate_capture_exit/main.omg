// Expected exit: 0. Moving a completed aggregate retains its child capture.
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) requires receipt.code == 7 {}
machine observe(receipt: &Receipt) {}
data Holder { receipt: Receipt; }
machine produce() -> Receipt ensures result.code == 7 { Receipt { code: 7 } }
machine main() {
    let first: Holder = Holder { receipt: produce() };
    observe(&Holder { receipt: first.receipt }.receipt);
}
