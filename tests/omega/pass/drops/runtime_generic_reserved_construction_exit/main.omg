domain u64::Positive(value) requires 1 <= value;

data Token { value: u64 in Positive; }
data Holder<T> { value: T; }

machine Token::drop(token: &mut Token)
requires token.value == 42
{
    token.value = 1;
}

machine main() crashes Trap {
    let mut holder: Holder<Token>;
    holder.value = Token { value: 42 };
    let observed: u64 = holder.value.value;
    transition { _ -> observe(observed) }
    state observe(observed: u64) {
        transition observed == 42 {
            true -> done()
            false -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
