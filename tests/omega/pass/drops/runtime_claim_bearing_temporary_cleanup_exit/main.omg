data Receipt [linear] { code: u64; }

machine Receipt::drop(receipt: &mut Receipt) {
    receipt.code = 0;
}

data Pair { first: Receipt; second: Receipt; }

machine inspect(pair: &Pair) -> bool {
    pair.first.code == 7 && pair.second.code == 13
}

machine selected(enabled: bool) -> bool {
    enabled && inspect(Pair {
        first: Receipt { code: 7 },
        second: Receipt { code: 13 }
    })
}

machine main() crashes Trap {
    let skipped: bool = selected(false);
    let observed: bool = selected(true);
    transition skipped == false && observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
