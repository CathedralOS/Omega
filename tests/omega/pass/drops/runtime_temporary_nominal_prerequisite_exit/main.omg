data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready
{
    token.ready = false;
}
machine read(token: &Token) -> u64 { token.value }
machine main() crashes Trap {
    let answer: u64 = read(&Token { ready: true, value: 7 });
    transition answer == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
