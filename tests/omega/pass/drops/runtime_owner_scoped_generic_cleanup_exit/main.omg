use omega::language::core::drop;

// The hook's type parameters belong to Envelope, not to the machine.
// Distinct closed static telescopes retain one source-backed carrier identity
// through the hook's remaining region application and core drop's exit.
data Envelope<'storage, Marker, Extra> {
    marker: Marker;
    extra: Extra;
    destination: &'storage mut i32;
}

// Missing cleanup leaves zero; duplicate cleanup toggles it back to zero.
machine write(destination: &mut i32) { destination = destination ^ 73; }

machine Envelope::drop(envelope: &mut Envelope<'storage, Marker, Extra>) {
    let marker: &Marker = &envelope.marker;
    let extra: &Extra = &envelope.extra;
    write(envelope.destination);
}

machine main() crashes Trap {
    let mut first: i32 = 0;
    let mut second: i32 = 0;
    let left: Envelope<[u64; 2], bool> = Envelope {
        destination: &mut first, marker: [41, 42], extra: true,
    };
    let right: Envelope<bool, u64> = Envelope {
        destination: &mut second, marker: false, extra: 19,
    };
    drop(left);
    drop(right);
    transition first == 73 && second == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
