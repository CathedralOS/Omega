// Expected exit: 0
// A selection's complement observes writes performed before its choice.
data Counter { drops: u64 in Wrapping; }
data AffineLeaf<'storage> { counter: &'storage mut Counter; }
machine AffineLeaf::drop(leaf: &mut AffineLeaf<'storage>) {
    leaf.counter.drops = leaf.counter.drops + 1;
}
data Envelope<Value> { case Held(value: Value); case Empty; }
machine Envelope::drop(envelope: &mut Envelope<Value>) {}
machine inspect_affine(envelope: Envelope<AffineLeaf>) -> u64 {
    transition envelope {
        Envelope::Held { .. } -> (1)
        Envelope::Empty -> (0)
    }
}
machine populate_and_choose<'storage>(
    envelope: &mut Envelope<AffineLeaf<'storage>>,
    counter: &'storage mut Counter,
    choose_first: bool
) -> bool {
    envelope = Envelope::Held { value: AffineLeaf { counter: counter } };
    choose_first
}
machine select_local<'storage>(
    counter: &'storage mut Counter,
    choose_first: bool
) -> Envelope<AffineLeaf<'storage>> {
    let mut first: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    let second: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    let selected: Envelope<AffineLeaf<'storage>> = match populate_and_choose(&mut first, counter, choose_first) {
        true -> first,
        false -> second,
    };
    selected
}
machine select_assignment<'storage>(
    counter: &'storage mut Counter,
    choose_first: bool
) -> Envelope<AffineLeaf<'storage>> {
    let mut first: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    let second: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    let mut selected: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    selected = match populate_and_choose(&mut first, counter, choose_first) {
        true -> first,
        false -> second,
    };
    selected
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { drops: 0 };
    let first: u64 = inspect_affine(select_local(&mut counter, true));
    let second: u64 = inspect_affine(select_local(&mut counter, false));
    let third: u64 = inspect_affine(select_assignment(&mut counter, true));
    let fourth: u64 = inspect_affine(select_assignment(&mut counter, false));
    transition first == 1 && second == 0 && third == 1 && fourth == 0 && counter.drops == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
