// Expected exit: 0. Borrowed temporary descriptors end before their backing
// hooks, once per owner, across ordinary and nested normal-call completions.
use omega::language::core::drop;

data Receipt { counter: &mut [u64; 1]; value: u64; }
machine Receipt::drop(receipt: &mut Receipt) {
    receipt.counter[0] = ((receipt.counter[0] as u64 in Wrapping) + 1) as u64;
}
machine issue(counter: &mut [u64; 1], value: u64) -> Receipt {
    Receipt { counter: counter, value: value }
}
data Observation { value: u64; }
data Envelope { observed: Observation; }
data ReceiptBorrow<'borrow> { receipt: &'borrow Receipt; }
machine lend<'borrow>(receipt: &'borrow Receipt) -> &'borrow Receipt { receipt }
machine wrap<'borrow>(receipt: &'borrow Receipt) -> ReceiptBorrow<'borrow> {
    ReceiptBorrow { receipt: receipt }
}
machine hold<'storage, 'borrow>(wrapper: &'storage ReceiptBorrow<'borrow>)
    -> &'storage ReceiptBorrow<'borrow> { wrapper }
boundary trait Reader {
    machine read(receipt: &Receipt) -> u64 reaches;
    machine copy(receipt: &Receipt) -> Observation reaches;
}
Provider satisfies Reader {
    machine read(receipt: &Receipt) -> u64 {
        transition receipt.counter[0] == 0 {
            true -> (receipt.value)
            false -> (0)
        }
    }
    machine copy(receipt: &Receipt) -> Observation { Observation { value: receipt.value } }
}
machine straight(counter: &mut [u64; 1]) -> u64 {
    Reader::read(&Receipt { counter: counter, value: 37 })
}
machine constructed<'borrow>(receipt: &'borrow Receipt) -> u64 {
    Reader::read(ReceiptBorrow { receipt: receipt }.receipt)
}
machine resident_projection<'borrow>(receipt: &'borrow Receipt) -> bool {
    let wrapper: ReceiptBorrow<'borrow> = wrap(receipt);
    let borrowed_value: u64 = Reader::read(hold(&wrapper).receipt);
    let resident_value: u64 = Reader::read(wrapper.receipt);
    borrowed_value == 61 && resident_value == 61
}
machine observe(envelope: &Envelope) -> u64 { envelope.observed.value }
machine main() reaches Reader crashes Trap {
    let mut constructed_drops: [u64; 1] = [0];
    let constructed: u64 = Reader::read(&Receipt { counter: &mut constructed_drops, value: 17 });
    let constructed_correct: bool = constructed == 17;
    let mut returned_drops: [u64; 1] = [0];
    let returned: u64 = Reader::read(&issue(&mut returned_drops, 23));
    let returned_correct: bool = returned == 23;
    let mut named_drops: [u64; 1] = [0];
    let named: Receipt = issue(&mut named_drops, 29);
    let first: u64 = Reader::read(&named);
    let second: u64 = Reader::read(&named);
    let named_correct: bool = first == 29 && second == 29;
    drop(named);
    let mut nested_drops: [u64; 1] = [0];
    let nested: Envelope = Envelope { observed: Reader::copy(&issue(&mut nested_drops, 31)) };
    let nested_correct: bool = nested.observed.value == 31;
    let mut straight_drops: [u64; 1] = [0];
    let straight_value: u64 = straight(&mut straight_drops);
    let straight_correct: bool = straight_value == 37;
    let mut scalar_drops: [u64; 1] = [0];
    let scalar_value: u64 = observe(&Envelope {
        observed: Reader::copy(&issue(&mut scalar_drops, 41))
    }) + 0;
    let scalar_correct: bool = scalar_value == 41;
    let mut lent_drops: [u64; 1] = [0];
    let lent_value: u64 = Reader::read(lend(issue(&mut lent_drops, 43))) + 0;
    let lent_correct: bool = lent_value == 43;
    let mut wrapped_drops: [u64; 1] = [0];
    let wrapped_value: u64 = Reader::read([wrap(&issue(&mut wrapped_drops, 47)).receipt][0]);
    let wrapped_correct: bool = wrapped_value == 47;
    let mut record_drops: [u64; 1] = [0];
    let record_value: u64 = constructed(&issue(&mut record_drops, 53));
    let record_correct: bool = record_value == 53;
    let mut array_drops: [u64; 1] = [0];
    let array_value: u64 = Reader::read([wrap(&issue(&mut array_drops, 59))][0].receipt);
    let array_correct: bool = array_value == 59;
    let mut resident_drops: [u64; 1] = [0];
    let resident: Receipt = issue(&mut resident_drops, 61);
    let resident_correct: bool = resident_projection(&resident);
    drop(resident);
    transition constructed_correct && returned_correct && named_correct
        && nested_correct && nested_drops[0] == 1 && straight_correct && straight_drops[0] == 1
        && constructed_drops[0] == 1 && returned_drops[0] == 1 && named_drops[0] == 1
        && scalar_correct && scalar_drops[0] == 1
        && lent_correct && lent_drops[0] == 1
        && wrapped_correct && wrapped_drops[0] == 1
        && record_correct && record_drops[0] == 1
        && array_correct && array_drops[0] == 1
        && resident_correct && resident_drops[0] == 1 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
