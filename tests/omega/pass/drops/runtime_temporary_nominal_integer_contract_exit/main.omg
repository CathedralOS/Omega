data Token { value: u64; }
machine Token::drop(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}
machine read(token: &Token) -> u64 { token.value }
machine main() crashes Trap {
    let answer: u64 = read(&Token { value: 7 });
    transition answer == 7 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
