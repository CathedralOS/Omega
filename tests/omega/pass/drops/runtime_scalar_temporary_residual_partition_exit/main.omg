data Token { value: u64; }
data Group { before: Token; selected: Token; after: Token; }
data Single { selected: Token; }

machine make_group(counter: &mut u64) -> Group {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Group { after: Token { value: 99 }, selected: Token { value: counter }, before: Token { value: 98 } }
}

machine make_single(counter: &mut u64) -> Single {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Single { selected: Token { value: counter } }
}

machine make_token(counter: &mut u64) -> Token {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Token { value: counter }
}

machine consume(left: Token, right: Token, borrowed: &Token, observed: &mut u64) -> u64 {
    observed = ((left.value as u64 in Wrapping) * 100 + (right.value as u64 in Wrapping) * 10 + (borrowed.value as u64 in Wrapping)) as u64;
    borrowed.value
}

machine consume_in_context(seed: Token, counter: &mut u64, observed: &mut u64) -> u64 {
    // The middle selection leaves two maximal residuals; Single leaves none.
    // Neither complement changes producer evaluation order or the live result.
    let answer: u64 = consume(make_group(counter).selected, make_single(counter).selected, &make_token(counter), observed);
    observed = ((observed as u64 in Wrapping) + (seed.value as u64 in Wrapping) * 1000) as u64;
    answer
}

machine main() crashes Trap {
    let mut counter: u64 = 0;
    let mut observed: u64 = 0;
    let answer: u64 = consume_in_context(make_token(&mut counter), &mut counter, &mut observed);
    transition answer == 4 && observed == 1234 && counter == 4 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
