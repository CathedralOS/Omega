data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready && token.value == 7
requires token.ready
requires token.value <= 9
requires 7 <= token.value
ensures !token.ready
ensures token.value == 0
{
    token.ready = false;
    token.value = 0;
}
machine read(token: &Token) -> u64 { token.value }
machine evaluate() -> u64 { read(&Token { ready: true, value: 7 }) }
machine main() crashes Trap {
    let first: u64 = evaluate();
    let second: u64 = read(&Token { ready: true, value: 7 });
    let local: Token = Token { ready: true, value: 7 };
    let third: u64 = read(&local);
    transition first == 7 && second == 7 && third == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
