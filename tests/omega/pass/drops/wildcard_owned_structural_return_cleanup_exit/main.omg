// Expected exit: 0
// Owned payload-bearing and empty cases share one authored return arm;
// the unread payload's hook runs once after the selected call completes.
data Receipt<'storage> { destination: &'storage mut u64; }
data Choice<'storage> { case Stop; case First(receipt: Receipt<'storage>); case Second; }
data Packet { value: u64; }
machine Receipt::drop(receipt: &mut Receipt<'storage>) {
    record_cleanup(receipt.destination);
}
machine record_cleanup(destination: &mut u64) {
    destination = ((destination as u64 in Wrapping) + 1) as u64;
}
machine produce(counter: &mut u64) -> Packet {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Packet { value: counter }
}
machine selected_value<'storage>(choice: Choice<'storage>, counter: &mut u64) -> Packet {
    transition choice {
        Choice::Stop -> (Packet { value: 0 })
        _ -> (produce(counter))
    }
}
machine selected_call<'storage>(choice: Choice<'storage>, counter: &mut u64) -> Packet {
    transition choice {
        Choice::Stop -> (Packet { value: 0 })
        _ -> produce(counter)
    }
}
machine main() crashes Trap {
    let mut bodies: u64 = 0;
    let mut cleanup: u64 = 0;
    let first: Packet = selected_value(Choice::First { receipt: Receipt { destination: &mut cleanup } }, &mut bodies);
    let second: Packet = selected_value(Choice::Second, &mut bodies);
    let stopped: Packet = selected_value(Choice::Stop, &mut bodies);
    let third: Packet = selected_call(Choice::First { receipt: Receipt { destination: &mut cleanup } }, &mut bodies);
    let fourth: Packet = selected_call(Choice::Second, &mut bodies);
    let stopped_call: Packet = selected_call(Choice::Stop, &mut bodies);
    transition first.value == 1 && second.value == 2 && stopped.value == 0
        && third.value == 3 && fourth.value == 4 && stopped_call.value == 0
        && bodies == 4 && cleanup == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
