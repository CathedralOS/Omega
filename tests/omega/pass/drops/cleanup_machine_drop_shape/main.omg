// Chapter 17: a resource-owning type defines cleanup
// through the reserved `drop` machine shape. `Guard::drop(&mut self)` is the
// teardown obligation; when a `Guard` local stops being live the compiler is
// responsible for the structural cleanup. Defining the drop machine and letting
// an owned local die at end of state type-checks cleanly.
//
// The executable cleanup slice additionally admits a NON-EMPTY `drop` body as
// a source-ordered list of zero-argument calls to mutually distinct empty
// helpers, each attached to a member-less marker type — the declared teardown
// ordering shape until ordinary drop lowering lands.

data Guard {
    handle: i32;
}

// Marker carrier for the ordered teardown helpers: the slice requires each
// helper to attach to a data type with no members.
data Teardown {
}

machine Teardown::unlock() {
}

machine Teardown::flush() {
}

machine Guard::drop(&mut self) {
    Teardown::unlock();
    Teardown::flush();
}

data Main {
}

machine Main::main(&mut self) {
    let g: Guard = Guard { handle: 7 };
}
