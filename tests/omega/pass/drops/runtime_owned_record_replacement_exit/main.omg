data Token { value: u64; }

machine main() crashes Trap {
    let mut token: Token = Token { value: 7 };
    token = Token { value: 9 };
    let observed: u64 = token.value;
    transition { _ -> observe(observed) }
    machine observe(observed: u64) {
        transition observed == 9 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
