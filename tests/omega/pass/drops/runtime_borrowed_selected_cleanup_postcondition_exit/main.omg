data Child { value: u64; ready: bool; }
data Element { marker: u64; child: Child; }
data Cursor { index: u64; calls: u64 in Wrapping; }

machine Child::drop(child: &mut Child)
requires child.value == 9 && child.ready
{
    child.value = 0;
    child.ready = false;
}

machine Element::drop(element: &mut Element)
ensures element.child.value == 9 && element.child.ready
{
    element.child.value = 9;
    element.child.ready = true;
}

machine select(cursor: &mut Cursor) -> u64 ensures result == 0 {
    cursor.calls += 1;
    cursor.index = 1;
    0
}

machine replacement(cursor: &mut Cursor) -> Element {
    cursor.index = 3;
    Element { marker: 19, child: Child { value: 7, ready: false } }
}

machine replace(elements: &mut [Element; 2], cursor: &mut Cursor) {
    elements[select(cursor)] = replacement(cursor);
}

machine main() crashes Trap {
    let mut elements: [Element; 2] = [
        Element { marker: 11, child: Child { value: 7, ready: false } },
        Element { marker: 7, child: Child { value: 7, ready: false } }
    ];
    let mut cursor: Cursor = Cursor { index: 0, calls: 0 };
    replace(&mut elements, &mut cursor);
    transition cursor.calls == 1 && cursor.index == 3
        && elements[0].marker == 19 && elements[0].child.value == 7
        && elements[1].marker == 7 && elements[1].child.value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
