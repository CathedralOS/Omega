data Token { value: u64; }

machine Token::drop(token: &mut Token) {
    token.value = 0;
}

machine make_token(counter: &mut u64) -> Token {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Token { value: counter }
}

machine consume(first: Token, second: Token, observed: &mut u64) -> u64 {
    observed = first.value;
    second.value
}

machine main() crashes Trap {
    let mut counter: u64 = 0;
    let mut observed: u64 = 0;
    // Each producer's mutable loan ends when its borrow-free result returns.
    // The drop hooks belong to the values, not to their producer's counter.
    let answer: u64 = consume(make_token(&mut counter), make_token(&mut counter), &mut observed);
    transition answer == 2 && observed == 1 && counter == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
