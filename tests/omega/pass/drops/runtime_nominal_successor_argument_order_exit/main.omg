// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.

public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}

PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
    }
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
    }
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    terminates;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    terminates;
}

data Token { ready: bool; byte: i32; }

machine Token::drop(token: &mut Token)
requires token.ready
reaches Console
{
    Console::write_byte(token.byte);
    token.ready = false;
}

// The outgoing call writes X before either local hook. Only the selected
// successor runs; both destinations observe the captured scalar unchanged.
machine outgoing() -> i32 reaches Console {
    Console::write_byte(88);
    71
}

machine choose(first_path: bool) reaches Console {
    let first: Token = Token { ready: true, byte: 65 };
    let second: Token = Token { ready: true, byte: 66 };
    transition first_path {
        true -> first_done(outgoing())
        _ -> second_done(outgoing())
    }
    machine first_done(captured: i32) {
        Console::write_byte(captured);
        Console::write_byte(69);
    }
    machine second_done(captured: i32) {
        Console::write_byte(captured);
        Console::write_byte(70);
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    choose(true);
    choose(false);
    Console::write_byte(10);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
