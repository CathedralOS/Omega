data Receipt [linear] dropped by drop_receipt { value: u64; }
data Owner dropped by drop_owner { first: Receipt; second: Receipt; }

machine drop_receipt(receipt: &mut Receipt)
requires receipt.value == 9
{
    receipt.value = 0;
}

machine drop_owner(owner: &mut Owner)
requires owner.first.value == 7 && owner.second.value == 13
ensures owner.first.value == 9 && owner.second.value == 9
{
    owner.first.value = 9;
    owner.second.value = 9;
}

machine inspect(owner: &Owner) -> bool {
    owner.first.value == 7 && owner.second.value == 13
}

// Empty arrays contribute no child debt; completing the other field must
// establish this parent so its guarantee precedes the Receipt hook.
data EmptyOwner dropped by drop_empty_owner { empty: [Receipt; 0]; receipt: Receipt; }
machine drop_empty_owner(owner: &mut EmptyOwner)
requires owner.receipt.value == 7
ensures owner.receipt.value == 9
{
    owner.receipt.value = 9;
}
machine empty_array() -> bool {
    let mut owner: EmptyOwner;
    owner.receipt = Receipt { value: 7 };
    owner.receipt.value == 7
}

// Once every element is written, the array belongs to the complete parent.
data ArrayOwner dropped by drop_array_owner { receipts: [Receipt; 2]; }
machine drop_array_owner(owner: &mut ArrayOwner)
requires owner.receipts[0].value == 7 && owner.receipts[1].value == 13
ensures owner.receipts[0].value == 9 && owner.receipts[1].value == 9
{
    owner.receipts[0].value = 9;
    owner.receipts[1].value = 9;
}
machine complete_array() -> bool {
    let mut owner: ArrayOwner;
    owner.receipts[1] = Receipt { value: 13 };
    owner.receipts[0] = Receipt { value: 7 };
    owner.receipts[0].value == 7 && owner.receipts[1].value == 13
}

machine main() crashes Trap {
    let owner: Owner = Owner {
        first: Receipt { value: 7 },
        second: Receipt { value: 13 }
    };
    let observed: bool = inspect(&owner) && empty_array() && complete_array();
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
