domain u64::Positive(value) requires 1 <= value;

data Token { value: u64 in Positive; }
data Pair { left: Token; right: Token; }

machine Token::drop(token: &mut Token)
requires token.value == 42
{
    token.value = 1;
}

machine main() {
    let mut pair: Pair;
    // Only the right child becomes a value. The untouched left storage has
    // no valid Token and must not receive either replacement or exit cleanup.
    pair.right = Token { value: 42 };
    transition { _ -> done() }
    machine done() {}
}
