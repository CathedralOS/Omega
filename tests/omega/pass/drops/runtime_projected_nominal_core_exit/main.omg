data Token { ready: bool; value: i32; }
data Pair { left: Token; right: Token; }
data Bundle { pairs: [Pair; 2]; }

machine Token::drop(token: &mut Token)
requires token.ready
{
    token.ready = false;
}

// No host imports or runtime entry inputs: both engines must perform the
// projected hook calls and retain the moved child through their completion.
machine select(input: Bundle, marker: Token) crashes Trap
requires input.pairs[0].left.ready, input.pairs[0].right.ready,
    input.pairs[1].left.ready, input.pairs[1].right.ready, marker.ready
{
    let local: Token = Token { ready: true, value: 7 };
    transition { _ -> finish(input.pairs[0].left) }
    machine finish(selected: Token)
    requires selected.ready
    {
        transition selected.value == 42 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let input: Bundle = Bundle { pairs: [
        Pair {
            left: Token { ready: true, value: 42 },
            right: Token { ready: true, value: 2 }
        },
        Pair {
            left: Token { ready: true, value: 3 },
            right: Token { ready: true, value: 4 }
        }
    ] };
    let marker: Token = Token { ready: true, value: 5 };
    select(input, marker);
}
