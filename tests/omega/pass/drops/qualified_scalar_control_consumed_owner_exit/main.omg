// Expected exit: 0
// Scalar completion must not revive a qualified entry claim already consumed.
use omega::language::core::drop;
data Claim [linear] { value: u64; }
domain Claim::Issued established by issue;
machine Claim::drop(claim: &mut Claim) {}
machine issue() -> Claim in Issued { Claim { value: 3 } }
machine consume(claim: Claim in Issued, branch: bool) -> u64 {
    let observed: u64 = claim.value;
    drop(claim);
    transition branch { true -> (observed) false -> (observed) }
}
machine main() crashes Trap {
    let first: u64 = consume(issue(), true);
    let second: u64 = consume(issue(), false);
    transition first == 3 && second == 3 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
