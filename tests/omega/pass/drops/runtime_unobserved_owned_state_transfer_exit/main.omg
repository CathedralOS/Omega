data Token { first: u64; second: u64; third: u64; }

machine discard_through_state(token: Token) {
    transition { _ -> arrived(token) }
    machine arrived(current: Token) {}
}

// An owned value retains transport and cleanup custody even if its payload
// is never read. Successor declarations must establish the same exact homes
// as an observed value, not depend on the rest of this function's operations.
machine forward(token: Token, value: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> middle(token, value) }
    machine middle(current: Token, value: u64 in Wrapping) -> u64 in Wrapping {
        transition { _ -> finish(current, value << 1) }
    }
    machine finish(last: Token, shifted: u64 in Wrapping) -> u64 in Wrapping {
        shifted
    }
}

machine main() crashes Trap {
    let unused: Token = Token { first: 4, second: 5, third: 6 };
    discard_through_state(unused);
    let token: Token = Token { first: 1, second: 2, third: 3 };
    let observed: u64 in Wrapping = forward(token, 21);
    transition observed == 42 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
