use omega::language::core::drop;

// A drop hook on a lifetime-parameterized owner: the hook's signature
// re-declares the same lifetime binders so the cleanup edge can be selected
// for any instantiation.
data Owner<'first, 'second> {
    first: &'first i32;
    second: &'second i32;
}

machine Owner::drop(owner: &mut Owner<'first, 'second>) {
}

machine main() {
    let a: i32 = 1;
    let b: i32 = 2;
    let owner: Owner = Owner { first: &a, second: &b };
    drop(owner);
}
