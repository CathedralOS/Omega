// Generic cleanup transports the complete callable predicate across core drop
// and ordinary forwarding. A Boolean field alone does not establish this hook.
use omega::language::core::drop;

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.

public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}

PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
    }
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
    }
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    terminates;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    terminates;
}

data Token { ready: bool; value: u64; byte: i32; }

machine Token::drop(token: &mut Token)
requires token.ready && token.value == 7
requires 7 <= token.value && token.value <= 9
reaches Console
{
    Console::write_byte(token.byte);
    token.ready = false;
    token.value = 0;
}

// An ordinary generic death edge owns the same contextual row as core drop.
machine retire<T>(value: T) {}

// Transfer forwards that row; this body must not dispose its moved occurrence.
machine forward<T>(value: T) { retire(value); }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let first: Token = Token { ready: true, value: 7, byte: 65 };
    let second: Token = Token { ready: true, value: 7, byte: 66 };
    drop(second);
    forward(first);
    Console::write_byte(10);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
