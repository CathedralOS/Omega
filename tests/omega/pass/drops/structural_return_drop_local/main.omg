// A body that returns a structural value disposes of every local it does
// not return. `exercise` only borrows its `token`, so the return runs the
// nominal drop; `relay` moves its token into a call before returning —
// the callee drops it and the return must not drop it again.
data Token { mark: i32; }
machine Token::drop(token: &mut Token) {
    token.mark = 0;
}
machine watch(token: &Token) -> i32 {
    token.mark
}
machine sink(token: Token) -> i32 {
    token.mark
}

data Shape { size: i32; }

machine exercise(shape: Shape) -> Shape {
    let token: Token = Token { mark: 4 };
    let seen: i32 = watch(&token);
    shape
}
machine relay(shape: Shape) -> Shape {
    let token: Token = Token { mark: 8 };
    let spent: i32 = sink(token);
    shape
}

data Main { size: i32; }

machine Main::main(main: &mut Main) {
    let first: Shape = exercise(Shape { size: 1 });
    let second: Shape = relay(Shape { size: 2 });
    main.size = ((first.size as i32 in Wrapping) + (second.size as i32 in Wrapping)) as i32;
}
