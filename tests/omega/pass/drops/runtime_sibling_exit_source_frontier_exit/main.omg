// Expected exit: 0
// Earlier emitted sibling calls cannot consume this exit's incoming homes.
data Token { value: u64; }
machine Token::drop(token: &mut Token) {}
machine identity(token: Token) -> Token { token }
machine inspect(token: Token) -> u64 { token.value }
machine choose(outer: bool, inner: bool) -> Token {
    let first: Token = Token { value: 11 };
    let second: Token = Token { value: 22 };
    transition outer {
        true -> (Token { value: inspect(first) })
        false -> (match inner { true -> first, false -> second, })
    }
}
machine main() crashes Trap {
    let first: u64 = inspect(choose(true, false));
    let second: u64 = inspect(choose(false, true));
    let third: u64 = inspect(choose(false, false));
    transition first == 11 && second == 11 && third == 22 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
