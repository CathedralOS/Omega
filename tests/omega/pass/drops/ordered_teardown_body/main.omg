use omega::language::core::drop;

data Teardown {
}

machine Teardown::unlock() {
}

machine Teardown::flush() {
}

data Guard {
    handle: i32;
}

// A non-empty drop body is an ordinary Unit machine body: source-ordered
// calls to attached helpers run at the cleanup edge, before the place dies.
machine Guard::drop(guard: &mut Guard) {
    Teardown::unlock();
    Teardown::flush();
}

machine main() {
    let g: Guard = Guard { handle: 7 };
}
