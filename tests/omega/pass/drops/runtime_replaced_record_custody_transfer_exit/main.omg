data Token { value: u64; }
data Tag [copy] { case Empty; case First; case Second; }
data Pair { left: Token; right: Token; tag: Tag; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine replace_borrowed(pair: &mut Pair) {
    pair.right = Token { value: 13 };
    pair.tag = Tag::Second;
}

machine consume(pair: Pair) -> bool {
    pair.left.value == 7 && pair.right.value == 13 && pair.tag == Tag::Second
}

machine main() crashes Trap {
    let mut pair: Pair = Pair {
        left: Token { value: 7 },
        right: Token { value: 9 },
        tag: Tag::Empty
    };
    pair.right = Token { value: 11 };
    pair.tag = Tag::First;
    replace_borrowed(&mut pair);
    // Restoring a field rejoins the owned parent; the borrowed helper does
    // not acquire its own disposal debt for that same parent.
    let observed: bool = consume(pair);
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
