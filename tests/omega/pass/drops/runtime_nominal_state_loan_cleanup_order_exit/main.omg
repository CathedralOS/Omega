// An affine Room with count 10 and executable nominal cleanup retains original backing through a successor-state loan; successor observes 10, and owner cleans exactly once after loan closes.
// Expected output contains: BAOCRD

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    terminates;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    terminates;
}

data Room { count: u32 in Wrapping; }
machine Room::drop(room: &mut Room) requires room.count == 10 reaches Console {
 Console::write_byte(68); room.count = 99;
}
data Marker { byte: i32; }
machine Marker::drop(marker: &mut Marker) reaches Console { Console::write_byte(marker.byte); }
machine scope() reaches Console crashes Trap {
 let older: Marker = Marker { byte: 65 };
 let room: Room = Room { count: 10 };
 let younger: Marker = Marker { byte: 66 };
 // Capturing a stored alias introduces private descriptor completion scopes;
 // they must not bring the retained Room's nominal cleanup forward.
 let loan: &mut Room = &mut room;
 transition { _ -> observe(loan) }
 machine observe(room: &mut Room) {
  let newest: Marker = Marker { byte: 67 };
  Console::write_byte(79);
  transition room.count == 10 { true -> again(room) false -> bad() }
 }
 machine again(room: &mut Room) { Console::write_byte(82); }
 machine bad() { crash Trap; }
}
data Main {} machine Main::main(main: &mut Main) reaches Console crashes Trap { scope(); }

PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
