use omega::language::core::drop;

// Owner binders, not method-local binders: two regions, one copy type and Count.
data Owner<'left, 'right, Marker [copy], const Count: u64> {
    left: &'left mut u64;
    right: &'right mut u64;
    marker: Marker;
    values: [u8; Count];
}
machine change_left(destination: &mut u64) { destination = destination ^ 73; }
machine change_right(destination: &mut u64) { destination = destination ^ 19; }
machine Owner::drop(owner: &mut Owner<'left, 'right, Marker, Count>)
requires Count >= 1
{
    let marker: &Marker = &owner.marker;
    change_left(owner.left);
    change_right(owner.right);
}
machine main() crashes Trap {
    let mut first: u64 = 0;
    let mut second: u64 = 0;
    let mut third: u64 = 0;
    let mut fourth: u64 = 0;
    let a: Owner<[u64; 2], 2> = Owner {
        left: &mut first, right: &mut second, marker: [41, 42], values: [1, 2],
    };
    let b: Owner<bool, 1> = Owner {
        left: &mut third, right: &mut fourth, marker: false, values: [3],
    };
    drop(a);
    drop(b);
    transition first == 73 && second == 19 && third == 73 && fourth == 19 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
