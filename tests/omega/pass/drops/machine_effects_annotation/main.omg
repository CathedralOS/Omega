// A regular (non-boundary) machine
// carries an explicit service-reach annotation. The chapter says cleanup/blocking
// behavior must be declared independently; here an ordinary machine declares the
// `Allocator` boundary-service reach. Machine-level declarations type-check
// cleanly. (Distinct from the boundary-trait reach canary, which annotates
// host-boundary trait machines.)

data Pool {
    // Defined-overflow domain: `size + 1` is a wrapping increment, not exact
    // arithmetic, so the grow body needs no operand range premise.
    size: u64 in Wrapping;
}

boundary trait Allocator {
}

machine Pool::grow(&mut self)
reaches
    Allocator
{
    self.size = self.size + 1;
}

data Main {
    pool: Pool;
}

machine Main::main(&mut self) {
    self.pool.grow();
}
