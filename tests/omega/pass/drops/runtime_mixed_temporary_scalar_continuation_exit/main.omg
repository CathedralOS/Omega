data Token { value: u64; }
data Pair { first: Token; second: Token; }

machine make_pair(counter: &mut u64) -> Pair {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Pair { first: Token { value: counter }, second: Token { value: 99 } }
}

machine make_token(counter: &mut u64) -> Token {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Token { value: counter }
}

machine consume(token: Token, borrowed: &Token, observed: &mut u64) -> u64 {
    observed = token.value;
    borrowed.value
}

machine main() crashes Trap {
    let mut counter: u64 = 0;
    let mut observed: u64 = 0;
    // Producers run left to right once. The borrowed whole temporary and the
    // first producer's residual sibling die together after this scalar call.
    let answer: u64 = consume(make_pair(&mut counter).first, &make_token(&mut counter), &mut observed);
    transition answer == 2 && observed == 1 && counter == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
