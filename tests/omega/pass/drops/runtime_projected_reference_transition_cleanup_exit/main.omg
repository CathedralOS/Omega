use omega_language_std::console;

data Leaf { value: i32; }
data View { body: &mut Leaf; }
data Outer { leftover: Leaf; selected: View; }
data Main { value: Leaf; }

// The selected subtree keeps its stored loan when its sibling is disposed.
// Reading through it must still observe the caller's original storage.
machine exercise(input: Outer) -> i32 {
    transition { _ -> finish(input.selected) }
    machine finish(value: View) -> i32 {
        value.body.value
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.value.value = 29;
    let input: Outer = Outer { leftover: Leaf { value: 7 }, selected: View { body: &mut main.value } };
    let observed: i32 = exercise(input);
    transition observed == 29 {
        true -> finish(main, 0)
        _ -> finish(main, 1)
    }
    machine finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
