// A generic conditional returns one owner and cleans only the other.
// The returned owner is deliberately unready until its caller repairs it.
use omega::language::core::drop;
use omega::language::core::external_binding;

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;

    // The existing Console role review nominates output through a complete
    // provider with an exit row. This program never calls that row.
    machine exit_process(return_code: i32)
    reaches Console;
}

public data ConsoleNativeProvider {}
public NativeConsole satisfies Console {
    machine write_byte(byte: i32) reaches Console terminates; {
        ConsoleNativeProvider::write_byte(byte);
    }
    machine exit_process(return_code: i32) reaches Console {
        Console::exit_process(return_code);
    }
}

// The finite-write assumption is attached to an explicit foreign contract,
// not to the standard compiler-owned Console primitive.
data PosixConsoleIo {}
boundary requirement PosixConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
terminates;
reaches Console;
data PosixConsoleImports {}


macos_arm64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
macos_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;


linux_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
linux_x86_64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;


linux_arm64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
linux_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;

// Windows uses the existing authored import route for process exit.
// Windows writes the byte to stdout through MSVCRT `_write`, one byte from
// the low byte of an i32 cell.
data WindowsConsoleIo { }
boundary requirement WindowsConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
terminates;
reaches Console;
data WindowsConsoleImports { }


windows_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}


data Token { ready: bool; byte: i32; }

machine Token::drop(token: &mut Token)
requires token.ready
reaches Console
{
    Console::write_byte(token.byte);
    token.ready = false;
}

machine choose<T>(keep_first: bool, first: T, second: T) -> T {
    transition keep_first { true -> first false -> second }
}

machine forward_choice<T>(flag: bool, first: T, second: T) -> T {
    choose(flag, first, second)
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let first: Token = Token { ready: false, byte: 65 };
    let second: Token = Token { ready: true, byte: 66 };
    let mut selected: Token = forward_choice(true, first, second);
    selected.ready = true;
    drop(selected);
    Console::write_byte(10);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
