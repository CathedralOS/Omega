// Expected exit: 0
data Token { ready: u64; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready == 1 { token.ready = 0; }
machine make_token() -> Token
ensures result.ready == 1 {
    Token { ready: 1, value: 7 }
}
machine read(token: &Token) -> u64 { token.value }
machine main() crashes Trap {
    let mut count: u64 = 0;
    let answer: u64 = read(&make_token());
    transition answer == 7 && count == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
