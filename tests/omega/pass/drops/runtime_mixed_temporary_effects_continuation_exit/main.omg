data Token { value: u64; }
data Group { first: Token; second: Token; third: Token; }

machine make_group(counter: &mut u64) -> Group {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Group {
        first: Token { value: counter },
        second: Token { value: 99 },
        third: Token { value: 100 }
    }
}

machine make_token(counter: &mut u64) -> Token {
    counter = ((counter as u64 in Wrapping) + 1) as u64;
    Token { value: counter }
}

machine consume(token: Token, borrowed: &Token, observed: &mut u64) {
    observed = ((token.value as u64 in Wrapping) * 10 + (borrowed.value as u64 in Wrapping)) as u64;
}

machine main() crashes Trap {
    let mut counter: u64 = 0;
    let mut observed: u64 = 0;
    // Both producers execute once. Whole borrowed-owner cleanup interleaves
    // with the first owner's two residual siblings on the call continuation.
    consume(make_group(&mut counter).first, &make_token(&mut counter), &mut observed);
    transition observed == 12 && counter == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
