// Expected exit: 0. Each distinct temporary invokes its parent hook once.
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Counter { value: u64; }
data Pair { first: Receipt; second: Receipt; counter: &mut Counter; }
machine Pair::drop(pair: &mut Pair) {
    pair.counter.value = ((pair.counter.value as u64 in Wrapping) + 1) as u64;
}
machine observe(receipt: &Receipt, expected: u64) crashes Trap {
    transition receipt.code == expected { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 0 };
    observe(&Pair {
        first: Receipt { code: 7 }, second: Receipt { code: 11 }, counter: &mut counter
    }.second, 11);
    observe(&Pair {
        first: Receipt { code: 17 }, second: Receipt { code: 23 }, counter: &mut counter
    }.first, 17);
    transition counter.value == 2 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
