data Token { value: u64; }
data Holder { token: Token; }

machine Token::drop(token: &mut Token) {
    token.value = 0;
}

machine replace_field(holder: &mut Holder)
requires holder.token.value == 7
ensures holder.token.value == 7
{
    holder.token = Token { value: 7 };
}

machine replace_root(token: &mut Token)
requires token.value == 7
ensures token.value == 7
{
    token = Token { value: 7 };
}

machine main() crashes Trap {
    let mut holder: Holder = Holder { token: Token { value: 7 } };
    let mut token: Token = Token { value: 7 };
    replace_field(&mut holder);
    replace_root(&mut token);
    // Cleanup of the old values must run before these replacement stores.
    // A hook applied to the new values instead would zero them and trap.
    transition holder.token.value == 7 && token.value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
