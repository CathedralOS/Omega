// A local subslice changes the receiver's coordinates, not the cleanup
// contract. Its selected element keeps the original collection's prerequisite.
data Child { value: u64; ready: bool; }
data Element { marker: u64; child: Child; }
data Cursor { index: u64; calls: u64 in Wrapping; }

machine Child::drop(child: &mut Child)
requires child.value == 9 && child.ready
{
    child.value = 0;
    child.ready = false;
}

machine Element::drop(element: &mut Element)
requires element.child.value == 9 && element.child.ready
ensures element.child.value == 9 && element.child.ready
{
    element.marker = 0;
}

machine select(cursor: &mut Cursor) -> u64 ensures result == 0 {
    cursor.calls += 1;
    cursor.index = 1;
    0
}

machine replacement(cursor: &mut Cursor) -> Element
ensures result.child.value == 9 && result.child.ready
{
    cursor.index = 3;
    Element { marker: 19, child: Child { value: 9, ready: true } }
}

machine replace(elements: &mut [Element], cursor: &mut Cursor)
requires elements.len >= 4,
    elements[0].child.value == 9, elements[0].child.ready,
    elements[1].child.value == 9, elements[1].child.ready,
    elements[2].child.value == 9, elements[2].child.ready,
    elements[3].child.value == 9, elements[3].child.ready
ensures elements[0].child.value == 9, elements[0].child.ready,
    elements[1].child.value == 9, elements[1].child.ready,
    elements[2].child.value == 9, elements[2].child.ready,
    elements[3].child.value == 9, elements[3].child.ready
{
    let tail: &mut [Element] = &mut elements[1..3];
    tail[select(cursor)] = replacement(cursor);
}

machine main() crashes Trap {
    let mut elements: [Element; 4] = [
        Element { marker: 31, child: Child { value: 9, ready: true } },
        Element { marker: 11, child: Child { value: 9, ready: true } },
        Element { marker: 7, child: Child { value: 9, ready: true } },
        Element { marker: 47, child: Child { value: 9, ready: true } }
    ];
    let mut cursor: Cursor = Cursor { index: 0, calls: 0 };
    let view: &mut [Element] = &mut elements[..];
    replace(view, &mut cursor);
    transition cursor.calls == 1 && cursor.index == 3
        && elements[0].marker == 31 && elements[0].child.value == 9 && elements[0].child.ready
        && elements[1].marker == 19 && elements[1].child.value == 9 && elements[1].child.ready
        && elements[2].marker == 7 && elements[2].child.value == 9 && elements[2].child.ready
        && elements[3].marker == 47 && elements[3].child.value == 9 && elements[3].child.ready {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
