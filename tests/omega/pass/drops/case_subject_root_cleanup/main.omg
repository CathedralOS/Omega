// A case dispatch on a field of an affine local (`item.kind`) observes the
// field only; the record keeps custody. A forwarding arm leaves its cleanup
// to the successor's return, the `_` arm runs it on the edge, and a
// returning arm runs it at the return — every disposition disposes once.
data Kind [copy] { case P; case B; case C; }
data Item {
    kind: Kind;
    weight: u64;
}
data Sink { }
machine Sink::bump(sink: &mut Sink) { }

data Main { weight: u64; }

machine weigh(sink: &mut Sink, item: Item) -> u64 {
    transition item.kind {
        Kind::P -> forward(sink, item)
        Kind::B -> set(item)
        _ -> (item.weight)
    }
    machine forward(sink: &mut Sink, item: Item) -> u64 {
        item.weight
    }
    machine set(item: Item) -> u64 {
        item.weight
    }
}

machine Main::main(main: &mut Main) {
    let mut sink: Sink;
    let item: Item = Item { kind: Kind::B, weight: 9 };
    main.weight = weigh(&mut sink, item);
}
