// Expected exit: 0. Disjoint writes preserve facts in reference-free records.
use omega::language::core::content;
use omega::language::core::drop;
data Slot { }
data Capacity [linear] { stamp: u64; active: u64; units: u64; released: bool; }
domain Capacity::Held(capacity) requires capacity.stamp != 0 established by acquire;
domain Capacity::Vacant(capacity) requires capacity.active == 0;
domain Capacity::Available = Capacity::Held & Capacity::Vacant;
machine Held::content(capacity: &Capacity) -> CountedQuantity<Slot>
satisfies Content<Capacity, CountedQuantity<Slot>>::project {
    CountedQuantity { magnitude: embed(capacity.units) as Nat }
}
machine Capacity::drop(capacity: &mut Capacity)
requires capacity.active == 0 && capacity.released { }
machine acquire() -> Capacity in Capacity::Available {
    Capacity { stamp: 17, active: 0, units: 1, released: false }
}
data Envelope { capacity: Capacity in Capacity::Available; }
data Holder<Value> { value: Value; }
machine wrap(capacity: Capacity in Capacity::Available) -> Envelope {
    Envelope { capacity: capacity }
}
machine retire_owned(mut capacity: Capacity in Capacity::Held)
requires capacity.active == 0 {
    capacity.released = true;
    drop(capacity);
}
machine main() {
    retire_owned(acquire());
    let mut envelope: Envelope = wrap(acquire());
    envelope.capacity.released = true;
    drop(envelope);
    let mut holder: Holder<Envelope> = Holder { value: wrap(acquire()) };
    holder.value.capacity.released = true;
    drop(holder);
}
