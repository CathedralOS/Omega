// A resource-owning value moves into a target state through a transition
// argument: the source hands `g` to `hold(...)`, transferring the cleanup
// obligation; the receiving state owns it and lets it die.
data Guard {
    handle: i32;
}
machine Guard::drop(guard: &mut Guard) {
}

data Main {}

machine Main::main(main: &mut Main) {
    let g: Guard = Guard { handle: 1 };
    transition {
        _ -> hold(g)
    }
    machine hold(guard: Guard) {
        transition {
            _ -> done()
        }
    }
    machine done() {
    }
}
