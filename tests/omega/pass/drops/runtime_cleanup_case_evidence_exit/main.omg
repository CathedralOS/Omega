// Expected exit: 0. Cleanup preserves exact case, owner and mutation identity.
data Ticket { drops: &mut [u64; 1]; value: u64; }
machine Ticket::drop(ticket: &mut Ticket) {
    ticket.drops[0] = ((ticket.drops[0] as u64 in Wrapping) + 1) as u64;
}
data Slot { case First(ticket: Ticket); case Second(ticket: Ticket); case Third(ticket: Ticket); }
data Reservation { before: u64; slot: Slot; after: u64; }
data Envelope { reservation: Reservation; }
data Siblings { left: Slot; right: Slot; }

machine consume(slot: Slot) -> u64 {
    transition slot {
        Slot::First { ticket } -> finish(ticket)
        Slot::Second { ticket } -> finish(ticket)
        Slot::Third { ticket } -> finish(ticket)
    }
    machine finish(ticket: Ticket) -> u64 { ticket.value }
}
machine make(which: u32, ticket: Ticket) -> Slot {
    transition which {
        0 -> Slot::First { ticket: ticket }
        1 -> Slot::Second { ticket: ticket }
        _ -> Slot::Third { ticket: ticket }
    }
}
machine reconstruct(envelope: Envelope) -> u64 {
    transition envelope.reservation.slot {
        Slot::First { ticket } -> retain(Envelope { reservation: Reservation {
            before: envelope.reservation.before, slot: Slot::First { ticket: ticket }, after: envelope.reservation.after } })
        Slot::Second { ticket } -> retain(Envelope { reservation: Reservation {
            before: envelope.reservation.before, slot: Slot::Second { ticket: ticket }, after: envelope.reservation.after } })
        Slot::Third { ticket } -> retain(Envelope { reservation: Reservation {
            before: envelope.reservation.before, slot: Slot::Third { ticket: ticket }, after: envelope.reservation.after } })
    }
    machine retain(envelope: Envelope) -> u64 { consume(envelope.reservation.slot) }
}
machine three_case(which: u32) -> bool {
    let mut drops: [u64; 1] = [0];
    let value: u64 = reconstruct(Envelope { reservation: Reservation {
        before: 11, slot: make(which, Ticket { drops: &mut drops, value: 73 }), after: 19 } });
    value == 73 && drops[0] == 1
}
machine siblings(value: Siblings) -> u64 {
    transition value.left {
        Slot::First { ticket } -> selected(ticket, value.right)
        Slot::Second { ticket } -> selected(ticket, value.right)
        Slot::Third { ticket } -> selected(ticket, value.right)
    }
    machine selected(ticket: Ticket, right: Slot) -> u64 { consume(right) }
}
machine sibling_case() -> bool {
    let mut left_drops: [u64; 1] = [0];
    let mut right_drops: [u64; 1] = [0];
    let value: u64 = siblings(Siblings {
        left: Slot::First { ticket: Ticket { drops: &mut left_drops, value: 17 } },
        right: Slot::Third { ticket: Ticket { drops: &mut right_drops, value: 73 } } });
    value == 73 && left_drops[0] == 1 && right_drops[0] == 1
}
machine replace(slot: &mut Slot, replacement: Slot) -> u64 { slot = replacement; 73 }
machine retag(original: Slot, replacement: Slot) -> u64 {
    let mut slot: Slot = original;
    transition slot in Slot::First {
        true -> replace(&mut slot, replacement)
        false -> 0
    }
}
machine retag_case() -> bool {
    let mut old_drops: [u64; 1] = [0];
    let mut new_drops: [u64; 1] = [0];
    let value: u64 = retag(
        Slot::First { ticket: Ticket { drops: &mut old_drops, value: 17 } },
        Slot::Third { ticket: Ticket { drops: &mut new_drops, value: 73 } });
    value == 73 && old_drops[0] == 1 && new_drops[0] == 1
}
machine join(select_first: bool, first: Ticket, second: Ticket) -> u64 {
    transition select_first {
        true -> selected(Slot::First { ticket: first })
        false -> selected(Slot::Third { ticket: second })
    }
    machine selected(slot: Slot) -> u64 { consume(slot) }
}
machine joined_case(select_first: bool) -> bool {
    let mut first_drops: [u64; 1] = [0];
    let mut second_drops: [u64; 1] = [0];
    let value: u64 = join(select_first,
        Ticket { drops: &mut first_drops, value: 73 }, Ticket { drops: &mut second_drops, value: 73 });
    value == 73 && first_drops[0] == 1 && second_drops[0] == 1
}
machine main() crashes Trap {
    let first: bool = three_case(0);
    let second: bool = three_case(1);
    let third: bool = three_case(2);
    let sibling: bool = sibling_case();
    let retagged: bool = retag_case();
    let first_join: bool = joined_case(true);
    let second_join: bool = joined_case(false);
    transition first && second && third && sibling && retagged && first_join && second_join {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
