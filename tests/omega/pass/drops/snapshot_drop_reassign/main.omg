// A scalar snapshot copied out before the owner is dropped stays usable
// after the transfer; assigning a whole replacement re-establishes the
// owner so later reads observe the new value.
use omega::language::core::drop;

data Guard {
    handle: i32;
}

machine Guard::drop(guard: &mut Guard) {
}

machine consume(value: Guard) {
}

data Main {}

machine Main::main() -> i32 {
    let mut g: Guard = Guard { handle: 7 };
    let snapshot: i32 = g.handle;
    drop(g);
    g = Guard { handle: snapshot };
    let restored: i32 = g.handle;
    consume(g);
    restored
}
