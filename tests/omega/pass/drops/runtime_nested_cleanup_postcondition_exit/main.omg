data Token { value: u64; ready: bool; }
data Owner { token: Token; }

machine Token::drop(token: &mut Token)
requires token.value == 9 && token.ready
{
    token.value = 0;
    token.ready = false;
}

machine Owner::drop(owner: &mut Owner)
requires owner.token.value == 7 && !owner.token.ready
ensures owner.token.value == 9 && owner.token.ready
{
    // The child starts at 7. Its later cleanup requires the parent's normal
    // guarantee, not a prerequisite evaluated against the pre-parent value.
    owner.token.value = 9;
    owner.token.ready = true;
}

machine main() {
    let owner: Owner = Owner { token: Token { value: 7, ready: false } };
    let owners: [Owner; 2] = [
        Owner { token: Token { value: 7, ready: false } },
        Owner { token: Token { value: 7, ready: false } }
    ];
    transition { _ -> done() }
    machine done() {}
}
