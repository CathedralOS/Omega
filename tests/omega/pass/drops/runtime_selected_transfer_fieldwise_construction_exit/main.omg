use omega::language::core::external_binding;

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
pub boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}
pub data ConsoleNativeProvider {}
data PosixConsoleIo {}
boundary requirement PosixConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
terminates;
reaches Console;
data PosixConsoleImports {}
macos_arm64 machine macos_arm64_write_binding() -> ForeignBinding<26, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } }
}
linux_x86_64 machine linux_x86_64_write_binding() -> ForeignBinding<9, 5, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.2.5"
    } }
}
linux_arm64 machine linux_arm64_write_binding() -> ForeignBinding<9, 5, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "write", version: "GLIBC_2.17"
    } }
}
macos_arm64 machine PosixConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    satisfies PosixConsoleIo::write via macos_arm64_write_binding();
macos_arm64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
linux_x86_64 machine PosixConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    satisfies PosixConsoleIo::write via linux_x86_64_write_binding();
linux_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
linux_arm64 machine PosixConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    satisfies PosixConsoleIo::write via linux_arm64_write_binding();
linux_arm64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
// All bound targets are little-endian: the low byte is the first byte.
data WindowsConsoleIo {}
boundary requirement WindowsConsoleIo::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
terminates;
reaches Console;
data WindowsConsoleImports {}
windows_x86_64 machine windows_x86_64_write_binding() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "_write"
    } }
}
windows_x86_64 machine WindowsConsoleImports::write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    satisfies WindowsConsoleIo::write via windows_x86_64_write_binding();
windows_x86_64 machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte
reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}

// Each selected transfer consumes its exact region. The skipped region stays
// behind younger roots until normal death, including after condition mutation.
data Token { value: u64 [1..=100]; byte: i32; }
data Pair<Value> { first: Value; second: Value; }
machine Token::drop(token: &mut Token) reaches Console { Console::write_byte(token.byte); }
machine consume(token: Token) -> u64 reaches Console { token.value }

// A structural local whose zero bits are not a value (`Token.value` is ranged
// to `[1..=100]`) is a deferred binding its field stores establish one at a
// time. A selected transfer of one field after that construction keeps the
// sibling's residual cleanup and the usual reverse declaration order at
// normal death, like a local built from a whole literal.
machine fieldwise_then_selected(enabled: bool) -> bool reaches Console {
    let mut selected: bool = enabled;
    let mut pair: Pair<Token>;
    pair.first = Token { value: 9, byte: 65 };
    pair.second = Token { value: 10, byte: 66 };
    let observed: bool = selected && consume(pair.first) == 9;
    selected = !selected;
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && pair.second.value == 10 && youngest.value == 11
}

machine verify(accepted: bool) reaches Console crashes Trap {
    Console::write_byte(10);
    transition accepted { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    verify(fieldwise_then_selected(false));
    verify(fieldwise_then_selected(true));
}

ConsoleNativeProviderConsoleImplementation satisfies Console {
    Console::write_byte = ConsoleNativeProvider::write_byte;
}
