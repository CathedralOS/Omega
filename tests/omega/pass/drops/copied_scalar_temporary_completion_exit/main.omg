// Expected exit: 0. Copies finish before their source descriptors and backing hooks.
data Receipt { counter: &mut [u64; 1]; value: u64; }
machine Receipt::drop(receipt: &mut Receipt) {
    receipt.counter[0] = ((receipt.counter[0] as u64 in Wrapping) + 1) as u64;
}
machine issue(counter: &mut [u64; 1], value: u64) -> Receipt {
    Receipt { counter: counter, value: value }
}
data ReceiptBorrow<'borrow> { receipt: &'borrow Receipt; }
machine wrap<'borrow>(receipt: &'borrow Receipt) -> ReceiptBorrow<'borrow> {
    ReceiptBorrow { receipt: receipt }
}
boundary trait Reader { machine read(receipt: &Receipt) -> u64 reaches; }
Provider satisfies Reader {
    machine read(receipt: &Receipt) -> u64 {
        transition receipt.counter[0] == 0 {
            true -> (receipt.value)
            false -> (0)
        }
    }
}
machine main() reaches Reader crashes Trap {
    let mut direct_drops: [u64; 1] = [0];
    let direct: u64 = wrap(&issue(&mut direct_drops, 67)).receipt.value;
    let direct_correct: bool = direct == 67 && direct_drops[0] == 1;
    let mut cast_drops: [u64; 1] = [0];
    let cast_value: u64 = wrap(&issue(&mut cast_drops, 73)).receipt.value as u64;
    let cast_correct: bool = cast_value == 73 && cast_drops[0] == 1;
    let mut call_drops: [u64; 1] = [0];
    let call_value: u64 = Reader::read([wrap(&issue(&mut call_drops, 83)).receipt][0]) + 0;
    let call_correct: bool = call_value == 83 && call_drops[0] == 1;
    transition direct_correct && cast_correct && call_correct {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
