// Expected exit: 0
data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token)
requires token.ready { token.ready = false; }
machine make_token(count: &mut u64) -> Token
ensures result.ready {
    count = ((count as u64 in Wrapping) + 1) as u64;
    Token { ready: true, value: 7 }
}
machine read(token: &Token) -> u64 { token.value }
machine main() crashes Trap {
    let mut count: u64 = 0;
    let answer: u64 = read(&make_token(&mut count));
    transition answer == 7 && count == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
