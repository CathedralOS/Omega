// No owner is established on a statically skipped evaluation path:
// `false && inspect(...)` never constructs the claim-bearing `Pair`
// temporaries, so neither linear member needs an owner or cleanup.
data Receipt [linear] { code: u64; }
data Pair { first: Receipt; second: Receipt; }

machine inspect(pair: &Pair) -> bool {
    pair.first.code == 7 && pair.second.code == 13
}

data Main { }

machine Main::main(main: &mut Main) {
    let observed: bool = false && inspect(Pair {
        first: Receipt { code: 7 },
        second: Receipt { code: 13 }
    });
}
