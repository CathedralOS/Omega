// Expected exit: 0
// Reading a sum tag leaves its nominal owner whole. Its active linear child
// is disposed exactly once, including after alternatives rejoin.
data Counter { drops: u64 in Wrapping; }
data Leaf<'storage> [linear] dropped by drop_leaf<'storage> { counter: &'storage mut Counter; }
machine drop_leaf<'storage>(leaf: &mut Leaf<'storage>) {
    leaf.counter.drops = leaf.counter.drops + 1;
}
data AffineLeaf<'storage> dropped by drop_affine_leaf<'storage> { counter: &'storage mut Counter; }
machine drop_affine_leaf<'storage>(leaf: &mut AffineLeaf<'storage>) {
    leaf.counter.drops = leaf.counter.drops + 1;
}
data Envelope<Value> dropped by drop_envelope<Value> { case Held(value: Value); case Empty; }
machine drop_envelope<Value>(envelope: &mut Envelope<Value>) {}

machine inspect(envelope: Envelope<Leaf>) -> u64 {
    transition envelope {
        Envelope::Held { .. } -> (1)
        Envelope::Empty -> (0)
    }
}

machine relay(envelope: Envelope<Leaf>) -> Envelope<Leaf> {
    let tag: u64 = match (envelope in Envelope::Held) {
        true -> 1,
        false -> 0,
    };
    envelope
}

machine inspect_scalar(envelope: Envelope<u64>) -> u64 {
    transition envelope {
        Envelope::Held { .. } -> (1)
        Envelope::Empty -> (0)
    }
}

machine exercise(counter: &mut Counter) -> u64 {
    inspect(relay(Envelope::Held { value: Leaf { counter: counter } }))
}

machine populate<'storage>(envelope: &mut Envelope<AffineLeaf<'storage>>,
                          counter: &'storage mut Counter) -> u64 {
    envelope = Envelope::Held { value: AffineLeaf { counter: counter } };
    0
}

machine replace_after_observation<'storage>(counter: &'storage mut Counter) -> u64 {
    let mut envelope: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    transition envelope {
        Envelope::Held { .. } -> (1)
        Envelope::Empty -> populate(&mut envelope, counter)
    }
}

machine inspect_affine(envelope: Envelope<AffineLeaf>) -> u64 {
    transition envelope {
        Envelope::Held { .. } -> (1)
        Envelope::Empty -> (0)
    }
}

machine second(first: u64, result: u64) -> u64 { result }

// The first operand replaces the observed case before the later operand's
// selected transfer. Both the consumed and skipped paths owe the new payload.
machine replace_before_selected_consume<'storage>(counter: &'storage mut Counter,
                                                  consume: bool) -> u64 {
    let mut envelope: Envelope<AffineLeaf<'storage>> = Envelope::Empty {};
    transition envelope {
        Envelope::Held { .. } -> (2)
        Envelope::Empty -> second(populate(&mut envelope, counter), match consume {
            true -> inspect_affine(envelope),
            false -> 0,
        })
    }
}

// Reading the outer tag must keep its parent selected while cleanup visits
// the inner case and its shared field. Separate counters detect missing or
// repeated cleanup for both children without borrowing one counter twice.
data NestedChoice<Value> {
    common: Value;
    case Held(value: Value);
    case Empty;
}
machine inspect_nested(envelope: Envelope<NestedChoice<AffineLeaf>>) -> u64 {
    transition envelope {
        Envelope::Held { .. } -> (1)
        Envelope::Empty -> (0)
    }
}
machine nested_case<'storage>(common: &'storage mut Counter,
                             payload: &'storage mut Counter, populated: bool) -> u64 {
    transition populated {
        true -> inspect_nested(Envelope::Held { value: NestedChoice::Held {
            common: AffineLeaf { counter: common },
            value: AffineLeaf { counter: payload },
        } })
        false -> inspect_nested(Envelope::Held { value: NestedChoice::Empty {
            common: AffineLeaf { counter: common },
        } })
    }
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { drops: 0 };
    let held: u64 = exercise(&mut counter);
    let empty: u64 = inspect(relay(Envelope::Empty {}));
    let scalar: u64 = inspect_scalar(Envelope::Held { value: 7 });
    let scalar_empty: u64 = inspect_scalar(Envelope::Empty {});
    let replaced: u64 = replace_after_observation(&mut counter);
    let consumed: u64 = replace_before_selected_consume(&mut counter, true);
    let skipped: u64 = replace_before_selected_consume(&mut counter, false);
    let mut common: Counter = Counter { drops: 0 };
    let mut payload: Counter = Counter { drops: 0 };
    let nested_held: u64 = nested_case(&mut common, &mut payload, true);
    let nested_empty: u64 = nested_case(&mut common, &mut payload, false);
    let nested_outer_empty: u64 = inspect_nested(Envelope::Empty {});
    transition held == 1 && empty == 0 && counter.drops == 4 && replaced == 0
        && consumed == 1 && skipped == 0
        && scalar == 1 && scalar_empty == 0
        && nested_held == 1 && nested_empty == 1 && nested_outer_empty == 0
        && common.drops == 2 && payload.drops == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
