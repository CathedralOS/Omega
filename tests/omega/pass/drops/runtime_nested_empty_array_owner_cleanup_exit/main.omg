domain u64::Positive(value) requires 1 <= value;
data Token { value: u64 in Positive; }
data Holder { tokens: [[Token; 0]; 2]; value: u64; }

machine Holder::drop(holder: &mut Holder)
requires holder.value == 7
{
    holder.value = 0;
}

machine observe(holder: &Holder) -> u64 { holder.value }

machine main() crashes Trap {
    let mut holder: Holder;
    holder.value = 7;
    let observed: u64 = observe(&holder);
    transition observed == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
