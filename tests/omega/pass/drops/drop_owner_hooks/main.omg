use omega::language::core::drop;
// `drop(g)` is the ordinary generic consuming machine: the caller's path
// is proved by transfer, and the checked cleanup edge selects the exact
// owner-attached `Guard::drop` hook. An `[erased]` member carries no
// runtime representation, so `drop(c)` consumes `Carrier` without
// requiring `Carrier::drop` or running `Evidence::drop`.
data Evidence {
    tag: i32;
}
machine Evidence::drop(evidence: &mut Evidence) {
}
data Guard {
    handle: i32;
}
machine Guard::drop(guard: &mut Guard) {
}
data Carrier {
    payload: i32;
    proof [erased]: Evidence;
}
machine main() {
    let g: Guard = Guard { handle: 7 };
    let c: Carrier = Carrier { payload: 1, proof: Evidence { tag: 0 } };
    drop(g);
    drop(c);
}
