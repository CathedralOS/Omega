use omega::language::core::drop;
// `drop(g)` is the ordinary generic consuming machine: the caller's path
// is proved by transfer, and the checked cleanup edge selects the exact
// `dropped by` hook `drop_guard`. An `[erased]` member carries no
// runtime representation, so `drop(c)` consumes `Carrier` without
// requiring a `dropped by` hook on `Carrier` or running `drop_evidence`.
data Evidence dropped by drop_evidence {
    tag: i32;
}
machine drop_evidence(evidence: &mut Evidence) {
}
data Guard dropped by drop_guard {
    handle: i32;
}
machine drop_guard(guard: &mut Guard) {
}
data Carrier {
    payload: i32;
    proof [erased]: Evidence;
}
machine main() {
    let g: Guard = Guard { handle: 7 };
    let c: Carrier = Carrier { payload: 1, proof: Evidence { tag: 0 } };
    drop(g);
    drop(c);
}
