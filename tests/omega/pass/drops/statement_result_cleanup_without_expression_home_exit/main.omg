// Expected exit: 0. Anonymous statement results retain their checked disposal.
data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token) requires token.ready { token.ready = false; }
machine token(value: u64) -> Token ensures result.ready {
    Token { ready: true, value: value }
}
data Outcome { case Empty; case Full(token: Token); }
machine outcome() -> Outcome { Outcome::Empty }
machine main() crashes Trap {
    _ = token(7);
    _ = outcome();
    let named: Token = token(9);
    transition named.value == 9 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
