use omega_language_std::console;
use omega::language::core::binding;

data Choice [copy] { case Empty; case First; case Second; }
data Main { console: Binding<Console>; left: Choice; right: Choice; }

machine Main::main(&mut self) reaches Console {
    self.left = Choice::First;
    self.right = Choice::Second;
    let equal_self: bool = self.left == self.left;
    let equal_other: bool = self.left == self.right;
    let unequal_self: bool = self.right != self.right;
    let unequal_other: bool = self.left != self.right;
    transition equal_self && !equal_other && !unequal_self && unequal_other {
        true -> empty_case()
        false -> finish(1)
    }
    state empty_case(&mut self) {
        self.left = Choice::Empty;
        self.right = Choice::Empty;
        let equal_empty: bool = self.left == self.right;
        transition equal_empty {
            true -> finish(70)
            false -> finish(2)
        }
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
