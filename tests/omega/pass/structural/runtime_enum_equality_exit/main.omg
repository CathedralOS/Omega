use omega_language_std::console;

data Choice [copy] { case Empty; case First; case Second; }
data Main { left: Choice; right: Choice; }

machine Main::main(main: &mut Main) reaches Console {
    main.left = Choice::First;
    main.right = Choice::Second;
    let equal_self: bool = main.left == main.left;
    let equal_other: bool = main.left == main.right;
    let unequal_self: bool = main.right != main.right;
    let unequal_other: bool = main.left != main.right;
    transition equal_self && !equal_other && !unequal_self && unequal_other {
        true -> empty_case(main)
        false -> finish(main, 1)
    }
    machine empty_case(main: &mut Main) {
        main.left = Choice::Empty;
        main.right = Choice::Empty;
        let equal_empty: bool = main.left == main.right;
        transition equal_empty {
            true -> finish(main, 70)
            false -> finish(main, 2)
        }
    }
    machine finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
