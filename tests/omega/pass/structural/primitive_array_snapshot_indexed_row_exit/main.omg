use omega_language_std::console;
data Main { rows: [[i32; 2]; 2]; }
machine Main::swap_row(main: &mut Main, at: u64) requires at < 2 {
    main.rows[at] = [main.rows[at][1], main.rows[at][0]];
}
machine Main::main(main: &mut Main) reaches Console {
    main.rows = [[3, 7], [11, 19]];
    Main::swap_row(main, 1);
    transition main.rows[0][0] == 3 && main.rows[0][1] == 7
        && main.rows[1][0] == 19 && main.rows[1][1] == 11 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
