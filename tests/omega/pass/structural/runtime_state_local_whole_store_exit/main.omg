// A bound local remains the same owned value when stored inside a state graph.
// Read the common member and selected payload after the store and state jump.
use omega_language_std::console;

data Event {
    consumed: bool;
    case Empty;
    case Treasure(gold: u64);
}

data Command { case Off; case Set(value: u64); }
data Cell [copy] { value: u64; }

data Main {
    event: Event;
    command: Command;
    cell: Cell;
}

machine Main::main(context: &mut Main) reaches Console {
    Main::store_copy(context);
    let replacement: Event = Event::Treasure { consumed: true, gold: 50 };
    context.event = replacement;
    transition context.event.consumed && context.cell.value == 19 {
        true -> payload(context)
        false -> bad(context)
    }

    state payload(context: &mut Main) {
        transition context.event {
            Event::Treasure { gold } -> amount(context, gold)
            _ -> bad(context)
        }
    }

    state amount(context: &mut Main, gold: u64) {
        transition gold == 50 {
            true -> replace_command(context)
            false -> bad(context)
        }
    }

    state replace_command(context: &mut Main) {
        let next: Command = Command::Set { value: 20 };
        context.command = next;
        transition context.command {
            Command::Set { value } -> command_value(context, value)
            _ -> bad(context)
        }
    }

    state command_value(context: &mut Main, value: u64) {
        transition value == 20 {
            true -> good(context)
            false -> bad(context)
        }
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}

machine Main::store_copy(context: &mut Main) {
    let first: Cell = Cell { value: 17 };
    let second: Cell = Cell { value: 19 };
    context.cell = second;
}
