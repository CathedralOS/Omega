data Record { value: i32; array: [i32; 2]; }
machine update(record: &mut Record) { record.value = 9; }
machine main() crashes Trap {
    let mut first: Record;
    first.value = 7;
    let mut second: Record = Record { value: 8 };
    transition { _ -> consume(&mut first, &mut second) }
    machine consume(first: &mut Record, second: &mut Record) {
        update(first);
        second.array[0] = first.value;
        transition { _ -> observe(first, second) }
    }
    machine observe(first: &Record, second: &Record) {
        transition first.value == 9 && second.array[0] == 9 && second.value == 8 { true -> done() false -> bad() }
    }
    machine done() { }
    machine bad() { crash Trap; }
}
