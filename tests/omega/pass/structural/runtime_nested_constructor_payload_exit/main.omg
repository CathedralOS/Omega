data Sample [copy] {
    grid: [[i16; 2]; 2];
    flags: [bool; 2];
    empty: [u8; 0];
}
data Envelope [copy] { case Ready(payload: [Sample; 2]); case Empty; }

machine sample(first: i16, second: i16) -> Sample {
    Sample {
        grid: [[first, second], [second, first]],
        flags: [true, false],
        empty: [],
    }
}

machine envelope() -> Envelope {
    Envelope::Ready { payload: [sample(-5i16, 9i16), sample(13i16, -17i16)] }
}

machine changed(values: [Sample; 2]) -> bool {
    let mut independent: [Sample; 2] = values;
    independent[0].grid[0][0] = 73i16;
    independent[0].flags[0] = false;
    independent[0].grid[0][0] == 73i16 && !independent[0].flags[0]
}

machine main() crashes Trap {
    let value: Envelope = envelope();
    transition value {
        Envelope::Ready { payload } -> inspect(payload)
        Envelope::Empty -> bad()
    }
    machine inspect(payload: [Sample; 2]) {
        let observed: bool = changed(payload);
        transition observed && payload[0].grid[0][0] == -5i16
            && payload[0].grid[1][0] == 9i16
            && payload[1].grid[1][1] == 13i16
            && payload[0].flags[0] && !payload[1].flags[1]
            && payload[0].empty.len == 0 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
