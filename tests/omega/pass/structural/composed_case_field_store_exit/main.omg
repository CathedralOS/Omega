// Case replacement inside a multi-state helper must update the caller's
// storage, including a literal, a copied parameter and a payload construction.
use omega_language_std::console;
use omega::language::core::binding;

data Direction [copy] { case Left; case Right; }
data Mode [copy] { case Empty; case Exploring; case Counter(step: u64); }
data Controller { direction: Direction; mode: Mode; count: u64; }
data Main { console: Binding<Console>; controller: Controller; }

machine Controller::before(&mut self) { self.count = 1; }
machine Controller::after(&mut self) { self.count = 2; }

machine Controller::initialize(&mut self, selected: Direction, seed: u64) {
    self.before();
    self.mode = Mode::Exploring;
    self.direction = selected;
    transition { _ -> finish(seed) }
    state finish(&mut self, seed: u64) {
        self.mode = Mode::Counter { step: seed };
        self.after();
    }
}

machine Main::main(&mut self) reaches Console {
    self.controller.initialize(Direction::Right, 7);
    transition self.controller.mode {
        Mode::Counter { step } -> observe(step)
        _ -> finish(1)
    }
    state observe(&mut self, step: u64) {
        transition step == 7 && self.controller.count == 2 {
            true -> observe_direction()
            false -> finish(2)
        }
    }
    state observe_direction(&mut self) {
        transition self.controller.direction {
            Direction::Right -> finish(70)
            _ -> finish(3)
        }
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
