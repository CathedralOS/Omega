// Case replacement inside a multi-state helper must update the caller's
// storage, including a literal, a copied parameter and a payload construction.
use omega_language_std::console;

data Direction [copy] { case Left; case Right; }
data Mode [copy] { case Empty; case Exploring; case Counter(step: u64); }
data Controller { direction: Direction; mode: Mode; count: u64; }
data Main { controller: Controller; }

machine Controller::before(controller: &mut Controller) { controller.count = 1; }
machine Controller::after(controller: &mut Controller) { controller.count = 2; }

machine Controller::initialize(controller: &mut Controller, selected: Direction, seed: u64) {
    Controller::before(controller);
    controller.mode = Mode::Exploring;
    controller.direction = selected;
    transition { _ -> finish(controller, seed) }
    state finish(controller: &mut Controller, seed: u64) {
        controller.mode = Mode::Counter { step: seed };
        Controller::after(controller);
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Controller::initialize(&mut main.controller, Direction::Right, 7);
    transition main.controller.mode {
        Mode::Counter { step } -> observe(main, step)
        _ -> finish(main, 1)
    }
    state observe(main: &mut Main, step: u64) {
        transition step == 7 && main.controller.count == 2 {
            true -> observe_direction(main)
            false -> finish(main, 2)
        }
    }
    state observe_direction(main: &mut Main) {
        transition main.controller.direction {
            Direction::Right -> finish(main, 70)
            _ -> finish(main, 3)
        }
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
