// Repeating an affine payload preserves its provider-bearing element layout.
use omega_language_std::console;

data Task { count: u64; }
data Slot { case Empty; case Held(task: Task); }
data Main {
    slots: [[Slot; 2]; 3];
    count: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 42;
    transition { _ -> finish(main) }
    state finish(main: &mut Main) { Console::exit_process(main.count); }
}
