// Repeating an affine payload preserves its provider-bearing element layout.
use omega_language_std::console;

data Task { count: u64; }
data Slot { case Empty; case Held(task: Task); }
data Main {
    slots: [[Slot; 2]; 3];
    count: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 42;
    transition { _ -> finish(main) }
    machine finish(main: &mut Main) { Console::exit_process(main.count); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
