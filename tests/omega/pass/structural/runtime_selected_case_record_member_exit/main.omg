// Same-spelled payloads keep their selected case through nested member reads.
use omega_language_std::console;

data Reset { success: bool; }
data Metadata { valid: bool; count: i32; }
data Scanned { left: Metadata; right: Metadata; }
data Response {
    case Reset(response: Reset);
    case Scanned(response: Scanned);
}
data Main { }

machine Main::inspect(main: &mut Main, response: Response) reaches Console {
    transition response {
        Response::Reset { response } -> finish(main, 1, 2, response.success)
        Response::Scanned { response } -> finish(main, response.left.count, response.right.count, response.left.valid && !response.right.valid)
    }
    state finish(main: &mut Main, left: i32, right: i32, success: bool) {
        transition success && left == 17 && right == 25 {
            true -> success(main)
            false -> failure(main)
        }
    }
    state success(main: &mut Main) { Console::exit_process(42); }
    state failure(main: &mut Main) { Console::exit_process(1); }
}

machine Main::main(main: &mut Main) reaches Console {
    Main::inspect(main, Response::Scanned {
        response: Scanned { left: Metadata { valid: true, count: 17 }, right: Metadata { valid: false, count: 25 } }
    });
}
