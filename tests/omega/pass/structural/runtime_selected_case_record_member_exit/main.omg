// Same-spelled payloads keep their selected case through nested member reads.
use omega_language_std::console;
use omega::language::core::binding;

data Reset { success: bool; }
data Metadata { valid: bool; count: i32; }
data Scanned { left: Metadata; right: Metadata; }
data Response {
    case Reset(response: Reset);
    case Scanned(response: Scanned);
}
data Main { console: Binding<Console>; }

machine Main::inspect(&mut self, response: Response) reaches Console {
    transition response {
        Response::Reset { response } -> finish(1, 2, response.success)
        Response::Scanned { response } -> finish(response.left.count, response.right.count, response.left.valid && !response.right.valid)
    }
    state finish(&mut self, left: i32, right: i32, success: bool) {
        transition success && left == 17 && right == 25 {
            true -> success()
            false -> failure()
        }
    }
    state success(&mut self) { self.console.exit_process(42); }
    state failure(&mut self) { self.console.exit_process(1); }
}

machine Main::main(&mut self) reaches Console {
    self.inspect(Response::Scanned {
        response: Scanned { left: Metadata { valid: true, count: 17 }, right: Metadata { valid: false, count: 25 } }
    });
}
