// A local array declared without an initializer is established by its
// declaration: its zero-constructible shape begins zero and element stores
// fill it. A record literal field then moves the whole array, the same way
// it moves an initialized local or a parameter. Untouched elements keep
// their zero establishment through the move.
use omega_language_std::console;

data FieldEntry { key: u64; offset: u64; }
data Plan { entries: [FieldEntry; 8]; entry_count: u64; }
data Main { }

machine plan() -> Plan {
    let mut entries: [FieldEntry; 8];
    entries[1] = FieldEntry { key: 40, offset: 24 };
    entries[2] = FieldEntry { key: 8, offset: 32 };
    Plan { entries: entries, entry_count: 3 }
}

machine Main::main(main: &mut Main) reaches Console {
    let result: Plan = plan();
    transition result.entries[0].key == 0
        && result.entries[0].offset == 0
        && result.entries[1].key == 40
        && result.entries[1].offset == 24
        && result.entries[2].offset == 32
        && result.entries[7].key == 0
        && result.entry_count == 3 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
