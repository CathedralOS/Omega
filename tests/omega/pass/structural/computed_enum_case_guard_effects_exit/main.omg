data Choice [copy] { case First; case Second; }
data Counter { calls: i32 in Wrapping; }
machine choose(counter: &mut Counter, flag: bool) -> Choice {
    counter.calls = counter.calls + 1;
    transition flag {
        true -> (Choice::First)
        false -> (Choice::Second)
    }
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { calls: 0 };
    transition choose(&mut counter, true) == Choice::First
        && Choice::First != choose(&mut counter, false)
        && counter.calls == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
