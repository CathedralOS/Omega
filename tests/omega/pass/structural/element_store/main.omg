// Regression for the structural element store: `self.items[i] = node` and
// `self.fmts[1] = Fmt::Octal` — the store's destination path ends in an
// element selection on a fixed-array field rather than a field segment.
// Lowering writes the consumed value through the root's window move/store
// pair at the element offset, scaling each runtime selector by its stride.
// Previously every index-ended path declined at the checked-trees window
// place map ("all-Field path"), so the machine was omitted outright.

use omega_language_std::console;
use omega::language::core::binding;

data Fmt [copy] {
    case Decimal;
    case Hex;
    case Octal;
}

data Node {
    tag: u64;
    fmt: Fmt;
}

data Main {
    console: Binding<Console>;
    nodes: [Node; 4];
    fmts: [Fmt; 4];
    cursor: u64;
}

machine Main::fill(&mut self, at: u64, node: Node)
    requires at < self.nodes.len
{
    self.nodes[at] = node;
}

machine Main::fill_local(&mut self) {
    let node: Node = Node { tag: 9, fmt: Fmt::Hex };
    self.nodes[0] = node;
    self.fmts[1] = Fmt::Octal;
}

machine Main::main(&mut self) reaches Console {
    self.fill(2, Node { tag: 4, fmt: Fmt::Decimal });
    self.fill_local();
    self.console.exit_process(0);
}
