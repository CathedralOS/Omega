use omega_language_std::console;
use omega::language::core::binding;

data Settings [copy] { count: i32; }
data Main { console: Binding<Console>; first: i32; second: i32; }

machine Settings::default() -> Settings { Settings { count: 1 } }
machine Settings::set_count(settings: &mut Settings, count: i32) { settings.count = count; }
machine Main::capture_first(context: &mut Main, settings: Settings) { context.first = settings.count; }
machine Main::capture_second(context: &mut Main, settings: Settings) { context.second = settings.count; }
machine Main::main(context: &mut Main) reaches Console {
    let mut settings: Settings = Settings::default();
    Settings::set_count(&mut settings, 17);
    Main::capture_first(context, settings);
    Settings::set_count(&mut settings, 25);
    Main::capture_second(context, settings);
    transition context.first == 17 && context.second == 25 && settings.count == 25 {
        true -> finish(context, 42)
        false -> finish(context, 1)
    }
    state finish(context: &mut Main, code: i32) { context.console.exit_process(code); }
}
