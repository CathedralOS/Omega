use omega_language_std::console;
use omega::language::core::binding;

data Handle<'e> {
    name: &'e [u8];
    tag: i32;
}

data Main {
    console: Binding<Console>;
    buffer: [u8; 8];
}

machine Main::pick<'e>(s: &'e [u8], flag: bool) -> Handle<'e> {
    transition flag {
        true -> left(s)
        _ -> right(s)
    }
    state left(s: &'e [u8]) -> Handle<'e> {
        Handle { name: s, tag: 1 }
    }
    state right(s: &'e [u8]) -> Handle<'e> {
        Handle { name: s, tag: 2 }
    }
}

machine Main::main(&mut self) reaches Console {
    self.console.exit_process(42);
}
