use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; values: [i32; 2]; }
machine Main::swap(main: &mut Main) {
    main.values = [main.values[1], main.values[0]];
}
machine Main::main(main: &mut Main) reaches Console {
    main.values = [3, 7];
    Main::swap(main);
    transition main.values[0] == 7 && main.values[1] == 3 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(0); }
    state bad(main: &mut Main) { main.console.exit_process(1); }
}
