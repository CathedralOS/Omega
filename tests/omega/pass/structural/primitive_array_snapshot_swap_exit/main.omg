use omega_language_std::console;
data Main { values: [i32; 2]; }
machine Main::swap(main: &mut Main) {
    main.values = [main.values[1], main.values[0]];
}
machine Main::main(main: &mut Main) reaches Console {
    main.values = [3, 7];
    Main::swap(main);
    transition main.values[0] == 7 && main.values[1] == 3 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(0); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
