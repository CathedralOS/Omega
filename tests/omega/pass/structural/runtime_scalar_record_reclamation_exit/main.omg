// Repeated copies cross storage collection thresholds while a caller root,
// a captured shared referent, the current record and returned records remain live.
data Record [copy] { value: u64; stamp: u64; }
data Held [copy] { target: &Record; }
data Main { seed: u64; }
machine carry(value: Record) -> Record { value }
machine churn(held: Held, value: Record) -> Record {
    transition { _ -> repeat(held, value, 0) }
    state repeat(held: Held, value: Record, count: u64) -> Record {
        transition count < 4096 {
            true -> next(held, value, count)
            false -> (value)
        }
    }
    state next(held: Held, value: Record, count: u64) -> Record {
        let mut copied: Record = carry(value);
        transition copied.value == held.target.value && copied.stamp == count {
            true -> increment(held, copied, count)
            false -> (Record { value: 1, stamp: 0 })
        }
    }
    state increment(held: Held, value: Record, count: u64) -> Record {
        transition count < 4096 { true -> stamp(held, value, count) false -> (value) }
    }
    state stamp(held: Held, value: Record, count: u64) -> Record {
        let mut next: Record = value;
        transition count < 4096 { true -> store(held, next, count + 1) false -> (next) }
    }
    state store(held: Held, value: Record, count: u64) -> Record {
        let mut next: Record = value; next.stamp = count;
        transition { _ -> repeat(held, next, count) }
    }
}
machine Main::main(main: &mut Main) crashes Trap {
    let stable: Record = Record { value: main.seed, stamp: 0 };
    let held: Held = Held { target: &stable };
    let result: Record = churn(held, stable);
    transition result.value == stable.value && result.stamp == 4096 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
