data Choice [copy] { case First; case Second; }
machine choose(flag: bool) -> Choice {
    transition flag {
        true -> (Choice::First)
        false -> (Choice::Second)
    }
}
machine main() crashes Trap {
    transition choose(true) == Choice::First && choose(false) != Choice::First {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
