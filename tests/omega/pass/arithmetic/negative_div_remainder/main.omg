// Signed division/remainder at value position select typed truncating
// entries per operand carrier: `(0i32 - 17) / 5` truncates toward zero
// (-3), `%` keeps the dividend's sign (-2) — the pair recomposes -17.
data Main { }

machine Main::main(main: &mut Main) {
    let unsigned: u64 = 12u64 / 4u64;
    transition unsigned == 3u64 {
        true -> finish((0i32 - 17) / 5i32 + (0i32 - 17) % 5i32)
        false -> bad()
    }
    machine finish(value: i32) {
        transition value == (0i32 - 5) {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() {}
}
