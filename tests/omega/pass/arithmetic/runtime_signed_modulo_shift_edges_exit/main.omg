// Sign-sensitive integer codegen -- the classic miscompile spots, guarded directly:
//   - signed modulo with negatives: -7 % 3 == -1 and 7 % -3 == 1 (truncated; sign follows dividend)
//   - arithmetic (sign-extending) right shift: -16 >> 2 == -4 (SAR), vs unsigned 16 >> 2 == 4 (SHR)
//   - runtime shift amount: 1 << n with n == 5 a runtime value == 32 (count from CL, not an imm)
// Each is discriminated; exits 70 iff all hold.
use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    transition { _ -> modulo(context, 0 - 7, 3) }

    state modulo(context: &mut Main, negative: i32 in Wrapping,
                 divisor: i32 in Wrapping) {
        let first_remainder: i32 in Wrapping = negative % divisor;
        let positive: i32 in Wrapping = 0 - negative;
        let negative_divisor: i32 in Wrapping = 0 - divisor;
        let second_remainder: i32 in Wrapping = positive % negative_divisor;
        transition first_remainder == 0 - 1 {
            true -> mod2(context, second_remainder)
            _ -> bad(context)
        }
    }

    state mod2(context: &mut Main, remainder: i32 in Wrapping) {
        transition remainder == 1 { true -> shifts(context, 0 - 16, 16) _ -> bad(context) }
    }
    state shifts(context: &mut Main, signed_value: i32 in Wrapping,
                 unsigned_value: u32 in Wrapping) {
        let signed_shift: i32 in Wrapping = signed_value >> 2;
        let unsigned_shift: u32 in Wrapping = unsigned_value >> 2;
        transition signed_shift == 0 - 4 {
            true -> ushift(context, unsigned_shift)
            _ -> bad(context)
        }
    }
    state ushift(context: &mut Main, shifted: u32 in Wrapping) {
        transition shifted == 4 {
            true -> runtime_shift(context, 5)
            _ -> bad(context)
        }
    }
    state runtime_shift(context: &mut Main, shift_count: i32 in Wrapping) {
        let base: i32 in Wrapping = 1;
        let shifted: i32 in Wrapping = base << shift_count;
        transition shifted == 32 { true -> ok(context) _ -> bad(context) }
    }
    state ok(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
