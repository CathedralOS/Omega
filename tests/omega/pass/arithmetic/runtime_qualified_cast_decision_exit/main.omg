domain u32::Marked;

machine narrow(value: u32) -> u8
requires value <= 255
{
    (value as u32 in Marked) as u8
}

machine main() crashes Trap {
    let first_result: u8 = narrow(42u32);
    let second_result: u8 = narrow(84u32);
    transition first_result == 42u8 && second_result == 84u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
