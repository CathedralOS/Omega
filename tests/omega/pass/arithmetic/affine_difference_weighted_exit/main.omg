// Expected exit: 0. Repeated coefficient mass and negative edge bounds remain exact.
machine weighted(first: u64, second: u64, third: u64, fourth: u64) -> u64
requires first >= second && third >= fourth
ensures 2 * embed(first) + 3 * embed(third) >= 2 * embed(second) + 3 * embed(fourth)
{ 0 }
machine negative_edges(first: u64, second: u64, third: u64, fourth: u64) -> u64
requires embed(first) + 1 >= embed(second) && embed(third) + 2 >= embed(fourth)
ensures embed(first) + embed(third) + 3 >= embed(second) + embed(fourth)
{ 0 }
machine main() crashes Trap {
    let repeated: u64 = weighted(10, 10, 1, 1);
    let negative: u64 = negative_edges(0, 1, 0, 2);
    transition repeated == 0 && negative == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
