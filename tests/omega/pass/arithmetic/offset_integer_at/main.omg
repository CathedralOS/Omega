use omega::language::core::layout;
// An unaligned `FieldPlan::IntegerAt` placement: offset 1 with stored_width
// 16 inside a size_fixed:4, align:1 plan.
data OffsetWord {}
machine OffsetWord::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 1,
            stored_width: 16,
            interpretation: IntegerInterpretation::Unsigned,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 4,
        size_is_dynamic: false,
        align: 1,
    }
}
data PortableWord [copy] { value: u64; }
data Main { word: OffsetWord<PortableWord>; }
machine Main::main(main: &mut Main) {
    main.word.value = 44444;
    transition main.word.value == 44444 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
