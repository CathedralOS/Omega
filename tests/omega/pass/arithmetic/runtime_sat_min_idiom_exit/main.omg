// RUN CANARY (exit 70) + interpreter differential. The MIN idiom
// `0 - 2147483648` (Omega has no negative literals; subtraction-from-zero
// IS the spelling for TYPE_MIN) computes MIN on all three engines. The
// sat/trap narrow paths sign-extend only NON-IMMEDIATE operands -- an
// immediate is loaded at its true wide value, and re-extending it from the
// target width corrupted 2147483648 into -2^31, saturating the subtraction
// to MAX (found probing the shift arc; a validation-level rejection was
// tried and REVERTED -- it breaks this exact idiom corpus-wide). aarch64:
// per-side skip in the shared extension block. x86_64: the flag-width
// narrow add/sub could not hold a wide immediate at all and MIGRATED to
// the wide-64-bit-op + shared range tail shape (multiply/shl's skeleton),
// with the unsigned tail direction-split per operator (subtract clamps
// DOWNWARD through a signed compare); the multiply prologue movsx takes
// the same per-side skip. Byte-pinned via the linux_x86_64 ELF pin.
// exits: 70 = MIN; 71 = MAX (the old corruption); 99 = other.
use omega_language_std::console;
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 in Saturating = (0 as i32 in Saturating) - 2147483648;
    transition a == (0 as i32 in Saturating) - 2147483647 - 1 {
        true  -> is_min()
        false -> chk_max()
    }
    state chk_max(&mut self) {
        transition a == 2147483647 {
            true  -> is_max()
            false -> other()
        }
    }
    state is_min(&mut self) { self.console.exit_process(70); }
    state is_max(&mut self) { self.console.exit_process(71); }
    state other(&mut self)  { self.console.exit_process(99); }
}
