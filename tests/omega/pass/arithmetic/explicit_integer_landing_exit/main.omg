// Explicit integer landing: anonymous arithmetic stays exact, and `as` around
// the complete anonymous expression acknowledges its fractional intermediate
// and lands the exact final value. Each place below lands `(7 / 2) * 2` as 7,
// where typed `7u64 / 2 * 2` would give 6. The implicit twin is
// fail/arithmetic/implicit_fractional_integer_landing.
// Expected exit: 70 when every landing yields 7; otherwise 71.
use omega_language_std::Console;

const SEVEN: u64 = ((7 / 2) * 2) as u64;

data Held [copy] { value: u64; }

machine identity(value: u64) -> u64 { value }

machine returned() -> u64 { ((7 / 2) * 2) as u64 }

machine joined(flag: bool) -> u64 {
    (match flag {
        true -> (7 / 2) * 2,
        false -> 14 / 2
    }) as u64
}

machine forwarded() -> u64 {
    transition { _ -> finish(((7 / 2) * 2) as u64) }
    machine finish(value: u64) -> u64 { value }
}

machine local() -> u64 {
    let value: u64 = ((7 / 2) * 2) as u64;
    value
}

machine field() -> u64 {
    let held: Held = Held { value: ((7 / 2) * 2) as u64 };
    held.value
}

machine typed() -> u64 { 7u64 / 2 * 2 }

machine entry_start() reaches Console {
    let all: bool = local() == 7 && field() == 7 && identity(((7 / 2) * 2) as u64) == 7
        && returned() == 7 && joined(true) == 7 && joined(false) == 7
        && SEVEN == 7 && forwarded() == 7 && ((0.5 * 4096) as u64) == 2048
        && (((1 / 3 + 1 / 6) * 1000) as u64) == 500 && typed() == 6;
    let outcome: i32 = match all {
        true -> 70,
        false -> 71
    };
    Console::exit_process(outcome);
}
