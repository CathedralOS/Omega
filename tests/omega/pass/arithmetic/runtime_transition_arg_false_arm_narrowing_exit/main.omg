// RUN canary (exit 70). Dominating-guard narrowing on the FALSE arm: the arm
// fires when `n >= 70` is FALSE, i.e. `n < 70` (negate `>=` -> `<`), so `n + 1`
// proves EXACT without an annotation even though i32 + 1 could otherwise
// overflow at the type's upper bound. climb(0) walks 0..70 through the false
// arm, then the true arm exits 70.
use omega_language_std::console;
data Main { }
machine Main::climb(context: &mut Main, n: i32) reaches Console {
    transition n >= 70 {
        true -> done(context, n)
        false -> Main::climb(context, n + 1)
    }
    state done(context: &mut Main, n: i32) { Console::exit_process(n); }
}
machine Main::main(context: &mut Main) { Main::climb(context, 0); }
