// Equivalent bounded sums retain independent carrier proofs through a
// local value, a record field, a call result, and a later state.
use omega_language_std::console;
data Ledger { value: u64; }
data Main { ledger: Ledger; }
machine identity(value: u64) -> u64 { value }
machine fingerprint(value: u64) -> u64 {
    (value % 100 * 2 + value % 100 * 3 + value % 100 * 5 + value % 100 * 7 + value % 100 * 11 + value % 100 * 13 + value % 100 * 17 + value % 100 * 19 + value % 100 * 23 + value % 100 * 29 + value % 100 * 31 + value % 100 * 37 + value % 100 * 41) % 191 + 1
}
machine field_fingerprint(ledger: &Ledger) -> u64 {
    (ledger.value % 100 * 2 + ledger.value % 100 * 3 + ledger.value % 100 * 5 + ledger.value % 100 * 7 + ledger.value % 100 * 11 + ledger.value % 100 * 13 + ledger.value % 100 * 17 + ledger.value % 100 * 19 + ledger.value % 100 * 23 + ledger.value % 100 * 29 + ledger.value % 100 * 31 + ledger.value % 100 * 37 + ledger.value % 100 * 41) % 191 + 1
}
machine call_fingerprint(value: u64) -> u64 {
    (identity(value) % 100 * 2 + identity(value) % 100 * 3 + identity(value) % 100 * 5 + identity(value) % 100 * 7 + identity(value) % 100 * 11 + identity(value) % 100 * 13 + identity(value) % 100 * 17 + identity(value) % 100 * 19 + identity(value) % 100 * 23 + identity(value) % 100 * 29 + identity(value) % 100 * 31 + identity(value) % 100 * 37 + identity(value) % 100 * 41) % 191 + 1
}
machine Main::main(main: &mut Main) reaches Console {
    main.ledger.value = 1;
    let local: u64 = main.ledger.value;
    let local_result: u64 = fingerprint(local);
    transition { _ -> compare(main, local_result) }
    state compare(main: &mut Main, local_result: u64) {
        let field_result: u64 = field_fingerprint(&main.ledger);
        let call_result: u64 = call_fingerprint(main.ledger.value);
        transition local_result == 48 && field_result == 48 && call_result == 48 {
            true -> accepted(main)
            false -> rejected(main)
        }
    }
    state accepted(main: &mut Main) { Console::exit_process(48); }
    state rejected(main: &mut Main) { Console::exit_process(1); }
}
