// RUN CANARY (exit 70) + interpreter differential. Wrapping `<<` by a count
// at/above the operand width MASKS the count (F8b, ch5 shift-count ruling
// 2026-07-18: `k & (width - 1)` -- the genuinely modular reading, and what
// the hardware computes anyway). 1i32 << 40 masks to << 8 = 256 -- the value
// x86 hardware always produced and the interp/aarch64 once "fixed" to the
// retired modular-VALUE zero; that old divergence pin now runs the OTHER
// way (exit 71 = the retired zero). Operand legs nest `(b << c) + 5` so the
// shl runs at the NODE width on the operand path: count 40 at u32 masks to
// 8 (261); count 70 at u32 masks to 6 (69).
// exits: 71 = i32 write leg gave the RETIRED modular zero; 99 = neither;
// 72/73 = operand leg count 40/70 not masked.

use omega_language_std::console;
data Main { console: Console; n: i32 in Wrapping; }
machine Main::main(&mut self) {
    self.n = 40;
    let a: i32 in Wrapping = 1;
    let y: i32 in Wrapping = a << self.n;
    transition y == 256 {
        true  -> operand_count40()
        false -> diagnose_write()
    }
    state diagnose_write(&mut self) {
        transition y == 0 {
            true  -> retired_modular_zero()
            false -> weird()
        }
    }
    state operand_count40(&mut self) {
        let b: u32 in Wrapping = (1 as u32 in Wrapping);
        let c: u32 in Wrapping = (40 as u32 in Wrapping);
        let r: u32 in Wrapping = (b << c) + 5;
        transition r == 261 {
            true  -> operand_count70()
            false -> wrong_operand40()
        }
    }
    state operand_count70(&mut self) {
        let b: u32 in Wrapping = (1 as u32 in Wrapping);
        let c: u32 in Wrapping = (70 as u32 in Wrapping);
        let r: u32 in Wrapping = (b << c) + 5;
        transition r == 69 {
            true  -> good()
            false -> wrong_operand70()
        }
    }
    state good(&mut self)            { self.console.exit_process(70); }
    state retired_modular_zero(&mut self) { self.console.exit_process(71); }
    state wrong_operand40(&mut self) { self.console.exit_process(72); }
    state wrong_operand70(&mut self) { self.console.exit_process(73); }
    state weird(&mut self)           { self.console.exit_process(99); }
}
