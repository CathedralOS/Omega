use omega::language::core::binding;
use omega_language_std::console;
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> digits(main, 100) }
    state digits(main: &mut Main, value: i64 in Wrapping) {
        main.console.write_byte(48);
        let next: i64 in Wrapping = value / 10;
        transition next > 0 {
            true -> digits(main, next)
            _ -> done(main)
        }
    }
    state done(main: &mut Main) {
        main.console.write_byte(10);
        main.console.exit_process(70);
    }
}
