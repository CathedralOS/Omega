use omega::language::core::float_operations;

// The canonical isNaN idiom: `f != f` is TRUE exactly when f is NaN (IEEE),
// and `f == f` is FALSE. This was silently miscompiled by the untyped
// reflexive fold (`x != x -> false` structurally) until the fold was
// TYPE-GATED (2026-07-02): float self-compares now lower to the real
// ucomis* runtime compare, whose NaN parity handling the sibling canary
// runtime_float_nan_comparison_exit pins for distinct operands.
use omega_language_std::console;
use omega::language::core::binding;
data Operands {
    f: f64;
}
data Main { console: Binding<Console>; }
machine Main::main(context: &mut Main) reaches Console {
    let mut operands: Operands;
    operands.f = 0.0f64 / 0.0;
    transition operands.f != operands.f {
        true -> check_eq(context, &operands)
        false -> bad(context)
    }
    state check_eq(context: &mut Main, operands: &Operands) {
        // NaN == NaN must be FALSE.
        transition operands.f == operands.f {
            true -> bad(context)
            false -> good(context)
        }
    }
    state good(context: &mut Main) { context.console.exit_process(70); }
    state bad(context: &mut Main) { context.console.exit_process(71); }
}
