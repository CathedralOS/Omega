// Typed integer literal suffixes select the literal's primitive type:
// `100i64`, `7u32`, `9usize` round-trip through storage and compare
// equal to the same suffixed literal.
data Main { wide: i64; small: u32; size: u64; }

machine Main::main(main: &mut Main) {
    main.wide = 100i64;
    main.small = 7u32;
    main.size = 9usize;
    transition main.wide == 100i64 && main.small == 7u32 && main.size == 9usize {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
