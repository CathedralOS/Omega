// Const-folding arithmetic that overflows i64 (`9e18 + 9e18` add, `4e9 * 4e9`
// multiply, `(1 << 63) / -1` division) used to PANIC the compiler ("attempt to
// add/multiply/divide with overflow", omega-state-values folder). The folder now uses
// wrapping arithmetic so it computes a value instead of crashing (overflow into an
// EXACT domain is caught earlier by decision-17). Exits a fixed 0, robust to the
// wrapped values.
use omega_language_std::console;
use omega::language::core::service;
data Main { console: Binding<Console>; a: i64 in Wrapping; b: i64 in Wrapping; c: i64 in Wrapping; }
machine Main::main(&mut self) reaches Console {
    // Anonymous folds stay exact until an operand lands (decision 17), so each
    // operand lands in the field's declared Wrapping carrier before combining.
    let add_l: i64 in Wrapping = 9000000000000000000;
    let add_r: i64 in Wrapping = 9000000000000000000;
    let mul_l: i64 in Wrapping = 4000000000;
    let mul_r: i64 in Wrapping = 4000000000;
    let min: i64 in Wrapping = -9223372036854775807 - 1;
    let neg_one: i64 in Wrapping = -1;
    self.a = add_l + add_r;      // add overflow wraps
    self.b = mul_l * mul_r;      // multiply overflow wraps
    self.c = min / neg_one;      // i64::MIN / -1 division overflow wraps
    self.console.exit_process(0);
}
