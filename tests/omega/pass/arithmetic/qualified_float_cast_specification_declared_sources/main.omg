use omega::language::core::float_operations;
machine sample() -> f64[3.0..=3.0] { 3.0 }
proposition parameter_exact(value: f64[3.0..=3.0]) = (value as u8 in Trapping) == 3u8;
proposition selected_result_exact() = (sample() as u8 in Wrapping) == 3u8;
proposition format_exact(value: f64[3.75..=3.75]) = (value as f32) == 3.75f32;
