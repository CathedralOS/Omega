use omega::language::core::float_operations;

machine sample() -> f64
    ensures result == 3.0;
{
    3.0
}

machine format_sample() -> f64
    ensures result == 3.75;
{
    3.75
}

proposition parameter_exact() = (sample() as u8 in Trapping) == 3u8;
proposition selected_result_exact() = (sample() as u8 in Wrapping) == 3u8;
proposition format_exact() = (format_sample() as f32) == 3.75f32;
