// Named integer width conversions must pick the right extension -- the classic
// movsx-vs-movzx trap:
//   i32 -1 -> wrapping i8 -> i32  = -1  (signed narrowing round-trips)
//   i32 -1 -> wrapping u8 -> i32  = 255 (0xFF read as an unsigned byte)
//   i32 200 -> wrapping i8 -> i32 = -56 (0xC8 sign-extends)
// A wrong extension (zero where sign is needed, or vice versa) would silently corrupt the value.
// Each is chained; exits 70 iff all hold.
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    x: i32 in Wrapping;
    y8: i8 in Wrapping;
    yu8: u8 in Wrapping;
    z: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.x = 0 - 1;
    self.y8 = narrow_i32_to_i8_wrapping(self.x as i32) as i8 in Wrapping;
    self.z = widen_i8_to_i32(self.y8 as i8) as i32 in Wrapping;
    transition self.z == 0 - 1 {
        true -> zero_ext()
        _ -> bad()
    }
    state zero_ext(&mut self) {
        self.x = 0 - 1;
        self.yu8 = narrow_i32_to_u8_wrapping(self.x as i32) as u8 in Wrapping;
        self.z = widen_u8_to_i32(self.yu8 as u8) as i32 in Wrapping;
        transition self.z == 255 {
            true -> trunc()
            _ -> bad()
        }
    }
    state trunc(&mut self) {
        self.x = 200;
        self.y8 = narrow_i32_to_i8_wrapping(self.x as i32) as i8 in Wrapping;
        self.z = widen_i8_to_i32(self.y8 as i8) as i32 in Wrapping;
        transition self.z == 0 - 56 {
            true -> ok()
            _ -> bad()
        }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(self.z as i32); }
}
