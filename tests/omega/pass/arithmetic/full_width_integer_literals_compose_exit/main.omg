// Fixed unsigned values retain their carrier in every runtime consumer.
machine maximum() -> u64 { 18446744073709551615u64 }
machine identity(value: u64) -> u64 { value }
machine decrement(value: u64) -> u64
requires value > 0
ensures result == value - 1
{ value - 1u64 }

machine main() crashes Trap {
    let returned: u64 = maximum();
    let called: u64 = identity(18446744073709551615u64);
    let anonymous: u64 = identity(18446744073709551615);
    let computed: u64 = 18446744073709551615u64 - 1u64;
    let decremented: u64 = decrement(18446744073709551615u64);
    let folded: u64 = (18446744073709551616 + 1) - 2;
    transition returned == called && called == anonymous
        && called > 9223372036854775807u64
        && 9223372036854775808u64 < called
        && computed == decremented && decremented == 18446744073709551614u64
        && folded == called {
        true -> delivered(18446744073709551615u64)
        _ -> bad()
    }
    machine delivered(value: u64) {
        transition value == 18446744073709551615u64 { true -> done() _ -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
