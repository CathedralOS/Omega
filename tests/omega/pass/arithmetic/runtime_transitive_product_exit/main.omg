machine double(value: i32, floor: i32, ceiling: i32) -> i32 {
    let valid: bool = -10i32 <= floor && floor < value
        && value < ceiling && ceiling <= 10i32;
    transition { _ -> decide(value, valid) }

    machine decide(value: i32, valid: bool) -> i32 {
        transition valid {
            true -> calculate(value)
            false -> empty()
        }
    }
    machine calculate(value: i32) -> i32 { value * 2i32 }
    machine empty() -> i32 { 0i32 }
}

machine main() crashes Trap {
    let low: i32 = double(-9i32, -10i32, 10i32);
    let high: i32 = double(9i32, -10i32, 10i32);
    let refused: i32 = double(100i32, -10i32, 10i32);
    transition low == -18i32 && high == 18i32 && refused == 0i32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
