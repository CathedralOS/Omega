machine positive(value: u8) requires value > 0 {}
machine below(value: u8) requires value < 255 {}
machine above_min(value: i8) requires value > -128 {}
machine below_max(value: i8) requires value < 127 {}
machine unsigned_edges(value: u8) {
 transition { 0 != value -> positive(value) _ -> {} }
}
machine unsigned_high(value: u8) { transition { value != 255 -> below(value) _ -> {} } }
machine signed_low(value: i8) { transition { value != -128 -> above_min(value) _ -> {} } }
machine signed_high(value: i8) { transition { 127 != value -> below_max(value) _ -> {} } }
machine main() {
 unsigned_edges(0); unsigned_edges(1);
 unsigned_high(254); unsigned_high(255);
 signed_low(-128); signed_low(-127);
 signed_high(126); signed_high(127);
}
