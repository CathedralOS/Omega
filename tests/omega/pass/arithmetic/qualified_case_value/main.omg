// Case values use explicit carrier qualification. State values instead reach a
// sibling through an explicit argument and bind to that sibling's parameter.

use omega_language_std::console;
use omega::language::core::service;

data Light { case Off; case On; }

data Main { console: Binding<Console>; }

machine Main::main(&mut self) reaches Console {
    let signal: Light = Light::On;
    transition { _ -> classify(70) }
    state classify(&mut self, n: i32 [0..=100]) {
        transition n > 0 {
            true -> report(n)
            _ -> zero()
        }
    }
    state report(&mut self, n: i32 [0..=100]) { self.console.exit_process(n); }
    state zero(&mut self) { self.console.exit_process(2); }
}