// RUN canary (exit 70). Regression for the #59 native miscompile: a domain-cast
// of a slice ELEMENT in a recursive accumulator argument
// (`acc + (s[0] as i32 in Wrapping)`) silently read 0 natively because the cast
// could not classify its element source, so the whole binary operand nulled out
// and the accumulator argument was dropped. Fixed by classifying a slice-element
// read from the collection's element type. arr = [10,20,15,25] sums to 70.
use omega_language_std::console;
data Summer {}
data Main { console: Console; arr: [i32; 4]; summer: Summer; }
machine Summer::sum(&mut self, s: &[i32], acc: i32 in Wrapping) -> i32 in Wrapping
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> sum(s[1..], acc + (s[0] as i32 in Wrapping))
        false -> acc
    }
}
machine Main::main(&mut self) {
    self.arr[0] = 10; self.arr[1] = 20; self.arr[2] = 15; self.arr[3] = 25;
    let s: &[i32] = self.arr.as_slice();
    let total: i32 in Wrapping = self.summer.sum(s, 0);
    self.console.exit_process(total as i32);
}
