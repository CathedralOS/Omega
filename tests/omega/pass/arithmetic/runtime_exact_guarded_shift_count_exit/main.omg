// RUN CANARY (exit 70) + interpreter differential. A dominating incoming
// guard proves a runtime Exact count is in 0..32, while the value's declared
// [0..=1] range proves every admitted `value * 2^count` remains in u32. Count
// validity and value overflow are independent obligations; both hold.
use omega_language_std::console;
data Operands where 0 <= value, value <= 1 { count: u32; value: u32; result: u32; }
data Main { }
machine Main::main(context: &mut Main) reaches Console
{
    let mut operands: Operands;
    operands.count = 5;
    operands.value = 1;
    transition operands.count < 32 {
        true -> shift(context, &mut operands)
        _ -> bad(context)
    }
    machine shift(context: &mut Main, operands: &mut Operands)
    {
        operands.result = operands.value << operands.count;
        transition operands.result == 32 {
            true -> good(context)
            _ -> bad(context)
        }
    }
    machine good(context: &mut Main)
    { Console::exit_process(70); }
    machine bad(context: &mut Main)
    { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
