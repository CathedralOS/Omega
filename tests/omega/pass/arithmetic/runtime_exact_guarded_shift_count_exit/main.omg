// RUN CANARY (exit 70) + interpreter differential. A dominating incoming
// guard proves a runtime Exact count is in 0..32, while the value's declared
// [0..=1] range proves every admitted `value * 2^count` remains in u32. Count
// validity and value overflow are independent obligations; both hold.
use omega_language_std::console;
data Main { console: Console; count: u32; value: u32 [0..=1]; result: u32; }
machine Main::main(&mut self) {
    self.count = 5;
    self.value = 1;
    transition self.count < 32 {
        true -> shift()
        _ -> bad()
    }
    state shift(&mut self) {
        self.result = self.value << self.count;
        transition self.result == 32 {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
