// RUN CANARY (exit 70) + interpreter differential. N2 rung (c) positive
// twin: the guarded-COPY shape discharges the [0..=i64::MAX] store for a
// plain u64 source -- the incoming edge's stable guard bounds the exact
// range where the type fact alone (now the true [0, u64::MAX]) cannot.
use omega_language_std::console;
data Values where 0 <= capped, capped <= 9223372036854775807 { raw: u64; capped: u64; }
data Main { }
machine Main::main(context: &mut Main) reaches Console
{
    let mut values: Values;
    values.raw = 42;
    transition values.raw <= 9223372036854775807 { true -> store(context, &mut values) _ -> bad(context) }
    state store(context: &mut Main, values: &mut Values)
    {
        values.capped = values.raw;
        Console::exit_process(70);
    }
    state bad(context: &mut Main)
    { Console::exit_process(71); }
}
