machine half(value: u64) -> u64
    ensures (value >> 1u64) <= 9223372036854775807
    ensures result <= 9223372036854775807
{ value >> 1u64 }
machine shifted(value: u64, count: i8) -> u64
    requires count >= 1 && count <= 63
    ensures (value >> count) <= 9223372036854775807
    ensures result <= 9223372036854775807
{ value >> count }
machine masked(value: u64) -> u64
    requires value >= 16 && value <= 31
    ensures (value & 16u64) >= 16
    ensures result == 16
{ value & 16u64 }
machine main() crashes Trap {
    let high: u64 = half(18446744073709551615u64);
    let zero: u64 = half(0u64);
    let variable: u64 = shifted(18446744073709551615u64, 1i8);
    let top: u64 = shifted(18446744073709551615u64, 63i8);
    let first: u64 = masked(16u64);
    let last: u64 = masked(31u64);
    transition high == 9223372036854775807 && zero == 0 && variable == high
        && top == 1 && first == 16 && last == 16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
