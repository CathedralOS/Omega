use omega_language_std::console;

// The caller's sum is an Exact `i32`: `triple` erases its Wrapping
// intermediate before returning, and `+ 100` is the caller's own Exact
// addition. The field that receives it is Exact too -- a `i32 in Wrapping`
// destination would select a policy implicitly at the store, which the
// language refuses (numeric values, "Policy selection and erasure are
// explicit"; pinned by fail/arithmetic/erased_policy_store_into_qualified_element).
data Main {
    s: i32;
}

machine triple(x: i32 in Wrapping) -> i32 {
    let t: i32 in Wrapping = x * 3;
    // Explicit erasure leaves the caller's own arithmetic in Exact.
    transition { _ -> (t as i32) }
}

machine Main::main(main: &mut Main) reaches Console {
    // The captured immutable actual fixes the complete normal-return value at 12.
    // Follow the transition return, then prove the caller's Exact addition.
    main.s = triple(4) + 100;
    transition { _ -> done(main) }
    state done(main: &mut Main) {
        Console::exit_process(main.s);
    }
}
