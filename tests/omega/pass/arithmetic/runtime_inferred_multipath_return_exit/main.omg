// RUN canary (exit 70). ch15 stage 2 -- MULTI-PATH return-range inference: `pick`
// declares no return range and returns via TWO transition arms (3 / 7). Its
// return interval is inferred as the UNION [3,7], so the caller's `pick(b) + 63`
// proves Exact (=> [66,70]) without an annotation. run(false): pick=7, +63 = 70.
use omega_language_std::console;
data Main { console: Console; }
machine Main::pick(&self, b: bool) -> i32 {
    transition b {
        true -> 3
        false -> 7
    }
}
machine Main::run(&mut self, b: bool) {
    let s: i32 = self.pick(b) + 63;
    self.console.exit_process(s);
}
machine Main::main(&mut self) { self.run(false); }
