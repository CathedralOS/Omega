// F8 (ch5 shift-count ruling, 2026-07-18): an Exact shift by a RANGED
// runtime count is legal when the range proves `count < width` -- the
// proof side of proof-or-policy. `k: u32 [0..=7]` bounds the count at
// [0,7] < 32, so `1 << k` carries no obligation and computes exactly
// (k = 3 -> 8). Twin of fail/arithmetic/shift_count_unproven_rejected.
use omega_language_std::console;
data Main { console: Console; k: u32 [0..=7]; n: u32; }
machine Main::main(&mut self) {
    self.k = 3;
    self.n = 1 << self.k;
    transition self.n == 8 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
