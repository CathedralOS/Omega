// Monte Carlo estimation of pi -- a real numerical-integration technique driving home that
// the xorshift PRNG (locked by operators/runtime_xorshift_prng_exit) is a usable building
// block. Throw 64 random points into the [0,100) x [0,100) square (each coordinate a fresh
// xorshift32 draw mod 100); the fraction landing inside the quarter circle of radius 100
// (px*px + py*py < 100*100) approximates pi/4. Fully deterministic from seed 1: exactly 53
// of 64 land inside, so the estimate 400*inside/64 = 331 (i.e. pi ~= 3.31). Both the count
// and the scaled estimate are checked -> exit 70.
use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    transition { _ -> loop(context, 1, 0, 0) }

    state loop(context: &mut Main, seed: u32 in Wrapping,
               inside: i32 in Wrapping, sample_count: i32 in Wrapping) {
        transition sample_count < 64 {
            true -> draw(context, seed, inside, sample_count)
            _ -> verify(context, inside)
        }
    }
    state draw(context: &mut Main, seed: u32 in Wrapping,
               inside: i32 in Wrapping, sample_count: i32 in Wrapping) {
        // A fresh xorshift32 draw for each coordinate. Only the final seed
        // crosses the back-edge; intermediate draws belong to this state.
        let first_left: u32 in Wrapping = seed ^ (seed << 13);
        let first_right: u32 in Wrapping = first_left ^ (first_left >> 17);
        let first_draw: u32 in Wrapping = first_right ^ (first_right << 5);
        let horizontal: u32 in Wrapping = first_draw % 100;
        let second_left: u32 in Wrapping = first_draw ^ (first_draw << 13);
        let second_right: u32 in Wrapping = second_left ^ (second_left >> 17);
        let next_seed: u32 in Wrapping = second_right ^ (second_right << 5);
        let vertical: u32 in Wrapping = next_seed % 100;
        // inside the quarter circle?
        let distance: u32 in Wrapping = horizontal * horizontal + vertical * vertical;
        transition distance < 10000 {
            true -> hit(context, next_seed, inside, sample_count)
            _ -> miss(context, next_seed, inside, sample_count)
        }
    }
    state hit(context: &mut Main, seed: u32 in Wrapping,
              inside: i32 in Wrapping, sample_count: i32 in Wrapping) {
        transition { _ -> loop(context, seed, inside + 1, sample_count + 1) }
    }
    state miss(context: &mut Main, seed: u32 in Wrapping,
               inside: i32 in Wrapping, sample_count: i32 in Wrapping) {
        transition { _ -> loop(context, seed, inside, sample_count + 1) }
    }
    state verify(context: &mut Main, inside: i32 in Wrapping) {
        let estimate: i32 in Wrapping = 400 * inside / 64;
        transition inside == 53 && estimate == 331 {
            true -> good(context)
            _ -> wrong(context, inside)
        }
    }
    state good(context: &mut Main) {
        Console::exit_process(70);
    }
    state wrong(context: &mut Main, inside: i32 in Wrapping) {
        Console::exit_process(inside as i32); // surface the count on regression
    }
}
