// Bounded unsigned sums must not recursively recheck their full operand
// trees merely to ask whether an absent ordered bound could help.
use omega_language_std::console;
data Main { }
machine fingerprint(value: u64) -> u64 {
    (value % 100 * 2 + value % 100 * 3 + value % 100 * 5 + value % 100 * 7 + value % 100 * 11 + value % 100 * 13 + value % 100 * 17 + value % 100 * 19 + value % 100 * 23 + value % 100 * 29 + value % 100 * 31 + value % 100 * 37 + value % 100 * 41) % 191 + 1
}
machine keep(value: u64) -> u64 {
    value + 0 + 0 + 0 + 0 + 0 + 0 + 0 + 0
}
machine Main::main(main: &mut Main) reaches Console {
    let value: u64 = fingerprint(1);
    let unchanged: u64 = keep(value);
    transition unchanged < 192 {
        true -> finish(main, unchanged)
        false -> bad(main)
    }
    state finish(main: &mut Main, value: u64)
    requires value < 192 {
        Console::exit_process(value as i32);
    }
    state bad(main: &mut Main) { Console::exit_process(200); }
}
