data Room {
    exit_count: u32 [0..=4];
}

data Main {
}

machine Main::main(
    &mut self,
    room: Room
) {
    transition room.exit_count > 0 {
        true -> append(room.exit_count)
        false -> {}
    }

    state append(
        &mut self,
        exit_count: u32 [1..=4]
    ) {
    }
}
