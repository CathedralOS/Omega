// Const-folded named wrapping conversions are correct across truncation and sign
// reinterpretation, INCLUDING a wrapping-produced high-bit value converted to a
// signed type. This is the POSITIVE CONTRAST to the const-fold arithmetic
// miscompile class (memory
// shift-right-signedness-const-fold / decision-17-const-fold-domain-hole,
// pending repros const_fold_unsigned_*): a CAST node carries its target type
// explicitly, so folding it never loses the width/signedness the way bare
// `Expression::Integer(i64)` arithmetic operands do. It also guards against a
// future "fix" to the arithmetic folder accidentally breaking cast folding.
//
//   wrap i32(300) -> u8        = 44    (truncate)
//   wrap i32(200) -> i8        = -56   (reinterpret: 0xC8)
//   wrap (0u32 - 1) -> i8      = -1    (low byte 0xFF -> i8 -1)
// exit 70 = all three fold correctly; 71 = a fold dropped width/sign.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let a: i32 = 300;
    let x: u8 = narrow_i32_to_u8_wrapping(a); // 44

    let b: i32 = 200;
    let y: i8 = narrow_i32_to_i8_wrapping(b); // -56

    let c: u32 in Wrapping = 0;
    let d: u32 in Wrapping = c - 1;  // 0xFFFFFFFF (wrapping)
    let z: i8 = narrow_u32_to_i8_wrapping(d as u32); // -1; named conversion consumes an explicitly erased payload

    transition { _ -> ck(x, y, z) }

    state ck(&mut self, x: u8, y: i8, z: i8) {
        transition x == 44 {
            true  -> ck2(y, z)
            false -> bad()
        }
    }
    state ck2(&mut self, y: i8, z: i8) {
        transition y == 0 - 56 {
            true  -> ck3(z)
            false -> bad()
        }
    }
    state ck3(&mut self, z: i8) {
        transition z == 0 - 1 {
            true  -> good()
            false -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
