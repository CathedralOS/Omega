// Call-result policy is independent of its inferred interval. Exact results
// require an explicit policy conversion; literals still land anonymously.
data Values {
    exact: u32;
    wrapping: u32 in Wrapping;
}

machine produce(value: u32) -> u32 { value }

machine bounded(value: u32) -> u32
requires value <= 9
ensures result <= 9
{ value }

machine increment(value: u32 in Wrapping) -> u32 in Wrapping { value + 1 }

machine main() crashes Trap {
    let mut values: Values;
    values.exact = produce(9);
    values.wrapping = produce(7) as u32 in Wrapping;
    let wrapping: u32 in Wrapping = increment(produce(7) as u32 in Wrapping);
    let saturating: u32 in Saturating = bounded(7) as u32 in Saturating;
    let trapping: u32 in Trapping = produce(7) as u32 in Trapping;
    let literal: u32 in Wrapping = 7;
    transition values.exact == 9 && values.wrapping == literal
        && (wrapping as u32) == 8 && (saturating as u32) == 7
        && (trapping as u32) == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
