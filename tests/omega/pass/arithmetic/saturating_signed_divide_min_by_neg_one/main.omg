// RUN CANARY (exit 70) + interpreter differential. Saturating signed divide/modulo
// of TYPE_MIN by -1: the same idiv #DE overflow corner as the Wrapping case, but
// the Saturating domain CLAMPS instead of wrapping:
//   INT_MIN / -1 = 2147483648 -> clamp to INT_MAX (2147483647)
//   INT_MIN % -1 = 0
// Verifies append_saturating_signed_divide_modulo's -1 guard (sibling of the
// Wrapping fix). exit 72 = divide did not clamp to INT_MAX; 73 = modulo not 0.

use omega::language::std::console;
data Main { console: Console; x: i32 in Saturating; y: i32 in Saturating; }
machine Main::main(&mut self) {
    self.x = 0 - 2147483647;
    self.x = self.x - 1;       // INT_MIN
    self.y = 0 - 1;            // -1
    let q: i32 in Saturating = self.x / self.y;   // clamp to INT_MAX
    let r: i32 in Saturating = self.x % self.y;   // 0
    transition q == 2147483647 {
        true  -> check_mod(r)
        false -> div_wrong()
    }
    state check_mod(&mut self, r: i32 in Saturating) {
        transition r == 0 {
            true  -> good()
            false -> mod_wrong()
        }
    }
    state good(&mut self)      { self.console.exit_process(70); }
    state div_wrong(&mut self) { self.console.exit_process(72); }
    state mod_wrong(&mut self) { self.console.exit_process(73); }
}
