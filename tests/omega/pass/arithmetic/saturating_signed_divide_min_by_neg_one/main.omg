// RUN CANARY (exit 70) + interpreter differential. Saturating signed divide/modulo
// of TYPE_MIN by -1: the same idiv #DE overflow corner as the Wrapping case, but
// the Saturating domain CLAMPS instead of wrapping:
//   INT_MIN / -1 = 2147483648 -> clamp to INT_MAX (2147483647)
//   INT_MIN % -1 = 0
// Verifies append_saturating_signed_divide_modulo's -1 guard (sibling of the
// Wrapping fix). exit 72 = divide did not clamp to INT_MAX; 73 = modulo not 0.

use omega_language_std::console;
data Main { }

machine Main::main(context: &mut Main) reaches Console {
    let mut dividend: i32 in Saturating = 0 - 2147483647;
    dividend = dividend - 1; // INT_MIN = -2147483648
    let divisor: i32 in Saturating = 0 - 1;
    let quotient: i32 in Saturating = dividend / divisor;
    let remainder: i32 in Saturating = dividend % divisor;
    transition quotient == 2147483647 {
        true  -> check_mod(&mut context, remainder)
        false -> div_wrong(&mut context)
    }
    state check_mod(context: &mut Main, remainder: i32 in Saturating) {
        transition remainder == 0 {
            true  -> good(&mut context)
            false -> mod_wrong(&mut context)
        }
    }
    state good(context: &mut Main)      { Console::exit_process(70); }
    state div_wrong(context: &mut Main) { Console::exit_process(72); }
    state mod_wrong(context: &mut Main) { Console::exit_process(73); }
}
