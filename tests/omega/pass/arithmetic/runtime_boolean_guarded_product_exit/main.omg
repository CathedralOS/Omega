machine double(value: i32) -> i32 {
    let outside: bool = value <= -10i32 || value >= 10i32;
    transition outside {
        false -> calculate(value)
        true -> empty()
    }
    machine calculate(value: i32) -> i32 { value * 2i32 }
    machine empty() -> i32 { 0 }
}

machine main() crashes Trap {
    let negative: i32 = double(-9i32);
    let positive: i32 = double(9i32);
    let refused: i32 = double(100i32);
    transition negative == -18i32 && positive == 18i32 && refused == 0i32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
