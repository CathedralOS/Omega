data Main {}

machine Main::main(&mut self, value: u32) -> u32
requires value <= 4
ensures result <= 4
{
    transition value < 4 {
        true -> append(value)
        false -> (value)
    }

    state append(&mut self, delivered: u32) -> u32
    requires delivered < 4
    {
        delivered + 1
    }
}
