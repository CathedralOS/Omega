// Signed indices need explicit lower bounds: `i64` params carry a
// `requires 0 <= index` for the element read and `0 <= start &&
// start <= end && end <= items.len` for the range — on a `&[u8]`
// slice and on a `&[u8; 4]` array alike.
machine read(items: &[u8], index: i64) -> u8
requires 0 <= index && index < items.len
{
    items[index]
}
machine window(items: &[u8], start: i64, end: i64)
requires 0 <= start && start <= end && end <= items.len
{
    let view: &[u8] = items[start..end];
}
machine array_window(items: &[u8; 4], start: i64, end: i64)
requires 0 <= start && start <= end && end <= items.len
{
    let view: &[u8] = items[start..end];
}

data Main {}

machine Main::main(main: &mut Main) { }
