machine signed_positive(value: i64, divisor: i64) -> i64
    requires value >= -7, value <= 7, divisor >= 2
    ensures result >= -7 && result <= 7
{ value % divisor }
machine signed_negative(value: i64, divisor: i64) -> i64
    requires value >= -7, value <= 7, divisor <= -2
    ensures result >= -7 && result <= 7
{ value % divisor }
machine unsigned(value: u64, divisor: u64) -> u64
    requires value <= 7, divisor >= 1
    ensures result <= 7
{ value % divisor }
machine main() crashes Trap {
    let positive: i64 = signed_positive(7i64, 128i64);
    let negative: i64 = signed_positive(-7i64, 128i64);
    let opposite: i64 = signed_negative(-7i64, -128i64);
    let small: i64 = signed_negative(7i64, -2i64);
    let wide: u64 = unsigned(7u64, 18446744073709551615u64);
    let unsigned_small: u64 = unsigned(7u64, 2u64);
    let zero: u64 = unsigned(0u64, 18446744073709551615u64);
    transition positive == 7 && negative == -7 && opposite == -7
        && small == 1 && wide == 7 && unsigned_small == 1 && zero == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
