// The runtime divisor range includes MIN, whose unsigned magnitude is2^63.
// Both remainder extrema are representable; MIN % MIN is zero, and the sign
// of an ordinary remainder follows its dividend rather than its divisor.
machine remainder(value: i64, divisor: i64) -> i64
requires divisor <= -2
{
    value % divisor
}

machine main() crashes Trap {
    let lower: i64 = remainder(-9223372036854775807i64, -9223372036854775808i64);
    let upper: i64 = remainder(9223372036854775807i64, -9223372036854775808i64);
    let minimum: i64 = remainder(-9223372036854775808i64, -9223372036854775808i64);
    let ordinary: i64 = remainder(-7i64, -3i64);
    transition lower == -9223372036854775807i64 && upper == 9223372036854775807i64
        && minimum == 0 && ordinary == -1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
