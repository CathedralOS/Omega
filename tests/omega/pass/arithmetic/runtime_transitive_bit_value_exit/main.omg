machine bit(count: u32, ceiling: u32) -> u64 {
    let valid: bool = count < ceiling && ceiling <= 64u32;
    transition valid {
        true -> calculate(count)
        false -> empty()
    }
    machine calculate(count: u32) -> u64 { 1u64 << count }
    machine empty() -> u64 { 0u64 }
}

machine main() crashes Trap {
    let small: u64 = bit(3u32, 4u32);
    let high: u64 = bit(63u32, 64u32);
    let refused: u64 = bit(64u32, 65u32);
    transition small == 8u64 && high == 9223372036854775808u64 && refused == 0u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
