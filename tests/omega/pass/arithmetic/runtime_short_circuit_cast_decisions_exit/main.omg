use omega_language_std::console;
use omega::language::core::binding;

machine identity(value: u8) -> u8 { value }

machine matches(value: u32) -> bool {
    transition value <= 255u32 && identity(value as u8) == 42u8 {
        true -> (true)
        _ -> (false)
    }
}

machine outside_or_matches(value: u32) -> bool {
    value > 255u32 || (value as u8) == 42u8
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let first: bool = matches(42u32);
    let second: bool = matches(300u32);
    let third: bool = outside_or_matches(300u32);
    let fourth: bool = outside_or_matches(1u32);
    transition first && !second && third && !fourth {
        true -> good(&main.console)
        _ -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
