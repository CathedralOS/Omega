machine wide(value: u64) -> u64
    requires value <= 9223372036854775807
    ensures (value << 1u64) <= 18446744073709551614
{
    value << 1u64
}

machine varied(value: u64, count: i8) -> u64
    requires value >= 1 && value <= 7 && count >= 1 && count <= 3
    ensures (value << count) >= 2
    ensures (value << count) <= 56
    ensures result >= 2 && result <= 56
{
    value << count
}

machine signed(value: i8, count: i16) -> i8
    requires value >= -8 && value <= 7 && count >= 1 && count <= 3
    ensures (value << count) >= -64
    ensures (value << count) <= 56
    ensures result >= -64 && result <= 56
{
    value << count
}

machine main() crashes Trap {
    let zero: u64 = wide(0u64);
    let high: u64 = wide(9223372036854775807u64);
    let low: u64 = varied(1u64, 1i8);
    let top: u64 = varied(7u64, 3i8);
    let negative: i8 = signed(-8i8, 3i16);
    let positive: i8 = signed(7i8, 3i16);
    transition zero == 0u64 && high == 18446744073709551614u64
        && low == 2u64 && top == 56u64 && negative == -64i8 && positive == 56i8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
