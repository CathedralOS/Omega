// RUN CANARY (exit 70) + interpreter differential. Wrapping SIGNED divide/modulo
// of TYPE_MIN by -1. x86 `idiv` raises #DE (integer-overflow trap) for this
// corner, so the Wrapping domain MUST guard it and produce the WRAPPED result:
//   INT_MIN / -1 = 2147483648 -> wraps to INT_MIN (== the dividend)
//   INT_MIN % -1 = 0
// Before the guard the native binary CRASHED with STATUS_INTEGER_OVERFLOW
// (0xC0000095); the interpreter always wrapped correctly. exit 72 = the divide
// did not wrap to INT_MIN; 73 = the modulo was not 0.

use omega_language_std::console;
data Main { }

machine Main::main(context: &mut Main) reaches Console {
    let mut dividend: i32 in Wrapping = 0 - 2147483647;
    dividend = dividend - 1; // INT_MIN = -2147483648
    let divisor: i32 in Wrapping = 0 - 1;
    let quotient: i32 in Wrapping = dividend / divisor;
    let remainder: i32 in Wrapping = dividend % divisor;
    transition quotient == dividend {
        true  -> check_mod(&mut context, remainder)
        false -> div_wrong(&mut context)
    }
    state check_mod(context: &mut Main, remainder: i32 in Wrapping) {
        transition remainder == 0 {
            true  -> good(&mut context)
            false -> mod_wrong(&mut context)
        }
    }
    state good(context: &mut Main)      { Console::exit_process(70); }
    state div_wrong(context: &mut Main) { Console::exit_process(72); }
    state mod_wrong(context: &mut Main) { Console::exit_process(73); }
}
