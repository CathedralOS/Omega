// RUN CANARY (must trap). Constant folding must preserve the Trapping
// domain's value-overflow behavior: u8 200 << 1 is 400, not wrapped 144.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }

machine Main::main(context: &mut Main) reaches Console {
    let left: u8 in Trapping = 200;
    let value: u8 in Trapping = left << 1;
    context.console.exit_process(70);
}
