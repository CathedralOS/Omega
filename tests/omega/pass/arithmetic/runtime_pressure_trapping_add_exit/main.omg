// Keep independently produced trapping additions live until their sum.
// The callee parameter makes the operands runtime values rather than constants.
use omega_language_std::console;
data Main { }

machine doubled_sum(x: u64 in Trapping) -> u64 in Trapping {
    let amount1: u64 in Trapping = x + 1;
    let doubled1: u64 in Trapping = amount1 + amount1;
    let amount2: u64 in Trapping = x + 2;
    let doubled2: u64 in Trapping = amount2 + amount2;
    let amount3: u64 in Trapping = x + 3;
    let doubled3: u64 in Trapping = amount3 + amount3;
    let amount4: u64 in Trapping = x + 4;
    let doubled4: u64 in Trapping = amount4 + amount4;
    let amount5: u64 in Trapping = x + 5;
    let doubled5: u64 in Trapping = amount5 + amount5;
    let amount6: u64 in Trapping = x + 6;
    let doubled6: u64 in Trapping = amount6 + amount6;
    let amount7: u64 in Trapping = x + 7;
    let doubled7: u64 in Trapping = amount7 + amount7;
    let amount8: u64 in Trapping = x + 8;
    let doubled8: u64 in Trapping = amount8 + amount8;
    let amount9: u64 in Trapping = x + 9;
    let doubled9: u64 in Trapping = amount9 + amount9;
    let amount10: u64 in Trapping = x + 10;
    let doubled10: u64 in Trapping = amount10 + amount10;
    let amount11: u64 in Trapping = x + 11;
    let doubled11: u64 in Trapping = amount11 + amount11;
    let amount12: u64 in Trapping = x + 12;
    let doubled12: u64 in Trapping = amount12 + amount12;
    let amount13: u64 in Trapping = x + 13;
    let doubled13: u64 in Trapping = amount13 + amount13;
    let amount14: u64 in Trapping = x + 14;
    let doubled14: u64 in Trapping = amount14 + amount14;
    let amount15: u64 in Trapping = x + 15;
    let doubled15: u64 in Trapping = amount15 + amount15;
    let amount16: u64 in Trapping = x + 16;
    let doubled16: u64 in Trapping = amount16 + amount16;
    let amount17: u64 in Trapping = x + 17;
    let doubled17: u64 in Trapping = amount17 + amount17;
    let amount18: u64 in Trapping = x + 18;
    let doubled18: u64 in Trapping = amount18 + amount18;
    let amount19: u64 in Trapping = x + 19;
    let doubled19: u64 in Trapping = amount19 + amount19;
    let amount20: u64 in Trapping = x + 20;
    let doubled20: u64 in Trapping = amount20 + amount20;
    let amount21: u64 in Trapping = x + 21;
    let doubled21: u64 in Trapping = amount21 + amount21;
    let amount22: u64 in Trapping = x + 22;
    let doubled22: u64 in Trapping = amount22 + amount22;
    let amount23: u64 in Trapping = x + 23;
    let doubled23: u64 in Trapping = amount23 + amount23;
    let amount24: u64 in Trapping = x + 24;
    let doubled24: u64 in Trapping = amount24 + amount24;
    let amount25: u64 in Trapping = x + 25;
    let doubled25: u64 in Trapping = amount25 + amount25;
    let amount26: u64 in Trapping = x + 26;
    let doubled26: u64 in Trapping = amount26 + amount26;
    let amount27: u64 in Trapping = x + 27;
    let doubled27: u64 in Trapping = amount27 + amount27;
    let amount28: u64 in Trapping = x + 28;
    let doubled28: u64 in Trapping = amount28 + amount28;
    let amount29: u64 in Trapping = x + 29;
    let doubled29: u64 in Trapping = amount29 + amount29;
    let amount30: u64 in Trapping = x + 30;
    let doubled30: u64 in Trapping = amount30 + amount30;
    let amount31: u64 in Trapping = x + 31;
    let doubled31: u64 in Trapping = amount31 + amount31;
    let amount32: u64 in Trapping = x + 32;
    let doubled32: u64 in Trapping = amount32 + amount32;
    doubled1 + doubled2 + doubled3 + doubled4 + doubled5 + doubled6 + doubled7 + doubled8 + doubled9 + doubled10 + doubled11 + doubled12 + doubled13 + doubled14 + doubled15 + doubled16 + doubled17 + doubled18 + doubled19 + doubled20 + doubled21 + doubled22 + doubled23 + doubled24 + doubled25 + doubled26 + doubled27 + doubled28 + doubled29 + doubled30 + doubled31 + doubled32
}

machine Main::main(context: &mut Main) reaches Console {
    let total: u64 in Trapping = doubled_sum(1);
    transition total == 1120 {
        true -> good(context)
        false -> bad(context)
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
