// Requires facts for indexed observations survive unrelated writes and jumps.
data Coefficients { values: [i64 in Wrapping; 2]; }
data Output { value: i64 in Wrapping; }
machine quotient(coefficients: &Coefficients, output: &mut Output) -> i64 in Wrapping
requires coefficients.values[0] > 0 && coefficients.values[1] > 0 {
    output.value = 0;
    let numerator: i64 in Wrapping = 20;
    numerator / coefficients.values[0]
}
machine selected(values: &[i64 in Wrapping; 2], index: u64) -> i64 in Wrapping
requires index < 2
requires values[index] != 0 {
    transition { _ -> divided(values, index) }
    machine divided(renamed: &[i64 in Wrapping; 2], selected: u64) -> i64 in Wrapping
    requires selected < 2
    requires renamed[selected] != 0 {
        let numerator: i64 in Wrapping = 20;
        numerator / renamed[selected]
    }
}
// A copied scalar remains nonzero after its source element is overwritten.
machine copied(values: &mut [i64 in Wrapping; 2], index: u64) -> i64 in Wrapping
requires index < 2
requires values[index] != 0 {
    let frozen: i64 in Wrapping = values[index];
    values[index] = 0;
    let numerator: i64 in Wrapping = 20;
    numerator / frozen
}
// Check-only regression: every declared machine body is checked.
// Constructor-to-call-precondition inference is a separate control.
machine main() { }
