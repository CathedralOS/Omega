machine half(value: u64) -> u64
    ensures result <= 9223372036854775807
{
    value / 2u64
}
machine bounded(value: u64, divisor: u64) -> u64
    requires divisor >= 2
    ensures result <= 9223372036854775807
{ value / divisor }
machine wide_divisor(value: u64) -> u64
    ensures result <= 1
{
    value / 18446744073709551615u64
}
machine main() crashes Trap {
    let high: u64 = half(18446744073709551615u64);
    let variable: u64 = bounded(18446744073709551615u64, 2u64);
    let wide: u64 = bounded(18446744073709551615u64, 18446744073709551615u64);
    let one: u64 = wide_divisor(18446744073709551615u64);
    let small: u64 = wide_divisor(1u64);
    let zero: u64 = half(0u64);
    transition high == 9223372036854775807 && variable == high
        && wide == 1 && one == 1 && small == 0 && zero == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
