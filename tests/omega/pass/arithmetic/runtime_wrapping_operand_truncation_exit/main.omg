// RUN CANARY (exit 70) + interpreter differential. A nested WRAPPING binary
// in OPERAND position must hand its parent the WIDTH-WRAPPED value: the
// plain 64-bit register op leaves (0u32 - 2) as 0xFFFF_FFFF_FFFF_FFFE, and a
// sign/width-sensitive parent then reads it wrong -- `>> 1` gave 63-bit
// garbage (native 4294967295 vs the u32-correct 2147483647), `/ 3` and `% 3`
// likewise, while the interpreter wraps AT THE NODE (decision 17). The
// store-truncation-is-the-wrap shortcut only holds at the WRITE. Both ISAs
// now truncate nested Wrapping results to the node's width (zero/sign-extend
// per the node's signedness) before the parent consumes them; x86_64
// byte-verified (mov r10d,r10d after each wrapped subtraction in a
// cross-compiled linux_x86_64 ELF). This supersedes the old "type-blind
// const-folder" TASKS entry: the cast-retag spelling (`0 as u32 in
// Wrapping`) blocks the folder's literal window entirely, so the same
// source now exercises the RUNTIME operand path -- which had this hole.
// exit 71 = >> wrong; 72 = / wrong; 73 = % wrong; 74 = wrapped-as-RIGHT wrong.
use omega_language_std::console;
data Main { }
machine Main::main(context: &mut Main) reaches Console {
    let wrapped: u32 in Wrapping = (0 as u32 in Wrapping) - 2;
    let shifted: u32 = (wrapped >> 1) as u32;
    let divided: u32 = (wrapped / 3) as u32;
    let remainder: u32 = (wrapped % 3) as u32;
    transition shifted == 2147483647 {
        true -> check_division(context, divided, remainder)
        _ -> wrong_shift(context)
    }
    machine check_division(context: &mut Main, divided: u32, remainder: u32) {
        transition divided == 1431655764 {
            true -> check_remainder(context, remainder)
            _ -> wrong_division(context)
        }
    }
    machine check_remainder(context: &mut Main, remainder: u32) {
        transition remainder == 2 {
            true -> right_operand(context)
            _ -> wrong_remainder(context)
        }
    }
    // The wrapped node as the RIGHT operand: register staging differs (the
    // right operand evaluates into its own home with the right scratch pool),
    // so the truncation must apply per-node regardless of side.
    machine right_operand(context: &mut Main) {
        let wrapped: u32 in Wrapping = (0 as u32 in Wrapping) - 2;
        let result: u32 in Wrapping = 5 + (wrapped / 1000000000);
        transition result == 9 {
            true -> good(context)
            _ -> wrong_right(context)
        }
    }
    machine good(context: &mut Main) { Console::exit_process(70); }
    machine wrong_shift(context: &mut Main) { Console::exit_process(71); }
    machine wrong_division(context: &mut Main) { Console::exit_process(72); }
    machine wrong_remainder(context: &mut Main) { Console::exit_process(73); }
    machine wrong_right(context: &mut Main) { Console::exit_process(74); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
