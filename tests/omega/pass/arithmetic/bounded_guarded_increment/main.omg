domain u32::U320To4 requires self <= 4;
data Main {
}

machine Main::main(
    &mut self,
    exit_count: u32 in U320To4
) -> u32 in U320To4 {
    transition exit_count < 4 {
        true -> append(exit_count)
        false -> (exit_count)
    }

    state append(
        &mut self,
        exit_count: u32 in U320To4
    ) -> u32 in U320To4
    requires exit_count < 4
    {
        exit_count + 1
    }
}
