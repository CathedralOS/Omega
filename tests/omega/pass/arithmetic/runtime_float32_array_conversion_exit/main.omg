use omega::language::core::float_operations;

// Float coverage the existing f64-scalar canaries miss: an f32 ARRAY (the separate f32 codegen
// path -- mulss/addss/ucomiss/cvtss) plus an int<->f64 round-trip cast. f32 sum 1.5+2.5+2.25 =
// 6.25 (exactly representable), then 7 as f64 * 2.0 truncated back to i32 = 14. Exits 70.
use omega_language_std::console;

data Main {
    console: Console;
    fs: [f32; 3];
    s32: f32;
    i: i32 in Wrapping;
    f64v: f64;
    r: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.fs[0] = 1.5;
    self.fs[1] = 2.5;
    self.fs[2] = 2.25;
    self.s32 = self.fs[0] + self.fs[1];
    self.s32 = self.s32 + self.fs[2];
    transition self.s32 == 6.25 { true -> conv() _ -> bad() }

    state conv(&mut self) {
        self.i = 7;
        self.f64v = self.i as f64;
        self.f64v = self.f64v * 2.0;
        self.r = (self.f64v as i32 in Saturating) as i32 in Wrapping;
        transition self.r == 14 { true -> ok() _ -> bad() }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
