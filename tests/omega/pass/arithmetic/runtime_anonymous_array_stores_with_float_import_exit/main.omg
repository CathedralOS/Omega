// Imported float operators cannot select a carrier for wholly anonymous
// arithmetic. The bitmap-height store matches window_demo; the rational
// intermediate must finish as seven before its i32 destination is checked;
// the whole-expression cast acknowledges that intermediate.
use omega_language_std::Console;

data Main {
    cells: [i32; 3];
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells[0] = 0 - 64;
    main.cells[1] = ((7 / 2) * 2) as i32;
    main.cells[2] = 1 + 2 * 3;
    transition main.cells[0] == -64 && main.cells[1] == 7 && main.cells[2] == 7 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
