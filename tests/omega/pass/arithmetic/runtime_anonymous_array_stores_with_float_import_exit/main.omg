// Imported float operators cannot select a carrier for wholly anonymous
// arithmetic. The bitmap-height store matches window_demo; the rational
// intermediate must finish as seven before its i32 destination is checked.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    cells: [i32; 3];
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells[0] = 0 - 64;
    main.cells[1] = (7 / 2) * 2;
    main.cells[2] = 1 + 2 * 3;
    transition main.cells[0] == -64 && main.cells[1] == 7 && main.cells[2] == 7 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
