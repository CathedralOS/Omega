// Mutable invocation-local storage retains the declared overflow behavior.
// Wrapping instead of trapping would reach exit 70 and fail the trap oracle.
use omega_language_std::console;

data Main { }

machine Main::main(context: &mut Main) reaches Console {
    let mut value: i32 in Trapping = 2147483647;
    value = value + 1;
    Console::exit_process(70);
}
