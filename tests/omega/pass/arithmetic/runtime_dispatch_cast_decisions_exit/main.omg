use omega_language_std::console;

machine narrow(value: u32) -> u8 {
    match value <= 255u32 {
        true -> value as u8,
        _ -> 0u8
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let first: u8 = narrow(42u32);
    let second: u8 = narrow(300u32);
    transition first == 42u8 && second == 0u8 {
        true -> good()
        _ -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}
