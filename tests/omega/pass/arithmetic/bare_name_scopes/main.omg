// Locks the BARE-NAME allow-list against the two non-obvious forms that a naive
// "unknown bare name" existence check wrongly rejected before it was scoped to the
// WHOLE machine (see fail canary undeclared_bare_name_rejected + its check in
// psi-validation/calls.rs `is_known_bare_name`):
//
//   1. CROSS-STATE param read: `state report` reads `n`, which is a PARAMETER of a
//      SIBLING state (`classify`), not of `report` itself. State bindings share the
//      machine-wide environment, so the existence check scans EVERY state's
//      parameters/locals -- a per-current-state lookup would falsely reject this.
//   2. BARE ENUM CASE: `let signal: Light = On;` -- `On` is a single-segment `Name`
//      that resolves to an enum case constant, not a local/param/field.
//
// classify(70): n=70 > 0 -> report -> exit_process(n) = 70. Differential (interp==native).

use omega_language_std::console;

data Light { case Off; case On; }

data Main { console: Console; }

machine Main::main(&mut self) {
    let signal: Light = On; // bare enum-case constant -- must be accepted
    transition { _ -> classify(70) }
    state classify(&mut self, n: i32 [0..=100]) {
        transition n > 0 {
            true -> report()
            _ -> zero()
        }
    }
    state report(&mut self) { self.console.exit_process(n); } // reads sibling `classify`'s param
    state zero(&mut self) { self.console.exit_process(2); }
}
