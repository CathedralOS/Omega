// Expected exit: 0.
data Buffer { values: [u8; 8]; }
data Count [copy] { value: u64; }

machine length<T>(values: &mut [T]) -> u64
ensures result <= values.len && result >= values.len { values.len }

machine forwarded(values: &mut [u8]) -> u64
ensures result <= values.len { length(values) }

machine main() crashes Trap {
    let mut buffer: Buffer;
    let count: Count = Count { value: forwarded(&mut buffer.values[1..7]) };
    let copy: Count = count;
    let direct: u64 = 1 + length(&mut buffer.values[1..7]);
    let empty: u64 = 1 + length(&mut buffer.values[4..4]);
    let window: &mut [u8] = &mut buffer.values[2..5];
    let local: u64 = 1 + forwarded(window);
    transition { _ -> verify(copy.value + 1, direct, empty, local) }
    machine verify(copied: u64, direct: u64, empty: u64, local: u64) {
        transition copied == 7 && direct == 7 && empty == 1 && local == 4 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
