machine bit(count: u32) -> u64 {
    let valid: bool = count < 64u32;
    transition valid {
        true -> calculate(count)
        false -> empty()
    }
    machine calculate(count: u32) -> u64 { 1u64 << count }
    machine empty() -> u64 { 0 }
}

machine main() crashes Trap {
    let small: u64 = bit(3u32);
    let high: u64 = bit(63u32);
    let refused: u64 = bit(64u32);
    transition small == 8 && high == 9223372036854775808u64 && refused == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
