data Guard { count: u32; valid: bool; }

machine shift(count: u32) -> u64 {
    let mut guard: Guard;
    guard.count = count;
    guard.valid = guard.count < 64u32;
    transition {
        guard.valid -> (8u64 >> guard.count)
        _ -> 0u64
    }
}

machine main() crashes Trap {
    let selected: u64 = shift(1u32);
    let refused: u64 = shift(64u32);
    transition selected == 4 && refused == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
