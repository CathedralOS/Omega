data Counter { amounts: [u8; 2]; }

machine increment(value: u8) -> Counter
requires value < 254u8 {
    Counter { amounts: [value + 1u8, value + 2u8] }
}

machine main() crashes Trap {
    let counter: Counter = increment(40u8);
    transition counter.amounts[0] == 41u8 && counter.amounts[1] == 42u8 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
