// A positive signed read count fits the remaining unsigned capacity.
use omega_language_std::console;

data Reader { received: u64 [0..=16384]; count: i64; }
machine Reader::advance(reader: &mut Reader) {
    transition reader.count > 0 { true -> room(reader) _ -> done() }
    state room(reader: &mut Reader) {
        transition reader.count as u64 <= 16384 - reader.received {
            true -> store(reader)
            _ -> done()
        }
    }
    state store(reader: &mut Reader) {
        reader.received = reader.received + reader.count as u64;
        transition { _ -> done() }
    }
    state done() { }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut reader: Reader;
    reader.received = 12288;
    reader.count = 54;
    Reader::advance(&mut reader);
    transition reader.received == 12342 { true -> good() _ -> bad() }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}
