// A positive signed read count fits the remaining unsigned capacity.
use omega_language_std::console;

data Reader { received: u64; count: i64; }
machine Reader::advance(reader: &mut Reader) {
    transition reader.count > 0 && reader.received <= 16384 { true -> room(reader) _ -> done() }
    machine room(reader: &mut Reader) {
        transition reader.count as u64 <= 16384 - reader.received {
            true -> store(reader)
            _ -> done()
        }
    }
    machine store(reader: &mut Reader) {
        reader.received = reader.received + reader.count as u64;
        transition { _ -> done() }
    }
    machine done() { }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut reader: Reader;
    reader.received = 12288;
    reader.count = 54;
    Reader::advance(&mut reader);
    transition reader.received == 12342 { true -> good() _ -> bad() }
    machine good() { Console::exit_process(70); }
    machine bad() { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
