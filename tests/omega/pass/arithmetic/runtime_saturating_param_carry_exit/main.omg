// Saturating i8 arithmetic carried through RECURSION PARAMS and a dispatch
// binary terminal (decision 17): each hop's `acc + 50` must clamp AT THE
// OPERATION (50, 100, 127-saturated), and the terminal `acc + 50` must stay
// 127 even though its landing slot (`let n: i8`, the machine's plain `-> i8`
// return) is Exact -- the domain rides the OPERAND's declared type, not the
// landing slot's. Both legs pinned by the differential oracle at exit 70.
// (History: promoted from pending/host/interp_saturating_param_carry -- the
// interpreter used to compute transition-argument arithmetic wide and let the
// Exact landing seam truncate 177 -> -79, exiting 71 while native correctly
// saturated; fixed by resolving the expression's declared scalar type at
// binary nodes.)
use omega_language_std::console;
data Main { console: Console; }
machine Main::count(&mut self, i: u64, j: u64, acc: i8 in Saturating)
terminates by (j, i) -> Nat::BoundedDistance;
-> i8
{
    transition j < i {
        true -> count(i, j + 1, acc + 50)
        false -> leaf(acc)
    }
    // Saturating BINARY terminal: acc(127 saturated) + 50 must stay 127.
    state leaf(&mut self, acc: i8 in Saturating) -> i8 { acc + 50 }
}
machine Main::main(&mut self) {
    // 3 iterations: 0+50=50, +50=100, +50=127(sat). Terminal: 127+50 = 127(sat).
    let n: i8 = self.count(3, 0, 0);
    transition n == 127 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
