// Trapping arithmetic FUSED into a guard operand must TRAP: 200 + 100 in
// `u8 in Trapping` overflows at the guard's add, so the process dies (brk /
// ud2) and never reaches either exit. Natively this exercises the
// OPERAND-POSITION trap lowering; the interpreter leg is pinned by
// interpreter_traps_on_trapping_guard_overflow (a trap has no comparable
// exit code for the differential harness). If a regression fused the plain
// add again, the wide 300 would truncate to 44 at the byte-width compare and
// exit 70 -- the suite test treats ANY clean exit as the failure.
// (History: parked 2026-07-09c as the deliberately-unfenced missed-trap gap;
// promoted when the operand-position lowering landed in both ISAs.)
use omega::language::std::console;
data Main { console: Console; au: u8 in Trapping; bu: u8 in Trapping; }
machine Main::main(&mut self) {
    self.au = 200;
    self.bu = 100;
    // TRAPS at the guard's fused add; neither state is reached.
    transition (self.au + self.bu == 44) { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
