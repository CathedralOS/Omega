// Exact quotient correlations survive locals, fields, returns and full-width values.
data Window { lower: u64; upper: u64; }

machine midpoint(lower: u64, upper: u64) -> u64
requires lower < upper
ensures result >= lower && result < upper
{
    lower + (upper - lower) / 2
}

machine split_midpoint(lower: u64, upper: u64, divisor: u64) -> u64
requires lower < upper && divisor >= 2
ensures result >= lower && result < upper
{
    let distance: u64 = upper - lower;
    let step: u64 = distance / divisor;
    lower + step
}

machine field_midpoint(window: &Window) -> u64
requires window.lower < window.upper
ensures result >= window.lower && result < window.upper
{
    window.lower + (window.upper - window.lower) / 2
}

machine negative_divisor(value: i64, divisor: i64) -> i64
requires value >= -20 && value <= 20 && divisor <= -2
ensures result >= -10 && result <= 10
{
    value / divisor
}

// These bounds previously depended on private addition-guard recognizers.
machine upper_guarded_sum(left: i64, right: i64) -> i64
requires right >= 0 && left <= 9223372036854775807 - right
{
    left + right
}

machine lower_guarded_sum(left: i64, right: i64) -> i64
requires right <= 0 && -9223372036854775808 - right <= left
{
    left + right
}

machine main() crashes Trap {
    let direct: u64 = midpoint(18446744073709551611, 18446744073709551615);
    let split: u64 = split_midpoint(10, 19, 3);
    let window: Window = Window { lower: 20, upper: 25 };
    let field: u64 = field_midpoint(&window);
    let called: u64 = midpoint(midpoint(0, 8), 10);
    let positive: i64 = negative_divisor(-19, -3);
    let negative: i64 = negative_divisor(19, -3);
    let upper_sum: i64 = upper_guarded_sum(9223372036854775803, 4);
    let lower_sum: i64 = lower_guarded_sum(-9223372036854775804, -4);
    transition direct == 18446744073709551613 && split == 13 && field == 22 && called == 7
        && positive == 6 && negative == -6
        && upper_sum == 9223372036854775807 && lower_sum == -9223372036854775808 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
