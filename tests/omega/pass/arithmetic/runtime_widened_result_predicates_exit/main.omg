use omega::language::core::numeric_conversion;
use omega_language_std::console;

// All historical widening-result bounds establish ordinary record predicates.
// Keep the input runtime-dependent and transport the complete record through
// a helper return and a named state before inspecting its exact endpoints.
data Widened where byte_unsigned_16 <= 255, byte_unsigned_32 <= 255,
    byte_unsigned_64 <= 255, half_unsigned_32 <= 65535,
    half_unsigned_64 <= 65535, word_unsigned_64 <= 4294967295,
    byte_signed_16 >= 0, byte_signed_16 <= 255,
    byte_signed_32 >= 0, byte_signed_32 <= 255,
    byte_signed_64 >= 0, byte_signed_64 <= 255,
    half_signed_32 >= 0, half_signed_32 <= 65535,
    half_signed_64 >= 0, half_signed_64 <= 65535,
    word_signed_64 >= 0, word_signed_64 <= 4294967295 {
    byte_unsigned_16: u16;
    byte_unsigned_32: u32;
    byte_unsigned_64: u64;
    half_unsigned_32: u32;
    half_unsigned_64: u64;
    word_unsigned_64: u64;
    byte_signed_16: i16;
    byte_signed_32: i32;
    byte_signed_64: i64;
    half_signed_32: i32;
    half_signed_64: i64;
    word_signed_64: i64;
}

machine widen(byte: u8, half: u16, word: u32) -> Widened {
    let widened: Widened = Widened {
        byte_unsigned_16: widen_u8_to_u16(byte),
        byte_unsigned_32: widen_u8_to_u32(byte),
        byte_unsigned_64: widen_u8_to_u64(byte),
        half_unsigned_32: widen_u16_to_u32(half),
        half_unsigned_64: widen_u16_to_u64(half),
        word_unsigned_64: widen_u32_to_u64(word),
        byte_signed_16: widen_u8_to_i16(byte),
        byte_signed_32: widen_u8_to_i32(byte),
        byte_signed_64: widen_u8_to_i64(byte),
        half_signed_32: widen_u16_to_i32(half),
        half_signed_64: widen_u16_to_i64(half),
        word_signed_64: widen_u32_to_i64(word),
    };
    transition { _ -> publish(widened) }
    state publish(widened: Widened) -> Widened { widened }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed {
        ByteRead::Byte { value } -> convert(main, (value as u8) | 129)
        ByteRead::Eof -> bad(main)
    }
    state convert(main: &mut Main, byte: u8) {
        let half: u16 = (byte as u16) * 257;
        let word: u32 = (half as u32) * 65537;
        let widened: Widened = widen(byte, half, word);
        transition { _ -> inspect(main, widened) }
    }
    state inspect(main: &mut Main, widened: Widened) {
        transition widened.byte_unsigned_16 == 255 && widened.byte_unsigned_32 == 255
            && widened.byte_unsigned_64 == 255 && widened.half_unsigned_32 == 65535
            && widened.half_unsigned_64 == 65535 && widened.word_unsigned_64 == 4294967295
            && widened.byte_signed_16 == 255 && widened.byte_signed_32 == 255
            && widened.byte_signed_64 == 255 && widened.half_signed_32 == 65535
            && widened.half_signed_64 == 65535 && widened.word_signed_64 == 4294967295 {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
