// RUN CANARY (exit 70) + interpreter differential. SHIFT-COUNT domain
// exemption (owner ruling 2026-07-13: "shift overflow is defined by the
// domain on which the operator is happening... lhs domain governs, rhs
// doesn't matter"): a Wrapping lhs shifted by an EXACT count resolves with
// the LHS's domain -- previously the mixed-domain check rejected
// `wrapped << count` outright. Legs: << and >> with a runtime Exact count.
// Wrapping counts are masked by the language operand width on every target.
// exits: 71 = << wrong; 72 = >> wrong; 73/74 = masked 32/64 leg wrong.
use omega_language_std::console;
data Main { }
machine Main::main(context: &mut Main) {
    Main::build(context, 3);
}
machine Main::build(main: &mut Main, count: u32) reaches Console {
    let a: u32 in Wrapping = (1 as u32 in Wrapping);
    let r: u32 in Wrapping = a << count;
    transition r == 8 {
        true -> leg2(main, count)
        _ -> wrong_shl(main)
    }
    machine leg2(main: &mut Main, count: u32) {
        let b: u32 in Wrapping = (64 as u32 in Wrapping);
        let s: u32 in Wrapping = b >> count;
        transition s == 8 {
            true -> atwidth32(main)
            _ -> wrong_shr(main)
        }
    }
    // MASKED-COUNT at-width legs (F8b, ch5 shift-count ruling 2026-07-18):
    // a Wrapping shift masks its count to `k & (width - 1)` -- the genuinely
    // modular reading, and what the hardware computes anyway. 1 << 40 at u32
    // is 1 << 8 = 256; 1 << 70 at u64 is 1 << 6 = 64. (Supersedes the
    // retired modular-VALUE semantics where at-width counts collapsed to 0.)
    machine atwidth32(main: &mut Main) {
        let a: u32 in Wrapping = (1 as u32 in Wrapping);
        let c: u32 in Wrapping = (40 as u32 in Wrapping);
        let r: u32 in Wrapping = a << c;
        transition r == 256 {
            true -> atwidth64(main)
            _ -> wrong_atwidth32(main)
        }
    }
    machine atwidth64(main: &mut Main) {
        let a: u64 in Wrapping = (1 as u64 in Wrapping);
        let c: u64 in Wrapping = (70 as u64 in Wrapping);
        let r: u64 in Wrapping = a << c;
        transition r == 64 {
            true -> good(main)
            _ -> wrong_atwidth64(main)
        }
    }
    machine good(main: &mut Main)           { Console::exit_process(70); }
    machine wrong_shl(main: &mut Main)      { Console::exit_process(71); }
    machine wrong_shr(main: &mut Main)      { Console::exit_process(72); }
    machine wrong_atwidth32(main: &mut Main){ Console::exit_process(73); }
    machine wrong_atwidth64(main: &mut Main){ Console::exit_process(74); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
