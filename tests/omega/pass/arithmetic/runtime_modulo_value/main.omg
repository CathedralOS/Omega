// Modulo as a runtime value: `17 % 5 == 2` in `u64`, written into a carrier
// field. The deployable shape matches the sibling runtime canaries: the
// computed value is checked in a guard ladder and the process exits 70 only
// when exact.

use omega_language_std::console;
use omega::language::core::binding;

data Health {
    value: u64;
}

data Main {
    console: Binding<Console>;
    health: Health;
}

machine Main::main(&mut self) reaches Console {
    self.health.value = 17u64 % 5;

    transition self.health.value == 2 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
