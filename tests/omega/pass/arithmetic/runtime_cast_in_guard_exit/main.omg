// Named integer conversions used DIRECTLY in guard subjects. Values are built
// at runtime so the checked core conversion bodies and call-result guard path
// both run rather than const-folding. This replaces the compatibility-cast
// spelling while retaining narrowing, signed widening, and unsigned widening
// coverage. The differential oracle also checks native==interpreter.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    big: i32 in Wrapping;
    i: i32 in Wrapping;
    neg: i32 in Wrapping;
    small: u8 in Wrapping;
}

machine Main::main(&mut self) {
    self.big = 0;
    self.i = 0;
    transition { _ -> build() }

    state build(&mut self) {
        transition self.i < 6 { true -> step() _ -> narrow_guard() }
    }
    state step(&mut self) {
        self.big = self.big + 50;
        self.i = self.i + 1;
        transition { _ -> build() }
    }

    // big = 300 at runtime from here on.
    state narrow_guard(&mut self) {
        // Explicit wrapping narrowing: 300 -> u8 44 (low byte of 0x12C).
        transition narrow_i32_to_u8_wrapping(self.big as i32) == 44 {
            true -> widen_signed_guard()
            _ -> bad()
        }
    }
    state widen_signed_guard(&mut self) {
        self.neg = 0 - 4;
        // Signed widening sign-extends -4 rather than zero-extending it.
        transition widen_i32_to_i64(self.neg as i32) == 0 - 4 {
            true -> widen_unsigned_guard()
            _ -> bad()
        }
    }
    state widen_unsigned_guard(&mut self) {
        self.small = 200;
        // Unsigned widening zero-extends 200 rather than sign-extending it.
        // The direct cast round trips separately pin computed exact-cast
        // premises: widen the runtime byte through a finite carrier chain, then
        // narrow it back without a range assumption or policy conversion.
        transition widen_u8_to_i32(self.small as u8) == 200
            && ((self.small as u16) as u8) == 200
            && ((((self.small as u16) as u32) as u64) as u8) == 200 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
