use omega::language::core::float_operations;

// RUN CANARY (exit 70) + interpreter differential. A plain f32 FIELD
// guard (`self.f > 3.14 && self.f < 3.15`) -- BROKEN program-wide until
// 2026-07-09 (native 71 / interp 70): the guard compared the stored
// 4-byte f32 pattern against F64 literal bits (constant float operands
// always resolved to f64 patterns). Fixed by the f32 compare re-encoding
// post-pass (state-guards operands/mod.rs): a constant float expectation
// against a 4-byte float place re-encodes to the f32 pattern and sizes
// the literal side to 4. Found probing the recast read-side fix.
use omega_language_std::console;
data Main { console: Console; f: f32; out: i32; }
machine Main::main(&mut self) {
    self.f = 3.141592;
    transition self.f > 3.14 && self.f < 3.15 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
