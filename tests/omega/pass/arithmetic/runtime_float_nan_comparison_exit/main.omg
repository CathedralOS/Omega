use omega::language::core::float_operations;

// NaN comparison: IEEE says every comparison with NaN is false EXCEPT `!=` (true).
// Native `ucomis*` reports NaN via the parity flag; the guard's failure jcc must honor
// it (a `jp` parity branch), else 4 of the 6 operators take the wrong arm. Each check
// below advances only on the IEEE-correct outcome; any wrong arm falls to `bad` (71).
use omega_language_std::console;
use omega::language::core::binding;
data Operands { z: f64; nan: f64; g: f64; }
data Main { console: Binding<Console>; }
machine Main::main(context: &mut Main) reaches Console {
    let mut operands: Operands;
    operands.z = 0.0;
    operands.nan = operands.z / operands.z;
    operands.g = 5.0;
    transition operands.nan != operands.g { true -> check_eq(context, &operands) _ -> bad(context) }
    state check_eq(context: &mut Main, operands: &Operands) { transition operands.nan == operands.g { true -> bad(context) _ -> check_lt(context, operands) } }
    state check_lt(context: &mut Main, operands: &Operands) { transition operands.nan <  operands.g { true -> bad(context) _ -> check_le(context, operands) } }
    state check_le(context: &mut Main, operands: &Operands) { transition operands.nan <= operands.g { true -> bad(context) _ -> check_gt(context, operands) } }
    state check_gt(context: &mut Main, operands: &Operands) { transition operands.nan >  operands.g { true -> bad(context) _ -> check_ge(context, operands) } }
    state check_ge(context: &mut Main, operands: &Operands) { transition operands.nan >= operands.g { true -> bad(context) _ -> ok(context) } }
    state ok(context: &mut Main)  { context.console.exit_process(70); }
    state bad(context: &mut Main) { context.console.exit_process(71); }
}
