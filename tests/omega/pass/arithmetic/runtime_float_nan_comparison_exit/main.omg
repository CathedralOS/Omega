use omega::language::core::float_operations;

// NaN comparison: IEEE says every comparison with NaN is false EXCEPT `!=` (true).
// Native `ucomis*` reports NaN via the parity flag; the guard's failure jcc must honor
// it (a `jp` parity branch), else 4 of the 6 operators take the wrong arm. Each check
// below advances only on the IEEE-correct outcome; any wrong arm falls to `bad` (71).
use omega_language_std::console;
data Main { z: f64; nan: f64; g: f64; }
machine Main::main(main: &mut Main) reaches Console {
    main.z = 0.0;
    main.nan = main.z / main.z;
    main.g = 5.0;
    transition main.nan != main.g { true -> check_eq(main) _ -> bad(main) }
    machine check_eq(main: &mut Main) { transition main.nan == main.g { true -> bad(main) _ -> check_lt(main) } }
    machine check_lt(main: &mut Main) { transition main.nan <  main.g { true -> bad(main) _ -> check_le(main) } }
    machine check_le(main: &mut Main) { transition main.nan <= main.g { true -> bad(main) _ -> check_gt(main) } }
    machine check_gt(main: &mut Main) { transition main.nan >  main.g { true -> bad(main) _ -> check_ge(main) } }
    machine check_ge(main: &mut Main) { transition main.nan >= main.g { true -> bad(main) _ -> ok(main) } }
    machine ok(main: &mut Main)  { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
