use omega_language_std::console;

data Values { length: u64; }
data Main { }

machine Values::count(values: &Values) -> u64 { values.length }

machine visit(selected: &Values, position: u64) -> u64 {
    transition position < Values::count(selected) {
        true -> advance(position)
        false -> 0
    }
    state advance(position: u64) -> u64 { position + 1 }
}

machine Main::main(context: &mut Main) reaches Console {
    let selected: Values = Values { length: 18446744073709551615 };
    let last: u64 = visit(&selected, 18446744073709551614);
    let exhausted: u64 = visit(&selected, 18446744073709551615);
    transition last == 18446744073709551615 && exhausted == 0 {
        true -> success(context)
        false -> failure(context)
    }
    state success(context: &mut Main) { Console::exit_process(42); }
    state failure(context: &mut Main) { Console::exit_process(1); }
}
