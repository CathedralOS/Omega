// Expected exit: 0.
// A const binder may take its ceiling from another binder. Limit <= 4 and
// Bound <= Limit make index < Bound exact for index * 4, through a
// parameter, a local, a field, and a call result. A third binder in the
// chain uses the same transfer.
data Cell { index: u64; }

machine parameter_scale<const Bound: u64, const Limit: u64>(index: u64) -> u64
requires Limit >= 1 && Limit <= 4, Bound <= Limit, index < Bound
{ index * 4 }

machine local_scale<const Bound: u64, const Limit: u64>(index: u64) -> u64
requires Limit >= 1 && Limit <= 4, Bound <= Limit, index < Bound
{
    let limited: u64 = index;
    limited * 4
}

machine field_scale<const Bound: u64, const Limit: u64>(cell: &Cell) -> u64
requires Limit >= 1 && Limit <= 4, Bound <= Limit, cell.index < Bound
{ cell.index * 4 }

machine unit<const Bound: u64, const Limit: u64>() -> u64
requires Limit >= 1 && Limit <= 4, Bound >= 1, Bound <= Limit
ensures result < Bound
{ 0 }

machine call_scale<const Bound: u64, const Limit: u64>() -> u64
requires Limit >= 1 && Limit <= 4, Bound >= 1, Bound <= Limit
{ unit<Bound, Limit>() * 4 }

machine swapped<const Bound: u64, const Limit: u64>(index: u64) -> u64
requires Limit >= 1 && Limit <= 4, Limit >= Bound, index < Bound
{ index * 4 }

machine later<const Bound: u64, const Limit: u64>(index: u64) -> u64
requires Limit >= 1 && Limit <= 4, Bound <= Limit, index < Bound
{
    transition { _ -> scale(index) }
    state scale(index: u64) -> u64 requires index < Bound { index * 4 }
}

machine deep<const Inner: u64, const Middle: u64, const Outer: u64>(index: u64) -> u64
requires Outer <= 4, Middle <= Outer, Inner <= Middle, index < Inner
{ index * 4 }

machine main() crashes Trap {
    let cell: Cell = Cell { index: 1 };
    transition parameter_scale<3, 4>(1) == 4
        && local_scale<3, 4>(1) == 4
        && field_scale<3, 4>(&cell) == 4
        && call_scale<3, 4>() == 0
        && swapped<3, 4>(1) == 4
        && later<3, 4>(1) == 4
        && deep<2, 3, 4>(1) == 4
    { true -> done() _ -> bad() }
    state done() { }
    state bad() { crash Trap; }
}
