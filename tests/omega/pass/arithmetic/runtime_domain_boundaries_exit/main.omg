// Arithmetic-domain behaviour at the TYPE BOUNDARIES, computed at runtime (the
// operands are field reads, not const-folded into the comparison), and checked
// against the boundary constants. Locks the Decision-17 domains' overflow
// semantics as a regression guard (native + interpreter must agree):
//   * i32 Saturating  MAX + 1 -> MAX   (clamp, no wrap)
//   * i32 Wrapping    MAX + 1 -> MIN   (two's-complement wrap)
//   * u8  Saturating  255 + 1 -> 255   (clamp at the unsigned ceiling)
//   * u8  Wrapping    0   - 1 -> 255   (unsigned underflow wraps)
// All four correct -> exit 70.

use omega_language_std::console;
use omega::language::core::binding;

data Operands {
    i32sat: i32 in Saturating;
    i32wrap: i32 in Wrapping;
    u8sat: u8 in Saturating;
    u8wrap: u8 in Wrapping;
}
data Main { console: Binding<Console>; }

machine Main::main(context: &mut Main) reaches Console {
    let mut operands: Operands;
    operands.i32sat = 2147483647;
    operands.i32sat = operands.i32sat + 1;          // saturates to i32::MAX

    operands.i32wrap = 2147483647;
    operands.i32wrap = operands.i32wrap + 1;        // wraps to i32::MIN

    operands.u8sat = 255;
    operands.u8sat = operands.u8sat + 1;            // saturates to 255

    operands.u8wrap = 0;
    operands.u8wrap = operands.u8wrap - 1;          // wraps to 255

    transition operands.i32sat == 2147483647 {
        true -> check_wrap(context, &operands)
        _ -> bad(context)
    }

    state check_wrap(context: &mut Main, operands: &Operands) {
        transition operands.i32wrap == 0 - 2147483648 {
            true -> check_u8sat(context, operands)
            _ -> bad(context)
        }
    }

    state check_u8sat(context: &mut Main, operands: &Operands) {
        transition operands.u8sat == 255 {
            true -> check_u8wrap(context, operands)
            _ -> bad(context)
        }
    }

    state check_u8wrap(context: &mut Main, operands: &Operands) {
        transition operands.u8wrap == 255 {
            true -> good(context)
            _ -> bad(context)
        }
    }

    state good(context: &mut Main) {
        context.console.exit_process(70);
    }

    state bad(context: &mut Main) {
        context.console.exit_process(71);
    }
}
