// Arithmetic-domain behaviour at the TYPE BOUNDARIES, computed at runtime (the
// operands are field reads, not const-folded into the comparison), and checked
// against the boundary constants. Locks the Decision-17 domains' overflow
// semantics as a regression guard (native + interpreter must agree):
//   * i32 Saturating  MAX + 1 -> MAX   (clamp, no wrap)
//   * i32 Wrapping    MAX + 1 -> MIN   (two's-complement wrap)
//   * u8  Saturating  255 + 1 -> 255   (clamp at the unsigned ceiling)
//   * u8  Wrapping    0   - 1 -> 255   (unsigned underflow wraps)
// All four correct -> exit 70.

use omega_language_std::console;

data Main {
    i32sat: i32 in Saturating;
    i32wrap: i32 in Wrapping;
    u8sat: u8 in Saturating;
    u8wrap: u8 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.i32sat = 2147483647;
    main.i32sat = main.i32sat + 1;          // saturates to i32::MAX

    main.i32wrap = 2147483647;
    main.i32wrap = main.i32wrap + 1;        // wraps to i32::MIN

    main.u8sat = 255;
    main.u8sat = main.u8sat + 1;            // saturates to 255

    main.u8wrap = 0;
    main.u8wrap = main.u8wrap - 1;          // wraps to 255

    transition main.i32sat == 2147483647 {
        true -> check_wrap(main)
        _ -> bad(main)
    }

    state check_wrap(main: &mut Main) {
        transition main.i32wrap == 0 - 2147483648 {
            true -> check_u8sat(main)
            _ -> bad(main)
        }
    }

    state check_u8sat(main: &mut Main) {
        transition main.u8sat == 255 {
            true -> check_u8wrap(main)
            _ -> bad(main)
        }
    }

    state check_u8wrap(main: &mut Main) {
        transition main.u8wrap == 255 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
