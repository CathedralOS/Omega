// Expected exit: 0. Finite stdin is empty for this corpus fixture.
use omega_language_std::console;
data Main { }

machine reused(value: i32 in Wrapping) -> i32 in Wrapping {
    let thousands: i32 in Wrapping = value / 1000;
    let hundreds: i32 in Wrapping = (value / 100) % 10;
    let tens: i32 in Wrapping = (value / 10) % 10;
    let ones: i32 in Wrapping = value % 10;
    value + thousands * 1000 + hundreds * 100 + tens * 10 + ones
}
machine shared(value: u64 in Saturating) -> u64 in Saturating {
    transition value > 0 { true -> calculate(value) _ -> 0 }
    state calculate(value: u64 in Saturating) -> u64 in Saturating {
        let product: u64 in Saturating = value * value;
        let quotient: u64 in Saturating = value / value;
        product + quotient + value
    }
}
machine shifts(value: u32 in Wrapping, count: u32 in Wrapping) -> u32 in Wrapping {
    let left: u32 in Wrapping = value << count;
    let right: u32 in Wrapping = value >> count;
    left + right + value + count
}
machine shared_shift(value: u32 in Wrapping) -> u32 in Wrapping {
    let shifted: u32 in Wrapping = value << value;
    shifted + value
}
machine trapped(value: u32 in Trapping) -> u32 in Trapping {
    let doubled: u32 in Trapping = value + value;
    doubled + value
}
machine read_value(context: &mut Main) -> i32 reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed {
        ByteRead::Eof -> (0 - 1)
        ByteRead::Byte { value } -> value
    }
}
machine Main::main(context: &mut Main) reaches Console {
    let byte: i32 = block read_value(context);
    let value: i32 in Wrapping = (byte as i32 in Wrapping) + 2346;
    let observed: i32 in Wrapping = reused(value);
    let shared_result: u64 in Saturating = shared(((byte as i32 in Wrapping) + 11) as u64 in Saturating);
    let shifted: u32 in Wrapping = shifts(((byte as i32 in Wrapping) + 18) as u32 in Wrapping, 2);
    let shared_shifted: u32 in Wrapping = shared_shift(((byte as i32 in Wrapping) + 3) as u32 in Wrapping);
    let trapped_result: u32 in Trapping = trapped(((byte as i32 in Wrapping) + 11) as u32 in Trapping);
    transition observed == 4690 && shared_result == 111 && shifted == 91 && shared_shifted == 10 && trapped_result == 30 {
        true -> good(context)
        _ -> wrong(context)
    }
    state good(context: &mut Main) { Console::exit_process(0); }
    state wrong(context: &mut Main) { Console::exit_process(71); }
}
