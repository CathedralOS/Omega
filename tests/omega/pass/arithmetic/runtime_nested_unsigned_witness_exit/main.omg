// A NESTED binary operand carries its operands' UNSIGNEDNESS (one witness):
// `(a / b) % k` with a high-bit u32 dividend must run the UNSIGNED divide AND
// modulo -- the signed idiv reads 3000000000 as negative and yields a negative
// remainder. The witness must recurse through the nested node in GUARD
// position (fused, no temp) exactly as the arg-materialization path types its
// temp slot. Also pins the sibling consumers of the same witness: an ordered
// compare of a nested quotient (unsigned `>`ping, not signed), and a logical
// (not arithmetic) shift-right of one. Operands are FIELDS (fold-proof; the
// verification landmines on the TASKS item apply: positive expected values
// only). Fifth direction: the WRITE-side fused-operand builder shares the
// witness funnel. Exit 70.
use omega_language_std::console;
use omega::language::core::binding;
data Operands {
    a: u32;
    b: u32;
    // Wrapping landing + S2-retagged ADD below: the Exact prover does not
    // model %-result ranges, and div/mod themselves carry no overflow
    // obligation -- the retag confines the proof question to the add while
    // the nested div/mod (this direction's actual subject) stay Exact-class
    // unsigned selections over runtime fields.
    r: u32 in Wrapping;
}
data Main { console: Binding<Console>; }
machine Main::main(context: &mut Main) reaches Console {
    let mut operands: Operands;
    operands.a = 3000000000;
    operands.b = 1;
    // Fused guard: unsigned 3000000000 / 1 % 100 = 0 (signed: rem -96).
    transition ((operands.a / operands.b) % 100 == 0) { true -> stored(context, &mut operands) _ -> bad1(context) }
    state stored(context: &mut Main, operands: &mut Operands) {
        // The arg-materialization flavor of the same shape.
        operands.r = ((operands.a / operands.b) % 100) as u32 in Wrapping;
        transition operands.r == 0 { true -> ordered(context, operands) _ -> bad2(context) }
    }
    state ordered(context: &mut Main, operands: &mut Operands) {
        // Ordered compare of a nested quotient: unsigned 1500000000 > 1000
        // (signed reading of the dividend would divide negative -> false).
        operands.b = 2;
        transition ((operands.a / operands.b) > 1000) { true -> shifted(context, operands) _ -> bad3(context) }
    }
    state shifted(context: &mut Main, operands: &mut Operands) {
        // Logical shift-right of a nested quotient: 3000000000/1 >> 1 =
        // 1500000000 (arithmetic sar of the negative reading differs).
        operands.b = 1;
        transition ((operands.a / operands.b) >> 1 == 1500000000) { true -> write_fused(context, operands) _ -> bad4(context) }
    }
    state write_fused(context: &mut Main, operands: &mut Operands) {
        // The WRITE-side fused-operand builder shares the same witness
        // funnel: the nested div/mod inside this add's left operand must
        // also pick the unsigned forms. a/b arrive from EARLIER states so
        // the folder cannot pre-compute the check (a same-state probe of
        // this shape folded its guard and MASKED the signedness entirely);
        // The S2 retags make the ADD Wrapping (defined overflow, no proof
        // obligation); the nested div/mod inside the left retag remain the
        // direction's subject.
        let mut z: u32 = 5;
        transition z < 10 { true -> write_go(context, operands, z) _ -> bad5(context) }
    }
    state write_go(context: &mut Main, operands: &mut Operands, zz: u32)
    requires
        zz <= 9
    {
        operands.r = (((operands.a / operands.b) % 100) as u32 in Wrapping)
            + (zz as u32 in Wrapping);
        transition operands.r == 5 { true -> good(context) _ -> bad6(context) }
    }
    state good(context: &mut Main) { context.console.exit_process(70); }
    state bad1(context: &mut Main) { context.console.exit_process(71); }
    state bad2(context: &mut Main) { context.console.exit_process(72); }
    state bad3(context: &mut Main) { context.console.exit_process(73); }
    state bad4(context: &mut Main) { context.console.exit_process(74); }
    state bad5(context: &mut Main) { context.console.exit_process(75); }
    state bad6(context: &mut Main) { context.console.exit_process(76); }
}
