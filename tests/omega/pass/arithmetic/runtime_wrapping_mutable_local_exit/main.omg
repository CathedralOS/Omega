// Zeroed local storage and successive writes preserve wrapping arithmetic.
use omega_language_std::console;

data Main { }

machine Main::main(context: &mut Main) reaches Console {
    let mut value: i32 in Wrapping;
    value = value + 2147483647;
    value = value + 1;
    value = value + 2147483647;
    value = value + 71;
    Console::exit_process(value as i32);
}
