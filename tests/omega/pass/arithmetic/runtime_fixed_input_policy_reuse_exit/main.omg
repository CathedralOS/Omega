// Exceptional signed policies, full-width unsigned reconstruction, trapping
// reuse and saturated products complement the ordinary fixed-division fixture.
machine wrapping(value: i64 in Wrapping, divisor: i64 in Wrapping) -> bool
requires divisor == -1
{
    let quotient: i64 in Wrapping = value / divisor;
    let remainder: i64 in Wrapping = value % divisor;
    let again: i64 in Wrapping = value / divisor;
    quotient == again && quotient == 0 - value && remainder == 0 && divisor == -1
}

machine saturating(value: i32 in Saturating, divisor: i32 in Saturating) -> bool
requires value == -2147483648 && divisor == -1
{
    let quotient: i32 in Saturating = value / divisor;
    let remainder: i32 in Saturating = value % divisor;
    let again: i32 in Saturating = value / divisor;
    quotient == 2147483647 && again == quotient && remainder == 0 && value == -2147483648
}

machine unsigned(value: u64 in Wrapping, divisor: u64 in Wrapping) -> bool
requires value == 18446744073709551615u64 && divisor == 10
{
    let quotient: u64 in Wrapping = value / divisor;
    let remainder: u64 in Wrapping = value % divisor;
    let again: u64 in Wrapping = value / divisor;
    quotient == 1844674407370955161u64 && remainder == 5 && quotient == again
        && quotient * divisor + remainder == value && divisor == 10
}

machine trapped(value: i32 in Trapping, divisor: i32 in Trapping) -> bool crashes Trap {
    let quotient: i32 in Trapping = value / divisor;
    let remainder: i32 in Trapping = value % divisor;
    let again: i32 in Trapping = value / divisor;
    quotient == 98 && remainder == 7 && quotient == again
        && quotient * divisor + remainder == value && divisor == 10 && value == 987
}

machine products(value: u64 in Saturating) -> u64 in Saturating {
    let square: u64 in Saturating = value * value;
    let twice: u64 in Saturating = value * 2;
    square + twice + value
}

machine main() crashes Trap {
    let minimum_wrapping: bool = wrapping(-9223372036854775808i64, -1);
    let ordinary_wrapping: bool = wrapping(137, -1);
    let minimum_saturating: bool = saturating(-2147483648, -1);
    let full_unsigned: bool = unsigned(18446744073709551615u64, 10);
    let trapping: bool = trapped(987, 10);
    let product: u64 in Saturating = products(9);
    transition minimum_wrapping && ordinary_wrapping && minimum_saturating && full_unsigned && trapping && product == 108 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
