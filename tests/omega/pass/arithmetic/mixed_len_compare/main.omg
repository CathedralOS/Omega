// Mixed-width guard comparisons: `main.i < main.text.len` compares i32
// against u64 `.len`; the re-guard `main.i >= 0 && main.i < 8` keeps the
// increment's overflow obligation out of the way so the comparison is
// the pinned behavior.
data Main { text: [u8; 8]; i: i32; }

machine Main::main(main: &mut Main) {
    main.text = "abcdefgh";
    main.i = 0;
    transition { _ -> step(main) }
    machine step(main: &mut Main) {
        transition main.i < main.text.len {
            true -> guarded(main)
            _ -> done(main)
        }
    }
    machine guarded(main: &mut Main) {
        transition main.i >= 0 && main.i < 8 {
            true -> bump(main)
            _ -> done(main)
        }
    }
    machine bump(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> step(main) }
    }
    machine done(main: &mut Main) {
        transition main.i == 8 {
            true -> correct()
            _ -> incorrect()
        }
    }
    machine correct() {}
    machine incorrect() {}
}
