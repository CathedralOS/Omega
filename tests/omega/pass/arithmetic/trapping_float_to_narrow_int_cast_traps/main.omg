use omega::language::core::float_operations;

// PASS canary: an f64 value that fits the wider conversion register but not
// the actual u8 target must trap before the truncating store. Exit 7 means the
// guard used u32/i32 bounds and sailed past; 71 means the in-range leg broke.
use omega::language::std::console;
data Main { console: Console; f: f64; r: u8; }
machine Main::main(&mut self) {
    self.f = 200.9;
    self.r = (self.f as u8 in Trapping) as u8;
    transition self.r == 200 { true -> out_of_range() _ -> bad() }
    state out_of_range(&mut self) {
        self.f = 300.0;
        self.r = (self.f as u8 in Trapping) as u8;
        self.console.exit_process(7);
    }
    state bad(&mut self) { self.console.exit_process(71); }
}
