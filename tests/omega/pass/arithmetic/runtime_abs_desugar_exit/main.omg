// `abs(x)` is a frontend desugar to `max(x, 0 - x)` (min/max are binary
// builtins, so abs needs zero new backend/interp machinery). abs(-70)=70,
// abs(12)=12; exits 70 only when both hold. The argument is a place, so
// the shared-subtree duplication is harmless (a call argument rejects).
use omega_language_std::console;
data Main {
    console: Console;
    x: i32;
    y: i32;
    r: i32;
    s: i32;
}
machine Main::main(&mut self) {
    self.x = 0 - 70;
    self.y = 12;
    self.r = abs(self.x);
    self.s = abs(self.y);
    transition self.r == 70 {
        true -> check_pos()
        false -> bad()
    }
    state check_pos(&mut self) {
        transition self.s == 12 {
            true -> good()
            false -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
