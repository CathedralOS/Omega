// A computed index over unsigned fields discharges its lower bound by
// type alone: `wh + wn` hoists to a temp whose u64 carrier cannot be
// negative — no `>= 0` guard needed; the upper bound is the authored
// guard.
data Main {
    arr: [i32 in Wrapping; 5];
    wh: u64 in Wrapping;
    wn: u64 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.wh = 1;
    main.wn = 3;
    transition main.wh + main.wn < 5 { true -> store(main) _ -> done(main) }
    machine store(main: &mut Main) {
        main.arr[main.wh + main.wn] = 11;
        transition main.arr[4] == 11 { true -> done(main) _ -> bad(main) }
    }
    machine done(main: &mut Main) {}
    machine bad(main: &mut Main) {}
}
