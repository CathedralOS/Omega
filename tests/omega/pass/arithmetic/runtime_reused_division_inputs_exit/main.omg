// One source parameter feeds several fixed-register divisions and remains live.
// Expected arithmetic is frozen here before execution: 27/10=2, 27%10=7,
// 27/4=6, 27%4=3, 27/27=1, 27%27=0; -27 truncates toward zero.
machine wrapping(value: i32 in Wrapping) -> bool requires value != 0 {
    let quotient: i32 in Wrapping = value / 10;
    let remainder: i32 in Wrapping = value % 10;
    let second: i32 in Wrapping = value / 4;
    let last: i32 in Wrapping = value % 4;
    let alias: i32 in Wrapping = value / value;
    let alias_remainder: i32 in Wrapping = value % value;
    quotient == 2 && remainder == 7 && second == 6 && last == 3
        && alias == 1 && alias_remainder == 0 && value == 27
}
machine saturating(value: i32 in Saturating) -> bool {
    let quotient: i32 in Saturating = value / 10;
    let remainder: i32 in Saturating = value % 10;
    let second: i32 in Saturating = value / 4;
    let last: i32 in Saturating = value % 4;
    quotient == 2 && remainder == 7 && second == 6 && last == 3 && value == 27
}
machine unsigned(value: u64 in Wrapping) -> bool requires value != 0 {
    let quotient: u64 in Wrapping = value / 10;
    let remainder: u64 in Wrapping = value % 10;
    let second: u64 in Wrapping = value / 4;
    let last: u64 in Wrapping = value % 4;
    let alias: u64 in Wrapping = value / value;
    quotient == 2 && remainder == 7 && second == 6 && last == 3
        && alias == 1 && value == 27
}
machine exact(value: i64) -> bool requires value == -27 {
    let quotient: i64 = value / 10;
    let remainder: i64 = value % 10;
    let second: i64 = value / 4;
    let last: i64 = value % 4;
    quotient == -2 && remainder == -7 && second == -6 && last == -3 && value == -27
}
machine main() crashes Trap {
    let first: bool = wrapping(27);
    let second: bool = saturating(27);
    let third: bool = unsigned(27);
    let fourth: bool = exact(-27);
    transition first && second && third && fourth {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
