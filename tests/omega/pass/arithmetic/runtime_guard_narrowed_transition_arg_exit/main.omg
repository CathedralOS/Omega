// The CO-LOCATED guard face of the keystone: an arm's guard and its arguments
// evaluate at the same dispatch, so `count < 100` narrows the `count + 1`
// argument into the [0..=100] parameter -- Exact, no domain. (Collection
// downgrades the guard when a SIBLING argument contains a call, which could
// mutate the guarded place between guard and argument evaluation.)
// count starts 0, bumps to 1 through the param. Exit 70. Differential.
use omega_language_std::console;
data Counter
where
    0 <= count,
    count <= 100,
{
    count: i32;
}
data Main { }
machine Main::main(context: &mut Main) reaches Console {
    let mut counter: Counter;
    transition counter.count < 100 {
        true -> bump(context, counter.count + 1, &mut counter)
        _ -> sat(context)
    }
    state bump(context: &mut Main, next: i32, counter: &mut Counter)
        requires 0 <= next && next <= 100
    {
        counter.count = next;
        transition { _ -> check(context, counter) }
    }
    state check(context: &mut Main, counter: &mut Counter) {
        transition counter.count == 1 { true -> ok(context) _ -> bad(context) }
    }
    state sat(context: &mut Main) { Console::exit_process(71); }
    state ok(context: &mut Main)  { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
