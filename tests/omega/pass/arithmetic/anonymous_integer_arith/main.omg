// Anonymous integer literals pick their type from the result carrier:
// `3 + 4` inside a `-> u8` machine is u8 arithmetic; wrapping edges
// like `(255 + 1) - 1` or `(0 - 1) + 2` and full-precision
// `(18446744073709551615 + 1) - 1` fold at check time inside the
// `ensures` evaluation — no `as` needed when every operand is
// anonymous and the carrier is fixed by the signature.
machine anonymous_sum() -> u8
ensures result == 7
{ 3 + 4 }
machine unsigned_intermediate() -> u8
ensures result == 255
{ (255 + 1) - 1 }
machine negative_intermediate() -> u8
ensures result == 1
{ (0 - 1) + 2 }
machine full_unsigned_precision() -> u64
ensures result == 18446744073709551615
{ (18446744073709551615 + 1) - 1 }

data Main {}
machine Main::main(main: &mut Main) {
    let a: u8 = anonymous_sum();
    let b: u8 = unsigned_intermediate();
    let c: u8 = negative_intermediate();
    let d: u64 = full_unsigned_precision();
}
