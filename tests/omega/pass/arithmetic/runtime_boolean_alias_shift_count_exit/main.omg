machine shift(value: u64, count: u32) -> u64 {
    let valid: bool = count < 64u32;
    transition valid {
        true -> calculate(value, count)
        false -> empty()
    }
    machine calculate(value: u64, count: u32) -> u64 { value >> count }
    machine empty() -> u64 { 0 }
}

machine main() crashes Trap {
    let selected: u64 = shift(8u64, 1u32);
    let refused: u64 = shift(8u64, 64u32);
    transition selected == 4 && refused == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
