// Expected exit: 0.
// Exercise odd and even bits, negative exponents, and reduction before products.
use omega_language_std::Console;

machine modular_power(base: i32, exponent: i32) -> i32
requires base >= 0
ensures result >= 0 && result <= 99
{
    transition {
        _ -> step(1, base % 100, exponent)
    }

    // Process the exponent bit by bit, lowest first; stop once it is exhausted.
    machine step(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        transition exponent == 0 {
            true -> (accumulator)
            _ -> classify(accumulator, base, exponent)
        }
    }

    // Fold the current squared base into the result only when this bit is set.
    machine classify(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        let bit: i32 = exponent % 2;
        transition bit == 1 {
            true -> accumulate(accumulator, base, exponent)
            _ -> square(accumulator, base, exponent)
        }
    }

    machine accumulate(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        let next_accumulator: i32 = (accumulator * base) % 100;
        transition {
            _ -> square(next_accumulator, base, exponent)
        }
    }

    // Square the base and halve the exponent for the next bit.
    machine square(accumulator: i32, base: i32, exponent: i32) -> i32
    requires accumulator >= 0 && accumulator <= 99
    requires base >= 0 && base <= 99
    ensures result >= 0 && result <= 99
    {
        let next_base: i32 = (base * base) % 100;
        let next_exponent: i32 = exponent / 2;
        transition {
            _ -> step(accumulator, next_base, next_exponent)
        }
    }

}
data Main {}
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let odd: i32 = modular_power(3, 7);
    let even: i32 = modular_power(3, 6);
    let negative: i32 = modular_power(3, -7);
    let reduced: i32 = modular_power(2147483647, 2);
    transition odd == 87 && even == 29 && negative == 1 && reduced == 9 {
        true -> Console::exit_process(0)
        false -> bad()
    }
    machine bad() crashes Trap { crash Trap; }
}

machine entry_start() reaches Console crashes Trap {
    let mut main: Main;
    Main::main(&mut main);
}
