machine shift(count: i32) -> u64 {
    let mut outside: bool = false;
    outside = count < 0i32 || count >= 64i32;
    let saved: bool = outside;
    transition { _ -> decide(saved, count) }

    machine decide(outside: bool, count: i32) -> u64 {
        transition outside {
            false -> calculate(count)
            true -> empty()
        }
    }
    machine calculate(count: i32) -> u64 { 8u64 >> count }
    machine empty() -> u64 { 0 }
}

machine main() crashes Trap {
    let selected: u64 = shift(1i32);
    let negative: u64 = shift(-1i32);
    let over_width: u64 = shift(64i32);
    transition selected == 4 && negative == 0 && over_width == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
