// An exact cast converts a value without changing it, so what was proved
// about the value before the cast still holds of the result. `value <= 200`
// makes the narrowing to `u8` representable and leaves room for the `u8`
// addition of 55; widening the sum back to `u32` owes no proof. Its twin
// `fail/arithmetic/exact_cast_carries_bound_unproven` differs only in the
// bound. Expected exit: 0.
machine scale(value: u32) -> u32
requires value <= 200
{
    let small: u8 = value as u8;
    let padded: u8 = small + 55;
    padded as u32
}

machine main() {
    let scaled: u32 = scale(200);
}
