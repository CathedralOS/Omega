machine quotient(divisor: u64) -> u64 {
    let nonzero: bool = divisor != 0u64;
    transition { _ -> classify(nonzero, divisor) }

    state classify(nonzero: bool, divisor: u64) -> u64 {
        transition nonzero {
            true -> divide(divisor)
            false -> empty()
        }
    }
    state divide(divisor: u64) -> u64 { 64u64 / divisor }
    state empty() -> u64 { 0 }
}

machine main() crashes Trap {
    let selected: u64 = quotient(8u64);
    let refused: u64 = quotient(0u64);
    transition selected == 8 && refused == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
