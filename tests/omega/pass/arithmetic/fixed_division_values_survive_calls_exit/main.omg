// Inputs and earlier fixed-register results survive later divide/remainder
// operations. An aliased dividend/divisor still denotes two observations.
use omega_language_std::console;
use omega::language::core::binding;
machine calculate(numerator: i64 in Wrapping, divisor: i64 in Wrapping) -> i64 in Wrapping
requires numerator > 0 && divisor > 0
{
    let quotient: i64 in Wrapping = numerator / divisor;
    let remainder: i64 in Wrapping = numerator % divisor;
    let identity: i64 in Wrapping = numerator / numerator;
    quotient * 1000 + remainder * 100 + numerator + divisor + identity * 10
}
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let result: i64 in Wrapping = calculate(45, 7);
    transition result == 6362 {
        true -> good(&main.console)
        false -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
