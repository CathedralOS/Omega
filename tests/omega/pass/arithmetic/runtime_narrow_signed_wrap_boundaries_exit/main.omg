// Signed two's-complement WRAP-AROUND at narrow-type boundaries (i8, i16), both ends. The
// existing narrow-signed canaries cover SATURATING clamps and guarded ops; the Wrapping
// wrap-around at the signed boundary (127 -> -128, -128 -> 127 for i8; the analogous i16
// corners) is exercised here. This pins that an in-Wrapping overflow on a narrow SIGNED
// type wraps in two's complement at the correct width -- a real behavior for pixel deltas,
// small counters, and fixed-width protocol fields. All four corners must hold -> exit 70.
use omega::language::std::console;

data Main {
    console: Console;
    a8h: i8 in Wrapping;   // i8 high boundary
    a8l: i8 in Wrapping;   // i8 low boundary
    a16h: i16 in Wrapping; // i16 high boundary
    a16l: i16 in Wrapping; // i16 low boundary
}

machine Main::main(&mut self) {
    self.a8h = 127;        self.a8h = self.a8h + 1;   // 127 + 1  wraps to -128
    self.a8l = 0 - 128;    self.a8l = self.a8l - 1;   // -128 - 1 wraps to 127
    self.a16h = 32767;     self.a16h = self.a16h + 1; // 32767 + 1   wraps to -32768
    self.a16l = 0 - 32768; self.a16l = self.a16l - 1; // -32768 - 1  wraps to 32767

    transition self.a8h == 0 - 128
            && self.a8l == 127
            && self.a16h == 0 - 32768
            && self.a16l == 32767 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
