// RUN canary (exit 70). Stage 1 of the unified fact catalog over sum cases:
// a case-payload field is bounded by its case `where` (`0 <= index && index <= 15`), so
// inside the `Found` destructure arm `index + 65` proves EXACT (index in [0,15]
// -> [65,80], no i32 overflow) with no annotation. Sound because construction
// enforces the range (forged out-of-range values are rejected -- see
// fail/arithmetic/construction_payload_out_of_range). Found{index:5} -> 5+65=70.
use omega_language_std::console;
data Slot { case Found(index: i32) where 0 <= index && index <= 15; case Full; }
data Main { }
machine Main::run(context: &mut Main, s: Slot) reaches Console {
    transition s {
        Slot::Found { index } -> use_it(context, index + 65)
        Slot::Full            -> done(context)
    }
    state use_it(context: &mut Main, n: i32) { Console::exit_process(n); }
    state done(context: &mut Main) { Console::exit_process(0); }
}
machine Main::main(context: &mut Main) { Main::run(context, Slot::Found { index: 5 }); }
