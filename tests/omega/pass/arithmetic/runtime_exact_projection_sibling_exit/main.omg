use omega_language_std::console;

data Main { }
data Pair { first: u32; second: u32; }

machine selected(divisor: u32) -> u32 requires divisor != 0 {
    Pair { first: 7u32, second: 42u32 / divisor }.first
}

machine Main::main(main: &mut Main) reaches Console {
    let value: u32 = selected(3u32);
    transition value == 7u32 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
