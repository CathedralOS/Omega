// RUN canary (decision 17 + S4 requires-seeding precision). A ONE-sided
// `requires x < 99` bounds only x's HIGH end; the value `(x + 1) + 1` proves
// both ordered EXACT additions (no `Wrapping`) because the operand's env
// interval is intersected with its declared type range. The first proof-bearing
// result feeds the second operation while retaining a separate safety proof.
// Before that intersection the low end stayed unbounded and this was
// (over-)rejected. The genuinely-overflowing direction
// (`requires x > 0 { x + 1 }`, high end unbounded) is still rejected.
//
// inc(40) = 42; main exits 42.

use omega::language::std::console;
data Main { console: Console; }

machine Main::inc(&mut self, x: i32) -> i32
    requires x < 99
{
    (x + 1) + 1
}

machine Main::main(&mut self) {
    let result: i32 = self.inc(40);
    self.console.exit_process(result);
}
