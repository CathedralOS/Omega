machine right_zero(value: u64) -> u64
    ensures result == 0
{
    value * 0
}
machine left_zero(value: u64) -> u64
    ensures result == 0
{
    0 * value
}
machine guarded_zero(value: u64, factor: u64) -> u64
    requires factor == 0
    ensures result == 0
{
    value * factor
}
machine main() crashes Trap {
    let right: u64 = right_zero(18446744073709551615u64);
    let left: u64 = left_zero(18446744073709551615u64);
    let guarded: u64 = guarded_zero(18446744073709551615u64, 0u64);
    transition right == 0 && left == 0 && guarded == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
