machine exact(value: u32) -> u32
    requires (match value != 0u32 {
        true -> 10u32 / value,
        _ -> 0u32
    }) >= 0u32
{
    0u32
}

machine wrapping(value: u32 in Wrapping) -> u32
    requires (match value != 0u32 {
        true -> 10u32 / value,
        _ -> 0u32
    }) >= 0u32
{
    0u32
}
