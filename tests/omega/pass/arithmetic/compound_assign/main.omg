// Compound assignment operators `+= -= *= /= %=` desugar to
// `x = x OP y`; chained in one state every later read observes the
// prior write, not a stale entry-value fold.
data Main {}

machine Main::main(main: &mut Main) {
    let mut v: i32 = 10;
    v += 5;
    v -= 3;
    v *= 2;
    v /= 4;
    v %= 4;
    transition v == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
