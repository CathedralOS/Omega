// Expected exit: 0
// Divisibility includes negative dividends, negative divisors and constants.
data Multiple where value % -3 == 0 { value: i64; }
machine signed(count: i64) -> Multiple requires count >= -4095 && count <= 4095 {
    Multiple { value: count * 6 + 12 }
}
machine saturated(value: u8 in Saturating) -> u8 in Saturating { (value * 2) % 2 }
machine wrapped(value: u8 in Wrapping) -> u8 in Wrapping { (value * 3) % 3 }
machine main() crashes Trap {
    let negative: Multiple = signed(-7);
    let positive: Multiple = signed(7);
    transition negative.value == -30 && positive.value == 54
        && saturated(128) == 1 && wrapped(100) == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
