use omega_language_std::console;

data Main { }
data Pair { first: u32; second: u32; }

machine retained(value: u32) -> u32 { value }

machine combined(divisor: u32) -> u32 requires divisor != 0 {
    Pair {
        first: Pair { first: 7u32, second: retained(42u32 / divisor) }.first,
        second: 99u32,
    }.first ^ Pair { first: 3u32, second: 63u32 / divisor }.second
}

machine Main::main(main: &mut Main) reaches Console {
    let value: u32 = combined(3u32);
    transition value == 18u32 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
