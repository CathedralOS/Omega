use omega_language_std::console;

data Sample {
    readings: &[u8];
}

machine read_member(value: &Sample) -> u8 {
    match value.readings.len == 0 {
        true -> 0,
        _ -> value.readings[0]
    }
}

data Main { source: [u8; 4]; }

machine Main::main(main: &mut Main) reaches Console {
    main.source[0] = 72;
    main.source[1] = 105;
    let sample: Sample;
    sample.readings = "Hi";
    let observed: u8 = read_member(&sample);
    transition observed == 72 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
