// A call-initialized mutable local can be reassigned from another call in a
// single-state static body (exit 70).
//
// `let mut total: i32 = thirty();` establishes the local's storage from one
// call's result, `echo(total)` reads that stored 30 as an argument, and
// `total = seventy();` stores a second call's result over it before the exit
// reads it back. The single-state body's call roster has to credit the first
// call to the local's initializer rather than report it as omitted. A lost
// reassignment exits 30.
use omega_language_std::console;

data Main { }

machine thirty() -> i32 {
    30
}

machine seventy() -> i32 {
    70
}

machine echo(value: i32) -> i32 {
    value
}

machine Main::main(main: &mut Main) reaches Console {
    let mut total: i32 = thirty();
    let seen: i32 = echo(total);
    total = seventy();
    Console::exit_process(total);
}
