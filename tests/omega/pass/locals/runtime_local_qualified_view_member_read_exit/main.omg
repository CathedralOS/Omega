domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
// Wire stage 2, domain-qualified borrowed slices: a `#N label: &[u8] in Utf8`
// member is still borrowed-slice storage -- the `in Utf8` qualification rides
// the referee slice, and ENCODE only reads the member (a place declared `in`
// establishes its domain at every write, so reading yields a value already in
// the domain). Encode therefore emits the same text-bytes append a plain
// `&[u8]` uses: a length varint then the raw bytes.
//
// The sample is memberwise-filled on a declared local: a view member starts
// as the empty descriptor at declaration (the zero handle is the absent
// view), and each member store that follows establishes its descriptor like
// any member write -- the same fill pattern `context.label = "omega"` uses
// on the entry record, applied to a local.
//
// Encoded bytes for { count: 7, label: "héllo" }, hand-computed:
//   era 0          -> 0x00   (no version blocks)
//   tag 0          -> 0x00   (field number 0)
//   count 7        -> 0x07   (single-byte varint)
//   tag 1          -> 0x01   (field number 1)
//   length 6       -> 0x06
//   'h'            -> 0x68
//   'é'            -> 0xC3 0xA9   (U+00E9 in UTF-8)
//   'l' 'l' 'o'    -> 0x6C 0x6C 0x6F
// written = 11; the canary checks the byte-exact frame + the written count
// in-language and exits 70 when both hold.

use omega_language_std::console;

data LabelMessage {
    #0 count: u32;
    #1 label: &[u8] in Utf8;
}

data LabelSample {
    count: u32;
    label: &[u8] in Utf8;
}

data Main {
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    let sample: LabelSample;
    sample.count = 7;
    sample.label = "héllo";

    LabelMessage::encode(&sample, &mut main.buffer, &mut main.written);

    let ok: bool = main.written == 11
        && main.buffer[0] == 0
        && main.buffer[1] == 0
        && main.buffer[2] == 7
        && main.buffer[3] == 1
        && main.buffer[4] == 6
        && main.buffer[5] == 72
        && main.buffer[6] == 195
        && main.buffer[7] == 169
        && main.buffer[8] == 108
        && main.buffer[9] == 108
        && main.buffer[10] == 111;

    transition ok {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
