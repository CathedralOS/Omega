// Element writes into an owned local array do not need `mut`: `mut` grants
// whole-binding replacement, and a member or element write does not rebind
// the local. Three establishments take element stores and read them back:
// a declared-zeroed local filled from a by-value array parameter's elements
// (the GUI providers' `padded[0] = title[0]` shape), an array-literal local,
// and a byte-string-literal local whose quoted bytes must be copied into the
// local's own storage rather than written through image storage.
// exits: 70 = all three read back their stored bytes; 71 = the zeroed local;
// 72 = the array-literal local; 73 = the byte-string local.
use omega_language_std::console;
use omega::language::core::binding;

machine pad(title: [u8; 3]) -> u8 {
    let padded: [u8; 4];
    padded[0] = title[0];
    padded[1] = title[1];
    padded[2] = title[2];
    padded[3] = 0;
    (padded[1])
}

machine patch_literal(seed: u8) -> u8 {
    let bytes: [u8; 4] = [1, 2, 3, 4];
    bytes[1] = seed;
    (bytes[1])
}

machine patch_text(seed: u8) -> u8 {
    let text: [u8; 3] = "ABC";
    text[1] = seed;
    (text[1])
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let title: [u8; 3] = [65, 70, 67];
    let padded: u8 = pad(title);
    let literal: u8 = patch_literal(70);
    let text: u8 = patch_text(70);
    transition padded == 70 {
        true -> literal_check(&main.console, literal, text)
        _ -> failed(&main.console, 71)
    }
    state literal_check(console: &Binding<Console>, literal: u8, text: u8) {
        transition literal == 70 {
            true -> text_check(console, text)
            _ -> failed(console, 72)
        }
    }
    state text_check(console: &Binding<Console>, text: u8) {
        transition text == 70 {
            true -> done(console)
            _ -> failed(console, 73)
        }
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state failed(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
