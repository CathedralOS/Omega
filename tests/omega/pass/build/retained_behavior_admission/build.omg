machine build(builder: &mut Build) {
    Build::application(builder, "retained_behavior_admission");
    Build::select_provider<Assertion, Noop>(builder, windows_x86_64);
    Build::select_provider<Assertion, Noop>(builder, linux_x86_64);
    Build::select_provider<Assertion, Noop>(builder, macos_arm64);
    Build::select_provider<Assertion, Noop>(builder, linux_arm64);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
