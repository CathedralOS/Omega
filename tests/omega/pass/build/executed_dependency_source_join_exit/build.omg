machine build(builder: &mut Build) {
    Build::application(builder, "executed_dependency_source_join_exit");
    select_dependency(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}

machine select_dependency(builder: &mut Build) {
    transition true {
        true -> selected_dependency(builder)
        false -> unselected_dependency(builder)
    }
}

machine selected_dependency(builder: &mut Build) {
    let mut selected_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../executed_dependency_source_library" });
    dependency::with_alias(&mut selected_dependency, "selected");
    let selected_registration: DependencyRegistration = Build::dependency(builder, selected_dependency);
}

machine unselected_dependency(builder: &mut Build) {
    let mut absent_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../must_not_be_acquired" });
    dependency::with_alias(&mut absent_dependency, "absent");
    let absent_registration: DependencyRegistration = Build::dependency(builder, absent_dependency);
}
