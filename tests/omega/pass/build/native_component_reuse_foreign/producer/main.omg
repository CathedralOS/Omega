use omega::language::core::external_binding;
public boundary trait NativeAbsolute { machine absolute(value: i32) -> i32 reaches; }
public boundary trait Reading { machine read() -> i32 reaches NativeAbsolute; }
public Reader satisfies Reading {
    machine read() -> i32 reaches NativeAbsolute { NativeAbsolute::absolute(-42) }
}


machine component_entry() {}
