use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "native_component_reuse");
    Build::depend_as(builder, "producer", Source::Path { location: "producer" });
    Build::select_provider<producer::Reading, producer::Reader>(builder, linux_arm64, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, linux_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, macos_arm64, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, macos_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, windows_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, uefi_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, cross_platform_cli, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, local_unchecked, CompositionMode::Independent);
    Build::select_provider<producer::Reading, producer::Reader>(builder, alpha_bootstrap, CompositionMode::Independent);
    Build::bind(builder, macos_arm64::ProgramEntry, main);

 Build::bind<producer::NativeAbsolute::absolute>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, macos_x86_64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, uefi_x86_64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, cross_platform_cli, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, local_unchecked, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
 Build::bind<producer::NativeAbsolute::absolute>(builder, alpha_bootstrap, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs",
    } });
}
