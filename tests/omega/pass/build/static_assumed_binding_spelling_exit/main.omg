// A user declaration with build-vocabulary spelling remains an ordinary call.
data Build { value: i32; }

machine Build::assume_binding_contract(builder: &mut Build) {
    builder.value = 42;
}

machine main() crashes Trap {
    let mut builder: Build;
    Build::assume_binding_contract(&mut builder);
    transition builder.value == 42 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
