machine build(builder: &mut Build) {
    Build::application(builder, "named_map_target_family_rows_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::select_provider<Gate, GateProvider>(builder, linux_arm64);
    Build::select_provider<Gate, GateProvider>(builder, linux_x86_64);
    Build::select_provider<Gate, GateProvider>(builder, macos_arm64);
    Build::select_provider<Gate, GateProvider>(builder, macos_x86_64);
    Build::select_provider<Gate, GateProvider>(builder, windows_x86_64);
    Build::select_provider<Gate, GateProvider>(builder, uefi_x86_64);
    Build::select_provider<Gate, GateProvider>(builder, cross_platform_cli);
    Build::select_provider<Gate, GateProvider>(builder, local_unchecked);
    Build::select_provider<Gate, GateProvider>(builder, alpha_bootstrap);
}
