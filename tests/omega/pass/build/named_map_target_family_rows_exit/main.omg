// RUN CANARY (exit 70). A package-local boundary trait is a selectable slot
// whose named map binds target-scoped machines. `open_gate` and `close_gate`
// are declared once per target, so each is a family whose head carries no
// body: the map's rows name the head, and realization installs the member
// authored for the realized target. The selection is spelled after the entry
// bindings; the sibling fixture spells it before them.
use omega_language_std::console;

public boundary trait Gate {
    machine open() -> i32 reaches;
    machine close(ticket: i32) -> i32 reaches;
}
GateProvider satisfies Gate {
    Gate::open = open_gate;
    Gate::close = close_gate;
}
macos_arm64 machine open_gate() -> i32 { 7 }

linux_x86_64 machine open_gate() -> i32 { 7 }
windows_x86_64 machine open_gate() -> i32 { 7 }
macos_arm64 machine close_gate(ticket: i32) -> i32 {
    transition ticket == 7 { true -> accepted() _ -> refused() }
    machine accepted() -> i32 { 70 }
    machine refused() -> i32 { 71 }
}

linux_x86_64 machine close_gate(ticket: i32) -> i32 {
    transition ticket == 7 { true -> accepted() _ -> refused() }
    machine accepted() -> i32 { 70 }
    machine refused() -> i32 { 71 }
}
windows_x86_64 machine close_gate(ticket: i32) -> i32 {
    transition ticket == 7 { true -> accepted() _ -> refused() }
    machine accepted() -> i32 { 70 }
    machine refused() -> i32 { 71 }
}

data Main { ticket: i32; code: i32; }
machine Main::main(main: &mut Main) reaches Gate + Console {
    main.ticket = Gate::open();
    main.code = Gate::close(main.ticket);
    transition main.code == 70 { true -> good() _ -> bad() }
    machine good() { Console::exit_process(70); }
    machine bad() { Console::exit_process(72); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Gate + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
