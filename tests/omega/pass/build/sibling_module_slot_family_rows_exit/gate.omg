module gate;

// The slot, its named map and the target-scoped families live in a sibling
// module of the root package; the build selects the map before any entry
// binding is spelled.
public boundary trait Gate {
    machine open() -> i32 reaches;
    machine close(ticket: i32) -> i32 reaches;
}
public GateProvider satisfies Gate {
    Gate::open = open_gate;
    Gate::close = close_gate;
}
public macos_arm64 machine open_gate() -> i32 { 7 }

public linux_x86_64 machine open_gate() -> i32 { 7 }
public windows_x86_64 machine open_gate() -> i32 { 7 }
public macos_arm64 machine close_gate(ticket: i32) -> i32 {
    transition ticket == 7 { true -> accepted() _ -> refused() }
    machine accepted() -> i32 { 70 }
    machine refused() -> i32 { 71 }
}

public linux_x86_64 machine close_gate(ticket: i32) -> i32 {
    transition ticket == 7 { true -> accepted() _ -> refused() }
    machine accepted() -> i32 { 70 }
    machine refused() -> i32 { 71 }
}
public windows_x86_64 machine close_gate(ticket: i32) -> i32 {
    transition ticket == 7 { true -> accepted() _ -> refused() }
    machine accepted() -> i32 { 70 }
    machine refused() -> i32 { 71 }
}
