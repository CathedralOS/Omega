machine build(builder: &mut Build) {
    Build::application(builder, "sibling_module_slot_family_rows_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, linux_arm64);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, linux_x86_64);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, macos_arm64);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, macos_x86_64);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, windows_x86_64);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, uefi_x86_64);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, cross_platform_cli);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, local_unchecked);
    Build::select_provider<gate::Gate, gate::GateProvider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
