// RUN CANARY (exit 70). Mechanical variant of named_map_target_family_rows_exit:
// the package-local boundary slot, its map and the per-target families are
// declared in the sibling module `gate`, and the build selects the provider
// before binding the entries. The realized member must still answer the call.
use omega_language_std::console;
use gate::Gate;

data Main { ticket: i32; code: i32; }
machine Main::main(main: &mut Main) reaches Gate + Console {
    main.ticket = Gate::open();
    main.code = Gate::close(main.ticket);
    transition main.code == 70 { true -> good() _ -> bad() }
    machine good() { Console::exit_process(70); }
    machine bad() { Console::exit_process(72); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Gate + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
