// RUN CANARY (exit 70) + interpreter differential. M2 blocker 3
// (depend-mapping, landed 2026-07-11): the companion build.omg's
// canonical `builder.depend_as("mylib", Source::Path { ... })` row maps the
// alias, `use mylib::values` resolves INTO the aliased directory (not
// root-relative), and the depended package's free const substitutes
// (composing with blocker 4). The dependency's build hook remains scoped to
// that package rather than colliding with the application's build hook.
use mylib::values;
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(&mut self) reaches Console {
    transition ANSWER == 42 { true -> yes() _ -> no() }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
