machine build(builder: &mut Build) {
    Build::application(builder, "default_component_abi_extents");
    let mut producer_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "producer" });
    dependency::with_alias(&mut producer_dependency, "producer");
    let producer_registration: DependencyRegistration = Build::dependency(builder, producer_dependency);
    Build::select_provider<producer::main::Inspect<u8>, producer::main::Inspector>(builder, windows_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::main::Inspect<u8>, producer::main::Inspector>(builder, linux_x86_64, CompositionMode::Independent);
    Build::select_provider<producer::main::Inspect<u8>, producer::main::Inspector>(builder, macos_arm64, CompositionMode::Independent);
    Build::select_provider<producer::main::Inspect<u8>, producer::main::Inspector>(builder, linux_arm64, CompositionMode::Independent);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
