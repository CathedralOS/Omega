// Expected exit: 0
// Build settings need the same Unit-return mutable-receiver writeback as this
// ordinary record. The replacement has static backing; the caller observes it.
use omega::language::core::activation;

data Settings<'storage> { identifier: &'storage [u8]; revision: u32; signature: [u8; 3]; }

machine replace_identifier<'storage>(settings: &mut Settings<'storage>) {
    settings.identifier = "omega";
    settings.revision = 42;
    settings.signature[1] = 9;
}

machine configure<'storage>(settings: &mut Settings<'storage>) {
    replace_identifier(settings);
}

machine exercise() -> bool {
    let mut settings: Settings = Settings { identifier: "before", revision: 0, signature: [0, 0, 0] };
    configure(&mut settings);
    settings.identifier.len == 5 && settings.identifier[0] == 111 && settings.revision == 42 && settings.signature[1] == 9
}

machine consume(settings: Settings) {}

// The embedding test selects this entry to measure frame lifetimes independently
// of value rows: two sequential call trees have a maximum of three live frames.
machine frame_leaf() {}
machine frame_nested() { frame_leaf(); }
machine frame_sequence() { frame_nested(); frame_nested(); }

machine copy_array(values: [u32; 3]) -> [u32; 3] { values }
machine empty_array_result() -> [u32; 0] { [] }
data Cell { value: u32; }
machine record_storage() -> u32 {
    let cell: Cell = Cell { value: 37 };
    cell.value
}
machine move_cell(cell: Cell) -> Cell { cell }
machine moved_record_storage() -> u32 {
    let cell: Cell = Cell { value: 37 };
    let moved: Cell = move_cell(cell);
    moved.value
}
data CopyCell [copy] { value: u32; }
machine copy_cell(cell: CopyCell) -> CopyCell { cell }
machine copied_record_storage() -> u32 {
    let mut original: CopyCell = CopyCell { value: 37 };
    let copied: CopyCell = copy_cell(original);
    original.value = 99;
    copied.value
}
machine write_number(value: &mut u32) { value = 37; }
machine primitive_storage() -> u32 {
    let mut value: u32 = 11;
    write_number(&mut value);
    value
}
machine primitive_entry(value: &mut u32) -> u32 {
    write_number(value);
    value
}
data Choice [copy] { case Chosen(value: u32); case Empty; }
machine case_storage() -> u32 {
    let choice: Choice = Choice::Chosen { value: 37 };
    transition choice {
        Choice::Chosen { value } -> chosen(value)
        Choice::Empty -> empty()
    }
    state chosen(value: u32) { value }
    state empty() { 0 }
}
data ByteHolder<'storage> { bytes: &'storage [u8]; }
machine byte_field_storage() -> u32 {
    let holder: ByteHolder = ByteHolder { bytes: "%" };
    holder.bytes[0] as u32
}
// Selected independently as a Terminal inspection: result-case storage must
// be funded before split/merge consumes the original activation claims.
machine activation_storage_budget() crashes Trap {
    transition Activation::try_claim<16>(8) {
        ActivationClaimAttempt::Established { claim } -> divide(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    state divide(claim: ActivationClaim) {
        transition ActivationClaim::split<8>(claim, 4) {
            ActivationClaimSplit::Covered { lower, upper } -> merge_children(lower, upper)
            ActivationClaimSplit::Rejected { claim } -> release_bad(claim)
        }
    }
    state merge_children(lower: ActivationClaim, upper: ActivationClaim) {
        transition ActivationClaim::merge(lower, upper) {
            ActivationClaimMerge::Covered { claim } -> release(claim)
            ActivationClaimMerge::Rejected { lower, upper } -> release_pair(lower, upper)
        }
    }
    state release_pair(lower: ActivationClaim, upper: ActivationClaim) {
        ActivationClaim::release(upper);
        ActivationClaim::release(lower);
        crash Trap;
    }
    state release_bad(claim: ActivationClaim) {
        ActivationClaim::release(claim);
        crash Trap;
    }
    state release(claim: ActivationClaim) { ActivationClaim::release(claim); }
    state bad() { crash Trap; }
}
machine array_result() -> [u32; 3] {
    let original: [u32; 3] = [11, 22, 33];
    let mut copied: [u32; 3] = copy_array(original);
    copied[1] = 44;
    [copied[0], copied[1], original[1]]
}

machine fail_after_write(settings: &mut Settings) crashes Trap {
    configure(settings);
    crash Trap;
}

machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
