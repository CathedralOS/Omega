machine build(builder: &mut Build) {
    Build::application(builder, "receiver_view_writeback_exit");
    configure_build(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}

machine configure_build(builder: &mut Build) {
    replace_build_identifier(builder);
}

machine replace_build_identifier(builder: &mut Build) {
    builder.identifier = "com.example.omega";
}

machine configure_build_readback(builder: &mut Build) {
    configure_build(builder);
    builder.subsystem = Subsystem::Gui;
}
