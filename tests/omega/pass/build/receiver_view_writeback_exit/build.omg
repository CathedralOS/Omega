machine build(builder: &mut Build) {
    Build::application(builder, "receiver_view_writeback_exit");
    configure_build(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}

machine configure_build(builder: &mut Build) {
    replace_build_identifier(builder);
}

// An explicit reborrow keeps the original activation identity at the host.
machine bind_reborrowed(builder: &mut Build) {
    Build::bind(&mut builder, macos_arm64::ProgramEntry, main);
}

machine replace_build_identifier(builder: &mut Build) {
    builder.identifier = "com.example.omega";
}

machine configure_build_readback(builder: &mut Build) {
    configure_build(builder);
    builder.subsystem = Subsystem::Gui;
}

// Exercise scalar, nested record, case-payload and byte-view settings through
// the same original receiver. These helpers are selected by the embedding test,
// not executed by the product's ordinary Build entry.
machine configure_all_settings(builder: &mut Build) {
    configure_build_readback(builder);
    builder.subsystem = Subsystem::Unspecified { value: 73 };
    builder.freestanding = true;
    builder.x86_deployment_features = X86DeploymentFeatures::AvxFma3;
    builder.privileged_services.port_io = true;
    builder.elf_interpreter.linux_arm64 = "/lib/omega-loader.so";
    builder.optimizations.control_flow_cleanup = 1;
    builder.optimizations.human_report = 1;
}

machine configure_invalid_identifier(builder: &mut Build) {
    builder.identifier = "not an identifier";
}

machine configure_invalid_loader(builder: &mut Build) {
    builder.elf_interpreter.linux_arm64 = "relative-loader.so";
}

machine configure_duplicate_optimization(builder: &mut Build) {
    builder.optimizations.control_flow_cleanup = 2;
}

boundary trait ObserveBuild {
    machine record(builder: &mut Build, sequence: u64) reaches;
}

machine configure_build_boundary(builder: &mut Build)
reaches ObserveBuild
{
    builder.identifier = "before";
    ObserveBuild::record(builder, 1);
    builder.identifier = "after";
    ObserveBuild::record(builder, 2);
}
