machine build(builder: &mut Build) {
    Build::application(builder, "runtime_static_service_exclusion_exit");
    Build::depend(builder, Source::Path { location: "../../../packages/logger-kit" });
    configure(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}

machine configure(builder: &mut Build) {
    let selected: u32 = Ordinary::exclude_service<u32>(7);
    Build::select_provider<logger_kit::main::Sink, logger_kit::main::QuietSinkProvider>(builder);
    Build::exclude_service<logger_kit::main::Sink>(builder);
}

data Ordinary {}
machine Ordinary::exclude_service<Element>(value: Element) -> Element {
    value
}
