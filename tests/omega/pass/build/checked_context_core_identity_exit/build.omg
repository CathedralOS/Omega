use omega::language::core::extent;

machine checked_value(value: addr) -> addr
requires no_wrap(value, 0)
{ value }

machine build(builder: &mut Build) {
    Build::application(builder, "checked_context_core_identity_exit");
    let checked: addr = checked_value(7);
    transition checked == 7 { true -> bind_entries(builder) false -> done() }

    machine bind_entries(builder: &mut Build) {
        Build::bind(builder, macos_arm64::ProgramEntry, main);
        Build::bind(builder, linux_arm64::ProgramEntry, main);
        Build::bind(builder, linux_x86_64::ProgramEntry, main);
        Build::bind(builder, windows_x86_64::ProgramEntry, main);
    }
    machine done() {}
}
