// Expected exit: 0.
// Core qualifications, projections and same-named local callables keep their
// independent Build/Product owners. Selecting either other body fails its oracle.
use omega::language::core::extent;

machine checked_value(value: addr) -> addr
requires no_wrap(value, 0)
{ 11 }

machine main() crashes Trap {
    let checked: addr = checked_value(7);
    transition checked == 11 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
