// Expected exit: 0. The entry's explicit region must not hide its closed context.
data Main<'entry> { value: i32; }
machine borrowed<'source>(value: &'source i32) -> &'source i32 { value }
machine Main::main<'entry>(main: &'entry mut Main<'entry>) crashes Trap {
    main.value = 37;
    let view: &i32 = borrowed(&main.value);
    let result: i32 = view as i32;
    transition result == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The root owns ordinary local storage; its region is not allocation authority.
machine entry_start<'entry>() crashes Trap {
    let mut entry_storage: Main<'entry>;
    Main::main(&mut entry_storage);
}
