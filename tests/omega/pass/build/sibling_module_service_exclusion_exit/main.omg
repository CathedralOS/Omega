// Excluding left::Sink leaves the same-spelled right::Sink admitted: the
// exclusion selects one module's declaration, never every `Sink`.
use left;
use right;
use right::Sink;

data Main { }
machine Main::main(main: &mut Main)
reaches Sink
{
    relay();
}

machine relay()
reaches Sink
{
    Sink::emit("relayed");
}
