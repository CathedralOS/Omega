use omega::language::core::extent;
use omega::language::core::representation;
use std::targets::uefi_x86_64::entry;

data SystemTableHeader {
    signature: u64;
    revision: u32;
    header_size: u32;
    crc: u32;
    reserved: u32;
}
SystemTableRepresentation satisfies OpaqueRepresentation<EfiSystemTable, SystemTableHeader> { }

FirmwareBootstrap satisfies UefiPhysicalEntry {
    UefiPhysicalEntry::enter = firmware_entry;
}

// A real source frame larger than the 128 KiB arrival guarantee. Both ends
// travel through an ordinary mutable loan; the image's entry stack must cover
// the exact emitted closure, without increasing the firmware premise.
machine firmware_entry(image_handle: EfiImageHandle, system_table: &EfiSystemTable) -> EfiStatus
satisfies UefiPhysicalEntry::enter {
    let mut workspace: [u64; 20000];
    workspace[0] = 17;
    reject_image(&mut workspace, image_handle)
}

machine reject_image(workspace: &mut [u64; 20000], image_handle: EfiImageHandle) -> EfiStatus {
    workspace[19999] = workspace[0];
    transition workspace[19999] == 17 && image_handle.raw != 0 {
        true -> (EfiStatus { code: 0x8000000000000002 })
        _ -> (EfiStatus { code: 0x8000000000000003 })
    }
}

machine kernel_entry(image: Extent in Granted, storage: Extent in Granted) {
    transition { _ -> retain(image as Extent, storage as Extent) }
    state retain(image: Extent, storage: Extent) {
        transition { _ -> retain(image, storage) }
    }
}
