use omega::language::core::float_operations;
use omega::language::core::option;

// A toolchain generic instantiated by Build belongs to its executable context,
// unlike the same template instantiated only by a Product declaration.
data BuildToken { value: u64; }
machine inspect_build(subject: &Optional<BuildToken>) -> u64 {
    transition subject {
        Optional::Some { value } -> (value.value)
        Optional::None -> (0)
    }
}

data CheckedMath {}
boundary requirement CheckedMath::offset_zero(value: i32) -> i32;

data CheckedMathProvider {}
machine CheckedMathProvider::offset_zero_impl(input: i32) -> i32
satisfies CheckedMath::offset_zero
{
    transition { _ -> input }
}

machine named_slot_count() -> i32 {
    CheckedMath::offset_zero(9)
}

macos_arm64 machine checked_target_capacity() -> u64 {
    let slots: [u8; named_slot_count()] = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    slots.len
}

windows_x86_64 machine checked_target_capacity() -> u64 {
    let slots: [u8; named_slot_count()] = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    slots.len
}

linux_arm64 machine checked_target_capacity() -> u64 {
    let slots: [u8; named_slot_count()] = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    slots.len
}

linux_x86_64 machine checked_target_capacity() -> u64 {
    let slots: [u8; named_slot_count()] = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    slots.len
}

machine slot_count() -> u64 {
    let half: f32 in Saturating = 0.5f32;
    let whole: f32 = Float::add(half, half) as f32;
    // Anonymous arguments and returns each land once, without an f64 detour.
    let precision: f32 = round_trip(8388609.499999999999999);
    // The whole anonymous tree lands once, not each arithmetic operand.
    let anonymous: f32 = 1.0 + 0.000000059604644775390625000001;
    transition whole == 1.0f32 && precision == 8388609.0f32
        && anonymous == 1.00000011920928955078125f32 { true -> 8 _ -> 0 }
}

machine round_trip(value: f32) -> f32 {
    transition value == 8388609.0f32 {
        true -> 8388609.499999999999999
        _ -> 0.0
    }
}

// The initializer's helper reads a later computed declaration. Readiness must
// follow that retained dependency before admitting the helper invocation.
const CHECKED_SLOT_COUNT: u64 = declared_slot_count();
const DECLARED_SLOT_COUNT: u64 = 4 * 2;
machine declared_slot_count() -> u64 { DECLARED_SLOT_COUNT }

machine capacity<Storage, const Capacity: u64>() -> u64
where Storage == [u8; Capacity]
{ Capacity }

machine recovered_capacity() -> u64 { capacity<[u8; 8]>() }

data Buffer<const Capacity: u64> {
    slots: [u8; Capacity];
}

// Inferred instances append attached declarations as well as their data owner.
machine Buffer::length<const Capacity: u64>(buffer: &Buffer<Capacity>) -> u64 {
    Capacity
}

machine synthesized_capacity<const Capacity: u64, Storage>() -> u64
where Storage == Buffer<Capacity>
{ Capacity }

// Settlement creates a concrete data instance before Product bodies complete.
// Its exact symbols must survive that continuation and ordinary field access.
data GenericStorage {
    buffer: Buffer<slot_count()>;
}

data Storage {
    slots: [u8; slot_count()];
    named_slots: [u8; named_slot_count()];
}

machine build(builder: &mut Build) {
    Build::application(builder, "selected_const_array_length_exit");
    let mut storage: Storage = Storage {};
    storage.slots[7] = 63;
    storage.named_slots[8] = 70;
    let mut generic: GenericStorage = GenericStorage {};
    generic.buffer.slots[7] = 91;
    let present: Optional<BuildToken> = Optional::Some { value: BuildToken { value: 8 } };
    let observed: u64 = inspect_build(&present);
    let mut local: Buffer<slot_count()> = Buffer { slots: [0, 0, 0, 0, 0, 0, 0, 0] };
    local.slots[7] = 19;
    let recovered: u64 = recovered_capacity();
    let synthesized: u64 = synthesized_capacity<13>();
    let target_capacity: u64 = checked_target_capacity();
    choose(builder, observed == 8 && target_capacity == 9 && synthesized == 13 && recovered == 8 && CHECKED_SLOT_COUNT == 8 && storage.slots[7] == 63 && storage.named_slots[8] == 70 && generic.buffer.slots[7] == 91 && local.slots[7] == 19);
}

machine choose(builder: &mut Build, correct: bool) {
    transition correct { true -> good(builder) _ -> bad(builder) }
    machine good(builder: &mut Build) {
        Build::bind(builder, macos_arm64::ProgramEntry, main);
        Build::bind(builder, linux_arm64::ProgramEntry, main);
        Build::bind(builder, linux_x86_64::ProgramEntry, main);
        Build::bind(builder, windows_x86_64::ProgramEntry, main);
    }
    machine bad(builder: &mut Build) {
        _ = BuildProduct::entry(&builder.product, "incorrect_build_constant", "macos_arm64::ProgramEntry");
    }
}
