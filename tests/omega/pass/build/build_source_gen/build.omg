// A build program may generate a source file and feed it back:
// `BuildSource::open/read` pulls the fixture bytes, `BuildOutput::
// create/write/include_source` stages `generated.omg` as source for
// the same product, then `complete` settles the required output.
machine build(builder: &mut Build) {
    Build::application(builder, "build_source_gen");
    Build::artifact_only(builder);
    let source_path: BuildPath = BuildSource::resolve(&builder.source, "asset.txt");
    let reader: i32 = BuildSource::open(&builder.source, source_path, 0);
    let mut bytes: [u8; 28];
    _ = BuildSource::read(&builder.source, reader, &mut bytes, 28);
    _ = BuildSource::close(&builder.source, reader);
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "generated.omg");
    let generated: BuildPath = BuildOutput::resolve(&builder.output, "generated.omg");
    let writer: i32 = BuildOutput::create(&mut builder.output, generated, 0);
    _ = BuildOutput::write(&mut builder.output, writer, &bytes);
    _ = BuildOutput::close(&mut builder.output, writer);
    BuildOutput::include_source(&mut builder.output, generated);
    let completion: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, generated);
    settle(builder, completion);
}
machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {}
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "generated source did not seal");
    }
}
