// Typed original entry RAM and activation stack backing have independent disjoint residences.
// This physical protocol witness forwards both views without placed scalar operations.
// Expected exit: 0
use omega::language::core::layout;

public data Registers {
    status: u32;
    transmit: u8;
}

public data RegPlacement {}

machine RegPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        representation: FieldPlan::At { offset: 4 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries,
            entry_count: 2,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 4,
        };
    let access: AccessPlan = AccessPlan::inaccessible(layout);
    transition { _ -> place_status(schema, access) }

    machine place_status(
        schema: Schema,
        access: AccessPlan
    ) -> AccessPlan {
        let status_key: u64 = schema.fields[0].key;
        transition { _ -> place_transmit(
            schema,
            AccessPlan::with(
                access,
                status_key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            )) }
    }

    machine place_transmit(
        schema: Schema,
        access: AccessPlan
    ) -> AccessPlan {
        transition { _ -> finish(
            AccessPlan::with(
                access,
                schema.fields[1].key,
                FieldAccess::External {
                    read: ExternalRead::None,
                    write: true,
                    exposure: Exposure::Exported,
                },
            )) }
    }

    machine finish(
        access: AccessPlan
    ) -> AccessPlan {
        let mut services: [u64; 32];
        services[0] = 7;
        AccessPlan::with_reach(
            access,
            BoundaryReach {
                services: services,
                service_count: 0,
            }
        )
    }
}


machine nested(
    first: &Access<RegPlacement, Registers>,
    second: &mut Access<RegPlacement, Registers>,
    caller: &[u8; 5242880]
) -> u64 crashes Trap {
    let mut resident: [u8; 5242880];
    resident[0] = 7;
    resident[2621440] = 11;
    resident[5242879] = 13;
    transition { _ -> forward(first, second, caller, &resident) }
    machine forward(
        first: &Access<RegPlacement, Registers>,
        second: &mut Access<RegPlacement, Registers>,
        caller: &[u8; 5242880],
        resident: &[u8; 5242880]
    ) -> u64 crashes Trap {
        transition caller[0] == 17 && caller[2621440] == 37 && caller[5242879] == 233
            && resident[0] == 7 && resident[2621440] == 11 && resident[5242879] == 13 {
            true -> done(first, second)
            _ -> bad()
        }
        machine done(first: &Access<RegPlacement, Registers>, second: &mut Access<RegPlacement, Registers>) -> u64 { 31 }
        machine bad() -> u64 crashes Trap { crash Trap; }
    }
}

machine start(first: &Access<RegPlacement, Registers>, second: &mut Access<RegPlacement, Registers>) crashes Trap {
    let mut caller: [u8; 5242880];
    caller[0] = 17;
    caller[2621440] = 37;
    caller[5242879] = 233;
    let observed: u64 = nested(first, second, &caller);
    transition observed == 31 && caller[0] == 17 && caller[2621440] == 37 && caller[5242879] == 233 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
