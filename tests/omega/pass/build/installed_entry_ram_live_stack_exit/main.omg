// Typed original entry RAM and activation stack backing have independent disjoint residences.
// This physical protocol witness forwards both views without placed scalar operations.
// Expected exit: 0
use omega::language::core::layout;

public data Registers {
    status: u32;
    transmit: u8;
}

public data RegPlacement {}

machine RegPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 4 },
    };
    let access: AccessPlan = AccessPlan::inaccessible(&schema);
    transition { _ -> place_status(schema, access, entries) }

    machine place_status(
        schema: Schema,
        access: AccessPlan,
        entries: [FieldEntry; 64]
    ) -> PlacementPlan {
        let status_key: u64 = schema.fields[0].key;
        transition { _ -> place_transmit(
            schema,
            AccessPlan::with(
                access,
                status_key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            ),
            entries
        ) }
    }

    machine place_transmit(
        schema: Schema,
        access: AccessPlan,
        entries: [FieldEntry; 64]
    ) -> PlacementPlan {
        transition { _ -> finish(
            AccessPlan::with(
                access,
                schema.fields[1].key,
                FieldAccess::External {
                    read: ExternalRead::None,
                    write: true,
                    exposure: Exposure::Exported,
                },
            ),
            entries
        ) }
    }

    machine finish(
        access: AccessPlan,
        entries: [FieldEntry; 64]
    ) -> PlacementPlan {
        let mut services: [u64; 32];
        services[0] = 7;
        PlacementPlan {
            layout: Plan {
                entries: entries,
                entry_count: 2,
                size_fixed: 8,
                size_is_dynamic: false,
                align: 4,
            },
            access: access,
            reach: BoundaryReach {
                services: services,
                service_count: 0,
            },
        }
    }
}


machine nested(
    first: &Placed<RegPlacement, Registers>,
    second: &mut Placed<RegPlacement, Registers>,
    caller: &[u8; 5242880]
) -> u64 crashes Trap {
    let mut resident: [u8; 5242880];
    resident[0] = 7;
    resident[2621440] = 11;
    resident[5242879] = 13;
    transition { _ -> forward(first, second, caller, &resident) }
    machine forward(
        first: &Placed<RegPlacement, Registers>,
        second: &mut Placed<RegPlacement, Registers>,
        caller: &[u8; 5242880],
        resident: &[u8; 5242880]
    ) -> u64 crashes Trap {
        transition caller[0] == 17 && caller[2621440] == 37 && caller[5242879] == 233
            && resident[0] == 7 && resident[2621440] == 11 && resident[5242879] == 13 {
            true -> done(first, second)
            _ -> bad()
        }
        machine done(first: &Placed<RegPlacement, Registers>, second: &mut Placed<RegPlacement, Registers>) -> u64 { 31 }
        machine bad() -> u64 crashes Trap { crash Trap; }
    }
}

machine start(first: &Placed<RegPlacement, Registers>, second: &mut Placed<RegPlacement, Registers>) crashes Trap {
    let mut caller: [u8; 5242880];
    caller[0] = 17;
    caller[2621440] = 37;
    caller[5242879] = 233;
    let observed: u64 = nested(first, second, &caller);
    transition observed == 31 && caller[0] == 17 && caller[2621440] == 37 && caller[5242879] == 233 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
