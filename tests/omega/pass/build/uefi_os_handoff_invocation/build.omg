machine build(builder: &mut Build) {
    Build::application(builder, "uefi_os_handoff_invocation");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
    builder.roots.bind(uefi_x86_64::ProgramEntry, Loader::run);
}
