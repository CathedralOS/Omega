use omega::language::core::extent;
use omega_language_std::targets::uefi_x86_64;
use omega_language_std::targets::uefi_x86_64::handoff;

// An OS-loader profile binds the same ProgramEntry storage roots as a
// returning UefiApplication, but its selected entry drives the target's
// authored handoff cycle: `UefiOsHandoffCycle::run` is the bounded
// GetMemoryMap/AllocatePages/FreePages/ExitBootServices custody transfer,
// seeded with the target's explicit stale-key bound and exhaustion status and
// retaining every firmware-written cell on the cycle record beneath this
// frame. The call carries no result: success transfers control to the loaded
// image's entry through the generated `transfer` edge, and bounded stale-key
// exhaustion performs the invocation's firmware return inside the edge. The
// adapter establishes the cycle's `table`/`image` custody beneath this
// package.
pub data Loader {
    cycle: UefiOsHandoffCycle;
}

machine Loader::run(
    &mut self,
    image: Extent in Granted,
    initial_storage: Extent in Granted
)
    reaches UefiBootServices + UefiOsHandoffTermination
    invokes UefiBootServices;
    invokes UefiOsHandoffTermination;
{
    transition { _ -> launch(image as Extent, initial_storage as Extent) }

    // The cyclic machine admits only the bare persistent receiver, so the
    // cycle call moves through `drive`; the granted extents ride this
    // machine's block parameters as plain extents, retained beneath the
    // invocation for the whole cycle life.
    state launch(&mut self, image: Extent, storage: Extent) {
        self.drive();
        transition { _ -> retain(image, storage) }
    }

    state retain(&mut self, image: Extent, storage: Extent) {
        transition { _ -> retain(image, storage) }
    }
}

// The acyclic forwarding edge into the target's authored cycle. `run` is the
// cyclic machine and may only be reached through the bare `self` receiver
// from a cyclic caller; this plain body presents the projected
// `self.cycle` receiver where it is legal.
machine Loader::drive(&mut self)
    reaches UefiBootServices + UefiOsHandoffTermination
    invokes UefiBootServices;
    invokes UefiOsHandoffTermination;
{
    self.cycle.run();
}
