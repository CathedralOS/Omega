// Native UEFI probe: debug port 0xe9 emits A only after both root geometries match.
// Synthetic input grants pin transport, not real firmware ownership.
use omega::language::core::extent;
use omega::language::core::assembly;
use entry_support::targets::uefi_x86_64::entry;

TestRoots satisfies ExtentRootProvider {
    machine grant(root: Extent) -> Extent { root }
}

FirmwareBootstrap satisfies UefiPhysicalEntry {
    machine enter(image_handle: EfiImageHandle, system_table: &EfiSystemTable) -> EfiStatus
    reaches ExtentRootProvider + ProgramStorageEntry
    invokes ExtentRootProvider;
    invokes ProgramStorageEntry;
    requires addr::Bound == 18446744073709551616
    {
        let image: Extent = ExtentRootProvider::grant(Extent { base: 4096, length: 4096 });
        let storage: Extent = ExtentRootProvider::grant(Extent { base: 8192, length: 4096 });
        forward_roots(image, storage);
        EfiStatus { code: 0 }
    }
}

machine forward_roots(image: Extent in Granted, storage: Extent in Granted)
reaches ProgramStorageEntry
invokes ProgramStorageEntry;
{
    ProgramStorageEntry::enter(image, storage);
}

uefi_x86_64 machine selected_continuation(image: Extent in Granted, storage: Extent in Granted)
reaches PortIo
{
    transition image.base == 4096 && image.length == 4096 && storage.base == 8192 && storage.length == 4096 {
        true -> report(image, storage)
        _ -> wrong(image, storage)
    }
    machine report(image: Extent in Granted, storage: Extent in Granted) {
        asm { out 233, 65 }
        transition { _ -> retain(image, storage) }
    }
    machine wrong(image: Extent in Granted, storage: Extent in Granted) {
        asm { out 233, 88 }
        transition { _ -> retain(image, storage) }
    }
    machine retain(image: Extent in Granted, storage: Extent in Granted) {
        transition { _ -> retain(image, storage) }
    }
}

machine alternate_continuation(image: Extent in Granted, storage: Extent in Granted)
reaches PortIo
{
    asm { out 233, 66 }
    transition { _ -> retain(image, storage) }
    machine retain(image: Extent in Granted, storage: Extent in Granted) {
        transition { _ -> retain(image, storage) }
    }
}
