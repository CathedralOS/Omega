machine build(builder: &mut Build) {
    Build::application(builder, "uefi_selected_storage_target_entry");
    Build::depend_as(builder, "entry_support", Source::Path { location: "../../../packages/uefi-storage-entry" });
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, linux_arm64);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, linux_x86_64);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, macos_arm64);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, macos_x86_64);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, windows_x86_64);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, uefi_x86_64);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, cross_platform_cli);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, local_unchecked);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, alpha_bootstrap);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, linux_arm64);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, linux_x86_64);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, macos_arm64);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, macos_x86_64);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, windows_x86_64);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, uefi_x86_64);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, cross_platform_cli);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, local_unchecked);
    Build::select_provider<ProgramStorageEntry, ProgramStorageEntryNativeProvider>(builder, alpha_bootstrap);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_arm64);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_x86_64);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_arm64);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_x86_64);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, windows_x86_64);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, uefi_x86_64);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, cross_platform_cli);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, local_unchecked);
    Build::select_provider<entry_support::UefiPhysicalEntry, FirmwareBootstrap>(builder, alpha_bootstrap);
    Build::bind(builder, uefi_x86_64::ProgramEntry, selected_continuation);
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}
