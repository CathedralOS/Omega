machine build(builder: &mut Build) {
    Build::application(builder, "package_batch_distinct_builds");
    Build::depend_as(builder, "helper", Source::Path { location: "helper" });
    Build::select_provider<helper::Reading, helper::Reader>(builder, linux_arm64);
    Build::select_provider<helper::Reading, helper::Reader>(builder, linux_x86_64);
    Build::select_provider<helper::Reading, helper::Reader>(builder, macos_arm64);
    Build::select_provider<helper::Reading, helper::Reader>(builder, macos_x86_64);
    Build::select_provider<helper::Reading, helper::Reader>(builder, windows_x86_64);
    Build::select_provider<helper::Reading, helper::Reader>(builder, uefi_x86_64);
    Build::select_provider<helper::Reading, helper::Reader>(builder, cross_platform_cli);
    Build::select_provider<helper::Reading, helper::Reader>(builder, local_unchecked);
    Build::select_provider<helper::Reading, helper::Reader>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
