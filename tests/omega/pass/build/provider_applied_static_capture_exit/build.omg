machine build(builder: &mut Build) {
    Build::application(builder, "build_target_provider_local");
    Build::bind(builder, windows_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, second_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, second_entry);
    choose<(21u64 + 8u64)>(builder);
}

// Both designated operands must use this reached helper's captured Tag.
machine choose<const Tag: u64>(builder: &mut Build) {
    Build::select_provider<Reading<Tag>, FirstReading<Tag>>(builder, windows_x86_64);
    Build::select_provider<Reading<Tag>, FirstReading<Tag>>(builder, macos_x86_64);
    Build::select_provider<Reading<Tag>, FirstReading<Tag>>(builder, linux_x86_64);
    Build::select_provider<Reading<Tag>, SecondReading<Tag>>(builder, macos_arm64);
    Build::select_provider<Reading<Tag>, SecondReading<Tag>>(builder, linux_arm64);
}

// Formation is mandatory even though this helper never executes; its valid
// request must not become an active provider selection.
machine unused_selection(builder: &mut Build) {
    Build::select_provider<Reading<8u64>, FirstReading<(8u64 / 1u64)>>(builder, macos_arm64);
}
