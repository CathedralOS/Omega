machine build(builder: &mut Build) {
    Build::package(builder, "reading_provider");
    Build::depend(builder, Source::Path { location: "reading_implementations" });
    Build::select_provider<reading_implementations::main::Reading, reading_implementations::main::FirstReading>(builder, windows_x86_64);
    Build::select_provider<reading_implementations::main::Reading, reading_implementations::main::FirstReading>(builder, macos_x86_64);
    Build::select_provider<reading_implementations::main::Reading, reading_implementations::main::FirstReading>(builder, linux_x86_64);
    Build::select_provider<reading_implementations::main::Reading, reading_implementations::main::SecondReading>(builder, macos_arm64);
    Build::select_provider<reading_implementations::main::Reading, reading_implementations::main::SecondReading>(builder, linux_arm64);
}
