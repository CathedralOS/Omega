machine choose(builder: &mut Build, target: BuildTarget) {
    Build::select_provider<Reading, SecondReading>(builder, target);
}
machine build(builder: &mut Build) {
    Build::application(builder, "provider_target_value_forwarding");
    let target: BuildTarget = macos_arm64;
    choose(builder, target);
    Build::select_provider<Reading, FirstReading>(builder, windows_x86_64, CompositionMode::Fused);
    Build::select_provider<Reading, FirstReading>(builder, linux_x86_64);
    Build::select_provider<Reading, SecondReading>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, second_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, second_entry);
}
