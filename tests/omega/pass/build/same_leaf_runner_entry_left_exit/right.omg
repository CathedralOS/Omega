module right;

use omega_language_std::console;
use omega::language::core::binding;

pub boundary trait Reader { machine read() -> i32; }
pub data Provider {}
machine Provider::read() -> i32 satisfies Reader::read { 37 }

pub data Runner { reader: Binding<Reader>; console: Binding<Console>; }
pub machine Runner::run(&mut self) reaches Reader, Console
invokes Reader;
invokes Console;
{
    let value: i32 = self.reader.read();
    transition value == 37 { true -> deliver(value) _ -> wrong(value) }
    state deliver(&mut self, observed: i32) { self.console.exit_process(observed); }
    state wrong(&mut self, observed: i32) { self.console.exit_process(65); }
}
