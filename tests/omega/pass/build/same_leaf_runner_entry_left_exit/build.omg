// Deployable native canary: every hosted target binds `left::Runner::run`
// through a compiler-issued product-entry description that a build helper
// returns. Both modules declare `Runner::run`, so only the qualified path
// under this package's product frontier tells the two apart.

machine build(builder: &mut Build) {
    Build::application(builder, "same_leaf_runner_entry_left_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<left::Reader, left::ProviderReaderImplementation>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, choose(builder, "macos_arm64::ProgramEntry"));
    Build::bind(builder, linux_arm64::ProgramEntry, choose(builder, "linux_arm64::ProgramEntry"));
    Build::bind(builder, linux_x86_64::ProgramEntry, choose(builder, "linux_x86_64::ProgramEntry"));
    Build::bind(builder, windows_x86_64::ProgramEntry, choose(builder, "windows_x86_64::ProgramEntry"));
}

machine choose(builder: &mut Build, slot: &[u8]) -> ProductEntryRef {
    BuildProduct::entry(&builder.product, "left::Runner::run", slot)
}
