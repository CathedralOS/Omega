// These unrelated declarations must not participate in target-slot selection.
boundary trait MacosApplication {}
boundary trait MacosArm64PhysicalEntry { machine enter() -> u64; }
boundary trait LinuxX86_64Application {}
boundary trait LinuxX86_64PhysicalEntry { machine enter() -> u64; }
boundary trait LinuxArm64Application {}
boundary trait LinuxArm64PhysicalEntry { machine enter() -> u64; }
boundary trait WindowsX86_64Application {}
boundary trait WindowsProcessEntry { machine enter() -> u64; }
boundary trait ProgramStorageEntry { machine enter() -> u64; }

machine main() {}
