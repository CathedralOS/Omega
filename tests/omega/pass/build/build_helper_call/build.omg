// The build machine may call sibling machines in the same file,
// passing `builder` through — declarations made in helpers bind to
// the same activation.
machine build(builder: &mut Build) {
    Build::application(builder, "build_helper_call");
    builder.freestanding = true;
    configure(builder);
}
machine configure(builder: &mut Build) {
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::exclude_physical_authority(builder, PhysicalAuthorityClass::PortIo);
}
