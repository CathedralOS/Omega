machine build(builder: &mut Build) {
    Build::application(builder, "conditional_root_binding");
    choose_entry(builder, true);
}
machine choose_entry(options: &mut Build, enabled: bool) {
    transition {
        enabled -> selected(options)
        _ -> ignored(options)
    }
    machine selected(options: &mut Build) {
        Build::bind(options, windows_x86_64::ProgramEntry, launch);
    }
    machine ignored(options: &mut Build) {
        Build::bind(options, windows_x86_64::ProgramEntry, missing);
    }
}
