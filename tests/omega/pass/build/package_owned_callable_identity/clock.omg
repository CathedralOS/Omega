module clock;
public boundary trait Clock { machine sleep(milliseconds: u32) -> i32 reaches; }
LocalClock satisfies Clock {
    machine sleep(milliseconds: u32) -> i32 reaches { 9 }
}

// Equal callable spellings from different packages retain distinct requirements.
// Expected exit: 0
use other_clock::clock::DependencyClock;
machine main() crashes Trap {
    let local: i32 = Clock::sleep(0);
    transition local == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
