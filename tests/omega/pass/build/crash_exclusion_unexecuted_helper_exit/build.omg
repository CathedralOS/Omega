// An unexecuted helper body grants no behavior exclusion.
machine build(builder: &mut Build) {
    Build::application(builder, "crash_exclusion_unexecuted_helper_exit");
    Build::depend(builder, Source::Path { location: "../../../packages/assert-kit" });
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::CheckingAssertProvider>(builder);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    maybe_exclude(builder, false);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}

machine maybe_exclude(builder: &mut Build, enabled: bool) {
    transition enabled -> exclude(builder), _ -> ();
    machine exclude(builder: &mut Build) {
        Build::exclude_crash(builder, CrashCause::Trap);
    }
}
