machine build(builder: &mut Build) {
    Build::application(builder, "uefi_entry_schema_same_leaf");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
    Build::bind(builder, uefi_x86_64::ProgramEntry, launch);
}
