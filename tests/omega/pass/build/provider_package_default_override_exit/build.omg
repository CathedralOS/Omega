machine build(builder: &mut Build) {
    Build::application(builder, "provider_package_default_override_exit");
    Build::depend(builder, Source::Path { location: "reading_provider" });
    Build::select_provider<reading_provider::main::Reading, OverrideReading>(builder, windows_x86_64);
    Build::select_provider<reading_provider::main::Reading, OverrideReading>(builder, macos_x86_64);
    Build::select_provider<reading_provider::main::Reading, OverrideReading>(builder, linux_x86_64);
    Build::select_provider<reading_provider::main::Reading, OverrideReading>(builder, macos_arm64);
    Build::select_provider<reading_provider::main::Reading, OverrideReading>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, second_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, second_entry);
}
