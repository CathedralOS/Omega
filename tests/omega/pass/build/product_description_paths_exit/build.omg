data OrdinaryPath {}
data Visits { value: u64 in Wrapping; }
machine path(value: &OrdinaryPath, visits: &mut Visits) -> u64 {
    visits.value = visits.value + 1;
    7
}

machine build(builder: &mut Build) {
    Build::application(builder, "product_description_paths_exit");
    let schema: ProductTypeSchema = BuildProduct::schema(&builder.product, "payload::Packet");
    let provider: ProductProviderRef = BuildProduct::provider(&builder.product, "payload::Provider");
    let ordinary: OrdinaryPath = OrdinaryPath {};
    let mut visits: Visits = Visits { value: 0 };
    let schema_path: &[u8] = ProductTypeSchema::path(&schema);
    let provider_path: &[u8] = ProductProviderRef::path(&provider);
    let ordinary_path: u64 = path(&ordinary, &mut visits);
    _ = path(&ordinary, &mut visits);
    _ = ProductTypeSchema::path(&schema);
    _ = ProductProviderRef::path(&provider);
    choose(builder, schema_path == "payload::Packet" && provider_path == "payload::Provider" && ordinary_path == 7 && visits.value == 2);
}

machine choose(builder: &mut Build, correct: bool) {
    transition correct { true -> good(builder) _ -> bad(builder) }
    machine good(builder: &mut Build) {
        Build::bind(builder, macos_arm64::ProgramEntry, main);
        Build::bind(builder, linux_arm64::ProgramEntry, main);
        Build::bind(builder, linux_x86_64::ProgramEntry, main);
        Build::bind(builder, windows_x86_64::ProgramEntry, main);
    }
    machine bad(builder: &mut Build) {
        // Fail during Build, before root-binding discovery can produce a product.
        _ = BuildProduct::entry(&builder.product, "incorrect_description_path", "macos_arm64::ProgramEntry");
    }
}
