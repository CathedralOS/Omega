// Select new code and data descriptors from the exact retained GDT.
// The CPU harness checks selectors, accessed bits, FS/GS bases and neighbors.
// Hosted main is never executed; the harness owns the table until shutdown.
use std::calling;
use omega::language::core::layout;
use omega::language::core::process_exit;


use omega::language::core::assembly;
use omega::language::core::assembly_model;
use omega::language::core::code_segment;
use omega::language::core::data_segment;

// The admitted caller runs at CPL0 with interrupts masked and no asynchronous
// arrivals, debugging, firmware calls or concurrent GDTR/table changes.
public boundary trait SegmentSelectorProbe: Calling<SegmentSelectorProbeCalling> {
    machine enter(buffers: &mut SegmentBuffers) -> u64
    reaches MachineControl + CodeSegmentControl + DataSegmentControl
    invokes CodeSegmentControl
    invokes DataSegmentControl
    crashes Abort;
}
public SegmentSelectorProbeCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 1 && signature.native_parameter_count == 1 && signature.has_result {
            true -> accepted()
            false -> rejected()
        }
        machine accepted() -> BoundaryPlanResult {
            let mut plan: BoundaryEntryPlan;
            plan.call.convention = CallingConvention::SystemVAMD64;
            plan.call.parameter_count = 1;
            plan.call.parameters[0].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rdi, value_byte_offset: 0, byte_size: 8 };
            plan.call.has_result = true;
            plan.call.result.shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.result.location_count = 1;
            plan.call.result.locations[0] = ValueLocation::Register { register: MachineRegister::X86Rax, value_byte_offset: 0, byte_size: 8 };
            plan.call.stack_alignment = 16;
            plan.call.entry_control = EntryControl::CallReturn;
            plan.state.initial_regime = MachineRegime::X86Long64;
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.permitted_transitive_use.instruction_pointer = true;
            plan.state.permitted_transitive_use.stack_pointer = true;
            plan.state.permitted_transitive_use.control_state = true;
            // Reloading CS, DS, ES and SS writes segment state.
            plan.state.permitted_transitive_use.segment_state = true;
            plan.state.stack = EntryStack::ProviderSelected;
            plan.state.preemption = Preemption::NotApplicable;
            BoundaryPlanResult::Accepted { plan: plan }
        }
        machine rejected() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "one borrowed buffer and one u64 result required" } }
        }
    }
}
public SegmentSelectorHandler satisfies SegmentSelectorProbe {
    machine enter(buffers: &mut SegmentBuffers) -> u64
    reaches MachineControl + CodeSegmentControl + DataSegmentControl
    invokes CodeSegmentControl
    invokes DataSegmentControl
    crashes Abort {
        transition exercise(buffers) {
            true -> pass()
            false -> fail()
        }
        machine pass() -> u64 { 0 }
        machine fail() -> u64 { 1 }
    }
}
public data SegmentBuffers {
    before: u64;
    table: [u64; 7];
    after: u64;
    other_table: [u64; 7];
}
machine exercise(buffers: &mut SegmentBuffers) -> bool
reaches MachineControl + CodeSegmentControl + DataSegmentControl
invokes CodeSegmentControl
invokes DataSegmentControl {
    let old_table: [u64; 7] = buffers.table;
    let old_other_table: [u64; 7] = buffers.other_table;
    let old_code: u16 = CodeSegmentControl::selector();
    let old_data: DataSelectors = DataSegmentControl::selectors();
    let wrong_code_table: bool = CodeSegmentControl::reload<7>(&mut buffers.other_table, 24u16);
    let wrong_code_kind: bool = CodeSegmentControl::reload<7>(&mut buffers.table, 32u16);
    let outside_code: bool = CodeSegmentControl::reload<7>(&mut buffers.table, 56u16);
    let code_after_refusals: u16 = CodeSegmentControl::selector();
    let wrong_data_table: bool = DataSegmentControl::reload<7>(&mut buffers.other_table, 32u16);
    let wrong_data_kind: bool = DataSegmentControl::reload<7>(&mut buffers.table, 24u16);
    let outside_data: bool = DataSegmentControl::reload<7>(&mut buffers.table, 56u16);
    let data_after_refusals: DataSelectors = DataSegmentControl::selectors();
    let tables_unchanged: bool = same_table(&old_table, &buffers.table) && same_table(&old_other_table, &buffers.other_table);
    let code_loaded: bool = CodeSegmentControl::reload<7>(&mut buffers.table, 24u16);
    let data_loaded: bool = DataSegmentControl::reload<7>(&mut buffers.table, 32u16);
    let code: u16 = CodeSegmentControl::selector();
    let data: DataSelectors = DataSegmentControl::selectors();
    !wrong_code_table && !wrong_code_kind && !outside_code
        && code_after_refusals == old_code
        && !wrong_data_table && !wrong_data_kind && !outside_data
        && same_data(&old_data, &data_after_refusals)
        && tables_unchanged && code_loaded && data_loaded && code == 24u16
        && data.ds == 32u16 && data.es == 32u16 && data.ss == 32u16
        && data.fs == 0u16 && data.gs == 0u16
}
machine same_table(left: &[u64; 7], right: &[u64; 7]) -> bool {
    left[0] == right[0] && left[1] == right[1] && left[2] == right[2]
        && left[3] == right[3] && left[4] == right[4]
        && left[5] == right[5] && left[6] == right[6]
}

machine same_data(left: &DataSelectors, right: &DataSelectors) -> bool {
    left.ds == right.ds && left.es == right.es && left.ss == right.ss
        && left.fs == right.fs && left.gs == right.gs
}

public data TimerGate { selector: u16; ist: u8; attributes: u8; reserved: u32; }
public TimerGateEntry satisfies PrivateCallbackSlot<TimerGate, TimerGateLayout, SegmentSelectorProbe::enter> {}
public TimerGateLayout satisfies FixedLayout<TimerGate> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 2 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 4 } };
        entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 5 } };
        entries[3] = FieldEntry { key: schema.fields[3].key, representation: FieldPlan::At { offset: 12 } };
        let plan: LayoutPlan = LayoutPlan { entries: entries, entry_count: 4, size_fixed: 16, size_is_dynamic: false, align: 8 };
        let low: LayoutPlan = LayoutPlan::place_private<TimerGateEntry>(plan,
            FieldPlan::Bits { container: 0, container_width: 16, destination_lsb: 0, source_lsb: 0, width: 16 });
        let middle: LayoutPlan = LayoutPlan::place_private<TimerGateEntry>(low,
            FieldPlan::Bits { container: 6, container_width: 16, destination_lsb: 0, source_lsb: 16, width: 16 });
        LayoutPlan::place_private<TimerGateEntry>(middle,
            FieldPlan::Bits { container: 8, container_width: 32, destination_lsb: 0, source_lsb: 32, width: 32 })
    }
}
public GateObserverCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 1 && signature.native_parameter_count == 1
            && signature.has_result && signature.callback_binder_count == 1 && signature.callback_demand_count == 1 {
            true -> accepted(signature)
            _ -> rejected()
        }
        machine accepted(signature: BoundarySignature) -> BoundaryPlanResult {
            let mut plan: BoundaryEntryPlan;
            plan.call.convention = CallingConvention::SystemVAMD64;
            plan.call.parameter_count = 1;
            plan.call.parameters[0].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rdi, value_byte_offset: 0, byte_size: 8 };
            plan.call.has_result = true;
            plan.call.result.shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.result.location_count = 1;
            plan.call.result.locations[0] = ValueLocation::Register { register: MachineRegister::X86Rax, value_byte_offset: 0, byte_size: 8 };
            plan.call.callback_materialization_count = 1;
            plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
            plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
            plan.call.stack_alignment = 16;
            plan.call.entry_control = EntryControl::CallReturn;
            plan.state.initial_regime = MachineRegime::X86Long64;
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.stack = EntryStack::ProviderSelected;
            plan.state.preemption = Preemption::NotApplicable;
            BoundaryPlanResult::Accepted { plan: plan }
        }
        machine rejected() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "one gate and one private timer entry required" } }
        }
    }
}

public data GateEnvelope { before: u64; gate: LayoutStorage<TimerGate, TimerGateLayout>; after: u64; }

public boundary trait NativeGateObserver: Calling<GateObserverCalling> {
    machine observe<machine Handler>(storage: &mut GateEnvelope) -> u64
    requires machine Handler satisfies SegmentSelectorProbe::enter;
    reaches;
}
public boundary trait GatePreparation {
    machine prepare<machine Handler>(storage: &mut GateEnvelope) -> u64
    requires machine Handler satisfies SegmentSelectorProbe::enter;
    reaches NativeGateObserver;
}
CheckedGatePreparation satisfies GatePreparation {
    machine prepare<machine Handler>(storage: &mut GateEnvelope) -> u64
    requires machine Handler satisfies SegmentSelectorProbe::enter;
    reaches NativeGateObserver {
        NativeGateObserver::observe<Handler>(storage)
    }
}
machine start() crashes Trap {
    let mut gate: LayoutStorage<TimerGate, TimerGateLayout>;
    gate.selector = 8u16; gate.ist = 1u8; gate.attributes = 142u8; gate.reserved = 0u32;
    let mut retained: GateEnvelope = GateEnvelope { before: 101, gate: gate, after: 203 };
    let observed: u64 = GatePreparation::prepare<SegmentSelectorHandler::enter>(&mut retained);
    transition observed == 0u64 && retained.before == 101u64 && retained.after == 203u64
        && retained.gate.selector == 8u16 && retained.gate.ist == 1u8
        && retained.gate.attributes == 142u8 && retained.gate.reserved == 0u32 {
        true -> done()
        false -> bad()
    }
    machine done() { ProcessExit::exit_process(0); }
    machine bad() { crash Trap; }
}
