machine build(builder: &mut Build) {
 Build::application(builder, "proof_alias_guarded_helper");
 Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::select_provider<Echo, EchoProvider>(builder, windows_x86_64);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::select_provider<Echo, EchoProvider>(builder, linux_x86_64);
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::select_provider<Echo, EchoProvider>(builder, macos_arm64);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::select_provider<Echo, EchoProvider>(builder, linux_arm64);
 Build::bind(builder, macos_x86_64::ProgramEntry, main);
 Build::select_provider<Echo, EchoProvider>(builder, macos_x86_64);
}
