machine build(builder: &mut Build) {
 Build::application(builder, "conditional_selection");
 transition true { true -> choose(builder) _ -> alternate(builder) }
 machine choose(builder: &mut Build) { Build::select_representation<Token, TokenRepresentation>(builder); Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, macos_arm64::ProgramEntry, main); }
 machine alternate(builder: &mut Build) { Build::select_representation<Token, TokenRepresentation>(builder); Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, macos_arm64::ProgramEntry, main); }
}
