data Buffer<const Capacity: u64> { slots: [u8; Capacity]; }
data ComputedStorage { buffer: Buffer<outer()>; }

machine leaf() -> u64 { 4 }
machine outer() -> u64 {
    let buffer: Buffer<leaf()> = Buffer {};
    buffer.slots.len
}

machine build(builder: &mut Build) {
    Build::application(builder, "const_index_dependency_order_exit");
    let result: ComputedStorage = ComputedStorage {};
    transition result.buffer.slots.len == 4 {
        true -> good(builder)
        _ -> bad(builder)
    }
    state good(builder: &mut Build) {
        builder.roots.bind(macos_arm64::ProgramEntry, main);
        builder.roots.bind(linux_arm64::ProgramEntry, main);
        builder.roots.bind(linux_x86_64::ProgramEntry, main);
        builder.roots.bind(windows_x86_64::ProgramEntry, main);
    }
    state bad(builder: &mut Build) {
        _ = BuildProduct::entry(&builder.product, "incorrect_const_dependency", "macos_arm64::ProgramEntry");
    }
}
