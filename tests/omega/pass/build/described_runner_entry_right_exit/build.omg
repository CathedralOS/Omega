// Deployable native canary: every hosted target binds the entry through a
// compiler-issued product-entry description returned by a build helper,
// never a declaration path re-resolved at the bind site.

machine build(builder: &mut Build) {
    Build::application(builder, "described_runner_entry_right_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(macos_arm64::ProgramEntry, choose(builder, "macos_arm64::ProgramEntry"));
    builder.roots.bind(linux_arm64::ProgramEntry, choose(builder, "linux_arm64::ProgramEntry"));
    builder.roots.bind(linux_x86_64::ProgramEntry, choose(builder, "linux_x86_64::ProgramEntry"));
    builder.roots.bind(windows_x86_64::ProgramEntry, choose(builder, "windows_x86_64::ProgramEntry"));
}

// The helper selects under this package's own product frontier and hands the
// opaque description back; `roots.bind` rejoins it to the exact machine the
// query chose.
machine choose(builder: &mut Build, slot: &[u8]) -> ProductEntryRef {
    builder.product.entry("right::Runner::run", slot)
}
