machine build(builder: &mut Build) {
    Build::application(builder, "component_borrowed_continuation");
    Build::select_provider<Lending, Immediate>(builder, linux_x86_64);
    Build::select_provider<Writing, WordWriter>(builder, linux_x86_64);
    Build::select_provider<Reading, WordReader>(builder, linux_x86_64);
    Build::select_provider<WordObservation, NoWordObservation>(builder, linux_x86_64);
    Build::select_provider<ViaLending, Forwarding>(builder, linux_x86_64);
    Build::select_provider<Observation, NoObservation>(builder, linux_x86_64);
    Build::select_provider<Mutation, NoMutation>(builder, linux_x86_64);
    Build::select_provider<OwnedLending, OwnedImmediate>(builder, linux_x86_64);
    Build::select_provider<SharedLending, SharedImmediate>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Lending, Immediate>(builder, windows_x86_64);
    Build::select_provider<Writing, WordWriter>(builder, windows_x86_64);
    Build::select_provider<Reading, WordReader>(builder, windows_x86_64);
    Build::select_provider<WordObservation, NoWordObservation>(builder, windows_x86_64);
    Build::select_provider<ViaLending, Forwarding>(builder, windows_x86_64);
    Build::select_provider<Observation, NoObservation>(builder, windows_x86_64);
    Build::select_provider<Mutation, NoMutation>(builder, windows_x86_64);
    Build::select_provider<OwnedLending, OwnedImmediate>(builder, windows_x86_64);
    Build::select_provider<SharedLending, SharedImmediate>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Lending, Immediate>(builder, macos_arm64);
    Build::select_provider<Writing, WordWriter>(builder, macos_arm64);
    Build::select_provider<Reading, WordReader>(builder, macos_arm64);
    Build::select_provider<WordObservation, NoWordObservation>(builder, macos_arm64);
    Build::select_provider<ViaLending, Forwarding>(builder, macos_arm64);
    Build::select_provider<Observation, NoObservation>(builder, macos_arm64);
    Build::select_provider<Mutation, NoMutation>(builder, macos_arm64);
    Build::select_provider<OwnedLending, OwnedImmediate>(builder, macos_arm64);
    Build::select_provider<SharedLending, SharedImmediate>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Lending, Immediate>(builder, linux_arm64);
    Build::select_provider<Writing, WordWriter>(builder, linux_arm64);
    Build::select_provider<Reading, WordReader>(builder, linux_arm64);
    Build::select_provider<WordObservation, NoWordObservation>(builder, linux_arm64);
    Build::select_provider<ViaLending, Forwarding>(builder, linux_arm64);
    Build::select_provider<Observation, NoObservation>(builder, linux_arm64);
    Build::select_provider<Mutation, NoMutation>(builder, linux_arm64);
    Build::select_provider<OwnedLending, OwnedImmediate>(builder, linux_arm64);
    Build::select_provider<SharedLending, SharedImmediate>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
