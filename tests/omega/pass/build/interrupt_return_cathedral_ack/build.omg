use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "timer_borrowed_gate_probe");
    Build::depend_as(builder, "std", Source::Path { location: "../../../../../source/library/std" });
    Build::depend_as(builder, "facts", Source::Path { location: "facts" });
    Build::select_representation<InterruptAcknowledgement, isa::x86_64::interrupts::entry::CathedralAcknowledgementRepresentation>(builder);
    Build::select_provider<GatePreparation, CheckedGatePreparation>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind<ProcessExit::exit_process>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "exit", version: "GLIBC_2.2.5" }
    });
    Build::bind<NativeGateObserver::observe>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned { object: "libomega_timer_observer.so", symbol: "timer_observe", version: "OMEGA_TIMER_1" }
    });
    builder.freestanding = true;
}
