data UserProduct {}

// An unrelated selected declaration named entry is ordinary user code.
machine UserProduct::entry(product: &UserProduct, path: &[u8], slot: &[u8]) -> u64 {
    7
}

machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_named_user_machine_exit");
    let product: UserProduct = UserProduct {};
    let marker: u64 = UserProduct::entry(&product, "not_a_declaration", "not_a_slot");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
