// This body must be resolved only when its module is compiled, or during review.
use omega::language::core::layout;

public machine unused() -> u64 {
    // Body-local builtin normalization is implementation work too.
    let invalid_intrinsic: u64 = abs(1, 2);
    let bytes: [u8; 0] = "a";
    9
}

// The declaration is indexed for Build descriptions, but its computed type
// belongs to the unimported Product module, not the Build evaluation program.
data UnusedSlots {
    slots: [u8; unused_slot_count()];
}

data UnusedBuffer<const Capacity: u64> {
    slots: [u8; Capacity];
}

data UnusedGenericStorage {
    buffer: UnusedBuffer<unused_slot_count()>;
}

data UnusedRange<T [copy]> [copy] { value: T; }

// Evaluating a signature's endpoint does not invoke its enclosing machine.
machine unused_endpoint(value: UnusedRange<u64>) -> u64 requires value.value <= unused_slot_count() {
    let bytes: [u8; 0] = "a";
    9
}

machine unused_slot_count() -> u64 {
    8
}

const UNUSED_COUNT: u64 = unused_slot_count();

machine fixed_count<const Count: u64>() -> u64 { Count }

machine unused_static_endpoint(value: UnusedRange<u64>) -> u64 requires value.value <= fixed_count<8>() {
    let bytes: [u8; 0] = "a";
    9
}

// A declaration-side equation does not demand unrelated implementations.
machine unused_capacity<Storage, const Capacity: u64>() -> u64
where Storage == [u8; Capacity]
{ Capacity }

public data UnusedRegisters {
    bytes: [u8; placed_byte_count()];
    nested: InnerPlacement<InnerRegisters>;
}

public machine placed_byte_count() -> u64 { unused_slot_count() }

public data InnerRegisters { status: u32; }
public data InnerPlacement {}

machine InnerPlacement::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 4,
        size_is_dynamic: false,
        align: 4,
    }
}

// Merely discovering another layout record does not demand its policy body.
data UnselectedLayout { value: InvalidPlacement<InnerRegisters>; }
data InvalidPlacement {}
machine InvalidPlacement::plan(schema: Schema) -> Plan {
    let invalid: u64 = abs(1, 2);
    Plan {}
}

public data UnusedPlacement {}

machine UnusedPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        placement: FieldPlan::At { offset: 8 },
    };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan {
            entries: entries,
            entry_count: 2,
            size_fixed: 12,
            size_is_dynamic: false,
            align: 4,
        },
        access: AccessPlan::inaccessible(&schema),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine unused_placed(view: &mut Placed<UnusedPlacement, UnusedRegisters>) -> u64 { 0 }
