machine build(builder: &mut Build) {
    Build::package(builder, "native_component_case_loan_cycle_producer");
    Build::select_provider<Reading, Reader>(builder, windows_x86_64);
    Build::select_provider<Reading, Reader>(builder, linux_x86_64);
    Build::select_provider<Reading, Reader>(builder, macos_arm64);
    Build::select_provider<Reading, Reader>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, component_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, component_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, component_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, component_entry);
}
