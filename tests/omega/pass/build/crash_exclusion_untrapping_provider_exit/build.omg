// Trap is excluded from the product while the selected assertion provider is
// the no-op implementation, so no composed path can trap. ControlFlowCleanup
// is enabled to show the optional optimization does not decide the verdict.
machine build(builder: &mut Build) {
    Build::application(builder, "crash_exclusion_untrapping_provider_exit");
    Build::depend(builder, Source::Path { location: "../../../packages/assert-kit" });
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, linux_arm64);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, linux_x86_64);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, macos_arm64);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, macos_x86_64);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, windows_x86_64);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, uefi_x86_64);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, cross_platform_cli);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, local_unchecked);
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssertProvider>(builder, alpha_bootstrap);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
