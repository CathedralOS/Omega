use omega::language::core::extent;
use omega::language::core::representation;
use omega::language::core::program_image;
use omega::language::core::code_layout;
use std::targets::uefi_x86_64::entry;

data SystemTableHeader {
    signature: u64;
    revision: u32;
    header_size: u32;
    crc: u32;
    reserved: u32;
}
SystemTableRepresentation satisfies OpaqueRepresentation<EfiSystemTable, SystemTableHeader> { }
FirmwareBootstrap satisfies UefiPhysicalEntry {
    UefiPhysicalEntry::enter = firmware_entry;
}

// Repeated observations through a call and field must name the same exact
// executing residence. Image replay additionally verifies the relocation's
// destination against the private partition, not merely nonzero equality.
data ImageObservation { retained_start: addr; }
machine selected_marker(value: u64) -> u64 { value }
machine observe() -> addr reaches ProgramImage {
    ProgramImage::retained_suffix_start()
}
machine firmware_entry(image_handle: EfiImageHandle, system_table: &EfiSystemTable) -> EfiStatus
satisfies UefiPhysicalEntry::enter
reaches ProgramImage {
    let observation: ImageObservation = ImageObservation { retained_start: observe() };
    let direct: addr = ProgramImage::retained_suffix_start();
    let layout: CodeLayout = code_layout<selected_marker>();
    transition direct != 0 && direct == observation.retained_start && layout.entry != 0 {
        true -> (EfiStatus { code: 0x8000000000000002 })
        _ -> (EfiStatus { code: 0x8000000000000003 })
    }
}
machine kernel_entry(image: Extent in Granted, storage: Extent in Granted) {
    transition { _ -> retain(image, storage) }
    machine retain(image: Extent in Granted, storage: Extent in Granted) {
        transition { _ -> retain(image, storage) }
    }
}
