machine build(builder: &mut Build) {
    Build::application(builder, "uefi_image_residence_observation");
    Build::depend_as(builder, "std", Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_arm64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_arm64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, windows_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, uefi_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, cross_platform_cli);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, local_unchecked);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, alpha_bootstrap);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, linux_arm64);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, linux_x86_64);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, macos_arm64);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, macos_x86_64);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, windows_x86_64);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, uefi_x86_64);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, cross_platform_cli);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, local_unchecked);
    Build::select_provider<ProgramImage, ProgramImageNativeProvider>(builder, alpha_bootstrap);
    Build::select_representation<std::EfiSystemTable, SystemTableRepresentation>(builder);
    Build::bind(builder, uefi_x86_64::ProgramEntry, kernel_entry);
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}
