use omega::language::core::binding;

// Admission token for the scheduler capability; the provider's grant route
// issues it WeakFair-qualified.
pub data SchedulerHandle [copy] {}

pub domain SchedulerHandle::WeakFair
satisfies ProgressProfile
established by Scheduler::grant;

pub boundary trait Scheduler {
    machine notify(value: i32)
    terminates;

    machine grant(handle: SchedulerHandle) -> SchedulerHandle in WeakFair;
}

data SchedulerProvider { grant: addr; notify: addr; }

// Notification returns normally. Provider selection does not turn this Unit
// requirement into canonical ProcessExit or establish its progress premise.
// The provider covers every catalogued host: a fixture compiled under the
// corpus's host-selected target finds a complete candidate wherever it runs.
linux_x86_64 machine SchedulerProvider::notify(value: i32)
satisfies Scheduler::notify
via ForeignBinding::Syscall(1);

linux_arm64 machine SchedulerProvider::notify(value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

macos_arm64 machine SchedulerProvider::notify(value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

macos_x86_64 machine SchedulerProvider::notify(value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

windows_x86_64 machine SchedulerProvider::notify(value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

machine SchedulerProvider::grant(handle: SchedulerHandle) -> SchedulerHandle in WeakFair
satisfies Scheduler::grant
via ForeignBinding::VtableField(grant);

data Main {
    scheduler: Binding<Scheduler>;
}

machine Main::main(main: &mut Main)
reaches Scheduler
requires main.scheduler in SchedulerHandle::WeakFair
terminates
{
    main.scheduler.notify(65);
}

machine build(builder: &mut Build) {
    Build::application(builder, "provider_receiver_progress_installation");
    builder.select_provider<Scheduler, SchedulerProvider>();
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::main);
}
