// Admission token for the scheduler capability; the provider's grant route
// issues it WeakFair-qualified.
// The opaque receipt has a native wire carrier; only the grant route
// establishes WeakFair membership.
public data SchedulerHandle [copy] { identity: u64; }

public domain SchedulerHandle::WeakFair
satisfies ProgressProfile
established by Scheduler::grant;

public boundary trait Scheduler {
    machine notify(provider: &SchedulerProvider, handle: SchedulerHandle, value: i32)
    reaches
    requires handle in SchedulerHandle::WeakFair
    terminates;

    machine grant(provider: &SchedulerProvider, handle: SchedulerHandle) -> SchedulerHandle in WeakFair reaches;
}

public data SchedulerProvider { grant: addr; notify: addr; }

// Notification returns normally. Provider selection does not turn this Unit
// requirement into canonical ProcessExit or establish its progress premise.
// The provider covers every catalogued host: a fixture compiled under the
// corpus's host-selected target finds a complete candidate wherever it runs.
linux_x86_64 machine SchedulerProvider::notify(provider: &SchedulerProvider, handle: SchedulerHandle, value: i32)
satisfies Scheduler::notify
via ForeignBinding::Syscall(1);

linux_arm64 machine SchedulerProvider::notify(provider: &SchedulerProvider, handle: SchedulerHandle, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

macos_arm64 machine SchedulerProvider::notify(provider: &SchedulerProvider, handle: SchedulerHandle, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

macos_x86_64 machine SchedulerProvider::notify(provider: &SchedulerProvider, handle: SchedulerHandle, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

windows_x86_64 machine SchedulerProvider::notify(provider: &SchedulerProvider, handle: SchedulerHandle, value: i32)
satisfies Scheduler::notify
via ForeignBinding::VtableField(notify);

machine SchedulerProvider::grant(provider: &SchedulerProvider, handle: SchedulerHandle) -> SchedulerHandle in WeakFair
satisfies Scheduler::grant
via ForeignBinding::VtableField(grant);

data Main {
    provider: SchedulerProvider;
    scheduler: SchedulerHandle;
}

machine Main::notify_fair(provider: &SchedulerProvider, handle: SchedulerHandle)
reaches Scheduler
requires handle in SchedulerHandle::WeakFair
terminates;
{
    Scheduler::notify(provider, handle, 65);
}

machine Main::main(main: &mut Main)
reaches Scheduler
{
    let granted: SchedulerHandle in SchedulerHandle::WeakFair = Scheduler::grant(&main.provider, main.scheduler);
    Main::notify_fair(&main.provider, granted);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Scheduler
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
