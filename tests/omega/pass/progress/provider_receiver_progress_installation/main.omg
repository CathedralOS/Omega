boundary trait Scheduler {
    machine notify(&self, value: i32)
    requires self in WeakFair
    terminates;

    machine grant(scheduler: Scheduler) -> Scheduler in WeakFair;
}

domain Scheduler::WeakFair
satisfies ProgressProfile
established by Scheduler::grant;

data SchedulerProvider { grant: addr; }

// Notification returns normally. Provider selection does not turn this Unit
// requirement into canonical ProcessExit or establish its progress premise.
linux_x86_64 machine SchedulerProvider::notify(&self, value: i32)
satisfies Scheduler::notify
via Binding::Syscall(1);

machine SchedulerProvider::grant(scheduler: Scheduler) -> Scheduler in WeakFair
satisfies Scheduler::grant
via Binding::VtableField(grant);

data Main {
    scheduler: Scheduler;
}

machine Main::main(&mut self)
reaches Scheduler
requires self.scheduler in Scheduler::WeakFair
terminates
{
    self.scheduler.notify(65);
}
