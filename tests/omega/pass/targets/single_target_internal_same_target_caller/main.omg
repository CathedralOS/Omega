// An unrealized target's caller resolves its own target's helper. Both
// bodies are checked and retained, without demanding UEFI realization on a
// development host. The portable-caller negative controls pin the distinct
// obligation when a realized caller demands a missing target body.
use omega_language_std::console;

data Helper { seed: i32; }

uefi_x86_64 machine Helper::paradigm_internal(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}

// The caller and callee belong to the same target.
uefi_x86_64 machine Helper::paradigm_caller(helper: &Helper) -> i32 {
    transition { _ -> (Helper::paradigm_internal(helper)) }
}

data Main { helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = main.helper.seed;
    transition a == 0 { true -> good(main) _ -> bad(main, 71) }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code2: i32) { Console::exit_process(code2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
