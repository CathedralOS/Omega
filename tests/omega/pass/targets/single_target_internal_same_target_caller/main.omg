// The EXEMPTION half of the inert-sibling rule, which nothing exercised.
//
// A target-scoped machine implemented by exactly ONE non-selected target is
// that target's paradigm internal, and the filter drops it "with its
// callers". A caller is exempt exactly when it is scoped to that SAME target
// and goes inert alongside the callee -- both vanish together and the
// program compiles and runs. `fail/targets/single_target_internal_{,statement_}caller_rejected`
// pin the other direction, a SURVIVING portable caller, which must reject.
//
// `pass/targets/single_target_internal_machine_skipped` was the only positive
// fixture here and it does NOT reach this rule twice over: it never calls its
// helper at all, and it scopes to `demo_target`, a name resolving to no real
// target, which is dropped before resolution rather than surviving as an
// inert sibling. This file uses a REAL non-selected profile and an actual
// call, so the exemption is what is being tested rather than an unused
// declaration.
//
// `uefi_x86_64` is the portable choice for the same reason its fail siblings
// give: a real profile that is nobody's development host, so both bodies are
// inert on every host this canary runs on.
use omega_language_std::console;
use omega::language::core::binding;

data Helper { seed: i32; }

uefi_x86_64 machine Helper::paradigm_internal(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}

// The caller: scoped to the SAME non-selected target, so it is filtered out
// alongside the callee instead of naming a body this build never realizes.
uefi_x86_64 machine Helper::paradigm_caller(helper: &Helper) -> i32 {
    transition { _ -> (Helper::paradigm_internal(helper)) }
}

data Main { console: Binding<Console>; helper: Helper; }

machine Main::main(&mut self) reaches Console {
    let a: i32 = self.helper.seed;
    transition a == 0 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code2: i32) { self.console.exit_process(code2); }
}
