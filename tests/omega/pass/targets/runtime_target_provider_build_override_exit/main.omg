// An explicit Build choice replaces every target's ordinary default as one
// complete map, including a method neither entry body invokes.
boundary trait Pick {
    machine choose() -> i32 reaches;
    machine spare() -> i32 reaches;
}
FirstMap satisfies Pick {
    machine choose() -> i32 { first() }
    machine spare() -> i32 { spare_realization() }
}
SecondMap satisfies Pick {
    machine choose() -> i32 { second() }
    machine spare() -> i32 { spare_realization() }
}
OverrideMap satisfies Pick {
    machine choose() -> i32 { override_choice() }
    machine spare() -> i32 { spare_realization() }
}
machine first() -> i32 { 1 }
machine second() -> i32 { 2 }
machine override_choice() -> i32 { 3 }
machine spare_realization() -> i32 { 44 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Pick, FirstMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Pick, FirstMap>(defaults);
}
windows_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Pick, SecondMap>(defaults);
}

data Main {}
macos_arm64 machine Main::main() reaches Pick crashes Trap {
    let selected: i32 = Pick::choose();
    transition selected == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

linux_x86_64 machine Main::main() reaches Pick crashes Trap {
    let selected: i32 = Pick::choose();
    transition selected == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
windows_x86_64 machine Main::main() reaches Pick crashes Trap {
    let selected: i32 = Pick::choose();
    transition selected == 3 { true -> done() _ -> bad() }
    machine done() { crash Trap; }
    machine bad() {}
}
