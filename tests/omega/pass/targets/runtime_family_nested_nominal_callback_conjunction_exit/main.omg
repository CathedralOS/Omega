trait Handler<Value> { machine call() -> bool; }
machine yes() -> bool satisfies Handler<u64>::call, Handler<bool>::call { true }

// This higher-order body requires no nominal authority from its input, so
// either member's stronger named callback promise can be passed to it.
machine invoke<machine Callback>() -> bool
where machine Callback() -> bool;
{ Callback() }

linux_arm64 machine choose<machine Routine>() -> bool
where machine Routine<machine Inner>() -> bool
where machine Inner satisfies Handler<u64>::call;
{ Routine<yes>() }

linux_x86_64 machine choose<machine Operation>() -> bool
where machine Operation<machine Nested>() -> bool
where machine Nested satisfies Handler<bool>::call;
{ Operation<yes>() }

macos_arm64 machine choose<machine Schema>() -> bool
where machine Schema<machine Chosen>() -> bool
where machine Chosen satisfies Handler<bool>::call;
{ Schema<yes>() }

windows_x86_64 machine choose<machine Action>() -> bool
where machine Action<machine Selected>() -> bool
where machine Selected satisfies Handler<u64>::call;
{ Action<yes>() }

machine main() crashes Trap {
    transition choose<invoke>() {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
