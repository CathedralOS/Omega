// Expected exit: 0. Two provider applications meet the non-first member's
// guarantee without confusing its demand with the head's weaker contract.
machine yes<Value>(value: &Value) -> bool ensures result { true }

linux_arm64 machine choose<Value, machine Selected>(value: &Value) -> bool
where machine Selected(argument: &Value) -> bool ensures true;
{ Selected(value) }

macos_arm64 machine choose<Element, machine Callback>(value: &Element) -> bool
where machine Callback(argument: &Element) -> bool ensures result;
{ Callback(value) }

linux_x86_64 machine choose<Element, machine Callback>(value: &Element) -> bool
where machine Callback(argument: &Element) -> bool ensures result;
{ Callback(value) }

machine main() crashes Trap {
    let number: u64 = 42u64;
    let flag: bool = false;
    let first: bool = choose<u64, yes>(&number);
    let second: bool = choose<bool, yes>(&flag);
    transition first && second {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
