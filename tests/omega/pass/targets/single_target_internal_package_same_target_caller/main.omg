// Same-target calls also retain exact family custody across a dependency.
// The UEFI caller and helper remain checked but need no host realization.
// The portable shared() call proves the package links into this executable.
use omega_language_std::console;
use paradigm_internals::paradigm;

data Main { helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = Helper::shared();
    transition a == 7 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code2: i32) { Console::exit_process(code2); }
}
