// The DEPENDENCY-PACKAGE half of the inert-sibling EXEMPTION, the positive
// twin of `pass/targets/single_target_internal_same_target_caller`.
//
// `paradigm_internals` ships `Helper::paradigm_caller`, a `uefi_x86_64` caller
// of the `uefi_x86_64` `Helper::paradigm_internal`: a caller scoped to the
// callee's own unrealized target goes inert alongside it, so both vanish
// together and the program compiles and runs. The fail siblings pin the other
// direction through the same package -- a SURVIVING portable caller rejects.
// This program exits 70 on every host (`expected_native_exit.txt`), so the
// exemption is asserted by execution, not merely by an unused declaration
// surviving the filter.
//
// The portable `Helper::shared` call proves the dependency links into the
// realized program while its `uefi_x86_64` internals drop silently.
use omega_language_std::console;
use omega::language::core::binding;
use paradigm_internals::paradigm;

data Main { console: Binding<Console>; helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = main.helper.shared();
    transition a == 7 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code2: i32) { main.console.exit_process(code2); }
}
