// THE FIELD MODEL (extern brief SS12.1, decided 2026-07-04): the M1 greeting
// re-authored with an external leaf attached to the vtable data type -- the
// binding names the fn-ptr FIELD and the LAYOUT computes its
// offset. No magic slot count: `reset` is a leading field (headers fall out
// free), `output_string` lands at +8, and the emitted dispatch is
// byte-identical to the retired ordinal original --
// `mov rax, [rcx+8]; call rax` (the suite test pins those bytes in the
// cross-compiled PE on ANY host).
pub boundary trait TextOutput { machine output_string(this: addr, text: addr); }
data EfiTextOutputProtocol {
    reset: addr;
    output_string: addr;
}
uefi_x86_64 machine EfiTextOutputProtocol::text_output_leaf(this: addr, text: addr) satisfies TextOutput::output_string via Binding::VtableField(output_string);
pub data EfiSystemTable {
    hdr_signature: u64; hdr_revision: u32; hdr_header_size: u32; hdr_crc: u32; hdr_reserved: u32;
    firmware_vendor: addr; firmware_revision: u32; fw_pad: u32;
    console_in_handle: addr; con_in: addr; console_out_handle: addr; con_out: addr;
}
pub data Main { out: TextOutput; msg: [u16; 19]; }
boundary machine Main::main(&self, handle: addr, table: &EfiSystemTable) -> i32
reaches TextOutput
invokes TextOutput;
{
    self.msg = utf16"Hello from Omega\r\n\0";
    let con_out: addr = table.con_out;
    self.out.output_string(con_out, &self.msg);
    transition { _ -> (0) }
}
