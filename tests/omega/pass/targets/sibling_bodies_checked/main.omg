// Target-scoped bodies of every target are resolved, typed, and checked on
// every host. A `demo_target` body that calls its own target's helper binds
// to that helper (no other target declares it), and the program still
// compiles and runs because the siblings are pruned once checking has
// committed. `demo_target` and `demo_target2` resolve to no real target, so
// both bodies are siblings on every host, and the two targets implement
// different names so no contract row is missing for the selected target.
use omega_language_std::console;
use omega::language::core::binding;

data Helper { seed: i32; }

demo_target machine Helper::paradigm_internal(&self) -> i32 {
    transition { _ -> 63 }
}

demo_target machine Helper::paradigm_entry(&self) -> i32 {
    let inner: i32 = self.paradigm_internal();
    transition { _ -> inner }
}

demo_target2 machine Helper::other_entry(&self) -> i32 {
    transition { _ -> 64 }
}

data Main { console: Binding<Console>; helper: Helper; }

machine Main::main(&mut self) reaches Console {
    let a: i32 = self.helper.seed;
    transition a == 0 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code2: i32) { self.console.exit_process(code2); }
}
