// Microsoft x64's fifth positional argument is a pointer in the incoming
// stack-argument area when the declared record is passed by reference.
data Pair { first: u64; second: u64; }
data Main { observed: Pair; }

boundary machine Main::main(
    &mut self,
    first: u64,
    second: u64,
    third: u64,
    fourth: u64,
    input: Pair
) -> i32 {
    self.observed = input;
    transition { _ -> (0) }
}
