// MS x64's fifth parameter is resident after the return address and 32-byte
// shadow space. This compile-only canary pins normalized stack-argument
// lowering; firmware itself invokes EFI main with only its standard pair.
pub data Main { observed: addr; }

boundary machine Main::main(
    &mut self,
    first: addr,
    second: addr,
    third: addr,
    fourth: addr,
    fifth: addr
) -> i32 {
    self.observed = fifth;
    transition { _ -> (0) }
}
