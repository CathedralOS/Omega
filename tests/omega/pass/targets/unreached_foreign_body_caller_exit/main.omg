// Portable callers of a body only UEFI supplies are checked on every build,
// but only the realized product's reach demands an implementation. Nothing
// the bound entry reaches calls `Helper::firmware_only`: `firmware_bridge` is
// never called, and `FirmwareValue` is a provider the build does not select.
// A hosted realization keeps both as checked source and the program runs. A
// dependency package's unused portable surface is the same case: checking it
// for a target that lacks some of its leaves realizes none of them.
// `fail/targets/reached_foreign_family_relay_rejected` and
// `fail/targets/reached_foreign_body_through_selected_provider_rejected` are
// the reached twins.
use omega_language_std::console;

data Helper { seed: i32; }

uefi_x86_64 machine Helper::firmware_only(input: i32) -> i32 {
    transition { _ -> 63 }
}

// Portable, and never called.
machine Helper::firmware_bridge(input: i32) -> i32 {
    transition { _ -> (Helper::firmware_only(input)) }
}

public data Value {}
public boundary requirement Value::read(input: i32) -> i32;

// The provider the build selects for `Value::read`.
public data PlainValue {}
machine PlainValue::read(input: i32) -> i32
satisfies Value::read { input }

// A competing provider the build never selects.
public data FirmwareValue {}
machine FirmwareValue::read(input: i32) -> i32
satisfies Value::read { Helper::firmware_only(input) }

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let selected: i32 = Value::read(70);
    Console::exit_process(selected);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
