// This 40-byte record is deliberately wider than the boundary handoff's
// special 32-byte shape ceiling. AAPCS64 must classify it through the general
// fixed-aggregate path and copy the x0 pointee into runtime-frame storage.
data FiveWords {
    first: u64;
    second: u64;
    third: u64;
    fourth: u64;
    fifth: u64;
}

data Main { observed: u64; }

boundary machine Main::main(&mut self, value: FiveWords) -> i32 {
    self.observed = value.first + value.second + value.third
        + value.fourth + value.fifth;
    transition { _ -> (0) }
}
