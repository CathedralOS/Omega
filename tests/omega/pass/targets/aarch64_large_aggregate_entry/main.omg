// A sole fixed aggregate above 16 bytes arrives indirectly under AAPCS64: x0
// points at caller-owned storage, which the entry prologue copies into the
// machine's runtime frame before dispatch begins. This must not take the
// Microsoft-x64 boundary handoff's exceptional word-spreading path.
pub data Triple {
    first: u64;
    second: u64;
    third: u64;
}

pub data Main { observed: u64; }

boundary machine Main::main(&mut self, value: Triple) -> i32 {
    self.observed = value.first + value.second + value.third;
    transition { _ -> (0) }
}
