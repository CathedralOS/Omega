// None of these bodies is reached from main. Terminal still owns every
// implementation, including unrequested and uncatalogued deployment tags.
// The value bodies call the delta body for their own target, not the head.
// The unrealized bodies also keep their conformance to an uncalled boundary.
data Helper { seed: u32; }
trait Value<T> { machine unrealized(helper: &T) -> u32; }
data Unused {}
boundary requirement Unused::read(helper: &Helper) -> u32;

linux_x86_64 machine Helper::delta(helper: &Helper) -> u32 {
    transition { _ -> 63 }
}
macos_arm64 machine Helper::delta(helper: &Helper) -> u32 {
    transition { _ -> 7 }
}
uefi_x86_64 machine Helper::delta(helper: &Helper) -> u32 {
    transition { _ -> 31 }
}

linux_x86_64 machine Helper::value(helper: &Helper) -> u32 {
    transition { _ -> Helper::delta(helper) }
}
macos_arm64 machine Helper::value(helper: &Helper) -> u32 {
    transition { _ -> Helper::delta(helper) }
}
uefi_x86_64 machine Helper::value(helper: &Helper) -> u32 {
    transition { _ -> Helper::delta(helper) }
}

archive_target machine Helper::unrealized(helper: &Helper) -> u32
satisfies Value<Helper>::unrealized, Unused::read {
    transition { _ -> 19 }
}
reserved_target machine Helper::unrealized(helper: &Helper) -> u32
satisfies Value<Helper>::unrealized, Unused::read {
    transition { _ -> 23 }
}

// An unrequested cyclic body is checked and retained too. It must not become
// execution demand or require a current optimizer body in another deployment.
archive_target machine Helper::cycle(helper: &Helper) -> u32 {
    transition { _ -> step(helper) }
    machine step(helper: &Helper) -> u32 {
        transition { _ -> step(helper) }
    }
}

machine main() { }
