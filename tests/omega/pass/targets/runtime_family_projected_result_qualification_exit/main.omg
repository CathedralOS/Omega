// A portable result promises the child's qualification in its data declaration.
// Selected bodies transport that membership and the same linear owner together.
use omega::language::core::drop;

public data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
public domain Receipt::Issued;
data Slot { receipt: Receipt in Receipt::Issued; }

machine issue(code: u64) -> Receipt in Receipt::Issued {
    let issued: Receipt in Receipt::Issued = Receipt { code: code };
    issued
}

boundary trait SelectedProduce {
    machine produce(code: u64) -> Slot reaches
;
}
CheckedProduce satisfies SelectedProduce {
    machine produce(code: u64) -> Slot
{ Slot { receipt: issue(code) } }
}




machine consume(receipt: Receipt in Receipt::Issued) -> bool {
    let correct: bool = receipt.code == 42;
    drop(receipt);
    correct
}

machine main() crashes Trap {
    let slot: Slot = SelectedProduce::produce(42);
    let correct: bool = consume(slot.receipt);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
