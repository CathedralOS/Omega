// Portable callers observe two selected family heads. Each value body calls
// its own exact delta sibling; all four delta bodies return different values.
// Shared bounds justify each member's arithmetic. The portable comparison
// observes values without using a private target result as a guarantee. Each
// target's entry supplies its exact authored pair, so choosing another whole
// target cohort cannot accidentally satisfy the oracle.
data Helper { seed: u64; }

linux_x86_64 machine Helper::delta(helper: &Helper) -> u64
ensures result <= 404;
{ 101 }
windows_x86_64 machine Helper::delta(helper: &Helper) -> u64
ensures result <= 404;
{ 202 }
macos_arm64 machine Helper::delta(helper: &Helper) -> u64
ensures result <= 404;
{ 303 }
linux_arm64 machine Helper::delta(helper: &Helper) -> u64
ensures result <= 404;
{ 404 }

linux_x86_64 machine Helper::value(helper: &Helper) -> u64
ensures result <= 411;
{ Helper::delta(helper) + 7 }
windows_x86_64 machine Helper::value(helper: &Helper) -> u64
ensures result <= 411;
{ Helper::delta(helper) + 7 }
macos_arm64 machine Helper::value(helper: &Helper) -> u64
ensures result <= 411;
{ Helper::delta(helper) + 7 }
linux_arm64 machine Helper::value(helper: &Helper) -> u64
ensures result <= 411;
{ Helper::delta(helper) + 7 }

data Main { helper: Helper; }
machine Main::check(main: &mut Main, expected_delta: u64, expected_value: u64)
crashes Trap {
    let value: u64 = Helper::value(&main.helper);
    let delta: u64 = Helper::delta(&main.helper);
    transition delta == expected_delta && value == expected_value {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

linux_x86_64 machine Main::main(main: &mut Main) crashes Trap {
    Main::check(main, 101, 108);
}
windows_x86_64 machine Main::main(main: &mut Main) crashes Trap {
    Main::check(main, 202, 209);
}
macos_arm64 machine Main::main(main: &mut Main) crashes Trap {
    Main::check(main, 303, 310);
}
linux_arm64 machine Main::main(main: &mut Main) crashes Trap {
    Main::check(main, 404, 411);
}

// The entry owns ordinary local state; selection supplies no context.
linux_x86_64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

windows_x86_64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

macos_arm64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

linux_arm64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
