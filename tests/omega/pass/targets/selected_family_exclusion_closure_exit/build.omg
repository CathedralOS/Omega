machine build(builder: &mut Build) {
    Build::select_provider<SelectedHelper, CheckedHelper>(builder, linux_x86_64);
    Build::select_provider<SelectedHelper, CheckedHelper>(builder, windows_x86_64);
    Build::select_provider<SelectedHelper, CheckedHelper>(builder, macos_arm64);
    Build::select_provider<SelectedHelper, CheckedHelper>(builder, linux_arm64);

    Build::application(builder, "selected_family_exclusion_closure_exit");
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
