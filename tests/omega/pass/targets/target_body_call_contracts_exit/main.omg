// Each target's body must keep its calls to that target's private helpers.
// The portable caller selects run(), whose public contract is the same.
data Helper { seed: u64; }

linux_x86_64 machine Helper::value(helper: &Helper, input: u64) -> u64
requires input == 1;
{ 42 }
windows_x86_64 machine Helper::value(helper: &Helper, input: u64) -> u64
requires input == 2;
{ 42 }
macos_arm64 machine Helper::value(helper: &Helper, input: u64) -> u64
requires input == 3;
{ 42 }
linux_arm64 machine Helper::value(helper: &Helper, input: u64) -> u64
requires input == 4;
{ 42 }

linux_x86_64 machine Helper::run(helper: &Helper) -> u64 { Helper::value(helper, 1) }
windows_x86_64 machine Helper::run(helper: &Helper) -> u64 { Helper::value(helper, 2) }
macos_arm64 machine Helper::run(helper: &Helper) -> u64 { Helper::value(helper, 3) }
linux_arm64 machine Helper::run(helper: &Helper) -> u64 { Helper::value(helper, 4) }

data Main { helper: Helper; }
machine Main::main(main: &mut Main) crashes Trap {
    let value: u64 = Helper::run(&main.helper);
    transition value == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
