// A target member's ranked self-transition stays inside that member. The
// tail `drain(...)` names the machine, not a state; sibling binding must
// retarget it to the same target's member as it does for state calls, or
// the member's rank cycle runs through the bodyless family interface and
// the member has no executable body.
use omega_language_std::console;

windows_x86_64 machine drain(value: u64, fuel: u64) -> u64
terminates by fuel;
{
    transition fuel > 0 && value > 0 {
        true -> drain(value - 1, fuel - 1)
        _ -> done(value)
    }
    state done(value: u64) -> u64 { value }
}
linux_x86_64 machine drain(value: u64, fuel: u64) -> u64
terminates by fuel;
{
    transition fuel > 0 && value > 0 {
        true -> drain(value - 1, fuel - 1)
        _ -> done(value)
    }
    state done(value: u64) -> u64 { value }
}
linux_arm64 machine drain(value: u64, fuel: u64) -> u64 { 2 }
macos_arm64 machine drain(value: u64, fuel: u64) -> u64 { 2 }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let left: u64 = drain(5, 3);
    transition left == 2 {
        true -> good()
        false -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(72); }
}
