// The DIRECT entry-ref-param faces (task #37): a GUARD SUBJECT and a
// MACHINE-TARGET assignment reading `table.<field>` with NO manual let. Both
// used to fold FLAT (slot 8 + field offset read from the FRAME -- silent
// garbage; report: `frame_storage@72`). The ref-param-member hoist now
// materializes each read into a slotted `let` that lowers through the
// boot-verified pointee path, and the state-values MATERIALIZATION rule keeps
// the temp from folding back:
//   guard  `table.firmware_revision == 0` -> pointee frame@8 +32 (4 bytes)
//   direct `self.c = table.con_out`       -> pointee frame@8 +64 into the
//                                            temp slot, then slot -> machine.
//   transition arg `check_p(table.con_in)` -> pointee frame@8 +48 (verified
//                                            working; locked here).
// The dedicated suite test asserts the report shows the pointee derefs and no
// flat slot+field read.
pub data EfiSystemTable {
    hdr_signature: u64;
    hdr_revision: u32;
    hdr_header_size: u32;
    hdr_crc: u32;
    hdr_reserved: u32;
    firmware_vendor: addr;
    firmware_revision: u32;
    fw_pad: u32;
    console_in_handle: addr;
    con_in: addr;
    console_out_handle: addr;
    con_out: addr;
}
pub data Main {
    c: addr;
}
boundary machine Main::main(&mut self, handle: addr, table: &EfiSystemTable) -> i32 {
    self.c = table.con_out;
    transition table.firmware_revision == 0 {
        true -> check_p(table.con_in)
        false -> check_p(table.con_in)
    }
    state check_p(&mut self, p: addr) -> i32 {
        transition p == 0 {
            true -> check_c()
            false -> check_c()
        }
    }
    state check_c(&mut self) -> i32 {
        transition self.c == 0 {
            true -> missing()
            false -> present()
        }
    }
    state missing(&mut self) -> i32 { transition { _ -> (4) } }
    state present(&mut self) -> i32 { transition { _ -> (5) } }
}
