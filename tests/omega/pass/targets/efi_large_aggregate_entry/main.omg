// Microsoft x64 by-reference aggregate entry pin: the first scalar occupies
// RCX, the record pointer occupies RDX, and the following scalar remains in R8.
data Triple { first: u64; second: u64; third: u64; }
data Main { observed: Triple; }

boundary machine Main::main(
    &mut self,
    before: u64,
    input: Triple,
    after: u64
) -> i32 {
    self.observed = input;
    transition { _ -> (0) }
}
