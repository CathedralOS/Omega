use omega::language::core::float_operations;

// One scalar consumes rdi. The following INTEGER/SSE record consumes rsi and
// xmm0 atomically; the trailing scalar float independently advances to xmm1.
pub data MixedPair where integer <= 100 {
    integer: u64;
    floating: f64;
}

pub data Main { observed_integer: u64; observed_float: f64; }

boundary machine Main::main(
    main: &mut Main,
    tag: u64,
    pair: MixedPair,
    tail: f64
) -> i32
requires
    tag <= 100;
{
    main.observed_integer = tag + pair.integer;
    main.observed_float = pair.floating + tail;
    transition { _ -> (0) }
}
