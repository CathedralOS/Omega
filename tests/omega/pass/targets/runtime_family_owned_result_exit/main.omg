// A portable family returns a fresh linear owner through ordinary result
// custody. Observation must not grant a second owner or lose the cleanup.
use omega::language::core::drop;
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}

boundary trait SelectedProduce {
    machine produce(code: u64) -> Receipt reaches
;
}
CheckedProduce satisfies SelectedProduce {
    machine produce(code: u64) -> Receipt
{ Receipt { code: code } }
}




machine main() crashes Trap {
    let receipt: Receipt = SelectedProduce::produce(42);
    let correct: bool = receipt.code == 42;
    drop(receipt);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
