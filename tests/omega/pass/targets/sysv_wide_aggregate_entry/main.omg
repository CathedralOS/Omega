// A five-word record exceeds both the SysV register ceiling and the separate
// 32-byte Microsoft boundary-handoff exception. It arrives inline on the
// incoming SysV stack and every fragment is copied into runtime storage.
pub data WideRecord {
    first: u64 [0..=100];
    second: u64 [0..=100];
    third: u64 [0..=100];
    fourth: u64 [0..=100];
    fifth: u64 [0..=100];
}
pub data Main { observed: u64; }
boundary machine Main::main(&mut self, value: WideRecord) -> i32 {
    self.observed = value.first + value.second + value.third + value.fourth + value.fifth;
    transition { _ -> (0) }
}
