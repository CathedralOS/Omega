data Item { code: u64; }
trait Handler<Value, Tag> { machine call(value: &Value, number: u64) -> bool; }
trait Predicate<Value> { machine evaluate(value: &Value, number: u64) -> bool; }

machine matches(value: &Item, number: u64) -> bool
satisfies Handler<Item, u64>::call, Handler<Item, bool>::call, Predicate<Item>::evaluate
{ value.code == number }

linux_arm64 machine choose<Value, machine Selected>(value: &Value) -> bool
where machine Selected satisfies Handler<Value, u64>::call;
{ Selected(value, 42u64) }

linux_x86_64 machine choose<Element, machine Callback>(value: &Element) -> bool
where machine Callback satisfies Handler<Element, bool>::call;
{ Callback(value, 42u64) }

macos_arm64 machine choose<Payload, machine Operation>(value: &Payload) -> bool
where machine Operation satisfies Predicate<Payload>::evaluate;
{ Operation(value, 42u64) }

windows_x86_64 machine choose<Datum, machine Action>(value: &Datum) -> bool
where machine Action(argument: &Datum, number: u64) -> bool;
{ Action(value, 42u64) }

machine main() crashes Trap {
    let item: Item = Item { code: 42u64 };
    transition choose<Item, matches>(&item) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
