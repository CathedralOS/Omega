// A program may bind the Alpha bootstrap entry beside native entries, as the
// product compiler does. The Rust compiler has no native realization for the
// Alpha target, so its provider row is published as unavailable while the
// native targets publish theirs.
data Main { }

machine Main::main(main: &mut Main) { }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
