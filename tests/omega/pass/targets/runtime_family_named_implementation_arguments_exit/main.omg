// Renamed type/evidence binders denote the same portable telescope. Each
// closed family call must retain its explicitly selected implementation map.
trait Reader<Value> {
    machine read(value: &Value) -> bool;
}

Always<Value> satisfies Reader<Value> {
    machine read(value: &Value) -> bool { true }
}
Never<Value> satisfies Reader<Value> {
    machine read(value: &Value) -> bool { false }
}

linux_x86_64 machine choose<Value, Selected satisfies Reader<Value>>(value: &Value) -> bool {
    Selected::read(value)
}
windows_x86_64 machine choose<Element, Operations satisfies Reader<Element>>(element: &Element) -> bool {
    Operations::read(element)
}
linux_arm64 machine choose<Payload, Implementation satisfies Reader<Payload>>(payload: &Payload) -> bool {
    Implementation::read(payload)
}
macos_arm64 machine choose<Datum, Action satisfies Reader<Datum>>(datum: &Datum) -> bool {
    Action::read(datum)
}

data Item { code: u64; }
machine main() crashes Trap {
    let item: Item = Item { code: 17 };
    let first: bool = choose<Item, Always<Item>>(&item);
    let second: bool = choose<Item, Never<Item>>(&item);
    transition (first, second) {
        (true, false) -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
