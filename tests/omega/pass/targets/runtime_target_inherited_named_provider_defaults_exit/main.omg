// One Child choice owns the complete inherited Parent roster, including spare
// which no runtime body calls. Separate Parent candidates are not a demand
// for another choice. The selecting map stays distinct from its shared code.
boundary trait Parent {
    machine echo(value: i32) -> i32;
    machine spare() -> i32;
}
boundary trait Child: Parent { machine choose() -> i32; }

FirstMap satisfies Child {
    Parent::echo = echo;
    Parent::spare = spare;
    Child::choose = first;
}
SecondMap satisfies Child {
    Parent::echo = echo;
    Parent::spare = spare;
    Child::choose = second;
}
FirstParentMap satisfies Parent {
    Parent::echo = echo;
    Parent::spare = spare;
}
SecondParentMap satisfies Parent {
    Parent::echo = echo;
    Parent::spare = spare;
}
machine echo(value: i32) -> i32 { value }
machine spare() -> i32 { 33 }
machine first() -> i32 { 1 }
machine second() -> i32 { 2 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, FirstMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, FirstMap>(defaults);
}
windows_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, SecondMap>(defaults);
}

data Main {}
macos_arm64 machine Main::main() reaches Parent + Child crashes Trap {
    let chosen: i32 = Child::choose();
    let echoed: i32 = Parent::echo((17 as i32));
    transition chosen == 1 && echoed == 17 {
        true -> done() _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

linux_x86_64 machine Main::main() reaches Parent + Child crashes Trap {
    let chosen: i32 = Child::choose();
    let echoed: i32 = Parent::echo((17 as i32));
    transition chosen == 1 && echoed == 17 {
        true -> done() _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
windows_x86_64 machine Main::main() reaches Parent + Child crashes Trap {
    let chosen: i32 = Child::choose();
    let echoed: i32 = Parent::echo((25 as i32));
    transition chosen == 2 && echoed == 25 {
        true -> selected() _ -> bad()
    }
    state selected() { crash Trap; }
    state bad() {}
}
