// The root selects a member handle. Neither its canonical spelling nor the
// source call graph is rewritten to make the Windows body the entry.
linux_x86_64 machine helper(value: u32) requires value == 1 {}
windows_x86_64 machine helper(value: u32) requires value == 2 {}
macos_arm64 machine helper(value: u32) requires value == 3 {}
linux_arm64 machine helper(value: u32) requires value == 4 {}
linux_x86_64 machine main() { helper(1); }
windows_x86_64 machine main() { helper(2); }
macos_arm64 machine main() { helper(3); }
linux_arm64 machine main() { helper(4); }
