// Build helpers use their admitted execution target; Product family naming
// must neither select them nor lose their original target after typing.
linux_x86_64 machine build_ready() -> bool { true }
windows_x86_64 machine build_ready() -> bool { true }
macos_arm64 machine build_ready() -> bool { true }
linux_arm64 machine build_ready() -> bool { true }

machine build(builder: &mut Build) {
    Build::application(builder, "target_family_entry_exit");
    transition build_ready() {
        true -> install(builder)
        false -> not_ready(builder)
    }
    machine install(builder: &mut Build) {
        Build::bind(builder, windows_x86_64::ProgramEntry, main);
        Build::bind(builder, linux_x86_64::ProgramEntry, main);
        Build::bind(builder, linux_arm64::ProgramEntry, main);
        Build::bind(builder, macos_arm64::ProgramEntry, main);
    }
    machine not_ready(builder: &mut Build) {}
}
