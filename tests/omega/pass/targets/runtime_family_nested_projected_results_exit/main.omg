// Qualified leaves inside generic records and fixed arrays retain their own
// paths and linear claims, not qualifications on the enclosing carrier.
use omega::language::core::drop;

public data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
// Declaration order deliberately differs from Terminal catalog name order.
public domain Receipt::Ready(receipt) requires receipt.code < 50;
public domain Receipt::Issued(receipt) requires receipt.code > 0;
data ReceiptBox { receipts: [Receipt in Receipt::Ready & Receipt::Issued; 2]; }
data Holder<Value> { value: Value; }

machine package() -> Holder<ReceiptBox> {
    let first: Receipt in Receipt::Ready & Receipt::Issued = Receipt { code: 12 };
    let second: Receipt in Receipt::Ready & Receipt::Issued = Receipt { code: 30 };
    Holder { value: ReceiptBox { receipts: [first, second] } }
}

linux_x86_64 machine produce() -> Holder<ReceiptBox> { package() }
windows_x86_64 machine produce() -> Holder<ReceiptBox> { package() }
linux_arm64 machine produce() -> Holder<ReceiptBox> { package() }
macos_arm64 machine produce() -> Holder<ReceiptBox> { package() }

machine consume(receipt: Receipt in Receipt::Ready & Receipt::Issued) -> u64 {
    let code: u64 = receipt.code;
    drop(receipt);
    code
}

machine main() crashes Trap {
    let holder: Holder<ReceiptBox> = produce();
    let first: u64 = consume(holder.value.receipts[0]);
    let second: u64 = consume(holder.value.receipts[1]);
    transition first == 12 && second == 30 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
