// Two attached external TableFunction leaves in one image:
// get_memory_map + exit_boot_services on the same trait. The table type owns
// field placement, each leaf names its field, and the dispatch-only table
// pointer stays outside the foreign signature. Cross-compiled for uefi_x86_64 on
// any host; this is the same shape Cathedral's real boot package consumes.
pub boundary trait BootServices {
    machine get_memory_map(
        this: addr,
        map_size: &mut u64,
        map: addr,
        key: &mut u64,
        desc_size: &mut u64,
        desc_version: &mut u32
    ) -> i32;
    machine exit_boot_services(this: addr, handle: addr, key: u64) -> i32
    reaches BootServices;
}
data EfiBootServicesTable {
    hdr: u64;
    raise_tpl: addr;
    restore_tpl: addr;
    allocate_pages: addr;
    free_pages: addr;
    get_memory_map: addr;
    exit_boot_services: addr;
}
uefi_x86_64 machine EfiBootServicesTable::get_memory_map_leaf(
    this: addr,
    map_size: &mut u64,
    map: addr,
    key: &mut u64,
    desc_size: &mut u64,
    desc_version: &mut u32
) -> i32 satisfies BootServices::get_memory_map via Binding::TableFunction(get_memory_map);
uefi_x86_64 machine EfiBootServicesTable::exit_boot_services_leaf(this: addr, handle: addr, key: u64) -> i32 satisfies BootServices::exit_boot_services via Binding::TableFunction(exit_boot_services);
pub data EfiSystemTable {
    hdr_signature: u64; hdr_revision: u32; hdr_header_size: u32; hdr_crc: u32; hdr_reserved: u32;
    firmware_vendor: addr; firmware_revision: u32; fw_pad: u32;
    console_in_handle: addr; con_in: addr; console_out_handle: addr; con_out: addr;
    runtime_services: addr; boot_services: addr;
}
pub data Main {
    bs: BootServices;
    map_size: u64;
    key: u64;
    desc_size: u64;
    desc_version: u32;
    map_buf: [u8; 256];
}
boundary machine Main::main(&mut self, handle: addr, table: &EfiSystemTable) -> i32
reaches BootServices + BootServices
invokes BootServices;
{
    self.map_size = 256;
    let boot_services: addr = table.boot_services;
    let map_size_ref: &mut u64 = &mut self.map_size;
    let map_address: addr = &self.map_buf;
    let key_ref: &mut u64 = &mut self.key;
    let descriptor_size: &mut u64 = &mut self.desc_size;
    let descriptor_version: &mut u32 = &mut self.desc_version;
    let map_status: i32 = self.bs.get_memory_map(
        boot_services,
        map_size_ref,
        map_address,
        key_ref,
        descriptor_size,
        descriptor_version
    );
    let exit_status: i32 = self.bs.exit_boot_services(boot_services, handle, self.key);
    transition { _ -> (0) }
}
