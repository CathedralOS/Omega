trait Handler<Value> { machine call() -> bool; }
trait Predicate { machine evaluate() -> bool; }

// One concrete entry carries every authored authority; matching carriers
// alone do not establish either nominal application or the distinct trait.
machine yes() -> bool
satisfies Handler<u64>::call, Handler<bool>::call, Predicate::evaluate
{ true }

linux_arm64 machine choose<machine Selected>() -> bool
requires machine Selected satisfies Handler<u64>::call;
{ Selected() }

linux_x86_64 machine choose<machine Callback>() -> bool
requires machine Callback satisfies Handler<bool>::call;
{ Callback() }

macos_arm64 machine choose<machine Operation>() -> bool
requires machine Operation satisfies Predicate::evaluate;
{ Operation() }

windows_x86_64 machine choose<machine Action>() -> bool
requires machine Action() -> bool;
{ Action() }

machine main() crashes Trap {
    transition choose<yes>() {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
