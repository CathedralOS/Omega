// RUN CANARY (exit 70): two target-scoped families select one body each.
// Both families name the exact profiles bound by build.omg. A compatibility
// profile such as local_unchecked has its own identity; mapping to the same
// native shape does not supply another profile's implementation.
// Exit 70 still requires both results (63 and 7), while the unselected
// same-name siblings must neither collide nor supply the selected calls.
use omega_language_std::console;

data Helper { seed: i32; }

windows_x86_64 machine Helper::pick(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}
macos_arm64 machine Helper::pick(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}
linux_x86_64 machine Helper::pick(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}
linux_arm64 machine Helper::pick(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}

windows_x86_64 machine Helper::delta(helper: &Helper) -> i32 {
    transition { _ -> 7 }
}
macos_arm64 machine Helper::delta(helper: &Helper) -> i32 {
    transition { _ -> 7 }
}
linux_x86_64 machine Helper::delta(helper: &Helper) -> i32 {
    transition { _ -> 7 }
}
linux_arm64 machine Helper::delta(helper: &Helper) -> i32 {
    transition { _ -> 7 }
}

data Main { helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = Helper::pick(&main.helper);
    let b: i32 = Helper::delta(&main.helper);
    transition a == 63 { true -> check_delta(main, b) _ -> bad(main, 71) }
    state check_delta(main: &mut Main, b2: i32) {
        transition b2 == 7 { true -> good(main) _ -> bad(main, 72) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code2: i32) { Console::exit_process(code2); }
}
