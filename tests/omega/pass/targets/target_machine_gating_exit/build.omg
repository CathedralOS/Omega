// Deployable target-machine canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::select_provider<SelectedHelperPick, CheckedHelperPick>(builder, windows_x86_64);
    Build::select_provider<SelectedHelperPick, CheckedHelperPick>(builder, macos_arm64);
    Build::select_provider<SelectedHelperPick, CheckedHelperPick>(builder, linux_x86_64);
    Build::select_provider<SelectedHelperPick, CheckedHelperPick>(builder, linux_arm64);
    Build::select_provider<SelectedHelperDelta, CheckedHelperDelta>(builder, windows_x86_64);
    Build::select_provider<SelectedHelperDelta, CheckedHelperDelta>(builder, macos_arm64);
    Build::select_provider<SelectedHelperDelta, CheckedHelperDelta>(builder, linux_x86_64);
    Build::select_provider<SelectedHelperDelta, CheckedHelperDelta>(builder, linux_arm64);

    Build::application(builder, "target_machine_gating_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
