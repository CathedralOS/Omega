// The exact uefi_x86_64 invocation profile pins x86_64 + PE32+. This build is
// freestanding, so no host boundary packages; services arrive via the entry's
// parameters.

machine build(builder: &mut Build) {
    builder.application("efi-vtable-call");
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}
