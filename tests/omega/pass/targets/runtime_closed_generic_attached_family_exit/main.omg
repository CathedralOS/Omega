// Both closed carriers retain independent portable interfaces and every body.
data Cell<Value [copy]> [copy] { value: Value; code: u64; }

linux_x86_64 machine Cell::read<Value [copy]>(cell: &Cell<Value>) -> u64 { cell.code }
windows_x86_64 machine Cell::read<Value [copy]>(cell: &Cell<Value>) -> u64 { cell.code }
linux_arm64 machine Cell::read<Value [copy]>(cell: &Cell<Value>) -> u64 { cell.code }
macos_arm64 machine Cell::read<Value [copy]>(cell: &Cell<Value>) -> u64 { cell.code }

data Main { narrow: Cell<u32>; wide: Cell<u64>; }
machine Main::main(main: &mut Main) crashes Trap {
    main.narrow.code = 42;
    main.wide.code = 7;
    let narrow: u64 = Cell::read(&main.narrow);
    let wide: u64 = Cell::read(&main.wide);
    transition narrow == 42 && wide == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
