machine build(builder: &mut Build) {
    Build::select_provider<SelectedCellRead, CheckedCellRead>(builder, linux_x86_64);
    Build::select_provider<SelectedCellRead, CheckedCellRead>(builder, windows_x86_64);
    Build::select_provider<SelectedCellRead, CheckedCellRead>(builder, linux_arm64);
    Build::select_provider<SelectedCellRead, CheckedCellRead>(builder, macos_arm64);

    Build::application(builder, "runtime_closed_generic_attached_family_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
