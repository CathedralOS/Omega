// The public requirement is portable. Each provider body checks its private
// calls against its own target, without rewriting the portable caller.
public data Value {}
public boundary requirement Value::read() -> u64 ensures result == 42;
public data TargetValue {}

linux_x86_64 machine private_value(input: u64) -> u64 requires input == 1 { 42 }
windows_x86_64 machine private_value(input: u64) -> u64 requires input == 2 { 42 }
macos_arm64 machine private_value(input: u64) -> u64 requires input == 3 { 42 }
linux_arm64 machine private_value(input: u64) -> u64 requires input == 4 { 42 }

linux_x86_64 machine TargetValue::read() -> u64
satisfies Value::read ensures result == 42 { private_value(1) }
windows_x86_64 machine TargetValue::read() -> u64
satisfies Value::read ensures result == 42 { private_value(2) }
macos_arm64 machine TargetValue::read() -> u64
satisfies Value::read ensures result == 42 { private_value(3) }
linux_arm64 machine TargetValue::read() -> u64
satisfies Value::read ensures result == 42 { private_value(4) }

machine main() crashes Trap {
    let value: u64 = Value::read();
    transition value == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
