machine build(builder: &mut Build) {
    Build::application(builder, "provider_family_private_contracts_exit");
    Build::select_provider<Value, TargetValue>(builder, linux_arm64);
    Build::select_provider<Value, TargetValue>(builder, linux_x86_64);
    Build::select_provider<Value, TargetValue>(builder, macos_arm64);
    Build::select_provider<Value, TargetValue>(builder, macos_x86_64);
    Build::select_provider<Value, TargetValue>(builder, windows_x86_64);
    Build::select_provider<Value, TargetValue>(builder, uefi_x86_64);
    Build::select_provider<Value, TargetValue>(builder, cross_platform_cli);
    Build::select_provider<Value, TargetValue>(builder, local_unchecked);
    Build::select_provider<Value, TargetValue>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
