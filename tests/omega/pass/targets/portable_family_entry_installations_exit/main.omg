// One portable main family stays in one immutable Terminal artifact. Every
// installed entry calls its exact same-target helper. Windows deliberately
// traps after its helper comparison; selecting another whole cohort therefore
// changes the externally observed outcome, not just a private constant.
linux_x86_64 machine helper() -> u32 { 101 }
windows_x86_64 machine helper() -> u32 { 202 }
macos_arm64 machine helper() -> u32 { 303 }
linux_arm64 machine helper() -> u32 { 404 }

linux_x86_64 machine main() crashes Trap {
    transition helper() == 101 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
windows_x86_64 machine main() crashes Trap {
    transition helper() == 202 {
        true -> selected()
        _ -> bad()
    }
    machine selected() { crash Trap; }
    machine bad() {}
}
macos_arm64 machine main() crashes Trap {
    transition helper() == 303 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
linux_arm64 machine main() crashes Trap {
    transition helper() == 404 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
