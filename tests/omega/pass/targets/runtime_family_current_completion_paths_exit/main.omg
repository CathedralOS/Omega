// The replacement's entry claim is at its root, but the portable call must
// transfer it at its current Pair::left path alongside the retained right.
// Neither selecting a family member nor moving a claim creates new custody.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }

machine settle(pair: Pair) -> bool {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let correct: bool = left.code == 12 && right.code == 30;
    drop(left);
    drop(right);
    correct
}

linux_x86_64 machine Pair::consume(pair: Pair) -> bool { settle(pair) }
windows_x86_64 machine Pair::consume(pair: Pair) -> bool { settle(pair) }
linux_arm64 machine Pair::consume(pair: Pair) -> bool { settle(pair) }
macos_arm64 machine Pair::consume(pair: Pair) -> bool { settle(pair) }

machine exercise(mut pair: Pair, replacement: Receipt) -> bool {
    let previous: Receipt = pair.left;
    pair.left = replacement;
    drop(previous);
    Pair::consume(pair)
}

machine main() crashes Trap {
    let correct: bool = exercise(
        Pair { left: Receipt { code: 1 }, right: Receipt { code: 30 } },
        Receipt { code: 12 }
    );
    transition correct {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
