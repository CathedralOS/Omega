machine build(builder: &mut Build) {
    Build::select_provider<SelectedPairConsume, CheckedPairConsume>(builder, linux_x86_64);
    Build::select_provider<SelectedPairConsume, CheckedPairConsume>(builder, windows_x86_64);
    Build::select_provider<SelectedPairConsume, CheckedPairConsume>(builder, linux_arm64);
    Build::select_provider<SelectedPairConsume, CheckedPairConsume>(builder, macos_arm64);

    Build::application(builder, "runtime_family_current_completion_paths_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
