// Expected exit: 0. Public generated heads in another package resolve through
// ordinary imports. A package address, carrier spelling, borrowed local and
// helper parameter all select the same family, never a lexical member body.
use family_import_kit::carrier;

data Main { carrier: Carrier; }

machine forwarded(carrier: &Carrier) -> u64 { Carrier::value(carrier) }

machine Main::check(main: &mut Main, expected: u64) crashes Trap {
    let direct: u64 = Carrier::value(&main.carrier);
    let qualified: u64 = family_import_kit::Carrier::value(&main.carrier);
    let local: Carrier = main.carrier;
    let borrowed: &Carrier = &local;
    let through_helper: u64 = forwarded(borrowed);
    transition direct == expected && qualified == expected && through_helper == expected {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

linux_x86_64 machine Main::main(main: &mut Main) crashes Trap { Main::check(main, 101); }
windows_x86_64 machine Main::main(main: &mut Main) crashes Trap { Main::check(main, 202); }
macos_arm64 machine Main::main(main: &mut Main) crashes Trap { Main::check(main, 303); }
linux_arm64 machine Main::main(main: &mut Main) crashes Trap { Main::check(main, 404); }

// The entry owns ordinary local state; selection supplies no context.
linux_x86_64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

windows_x86_64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

macos_arm64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

linux_arm64 machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
