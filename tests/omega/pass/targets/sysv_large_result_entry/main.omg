// SysV MEMORY-result entry pin: incoming rdi is the caller-owned result
// destination, so the declared scalar arrives in rsi. The terminal record is
// copied through the saved pointer and that pointer is returned in rax.
data Triple { first: u64; second: u64; third: u64; }
data Main { output: Triple; }
boundary machine Main::main(&self, marker: u64) -> Triple {
    transition { _ -> (self.output) }
}

target linux_x86_64 {
}
