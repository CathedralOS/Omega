// An anonymous family return and a record containing linear children use the
// same receiving frontier as a named root-linear result.
use omega::language::core::drop;

data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }
data Holder<Value> { held: Value; }

boundary trait SelectedProduce {
    machine produce(code: u64) -> Receipt reaches
;
}
CheckedProduce satisfies SelectedProduce {
    machine produce(code: u64) -> Receipt
{ Receipt { code: code } }
}




machine relay(code: u64) -> Receipt { SelectedProduce::produce(code) }

boundary trait SelectedPack {
    machine pack<Value>(held: Value) -> Holder<Value> reaches
;
}
CheckedPack satisfies SelectedPack {
    machine pack<Value>(held: Value) -> Holder<Value>
{ Holder { held: held } }
}




boundary trait SelectedPair {
    machine pair() -> Pair reaches
;
}
CheckedPair satisfies SelectedPair {
    machine pair() -> Pair
{ Pair { left: Receipt { code: 12 }, right: Receipt { code: 30 } } }
}




machine main() crashes Trap {
    let relayed: Receipt = relay(42);
    let holder: Holder<Receipt> = SelectedPack::pack<Receipt>(relayed);
    let transferred: Receipt = holder.held;
    let result: Pair = SelectedPair::pair();
    let left: Receipt = result.left;
    let right: Receipt = result.right;
    let correct: bool = transferred.code == 42 && left.code == 12 && right.code == 30;
    drop(transferred);
    drop(left);
    drop(right);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
