trait Handler<Value> { machine call() -> bool; }
machine yes() -> bool satisfies Handler<u64>::call { true }

linux_arm64 machine choose<machine Selected>() -> bool
requires machine Selected satisfies Handler<u64>::call;
{ Selected() }

linux_x86_64 machine choose<machine Callback>() -> bool
requires machine Callback satisfies Handler<u64>::call;
{ Callback() }

macos_arm64 machine choose<machine Operation>() -> bool
requires machine Operation satisfies Handler<u64>::call;
{ Operation() }

windows_x86_64 machine choose<machine Action>() -> bool
requires machine Action satisfies Handler<u64>::call;
{ Action() }

machine main() crashes Trap {
    transition choose<yes>() {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
