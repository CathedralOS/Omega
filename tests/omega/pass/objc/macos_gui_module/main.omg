// Bounded headless-CI canary for the shipped `MacosGui` provider. It exercises
// window creation, DC lookup, framebuffer blitting, the message pump, and window
// liveness through the same value-call shape as `window_demo`, using eight frames
// and omitting timing and interactive console waits. Success exits with 3.

use omega::language::std::macos_gui;

use omega::language::std::console;

// Keep loop/guard scalars before the framebuffer so this canary isolates provider
// behavior from large frame-offset addressing. The framebuffer base itself is
// materialized in a register.
data Main {
    console: Console;
    gui: MacosGui;
    hwnd: u64;
    hdc: u64;
    dispatched: u64;
    have: u32;
    translated: u32;
    alive: u32;
    pumped: i32 [0..=16];
    copied: u32;
    frame: i32 [0..=8];
    i: i32 [0..=4096];
    c: i32;
    px: i32;
    cls: [u8; 7];
    title: [u8; 11];
    info: [i32; 11];
    message: [u64; 6];
    pixels: [i32; 4096];
}

machine Main::main(&mut self) {
    self.console.write_line("macos_gui_module: window_demo shape through the MacosGui provider");
    // "#32770\0" — the predefined dialog class (ignored on macOS; D-macgui-style).
    self.cls[0] = 35;
    self.cls[1] = 51;
    self.cls[2] = 50;
    self.cls[3] = 55;
    self.cls[4] = 55;
    self.cls[5] = 48;
    self.cls[6] = 0;
    // "omega demo\0"
    self.title[0] = 111;
    self.title[1] = 109;
    self.title[2] = 101;
    self.title[3] = 103;
    self.title[4] = 97;
    self.title[5] = 32;
    self.title[6] = 100;
    self.title[7] = 101;
    self.title[8] = 109;
    self.title[9] = 111;
    self.title[10] = 0;
    // BITMAPINFOHEADER: 64x64 top-down 32bpp BI_RGB (ignored on macOS).
    self.info[0] = 40;
    self.info[1] = 64;
    self.info[2] = 0 - 64;
    self.info[3] = 2097153;
    self.hwnd = self.gui.window_create(self.cls, self.title, 282001408, 200, 200, 272, 295);
    transition self.hwnd > 0 { true -> dc() _ -> bad() }
    state dc(&mut self) {
        self.hdc = self.gui.get_dc(self.hwnd);
        self.frame = 0;
        transition self.hdc > 0 { true -> frame_loop() _ -> bad() }
    }
    state frame_loop(&mut self) {
        transition self.frame < 8 { true -> fill_init() _ -> finish() }
    }
    state fill_init(&mut self) {
        self.i = 0;
        transition { _ -> fill_loop() }
    }
    state fill_loop(&mut self) {
        transition self.i >= 0 && self.i < 4096 { true -> fill_cell() _ -> present() }
    }
    state fill_cell(&mut self) {
        self.c = ((self.i / 64) + (self.i % 64) + self.frame * 4) % 256;
        self.px = (self.c * 65536) + ((255 - self.c) * 256) + 64;
        transition self.i >= 0 && self.i < 4096 { true -> fill_put() _ -> bad() }
    }
    state fill_put(&mut self) {
        self.pixels[self.i] = self.px;
        self.i = self.i + 1;
        transition { _ -> fill_loop() }
    }
    state present(&mut self) {
        self.copied = self.gui.blit(self.hdc, 256, 256, 64, 64, self.pixels, self.info);
        transition self.copied == 64 { true -> pump_init() _ -> bad() }
    }
    state pump_init(&mut self) {
        self.pumped = 0;
        transition { _ -> pump_loop() }
    }
    state pump_loop(&mut self) {
        self.have = self.gui.msg_peek(self.message);
        transition self.have > 0 { true -> pump_handle() _ -> liveness() }
    }
    state pump_handle(&mut self) {
        self.translated = self.gui.msg_translate(self.message);
        self.dispatched = self.gui.msg_dispatch(self.message);
        transition self.pumped < 16 { true -> pump_next() _ -> liveness() }
    }
    state pump_next(&mut self) {
        self.pumped = self.pumped + 1;
        transition { _ -> pump_loop() }
    }
    state liveness(&mut self) {
        self.alive = self.gui.is_window(self.hwnd);
        transition self.alive > 0 { true -> next_frame() _ -> finish() }
    }
    state next_frame(&mut self) {
        transition self.frame < 8 { true -> advance() _ -> finish() }
    }
    state advance(&mut self) {
        self.frame = self.frame + 1;
        transition { _ -> frame_loop() }
    }
    state finish(&mut self) {
        self.console.write_line("PASS: window_demo behavior blitted + pumped natively (exit 3)");
        self.console.exit_process(3);
    }
    state bad(&mut self) {
        self.console.write_line("FAIL: window/DC creation or a blit assertion failed (exit 1)");
        self.console.exit_process(1);
    }
}
