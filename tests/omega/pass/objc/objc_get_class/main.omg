use omega::language::core::presentation_authority;
use omega::language::core::time_authority;
use omega::language::core::native_execution_authority;
use omega::language::core::filesystem_authority;
use omega::language::core::process_authority;
use omega::language::core::process_exit;
// PROVES multi-dylib linking (render fire 7): the FIRST call into a second dylib.
// `objc_getClass` lives in /usr/lib/libobjc.A.dylib, NOT libSystem — so the
// Mach-O must emit a 2nd LC_LOAD_DYLIB and bind this symbol at dylib ordinal 2.
// `objc_getClass("NSObject")` returns the NSObject Class pointer (always present
// in libobjc's runtime); a non-null result means dyld resolved the second-dylib
// import correctly. cls != 0 -> exit 7; a broken bind (or wrong ordinal) leaves
// cls == 0 -> exit 1 (or dyld aborts at load, which the test also catches).

// An Objective-C class name: NUL-free bytes (a C string, like a path but its own
// domain — `objc_getClass` takes `const char *`). `no_nul` is compiler-recognized.
public domain [u8]::ClassName(bytes)
requires
    no_nul(bytes);
use omega_language_std::console;

public boundary trait ObjectiveC {
    machine get_class(name: &[u8] in ClassName) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
}

data Main {
}

machine Main::main(main: &mut Main) reaches
    Console + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    GlobalInputObservation + ClockObservation + ExecutionDelay +
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit {
    let mut cls: u64 = ObjectiveC::get_class("NSObject");
    transition cls != 0 { true -> good(main) _ -> bad(main) }
    machine good(main: &mut Main) { Console::exit_process(7); }
    machine bad(main: &mut Main)  { Console::exit_process(1); }
}
