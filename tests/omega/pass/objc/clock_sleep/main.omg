// PROVES the macOS `Clock.sleep` native lowering (render fire 23): the samples pace
// their animation with `self.clock.sleep(ms)` through the UNCHANGED `Clock` boundary
// trait; window_demo will not even compile without a darwin lowering for it. On macOS
// `Clock.sleep(ms)` lowers to `poll(NULL, 0, ms)` — with zero fds, poll's timeout IS a
// millisecond sleep (correct units, no <1s cap, unlike usleep's microseconds). This
// canary sleeps 3×150ms = ~450ms through the boundary, then exits 6. The regression
// times the run to confirm MILLISECOND units (≈450ms, not ~instant micros nor ~450s).
//
// The `ms` boundary arg lands in poll's `timeout` (x2) with x0=NULL, x1=nfds=0 synthesized
// by the operand arm. A bounded 3× loop (guard-before-increment keystone) drives it.

use omega::language::std::console;
boundary trait Clock {
    machine sleep(milliseconds: u32);
}

data Main {
    console: Console;
    clock: Clock;
    ticks: i32 [0..=3];
}

machine Main::main(&mut self) {
    self.ticks = 0;
    transition { _ -> loop() }
    state loop(&mut self) {
        transition self.ticks < 3 { true -> nap() _ -> done() }
    }
    state nap(&mut self) {
        self.clock.sleep(150);
        transition self.ticks < 3 { true -> advance() _ -> done() }
    }
    state advance(&mut self) {
        self.ticks = self.ticks + 1;
        transition { _ -> loop() }
    }
    state done(&mut self) {
        self.console.exit_process(6);
    }
}
