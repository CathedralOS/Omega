use omega::language::core::WindowManagement;
use omega::language::core::SurfacePresentation;
use omega::language::core::WindowEventObservation;
use omega::language::core::WindowEventDispatch;
use omega::language::core::GlobalInputObservation;
use omega::language::core::ClockObservation;
use omega::language::core::ExecutionDelay;
use omega::language::core::NativeCodeExecution;
use omega::language::core::FilesystemContentRead;
use omega::language::core::FilesystemContentWrite;
use omega::language::core::FilesystemMetadataQuery;
use omega::language::core::FilesystemMetadataMutation;
use omega::language::core::DirectoryEnumeration;
use omega::language::core::FilesystemNamespaceMutation;
use omega::language::core::ProcessInput;
use omega::language::core::ProcessOutput;
use omega::language::core::ProcessExit;
// PROVES the 3-argument objc_msgSend with a SCALAR argument + a determinate
// integer return VALUE (render fire 8) — the exact shape the window path needs
// (setActivationPolicy: int, activateIgnoringOtherApps: BOOL, etc.). Sends
//   [NSObject respondsToSelector: @selector(alloc)]
// recv (NSObject class) -> x0, sel(respondsToSelector:) -> x1, arg(SEL alloc) ->
// x2; the BOOL result comes back in x0. NSObject's metaclass DOES respond to
// +alloc, so the answer is exactly 1 (verified: the method returns via `mov w0,
// #1`, zeroing the high bits). r == 1 -> exit 8; a misplaced arg or wrong result
// register gives something else -> exit 1. Uses only NSObject (defined in
// libobjc); Foundation/AppKit classes need their frameworks loaded (see D-objc).

public domain [u8]::CString
requires
    no_nul(self);
use omega_language_std::Console;

public boundary trait ObjectiveC {
    machine get_class(name: &[u8] in CString) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
    machine register_selector(name: &[u8] in CString) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
    machine send_scalar(recv: u64, sel: u64, arg: u64) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
}

data Main {
}

machine Main::main(main: &mut Main) reaches
    Console + NativeCodeExecution + WindowManagement +
    SurfacePresentation + WindowEventObservation + WindowEventDispatch +
    GlobalInputObservation + ClockObservation + ExecutionDelay +
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit {
    let mut cls: u64 = ObjectiveC::get_class("NSObject");
    let mut sel_resp: u64 = ObjectiveC::register_selector("respondsToSelector:");
    let mut sel_alloc: u64 = ObjectiveC::register_selector("alloc");
    let mut r: u64 = ObjectiveC::send_scalar(cls, sel_resp, sel_alloc);
    transition r == 1 { true -> good(main) _ -> bad(main) }
    machine good(main: &mut Main) { Console::exit_process(8); }
    machine bad(main: &mut Main)  { Console::exit_process(1); }
}
