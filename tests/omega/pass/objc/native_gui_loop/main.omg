use omega::language::core::float_operations;

// PROVES the SAMPLES' whole behavior runs natively (render fire 16): a bounded
// windowed app that opens a window with an image view, then for a few frames
// blits a framebuffer and drains the event queue non-blocking, then closes. This
// is exactly the shape of samples/gui/window_demo (the exit-asserted, short-lived
// variant) — every Win32 op's macOS behavior, composed from the proven objc/CG
// primitives:
//   window_create -> NSApp + NSWindow + NSImageView + setContentView + orderFront
//   blit          -> CGBitmapContext(&pixels) -> CGImage -> NSImage -> setImage:
//   msg_peek pump  -> nextEventMatchingMask:untilDate:distantPast (non-blocking)
//   is_window      -> [window isVisible]
//   window_destroy -> [window close]
// Selectors reused across frames are interned ONCE and cached. Bounded to 3
// frames and headless-safe: no blocking pump, the window need not be visible (a
// session box shows it briefly). Runs the full render+pump loop -> exit 4. This
// is the end-goal behavior; the only remaining piece is the source-transparent
// wiring so the UNCHANGED samples' boundary Gui/Clock/Input calls reach it.

pub domain [u8]::CString(bytes)
requires
    no_nul(bytes);
use omega_language_std::console;

pub boundary trait ObjectiveC {
    machine get_class(name: &[u8] in CString) -> u64;
    machine register_selector(name: &[u8] in CString) -> u64;
    machine send(recv: u64, sel: u64) -> u64;
    machine send_scalar(recv: u64, sel: u64, arg: u64) -> u64;
    machine send_scalar4(recv: u64, sel: u64, a: u64, b: u64, c: u64, d: u64) -> u64;
    machine send_rect(recv: u64, sel: u64, x: f64, y: f64, w: f64, h: f64, a: u64, b: u64, c: u64) -> u64;
    machine send_image_size(recv: u64, sel: u64, image: u64, w: f64, h: f64) -> u64;
    machine send_string(recv: u64, sel: u64, text: &[u8] in CString) -> u64;
}

pub boundary trait CoreGraphics {
    machine color_space_rgb() -> u64;
    machine bitmap_context(data: &mut [i32], w: i64, h: i64, bpc: i64, stride: i64, space: u64, info: i64) -> u64;
    machine bitmap_context_image(ctx: u64) -> u64;
}

data Main where 0 <= frame, frame <= 8 {
    pixels: [i32; 16];
    fx: f64;
    fy: f64;
    fw: f64;
    fh: f64;
    sw: f64;
    sh: f64;
    app: u64;
    win: u64;
    view: u64;
    space: u64;
    date: u64;
    mode: u64;
    tmp: u64;
    sel: u64;
    sel_img: u64;
    sel_set: u64;
    sel_next: u64;
    ctx: u64;
    cgimg: u64;
    nsimg: u64;
    evt: u64;
    mask: u64;
    frame: i32;
    alive: u64;
    rc: u64;
}

machine Main::main(main: &mut Main) reaches Console + CoreGraphics + ObjectiveC {
    main.fx = 0.0;
    main.fy = 0.0;
    main.fw = 64.0;
    main.fh = 64.0;
    main.sw = 4.0;
    main.sh = 4.0;
    // NSApplication + regular policy.
    main.tmp = ObjectiveC::get_class("NSApplication");
    main.sel = ObjectiveC::register_selector("sharedApplication");
    main.app = ObjectiveC::send(main.tmp, main.sel);
    main.sel = ObjectiveC::register_selector("setActivationPolicy:");
    main.rc = ObjectiveC::send_scalar(main.app, main.sel, 0);
    // NSWindow.
    main.tmp = ObjectiveC::get_class("NSWindow");
    main.sel = ObjectiveC::register_selector("alloc");
    main.tmp = ObjectiveC::send(main.tmp, main.sel);
    main.sel = ObjectiveC::register_selector("initWithContentRect:styleMask:backing:defer:");
    main.win = ObjectiveC::send_rect(main.tmp, main.sel, main.fx, main.fy, main.fw, main.fh, 15, 2, 0);
    // NSImageView as the content view.
    main.tmp = ObjectiveC::get_class("NSImageView");
    main.sel = ObjectiveC::register_selector("alloc");
    main.tmp = ObjectiveC::send(main.tmp, main.sel);
    main.sel = ObjectiveC::register_selector("initWithFrame:");
    main.view = ObjectiveC::send_rect(main.tmp, main.sel, main.fx, main.fy, main.fw, main.fh, 0, 0, 0);
    main.sel = ObjectiveC::register_selector("setContentView:");
    main.rc = ObjectiveC::send_scalar(main.win, main.sel, main.view);
    main.sel = ObjectiveC::register_selector("makeKeyAndOrderFront:");
    main.rc = ObjectiveC::send_scalar(main.win, main.sel, 0);
    // Cache the per-frame selectors + shared blit/pump inputs.
    main.sel_img = ObjectiveC::register_selector("initWithCGImage:size:");
    main.sel_set = ObjectiveC::register_selector("setImage:");
    main.sel_next = ObjectiveC::register_selector("nextEventMatchingMask:untilDate:inMode:dequeue:");
    main.space = CoreGraphics::color_space_rgb();
    main.tmp = ObjectiveC::get_class("NSDate");
    main.sel = ObjectiveC::register_selector("distantPast");
    main.date = ObjectiveC::send(main.tmp, main.sel);
    main.tmp = ObjectiveC::get_class("NSString");
    main.sel = ObjectiveC::register_selector("alloc");
    main.tmp = ObjectiveC::send(main.tmp, main.sel);
    main.sel = ObjectiveC::register_selector("initWithUTF8String:");
    main.mode = ObjectiveC::send_string(main.tmp, main.sel, "kCFRunLoopDefaultMode");
    main.mask = 4294967295;
    main.frame = 0;
    transition main.win != 0 { true -> frame_loop(main) _ -> bad(main) }
    state frame_loop(main: &mut Main) {
        transition main.frame < 3 { true -> render(main) _ -> teardown(main) }
    }
    state render(main: &mut Main) {
        // "render" a frame: stamp the buffer, blit it into the image view.
        main.pixels[0] = main.frame;
        main.ctx = CoreGraphics::bitmap_context(&mut main.pixels, 4, 4, 8, 16, main.space, 8198);
        main.cgimg = CoreGraphics::bitmap_context_image(main.ctx);
        main.tmp = ObjectiveC::get_class("NSImage");
        main.sel = ObjectiveC::register_selector("alloc");
        main.tmp = ObjectiveC::send(main.tmp, main.sel);
        main.nsimg = ObjectiveC::send_image_size(main.tmp, main.sel_img, main.cgimg, main.sw, main.sh);
        main.rc = ObjectiveC::send_scalar(main.view, main.sel_set, main.nsimg);
        // Pump the event queue non-blocking.
        main.evt = ObjectiveC::send_scalar4(main.app, main.sel_next, main.mask, main.date, main.mode, 1);
        // Guard BEFORE the increment so the edge carries the bound (keystone).
        transition main.frame < 8 { true -> bump(main) _ -> teardown(main) }
    }
    state bump(main: &mut Main) {
        main.frame = main.frame + 1;
        transition { _ -> frame_loop(main) }
    }
    state teardown(main: &mut Main) {
        main.sel = ObjectiveC::register_selector("isVisible");
        main.alive = ObjectiveC::send(main.win, main.sel);
        main.sel = ObjectiveC::register_selector("close");
        main.rc = ObjectiveC::send_scalar(main.win, main.sel, 0);
        transition { _ -> good(main) }
    }
    state good(main: &mut Main) { Console::exit_process(4); }
    state bad(main: &mut Main)  { Console::exit_process(1); }
}
