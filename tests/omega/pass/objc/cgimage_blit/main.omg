// PROVES the framebuffer → CGImage blit path (render fire 12), the pixels-to-image
// half of the window blit. Builds a CGImage from a 4x4 BGRA framebuffer WITHOUT
// the 11-arg CGImageCreate (3 stack args) by going through a bitmap context, whose
// creator takes 7 register args:
//   space = CGColorSpaceCreateDeviceRGB()                         (0 args)
//   ctx   = CGBitmapContextCreate(&pixels, 4, 4, 8, 16, space,    (7 args, x0-x6)
//              0x2006)  // kCGImageAlphaNoneSkipFirst|ByteOrder32Little
//   img   = CGBitmapContextCreateImage(ctx)                       (1 arg)
//   w     = CGImageGetWidth(img)                                  (1 arg -> x0)
// The framebuffer is passed as a POINTER (address of the [i32;16] field, like an
// fs buffer). A correct chain — colorspace non-null, the 7-arg context call places
// width/height/stride/colorspace/info right, the snapshot, and the width readback —
// yields w == 4 -> exit 4. A wrong arg (bad stride, unsupported bitmapInfo, or a
// misplaced register) makes CGBitmapContextCreate return NULL, so the image is nil
// and CGImageGetWidth(nil) == 0 -> exit 1.

use omega::language::std::console;

boundary trait CoreGraphics {
    machine color_space_rgb() -> u64;
    machine bitmap_context(data: &mut [i32], w: i64, h: i64, bpc: i64, stride: i64, space: u64, info: i64) -> u64;
    machine bitmap_context_image(ctx: u64) -> u64;
    machine image_width(img: u64) -> i64;
}

data Main {
    console: Console;
    cg: CoreGraphics;
    pixels: [i32; 16];
    space: u64;
    ctx: u64;
    img: u64;
    width: i64;
}

machine Main::main(&mut self) {
    self.space = self.cg.color_space_rgb();
    self.ctx = self.cg.bitmap_context(&mut self.pixels, 4, 4, 8, 16, self.space, 8198);
    self.img = self.cg.bitmap_context_image(self.ctx);
    self.width = self.cg.image_width(self.img);
    transition self.width == 4 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(4); }
    state bad(&mut self)  { self.console.exit_process(1); }
}
