// PROVES the darwin GUI-provider SUBSTITUTION (render fire 24, task #57): this file
// declares the UNCHANGED Win32-shaped `boundary trait Gui` and calls it directly —
// exactly like samples/gui/window_demo, with NO `use` of any macOS module. On darwin
// the bundled `MacosGui` provider is selected for `Gui`, so `Gui::window_create(..)`
// dispatches to the objc/Cocoa-composing MacosGui machine as an ordinary value-call. A non-null
// window + get_dc echo -> exit 7. This is the source-transparent wiring that lets the
// samples run natively without touching their traits.
//
// Minimal on purpose (window lifecycle only, no framebuffer array) so it proves the
// SUBSTITUTION in isolation, independent of the large-offset encoder gap (task #59).

use omega_language_std::console;
pub boundary trait Gui {
    machine window_create(class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64;
    machine get_dc(window: u64) -> u64;
    machine is_window(window: u64) -> u32;
    machine window_destroy(window: u64) -> u32;
}

data Main {
    win: u64;
    dc: u64;
    alive: u32;
    killed: u32;
    cls: [u8; 7];
    title: [u8; 11];
}

machine Main::main(main: &mut Main) reaches Console + Gui {
    main.win = Gui::window_create(main.cls, main.title, 0, 0, 0, 200, 150);
    main.dc = Gui::get_dc(main.win);
    main.alive = Gui::is_window(main.win);
    main.killed = Gui::window_destroy(main.win);
    transition main.win != 0 { true -> ck_dc(main) _ -> bad(main) }
    state ck_dc(main: &mut Main) { transition main.dc == main.win { true -> good(main) _ -> bad(main) } }
    state good(main: &mut Main) { Console::exit_process(7); }
    state bad(main: &mut Main)  { Console::exit_process(1); }
}
