use omega_language_std::console;
data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }
machine choose(selected: u64) -> u64 {
    let p: Pair = Pair { first: Payload { left: 4, right: 6 }, second: Payload { left: 8, right: 10 } };
    let result: Payload = match selected {
        0 -> p.first,
        _ -> p.second
    };
    result.left ^ result.right
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let a: u64 = choose(0);
    let b: u64 = choose(1);
    transition a == 2 && b == 2 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
