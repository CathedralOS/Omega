data Category { case Other; case Missing; }
data Record { category: Category; number: u64; }

machine classify(code: u64) -> Category {
    match code { 2 -> Category::Missing, _ -> Category::Other }
}

machine record(code: u64) -> Record {
    match code {
        2 -> Record { category: Category::Missing, number: 7 },
        _ -> Record {
            category: match code { 3 -> Category::Missing, _ -> Category::Other },
            number: code
        }
    }
}

machine accept(category: Category) {}

machine consume_result(code: u64) {
    let category: Category = match code { 2 -> Category::Missing, _ -> Category::Other };
    accept(category);
}

data Holder { category: Category; }

machine Holder::replace(holder: &mut Holder, code: u64) {
    holder.category = match code { 2 -> Category::Missing, _ -> Category::Other };
}

use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let a: Category = classify(2);
    let r: Record = record(3);
    consume_result(2);
    let mut h: Holder = Holder { category: Category::Other };
    Holder::replace(&mut h, 2);
    transition (a in Category::Missing) && (r.category in Category::Missing) && r.number == 3 && (h.category in Category::Missing) {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
