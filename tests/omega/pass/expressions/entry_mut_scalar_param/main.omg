// `machine Main::main(out: &mut i32)` — the entry machine binds a
// borrowed scalar context, not a `&mut Main`: stores through `out`
// land in the caller's storage.
data Main { }

machine Main::main(out: &mut i32) {
    let a: i32 = 2;
    let b: i32 = 3;
    let c: i32 = 4;
    out = (a + b) * c;
}
