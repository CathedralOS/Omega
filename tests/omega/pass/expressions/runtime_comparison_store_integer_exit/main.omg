// A comparison stored into an integer slot spells its `{0, 1}` value with
// `as`: a comparison is `bool`, and a store adds no conversion
// (fail/expressions/comparison_result_integer_store_rejected). The converted
// store into a local and into an `i32 in Wrapping` field each plan a scalar
// value row, so the state has an executable body.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) reaches Console {
    let value: i32 = 70;
    let matched: i32 = (value == 70) as i32;
    let missed: i32 = (value < 7) as i32;
    main.hits = (value != 7) as i32 in Wrapping;
    let total: i32 = matched + missed + (main.hits as i32);
    transition total == 2 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
