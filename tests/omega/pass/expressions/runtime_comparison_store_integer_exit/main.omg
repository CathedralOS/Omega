// A raw comparison stored into an integer slot is its `{0, 1}` value:
// checking admits `hits = value == 70` as that coercion, and `as i32` of a
// Boolean already lowers as a total widening. The implicit store into a local
// and into an `i32 in Wrapping` field planned no scalar value row, so the
// state had no executable body ("scalar local: pure initializer",
// "structural field store: pure source: scalar expression row").
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) reaches Console {
    let value: i32 = 70;
    let matched: i32 = value == 70;
    let missed: i32 = value < 7;
    main.hits = value != 7;
    let total: i32 = matched + missed + (main.hits as i32);
    transition total == 2 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
