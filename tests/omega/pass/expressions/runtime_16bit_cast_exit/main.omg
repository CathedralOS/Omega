// 16-bit (i16/u16) named integer conversions: every conversion touching a
// 2-byte width used to be refused ("state mutation needs lowering") even though
// the x86_64 convert encoder already handled 2-byte
// (movzx/movsx-extend a word source; 0x66-prefixed word store). The selection
// gate only admitted 1/4/8-byte widths; widening it to also admit 2 unlocked the
// whole family. This locks every direction:
//   * u16 -> u8   (truncate)        511   -> 255
//   * i16 -> i32  (sign-extend)     -100  -> -100
//   * i32 -> i16  (truncate)        70000 -> 4464
//   * u8  -> u16  (zero-extend)     200   -> 200
//   * i16 -> i8   (truncate+sign)   200   -> -56
//   * u16 -> i16  (reinterpret)     40000 -> -25536
//
// All correct -> exit 70.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    u16val: u16 in Wrapping;
    i16val: i16 in Wrapping;
    i32val: i32 in Wrapping;
    u8val: u8 in Wrapping;
    trunc8: u8 in Wrapping;
    wide32: i32 in Trapping;
    narrow16: i16 in Wrapping;
    widened16: u16 in Wrapping;
    signed8: i8 in Wrapping;
    reinterp16: i16 in Wrapping;
}

machine Main::main(&mut self) {
    self.u16val = 511;
    self.i16val = 0 - 100;
    self.i32val = 70000;
    self.u8val = 200;

    // Conversion policy belongs to the named operation. The result returns to
    // Exact arithmetic, then is qualified separately for these policy-bearing
    // storage fields.
    self.trunc8 =
        narrow_u16_to_u8_wrapping(self.u16val as u16) as u8 in Wrapping; // 255
    self.wide32 =
        widen_i16_to_i32(self.i16val as i16) as i32 in Trapping; // -100
    self.narrow16 =
        narrow_i32_to_i16_wrapping(self.i32val as i32) as i16 in Wrapping; // 4464
    self.widened16 =
        widen_u8_to_u16(self.u8val as u8) as u16 in Wrapping; // 200

    transition self.trunc8 == 255 {
        true -> check_wide()
        _ -> bad()
    }
    state check_wide(&mut self) {
        transition self.wide32 == 0 - 100 { true -> check_narrow() _ -> bad() }
    }
    state check_narrow(&mut self) {
        transition self.narrow16 == 4464 { true -> check_widened() _ -> bad() }
    }
    state check_widened(&mut self) {
        transition self.widened16 == 200 { true -> check_i16_to_i8() _ -> bad() }
    }
    state check_i16_to_i8(&mut self) {
        self.i16val = 200;
        self.signed8 =
            narrow_i16_to_i8_wrapping(self.i16val as i16) as i8 in Wrapping; // -56
        transition self.signed8 == 0 - 56 { true -> check_reinterp() _ -> bad() }
    }
    state check_reinterp(&mut self) {
        self.u16val = 40000;
        self.reinterp16 =
            narrow_u16_to_i16_wrapping(self.u16val as u16) as i16 in Wrapping; // -25536
        transition self.reinterp16 == 0 - 25536 { true -> good() _ -> bad() }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
