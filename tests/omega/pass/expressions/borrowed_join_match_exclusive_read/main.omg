use omega_language_std::console;
data Pair { left: u64; right: u64; }
data Main { a: Pair; b: Pair; }
machine Main::main(main: &mut Main) reaches Console {
    main.a = Pair { left: 35, right: 0 };
    main.b = Pair { left: 9, right: 0 };
    let flag: bool = main.a.left == 35;
    let r: &mut Pair = match flag {
        true -> &mut main.a,
        _ -> &mut main.b
    };
    let v: u64 = r.left | r.left;
    transition v == 35 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
