// Anonymous numeric match subject: a comptime-folded giant-literal
// expression `2^64 / 2^64` evaluates to 1 exactly — the subject never
// binds a name.
machine identity(value: u64) -> u64 {
    value
}

machine choose() -> u64 {
    match 18446744073709551616 / 18446744073709551616 {
        0 -> identity(99),
        1 -> identity(7),
        _ -> identity(9)
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    transition choose() == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
