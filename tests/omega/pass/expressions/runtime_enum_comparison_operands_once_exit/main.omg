// Expected exit: 0. Each enum operand completes once, left before right.
data Choice [copy] { case First; case Second; }
data Counter { digits: u32 in Wrapping; }
machine choose(counter: &mut Counter, digit: u32 in Wrapping, first: bool) -> Choice {
    counter.digits = counter.digits * 10 + digit;
    transition first {
        true -> (Choice::First)
        false -> (Choice::Second)
    }
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { digits: 0 };
    let same: bool = choose(&mut counter, 1, true) == choose(&mut counter, 2, true);
    let different: bool = choose(&mut counter, 3, true) != choose(&mut counter, 4, false);
    transition same && different && counter.digits == 1234 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
