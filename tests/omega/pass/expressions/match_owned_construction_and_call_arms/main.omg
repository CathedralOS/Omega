use omega_language_std::console;
data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }
machine supply(first: u64, second: u64) -> Pair {
    Pair { first: Payload { left: first, right: second }, second: Payload { left: second, right: first } }
}
machine choose(selected: u64) -> u64 {
    let result: Payload = match selected {
        0 -> Payload { left: 4, right: 6 },
        _ -> supply(251, 249).second
    };
    result.left ^ result.right
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let a: u64 = choose(0);
    let b: u64 = choose(1);
    transition a == 2 && b == 2 { true -> good(main) _ -> bad(main) }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
