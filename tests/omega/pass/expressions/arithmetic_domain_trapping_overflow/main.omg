// Frozen decision 17, stage S1b: the `Trapping` arithmetic domain ABORTS the
// process on overflow (the native backend emits `ud2` after a width-correct add
// when the carry/overflow flag is set).
//
// 200 + 100 = 300 overflows u8, so `u8 in Trapping` traps -- the program never
// reaches the transition and never exits 70. This compiles cleanly (the trap is
// a runtime event); expected_native_exit.txt requires the exact target trap.
// A clean exit, missing execution or a different crash cannot satisfy it.

use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut a: u8 in Trapping = 200;
    let mut b: u8 in Trapping = 100;
    // Operand-driven: a/b carry the Trapping domain, so the add traps on overflow.
    let c: u8 in Trapping = a + b;   // 300 overflows u8 -> trap (ud2)
    transition c == 44 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
