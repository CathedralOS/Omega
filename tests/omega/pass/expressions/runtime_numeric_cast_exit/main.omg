use omega::language::core::float_operations;

// Numeric carrier coercions preserve their source values. A named truncating
// conversion makes the fractional change explicit. This chains a float
// computation into a named float->int conversion and an exact int->float
// coercion, so reaching exit 70 also confirms the
// f64 arithmetic result exactly: 9.0 / 2.0 = 4.5, truncated to 4, widened back
// to 4.0.

use omega_language_std::console;

data Main {
    real_value: f64;
    truncated: i32;
    widened: f64;
    narrow_source: i32;
    widened_int: i64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.real_value = 9.0;
    main.real_value = main.real_value / 2.0; // 4.5

    // float -> int truncates toward zero (4.5 -> 4).
    let converted: i32 in Saturating = I32::from_f64(main.real_value);
    main.truncated = converted as i32;
    transition main.truncated == 4 {
        true -> check_int_to_float(main)
        false -> bad(main)
    }

    state check_int_to_float(main: &mut Main) {
        // int -> float (4 -> 4.0).
        main.widened = main.truncated as f64;
        transition main.widened == 4.0 {
            true -> check_signed_widen(main)
            false -> bad(main)
        }
    }

    state check_signed_widen(main: &mut Main) {
        main.narrow_source = -100;
        // signed integer widening sign-extends (-100 stays -100, not 2^32-100).
        main.widened_int = main.narrow_source as i64;
        transition main.widened_int == -100 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
