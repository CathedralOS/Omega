use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

data Cell { tag: u8; narrow: f32; wide: f64; }
data Main {
    console: Binding<Console>;
    cells: [Cell; 2];
    position: u64;
    narrow: f32;
    wide: f64;
}
machine Main::main(&mut self) reaches Console {
    self.cells[0] = Cell { tag: 3, narrow: 1.0f32, wide: 2.0f64 };
    self.cells[1] = Cell { tag: 5, narrow: 7.5f32, wide: 12.25f64 };
    self.position = 1;
    transition self.position < 2 {
        true -> read(&mut self)
        false -> bad(&mut self)
    }
    state read(main: &mut Main) {
        main.narrow = main.cells[main.position].narrow;
        main.wide = main.cells[main.position].wide;
        transition main.narrow == 7.5f32 && main.wide == 12.25f64 {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
