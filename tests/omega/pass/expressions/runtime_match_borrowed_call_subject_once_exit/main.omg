// Forwarding a captured field never replays the effectful subject producer.
// Expected exit: 0
data Counter { value: u32 in Wrapping; }
data Cell { value: i32; }
data View<'storage> [copy] { target: &'storage Cell; }
machine produce<'storage>(counter: &mut Counter, cell: &'storage Cell) -> View<'storage> {
    counter.value = counter.value + 1;
    View { target: cell }
}
machine read(cell: &Cell) -> i32 { cell.value }
machine exercise() -> bool {
    let mut counter: Counter = Counter { value: 0 };
    let cell: Cell = Cell { value: 17 };
    let observed: i32 = match produce(&mut counter, &cell) {
        View { target } -> read(target)
    };
    observed == 17 && (counter.value as u32) == 1
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
