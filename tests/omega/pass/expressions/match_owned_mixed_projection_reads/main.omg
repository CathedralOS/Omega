use omega_language_std::console;

data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }

machine supply(first: u64, second: u64) -> Pair {
    Pair {
        first: Payload { left: first, right: second },
        second: Payload { left: second, right: first }
    }
}

// local projection on first arm, call projection on fallback arm
machine mix_a(selected: u64) -> u64 {
    let pair: Pair = Pair {
        first: Payload { left: 4, right: 6 },
        second: Payload { left: 8, right: 10 }
    };
    let result: Payload = match selected {
        0 -> pair.first,
        _ -> supply(251, 249).second
    };
    result.left
}

// call projection on first arm, local projection on fallback arm
machine mix_b(selected: u64) -> u64 {
    let pair: Pair = Pair {
        first: Payload { left: 4, right: 6 },
        second: Payload { left: 8, right: 10 }
    };
    let result: Payload = match selected {
        0 -> supply(251, 249).first,
        _ -> pair.second
    };
    result.left
}

// local projections on both arms
machine mix_c(selected: u64) -> u64 {
    let pair: Pair = Pair {
        first: Payload { left: 4, right: 6 },
        second: Payload { left: 8, right: 10 }
    };
    let result: Payload = match selected {
        0 -> pair.first,
        _ -> pair.second
    };
    result.left
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    // mix_a(1): arm _ -> supply.second -> left=249 expected
    let a: u64 = mix_a(1);
    transition a == 249 { true -> a_ok(main) _ -> exit(main, 81) }
    state a_ok(main: &mut Main) {
        // mix_b(1): arm _ -> pair.second -> left=8 expected
        let b: u64 = mix_b(1);
        transition b == 8 { true -> b_ok(main) _ -> exit(main, 82) }
    }
    state b_ok(main: &mut Main) {
        // mix_c(1): arm _ -> pair.second -> left=8 expected
        let c: u64 = mix_c(1);
        transition c == 8 { true -> c_ok(main) _ -> exit(main, 83) }
    }
    state c_ok(main: &mut Main) { Console::exit_process(70); }
    state exit(main: &mut Main, code: u64) { Console::exit_process(code as i32); }
}
