data Reading { value: u64; }
machine make(count: &mut u64) -> Reading {
    count = ((count as u64 in Wrapping) + 1) as u64;
    Reading { value: 70 }
}
machine observe(count: &mut u64) -> u64 {
    make(&mut count).value
}
machine main() crashes Trap {
    let mut count: u64 = 0;
    let value: u64 = observe(&mut count);
    transition value == 70 && count == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
