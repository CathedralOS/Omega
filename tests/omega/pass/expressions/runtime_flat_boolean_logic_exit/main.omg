// Flat boolean logic in guards and value position. Locks:
//   - a flat AND guard      (`a && b`)
//   - a flat OR guard       (`a || b`)
//   - a negation guard      (`!b`)
//   - a three-term AND guard (`a && c && !b`)
//   - a value-position bool  (`let r = a && !b`)
// (The nested mix `(a || b) && c` is a documented separate gap; flat logic works.)
// With a = true, b = false, c = true. Exits 70.

use omega_language_std::console;

data Main {
    a: bool;
    b: bool;
    c: bool;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = true;
    main.b = false;
    main.c = true;

    // a && b == false -> takes the `_` arm
    transition main.a && main.b { true -> bad(main) _ -> check_or(main) }

    state check_or(main: &mut Main) {
        // a || b == true
        transition main.a || main.b { true -> check_neg(main) _ -> bad(main) }
    }
    state check_neg(main: &mut Main) {
        // !b == true
        transition !main.b { true -> check_three(main) _ -> bad(main) }
    }
    state check_three(main: &mut Main) {
        // a && c && !b == true
        transition main.a && main.c && !main.b { true -> check_value(main) _ -> bad(main) }
    }
    state check_value(main: &mut Main) {
        let r: bool = main.a && !main.b; // true
        transition r { true -> good(main) _ -> bad(main) }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
