// Copyable descriptor custody keeps its captured pointer across source replacement.
// Expected exit: 0
data Cell { value: i32; }
data View<'storage> [copy] { target: &'storage Cell; }
machine replace<'storage>(view: &mut View<'storage>, incoming: &'storage Cell) -> bool {
    view.target = incoming;
    true
}
machine exercise() -> bool {
    let first: Cell = Cell { value: 17 };
    let second: Cell = Cell { value: 19 };
    let mut view: View = View { target: &first };
    let observed: i32 = match view {
        View { target } if replace(&mut view, &second) -> target.value
        _ -> 0
    };
    observed == 17 && view.target.value == 19
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
