use omega_language_std::console;

data Main { }
data Pair { first: u32; second: u32; }

machine retained(value: u32) -> u32 { value }

machine combined(left: u32, right: u32) -> u32 {
    Pair {
        first: Pair { first: left, second: retained(right) }.first,
        second: right,
    }.first ^ Pair { first: right, second: left }.second
}

machine Main::main(main: &mut Main) reaches Console {
    let value: u32 = combined(7u32, 21u32);
    transition value == 0u32 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
