// RUN CANARY (exit 70). Borrow-carrying data (frozen decision 15 stage 2/3):
// a `data` value may HOLD a borrow (`Msg { body: &Cell }`). Constructing one
// (`Msg { body: &main.cell }`) and reading its reference field (`m.body`)
// extracts the borrowed source -- the struct-literal field-extraction fold that
// also fixes a plain local aggregate's field read (`let p = Pair{..}; p.a`).
// The extracted `&Cell` is then dereferenced through a `&Cell` ref parameter.
//
// main.cell.value = 70 -> m.body -> read_cell derefs c.value -> 70 -> exit 70.

use omega_language_std::console;

data Cell { value: i32; }
data Msg { body: &Cell; }

data Main {
    cell: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    let message: Msg = Msg { body: &main.cell };
    let code: i32 = read_cell(message.body);
    transition code == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

machine read_cell(item: &Cell) -> i32 {
    transition {
        _ -> item.value
    }
}
