// RUN CANARY (exit 70). An integer operation whose operands carry no carrier
// anywhere -- `match` results built only from anonymous literals, or one such
// match beside a literal -- is anonymous as a whole, so it lands at the
// destination that stores it: a local, a call argument, or a result.
// fail/expressions/match_operand_anonymous_operation_overflow pins that the
// destination is the carrier the exact-arithmetic proof uses.

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine take(value: u8) -> u8 { value }

machine product(flag: bool) -> i64 {
    match flag { true -> 2 _ -> 5 } * match flag { true -> 7 _ -> 11 }
}

machine Main::main(main: &mut Main) reaches Console {
    let near: bool = product(true) == 14;
    let sum: i32 = match near {
        true -> 10
        _ -> 20
    } + match near {
        true -> 3
        _ -> 4
    };
    let difference: u8 = take(50 - match near { true -> 8 _ -> 9 });
    transition sum == 13 && difference == 42 {
        true -> good(main, near)
        _ -> bad(main)
    }
    state good(main: &mut Main, near: bool) {
        let mut later: i32 = match near { true -> 1 _ -> 2 } + 30;
        transition later == 31 {
            true -> done(main)
            _ -> bad(main)
        }
    }
    state done(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
