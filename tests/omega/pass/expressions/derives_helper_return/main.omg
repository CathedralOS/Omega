// A helper machine DERIVES a narrower `File` authority from a
// caller-provided `Folder` at the `Filesystem` boundary and returns it;
// the outer `open_main_log` only forwards its folder, so the authority
// flow propagates `derives` up the call graph.

pub domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

pub data Folder {
}
pub data File {
}
pub domain File::Writable
established by Filesystem::open;

pub boundary trait Filesystem {
    machine open(folder: Folder, path: &[u8] in Utf8) -> File
    ensures
        result in File::Writable
    reaches
        Filesystem;
}

data Worker {
}
machine Worker::open_log(worker: &mut Worker, folder: Folder) -> File
reaches
    Filesystem
{
    Filesystem::open(folder, "log.txt")
}
machine Worker::open_main_log(worker: &mut Worker, folder: Folder) -> File
reaches
    Filesystem
{
    Worker::open_log(worker, folder)
}

data Main { worker: Worker; }
machine Main::main(main: &mut Main) reaches Filesystem {
    let folder: Folder = Folder {};
    let file: File = Worker::open_main_log(&mut main.worker, folder);
}
