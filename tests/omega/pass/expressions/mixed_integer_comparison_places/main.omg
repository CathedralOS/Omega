use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    signed: i32;
    unsigned: u64;
    signed_maximum: i64;
    unsigned_maximum: u64;
}

machine Main::main(&mut self) reaches Console {
    self.signed = 0 - 1;
    self.unsigned = 10;
    self.signed_maximum = 9223372036854775807;
    self.unsigned_maximum = 18446744073709551615;
    transition self.signed < self.unsigned {
        true -> boundaries(&mut self)
        _ -> promoted(&mut self)
    }

    state boundaries(main: &mut Main) {
        transition main.signed < main.unsigned_maximum
            && main.signed <= main.unsigned_maximum
            && !(main.signed > main.unsigned_maximum)
            && !(main.signed >= main.unsigned_maximum)
            && !(main.signed == main.unsigned_maximum)
            && main.signed != main.unsigned_maximum
            && main.unsigned_maximum > main.signed_maximum
            && main.unsigned_maximum >= main.signed_maximum
            && !(main.unsigned_maximum < main.signed_maximum)
            && !(main.unsigned_maximum <= main.signed_maximum)
            && !(main.unsigned_maximum == main.signed_maximum)
            && main.unsigned_maximum != main.signed_maximum {
            true -> correct(main)
            _ -> promoted(main)
        }
    }

    // 70 when the compiler keeps `-1` negative, 71 when it promotes the
    // signed value into the unsigned carrier instead.
    state correct(main: &mut Main) { main.console.exit_process(70); }
    state promoted(main: &mut Main) { main.console.exit_process(71); }
}
