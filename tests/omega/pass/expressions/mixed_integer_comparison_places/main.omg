use omega_language_std::console;

data Main {
    signed: i32;
    unsigned: u64;
    signed_maximum: i64;
    unsigned_maximum: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.signed = 0 - 1;
    main.unsigned = 10;
    main.signed_maximum = 9223372036854775807;
    main.unsigned_maximum = 18446744073709551615;
    transition main.signed < main.unsigned {
        true -> boundaries(main)
        _ -> promoted(main)
    }

    state boundaries(main: &mut Main) {
        transition main.signed < main.unsigned_maximum
            && main.signed <= main.unsigned_maximum
            && !(main.signed > main.unsigned_maximum)
            && !(main.signed >= main.unsigned_maximum)
            && !(main.signed == main.unsigned_maximum)
            && main.signed != main.unsigned_maximum
            && main.unsigned_maximum > main.signed_maximum
            && main.unsigned_maximum >= main.signed_maximum
            && !(main.unsigned_maximum < main.signed_maximum)
            && !(main.unsigned_maximum <= main.signed_maximum)
            && !(main.unsigned_maximum == main.signed_maximum)
            && main.unsigned_maximum != main.signed_maximum {
            true -> correct(main)
            _ -> promoted(main)
        }
    }

    // 70 when the compiler keeps `-1` negative, 71 when it promotes the
    // signed value into the unsigned carrier instead.
    state correct(main: &mut Main) { Console::exit_process(70); }
    state promoted(main: &mut Main) { Console::exit_process(71); }
}
