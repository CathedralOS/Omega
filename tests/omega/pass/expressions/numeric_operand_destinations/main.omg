machine choose(flag: bool) -> u64 {
    (match flag {
        true -> 18446744073709551616 / 18446744073709551616
        false -> 7 / 2 * 2
    }) as u64
}

machine combine(flag: bool) -> u64 { choose(flag) | 8u64 }

machine direct() -> u64 {
    (18446744073709551616 / 18446744073709551616) | 8u64
}

machine composed(flag: bool) -> u64 {
    (match flag {
        true -> 18446744073709551616 / 18446744073709551616
        false -> 7 / 2 * 2
    }) | (8u64 | 16u64)
}

machine main() -> u64 { combine(true) | composed(false) }
