use omega_language_std::console;
data Main { xs: [u64; 4]; ys: [u64; 4]; i: u64; }
machine Main::main(main: &mut Main) reaches Console {
    main.xs = [0, 0, 0, 0];
    main.ys = [0, 0, 0, 0];
    main.i = 2;
    let flag: bool = main.i == 2;
    let r: &mut [u64; 4] = match flag {
        true -> &mut main.xs,
        _ -> &mut main.ys
    };
    r[main.i] = 70;
    transition main.xs[2] == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
