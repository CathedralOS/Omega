// A saved outer subject's nested tag test observes the inner carrier.
// Expected exit: 0
data Probe [copy] { case Active(value: i32); case Empty; }
data Container [copy] { inner: Probe; }
machine exercise() -> bool {
    let container: Container = Container { inner: Probe::Empty {} };
    let observed: i32 = match container {
        Container { inner } if inner in Probe::Active -> 0
        Container { inner } if inner in Probe::Empty -> 41
        _ -> 0
    };
    observed == 41
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
