// A field predicate invokes ordinary selected equality, not raw structural equality.
// Expected exit: 0
trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}
data Point [copy] { value: i32; }
PointEquality satisfies Equatable<Point> {
    machine equals(left: &Point, right: &Point) -> bool { false }
}
data Container [copy] { point: Point; }
machine exercise() -> bool {
    let container: Container = Container { point: Point { value: 41 } };
    let observed: i32 = match container {
        Container { point: (Point { value: 41 }) } -> 0
        _ -> 41
    };
    observed == 41
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
