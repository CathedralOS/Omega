use omega_language_std::console;

data Main {
    text: [u8; 8];
    i: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.i = 0;
    transition { _ -> step(main) }

    state step(main: &mut Main) {
        transition main.i < main.text.len {
            true -> guarded(main)
            _ -> done(main)
        }
    }

    // The re-guard keeps the increment's own overflow obligation out of the
    // way, exactly as `cli/text/parse_int` does, so the guard comparison is
    // the only thing this fixture pins.
    state guarded(main: &mut Main) {
        transition main.i >= 0 && main.i < 8 {
            true -> bump(main)
            _ -> done(main)
        }
    }

    state bump(main: &mut Main) {
        main.i = main.i + 1;
        transition { _ -> step(main) }
    }

    state done(main: &mut Main) {
        transition main.i == 8 {
            true -> correct(main)
            _ -> incorrect(main)
        }
    }
    state correct(main: &mut Main) { Console::exit_process(70); }
    state incorrect(main: &mut Main) { Console::exit_process(71); }
}
