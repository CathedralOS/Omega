use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    text: [u8; 8];
    i: i32;
}

machine Main::main(&mut self) reaches Console {
    self.i = 0;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.i < self.text.len {
            true -> guarded()
            _ -> done()
        }
    }

    // The re-guard keeps the increment's own overflow obligation out of the
    // way, exactly as `cli/text/parse_int` does, so the guard comparison is
    // the only thing this fixture pins.
    state guarded(&mut self) {
        transition self.i >= 0 && self.i < 8 {
            true -> bump()
            _ -> done()
        }
    }

    state bump(&mut self) {
        self.i = self.i + 1;
        transition { _ -> step() }
    }

    state done(&mut self) {
        transition self.i == 8 {
            true -> correct()
            _ -> incorrect()
        }
    }
    state correct(&mut self) { self.console.exit_process(70); }
    state incorrect(&mut self) { self.console.exit_process(71); }
}
