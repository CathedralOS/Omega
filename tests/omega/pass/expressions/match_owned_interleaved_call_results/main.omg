data Choice {
    case Empty;
    case Some(value: u32);
}

data Marker { tag: u64; }

machine choose(selected: bool, tag: u64) -> bool {
    let left: Choice = Choice::Some { value: 37 };
    let marker: Marker = Marker { tag: tag };
    let right: Choice = Choice::Empty;
    let result: Choice = match selected {
        true -> left,
        false -> right
    };
    let observed: bool = result in Choice::Some;
    marker.tag == tag && observed
}

use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let a: bool = choose(true, 9);
    let b: bool = choose(false, 9);
    transition a && !b {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
