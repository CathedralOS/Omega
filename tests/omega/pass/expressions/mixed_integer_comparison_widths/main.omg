use omega_language_std::console;
data Main { small: i8; big: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.small = 44;
    main.big = 300;
    transition main.small == main.big { true -> hit(main) _ -> miss(main) }
    state hit(main: &mut Main) { Console::exit_process(1); }
    state miss(main: &mut Main) { Console::exit_process(2); }
}
