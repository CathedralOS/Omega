use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; small: i8; big: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.small = 44;
    main.big = 300;
    transition main.small == main.big { true -> hit(main) _ -> miss(main) }
    state hit(main: &mut Main) { main.console.exit_process(1); }
    state miss(main: &mut Main) { main.console.exit_process(2); }
}
