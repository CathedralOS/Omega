// RUN CANARY (exit 70). Frozen decision 17, stage S1a: the `Wrapping` arithmetic
// domain parses (`u8 in Wrapping`) and wraps modulo the operand width.
//
// 200 + 100 = 300, which wraps to 300 - 256 = 44 in u8. The current integer
// codegen already wraps at the operand width, so `T in Wrapping` is transparent
// at this stage (it documents intent and reserves the surface); the distinct
// `Saturating`/`Trapping` codegen and exact-by-default overflow ENFORCEMENT land
// in later stages.

use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut a: u8 in Wrapping = 200;
    let mut b: u8 in Wrapping = 100;
    // Operand-driven (decision 17): the Wrapping domain lives on a/b's types.
    let c: u8 in Wrapping = a + b;   // 300 wraps to 44 (u8)
    transition c == 44 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
