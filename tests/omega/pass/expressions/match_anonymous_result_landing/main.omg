// Expected exit: 70.
use omega_language_std::Console;

// The anonymous join keeps both arms exact; the whole-expression cast lands
// the selected arm and acknowledges the `7/2` intermediate.
machine choose(flag: bool) -> u64 {
    (match flag {
        true -> 18446744073709551616 / 18446744073709551616
        false -> 7 / 2 * 2
    }) as u64
}

machine main() -> u64 { choose(true) }

// The reusable calculations above retain their original inputs and shapes.
machine entry_start() reaches Console {
    let outcome: i32 = match main() == 1u64 && choose(false) == 7u64 {
        true -> 70,
        false -> 71
    };
    Console::exit_process(outcome);
}
