data Payload { left: u64; right: u64; }
data Envelope { leading: u64; payload: Payload; }
machine Payload::get_right(payload: &Payload) -> u64 { payload.right }

machine choose(selected: u64, inner: bool, first: u64, second: u64) -> u64 {
    let marker: Payload = Payload { left: 37, right: 91 };
    let left: Envelope = Envelope {
        leading: first,
        payload: Payload { left: first, right: second }
    };
    let right: Envelope = Envelope {
        leading: second,
        payload: Payload { left: second, right: first }
    };
    let result: Envelope = match selected {
        0 -> left,
        1 -> right,
        _ -> Envelope {
            payload: match inner {
                true -> Payload { right: first ^ 255, left: second },
                false -> Payload { right: second ^ 255, left: first }
            },
            leading: first
        }
    };
    Payload::get_right(&result.payload) ^ marker.left
}

use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let a: u64 = choose(0, true, 4, 6);
    let b: u64 = choose(1, false, 4, 6);
    let c: u64 = choose(2, true, 4, 6);
    transition a == 35 && b == 33 && c == 222 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
