// Expected exit: 0
use omega::language::core::drop;
data Item [linear] { value: u64; }
machine Item::drop(item: &mut Item) {}
machine issue(value: u64) -> Item { Item { value: value } }
machine choose(select: bool) -> bool {
    let first: Item = match select { true -> issue(17), false -> issue(19) };
    let second: Item = match select { true -> issue(23), false -> issue(29) };
    let correct: bool = (select && first.value == 17 && second.value == 23)
        || (!select && first.value == 19 && second.value == 29);
    drop(first);
    drop(second);
    correct
}
machine main() crashes Trap {
    let first: bool = choose(true);
    let second: bool = choose(false);
    transition first && second { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
