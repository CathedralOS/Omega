use omega_language_std::console;
data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }
machine select_field(selected: bool, a: Pair, b: Pair) -> Payload {
    match selected { true -> a.first, false -> b.second }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let d: Payload = select_field(false, Pair { first: Payload { left: 1, right: 2 }, second: Payload { left: 3, right: 4 } }, Pair { first: Payload { left: 5, right: 6 }, second: Payload { left: 7, right: 8 } });
    transition d.left == 7 && d.right == 8 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
