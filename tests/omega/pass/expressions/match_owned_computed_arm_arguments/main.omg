use omega_language_std::console;

data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }

machine supply(first: u64, second: u64) -> Pair {
    Pair {
        first: Payload { left: first, right: second },
        second: Payload { left: second, right: first }
    }
}

// literal-constructed pair, computed call args
machine mix_d(selected: u64, first: u64, second: u64) -> u64 {
    let pair: Pair = Pair {
        first: Payload { left: 4, right: 6 },
        second: Payload { left: 8, right: 10 }
    };
    let result: Payload = match selected {
        0 -> pair.first,
        _ -> supply(first ^ 255, second ^ 255).second
    };
    result.left
}

// parameter-constructed pair, literal call args
machine mix_e(selected: u64, first: u64, second: u64) -> u64 {
    let pair: Pair = Pair {
        first: Payload { left: first, right: second },
        second: Payload { left: second, right: first }
    };
    let result: Payload = match selected {
        0 -> pair.first,
        _ -> supply(251, 249).second
    };
    result.left
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    // mix_d(1,4,6): supply(251,249).second.left = 249 expected
    let d: u64 = mix_d(1, 4, 6);
    transition d == 249 { true -> d_ok(main) _ -> exit(main, 81) }
    state d_ok(main: &mut Main) {
        // mix_e(1,4,6): same supply.second.left = 249 expected
        let e: u64 = mix_e(1, 4, 6);
        transition e == 249 { true -> e_ok(main) _ -> exit(main, 82) }
    }
    state e_ok(main: &mut Main) { Console::exit_process(70); }
    state exit(main: &mut Main, code: u64) { Console::exit_process(code as i32); }
}
