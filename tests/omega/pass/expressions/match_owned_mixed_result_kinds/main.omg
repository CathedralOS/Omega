data Choice {
    case Empty;
    case Some(value: u32);
}

machine choose(selected: bool) -> bool {
    let left: Choice = Choice::Some { value: 37 };
    let result: Choice = match selected {
        true -> left,
        false -> Choice::Empty
    };
    result in Choice::Some
}

use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let a: bool = choose(true);
    let b: bool = choose(false);
    transition a && !b {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
