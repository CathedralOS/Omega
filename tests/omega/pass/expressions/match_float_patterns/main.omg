use omega::language::core::float_operations;
use omega::language::core::binding;
use omega_language_std::console;

machine identity(value: f32) -> f32 { value }

machine choose(value: f32, first: f32, second: f32) -> u64 {
    match identity(value) {
        identity(first) -> 7,
        identity(second) -> 9,
        _ -> 11
    }
}

data Main { console: Binding<Console>; }

// Preserve the reusable call-bearing comparison and observe first-match,
// second-match, fallback and signed-zero behavior through the native product.
machine Main::main(&mut self)
reaches Console
{
    let first: u64 = choose(2.0f32, 2.0f32, 2.0f32);
    let second: u64 = choose(2.0f32, 1.0f32, 2.0f32);
    let fallback: u64 = choose(3.0f32, 1.0f32, 2.0f32);
    let zeros: u64 = choose(-0.0f32, 0.0f32, 0.0f32);
    let outcome: i32 = match first == 7 && second == 9 && fallback == 11 && zeros == 7 {
        true -> 70,
        false -> 71
    };
    self.console.exit_process(outcome);
}
