use omega::language::core::float_operations;

machine identity(value: f32) -> f32 { value }

machine choose(value: f32, first: f32, second: f32) -> u64 {
    match identity(value) {
        identity(first) -> 7,
        identity(second) -> 9,
        _ -> 11
    }
}

// The reusable comparison remains testable with runtime arguments; this root
// also requires the same call-bearing closure to publish as an application.
machine launch() {
    let result: u64 = choose(2.0f32, 1.0f32, 2.0f32);
}
