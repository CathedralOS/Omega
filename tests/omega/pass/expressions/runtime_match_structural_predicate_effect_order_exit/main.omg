// A failed tag skips field predicates; a failed field skips its guard.
// Selected guards execute exactly once, and later arms do not execute.
// Expected exit: 0
data Counter { value: u32 in Wrapping; }
data Probe { case Active(value: i32); case Empty; }
machine count(counter: &mut Counter) -> i32 {
    counter.value = counter.value + 1;
    0
}
machine allow(counter: &mut Counter) -> bool {
    counter.value = counter.value + 1;
    true
}
machine deny(counter: &mut Counter) -> bool {
    counter.value = counter.value + 1;
    false
}
machine exercise() -> bool {
    let mut tag_counter: Counter = Counter { value: 0 };
    let empty: Probe = Probe::Empty {};
    let tag_result: i32 = match empty {
        Probe::Active { value: count(&mut tag_counter) } if allow(&mut tag_counter) -> 0
        Probe::Empty {} if allow(&mut tag_counter) -> 41
        _ -> count(&mut tag_counter)
    };
    let mut field_counter: Counter = Counter { value: 0 };
    let active: Probe = Probe::Active { value: 1 };
    let field_result: i32 = match active {
        Probe::Active { value: 0 } if allow(&mut field_counter) -> 0
        Probe::Active { value as _ } if allow(&mut field_counter) -> 41
        _ -> count(&mut field_counter)
    };
    let mut fallback_counter: Counter = Counter { value: 0 };
    let fallback: Probe = Probe::Active { value: 1 };
    let fallback_result: i32 = match fallback {
        Probe::Active { value as _ } if deny(&mut fallback_counter) -> 0
        Probe::Active { value as _ } if allow(&mut fallback_counter) -> 41
        _ -> 0
    };
    tag_result == 41 && field_result == 41
        && (tag_counter.value as u32) == 1 && (field_counter.value as u32) == 1
        && fallback_result == 41 && (fallback_counter.value as u32) == 2
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
