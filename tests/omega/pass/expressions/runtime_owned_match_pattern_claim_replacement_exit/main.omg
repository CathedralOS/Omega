// Expected exit: 0
use omega::language::core::drop;
data Token [linear] { code: u64; }
machine Token::drop(token: &mut Token) { token.code = 0; }
data Parcel { token: Token; marker: u64; }
machine replace(parcel: &mut Parcel) -> u64 {
    let old: Token = parcel.token;
    drop(old);
    parcel.token = Token { code: 23 };
    1
}
machine through(choice: u64) -> bool {
    let mut parcel: Parcel = Parcel { token: Token { code: 19 }, marker: 7 };
    let selected: Parcel = match choice {
        0 -> parcel
        replace(&mut parcel) -> parcel
        _ -> parcel
    };
    let observed: bool = (choice == 0 && selected.token.code == 19)
        || (choice != 0 && selected.token.code == 23);
    drop(selected.token);
    observed
}
machine main() crashes Trap {
    transition through(0) && through(1) && through(2) { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
