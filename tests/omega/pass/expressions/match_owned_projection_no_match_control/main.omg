use omega_language_std::console;

data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }

machine supply(first: u64, second: u64) -> Pair {
    Pair {
        first: Payload { left: first, right: second },
        second: Payload { left: second, right: first }
    }
}

machine via_let(first: u64, second: u64) -> u64 {
    let whole: Pair = supply(first, second);
    let result: Payload = whole.second;
    result.left
}

machine direct(first: u64, second: u64) -> u64 {
    let result: Payload = supply(first, second).second;
    result.left
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let a: u64 = via_let(251, 249);
    let b: u64 = direct(251, 249);
    transition a == 249 && b == 249 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
