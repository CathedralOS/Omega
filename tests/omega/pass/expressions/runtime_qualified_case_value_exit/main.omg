// RUN CANARY (exit 70, differential): a REAL qualified enum case in value
// position (`Signal::Green`) stays accepted -- the positive twin of the
// two-segment existence check (fail/expressions/
// undeclared_two_segment_path_rejected). It resolves to a valid case symbol
// before validation, so the new both-symbols-unresolved reject never fires
// on it. Discriminating: the bound case must equal Signal::Green (a missed
// resolution would read ZII = the first case, Red, and fall to exit 71).
use omega::language::std::console;
data Signal { case Red; case Green; }
data Main { console: Console; }
machine Main::main(&mut self) {
    let s: Signal = Signal::Green;
    transition s == Signal::Green { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
