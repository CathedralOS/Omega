// RUN CANARY (exit 70). NEGATIVE-i32 arithmetic in a transition GUARD subject.
// `self.x - 1 == -9` for x = -8 used to take the WRONG arm natively: a computed
// value-operand loaded the i32 zero- (not sign-) extended into a 64-bit register,
// but the compare ran 64-bit, so a negative result's high bits diverged. Fixed by
// computing a Binary value-operand's byte_size from the NON-immediate operand
// (runtime_value_compare_byte_size) instead of max() -- an integer literal reports
// width 8 and would otherwise widen the whole expression. The compare then runs at
// the i32 width (32-bit), so only the correct low bytes matter.
//
// The interpreter always evaluated this correctly (i64), so it was a native-only
// miscompile; the differential oracle now pins it. Every arm is reached only on a
// correct guard, so a regression exits 71-74. (Add/Sub/Mul are modular; div/mod
// with a negative dividend is a separate, deeper case -- see
// guard-negative-i32-arithmetic memory.)

use omega_language_std::console;

data Main {
    console: Console;
    x: i32;
}

machine Main::main(&mut self) {
    self.x = 0 - 8;

    // -8 - 1 = -9  (TRUE)
    transition self.x - 1 == -9 {
        true -> check_add_neg()
        _ -> bad(71)
    }

    // -8 + 1 = -7  (TRUE)
    state check_add_neg(&mut self) {
        transition self.x + 1 == -7 {
            true -> check_false()
            _ -> bad(72)
        }
    }

    // -8 - 1 = -9, which is NOT -3  (FALSE -> false arm)
    state check_false(&mut self) {
        transition self.x - 1 == -3 {
            true -> bad(73)
            _ -> check_pos_result()
        }
    }

    // -8 + 10 = 2  (negative operand, positive result; TRUE)
    state check_pos_result(&mut self) {
        transition self.x + 10 == 2 {
            true -> good()
            _ -> bad(74)
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
