// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: match_join.
// Expected exit: 0
machine choose(counter: &mut u64) -> bool { counter = 91; true }

machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut backing[..]];
    let mut counter: u64 = 0;
    let selected: [&mut [u8]; 1] = match choose(&mut counter) {
        true -> windows
        false -> windows
    };
    let length: u64 = selected[0].len;
    let observed: bool = selected[0][0] == 19 && length == 1 && counter == 91;
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
