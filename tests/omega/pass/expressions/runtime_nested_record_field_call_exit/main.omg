data Input { value: u64; }
data Reading { value: u64; }
machine produce(count: &mut u64) -> Input {
    count = ((count as u64 in Wrapping) + 1) as u64;
    Input { value: count }
}
machine make(input: Input) -> Reading { Reading { value: input.value } }
machine observe(count: &mut u64) -> u64 {
    make(produce(&mut count)).value
}
machine observe_local(count: &mut u64) -> u64 {
    let input: Input = produce(&mut count);
    make(input).value
}
machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}
machine combine(left: Input, middle: u64, right: Input) -> Reading {
    Reading { value: (((left.value as u64 in Wrapping) * 100)
        + ((middle as u64 in Wrapping) * 10)
        + (right.value as u64 in Wrapping)) as u64 }
}
machine observe_order(count: &mut u64) -> u64 {
    combine(produce(&mut count), tick(&mut count), produce(&mut count)).value
}
machine main() crashes Trap {
    let mut count: u64 = 0;
    let value: u64 = observe(&mut count);
    let local_value: u64 = observe_local(&mut count);
    let ordered_value: u64 = observe_order(&mut count);
    transition value == 1 && local_value == 2 && ordered_value == 345 && count == 5 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
