// RUN canary: owned match sources inside an authored state edge. The match
// selects one live owner while an interleaved owner stays live; the selected
// result and the interleaved owner cross the transition into the successor's
// owned parameters, and the displaced source dies on the selected edge.
use omega_language_std::console;

data Choice {
    case Empty;
    case Some(value: u32);
}

data Marker { tag: u64; }

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let selected: bool = true;
    let tag: u64 = 9;
    let left: Choice = Choice::Some { value: 37 };
    let marker: Marker = Marker { tag: tag };
    let right: Choice = Choice::Empty;
    let result: Choice = match selected {
        true -> left,
        false -> right
    };
    let observed: bool = result in Choice::Some;
    transition observed {
        true -> kept(result, marker, main)
        false -> kept(result, marker, main)
    }
    state kept(result: Choice, marker: Marker, main: &mut Main) {
        let bonus: u64 = match result in Choice::Some {
            true -> 1u64,
            false -> 2u64
        };
        transition marker.tag == 9 && bonus == 1 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
