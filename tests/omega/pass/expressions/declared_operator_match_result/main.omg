// OPERATOR-MACHINE-SUPPLY acceptance: a fixed token after `machine` binds `+`
// on borrowed test-owned `Wrapped` operands to the declaration's own checked body. The
// selected true arm invokes that body and yields the wrapped sum 250 + 10 =
// 260u64, which no `u8` builtin could carry; the false arm folds to 1 without
// invoking the operator. Nothing is searched among satisfiers: the
// declaration owns its body, and the same declaration stays callable by name.
// RUN CANARY (exit 70): `main` observes all three results natively and exits
// 70 only when `select_true` and `by_name` yield 260 and `select_false`
// yields 1; any other result exits 71.
use omega_language_std::console;

pub data Wrapped { value: u8; }

pub machine + Wrapped::add(left: &Wrapped, right: &Wrapped) -> u64 {
    (left.value as u64) + (right.value as u64)
}

machine choose(flag: bool, left: &Wrapped, right: &Wrapped) -> u64 {
    match flag {
        true -> left + right,
        false -> 18446744073709551616 / 18446744073709551616
    }
}

machine select_true() -> u64 {
    let left: Wrapped = Wrapped { value: 250u8 };
    let right: Wrapped = Wrapped { value: 10u8 };
    choose(true, &left, &right)
}

machine select_false() -> u64 {
    let left: Wrapped = Wrapped { value: 250u8 };
    let right: Wrapped = Wrapped { value: 10u8 };
    choose(false, &left, &right)
}

machine by_name() -> u64 {
    let left: Wrapped = Wrapped { value: 250u8 };
    let right: Wrapped = Wrapped { value: 10u8 };
    Wrapped::add(&left, &right)
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let selected: u64 = select_true();
    let skipped: u64 = select_false();
    let named: u64 = by_name();
    transition selected == 260 && skipped == 1 && named == 260 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
