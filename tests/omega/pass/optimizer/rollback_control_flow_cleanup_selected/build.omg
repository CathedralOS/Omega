// The build authors `ControlFlowCleanup` by exact name so compilation exercises the
// Psi rule's own rewrite; the fixture's declared `rollback.txt` overlay
// subtracts it again, so the check leg's Terminal-artifact pair compares
// the rolled-back semantic module against the unrolled one.

machine build(builder: &mut Build) {
    Build::application(builder, "rollback_control_flow_cleanup_selected");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::ControlFlowCleanup,
    );
}
