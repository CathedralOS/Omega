// `ControlFlowCleanup` folds a constant conditional branch and removes the
// region its untaken edge strands. `decided` binds a literal `true`, so
// the branch always jumps `taken` and `untaken` is unreachable: the
// selected build's Terminal semantic module drops the folded branch's dead
// region, which the check leg's `module:differs` fact pins before the
// declared rollback subtracts the rule and the pair's two fingerprints
// record the rejoined module.

machine main() {
    let decided: bool = true;

    transition decided {
        true -> taken()
        _ -> untaken()
    }

    machine taken() { }
    machine untaken() { }
}
