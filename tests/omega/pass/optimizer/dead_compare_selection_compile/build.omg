// The build selects the constant-flag folds and dead-compare removal by
// exact name, so compilation exercises their composed execution through
// the pre-allocation stage catalog — folding the branch leaves the
// compare's flag publication unread, and the dead-compare pass removes
// it — and the native run observes the decided branch: the program exits
// 0 when `decide(7i64)` still returns 43 and traps otherwise.

machine build(builder: &mut Build) {
    Build::application(builder, "dead_compare_selection_compile");
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_arm64::ProgramEntry, main);
    builder.roots.bind(macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::SelectedConstantBooleanFoldV1,
    );
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::SelectedConstantBranchFoldV1,
    );
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::SelectedDeadCompareRemovalV1,
    );
}
