// The control for the join-invariant transport fixtures: the same consumed
// literal join and the same copy parameter `probe` bound to `other` on both
// incoming edges, but no runtime index obligation, so no scalar block
// invariant is retained for the join. `CopyPropagation` still collapses
// `probe` and `DeadPureScalarElimination` still removes `unused` -- and, no
// invariant naming it, removes `probe` itself -- while the report carries no
// withheld rewrite. Without this control a route that reported every
// selected pass would look identical to transport succeeding.
machine choose(other: u64) -> i32 {
    let unused: bool = other == 7u64;
    transition other == 0u64 {
        true -> joined(other, 10)
        _ -> joined(other, 99)
    }

    machine joined(probe: u64, choice: i32) -> i32 {
        transition choice < 50 {
            true -> (choice)
            _ -> (choice)
        }
    }
}

machine main() crashes Trap {
    let decided: i32 = choose(0);
    transition decided == 10 {
        true -> done()
        _ -> bad()
    }

    machine done() {}
    machine bad() { crash Trap; }
}
