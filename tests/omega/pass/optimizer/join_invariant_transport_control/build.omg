// The control build authors the same two rules as the selected fixtures but
// the program retains no join invariant, so the pair pins that selection and
// execution do not depend on an invariant existing.

machine build(builder: &mut Build) {
    Build::application(builder, "join_invariant_transport_control");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::CopyPropagation,
    );
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::DeadPureScalarElimination,
    );
}
