// `CopyPropagation` substitutes a block parameter bound by a single
// edge's carried value. `merge`'s `carried` parameter receives `produced`
// on the only incoming edge, so the rule drops the parameter operation
// and the comparison reads `produced` directly: the check leg's
// `module:differs` fact pins the substitution before the declared
// rollback subtracts the rule and the pair's two fingerprints record the
// rejoined module.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();

    transition {
        _ -> merge(produced)
    }

    machine merge(carried: i32) {
        transition carried == 7 {
            true -> done()
            _ -> done()
        }
    }

    machine done() { }
}
