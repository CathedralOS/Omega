// The build selects the sole equivalent-compare removal by exact name, so
// compilation exercises its execution through the pre-allocation stage
// catalog and the native run observes the result: the program exits 0
// when `probe(7i64)` still returns 0 and traps otherwise.

machine build(builder: &mut Build) {
    Build::application(builder, "equivalent_compare_selection_compile");
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_arm64::ProgramEntry, main);
    builder.roots.bind(macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::SelectedEquivalentCompareRemovalV1,
    );
}
