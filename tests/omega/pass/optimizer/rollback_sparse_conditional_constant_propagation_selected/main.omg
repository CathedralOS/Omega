// `SparseConditionalConstantPropagation` folds scalar computations whose
// operands resolve to literals. `addend` binds the literal `2`, so
// `addend + 3` folds to `5` and `folded == 5` folds to the `true`
// constant: the selected build's Terminal semantic module replaces the
// arithmetic and the comparison with literal operations, which the check
// leg's `module:differs` fact pins before the declared rollback subtracts
// the rule and the pair's two fingerprints record the rejoined module.

machine main() {
    let addend: i32 in Wrapping = 2;
    let folded: i32 in Wrapping = addend + 3;

    transition folded == 5 {
        true -> done()
        _ -> done()
    }

    machine done() { }
}
