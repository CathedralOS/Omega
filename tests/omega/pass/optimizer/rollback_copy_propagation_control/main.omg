// `CopyPropagation` substitutes a block parameter bound by a single
// edge's carried value. `merge`'s `carried` parameter receives `produced`
// on the only incoming edge. This control build selects no rule, so its
// semantic module is the one the selected fixture's rolled-back module
// must rejoin byte-for-byte; the check leg records the pair's
// fingerprints side by side so the golden pins that equality.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();

    transition {
        _ -> merge(produced)
    }

    machine merge(carried: i32) {
        transition carried == 7 {
            true -> done()
            _ -> done()
        }
    }

    machine done() { }
}
