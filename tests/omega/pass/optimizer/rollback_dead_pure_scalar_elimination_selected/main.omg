// `DeadPureScalarElimination` removes pure scalar computations no reader
// consumes. `unused` binds a comparison nothing reads, so the rule
// removes it and the literal that fed only it, while the impure
// `source()` call stays: the check leg's `module:differs` fact pins the
// removal before the declared rollback subtracts the rule and the pair's
// two fingerprints record the rejoined module.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();
    let unused: bool = produced == 7;

    transition {
        _ -> done()
    }

    machine done() { }
}
