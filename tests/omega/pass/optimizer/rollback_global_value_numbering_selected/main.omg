// `GlobalValueNumbering` deduplicates equivalent scalar computations:
// `first` and `second` both compute `produced + one` over the same two
// value identities, so the rule redirects `second`'s uses to `first` and
// drops the duplicate addition. The comparison keeps a reader on both
// results so neither dies before the pass runs: the check leg's
// `module:differs` fact pins the deduplication before the declared
// rollback subtracts the rule and the pair's two fingerprints record the
// rejoined module.

machine source() -> i32 in Wrapping {
    7
}

machine main() {
    let produced: i32 in Wrapping = source();
    let one: i32 in Wrapping = 1;
    let first: i32 in Wrapping = produced + one;
    let second: i32 in Wrapping = produced + one;

    transition first == second {
        true -> done()
        _ -> done()
    }

    machine done() { }
}
