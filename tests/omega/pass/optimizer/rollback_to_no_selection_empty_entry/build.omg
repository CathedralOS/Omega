// One selected rule on an empty entry, realized on every hosted target.
//
// The corpus route supplies no release overlay — `build_native_fixture`
// builds its request without one — so running this fixture exercises the
// ordinary selected path and says nothing about rolling a rule back. The
// disabled-rule rejoin is checked by `driver/tests/rollback_to_identity.rs`,
// which supplies the overlay and compares the published module against a
// build that selects nothing.

machine build(builder: &mut Build) {
    Build::application(builder, "rollback_to_no_selection_empty_entry");
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_arm64::ProgramEntry, main);
    builder.roots.bind(macos_arm64::ProgramEntry, main);
    builder.optimizations.enable(Optimization::ControlFlowCleanup);
}
