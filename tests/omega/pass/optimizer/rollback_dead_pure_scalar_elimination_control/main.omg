// `DeadPureScalarElimination` removes pure scalar computations no reader
// consumes. `unused` binds a comparison nothing reads. This control build
// selects no rule, so its semantic module is the one the selected
// fixture's rolled-back module must rejoin byte-for-byte; the check leg
// records the pair's fingerprints side by side so the golden pins that
// equality.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();
    let unused: bool = produced == 7;

    transition {
        _ -> done()
    }

    machine done() { }
}
