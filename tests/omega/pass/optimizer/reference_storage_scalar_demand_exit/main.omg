use omega_language_std::console;

data Pair { prefix: u64; value: u32; }
data Main { pair: Pair; }

machine replace(value: &mut u32) { value = 19; }
machine read(value: &u32) -> u32 { value }

// Reference formation demands scalar geometry even when that geometry is
// used only by the reference carrier. Exercise a local and a nonzero field
// projection through calls and a later state under scalar elimination.
machine Main::main(main: &mut Main) reaches Console {
    main.pair.prefix = 41;
    main.pair.value = 7;
    let mut local: u32 = 3;
    replace(&mut local);
    let captured: u32 = read(&local);
    replace(&mut main.pair.value);
    transition captured == 19 {
        true -> observe(main)
        false -> bad(main)
    }
    state observe(main: &mut Main) {
        let observed: u32 = read(&main.pair.value);
        transition observed == 19 && main.pair.prefix == 41 {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
