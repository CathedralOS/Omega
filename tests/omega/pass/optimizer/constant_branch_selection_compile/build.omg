// The build selects the sole constant-branch fold by exact name, so
// compilation exercises its execution through the pre-allocation stage
// catalog and the native run observes the decided branch: the program
// exits 0 when `decide(7i64)` still returns 43 and traps otherwise.

machine build(builder: &mut Build) {
    Build::application(builder, "constant_branch_selection_compile");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::SelectedConstantBranchFoldV1,
    );
}
