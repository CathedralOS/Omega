// `SelectedConstantBranchFoldV1` proves a conditional-branch terminator's
// flag state derives from one compare over compile-time constants and
// replaces the terminator with the decided jump. `value < value` is a real
// selected `CompareI64`/`ConditionalBranchI64LessThan` pair — no frontend
// constant sees it — whose `register - register` flag state is always
// false, so the fold jumps the untaken edge and `decide(7i64)` returns 43.
// `main` observes that result: a fold that decided the taken edge returns 41
// and traps instead of reaching the authored exit 0. The `decided == 43i64`
// transition keeps a runtime `==` compare beside the folded one that the same
// pass must decline.

machine decide(value: i64) -> i64 {
    transition value < value {
        true -> taken()
        _ -> untaken()
    }

    state taken() -> i64 { 41i64 }
    state untaken() -> i64 { 43i64 }
}

machine main() crashes Trap {
    let decided: i64 = decide(7i64);
    transition decided == 43i64 {
        true -> done()
        _ -> bad()
    }

    state done() { }
    state bad() { crash Trap; }
}
