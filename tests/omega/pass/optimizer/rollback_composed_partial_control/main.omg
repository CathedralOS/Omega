// The control authors only `DeadPureScalarElimination`: the module the
// selected fixture's partially rolled-back build must rejoin
// byte-for-byte. Its `rollback.txt` still declares `CopyPropagation`,
// which subtracts nothing here -- the receipt records `applied=[]` and
// the fingerprints match the selected row's `rolled-back-semantic`.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();
    let unused: bool = produced == 7;

    transition {
        _ -> merge(produced)
    }

    machine merge(carried: i32) {
        transition carried == 7 {
            true -> done()
            _ -> done()
        }
    }

    machine done() { }
}
