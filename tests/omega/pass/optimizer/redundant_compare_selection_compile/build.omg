// The release overlay selects the sole redundant-compare removal, so
// compilation exercises its execution through the pre-allocation stage
// catalog.

machine build(builder: &mut Build) {
    Build::application(builder, "redundant_compare_selection_compile");
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_arm64::ProgramEntry, main);
    builder.roots.bind(macos_arm64::ProgramEntry, main);
    builder.optimizations.enable(
        Optimization::SelectedRedundantCompareRemovalV1,
    );
}
