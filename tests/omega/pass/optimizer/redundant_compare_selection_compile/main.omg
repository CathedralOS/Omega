// `SelectedRedundantCompareRemovalV1` removes a compare whose flag
// publication a same-form, same-operands shadow already publishes on every
// reaching path. `left < right && left < right` selects two `CompareI64`
// pairs over the same registers; the second compare's last flag event on
// its only incoming path is the first compare's identical publication, so
// the removal leaves the second branch reading the shadow's flag state and
// `probe(7i64, 9i64)` returns 1. `main` observes that result: a removal
// that corrupted the flag state the second condition reads returns 0 and
// traps instead of reaching the authored exit 0. The `observed == 1i64`
// transition keeps a runtime `==` compare with no reaching shadow that the
// same pass must decline.

machine probe(left: i64, right: i64) -> i64 {
    transition left < right && left < right {
        true -> yes()
        _ -> no()
    }

    state yes() -> i64 { 1i64 }
    state no() -> i64 { 0i64 }
}

machine main() crashes Trap {
    let observed: i64 = probe(7i64, 9i64);
    transition observed == 1i64 {
        true -> done()
        _ -> bad()
    }

    state done() { }
    state bad() { crash Trap; }
}
