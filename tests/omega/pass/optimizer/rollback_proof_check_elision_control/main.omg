// `ProofCheckElision` folds a proof-bearing scalar leaf whose evidence
// the proof bundle discharges. `produced - produced` is an exact
// subtraction whose no-overflow obligation admission proves from the
// identical operands alone. This control build selects no rule, so its
// semantic module is the one the selected fixture's rolled-back module
// must rejoin byte-for-byte; the check leg records the pair's
// fingerprints side by side so the golden pins that equality.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();
    let folded: i32 = produced - produced;

    transition folded == 0 {
        true -> done()
        _ -> done()
    }

    machine done() { }
}
