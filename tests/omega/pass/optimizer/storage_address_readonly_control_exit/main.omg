// Expected exit: 0. The two equal arrays remain simultaneously live.
machine observe(prior: &[u64; 2], copied: &[u64; 2]) -> bool {
    let a: u64 = prior[0];
    let b: u64 = copied[0];
    (a == b)
}
machine scan(left: u64, right: u64, limit: u64, increment: u64) -> bool
requires limit <= 3 requires increment == 1 {
    transition { _ -> body([left, right], 0, left, right, limit, increment) }
    machine body(prior: [u64; 2], index: u64, left: u64, right: u64, limit: u64, increment: u64) -> bool
    requires index <= limit requires limit <= 3 requires increment == 1 {
        let copied: [u64; 2] = [left, right];
        let observed: bool = observe(&prior, &copied);
        transition index < limit {
            true -> body(copied, index + increment, left, right, limit, increment)
            false -> observed
        }
    }
}
machine main() crashes Trap {
    let valid: bool = scan(7, 11, 3, 1);
    transition valid { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
