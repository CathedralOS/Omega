// `GlobalValueNumbering` deduplicates equivalent scalar computations:
// `first` and `second` both compute `produced + one` over the same two
// value identities. This control build selects no rule, so its semantic
// module is the one the selected fixture's rolled-back module must rejoin
// byte-for-byte; the check leg records the pair's fingerprints side by
// side so the golden pins that equality.

machine source() -> i32 in Wrapping {
    7
}

machine main() {
    let produced: i32 in Wrapping = source();
    let one: i32 in Wrapping = 1;
    let first: i32 in Wrapping = produced + one;
    let second: i32 in Wrapping = produced + one;

    transition first == second {
        true -> done()
        _ -> done()
    }

    machine done() { }
}
