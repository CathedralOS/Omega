// `table[index]` is a runtime index site, so the machine owns a reconstructed
// obligation and the two-arm literal join retains an interval invariant. The
// invariant also names `probe`, a copy parameter every incoming edge binds to
// `index`. `CopyPropagation` collapses `probe` to `index` -- a source that
// stands in the join header's telescope -- and rewrites the retained
// predicate with the same substitution instead of withholding the rewrite:
// the check leg's `module:differs` fact pins that collapse before the
// declared rollback subtracts the rule.
//
// `unused` binds a comparison nothing reads so the second selected rule,
// `DeadPureScalarElimination`, still finds its own dead scalar on the same
// proof-bearing module.
machine choose(index: u64, other: u64) -> i32 requires index <= 7 {
    let table: [i32; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
    let hit: i32 = table[index];
    let unused: bool = index < other;
    transition hit == 0 {
        true -> joined(index, 10)
        _ -> joined(index, 99)
    }

    machine joined(probe: u64, choice: i32) -> i32 requires probe <= 7 {
        transition choice < 50 {
            true -> (choice)
            _ -> (choice)
        }
    }
}

machine main() crashes Trap {
    let decided: i32 = choose(1, 2);
    transition decided == 10 {
        true -> done()
        _ -> bad()
    }

    machine done() {}
    machine bad() { crash Trap; }
}
