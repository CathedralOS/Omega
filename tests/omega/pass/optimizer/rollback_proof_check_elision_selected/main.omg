// `ProofCheckElision` folds a proof-bearing scalar leaf whose evidence
// the proof bundle discharges. `produced - produced` is an exact
// subtraction whose no-overflow obligation admission proves from the
// identical operands alone, so the rule replaces it with the literal `0`
// and the consumed obligation's evidence leaves the published bundle: the
// check leg's `module:differs` fact pins the fold before the declared
// rollback subtracts the rule and the pair's two fingerprints record the
// rejoined module.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();
    let folded: i32 = produced - produced;

    transition folded == 0 {
        true -> done()
        _ -> done()
    }

    machine done() { }
}
