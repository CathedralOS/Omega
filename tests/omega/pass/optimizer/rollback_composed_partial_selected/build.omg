// The build authors both rules by exact name so the declared
// `rollback.txt` overlay can subtract only `CopyPropagation` and still
// leave `DeadPureScalarElimination` effective -- the partial-subtraction
// leg no single-rule fixture can reach.

machine build(builder: &mut Build) {
    Build::application(builder, "rollback_composed_partial_selected");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::CopyPropagation,
    );
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::DeadPureScalarElimination,
    );
}
