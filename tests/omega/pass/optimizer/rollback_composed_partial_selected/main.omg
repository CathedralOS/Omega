// The build authors `CopyPropagation` and `DeadPureScalarElimination`
// together; the declared rollback subtracts only `CopyPropagation`, so
// the rolled build still runs the dead-scalar elimination. `unused` gives
// the surviving rule real work (a dead compare nothing reads) while
// `merge`'s `carried` parameter gives the rolled-back rule the copy
// substitution that `module:differs` pins -- the receipt's non-empty
// `effective=[DeadPureScalarElimination]` is the composition contract:
// releasing one authored rule keeps the rest of the authored selection.

machine source() -> i32 {
    7
}

machine main() {
    let produced: i32 = source();
    let unused: bool = produced == 7;

    transition {
        _ -> merge(produced)
    }

    machine merge(carried: i32) {
        transition carried == 7 {
            true -> done()
            _ -> done()
        }
    }

    machine done() { }
}
