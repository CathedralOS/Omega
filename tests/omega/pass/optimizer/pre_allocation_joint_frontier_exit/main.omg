// Stored values, copied readers and calls compose across functions.
// Earlier rewrite families must retain priority when forwarding publishes copies.
data Context { value: u64; }

machine first_value(context: &mut Context) -> u64
ensures result == 43u64
{
    context.value = 43u64;
    context.value
}

machine main(context: &mut Context) crashes Trap {
    let first: u64 = first_value(context);
    context.value = first;
    let observed: u64 = context.value;
    transition observed == 43u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
