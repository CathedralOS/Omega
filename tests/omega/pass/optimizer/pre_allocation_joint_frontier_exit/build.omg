machine build(builder: &mut Build) {
    Build::application(builder, "pre_allocation_joint_frontier_exit");
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedSameBlockCopyI64RemovalV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedRedundantExtensionRemovalV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedAddressOffsetFoldV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedConstantBooleanFoldV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedConstantBranchFoldV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedDeadCompareRemovalV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedRedundantCompareRemovalV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedEquivalentCompareRemovalV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedCopiedCallOperandFoldV1);
    Optimizations::enable(&mut builder.optimizations, Optimization::SelectedStoredLoadForwardingV1);
}
