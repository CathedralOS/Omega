// `whole.inner`, `copied.lease`, and `whole.inner.lease` each mint an
// ordinary-path `StructuralLeafCopy` whose result holds exactly the source's
// contents at the copied projection. The selected
// `RepresentationSpecialization` crosses each copy back to `whole`'s
// `EstablishRecord` chain -- ordinary field identities resolved to their
// roster's verifier handles first -- folding `member` and `nested` to
// `BooleanConstant(true)` and `level` to `IntegerConstant(7)` when stage 01
// runs the pass. The fold is semantics-preserving, so the authored exit is
// the same with or without it: the transition takes `done` only when the
// reads return the authored values, and a misresolved projection reads the
// wrong case or the wrong scalar and takes `bad` instead.
data Lease [copy] {
    case Live;
    case Free;
}

data Inner [copy] {
    lease: Lease;
    level: u8;
}

data Outer [copy] {
    inner: Inner;
    flag: bool;
}

machine main() crashes Trap {
    let whole: Outer = Outer {
        inner: Inner { lease: Lease::Live, level: 7u8 },
        flag: true,
    };
    let copied: Inner = whole.inner;
    let copied_lease: Lease = copied.lease;
    let deep_lease: Lease = whole.inner.lease;
    let member: bool = copied_lease in Lease::Live;
    let nested: bool = deep_lease in Lease::Live;
    let level: u8 = copied.level;
    transition member && nested && level == 7u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
