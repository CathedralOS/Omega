// The build authors `RepresentationSpecialization` by exact name so the
// selected suite reaches the post-Terminal abstract-operations stage the
// pass executes in.

machine build(builder: &mut Build) {
    Build::application(builder, "ordinary_copy_membership_selected");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::RepresentationSpecialization,
    );
}
