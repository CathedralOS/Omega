machine build(builder: &mut Build) {
    Build::application(builder, "selected_comparison_demand_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Optimizations::enable(&mut builder.optimizations, Optimization::SparseConditionalConstantPropagation);
    Optimizations::enable(&mut builder.optimizations, Optimization::GlobalValueNumbering);
    Optimizations::enable(&mut builder.optimizations, Optimization::DeadPureScalarElimination);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
}
