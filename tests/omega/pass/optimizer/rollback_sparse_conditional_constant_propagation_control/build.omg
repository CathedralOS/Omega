// The control build authors no optimization selection: its semantic
// module is the one the selected fixture's rolled-back module must
// rejoin byte-for-byte. The fixture declares the same `rollback.txt`
// rule, which subtracts nothing here -- its receipt records
// `applied=[]`.

machine build(builder: &mut Build) {
    Build::application(builder, "rollback_sparse_conditional_constant_propagation_control");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
