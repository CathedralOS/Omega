// `SparseConditionalConstantPropagation` folds scalar computations whose
// operands resolve to literals. `addend` binds the literal `2`, so
// `addend + 3` folds to `5` and `folded == 5` folds to the `true`
// constant. This control build selects no rule, so its semantic module is
// the one the selected fixture's rolled-back module must rejoin
// byte-for-byte; the check leg records the pair's fingerprints side by
// side so the golden pins that equality.

machine main() {
    let addend: i32 in Wrapping = 2;
    let folded: i32 in Wrapping = addend + 3;

    transition folded == 5 {
        true -> done()
        _ -> done()
    }

    machine done() { }
}
