// The build authors `CopyPropagation` and `DeadPureScalarElimination` by
// exact name so compilation exercises both Psi rules on the proof-bearing
// module; the fixture's declared `rollback.txt` overlay subtracts
// `DeadPureScalarElimination` again, so the check leg's Terminal-artifact
// pair isolates the liveness rule's own removal on the invariant-bearing
// module.

machine build(builder: &mut Build) {
    Build::application(builder, "join_invariant_dead_scalar_transport_selected");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::CopyPropagation,
    );
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::DeadPureScalarElimination,
    );
}
