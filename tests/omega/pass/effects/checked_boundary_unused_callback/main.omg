public boundary trait Read {}
public boundary trait Handler {
    machine read() -> u64 reaches Read blocks;
}
data Provider {}
machine Provider::callback() -> u64 satisfies Handler::read reaches Read { 7 }

// Permission to invoke a callback does not mean a checked body invokes it.
boundary machine ignore<machine Callback>() -> u64
where machine Callback satisfies Handler::read;
invokes Handler;
{ 9 }

machine caller() -> u64 { ignore<Provider::callback>() }
