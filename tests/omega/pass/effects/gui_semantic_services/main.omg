use omega_language_std::macos_gui;
use omega_language_std::windows_gui_host;

public boundary trait GlobalInputClient {
    machine read() -> u64 reaches GlobalInputObservation;
}

public GlobalInputProvider satisfies GlobalInputClient {
    machine read() -> u64 reaches GlobalInputObservation {
        macos_key_state(32)
    }
}

public macos_arm64 machine pace() reaches ExecutionDelay {
    macos_sleep(0);
}

public macos_arm64 machine observe_clock() -> u64 reaches ClockObservation {
    macos_perf_counter()
}

public windows_x86_64 machine observe_window() -> u64
reaches WindowManagement invokes WindowsGuiHost; {
    WindowsGuiHost::foreground_window()
}