// A structural callback retains the selected boundary's declared reach.
public boundary trait Read {}
public boundary trait Reader { machine read(value: u64) -> u64 reaches Read; }
boundary machine read(value: u64) -> u64 satisfies Reader::read reaches Read { value }

trait Published { machine run() -> u64 reaches Read; }

machine apply<machine Step>(value: u64) -> u64
where machine Step(value: u64) -> u64 reaches Read;
reaches Read
{ Step(value) }

machine main() -> u64 satisfies Published::run reaches Read {
    apply<read>(17u64)
}

machine entry() crashes Trap {
    transition main() == 17u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
