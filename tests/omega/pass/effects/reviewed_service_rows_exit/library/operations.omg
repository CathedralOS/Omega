// Selection identity and capability identity remain separate in publication.
public boundary trait ReadCapability { }
public boundary trait Operations {
    machine read(value: i32) -> i32 reaches ReadCapability;
    machine identity(value: i32) -> i32 reaches;
}
public machine read_value(value: i32) -> i32
reaches ReadCapability
invokes Operations;
{
    Operations::read(value)
}
public machine pure_value(value: i32) -> i32
invokes Operations;
{
    Operations::identity(value)
}
