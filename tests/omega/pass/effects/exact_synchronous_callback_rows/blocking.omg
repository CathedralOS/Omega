
pub boundary trait BlockingHandler {
    machine wait() -> u64 blocks;
    machine unrelated_suspend() suspends;
}
pub boundary trait BlockingRegistrar {
    machine execute<machine Callback>() -> u64
    where machine Callback satisfies BlockingHandler::wait;
    invokes BlockingHandler;
}
machine wait_callback() -> u64 satisfies BlockingHandler::wait blocks; { 7 }

machine execute_blocking() -> u64 reaches BlockingRegistrar {
    block BlockingRegistrar::execute<wait_callback>()
}
