use omega::language::core::filesystem_authority;

public boundary trait SurfacePresentation {}
public boundary trait NativeFilesystem {
    machine write_cache() reaches FilesystemContentWrite;
}
public boundary trait GraphicsPlatform {
    machine present() reaches SurfacePresentation + FilesystemContentWrite invokes NativeFilesystem;
}
public boundary trait PresentationClient {
    machine present() reaches SurfacePresentation + FilesystemContentWrite invokes NativeFilesystem;
}

machine write_cache() reaches FilesystemContentWrite invokes NativeFilesystem; {
    NativeFilesystem::write_cache();
}

data Renderer {}
machine Renderer::present() satisfies GraphicsPlatform::present
reaches SurfacePresentation + FilesystemContentWrite invokes NativeFilesystem; {
    write_cache();
}

public machine forward_presentation() invokes NativeFilesystem; {
    Renderer::present();
}

data Client {}
machine Client::present() satisfies PresentationClient::present
invokes NativeFilesystem; {
    forward_presentation();
}