// A callable boundary still needs provider identity when its effect row is
// empty. Exercise direct, bound and helper calls without inventing an effect.
use omega_language_std::console;

pub boundary trait Pure { machine evaluate(value: i32) -> i32; }
data Provider {}
machine Provider::evaluate(value: i32) -> i32 satisfies Pure::evaluate { value }

data Main { }
machine through_helper(value: i32) -> i32 {
    Pure::evaluate(value)
}
machine Main::main(main: &mut Main) reaches Console {
    let direct: i32 = Pure::evaluate(70);
    let bound: i32 = Pure::evaluate(direct);
    let forwarded: i32 = through_helper(bound);
    Console::exit_process(forwarded);
}
