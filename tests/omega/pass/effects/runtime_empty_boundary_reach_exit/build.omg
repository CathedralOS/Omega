machine build(builder: &mut Build) {
    Build::application(builder, "runtime_empty_boundary_reach_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Pure, ProviderPureImplementation>(builder, linux_arm64);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, linux_x86_64);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, macos_arm64);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, macos_x86_64);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, windows_x86_64);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, uefi_x86_64);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, cross_platform_cli);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, local_unchecked);
    Build::select_provider<Pure, ProviderPureImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
