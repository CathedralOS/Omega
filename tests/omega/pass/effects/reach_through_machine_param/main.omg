// A machine param bound by a trait-member `satisfies`: `Step(value)`
// invokes the bound machine and the call inherits the member's declared
// `reaches Console` ceiling — effect reach computes through the
// dictionary-free static dispatch.
public boundary trait Console {}
public trait StepContract {
    machine step(value: u64) -> u64 reaches Console;
}
machine note() reaches Console {}
public machine traverse<machine Step>(value: u64) -> u64
    where machine Step satisfies StepContract::step;
{ Step(value) }
machine quiet(value: u64) -> u64 satisfies StepContract::step { value + 0 }
data Main { input: u64; }
machine Main::main(main: &mut Main) {
    main.input = 5;
    let out: u64 = traverse<quiet>(main.input);
    transition out == 5 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
