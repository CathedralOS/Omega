boundary trait Console { machine ping(); }

machine apply<machine Schema, machine Unused>(value: u64) -> u64
where machine Schema<const Number: u64>(value: u64) -> u64 reaches Console;
where machine Unused<const Number: u64>(value: u64) -> u64 reaches Console;
{
    let first: u64 = Schema<2>(value);
    Schema<3>(first)
}

machine selected<const Count: u64>(value: u64) -> u64 reaches Console { Count }
machine unused<const Count: u64>(value: u64) -> u64 reaches Console { value }

pub machine enter(value: u64) -> u64 { apply<selected, unused>(value) }
