use omega::language::core::service;
pub boundary trait Readable {
    machine read() -> u64;
}
pub boundary trait Queryable {}

pub data Worker { reader: Binding<Readable>; }

machine Worker::read(&mut self) -> u64 reaches Readable + Queryable {
    self.reader.read()
}

pub machine Worker::forward(&mut self) -> u64 invokes Readable; {
    self.read()
}
