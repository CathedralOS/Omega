machine build(builder: &mut Build) {
    Build::application(builder, "invoked_family_block_marker_redundant_exit");
    Build::select_provider<Device, DeviceProvider>(builder, linux_x86_64);
    Build::select_provider<Device, DeviceProvider>(builder, linux_arm64);
    Build::select_provider<Device, DeviceProvider>(builder, macos_arm64);
    Build::select_provider<Device, DeviceProvider>(builder, windows_x86_64);
    Build::select_provider<Sink, Provider>(builder, linux_x86_64);
    Build::select_provider<Sink, Provider>(builder, linux_arm64);
    Build::select_provider<Sink, Provider>(builder, macos_arm64);
    Build::select_provider<Sink, Provider>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, run);
    Build::bind(builder, linux_arm64::ProgramEntry, run);
    Build::bind(builder, macos_arm64::ProgramEntry, run);
    Build::bind(builder, windows_x86_64::ProgramEntry, run);
}
