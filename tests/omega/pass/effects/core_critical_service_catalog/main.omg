use omega::language::core::filesystem_authority;
use omega::language::core::process_authority;
use omega::language::core::process_exit;
use omega::language::core::assembly;
use omega::language::core::interrupt;

public machine published_ceiling()
reaches
    FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery +
    FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation +
    ProcessInput + ProcessOutput + ProcessExit +
    MachineControl + PortIo + InterruptControl +
    InterruptEntry + RootMemoryAccess
{}