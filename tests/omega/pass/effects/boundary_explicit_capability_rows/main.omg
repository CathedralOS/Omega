// Interface identity is not an effect. A two-operation provider can expose
// distinct capability rows; calling one operation does not reach the other.
use omega::language::core::binding;
pub boundary trait Content {}
pub boundary trait Read: Content {}
pub boundary trait Write {}
pub boundary trait Host {
    machine read() -> u64 reaches Read;
    machine write(value: u64) reaches Write;
    machine pure(value: u64) -> u64;
    machine wait() blocks;
}

pub boundary trait Portable {
    machine read() -> u64 reaches Read invokes Host;
    machine pure() -> u64 invokes Host;
}

machine portable_read(portable: &mut Binding<Portable>) -> u64 reaches Read {
    portable.read()
}

machine portable_pure(portable: &mut Binding<Portable>) -> u64 {
    portable.pure()
}

machine read_only() -> u64 reaches Read
invokes Host;
{ Host::read() }

machine pure_operation() -> u64
invokes Host;
{ Host::pure(7) }

machine bound_read(host: &mut Binding<Host>) -> u64 reaches Read {
    host.read()
}

machine bound_pure(host: &mut Binding<Host>) -> u64 {
    host.pure(7)
}

// The implementation check retains the read capability's parent closure.
pub trait ReadContract { machine read() -> u64 reaches Read invokes Host; }
data Reader {}
machine Reader::read() -> u64 satisfies ReadContract::read { read_only() }

pub trait PureContract { machine pure() -> u64 invokes Host; }
data Pure {}
machine Pure::pure() -> u64 satisfies PureContract::pure { pure_operation() }
