// A checked implementation may perform the exact synchronous callback's
// effect, but does not inherit unrelated members of the callback family.
public boundary trait Read {}
public boundary trait Write {}
public boundary trait Handler {
    machine read() -> u64 reaches Read;
    machine unrelated_write() reaches Write blocks;
}
public boundary trait Registrar {
    machine execute<machine Callback>() -> u64
    where machine Callback satisfies Handler::read;
    reaches
    invokes Handler;
}
data Provider {}
machine Provider::execute<machine Callback>() -> u64
where machine Callback satisfies Handler::read;
satisfies Registrar::execute
{ Callback() }
