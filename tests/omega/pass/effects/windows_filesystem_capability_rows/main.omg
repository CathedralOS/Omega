// Raw Windows requirements publish operation capabilities, not family identity.
// Cursor, durability, handle custody and last-error access have no filesystem
// content/metadata/namespace reach; their physical authority stays separate.
use omega_language_std::windows_filesystem_host;
use omega::language::core::filesystem_authority;

machine read_only(handle: u64, buffer: &mut [u8], count: u64) -> i64
reaches FilesystemContentRead
{ block WindowsFilesystemHost::read_file(handle, buffer, count) }

machine write_only(handle: u64, bytes: &[u8]) -> i64
reaches FilesystemContentWrite
{ block WindowsFilesystemHost::write_file(handle, bytes) }

machine query_time(handle: u64) -> WindowsFileTimeResult
reaches FilesystemMetadataQuery
{ block WindowsFilesystemHost::get_file_time(handle) }

machine change_time(handle: u64, accessed: u64, modified: u64) -> i32
reaches FilesystemMetadataMutation
{ block WindowsFilesystemHost::set_file_time(handle, accessed, modified) }

machine remove(path: &[u8] in Path) -> i32
reaches FilesystemNamespaceMutation
{ block WindowsFilesystemHost::delete_file(path) }

machine copy_capable_move(from: &[u8] in Path, to: &[u8] in Path) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{ block WindowsFilesystemHost::move_file(from, to, 2) }

machine last_error() -> u32 { WindowsFilesystemHost::last_error() }
machine close(handle: u64) -> i32 { block WindowsFilesystemHost::close_handle(handle) }
machine sync(handle: u64) -> i32 { block WindowsFilesystemHost::flush_file_buffers(handle) }
machine duplicate(handle: u64) -> u64 { WindowsFilesystemHost::duplicate_handle(handle) }
machine seek(handle: u64, distance: i64) -> i64 {
    block WindowsFilesystemHost::set_file_pointer(handle, distance, 0)
}
