machine posix_copy_path_from(path: &[u8], out: &mut [u8], index: u64)
terminates by (index, path.len) -> Nat::BoundedDistance;
{
    posix_put_path_byte(path, out, index);
    transition index < path.len {
        true -> posix_copy_path_from(path, out, index + 1)
        _ -> done()
    }

    machine done() { }
}

machine posix_put_path_byte(path: &[u8], out: &mut [u8], index: u64) {
    transition index < path.len {
        true -> byte(path, out, index)
        _ -> terminator(out, index)
    }

    machine byte(path: &[u8], out: &mut [u8], index: u64) {
        transition index + 1 < out.len {
            true -> write_byte(path, out, index)
            _ -> done()
        }
    }

    machine write_byte(path: &[u8], out: &mut [u8], index: u64) {
        out[index] = path[index];
        transition { _ -> done() }
    }

    machine terminator(out: &mut [u8], index: u64) {
        transition index < out.len {
            true -> write_terminator(out, index)
            _ -> done()
        }
    }

    machine write_terminator(out: &mut [u8], index: u64) {
        out[index] = 0;
        transition { _ -> done() }
    }

    machine done() { }
}

machine program() crashes Trap {
    let input: [u8; 3] = [7, 11, 19];
    let mut output: [u8; 4];
    posix_copy_path_from(&input[..], &mut output[..], 0);
    transition output[0] == 7 && output[1] == 11 && output[2] == 19 && output[3] == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
