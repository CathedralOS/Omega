// A result-bearing scalar machine whose loop header is not its entry
// state: the entry runs once as a prologue (returns early or seeds
// `step`), then every iteration re-enters `step` — the loop values
// travel as `step`'s parameters. Square-and-multiply computes
// 3^7 mod 100 = 87 with every factor reduced `% 100` first.
machine modular_power(base: i32, exponent: i32) -> i32 {
    transition exponent < 0 {
        true -> (0)
        _ -> step(1, base % 100, exponent)
    }
    machine step(result: i32, base: i32, exponent: i32) -> i32 {
        transition exponent == 0 {
            true -> (result)
            _ -> classify(result, base, exponent)
        }
    }
    machine classify(result: i32, base: i32, exponent: i32) -> i32 {
        let bit: i32 = exponent % 2;
        transition bit == 1 {
            true -> accumulate(result, base, exponent)
            _ -> square(result, base, exponent)
        }
    }
    machine accumulate(result: i32, base: i32, exponent: i32) -> i32 {
        let next_result: i32 = ((result % 100) * (base % 100)) % 100;
        transition { _ -> square(next_result, base, exponent) }
    }
    machine square(result: i32, base: i32, exponent: i32) -> i32 {
        let next_base: i32 = ((base % 100) * (base % 100)) % 100;
        let next_exponent: i32 = exponent / 2;
        transition { _ -> step(result, next_base, next_exponent) }
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    let result: i32 = modular_power(3, 7);
    transition result == 87 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
