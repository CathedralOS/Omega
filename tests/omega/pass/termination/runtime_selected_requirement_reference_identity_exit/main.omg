trait RankReader {
    machine read(value: &u32) -> u32 terminates;
    requires value <= 9
    ensures result == value;
    machine keep(value: u32) -> u32 terminates;
    requires value <= 9
    ensures result == value;
}

ReadOnly satisfies RankReader {
    machine read(value: &u32) -> u32
    requires value <= 9;
    ensures result == value;
    {
        value
    }
    machine keep(value: u32) -> u32
    requires value <= 9;
    ensures result == value;
    {
        value
    }
}

machine require_identity(actual: u32, expected: u32) -> u32
requires actual == expected;
{
    actual
}

machine compare_results(selected: dyn RankReader, remaining: u32) -> u32
requires remaining <= 9;
{
    let observed: u32 = RankReader::read(selected, &remaining);
    let direct_checked: u32 = require_identity(observed, remaining);
    let nested: u32 = RankReader::keep(selected, RankReader::read(selected, &remaining));
    let nested_checked: u32 = require_identity(nested, remaining);
    let composed: u32 = RankReader::read(selected, &remaining) + 0;
    let composed_checked: u32 = require_identity(composed, remaining);
    direct_checked
}

machine main() crashes Trap {
    let selected: dyn RankReader = ReadOnly as dyn RankReader;
    let result: u32 = compare_results(selected, 4);
    transition result == 4 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
