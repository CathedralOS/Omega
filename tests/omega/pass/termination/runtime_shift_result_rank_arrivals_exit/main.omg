pub boundary trait RankReader {
    machine step(value: i32) -> i32
    terminates
    requires value > 0 && value <= 9
    ensures result == value >> 1;
}
CheckedReader satisfies RankReader {
    machine step(value: i32) -> i32
    requires value > 0 && value <= 9;
    ensures result == value >> 1;
    { value >> 1 }
}
machine identity(value: i32) -> i32 ensures result == value; { value }

machine direct(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    transition remaining > 0 {
        true -> direct(RankReader::step(remaining))
        false -> remaining
    }
}
machine nested(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    transition remaining > 1 {
        true -> nested(identity(RankReader::step(RankReader::step(remaining))))
        false -> remaining
    }
}
machine saved(remaining: i32) -> i32
requires remaining > 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    let next: i32 = RankReader::step(remaining);
    transition next > 0 {
        true -> saved(identity(next))
        false -> next
    }
}
data Progress { remaining: i32; }
machine step_record(value: i32) -> Progress
requires value > 0 && value <= 9;
ensures result.remaining == value >> 1;
{ Progress { remaining: value >> 1 } }
machine projected(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
{
    transition remaining > 0 {
        true -> projected(step_record(remaining).remaining)
        false -> remaining
    }
}
// The count has its own width and overflow policy. Exact left owns the shift.
machine shifted(value: i32, count: u8 in Wrapping) -> i32
requires value > 0 && value <= 9 && count >= 1 && count <= 3;
ensures result == value >> count;
{ value >> count }
machine variable(remaining: i32, count: u8 in Wrapping) -> i32
requires remaining >= 0 && remaining <= 9 && count >= 1 && count <= 3;
terminates by remaining -> Nat::Descending in 0..=9;
{
    transition remaining > 0 {
        true -> variable(shifted(remaining, count), count)
        false -> remaining
    }
}
machine shifted_left(value: i32, count: u8 in Wrapping) -> i32
requires value >= 0 && value <= 9 && count <= 3;
ensures result == value << count;
{ value << count }
machine masked(value: i32, mask: i32) -> i32
requires value >= 0 && value <= 9 && mask >= 0 && mask <= 3;
ensures result == value & mask;
{ value & mask }
machine require_left(value: i32) -> i32 requires value >= 0 && value <= 72; { value }
machine require_mask(value: i32) -> i32 requires value >= 0 && value <= 3; { value }
machine receive_left(value: i32, count: u8 in Wrapping) -> i32
requires value >= 0 && value <= 9 && count <= 3;
{ require_left(shifted_left(value, count)) }
machine receive_mask(value: i32, mask: i32) -> i32
requires value >= 0 && value <= 9 && mask >= 0 && mask <= 3;
{ require_mask(masked(value, mask)) }
machine signed_shift(value: i32) -> i32
requires value >= -9 && value <= 9;
ensures result == value >> 1;
{ value >> 1 }
machine require_negative(value: i32) -> i32 requires value == -4; { value }
machine preserved_endpoint(remaining: u64, count: u8 in Wrapping) -> u64
requires remaining <= 2 && count >= 1 && count <= 3;
terminates by remaining -> Nat::Descending in 0..=(16u64 >> count);
{
 transition remaining > 0 {
 true -> preserved_endpoint(remaining - 1, count)
 false -> 0
 }
}

data Count { bits: u8 in Wrapping; }
machine record_countdown(remaining: i32, settings: &Count) -> i32
requires remaining >= 0 && remaining <= 9 && settings.bits >= 1 && settings.bits <= 3;
terminates by remaining -> Nat::Descending in 0..=9;
{
 transition remaining > 0 {
 true -> record_countdown(shifted(remaining, settings.bits), settings)
 false -> remaining
 }
}

data Main { }
machine Main::main(main: &mut Main) reaches RankReader crashes Trap {
    let first: i32 = direct(9);
    let second: i32 = nested(8);
    let third: i32 = projected(7);
    let fourth: i32 = saved(6);
    let fifth: i32 = variable(9, 2 as u8 in Wrapping);
    let sixth: i32 = receive_left(9, 3 as u8 in Wrapping);
    let seventh: i32 = receive_mask(7, 3);
    let eighth: i32 = require_negative(signed_shift(-7));
    let ninth: u64 = preserved_endpoint(2, 1 as u8 in Wrapping);
    let settings: Count = Count { bits: 2 as u8 in Wrapping };
    let tenth: i32 = record_countdown(9, &settings);
    transition tenth == 0 && ninth == 0 && first == 0 && second == 0 && third == 0 && fourth == 0 && fifth == 0 && sixth == 72 && seventh == 3 && eighth == -4 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
