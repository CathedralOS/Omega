pub boundary trait RankReader {
    machine step(value: i32) -> i32
    terminates
    requires value > 0 && value <= 9
    ensures result == value / 2;
}
CheckedReader satisfies RankReader {
    machine step(value: i32) -> i32
    requires value > 0 && value <= 9;
    ensures result == value / 2;
    { value / 2 }
}
machine identity(value: i32) -> i32 ensures result == value; { value }

machine direct(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    transition remaining > 0 {
        true -> direct(RankReader::step(remaining))
        false -> remaining
    }
}
machine nested(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    transition remaining > 1 {
        true -> nested(identity(RankReader::step(RankReader::step(remaining))))
        false -> remaining
    }
}
machine saved(remaining: i32) -> i32
requires remaining > 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    let next: i32 = RankReader::step(remaining);
    transition next > 0 {
        true -> saved(identity(next))
        false -> next
    }
}
data Progress { remaining: i32; }
machine step_record(value: i32) -> Progress
requires value > 0 && value <= 9;
ensures result.remaining == value / 2;
{ Progress { remaining: value / 2 } }
machine projected(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
{
    transition remaining > 0 {
        true -> projected(step_record(remaining).remaining)
        false -> remaining
    }
}
machine divided(value: i32, divisor: i32) -> i32
requires value > 0 && value <= 9 && divisor >= 2 && divisor <= 9;
ensures result == value / divisor;
{ value / divisor }
machine variable(remaining: i32, divisor: i32) -> i32
requires remaining >= 0 && remaining <= 9 && divisor >= 2 && divisor <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
{
    transition remaining > 0 {
        true -> variable(divided(remaining, divisor), divisor)
        false -> remaining
    }
}
machine reduced(value: i32, divisor: i32) -> i32
requires value > 0 && value <= 9 && divisor > 0 && divisor <= value;
ensures result == value % divisor;
{ value % divisor }
machine remainder(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
{
    transition remaining > 0 {
        true -> remainder(reduced(remaining, remaining))
        false -> remaining
    }
}
machine signed_quotient(value: i32) -> i32
requires value >= -9 && value <= 9;
ensures result == value / 2;
{ value / 2 }
machine signed_remainder(value: i32) -> i32
requires value >= -9 && value <= 9;
ensures result == value % 2;
{ value % 2 }
machine require_negative_quotient(value: i32) -> i32
requires value == -3;
{ value }
machine require_negative_remainder(value: i32) -> i32
requires value == -1;
{ value }
data Main { }
machine Main::main(main: &mut Main) reaches RankReader crashes Trap {
    let first: i32 = direct(9);
    let second: i32 = nested(8);
    let third: i32 = projected(7);
    let fourth: i32 = saved(6);
    let fifth: i32 = variable(9, 3);
    let sixth: i32 = remainder(8);
    let seventh: i32 = require_negative_quotient(signed_quotient(-7));
    let eighth: i32 = require_negative_remainder(signed_remainder(-7));
    transition fifth == 0 && sixth == 0 && seventh == -3 && eighth == -1 && first == 0 && second == 0 && third == 0 && fourth == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
