// COMPILE CANARY: the cursor itself increases; the view owns the bounded
// remaining-distance normalization, and the optional range constrains rank.
data Main {}

machine Main::main(main: &mut Main) {
    let value: u64 = Main::walk(main, 4, 0);
}

machine Main::walk(main: &mut Main, limit: u64, index: u64) -> u64
terminates by index -> Nat::IncreasingTo(limit) in 0..=limit
{
    transition index < limit {
        true -> Main::walk(main, limit, index + 1)
        false -> index
    }
}
