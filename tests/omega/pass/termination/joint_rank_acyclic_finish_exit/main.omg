// One joint cycle permits a preserving edge when the return edge strictly
// decreases the rank. The acyclic finishing state needs no rank parameter.
machine left(remaining: u64)
terminates by remaining in 0..=9;
-> u64
requires remaining <= 9
{
    transition remaining > 0 {
        true -> right(remaining)
        false -> finish()
    }
    machine finish() -> u64 { 70 }
}

machine right(remaining: u64)
terminates by remaining in 0..=9;
-> u64
requires remaining > 0 && remaining <= 9
{
    transition { _ -> left(remaining - 1) }
}

machine main() crashes Trap {
    let counted: u64 = left(4);
    let empty: u64 = left(0);
    transition counted == 70 && empty == 70 {
        true -> done()
        false -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
