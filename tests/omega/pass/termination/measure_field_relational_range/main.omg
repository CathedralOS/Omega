data Countdown where 0 <= remaining, remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64
{ countdown.remaining }

machine walk(countdown: Countdown, ceiling: u64, amount: u64)
    requires 0 <= ceiling && ceiling <= 5 && 1 <= amount && amount <= 2
requires countdown.remaining <= ceiling;
terminates by countdown -> Countdown::Remaining in 0..=ceiling;
-> u64 {
    transition countdown.remaining >= amount {
        true -> walk(Countdown { remaining: countdown.remaining - amount }, ceiling, amount)
        false -> countdown.remaining
    }
}
