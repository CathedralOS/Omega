data Countdown where remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }

machine walk(countdown: Countdown, ceiling: u64)
requires ceiling >= 5 && ceiling <= 10;
terminates by countdown -> Countdown::Remaining in 0..=ceiling;
-> u64 {
    transition countdown.remaining > 0 {
        true -> walk(Countdown { remaining: countdown.remaining - 1 }, ceiling)
        false -> countdown.remaining
    }
}

// The original field-selected countdown retains this ordinary parameter
// as its fixed endpoint throughout the complete recursive invocation.
machine main() crashes Trap {
    let result: u64 = walk(Countdown { remaining: 5 }, 9);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
