data Pair where left <= 5, right <= 5 { left: u32; right: u32; }

machine walk(remaining: u32)
requires remaining <= 5
terminates by remaining in 0..=5;
-> u32 {
    transition { _ -> iterate(Pair { left: remaining, right: 4 }) }
    machine iterate(pending: Pair) -> u32 {
        let captured: Pair = pending;
        transition captured.left > 0 {
            true -> iterate(Pair { left: captured.left - 1, right: captured.right })
            false -> captured.left
        }
    }
}

machine main() crashes Trap {
    let result: u32 = walk(5);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
