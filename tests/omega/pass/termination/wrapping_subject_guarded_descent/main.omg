// Wrapping and Saturating ranking subjects rank when an independent no-wrap
// premise holds at the recursive edge (numeric_values.md: a Wrapping loop
// update needs an independent no-wrap proof before monotonicity can be
// inferred; the proposed descent cannot supply its own premise). The engine
// reads each policy's law: a Wrapping result equals its mathematical value
// exactly when that value lands in the result carrier, and a Saturating one
// likewise, so `n - 1` under a dominating `n >= 1` guard is the natural
// `n - 1`. The variants cover another carrier (u32, i64, u8), each guard
// spelling (`n >= 1`, `0 < n`, `n > 0`), a signed subject under an explicit
// `Nat::Descending` view with its `requires n >= 0` floor, a Saturating
// policy, and a two-subject bounded distance whose cursor steps up under
// `cursor < limit` (the no-wrap premise is then the bound formal's own
// carrier maximum).
// Nothing here is a source shape: the sibling invalid control
// `fail/termination/wrapping_subject_unguarded_decrement` decrements the same
// Wrapping subject under a guard that says nothing about it and must refuse.

data Main {
}

machine Main::main(main: &mut Main) {
    let narrow: u32 in Wrapping = Main::count_down(main, 5);
    let signed: i64 in Wrapping = Main::signed_down(main, 6, 0);
    let clamped: u8 in Saturating = Main::saturating_down(main, 3);
    let climbed: u64 in Wrapping = Main::climb(main, 2, 9);
}

machine Main::count_down(main: &mut Main, n: u32 in Wrapping) -> u32 in Wrapping
terminates by n
{
    transition n >= 1 {
        true -> count_down(main, n - 1)
        false -> n
    }
}

machine Main::signed_down(main: &mut Main, n: i64 in Wrapping, acc: i64 in Wrapping) -> i64 in Wrapping
requires n >= 0
terminates by n -> Nat::Descending
{
    transition 0 < n {
        true -> signed_down(main, n - 1, acc + 1)
        false -> acc
    }
}

machine Main::saturating_down(main: &mut Main, n: u8 in Saturating) -> u8 in Saturating
terminates by n
{
    transition n > 0 {
        true -> saturating_down(main, n - 1)
        false -> n
    }
}

machine Main::climb(main: &mut Main, cursor: u64 in Wrapping, limit: u64 in Wrapping) -> u64 in Wrapping
terminates by (cursor, limit) -> Nat::BoundedDistance
{
    transition cursor < limit {
        true -> climb(main, cursor + 1, limit)
        false -> cursor
    }
}
