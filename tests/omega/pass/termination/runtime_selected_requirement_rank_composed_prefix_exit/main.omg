trait RankReader {
    machine read(value: &u32) -> u32 terminates;
    machine keep(value: u32) -> u32 terminates;
}

ReadOnly satisfies RankReader {
    machine read(value: &u32) -> u32
    {
        value
    }
    machine keep(value: u32) -> u32
    {
        value
    }
}

machine nested_countdown(selected: dyn RankReader, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(selected, remaining) }
    machine scan(selected: dyn RankReader, remaining: u32) -> u32
    requires remaining <= 9;
    {
        let observed: u32 = RankReader::read(selected, &remaining);
        let nested: u32 = RankReader::keep(selected, RankReader::read(selected, &remaining));
        transition remaining > 0 {
            true -> scan(selected, remaining - 1)
            false -> nested
        }
    }

}

machine composed_countdown(selected: dyn RankReader, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(selected, remaining) }
    machine scan(selected: dyn RankReader, remaining: u32) -> u32
    requires remaining <= 9;
    {
        let observed: u32 = RankReader::read(selected, &remaining);
        let composed: u32 = RankReader::read(selected, &remaining) + 0;
        transition remaining > 0 {
            true -> scan(selected, remaining - 1)
            false -> composed
        }
    }

}

machine main() crashes Trap {
    let selected: dyn RankReader = ReadOnly as dyn RankReader;
    let nested: u32 = nested_countdown(selected, 4);
    let composed: u32 = composed_countdown(selected, 4);
    transition nested == 0 && composed == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
