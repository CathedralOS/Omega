use omega::language::core::float_operations;

machine countdown(value: f64, count: u64)
requires value >= 0.0 && count <= 4;
terminates by count in 0..=4;
-> f64 {
    transition count == 0 {
        true -> value
        false -> countdown(value, count - 1)
    }
}

machine narrow(value: f32, count: u64)
requires value >= 0.0f32;
requires count <= 4;
terminates by count in 0..=4;
-> f32 {
    transition count == 0 {
        true -> value
        false -> narrow(value, count - 1)
    }
}

machine ping(value: f64, count: u64)
requires value >= 0.0 && count <= 4;
terminates by count in 0..=4;
-> f64 {
    transition count == 0 {
        true -> value
        false -> pong(value, count - 1)
    }
}
machine pong(value: f64, count: u64)
requires value >= 0.0 && count <= 4;
terminates by count in 0..=4;
-> f64 {
    transition count == 0 {
        true -> value
        false -> ping(value, count - 1)
    }
}

data Reading { value: f64; }
machine ranged(reading: &Reading, count: u64)
requires reading.value >= 0.0 && count <= 4;
terminates by count in 0..=4;
-> f64 {
    transition count == 0 {
        true -> reading.value
        false -> advance(reading, count - 1)
    }
    machine advance(current: &Reading, pending: u64) -> f64
    requires current.value >= 0.0 && pending <= 4;
    {
        transition pending == 0 {
            true -> current.value
            false -> ranged(current, pending - 1)
        }
    }
}

machine observed(reading: &Reading, count: u64) -> f64
requires count <= 4;
{
    let ready: bool = reading.value >= 0.0;
    transition ready {
        true -> ranged(reading, count)
        false -> 0.0
    }
}

machine supplied() -> f64
ensures result >= 0.0;
{ 2.0 }

machine main() crashes Trap {
    let smaller: f32 = narrow(1.0f32, 2);
    let supplied_value: f64 = supplied();
    let direct: f64 = countdown(supplied_value, 3);
    let value: f64 = ping(2.0, 3);
    let reading: Reading = Reading { value: 3.0 };
    transition reading.value >= 0.0 {
        true -> check(&reading, value, direct, smaller)
        false -> bad()
    }
    machine check(reading: &Reading, value: f64, direct: f64, smaller: f32)
    requires reading.value >= 0.0;
    {
        let field: f64 = ranged(reading, 3);
        let saved: f64 = observed(reading, 4);
        transition value == 2.0 && direct == 2.0 && field == 3.0 && saved == 3.0 && smaller == 1.0f32 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

