// A call component's arrival premise observes limits.ceiling, not the whole
// record. Writing its sibling remains legal and visible to the caller.
data Limits { ceiling: u32; observed: u32; }

machine first(limits: &mut Limits, remaining: u32, scratch: u32) -> u32
requires remaining <= 9 && limits.ceiling <= 4 && scratch <= limits.ceiling;
terminates by remaining in 0..=9;
{
    transition { _ -> step(limits, remaining, scratch) }
    machine step(limits: &mut Limits, current: u32, saved: u32) -> u32
    requires current <= 9 && limits.ceiling <= 4 && saved <= limits.ceiling;
    {
        limits.observed = 1;
        transition current > 0 {
            true -> second(limits, current - 1, saved)
            false -> (70)
        }
    }
}

machine second(limits: &mut Limits, pending: u32, saved: u32) -> u32
requires pending <= 9 && limits.ceiling <= 4 && saved <= limits.ceiling;
terminates by pending in 0..=9;
{
    transition pending > 0 {
        true -> first(limits, pending - 1, saved)
        false -> (70)
    }
}

machine main() crashes Trap {
    let mut limits: Limits = Limits { ceiling: 4, observed: 0 };
    let result: u32 = first(&mut limits, 7, 2);
    transition result == 70 && limits.ceiling == 4 && limits.observed == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
