use omega::language::core::external_binding;
public data ForeignMath {}
public boundary requirement ForeignMath::absolute(value: i32) -> i32
terminates;
requires value >= 0 && value <= 9;
ensures result == value;
data ForeignProvider {}
macos_arm64 machine abs_binding() -> ForeignBinding<17, 4, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "libSystem.B.dylib", symbol: "_abs"
    } }
}
macos_arm64 machine ForeignProvider::absolute(value: i32) -> i32
satisfies ForeignMath::absolute via abs_binding();
machine require_identity(actual: i32, expected: i32) -> i32
requires actual == expected;
{ actual }
machine countdown(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
{
    let direct: i32 = ForeignMath::absolute(remaining);
    let direct_checked: i32 = require_identity(direct, remaining);
    let nested: i32 = ForeignMath::absolute(ForeignMath::absolute(remaining));
    let nested_checked: i32 = require_identity(nested, remaining);
    let composed: i32 = ForeignMath::absolute(remaining) + 0;
    let composed_checked: i32 = require_identity(composed, remaining);
    transition remaining > 0 {
        true -> countdown(ForeignMath::absolute(remaining - 1))
        false -> composed_checked
    }
}
