use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::package(builder, "native_bindings_external_result_ranked_arrival_compile");

 Build::bind<ForeignMath::absolute>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "libSystem.B.dylib", symbol: "_abs"
    } });
}
