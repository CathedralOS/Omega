// A `measure` over a whole record projects its member as the rank:
// `Countdown::Remaining(countdown)` reads `countdown.remaining`, and
// `terminates by countdown -> Countdown::Remaining` ranks the machine on
// the projected field's descent.
data Countdown { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }
machine walk(countdown: Countdown) -> u64
terminates by countdown -> Countdown::Remaining {
    transition countdown.remaining > 0 {
        true -> walk(Countdown { remaining: countdown.remaining - 1 })
        false -> countdown.remaining
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
