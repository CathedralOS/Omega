// A declared measure computes `value * 2` over its `u8` parameter; the
// authored range `0..=200` constrains the produced rank, not the
// `[0..=100]` subject — entry proves `2 * remaining <= 200` and the
// guarded self edge proves strict descent of `2 * (remaining - 1)`
// against `2 * remaining`.
data Countdown {}
measure Countdown::Doubled(value: u8) -> u8 { value * 2 }
machine walk(remaining: u8) -> u8
terminates by remaining -> Countdown::Doubled in 0..=200
requires remaining <= 100
{
    transition remaining > 0 {
        true -> walk(remaining - 1)
        false -> remaining
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
