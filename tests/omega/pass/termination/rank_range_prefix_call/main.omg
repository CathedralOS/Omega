// PASS CANARY. `walk` issues `Main::audit(main, remaining)` before its recursive
// edge. The checked-body callee's complete write frame covers only
// `main.audits`, disjoint from every premise carrier (`remaining` and the
// pinned `ceiling`), so the entry-relative rank still describes the
// transition actuals.
data Main { audits: u64 }

machine Main::main(main: &mut Main) -> u32 {
    transition { _ -> Main::walk(main, 4, 9) }
}

machine Main::audit(main: &mut Main, value: u32) {
    main.audits = 0;
}

machine Main::walk(main: &mut Main, remaining: u32, ceiling: u32)
requires
    5 <= ceiling && ceiling <= 10;
    remaining <= ceiling;
terminates by remaining in 0..=ceiling;
-> u32 {
    Main::audit(main, remaining);
    transition remaining > 0 {
        true -> walk(main, remaining - 1, ceiling)
        false -> remaining
    }
}
