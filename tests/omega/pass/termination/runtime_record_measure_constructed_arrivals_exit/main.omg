data Countdown where 0 <= remaining, remaining <= 5, 0 <= limit, limit <= 5 {
    remaining: u64;
    limit: u64;
}
measure Countdown::Remaining(countdown: Countdown) -> u64
{ countdown.remaining }

machine walk(countdown: Countdown)
requires countdown.remaining <= countdown.limit;
terminates by countdown -> Countdown::Remaining in 0..=countdown.limit;
-> u64 {
    transition countdown.remaining > 0 {
        true -> iterate(Countdown {
            remaining: countdown.remaining - 1,
            limit: countdown.limit
        })
        false -> countdown.remaining
    }
    state iterate(pending: Countdown)
    {
        transition pending.remaining > 0 {
            true -> iterate(Countdown {
                remaining: pending.remaining - 1,
                limit: pending.limit
            })
            false -> pending.remaining
        }
    }
}

machine main() crashes Trap {
    let empty: u64 = walk(Countdown { remaining: 0, limit: 5 });
    let partial: u64 = walk(Countdown { remaining: 3, limit: 5 });
    let full: u64 = walk(Countdown { remaining: 5, limit: 5 });
    transition empty == 0 && partial == 0 && full == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
