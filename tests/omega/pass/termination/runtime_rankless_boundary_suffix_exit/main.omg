// The boundary contract cannot reenter the countdown. The rankless suffix
// still executes its selected provider; the entry checks the observed result.
pub boundary trait Output { machine value() -> u32; }
pub data Provider {}
machine Provider::value() -> u32 satisfies Output::value { 37 }
// Each family member retains the abstract service it invokes. The generated
// interface publishes their inferred reach even though it has no body.
macos_arm64 machine selected() -> u32 reaches Output { Output::value() }
macos_x86_64 machine selected() -> u32 reaches Output { Output::value() }
linux_x86_64 machine selected() -> u32 reaches Output { Output::value() }
linux_arm64 machine selected() -> u32 reaches Output { Output::value() }
windows_x86_64 machine selected() -> u32 reaches Output { Output::value() }
machine count(remaining: u32) terminates by remaining; -> u32 reaches Output {
    transition remaining > 0 {
        true -> count(remaining - 1)
        false -> finish()
    }
    state finish() -> u32 { selected() }
}
data Main { }
machine Main::main(main: &mut Main) reaches Output crashes Trap {
    let result: u32 = count(3);
    transition result == 37 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

ProviderOutputImplementation satisfies Output {
    Output::value = Provider::value;
}
