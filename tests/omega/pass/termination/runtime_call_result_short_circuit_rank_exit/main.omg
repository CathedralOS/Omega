// An insertion sort's sift: a call statement splits the entry before a
// short-circuit guard over its result. The guard's second test is a block
// with no parameters, so the loop counter it sees is the one its
// predecessor rebound after the call, not the header's; the ranked cycle
// keeps exactly the one authored descent.
use omega_language_std::console;

data Main { values: [i32; 6]; }

machine swap_descending(values: &mut [i32; 6], position: u64) -> bool
requires position < 6
{
    transition position > 0 && values[position - 1] > values[position] {
        true -> swap(values, position)
        _ -> (false)
    }
    state swap(values: &mut [i32; 6], position: u64) -> bool
    requires position > 0 && position < 6
    {
        let left: i32 = values[position - 1];
        values[position - 1] = values[position];
        values[position] = left;
        transition { _ -> (true) }
    }
}

machine sift(values: &mut [i32; 6], position: u64) -> bool
terminates by position -> Nat::Descending;
requires position < 6
{
    let swapped: bool = swap_descending(values, position);
    transition swapped && position > 0 {
        true -> sift(values, position - 1)
        _ -> (true)
    }
}

machine sort(values: &mut [i32; 6], index: u64) -> bool
terminates by (index, 6) -> Nat::BoundedDistance;
requires index < 6
{
    let sifted: bool = sift(values, index);
    transition index + 1 < 6 {
        true -> sort(values, index + 1)
        _ -> (true)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.values[0] = 5;
    main.values[1] = -2;
    main.values[2] = 9;
    main.values[3] = 0;
    main.values[4] = 3;
    main.values[5] = -7;
    let sorted: bool = sort(&mut main.values, 0);
    transition main.values[0] == -7 && main.values[1] == -2 && main.values[2] == 0
        && main.values[3] == 3 && main.values[4] == 5 && main.values[5] == 9 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
