// `measure Card::PowerOrder` — an authored ranking order; `terminates by
// power -> Card::PowerOrder` ranks the recursive call through it.
data Card {
    power: u64;
}
measure Card::PowerOrder(power: u64) -> u64 { power }
machine weaken(power: u64) -> u64
    terminates by power -> Card::PowerOrder {
    transition power > 0 {
        true -> weaken(power - 1)
        false -> power
    }
}
machine main() {
    let value: u64 = weaken(3);
}
