// COMPILE CANARY. An acyclic satisfier inherits the requirement's published
// guarantee without repeating either `terminates;` or a private witness.
trait Value {
    machine value() -> u64 terminates;
}

machine main() {
    let result: u64 = value();
    let direct: u64 = direct_value();
}

machine value() -> u64
satisfies Value::value
{
    7
}

// A one-member boundary trait owns the same published interface. Its satisfier
// precedes it deliberately: inheritance cannot depend on declaration order.
machine direct_value() -> u64
satisfies Direct::value
{
    9
}

boundary trait Direct {
    machine value() -> u64
    terminates
    reaches;
}
