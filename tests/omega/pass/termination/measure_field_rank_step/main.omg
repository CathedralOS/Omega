data Countdown where 0 <= remaining, remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64
{ countdown.remaining }

machine walk(countdown: Countdown, amount: u64)
    requires 1 <= amount && amount <= 2
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition countdown.remaining >= amount {
        true -> walk(Countdown { remaining: countdown.remaining - amount }, amount)
        false -> countdown.remaining
    }
}
