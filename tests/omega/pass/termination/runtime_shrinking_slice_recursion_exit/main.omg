// Shrinking-slice recursion executes at runtime, pure tail dispatch end to
// end (no statement-position calls — those still over-execute natively; see
// the non-guard executor-of-record residue in TASKS.md). Each true arm
// tail-calls with the items[1..] window (the guard fact proves the [0] read
// and the subslice) and threads the head element's value, folded into machine
// state on entry. 10+20+15+25 = 70 in self.total drives exit 70 only when
// every shrinking window executed its descriptor update and element read.
//
// Regression shape: a self-recursive machine shares ONE call context, so the
// transition retargets the very frame slots it reads. `items[0].value` must
// lower as an indexed read THROUGH the slice descriptor's data pointer and be
// staged alongside the subslice before either parameter slot commits. The bug
// this canary pins resolved it as a plain place over the descriptor slot,
// handing `take` the data pointer's low bytes (exit saw 152 = (4*ptr+24) & 0xff).

use omega_language_std::console;

data Entry {
    value: u32 in Wrapping;
}

data Main {
    console: Console;
    entries: [Entry; 4];
    total: u32 in Wrapping;
}

machine Main::main(&mut self) {
    self.entries[0].value = 10;
    self.entries[1].value = 20;
    self.entries[2].value = 15;
    self.entries[3].value = 25;

    let view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> self.accumulate(view, 0)
    }
}

machine Main::accumulate(&mut self, items: &[Entry], take: u32 in Wrapping)
terminates by items -> Slice::Length;
{
    self.total = self.total + take;

    transition items.len > 0 {
        true -> accumulate(items[1..], items[0].value)
        false -> finished()
    }

    state finished(&mut self) {
        transition self.total {
            70 -> matched()
            _ -> missed()
        }
    }

    state matched(&mut self) {
        self.console.exit_process(70);
    }

    state missed(&mut self) {
        self.console.exit_process(71);
    }
}
