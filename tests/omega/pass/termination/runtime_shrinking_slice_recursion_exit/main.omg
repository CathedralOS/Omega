// Shrinking-slice recursion executes at runtime, pure tail dispatch end to
// end (no statement-position calls — those still over-execute natively; see
// the non-guard executor-of-record residue in TASKS.md). Each true arm
// tail-calls with the items[1..] window (the guard fact proves the [0] read
// and the subslice) and threads the head element's value, folded into machine
// state on entry. 10+20+15+25 = 70 in main.total drives exit 70 only when
// every shrinking window executed its descriptor update and element read.
//
// Regression shape: a self-recursive machine shares ONE call context, so the
// transition retargets the very frame slots it reads. `items[0].value` must
// lower as an indexed read THROUGH the slice descriptor's data pointer and be
// staged alongside the subslice before either parameter slot commits. The bug
// this canary pins resolved it as a plain place over the descriptor slot,
// handing `take` the data pointer's low bytes (exit saw 152 = (4*ptr+24) & 0xff).

use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: u32 in Wrapping;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
    total: u32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 10;
    main.entries[1].value = 20;
    main.entries[2].value = 15;
    main.entries[3].value = 25;

    let view: &[Entry] = main.entries.as_slice();
    main.total = Main::accumulate(view, 0);

    transition main.total {
        70 -> matched(main)
        _ -> missed(main)
    }

    state matched(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}

// The running total is CARRIED and RETURNED rather than accumulated into the
// caller's record: `items` is a shared view of `main.entries`, and taking
// `&mut Main` beside it would mutate the record a live shared child freezes.
// The shrinking-slice recursion this fixture exists to cover is unchanged.
machine Main::accumulate(items: &[Entry], carried: u32 in Wrapping)
terminates by items -> Slice::Length;
-> u32 in Wrapping {
    transition items.len > 0 {
        true -> accumulate(items[1..], carried + items[0].value)
        false -> (carried)
    }
}
