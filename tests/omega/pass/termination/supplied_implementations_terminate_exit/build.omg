machine build(builder: &mut Build) {
    Build::application(builder, "supplied_implementations_terminate_exit");
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::select_provider<Selection, X86Selection>(builder, linux_x86_64);
    Build::select_provider<Selection, X86Selection>(builder, windows_x86_64);
    Build::select_provider<Selection, ArmSelection>(builder, linux_arm64);
    Build::select_provider<Selection, ArmSelection>(builder, macos_arm64);
}
