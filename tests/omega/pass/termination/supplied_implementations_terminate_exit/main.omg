// Every supplied implementation of a boundary requirement is part of the
// recurrence, whichever one Build selects. Here none re-enters the ranked
// root, so the cycle is the root's own descent and the program checks. Each
// target's tag is distinct, so a wrong provider row traps.
// Expected exit: 0
boundary trait Selection {
    machine selected() -> u64 reaches;
}
X86Selection satisfies Selection {
    machine selected() -> u64 { 17 }
}
ArmSelection satisfies Selection {
    machine selected() -> u64 { 29 }
}
machine walk(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance
{
    transition index < limit {
        true -> walk(index + 1, limit)
        _ -> done()
    }
    machine done() -> u64 { Selection::selected() }
}
machine x86_entry() crashes Trap {
    let tag: u64 = walk(0, 4);
    transition tag == 17 { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
machine arm_entry() crashes Trap {
    let tag: u64 = walk(0, 4);
    transition tag == 29 { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
