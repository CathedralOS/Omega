// Both rank endpoints may be symbolic parameters: `in floor..=ceiling`
// — and the mutual members SWAP which formal supplies which bound at
// each edge (`first` takes floor, `second` takes upper/lower), so the
// telescope re-instantiates the interval per callee.
data Main {}
machine Main::first(main: &mut Main, floor: u64, remaining: u64, ceiling: u64) -> u64
requires floor <= remaining && remaining <= ceiling
terminates by remaining in floor..=ceiling {
    transition remaining > floor {
        true -> Main::second(main, ceiling, remaining, floor)
        false -> remaining
    }
}
machine Main::second(main: &mut Main, upper: u64, pending: u64, lower: u64) -> u64
requires lower <= pending && pending <= upper
terminates by pending in lower..=upper {
    transition pending > lower {
        true -> Main::first(main, lower, pending - 1, upper)
        false -> pending
    }
}
machine Main::main(main: &mut Main) -> u64 {
    transition { _ -> Main::first(main, 2, 6, 6) }
}
