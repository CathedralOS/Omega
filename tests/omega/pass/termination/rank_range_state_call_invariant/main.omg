// PASS CANARY. A component call issued from a subordinate state reads the
// member's own authored range as that arrival's invariant: `outer`'s
// state-edge judgment re-establishes `0 <= remaining <= cap` at
// `hold(remaining, cap)`, so the site `hold -> inner(pending, bound)` proves
// membership of the transported rank from that invariant rather than from a
// guard that respells it, and the unranged `inner` conserves the endpoint
// back through `outer(limit, n - 1)`.

data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.outer(6, 4) }
}

machine Main::outer(&mut self, cap: u64, remaining: u64)
requires remaining <= cap;
terminates by remaining in 0..=cap;
-> u64 {
    transition remaining > 0 {
        true -> hold(remaining, cap)
        false -> remaining
    }
    state hold(pending: u64, bound: u64) {
        transition pending > 0 {
            true -> self.inner(pending, bound)
            false -> pending
        }
    }
}

machine Main::inner(&mut self, n: u64, limit: u64)
terminates by n;
-> u64 {
    transition n > 0 && n <= limit {
        true -> self.outer(limit, n - 1)
        false -> n
    }
}
