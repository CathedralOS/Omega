// The pinned view bound `limit` is a mutable input (`mut limit`), but
// its declared range forms the computed endpoint `limit + 1` at every
// evaluation; the premise-preserving prefix proves `limit` still
// denotes its arrival value across the named-state cycle.
machine main() -> u64 {
    transition { _ -> walk(0, 4) }
}
machine walk(index: u64, mut limit: u64)
    requires 0 <= limit && limit <= 10
requires index <= limit;
terminates by index -> Nat::IncreasingTo(limit) in 0..=(limit + 1);
-> u64 {
    transition index < limit {
        true -> step(index + 1, limit)
        false -> index
    }
    machine step(cursor: u64, ceiling: u64) -> u64
    requires ceiling <= 10
    {
        transition cursor < ceiling {
            true -> walk(cursor + 1, ceiling)
            false -> cursor
        }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
