// Two machines share the same declared lexicographic view:
// `measure Progress::Steps lexicographic { outer, inner }` ranks the
// pair in dictionary order — the first edge forwards the tuple
// unchanged, the second preserves `outer` and strictly decreases
// `inner`.
data Progress {
    outer: u64;
    inner: u64;
}
measure Progress::Steps lexicographic { outer, inner }
data Main {}
machine Main::main(main: &mut Main) -> u64 {
    transition {
        _ -> Main::scan_a(main, Progress { outer: 1, inner: 4 })
    }
}
machine Main::scan_a(main: &mut Main, progress: Progress) -> u64
terminates by progress -> Progress::Steps
{
    transition progress.inner > 0 {
        true -> Main::scan_b(main, progress)
        false -> 0
    }
}
machine Main::scan_b(main: &mut Main, progress: Progress) -> u64
terminates by progress -> Progress::Steps
{
    transition progress.inner > 0 {
        true -> Main::scan_a(main, Progress {
            outer: progress.outer,
            inner: progress.inner - 1,
        })
        false -> 0
    }
}
