// PASS CANARY. `right` arrives as the strict step `remaining - stride`, and
// `stride`'s declared floor proves the amount nonzero: the moved copy names
// the continuation the rank reads, `pair`'s telescope demotes the stale
// `left` snapshot, and `step(right)` transports the descended copy through
// the call component.
data Main {}

machine Main::main(main: &mut Main) -> u32
{
    transition { _ -> Main::count(main, 9, 1) }
}

machine Main::count(main: &mut Main, remaining: u32, stride: u32)
    requires 0 <= remaining && remaining <= 9 && 1 <= stride && stride <= 5
terminates by remaining in 0..=9;
-> u32 {
    transition remaining >= stride {
        true -> pair(main, remaining, remaining - stride, stride)
        false -> remaining
    }
    machine pair(main: &mut Main, left: u32, right: u32, step: u32) -> u32
        requires 0 <= left && left <= 9 && 0 <= right && right <= 9 && 1 <= step && step <= 5
    {
        transition left > 0 {
            true -> Main::step(main, right, step)
            false -> right
        }
    }
}

machine Main::step(main: &mut Main, n: u32, stride: u32)
    requires 0 <= n && n <= 9 && 1 <= stride && stride <= 5
terminates by n in 0..=9;
-> u32 {
    transition n >= stride {
        true -> Main::count(main, n - stride, stride)
        false -> n
    }
}
