// PASS CANARY. A member may issue a component call from a subordinate state:
// `hold -> step(pending)` transports `pending` to its discovered entry role
// `remaining`, so the edge is weak (`remaining` unchanged) and the strict
// `step -> count(n - 1)` edge completes every cycle's descent.

data Main {}

machine Main::main(&mut self) -> u32 {
    transition { _ -> Main::count(&mut self, 5) }
}

machine Main::count(main: &mut Main, remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition remaining > 0 {
        true -> hold(main, remaining)
        false -> remaining
    }
    state hold(main: &mut Main, pending: u32)
    requires pending <= 9
    {
        transition pending > 0 {
            true -> Main::step(main, pending)
            false -> pending
        }
    }
}

machine Main::step(main: &mut Main, n: u32)
terminates by n in 0..=9;
-> u32
requires n <= 9
{
    transition n > 0 {
        true -> Main::count(main, n - 1)
        false -> n
    }
}
