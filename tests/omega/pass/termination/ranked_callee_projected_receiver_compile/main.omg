// RUN CANARY (exit 70). Ranked callee entered through a projected
// receiver: `engine.cursor.step(...)` borrows the `cursor` field as the
// callee's whole receiver, and the callee's ranked backedge keeps that
// same projected referent as its subject
// (wiki/spec/language/termination.md "Ranked callees on projected
// receivers"). The caller/callee join preserves the exact projection,
// callee identity, return/cleanup, and the caller-visible write: `main`
// starts the cursor at 5 so `step` iterates five times before `done`
// zeroes `cursor.remaining` on the projected referent, `run` reads it back
// through `engine.cursor`, and `main` exits 70 only when that composed
// write is observed (an unwritten cursor still reads 5 and exits 71).
use omega_language_std::console;
use omega::language::core::binding;

data Cursor where remaining <= 8 { remaining: u64; }

machine Cursor::step(cursor: &mut Cursor, remaining: u64 [0..=8]) -> u64 [0..=8]
terminates by remaining -> Nat::Descending;
{
    transition remaining > 0 {
        true -> Cursor::step(cursor, remaining - 1)
        false -> done(cursor)
    }
    state done(cursor: &mut Cursor) -> u64 [0..=8] {
        cursor.remaining = 0;
        0
    }
}

data Engine { cursor: Cursor; }

machine Engine::run(engine: &mut Engine) -> u64 [0..=8] {
    let start: u64 [0..=8] = engine.cursor.remaining;
    _ = Cursor::step(&mut engine.cursor, start);
    engine.cursor.remaining
}

data Main {
    console: Binding<Console>;
    engine: Engine;
}

machine Main::main(main: &mut Main) reaches Console {
    main.engine.cursor.remaining = 5;
    transition Engine::run(&mut main.engine) == 0 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
