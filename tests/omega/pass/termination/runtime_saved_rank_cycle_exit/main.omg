// Saved arguments retain the ranked value, not another same-typed parameter.
data Main {}

// This nominal operator cannot apply to the countdown's u32 observations.
data Distance { value: u32; }
boundary machine - Distance::subtract(left: Distance, right: Distance) -> Distance;

machine Main::count(remaining: u32, marker: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition remaining > 0 {
        true -> hold(marker, remaining)
        false -> marker
    }
    machine hold(mut marker: u32, pending: u32) -> u32
    requires pending > 0 && pending <= 9
    {
        let saved: u32 = pending;
        marker = 7;
        transition { _ -> Main::step(saved - 1, marker) }
    }
}

machine Main::step(remaining: u32, marker: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition { _ -> Main::count(remaining, marker) }
}

machine Main::main() crashes Trap {
    let result: u32 = Main::count(5, 2);
    let empty: u32 = Main::count(0, 3);
    transition result == 7 && empty == 3 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
