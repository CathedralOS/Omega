// PASS CANARY. A ranged member authors a `.len` ceiling on its scalar rank
// while the second member keeps no range of its own. The unranged member
// still transports the produced length exactly: `bag` arrives from `items`
// and returns to `items`, so the pinned endpoint is conserved through the
// mixed component and the `remaining - 1` edge keeps the cycle strict.
data Main {
    entries: [u64; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[u64] = self.entries.as_slice();

    transition {
        _ -> self.outer(3, view)
    }
}

machine Main::outer(&mut self, remaining: u64, items: &[u64])
requires items.len >= remaining;
terminates by remaining in 0..=items.len;
-> u64 {
    transition remaining > 0 {
        true -> self.inner(remaining - 1, items)
        false -> remaining
    }
}

machine Main::inner(&mut self, n: u64, bag: &[u64])
requires bag.len >= n;
terminates by n;
-> u64 {
    transition n > 0 {
        true -> self.outer(n, bag)
        false -> n
    }
}
