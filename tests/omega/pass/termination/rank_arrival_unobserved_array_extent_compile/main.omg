data Countdown where remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }

machine identity(value: Countdown) -> Countdown
ensures result.remaining == value.remaining;
{ value }

machine walk(countdown: Countdown, padding: &[u8; 65536])
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition {
        _ -> iterate(identity(countdown), Countdown { remaining: 4 }, padding)
    }
    machine iterate(held: Countdown, spare: Countdown, padding: &[u8; 65536]) -> u64 {
        transition held.remaining > 0 {
            true -> iterate(identity(Countdown { remaining: held.remaining - 1 }), spare, padding)
            false -> held.remaining
        }
    }
}

machine main() {}

// Execute the unchanged walk with the large unrelated array it forwards.
// The selected rank remains Countdown.remaining, not an array element.
machine run() crashes Trap {
    let padding: [u8; 65536];
    let result: u64 = walk(Countdown { remaining: 5 }, &padding);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
