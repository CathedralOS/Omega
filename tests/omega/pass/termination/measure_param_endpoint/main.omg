// A projected-measure rank range may name a parameter endpoint:
// `in 0..=ceiling` uses the machine's own `ceiling` formal, repinned by
// the requires fact `5 <= ceiling && ceiling <= 10`; a subordinate
// state carries its own requires clause, and the record's data-where
// facts (`0 <= remaining <= 5`) discharge the descent measure.
data Countdown where 0 <= remaining, remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64
{ countdown.remaining }
machine walk(countdown: Countdown, ceiling: u64)
    requires 5 <= ceiling && ceiling <= 10
terminates by countdown -> Countdown::Remaining in 0..=ceiling;
-> u64 {
    transition { _ -> iterate(ceiling, countdown) }
    machine iterate(limit: u64, pending: Countdown) -> u64
        requires 5 <= limit && limit <= 10
    {
        transition pending.remaining > 0 {
            true -> iterate(limit, Countdown { remaining: pending.remaining - 1 })
            false -> pending.remaining
        }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
