// `count` is a mutable input outside every ranking premise: not the
// subject, not the pinned view bound, not a range endpoint, named by
// no requires fact. Its complete write frame is disjoint from those
// carriers, so the store before the transition leaves the
// entry-relative ranking intact.
machine main() -> u64 {
    transition { _ -> walk(0, 4, 0) }
}
machine walk(index: u64, limit: u64, mut count: u64) -> u64
requires
    limit <= 10,
    index <= limit
terminates by index -> Nat::IncreasingTo(limit) in 0..=(limit + 1) {
    count = index;
    transition index < limit {
        true -> walk(index + 1, limit, count)
        false -> count
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
