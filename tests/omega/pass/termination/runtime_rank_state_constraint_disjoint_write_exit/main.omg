machine walk(remaining: u32)
requires remaining <= 9
terminates by remaining in 0..=9;
-> u32 {
    transition { _ -> step(remaining, 4, 2, 0) }

    machine step(current: u32, mut ceiling: u32, scratch: u32, mut unrelated: u32) -> u32
    requires current <= 9 && ceiling <= 4 && scratch <= ceiling
    {
        unrelated = 1;
        transition scratch > ceiling {
            true -> step(current, 4, scratch, unrelated)
            false -> (70)
        }
    }
}

machine main() crashes Trap {
    let result: u32 = walk(7);
    transition result == 70 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
