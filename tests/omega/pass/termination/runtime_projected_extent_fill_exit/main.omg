// Nested fixed extents and runtime slice extents survive element writes.
// Mixed ranged/unranged recursion must conserve the authored endpoint.
data Cells { bytes: [u8; 4]; }
data Storage { cells: Cells; }

machine fill_nested(storage: &mut Storage, position: u64) -> u64
terminates by (position, storage.cells.bytes.len) -> Nat::BoundedDistance in 0..=storage.cells.bytes.len;
requires position < storage.cells.bytes.len
{
    storage.cells.bytes[position] = 7;
    transition position + 1 < storage.cells.bytes.len {
        true -> fill_nested_next(storage, position + 1)
        false -> (position + 1)
    }
}

machine fill_nested_next(storage: &mut Storage, position: u64) -> u64
terminates by (position, storage.cells.bytes.len) -> Nat::BoundedDistance;
requires position < storage.cells.bytes.len
{
    storage.cells.bytes[position] = 7;
    transition position + 1 < storage.cells.bytes.len {
        true -> fill_nested(storage, position + 1)
        false -> (position + 1)
    }
}

machine fill_slice(bytes: &mut [u8], position: u64) -> u64
terminates by (position, bytes.len) -> Nat::BoundedDistance in 0..=bytes.len;
requires position < bytes.len
{
    bytes[position] = 3;
    transition position + 1 < bytes.len {
        true -> fill_slice_next(bytes, position + 1)
        false -> (position + 1)
    }
}

machine fill_slice_next(bytes: &mut [u8], position: u64) -> u64
terminates by (position, bytes.len) -> Nat::BoundedDistance;
requires position < bytes.len
{
    bytes[position] = 3;
    transition position + 1 < bytes.len {
        true -> fill_slice(bytes, position + 1)
        false -> (position + 1)
    }
}

machine overwrite_reborrow(bytes: &mut [u8], position: u64)
requires bytes.len >= 2 && position < bytes.len
{
    let view: &mut [u8] = &mut bytes[..];
    view[position] = 9;
    let tail: &mut [u8] = &mut bytes[1..];
    tail[0] = 11;
}

machine main() crashes Trap {
    let mut storage: Storage;
    let count: u64 = fill_nested(&mut storage, 0);
    let filled: bool = count == 4 && storage.cells.bytes[0] == 7
        && storage.cells.bytes[1] == 7 && storage.cells.bytes[2] == 7
        && storage.cells.bytes[3] == 7;
    let view: &mut [u8] = &mut storage.cells.bytes[..];
    let sliced: u64 = fill_slice(view, 0);
    let slice_filled: bool = storage.cells.bytes[0] == 3 && storage.cells.bytes[1] == 3
        && storage.cells.bytes[2] == 3 && storage.cells.bytes[3] == 3;
    overwrite_reborrow(&mut storage.cells.bytes[..], 2);
    transition filled && slice_filled && sliced == 4 && storage.cells.bytes[0] == 3
        && storage.cells.bytes[1] == 11 && storage.cells.bytes[2] == 9
        && storage.cells.bytes[3] == 3 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
