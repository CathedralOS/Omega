// RUN CANARY (exit 0) + interpreter differential -- invocation-fixed
// remainder endpoints survive a named-state arrival that REORDERS the
// endpoint operands. `walk`'s range `0..(cap % divisor + 6)` names `cap`
// and `divisor`; the entry transition re-binds them to `iterate`'s
// `limit` and `width` (with `pending` last), so every arrival at the loop
// header must re-establish that the preserved remainder still bounds the
// measure. The header `iterate` differs from the entry state, and `main`
// runs unrelated work beside the ranked call. Recovered from the deleted
// `rank_remainder_endpoints` named-state case (c60792d7bdd); the check-only
// `named_computed_rank_endpoints` twin uses a literal divisor and never
// executes.
//
// exit 0 = the countdown reached `pending == 0` and returned it;
// exit 1 = any other outcome.

use omega_language_std::console;

data Main { }

machine walk(remaining: u64, cap: u64, divisor: u64)
    requires 0 <= remaining && remaining <= 5
        && 0 <= cap && cap <= 20
        && 1 <= divisor && divisor <= 5
terminates by remaining in 0..(cap % divisor + 6);
-> u64 {
    transition { _ -> iterate(divisor, cap, remaining) }

    state iterate(width: u64, limit: u64, pending: u64)
        requires 1 <= width && width <= 5
            && 0 <= limit && limit <= 20
            && 0 <= pending && pending <= 5
    {
        transition pending > 0 {
            true -> iterate(width - 0, limit - 0, pending - 1)
            false -> pending
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let tick: u64 = 40 + 2;
    let outcome: u64 = walk(5, 17, 4);
    transition outcome == 0 && tick == 42 {
        true -> passed(main)
        _ -> failed(main)
    }

    state passed(main: &mut Main) { Console::exit_process(0); }
    state failed(main: &mut Main) { Console::exit_process(1); }
}
