// The argumented bounded-distance ranking selected explicitly: a
// climbing-index loop proves termination with
// `terminates by (index, limit) -> Nat::BoundedDistance`. The arrow's
// left side is uniformly the ranked subjects, bound in order to the
// named view's (lower, upper) parameters, so the use site reads as a
// ranking selection rather than ad-hoc proof arithmetic.
machine main() -> u64 {
    transition {
        _ -> walk(4, 0)
    }
}
machine walk(limit: u64, index: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance
{
    transition index < limit {
        true -> walk(limit, index + 1)
        false -> index
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
