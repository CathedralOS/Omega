// A measure rank endpoint computed from a sibling record member:
// `in 0..(countdown.limit + 1)` — exclusive upper bound over the
// member's declared range.
data Countdown where 0 <= remaining, remaining <= 5, 0 <= limit, limit <= 5 {
    remaining: u64;
    limit: u64;
}
measure Countdown::Remaining(countdown: Countdown) -> u64
{ countdown.remaining }
machine walk(countdown: Countdown) -> u64
requires countdown.remaining <= countdown.limit
terminates by countdown -> Countdown::Remaining in 0..(countdown.limit + 1) {
    transition countdown.remaining > 0 {
        true -> walk(Countdown {
            remaining: countdown.remaining - 1,
            limit: countdown.limit
        })
        false -> countdown.remaining
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
