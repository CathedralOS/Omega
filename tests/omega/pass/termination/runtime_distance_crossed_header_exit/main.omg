// Distance ranks must be defined even when the cursor already exceeds its
// bound. Such an entry immediately returns; it does not promise cursor <= bound.
machine count_to(cursor: u64, limit: u64)
terminates by (cursor, limit) -> Nat::BoundedDistance;
-> u64 {
    transition cursor < limit {
        true -> count_to(cursor + 1, limit)
        false -> cursor
    }
}

machine count_to_eight(cursor: u32)
terminates by cursor -> Nat::IncreasingTo(8);
-> u32 {
    transition cursor < 8 {
        true -> count_to_eight(cursor + 1)
        false -> cursor
    }
}

// A call component keeps the bound's value, not its name or formal ordinal.
machine count_via_peer(cursor: u64, limit: u64)
terminates by (cursor, limit) -> Nat::BoundedDistance;
-> u64 {
    transition cursor < limit {
        true -> peer(limit, cursor + 1)
        false -> cursor
    }
}

machine peer(ceiling: u64, position: u64)
terminates by (position, ceiling) -> Nat::BoundedDistance;
-> u64 {
    transition position < ceiling {
        true -> count_via_peer(position + 1, ceiling)
        false -> position
    }
}

machine main() crashes Trap {
    let progressing: u64 = count_to(3, 5);
    let crossed: u64 = count_to(9, 5);
    let maximum: u64 = count_to(18446744073709551615, 0);
    let constant_progressing: u32 = count_to_eight(3);
    let constant_crossed: u32 = count_to_eight(9);
    let constant_maximum: u32 = count_to_eight(4294967295);
    let joint_progressing: u64 = count_via_peer(3, 8);
    let joint_crossed: u64 = count_via_peer(9, 5);
    transition progressing == 5 && crossed == 9 && maximum == 18446744073709551615
        && constant_progressing == 8 && constant_crossed == 9
        && constant_maximum == 4294967295
        && joint_progressing == 8 && joint_crossed == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
