// PASS CANARY. A declared scalar view over projected storage:
// `countdown.remaining -> Countdown::Doubled` produces `value * 2` from the
// exact `u64` member coordinate rather than a bare formal. The flat self
// call descends directly; the two-state form transports the same coordinate
// and the pinned ceiling through the discovered telescope.
data Countdown where 0 <= remaining, remaining <= 5 { remaining: u64; }
measure Countdown::Doubled(value: u64) -> u64
{ value * 2 }

machine walk_flat(countdown: Countdown)
terminates by countdown.remaining -> Countdown::Doubled in 0..=10;
-> u64 {
    transition countdown.remaining > 0 {
        true -> walk_flat(Countdown { remaining: countdown.remaining - 1 })
        false -> countdown.remaining
    }
}

machine walk(countdown: Countdown, limit: u64)
    requires 0 <= limit && limit <= 10
requires countdown.remaining * 2 <= limit;
terminates by countdown.remaining -> Countdown::Doubled in 0..=limit;
-> u64 {
    transition { _ -> step(countdown, limit) }
    machine step(current: Countdown, bound: u64) -> u64
        requires 0 <= bound && bound <= 10
    {
        transition current.remaining > 0 {
            true -> step(Countdown { remaining: current.remaining - 1 }, bound)
            false -> current.remaining
        }
    }
}


data NarrowCountdown {}
measure NarrowCountdown::Doubled(value: u8) -> u8
{ value * 2 }

machine walk_narrow(remaining: u8)
requires remaining <= 100;
terminates by remaining -> NarrowCountdown::Doubled in 0..=200;
-> u8 {
    transition remaining > 0 {
        true -> walk_narrow(remaining - 1)
        false -> remaining
    }
}

machine main() crashes Trap {
    let flat: u64 = walk_flat(Countdown { remaining: 5 });
    let carried: u64 = walk(Countdown { remaining: 5 }, 10);
    let narrow: u8 = walk_narrow(100);
    transition flat == 0 && carried == 0 && narrow == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
