// PASS CANARY. A runtime call component ranked by a declared custom
// struct-field view: `Countdown::Remaining` reads the exact `remaining`
// coordinate of each member's record subject. The forward edge preserves the
// record; the rebuilt literal strictly decreases the coordinate.
data Countdown where 0 <= remaining, remaining <= 5 {
    remaining: u64;
}

measure Countdown::Remaining(countdown: Countdown) -> u64
{
    countdown.remaining
}

data Main {}

machine Main::main(main: &mut Main) -> u64
{
    transition { _ -> Main::scan_a(main, Countdown { remaining: 2 }) }
}

machine Main::scan_a(main: &mut Main, countdown: Countdown)
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition countdown.remaining > 0 {
        true -> Main::scan_b(main, countdown)
        false -> countdown.remaining
    }
}

machine Main::scan_b(main: &mut Main, pending: Countdown)
terminates by pending -> Countdown::Remaining in 0..=5;
-> u64 {
    transition pending.remaining > 0 {
        true -> Main::scan_a(main, Countdown { remaining: pending.remaining - 1 })
        false -> pending.remaining
    }
}
