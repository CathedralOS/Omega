// A bounded-distance loop whose machine also has an exit state, in the shape
// std's chunk copies use: the body calls a helper, then one root edge loops.
// The rank needs no `index <= limit` at entry: a cursor already past its bound
// exits on the first guard, so only the arrival edge owes a decrease. Every
// byte is checked, so the loop must really have run four times.
machine put(chunk: &mut [u8; 4], index: u64) {
    transition index < 4 {
        true -> write(chunk, index)
        _ -> done()
    }
    machine write(chunk: &mut [u8; 4], index: u64) requires index < 4 { chunk[index] = 7; }
    machine done() { }
}
machine fill(chunk: &mut [u8; 4], index: u64, limit: u64)
terminates by (index, limit) -> Nat::BoundedDistance;
{
    put(chunk, index);
    transition index < limit {
        true -> fill(chunk, index + 1, limit)
        _ -> done()
    }
    machine done() { }
}
machine main() crashes Trap {
    let mut chunk: [u8; 4];
    fill(&mut chunk, 0, 3);
    fill(&mut chunk, 9, 4);
    transition chunk[0] == 7 && chunk[1] == 7 && chunk[2] == 7 && chunk[3] == 7 {
        true -> good()
        false -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
