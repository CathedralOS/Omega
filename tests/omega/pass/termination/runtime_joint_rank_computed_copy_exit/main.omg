// Joint call ranking preserves a computed +0 copy and descends at step.
data Main {}

machine Main::main(main: &mut Main) -> u32 {
    transition { _ -> Main::count(main, 5) }
}

machine Main::count(main: &mut Main, remaining: u32)
requires remaining <= 9;
terminates by remaining;
-> u32 {
    transition { _ -> pair(main, remaining, remaining + 0) }
    machine pair(main: &mut Main, left: u32, right: u32) -> u32
    requires left <= 9 && right <= 9;
    {
        transition left > 0 {
            true -> Main::step(main, right)
            false -> left
        }
    }
}

machine Main::step(main: &mut Main, n: u32)
requires n <= 9;
terminates by n in 0..=9;
-> u32 {
    transition n > 0 {
        true -> Main::count(main, n - 1)
        false -> n
    }
}


machine program() crashes Trap {
    let mut instance: Main = Main {};
    let result: u32 = Main::main(&mut instance);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
