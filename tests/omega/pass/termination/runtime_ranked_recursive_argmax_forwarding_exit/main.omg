// A local state forwards the cursor; the recursive machine invocation then
// advances it. The complete call cycle decreases its bounded-distance rank.
// This is not a subordinate-state cycle requiring strictness on both hops.
machine argmax(items: &[i32; 5], index: u64, best: u64) -> u64
requires best < 5
terminates by index -> Nat::IncreasingTo(5);
{
    transition index < 5 {
        true -> step(items, index, best)
        false -> best
    }
    machine step(items: &[i32; 5], index: u64, best: u64) -> u64 requires index < 5, best < 5 {
        transition items[index] > items[best] {
            true -> argmax(items, index + 1, index)
            false -> argmax(items, index + 1, best)
        }
    }
}
machine main() crashes Trap {
    let items: [i32; 5] = [4, -2, 17, 9, 17];
    let found: u64 = argmax(&items, 0, 0);
    transition found == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
