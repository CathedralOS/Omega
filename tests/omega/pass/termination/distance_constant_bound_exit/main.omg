// A bounded distance whose bound is a literal. `(index, 8)` and
// `Nat::IncreasingTo(16)` rank the cursor's distance below a constant: the
// guard `index < 8` keeps the cursor below the bound, and the bound has no
// parameter to thread through the cycle.
use omega_language_std::console;

data Main { }

machine count_to_eight(index: u64) -> u64
terminates by (index, 8) -> Nat::BoundedDistance;
{
    transition index < 8 {
        true -> count_to_eight(index + 1)
        _ -> (index)
    }
}

machine count_to_sixteen(index: u32) -> u32
terminates by index -> Nat::IncreasingTo(16);
{
    transition index < 16 {
        true -> count_to_sixteen(index + 1)
        _ -> (index)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let eight: u64 = count_to_eight(0);
    let sixteen: u32 = count_to_sixteen(3);
    transition eight == 8 && sixteen == 16 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
