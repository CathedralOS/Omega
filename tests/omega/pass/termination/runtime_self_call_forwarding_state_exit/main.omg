machine walk(remaining: u64) -> u64
requires remaining <= 4;
terminates;
terminates by remaining in 0..=4;
{
    transition remaining > 0 {
        true -> forward(remaining)
        false -> 0
    }
    machine forward(count: u64) -> u64
    requires count > 0 && count <= 4;
    {
        transition { _ -> walk(count - 1) }
    }
}

machine walk_value(remaining: u64) -> u64
requires remaining <= 4;
terminates;
terminates by remaining in 0..=4;
{
    transition remaining > 0 {
        true -> forward(remaining)
        false -> 0
    }
    machine forward(count: u64) -> u64
    requires count > 0 && count <= 4;
    {
        let next: u64 = count - 1;
        transition { _ -> (walk_value(next)) }
    }
}

machine walk_arrival(remaining: u64) -> u64
requires remaining <= 4;
terminates;
terminates by remaining in 0..=4;
{
    transition remaining > 0 {
        true -> forward(remaining - 1)
        false -> 0
    }
    machine forward(count: u64) -> u64
    requires count < 4;
    {
        transition { _ -> walk_arrival(count) }
    }
}

machine main() crashes Trap {
    let observed: u64 = walk(4);
    let captured: u64 = walk_value(4);
    let arrival: u64 = walk_arrival(4);
    let signed: i32 = walk_signed(4);
    let bounded: u64 = walk_distance(0, 4);
    transition observed == 0 && captured == 0 && arrival == 0 && signed == 0 && bounded == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine walk_signed(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 4;
terminates;
terminates by remaining -> Nat::Descending in 0..=4;
{
    transition remaining > 0 {
        true -> forward(remaining)
        false -> remaining
    }
    machine forward(count: i32) -> i32
    requires count > 0 && count <= 4;
    {
        transition { _ -> walk_signed(count - 1) }
    }
}

machine walk_distance(index: u64, ceiling: u64) -> u64
requires ceiling <= 4 && index <= ceiling + 1;
terminates;
terminates by (index, ceiling + 1) -> Nat::BoundedDistance;
{
    transition index < ceiling + 1 {
        true -> walk_distance(index + 1, ceiling)
        false -> index
    }
}
