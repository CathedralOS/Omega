// A record payload shuttles between two states in alternating roles:
// `carried` in `first` is delivered as `saved` in `second` and back —
// plus a duplicated actual (`spare, spare`) filling two formals from
// one source.
data Main {}
data Payload { value: u64; }
machine Main::walk(remaining: u32, payload: Payload, spare: u32)
terminates by remaining in 0..=5;
-> u32
requires remaining <= 5
{
    transition remaining > 2 {
        true -> first(payload, remaining - 1, spare, spare)
        false -> second(remaining + 0, payload)
    }
    machine first(carried: Payload, pending: u32, first_spare: u32, second_spare: u32) -> u32
    requires pending <= 5
    {
        transition pending > 0 {
            true -> second(pending - 1, carried)
            false -> pending
        }
    }
    machine second(left: u32, saved: Payload) -> u32
    requires left <= 5
    {
        transition left > 0 {
            true -> first(saved, left - 1, 0, 1)
            false -> left
        }
    }
}
machine Main::main(main: &mut Main) -> u32 {
    transition { _ -> Main::walk(5, Payload { value: 7 }, 9) }
}
