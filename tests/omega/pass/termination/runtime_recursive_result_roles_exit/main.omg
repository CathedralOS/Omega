// The recursive value call's result in EVERY consumer ROLE the aggregate
// unserved-recursive-call-result sweep serves beyond the let binding: a
// GUARD subject (`transition self.countdown(..) == 5`) and a TRANSITION
// ARGUMENT (`true -> fwd(self.countdown(..))`). The value-call-ARG role is
// pinned separately through the bind-first spelling in
// pass/calls/recursive_result_bind_first_arg. Each countdown re-enters its own entry
// (transition-arg self-recursion, measure-proved) and must deliver its
// terminal 5 through the role's slot. Exit 70; distinct exits per role.
use omega_language_std::console;
data Main { console: Console; }
data Cnt { n: u64; }
measure Cnt::Order(n: u64) -> u64 { n }
machine Main::countdown(&mut self, c: Cnt)
terminates by c.n -> Cnt::Order;
-> u64
{
    transition c.n > 0 { true -> countdown(Cnt { n: c.n - 1 }) false -> 5 }
}
machine Main::main(&mut self) {
    // TransitionArgument role: recursive result forwarded as an arg.
    transition self.countdown(Cnt { n: 3 }) == 5 { true -> fwd(self.countdown(Cnt { n: 2 })) _ -> bad_guard() }
    state fwd(&mut self, v: u64) {
        transition v == 5 { true -> good() _ -> bad_fwd() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad_guard(&mut self) { self.console.exit_process(71); }
    state bad_fwd(&mut self) { self.console.exit_process(72); }
}
