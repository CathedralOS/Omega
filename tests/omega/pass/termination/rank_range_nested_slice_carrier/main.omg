// PASS CANARY. The ranked collection arrives nested inside a record
// carrier: `holder` claims `bag`'s entry role at the unique path `bag`
// under `Pair`, so the produced length reads `holder.bag.items`. The
// literal rebuild transports the same role to the next `holder` while the
// strict subslice descends.
data Bag { items: &[u32]; }
data Pair { bag: Bag; }

machine walk(bag: Bag, capacity: u64)
requires bag.items.len <= capacity;
terminates by bag.items -> Slice::Length in 0..=capacity;
-> u64 {
    transition { _ -> step(Pair { bag: bag }, capacity) }
    state step(holder: Pair, bound: u64) {
        transition holder.bag.items.len > 0 {
            true -> step(Pair { bag: Bag { items: holder.bag.items[1..] } }, bound)
            false -> 0
        }
    }
}
