machine bytes_walk(unrelated: u64, bytes: &[u8])
terminates by bytes -> Slice::Length;
-> u64 {
    transition bytes.len > 0 {
        true -> bytes_walk(unrelated, bytes[1..])
        false -> unrelated
    }
}

machine elements_walk(unrelated: u64, elements: &[u32])
terminates by elements -> Slice::Length;
-> u64 {
    transition elements.len > 0 {
        true -> elements_walk(unrelated, elements[1..])
        false -> unrelated
    }
}

machine main() crashes Trap {
    let values: [u32; 3] = [1, 2, 3];
    let elements: &[u32] = &values[..];
    let byte_result: u64 = bytes_walk(7, "abc");
    let element_result: u64 = elements_walk(9, elements);
    transition byte_result == 7 && element_result == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
