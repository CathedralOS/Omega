data Countdown where remaining <= 5 { remaining: u64; }
data Bundle { held: Countdown; spare: Countdown; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }
machine walk(countdown: Countdown)
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition countdown.remaining > 3 {
        true -> iterate(Bundle { held: Countdown { remaining: 3 }, spare: Countdown { remaining: 4 } })
        false -> countdown.remaining
    }
    machine iterate(pending: Bundle) -> u64 {
        transition pending.held.remaining > 0 {
            true -> iterate(Bundle { held: Countdown { remaining: pending.held.remaining - 1 }, spare: pending.spare })
            false -> pending.held.remaining
        }
    }
}
machine main() { let result: u64 = walk(Countdown { remaining: 5 }); }

// Observe the original walk after it replaces its arrival with a fresh
// nested owner. Equal bounds do not make that new value the old subject.
machine run() crashes Trap {
    let result: u64 = walk(Countdown { remaining: 5 });
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
