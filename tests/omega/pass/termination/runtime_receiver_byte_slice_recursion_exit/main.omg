// A static machine recursively receives its context and a shrinking byte view.
// Both arguments keep their authored positions; there is no hidden receiver.
// Seven bytes plus the empty window add 80 to count and produce exit 70.
// Control: termination/runtime_shrinking_slice_recursion_exit uses element views.
use omega_language_std::Console;

data Main {
    count: u32 in Wrapping;
}

machine main(main: &mut Main) {
    main.count = 0;
    transition {
        _ -> walk(main, "abcdefg")
    }
}

machine walk(main: &mut Main, bytes: &[u8])
terminates by bytes -> Slice::Length
reaches Console {
    main.count = main.count + 10;

    transition bytes.len > 0 {
        true -> walk(main, bytes[1..])
        false -> finished(main)
    }

    machine finished(main: &mut Main) {
        transition main.count == 80 {
            true -> matched(main)
            false -> missed(main)
        }
    }

    machine matched(main: &mut Main) {
        Console::exit_process(70);
    }

    machine missed(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
