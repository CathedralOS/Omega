// A receiver-bearing machine re-enters itself with a shrinking byte view.
// The self edge `walk(bytes[1..])` names its view after the implicit `&mut
// self` formal, so the authored argument list holds the subslice one slot
// before its parameter position; the edge must rejoin the argument at that
// authored slot. Each entry adds 10 to `main.count`: seven bytes and the
// final empty window make 80 and exit 70; any other count exits 71.
//
// The byte-view control for `termination/runtime_shrinking_slice_recursion_exit`,
// whose element-view rank still needs the Terminal ranked-cycle validator to
// accept element-view length observations.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    count: u32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.count = 0;
    transition {
        _ -> Main::walk(main, "abcdefg")
    }
}

machine Main::walk(main: &mut Main, bytes: &[u8])
terminates by bytes -> Slice::Length;
reaches Console {
    main.count = main.count + 10;

    transition bytes.len > 0 {
        true -> walk(main, bytes[1..])
        false -> finished(main)
    }

    state finished(main: &mut Main) {
        transition main.count == 80 {
            true -> matched(main)
            false -> missed(main)
        }
    }

    state matched(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}
