// The argumented bounded-distance ranking selected explicitly: the
// climbing-index loop proves termination with
// `terminates by (index, limit) -> Nat::BoundedDistance`. The arrow's left side
// is uniformly the ranked subjects, bound in order to the named view's
// (lower, upper) parameters, so the use site reads as a ranking selection
// rather than ad-hoc proof arithmetic (the use-site subtraction spelling
// `terminates by limit - index` is retired).

data Main {}

machine Main::main(&mut self) -> u64 {
    transition {
        _ -> self.walk(4, 0)
    }
}

machine Main::walk(&mut self, limit: u64, index: u64)
terminates by (index, limit) -> Nat::BoundedDistance;
-> u64
{
    transition index < limit {
        true -> walk(limit, index + 1)
        false -> index
    }
}
