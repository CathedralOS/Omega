// PASS CANARY. The pinned view bound `limit` is a mutable input, but its
// declared range forms the computed endpoint `limit + 1` at every
// evaluation; the premise-preserving prefix separately proves `limit`
// still denotes its arrival value across the named-state cycle.
data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.walk(0, 4) }
}

machine Main::walk(&mut self, index: u64, mut limit: u64 [0..=10])
requires index <= limit;
terminates by index -> Nat::IncreasingTo(limit) in 0..=(limit + 1);
-> u64 {
    transition index < limit {
        true -> step(index + 1, limit)
        false -> index
    }
    state step(cursor: u64, ceiling: u64 [0..=10]) {
        transition cursor < ceiling {
            true -> walk(cursor + 1, ceiling)
            false -> cursor
        }
    }
}
