// PASS CANARY. The pinned view bound `limit` is a mutable input, but its
// arrival requirement bounds the computed endpoint `limit + 1`. The
// write-free prefix preserves that fact across the named-state cycle;
// the requirement does not constrain a later assignment automatically.
machine main() -> u64 {
    transition { _ -> walk(0, 4) }
}

machine walk(index: u64, mut limit: u64)
    requires 0 <= limit && limit <= 10
requires index <= limit;
terminates by index -> Nat::IncreasingTo(limit) in 0..=(limit + 1);
-> u64 {
    transition index < limit {
        true -> step(index + 1, limit)
        false -> index
    }
    machine step(cursor: u64, ceiling: u64) -> u64
    requires ceiling <= 10
    {
        transition cursor < ceiling {
            true -> walk(cursor + 1, ceiling)
            false -> cursor
        }
    }
}
