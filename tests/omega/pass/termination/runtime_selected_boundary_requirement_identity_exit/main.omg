
pub boundary trait BoundaryRankReader {
    machine read(value: &u32) -> u32 terminates
    requires value <= 9
    ensures result == value;
    machine keep(value: u32) -> u32 terminates
    requires value <= 9
    ensures result == value;
}

CheckedReader satisfies BoundaryRankReader {
    machine read(value: &u32) -> u32
    requires value <= 9;
    ensures result == value;
    { value }
    machine keep(value: u32) -> u32
    requires value <= 9;
    ensures result == value;
    { value }
}

machine require_identity(actual: u32, expected: u32) -> u32
requires actual == expected;
{ actual }

machine countdown(remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
reaches BoundaryRankReader
{
    transition { _ -> scan(remaining) }
    state scan(remaining: u32) -> u32
    requires remaining <= 9;
    {
        let observed: u32 = BoundaryRankReader::read(&remaining);
        let direct_checked: u32 = require_identity(observed, remaining);
        let nested: u32 = BoundaryRankReader::keep(BoundaryRankReader::read(&remaining));
        let nested_checked: u32 = require_identity(nested, remaining);
        let composed: u32 = BoundaryRankReader::read(&remaining) + 0;
        let composed_checked: u32 = require_identity(composed, remaining);
        transition remaining > 0 {
            true -> scan(remaining - 1)
            false -> composed_checked
        }
    }
}

data Main { }

machine Main::main(main: &mut Main)
reaches BoundaryRankReader
crashes Trap
{
    let result: u32 = countdown(4);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
