machine build(builder: &mut Build) {
    Build::application(builder, "read_countdown_identity");
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, linux_arm64);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, linux_x86_64);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, macos_arm64);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, macos_x86_64);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, windows_x86_64);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, uefi_x86_64);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, cross_platform_cli);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, local_unchecked);
    Build::select_provider<BoundaryRankReader, CheckedReader>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
