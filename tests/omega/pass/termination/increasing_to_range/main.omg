// The cursor itself increases: the `Nat::IncreasingTo(limit)` view
// owns the bounded remaining-distance normalization, and the
// optional `in 0..=limit` range constrains the produced rank.
data Main {}
machine Main::main(main: &mut Main) {
    let value: u64 = Main::walk(main, 4, 0);
}
machine Main::walk(main: &mut Main, limit: u64, index: u64) -> u64
terminates by index -> Nat::IncreasingTo(limit) in 0..=limit
{
    transition index < limit {
        true -> Main::walk(main, limit, index + 1)
        false -> index
    }
}
