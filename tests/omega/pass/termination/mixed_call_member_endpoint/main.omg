// PASS CANARY. A mixed-range call component conserves a projected endpoint:
// `Main::outer` pins `remaining in 0..=limits.cap` where the ceiling is the
// exact `limits.cap` member coordinate, and the unranged `Main::inner`
// transports the same record through a nested `Wrap` carrier. The projected
// ceiling stays the identical coordinate at every call boundary, so the
// complete cycle admits with strict descent on `remaining`.
data Main {}
data Limits { cap: u64 [0..=9]; }
data Wrap { limits: Limits; }

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.outer(5, Limits { cap: 8 }) }
}

machine Main::outer(&mut self, remaining: u64, limits: Limits)
requires remaining <= limits.cap;
terminates by remaining in 0..=limits.cap;
-> u64 {
    transition remaining > 0 {
        true -> self.inner(remaining, Wrap { limits: limits })
        false -> remaining
    }
}

machine Main::inner(&mut self, n: u64, wrap: Wrap)
terminates by n;
-> u64 {
    transition n > 0 && n <= wrap.limits.cap {
        true -> self.outer(n - 1, wrap.limits)
        false -> n
    }
}
