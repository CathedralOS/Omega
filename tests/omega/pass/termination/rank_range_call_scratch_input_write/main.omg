// PASS CANARY. `scan_a` stores into `count`, a mutable input outside its
// ranking premises, before the component call. The write frame is disjoint
// from the ranked pair and the requires fact, so the entry-relative distance
// still describes the call's actual arguments.
data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.scan_a(0, 4, 0) }
}

machine Main::scan_a(&mut self, index: u64, limit: u64, mut count: u64)
requires
    index <= 4 && limit <= 4;
    index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    count = index;
    transition index < limit {
        true -> self.scan_b(index, limit, count)
        false -> count
    }
}

machine Main::scan_b(&mut self, index: u64, limit: u64, count: u64)
requires
    index <= 4 && limit <= 4;
    index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    transition index < limit {
        true -> self.scan_a(index + 1, limit, count)
        false -> count
    }
}
