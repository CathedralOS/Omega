use omega::language::core::binding;
pub boundary trait RankReader { machine observe(value: i32) -> i32
terminates
requires value >= 0 && value <= 9
ensures result == value;
}
CheckedReader satisfies RankReader {
    machine observe(value: i32) -> i32
    requires value >= 0 && value <= 9;
    ensures result == value;
    { value }
}
machine require_identity(actual: i32, expected: i32) -> i32
requires actual == expected;
{ actual }
machine countdown(reader: &Binding<RankReader>, remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader
{
    let direct: i32 = reader.observe(remaining);
    let direct_checked: i32 = require_identity(direct, remaining);
    let nested: i32 = reader.observe(reader.observe(remaining));
    let nested_checked: i32 = require_identity(nested, remaining);
    let composed: i32 = reader.observe(remaining) + 0;
    let composed_checked: i32 = require_identity(composed, remaining);
    transition remaining > 0 {
        true -> countdown(reader, reader.observe(remaining - 1))
        false -> composed_checked
    }
}

data Main { reader: Binding<RankReader>; }
machine Main::main(main: &mut Main) reaches RankReader crashes Trap {
    let result: i32 = countdown(&main.reader, 4);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
