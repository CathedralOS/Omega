// Expected exit: 0. Saving a comparison preserves both dispatch polarities.
machine drain(remaining: u64) terminates by remaining; -> u64 {
    let empty: bool = remaining <= 0;
    let nonempty: bool = empty == false;
    transition nonempty {
        true -> drain(remaining - 1)
        false -> remaining
    }
}
machine main() crashes Trap {
    let result: u64 = drain(5);
    transition result == 0 { true -> {} false -> bad() }
    machine bad() { crash Trap; }
}
