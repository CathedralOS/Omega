pub boundary trait RankReader {
    machine step(value: i32) -> i32
    terminates
    requires value > 0 && value <= 9
    ensures result == value - 1;
}
CheckedReader satisfies RankReader {
    machine step(value: i32) -> i32
    requires value > 0 && value <= 9;
    ensures result == value - 1;
    { value - 1 }
}
machine identity(value: i32) -> i32 ensures result == value; { value }

machine direct(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    transition remaining > 0 {
        true -> direct(RankReader::step(remaining))
        false -> remaining
    }
}
machine nested(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    transition remaining > 1 {
        true -> nested(identity(RankReader::step(RankReader::step(remaining))))
        false -> remaining
    }
}
machine saved(remaining: i32) -> i32
requires remaining > 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader {
    let next: i32 = RankReader::step(remaining);
    transition next > 0 {
        true -> saved(identity(next))
        false -> next
    }
}
data Progress { remaining: i32; }
machine step_record(value: i32) -> Progress
requires value > 0 && value <= 9;
ensures result.remaining == value - 1;
{ Progress { remaining: value - 1 } }
machine projected(remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
{
    transition remaining > 0 {
        true -> projected(step_record(remaining).remaining)
        false -> remaining
    }
}
data Main { }
machine Main::main(main: &mut Main) reaches RankReader crashes Trap {
    let first: i32 = direct(9);
    let second: i32 = nested(8);
    let third: i32 = projected(7);
    let fourth: i32 = saved(6);
    transition first == 0 && second == 0 && third == 0 && fourth == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
