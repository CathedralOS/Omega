// The private loop drops its consumed slice before its final boundary call.
// An empty invokes ceiling preserves that acyclic suffix without promising I/O progress.
public boundary trait Output { machine emit_byte(byte: i32) reaches Output; }
public data Provider {}
public data DirectProvider {}
boundary machine DirectProvider::emit_byte(byte: i32) satisfies Output::emit_byte;
macos_arm64 boundary machine Provider::emit_byte(byte: i32) satisfies Output::emit_byte;
linux_x86_64 boundary machine Provider::emit_byte(byte: i32) satisfies Output::emit_byte;
machine console_write_bytes(bytes: &[u8], newline: bool)
terminates by bytes -> Slice::Length;
reaches Output
{
    transition bytes.len > 0 {
        true -> emit(bytes[0], bytes[1..], newline)
        false -> finish(newline)
    }

    machine emit(byte: u8, bytes: &[u8], newline: bool) {
        let mut output: u8 = byte;
        Provider::emit_byte(output as i32);
        transition bytes.len > 0 {
            true -> emit(bytes[0], bytes[1..], newline)
            false -> finish(newline)
        }
    }

    machine finish(newline: bool) {
        transition newline {
            true -> emit_newline(10)
            false -> done()
        }
    }

    machine emit_newline(byte: u8) {
        DirectProvider::emit_byte(10);
        let mut output: u8 = byte;
        Provider::emit_byte(output as i32);
    }

    machine done() { }
}
