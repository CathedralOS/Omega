public data Token [copy] { identity: u64; }
public domain Token::Fair satisfies ProgressProfile established by Grants::grant;
public boundary trait Grants { machine grant() -> Token in Fair reaches; }
data Holder [copy] { token: Token; }
linux_x86_64 machine selected_family<T>(left: &Holder, right: &Holder) -> u64
requires left.token in Token::Fair
terminates;
{ 7 }
linux_arm64 machine selected_family<T>(left: &Holder, right: &Holder) -> u64
requires left.token in Token::Fair
terminates;
{ 7 }
macos_arm64 machine selected_family<T>(left: &Holder, right: &Holder) -> u64
requires left.token in Token::Fair
terminates;
{ 7 }
windows_x86_64 machine selected_family<T>(left: &Holder, right: &Holder) -> u64
requires right.token in Token::Fair
terminates;
{ 7 }
machine checked_caller(left: &Holder, right: &Holder) -> u64
requires left.token in Token::Fair, right.token in Token::Fair
terminates;
{ selected_family<u64>(left, right) }
machine main() {}
