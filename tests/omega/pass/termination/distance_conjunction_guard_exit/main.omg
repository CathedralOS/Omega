// A bounded distance proved through a conjunction guard. Either conjunct of
// `index < limit && index < 4096` that names the bound keeps the cursor
// below it, for a scalar bound and for a collection length alike.
use omega_language_std::console;

data Main { bytes: [u8; 8]; }

machine count_to(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance;
{
    transition index < limit && index < 4096 {
        true -> count_to(index + 1, limit)
        _ -> (index)
    }
}

machine count_in(bytes: &[u8], index: u64) -> u64
terminates by (index, bytes.len) -> Nat::BoundedDistance;
{
    transition index < 4096 && index < bytes.len {
        true -> count_in(bytes, index + 1)
        _ -> (index)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let counted: u64 = count_to(2, 5);
    let walked: u64 = count_in(&main.bytes, 0);
    transition counted == 5 && walked == 8 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
