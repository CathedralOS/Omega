// `terminates;` belongs to the published requirement: the satisfier
// inherits it and authors only its private ranking witness —
// `satisfies Countdown::countdown` + `terminates by remaining`.
trait Countdown {
    machine countdown(remaining: u64) -> u64 terminates;
}
machine main() {
    let value: u64 = countdown(3);
}
machine countdown(remaining: u64) -> u64
satisfies Countdown::countdown
terminates by remaining
{
    transition remaining > 0 {
        true -> countdown(remaining - 1)
        false -> 0
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
