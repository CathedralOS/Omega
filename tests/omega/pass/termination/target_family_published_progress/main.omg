public data Handle [copy] { identity: u64; }
public domain Handle::Ready satisfies ProgressProfile established by Grant::issue;
public boundary trait Grant {
    machine issue(value: Handle) -> Handle in Ready reaches;
}

// Each member's published premise belongs to its own parameter telescope.
macos_arm64 machine finish(value: Handle)
requires value in Ready
terminates;
{ }
windows_x86_64 machine finish(other: Handle)
requires other in Ready
terminates;
{ }

machine forward(value: Handle)
requires value in Ready
terminates;
{
    finish(value);
}
