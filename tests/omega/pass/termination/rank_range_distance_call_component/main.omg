// A two-machine call component ranked by `Nat::BoundedDistance`: each member
// keeps its own exact (lower, upper) subjects, and every in-component call
// re-proves the authored rank range with pinned endpoints. The paired
// subjects arrive through the callee's own formal names, so a positional or
// spelling difference cannot substitute for the exact mapping.
data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.scan_a(0, 4) }
}

machine Main::scan_a(&mut self, index: u64 [0..=4], limit: u64 [0..=4])
requires index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    transition index < limit {
        true -> self.scan_b(index + 1, limit)
        false -> index
    }
}

machine Main::scan_b(&mut self, index: u64 [0..=4], limit: u64 [0..=4])
requires index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    transition index < limit {
        true -> self.scan_a(index + 1, limit)
        false -> index
    }
}
