trait RankReader {
    machine read(value: &u32) -> u32 terminates;
    machine keep(value: u32) -> u32 terminates;
}

ReadOnly satisfies RankReader {
    machine read(value: &u32) -> u32 { value }
    machine keep(value: u32) -> u32 { value }
}

data Scratch { observed: u32; values: [u32; 2]; }

machine first_index() -> u64
ensures result == 0
{ 0 }

machine condition(value: bool) -> bool { value }

machine countdown(selected: dyn RankReader, scratch: &mut Scratch, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(selected, scratch, remaining) }
    machine scan(selected: dyn RankReader, scratch: &mut Scratch, remaining: u32) -> u32
    requires remaining <= 9;
    {
        scratch.observed = RankReader::keep(selected, RankReader::read(selected, &remaining)) + 0;
        scratch.values[first_index()] = RankReader::read(selected, &remaining);
        _ = RankReader::keep(selected, RankReader::read(selected, &remaining));
        transition remaining > 0 && condition(true) {
            true -> scan(selected, scratch, remaining - 1)
            false -> scratch.observed
        }
    }
}

machine main() crashes Trap {
    let selected: dyn RankReader = ReadOnly as dyn RankReader;
    let scratch: Scratch = Scratch { observed: 99, values: [99, 99] };
    let result: u32 = countdown(selected, &mut scratch, 4);
    transition result == 0 && scratch.observed == 0 && scratch.values[0] == 0 && scratch.values[1] == 99 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
