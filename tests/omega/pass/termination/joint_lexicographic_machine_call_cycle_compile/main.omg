// COMPILE CANARY. Two machines share the same declared lexicographic view.
// The first edge forwards the tuple; the second preserves the first component
// and strictly decreases the second.
data Progress {
    outer: u64;
    inner: u64;
}

measure Progress::Steps lexicographic { outer, inner }

data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition {
        _ -> Main::scan_a(main, Progress { outer: 1, inner: 4 })
    }
}

machine Main::scan_a(main: &mut Main, progress: Progress)
terminates by progress -> Progress::Steps;
-> u64
{
    transition progress.inner > 0 {
        true -> Main::scan_b(main, progress)
        false -> 0
    }
}

machine Main::scan_b(main: &mut Main, progress: Progress)
terminates by progress -> Progress::Steps;
-> u64
{
    transition progress.inner > 0 {
        true -> Main::scan_a(main, Progress {
            outer: progress.outer,
            inner: progress.inner - 1,
        })
        false -> 0
    }
}
