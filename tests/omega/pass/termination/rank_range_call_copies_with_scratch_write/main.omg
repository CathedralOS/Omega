// PASS CANARY. `left` and `right` are bare-forward copies of the ranked
// `remaining`, and either may transport the rank to `step`; `scratch` carries
// the unique, unconstrained role `extra`, so storing into it before the call
// touches no premise carrier, no shared copy, and no conserved endpoint.
data Main {}

machine Main::main(&mut self) -> u32 {
    transition { _ -> self.count(5, 1) }
}

machine Main::count(&mut self, remaining: u32, extra: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition remaining > 0 {
        true -> pair(remaining, remaining, extra)
        false -> remaining
    }
    state pair(left: u32, right: u32, mut scratch: u32)
    requires left <= 9 && right <= 9
    {
        scratch = left;
        transition left > 0 {
            true -> self.step(right)
            false -> scratch
        }
    }
}

machine Main::step(&mut self, n: u32)
terminates by n in 0..=9;
-> u32
requires n <= 9
{
    transition n > 0 {
        true -> self.count(n - 1, 0)
        false -> n
    }
}
