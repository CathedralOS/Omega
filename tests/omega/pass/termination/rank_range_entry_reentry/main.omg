data Main {}

machine Main::main() -> u32 {
    transition { _ -> self.walk(5) }
}

machine Main::walk(remaining: u32)
terminates by remaining in 0..=5;
-> u32
requires remaining <= 5
{
    transition remaining > 0 {
        true -> step(remaining - 1)
        false -> remaining
    }
    state step(pending: u32)
    requires pending <= 5
    {
        transition pending > 0 {
            true -> walk(pending - 1)
            false -> pending
        }
    }
}
