// `terminates by entries` — the default slice-length order ranks the
// tail recursion `walk(main, entries[1..])`.
data Entry {
    value: i32;
}
data Main {
    entries: [Entry; 4];
}
machine Main::walk(main: &Main, entries: &[Entry]) -> u64
    terminates by entries {
    transition entries.len > 0 {
        true -> walk(main, entries[1..])
        false -> 0
    }
}
machine Main::main(main: &mut Main) {
    main.entries[0].value = 5;
    let view: &[Entry] = &main.entries[..];
    let seen: u64 = Main::walk(&main, view);
    transition seen == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
