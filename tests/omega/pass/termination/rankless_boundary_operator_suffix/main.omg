// Named boundary operators retain their declaration identity in both call forms.
public data Scalar {}
public boundary operator Scalar::observe(value: u32);
public boundary operator Value::value() -> u32;
machine count(remaining: u32) terminates by remaining; -> u32 {
    transition remaining > 0 {
        true -> count(remaining - 1)
        false -> finish()
    }
    machine finish() -> u32 {
        Scalar::observe(7);
        Value::value()
    }
}
