// Fresh zero-established locals preserve a separate countdown's premises.
data Scratch { value: u32; }
data Main {}

machine countdown(remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining;
{
    let mut scratch: [u32; 2];
    scratch[0] = 7;
    transition { _ -> step(remaining, scratch) }

    machine step(remaining: u32, scratch: [u32; 2]) -> u32
    requires remaining <= 9;
    {
        let mut record: Scratch;
        let scalar: u32;
        record.value = scratch[0];
        let result: u32 = record.value;
        transition remaining > 0 {
            true -> step(remaining - 1, scratch)
            false -> done(result, scalar)
        }
    }
    machine done(result: u32, scalar: u32) -> u32 {
        transition scalar == 0 {
            true -> result
            false -> 99
        }
    }
}

machine Main::main() crashes Trap {
    let result: u32 = countdown(5);
    transition result == 7 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
