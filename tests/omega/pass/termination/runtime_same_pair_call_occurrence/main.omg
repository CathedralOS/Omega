// Expected exit: 0
// Every recursive occurrence is a tail edge; only the complete cycle is strict.
machine first(remaining: u64) -> u64
requires remaining <= 4;
terminates by remaining in 0..=4;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        transition { _ -> second(remaining) }
    }
}
machine second(remaining: u64) -> u64
requires remaining <= 4;
terminates by remaining in 0..=4;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        transition { _ -> first(remaining - 1) }
    }
}
machine main() crashes Trap {
    let result: u64 = first(3);
    transition result == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
