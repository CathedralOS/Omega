// Case RE-ASSIGNMENT: overwriting one payload-carrying case with another
// must rewrite the tag AND the (overlaying) payload bytes. `Walk { pace: 9 }`
// then `Run { speed: 70 }` share the payload base offset, so a stale tag or
// stale payload selects the wrong arm or exits 9/71. The Walk arm sits FIRST
// so a tag that never changed (or compared too wide) would take it. Exits 70
// only when the second construction fully replaces the first.

use omega_language_std::console;

data Mode {
    case Stand;
    case Walk(pace: i32);
    case Run(speed: i32);
}

data Main {
    mode: Mode;
}

machine Main::main(main: &mut Main) reaches Console {
    main.mode = Mode::Walk { pace: 9 };
    main.mode = Mode::Run { speed: 70 };

    transition main.mode {
        Mode::Walk { pace } -> bad(main, pace)
        Mode::Run { speed } -> done(main, speed)
        _ -> bad(main, 72)
    }

    state done(main: &mut Main, speed: i32) {
        Console::exit_process(speed);
    }

    state bad(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
