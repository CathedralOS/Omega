// A mixed record (common fields beside its cases) copied out of a borrowed
// array: arms read a common field (`token.start`) and test a case's payload
// (`Token::Mark { kind: Kind::B }`). Common fields sit on the carrier in
// every case, so they read like a record's; a payload field is observed
// through its case step. Before, lowering refused both: the common read with
// "record read requires a record namespace" and the payload test with
// "static case observation requires record fields and fixed indices".
// The product parser reads `Token` exactly so.
//
// Element 2 is `Mark(B)` starting at 30, element 3 a `Word` ending at 25 and
// element 4 `Mark(A)` ending at 15; each takes its own arm and the three
// coordinates sum to 70.
use omega_language_std::console;

data Kind [copy] { case A; case B; }
data Token [copy] {
    start: u64 [0..=100];
    end: u64 [0..=100];
    case Word;
    case Mark(kind: Kind);
}
data Stream { tokens: [Token; 8]; }

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut stream: Stream;
    stream.tokens[2] = Token::Mark { kind: Kind::B };
    stream.tokens[2].start = 30;
    stream.tokens[3] = Token::Word;
    stream.tokens[3].end = 25;
    stream.tokens[4] = Token::Mark { kind: Kind::A };
    stream.tokens[4].end = 15;
    let first: u64 [0..=100] = classify(&stream, 2);
    let second: u64 [0..=100] = classify(&stream, 3);
    let third: u64 [0..=100] = classify(&stream, 4);
    transition first == 30 && second == 25 && third == 15 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}

// `Mark(B)` answers its start; any other token answers its end.
machine classify(stream: &Stream, index: u64 [0..=7]) -> u64 [0..=100] {
    let token: Token = stream.tokens[index];
    transition token {
        Token::Mark { kind: Kind::B } -> (token.start)
        _ -> (token.end)
    }
}
