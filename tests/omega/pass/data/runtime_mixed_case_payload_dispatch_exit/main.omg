// RUN CANARY (exit 70). A payload dispatch on a mixed-shape receiver field
// selects the case from the tag and binds the payload from its overlay after
// the common fields: `gold` must read back 50, not a common-field byte.
use omega_language_std::console;
use omega::language::core::binding;

data Event {
    consumed: bool;
    bonus: i32;
    case Nothing;
    case Treasure(gold: i32);
}

data Main {
    console: Binding<Console>;
    event: Event;
}

machine Main::main(main: &mut Main) reaches Console {
    main.event = Event::Treasure { gold: 50, consumed: true };
    transition main.event {
        Event::Treasure { gold } -> check_gold(main, gold)
        _ -> bad(main)
    }

    state check_gold(main: &mut Main, gold: i32) {
        transition gold == 50 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
