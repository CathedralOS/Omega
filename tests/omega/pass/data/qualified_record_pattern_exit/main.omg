// Expected exit: 0
// Field extraction observes a qualified subject; coverage metadata never stores
// or dequalifies that subject. Ordinary extracted fields still have their own
// types. Exercise parameter, local, nested field, call result and arm subjects.
data Point [copy] { horizontal: u64; vertical: u64; }
domain Point::Screen established by screen;
data Frame [copy] { point: Point in Screen; }
data Counter { calls: u32 in Wrapping; }
machine screen() -> Point in Screen { Point { horizontal: 30, vertical: 40 } }
machine computed(counter: &mut Counter) -> Point in Screen {
    counter.calls = counter.calls + 1;
    screen()
}
machine inspect_computed() -> bool {
    let mut counter: Counter = Counter { calls: 0 };
    transition computed(&mut counter) {
        Point { horizontal, vertical } if horizontal == 30 && vertical == 40 -> verify(counter)
        _ -> bad()
    }
    machine verify(counter: Counter) -> bool { counter.calls == 1 }
    machine bad() -> bool { false }
}
machine inspect(point: Point in Screen) -> bool {
    let { horizontal, vertical as height } = point;
    horizontal == 30 && height == 40
}
machine inspect_arm(point: Point in Screen) -> bool {
    transition point {
        Point { horizontal, vertical as height } if horizontal == 30 && height == 40 -> good()
        _ -> bad()
    }
    machine good() -> bool { true }
    machine bad() -> bool { false }
}
machine main() crashes Trap {
    let point: Point in Screen = screen();
    let { horizontal as _, vertical as _ } = point;
    let { horizontal as width, vertical as _ } = point;
    let frame: Frame = Frame { point: point };
    let { horizontal as nested_width, vertical as nested_height } = frame.point;
    let parameter: bool = inspect(point);
    let arm: bool = inspect_arm(frame.point);
    let result: bool = inspect(screen());
    let once: bool = inspect_computed();
    transition width == 30 && nested_width == 30 && nested_height == 40
        && parameter && arm && result && once {
        true -> done(point)
        _ -> bad()
    }
    machine done(point: Point in Screen) {
        let { horizontal as _, vertical as _ } = point;
    }
    machine bad() { crash Trap; }
}
