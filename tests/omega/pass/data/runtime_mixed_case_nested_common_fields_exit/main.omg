// Common members have the same recursive zero establishment as record fields.
// Selecting a nonzero payload must not overwrite the omitted nested record.
data Bonus [copy] { value: u64; }
data Evidence [copy] { case Only; }
data Event {
    proof [erased]: Evidence;
    consumed: bool;
    bonus: i32;
    details: Bonus;
    samples: [Bonus; 2];
    case Nothing;
    case Treasure(witness [erased]: Evidence, gold: u64);
}

machine tick(count: &mut u64) -> Bonus {
    count = ((count as u64 in Wrapping) + 1) as u64;
    Bonus { value: count }
}

machine observe(event: &Event) -> bool {
    event.consumed == false && event.bonus == 0 && event.details.value == 2
        && event.samples[0].value == 3 && event.samples[1].value == 4
}

machine read_common(events: &[Event; 2], position: u64) -> bool
requires position < 2 {
    events[position].bonus == 9
}

// Structural common operands participate in the same authored call schedule
// as payload operands; false selection must evaluate none of them.
machine selected(enabled: bool, count: &mut u64) -> bool {
    enabled && observe(Event::Treasure {
        gold: tick(count).value,
        details: tick(count),
        samples: [tick(count), tick(count)]
    })
}

machine main() crashes Trap {
    let event: Event = Event::Treasure { gold: 50, consumed: true };
    let mut count: u64 = 0;
    let skipped: bool = selected(false, &mut count);
    let completed: bool = selected(true, &mut count);
    let events: [Event; 2] = [
        Event::Treasure { gold: 5, bonus: 3 },
        Event::Treasure { gold: 7, bonus: 9 }
    ];
    let selected_common: bool = read_common(&events, 1);
    transition event.consumed && event.bonus == 0 && event.details.value == 0
        && event.samples[0].value == 0 && event.samples[1].value == 0
        && skipped == false && completed && count == 4 && selected_common {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
