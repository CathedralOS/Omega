// Frozen decision 11: a payload-LESS case name stays a legal `==` value even
// when a SIBLING case carries a payload -- tag identity is total equality for
// the payload-free case itself. Only the payload-BEARING bare name is the
// category error (fail/data/bare_payload_case_equality_suggests_in).
// Structural `==` needs declared conformance: `Command satisfies Equatable`
// supplies it, matching pass/traits/equatable_sum_payload_equality_exit.

trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

data Command {
    case None;
    case Move(dx: i32);
}

CommandEquatable: Command satisfies Equatable;

data Main {
    cmd: Command;
    hit: bool;
}

machine Main::main(&mut self) {
    self.hit = self.cmd == Command::None;
}
