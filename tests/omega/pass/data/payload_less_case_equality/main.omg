// A qualified payload-LESS case member stays a legal `==` value even when a
// SIBLING case carries a payload: tag identity is total equality for the
// payload-free case itself. A payload-bearing member without construction is
// the category error (fail/data/bare_payload_case_equality_suggests_in).
// Structural `==` needs a named implementation: `CommandEquality satisfies
// Equatable<Command> { }` supplies it.

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Command {
    case None;
    case Move(dx: i32);
}

CommandEquality satisfies Equatable<Command> { }

data Main {
    cmd: Command;
}

machine Main::main(main: &mut Main) {
    let mut hit: bool = main.cmd == Command::None;
}
