// RUN CANARY (exit 70). Zero storage selects the first declared case with a
// zero payload (dependent_values.md, default domains and zero
// initialization). Here that payload is itself a sum: the zero `Token` is
// `Integer { base: Base::Decimal, empty: false }` with `start` zero, in a
// state-local array and in a caller-owned field.
use omega_language_std::console;

data Base [copy] { case Decimal; case Hex; }
data Token [copy] {
    start: u64 in Trapping;
    case Integer(base: Base, empty: bool);
    case Word;
}
data Holder { tokens: [Token; 2] in Trapping; ready: bool; }
data Context { token: Token; }

machine main(context: &mut Context) reaches Console {
    transition context.token {
        Token::Integer { base: Base::Decimal, empty } -> caller_empty(context, empty)
        _ -> bad(context, 71)
    }

    state caller_empty(context: &mut Context, empty: bool) {
        transition empty {
            false -> local(context)
            _ -> bad(context, 72)
        }
    }
    state local(context: &mut Context) {
        let mut holder: Holder;
        holder.ready = true;
        let token: Token = holder.tokens[1];
        transition token {
            Token::Integer { base: Base::Decimal, empty: false } -> start(context, token.start, holder.ready)
            _ -> bad(context, 73)
        }
    }
    state start(context: &mut Context, start: u64 in Trapping, ready: bool) {
        transition start == 0 && ready {
            true -> good(context)
            _ -> bad(context, 74)
        }
    }
    state good(context: &mut Context) { Console::exit_process(70); }
    state bad(context: &mut Context, code: i32) { Console::exit_process(code); }
}
