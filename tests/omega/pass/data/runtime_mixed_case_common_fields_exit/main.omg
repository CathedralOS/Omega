// RUN CANARY (exit 70). A mixed-shape case literal establishes its common
// fields beside the selected payload: a named common field keeps its value and
// an unnamed one reads zero, whatever case is active.
use omega_language_std::console;

data Event {
    consumed: bool;
    bonus: i32;
    case Nothing;
    case Treasure(gold: i32);
}

data Main {
    event: Event;
}

machine Main::main(main: &mut Main) reaches Console {
    main.event = Event::Treasure { gold: 50, consumed: true };
    transition main.event.consumed {
        true -> check_bonus(main)
        _ -> bad(main)
    }

    machine check_bonus(main: &mut Main) {
        transition main.event.bonus == 0 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
