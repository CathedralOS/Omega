// A plain-data arm may match a field value while binding its other fields.
// The field comparison is a real equality guard, so the ordinary flow/proof
// machinery knows `main.header.ok == 0` inside the first arm.

use omega_language_std::console;
use omega::language::core::binding;

data Header [copy] {
    ok: i32;
    version: i32;
}

data Main {
    console: Binding<Console>;
    header: Header;
}

machine require_ok(header: Header)
requires header.ok == 0
{
}

machine Main::main(main: &mut Main) reaches Console {
    main.header.ok = 0;
    main.header.version = 70;
    transition main.header {
        Header { ok: 0, version } -> matched(main, version)
        _ -> finish(main, 1)
    }

    state matched(main: &mut Main, code: i32) {
        // The pattern's equality guard follows the transition argument into
        // this state and discharges the callee's ordinary precondition.
        require_ok(main.header);
        main.console.exit_process(code);
    }

    state finish(main: &mut Main, code: i32) {
        main.console.exit_process(code);
    }
}
