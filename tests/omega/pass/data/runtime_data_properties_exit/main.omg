// Declared type property: `data Point [copy]` parses, verifies because every
// field is structurally copyable, and has NO runtime cost -- the program
// behaves identically to the property-free declaration. Nested propagation:
// `Holder` declares `[copy]` and stores a `Point`, which qualifies
// only because `Point` declares the properties itself.

use omega_language_std::console;
use omega::language::core::service;

data Point [copy] {
    x: i32;
    y: i32;
}

data Holder [copy] {
    p: Point;
    tag: i32;
}

data Main {
    console: Binding<Console>;
    h: Holder;
}

machine Main::main(&mut self) reaches Console {
    self.h.p.x = 60;
    self.h.p.y = 9;
    self.h.tag = 1;

    transition self.h.p.x + self.h.p.y + self.h.tag == 70 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
