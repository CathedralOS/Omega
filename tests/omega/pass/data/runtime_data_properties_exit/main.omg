// Declared type property: `data Point [copy]` parses, verifies because every
// field is structurally copyable, and has NO runtime cost -- the program
// behaves identically to the property-free declaration. Nested propagation:
// `Holder` declares `[copy]` and stores a `Point`, which qualifies
// only because `Point` declares the properties itself.

use omega_language_std::console;

data Point [copy] {
    x: i32;
    y: i32;
}

data Holder [copy] {
    p: Point;
    tag: i32;
}

data Main {
    h: Holder;
}

machine Main::main(main: &mut Main) reaches Console {
    main.h.p.x = 60;
    main.h.p.y = 9;
    main.h.tag = 1;

    transition main.h.p.x + main.h.p.y + main.h.tag == 70 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
