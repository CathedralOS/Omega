use token;

// Ordinary Product data may nest selected opaque fields; the carrier arrives
// through the Build selection, never through source construction.
public data TokenPair {
    quotient: Token;
    remainder: Token;
}

machine forward(pair: TokenPair) -> TokenPair {
    pair
}

machine quotient(pair: TokenPair) -> Token {
    pair.quotient
}

machine main() {}
