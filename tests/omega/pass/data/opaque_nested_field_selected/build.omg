// Both scopes see this declaration. Describing its Product representation does
// not use Token as a host type or grant Build a Copy receipt.
use token;

machine build(builder: &mut Build) {
    Build::application(builder, "opaque_nested_field_selected");
    Build::select_representation<Token, TokenRepresentation>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
