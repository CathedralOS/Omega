// Both scopes see this declaration. Describing its Product representation does
// not use Token as a host type or grant Build a Copy receipt.
use token;

machine build(builder: &mut Build) {
    Build::application(builder, "opaque_copy_selected");
    Ordinary::select_representation<u32>(7);
    Build::select_representation<Token, TokenRepresentation>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}

data Ordinary {}
machine Ordinary::select_representation<Element>(value: Element) {}
