// Literal-only predicate proofs still validate each nested constructor, exact
// selected field, omitted zero and case clause. The array is deliberately not
// needed by any predicate: unsupported denotations must not hide other fields.
data Cell [copy] where value <= 7 { value: u64; }
data Packet [copy] where count <= 2 {
    count: u64;
    cells: [Cell; 2];
    case Ready(marker: u64) where marker == 9;
}

machine main() {
    let packet: Packet = Packet::Ready {
        cells: [Cell { value: 7 }, Cell {}],
        marker: 9,
        count: 2
    };
}
