// Record patterns in LET position (owner spec 2026-07-18): exhaustive by
// law, `as` renames, `as _` waives. Desugars at parse time to the
// __destructure#* marker (exhaustiveness carrier) + per-bound-field
// Unit-sentinel lets whose types flow through hoist inference. Ranged
// fields keep the decision-17 exact-arithmetic obligation dischargeable.
// The runtime self-check accepts only 30 + 40 = 70.
use omega_language_std::console;
use omega::language::core::binding;
domain i32::Coord requires 0 <= self && self <= 100;
data Point {
    x: i32 in Coord;
    y: i32 in Coord;
    z: i32 in Coord;
}
data Main { console: Binding<Console>; point: Point; }
machine Main::main(&mut self) reaches Console {
    self.point = Point { x: 30, y: 40, z: 5 };
    let { x, y as vertical, z as _ } = self.point;
    let total: i32 = x + vertical;
    transition total == 70 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(1); }
}
