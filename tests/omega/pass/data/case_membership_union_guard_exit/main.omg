// Decision 11: a UNION of implicit case domains as a transition guard
// subject. `main.cmd in Command::Quit | Command::Move` is true when the tag
// is either case; the payload-bearing `Move` arm of the union must still be
// a tag-only test (the constructed `dx: 2` payload must not leak into the
// compare). The held value matches the SECOND union arm, so a lowering that
// drops or reorders union arms exits 71.

use omega_language_std::console;
use omega::language::core::binding;

data Command {
    case None;
    case Quit;
    case Move(dx: i32);
}

data Main {
    console: Binding<Console>;
    cmd: Command;
}

machine Main::main(main: &mut Main) reaches Console {
    main.cmd = Command::Move { dx: 2 };

    transition (main.cmd in Command::Quit | Command::Move) {
        (true) -> matched(main)
        _ -> missed(main)
    }

    state matched(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}
