// RUN CANARY (exit 70). A type whose first case carries a float is
// zero-constructible: all-zero bytes are +0.0, so the zero `Sample` is
// `Reading { value: +0.0 }`. That lets a constructor omit a `Sample` field,
// which takes its zero value, and the dispatch must select the first case.
// (Reading the float back is not exercised: binding a float payload into a
// successor's guard is refused even for an explicitly constructed value.)
use omega_language_std::console;
use omega::language::core::binding;

data Sample [copy] {
    case Reading(value: f64);
    case Missing;
}
data Holder [copy] { sample: Sample; ready: bool; }
data Context { console: Binding<Console>; }

machine main(context: &mut Context) reaches Console {
    transition { _ -> sample(context) }

    state sample(context: &mut Context) {
        let holder: Holder = Holder { ready: true };
        transition holder.sample {
            Sample::Reading { value } -> ready(context, holder.ready)
            _ -> bad(context, 71)
        }
    }
    state ready(context: &mut Context, ready: bool) {
        transition ready {
            true -> good(context)
            _ -> bad(context, 72)
        }
    }
    state good(context: &mut Context) { context.console.exit_process(70); }
    state bad(context: &mut Context, code: i32) { context.console.exit_process(code); }
}
