// `poke` writes `b.cells[0]` through the reference local `v`. The stored 3
// keeps `B`'s collection predicate, so the return re-proves it from the
// element store exactly as a direct `b.cells[0] = 3` would. The program exits
// 43 only if the store reached `b.cells[0]`, and 44 otherwise.

use omega_language_std::Console;

machine first_small(cells: &[u64; 4]) -> bool { cells[0] <= 4 }

data B requires first_small(&cells) == true {
    cells: [u64; 4];
}

machine poke(b: &mut B) {
    let v: &mut [u64; 4] = &mut b.cells;
    v[0] = 3;
}

machine entry_start() reaches Console {
    let mut b: B;
    poke(&mut b);

    transition (b.cells[0] == 3) {
        (true) -> stored()
        _ -> missed()
    }

    machine stored() {
        Console::exit_process(43);
    }

    machine missed() {
        Console::exit_process(44);
    }
}
