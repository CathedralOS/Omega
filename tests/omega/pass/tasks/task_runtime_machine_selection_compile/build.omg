machine build(builder: &mut Build) {
    Build::application(builder, "task_runtime_machine_selection_compile");
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, linux_arm64);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, linux_x86_64);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, macos_arm64);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, macos_x86_64);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, windows_x86_64);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, uefi_x86_64);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, cross_platform_cli);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, local_unchecked);
    Build::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
}
