use omega::language::core::task;
use omega::language::core::binding;

// MP6/TR3: task activation consumes the ordinary compile-time machine-symbol
// parameter surface. `Worker::run` is selected statically and survives as the
// concrete activation target; no runtime callable or inferred capture exists.
data CanaryTaskRuntime { }

machine CanaryTaskRuntime::start<T, Arguments, machine Target>(
    arguments: Arguments
) -> Task<T>
where machine Target(arguments: Arguments) -> T suspends; blocks;
satisfies TaskRuntime::start
via ForeignBinding::CompilerIntrinsic;

machine CanaryTaskRuntime::try_start<T, Arguments, machine Target>(
    arguments: Arguments
) -> StartOutcome<T, Arguments>
where machine Target(arguments: Arguments) -> T suspends; blocks;
satisfies TaskRuntime::try_start
via ForeignBinding::CompilerIntrinsic;

CanaryTaskRuntimeProvider satisfies TaskRuntime {
    TaskRuntime::start = CanaryTaskRuntime::start;
    TaskRuntime::try_start = CanaryTaskRuntime::try_start;
}

data TargetProviders {}
linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(defaults);
}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(defaults);
}
windows_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<TaskRuntime, CanaryTaskRuntimeProvider>(defaults);
}

pub boundary data Sleeper;
boundary machine Sleeper::park(token: i32) suspends;

pub data Token {
    id: u64;
}

pub boundary trait TokenIssuer {
    machine issue(id: u64) -> Token
    ensures
        result in Carry::AcrossSuspend;
}

data Worker { }
machine Worker::run(token: Token in Carry::AcrossSuspend) -> Token suspends; {
    let carried: Token = token;
    suspend Sleeper::park(7);
    carried
}

// Runtime-instance dispatch is deliberately outside this selected-provider
// plan canary. This consumer closes each linear bootstrap claim locally after
// elaboration.
machine Task::settle<T>(task: Task<T>) -> TaskOutcome<T> {
    suspend block Task::finish(task)
}

data Main {
    runtime: &Binding<TaskRuntime>;
}

machine Main::probe(main: &mut Main) reaches TokenIssuer + TaskRuntime {
    let token: Token = TokenIssuer::issue(7);
    let first: Task<Token> = main.runtime.start<Token, Token in Carry::AcrossSuspend, Worker::run>(token);

    let retry: Token = TokenIssuer::issue(9);
    let outcome: StartOutcome<Token, Token in Carry::AcrossSuspend> =
        main.runtime.try_start<Token, Token in Carry::AcrossSuspend, Worker::run>(retry);

    _ = suspend block Task::settle(first);
    // `try_start` may decline. Only the selected `Started` case carries a
    // task claim; a rejection returns the unconsumed arguments instead.
    transition outcome {
        StartOutcome::Started { task } -> settle_retry(task)
        StartOutcome::Rejected { arguments, reason } -> rejected(arguments, reason)
    }

    state settle_retry(retry_task: Task<Token>) {
        _ = suspend block Task::settle(retry_task);
    }

    state rejected(arguments: Token, reason: StartRejection) { }
}

machine Main::main() { }
