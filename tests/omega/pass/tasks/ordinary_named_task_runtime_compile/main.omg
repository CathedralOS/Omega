// An authored protocol with the same names is ordinary routed service code.
// Its generic target is not a Core task activation or runtime-custody claim.
pub data Task<Value> { value: Value; }
pub boundary trait TaskRuntime {
    machine start<machine Target>() -> Task<i32>
    where machine Target() -> i32;
    ensures true;
}
machine value() -> i32 { 7 }
machine probe() -> Task<i32> reaches TaskRuntime {
    TaskRuntime::start<value>()
}
machine main() {}
