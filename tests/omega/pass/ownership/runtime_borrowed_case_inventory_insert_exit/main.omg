// Expected exit: 0. Captured slot loans retain inserted linear payloads;
// a second insertion refuses without replacing the first token.
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Token [linear] { value: u64; }
data Slot { case Empty; case Held(token: Token); }
data Inventory { slots: [Slot; 4]; }

machine insert(slot: &mut Slot, value: u64) -> bool {
    transition slot {
        Slot::Empty -> store(slot, value)
        Slot::Held { token } -> false
    }
    machine store(slot: &mut Slot, value: u64) -> bool
    requires slot in Slot::Empty
    {
        slot = Slot::Held { token: Token { value: value } };
        true
    }
}

machine insert_at(inventory: &mut Inventory, position: u64, value: u64) -> bool
requires position < 4
{
    insert(&mut inventory.slots[position], value)
}

machine read(inventory: &Inventory, position: u64) -> u64
requires position < 4
{
    transition &inventory.slots[position] {
        Slot::Empty -> 0
        Slot::Held { token } -> token.value
    }
}

machine choose() -> u64 { 1 }

machine main() reaches ProcessExit {
    let position: u64 = choose();
    transition position < 4 {
        true -> exercise(position)
        _ -> wrong()
    }
    machine exercise(position: u64)
    requires position < 4
    {
        let mut inventory: Inventory;
        let first: bool = insert_at(&mut inventory, position, 73);
        let second: bool = insert_at(&mut inventory, position, 97);
        let held: u64 = read(&inventory, position);
        let empty: u64 = read(&inventory, 0);
        transition first && !second && held == 73 && empty == 0 {
            true -> finish(inventory, 0)
            _ -> finish(inventory, 1)
        }
    }
    machine wrong() { ProcessExit::exit_process(2); }
    machine finish(inventory: Inventory, status: i32) { ProcessExit::exit_process(status); }
}
