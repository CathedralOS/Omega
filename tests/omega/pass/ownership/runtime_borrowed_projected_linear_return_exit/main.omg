use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Carrier { marker: u64; token: Token; }
data Holder { guard: u64; token: Token; }

machine extract(carrier: Carrier) -> Token { carrier.token }

machine restore(holder: &mut Holder) -> u64 {
    let detached: Token = holder.token;
    holder.token = extract(Carrier { marker: 7, token: detached });
    holder.token.value
}

machine main() crashes Trap {
    let mut holder: Holder = Holder { guard: 19, token: Token { value: 42 } };
    let value: u64 = restore(&mut holder);
    let guard: u64 = holder.guard;
    let remaining: Token = holder.token;
    drop(remaining);
    transition value == 42 && guard == 19 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
