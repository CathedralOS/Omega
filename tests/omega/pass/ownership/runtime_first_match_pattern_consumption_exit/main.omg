data Held { value: &i32; }
machine consume(held: Held) -> i32 { held.value }
machine consume_matches(held: Held) -> bool { consume(held) == 17 }
machine short_circuit(value: &i32, choice: bool) -> bool {
    let held: Held = Held { value: value };
    choice && consume_matches(held)
}
machine selected(value: &i32, choice: i32) -> i32 {
    let held: Held = Held { value: value };
    match choice {
        0 -> consume(held),
        consume(held) -> 17,
        _ -> 23,
    }
}
machine main() crashes Trap {
    let value: i32 = 17;
    transition selected(&value, 0) == 17 && selected(&value, 17) == 17 && selected(&value, 23) == 23 && short_circuit(&value, true) && !short_circuit(&value, false) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
