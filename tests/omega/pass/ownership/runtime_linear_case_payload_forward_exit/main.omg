use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Choice {
    case Success(token: Token);
    case Failure(token: Token);
}
data Envelope { marker: u64; choice: Choice; }

machine forward(choice: Choice) -> Choice { choice }

// Moving a nested sum carries every claim below the selected argument path,
// while the caller retains the containing owner's residual affine debt.
machine forward_projected(envelope: Envelope) -> Choice {
    forward(envelope.choice)
}

machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Success { token } -> read_and_drop(token)
        Choice::Failure { token } -> read_and_drop(token)
    }
}

machine read_and_drop(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}

machine main() crashes Trap {
    let success: Choice = Choice::Success { token: Token { value: 41 } };
    let success_returned: Choice = forward(success);
    let first: u64 = consume(success_returned);
    let failure: Choice = Choice::Failure { token: Token { value: 17 } };
    let failure_returned: Choice = forward(failure);
    let second: u64 = consume(failure_returned);
    let envelope: Envelope = Envelope {
        marker: 7,
        choice: Choice::Success { token: Token { value: 29 } }
    };
    let projected: Choice = forward_projected(envelope);
    let third: u64 = consume(projected);
    transition first == 41 && second == 17 && third == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
