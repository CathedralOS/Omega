// A `&mut` loan may name a destructure-produced local: `let { x, y } =
// point` splits the record, then `bump(&mut x)` lends just the first
// member's claim — destructured locals loan like any named place.
data Point {
    x: u64;
    y: u64;
}

data Main { answer: u64; }

machine Main::bump(cell: &mut u64) {
    cell = 9;
}

machine Main::main(main: &mut Main) {
    let point: Point = Point { x: 1, y: 2 };
    let { x, y } = point;
    Main::bump(&mut x);
    transition x {
        9 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
