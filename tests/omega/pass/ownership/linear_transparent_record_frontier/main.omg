// A transparent affine record contributes no nominal claim of its own. Its
// two contained linear fields remain independent path-indexed obligations.
use omega_language_std::console;
use omega::language::core::binding;

data Receipt [linear] {
    code: i32;
}

// Hook-less linear obligation: the declared consuming contract is the
// authorized terminal disposition.
boundary requirement Receipt::ack(receipt: Receipt);

data Pair {
    left: Receipt;
    right: Receipt;
}

data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    let pair: Pair = Pair { left: left, right: right };
    let forwarded: Pair = pair;
    let extracted_left: Receipt = forwarded.left;
    let extracted_right: Receipt = forwarded.right;
    Receipt::ack(extracted_left);
    Receipt::ack(extracted_right);
    main.console.exit_process(0);
}
