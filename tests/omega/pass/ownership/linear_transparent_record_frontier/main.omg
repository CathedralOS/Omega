// A transparent affine record contributes no nominal claim of its own. Its
// two contained linear fields remain independent path-indexed obligations:
// construction carries each member's claim to its field, the whole-record
// move keeps both, and each extracted member is consumed separately.
//
// The requirement's provider is the external sink
// `pass/ownership/linear_transfer_and_consume` declares (each bound target's
// C library `abs`). `fail/ownership/linear_transparent_record_member_scope_loss`
// is the same frontier with one member left unconsumed.
use omega_language_std::console;
use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

// Hook-less linear obligation: the declared consuming contract is the
// authorized terminal disposition.
boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}

windows_x86_64 machine windows_x86_64_receipt_sink_binding() -> ForeignBinding<10, 3, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    }
}

linux_x86_64 machine linux_x86_64_receipt_sink_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    }
}

linux_arm64 machine linux_arm64_receipt_sink_binding() -> ForeignBinding<9, 3, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    }
}

macos_arm64 machine macos_arm64_receipt_sink_binding() -> ForeignBinding<17, 4, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_abs",
        },
    }
}

windows_x86_64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via windows_x86_64_receipt_sink_binding();
linux_x86_64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via linux_x86_64_receipt_sink_binding();
linux_arm64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via linux_arm64_receipt_sink_binding();
macos_arm64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via macos_arm64_receipt_sink_binding();

data Pair {
    left: Receipt;
    right: Receipt;
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    let pair: Pair = Pair { left: left, right: right };
    let forwarded: Pair = pair;
    let extracted_left: Receipt = forwarded.left;
    let extracted_right: Receipt = forwarded.right;
    Receipt::ack(extracted_left);
    Receipt::ack(extracted_right);
    Console::exit_process(0);
}
