// A transparent affine record contributes no nominal claim of its own. Its
// two contained linear fields remain independent path-indexed obligations:
// construction carries each member's claim to its field, the whole-record
// move keeps both, and each extracted member is consumed separately.
//
// The requirement's provider is the external sink
// `pass/ownership/linear_transfer_and_consume` declares (each bound target's
// C library `abs`). `fail/ownership/linear_transparent_record_member_scope_loss`
// is the same frontier with one member left unconsumed.
use omega_language_std::console;
use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

// Hook-less linear obligation: the declared consuming contract is the
// authorized terminal disposition.
boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}


data Pair {
    left: Receipt;
    right: Receipt;
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    let pair: Pair = Pair { left: left, right: right };
    let forwarded: Pair = pair;
    let extracted_left: Receipt = forwarded.left;
    let extracted_right: Receipt = forwarded.right;
    Receipt::ack(extracted_left);
    Receipt::ack(extracted_right);
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
