// A shared-view parameter serves as a transition subject inside the
// callee: `scan(cell: &u64)` dispatches on `cell` directly — the view
// reads through to the caller's value at decision time.
data Main {
    cell: u64;
    answer: u64;
}

machine Main::scan(cell: &u64) -> u64 {
    transition cell {
        6 -> hit()
        _ -> miss()
    }
    machine hit() -> u64 { 70 }
    machine miss() -> u64 { 71 }
}

machine Main::main(main: &mut Main) {
    main.cell = 6;
    main.answer = Main::scan(&main.cell);
}
