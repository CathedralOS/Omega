use omega::language::core::drop;

data Token {
    id: u64;
}

data Submission [linear] {
    arguments: Token;
}

data Ticket [linear] {
    executor: u64;
    slot: u64;
}

data SubmissionRejection {
    code: i32;
}

// A sum whose arms carry different linear claims: `Accepted` vends the
// completion ticket, `Rejected` returns the whole moved submission — the
// rejection path gives custody back to the caller.
data SubmitOutcome {
    case Accepted(ticket: Ticket);
    case Rejected(submission: Submission, reason: SubmissionRejection);
}

// Type-attached bodyless requirements on linear data: each declared edge is
// the authorized terminal disposition for a hook-less linear type, called
// like an ordinary machine.
boundary requirement Submission::release(submission: Submission);
boundary requirement Ticket::release(ticket: Ticket);
boundary requirement SubmitOutcome::release(outcome: SubmitOutcome);

machine submit(submission: Submission, claim: Ticket, open: bool) -> SubmitOutcome {
    transition open {
        true -> admit(submission, claim)
        _ -> refuse(submission, claim)
    }

    state admit(submission: Submission, claim: Ticket) {
        Submission::release(submission);
        SubmitOutcome::Accepted { ticket: claim }
    }

    state refuse(submission: Submission, claim: Ticket) {
        Ticket::release(claim);
        SubmitOutcome::Rejected {
            submission: submission,
            reason: SubmissionRejection { code: -1 },
        }
    }
}

machine main() -> i32 {
    let submission: Submission = Submission { arguments: Token { id: 7 } };
    let outcome: SubmitOutcome = SubmitOutcome::Rejected {
        submission: submission,
        reason: SubmissionRejection { code: -1 },
    };
    // Member projection moves the payload claim back out of the sum.
    let returned: Submission = outcome.submission;
    Submission::release(returned);

    let claim: Ticket = Ticket { executor: 1, slot: 0 };
    let admitted: SubmitOutcome = submit(
        Submission { arguments: Token { id: 8 } },
        claim,
        true
    );
    SubmitOutcome::release(admitted);
    0
}
