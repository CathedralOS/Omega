// Entry establishment supplies the context occurrence, not a machine namespace.
// Projected and directly borrowed bindings share the same receiver admission.
use omega::language::core::binding;
use omega::language::core::drop;

pub data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

pub boundary trait Settlement {
    machine settle(prefix: i32, receipt: Receipt, suffix: i32) -> i32;
}

Settler satisfies Settlement {
    machine settle(prefix: i32, receipt: Receipt, suffix: i32) -> i32 {
        let code: i32 = receipt.code;
        drop(receipt);
        (((prefix as i32 in Wrapping) + (code as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
    }
}

data Services { settlement: Binding<Settlement>; }
data Context { services: Services; }

machine forward(prefix: i32, receipt: Receipt, context: &mut Context, suffix: i32) -> i32 reaches Settlement {
    ((context.services.settlement.settle(prefix, receipt, suffix) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

machine direct(binding: &mut Binding<Settlement>, receipt: Receipt) -> i32 reaches Settlement {
    ((binding.settle(2, receipt, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

machine verify(correct: bool) crashes Trap {
    transition correct {
        true -> good()
        _ -> bad()
    }
    state good() {}
    state bad() { crash Trap; }
}

machine main(context: &mut Context) reaches Settlement crashes Trap {
    let receipt: Receipt = Receipt { code: 7 };
    let result: i32 = ((context.services.settlement.settle(2, receipt, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let forwarded: i32 = forward(2, Receipt { code: 8 }, context, 3);
    let borrowed: i32 = direct(&mut context.services.settlement, Receipt { code: 9 });
    // Statement and computed applications transfer each caller receipt once.
    let statement: i32 = context.services.settlement.settle(2, Receipt { code: 10 }, 3);
    verify(result == 13 && forwarded == 14 && borrowed == 15 && statement == 15);
}
