// A shared view of one array element forwards like a member view:
// `&main.cells[1]` lends the second slot to `scan`, which dispatches on
// its `&u64` parameter — element places borrow piecewise.
data Main {
    cells: [u64; 3];
    answer: u64;
}

machine Main::scan(cell: &u64) -> u64 {
    transition cell {
        6 -> hit()
        _ -> miss()
    }
    machine hit() -> u64 { 70 }
    machine miss() -> u64 { 71 }
}

machine Main::main(main: &mut Main) {
    main.cells = [1, 6, 2];
    main.answer = Main::scan(&main.cells[1]);
}
