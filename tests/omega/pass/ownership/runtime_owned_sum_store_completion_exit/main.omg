// Expected exit: 0.
// Internal store operands complete before their destination consumes them.
data Tag [copy] { case Empty; case First; case Second; }
data Pair { tag: Tag; sentinel: u64; }

machine replace_owned(value: Tag) -> bool {
    let mut pair: Pair = Pair { tag: Tag::Empty, sentinel: 17 };
    pair.tag = value;
    pair.tag == Tag::Second && pair.sentinel == 17
}

machine replace_borrowed(pair: &mut Pair, value: Tag) {
    pair.tag = value;
}

machine main() crashes Trap {
    let mut pair: Pair = Pair { tag: Tag::Empty, sentinel: 29 };
    pair.tag = Tag::First;
    let literal: bool = pair.tag == Tag::First && pair.sentinel == 29;
    let copied: bool = replace_owned(Tag::Second);
    replace_borrowed(&mut pair, Tag::Second);
    transition literal && copied && pair.tag == Tag::Second && pair.sentinel == 29 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
