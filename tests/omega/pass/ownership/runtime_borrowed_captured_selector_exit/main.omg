data Token { value: u64; }
data Cursor { index: u64; calls: u64 in Wrapping; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine select(cursor: &mut Cursor) -> u64 ensures result == 0 {
    cursor.calls += 1;
    cursor.index = 1;
    0
}

machine replacement(cursor: &mut Cursor) -> Token {
    cursor.index = 3;
    Token { value: 19 }
}

machine replace(tokens: &mut [Token; 2], cursor: &mut Cursor) {
    tokens[select(cursor)] = replacement(cursor);
}

machine main() crashes Trap {
    let mut tokens: [Token; 2] = [Token { value: 11 }, Token { value: 7 }];
    let mut cursor: Cursor = Cursor { index: 0, calls: 0 };
    replace(&mut tokens, &mut cursor);
    transition cursor.calls == 1 && cursor.index == 3
        && tokens[0].value == 19 && tokens[1].value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
