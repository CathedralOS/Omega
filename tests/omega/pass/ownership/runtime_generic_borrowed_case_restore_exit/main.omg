use omega::language::core::drop;

data Envelope<T> { value: u64; reference: T; }
data Holder<T> { guard: u64; envelope: Envelope<T>; }
data Attempt<T> {
    case Success(envelope: Envelope<T>);
    case Failure(envelope: Envelope<T>);
}

machine try_transform<'storage>(envelope: Envelope<&'storage i32>, succeed: bool) -> Attempt<&'storage i32> {
    transition succeed {
        true -> success(envelope)
        false -> Attempt::Failure { envelope: envelope }
    }
    machine success(envelope: Envelope<&'storage i32>) -> Attempt<&'storage i32> {
        let value: u64 = envelope.value;
        let reference: &'storage i32 = envelope.reference;
        drop(envelope);
        Attempt::Success { envelope: Envelope {
            value: ((value as u64 in Wrapping) + 1) as u64,
            reference: reference
        } }
    }
}

machine restore<'storage>(attempt: Attempt<&'storage i32>) -> Envelope<&'storage i32> {
    transition attempt {
        Attempt::Success { envelope } -> (envelope)
        Attempt::Failure { envelope } -> (envelope)
    }
}

machine apply<'storage>(holder: &mut Holder<&'storage i32>, succeed: bool) -> u64 {
    let detached: Envelope<&'storage i32> = holder.envelope;
    let attempt: Attempt<&'storage i32> = try_transform(detached, succeed);
    holder.envelope = restore(attempt);
    holder.envelope.value
}

machine main() crashes Trap {
    let backing: i32 = 73;
    let mut holder: Holder<&i32> = Holder {
        guard: 19,
        envelope: Envelope { value: 41, reference: &backing }
    };
    let failed: u64 = apply(&mut holder, false);
    let after_failure: i32 = holder.envelope.reference;
    let succeeded: u64 = apply(&mut holder, true);
    let after_success: i32 = holder.envelope.reference;
    let guard: u64 = holder.guard;
    drop(holder);
    transition failed == 41 && succeeded == 42 && guard == 19
        && after_failure == 73 && after_success == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
