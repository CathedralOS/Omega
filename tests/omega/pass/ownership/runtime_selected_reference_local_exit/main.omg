machine read(value: &i32) -> i32 { value }

machine choose(first: &i32, second: &i32, take_first: bool) -> i32 {
    let selected: &i32 = match take_first {
        true -> first,
        _ -> second,
    };
    read(selected)
}

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let mut first: i32 = 40;
    let mut second: i32 = 42;
    let from_first: i32 = choose(&first, &second, true);
    let from_second: i32 = choose(&first, &second, false);
    let selected: &i32 = match from_first == 40 {
        true -> &first,
        _ -> &second,
    };
    let selected_observation: i32 = read(selected);
    first = 41;
    second = 43;
    transition from_first == 40 && from_second == 42 && selected_observation == 40 && first == 41 && second == 43 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
