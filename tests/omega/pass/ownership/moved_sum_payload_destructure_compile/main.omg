// A moved sum still destructures at the arm: `move m` hands `Msg`
// across the transition boundary and `Move { dx }` binds its payload
// on the far side — moving transfers the whole case, contents intact.
data Msg {
    case Move(dx: u64);
    case Stay;
}

data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let m: Msg = Msg::Move { dx: 70 };
    transition move m {
        Msg::Move { dx } -> use(main, dx)
        _ -> bad(main)
    }

    machine use(main: &mut Main, amount: u64) { main.answer = amount; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
