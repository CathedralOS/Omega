// Free machines return records whose linear members carry claims. A bare
// machine call names the machine rather than its entry state, and the claim
// outcome a caller binds must not depend on that spelling. `pack` places its
// inputs in different fields on its two arms; `issue` is called once per arm,
// and every extracted member is consumed by the external sink
// `pass/ownership/linear_transfer_and_consume` declares.
use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}


data Pair {
    left: Receipt;
    right: Receipt;
}

machine pack(swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition swap {
        false -> (Pair { left: left, right: right })
        true -> (Pair { left: right, right: left })
    }
}

machine issue(swap: bool, first: i32, second: i32) -> Pair {
    let left: Receipt = Receipt { code: first };
    let right: Receipt = Receipt { code: second };
    transition { _ -> pack(swap, left, right) }
}

machine main() {
    let kept: Pair = issue(false, 1, 2);
    let swapped: Pair = issue(true, 3, 4);
    let kept_left: Receipt = kept.left;
    let kept_right: Receipt = kept.right;
    let swapped_left: Receipt = swapped.left;
    let swapped_right: Receipt = swapped.right;
    Receipt::ack(kept_left);
    Receipt::ack(kept_right);
    Receipt::ack(swapped_left);
    Receipt::ack(swapped_right);
}
