data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }

machine restore(tokens: &mut [Token])
requires tokens.len >= 2
{
    let mut at: u64 = 0;
    let captured: u64 = at + 0;
    at = 1;
    let first: Token = tokens[captured + 1];
    tokens[captured + 1] = first;
    let fixed: Token = tokens[0 + 1];
    tokens[0u64 + 1] = Token { byte: 31 };
}

machine main() crashes Trap {
    let mut tokens: [Token; 2] = [Token { byte: 11 }, Token { byte: 23 }];
    let view: &mut [Token] = &mut tokens[..];
    restore(view);
    transition tokens[0].byte == 11 && tokens[1].byte == 31 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
