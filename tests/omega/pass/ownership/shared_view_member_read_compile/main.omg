// A shared borrow lends the caller's claim read-only: `peek(&account)`
// reads through the view while the caller's `account` stays live, and a
// second `&` local view coexists beside it. Shared loans don't repair —
// they never gave the callee write custody.
data Account { balance: u64; }

data Main { account: Account; }

machine Main::peek(account: &Account) -> u64 {
    account.balance
}

machine Main::main(main: &mut Main) {
    main.account = Account { balance: 42 };
    let seen: u64 = Main::peek(&main.account);
    let view: &Account = &main.account;
    let copied: u64 = view.balance;
    main.account.balance = copied;
}
