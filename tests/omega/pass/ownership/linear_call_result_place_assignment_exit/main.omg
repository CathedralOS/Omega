// A claim-bearing call result assigned to an existing place, not bound by
// `let`. The assignment's establishment is rooted at the destination owner,
// so the receiving path beneath the call result strips the destination's own
// projection: `pair.left = make(5)` continues `make`'s claim at `left`, and
// `held = make(9)` continues it at the whole local. Each place was vacated
// first, so no live obligation is overwritten.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine issue(first: i32, second: i32) -> Pair {
    let left: Receipt = Receipt { code: first };
    let right: Receipt = Receipt { code: second };
    Pair { left: left, right: right }
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine settle(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine main() crashes Trap {
    let mut pair: Pair = issue(1, 2);
    let vacated: Receipt = pair.left;
    let retired: i32 = consume(vacated);
    pair.left = make(5);
    let settled: i32 = settle(pair);
    let mut held: Receipt = make(8);
    let first: i32 = consume(held);
    held = make(9);
    let second: i32 = consume(held);
    let mut projected: Pair = issue(3, 4);
    let removed: i32 = consume(projected.left);
    projected.left = make(6);
    let replacement: i32 = consume(projected.left);
    let sibling: i32 = consume(projected.right);
    transition retired == 1 && settled == 7 && first == 8 && second == 9
        && removed == 3 && replacement == 6 && sibling == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
