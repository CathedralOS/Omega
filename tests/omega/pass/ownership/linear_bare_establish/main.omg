// A bare `let mut receipt: Receipt;` owns only zeroed storage — explicit
// assignment establishes the value and creates the linear obligation,
// then the consuming contract transfers custody and discharges it.
data Receipt [linear] { code: i32; }
boundary requirement Receipt::ack(receipt: Receipt);
machine Main::main() -> i32 {
    let mut receipt: Receipt;
    receipt = Receipt { code: 7 };
    Receipt::ack(receipt);
    0
}
data Main {}
