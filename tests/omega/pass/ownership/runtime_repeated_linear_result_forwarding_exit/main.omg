use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }

machine issue(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine combine(first: i32, second: i32) -> Pair {
    // Repeated invocations of one producer are distinct live claims. Their
    // establishment order is the reverse of the final record's field order.
    let right: Receipt = issue(second);
    let left: Receipt = issue(first);
    Pair { left: left, right: right }
}

machine capture(first: i32, second: i32) -> Pair {
    // Returning a captured result preserves both paths' actual invocation
    // lineage; it must not collapse them to the shared issue declaration.
    let captured: Pair = combine(first, second);
    captured
}

machine identity(receipt: Receipt) -> Receipt { receipt }

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine main() crashes Trap {
    let first: Pair = capture(11, 12);
    let second: Pair = capture(21, 22);
    // Both pairs are live before this projection moves one claim through an
    // input-return identity call; every sibling retains its own obligation.
    let forwarded: Receipt = identity(first.right);
    let first_left: i32 = consume(first.left);
    let second_right: i32 = consume(second.right);
    let first_right: i32 = consume(forwarded);
    let second_left: i32 = consume(second.left);
    transition first_left == 11 && first_right == 12
        && second_left == 21 && second_right == 22 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
