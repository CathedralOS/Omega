use omega::language::core::drop;

data Token<T> [linear] { value: u64; reference: T; }
machine Token::drop(token: &mut Token<T>) {}
data Holder<T> { guard: u64; token: Token<T>; }
data Attempt<T> {
    case Success(token: Token<T>);
    case Failure(token: Token<T>);
}

machine try_transform<'storage>(token: Token<&'storage i32>, succeed: bool) -> Attempt<&'storage i32> {
    transition succeed {
        true -> success(token)
        false -> Attempt::Failure { token: token }
    }
    machine success(token: Token<&'storage i32>) -> Attempt<&'storage i32> {
        let value: u64 = token.value;
        let reference: &'storage i32 = token.reference;
        drop(token);
        Attempt::Success { token: Token {
            value: ((value as u64 in Wrapping) + 1) as u64,
            reference: reference
        } }
    }
}

machine restore<'storage>(attempt: Attempt<&'storage i32>) -> Token<&'storage i32> {
    transition attempt {
        Attempt::Success { token } -> (token)
        Attempt::Failure { token } -> (token)
    }
}

machine apply<'storage>(holder: &mut Holder<&'storage i32>, succeed: bool) -> u64 {
    let detached: Token<&'storage i32> = holder.token;
    let attempt: Attempt<&'storage i32> = try_transform(detached, succeed);
    holder.token = restore(attempt);
    holder.token.value
}

machine main() crashes Trap {
    let backing: i32 = 73;
    let mut holder: Holder<&i32> = Holder {
        guard: 19,
        token: Token { value: 41, reference: &backing }
    };
    let failed: u64 = apply(&mut holder, false);
    let after_failure: i32 = holder.token.reference;
    let succeeded: u64 = apply(&mut holder, true);
    let after_success: i32 = holder.token.reference;
    let guard: u64 = holder.guard;
    let remaining: Token<&i32> = holder.token;
    drop(remaining);
    transition failed == 41 && succeeded == 42 && guard == 19
        && after_failure == 73 && after_success == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
