// Whole elements replaced through exclusive slice parameters. A view never
// owns its elements: each replacement opens and repairs a restoration window
// on the element the view selects in its collection, bounded by the view's
// runtime length. Copy elements take a call result, a copy of another index
// and a runtime-selected replacement between scalar writes. Affine elements
// dispose the displaced value before the store; moving one out leaves a hole
// that a later store repairs without disposal. The zeroing hook would expose
// cleanup applied to a new value instead of the displaced one.
data Exit [copy] { code: u64; open: bool; }
data Token { byte: i32; }
data Room { token: Token; cell: u64; }

machine Token::drop(token: &mut Token) { token.byte = 0; }

machine blank_exit(code: u64) -> Exit {
    Exit { code: code, open: true }
}

machine mint(byte: i32) -> Token {
    Token { byte: byte }
}

machine fill_exits(exits: &mut [Exit], at: u64)
requires exits.len >= 3, at < exits.len
{
    exits[2].code = 5;
    exits[0] = blank_exit(11);
    exits[1].code = 29;
    exits[2] = exits[0];
    exits[0].open = false;
    exits[at] = blank_exit(41);
}

// A subslice's element zero is element one of the viewed array.
machine reopen(exits: &mut [Exit])
requires exits.len >= 2
{
    exits[1] = blank_exit(43);
    exits[0] = exits[1];
    exits[0].open = false;
}

machine rotate(tokens: &mut [Token], at: u64)
requires tokens.len >= 3, at < tokens.len
{
    tokens[1] = mint(68);
    let first: Token = tokens[0];
    tokens[0] = mint(69);
    tokens[2] = first;
    tokens[at] = mint(71);
}

machine swap(tokens: &mut [Token])
requires tokens.len >= 2
{
    let first: Token = tokens[0];
    let second: Token = tokens[1];
    tokens[0] = second;
    tokens[1] = first;
}

// A field of a view element is a window below the same selected element.
machine refit(rooms: &mut [Room], at: u64)
requires rooms.len >= 2, at < rooms.len
{
    rooms[1].token = mint(68);
    let first: Token = rooms[0].token;
    rooms[0].token = mint(69);
    rooms[at].token = first;
    rooms[at].cell = 9;
}

// A view forwarded to a state keeps its loan; the block parameter roots the
// window.
machine forward(tokens: &mut [Token])
requires tokens.len >= 3
{
    transition { _ -> replace(tokens) }
    machine replace(tokens: &mut [Token])
    requires tokens.len >= 3
    {
        tokens[2] = mint(70);
    }
}

machine main() crashes Trap {
    let mut exits: [Exit; 4];
    let exit_view: &mut [Exit] = &mut exits[0..4];
    fill_exits(exit_view, 1);
    let exit_tail: &mut [Exit] = &mut exit_view[2..4];
    reopen(exit_tail);
    let mut tokens: [Token; 3] = [Token { byte: 65 }, Token { byte: 66 }, Token { byte: 67 }];
    let view: &mut [Token] = &mut tokens[0..3];
    rotate(view, 1);
    swap(view);
    forward(view);
    let mut rooms: [Room; 2] = [
        Room { token: Token { byte: 65 }, cell: 1 },
        Room { token: Token { byte: 66 }, cell: 2 }
    ];
    let room_view: &mut [Room] = &mut rooms[0..2];
    refit(room_view, 1);
    transition exits[0].code == 11 && !exits[0].open
        && exits[1].code == 41 && exits[1].open
        && exits[2].code == 43 && !exits[2].open
        && exits[3].code == 43 && exits[3].open
        && tokens[0].byte == 71 && tokens[1].byte == 69 && tokens[2].byte == 70
        && rooms[0].token.byte == 69 && rooms[0].cell == 1
        && rooms[1].token.byte == 65 && rooms[1].cell == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
