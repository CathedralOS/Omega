// Expected exit: 0
use borrowed_partition_support::main;
use omega::language::core::drop;
machine refresh(strategy: &mut Strategy) -> u64
requires strategy.tail.length == 48
ensures strategy.tail.length == 48, strategy.remaining == 48, result == 0
{
    let previous: Region in Owned = strategy.tail;
    drop(previous);
    strategy.tail = issue();
    strategy.remaining = 48;
    0
}
machine cycle(strategy: &mut Strategy, select: bool, count: u64) -> bool
requires strategy.tail.length == 48
ensures strategy.tail.length == 48, strategy.remaining == 48
{
    transition { _ -> again(strategy, select, count) }
    machine again(strategy: &mut Strategy, select: bool, count: u64) -> bool
    requires strategy.tail.length == 48
    {
        let zero: u64 = match select { true -> refresh(strategy), false -> refresh(strategy) };
        transition count == 0 { true -> complete(strategy, zero) _ -> again(strategy, !select, count - 1) }
    }
    machine complete(strategy: &mut Strategy, zero: u64) -> bool
    requires strategy.tail.length == 48, strategy.remaining == 48, zero == 0
    { strategy.tail.length == 48 && strategy.remaining == 48 && zero == 0 }
}
machine exercise(select: bool) -> bool {
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let correct: bool = cycle(&mut strategy, select, 3);
    drop(strategy.tail);
    correct
}
machine main() crashes Trap {
    transition exercise(true) && exercise(false) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
