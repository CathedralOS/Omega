// Expected exit: 0
// Moving an intact nominal linear parent transports its contained obligation.
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Envelope [linear] { token: Token; marker: u64; }
machine Envelope::drop(envelope: &mut Envelope) {}
domain Envelope::Moved;
data Carrier { envelope: Envelope; sibling: u64; }

machine forward(envelope: Envelope) -> Envelope in Moved {
    let moved: Envelope in Moved = envelope;
    moved
}

machine from_field(carrier: Carrier) -> Envelope in Moved {
    let moved: Envelope in Moved = carrier.envelope;
    moved
}

machine produce() -> Envelope {
    Envelope { token: Token { value: 29 }, marker: 17 }
}

machine from_result() -> Envelope in Moved {
    let moved: Envelope in Moved = produce();
    moved
}

machine observe(envelope: Envelope) -> bool {
    let value: u64 = envelope.token.value;
    let marker: u64 = envelope.marker;
    drop(envelope);
    value == 29 && marker == 17
}

machine main() crashes Trap {
    let original: Envelope = Envelope {
        token: Token { value: 29 }, marker: 17
    };
    let moved: Envelope = forward(original);
    let local_ok: bool = observe(moved);
    let field_ok: bool = observe(from_field(Carrier {
        envelope: produce(), sibling: 11
    }));
    let result_ok: bool = observe(from_result());
    transition local_ok && field_ok && result_ok {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
