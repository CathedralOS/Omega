use omega_language_std::console;
use omega::language::core::drop;

data Inventory [linear] { slots: i32; }
machine Inventory::drop(inventory: &mut Inventory) {}
data Envelope [linear] { guard: i32; inventory: Inventory; }
machine Envelope::drop(envelope: &mut Envelope) {}
data Main { }

machine transform(inventory: Inventory) -> Inventory {
    transition inventory.slots == 41 {
        true -> increment(inventory)
        false -> preserve(inventory)
    }
    state increment(inventory: Inventory) -> Inventory {
        let slots: i32 = inventory.slots;
        drop(inventory);
        Inventory { slots: ((slots as i32 in Wrapping) + 1) as i32 }
    }
    state preserve(inventory: Inventory) -> Inventory { inventory }
}

machine repair(inventory: &mut Inventory) -> i32 {
    let alias: &mut Inventory = inventory;
    let removed: Inventory = alias;
    alias = transform(removed);
    alias.slots
}

machine repair_projected(envelope: &mut Envelope) -> i32 {
    let alias: &mut Inventory = &mut envelope.inventory;
    let forwarded: &mut Inventory = alias;
    let removed: Inventory = forwarded;
    forwarded = transform(removed);
    forwarded.slots
}

machine Main::main(main: &mut Main) reaches Console {
    let mut inventory: Inventory = Inventory { slots: 41 };
    let transformed: i32 = repair(&mut inventory);
    inventory.slots = 7;
    let preserved: i32 = repair(&mut inventory);
    let final_value: i32 = inventory.slots;
    drop(inventory);
    let mut envelope: Envelope = Envelope { guard: 19, inventory: Inventory { slots: 41 } };
    let projected: i32 = repair_projected(&mut envelope);
    let guard: i32 = envelope.guard;
    let projected_final: i32 = envelope.inventory.slots;
    drop(envelope);
    transition transformed == 42 && preserved == 7 && final_value == 7
        && projected == 42 && guard == 19 && projected_final == 42 {
        true -> finish(main, 42)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
