// Expected exit: 0. Observing a returned owner's field or case retains the nested transfer.
data Ticket { value: u64; }
// The observed tag is copyable; the call still consumes its affine Ticket input.
data Choice [copy] { case Full(value: u64); case Empty; }
machine issue() -> Ticket { Ticket { value: 73 } }
machine forward(ticket: Ticket) -> Ticket { ticket }
machine pack(ticket: Ticket) -> Choice { Choice::Full { value: ticket.value } }
machine main() crashes Trap {
    let field_ticket: Ticket = issue();
    let field: u64 = forward(field_ticket).value;
    let case_ticket: Ticket = issue();
    let full: bool = pack(case_ticket) in Choice::Full;
    transition field == 73 && full { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
