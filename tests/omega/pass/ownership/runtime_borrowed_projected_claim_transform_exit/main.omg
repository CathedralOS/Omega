use omega_language_std::console;
use omega::language::core::drop;

data Counter [linear] { slots: i32; }
machine Counter::drop(counter: &mut Counter) {}
data Inventory { marker: i32; counter: Counter; }
data Holder { inventory: Inventory; }

machine Inventory::bump(inventory: Inventory) -> Inventory {
    transition inventory.counter.slots == 41 {
        true -> increment(inventory)
        false -> preserve(inventory)
    }
    state increment(inventory: Inventory) -> Inventory {
        let marker: i32 = inventory.marker;
        let counter: Counter = inventory.counter;
        let slots: i32 = counter.slots;
        drop(counter);
        Inventory { marker: marker, counter: Counter { slots: ((slots as i32 in Wrapping) + 1) as i32 } }
    }
    state preserve(inventory: Inventory) -> Inventory { inventory }
}

machine apply(holder: &mut Holder) -> i32 {
    let taken: Inventory = holder.inventory;
    holder.inventory = move Inventory::bump(taken);
    holder.inventory.counter.slots
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut holder: Holder = Holder { inventory: Inventory { marker: 99, counter: Counter { slots: 41 } } };
    let transformed: i32 = apply(&mut holder);
    holder.inventory.counter.slots = 7;
    let preserved: i32 = apply(&mut holder);
    let preserved_marker: i32 = holder.inventory.marker;
    let final_counter: Counter = holder.inventory.counter;
    let final_slots: i32 = final_counter.slots;
    drop(final_counter);
    transition transformed == 42 && preserved == 7 && final_slots == 7 && preserved_marker == 99 {
        true -> finish(main, 42)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
