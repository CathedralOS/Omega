// A `&mut` loan may name a nested member: `&mut outer.inner` lends exactly
// the inner record's claim — the callee sees only the borrowed subtree and
// the parent's other members stay owned by the caller.
data Inner { count: u64; }

data Outer {
    inner: Inner;
    tag: u64;
}

data Main { outer: Outer; }

machine Main::bump(inner: &mut Inner)
requires inner.count <= 100
{
    inner.count = inner.count + 1;
}

machine Main::main(main: &mut Main) {
    main.outer = Outer { inner: Inner { count: 40 }, tag: 7 };
    Main::bump(&mut main.outer.inner);
    let tag: u64 = main.outer.tag;
}
