data Token { value: u64; }
data Cursor { index: u64; calls: u64 in Wrapping; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine select(cursor: &mut Cursor) -> u64 ensures result == 1 {
    cursor.calls += 1;
    cursor.index = 1;
    1
}

machine replacement(cursor: &mut Cursor) -> Token {
    cursor.index = 3;
    Token { value: 19 }
}

machine main() crashes Trap {
    let mut tokens: [Token; 2] = [Token { value: 11 }, Token { value: 7 }];
    let mut cursor: Cursor = Cursor { index: 0, calls: 0 };
    // The target computation executes once, before the replacement call.
    // Old cleanup and store consume its saved coordinate, not another call.
    // A nonzero selection also exposes cleanup that loses the runtime offset.
    tokens[select(&mut cursor)] = replacement(&mut cursor);
    transition cursor.calls == 1 && cursor.index == 3
        && tokens[0].value == 11 && tokens[1].value == 19 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
