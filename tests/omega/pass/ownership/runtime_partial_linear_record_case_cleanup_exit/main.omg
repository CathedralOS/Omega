// An absent payload remains absent through completed call results, projected
// fields and reconstructed carriers. A live payload takes the same route
// with its original linear obligation and is consumed exactly once.
use omega::language::core::drop;

data Token [linear] { value: u32; }
machine Token::drop(token: &mut Token) {}
data Slot { case Empty; case Held(token: Token); }
data Holder { slot: Slot; }

machine empty() -> Holder { Holder { slot: Slot::Empty } }
machine forward(value: Holder) -> Holder { value }

machine anonymous() -> Holder {
    let value: Holder = empty();
    forward(Holder { slot: value.slot })
}

machine named() -> Holder {
    let value: Holder = empty();
    let rebuilt: Holder = Holder { slot: value.slot };
    forward(rebuilt)
}

machine returned() -> Holder {
    let value: Holder = empty();
    Holder { slot: value.slot }
}

machine held(token: Token) -> Holder {
    let value: Holder = Holder { slot: Slot::Held { token: token } };
    forward(Holder { slot: value.slot })
}

// A named reconstructed carrier must forward a present optional claim too.
machine named_held(token: Token) -> Holder {
    let value: Holder = Holder { slot: Slot::Held { token: token } };
    let rebuilt: Holder = Holder { slot: value.slot };
    forward(rebuilt)
}

machine consume(value: Holder) -> u32 {
    transition value.slot {
        Slot::Empty -> 0
        Slot::Held { token } -> finish(token)
    }
    machine finish(token: Token) -> u32 {
        let value: u32 = token.value;
        drop(token);
        value
    }
}

// An unconditional claim remains live when the neighboring case is empty.
// The generic return must also retain the optional payload when it is present.
data Mixed { required: Token; slot: Slot; }
machine forward_mixed(value: Mixed) -> Mixed { value }
machine empty_mixed(required: Token) -> Mixed {
    Mixed { required: required, slot: Slot::Empty }
}
machine consume_mixed(value: Mixed) -> u64 {
    let required: u32 = value.required.value;
    drop(value.required);
    transition value.slot {
        Slot::Empty -> empty_value(required)
        Slot::Held { token } -> finish(required, token)
    }
    machine empty_value(required: u32) -> u64 { required as u64 }
    machine finish(required: u32, token: Token) -> u64 {
        let payload: u32 = token.value;
        drop(token);
        (required as u64) + (payload as u64)
    }
}

// A partial owner also cleans selected structural payloads with no hooks.
data Item { value: u32; }
data AffineSlot { case Empty; case Held(item: Item); }
data AffineMixed { required: Token; slot: AffineSlot; }
machine forget_affine(value: AffineMixed) { drop(value.required); }

machine main() crashes Trap {
    let first: u32 = consume(anonymous());
    let second: u32 = consume(named());
    let third: u32 = consume(returned());
    let live: u32 = consume(held(Token { value: 70 }));
    let named_live: u32 = consume(named_held(Token { value: 71 }));
    let mixed_empty: u64 = consume_mixed(forward_mixed(empty_mixed(Token { value: 11 })));
    let mixed_live: u64 = consume_mixed(forward_mixed(Mixed {
        required: Token { value: 11 },
        slot: Slot::Held { token: Token { value: 70 } }
    }));
    forget_affine(AffineMixed {
        required: Token { value: 11 }, slot: AffineSlot::Empty
    });
    forget_affine(AffineMixed {
        required: Token { value: 11 },
        slot: AffineSlot::Held { item: Item { value: 70 } }
    });
    transition first == 0 && second == 0 && third == 0 && live == 70 && named_live == 71
        && mixed_empty == 11 && mixed_live == 81 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
