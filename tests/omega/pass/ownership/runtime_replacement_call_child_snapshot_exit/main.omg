data Child { value: u64; }
data Pair { first: Child; second: u64; }
data Cursor { value: u64; }

machine next(cursor: &mut Cursor) -> u64
ensures result == 9, cursor.value == 9
{
    cursor.value = 9;
    9
}

machine later(cursor: &mut Cursor) -> u64
ensures result == 5, cursor.value == 11
{
    cursor.value = 11;
    5
}

machine replace(pair: &mut Pair, cursor: &mut Cursor)
ensures pair.first.value == 9, pair.second == 5, cursor.value == 11
{
    let alias: &mut Pair = pair;
    alias = Pair {
        first: Child { value: next(cursor) },
        second: later(cursor)
    };
}

machine observe_saved(saved: &[Child; 2])
requires saved[0].value == 9, saved[1].value == 5 {}

machine capture_array(cursor: &mut Cursor) -> [Child; 2] {
    let saved: [Child; 2] = [
        Child { value: next(cursor) },
        Child { value: later(cursor) }
    ];
    observe_saved(&saved);
    saved
}

machine main() crashes Trap {
    let mut pair: Pair = Pair { first: Child { value: 3 }, second: 4 };
    let mut cursor: Cursor = Cursor { value: 7 };
    replace(&mut pair, &mut cursor);
    let saved: [Child; 2] = capture_array(&mut cursor);
    transition pair.first.value == 9 && pair.second == 5 && cursor.value == 11
        && saved[0].value == 9 && saved[1].value == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
