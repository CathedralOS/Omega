// A stored `&` view forwards to another callee as an argument: `let
// peek: &u64 = &main.score` then `read(peek)` — the existing loan is the
// argument; no second loan is taken at the call site.
data Main { score: u64; }

machine Main::read(score: &u64) -> u64 {
    score
}

machine Main::main(main: &mut Main) {
    main.score = 42;
    let peek: &u64 = &main.score;
    let seen: u64 = Main::read(peek);
}
