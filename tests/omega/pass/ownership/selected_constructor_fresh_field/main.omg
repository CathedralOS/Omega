// Expected exit: 0
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Holder { token: Token; }
data Pair { left: Token; right: Token; }
data Wrapped { pair: Pair; }
machine choose(holder: Holder, selected: bool) -> Pair {
    match selected {
        true -> Pair { left: holder.token, right: Token { value: 29 } },
        false -> Pair { left: holder.token, right: Token { value: 31 } },
    }
}
machine wrap(holder: Holder, selected: bool) -> Wrapped {
    let pair: Pair = choose(holder, selected);
    Wrapped { pair: pair }
}
machine two_live() crashes Trap {
    let first: Wrapped = wrap(Holder { token: Token { value: 17 } }, true);
    let second: Wrapped = wrap(Holder { token: Token { value: 43 } }, false);
    let correct: bool = first.pair.left.value == 17 && first.pair.right.value == 29
        && second.pair.left.value == 43 && second.pair.right.value == 31;
    let { pair as first_pair } = first;
    let { pair as second_pair } = second;
    let { left as first_left, right as first_right } = first_pair;
    let { left as second_left, right as second_right } = second_pair;
    drop(first_left);
    drop(first_right);
    drop(second_left);
    drop(second_right);
    transition correct { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exercise(selected: bool) crashes Trap {
    let pair: Pair = choose(Holder { token: Token { value: 17 } }, selected);
    let correct: bool = pair.left.value == 17 && match selected {
        true -> pair.right.value == 29,
        false -> pair.right.value == 31,
    };
    let { left, right } = pair;
    drop(left);
    drop(right);
    transition correct { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap { exercise(true); exercise(false); two_live(); }
