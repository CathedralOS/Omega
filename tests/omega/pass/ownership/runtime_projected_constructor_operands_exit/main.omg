// Each constructor moves only its selected subtree. The neighboring mandatory
// token remains readable and consumable after the constructed argument returns.
use omega::language::core::drop;

data Token [linear] { value: u32; }
machine Token::drop(token: &mut Token) {}
data Slot { case Empty; case Held(token: Token); }
data Holder { slot: Slot; }
data Mixed { required: Token; slot: Slot; }
data Pair { required: Token; payload: Token; }

machine consume(value: Holder) -> u32 {
    transition value.slot {
        Slot::Empty -> 0
        Slot::Held { token } -> finish(token)
    }
    machine finish(token: Token) -> u32 {
        let value: u32 = token.value;
        drop(token);
        value
    }
}

machine forward(value: Mixed) -> Mixed { value }

machine consume_after_sibling(value: Mixed) -> u64 {
    let required: u32 = value.required.value;
    drop(value.required);
    (required as u64) + (consume(Holder { slot: value.slot }) as u64)
}

machine consume_before_sibling(value: Mixed) -> u64 {
    let payload: u32 = consume(Holder { slot: value.slot });
    let required: u32 = value.required.value;
    drop(value.required);
    (required as u64) + (payload as u64)
}

machine consume_case(value: Pair) -> u64 {
    let payload: u32 = consume(Holder { slot: Slot::Held { token: value.payload } });
    let required: u32 = value.required.value;
    drop(value.required);
    (required as u64) + (payload as u64)
}

machine consume_array(values: [Slot; 1]) -> u32 {
    let slot: Slot = values[0];
    consume(Holder { slot: slot })
}

machine consume_array_before_sibling(value: Mixed) -> u64 {
    let payload: u32 = consume_array([value.slot]);
    let required: u32 = value.required.value;
    drop(value.required);
    (required as u64) + (payload as u64)
}

machine consume_pair(value: Pair) -> u64 {
    let required: u32 = value.required.value;
    let payload: u32 = value.payload.value;
    drop(value.required);
    drop(value.payload);
    (required as u64) * 100 + (payload as u64)
}

machine swap(value: Pair) -> u64 {
    consume_pair(Pair { payload: value.required, required: value.payload })
}

machine main() crashes Trap {
    let original: u64 = consume_after_sibling(forward(Mixed {
        required: Token { value: 11 }, slot: Slot::Held { token: Token { value: 70 } }
    }));
    let held: u64 = consume_before_sibling(Mixed {
        required: Token { value: 12 }, slot: Slot::Held { token: Token { value: 70 } }
    });
    let empty: u64 = consume_before_sibling(Mixed {
        required: Token { value: 13 }, slot: Slot::Empty
    });
    let selected: u64 = consume_case(Pair {
        required: Token { value: 14 }, payload: Token { value: 70 }
    });
    let array: u64 = consume_array_before_sibling(Mixed {
        required: Token { value: 15 }, slot: Slot::Held { token: Token { value: 70 } }
    });
    let swapped: u64 = swap(Pair {
        required: Token { value: 12 }, payload: Token { value: 34 }
    });
    transition original == 81 && held == 82 && empty == 13 && selected == 84
        && array == 85 && swapped == 3412 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
