// Expected exit: 0. Selected custody follows actual completed values.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Choice { case Empty; case Live(token: Token); }
machine choose(enabled: bool) -> Choice {
    match enabled {
        true -> Choice::Live { token: Token { value: 13 } },
        _ -> Choice::Empty,
    }
}
machine value(choice: Choice) -> u64 {
    transition choice {
        Choice::Empty -> empty()
        Choice::Live { token } -> read(token)
    }
}
machine empty() -> u64 { 0 }
machine read(token: Token) -> u64 {
    let result: u64 = token.value;
    drop(token);
    result
}
machine main() crashes Trap {
    let present: u64 = value(choose(true));
    let absent: u64 = value(choose(false));
    transition present == 13 && absent == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
