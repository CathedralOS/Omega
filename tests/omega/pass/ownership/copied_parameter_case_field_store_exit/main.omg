// A mutable local copied from a by-value parameter is fresh storage the
// caller cannot observe: storing a field of it, scalar or case-valued, writes
// only the copy. Exits 70 when the straight-line copy and the branch-state
// copy each report Second (2 + 2), the original stays First (1) and the
// copies' counts read back 7 and 9 (2 + 2 + 1 + 7 + 9 = 21).
use omega_language_std::console;

data Kind [copy] {
    case First;
    case Second;
}

data Item [copy] {
    kind: Kind;
    count: u64 in Trapping;
}

machine Kind::tag(kind: Kind) -> u64 in Trapping {
    transition kind {
        Kind::First -> one()
        _ -> two()
    }

    state one() -> u64 in Trapping { 1 }
    state two() -> u64 in Trapping { 2 }
}

// Straight-line: the copy's case field and count are replaced.
machine Item::promoted(item: Item) -> Item {
    let mut copy: Item = item;
    copy.kind = Kind::Second;
    copy.count = 7;
    copy
}

// Branch state: the same stores after a transition.
machine Item::promoted_when(item: Item, promote: bool) -> Item {
    transition promote {
        true -> promote(item)
        _ -> keep(item)
    }

    state promote(item: Item) -> Item {
        let mut copy: Item = item;
        copy.kind = Kind::Second;
        copy.count = 9;
        copy
    }

    state keep(item: Item) -> Item { item }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let original: Item = Item { kind: Kind::First, count: 3 };
    let straight: Item = Item::promoted(original);
    let branched: Item = Item::promoted_when(original, true);
    let straight_tag: u64 in Trapping = Kind::tag(straight.kind);
    let branched_tag: u64 in Trapping = Kind::tag(branched.kind);
    let original_tag: u64 in Trapping = Kind::tag(original.kind);
    let total: u64 in Trapping = straight_tag + branched_tag + original_tag + straight.count + branched.count;
    transition total == 21 {
        true -> done(main, 70)
        _ -> done(main, 71)
    }

    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
