// Expected exit: 0. Mutually exclusive arms retain separate custody; a read
// completed before a move remains valid. Exercise both selections at runtime.
data Ticket { value: u64; }
machine take(ticket: Ticket) -> u64 { ticket.value }
machine compare(left: u64, right: u64) -> bool { left == right }
machine selected(choice: bool, ticket: Ticket) -> u64 {
    match choice { true -> take(ticket) false -> ticket.value }
}
machine before_move(choice: bool, ticket: Ticket) -> bool {
    match choice {
        true -> compare(ticket.value, take(ticket))
        false -> ticket.value == 7
    }
}
machine short_before_move(choice: bool, ticket: Ticket) -> bool {
    choice && compare(ticket.value, take(ticket))
}
machine main() crashes Trap {
    let moved: u64 = selected(true, Ticket { value: 7 });
    let retained: u64 = selected(false, Ticket { value: 7 });
    let before: bool = before_move(true, Ticket { value: 7 });
    let sibling: bool = before_move(false, Ticket { value: 7 });
    let evaluated: bool = short_before_move(true, Ticket { value: 7 });
    let skipped: bool = short_before_move(false, Ticket { value: 7 });
    transition moved == 7 && retained == 7 && before && sibling && evaluated && !skipped {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
