use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

// Hook-less linear obligation: the declared consuming contract is the
// authorized terminal disposition.
boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}


machine consume(receipt: Receipt) -> i32 {
    Receipt::ack(receipt);
    17
}
machine forward(receipt: Receipt) -> Receipt { receipt }
data Envelope { receipt: Receipt; }
machine consume_envelope(envelope: Envelope) -> i32 { consume(envelope.receipt) }
machine selected(choice: i32) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    match choice {
        0 -> consume(forward(receipt)),
        consume(receipt) -> 17,
        _ -> 23,
    }
}
machine selected_pattern(choice: i32) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    match choice {
        0 -> consume(receipt),
        consume(forward(forward(receipt))) -> 17,
        _ -> 23,
    }
}
machine selected_construction(choice: i32) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    match choice {
        0 -> consume_envelope(Envelope { receipt: forward(receipt) }),
        consume(receipt) -> 17,
        _ -> 23,
    }
}
machine main() crashes Trap {
    transition selected(0) == 17 && selected(17) == 17 && selected(23) == 23
        && selected_pattern(0) == 17 && selected_pattern(17) == 17 && selected_pattern(23) == 23
        && selected_construction(0) == 17 && selected_construction(17) == 17 && selected_construction(23) == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
