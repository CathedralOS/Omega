// Expected exit: 0
// A consuming recoverable result restores its exact borrowed place and preserves disjoint storage.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Outcome { case Success(token: Token); case Failure(token: Token); }
data Holder { tokens: [Token; 2]; sibling: u64; }
machine first_slot(count: &mut u64) -> u64 ensures result == 1 { count = ((count as u64 in Wrapping) + 1) as u64; 1 }
machine attempt(token: Token, succeed: bool, observed: u64) -> Outcome {
    transition succeed {
        true -> success(token)
        _ -> Outcome::Failure { token: token }
    }
    machine success(token: Token) -> Outcome {
        let value: u64 = token.value;
        drop(token);
        Outcome::Success { token: Token { value: ((value as u64 in Wrapping) + 1) as u64 } }
    }
}
machine recover(outcome: Outcome) -> Token {
    transition outcome {
        Outcome::Success { token } -> token
        Outcome::Failure { token } -> token
    }
}
machine observe(sibling: &mut u64) -> u64 { sibling = 19; sibling }
machine repair(holder: &mut Holder, succeed: bool, count: &mut u64) {
    let alias: &mut Token = &mut holder.tokens[first_slot(count)];
    let first: Outcome = attempt(alias, succeed, observe(&mut holder.sibling));
    alias = recover(first);
    let detached: Token = alias;
    let second: Outcome = attempt(detached, succeed, observe(&mut holder.sibling));
    holder.tokens[first_slot(count)] = recover(second);
}
machine main() crashes Trap {
    let mut count: u64 = 0;
    let mut holder: Holder = Holder { tokens: [Token { value: 7 }, Token { value: 42 }], sibling: 7 };
    repair(&mut holder, false, &mut count);
    repair(&mut holder, true, &mut count);
    let correct: bool = holder.tokens[first_slot(&mut count)].value == 44 && holder.sibling == 19 && count == 5;
    drop(holder.tokens[first_slot(&mut count)]);
    drop(holder.tokens[0]);
    transition (correct && count == 6) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
