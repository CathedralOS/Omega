use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

// Hook-less linear obligation: the declared consuming contract is the
// authorized terminal disposition.
boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}


machine consume(receipt: Receipt) -> i32 {
    Receipt::ack(receipt);
    17
}
machine selected(choice: i32) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    match choice {
        0 -> consume(receipt),
        consume(receipt) -> 17,
        _ -> 23,
    }
}
machine selected_target(choice: bool) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    transition choice {
        true -> (consume(receipt))
        false -> (consume(receipt))
    }
}
machine main() crashes Trap {
    transition selected(0) == 17 && selected(17) == 17 && selected(23) == 23 && selected_target(true) == 17 && selected_target(false) == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
