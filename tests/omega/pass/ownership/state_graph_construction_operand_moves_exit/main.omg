// Affine owners moved into the construction a computed call consumes, inside
// a machine with named states. The entry state moves a local into the record
// it hands to `settle`; `holding` moves its parameter into another such
// record. Each move is the owner's one disposition: neither state disposes
// of the moved owner again at its exit.
data Token { code: i32; }

data Pair { left: Token; right: Token; }

machine settle(pair: Pair) -> i32 {
    ((pair.left.code as i32 in Wrapping) + (pair.right.code as i32 in Wrapping)) as i32
}

machine main() crashes Trap {
    let left: Token = Token { code: 1 };
    let first: i32 = settle(Pair { left: left, right: Token { code: 2 } });
    let carried: Token = Token { code: first };
    transition { _ -> holding(carried) }

    machine holding(held: Token) {
        let total: i32 = settle(Pair { left: held, right: Token { code: 4 } });
        transition total == 7 {
            true -> done()
            _ -> bad()
        }
    }

    machine done() {}
    machine bad() { crash Trap; }
}
