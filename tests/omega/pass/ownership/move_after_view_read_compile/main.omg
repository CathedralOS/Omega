// A shared view's last read retires it, and `move` may then take the
// member: `&main.tag` feeds `peek`, then `move main.tag` transfers the
// claim — reads and moves sequence cleanly on one member.
data Main {
    tag: u64;
    answer: u64;
}

machine Main::peek(tag: &u64) -> u64 {
    tag
}

machine Main::spend(token: u64) -> u64 {
    token
}

machine Main::main(main: &mut Main) {
    main.tag = 9;
    let seen: u64 = Main::peek(&main.tag);
    let taken: u64 = Main::spend(move main.tag);
    transition taken {
        9 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
