// Expected exit: 0
use borrowed_partition_support::main;
data FirstPass { strategy: Strategy; first: Region in Owned; }
machine begin(select: bool) -> FirstPass
ensures result.first.length == 16, result.strategy.tail.length == 32,
    result.strategy.remaining == 32
{
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let first: Region in Owned = match select {
        true -> carve(&mut strategy, 48, 16),
        false -> carve(&mut strategy, 48, 16),
    };
    FirstPass { strategy: strategy, first: first }
}
machine exercise(select: bool) -> bool {
    let initial: FirstPass = begin(select);
    let mut current: Strategy = initial.strategy;
    let first: Region in Owned = initial.first;
    let second: Region in Owned = carve(&mut current, 32, 8);
    finish(current, first, second)
}
machine main() crashes Trap {
    let correct: bool = exercise(true) && exercise(false);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
