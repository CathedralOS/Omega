// A `&mut` loan projects through a member into an element:
// `fill(&mut main.row.cells[1])` lends just the array's second slot —
// the loan path combines member and index freely.
data Row {
    cells: [u64; 3];
    tag: u64;
}

data Main {
    row: Row;
    answer: u64;
}

machine Main::fill(cell: &mut u64) {
    cell = 9;
}

machine Main::main(main: &mut Main) {
    main.row = Row { cells: [1, 2, 3], tag: 4 };
    Main::fill(&mut main.row.cells[1]);
    transition main.row.cells[1] {
        9 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
