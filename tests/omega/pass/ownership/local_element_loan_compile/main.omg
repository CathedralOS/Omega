// A `&mut` loan may name an element of a plain local: `bump(&mut
// cells[1])` lends the second slot of a caller-owned array — the loan
// needs no member path, only an index projection.
data Main { answer: u64; }

machine Main::bump(cell: &mut u64) {
    cell = 9;
}

machine Main::main(main: &mut Main) {
    let cells: [u64; 3] = [1, 2, 3];
    Main::bump(&mut cells[1]);
    transition cells[1] {
        9 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
