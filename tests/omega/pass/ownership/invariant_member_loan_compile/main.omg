// A `&mut` loan may name a `data where` member: `fill(&mut
// main.margin.left)` lends the constrained field — the callee's write
// then flows back through the invariant's lens at the record boundary.
data Margin
where
    left - right >= 2,
{
    left: u64;
    right: u64;
}

data Main { margin: Margin; }

machine Main::fill(cell: &mut u64) ensures cell == 8 {
    cell = 8;
}

machine Main::main(main: &mut Main) {
    main.margin = Margin { left: 7, right: 3 };
    Main::fill(&mut main.margin.left);
}
