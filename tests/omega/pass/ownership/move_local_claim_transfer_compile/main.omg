// `move` transfers the claim on a non-linear local: after `let moved =
// move token` the original binding no longer contributes a live claim and
// only `moved` may be read or passed onward. The move is ownership transfer,
// not a copy.
data Token { raw: u64; }

data Main { answer: u64; }

machine Main::spend(token: Token) -> u64 {
    token.raw
}

machine Main::main(main: &mut Main) {
    let token: Token = Token { raw: 40 };
    let moved: Token = move token;
    main.answer = Main::spend(moved);
}
