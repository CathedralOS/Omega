// A narrowed local view keeps its own loan and element coordinates. It is
// neither a new collection owner nor a spelling of its parent's element zero.
data Exit [copy] { code: u64; open: bool; }
data Token { byte: i32; }

machine Token::drop(token: &mut Token) { token.byte = 0; }

machine blank_exit(code: u64) -> Exit {
    Exit { code: code, open: true }
}

machine fill(exits: &mut [Exit])
requires exits.len >= 4
{
    let tail: &mut [Exit] = exits[1..3];
    tail[0].code = 11;
    tail[1] = blank_exit(43);
    let nested: &mut [Exit] = tail[1..2];
    nested[0].open = false;
}

machine rotate(tokens: &mut [Token])
requires tokens.len >= 4
{
    let tail: &mut [Token] = tokens[1..3];
    let first: Token = tail[0];
    tail[0] = Token { byte: 69 };
    tail[1] = first;
}

machine main() crashes Trap {
    let mut exits: [Exit; 4];
    let exit_view: &mut [Exit] = exits.as_mut_slice();
    fill(exit_view);
    let mut tokens: [Token; 4] = [
        Token { byte: 65 }, Token { byte: 66 },
        Token { byte: 67 }, Token { byte: 68 }
    ];
    let token_view: &mut [Token] = tokens.as_mut_slice();
    rotate(token_view);
    transition exits[0].code == 0 && !exits[0].open
        && exits[1].code == 11 && !exits[1].open
        && exits[2].code == 43 && !exits[2].open
        && exits[3].code == 0 && !exits[3].open
        && tokens[0].byte == 65 && tokens[1].byte == 69
        && tokens[2].byte == 66 && tokens[3].byte == 68 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
