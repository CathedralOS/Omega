// A narrowed local view keeps its own loan and element coordinates. It is
// neither a new collection owner nor a spelling of its parent's element zero.
data Exit [copy] { code: u64; open: bool; }
data Token { byte: i32; }

machine Token::drop(token: &mut Token) { token.byte = 0; }

machine blank_exit(code: u64) -> Exit {
    Exit { code: code, open: true }
}

machine fill(exits: &mut [Exit])
requires exits.len >= 4
{
    let tail: &mut [Exit] = &mut exits[1..3];
    tail[0].code = 11;
    tail[1] = blank_exit(43);
    let nested: &mut [Exit] = &mut tail[1..2];
    nested[0].open = false;
}

machine rotate(tokens: &mut [Token], at: u64)
requires tokens.len >= 4, at < 2
{
    let tail: &mut [Token] = &mut tokens[1..3];
    let chosen: u64 = at + 0;
    let shifted: u64 = (chosen + 1) - 1;
    let selected: u64 = shifted;
    let first: Token = tail[selected];
    tail[at] = Token { byte: 69 };
    tail[1] = first;
}

machine main() crashes Trap {
    let mut exits: [Exit; 4];
    let exit_view: &mut [Exit] = &mut exits[..];
    fill(exit_view);
    let mut tokens: [Token; 4] = [
        Token { byte: 65 }, Token { byte: 66 },
        Token { byte: 67 }, Token { byte: 68 }
    ];
    let token_view: &mut [Token] = &mut tokens[..];
    rotate(token_view, 0);
    let mut other_tokens: [Token; 4] = [
        Token { byte: 65 }, Token { byte: 66 },
        Token { byte: 67 }, Token { byte: 68 }
    ];
    let other_view: &mut [Token] = &mut other_tokens[..];
    rotate(other_view, 1);
    transition exits[0].code == 0 && !exits[0].open
        && exits[1].code == 11 && !exits[1].open
        && exits[2].code == 43 && !exits[2].open
        && exits[3].code == 0 && !exits[3].open
        && tokens[0].byte == 65 && tokens[1].byte == 69
        && tokens[2].byte == 66 && tokens[3].byte == 68
        && other_tokens[0].byte == 65 && other_tokens[1].byte == 66
        && other_tokens[2].byte == 67 && other_tokens[3].byte == 68 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
