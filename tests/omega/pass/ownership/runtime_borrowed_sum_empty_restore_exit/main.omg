use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) { token.value = 0; }
data Choice { case Empty; case Value(token: Token); }
data Holder { marker: u64; choice: Choice; sibling: Token; }

machine populate(choice: &mut Choice) -> u64 {
    choice = Choice::Value { token: Token { value: 42 } };
    5
}

machine erase(choice: &mut Choice) {
    choice = Choice::Empty {};
}

machine read_and_drop(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}

machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Empty {} -> 42
        Choice::Value { token } -> read_and_drop(token)
    }
}

machine main() crashes Trap {
    let mut empty: Holder = Holder {
        marker: 19,
        choice: Choice::Empty {},
        sibling: Token { value: 20 },
    };
    let mut full: Holder = Holder {
        marker: 23,
        choice: Choice::Value { token: Token { value: 7 } },
        sibling: Token { value: 22 },
    };
    let first_sibling: u64 = read_and_drop(empty.sibling);
    let populated: u64 = populate(&mut empty.choice) + 1;
    erase(&mut full.choice);
    let first: u64 = consume(empty.choice);
    let second: u64 = consume(full.choice);
    let second_sibling: u64 = read_and_drop(full.sibling);
    transition populated == 6 && first == 42 && second == 42 && first_sibling == 20 && second_sibling == 22 && empty.marker == 19 && full.marker == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
