// Expected exit: 0. A borrowed qualified case payload remains the source of
// a structural-result call, not an invented parameter or a copied owner.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
data Token [linear] { value: u64; }
domain Token::Issued established by issue;
data Slot { case Empty; case Held(token: Token in Issued); }
data Inventory { slots: [Slot; 2]; }
data Snapshot { case Unavailable; case Ready(values: [u64; 2]); }
machine issue(value: u64) -> Token in Issued { Token { value: value } }
machine snapshot<Role>(token: &Token in Issued) -> Snapshot {
    Snapshot::Ready { values: [token.value, token.value] }
}
machine read(inventory: &Inventory, position: u64) -> Snapshot
requires position < 2
{
    transition &inventory.slots[position] {
        Slot::Empty -> Snapshot::Unavailable
        Slot::Held { token } -> (snapshot<u64>(token))
    }
}
machine amount(snapshot: Snapshot) -> u64 {
    transition snapshot {
        Snapshot::Unavailable -> 0
        Snapshot::Ready { values } -> (values[0])
    }
}
machine main() reaches ProcessExit {
    let inventory: Inventory = Inventory {
        slots: [Slot::Held { token: issue(73) }, Slot::Empty]
    };
    let held: u64 = amount(read(&inventory, 0));
    let empty: u64 = amount(read(&inventory, 1));
    transition held == 73 && empty == 0 {
        true -> finish(inventory, 0)
        _ -> finish(inventory, 1)
    }
    machine finish(inventory: Inventory, status: i32) { ProcessExit::exit_process(status); }
}
