// Expected exit: 0
use borrowed_partition_support::main;
use omega::language::core::drop;

machine consume(strategy: Strategy, first: Region in Owned) -> bool
requires first.length == 16 && strategy.tail.length == 32 && strategy.remaining == 32
{
    let correct: bool = first.length == 16 && strategy.tail.length == 32 && strategy.remaining == 32;
    drop(first);
    drop(strategy.tail);
    correct
}
machine choose(strategy: &mut Strategy, select: bool) -> Region in Owned
requires strategy.tail.length == 48
ensures result.length == 16, strategy.tail.length == 32, strategy.remaining == 32
{
    let first: Region in Owned = match select {
        true -> carve(strategy, 48, 16),
        false -> carve(strategy, 48, 16),
    };
    first
}
machine exercise(select: bool) -> bool {
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let first: Region in Owned = choose(&mut strategy, select);
    consume(strategy, first)
}
machine main() crashes Trap {
    let correct: bool = exercise(true) && exercise(false);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
