// A `&mut` loan may retarget a whole sum: `flip(&mut main.switch)` assigns
// a different case through the loan — the callee replaces the caller's
// stored value, discriminant and payload together.
data Switch {
    case Off;
    case On(level: u64);
}

data Main {
    switch: Switch;
    answer: u64;
}

machine Main::flip(switch: &mut Switch) {
    switch = Switch::On { level: 5 };
}

machine Main::main(main: &mut Main) {
    main.switch = Switch::Off;
    Main::flip(&mut main.switch);
    transition main.switch {
        Switch::On { level } -> bright(main, level)
        _ -> dark(main)
    }

    machine bright(main: &mut Main, level: u64) {
        transition level {
            5 -> good(main)
            _ -> dim(main)
        }
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine dim(main: &mut Main) { main.answer = 71; }
    machine dark(main: &mut Main) { main.answer = 72; }
}
