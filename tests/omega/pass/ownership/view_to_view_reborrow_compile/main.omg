// A stored `&` view feeds a second binding: `let again: &u64 = peek`
// copies the view's name — shared loans may be re-referenced through
// locals without taking the member's address again.
data Main { score: u64; }

machine Main::read(score: &u64) -> u64 {
    score
}

machine Main::main(main: &mut Main) {
    main.score = 11;
    let peek: &u64 = &main.score;
    let again: &u64 = peek;
    let seen: u64 = Main::read(again);
}
