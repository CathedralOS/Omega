// `main.inventory = move replacement;` — an owned value explicitly
// spelled as moved into another location; the ownership lane still
// infers the actual move from value flow.
data Inventory {
    slots: i32;
}
data Main {
    inventory: Inventory;
}
machine Main::main(main: &mut Main) {
    main.inventory.slots = 41;
    let replacement: Inventory = main.inventory;
    main.inventory = move replacement;
    transition main.inventory.slots == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
