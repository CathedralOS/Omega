// A `&mut` loan may name a whole array member: `zero(&mut main.cells)`
// lends every element — the callee indexes the loaned array and writes
// each slot through the single view.
data Main {
    cells: [u64; 3];
    answer: u64;
}

machine Main::zero(cells: &mut [u64; 3]) {
    cells[0] = 0;
    cells[2] = 0;
}

machine Main::main(main: &mut Main) {
    main.cells = [5, 6, 7];
    Main::zero(&mut main.cells);
    transition main.cells[0] == 0
        && main.cells[2] == 0
    {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
