// Expected exit: 0.
// The first selected endpoint still contains 11 after operand evaluation.
use omega_language_std::console;
data Cell { value: u64 in Wrapping; }
data Held<'source> { target: &'source mut Cell; }
machine observe(target: &Cell, replaced: bool) -> u64 in Wrapping {
    target.value
}
machine replace<'source>(slot: &mut Held<'source>, next: &'source mut Cell) -> bool {
    slot = Held { target: next };
    true
}
machine evaluated_value() -> u64 in Wrapping {
    let mut first: Cell = Cell { value: 11 };
    let mut second: Cell = Cell { value: 22 };
    let mut selected: Held = Held { target: &mut first };
    observe(selected.target, replace(&mut selected, &mut second))
}


machine main() reaches Console {
    let observed: u64 in Wrapping = evaluated_value();
    transition observed == 11 {
        true -> done()
        false -> wrong()
    }
    machine done() { Console::exit_process(0); }
    machine wrong() { Console::exit_process(71); }
}
