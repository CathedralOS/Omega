use omega_language_std::console;
use omega::language::core::binding;

data Inventory { slots: i32; }

machine Inventory::bump(inventory: Inventory) -> Inventory {
    Inventory { slots: ((inventory.slots as i32 in Wrapping) + 1) as i32 }
}

data Main {
    console: Binding<Console>;
    inventory: Inventory;
}

machine Main::main(main: &mut Main) reaches Console {
    main.inventory.slots = 41;
    let taken: Inventory = main.inventory;
    // `bump` takes its subject BY VALUE, so the call consumes `taken` and
    // carries no `&`; the result restores the owner the move emptied.
    main.inventory = move Inventory::bump(taken);
    main.console.exit_process(main.inventory.slots);
}
