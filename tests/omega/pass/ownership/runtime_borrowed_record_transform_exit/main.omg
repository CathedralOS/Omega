use omega_language_std::console;
use omega::language::core::binding;

data Inventory { slots: i32; }

machine Inventory::bump(self) -> Inventory {
    Inventory { slots: ((self.slots as i32 in Wrapping) + 1) as i32 }
}

data Main {
    console: Binding<Console>;
    inventory: Inventory;
}

machine Main::main(&mut self) reaches Console {
    self.inventory.slots = 41;
    let taken: Inventory = self.inventory;
    self.inventory = move taken.bump();
    self.console.exit_process(self.inventory.slots);
}
