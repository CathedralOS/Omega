// A `&mut` loan may project through a machine's own parameter:
// `&mut m.outer.inner.count` lends the nested leaf inside the caller-owned
// record — the loan crosses two member levels of a `&mut` parameter.
data Inner { count: u64; }

data Outer { inner: Inner; }

data Main {
    outer: Outer;
    answer: u64;
}

machine Main::bump(counter: &mut u64) {
    counter = 8;
}

machine Main::main(main: &mut Main) {
    main.outer = Outer { inner: Inner { count: 1 } };
    Main::bump(&mut main.outer.inner.count);
    transition main.outer.inner.count {
        8 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
