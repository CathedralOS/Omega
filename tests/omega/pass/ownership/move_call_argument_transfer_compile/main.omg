// `move` transfers the claim straight into a call argument: `spend(move
// token)` hands the callee the parameter's claim and retires the caller's
// binding at the call site. Two locals move through two calls in sequence.
data Token { raw: u64; }

data Main {
    answer: u64;
    spare: u64;
}

machine Main::spend(token: Token) -> u64 {
    token.raw
}

machine Main::main(main: &mut Main) {
    let token: Token = Token { raw: 40 };
    main.answer = Main::spend(move token);
    let spare: Token = Token { raw: 2 };
    main.spare = Main::spend(move spare);
}
