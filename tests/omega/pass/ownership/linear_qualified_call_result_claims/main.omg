// Qualification and linear custody survive returned values, construction,
// projection and reseating. Field reads lend the current owner without
// forgetting its qualification or consuming the claim acknowledged later.
use omega::language::core::drop;

public data Receipt [linear] {
    code: i32;
    first: u64;
    second: u64;
    third: u64;
    fourth: u64;
}
machine Receipt::drop(receipt: &mut Receipt) {}
public domain Receipt::Issued;
domain Receipt::Extra(receipt) requires receipt.code >= 0;
domain Receipt::ExtraIssued = Issued & Extra;

public boundary trait Acknowledgement {
    machine acknowledge(receipt: Receipt in Receipt::Issued) reaches crashes Trap;
}
Acknowledged satisfies Acknowledgement {
    machine acknowledge(receipt: Receipt in Receipt::Issued) crashes Trap {
        verify_payload(&receipt);
        drop(receipt);
    }
}

data Slot { receipt: Receipt in Receipt::Issued; }
data ReceiptBox { receipts: [Receipt in Receipt::Issued; 2]; }
data SlotChoice { case Empty; case Present(slot: Slot); }
data Counter [copy] { code: i32; }
domain Counter::Ready;
domain Counter::ReadyAlias = Ready;
data Holder<T> { value: T; }

machine untouched() {}

machine is_zero(counter: &Counter in Counter::Ready) -> bool {
    counter.code == 0
}

// A field read through a qualified borrow observes the membership's bytes
// without consuming or establishing it, whatever the loan's permission and
// whether the carrier is an entry formal or a later state arrival.
machine is_zero_exclusive(counter: &mut Counter in Counter::Ready) -> bool {
    counter.code == 0
}

machine is_zero_arrival(counter: &Counter in Counter::Ready) -> bool {
    transition { _ -> arrived(counter) }
    machine arrived(current: &Counter in Counter::Ready) -> bool { current.code == 0 }
}

machine pass(receipt: Receipt in Receipt::Issued) -> Receipt in Receipt::Issued { receipt }
machine issue(code: i32) -> Receipt in Receipt::Issued {
    let issued: Receipt in Receipt::Issued = Receipt {
        code: code, first: 11, second: 22, third: 33, fourth: 44
    };
    issued
}

machine forward(receipt: Receipt in Receipt::Issued) -> Receipt in Receipt::Issued {
    transition { _ -> returning(receipt) }
    machine returning(held: Receipt in Receipt::Issued) -> Receipt in Receipt::Issued { held }
}

machine make_slot(code: i32) -> Slot { Slot { receipt: pass(issue(code)) } }

// No preceding read forces a home: the store itself must preserve a direct
// register-carried owner's bytes, and return must observe the current home.
machine replace_counter(mut holder: Holder<Counter>, counter: Counter) -> Holder<Counter> {
    holder.value = counter;
    holder
}

machine wrap_counter(counter: Counter in Counter::Ready)
    -> Holder<Counter in Counter::Ready> {
    Holder { value: counter }
}

// The first unconditional arm is the completion even when authored storage
// retains a later unreachable arm. Value and named-call exits carry the same
// owned result without inventing a callee-template claim in the caller.
machine value_slot(code: i32) -> Slot {
    transition { _ -> (make_slot(code)) _ -> (make_slot(0)) }
}
machine terminal_slot(code: i32) -> Slot {
    transition { _ -> make_slot(code) _ -> make_slot(0) }
}

machine replace_owned(mut slot: Slot, replacement: Receipt in Receipt::Issued) -> Slot
    reaches Acknowledgement crashes Trap {
    let original_code: i32 = slot.receipt.code;
    let previous: Receipt in Receipt::Issued = slot.receipt;
    slot.receipt = replacement;
    verify(previous.code == original_code);
    Acknowledgement::acknowledge(previous);
    slot
}

machine replace_local(code: i32, replacement: Receipt in Receipt::Issued) -> Slot
    reaches Acknowledgement crashes Trap {
    let mut slot: Slot = make_slot(code);
    let previous: Receipt in Receipt::Issued = slot.receipt;
    slot.receipt = replacement;
    verify(previous.code == code);
    Acknowledgement::acknowledge(previous);
    let current: Slot = slot;
    current
}

machine replace_constructed(code: i32, replacement: Receipt in Receipt::Issued) -> Holder<Slot>
    reaches Acknowledgement crashes Trap {
    let mut slot: Slot = make_slot(code);
    let previous: Receipt in Receipt::Issued = slot.receipt;
    slot.receipt = replacement;
    verify(previous.code == code);
    Acknowledgement::acknowledge(previous);
    Holder { value: slot }
}

machine acknowledge_choice(choice: SlotChoice, expected: i32)
    reaches Acknowledgement crashes Trap {
    transition choice {
        SlotChoice::Present { slot } -> acknowledge_slot(slot, expected)
        SlotChoice::Empty {} -> empty()
    }
    machine empty() {}
}

machine acknowledge_slot(slot: Slot, expected: i32) reaches Acknowledgement crashes Trap {
    verify(slot.receipt.code == expected);
    Acknowledgement::acknowledge(slot.receipt);
}

machine acknowledge_holder(holder: Holder<Slot>, expected: i32)
    reaches Acknowledgement crashes Trap {
    verify(holder.value.receipt.code == expected);
    Acknowledgement::acknowledge(holder.value.receipt);
}

machine guard_value(holder: Holder<Slot>, expected: i32) -> bool
    reaches Acknowledgement crashes Trap {
    let code: i32 = holder.value.receipt.code;
    Acknowledgement::acknowledge(holder.value.receipt);
    code == expected
}

machine guard_constructed(mut slot: Slot, replacement: Receipt in Receipt::Issued)
    reaches Acknowledgement crashes Trap {
    let expected: i32 = replacement.code;
    let previous: Receipt in Receipt::Issued = slot.receipt;
    slot.receipt = replacement;
    Acknowledgement::acknowledge(previous);
    transition guard_value(Holder { value: slot }, expected) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine branch_constructed(first: bool, slot: Slot) -> Holder<Slot> {
    transition first {
        true -> Holder { value: slot }
        _ -> Holder { value: slot }
    }
}

machine replace(slot: &mut Slot, replacement: Receipt in Receipt::Issued)
    reaches Acknowledgement crashes Trap {
    let previous: Receipt in Receipt::Issued = slot.receipt;
    slot.receipt = replacement;
    Acknowledgement::acknowledge(previous);
}

machine verify(correct: bool) crashes Trap {
    transition correct { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}

machine verify_payload(receipt: &Receipt in Receipt::Issued) crashes Trap {
    verify(receipt.first == 11);
    verify(receipt.second == 22);
    verify(receipt.third == 33);
    verify(receipt.fourth == 44);
}

machine main() reaches Acknowledgement crashes Trap {
    let zeroed: Counter;
    let vacuous_zero: Counter in Counter::ReadyAlias;
    verify(vacuous_zero.code == 0);
    let counter: Counter in Counter::Ready = Counter { code: 0 };
    verify(zeroed.code == 0 && is_zero(&counter));
    let mut exclusive: Counter in Counter::Ready = Counter { code: 0 };
    verify(is_zero_exclusive(&mut exclusive));
    verify(is_zero_arrival(&counter));
    let omitted: Counter in Counter::ReadyAlias = Counter {};
    verify(is_zero(&omitted));
    let holder: Holder<Counter in Counter::Ready> = Holder { value: counter };
    verify(holder.value.code == 0);
    let repaired_counter: Holder<Counter> = replace_counter(
        Holder { value: Counter { code: 1 } }, Counter { code: 42 }
    );
    verify(repaired_counter.value.code == 42);
    verify(is_zero(&holder.value));
    let wrapped: Holder<Counter in Counter::Ready> = wrap_counter(counter);
    verify(is_zero(&wrapped.value));
    untouched();
    verify(holder.value.code == 0);
    let fresh: Receipt in Receipt::Issued = Receipt {
        code: 6, first: 11, second: 22, third: 33, fourth: 44
    };
    let passed: Receipt in Receipt::Issued = forward(pass(fresh));
    verify(passed.code == 6);
    Acknowledgement::acknowledge(passed);
    let mut slot: Slot = make_slot(1);
    verify(slot.receipt.code == 1);
    let vacated: Receipt in Receipt::Issued = slot.receipt;
    verify(vacated.code == 1);
    Acknowledgement::acknowledge(vacated);
    slot.receipt = issue(2);
    verify(slot.receipt.code == 2);
    let refilled: Receipt in Receipt::Issued = slot.receipt;
    verify(refilled.code == 2);
    Acknowledgement::acknowledge(refilled);
    slot.receipt = issue(3);
    replace(&mut slot, issue(4));
    verify(slot.receipt.code == 4);
    Acknowledgement::acknowledge(slot.receipt);
    let stronger: Receipt in Receipt::ExtraIssued = Receipt {
        code: 5, first: 11, second: 22, third: 33, fourth: 44
    };
    let mut stronger_slot: Slot = Slot { receipt: stronger };
    replace(&mut stronger_slot, issue(6));
    let current_slot: Slot = stronger_slot;
    verify(current_slot.receipt.code == 6);
    Acknowledgement::acknowledge(current_slot.receipt);
    let repaired: Slot = replace_owned(make_slot(7), issue(8));
    verify(repaired.receipt.code == 8);
    Acknowledgement::acknowledge(repaired.receipt);
    let repaired_local: Slot = replace_local(9, issue(10));
    verify(repaired_local.receipt.code == 10);
    Acknowledgement::acknowledge(repaired_local.receipt);
    let value_returned: Slot = value_slot(11);
    verify(value_returned.receipt.code == 11);
    Acknowledgement::acknowledge(value_returned.receipt);
    let terminal_returned: Slot = terminal_slot(12);
    verify(terminal_returned.receipt.code == 12);
    Acknowledgement::acknowledge(terminal_returned.receipt);
    // Each element's hook moves with that whole element. The array container
    // owes no nominal hook after both elements have left its plain owner.
    let boxed: ReceiptBox = ReceiptBox { receipts: [issue(13), issue(14)] };
    let first: Receipt in Receipt::Issued = boxed.receipts[0];
    let second: Receipt in Receipt::Issued = boxed.receipts[1];
    Acknowledgement::acknowledge(first);
    Acknowledgement::acknowledge(second);
    let after_box: Slot = make_slot(15);
    verify(after_box.receipt.code == 15);
    Acknowledgement::acknowledge(after_box.receipt);
    let constructed: Holder<Slot> = replace_constructed(16, issue(17));
    verify(constructed.value.receipt.code == 17);
    Acknowledgement::acknowledge(constructed.value.receipt);
    let mut array_source: Slot = make_slot(18);
    let old_array: Receipt in Receipt::Issued = array_source.receipt;
    array_source.receipt = issue(19);
    Acknowledgement::acknowledge(old_array);
    let array: [Slot; 2] = [array_source, make_slot(20)];
    verify(array[0].receipt.code == 19 && array[1].receipt.code == 20);
    Acknowledgement::acknowledge(array[0].receipt);
    Acknowledgement::acknowledge(array[1].receipt);
    let mut case_source: Slot = make_slot(21);
    let old_case: Receipt in Receipt::Issued = case_source.receipt;
    case_source.receipt = issue(22);
    Acknowledgement::acknowledge(old_case);
    acknowledge_choice(SlotChoice::Present { slot: case_source }, 22);
    guard_constructed(make_slot(23), issue(24));
    acknowledge_holder(branch_constructed(true, make_slot(25)), 25);
    acknowledge_holder(branch_constructed(false, make_slot(26)), 26);
}
