// `move` may name a record member: `let held = move holder.token` moves the
// field's claim out of `holder` — the record's other members stay live and
// the emptied slot may be refilled before the next read.
data Token { raw: u64; }

data Holder {
    token: Token;
    tag: u64;
}

data Main { holder: Holder; }

machine Main::main(main: &mut Main) {
    main.holder = Holder { token: Token { raw: 40 }, tag: 7 };
    let held: Token = move main.holder.token;
    let tag: u64 = main.holder.tag;
    main.holder.token = Token { raw: 1 };
}
