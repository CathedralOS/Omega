// Expected exit: 0.
// The first selected endpoint still contains 11 after operand evaluation.
use omega_language_std::console;
data Cell [copy] { value: u64 in Wrapping; }
data Held<'source> [copy] { target: &'source [Cell; 1]; }
machine observe(value: Cell) -> u64 in Wrapping { value.value }
machine replace<'source>(slot: &mut Held<'source>, next: &'source [Cell; 1]) -> u64
ensures result == 0 {
    slot = Held { target: next };
    0
}
machine evaluated_value() -> u64 in Wrapping {
    let first: [Cell; 1] = [Cell { value: 11 }];
    let second: [Cell; 1] = [Cell { value: 22 }];
    let mut selected: Held = Held { target: &first };
    observe(selected.target[0])
}


machine main() reaches Console {
    let observed: u64 in Wrapping = evaluated_value();
    transition observed == 11 {
        true -> done()
        false -> wrong()
    }
    machine done() { Console::exit_process(0); }
    machine wrong() { Console::exit_process(71); }
}
