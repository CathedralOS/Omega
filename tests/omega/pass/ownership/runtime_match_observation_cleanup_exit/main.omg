// Completed observations dispose their exact anonymous residual after the body.
// Expected exit: 0
use omega::language::core::drop;

data Counter { value: u32 in Wrapping; }
data Note<'storage> { counter: &'storage mut Counter; value: i32; }
data Answer [copy] { value: i32; }
data Receipt [linear] { value: i32; }
data Bundle<'storage> { receipt: Receipt; note: Note<'storage>; }

machine append(counter: &mut Counter, digit: u32 in Wrapping) -> bool {
    counter.value = counter.value * 10 + digit;
    true
}
machine mark(counter: &mut Counter) -> i32 {
    _ = append(counter, 3);
    41
}
machine Note::drop(note: &mut Note) { _ = append(note.counter, 4); }
machine Receipt::drop(receipt: &mut Receipt) {}
machine issue<'storage>(counter: &'storage mut Counter) -> Note<'storage> {
    Note { counter: counter, value: 41 }
}
machine issue_bundle<'storage>(counter: &'storage mut Counter) -> Bundle<'storage> {
    Bundle { receipt: Receipt { value: 41 }, note: issue(counter) }
}
machine consume(receipt: Receipt, counter: &mut Counter) -> i32 {
    _ = append(counter, 8);
    let value: i32 = receipt.value;
    drop(receipt);
    value
}
machine scalar_result() -> bool {
    let mut counter: Counter = Counter { value: 0 };
    let selected: bool = match issue(&mut counter) {
        Note { counter, value: 41 } if append(counter, 2) -> append(counter, 3)
        _ -> false
    };
    selected && (counter.value as u32) == 234
}
machine structural_result() -> bool {
    let mut counter: Counter = Counter { value: 0 };
    let selected: Answer = match issue(&mut counter) {
        Note { counter, value: 41 } -> Answer { value: mark(counter) }
        _ -> Answer { value: 0 }
    };
    selected.value == 41 && (counter.value as u32) == 34
}
machine linear_result() -> bool {
    let mut counter: Counter = Counter { value: 0 };
    let receipt: Receipt = match issue_bundle(&mut counter) {
        Bundle { receipt, note as _ } -> receipt
    };
    let value: i32 = consume(receipt, &mut counter);
    value == 41 && (counter.value as u32) == 48
}
machine main() crashes Trap {
    transition scalar_result() && structural_result() && linear_result() {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
