// Expected exit: 0
// Internal arrival: outgoing argument calls finish, departed storage is
// cleaned, then the destination body executes.
data Counter { value: u64; }
data Cleanup { counter: &mut Counter; }
data Wrapper { cleanup: Cleanup; }

machine Cleanup::drop(cleanup: &mut Cleanup) {
    cleanup.counter.value =
        ((cleanup.counter.value as u64 in Wrapping) + 10) as u64;
}

machine prepare(counter: &mut Counter) -> u64 {
    counter.value = 7;
    counter.value
}

machine internal(counter: &mut Counter) -> u64 {
    let cleanup: Cleanup = Cleanup { counter: counter };
    // The cleanup record holds the live exclusive loan until departure.
    // Argument evaluation uses that child, not its suspended parent.
    transition { _ -> entered(prepare(cleanup.counter), counter) }
    machine entered(captured: u64, counter: &mut Counter) -> u64 {
        let arrival: u64 = counter.value;
        counter.value = 29;
        transition captured == 7 {
            true -> arrival
            _ -> 99
        }
    }
}

machine nested(counter: &mut Counter, select_first: bool) -> u64 {
    let wrapper: Wrapper = Wrapper { cleanup: Cleanup { counter: counter } };
    transition select_first {
        true -> entered(prepare(wrapper.cleanup.counter), counter)
        _ -> entered(prepare(wrapper.cleanup.counter), counter)
    }
    machine entered(captured: u64, counter: &mut Counter) -> u64 {
        let arrival: u64 = counter.value;
        counter.value = 29;
        transition captured == 7 {
            true -> arrival
            _ -> 99
        }
    }
}

machine main() crashes Trap {
    let mut first: Counter = Counter { value: 0 };
    let internal_arrival: u64 = internal(&mut first);
    let mut second: Counter = Counter { value: 0 };
    let nested_target_arrival: u64 = nested(&mut second, true);
    let mut third: Counter = Counter { value: 0 };
    let nested_continuation_arrival: u64 = nested(&mut third, false);
    transition internal_arrival == 17 && first.value == 29
        && nested_target_arrival == 17 && second.value == 29
        && nested_continuation_arrival == 17 && third.value == 29 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
