use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Choice { case Success(token: Token); case Failure(token: Token); }
data Holder { marker: u64; choice: Choice; }

machine identity(choice: Choice) -> Choice { choice }

machine repair(choice: &mut Choice) {
    let detached: Choice = choice;
    choice = identity(detached);
}

machine read_and_drop(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}

machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Success { token } -> read_and_drop(token)
        Choice::Failure { token } -> read_and_drop(token)
    }
}

machine main() crashes Trap {
    let mut success: Holder = Holder {
        marker: 19,
        choice: Choice::Success { token: Token { value: 20 } },
    };
    let mut failure: Holder = Holder {
        marker: 23,
        choice: Choice::Failure { token: Token { value: 22 } },
    };
    repair(&mut success.choice);
    repair(&mut failure.choice);
    let first: u64 = consume(success.choice);
    let second: u64 = consume(failure.choice);
    transition first == 20 && second == 22 && success.marker == 19 && failure.marker == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
