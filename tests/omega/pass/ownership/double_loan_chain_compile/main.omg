// Consecutive `&mut` loans lend the same claim twice in a row: `fill` then
// `clear` each borrow `main.slot`, each loan ends at its call's return, and
// the member reads whole afterward.
data Main { slot: u64; }

machine Main::fill(cell: &mut u64) {
    cell = 40;
}

machine Main::clear(cell: &mut u64) {
    cell = 0;
}

machine Main::main(main: &mut Main) {
    main.slot = 1;
    Main::fill(&mut main.slot);
    Main::clear(&mut main.slot);
    let done: u64 = main.slot;
}
