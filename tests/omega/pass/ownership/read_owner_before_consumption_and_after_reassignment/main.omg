// Reads through an owner are legal while it holds an established value: a
// scalar snapshot copied out before the owner is consumed stays usable after
// the transfer, and assigning a whole replacement re-establishes the owner so
// later reads through it observe the new value. The companion fail fixtures
// `ownership/read_through_{dropped,consumed}_owner_rejected` read the owner
// between those two points instead.

use omega::language::core::drop;

data Guard {
    handle: i32;
}

machine Guard::drop(guard: &mut Guard) {
}

machine consume(value: Guard) {
}

data Main {}

machine Main::main() -> i32 {
    let mut g: Guard = Guard { handle: 7 };
    let snapshot: i32 = g.handle;
    drop(g);
    g = Guard { handle: snapshot };
    let restored: i32 = g.handle;
    consume(g);
    restored
}
