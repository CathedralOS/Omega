// Expected exit: 0
// A reconstructed aggregate retains mutually exclusive claim paths from a
// completed sum result, alongside its unconditional sibling claims.
use omega::language::core::drop;
data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token) {}
machine retire(token: Token) -> u64 {
    let value: u64 = token.value;
    drop(token);
    value
}
data Choice { case Left(token: Token); case Right(token: Token); }
data Inner { choice: Choice; neighbor: Token; }
data Outer { prefix: Token; inner: Inner; }
machine choose(left: bool) -> Choice {
    transition left {
        true -> Choice::Left { token: Token { value: 41 } }
        false -> Choice::Right { token: Token { value: 73 } }
    }
}
machine make(left: bool) -> Outer {
    let choice: Choice = choose(left);
    Outer { prefix: Token { value: 17 }, inner: Inner {
        choice: choice, neighbor: Token { value: 29 }
    } }
}
machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Left { token } -> retire(token)
        Choice::Right { token } -> retire(token)
    }
}
machine check(left: bool, expected: u64) -> bool {
    let value: Outer = make(left);
    let prefix: u64 = retire(value.prefix);
    let neighbor: u64 = retire(value.inner.neighbor);
    let selected: u64 = consume(value.inner.choice);
    prefix == 17 && neighbor == 29 && selected == expected
}
machine main() crashes Trap {
    let left: bool = check(true, 41);
    let right: bool = check(false, 73);
    transition left && right { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
