// A `&` view may name a domain-qualified member: `peek(&main.pair.n)`
// lends read access to the `u64 in Tiny` slot — shared loans preserve
// the field's proof, unlike `&mut` loans whose opaque writes leave the
// domain unprovable at the record boundary.
domain u64::Tiny
requires
    self <= 4;

data Pair {
    n: u64 in Tiny;
    tag: u64;
}

machine Main::peek(n: &u64) -> u64 {
    n
}

data Main { pair: Pair; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { n: 3, tag: 7 };
    let seen: u64 = Main::peek(&main.pair.n);
}
