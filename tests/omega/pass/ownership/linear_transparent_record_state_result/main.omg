// A path-aligned state result maps each transparent-record claim from the
// callee's outgoing frontier to the caller's receiving frontier independently.
use omega_language_std::console;

data Receipt [linear] {
    code: i32;
}

machine Receipt::ack(self) {}

data Pair {
    left: Receipt;
    right: Receipt;
}

data Main { console: Console; }

machine Main::issue(&mut self) -> Pair {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    let pair: Pair = Pair { left: left, right: right };
    transition { _ -> pair }
}

machine Main::main(&mut self) {
    let returned: Pair = self.issue();
    let left: Receipt = returned.left;
    let right: Receipt = returned.right;
    Receipt::ack(left);
    Receipt::ack(right);
    self.console.exit_process(0);
}
