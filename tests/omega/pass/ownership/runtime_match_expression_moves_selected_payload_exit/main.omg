// Expected exit: 0
// A match expression that moves the selected case's only linear payload
// leaves no residual for the subject's whole-value death: its candidate
// cleanup is skipped, the moved token is disposed once by its new owner, and
// each arm yields its own payload (5 for Success, 6 for Failure).
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Outcome { case Success(token: Token); case Failure(token: Token); }
machine make(succeed: bool) -> Outcome {
    transition succeed {
        true -> Outcome::Success { token: Token { value: 5 } }
        _ -> Outcome::Failure { token: Token { value: 6 } }
    }
}
machine unwrap(succeed: bool) -> u64 {
    let first: Outcome = make(succeed);
    let token: Token = match first {
        Outcome::Success { token } -> token
        Outcome::Failure { token } -> token
    };
    let value: u64 = token.value;
    drop(token);
    value
}
machine main() crashes Trap {
    let success: u64 = unwrap(true);
    let failure: u64 = unwrap(false);
    transition success == 5 && failure == 6 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
