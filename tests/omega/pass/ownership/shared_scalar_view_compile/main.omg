// A `&` loan may name a scalar member: `&main.score` lends a read-only u64
// view — the callee reads through it while the caller's member stays live,
// and a second shared view of the same member coexists.
data Main { score: u64; }

machine Main::read(score: &u64) -> u64 {
    score
}

machine Main::main(main: &mut Main) {
    main.score = 42;
    let seen: u64 = Main::read(&main.score);
    let again: &u64 = &main.score;
    let copied: u64 = again;
}
