// Expected exit: 0
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Pair { left: Token; right: Token; }
data Wrapped { pair: Pair; }
machine select_pair(first: Token, second: Token, selected: bool) -> Pair {
    let pair: Pair = match selected {
        true -> Pair { left: first, right: second },
        false -> Pair { left: second, right: first },
    };
    pair
}
machine wrap_pair(first: Token, second: Token, selected: bool) -> Wrapped {
    let pair: Pair = select_pair(first, second, selected);
    Wrapped { pair: pair }
}
machine exercise_return(selected: bool) crashes Trap {
    let wrapped: Wrapped = wrap_pair(Token { value: 17 }, Token { value: 29 }, selected);
    let correct: bool = match selected {
        true -> wrapped.pair.left.value == 17 && wrapped.pair.right.value == 29,
        false -> wrapped.pair.left.value == 29 && wrapped.pair.right.value == 17,
    };
    let { pair } = wrapped;
    let { left, right } = pair;
    drop(left);
    drop(right);
    transition correct { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exercise(selected: bool) crashes Trap {
    let first: Token = Token { value: 17 };
    let second: Token = Token { value: 29 };
    let pair: Pair = match selected {
        true -> Pair { left: first, right: second },
        false -> Pair { left: second, right: first },
    };
    let correct: bool = match selected {
        true -> pair.left.value == 17 && pair.right.value == 29,
        false -> pair.left.value == 29 && pair.right.value == 17,
    };
    let { left, right } = pair;
    drop(left);
    drop(right);
    transition correct { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    exercise(true);
    exercise(false);
    exercise_return(true);
    exercise_return(false);
}
