// Expected exit: 0
use borrowed_partition_support::main;
use omega::language::core::drop;
data Envelope { strategy: Strategy; marker: u64; }
machine consume(strategy: Strategy, first: Region in Owned) -> bool
requires first.length == 16, strategy.tail.length == 32, strategy.remaining == 32
{
    let correct: bool = first.length == 16 && strategy.tail.length == 32 && strategy.remaining == 32;
    drop(first);
    drop(strategy.tail);
    correct
}
machine exercise(select: bool, inner: bool) -> bool {
    let mut envelope: Envelope = Envelope { strategy: Strategy { tail: issue(), remaining: 48 }, marker: 29 };
    let held: &mut u64 = &mut envelope.marker;
    let first: Region in Owned = match select {
        true -> match inner {
            true -> carve(&mut envelope.strategy, 48, 16),
            false -> carve(&mut envelope.strategy, 48, 16),
        },
        false -> carve(&mut envelope.strategy, 48, 16),
    };
    held = 73;
    let correct: bool = envelope.marker == 73;
    consume(envelope.strategy, first) && correct
}
machine main() crashes Trap {
    let correct: bool = exercise(true, true) && exercise(true, false) && exercise(false, true) && exercise(false, false);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
