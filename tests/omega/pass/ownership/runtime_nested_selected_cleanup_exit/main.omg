// Expected exit: 0. Selected nested transfers and skipped owners each clean up once.
data Ticket { drops: &mut [u64; 1]; value: u64; }
machine Ticket::drop(ticket: &mut Ticket) {
    ticket.drops[0] = ((ticket.drops[0] as u64 in Wrapping) + 1) as u64;
}
machine issue(drops: &mut [u64; 1]) -> Ticket {
    Ticket { drops: drops, value: 73 }
}
machine forward(ticket: Ticket) -> Ticket { ticket }
machine read(ticket: Ticket) -> u64 { ticket.value }
machine selected(choice: bool, drops: &mut [u64; 1]) -> bool {
    let ticket: Ticket = issue(drops);
    choice && read(forward(ticket)) == 73
}
machine main() crashes Trap {
    let mut skipped_drops: [u64; 1] = [0];
    let mut taken_drops: [u64; 1] = [0];
    let skipped: bool = selected(false, &mut skipped_drops);
    let taken: bool = selected(true, &mut taken_drops);
    transition !skipped && taken && skipped_drops[0] == 1 && taken_drops[0] == 1 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
