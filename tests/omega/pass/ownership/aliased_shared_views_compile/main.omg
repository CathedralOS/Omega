// Two `&` views of the SAME member coexist: `first` and `second` both
// name `&main.score` — shared loans alias freely; only the exclusive
// `&mut` form demands disjointness.
data Main { score: u64; }

machine Main::read(score: &u64) -> u64 {
    score
}

machine Main::main(main: &mut Main) {
    main.score = 9;
    let first: &u64 = &main.score;
    let second: &u64 = &main.score;
    let a: u64 = Main::read(first);
    let b: u64 = Main::read(second);
}
