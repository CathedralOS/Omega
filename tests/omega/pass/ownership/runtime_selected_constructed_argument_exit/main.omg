data Held { value: &i32; }
data Wrapped { held: Held; }
machine consume(held: Held) -> i32 { held.value }
machine consume_wrapped(wrapped: Wrapped) -> i32 { consume(wrapped.held) }
machine forward(value: i32) -> i32 { value }
machine selected(value: &i32, choice: i32) -> i32 {
    let held: Held = Held { value: value };
    forward(match choice {
        0 -> forward(consume_wrapped(Wrapped { held: held })),
        consume(held) -> 17,
        _ -> 23,
    })
}
machine main() crashes Trap {
    let value: i32 = 17;
    transition selected(&value, 0) == 17 && selected(&value, 17) == 17 && selected(&value, 23) == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
