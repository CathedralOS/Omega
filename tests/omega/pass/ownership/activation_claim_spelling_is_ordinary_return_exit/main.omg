// Expected exit: 0
// An authored name does not acquire the sealed activation claim's custody.
data ActivationClaim [copy] { value: u64; }

machine retain(value: ActivationClaim) -> ActivationClaim { value }

machine main() crashes Trap {
    let returned: ActivationClaim = retain(ActivationClaim { value: 23u64 });
    transition returned.value == 23u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
