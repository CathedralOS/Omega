domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    return_code: i32;
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("assign");
    self.return_code = 0;
    self.console.exit_process(self.return_code);
}
