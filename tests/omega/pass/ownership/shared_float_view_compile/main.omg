// A `&` view may name a float member: `read(&main.rate)` lends read
// access to the f64 — shared loans work on every scalar width, not just
// integers.
data Main {
    rate: f64;
    answer: u64;
}

machine Main::read(rate: &f64) -> f64 {
    rate
}

machine Main::main(main: &mut Main) {
    main.rate = 2.5;
    let seen: f64 = Main::read(&main.rate);
    transition seen == 2.5 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
