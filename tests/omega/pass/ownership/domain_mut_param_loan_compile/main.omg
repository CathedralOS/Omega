// A `&mut` parameter may itself carry a domain: `fill(cell: &mut u64 in
// Tiny)` declares exclusive access qualified to {0..4} — writes the
// callee makes must stay inside the domain's established range.
domain u64::Tiny(value)
requires
    value <= 4;

machine Main::fill(cell: &mut u64 in Tiny) {
    cell = 4;
}

data Main {
    cell: u64;
    answer: u64;
}

machine Main::main(main: &mut Main) {
    main.cell = 0;
    Main::fill(&mut main.cell);
    transition main.cell {
        4 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
