// Claim-bearing arguments constructed inline at their call. A construction
// passed by value is an anonymous owner: it establishes its claim frontier
// when it completes, and the call receives the completed owner whole. A
// nested construction mints a fresh claim; a moved member's claim continues
// into the construction at its field. `pass` returns its input, so the
// caller's result continues the inline construction's claim. Every value
// reaches the drop-hooked consumer exactly once, including a construction
// handed straight to the generic `drop`. Call-produced children retain their
// claims through nested construction and preserve authored field order;
// nonresident case payloads establish no live claim.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

data Envelope { pair: Pair; }

data Choice { case Empty; case Value(receipt: Receipt); }
data ChoiceEnvelope { choice: Choice; sibling: Receipt; }
data ProjectedChoice { choice: Choice; tag: i32; }

machine pass(receipt: Receipt) -> Receipt {
    receipt
}

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine issue(sequence: &mut i32) -> Receipt {
    let code: i32 = sequence;
    sequence = ((sequence as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let issued: Receipt = Receipt { code: code };
    issued
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine settle(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine settle_order(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = (((left.code as i32 in Wrapping) * (10 as i32 in Wrapping)) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine settle_array(receipts: [Receipt; 2]) -> i32 {
    let first: Receipt = receipts[0];
    let second: Receipt = receipts[1];
    let total: i32 = (((first.code as i32 in Wrapping) * (10 as i32 in Wrapping)) + (second.code as i32 in Wrapping)) as i32;
    drop(first);
    drop(second);
    total
}

machine settle_nested(receipts: [[Receipt; 1]; 2]) -> i32 {
    let second: Receipt = receipts[1][0];
    let first: Receipt = receipts[0][0];
    let total: i32 = (((first.code as i32 in Wrapping) * (10 as i32 in Wrapping)) + (second.code as i32 in Wrapping)) as i32;
    drop(second);
    drop(first);
    total
}

machine settle_pairs(pairs: [Pair; 1]) -> i32 {
    let pair: Pair = pairs[0];
    settle_order(pair)
}

machine open(envelope: Envelope) -> i32 {
    settle(envelope.pair)
}

machine choose(present: bool) -> Choice {
    transition present {
        true -> Choice::Value { receipt: make(12) }
        false -> Choice::Empty {}
    }
}

machine consume_choice(choice: Choice) -> i32 {
    transition choice {
        Choice::Empty {} -> 0
        Choice::Value { receipt } -> consume(receipt)
    }
}

machine enclose_choice(present: bool) -> ProjectedChoice {
    ProjectedChoice { choice: choose(present), tag: 3 }
}

machine open_choice(envelope: ChoiceEnvelope) -> i32 {
    let sibling: i32 = consume(envelope.sibling);
    let chosen: i32 = consume_choice(envelope.choice);
    ((sibling as i32 in Wrapping) + (chosen as i32 in Wrapping)) as i32
}

machine verify(settled: bool) crashes Trap {
    transition settled {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    let moved: i32 = settle(Pair { left: left, right: right });
    let fresh: i32 = settle(Pair { left: Receipt { code: 3 }, right: Receipt { code: 4 } });
    let direct: i32 = consume(Receipt { code: 5 });
    let passed: Receipt = pass(Receipt { code: 6 });
    let forwarded: i32 = consume(passed);
    let produced: i32 = settle(Pair { left: make(7), right: make(8) });
    let original: Receipt = make(10);
    let nested: i32 = open(Envelope { pair: Pair { left: pass(original), right: make(11) } });
    let mut sequence: i32 = 1;
    let ordered: i32 = settle_order(Pair { right: issue(&mut sequence), left: issue(&mut sequence) });
    let array: i32 = settle_array([make(1), make(2)]);
    let array_order: i32 = settle_array([issue(&mut sequence), issue(&mut sequence)]);
    let nested_array: i32 = settle_nested([[make(1)], [make(2)]]);
    let array_record: i32 = settle_pairs([Pair { left: make(1), right: make(2) }]);
    let absent: i32 = open_choice(ChoiceEnvelope { choice: choose(false), sibling: make(21) });
    let present: i32 = open_choice(ChoiceEnvelope { choice: choose(true), sibling: make(22) });
    let projected_absent: i32 = consume_choice(enclose_choice(false).choice);
    let projected_present: i32 = consume_choice(enclose_choice(true).choice);
    drop(Receipt { code: 9 });
    verify(moved == 3 && fresh == 7 && direct == 5 && forwarded == 6 && produced == 15
        && nested == 21 && ordered == 21 && sequence == 5 && array == 12 && array_order == 34
        && nested_array == 12 && array_record == 12
        && absent == 21 && present == 34
        && projected_absent == 0 && projected_present == 12);
}
