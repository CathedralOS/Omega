// Chapter 2: an owned value may be explicitly spelled as moved into another
// location via `move` (`main.inventory = move replacement;`). The ownership
// lane still infers the actual move from value flow.
use omega_language_std::console;

data Inventory {
    slots: i32;
}

data Main {
    inventory: Inventory;
}

machine Main::main(main: &mut Main) reaches Console {
    main.inventory.slots = 41;
    let replacement: Inventory = main.inventory;
    main.inventory = move replacement;
    Console::exit_process(main.inventory.slots);
}
