// The selector is mutable storage, but its value is unchanged between the
// opening move and repair. Mutation after closing the window creates no debt.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }
machine reset(index: &mut u64) { index = 0; }

machine rotate(tokens: &mut [Token], initial: u64)
requires tokens.len >= 2, initial < 2
{
    let mut at: u64 = initial;
    let mut unrelated: u64 = initial;
    let first: Token = tokens[at];
    reset(&mut unrelated);
    tokens[at] = Token { byte: 19 };
    tokens[1] = first;
    at = 2;
}

machine saved_rotate(tokens: &mut [Token], initial: u64)
requires tokens.len >= 2, initial < 2
{
    let mut at: u64 = initial;
    let saved: u64 = at;
    let copied: u64 = saved;
    let first: Token = tokens[saved];
    reset(&mut at);
    tokens[copied] = Token { byte: 23 };
    tokens[0] = first;
}

machine main() crashes Trap {
    let mut left: [Token; 2] = [Token { byte: 11 }, Token { byte: 7 }];
    let left_view: &mut [Token] = &mut left[..];
    rotate(left_view, 0);
    let mut right: [Token; 2] = [Token { byte: 11 }, Token { byte: 7 }];
    let right_view: &mut [Token] = &mut right[..];
    rotate(right_view, 1);
    let mut saved: [Token; 2] = [Token { byte: 5 }, Token { byte: 13 }];
    let saved_view: &mut [Token] = &mut saved[..];
    saved_rotate(saved_view, 1);
    transition left[0].byte == 19 && left[1].byte == 11
        && right[0].byte == 11 && right[1].byte == 7
        && saved[0].byte == 13 && saved[1].byte == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
