// A boundary-trait requirement consumes a by-value `[linear]` parameter: the
// call edge transfers custody and the requirement discharges the claim —
// `Receipt` selects no `dropped by` cleanup, so no edge cleanup may
// retire it. Binding spellings: `DllImport::ElfVersioned` /
// `DllImport::PeByName` / `DllImport::MachODylibSymbol`.
data Receipt [linear] {
    code: i32;
}
boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}
data ReceiptSink {}
machine main() {
    let receipt: Receipt = Receipt { code: -7 };
    let alias: Receipt = receipt;
    ReceiptAck::ack(alias);
}
