use omega::language::core::external_binding;
// A `boundary requirement` consumes a by-value `[linear]` parameter: the
// call edge transfers custody and the requirement discharges the claim —
// `Receipt` declares no `Receipt::drop` plan, so no edge cleanup may
// retire it. Binding spellings: `DllImport::ElfVersioned` /
// `DllImport::PeByName` / `DllImport::MachODylibSymbol`.
data Receipt [linear] {
    code: i32;
}
boundary requirement Receipt::ack(receipt: Receipt);
data ReceiptSink {}


machine main() {
    let receipt: Receipt = Receipt { code: -7 };
    let alias: Receipt = receipt;
    Receipt::ack(alias);
}
