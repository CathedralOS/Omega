// A `&` loan may name a whole record: `peek(&main.row)` lends read-only
// access to the aggregate — the callee reads members through the view
// while the caller keeps ownership.
data Row {
    cells: [u64; 2];
    tag: u64;
}

data Main { row: Row; }

machine Main::peek(row: &Row) -> u64 {
    row.tag
}

machine Main::main(main: &mut Main) {
    main.row = Row { cells: [1, 2], tag: 7 };
    let seen: u64 = Main::peek(&main.row);
}
