// Claim-bearing values inside a machine with named states. A receipt
// established in the entry state crosses an edge into `holding`, which moves
// it into an inline construction whose other member is fresh, hands a second
// inline construction directly to a consumer, and consumes a local of its own
// inside an arithmetic expression. Every one of those calls is a computed
// operand: its claims cross at the call exactly as a statement call's do.
// The receipt `holding` establishes from the totals crosses a conditional
// edge into one of two states, each of which consumes it. Each state's entry
// claim continues the claim its arriving edge carries.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine settle(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine main() crashes Trap {
    let issued: Receipt = Receipt { code: 1 };
    transition { _ -> holding(issued, 3) }

    machine holding(held: Receipt, extra: i32) {
        let paired: i32 = settle(Pair { left: held, right: Receipt { code: 2 } });
        let direct: i32 = consume(Receipt { code: extra });
        let local: Receipt = Receipt { code: 4 };
        let offset: i32 = ((consume(local) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
        let carried: Receipt = Receipt {
            code: ((paired as i32 in Wrapping) + (direct as i32 in Wrapping) + (offset as i32 in Wrapping)) as i32
        };
        transition paired == 3 {
            true -> finishing(carried)
            _ -> abandoning(carried)
        }
    }

    machine finishing(last: Receipt) {
        let observed: i32 = consume(last);
        transition observed == 11 {
            true -> done()
            _ -> bad()
        }
    }

    machine abandoning(last: Receipt) {
        let observed: i32 = consume(last);
        transition { _ -> bad() }
    }

    machine done() {}
    machine bad() { crash Trap; }
}
