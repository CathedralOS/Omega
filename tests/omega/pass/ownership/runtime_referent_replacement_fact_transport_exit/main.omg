data Child { value: u64; }
data Pair { first: Child; second: u64; }
machine replace(pair: &mut Pair)
ensures pair.first.value == 9, pair.second == 5
{
    let alias: &mut Pair = pair;
    let mut source: u64 = 7;
    // The store installs a Pair, not the alias's reference descriptor.
    alias = Pair { first: Child { value: source + 2 }, second: 5 };
    // The installed child retains its value after the source changes.
    source = 11;
}

machine main() crashes Trap {
    let mut pair: Pair = Pair { first: Child { value: 3 }, second: 4 };
    replace(&mut pair);
    transition pair.first.value == 9 && pair.second == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
