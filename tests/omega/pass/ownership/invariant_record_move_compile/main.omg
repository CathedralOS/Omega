// `move` may take a `data where` record out of a `&mut` member, but the
// hole must be repaired before the state exits: `take(move main.band)`
// then a fresh literal restores the member — custody moves out, the
// record's slot re-admits a new value.
data Band
requires
    a >= 1,
    b >= a,
    b <= 9,
{
    a: u64;
    b: u64;
}

data Main { band: Band; }

machine Main::take(band: Band) -> u64 {
    band.a
}

machine Main::main(main: &mut Main) {
    main.band = Band { a: 3, b: 7 };
    let seen: u64 = Main::take(move main.band);
    main.band = Band { a: 2, b: 4 };
}
