// A `let mut` slot accepts a moved claim by store: `slot = move held`
// — the mut binding's next value comes from a move, then carries into
// the call argument.
data Grant { raw: u64; }

data Main { answer: u64; }

machine Main::claim(g: Grant) -> u64 {
    g.raw
}

machine Main::main(main: &mut Main) {
    let held: Grant = Grant { raw: 70 };
    let mut slot: Grant = Grant { raw: 0 };
    slot = move held;
    main.answer = Main::claim(move slot);
}
