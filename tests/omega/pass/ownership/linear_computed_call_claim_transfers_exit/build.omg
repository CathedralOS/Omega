// Every hosted target selects its exact entry.
machine build(builder: &mut Build) {
    Build::application(builder, "linear_computed_call_claim_transfers_exit");
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, linux_arm64);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, linux_x86_64);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, macos_arm64);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, macos_x86_64);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, windows_x86_64);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, uefi_x86_64);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, cross_platform_cli);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, local_unchecked);
    Build::select_provider<BoundarySettlement, BoundarySettler>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    // Keep the independent optimizer contract and live-frontier checks in
    // the regression, in addition to native and Terminal execution.
    Optimizations::enable(&mut builder.optimizations, Optimization::CopyPropagation);
}
