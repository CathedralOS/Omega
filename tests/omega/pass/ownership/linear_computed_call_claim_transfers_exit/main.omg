// Claim-bearing operands of calls evaluated inside an expression. A call
// that is one operand of arithmetic is a computed call, not a statement
// call; its owned operands still hand their claims over at the call: an
// inline construction, a named local, a construction holding a moved local
// beside a fresh member, and a nested call's anonymous linear result.
use omega::language::core::drop;
data Main { }

pub data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }
data Choice { case Empty; case Value(receipt: Receipt); }
data Sample [copy] { code: i32; }

// A selector owns no data: the selected slot receives the same ordered
// scalar/owned/scalar stream and typed claim paths as a static call.
trait Settlement<T> {
    machine settle(prefix: i32, value: T, suffix: i32) -> i32;
}

pub boundary trait BoundarySettlement {
    machine settle(prefix: i32, value: Receipt, suffix: i32) -> i32;
}

BoundarySettler satisfies BoundarySettlement { BoundarySettlement::settle = settle_boundary_settler; }
machine settle_boundary_settler(prefix: i32, value: Receipt, suffix: i32) -> i32
satisfies BoundarySettlement::settle
{
    let code: i32 = consume(value);
        (((prefix as i32 in Wrapping) + (code as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
}

Observed satisfies Settlement<Receipt> { Settlement::settle = settle_observed; }
machine settle_observed(prefix: i32, value: Receipt, suffix: i32) -> i32
satisfies Settlement<Receipt>::settle
{
    let code: i32 = value.code;
        drop(value);
        (((prefix as i32 in Wrapping) + (code as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
}

Scaled satisfies Settlement<Receipt> { Settlement::settle = settle_scaled; }
machine settle_scaled(prefix: i32, value: Receipt, suffix: i32) -> i32
satisfies Settlement<Receipt>::settle
{
    let code: i32 = value.code;
        drop(value);
        (((prefix as i32 in Wrapping) + ((code as i32 in Wrapping) * (10 as i32 in Wrapping))) + (suffix as i32 in Wrapping)) as i32
}

Paired satisfies Settlement<Pair> { Settlement::settle = settle_paired; }
machine settle_paired(prefix: i32, value: Pair, suffix: i32) -> i32
satisfies Settlement<Pair>::settle
{
    let left: Receipt = value.left;
        let right: Receipt = value.right;
        let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
        drop(left);
        drop(right);
        (((prefix as i32 in Wrapping) + (total as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
}

Chosen satisfies Settlement<Choice> { Settlement::settle = settle_chosen; }
machine settle_chosen(prefix: i32, value: Choice, suffix: i32) -> i32
satisfies Settlement<Choice>::settle
{
    let code: i32 = consume_choice(value);
        (((prefix as i32 in Wrapping) + (code as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
}

Copied satisfies Settlement<Sample> { Settlement::settle = settle_copied; }
machine settle_copied(prefix: i32, value: Sample, suffix: i32) -> i32
satisfies Settlement<Sample>::settle
{
    (((prefix as i32 in Wrapping) + (value.code as i32 in Wrapping)) + (suffix as i32 in Wrapping)) as i32
}

machine replace_sample(sample: &mut Sample) -> i32 {
    sample.code = 25;
    25
}

machine consume_choice(choice: Choice) -> i32 {
    transition choice {
        Choice::Empty {} -> 0
        Choice::Value { receipt } -> consume(receipt)
    }
}

machine dispatch(selected: dyn Settlement<Receipt>, receipt: Receipt) -> i32 {
    ((Settlement::settle(selected, 2, receipt, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

machine boundary_dispatch(receipt: Receipt) -> i32 reaches BoundarySettlement {
    ((BoundarySettlement::settle(2, receipt, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine settle(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine verify(settled: bool) crashes Trap {
    transition settled {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

machine settle_array(receipts: [Receipt; 2]) -> i32 {
    let second: Receipt = receipts[1];
    let first: Receipt = receipts[0];
    let total: i32 = (((first.code as i32 in Wrapping) * (10 as i32 in Wrapping)) + (second.code as i32 in Wrapping)) as i32;
    drop(second);
    drop(first);
    total
}

machine Main::main(main: &mut Main) reaches BoundarySettlement crashes Trap {
    let inline: i32 = ((consume(Receipt { code: 5 }) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let local: Receipt = Receipt { code: 4 };
    let named: i32 = ((consume(local) as i32 in Wrapping) + (2 as i32 in Wrapping)) as i32;
    let member: Receipt = Receipt { code: 6 };
    let paired: i32 = ((settle(Pair { left: member, right: Receipt { code: 7 } }) as i32 in Wrapping) + (3 as i32 in Wrapping)) as i32;
    let nested: i32 = consume(make(8));
    let produced: i32 = ((settle(Pair { left: make(9), right: make(10) }) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let array: i32 = ((settle_array([make(1), make(2)]) as i32 in Wrapping) + (3 as i32 in Wrapping)) as i32;
    let mut selected: dyn Settlement<Receipt> = Observed as dyn Settlement<Receipt>;
    let owned: Receipt = make(7);
    let observed: i32 = ((Settlement::settle(selected, 2, owned, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    selected = Scaled as dyn Settlement<Receipt>;
    let scaled: i32 = dispatch(selected, make(7));
    let pair_selector: dyn Settlement<Pair> = Paired as dyn Settlement<Pair>;
    let multi_claim: i32 = ((Settlement::settle(pair_selector, 2, Pair { left: make(4), right: make(5) }, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let projected: Pair = Pair { left: make(6), right: make(8) };
    let projection: i32 = ((Settlement::settle(selected, 2, projected.left, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let sibling: i32 = consume(projected.right);
    let choice_selector: dyn Settlement<Choice> = Chosen as dyn Settlement<Choice>;
    let absent: i32 = ((Settlement::settle(choice_selector, 2, Choice::Empty {}, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let present: i32 = ((Settlement::settle(choice_selector, 2, Choice::Value { receipt: make(9) }, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let copy_selector: dyn Settlement<Sample> = Copied as dyn Settlement<Sample>;
    let mut sample: Sample = Sample { code: 17 };
    let snapshot: i32 = ((Settlement::settle(copy_selector, 2, sample, replace_sample(&mut sample)) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    // A selector invocation can itself be a computed operand of an outer
    // call; the enclosing argument group does not acquire its moved owner.
    verify(Settlement::settle(selected, 2, make(1), 3) == 15);
    // Boundary calls bind the same caller claims as completion receipts, even
    // inside another call's argument or a retained scalar helper's body.
    let boundary_inline: i32 = ((BoundarySettlement::settle(2, Receipt { code: 7 }, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let boundary_named_owner: Receipt = make(8);
    let boundary_named: i32 = ((BoundarySettlement::settle(2, boundary_named_owner, 3) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let boundary_forwarded: i32 = boundary_dispatch(make(9));
    let boundary_pair: Pair = Pair { left: make(10), right: make(11) };
    verify(BoundarySettlement::settle(2, boundary_pair.left, 3) == 15);
    let boundary_sibling: i32 = consume(boundary_pair.right);
    verify(inline == 6 && named == 6 && paired == 16 && nested == 8 && produced == 20 && array == 15
        && observed == 13 && scaled == 76 && multi_claim == 15 && projection == 66 && sibling == 8
        && absent == 6 && present == 15 && snapshot == 45 && sample.code == 25
        && boundary_inline == 13 && boundary_named == 14 && boundary_forwarded == 15 && boundary_sibling == 11);
}
