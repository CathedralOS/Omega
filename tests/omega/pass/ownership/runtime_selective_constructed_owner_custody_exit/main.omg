// Selected operations transfer a named owner; skipped paths settle its
// retained no-code affine custody before reconverging. A disjoint sibling
// remains available, and a branch-only construction creates no skipped owner.
data Token { value: u64; }
data Wrapped { token: Token; }
data Holder<Value> { value: Value; }
data Pair { left: Token; right: Token; }

machine consume(value: Wrapped) -> u64 { value.token.value }

machine and_transfer(enabled: bool) -> bool {
    let token: Token = Token { value: 9 };
    let survivor: Token = Token { value: 10 };
    let observed: bool = enabled && consume(Wrapped { token: token }) == 9;
    (observed == enabled) && survivor.value == 10
}

machine or_transfer(enabled: bool) -> bool {
    let token: Token = Token { value: 9 };
    let survivor: Token = Token { value: 10 };
    let observed: bool = enabled || consume(Wrapped { token: token }) == 9;
    observed && survivor.value == 10
}

machine nested_transfer(outer: bool, inner: bool) -> bool {
    let token: Token = Token { value: 9 };
    let survivor: Token = Token { value: 10 };
    let observed: bool = outer && (inner || consume(Wrapped { token: token }) == 9);
    (observed == outer) && survivor.value == 10
}

machine branch_birth(enabled: bool) -> bool {
    let observed: bool = enabled && consume(Wrapped { token: Token { value: 9 } }) == 9;
    observed == enabled
}

machine consume_holder(value: Holder<Token>) -> u64 { value.value.value }
machine generic_transfer(enabled: bool) -> bool {
    let holder: Holder<Token> = Holder { value: Token { value: 9 } };
    let observed: bool = enabled && consume_holder(holder) == 9;
    observed == enabled
}

machine consume_pair(value: Pair) -> bool {
    value.left.value == 11 && value.right.value == 9
}
machine replace_then_select(enabled: bool) -> bool {
    let mut pair: Pair = Pair {
        left: Token { value: 7 },
        right: Token { value: 9 }
    };
    pair.left = Token { value: 11 };
    let observed: bool = enabled && consume_pair(pair);
    observed == enabled
}

machine indexed_replacement(index: &mut u64) -> Token {
    index = 1;
    Token { value: 19 }
}
machine consume_tokens(tokens: [Token; 2]) -> bool {
    tokens[0].value == 19 && tokens[1].value == 7
}
machine replace_index_then_select(enabled: bool) -> bool {
    let mut tokens: [Token; 2] = [Token { value: 11 }, Token { value: 7 }];
    let mut index: u64 = 0;
    tokens[index] = indexed_replacement(&mut index);
    let observed: bool = enabled && consume_tokens(tokens);
    (observed == enabled) && index == 1
}

machine main() crashes Trap {
    let accepted: bool = and_transfer(false) && and_transfer(true)
        && or_transfer(true) && or_transfer(false)
        && nested_transfer(false, false) && nested_transfer(false, true)
        && nested_transfer(true, true) && nested_transfer(true, false)
        && branch_birth(false) && branch_birth(true)
        && generic_transfer(false) && generic_transfer(true)
        && replace_then_select(false) && replace_then_select(true)
        && replace_index_then_select(false) && replace_index_then_select(true);
    transition accepted { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
