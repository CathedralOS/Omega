machine build(builder: &mut Build) {
    Build::application(builder, "linear_issued_argument_transfer_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<TokenRoot>(builder);
    Build::select_provider<TokenRoot, TokenProvider>(builder, linux_arm64);
    Build::select_provider<TokenRoot, TokenProvider>(builder, linux_x86_64);
    Build::select_provider<TokenRoot, TokenProvider>(builder, macos_arm64);
    Build::select_provider<TokenRoot, TokenProvider>(builder, macos_x86_64);
    Build::select_provider<TokenRoot, TokenProvider>(builder, windows_x86_64);
    Build::select_provider<TokenRoot, TokenProvider>(builder, uefi_x86_64);
    Build::select_provider<TokenRoot, TokenProvider>(builder, cross_platform_cli);
    Build::select_provider<TokenRoot, TokenProvider>(builder, local_unchecked);
    Build::select_provider<TokenRoot, TokenProvider>(builder, alpha_bootstrap);
    Build::select_provider<TokenConsumer, Consumer>(builder, linux_arm64);
    Build::select_provider<TokenConsumer, Consumer>(builder, linux_x86_64);
    Build::select_provider<TokenConsumer, Consumer>(builder, macos_arm64);
    Build::select_provider<TokenConsumer, Consumer>(builder, macos_x86_64);
    Build::select_provider<TokenConsumer, Consumer>(builder, windows_x86_64);
    Build::select_provider<TokenConsumer, Consumer>(builder, uefi_x86_64);
    Build::select_provider<TokenConsumer, Consumer>(builder, cross_platform_cli);
    Build::select_provider<TokenConsumer, Consumer>(builder, local_unchecked);
    Build::select_provider<TokenConsumer, Consumer>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
