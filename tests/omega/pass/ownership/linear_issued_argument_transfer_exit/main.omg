// Evaluated argument temporaries preserve the original owners' exact claims.
// Expected exit: 37. Named, projected, parameter and fresh call-result operands
// exercise the same ownership transfer through ordinary and boundary calls.
use omega::language::core::drop;
use omega_language_std::console;

public data Token [linear] { code: u8; }
machine Token::drop(token: &mut Token) {}
public domain Token::Issued established by TokenRoot::grant;
public boundary trait TokenRoot {
    machine grant(token: Token) -> Token reaches ensures result in Token::Issued;
}
TokenProvider satisfies TokenRoot {
    machine grant(token: Token) -> Token { token }
}
data Pair { left: Token in Issued; right: Token in Issued; }
data Envelope { pair: Pair; }

machine total_tokens(first: Token in Issued, second: Token in Issued) -> u64 {
    let result: u64 = (first.code as u64) + (second.code as u64);
    drop(first);
    drop(second);
    result
}

public boundary trait TokenConsumer {
    machine observe(first: Token in Issued, second: Token in Issued) -> u64 reaches;
}
Consumer satisfies TokenConsumer {
    machine observe(first: Token in Issued, second: Token in Issued) -> u64 {
        total_tokens(first, second)
    }
}

machine forward(first: Token in Issued, second: Token in Issued) -> u64 {
    transition { _ -> next(first, second) }
    state next(first: Token in Issued, second: Token in Issued) -> u64 {
        total_tokens(first, second)
    }
}

data Main {}
machine Main::run(context: &mut Main) reaches TokenRoot + TokenConsumer + Console {
    let first: Token = TokenRoot::grant(Token { code: 11 });
    let second: Token = TokenRoot::grant(Token { code: 26 });
    let named: u64 = total_tokens(first, second);
    let pair: Pair = Pair {
        left: TokenRoot::grant(Token { code: 12 }),
        right: TokenRoot::grant(Token { code: 25 }),
    };
    let fields: u64 = total_tokens(pair.left, pair.right);
    let envelope: Envelope = Envelope { pair: Pair {
        left: TokenRoot::grant(Token { code: 13 }),
        right: TokenRoot::grant(Token { code: 24 }),
    } };
    let projected: u64 = TokenConsumer::observe(envelope.pair.left, envelope.pair.right);
    let nested: u64 = forward(
        TokenRoot::grant(Token { code: 14 }),
        TokenRoot::grant(Token { code: 23 })
    );
    let computed_pair: Pair = Pair {
        left: TokenRoot::grant(Token { code: 15 }),
        right: TokenRoot::grant(Token { code: 22 }),
    };
    let computed: bool = total_tokens(computed_pair.left, computed_pair.right) == 37;
    let captured_first: Token = TokenRoot::grant(Token { code: 16 });
    let captured_second: Token = TokenRoot::grant(Token { code: 21 });
    let captured: bool = total_tokens(captured_first, captured_second) == 37;
    transition named == 37 && fields == 37 && projected == 37 && nested == 37 && computed && captured {
        true -> good()
        _ -> bad()
    }
    state good() { Console::exit_process(37); }
    state bad() { Console::exit_process(99); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches TokenRoot + TokenConsumer + Console {
    let mut entry_storage: Main;
    Main::run(&mut entry_storage);
}
