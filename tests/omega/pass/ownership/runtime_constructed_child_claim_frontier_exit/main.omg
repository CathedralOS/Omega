// Expected exit: 0.
// Inline children transfer their original claims into the complete parent.
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { first: Receipt; second: Receipt; }
data LinearParent [linear] { receipt: Receipt; }
machine LinearParent::drop(parent: &mut LinearParent) {}
machine issue(code: u64) -> Receipt { Receipt { code: code } }

machine main() crashes Trap {
    let direct: Receipt = Receipt { code: 3 };
    let pair: Pair = Pair { first: Receipt { code: 7 }, second: Receipt { code: 13 } };
    let first: Receipt = Receipt { code: 17 };
    let second: Receipt = Receipt { code: 23 };
    let named: Pair = Pair { first: first, second: second };
    let nominal: LinearParent = LinearParent { receipt: Receipt { code: 29 } };
    let issued: LinearParent = LinearParent { receipt: issue(31) };
    let held: Receipt = issue(37);
    let received: LinearParent = LinearParent { receipt: held };
    transition direct.code == 3 && pair.first.code == 7 && pair.second.code == 13
        && named.first.code == 17 && named.second.code == 23 && nominal.receipt.code == 29
        && issued.receipt.code == 31 && received.receipt.code == 37 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
