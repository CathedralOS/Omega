// A free `main` projects the linear members of two claim-bearing call
// results and retires each through a drop-hooked consumer. A projected
// owned argument carries exactly the claim beneath its path; its affine
// owner keeps the sibling claim until another projection moves it, whether
// that projection is a call argument or a `let` binding. Each result's
// claims continue the claims its callee's returning edge holds at each path.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { left: Receipt; right: Receipt; }

machine issue(first: i32, second: i32) -> Pair {
    let left: Receipt = Receipt { code: first };
    let right: Receipt = Receipt { code: second };
    Pair { left: left, right: right }
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine main() crashes Trap {
    let first: Pair = issue(1, 2);
    let second: Pair = issue(3, 4);
    let first_left: i32 = consume(first.left);
    let second_right: i32 = consume(second.right);
    let first_right: Receipt = first.right;
    let second_left: Receipt = second.left;
    let retired_right: i32 = consume(first_right);
    let retired_left: i32 = consume(second_left);
    transition first_left == 1 && second_right == 4 && retired_right == 2 && retired_left == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
