// A `&mut` loan may name a plain local copied from a state parameter:
// `fill(&mut held)` lends the local's claim — state parameters themselves
// are read-only bindings, so the value moves through a local slot.
data Main { answer: u64; }

machine Main::fill(cell: &mut u64) {
    cell = 70;
}

machine Main::main(main: &mut Main) {
    transition 1 {
        1 -> measure(main, 0)
        _ -> miss(main)
    }

    machine measure(main: &mut Main, captured: u64) {
        let held: u64 = captured;
        Main::fill(&mut held);
        main.answer = held;
    }

    machine miss(main: &mut Main) { main.answer = 71; }
}
