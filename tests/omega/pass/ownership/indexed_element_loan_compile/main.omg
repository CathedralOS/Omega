// A `&mut` loan may name an array element: `&mut row.cells[1]` lends the
// single slot's claim — the callee writes through the element view and the
// rest of the array stays owned by the caller.
data Row {
    cells: [u64; 4];
    tag: u64;
}

data Main { row: Row; }

machine Main::fill(cell: &mut u64)
requires cell <= 100
{
    cell = cell + 10;
}

machine Main::main(main: &mut Main) {
    main.row = Row { cells: [1, 2, 3, 4], tag: 0 };
    Main::fill(&mut main.row.cells[1]);
    let tag: u64 = main.row.tag;
}
