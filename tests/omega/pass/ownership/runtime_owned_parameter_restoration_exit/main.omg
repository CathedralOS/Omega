// Exit custody follows the current parameter occurrence, not every move
// in its history. The scalar prefix precedes the structural parameter so
// authored parameter positions differ from dense structural indexes.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }

machine consume(receipt: Receipt) -> i32 {
    let code: i32 = receipt.code;
    drop(receipt);
    code
}

machine total(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let first: i32 = consume(left);
    let second: i32 = consume(right);
    ((first as i32 in Wrapping) + (second as i32 in Wrapping)) as i32
}

machine record(prefix: i32, mut pair: Pair) -> i32 {
    let previous: Receipt = pair.left;
    pair.left = Receipt { code: 33 };
    let restored: Receipt = pair.left;
    let sibling: Receipt = pair.right;
    let old: i32 = consume(previous);
    let new: i32 = consume(restored);
    let other: i32 = consume(sibling);
    ((((prefix as i32 in Wrapping) + (old as i32 in Wrapping))
        + (new as i32 in Wrapping)) + (other as i32 in Wrapping)) as i32
}

machine array(prefix: i32, mut receipts: [Receipt; 2]) -> i32 {
    let previous: Receipt = receipts[0];
    receipts[0] = Receipt { code: 7 };
    let restored: Receipt = receipts[0];
    let sibling: Receipt = receipts[1];
    let old: i32 = consume(previous);
    let new: i32 = consume(restored);
    let other: i32 = consume(sibling);
    ((((prefix as i32 in Wrapping) + (old as i32 in Wrapping))
        + (new as i32 in Wrapping)) + (other as i32 in Wrapping)) as i32
}

machine whole(prefix: i32, mut pair: Pair) -> i32 {
    let previous: Pair = pair;
    pair = Pair { left: Receipt { code: 3 }, right: Receipt { code: 4 } };
    let old: i32 = total(previous);
    let new: i32 = total(pair);
    (((prefix as i32 in Wrapping) + (old as i32 in Wrapping))
        + (new as i32 in Wrapping)) as i32
}

// State successors receive the current formal, while a captured old owner
// still contributes its own value before the branch.
machine routed(prefix: i32, mut pair: Pair, selected: bool) -> i32 {
    let previous: Pair = pair;
    pair = Pair { left: Receipt { code: 3 }, right: Receipt { code: 4 } };
    let old: i32 = total(previous);
    transition selected {
        true -> finish(pair, old, prefix)
        false -> total(pair)
    }
    machine finish(pair: Pair, old: i32, prefix: i32) -> i32 {
        let current: i32 = total(pair);
        (((current as i32 in Wrapping) + (old as i32 in Wrapping))
            + (prefix as i32 in Wrapping)) as i32
    }
}

// Replacing one child preserves the aggregate home but changes that child's
// claim. A successor must receive the replacement claim, not the entry claim.
machine routed_field(prefix: i32, mut pair: Pair) -> i32 {
    let previous: Receipt = pair.left;
    pair.left = Receipt { code: 3 };
    let old: i32 = consume(previous);
    transition { _ -> finish(pair, old, prefix) }
    machine finish(pair: Pair, old: i32, prefix: i32) -> i32 {
        let current: i32 = total(pair);
        (((current as i32 in Wrapping) + (old as i32 in Wrapping))
            + (prefix as i32 in Wrapping)) as i32
    }
}

// A restored affine value remains owned at return. Its cleanup must refer
// to the replacement occurrence; a historical move cannot suppress it.
data Item { code: i32; }
data Items { left: Item; right: Item; }

machine remaining(prefix: i32, mut items: Items) -> i32 {
    let previous: Item = items.left;
    items.left = Item { code: 8 };
    (((prefix as i32 in Wrapping) + (previous.code as i32 in Wrapping))
        + (items.left.code as i32 in Wrapping)) as i32
}

machine remaining_whole(prefix: i32, mut item: Item) -> i32 {
    let previous: Item = item;
    item = Item { code: 9 };
    (((prefix as i32 in Wrapping) + (previous.code as i32 in Wrapping))
        + (item.code as i32 in Wrapping)) as i32
}

machine main() crashes Trap {
    let record_result: i32 = record(5, Pair {
        left: Receipt { code: 11 }, right: Receipt { code: 29 }
    });
    let array_result: i32 = array(5, [Receipt { code: 4 }, Receipt { code: 9 }]);
    let whole_result: i32 = whole(5, Pair {
        left: Receipt { code: 1 }, right: Receipt { code: 2 }
    });
    let remaining_result: i32 = remaining(5, Items {
        left: Item { code: 2 }, right: Item { code: 3 }
    });
    let remaining_whole_result: i32 = remaining_whole(5, Item { code: 1 });
    let routed_true: i32 = routed(5, Pair {
        left: Receipt { code: 1 }, right: Receipt { code: 2 }
    }, true);
    let routed_false: i32 = routed(5, Pair {
        left: Receipt { code: 1 }, right: Receipt { code: 2 }
    }, false);
    let routed_field_result: i32 = routed_field(5, Pair {
        left: Receipt { code: 1 }, right: Receipt { code: 2 }
    });
    transition record_result == 78 && array_result == 25 && whole_result == 15
        && remaining_result == 15 && remaining_whole_result == 15
        && routed_true == 15 && routed_false == 7 && routed_field_result == 11 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
