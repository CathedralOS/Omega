// A `&mut` loan on one member doesn't freeze the others: while
// `fill(&mut main.a)` is outstanding the caller writes `main.b` directly —
// exclusive access is per-place, not per-record.
data Main {
    a: u64;
    b: u64;
    answer: u64;
}

machine Main::fill(cell: &mut u64) {
    cell = 4;
}

machine Main::main(main: &mut Main) {
    main.a = 0;
    main.b = 0;
    let loan: &mut u64 = &mut main.a;
    main.b = 7;
    loan = 4;
    transition main.b {
        7 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
