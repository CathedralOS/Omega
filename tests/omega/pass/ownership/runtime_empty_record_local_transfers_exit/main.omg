// Empty-record values take every ordinary custody route without storage:
// `kept` is forwarded to a named state, `dropped` dies unused in the entry
// state, and a constructed `Empty {}` argument replaces a field of a
// mutable-borrowed record beside a scalar sibling. None of them owes bytes,
// a move window or cleanup code. Exits 70 when the sibling store survives the
// replacement and reaches the forwarding state.
use omega_language_std::console;

data Empty {}
data Holder { marker: Empty; value: i32; }
data Main { }

machine replace(holder: &mut Holder, marker: Empty) {
    holder.marker = marker;
    holder.value = 70;
}

machine Main::main(main: &mut Main) reaches Console {
    let kept: Empty = Empty {};
    let dropped: Empty = Empty {};
    let mut holder: Holder = Holder { marker: Empty {}, value: 1 };
    replace(&mut holder, Empty {});
    transition { _ -> forward(main, kept, holder.value) }
    state forward(main: &mut Main, kept: Empty, value: i32) {
        transition value == 70 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
