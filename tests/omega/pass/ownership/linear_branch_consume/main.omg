// Transition arms are alternatives, not sequential copies: both
// paths transfer the SAME linear obligation into a consuming state —
// `boundary requirement Receipt::ack(receipt: Receipt)` takes
// custody by move on whichever arm fires.
data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) { }
boundary requirement Receipt::ack(receipt: Receipt);
use omega::language::core::drop;
data Main { choose_first: bool; }
machine Main::main(main: &mut Main) -> i32 {
    let receipt: Receipt = Receipt { code: 7 };
    transition main.choose_first {
        true -> consume_first(receipt)
        _ -> consume_second(receipt)
    }
    machine consume_first(receipt: Receipt) -> i32 {
        Receipt::ack(receipt);
        0
    }
    machine consume_second(receipt: Receipt) -> i32 {
        Receipt::ack(receipt);
        0
    }
}
