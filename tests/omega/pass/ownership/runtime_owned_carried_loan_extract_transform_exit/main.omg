use omega_language_std::console;
data Carrier<'storage> { marker: i32; reference: &'storage i32; }
data Holder<'storage> { carrier: Carrier<'storage>; }
data Main { }
machine transform<'storage>(carrier: Carrier<'storage>) -> Carrier<'storage> {
    transition carrier.marker == 41 {
        true -> increment(carrier)
        false -> preserve(carrier)
    }
    state increment(carrier: Carrier<'storage>) -> Carrier<'storage> {
        Carrier { marker: ((carrier.marker as i32 in Wrapping) + 1) as i32, reference: carrier.reference }
    }
    state preserve(carrier: Carrier<'storage>) -> Carrier<'storage> { carrier }
}
machine extract<'storage>(holder: Holder<'storage>) -> i32 {
    let removed: Carrier<'storage> = holder.carrier;
    let returned: Carrier<'storage> = transform(removed);
    returned.reference
}
machine Main::main(main: &mut Main) reaches Console {
    let backing: i32 = 42;
    let holder: Holder = Holder { carrier: Carrier { marker: 41, reference: &backing } };
    let observed: i32 = extract(holder);
    transition observed == 42 {
        true -> finish(main, 42)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
