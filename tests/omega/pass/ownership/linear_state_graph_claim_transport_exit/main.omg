// Linear values held across state edges. Each state's entry claim continues
// the claim its arriving edge carries, whatever established it: `spin`
// reenters its own entry holding the receipt its caller passed in (an inline
// construction once, a named local once) until its count runs out; `issue`
// carries a local into the state that returns it; `main` carries a call
// result into `holding`, which hands that claim through `pass` and back, then
// carries a fresh call result into `last`.
// `exchange` joins opposite original claims into destination names; `rotate`
// exchanges two invocation names on a backedge without overwriting custody.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
data Pair { left: Receipt; right: Receipt; }
data Package { pair: Pair; spare: Receipt; }

machine Receipt::drop(receipt: &mut Receipt) {}

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine pass(receipt: Receipt) -> Receipt {
    receipt
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine spin(held: Receipt, remaining: u32) -> i32
terminates by remaining -> Nat::Descending;
{
    transition remaining > 0 {
        true -> spin(held, remaining - 1)
        _ -> finish(held)
    }
    machine finish(last: Receipt) -> i32 {
        consume(last)
    }
}

machine issue(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    transition { _ -> returning(issued) }
    machine returning(held: Receipt) -> Receipt {
        held
    }
}

machine exchange(swap: bool, left: Receipt, right: Receipt) crashes Trap {
    transition swap {
        true -> received(right, left, 2, 1)
        _ -> received(left, right, 1, 2)
    }
    machine received(first: Receipt, second: Receipt, expected_first: i32, expected_second: i32) {
        let first_code: i32 = consume(first);
        let second_code: i32 = consume(second);
        transition first_code == expected_first && second_code == expected_second {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine rotate(first: Receipt, second: Receipt, remaining: u32) -> i32
terminates by remaining -> Nat::Descending;
{
    transition remaining > 0 {
        true -> rotate(second, first, remaining - 1)
        _ -> finish(first, second)
    }
    machine finish(left: Receipt, right: Receipt) -> i32 {
        let observed: i32 = consume(left);
        let discarded: i32 = consume(right);
        observed
    }
}

machine exchange_members(swap: bool, pair: Pair) crashes Trap {
    transition swap {
        true -> received(pair.right, pair.left, 2, 1)
        _ -> received(pair.left, pair.right, 1, 2)
    }
    machine received(first: Receipt, second: Receipt, expected_first: i32, expected_second: i32) {
        let first_code: i32 = consume(first);
        let second_code: i32 = consume(second);
        transition first_code == expected_first && second_code == expected_second {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// A retained local can be a path under its original home, not a fresh place.
// Forwarding it must move only that subtree and keep both received claims.
machine forward_local(package: Package) -> i64 {
    let pair: Pair = package.pair;
    let spare: i32 = consume(package.spare);
    transition { _ -> holding(pair) }
    machine holding(held: Pair) -> i64 {
        let first: i32 = consume(held.left);
        let second: i32 = consume(held.right);
        (first as i64) + (second as i64)
    }
}

machine exchange_pairs(swap: bool, left: Pair, right: Pair) crashes Trap {
    transition swap {
        true -> received(right, left, 3, 1)
        _ -> received(left, right, 1, 3)
    }
    machine received(first: Pair, second: Pair, expected_first: i32, expected_second: i32) {
        let first_code: i32 = consume(first.left);
        let first_sibling: i32 = consume(first.right);
        let second_code: i32 = consume(second.left);
        let second_sibling: i32 = consume(second.right);
        transition first_code == expected_first && second_code == expected_second {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    exchange(true, make(1), make(2));
    exchange(false, make(1), make(2));
    exchange_members(true, Pair { left: make(1), right: make(2) });
    exchange_members(false, Pair { left: make(1), right: make(2) });
    exchange_pairs(true, Pair { left: make(1), right: make(2) }, Pair { left: make(3), right: make(4) });
    exchange_pairs(false, Pair { left: make(1), right: make(2) }, Pair { left: make(3), right: make(4) });
    let forwarded: i64 = forward_local(Package {
        pair: Pair { left: make(3), right: make(4) },
        spare: make(9)
    });
    let rotated: i32 = rotate(make(9), make(8), 2);
    let looped: i32 = spin(Receipt { code: 9 }, 3);
    let issued: Receipt = Receipt { code: 2 };
    let once: i32 = spin(issued, 0);
    let made: Receipt = issue(6);
    transition looped == 9 && once == 2 && rotated == 9 && forwarded == 7 {
        true -> holding(made)
        _ -> refusing(made)
    }

    machine holding(held: Receipt) {
        let back: Receipt = pass(held);
        let observed: i32 = consume(back);
        let fresh: Receipt = make(observed);
        transition { _ -> last(fresh) }
    }

    machine refusing(held: Receipt) {
        let observed: i32 = consume(held);
        transition { _ -> bad() }
    }

    machine last(final: Receipt) {
        let seen: i32 = consume(final);
        transition seen == 6 {
            true -> done()
            _ -> bad()
        }
    }

    machine done() {}
    machine bad() { crash Trap; }
}
