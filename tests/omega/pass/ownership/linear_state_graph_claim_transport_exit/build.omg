// Every hosted target selects its exact entry.
machine build(builder: &mut Build) {
    Build::application(builder, "linear_state_graph_claim_transport_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    // Exercise the independent optimizer ownership replay, not just the
    // no-selection identity route, over the same state binding rosters.
    Optimizations::enable(&mut builder.optimizations, Optimization::CopyPropagation);
}
