use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Carrier { marker: u64; token: Token; }
data Envelope { sibling: Token; carrier: Carrier; }

machine extract(envelope: Envelope) -> Carrier {
    let sibling: Token = envelope.sibling;
    drop(sibling);
    envelope.carrier
}

machine main() crashes Trap {
    let envelope: Envelope = Envelope {
        sibling: Token { value: 17 },
        carrier: Carrier { marker: 7, token: Token { value: 42 } }
    };
    let carrier: Carrier = extract(envelope);
    let value: u64 = carrier.token.value;
    let marker: u64 = carrier.marker;
    let token: Token = carrier.token;
    drop(token);
    transition value == 42 && marker == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
