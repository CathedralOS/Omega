// Expected exit: 0.
// A selected field retains the established physical home of its affine owner.
data Payload { left: u64; right: u64; }
data Pair { first: Payload; second: Payload; }

machine choose(enabled: bool, pair: Pair) -> Payload {
    let result: Payload = match enabled { true -> pair.first, _ -> pair.second };
    result
}

machine main() crashes Trap {
    let first: Payload = choose(true, Pair {
        first: Payload { left: 4, right: 6 },
        second: Payload { left: 8, right: 9 }
    });
    let second: Payload = choose(false, Pair {
        first: Payload { left: 14, right: 16 },
        second: Payload { left: 18, right: 19 }
    });
    transition first.left == 4 && first.right == 6 && second.left == 18 && second.right == 19 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
