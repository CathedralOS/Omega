// Expected exit: 0. A selected field moves through the shared completion owner.
use omega::language::core::drop;
data Token [linear] { value: u64; }
data Envelope { token: Token; }
machine Token::drop(token: &mut Token) {}
machine valid(enabled: bool) -> Token {
    let mut home: Envelope = Envelope { token: match enabled {
        true -> Token { value: 1 },
        _ -> Token { value: 2 },
    } };
    let first: Token = home.token;
    drop(first);
    home.token = match enabled {
        true -> Token { value: 3 },
        _ -> Token { value: 4 },
    };
    let second: Token = home.token;
    drop(second);
    home.token = match enabled {
        true -> Token { value: 5 },
        _ -> Token { value: 6 },
    };
    let moved: Token = home.token;
    let result: Token = match enabled {
        true -> moved,
        _ -> moved,
    };
    result
}
machine main() crashes Trap {
    let first: Token = valid(true);
    let left: u64 = first.value;
    drop(first);
    let second: Token = valid(false);
    let right: u64 = second.value;
    drop(second);
    transition left == 5 && right == 6 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
