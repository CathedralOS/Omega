// A `&` view may name a whole `data where` record: `peek(&main.band)`
// lends read access to the constrained aggregate — the view sees the
// record's members while the caller's invariant stays intact.
data Band
requires
    a >= 1,
    b >= a,
    b <= 9,
{
    a: u64;
    b: u64;
}

data Main { band: Band; }

machine Main::peek(band: &Band) -> u64 {
    band.a
}

machine Main::main(main: &mut Main) {
    main.band = Band { a: 3, b: 7 };
    let seen: u64 = Main::peek(&main.band);
}
