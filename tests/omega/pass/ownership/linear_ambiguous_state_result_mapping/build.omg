use omega::language::core::external_binding;
// Every hosted target selects its exact entry and the sink its target binds.
machine build(builder: &mut Build) {
    Build::application(builder, "linear_ambiguous_state_result_mapping");
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind<ReceiptAck::ack>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    });
    Build::bind<ReceiptAck::ack>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    });
    Build::bind<ReceiptAck::ack>(builder, linux_arm64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    });
    Build::bind<ReceiptAck::ack>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_abs",
        },
    });
}
