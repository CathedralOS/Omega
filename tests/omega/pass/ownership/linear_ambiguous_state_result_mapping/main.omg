// A linear result whose lineage depends on the exit taken. `Main::pack`
// returns its two inputs in different result fields on its two arms, so the
// claim at `returned.left` continues `issue`'s `left` on one exit and its
// `right` on the other. Checking publishes that per-exit correspondence as a
// conditional claim join rather than one outcome map. Both alternatives have
// the same realization, so the call binds its result claims by path: each
// result claim continues whichever claim the callee's returning edge holds at
// that path, and `main` consumes both.
//
// The requirement's provider is the external sink
// `pass/ownership/linear_transfer_and_consume` declares: each bound target's
// C library `abs`, which takes the one-field `i32` record by value and
// completes the receipt's claim.
use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}


data Pair {
    left: Receipt;
    right: Receipt;
}

data Main {}

machine Main::pack(swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition swap {
        false -> (Pair { left: left, right: right })
        true -> (Pair { left: right, right: left })
    }
}

machine issue() -> Pair {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    transition { _ -> Main::pack(false, left, right) }
}

machine Main::main() {
    let returned: Pair = issue();
    let left: Receipt = returned.left;
    let right: Receipt = returned.right;
    Receipt::ack(left);
    Receipt::ack(right);
}
