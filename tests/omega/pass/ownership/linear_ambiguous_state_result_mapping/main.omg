// A linear result whose lineage depends on the exit taken. `Main::pack`
// returns its two inputs in different result fields on its two arms, so the
// claim at `returned.left` continues `issue`'s `left` on one exit and its
// `right` on the other. Checking publishes that per-exit correspondence as a
// conditional claim join rather than one outcome map. Both alternatives have
// the same realization, so the call binds its result claims by path: each
// result claim continues whichever claim the callee's returning edge holds at
// that path, and `main` consumes both.
//
// The requirement's provider is the external sink
// `pass/ownership/linear_transfer_and_consume` declares: each bound target's
// C library `abs`, which takes the one-field `i32` record by value and
// completes the receipt's claim.
use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}

windows_x86_64 machine windows_x86_64_receipt_sink_binding() -> ForeignBinding<10, 3, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    }
}

linux_x86_64 machine linux_x86_64_receipt_sink_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    }
}

linux_arm64 machine linux_arm64_receipt_sink_binding() -> ForeignBinding<9, 3, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    }
}

macos_arm64 machine macos_arm64_receipt_sink_binding() -> ForeignBinding<17, 4, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_abs",
        },
    }
}

windows_x86_64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via windows_x86_64_receipt_sink_binding();
linux_x86_64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via linux_x86_64_receipt_sink_binding();
linux_arm64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via linux_arm64_receipt_sink_binding();
macos_arm64 machine ReceiptSink::ack_leaf(receipt: Receipt)
satisfies Receipt::ack via macos_arm64_receipt_sink_binding();

data Pair {
    left: Receipt;
    right: Receipt;
}

data Main {}

machine Main::pack(swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition swap {
        false -> (Pair { left: left, right: right })
        true -> (Pair { left: right, right: left })
    }
}

machine issue() -> Pair {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    transition { _ -> Main::pack(false, left, right) }
}

machine Main::main() {
    let returned: Pair = issue();
    let left: Receipt = returned.left;
    let right: Receipt = returned.right;
    Receipt::ack(left);
    Receipt::ack(right);
}
