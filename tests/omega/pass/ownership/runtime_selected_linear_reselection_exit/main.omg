// Expected exit: 0. Selected custody follows actual completed values.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
machine valid(enabled: bool) -> Token {
    let saved: Token = match enabled {
        true -> Token { value: 1 },
        _ -> Token { value: 2 },
    };
    let first: Token = match enabled {
        true -> saved,
        _ -> saved,
    };
    first
}

machine main() crashes Trap {
    let first: Token = valid(true);
    let left: u64 = first.value;
    drop(first);
    let second: Token = valid(false);
    let right: u64 = second.value;
    drop(second);
    transition left == 1 && right == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
