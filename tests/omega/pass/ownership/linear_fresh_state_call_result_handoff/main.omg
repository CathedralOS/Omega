// PASS canary: a state-local linear obligation returned through a state call
// keeps its original provenance when the caller binds and later consumes it.
// The receiving continuation must not mint an unrelated caller-side claim.
use omega_language_std::console;

data Receipt [linear] { code: i32; }
machine Receipt::ack(self) {}

data Main { console: Console; }

machine Main::issue(&mut self) -> Receipt {
    let issued: Receipt = Receipt { code: 7 };
    transition { _ -> issued }
}

machine Main::main(&mut self) {
    let returned: Receipt = self.issue();
    Receipt::ack(returned);
    self.console.exit_process(0);
}
