// `let mut` marks a rebindable local: `let mut x: u64 = 1` then `x = 7`
// — the binding itself takes new values, distinct from loans through
// the local's storage.
data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let mut x: u64 = 1;
    x = 7;
    transition x {
        7 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
