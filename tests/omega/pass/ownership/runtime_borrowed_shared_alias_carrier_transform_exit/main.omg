use omega_language_std::console;

data Carrier<'storage> {
    marker: i32;
    reference: &'storage i32;
    duplicate: &'storage i32;
}

data Holder<'storage> { carrier: Carrier<'storage>; }
data Main { }

machine transform<'storage>(carrier: Carrier<'storage>) -> Carrier<'storage> {
    transition carrier.marker == 41 {
        true -> increment(carrier)
        false -> preserve(carrier)
    }
    state increment(carrier: Carrier<'storage>) -> Carrier<'storage> {
        Carrier { marker: ((carrier.marker as i32 in Wrapping) + 1) as i32, reference: carrier.reference, duplicate: carrier.duplicate }
    }
    state preserve(carrier: Carrier<'storage>) -> Carrier<'storage> { carrier }
}

machine repair<'storage>(holder: &mut Holder<'storage>) -> i32 {
    let removed: Carrier<'storage> = holder.carrier;
    holder.carrier = transform(removed);
    let removed_again: Carrier<'storage> = holder.carrier;
    holder.carrier = transform(removed_again);
    let removed_third: Carrier<'storage> = holder.carrier;
    holder.carrier = transform(removed_third);
    holder.carrier.reference
}

machine Main::main(main: &mut Main) reaches Console {
    let backing: i32 = 42;
    let mut holder: Holder = Holder {
        carrier: Carrier { marker: 41, reference: &backing, duplicate: &backing }
    };
    let transformed: i32 = repair(&mut holder);
    let marker: i32 = holder.carrier.marker;
    let preserved: i32 = repair(&mut holder);
    let duplicate: i32 = holder.carrier.duplicate;
    transition transformed == 42 && preserved == 42 && duplicate == 42 && marker == 42 {
        true -> finish(main, 42)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
