// Expected exit: 0. A nested owned call executes only on its selected path.
data Ticket { value: u64; }
data Counter { value: u64; }
machine issue() -> Ticket { Ticket { value: 73 } }
machine forward(ticket: Ticket, counter: &mut Counter) -> Ticket {
    counter.value = ((counter.value as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    ticket
}
machine read(ticket: Ticket) -> u64 { ticket.value }
machine selected(choice: bool, counter: &mut Counter) -> bool {
    let ticket: Ticket = issue();
    choice && read(forward(ticket, counter)) == 73
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 0 };
    let skipped: bool = selected(false, &mut counter);
    let taken: bool = selected(true, &mut counter);
    transition !skipped && taken && counter.value == 1 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
