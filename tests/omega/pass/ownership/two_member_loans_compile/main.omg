// One call may lend two disjoint members at once: `weave(&mut main.x,
// &mut main.y)` hands exclusive access to both places — the loans are
// disjoint, so a single call holds both.
data Main {
    x: u64;
    y: u64;
    answer: u64;
}

machine Main::weave(a: &mut u64, b: &mut u64) {
    a = 7;
    b = 8;
}

machine Main::main(main: &mut Main) {
    main.x = 0;
    main.y = 0;
    Main::weave(&mut main.x, &mut main.y);
    transition main.x {
        7 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
