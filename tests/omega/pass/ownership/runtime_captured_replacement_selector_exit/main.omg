data Token { value: u64; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine replacement(index: &mut u64) -> Token {
    index = 1;
    Token { value: 19 }
}

machine main() crashes Trap {
    let mut tokens: [Token; 2] = [Token { value: 11 }, Token { value: 7 }];
    let mut index: u64 = 0;
    // Capture the element before the RHS changes its selector. Old cleanup
    // and the store must still name element zero, leaving element one intact.
    tokens[index] = replacement(&mut index);
    transition index == 1 && tokens[0].value == 19 && tokens[1].value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
