// Two distinct call results, each an affine owner of one linear receipt and
// one hooked affine note. Moving each receipt out leaves its owner's note as
// a residual complement; at exit the residuals are disposed in reverse
// production order (`second`'s note before `first`'s) through the note's
// cleanup hook, after the receipts were retired through their consumer.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Note { tally: i32; }

machine Note::drop(note: &mut Note) {}

data Bundle { receipt: Receipt; note: Note; }

machine issue(code: i32) -> Bundle {
    let receipt: Receipt = Receipt { code: code };
    let note: Note = Note { tally: code };
    Bundle { receipt: receipt, note: note }
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine main() crashes Trap {
    let first: Bundle = issue(1);
    let second: Bundle = issue(2);
    let first_receipt: Receipt = first.receipt;
    let first_code: i32 = consume(first_receipt);
    let second_code: i32 = consume(second.receipt);
    // The anonymous owner keeps its whole producer claim frontier while the
    // selected receipt moves and the hooked sibling's residual is disposed.
    let direct_code: i32 = consume(issue(3).receipt);
    transition first_code == 1 && second_code == 2 && direct_code == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
