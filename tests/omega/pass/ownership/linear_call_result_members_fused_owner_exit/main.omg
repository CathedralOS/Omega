// Both authored sibling owners establish and dispose fresh claims before
// receiving two call-produced claims in the mutually recursive tail component.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine settle(pair: Pair) -> i32 {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    let total: i32 = ((left.code as i32 in Wrapping) + (right.code as i32 in Wrapping)) as i32;
    drop(left);
    drop(right);
    total
}

machine verify(settled: bool) crashes Trap {
    transition settled {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine ping(depth: u64) crashes Trap
terminates by depth;
{
    let fresh: Receipt = Receipt { code: 11 };
    drop(fresh);
    let observed: i32 = settle(Pair { left: make(1), right: make(2) });
    verify(observed == 3);
    transition depth == 0 {
        true -> done()
        _ -> pong(depth - 1)
    }
    machine done() {}
}

machine pong(depth: u64) crashes Trap
terminates by depth;
{
    let fresh: Receipt = Receipt { code: 22 };
    drop(fresh);
    let observed: i32 = settle(Pair { left: make(1), right: make(2) });
    verify(observed == 3);
    transition depth == 0 {
        true -> done()
        _ -> ping(depth - 1)
    }
    machine done() {}
}

machine main() crashes Trap { ping(2); }
