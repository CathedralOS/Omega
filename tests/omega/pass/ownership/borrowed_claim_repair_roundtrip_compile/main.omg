// A `&mut` loan into a callee repairs the caller's claim on return: after
// `lend(&mut account)` writes through the view, `account` reads whole again
// in the caller. The loan is scoped to the call — custody round-trips.
data Account { balance: u64; }

data Main { account: Account; }

machine Main::lend(account: &mut Account) {
    account.balance = 42;
}

machine Main::main(main: &mut Main) {
    main.account = Account { balance: 0 };
    Main::lend(&mut main.account);
    main.account.balance = main.account.balance;
}
