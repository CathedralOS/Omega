data Held { value: &i32; }
machine consume(held: Held) -> i32 { held.value }
machine unconditional(value: &i32) -> i32 {
    let held: Held = Held { value: value };
    transition { _ -> (consume(held)) }
}
machine conditional(value: &i32, choice: bool) -> i32 {
    let held: Held = Held { value: value };
    transition choice {
        true -> (consume(held))
        false -> (consume(held))
    }
}
machine ordered(value: &i32, choice: i32) -> i32 {
    let held: Held = Held { value: value };
    transition choice {
        0 -> (consume(held))
        1 -> (consume(held))
        _ -> (consume(held))
    }
}
machine mixed(value: &i32, choice: bool) -> i32 {
    let held: Held = Held { value: value };
    transition choice {
        true -> (consume(held))
        false -> finish(held)
    }
    machine finish(remaining: Held) -> i32 { consume(remaining) }
}
machine abandoning(value: &i32, choice: bool) -> i32 crashes Trap {
    let held: Held = Held { value: value };
    transition choice {
        true -> (consume(held))
        false -> failed(held)
    }
    machine failed(remaining: Held) -> i32 { crash Trap; }
}
machine main() crashes Trap {
    let value: i32 = 17;
    transition unconditional(&value) == 17
        && conditional(&value, true) == 17 && conditional(&value, false) == 17
        && ordered(&value, 0) == 17 && ordered(&value, 1) == 17 && ordered(&value, 2) == 17
        && mixed(&value, true) == 17 && mixed(&value, false) == 17
        && abandoning(&value, true) == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
