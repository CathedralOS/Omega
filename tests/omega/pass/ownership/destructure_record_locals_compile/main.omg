// A non-linear record destructures into locals: `let { x, y } = point`
// splits the aggregate's plain members into independent bindings — each
// local owns its member's claim from then on.
data Point {
    x: u64;
    y: u64;
}

data Main { answer: u64; }

machine Main::main(main: &mut Main) {
    let point: Point = Point { x: 30, y: 40 };
    let { x, y } = point;
    transition x {
        30 -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { main.answer = 70; }
    machine bad(main: &mut Main) { main.answer = 71; }
}
