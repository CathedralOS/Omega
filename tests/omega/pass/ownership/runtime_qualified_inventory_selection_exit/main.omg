// Expected exit: 0. Runtime selection preserves the same conditional issuer
// obligations across an inventory larger than the old selection-work ceiling.
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Token [linear] { value: u64; }
domain Token::Issued established by issue;
data Slot { case Empty; case Held(token: Token in Issued); }
data Inventory { slots: [Slot; 2048]; }

machine issue(value: u64) -> Token in Issued { Token { value: value } }
machine value(token: &Token in Issued) -> u64 { token.value }
machine insert(slot: &mut Slot) -> bool {
    transition slot {
        Slot::Held { token } -> false
        Slot::Empty -> store(slot)
    }
    machine store(slot: &mut Slot) -> bool
    requires slot in Slot::Empty
    {
        slot = Slot::Held { token: issue(73) };
        true
    }
}
machine insert_at(inventory: &mut Inventory, position: u64) -> bool
requires position < 2048
{
    insert(&mut inventory.slots[position])
}
machine read(inventory: &Inventory, position: u64) -> u64
requires position < 2048
{
    transition &inventory.slots[position] {
        Slot::Empty -> 0
        Slot::Held { token } -> value(token)
    }
}
machine main() reaches ProcessExit {
    let mut inventory: Inventory;
    let inserted: bool = insert_at(&mut inventory, 2047);
    let held: u64 = read(&inventory, 2047);
    let empty: u64 = read(&inventory, 0);
    transition inserted && held == 73 && empty == 0 {
        true -> finish(inventory, 0)
        _ -> finish(inventory, 1)
    }
    machine finish(inventory: Inventory, status: i32) { ProcessExit::exit_process(status); }
}
