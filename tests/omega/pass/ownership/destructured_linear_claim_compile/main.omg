// A linear member claimed by record destructure may flow straight into the
// consuming boundary requirement: `let { grant } = envelope` splits the
// linear field out of its wrapper, and `take` receives exactly that claim.
// The wrapper's residual fields carry no obligation.
data Grant [linear] { raw: u64; }

data Envelope {
    grant: Grant;
    tag: u64;
}

data Main { kept: u64; }

boundary trait GrantTake {
    machine take(grant: Grant) reaches;
}

machine Main::main(main: &mut Main) {
    let envelope: Envelope = Envelope { grant: Grant { raw: 42 }, tag: 7 };
    let { grant, tag } = envelope;
    GrantTake::take(grant);
    main.kept = tag;
}
