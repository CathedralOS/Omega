data Token { value: u64; }

machine Token::drop(token: &mut Token) { token.value = 0; }

machine replacement_value(index: &mut u64) -> u64 {
    index = 3;
    19
}

machine main() crashes Trap {
    let mut tokens: [Token; 2] = [Token { value: 11 }, Token { value: 7 }];
    let mut index: u64 = 0;
    // The construction's scalar producer changes the selector out of range.
    // Neither cleanup nor store may re-evaluate that now-invalid selector.
    tokens[index] = Token { value: replacement_value(&mut index) };
    transition index == 3 && tokens[0].value == 19 && tokens[1].value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
