// A `&` loan may name a whole array member: `&main.row.cells` lends a
// read-only view of all four elements — the callee indexes the view while
// the caller's array stays owned.
data Row {
    cells: [u64; 4];
    tag: u64;
}

data Main { row: Row; }

machine Main::first(cells: &[u64; 4]) -> u64 {
    cells[0]
}

machine Main::main(main: &mut Main) {
    main.row = Row { cells: [10, 20, 30, 40], tag: 7 };
    let head: u64 = Main::first(&main.row.cells);
    let tag: u64 = main.row.tag;
}
