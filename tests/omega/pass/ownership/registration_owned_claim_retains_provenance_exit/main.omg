// Expected exit: 0.
// A qualification-only cast transfers the same linear claim. Omitting the
// displayed suffix does not destroy its exact origin or permit a second owner.
use omega::language::core::content;
use omega::language::core::drop;

data Slot {}
data Capacity [linear] {}
domain Capacity::Held established by acquire;
machine Held::content(capacity: &Capacity) -> CountedQuantity<Slot>
satisfies Content<Capacity, CountedQuantity<Slot>>::project {
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
machine Capacity::drop(capacity: &mut Capacity) {}
machine acquire() -> Capacity in Capacity::Held { Capacity {} }
machine main() {
    let capacity: Capacity in Capacity::Held = acquire();
    let transferred: Capacity = capacity as Capacity;
    let retained: Capacity in Capacity::Held = transferred as Capacity in Capacity::Held;
    drop(retained);
}
