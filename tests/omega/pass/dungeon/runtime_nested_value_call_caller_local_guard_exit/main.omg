// A guarded transition on a value call whose NESTED inline value call returns a
// comparison against the CALLER's fold-only local: `should_carve` computes
// `let chance = max(15, 80 - depth * 6)` and returns `self.rng.chance(random,
// chance, 100)`; chance's leaf value is `roll < numerator` where `numerator`
// binds to should_carve's local `chance`, which has NO frame slot (the storage
// planner expects it to fold). The leaf context could not resolve the name as
// a place, so the call-result write was silently dropped and the guard byte
// stayed 0 -- the TRUE arm never fired (the dungeon's side rooms R05/R06 were
// never carved, rendering empty descriptions). Exit 70 = the comparison value
// is computed and the true arm dispatches (interpreter semantics); exit 71 =
// the result-slot write was lost and the false arm ran.
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data RandomState {
    seed: u64 in Wrapping;
    calls: UInt;
}

data Random {
}

data Roller {
    rng: Random;
}

data Main {
    console: Console;
    roller: Roller;
}

machine Main::main(&mut self) {
    let random: RandomState;
    random.seed = 1;
    random.calls = 0;

    // seed 1: first draw raw = 48 -> 48 % 100 = 48 < 68, so should_carve(2) is
    // true and the TRUE arm must dispatch.
    transition self.roller.should_carve(&mut random, 2) {
        true -> carved()
        false -> skipped()
    }

    state carved(&mut self) {
        self.console.exit_process(70);
    }

    state skipped(&mut self) {
        self.console.exit_process(71);
    }
}

machine Roller::should_carve(&mut self, random: &mut RandomState, depth: u32) -> bool {
    let chance: u32 = max(15, 80 - depth * 6);
    let rolled: bool = self.rng.chance(random, chance, 100);

    transition {
        _ -> rolled
    }
}

machine Random::next_u32(&mut self, state: &mut RandomState) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;

    transition {
        _ -> (narrow_u64_to_u32_wrapping(state.seed >> 32))
    }
}

machine Random::range(&mut self, state: &mut RandomState, exclusive_max: u32) -> u32 {
    let raw: u32 = self.next_u32(state);

    transition {
        _ -> (raw % exclusive_max)
    }
}

machine Random::chance(
    &mut self,
    state: &mut RandomState,
    numerator: u32,
    denominator: u32
    ) -> bool {
    let roll: u32 = self.range(state, denominator);

    transition {
        _ -> (roll < numerator)
    }
}
