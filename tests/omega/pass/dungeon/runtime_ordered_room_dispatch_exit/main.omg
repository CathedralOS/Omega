use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let mut current_room: u64 = 2;
    let mut fountain_used: bool = false;
    let mut bat_defeated: bool = true;
    let mut treasure_taken: bool = false;

    transition (
        current_room,
        fountain_used,
        bat_defeated,
        treasure_taken
    ) {
        (0, _, _, _) -> gate(&mut self)
        (1, true, _, _) -> spent(&mut self)
        (1, false, _, _) -> fountain(&mut self)
        (2, _, true, _) -> ambush_clear(&mut self)
        (2, _, false, _) -> ambush(&mut self)
        (3, _, _, true) -> looted(&mut self)
        _ -> vault(&mut self)
    }

    state gate(main: &mut Main) {
        main.console.exit_process(70);
    }

    state spent(main: &mut Main) {
        main.console.exit_process(71);
    }

    state fountain(main: &mut Main) {
        main.console.exit_process(72);
    }

    state ambush_clear(main: &mut Main) {
        main.console.exit_process(73);
    }

    state ambush(main: &mut Main) {
        main.console.exit_process(74);
    }

    state looted(main: &mut Main) {
        main.console.exit_process(75);
    }

    state vault(main: &mut Main) {
        main.console.exit_process(76);
    }
}
