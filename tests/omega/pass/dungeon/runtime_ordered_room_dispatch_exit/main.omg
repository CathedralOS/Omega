use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let mut current_room: u64 = 2;
    let mut fountain_used: bool = false;
    let mut bat_defeated: bool = true;
    let mut treasure_taken: bool = false;

    transition (
        current_room,
        fountain_used,
        bat_defeated,
        treasure_taken
    ) {
        (0, _, _, _) -> gate()
        (1, true, _, _) -> spent()
        (1, false, _, _) -> fountain()
        (2, _, true, _) -> ambush_clear()
        (2, _, false, _) -> ambush()
        (3, _, _, true) -> looted()
        _ -> vault()
    }

    state gate(&mut self) {
        self.console.exit_process(70);
    }

    state spent(&mut self) {
        self.console.exit_process(71);
    }

    state fountain(&mut self) {
        self.console.exit_process(72);
    }

    state ambush_clear(&mut self) {
        self.console.exit_process(73);
    }

    state ambush(&mut self) {
        self.console.exit_process(74);
    }

    state looted(&mut self) {
        self.console.exit_process(75);
    }

    state vault(&mut self) {
        self.console.exit_process(76);
    }
}
