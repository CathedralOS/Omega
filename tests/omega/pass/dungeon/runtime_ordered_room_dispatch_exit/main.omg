use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut current_room: u64 = 2;
    let mut fountain_used: bool = false;
    let mut bat_defeated: bool = true;
    let mut treasure_taken: bool = false;

    transition (
        current_room,
        fountain_used,
        bat_defeated,
        treasure_taken
    ) {
        (0, _, _, _) -> gate(main)
        (1, true, _, _) -> spent(main)
        (1, false, _, _) -> fountain(main)
        (2, _, true, _) -> ambush_clear(main)
        (2, _, false, _) -> ambush(main)
        (3, _, _, true) -> looted(main)
        _ -> vault(main)
    }

    state gate(main: &mut Main) {
        Console::exit_process(70);
    }

    state spent(main: &mut Main) {
        Console::exit_process(71);
    }

    state fountain(main: &mut Main) {
        Console::exit_process(72);
    }

    state ambush_clear(main: &mut Main) {
        Console::exit_process(73);
    }

    state ambush(main: &mut Main) {
        Console::exit_process(74);
    }

    state looted(main: &mut Main) {
        Console::exit_process(75);
    }

    state vault(main: &mut Main) {
        Console::exit_process(76);
    }
}
