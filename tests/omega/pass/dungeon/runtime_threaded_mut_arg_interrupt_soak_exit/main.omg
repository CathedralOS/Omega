// Soak test for threaded `&mut` arguments under kernel preemption.
//
// The dispatch loop copies pointer-sized frame slots with load/store pairs
// through a scratch register. On Darwin arm64 the kernel ZEROES x18 (the
// reserved platform register) on every kernel->user return, so a value parked
// in x18 across a timer interrupt is silently replaced with 0 -- the dungeon
// crawler segfaulted this way when a threaded `&mut Level` slot copy lost its
// pointer mid-generation (nondeterministic, landing wherever the first tick
// fell). This canary threads a `&mut Tally` through a dispatched call fifty
// million times so the run spans many timer ticks; if any emitted slot copy
// parks data in an interrupt-clobbered register, the pointer (or the count)
// corrupts and the run crashes or exits 71 instead of 70.
use omega_language_std::console;

data Tally {
    // Defined-overflow domain: the threaded `&mut` sink keeps unconditional
    // bump semantics while `value + 1` is a wrapping, not exact, increment.
    value: u64 in Wrapping;
}

data Stepper {
}

machine Stepper::bump(tally: &mut Tally) {
    tally.value = tally.value + 1;
}

data Main {
    stepper: Stepper;
    tally: Tally;
}

machine Main::main(main: &mut Main) reaches Console {
    main.tally.value = 0;

    transition {
        _ -> spin(main, &mut main.tally, 0, 50000000)
    }

    state spin(
        main: &mut Main,
        tally: &mut Tally,
        // Defined-overflow counter: the unconditional `index + 1` increments a
        // value threaded through a mutating call, matching the corpus's own
        // soak-loop convention (`u64 in Wrapping`).
        index: u64 in Wrapping,
        count: u64
    ) {
        Stepper::bump(tally);
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < count;

        transition {
            has_next -> spin(main, tally, next_index, count)
            _ -> check(main)
        }
    }

    state check(main: &mut Main) {
        transition main.tally.value == 50000000 {
            true -> full_count(main)
            false -> dropped_count(main)
        }
    }

    state full_count(main: &mut Main) {
        Console::exit_process(70);
    }

    state dropped_count(main: &mut Main) {
        Console::exit_process(71);
    }
}
