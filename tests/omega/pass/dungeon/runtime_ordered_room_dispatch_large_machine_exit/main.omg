use omega_language_std::console;

domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data CommandParser {}

data GameView {}

machine GameView::render_title(
    &mut self,
    console: &mut Console
) {
    console.write_line("Dungeon Crawler");
}

machine GameView::render_prompt(
    &mut self,
    console: &mut Console
) {
    console.write("> ");
}

machine GameView::render_line(
    &mut self,
    line: &[u8],
    console: &mut Console
) {
    console.write_line(line);
}

data Dungeon {
    room_zero_seen: bool;
    room_one_seen: bool;
    room_two_seen: bool;
    room_three_seen: bool;
}

machine Dungeon::enter_room(
    &mut self,
    room_index: u64
) {
    transition {
        _ -> mark_current_room(room_index)
    }

    state mark_current_room(&mut self, room_index: u64) {
        transition room_index {
            0 -> mark_zero()
            1 -> mark_one()
            2 -> mark_two()
            _ -> mark_three()
        }
    }

    state mark_zero(&mut self) {
        self.room_zero_seen = true;
    }

    state mark_one(&mut self) {
        self.room_one_seen = true;
    }

    state mark_two(&mut self) {
        self.room_two_seen = true;
    }

    state mark_three(&mut self) {
        self.room_three_seen = true;
    }
}

data Main {
    console: Console;
    dungeon: Dungeon;
    parser: CommandParser;
    view: GameView;
    input: [u8; 32];
    input_count: u64;
    output: [u8; 32] in Utf8;
    current_room_index: u64;
    fountain_used: bool;
    bat_defeated: bool;
    treasure_taken: bool;
}

machine Main::main(&mut self) {
    self.output = "";
    self.input_count = 0;
    self.current_room_index = 2;
    self.fountain_used = false;
    self.bat_defeated = true;
    self.treasure_taken = false;

    self.view.render_title(&mut self.console);

    transition {
        _ -> enter_room()
    }

    state enter_room(&mut self) {
        self.dungeon.enter_room(self.current_room_index);

        transition (
            self.current_room_index,
            self.fountain_used,
            self.bat_defeated,
            self.treasure_taken
        ) {
            (0, _, _, _) -> show_gate_room()
            (1, true, _, _) -> show_spent_fountain_room()
            (1, false, _, _) -> show_fountain_room()
            (2, _, true, _) -> show_ambush_room()
            (2, _, false, _) -> show_ambush_encounter()
            (3, _, _, true) -> show_looted_vault_room()
            _ -> show_vault_room()
        }
    }

    state prompt(&mut self) {
        self.view.render_prompt(&mut self.console);
        transition self.input_count <= self.input.len && self.input[0..self.input_count] == "exit" {
            true -> finished()
            false -> invalid_command()
        }
    }

    state read_command(&mut self) {
        let observed: LineReadResult = self.console.read_line(&mut self.input);
        transition observed {
            LineReadResult::LineComplete { count } -> bounded_input(count, true)
            LineReadResult::EndOfInput { count } -> bounded_input(count, false)
            LineReadResult::Full { count } -> invalid_command()
            LineReadResult::Invalid -> invalid_command()
        }
    }

    // Normalize this command/echo protocol explicitly; the reader preserves raw bytes.
    state bounded_input(&mut self, count: u64, complete: bool) {
        transition count <= self.input.len {
            true -> normal_input(count, complete)
            false -> invalid_command()
        }
    }
    state normal_input(&mut self, count: u64, complete: bool) {
        transition complete {
            true -> completed_input(count)
            false -> parsed_input(count)
        }
    }
    state completed_input(&mut self, count: u64) {
        transition count > 0 && count <= self.input.len {
            true -> trim_carriage_return(count - 1)
            false -> invalid_command()
        }
    }
    state trim_carriage_return(&mut self, count: u64) {
        transition count > 0 && count <= self.input.len {
            true -> inspect_carriage_return(count, count - 1)
            false -> parsed_input(count)
        }
    }
    state inspect_carriage_return(&mut self, count: u64, byte_index: u64) {
        transition byte_index < self.input.len && self.input[byte_index] == 13 {
            true -> parsed_input(byte_index)
            false -> parsed_input(count)
        }
    }

    state parsed_input(&mut self, count: u64) {

        self.input_count = count;
        transition {
            count <= self.input.len && self.input[0..count] == "look" -> look()
            count <= self.input.len && self.input[0..count] == "help" -> exits()
            count <= self.input.len && self.input[0..count] == "use" -> use_event()
            count <= self.input.len && self.input[0..count] == "fight" -> fight()
            _ -> invalid_command()
        }
    }

    state look(&mut self) {
        transition (
            self.current_room_index,
            self.fountain_used,
            self.bat_defeated,
            self.treasure_taken
        ) {
            (0, _, _, _) -> look_gate_room()
            (1, true, _, _) -> look_spent_fountain_room()
            (1, false, _, _) -> look_fountain_room()
            (2, _, true, _) -> look_ambush_room()
            (2, _, false, _) -> look_ambush_encounter()
            (3, _, _, true) -> look_looted_vault_room()
            _ -> look_vault_room()
        }
    }

    state exits(&mut self) {
        transition (self.current_room_index, self.bat_defeated) {
            (0, _) -> show_gate_paths()
            (1, _) -> show_fountain_paths()
            (2, true) -> show_ambush_paths()
            (2, false) -> show_ambush_blocked_paths()
            _ -> show_vault_paths()
        }
    }

    state use_event(&mut self) {
        self.output = "use";
        self.view.render_line(self.output, &mut self.console);
        transition {
            _ -> prompt()
        }
    }

    state fight(&mut self) {
        self.output = "fight";
        self.view.render_line(self.output, &mut self.console);
        transition {
            _ -> prompt()
        }
    }

    state invalid_command(&mut self) {
        self.output = "invalid";
        self.view.render_line(self.output, &mut self.console);
        transition {
            _ -> finished()
        }
    }

    state show_gate_room(&mut self) {
        self.console.exit_process(100);
    }

    state show_spent_fountain_room(&mut self) {
        self.console.exit_process(101);
    }

    state show_fountain_room(&mut self) {
        self.console.exit_process(102);
    }

    state show_ambush_room(&mut self) {
        self.console.exit_process(103);
    }

    state show_ambush_encounter(&mut self) {
        self.console.exit_process(104);
    }

    state show_looted_vault_room(&mut self) {
        self.console.exit_process(105);
    }

    state show_vault_room(&mut self) {
        self.console.exit_process(106);
    }

    state look_gate_room(&mut self) {
        self.console.exit_process(110);
    }

    state look_spent_fountain_room(&mut self) {
        self.console.exit_process(111);
    }

    state look_fountain_room(&mut self) {
        self.console.exit_process(112);
    }

    state look_ambush_room(&mut self) {
        self.console.exit_process(113);
    }

    state look_ambush_encounter(&mut self) {
        self.console.exit_process(114);
    }

    state look_looted_vault_room(&mut self) {
        self.console.exit_process(115);
    }

    state look_vault_room(&mut self) {
        self.console.exit_process(116);
    }

    state show_gate_paths(&mut self) {
        self.console.exit_process(120);
    }

    state show_fountain_paths(&mut self) {
        self.console.exit_process(121);
    }

    state show_ambush_paths(&mut self) {
        self.console.exit_process(122);
    }

    state show_ambush_blocked_paths(&mut self) {
        self.console.exit_process(123);
    }

    state show_vault_paths(&mut self) {
        self.console.exit_process(124);
    }

    state finished(&mut self) {
        self.console.exit_process(125);
    }
}
