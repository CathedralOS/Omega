// Package review must retain an implementation-valued parent argument.
// This is ordinary named conformance, not a structural machine binder.
public trait Policy {
    machine value() -> u64;
}

public SelectedPolicy satisfies Policy {
    machine value() -> u64 { 42 }
}

public trait WithPolicy<P satisfies Policy> {
    machine inherited() -> u64;
}

public trait Interface: WithPolicy<SelectedPolicy> {
    machine read() -> u64;
}

public Reader satisfies Interface {
    machine inherited() -> u64 { SelectedPolicy::value() }
    machine read() -> u64 { SelectedPolicy::value() }
}
