// Expected exit: 0
// The target realization table supplies F32::negate; no Build program may
// select the library's unused provider for it. The program calls only the
// classifier; the library has no entry.
use numeric_library;

machine main() {
    transition is_nan(0.0f32) {
        false -> check_nan()
        _ -> fail()
    }
    machine check_nan() {
        let zero: f32 = 0.0f32;
        transition is_nan(zero / zero) {
            true -> done()
            _ -> fail()
        }
    }
    machine done() {}
    machine fail() { crash Trap; }
}
