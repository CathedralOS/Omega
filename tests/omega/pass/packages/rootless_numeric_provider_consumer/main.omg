// Expected exit: 0
// The root explicitly chooses its library's negate provider over the competing
// defaults. The program calls only the classifier; the library has no entry.
use omega::language::core::float_operations;
use numeric_library::main;

machine main() {
    transition is_nan(0.0f32) {
        false -> check_nan()
        _ -> fail()
    }
    machine check_nan() {
        let zero: f32 = 0.0f32;
        transition is_nan(zero / zero) {
            true -> done()
            _ -> fail()
        }
    }
    machine done() {}
    machine fail() { crash Trap; }
}
