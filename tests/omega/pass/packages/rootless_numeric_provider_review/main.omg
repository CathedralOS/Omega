// A reusable numeric library has no ProgramEntry. Review must retain supplied
// external declarations even when no call selects their implementation.
use omega::language::core::F32::negate;
use omega::language::core::F32::is_nan;

public trait NumericProviderMember {
    machine native_negate(value: f32) -> f32;
}

public UnusedNumericProvider satisfies NumericProviderMember {
    machine native_negate(value: f32) -> f32
        satisfies F32::negate
        via ForeignBinding::CompilerIntrinsic;
}

public machine is_nan(value: f32) -> bool {
    F32::is_nan(value)
}
