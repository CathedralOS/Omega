// Expected exit: 0
// Public data predicates retain their exact subject and case payload in review.
public data Locator
    requires ((self in Locator::Absolute) && self.length == 0)
       || ((self in Locator::Module) && self.length <= 2)
{
    case Absolute(length: u64);
    case Module(length: u64);
}
machine main() crashes Trap {
    check_absolute(Locator::Absolute { length: 0 });
    check_module(Locator::Module { length: 2 });
}
machine check_absolute(value: Locator) crashes Trap {
    transition value {
        Locator::Absolute { length } -> check(length)
        Locator::Module { length } -> bad()
    }
    machine check(length: u64) {
        transition length == 0 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine check_module(value: Locator) crashes Trap {
    transition value {
        Locator::Module { length } -> check(length)
        Locator::Absolute { length } -> bad()
    }
    machine check(length: u64) {
        transition length == 2 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
