use omega_language_std::console;

machine first(calls: &mut u64 in Wrapping) -> u64
ensures result >= 1 && result <= 1 {
    calls = calls * 10 + 1;
    1
}
machine last(calls: &mut u64 in Wrapping) -> u64
ensures result >= 3 && result <= 3 {
    calls = calls * 10 + 2;
    3
}
data Main {
    values: [u8; 4];
    calls: u64 in Wrapping;
}
machine Main::main(context: &mut Main) reaches Console {
    let view: &[u8] = &context.values[first(&mut context.calls)..last(&mut context.calls)];
    transition view.len == 2 && context.calls == 12 {
        true -> good(context)
        false -> bad(context)
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
