use omega_language_std::console;

data Entry [copy] {
    value: i32 in Wrapping;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    let entry_view: &[Entry] = &main.entries[..];

    transition entry_view.len > 0 {
        true -> sum_entries(main, entry_view, 0, 0)
        false -> bad(main)
    }

    state sum_entries(
        main: &Main,
        entries: &[Entry],
        index: u64 in Wrapping,
        total: i32 in Wrapping
    ) {
        let current: Entry = entries[index];
        let next_total: i32 in Wrapping = total + 1;
        let next_index: u64 in Wrapping = index + 1;
        let has_next: bool = next_index < entries.len;

        transition has_next {
            true -> sum_entries(main, entries, next_index, next_total)
            false -> check_total(main, next_total)
        }
    }

    state check_total(main: &Main, total: i32 in Wrapping) {
        transition total == 4 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &Main) {
        Console::exit_process(91);
    }

    state bad(main: &Main) {
        Console::exit_process(92);
    }
}
