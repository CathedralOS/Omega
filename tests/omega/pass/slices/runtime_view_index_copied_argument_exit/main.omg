use omega_language_std::console;
use omega::language::core::binding;
data Entry [copy] { value: [u64; 1]; }
data Main { console: Binding<Console>; entries: [Entry; 2]; }
machine observe(selected: Entry) -> u64 { selected.value[0] }
machine read_entry(entries: &[Entry], index: u64) -> u64
requires index < entries.len;
{
    observe(entries[index])
}
machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value[0] = 70;
    let entries: &[Entry] = main.entries.as_slice();
    let value: u64 = read_entry(entries, 0u64);
    transition value == 70 { true -> good(main) false -> bad(main) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
