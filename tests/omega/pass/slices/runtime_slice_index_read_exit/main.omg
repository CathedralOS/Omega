use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: i32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
}

machine Main::main(&mut self) reaches Console {
    self.entries[0].value = 7;

    let entry_view: &[Entry] = self.entries.as_slice();
    let index: u64 = 0;

    transition entry_view[index].value == 7 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(41);
    }

    state bad(&mut self) {
        self.console.exit_process(42);
    }
}
