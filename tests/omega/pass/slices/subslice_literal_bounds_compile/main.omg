data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = main.entries.as_slice();
    let prefix: &[Entry] = view[..4];
    let middle: &[Entry] = view[1..3];
    let empty_tail: &[Entry] = view[4..];
    prefix.len + middle.len + empty_tail.len
}
