domain i32::Small(value) requires 0 <= value && value <= 100;
machine copy(items: &[i32 in Small; 3], index: u64) -> i32 in Small
requires index < 3 { items[index] }
machine main() crashes Trap {
 let mut items: [i32 in Small; 3];
 items[0] = 11; items[1] = 39; items[2] = 13;
 let chosen: i32 in Small = copy(&items, 1);
 items[1] = 27;
 transition chosen == 39 && items[0] == 11 && items[1] == 27 && items[2] == 13 {
 true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
