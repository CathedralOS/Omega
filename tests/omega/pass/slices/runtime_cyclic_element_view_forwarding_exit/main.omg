// A mutable element view forwarded through a cycle still writes the selected caller element and leaves its neighbor unchanged.
// Expected exit: 0
machine write(items: &mut [i32])
requires items.len > 1
{
    transition { _ -> carry(items, 0) }
    machine carry(items: &mut [i32], seen: u64)
    requires items.len > 1
    {
        transition seen == 0 {
            true -> carry(items, 1)
            false -> store(items)
        }
    }
    machine store(items: &mut [i32])
    requires items.len > 1
    {
        items[1] = 23;
    }
}
machine main() crashes Trap {
    let mut items: [i32; 2];
    let view: &mut [i32] = &mut items[..];
    write(view);
    transition items[0] == 0 && items[1] == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
