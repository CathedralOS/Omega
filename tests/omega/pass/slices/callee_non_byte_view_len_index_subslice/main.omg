// A callee receives a non-byte-element borrowed view (`&[Entry]`) and uses all
// three view vocabulary operations in one body: `sub.len` for the extent guard,
// `sub[index]` for element indexing, and `sub[1..]` to materialize a tail
// subslice whose own `len` and element index are then exercised. The borrowed
// descriptor must carry through the call boundary for every operation, not
// just the length fact. The callees take only the view: forwarding `&mut Main`
// beside a live shared loan of `main.entries` would alias that loan.

use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

// The executable entry exits with the result the view operations select:
// entries[1].value through `sub[index]` and the tail's first element, 9.
machine Main::run(context: &mut Main) reaches Console {
    let result: i32 = Main::main(context);
    Console::exit_process(result);
}

machine Main::main(main: &mut Main) -> i32 {
    main.entries[1].value = 9;

    let view: &[Entry] = &main.entries[..];
    let index: u64 = 1;
    let selected: i32 = Main::inspect(view, index);
    (selected)
}

machine Main::inspect(sub: &[Entry], index: u64) -> i32 {
    transition sub.len >= 1 && index < sub.len {
        true -> confirmed(sub, index)
        false -> 0
    }

    state confirmed(sub: &[Entry], index: u64) -> i32 {
        let first: i32 = Main::confirm(sub[1..], sub[index].value);
        (first)
    }
}

machine Main::confirm(tail: &[Entry], chosen: i32) -> i32 {
    transition tail.len >= 1 {
        true -> emit(tail[0].value)
        false -> chosen
    }

    state emit(first: i32) -> i32 {
        transition {
            _ -> first
        }
    }
}
