machine build(builder: &mut Build) {
    Build::application(builder, "callee_non_byte_view_len_index_subslice");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::run);
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::run);
    builder.roots.bind(linux_arm64::ProgramEntry, Main::run);
    builder.roots.bind(macos_arm64::ProgramEntry, Main::run);
}
