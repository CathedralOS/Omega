// A `Granted & Vacant` value carries the dormant-content
// qualification into a `Vacant`-qualified field — construction is
// admitted; only the qualifier-free source shape is an implicit
// strengthening (fail territory).
use omega::language::core::extent;
data Held {
    e: Extent in Granted & Vacant;
}
machine keep(whole: Extent in Granted & Vacant) -> Extent
{
    let held: Held = Held { e: whole };
    held.e as Extent
}
data Main {}
machine Main::main(main: &mut Main) { }
