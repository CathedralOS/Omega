use omega::language::core::extent;
// `no_wrap(base, length)` is a bodyless authority requires; `embed` and
// `addr::Bound` are the geometry terms an ensures can cite. (`ExtentSlot`
// is package-private — filed under "Gaps found" in README.)
machine no_wrap_is_geometry(base: addr, length: u64)
    requires no_wrap(base, length)
    ensures embed(base) + embed(length) <= addr::Bound
{}
machine main() {
}
