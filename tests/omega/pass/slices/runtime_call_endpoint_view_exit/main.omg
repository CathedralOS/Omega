use omega_language_std::console;

data Window {}
machine Window::endpoint<const N: u64>(witness: &[u8; N]) -> u64
requires N <= 3
ensures result <= 3
{ N }

data Main {
    values: [u8; 4];
}

machine Main::main(context: &mut Main) reaches Console {
    context.values[0] = 17;
    context.values[1] = 42;
    let pair: [u8; 2] = [0, 0];
    let view: &[u8] = &context.values[..Window::endpoint(&pair)];
    transition view.len == 2 {
        true -> good(context)
        false -> bad(context)
    }
    machine good(context: &mut Main) { Console::exit_process(70); }
    machine bad(context: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
