// A `[copy]` record holding a shared text view and a scalar crosses
// state edges by value: `inspect(main.badge)` copies the record out of
// the receiver into the successor's owned parameter — the view field
// travels as its two-word descriptor (image backing + extent) beside
// the scalar; each state reads its own copy.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Badge [copy] {
    label: &[u8] in Utf8;
    rank: u64;
}
data Main {
    badge: Badge;
}
machine Main::main(main: &mut Main) {
    main.badge.label = "north";
    main.badge.rank = 9;
    transition { _ -> inspect(main, main.badge) }
    machine inspect(main: &mut Main, badge: Badge) {
        transition badge.label.len == 5 && badge.rank == 9 {
            true -> confirm(main, badge)
            _ -> done(main)
        }
    }
    machine confirm(main: &mut Main, badge: Badge) {
        transition badge.label == "north" {
            true -> done(main)
            _ -> done(main)
        }
    }
    machine done(main: &mut Main) { }
}
