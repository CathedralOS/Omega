domain i32::Small(value) requires 0 <= value && value <= 100;
machine write(items: &mut [i32 in Small; 3], index: u64, value: i32 in Small)
requires index < 3 { items[index] = value; }
machine main() crashes Trap {
    let mut items: [i32 in Small; 3];
    items[0] = 11; items[1] = 39; items[2] = 13;
    write(&mut items, 1, 27);
    transition items[0] == 11 && items[1] == 27 && items[2] == 13 {
        true -> done() _ -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
