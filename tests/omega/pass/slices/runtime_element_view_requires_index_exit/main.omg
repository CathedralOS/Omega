use omega_language_std::console;

machine read(values: &[u32], position: u64) -> u32
requires position < values.len;
{
    values[position]
}

data Main {
    values: [u32; 4];
}

machine Main::main(context: &mut Main) reaches Console {
    context.values[2] = 105;
    let view: &[u32] = &context.values[..];
    transition 2 < view.len {
        true -> observe(view)
        false -> bad(context)
    }
    state observe(values: &[u32]) {
        let observed: u32 = read(values, 2);
        let code: i32 = match observed == 105 { true -> 70, false -> 71 };
        Console::exit_process(code);
    }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
