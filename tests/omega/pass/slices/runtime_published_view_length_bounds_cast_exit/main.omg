machine middle(items: &[u8; 4]) -> &[u8]
ensures result.len == 2
{
    items[1..3]
}

machine main() crashes Trap {
    let bytes: [u8; 4] = [1, 2, 3, 4];
    let view: &[u8] = middle(&bytes);
    let length: u8 = view.len as u8;
    transition length == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
