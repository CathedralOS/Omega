data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();
    let start: u64 = 1;
    let width: u64 = 2;
    let end: u64 = start + width;
    let tail: &[Entry] = view[start..];
    let middle: &[Entry] = view[start..end];
    // `end - 3` binds to a local first: a bare computed index is fenced
    // since the R0 fence-order fix (the checker's facts fold used to accept
    // it while the backend read ZII -- this canary is compile-only, so the
    // miscompile was never observed; the folded-bound FACTS this canary
    // pins flow identically through the local).
    let pick: u64 = end - 3;
    let chosen: Entry = middle[pick];
    tail.len + middle.len
}
