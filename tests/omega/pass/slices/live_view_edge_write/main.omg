// Element-view write across a named edge: `release` establishes an
// exclusive `&mut [i32]` view, stores through it, then crosses an
// ordinary transition with the loan still live — the state's custody
// admits the view write without claiming a root of its own.
data Bag { cells: [i32; 4]; }

machine release(bag: &mut Bag) {
    let cells: &mut [i32] = &mut bag.cells[..];
    cells[2] = 7;
    transition { _ -> done() }
    machine done() {}
}

data Main { bag: Bag; }

machine Main::main(main: &mut Main) {
    release(&mut main.bag);
    transition main.bag.cells[2] == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
