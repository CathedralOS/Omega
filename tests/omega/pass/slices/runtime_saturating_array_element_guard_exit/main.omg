// SATURATING machine-array elements fused in GUARD operands -- the
// MachineIndexed operand variant and the decision-17 operand-domain lowering
// intersecting: `sarr[i] + sarr[1]` must CLAMP at the operation (200+100 ->
// 255) with no landing store, the element domain riding the ARRAY
// declaration (`[u8; 3] in Saturating`). The lowered form hoists the
// runtime-indexed element and computes the bool via a saturating binary
// write (`Add/1 in Saturating` in the backend report); the interpreter's
// domain witness resolves the element type through the declared array.
// Directions: clamp equality (200+100 == 255) and the ordering face
// (200+100 <= 255 -- true clamped, FALSE if a wide 300 leaked; 255 is
// representable in u8, unlike 256, whose byte-width truncation to 0 made an
// earlier draft fail on BOTH legs identically -- the literal-out-of-range
// compare face of the const-fold family). Runtime indexes keep the folder
// out. Third direction: BOTH operands runtime-indexed (no sibling for the
// witness fallback). Exit 70.
use omega_language_std::console;
data Main { sarr: [u8; 3] in Saturating; idx: u64; jdx: u64; }
machine Main::main(main: &mut Main) reaches Console {
    main.sarr = [200, 100, 50];
    main.idx = 0;
    main.jdx = 1;
    transition (main.idx < 3) && (main.jdx < 3) { true -> go(main.idx, main.jdx, main) _ -> bad(main) }
    state go(i: u64, j: u64, main: &mut Main) requires i <= 2, j <= 2 {
        transition (main.sarr[i] + main.sarr[1] == 255) { true -> ordered(main, i, j) _ -> bad_eq(main) }
    }
    state ordered(main: &mut Main, i: u64, j: u64) requires i <= 2, j <= 2 {
        // Bounded params forward range-preservingly (per-state env facts
        // cannot re-prove main.idx here; the param chain carries the proof).
        transition (main.sarr[i] + main.sarr[1] <= 255) { true -> both_runtime(main, i, j) _ -> bad_ord(main) }
    }
    state both_runtime(main: &mut Main, i: u64, j: u64) requires i <= 2, j <= 2 {
        // BOTH operands runtime-indexed: no const-indexed sibling exists for
        // the `.or()` witness fallback to lean on -- each side must resolve
        // its element domain independently through the data-field path.
        transition (main.sarr[i] + main.sarr[j] == 255) { true -> good(main) _ -> bad_both(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
    state bad_eq(main: &mut Main) { Console::exit_process(72); }
    state bad_ord(main: &mut Main) { Console::exit_process(73); }
    state bad_both(main: &mut Main) { Console::exit_process(74); }
}
