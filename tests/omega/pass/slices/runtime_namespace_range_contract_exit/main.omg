// Implementation qualification groups code, not a hidden data receiver.
trait Range {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len
    crashes Trap
        start > end;
}

Views satisfies Range {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len
    crashes Trap
        start > end
    {
        bytes[start..end]
    }
}

data Main { bytes: [u8; 4]; }

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[1] = 70;
    let middle: &[u8] = Views::middle(&main.bytes, 1, 3);
    transition middle.len == 2 && middle[0] == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
