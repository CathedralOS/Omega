// Reading a `&[T]` slice element by a RUNTIME index: `s[main.i]` where `s` is a
// borrowed slice (`&main.nums[..]`) and `main.i` is a runtime field. Like
// the inline-array read, this was a silent miscompile (the read emitted nothing
// and the target kept its zero value); the machine-indexed read encoder now
// covers it. Reads two runtime indices and self-checks. (Constant indices on a
// slice already worked.)

use omega_language_std::console;

data Main {
    nums: [i32; 4];
    i: i32 in Trapping;
    a: i32;
    b: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.nums[0] = 10;
    main.nums[1] = 20;
    main.nums[2] = 30;
    main.nums[3] = 40;

    transition {
        _ -> compute(main)
    }

    state compute(main: &mut Main) {
        let s: &[i32] = &main.nums[..];
        main.i = 1;
        main.a = s[main.i]; // 20
        main.i = 3;
        main.b = s[main.i]; // 40
        transition main.a == 20 {
            true -> check_b(main)
            _ -> bad(main)
        }
    }

    state check_b(main: &mut Main) {
        transition main.b == 40 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
