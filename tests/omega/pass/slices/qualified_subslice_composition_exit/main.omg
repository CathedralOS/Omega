// Primitive byte domains survive runtime subslices, another subslice through a
// helper parameter and a named local. Empty views remain valid ASCII views.
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
use omega_language_std::console;

data Main { end: u64; }

machine Main::main(main: &mut Main) {
    main.end = 4;
    Main::relay(main, "ABCDE");
}

machine Main::relay(main: &Main, bytes: &[u8] in Ascii) reaches Console {
    transition main.end < bytes.len {
        true -> Main::cut(main, bytes[0..main.end])
        false -> bad(main)
    }
    state bad(main: &Main) { Console::exit_process(71); }
}

machine Main::cut(main: &Main, prefix: &[u8] in Ascii) reaches Console {
    let empty: &[u8] = prefix[0..0];
    Main::inspect(main, empty, prefix);
}

machine Main::inspect(main: &Main, empty: &[u8] in Ascii, prefix: &[u8] in Ascii) reaches Console {
    transition empty.len == 0 && prefix == "ABCD" {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &Main) { Console::exit_process(70); }
    state bad(main: &Main) { Console::exit_process(71); }
}
