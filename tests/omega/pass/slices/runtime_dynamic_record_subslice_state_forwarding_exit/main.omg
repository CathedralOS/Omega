data Cell [copy] { value: i32; flag: bool; }

machine write(items: &mut [Cell], start: u64, end: u64)
requires start < end && end <= items.len
{
    transition { _ -> forwarded(true, &mut items[start..end]) }
    machine forwarded(marker: bool, selected: &mut [Cell])
    requires selected.len > 0
    {
        selected[0].value = 23;
        selected[0].flag = marker;
    }
}

machine main() crashes Trap {
    let mut items: [Cell; 3];
    items[0].value = 11;
    items[2].value = 13;
    let view: &mut [Cell] = &mut items[..];
    write(view, 1, 2);
    transition items[0].value == 11 && !items[0].flag
        && items[1].value == 23 && items[1].flag
        && items[2].value == 13 && !items[2].flag {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
