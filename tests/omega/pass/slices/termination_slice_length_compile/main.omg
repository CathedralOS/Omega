data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = main.entries.as_slice();

    transition {
        _ -> Main::walk(main, view)
    }
}

machine Main::walk(main: &Main, entries: &[Entry])
terminates by entries -> Slice::Length;
-> u64
{
    transition entries.len > 0 {
        true -> walk(main, entries[1..])
        false -> 0
    }
}
