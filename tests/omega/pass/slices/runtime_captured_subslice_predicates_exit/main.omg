// Subslice descriptors retain their established byte classes through local
// copies and repeated slicing, even after the original descriptor is rebound.
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
domain [u8]::NoNul(bytes) requires no_nul(bytes);

machine ascii_matches(bytes: &[u8] in Ascii, expected: &[u8]) -> bool {
    bytes == expected
}

machine no_nul_matches(bytes: &[u8] in NoNul, expected: &[u8]) -> bool {
    bytes == expected
}

machine ascii_windows(bytes: &[u8] in Ascii) -> bool {
    transition bytes.len >= 4 {
        true -> inspect(bytes)
        false -> short()
    }
    machine short() -> bool { false }
    machine inspect(bytes: &[u8] in Ascii) -> bool {
        let mut window: &[u8] = bytes[1..3];
        let saved: &[u8] = window;
        let nested: &[u8] = saved[0..1];
        window = "é";
        ascii_matches(nested, "B") && ascii_matches(saved, "BC") && window == "é"
    }
}

machine no_nul_windows(bytes: &[u8] in NoNul) -> bool {
    transition bytes.len >= 2 {
        true -> inspect(bytes)
        false -> short()
    }
    machine short() -> bool { false }
    machine inspect(bytes: &[u8] in NoNul) -> bool {
        let prefix: &[u8] = bytes[0..2];
        let empty: &[u8] = prefix[1..1];
        no_nul_matches(prefix, "Pa") && no_nul_matches(empty, "")
    }
}

machine main() crashes Trap {
    transition ascii_windows("ABCD") && no_nul_windows("Path") {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
