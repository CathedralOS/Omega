// `[u8; 0]` is a first-class value at check: admitted in locals,
// constants, parameters, returns, record fields, and nested arrays.
// `[]` or `""` constructs it exactly; it compares by value and reports
// `.len` = 0.
const EMPTY: [u8; 0] = "";

data Holder { bytes: [u8; 0]; }

machine first(rows: [[u8; 0]; 1]) -> [u8; 0] { rows[0] }

data Main {}

machine Main::main(main: &mut Main) {
    let from_literal: [u8; 0] = [];
    let from_bytes: [u8; 0] = "";
    let nested: [[u8; 0]; 0] = [];
    let held: Holder = Holder { bytes: [] };
    let selected: [u8; 0] = first([EMPTY]);
    let same: bool = from_literal == selected;
    let count: u64 = from_bytes.len;
    transition same && count == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
