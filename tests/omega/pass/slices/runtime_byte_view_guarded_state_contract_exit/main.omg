// A guard observes a caller-supplied view, then forwards that exact view to
// a state whose authored precondition names its own descriptor extent.
use omega_language_std::console;

machine contains_marker(bytes: &[u8], position: u64) -> bool {
    transition { _ -> check(bytes, position) }

    state check(bytes: &[u8], position: u64) -> bool {
        transition position < bytes.len {
            true -> inspect(bytes, position)
            false -> false
        }
    }

    state inspect(bytes: &[u8], position: u64) -> bool
    requires position < bytes.len;
    {
        bytes[position] == 70
    }
}

data Main {
    bytes: [u8; 3];
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[1] = 70;
    let found: bool = contains_marker(&main.bytes, 1);
    let outside: bool = contains_marker(&main.bytes, 3);
    transition found && !outside {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
