data Row { values: [i32; 4]; }
data Window { rows: [Row; 2]; }
machine write_pair(values: &mut [i32]) {
    transition values.len >= 2 {
        true -> write(values)
        _ -> skip()
    }
    state write(values: &mut [i32]) { values[0] = 7; values[1] = 9; }
    state skip() {}
}
machine ordinary(window: &mut Window, row: u64)
requires row < 2;
{ write_pair(&mut window.rows[row].values[1..3]); }
machine staged(window: &mut Window, row: u64)
requires row < 2;
{
    transition { _ -> next(window, row) }
    state next(window: &mut Window, row: u64)
    requires row < 2;
    { write_pair(&mut window.rows[row].values[0..2]); }
}
machine main() crashes Trap {
    let mut first: Window = Window { rows: [Row { values: [0, 0, 0, 0] }, Row { values: [0, 0, 0, 0] }] };
    let mut second: Window = Window { rows: [Row { values: [0, 0, 0, 0] }, Row { values: [0, 0, 0, 0] }] };
    ordinary(&mut first, 1);
    staged(&mut second, 0);
    transition first.rows[1].values[0] == 0 && first.rows[1].values[1] == 7 && first.rows[1].values[2] == 9
        && first.rows[1].values[3] == 0 && second.rows[0].values[0] == 7 && second.rows[0].values[1] == 9
        && second.rows[0].values[2] == 0 && second.rows[0].values[3] == 0
        && first.rows[0].values[0] == 0 && first.rows[0].values[1] == 0
        && first.rows[0].values[2] == 0 && first.rows[0].values[3] == 0
        && second.rows[1].values[0] == 0 && second.rows[1].values[1] == 0
        && second.rows[1].values[2] == 0 && second.rows[1].values[3] == 0 {
        true -> passed()
        _ -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
