data Row { marker: u64; values: [i32; 4]; }
data Window { marker: u64; rows: [Row; 2]; }
machine write_pair(values: &mut [i32]) {
    transition values.len >= 2 {
        true -> write(values)
        _ -> skip()
    }
    machine write(values: &mut [i32]) { values[0] = 7; values[1] = 9; }
    machine skip() {}
}
machine ordinary(window: &mut Window, row: u64)
requires row < 2;
{ write_pair(&mut window.rows[row].values[1..3]); }
machine staged(window: &mut Window, row: u64)
requires row < 2;
{
    transition { _ -> next(window, row) }
    machine next(window: &mut Window, row: u64)
    requires row < 2;
    { write_pair(&mut window.rows[row].values[0..2]); }
}
machine main() crashes Trap {
    let mut first: Window = Window { marker: 43, rows: [Row { marker: 101, values: [0, 0, 0, 0] }, Row { marker: 202, values: [0, 0, 0, 0] }] };
    let mut second: Window = Window { marker: 43, rows: [Row { marker: 101, values: [0, 0, 0, 0] }, Row { marker: 202, values: [0, 0, 0, 0] }] };
    ordinary(&mut first, 1);
    staged(&mut second, 0);
    transition first.marker == 43 && second.marker == 43
        && first.rows[0].marker == 101 && first.rows[1].marker == 202
        && second.rows[0].marker == 101 && second.rows[1].marker == 202
        && first.rows[1].values[0] == 0 && first.rows[1].values[1] == 7 && first.rows[1].values[2] == 9
        && first.rows[1].values[3] == 0 && second.rows[0].values[0] == 7 && second.rows[0].values[1] == 9
        && second.rows[0].values[2] == 0 && second.rows[0].values[3] == 0
        && first.rows[0].values[0] == 0 && first.rows[0].values[1] == 0
        && first.rows[0].values[2] == 0 && first.rows[0].values[3] == 0
        && second.rows[1].values[0] == 0 && second.rows[1].values[1] == 0
        && second.rows[1].values[2] == 0 && second.rows[1].values[3] == 0 {
        true -> passed()
        _ -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
