domain u64::Positive(value) requires value >= 1;

machine copy(values: &[u64 in Positive]) -> u64 in Positive
requires values.len == 2
{
    values[1]
}

machine main() crashes Trap {
    let mut values: [u64 in Positive; 2];
    values[0] = 7;
    values[1] = 42;
    let chosen: u64 in Positive = copy(&values[..]);
    values[1] = 9;
    transition chosen == 42 && values[0] == 7 && values[1] == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
