// RUNTIME-index slice-descriptor element read into a machine field
// (`main.got = s[i]`, i a ranged param) -- the runtime twin of the fixed
// copy, same width-0 history. Report shows the indexed copy op. -> exit 1.
use omega_language_std::console;
data Main {
    arr: [i32; 4];
    got: i32;
}
machine Main::main(main: &mut Main) reaches Console {
    main.arr[1] = 11;
    let s: &[i32] = &main.arr[..];
    transition s.len == 4 {
        true -> pick(main, s, 1)
        false -> no(main)
    }
    state pick(main: &mut Main, s: &[i32], i: u64) requires i <= 3 {
        transition i < s.len {
            true -> go(main, s, i)
            false -> no(main)
        }
    }
    state go(main: &mut Main, s: &[i32], i: u64) requires i <= 3 {
        main.got = s[i];
        transition main.got == 11 {
            true -> yes(main)
            false -> no(main)
        }
    }
    state yes(main: &mut Main) { Console::exit_process(1); }
    state no(main: &mut Main) { Console::exit_process(2); }
}
