// A runtime-indexed read at a MULTI-PREDECESSOR JOIN. `merge` is reached from both
// `left` and `right`; the index bound `idx < 4` is established once (before the
// branch) and carried to `merge` by the range checker's predecessor MEET -- a guard
// holds at a join when EVERY incoming edge carries it and none rewrites the field.
// Before the meet this required re-proving the bound in a guard state at the join.
//
// arr[2] == 30 -> exit 70.

use omega_language_std::console;

data Main {
    arr: [i32; 4];
    idx: u64;
    flag: bool;
    r: i32 in Trapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.arr[0] = 10;
    main.arr[1] = 20;
    main.arr[2] = 30;
    main.arr[3] = 40;
    main.idx = 2;
    main.flag = true;

    // Establish the bound once, before the branch.
    transition main.idx < 4 {
        true -> split(main)
        _ -> bad(main)
    }

    state split(main: &mut Main) {
        transition main.flag {
            true -> left(main)
            _ -> right(main)
        }
    }
    // Neither arm rewrites `idx`, so `idx < 4` survives both paths to `merge`.
    state left(main: &mut Main) {
        transition { _ -> merge(main) }
    }
    state right(main: &mut Main) {
        transition { _ -> merge(main) }
    }

    // Multi-predecessor join: the meet carries `idx < 4` here without a re-guard.
    state merge(main: &mut Main) {
        main.r = main.arr[main.idx] as i32 in Trapping;
        transition main.r == 30 { true -> good(main) _ -> bad(main) }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
