// A loop bound must cross a CONDITIONAL BRANCH to prove an indexed read. The
// bound `i < 4` is established at `loop_`; `check` reads `data[i]` (level-1) and
// branches on its value; `big` -- reached only via the `x > 50` arm -- reads
// `data[i]` AGAIN. That second read needs `i < 4` to hold at `big`'s entry even
// though `big`'s incoming edge is guarded by `x > 50`, not the loop bound.
//
// This is TRANSITIVE bound propagation: walking back from `big` finds `i < 4`
// one edge further up, and it still holds because the intermediate state
// (`check`) rewrites only `x`, never `i`. (A state that reassigned `i` would
// block it -- that is the soundness gate.) The same shape underlies the swap of
// an in-place sort. data[1] = 99 is the one value > 50, so `big` re-reads 99.

use omega_language_std::console;

data Main {
    console: Console;
    data: [i32; 4];
    i: i32 in Trapping;
    x: i32;
    found: i32;
}

machine Main::main(&mut self) {
    self.data[0] = 10;
    self.data[1] = 99;
    self.data[2] = 20;
    self.data[3] = 30;
    self.i = 0;
    self.found = 0;

    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        transition self.i < 4 {
            true -> check()
            _ -> done()
        }
    }

    state check(&mut self) {
        self.x = self.data[self.i];
        transition self.x > 50 {
            true -> big()
            _ -> advance()
        }
    }

    // Reached only through `check`'s `x > 50` arm; the `i < 4` bound must carry
    // here transitively for this indexed read to prove.
    state big(&mut self) {
        self.found = self.data[self.i];
        transition {
            _ -> advance()
        }
    }

    state advance(&mut self) {
        self.i = self.i + 1;
        transition {
            _ -> loop_()
        }
    }

    state done(&mut self) {
        transition self.found == 99 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
