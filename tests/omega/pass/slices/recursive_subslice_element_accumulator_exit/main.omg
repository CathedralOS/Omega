// RUN CANARY (exit 70). A tail-recursive value-returning machine whose
// accumulator argument READS a slice element of the SAME slice it subslices:
// `sum(s[1..], acc + s[0])`. The element `s[0]` must be read BEFORE the `s`
// parameter's descriptor is retargeted to `s[1..]`.
//
// Regression guard: argument materialization advanced the descriptor in place
// (s[1..]) and THEN read s[0] through it, so every step summed the NEXT
// window's head -- an off-by-one that made [5,10,15,20] sum wrong (native exit
// 71). `acc + 1` was immune (no slice read), so this slipped past the existing
// recursive-value canary. Fixed by reporting the element read's descriptor slot
// as a frame source even when nested inside a binary accumulator, so the
// argument-overlap detector stages the call. Interpreter was always correct.

use omega_language_std::console;

data Summer {}

data Main {
    arr: [i32 in Wrapping; 4];
    summer: Summer;
}

machine sum(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32 in Wrapping
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> sum(s[1..], acc + s[0])
        false -> acc
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.arr[0] = 5;
    main.arr[1] = 10;
    main.arr[2] = 15;
    main.arr[3] = 20;
    let s: &[i32 in Wrapping] = &main.arr[..];
    let total: i32 in Wrapping = sum(s, 0);
    transition total == 50 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
