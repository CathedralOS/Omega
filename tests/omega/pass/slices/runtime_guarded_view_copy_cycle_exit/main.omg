use omega_language_std::console;

data NameBuffer {
    bytes: [u8; 256];
    length: u64;
}

machine NameBuffer::copy_name(buffer: &mut NameBuffer, name: &[u8], limit: u64) {
    transition { _ -> copy(buffer, name, limit, 0) }

    state copy(buffer: &mut NameBuffer, name: &[u8], limit: u64, position: u64) {
        transition position < name.len && position < limit && position < 256 {
            true -> store(buffer, name, limit, position)
            false -> done(buffer, position)
        }
    }

    state store(buffer: &mut NameBuffer, name: &[u8], limit: u64, position: u64)
        requires 0 <= position && position < name.len && position < limit && position < 256
    {
        buffer.bytes[position] = name[position];
        transition { _ -> copy(buffer, name, limit, position + 1) }
    }

    state done(buffer: &mut NameBuffer, position: u64) {
        buffer.length = position;
    }
}

data Main {
    destination: NameBuffer;
    source: [u8; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.source[0] = 11;
    main.source[1] = 22;
    main.source[2] = 33;
    main.source[3] = 44;
    main.destination.bytes[3] = 99;
    NameBuffer::copy_name(&mut main.destination, &main.source, 3);
    transition main.destination.length == 3 && main.destination.bytes[0] == 11
        && main.destination.bytes[1] == 22 && main.destination.bytes[2] == 33
        && main.destination.bytes[3] == 99 {
        true -> zero_limit(main)
        false -> bad(main)
    }

    state zero_limit(main: &mut Main) {
        NameBuffer::copy_name(&mut main.destination, &main.source, 0);
        transition main.destination.length == 0 && main.destination.bytes[0] == 11 {
            true -> whole_input(main)
            false -> bad(main)
        }
    }

    state whole_input(main: &mut Main) {
        NameBuffer::copy_name(&mut main.destination, &main.source, 256);
        transition main.destination.length == 4 && main.destination.bytes[3] == 44 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
