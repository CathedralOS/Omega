// A narrowed local view keeps its own loan and element coordinates:
// `exits[1..3]` lends a sub-view, `tail[1..2]` narrows it further — it is
// neither a new collection owner nor a spelling of its parent's element
// zero. `crashes Trap` marks the machine's trapping operation class.
data Exit [copy] { code: u64; open: bool; }

machine blank_exit(code: u64) -> Exit {
    Exit { code: code, open: true }
}

machine fill(exits: &mut [Exit])
requires exits.len >= 4
{
    let tail: &mut [Exit] = &mut exits[1..3];
    tail[0].code = 11;
    tail[1] = blank_exit(43);
    let nested: &mut [Exit] = &mut tail[1..2];
    nested[0].open = false;
}

data Main {}

machine Main::main(main: &mut Main) crashes Trap {
    let mut exits: [Exit; 4];
    let exit_view: &mut [Exit] = &mut exits[..];
    fill(exit_view);
    transition exits[2].code == 43 && !exits[2].open && exits[0].code == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
