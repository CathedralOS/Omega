// Expected exit: 0. Replacing a descriptor preserves its new backing and old storage.
data Cell [copy] { value: u32; tag: u64; }
data Window<'input> { values: &'input mut [Cell]; }

machine observe(values: &[Cell]) -> bool {
    transition values.len == 2 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 2 {
        values[0].value == 42 && values[0].tag == 9223372036854775808
            && values[1].value == 19 && values[1].tag == 29
    }
}
machine main() crashes Trap {
    let mut original: [Cell; 1] = [Cell { value: 7, tag: 17 }];
    let mut replacement: [Cell; 2] = [Cell { value: 42, tag: 9223372036854775808 }, Cell { value: 19, tag: 29 }];
    let mut windows: [Window; 1] = [Window { values: &mut original[..] }];
    let view: &mut [Window] = &mut windows[..];
    view[0].values = &mut replacement[..];
    let returned: &mut [Cell] = &mut view[0].values[..];
    let valid: bool = observe(returned);
    transition valid && original[0].value == 7 && original[0].tag == 17 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
