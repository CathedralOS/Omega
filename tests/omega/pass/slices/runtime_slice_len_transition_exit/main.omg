use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) reaches Console {
    let entry_view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> check_len(entry_view)
    }

    state check_len(&mut self, entries: &[Entry]) {
        transition entries.len == 4 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(101);
    }

    state bad(&mut self) {
        self.console.exit_process(102);
    }
}
