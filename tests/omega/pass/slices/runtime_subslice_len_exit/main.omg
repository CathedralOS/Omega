// A borrowed `&[u8]` bound to a literal-bounded fixed-array subslice
// (`main.source[0..2]`) has a `.len` equal to the window width (`b - a`). When
// the local is used only for `.len`, it is inlined to `(main.source[0..2]).len`
// and never materialized, so the length must FOLD to the literal `b - a`
// (2) -- not fall through to a place read with no descriptor slot. Exits 70
// when `s.len == 2`.

use omega_language_std::console;

data Main {
    source: [u8; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.source[0] = 72;
    main.source[1] = 105;

    let s: &[u8] = main.source[0..2];

    let matches: bool = s.len == 2;
    transition matches {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
