use omega_language_std::console;

data Main {
    bytes: [u8; 4];
}

machine whole(bytes: &[u8]) -> &[u8] {
    let measured: u64 = bytes.len;
    let copied: u64 = measured;
    bytes[0..copied]
}

machine first_pair(bytes: &[u8]) -> u8 {
    transition bytes.len == 2 {
        true -> (bytes[0])
        _ -> (0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[1] = 70;
    let middle: &[u8] = main.bytes[1..3];
    let forwarded: &[u8] = whole(middle);
    let value: u8 = first_pair(forwarded);
    Console::exit_process(value as i32);
}
