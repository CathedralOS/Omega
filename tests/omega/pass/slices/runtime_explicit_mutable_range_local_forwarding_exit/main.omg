// `&mut items[1..3]` spells the mutable subrange explicitly
// (`bare-range-reference-access`). The resulting `&mut [i32]` binding then
// forwards to a call and to a state under ordinary rules: `fill(window)` and
// `forwarded(window)` need no second `&mut`.
machine fill(items: &mut [i32])
requires items.len > 0
{
    items[0] = 23;
}
machine write(items: &mut [i32])
requires items.len > 3
{
    let window: &mut [i32] = &mut items[1..3];
    fill(window);
    transition { _ -> forwarded(window) }
    machine forwarded(values: &mut [i32])
    requires values.len > 1
    {
        values[1] = 7;
    }
}
machine main() crashes Trap {
    let mut items: [i32; 4];
    let view: &mut [i32] = &mut items[..];
    write(view);
    transition items[0] == 0 && items[1] == 23 && items[2] == 7 && items[3] == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
