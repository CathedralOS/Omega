// A `&[Entry]` parameter subslices under an explicit guard:
// `entries[start..end]` is admitted when `start <= end && end <
// entries.len` dominates the edge, and the narrowed view forwards into
// a `&[Entry]` callee.
data Entry {
    value: i32;
}

data Main {}

machine Main::main(main: &mut Main) { }

machine choose(entries: &[Entry], start: u64, end: u64) -> u64 {
    transition start <= end && end < entries.len {
        true -> length(entries[start..end])
        false -> 0
    }
    machine length(entries: &[Entry]) -> u64 {
        transition {
            _ -> entries.len
        }
    }
}
