data Cell [copy] { value: u32; }
data Window<'input> { values: &'input mut [Cell]; }

// Store normalization captures both selectors. The outer capture preserves
// the identity of the nested descriptor measured by the precondition.
machine replace(windows: &mut [Window], outer: u64, inner: u64, replacement: Cell)
requires outer < windows.len && inner < windows[outer].values.len {
    windows[outer].values[inner] = replacement;
}
machine main() {}
