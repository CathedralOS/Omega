machine replace(values: &mut [u64]) {
    transition values.len > 0 {
        true -> write(values)
        false -> done()
    }
    machine write(values: &mut [u64]) {
        values[0] = 7;
    }
    machine done() {}
}

machine main() crashes Trap {
    let mut values: [u64; 2];
    replace(&mut values[0..2]);
    transition values[0] == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
