// The extent surface's authored denotation: `use
// omega::language::core::extent` brings `no_wrap`, and a machine may
// state `requires no_wrap(base, length)` — the address-extent
// non-wrapping fact as a checked requirement denotation.
use omega::language::core::extent;
machine geometry(base: addr, length: u64)
requires no_wrap(base, length)
{}
data Main {}
machine Main::main(main: &mut Main) { }
