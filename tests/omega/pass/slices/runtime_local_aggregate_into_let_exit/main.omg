// A LOCAL ARRAY literal read by a SUBSEQUENT let, then used as a value. This silently
// miscompiled to 0: the liveness scan (`statement_references_local`) inspected
// Expression/Assignment/Call/Transition statements but NOT a LocalData (`let`) value,
// so a read-only array referenced only by a later `let` was elided (no frame slot),
// and the indexed read resolved against a missing slot. Fixed by keeping the slot for
// an array-literal local referenced in a later let value. (Struct field reads fold to
// the literal field and never needed a slot; borrow-carrying structs must stay folded,
// so the gate is array-only.)
//
// Covers: local-array element into a let (`let a = arr[1]`), a second const index,
// a value-struct field into a let (`let px = p.x`, works via folding), a local-array
// element used as an arithmetic operand (`arr[0] + a + px`), and a slotted-array let
// passed to a VALUE-CALL (`self.dbl(a1)` -- previously broke before the array got a
// slot). Exits 70.

use omega_language_std::console;

data Pt {
    x: i32 in Wrapping;
    y: i32 in Wrapping;
}

data Main {
    console: Console;
}

machine Main::dbl(&self, n: i32 in Wrapping) -> i32 in Wrapping {
    n + n
}

machine Main::main(&mut self) {
    let arr: [i32; 4] = [10, 20, 30, 40];
    let a1: i32 in Wrapping = arr[1];
    let a3: i32 in Wrapping = arr[3];

    let p: Pt = Pt { x: 7, y: 9 };
    let px: i32 in Wrapping = p.x;

    let sum: i32 in Wrapping = arr[0] + a1 + px; // 10 + 20 + 7 = 37
    let doubled: i32 in Wrapping = self.dbl(a1); // value-call arg from a slotted-array let -> 40

    transition doubled == 40 { true -> check_a1(a1, a3, px, sum) _ -> bad() }

    state check_a1(&mut self, a1: i32 in Wrapping, a3: i32 in Wrapping, px: i32 in Wrapping, sum: i32 in Wrapping) {
        transition a1 == 20 { true -> check_a3(a3, px, sum) _ -> bad() }
    }
    state check_a3(&mut self, a3: i32 in Wrapping, px: i32 in Wrapping, sum: i32 in Wrapping) {
        transition a3 == 40 { true -> check_px(px, sum) _ -> bad() }
    }
    state check_px(&mut self, px: i32 in Wrapping, sum: i32 in Wrapping) {
        transition px == 7 { true -> check_sum(sum) _ -> bad() }
    }
    state check_sum(&mut self, sum: i32 in Wrapping) {
        transition sum == 37 { true -> good() _ -> bad() }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
