data Entry {
    value: i32;
}

machine main() -> u64 {
    transition {
        _ -> 0
    }

    state choose(entries: &[Entry]) -> u64 {
        transition 2 <= entries.len {
            true -> length(entries[2..])
            false -> 0
        }
    }

    state length(entries: &[Entry]) -> u64 {
        transition {
            _ -> entries.len
        }
    }
}
