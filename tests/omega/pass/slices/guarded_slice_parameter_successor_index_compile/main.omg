data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self) -> i32 {
    transition {
        _ -> 0
    }

    state choose(&mut self, entries: &[Entry], index: u64) -> i32 {
        transition index + 1 <= entries.len {
            true -> accept(entries[index].value)
            false -> 0
        }
    }

    state accept(&mut self, value: i32) -> i32 {
        transition {
            _ -> value
        }
    }
}
