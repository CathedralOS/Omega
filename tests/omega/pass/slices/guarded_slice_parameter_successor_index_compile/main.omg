data Entry {
    value: i32;
}

machine main() -> i32 {
    transition {
        _ -> 0
    }

    state choose(entries: &[Entry], index: u64) -> i32 {
        transition index < 4096 && index + 1 <= entries.len {
            true -> accept(entries[index].value)
            false -> 0
        }
    }

    state accept(value: i32) -> i32 {
        transition {
            _ -> value
        }
    }
}
