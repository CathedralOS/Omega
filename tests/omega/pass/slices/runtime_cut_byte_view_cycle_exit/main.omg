// A subslice passed around a state cycle retains every incoming storage root.
// Guarded reads observe the progressively shortened view, including a cut
// initial argument and a literal-backed argument to the same machine.
use omega_language_std::console;
data Main { bytes: [u8; 4]; }
machine sum(bytes: &[u8]) -> i32 in Wrapping {
    transition { _ -> scan(bytes, 0) }
    state scan(bytes: &[u8], total: i32 in Wrapping) -> i32 in Wrapping {
        transition bytes.len > 0 {
            true -> observe(bytes[0], bytes[1..], total)
            false -> (total)
        }
    }
    state observe(head: u8, tail: &[u8], total: i32 in Wrapping) -> i32 in Wrapping {
        transition { _ -> relay(tail, total + (head as i32 in Wrapping)) }
    }
    state relay(tail: &[u8], total: i32 in Wrapping) -> i32 in Wrapping {
        transition { _ -> scan(tail, total) }
    }
}
// Compose retained local cuts before transporting another cut around a cycle.
machine chained(bytes: &[u8]) -> i32 in Wrapping {
    transition { _ -> scan(bytes, 0) }
    state scan(bytes: &[u8], total: i32 in Wrapping) -> i32 in Wrapping {
        let first: &[u8] = bytes[0..];
        let second: &[u8] = first[0..];
        transition second.len > 0 {
            true -> observe(second[0], second[1..], total)
            false -> (total)
        }
    }
    state observe(head: u8, tail: &[u8], total: i32 in Wrapping) -> i32 in Wrapping {
        transition { _ -> scan(tail, total + (head as i32 in Wrapping)) }
    }
}
machine Main::main(main: &mut Main) reaches Console {
    main.bytes = [1, 2, 3, 4];
    let whole: i32 in Wrapping = sum(&main.bytes);
    let cut: i32 in Wrapping = sum(&main.bytes[1..]);
    let literal: i32 in Wrapping = sum("AB");
    let chained: i32 in Wrapping = chained(&main.bytes);
    let chained_cut: i32 in Wrapping = chained(&main.bytes[1..]);
    let chained_literal: i32 in Wrapping = chained("ABC");
    transition whole == 10 && cut == 9 && literal == 131 && chained == 10 && chained_cut == 9 && chained_literal == 198 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
