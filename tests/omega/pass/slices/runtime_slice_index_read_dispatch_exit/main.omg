use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    transition true {
        true -> read_alias(main)
    }

    state read_alias(main: &mut Main) {
        main.entries[0].value = 7;

        let entry_view: &[Entry] = &main.entries[..];
        let index: u64 = 0;

        transition entry_view[index].value == 7 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(43);
    }

    state bad(main: &mut Main) {
        Console::exit_process(44);
    }
}
