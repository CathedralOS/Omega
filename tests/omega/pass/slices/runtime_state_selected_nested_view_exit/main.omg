data Cell [copy] { value: u32; tag: u64; }
data Window<'input> { marker: u64; values: &'input mut [Cell]; }

machine replace<'input>(windows: &'input mut [Window<'input>], window_position: u64, position: u64, replacement: Cell)
    -> &'input mut [Cell]
requires window_position < windows.len
{
    transition position < windows[window_position].values.len {
        true -> store(windows, window_position, position, replacement)
        false -> (&mut windows[window_position].values[..0])
    }
    state store(windows: &'input mut [Window<'input>], window_position: u64, position: u64, replacement: Cell)
        -> &'input mut [Cell]
    requires window_position < windows.len && position < windows[window_position].values.len {
        windows[window_position].values[position] = replacement;
        &mut windows[window_position].values[..]
    }
}

machine observe(values: &[Cell]) -> bool {
    transition values.len == 2 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 2 {
        values[0].value == 7 && values[0].tag == 17
            && values[1].value == 42 && values[1].tag == 9223372036854775808
    }
}

machine main() crashes Trap {
    let mut values: [Cell; 4] = [
        Cell { value: 90, tag: 91 }, Cell { value: 7, tag: 17 },
        Cell { value: 9, tag: 19 }, Cell { value: 80, tag: 81 }
    ];
    let mut other: [Cell; 1] = [Cell { value: 61, tag: 71 }];
    let mut windows: [Window; 2] = [
        Window { marker: 52, values: &mut other[..] },
        Window { marker: 51, values: &mut values[1..3] }
    ];
    let selected: &mut [Cell] = replace(&mut windows[..], 1, 1,
        Cell { value: 42, tag: 9223372036854775808 });
    let correct: bool = observe(selected);
    transition correct && other[0].value == 61 && other[0].tag == 71 && values[0].value == 90 && values[0].tag == 91
        && values[3].value == 80 && values[3].tag == 81
        && values[2].value == 42 && values[2].tag == 9223372036854775808 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
