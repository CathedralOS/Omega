// Whole-record stores through a runtime index on an element view:
// `nodes[pick] = fresh` with `pick` a computed scalar.
data Node { value: i32; tag: i32; }
data Bag { nodes: [Node; 4]; }

machine Main::fill_literal(bag: &mut Bag, fresh: Node) {
    let nodes: &mut [Node] = &mut bag.nodes[..];
    let pick: i32 = 2;
    nodes[pick] = fresh;
    transition { _ -> done() }
    machine done() {}
}

data Main { bag: Bag; }

machine Main::main(main: &mut Main) {
    let fresh: Node = Node { value: 7, tag: 3 };
    Main::fill_literal(&mut main.bag, fresh);
    transition main.bag.nodes[2].value == 7 && main.bag.nodes[2].tag == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
