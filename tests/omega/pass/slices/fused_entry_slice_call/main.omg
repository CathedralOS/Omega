// A `[u64; 3]` field on the entry receiver coerces to a checked callee's
// `&mut [u64]` through the borrowed-view presentation; the Fused entry
// receiver keeps its Terminal attachment while it lends the field.

pub boundary trait Ping {
    machine ping();
}
data PingProvider { }
machine PingProvider::ping() satisfies Ping::ping { }

data Filter { threshold: u64; }
data Worker { }
machine Worker::drain(buf: &mut [u64], filter: &Filter, index: u64) {
    transition {
        _ -> probe(&mut buf, filter, index)
    }
    state probe(buf: &mut [u64], filter: &Filter, index: u64) {
        transition {
            _ -> done()
        }
    }
    state done() {
    }
}

data Main {
    worker: Worker;
    items: [u64; 3];
    filter: Filter;
}

machine Main::main(main: &mut Main) {
    Worker::drain(&mut main.items, &main.filter, 0);
}
