data Cell [copy] { value: u32; tag: u64; }
data Window<'input> { values: &'input mut [Cell]; }

machine select<'input>(windows: &'input mut [Window<'input>], selected: u64) -> &'input mut [Cell]
requires selected < windows.len {
    &mut windows[selected].values[..]
}
machine observe(values: &[Cell]) -> bool {
    transition values.len == 2 {
        true -> inspect(values)
        false -> false
    }
    state inspect(values: &[Cell]) -> bool requires values.len == 2 {
        values[0].value == 42 && values[0].tag == 9223372036854775808
            && values[1].value == 19 && values[1].tag == 29
    }
}
machine exercise(selected: u64) -> bool requires selected < 2 {
    let mut first: [Cell; 1] = [Cell { value: 7, tag: 17 }];
    let mut second: [Cell; 1] = [Cell { value: 11, tag: 31 }];
    let mut replacement: [Cell; 2] = [Cell { value: 42, tag: 9223372036854775808 }, Cell { value: 19, tag: 29 }];
    let mut windows: [Window; 2] = [Window { values: &mut first[..] }, Window { values: &mut second[..] }];
    let view: &mut [Window] = &mut windows[..];
    view[selected].values = &mut replacement[..];
    let returned: &mut [Cell] = select(view, selected);
    let valid: bool = observe(returned);
    valid && first[0].value == 7 && first[0].tag == 17
        && second[0].value == 11 && second[0].tag == 31
}
machine main() crashes Trap {
    let first: bool = exercise(0);
    let second: bool = exercise(1);
    transition first && second {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
