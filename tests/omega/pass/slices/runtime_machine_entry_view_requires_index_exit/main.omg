use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    source: [u8; 4];
    i: u64;
}

machine read_edge(v: &[u8], i: u64) -> u8
    requires i < v.len;
{
    v[i]
}

machine Main::main(main: &mut Main) reaches Console {
    main.source[0] = 72;
    main.source[1] = 105;
    main.i = 1;
    transition { _ -> start(main) }

    state start(main: &mut Main) {
        let v: &[u8] = &main.source[..];
        transition main.i < v.len {
            true -> inner(v, main.i, &main.console)
            _ -> bad(main)
        }
    }

    state inner(v: &[u8], i: u64, c: &Binding<Console>) {
        let observed: u8 = read_edge(v, i);
        let code: u8 = match observed == 105 { true -> 70, _ -> 71 };
        c.exit_process(code as i32);
    }

    state bad(main: &mut Main) { main.console.exit_process(71); }
}
