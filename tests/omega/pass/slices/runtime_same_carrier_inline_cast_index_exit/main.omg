machine write(items: &mut [u8], index: u64 in Wrapping)
requires index < items.len;
{
    items[index as u64] = 7;
}

machine read(items: &[u8], index: u64 in Wrapping) -> u8
requires index < items.len;
{
    items[index as u64]
}

machine main() crashes Trap {
    let mut items: [u8; 2];
    items[0] = 1;
    items[1] = 3;
    write(&mut items[..], 1);
    let result: u8 = read(&items[..], 1);
    transition result == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
