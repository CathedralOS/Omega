data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self, entries: &[Entry], index: u64) -> i32
requires
    // The successor expression is exact arithmetic: the declared parameter
    // bound is the independent premise that `index + 1` cannot overflow.
    index <= 9223372036854775806,
    index + 1 <= entries.len
{
    let chosen: Entry = entries[index];
    chosen.value
}
