// `let cells: &mut [i32] = &mut bag.cells[..]` — mutable element-view
// establishment lends the array's contiguous storage under an exclusive
// loan; writes through the view are observed through the owning
// collection.
data Bag {
    cells: [i32; 4];
}
machine fill(bag: &mut Bag) {
    let cells: &mut [i32] = &mut bag.cells[..];
    cells[2] = 7;
}
machine sow(bag: &mut Bag) {
    let cells: &mut [i32] = &mut bag.cells[..];
    cells[0] = 1;
}
data Main { bag: Bag; }
machine Main::main(main: &mut Main) {
    fill(&mut main.bag);
    sow(&mut main.bag);
    transition main.bag.cells[2] == 7 && main.bag.cells[0] == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
