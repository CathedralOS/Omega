// Expected exit: 0. Selector completion supplies the RHS premise; each operand runs once.
trait Range {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len
    ensures result.len == end - start;
}
Views satisfies Range {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len
    ensures result.len == end - start {
        bytes[start..end]
    }
}
machine select(counter: &mut u64) -> u64
requires counter == 0
ensures counter == 1 && result == 1 { counter = counter + 1; 1 }
machine replacement(counter: &mut u64) -> u8
requires counter == 1
ensures counter == 2 && result == 70 { counter = counter + 1; 70 }
machine first(bytes: &[u8]) -> u8
requires bytes.len > 0 { bytes[0] }
data Main { bytes: [u8; 4]; }
machine Main::main(main: &mut Main) crashes Trap {
    main.bytes = [3, 4, 5, 6];
    let mut counter: u64 = 0;
    main.bytes[select(&mut counter)] = replacement(&mut counter);
    let middle: &[u8] = Views::middle(&main.bytes, 1, 3);
    let value: u8 = first(middle);
    transition middle.len == 2 && value == 70 && counter == 2 && main.bytes[2] == 5 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
