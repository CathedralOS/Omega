// Representation recasts compose as nested operands inside an ordinary
// binary expression, in both shared (`as &`) and mutable (`as &mut`)
// spellings: a mutable view read through an expression position
// re-reads the same backing place — no reference-typed `let` binding
// required.
data Bits { x: i32; y: u32; }
machine Bits::go(bits: &mut Bits) {
    bits.y = ((bits.x & 0xffff) as u32) & (&bits.x as &u32);
    bits.y = bits.y & (&mut bits.x as &mut u32);
}

data Main { bits: Bits; }
machine Main::main(main: &mut Main) {
    transition { _ -> touch(main) }
    machine touch(main: &mut Main) { Bits::go(&mut main.bits); }
}
