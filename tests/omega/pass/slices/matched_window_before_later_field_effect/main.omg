// Expected exit: 0
data Holder where which <= 1 { which: u64; route: [u64; 4]; }
data Report<'input> { changed: u64; events: &'input [u64]; }
machine change(value: &mut u64) -> u64 ensures value == 1 && result == 2 {
    value = 1;
    2
}
// The window captures the old value before the following field changes it.
machine selected<'input>(holder: &'input mut Holder) -> Report<'input>
ensures result.events.len == 1 {
    match holder.which {
        0 -> match 0 {
            0 -> Report { events: &holder.route[0..holder.which + 1], changed: change(&mut holder.which) }
            _ -> Report { changed: 0, events: &holder.route[0..1] }
        }
        _ -> Report { changed: 0, events: &holder.route[0..1] }
    }
}
machine valid(report: Report) -> bool {
    transition report.events.len == 1 {
        true -> inspect(report)
        _ -> false
    }
    state inspect(report: Report) -> bool requires report.events.len == 1 {
        report.changed == 2 && report.events[0] == 7
    }
}
machine main() crashes Trap {
    let mut holder: Holder = Holder { which: 0, route: [7, 8, 9, 10] };
    let report: Report = selected(&mut holder);
    transition valid(report) {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
