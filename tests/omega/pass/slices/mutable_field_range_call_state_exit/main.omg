data WindowBuffer {
    items: [i32; 4];
    marker: i32;
}

machine write_pair(values: &mut [i32]) {
    transition values.len >= 2 {
        true -> write(values)
        false -> skip()
    }
    machine write(values: &mut [i32]) {
        values[0] = 7;
        values[1] = 9;
    }
    machine skip() {}
}

machine through_state(context: &mut WindowBuffer) {
    transition { _ -> narrowed(&mut context.items[0..2]) }
    machine narrowed(values: &mut [i32]) {
        write_pair(values);
    }
}

machine main() crashes Trap {
    let mut context: WindowBuffer;
    through_state(&mut context);
    write_pair(&mut context.items[2..4]);
    transition context.items[0] == 7 && context.items[1] == 9
        && context.items[2] == 7 && context.items[3] == 9
        && context.marker == 0 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
