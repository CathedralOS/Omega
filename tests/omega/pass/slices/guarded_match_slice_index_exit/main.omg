use omega_language_std::console;

machine first(values: &[i32], count: u64) -> i32 {
    let observed: i32 = match count > 0 && count <= values.len && 0 < values.len {
        true -> values[0],
        false -> 0
    };
    observed
}

machine last_or_zero(values: &[i32]) -> i32 {
    match values.len == 0 {
        true -> 0,
        _ -> values[0]
    }
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let values: [i32; 2] = [31, 39];
    let empty: [i32; 0] = [];
    let nonempty: i32 = first(&values[..], 2);
    let missing: i32 = first(&empty[..], 0);
    let too_many: i32 = first(&values[..], 3);
    let complement: i32 = last_or_zero(&values[..]);
    let absent: i32 = last_or_zero(&empty[..]);
    transition nonempty == 31 && missing == 0 && too_many == 0 && complement == 31 && absent == 0 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
