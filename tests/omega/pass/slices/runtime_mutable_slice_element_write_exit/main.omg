use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: i32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
}

machine Main::main(&mut self) reaches Console {
    let entry_slice: &mut [Entry] = self.entries.as_mut_slice();
    entry_slice[0].value = 7;

    transition self.entries[0].value == 7 {
        true -> good(&mut self)
        false -> bad(&mut self)
    }

    state good(main: &mut Main) {
        main.console.exit_process(21);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(22);
    }
}
