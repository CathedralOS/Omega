use omega_language_std::console;
use omega::language::core::service;

data Entry {
    value: i32;
}

data Main {
    console: Service<Console>;
    entries: [Entry; 4];
}

machine Main::main(&mut self) reaches Console {
    let entry_slice: &mut [Entry] = self.entries.as_mut_slice();
    entry_slice[0].value = 7;

    transition self.entries[0].value == 7 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(21);
    }

    state bad(&mut self) {
        self.console.exit_process(22);
    }
}
