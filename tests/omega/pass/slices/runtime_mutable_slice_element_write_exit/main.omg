use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    let entry_slice: &mut [Entry] = &mut main.entries[..];
    entry_slice[0].value = 7;

    transition main.entries[0].value == 7 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(21);
    }

    state bad(main: &mut Main) {
        Console::exit_process(22);
    }
}
