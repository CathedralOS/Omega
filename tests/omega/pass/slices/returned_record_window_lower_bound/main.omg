// Each exit of a two-arm return proves its own field is non-empty, even
// though the arms do not share one length.
data Held<'row> { values: &'row mut [i32 in Wrapping]; }
machine span<'row>(items: &'row mut [i32 in Wrapping; 4], which: i32 in Wrapping) -> Held<'row>
ensures result.values.len >= 1
{
    transition which == 0 {
        true -> one(items)
        _ -> three(items)
    }
    state one(items: &'row mut [i32 in Wrapping; 4]) -> Held<'row> {
        Held { values: &mut items[0..1] }
    }
    state three(items: &'row mut [i32 in Wrapping; 4]) -> Held<'row> {
        Held { values: &mut items[1..4] }
    }
}
machine write_first(window: &mut [i32 in Wrapping])
requires window.len >= 1 {
    window[0] = window[0];
}
machine use_bound() {
    let mut row: [i32 in Wrapping; 4] = [1, 2, 3, 4];
    let held: Held = span(&mut row, 0);
    write_first(held.values);
    let rest: Held = span(&mut row, 1);
    write_first(rest.values);
}
machine main() crashes Trap {
    transition true {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
