use omega_language_std::math;

// A static machine lends its own local fixed arrays through element views.
// `&values[..]` establishes a shared `&[i32]` descriptor over the local
// array's home, `&values` presents the same backing directly as a call
// argument, and a zero-initialized `[i32; 3]` lends both `&mut [i32]` and
// `&[i32]` views of its storage. Exits 70 only when every view observed the
// one local backing with its exact extent and contents.

use omega_language_std::console;
use omega::language::core::binding;

machine largest(values: &[i32], current: i32) -> i32 {
    transition values.len > 0 {
        true -> largest(values[1..], max_i32(current, values[0]))
        false -> (current)
    }
}

machine count(values: &[i32]) -> u64 {
    transition { _ -> (values.len) }
}

machine measure(slots: &mut [i32]) -> u64 {
    transition { _ -> (slots.len) }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let values: [i32; 4] = [3, 11, 2, 7];
    let view: &[i32] = &values[..];
    let from_view: i32 = largest(view, 0);
    let direct: i32 = largest(&values, 0);
    let extent: u64 = count(&values);
    let mut slots: [i32; 3];
    let slot_count: u64 = measure(&mut slots);
    let seeded: i32 = largest(&slots, 5);
    transition from_view == 11 && direct == 11 && extent == 4 && slot_count == 3 && seeded == 5 {
        true -> done(&main.console)
        _ -> refused(&main.console)
    }

    state done(console: &Binding<Console>) {
        Console::exit_process(console, 70);
    }

    state refused(console: &Binding<Console>) {
        Console::exit_process(console, 71);
    }
}
