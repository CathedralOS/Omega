use omega_language_std::console;
use omega::language::core::binding;

data Entry [copy] {
    value: i32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 7;

    let entry_view: &[Entry] = main.entries.as_slice();
    let index: u64 = 0;
    let chosen: Entry = entry_view[index];

    transition chosen.value == 7 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(51);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(52);
    }
}
