// The FULL runtime-bounded fixed-array subslice arc: BOTH bounds are runtime
// params, the dominating guard `lo <= hi && hi <= main.arr.len` (a) lowers
// natively (the fixed-array `.len` guard-operand fold -> CompareStaticValue)
// and (b) discharges the prover's subslice bound obligations; the true arm
// passes `main.arr[lo..hi]` as a slice argument. The consumer sees length 3.
// An empty window reaches the consumer; reversed and out-of-range bounds
// return the refusal code without evaluating a slice. Success exits 3.
use omega_language_std::console;

data Main {
    arr: [i32; 5];
}

machine Main::main(main: &mut Main) reaches Console {
    let result: i32 = Main::view(main, 1, 4);
    let empty: i32 = Main::view(main, 5, 5);
    let reversed: i32 = Main::view(main, 4, 1);
    let outside: i32 = Main::view(main, 1, 6);
    transition result == 3 && empty == 0 && reversed == 8 && outside == 8 {
        true -> finish(main, result)
        false -> finish(main, 9)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::view(main: &Main, lo: u64, hi: u64) -> i32 {
    transition lo <= hi && hi <= main.arr.len {
        true -> Main::consume(main.arr[lo..hi])
        false -> 8
    }
}

machine Main::consume(sub: &[i32]) -> i32 {
    let n: u64 = sub.len;
    transition n == 3 {
        true -> 3
        false -> 0
    }
}
