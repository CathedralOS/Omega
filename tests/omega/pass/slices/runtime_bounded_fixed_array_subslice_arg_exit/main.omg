// The FULL runtime-bounded fixed-array subslice arc: BOTH bounds are runtime
// params, the dominating guard `lo <= hi && hi <= main.arr.len` (a) lowers
// natively (the fixed-array `.len` guard-operand fold -> CompareStaticValue)
// and (b) discharges the prover's subslice bound obligations; the true arm
// passes `main.arr[lo..hi]` as a slice ARGUMENT (frame-slot START + END feed
// the seeded-then-shrunk descriptor). consume sees len 3 -> exit 3.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    arr: [i32; 5];
}

machine Main::main(main: &mut Main) {
    transition { _ -> Main::view(main, 1, 4) }
}

machine Main::view(main: &mut Main, lo: u64, hi: u64) reaches Console {
    let arr_lo__hi_value: i32 = main.arr[lo..hi];
    transition lo <= hi && hi <= main.arr.len {
        true -> Main::consume(main, arr_lo__hi_value)
        false -> bad(main)
    }
    state bad(main: &mut Main) { main.console.exit_process(8); }
}

machine Main::consume(main: &mut Main, sub: &[i32]) reaches Console {
    let n: u64 = sub.len;
    transition n == 3 {
        true -> matched(main)
        false -> unmatched(main)
    }
    state matched(main: &mut Main) { main.console.exit_process(3); }
    state unmatched(main: &mut Main) { main.console.exit_process(0); }
}
