use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: i32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 11;
    main.entries[1].value = 29;
    main.entries[2].value = 37;

    let view: &[Entry] = main.entries.as_slice();
    let tail: &[Entry] = view[1..];

    transition { _ -> choose(main, tail, 1) }

    state choose(main: &Main, entries: &[Entry], index: u64) {
        transition entries[index].value == 37 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &Main) {
        main.console.exit_process(207);
    }

    state bad(main: &Main) {
        main.console.exit_process(208);
    }
}
