machine change(items: &mut [i32], value: i32) -> bool requires items.len == 1 {
    items[0] = value;
    true
}
machine main() crashes Trap {
    let mut items: [i32; 1] = [1];
    let first: bool = change(&mut items, 7);
    let after_first: bool = items[0] == 7;
    let inverted: bool = !change(&mut items, 9);
    transition first && after_first && !inverted && items[0] == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
