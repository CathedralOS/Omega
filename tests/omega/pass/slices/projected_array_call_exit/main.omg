use omega_language_std::console;

data Main { }

machine Main::report(main: &mut Main, values: &[u8]) reaches Console {
    Console::write(values);
    Console::write("\n");
    let code: i32 = match values.len == 2 {
        true -> 70,
        false -> 71
    };
    Console::exit_process(code);
}

machine Main::main(main: &mut Main) reaches Console {
    let rows: [[u8; 2]; 2] = [[97, 98], [99, 100]];
    Main::report(main, &rows[1][..]);
}
