// Expected exit: 0
domain i32::Selected(value) requires value == 1 || value == 38;
machine main() crashes Trap {
    let mut selected: i32 in Selected = 38;
    let snapshot: i32 in Selected = selected;
    selected = 1;
    transition snapshot == 38 && selected == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
