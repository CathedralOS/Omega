use omega_language_std::console;
data Packet { items: [u8; 4]; marker: i32; }
machine stamp(values: &mut [u8]) {
    transition values.len >= 4 { true -> write(values) _ -> skip() }
    machine write(values: &mut [u8]) { values[0] = 70; values[3] = 5; }
    machine skip() {}
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut packet: Packet;
    transition { _ -> check(&mut packet) }
    machine check(packet: &mut Packet) {
        stamp(&mut packet.items);
        let view: &[u8] = &packet.items[..];
        transition view.len == 4 && packet.items[0] == 70 && packet.items[3] == 5 && packet.marker == 0 {
            true -> done() _ -> failed()
        }
    }
    machine done() { Console::exit_process(70); }
    machine failed() { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
