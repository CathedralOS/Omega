machine write(items: &mut [i32])
requires items.len > 1
{
    transition { _ -> forwarded(&mut items[1..2]) }
    machine forwarded(items: &mut [i32])
    requires items.len > 0
    {
        items[0] = 23;
    }
}
machine main() crashes Trap {
    let mut items: [i32; 2];
    let view: &mut [i32] = &mut items[..];
    write(view);
    transition items[0] == 0 && items[1] == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
