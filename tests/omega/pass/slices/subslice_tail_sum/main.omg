// A tail-recursive value-returning machine whose accumulator argument
// READS a slice element of the SAME slice it subslices:
// `sum(s[1..], acc + s[0])` — the element `s[0]` must be read before the
// `s` parameter's descriptor retargets to `s[1..]`. Ranked by the
// slice-length order.
data Summer {}
data Main {
    arr: [i32 in Wrapping; 4];
    summer: Summer;
}

machine sum(s: &[i32 in Wrapping], acc: i32 in Wrapping) -> i32 in Wrapping
terminates by s -> Slice::Length;
{
    transition s.len > 0 {
        true -> sum(s[1..], acc + s[0])
        false -> acc
    }
}

machine Main::main(main: &mut Main) {
    main.arr[0] = 5;
    main.arr[1] = 10;
    main.arr[2] = 15;
    main.arr[3] = 20;
    let s: &[i32 in Wrapping] = &main.arr[..];
    let total: i32 in Wrapping = sum(s, 0);
    transition total == 50 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { main.arr[0] = 50; }
    machine bad(main: &mut Main) { main.arr[0] = 0; }
}
