// TWO-POINTER reverse-in-place -- validates the relational chaining for indexed
// WRITES (the palindrome only read): the write target `nums[self.i]` proves
// in-bounds via `i <= j < len` (the `i < j` guard's ordering chained with the
// decreasing pointer's invariant), and `nums[self.j]` via `j < len`.
//
// The swap reads both elements into FIELDS, then writes each from a field. (A
// direct `nums[i] = nums[j]` -- a runtime-indexed write whose value is a
// runtime-indexed read -- is a separate, latent codegen miscompile; the
// field-temp form is the idiom that works today, also used by bubble_sort.)
//
// [1,2,3,4,5] reversed is [5,4,3,2,1]: nums[0]==5 and nums[4]==1 -> exit 70.

use omega_language_std::console;

data Main {
    console: Console;
    nums: [i32; 5] in Trapping;
    i: u64 in Wrapping;
    j: u64 in Wrapping;
    left_value: i32 in Trapping;
    right_value: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.nums[0] = 1;
    self.nums[1] = 2;
    self.nums[2] = 3;
    self.nums[3] = 4;
    self.nums[4] = 5;
    self.i = 0;
    self.j = 4;

    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        transition self.i < self.j {
            true -> swap()
            _ -> check()
        }
    }

    state swap(&mut self) {
        self.left_value = self.nums[self.i];    // i <= j < len
        self.right_value = self.nums[self.j];   // j < len
        self.nums[self.i] = self.right_value as i32;   // write target proves via i <= j < len
        self.nums[self.j] = self.left_value as i32;    // write target proves via j < len
        self.i = self.i + 1;
        self.j = self.j - 1;
        transition {
            _ -> loop_()
        }
    }

    state check(&mut self) {
        let first: i32 = self.nums[0];
        let last: i32 = self.nums[4];
        transition first == 5 {
            true -> check_last(last)
            _ -> bad()
        }
    }

    state check_last(&mut self, last: i32) {
        transition last == 1 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
