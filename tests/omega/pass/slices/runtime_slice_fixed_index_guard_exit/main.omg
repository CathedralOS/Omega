use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 7;

    let entry_view: &[Entry] = &main.entries[..];

    transition {
        _ -> check_first(main, entry_view)
    }

    state check_first(main: &Main, entries: &[Entry]) {
        transition entries[0].value == 7 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &Main) {
        Console::exit_process(121);
    }

    state bad(main: &Main) {
        Console::exit_process(122);
    }
}
