// A computed index rooted at the machine's DATA BINDING hoists into a temp the
// same way a receiver-rooted one does. `main.cells[main.i - 1]` is a Binary
// index whose leaf is a field of the record this machine operates on; the
// normalization pass lifts it into a `__hoist_N` local, and `i`'s declared
// `[1..=4]` range proves `i - 1` lands inside `cells`.
//
// Before this, the hoister recognized only a `main.<field>` leaf, so the static
// spelling fell through to the computed-index fence and reported "index
// `main.i - 1` is a computed expression, not yet supported as an indexed
// operand" -- a refusal the identical receiver-spelled program never got.
data Main {
    cells: [i32; 4];
    i: u64 [1..=4];
    seen: i32;
}

machine Main::main(main: &mut Main) {
    main.cells[2] = 7;
    main.i = 3;
    main.seen = main.cells[main.i - 1];
}
