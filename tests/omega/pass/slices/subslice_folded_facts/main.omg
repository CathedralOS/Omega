// Let-bound computed endpoints subslice a view: `view[start..]` tail and
// `view[start..end]` middle fold `start + width` into a bound fact; the
// later `end - 3` pick must bind to a local first — a bare computed
// index is fenced.
data Entry [copy] {
    value: i32;
}
data Main {
    entries: [Entry; 4];
}
machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = &main.entries[..];
    let start: u64 = 1;
    let width: u64 = 2;
    let end: u64 = start + width;
    let tail: &[Entry] = view[start..];
    let middle: &[Entry] = view[start..end];
    let pick: u64 = end - 3;
    let chosen: Entry = middle[pick];
    tail.len + middle.len
}
