// Runtime-indexed element stores through a mutable element view:
// `slots[index] = value` lowers to the element-view write op — the
// view's length witness feeds the bounds proof under
// `requires index < slots.len`.
data FixedVec {}
machine FixedVec::store(slots: &mut [i32], index: u64 in Wrapping, value: i32 in Wrapping)
    requires index < slots.len
{
    slots[index] = value as i32;
}
data Main { items: [i32; 4]; }
machine Main::main(main: &mut Main) {
    main.items = [1, 2, 3, 4];
    let view: &mut [i32] = &mut main.items[..];
    view[1] = 77;
    transition main.items[1] == 77 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
