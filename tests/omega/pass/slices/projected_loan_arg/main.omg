// `&main.<field>` as a successor argument loans the projected field into
// the successor's borrowed parameter: the loan's root is the
// `main: &mut Main` data parameter, and the state reads through the
// view.
data Pair [copy] { a: i32; }

data Main { pair: Pair; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { a: 11 };
    transition { _ -> inspect(main, &main.pair) }
    machine inspect(main: &mut Main, view: &Pair) {
        transition view.a == 11 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() {}
}
