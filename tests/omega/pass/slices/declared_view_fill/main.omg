// Declaring a record reserves storage; filling its view member
// establishes that descriptor without inventing a zero reference or
// copying its backing — `room.label = source` writes the
// `&[u8] in Utf8` view into the declared member.
domain [u8]::Utf8
requires
    valid_utf8(self);
data Room [copy] { label: &[u8] in Utf8; }
data Main {
    source: Room;
}
machine Main::main(main: &mut Main) {
    main.source.label = "Gate";
    let room: Room;
    room.label = main.source.label;
}
