machine read(items: &[u8], index: i64) -> u8
requires 0 <= index && index < items.len;
{
    items[index]
}

machine window(items: &[u8], start: i64, end: i64)
requires 0 <= start && start <= end && end <= items.len;
{
    let view: &[u8] = items[start..end];
}

machine array_window(items: &[u8; 4], start: i64, end: i64)
requires 0 <= start && start <= end && end <= items.len;
{
    let view: &[u8] = items[start..end];
}
