use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: i32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
}

machine Main::main(&mut self) reaches Console {
    let entry_view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> check(entry_view, 0)
    }

    state check(&mut self, entries: &[Entry], index: u64) {
        let next_index: u64 = index + 1;
        let has_next: bool = next_index < entries.len;

        transition has_next {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(191);
    }

    state bad(&mut self) {
        self.console.exit_process(192);
    }
}
