// Nested subslice over a runtime slice parameter in ONE expression
// (`sub[1..][1..]`). The inner literal layer folds into the outer as a window
// bias: ptr = sub.ptr + 2*elem, len = sub.len - 2. The regression this pins:
// the nested base silently resolved to the UN-offset descriptor (native saw
// length 4 instead of 3) while the interpreter rejected the shape outright.

use platform::console;

data Entry { value: i32; }

data Main {
    console: Console;
    entries: [Entry; 5];
}

machine Main::main(&mut self) {
    let view: &[Entry] = self.entries.as_slice();
    transition {
        _ -> self.check(view)
    }
}

machine Main::check(&mut self, sub: &[Entry]) {
    transition sub.len > 3 {
        true -> self.verify(sub[1..][1..])
        false -> bad()
    }
    state bad(&mut self) { self.console.exit_process(71); }
}

machine Main::verify(&mut self, sub: &[Entry]) {
    transition sub.len == 3 {
        true -> good()
        false -> wrong()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state wrong(&mut self) { self.console.exit_process(72); }
}
