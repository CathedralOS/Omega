// A Unit state passes both a subslice of a borrowed element view and a
// scalar read of an element of that same view to one call, in each authored
// order. Arguments evaluate left to right, each operand in its own block, so
// the subslice and the read must each observe the view's length where they
// run: a length observed while producing the other operand does not
// dominate them. `confirm` selects the tail's first element (9) only when the
// subslice starts at element 1; `confirm_after` selects the tail's second
// element (42) only when the read delivered element 1. Any other path exits
// 1, 2 or 3.

use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

// The subslice operand precedes the read operand.
machine Main::confirm(tail: &[Entry], chosen: i32) -> i32 {
    transition tail.len >= 1 {
        true -> emit(tail[0].value)
        false -> chosen
    }

    state emit(first: i32) -> i32 {
        transition {
            _ -> first
        }
    }
}

// The read operand precedes the subslice operand.
machine Main::confirm_after(chosen: i32, tail: &[Entry]) -> i32 {
    transition chosen == 9 {
        true -> check(tail)
        false -> 1
    }

    state check(tail: &[Entry]) -> i32 {
        transition tail.len >= 2 {
            true -> emit(tail[1].value)
            false -> 2
        }
    }

    state emit(second: i32) -> i32 {
        transition {
            _ -> second
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[1].value = 9;
    main.entries[2].value = 42;
    let view: &[Entry] = &main.entries[..];

    transition {
        _ -> picked(main, view)
    }

    state picked(main: &Main, sub: &[Entry]) {
        transition sub.len >= 2 {
            true -> chosen(main, sub)
            false -> bad(main)
        }
    }

    state chosen(main: &Main, sub: &[Entry]) {
        let first: i32 = Main::confirm(sub[1..], sub[1].value);
        let second: i32 = Main::confirm_after(sub[1].value, sub[1..]);
        transition first == 9 {
            true -> report(main, second)
            false -> bad(main)
        }
    }

    state report(main: &Main, value: i32) {
        Console::exit_process(value);
    }

    state bad(main: &Main) {
        Console::exit_process(3);
    }
}
