// A `&mut [u8]` view carried around a state cycle keeps the caller's storage
// as its backing. `step -> more -> put_more -> step` is the varint emission
// loop the generated wire codecs use: every state in the cycle receives the
// view only from its cycle predecessor, and only `step`'s entry edge names
// the caller's buffer. Native selection enumerates the view's backing roots
// across the cycle instead of refusing the inner states for naming none of
// their own. Encoding 300 writes [0xAC, 0x02] and counts 2 bytes; exits 70.

use omega_language_std::console;

data Main {
    buffer: [u8; 8];
    written: u64;
}

machine put(out: &mut [u8], written: &mut u64, value: u64) {
    transition { _ -> step(out, written, 0, value) }

    state step(out: &mut [u8], written: &mut u64, at: u64, bits: u64) {
        transition bits < 128 {
            true -> last(out, written, at, bits)
            _ -> more(out, written, at, bits)
        }
    }

    state more(out: &mut [u8], written: &mut u64, at: u64, bits: u64) {
        transition at < out.len {
            true -> put_more(out, written, at, bits)
            _ -> overflow(out, written, at)
        }
    }

    state put_more(out: &mut [u8], written: &mut u64, at: u64, bits: u64) {
        out[at] = ((bits & 127) | 128) as u8;
        transition { _ -> step(out, written, at + 1, bits >> 7) }
    }

    state last(out: &mut [u8], written: &mut u64, at: u64, bits: u64) {
        transition at < out.len {
            true -> put_last(out, written, at, bits)
            _ -> overflow(out, written, at)
        }
    }

    state put_last(out: &mut [u8], written: &mut u64, at: u64, bits: u64) {
        out[at] = bits as u8;
        written = at + 1;
    }

    state overflow(out: &mut [u8], written: &mut u64, at: u64) {
        written = 0;
    }
}

machine Main::main(main: &mut Main) reaches Console {
    put(&mut main.buffer, &mut main.written, 300);
    transition main.written == 2 && main.buffer[0] == 172 && main.buffer[1] == 2 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
