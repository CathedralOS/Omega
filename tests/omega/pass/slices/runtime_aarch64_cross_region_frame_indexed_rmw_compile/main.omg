// A frame-held slice descriptor indexed by a MACHINE field exercises the
// AArch64 cross-region binary-write and copy address recipes and their second
// base relocations.
use omega_language_std::console;
data Main {
    console: Console;
    arr: [i32; 4];
    i: u64 [0..=3];
    value: i32 [0..=100];
    got: i32;
}
machine Main::main(&mut self) {
    self.arr[2] = 40;
    self.i = 2;
    self.value = 40;
    let s: &mut [i32] = self.arr.as_mut_slice();
    let out: &mut i32 = &mut self.got;
    transition self.i < s.len {
        true -> seed(s, out)
        false -> no()
    }
    state seed(&mut self, s: &mut [i32], out: &mut i32) {
        s[self.i] = self.value;
        transition true { _ -> work(s, out) }
    }
    state work(&mut self, s: &mut [i32], out: &mut i32) {
        s[self.i] = self.value + 2;
        out = s[self.i];
        transition out == 42 && self.arr[2] == 42 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
