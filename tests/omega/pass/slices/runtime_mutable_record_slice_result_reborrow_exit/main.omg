data Cell [copy] { value: i32; }
machine middle(items: &mut [Cell; 3]) -> &mut [Cell] { &mut items[1..2] }
machine write(items: &mut [Cell]) requires items.len > 0 { items[0].value = 27; }
machine main() crashes Trap {
 let mut items: [Cell; 3]; items[0].value=11; items[1].value=39; items[2].value=13;
 let selected: &mut [Cell] = middle(&mut items);
 write(selected);
 transition items[0].value==11 && items[1].value==27 && items[2].value==13 { true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
