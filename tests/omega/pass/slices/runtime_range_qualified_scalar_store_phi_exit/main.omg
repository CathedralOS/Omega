domain i32::Small(value) requires 0 <= value && value <= 100;
machine write(items: &mut [i32 in Small; 3], value: i32 in Small, flag: bool) {
 transition flag { true -> next(items, value) _ -> next(items, value) }
 machine next(items: &mut [i32 in Small; 3], value: i32 in Small) { items[1] = value; }
}
machine main() crashes Trap {
 let mut items: [i32 in Small; 3];
 items[0] = 11; items[1] = 39; items[2] = 13;
 write(&mut items, 27, true);
 transition items[0] == 11 && items[1] == 27 && items[2] == 13 { true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
