// A FIELD array's indexed element used as a VALUE OPERAND -- passed to a value-call,
// and read into a let then forwarded as a transition argument. This is the core
// "read a grid/buffer cell and compute with it" pattern, and it works for FIELD
// arrays (`self.nums[i]`).
//
// The same with a LOCAL array literal (`let arr = [..]; let e = arr[i]`) is now also
// fixed (the read-only array was being elided without a frame slot; see
// slices/runtime_local_aggregate_into_let_exit). Exits 70.

use omega_language_std::console;

data Main {
    console: Console;
    nums: [i32; 4];
}

machine Main::dbl(&self, n: i32 in Wrapping) -> i32 in Wrapping {
    n + n
}

machine Main::main(&mut self) {
    self.nums = [10, 20, 30, 40];

    // field-array element straight into a value-call argument
    let doubled: i32 in Wrapping = self.dbl(self.nums[1]);
    // field-array element into a let, then forwarded as a transition argument
    let picked: i32 in Wrapping = self.nums[2];

    transition doubled == 40 { true -> check_picked(picked) _ -> bad() }

    state check_picked(&mut self, picked: i32 in Wrapping) {
        transition picked == 30 { true -> good() _ -> bad() }
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
