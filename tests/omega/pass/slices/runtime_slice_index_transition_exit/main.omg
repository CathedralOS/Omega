use platform::console;

data Entry {
    value: i32;
}

data Main {
    console: Console;
    entries: [Entry; 4];
}

machine Main::main(&mut self) {
    self.entries[0].value = 7;

    let entry_view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> check_first(entry_view)
    }

    state check_first(&mut self, entries: &[Entry]) {
        let current: Entry = entries[0];

        transition current.value == 7 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(111);
    }

    state bad(&mut self) {
        self.console.exit_process(112);
    }
}
