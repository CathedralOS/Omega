// Expected exit: 0. Destination slot1 is captured before the RHS changes slot to2.
trait Range {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len
    ensures result.len == end - start;
}
Views satisfies Range {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len
    ensures result.len == end - start {
        bytes[start..end]
    }
}
machine replacement(slot: &mut u64) -> u8
ensures result == 70 && slot == 2 { slot = 2; 70 }
machine first(bytes: &[u8]) -> u8
requires bytes.len > 0 { bytes[0] }
data Main { bytes: [u8; 4]; }
machine Main::main(main: &mut Main) crashes Trap {
    main.bytes = [3, 4, 5, 6];
    let mut slot: u64 = 1;
    main.bytes[slot] = replacement(&mut slot);
    let middle: &[u8] = Views::middle(&main.bytes, 1, 3);
    let value: u8 = first(middle);
    transition middle.len == 2 && value == 70 && slot == 2 && main.bytes[2] == 5 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
