// `use omega::language::core::slice` imports the slice surface:
// `&main.entries[..]` borrows a field array as `&[T]` and `.len` reports the
// runtime length.
use omega::language::core::slice;

data Entry { value: i32; }
data Main { entries: [Entry; 4]; }

machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = &main.entries[..];
    view.len
}
