// In the arm `which == 0`, the window end joins two spellings of that
// coordinate. Both are 2, so the window publishes length 2.
// Expected exit: 0
machine from_join<'row>(items: &'row mut [u8; 4], which: i64, flag: bool) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..(match flag { true -> which + 2, false -> 2 })]
        _ -> &mut items[2..4]
    }
}
machine write_pair(window: &mut [u8])
    requires window.len >= 2
{
    window[0] = 9;
    window[1] = 8;
}
machine main() crashes Trap {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_join(&mut bytes, 0, true);
    write_pair(window);
    transition bytes[0] == 9 && bytes[1] == 8 && bytes[2] == 3 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
