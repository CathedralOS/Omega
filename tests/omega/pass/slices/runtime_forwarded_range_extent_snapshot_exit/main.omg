machine forward(bytes: &[u8]) -> &[u8]
ensures result.len >= bytes.len && result.len <= bytes.len { bytes }

machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
requires start <= end && end <= bytes.len
ensures result.len == end - start {
    let mut endpoint: u64 = end;
    let mut window: &[u8] = bytes[start..endpoint];
    window = forward(window);
    endpoint = start;
    window
}

machine first(bytes: &[u8]) -> u8
requires bytes.len > 0 { bytes[0] }

data Main { bytes: [u8; 4]; }
machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[1] = 70;
    let window: &[u8] = middle(&main.bytes, 1, 3);
    let value: u8 = first(window);
    transition window.len == 2 && value == 70 {
        true -> good()
        _ -> bad()
    }
    state good() {}
    state bad() { crash Trap; }
}
