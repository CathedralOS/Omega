data Evidence [copy] { case Only; }
data Cell [copy] { value:i32; proof [erased]: Evidence; flag:bool; }
machine copy(items: &[Cell]) -> Cell requires items.len > 1 { items[1] }
machine main() crashes Trap {
 let mut items: [Cell; 3]; items[0].value=11; items[1].value=39; items[1].flag=true; items[2].value=13;
 let view: &[Cell]=&items[..]; let chosen: Cell=copy(view); items[1].value=27; items[1].flag=false;
 transition chosen.value==39 && chosen.flag && items[0].value==11 && items[1].value==27 && items[2].value==13 { true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
