use omega_language_std::console;

data Entry [copy] {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 11;
    main.entries[1].value = 29;
    main.entries[2].value = 37;
    main.entries[3].value = 43;

    let view: &[Entry] = &main.entries[..];
    let tail: &[Entry] = view[1..];
    let window: &[Entry] = tail[..2];
    let chosen: Entry = window[1];

    transition chosen.value == 37 {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(215);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(216);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
