use omega_language_std::console;
use omega::language::core::binding;

data Entry [copy] {
    value: i32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 11;
    main.entries[1].value = 29;
    main.entries[2].value = 37;
    main.entries[3].value = 43;

    let view: &[Entry] = main.entries.as_slice();
    let tail: &[Entry] = view[1..];
    let window: &[Entry] = tail[..2];
    let chosen: Entry = window[1];

    transition chosen.value == 37 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(215);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(216);
    }
}
