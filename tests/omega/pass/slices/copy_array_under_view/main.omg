// A by-value pass of a copy-eligible fixed array does not move the
// owner place: `[u32; 2]` is Unrestricted via its scalar element type,
// so `consume(main.items)` copies while `main.items` stays
// established — the live shared `view` remains valid and its later
// read is admitted (affine arrays reject under a live view).
machine consume(items: [u32; 2]) {
    let first: u32 = items[0];
}
data Main {
    items: [u32; 2];
}
machine Main::main(main: &mut Main) {
    main.items = [3, 4];
    let view: &[u32] = &main.items[..];
    consume(main.items);
    let first: u32 = view[0];
}
