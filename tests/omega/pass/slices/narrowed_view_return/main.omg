// A member's narrowed sub-view returns as the machine's `-> &[u8]`
// result: `holder.bytes[1..2]` keeps the holder's loan alive in the
// returned view; `Choice::Return -> observed` is the bare-param arm
// result spelling.
data Choice [copy] { case Forward; case End; case Return; }
data Holder { bytes: [u8; 2]; calls: u64; }

machine observe(bytes: &[u8]) -> u64 { bytes.len }

machine narrowed(holder: &mut Holder) -> &[u8] {
    holder.calls = ((holder.calls as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    holder.bytes[1..2]
}

machine select(bytes: &[u8; 2], choice: Choice) -> u64 {
    let view: &[u8] = &bytes[..];
    let observed: u64 = observe(view);
    transition choice {
        Choice::Forward -> forwarded(view)
        Choice::End -> ended(observed)
        Choice::Return -> observed
    }
    machine forwarded(view: &[u8]) -> u64 { view.len }
    machine ended(observed: u64) -> u64 { observed }
}

data Main {}

machine Main::main(main: &mut Main) {
    let bytes: [u8; 2] = [11, 22];
    let via_view: u64 = select(&bytes, Choice::Forward);
    let via_ret: u64 = select(&bytes, Choice::Return);
    transition via_view == 2 && via_ret == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
