// A changed formal has no entry substitution; independent exit facts remain.
// Expected exit: 0
data Held<'row> { values: &'row mut [u8]; }
machine changed<'row>(values: &'row mut [u8; 4], mut count: u64) -> Held<'row>
ensures result.values.len == count
ensures result.values.len == 3 {
    count = 3;
    Held { values: &mut values[0..count] }
}
machine need_three(values: &[u8]) requires values.len == 3 {}
machine main() crashes Trap {
    let mut values: [u8; 4] = [10, 20, 30, 40];
    let held: Held = changed(&mut values, 2);
    need_three(held.values);
    transition held.values.len == 3 && held.values[2] == 30 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
