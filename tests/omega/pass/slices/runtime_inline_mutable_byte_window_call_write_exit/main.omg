machine replace(values: &mut [u8]) -> u64 {
    transition values.len > 0 {
        true -> write(values)
        false -> empty()
    }
    machine write(values: &mut [u8]) -> u64 {
        values[0] = 7;
        values.len
    }
    machine empty() -> u64 { 0 }
}

machine main() crashes Trap {
    let mut values: [u8; 4];
    values[0] = 11;
    values[3] = 13;
    let length: u64 = replace(&mut values[1..3]);
    transition length == 2 && values[1] == 7
        && values[0] == 11 && values[3] == 13 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
