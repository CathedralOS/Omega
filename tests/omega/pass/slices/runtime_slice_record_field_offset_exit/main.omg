use omega_language_std::console;

data Entry {
    prefix: u64;
    value: i16;
    suffix: u32;
}

data Main {
    entries: [Entry; 2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 11;
    main.entries[1].prefix = 123;
    main.entries[1].value = 29;
    main.entries[1].suffix = 456;
    let entry_view: &[Entry] = &main.entries[..];
    let index: u64 = 1;
    transition entry_view[index].value == 29 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &Main) {
        Console::exit_process(61);
    }
    machine bad(main: &Main) {
        Console::exit_process(62);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
