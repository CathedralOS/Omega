use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    prefix: u64;
    value: i16;
    suffix: u32;
}

data Main {
    console: Binding<Console>;
    entries: [Entry; 2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 11;
    main.entries[1].prefix = 123;
    main.entries[1].value = 29;
    main.entries[1].suffix = 456;
    let entry_view: &[Entry] = main.entries.as_slice();
    let index: u64 = 1;
    transition entry_view[index].value == 29 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &Main) {
        main.console.exit_process(61);
    }
    state bad(main: &Main) {
        main.console.exit_process(62);
    }
}
