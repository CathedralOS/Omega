use omega_language_std::console;

data Entry [copy] {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.entries[0].value = 11;
    main.entries[1].value = 29;

    let view: &[Entry] = &main.entries[..];
    let tail: &[Entry] = view[1..];
    let chosen: Entry = tail[0];

    transition chosen.value == 29 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(205);
    }

    state bad(main: &mut Main) {
        Console::exit_process(206);
    }
}
