// The exact create_dir_all path-scan shape, minus the fs call -- both slice fixes
// combined. A `&[u8] in Path` DOMAIN-constrained slice param; a storage-vs-storage
// guard `main.k < path.len` (field vs domained-slice `.len`, needs the
// `is_slice_descriptor` Constrained peel); a RUNTIME-END subslice `path[0..main.k]`
// whose end is a machine field (needs the `resolve_subslice_bound` Machine-region-END
// relaxation); the subslice-domain grant (`path[0..k] in Path`, no_nul is
// subslice-preserving); and the subslice descriptor passed onward as a `&[u8] in Path`
// arg. Exits on the subslice length (5) so no fs machinery is involved.

domain [u8]::Path(bytes)
requires
    no_nul(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    k: u64;
}

machine Main::main(main: &mut Main) {
    main.k = 5;
    transition {
        _ -> Main::check(main, "/adir/x")
    }
}

machine Main::check(main: &Main, path: &[u8] in Path) reaches Console {
    // storage(main.k)=5 < storage(path.len)=7 -> subslice path[0..5] = "/adir".
    transition main.k < path.len {
        true -> Main::verify(main, path[0..main.k])
        false -> bad(main)
    }
    state bad(main: &Main) {
        main.console.exit_process(71);
    }
}

machine Main::verify(main: &Main, prefix: &[u8] in Path) reaches Console {
    transition prefix.len == 5 {
        true -> good(main)
        false -> wrong(main)
    }
    state good(main: &Main) {
        main.console.exit_process(70);
    }
    state wrong(main: &Main) {
        main.console.exit_process(71);
    }
}
