// Ordinary constants establish their data/case predicates without becoming
// generic indices. Keep exact u64 bits through nested record/array copies.
public data Bounded [copy] where value <= 7 { value: u64; }
public data Choice [copy] {
    case Empty;
    case Selected(value: u64) where value <= 7;
    case Uninhabited(value: u64) where value < 0;
}
public data Packet [copy] {
    bounded: Bounded;
    rows: [Bounded; 2];
    choice: Choice;
    maximum: u64;
}
public const Packet::VALUE: Packet = Packet {
    bounded: Bounded { value: 7 },
    rows: [Bounded { value: 0 }, Bounded { value: 6 }],
    choice: Choice::Selected { value: 5 },
    maximum: 18446744073709551615,
};
data Main { packet: Packet; }
machine Main::main(main: &mut Main) crashes Trap {
    main.packet = Packet::VALUE;
    let packet: Packet = Packet::VALUE;
    let wrapped: u64 in Wrapping = (packet.maximum as u64 in Wrapping) + 1;
    transition wrapped == 0 && main.packet.bounded.value == 7 && packet.rows[1].value == 6 {
        true -> inspect(packet.choice)
        false -> bad()
    }
    state inspect(choice: Choice) {
        transition choice {
            Choice::Selected { value } -> check(value)
            _ -> bad()
        }
    }
    state check(value: u64) {
        transition value == 5 { true -> done() false -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
