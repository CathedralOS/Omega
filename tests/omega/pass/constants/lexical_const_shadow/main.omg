// A `const` aggregate value may be shadowed lexically at every binder
// depth: a const record `KEY`, a param named `KEY`, and a local
// `let KEY` — each resolves to its own stage.
data Key [copy] { value: u64; }
const KEY: Key = Key { value: 1 };
machine root_key() -> Key { KEY }
machine keep(KEY: Key) -> Key { KEY }
machine local_key(input: Key) -> Key {
    let KEY: Key = input;
    KEY
}
machine later_key(input: Key) -> Key {
    let selected: Key = KEY;
    let KEY: Key = input;
    selected
}

data Main {}
machine Main::main(main: &mut Main) { }
