// Expected exit: 0
// read<7>() adds the zero `amount` field of a record constant, so it returns exactly 7.
data Adjustment [copy] { before: u64; amount: u64; after: u64; }
const OFFSET: Adjustment = Adjustment { before: 13, amount: 0, after: 17 };
machine read<const Value: u64>() -> u64
requires Value <= 100
ensures result == Value
{ Value + OFFSET.amount }
machine main() crashes Trap {
    let value: u64 = read<7>();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
