// A completed call carries the actual numeric extent, not source storage identity.
// Expected exit: 0
machine window(items: &[u8], offset: u64, limit: u64) -> &[u8]
requires offset <= limit && limit <= items.len
ensures true && result.len == limit - offset {
    &items[offset..limit]
}
machine requires_one(items: &[u8]) -> u8
requires items.len == 1 {
    items[0]
}
machine main() crashes Trap {
    let items: [u8; 3] = [1, 2, 3];
    let result: &[u8] = window(&items, 1, 2);
    let observed: u8 = requires_one(result);
    transition observed == 2u8 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
