// Importing the core float operation surface makes primitive spellings resolve
// to named Float requirements while retaining the bootstrap native lowering.
// Both permanent formats participate, and comparison is a separate identity
// from arithmetic.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    left32: f32;
    right32: f32;
    sum32: f32;
    difference32: f32;
    product32: f32;
    quotient32: f32;
    left64: f64;
    right64: f64;
    sum64: f64;
    difference64: f64;
    product64: f64;
    quotient64: f64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.left32 = 6.0;
    main.right32 = 2.0;
    main.sum32 = main.left32 + main.right32;
    main.difference32 = main.left32 - main.right32;
    main.product32 = main.left32 * main.right32;
    main.quotient32 = main.left32 / main.right32;
    main.left64 = 9.0;
    main.right64 = 3.0;
    main.sum64 = main.left64 + main.right64;
    main.difference64 = main.left64 - main.right64;
    main.product64 = main.left64 * main.right64;
    main.quotient64 = main.left64 / main.right64;
    transition main.sum32 == 8.0
        && main.difference32 == 4.0
        && main.product32 == 12.0
        && main.quotient32 == 3.0
        && main.left32 == main.left32
        && main.left32 != main.right32
        && main.right32 < main.left32
        && main.right32 <= main.left32
        && main.left32 > main.right32
        && main.left32 >= main.right32
        && main.sum64 == 12.0
        && main.difference64 == 6.0
        && main.product64 == 27.0
        && main.quotient64 == 3.0
        && main.left64 == main.left64
        && main.left64 != main.right64
        && main.right64 < main.left64
        && main.right64 <= main.left64
        && main.left64 > main.right64
        && main.left64 >= main.right64 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(77); }
}
