// Bitwise operators as runtime values: AND (`&`), OR (`|`), XOR (`^`). They
// produce integers (not booleans) and cannot overflow, so they carry no
// arithmetic domain obligation. `12 & 10 == 8`, `12 | 10 == 14`, `12 ^ 10 == 6`.
// Precedence sits between comparison and the shifts (Rust-style), and infix `&`
// is disambiguated from a prefix reference by position.

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    a: i32;
    b: i32;
    and_result: i32;
    or_result: i32;
    xor_result: i32;
}

machine Main::main(&mut self) reaches Console {
    self.a = 12;
    self.b = 10;
    self.and_result = self.a & self.b; // 8
    self.or_result = self.a | self.b;  // 14
    self.xor_result = self.a ^ self.b; // 6

    transition self.and_result == 8 {
        true -> check_or(&mut self)
        false -> bad(&mut self)
    }

    state check_or(main: &mut Main) {
        transition main.or_result == 14 {
            true -> check_xor(main)
            false -> bad(main)
        }
    }

    state check_xor(main: &mut Main) {
        transition main.xor_result == 6 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
