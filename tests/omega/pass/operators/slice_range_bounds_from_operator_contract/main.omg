// The imported Slice::range contract must accept proven closed bounds, including
// an empty range at the end. This is the positive control for the invalid range
// in fail/slices/subslice_range_operator_contract_unproven.
use omega::language::core::slice;

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();
    let middle: &[Entry] = view[1..3];
    let empty: &[Entry] = view[4..4];
    middle.len + empty.len
}
