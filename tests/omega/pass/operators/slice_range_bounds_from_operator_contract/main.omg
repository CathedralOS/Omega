// Importing slice helpers leaves builtin bounds in force.

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine inspect(main: &mut Main) -> u64 {
    // Both ordinary and empty endpoint windows retain checked builtin bounds.
    let view: &[Entry] = &main.entries;
    let middle: &[Entry] = view[1..3];
    let empty: &[Entry] = view[4..4];
    middle.len + empty.len
}
