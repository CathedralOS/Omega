// A specialized reference result supplies one scalar selector snapshot.
data Main where position <= 1 { values: [i64; 2]; position: u64; }
machine identity<'input, T>(position: &'input T) -> &'input T { position }
machine reset(position: &mut u64) -> i64 requires position <= 1 ensures position <= 1 {
    position = 0;
    -17
}
machine replace(values: &write [i64; 2], position: &mut u64) requires position <= 1 ensures position <= 1 {
    values[identity(&position)] = reset(&mut position);
}
machine Main::main(main: &mut Main) crashes Trap {
    main.values[0] = 85;
    main.values[1] = 29;
    main.position = 1;
    replace(&write main.values, &mut main.position);
    transition main.position == 0 && main.values[0] == 85 && main.values[1] == -17 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
