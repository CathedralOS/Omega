use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed {
        ByteRead::Eof -> emit(main, 37)
        ByteRead::Byte { value } -> emit(main, (value as i32 in Wrapping) % 82)
    }
    state emit(main: &mut Main, value: i32 in Wrapping) {
        number(value);
        number(81);
        Console::exit_process(0);
    }
}

// The original value survives fixed-register division and a provider call,
// then supplies the remainder. Each use needs its own admitted live range.
machine number(value: i32 in Wrapping) reaches Console {
    transition value >= 10 {
        true -> higher(value)
        _ -> digit(value)
    }
    state higher(value: i32 in Wrapping) {
        Console::write_byte(((value / 10) + 48) as i32);
        transition { _ -> digit(value % 10) }
    }
    state digit(value: i32 in Wrapping) {
        Console::write_byte((value + 48) as i32);
    }
}
