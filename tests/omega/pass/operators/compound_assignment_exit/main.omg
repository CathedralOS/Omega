// Compound assignment operators (`+=`, `-=`, `*=`, `/=`, `%=`), each desugaring
// to `x = x OP y`. Chaining them in one state also exercises the static-value
// invalidation fix: every later read of `v` must observe the prior write,
// not the stale entry-value constant fold.

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let mut v: i32 = 10;
    v += 5; // 15
    v -= 3; // 12
    v *= 2; // 24
    v /= 4; // 6
    v %= 4; // 2

    transition v == 2 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
