// Integer division as a runtime value: `12 / 4 == 3` in `u64`, the realized
// exact-division carrier. The deployable shape matches the sibling runtime
// operator canaries: the quotient is checked in a guard ladder and the
// process exits 70 only when the computed value is exact.

use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Service<Console>;
    numerator: u64;
    denominator: u64;
    quotient: u64;
}

machine Main::main(&mut self) reaches Console {
    self.numerator = 12;
    self.denominator = 4;
    self.quotient = self.numerator / self.denominator;

    transition self.quotient == 3 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
