data Frame { value: u64; }
data ReadOnly { value: u64; }
data Main { frame: Frame; read_only: ReadOnly; values: [u64; 2]; }

machine [] Frame::at(frame: &mut Frame, index: u64) -> u64 {
    frame.value = 70;
    frame.value
}

machine [..] ReadOnly::range(frame: &ReadOnly, start: u64, end: u64) -> u64 {
    frame.value
}

machine available<Element>(items: &[Element]) -> bool {
    items.len == 2
}

machine Main::main(main: &mut Main) crashes Trap {
    main.read_only.value = 30;
    main.values[0] = 70;
    let changed: u64 = main.frame[0];
    let ranged: u64 = main.read_only[..1];
    let complete: bool = available(&main.values);
    transition changed == 70 && main.frame.value == 70 && ranged == 30 && complete {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
