// Xorshift32 PRNG -- exercises bitwise XOR and bit shifts COMPOSING into a real
// algorithm, and pins native==interpreter agreement on the whole sequence (a
// signed-vs-logical `>>` divergence between backends would change the draw).
// Seed 2463534242 -> one xorshift step -> low byte 99. Self-checks and exits 70.

use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut state: u32 in Wrapping = 2463534242;

    let mut scratch: u32 in Wrapping = state << 13;
    state = state ^ scratch;

    scratch = state >> 17;
    state = state ^ scratch;

    scratch = state << 5;
    state = state ^ scratch;

    let mut output: i32 = (state & 255) as i32;

    transition output == 99 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
