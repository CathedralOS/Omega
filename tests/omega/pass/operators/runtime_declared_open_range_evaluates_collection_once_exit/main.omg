data Window [copy] { len: u64; }
data Main { calls: u64; }

machine collection(main: &mut Main) -> Window {
    main.calls = ((main.calls as u64 in Wrapping) + 1) as u64;
    Window { len: main.calls }
}

// Deliberately not builtin slicing: execution must use the selected body.
machine [..] Window::range(window: Window, start: u64, end: u64) -> u64 {
    ((window.len as u64 in Wrapping) * 10 + (end as u64 in Wrapping)) as u64
}

machine choose(main: &mut Main, enabled: bool) -> u64 {
    match enabled {
        true -> collection(main)[..],
        false -> 0
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    let selected: u64 = choose(main, true);
    let skipped: u64 = choose(main, false);
    transition selected == 11 && skipped == 0 && main.calls == 1 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
