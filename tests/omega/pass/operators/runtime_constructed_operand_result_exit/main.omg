use omega::language::core::float_operations;

data Input [copy] { value: f32; }
data Other [copy] { value: f32; }
data Ordered [copy] { first: u64; second: u64; }
data Choice [copy] { case Present(value: u64); case Empty; }
data Token { value: u64; }
data Wrapped { token: Token; }

machine + Input::combine(left: Input, right: Input) -> f64 {
    (left.value as f64) + (right.value as f64)
}

machine + Other::combine(left: Other, right: Other) -> f64 {
    (left.value as f64) - (right.value as f64)
}

machine forward<Value>(value: Value) -> Value { value }

machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}

machine in_order(before: u64, pair: Ordered, after: u64) -> bool {
    before == 1 && pair.second == 2 && pair.first == 3 && after == 4
}

machine select(enabled: bool, count: &mut u64) -> bool {
    enabled && in_order(tick(count), Ordered {
        second: tick(count), first: tick(count)
    }, tick(count))
}

machine first(values: [u64; 2]) -> u64 { values[0] }
machine case_value(choice: Choice) -> u64 {
    transition choice {
        Choice::Present { value } -> value
        Choice::Empty -> 0
    }
}
machine consume(value: Wrapped) -> u64 { value.token.value }
machine transfer(enabled: bool) -> bool {
    let token: Token = Token { value: 9 };
    let survivor: Token = Token { value: 10 };
    let consumed: bool = enabled && consume(Wrapped { token: token }) == 9;
    consumed && survivor.value == 10
}

machine main() crashes Trap {
    let result: bool = (Input { value: 0.25f32 } + Input { value: 0.25f32 }) == 0.5;
    let widened: bool = (Input { value: 16777216.0f32 } + Input { value: 1.0f32 }) == 16777217.0;
    let other: bool = (Other { value: 0.25f32 } + Other { value: 0.25f32 }) == 0.0;
    let named: bool = Input::combine(Input { value: 0.25f32 }, Input { value: 0.25f32 }) == 0.5;
    // Inferred generic results must expose the same nominal operator meaning.
    let forwarded: bool = (forward<Input>(Input { value: 0.25f32 })
        + forward<Input>(Input { value: 0.25f32 })) == 0.5;
    let mut count: u64 = 0;
    let skipped: bool = select(false, &mut count);
    let selected: bool = select(true, &mut count);
    let array: bool = first([tick(&mut count), tick(&mut count)]) == 5;
    let choice: bool = case_value(Choice::Present { value: tick(&mut count) }) == 7;
    let transferred: bool = transfer(true);
    let retained: bool = transfer(false);
    transition result && widened && other && named && forwarded && skipped == false && selected
        && array && choice && transferred && retained == false && count == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
