// A declared reference operand keeps caller storage through normalization.
data Buffer { value: u64; }
data Main { buffer: Buffer; position: u64; }
machine [] Buffer::at(buffer: &Buffer, position: &mut u64) -> u64 {
    position = 0;
    buffer.value
}
machine Main::main(main: &mut Main) crashes Trap {
    main.buffer.value = 73;
    main.position = 1;
    let value: u64 = main.buffer[&mut main.position];
    transition value == 73 && main.position == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
