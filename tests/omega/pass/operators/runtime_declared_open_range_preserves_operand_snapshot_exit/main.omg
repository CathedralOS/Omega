data Window [copy] { len: u64; }
data Main { window: Window; calls: u64; }

machine alter(main: &mut Main) -> u64 {
    main.window.len = 9;
    main.calls = ((main.calls as u64 in Wrapping) + 1) as u64;
    0
}

machine [..] Window::range(window: Window, start: u64, end: u64) -> u64 {
    ((window.len as u64 in Wrapping) * 10 + (end as u64 in Wrapping)) as u64
}

machine choose<Marker>(main: &mut Main, enabled: bool) -> u64 {
    match enabled {
        true -> main.window[alter(main)..],
        false -> 0
    }
}

machine collection(main: &mut Main) -> Window {
    main.calls = ((main.calls as u64 in Wrapping) + 1) as u64;
    Window { len: main.calls }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.window.len = 5;
    let selected: u64 = choose<u64>(main, true);
    let skipped: u64 = choose<u64>(main, false);
    let independent: u64 = Window::range(collection(main), 0, collection(main).len);
    transition selected == 55 && skipped == 0 && independent == 23 && main.calls == 3 && main.window.len == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
