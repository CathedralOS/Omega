// Typed integer literal suffixes (`5i64`, `7u32`, `9usize`). The suffix selects
// the literal's primitive type; the value must round-trip through storage and
// compare equal to the same suffixed literal.

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    wide: i64;
    small: u32;
    size: u64;
}

machine Main::main(&mut self) reaches Console {
    self.wide = 100i64;
    self.small = 7u32;
    self.size = 9usize;

    transition self.wide == 100i64 {
        true -> check_small(&mut self)
        false -> bad(&mut self)
    }

    state check_small(main: &mut Main) {
        transition main.small == 7u32 {
            true -> check_size(main)
            false -> bad(main)
        }
    }

    state check_size(main: &mut Main) {
        transition main.size == 9usize {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
