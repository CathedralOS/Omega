use omega::language::core::F64::from_i32;
use omega::language::core::I8::from_f32;

machine main() crashes Trap {
    let narrow: i8 = I8::from_f32(1.0f32);
    let wide: f64 = F64::from_i32(1i32);
    transition narrow == 1i8 && wide == 1.0f64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
