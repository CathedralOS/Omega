// A fixed-token boundary operator whose `requires` names its right operand runs
// through a selected checked satisfier. `prepare(&mut value)` stores 1, returns
// 1 and ensures `value >= 0`, so the right operand read after the effect both
// discharges `right >= 0` and equals the left operand. Reading `value` before
// the effect would compare 1 with 5; a builtin comparison in place of the
// satisfier's body would ignore the selection. The operator is used directly,
// in a later state and through locals, and every use must hold. The same
// program without a satisfier is
// `fail/providers/boundary_operator_without_provider`.
boundary machine == Integer::equal(left: i32, right: i32) -> bool
requires right >= 0;

data CheckedEquality {}

machine CheckedEquality::equal(left: i32, right: i32) -> bool
satisfies Integer::equal
requires right >= 0
{
    left <= right && left >= right
}

machine prepare(value: &mut i32) -> i32
ensures value >= 0 {
    value = 1;
    1
}

machine direct(mut value: i32) -> bool {
    prepare(&mut value) == value
}

machine deferred(value: i32) -> bool {
    transition { _ -> later(value) }
    machine later(mut held: i32) -> bool {
        prepare(&mut held) == held
    }
}

machine through_locals(mut value: i32) -> bool {
    let prepared: i32 = prepare(&mut value);
    let equal: bool = prepared == value;
    equal
}

machine main() crashes Trap {
    let first: bool = direct(5);
    let second: bool = deferred(5);
    let third: bool = through_locals(5);
    transition first && second && third {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
