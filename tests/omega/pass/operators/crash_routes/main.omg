// Invocation-specific operator crash routes through execution.
// `safe` discharges the boundary == Trap route with its own `requires`;
// `may_crash` propagates the uncovered route and `wrapper` covers it by
// declaration. `Main::main` calls both with operands that keep every route
// dormant: the run must exit 0, not trap.
// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish.
public domain i32::Compared;

boundary machine == Comparison::equal(left: i32 in Compared, right: i32 in Compared) -> bool
crashes Trap !(right >= 0);

data Comparison { }

data ComparisonProvider { }

machine ComparisonProvider::equal(left: i32 in Compared, right: i32 in Compared) -> bool
    satisfies Comparison::equal
{
    transition left < right {
        true -> false
        _ -> !(right < left)
    }
}

public machine safe(value: i32 in Compared) -> bool
requires value >= 0 {
    1 == value
}

machine may_crash(left: i32 in Compared, right: i32 in Compared) -> bool {
    left == right
}

public machine wrapper(left: i32 in Compared, right: i32 in Compared) -> bool
crashes Trap {
    may_crash(left, right)
}

data Main { }

machine Main::main(main: &mut Main) crashes Trap {
    let discharged: bool = safe(1);
    let covered: bool = wrapper(2, 2);
    transition discharged {
        true -> covered_observed(covered)
        _ -> bad()
    }
    machine covered_observed(covered: bool) {
        transition covered {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
