// Unary minus: negative integer literals (`-5`, folded to a constant so they
// work in guards) and negation of a non-literal (`-main.v`, lowered to `0 - v`).

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    v: i32;
    n: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.v = 10;
    main.n = -main.v;

    transition main.n == -10 {
        true -> check_literal(main)
        false -> bad(main)
    }

    state check_literal(main: &mut Main) {
        main.v = -5;
        transition main.v < 0 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
