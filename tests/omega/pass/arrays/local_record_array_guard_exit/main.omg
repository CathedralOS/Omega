data Values {
    items: [i32; 4];
    other: [i32; 4];
}

data Context {
    values: Values;
}

machine store(context: &mut Context) {
    context.values.items[1] = 7;
    context.values.other[1] = 11;
}

machine main() crashes Trap {
    let mut context: Context;
    store(&mut context);
    transition context.values.items[1] == 7
        && context.values.other[1] == 11
        && context.values.items[2] == 0 {
        true -> passed()
        false -> failed()
    }

    state passed() {}
    state failed() { crash Trap; }
}
