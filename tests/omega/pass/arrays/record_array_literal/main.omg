// Record literals supply closed primitive array members at every
// site: two arrays in one literal, nested `[[i32; 2]; 2]`, an array
// beside scalar and nested-record members, an array inside a nested
// literal, and a negative operand element — each lowers as one
// scalar-array establishment in row-major order.
data Pair {
    left: [u8; 2];
    right: [u8; 2];
}
data Grid {
    cells: [[i32; 2]; 2];
}
data Framed {
    header: u8;
    payload: [i64; 3];
    tag: Pair;
}
data Outer {
    inner: Grid;
}
data Main {
    pair: Pair;
    grid: Grid;
    framed: Framed;
    outer: Outer;
}
machine Main::main(main: &mut Main) {
    main.pair = Pair { left: [1, 2], right: [3, 4] };
    main.grid = Grid { cells: [[10, 20], [30, 40]] };
    main.framed = Framed { header: 7, payload: [1, 0 - 2, 3], tag: Pair { left: [5, 6], right: [7, 8] } };
    main.outer = Outer { inner: Grid { cells: [[5, 6], [7, 8]] } };
    transition main.grid.cells[1][0] == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
