// Owned array operands snapshot contents at their exact evaluation
// positions: `before` captures pre-write contents, the effectful `marker`
// rewrites index 0, and `after` captures post-write contents — the same
// source home stays writable between the independent copies.
public data ArrayReader {}
public boundary requirement ArrayReader::epochs(
    before: [u8; 4], marker: u64, after: [u8; 4]
) -> i32;
data ArrayReaderProvider {}
machine ArrayReaderProvider::epochs(before: [u8; 4], marker: u64, after: [u8; 4]) -> i32
satisfies ArrayReader::epochs {
    transition marker == 22
        && before[0] == 31 && after[0] == 99 {
        true -> 70
        _ -> 72
    }
}

data Buffer { values: [u8; 4]; effects: u64 in Wrapping; }
machine write99(buffer: &mut Buffer) -> u64 {
    buffer.values[0] = 99;
    22
}

data Main { buf: Buffer; out: i32; }

machine Main::main(main: &mut Main) {
    main.buf.values[0] = 31;
    main.buf.values[1] = 40;
    main.buf.values[2] = 50;
    main.buf.values[3] = 60;
    let result: i32 = ArrayReader::epochs(main.buf.values, write99(&mut main.buf), main.buf.values);
    main.out = result;
}
