use omega::language::core::layout;
// A runtime-indexed element is the recast origin:
// `&mut main.bytes[main.position] as &mut RawView` views the byte at a
// checked index through the plan-laid record.
data SignedByte {}
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
data PortableByte [copy] { value: i64; }
data RawView { value: SignedByte<PortableByte>; }
data Main { bytes: [u8; 2]; position: u64; }
machine Main::main(main: &mut Main) {
    main.position = 1;
    let view: &mut RawView = &mut main.bytes[main.position] as &mut RawView;
    view.value.value = -128;
    transition main.bytes[1] == 128 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
