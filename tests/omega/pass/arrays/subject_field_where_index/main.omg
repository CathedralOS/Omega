// A data `where` fact bounds a field read through the machine's explicit
// subject in a SUCCESSOR state, under a computed index: `main.k + 1`
// discharges `arr`'s bound by interval arithmetic over `k`'s standing
// facts — the literal store's exact value does not survive the
// transition, only the where fact does.
data Main where 0 <= k, k <= 3 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = main.arr[main.k + 1];
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = main.arr[main.k + 1];
    }
}
