// An indexed scalar replacement carries the same computed-value root as a
// record field: selected IEEE operations complete before storage is written.
// Challenge both record-backed f64 elements and borrowed local f32 elements.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    levels: [f64; 2];
    millimetres: i64;
}

machine Main::replace_level(main: &mut Main, position: u64)
requires position < 2
{
    main.levels[position] = F64::from_i64(main.millimetres) / 1000.0;
}

machine store_local(values: &mut [f32; 2], position: u64, value: f32)
requires position < 2
{
    values[position] = (value + 1.0f32) * 2.0f32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.millimetres = 2250;
    Main::replace_level(main, 1);
    let mut local_values: [f32; 2];
    store_local(&mut local_values, 0, 3.0f32);
    transition main.levels[1] == 2.25 && local_values[0] == 8.0f32 && main.levels[0] == 0.0 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
