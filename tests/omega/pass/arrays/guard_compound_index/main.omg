// A compound index bound follows an explicit data subject into its
// successor: the edge guard `main.b * 20 + main.a >= 0 && ... < 200`
// discharges the `grid` write in `put` — the same compound expression
// serves as guard fact and index.
data Main {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    grid: [i32; 200] in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.a = 1;
    main.b = 1;
    transition main.b * 20 + main.a >= 0 && main.b * 20 + main.a < 200 {
        true -> put(main)
        _ -> done(main)
    }
    machine put(main: &mut Main) { main.grid[main.b * 20 + main.a] = 7; }
    machine done(main: &mut Main) {}
}
