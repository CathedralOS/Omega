// Expected exit: 0. A later storage mutation does not change captured scalars.
data Limited where value <= 320 { value: u64; }
data Input where total <= 320, amount <= 1000 { total: u64; amount: u64; }
machine clobber(input: &mut Input) { input.amount = 321; }
machine write(output: &mut Limited, input: &mut Input)
requires input.amount <= 320 - input.total
{
    let total: u64 = input.total;
    let amount: u64 = input.amount;
    clobber(input);
    output.value = total + amount;
}
machine main() crashes Trap {
    let mut output: Limited = Limited { value: 0 };
    let mut input: Input = Input { total: 300, amount: 20 };
    write(&mut output, &mut input);
    transition output.value == 320 && input.amount == 321 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
