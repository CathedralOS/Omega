// Expected exit: 0. A saved loop decision survives an unrelated field write and Boolean alias.
data Main { items: [u8; 3]; index: u64 in Trapping; other: u64 in Wrapping; }
machine Main::drive(main: &mut Main) {
    main.index = 0;
    transition { _ -> body(main) }
    machine body(main: &mut Main) {
        main.items[main.index] = 7;
        main.index = main.index + 1;
        transition { _ -> test(main) }
    }
    machine test(main: &mut Main) {
        let observed: bool = main.index < 3;
        main.other = main.other + 1;
        let has_next: bool = observed;
        transition has_next { true -> body(main) false -> done(main) }
    }
    machine done(main: &mut Main) {}
}
machine main() crashes Trap {
    let mut value: Main;
    Main::drive(&mut value);
    transition value.index == 3 && value.other == 3
        && value.items[0] == 7 && value.items[1] == 7 && value.items[2] == 7 {
        true -> {} false -> bad()
    }
    machine bad() { crash Trap; }
}
