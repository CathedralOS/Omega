// Expected exit: 0. Scalar homes snapshot each element before the next call,
// including construction inside a scalar-returning machine.
data Bounded [copy] where value <= 100 {
    value: u64;
}

machine replace(value: &mut Bounded) -> Bounded {
    value.value = 8;
    Bounded { value: 92 }
}

machine ordered(value: &mut Bounded) -> u64 {
    let values: [Bounded; 2] =
        [value, replace(&mut value)];
    values[0].value
}

machine main() crashes Trap {
    let mut value: Bounded = Bounded { value: 7 };
    let captured: u64 = ordered(&mut value);
    let mut original: [Bounded; 2] =
        [value, replace(&mut value)];
    let copied: [Bounded; 2] = original;
    original[0].value = 9;
    transition captured == 7 && value.value == 8 && original[0].value == 9
        && copied[0].value == 8 && copied[1].value == 92 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
