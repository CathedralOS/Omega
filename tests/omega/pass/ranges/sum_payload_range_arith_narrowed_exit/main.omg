// Sum-payload narrowing through ARITHMETIC in a transition arg (2026-07-08),
// migrated off the revoked `[0..=10]`/`[0..=100]` suffixes. The payload keeps
// its declared bound as the explicit predicate domain `i32 in Ten`:
// construction store-enforces it (`Cmd::Dim { amount: 100 }` is rejected),
// and the domain membership discharges `scale`'s numeric requires. Inside
// `scale` the requires-bounded operand proves `a * 10` exact and the hoisted
// `scaled` local carries [0..=100] into `apply`'s contract (a binary
// expression cannot be a requires argument's folded bound, so the multiply
// happens one state earlier). Guard-gated: a too-wide result stays unproven
// (fail canary sum_payload_arith_too_wide).
// Cmd::Dim { amount: 7 } -> apply(7 * 10 = 70) -> exit 70.
use omega_language_std::console;
use omega::language::core::service;
domain i32::Ten requires 0 <= self && self <= 10;
data Cmd { case Dim(amount: i32 in Ten); case Off; }
data Main { console: Binding<Console>; c: Cmd; }
machine Main::main(&mut self) reaches Console {
    self.c = Cmd::Dim { amount: 7 };
    transition self.c {
        Cmd::Dim { amount } -> scale(amount)
        Cmd::Off            -> apply(0)
    }
    state scale(&mut self, a: i32) requires a >= 0 && a <= 10 {
        let scaled: i32 = a * 10;
        transition { _ -> apply(scaled) }
    }
    state apply(&mut self, target: i32) requires 0 <= target && target <= 100 {
        self.console.exit_process(target);
    }
    state bad(&mut self) { self.console.exit_process(1); }
}
machine Main::run(&mut self) { self.main(); }
