// A case-payload data predicate justifies the numeric `scale` contract.
// The exact multiply is carried through the local into `apply`'s contract.
// Cmd::Dim { amount: 7 } -> apply(7 * 10 = 70) -> exit 70.
use omega_language_std::console;
data Cmd requires (self in Cmd::Off) || ((self in Cmd::Dim) && 0 <= self.amount && self.amount <= 10) { case Dim(amount: i32); case Off; }
data Main { c: Cmd; }
machine Main::main(main: &mut Main) reaches Console {
    main.c = Cmd::Dim { amount: 7 };
    transition main.c {
        Cmd::Dim { amount } -> scale(main, amount)
        Cmd::Off            -> apply(main, 0)
    }
    machine scale(main: &mut Main, a: i32) requires a >= 0 && a <= 10 {
        let scaled: i32 = a * 10;
        transition { _ -> apply(main, scaled) }
    }
    machine apply(main: &mut Main, target: i32) requires 0 <= target && target <= 100 {
        Console::exit_process(target);
    }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}
machine Main::run(main: &mut Main) { Main::main(main); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main = Main { c: Cmd::Dim { amount: 0 } };
    Main::main(&mut entry_storage);
}
