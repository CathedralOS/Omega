// RUN CANARY (exit 70) -- the ERGONOMIC Filesystem wrapper natively on
// windows_x86_64: every result SHAPE the wrapper produces, asserted end to end.
//   write_all           -> UnitResult::Ok            (create+write+close)
//   create_new existing -> OpenResult::Error{kind}   kind == AlreadyExists
//   open                -> OpenResult::Ok{File}      the STRUCT payload, USED:
//   read(file, ..)      -> IoResult::Ok{count}       the File rides as an arg
//   remove              -> UnitResult::Ok
//   remove missing      -> UnitResult::Error{kind}   kind == NotFound
// This runs the value-call payload-delivery fixes (TASKS_FS blockers #2/#3)
// through the REAL wrapper -- the Windows twins covered the pure-language
// shapes; this covers the fs machinery itself. The interpreter's virtual fs
// is the differential oracle. Content is "hello" (no CR/LF/^Z bytes), so the
// wrapper's text-mode open (flags 0, no O_BINARY) reads it unmangled.
// exits: 70 ok; 71 write_all not Ok; 72 create_new not Error; 73 kind not
// AlreadyExists; 74 open not Ok; 75 read not Ok; 76 count != 5; 77 first
// byte wrong; 78 remove not Ok; 79 remove(missing) not Error; 80 kind not
// NotFound.

use omega_language_std::filesystem;
use omega_language_std::filesystem_host;

use omega_language_std::console;

data Main {
    fs: Filesystem;
    buffer: [u8; 32];
    unit_result: UnitResult;
    open_result: OpenResult;
    io_result: IoResult;
    rc: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.unit_result = Filesystem::write_all(&mut main.fs, "omega_wrapper_probe.txt", "hello");
    transition main.unit_result { UnitResult::Ok -> exists_check(main) _ -> bad(main, 71) }

    state exists_check(main: &mut Main) {
        // AlreadyExists via mkdir (flag-FREE, so fully portable): create_new's
        // O_CREAT|O_EXCL carries DARWIN flag values, which mean different bits
        // to msvcrt (0x200 = darwin O_CREAT = windows O_TRUNC!) -- the flag
        // portability question rides the portable-fs design (TASKS_FS #6).
        main.unit_result = Filesystem::create_dir(&mut main.fs, "omega_wrapper_probe_dir");
        transition main.unit_result { UnitResult::Ok -> exists_again(main) _ -> bad(main, 72) }
    }
    state exists_again(main: &mut Main) {
        let result: UnitResult = Filesystem::create_dir(&mut main.fs, "omega_wrapper_probe_dir");
        transition result {
            UnitResult::Error { kind } -> exists_kind(main, kind)
            _ -> bad(main, 81)
        }
    }
    state exists_kind(main: &mut Main, kind: ErrorKind) {
        main.unit_result = Filesystem::remove_dir(&mut main.fs, "omega_wrapper_probe_dir");
        transition kind { ErrorKind::AlreadyExists -> open_it(main) _ -> bad(main, 73) }
    }

    state open_it(main: &mut Main) {
        main.open_result = Filesystem::open(&mut main.fs, "omega_wrapper_probe.txt");
        transition main.open_result {
            OpenResult::Ok { file } -> read_it(main, file)
            _ -> bad(main, 74)
        }
    }
    state read_it(main: &mut Main, file: File) {
        main.io_result = Filesystem::read(&mut main.fs, file, &mut main.buffer, 32);
        main.rc = Filesystem::close(&mut main.fs, file);
        transition main.rc == 0 { true -> read_checked(main) _ -> bad(main, 82) }
    }
    state read_checked(main: &mut Main) {
        transition main.io_result {
            IoResult::Ok { count } -> check_count(main, count)
            _ -> bad(main, 75)
        }
    }
    state check_count(main: &mut Main, count: u64) {
        transition count == 5 { true -> check_byte(main) _ -> bad(main, 76) }
    }
    state check_byte(main: &mut Main) {
        transition main.buffer[0] == 104 { true -> remove_it(main) _ -> bad(main, 77) }
    }

    state remove_it(main: &mut Main) {
        main.unit_result = Filesystem::remove(&mut main.fs, "omega_wrapper_probe.txt");
        transition main.unit_result { UnitResult::Ok -> remove_missing(main) _ -> bad(main, 78) }
    }
    state remove_missing(main: &mut Main) {
        let result: UnitResult = Filesystem::remove(&mut main.fs, "omega_wrapper_probe.txt");
        transition result {
            UnitResult::Error { kind } -> missing_kind(main, kind)
            _ -> bad(main, 79)
        }
    }
    state missing_kind(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> good(main) _ -> bad(main, 80) }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
