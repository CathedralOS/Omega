// Expected Windows exit: 70. A two-byte read into an offset five-byte view
// writes only that prefix. Zero/oversized requests preserve the shared cursor.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::filesystem_authority;

data Main { buffer: [u8; 8]; handle: u64; }
machine Main::main(main: &mut Main)
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    main.handle = block WindowsFilesystemHost::create_file("omega_bounded.txt", 3221225472, 7, 2, 128);
    transition main.handle != 0 { true -> seed(main) _ -> bad(main, 71) }
    machine seed(main: &mut Main) {
        let written: i64 = block WindowsFilesystemHost::write_file(main.handle, "abc");
        let position: i64 = block WindowsFilesystemHost::set_file_pointer(main.handle, 0, 0);
        transition written == 3 && position == 0 { true -> read(main) _ -> bad(main, 72) }
    }
    machine read(main: &mut Main) {
        main.buffer[0] = 201; main.buffer[1] = 202;
        main.buffer[2] = 203; main.buffer[3] = 204;
        main.buffer[4] = 205; main.buffer[5] = 206;
        main.buffer[6] = 207; main.buffer[7] = 208;
        let count: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer[2..7], 2);
        transition count == 2 && main.buffer[0] == 201 && main.buffer[1] == 202
            && main.buffer[2] == 97 && main.buffer[3] == 98 && main.buffer[4] == 205
            && main.buffer[5] == 206 && main.buffer[6] == 207 && main.buffer[7] == 208 {
            true -> empty_and_invalid(main)
            _ -> bad(main, 73)
        }
    }
    machine empty_and_invalid(main: &mut Main) {
        let empty_read: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer[2..7], 0);
        let empty_write: i64 = block WindowsFilesystemHost::write_file(main.handle, "");
        let oversized: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer[2..7], 6);
        transition empty_read == 0 && empty_write == 0 && oversized == -87
            && main.buffer[0] == 201 && main.buffer[1] == 202 && main.buffer[2] == 97
            && main.buffer[3] == 98 && main.buffer[4] == 205 && main.buffer[5] == 206
            && main.buffer[6] == 207 && main.buffer[7] == 208 {
            true -> cursor(main)
            _ -> bad(main, 74)
        }
    }
    machine cursor(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer, 1);
        transition count == 1 && main.buffer[0] == 99 { true -> cleanup(main) _ -> bad(main, 75) }
    }
    machine cleanup(main: &mut Main) {
        let closed: i32 = block WindowsFilesystemHost::close_handle(main.handle);
        let removed: i32 = block WindowsFilesystemHost::delete_file("omega_bounded.txt");
        transition closed == 0 && removed == 0 { true -> good(main) _ -> bad(main, 76) }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
