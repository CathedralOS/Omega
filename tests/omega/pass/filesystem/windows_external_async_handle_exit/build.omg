use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "windows_external_async_handle_exit");
    Build::depend(builder, Source::Path {
        location: "../../../../../source/library/std"
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);

 Build::bind<ExternalFileOpen::open>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "CreateFileW"
    } });
}
