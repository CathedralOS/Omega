// Expected Windows exit: 70. External asynchronous handles reject before any
// caller buffer is lent, including zero-length requests. Synchronous transfers
// retain a shared cursor and never consume the caller's original HANDLE.
// Locks also refuse asynchronous objects before borrowing request storage;
// every acquisition mode is tried on a free file, avoiding a blocking oracle.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;

domain [u16; 16]::ExternalNativePath(path) requires path[15] == 0;

boundary trait ExternalFileOpen {
    machine open(path: &[u16; 16] in ExternalNativePath, access: u32, sharing: u32, security: u64,
        disposition: u32, flags: u32, template: u64) -> i64
    requires security == 0 && template == 0
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    blocks;
}
windows_x86_64 machine external_file_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "CreateFileW"
    } }
}
windows_x86_64 machine external_file_open(path: &[u16; 16] in ExternalNativePath, access: u32, sharing: u32,
    security: u64, disposition: u32, flags: u32, template: u64) -> i64
satisfies ExternalFileOpen::open
via external_file_binding()
requires security == 0 && template == 0
blocks;

data Main { buffer: [u8; 1]; handle: u64; asynchronous: u64; duplicate: u64; }
machine Main::main(main: &mut Main)
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    main.handle = block WindowsFilesystemHost::create_file("omega_async.txt", 3221225472, 7, 2, 128);
    transition main.handle != 0 { true -> seed(main) _ -> bad(main, 71) }
    machine seed(main: &mut Main) {
        let written: i64 = block WindowsFilesystemHost::write_file(main.handle, "ab");
        let position: i64 = block WindowsFilesystemHost::set_file_pointer(main.handle, 0, 0);
        transition written == 2 && position == 0 { true -> external(main) _ -> bad(main, 72) }
    }
    machine external(main: &mut Main) {
        // Deliberately bypass the raw family's open-time async-flag rejection.
        let wide: [u16; 16] = [111u16, 109u16, 101u16, 103u16, 97u16, 95u16,
            97u16, 115u16, 121u16, 110u16, 99u16, 46u16, 116u16, 120u16, 116u16, 0u16];
        let handle: i64 = block external_file_open(&wide, 3221225472, 7, 0, 3, 1073741952, 0);
        transition handle != 0 && handle != -1 { true -> reject(main, handle) _ -> bad(main, 73) }
    }
    machine reject(main: &mut Main, handle: i64) {
        main.asynchronous = narrow_i64_to_u64_wrapping(handle);
        main.buffer[0] = 119;
        let read: i64 = block WindowsFilesystemHost::read_file(main.asynchronous, &mut main.buffer, 1);
        let empty_read: i64 = block WindowsFilesystemHost::read_file(main.asynchronous, &mut main.buffer, 0);
        let write: i64 = block WindowsFilesystemHost::write_file(main.asynchronous, "q");
        let empty_write: i64 = block WindowsFilesystemHost::write_file(main.asynchronous, "");
        transition read == -87 && empty_read == -87 && write == -87 && empty_write == -87 && main.buffer[0] == 119 {
            true -> reject_blocking_exclusive(main)
            _ -> bad(main, 74)
        }
    }
    machine reject_blocking_exclusive(main: &mut Main) {
        let status: i32 = block WindowsFilesystemHost::lock_file(main.asynchronous, true, false);
        transition status == -87 { true -> reject_blocking_shared(main) false -> bad(main, 79) }
    }
    machine reject_blocking_shared(main: &mut Main) {
        let status: i32 = block WindowsFilesystemHost::lock_file(main.asynchronous, false, false);
        transition status == -87 { true -> reject_try_exclusive(main) false -> bad(main, 80) }
    }
    machine reject_try_exclusive(main: &mut Main) {
        let status: i32 = block WindowsFilesystemHost::lock_file(main.asynchronous, true, true);
        transition status == -87 { true -> reject_try_shared(main) false -> bad(main, 81) }
    }
    machine reject_try_shared(main: &mut Main) {
        let status: i32 = block WindowsFilesystemHost::lock_file(main.asynchronous, false, true);
        transition status == -87 { true -> reject_unlock(main) false -> bad(main, 82) }
    }
    machine reject_unlock(main: &mut Main) {
        let status: i32 = block WindowsFilesystemHost::unlock_file(main.asynchronous);
        transition status == -87 { true -> no_leaked_lock(main) false -> bad(main, 83) }
    }
    machine no_leaked_lock(main: &mut Main) {
        let acquired: i32 = block WindowsFilesystemHost::lock_file(main.handle, true, true);
        transition acquired == 0 { true -> unlock_synchronous(main) false -> bad(main, 84) }
    }
    machine unlock_synchronous(main: &mut Main) {
        let released: i32 = block WindowsFilesystemHost::unlock_file(main.handle);
        transition released == 0 { true -> first(main) false -> bad(main, 85) }
    }
    machine first(main: &mut Main) {
        main.duplicate = WindowsFilesystemHost::duplicate_handle(main.handle);
        let read: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer, 1);
        transition main.duplicate != 0 && read == 1 && main.buffer[0] == 97 {
            true -> second(main)
            _ -> bad(main, 75)
        }
    }
    machine second(main: &mut Main) {
        let read: i64 = block WindowsFilesystemHost::read_file(main.duplicate, &mut main.buffer, 1);
        let closed: i32 = block WindowsFilesystemHost::close_handle(main.handle);
        transition read == 1 && main.buffer[0] == 98 && closed == 0 { true -> surviving(main) _ -> bad(main, 76) }
    }
    machine surviving(main: &mut Main) {
        let read: i64 = block WindowsFilesystemHost::read_file(main.duplicate, &mut main.buffer, 1);
        transition read == 0 { true -> cleanup(main) _ -> bad(main, 77) }
    }
    machine cleanup(main: &mut Main) {
        let duplicate_closed: i32 = block WindowsFilesystemHost::close_handle(main.duplicate);
        let async_closed: i32 = block WindowsFilesystemHost::close_handle(main.asynchronous);
        let removed: i32 = block WindowsFilesystemHost::delete_file("omega_async.txt");
        transition duplicate_closed == 0 && async_closed == 0 && removed == 0 {
            true -> good(main)
            _ -> bad(main, 78)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
