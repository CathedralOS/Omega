// Expected exit: 0
// Missing POSIX information is not a zero identity. Portable read-only requests
// remain distinct from exact modes, whose sticky/set-ID bits survive updates.
use omega_language_std::filesystem;

machine main() crashes Trap {
    let mut permissions: Permissions;
    transition Permissions::readonly(&permissions) {
        false -> portable(permissions)
        true -> bad()
    }
    machine portable(permissions: Permissions) {
        let mut updated: Permissions = permissions;
        Permissions::set_readonly(&mut updated, true);
        transition updated {
            Permissions::Readonly { value } -> readonly(value)
            _ -> bad()
        }
    }
    machine readonly(value: bool) {
        transition value { true -> other_writers() false -> bad() }
    }
    machine other_writers() {
        let group: Permissions = Permissions::Posix { mode: 16 };
        let other: Permissions = Permissions::Posix { mode: 2 };
        transition !Permissions::readonly(&group) && !Permissions::readonly(&other) {
            true -> exact()
            false -> bad()
        }
    }
    machine exact() {
        let mut permissions: Permissions = Permissions::Posix { mode: 1444 };
        Permissions::set_readonly(&mut permissions, true);
        transition permissions {
            Permissions::Posix { mode } -> check_readonly(permissions, mode)
            _ -> bad()
        }
    }
    machine check_readonly(permissions: Permissions, mode: u32) {
        transition mode == 1316 && Permissions::readonly(&permissions) {
            true -> writable(permissions)
            false -> bad()
        }
    }
    machine writable(permissions: Permissions) {
        let mut updated: Permissions = permissions;
        Permissions::set_readonly(&mut updated, false);
        transition updated {
            Permissions::Posix { mode } -> check_writable(updated, mode)
            _ -> bad()
        }
    }
    machine check_writable(permissions: Permissions, mode: u32) {
        // Enabling writes adds all three write bits; it does not restore the
        // original group/other bits remembered nowhere in this value.
        transition mode == 1462 && !Permissions::readonly(&permissions) {
            true -> absent()
            false -> bad()
        }
    }
    machine absent() {
        let metadata: Metadata = Metadata {
            len: 8, kind: FileKind::File,
            permissions: Permissions::Readonly { value: true }, nlink: 1,
            posix: PosixMetadataResult::Error { kind: ErrorKind::Unsupported },
            modified_secs: -1, accessed_secs: 0,
            creation_time: TimestampResult::Ok { seconds: 0 }, changed_secs: 1
        };
        transition Metadata::is_file(&metadata) && !Metadata::is_dir(&metadata)
            && Metadata::readonly(&metadata) && Metadata::modified(&metadata) == -1 {
            true -> unavailable(Metadata::posix(&metadata))
            false -> bad()
        }
    }
    machine unavailable(result: PosixMetadataResult) {
        transition result {
            PosixMetadataResult::Error { kind } -> unsupported(kind)
            _ -> bad()
        }
    }
    machine unsupported(kind: ErrorKind) {
        transition kind { ErrorKind::Unsupported -> zero_result() _ -> bad() }
    }
    machine zero_result() {
        let result: PosixMetadataResult;
        transition result { PosixMetadataResult::Error { kind } -> zero_error(kind) _ -> bad() }
    }
    machine zero_error(kind: ErrorKind) {
        transition kind { ErrorKind::Other -> zero_values() _ -> bad() }
    }
    machine zero_values() {
        let details: PosixMetadata;
        let result: PosixMetadataResult = PosixMetadataResult::Ok { details: details };
        transition result { PosixMetadataResult::Ok { details } -> valid_zero(details) _ -> bad() }
    }
    machine valid_zero(details: PosixMetadata) {
        transition details.uid == 0 && details.gid == 0 && details.ino == 0
            && details.blocks == 0 && details.blksize == 0 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
