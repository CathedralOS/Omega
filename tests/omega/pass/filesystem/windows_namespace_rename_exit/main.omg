// Expected exit: 70 (Windows). A namespace-only rename replaces a destination,
// removes the old name, preserves the source bytes and reports missing-source failure.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::filesystem_authority;

public machine rename_names_only(from: &[u8] in Path, to: &[u8] in Path) -> i32
blocks;
reaches FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{ block WindowsFilesystemHost::rename_file(from, to) }

data Main { handle: u64; buffer: [u8; 8]; }
machine Main::main(main: &mut Main)
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    // NUL-free does not imply UTF-8. Establish the input domain statically so
    // the native adapter, not a missing Path proof, must reject these bytes.
    let invalid_path: &[u8] in Path = "\xFF";
    let refused: i32 = block rename_names_only(invalid_path, "omega_rename_destination.txt");
    transition refused == -87 { true -> invalid_destination(main) _ -> bad(82) }
    state invalid_destination(main: &mut Main) {
        let invalid_path: &[u8] in Path = "\xFF";
        let refused: i32 = block rename_names_only("omega_rename_source.txt", invalid_path);
        transition refused == -87 { true -> create(main) _ -> bad(83) }
    }
    state create(main: &mut Main) {
        main.handle = block WindowsFilesystemHost::create_file("omega_rename_source.txt", 1073741824, 7, 2, 128);
        transition main.handle != 0 { true -> source(main) _ -> bad(71) }
    }
    state source(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::write_file(main.handle, "renamed");
        let closed: i32 = block WindowsFilesystemHost::close_handle(main.handle);
        transition count == 7 && closed == 0 { true -> destination(main) _ -> bad(72) }
    }
    state destination(main: &mut Main) {
        main.handle = block WindowsFilesystemHost::create_file("omega_rename_destination.txt", 1073741824, 7, 2, 128);
        transition main.handle != 0 { true -> previous(main) _ -> bad(73) }
    }
    state previous(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::write_file(main.handle, "old");
        let closed: i32 = block WindowsFilesystemHost::close_handle(main.handle);
        transition count == 3 && closed == 0 { true -> rename(main) _ -> bad(74) }
    }
    state rename(main: &mut Main) {
        let result: i32 = block rename_names_only("omega_rename_source.txt", "omega_rename_destination.txt");
        transition result == 0 { true -> missing(main) _ -> bad(75) }
    }
    state missing(main: &mut Main) {
        let result: i32 = block rename_names_only("omega_rename_source.txt", "omega_rename_destination.txt");
        transition result == -2 { true -> old_name(main) _ -> bad(76) }
    }
    state old_name(main: &mut Main) {
        main.handle = block WindowsFilesystemHost::create_file("omega_rename_source.txt", 2147483648, 7, 3, 128);
        transition main.handle == 0 { true -> read(main) _ -> close_unexpected(main) }
    }
    state close_unexpected(main: &mut Main) {
        let closed: i32 = block WindowsFilesystemHost::close_handle(main.handle);
        transition closed == 0 { true -> bad(77) _ -> bad(78) }
    }
    state read(main: &mut Main) {
        main.handle = block WindowsFilesystemHost::create_file("omega_rename_destination.txt", 2147483648, 7, 3, 128);
        transition main.handle != 0 { true -> bytes(main) _ -> bad(79) }
    }
    state bytes(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer, 8);
        let closed: i32 = block WindowsFilesystemHost::close_handle(main.handle);
        transition count == 7 && closed == 0
            && main.buffer[0] == 114 && main.buffer[1] == 101 && main.buffer[2] == 110
            && main.buffer[3] == 97 && main.buffer[4] == 109 && main.buffer[5] == 101 && main.buffer[6] == 100 {
            true -> cleanup(main) _ -> bad(80)
        }
    }
    state cleanup(main: &mut Main) {
        let result: i32 = block WindowsFilesystemHost::delete_file("omega_rename_destination.txt");
        transition result == 0 { true -> bad(70) _ -> bad(81) }
    }
    state bad(code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
