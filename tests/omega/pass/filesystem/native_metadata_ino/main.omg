// NATIVE MetadataExt::ino/uid/gid via stat (Rust os::unix::fs::MetadataExt). Two
// distinct files share an owner (same st_uid/st_gid) but have DIFFERENT inodes;
// a hard link to the first file shares its inode (st_ino equal). Proves st_ino
// (u64 @8), st_uid (u32 @16) and st_gid (u32 @20) decode from the real stat
// record on macOS syscalls, and that inode identity behaves as POSIX specifies.

use omega_language_std::posix_filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    discard: i32;
    mode: i32;
    fd: i32;
    rc: i32;
    ino_a: i64;
    ino_b: i64;
    ino_link: i64;
    uid_a: i32;
    uid_b: i32;
    gid_a: i32;
    gid_b: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(main: &mut Main) reaches PosixFilesystemHost {
    main.mode = 420;
    main.fd = PosixFilesystemHost::create("/tmp/omega_ino_a.txt", main.mode);
    main.n = PosixFilesystemHost::write(main.fd, "aa");
    main.discard = PosixFilesystemHost::close(main.fd);
    main.fd = PosixFilesystemHost::create("/tmp/omega_ino_b.txt", main.mode);
    main.n = PosixFilesystemHost::write(main.fd, "bb");
    main.discard = PosixFilesystemHost::close(main.fd);
    // defensive: clear a stale link from a prior failed run (rc ignored)
    main.discard = PosixFilesystemHost::remove("/tmp/omega_ino_link.txt");
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_ino_a.txt", &mut main.buffer);
    // carrier note: each little-endian field is assembled in the unsigned
    // carrier of its own width and reinterpreted once at the end, so every
    // shifted byte is Exact-representable: 255 << 24 is 4278190080 against
    // a u32 ceiling of 4294967295, and 255 << 56 is 18374686479671623680
    // against a u64 ceiling of 18446744073709551615. Shifting in the signed
    // carriers reaches the same values against ceilings of 2147483647 and
    // 9223372036854775807, a decision-17 obligation no return range can
    // discharge.
    main.ino_a = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(main.buffer[8])
            | (widen_u8_to_u64(main.buffer[9]) << 8)
            | (widen_u8_to_u64(main.buffer[10]) << 16)
            | (widen_u8_to_u64(main.buffer[11]) << 24)
            | (widen_u8_to_u64(main.buffer[12]) << 32)
            | (widen_u8_to_u64(main.buffer[13]) << 40)
            | (widen_u8_to_u64(main.buffer[14]) << 48)
            | (widen_u8_to_u64(main.buffer[15]) << 56));
    main.uid_a = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[16])
            | (widen_u8_to_u32(main.buffer[17]) << 8)
            | (widen_u8_to_u32(main.buffer[18]) << 16)
            | (widen_u8_to_u32(main.buffer[19]) << 24));
    main.gid_a = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[20])
            | (widen_u8_to_u32(main.buffer[21]) << 8)
            | (widen_u8_to_u32(main.buffer[22]) << 16)
            | (widen_u8_to_u32(main.buffer[23]) << 24));
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_ino_b.txt", &mut main.buffer);
    main.ino_b = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(main.buffer[8])
            | (widen_u8_to_u64(main.buffer[9]) << 8)
            | (widen_u8_to_u64(main.buffer[10]) << 16)
            | (widen_u8_to_u64(main.buffer[11]) << 24)
            | (widen_u8_to_u64(main.buffer[12]) << 32)
            | (widen_u8_to_u64(main.buffer[13]) << 40)
            | (widen_u8_to_u64(main.buffer[14]) << 48)
            | (widen_u8_to_u64(main.buffer[15]) << 56));
    main.uid_b = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[16])
            | (widen_u8_to_u32(main.buffer[17]) << 8)
            | (widen_u8_to_u32(main.buffer[18]) << 16)
            | (widen_u8_to_u32(main.buffer[19]) << 24));
    main.gid_b = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[20])
            | (widen_u8_to_u32(main.buffer[21]) << 8)
            | (widen_u8_to_u32(main.buffer[22]) << 16)
            | (widen_u8_to_u32(main.buffer[23]) << 24));
    main.rc = PosixFilesystemHost::hard_link("/tmp/omega_ino_a.txt", "/tmp/omega_ino_link.txt");
    transition main.rc == 0 { true -> statlink(main) _ -> fail(main) }
    state statlink(main: &mut Main) {
        main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_ino_link.txt", &mut main.buffer);
        main.ino_link = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(main.buffer[8])
                | (widen_u8_to_u64(main.buffer[9]) << 8)
                | (widen_u8_to_u64(main.buffer[10]) << 16)
                | (widen_u8_to_u64(main.buffer[11]) << 24)
                | (widen_u8_to_u64(main.buffer[12]) << 32)
                | (widen_u8_to_u64(main.buffer[13]) << 40)
                | (widen_u8_to_u64(main.buffer[14]) << 48)
                | (widen_u8_to_u64(main.buffer[15]) << 56));
        main.discard = PosixFilesystemHost::remove("/tmp/omega_ino_link.txt");
        main.discard = PosixFilesystemHost::remove("/tmp/omega_ino_a.txt");
        main.discard = PosixFilesystemHost::remove("/tmp/omega_ino_b.txt");
        transition main.uid_a == main.uid_b { true -> checkgid(main) _ -> fail(main) }
    }
    state checkgid(main: &mut Main) {
        transition main.gid_a == main.gid_b { true -> checkinodiff(main) _ -> fail(main) }
    }
    state checkinodiff(main: &mut Main) {
        // two distinct files have distinct inodes
        transition main.ino_a == main.ino_b { true -> fail(main) _ -> checkinoeq(main) }
    }
    state checkinoeq(main: &mut Main) {
        // a hard link shares the original's inode
        transition main.ino_a == main.ino_link { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "PASS: uid/gid consistent; distinct files distinct ino; hard link shares ino\n"); }
    state fail(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "FAIL: ino/uid/gid\n"); }
}
