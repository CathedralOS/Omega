// NATIVE MetadataExt::ino/uid/gid via stat (Rust os::unix::fs::MetadataExt). Two
// distinct files share an owner (same st_uid/st_gid) but have DIFFERENT inodes;
// a hard link to the first file shares its inode (st_ino equal). Proves st_ino
// (u64 @8), st_uid (u32 @16) and st_gid (u32 @20) decode from the real stat
// record on macOS syscalls, and that inode identity behaves as POSIX specifies.

use omega_language_std::filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    fs: FilesystemHost;
    mode: i32;
    fd: i32;
    rc: i32;
    ino_a: i64;
    ino_b: i64;
    ino_link: i64;
    uid_a: i32;
    uid_b: i32;
    gid_a: i32;
    gid_b: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(&mut self) reaches FilesystemHost {
    self.mode = 420;
    self.fd = self.fs.create("/tmp/omega_ino_a.txt", self.mode);
    self.n = self.fs.write(self.fd, "aa");
    self.n = self.fs.close(self.fd);
    self.fd = self.fs.create("/tmp/omega_ino_b.txt", self.mode);
    self.n = self.fs.write(self.fd, "bb");
    self.n = self.fs.close(self.fd);
    // defensive: clear a stale link from a prior failed run (rc ignored)
    self.n = self.fs.remove("/tmp/omega_ino_link.txt");
    self.rc = self.fs.read_metadata("/tmp/omega_ino_a.txt", &mut self.buffer);
    // carrier note: each little-endian field is assembled in the unsigned
    // carrier of its own width and reinterpreted once at the end, so every
    // shifted byte is Exact-representable: 255 << 24 is 4278190080 against
    // a u32 ceiling of 4294967295, and 255 << 56 is 18374686479671623680
    // against a u64 ceiling of 18446744073709551615. Shifting in the signed
    // carriers reaches the same values against ceilings of 2147483647 and
    // 9223372036854775807, a decision-17 obligation no return range can
    // discharge.
    self.ino_a = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(self.buffer[8])
            | (widen_u8_to_u64(self.buffer[9]) << 8)
            | (widen_u8_to_u64(self.buffer[10]) << 16)
            | (widen_u8_to_u64(self.buffer[11]) << 24)
            | (widen_u8_to_u64(self.buffer[12]) << 32)
            | (widen_u8_to_u64(self.buffer[13]) << 40)
            | (widen_u8_to_u64(self.buffer[14]) << 48)
            | (widen_u8_to_u64(self.buffer[15]) << 56));
    self.uid_a = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(self.buffer[16])
            | (widen_u8_to_u32(self.buffer[17]) << 8)
            | (widen_u8_to_u32(self.buffer[18]) << 16)
            | (widen_u8_to_u32(self.buffer[19]) << 24));
    self.gid_a = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(self.buffer[20])
            | (widen_u8_to_u32(self.buffer[21]) << 8)
            | (widen_u8_to_u32(self.buffer[22]) << 16)
            | (widen_u8_to_u32(self.buffer[23]) << 24));
    self.rc = self.fs.read_metadata("/tmp/omega_ino_b.txt", &mut self.buffer);
    self.ino_b = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(self.buffer[8])
            | (widen_u8_to_u64(self.buffer[9]) << 8)
            | (widen_u8_to_u64(self.buffer[10]) << 16)
            | (widen_u8_to_u64(self.buffer[11]) << 24)
            | (widen_u8_to_u64(self.buffer[12]) << 32)
            | (widen_u8_to_u64(self.buffer[13]) << 40)
            | (widen_u8_to_u64(self.buffer[14]) << 48)
            | (widen_u8_to_u64(self.buffer[15]) << 56));
    self.uid_b = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(self.buffer[16])
            | (widen_u8_to_u32(self.buffer[17]) << 8)
            | (widen_u8_to_u32(self.buffer[18]) << 16)
            | (widen_u8_to_u32(self.buffer[19]) << 24));
    self.gid_b = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(self.buffer[20])
            | (widen_u8_to_u32(self.buffer[21]) << 8)
            | (widen_u8_to_u32(self.buffer[22]) << 16)
            | (widen_u8_to_u32(self.buffer[23]) << 24));
    self.rc = self.fs.hard_link("/tmp/omega_ino_a.txt", "/tmp/omega_ino_link.txt");
    transition self.rc == 0 { true -> statlink() _ -> fail() }
    state statlink(&mut self) {
        self.rc = self.fs.read_metadata("/tmp/omega_ino_link.txt", &mut self.buffer);
        self.ino_link = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(self.buffer[8])
                | (widen_u8_to_u64(self.buffer[9]) << 8)
                | (widen_u8_to_u64(self.buffer[10]) << 16)
                | (widen_u8_to_u64(self.buffer[11]) << 24)
                | (widen_u8_to_u64(self.buffer[12]) << 32)
                | (widen_u8_to_u64(self.buffer[13]) << 40)
                | (widen_u8_to_u64(self.buffer[14]) << 48)
                | (widen_u8_to_u64(self.buffer[15]) << 56));
        self.n = self.fs.remove("/tmp/omega_ino_link.txt");
        self.n = self.fs.remove("/tmp/omega_ino_a.txt");
        self.n = self.fs.remove("/tmp/omega_ino_b.txt");
        transition self.uid_a == self.uid_b { true -> checkgid() _ -> fail() }
    }
    state checkgid(&mut self) {
        transition self.gid_a == self.gid_b { true -> checkinodiff() _ -> fail() }
    }
    state checkinodiff(&mut self) {
        // two distinct files have distinct inodes
        transition self.ino_a == self.ino_b { true -> fail() _ -> checkinoeq() }
    }
    state checkinoeq(&mut self) {
        // a hard link shares the original's inode
        transition self.ino_a == self.ino_link { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: uid/gid consistent; distinct files distinct ino; hard link shares ino\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: ino/uid/gid\n"); }
}
