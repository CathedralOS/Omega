// RUN CANARY (exit 70, Windows): real HANDLE-based raw filesystem operations.
// Create/write/flush/reopen/seek/read, shared-cursor duplication, writable
// attributes, non-replacing rename, missing old name, mkdir/delete/rmdir.
// Failure exits 71..87 retain the original matrix's independent checks.
use omega_language_std::windows_filesystem_host;

use omega_language_std::console;

data Main {
    buffer: [u8; 8];
    handle: u64;
    duplicate: u64;
    n: i64;
    pos: i64;
    rc: i32;
}

machine Main::main(main: &mut Main) reaches Console + WindowsFilesystemHost {
    main.handle = WindowsFilesystemHost::create_file("omega_fswin_breadth_a.txt", 1073741824, 7, 2, 128);
    transition main.handle != 0 { true -> write_it(main) _ -> bad(main, 71) }

    state write_it(main: &mut Main) {
        main.n = WindowsFilesystemHost::write_file(main.handle, "abcdef");
        transition main.n == 6 { true -> sync_it(main) _ -> bad(main, 72) }
    }

    state sync_it(main: &mut Main) {
        main.rc = WindowsFilesystemHost::flush_file_buffers(main.handle);
        transition main.rc == 0 { true -> close_it(main) _ -> bad(main, 73) }
    }

    state close_it(main: &mut Main) {
        main.rc = WindowsFilesystemHost::close_handle(main.handle);
        transition main.rc == 0 { true -> reopen(main) _ -> bad(main, 74) }
    }

    state reopen(main: &mut Main) {
        // OPEN_EXISTING with GENERIC_READ; HANDLEs need no CRT descriptor bridge.
        main.handle = WindowsFilesystemHost::create_file("omega_fswin_breadth_a.txt", 2147483648, 7, 3, 128);
        transition main.handle != 0 { true -> seek_it(main) _ -> bad(main, 75) }
    }

    state seek_it(main: &mut Main) {
        // SEEK_SET=0: land on byte 2 ('c').
        main.pos = WindowsFilesystemHost::set_file_pointer(main.handle, 2, 0);
        transition main.pos == 2 { true -> read_it(main) _ -> bad(main, 76) }
    }

    state read_it(main: &mut Main) {
        main.n = WindowsFilesystemHost::read_file(main.handle, &mut main.buffer, 2);
        transition main.n == 2 { true -> check_c(main) _ -> bad(main, 77) }
    }

    state check_c(main: &mut Main) {
        transition main.buffer[0] == 99 { true -> check_d(main) _ -> bad(main, 78) }
    }

    state check_d(main: &mut Main) {
        transition main.buffer[1] == 100 { true -> dup_it(main) _ -> bad(main, 78) }
    }

    state dup_it(main: &mut Main) {
        main.duplicate = WindowsFilesystemHost::duplicate_handle(main.handle);
        main.rc = WindowsFilesystemHost::close_handle(main.handle);
        transition main.duplicate != 0 { true -> read_dup(main) _ -> bad(main, 79) }
    }

    state read_dup(main: &mut Main) {
        // The dup shares (or copied) the file position: next byte is 'e'.
        main.n = WindowsFilesystemHost::read_file(main.duplicate, &mut main.buffer, 1);
        transition main.buffer[0] == 101 { true -> close_dup(main) _ -> bad(main, 80) }
    }

    state close_dup(main: &mut Main) {
        main.rc = WindowsFilesystemHost::close_handle(main.duplicate);
        transition main.rc == 0 { true -> chmod_it(main) _ -> bad(main, 81) }
    }

    state chmod_it(main: &mut Main) {
        // FILE_ATTRIBUTE_NORMAL clears the readonly attribute, as the old chmod leg did.
        main.rc = WindowsFilesystemHost::set_file_attributes("omega_fswin_breadth_a.txt", 128);
        transition main.rc == 0 { true -> pre_clean_dest(main) _ -> bad(main, 82) }
    }

    state pre_clean_dest(main: &mut Main) {
        // MoveFileExW with flags 0 does not replace an existing destination.
        // Clear a leftover from a crashed prior run; failure is harmless here.
        main.rc = WindowsFilesystemHost::delete_file("omega_fswin_breadth_b.txt");
        transition true { _ -> rename_it(main) }
    }

    state rename_it(main: &mut Main) {
        main.rc = WindowsFilesystemHost::move_file("omega_fswin_breadth_a.txt", "omega_fswin_breadth_b.txt", 0);
        transition main.rc == 0 { true -> probe_old(main) _ -> bad(main, 83) }
    }

    state probe_old(main: &mut Main) {
        main.handle = WindowsFilesystemHost::create_file("omega_fswin_breadth_a.txt", 2147483648, 7, 3, 128);
        transition main.handle == 0 { true -> mkdir_it(main) _ -> bad(main, 84) }
    }

    state mkdir_it(main: &mut Main) {
        main.rc = WindowsFilesystemHost::create_directory("omega_fswin_breadth_dir");
        transition main.rc == 0 { true -> clean_file(main) _ -> bad(main, 85) }
    }

    state clean_file(main: &mut Main) {
        main.rc = WindowsFilesystemHost::delete_file("omega_fswin_breadth_b.txt");
        transition main.rc == 0 { true -> clean_dir(main) _ -> bad(main, 86) }
    }

    state clean_dir(main: &mut Main) {
        main.rc = WindowsFilesystemHost::remove_directory("omega_fswin_breadth_dir");
        transition main.rc == 0 { true -> good(main) _ -> bad(main, 87) }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
