        main.bytes[5] = 75;
        main.bytes[6] = 76;
        main.bytes[7] = 77;
        let count: i64 = PosixFilesystemHost::read_link("native-transfer-records/link", &mut main.bytes[1..7], 2);
        transition count == 2 && main.bytes[0] == 91 && main.bytes[1] == 97 && main.bytes[2] == 98
            && main.bytes[3] == 73 && main.bytes[4] == 74 && main.bytes[5] == 75
            && main.bytes[6] == 76 && main.bytes[7] == 77 {
            true -> zero_link(main) _ -> finish(main, 20)
        }
    }
    state zero_link(main: &mut Main) {
        let count: i64 = PosixFilesystemHost::read_link("native-transfer-records/missing", &mut main.bytes[1..7], 0);
        transition count < 0 && main.bytes[0] == 91 && main.bytes[1] == 97 && main.bytes[2] == 98
