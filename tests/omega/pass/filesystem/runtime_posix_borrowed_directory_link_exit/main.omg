// Expected exit: 0. Raw directory and link reads use bounded caller windows.
// Offset-one views challenge native alignment; an oversized count cannot touch
// canaries. Darwin's private four-byte directory suffix stays caller-owned on
// success and failure. Empty requests still report real native errors.
use omega_language_std::posix_filesystem_host;
use omega_language_std::console;

data Main { bytes: [u8; 1026]; descriptor: i32; position: i64; }
machine Main::main(main: &mut Main)
reaches Console + DirectoryEnumeration + FilesystemMetadataQuery + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    main.descriptor = -1;
    let created: i32 = PosixFilesystemHost::create_dir("native-transfer-records", 448);
