        main.position = 0;
        transition closed == 0 && main.descriptor >= 0 { true -> directory(main) _ -> finish(main, 24) }
    }
    state directory(main: &mut Main) {
        main.bytes[1021] = 81;
        main.bytes[1022] = 82;
        main.bytes[1023] = 83;
        main.bytes[1024] = 84;
        main.bytes[1025] = 92;
        let count: i64 = PosixFilesystemHost::read_dir(main.descriptor, &mut main.bytes[1..1025], 18446744073709551615, &mut main.position);
