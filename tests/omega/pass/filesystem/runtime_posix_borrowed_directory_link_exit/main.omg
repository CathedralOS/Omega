}

machine suffix_intact(main: &Main) -> bool {
    main.bytes[0] == 91 && main.bytes[1021] == 81 && main.bytes[1022] == 82
        && main.bytes[1023] == 83 && main.bytes[1024] == 84 && main.bytes[1025] == 92
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + DirectoryEnumeration + FilesystemMetadataQuery + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
