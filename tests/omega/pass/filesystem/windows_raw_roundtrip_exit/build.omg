// Windows raw-filesystem roundtrip proof: select the exact Windows entry.
target windows_x86_64 { }

machine build(builder: &mut Build) {
    builder.application("windows-raw-roundtrip-exit");
    builder.depend(Source::Path {
        location: "../../../../../source/library/std"
    });
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
}
