// RUN CANARY (exit 70) -- the dir-walk WRAPPER family natively, END TO END:
// create_dir_all (deep, via the dispatched mkall walkers) -> exists -> two
// write_alls -> read_dir_count == 2 -> read_dir_is_empty NonEmpty ->
// remove_dir_all (the iterative dirfd-stack drain) -> exists false.
// PROMOTED from pending 2026-07-09k after a multi-iteration arc closed, in
// order: the sound fence exemption for dispatch-routed calls; enum-case
// terminal return-writes; the router's Nested loop-blindness; rda's
// call-recursion (iterative drain); the dual-indexed field-carrier split;
// the dirfd REWIND (getdirentries cursors are fd offsets); and the
// entry_name NUL TERMINATION (a REUSED buffer left the previous longer
// name's tail -- "b" over "f1.txt" read back "b1.txt" -> ENOENT at the
// drain's parent-remove; the interp slices by length, so only native
// diverged). macOS-gated (read_dir has no msvcrt row); the interpreter's
// virtual fs is the oracle.
use omega::language::std::filesystem;
use omega::language::std::filesystem_host;
use omega::language::std::console;
data Main {
    console: Console;
    fs: Filesystem;
    unit_result: UnitResult;
    io_result: IoResult;
    empty_result: EmptyResult;
    present: bool;
}
machine Main::main(&mut self) {
    _ = self.fs.create_dir_all("omega_walk_a/b/c");
    transition true { true -> ck_created() _ -> bad(99) }
    state ck_created(&mut self) {
        self.present = self.fs.exists("omega_walk_a/b/c");
        transition self.present { true -> seed() _ -> bad(71) }
    }
    state seed(&mut self) {
        self.unit_result = self.fs.write_all("omega_walk_a/b/c/f1.txt", "x");
        transition self.unit_result { UnitResult::Ok -> seed2() _ -> bad(72) }
    }
    state seed2(&mut self) {
        self.unit_result = self.fs.write_all("omega_walk_a/b/c/f2.txt", "y");
        transition self.unit_result { UnitResult::Ok -> count() _ -> bad(72) }
    }
    state count(&mut self) {
        self.io_result = self.fs.read_dir_count("omega_walk_a/b/c");
        transition self.io_result { IoResult::Ok { count } -> ckcount(count) _ -> bad(73) }
    }
    state ckcount(&mut self, count: u64) {
        transition count == 2 { true -> ckempty() _ -> bad(73) }
    }
    state ckempty(&mut self) {
        self.empty_result = self.fs.read_dir_is_empty("omega_walk_a/b/c");
        transition self.empty_result { EmptyResult::NonEmpty -> teardown() _ -> bad(74) }
    }
    state teardown(&mut self) {
        _ = self.fs.remove_dir_all("omega_walk_a");
        transition true { true -> ck_gone() _ -> bad(99) }
    }
    state ck_gone(&mut self) {
        self.present = self.fs.exists("omega_walk_a");
        transition self.present { true -> bad(75) _ -> good() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
