// RUN CANARY (exit 70) -- the dir-walk WRAPPER family natively, END TO END:
// create_dir_all (deep, via the dispatched mkall walkers) -> exists -> two
// write_alls -> read_dir_count == 2 -> read_dir_is_empty NonEmpty ->
// remove_dir_all (the iterative dirfd-stack drain) -> exists false.
// PROMOTED from pending 2026-07-09k after a multi-iteration arc closed, in
// order: the sound fence exemption for dispatch-routed calls; enum-case
// terminal return-writes; the router's Nested loop-blindness; rda's
// call-recursion (iterative drain); the dual-indexed field-carrier split;
// the dirfd REWIND (getdirentries cursors are fd offsets); and the
// entry_name NUL TERMINATION (a REUSED buffer left the previous longer
// name's tail -- "b" over "f1.txt" read back "b1.txt" -> ENOENT at the
// drain's parent-remove; the interp slices by length, so only native
// diverged). macOS-gated (read_dir has no msvcrt row); the interpreter's
// virtual fs is the oracle.
use omega_language_std::filesystem;
use omega_language_std::filesystem_host;
use omega_language_std::console;
data Main {
    fs: Filesystem;
    unit_result: UnitResult;
    io_result: IoResult;
    empty_result: EmptyResult;
    present: bool;
}
machine Main::main(main: &mut Main) reaches Console {
    _ = Filesystem::create_dir_all(&mut main.fs, "omega_walk_a/b/c");
    transition true { true -> ck_created(main) _ -> bad(main, 99) }
    state ck_created(main: &mut Main) {
        main.present = Filesystem::exists(&mut main.fs, "omega_walk_a/b/c");
        transition main.present { true -> seed(main) _ -> bad(main, 71) }
    }
    state seed(main: &mut Main) {
        main.unit_result = Filesystem::write_all(&mut main.fs, "omega_walk_a/b/c/f1.txt", "x");
        transition main.unit_result { UnitResult::Ok -> seed2(main) _ -> bad(main, 72) }
    }
    state seed2(main: &mut Main) {
        main.unit_result = Filesystem::write_all(&mut main.fs, "omega_walk_a/b/c/f2.txt", "y");
        transition main.unit_result { UnitResult::Ok -> count(main) _ -> bad(main, 72) }
    }
    state count(main: &mut Main) {
        main.io_result = Filesystem::read_dir_count(&mut main.fs, "omega_walk_a/b/c");
        transition main.io_result { IoResult::Ok { count } -> ckcount(main, count) _ -> bad(main, 73) }
    }
    state ckcount(main: &mut Main, count: u64) {
        transition count == 2 { true -> ckempty(main) _ -> bad(main, 73) }
    }
    state ckempty(main: &mut Main) {
        main.empty_result = Filesystem::read_dir_is_empty(&mut main.fs, "omega_walk_a/b/c");
        transition main.empty_result { EmptyResult::NonEmpty -> teardown(main) _ -> bad(main, 74) }
    }
    state teardown(main: &mut Main) {
        _ = Filesystem::remove_dir_all(&mut main.fs, "omega_walk_a");
        transition true { true -> ck_gone(main) _ -> bad(main, 99) }
    }
    state ck_gone(main: &mut Main) {
        main.present = Filesystem::exists(&mut main.fs, "omega_walk_a");
        transition main.present { true -> bad(main, 75) _ -> good(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
