// Expected exit: 70. Create nested directories, count two files, then remove
// the tree and verify it is gone.
use omega_language_std::IoResult;
use omega_language_std::EmptyResult;
use omega_language_std::UnitResult;
use omega_language_std::Filesystem;
use omega_language_std::Filesystem::write_all;
use omega_language_std::Filesystem::exists;
use omega_language_std::Filesystem::create_dir_all;
use omega_language_std::Filesystem::read_dir_is_empty;
use omega_language_std::Filesystem::read_dir_count;
use omega_language_std::Filesystem::remove_dir_all;
use omega_language_std::Console;
data Main {
    fs: Filesystem;
    unit_result: UnitResult;
    io_result: IoResult;
    empty_result: EmptyResult;
    present: bool;
}
machine Main::main(main: &mut Main) reaches Console + DirectoryEnumeration + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    _ = block Filesystem::create_dir_all(&mut main.fs, "omega_walk_a/b/c");
    transition true { true -> block ck_created(main) _ -> bad(main, 99) }
    machine ck_created(main: &mut Main) {
        main.present = block Filesystem::exists(&mut main.fs, "omega_walk_a/b/c");
        transition main.present { true -> block seed(main) _ -> bad(main, 71) }
    }
    machine seed(main: &mut Main) {
        main.unit_result = block Filesystem::write_all(&mut main.fs, "omega_walk_a/b/c/f1.txt", "x");
        transition main.unit_result { UnitResult::Ok -> block seed2(main) _ -> bad(main, 72) }
    }
    machine seed2(main: &mut Main) {
        main.unit_result = block Filesystem::write_all(&mut main.fs, "omega_walk_a/b/c/f2.txt", "y");
        transition main.unit_result { UnitResult::Ok -> block count(main) _ -> bad(main, 72) }
    }
    machine count(main: &mut Main) {
        main.io_result = block Filesystem::read_dir_count(&mut main.fs, "omega_walk_a/b/c");
        transition main.io_result { IoResult::Ok { count } -> block ckcount(main, count) _ -> bad(main, 73) }
    }
    machine ckcount(main: &mut Main, count: u64) {
        transition count == 2 { true -> block ckempty(main) _ -> bad(main, 73) }
    }
    machine ckempty(main: &mut Main) {
        main.empty_result = block Filesystem::read_dir_is_empty(&mut main.fs, "omega_walk_a/b/c");
        transition main.empty_result { EmptyResult::NonEmpty -> block teardown(main) _ -> bad(main, 74) }
    }
    machine teardown(main: &mut Main) {
        _ = block Filesystem::remove_dir_all(&mut main.fs, "omega_walk_a");
        transition true { true -> block ck_gone(main) _ -> bad(main, 99) }
    }
    machine ck_gone(main: &mut Main) {
        main.present = block Filesystem::exists(&mut main.fs, "omega_walk_a");
        transition main.present { true -> bad(main, 75) _ -> good(main) }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + DirectoryEnumeration + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
