// Expected exit: 70 (Windows only). Truncation preserves the shared cursor;
// handle/path read-only updates preserve unrelated observed attributes.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::filesystem_authority;

data Main {}

machine Main::main(main: &mut Main)
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let code: i32 = block file_control_probe();
    Console::exit_process(code);
}

machine file_control_probe() -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let reset: i32 = block WindowsFilesystemHost::set_path_readonly("omega_raw_file_control.bin", false);
    let removed: i32 = block WindowsFilesystemHost::delete_file("omega_raw_file_control.bin");
    let handle: u64 = block WindowsFilesystemHost::create_file("omega_raw_file_control.bin", 3221225472, 7, 2, 128);
    transition handle != 0 { true -> write(handle) false -> 71 }
    state write(handle: u64) -> i32 {
        let count: i64 = block WindowsFilesystemHost::write_file(handle, "01234567890123456789");
        transition count == 20 { true -> seek(handle) false -> finish(handle, 72) }
    }
    state seek(handle: u64) -> i32 {
        let position: i64 = block WindowsFilesystemHost::set_file_pointer(handle, 5, 0);
        transition position == 5 { true -> truncate(handle) false -> finish(handle, 73) }
    }
    state truncate(handle: u64) -> i32 {
        let status: i32 = block WindowsFilesystemHost::set_file_length(handle, 3);
        transition status == 0 { true -> cursor(handle) false -> finish(handle, 74) }
    }
    state cursor(handle: u64) -> i32 {
        let position: i64 = block WindowsFilesystemHost::set_file_pointer(handle, 0, 1);
        transition position == 5 { true -> query(handle) false -> finish(handle, 75) }
    }
    state query(handle: u64) -> i32 {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(handle);
        transition outcome {
            WindowsMetadataResult::Value { metadata } -> length(handle, metadata)
            _ -> finish(handle, 76)
        }
    }
    state length(handle: u64, metadata: WindowsFileMetadata) -> i32 {
        transition metadata.length == 3 { true -> readonly(handle, metadata.attributes) false -> finish(handle, 76) }
    }
    state readonly(handle: u64, attributes: u32) -> i32 {
        let status: i32 = block WindowsFilesystemHost::set_handle_readonly(handle, true);
        transition status == 0 { true -> read_attributes(handle, attributes) false -> finish(handle, 77) }
    }
    state read_attributes(handle: u64, attributes: u32) -> i32 {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(handle);
        transition outcome {
            WindowsMetadataResult::Value { metadata } -> changed(handle, attributes, metadata.attributes)
            _ -> finish(handle, 78)
        }
    }
    state changed(handle: u64, before: u32, after: u32) -> i32 {
        // NORMAL is the absence of other attributes, not an independent bit.
        transition (after & 1) != 0 && (before & 4294967166) == (after & 4294967166) {
            true -> writable(handle, before)
            false -> finish(handle, 78)
        }
    }
    state writable(handle: u64, attributes: u32) -> i32 {
        let status: i32 = block WindowsFilesystemHost::set_path_readonly("omega_raw_file_control.bin", false);
        transition status == 0 { true -> verify(handle, attributes) false -> finish(handle, 79) }
    }
    state verify(handle: u64, attributes: u32) -> i32 {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(handle);
        transition outcome {
            WindowsMetadataResult::Value { metadata } -> restored(handle, attributes, metadata.attributes)
            _ -> finish(handle, 80)
        }
    }
    state restored(handle: u64, before: u32, after: u32) -> i32 {
        transition (after & 1) == 0 && (before & 4294967166) == (after & 4294967166) {
            true -> finish(handle, 70)
            false -> finish(handle, 80)
        }
    }
    state finish(handle: u64, code: i32) -> i32 {
        let released: i32 = block WindowsFilesystemHost::close_handle(handle);
        let reset: i32 = block WindowsFilesystemHost::set_path_readonly("omega_raw_file_control.bin", false);
        let removed: i32 = block WindowsFilesystemHost::delete_file("omega_raw_file_control.bin");
        transition code != 70 { true -> (code) false -> cleanup(released, reset, removed) }
    }
    state cleanup(released: i32, reset: i32, removed: i32) -> i32 {
        transition released == 0 && reset == 0 && removed == 0 { true -> 70 false -> 81 }
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
