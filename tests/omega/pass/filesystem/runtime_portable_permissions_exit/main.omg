// Expected exit: 0
// A portable read-only request preserves non-write POSIX bits, using either a
// path or an open file. Exact modes and the zero/default request stay distinct.
use omega_language_std::filesystem;
use omega_language_std::console;

data Main { filesystem: Filesystem; file: File; }

machine Main::main(main: &mut Main) reaches Console {
    let result: OpenResult = block Filesystem::create_new(&mut main.filesystem, "omega_permission_modes.txt");
    transition result { OpenResult::Ok { file } -> opened(main, file) _ -> bad(10) }
    machine opened(main: &mut Main, file: File) {
        main.file = file;
        // 0o1750: sticky plus executable owner/group bits, not merely rw data.
        let result: UnitResult = block Filesystem::set_file_permissions(&mut main.filesystem, file, Permissions::Posix { mode: 1000 });
        transition result { UnitResult::Ok -> readonly(main) _ -> bad(11) }
    }
    machine readonly(main: &mut Main) {
        let result: UnitResult = block Filesystem::set_permissions(&mut main.filesystem, "omega_permission_modes.txt", Permissions::Readonly { value: true });
        transition result { UnitResult::Ok -> inspect_readonly(main) _ -> bad(12) }
    }
    machine inspect_readonly(main: &mut Main) {
        let result: MetadataResult = block Filesystem::metadata(&mut main.filesystem, main.file);
        transition result { MetadataResult::Ok { meta } -> readonly_mode(main, meta.posix) _ -> bad(13) }
    }
    machine readonly_mode(main: &mut Main, result: PosixMetadataResult) {
        transition result { PosixMetadataResult::Ok { details } -> preserved(main, details.mode) _ -> bad(14) }
    }
    machine preserved(main: &mut Main, mode: u32) {
        transition (mode & 4095) == 872 { true -> writable(main) false -> bad(15) }
    }
    machine writable(main: &mut Main) {
        let result: UnitResult = block Filesystem::set_file_permissions(&mut main.filesystem, main.file, Permissions::Readonly { value: false });
        transition result { UnitResult::Ok -> inspect_writable(main) _ -> bad(16) }
    }
    machine inspect_writable(main: &mut Main) {
        let result: MetadataResult = block Filesystem::metadata_path(&mut main.filesystem, "omega_permission_modes.txt");
        transition result { MetadataResult::Ok { meta } -> writable_mode(main, meta.posix) _ -> bad(17) }
    }
    machine writable_mode(main: &mut Main, result: PosixMetadataResult) {
        transition result { PosixMetadataResult::Ok { details } -> enabled(main, details.mode) _ -> bad(18) }
    }
    machine enabled(main: &mut Main, mode: u32) {
        transition (mode & 4095) == 1018 { true -> defaults(main) false -> bad(19) }
    }
    machine defaults(main: &mut Main) {
        let permissions: Permissions;
        let result: UnitResult = block Filesystem::set_file_permissions(&mut main.filesystem, main.file, permissions);
        transition result { UnitResult::Ok -> inspect_default(main) _ -> bad(20) }
    }
    machine inspect_default(main: &mut Main) {
        let result: MetadataResult = block Filesystem::metadata(&mut main.filesystem, main.file);
        transition result { MetadataResult::Ok { meta } -> default_mode(main, meta.posix) _ -> bad(21) }
    }
    machine default_mode(main: &mut Main, result: PosixMetadataResult) {
        transition result { PosixMetadataResult::Ok { details } -> defaulted(main, details.mode) _ -> bad(22) }
    }
    machine defaulted(main: &mut Main, mode: u32) {
        transition (mode & 4095) == 438 { true -> close(main) false -> bad(23) }
    }
    machine close(main: &mut Main) {
        let result: UnitResult = block Filesystem::close(&mut main.filesystem, main.file);
        transition result { UnitResult::Ok -> remove(main) _ -> bad(24) }
    }
    machine remove(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "omega_permission_modes.txt");
        transition result { UnitResult::Ok -> missing(main) _ -> bad(25) }
    }
    machine missing(main: &mut Main) {
        let result: UnitResult = block Filesystem::set_permissions(&mut main.filesystem, "omega_permission_modes.txt", Permissions::Readonly { value: true });
        transition result { UnitResult::Error { kind } -> missing_kind(main, kind) _ -> bad(26) }
    }
    machine missing_kind(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> absent(main) _ -> bad(27) }
    }
    machine absent(main: &mut Main) {
        let file: File;
        let result: UnitResult = block Filesystem::set_file_permissions(&mut main.filesystem, file, Permissions::Readonly { value: true });
        transition result { UnitResult::Error { kind } -> absent_kind(kind) _ -> bad(28) }
    }
    machine absent_kind(kind: ErrorKind) {
        transition kind { ErrorKind::BadDescriptor -> good() _ -> bad(29) }
    }
    machine good() { Console::exit_process(0); }
    machine bad(code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
