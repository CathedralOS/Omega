// NATIVE file-type classification (Rust FileType / os::unix::fs::FileTypeExt) via
// stat's st_mode format bits, on real macOS. Decodes st_mode (offset 4, u16) and
// masks the format field (mode & S_IFMT, S_IFMT = 0o170000 = 61440). `/dev/null`
// is a CHARACTER-special device (S_IFCHR = 0o020000 = 8192) present on every
// system; a freshly-created regular file is S_IFREG (0o100000 = 32768). Proves
// is_char_device()/is_file() decode real device nodes, not just regular files.

use omega_language_std::filesystem_host;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

data Main {
    fs: Binding<FilesystemHost>;
    mode: i32;
    fd: i32;
    rc: i32;
    fmt: i32;
    discard: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(main: &mut Main) reaches FilesystemHost {
    main.mode = 420;
    // 1: /dev/null must stat as a character device
    main.rc = main.fs.read_metadata("/dev/null", &mut main.buffer);
    transition main.rc == 0 { true -> checkchar(main) _ -> fail(main) }
    state checkchar(main: &mut Main) {
        main.fmt =
            (widen_u8_to_i32(main.buffer[4]) | (widen_u8_to_i32(main.buffer[5]) << 8))
                & 61440;
        transition main.fmt == 8192 { true -> regular(main) _ -> fail(main) }
    }
    state regular(main: &mut Main) {
        // 2: a fresh regular file must stat as S_IFREG (not a device)
        main.fd = main.fs.create("/tmp/omega_ftype.txt", main.mode);
        main.n = main.fs.write(main.fd, "hi");
        main.discard = main.fs.close(main.fd);
        main.rc = main.fs.read_metadata("/tmp/omega_ftype.txt", &mut main.buffer);
        main.discard = main.fs.remove("/tmp/omega_ftype.txt");
        transition main.rc == 0 { true -> checkreg(main) _ -> fail(main) }
    }
    state checkreg(main: &mut Main) {
        main.fmt =
            (widen_u8_to_i32(main.buffer[4]) | (widen_u8_to_i32(main.buffer[5]) << 8))
                & 61440;
        transition main.fmt == 32768 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = main.fs.write(1, "PASS: /dev/null is S_IFCHR (char device); regular file is S_IFREG\n"); }
    state fail(main: &mut Main) { main.n = main.fs.write(1, "FAIL: native filetype\n"); }
}
