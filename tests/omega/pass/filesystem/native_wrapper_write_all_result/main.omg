// The ergonomic wrapper's PAYLOAD-CARRYING result enum, natively — the shape the
// value-call deep fix unblocked. `Filesystem::write_all(path, bytes) -> UnitResult`
// returns `UnitResult::Ok` or `UnitResult::Error { kind }` via an internal
// `transition n >= 0 { .. }` to leaf states, and the RESULT (not just the side
// effect) is assigned to a field and case-matched in transition position —
// value-position match dispatches on scalar patterns only. A write to an
// unwritable path (a nonexistent parent directory) must be Error; a write to
// /tmp must be Ok.
//
// Before the fix this always reported Ok (the guard read the write count's ZII
// zero and/or the field-mutation re-materialized the first leaf terminal). PASS
// iff the bad path is Error AND the good path is Ok.

use omega_language_std::console;
use omega_language_std::filesystem;
use omega_language_std::filesystem_host;
use omega::language::core::service;

data Main {
    console: Binding<Console>;
    fs: Filesystem;
    res: UnitResult;
}

machine Main::main(&mut self) reaches FilesystemHost + Console {
    // Bad path: the parent directory does not exist -> create fails -> Error.
    self.res = self.fs.write_all("/no_such_dir_xyz_999/f.txt", "hi");
    transition self.res { UnitResult::Ok -> bad_err() _ -> after_err() }

    state after_err(&mut self) {
        // Good path: write succeeds -> Ok.
        self.res = self.fs.write_all("/tmp/omega_wa_result.txt", "hello");
        transition self.res { UnitResult::Ok -> good() _ -> bad_ok() }
    }
    state good(&mut self)    { self.console.write_line("PASS: write_all result Error-then-Ok correct"); }
    state bad_err(&mut self) { self.console.write_line("FAIL: write_all to a bad path was not Error"); }
    state bad_ok(&mut self)  { self.console.write_line("FAIL: write_all to a good path was not Ok"); }
}
