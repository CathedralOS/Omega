    }
    machine ck6(main: &mut Main, kind: ErrorKind) {
        transition kind {
            ErrorKind::NotFound -> block cleanup(main)
            _ -> bad(main, 78)
        }
    }
    machine cleanup(main: &mut Main) {
        main.unit_result = block Filesystem::remove(&mut main.fs, "omega_ow_probe.txt");
        transition main.unit_result { UnitResult::Ok -> good(main) _ -> bad(main, 79) }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
