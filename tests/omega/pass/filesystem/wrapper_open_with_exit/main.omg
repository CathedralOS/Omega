// RUN CANARY (exit 70) -- `Filesystem::open_with` (Rust OpenOptions),
// PROMOTED from pending/host/wrapper_open_with_matrix (2026-07-08j): the
// selected target package encodes the semantic OpenOptions into its foreign
// flag word. The target body remains branch-free and uses sign-safe operations
// only (| & ^ <<), bool-source casts, and ZII for absent literal fields.
// Exercises the matrix end-to-end:
//   1. write+create on an ABSENT path -> creates, write lands;
//   2. read-only open -> reads the bytes back;
//   3. write+truncate -> metadata len 0 after close (truncate happened);
//   4. write+append -> new bytes land at EOF (len grows, tail byte checks);
//   5. create_new on an EXISTING path -> Error{AlreadyExists};
//   6. read on an ABSENT path (no create) -> Error{NotFound}.
// The interpreter's virtual fs is the differential oracle.
// exits: 70 ok; 71 leg-1 create failed; 72 leg-1 write short; 73 leg-2 open
// failed; 74 leg-2 bytes wrong; 75 leg-3 truncate len != 4; 76 leg-4 append
// len != 8 or tail wrong; 77 leg-5 not AlreadyExists; 78 leg-6 not NotFound;
// 79 cleanup failed.
use omega_language_std::File;
use omega_language_std::ErrorKind;
use omega_language_std::OpenResult;
use omega_language_std::IoResult;
use omega_language_std::UnitResult;
use omega_language_std::OpenOptions;
use omega_language_std::Metadata;
use omega_language_std::MetadataResult;
use omega_language_std::Filesystem;
use omega_language_std::Filesystem::read;
use omega_language_std::Filesystem::write;
use omega_language_std::Filesystem::close;
use omega_language_std::Filesystem::read_all;
use omega_language_std::Filesystem::metadata_path;
use omega_language_std::Filesystem::remove;
use omega_language_std::Filesystem::open_with;
use omega_language_std::Console;
data Main {
    fs: Filesystem;
    open_result: OpenResult;
    io_result: IoResult;
    unit_result: UnitResult;
    meta_result: MetadataResult;
    file_handle: u64;
    close_result: UnitResult;
    back: [u8; 16];
}
machine Main::main(main: &mut Main) reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    // Leg 1: write+create on an absent path.
    let opts_wc: OpenOptions = OpenOptions { write: true, create: true };
    main.open_result = block Filesystem::open_with(&mut main.fs, "omega_ow_probe.txt", opts_wc);
    transition main.open_result { OpenResult::Ok { file } -> block writeit(main, file) _ -> bad(main, 71) }
    machine writeit(main: &mut Main, file: File) {
        main.file_handle = file.handle;
        main.io_result = block Filesystem::write(&mut main.fs, File { handle: main.file_handle }, "abc");
        main.close_result = block Filesystem::close(&mut main.fs, File { handle: main.file_handle });
        transition main.io_result { IoResult::Ok { count } -> block wrote(main, count) _ -> bad(main, 72) }
    }
    machine wrote(main: &mut Main, count: u64) {
        transition count == 3 { true -> block leg2(main) _ -> bad(main, 72) }
    }
    // Leg 2: read-only open reads the bytes back.
    machine leg2(main: &mut Main) {
        let opts_r: OpenOptions = OpenOptions { read: true };
        main.open_result = block Filesystem::open_with(&mut main.fs, "omega_ow_probe.txt", opts_r);
        transition main.open_result { OpenResult::Ok { file } -> block readit(main, file) _ -> bad(main, 73) }
    }
    machine readit(main: &mut Main, file: File) {
        main.file_handle = file.handle;
        main.io_result = block Filesystem::read(&mut main.fs, File { handle: main.file_handle }, &mut main.back, 16);
        main.close_result = block Filesystem::close(&mut main.fs, File { handle: main.file_handle });
        transition main.back[0] == 97 { true -> block read_tail(main) _ -> bad(main, 74) }
    }
    machine read_tail(main: &mut Main) {
        transition main.back[2] == 99 { true -> block leg3(main) _ -> bad(main, 74) }
    }
    // Leg 3: write+truncate empties, then write 4 -> len 4.
    machine leg3(main: &mut Main) {
        let opts_wt: OpenOptions = OpenOptions { write: true, truncate: true };
        main.open_result = block Filesystem::open_with(&mut main.fs, "omega_ow_probe.txt", opts_wt);
        transition main.open_result { OpenResult::Ok { file } -> block trunced(main, file) _ -> bad(main, 75) }
    }
    machine trunced(main: &mut Main, file: File) {
        main.file_handle = file.handle;
        main.io_result = block Filesystem::write(&mut main.fs, File { handle: main.file_handle }, "wxyz");
        main.close_result = block Filesystem::close(&mut main.fs, File { handle: main.file_handle });
        main.meta_result = block Filesystem::metadata_path(&mut main.fs, "omega_ow_probe.txt");
        transition main.meta_result { MetadataResult::Ok { meta } -> block ck3(main, meta) _ -> bad(main, 75) }
    }
    machine ck3(main: &mut Main, meta: Metadata) {
        transition meta.len == 4 { true -> block leg4(main) _ -> bad(main, 75) }
    }
    // Leg 4: append -> len grows to 7, tail is the appended bytes.
    machine leg4(main: &mut Main) {
        let opts_a: OpenOptions = OpenOptions { write: true, append: true };
        main.open_result = block Filesystem::open_with(&mut main.fs, "omega_ow_probe.txt", opts_a);
        transition main.open_result { OpenResult::Ok { file } -> block appended(main, file) _ -> bad(main, 76) }
    }
    machine appended(main: &mut Main, file: File) {
        main.file_handle = file.handle;
        main.io_result = block Filesystem::write(&mut main.fs, File { handle: main.file_handle }, "tail");
        main.close_result = block Filesystem::close(&mut main.fs, File { handle: main.file_handle });
        main.io_result = block Filesystem::read_all(&mut main.fs, "omega_ow_probe.txt", &mut main.back, 16);
        transition main.io_result { IoResult::Ok { count } -> block ck4(main, count) _ -> bad(main, 76) }
    }
    machine ck4(main: &mut Main, count: u64) {
        transition count == 8 { true -> block ck4b(main) _ -> bad(main, 76) }
    }
    machine ck4b(main: &mut Main) {
        // "wxyz" + "tail": back[4] = 't' (116), back[7] = 'l' (108).
        transition main.back[4] == 116 { true -> block ck4c(main) _ -> bad(main, 76) }
    }
    machine ck4c(main: &mut Main) {
        transition main.back[7] == 108 { true -> block leg5(main) _ -> bad(main, 76) }
    }
    // Leg 5: create_new on the EXISTING path must be AlreadyExists.
    machine leg5(main: &mut Main) {
        let opts_cn: OpenOptions = OpenOptions { write: true, create_new: true };
        let created: OpenResult = block Filesystem::open_with(&mut main.fs, "omega_ow_probe.txt", opts_cn);
        transition created {
            OpenResult::Error { kind } -> block ck5(main, kind)
            _ -> bad(main, 77)
