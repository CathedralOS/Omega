// NATIVE fs `rename` (Rust) via `_rename` — two path pointers in one call
// (resolved by literal creation order). Creates A, writes to it, renames A->B,
// then opens B for reading (proving the rename moved it) and reads it back.
// Prints PASS. NOT registered in ACTIVE_PASS_CANARIES yet.

use omega::language::std::filesystem_host;

data Main {
    fs: FilesystemHost;
    mode: i32;
    read_flags: i32;
    cap: u64;
    fd: i32;
    n: i64;
    rn: i64;
    rc: i32;
    buffer: [u8; 64];
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.read_flags = 0;
    self.cap = 64;
    self.fd = self.fs.create("/tmp/omega_ren_a.txt", self.mode);
    transition self.fd >= 0 { true -> wrote() _ -> fail() }
    state wrote(&mut self) {
        self.n = self.fs.write(self.fd, "renamed content\n");
        self.n = self.fs.close(self.fd);
        self.rc = self.fs.rename("/tmp/omega_ren_a.txt", "/tmp/omega_ren_b.txt");
        transition self.rc == 0 { true -> renamed() _ -> fail() }
    }
    state renamed(&mut self) {
        self.fd = self.fs.open("/tmp/omega_ren_b.txt", self.read_flags);
        transition self.fd >= 0 { true -> rd() _ -> fail() }
    }
    state rd(&mut self) {
        self.rn = self.fs.read(self.fd, &mut self.buffer, self.cap);
        self.n = self.fs.close(self.fd);
        self.rc = self.fs.remove("/tmp/omega_ren_b.txt");
        transition self.rn == 16 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: rename A->B, B holds the 16-byte content\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: rename\n"); }
}
