// Expected exit: 0. Recursive directory creation follows a directory link,
// rejects file and dangling links, and leaves the links and targets intact.
use omega_language_std::File;
use omega_language_std::ErrorKind;
use omega_language_std::UnitResult;
use omega_language_std::FileKind;
use omega_language_std::Metadata;
use omega_language_std::MetadataResult;
use omega_language_std::Filesystem;
use omega_language_std::Filesystem::write_all;
use omega_language_std::Filesystem::metadata_path;
use omega_language_std::Filesystem::remove;
use omega_language_std::Filesystem::create_dir;
use omega_language_std::Filesystem::remove_dir;
use omega_language_std::Filesystem::create_dir_all;
use omega_language_std::Filesystem::symlink;
use omega_language_std::Console;
data Main { filesystem: Filesystem; }
machine Main::main(main: &mut Main) reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let result: UnitResult = block Filesystem::write_all(&mut main.filesystem, "file_target", "keep");
    transition result { UnitResult::Ok -> block link_file(main) _ -> bad(10) }
    machine link_file(main: &mut Main) {
        let result: UnitResult = block Filesystem::symlink(&mut main.filesystem, "file_target", "file_link");
        transition result { UnitResult::Ok -> block reject_file(main) _ -> bad(11) }
    }
    machine reject_file(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "file_link");
        transition result { UnitResult::Error { kind } -> block file_error(main, kind) _ -> bad(12) }
    }
    machine file_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::AlreadyExists -> block directory(main) _ -> bad(13) }
    }
    machine directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir(&mut main.filesystem, "directory_target");
        transition result { UnitResult::Ok -> block link_directory(main) _ -> bad(14) }
    }
    machine link_directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::symlink(&mut main.filesystem, "directory_target", "directory_link");
        transition result { UnitResult::Ok -> block accept_directory(main) _ -> bad(15) }
    }
    machine accept_directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "directory_link");
        transition result { UnitResult::Ok -> block dangling(main) _ -> bad(16) }
    }
    machine dangling(main: &mut Main) {
        let result: UnitResult = block Filesystem::symlink(&mut main.filesystem, "missing_target", "dangling_link");
        transition result { UnitResult::Ok -> block reject_dangling(main) _ -> bad(23) }
    }
    machine reject_dangling(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "dangling_link");
        transition result { UnitResult::Error { kind } -> block dangling_error(main, kind) _ -> bad(24) }
    }
    machine dangling_error(main: &mut Main, kind: ErrorKind) {
        // Followed metadata fails with NotFound; preserve mkdir's AlreadyExists.
        transition kind { ErrorKind::AlreadyExists -> block unlink_dangling(main) _ -> bad(25) }
    }
    machine unlink_dangling(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "dangling_link");
        transition result { UnitResult::Ok -> block check_file(main) _ -> bad(26) }
    }
    machine check_file(main: &mut Main) {
        let result: MetadataResult = block Filesystem::metadata_path(&mut main.filesystem, "file_target");
        transition result { MetadataResult::Ok { meta } -> block file_metadata(main, meta) _ -> bad(17) }
    }
    machine file_metadata(main: &mut Main, metadata: Metadata) {
        transition metadata.kind { FileKind::File -> block unlink_file(main) _ -> bad(18) }
    }
    machine unlink_file(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "file_link");
        transition result { UnitResult::Ok -> block unlink_directory(main) _ -> bad(19) }
    }
    machine unlink_directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "directory_link");
        transition result { UnitResult::Ok -> block remove_file(main) _ -> bad(20) }
    }
    machine remove_file(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "file_target");
        transition result { UnitResult::Ok -> block remove_directory(main) _ -> bad(21) }
    }
    machine remove_directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove_dir(&mut main.filesystem, "directory_target");
        transition result { UnitResult::Ok -> bad(0) _ -> bad(22) }
    }
    machine bad(code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
