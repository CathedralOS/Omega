// NATIVE MetadataExt::nlink via stat (Rust os::unix::fs::MetadataExt::nlink).
// Creates a file (link count 1), decodes st_nlink (u16 @6) == 1, hard-links it to
// a second name, then re-stats the ORIGINAL and confirms st_nlink is now 2 (both
// names share one inode). Proves the nlink field decodes from the real stat
// record on macOS syscalls.

use omega_language_std::filesystem_host;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

data Main {
    fs: Binding<FilesystemHost>;
    discard: i32;
    mode: i32;
    fd: i32;
    rc: i32;
    nlink1: i32;
    nlink2: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(main: &mut Main) reaches FilesystemHost {
    main.mode = 420;
    main.fd = main.fs.create("/tmp/omega_nlink.txt", main.mode);
    main.n = main.fs.write(main.fd, "hi");
    main.discard = main.fs.close(main.fd);
    // defensive: clear a stale link from a prior failed run (rc ignored)
    main.discard = main.fs.remove("/tmp/omega_nlink_2.txt");
    main.rc = main.fs.read_metadata("/tmp/omega_nlink.txt", &mut main.buffer);
    main.nlink1 =
        widen_u8_to_i32(main.buffer[6]) | (widen_u8_to_i32(main.buffer[7]) << 8);
    main.rc = main.fs.hard_link("/tmp/omega_nlink.txt", "/tmp/omega_nlink_2.txt");
    transition main.rc == 0 { true -> stat2(main) _ -> fail(main) }
    state stat2(main: &mut Main) {
        main.rc = main.fs.read_metadata("/tmp/omega_nlink.txt", &mut main.buffer);
        main.nlink2 =
            widen_u8_to_i32(main.buffer[6]) | (widen_u8_to_i32(main.buffer[7]) << 8);
        main.discard = main.fs.remove("/tmp/omega_nlink_2.txt");
        main.discard = main.fs.remove("/tmp/omega_nlink.txt");
        transition main.nlink1 == 1 { true -> check2(main) _ -> fail(main) }
    }
    state check2(main: &mut Main) {
        transition main.nlink2 == 2 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = main.fs.write(1, "PASS: nlink 1 -> 2 after hard_link\n"); }
    state fail(main: &mut Main) { main.n = main.fs.write(1, "FAIL: nlink\n"); }
}
