use omega::language::core::filesystem_authority;
// NATIVE MetadataExt::blocks/blksize via stat (Rust os::unix::fs::MetadataExt).
// st_blksize (@112) is the filesystem's preferred I/O block size -- a real,
// nonzero value (typically 4096). st_blocks (@104) is the 512-byte block count.
// Proves both fields decode from the real stat record on macOS. (blksize is the
// robust assertion; blocks is filesystem-dependent, so it is only decoded.)

use omega_language_std::posix_filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    discard: i32;
    mode: i32;
    fd: i32;
    rc: i32;
    blksize: i32;
    blocks: i64;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(main: &mut Main) reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    main.mode = 420;
    main.fd = PosixFilesystemHost::create("/tmp/omega_blocks.txt", main.mode);
    main.n = PosixFilesystemHost::write(main.fd, "some content here");
    main.discard = PosixFilesystemHost::close(main.fd);
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_blocks.txt", &mut main.buffer);
    // carrier note: each little-endian field is assembled in the unsigned
    // carrier of its own width and reinterpreted once at the end, so every
    // shifted byte is Exact-representable: 255 << 24 is 4278190080 against
    // a u32 ceiling of 4294967295, and 255 << 56 is 18374686479671623680
    // against a u64 ceiling of 18446744073709551615. Shifting in the signed
    // carriers reaches the same values against ceilings of 2147483647 and
    // 9223372036854775807, a decision-17 obligation no return range can
    // discharge.
    main.blksize = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[112])
            | (widen_u8_to_u32(main.buffer[113]) << 8)
            | (widen_u8_to_u32(main.buffer[114]) << 16)
            | (widen_u8_to_u32(main.buffer[115]) << 24));
    main.blocks = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(main.buffer[104])
            | (widen_u8_to_u64(main.buffer[105]) << 8)
            | (widen_u8_to_u64(main.buffer[106]) << 16)
            | (widen_u8_to_u64(main.buffer[107]) << 24)
            | (widen_u8_to_u64(main.buffer[108]) << 32)
            | (widen_u8_to_u64(main.buffer[109]) << 40)
            | (widen_u8_to_u64(main.buffer[110]) << 48)
            | (widen_u8_to_u64(main.buffer[111]) << 56));
    main.discard = PosixFilesystemHost::remove("/tmp/omega_blocks.txt");
    transition main.blksize > 0 { true -> good(main) _ -> fail(main) }
    state good(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "PASS: st_blksize decodes a nonzero preferred I/O size\n"); }
    state fail(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "FAIL: blocks/blksize\n"); }
}
