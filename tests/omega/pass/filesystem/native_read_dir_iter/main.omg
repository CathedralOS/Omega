// NATIVE fs read_dir ITERATION (Rust fs::read_dir's DirEntry walk) on real macOS.
// This is the payoff of fixing the runtime-indexed-read instruction: it fills the
// directory buffer via ___getdirentries64, then WALKS the packed dirent records
// with a RUNTIME-INDEXED cursor — `buffer[off+16]`/`[off+17]` reads the LE u16
// `d_reclen`, advancing `off` by `reclen` until the filled byte count. Counts the
// entries (".", "..", "alpha", "beta" => 4). The `buffer[main.idx]` reads (idx a
// runtime value) exercise `CopyRuntimeMachineIndexedToRuntimeStorage`, which now
// lowers correctly on aarch64. Prints PASS iff exactly 4 entries are walked.

use omega_language_std::filesystem_host;
use omega::language::core::binding;

data Main {
    fs: Binding<FilesystemHost>;
    discard: i32;
    dirmode: i32;
    filemode: i32;
    rdonly: i32;
    cap: u64;
    rc: i32;
    fd: i32;
    dfd: i32;
    n: i64;
    total: i64;
    totalu: u64 in Wrapping;
    position: i64;
    off: u64 in Wrapping;
    idx: u64 in Wrapping;
    count: i32 in Wrapping;
    lo: u8;
    hi: u8;
    lou: u64 in Wrapping;
    hiu: u64 in Wrapping;
    reclen: u64 in Wrapping;
    buffer: [u8; 512];
}

machine Main::main(main: &mut Main) reaches FilesystemHost {
    main.dirmode = 493;
    main.filemode = 420;
    main.rdonly = 0;
    main.cap = 512;
    main.position = 0;
    main.off = 0;
    main.count = 0;
    main.rc = main.fs.create_dir("/tmp/omega_rdi", main.dirmode);
    main.fd = main.fs.create("/tmp/omega_rdi/alpha", main.filemode);
    main.discard = main.fs.close(main.fd);
    main.fd = main.fs.create("/tmp/omega_rdi/beta", main.filemode);
    main.discard = main.fs.close(main.fd);
    main.dfd = main.fs.open("/tmp/omega_rdi", main.rdonly);
    transition main.dfd >= 0 { true -> readit(main) _ -> fail(main) }
    state readit(main: &mut Main) {
        main.total = main.fs.read_dir(main.dfd, &mut main.buffer, main.cap, &mut main.position);
        main.totalu = main.total as u64 in Wrapping;
        transition main.total > 0 { true -> walk(main) _ -> fail(main) }
    }
    state walk(main: &mut Main) {
        // dominating guard: cursor within the buffer so the header reads are
        // provably in-bounds (discharges the static index-bounds obligation).
        transition main.off < 480 { true -> walkbody(main) _ -> fail(main) }
    }
    state walkbody(main: &mut Main) {
        // d_reclen: little-endian u16 at record offset + 16 (RUNTIME-indexed read)
        main.idx = main.off + 16;
        main.lo = main.buffer[main.idx];
        main.idx = main.off + 17;
        main.hi = main.buffer[main.idx];
        main.lou = main.lo as u64 in Wrapping;
        main.hiu = main.hi as u64 in Wrapping;
        main.reclen = (main.hiu << 8) | main.lou;
        main.count = main.count + 1;
        main.off = main.off + main.reclen;
        transition main.off < main.totalu { true -> walk(main) _ -> done(main) }
    }
    state done(main: &mut Main) {
        main.discard = main.fs.close(main.dfd);
        main.discard = main.fs.remove("/tmp/omega_rdi/alpha");
        main.discard = main.fs.remove("/tmp/omega_rdi/beta");
        main.rc = main.fs.remove_dir("/tmp/omega_rdi");
        // entries: ".", "..", "alpha", "beta" => 4
        transition main.count == 4 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = main.fs.write(1, "PASS: read_dir iteration walked 4 entries (., .., alpha, beta) natively\n"); }
    state fail(main: &mut Main) { main.n = main.fs.write(1, "FAIL: read_dir iteration\n"); }
}
