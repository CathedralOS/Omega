// RUN CANARY (exit 70, WINDOWS-HOST ONLY) -- the WRAPPER canonicalize
// contract on windows (windows session slices 4a/4d): msvcrt has no realpath,
// so the windows_x86_64 impl composes CreateFileA(FILE_FLAG_BACKUP_SEMANTICS),
// GetFinalPathNameByHandleA (flags 0 = the \\?\-prefixed DOS path, exactly
// Rust's windows canonicalize spelling), CloseHandle. This supports files AND
// directories. Dual-engine with
// per-model first-byte discrimination: NATIVE resolves to "\\?\C:\..."
// (first byte '\\', 92); the HERMETIC model's canonical path IS the
// descriptor's stored key (first byte 'o' of the relative probe name,
// 111) -- the transition accepts exactly these two, so a garbage or
// unwritten buffer fails BOTH engines. The missing-path leg pins
// NotFound on both (the open leg fails with native/model ERROR_FILE_NOT_FOUND
// before path resolution).
// exits: 70 good; 71 seed write failed; 72 canonicalize refused; 73 the
// resolved buffer starts with neither model's spelling; 74 the
// missing-path leg did not refuse; 75 the refusal kind was not NotFound;
// 76 directory creation failed; 77 directory canonicalize refused; 78 the
// resolved directory buffer starts with neither model's spelling.

use omega_language_std::filesystem;

use omega_language_std::console;

// Separate entry for the host-call-count regression: failed acquisition must
// observe its error without querying or closing the invalid handle.
data FailedOpen {
    filesystem: Filesystem;
    buffer: [u8; 1024];
    result: UnitResult;
}

machine FailedOpen::main(failed_open: &mut FailedOpen) -> i32 {
    let outcome: UnitResult = block Filesystem::canonicalize(&mut failed_open.filesystem, "omega_wcanon_missing.txt", &mut failed_open.buffer);
    transition outcome {
        UnitResult::Error { kind } -> failed(kind)
        _ -> unexpected()
    }
    machine failed(kind: ErrorKind) -> i32 {
        transition kind { ErrorKind::NotFound -> expected() _ -> unexpected() }
    }
    machine expected() -> i32 { 70 }
    machine unexpected() -> i32 { 71 }
}

data Main {
    fs: Filesystem;
    unit_result: UnitResult;
    canon: [u8; 1024];
}

machine Main::main(main: &mut Main) reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    main.unit_result = block Filesystem::write_all(&mut main.fs, "omega_wcanon_probe.txt", "canon");
    transition main.unit_result { UnitResult::Ok -> resolve(main) _ -> bad(main, 71) }
    machine resolve(main: &mut Main) {
        main.unit_result = block Filesystem::canonicalize(&mut main.fs, "omega_wcanon_probe.txt", &mut main.canon);
        transition main.unit_result { UnitResult::Ok -> spelled(main) _ -> bad(main, 72) }
    }
    machine spelled(main: &mut Main) {
        // Native: '\\' (92, the \\?\ prefix). Hermetic: 'o' (111, the key
        // verbatim). Anything else = the resolve never wrote the buffer.
        transition canonical_prefix_is_valid(main.canon[0]) { true -> make_dir(main) _ -> bad(main, 73) }
    }
    machine make_dir(main: &mut Main) {
        main.unit_result = block Filesystem::create_dir(&mut main.fs, "omega_wcanon_dir");
        transition main.unit_result { UnitResult::Ok -> resolve_dir(main) _ -> bad(main, 76) }
    }
    machine resolve_dir(main: &mut Main) {
        main.unit_result = block Filesystem::canonicalize(&mut main.fs, "omega_wcanon_dir", &mut main.canon);
        transition main.unit_result { UnitResult::Ok -> spelled_dir(main) _ -> bad(main, 77) }
    }
    machine spelled_dir(main: &mut Main) {
        transition canonical_prefix_is_valid(main.canon[0]) { true -> missing(main) _ -> bad(main, 78) }
    }
    machine missing(main: &mut Main) {
        let outcome: UnitResult = block Filesystem::canonicalize(&mut main.fs, "omega_wcanon_missing.txt", &mut main.canon);
        transition outcome { UnitResult::Error { kind } -> kindcheck(main, kind) _ -> bad(main, 74) }
    }
    machine kindcheck(main: &mut Main, kind: ErrorKind) {
        // The open leg's captured GetLastError supplies this classification.
        transition kind { ErrorKind::NotFound -> cleanup(main) _ -> bad(main, 75) }
    }
    machine cleanup(main: &mut Main) {
        main.unit_result = block Filesystem::remove(&mut main.fs, "omega_wcanon_probe.txt");
        transition { _ -> cleanup_dir(main) }
    }
    machine cleanup_dir(main: &mut Main) {
        main.unit_result = block Filesystem::remove_dir(&mut main.fs, "omega_wcanon_dir");
        transition { _ -> good(main) }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// A hosted native canonical path is absolute in its selected OS spelling.
// The Windows model's independently authored relative-key oracle is retained.
linux_x86_64 machine canonical_prefix_is_valid(byte: u8) -> bool { byte == 47 }
linux_arm64 machine canonical_prefix_is_valid(byte: u8) -> bool { byte == 47 }
macos_arm64 machine canonical_prefix_is_valid(byte: u8) -> bool { byte == 47 }
macos_x86_64 machine canonical_prefix_is_valid(byte: u8) -> bool { byte == 47 }
windows_x86_64 machine canonical_prefix_is_valid(byte: u8) -> bool { byte == 92 || byte == 111 }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
