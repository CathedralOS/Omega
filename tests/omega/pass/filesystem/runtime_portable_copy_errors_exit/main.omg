// Expected exit: 0.
// Copy transfers only the bounded initialized prefix, preserves scratch tails,
// and propagates acquisition errors. Canonicalization checks capacity before
// touching output. The Linux-only full-device control separately pins write_all.
use omega_language_std::filesystem;
use omega_language_std::console;

data Main {
    filesystem: Filesystem;
    scratch: [u8; 8];
    readback: [u8; 8];
    small: [u8; 2];
}
machine Main::main(main: &mut Main) reaches Console {
    main.scratch[3] = 85;
    main.readback[3] = 86;
    main.small[0] = 87;
    main.small[1] = 88;
    let result: UnitResult = block Filesystem::write_all(&mut main.filesystem, "omega_copy_source.txt", "abcdef");
    transition result { UnitResult::Ok -> permissions(main) _ -> bad(10) }
    machine permissions(main: &mut Main) {
        let result: UnitResult = block Filesystem::set_permissions(&mut main.filesystem, "omega_copy_source.txt", Permissions::Posix { mode: 384 });
        transition result { UnitResult::Ok -> copy(main) _ -> bad(27) }
    }
    machine copy(main: &mut Main) {
        let result: IoResult = block Filesystem::copy(&mut main.filesystem, "omega_copy_source.txt", "omega_copy_destination.txt", &mut main.scratch, 3);
        transition result { IoResult::Ok { count } -> copied(main, count) _ -> bad(11) }
    }
    machine copied(main: &mut Main, count: u64) {
        transition count == 3 && main.scratch[0] == 97 && main.scratch[1] == 98 && main.scratch[2] == 99 && main.scratch[3] == 85 {
            true -> copied_permissions(main) false -> bad(12)
        }
    }
    machine copied_permissions(main: &mut Main) {
        let result: MetadataResult = block Filesystem::metadata_path(&mut main.filesystem, "omega_copy_destination.txt");
        transition result { MetadataResult::Ok { meta } -> check_permissions(main, meta) _ -> bad(28) }
    }
    machine check_permissions(main: &mut Main, metadata: Metadata) {
        transition metadata.posix { PosixMetadataResult::Ok { details } -> check_mode(main, details) _ -> bad(29) }
    }
    machine check_mode(main: &mut Main, details: PosixMetadata) {
        transition (details.mode & 511) == 384 { true -> read(main) false -> bad(29) }
    }
    machine read(main: &mut Main) {
        let result: IoResult = block Filesystem::read_all(&mut main.filesystem, "omega_copy_destination.txt", &mut main.readback, 8);
        transition result { IoResult::Ok { count } -> read_count(main, count) _ -> bad(13) }
    }
    machine read_count(main: &mut Main, count: u64) {
        transition count == 3 && main.readback[0] == 97 && main.readback[1] == 98 && main.readback[2] == 99 && main.readback[3] == 86 {
            true -> missing_source(main) false -> bad(14)
        }
    }
    machine missing_source(main: &mut Main) {
        let result: IoResult = block Filesystem::copy(&mut main.filesystem, "/no_such_omega_copy_parent_999/source", "omega_copy_uncreated.txt", &mut main.scratch, 8);
        transition result { IoResult::Error { kind } -> source_error(main, kind) _ -> bad(15) }
    }
    machine source_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> check_destination(main) _ -> bad(16) }
    }
    machine check_destination(main: &mut Main) {
        let exists: bool = block Filesystem::exists(&mut main.filesystem, "omega_copy_uncreated.txt");
        transition exists { false -> missing_destination(main) true -> bad(17) }
    }
    machine missing_destination(main: &mut Main) {
        let result: IoResult = block Filesystem::copy(&mut main.filesystem, "omega_copy_source.txt", "/no_such_omega_copy_parent_999/destination", &mut main.scratch, 8);
        transition result { IoResult::Error { kind } -> destination_error(main, kind) _ -> bad(18) }
    }
    machine destination_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> canonical(main) _ -> bad(19) }
    }
    machine canonical(main: &mut Main) {
        let result: UnitResult = block Filesystem::canonicalize(&mut main.filesystem, "omega_copy_source.txt", &mut main.small);
        transition result { UnitResult::Error { kind } -> capacity_error(main, kind) _ -> bad(20) }
    }
    machine capacity_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::InvalidInput -> unchanged(main) _ -> bad(21) }
    }
    machine unchanged(main: &mut Main) {
        transition main.small[0] == 87 && main.small[1] == 88 { true -> missing_canonical(main) false -> bad(22) }
    }
    machine missing_canonical(main: &mut Main) {
        let result: UnitResult = block Filesystem::canonicalize(&mut main.filesystem, "/no_such_omega_canonical_parent_999/source", &mut main.small);
        transition result { UnitResult::Error { kind } -> canonical_error(main, kind) _ -> bad(33) }
    }
    machine canonical_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> missing_unchanged(main) _ -> bad(34) }
    }
    machine missing_unchanged(main: &mut Main) {
        transition main.small[0] == 87 && main.small[1] == 88 { true -> long_name(main) false -> bad(35) }
    }
    machine long_name(main: &mut Main) {
        // One 256-byte component exceeds both hosts' 255-byte NAME_MAX.
        let result: OpenResult = block Filesystem::open(&mut main.filesystem, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
        transition result { OpenResult::Error { kind } -> name_error(main, kind) _ -> bad(23) }
    }
    machine name_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::InvalidInput -> oversized_path(main) _ -> bad(24) }
    }
    machine oversized_path(main: &mut Main) {
        // Exactly 4096 non-NUL bytes: the adapter must refuse before realpath,
        // independently of the OS's path-component limit and errno numbering.
        let result: UnitResult = block Filesystem::canonicalize(&mut main.filesystem, "", &mut main.small);
        transition result { UnitResult::Error { kind } -> oversized_error(main, kind) _ -> bad(30) }
    }
    machine oversized_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::InvalidInput -> oversized_unchanged(main) _ -> bad(31) }
    }
    machine oversized_unchanged(main: &mut Main) {
        transition main.small[0] == 87 && main.small[1] == 88 { true -> remove_source(main) false -> bad(32) }
    }
    machine remove_source(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "omega_copy_source.txt");
        transition result { UnitResult::Ok -> remove_destination(main) _ -> bad(25) }
    }
    machine remove_destination(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "omega_copy_destination.txt");
        transition result { UnitResult::Ok -> good() _ -> bad(26) }
    }
    machine good() { Console::exit_process(0); }
    machine bad(code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
