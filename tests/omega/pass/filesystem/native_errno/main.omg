use omega::language::core::filesystem_authority;
// NATIVE fs errno (typed error model). Opens a path that does not exist; the
// raw POSIX service reports failure as the negated errno, so the open returns
// -ENOENT (-2) on every POSIX target: Linux's kernel result directly, and
// Darwin's libc -1 with errno read from `___error()`. Prints PASS iff the
// result is -2.

use omega_language_std::posix_filesystem_host;

data Main {
    rdonly: i32;
    fd: i32;
    code: i32;
    n: i64;
}

machine Main::main(main: &mut Main) reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    main.rdonly = 0;
    main.fd = PosixFilesystemHost::open("/tmp/omega_definitely_absent_xyzzy.txt", main.rdonly);
    transition main.fd < 0 { true -> classify(main) _ -> fail(main) }
    state classify(main: &mut Main) {
        transition main.fd == -2 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "PASS: a missing open returns -ENOENT (-2)\n"); }
    state fail(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "FAIL: errno\n"); }
}
