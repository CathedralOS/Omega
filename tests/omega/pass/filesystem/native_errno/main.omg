// NATIVE fs errno (typed error model). Opens a path that does not exist; the
// raw open returns a negative fd, and errno() (darwin ___error() dereferenced)
// reports ENOENT (2). Proves the value-returning-with-pointer-deref host call
// works end-to-end. Prints PASS iff errno == 2.

use omega_language_std::filesystem_host;
use omega::language::core::binding;

data Main {
    fs: Binding<FilesystemHost>;
    rdonly: i32;
    fd: i32;
    code: i32;
    n: i64;
}

machine Main::main(main: &mut Main) reaches FilesystemHost {
    main.rdonly = 0;
    main.fd = main.fs.open("/tmp/omega_definitely_absent_xyzzy.txt", main.rdonly);
    transition main.fd < 0 { true -> classify(main) _ -> fail(main) }
    state classify(main: &mut Main) {
        main.code = main.fs.errno();
        transition main.code == 2 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = main.fs.write(1, "PASS: errno == ENOENT (2) for a missing open\n"); }
    state fail(main: &mut Main) { main.n = main.fs.write(1, "FAIL: errno\n"); }
}
