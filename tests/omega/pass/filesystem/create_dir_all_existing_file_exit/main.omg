// Expected exit: 0. Recursive directory creation accepts an existing directory,
// but must not report success for an ordinary file at the requested leaf.
use omega_language_std::filesystem;
use omega_language_std::console;

data Main { filesystem: Filesystem; }

machine Main::main(main: &mut Main) reaches Console {
    let result: UnitResult = block Filesystem::write_all(&mut main.filesystem, "leaf.txt", "keep");
    transition result { UnitResult::Ok -> existing_file(main) _ -> cleanup(main, 10) }
    machine existing_file(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "leaf.txt");
        transition result {
            UnitResult::Error { kind } -> file_error(main, kind)
            _ -> cleanup(main, 11)
        }
    }
    machine file_error(main: &mut Main, kind: ErrorKind) {
        transition kind { ErrorKind::AlreadyExists -> create(main) _ -> cleanup(main, 12) }
    }
    machine create(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "good/nested");
        transition result { UnitResult::Ok -> existing_directory(main) _ -> cleanup(main, 13) }
    }
    machine existing_directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::create_dir_all(&mut main.filesystem, "good/nested");
        transition result { UnitResult::Ok -> remove_directory(main) _ -> cleanup(main, 14) }
    }
    machine remove_directory(main: &mut Main) {
        let result: UnitResult = block Filesystem::remove_dir_all(&mut main.filesystem, "good");
        transition result { UnitResult::Ok -> cleanup(main, 0) _ -> cleanup(main, 15) }
    }
    machine cleanup(main: &mut Main, status: i32) {
        let result: UnitResult = block Filesystem::remove(&mut main.filesystem, "leaf.txt");
        transition result { UnitResult::Ok -> exit(status) _ -> exit(16) }
    }
    machine exit(status: i32) { Console::exit_process(status); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
