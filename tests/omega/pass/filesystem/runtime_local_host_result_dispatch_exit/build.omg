// Deployable local host-result canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_local_host_result_dispatch_exit");
    Build::depend(builder, Source::Path {
        location: "../../../../../source/library/std"
    });
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
