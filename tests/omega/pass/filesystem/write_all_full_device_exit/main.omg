// Expected exit: 0. An acquired writable descriptor can still fail its write.
// /dev/full is Linux-specific; portable copy/capacity controls run separately.
use omega_language_std::filesystem;
use omega_language_std::console;
data Main { filesystem: Filesystem; }
machine Main::main(main: &mut Main) reaches Console {
    let result: UnitResult = block Filesystem::write_all(&mut main.filesystem, "/dev/full", "cannot fit");
    transition result { UnitResult::Error { kind } -> failed_write(kind) _ -> bad() }
    machine failed_write(kind: ErrorKind) {
        transition kind { ErrorKind::Other -> good() _ -> bad() }
    }
    machine good() { Console::exit_process(0); }
    machine bad() { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
