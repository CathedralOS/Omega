use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "windows_raw_read_link_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);

 Build::bind<FixtureSymlink::create>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "CreateSymbolicLinkW"
    } });
}
