// Expected exit: 70 (Windows only). Needs Windows Developer Mode (or an
// authorized symlink-creation token) for fixture setup; never skips that setup.
// Read dangling relative/absolute targets without following them, return a
// byte prefix without NUL, and validate all Unicode before copying any prefix.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::external_binding;
