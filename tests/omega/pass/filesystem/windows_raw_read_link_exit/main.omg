domain [u16; 19]::FixtureLink(path) requires path[18] == 0;
domain [u16; 64]::FixtureTarget(path) requires path[63] == 0;

// Independent, fixture-only setup. Windows requires file/directory intent;
// the portable generic symlink operation cannot infer that intent. BOOLEAN is
// an eight-bit result, not Win32's four-byte BOOL.
boundary trait FixtureSymlink {
    machine create(link: &[u16; 19] in FixtureLink, target: &[u16; 64] in FixtureTarget, flags: u32) -> u8
    requires flags == 2
    reaches FilesystemNamespaceMutation blocks;
}
windows_x86_64 machine fixture_symlink_binding() -> ForeignBinding<12, 19, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "CreateSymbolicLinkW"
    } }
}
