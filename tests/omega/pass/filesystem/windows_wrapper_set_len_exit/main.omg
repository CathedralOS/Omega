// RUN CANARY (exit 70) -- `set_len` UNFENCED on windows_x86_64 (2026-07-08). The raw
// seam now binds msvcrt `_chsize_s(fd, __int64 size)` (ftruncate's analogue, the
// 64-bit variant so the i64 length is not truncated to `_chsize`'s 32-bit long).
// Discriminating: create an empty file, EXTEND it to 10 bytes with set_len, then
// `metadata_path` reports len == 10 (the size change is a metadata op on the fd,
// visible to a subsequent stat). NATIVE + interp differential.
// exits: 70 ok; 71 create failed; 72 set_len not Ok; 73 close nonzero; 74 metadata
// not Ok; 75 wrong len.
use omega_language_std::filesystem;
use omega_language_std::filesystem_host;
use omega_language_std::console;
data Main { console: Console; fs: Filesystem; open_result: OpenResult; unit_result: UnitResult; meta_result: MetadataResult; rc: i32; }
machine Main::main(&mut self) {
    self.open_result = self.fs.create("omega_setlen_probe.txt");
    transition self.open_result { OpenResult::Ok { file } -> extend(file) _ -> bad(71) }
    state extend(&mut self, file: File) {
        self.unit_result = self.fs.set_len(file, 10);
        transition self.unit_result { UnitResult::Ok -> close_it(file) _ -> bad(72) }
    }
    state close_it(&mut self, file: File) {
        self.rc = self.fs.close(file);
        transition self.rc == 0 { true -> verify() _ -> bad(73) }
    }
    state verify(&mut self) {
        self.meta_result = self.fs.metadata_path("omega_setlen_probe.txt");
        transition self.meta_result { MetadataResult::Ok { meta } -> chk(meta) _ -> bad(74) }
    }
    state chk(&mut self, meta: Metadata) {
        self.unit_result = self.fs.remove("omega_setlen_probe.txt");
        transition meta.len == 10 { true -> good() _ -> bad(75) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
