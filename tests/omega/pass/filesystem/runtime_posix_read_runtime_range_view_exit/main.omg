// POSIX `read` lends a byte-view element of the caller's backing to the
// native descriptor: the provider's `&mut buffer[0]` on its `&mut [u8]`
// parameter is the foreign call's structural input, an inline byte element
// with no declaration of its own. Every spelling of that view reaches the
// same call: a field buffer windowed from a runtime offset while short
// transfers accumulate to EOF, a `&mut [u8; N]` parameter windowed by its
// caller, and a local buffer, each read twice into the same backing.
use omega_language_std::posix_filesystem_host;

data Main {
    source: [u8; 300];
    buffer: [u8; 320];
    window: [u8; 64];
    fd: i32;
    n: i64;
    received: u64 [0..=320];
    cursor: i64;
    first: i64;
    second: i64;
    local: i64;
    discard: i32;
}

// A caller-chosen window of a borrowed fixed buffer. The caller's second
// call reuses the buffer from a later offset.
machine read_window(fd: i32, bytes: &mut [u8; 64], start: u64 [0..=64]) -> i64
    reaches PosixFilesystemHost
{
    PosixFilesystemHost::read(fd, &mut bytes[start..64], 64 - start)
}

// The same window over a local buffer, read twice; the sentinel past the
// window and the bytes the second transfer placed decide the result.
machine read_local(fd: i32, start: u64 [0..=7]) -> i64
    reaches PosixFilesystemHost
{
    let mut local: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 9];
    let first: i64 = PosixFilesystemHost::read(fd, &mut local[start..7], 7 - start);
    let second: i64 = PosixFilesystemHost::read(fd, &mut local[start..7], 7 - start);
    transition first == 4 && second == 4 && local[0] == 0 && local[3] == 33 && local[7] == 9 {
        true -> (1)
        _ -> (0)
    }
}

machine Main::main(main: &mut Main) reaches PosixFilesystemHost {
    main.source[0] = 11;
    main.source[31] = 66;
    main.source[64] = 55;
    main.source[99] = 22;
    main.source[100] = 33;
    main.source[299] = 44;
    main.buffer[319] = 7;
    main.discard = PosixFilesystemHost::remove("/tmp/omega_runtime_range_view_read.txt");
    main.fd = PosixFilesystemHost::create("/tmp/omega_runtime_range_view_read.txt", 420);
    transition main.fd >= 0 { true -> write(main) _ -> fail(main) }

    state write(main: &mut Main) {
        main.n = PosixFilesystemHost::write(main.fd, &main.source[0..300]);
        main.discard = PosixFilesystemHost::close(main.fd);
        main.fd = PosixFilesystemHost::open("/tmp/omega_runtime_range_view_read.txt", 0);
        transition main.n == 300 && main.fd >= 0 { true -> read_go(main) _ -> fail(main) }
    }

    // --- a field buffer windowed from the runtime offset, to EOF ---
    state read_go(main: &mut Main) {
        main.received = 0;
        transition { _ -> read_more(main) }
    }
    state read_more(main: &mut Main) {
        transition main.received < 320 { true -> read_chunk(main) _ -> read_close(main) }
    }
    state read_chunk(main: &mut Main) {
        main.n = PosixFilesystemHost::read(main.fd, &mut main.buffer[main.received..320], 320 - main.received);
        transition main.n > 0 { true -> read_count(main) _ -> read_close(main) }
    }
    state read_count(main: &mut Main) {
        transition main.n as u64 <= 320 - main.received { true -> read_advance(main) _ -> read_error(main) }
    }
    state read_advance(main: &mut Main) {
        main.received = main.received + main.n as u64;
        transition { _ -> read_more(main) }
    }
    state read_error(main: &mut Main) {
        main.n = 0 - 1;
        transition { _ -> read_close(main) }
    }
    state read_close(main: &mut Main) {
        transition main.n == 0 && main.received == 300
            && main.buffer[0] == 11 && main.buffer[99] == 22 && main.buffer[100] == 33
            && main.buffer[299] == 44 && main.buffer[300] == 0 && main.buffer[319] == 7 {
            true -> rewind(main)
            _ -> fail(main)
        }
    }

    // --- a `&mut [u8; 64]` parameter windowed by the caller, reused ---
    state rewind(main: &mut Main) {
        main.cursor = PosixFilesystemHost::seek(main.fd, 0, 0);
        main.first = read_window(main.fd, &mut main.window, 0);
        main.second = read_window(main.fd, &mut main.window, 32);
        transition main.cursor == 0 && main.first == 64 && main.second == 32
            && main.window[0] == 11 && main.window[31] == 66 && main.window[32] == 55 {
            true -> local(main)
            _ -> fail(main)
        }
    }

    // --- a local buffer windowed from a parameter offset, reused ---
    state local(main: &mut Main) {
        main.local = read_local(main.fd, 3);
        transition main.local == 1 { true -> success(main) _ -> fail(main) }
    }
    state success(main: &mut Main) {
        main.discard = PosixFilesystemHost::close(main.fd);
        main.discard = PosixFilesystemHost::remove("/tmp/omega_runtime_range_view_read.txt");
        main.n = PosixFilesystemHost::write(1, "PASS: runtime range views, 300 bytes to EOF, windowed parameter and local reuse\n");
    }
    state fail(main: &mut Main) {
        main.discard = PosixFilesystemHost::close(main.fd);
        main.discard = PosixFilesystemHost::remove("/tmp/omega_runtime_range_view_read.txt");
        main.n = PosixFilesystemHost::write(1, "FAIL: runtime range view read\n");
    }
}
