// Expected exit: 70 (Windows only). Names-only enumeration counts a child
// directory and two files, including a 300-byte UTF-8 name. Counting must not
// decode into the portable 256-byte DirEntry buffer or request metadata reach.
use omega_language_std::WindowsFilesystemHost;
use omega_language_std::Console;
use omega::language::core::FilesystemContentRead;
use omega::language::core::FilesystemContentWrite;
use omega::language::core::FilesystemMetadataMutation;
use omega::language::core::DirectoryEnumeration;
use omega::language::core::FilesystemNamespaceMutation;

data Main { first: u64; second: u64; }

machine Main::main(main: &mut Main)
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration {
    let removed: i32 = block cleanup_names();
    let created: i32 = block WindowsFilesystemHost::create_directory("omega_raw_directory");
    transition created == 0 { true -> block child(main) false -> block finish(main, 71) }
    machine child(main: &mut Main) {
        let status: i32 = block WindowsFilesystemHost::create_directory("omega_raw_directory/child");
        transition status == 0 { true -> block first(main) false -> block finish(main, 72) }
    }
    machine first(main: &mut Main) {
        main.first = block WindowsFilesystemHost::create_file("omega_raw_directory/first", 3221225472, 7, 2, 128);
        transition main.first != 0 { true -> block second(main) false -> block finish(main, 73) }
    }
    machine second(main: &mut Main) {
        main.second = block WindowsFilesystemHost::create_file("omega_raw_directory/界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界", 3221225472, 7, 2, 128);
        transition main.second != 0 { true -> block count(main) false -> block finish(main, 74) }
    }
    machine count(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::directory_count("omega_raw_directory");
        transition count == 3 { true -> block empty(main) false -> block finish(main, 75) }
    }
    machine empty(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::directory_count("omega_raw_directory/child");
        transition count == 0 { true -> block refuse_file(main) false -> block finish(main, 76) }
    }
    machine refuse_file(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::directory_count("omega_raw_directory/first");
        transition count < 0 { true -> block refuse_missing(main) false -> block finish(main, 77) }
    }
    machine refuse_missing(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::directory_count("omega_raw_directory/missing");
        transition count < 0 { true -> block finish(main, 70) false -> block finish(main, 78) }
    }
    machine finish(main: &mut Main, code: i32) {
        let second: i32 = block close_if_present(main.second);
        let first: i32 = block close_if_present(main.first);
        let removed: i32 = block cleanup_names();
        transition code != 70 { true -> done(code) false -> cleanup(first, second, removed) }
    }
    machine cleanup(first: i32, second: i32, removed: i32) {
        transition first == 0 && second == 0 && removed == 0 { true -> done(70) false -> done(79) }
    }
    machine done(code: i32) { Console::exit_process(code); }
}

machine close_if_present(handle: u64) -> i32 {
    transition handle != 0 { true -> block release(handle) false -> 0 }
    machine release(handle: u64) -> i32 { block WindowsFilesystemHost::close_handle(handle) }
}

machine cleanup_names() -> i32 reaches FilesystemNamespaceMutation {
    let first: i32 = block WindowsFilesystemHost::delete_file("omega_raw_directory/first");
    let second: i32 = block WindowsFilesystemHost::delete_file("omega_raw_directory/界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界界");
    let child: i32 = block WindowsFilesystemHost::remove_directory("omega_raw_directory/child");
    block WindowsFilesystemHost::remove_directory("omega_raw_directory")
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
