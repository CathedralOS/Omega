use omega::language::core::filesystem_authority;
// NATIVE MetadataExt::ctime/dev via stat (Rust os::unix::fs::MetadataExt). Two
// files on the same filesystem: st_ctime reads a real recent change time
// (> 1e9), and both files share a NONZERO st_dev (@0) — the device of /tmp.
// `read_metadata` delivers the TARGET's raw `struct stat`: Darwin keeps the
// ctime seconds at offset 64; the Linux generic layout keeps them at offset
// 104 — each bound target decodes its own record.

use omega_language_std::posix_filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    discard: i32;
    mode: i32;
    fd: i32;
    rc: i32;
    ctime: i64;
    dev_a: i32;
    dev_b: i32;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main_linux(main: &mut Main) reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    main.mode = 420;
    main.fd = PosixFilesystemHost::create("/tmp/omega_cd_a.txt", main.mode);
    main.n = PosixFilesystemHost::write(main.fd, "a");
    main.discard = PosixFilesystemHost::close(main.fd);
    main.fd = PosixFilesystemHost::create("/tmp/omega_cd_b.txt", main.mode);
    main.discard = PosixFilesystemHost::close(main.fd);
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_cd_a.txt", &mut main.buffer);
    // carrier note: each little-endian field is assembled in the unsigned
    // carrier of its own width and reinterpreted once at the end, so every
    // shifted byte is Exact-representable: 255 << 24 is 4278190080 against
    // a u32 ceiling of 4294967295, and 255 << 56 is 18374686479671623680
    // against a u64 ceiling of 18446744073709551615. Shifting in the signed
    // carriers reaches the same values against ceilings of 2147483647 and
    // 9223372036854775807, a decision-17 obligation no return range can
    // discharge.
    main.ctime = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(main.buffer[104])
            | (widen_u8_to_u64(main.buffer[105]) << 8)
            | (widen_u8_to_u64(main.buffer[106]) << 16)
            | (widen_u8_to_u64(main.buffer[107]) << 24)
            | (widen_u8_to_u64(main.buffer[108]) << 32)
            | (widen_u8_to_u64(main.buffer[109]) << 40)
            | (widen_u8_to_u64(main.buffer[110]) << 48)
            | (widen_u8_to_u64(main.buffer[111]) << 56));
    main.dev_a = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[0])
            | (widen_u8_to_u32(main.buffer[1]) << 8)
            | (widen_u8_to_u32(main.buffer[2]) << 16)
            | (widen_u8_to_u32(main.buffer[3]) << 24));
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_cd_b.txt", &mut main.buffer);
    main.dev_b = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[0])
            | (widen_u8_to_u32(main.buffer[1]) << 8)
            | (widen_u8_to_u32(main.buffer[2]) << 16)
            | (widen_u8_to_u32(main.buffer[3]) << 24));
    main.discard = PosixFilesystemHost::remove("/tmp/omega_cd_a.txt");
    main.discard = PosixFilesystemHost::remove("/tmp/omega_cd_b.txt");
    transition main.ctime > 1000000000 { true -> checkdev(main) _ -> fail(main) }
    state checkdev(main: &mut Main) {
        // two files on the same filesystem share a device id
        transition main.dev_a == main.dev_b { true -> checkdevnz(main) _ -> fail(main) }
    }
    state checkdevnz(main: &mut Main) {
        transition main.dev_a == 0 { true -> fail(main) _ -> good(main) }
    }
    state good(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "PASS: ctime recent; two files share a nonzero device\n"); }
    state fail(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "FAIL: ctime/dev\n"); }
}

machine Main::main_macos(main: &mut Main) reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemMetadataQuery + FilesystemNamespaceMutation {
    main.mode = 420;
    main.fd = PosixFilesystemHost::create("/tmp/omega_cd_a.txt", main.mode);
    main.n = PosixFilesystemHost::write(main.fd, "a");
    main.discard = PosixFilesystemHost::close(main.fd);
    main.fd = PosixFilesystemHost::create("/tmp/omega_cd_b.txt", main.mode);
    main.discard = PosixFilesystemHost::close(main.fd);
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_cd_a.txt", &mut main.buffer);
    // carrier note: each little-endian field is assembled in the unsigned
    // carrier of its own width and reinterpreted once at the end, so every
    // shifted byte is Exact-representable: 255 << 24 is 4278190080 against
    // a u32 ceiling of 4294967295, and 255 << 56 is 18374686479671623680
    // against a u64 ceiling of 18446744073709551615. Shifting in the signed
    // carriers reaches the same values against ceilings of 2147483647 and
    // 9223372036854775807, a decision-17 obligation no return range can
    // discharge.
    main.ctime = narrow_u64_to_i64_wrapping(
        widen_u8_to_u64(main.buffer[64])
            | (widen_u8_to_u64(main.buffer[65]) << 8)
            | (widen_u8_to_u64(main.buffer[66]) << 16)
            | (widen_u8_to_u64(main.buffer[67]) << 24)
            | (widen_u8_to_u64(main.buffer[68]) << 32)
            | (widen_u8_to_u64(main.buffer[69]) << 40)
            | (widen_u8_to_u64(main.buffer[70]) << 48)
            | (widen_u8_to_u64(main.buffer[71]) << 56));
    main.dev_a = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[0])
            | (widen_u8_to_u32(main.buffer[1]) << 8)
            | (widen_u8_to_u32(main.buffer[2]) << 16)
            | (widen_u8_to_u32(main.buffer[3]) << 24));
    main.rc = PosixFilesystemHost::read_metadata("/tmp/omega_cd_b.txt", &mut main.buffer);
    main.dev_b = narrow_u32_to_i32_wrapping(
        widen_u8_to_u32(main.buffer[0])
            | (widen_u8_to_u32(main.buffer[1]) << 8)
            | (widen_u8_to_u32(main.buffer[2]) << 16)
            | (widen_u8_to_u32(main.buffer[3]) << 24));
    main.discard = PosixFilesystemHost::remove("/tmp/omega_cd_a.txt");
    main.discard = PosixFilesystemHost::remove("/tmp/omega_cd_b.txt");
    transition main.ctime > 1000000000 { true -> checkdev(main) _ -> fail(main) }
    state checkdev(main: &mut Main) {
        // two files on the same filesystem share a device id
        transition main.dev_a == main.dev_b { true -> checkdevnz(main) _ -> fail(main) }
    }
    state checkdevnz(main: &mut Main) {
        transition main.dev_a == 0 { true -> fail(main) _ -> good(main) }
    }
    state good(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "PASS: ctime recent; two files share a nonzero device\n"); }
    state fail(main: &mut Main) { main.n = PosixFilesystemHost::write(1, "FAIL: ctime/dev\n"); }
}
