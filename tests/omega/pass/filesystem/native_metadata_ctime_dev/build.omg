// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "native_metadata_ctime_dev");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../source/library/std"
    }));
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start_);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start_);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
