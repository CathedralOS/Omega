// Expected exit: 0.
// Expected output contains: PASS: canonicalize follows a real symlink
// Resolve a real file and a distinct symlink to it. Their complete canonical
// absolute paths must agree. This retains the original /tmp symlink pressure
// without assuming that every host spells its target /private/tmp.
use omega_language_std::filesystem;
use omega_language_std::console;

data Main {
    filesystem: Filesystem;
    result: UnitResult;
    target: [u8; 1024];
    alias: [u8; 1024];
}

machine same_canonical_path(left: &[u8; 1024], right: &[u8; 1024]) -> bool {
    transition left[0] == 47 && right[0] == 47 {
        true -> compare(left, right, 0)
        false -> (false)
    }
    machine compare(left: &[u8; 1024], right: &[u8; 1024], position: u64) -> bool {
        transition position < 1024 {
            true -> byte(left, right, position)
            false -> (true)
        }
    }
    machine byte(left: &[u8; 1024], right: &[u8; 1024], position: u64) -> bool
    requires position < 1024;
    {
        transition left[position] == right[position] {
            true -> compare(left, right, position + 1)
            false -> (false)
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.result = block Filesystem::remove(&mut main.filesystem, "/tmp/omega_canon_alias.txt");
    main.result = block Filesystem::remove(&mut main.filesystem, "/tmp/omega_canon_file.txt");
    main.result = block Filesystem::write_all(&mut main.filesystem, "/tmp/omega_canon_file.txt", "canonical");
    transition main.result { UnitResult::Ok -> link(main) _ -> cleanup(main, false) }
    machine link(main: &mut Main) {
        main.result = block Filesystem::symlink(&mut main.filesystem, "/tmp/omega_canon_file.txt", "/tmp/omega_canon_alias.txt");
        transition main.result { UnitResult::Ok -> target(main) _ -> cleanup(main, false) }
    }
    machine target(main: &mut Main) {
        main.result = block Filesystem::canonicalize(&mut main.filesystem, "/tmp/omega_canon_file.txt", &mut main.target);
        transition main.result { UnitResult::Ok -> alias(main) _ -> cleanup(main, false) }
    }
    machine alias(main: &mut Main) {
        main.result = block Filesystem::canonicalize(&mut main.filesystem, "/tmp/omega_canon_alias.txt", &mut main.alias);
        transition main.result { UnitResult::Ok -> compare(main) _ -> cleanup(main, false) }
    }
    machine compare(main: &mut Main) {
        let same: bool = same_canonical_path(&main.target, &main.alias);
        transition { _ -> cleanup(main, same) }
    }
    machine cleanup(main: &mut Main, correct: bool) {
        main.result = block Filesystem::remove(&mut main.filesystem, "/tmp/omega_canon_alias.txt");
        main.result = block Filesystem::remove(&mut main.filesystem, "/tmp/omega_canon_file.txt");
        transition correct { true -> good() false -> bad() }
    }
    machine good() { Console::write_line("PASS: canonicalize follows a real symlink"); }
    machine bad() { Console::write_line("FAIL: canonicalize"); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
