// NATIVE fs canonicalize via realpath (Rust fs::canonicalize). Creates a file
// under /tmp, then canonicalizes its path. On macOS /tmp is a symlink to
// /private/tmp, so realpath resolves the canonical path to "/private/tmp/...".
// The buffer therefore begins "/private/tmp/": buffer[0]=='/', buffer[1]=='p'
// (NOT 't' — that's the resolution proof), buffer[8]=='/'. Proves the realpath
// op lowers and runs on real macOS syscalls, resolving symlinks for real.

use omega_language_std::filesystem_host;

data Main {
    discard: i32;
    mode: i32;
    fd: i32;
    rc: i64;
    b0: u8;
    b1: u8;
    b8: u8;
    n: i64;
    buffer: [u8; 1024];
}

machine Main::main(main: &mut Main) reaches FilesystemHost {
    main.mode = 420;
    main.fd = FilesystemHost::create("/tmp/omega_canon.txt", main.mode);
    main.discard = FilesystemHost::close(main.fd);
    main.rc = FilesystemHost::canonicalize("/tmp/omega_canon.txt", &mut main.buffer);
    main.discard = FilesystemHost::remove("/tmp/omega_canon.txt");
    transition main.rc != 0 { true -> decode(main) _ -> fail(main) }
    state decode(main: &mut Main) {
        // realpath resolves /tmp -> /private/tmp: the canonical path is
        // "/private/tmp/omega_canon.txt".
        main.b0 = main.buffer[0];
        main.b1 = main.buffer[1];
        main.b8 = main.buffer[8];
        transition main.b0 == 47 { true -> checkp(main) _ -> fail(main) }
    }
    state checkp(main: &mut Main) {
        // buffer[1] == 'p' (of "private") proves /tmp was resolved, not left as-is
        transition main.b1 == 112 { true -> checkslash(main) _ -> fail(main) }
    }
    state checkslash(main: &mut Main) {
        transition main.b8 == 47 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) { main.n = FilesystemHost::write(1, "PASS: canonicalize resolves /tmp -> /private/tmp\n"); }
    state fail(main: &mut Main) { main.n = FilesystemHost::write(1, "FAIL: canonicalize\n"); }
}
