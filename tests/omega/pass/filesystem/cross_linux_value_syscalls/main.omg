// Linux raw-filesystem syscall slice. Both targets lower the semantic
// open/open_create operations through openat(AT_FDCWD, ...), preserve
// value-returning read/write/close results, and adapt the portable four-argument
// read_dir seam to Linux getdents64(fd, buffer, count).
// Expected native exit: 70.
use omega::language::std::filesystem_host;
use omega::language::std::filesystem;
use omega::language::std::console;

data Main {
    fs: FilesystemHost;
    semantic_fs: Filesystem;
    console: Console;
    open_result: OpenResult;
    io_result: IoResult;
    unit_result: UnitResult;
    entry_result: DirEntryResult;
    fd: i32;
    rc: i32;
    count: i64;
    position: i64;
    capacity: u64;
    buffer: [u8; 512];
    metadata: [u8; 144];
}

machine Main::main(&mut self) {
    // O_WRONLY | O_CREAT. /dev/null already exists, so this exercises the
    // four-argument openat adapter without leaving a filesystem artifact.
    self.fd = self.fs.open_create("/dev/null", 65, 438);
    transition self.fd >= 0 { true -> write_null() _ -> fail_open_create() }
    state write_null(&mut self) {
        self.count = self.fs.write(self.fd, "omega-linux\n");
        self.rc = self.fs.close(self.fd);
        transition self.count == 12 && self.rc == 0 {
            true -> open_hostname()
            false -> fail_write()
        }
    }
    state open_hostname(&mut self) {
        self.fd = self.fs.open("/etc/hostname", 0);
        transition self.fd >= 0 { true -> stat_hostname() _ -> fail_open() }
    }
    state stat_hostname(&mut self) {
        self.rc = self.fs.read_file_metadata(self.fd, &mut self.metadata);
        transition self.rc == 0 { true -> read_hostname() _ -> fail_stat() }
    }
    state read_hostname(&mut self) {
        self.capacity = 64;
        self.count = self.fs.read(self.fd, &mut self.buffer, self.capacity);
        self.rc = self.fs.close(self.fd);
        transition self.count > 0 && self.rc == 0 {
            true -> open_directory()
            false -> fail_read()
        }
    }
    state open_directory(&mut self) {
        self.fd = self.fs.open("/tmp", 0);
        self.position = 0;
        transition self.fd >= 0 { true -> read_directory() _ -> fail_read_dir() }
    }
    state read_directory(&mut self) {
        self.count = self.fs.read_dir(self.fd, &mut self.buffer, 512, &mut self.position);
        self.rc = self.fs.close(self.fd);
        transition self.count >= 0 && self.rc == 0 { true -> classify_missing() _ -> fail_read_dir() }
    }
    state classify_missing(&mut self) {
        let options: OpenOptions = OpenOptions { read: true };
        self.open_result = self.semantic_fs.open_with("/omega_definitely_absent_linux", options);
        transition self.open_result {
            OpenResult::Error { kind } -> check_missing(kind)
            _ -> fail_error_kind()
        }
    }
    state check_missing(&mut self, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> classify_bad_fd() _ -> fail_error_kind() }
    }
    state classify_bad_fd(&mut self) {
        self.io_result = self.semantic_fs.read(File { fd: -1 }, &mut self.buffer, 1);
        transition self.io_result {
            IoResult::Error { kind } -> check_bad_fd(kind)
            _ -> fail_error_kind()
        }
    }
    state check_bad_fd(&mut self, kind: ErrorKind) {
        transition kind { ErrorKind::BadDescriptor -> remove_missing() _ -> fail_error_kind() }
    }
    state remove_missing(&mut self) {
        self.unit_result = self.semantic_fs.remove("/omega_definitely_absent_linux");
        transition self.unit_result {
            UnitResult::Error { kind } -> check_remove_missing(kind)
            _ -> fail_error_kind()
        }
    }
    state check_remove_missing(&mut self, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> read_missing_directory() _ -> fail_error_kind() }
    }
    state read_missing_directory(&mut self) {
        self.entry_result = self.semantic_fs.read_dir_nth("/omega_definitely_absent_linux", 0);
        transition self.entry_result {
            DirEntryResult::Error { kind } -> check_directory_missing(kind)
            _ -> fail_error_kind()
        }
    }
    state check_directory_missing(&mut self, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> remove_missing_tree() _ -> fail_error_kind() }
    }
    state remove_missing_tree(&mut self) {
        self.unit_result = self.semantic_fs.remove_dir_all("/omega_definitely_absent_linux");
        transition self.unit_result {
            UnitResult::Error { kind } -> check_tree_missing(kind)
            _ -> fail_error_kind()
        }
    }
    state check_tree_missing(&mut self, kind: ErrorKind) {
        transition kind { ErrorKind::NotFound -> good() _ -> fail_error_kind() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state fail_open_create(&mut self) { self.console.exit_process(1); }
    state fail_write(&mut self) { self.console.exit_process(2); }
    state fail_open(&mut self) { self.console.exit_process(3); }
    state fail_read(&mut self) { self.console.exit_process(4); }
    state fail_stat(&mut self) { self.console.exit_process(5); }
    state fail_read_dir(&mut self) { self.console.exit_process(6); }
    state fail_error_kind(&mut self) { self.console.exit_process(7); }
}
