// Expected Windows exit: 70. Preserve the fixed FILETIME-to-Unix calibration
// through a real close/reopen metadata round trip. Native HANDLEs replace the
// legacy CRT descriptor bridge; the fixed timestamp is still assembled from
// the original eight literal bytes, independently of the Unix conversion.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main { handle: u64; bytes: [u8; 8]; }
machine Main::main(main: &mut Main) reaches Console + WindowsFilesystemHost {
    main.handle = WindowsFilesystemHost::create_file("omega_wsft_probe.txt", 1073741824, 7, 2, 128);
    transition main.handle != 0 { true -> seed(main) _ -> bad(main, 71) }
    state seed(main: &mut Main) {
        let written: i64 = WindowsFilesystemHost::write_file(main.handle, "stamp");
        let closed: i32 = WindowsFilesystemHost::close_handle(main.handle);
        transition written == 5 && closed == 0 { true -> reopen(main) _ -> bad(main, 71) }
    }
    state reopen(main: &mut Main) {
        main.handle = WindowsFilesystemHost::create_file("omega_wsft_probe.txt", 3221225472, 7, 3, 128);
        transition main.handle != 0 { true -> stamp(main) _ -> bad(main, 72) }
    }
    state stamp(main: &mut Main) {
        // 131_444_736_000_000_000 ticks = 0x01D2FC4A7CE00000.
        main.bytes[0] = 0; main.bytes[1] = 0;
        main.bytes[2] = 224; main.bytes[3] = 124;
        main.bytes[4] = 74; main.bytes[5] = 252;
        main.bytes[6] = 210; main.bytes[7] = 1;
        let ticks: u64 = widen_u8_to_u64(main.bytes[0])
            | (widen_u8_to_u64(main.bytes[1]) << 8)
            | (widen_u8_to_u64(main.bytes[2]) << 16)
            | (widen_u8_to_u64(main.bytes[3]) << 24)
            | (widen_u8_to_u64(main.bytes[4]) << 32)
            | (widen_u8_to_u64(main.bytes[5]) << 40)
            | (widen_u8_to_u64(main.bytes[6]) << 48)
            | (widen_u8_to_u64(main.bytes[7]) << 56);
        let status: i32 = WindowsFilesystemHost::set_file_time(main.handle, ticks, ticks);
        let closed: i32 = WindowsFilesystemHost::close_handle(main.handle);
        transition status == 0 && closed == 0 { true -> reopen_metadata(main) _ -> bad(main, 73) }
    }
    state reopen_metadata(main: &mut Main) {
        main.handle = WindowsFilesystemHost::create_file("omega_wsft_probe.txt", 2147483648, 7, 3, 128);
        transition main.handle != 0 { true -> metadata(main) _ -> bad(main, 74) }
    }
    state metadata(main: &mut Main) {
        let result: WindowsFileTimeResult = WindowsFilesystemHost::get_file_time(main.handle);
        let closed: i32 = WindowsFilesystemHost::close_handle(main.handle);
        let removed: i32 = WindowsFilesystemHost::delete_file("omega_wsft_probe.txt");
        transition result {
            WindowsFileTimeResult::Value { access_time, write_time } -> decode(main, write_time)
            WindowsFileTimeResult::Error { code } -> bad(main, 74)
        }
    }
    state decode(main: &mut Main, ticks: u64) {
        transition ticks >= 116444736000000000 {
            true -> unix(main, ticks)
            _ -> bad(main, 75)
        }
    }
    state unix(main: &mut Main, ticks: u64) requires ticks >= 116444736000000000 {
        let seconds: u64 = (ticks - 116444736000000000) / 10000000;
        transition seconds == 1500000000 { true -> good(main) _ -> bad(main, 75) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
