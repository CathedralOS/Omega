// RUN CANARY (exit 70, WINDOWS-HOST ONLY) -- the RAW set_file_time seam op
// (windows session slice 4b): kernel32 SetFileTime over the handle bridge
// (_get_osfhandle), the designed signature (handle, NULL-able creation,
// &access FILETIME, &write FILETIME) -> BOOL. The FILETIME is hand-built
// (131444736000000000 = unix 1_500_000_000 at 100ns units since 1601) and
// the STAT ROUND-TRIP pins it end to end: the raw stat reports exactly
// 1_500_000_000 at the windows `_stat64` st_mtime offset (@40) -- the
// hermetic model converts FILETIME -> unix seconds through the same
// calibration constants, so a slip on either side breaks its engine.
// The WRAPPER `set_times` path has its own end-to-end canary; this raw pin
// keeps the admitted seam and FILETIME calibration independently honest.
// exits: 70 good; 71 setup failed; 72 the bridge returned no handle; 73
// SetFileTime refused; 74 stat failed; 75 the round-tripped mtime is
// wrong (a FILETIME calibration slip).

use omega_language_std::filesystem_host;

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Main {
    fd: i32;
    n: i64;
    rc64: i32;
    ft: [u8; 8];
    stat_buf: [u8; 144];
    mtime: i64;
}

machine Main::main(main: &mut Main) reaches Console + FilesystemHost {
    // Seed and CLOSE first: a pending write flushed by a later close would
    // update mtime past the stamp (both engines model this). The stamp
    // rides a clean read-write reopen.
    main.fd = FilesystemHost::create("omega_wsft_probe.txt", 438);
    main.n = FilesystemHost::write(main.fd, "stamp");
    let closed_create: i32 = FilesystemHost::close(main.fd);
    main.fd = FilesystemHost::open("omega_wsft_probe.txt", 2);
    transition main.fd >= 0 { true -> bridge(main) _ -> bad(main, 71) }
    state bridge(main: &mut Main) {
        let handle: i64 = FilesystemHost::get_osfhandle(main.fd);
        transition handle > 0 { true -> stamp(main, handle) _ -> bad(main, 72) }
    }
    state stamp(main: &mut Main, handle: i64) {
        // FILETIME for unix 1_500_000_000: 131_444_736_000_000_000
        // = 0x01D2FC4A7CE00000, little-endian bytes 00 00 E0 7C 4A FC D2 01.
        main.ft[0] = 0;
        main.ft[1] = 0;
        main.ft[2] = 224;
        main.ft[3] = 124;
        main.ft[4] = 74;
        main.ft[5] = 252;
        main.ft[6] = 210;
        main.ft[7] = 1;
        let rc: i32 = FilesystemHost::set_file_time(handle, 0, &main.ft, &main.ft);
        let closed_probe: i32 = FilesystemHost::close(main.fd);
        transition rc != 0 { true -> restat(main) _ -> bad(main, 73) }
    }
    state restat(main: &mut Main) {
        main.rc64 = FilesystemHost::read_metadata("omega_wsft_probe.txt", &mut main.stat_buf);
        let removed: i32 = FilesystemHost::remove("omega_wsft_probe.txt");
        transition main.rc64 == 0 { true -> decode(main) _ -> bad(main, 74) }
    }
    state decode(main: &mut Main) {
        // Windows `_stat64` st_mtime @40, pinned by the target StatLayout.
        // carrier note: the little-endian field is assembled in `u64` and
        // reinterpreted once at the landing, so every shifted byte is
        // Exact-representable: 255 << 56 is 18374686479671623680 against a u64
        // ceiling of 18446744073709551615. Shifting in `i64` reaches the same
        // 18374686479671623680 against a ceiling of 9223372036854775807, which
        // is a decision-17 obligation no return range can discharge.
        main.mtime = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(main.stat_buf[40])
                | (widen_u8_to_u64(main.stat_buf[41]) << 8)
                | (widen_u8_to_u64(main.stat_buf[42]) << 16)
                | (widen_u8_to_u64(main.stat_buf[43]) << 24)
                | (widen_u8_to_u64(main.stat_buf[44]) << 32)
                | (widen_u8_to_u64(main.stat_buf[45]) << 40)
                | (widen_u8_to_u64(main.stat_buf[46]) << 48)
                | (widen_u8_to_u64(main.stat_buf[47]) << 56));
        transition main.mtime == 1500000000 { true -> good(main) _ -> bad(main, 75) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
