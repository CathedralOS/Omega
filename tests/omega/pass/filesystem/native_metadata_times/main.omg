// NATIVE fs Metadata times (Rust Metadata::accessed/modified/created). Creates a
// file, stat's it, and decodes st_atimespec.tv_sec (@32), st_mtimespec.tv_sec
// (@48), and st_birthtimespec.tv_sec (@80) by i64 byte-assembly. A just-created
// file has all three as real recent timestamps (> 1_000_000_000, i.e. after
// 2001). Exercises the stat op + three independent i64 byte-assemblies on real
// macOS syscalls.

use omega_language_std::filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    fs: FilesystemHost;
    mode: i32;
    floor: i64;
    fd: i32;
    rc: i32;
    atime: i64;
    mtime: i64;
    btime: i64;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(&mut self) reaches FilesystemHost {
    self.mode = 420;
    self.floor = 1000000000;
    self.fd = self.fs.create("/tmp/omega_times.txt", self.mode);
    self.n = self.fs.write(self.fd, "t");
    self.n = self.fs.close(self.fd);
    self.rc = self.fs.read_metadata("/tmp/omega_times.txt", &mut self.buffer);
    self.n = self.fs.remove("/tmp/omega_times.txt");
    transition self.rc == 0 { true -> decode() _ -> fail() }
    state decode(&mut self) {
        // carrier note: the little-endian field is assembled in `u64` and
        // reinterpreted once at the end, so every shifted byte is
        // Exact-representable: 255 << 56 is 18374686479671623680 against a u64
        // ceiling of 18446744073709551615. Shifting in `i64` reaches the same
        // 18374686479671623680 against a ceiling of 9223372036854775807, which
        // is a decision-17 obligation no return range can discharge.
        self.atime = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(self.buffer[32])
                | (widen_u8_to_u64(self.buffer[33]) << 8)
                | (widen_u8_to_u64(self.buffer[34]) << 16)
                | (widen_u8_to_u64(self.buffer[35]) << 24)
                | (widen_u8_to_u64(self.buffer[36]) << 32)
                | (widen_u8_to_u64(self.buffer[37]) << 40)
                | (widen_u8_to_u64(self.buffer[38]) << 48)
                | (widen_u8_to_u64(self.buffer[39]) << 56));
        self.mtime = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(self.buffer[48])
                | (widen_u8_to_u64(self.buffer[49]) << 8)
                | (widen_u8_to_u64(self.buffer[50]) << 16)
                | (widen_u8_to_u64(self.buffer[51]) << 24)
                | (widen_u8_to_u64(self.buffer[52]) << 32)
                | (widen_u8_to_u64(self.buffer[53]) << 40)
                | (widen_u8_to_u64(self.buffer[54]) << 48)
                | (widen_u8_to_u64(self.buffer[55]) << 56));
        self.btime = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(self.buffer[80])
                | (widen_u8_to_u64(self.buffer[81]) << 8)
                | (widen_u8_to_u64(self.buffer[82]) << 16)
                | (widen_u8_to_u64(self.buffer[83]) << 24)
                | (widen_u8_to_u64(self.buffer[84]) << 32)
                | (widen_u8_to_u64(self.buffer[85]) << 40)
                | (widen_u8_to_u64(self.buffer[86]) << 48)
                | (widen_u8_to_u64(self.buffer[87]) << 56));
        transition self.atime > self.floor { true -> checkm() _ -> fail() }
    }
    state checkm(&mut self) {
        transition self.mtime > self.floor { true -> checkb() _ -> fail() }
    }
    state checkb(&mut self) {
        transition self.btime > self.floor { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: stat decodes real atime/mtime/birthtime\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: metadata times\n"); }
}
