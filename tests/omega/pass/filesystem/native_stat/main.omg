// NATIVE fs metadata via stat (Rust fs::metadata). Creates a 10-byte file, then
// read_metadata fills a 144-byte struct stat, and Omega decodes st_size (i64 at
// offset 96) and st_mode (u16 at offset 4) by little-endian byte-assembly. A
// regular file must report len 10 and is_dir false ((st_mode & S_IFMT) !=
// S_IFDIR). Proves the stat op + native byte-assembly on real macOS syscalls.

use omega_language_std::filesystem_host;
use omega::language::core::numeric_conversion;

data Main {
    fs: FilesystemHost;
    mode: i32;
    fd: i32;
    rc: i32;
    len: i64;
    st_mode: i32;
    is_dir: bool;
    n: i64;
    buffer: [u8; 144];
}

machine Main::main(&mut self) reaches FilesystemHost {
    self.mode = 420;
    self.fd = self.fs.create("/tmp/omega_stat.txt", self.mode);
    self.n = self.fs.write(self.fd, "1234567890");
    self.n = self.fs.close(self.fd);
    self.rc = self.fs.read_metadata("/tmp/omega_stat.txt", &mut self.buffer);
    self.n = self.fs.remove("/tmp/omega_stat.txt");
    transition self.rc == 0 { true -> decode() _ -> fail() }
    state decode(&mut self) {
        // carrier note: the little-endian field is assembled in `u64` and
        // reinterpreted once at the end, so every shifted byte is
        // Exact-representable: 255 << 56 is 18374686479671623680 against a u64
        // ceiling of 18446744073709551615. Shifting in `i64` reaches the same
        // 18374686479671623680 against a ceiling of 9223372036854775807, which
        // is a decision-17 obligation no return range can discharge.
        self.len = narrow_u64_to_i64_wrapping(
            widen_u8_to_u64(self.buffer[96])
                | (widen_u8_to_u64(self.buffer[97]) << 8)
                | (widen_u8_to_u64(self.buffer[98]) << 16)
                | (widen_u8_to_u64(self.buffer[99]) << 24)
                | (widen_u8_to_u64(self.buffer[100]) << 32)
                | (widen_u8_to_u64(self.buffer[101]) << 40)
                | (widen_u8_to_u64(self.buffer[102]) << 48)
                | (widen_u8_to_u64(self.buffer[103]) << 56));
        self.st_mode =
            widen_u8_to_i32(self.buffer[4]) | (widen_u8_to_i32(self.buffer[5]) << 8);
        self.is_dir = (self.st_mode & 61440) == 16384;
        transition self.len == 10 { true -> checkkind() _ -> fail() }
    }
    state checkkind(&mut self) {
        transition self.is_dir { true -> fail() _ -> good() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: stat decodes len 10, is_dir false\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: stat\n"); }
}
