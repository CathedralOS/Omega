// FULL NATIVE std::fs CRUD round-trip — RUNS end-to-end on real macOS syscalls.
// Running the emitted mach-o prints
//   "PASS: native fs CRUD round-trip (create+write+read 17B+close+remove)"
// and the file is created (0644) then deleted.
//
// The raw boundary `PosixFilesystemHost` is VALUE-RETURNING with HUMAN method names
// (create/open/read/write/close/remove) — the ugly libc spellings (_creat,
// _unlink) live only in the darwin binding table. `create` maps to `_creat`
// (not `_open`) because open's mode is variadic (stack-passed on arm64);
// creat's mode is a register parameter. Lowered via the aarch64 value-returning
// host-call primitive. Read count is captured in `rn` BEFORE close overwrites
// `n`. NOT registered in ACTIVE_PASS_CANARIES yet (canary_suite.rs is hot).

use omega_language_std::posix_filesystem_host;

data Main {
    discard: i32;
    mode: i32;
    read_flags: i32;
    cap: u64;
    fd: i32;
    n: i64;
    rn: i64;
    buffer: [u8; 64];
}

machine Main::main(main: &mut Main) reaches PosixFilesystemHost {
    main.mode = 420;
    main.read_flags = 0;
    main.cap = 64;
    main.fd = PosixFilesystemHost::create("/tmp/omega_crud.txt", main.mode);
    transition main.fd >= 0 { true -> wrote(main) _ -> fail(main) }
    state wrote(main: &mut Main) {
        main.n = PosixFilesystemHost::write(main.fd, "omega end to end\n");
        main.discard = PosixFilesystemHost::close(main.fd);
        main.fd = PosixFilesystemHost::open("/tmp/omega_crud.txt", main.read_flags);
        transition main.fd >= 0 { true -> rd(main) _ -> fail(main) }
    }
    state rd(main: &mut Main) {
        main.rn = PosixFilesystemHost::read(main.fd, &mut main.buffer, main.cap);
        main.discard = PosixFilesystemHost::close(main.fd);
        transition main.rn == 17 { true -> good(main) _ -> fail(main) }
    }
    state good(main: &mut Main) {
        main.n = PosixFilesystemHost::write(1, "PASS: native fs CRUD round-trip (create+write+read 17B+close+remove)\n");
        main.discard = PosixFilesystemHost::remove("/tmp/omega_crud.txt");
    }
    state fail(main: &mut Main) {
        main.n = PosixFilesystemHost::write(1, "FAIL\n");
        main.discard = PosixFilesystemHost::remove("/tmp/omega_crud.txt");
    }
}
