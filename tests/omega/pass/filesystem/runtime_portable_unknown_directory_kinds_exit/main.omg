// Expected exit: 0. A real directory provider withholds every d_type hint.
// Portable enumeration still distinguishes a directory, file and symlink;
// recursive removal must remove the tree without following the outside link.
use omega_language_std::filesystem;
use omega_language_std::posix_filesystem_host;
use omega_language_std::console;
use omega::language::core::numeric_conversion;

UnknownDirectoryEntries satisfies PosixFilesystemHost {
    machine open(path: &[u8] in Path, flags: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemImplementation::open(path, flags)
    }

    machine open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemImplementation::open_create(path, flags, mode)
    }

    machine create(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemImplementation::create(path, mode)
    }

    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemContentRead {
        PosixFilesystemImplementation::read(fd, buffer, count)
    }

    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite {
        PosixFilesystemImplementation::write(fd, bytes)
    }

    machine read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64 reaches FilesystemContentRead {
        PosixFilesystemImplementation::read_at(fd, buffer, count, offset)
    }

    machine write_at(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite {
        PosixFilesystemImplementation::write_at(fd, bytes, offset)
    }

    machine close(fd: i32) -> i32 {
        PosixFilesystemImplementation::close(fd)
    }

    machine remove(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::remove(path)
    }

    machine seek(fd: i32, offset: i64, whence: i32) -> i64 {
        PosixFilesystemImplementation::seek(fd, offset, whence)
    }

    machine create_dir(path: &[u8] in Path, mode: i32) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemImplementation::create_dir(path, mode)
    }

    machine remove_dir(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::remove_dir(path)
    }

    machine create_dir_name(name: &[u8], mode: i32) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemImplementation::create_dir_name(name, mode)
    }

    machine open_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        PosixFilesystemImplementation::open_at(dirfd, name, flags)
    }

    machine unlink_at(dirfd: i32, name: &[u8], flags: i32) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::unlink_at(dirfd, name, flags)
    }

    machine set_permissions(path: &[u8] in Path, mode: u32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemImplementation::set_permissions(path, mode)
    }

    machine set_file_permissions(fd: i32, mode: u32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemImplementation::set_file_permissions(fd, mode)
    }

    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::rename(from, to)
    }

    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::hard_link(original, link)
    }

    machine symlink(target: &[u8] in Path, link: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::symlink(target, link)
    }

    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemMetadataQuery {
        PosixFilesystemImplementation::read_link(path, buffer, count)
    }

    machine read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64 reaches DirectoryEnumeration {
        with_unknown_directory_kinds(fd, buffer, count, position)
    }

    machine remove_name(path: &[u8]) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::remove_name(path)
    }

    machine remove_dir_name(path: &[u8]) -> i32 reaches FilesystemNamespaceMutation {
        PosixFilesystemImplementation::remove_dir_name(path)
    }

    machine read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemImplementation::read_metadata(path, buffer)
    }

    machine read_file_metadata(fd: i32, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemImplementation::read_file_metadata(fd, buffer)
    }

    machine read_symlink_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemImplementation::read_symlink_metadata(path, buffer)
    }

    machine read_metadata_at(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32 reaches FilesystemMetadataQuery {
        PosixFilesystemImplementation::read_metadata_at(directory_descriptor, name, buffer, flags)
    }

    machine set_len(fd: i32, length: i64) -> i32 reaches FilesystemContentWrite + FilesystemMetadataMutation {
        PosixFilesystemImplementation::set_len(fd, length)
    }

    machine set_file_times(fd: i32, times: &[u8]) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemImplementation::set_file_times(fd, times)
    }

    machine sync(fd: i32) -> i32 {
        PosixFilesystemImplementation::sync(fd)
    }

    machine sync_data(fd: i32) -> i32 {
        PosixFilesystemImplementation::sync_data(fd)
    }

    machine duplicate(fd: i32) -> i32 {
        PosixFilesystemImplementation::duplicate(fd)
    }

    machine lock_file(fd: i32, operation: i32) -> i32 {
        PosixFilesystemImplementation::lock_file(fd, operation)
    }

    machine change_owner(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemImplementation::change_owner(path, uid, gid)
    }

    machine change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemImplementation::change_owner_no_follow(path, uid, gid)
    }

    machine change_file_owner(fd: i32, uid: i32, gid: i32) -> i32 reaches FilesystemMetadataMutation {
        PosixFilesystemImplementation::change_file_owner(fd, uid, gid)
    }
}

machine with_unknown_directory_kinds(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64
reaches DirectoryEnumeration
{
    let total: i64 = PosixFilesystemImplementation::read_dir(fd, buffer, count, position);
    transition total > 0 && total <= 512 { true -> bounded(buffer, total) _ -> total }
    state bounded(buffer: &mut [u8], total: i64) -> i64 requires total > 0; {
        let length: u64 = narrow_i64_to_u64_exact(total);
        transition { _ -> walk(buffer, total, length, 0) }
    }
    state walk(buffer: &mut [u8], total: i64, length: u64, offset: u64) -> i64 {
        transition offset < length { true -> header(buffer, total, length, offset) _ -> total }
    }
    state header(buffer: &mut [u8], total: i64, length: u64, offset: u64) -> i64 {
        transition offset < 489 && offset + 17 < buffer.len {
            true -> record(buffer, total, length, offset) _ -> -5
        }
    }
    state record(buffer: &mut [u8], total: i64, length: u64, offset: u64) -> i64
    requires offset < 489, offset + 17 < buffer.len;
    {
        let low: u64 = widen_u8_to_u64(buffer[offset + 16]);
        let high: u64 = widen_u8_to_u64(buffer[offset + 17]);
        let record_length: u64 = low | (high << 8);
        transition record_length >= 24 && record_length <= 512 - offset {
            true -> clear(buffer, total, length, offset, record_length) _ -> -5
        }
    }
    state clear(buffer: &mut [u8], total: i64, length: u64, offset: u64, record_length: u64) -> i64
    requires offset < 489, record_length <= 512 - offset;
    {
        let kind_offset: u64 = offset + directory_kind_offset();
        transition kind_offset < buffer.len {
            true -> store(buffer, total, length, offset, record_length, kind_offset) _ -> -5
        }
    }
    state store(buffer: &mut [u8], total: i64, length: u64, offset: u64, record_length: u64, kind_offset: u64) -> i64
    requires kind_offset < buffer.len, offset < 489, record_length <= 512 - offset;
    {
        buffer[kind_offset] = 0;
        transition { _ -> walk(buffer, total, length, offset + record_length) }
    }
}
linux_x86_64 machine directory_kind_offset() -> u64[18..=20] { 18 }
linux_arm64 machine directory_kind_offset() -> u64[18..=20] { 18 }
macos_arm64 machine directory_kind_offset() -> u64[18..=20] { 20 }

data Main { filesystem: Filesystem; index: u64 in Wrapping; seen: u32; }
machine Main::main(main: &mut Main) reaches Console {
    let result: UnitResult = Filesystem::create_dir_all(&mut main.filesystem, "omega_unknown_kinds/sub");
    transition result { UnitResult::Ok -> payload(main) _ -> bad(10) }
    state payload(main: &mut Main) {
        let result: UnitResult = Filesystem::write_all(&mut main.filesystem, "omega_unknown_kinds/sub/file", "contents");
        transition result { UnitResult::Ok -> outside(main) _ -> bad(11) }
    }
    state outside(main: &mut Main) {
        let result: UnitResult = Filesystem::create_dir(&mut main.filesystem, "omega_unknown_outside");
        transition result { UnitResult::Ok -> outside_file(main) _ -> bad(12) }
    }
    state outside_file(main: &mut Main) {
        let result: UnitResult = Filesystem::write_all(&mut main.filesystem, "omega_unknown_outside/keep", "keep");
        transition result { UnitResult::Ok -> link(main) _ -> bad(13) }
    }
    state link(main: &mut Main) {
        let result: UnitResult = Filesystem::symlink(&mut main.filesystem, "../omega_unknown_outside", "omega_unknown_kinds/link");
        transition result { UnitResult::Ok -> read(main) _ -> bad(14) }
    }
    state read(main: &mut Main) {
        let result: DirEntryResult = Filesystem::read_dir_nth(&mut main.filesystem, "omega_unknown_kinds", main.index as u64);
        transition result { DirEntryResult::Ok { entry } -> classify(main, entry) DirEntryResult::End -> listed(main) _ -> bad(15) }
    }
    state classify(main: &mut Main, entry: DirEntry) {
        transition {
            entry.name_len == 3 && entry.name[0] == 115 && entry.is_dir && !entry.is_file -> directory(main)
            entry.name_len == 4 && entry.name[0] == 108 && !entry.is_dir && !entry.is_file -> symlink(main)
            _ -> bad(16)
        }
    }
    state directory(main: &mut Main) { main.seen = main.seen | 1; transition { _ -> next(main) } }
    state symlink(main: &mut Main) { main.seen = main.seen | 2; transition { _ -> next(main) } }
    state next(main: &mut Main) {
        main.index += 1;
        transition main.index <= 2 { true -> read(main) _ -> bad(17) }
    }
    state listed(main: &mut Main) {
        transition main.index == 2 && main.seen == 3 { true -> read_file(main) _ -> bad(18) }
    }
    state read_file(main: &mut Main) {
        let result: DirEntryResult = Filesystem::read_dir_nth(&mut main.filesystem, "omega_unknown_kinds/sub", 0);
        transition result { DirEntryResult::Ok { entry } -> file_kind(main, entry) _ -> bad(19) }
    }
    state file_kind(main: &mut Main, entry: DirEntry) {
        transition entry.is_file && !entry.is_dir { true -> remove(main) _ -> bad(20) }
    }
    state remove(main: &mut Main) {
        let result: UnitResult = Filesystem::remove_dir_all(&mut main.filesystem, "omega_unknown_kinds");
        transition result { UnitResult::Ok -> preserved(main) _ -> bad(21) }
    }
    state preserved(main: &mut Main) {
        let present: bool = Filesystem::exists(&mut main.filesystem, "omega_unknown_outside/keep");
        let removed: bool = Filesystem::exists(&mut main.filesystem, "omega_unknown_kinds");
        transition present && !removed { true -> cleanup(main) _ -> bad(22) }
    }
    state cleanup(main: &mut Main) {
        let result: UnitResult = Filesystem::remove_dir_all(&mut main.filesystem, "omega_unknown_outside");
        transition result { UnitResult::Ok -> short_output() _ -> bad(23) }
    }
    state short_output() {
        let refused: bool = metadata_at_refuses_short_output();
        transition refused { true -> good() _ -> bad(24) }
    }
    state good() { Console::exit_process(0); }
    state bad(code: i32) { Console::exit_process(code); }
}

machine metadata_at_refuses_short_output() -> bool reaches FilesystemMetadataQuery {
    let mut buffer: [u8; 8];
    buffer[0] = 91;
    buffer[7] = 92;
    // EBADF would show that the OS was reached before the storage check.
    let result: i32 = PosixFilesystemHost::read_metadata_at(-1, "missing", &mut buffer, 0);
    result == -22 && buffer[0] == 91 && buffer[7] == 92
}
