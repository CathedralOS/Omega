// Expected exit: 70 (Windows). Metadata observes a pinned native file object,
// preserves the caller's cursor/handle, returns genuine length/link/time facts,
// distinguishes directories, and fails closed for an invalid handle.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;
use omega::language::core::filesystem_authority;
use omega::language::core::external_binding;

// Independent producer of a valid non-disk HANDLE. The raw metadata service
// must classify it before entering a native query that excludes pipes.
boundary trait FixturePipe {
    machine create(read: &mut u64, write: &mut u64, security: u64, size: u32) -> i32
    reaches
    requires security == 0 && size == 0
    blocks;
}
data FixturePipeImports {}
windows_x86_64 machine fixture_pipe_binding() -> ForeignBinding<12, 10, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "CreatePipe"
    } }
}
windows_x86_64 machine FixturePipeImports::create(read: &mut u64, write: &mut u64, security: u64, size: u32) -> i32
satisfies FixturePipe::create via fixture_pipe_binding()
requires security == 0 && size == 0
blocks;

data Main { handle: u64; pipe_read: u64; pipe_write: u64; buffer: [u8; 8]; status: i32; }

machine Main::main(main: &mut Main)
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let untouched: WindowsMetadataResult;
    transition untouched {
        WindowsMetadataResult::Error { code } -> invalid(main, code)
        _ -> bad(71)
    }
    state invalid(main: &mut Main, code: u32) {
        transition code == 0 { true -> query_invalid(main) _ -> bad(71) }
    }
    state query_invalid(main: &mut Main) {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(0);
        transition outcome {
            WindowsMetadataResult::Error { code } -> refused(main, code)
            _ -> bad(72)
        }
    }
    state refused(main: &mut Main, code: u32) {
        transition code == 6 { true -> pipe(main) _ -> bad(72) }
    }
    state pipe(main: &mut Main) {
        let succeeded: i32 = block FixturePipe::create(&mut main.pipe_read, &mut main.pipe_write, 0, 0);
        transition succeeded != 0 { true -> inspect_pipe(main) _ -> bad(87) }
    }
    state inspect_pipe(main: &mut Main) {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(main.pipe_read);
        transition outcome {
            WindowsMetadataResult::Error { code } -> refused_pipe(main, code)
            _ -> bad(88)
        }
    }
    state refused_pipe(main: &mut Main, code: u32) {
        transition code == 50 { true -> close_pipe(main) _ -> bad(88) }
    }
    state close_pipe(main: &mut Main) {
        let read_closed: i32 = block WindowsFilesystemHost::close_handle(main.pipe_read);
        let write_closed: i32 = block WindowsFilesystemHost::close_handle(main.pipe_write);
        transition read_closed == 0 && write_closed == 0 { true -> create(main) _ -> bad(89) }
    }
    state create(main: &mut Main) {
        main.handle = block WindowsFilesystemHost::create_file("omega_raw_metadata.txt", 3221225472, 7, 2, 128);
        transition main.handle != 0 { true -> write(main) _ -> bad(73) }
    }
    state write(main: &mut Main) {
        let count: i64 = block WindowsFilesystemHost::write_file(main.handle, "metadata");
        transition count == 8 { true -> inspect(main) _ -> bad(74) }
    }
    state inspect(main: &mut Main) {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(main.handle);
        transition outcome {
            WindowsMetadataResult::Value { metadata } -> checked(main, metadata)
            _ -> bad(75)
        }
    }
    state checked(main: &mut Main, metadata: WindowsFileMetadata) {
        transition metadata.length == 8 && metadata.links > 0
            && (metadata.attributes & 16) == 0 && metadata.creation_ticks > 0
            && metadata.write_ticks > 0 && metadata.change_ticks > 0 {
            true -> cursor(main)
            _ -> bad(76)
        }
    }
    state cursor(main: &mut Main) {
        let position: i64 = block WindowsFilesystemHost::set_file_pointer(main.handle, 0, 1);
        transition position == 8 { true -> rewind(main) _ -> bad(77) }
    }
    state rewind(main: &mut Main) {
        let position: i64 = block WindowsFilesystemHost::set_file_pointer(main.handle, 0, 0);
        let count: i64 = block WindowsFilesystemHost::read_file(main.handle, &mut main.buffer, 8);
        transition position == 0 && count == 8 && main.buffer[0] == 109 && main.buffer[7] == 97 {
            true -> close_file(main)
            _ -> bad(78)
        }
    }
    state close_file(main: &mut Main) {
        main.status = block WindowsFilesystemHost::close_handle(main.handle);
        transition main.status == 0 { true -> inspect_path(main) _ -> bad(79) }
    }
    state inspect_path(main: &mut Main) {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::read_metadata("omega_raw_metadata.txt", false);
        transition outcome {
            WindowsMetadataResult::Value { metadata } -> checked_path(main, metadata)
            _ -> bad(90)
        }
    }
    state checked_path(main: &mut Main, metadata: WindowsFileMetadata) {
        transition metadata.length == 8 && (metadata.attributes & 16) == 0 {
            true -> missing_path(main)
            _ -> bad(90)
        }
    }
    state missing_path(main: &mut Main) {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::read_metadata("omega_raw_metadata_missing.txt", false);
        transition outcome {
            WindowsMetadataResult::Error { code } -> refused_missing(main, code)
            _ -> bad(91)
        }
    }
    state refused_missing(main: &mut Main, code: u32) {
        transition code == 2 { true -> directory(main) _ -> bad(91) }
    }
    state directory(main: &mut Main) {
        main.status = block WindowsFilesystemHost::create_directory("omega_raw_metadata_dir");
        transition main.status == 0 { true -> open_directory(main) _ -> bad(80) }
    }
    state open_directory(main: &mut Main) {
        // FILE_READ_ATTRIBUTES; FILE_FLAG_BACKUP_SEMANTICS opens a directory.
        main.handle = block WindowsFilesystemHost::create_file("omega_raw_metadata_dir", 128, 7, 3, 33554432);
        transition main.handle != 0 { true -> inspect_directory(main) _ -> bad(81) }
    }
    state inspect_directory(main: &mut Main) {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(main.handle);
        transition outcome {
            WindowsMetadataResult::Value { metadata } -> checked_directory(main, metadata)
            _ -> bad(82)
        }
    }
    state checked_directory(main: &mut Main, metadata: WindowsFileMetadata) {
        transition (metadata.attributes & 16) != 0 { true -> cleanup(main) _ -> bad(83) }
    }
    state cleanup(main: &mut Main) {
        main.status = block WindowsFilesystemHost::close_handle(main.handle);
        transition main.status == 0 { true -> remove_file(main) _ -> bad(84) }
    }
    state remove_file(main: &mut Main) {
        main.status = block WindowsFilesystemHost::delete_file("omega_raw_metadata.txt");
        transition main.status == 0 { true -> remove_directory(main) _ -> bad(85) }
    }
    state remove_directory(main: &mut Main) {
        main.status = block WindowsFilesystemHost::remove_directory("omega_raw_metadata_dir");
        transition main.status == 0 { true -> good() _ -> bad(86) }
    }
    state good() { Console::exit_process(70); }
    state bad(code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
