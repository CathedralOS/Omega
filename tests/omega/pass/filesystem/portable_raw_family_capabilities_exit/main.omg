// Expected exit: 0. The portable sink writes exactly "capabilities" without
// making callers declare either raw operating-system family's service identity.
use omega::language::core::FilesystemContentRead;
use omega::language::core::FilesystemContentWrite;
use omega::language::core::FilesystemMetadataMutation;
use omega::language::core::FilesystemNamespaceMutation;
use wav_output::wav_output::WavOutput;

machine main()
reaches WavOutput + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
crashes Trap
{
    let written: i64 = block WavOutput::write_wav("omega_portable_capabilities.txt", "capabilities");
    transition written == 12 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
