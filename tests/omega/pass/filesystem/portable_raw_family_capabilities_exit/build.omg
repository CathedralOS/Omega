machine build(builder: &mut Build) {
    Build::application(builder, "portable_raw_family_capabilities_exit");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../source/library/std"
    }));
    let wav_output_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../samples/cli/audio/wav_output"
    }));
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
