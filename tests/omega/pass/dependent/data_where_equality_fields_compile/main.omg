// A `data where` clause may require two fields equal: `Mirror` is valid
// only while `left == right`. Equal literals prove the bound at
// construction; the invariant holds the pair in lockstep.
data Mirror
requires
    left == right,
{
    left: u64;
    right: u64;
}

data Main { mirror: Mirror; }

machine Main::main(main: &mut Main) {
    main.mirror = Mirror { left: 9, right: 9 };
}
