// RUN CANARY (exit 2) + interpreter differential. The R1 relational
// SUBTRACTION rule (the one closed rule interval arithmetic cannot
// express): `main.count - i` with `i: u32, requires param <= main.count` proves
// non-negative in EXACT u32 -- the dependent atom `i <= count` gives
// `count - i >= 0` (the capacity-minus-used idiom; the exclusive sugar's
// -1 offset gives `>= 1`). Refinement lives in the decision-17 overflow
// analysis (arithmetic_domains refine_dependent_subtract), write-fenced
// like every entry-fact bridge: a mid-state write to the field or any
// opaque call defeats it (fail/dependent/
// dependent_subtract_after_write_rejected), and the FLIPPED direction
// (`i - main.count`) stays refused (probed -- underflow is real there).
// exits: 8 - 6 = 2.
use omega_language_std::console;
use omega::language::core::binding;
data Main where count <= 11 { console: Binding<Console>; count: u32; j: u32; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.count = 8;
    main.j = 6;
    transition main.j <= main.count { true -> read(main) _ -> bad(main) }
    state read(main: &mut Main)
        requires main.j <= main.count
    {
        let remaining: u32 = main.count - main.j;
        main.out = remaining as i32;
        main.console.exit_process(main.out);
    }
    state bad(main: &mut Main) { main.console.exit_process(9); }
}
