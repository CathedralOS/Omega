// A `data where` conjunct may use `&&` inside one fact: `Ladder` is
// valid only while `a <= b && b <= c` — a three-field ascending chain
// written as a single boolean expression.
data Ladder
requires
    a <= b && b <= c,
{
    a: u64;
    b: u64;
    c: u64;
}

data Main { ladder: Ladder; }

machine Main::main(main: &mut Main) {
    main.ladder = Ladder { a: 1, b: 2, c: 3 };
}
