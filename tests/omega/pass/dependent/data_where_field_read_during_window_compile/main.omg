// R2 read precision: reading one scalar field does not consume the record-level
// coupling, so the adjacent repair may still close the window.
data Map
where
    start <= end,
{
    start: i32;
    end: i32;
}

machine Map::repair(map: &mut Map) {
    map.start = 10;
    let old_end: i32 = map.end;
    map.end = 10;
}

data Main {
}

machine Main::main() {
}
