// A `data where` bound may be an arithmetic expression: `Pair` is valid
// only while `left + right <= 12` — the fact reasons over a computed
// operand, not just a bare field.
data Pair
requires
    left + right <= 12,
{
    left: u64;
    right: u64;
}

data Main { pair: Pair; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { left: 5, right: 6 };
}
