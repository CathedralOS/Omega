// R5 default-domain frame: the predecessor proves an exact valuation for
// main.pair. A known sibling call writes only other, so the transported
// right == 20 witness survives and proves that left = 15 restores left <= right.
data Pair
where
    left <= right,
{
    left: i32;
    right: i32;
}

data Main {
    pair: Pair;
}

machine Main::main(main: &mut Main) {
    main.pair.right = 20;
    transition { _ -> update(main) }

    state update(main: &mut Main) {
        Main::touch_other();
        main.pair.left = 15;
    }
}

machine Main::touch_other() {
    let mut other: i32 = 1;
}
