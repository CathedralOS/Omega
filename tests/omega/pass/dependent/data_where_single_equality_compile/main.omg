// A `data where` clause may pin a field to one exact value: `Unit` is
// valid only while `step == 1` — a single-point domain. The literal `1`
// constructs.
data Unit
requires
    step == 1,
{
    step: u64;
}

data Main { unit: Unit; }

machine Main::main(main: &mut Main) {
    main.unit = Unit { step: 1 };
}
