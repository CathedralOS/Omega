// RUN CANARY (exit 70) + interpreter differential. The R0 x R1a
// COMPOSITION (ch12's working shape): dependent-ranged state params feed
// the row-major product index directly --
//   state read(&mut self, y: u32 [0..=self.rows], x: u32 [0..=self.cols])
//       { ... self.pixels[y * 4 + x] ... }
// with RUNTIME arguments (nothing folds): the caller's guard proves the
// dependent obligations, decision-17's overflow proof and the computed-
// index hoist BOTH read the params' intervals SUBSTITUTED through the
// named fields' store-enforced literal ranges (rows<=2, cols<=3 =>
// y*4+x in [0..=11] < 12), and the hoisted temp indexes by slot. A wider
// field range that breaks the product ([0..=4] cols -> top 12) refuses
// with the clean cannot-prove error (probed).
// exits: 71 = the composed read delivered the wrong element.
use omega_language_std::console;
data Main {
    console: Console;
    pixels: [u8; 12];
    rows: u32 [0..=2];
    cols: u32 [0..=3];
    j: u32;
    k: u32;
}
machine Main::main(&mut self) {
    self.rows = 2;
    self.cols = 3;
    self.j = 2;
    self.k = 3;
    self.pixels[11] = 7;
    transition self.j <= self.rows && self.k <= self.cols {
        true -> read(self.j, self.k)
        _ -> bad()
    }
    state read(&mut self, y: u32 [0..=self.rows], x: u32 [0..=self.cols]) {
        transition self.pixels[y * 4 + x] == 7 {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
