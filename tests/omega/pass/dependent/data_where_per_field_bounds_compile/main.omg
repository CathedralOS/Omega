// A `data where` clause may bound two different fields with different
// facts: `Range` holds `start >= 1` and `end <= 4` as conjuncts of one
// invariant. Literals inside both bounds construct.
data Range
requires
    start >= 1,
    end <= 4,
{
    start: u64;
    end: u64;
}

data Main { range: Range; }

machine Main::main(main: &mut Main) {
    main.range = Range { start: 2, end: 3 };
}
