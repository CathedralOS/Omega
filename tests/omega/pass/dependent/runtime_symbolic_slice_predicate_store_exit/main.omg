// A write preserves both independently traversed predicates through their
// checked bodies. No array length or predicate name grants the result.
machine valid_values(values: &[i32]) -> bool { check_values(values, values.len) }
machine check_values(values: &[i32], remaining: u64) -> bool
requires remaining <= values.len
terminates;
terminates by remaining in 0..=values.len;
{
    transition remaining > 0 { true -> inspect(values, remaining) false -> (true) }
    state inspect(values: &[i32], remaining: u64) -> bool
    requires remaining > 0 && remaining <= values.len
    {
        let selected: u64 = remaining - 1;
        transition values[selected] >= 0 && values[selected] <= 255 {
            true -> check_values(values, selected)
            false -> (false)
        }
    }
}
machine ascending_values(values: &[i32]) -> bool { check_ascending(values, 0) }
machine check_ascending(values: &[i32], cursor: u64) -> bool
requires cursor <= values.len
terminates;
terminates by (cursor, values.len) -> Nat::BoundedDistance;
{
    transition cursor < values.len { true -> inspect(values, cursor) false -> (true) }
    state inspect(values: &[i32], cursor: u64) -> bool
    requires cursor < values.len
    {
        transition values[cursor] >= 0 && values[cursor] <= 255 {
            true -> check_ascending(values, cursor + 1)
            false -> (false)
        }
    }
}
machine replace(values: &mut [i32], selected: u64, replacement: i32)
requires selected < values.len
requires valid_values(values) == true && ascending_values(values) == true
requires replacement >= 0 && replacement <= 255
ensures valid_values(values) == true && ascending_values(values) == true
{
    // Both arrivals owe the complete source predicate, not just the first edge.
    transition selected == 0 {
        true -> store(values, selected, replacement)
        false -> store(values, selected, replacement)
    }
    state store(values: &mut [i32], selected: u64, replacement: i32)
    requires selected < values.len
    requires valid_values(values) == true && ascending_values(values) == true
    requires replacement >= 0 && replacement <= 255
    {
        let saved: i32 = replacement;
        let coordinate: u64 = selected;
        values[coordinate] = saved;
        values[selected] = replacement;
    }
}
data Rows where valid_values(&values) == true, ascending_values(&values) == true {
    values: [i32; 6];
}
data Main { rows: Rows; }
machine Main::main(main: &mut Main) crashes Trap {
    replace(&mut main.rows.values[..], 4, 40);
    let observed: i32 = main.rows.values[4];
    transition observed == 40 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
