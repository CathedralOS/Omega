// A `data where` clause may relate two fields: `Window` is valid only while
// `low <= high`. The relational bound re-proves at state boundaries, so a
// record may be built field-by-field: the zero literal satisfies `0 <= 0`,
// and later stores under a callee `requires` relating its own parameters
// keep the bound at the point the machine exits.
data Window
requires
    low <= high,
{
    low: u64;
    high: u64;
}

data Main { span: u64; }

machine Main::frame(start: u64, limit: u64) -> u64
requires start <= limit, limit <= 100
{
    let window: Window = Window { low: 0, high: 0 };
    window.low = start;
    window.high = limit;
    window.high
}

machine Main::main(main: &mut Main) {
    main.span = Main::frame(5, 15);
}
