// A `data where` bound may name a module constant: `head < CAP` folds the
// bound against the constant's value, so constructions below `CAP` prove
// and the field stays a runtime value.
const CAP: u64 = 8;

data Ring
requires
    head < CAP,
{
    head: u64;
}

data Main { ring: Ring; }

machine Main::main(main: &mut Main) {
    main.ring = Ring { head: 5 };
    main.ring.head = main.ring.head + 1;
}
