// CASE-CONSTRAINTS ordinary move/linear-payload control: a case `where` fact
// gates construction while the payload carries a linear child. The arm moves
// `receipt` out of the owned `Envelope` into `ship`, where the consuming
// `Receipt::ack` discharges it -- the constraint rides ordinary ownership,
// with no copy, borrow, or disposal relaxation.
data Receipt [linear] { code: i32; }
machine Receipt::ack(self) {}
data Envelope {
    case Empty;
    case Wrapped(code: i32, receipt: Receipt) where code >= 0;
}
data Main {}
machine Main::main() {
    let envelope: Envelope = Envelope::Wrapped { code: 3, receipt: Receipt { code: 7 } };
    transition envelope {
        Envelope::Wrapped { code, receipt } -> ship(code, receipt)
        Envelope::Empty -> done()
    }
    state ship(&mut self, code: i32, receipt: Receipt) {
        Receipt::ack(receipt);
    }
    state done(&mut self) {}
}
