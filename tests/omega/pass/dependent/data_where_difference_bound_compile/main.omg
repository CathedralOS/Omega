// A `data where` bound may subtract operands: `Margin` is valid only
// while `left - right >= 2` — the fact reasons over a difference, keeping
// the fields a provable distance apart.
data Margin
requires
    left - right >= 2,
{
    left: u64;
    right: u64;
}

data Main { margin: Margin; }

machine Main::main(main: &mut Main) {
    main.margin = Margin { left: 7, right: 3 };
}
