// A `data where` clause may chain three fields transitively: `Sorted` is
// valid only while `low <= mid` and `mid <= high` both hold. A literal with
// ordered constants proves both conjuncts; the chain is one invariant.
data Sorted
requires
    low <= mid,
    mid <= high,
{
    low: u64;
    mid: u64;
    high: u64;
}

data Main { sorted: Sorted; }

machine Main::main(main: &mut Main) {
    main.sorted = Sorted { low: 1, mid: 5, high: 9 };
    main.sorted.mid = 7;
}
