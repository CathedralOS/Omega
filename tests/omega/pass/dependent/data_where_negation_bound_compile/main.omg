// A `data where` clause may relate a signed field to a negated bound:
// `Reading` is valid only while `reading >= -40` — below-freezing
// temperatures still construct. Negative literals in the bound and in the
// field's type are ordinary signed values.
data Reading
requires
    reading >= -40,
{
    reading: i64;
}

data Main { reading: Reading; }

machine Main::main(main: &mut Main) {
    main.reading = Reading { reading: -12 };
}
