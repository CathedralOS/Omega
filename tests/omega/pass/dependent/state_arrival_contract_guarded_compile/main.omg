// R5 state-arrival contract: the transition guard proves the target state's
// explicit `requires`, which is then available as an assumption in its body.
data Main {
    value: i32;
}

machine Main::main(&mut self) {
    transition self.value > 0 {
        true -> positive(self.value)
        false -> done()
    }

    state positive(value: i32)
    requires
        value > 0
    {
        consume(value);
    }

    state done() { }
}

machine consume(value: i32)
requires
    value > 0
{
}
