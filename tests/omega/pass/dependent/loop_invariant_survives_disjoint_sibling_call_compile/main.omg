// R5/Houdini frame bridge: the monotone-loop pass infers `0 <= self.i < 4`.
// A known sibling writes only `self.other`, so both inferred facts survive to
// the indexed read without an authored state contract.
data Main {
    nums: [i32; 4] in Trapping;
    i: i32 in Trapping;
    other: i32;
    value: i32;
}

machine Main::main(&mut self) {
    self.i = 0;
    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        self.touch_other();
        self.value = self.nums[self.i];
        self.i = self.i + 1;
        transition self.i < 4 {
            true -> loop_()
            false -> done()
        }
    }

    state done(&mut self) { }
}

machine Main::touch_other(&mut self) {
    self.other = 1;
}
