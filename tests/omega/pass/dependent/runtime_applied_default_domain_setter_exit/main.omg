data Counter<const Limit: u64> where count <= Limit { count: u64; }

machine Counter::set<const Bound: u64>(counter: &mut Counter<Bound>, value: u64)
requires value <= Bound;
{
    counter.count = value;
}

data Main { counter: Counter<4>; }

machine Main::main(main: &mut Main) crashes Trap {
    Counter::set(&mut main.counter, 3);
    transition main.counter.count == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
