// Collection invariant, indexed consequence: the helper theorem
// `cell_is_bit` concludes that one selected element is 0 or 1 from the
// predicate and a valid index; the checker proves it from `cells_valid`'s
// body. Each citation's `requires cells_valid(cells) == true` is the fact
// `Grid` states in `where` at `context.grid`, and its conclusion bounds
// that exact element, so the Exact `i32` sum of two cells fits. Dropping one
// citation leaves that operand unbounded
// (fail/dependent/collection_predicate_uncited_sum_rejected).

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

// Helper theorem: a valid collection's selected element is 0 or 1. The
// checker proves the ensures by exploring `cells_valid`'s own states under
// the premise, case by case over `index`.
machine cell_is_bit(cells: &[i32; 4], index: u64)
requires cells_valid(cells) == true
requires index < 4
ensures cells[index] >= 0 && cells[index] <= 1
{
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
    total: i32;
}

machine Main::sum(context: &mut Main) {
    cell_is_bit(&context.grid.board, 0);
    cell_is_bit(&context.grid.board, 3);
    context.total = context.grid.board[0] + context.grid.board[3];
}

machine Main::main(context: &mut Main) {
    Main::sum(context);
}
