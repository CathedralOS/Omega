domain u64::Positive(value) requires 1 <= value;
data Token { value: u64 in Positive; }
data Pair<T> { marker: i32; first: T; second: T; }
data Holder<T> { value: T; }
data Coupled<T> where start <= end, { value: T; start: i32; end: i32; }
data Span where start == end, { start: i32; end: i32; }

machine Token::drop(token: &mut Token) requires token.value == 42 { token.value = 1; }
machine token() -> Token ensures result.value == 42 { Token { value: 42 } }
machine inspect(pair: &Pair<Token>) -> bool {
    pair.first.value == 42 && pair.second.value == 42
}
machine inspect_coupled(holder: &Coupled<Token>) -> bool {
    holder.value.value == 42 && holder.start == 10 && holder.end == 20
}
machine mirror(boundary: i32) -> bool {
    let mut span: Span;
    span.start = boundary;
    span.end = boundary;
    span.start == span.end
}
machine main() crashes Trap {
    let mut pair: Pair<Token>;
    pair.marker = 0;
    pair.first = Token { value: 42 };
    let first: u64 = pair.first.value;
    pair.second = token();
    let complete: bool = inspect(&pair);
    let mut nested: Holder<Holder<Token>>;
    nested.value.value = Token { value: 42 };
    let nested_value: u64 = nested.value.value.value;
    let mut coupled: Coupled<Token>;
    coupled.start = 10;
    coupled.value = Token { value: 42 };
    coupled.end = 20;
    let restored: bool = inspect_coupled(&coupled);
    let mirrored: bool = mirror(7);
    transition first == 42 && complete && nested_value == 42 && restored && mirrored {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
