// TRANSITIVE field-vs-field reader hypotheses: count <= mid and
// mid <= capacity and capacity <= 100 CHAIN through the unranged middle field, so a
// read of count fits u32 (requires 0 <= it <= 100) (bound_source_interval falls back to
// the co-field's own where-fact interval, depth-capped). RUNS exit 70.
use omega_language_std::console;
use omega::language::core::binding;
data Tally
where
    count <= mid,
    mid <= capacity,
    capacity <= 100,
{
    count: u32;
    mid: u32;
    capacity: u32;
}
data Main { console: Binding<Console>; }
machine Main::record(&mut self, v: u32) requires v <= 100 { }
machine Main::main(&mut self) reaches Console {
    let t: Tally = Tally { count: 5, mid: 20, capacity: 50 };
    self.record(t.count);
    self.console.exit_process(70);
}
