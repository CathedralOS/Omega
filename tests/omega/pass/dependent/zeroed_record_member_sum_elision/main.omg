// COMPILE CANARY. A record literal may elide a member of sum type whose first
// case carries scalar payloads: zero establishment mints the first-case tag
// cell and the zero spelling of its scalar payload fields. Elided scalar
// members in a partially-authored literal establish their declared type's
// zero as the field's scalar value.
use omega_language_std::console;

data RegionAlignment {
    case Unaligned(offset: u64);
    case Aligned(boundary: u64);
}

data Snapshot {
    region_count: u32;
    padding: [u8; 8];
    alignment: RegionAlignment;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let snapshot: Snapshot = Snapshot {};
    let partial: Snapshot = Snapshot { region_count: 4 };
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
