// A `data where` clause may negate an arithmetic relation: `Skip` is
// valid only while `a + 1 != b` — a disequality over a computed operand,
// keeping b off a's successor.
data Skip
requires
    a + 1 != b,
{
    a: u64;
    b: u64;
}

data Main { skip: Skip; }

machine Main::main(main: &mut Main) {
    main.skip = Skip { a: 3, b: 9 };
}
