// A `data where` clause may require a disequality: `Handle` is valid only
// while `raw != 0` — a zero handle is the absence state and cannot be
// constructed as a live value. Nonzero literals prove the bound.
data Handle
requires
    raw != 0,
{
    raw: u64;
}

data Main { handle: Handle; }

machine Main::main(main: &mut Main) {
    main.handle = Handle { raw: 7 };
}
