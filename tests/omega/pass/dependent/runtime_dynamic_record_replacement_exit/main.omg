data Cell { value: u64; }
data Coupled where left == right, { left: i32; right: i32; }
data Rows { plain: [Cell; 2]; coupled: [Coupled; 2]; }

machine replace(rows: &mut Rows, index: u64) requires index < 2 {
    rows.plain[index] = Cell { value: 42 };
    rows.coupled[index] = Coupled { left: 9, right: 9 };
}

machine main() crashes Trap {
    let mut rows: Rows = Rows {
        plain: [Cell { value: 7 }, Cell { value: 11 }],
        coupled: [Coupled { left: 1, right: 1 }, Coupled { left: 2, right: 2 }]
    };
    replace(&mut rows, 1);
    transition rows.plain[0].value == 7 && rows.plain[1].value == 42
        && rows.coupled[0].left == 1 && rows.coupled[1].right == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
