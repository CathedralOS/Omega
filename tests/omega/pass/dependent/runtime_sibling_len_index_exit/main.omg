// A state's precondition relates an explicit context field to a sibling slice
// parameter: main.j < items.len. The caller's guard establishes that relation;
// the callee then indexes without another guard. Expected exit: 7.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; buf: [u8; 8]; j: u64; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.buf[5] = 7;
    main.j = 5;
    let view: &[u8] = main.buf.as_slice();
    transition main.j < view.len { true -> read(main, view) _ -> bad(main) }
    state read(main: &mut Main, items: &[u8])
        requires main.j < items.len
    {
        main.out = items[main.j] as i32;
        main.console.exit_process(main.out);
    }
    state bad(main: &mut Main) { main.console.exit_process(9); }
}
