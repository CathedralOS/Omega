// RUN CANARY (exit 7) + interpreter differential. Chapter 12's headline
// Buffer::get shape: `state read(&mut self, items: &[u8], index: u64)
// requires index < items.len` -- the bound names a SIBLING parameter's slice length.
// The caller proves each entry on its arm (`main.j < view.len`; the
// sibling-length proof atom resolves the sibling's ARGUMENT at plan-build
// time and the guard route matches `<arg> < <sibling-arg>.len` by display
// spelling); inside the callee the STRICT bound mints the
// unknown-length prover's prove_index fact, so `items[index]` indexes
// with NO guard. Unguarded callers and unknown/non-slice sibling names
// refuse (fail siblings). Slice views are immutable, so the length
// needs no write fence.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; buf: [u8; 8]; j: u64; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.buf[5] = 7;
    main.j = 5;
    let view: &[u8] = main.buf.as_slice();
    transition main.j < view.len { true -> read(main, view) _ -> bad(main) }
    state read(main: &mut Main, items: &[u8])
        requires main.j < items.len
    {
        main.out = items[main.j] as i32;
        main.console.exit_process(main.out);
    }
    state bad(main: &mut Main) { main.console.exit_process(9); }
}
