// COMPILE CANARY. A field range is default-domain sugar: excluding zero gates
// the record, and an explicit in-range initializer establishes it.
use omega_language_std::console;
use omega::language::core::binding;
data Player where health >= 1, health <= 100 { health: i32; score: i32; }
data Main { console: Binding<Console>; }
machine Main::main(&mut self) reaches Console {
    let player: Player = Player { health: 50 };
    self.console.exit_process(70);
}
