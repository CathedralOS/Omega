// RUN CANARY (exit 70). A provisioned entry receiver must satisfy its
// carrier's facts in the all-zero image, so `health >= 1` cannot gate `Main`
// itself. The gate rides an explicitly constructed local `Player` instead:
// the entry machine builds the gated witness, and its field feeds the hosted
// exit. `Player` is `[copy]` so the live local needs no affine cleanup at the
// nonreturning boundary call.
use omega_language_std::console;
use omega::language::core::service;
data Player [copy]
where
    health >= 1,
{
    health: i32;
}
data Main {
    console: Binding<Console>;
}
machine Main::main(&mut self) reaches Console {
    let player: Player = Player { health: 70 };
    self.console.exit_process(player.health);
}
