// Entry provisioning must prove the first case's actual zero payload facts.
// Clause presence is not a refusal, and another case is not a zero witness.
// Case selection publishes bounds to every apply arm without range suffixes.
use omega_language_std::console;

const level: i32 = 999;
data Command<const Maximum: i32> {
    case SetLevel(level: i32) where level >= 0 && level <= Maximum;
    case Dim(amount: i32) where amount >= 0 && amount <= 10;
    case Off;
}
data Main where brightness >= 0 && brightness <= 100 {
    brightness: i32;
    command: Command<100>;
}
machine forward(command: Command<100>) -> Command<100> {
    command
}
machine Main::main(main: &mut Main) reaches Console {
    main.brightness = 80;
    let selected: Command<100> = forward(Command::SetLevel { level: 65 });
    main.command = selected;
    transition main.command {
        Command::SetLevel { level } -> apply(main, level)
        Command::Dim { amount } -> apply(main, amount * 10)
        Command::Off -> apply(main, 0)
    }
    state apply(main: &mut Main, target: i32)
    requires target >= 0 && target <= 100;
    {
        main.brightness = target;
        transition { _ -> done(main) }
    }
    state done(main: &mut Main) {
        Console::exit_process(main.brightness);
    }
}
