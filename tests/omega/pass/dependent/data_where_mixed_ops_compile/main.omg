// A `data where` clause mixes operators across conjuncts: `Gate` is valid
// only while `a >= 1`, `a != b`, and `b <= 8` — bounds, disequality, and a
// cross-field ceiling in one invariant.
data Gate
requires
    a >= 1,
    a != b,
    b <= 8,
{
    a: u64;
    b: u64;
}

data Main { gate: Gate; }

machine Main::main(main: &mut Main) {
    main.gate = Gate { a: 3, b: 7 };
}
