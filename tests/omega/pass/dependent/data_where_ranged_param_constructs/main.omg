// R2 rung 3 slice 9 -- PROVER-BACKED CONSTRUCTION: the literal's field
// value is a RUNTIME parameter, but its declared `requires 1 <= strength,
// strength <= 100` decides the gated fact `health >= 1` by interval folding
// -- ch12's Player constructs from runtime data with no spelled requires,
// and the access gate opens in the constructing machine. The Player is a
// local of that machine: a provisioned entry context must be valid at zero
// (wiki/spec/build/entry_roots.md), so a gated record cannot be one of its
// fields.
use omega_language_std::console;
data Player
where
    health >= 1,
{
    health: i32;
}
data Main { }
machine Main::recruit(strength: i32) -> i32
requires 1 <= strength, strength <= 100
{
    let champion: Player = Player { health: strength };
    champion.health
}
machine Main::main(context: &mut Main) reaches Console {
    let power: i32 = Main::recruit(50);
    transition power == 50 {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
