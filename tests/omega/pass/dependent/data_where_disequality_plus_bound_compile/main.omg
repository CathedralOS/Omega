// Two conjuncts may constrain one field both ways at once: `Port` is
// valid only while `port > 0` and `port != 9` — a positive field with a
// single excluded point inside its range.
data Port
requires
    port > 0,
    port != 9,
{
    port: u64;
}

data Main { port: Port; }

machine Main::main(main: &mut Main) {
    main.port = Port { port: 8 };
}
