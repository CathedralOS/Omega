// A `data where` clause may order two fields strictly: `Order` is valid
// only while `first < second` — the strict cross-field relation, no
// slack allowed.
data Order
requires
    first < second,
{
    first: u64;
    second: u64;
}

data Main { order: Order; }

machine Main::main(main: &mut Main) {
    main.order = Order { first: 2, second: 9 };
}
