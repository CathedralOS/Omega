// CASE-CONSTRAINTS case replacement: a payload store under `Range` opens an
// invariant window on `lo <= hi`, but the constraint is indexed by the
// ACTIVE case -- replacing the value with `Interval::Empty` drops the
// `Range` obligation entirely, so the machine may exit cleanly.
data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { interval: Interval; }
machine Main::main(&mut self) {
    self.interval = Interval::Range { lo: 1, hi: 5 };
    self.interval.hi = 0;
    self.interval = Interval::Empty;
}
