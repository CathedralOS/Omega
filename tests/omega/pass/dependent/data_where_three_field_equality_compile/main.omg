// A `data where` clause may chain equality across three fields:
// `Triple` is valid only while `first == second` and `second == third`
// — a full-equality invariant folded from pairwise conjuncts.
data Triple
requires
    first == second,
    second == third,
{
    first: u64;
    second: u64;
    third: u64;
}

data Main { triple: Triple; }

machine Main::main(main: &mut Main) {
    main.triple = Triple { first: 7, second: 7, third: 7 };
}
