// CASE-CONSTRAINTS generic case-data synthesis: a `type` binder in a case
// `where` fact is decided against the closed argument identity at instance
// synthesis -- `T == i32` holds on `Value<i32>`, so the fact discharges off
// the `Integer` case, `value` arrives as an `i32` in the arm with no cast,
// and `Integer { value: 5 }` constructs.
data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}
data Main { v: Value<i32>; }
machine Main::main(&mut self) {
    self.v = Value::Integer { value: 5 };
    transition self.v {
        Value::Integer { value } -> seen(value)
        _ -> done()
    }
    state seen(&mut self, value: i32) {}
    state done(&mut self) {}
}
