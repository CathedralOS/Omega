// A `data where` clause mixes a field-field chain with a literal ceiling:
// `Pair` is valid only while `x <= y` and `y <= 3` — the literal end
// bounds the chain's top.
data Pair
requires
    x <= y,
    y <= 3,
{
    x: u64;
    y: u64;
}

data Main { pair: Pair; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { x: 1, y: 2 };
}
