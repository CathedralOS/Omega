// The predicate is not hereditary: a two-element view does not satisfy it.
machine exactly_four(cells: &[i32]) -> bool { cells.len == 4 }

data Grid where exactly_four(&cells) == true { cells: [i32; 4]; }

machine count(cells: &[i32]) -> u64
requires exactly_four(cells) == true
{ cells.len }

machine main() crashes Trap {
    let mut grid: Grid;
    let count: u64 = count(&grid.cells[..]);
    transition count == 4 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
