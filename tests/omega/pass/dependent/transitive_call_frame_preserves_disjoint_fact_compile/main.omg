// R5 transitive frame: may-write summaries compose through internal sibling
// calls, preserving a caller fact when the entire call chain writes elsewhere.
data Main {
}

machine Main::main(main: &mut Main) {
    let mut stable: u32 = 5;
    Main::middle(main);
    let mut result: u32 = stable + 1;
}

machine Main::middle(main: &mut Main) {
    Main::touch(main);
}

machine Main::touch(main: &mut Main) {
    let mut touched: u32 = 1;
}
