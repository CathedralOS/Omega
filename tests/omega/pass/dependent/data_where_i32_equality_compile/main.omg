// A `data where` clause may pin two i32 fields to equality: `Span` is
// valid only while `start == end` — the same-point interval on signed
// members, mirroring the corpus's own shape.
data Span
requires
    start == end,
{
    start: i32;
    end: i32;
}

data Main { span: Span; }

machine Main::main(main: &mut Main) {
    main.span = Span { start: -3, end: -3 };
}
