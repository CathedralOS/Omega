// Collection invariant, zero initialization: `Grid`'s default domain is an
// ordinary predicate machine that walks the cells with one state per
// element. Exploring that body with every cell zero returns `true` on every
// path, so the zeroed `Grid` is established at boot and `main` may read it
// before any store. A walk that is false at zero keeps the data gated
// (fail/dependent/collection_predicate_zero_violating_read_rejected).

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
    seen: i32;
}

machine Main::main(main: &mut Main) {
    main.seen = main.grid.board[2];
}
