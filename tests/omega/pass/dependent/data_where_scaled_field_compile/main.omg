// A `data where` conjunct may scale one field against another:
// `Coupon` is valid only while `face * 2 <= limit` — the arithmetic
// operand compares to a sibling field, not a literal.
data Coupon
requires
    face * 2 <= limit,
{
    face: u64;
    limit: u64;
}

data Main { coupon: Coupon; }

machine Main::main(main: &mut Main) {
    main.coupon = Coupon { face: 4, limit: 9 };
}
