data Pair where left <= right, { left: u64; right: u64; }
data Storage { pair: Pair; }

machine Storage::walk(storage: &mut Storage, choose_left: bool) {
    transition choose_left {
        true -> seed_left(storage)
        false -> seed_right(storage)
    }
    state first(storage: &mut Storage) {
        transition true { true -> second(storage) false -> done(storage) }
    }
    state second(storage: &mut Storage) {
        transition true { true -> first(storage) false -> done(storage) }
    }
    state seed_left(storage: &mut Storage) {
        storage.pair = Pair { left: 1, right: 2 };
        transition true { true -> first(storage) false -> first(storage) }
    }
    state seed_right(storage: &mut Storage) {
        storage.pair = Pair { right: 2, left: 1 };
        transition true { true -> second(storage) false -> second(storage) }
    }
    state done(storage: &mut Storage) {
        storage.pair.left = 2;
    }
}
