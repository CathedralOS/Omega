// A `data where` bound applies to narrow integer fields too: `Tag` is
// valid only while `tag >= 10` on a u8 — the bound proves against the
// field's own width at construction.
data Tag
requires
    tag >= 10,
{
    tag: u8;
}

data Main { tag: Tag; }

machine Main::main(main: &mut Main) {
    main.tag = Tag { tag: 42 };
}
