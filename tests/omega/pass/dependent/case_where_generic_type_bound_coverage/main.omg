// CASE-CONSTRAINTS generic case-data coverage: `T == i32` refutes on
// `Value<bool>`, so `Integer` is an impossible case on this instance and a
// match covering only `Boolean` is already exhaustive -- no `_` arm needed.
data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}
data Main { v: Value<bool>; }
machine Main::main(&mut self) {
    self.v = Value::Boolean { value: true };
    transition self.v {
        Value::Boolean { value } -> done()
    }
    state done(&mut self) {}
}
