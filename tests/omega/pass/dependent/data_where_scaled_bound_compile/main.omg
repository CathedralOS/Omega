// A `data where` bound may scale the field: `Half` is valid only while
// `a * 2 <= 10` — literal-scaled operands compose in bounds like the
// field-field arithmetic probes.
data Half
requires
    a * 2 <= 10,
{
    a: u64;
}

data Main { half: Half; }

machine Main::main(main: &mut Main) {
    main.half = Half { a: 4 };
}
