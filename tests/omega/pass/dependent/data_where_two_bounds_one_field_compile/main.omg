// A `data where` clause may pin both ends of one field: `Score` is valid
// only while `1 <= score` and `score <= 10` — an inclusive interval on a
// single member. Values inside both bounds construct.
data Score
requires
    score >= 1,
    score <= 10,
{
    score: u64;
}

data Main { score: Score; }

machine Main::main(main: &mut Main) {
    main.score = Score { score: 7 };
}
