machine read_last(cells: &[i32], remaining: u64) -> i32
requires remaining > 0 && remaining <= cells.len
{
    let selected: u64 = remaining - 1;
    let observed: i32 = cells[selected];
    transition { _ -> observed }
}

machine main() crashes Trap {
    let cells: [i32; 4] = [3, 5, 7, 9];
    let observed: i32 = read_last(&cells[..], 3);
    transition observed == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
