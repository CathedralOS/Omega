// A `data where` bound applies at i8 width: `Delta` is valid only while
// `value <= 10` — the ceiling proves against the narrow signed field.
data Delta
requires
    value <= 10,
{
    value: i8;
}

data Main { delta: Delta; }

machine Main::main(main: &mut Main) {
    main.delta = Delta { value: 9 };
}
