// A `data where` clause may write a half-open interval: `Level` is valid
// only while `value >= 3` and `value < 10` — lower bound inclusive, upper
// bound exclusive.
data Level
requires
    value >= 3,
    value < 10,
{
    value: u64;
}

data Main { level: Level; }

machine Main::main(main: &mut Main) {
    main.level = Level { value: 4 };
}
