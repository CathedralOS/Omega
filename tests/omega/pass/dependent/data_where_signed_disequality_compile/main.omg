// A `data where` clause may exclude a signed sentinel: `Reading` is
// valid only while `value != -1` — negative disequality keeps the
// error-marker value out of the domain.
data Reading
requires
    value != -1,
{
    value: i64;
}

data Main { reading: Reading; }

machine Main::main(main: &mut Main) {
    main.reading = Reading { value: -4 };
}
