// Collection invariant, restoration after element stores: `Main::seed`
// arrives with `Grid`'s predicate established and stores 1 into two cells.
// Each store opens a window on `context.grid`; exploring `cells_valid` over
// the entry facts plus the stored values returns `true`, so the window closes
// before the call and the state exit. The later requirement of `count` is
// then the standing `where` fact itself. A store of 2 leaves the window open
// (fail/dependent/collection_predicate_element_store_violates_rejected).

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

// Helper theorem: a valid collection's selected element is 0 or 1. The
// checker proves the ensures by exploring `cells_valid`'s own states under
// the premise, case by case over `index`.
machine cell_is_bit(cells: &[i32; 4], index: u64)
requires cells_valid(cells) == true
requires index < 4
ensures cells[index] >= 0 && cells[index] <= 1
{
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
    total: i32;
}

machine count(cells: &[i32; 4]) -> i32
requires cells_valid(cells) == true
{
    cell_is_bit(cells, 1);
    cell_is_bit(cells, 2);
    transition { _ -> (cells[1] + cells[2]) }
}

machine Main::seed(context: &mut Main) {
    context.grid.board[1] = 1;
    context.grid.board[2] = 1;
    context.total = count(&context.grid.board);
}

machine Main::main(context: &mut Main) {
    Main::seed(context);
}
