// CASE-CONSTRAINTS match-contributed case facts: a `transition` arm whose
// pattern selects `Range { lo, hi }` runs under that case's `where` facts --
// dispatch already established `lo <= hi`, so `hi - lo` is exact unsigned
// arithmetic inside the arm. Sibling and fall-through arms see no such facts.
data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { interval: Interval; }
machine Main::main(&mut self) {
    self.interval = Interval::Range { lo: 1, hi: 5 };
    transition self.interval {
        Interval::Empty -> done()
        Interval::Range { lo, hi } -> span(hi - lo)
        _ -> done()
    }
    state span(&mut self, width: u64) {}
    state done(&mut self) {}
}
