// A `data where` clause may pin two u8 fields to equality: `Twins` is
// valid only while `first == second` — the same-point invariant at byte
// width.
data Twins
requires
    first == second,
{
    first: u8;
    second: u8;
}

data Main { twins: Twins; }

machine Main::main(main: &mut Main) {
    main.twins = Twins { first: 9, second: 9 };
}
