// COMPILE CANARY. The first sum case is the zero value. A payload-free Empty
// therefore absorbs Player's gate, and an array of slots can zero-initialize.
use omega_language_std::console;
use omega::language::core::service;
data Player where health >= 1, health <= 100 { health: i32; }
data PlayerSlot {
    case Empty;
    case Filled(player: Player);
}
data Team { roster: [PlayerSlot; 8]; }
data Main { console: Binding<Console>; }
machine Main::main(&mut self) reaches Console {
    let team: Team = Team {};
    self.console.exit_process(70);
}
