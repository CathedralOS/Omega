// Retained floating range endpoints are IEEE values, not integer bounds.
// Carrier-valid zero also needs no grant for route-/predicate-free aliases.
data Counter [copy] { code: i32; }
domain Counter::Ready;
domain Counter::ReadyAlias = Ready;
data ZeroRatio [copy] where value >= 0.0 && value < 0.5 { value: f32; }

machine main() {
    let counter: Counter in Counter::ReadyAlias;
    let observed: i32 = counter.code;
    let zero_ratio: ZeroRatio;
    let ratio: f32 = zero_ratio.value;
    let omitted: ZeroRatio = ZeroRatio {};
}
// An unused generic payload in another case cannot invalidate the home case.
data Choice<T> {
    case #0 Empty;
    case #1 Value(value: T);
}
machine zero_is_empty<T>() ensures zero_value<Choice<T>>() in Choice::Empty {}
