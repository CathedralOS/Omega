// A state whose only exit is a crash may leave a data `requires` window open.
// `abandon` breaks `count <= len` with `target.count = 99` and then crashes;
// no return follows, so nothing consumes the broken value through this
// machine's normal outcome.
//
// Rule (wiki/spec/language/dependent_values.md, "Invariant windows"): "A crash
// may abandon an open window but supplies no survivor-safety theorem".
//
// Twin: `fail/dependent/data_requires_return_beside_dead_crash`, where the same
// write is followed by a dispatch whose arms return before the crash, and is
// rejected.
data Tally
requires
    count <= len,
{
    len: u32;
    count: u32;
}
machine abandon(target: &mut Tally) crashes Trap {
    target.count = 99;
    crash Trap;
}
machine main() {}
