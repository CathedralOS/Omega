// A case `where` equality relates the two payload fields: under the
// `Interval::Point` arm, `lo == hi` holds on the destructured bindings, so
// `hi - lo` cannot underflow. The equality is contributed as both orders on
// the exact subject places, the same relations an authored `lo == hi` guard
// produces, and it survives the edge into `take` through the bound
// parameters. Before 2026-10-06 a case equality contributed only literal
// sides, and this subtraction was rejected as possible `u64` overflow.
data Interval {
    case Empty;
    case Point(lo: u64, hi: u64) where lo == hi;
}
data Main { interval: Interval; width: u64; }
machine Main::main(main: &mut Main) {
    transition main.interval {
        Interval::Point { lo, hi } -> take(lo, hi, main)
        Interval::Empty -> done()
    }
    machine take(lo: u64, hi: u64, main: &mut Main) {
        main.width = hi - lo;
    }
    machine done() { }
}
