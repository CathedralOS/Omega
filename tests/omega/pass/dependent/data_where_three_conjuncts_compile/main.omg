// A `data where` clause composes three conjuncts across two fields:
// `a >= 1`, `b >= a`, `b <= 9` — an ordered pair inside a bounded band.
// Literals proving all three construct.
data Band
requires
    a >= 1,
    b >= a,
    b <= 9,
{
    a: u64;
    b: u64;
}

data Main { band: Band; }

machine Main::main(main: &mut Main) {
    main.band = Band { a: 3, b: 7 };
}
