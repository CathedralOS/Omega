// A `data where` clause may pin a field to a companion field's value at
// u64 width: `Mirror` is valid only while `copy == source` — field-field
// equality on the widest scalar.
data Mirror
requires
    copy == source,
{
    copy: u64;
    source: u64;
}

data Main { mirror: Mirror; }

machine Main::main(main: &mut Main) {
    main.mirror = Mirror { copy: 8, source: 8 };
}
