// R2 rung 3 slice 11 -- CROSS-MACHINE ESTABLISHMENT: recruit (a
// single-state machine) definitely establishes a Player on every path; its
// result joins main's tracking at the call site, so the read AFTER the call
// passes the access gate (establishment is globally monotone -- a call can
// only add it). The Player arrives as the call's result rather than a context
// field: a provisioned entry context must be valid at zero
// (wiki/spec/build/entry_roots.md), so a gated record cannot be one of its
// fields.
use omega_language_std::console;
data Player
where
    health >= 1,
{
    health: i32;
}
data Main { }
machine Main::recruit(strength: i32) -> Player
requires 1 <= strength, strength <= 100
{
    Player { health: strength }
}
machine Main::main(context: &mut Main) reaches Console {
    let champion: Player = Main::recruit(50);
    let power: i32 = champion.health;
    transition power == 50 {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
