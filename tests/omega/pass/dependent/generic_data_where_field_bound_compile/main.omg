// A `data where` clause survives on a generic carrier: `Box<T>` bounds its
// scalar `size` independent of the member type — `Box<u64>` and
// `Box<bool>` instantiate under the same `size <= 4` invariant.
data Box<T>
requires
    size <= 4,
{
    size: u64;
    value: T;
}

data Main {
    numbers: Box<u64>;
    flags: Box<bool>;
}

machine Main::main(main: &mut Main) {
    main.numbers = Box { size: 3, value: 42 };
    main.flags = Box { size: 1, value: true };
}
