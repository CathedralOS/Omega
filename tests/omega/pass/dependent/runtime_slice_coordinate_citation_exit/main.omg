// A normal-return guarantee follows the selected builtin window's ordinal.
// The runtime check supplies the bound; no collection predicate is assumed.
machine check_byte(cells: &[i32], index: u64) crashes Trap
requires index < cells.len
ensures cells[index] >= 0 && cells[index] <= 255
{
    transition cells[index] < 0 || cells[index] > 255 {
        true -> bad(cells, index)
        false -> done(cells, index)
    }
    machine bad(cells: &[i32], index: u64) { crash Trap; }
    machine done(cells: &[i32], index: u64)
    requires index < cells.len
    requires cells[index] >= 0 && cells[index] <= 255
    {}
}

data Cells { values: [i32; 4]; }

machine compute(cells: &Cells) -> i32 crashes Trap {
    check_byte(&cells.values[2..4], 1);
    let observed: i32 = cells.values[3] + 1;
    transition { _ -> observed }
}

machine main() crashes Trap {
    let mut cells: Cells;
    cells.values[3] = 7;
    let observed: i32 = compute(&cells);
    transition observed == 8 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
