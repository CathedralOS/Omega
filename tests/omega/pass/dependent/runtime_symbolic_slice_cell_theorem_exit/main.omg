// An arbitrary-length predicate proves a selected-cell theorem, not a fact
// granted by its name or a four-element shape. This customer supplies six cells.
machine valid_values(values: &[i32]) -> bool { check_values(values, values.len) }

machine check_values(values: &[i32], remaining: u64) -> bool
requires remaining <= values.len
terminates;
terminates by remaining in 0..=values.len;
{
    transition remaining > 0 { true -> inspect(values, remaining) false -> (true) }
    machine inspect(values: &[i32], remaining: u64) -> bool
    requires remaining > 0 && remaining <= values.len
    {
        let selected: u64 = remaining - 1;
        transition values[selected] >= 0 && values[selected] <= 255 {
            true -> check_values(values, selected)
            false -> (false)
        }
    }
}

machine ascending_values(values: &[i32]) -> bool { check_ascending(values, 0) }
machine check_ascending(values: &[i32], cursor: u64) -> bool
requires cursor <= values.len
terminates;
terminates by (cursor, values.len) -> Nat::BoundedDistance;
{
    transition cursor < values.len { true -> inspect(values, cursor) false -> (true) }
    machine inspect(values: &[i32], cursor: u64) -> bool
    requires cursor < values.len
    {
        transition values[cursor] >= 0 && values[cursor] <= 255 {
            true -> check_ascending(values, cursor + 1)
            false -> (false)
        }
    }
}

machine selected_by_forward(values: &[i32], selected: u64)
requires ascending_values(values) == true && selected < values.len
ensures values[selected] >= 0 && values[selected] <= 255
{}

machine selected_is_byte(values: &[i32], selected: u64)
requires true == valid_values(values) && selected < values.len
ensures values[selected] >= 0 && values[selected] <= 255
{}

machine read_selected(values: &[i32], selected: u64) -> i32
requires valid_values(values) == true
requires ascending_values(values) == true
requires selected < values.len
ensures result >= 1 && result <= 256
{
    selected_is_byte(values, selected);
    selected_by_forward(values, selected);
    let observed: i32 = values[selected];
    transition { _ -> (observed + 1) }
}

data Rows where valid_values(&values) == true, ascending_values(&values) == true { values: [i32; 6]; }
data Main { rows: Rows; }
machine Main::main(main: &mut Main) crashes Trap {
    main.rows.values[4] = 40;
    let selected: u64 = 4;
    let observed: i32 = read_selected(&main.rows.values[..], selected);
    transition observed == 41 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
