// A `data where` bound applies at u16 width: `Port` is valid only while
// `port <= 1000` — the ceiling proves against the field's own width.
data Port
requires
    port <= 1000,
{
    port: u16;
}

data Main { port: Port; }

machine Main::main(main: &mut Main) {
    main.port = Port { port: 80 };
}
