// RUN CANARY (exit 70). A zero-valid default-domain bound is standing in every
// state of the attached machine and discharges exact arithmetic on its field.
use omega_language_std::console;
data Main
where
    value <= 60,
{
    value: i32;
}
machine Main::main(main: &mut Main) reaches Console {
    let return_code: i32 = 70 + main.value;
    Console::exit_process(return_code);
}
