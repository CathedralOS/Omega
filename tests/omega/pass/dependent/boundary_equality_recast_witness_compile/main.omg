use omega::language::core::service;
// R1/R4: a boundary contract may transport a symbolic bound through equality
// between out-parameters. `size == cap && cap <= 8` proves the four-byte view
// beginning at `size` fits in the twelve-byte region.
pub boundary trait Firmware {
    machine get_map(size: &mut u32, cap: &mut u32)
    ensures size == cap && cap <= 8;
}

data Main {
    fw: Binding<Firmware>;
    buf: [u8; 12];
    size: u32;
    cap: u32;
}

machine Main::main(&mut self) reaches Firmware {
    self.fw.get_map(&mut self.size, &mut self.cap);
    transition { _ -> read(self.size, self.cap) }

    state read(&mut self, size: u32, cap: u32) {
        let word: &u32 = &self.buf[size] as &u32;
    }
}
