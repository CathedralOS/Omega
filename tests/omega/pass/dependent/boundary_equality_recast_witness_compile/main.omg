// A boundary `ensures` may relate two out-parameters: `size == cap &&
// cap <= 8` bounds `size` through `cap`, so the four-byte view beginning at
// `size` fits in the twelve-byte region. The equality stays a relation between
// the two argument places; the fail sibling
// `fail/recast/boundary_equality_retired_by_out_argument_write` shows a later
// write to one of them retiring it.
pub boundary trait Firmware {
    machine get_map(size: &mut u32, cap: &mut u32)
    ensures size == cap && cap <= 8;
}

data Main {
    buf: [u8; 12];
    size: u32;
    cap: u32;
}

machine Main::main(main: &mut Main) reaches Firmware {
    Firmware::get_map(&mut main.size, &mut main.cap);
    // The scalar operands copy `size` and `cap` before `main` lends the
    // whole receiver for the rest of the transition.
    transition { _ -> read(main.size, main.cap, main) }

    state read(size: u32, cap: u32, main: &mut Main) {
        let word: &u32 = &main.buf[size] as &u32;
    }
}
