// A `data where` clause may pin a signed interval: `Temp` is valid only
// while `-5 <= value` and `value <= 5` — a symmetric band around zero.
// Signed literals prove the band at construction.
data Temp
requires
    value >= -5,
    value <= 5,
{
    value: i64;
}

data Main { temp: Temp; }

machine Main::main(main: &mut Main) {
    main.temp = Temp { value: -3 };
}
