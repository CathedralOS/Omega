// RUN CANARY (exit 6) + interpreter differential. The chapter-12 requires
// loop CLOSED: a dominating incoming-arm guard establishes a machine
// `requires` fact at the call site -- `transition main.a <= main.b
// { true -> go() }` proves helper's `requires main.a <= main.b` (the
// contracts prover consumes the ranges machinery's IncomingGuard
// walk-back: single-predecessor edges, rewrite-fenced across
// intermediate states, plus the caller state's own pre-call
// preservation), and INSIDE helper the same requires proves the exact
// u32 subtraction (channel b). The same incoming guard now discharges the
// dependent call argument: `x: u32, requires param <= main.b` accepts `main.a` because
// every edge into `go` carries the proving guard. Guard-then-WRITE before
// the call refuses (probed), as does the unguarded caller
// (fail/dependent/requires_call_unproven_rejected).
// exits: 9 - 3 = 6.
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Main { a: u32; b: u32; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.a = 3;
    main.b = 9;
    transition main.a <= main.b { true -> go(main) _ -> bad(main) }
    state go(main: &mut Main) {
        let a_value: u32 = main.a;
        Main::helper(main, a_value);
        let code: i32 = main.out;
        Console::exit_process(code);
    }
    state bad(main: &mut Main) { Console::exit_process(9); }
}
machine Main::helper(main: &mut Main, x: u32) requires main.a <= main.b, x <= main.b {
    let diff: u32 = main.b - x;
    main.out = narrow_u32_to_i32_trapping(diff);
}
