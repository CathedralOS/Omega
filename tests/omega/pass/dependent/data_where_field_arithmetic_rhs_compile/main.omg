// The arithmetic operand may sit on the bound's right side: `Step` is
// valid only while `x >= y + 1` — x stays strictly above y.
data Step
requires
    x >= y + 1,
{
    x: u64;
    y: u64;
}

data Main { step: Step; }

machine Main::main(main: &mut Main) {
    main.step = Step { x: 5, y: 3 };
}
