// RUN CANARY (exit 70). A collection invariant runs natively: `Grid` states
// its cells with the ordinary predicate machine `cells_valid`, and Terminal
// carries the predicate's checked elementwise consequence (each cell in
// [0, 1]) as the declaration predicate roster. Every machine reaching `Grid`
// through `context` requires those rows at entry and restores them at
// return: `seed` stores two cells, `advance` cites `cell_is_bit` and stores
// through its states, and `count` sums all four `next` cells with Exact
// `i32` arithmetic whose operand bounds are the rows. The fact-only
// `cell_is_bit` citations emit no call. Two live board cells make cell 0
// live, so the count is 1 and the code is 1 + 69.
use omega_language_std::console;

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    state at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    state at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    state at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

// Helper theorem: a valid collection's selected cell is 0 or 1.
machine cell_is_bit(cells: &[i32; 4], index: u64)
requires cells_valid(cells) == true
requires index < 4
ensures cells[index] >= 0 && cells[index] <= 1
{
}

data Grid [copy] where cells_valid(&board) == true, cells_valid(&next) == true {
    board: [i32; 4];
    next: [i32; 4];
    offset: i32 in Wrapping;
}

data Main {
    g: Grid;
}

machine Main::seed(context: &mut Main) {
    context.g.board[1] = 1;
    context.g.board[2] = 1;
    context.g.offset = 69;
}

// Cell 0 lives when both of its neighbours do.
machine Main::advance(context: &mut Main) {
    cell_is_bit(&context.g.board, 1);
    cell_is_bit(&context.g.board, 2);
    let neighbours: i32 in Wrapping = (context.g.board[1] + context.g.board[2]) as i32 in Wrapping;
    transition neighbours == 2 {
        true -> live(context)
        _ -> die(context)
    }

    state live(context: &mut Main) { context.g.next[0] = 1; }

    state die(context: &mut Main) { context.g.next[0] = 0; }
}

machine Main::count(context: &mut Main) -> i32 {
    cell_is_bit(&context.g.next, 0);
    cell_is_bit(&context.g.next, 1);
    cell_is_bit(&context.g.next, 2);
    cell_is_bit(&context.g.next, 3);
    transition {
        _ -> (context.g.next[0] + context.g.next[1] + context.g.next[2] + context.g.next[3])
    }
}

machine Main::main(context: &mut Main) reaches Console {
    Main::seed(context);
    Main::advance(context);
    let live: i32 in Wrapping = Main::count(context) as i32 in Wrapping;
    let code: i32 in Wrapping = live + context.g.offset;
    transition code == 70 {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) { Console::exit_process(70); }

    state bad(context: &mut Main) { Console::exit_process(71); }
}
