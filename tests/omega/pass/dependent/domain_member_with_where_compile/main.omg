// A member's own `in` domain and the record's `where` clause compose:
// `n: u64 in Tiny` narrows the field to {0..4} while `n >= 2` adds the
// record-level floor — both bounds must hold at construction, and the
// literal 3 satisfies each.
domain u64::Tiny
requires
    self <= 4;

data Pair
where
    n >= 2,
{
    n: u64 in Tiny;
    tag: u64;
}

data Main { pair: Pair; }

machine Main::main(main: &mut Main) {
    main.pair = Pair { n: 3, tag: 7 };
}
