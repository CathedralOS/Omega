// A field store into a `data where` record re-proves the invariant at the
// store site: `main.margin.left = 6` keeps `left - right >= 2` true given
// `right == 3` — the checker treats member writes as re-admission, not
// blind pokes.
data Margin
requires
    left - right >= 2,
{
    left: u64;
    right: u64;
}

data Main { margin: Margin; }

machine Main::main(main: &mut Main) {
    main.margin = Margin { left: 7, right: 3 };
    main.margin.left = 6;
}
