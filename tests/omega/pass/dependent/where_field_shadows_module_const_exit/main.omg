// A data or case `where` fact binds its own field names before module
// constants. `Holder`'s common fact and `Slot::Found`'s payload fact both
// name `value` beside `const value: u64 = 99`; reading either as the
// constant would make the fact `99 <= 5`, which no construction satisfies.
// The facts prove `found`'s arrival contract, and the state body's bare
// `value` still selects the constant. Exit 3 + 4 = 7.
use omega_language_std::console;

const value: u64 = 99;

data Holder where value <= 5 {
    value: u64;
}

data Slot {
    case Empty;
    case Found(value: u64) where value <= 5;
}

data Main {
}

machine Main::main(main: &mut Main)
reaches Console
{
    let holder: Holder = Holder { value: 3 };
    let slot: Slot = Slot::Found { value: 4 };
    transition slot {
        Slot::Found { value } -> found(main, holder.value, value)
        Slot::Empty -> invalid(main)
    }
    state found(main: &mut Main, common: u64, payload: u64)
    requires common <= 5 && payload <= 5
    {
        transition value == 99 {
            true -> done(main, common, payload)
            false -> invalid(main)
        }
    }
    state done(main: &mut Main, common: u64, payload: u64)
    requires common <= 5 && payload <= 5
    {
        Console::exit_process((common + payload) as i32);
    }
    state invalid(main: &mut Main) { Console::exit_process(99); }
}
