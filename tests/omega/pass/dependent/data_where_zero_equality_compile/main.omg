// A `data where` clause may pin a field to zero: `Empty` is valid only
// while `count == 0` — the absence invariant at construction, the other
// end of the `!= 0` probes.
data Empty
requires
    count == 0,
{
    count: u64;
}

data Main { empty: Empty; }

machine Main::main(main: &mut Main) {
    main.empty = Empty { count: 0 };
}
