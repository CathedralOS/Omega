// RUN CANARY (exit 70). A zero-valid nested record contributes its standing
// bound at the qualified place, so exact arithmetic sees self.map.value <= 60.
use omega_language_std::console;
data Map
where
    value <= 60,
{
    value: i32;
}
data Main { console: Console; map: Map; }
machine Main::main(&mut self) {
    let return_code: i32 = 70 + self.map.value;
    self.console.exit_process(return_code);
}
