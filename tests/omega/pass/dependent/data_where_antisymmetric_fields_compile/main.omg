// `where` conjuncts may bracket a pair antisymmetrically: `Twin` is
// valid only while `a <= b` and `b <= a` — the two relations meet only
// at equality, an indirect `a == b`.
data Twin
requires
    a <= b,
    b <= a,
{
    a: u64;
    b: u64;
}

data Main { twin: Twin; }

machine Main::main(main: &mut Main) {
    main.twin = Twin { a: 7, b: 7 };
}
