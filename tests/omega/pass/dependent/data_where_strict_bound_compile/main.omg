// A `data where` clause may use a strict bound: `Skip` is valid only while
// `index > 0` — zero is excluded from the value space. Strict and
// non-strict bounds discharge from the same literal facts.
data Skip
requires
    index > 0,
{
    index: u64;
}

data Main { skip: Skip; }

machine Main::main(main: &mut Main) {
    main.skip = Skip { index: 5 };
}
