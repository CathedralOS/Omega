// RUN CANARY (exit 70). A relational default-domain fact crosses calls in
// Terminal: `start <= end` is `Main`'s declaration predicate row, so
// `widen` requires it at entry and restores it at return through the
// `&mut Main` data binding. Its first store opens a window (`end` = 15 below
// `start` = 20 is never observed) and the second closes it. `main`
// establishes the row from its own stores before the call and exits on the
// restored span.
use omega_language_std::console;

data Main
where
    start <= end,
{
    start: i32;
    end: i32;
}

machine Main::widen(main: &mut Main) {
    main.start = 20;
    main.end = 30;
}

machine Main::main(main: &mut Main) reaches Console {
    main.start = 10;
    main.end = 15;
    Main::widen(main);
    transition main.end == 30 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }

    state bad(main: &mut Main) { Console::exit_process(71); }
}
