// A boundary requirement declares recoverable failure as an ordinary returned
// sum. A selected host provider may lower that result indirectly, but the
// semantic source surface exposes neither a result out-parameter nor an
// invisible unwind.

data Buffer {
    len: u64;
}

data IOError {
    code: i32;
}

data ReadOutcome {
    case Read(bytes: u64);
    case Closed;
    case Failed(error: IOError);
}

data HostFile {
    handle: i32;
}

boundary machine HostFile::read(handle: i32, out: &mut Buffer) -> ReadOutcome;

data Main {
}

machine Main::main(&mut self) {
}
