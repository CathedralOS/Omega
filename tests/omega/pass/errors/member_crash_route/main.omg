// A `crashes Trap` contract may name a member-projection operand route:
// `crashes Trap flags.dangerous` crashes on the aggregate's own field —
// beside the scalar-operand form `crashes Trap flag`.
data CrashFlags {
    dangerous: bool;
}
machine scalar_guarded(flag: bool) -> bool
requires true == true
ensures true == true
crashes Trap
    flag
{
    transition flag {
        true -> scalar_fail()
        _ -> scalar_succeed()
    }
    machine scalar_fail() -> bool {
        crash Trap;
    }
    machine scalar_succeed() -> bool { false }
}
machine member_guarded(flags: CrashFlags) -> bool
requires true == true
ensures true == true
crashes Trap
    flags.dangerous
{
    transition flags.dangerous {
        true -> member_fail()
        _ -> member_succeed()
    }
    machine member_fail() -> bool {
        crash Trap;
    }
    machine member_succeed() -> bool { false }
}

data Main {}
machine Main::main(main: &mut Main) { }
