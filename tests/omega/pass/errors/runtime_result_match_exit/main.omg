// Explicit Result-style error handling at RUNTIME -- the sum-type idiom (Ok / Err, no
// exceptions) real apps use for recoverable failure. The compile-only
// fallible_result_data_shape companion checks an ordinary returned outcome sum; here it is a
// two-case ENUM that is produced conditionally, then MATCHED and handled, with the loop
// accumulating successes and counting errors. Safe-dividing 10/2, 7/0, 20/4 yields
// Ok(5), Err, Ok(5); the Ok values sum to 10 and one Err is counted. The quotient is
// computed only in the divisor-nonzero branch (so a divide-by-zero is never executed --
// the error is data, not a trap), and the matched payload flows to the handler state.
// Exits 70.
use omega_language_std::console;

data DivResult {
    case Ok(value: i32 in Wrapping);
    case Err(code: i32 in Wrapping);
}

data Main {
    aa: [i32; 3];
    bb: [i32; 3];
    result: DivResult;
    i: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    q: i32 in Wrapping;
    acc: i32 in Wrapping;  // sum of Ok values
    errs: i32 in Wrapping; // count of Err
}

machine Main::main(main: &mut Main) reaches Console {
    main.aa = [10, 7, 20];
    main.bb = [2, 0, 4];
    main.i = 0;
    main.acc = 0;
    main.errs = 0;
    transition { _ -> loop(main) }

    state loop(main: &mut Main) {
        transition main.i >= 0 && main.i < 3 { true -> load(main) _ -> verify(main) }
    }
    state load(main: &mut Main) {
        main.a = main.aa[main.i] as i32 in Wrapping;
        main.b = main.bb[main.i] as i32 in Wrapping;
        // produce a Result: Ok(a/b) when the divisor is nonzero, else Err
        transition main.b != 0 { true -> comp_ok(main) _ -> comp_err(main) }
    }
    state comp_ok(main: &mut Main) {
        main.q = main.a / main.b; // only reached when b != 0
        main.result = DivResult::Ok { value: main.q };
        transition { _ -> handle(main) }
    }
    state comp_err(main: &mut Main) {
        main.result = DivResult::Err { code: 1 };
        transition { _ -> handle(main) }
    }
    // match the Result and handle each case
    state handle(main: &mut Main) {
        transition main.result {
            DivResult::Ok { value } -> h_ok(main, value)
            DivResult::Err { code } -> h_err(main)
        }
    }
    state h_ok(main: &mut Main, v: i32 in Wrapping) {
        main.acc = main.acc + v;
        main.i = main.i + 1;
        transition { _ -> loop(main) }
    }
    state h_err(main: &mut Main) {
        main.errs = main.errs + 1;
        main.i = main.i + 1;
        transition { _ -> loop(main) }
    }

    state verify(main: &mut Main) {
        transition main.acc == 10 && main.errs == 1 { true -> good(main) _ -> wrong(main) }
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state wrong(main: &mut Main) {
        Console::exit_process(main.acc as i32); // surface the sum on regression
    }
}
