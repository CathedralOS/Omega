// A matched owned structural payload can initialize another result directly.
// Expected exit: 70.
use omega_language_std::console;

data Kind { case Other; case NotFound; }
data Outcome { case Error(kind: Kind); case Ok; }
data Wrapped { kind: Kind; }
machine reconstruct(result: Outcome) -> Outcome {
    transition result {
        Outcome::Error { kind } -> Outcome::Error { kind: kind }
        Outcome::Ok -> Outcome::Ok
    }
}
machine wrap(result: Outcome) -> Wrapped {
    transition result {
        Outcome::Error { kind } -> Wrapped { kind: kind }
        Outcome::Ok -> Wrapped { kind: Kind::Other }
    }
}
machine reconstruct_through_state(result: Outcome) -> Outcome {
    transition result {
        Outcome::Error { kind } -> forwarded(kind)
        Outcome::Ok -> Outcome::Ok
    }
    state forwarded(kind: Kind) -> Outcome { Outcome::Error { kind: kind } }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: Outcome = reconstruct(Outcome::Error { kind: Kind::NotFound });
    transition result {
        Outcome::Error { kind } -> verify(main, kind)
        Outcome::Ok -> fail(main)
    }
    state verify(main: &mut Main, kind: Kind) {
        transition kind { Kind::NotFound -> record(main) _ -> fail(main) }
    }
    state record(main: &mut Main) {
        let wrapped: Wrapped = wrap(Outcome::Error { kind: Kind::NotFound });
        transition wrapped.kind { Kind::NotFound -> forwarded(main) _ -> fail(main) }
    }
    state forwarded(main: &mut Main) {
        let result: Outcome = reconstruct_through_state(Outcome::Error { kind: Kind::NotFound });
        transition result { Outcome::Error { kind } -> forwarded_kind(main, kind) _ -> fail(main) }
    }
    state forwarded_kind(main: &mut Main, kind: Kind) {
        transition kind { Kind::NotFound -> other(main) _ -> fail(main) }
    }
    state other(main: &mut Main) {
        let result: Outcome = reconstruct(Outcome::Error { kind: Kind::Other });
        transition result { Outcome::Error { kind } -> other_kind(main, kind) _ -> fail(main) }
    }
    state other_kind(main: &mut Main, kind: Kind) {
        transition kind { Kind::Other -> empty(main) _ -> fail(main) }
    }
    state empty(main: &mut Main) {
        let result: Outcome = reconstruct(Outcome::Ok);
        transition result { Outcome::Ok -> finish(main) _ -> fail(main) }
    }
    state finish(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main) { Console::exit_process(71); }
}
