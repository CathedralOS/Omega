// A returned case payload taken from an owned structural STATE PARAMETER.
// `pc_err` carries `kind: Kind` as a formal and returns
// `Res::Error { kind: kind }` -- the shape std::filesystem's `rdie_err` uses.
// The value planner once described a parameter-rooted scalar-case place as a
// StructuralLocal, so the returned-value consumption walk searched the state's
// result-binding roster for a formal that never mints one and omitted the
// whole unit plan. A formal is a `Parameter` source, whose consumption is the
// call's own transfer. The identical construction with `kind` a structural
// local from a call was always admitted, which is why the sibling Filesystem
// machines that build their kind as a local stayed green. Exits 70.
use omega_language_std::console;
data Kind { case Other; case NotFound; }
data Res { case Error(kind: Kind); case Empty; }
data Probe { seen: i32; }
machine Probe::classify(probe: &mut Probe, flag: bool) -> Res {
    probe.seen = 1;
    transition flag {
        true -> pc_empty(probe)
        _ -> pc_err(probe, Kind::NotFound)
    }
    state pc_empty(probe: &mut Probe) -> Res { Res::Empty }
    state pc_err(probe: &mut Probe, kind: Kind) -> Res { Res::Error { kind: kind } }
}
data Main { probe: Probe; result: Res; }
machine Main::main(main: &mut Main) reaches Console {
    main.result = Probe::classify(&mut main.probe, false);
    transition main.result {
        Res::Empty -> bad(main, 71)
        _ -> good(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
