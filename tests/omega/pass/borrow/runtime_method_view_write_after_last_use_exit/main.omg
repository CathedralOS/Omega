// RUN canary (lifetimes stage 1, the complement of
// fail/borrow/method_view_receiver_unrelated_field_write): the whole-record
// loan of a returned view ends at the view's LAST USE, not at scope
// end -- so writing another field of the local record AFTER the final write
// through the view must compile (use-ranged loans, Rust's NLL shape). The
// runtime assertion proves both writes landed: 7 through the view into
// cells[2], then 63 directly into `other` (sum 70).

use omega_language_std::console;

data Cell {
    value: i32;
}

data Bag {
    cells: [Cell; 4];
    other: i32;
}

machine Bag::pick(bag: &mut Bag) -> &mut Cell {
    let slots: &mut [Cell] = bag.cells.as_mut_slice();
    transition {
        _ -> &mut slots[2]
    }
}

machine main() reaches Console {
    let mut bag: Bag;
    let cell: &mut Cell = Bag::pick(&mut bag);
    cell.value = 7;
    // `cell` is dead from here on: the whole-record loan has ended.
    bag.other = 63;
    transition (bag.cells[2].value as i64) + (bag.other as i64) == 70 {
        true -> good()
        false -> bad()
    }
    state good() {
        Console::exit_process(70);
    }
    state bad() {
        Console::exit_process(71);
    }
}
