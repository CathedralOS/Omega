machine build(builder: &mut Build) {
    Build::application(builder, "runtime_mutable_argument_shared_boundary_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, linux_arm64);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, linux_x86_64);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, macos_arm64);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, macos_x86_64);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, windows_x86_64);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, uefi_x86_64);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, cross_platform_cli);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, local_unchecked);
    Build::select_provider<Observe, ObserverObserveImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
