data Cell { padding: i64; value: i64; }
data Main { position: u64; }

machine replace(cells: &write [Cell; 2], position: u64, incoming: Cell)
requires position < 2 {
    cells[position] = incoming;
}

machine Main::main(main: &mut Main) crashes Trap {
    let mut cells: [Cell; 2] = [
        Cell { padding: 11, value: 85 },
        Cell { padding: 23, value: 29 }
    ];
    let incoming: Cell = Cell { padding: 31, value: -17 };
    main.position = 1;
    replace(&write cells, main.position, incoming);
    transition cells[0].padding == 11 && cells[0].value == 85
        && cells[1].padding == 31 && cells[1].value == -17 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
