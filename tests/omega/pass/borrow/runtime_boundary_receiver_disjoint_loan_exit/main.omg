use omega_language_std::console;

data Main { bytes: [u8; 2]; }

// Explicit disjoint arguments lend the capability and the byte field.
// Keep the loan live through an internal state and a boundary invocation.
machine Main::publish(bytes: &[u8]) reaches Console {
    transition { _ -> forward(bytes) }
    machine forward(bytes: &[u8]) {
        Console::write_line(bytes);
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[0] = 79;
    main.bytes[1] = 75;
    let bytes_0__2_value: u8 = main.bytes[0..2];
    Main::publish(bytes_0__2_value);
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
