data Cell { value: i64; }
data Held { stamp: i64; target: &mut Cell; }
data Main { left: Cell; right: Cell; }

machine replace(held: &write Held, incoming: Held) { held = incoming; }

machine Main::main(main: &mut Main) crashes Trap {
    main.left.value = 11;
    main.right.value = 85;
    let mut held: Held = Held { target: &mut main.left, stamp: 17 };
    let incoming: Held = Held { target: &mut main.right, stamp: 23 };
    replace(&write held, identity(identity(incoming)));
    held.target.value = 89;
    main.left.value = 29;
    let current: &Cell = &held.target;
    let observed: i64 = current.value;
    main.right.value = 41;
    let stamp: i64 = held.stamp;
    transition observed == 89 && stamp == 23 && main.left.value == 29 && main.right.value == 41 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

machine identity(value: Held) -> Held { value }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
