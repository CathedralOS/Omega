// Expected exit: 0.
machine main() crashes Trap {
    let bytes: &[u8] = "abcd";
    let window: &[u8] = bytes[1..3];
    let selected: addr = address_of(&window[0]);
    let original: addr = address_of(&bytes[1]);
    let sibling: addr = address_of(&bytes[2]);
    transition selected == original && selected != sibling && selected != 0 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
