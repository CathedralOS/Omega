data Cell [copy] { padding: i64; value: i64; }
data Main { cells: [Cell; 2]; position: u64; replacement: Cell; }

machine replace(cells: &write [Cell; 2], position: u64, incoming: Cell)
requires position < 2
{
    cells[position] = incoming;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.cells[0].padding = 11;
    main.cells[0].value = 85;
    main.cells[1].padding = 23;
    main.cells[1].value = 29;
    main.position = 1;
    main.replacement.padding = 31;
    main.replacement.value = -17;
    replace(&write main.cells, main.position, main.replacement);
    transition main.cells[0].padding == 11 && main.cells[0].value == 85
        && main.cells[1].padding == 31 && main.cells[1].value == -17
        && main.replacement.padding == 31 && main.replacement.value == -17 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
