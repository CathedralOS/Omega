data Cell [copy] { padding: i64; value: i64; }
data Pair [copy] { left: Cell; right: Cell; }
data Main { pair: Pair; }

machine Cell::replace(cell: &write Cell, value: i64) { cell.value = value; }

machine forward(pair: &mut Pair, value: i64) {
    transition { _ -> selected(&write pair.right, value) }
    state selected(cell: &write Cell, value: i64) {
        transition { _ -> store(&write cell, value) }
    }
    state store(cell: &write Cell, value: i64) {
        Cell::replace(&write cell, value);
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.pair.left.padding = 11;
    main.pair.left.value = 17;
    main.pair.right.padding = 23;
    main.pair.right.value = 29;
    forward(&mut main.pair, -43);
    transition main.pair.left.padding == 11 && main.pair.left.value == 17
        && main.pair.right.padding == 23 && main.pair.right.value == -43 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
