data Cell [copy] { padding: i64; value: i64; }
data Main { position: u64; }

machine Cell::replace(cell: &write Cell, value: i64) { cell.value = value; }

machine replace_selected(cells: &write [Cell; 3], position: u64, value: i64)
requires position < 3 {
    Cell::replace(&write cells[position], value);
}

machine Main::main(main: &mut Main) crashes Trap {
    let mut cells: [Cell; 3] = [
        Cell { padding: 11, value: 17 },
        Cell { padding: 23, value: 29 },
        Cell { padding: 31, value: 37 }
    ];
    main.position = 1;
    replace_selected(&write cells, main.position, 43);
    main.position = 2;
    Cell::replace(&write cells[main.position], 47);
    transition cells[0].value == 17 && cells[1].value == 43
        && cells[2].value == 47 && cells[0].padding == 11
        && cells[1].padding == 23 && cells[2].padding == 31 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
