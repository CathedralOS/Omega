data Observation [copy] { value: i32; }
data Counter { calls: i32 in Wrapping; }
data Main { counter: Counter; }

machine replace(destination: &write i32) -> Observation {
    destination = 42;
    Observation { value: 19 }
}

machine replace_and_observe(destination: &write i32) -> i32 {
    replace(&write destination).value
}

machine replace_array(destination: &write i32, counter: &mut Counter) -> [i32; 2] {
    destination = 63;
    counter.calls = counter.calls + 1;
    [23, 29]
}

machine replace_array_and_observe(destination: &write i32, counter: &mut Counter, position: u64) -> i32 requires position <= 1 {
    replace_array(&write destination, counter)[position]
}

machine Main::main(main: &mut Main) crashes Trap {
    let mut backing: i32 = 7;
    let observation: i32 = replace_and_observe(&write backing);
    let mut other_backing: i32 = 11;
    main.counter.calls = 0;
    let selected: i32 = replace_array_and_observe(&write other_backing, &mut main.counter, 1);
    transition backing == 42 && observation == 19
        && other_backing == 63 && selected == 29 && main.counter.calls == 1 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
