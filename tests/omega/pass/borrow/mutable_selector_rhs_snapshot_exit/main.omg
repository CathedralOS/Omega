// A selector assignment evaluates its old value before storing the new value.
// Expected exit: 0
machine select<'storage>(chosen: &'storage mut u64, other: &'storage mut u64, pick_chosen: bool) -> &'storage mut u64 {
    transition pick_chosen {
        true -> chosen
        _ -> other
    }
}

machine choose<'storage>(chosen: &'storage mut u64, other: &'storage mut u64, mut pick_chosen: bool) -> &'storage mut u64 {
    pick_chosen = !pick_chosen;
    let result: &'storage mut u64 = select(chosen, other, pick_chosen);
    pick_chosen = !pick_chosen;
    result = 2;
    result
}

machine overwrite(slot: &mut u64) -> u64 in Wrapping {
    slot = 9;
    (1 as u64 in Wrapping)
}

machine main() crashes Trap {
    let mut chosen: u64 = 0;
    let mut other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    let marker: u64 in Wrapping = overwrite(choose(&mut chosen, &mut other, true));
    let found: u8 = items[chosen];
    transition found == 4 && (marker as u64) == 1 && other == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
