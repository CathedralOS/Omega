use omega_language_std::console;

data Message { case Captured(value: i32); case Empty; }
data Counter { value: i32; calls: u32 in Wrapping; }

machine snapshot(counter: &mut Counter) -> Message {
    counter.calls = counter.calls + 1;
    Message::Captured { value: counter.value }
}

machine run(counter: &mut Counter) -> i32 {
    transition snapshot(counter) {
        Message::Captured { value } -> consume(counter, value)
        _ -> (72)
    }
    state consume(counter: &mut Counter, value: i32) -> i32 {
        counter.value = 99;
        transition value == 70 && counter.calls == 1 {
            true -> (70)
            _ -> (71)
        }
    }
}

data Main { counter: Counter; result: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.counter.value = 70;
    main.result = run(&mut main.counter);
    Console::exit_process(main.result);
}
