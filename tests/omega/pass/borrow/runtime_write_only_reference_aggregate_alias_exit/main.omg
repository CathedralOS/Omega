data Cell { value: i64; }
data Held { target: &Cell; stamp: i64; }
data Main { left: Cell; right: Cell; }

machine replace(held: &write Held, incoming: Held) { held = incoming; }

machine Main::main(main: &mut Main) crashes Trap {
    main.left.value = 11;
    main.right.value = 85;
    let mut held: Held = Held { target: &main.left, stamp: 17 };
    let incoming: Held = Held { target: &main.right, stamp: 23 };
    let slot: &write Held = &write held;
    slot = incoming;
    main.left.value = 29;
    let observed: i64 = held.target.value;
    main.right.value = 41;
    let stamp: i64 = held.stamp;
    transition observed == 85 && stamp == 23 && main.left.value == 29 && main.right.value == 41 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
