use omega::language::core::float_operations;
data Context { residuals: [f64; 8]; offset: i32; count: i32; }
machine shifted(values: &mut [f64], amount: f64) {
    transition { _ -> scan(values, amount, 0) }
    state scan(values: &mut [f64], amount: f64, index: i32 in Wrapping) {
        transition index >= 0 && index < values.len { true -> update(values, amount, index) _ -> {} }
    }
    state update(values: &mut [f64], amount: f64, index: i32 in Wrapping)
    requires index >= 0 && index < values.len {
        values[index] = values[index] - amount;
        transition { _ -> scan(values, amount, index + 1) }
    }
}
machine main(context: &mut Context) crashes Trap {
    context.residuals = [40.0, 40.0, 37.0, 33.0, 40.0, 40.0, 40.0, 40.0];
    context.offset = 1; context.count = 4;
    let last: i32 = context.count - 1;
    transition context.offset >= 0 && last >= context.offset && last < 8 { true -> run(context, last) _ -> bad() }
    state run(context: &mut Context, last: i32)
    requires context.offset >= 0 && last >= context.offset && last < 8 {
        let view: &mut [f64] = &mut context.residuals[context.offset..=last];
        shifted(view, 0.5);
        transition context.residuals[0] == 40.0 && context.residuals[1] == 39.5 && context.residuals[2] == 36.5 && context.residuals[3] == 32.5 && context.residuals[4] == 40.0 { true -> done() _ -> bad() }
    }
    state done() {} state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
