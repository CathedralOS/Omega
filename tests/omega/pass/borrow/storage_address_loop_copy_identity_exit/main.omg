// Expected exit: 0.
machine different(original: &[u64; 2], copied: &[u64; 2]) -> bool {
    let original_address: addr = address_of(&original[0]);
    let copied_address: addr = address_of(&copied[0]);
    (original_address != copied_address && original_address != 0 && copied_address != 0)
}
machine scan(original: &[u64; 2]) -> bool {
    transition { _ -> step(original, [7, 11], 0, true) }
    machine step(original: &[u64; 2], prior: [u64; 2], index: u64, valid: bool) -> bool {
        transition index < 3 { true -> body(original, prior, index, valid) false -> valid }
    }
    machine body(original: &[u64; 2], prior: [u64; 2], index: u64, valid: bool) -> bool requires index < 3 {
        let copied: [u64; 2] = [7, 11];
        let distinct: bool = different(&prior, &copied);
        transition { _ -> step(original, copied, index + 1, valid && distinct) }
    }
}
machine main() crashes Trap {
    let values: [u64; 2] = [7, 11];
    let valid: bool = scan(&values);
    transition valid { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
