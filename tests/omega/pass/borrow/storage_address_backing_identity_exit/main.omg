// Expected exit: 0.
data Cell { first: u64; second: u64; }
machine expose(value: &u64) -> addr { address_of(value) }
machine nested(outer: addr) -> bool {
    let value: u64 = 7;
    let current: addr = expose(&value);
    current != outer && current != 0 && current == address_of(&value)
}
machine main() crashes Trap {
    let mut value: u64 = 7;
    let view: &u64 = &value;
    let original: addr = address_of(&value);
    let forwarded: addr = expose(view);
    let compatible: &i64 = &value as &i64;
    let reinterpreted: addr = address_of(compatible);
    let separate: bool = nested(original);
    value = 11;
    let after_write: addr = address_of(&value);
    let cell: Cell = Cell { first: 7, second: 11 };
    let field: addr = expose(&cell.first);
    transition original == forwarded && original == reinterpreted && original == after_write && original != 0 && separate && value == 11 &&
        field == address_of(&cell.first) && field != address_of(&cell.second) {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
