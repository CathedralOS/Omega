// Expected exit: 0.
machine main() crashes Trap {
    let values: [u16; 3] = [7, 11, 13];
    let independent: [u16; 3] = values;
    let independent_address: addr = address_of(&independent[1]);
    let window: &[u16] = values[1..3];
    let selected: addr = address_of(&window[0]);
    let original: addr = address_of(&values[1]);
    let sibling: addr = address_of(&values[2]);
    transition selected == original && selected != sibling && selected != 0 && independent_address != original {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
