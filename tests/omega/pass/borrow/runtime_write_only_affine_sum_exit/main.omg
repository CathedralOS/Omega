// Completed affine sums replace tag and payload together without observing old contents.
data Reading { case Empty; case Pair(first: i64, second: i64); case Single(value: i64); }
data Main { reading: Reading; neighbor: i64; }
machine produce(incoming: Reading) -> Reading { incoming }
machine replace(reading: &write Reading, incoming: Reading) { reading = produce(incoming); }
machine Main::main(main: &mut Main) crashes Trap {
    main.neighbor = 85;
    replace(&write main.reading, Reading::Pair { first: 11, second: 23 });
    transition main.reading {
        Reading::Pair { first, second } -> pair(main, first, second)
        _ -> bad()
    }
    state pair(main: &mut Main, first: i64, second: i64) {
        transition first == 11 && second == 23 {
            true -> clear(main)
            _ -> bad()
        }
    }
    state clear(main: &mut Main) {
        replace(&write main.reading, Reading::Empty);
        transition main.reading {
            Reading::Empty -> refill(main)
            _ -> bad()
        }
    }
    state refill(main: &mut Main) {
        let incoming: Reading = Reading::Single { value: -17 };
        replace(&write main.reading, incoming);
        transition main.reading {
            Reading::Single { value } -> check(main, value)
            _ -> bad()
        }
    }
    state check(main: &mut Main, value: i64) {
        transition value == -17 && main.neighbor == 85 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
