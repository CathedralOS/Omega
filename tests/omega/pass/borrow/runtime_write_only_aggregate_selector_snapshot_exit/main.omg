// Assignment captures its destination before evaluating a mutating RHS.
// A persistent nested write-only loan also keeps its selected backing.
data Cell [copy] { padding: i64; value: i64; }
data Main { cells: [Cell; 2]; position: u64; replacement: Cell; }

machine reset(position: &mut u64, incoming: Cell) -> Cell {
    position = 0;
    incoming
}
machine replace(cells: &write [Cell; 2], position: &mut u64, incoming: Cell)
requires position < 2 {
    cells[position] = reset(&mut position, incoming);
}
machine captured(cells: &write [Cell; 2], position: &mut u64, incoming: Cell)
requires position < 2 {
    let parent: &write [Cell; 2] = &write cells;
    let selected: &write Cell = &write parent[position];
    position = 0;
    selected = incoming;
}
machine Main::main(main: &mut Main) crashes Trap {
    main.cells[0].padding = 11;
    main.cells[0].value = 85;
    main.cells[1].padding = 23;
    main.cells[1].value = 29;
    main.position = 1;
    main.replacement.padding = 31;
    main.replacement.value = -17;
    replace(&write main.cells, &mut main.position, main.replacement);
    transition main.position == 0 && main.cells[0].padding == 11 && main.cells[0].value == 85
        && main.cells[1].padding == 31 && main.cells[1].value == -17 {
        true -> again(main)
        _ -> bad()
    }
    state again(main: &mut Main) {
        main.position = 1;
        main.replacement.padding = 37;
        main.replacement.value = -19;
        captured(&write main.cells, &mut main.position, main.replacement);
        transition main.position == 0 && main.cells[0].padding == 11 && main.cells[0].value == 85
            && main.cells[1].padding == 37 && main.cells[1].value == -19
            && main.replacement.padding == 37 && main.replacement.value == -19 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
