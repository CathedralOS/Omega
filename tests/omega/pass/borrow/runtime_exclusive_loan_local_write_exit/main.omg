// RUN CANARY (exit 70). An immutable `&mut` local naming a place is that
// place: it plans no operation, and the write through the name is the
// ordinary store of `storage.raw`. Nothing reseats the binding, so the loan
// carries no runtime value of its own. Reading the field back afterwards
// proves the store reached the loaned storage and not a copy.
use omega_language_std::console;

data Main {
}

data Storage {
    raw: u8;
}

machine Main::main(context: &mut Main) reaches Console {
    let mut storage: Storage;
    storage.raw = 1;
    let seen: &mut u8 = &mut storage.raw;
    seen = 0;
    transition storage.raw == 0 {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
