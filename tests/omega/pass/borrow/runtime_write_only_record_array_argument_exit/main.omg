data Cell [copy] { value: i64; }
data Main { cells: [Cell; 2]; }

machine Cell::replace(cell: &write Cell, value: i64) { cell.value = value; }

machine Main::main(main: &mut Main) crashes Trap {
    main.cells[0].value = 85;
    let parent: &write [Cell; 2] = &write main.cells;
    let child: &write [Cell; 2] = &write parent;
    let leaf: &write [Cell; 2] = &write child;
    Cell::replace(&write leaf[1], 7);
    Cell::replace(&write leaf[1], 9);
    transition main.cells[0].value == 85 && main.cells[1].value == 9 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
