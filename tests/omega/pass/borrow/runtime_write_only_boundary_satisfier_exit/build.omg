machine build(builder: &mut Build) {
    Build::application(builder, "runtime_write_only_boundary_satisfier_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Store::write, Provider>(builder, windows_x86_64);
    Build::select_provider<Store::write, Provider>(builder, linux_x86_64);
    Build::select_provider<Store::write, Provider>(builder, macos_arm64);
    Build::select_provider<Store::write, Provider>(builder, linux_arm64);
}
