data Cell [copy] { padding: i64; value: i64; }
data Main { cells: [Cell; 2]; position: u64; }

machine Cell::replace(cell: &write Cell, value: i64) { cell.value = value; }

machine Main::main(main: &mut Main) crashes Trap {
    main.cells[0].padding = 11;
    main.cells[0].value = 85;
    main.cells[1].padding = 23;
    main.cells[1].value = 29;
    main.position = 1;
    let parent: &write [Cell; 2] = &write main.cells;
    let child: &write [Cell; 2] = &write parent;
    let selected: &write Cell = &write child[main.position];
    main.position = 0;
    Cell::replace(&write selected, 7);
    Cell::replace(&write selected, 9);
    selected.value = 13;
    transition main.cells[0].value == 85 && main.cells[1].value == 13
        && main.cells[0].padding == 11 && main.cells[1].padding == 23
        && main.position == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
