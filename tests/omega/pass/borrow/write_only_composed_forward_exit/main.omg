use omega_language_std::console;

data Pair { left: i32; right: i32; }
data Main { pair: Pair; }

machine replace(destination: &write i32, value: i32) {
    destination = value;
}

machine forward(destination: &write Pair, choose_left: bool, value: i32) {
    transition choose_left {
        true -> left(&write destination, value)
        false -> right(&write destination, value)
    }
    machine left(destination: &write Pair, value: i32) {
        replace(&write destination.left, value);
    }
    machine right(destination: &write Pair, value: i32) {
        replace(&write destination.right, value);
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.pair.left = 7;
    main.pair.right = 19;
    forward(&write main.pair, true, 42);
    forward(&write main.pair, false, -31);
    transition main.pair.left == 42 && main.pair.right == -31 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
