// A port read from an immediate port number checks and lowers: `in` writes
// the declared `u8` destination, and the machine declares the `PortIo` reach
// the instruction needs. This replaces an earlier fence that expected port
// reads to be unlowered; the missing-reach twin is
// fail/ports/asm_port_in_missing_reach.

data Main {
    byte: u8;
}

machine Main::main(main: &mut Main) reaches PortIo {
    asm clobbers rax, rdx, r10, r15 {
        in main.byte, 0x3F8
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches PortIo {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
