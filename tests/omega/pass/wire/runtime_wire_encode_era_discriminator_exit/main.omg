// Wire stage 2a, era discriminator (frozen decision 10): a schema with one
// declared version block snapshots that block as era 0 (the pre-versioning
// body), so the CURRENT body encodes era 1 -- the first byte every encoded
// message carries. The v1 era documented field 0 as i32; the current era
// retired it (reserved) and recycled the name onto field 1 as u32, which is
// exactly the evolution the discriminator exists to disambiguate.
//
// Expected bytes for { counter: 7 }, hand-computed:
//   era 1          -> 0x01        (one version block; current = highest era)
//   tag 1          -> 0x01
//   counter 7      -> 0x07
// written = 3.

use omega_language_std::console;

data VersionedMessage {
    version v1 {
        #0 counter: i32;
    }

    retired #0;
    #1 counter: u32;
}

data VersionedSample {
    counter: u32;
}

data Main {
    console: Console;
    buffer: [u8; 16];
    written: u64;
}

machine Main::main(&mut self) {
    let msg: VersionedSample = VersionedSample { counter: 7 };

    VersionedMessage::encode(&msg, &mut self.buffer, &mut self.written);

    transition self.written == 3 {
        true -> check_bytes()
        false -> bad()
    }

    state check_bytes(&mut self) {
        let ok: bool = self.buffer[0] == 1
            && self.buffer[1] == 1
            && self.buffer[2] == 7;
        transition ok {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
