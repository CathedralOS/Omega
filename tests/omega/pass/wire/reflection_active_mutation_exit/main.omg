// Expected exit: 0
use omega::language::core::reflect;
data Subject [copy] { #0 common: u64; #1 case Idle; #2 case Item(#0 payload: u64); }
data Seen { cases: u64; fields: u64; }
machine selected(seen: &mut Seen, info: &reflect::CaseInfo) {
    seen.cases = ((seen.cases as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
}
machine increment<Kind>(seen: &mut Seen, info: &reflect::FieldInfo, value: &mut Kind)
requires Kind == u64
{
    seen.fields = ((seen.fields as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
    value = ((value as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
}
machine main() crashes Trap {
    let mut subject: Subject = Subject::Item { common: 11u64, payload: 22u64 };
    let mut seen: Seen;
    reflect::visit_active_fields_mut<Subject, selected, increment>(&mut subject, &mut seen);
    let common_value: u64 = subject.common;
    transition subject {
        Subject::Item { common as _, payload } -> check(common_value, payload, &seen)
        _ -> bad()
    }
    machine check(common: u64, payload: u64, seen: &Seen) crashes Trap {
        transition common == 12u64 && payload == 23u64 && seen.cases == 1u64 && seen.fields == 2u64 {
            true -> done() false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
