// Chapter 21 encode and decode policies are ordinary requirement surfaces.
// The preserving carrier keeps the validated known value separate from
// uninterpreted relay bytes and codec-private ordering metadata.

use omega::language::std::wire;

data Message {
    value: u32;
}

data ExamplePolicy {
}

machine encode(
    value: &Message,
    out: &mut [u8],
    written: &mut u64
) satisfies Encode<ExamplePolicy, Message>::encode {
}

ExampleStrict:
    satisfies StrictDecode<ExamplePolicy, Message>
{
    machine decode_strict(bytes: &[u8]) -> DecodeResult<Message> {
        DecodeResult::Invalid
    }
}

ExampleProjecting:
    satisfies ProjectingDecode<ExamplePolicy, Message>
{
    machine decode_projecting(bytes: &[u8]) -> DecodeResult<Message> {
        DecodeResult::Invalid
    }
}

machine preserving_decode(
    bytes: &[u8]
) -> DecodeResult<Relayed<Message>>
satisfies PreservingDecode<ExamplePolicy, Message>::decode_preserving
{
    DecodeResult::Invalid
}

machine retain_remainder(
    bytes_and_ordering: &[u8]
) -> Relayed<Message> {
    let relayed: Relayed<Message> = Relayed {
        value: Message { value: 7 },
        remainder: OpaqueWireRemainder {
            codec_identity: 42,
            bytes_and_ordering: bytes_and_ordering,
        },
    };
    transition {
        _ -> relayed
    }
}

data Main {
}

machine Main::main(&mut self) {
}
