// Chapter 20 (Wire Protocols): the encoding-family axis rides a PLAIN `data`
// with identity numbers on its fields. `wire` IS a recognized top-level
// contextual keyword -- what is retired is the `wire data` declaration form,
// which `parse_declaration.rs` refuses by name and redirects to exactly the
// spelling below. This canary pins that the replacement compiles.

data CounterMessage {
    #0 counter: i32;
    #1 timestamp_millis: i64;
}

data Main {
}

machine Main::main(&mut self) {
}
