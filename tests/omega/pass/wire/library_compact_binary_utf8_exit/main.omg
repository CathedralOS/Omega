    let max_four: [u8; 4] = [244u8, 143u8, 191u8, 191u8];
    let mixed: [u8; 7] = [65u8, 226u8, 130u8, 172u8, 194u8, 128u8, 0u8];
    let lonely_tail: [u8; 1] = [128u8];
    let overlong_two: [u8; 2] = [192u8, 128u8];
