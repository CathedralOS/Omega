        && CompactBinary::valid_utf8(&min_two[..])
        && CompactBinary::valid_utf8(&max_two[..])
        && CompactBinary::valid_utf8(&euro[..])
        && CompactBinary::valid_utf8(&min_three[..])
        && CompactBinary::valid_utf8(&before_surrogate[..])
