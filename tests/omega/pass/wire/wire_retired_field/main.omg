// Data-level `retired #N;` seals a published field identity so later
// schema edits cannot silently reuse it.
data CounterMessage {
    #0 counter: i32;
    #1 timestamp_millis: i64;

    retired #3;
}
data Main { message: CounterMessage; }
machine Main::main(main: &mut Main) {
    main.message.counter = -7;
    main.message.timestamp_millis = 1700000000000;
    transition main.message.counter == -7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
