// RANGE ESTABLISHMENT AT THE WIRE BOUNDARY: hostile 200 must not enter the
// declared `u32 [0..=100]` field; a later in-range 50 must establish it.
use omega::language::std::console;
data Msg {
    #0 v: u32;
    #1 delta: i32;
}
data Val {
    v: u32 [0..=100];
    delta: i32 [-10..=10];
}
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    buffer: [u8; 32];
    bad_read: u64;
    bad_verdict: WireVerdict;
    good_read: u64;
    good_verdict: WireVerdict;
}
machine Main::main(&mut self) {
    // era 0, tag 0, value 200 (varint C8 01), tag 1, delta -20
    // (zigzag 39). Both declared ranges reject.
    self.buffer[0] = 0;
    self.buffer[1] = 0;
    self.buffer[2] = 200;
    self.buffer[3] = 1;
    self.buffer[4] = 1;
    self.buffer[5] = 39;
    let bad: Val = Val { v: 42, delta: 7 };
    Msg::decode(
        &mut bad,
        &self.buffer,
        &mut self.bad_read,
        &mut self.bad_verdict,
    );

    // Same envelope, now value 50 and delta -5 (zigzag 9).
    self.buffer[2] = 50;
    self.buffer[3] = 1;
    self.buffer[4] = 9;
    let good: Val = Val { v: 42, delta: 7 };
    Msg::decode(
        &mut good,
        &self.buffer,
        &mut self.good_read,
        &mut self.good_verdict,
    );

    transition {
        self.bad_verdict == WireVerdict::Sound -> accepted_hostile()
        bad.v != 42 || bad.delta != 7 -> corrupted_on_reject()
        self.good_verdict == WireVerdict::Sound && good.v == 50 && good.delta == 0 - 5 -> proven()
        _ -> broken()
    }
    state accepted_hostile(&mut self)    { self.console.exit_process(66); }
    state corrupted_on_reject(&mut self) { self.console.exit_process(67); }
    state proven(&mut self)              { self.console.exit_process(70); }
    state broken(&mut self)              { self.console.exit_process(71); }
}
