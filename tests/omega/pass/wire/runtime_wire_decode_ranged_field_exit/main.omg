// RANGE ESTABLISHMENT AT THE WIRE BOUNDARY: hostile 200 must not enter the
// declared `u32 in WireValue` field; a later in-range 50 must establish it.
use omega_language_std::console;
data Msg {
    #0 v: u32;
    #1 delta: i32;
}
domain u32::WireValue(value) requires value <= 100;
domain i32::WireDelta(value) requires 0 - 10 <= value && value <= 10;
data Val {
    v: u32 in WireValue;
    delta: i32 in WireDelta;
}
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 32];
    bad_read: u64;
    bad_verdict: WireVerdict;
    good_read: u64;
    good_verdict: WireVerdict;
}
machine Main::main(main: &mut Main) reaches Console {
    // era 0, tag 0, value 200 (varint C8 01), tag 1, delta -20
    // (zigzag 39). Both declared ranges reject.
    main.buffer[0] = 0;
    main.buffer[1] = 0;
    main.buffer[2] = 200;
    main.buffer[3] = 1;
    main.buffer[4] = 1;
    main.buffer[5] = 39;
    let bad: Val = Val { v: 42, delta: 7 };
    Msg::decode(
        &mut bad,
        &main.buffer,
        &mut main.bad_read,
        &mut main.bad_verdict,
    );

    // Same envelope, now value 50 and delta -5 (zigzag 9).
    main.buffer[2] = 50;
    main.buffer[3] = 1;
    main.buffer[4] = 9;
    let good: Val = Val { v: 42, delta: 7 };
    Msg::decode(
        &mut good,
        &main.buffer,
        &mut main.good_read,
        &mut main.good_verdict,
    );

    transition {
        main.bad_verdict == WireVerdict::Sound -> accepted_hostile(main)
        bad.v != 42 || bad.delta != 7 -> corrupted_on_reject(main)
        main.good_verdict == WireVerdict::Sound && good.v == 50 && good.delta == 0 - 5 -> proven(main)
        _ -> broken(main)
    }
    state accepted_hostile(main: &mut Main)    { Console::exit_process(66); }
    state corrupted_on_reject(main: &mut Main) { Console::exit_process(67); }
    state proven(main: &mut Main)              { Console::exit_process(70); }
    state broken(main: &mut Main)              { Console::exit_process(71); }
}
