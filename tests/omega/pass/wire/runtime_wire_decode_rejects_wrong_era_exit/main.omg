use omega_language_std::wire;
use omega::language::core::reflect;
// Wire stage 2b: decode only accepts the schema's CURRENT era
// (historical eras decode through format-package lineage sums). The buffer
// is hand-built with era byte 5 where the schema's current era is 0, so the
// decoder must report failure (`ok` = false). The failure flag is STICKY:
// the decoder keeps scanning (bounds-checked) after the mismatch, but no
// later step can set the flag back.
//
// Hand-computed walk over [5, 0, 0, 0, 0, 0, 0, 0]:
//   era    expect 0x00, sees 5 -> FAIL (consumes the byte)
//   tag 0  expect 0x00, sees 0 -> matches
//   counter varint reads 0x00  -> 0
//   tag 1  expect 0x01, sees 0 -> still failed
//   delta varint reads 0x00    -> 0
//   tag 2  expect 0x02, sees 0 -> still failed
//   flag varint reads 0x00     -> false
// read = 7, ok = false -- the canary takes the failure path and exits 70.

use omega_language_std::console;

data CounterMessage {
    #0 counter: u32;
    #1 delta: i32;
    #2 flag: bool;
}

data CounterSample {
    counter: u32;
    delta: i32;
    flag: bool;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data OwnerVerdict {
    case Invalid;
    case Sound;
}

data Main {
    read: u64;
    verdict: OwnerVerdict;
}

machine Main::main(main: &mut Main) reaches Console {
    let buffer: [u8; 8] = [5, 0, 0, 0, 0, 0, 0, 0];

    let decoded: CounterSample = CounterSample {
        counter: 0,
        delta: 0,
        flag: false
    };

    CounterMessageCodec::decode(&mut decoded, &buffer, &mut main.read, &mut main.verdict);

    transition main.verdict {
        OwnerVerdict::Sound -> bad(main)
        OwnerVerdict::Invalid -> good(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

// The source-owned constructor receives carrier-validated words only.
data CounterMessageCodec {}
machine CounterMessageCodec::plan(context: &mut ScalarPlanContext) {
    reflect::inspect_record_fields<CounterMessage, CompactBinary::plan_scalar>(context);
}
machine CounterMessageCodec::construct(bytes: &[u8], fields: &[ScalarSlot]) -> DecodeResult<CounterSample> {
    transition fields.len == 3u64 { true -> create(fields) false -> DecodeResult::Invalid }
    machine create(fields: &[ScalarSlot]) -> DecodeResult<CounterSample>
    requires fields.len == 3u64
    {
        let counter: u64 = fields[0u64].unsigned;
        let delta: i64 = fields[1u64].signed;
        let flag: u64 = fields[2u64].unsigned;
        transition counter <= 4294967295u64 && delta >= (0i64 - 2147483648i64) && delta <= 2147483647i64 && flag <= 1u64 {
            true -> establish(counter, delta, flag)
            false -> DecodeResult::Invalid
        }
    }
    machine establish(counter: u64, delta: i64, flag: u64) -> DecodeResult<CounterSample>
    requires counter <= 4294967295u64 && delta >= (0i64 - 2147483648i64) && delta <= 2147483647i64 && flag <= 1u64
    { DecodeResult::Sound { value: CounterSample { counter: counter as u32, delta: delta as i32, flag: flag == 1u64 } } }
}
machine CounterMessageCodec::decode<const N: u64>(value: &mut CounterSample, bytes: &[u8; N], read: &mut u64, verdict: &mut OwnerVerdict) {
    let mut fields: [ScalarSlot; 3];
    transition CompactBinary::decode_record<CounterSample, CounterMessageCodec::plan, CounterMessageCodec::construct>(&bytes[..], &mut fields[..], read, 10000u64) {
        DecodeResult::Sound { value as decoded } -> commit(value, decoded, verdict)
        _ -> invalid(verdict)
    }
    machine commit(value: &mut CounterSample, decoded: CounterSample, verdict: &mut OwnerVerdict) {
        value = decoded;
        verdict = OwnerVerdict::Sound;
    }
    machine invalid(verdict: &mut OwnerVerdict) { verdict = OwnerVerdict::Invalid; }
}
