// Draft preserving codec execution regression; expected successful exit 70.
// Finite checks do not establish a general codec agreement proof or Derived trust.
// Encoder failure reports written=0. Capacity failure may leave a partial output;
// codec identity failure is checked before the first output write.
use omega_language_std::console;
use omega_language_std::wire;
use omega::language::core::binding;

data PreservePolicy {
}

// v1 consumer schema: `value` is the only known member. A later writer's
// extra members stay opaque relay bytes, not a rejection or silent drop.
data LocalMessage {
    value: u8;
}

machine preserving_decode(
    bytes: &[u8]
) -> DecodeResult<Relayed<LocalMessage>>
satisfies PreservingDecode<PreservePolicy, LocalMessage>::decode_preserving
{
    transition bytes.len >= 1 {
        true -> DecodeResult::Sound {
            value: Relayed {
                value: LocalMessage { value: bytes[0] },
                remainder: OpaqueWireRemainder {
                    codec_identity: 7,
                    bytes_and_ordering: bytes[1..bytes.len],
                },
            },
        }
        false -> DecodeResult::Invalid
    }
}

machine preserving_encode(
    value: &Relayed<LocalMessage>, out: &mut [u8], written: &mut u64
) satisfies Encode<PreservePolicy, Relayed<LocalMessage>>::encode
{
    written = 0;
    transition value.remainder.codec_identity == 7 {
        true -> capacity(value, out, written)
        false -> refused(written)
    }
    state capacity(value: &Relayed<LocalMessage>, out: &mut [u8], written: &mut u64) {
        transition out.len > 0 {
            true -> first(value, out, written)
            false -> refused(written)
        }
    }
    state first(value: &Relayed<LocalMessage>, out: &mut [u8], written: &mut u64) {
        out[0] = value.value.value;
        transition { _ -> copy_tail(value.remainder.bytes_and_ordering, out, written, 0, 1) }
    }
    state copy_tail(tail: &[u8], out: &mut [u8], written: &mut u64, index: u64, at: u64) {
        transition index < tail.len {
            true -> room(tail, out, written, index, at)
            false -> complete(written, at)
        }
    }
    state room(tail: &[u8], out: &mut [u8], written: &mut u64, index: u64, at: u64) {
        transition at < out.len {
            true -> emit(tail, out, written, index, at)
            false -> refused(written)
        }
    }
    state emit(tail: &[u8], out: &mut [u8], written: &mut u64, index: u64, at: u64) {
        out[at] = tail[index];
        transition { _ -> copy_tail(tail, out, written, index + 1, at + 1) }
    }
    state complete(written: &mut u64, count: u64) { written = count; }
    state refused(written: &mut u64) { written = 0; }
}

data Main {
    console: Binding<Console>;
    buffer: [u8; 3];
    output: [u8; 3];
    written: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.buffer[0] = 41;
    main.buffer[1] = 171;
    main.buffer[2] = 205;
    let invalid: DecodeResult<Relayed<LocalMessage>> =
        preserving_decode(main.buffer[0..0]);
    transition invalid {
        DecodeResult::Sound { value } -> invalid_accepted(main)
        DecodeResult::Invalid -> decode_original(main)
    }
    state decode_original(main: &mut Main) {
        let decoded: DecodeResult<Relayed<LocalMessage>> =
            preserving_decode(main.buffer[0..3]);
        transition decoded {
            DecodeResult::Sound { value } -> inspect(main, value)
            DecodeResult::Invalid -> refused(main)
        }
    }
    state inspect(main: &mut Main, relayed: Relayed<LocalMessage>) {
        transition relayed.value.value == 41
            && relayed.remainder.codec_identity == 7
            && relayed.remainder.bytes_and_ordering.len == 2 {
            true -> tail_first(main, relayed, 0)
            false -> disagreement(main)
        }
    }
    state tail_first(main: &mut Main, relayed: Relayed<LocalMessage>, i: u64) {
        transition i < relayed.remainder.bytes_and_ordering.len {
            true -> tail_first_byte(main, relayed.remainder.bytes_and_ordering[i], relayed)
            false -> disagreement(main)
        }
    }
    state tail_first_byte(main: &mut Main, b: u8, relayed: Relayed<LocalMessage>) {
        transition b == 171 {
            true -> tail_second(main, relayed, 1)
            false -> disagreement(main)
        }
    }
    state tail_second(main: &mut Main, relayed: Relayed<LocalMessage>, i: u64) {
        transition i < relayed.remainder.bytes_and_ordering.len {
            true -> tail_second_byte(main, relayed.remainder.bytes_and_ordering[i], relayed)
            false -> disagreement(main)
        }
    }
    state tail_second_byte(main: &mut Main, b: u8, relayed: Relayed<LocalMessage>) {
        transition b == 205 {
            true -> relay(main, relayed)
            false -> disagreement(main)
        }
    }
    state relay(main: &mut Main, relayed: Relayed<LocalMessage>) {
        preserving_encode(&relayed, &mut main.output, &mut main.written);
        transition main.written == 3 && main.output[0] == 41
            && main.output[1] == 171 && main.output[2] == 205 {
            true -> update_known(main, relayed)
            false -> relay_disagreement(main)
        }
    }
    state update_known(main: &mut Main, relayed: Relayed<LocalMessage>) {
        // Known semantics can change independently; the opaque ordered tail
        // remains borrowed from the original input without reinterpretation.
        let updated: Relayed<LocalMessage> = Relayed {
            value: LocalMessage { value: 42 },
            remainder: relayed.remainder,
        };
        preserving_encode(&updated, &mut main.output, &mut main.written);
        transition main.written == 3 && main.output[0] == 42
            && main.output[1] == 171 && main.output[2] == 205
            && main.buffer[0] == 41 && main.buffer[1] == 171 && main.buffer[2] == 205 {
            true -> wrong_codec(main, updated)
            false -> known_disagreement(main)
        }
    }
    state wrong_codec(main: &mut Main, relayed: Relayed<LocalMessage>) {
        // The public envelope is forgeable. Its codec identity is checked by
        // this authored encoder before it writes any output byte.
        let wrong_policy: Relayed<LocalMessage> = Relayed {
            value: LocalMessage { value: 99 },
            remainder: OpaqueWireRemainder {
                codec_identity: 8,
                bytes_and_ordering: relayed.remainder.bytes_and_ordering,
            },
        };
        preserving_encode(&wrong_policy, &mut main.output, &mut main.written);
        transition main.written == 0 && main.output[0] == 42
            && main.output[1] == 171 && main.output[2] == 205 {
            true -> good(main)
            false -> foreign_accepted(main)
        }
    }
    state good(main: &mut Main)               { main.console.exit_process(70); }
    state refused(main: &mut Main)            { main.console.exit_process(71); }
    state disagreement(main: &mut Main)       { main.console.exit_process(72); }
    state relay_disagreement(main: &mut Main) { main.console.exit_process(73); }
    state known_disagreement(main: &mut Main) { main.console.exit_process(74); }
    state invalid_accepted(main: &mut Main)    { main.console.exit_process(75); }
    state foreign_accepted(main: &mut Main)    { main.console.exit_process(76); }
}
