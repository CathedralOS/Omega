// RUN CANARY (exit 70). The board's residual -- "no codec publishes
// preserving decode" -- ends here: the first AUTHORED `PreservingDecode`
// realization that executes on every engine. The decoder validates the
// known member (`value`) from the frame head and binds the still-unknown
// tail bytes into `OpaqueWireRemainder` under the codec's own identity;
// the consumer then reads the decoded value AND the retained tail back
// through `Relayed`, so remainder custody is runtime-observable rather
// than only admission-visible.
// exits: 71 = the decoder returned Invalid; 72 = the decoded value or the
//        remainder's identity/length/bytes disagreed with the frame.
use omega_language_std::console;
use omega_language_std::wire;
use omega::language::core::service;

data PreservePolicy {
}

// v1 consumer schema: `value` is the only known member. A later writer's
// extra members stay opaque relay bytes, not a rejection or silent drop.
data LocalMessage {
    value: u8;
}

machine preserving_decode(
    bytes: &[u8]
) -> DecodeResult<Relayed<LocalMessage>>
satisfies PreservingDecode<PreservePolicy, LocalMessage>::decode_preserving
{
    transition bytes.len >= 1 {
        true -> DecodeResult::Sound {
            value: Relayed {
                value: LocalMessage { value: bytes[0] },
                remainder: OpaqueWireRemainder {
                    codec_identity: 7,
                    bytes_and_ordering: bytes[1..bytes.len],
                },
            },
        }
        false -> DecodeResult::Invalid
    }
}

data Main {
    console: Binding<Console>;
    buffer: [u8; 3];
}

machine Main::main(&mut self) reaches Console {
    self.buffer[0] = 41;
    self.buffer[1] = 171;
    self.buffer[2] = 205;
    let decoded: DecodeResult<Relayed<LocalMessage>> =
        preserving_decode(self.buffer[0..3]);
    transition decoded {
        DecodeResult::Sound { value } -> inspect(value)
        DecodeResult::Invalid -> refused()
    }
    state inspect(&mut self, relayed: Relayed<LocalMessage>) {
        transition relayed.value.value == 41
            && relayed.remainder.codec_identity == 7
            && relayed.remainder.bytes_and_ordering.len == 2 {
            true -> tail_first(relayed.remainder.bytes_and_ordering, 0)
            false -> disagreement()
        }
    }
    state tail_first(&mut self, tail: &[u8], i: u64) {
        transition i < tail.len {
            true -> tail_first_byte(tail, tail[i])
            false -> disagreement()
        }
    }
    state tail_first_byte(&mut self, tail: &[u8], b: u8) {
        transition b == 171 {
            true -> tail_second(tail, 1)
            false -> disagreement()
        }
    }
    state tail_second(&mut self, tail: &[u8], i: u64) {
        transition i < tail.len {
            true -> tail_second_byte(tail[i])
            false -> disagreement()
        }
    }
    state tail_second_byte(&mut self, b: u8) {
        transition b == 205 {
            true -> good()
            false -> disagreement()
        }
    }
    state good(&mut self)         { self.console.exit_process(70); }
    state refused(&mut self)      { self.console.exit_process(71); }
    state disagreement(&mut self) { self.console.exit_process(72); }
}
