// Preserving codec execution regression; expected successful exit 70.
// Finite checks do not establish a general codec agreement proof or Derived trust.
// Encoder failure reports written=0. Capacity failure may leave a partial output;
// codec identity failure is checked before the first output write.
use omega_language_std::Console;
use omega::language::core::DecodeResult;
use omega::language::core::OpaqueWireRemainder;
use omega::language::core::Relayed;
use omega::language::core::Encode;
use omega::language::core::PreservingDecode;

data PreservePolicy {
}

// v1 consumer schema: `value` is the only known member. A later writer's
// extra members stay opaque relay bytes, not a rejection or silent drop.
data LocalMessage {
    value: u8;
}

machine preserving_decode(
    bytes: &[u8]
) -> DecodeResult<Relayed<LocalMessage>>
satisfies PreservingDecode<PreservePolicy, LocalMessage>::decode_preserving
{
    transition bytes.len >= 1 {
        true -> DecodeResult::Sound {
            value: Relayed {
                value: LocalMessage { value: bytes[0] },
                remainder: OpaqueWireRemainder {
                    codec_identity: 7,
                    bytes_and_ordering: bytes[1..bytes.len],
                },
            },
        }
        false -> DecodeResult::Invalid
    }
}

machine preserving_encode(
    value: &Relayed<LocalMessage>, out: &mut [u8], written: &mut u64
) satisfies Encode<PreservePolicy, Relayed<LocalMessage>>::encode
{
    written = 0;
    transition value.remainder.codec_identity == 7 {
        true -> capacity(value, out, written)
        false -> refused(written)
    }
    machine capacity(value: &Relayed<LocalMessage>, out: &mut [u8], written: &mut u64) {
        transition out.len > 0 {
            true -> first(value, out, written)
            false -> refused(written)
        }
    }
    machine first(value: &Relayed<LocalMessage>, out: &mut [u8], written: &mut u64) {
        out[0] = value.value.value;
        transition { _ -> copy_tail(value.remainder.bytes_and_ordering, out, written, 0, 1) }
    }
    machine copy_tail(tail: &[u8], out: &mut [u8], written: &mut u64, index: u64, at: u64) {
        transition index < tail.len {
            true -> room(tail, out, written, index, at)
            false -> complete(written, at)
        }
    }
    machine room(tail: &[u8], out: &mut [u8], written: &mut u64, index: u64, at: u64) {
        transition at < out.len {
            true -> emit(tail, out, written, index, at)
            false -> refused(written)
        }
    }
    machine emit(tail: &[u8], out: &mut [u8], written: &mut u64, index: u64, at: u64) {
        out[at] = tail[index];
        transition { _ -> copy_tail(tail, out, written, index + 1, at + 1) }
    }
    machine complete(written: &mut u64, count: u64) { written = count; }
    machine refused(written: &mut u64) { written = 0; }
}

// The decoded remainder borrows `buffer`, so the relay states receive the
// output sink exclusively and the input only as a shared view; an exclusive
// `&mut Main` beside a view into its own buffer would alias.
data Main {
    buffer: [u8; 3];
    sink: Sink;
}

data Sink {
    output: [u8; 3];
    written: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.buffer[0] = 41;
    main.buffer[1] = 171;
    main.buffer[2] = 205;
    let invalid: DecodeResult<Relayed<LocalMessage>> =
        preserving_decode(main.buffer[0..0]);
    transition invalid {
        DecodeResult::Sound { value } -> invalid_accepted(main)
        DecodeResult::Invalid -> decode_original(main)
    }
    machine decode_original(main: &mut Main) {
        let decoded: DecodeResult<Relayed<LocalMessage>> =
            preserving_decode(main.buffer[0..3]);
        transition decoded {
            DecodeResult::Sound { value } -> inspect(&mut main.sink, &main.buffer, value)
            DecodeResult::Invalid -> refused(main)
        }
    }
    machine inspect(sink: &mut Sink, input: &[u8; 3], relayed: Relayed<LocalMessage>) {
        transition relayed.value.value == 41
            && relayed.remainder.codec_identity == 7
            && relayed.remainder.bytes_and_ordering.len == 2 {
            true -> tail_first(sink, input, relayed, 0)
            false -> disagreement(sink, input)
        }
    }
    machine tail_first(sink: &mut Sink, input: &[u8; 3], relayed: Relayed<LocalMessage>, i: u64) {
        transition i < relayed.remainder.bytes_and_ordering.len {
            true -> tail_first_byte(sink, input, relayed.remainder.bytes_and_ordering[i], relayed)
            false -> disagreement(sink, input)
        }
    }
    machine tail_first_byte(sink: &mut Sink, input: &[u8; 3], b: u8, relayed: Relayed<LocalMessage>) {
        transition b == 171 {
            true -> tail_second(sink, input, relayed, 1)
            false -> disagreement(sink, input)
        }
    }
    machine tail_second(sink: &mut Sink, input: &[u8; 3], relayed: Relayed<LocalMessage>, i: u64) {
        transition i < relayed.remainder.bytes_and_ordering.len {
            true -> tail_second_byte(sink, input, relayed.remainder.bytes_and_ordering[i], relayed)
            false -> disagreement(sink, input)
        }
    }
    machine tail_second_byte(sink: &mut Sink, input: &[u8; 3], b: u8, relayed: Relayed<LocalMessage>) {
        transition b == 205 {
            true -> relay(sink, input, relayed)
            false -> disagreement(sink, input)
        }
    }
    machine relay(sink: &mut Sink, input: &[u8; 3], relayed: Relayed<LocalMessage>) {
        preserving_encode(&relayed, &mut sink.output, &mut sink.written);
        transition sink.written == 3 && sink.output[0] == 41
            && sink.output[1] == 171 && sink.output[2] == 205 {
            true -> update_known(sink, input, relayed)
            false -> relay_disagreement(sink, input)
        }
    }
    machine update_known(sink: &mut Sink, input: &[u8; 3], relayed: Relayed<LocalMessage>) {
        // Known semantics can change independently; the opaque ordered tail
        // remains borrowed from the original input without reinterpretation.
        let updated: Relayed<LocalMessage> = Relayed {
            value: LocalMessage { value: 42 },
            remainder: relayed.remainder,
        };
        preserving_encode(&updated, &mut sink.output, &mut sink.written);
        transition sink.written == 3 && sink.output[0] == 42
            && sink.output[1] == 171 && sink.output[2] == 205
            && input[0] == 41 && input[1] == 171 && input[2] == 205 {
            true -> wrong_codec(sink, input, updated)
            false -> known_disagreement(sink, input)
        }
    }
    machine wrong_codec(sink: &mut Sink, input: &[u8; 3], relayed: Relayed<LocalMessage>) {
        // The public envelope is forgeable. Its codec identity is checked by
        // this authored encoder before it writes any output byte.
        let wrong_policy: Relayed<LocalMessage> = Relayed {
            value: LocalMessage { value: 99 },
            remainder: OpaqueWireRemainder {
                codec_identity: 8,
                bytes_and_ordering: relayed.remainder.bytes_and_ordering,
            },
        };
        preserving_encode(&wrong_policy, &mut sink.output, &mut sink.written);
        transition sink.written == 0 && sink.output[0] == 42
            && sink.output[1] == 171 && sink.output[2] == 205 {
            true -> good(sink, input)
            false -> foreign_accepted(sink, input)
        }
    }
    machine good(sink: &mut Sink, input: &[u8; 3])               { Console::exit_process(70); }
    machine refused(main: &mut Main)                              { Console::exit_process(71); }
    machine disagreement(sink: &mut Sink, input: &[u8; 3])       { Console::exit_process(72); }
    machine relay_disagreement(sink: &mut Sink, input: &[u8; 3]) { Console::exit_process(73); }
    machine known_disagreement(sink: &mut Sink, input: &[u8; 3]) { Console::exit_process(74); }
    machine invalid_accepted(main: &mut Main)                     { Console::exit_process(75); }
    machine foreign_accepted(sink: &mut Sink, input: &[u8; 3])   { Console::exit_process(76); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
