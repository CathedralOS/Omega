// Wire REPEATED fields: a `FixedVec<scalar, max>` packs
// LENGTH-delimited (protobuf's packed encoding) -- tag varint + byte-LENGTH
// varint + back-to-back element varints, NO per-element tags. The carrier's
// own `length` selects the live inline elements; no synthetic sibling count
// field exists.
//
// Encoded bytes for { sensor_id: 7, samples: FixedVec([150, -2], len 2),
// flag: true }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00        (sensor_id)
//   sensor_id 7    -> 0x07
//   tag 1          -> 0x01        (samples)
//   length 3       -> 0x03        (the packed elements below)
//     150          -> 0xAC 0x02   (zigzag(150) = 300 = 0b1_0010_1100)
//     -2           -> 0x03        (zigzag(-2) = 3)
//   tag 2          -> 0x02        (flag)
//   flag true      -> 0x01
// written = 10; the decoder consumes the same 10 bytes (read = 10,
// ok = true), decodes both live elements, and writes samples.length = 2.

use omega::language::core::fixed_vec;
use omega::language::std::console;

data SensorReadings {
    #0 sensor_id: u32;
    #1 samples: FixedVec<i32, 4>;
    #2 flag: bool;
}

data SensorSample {
    sensor_id: u32;
    samples: FixedVec<i32, 4>;
    flag: bool;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(&mut self) {
    let msg: SensorSample = SensorSample {
        sensor_id: 7,
        samples: FixedVec { items: [150, 0 - 2, 0, 0], length: 2 },
        flag: true
    };

    SensorReadings::encode(&msg, &mut self.buffer, &mut self.written);

    let decoded: SensorSample = SensorSample {
        sensor_id: 0,
        samples: FixedVec { items: [0, 0, 0, 0], length: 0 },
        flag: false
    };

    SensorReadings::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);

    let matches: bool = self.verdict == WireVerdict::Sound
        && self.written == 10
        && self.read == 10
        && decoded.sensor_id == 7
        && decoded.samples.length == 2
        && decoded.samples.items[0] == 150
        && decoded.samples.items[1] == 0 - 2
        && decoded.flag;
    transition matches {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
