// The core FixedVec carrier is a wire member however its type is spelled:
// here through the fully qualified path. The encoder and decoder recognize
// the carrier by its declaration in core/fixed_vec.omg, not by the text
// `FixedVec`, so a spelling resolved through a generated family head still
// encodes as a packed repeated field.
use omega::language::core::fixed_vec;
data RoomPacket {
    #0 room_id: u32;
    #1 samples: omega::language::FixedVec<i32, 4>;
    #2 depth: i32;
}
data RoomPacketValue {
    room_id: u32;
    samples: FixedVec<i32, 4>;
    depth: i32;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
    packet: RoomPacketValue;
}
machine Main::main(main: &mut Main) {
    let msg: RoomPacketValue = RoomPacketValue {
        room_id: 300,
        samples: FixedVec { items: [150, 0 - 2, 0, 0], length: 2 },
        depth: 0 - 64,
    };
    RoomPacket::encode(&msg, &mut main.buffer, &mut main.written);
    RoomPacket::decode(&mut main.packet, &main.buffer, &mut main.read, &mut main.verdict);
    transition main.verdict == WireVerdict::Sound
        && main.written == 13
        && main.read == 13
        && main.packet.room_id == 300
        && main.packet.depth == 0 - 64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
