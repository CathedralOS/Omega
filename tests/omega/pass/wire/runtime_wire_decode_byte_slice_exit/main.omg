// Wire stage 2 (#43), borrowed `&[u8]` ZERO-COPY decode. `decode` reads a
// byte-LENGTH varint, bounds-checks it, then stores a fat `{ptr, len}`
// descriptor VIEWING the decode buffer in place -- no allocator, no copy -- and
// advances the cursor past the content. The decoded `&[u8]` borrows the buffer.
//
// This round-trips and proves the view is CONTENT-correct: encode
// { bytes: [72, 105] } to 5 bytes, decode it back into `decoded`, then
// RE-ENCODE `decoded` -- if its descriptor points at the right buffer bytes
// with the right length, the re-encode reproduces the same framing (length 2,
// then 0x48 0x69). Exits 70 when ok, read = 5, and the re-encoded content
// matches.

use omega_language_std::console;

data Blob {
    #0 bytes: &[u8];
}

data BlobSample {
    bytes: &[u8];
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    source: [u8; 4];
    buffer: [u8; 64];
    buffer2: [u8; 64];
    written: u64;
    written2: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source[0] = 72;
    main.source[1] = 105;
    let sample: BlobSample = BlobSample { bytes: main.source[0..2] };

    Blob::encode(&sample, &mut main.buffer, &mut main.written);

    let decoded: BlobSample = BlobSample { bytes: main.source[0..2] };
    Blob::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);

    Blob::encode(&decoded, &mut main.buffer2, &mut main.written2);

    let matches: bool = main.verdict == WireVerdict::Sound
        && main.read == 5
        && main.written2 == 5
        && main.buffer2[2] == 2
        && main.buffer2[3] == 72
        && main.buffer2[4] == 105;

    transition matches {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
