// MINT ARC RUNG 2b: THE POLICY AUTHORS THE WIRE PLAN. This is the
// byte-pinned compact_binary roundtrip with one addition: an inline
// `CompactBinary::plan(schema: Schema) -> Plan` grammar policy. Because it
// exists, the compiler MATERIALIZES each schema's facts (number + FieldKind),
// evaluates the policy at build time (purity-gated, the L0 engine), extracts
// the authored `Varint(tag)`/`LengthPrefixed(tag)` placements, and requires
// agreement with the codec walk -- the emitted tag bytes then come from the
// authored plan. The hand-computed bytes below must therefore still hold
// EXACTLY (the fail twin, wire_policy_plan_disagrees, proves divergence is a
// compile error -- the policy is load-bearing, not decorative).
//
// Wire stage 2b: the compact_binary v0 round trip. `encode` frames the
// message, `decode(&mut value, &buffer, &mut read, &mut ok)` reads it
// back: the CURRENT era varint must match byte for byte, then per field in
// field-number order the expected tag varint and a value varint (LEB128;
// signed values un-zigzag ((n >> 1) ^ -(n & 1)); bool 0/1). `read` receives
// the bytes consumed and `ok` the success flag.
//
// Encoded bytes for { counter: 300, delta: -2, flag: true }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00
//   counter 300    -> 0xAC 0x02   (300 = 0b1_0010_1100: low7 0101100|0x80 = 0xAC, then 0b10 = 0x02)
//   tag 1          -> 0x01
//   delta -2       -> 0x03        (zigzag(-2) = 3; unzigzag(3) = -2)
//   tag 2          -> 0x02
//   flag true      -> 0x01
// written = 8; the decoder consumes the same 8 bytes (read = 8, ok = true)
// and every decoded field equals the original.

use omega::language::std::console;

data CounterMessage {
    #0 counter: u32;
    #1 delta: i32;
    #2 flag: bool;
}

data CounterSample {
    counter: u32;
    delta: i32;
    flag: bool;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(&mut self) {
    let msg: CounterSample = CounterSample {
        counter: 300,
        delta: 0 - 2,
        flag: true
    };

    CounterMessage::encode(&msg, &mut self.buffer, &mut self.written);

    let decoded: CounterSample = CounterSample {
        counter: 0,
        delta: 0,
        flag: false
    };

    CounterMessage::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);

    let matches: bool = self.verdict == WireVerdict::Sound
        && self.written == 8
        && self.read == 8
        && decoded.counter == 300
        && decoded.delta == 0 - 2
        && decoded.flag;
    transition matches {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

// --- The grammar policy (std layout vocabulary, inlined) -----------------
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField { size: u64 [0..=4096]; align: u64 [1..=16]; number: i64; kind: FieldKind; }
data Schema { fields: [SchemaField; 32]; field_count: u64 [0..=32]; }
data FieldPlan {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data Plan { fields: [FieldPlan; 32]; entry_count: u64; size_fixed: u64; size_is_dynamic: bool; align: u64; }

data CompactBinary {
    plans: [FieldPlan; 32];
    index: u64 in Wrapping;
    tag: u64;
}
machine CompactBinary::plan(&mut self, schema: Schema) -> Plan {
    self.evaluate(schema, 128)
}

machine CompactBinary::evaluate(&mut self, schema: Schema, fuel: u64 [1..=128]) -> Plan
terminates by fuel;
{
    self.index = 0;
    transition { _ -> fill(schema, fuel) }

    state fill(&mut self, schema: Schema, fuel: u64 [1..=128]) {
        transition fuel > 1 && self.index < 32 && self.index < schema.field_count {
            true -> place(schema, fuel - 1)
            _ -> done(schema)
        }
    }
    state place(&mut self, schema: Schema, fuel: u64 [1..=128]) {
        self.tag = (schema.fields[self.index].number as u64 in Wrapping) as u64;
        self.plans[self.index] = field_plan(schema.fields[self.index].kind, self.tag);
        self.index = self.index + 1;
        transition fuel > 1 { true -> fill(schema, fuel - 1) _ -> done(schema) }
    }
    state done(&mut self, schema: Schema) -> Plan {
        Plan {
            fields: self.plans,
            entry_count: schema.field_count,
            size_fixed: 0,
            size_is_dynamic: true,
            align: 1,
        }
    }
}

machine field_plan(kind: FieldKind, tag: u64) -> FieldPlan {
    transition kind {
        FieldKind::Scalar -> varint(tag)
        FieldKind::Text -> blob(tag)
        FieldKind::Nested -> blob(tag)
        FieldKind::Repeated -> blob(tag)
    }
    state varint(tag: u64) -> FieldPlan { FieldPlan::Varint { tag: tag } }
    state blob(tag: u64) -> FieldPlan { FieldPlan::LengthPrefixed { tag: tag } }
}
