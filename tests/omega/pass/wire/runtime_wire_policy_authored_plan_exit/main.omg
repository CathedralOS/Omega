use omega::language::core::DecodeResult;
use omega::language::core::CompactBinary;
use omega::language::core::EncodeResult;
use omega::language::core::EncodedField;
use omega::language::core::EncodeContext;
use omega::language::core::CompactBinary::encode;
use omega::language::core::CompactBinary::scalar_field;
use omega::language::core::ScalarSlot;
use omega::language::core::ScalarPlanContext;
use omega::language::core::CompactBinary::plan_scalar;
use omega::language::core::CompactBinary::decode_record;
use omega::language::core::reflect;
// The owner builds an explicit WireSchema through authorized declaration
// inspection. AuthoredCompactBinary::plan evaluates as an ordinary source
// constant; a requires gate checks its placements against the source library's
// framing. The hand-computed bytes remain unchanged. The rejection twin
// changes the plan while retaining that same gate and byte grammar.
//
// Wire stage 2b: the compact_binary v0 round trip. `encode` frames the
// message, `decode(&mut value, &buffer, &mut read, &mut ok)` reads it
// back: the CURRENT era varint must match byte for byte, then per field in
// field-number order the expected tag varint and a value varint (LEB128;
// signed values un-zigzag ((n >> 1) ^ -(n & 1)); bool 0/1). `read` receives
// the bytes consumed and `ok` the success flag.
//
// Encoded bytes for { counter: 300, delta: -2, flag: true }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00
//   counter 300    -> 0xAC 0x02   (300 = 0b1_0010_1100: low7 0101100|0x80 = 0xAC, then 0b10 = 0x02)
//   tag 1          -> 0x01
//   delta -2       -> 0x03        (zigzag(-2) = 3; unzigzag(3) = -2)
//   tag 2          -> 0x02
//   flag true      -> 0x01
// written = 8; the decoder consumes the same 8 bytes (read = 8, ok = true)
// and every decoded field equals the original.

use omega_language_std::Console;
use omega::language::core::narrow_u64_to_i64_wrapping;
use omega::language::core::narrow_i64_to_u64_wrapping;

data CounterMessage {
    #0 counter: u32;
    #1 delta: i32;
    #2 flag: bool;
}

data CounterSample {
    #0 counter: u32;
    #1 delta: i32;
    #2 flag: bool;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data PolicyVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: PolicyVerdict;
}

machine Main::main(main: &mut Main) reaches Console {
    let msg: CounterSample = CounterSample {
        counter: 300,
        delta: 0 - 2,
        flag: true
    };

    PolicyCodec::encode(&msg, &mut main.buffer, &mut main.written);

    let mut decoded: CounterSample = CounterSample {
        counter: 0,
        delta: 0,
        flag: false
    };

    PolicyCodec::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);

    let matches: bool = main.verdict == PolicyVerdict::Sound
        && main.written == 8
        && main.read == 8
        && main.buffer[0] == 0
        && main.buffer[1] == 0
        && main.buffer[2] == 172
        && main.buffer[3] == 2
        && main.buffer[4] == 1
        && main.buffer[5] == 3
        && main.buffer[6] == 2
        && main.buffer[7] == 1
        && decoded.counter == 300
        && decoded.delta == 0 - 2
        && decoded.flag;
    transition matches {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// --- The grammar policy (std layout vocabulary, inlined) -----------------
data FieldKind [copy] { case Scalar; case Text; case Nested; case Repeated; }
data WireSchemaField [copy] { number: i64; kind: FieldKind; }
data WireSchema [copy] requires field_count <= 32 { fields: [WireSchemaField; 32]; field_count: u64; }
data FieldPlan [copy] {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data Plan { fields: [FieldPlan; 32]; entry_count: u64; size_fixed: u64; size_is_dynamic: bool; align: u64; }

data AuthoredCompactBinary {
    plans: [FieldPlan; 32];
    index: u64 in Wrapping;
    tag: u64;
}
machine AuthoredCompactBinary::plan(compact_binary: &mut AuthoredCompactBinary, schema: WireSchema) -> Plan {
    AuthoredCompactBinary::evaluate(compact_binary, schema, 128)
}

machine AuthoredCompactBinary::evaluate(compact_binary: &mut AuthoredCompactBinary, schema: WireSchema, remaining_steps: u64) -> Plan
requires 1 <= remaining_steps
requires remaining_steps <= 128
{
    transition { _ -> fill(compact_binary, schema, remaining_steps, 0) }

    // The remaining_steps witness belongs to the recursive fill/place component.
    machine fill(compact_binary: &mut AuthoredCompactBinary, schema: WireSchema, remaining_steps: u64, index: u64 in Wrapping) -> Plan
    requires 1 <= remaining_steps
    requires remaining_steps <= 128
    terminates by remaining_steps
    {
        transition remaining_steps > 1 && index < 32 && index < schema.field_count {
            true -> place(compact_binary, schema, remaining_steps - 1, index)
            _ -> done(compact_binary, schema)
        }
    }
    machine place(compact_binary: &mut AuthoredCompactBinary, schema: WireSchema, remaining_steps: u64, index: u64 in Wrapping) -> Plan
    requires 1 <= remaining_steps
    requires remaining_steps <= 128 {
        compact_binary.tag = narrow_i64_to_u64_wrapping(schema.fields[index].number);
        compact_binary.plans[index] = field_plan(&schema.fields[index].kind, compact_binary.tag);
        transition remaining_steps > 1 { true -> fill(compact_binary, schema, remaining_steps - 1, index + 1) _ -> done(compact_binary, schema) }
    }
    machine done(compact_binary: &mut AuthoredCompactBinary, schema: WireSchema) -> Plan {
        Plan {
            fields: compact_binary.plans,
            entry_count: schema.field_count,
            size_fixed: 0,
            size_is_dynamic: true,
            align: 1,
        }
    }
}

machine field_plan(kind: &FieldKind, tag: u64) -> FieldPlan {
    transition kind {
        FieldKind::Scalar -> varint(tag)
        FieldKind::Text -> blob(tag)
        FieldKind::Nested -> blob(tag)
        FieldKind::Repeated -> blob(tag)
    }
    machine varint(tag: u64) -> FieldPlan { FieldPlan::Varint { tag: tag } }
    machine blob(tag: u64) -> FieldPlan { FieldPlan::LengthPrefixed { tag: tag } }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

// The source-owned constructor receives carrier-validated words only.
data PolicyCodec {}
machine PolicyCodec::plan(context: &mut ScalarPlanContext) {
    policy_gate(POLICY_ACCEPTED);
    reflect::inspect_record_fields<CounterMessage, CompactBinary::plan_scalar>(context);
}
machine PolicyCodec::construct(bytes: &[u8], fields: &[ScalarSlot]) -> DecodeResult<CounterSample> {
    transition fields.len == 3u64 { true -> create(fields) false -> DecodeResult::Invalid }
    machine create(fields: &[ScalarSlot]) -> DecodeResult<CounterSample>
    requires fields.len == 3u64
    {
        let counter: u64 = fields[0u64].unsigned;
        let delta: i64 = fields[1u64].signed;
        let flag: u64 = fields[2u64].unsigned;
        transition counter <= 4294967295u64 && delta >= (0i64 - 2147483648i64) && delta <= 2147483647i64 && flag <= 1u64 {
            true -> establish(counter, delta, flag)
            false -> DecodeResult::Invalid
        }
    }
    machine establish(counter: u64, delta: i64, flag: u64) -> DecodeResult<CounterSample>
    requires counter <= 4294967295u64 && delta >= (0i64 - 2147483648i64) && delta <= 2147483647i64 && flag <= 1u64
    { DecodeResult::Sound { value: CounterSample { counter: counter as u32, delta: delta as i32, flag: flag == 1u64 } } }
}
machine PolicyCodec::decode<const N: u64>(value: &mut CounterSample, bytes: &[u8; N], read: &mut u64, verdict: &mut PolicyVerdict) {
    let mut fields: [ScalarSlot; 3];
    transition CompactBinary::decode_record<CounterSample, PolicyCodec::plan, PolicyCodec::construct>(&bytes[..], &mut fields[..], read, 10000u64) {
        DecodeResult::Sound { value as decoded } -> commit(value, decoded, verdict)
        _ -> invalid(verdict)
    }
    machine commit(value: &mut CounterSample, decoded: CounterSample, verdict: &mut PolicyVerdict) {
        value = decoded;
        verdict = PolicyVerdict::Sound;
    }
    machine invalid(verdict: &mut PolicyVerdict) { verdict = PolicyVerdict::Invalid; }
}

machine PolicyCodec::fields(value: &CounterSample, context: &mut EncodeContext) {
    policy_gate(POLICY_ACCEPTED);
    reflect::visit_runtime_fields<CounterSample, CompactBinary::scalar_field>(value, context);
}
machine PolicyCodec::encode<const N: u64>(value: &CounterSample, out: &mut [u8; N], written: &mut u64) {
    let mut scratch: [u8; N]; let mut fields: [EncodedField; 3];
    transition CompactBinary::encode<CounterSample, PolicyCodec::fields>(value, &mut out[..], &mut scratch[..], &mut fields[..], 10000u64) {
        EncodeResult::Encoded { next } -> finish(written, next) _ -> finish(written, 0u64)
    }
    machine finish(written: &mut u64, next: u64) { written = next; }
}


// The explicit 32-slot budget belongs to this authored example policy. It is
// not a reflection or codec limit (the library's 40-field witness exceeds it).
data PolicyKind [copy] { supported: bool; kind: FieldKind; }
data PolicyCapture { schema: WireSchema; valid: bool; }
const POLICY_ACCEPTED: bool = selected_policy_is_valid();
machine policy_gate(valid: bool) requires valid {}
machine describe_policy_member<Kind>(capture: &mut PolicyCapture, info: &reflect::FieldInfo) {
    let kind: PolicyKind = policy_kind<Kind>();
    transition info.has_stable_number && !info.is_erased && kind.supported && info.declaration_position < 32u64 {
        true -> put(capture, info, kind.kind)
        false -> invalid(capture)
    }
    machine put(capture: &mut PolicyCapture, info: &reflect::FieldInfo, kind: FieldKind)
    requires info.declaration_position < 32u64
    {
        capture.schema.fields[info.declaration_position] = WireSchemaField { number: narrow_u64_to_i64_wrapping(info.stable_number), kind: kind };
        capture.schema.field_count = info.declaration_position + 1u64;
    }
    machine invalid(capture: &mut PolicyCapture) { capture.valid = false; }
}
machine selected_policy_is_valid() -> bool {
    let mut capture: PolicyCapture;
    capture.valid = true;
    reflect::inspect_record_fields<CounterMessage, describe_policy_member>(&mut capture);
    let mut policy: AuthoredCompactBinary;
    let selected: Plan = AuthoredCompactBinary::plan(&mut policy, capture.schema);
    capture.valid && selected.entry_count == capture.schema.field_count && policy_matches(&capture.schema, &selected, 0u64, 100u64)
}
machine policy_kind<Kind>() -> PolicyKind {
    transition {
        Kind == u32 || Kind == i32 || Kind == bool -> PolicyKind { supported: true, kind: FieldKind::Scalar }

        _ -> PolicyKind { supported: false, kind: FieldKind::Scalar }
    }
}
machine policy_matches(schema: &WireSchema, plan: &Plan, index: u64, remaining_steps: u64) -> bool
requires remaining_steps > 0u64
terminates by remaining_steps
{
    transition {
        index == schema.field_count -> true
        index < schema.field_count && index < 32u64 && remaining_steps > 1u64 -> member(schema, plan, index, remaining_steps)
        _ -> false
    }
    machine member(schema: &WireSchema, plan: &Plan, index: u64, remaining_steps: u64) -> bool
    requires index < schema.field_count && index < 32u64 && remaining_steps > 1u64
    {
        transition policy_member_matches(&schema.fields[index].kind, &plan.fields[index], narrow_i64_to_u64_wrapping(schema.fields[index].number)) {
            true -> policy_matches(schema, plan, index + 1u64, remaining_steps - 1u64)
            false -> false
        }
    }
}
machine policy_member_matches(kind: &FieldKind, placement: &FieldPlan, number: u64) -> bool {
    transition placement {
        FieldPlan::Varint { tag } -> (tag == number && kind == FieldKind::Scalar)
        FieldPlan::LengthPrefixed { tag } -> (tag == number && kind != FieldKind::Scalar)
        _ -> false
    }
}
