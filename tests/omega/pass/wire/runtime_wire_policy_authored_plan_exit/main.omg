// MINT ARC RUNG 2b: THE POLICY AUTHORS THE WIRE PLAN. This is the
// byte-pinned compact_binary roundtrip with one addition: an inline
// `CompactBinary::plan(schema: Schema) -> Plan` grammar policy. Because it
// exists, the compiler MATERIALIZES each schema's facts (number + FieldKind),
// evaluates the policy at build time (purity-gated, the L0 engine), extracts
// the authored `Varint(tag)`/`LengthPrefixed(tag)` placements, and requires
// agreement with the codec walk -- the emitted tag bytes then come from the
// authored plan. The hand-computed bytes below must therefore still hold
// EXACTLY (the fail twin, wire_policy_plan_disagrees, proves divergence is a
// compile error -- the policy is load-bearing, not decorative).
//
// Wire stage 2b: the compact_binary v0 round trip. `encode` frames the
// message, `decode(&mut value, &buffer, &mut read, &mut ok)` reads it
// back: the CURRENT era varint must match byte for byte, then per field in
// field-number order the expected tag varint and a value varint (LEB128;
// signed values un-zigzag ((n >> 1) ^ -(n & 1)); bool 0/1). `read` receives
// the bytes consumed and `ok` the success flag.
//
// Encoded bytes for { counter: 300, delta: -2, flag: true }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00
//   counter 300    -> 0xAC 0x02   (300 = 0b1_0010_1100: low7 0101100|0x80 = 0xAC, then 0b10 = 0x02)
//   tag 1          -> 0x01
//   delta -2       -> 0x03        (zigzag(-2) = 3; unzigzag(3) = -2)
//   tag 2          -> 0x02
//   flag true      -> 0x01
// written = 8; the decoder consumes the same 8 bytes (read = 8, ok = true)
// and every decoded field equals the original.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

data CounterMessage {
    #0 counter: u32;
    #1 delta: i32;
    #2 flag: bool;
}

data CounterSample {
    counter: u32;
    delta: i32;
    flag: bool;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(main: &mut Main) reaches Console {
    let msg: CounterSample = CounterSample {
        counter: 300,
        delta: 0 - 2,
        flag: true
    };

    CounterMessage::encode(&msg, &mut main.buffer, &mut main.written);

    let decoded: CounterSample = CounterSample {
        counter: 0,
        delta: 0,
        flag: false
    };

    CounterMessage::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);

    let matches: bool = main.verdict == WireVerdict::Sound
        && main.written == 8
        && main.read == 8
        && main.buffer[0] == 0
        && main.buffer[1] == 0
        && main.buffer[2] == 172
        && main.buffer[3] == 2
        && main.buffer[4] == 1
        && main.buffer[5] == 3
        && main.buffer[6] == 2
        && main.buffer[7] == 1
        && decoded.counter == 300
        && decoded.delta == 0 - 2
        && decoded.flag;
    transition matches {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// --- The grammar policy (std layout vocabulary, inlined) -----------------
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField where size <= 4096, 1 <= align, align <= 16 { size: u64; align: u64; number: i64; kind: FieldKind; }
data Schema where field_count <= 32 { fields: [SchemaField; 32]; field_count: u64; }
data FieldPlan [copy] {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data Plan { fields: [FieldPlan; 32]; entry_count: u64; size_fixed: u64; size_is_dynamic: bool; align: u64; }

data CompactBinary {
    plans: [FieldPlan; 32];
    index: u64 in Wrapping;
    tag: u64;
}
machine CompactBinary::plan(compact_binary: &mut CompactBinary, schema: Schema) -> Plan {
    CompactBinary::evaluate(compact_binary, schema, 128)
}

machine CompactBinary::evaluate(compact_binary: &mut CompactBinary, schema: Schema, fuel: u64) -> Plan
requires 1 <= fuel
requires fuel <= 128
terminates by fuel;
{
    transition { _ -> fill(compact_binary, schema, fuel, 0) }

    state fill(compact_binary: &mut CompactBinary, schema: Schema, fuel: u64, index: u64 in Wrapping)
    requires 1 <= fuel
    requires fuel <= 128 {
        transition fuel > 1 && index < 32 && index < schema.field_count {
            true -> place(compact_binary, schema, fuel - 1, index)
            _ -> done(compact_binary, schema)
        }
    }
    state place(compact_binary: &mut CompactBinary, schema: Schema, fuel: u64, index: u64 in Wrapping)
    requires 1 <= fuel
    requires fuel <= 128 {
        compact_binary.tag = narrow_i64_to_u64_wrapping(schema.fields[index].number);
        compact_binary.plans[index] = field_plan(&schema.fields[index].kind, compact_binary.tag);
        transition fuel > 1 { true -> fill(compact_binary, schema, fuel - 1, index + 1) _ -> done(compact_binary, schema) }
    }
    state done(compact_binary: &mut CompactBinary, schema: Schema) -> Plan {
        Plan {
            fields: compact_binary.plans,
            entry_count: schema.field_count,
            size_fixed: 0,
            size_is_dynamic: true,
            align: 1,
        }
    }
}

machine field_plan(kind: &FieldKind, tag: u64) -> FieldPlan {
    transition kind {
        FieldKind::Scalar -> varint(tag)
        FieldKind::Text -> blob(tag)
        FieldKind::Nested -> blob(tag)
        FieldKind::Repeated -> blob(tag)
    }
    state varint(tag: u64) -> FieldPlan { FieldPlan::Varint { tag: tag } }
    state blob(tag: u64) -> FieldPlan { FieldPlan::LengthPrefixed { tag: tag } }
}
