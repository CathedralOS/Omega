// Wire fixed-array REPEATED fields, DEGENERATE EXACT EXTENT `N = 1`: the
// carrier contributes exactly one element, with no synthetic sibling count.
// An extent-derived off-by-one shows up here first.
//
// Encoded bytes for { code: [9], flag: true }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00        (code)
//   length 1       -> 0x01        (one packed element byte)
//     9            -> 0x09        (u32: plain varint, no zigzag)
//   tag 1          -> 0x01        (flag)
//   flag true      -> 0x01
// written = 6; the decoder consumes the same 6 bytes (read = 6, ok = true),
// decodes the single required element.

use omega::language::std::console;

data Ping {
    #0 code: [u32; 1];
    #1 flag: bool;
}

data PingValue {
    code: [u32; 1];
    flag: bool;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    buffer: [u8; 32];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(&mut self) {
    let msg: PingValue = PingValue {
        code: [9],
        flag: true
    };

    Ping::encode(&msg, &mut self.buffer, &mut self.written);

    let decoded: PingValue = PingValue {
        code: [0],
        flag: false
    };

    Ping::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);

    let matches: bool = self.verdict == WireVerdict::Sound
        && self.written == 6
        && self.read == 6
        && decoded.code[0] == 9
        && decoded.flag;
    transition matches {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
