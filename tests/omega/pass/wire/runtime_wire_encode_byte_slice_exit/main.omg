use omega_language_std::wire;
use omega::language::core::reflect;
domain [u8]::Utf8
requires
    valid_utf8(self);
// Wire stage 2 (#43), borrowed `&[u8]` fields: the honest zero-copy bytes/text
// field (a fat `{ptr, len}` slice), encoded as RAW bytes -- a length varint
// then the bytes -- distinct from a `[u8; N]` repeated field (packed
// per-element varints). Constructing `BlobSample { bytes: bytes2.source[0..2] }`
// materializes a `{ptr -> &source[0], len = 2}` descriptor into the field, and
// `encode` frames it through the same text-bytes append a `&[u8] in Utf8` uses.
//
// Encoded bytes for { bytes: [72, 105] }, hand-computed:
//   era 0       -> 0x00   (no version blocks)
//   tag 0       -> 0x00   (field number 0)
//   length 2    -> 0x02
//   'H'         -> 0x48   (72)
//   'i'         -> 0x69   (105)
// written = 5; the canary checks the five bytes + the written count in-language
// and exits 70 when byte-exact.

use omega_language_std::console;

data Blob {
    #0 bytes: &[u8];
}

data BlobSample {
    #0 bytes: &[u8];
}

data Main {
    source: [u8; 4];
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source[0] = 72;
    main.source[1] = 105;
    let sample: BlobSample = BlobSample { bytes: main.source[0..2] };

    BlobCodec::encode(&sample, &mut main.buffer, &mut main.written);

    let ok: bool = main.written == 5
        && main.buffer[0] == 0
        && main.buffer[1] == 0
        && main.buffer[2] == 2
        && main.buffer[3] == 72
        && main.buffer[4] == 105;

    transition ok {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

// The semantic owner supplies visitation. The library owns all byte grammar.
data BlobCodec {}
machine BlobCodec::fields(value: &BlobSample, context: &mut EncodeContext) {
    reflect::visit_runtime_fields<BlobSample, CompactBinary::bytes_field>(value, context);
}
machine BlobCodec::encode<const N: u64>(value: &BlobSample, out: &mut [u8; N], written: &mut u64) {
    let mut scratch: [u8; N];
    let mut fields: [EncodedField; 1];
    transition CompactBinary::encode<BlobSample, BlobCodec::fields>(value, &mut out[..], &mut scratch[..], &mut fields[..], 10000u64) {
        EncodeResult::Encoded { next } -> finish(written, next)
        _ -> finish(written, 0u64)
    }
    machine finish(written: &mut u64, next: u64) { written = next; }
}
