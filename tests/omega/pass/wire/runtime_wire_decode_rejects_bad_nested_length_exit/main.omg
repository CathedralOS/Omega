// Wire nested message fields, failure path: the sub-message's declared
// byte-LENGTH must equal the bytes its fields actually consume. The buffer
// is hand-built from the valid nested round trip with ONE corruption -- the
// length byte says 6 where the child's fields occupy 5 -- so the nested
// CLOSE check must clear the sticky `ok` (the cursor lands one byte before
// the declared end). The decoder keeps scanning bounds-checked after the
// mismatch, but nothing can set the flag back.
//
// Hand-computed walk over [0, 0, 6, 0, 0xAC, 0x02, 1, 3, 1, 0x7F]:
//   era      expect 0x00, sees 0      -> matches            (cursor 1)
//   tag 0    expect 0x00, sees 0      -> matches (header)   (cursor 2)
//   length   varint reads 6           -> end bound = 3 + 6 = 9 <= 10, in bounds
//     tag 0  expect 0x00, sees 0      -> matches (room_id)  (cursor 4)
//     varint reads 0xAC 0x02          -> room_id = 300      (cursor 6)
//     tag 1  expect 0x01, sees 1      -> matches (kind)     (cursor 7)
//     varint reads 0x03               -> kind = -2          (cursor 8)
//   close    cursor 8 != end bound 9  -> FAIL (sticky; the true length is 5)
//   tag 1    expect 0x01, sees 1      -> matches (depth)    (cursor 9)
//   depth    varint reads 0x7F        -> -64                (cursor 10)
// read = 10, ok = false -- the canary takes the failure path and exits 70.

use omega::language::std::console;

data RoomHeader {
    #0 room_id: u32;
    #1 kind: i32;
}

data RoomMessage {
    #0 header: RoomHeader;
    #1 depth: i32;
}

data RoomHeaderValue {
    room_id: u32;
    kind: i32;
}

data RoomMessageValue {
    header: RoomHeaderValue;
    depth: i32;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(&mut self) {
    let buffer: [u8; 10] = [0, 0, 6, 0, 172, 2, 1, 3, 1, 127];

    let decoded: RoomMessageValue = RoomMessageValue {
        header: RoomHeaderValue {
            room_id: 0,
            kind: 0
        },
        depth: 0
    };

    RoomMessage::decode(&mut decoded, &buffer, &mut self.read, &mut self.verdict);

    transition self.verdict {
        WireVerdict::Sound -> bad()
        WireVerdict::Invalid -> good()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
