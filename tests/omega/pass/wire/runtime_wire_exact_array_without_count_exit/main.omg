use omega_language_std::wire;
use omega::language::core::reflect;
// A fixed array contributes exactly N repeated elements. No synthetic
// `<name>_count` sibling is required or consulted: the schema's static
// extent is the encoded element count, framed length-delimited like the
// FixedVec carrier.
//
// Expected bytes for { readings: [1, 2, 3, 4] }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00        (readings)
//   length 4       -> 0x04        (the packed elements below)
//     1..4         -> 0x01 0x02 0x03 0x04
// written = 7.

use omega_language_std::console;

data Telemetry {
    #0 readings: [u32; 4];
}

data TelemetryValue {
    #0 readings: [u32; 4];
}

data Main {
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    let msg: TelemetryValue = TelemetryValue {
        readings: [1, 2, 3, 4]
    };

    TelemetryCodec::encode(&msg, &mut main.buffer, &mut main.written);

    transition main.written == 7 {
        true -> check_bytes(main)
        false -> bad(main)
    }

    machine check_bytes(main: &mut Main) {
        let ok: bool = main.buffer[0] == 0
            && main.buffer[1] == 0
            && main.buffer[2] == 4
            && main.buffer[3] == 1
            && main.buffer[4] == 2
            && main.buffer[5] == 3
            && main.buffer[6] == 4;
        transition ok {
            true -> good(main)
            false -> bad(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

// The semantic owner supplies visitation. The library owns all byte grammar.
data TelemetryCodec {}
machine TelemetryCodec::fields(value: &TelemetryValue, context: &mut EncodeContext) {
    reflect::visit_runtime_fields<TelemetryValue, CompactBinary::packed_field>(value, context);
}
machine TelemetryCodec::encode<const N: u64>(value: &TelemetryValue, out: &mut [u8; N], written: &mut u64) {
    let mut scratch: [u8; N];
    let mut fields: [EncodedField; 1];
    transition CompactBinary::encode<TelemetryValue, TelemetryCodec::fields>(value, &mut out[..], &mut scratch[..], &mut fields[..], 10000u64) {
        EncodeResult::Encoded { next } -> finish(written, next)
        _ -> finish(written, 0u64)
    }
    machine finish(written: &mut u64, next: u64) { written = next; }
}
