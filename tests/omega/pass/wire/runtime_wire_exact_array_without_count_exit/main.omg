// A fixed array contributes exactly N repeated elements. No synthetic
// `<name>_count` sibling is required or consulted: the schema's static
// extent is the encoded element count, framed length-delimited like the
// FixedVec carrier.
//
// Expected bytes for { readings: [1, 2, 3, 4] }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00        (readings)
//   length 4       -> 0x04        (the packed elements below)
//     1..4         -> 0x01 0x02 0x03 0x04
// written = 7.

use omega_language_std::console;

data Telemetry {
    #0 readings: [u32; 4];
}

data TelemetryValue {
    readings: [u32; 4];
}

data Main {
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    let msg: TelemetryValue = TelemetryValue {
        readings: [1, 2, 3, 4]
    };

    Telemetry::encode(&msg, &mut main.buffer, &mut main.written);

    transition main.written == 7 {
        true -> check_bytes(main)
        false -> bad(main)
    }

    state check_bytes(main: &mut Main) {
        let ok: bool = main.buffer[0] == 0
            && main.buffer[1] == 0
            && main.buffer[2] == 4
            && main.buffer[3] == 1
            && main.buffer[4] == 2
            && main.buffer[5] == 3
            && main.buffer[6] == 4;
        transition ok {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
