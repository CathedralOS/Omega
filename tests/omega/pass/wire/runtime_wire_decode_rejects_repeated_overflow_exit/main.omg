// Wire REPEATED fields, failure paths: a hostile packed payload cannot
// overrun the declared maximum or the buffer.
//
// Payload 1 (too many elements): [0x00, 0x00, 0x03, 0x02, 0x02, 0x02] -- era
// 0, tag 0, byte-length 3, then THREE one-byte elements (zigzag(1) = 2) for
// a `[i32; 2]` field. The two exact reads consume two elements (cursor = 5),
// and the CLOSE
// check clears ok because the cursor stopped short of the declared end bound
// (6).
//
// Payload 2 (hostile length): [0x00, 0x00, 0x20, 0x02, 0x02, 0x02] -- the
// byte-length claims 32 where only 3 bytes remain. The OPEN check clears ok
// (the bound would run past the buffer); the guarded reads stay
// bounds-checked against the buffer, so nothing reads out of bounds, and the
// decode reports failure.
//
// Exit 70 only when BOTH decodes report failure.

use omega_language_std::console;

data Burst {
    #0 samples: [i32; 2];
}

data BurstValue {
    samples: [i32; 2];
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    console: Console;
    read_overflow: u64;
    verdict_overflow: WireVerdict;
    read_hostile: u64;
    verdict_hostile: WireVerdict;
}

machine Main::main(&mut self) {
    let overflow_payload: [u8; 6] = [0, 0, 3, 2, 2, 2];
    let hostile_payload: [u8; 6] = [0, 0, 32, 2, 2, 2];

    let decoded: BurstValue = BurstValue {
        samples: [0, 0]
    };

    Burst::decode(&mut decoded, &overflow_payload, &mut self.read_overflow, &mut self.verdict_overflow);

    Burst::decode(&mut decoded, &hostile_payload, &mut self.read_hostile, &mut self.verdict_hostile);

    transition self.verdict_overflow {
        WireVerdict::Sound -> bad()
        WireVerdict::Invalid -> check_hostile()
    }

    state check_hostile(&mut self) {
        transition self.verdict_hostile {
            WireVerdict::Sound -> bad()
            WireVerdict::Invalid -> good()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
