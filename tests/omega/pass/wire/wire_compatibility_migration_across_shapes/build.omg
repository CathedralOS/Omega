machine build(builder: &mut Build) {
    Ordinary::require_wire_compatibility<u32>(7);
    Build::application(builder, "wire_compatibility_migration_across_shapes");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    require_archive_migration(builder);
}

machine require_archive_migration(builder: &mut Build) {
    Build::require_wire_compatibility<
        ArchiveStore,
        CounterLineage,
        Counter,
        CounterV1,
        CompleteMigration
    >(builder);
}

data Ordinary {}
machine Ordinary::require_wire_compatibility<Element>(value: Element) {}
