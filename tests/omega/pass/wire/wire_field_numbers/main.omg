use omega_language_std::wire;
use omega::language::core::reflect;
// Numbered data fields declare wire encoding membership: `#0`/`#1`
// are field tags, not positions. `Blob::encode` is the synthesized
// wire framer — a fat `&[u8]` field frames RAW (length varint then
// bytes), distinct from a `[u8; N]` packed repeated field.
data Blob {
    #0 bytes: &[u8];
}
data Header {
    #0 tag: u8;
    #1 count: u16;
}
data Main {
    source: [u8; 4];
    buffer: [u8; 64];
    written: u64;
}
machine Main::main(main: &mut Main) {
    main.source[0] = 72;
    main.source[1] = 105;
    let sample: Blob = Blob { bytes: main.source[0..2] };
    BlobCodec::encode(&sample, &mut main.buffer, &mut main.written);
    let ok: bool = main.written == 5
        && main.buffer[2] == 2
        && main.buffer[3] == 72
        && main.buffer[4] == 105;
}

// The semantic owner supplies visitation. The library owns all byte grammar.
data BlobCodec {}
machine BlobCodec::fields(value: &Blob, context: &mut EncodeContext) {
    reflect::visit_runtime_fields<Blob, CompactBinary::bytes_field>(value, context);
}
machine BlobCodec::encode<const N: u64>(value: &Blob, out: &mut [u8; N], written: &mut u64) {
    let mut scratch: [u8; N];
    let mut fields: [EncodedField; 1];
    transition CompactBinary::encode<Blob, BlobCodec::fields>(value, &mut out[..], &mut scratch[..], &mut fields[..], 10000u64) {
        EncodeResult::Encoded { next } -> finish(written, next)
        _ -> finish(written, 0u64)
    }
    machine finish(written: &mut u64, next: u64) { written = next; }
}
