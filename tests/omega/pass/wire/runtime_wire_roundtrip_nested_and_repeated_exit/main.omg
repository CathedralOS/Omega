// Wire NESTED MESSAGE + REPEATED field in ONE message: both features stage
// runtime-sized payloads (the sub-message replays length-prefixed from the
// wire scratch; the packed FixedVec field's length is intrinsic), so their
// composition pins that the second runtime-sized region
// starts where the first actually ended -- on BOTH the encode and decode
// sides (the decoder must close the sub-region exactly on its bound, then
// open the packed region from the live cursor).
//
// Encoded bytes for { header: { room_id: 300 },
// samples: FixedVec([150, -2], len 2), depth: -64 }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00        (header)
//   length 3       -> 0x03        (sub-message body below)
//     tag 0        -> 0x00        (room_id; NO era inside the sub-message)
//     room_id 300  -> 0xAC 0x02   (u32: plain varint)
//   tag 1          -> 0x01        (samples)
//   length 3       -> 0x03        (packed elements below)
//     150          -> 0xAC 0x02   (zigzag(150) = 300)
//     -2           -> 0x03        (zigzag(-2) = 3)
//   tag 2          -> 0x02        (depth)
//   depth -64      -> 0x7F        (zigzag(-64) = 127)
// written = 13; the decoder consumes the same 13 bytes (read = 13,
// ok = true) and every decoded field equals the original.

use omega::language::core::fixed_vec;
use omega_language_std::console;

data RoomHeader {
    #0 room_id: u32;
}

data RoomPacket {
    #0 header: RoomHeader;
    #1 samples: FixedVec<i32, 4>;
    #2 depth: i32;
}

data RoomHeaderValue {
    room_id: u32;
}

data RoomPacketValue {
    header: RoomHeaderValue;
    samples: FixedVec<i32, 4>;
    depth: i32;
}

// The decode verdict: a dispatchable enum, not a forgettable flag. Invalid
// is the ZII zero case, so an untouched verdict reads as failure.
data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
    packet: RoomPacketValue;
}

machine Main::main(main: &mut Main) reaches Console {
    let msg: RoomPacketValue = RoomPacketValue {
        header: RoomHeaderValue {
            room_id: 300
        },
        samples: FixedVec { items: [150, 0 - 2, 0, 0], length: 2 },
        depth: 0 - 64
    };

    RoomPacket::encode(&msg, &mut main.buffer, &mut main.written);

    RoomPacket::decode(&mut main.packet, &main.buffer, &mut main.read, &mut main.verdict);

    transition main.verdict == WireVerdict::Sound
        && main.written == 13
        && main.read == 13
        && main.packet.header.room_id == 300
        && main.packet.samples.length == 2
        && main.packet.samples.items[0] == 150
        && main.packet.samples.items[1] == 0 - 2
        && main.packet.depth == 0 - 64 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
