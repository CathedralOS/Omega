// RUN CANARY (exit 70) + interpreter differential. The decode-boundary
// UTF-8 validator's edge classes, one leg each over hand-crafted wire
// buffers: the euro sign E2 82 AC decodes SOUND (honest 3-byte); the
// overlong E0 80 80, the UTF-16 surrogate ED A0 80, the beyond-U+10FFFF
// F4 90 80, and the truncated F0 90 all decode INVALID. Pins the aarch64
// compare/branch walk (label-resolved, 77 instructions) against the
// interp's std::str::from_utf8 -- the two must agree on every class.
// exits: 71 = euro wrongly refused; 72/73/74/75 = the respective
// adversarial class wrongly accepted.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
data LabelMessage {
    #0 count: u32;
    #1 label: &[u8] in Utf8;
}
data LabelSample {
    count: u32;
    label: &[u8] in Utf8;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    buffer: [u8; 16];
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(main: &mut Main) reaches Console {
    main.buffer[0] = 0;
    main.buffer[1] = 0;
    main.buffer[2] = 7;
    main.buffer[3] = 1;
    main.buffer[4] = 3;
    main.buffer[5] = 226;
    main.buffer[6] = 130;
    main.buffer[7] = 172;
    let decoded: LabelSample;
    decoded.count = 0;
    decoded.label = "";
    LabelMessage::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);
    transition main.verdict == WireVerdict::Sound {
        true -> overlong(main)
        false -> bad_euro(main)
    }
    state overlong(main: &mut Main) {
        main.buffer[5] = 224;
        main.buffer[6] = 128;
        main.buffer[7] = 128;
        let d2: LabelSample;
        d2.count = 0;
        d2.label = "";
        LabelMessage::decode(&mut d2, &main.buffer, &mut main.read, &mut main.verdict);
        transition main.verdict == WireVerdict::Invalid {
            true -> surrogate(main)
            false -> bad_overlong(main)
        }
    }
    state surrogate(main: &mut Main) {
        main.buffer[5] = 237;
        main.buffer[6] = 160;
        main.buffer[7] = 128;
        let d3: LabelSample;
        d3.count = 0;
        d3.label = "";
        LabelMessage::decode(&mut d3, &main.buffer, &mut main.read, &mut main.verdict);
        transition main.verdict == WireVerdict::Invalid {
            true -> beyond(main)
            false -> bad_surrogate(main)
        }
    }
    state beyond(main: &mut Main) {
        main.buffer[5] = 244;
        main.buffer[6] = 144;
        main.buffer[7] = 128;
        let d4: LabelSample;
        d4.count = 0;
        d4.label = "";
        LabelMessage::decode(&mut d4, &main.buffer, &mut main.read, &mut main.verdict);
        transition main.verdict == WireVerdict::Invalid {
            true -> truncated(main)
            false -> bad_beyond(main)
        }
    }
    state truncated(main: &mut Main) {
        main.buffer[4] = 2;
        main.buffer[5] = 240;
        main.buffer[6] = 144;
        let d5: LabelSample;
        d5.count = 0;
        d5.label = "";
        LabelMessage::decode(&mut d5, &main.buffer, &mut main.read, &mut main.verdict);
        transition main.verdict == WireVerdict::Invalid {
            true -> good(main)
            false -> bad_truncated(main)
        }
    }
    state good(main: &mut Main)          { Console::exit_process(70); }
    state bad_euro(main: &mut Main)      { Console::exit_process(71); }
    state bad_overlong(main: &mut Main)  { Console::exit_process(72); }
    state bad_surrogate(main: &mut Main) { Console::exit_process(73); }
    state bad_beyond(main: &mut Main)    { Console::exit_process(74); }
    state bad_truncated(main: &mut Main) { Console::exit_process(75); }
}
