use first;
use second;

data WireVerdict {
    case Invalid;
    case Sound;
}

data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    verdict: WireVerdict;
}

machine Main::main(&mut self) {
    let first_msg: first::Counter = first::Counter {
        counter: 7
    };
    let second_msg: second::Counter = second::Counter {
        counter: 7,
        timestamp: 9
    };

    first::Counter::encode(&first_msg, &mut self.buffer, &mut self.written);
    second::Counter::encode(&second_msg, &mut self.buffer, &mut self.written);

    let mut decoded: second::Counter = second::Counter {
        counter: 0,
        timestamp: 0
    };
    second::Counter::decode(&mut decoded, &self.buffer, &mut self.read, &mut self.verdict);
}
