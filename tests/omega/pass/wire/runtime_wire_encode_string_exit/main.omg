domain [u8]::Utf8
requires
    valid_utf8(self);
// Wire stage 2a, &[u8] in Utf8 fields: `LabelMessage::encode(&msg,
// &mut self.buffer, &mut self.written)` frames the schema's CURRENT era in
// compact_binary v0. A &[u8] in Utf8 field rides as its tag varint, then a LENGTH
// varint (byte count), then the raw UTF-8 bytes -- no NUL terminator, no
// padding. The &[u8] in Utf8 field must carry the highest field number (it encodes
// last; its byte-copy is the one runtime-sized append, bounds-checked
// against the buffer's compile-time capacity).
//
// Expected bytes for { count: 7, label: "hi" }, hand-computed:
//   era 0          -> 0x00        (no version blocks)
//   tag 0          -> 0x00
//   count 7        -> 0x07
//   tag 1          -> 0x01
//   len 2          -> 0x02        ("hi" is two UTF-8 bytes)
//   'h'            -> 0x68 (104)
//   'i'            -> 0x69 (105)
// written = 7.

use omega_language_std::console;

data LabelMessage {
    #0 count: u32;
    #1 label: &[u8] in Utf8;
}

data LabelSample {
    count: u32;
    label: &[u8] in Utf8;
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(&mut self) {
    // Field-assignment form: struct-literal &[u8] in Utf8 field initialization does
    // not lower to a native descriptor write yet (assignments do).
    let msg: LabelSample;
    msg.count = 7;
    msg.label = "hi";

    LabelMessage::encode(&msg, &mut self.buffer, &mut self.written);

    transition self.written == 7 {
        true -> check_bytes()
        false -> bad()
    }

    state check_bytes(&mut self) {
        let ok: bool = self.buffer[0] == 0
            && self.buffer[1] == 0
            && self.buffer[2] == 7
            && self.buffer[3] == 1
            && self.buffer[4] == 2
            && self.buffer[5] == 104
            && self.buffer[6] == 105;
        transition ok {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}