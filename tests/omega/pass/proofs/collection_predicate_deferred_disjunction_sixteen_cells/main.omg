// Helper theorem over a predicate that guards every element in its own
// state, at sixteen elements. Each guard `cells[i] == 0 || cells[i] == 1` is a
// disjunction; proving `cell_is_bit` explores the predicate on the paths where
// the selected `index` is not yet matched, and those paths carry one such
// disjunction per element the goal never reads. The checker keeps them as
// deferred clauses and splits a clause only when a decision touches its
// atoms, so the exploration stays linear in the element count rather than
// forking once per element (2^16 paths exhausted the work budget before).
// The four-element shape is pinned by
// pass/dependent/collection_predicate_helper_theorem_bounds_sum.

machine cells_valid(cells: &[i32; 16]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 16]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 16]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 16]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> at_4(cells)
            _ -> (false)
        }
    }

    machine at_4(cells: &[i32; 16]) -> bool {
        transition cells[4] == 0 || cells[4] == 1 {
            true -> at_5(cells)
            _ -> (false)
        }
    }

    machine at_5(cells: &[i32; 16]) -> bool {
        transition cells[5] == 0 || cells[5] == 1 {
            true -> at_6(cells)
            _ -> (false)
        }
    }

    machine at_6(cells: &[i32; 16]) -> bool {
        transition cells[6] == 0 || cells[6] == 1 {
            true -> at_7(cells)
            _ -> (false)
        }
    }

    machine at_7(cells: &[i32; 16]) -> bool {
        transition cells[7] == 0 || cells[7] == 1 {
            true -> at_8(cells)
            _ -> (false)
        }
    }

    machine at_8(cells: &[i32; 16]) -> bool {
        transition cells[8] == 0 || cells[8] == 1 {
            true -> at_9(cells)
            _ -> (false)
        }
    }

    machine at_9(cells: &[i32; 16]) -> bool {
        transition cells[9] == 0 || cells[9] == 1 {
            true -> at_10(cells)
            _ -> (false)
        }
    }

    machine at_10(cells: &[i32; 16]) -> bool {
        transition cells[10] == 0 || cells[10] == 1 {
            true -> at_11(cells)
            _ -> (false)
        }
    }

    machine at_11(cells: &[i32; 16]) -> bool {
        transition cells[11] == 0 || cells[11] == 1 {
            true -> at_12(cells)
            _ -> (false)
        }
    }

    machine at_12(cells: &[i32; 16]) -> bool {
        transition cells[12] == 0 || cells[12] == 1 {
            true -> at_13(cells)
            _ -> (false)
        }
    }

    machine at_13(cells: &[i32; 16]) -> bool {
        transition cells[13] == 0 || cells[13] == 1 {
            true -> at_14(cells)
            _ -> (false)
        }
    }

    machine at_14(cells: &[i32; 16]) -> bool {
        transition cells[14] == 0 || cells[14] == 1 {
            true -> at_15(cells)
            _ -> (false)
        }
    }

    machine at_15(cells: &[i32; 16]) -> bool {
        transition cells[15] == 0 || cells[15] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

// A valid board's selected cell is 0 or 1, proved from `cells_valid`'s body.
machine cell_is_bit(cells: &[i32; 16], index: u64)
requires cells_valid(cells) == true
requires index < 16
ensures cells[index] >= 0 && cells[index] <= 1
{
}

data Grid where cells_valid(&board) == true {
    board: [i32; 16];
}

data Main {
    grid: Grid;
    total: i32;
}

machine Main::sum(context: &mut Main) {
    cell_is_bit(&context.grid.board, 0);
    cell_is_bit(&context.grid.board, 15);
    context.total = context.grid.board[0] + context.grid.board[15];
}

machine Main::main(context: &mut Main) {
    Main::sum(context);
}
