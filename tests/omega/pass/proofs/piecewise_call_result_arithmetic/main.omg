// Ordinary result contracts carry branch facts into caller arithmetic.
machine reflected(value: i32) -> i32
requires value >= -2 && value <= 2
ensures (value < 0 && result == 0 - value) ||
    (value >= 0 && result == value)
{
    transition { value < 0 -> (0 - value) _ -> (value) }
}

machine varied(value: i32) -> i32
requires value >= -2 && value <= 2
{
    let reflected_value: i32 = reflected(value);
    // This addition requires the whole piecewise bound, not only one branch.
    reflected_value + 2147483645
}

machine singleton() -> i32 {
    reflected(-2) + 2147483645
}
