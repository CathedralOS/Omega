// Expected: descend(3, 9) returns 1, so Main exits 70. A forwarding state sits
// between the entry and the recursive invocation; the invocation, not a local
// state jump, carries the ranked decrease and the entry-relative guarantee.
use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let floor: u64 = descend(3, 9);
    transition floor == 1 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

machine descend(n: u64, previous: u64) -> u64
requires n <= previous && previous <= 1000
terminates by n -> Nat::Descending;
ensures result <= previous
{
    transition n > 0 {
        true -> hold(n - 1, n)
        false -> previous
    }
    machine hold(n: u64, previous: u64) -> u64
    requires n <= previous && previous <= 1000
    {
        transition { _ -> carry(n, previous) }
    }
    machine carry(n: u64, previous: u64) -> u64
    requires n <= previous && previous <= 1000
    {
        transition n > 0 {
            true -> descend(n - 1, n)
            false -> previous
        }
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
