// Expected: descend(3, 9) returns 1, so Main exits 70. A forwarding state sits
// between the entry and the recursive invocation; the invocation, not a local
// state jump, carries the ranked decrease and the entry-relative guarantee.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let floor: u64 = descend(3, 9);
    transition floor == 1 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}

machine descend(n: u64, previous: u64) -> u64
requires n <= previous && previous <= 1000
terminates by n -> Nat::Descending;
ensures result <= previous
{
    transition n > 0 {
        true -> hold(n - 1, n)
        false -> previous
    }
    state hold(n: u64, previous: u64) -> u64
    requires n <= previous && previous <= 1000
    {
        transition { _ -> carry(n, previous) }
    }
    state carry(n: u64, previous: u64) -> u64
    requires n <= previous && previous <= 1000
    {
        transition n > 0 {
            true -> descend(n - 1, n)
            false -> previous
        }
    }
}
