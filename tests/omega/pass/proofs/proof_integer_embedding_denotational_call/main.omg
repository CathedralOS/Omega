// A proof embedding is a value term, not an unresolved operational call.
// Its enclosing projection remains subject to ordinary denotation checks.
use omega::language::core::nat;

machine magnitude(value: u64) -> Nat {
    embed(value) as Nat
}

machine identity(value: u64) -> u64 {
    value
}

// Nested ordinary calls and a sibling embedding retain separate flow
// coordinates even though the embedding itself has no operational edge.
machine doubled(value: u64) -> Nat {
    (embed(identity(value)) + embed(identity(value))) as Nat
}

machine preserve(value: u64)
requires magnitude(value) == magnitude(value)
ensures magnitude(value) == magnitude(value)
{}

machine preserve_composition(value: u64)
requires doubled(value) == doubled(value)
ensures doubled(value) == doubled(value)
{}

machine main() {}
