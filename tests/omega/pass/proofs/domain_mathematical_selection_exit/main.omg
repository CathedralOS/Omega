// Expected exit: 0. Domain facts select the exact imported mathematical owner.
use helpers;
data Region { base: addr; length: u64; }
// A same-spelled local definition has a different, contradictory meaning.
let no_wrap(base: addr, length: u64): core::Strict<0> = embed(base) < 0;
domain Region::Bounded(region)
requires helpers::no_wrap(region.length, region.base);
machine region(base: addr, length: u64, endpoint: addr) -> Region in Bounded
requires embed(base) + embed(length) <= embed(endpoint)
ensures result.base == base && result.length == length
{ Region { base: base, length: length } }
machine cut(whole: Region in Bounded, requested: u64) -> addr
requires requested < whole.length
{ whole.base + requested }
machine main() crashes Trap {
    let observed: addr = cut(region(10, 80, 100), 20);
    transition observed == 30 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
