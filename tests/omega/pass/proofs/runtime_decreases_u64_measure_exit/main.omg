// RUN CANARY (exit 70) + interpreter differential. Termination measures use
// explicit u64 counts after the retirement of the pointer-sized integer aliases.
// RUN CANARY (exit 70) -- the fence-exemption ACCEPTANCE TEST, promoted
// 2026-07-09f: a value call to an EFFECTFUL re-entrant machine (per-entry
// `self.hits` bump, SelfTarget re-entry) ROUTES TO DISPATCH and delivers both
// the looped RESULT (total == 5) and the per-entry EFFECT COUNT (hits == 5).
// This exact program was the COUNTEREXAMPLE that retracted the first
// exemption attempt (2026-07-08n: the field-read terminal misdelivered);
// with the return-write matrix closed (field/binary/multi-arm/guard/
// transition-arg) and unserved terminals refusing loudly
// (collect_call_result_return_blockers), the splice fences exempt
// dispatch-routed calls SOUNDLY: dispatched value calls either deliver
// correctly or fail to compile, never silently ZII. Differential.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; hits: i32 in Wrapping; total: i32 in Wrapping; }
machine Main::count(main: &mut Main, i: u64, j: u64)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32
{
    main.hits = main.hits + 1;
    transition j < i {
        true -> count(main, i, j + 1)
        false -> done_leaf(main)
    }
    state done_leaf(main: &mut Main) -> i32 {
        let result: i32 = main.hits as i32;
        result
    }
}
machine Main::main(main: &mut Main) reaches Console {
    // i = 4: entries at j = 0,1,2,3,4 -> hits == 5; result returns hits (5).
    main.total = Main::count(main, 4, 0);
    transition main.total == 5 { true -> ck_hits(main) _ -> bad(main, 71) }
    state ck_hits(main: &mut Main) {
        transition main.hits == 5 { true -> good(main) _ -> bad(main, 72) }
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
