// N8's first construction rung: core Rat exposes an honest division-free
// closeness predicate, and its reflexive/symmetric laws are checked machines.
use omega::language::core::rat;

machine valid_unit_rat() -> Rat {
    mk_rat(
        Nat::Succ { prev: Nat::Zero },
        Nat::Succ { prev: Nat::Zero },
        Nat::Succ { prev: Nat::Zero }
    )
}

machine close_is_reflexive(value: Rat, precision: Nat)
ensures (rat_close(value, value, precision)) == Nat::Zero
{
    rat_close_reflexive(value, precision);
}

machine close_is_symmetric(left: Rat, right: Rat, precision: Nat)
requires (rat_close(left, right, precision)) == Nat::Zero
ensures (rat_close(right, left, precision)) == Nat::Zero
{
    rat_close_symmetric(left, right, precision);
}

machine scaled_triangle_is_available(left: Rat, middle: Rat, right: Rat)
ensures
    (saturating_sub(
        mul(middle.den, rat_gap(left, right)),
        add(
            mul(right.den, rat_gap(left, middle)),
            mul(left.den, rat_gap(middle, right))
        )
    )) == Nat::Zero
{
    rat_gap_triangle_scaled(left, middle, right);
}

machine doubled_precision_triangle_is_available(
    left: Rat,
    middle: Rat,
    right: Rat,
    precision: Nat
)
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, middle.den)) == Nat::Zero;
    (rat_close(left, middle, add(precision, precision))) == Nat::Zero;
    (rat_close(middle, right, add(precision, precision))) == Nat::Zero
ensures
    (rat_close(left, right, precision)) == Nat::Zero
{
    rat_close_triangle_split(left, middle, right, precision);
}

data Main {
}

machine Main::main(&mut self) {
}
