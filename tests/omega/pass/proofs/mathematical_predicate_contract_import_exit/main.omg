use helpers;

let reflexive(value: u8): core::Strict<0> = value == value;

machine formed(value: u8)
ensures reflexive(value) {}

machine identity(value: u8) -> u8
ensures reflexive(result) {
    value
}

machine qualified(value: u8)
ensures helpers::reflexive(value) {}

machine returned(value: u8)
ensures helpers::predicate(value) {}

machine generic(value: u8)
ensures helpers::identity<u8>(value) == value {}

let apply(predicate: u8 -> core::Strict<0>, value: u8): core::Strict<0> =
    predicate(value);

machine higher_order(value: u8)
ensures apply(reflexive(), value) {}

machine typed_result()
ensures helpers::byte_mask() == helpers::byte_mask() {}

machine wrapping(value: u8 in Wrapping)
ensures helpers::wrapping_reflexive(value) {}

machine main() crashes Trap {
    formed(7u8);
    qualified(9u8);
    returned(13u8);
    generic(17u8);
    typed_result();
    higher_order(19u8);
    wrapping(255u8 as u8 in Wrapping);
    let observed: u8 = identity(11u8);
    transition observed == 11u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
