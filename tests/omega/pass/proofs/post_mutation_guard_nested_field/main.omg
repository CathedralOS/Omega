// Expected exit: 0.
data Context { count: u64; }
data Container { inner: Context; }
machine set(context: &mut Context) -> bool { context.count = 5; true }
machine main(container: &mut Container) crashes Trap {
    transition set(&mut container.inner) && container.inner.count < 6 { true -> bounded(&container.inner) false -> bad() }
    state bounded(value: &Context) requires value.count < 6 { transition value.count == 5 { true -> done() false -> bad() } }
    state done() { }
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Container;
    main(&mut entry_storage);
}
