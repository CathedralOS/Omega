// Expected exit: 0
// Unrelated float overloads cannot erase the exact Int result of embed.
use omega::language::core::float_operations;

machine offset(base: addr, length: u64, requested: u64) -> addr
requires embed(base) + embed(length) <= addr::Bound && requested < length
{ base + requested }

data Window [copy] { base: addr; length: u64; }
machine projected(window: Window, requested: u64, ceiling: addr) -> addr
requires embed(window.base) + embed(window.length) <= embed(ceiling) - 0
    && requested < window.length
{ offset(window.base, window.length, requested) }

machine main() crashes Trap {
    let window: Window = Window { base: 10, length: 80 };
    let selected: addr = projected(window, 20, 100);
    transition selected == 30 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
