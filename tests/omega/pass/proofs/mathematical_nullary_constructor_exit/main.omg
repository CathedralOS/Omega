// Expected exit: 0
// Mathematical definitions retain ordinary nullary constructor values.
use omega::language::core::Nat;
data Choice [copy] { case First; case Other; }
let is_zero(value: Nat): core::Type<0> = core::Identity<Nat>(value, Nat::Zero);
let is_first(value: Choice): core::Type<0> = core::Identity<Choice>(value, Choice::First);
machine zero_fact() reaches terminates
ensures is_zero(Nat::Zero)
{ }
machine consume(value: Choice) -> u64
requires is_first(value)
{ 41u64 }
machine main() crashes Trap {
    zero_fact();
    let result: u64 = consume(Choice::First);
    transition result == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
