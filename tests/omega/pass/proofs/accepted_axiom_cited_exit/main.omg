use omega::language::core::nat;
use omega_language_std::console;
data Main { }

// An axiom about an UNPROVEN shape, cited by a lemma: the citation
// delivers the accepted fact into the lemma's hypothesis base.
boundary machine mul_comm_axiom(a: Nat, b: Nat) -> Nat
ensures
    (mul(a, b)) == (mul(b, a));

machine uses_axiom(a: Nat, b: Nat) -> Nat
ensures
    (mul(a, b)) == (mul(b, a))
{
    transition {
        _ -> body(a, b)
    }

    state body(a: Nat, b: Nat) -> Nat {
        mul_comm_axiom(a, b);
        transition { _ -> Nat::Zero }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
