// N6: core relation properties consume proposition families and keep their
// laws independent. The composite hierarchy is imported from core rather than
// rediscovered through proof-machine name suffixes. Each relation is a defined
// proposition, so every realizer proves its law from exactly the premises its
// requirement grants; a realizer may not add premises the requirement does
// not imply.
use omega::language::core::relation;

data Carrier {
}

proposition related(left: Carrier, right: Carrier) = left == right;

machine related_reflexive(value: Carrier)
satisfies Reflexive<Carrier, related>::reflexive
ensures related(value, value)
{
}

machine related_symmetric(left: Carrier, right: Carrier)
satisfies Symmetric<Carrier, related>::symmetric
requires related(left, right)
ensures related(right, left)
{
}

machine related_transitive(left: Carrier, middle: Carrier, right: Carrier)
satisfies Transitive<Carrier, related>::transitive
requires
    related(left, middle)
    related(middle, right)
ensures related(left, right)
{
}

machine related_antisymmetric(left: Carrier, right: Carrier)
satisfies Antisymmetric<Carrier, related>::antisymmetric
requires
    related(left, right)
    related(right, left)
ensures left == right
{
}

// Renamed parameters bind the requirement telescope positionally: the
// requirement names `left`/`right` while the satisfier names them
// `right`/`left`, so the inherited law still lands on the correct slots.
machine related_reflexive_named(item: Carrier)
satisfies Reflexive<Carrier, related>::reflexive
ensures related(item, item)
{
}

machine related_symmetric_flipped(right: Carrier, left: Carrier)
satisfies Symmetric<Carrier, related>::symmetric
requires related(right, left)
ensures related(left, right)
{
}

data Index {
}

data Stream<machine Sequence>
requires machine Sequence(index: Index) -> Index;
{
    case Empty;
    case More(tail: Stream<Sequence>);
}

// Heterogeneous packs relate `Stream<Left>` to `Stream<Right>`, values of
// different types, so the stream relation is the total one. The trait names
// the bare family; each realizer's machine binders instantiate the packs.
proposition stream_related<machine Left, machine Right>(
    left: Stream<Left>,
    right: Stream<Right>
) = true;

machine stream_related_reflexive<machine Sequence>(value: Stream<Sequence>)
requires machine Sequence(index: Index) -> Index;
satisfies Reflexive<Stream, stream_related>::reflexive
ensures stream_related<Sequence, Sequence>(value, value)
{
}

machine stream_related_symmetric<machine Left, machine Right>(
    left: Stream<Left>,
    right: Stream<Right>
)
requires machine Left(index: Index) -> Index;
requires machine Right(index: Index) -> Index;
satisfies Symmetric<Stream, stream_related>::symmetric
requires stream_related<Left, Right>(left, right)
ensures stream_related<Right, Left>(right, left)
{
}

machine stream_related_transitive<
    machine Left,
    machine Middle,
    machine Right
>(
    left: Stream<Left>,
    middle: Stream<Middle>,
    right: Stream<Right>
)
requires machine Left(index: Index) -> Index;
requires machine Middle(index: Index) -> Index;
requires machine Right(index: Index) -> Index;
satisfies Transitive<Stream, stream_related>::transitive
requires
    stream_related<Left, Middle>(left, middle)
    stream_related<Middle, Right>(middle, right)
ensures stream_related<Left, Right>(left, right)
{
}

machine main() {
}
