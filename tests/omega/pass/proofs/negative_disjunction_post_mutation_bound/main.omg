// Expected exit: 0.
data Context { count: u64; }
machine set(context: &mut Context) -> bool { context.count = 5; false }
machine main(context: &mut Context) crashes Trap {
    transition set(context) || context.count >= 6 { false -> bounded(context) true -> bad() }
    machine bounded(context: &Context) requires context.count < 6 { transition context.count == 5 { true -> done() false -> bad() } }
    machine done() { }
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
