// Compile canary: the fixture requests hermetic application identity through its
// `Build::application` declaration, so the managed quotient request carries
// application provenance rather than the standalone-source identity the
// admission refuses — without depending on the ordinary std package.

machine build(builder: &mut Build) {
    Build::application(builder, "quotient_define_managed_compile");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
