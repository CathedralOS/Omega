// Expected exit: 0. Owned fields and view metadata survive later writes;
// reference-content promises remain usable when no later write intervenes.
data Cell [copy] { value: u64; }
data OwnedPair { cell: Cell; marker: u64; }
data SharedPair { cell: &Cell; marker: u64; }
data ViewPair { view: &[u8]; marker: u64; }
data MutablePair { cell: &mut Cell; marker: u64; }
data ScalarPair { value: u64; marker: u64; }
machine keep_owned(cell: &Cell) -> Cell
requires cell.value == 11;
ensures result.value == 11;
{ Cell { value: cell.value } }
machine keep_shared(cell: &Cell) -> &Cell
requires cell.value == 11;
ensures result.value == 11;
{ cell }
machine keep_view(bytes: &[u8]) -> &[u8]
requires bytes.len >= 1024;
ensures result.len >= 1024;
{ bytes }
machine restore(cell: &mut Cell) -> &mut Cell
ensures result.value == 11;
{ cell.value = 11; cell }
machine overwrite(cell: &mut Cell) -> u64 { cell.value = 99; 0 }
machine keep_scalar(value: &u64) -> &u64
requires value == 11;
ensures result == 11;
{ value }
machine overwrite_scalar(value: &mut u64) -> u64 { value = 99; 0 }
machine no_write() -> u64 { 0 }
machine demand(value: u64) requires value == 11 { }
machine plain_scalar(value: &u64) -> &u64 { value }
machine replace_scalar(value: &mut u64) -> u64 {
    let previous: u64 = value;
    value = 99;
    previous
}
machine scalar_observation_precedes_sibling_write() -> bool {
    let mut value: u64 = 11;
    let matches: bool = plain_scalar(&value) == replace_scalar(&mut value);
    matches && value == 99
}
machine replace_cell(cell: &mut Cell) -> u64 {
    let previous: u64 = cell.value;
    cell.value = 99;
    previous
}
machine record_observation_precedes_sibling_write() -> bool {
    let mut cell: Cell = Cell { value: 11 };
    let matches: bool = keep_shared(&cell).value == replace_cell(&mut cell);
    matches && cell.value == 99
}
machine increment_scalar(value: u64) -> u64 requires value == 11 {
    plain_scalar(&value) + 1
}
machine marked_scalar<'storage>(value: &'storage u64, marker: &mut u64) -> &'storage u64 {
    marker = 7;
    value
}
machine selected_scalar(flag: bool) -> bool {
    let mut value: u64 = 11;
    let mut marker: u64 = 0;
    let copied: u64 = match flag {
        true -> plain_scalar(&value),
        _ -> marked_scalar(&value, &mut marker)
    };
    _ = overwrite_scalar(&mut value);
    copied == 11 && value == 99 && ((flag && marker == 0) || (!flag && marker == 7))
}
machine main() crashes Trap {
    let mut original: Cell = Cell { value: 11 };
    let owned: OwnedPair = OwnedPair { cell: keep_owned(&original), marker: overwrite(&mut original) };
    demand(owned.cell.value);
    let shared_cell: Cell = Cell { value: 11 };
    let shared: SharedPair = SharedPair { cell: keep_shared(&shared_cell), marker: no_write() };
    demand(shared.cell.value);
    let mut bytes: [u8; 1024];
    bytes[1023] = 73;
    let view: ViewPair = ViewPair { view: keep_view(&bytes[..]), marker: overwrite(&mut original) };
    let last: u8 = view.view[1023];
    let restored: MutablePair = MutablePair { cell: restore(&mut original), marker: no_write() };
    demand(restored.cell.value);
    let mut scalar: u64 = 11;
    let copied: u64 = keep_scalar(&scalar);
    let captured: ScalarPair = ScalarPair { value: keep_scalar(&scalar), marker: overwrite_scalar(&mut scalar) };
    demand(copied);
    demand(captured.value);
    let mut reordered_cell: Cell = Cell { value: 11 };
    // Evaluation order belongs to authored initializers, not record layout.
    let reordered: MutablePair = MutablePair { marker: overwrite(&mut reordered_cell), cell: restore(&mut reordered_cell) };
    demand(reordered.cell.value);
    let mut array_scalar: u64 = 11;
    let array: [u64; 2] = [plain_scalar(&array_scalar), overwrite_scalar(&mut array_scalar)];
    let mut arithmetic_scalar: u64 = 11;
    let incremented: u64 = plain_scalar(&arithmetic_scalar) + 1;
    _ = overwrite_scalar(&mut arithmetic_scalar);
    let immutable_scalar: u64 = 11;
    let immutable_incremented: u64 = plain_scalar(&immutable_scalar) + 1;
    let parameter_incremented: u64 = increment_scalar(11);
    let selected_first: bool = selected_scalar(true);
    let selected_second: bool = selected_scalar(false);
    let observed_before_sibling: bool = scalar_observation_precedes_sibling_write();
    let field_before_sibling: bool = record_observation_precedes_sibling_write();
    transition owned.cell.value == 11 && shared.cell.value == 11 && last == 73
        && restored.cell.value == 11 && copied == 11 && captured.value == 11
        && scalar == 99 && reordered.cell.value == 11
        && array[0] == 11 && array[1] == 0 && array_scalar == 99
        && incremented == 12 && arithmetic_scalar == 99
        && immutable_incremented == 12 && parameter_incremented == 12
        && selected_first && selected_second && observed_before_sibling && field_before_sibling { true -> done() _ -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
