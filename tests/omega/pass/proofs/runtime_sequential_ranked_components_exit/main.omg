// Expected: descend(3, 9) returns 9, so Main exits 70.
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let floor: u64 = descend(3, 9);
    transition floor == 9 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}


machine descend(n: u64 [0..=1000], previous: u64 [0..=1000]) -> u64
terminates by n -> Nat::Descending;
ensures result <= previous
{
    transition n > 0 {
        true -> descend(n - 1, previous)
        false -> loop(n, previous)
    }
    state loop(n: u64 [0..=1000], p: u64 [0..=1000]) -> u64 {
        transition n > 0 && n <= p {
            true -> loop(n - 1, n)
            false -> p
        }
    }
}
