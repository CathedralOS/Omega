// An axiom about an UNPROVEN shape, cited by a lemma: a boundary
// machine's `ensures` states `(mul(a,b)) == (mul(b,a))` where `mul`
// itself is never defined — the citation delivers the accepted fact
// into the lemma's hypothesis base.
use omega::language::core::nat;
boundary machine mul_comm_axiom(a: Nat, b: Nat) -> Nat
ensures
    (mul(a, b)) == (mul(b, a));
machine uses_axiom(a: Nat, b: Nat) -> Nat
ensures
    (mul(a, b)) == (mul(b, a))
{
    transition {
        _ -> body(a, b)
    }
    machine body(a: Nat, b: Nat) -> Nat {
        mul_comm_axiom(a, b);
        transition { _ -> Nat::Zero }
    }
}
data Main {}
machine Main::main(main: &mut Main) { }
