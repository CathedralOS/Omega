use omega::language::core::slice;
use omega::language::core::float_operations;
data SpectrumView<'samples> [copy] { samples: &'samples [f64]; temperature: f64; }
machine radiance<'samples>(spectrum: SpectrumView<'samples>, column: u64) -> f64
requires column < spectrum.samples.len { spectrum.samples[column] }

// Borrowed carriers and ordinary named calls retain the same bound.
machine borrowed<'samples>(spectrum: &SpectrumView<'samples>, column: u64) -> f64
requires column < spectrum.samples.len { Slice::index(spectrum.samples, column) }
data Batch<'samples> [copy] { selected: SpectrumView<'samples>; other: SpectrumView<'samples>; }
machine nested<'samples>(batch: Batch<'samples>, column: u64) -> f64
requires column < batch.selected.samples.len { batch.selected.samples[column] }

data ForwardView<'data> [copy] { samples: &'data [u8]; }
machine sink_length<'data>(input: ForwardView<'data>) requires input.samples.len >= 0 { }
machine forward_length<'data>(source: ForwardView<'data>) { sink_length(source); }

data BorrowedView<'data> [copy] { samples: &'data [u8]; }
machine sink_borrowed<'data>(input: &BorrowedView<'data>, index: u64) -> u8 requires index < input.samples.len { input.samples[index] }
machine forward_borrowed<'data>(source: &BorrowedView<'data>, index: u64) -> u8 requires index < source.samples.len { sink_borrowed(source, index) }

// Element type applications do not change descriptor metadata identity.
data TypedView<'data, Element> [copy] { samples: &'data [Element]; }
machine checked_length<'data, Element>(view: TypedView<'data, Element>, index: u64) -> u64
requires index < view.samples.len { index }
machine forward_typed<'data, Element>(view: TypedView<'data, Element>, index: u64) -> u64
requires index < view.samples.len { checked_length(view, index) }
