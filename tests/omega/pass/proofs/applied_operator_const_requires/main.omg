// The operator application occurs only in a proof clause, never at runtime.
// Carrier<8> must bind the selected operator's const Width to 8.
data Carrier<const Width: u64> { marker: u64; }

machine + Carrier::select<const Width: u64>(carrier: Carrier<Width>, value: u64) -> u64
requires value < Width
{
    value
}

// Expected: check. The selected width is 8 and the actual value is 4.
// Only the actual selected bound, not caller Width, licenses the application.
machine witness(carrier: Carrier<8>, value: u64, Width: u64)
requires value == 4
requires Width == 16
requires value < 8
requires (carrier + value) == (carrier + value)
{}

machine main() {}
