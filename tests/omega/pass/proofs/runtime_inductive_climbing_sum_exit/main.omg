// RUN CANARY (exit 70): the native twin of proofs/proof_inductive_climbing_sum.
// The same bounded-distance induction (the recursive arm assumes `climb`'s
// own `ensures` at (limit, index + 1, acc + 1) because the argumented
// `(index, limit) -> Nat::BoundedDistance` measure strictly decreases under
// the `index < limit` guard) must certify a path that executes natively:
// the published Terminal artifact has to carry the `embed` guarantee, the
// requires at every arrival and the bounded-distance ranking, not only the
// source checker's verdict. `main` stores the limit in a field and passes
// the field read, so the receiver's recursion runs on a value the program
// holds at runtime rather than on a literal argument; the call still owes
// `climb`'s three `requires` conjuncts at that arrival. climb(4, 0, 0)
// visits (4, 0, 0), (4, 1, 1), (4, 2, 2), (4, 3, 3), (4, 4, 4) and returns
// 4; the program exits 70 on that value and 71 otherwise.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    limit: u64;
}

machine Main::main(&mut self) reaches Console {
    self.limit = 4;
    let total: u64 = self.climb(self.limit, 0, 0);
    transition total == 4 {
        true -> good(&mut self)
        _ -> bad(&mut self)
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}

machine Main::climb(&mut self, limit: u64, index: u64, acc: u64) -> u64
requires
    limit <= 1000,
    acc <= index,
    acc <= 1000
terminates by (index, limit) -> Nat::BoundedDistance;
ensures
    embed(result) >= embed(acc) + embed(limit) - embed(index)
{
    transition index < limit {
        true -> climb(limit, index + 1, acc + 1)
        false -> acc
    }
}
