// Digit bytes written by a nested loop keep a UTF-8 row printable (exit 70).
//
// A 9x9 times table writes each product's tens and ones digits into a
// `[u8; 28] in Utf8` row, then prints it. Proving the stored bytes are ASCII
// needs the row and column bounds that invariant discovery finds over more
// than one round. A later round can return a site under its old obligation
// identity with a different question (a strengthened goal or new axioms); a
// discovery roster keyed by that identity alone never re-asked it, so a Unit
// call requirement stayed unproved and native production refused the
// program. Exit 71 means a bounds guard failed at run time.
use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 28]::Utf8
requires
    valid_utf8(self);
data Main {
    console: Binding<Console>;
    line: [u8; 28] in Utf8;
    i: i32 in Wrapping;   // row factor 1..9
    j: i32 in Wrapping;   // column factor 1..9
    k: i32 in Wrapping;   // clear index
    p: i32 in Wrapping;   // product i*j
    tens: i32 in Wrapping;
    ones: i32 in Wrapping;
    o0: i32 in Wrapping;  // column byte offset (j-1)*3
    o1: i32 in Wrapping;  // o0 + 1
    tc: u8;               // tens char (or space)
    oc: u8;               // ones char
}

machine Main::main(&mut self) reaches Console {
    self.line = "                            ";
    self.i = 1;
    transition { _ -> row_loop() }

    state row_loop(&mut self) {
        transition self.i >= 1 && self.i <= 9 { true -> clear_init() _ -> finish() }
    }
    // clear the row buffer to spaces
    state clear_init(&mut self) {
        self.k = 0;
        transition { _ -> clear() }
    }
    state clear(&mut self) {
        transition self.k >= 0 && self.k < 28 { true -> clear_cell() _ -> col_init() }
    }
    state clear_cell(&mut self) {
        self.line[self.k] = 32; // ' '
        self.k = self.k + 1;
        transition { _ -> clear() }
    }
    state col_init(&mut self) {
        self.j = 1;
        transition { _ -> col_loop() }
    }
    state col_loop(&mut self) {
        transition self.j >= 1 && self.j <= 9 { true -> cell() _ -> emit_row() }
    }
    state cell(&mut self) {
        self.p = self.i * self.j;
        self.tens = self.p / 10;
        self.ones = self.p % 10;
        self.oc = narrow_i32_to_u8_trapping((self.ones + 48) as i32);
        transition self.tens > 0 { true -> cell_tens() _ -> cell_space() }
    }
    state cell_tens(&mut self) {
        self.tc = narrow_i32_to_u8_trapping((self.tens + 48) as i32);
        transition { _ -> cell_write() }
    }
    state cell_space(&mut self) {
        self.tc = 32; // leading space for single-digit products
        transition { _ -> cell_write() }
    }
    state cell_write(&mut self) {
        self.o0 = (self.j - 1) * 3;
        self.o1 = self.o0 + 1;
        transition self.o0 >= 0 && self.o0 < 28 && self.o1 >= 0 && self.o1 < 28 {
            true -> cell_store()
            _ -> bad()
        }
    }
    state cell_store(&mut self) {
        self.line[self.o0] = self.tc;
        self.line[self.o1] = self.oc;
        self.j = self.j + 1;
        transition { _ -> col_loop() }
    }
    state emit_row(&mut self) {
        self.console.write_line(self.line);
        self.i = self.i + 1;
        transition { _ -> row_loop() }
    }

    state finish(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
