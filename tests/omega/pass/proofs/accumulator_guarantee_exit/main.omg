use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let total: u64 = climb(4, 10);
    transition total == 14 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine climb(remaining: u64, acc: u64) -> u64
    requires 0 <= remaining && remaining <= 1000 && 0 <= acc && acc <= 1000
terminates by remaining -> Nat::Descending;
ensures result == acc + remaining
{
    transition remaining > 0 && acc < 1000 {
        true -> climb(remaining - 1, acc + 1)
        false -> (acc + remaining)
    }
}
