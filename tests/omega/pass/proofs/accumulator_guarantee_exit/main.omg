use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let total: u64 = climb(4, 10);
    transition total == 14 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine climb(remaining: u64[0..=1000], acc: u64[0..=1000]) -> u64
terminates by remaining -> Nat::Descending;
ensures result == acc + remaining
{
    transition remaining > 0 && acc < 1000 {
        true -> climb(remaining - 1, acc + 1)
        false -> (acc + remaining)
    }
}
