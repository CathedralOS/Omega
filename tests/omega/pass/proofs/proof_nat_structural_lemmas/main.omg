// Math roster N3 rung 1: the STRUCTURAL mini-judge proves the equality
// kernel over proof-only data -- reflexivity (a == a), nullary-case
// equality (Nat::Zero == Nat::Zero), and symmetry/transitivity falling
// out of requires-equality substitution. Distinct-case claims refute
// (fail/proofs/nat_structural_disproof_refuted); anything beyond this
// term language (payload constructors are grammar-gated in fact
// position, proof-machine applications await unfolding) still fences
// with the N3 pointer (fail/proofs/structural_ensures_unjudged_rejected).
use omega::language::core::nat;
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
machine nat_refl(a: Nat)
ensures
    a == a
{
}
machine zero_refl()
ensures
    Nat::Zero == Nat::Zero
{
}
machine nat_symm(a: Nat, b: Nat)
requires
    a == b
ensures
    b == a
{
}
machine nat_trans(a: Nat, b: Nat, c: Nat)
requires
    a == b && b == c
ensures
    a == c
{
}
// Bodied identity: the sole unguarded value arm binds `result` totally.
machine nat_id(b: Nat) -> Nat
ensures
    result == b
{
    transition { _ -> (b) }
}
// INJECTIVITY: the parenthesized case literals re-enable struct literals
// inside the contract grammar, both equality fences stand down for
// recursive proof data in fact position, and the judge decomposes
// same-case constructor equations pairwise.
machine succ_inj(a: Nat, b: Nat)
requires
    (Nat::Succ { prev: a }) == (Nat::Succ { prev: b })
ensures
    a == b
{
}
// COMPUTE-MODE + STRUCTURAL INDUCTION now live IN CORE: nat.omg carries
// add_zero_left (extraction shape, unfolds add's Zero arm) and
// add_zero_right (right identity by induction) as PROVEN library lemmas,
// machine-checked for every importer -- including this canary, whose
// `use` line exercises them. Ground compute stays program-side:
// 1 + 1 == 2 by two unfold steps (Succ arm, then Zero).
machine one_plus_one()
ensures
    (add(Nat::Succ { prev: Nat::Zero }, Nat::Succ { prev: Nat::Zero })) == (Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } })
{
}
// FACT CONSUMPTION: cite core add_zero_right's proven right-identity theorem,
// then return the value named by that fact. The theorem itself is resultless.
machine cite_right(a: Nat) -> Nat
ensures
    result == a
{
    add_zero_right(a);
    transition { _ -> a }
}
// STATEMENT-CALL CITATION (ch10 "Citing Proofs"; the settled proof-citation
// rule): the bare statement call delivers add_zero_right's proven LAW
// conjunct `add(a, Zero) == a` instantiated at `b` -- explicit fact
// injection, erased at codegen. Without the citation this exact goal
// FENCES (fail/proofs/uncited_structural_fact_rejected): nothing is
// global, nothing applies silently.
machine cite_zero(b: Nat)
ensures
    (add(b, Nat::Zero)) == b
{
    add_zero_right(b);
}
// COMMUTATIVITY, consumed: core add_comm is PROVEN (induction with
// per-arm sub-state citations -- N3 rung 2); citing it here injects the
// law at (x, y). The peak of the Peano ladder so far.
machine cite_comm(x: Nat, y: Nat)
ensures
    (add(x, y)) == (add(y, x))
{
    add_comm(x, y);
}
// The commutative-semiring surface, consumed: core carries add_assoc and
// mul_comm PROVEN (mul_comm's ladder: mul_zero_right -> mul_succ_right's
// three-citation choreography -> mul_comm); citing them here pins every
// importer's access to the full law set.
machine cite_assoc(x: Nat, y: Nat, z: Nat)
ensures
    (add(add(x, y), z)) == (add(x, add(y, z)))
{
    add_assoc(x, y, z);
}
machine cite_mul_comm(x: Nat, y: Nat)
ensures
    (mul(x, y)) == (mul(y, x))
{
    mul_comm(x, y);
}
