// Expected exit: 0
let within(limit: u64, value: u64): core::Strict<0> = !(value > limit);
machine consume(value: u64) -> u64
requires within(5, value)
{ 5u64 - value }
machine main() crashes Trap {
    let result: u64 = consume(3);
    transition result == 2 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
