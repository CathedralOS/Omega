// Expected exit: 70.
use omega::language::core::nat;
use omega_language_std::console;

data Observation { value: Nat; other: Nat; }

machine project<machine Read>(index: Nat) -> Nat
where machine Read(index: Nat) -> Observation terminates;
{
    let observation: Observation = Read(index);
    transition { _ -> observation.value }
}

machine forwarded<machine Read>(index: Nat) -> Nat
where machine Read(index: Nat) -> Observation terminates;
{
    transition { _ -> (project<Read>(index)) }
}

machine result_projection<machine Read>(index: Nat)
where machine Read(index: Nat) -> Observation terminates;
ensures
    project<Read>(index) == (Read(index)).value;
    forwarded<Read>(index) == (Read(index)).value
{
}

machine literal(index: Nat) -> Observation terminates; {
    Observation { value: index, other: Nat::Zero }
}

machine concrete_projection(index: Nat)
ensures
    project<literal>(index) == index;
    forwarded<literal>(index) == index
{
    result_projection<literal>(index);
}

machine verified_exit(code: i32) -> i32
requires
    project<literal>(Nat::Zero) == Nat::Zero;
    forwarded<literal>(Nat::Zero) == Nat::Zero
{
    code
}

data Main {}

machine Main::main(main: &mut Main) reaches Console {
    concrete_projection(Nat::Zero);
    let code: i32 = verified_exit(70);
    Console::exit_process(code);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
