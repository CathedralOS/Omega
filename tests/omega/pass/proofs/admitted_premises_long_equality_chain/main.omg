// Formation of every increment has an independent bound; the result goal
// consumes the whole seventeen-value equality chain.
machine chained(value00: i32, value01: i32, value02: i32, value03: i32, value04: i32, value05: i32, value06: i32, value07: i32, value08: i32, value09: i32, value10: i32, value11: i32, value12: i32, value13: i32, value14: i32, value15: i32, value16: i32) -> i32
requires value01 <= 100i32
requires value02 <= 100i32
requires value03 <= 100i32
requires value04 <= 100i32
requires value05 <= 100i32
requires value06 <= 100i32
requires value07 <= 100i32
requires value08 <= 100i32
requires value09 <= 100i32
requires value10 <= 100i32
requires value11 <= 100i32
requires value12 <= 100i32
requires value13 <= 100i32
requires value14 <= 100i32
requires value15 <= 100i32
requires value16 <= 100i32
requires value00 == value01 + 1i32
requires value01 == value02 + 1i32
requires value02 == value03 + 1i32
requires value03 == value04 + 1i32
requires value04 == value05 + 1i32
requires value05 == value06 + 1i32
requires value06 == value07 + 1i32
requires value07 == value08 + 1i32
requires value08 == value09 + 1i32
requires value09 == value10 + 1i32
requires value10 == value11 + 1i32
requires value11 == value12 + 1i32
requires value12 == value13 + 1i32
requires value13 == value14 + 1i32
requires value14 == value15 + 1i32
requires value15 == value16 + 1i32
ensures result == value16 + 16i32 { value00 }
machine main() {}
