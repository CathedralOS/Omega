// Expected: descend(3, 9) returns 1, so Main exits 70.
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let floor: u64 = descend(3, 9);
    transition floor == 1 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}


machine descend(n: u64, previous: u64) -> u64
requires n <= previous && previous <= 1000
terminates by n -> Nat::Descending;
ensures result <= previous
{
    transition n > 1 {
        true -> carry(n - 1, n)
        false -> loop(n, previous)
    }
    state carry(n: u64, p: u64) -> u64
    requires n > 0 && n <= p && p <= 1000
    {
        transition { _ -> descend(n - 1, p) }
    }
    state loop(n: u64, p: u64) -> u64
    requires n <= p && p <= 1000
    {
        transition n > 0 {
            true -> loop(n - 1, n)
            false -> p
        }
    }
}
