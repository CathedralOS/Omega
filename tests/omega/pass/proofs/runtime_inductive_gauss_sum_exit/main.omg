// RUN CANARY (exit 70): the native twin of proofs/proof_inductive_gauss_sum.
// The same inductive `ensures` (2 * gauss_sum(n, acc) == 2*acc + n*(n+1),
// judged per transition arm with the recursive arm assuming the machine's
// own guarantee at (n - 1, acc + n) under the `terminates by n` descent)
// must certify a path that executes natively: the published Terminal
// artifact has to carry the Wrapping guarantee and the countdown's
// certificate, not only the source checker's verdict. `main` stores the
// count in a field and passes the field read, so the receiver's recursion
// runs on a value the program holds at runtime rather than on a literal
// argument. gauss_sum(4, 0) visits (4, 0), (3, 4), (2, 7), (1, 9), (0, 10)
// and returns 10; the program exits 70 on that value and 71 otherwise.
use omega_language_std::console;

data Main {
    count: u64 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 4;
    let total: u64 in Wrapping = Main::gauss_sum(main.count, 0);
    transition total == 10 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine Main::gauss_sum(n: u64 in Wrapping, acc: u64 in Wrapping) -> u64 in Wrapping
terminates by n;
ensures
    result * 2 == acc * 2 + n * (n + 1)
{
    transition n > 0 {
        true -> gauss_sum(n - 1, acc + n)
        false -> acc
    }
}
