// Expected exit: 0
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; items: [u8; 64]; }
machine Main::main(main: &mut Main) reaches Console {
    let read: LineReadResult = block main.console.read_line(&mut main.items);
    transition read { LineReadResult::LineComplete { count } -> inspect(main, 0) _ -> done(main) }
    state inspect(main: &mut Main, selector: u64) requires selector < 64 {
        transition main.items[selector] >= 48 && main.items[selector] <= 49 { true -> bounded(main, selector) false -> done(main) }
    }
    state bounded(main: &mut Main, selector: u64) requires selector < 64 requires main.items[selector] >= 48 {
        transition { _ -> done(main) }
    }
    state done(main: &mut Main) { main.console.exit_process(0); }
}
