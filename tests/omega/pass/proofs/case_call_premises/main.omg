data Tree {
    marked: bool;
    case Empty;
    case Node(child: Tree);
}

machine empty_only(value: Tree) -> Tree
requires value in Tree::Empty;
terminates;
{ value }

machine node_only(value: Tree) -> Tree
requires value in Tree::Node;
terminates;
{ value }

// Tag preconditions do not constrain common or payload field values.
machine concrete()
ensures empty_only(Tree::Empty { marked: true }) == empty_only(Tree::Empty { marked: true });
ensures node_only(Tree::Node { marked: true, child: Tree::Empty })
    == node_only(Tree::Node { marked: true, child: Tree::Empty });
{}

machine symbolic(value: Tree)
requires value in Tree::Empty;
ensures empty_only(value) == empty_only(value);
{}

machine alias_subject(value: Tree, alias: Tree)
requires value == alias;
requires value in Tree::Empty;
ensures empty_only(alias) == empty_only(alias);
{}

machine forward(value: Tree, other: Tree) -> Tree
requires value in Tree::Empty;
terminates;
{
    transition { _ -> next(other, value) }
    state next(unknown: Tree, known: Tree) -> Tree {
        transition { _ -> (empty_only(known)) }
    }
}

machine make_empty(marked: bool) -> Tree
ensures result in Tree::Empty;
terminates;
{ transition { _ -> Tree::Empty { marked: marked } } }

machine preserve_empty(value: Tree) -> Tree
requires value in Tree::Empty;
ensures result in Tree::Empty;
terminates;
{ value }

// Only the declared tag is transported; marked remains unconstrained.
machine completed_calls() -> Tree
terminates;
{
    let first: Tree = make_empty(true);
    let second: Tree = preserve_empty(first);
    transition { _ -> next(second) }
    state next(known: Tree) -> Tree {
        transition known {
            Tree::Empty -> (empty_only(known))
            Tree::Node { child } -> child
        }
    }
}
