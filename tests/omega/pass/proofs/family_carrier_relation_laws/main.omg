// A machine-indexed carrier family satisfies relation laws. The trait names
// the bare family `Chain`; each law quantifies its index packs independently
// and the realizer's own machine binders instantiate them through its
// parameter types, so a realizer may require exactly the requirement's
// premise at its recovered packs. The family's fields hold no borrowed
// storage, so its borrow frontier is empty for every pack. Binder names are
// positional: `chained_symmetric` names its first binder `Second`.
use omega::language::core::relation;

data Index {
}

data Chain<machine Step>
requires machine Step(index: Index) -> Index;
{
    case End;
    case Link(next: Chain<Step>);
}

proposition chained<machine Left, machine Right>(
    left: Chain<Left>,
    right: Chain<Right>
) = true;

machine chained_reflexive<machine Only>(chain: Chain<Only>)
requires machine Only(index: Index) -> Index;
ensures chained<Only, Only>(chain, chain)
{
}

machine chained_symmetric<machine Second, machine First>(
    first: Chain<Second>,
    second: Chain<First>
)
requires machine Second(index: Index) -> Index;
requires machine First(index: Index) -> Index;
requires chained<Second, First>(first, second)
ensures chained<First, Second>(second, first)
{
}

machine chained_transitive<machine Low, machine Mid, machine High>(
    low: Chain<Low>,
    mid: Chain<Mid>,
    high: Chain<High>
)
requires machine Low(index: Index) -> Index;
requires machine Mid(index: Index) -> Index;
requires machine High(index: Index) -> Index;
requires
    chained<Low, Mid>(low, mid)
    chained<Mid, High>(mid, high)
ensures chained<Low, High>(low, high)
{
}

ChainEquivalence satisfies Equivalence<Chain, chained> {
    Reflexive::reflexive = chained_reflexive;
    Symmetric::symmetric = chained_symmetric;
    Transitive::transitive = chained_transitive;
}

machine main() {
}
