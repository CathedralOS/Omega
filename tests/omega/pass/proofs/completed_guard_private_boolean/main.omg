// Expected exit: 0. A completed private Boolean predicate retains its full integer condition.
machine at_least_seven(value: u64) -> bool { value >= 7 }
machine subtract_seven(value: u64) -> u64 {
    match at_least_seven(value) {
        true -> value - 7,
        _ -> 0
    }
}
machine main() crashes Trap {
    let positive: u64 = subtract_seven(9);
    let fallback: u64 = subtract_seven(2);
    transition positive == 2 && fallback == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
