// A preceding value binding advances the path without replacing its eventual result.
machine identity(value: bool) -> bool
ensures result == value { value }

machine forwarded(value: bool) -> bool
ensures result == value {
    transition { _ -> finish(value) }
    machine finish(observed: bool) -> bool {
        let unused: bool = identity(false) || identity(false);
        observed
    }
}

machine main() crashes Trap {
    let observed: bool = forwarded(true);
    transition observed { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
