trait Evidence {}
proposition available() evidence Evidence;
public machine step() -> bool blocks; { true }
machine scan(remaining: i32 in Wrapping) -> bool
requires incoming: available()
{
    let ready: bool = block step();
    transition remaining > 0 {
        true -> block scan(remaining - 1; incoming)
        _ -> ready
    }
}
machine caller()
requires incoming: available()
{
    let result: bool = block scan(3; incoming);
}
