// The second guard exits with remaining == 3, after only one decrement.
// Returning the accumulator observes that early exit: four steps give 1003,
// but the authored guard must stop at 1000.
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let total: u64 = climb(4, 999);
    transition total == 1000 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine climb(remaining: u64, acc: u64) -> u64
requires remaining <= 1000 && acc <= 1000
terminates by remaining -> Nat::Descending;
{
    transition remaining > 0 && acc < 1000 {
        true -> climb(remaining - 1, acc + 1)
        false -> acc
    }
}
