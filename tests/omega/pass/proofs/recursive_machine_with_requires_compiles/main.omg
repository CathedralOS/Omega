// Regression pin: a `requires` clause on a recursive machine used to crash
// the compiler with a stack overflow -- the contract evaluator's constant
// walk (ContractExpressionEvaluator::integer_value) followed the SELF call
// site's arguments in a loop (`limit` resolves to the argument at the
// recursive call, whose names resolve back through the same call site
// forever). The evaluator now detects the cycle and stands down (unknown),
// so discharge falls to the other provers. This canary's value is that it
// compiles AT ALL; the requires shape is chosen so both call sites
// legitimately discharge:
//   - the outer call passes the literal 7, proven by constant following
//     (the same walk the cycle guard must not break), and
//   - the recursive call threads `limit` unchanged, proven by the caller's
//     own `requires limit > 0` entry fact.
// Exact accumulator arithmetic additionally needs a preserved budget. For
// 0 < n <= 1000, (acc + n) + (n - 1) * 1000 <= acc + n * 1000.
// That budget survives each call without changing the algorithm or selecting
// Wrapping, and supplies room for the next Exact accumulator update.

data Main {
}

machine Main::main(&mut self) {
    let total: u64 = self.gauss_sum(4, 0, 7);
}

machine Main::gauss_sum(&mut self, n: u64, acc: u64, limit: u64) -> u64
terminates by n;
requires
    limit > 0,
    n <= 1000,
    acc <= 1000000,
    acc + n * 1000 <= 1000000
{
    transition n > 0 {
        true -> gauss_sum(n - 1, acc + n, limit)
        false -> acc
    }
}
