// Expected exit: 0.
data Context { count: u64; }
machine set(context: &mut Context) -> bool { context.count = 5; true }
machine main() crashes Trap {
    let mut record: Context = Context { count: 0 };
    let alias: &mut Context = &mut record;
    transition set(alias) && alias.count < 6 { true -> bounded(alias) false -> bad() }
    machine bounded(value: &Context) requires value.count < 6 { transition value.count == 5 { true -> done() false -> bad() } }
    machine done() { }
    machine bad() { crash Trap; }
}
