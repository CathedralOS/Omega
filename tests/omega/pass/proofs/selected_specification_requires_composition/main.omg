use omega::language::core::nat;

machine selected_pair<machine First, machine Second>(left: Nat, right: Nat) -> Nat
where machine First(value: Nat) -> Nat;
where machine Second(value: Nat) -> Nat;
requires
    (saturating_sub(First(left), left)) == Nat::Zero;
    (saturating_sub(Second(right), right)) == Nat::Zero
{ left }

machine reordered<machine Left, machine Right>(left: Nat, right: Nat)
where machine Left(value: Nat) -> Nat;
where machine Right(value: Nat) -> Nat;
requires
    (saturating_sub(Left(left), left)) == Nat::Zero;
    (saturating_sub(Right(right), right)) == Nat::Zero
ensures selected_pair<Right, Left>(right, left) == right
{}

machine invoke<machine Selected>(value: Nat) -> Nat
where machine Selected(value: Nat) -> Nat;
{ value }

machine nested_identity<machine Modulus>(value: Nat) -> Nat
where machine Modulus(value: Nat) -> Nat;
requires (saturating_sub(invoke<Modulus>(value), value)) == Nat::Zero
{ value }

machine nested<machine Choice>(subject: Nat)
where machine Choice(input: Nat) -> Nat;
requires (saturating_sub(invoke<Choice>(subject), subject)) == Nat::Zero
ensures nested_identity<Choice>(subject) == subject
{}
