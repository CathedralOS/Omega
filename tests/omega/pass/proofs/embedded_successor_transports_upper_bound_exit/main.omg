// Expected exit: 0
// The embedded successor equation transports the original length ceiling.
machine remain<Length: u64, NextLength: u64, Total: u64>() -> u64
requires Length <= 7 && embed(Length) + 1 == embed(NextLength)
         && embed(Total) <= 10 * embed(NextLength)
{
    80u64 - Total
}
machine main() crashes Trap {
    let result: u64 = remain<0, 1, 7>();
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
