// Expected exit: 0
// A qualified operand retains its nominal source theory while comparisons use
// its scalar carrier. Field, helper result and state transport keep that fact.
domain i64::Meters;
data Measurement { distance: i64 in Meters; }
let meter_identity(value: i64 in Meters): i64 in Meters = value;

machine identity(value: i64 in Meters) -> i64 in Meters
ensures result == meter_identity(value)
{
    value
}

machine main() crashes Trap {
    let distance: i64 in Meters = 29i64 as i64 in Meters;
    let measurement: Measurement = Measurement { distance: distance };
    let returned: i64 in Meters = identity(measurement.distance);
    transition returned == distance {
        true -> check(returned)
        _ -> wrong()
    }

    machine check(value: i64 in Meters) {
        transition (value as i64) == 29 {
            true -> done()
            _ -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
