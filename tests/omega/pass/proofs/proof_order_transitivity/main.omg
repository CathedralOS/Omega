// Ladder rung L1 (ordering transitivity): a < b and b < c entail a < c.
// Lean analog: `Nat.lt_trans`. Requires chaining two strict-order facts,
// one entailment hop past direct fact matching.

machine less_than_transitive(a: u64, b: u64, c: u64)
requires
    a < b
    b < c
ensures
    a < c
{
}

data Main {
}

machine Main::main(&mut self) {
}
