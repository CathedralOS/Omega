// Expected exit: 0.
// An element-writing call preserves the slice descriptor and its count bound.
data Partition<'storage> { records: &'storage mut [u64]; count: u64; }
machine keep(records: &mut [u64], count: u64) -> u64
requires records.len > 0
ensures result <= count {
    records[0] = 7;
    transition { _ -> count }
}
machine filter<'storage>(partition: &mut Partition<'storage>)
requires partition.count <= partition.records.len && partition.records.len > 0
ensures partition.count <= partition.records.len {
    partition.count = keep(&mut partition.records[..], partition.count);
}

machine main() crashes Trap {
    let mut backing: [u64; 3] = [41, 3, 59];
    let mut partition: Partition = Partition { records: &mut backing[1..2], count: 1 };
    filter(&mut partition);
    transition partition.count == 1 && partition.records.len == 1
        && partition.records[0] == 7 && backing[0] == 41 && backing[2] == 59 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
