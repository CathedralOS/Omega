// Expected exit: 0. Both recursive proof constructors cite the empty theorem.
data Ordinal { case Zero; case Step(previous: Ordinal); }
machine reflexive(value: Ordinal)
ensures value == value
{}
data Context {}
machine main(context: &mut Context) {
    reflexive(Ordinal::Zero);
    reflexive(Ordinal::Step { previous: Ordinal::Zero });
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
