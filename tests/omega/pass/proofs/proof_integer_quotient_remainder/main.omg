// Expected exit: 0. Mathematical contracts erase after their formation and
// theorem obligations have been checked; none executes integer projections.
machine signs()
ensures
    embed(-7i32) / 2 == -3,
    embed(7i32) / -2 == -3,
    embed(-7i32) / -2 == 3,
    embed(7i32) / 2 == 3,
    embed(-7i32) % 2 == -1,
    embed(7i32) % -2 == 1,
    embed(-7i32) % -2 == -1,
    embed(7i32) % 2 == 1,
    (embed(18446744073709551615u64) + 1) / 2 == 9223372036854775808,
    (embed(18446744073709551615u64) + 2) % 2 == 1
{}
machine main() {
    signs();
    quotient_bounds(7);
    anonymous_operands();
    unbounded();
    remainder_bounds(7, 2);
    remainder_window(14);
    nonzero_divisor(2);
    positive_divisor(2);
    negative_divisor(-2);
    ordered_quotient_premise(2);
    named_nonzero_premise(2);
}

machine quotient_bounds(value: i32)
requires value >= 0, value <= 9
ensures embed(value) / 2 >= 0, embed(value) / 2 <= 4
{}

machine anonymous_operands()
ensures
    embed(7i32) / (1 + 1) == 3,
    embed(7i32) % (1 + 1) == 1,
    (5 + 2) / embed(2i32) == 3,
    embed(7i32) / (1 / 2 * 4) == 3,
    embed(7i32) % (1.5 + 0.5) == 1
{}

// The dividend exceeds 128 bits; no host-width landing is involved.
machine unbounded()
ensures
    ((embed(18446744073709551615u64) + 1) * (embed(18446744073709551615u64) + 1) * 2 + 1) / 2 == (embed(18446744073709551615u64) + 1) * (embed(18446744073709551615u64) + 1),
    ((embed(18446744073709551615u64) + 1) * (embed(18446744073709551615u64) + 1) * 2 + 1) % 2 == 1,
    7 / 2 == 3.5
{}

machine remainder_bounds(value: i32, divisor: i32)
requires divisor == 2
ensures embed(value) % embed(divisor) >= -1, embed(value) % embed(divisor) <= 1
{}

machine remainder_window(value: i32)
requires value >= 13, value <= 15
ensures embed(value) % 8 >= 5, embed(value) % 8 <= 7
{}

// Formation consumes only prior facts, including unequal and ordered bounds.
machine nonzero_divisor(divisor: i32)
requires divisor != 0
ensures
    embed(7i32) / embed(divisor) == embed(7i32) / embed(divisor),
    embed(7i32) % embed(divisor) == embed(7i32) % embed(divisor)
{}

machine positive_divisor(divisor: i32)
requires embed(divisor) > 0
ensures embed(7i32) / embed(divisor) == embed(7i32) / embed(divisor)
{}

machine negative_divisor(divisor: i32)
requires divisor < 0
ensures embed(7i32) % embed(divisor) == embed(7i32) % embed(divisor)
{}

// Each partial term forms only on its nonzero edge, including earlier failures.
machine guarded_quotient(divisor: i32)
requires (match divisor != 0 {
    true -> embed(7i32) / embed(divisor),
    _ -> embed(0i32)
}) >= embed(0i32)
{}

machine guarded_remainder(divisor: i32)
requires (match divisor == 0 {
    true -> embed(0i32),
    _ -> embed(7i32) % embed(divisor)
}) >= embed(0i32)
{}

machine guarded_integer_pattern(divisor: i32)
requires (match divisor {
    0 -> embed(0i32),
    _ -> embed(7i32) / embed(divisor)
}) >= embed(0i32)
{}

machine ordered_quotient_premise(divisor: i32)
requires divisor != 0
requires embed(7i32) / embed(divisor) == 3
ensures embed(7i32) / embed(divisor) == 3
{}

let nonzero(value: i32): core::Strict<0> = embed(value) != 0;
machine named_nonzero_premise(divisor: i32)
requires nonzero(divisor)
ensures embed(7i32) / embed(divisor) == embed(7i32) / embed(divisor)
{}

machine ordered_patterns(divisor: i32)
requires (match embed(divisor) {
    embed(0i32) -> embed(0i32),
    embed(7i32) / embed(divisor) -> embed(0i32),
    _ -> embed(0i32)
}) == embed(0i32)
{}
