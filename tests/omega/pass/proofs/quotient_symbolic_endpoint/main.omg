// A rank endpoint may divide by a second symbolic parameter:
// `in 0..(cap / divisor + 6)` — three-parameter symbolic quotient,
// strengthened by the requires band `1 <= divisor <= 5`.
machine walk(remaining: u64, cap: u64, divisor: u64)
    requires 0 <= remaining && remaining <= 5 && 0 <= cap && cap <= 20 && 1 <= divisor && divisor <= 5
terminates by remaining in 0..(cap / divisor + 6);
-> u64 {
    transition { _ -> iterate(divisor, cap, remaining) }
    machine iterate(width: u64, limit: u64, pending: u64) -> u64
        requires 1 <= width && width <= 5 && 0 <= limit && limit <= 20 && 0 <= pending && pending <= 5
    {
        transition pending > 0 {
            true -> iterate(width, limit - 0, pending - 1)
            false -> pending
        }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
