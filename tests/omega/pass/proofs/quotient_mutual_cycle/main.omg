// A mutual call cycle where BOTH members declare quotient rank
// endpoints: `first` ranks `remaining in 0..(cap / 5 + 6)` and
// `second` ranks `pending in 0..(limit / 5 + 6)` — each edge's
// delivered coordinate re-instantiates the callee's endpoint.
data Main { observed: u64; }
machine Main::first(main: &mut Main, remaining: u64, cap: u64) -> u64
    requires 0 <= remaining && remaining <= 5 && 0 <= cap && cap <= 20
terminates by remaining in 0..(cap / 5 + 6) {
    transition remaining > 0 {
        true -> Main::second(main, cap, remaining)
        false -> remaining
    }
}
machine Main::second(main: &mut Main, limit: u64, pending: u64) -> u64
    requires 0 <= limit && limit <= 20 && 0 <= pending && pending <= 5
terminates by pending in 0..(limit / 5 + 6) {
    transition pending > 0 {
        true -> Main::first(main, pending - 1, limit)
        false -> pending
    }
}
machine Main::main(main: &mut Main) -> u64 {
    transition { _ -> Main::first(main, 3, 9) }
}
