// Mathematical applications initialize erased bindings without requesting
// execution. Every binding role retains the checked application and its inputs.
let identity(value: u64): u64 = value;
data Payload { value: u64; proof [erased]: u64; }
machine forget(proof [erased]: u64) {}
machine main() {
    let local [erased]: u64 = identity(7);
    let payload: Payload = Payload { value: 3, proof: identity(8) };
    forget(identity(9));
    transition { _ -> next(identity(10)) }
    machine next(proof [erased]: u64) {}
}
