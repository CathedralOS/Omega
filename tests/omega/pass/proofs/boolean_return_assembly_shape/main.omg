// Checking-only shape control: reordered assembly and its state exits form.
machine choose() -> bool {
    asm {
    entry:
        jmp live;
    skipped:
        jmp no();
    live:
        jmp yes()
    }
    machine no() -> bool { false }
    machine yes() -> bool { true }
}

machine main() -> bool {
    choose()
}
