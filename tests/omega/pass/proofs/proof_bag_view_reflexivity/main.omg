// Ladder rung L6 (proof views): the Bag multiset view from the compile-time
// proofs chapter carries a view equality from requires to ensures unchanged.
// Lean analog: `Multiset.coe_eq_coe` transport / plain `exact h`.
// `core::seq` ships `Bag` as the honest packaging form -- `BagView` carries
// the slice itself, so `Bag(a) == Bag(b)` is the slice view's equality, not
// an order-insensitive multiset fact; the sorted canonical representative
// lands with the slice-extraction rungs. The calls select that declaration
// and the identical atom carries.

use omega::language::core::seq;

machine bag_equality_carries(before: &[u64], items: &[u64])
requires
    Bag(items) == Bag(before)
ensures
    Bag(items) == Bag(before)
{
}

// State requirements use the state's own parameter types. The entry's `value`
// has a different type; both nested constructor results must be prepared.
machine state_constructor_reflexivity(value: u32, tail: Seq<u64>) {
    transition { _ -> conclude(17, tail) }
    state conclude(value: u64, tail: Seq<u64>)
    requires
        (Seq::Cons { head: value, tail: Seq::Cons { head: value, tail: tail } })
        == (Seq::Cons { head: value, tail: Seq::Cons { head: value, tail: tail } })
    {}
}

// A returned record's descriptor dies on the selected edge: one branch moves
// the record to its successor, while the other disposes it in this state.
machine observe_selected_view(keep: bool) -> bool {
    let values: [u64; 3] = [17, 25, 31];
    let items: &[u64] = &values;
    let view: BagView = Bag(items);
    transition keep {
        true -> inspect(view)
        false -> done()
    }
    state inspect(view: BagView) -> bool { view.items.len == 3 }
    state done() -> bool { true }
}

// Expected exit: 0. The checked library also supplies the runtime view.
machine main() crashes Trap {
    let values: [u64; 3] = [17, 25, 31];
    let items: &[u64] = &values;
    let view: BagView = Bag(items);
    transition view.items.len == 3
        && observe_selected_view(true) && observe_selected_view(false) {
        true -> inspect(view.items)
        false -> failed()
    }
    state inspect(items: &[u64]) requires items.len == 3 {
        transition items[0] == 17 && items[1] == 25 && items[2] == 31 {
            true -> passed()
            false -> failed()
        }
    }
    state passed() {}
    state failed() { crash Trap; }
}
