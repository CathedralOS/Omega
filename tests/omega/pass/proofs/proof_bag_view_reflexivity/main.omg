// Bag packages the borrowed slice descriptor in a BagView. The contract
// receives those existing views and carries their descriptor identity from
// requires to ensures; it does not replay a reference-bearing call.

use omega::language::core::Seq;
use omega::language::core::BagView;
use omega::language::core::Bag;

machine bag_equality_carries(before: BagView, items: BagView)
requires
    core::Identity<BagView>(items, before)
ensures
    core::Identity<BagView>(items, before)
{
}

// State requirements use the state's own parameter types. The entry's `value`
// has a different type; both nested constructor results must be prepared.
machine state_constructor_reflexivity(value: u32, tail: Seq<u64>) {
    transition { _ -> conclude(17, tail) }
    machine conclude(value: u64, tail: Seq<u64>)
    requires
        core::Identity<Seq<u64>>(
            Seq::Cons { head: value, tail: Seq::Cons { head: value, tail: tail } },
            Seq::Cons { head: value, tail: Seq::Cons { head: value, tail: tail } }
        )
    {}
}

// A returned record's descriptor dies on the selected edge: one branch moves
// the record to its successor, while the other disposes it in this state.
machine observe_selected_view(keep: bool) -> bool {
    let values: [u64; 3] = [17, 25, 31];
    let items: &[u64] = &values;
    let view: BagView = Bag(items);
    transition keep {
        true -> inspect(view)
        false -> done()
    }
    machine inspect(view: BagView) -> bool { view.items.len == 3 }
    machine done() -> bool { true }
}

// Expected exit: 0. The checked library also supplies the runtime view.
machine main() crashes Trap {
    let values: [u64; 3] = [17, 25, 31];
    let items: &[u64] = &values;
    let view: BagView = Bag(items);
    transition view.items.len == 3
        && observe_selected_view(true) && observe_selected_view(false) {
        true -> inspect(view.items)
        false -> failed()
    }
    machine inspect(items: &[u64]) requires items.len == 3 {
        transition items[0] == 17 && items[1] == 25 && items[2] == 31 {
            true -> passed()
            false -> failed()
        }
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
