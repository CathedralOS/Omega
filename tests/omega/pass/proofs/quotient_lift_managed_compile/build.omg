// Compile canary: the fixture requests package identity through its
// `Build::package` declaration, so the managed quotient request carries
// package provenance rather than the standalone-source identity the
// admission refuses — without depending on the ordinary std package.

machine build(builder: &mut Build) {
    Build::package(builder, "quotient_lift_managed_compile");
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
}
