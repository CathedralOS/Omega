// Free machines over recursive proof-only data may form a non-tail
// call SCC because no runtime frame is emitted: each cross-machine
// edge consumes the case-payload subterm selected by the shared
// witness.
data ProofNat {
    case Zero;
    case Succ(prev: ProofNat);
}
machine left(n: ProofNat) -> ProofNat
terminates by n
{
    transition n {
        ProofNat::Zero -> ProofNat::Zero
        ProofNat::Succ { prev } -> ProofNat::Succ { prev: right(prev) }
    }
}
machine right(n: ProofNat) -> ProofNat
terminates by n
{
    transition n {
        ProofNat::Zero -> ProofNat::Zero
        ProofNat::Succ { prev } -> ProofNat::Succ { prev: left(prev) }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
