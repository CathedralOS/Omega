// LAW-CONFORMANCE PROBE (rearrange rung B): a trait LAW requirement
// (ensures on the requirement) must be backed by the satisfier's PROVEN
// ensures, with the law's op slots resolved through the carrier's own
// conformances -- the op machine is named `plus`, NOT `add`, so the slot
// rewrite is really exercised.
use omega_language_std::console;
use omega::language::core::binding;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

trait RingOps2<T> {
    machine add(a: T, b: T) -> T;
    machine add_assoc(a: T, b: T, c: T)
    ensures add(add(a, b), c) == add(a, add(b, c));
}

machine plus(a: Peano, b: Peano) -> Peano
satisfies RingOps2<Peano>::add
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: plus(pred, b) }
    }
}

// The nat.omg add_assoc shape (pure induction, no citations), over Peano's
// `plus`: proves the LAW the trait declares, so the conformance holds.
machine plus_assoc(a: Peano, b: Peano, c: Peano)
satisfies RingOps2<Peano>::add_assoc
terminates by a;
ensures
    (plus(plus(a, b), c)) == (plus(a, plus(b, c)))
{
    transition a {
        Peano::Zero -> base()
        Peano::Succ { pred } -> step(pred, b, c)
    }
    state base() {
    }
    state step(pred: Peano, b: Peano, c: Peano) {
        plus_assoc(pred, b, c);
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    main.console.exit_process(70);
}
