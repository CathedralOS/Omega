use omega::language::core::float_operations;

// Unsuffixed arguments land at the selected declaration, including in proof
// contracts. The returned zero and the projected zero have the same format.
machine zero_f64() -> f64
ensures Float::meaning64(result) == Float::meaning64(0.0)
{
    0.0
}

machine zero_f32() -> f32
ensures Float::meaning32(result) == Float::meaning32(0.0)
{
    0.0
}
