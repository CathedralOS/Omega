// `live - step` is the moved copy of `remaining` once `stride`'s
// declared floor proves the amount nonzero: the `pair` state's
// telescope demotes the stale `saved` snapshot rather than forcing an
// equality the step broke, and the loop still descends through
// `live`.
machine walk(remaining: u32, stride: u32)
    requires 0 <= remaining && remaining <= 9 && 1 <= stride && stride <= 5
terminates by remaining in 0..=9;
-> u32 {
    transition { _ -> pair(remaining, remaining, stride) }
    machine pair(live: u32, saved: u32, step: u32) -> u32
        requires 0 <= live && live <= 9 && 0 <= saved && saved <= 9 && 1 <= step && step <= 5
    {
        transition live >= step {
            true -> pair(live - step, saved, step)
            false -> live
        }
    }
}

data Main {}
machine Main::main(main: &mut Main) { }
