// Expected exit: 0
// A completed store retains its captured address and its returned value facts.
data Cell [copy] { value: u64; }
data Holder { cell: &mut Cell; }
data Store [copy] { value: u64; other: u64; }
machine retarget(holder: &mut Holder, replacement: &mut Cell) -> u64
ensures result == 11 { holder.cell = replacement; 11 }
machine eleven() -> u64 ensures result == 11 { 11 }
machine select_eleven(position: &mut u64) -> u64
ensures result == 11 { position = 1; 11 }
machine modify(store: &mut Store) -> u64
ensures result == 11 { store.other = 77; 11 }
machine demand(value: u64) requires value == 11 {}
machine captured_write(values: &mut [u64])
requires values.len >= 2;
ensures values[0] == 11;
{
    let mut position: u64 = 0;
    values[position] = select_eleven(&mut position);
}
machine incoming(store: &mut Store) {
    store.value = modify(store);
    demand(store.value);
}
machine indexed(values: &mut [u64], position: u64)
requires position < values.len {
    values[position] = 11;
    demand(values[position]);
}
machine main() crashes Trap {
    let mut previous: Cell = Cell { value: 0 };
    let mut replacement: Cell = Cell { value: 99 };
    let mut holder: Holder = Holder { cell: &mut previous };
    holder.cell.value = retarget(&mut holder, &mut replacement);
    demand(previous.value);
    let mut scalar: u64 = 0;
    scalar = eleven();
    demand(scalar);
    let mut store: Store = Store { value: 0, other: 0 };
    store.value = modify(&mut store);
    demand(store.value);
    let alias: &mut Store = &mut store;
    alias.value = modify(alias);
    demand(alias.value);
    incoming(alias);
    let mut values: [u64; 2] = [0, 99];
    indexed(&mut values[..], 1);
    let mut position: u64 = 0;
    values[position] = select_eleven(&mut position);
    demand(values[0]);
    let mut captured: [u64; 2] = [0, 99];
    captured_write(&mut captured[..]);
    demand(captured[0]);
    transition previous.value == 11 && holder.cell.value == 99 && scalar == 11
        && store.value == 11 && store.other == 77 && values[0] == 11
        && values[1] == 11 && position == 1 && captured[0] == 11
        && captured[1] == 99 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
