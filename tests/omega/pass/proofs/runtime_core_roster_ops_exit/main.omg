// RUN CANARY (exit 70) + interpreter differential. Math roster N4: the
// core library's Peano operations (nat.omg's add/mul; add_zero_left and
// add_zero_right ship as PROVEN lemmas) and generic recursive Seq<T>
// with its own structurally-recursive `length` proof machine + the
// length_empty lemma (seq.omg) all validate through the machine-stratum
// contagion and the structural entailment judge. This program adds one
// more PROVEN lemma on top -- a program-side extension of the roster --
// then runs untouched (everything here is proof-only).
use omega::language::core::nat;
use omega::language::core::seq;
use omega_language_std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
// length of a two-element sequence is Succ(Succ(Zero)) -- two unfold
// steps through the core `length` machine's Cons arm, then the Empty arm.
machine length_two(a: u64, b: u64)
ensures
    (length(Seq::Cons { head: a, tail: Seq::Cons { head: b, tail: Seq::Empty } }))
        == (Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } })
{
}
// Citing the core's COMPOSED Seq law (length distributes over append,
// proven by induction in seq.omg): the citation delivers it at (u, v).
machine cite_length_append(u: Seq<u64>, v: Seq<u64>)
ensures
    (length(append(u, v))) == (add(length(u), length(v)))
{
    length_append(u, v);
}
