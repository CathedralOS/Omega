// A transparent proposition premise means its body: `requires p(a, b)`
// installs the identity equations `p`'s definition states under the actual
// arguments, through the same unfolding an `ensures p(..)` goal uses. The
// premise may sit on a machine, on a state arrival, or on a realizer of a
// trait requirement whose proposition parameter the edge selects; its body
// may be a conjunction or another proposition's application. Identity
// equality of a record is the conjunction of its field equalities.
use omega::language::core::relation;

data Point {
    x: u32;
    y: u32;
}

data Segment {
    start: Point;
    end: Point;
}

proposition same_x(left: Point, right: Point) = left.x == right.x;
proposition same_point(left: Point, right: Point) = left.x == right.x && left.y == right.y;
proposition coincident(left: Point, right: Point) = same_point(right, left);

// A conjunction premise proves the reversed conjunction.
machine same_point_symmetric(a: Point, b: Point)
requires same_point(a, b)
ensures same_point(b, a)
{
}

// A definition over another definition proves record equality.
machine coincident_equal(a: Point, b: Point)
requires coincident(a, b)
ensures a == b
{
}

// Proposition and expression premises compose.
machine same_x_chain(a: Point, b: Point, c: Point)
requires
    same_x(a, b)
    b.x == c.x
ensures same_x(a, c)
{
}

// Field arguments unfold to field places; equality extends through nesting.
machine segment_equal(first: Segment, second: Segment)
requires
    same_point(first.start, second.start)
    coincident(first.end, second.end)
ensures first == second
{
}

// A state arrival premise establishes a citation's unfolded requirement.
machine state_premise(a: Point, b: Point)
requires same_point(a, b)
{
    transition { _ -> settle(a, b) }
    machine settle(first: Point, second: Point)
    requires same_point(first, second)
    {
        same_point_symmetric(second, first);
    }
}

// Realizers rename the requirement's parameters positionally; the inherited
// law unfolds through the selected family.
machine point_symmetric(first: Point, second: Point)
satisfies Symmetric<Point, same_point>::symmetric
requires same_point(first, second)
ensures same_point(second, first)
{
}

machine x_transitive(a: Point, b: Point, c: Point)
satisfies Transitive<Point, same_x>::transitive
requires
    same_x(a, b)
    same_x(b, c)
ensures same_x(a, c)
{
}

machine point_antisymmetric(a: Point, b: Point)
satisfies Antisymmetric<Point, same_point>::antisymmetric
requires
    same_point(a, b)
    same_point(b, a)
ensures a == b
{
}

machine main() {}
