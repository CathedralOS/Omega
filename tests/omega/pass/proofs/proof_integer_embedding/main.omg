// Embedding observes integer payloads in mathematical Int without overflowing
// or changing the arithmetic policy of their source bindings.
machine unsigned_successor(value: u64)
ensures embed(value) + 1 > embed(value)
{}

machine signed_identity(value: i32 in Trapping)
ensures embed(value) == embed(value)
{}

// Both operand results must retain Int, not become unknown float candidates.
machine commuted_successor(value: u64)
ensures (embed(value) + 1) == (1 + embed(value))
{}

machine main() {}

// Policy is local to the operation, not selected by an embed elsewhere.
machine wrapping_without_embedding(value: u8 in Wrapping)
requires value == 255
ensures value + 1 == 0
{}

machine nested_saturation(value: i8 in Saturating)
requires value == 127
ensures embed((value + 1) - 1) == 126
{}
