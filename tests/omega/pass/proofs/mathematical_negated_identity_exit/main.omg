// Expected exit: 0
// Named negation retains the formed identity and its exact typed subjects.
data Pair [copy] { first: u8; last: u8; }
let different<A: core::Type<0>>(left: A, right: A): core::Strict<0> =
    !core::Identity<A>(left, right);
let same_twice<A: core::Type<0>>(left: A, right: A): core::Strict<0> =
    !!core::Identity<A>(left, right);
machine consume(left: Pair, right: Pair) -> u64
requires different<Pair>(left, right)
requires same_twice<Pair>(left, left)
{ (left.first as u64) + (right.last as u64) }
machine distinct_zero() reaches terminates
ensures different<f64>(-0.0f64, 0.0f64)
{ }
machine main() crashes Trap {
    distinct_zero();
    let result: u64 = consume(Pair { first: 17u8, last: 3u8 }, Pair { first: 17u8, last: 29u8 });
    transition result == 46 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
