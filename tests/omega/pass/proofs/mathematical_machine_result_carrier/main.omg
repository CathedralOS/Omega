data Packet [copy] { value: u8; }
machine packet(value:u8)->Packet { Packet { value: value } }
let same_packet(value:u8):core::Strict<0> = packet(value)==packet(value);
let same_field(value:u8):core::Strict<0> = packet(value).value==value;

data Main { observed:u8; }
machine main(context:&mut Main) crashes Trap {
    let observed:Packet=packet(41u8);
    context.observed=observed.value;
    transition context.observed==41u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
