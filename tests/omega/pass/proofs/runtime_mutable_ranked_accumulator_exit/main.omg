// Expected: accumulate(3, 4, 7) returns 7, so the program exits 70.
use omega_language_std::console;

machine main() reaches Console {
    let floor: u64 = accumulate(3, 4, 7);
    transition floor == 7 {
        true -> good()
        _ -> bad()
    }

    state good() {
        Console::exit_process(70);
    }

    state bad() {
        Console::exit_process(71);
    }
}


machine accumulate(mut remaining: u64, mut accumulator: u64, total: u64) -> u64
requires remaining > 0 && remaining <= 1000 && accumulator <= 1000 && total <= 1000
requires remaining + accumulator == total
terminates by remaining -> Nat::Descending;
ensures result == total
{
    remaining = remaining - 1;
    accumulator = accumulator + 1;
    transition remaining > 0 {
        true -> accumulate(remaining, accumulator, total)
        false -> accumulator
    }
}
