use omega::language::core::float_operations;

// A false Boolean guard is an observed fact, not failure to prove it true.
// The selected branch returns the exact input, including NaNs and both zeros.
machine retain_when_false(flag: bool, value: f64) -> f64
ensures flag || (!flag && Float::meaning64(result) == Float::meaning64(value))
{
    transition flag {
        true -> (0.0)
        _ -> (value)
    }
}

// The same negation in a local must preserve its completed Boolean meaning.
machine retain_when_negated(flag: bool, value: f64) -> f64
ensures flag || Float::meaning64(result) == Float::meaning64(value)
{
    let selected: bool = !flag;
    transition selected {
        true -> (value)
        _ -> (0.0)
    }
}
