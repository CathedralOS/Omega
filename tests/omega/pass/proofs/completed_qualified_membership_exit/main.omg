// Expected exit: 0
data Counter [copy] { value: u64; }
domain Counter::One(value) requires value.value == 1;
machine make() -> Counter in One { Counter { value: 1 } }
machine observe(value: Counter) -> u64
requires value in One
ensures result == 1
{ value.value }
machine exercise() -> u64 {
    let mut value: Counter = make();
    observe(value)
}
machine main() crashes Trap {
    let result: u64 = exercise();
    transition result == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
