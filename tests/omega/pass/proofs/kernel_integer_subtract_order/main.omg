// Expected exit: 0. A computed rank ceiling retains the record's divisor bounds.
machine reset(value: &mut u64) -> u64 { value = 0; 0 }

data Limits where 3 <= divisor, divisor <= 5 {
    limit: u64;
    divisor: u64;
}

machine walk(remaining: u64, limits: Limits, marker: u64)
terminates by remaining -> Nat::Descending in 0..(limits.limit % limits.divisor + 6);
-> u64
requires remaining <= 5
{
    let mut scratch: u64 = 0;
    transition remaining > 0 {
        true -> walk(remaining - 1, limits, reset(&mut scratch))
        false -> remaining
    }
}

data Scratch { marker: u64; }

// Saving an effectful result and projecting its mutable operand must preserve
// the same rank evidence as placing the call directly in an argument.
machine walk_saved(remaining: u64, limits: Limits, marker: u64)
terminates by remaining -> Nat::Descending in 0..(limits.limit % limits.divisor + 6);
-> u64
requires remaining <= 5
{
    let mut scratch: Scratch = Scratch { marker: 9 };
    _ = reset(&mut scratch.marker);
    let next_marker: u64 = reset(&mut scratch.marker);
    transition remaining > 0 {
        true -> walk_saved(remaining - 1, limits, next_marker)
        false -> remaining
    }
}

machine main() crashes Trap {
    let limits: Limits = Limits { limit: 7, divisor: 3 };
    let saved_limits: Limits = Limits { limit: 13, divisor: 5 };
    transition walk(5, limits, 11) == 0 && walk_saved(5, saved_limits, 11) == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
