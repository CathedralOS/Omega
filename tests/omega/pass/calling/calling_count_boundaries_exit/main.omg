// Count predicates describe values, not ABI authority. Exercise their exact
// upper limits through ordinary aggregate returns before observing them.
use omega_language_std::calling;
use omega_language_std::console;

data Main { }

machine signature_at_capacity() -> BoundarySignature {
    let mut signature: BoundarySignature;
    signature.shape_count = 256;
    signature.field_count = 256;
    signature.parameter_count = 32;
    signature.native_parameter_count = 32;
    signature.callback_binder_count = 32;
    signature.callback_demand_count = 32;
    signature
}

machine plan_at_capacity() -> CallPlan {
    let mut plan: CallPlan;
    plan.parameter_count = 32;
    plan.callback_materialization_count = 32;
    plan.parameters[31].location_count = 16;
    plan.result.location_count = 16;
    plan.ordinary_clobbers.register_count = 64;
    plan
}

machine Main::main(main: &mut Main) reaches Console {
    let signature: BoundarySignature = signature_at_capacity();
    let plan: CallPlan = plan_at_capacity();
    let path: [u64; 16];
    let destination: NativePlace = NativePlace::Field {
        parameter: 1, layout: 2, field_path: path, field_path_count: 16,
    };
    transition signature.shape_count == 256 && signature.field_count == 256
        && signature.parameter_count == 32 && signature.native_parameter_count == 32
        && signature.callback_binder_count == 32 && signature.callback_demand_count == 32
        && plan.parameter_count == 32 && plan.callback_materialization_count == 32
        && plan.parameters[31].location_count == 16 && plan.result.location_count == 16
        && plan.ordinary_clobbers.register_count == 64 {
        true -> inspect_destination(main, destination)
        false -> bad(main)
    }
    state inspect_destination(main: &mut Main, destination: NativePlace) {
        transition destination {
            NativePlace::Field { field_path_count, parameter as _, layout as _, field_path as _ } -> inspect_count(main, field_path_count)
            _ -> bad(main)
        }
    }
    state inspect_count(main: &mut Main, count: u64) {
        transition count == 16 { true -> good(main) false -> bad(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
