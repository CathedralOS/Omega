// RUN canary (exit 99). Sibling of value_machine_self_array_local_index_exit for
// the PURE-CONST BINARY index sub-case. A VALUE machine (`self.probe.fill()`)
// returns `self.buf[4 + 1]` -- a machine-owned array read whose index is a binary
// of two INTEGER literals. The frontend index-hoist deliberately leaves both-
// literal indices "for the const fold", but the fixed-index resolver only
// accepted a bare `Integer`, so `buf[4 + 1]` fell through and read offset 0
// (native only; the interpreter evaluates the AST, and a plain machine masked it
// via const-propagation of an adjacent write). Now `fixed_indexed_target_path_in_table`
// const-folds a binary index, so `4 + 1` resolves to a fixed element like `5`.
// This is the shape the former offset-based fs stat decoder used to hit:
// `stat_buf[24 + 0]`. The live filesystem path now projects through a checked
// target-authored `StatLayout`; this canary remains about constant indexing.
// fill(): buf[5]=99, returns buf[4 + 1]=buf[5]=99.
// Expected exit: 99
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Probe { buf: [u8; 16]; }
machine Probe::fill(&mut self) -> i64 {
    self.buf[5] = 99;
    transition true { _ -> go() }
    state go(&mut self) -> i64 { self.buf[4 + 1] as i64 }
}
data Main { console: Console; probe: Probe; out: i64; ncode: i32; }
machine Main::main(&mut self) {
    self.out = self.probe.fill();
    self.ncode = narrow_i64_to_i32_trapping(self.out);
    self.console.exit_process(self.ncode);
}
