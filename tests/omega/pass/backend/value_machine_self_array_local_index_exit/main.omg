// RUN canary (exit 99). A VALUE machine (invoked `self.probe.fill()`) reads
// `self.buf[<local index>]` as its terminal RETURN value in a sub-state. The
// return is a bare trailing expression (an Expression statement), which the
// syntax->symbol-resolved lowering previously did NOT hoist -- so the
// runtime-indexed machine read `self.buf[j]` reached selection raw, fell to the
// place resolver, dropped the index, and read the wrong base (native 0; the
// interpreter masked it at 99). Now the Expression statement hoists its
// operand-indexed reads like the let/assignment/transition-value paths, so the
// index materializes and the read threads the receiver base.
// fill(): buf[5]=99, returns buf[5]=99.
// Expected exit: 99
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Probe { buf: [u8; 16]; }
machine Probe::fill(&mut self) -> i64 {
    self.buf[5] = 99;
    transition true { _ -> go() }
    state go(&mut self) -> i64 { let j: u64 = 4 + 1; self.buf[j] as i64 }
}
data Main { console: Console; probe: Probe; out: i64; ncode: i32; }
machine Main::main(&mut self) {
    self.out = self.probe.fill();
    self.ncode = narrow_i64_to_i32_trapping(self.out);
    self.console.exit_process(self.ncode);
}
