// A 32 MiB machine-local record gives `Main::main` a frame past the 16 MiB
// one shifted-plus-unshifted `add`/`sub` pair reaches on AArch64. The frame
// still commits granule by granule, its saved link register sits above the
// record and is addressed in page steps, and the release returns `sp` in page
// steps. `Big::fill` writes the record's last byte through the loaned
// pointer; exits 70 when that byte reads back.
use omega_language_std::console;

data Big {
    bytes: [u8; 33554432] in Trapping;
    length: u64 in Trapping;
}

data Main {
}

machine Big::fill(big: &mut Big, value: u8 in Trapping) {
    big.bytes[33554431] = value;
    big.length = 33554432;
}

machine Main::main(main: &mut Main) reaches Console
crashes Trap
{
    let mut big: Big;
    Big::fill(&mut big, 70);
    transition { _ -> finish(main, &big) }

    state finish(main: &mut Main, big: &Big) {
        Console::exit_process(big.bytes[33554431] as i32);
    }
}
