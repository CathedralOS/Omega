// Package consumer for the borrowed bump allocation API. Infallible calls
// capture the exact available count, prove capacity, and preserve the decrement
// through two live owned results. Fallible calls keep the strategy in place.
//
// This remains a compile-only integration fixture: its entry acquires no
// backing. The legacy merge and resident declarations below do not establish
// an executable allocator, physical storage or the unfinished reset contract.
use omega::language::core::extent;
use omega::language::core::content;
use alloc::bump;
machine exercise(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let first: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    check_remaining(strategy.remaining, capacity, 16);
    let available: u64 = strategy.remaining;
    let second: Extent in Granted & Vacant = allocate(&mut strategy, 32, available);
    check_remaining(strategy.remaining, available, 32);
    let mut restored: Bump = reset(strategy, first, second);
    let restored_capacity: u64 = restored.remaining;
    let reused: Extent in Granted & Vacant = allocate(&mut restored, capacity, restored_capacity);
    let recomposed: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: reused,
        rest: restored.tail,
    });
    recomposed as Extent
}

// A second allocation epoch uses the real fallible request. `demand` is
// unrelated to the original capacity, so both returned outcomes must work:
// success recomposes its allocation and tail; rejection returns the strategy's
// unchanged tail. No caller-side guard substitutes for the returned custody.
machine exercise_fallible(whole: Extent in Granted & Vacant, capacity: u64, demand: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let first: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    let second: Extent in Granted & Vacant = allocate(&mut strategy, 32, capacity - 16);
    let mut restored: Bump = reset(strategy, first, second);
    let attempt: Attempt = try_allocate(&mut restored, demand);
    transition attempt {
        Attempt::Allocated { allocation } -> reuse(restored, allocation)
        Attempt::Exhausted -> rejected(restored)
    }

    // Allocation already happened inside the request. This arm returns both
    // selected claims to the partition boundary for exact recomposition.
    state reuse(strategy: Bump, allocation: Extent in Granted & Vacant) -> Extent
    {
        let new_tail: Extent in Granted & Vacant = strategy.tail;
        let recomposed: Extent in Granted & Vacant = ExtentPartition::merge(Split {
            taken: allocation,
            rest: new_tail,
        });
        recomposed as Extent
    }

    // The rejected arm returns the recomposed backing untouched — the
    // request never happened, so the caller's custody is unchanged.
    state rejected(strategy: Bump) -> Extent {
        strategy.tail as Extent
    }
}

// Two coexisting allocations, then a partial cleanup: the newest region
// returns through `release` while the oldest stays live, a third
// allocation comes out of the restored tail, and `reset` still waits for
// the remaining pair — a live first allocation has no spelling here
// because `Extent` is linear. The third request's bound follows from the
// residual `release` restored, not a caller-invented floor — the same
// rule `exercise`'s second request follows — and the closing reset
// restores the full original capacity for one unguarded reuse.
machine exercise_release(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let first: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    let second: Extent in Granted & Vacant = allocate(&mut strategy, 32, capacity - 16);
    // The first allocation stays live while the second region returns.
    let mut grown: Bump = release(strategy, second);
    let available: u64 = grown.remaining;
    let third: Extent in Granted & Vacant = allocate(&mut grown, 24, available);
    let mut restored: Bump = reset(grown, first, third);
    let restored_capacity: u64 = restored.remaining;
    let reused: Extent in Granted & Vacant = allocate(&mut restored, capacity, restored_capacity);
    let recomposed: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: reused,
        rest: restored.tail,
    });
    recomposed as Extent
}

// The reservation container over the chain: open a 16-byte buffer, then
// close — the live buffer and the tail recompose into the backing's suffix.
// The record fields retain their existing qualifications while this exercise
// explicitly rebuilds the container before returning its backing.
machine exercise_vec(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let vec: BumpVec = open(whole, 16, capacity);
    let strategy: Bump = vec.strategy;
    let remaining: u64 = strategy.remaining;
    let tail: Extent in Granted & Vacant = strategy.tail;
    let buffer: Extent in Granted & Vacant = vec.buffer;
    let recomposed: Recomposed = close(
        BumpVec {
            strategy: Bump { tail: tail, remaining: remaining },
            buffer: buffer,
            retained_buffer: vec.retained_buffer,
        },
    );
    let backing: Extent in Granted & Vacant = recomposed.backing;
    backing as Extent
}

// Reserve 16 bytes, request 32 more while retaining the old buffer, then
// request another growth and close either returned outcome. The second
// request exercises full-slot rejection without dropping retained custody.
machine exercise_grow(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let vec: BumpVec = open(whole, 16, capacity);
    let strategy: Bump = vec.strategy;
    let remaining: u64 = strategy.remaining;
    let tail: Extent in Granted & Vacant = strategy.tail;
    let buffer: Extent in Granted & Vacant = vec.buffer;
    let growth: Growth = grow(
        BumpVec {
            strategy: Bump { tail: tail, remaining: remaining },
            buffer: buffer,
            retained_buffer: vec.retained_buffer,
        },
        32,
    );
    transition growth {
        Growth::Grown { vec } -> retry(vec)
        Growth::Rejected { vec } -> finish(vec)
    }

    state retry(vec: BumpVec) -> Extent {
        let second: Growth = grow(vec, 1);
        transition second {
            Growth::Grown { vec } -> finish(vec)
            Growth::Rejected { vec } -> finish(vec)
        }
    }

    state finish(vec: BumpVec) -> Extent {
        let recomposed: Recomposed = close(vec);
        recomposed.backing as Extent
    }
}

// Grow past the tail: a demand larger than the whole remaining residual
// exhausts `try_allocate` inside `grow`'s reserve step, so the container
// returns `Growth::Rejected` with the retained slot still empty — a distinct
// arm from `exercise_grow`'s full-slot rejection. The rejection preserves the
// live buffer's custody and the container stays usable: a later request that
// fits the residual still grows, and `close` folds every region back.
machine exercise_grow_exhausted(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let vec: BumpVec = open(whole, 16, capacity);
    let strategy: Bump = vec.strategy;
    let remaining: u64 = strategy.remaining;
    let tail: Extent in Granted & Vacant = strategy.tail;
    let buffer: Extent in Granted & Vacant = vec.buffer;
    let growth: Growth = grow(
        BumpVec {
            strategy: Bump { tail: tail, remaining: remaining },
            buffer: buffer,
            retained_buffer: vec.retained_buffer,
        },
        capacity,
    );
    transition growth {
        Growth::Grown { vec } -> finish(vec)
        Growth::Rejected { vec } -> retry_within(vec)
    }

    // The rejected container kept its live buffer and its empty retained
    // slot; a demand that fits the residual still grows it.
    state retry_within(vec: BumpVec) -> Extent {
        let second: Growth = grow(vec, 8);
        transition second {
            Growth::Grown { vec } -> finish(vec)
            Growth::Rejected { vec } -> finish(vec)
        }
    }

    state finish(vec: BumpVec) -> Extent {
        let recomposed: Recomposed = close(vec);
        recomposed.backing as Extent
    }
}

// Shrink then grow: `shrink` returns the live buffer's freed suffix to the
// tail, `grow` spends part of the restored residual on a new buffer while
// the shrunk one moves to the retained slot, and `close` folds every region
// back. The grown leg proves the restored residual is spendable, not just
// recorded — the same residual law `release` established.
machine exercise_shrink(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let vec: BumpVec = open(whole, 32, capacity);
    let shrunk: BumpVec = shrink(vec, 16);
    let growth: Growth = grow(shrunk, 8);
    transition growth {
        Growth::Grown { vec } -> finish(vec)
        Growth::Rejected { vec } -> finish(vec)
    }

    state finish(vec: BumpVec) -> Extent {
        let recomposed: Recomposed = close(vec);
        recomposed.backing as Extent
    }
}

// The same two-allocation plan spelled directly over the partition boundary,
// kept as the control surface for restating `Split` fields from a boundary
// result.
machine exercise_boundary(whole: Extent in Granted & Vacant) -> Extent
requires 48 <= whole.length
reaches ExtentPartition
{
    let first: VacantExtentParts = split_vacant_extent(whole, 16);
    let first_allocation: Extent in Granted & Vacant = first.taken;
    let after_first: Extent in Granted & Vacant = first.rest;
    let second: VacantExtentParts = split_vacant_extent(after_first, 32);
    let second_allocation: Extent in Granted & Vacant = second.taken;
    let tail: Extent in Granted & Vacant = second.rest;
    let upper_and_tail: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: second_allocation,
        rest: tail,
    });
    let restored: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: first_allocation,
        rest: upper_and_tail,
    });
    restored as Extent
}

// Element type and the placement-policy index it is resident under. The
// index is identity only: no plan is evaluated for it here.
public data Slot [copy] {
    value: u32;
}

public data SlotPlacement {}

// Established custody: the allocation now carries one complete live `Slot`.
// The record, not a bare extent, is what crosses machines (see the header's
// restatement edge).
public data Occupied {
    storage: Extent in Granted & Resident<SlotPlacement, Slot>;
}

// The abstract retirement returns the grant and moved-out value. Only the
// core-authorized vacancy provider may establish absence of live contents;
// the retirement's Granted conservation law alone does not establish Vacant.
public data Retired {
    storage: Extent in Granted;
    value: Slot;
}

// The provider-issuance route for one concrete `(SlotPlacement, Slot)`
// application. `place` and `retire` conserve the extent's content; `read`
// is a borrowed view returning a copy of the resident value.
public boundary trait ResidentStorage {
    machine place(storage: Extent in Granted & Vacant, value: Slot) -> Occupied
    ensures
        Granted::content(old(&storage)) == Granted::content(&result.storage);

    machine read(placed: &Occupied) -> Slot;

    machine retire(placed: Occupied) -> Retired
    ensures
        Granted::content(old(&placed.storage)) == Granted::content(&result.storage);

    // The same view and retirement over the restated qualified extent: the
    // parameter domains are the exact indexed application, so a caller must
    // prove `Resident<SlotPlacement, Slot>` on the argument it passes.
    machine view(storage: &Extent in Granted & Resident<SlotPlacement, Slot>) -> Slot;

    machine retire_view(storage: Extent in Granted & Resident<SlotPlacement, Slot>) -> Retired
    ensures
        Granted::content(old(&storage)) == Granted::content(&result.storage);
}

// One allocation, established, read, retired, and recomposed with the tail.
machine exercise_resident(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    16 <= capacity;
    capacity == whole.length
reaches ExtentPartition, ResidentStorage, VacantContentTransfer
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let vacant: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    let tail: Extent in Granted & Vacant = strategy.tail;
    let placed: Occupied = ResidentStorage::place(vacant, Slot { value: 7 });
    let observed: Slot = ResidentStorage::read(&placed);
    let retired: Retired = ResidentStorage::retire(placed);
    let released: Extent in Granted & Vacant = VacantContentTransfer::transfer(retired.storage);
    let recomposed: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: released,
        rest: tail,
    });
    recomposed as Extent
}

// The restated-local variant: `Occupied.storage` is restated through an
// exactly typed `let` and the qualified extent itself crosses the view and
// retirement calls.
machine exercise_resident_restated(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    16 <= capacity;
    capacity == whole.length
reaches ExtentPartition, ResidentStorage, VacantContentTransfer
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let vacant: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    let tail: Extent in Granted & Vacant = strategy.tail;
    let placed: Occupied = ResidentStorage::place(vacant, Slot { value: 7 });
    let resident: Extent in Granted & Resident<SlotPlacement, Slot> = placed.storage;
    let observed: Slot = ResidentStorage::view(&resident);
    let retired: Retired = ResidentStorage::retire_view(resident);
    let released: Extent in Granted & Vacant = VacantContentTransfer::transfer(retired.storage);
    let recomposed: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: released,
        rest: tail,
    });
    recomposed as Extent
}
machine exercise_retained(whole: Extent in Granted & Vacant, capacity: u64) -> Extent
requires
    16 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let allocation: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    let retired: RetiredSlot = retain_buffer(allocation);
    let restored: Bump = reset_retired(strategy, retired);
    let unchanged: Bump = reset_retired(restored, RetiredSlot::Empty);
    unchanged.tail as Extent
}

data BumpRootProvider {}

machine BumpRootProvider::grant_root(root: Extent) -> Extent
satisfies ExtentRootProvider::grant
{
    root
}

machine main() {}
