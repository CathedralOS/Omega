// Compile canary: the durable depend-edge consumer — this fixture's build
// reaches the bundled alloc package through an authored `builder.depend`
// row instead of a hand-instantiated strategy copy.

machine build(builder: &mut Build) {
    builder.application("bump_allocator_canary");
    builder.depend(Source::Path {
        location: "../../../../../source/library/alloc"
    });
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
}
