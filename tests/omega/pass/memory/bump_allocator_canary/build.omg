// Compile canary: the durable depend-edge consumer — this fixture's build
// reaches the bundled alloc package through an authored `Build::depend`
// row instead of a hand-instantiated strategy copy.

machine build(builder: &mut Build) {
    Build::application(builder, "bump_allocator_canary");
    Build::depend(builder, Source::Path {
        location: "../../../../../source/library/alloc"
    });
    builder.select_provider<ExtentRootProvider, BumpRootProvider>();
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
}
