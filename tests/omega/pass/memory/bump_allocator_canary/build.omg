// Compile canary: the durable depend-edge consumer — this fixture's build
// reaches the bundled alloc package through an authored `Build::depend`
// row instead of a hand-instantiated strategy copy.

machine build(builder: &mut Build) {
    Build::application(builder, "bump_allocator_canary");
    Build::depend(builder, Source::Path {
        location: "../../../../../source/library/alloc"
    });
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, linux_arm64);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, linux_x86_64);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, macos_arm64);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, macos_x86_64);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, windows_x86_64);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, uefi_x86_64);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, cross_platform_cli);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, local_unchecked);
    Build::select_provider<ExtentRootProvider, BumpRootProvider>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
