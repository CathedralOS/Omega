// Expected exit: 0. Returned residents outlive the strategy's exclusive borrow.
use omega::language::core::drop;

data First {}
data Slot [linear] { value: u64; }
machine Slot::drop(slot: &mut Slot) { slot.value = 0; }
domain<P> Slot::Resident<P> established by initialize;
data Storage<P> { resident: Slot in Resident<P>; }

machine initialize<P>(value: u64) -> Slot in Resident<P> {
    Slot { value: value }
}

machine replace<P>(storage: &mut Storage<P>, replacement: Slot in Resident<P>) -> Slot in Resident<P> {
    let previous: Slot in Resident<P> = storage.resident;
    storage.resident = replacement;
    previous
}

machine read<P>(slot: &Slot in Resident<P>) -> u64 { slot.value }

machine main() crashes Trap {
    let mut storage: Storage<First> = Storage { resident: initialize<First>(17) };
    let first: Slot in Resident<First> = replace<First>(&mut storage, initialize<First>(29));
    let second: Slot in Resident<First> = replace<First>(&mut storage, initialize<First>(43));
    let left: u64 = read<First>(&first);
    let right: u64 = read<First>(&second);
    let retained: u64 = read<First>(&storage.resident);
    drop(first);
    drop(second);
    drop(storage);
    transition left == 17 && right == 29 && retained == 43 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
