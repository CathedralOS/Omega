// Console byte homes above a 32 MiB local: the `read_byte` result home and
// the `write_byte` argument home are frame slots past 16 MiB, beyond both the
// byte store's twelve-bit reach and one shifted `add` pair on AArch64. The
// read forms its buffer address in page steps; the write copies its value
// before forming `x1`, since the value may live there. `input.txt` supplies
// "F" (70); the program echoes the record's last byte, also 70, and exits
// with the byte it read.
use omega_language_std::console;

data Big {
    bytes: [u8; 33554432] in Trapping;
    length: u64 in Trapping;
}

data Main {
}

machine Big::fill(big: &mut Big, value: u8 in Trapping) {
    big.bytes[33554431] = value;
    big.length = 33554432;
}

machine Main::main(main: &mut Main) reaches Console
crashes Trap
{
    let mut big: Big;
    Big::fill(&mut big, 70);
    let read: ByteRead = block Console::read_byte();
    Console::write_byte(big.bytes[33554431] as i32);
    transition read {
        ByteRead::Byte { value } -> echoed(main, value)
        _ -> missing(main)
    }

    state echoed(main: &mut Main, value: i32) {
        Console::exit_process(value);
    }

    state missing(main: &mut Main) {
        Console::exit_process(71);
    }
}
