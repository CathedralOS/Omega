machine build(builder: &mut Build) {
    Build::application(builder, "runtime_linear_native_allocation_exit");
    Build::select_provider<NativeHeap, HeapProvider>(builder, linux_arm64);
    Build::select_provider<NativeHeap, HeapProvider>(builder, linux_x86_64);
    Build::select_provider<NativeHeap, HeapProvider>(builder, macos_arm64);
    Build::select_provider<NativeHeap, HeapProvider>(builder, macos_x86_64);
    Build::select_provider<NativeHeap, HeapProvider>(builder, windows_x86_64);
    Build::select_provider<NativeHeap, HeapProvider>(builder, uefi_x86_64);
    Build::select_provider<NativeHeap, HeapProvider>(builder, cross_platform_cli);
    Build::select_provider<NativeHeap, HeapProvider>(builder, local_unchecked);
    Build::select_provider<NativeHeap, HeapProvider>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
