// INTERRUPT-TABLE-CANARY: the authored-roots leg of Cathedral's
// exception-roots-and-timer boundary. `interrupt_table.omg` authors the
// wire layout; this module authors the ROOTS that fill it -- a
// fatal-exception entry declared as a boundary trait the compiler's
// provider selection must resolve to a concrete machine before the
// member can ever reach the installed-root ledger.
//
// The package declares WHAT installs (a boundary trait inheriting the
// core interrupt-entry contract, pinned to an authored calling policy
// whose plan demands a dedicated critical stack, masked preemption, and
// interrupt-return exit); the compiler selects WHO satisfies it (the
// conformance below), validates the policy's returned plan, and retains
// the selected provider's schema, claims, and reach resolution. What
// remains compiler-side is the deriver-owned entry/exit stub and the
// runtime resource columns (stack/fuel/machine-state receipts) that
// admitted-provider custody still supplies in the compiler test.
//
// `CriticalStackPolicy` fixes the divide-error member's stack class (11)
// and `TimerStackPolicy` the timer member's (14): the emitted boundary
// plans are what `admit_interrupt_table_member` joins against the
// declared membership. `InterruptEntry::enter` is deliberately one shared
// requirement identity -- every root trait inheriting it names the same
// requirement, and the retained closure carries each heir's row under its
// own selected provider plan.

use omega::language::core::interrupt;
use omega::language::core::assembly_model;
use omega_language_std::calling;

// The acknowledgement's physical carrier: five aligned u64 cells hold the
// physical-root, execution, invocation, policy, and acknowledgement words
// the boundary hands the machine. The representation conformance makes
// the compiler's materialization of `InterruptAcknowledgement` by value
// exact -- `build.omg` selects it so the closed calling vocabulary can
// compute the boundary signature's shapes.
pub data CriticalAcknowledgementCarrier {
    physical_root: u64;
    execution: u64;
    invocation: u64;
    policy: u64;
    acknowledgement: u64;
}

pub CriticalAcknowledgementRepresentation satisfies OpaqueRepresentation<
    InterruptAcknowledgement,
    CriticalAcknowledgementCarrier
> { }

// The authored calling policy for dedicated critical-stack roots. The
// compiler evaluates `plan` at build time against the materialized
// boundary signature and VALIDATES the returned plan; a buggy plan is a
// compile error, never unsafety. The plan demands: System V AMD64 entry
// shape (the machine arrives with the acknowledgement in the
// compiler-owned stack slot), interrupt-return exit, x86-64 long regime,
// the interrupted state's full snapshot, arrival on dedicated critical
// stack class 11 (the divide-error member's declared class), masked
// preemption, and a transitive machine-state ceiling of general
// registers plus flags -- the footprint the installed root's admitted
// machine-state column must stay inside.
pub data CriticalStackPolicy {
}
pub CriticalStackPolicyCalling satisfies CallingPolicy {
    CallingPolicy::plan = CriticalStackPolicy::plan;
}

machine CriticalStackPolicy::plan(
    signature: BoundarySignature
) -> BoundaryPlanResult
    satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 1 {
        true -> accept(signature, signature.parameters[0])
        _ -> reject()
    }

    state accept(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition root < 256 {
            true -> size(signature, root)
            _ -> reject()
        }
    }

    state size(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition signature.shapes[root].byte_size == 40 {
            true -> alignment(signature, root)
            _ -> reject()
        }
    }

    state alignment(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition signature.shapes[root].alignment == 8 {
            true -> build(signature, root)
            _ -> reject()
        }
    }

    state build(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::SystemVAMD64;
        output.call.parameter_count = 1;
        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[root].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[root].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Stack {
            stack_byte_offset: 0,
            value_byte_offset: 0,
            byte_size: signature.shapes[root].byte_size,
            alignment: 8
        };
        output.call.stack_alignment = 16;
        output.call.entry_control = EntryControl::InterruptReturn;
        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.interrupted_state.general_registers = true;
        output.state.interrupted_state.vector_registers = true;
        output.state.interrupted_state.flags = true;
        output.state.interrupted_state.instruction_pointer = true;
        output.state.interrupted_state.stack_pointer = true;
        output.state.saved_state.general_registers = true;
        output.state.saved_state.flags = true;
        output.state.saved_state.instruction_pointer = true;
        output.state.saved_state.stack_pointer = true;
        output.state.restored_state.general_registers = true;
        output.state.restored_state.flags = true;
        output.state.restored_state.instruction_pointer = true;
        output.state.restored_state.stack_pointer = true;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::Dedicated { class: 11 };
        output.state.preemption = Preemption::Masked;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection {
                reason: "fatal exception roots take exactly one acknowledgement",
            },
        }
    }
}

// The fatal-exception root contract: one requirement inherited from
// `InterruptEntry` (arrive holding a Pending acknowledgement, bound to
// the authored calling policy). The compiler's provider selection
// resolves this trait to the named implementation below; nothing
// consumer-side spells the provider's name again.
pub boundary trait FatalExceptionRoot: InterruptEntry + Calling<CriticalStackPolicyCalling> {
}

// The divide-error provider. Its entry machine realizes
// `InterruptEntry::enter`: it accepts the Pending acknowledgement and
// discharges the linear parameter through `complete` -- an honest
// stand-in until the fatal-halt body arrives with the controller leg.
// The declared `reaches PortIo` is the realization's own bound; the
// compiler-derived installation-reach resolution records it against the
// requirement's `MachineControl + PortIo` upper bound. The named
// implementation owns the complete root map; its one row names the
// inherited requirement's declaring trait and the existing entry machine.
pub data FatalExceptionProvider {
}
pub FatalExceptionProviderRoot satisfies FatalExceptionRoot {
    InterruptEntry::enter = FatalExceptionProvider::enter;
}

machine FatalExceptionProvider::enter(acknowledgement: InterruptAcknowledgement in Pending)
    reaches MachineControl
{
    AcknowledgementCompletion::complete(acknowledgement);
}

// The timer root's calling policy: the same validated envelope as
// `CriticalStackPolicy`, but its arrivals land on dedicated critical
// stack class 14 -- the declared membership joins vector 0x20 to that
// class, and the table profile refuses two members sharing one class.
pub data TimerStackPolicy {
}
pub TimerStackPolicyCalling satisfies CallingPolicy {
    CallingPolicy::plan = TimerStackPolicy::plan;
}

machine TimerStackPolicy::plan(
    signature: BoundarySignature
) -> BoundaryPlanResult
    satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 1 {
        true -> accept(signature, signature.parameters[0])
        _ -> reject()
    }

    state accept(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition root < 256 {
            true -> size(signature, root)
            _ -> reject()
        }
    }

    state size(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition signature.shapes[root].byte_size == 40 {
            true -> alignment(signature, root)
            _ -> reject()
        }
    }

    state alignment(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition signature.shapes[root].alignment == 8 {
            true -> build(signature, root)
            _ -> reject()
        }
    }

    state build(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::SystemVAMD64;
        output.call.parameter_count = 1;
        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[root].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[root].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Stack {
            stack_byte_offset: 0,
            value_byte_offset: 0,
            byte_size: signature.shapes[root].byte_size,
            alignment: 8
        };
        output.call.stack_alignment = 16;
        output.call.entry_control = EntryControl::InterruptReturn;
        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.interrupted_state.general_registers = true;
        output.state.interrupted_state.vector_registers = true;
        output.state.interrupted_state.flags = true;
        output.state.interrupted_state.instruction_pointer = true;
        output.state.interrupted_state.stack_pointer = true;
        output.state.saved_state.general_registers = true;
        output.state.saved_state.flags = true;
        output.state.saved_state.instruction_pointer = true;
        output.state.saved_state.stack_pointer = true;
        output.state.restored_state.general_registers = true;
        output.state.restored_state.flags = true;
        output.state.restored_state.instruction_pointer = true;
        output.state.restored_state.stack_pointer = true;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::Dedicated { class: 14 };
        output.state.preemption = Preemption::Masked;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection {
                reason: "timer roots take exactly one acknowledgement",
            },
        }
    }
}

// The timer root contract: the same inherited `InterruptEntry::enter`
// requirement under its own calling policy. `InterruptEntry::enter` is
// deliberately one shared requirement identity -- the selected closure
// now retains one resolution row per (requirement, plan), so this second
// inheriting trait resolves through its own provider plan.
pub boundary trait TimerRoot: InterruptEntry + Calling<TimerStackPolicyCalling> {
}

// The timer provider. Its tick machine realizes `InterruptEntry::enter`:
// the hard handler only acknowledges -- `complete` discharges the linear
// Pending acknowledgement and wakes ordinary work. The device source and
// tick record are the later device leg's package code; the LAPIC reach
// `complete` settles through stays inside the requirement's declared
// `MachineControl + PortIo` bound.
pub data TimerProvider {
}
pub TimerProviderRoot satisfies TimerRoot {
    InterruptEntry::enter = TimerProvider::enter;
}

machine TimerProvider::enter(acknowledgement: InterruptAcknowledgement in Pending)
    reaches MachineControl
{
    AcknowledgementCompletion::complete(acknowledgement);
}

// The mask-guard provider the entry's `InterruptMaskGuard in Active`
// claim names. `InterruptMaskControl` is a `boundary trait`, so this row
// takes the boundary-trait lane of
// `selected-dispatch/src/compiler_intrinsic.rs`. That lane matches only the
// four bundled hosted rows in `HOSTED_INTRINSIC_ROWS`
// (`Console::exit_process`, `ProcessExit::exit_process`,
// `Console::write_byte`, `Console::read_byte`) and otherwise answers
// `Unsupported`, which is not a check-time error. Arrival masking is
// therefore tolerated, not realized: the compiler lowers nothing for it,
// and no compiler-side interrupt runtime supplies it. Do not read this
// declaration as a precedent that an interrupt-family operation has a
// compiler-known realization. The leaf keeps its exact `via` edge, so it
// is a candidate for the slot on its own; `build.omg` selects the named
// implementation explicitly.
pub data InterruptMaskProvider {
}
pub InterruptMaskProviderMaskControl satisfies InterruptMaskControl {
    InterruptMaskControl::save_and_mask = InterruptMaskProvider::save_and_mask;
}

machine InterruptMaskProvider::save_and_mask() -> InterruptMaskGuard in Active
    satisfies InterruptMaskControl::save_and_mask
    via ForeignBinding::CompilerIntrinsic;

// The selected x2APIC controller completes an interrupt with its EOI MSR.
// The package owns that protocol and proves the actual register event; Core
// retains only the Pending token and consuming completion requirement.
proposition acknowledgement_completed(acknowledgement: InterruptAcknowledgement)
    = model_specific_written(2059, 0);

AcknowledgementCompletion satisfies InterruptAcknowledgementCompletion {
    InterruptAcknowledgementCompletion::complete = complete_acknowledgement;
}

machine complete_acknowledgement(acknowledgement: InterruptAcknowledgement)
satisfies InterruptAcknowledgementCompletion::complete
reaches MachineControl
requires acknowledgement in InterruptAcknowledgement::Pending;
ensures acknowledgement_completed(acknowledgement);
{
    let index: u32 = 2059;
    let value: u64 = 0;
    asm where ensures acknowledgement_completed(acknowledgement) {
        wrmsr index, value
    }
}
