// INTERRUPT-TABLE-CANARY: Cathedral's interrupt descriptor table spelled
// as an ordinary source layout. `cathedral/interrupt_table.omg` carries
// the package's authored shapes -- the semantic gate record, the table
// record, and the build-time layout policies that place them on the
// x86-64 wire encoding. The corpus checks the authored layouts, entry
// policies, selected providers, and acknowledgement completion body. This
// declaration-only root retains the authored types; it neither installs an
// interrupt table nor executes privileged instructions on the corpus host.

use cathedral::interrupt_roots;
use cathedral::interrupt_table;
use cathedral::interrupt_validation;

machine main() {
}

// Keeping the gate, table, membership and verdict types in an ordinary
// parameter/result position is what binds the modules' declarations into
// this program's checked surface; the layout policies and the validator
// itself are invoked by build-time evaluation, not by authored call sites.
machine Main::retain(
    table: InterruptDescriptorTable,
    membership: InterruptTableMembership,
    verdict: TableVerdict
) -> InterruptDescriptorTable {
    table
}
