// INTERRUPT-TABLE-CANARY build root: registers the application and
// selects the acknowledgement's physical representation so the authored
// boundary machines materialize against an exact carrier. The build file
// shares the program namespace — `use` here would re-declare the roots
// module — so the selection names program declarations directly. The
// bundled `omega::language::core` namespace needs no declaration, but
// `std` is an ordinary package: the roots reach its calling vocabulary
// through the requester-local `omega_language_std` alias this dependency
// establishes.

machine build(builder: &mut Build) {
    Build::application(builder, "interrupt_table_canary");
    // Bare-metal interrupt providers use privileged catalog operations.
    // This canary is built and inspected, never executed on the host.
    builder.freestanding = true;
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<
        InterruptAcknowledgementCompletion,
        AcknowledgementCompletion
    >(builder);
    Build::select_provider<
        InterruptMaskControl,
        InterruptMaskProviderMaskControl
    >(builder);
    Build::select_representation<
        InterruptAcknowledgement,
        CriticalAcknowledgementRepresentation
    >(builder);
}
