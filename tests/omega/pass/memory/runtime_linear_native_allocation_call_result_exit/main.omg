// Expected exit: 0. Native allocation returns the release claim itself.
// The address stays inert: this program neither creates a reference nor grants
// an extent from an allocator result. Held means exactly the right to free it.
use omega::language::core::external_binding;

pub data Allocation [linear] { address: addr; }
pub domain Allocation::Held established by NativeHeap::allocate;
pub boundary trait NativeHeap {
    machine allocate(bytes: u64) -> Allocation
    ensures result in Held;
    machine release(allocation: Allocation in Held);
}

HeapProvider satisfies NativeHeap {
    NativeHeap::allocate = allocate;
    NativeHeap::release = release;
}
linux_x86_64 machine allocation_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "malloc", version: "GLIBC_2.2.5",
    } }
}
linux_x86_64 machine release_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "free", version: "GLIBC_2.2.5",
    } }
}
linux_x86_64 machine allocate(bytes: u64) -> Allocation
satisfies NativeHeap::allocate
via allocation_binding();

linux_x86_64 machine release(allocation: Allocation in Held)
satisfies NativeHeap::release via release_binding();

machine acquire(bytes: u64) -> Allocation
reaches NativeHeap
ensures result in Held
{
    NativeHeap::allocate(bytes)
}

machine settle(allocation: Allocation in Held) reaches NativeHeap {
    NativeHeap::release(allocation);
}

data Main {}
machine Main::main(main: &mut Main) reaches NativeHeap crashes Trap {
    let first: Allocation in Held = acquire(131072);
    let second: Allocation in Held = acquire(262144);
    let first_address: addr = first.address;
    let second_address: addr = second.address;
    transition first_address != (0 as addr) && second_address != (0 as addr) && first_address != second_address {
        true -> release(first, second)
        _ -> bad(first, second)
    }
    state release(first: Allocation in Held, second: Allocation in Held) {
        settle(first);
        settle(second);
    }
    state bad(first: Allocation in Held, second: Allocation in Held) {
        settle(first);
        settle(second);
        crash Trap;
    }
}
