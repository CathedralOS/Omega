module translation;

// The Omega-owned translation authority contract. This module is deliberately
// neither the application driver nor the provider package: Omega owns the
// general mapping authority, custody checking, and provider crossings
// (wiki/spec/resources/extents.md "Mapping and reclamation"), while
// `cathedral/` is the stand-in OS package whose checked routes the selected
// realization composes. Keeping the contract here lets the provider import it
// without the driver mediating.
//
// A translation provider installs and tears down mappings over ordinary
// extent custody. Fixed placement consumes the exact source and destination
// extents into one linear `Mapping` carrier that is only `Pending` after
// structural validation -- a pending mapping is not mapped access. The
// provider's activation crossing requalifies that same carrier `Installed`;
// only an installed mapping may be unmapped. `unmap` returns reusable
// `Granted` custody for both ranges plus the owed cross-core shootdown
// token -- TLB debt that must be discharged through `Shootdown::discharge`
// before the teardown is complete. Equal-length ranges are the contract's
// structural precondition, matching the conservation model's check.
//
// The borrowed-source route mirrors the owned one with different custody:
// `map_borrowed` takes a shared loan of the source while still consuming the
// destination, and the `BorrowedMapping` carrier keeps that loan visible so
// the lender's `Granted` source stays suspended -- it cannot be consumed,
// moved, or reclaimed while the mapping lives (matching
// `MappedExtent::loan_mut`'s refusal of mutable access under shared source
// custody in psi/foundation/extents). Releasing an installed borrowed
// mapping ends the loan instead of returning source custody: the lender's
// source qualification resumes, and teardown still owes the same shootdown.
//
// The obligation surface is source-spelled: `TranslationInstallObligations`
// and `TranslationReleaseObligations` are authored contract data, not just
// conservation-model internals. The caller authors the fact identities it
// requires, `map`/`map_borrowed` consume the sets into the carrier, and the
// carrier keeps them readable for its whole life -- the same surface the
// conservation model exposes as `install_obligations()`/
// `release_obligations()` on its grant, pending, installed, and teardown
// carriers. The sets are inert: holding or copying one grants no
// authority, and only the provider's activation and release receipt
// crossings discharge them. One carrier type keeps both sets across
// requalification where the model stages them per carrier; dropping a
// field at `activate` is not a spelling one type admits.
//
// The carrier also exposes the mapping's recorded geometry -- source and
// destination base and length as inert `addr`/`u64` fields minted by the
// `map` crossing, the same provider-visible surface the model's
// `PendingMap` offers as `source_base()`/`destination_base()` reads for
// deriving target translation entries. The values are provider-recorded
// evidence bound by the receipt crossings, not source-proven facts, and
// reading them grants no access: an address is data, not authority.
use omega::language::core::assembly;
use omega::language::core::extent;

// One translation-activation fact an install receipt must establish,
// spelled as authored contract data. The identity is inert: naming a fact
// grants no authority, and nonzero normalization belongs to the provider's
// admission, not to source.
pub data TranslationActivationFact {
    identity: u64;
}

// One target-completion fact a release receipt must establish before the
// torn-down mapping's authority becomes reusable.
pub data TranslationCompletionFact {
    identity: u64;
}

// The exact install obligations a mapping binds, spelled as the authored
// fact identities the provider's activation receipt must cover. This
// contract fixes the set at two facts; a provider package's own contract
// declares the arity its receipts actually require.
pub data TranslationInstallObligations {
    facts: [TranslationActivationFact; 2];
}

// The exact release obligations a mapping binds, spelled as the authored
// fact identities the provider's release receipt must cover.
pub data TranslationReleaseObligations {
    facts: [TranslationCompletionFact; 2];
}

// Provider-owned identity of one pending or installed mapping over the
// exact consumed extents. `boundary data` keeps it unforgeable and the
// carrier opaque: source can move and read it but never spell one into
// being.
pub boundary data MappingToken [linear];

// The mapping carrier: token identity, the consumed source and destination
// ranges, and the authored obligation sets. Not `[linear]` itself because
// the shootdown ledger must be able to hold it across suspended crossings
// (the token inside is still linear), but a moved carrier carries the
// mapping's whole custody and only the provider's receipt crossings
// requalify it.
pub data Mapping {
    token: MappingToken;
    source: Extent in Granted;
    destination: Extent in Granted;
    install: TranslationInstallObligations;
    release: TranslationReleaseObligations;
}

pub domain Mapping::Pending
established by TranslationAuthority::map;

pub domain Mapping::Installed
established by TranslationAuthority::activate;

// Provider-owned identity of one borrowed-source mapping. Kept opaque for
// the same reason as `MappingToken`; the carrier below pairs it with the
// visible loan it holds, so source can never spell this token alone.
pub boundary data BorrowedMappingToken [linear];

// The borrowed-source carrier: an unforgeable provider identity, the
// visible shared loan of the lender's source, the consumed destination
// range, and the same authored obligation surface the owned route
// carries. While this value lives the loan stays active, which is what
// makes the lender's owned source unavailable until teardown releases
// the carrier. Not `[linear]` for the same ledger-visibility reason as
// `Mapping`.
pub data BorrowedMapping {
    token: BorrowedMappingToken;
    held_source: &Extent in Granted;
    destination: Extent in Granted;
    install: TranslationInstallObligations;
    release: TranslationReleaseObligations;
}

pub domain BorrowedMapping::Pending
established by TranslationAuthority::map_borrowed;

pub domain BorrowedMapping::Installed
established by TranslationAuthority::activate_borrowed;

// The linear cross-core invalidation debt a teardown leaves. It cannot be
// dropped; only `discharge` consumes it.
pub boundary data Shootdown [linear];

pub domain Shootdown::Owed;

// Teardown's intermediate custody: the reusable destination, the owned
// source the mapping held, and the still-owed shootdown obligation.
pub data Unmapped {
    destination: Extent in Granted;
    source: Extent in Granted;
    shootdown: Shootdown in Owed;
}

// Borrowed teardown's intermediate custody has no `source` field: the loan
// ends when the carrier is consumed, so the lender -- not the unmap route --
// retains source authority. Only the destination and the shootdown debt
// return through the boundary.
pub data UnmappedBorrowed {
    destination: Extent in Granted;
    shootdown: Shootdown in Owed;
}

// The debt-free shape after `discharge`: both ranges' authority, nothing owed.
pub data Reclaimed {
    destination: Extent in Granted;
    source: Extent in Granted;
}

pub boundary trait TranslationAuthority {
    // Structural validation only: consumes the caller-authored obligation
    // sets into the pending carrier, where a consumer reads the exact fact
    // sets the provider's receipts must establish. The carrier holds both
    // ranges' custody and grants no mapped access.
    machine map(
        source: Extent in Granted,
        destination: Extent in Granted,
        install: TranslationInstallObligations,
        release: TranslationReleaseObligations
    ) -> Mapping
    requires
        source.length == destination.length
    ensures
        result in Mapping::Pending,
        separate(
            Granted::content(&result.source),
            Granted::content(&result.destination),
        )
        == separate(
            Granted::content(old(&source)),
            Granted::content(old(&destination)),
        );

    // The provider receipt crossing: installed translations exist for the
    // exact pending mapping, and the carrier's authored install set is
    // what the receipt behind this edge must establish.
    machine activate(pending: Mapping in Pending) -> Mapping
    ensures
        result in Mapping::Installed,
        separate(
            Granted::content(&result.source),
            Granted::content(&result.destination),
        )
        == separate(
            Granted::content(old(&pending.source)),
            Granted::content(old(&pending.destination)),
        );

    // Stale translations are released by the provider before this returns;
    // the carrier's authored release set is what that receipt must
    // establish, and the cross-core shootdown debt remains the caller's
    // to discharge.
    machine unmap(active: Mapping in Installed) -> Unmapped
    ensures
        separate(
            Granted::content(&result.destination),
            Granted::content(&result.source),
        )
        == separate(
            Granted::content(old(&active.source)),
            Granted::content(old(&active.destination)),
        );

    // Structural validation over a shared source loan: the pending carrier
    // holds the loan, the destination's custody, and the caller-authored
    // obligation sets, and grants no mapped access. The lender's owned
    // source stays borrowed until release.
    machine map_borrowed(
        source: &Extent in Granted,
        destination: Extent in Granted,
        install: TranslationInstallObligations,
        release: TranslationReleaseObligations
    ) -> BorrowedMapping
    requires
        source.length == destination.length
    ensures
        result in BorrowedMapping::Pending,
        Granted::content(&result.destination)
        == Granted::content(old(&destination));

    // The borrowed route's receipt crossing: installed translations exist
    // for the exact pending borrowed mapping.
    machine activate_borrowed(pending: BorrowedMapping in Pending)
        -> BorrowedMapping
    ensures
        result in BorrowedMapping::Installed,
        Granted::content(&result.destination)
        == Granted::content(old(&pending.destination));

    // Releasing an installed borrowed mapping ends the source loan; the
    // shootdown debt remains the caller's to discharge.
    machine unmap_borrowed(active: BorrowedMapping in Installed)
        -> UnmappedBorrowed
    ensures
        Granted::content(&result.destination)
        == Granted::content(old(&active.destination));
}

pub boundary requirement Shootdown::discharge(self)
reaches MachineControl
requires
    self in Shootdown::Owed;
