// The irreducible crossings of Cathedral's translation provider.
//
// Three hardware edges stand between the package's structures and an active
// mapping, and none of them is spellable in checked source yet:
//
// - `store_entry` writes one encoded entry into a table's backing extent.
//   Interpreting stable storage is placed access
//   (wiki/spec/resources/placed_access.md), whose place/take/read operations
//   are still undeclared, so the write is a provider-admitted requirement.
//   The mutable borrow names the exact table whose contents change; backing
//   custody never leaves it.
// - `activate_root` makes the hierarchy's root table the active translation
//   base -- the CR3/TTBR-class register write. It borrows the root: the
//   provider keeps ownership for the hierarchy's whole life.
// - `invalidate_leaf` retires one leaf page's stale local translation. It is
//   the provider-local half of release only: the cross-core completion is the
//   contract's separate `Shootdown` debt, so a driver still discharges that
//   linear obligation after `unmap`.
//
// Every machine reaches `MachineControl`, the hardware-access ceiling the
// interrupt obligations use (source/library/core/interrupt.omg): callers must
// declare the reach, and the provider selection behind the trait is what
// admits the realization.
use omega::language::core::assembly;
use cathedral::tables;

pub boundary trait TranslationHardware {
    // Store `entry` into `table`'s slot `slot`, consuming and returning the
    // table so its `storage` qualification replays through the call: a
    // `&mut` borrow cannot carry the backing extent's `Granted` claim
    // across a boundary crossing, and a boundary contract may only
    // re-certify its `result`. The single consumed input and single
    // qualified output admit the checker's identity-forwarding route, so
    // no conservation equation is spelled here. The ranged slot is the
    // contract's static bound on a 512-entry table -- `level_index` returns
    // the same range, so the walk's result is the only slot spelling a
    // caller needs.
    machine store_entry(
        table: Table,
        slot: u64 [0..=511],
        entry: TableEntry
    ) -> Table
    reaches MachineControl;

    // Make `root` the active translation root for this hierarchy.
    machine activate_root(root: &Table) reaches MachineControl;

    // Invalidate the stale local translation for the leaf page serving
    // `virtual_base`. Provider-local only: cross-core invalidation stays a
    // `Shootdown` obligation of the mapping contract.
    machine invalidate_leaf(virtual_base: addr) reaches MachineControl;
}
