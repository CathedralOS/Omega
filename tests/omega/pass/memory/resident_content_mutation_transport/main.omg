// Checking probe, not runtime evidence. The caller supplies an actual resident.
use omega::language::core::extent;
use omega::language::core::layout;

public data Word { value: u64; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }
    );
    let services: [u64; 32];
    AccessPlan::with_reach(
        access,
        BoundaryReach { services: services, service_count: 0 }
    )
}

data Holder {
    storage: Extent in Granted & Resident<WordPlacement, Word>;
}

data LoanHolder {
    storage: &mut Extent in Granted & Resident<WordPlacement, Word>;
}

machine overwrite(view: &mut Access<WordPlacement, Word>) {
    write(&mut view.value, 29u64);
}

machine borrowed_overwrite(storage: &mut Extent in Granted & Resident<WordPlacement, Word>) {
    overwrite(Access::view_resident_mut<WordPlacement, Word>(storage));
}

machine carried_overwrite(holder: LoanHolder) {
    borrowed_overwrite(holder.storage);
}

machine owned_overwrite(mut storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> Extent in Granted & Resident<WordPlacement, Word>
{
    borrowed_overwrite(&mut storage);
    storage
}

machine holder_overwrite(mut holder: Holder) -> Holder {
    borrowed_overwrite(&mut holder.storage);
    holder
}

machine moved_overwrite(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> Extent in Granted & Resident<WordPlacement, Word>
{
    let mut active: Extent in Granted & Resident<WordPlacement, Word> = storage;
    borrowed_overwrite(&mut active);
    active
}

machine exercise(mut storage: Extent in Granted & Resident<WordPlacement, Word>) -> Holder {
    let mut view: &mut Access<WordPlacement, Word> =
        Access::view_resident_mut<WordPlacement, Word>(&mut storage);
    overwrite(view);
    carried_overwrite(LoanHolder { storage: &mut storage });
    let mut holder: Holder = Holder { storage: moved_overwrite(owned_overwrite(storage)) };
    borrowed_overwrite(&mut holder.storage);
    holder_overwrite(holder)
}
