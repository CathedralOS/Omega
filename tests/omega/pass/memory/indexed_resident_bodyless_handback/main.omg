// Normal exclusive handback restores this exact pre-live applied field domain.
// This forwards existing membership; it does not issue a fresh resident.
data First {}
data Slot { value: u64; }
domain<P> Slot::Resident<P> established by initialize;
data Storage<P> { resident: Slot in Resident<P>; }
machine initialize<P>(value: u64) -> Slot in Resident<P> { Slot { value: value } }
boundary trait Outsider { machine alter(storage: &mut Storage<First>) reaches; }
machine read(slot: &Slot in Resident<First>) -> u64 { slot.value }
machine exercise(storage: &mut Storage<First>) -> u64 reaches Outsider {
    Outsider::alter(storage);
    read(&storage.resident)
}
machine main() {}
