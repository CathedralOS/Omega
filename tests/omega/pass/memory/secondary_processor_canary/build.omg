// SECONDARY-PROCESSOR-CANARY build root: registers the application, binds
// the host program entries, and selects the inert occurrence/vector word
// representations. The envelope keeps its ordinary typed acknowledgement
// reference and exact four-word calling shape. The build file shares the program namespace — `use` here
// would re-declare the roots module — so the bindings name program
// declarations directly. The bundled `omega::language::core` namespace
// needs no declaration, but `std` is an ordinary package: the startup
// contract reaches its calling vocabulary through the requester-local
// `omega_language_std` alias this dependency establishes.

machine build(builder: &mut Build) {
    Build::application(builder, "secondary_processor_canary");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });

    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<
        StartupAcknowledgementProtocol,
        StartupConfirmationProvider
    >(builder);
    Build::select_representation<StartupOccurrence, StartupOccurrenceRepresentation>(builder);
    Build::select_representation<StartupVector, StartupVectorRepresentation>(builder);
}
