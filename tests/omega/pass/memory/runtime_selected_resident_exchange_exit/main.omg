// Expected exit: 0. Either selected backing restores the same exact qualification.
use omega::language::core::drop;
data First {}
data Slot [linear] { value: u64; }
machine Slot::drop(slot: &mut Slot) { slot.value = 0; }
domain<P> Slot::Resident<P> established by initialize;
data Storage<P> { resident: Slot in Resident<P>; }
machine initialize<P>(value: u64) -> Slot in Resident<P> { Slot { value: value } }
machine replace<P>(storage: &mut Storage<P>, replacement: Slot in Resident<P>) -> Slot in Resident<P> {
    let previous: Slot in Resident<P> = storage.resident;
    storage.resident = replacement;
    previous
}
machine read<P>(slot: &Slot in Resident<P>) -> u64 { slot.value }
machine choose<'a, P>(left: &'a mut Storage<P>, right: &'a mut Storage<P>, first: bool) -> &'a mut Storage<P> {
    transition first { true -> left _ -> right }
}
machine exercise(first: bool) crashes Trap {
    let mut left: Storage<First> = Storage { resident: initialize<First>(17) };
    let mut right: Storage<First> = Storage { resident: initialize<First>(29) };
    let previous: Slot in Resident<First> = replace<First>(
        choose<First>(&mut left, &mut right, first), initialize<First>(43));
    let selected: &mut Storage<First> = choose<First>(&mut left, &mut right, first);
    let second: Slot in Resident<First> = replace<First>(selected, initialize<First>(61));
    let observed: u64 = read<First>(&previous);
    let second_value: u64 = read<First>(&second);
    let left_value: u64 = read<First>(&left.resident);
    let right_value: u64 = read<First>(&right.resident);
    drop(previous);
    drop(second);
    drop(left);
    drop(right);
    transition first {
        true -> check(observed == 17 && second_value == 43 && left_value == 61 && right_value == 29)
        _ -> check(observed == 29 && second_value == 43 && left_value == 17 && right_value == 61)
    }
    machine check(correct: bool) { transition correct { true -> done() _ -> wrong() } }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine main() crashes Trap { exercise(true); exercise(false); }
