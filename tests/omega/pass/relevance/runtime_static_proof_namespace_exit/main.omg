// Identical proof operations have identical relevance in every namespace.
data Natural { case Zero; case Succ(previous: Natural); }
data Namespace { unrelated: u64; }

machine identity(value: Natural) -> Natural ensures result == value { value }
machine Namespace::identity(value: Natural) -> Natural ensures result == value { value }
machine Natural::identity(value: Natural) -> Natural ensures result == value { value }

machine main() {
    let free [erased]: Natural = identity(Natural::Zero {});
    let qualified [erased]: Natural = Namespace::identity(Natural::Zero {});
    let mathematical [erased]: Natural = Natural::identity(Natural::Zero {});
    let chained [erased]: Natural = Namespace::identity(free);
}
