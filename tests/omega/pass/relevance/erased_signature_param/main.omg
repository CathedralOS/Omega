// `bound [erased]: i32` — a signature parameter may be erased exactly
// like a data field: it stays in checking and semantic identity but
// contributes no runtime storage or read; the requires clause cites it
// while the body reads `n` alone. The call site discharges the
// instantiated requires from literal arguments.
machine keep(n: i32, bound [erased]: i32) -> i32
    requires n < bound
{
    n
}
data Main { result: i32; }
machine Main::main(main: &mut Main) {
    main.result = keep(70, 100);
    transition main.result == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
