// A closed checked-shape record whose fields are term-expressible is a
// contract term carrier: `witness [erased]: Proof` rides the erased
// proof-term lane — the literal publishes as a Construction with Scalar
// leaves and occupies no runtime signature position.
data Proof {
    tag: i32;
}

machine keep(n: i32, witness [erased]: Proof) -> i32 {
    n
}

data Main { result: i32; }

machine Main::main(main: &mut Main) {
    let result: i32 = keep(70, Proof { tag: 1 });
    transition result == 70 {
        true -> good(main, result)
        _ -> bad(main)
    }
    machine good(main: &mut Main, result: i32) { main.result = result; }
    machine bad(main: &mut Main) { main.result = 0; }
}
