// An erased local may be the subject of a BY-VALUE proof-machine call:
// `P` is recursive data with no layout (proof-only by computed
// classification), so `P::touch(p)` is proof computation — a `&P`
// subject would be a runtime consumption attempt.
data P {
    case Z;
    case S(prev: P);
}
machine P::touch(p: P) {
}
machine main() {
    let p [erased]: P = P::Z {};
    P::touch(p);
}
