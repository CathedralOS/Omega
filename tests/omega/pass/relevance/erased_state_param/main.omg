// An `[erased]` machine parameter flows into an `[erased]` state
// parameter through a named transition: `store(n, bound)` supplies the
// binding's initializer at the erased position, and `store`'s own
// `requires n < bound` re-cites it.
data Main {}
machine Main::record(n: i32, bound [erased]: i32)
    requires n < bound
{
    transition { _ -> store(n, bound) }
    machine store(n: i32, bound [erased]: i32)
        requires n < bound
    {
        let mut total: i32 = n;
    }
}
machine Main::main(main: &mut Main) {
    Main::record(3, 10);
}
