// INTENTIONALLY REJECTED (PROOF-RELEVANCE-MIGRATION): a proof-only type
// (`Nat` has no runtime layout) on an erased parameter of a runtime machine
// has no scalar lane — `shape_admission`'s
// `validate_erased_runtime_scalar_formals` rejects it at check time with
// "erased parameter `witness` is not scalar" until contract terms can carry
// non-scalar erased actuals. The surface is pinned by
// fail/relevance/erased_nonscalar_parameter; this member keeps its pass
// roster slots pending re-homing to fail/ or pending/ once the suite rosters
// are unfenced (its dedicated legs are canary_suite
// layouts_and_pending::erased_proof_only_typed_parameter_*).
use omega_language_std::console;
use omega::language::core::service;
use omega::language::core::nat;

machine keep(n: i32, witness [erased]: Nat) -> i32 {
    n
}

data Main {
    console: Service<Console>;
}

machine Main::main(&mut self) reaches Console {
    let result: i32 = keep(70, Nat::Zero {});
    transition result == 70 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
