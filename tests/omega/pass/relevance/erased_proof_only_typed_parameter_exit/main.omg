// PROOF-RELEVANCE-MIGRATION: a proof-only type (`Nat` has no runtime
// layout) on an erased parameter of a runtime machine rides the erased
// proof-term lane — `witness` publishes as an erased proof formal,
// `Nat::Zero {}` lowers to a `ProofTerm::Construction` actual, and the
// lane is verified at the call site but ignored at runtime. Closed
// checked-shape records/enums whose fields are term-expressible also ride
// this lane (pass/relevance/erased_record_parameter_exit); non-carrier
// shapes still refuse by name (pinned by
// fail/relevance/erased_nonscalar_parameter). The dedicated legs are
// canary_suite layouts_and_pending::erased_proof_only_typed_parameter_*.
use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::nat;

machine keep(n: i32, witness [erased]: Nat) -> i32 {
    n
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let result: i32 = keep(70, Nat::Zero {});
    transition result == 70 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
