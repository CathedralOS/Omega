// An erased proof formal occupies no structural position: `relay` forwards
// its borrowed `values` parameter to `first`, and the argument names
// `values`, not a slot counted past the erased `witness` — a trailing
// erased formal must not disturb it either.
data Proof {
    tag: i32;
}
data Inner {
    a: u8;
    b: u8;
}

machine first(values: &Inner) -> u8 {
    values.a
}

data Main { inner: Inner; result: u8; }

machine Main::relay(witness [erased]: Proof, values: &Inner, trailing [erased]: Proof) -> u8 {
    first(values)
}

machine Main::main(main: &mut Main) {
    main.inner.a = 70;
    main.inner.b = 1;
    main.result = Main::relay(Proof { tag: 1 }, &main.inner, Proof { tag: 2 });
    transition main.result == 70 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() {}
}
