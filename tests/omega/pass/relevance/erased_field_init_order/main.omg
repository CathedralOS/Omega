// A record literal listed out of field order still supplies an `[erased]`
// member from its literal expression — `proof` sits between `after` and
// `before` in the source while occupying no runtime position. The erased
// member's own drop hook never becomes the record's obligation.
data Evidence { tag: i32; }
machine Evidence::drop(evidence: &mut Evidence) {}
data Carrier { before: i32; proof [erased]: Evidence; after: i32; }

machine inspect(carrier: &Carrier) -> bool {
    carrier.before == 17 && carrier.after == 29
}

machine run() -> bool {
    let carrier: Carrier = Carrier {
        after: 29, proof: Evidence { tag: 101 }, before: 17
    };
    inspect(&carrier)
}

data Main { observed: bool; }

machine Main::main(main: &mut Main) {
    let observed: bool = run();
    transition observed {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { main.observed = true; }
    machine bad(main: &mut Main) { main.observed = false; }
}
