// An erased proof formal occupies no structural position. `relay` forwards
// its borrowed `values` parameter to `first` inside a scalar computation;
// the forwarded argument must name `values`, not a slot counted past the
// erased `witness`. The trailing erased formal must not disturb it either.
// Native run: exit 70 = the callee read the forwarded record; 71 = it did not.
use omega_language_std::console;

data Proof {
    tag: i32;
}

data Inner {
    a: u8;
    b: u8;
}

data Main {
    inner: Inner;
    result: u8;
}

machine first(values: &Inner) -> u8 {
    values.a
}

machine Main::main(main: &mut Main) reaches Console {
    main.inner.a = 70;
    main.inner.b = 1;
    main.result = Main::relay(Proof { tag: 1 }, &main.inner, Proof { tag: 2 });
    transition main.result == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

machine Main::relay(witness [erased]: Proof, values: &Inner, trailing [erased]: Proof) -> u8 {
    first(values)
}
