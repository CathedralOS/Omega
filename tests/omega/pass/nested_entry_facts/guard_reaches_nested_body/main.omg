// Every caller of `finish` proves its argument is below 1000.0 before the call,
// so the converted value's product fits i32 without a repeated `requires`.
use omega::language::core::float_operations;

machine convert(value: f64) -> i32 {
    transition value == value && value >= 0.0 && value < 1000.0 {
        true -> finish(value)
        false -> zero()
    }
    machine finish(value: f64) -> i32 {
        let converted: i32 = I32::from_f64(value);
        converted * 1000
    }
    machine zero() -> i32 { 0 }
}

machine main() crashes Trap {
    transition convert(1.5) == 1000 { true -> done() _ -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
