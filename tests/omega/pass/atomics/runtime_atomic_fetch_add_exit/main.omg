// RUN canary (ch17 "Atomics" / concurrency stage 1, M3): AtomicU32 fetch_add.
// `fetch_add(n, NoOrdering)` returns the PRIOR value and adds n to the cell.
// The parser carries the ordering and result place through the arithmetic-shaped
// frontend form. Native lowering emits one LOCK XADD / LDADD* and stores the
// instruction-observed prior -- there is no separate ordinary read.
//
// Guard ladder (exits 70..73):
//   - old1 == 10 (prior value before first fetch_add)           exit 71 on miss
//   - counter == 15 (value after first fetch_add(5))             exit 72 on miss
//   - old2 == 15 (prior value before second fetch_add)          exit 73 on miss
//   - counter == 23 (value after second fetch_add(8))            exit 74 on miss
//   - exit 70 = all four assertions pass

use omega_language_std::console;

data Main {
    counter: AtomicU32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.counter.store(10, NoOrdering);

    let old1: u32 in Wrapping = main.counter.fetch_add(5, NoOrdering);

    transition old1 == 10 {
        true -> check_after_first(main)
        false -> bad_old1(main)
    }
    state check_after_first(main: &mut Main) {
        transition main.counter == 15 {
            true -> do_second_add(main)
            false -> bad_after_first(main)
        }
    }
    state do_second_add(main: &mut Main) {
        let old2: u32 in Wrapping = main.counter.fetch_add(8, NoOrdering);
        transition old2 == 15 {
            true -> check_after_second(main)
            false -> bad_old2(main)
        }
    }
    state check_after_second(main: &mut Main) {
        transition main.counter == 23 {
            true -> good(main)
            false -> bad_after_second(main)
        }
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad_old1(main: &mut Main) {
        Console::exit_process(71);
    }
    state bad_after_first(main: &mut Main) {
        Console::exit_process(72);
    }
    state bad_old2(main: &mut Main) {
        Console::exit_process(73);
    }
    state bad_after_second(main: &mut Main) {
        Console::exit_process(74);
    }
}
