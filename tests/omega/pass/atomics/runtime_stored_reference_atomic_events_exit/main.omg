// Distinct descriptor fields can lend the same atomic cell. Local storage,
// borrowed backing and instruction-observed priors retain separate identities.
data Cell { counter: AtomicU64; }
data Packet { first: &Cell; second: &Cell; counter: AtomicU64; }

machine observe(cell: &Cell) -> u64 in Wrapping {
    let value: u64 in Wrapping = cell.counter.load(NoOrdering);
    transition { _ -> (value) }
}

machine main() crashes Trap {
    let cell: Cell = Cell { counter: 3 };
    let other: Cell = Cell { counter: 91 };
    let packet: Packet = Packet { first: &cell, second: &cell, counter: 7 };
    packet.first.counter.store(23, NoOrdering);
    let captured: u64 in Wrapping = packet.first.counter.load(NoOrdering);
    let first: u64 in Wrapping = packet.first.counter.fetch_add(5, NoOrdering);
    packet.counter.store(11, NoOrdering);
    let second: u64 in Wrapping = packet.second.counter.fetch_add(7, NoOrdering);
    let resident: u64 in Wrapping = packet.first.counter.load(NoOrdering);
    let reference: &Cell = packet.second;
    let through_reference: u64 in Wrapping = reference.counter.load(NoOrdering);
    let local: u64 in Wrapping = packet.counter.load(NoOrdering);
    let original: u64 in Wrapping = observe(&cell);
    let untouched: u64 in Wrapping = observe(&other);
    transition captured == 23 && first == 23 && second == 28 && resident == 35
        && through_reference == 35 && local == 11 && original == 35 && untouched == 91 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
