// The sealed atomic operation checks only its authored operands. Calls and
// arithmetic in those operands still execute and retain ordinary checking.
data Counter { value: AtomicU32; }

machine identity(value: u32) -> u32 { value }

machine exchange(counter: &Counter, expected: u32, proposed: u32) -> u32 in Wrapping {
    let prior: u32 in Wrapping = counter.value.compare_exchange(
        identity(expected), identity(proposed), ReceivePublish, Receive);
    prior
}

machine main() crashes Trap {
    let counter: Counter = Counter { value: 0 };
    counter.value.store(10, NoOrdering);
    let prior: u32 in Wrapping = exchange(&counter, 10, 99);
    transition prior == 10 {
        true -> mismatch(&counter)
        false -> wrong()
    }
    state mismatch(counter: &Counter) {
        let expected: u32 = 10;
        let proposed: u32 = 40;
        let prior: u32 in Wrapping = counter.value.compare_exchange(
            identity(expected), proposed + 2, GlobalOrder, Receive);
        let observed: u32 = counter.value.load(Receive);
        transition prior == 99 && observed == 99 {
            true -> done()
            false -> wrong()
        }
    }
    state done() {}
    state wrong() { crash Trap; }
}
