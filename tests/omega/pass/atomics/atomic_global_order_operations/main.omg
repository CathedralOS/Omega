// PASS canary (checked only): the complete proof-static ordering surface of
// the normalized atomic operations is admitted. Every operation kind carries
// its ordering as checked source data — GlobalOrder on load, store, fetch,
// swap, and compare-exchange success; ReceivePublish on a read-modify-write;
// and a read-only Receive failure ordering beneath GlobalOrder success.
//
// This fixture deliberately does not enter native lowering: the normalized
// atomic abstract event retains this ordering evidence as checkable
// operation data, and the canary pins checked-level admission of exactly the
// surface that evidence must cover.

data Main {
    counter: AtomicU32;
}

machine Main::main(&mut self) -> u32 {
    self.counter.store(10, GlobalOrder);
    let observed: u32 in Wrapping = self.counter.load(GlobalOrder);
    let prior: u32 in Wrapping = self.counter.fetch_add(5, ReceivePublish);
    let displaced: u32 in Wrapping = self.counter.swap(20, GlobalOrder);
    let cas_prior: u32 in Wrapping = self.counter.compare_exchange(20, 30, GlobalOrder, Receive);
    transition { _ -> (observed + prior + displaced + cas_prior) }
}
