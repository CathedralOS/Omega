use omega_language_std::console;

data Choice { case Cell(counter: AtomicU32, n: u64 in Wrapping); case Empty; }
data Main { }

machine inspect(choice: &Choice) -> u64 in Wrapping {
    transition choice {
        Choice::Cell { counter as _, n } -> (n)
        Choice::Empty -> (0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let full: Choice = Choice::Cell { counter: 3, n: 70 };
    let empty: Choice = Choice::Empty;
    let present: u64 in Wrapping = inspect(&full);
    let absent: u64 in Wrapping = inspect(&empty);
    transition present == 70 && absent == 0 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
