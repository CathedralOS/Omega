// Atomic store and fetch_or mutate an AtomicU32 through a shared Cell borrow,
// without granting ordinary writes to the enclosing record. The negative
// control is fail/atomics/shared_receiver_plain_field_write.
// publish(10), then mark(5), must observe prior 10 and leave 15: exit 70.

use omega_language_std::console;

data Cell {
    value: AtomicU32;
}

machine Cell::publish(cell: &Cell, value: u32) {
    cell.value.store(value, Publish);
}

machine Cell::mark(cell: &Cell, bits: u32) -> u32 {
    let prior: u32 = cell.value.fetch_or(bits, ReceivePublish);
    transition { _ -> (prior) }
}

data Main {
    cell: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    Cell::publish(&main.cell, 10);
    let prior: u32 = Cell::mark(&main.cell, 5);
    transition prior == 10 {
        true -> check_value(main)
        false -> bad_prior(main)
    }

    machine check_value(main: &mut Main) {
        transition main.cell.value == 15 {
            true -> good(main)
            false -> bad_value(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad_prior(main: &mut Main) {
        Console::exit_process(71);
    }

    machine bad_value(main: &mut Main) {
        Console::exit_process(72);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
