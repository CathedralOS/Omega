// PASS + RUN canary: atomic operations take a shared receiver
// (wiki/spec/language/concurrency.md, "All receivers are shared"). A store and
// a fetch_or on an AtomicU32 field reached through `&self` are admitted; the
// enclosing record is never written through the shared borrow, the cell is.
// An ordinary write through `&self` stays rejected
// (fail/atomics/shared_receiver_plain_field_write).
//
// Main observes the cell afterwards: publish(10) then mark(5) returns the
// instruction-observed prior 10 and leaves 15 in the cell -> exit 70.
// 71 = wrong fetch_or prior, 72 = wrong stored value.

use omega_language_std::console;
use omega::language::core::binding;

data Cell {
    value: AtomicU32;
}

machine Cell::publish(cell: &Cell, value: u32) {
    cell.value.store(value, Publish);
}

machine Cell::mark(cell: &Cell, bits: u32) -> u32 {
    let prior: u32 = cell.value.fetch_or(bits, ReceivePublish);
    transition { _ -> (prior) }
}

data Main {
    console: Binding<Console>;
    cell: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    Cell::publish(&main.cell, 10);
    let prior: u32 = Cell::mark(&main.cell, 5);
    transition prior == 10 {
        true -> check_value(main)
        false -> bad_prior(main)
    }

    state check_value(main: &mut Main) {
        transition main.cell.value == 15 {
            true -> good(main)
            false -> bad_value(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad_prior(main: &mut Main) {
        main.console.exit_process(71);
    }

    state bad_value(main: &mut Main) {
        main.console.exit_process(72);
    }
}
