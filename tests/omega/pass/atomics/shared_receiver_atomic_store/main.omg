// PASS + RUN canary: atomic operations take a shared receiver
// (wiki/spec/language/concurrency.md, "All receivers are shared"). A store and
// a fetch_or on an AtomicU32 field reached through `&self` are admitted; the
// enclosing record is never written through the shared borrow, the cell is.
// An ordinary write through `&self` stays rejected
// (fail/atomics/shared_receiver_plain_field_write).
//
// Main observes the cell afterwards: publish(10) then mark(5) returns the
// instruction-observed prior 10 and leaves 15 in the cell -> exit 70.
// 71 = wrong fetch_or prior, 72 = wrong stored value.

use omega_language_std::console;
use omega::language::core::service;

data Cell {
    value: AtomicU32;
}

machine Cell::publish(&self, value: u32) {
    self.value.store(value, Publish);
}

machine Cell::mark(&self, bits: u32) -> u32 {
    let prior: u32 = self.value.fetch_or(bits, ReceivePublish);
    transition { _ -> (prior) }
}

data Main {
    console: Binding<Console>;
    cell: Cell;
}

machine Main::main(&mut self) reaches Console {
    self.cell.publish(10);
    let prior: u32 = self.cell.mark(5);
    transition prior == 10 {
        true -> check_value()
        false -> bad_prior()
    }

    state check_value(&mut self) {
        transition self.cell.value == 15 {
            true -> good()
            false -> bad_value()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad_prior(&mut self) {
        self.console.exit_process(71);
    }

    state bad_value(&mut self) {
        self.console.exit_process(72);
    }
}
