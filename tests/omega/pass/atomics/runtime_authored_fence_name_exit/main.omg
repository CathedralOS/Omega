// An authored body with the sealed primitive's spelling remains an ordinary call.
data Atomic {}
data FenceOrdering [copy] { case Receive; case Publish; case ReceivePublish; }
data Trace { calls: u32 in Wrapping; }
machine Atomic::fence(trace: &mut Trace, ordering: FenceOrdering) {
    trace.calls = trace.calls + 1;
}
machine main() crashes Trap {
    let trace: Trace = Trace { calls: 0 };
    Atomic::fence(&mut trace, FenceOrdering::Publish);
    transition trace.calls == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
