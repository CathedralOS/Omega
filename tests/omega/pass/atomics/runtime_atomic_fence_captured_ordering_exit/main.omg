use omega::language::core::atomic;
data Trace { calls: u32 in Wrapping; }
data Options { ordering: FenceOrdering; }
machine choose(trace: &mut Trace) -> FenceOrdering
ensures result in FenceOrdering::Publish {
    trace.calls = trace.calls + 1;
    FenceOrdering::Publish
}
machine receive(ordering: FenceOrdering)
requires ordering in FenceOrdering::Receive {
    Atomic::fence(ordering);
}
machine main() crashes Trap {
    let trace: Trace = Trace { calls: 0 };
    Atomic::fence(choose(&mut trace));
    let ordering: FenceOrdering = FenceOrdering::Receive;
    receive(ordering);
    let options: Options = Options { ordering: FenceOrdering::ReceivePublish };
    Atomic::fence(options.ordering);
    transition trace.calls == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
