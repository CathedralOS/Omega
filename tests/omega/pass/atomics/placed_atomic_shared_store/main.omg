use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::AtomicOperations;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::Access;
public data Word { value: u32; }
public data WordPlacement {}
machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
            FieldAccess::Atomic { operations: AtomicOperations {
                load: true, store: true, fetch_add: false, fetch_sub: false,
                fetch_xor: false, fetch_or: false, fetch_and: false, swap: false,
                compare_exchange: false, compare_exchange_once: false,
                try_exchange: false, try_exchange_once: false
            }, exposure: Exposure::Exported }),
        BoundaryReach { services: services, service_count: 0 }
    )
}
machine probe(view: &Access<WordPlacement, Word>) -> u32 {
    view.value.store(41, Publish);
    let observed: u32 = view.value.load(Receive);
    observed
}
