// A selected payload is a namespace, not a materialized scalar. The nested
// field path must keep the caller's original atomic backing through a loan.
data Counter { value: AtomicU32; }
data Choice { case Live(counter: Counter); case Empty; }

machine make() -> Choice ensures result in Choice::Live {
    Choice::Live { counter: Counter { value: 11 } }
}

machine increment(choice: &Choice) -> u32 in Wrapping
requires choice in Choice::Live
{
    let prior: u32 in Wrapping = choice.counter.value.fetch_add(9, NoOrdering);
    transition { _ -> (prior) }
}

machine observe(choice: &Choice) -> u32 in Wrapping
requires choice in Choice::Live
{
    let resident_atomic_observed: u32 = choice.counter.value.load(NoOrdering);
    let resident: u32 in Wrapping = resident_atomic_observed as u32 in Wrapping;
    transition { _ -> (resident) }
}

machine main() crashes Trap {
    let choice: Choice = make();
    let prior: u32 in Wrapping = increment(&choice);
    let resident: u32 in Wrapping = observe(&choice);
    transition prior == 11 && resident == 20 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
