// OR, AND and XOR must each return the committed prior at both admitted
// source widths. Separate guard states retain every prior/resident assertion
// without requiring the independent combined-Boolean custody lane.
// ISA byte mutation and native contention probes also cover 8/16-bit forms,
// which do not yet have AtomicU8/AtomicU16 source types. Exit 70 proves all
// six priors and both final residents, including bits above the 32-bit lane.
use omega_language_std::console;

data Main {
    cell32: AtomicU32;
    cell64: AtomicU64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.cell32.store(2147483658, GlobalOrder);
    let prior: u32 = main.cell32.fetch_or(5, ReceivePublish);
    transition prior == 2147483658 {
        true -> and32(main)
        false -> bad(main)
    }
    machine and32(main: &mut Main) {
        let prior: u32 = main.cell32.fetch_and(4294967287, ReceivePublish);
        transition prior == 2147483663 {
            true -> xor32(main)
            false -> bad(main)
        }
    }
    machine xor32(main: &mut Main) {
        let prior: u32 = main.cell32.fetch_xor(3, ReceivePublish);
        transition prior == 2147483655 {
            true -> check32(main)
            false -> bad(main)
        }
    }
    machine check32(main: &mut Main) {
        transition main.cell32 == 2147483652 {
            true -> or64(main)
            false -> bad(main)
        }
    }
    machine or64(main: &mut Main) {
        main.cell64.store(4611686018427387914, GlobalOrder);
        let prior: u64 = main.cell64.fetch_or(5, ReceivePublish);
        transition prior == 4611686018427387914 {
            true -> and64(main)
            false -> bad(main)
        }
    }
    machine and64(main: &mut Main) {
        let prior: u64 = main.cell64.fetch_and(9223372036854775799, ReceivePublish);
        transition prior == 4611686018427387919 {
            true -> xor64(main)
            false -> bad(main)
        }
    }
    machine xor64(main: &mut Main) {
        let prior: u64 = main.cell64.fetch_xor(3, ReceivePublish);
        transition prior == 4611686018427387911 {
            true -> check64(main)
            false -> bad(main)
        }
    }
    machine check64(main: &mut Main) {
        transition main.cell64 == 4611686018427387908 {
            true -> good(main)
            false -> bad(main)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
