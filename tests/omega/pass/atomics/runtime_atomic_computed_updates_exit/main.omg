// Store, swap and fetch use the same ordered operand computation route as CAS.
data Counter { value: AtomicU32; }
data Trace { code: u32 in Wrapping; }

machine record(trace: &mut Trace, digit: u32 in Wrapping, value: u32) -> u32 {
    trace.code = trace.code * 10 + digit;
    value
}

machine main() crashes Trap {
    let counter: Counter = Counter { value: 0 };
    let mut trace: Trace = Trace { code: 0 };
    counter.value.store(record(&mut trace, 1, 10), NoOrdering);
    let swapped: u32 in Wrapping = counter.value.swap(record(&mut trace, 2, 20), ReceivePublish);
    let fetched: u32 in Wrapping = counter.value.fetch_add(record(&mut trace, 3, 5), NoOrdering);
    let observed: u32 = counter.value.load(NoOrdering);
    transition swapped == 10 && fetched == 20 && observed == 25 && trace.code == 123 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
