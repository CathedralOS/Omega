// Case selection lends the original atomic payload cell. Three independent
// calls must observe 3, 8 and 16, not the discriminator's copied payload bits.
data Choice { case Cell(counter: AtomicU32); case Empty; }

machine make() -> Choice ensures result in Choice::Cell { Choice::Cell { counter: 3 } }
machine increment(choice: &Choice, amount: u32) -> u32 in Wrapping
requires choice in Choice::Cell
{
    let prior: u32 in Wrapping = choice.counter.fetch_add(amount, NoOrdering);
    transition { _ -> (prior) }
}
machine observe(choice: &Choice) -> u32 in Wrapping
requires choice in Choice::Cell
{
    let resident_atomic_observed: u32 = choice.counter.load(NoOrdering);
    let resident: u32 in Wrapping = resident_atomic_observed as u32 in Wrapping;
    transition { _ -> (resident) }
}
machine selected_value(choice: &Choice) -> bool
requires choice in Choice::Cell
{
    let resident_atomic_observed: u32 = choice.counter.load(NoOrdering);
    let resident: u32 in Wrapping = resident_atomic_observed as u32 in Wrapping;
    transition { _ -> (resident == 16) }
}

machine main() crashes Trap {
    let choice: Choice = make();
    let first: u32 in Wrapping = increment(&choice, 5);
    let second: u32 in Wrapping = increment(&choice, 8);
    let resident: u32 in Wrapping = observe(&choice);
    let selected: bool = selected_value(&choice);
    transition first == 3 && second == 8 && resident == 16 && selected {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
