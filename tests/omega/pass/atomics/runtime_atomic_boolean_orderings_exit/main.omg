// Expected exit: 0.
// A shared atomic Boolean store preserves its exact cell and ordering, and its load observes the stored Boolean.
use omega::language::core::atomic;
data Cells { selected: AtomicBool; sibling: AtomicBool; }
machine exercise(cells: &Cells) -> bool {
    cells.sibling.store(true, NoOrdering);
    cells.selected.store(true, GlobalOrder);
    let first: bool = cells.selected.load(GlobalOrder);
    cells.selected.store(false, Publish);
    Atomic::fence(FenceOrdering::ReceivePublish);
    let second: bool = cells.selected.load(Receive);
    cells.selected.store(true, NoOrdering);
    Atomic::fence(FenceOrdering::Receive);
    let third: bool = cells.selected.load(NoOrdering);
    let sibling: bool = cells.sibling.load(Receive);
    first && !second && third && sibling
}
machine main() crashes Trap {
    let cells: Cells;
    transition exercise(&cells) { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
