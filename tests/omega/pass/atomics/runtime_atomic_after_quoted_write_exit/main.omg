// RUN canary: atomic coherence after a quoted console write. The write lends
// the literal's immutable image bytes; that loan cannot reach the counter, so
// the first store still reads from the activation's initial residency and the
// fetch_add observes that store. Exit 70 when the prior and the result agree;
// 71 and 72 name which one did not.

use omega_language_std::console;

data Main {
    counter: AtomicU32;
}

machine Main::main(main: &mut Main) reaches Console {
    Console::write_line("atomic store after a quoted write");
    main.counter.store(10, NoOrdering);
    let old: u32 in Wrapping = main.counter.fetch_add(5, NoOrdering);
    transition old == 10 {
        true -> check_sum(main)
        false -> bad_prior(main)
    }
    state check_sum(main: &mut Main) {
        transition main.counter == 15 {
            true -> good(main)
            false -> bad_sum(main)
        }
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad_prior(main: &mut Main) {
        Console::exit_process(71);
    }
    state bad_sum(main: &mut Main) {
        Console::exit_process(72);
    }
}
