// Owned return and shared lending retain the case's original atomic member.
// Independent shared helpers must observe 3, then 8, and finally 16 in that
// same cell. The common member sits after the case tag, not at record offset 0.
data Counter { value: AtomicU32; case Live(seed: u32); case Empty; }

machine make() -> Counter { Counter::Live { value: 3, seed: 7 } }
machine increment(counter: &Counter, amount: u32) -> u32 in Wrapping {
    let prior: u32 in Wrapping = counter.value.fetch_add(amount, NoOrdering);
    transition { _ -> (prior) }
}
machine observe(counter: &Counter) -> u32 in Wrapping {
    let value: u32 in Wrapping = counter.value.load(NoOrdering);
    transition { _ -> (value) }
}
machine selected(counter: &Counter) -> bool {
    transition counter {
        Counter::Live { value as _, seed } -> (seed == 7)
        _ -> (false)
    }
}

machine main() crashes Trap {
    let counter: Counter = make();
    let first: u32 in Wrapping = increment(&counter, 5);
    let second: u32 in Wrapping = increment(&counter, 8);
    let resident: u32 in Wrapping = observe(&counter);
    let live: bool = selected(&counter);
    transition first == 3 && second == 8 && resident == 16 && live {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
