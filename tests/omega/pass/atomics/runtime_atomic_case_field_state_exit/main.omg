// Expected exit: 0. Shared payload writes preserve the nested case through
// a result projection, a helper parameter and a state arrival.
data Choice { case Cell(counter: AtomicU32); case Empty; }
data Envelope { item: Choice; }
machine make() -> Envelope ensures result.item in Choice::Cell {
    Envelope { item: Choice::Cell { counter: 3 } }
}
machine increment(choice: &Choice) -> u32 in Wrapping
requires choice in Choice::Cell {
    let prior: u32 in Wrapping = choice.counter.fetch_add(5, NoOrdering);
    transition { _ -> (prior) }
}
machine exercise(choice: &Choice) -> u32 in Wrapping
requires choice in Choice::Cell {
    let first: u32 in Wrapping = increment(choice);
    let second: u32 in Wrapping = increment(choice);
    transition { _ -> finish(choice) }
    machine finish(choice: &Choice) -> u32 in Wrapping
    requires choice in Choice::Cell {
        let third: u32 in Wrapping = increment(choice);
        let resident_atomic_observed: u32 = choice.counter.load(NoOrdering);
        let resident: u32 in Wrapping = resident_atomic_observed as u32 in Wrapping;
        transition { _ -> (resident) }
    }
}
machine main() crashes Trap {
    let envelope: Envelope = make();
    let resident: u32 in Wrapping = exercise(&envelope.item);
    transition resident == 18 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
