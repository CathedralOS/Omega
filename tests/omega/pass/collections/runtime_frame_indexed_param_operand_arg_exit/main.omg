// The param-array runtime-indexed read as a BINARY OPERAND (`vals[k] + 100`,
// hoist funnel) AND as a transition ARGUMENT (`self.report(vals[k])`), with
// ELEMENT RANGES on the param type (`[i32 in I320To30; 3]`) discharging the
// exact-arithmetic obligation. vals=[10,20,30], k=2 -> 130 -> report(30) -> 1.
use omega_language_std::console;
use omega::language::core::binding;
domain i32::I320To30 requires 0 <= self && self <= 30;
domain u64::U640To2 requires self <= 2;
data Main {
    console: Binding<Console>;
    vals: [i32; 3];
}
machine Main::main(&mut self) {
    self.vals[0] = 10;
    self.vals[1] = 20;
    self.vals[2] = 30;
    transition { _ -> self.pick(self.vals, 2) }
}
machine Main::pick(&mut self, vals: [i32 in I320To30; 3], k: u64 in U640To2) reaches Console {
    let v: i32 = vals[k] + 100;
    transition v == 130 {
        true -> self.report(vals[k])
        false -> no()
    }
    state no(&mut self) { self.console.exit_process(2); }
}
machine Main::report(&mut self, got: i32) reaches Console {
    transition got == 30 {
        true -> yes()
        false -> half()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state half(&mut self) { self.console.exit_process(3); }
}
