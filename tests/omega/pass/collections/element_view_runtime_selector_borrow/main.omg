use omega_language_std::console;
use omega::language::core::binding;

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
    at: u64;
}

data Main {
    console: Binding<Console>;
    bag: Bag;
}

machine Main::main(&mut self) reaches Console {
    self.bag.at = 2;
    self.fill(&mut self.bag);
    transition self.bag.cells[2].value == 7 && self.bag.cells[2].tag == 9 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(181);
    }

    state bad(&mut self) {
        self.console.exit_process(90);
    }
}

machine Main::fill(&mut self, bag: &mut Bag) requires bag.at < 4 {
    let cells: &mut [Cell] = bag.cells.as_mut_slice();
    let cell: &mut Cell = &mut cells[bag.at];
    cell.value = 7;
    let at: u64 = bag.at;
    let picked: &mut Cell = &mut cells[at];
    picked.tag = 9;
    transition {
        _ -> done()
    }

    state done() {
    }
}
