use omega::language::core::float_operations;
data Context { values: [f64; 3]; flags: [u16; 2]; }
machine generic_extent<T>(values: &[T]) -> u64 ensures result == values.len { values.len }
machine generic_read(values: &[u16]) -> u16 {
    let count: u64 = generic_extent(values);
    transition count > 0 { true -> (values[0]) false -> 0 }
}
machine extent(values: &[f64]) -> u64 ensures result == values.len { values.len }
machine reversed(unused: &[f64], values: &[f64]) -> u64
ensures values.len == result && result >= 0 { values.len }
machine value(values: &[f64], index: u32) -> f64 {
    let count: u64 = extent(values);
    let copied: u64 = count;
    transition index < copied { true -> (values[index]) false -> 99.0 }
}
machine assigned(values: &[f64]) -> f64 {
    let mut count: u64 = 0;
    count = extent(values);
    transition count > 0 { true -> (values[0]) false -> 99.0 }
}
machine direct(values: &[f64]) -> f64 {
    transition extent(values) > 0 { true -> (values[0]) false -> 99.0 }
}
machine ordinal(left: &[f64], right: &[f64]) -> f64 {
    let count: u64 = reversed(left, right);
    transition count > 0 { true -> (right[0]) false -> 99.0 }
}
machine written(values: &mut [f64]) -> f64 {
    let count: u64 = extent(values);
    transition count > 0 { true -> write(values, count) false -> 99.0 }
    state write(values: &mut [f64], count: u64) {
        values[0] = 8.5;
        transition count > 0 { true -> (values[0]) false -> 99.0 }
    }
}
machine main(context: &mut Context) crashes Trap {
    context.values = [2.25, 3.5, 7.0];
    context.flags = [11, 12];
    let g: u16 = generic_read(&context.flags[..]);
    let a: f64 = value(&context.values[..], 1);
    let b: f64 = value(&context.values[0..0], 0);
    let c: f64 = assigned(&context.values[..]);
    let d: f64 = direct(&context.values[..]);
    let e: f64 = ordinal(&context.values[0..0], &context.values[..]);
    let f: f64 = written(&mut context.values[..]);
    transition a == 3.5 && b == 99.0 && c == 2.25 && d == 2.25 && e == 2.25 && f == 8.5 && g == 11 {
        true -> {}
        false -> bad()
    }
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
