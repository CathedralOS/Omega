// GUARD-BOUNDED computed index as a binary operand: `acc + arr[k + 1]`
// under `transition k + 1 >= 0 && k + 1 < 5`. Was the computed-index FAIL
// canary; the index auto-hoist (2026-07-07) rewrites `arr[k + 1]` to index a
// slotted `__hoist` temp, and the index prover consults guard facts under the
// temp's INITIALIZER label ("self.k + 1") -- sound because the synthesized
// `let` is adjacent to its use. k = arr[0] = 1, so acc = arr[2] = 30 = exit.
use omega_language_std::console;

data Main {
    console: Console;
    arr: [i32; 5] in Trapping;
    k: i32 in Trapping;
    acc: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.arr = [1, 20, 30, 40, 50];
    self.k = self.arr[0];
    self.acc = 0;
    transition self.k + 1 >= 0 && self.k + 1 < 5 { true -> read() _ -> done() }

    state read(&mut self) {
        self.acc = self.acc + self.arr[self.k + 1];
        transition { _ -> done() }
    }
    state done(&mut self) {
        self.console.exit_process(self.acc as i32);
    }
}
