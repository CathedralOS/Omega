// Any integer operand indexes builtin array and slice geometry
// (spec/language/counts_and_addresses.md, separate roles): every unsigned
// and signed width selects an element once its bounds are proved, and a
// signed index carries its own nonnegative range.
machine combine_fixed(
    values: [u64; 4],
    index_u8: u8 [0..=3],
    index_u16: u16 [0..=3],
    index_u32: u32 [0..=3],
    index_u64: u64 [0..=3],
    index_i8: i8 [0..=3],
    index_i16: i16 [0..=3],
    index_i32: i32 [0..=3],
    index_i64: i64 [0..=3]
) -> u64 {
    values[index_u8] ^ values[index_u16] ^ values[index_u32] ^ values[index_u64]
        ^ values[index_i8] ^ values[index_i16] ^ values[index_i32] ^ values[index_i64]
}

machine read_slice(values: &[u64], position: i32 [0..=3]) -> u64
requires position < values.len;
{
    values[position]
}

machine main() {}
