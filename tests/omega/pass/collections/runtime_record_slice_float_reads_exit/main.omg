// Expected exit: 0. Reads must retain exact descriptor and element identity.
use omega::language::core::slice;
use omega::language::core::float_operations;
data Spectrum<'samples> [copy] { values: &'samples [f64]; }
machine read<'samples>(spectrum: Spectrum<'samples>, index: u64) -> f64
requires index < spectrum.values.len { spectrum.values[index] }
machine borrowed_read<'samples>(spectrum: &Spectrum<'samples>, index: u64) -> f64
requires index < spectrum.values.len { spectrum.values[index] }
machine main() crashes Trap {
    let values: [f64; 3] = [8.0, 11.0, 14.0];
    let spectrum: Spectrum = Spectrum { values: &values };
    let middle: f64 = read(spectrum, 1);
    let last: f64 = borrowed_read(&spectrum, 2);
    transition middle == 11.0 && last == 14.0 { true -> done() false -> bad() }
    machine done() { }
    machine bad() { crash Trap; }
}
