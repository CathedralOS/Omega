// The collection's Trapping policy governs indexing. Its structural enum
// element keeps the declared Mode type and storage identity through dispatch.
data Mode [copy] {
    case Idle;
    case Busy;
}

data Table where count <= 4 {
    modes: [Mode; 4] in Trapping;
    count: u64;
}

machine Table::weigh(table: &Table, index: u64 in Trapping) -> u64
crashes Trap
{
    transition index < table.count {
        true -> classify(table, index)
        _ -> absent()
    }

    state classify(table: &Table, index: u64 in Trapping) {
        transition table.modes[index] {
            Mode::Idle -> idle()
            Mode::Busy -> occupied()
        }
    }

    state idle() { 1 }
    state occupied() { 2 }
    state absent() { 0 }
}

machine main() crashes Trap {
    let mut table: Table;
    table.count = 3;
    table.modes[1] = Mode::Busy;
    let busy: u64 = Table::weigh(&table, 1) as u64;
    let idle: u64 = Table::weigh(&table, 2) as u64;
    let absent: u64 = Table::weigh(&table, 3) as u64;
    transition busy == 2 && idle == 1 && absent == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
