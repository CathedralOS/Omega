data Cell { value: i32 in Wrapping; }
data Row { cells: [Cell; 2]; }

machine read(rows: &[Row], row: u64, column: u64) -> i32 in Wrapping
requires row < rows.len
requires column < 1
{
    rows[row].cells[column + 1].value
}

machine main() crashes Trap {
    let mut rows: [Row; 3];
    rows[2].cells[1].value = 70;
    let view: &[Row] = &rows[..];
    let observed: i32 in Wrapping = read(view, 2, 0);
    transition observed == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
