// A computed index that stays inside a short-circuit operand or a later
// transition arm is evaluated where that operand runs, so symbol resolution
// cannot hoist it. Its bound comes from the arithmetic walk that checked its
// evaluation: `position > 0 &&` bounds `position - 1`, `position >= 5 ||`
// bounds `position + 1`, and a refuted earlier arm bounds the later one.
use omega_language_std::console;

data Main { values: [i32; 6]; }

machine descends(values: &[i32; 6], position: u64) -> bool
requires position < 6
{
    transition position > 0 && values[position - 1] > values[position] {
        true -> (true)
        _ -> (false)
    }
}

machine rises_or_last(values: &[i32; 6], position: u64) -> bool
requires position < 6
{
    transition position >= 5 || values[position + 1] > values[position] {
        true -> (true)
        _ -> (false)
    }
}

machine left_neighbor(values: &[i32; 6], position: u64) -> i32
requires position < 6
{
    transition {
        position == 0 -> (0)
        values[position - 1] < 0 -> (-1)
        _ -> (values[position - 1])
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.values[0] = 9;
    main.values[1] = 4;
    main.values[2] = 6;
    main.values[3] = -3;
    main.values[5] = -1;
    let at_zero: bool = descends(&main.values, 0);
    let at_one: bool = descends(&main.values, 1);
    let at_two: bool = descends(&main.values, 2);
    let rises: bool = rises_or_last(&main.values, 1);
    let last: bool = rises_or_last(&main.values, 5);
    let flat: bool = rises_or_last(&main.values, 0);
    let first: i32 = left_neighbor(&main.values, 0);
    let negative: i32 = left_neighbor(&main.values, 4);
    let neighbor: i32 = left_neighbor(&main.values, 3);
    transition !at_zero && at_one && !at_two && rises && last && !flat
        && first == 0 && negative == -1 && neighbor == 6 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
