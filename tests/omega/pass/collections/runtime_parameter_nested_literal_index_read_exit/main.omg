// Helper machines receive nested fixed arrays as `&mut` parameters, store
// through literal and runtime selectors, and read literal elements back.
// `grid[1][2]` names row 1, column 2: the transposed element `grid[2][1]`
// holds a different value, so a read that swapped the two selectors would
// observe 5 instead of 42. `rows[2].data[1]` reaches through a record member
// between its selectors. Exits 70 only when both helpers read the elements
// their runtime stores updated.

use omega_language_std::console;
use omega::language::core::binding;

data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }

machine bump_grid(grid: &mut [[i32 in Wrapping; 4]; 3], i: u64, j: u64) -> u64
requires i <= 2
requires j <= 3 {
    grid[1][2] = 41;
    grid[2][1] = 5;
    grid[i][j] = grid[i][j] + 1;
    let got: i32 in Wrapping = grid[1][2];
    transition got == 42 {
        true -> (1)
        _ -> (0)
    }
}

machine bump_rows(rows: &mut [Row; 3], i: u64, j: u64) -> u64
requires i <= 2
requires j <= 1 {
    rows[2].data[1] = 41;
    rows[2].tag = 7;
    rows[i].data[j] = rows[i].data[j] + 1;
    let got: i32 in Wrapping = rows[2].data[1] + rows[2].tag;
    transition got == 49 {
        true -> (1)
        _ -> (0)
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut grid: [[i32 in Wrapping; 4]; 3];
    let grid_result: u64 = bump_grid(&mut grid, 1, 2);
    let mut rows: [Row; 3];
    let row_result: u64 = bump_rows(&mut rows, 2, 1);
    transition grid_result == 1 && row_result == 1 {
        true -> done(&main.console)
        _ -> refused(&main.console, 71)
    }

    state done(console: &Binding<Console>) {
        Console::exit_process(console, 70);
    }

    state refused(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
