use omega_language_std::console;

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    fill(&mut main.bag);
    transition main.bag.cells[2].value == 7 {
        true -> tagged(main)
        false -> bad(main)
    }

    state tagged(main: &mut Main) {
        transition main.bag.cells[2].tag == 7 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(90);
    }
}

machine fill(bag: &mut Bag) {
    let cells: &mut [Cell] = &mut bag.cells[..];
    cells[2].value = 7;
    let seen: i32 = cells[2].value;
    cells[2].tag = seen;
    let pick: i32 = 2;
    let marked: i32 = cells[pick].tag;
    transition {
        _ -> done()
    }

    state done() {
    }
}
