data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
machine read(value: &i32 in Wrapping) -> i32 in Wrapping { value }
machine select(rows: &[Row; 3], row: i64, column: i32) -> i32 in Wrapping
requires row >= 0 && row < 3, column >= 0 && column < 2 {
    read(&rows[row + 0].data[column + 0])
}
machine main() crashes Trap {
    let mut rows: [Row; 3];
    rows[2].data[1] = 41;
    let observed: i32 in Wrapping = select(&rows, 2, 1);
    transition observed == 41 && rows[2].data[1] == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
