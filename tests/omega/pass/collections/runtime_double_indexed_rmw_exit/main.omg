// DIRECT RMW on both-runtime nested targets: `grid[i][j] = grid[i][j] + 1`
// (WriteRuntimeMachineDoubleIndexedBinary -- the assignment-value hoist slots
// the RHS read, so left/right ride the ordinary operand machinery) and the
// member-between flavor `rows[i].data[j] += 1`. Also pins the STALE-FOLD fix:
// the const write `grid[1][2] = 41` used to keep its fold PAST the RMW (the
// invalidation key embedded the runtime index -- "grid[i]" never
// prefixes "grid[1][2]"), so the final read folded to 41; nested_place_key
// now stops the prefix BELOW the outermost runtime-indexed level. And the
// hoist-temp typing walks interleaved Indexed/Member chains (rows[i].data[j]
// minted an untypeable Unit temp before).
use omega_language_std::console;
data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Main {
}
machine Main::main(context: &mut Main) reaches Console {
    let mut grid: [[i32 in Wrapping; 4]; 3];
    transition { _ -> grid_rmw(context, &mut grid, 1, 2) }
    state grid_rmw(context: &mut Main, grid: &mut [[i32 in Wrapping; 4]; 3], i: u64, j: u64)
    requires i <= 2
    requires j <= 3 {
        grid[1][2] = 41;
        grid[i][j] = grid[i][j] + 1;
        let got: i32 in Wrapping = grid[1][2];
        transition got == 42 {
            true -> prepare_rows(context)
            false -> no(context)
        }
    }
    state prepare_rows(context: &mut Main) {
        let mut rows: [Row; 3];
        transition { _ -> member_rmw(context, &mut rows, 2, 1) }
    }
    state member_rmw(context: &mut Main, rows: &mut [Row; 3], i: u64, rj: u64)
    requires i <= 2
    requires rj <= 1 {
        rows[2].data[1] = 41;
        rows[2].tag = 7;
        rows[i].data[rj] = rows[i].data[rj] + 1;
        let got: i32 in Wrapping = rows[2].data[1] + rows[2].tag;
        transition got == 49 {
            true -> yes(context)
            false -> no(context)
        }
    }
    state yes(context: &mut Main) { Console::exit_process(1); }
    state no(context: &mut Main) { Console::exit_process(2); }
}
