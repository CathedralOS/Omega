// A scalar machine reads a caller's fixed array through a shared `&[i32; 6]`
// loan with runtime indices, across two states, without a loop. The loan is a
// fixed array, not an element view: its declared extent bounds each read
// under the state's `requires`. Over [4, 15, 8, 42, 16, 23], indices 3 and 5
// select 42 and 23 (not their transposes); exits 70 only when the reads
// return 65.

use omega_language_std::console;
data Main { }

machine pair_sum(numbers: &[i32; 6], first: u64, second: u64) -> i32
requires first < 6
requires second < 6 {
    let left: i32 = numbers[first];
    transition left == 42 {
        true -> add(numbers, second, left)
        _ -> (0)
    }

    state add(numbers: &[i32; 6], second: u64, left: i32) -> i32
    requires second < 6
    requires left == 42 {
        let right: i32 = numbers[second];
        transition right == 23 {
            true -> (65)
            _ -> (1)
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let numbers: [i32; 6] = [4, 15, 8, 42, 16, 23];
    let total: i32 = pair_sum(&numbers, 3, 5);
    transition total == 65 {
        true -> done()
        _ -> refused(71)
    }

    state done() {
        Console::exit_process(70);
    }

    state refused(code: i32) {
        Console::exit_process(code);
    }
}
