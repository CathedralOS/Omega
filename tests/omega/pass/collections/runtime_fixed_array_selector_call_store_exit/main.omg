// Both operand calls execute once, with the selector completing before the
// value changes its source. The store uses the captured selector, not two.
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Grid { cells: [u8; 2]; }
data Cursor {
    index: u64;
    selector_calls: u64 in Wrapping;
    value_calls: u64 in Wrapping;
}

machine select(cursor: &mut Cursor) -> u64
    ensures result == 1
{
    cursor.selector_calls += 1;
    cursor.index = 1;
    1
}

machine value(cursor: &mut Cursor) -> u8 {
    cursor.value_calls += 1;
    cursor.index = 2;
    70
}

machine store(grid: &mut Grid, cursor: &mut Cursor) {
    grid.cells[select(cursor)] = value(cursor);
}

data Main { }
machine Main::main(main: &mut Main) reaches ProcessExit {
    let mut grid: Grid;
    let mut cursor: Cursor;
    store(&mut grid, &mut cursor);
    transition grid.cells[1] == 70 && cursor.index == 2
        && cursor.selector_calls == 1 && cursor.value_calls == 1 {
        true -> passed()
        false -> failed()
    }
    state passed() { ProcessExit::exit_process(70); }
    state failed() { ProcessExit::exit_process(77); }
}
