data Cell where value >= 0 && value <= 9 {
    value: i32;
    tag: u32;
}
data Grid { cells: [Cell; 2]; }
data Cursor { index: i64; }

machine value(cursor: &mut Cursor) -> i32
ensures result >= 0 && result <= 9
{
    cursor.index = 0;
    7
}

machine store(cells: &mut [Cell], cursor: &mut Cursor) {
    transition cursor.index >= 0 && cursor.index < cells.len {
        true -> at(cells, cursor)
        _ -> done()
    }
    machine at(cells: &mut [Cell], cursor: &mut Cursor)
    requires cursor.index >= 0 && cursor.index < cells.len
    {
        cells[cursor.index].value = value(cursor);
    }
    machine done() {}
}

machine main() crashes Trap {
    let mut grid: Grid;
    let mut cursor: Cursor = Cursor { index: 1 };
    let cells: &mut [Cell] = &mut grid.cells[..];
    store(cells, &mut cursor);
    transition grid.cells[1].value == 7 && grid.cells[0].value == 0
        && grid.cells[1].tag == 0 && cursor.index == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
