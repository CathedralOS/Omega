use omega_language_std::console;

data Main { }

machine Main::main(context: &mut Main) reaches Console {
    let mut grid: [[u32; 2]; 2] = [[1, 2], [3, 4]];
    transition { _ -> mutate(context, &mut grid, 1, 0) }

    machine mutate(context: &mut Main, grid: &mut [[u32; 2]; 2], row: u64, column: u64)
    requires row < 2
    requires column < 2 {
        let previous: u32 = grid[row][column];
        grid[row][column] = 9;
        transition previous == 3 && grid[1][0] == 9 && grid[0][0] == 1 && grid[0][1] == 2 && grid[1][1] == 4 {
            true -> success(context)
            false -> failure(context)
        }
    }
    machine success(context: &mut Main) { Console::exit_process(70); }
    machine failure(context: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
