data Cursor where row < 2 { row: u64; }

machine later(cursor: &mut Cursor, result: u32) -> u32 {
    cursor.row = 0;
    result
}

machine first(values: &[u32], ignored: u32) -> u32 {
    transition values.len > 0 {
        true -> present(values)
        _ -> empty()
    }
    machine present(values: &[u32]) -> u32 { values[0] }
    machine empty() -> u32 { 0 }
}

machine verify(values: &[u32], expected: u32) crashes Trap {
    transition values.len > 0 {
        true -> present(values, expected)
        _ -> bad()
    }
    machine present(values: &[u32], expected: u32) {
        transition values[0] == expected {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine exercise(matrix: &[[u32; 3]; 2], cursor: &mut Cursor) crashes Trap
requires cursor.row < 2 {
    let observed: u32 = first(matrix[cursor.row][0..1], later(cursor, 99));
    cursor.row = 1;
    verify(matrix[cursor.row][0..1], later(cursor, 17));
    cursor.row = 0;
    let other: u32 = first(matrix[cursor.row][0..1], later(cursor, 99));
    transition observed == 17 && other == 3 && cursor.row == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let mut matrix: [[u32; 3]; 2];
    matrix[0][0] = 3;
    matrix[1][0] = 17;
    let mut cursor: Cursor = Cursor { row: 1 };
    exercise(&matrix, &mut cursor);
}
