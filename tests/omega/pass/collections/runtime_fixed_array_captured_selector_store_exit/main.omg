// The destination selector completes before the RHS mutates its source.
// The write still targets cell one; the cursor's live value becomes two.
use omega_language_std::console;
use omega::language::core::binding;
data Grid { cells: [u8; 2]; }
data Cursor { index: u64; }

machine replace_cursor(cursor: &mut Cursor) -> u8 {
    cursor.index = 2;
    70
}

machine store(grid: &mut Grid, cursor: &mut Cursor)
    requires cursor.index < 2
{
    grid.cells[cursor.index] = replace_cursor(cursor);
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut grid: Grid;
    let mut cursor: Cursor;
    cursor.index = 1;
    store(&mut grid, &mut cursor);
    transition grid.cells[1] == 70 && cursor.index == 2 {
        true -> passed(&main.console)
        false -> failed(&main.console)
    }
    state passed(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state failed(console: &Binding<Console>) { Console::exit_process(console, 77); }
}
