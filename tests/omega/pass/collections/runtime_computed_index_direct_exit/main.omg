// DIRECT computed-index spellings, auto-hoisted (2026-07-07): the
// syntax->resolved layer rewrites `arr[<binary>]` (self-field/param/literal
// operands only) into `let __hoist_N = <binary>; arr[__hoist_N]`; the typed
// layer types the temp from the place operand's BASE scalar plus a range
// SYNTHESIZED by interval arithmetic over the operands' Exact declared
// ranges (store-enforced at the temp's initializer, so an unguarded `k - 1`
// still rejects); state-storage keeps the temp's slot; simplify never folds
// it back.
// a1: read r = arr[k + 1]        a2: operand r = acc + arr[k + 1]
// a3: write arr[k + 1] = v       a4: reversed literal arr[1 + k]
// a5: backward arr[k - 1] under a dominating guard
use omega::language::std::console;
data Main {
    console: Console;
    arr: [i32 in Wrapping; 5];
    k: u64 [0..=3];
    acc: i32 in Wrapping;
    r: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.arr[1] = 5;
    self.arr[2] = 7;
    self.arr[3] = 42;
    self.k = 2;
    self.r = self.arr[self.k + 1];
    transition self.r == 42 {
        true -> a2()
        false -> no()
    }
    state a2(&mut self) {
        self.acc = 100;
        self.r = self.acc + self.arr[self.k + 1];
        transition self.r == 142 {
            true -> a3()
            false -> no()
        }
    }
    state a3(&mut self) {
        self.arr[self.k + 1] = 99;
        self.r = self.arr[3];
        transition self.r == 99 {
            true -> a4()
            false -> no()
        }
    }
    state a4(&mut self) {
        self.r = self.arr[1 + self.k];
        transition self.r == 99 {
            true -> a5()
            false -> no()
        }
    }
    state a5(&mut self) {
        transition self.k == 2 {
            true -> a5b()
            false -> no()
        }
    }
    state a5b(&mut self) {
        self.r = self.arr[self.k - 1];
        transition self.r == 5 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
