// DIRECT computed-index spellings, auto-hoisted (2026-07-07): the
// syntax->resolved layer rewrites `arr[<binary>]` (self-field/param/literal
// operands only) into `let __hoist_N = <binary>; arr[__hoist_N]`; the typed
// layer types the temp from the place operand's BASE scalar plus a range
// SYNTHESIZED by interval arithmetic over the operands' Exact declared
// ranges (store-enforced at the temp's initializer, so an unguarded `k - 1`
// still rejects); state-storage keeps the temp's slot; simplify never folds
// it back.
// a1: read r = arr[k + 1]        a2: operand r = acc + arr[k + 1]
// a3: write arr[k + 1] = v       a4: reversed literal arr[1 + k]
// a5: backward arr[k - 1] under a dominating guard
// a6: write arr[wh + wn] over `u64 in Wrapping` operands: the temp keeps the
//     operands' arithmetic policy, so its store is not a policy conversion
use omega_language_std::console;
use omega::language::core::binding;
data Main where 0 <= k, k <= 3 {
    console: Binding<Console>;
    arr: [i32 in Wrapping; 5];
    k: u64;
    acc: i32 in Wrapping;
    r: i32 in Wrapping;
    wh: u64 in Wrapping;
    wn: u64 in Wrapping;
}
machine Main::main(main: &mut Main) reaches Console
{
    main.arr[1] = 5;
    main.arr[2] = 7;
    main.arr[3] = 42;
    main.k = 2;
    main.r = main.arr[main.k + 1];
    transition main.r == 42 {
        true -> a2(main)
        false -> no(main)
    }
    state a2(main: &mut Main)
    {
        main.acc = 100;
        main.r = main.acc + main.arr[main.k + 1];
        transition main.r == 142 {
            true -> a3(main)
            false -> no(main)
        }
    }
    state a3(main: &mut Main)
    {
        main.arr[main.k + 1] = 99;
        main.r = main.arr[3];
        transition main.r == 99 {
            true -> a4(main)
            false -> no(main)
        }
    }
    state a4(main: &mut Main)
    {
        main.r = main.arr[1 + main.k];
        transition main.r == 99 {
            true -> a5(main)
            false -> no(main)
        }
    }
    state a5(main: &mut Main)
    {
        transition main.k == 2 {
            true -> a5b(main)
            false -> no(main)
        }
    }
    state a5b(main: &mut Main)
    {
        main.r = main.arr[main.k - 1];
        transition main.r == 5 {
            true -> a6(main)
            false -> no(main)
        }
    }
    state a6(main: &mut Main)
    {
        main.wh = 1;
        main.wn = 3;
        transition main.wh + main.wn < 5 {
            true -> a6b(main)
            false -> no(main)
        }
    }
    state a6b(main: &mut Main)
    {
        main.arr[main.wh + main.wn] = 11;
        main.r = main.arr[4];
        transition main.r == 11 {
            true -> yes(main)
            false -> no(main)
        }
    }
    state yes(main: &mut Main)
    { main.console.exit_process(1); }
    state no(main: &mut Main)
    { main.console.exit_process(2); }
}
