// A RANGE-TYPED LET carrying a computed index (`let m: u64 [1..=4] =
// self.k + 1; self.arr[m]`) lowers on every face. Two coordinated pieces
// (2026-07-07): state-storage keeps the local's SLOT when a computed-value
// initializer is consumed as a runtime index (collection.rs carve-out), and
// state-values' simplify does NOT fold a computed binding back into an index
// position (simplify_index_expression) -- folding re-created `arr[k+1]`,
// which has no lowering. The checker proves bounds from the let's range type.
// The DIRECT `arr[k+1]` stays a clean error until the auto-hoist exists.
// f1: read arr[m], m = k+1        f2: write arr[m] = v
// f3: guard subject arr[m] == v   f4: backward offset m = k-1 (guard-narrowed)
// f5: regression -- bare-copy index (let c = k; arr[c]) still folds+works
use omega_language_std::console;
data Main {
    console: Console;
    arr: [i32; 5];
    k: u64 [0..=3];
    r: i32;
}
machine Main::main(&mut self) {
    self.arr[1] = 5;
    self.arr[2] = 7;
    self.arr[3] = 42;
    self.k = 2;
    let m: u64 [1..=4] = self.k + 1;
    self.r = self.arr[m];
    transition self.r == 42 {
        true -> f2()
        false -> no()
    }
    state f2(&mut self) {
        let w: u64 [1..=4] = self.k + 1;
        self.arr[w] = 99;
        self.r = self.arr[3];
        transition self.r == 99 {
            true -> f3()
            false -> no()
        }
    }
    state f3(&mut self) {
        let g: u64 [1..=4] = self.k + 1;
        transition self.arr[g] == 99 {
            true -> f4()
            false -> no()
        }
    }
    state f4(&mut self) {
        transition self.k == 2 {
            true -> f4a()
            false -> no()
        }
    }
    state f4a(&mut self) {
        let b: u64 [0..=2] = self.k - 1;
        self.r = self.arr[b];
        transition self.r == 5 {
            true -> f5()
            false -> no()
        }
    }
    state f5(&mut self) {
        let c: u64 [0..=3] = self.k;
        self.r = self.arr[c];
        transition self.r == 7 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
