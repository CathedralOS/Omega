data Element { value: u64; }
data Packet { prefix: u8; empty: [[Element; 0]; 2]; suffix: u8; stamp: u64; }
data Context { lead: u8; packet: Packet; trail: u8; }
machine set(packet: &mut Packet) {
    packet.prefix = 7;
    packet.suffix = 9;
    packet.stamp = 70;
}
machine main(context: &mut Context) crashes Trap {
    context.lead = 12;
    context.trail = 13;
    set(&mut context.packet);
    transition context.lead == 12 && context.trail == 13
        && context.packet.prefix == 7 && context.packet.suffix == 9
        && context.packet.stamp == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
