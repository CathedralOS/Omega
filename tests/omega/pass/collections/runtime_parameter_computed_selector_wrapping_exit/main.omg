data Cell [copy] {value:u8 in Wrapping;}
data Cursor {position:u64[0..2];calls:u32 in Wrapping;}
machine select(cursor:&mut Cursor)->u64[0..2] {
 let chosen:u64[0..2]=cursor.position;
 cursor.calls=cursor.calls+1;
 cursor.position=1;
 chosen
}
machine keep(value:u8 in Wrapping)->u8 in Wrapping {value}
machine observe(cells:&[Cell;2],cursor:&mut Cursor)->u8 in Wrapping {
 keep(cells[select(cursor)].value)+1
}
machine main() crashes Trap {
 let cells:[Cell;2]=[Cell{value:255},Cell{value:3}];
 let mut cursor:Cursor=Cursor{position:0,calls:0};
 let observed:u8 in Wrapping=observe(&cells,&mut cursor);
 transition observed==0 && cursor.calls==1 && cursor.position==1 {true->done() _->bad()}
 state done(){} state bad(){crash Trap;}
}
