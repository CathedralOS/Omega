// An element read out of a `[T; N] in Wrapping` array keeps the array's
// declared arithmetic policy, so a read-modify-write back into the same
// runtime-indexed element never converts: the operand carries `i32 in
// Wrapping`, a bare literal lands beside it under that policy, and the result
// stores into the `i32 in Wrapping` slot as is (numeric values, "an implicitly
// bare binding cannot erase Wrapping meaning"). The policy flows the same way
// through every spelling of the element read -- a field of a field, a typed
// local that holds the read, a `&mut` parameter -- and under `+`, `-` and `*`.
// `bytes` makes the retained policy observable: `250 + 10` in `u8 in Wrapping`
// reduces to 4, which an Exact `u8` element could not even prove in range.
// Reduced from samples/cli/rendering/histogram and
// samples/cli/interpreters/stack_calculator.
//
// The refused twin is fail/arithmetic/erased_policy_store_into_qualified_element:
// an explicit `as i32` on the sum erases the policy, and the store back into
// the qualified element then needs an explicit `as i32 in Wrapping`.
data Counts { values: [i32; 4] in Wrapping; }
data Holder { counts: Counts; bytes: [u8; 2] in Wrapping; }

machine triple(counts: &mut Counts, index: u64) requires index < 4 {
    counts.values[index] = counts.values[index] * 3;
}

machine main() crashes Trap {
    let mut holder: Holder;
    holder.counts.values[2] = 5;
    holder.bytes[1] = 250;
    transition { _ -> tally(&mut holder, 2, 1) }

    machine tally(holder: &mut Holder, index: u64, slot: u64) requires index < 4, slot < 2 {
        // Field of a field, `+`: 5 -> 6.
        holder.counts.values[index] = holder.counts.values[index] + 1;
        // Through a typed local, `-`: 6 -> 4.
        let read: i32 in Wrapping = holder.counts.values[index];
        holder.counts.values[index] = read - 2;
        // Through a `&mut` parameter, `*`: 4 -> 12.
        triple(&mut holder.counts, index);
        // `u8 in Wrapping` reduces modulo 256: 250 + 10 -> 4.
        holder.bytes[slot] = holder.bytes[slot] + 10;
        transition holder.counts.values[index] == 12 && holder.bytes[slot] == 4 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
