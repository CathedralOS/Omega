use omega::language::core::slice;
use omega::language::core::float_operations;
data Input<'samples, Element [copy], const Count: u64> [copy] {
 values: &'samples [Element];
 tags: [u8; Count];
}
machine read<'samples>(input: Input<'samples, f64, 2>, index: u64) -> f64
requires index < input.values.len { let value: f64 = input.values[index]; value }
machine main() crashes Trap {
 let values: [f64; 3] = [8.0, 11.0, 14.0];
 let middle: f64 = read(Input { values: &values, tags: [1, 2] }, 1);
 transition middle == 11.0 { true -> done() false -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
