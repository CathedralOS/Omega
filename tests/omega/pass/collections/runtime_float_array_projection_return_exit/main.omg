use omega::language::core::float_operations;
machine row(values: &[[f64; 2]; 2], index: u64) -> [f64; 2]
requires index < 2;
{ values[index] }
machine main() crashes Trap {
 let values: [[f64; 2]; 2] = [[1.0, 2.0], [3.0, 4.0]];
 let selected: [f64; 2] = row(&values, 1);
 transition selected[0] == 3.0 && selected[1] == 4.0 { true -> done() _ -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
