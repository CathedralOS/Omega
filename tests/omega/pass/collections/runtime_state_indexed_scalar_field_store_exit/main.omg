use omega::language::core::float_operations;

data Cell { position: f64; velocity: f64; count: i32 in Wrapping; }
data Cells { values: [Cell; 2]; }

machine increment(value: i32 in Wrapping) -> i32 in Wrapping { value + 1 }

machine advance(cells: &mut Cells, index: u64, delay: f64) requires index < 2 {
    cells.values[index].position = cells.values[index].position + delay * cells.values[index].velocity;
}

machine forward(cells: &mut Cells, index: u64, delay: f64) requires index < 2 {
    transition { _ -> selected(cells, delay, index) }
    state selected(cells: &mut Cells, elapsed: f64, selected_index: u64) requires selected_index < 2 {
        cells.values[selected_index].position = cells.values[selected_index].position + elapsed * cells.values[selected_index].velocity;
        cells.values[selected_index].count = increment(cells.values[selected_index].count);
    }
}

machine main() crashes Trap {
    let mut cells: Cells;
    cells.values[0].velocity = 1.0;
    cells.values[1].velocity = 2.0;
    advance(&mut cells, 1, 3.0);
    forward(&mut cells, 1, 2.0);
    forward(&mut cells, 0, 4.0);
    transition cells.values[1].position == 10.0 && cells.values[0].position == 4.0
        && cells.values[0].count == 1 && cells.values[1].count == 1 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
