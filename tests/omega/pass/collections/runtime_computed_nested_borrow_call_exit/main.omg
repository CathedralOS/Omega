data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }

machine increment(value: &mut i32 in Wrapping) {
    value = value + 1;
}

machine visit(rows: &mut [Row; 3], row: u64, column: u64)
requires row < 3, column < 2
{
    increment(&mut rows[row + 0].data[column + 0]);
}

machine main() crashes Trap {
    let mut rows: [Row; 3];
    rows[2].data[1] = 41;
    rows[2].tag = 7;
    rows[1].data[1] = 5;
    visit(&mut rows, 2, 1);
    transition rows[2].data[1] == 42 && rows[2].data[0] == 0
        && rows[1].data[1] == 5 && rows[2].tag == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
