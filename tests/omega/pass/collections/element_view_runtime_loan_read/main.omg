// Shared record loan through a runtime index: `&cells[bag.at]` captures a
// `&Cell` element whose selector is a structural field of the borrowed
// parameter. The loan mints a runtime-indexed element read — the view's live
// length discharges the bound.
use omega_language_std::console;

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
    at: u64;
}

data Main {
    bag: Bag;
}

machine pick(bag: &mut Bag)
requires bag.at < 4
{
    let cells: &[Cell] = &bag.cells[..];
    let cell: &Cell = &cells[bag.at];
    let observed: i32 = cell.value;
    bag.cells[0].value = observed;
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.at = 2;
    main.bag.cells[2].value = 7;
    main.bag.cells[2].tag = 9;
    pick(&mut main.bag);

    transition main.bag.cells[0].value == 0 {
        true -> bad(main)
        false -> good(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(182);
    }
}
