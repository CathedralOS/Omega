use omega_language_std::console;
use alloc::vec;

// Growth fixture: `Vec` is a linear handle over caller-minted `Backing*`
// stores; `Pool` is the allocation strategy's ledger. The program seeds
// its backing supply, opens the pool, then drives a two-rung growth
// lifecycle and a denied request, and every comparison lands in one
// first-failure exit code.
data Checker {}

// `flag` converts a carried boolean to an index contribution: `k` when the
// check failed, 0 when it held.
machine Checker::flag(ok: bool, k: i32 in Wrapping) -> i32 in Wrapping {
    transition ok {
        true -> 0
        false -> k
    }
}

// `pick` keeps the first nonzero index contribution in a left fold.
machine Checker::pick(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping {
    transition a != 0 {
        true -> a
        false -> b
    }
}

data Main {
    check: Checker;

    // The allocation strategy's ledger over caller-declared supply.
    pool: Pool;

    // Caller-minted backing supply: the main vector's three rung stores,
    // a second store for the empty-cleanup lifecycle, and a spare 16-rung
    // store the denied request must leave untouched.
    eb: Backing4;
    b4: Backing4;
    b8: Backing8;
    b16: Backing16;
    spare16: Backing16;

    // Explicit backing-return targets: what `drain` reads back out.
    out4: Backing4;
    out16: Backing16;

    // The linear handle itself, held as receiver state.
    v: Vec;
}

machine Main::main(main: &mut Main) reaches Console {
    // Mint caller-supplied backing: each store starts empty and unheld.
    Backing4::seed(&mut main.eb);
    Backing4::seed(&mut main.b4);
    Backing8::seed(&mut main.b8);
    Backing16::seed(&mut main.b16);
    Backing16::seed(&mut main.spare16);
    Backing4::seed(&mut main.out4);
    Backing16::seed(&mut main.out16);

    // Declare the supply to the strategy: two 4-stores (eb + b4), one
    // 8-store, one 16-store. The denied request must not touch it.
    Pool::open(&mut main.pool, 2, 1, 1);

    // ---- empty-vector lifecycle: grant, open, drain, release ----
    // `main.v` is the receiver-held linear handle; it names no storage yet.
    main.v.live = 0;
    main.v.rung = 0;
    main.v.len = 0;
    let r4a: Request = Pool::request4(&mut main.pool);
    let opened_e: u64 = Vec::open4(&mut main.v, r4a, &mut main.eb);
    Vec::drain4(&mut main.eb, &mut main.out4);
    Pool::release4(&mut main.pool);

    // ---- main lifecycle: open at rung 4 over caller-supplied b4 ----
    let r4b: Request = Pool::request4(&mut main.pool);
    let opened_v: u64 = Vec::open4(&mut main.v, r4b, &mut main.b4);
    Vec::push4(&mut main.v, &mut main.b4, 0, 1);
    Vec::push4(&mut main.v, &mut main.b4, 1, 2);
    Vec::push4(&mut main.v, &mut main.b4, 2, 3);
    Vec::push4(&mut main.v, &mut main.b4, 3, 4);

    // first growth: 4 -> 8 through the pool's grant
    let r8: Request = Pool::request8(&mut main.pool);
    let moved1: u64 = Vec::grow4to8(&mut main.v, &mut main.b4, &mut main.b8, r8);
    Pool::release4(&mut main.pool);
    Vec::push8(&mut main.v, &mut main.b8, 4, 5);
    Vec::push8(&mut main.v, &mut main.b8, 5, 6);
    Vec::push8(&mut main.v, &mut main.b8, 6, 7);
    Vec::push8(&mut main.v, &mut main.b8, 7, 8);

    // second growth: 8 -> 16 through the pool's grant
    let r16: Request = Pool::request16(&mut main.pool);
    let moved2: u64 = Vec::grow8to16(&mut main.v, &mut main.b8, &mut main.b16, r16);
    Pool::release8(&mut main.pool);
    Vec::push16(&mut main.v, &mut main.b16, 8, 9);
    Vec::push16(&mut main.v, &mut main.b16, 9, 10);

    // allocation failure: the 16-rung supply is exhausted, so this
    // request is denied and grow8to16 must preserve contents, custody,
    // and the caller's spare store untouched.
    let r16b: Request = Pool::request16(&mut main.pool);
    let unmoved: u64 = Vec::grow8to16(&mut main.v, &mut main.b8, &mut main.spare16, r16b);

    // explicit backing return: drain the resident 16-rung store back to
    // caller-owned out16, then release the slot and close the handle.
    Vec::drain16(&mut main.b16, &mut main.out16);
    Pool::release16(&mut main.pool);
    let v_len: u64 = main.v.len;
    let v_live: u64 = main.v.live;
    let v_rung: u64 = main.v.rung;

    // every observation lands in one first-failure exit code.
    let f11: i32 in Wrapping = Checker::flag(opened_e == 1, 11);
    let f12: i32 in Wrapping = Checker::flag(opened_v == 1, 12);
    let f13: i32 in Wrapping = Checker::flag(moved1 == 4, 13);
    let f14: i32 in Wrapping = Checker::flag(moved2 == 8, 14);
    let f15: i32 in Wrapping = Checker::flag(unmoved == 0, 15);
    let f16: i32 in Wrapping = Checker::flag(v_len == 10, 16);
    let f17: i32 in Wrapping = Checker::flag(v_live == 1, 17);
    let f18: i32 in Wrapping = Checker::flag(v_rung == 16, 18);

    // drained contents: the full live prefix crossed into out16.
    let f19: i32 in Wrapping = Checker::flag(main.out16.e[0] == 1, 19);
    let f20: i32 in Wrapping = Checker::flag(main.out16.e[7] == 8, 20);
    let f21: i32 in Wrapping = Checker::flag(main.out16.e[9] == 10, 21);
    let f22: i32 in Wrapping = Checker::flag(main.out16.e[15] == 0, 22);

    // custody: every live store retired, unheld, and zeroed.
    let f23: i32 in Wrapping = Checker::flag(main.b4.held == 0, 23);
    let f24: i32 in Wrapping = Checker::flag(main.b4.e[0] == 0, 24);
    let f25: i32 in Wrapping = Checker::flag(main.b8.held == 0, 25);
    let f26: i32 in Wrapping = Checker::flag(main.b8.e[0] == 0, 26);
    let f27: i32 in Wrapping = Checker::flag(main.b16.held == 0, 27);
    let f28: i32 in Wrapping = Checker::flag(main.b16.e[0] == 0, 28);
    let f29: i32 in Wrapping = Checker::flag(main.eb.held == 0, 29);

    // the denied request left the spare store untouched and unheld.
    let f30: i32 in Wrapping = Checker::flag(main.spare16.held == 0, 30);
    let f31: i32 in Wrapping = Checker::flag(main.spare16.e[0] == 0, 31);

    // the strategy's ledger reconciles: every released slot returned.
    let f32: i32 in Wrapping = Checker::flag(main.pool.free4 == 2, 32);
    let f33: i32 in Wrapping = Checker::flag(main.pool.free8 == 1, 33);
    let f34: i32 in Wrapping = Checker::flag(main.pool.free16 == 1, 34);
    let f35: i32 in Wrapping = Checker::flag(main.pool.over4 == 0, 35);
    let f36: i32 in Wrapping = Checker::flag(main.pool.over8 == 0, 36);
    let f37: i32 in Wrapping = Checker::flag(main.pool.over16 == 0, 37);

    let p1: i32 in Wrapping = Checker::pick(f11, f12);
    let p2: i32 in Wrapping = Checker::pick(p1, f13);
    let p3: i32 in Wrapping = Checker::pick(p2, f14);
    let p4: i32 in Wrapping = Checker::pick(p3, f15);
    let p5: i32 in Wrapping = Checker::pick(p4, f16);
    let p6: i32 in Wrapping = Checker::pick(p5, f17);
    let p7: i32 in Wrapping = Checker::pick(p6, f18);
    let p8: i32 in Wrapping = Checker::pick(p7, f19);
    let p9: i32 in Wrapping = Checker::pick(p8, f20);
    let p10: i32 in Wrapping = Checker::pick(p9, f21);
    let p11: i32 in Wrapping = Checker::pick(p10, f22);
    let p12: i32 in Wrapping = Checker::pick(p11, f23);
    let p13: i32 in Wrapping = Checker::pick(p12, f24);
    let p14: i32 in Wrapping = Checker::pick(p13, f25);
    let p15: i32 in Wrapping = Checker::pick(p14, f26);
    let p16: i32 in Wrapping = Checker::pick(p15, f27);
    let p17: i32 in Wrapping = Checker::pick(p16, f28);
    let p18: i32 in Wrapping = Checker::pick(p17, f29);
    let p19: i32 in Wrapping = Checker::pick(p18, f30);
    let p20: i32 in Wrapping = Checker::pick(p19, f31);
    let p21: i32 in Wrapping = Checker::pick(p20, f32);
    let p22: i32 in Wrapping = Checker::pick(p21, f33);
    let p23: i32 in Wrapping = Checker::pick(p22, f34);
    let p24: i32 in Wrapping = Checker::pick(p23, f35);
    let p25: i32 in Wrapping = Checker::pick(p24, f36);
    let p26: i32 in Wrapping = Checker::pick(p25, f37);

    let code: i32 in Wrapping = 70 + p26;
    Console::exit_process(code as i32);
}
