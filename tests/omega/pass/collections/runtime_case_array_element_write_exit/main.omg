// Array-of-CASE element construction -- the shape the case-vocabulary layout
// Plan needs (`plan.fields[i] = FieldPlan::At { offset, width }`, the
// plan-walking deriver's foundation). Writes a case value at a CONST index and
// at a RUNTIME index, then payload-matches both back: At{8,4} at [0] gives 12,
// At{16,8} at [2] gives 24, exit 36. Native must match the interpreter (the
// interpreter is the L0 build-time engine, so this also gates the structured
// Plan work).
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data FieldPlan {
    case At(offset: i64, width: i64);
    case Skip;
}
data Main
where
    0 <= i,
    i <= 3,
{ plans: [FieldPlan; 4]; i: i64; a: i64 in Wrapping; b: i64 in Wrapping; r: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.plans[0] = FieldPlan::At { offset: 8, width: 4 };
    main.i = 2;
    main.plans[main.i] = FieldPlan::At { offset: 16, width: 8 };
    transition main.plans[0] {
        FieldPlan::At { offset, width } -> first(main, (offset as i64 in Wrapping) + (width as i64 in Wrapping))
        FieldPlan::Skip -> bad(main)
    }
    state first(main: &mut Main, v: i64 in Wrapping) {
        main.a = v;
        transition main.plans[2] {
            FieldPlan::At { offset, width } -> second(main, (offset as i64 in Wrapping) + (width as i64 in Wrapping))
            FieldPlan::Skip -> bad(main)
        }
    }
    state second(main: &mut Main, v: i64 in Wrapping) {
        main.b = v;
        main.r = narrow_i64_to_i32_trapping((main.a + main.b) as i64);
        Console::exit_process(main.r);
    }
    state bad(main: &mut Main) { Console::exit_process(99); }
}
