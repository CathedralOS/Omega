// Runtime selectors at more than one depth write the one element they name:
// `self.cube[self.a][self.b][0]` (two runtime outer indices over a const
// leaf) and `self.grid[self.r][self.c]` (a runtime final index). Both arrays
// start from whole array literals. Each write is read back, beside a
// neighboring element that must keep its literal value: exit 70.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    cube: [[[i32; 2]; 2]; 2];
    grid: [[i32; 3]; 2];
    a: i32;
    b: i32;
    r: i32;
    c: i32;
    deep: i32;
    column: i32;
    deep_neighbor: i32;
    column_neighbor: i32;
}

machine Main::main(&mut self) reaches Console {
    self.cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
    self.grid = [[1, 2, 3], [4, 5, 6]];
    self.a = 1;
    self.b = 1;
    self.r = 1;
    self.c = 2;
    self.cube[self.a][self.b][0] = 99;
    self.grid[self.r][self.c] = 42;
    self.deep = self.cube[1][1][0];
    self.column = self.grid[1][2];
    self.deep_neighbor = self.cube[1][0][1];
    self.column_neighbor = self.grid[1][1];
    transition self.deep == 99 && self.column == 42
        && self.deep_neighbor == 6 && self.column_neighbor == 5 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
