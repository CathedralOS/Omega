// Whole-array VALUE copy: assigning one owned array field to another (`main.b = main.a`)
// copies the contents, so mutating an element of the destination must NOT touch the source.
// The check discriminates both ways: the source array keeps its originals (5, 6, 7) AND the
// destination holds the mutated first element with the rest copied (99, 6, 7). Exits 70.
//
// This is the array counterpart of the struct value-copy locked in
// structs/runtime_array_element_struct_copy_exit. The interpreter (the differential oracle)
// previously ALIASED this (shared the backing element cells) while native deep-copied; the
// fix deep-clones a Value::Array on assignment/`let` ONLY when the target type is an owned
// [T; N] (a slice &[T] stays a shared view), so this now verifies interp==native.
use omega_language_std::console;

data Main {
    a: [i32; 3] in Wrapping;
    b: [i32; 3] in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a[0] = 5;
    main.a[1] = 6;
    main.a[2] = 7;
    main.b = main.a; // whole-array value copy
    main.b[0] = 99;  // mutate the copy's first element
    transition main.a[0] == 5
            && main.a[1] == 6
            && main.a[2] == 7
            && main.b[0] == 99
            && main.b[1] == 6
            && main.b[2] == 7 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(main.a[0] as i32); // surface the aliased source value on regression
    }
}
