// Dijkstra's Dutch national flag partition over an ENUM array -- the
// three-pointer in-place partition written in bubble_sort's landed idiom:
// field counters with declared Exact ranges + literal re-guard states
// dominating every runtime-indexed access.
//
//   [White, Blue, Red]  ->  [Red, White, Blue]
//
// Pins, composed in one program: an INDEXED ENUM guard subject
// (`transition main.items[main.w] { Color::Red -> .. }`), runtime-indexed
// enum-element reads/writes (the swap), counter arithmetic proven by
// dominating guards carried transitively across states, and ZII (Color's
// first case is Red, so the zero array is already all-Red).
//
// The confused(9x) arms are the loop invariants Dafny would write as
// `invariant w <= b <= 3` -- relational facts today's prover doesn't carry
// across the loop, so they stand as honest runtime checks that never fire
// (the dependent-types R2 window-fact target turns them into provably-dead
// arms).
// Expected exit: 70 (71/72/73 = wrong final element at 0/1/2; 96/97/98 =
// invariant check tripped, 95 = increment re-guard tripped).
use omega_language_std::console;
use omega::language::core::binding;
// Swaps copy these payload-free values out of borrowed array storage.
data Color [copy] {
    case Red;
    case White;
    case Blue;
}
data Main
where
    r <= 3,
    w <= 3,
    b <= 3,
    bp <= 2,
{
    console: Binding<Console>;
    items: [Color; 3];
    r: u64;
    w: u64;
    b: u64;
    bp: u64;
    t: Color;
}
machine Main::main(main: &mut Main) reaches Console {
    main.items[0] = Color::White;
    main.items[1] = Color::Blue;
    main.items[2] = Color::Red;
    main.r = 0;
    main.w = 0;
    main.b = 3;
    transition {
        _ -> head(main)
    }

    // Loop head: partition until the white cursor meets the blue fence.
    state head(main: &mut Main) {
        transition main.w < main.b {
            true -> w_guard(main)
            _ -> check0(main)
        }
    }

    // Literal re-guard: dominates every items[main.w] access downstream
    // (classify, red_swap, blue_swap -- no state between rewrites w).
    state w_guard(main: &mut Main) {
        transition main.w < 3 {
            true -> classify(main)
            _ -> confused(main, 96)
        }
    }

    state classify(main: &mut Main) {
        transition main.items[main.w] {
            Color::Red -> r_guard(main)
            Color::White -> w_bump_guard(main)
            _ -> b_guard(main)
        }
    }

    state r_guard(main: &mut Main) {
        transition main.r < 3 {
            true -> red_swap(main)
            _ -> confused(main, 97)
        }
    }

    // Red at the cursor: swap it into the red prefix, grow the prefix
    // (`r + 1` proves on the DIRECT edge from r_guard), then join the
    // white path to bump the cursor.
    state red_swap(main: &mut Main) {
        main.t = main.items[main.r];
        main.items[main.r] = main.items[main.w];
        main.items[main.w] = main.t;
        main.r = main.r + 1;
        transition {
            _ -> w_bump_guard(main)
        }
    }

    // Re-guard before the increment: the bound must sit on the DIRECT edge
    // for the `+ 1` to prove (the bubble_sort `advance` idiom). Both the
    // red and white arms join here.
    state w_bump_guard(main: &mut Main) {
        transition main.w < 3 {
            true -> w_bump(main)
            _ -> confused(main, 95)
        }
    }

    state w_bump(main: &mut Main) {
        main.w = main.w + 1;
        transition {
            _ -> head(main)
        }
    }

    state b_guard(main: &mut Main) {
        transition main.b > 0 {
            true -> blue_swap(main)
            _ -> confused(main, 98)
        }
    }

    // Blue at the cursor: shrink the blue fence, swap the blue out to it.
    // The decremented fence lands in `bp`, whose DECLARED range [0..=2]
    // carries the index proof (the stored `b` itself would read back at
    // its wider [0..=3] range).
    state blue_swap(main: &mut Main) {
        main.bp = main.b - 1;
        main.t = main.items[main.w];
        main.items[main.w] = main.items[main.bp];
        main.items[main.bp] = main.t;
        main.b = main.bp;
        transition {
            _ -> head(main)
        }
    }

    // Verify [Red, White, Blue] element by element via case dispatch.
    state check0(main: &mut Main) {
        transition main.items[0] {
            Color::Red -> check1(main)
            _ -> bad(main, 71)
        }
    }
    state check1(main: &mut Main) {
        transition main.items[1] {
            Color::White -> check2(main)
            _ -> bad(main, 72)
        }
    }
    state check2(main: &mut Main) {
        transition main.items[2] {
            Color::Blue -> good(main)
            _ -> bad(main, 73)
        }
    }
    state good(main: &mut Main) {
        main.console.exit_process(70);
    }
    state bad(main: &mut Main, code: i32) {
        main.console.exit_process(code);
    }
    state confused(main: &mut Main, code: i32) {
        main.console.exit_process(code);
    }
}
