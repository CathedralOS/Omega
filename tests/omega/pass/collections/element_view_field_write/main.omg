use omega_language_std::console;

// Record-element field stores through an exclusive element view: `fill`
// establishes `cells: &mut [Cell]` over the bag's array and stores scalar
// leaves beneath indexed elements. A view carries no literal array length —
// the loan's stored extent is the bound's witness at every stage.

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    fill(&mut main.bag);

    transition main.bag.cells[2].value == 7 {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &mut Main) {
        transition main.bag.cells[2].tag == 9 {
            true -> finish(main)
            false -> bad(main)
        }
    }

    machine finish(main: &mut Main) {
        Console::exit_process(181);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(90);
    }
}

machine fill(bag: &mut Bag) {
    let cells: &mut [Cell] = &mut bag.cells[..];
    cells[2].value = 7;
    cells[2].tag = 9;
    transition {
        _ -> done()
    }

    machine done() {
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
