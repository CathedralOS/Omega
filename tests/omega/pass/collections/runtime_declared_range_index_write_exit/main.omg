// The WRITE face of the declared-range index proof: `self.arr[self.i] = 30`
// with `i: u64 in U640To4` and no dominating guard. The ZII i=0 writes arr[0];
// the read-back confirms -> exit 30.
use omega_language_std::console;
use omega::language::core::binding;

domain u64::U640To4 requires self <= 4;
data Main {
    console: Binding<Console>;
    arr: [i32; 5];
    i: u64 in U640To4;
}

machine Main::main(&mut self) reaches Console {
    transition { _ -> write() }

    state write(&mut self) {
        self.arr[self.i] = 30;
        transition self.arr[0] == 30 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(30); }
    state unmatched(&mut self) { self.console.exit_process(0); }
}
