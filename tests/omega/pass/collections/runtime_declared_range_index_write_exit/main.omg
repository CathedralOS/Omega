// The WRITE face of the declared-range index proof: `main.arr[main.i] = 30`
// with `i: u64 [0..=4]` and no dominating guard. The ZII i=0 writes arr[0];
// the read-back confirms -> exit 30.
use omega_language_std::console;
use omega::language::core::binding;

data Main where 0 <= i, i <= 4 {
    console: Binding<Console>;
    arr: [i32; 5];
    i: u64;
}

machine Main::main(main: &mut Main) reaches Console
{
    transition { _ -> write(main) }

    state write(main: &mut Main)
    {
        main.arr[main.i] = 30;
        transition main.arr[0] == 30 {
            true -> matched(main)
            false -> unmatched(main)
        }
    }
    state matched(main: &mut Main)
    { main.console.exit_process(30); }
    state unmatched(main: &mut Main)
    { main.console.exit_process(0); }
}
