// An array literal of cases stored into one row of a nested array: the row's
// fixed (`main.rows[0] = [..]`) or runtime (`main.rows[main.i] = [..]`) index
// prefixes each element's window, exactly as a whole-field store appends the
// element's own index, and the runtime row re-proves its bound from `i <= 1`.
// Both rows stay distinct: exit 3.
use omega_language_std::console;
use omega::language::core::binding;
data Cell {
    case Wall;
    case Floor;
    case Door;
}
data Main
where
    i <= 1,
{
    console: Binding<Console>;
    rows: [[Cell; 2]; 2];
    i: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.rows[0] = [Cell::Wall, Cell::Wall];
    main.i = 1;
    main.rows[main.i] = [Cell::Floor, Cell::Door];
    transition main.rows[1][1] {
        Cell::Door -> check_row(main)
        _ -> finish(main, 1)
    }
    state check_row(main: &mut Main) {
        transition main.rows[0][1] {
            Cell::Wall -> finish(main, 3)
            _ -> finish(main, 2)
        }
    }
    state finish(main: &mut Main, code: i32) {
        main.console.exit_process(code);
    }
}
