data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Cursor where row < 3 && column < 2 { row: u64; column: u64; }
machine later(cursor: &mut Cursor) -> i32 in Wrapping {
    cursor.row = 0;
    cursor.column = 0;
    42
}
trait Writer { machine store(value: &mut i32 in Wrapping, replacement: i32 in Wrapping); }
Written satisfies Writer {
    machine store(value: &mut i32 in Wrapping, replacement: i32 in Wrapping) { value = replacement; }
}
machine visit(rows: &mut [Row; 3], cursor: &mut Cursor)
requires cursor.row < 3, cursor.column < 2 {
    let selected: dyn Writer = Written as dyn Writer;
    Writer::store(selected, &mut rows[cursor.row].data[cursor.column], later(cursor));
}
machine main() crashes Trap {
    let mut rows: [Row; 3];
    let mut cursor: Cursor = Cursor { row: 2, column: 1 };
    rows[2].tag = 7;
    rows[1].data[1] = 5;
    visit(&mut rows, &mut cursor);
    transition rows[2].data[1] == 42 && rows[0].data[0] == 0
        && rows[1].data[1] == 5 && rows[2].tag == 7
        && cursor.row == 0 && cursor.column == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
