// Nested runtime-indexed element reads in conditional successor arguments.
// `main.a[i][k]` selects row `i` at run time and then element `k` inside that
// row at run time: two `RuntimeIndex` selectors, each bounded against its
// own array by the state's `requires` clauses. The Wrapping policy sits on
// the element type, so the product and the accumulation wrap instead of
// demanding an exact-range proof.
//
//   row a[1]     = [2147483647, 8, 0]
//   column b[_][2] = [2, 9, 5]
//   k = 0: 2147483647 * 2 wraps to -2
//   k = 1: -2 + 8 * 9          =  70
//   k = 2: 70 + 0 * 5          =  70
//
// Reduced from `samples/cli/collections/matrix_multiply`, whose `dot` state
// passes `acc + main.a[i][k] * main.b[k][j]` in the same position.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    a: [[i32 in Wrapping; 3]; 3];
    b: [[i32 in Wrapping; 3]; 3];
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = [[0, 0, 0], [2147483647, 8, 0], [0, 0, 0]];
    main.b = [[0, 0, 2], [0, 0, 9], [0, 0, 5]];
    transition { _ -> dot(main, 1, 2, 0, 0) }
    state dot(main: &mut Main, i: u64, j: u64, k: u64, acc: i32 in Wrapping)
    requires i <= 2
    requires j <= 2
    requires k <= 2 {
        let next_k: u64 = k + 1;
        transition next_k <= 2 {
            true -> dot(main, i, j, next_k, acc + main.a[i][k] * main.b[k][j])
            false -> done(main, acc + main.a[i][k] * main.b[k][j])
        }
    }
    state done(main: &mut Main, acc: i32 in Wrapping) {
        main.console.exit_process(acc as i32);
    }
}
