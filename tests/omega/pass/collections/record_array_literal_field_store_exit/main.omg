// A whole array literal of affine records stored into a fixed-array field:
// each record is established from its own scalar fields, then replaces its
// element window, and each displaced old record dies on the statement's
// continuation. Reads of three stored fields agree: exit 25.
use omega_language_std::console;
use omega::language::core::binding;
data Point {
    x: i32;
    y: i32;
}
data Main {
    console: Binding<Console>;
    points: [Point; 3];
}
machine Main::main(&mut self) reaches Console {
    self.points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 20 }];
    transition { _ -> check() }
    state check(&mut self) {
        transition self.points[2].y == 20 && self.points[0].x == 1 && self.points[1].y == 4 {
            true -> finish(25)
            _ -> finish(1)
        }
    }
    state finish(&mut self, code: i32) {
        self.console.exit_process(code);
    }
}
