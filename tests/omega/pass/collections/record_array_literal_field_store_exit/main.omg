// A whole array literal of affine records stored into a fixed-array field:
// each record is established from its own scalar fields, then replaces its
// element window, and each displaced old record dies on the statement's
// continuation. Reads of three stored fields agree: exit 25.
use omega_language_std::console;
data Point {
    x: i32;
    y: i32;
}
data Main {
    points: [Point; 3];
}
machine Main::main(context: &mut Main) reaches Console {
    context.points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 20 }];
    transition { _ -> check(context) }
    machine check(context: &mut Main) {
        transition context.points[2].y == 20 && context.points[0].x == 1 && context.points[1].y == 4 {
            true -> finish(context, 25)
            _ -> finish(context, 1)
        }
    }
    machine finish(context: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
