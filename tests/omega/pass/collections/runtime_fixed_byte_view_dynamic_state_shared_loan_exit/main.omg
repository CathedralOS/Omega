// Form a fixed byte-view state loan from a runtime-selected array field.
// A later argument resets the selector: the view must still name row 1.
// Its shared copy descriptor crosses another state before both reads.
// Expected exit: 70.
use omega_language_std::console;

data Row { bytes: [u8; 3]; }
data Cursor { index: u64; }

machine reset(cursor: &mut Cursor) -> bool {
    cursor.index = 0;
    true
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut rows: [Row; 2];
    let mut cursor: Cursor = Cursor { index: 1 };
    let selected: u64 = cursor.index;
    rows[0].bytes[0] = 11;
    rows[1].bytes[0] = 22;
    transition selected < 2 {
        true -> select(&mut rows, &mut cursor, selected)
        _ -> finish(71)
    }
    state select(rows: &mut [Row; 2], cursor: &mut Cursor, selected: u64)
        requires selected < 2
    {
        transition { _ -> forward(&rows[selected].bytes, reset(cursor)) }
    }
    state forward(bytes: &[u8; 3], ready: bool) {
        transition { _ -> write(bytes, ready) }
    }
    state write(bytes: &[u8; 3], ready: bool) {
        transition ready && bytes[0] == 22 {
            true -> replace(bytes)
            _ -> finish(72)
        }
    }
    state replace(bytes: &[u8; 3]) {
        transition bytes[0] == 22 {
            true -> finish(70)
            _ -> finish(73)
        }
    }
    state finish(code: i32) { Console::exit_process(code); }
}
