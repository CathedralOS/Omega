// A whole array literal of payload-free cases stored into a fixed-array field
// (`context.grid = [Cell::Water, ..]`, the `samples/cli/rendering/dungeon_render`
// shape). Terminal has no whole structural-array establishment, so the literal
// composes from the operations one `context.grid[k] = Cell::X` already uses:
// every element is established first, then each replaces its own element
// window. The second literal overwrites occupied elements, so every element's
// displacement runs too; the arms read three elements back: exit 42.
use omega_language_std::console;
data Cell {
    case Wall;
    case Floor;
    case Door;
    case Water;
}
data Main {
    grid: [Cell; 4];
}
machine Main::main(context: &mut Main) reaches Console {
    context.grid = [Cell::Wall, Cell::Wall, Cell::Wall, Cell::Wall];
    context.grid = [Cell::Water, Cell::Door, Cell::Floor, Cell::Wall];
    transition context.grid[0] {
        Cell::Water -> second(context, 40)
        _ -> finish(context, 1)
    }
    state second(context: &mut Main, base: i32) {
        transition context.grid[3] {
            Cell::Wall -> third(context, base + 2)
            _ -> finish(context, 2)
        }
    }
    state third(context: &mut Main, total: i32) {
        transition context.grid[1] {
            Cell::Door -> finish(context, total)
            _ -> finish(context, 3)
        }
    }
    state finish(context: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
