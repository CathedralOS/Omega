data Endpoint where end <= 3 { end: u64; }

machine first(values: &[u32], ignored: u32) -> u32
requires values.len > 0 {
    values[0]
}

machine replace(endpoint: &mut Endpoint) -> u32 {
    endpoint.end = 0;
    99
}

machine main() crashes Trap {
    let mut values: [u32; 3];
    values[0] = 7;
    values[1] = 11;
    values[2] = 13;
    let mut endpoint: Endpoint = Endpoint { end: 1 };
    endpoint.end = 1;
    let observed: u32 = first(values[0..endpoint.end], replace(&mut endpoint));
    transition observed == 7 && endpoint.end == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
