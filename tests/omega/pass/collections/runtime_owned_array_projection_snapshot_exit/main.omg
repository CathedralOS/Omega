// Expected exit: 0; stdout: independently frozen selected and copied rows.
use omega_language_std::console;

data Main {
    rows: [[i32; 2]; 2];
    planes: [[[i32; 2]; 2]; 2];
    empty: [[i32; 0]; 2];
}
data Reply [copy] { case Values(row: [i32; 2]); case Empty; }

machine row(rows: &[[i32; 2]; 2], index: u64) -> [i32; 2]
requires index < 2;
{ rows[index] }
machine plane(planes: &[[[i32; 2]; 2]; 2], index: u64) -> [[i32; 2]; 2]
requires index < 2;
{ planes[index] }
machine identity<T [copy]>(values: T) -> T { values }
machine empty_row(rows: &[[i32; 0]; 2], index: u64) -> [i32; 0]
requires index < 2;
{ rows[index] }
machine emit_case(main: &mut Main, reply: &Reply) reaches Console {
    transition reply {
        Reply::Values { row } -> selected(main, row)
        Reply::Empty -> none(main)
    }
    state selected(main: &mut Main, values: [i32; 2]) {
        let copied: [i32; 2] = values;
        emit(main, copied);
    }
    state none(main: &mut Main) { emit(main, [0, 0]); }
}
machine emit_later(main: &mut Main, rows: &[[i32; 2]; 2], index: u64) reaches Console
requires index < 2;
{
    transition { _ -> selected(main, rows, index) }
    state selected(main: &mut Main, rows: &[[i32; 2]; 2], index: u64)
    requires index < 2
    {
        let copied: [i32; 2] = rows[index];
        emit(main, copied);
    }
}
machine emit(main: &mut Main, values: [i32; 2]) reaches Console {
    Console::write_byte(((values[0] as i32 in Wrapping) + 48) as i32);
    Console::write_byte(((values[1] as i32 in Wrapping) + 48) as i32);
    Console::write_byte(10);
}
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    main.rows[0][0] = 1; main.rows[0][1] = 2;
    main.rows[1][0] = 3; main.rows[1][1] = 4;
    main.planes[1][0][0] = 5; main.planes[1][0][1] = 6;
    main.planes[1][1][0] = 7; main.planes[1][1][1] = 8;
    let copied: [i32; 2] = row(&main.rows, 1);
    main.rows[1][0] = 9;
    emit(main, copied);
    let forwarded: [i32; 2] = identity(main.rows[0]);
    emit(main, forwarded);
    let local: [[i32; 2]; 2] = [[1, 2], [3, 4]];
    let local_row: [i32; 2] = local[1];
    emit(main, local_row);
    let selected_plane: [[i32; 2]; 2] = plane(&main.planes, 1);
    let plane_row: [i32; 2] = row(&selected_plane, 1);
    emit(main, plane_row);
    let empty: [i32; 0] = empty_row(&main.empty, 1);
    let reply: Reply = Reply::Values { row: [5, 6] };
    emit_case(main, &reply);
    let state_rows: [[i32; 2]; 2] = [[1, 2], [3, 4]];
    emit_later(main, &state_rows, 0);
    transition copied[0] == 3 && copied[1] == 4 && main.rows[1][0] == 9
        && main.rows[1][1] == 4 && empty.len == 0 {
        true -> good(main) _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(9); }
}
