// A 2D array (`[[i32; 2]; 2]`): const-indexed reads and writes both work, native==interp. Fill
// all four cells and sum them (1+2+3+4 = 10), discriminating each cell. Exit 70 iff the sum is 10.
//
// Runtime row and column selectors are exercised by
// pass/collections/runtime_nested_runtime_indexed_writes_exit; this canary stays in the const subset.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    grid: [[i32; 2]; 2] in Wrapping;
    s: i32 in Wrapping;
}

machine Main::main(&mut self) reaches Console {
    self.grid[0][0] = 1;
    self.grid[0][1] = 2;
    self.grid[1][0] = 3;
    self.grid[1][1] = 4;
    self.s = (self.grid[0][0] as i32 in Wrapping) + (self.grid[0][1] as i32 in Wrapping);
    self.s = (self.s as i32 in Wrapping) + (self.grid[1][0] as i32 in Wrapping);
    self.s = (self.s as i32 in Wrapping) + (self.grid[1][1] as i32 in Wrapping);
    transition self.s == 10 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(self.s as i32);
    }
}
