// Whole structural elements replaced through whole-collection element views
// of borrowed fixed arrays: a structural call result, an element copied
// within one view, and an element copied from a by-value state parameter's
// view. Scalar element writes through the same live view interleave with the
// replacements, and unselected elements keep their contents.
data Exit [copy] { code: u64; open: bool; }
data Room [copy] { cell: u64; exits: [Exit; 3]; }

machine blank_exit(code: u64) -> Exit {
    Exit { code: code, open: true }
}

machine fill_exits(room: &mut Room) {
    let exits: &mut [Exit] = &mut room.exits[..];
    exits[2].code = 5;
    exits[0] = blank_exit(11);
    exits[1].code = 29;
    exits[2] = exits[0];
    exits[0].open = false;
}

machine copy_room(source: Room, destination: &mut Room) {
    transition {
        _ -> apply(source, destination)
    }

    machine apply(room: Room, out_room: &mut Room) {
        out_room.cell = room.cell;
        let out_exits: &mut [Exit] = &mut out_room.exits[..];
        let room_exits: &[Exit] = &room.exits[..];
        out_exits[0] = room_exits[2];
        out_exits[1] = room_exits[1];
    }
}

machine main() crashes Trap {
    let mut room: Room;
    room.cell = 3;
    fill_exits(&mut room);
    let mut mirror: Room;
    mirror.exits[2].code = 41;
    copy_room(room, &mut mirror);
    transition room.exits[0].code == 11 && !room.exits[0].open
        && room.exits[1].code == 29 && !room.exits[1].open
        && room.exits[2].code == 11 && room.exits[2].open
        && mirror.cell == 3
        && mirror.exits[0].code == 11 && mirror.exits[0].open
        && mirror.exits[1].code == 29 && !mirror.exits[1].open
        && mirror.exits[2].code == 41 && !mirror.exits[2].open {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
