// A computed row-major index as a case-dispatch subject
// (`transition self.grid[self.r * 3 + self.c] { .. }`, the
// `samples/cli/rendering/dungeon_render` shape). Symbol resolution hoists the
// computed index into an immutable scalar local before the subject borrow, so
// each arm's case observation selects its element with that local; the one
// dominating guard on the compound bound in `cell` is the evidence Terminal
// re-proves the element bound from. Every cell of a 2x3 grid is classified
// and weighted: 1 + 2 + 4 + 8 + 4 + 1, exit 20.
use omega_language_std::console;
use omega::language::core::binding;
data Cell {
    case Wall;
    case Floor;
    case Door;
    case Water;
}
data Main {
    console: Binding<Console>;
    grid: [Cell; 6];
    r: u32 in Wrapping;
    c: u32 in Wrapping;
    total: i32 in Wrapping;
}
machine Main::main(&mut self) reaches Console {
    self.grid = [Cell::Wall, Cell::Floor, Cell::Door, Cell::Water, Cell::Door, Cell::Wall];
    self.r = 0;
    self.total = 0;
    transition { _ -> row_loop() }
    state row_loop(&mut self) {
        transition self.r < 2 { true -> col_start() _ -> done() }
    }
    state col_start(&mut self) {
        self.c = 0;
        transition { _ -> col_loop() }
    }
    state col_loop(&mut self) {
        transition self.c < 3 { true -> cell() _ -> next_row() }
    }
    state cell(&mut self) {
        transition self.r * 3 + self.c < 6 { true -> classify() _ -> next_row() }
    }
    state classify(&mut self) {
        transition self.grid[self.r * 3 + self.c] {
            Cell::Wall -> add(1)
            Cell::Floor -> add(2)
            Cell::Door -> add(4)
            Cell::Water -> add(8)
        }
    }
    state add(&mut self, weight: i32 in Wrapping) {
        self.total = self.total + weight;
        self.c = self.c + 1;
        transition { _ -> col_loop() }
    }
    state next_row(&mut self) {
        self.r = self.r + 1;
        transition { _ -> row_loop() }
    }
    state done(&mut self) {
        self.console.exit_process(self.total as i32);
    }
}
