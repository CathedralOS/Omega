// A computed row-major index as a case-dispatch subject
// (`transition self.grid[self.r * 3 + self.c] { .. }`, the
// `samples/cli/rendering/dungeon_render` shape). Symbol resolution hoists the
// computed index into an immutable scalar local before the subject borrow, so
// each arm's case observation selects its element with that local; the one
// dominating guard on the compound bound in `cell` is the evidence Terminal
// re-proves the element bound from. Every cell of a 2x3 grid is classified
// and weighted: 1 + 2 + 4 + 8 + 4 + 1, exit 20.
use omega_language_std::console;
use omega::language::core::binding;
data Cell {
    case Wall;
    case Floor;
    case Door;
    case Water;
}
data Main {
    console: Binding<Console>;
    grid: [Cell; 6];
    r: u32 in Wrapping;
    c: u32 in Wrapping;
    total: i32 in Wrapping;
}
machine Main::main(main: &mut Main) reaches Console {
    main.grid = [Cell::Wall, Cell::Floor, Cell::Door, Cell::Water, Cell::Door, Cell::Wall];
    main.r = 0;
    main.total = 0;
    transition { _ -> row_loop(main) }
    state row_loop(main: &mut Main) {
        transition main.r < 2 { true -> col_start(main) _ -> done(main) }
    }
    state col_start(main: &mut Main) {
        main.c = 0;
        transition { _ -> col_loop(main) }
    }
    state col_loop(main: &mut Main) {
        transition main.c < 3 { true -> cell(main) _ -> next_row(main) }
    }
    state cell(main: &mut Main) {
        transition main.r * 3 + main.c < 6 { true -> classify(main) _ -> next_row(main) }
    }
    state classify(main: &mut Main) {
        transition main.grid[main.r * 3 + main.c] {
            Cell::Wall -> add(main, 1)
            Cell::Floor -> add(main, 2)
            Cell::Door -> add(main, 4)
            Cell::Water -> add(main, 8)
        }
    }
    state add(main: &mut Main, weight: i32 in Wrapping) {
        main.total = main.total + weight;
        main.c = main.c + 1;
        transition { _ -> col_loop(main) }
    }
    state next_row(main: &mut Main) {
        main.r = main.r + 1;
        transition { _ -> row_loop(main) }
    }
    state done(main: &mut Main) {
        main.console.exit_process(main.total as i32);
    }
}
