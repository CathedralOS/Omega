// Each indexed destination owns its own bound. The inner extent is three,
// the outer extent two, and their AssignmentIndex depths reverse path order.
use omega_language_std::console;

data Matrix { cells: [[u8; 3]; 2]; }

machine store(matrix: &mut Matrix, row: u64, column: u64)
    requires row < 2, column < 3
{
    matrix.cells[row][column] = 70;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut matrix: Matrix;
    store(&mut matrix, 1, 2);
    transition matrix.cells[1][2] == 70 {
        true -> passed()
        false -> failed()
    }
    machine passed() { Console::exit_process(70); }
    machine failed() { Console::exit_process(77); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
