use omega_language_std::console;
use omega::language::core::binding;

data Node {
    value: i32;
    tag: i32;
}

data Bag {
    nodes: [Node; 4];
}

data Main {
    console: Binding<Console>;
    bag: Bag;
}

machine Main::main(&mut self) reaches Console {
    let fresh: Node = Node { value: 7, tag: 3 };
    self.fill_literal(&mut self.bag, fresh);
    let second: Node = Node { value: 5, tag: 1 };
    self.fill_param(&mut self.bag, second, 1);
    let third: Node = Node { value: 9, tag: 4 };
    self.fill_direct(&mut self.bag, third);
    transition
        self.bag.nodes[2].value == 7
            && self.bag.nodes[1].tag == 1
            && self.bag.nodes[3].value == 9
    {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(181);
    }

    state bad(&mut self) {
        self.console.exit_process(90);
    }
}

machine Main::fill_literal(&mut self, bag: &mut Bag, fresh: Node) {
    let nodes: &mut [Node] = bag.nodes.as_mut_slice();
    let pick: i32 = 2;
    nodes[pick] = fresh;
    transition {
        _ -> done()
    }

    state done() {
    }
}

machine Main::fill_param(&mut self, bag: &mut Bag, fresh: Node, at: u64)
    requires at < 4
{
    let nodes: &mut [Node] = bag.nodes.as_mut_slice();
    nodes[at] = fresh;
    transition {
        _ -> done()
    }

    state done() {
    }
}

machine Main::fill_direct(&mut self, bag: &mut Bag, fresh: Node) {
    bag.nodes[3] = fresh;
    transition {
        _ -> done()
    }

    state done() {
    }
}
