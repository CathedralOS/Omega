use omega_language_std::console;

data Node {
    value: i32;
    tag: i32;
}

data Bag {
    nodes: [Node; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    let fresh: Node = Node { value: 7, tag: 3 };
    Main::fill_literal(&mut main.bag, fresh);
    let second: Node = Node { value: 5, tag: 1 };
    Main::fill_param(&mut main.bag, second, 1);
    let third: Node = Node { value: 9, tag: 4 };
    Main::fill_direct(&mut main.bag, third);
    transition
        main.bag.nodes[2].value == 7
            && main.bag.nodes[1].tag == 1
            && main.bag.nodes[3].value == 9
    {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(90);
    }
}

machine Main::fill_literal(bag: &mut Bag, fresh: Node) {
    let nodes: &mut [Node] = &mut bag.nodes[..];
    let pick: i32 = 2;
    nodes[pick] = fresh;
    transition {
        _ -> done()
    }

    state done() {
    }
}

machine Main::fill_param(bag: &mut Bag, fresh: Node, at: u64)
    requires at < 4
{
    let nodes: &mut [Node] = &mut bag.nodes[..];
    nodes[at] = fresh;
    transition {
        _ -> done()
    }

    state done() {
    }
}

machine Main::fill_direct(bag: &mut Bag, fresh: Node) {
    bag.nodes[3] = fresh;
    transition {
        _ -> done()
    }

    state done() {
    }
}
