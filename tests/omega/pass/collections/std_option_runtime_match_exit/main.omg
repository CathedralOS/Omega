// The std `Optional<T>` works at runtime for presence/absence matching and
// payload extraction. `b` is never written: its all-zero home representation
// must dispatch as None.
use omega::language::core::option;
use omega_language_std::console;

data Main {
    a: Optional<i32>;
    b: Optional<i32>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = Optional::Some { value: 70 };
    transition main.a {
        Optional::Some { value } -> check_b(main, value)
        Optional::None -> bad(main)
    }
    machine check_b(main: &mut Main, value: i32) {
        transition main.b {
            Optional::Some { value } -> bad(main)
            Optional::None -> ok(main, value)
        }
    }
    machine ok(main: &mut Main, value: i32) { Console::exit_process(value); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
