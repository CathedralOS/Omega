// A scalar machine compares IEEE fields of a RUNTIME-selected element of a
// borrowed fixed array against literals: `probes[k].reading == 18.5` is its
// transition guard and `probes[k].scale` is kept in an `f32` local that a
// successor state compares. The element reads run in the machine's attached
// Unit, and an IEEE comparison is a selected operator, so the guard is a
// checked computation with no pure guard expression. The Unit's guard
// dispatch replays that computation; it used to demand a pure guard while
// probing for a case-payload dispatch and refused the machine
// ("scalar computation needs one checked expression and one source
// binding"), although the same guard over a borrowed record's field ran.
//
//   element    tag  reading  scale   classify
//   probes[0]   1    20.5    0.25       1     (reading differs)
//   probes[1]   2    18.5    4.0        2     (scale too large)
//   probes[2]   3    18.5    1.5        0     (both match)
//   probes[3]   4    24.5    1.5        1     (reading differs)
//
// Elements 1 and 2 share `reading` and elements 2 and 3 share `scale`, so a
// read of the wrong element, field, format or stride changes at least one
// classification. All four classifications as tabulated -> exit 70.
use omega::language::core::float_operations;
use omega_language_std::console;

data Probe {
    tag: u8;
    reading: f64;
    scale: f32;
}

machine classify(probes: &[Probe; 4], k: u64) -> i32
requires k < 4 {
    let scale: f32 = probes[k].scale;
    transition probes[k].reading == 18.5 {
        true -> check_scale(scale)
        _ -> (1)
    }

    state check_scale(scale: f32) -> i32 {
        transition scale < 2.0 {
            true -> (0)
            _ -> (2)
        }
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut probes: [Probe; 4];
    probes[0].tag = 1;
    probes[0].reading = 20.5;
    probes[0].scale = 0.25;
    probes[1].tag = 2;
    probes[1].reading = 18.5;
    probes[1].scale = 4.0;
    probes[2].tag = 3;
    probes[2].reading = 18.5;
    probes[2].scale = 1.5;
    probes[3].tag = 4;
    probes[3].reading = 24.5;
    probes[3].scale = 1.5;
    let first: i32 = classify(&probes, 0);
    let second: i32 = classify(&probes, 1);
    let third: i32 = classify(&probes, 2);
    let fourth: i32 = classify(&probes, 3);
    transition first == 1 && second == 2 && third == 0 && fourth == 1 {
        true -> done()
        _ -> refused(71)
    }

    state done() {
        Console::exit_process(70);
    }

    state refused(code: i32) {
        Console::exit_process(code);
    }
}
