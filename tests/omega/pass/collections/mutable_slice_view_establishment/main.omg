use omega_language_std::console;
use omega::language::core::binding;

// Mutable element-view establishment: `let cells: &mut [i32] =
// bag.cells.as_mut_slice()` lends the array's contiguous storage under an
// exclusive loan. The machine writes an element through the view and
// observes the write through the owning collection on the transition guard.
// `sow` exercises the same establishment rooted at the subject.

data Bag {
    cells: [i32; 4];
}

data Main {
    console: Binding<Console>;
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    fill(&mut main.bag);
    Main::sow(main);

    transition main.bag.cells[2] == 7 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(181);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(182);
    }
}

machine fill(bag: &mut Bag) {
    let cells: &mut [i32] = bag.cells.as_mut_slice();
    cells[2] = 7;
}

machine Main::sow(main: &mut Main) {
    let cells: &mut [i32] = main.bag.cells.as_mut_slice();
    cells[0] = 3;
}
