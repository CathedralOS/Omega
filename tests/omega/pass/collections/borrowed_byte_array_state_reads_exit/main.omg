// Element reads through a borrowed whole fixed byte array state parameter.
// `&[u8; 5]` is a bounded byte view whose extent is its declared length, so
// a literal index is a byte read against that extent, never a static
// projection into the array: in a guard, in a statement, and through a
// scalar helper's parameter. Runtime indexes read the same carrier under a
// short-circuit guard and under a state requirement. "HELLO": exit 70.
use omega_language_std::console;
use omega::language::core::binding;

machine head(bytes: &[u8; 5]) -> u8 {
    transition { _ -> (bytes[0]) }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let text: [u8; 5] = "HELLO";
    transition { _ -> literal(&main.console, &text, 1) }

    state literal(console: &Binding<Console>, text: &[u8; 5], second: u64) {
        let last: u8 = text[4];
        transition text[0] == 72 && last == 79 {
            true -> guarded(console, text, second)
            _ -> finish(console, 71)
        }
    }

    state guarded(console: &Binding<Console>, text: &[u8; 5], second: u64) {
        transition second < 5 && text[second] == 69 {
            true -> required(console, text, 2)
            _ -> finish(console, 72)
        }
    }

    state required(console: &Binding<Console>, text: &[u8; 5], third: u64)
        requires third < 5
    {
        let byte: u8 = text[third];
        let first: u8 = head(text);
        transition byte == 76 && first == 72 {
            true -> finish(console, 70)
            _ -> finish(console, 73)
        }
    }

    state finish(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
