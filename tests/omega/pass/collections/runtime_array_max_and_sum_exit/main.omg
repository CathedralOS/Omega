// Find the maximum and the sum of an array in one pass -- a real reduction algorithm over runtime
// indices. Combines: an indexed read bound to a local (`let v = self.arr[self.i]`), reduction
// (`self.total = self.total + v`), and a comparison of the element via the SOUND local-bind
// pattern (`transition v > self.mx`, NOT `transition self.arr[self.i] > self.mx` -- a runtime-
// indexed read as a guard subject silently miscompiles; binding to a local first is the sound
// idiom). arr = [30,50,70,20,60,10] -> max 70, sum 240; both self-checked. Differential.
use omega_language_std::console;
data Main { console: Console; arr: [i32 in Wrapping; 6]; i: i32 in Wrapping; mx: i32 in Wrapping; total: i32 in Wrapping; }
machine Main::main(&mut self) {
    self.arr[0] = 30; self.arr[1] = 50; self.arr[2] = 70; self.arr[3] = 20; self.arr[4] = 60; self.arr[5] = 10;
    self.mx = 0;
    self.total = 0;
    self.i = 0;
    transition { _ -> loop() }
    state loop(&mut self) {
        transition self.i < 6 { true -> body() _ -> check_max() }
    }
    state body(&mut self) {
        let v: i32 in Wrapping = self.arr[self.i];
        self.total = self.total + v;
        self.i = self.i + 1;
        transition v > self.mx { true -> set_max(v) _ -> loop() }
    }
    state set_max(&mut self, v: i32 in Wrapping) {
        self.mx = v;
        transition { _ -> loop() }
    }
    state check_max(&mut self) {
        transition self.mx == 70 { true -> check_sum() _ -> bad() }
    }
    state check_sum(&mut self) {
        transition self.total == 240 { true -> ok() _ -> bad() }
    }
    state ok(&mut self)  { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
