// An index bound carried through a CHAIN of intermediate guards. `x` is bounded once
// (x < 10), then the back-walk crosses several `d < 0 { true -> .. _ -> .. }` convergent-
// arm guards -- which neither name nor rewrite x -- before `arr[x]` is read. The bound
// must survive that crossing. Before convergent arms were treated as a single
// unconditional predecessor, each guard split looked like a join and DROPPED the carried
// bound, forcing a re-guard right before every indexed access (the ripple_field /
// binary_search_viz idiom). Reads arr[3] = 70 -> exit 70. (Reassigning x mid-chain still
// drops the bound -- the survives-check keeps it sound.)
use omega_language_std::console;

data Main {
    console: Console;
    arr: [i32; 10] in Trapping;
    x: i32 in Trapping;
    d: i32 in Trapping;
    r: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.arr = [3, 10, 20, 70, 40, 50, 60, 80, 90, 99];
    self.x = self.arr[0]; // x = 3 (runtime, from a const-index read)
    self.d = 0 - 2;
    transition self.x >= 0 && self.x < 10 { true -> g1() _ -> bad() }

    // a chain of convergent-arm guards on a DIFFERENT field; x is untouched throughout
    state g1(&mut self) {
        transition self.d < 0 { true -> g2() _ -> g2() }
    }
    state g2(&mut self) {
        transition self.d < 0 { true -> g3() _ -> g3() }
    }
    state g3(&mut self) {
        transition self.d < 0 { true -> access() _ -> access() }
    }
    state access(&mut self) {
        self.r = self.arr[self.x]; // x's bound carried across g1..g3
        transition self.r == 70 { true -> good() _ -> wrong() }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state wrong(&mut self) {
        self.console.exit_process(71);
    }
    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
