use omega_language_std::console;

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    bag: Bag;
    at: u64 [0..=3];
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.cells[0].value = 5;
    main.bag.cells[1].value = 3;
    main.bag.cells[2].value = 5;
    main.bag.cells[3].value = 7;
    main.at = 2;
    Main::fill_literal(main);
    Main::fill_field(main);
    Main::fill_local(main);
    Main::fill_param(main, 3);
    Main::read_shared(main, 0);
    transition
        main.bag.cells[2].value == 20
            && main.bag.cells[1].value == 9
            && main.bag.cells[0].value == 5
            && main.bag.cells[3].value == 9
    {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine Main::fill_literal(main: &mut Main) {
    let cells: &mut [Cell] = &mut main.bag.cells[..];
    Main::set_at(&mut cells[2], 40);
}

machine Main::fill_field(main: &mut Main) {
    let cells: &mut [Cell] = &mut main.bag.cells[..];
    Main::set_at(&mut cells[main.at], 20);
}

machine Main::fill_local(main: &mut Main) {
    let i: u64 = 1;
    let cells: &mut [Cell] = &mut main.bag.cells[..];
    Main::set_at(&mut cells[i], 9);
}

machine Main::fill_param(main: &mut Main, k: u64) requires k < 4 {
    let cells: &mut [Cell] = &mut main.bag.cells[..];
    Main::set_at(&mut cells[k], 9);
}

machine Main::read_shared(main: &mut Main, k: u64) requires k < 4 {
    let cells: &[Cell] = &main.bag.cells[..];
    Main::inspect(&cells[k]);
}

machine Main::set_at(cell: &mut Cell, v: i32) {
    cell.value = v;
}

machine Main::inspect(cell: &Cell) {
    transition cell.value == 5 {
        true -> done()
        _ -> miss()
    }

    state done() { }
    state miss() { }
}
