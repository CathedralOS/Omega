data Slot { scores: [i32; 2]; tag: u32; }
data Grid { slots: [Slot; 2]; }
data Cursor { index: i64; }

machine value(cursor: &mut Cursor) -> i32 {
    cursor.index = 0;
    23
}

machine store(slots: &mut [Slot], cursor: &mut Cursor) {
    transition cursor.index >= 0 && cursor.index < slots.len {
        true -> at(slots, cursor)
        _ -> done()
    }
    machine at(slots: &mut [Slot], cursor: &mut Cursor)
    requires cursor.index >= 0 && cursor.index < slots.len
    {
        slots[cursor.index].scores[1] = value(cursor);
    }
    machine done() {}
}

machine main() crashes Trap {
    let mut grid: Grid;
    let mut cursor: Cursor = Cursor { index: 1 };
    let slots: &mut [Slot] = &mut grid.slots[..];
    store(slots, &mut cursor);
    transition grid.slots[1].scores[1] == 23 && grid.slots[1].scores[0] == 0
        && grid.slots[0].scores[1] == 0 && grid.slots[1].tag == 0
        && cursor.index == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
