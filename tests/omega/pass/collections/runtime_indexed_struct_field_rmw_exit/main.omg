// Runtime indexed field update under a dominating read of unchanged storage.
// Both observations select the same element and retain its declared range;
// the guard permits incrementing 4 to 5, which produces exit 1.
use omega_language_std::console;
data Cell where v >= 0 && v <= 9 {
    v: i32;
}
data Main where k <= 3 {
    cells: [Cell; 4];
    k: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.cells[2].v = 4;
    main.k = 2;
    transition main.cells[main.k].v < 9 {
        true -> bump(main)
        false -> full(main)
    }
    state bump(main: &mut Main) {
        main.cells[main.k].v = main.cells[main.k].v + 1;
        transition main.cells[2].v == 5 {
            true -> yes(main)
            false -> no(main)
        }
    }
    state yes(main: &mut Main) { Console::exit_process(1); }
    state no(main: &mut Main) { Console::exit_process(2); }
    state full(main: &mut Main) { Console::exit_process(8); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
