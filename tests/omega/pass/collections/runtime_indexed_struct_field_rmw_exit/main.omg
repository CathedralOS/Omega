// Machine-collection element-field RMW at a RUNTIME index:
// `self.cells[self.k].v = self.cells[self.k].v + 1` under a dominating
// `cells[k].v < 9` guard. The member-over-indexed hoist materializes the READ
// into a field-typed temp ([0..=9] intact), the guard bounds it, and the
// machine-indexed write stores `__hoist + 1` back through the element's field
// offset. cells[2].v: 4 -> 5 -> exit 1.
use omega_language_std::console;
use omega::language::core::binding;
data Cell {
    v: i32 [0..=9];
}
data Main {
    console: Binding<Console>;
    cells: [Cell; 4];
    k: u64 [0..=3];
}
machine Main::main(main: &mut Main) reaches Console {
    main.cells[2].v = 4;
    main.k = 2;
    transition main.cells[main.k].v < 9 {
        true -> bump(main)
        false -> full(main)
    }
    state bump(main: &mut Main) {
        main.cells[main.k].v = main.cells[main.k].v + 1;
        transition main.cells[2].v == 5 {
            true -> yes(main)
            false -> no(main)
        }
    }
    state yes(main: &mut Main) { main.console.exit_process(1); }
    state no(main: &mut Main) { main.console.exit_process(2); }
    state full(main: &mut Main) { main.console.exit_process(8); }
}
