// PROBE (uncharacterized): the EQUALITY op over two runtime-indexed reads in a
// guard -- `arr[i] == arr[j]`. The `<` shape is verified
// (runtime_dual_indexed_guard_compare_exit); `==` was the operator the original
// memory flag named, and equality lowers a different comparison, so it is probed
// separately. arr = [10, 20, 30, 10]. With i = 0 (10), j = 3 (10) the values are
// EQUAL -> true. Then with j = 1 (20) they are UNEQUAL -> false. Both correct ->
// exit 70; a compare that read the wrong element -> exit 71.
use omega_language_std::console;
data Main {
    console: Console;
    arr: [i32; 4];
    i: i32 [0..=3];
    j: i32 [0..=3];
}
machine Main::main(&mut self) {
    self.arr[0] = 10;
    self.arr[1] = 20;
    self.arr[2] = 30;
    self.arr[3] = 10;
    self.i = 0;
    self.j = 3;

    // arr[0]=10 == arr[3]=10 must be TRUE.
    transition self.arr[self.i] == self.arr[self.j] {
        true -> check_unequal()
        false -> bad()
    }

    // arr[0]=10 == arr[1]=20 must be FALSE (re-establish flow constants first).
    state check_unequal(&mut self) {
        self.i = 0;
        self.j = 1;
        transition self.arr[self.i] == self.arr[self.j] {
            true -> bad()
            false -> good()
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
