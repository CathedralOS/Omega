data Row { tag: i32 in Wrapping; data: [i32 in Wrapping; 2]; }
data Cursor { calls: u32 in Wrapping; }
machine choose_row(cursor: &mut Cursor) -> u64
ensures result == 2 {
    cursor.calls = cursor.calls + 1;
    2
}
machine choose_column(cursor: &mut Cursor) -> u64
ensures result == 1 {
    cursor.calls = cursor.calls + 1;
    1
}
machine replacement(cursor: &mut Cursor) -> i32 in Wrapping {
    cursor.calls = cursor.calls + 1;
    42
}
machine store(value: &mut i32 in Wrapping, replacement: i32 in Wrapping) {
    value = replacement;
}
machine visit(rows: &mut [Row; 3], cursor: &mut Cursor) {
    store(&mut rows[choose_row(cursor)].data[choose_column(cursor)], replacement(cursor));
}
machine main() crashes Trap {
    let mut rows: [Row; 3];
    let mut cursor: Cursor;
    rows[2].tag = 7;
    visit(&mut rows, &mut cursor);
    transition rows[2].data[1] == 42 && rows[0].data[0] == 0
        && rows[2].tag == 7 && cursor.calls == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
