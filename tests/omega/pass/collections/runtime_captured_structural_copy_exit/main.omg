// Each selector runs once in source order. The copied record keeps the value
// it read even after the original cell is replaced. A preceding scalar call
// keeps selector positions honest in the enclosing computation's local roster.
data Cell [copy] { value: u32 in Wrapping; ready: bool; }
data Row [copy] { cells: [Cell; 2]; }
data Matrix { rows: [Row; 2]; }
data Cursor { calls: u32 in Wrapping; trace: u32 in Wrapping; }

machine select(cursor: &mut Cursor, digit: u32 in Wrapping) -> u64
ensures result < 2
{
    cursor.calls = cursor.calls + 1;
    cursor.trace = cursor.trace * 10 + digit;
    0
}

machine keep(value: u32 in Wrapping) -> u32 in Wrapping { value }

machine observe(matrix: &mut Matrix, cursor: &mut Cursor) -> u32 in Wrapping {
    let earlier: u32 in Wrapping = keep(19);
    let copied: Cell = matrix.rows[select(cursor, 1)].cells[select(cursor, 2)];
    matrix.rows[0].cells[0] = Cell { value: 99, ready: false };
    transition copied.ready {
        true -> captured(earlier + copied.value)
        _ -> missing()
    }
    machine captured(value: u32 in Wrapping) -> u32 in Wrapping { value }
    machine missing() -> u32 in Wrapping { 0 }
}

machine main() crashes Trap {
    let mut matrix: Matrix;
    matrix.rows[0].cells[0] = Cell { value: 7, ready: true };
    let mut cursor: Cursor = Cursor { calls: 0, trace: 0 };
    let observed: u32 in Wrapping = observe(&mut matrix, &mut cursor);
    transition observed == 26 && cursor.calls == 2 && cursor.trace == 12
        && matrix.rows[0].cells[0].value == 99 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
