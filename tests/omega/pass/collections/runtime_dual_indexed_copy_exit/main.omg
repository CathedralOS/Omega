// The DUAL runtime-indexed copy `nums[i] = nums[j]` (task #38) -- LOWERED FOR
// REAL now via CopyRuntimeMachineIndexedToRuntimeMachineIndexed (read the
// source element off the machine base by j, store it by i; two machine-base
// relocations, distinct index registers). This was fenced as a clean error
// since 2026-06-29 because the value used to resolve to the array BASE and
// silently copy nums[0]. nums=[10,20,30,40,50], i=0, j=4: nums[0] becomes 50
// and the program exits it -- 50 proves the copy read element j (the historic
// bug exits 10; a no-op also exits 10).
use omega::language::std::console;

data Main {
    console: Console;
    nums: [i32; 5] in Trapping;
    i: i32 in Trapping;
    j: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.nums = [10, 20, 30, 40, 50];
    self.i = 0;
    self.j = 4;
    self.nums[self.i] = self.nums[self.j];
    self.console.exit_process(self.nums[0]);
}
