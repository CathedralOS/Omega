// A FRAME-resident (by-value param) inline array read at a RUNTIME index
// (`let v = arr[k]`): used to fall through every value-write strategy and
// silently read 0 (interp right). Now lowered via
// CopyRuntimeFrameBaseIndexedToRuntimeFrame -- the LOAD counterpart of the
// frame-base-indexed address computation. arr=[10,20,30], k=1 -> 20 -> exit 1.
use omega_language_std::console;
data Main {
    arr: [i32; 3];
}
machine Main::main(main: &mut Main) {
    main.arr[0] = 10;
    main.arr[1] = 20;
    main.arr[2] = 30;
    transition { _ -> Main::pick(main.arr, 1, main) }
}
machine Main::pick(arr: [i32; 3], k: u64, main: &mut Main) reaches Console
requires k <= 2
{
    let v: i32 = arr[k];
    transition v == 20 {
        true -> yes(main)
        false -> no(main)
    }
    machine yes(main: &mut Main) { Console::exit_process(1); }
    machine no(main: &mut Main) { Console::exit_process(2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
