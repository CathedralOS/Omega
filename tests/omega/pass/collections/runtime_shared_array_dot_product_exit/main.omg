// Dot product of two vectors: sum over i of a[i] * b[i]. This reads cleanly now
// that a runtime-indexed read works as a sub-expression operand -- two indexed
// reads inside a multiplication inside the running sum, written directly:
//
//   sum = sum + a[i] * b[i]
//
// The vectors are invocation-local values. A shared-borrowed reduction carries
// only its index and accumulator between states, not scratch fields in Main.
// The accumulator and elements are `in Wrapping`; the counter is Exact and
// its increment is bounded by the guarded state entry.
//
// [1,2,3] . [4,5,6] = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32.
// Expected exit: 32.

use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    Console::write_line("dot_product: [1,2,3] . [4,5,6] via inline indexed multiply-accumulate");
    let a: [i32 in Wrapping; 3] = [1, 2, 3];
    let b: [i32 in Wrapping; 3] = [4, 5, 6];
    let sum: i32 in Wrapping = compute_dot_product(&a, &b);
    Console::write_line("result: the dot product, 32 for these vectors (the exit code)");
    Console::write_line("[press Enter to close]");
    let mut pause: [u8; 256];
    _ = block Console::read_line(&mut pause);
    Console::exit_process(sum as i32);
}

machine compute_dot_product(a: &[i32 in Wrapping; 3], b: &[i32 in Wrapping; 3]) -> i32 in Wrapping {
    transition { _ -> step(a, b, 0, 0) }

    state step(a: &[i32 in Wrapping; 3], b: &[i32 in Wrapping; 3], index: i32, sum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 {
        transition index < 3 {
            true -> accumulate(a, b, index, sum)
            _ -> done(sum)
        }
    }

    state accumulate(a: &[i32 in Wrapping; 3], b: &[i32 in Wrapping; 3], index: i32, sum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0
    requires index < 3 {
        let next_sum: i32 in Wrapping = sum + a[index] * b[index];
        transition { _ -> step(a, b, index + 1, next_sum) }
    }

    state done(sum: i32 in Wrapping) -> i32 in Wrapping { sum }
}
