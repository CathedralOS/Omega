// A closed primitive array literal may compute its elements with calls. Each
// element call runs once, in increasing index order, and lands in its own
// slot: the program exits 70 only when the three slots hold 2, 4 and 6.
use omega_language_std::console;

machine twice(value: i32 in Wrapping) -> i32 in Wrapping {
    value + value
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let values: [i32 in Wrapping; 3] = [twice(1), twice(2), twice(3)];
    transition {
        values[0] == 2 && values[1] == 4 && values[2] == 6 -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
