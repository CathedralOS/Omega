use omega_language_std::console;
use omega::language::core::binding;

// ALLOCATOR STORY STAGE 1 — fixed-capacity vec, proof-discharged round trip.
//
// `FixedVecI32x4` is the core `FixedVec<T, const N: u64>` pattern
// (core/fixed_vec.omg) instantiated BY HAND for i32 / N = 4, because generic
// machine instantiation is not wired yet (any machine attached to the
// generic data fails layout on `[T; N]`). The contracts are the core ones:
//
//   * push requires provable spare room (`length < items.len`) — no growth,
//     no trap; an undischarged call is a compile error (see the
//     fail/collections twins).
//   * pop requires provable non-emptiness plus the spelled predecessor
//     bound (`length - 1 < items.len`; derivable once data invariants
//     exist).
//   * get requires the index within the LIVE length; the capacity-side
//     bound folds against the static extent.
//
// The discharge chain is pure contract chaining — no runtime checks:
// clear ESTABLISHES room (ensures; valid here because N = 4 > 0), push
// CONSUMES it and GUARANTEES non-emptiness + the popped slot's bound, pop
// and get CONSUME push's guarantees. Mutating calls invalidate carried
// facts, so each proof-obligated call is fed by the guarantee of the call
// before it.
//
// At runtime the ladder checks the actual data flow: push(7) lands in the
// store (get(0) == 7), pop returns the pushed value AND shrinks the vector,
// a second clear/push cycle overwrites slot 0 (get(0) == 9), and the final
// length is exactly 1. Exits 70 only when every value and the length hold.

data FixedVecI32x4 {
    items: [i32; 4];
    length: u64 in Wrapping;
}

// Empty the vector and ESTABLISH the has-room fact for the next push. The
// strict `<` ensures is justified by this concrete capacity (4 > 0); the
// generic core `clear` only guarantees `length == 0`.
machine FixedVecI32x4::clear(fixed_vec_i32x4: &mut FixedVecI32x4)
ensures
    fixed_vec_i32x4.length < fixed_vec_i32x4.items.len
{
    fixed_vec_i32x4.length = 0;
}

machine FixedVecI32x4::push(fixed_vec_i32x4: &mut FixedVecI32x4, value: i32 in Wrapping)
requires
    fixed_vec_i32x4.length < fixed_vec_i32x4.items.len
ensures
    fixed_vec_i32x4.length > 0;
    fixed_vec_i32x4.length - 1 < fixed_vec_i32x4.items.len
{
    let slots: &mut [i32] = fixed_vec_i32x4.items.as_mut_slice();
    let index: u64 in Wrapping = fixed_vec_i32x4.length;
    let raw_value: i32 = value as i32;
    let n: u64 in Wrapping = slots.len;
    slots[index] = raw_value;
    fixed_vec_i32x4.length = fixed_vec_i32x4.length + 1;
}

// The conventional read-into-local-then-return spelling: the popped value is
// captured BEFORE the length write and returned as a trailing bare local.
// (This shape used to be mis-lowered natively -- the trailing local had no
// frame slot, so the result write silently dropped; pinned by
// calls/runtime_trailing_local_return_exit.)
machine FixedVecI32x4::pop(fixed_vec_i32x4: &mut FixedVecI32x4) -> i32
requires
    fixed_vec_i32x4.length > 0;
    fixed_vec_i32x4.length - 1 < fixed_vec_i32x4.items.len
{
    let slots: &[i32] = fixed_vec_i32x4.items.as_slice();
    let index: u64 in Wrapping = fixed_vec_i32x4.length - 1;
    let value: i32 in Wrapping = slots[index] as i32 in Wrapping;
    fixed_vec_i32x4.length = index;
    let raw_value: i32 = value as i32;
    raw_value
}

machine FixedVecI32x4::get(fixed_vec_i32x4: &FixedVecI32x4, index: u64 in Wrapping) -> i32
requires
    fixed_vec_i32x4.length > index;
    index < fixed_vec_i32x4.items.len
{
    let slots: &[i32] = fixed_vec_i32x4.items.as_slice();
    slots[index]
}

data Main {
    console: Binding<Console>;
    vec: FixedVecI32x4;
}

machine Main::main(main: &mut Main) reaches Console {
    FixedVecI32x4::clear(&mut main.vec);
    FixedVecI32x4::push(&mut main.vec, 7);
    let first: i32 in Wrapping = FixedVecI32x4::get(&main.vec, 0) as i32 in Wrapping;
    let popped: i32 in Wrapping = FixedVecI32x4::pop(&mut main.vec) as i32 in Wrapping;
    FixedVecI32x4::clear(&mut main.vec);
    FixedVecI32x4::push(&mut main.vec, 9);
    let second: i32 in Wrapping = FixedVecI32x4::get(&main.vec, 0) as i32 in Wrapping;

    transition first == 7 {
        true -> check_popped(main, popped, second)
        false -> bad_first(main)
    }

    state check_popped(main: &mut Main, popped: i32 in Wrapping, second: i32 in Wrapping) {
        transition popped == 7 {
            true -> check_second(main, second)
            false -> bad_popped(main)
        }
    }

    state check_second(main: &mut Main, second: i32 in Wrapping) {
        transition second == 9 {
            true -> check_length(main)
            false -> bad_second(main)
        }
    }

    state check_length(main: &mut Main) {
        transition main.vec.length == 1 {
            true -> good(main)
            false -> bad_length(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad_first(main: &mut Main) {
        main.console.exit_process(71);
    }

    state bad_popped(main: &mut Main) {
        main.console.exit_process(72);
    }

    state bad_second(main: &mut Main) {
        main.console.exit_process(73);
    }

    state bad_length(main: &mut Main) {
        main.console.exit_process(74);
    }
}
