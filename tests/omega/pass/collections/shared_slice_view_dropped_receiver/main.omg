use omega_language_std::console;

data Node {
    value: i32;
    tag: i32;
}

data Bag {
    nodes: [Node; 4];
}

data Probe {
    seed: i32;
}

data Main {
    probe: Probe;
}

machine Main::main(main: &mut Main) reaches Console {
    let bag: Bag;
    bag.nodes[2].value = 7;
    Probe::scan(&main.probe, &mut bag);
    transition true {
        true -> good(main)
        _ -> good(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }
}

machine Probe::scan(probe: &Probe, bag: &mut Bag) {
    let slots: &[Node] = &bag.nodes[..];
}
