// Offset subviews retain their backing, and each descendant array contributes
// its own selector stride. Padding makes a static-offset-only read observable.
data Cell { padding: u64; value: i32 in Wrapping; active: bool; }
data Row { header: u64; cells: [Cell; 3]; numbers: [i32 in Wrapping; 2]; }

machine read_cell(rows: &[Row], row: u64, column: i32) -> i32 in Wrapping
requires row < rows.len
requires 0 <= column
requires column < 3
{
    rows[row].cells[column].value
}

machine read_number(rows: &[Row], row: u64, column: u64) -> i32 in Wrapping
requires row < rows.len
requires column < 2
{
    rows[row].numbers[column]
}

machine read_active(rows: &[Row], row: u64, column: u64) -> bool
requires row < rows.len
requires column < 3
{
    rows[row].cells[column].active
}

machine main() crashes Trap {
    let mut rows: [Row; 4];
    rows[2].cells[2].value = 42;
    rows[2].cells[2].active = true;
    rows[2].numbers[1] = 70;
    let view: &[Row] = &rows[..];
    let window: &[Row] = view[1..3];
    let cell: i32 in Wrapping = read_cell(window, 1, 2);
    let number: i32 in Wrapping = read_number(window, 1, 1);
    let active: bool = read_active(window, 1, 2);
    transition cell == 42 && number == 70 && active {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
