use omega::language::core::float_operations;

data Cell { value: f64 in Finite; tag: u32; }
data Grid { cells: [Cell; 2]; }
data Cursor { index: i64; calls: u32 in Wrapping; }

machine sample(cursor: &mut Cursor) -> f64 in Finite {
    cursor.index = 0;
    cursor.calls = cursor.calls + 1u32;
    3.75
}

machine store(cells: &mut [Cell], cursor: &mut Cursor) {
    transition cursor.index >= 0 && cursor.index < cells.len {
        true -> at(cells, cursor)
        _ -> done()
    }
    machine at(cells: &mut [Cell], cursor: &mut Cursor)
    requires cursor.index >= 0 && cursor.index < cells.len
    {
        cells[cursor.index].value = sample(cursor);
    }
    machine done() {}
}

machine main() crashes Trap {
    let mut grid: Grid;
    let mut cursor: Cursor = Cursor { index: 1, calls: 0u32 };
    let cells: &mut [Cell] = &mut grid.cells[..];
    store(cells, &mut cursor);
    transition grid.cells[1].value == 3.75 && grid.cells[0].value == 0.0
        && grid.cells[1].tag == 0u32 && cursor.index == 0i64 && cursor.calls == 1u32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
