data Cell where value >= 0 && value <= 9, floor >= 0, ceiling <= 9 {
    value: i32;
    floor: i64;
    ceiling: u64;
}
data Grid { cells: [Cell; 2]; }

machine value() -> i32 ensures result == 7 { 7 }

machine store(cells: &mut [Cell])
requires cells.len >= 2
{
    cells[1].value = value();
    cells[1].floor = 100;
    cells[1].ceiling = 9;
}

machine main() crashes Trap {
    let mut grid: Grid;
    let cells: &mut [Cell] = &mut grid.cells[..];
    store(cells);
    transition grid.cells[1].value == 7 && grid.cells[1].floor == 100
        && grid.cells[1].ceiling == 9 && grid.cells[0].value == 0
        && grid.cells[0].floor == 0 && grid.cells[0].ceiling == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
