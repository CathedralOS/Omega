// Runtime-indexed read of a BOUNDED element leaf: `cells[k].v` where `v: i32
// [0..=9]` cannot emit a flat scalar read (the declared bound belongs to the
// canonical field read), so emission hoists the element through a
// `StructuralLeafCopy` at the runtime index and reads `v` canonically on the
// fresh element place. Exit 70 only when the hoisted read carried the bound
// and the authored value.
use omega_language_std::console;
data Cell where v >= 0 && v <= 9 {
    hp: i32;
    v: i32;
}
data Main where k <= 3 {
    cells: [Cell; 4];
    k: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.cells[2].hp = 1;
    main.cells[2].v = 7;
    main.k = 2;
    transition main.cells[main.k].v == 7 {
        true -> yes(main)
        false -> no(main)
    }
    machine yes(main: &mut Main) { Console::exit_process(70); }
    machine no(main: &mut Main) { Console::exit_process(3); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
