// Composition control: restricted u8 storage must not shadow plain byte identity.
// Form a fixed byte-view state loan from a runtime-selected array field.
// A later argument resets the selector: the view must still name row 1.
// Its descriptor crosses another state before the first read and write.
// Expected exit: 70.
use omega_language_std::console;
use omega::language::core::binding;

data Row { bytes: [u8; 3]; }
data Cursor { index: u64; }

machine reset(cursor: &mut Cursor) -> bool {
    cursor.index = 0;
    true
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut rows: [Row; 2];
    let mut cursor: Cursor = Cursor { index: 1 };
    let selected: u64 = cursor.index;
    let mut marker: u8 [0..=7] = 3;
    rows[0].bytes[0] = 11;
    rows[1].bytes[0] = 22;
    transition selected < 2 && marker == 3 {
        true -> select(&main.console, &mut rows, &mut cursor, selected)
        _ -> finish(&main.console, 71)
    }
    state select(console: &Binding<Console>, rows: &mut [Row; 2], cursor: &mut Cursor, selected: u64)
        requires selected < 2
    {
        transition { _ -> forward(console, &mut rows[selected].bytes, reset(cursor)) }
    }
    state forward(console: &Binding<Console>, bytes: &mut [u8; 3], ready: bool) {
        transition { _ -> write(console, bytes, ready) }
    }
    state write(console: &Binding<Console>, bytes: &mut [u8; 3], ready: bool) {
        transition ready && bytes[0] == 22 {
            true -> replace(console, bytes)
            _ -> finish(console, 72)
        }
    }
    state replace(console: &Binding<Console>, bytes: &mut [u8; 3]) {
        bytes[0] = 77;
        transition bytes[0] == 77 {
            true -> finish(console, 70)
            _ -> finish(console, 73)
        }
    }
    state finish(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
