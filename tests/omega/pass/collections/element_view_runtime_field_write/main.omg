use omega_language_std::console;

// Record-element field stores at a runtime selector through an exclusive
// element view: `fill` establishes `cells: &mut [Cell]` over the bag's array
// and writes beneath `cells[pick]`. A view's extent is live — the store's
// bound re-proves `pick < len` against the dominating length observation the
// emission mints beside it, never against a literal in the type.

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    fill(&mut main.bag);

    transition main.bag.cells[2].value == 7 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(90);
    }
}

machine fill(bag: &mut Bag) {
    let cells: &mut [Cell] = &mut bag.cells[..];
    let pick: i32 = 2;
    cells[pick].value = 7;
    transition {
        _ -> done()
    }

    state done() {
    }
}
