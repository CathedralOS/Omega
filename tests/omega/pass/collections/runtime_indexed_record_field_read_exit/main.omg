// A scalar field of a RUNTIME-selected record element, read as a store value:
// `self.cells[self.i].hp`. The read is one Terminal `PrimitiveScalarRead`
// whose path selects the element with a `RuntimeIndex` segment and ends at
// the element's `hp` field; the verifier bounds the selector against the
// array's declared extent, and Omega loads `hp` at its declared offset inside
// the element, past `tag`, plus `i` times the element stride.
//
// The four elements hold distinct `hp` values and element 2 also holds a
// `tag`, so reading the wrong element, the wrong field or the wrong stride
// gives a different exit. Boolean observations select both a true and false
// element through the same runtime-indexed read. All observations -> exit 70.
use omega_language_std::console;
use omega::language::core::binding;

data Cell {
    tag: u8;
    ready: bool;
    hp: i32;
}

data Main {
    console: Binding<Console>;
    cells: [Cell; 4];
    i: u64 [0..=3];
    scratch: i32;
    selected: bool;
    other: bool;
}

machine Main::main(&mut self) reaches Console {
    self.cells[0].hp = 5;
    self.cells[1].hp = 11;
    self.cells[2].hp = 70;
    self.cells[2].tag = 9;
    self.cells[2].ready = true;
    self.cells[3].hp = 13;
    self.cells[3].ready = true;
    self.i = 2;
    self.scratch = self.cells[self.i].hp;
    self.selected = self.cells[self.i].ready;
    self.i = 1;
    self.other = self.cells[self.i].ready;
    transition self.selected && !self.other && self.scratch == 70 {
        true -> good(&mut self)
        _ -> bad(&mut self)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
