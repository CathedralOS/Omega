// CONST-row + RUNTIME-column 2D reads (`grid[1][j]`, j runtime): used to be
// fenced (and before that a silent read-0). The const level folds into the
// machine-owned collection resolution's fixed offset (root-element-index
// ordering fix + suffix-walk boundary threading); the op carries the one
// runtime index. Pins BOTH consumers: machine-field target (`main.got = ..`)
// and frame LET target (`let picked = ..`). grid[1][2]=42, j=2 -> exit 1.
use omega_language_std::console;
use omega::language::core::binding;
data Main where 0 <= j, j <= 3 {
    console: Binding<Console>;
    grid: [[i32; 4]; 3];
    j: u64;
    got: i32;
}
machine Main::main(main: &mut Main) reaches Console
{
    main.grid[1][2] = 42;
    main.grid[1][3] = 9;
    main.grid[2][2] = 5;
    main.j = 2;
    main.got = main.grid[1][main.j];
    transition main.got == 42 {
        true -> let_read(main)
        false -> no(main)
    }
    state let_read(main: &mut Main)
    {
        let picked: i32 = main.grid[1][main.j];
        transition picked == 42 {
            true -> neighbor(main)
            false -> no(main)
        }
    }
    state neighbor(main: &mut Main)
    {
        main.got = main.grid[2][main.j];
        transition main.got == 5 {
            true -> yes(main)
            false -> no(main)
        }
    }
    state yes(main: &mut Main)
    { main.console.exit_process(1); }
    state no(main: &mut Main)
    { main.console.exit_process(2); }
}
