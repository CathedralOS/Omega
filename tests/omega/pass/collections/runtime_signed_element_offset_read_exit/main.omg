// A runtime-indexed element read of a narrow signed array that does not start
// the referent: `values` follows the console binding and a u64 field, so the
// element address is the array's nonzero base plus index * 4, and the i32
// load must sign-extend. values[2] is -7; only a read that addresses the
// array field and restores the sign compares equal. The declared domain
// `i: u64 in U640To3` proves the element obligation. -> exit 70.
use omega_language_std::console;

domain u64::U640To3(value) requires value <= 3;
data Main {
    tag: u64;
    values: [i32; 4];
    i: u64 in U640To3;
}

machine Main::main(main: &mut Main) reaches Console {
    main.tag = 99;
    main.values[0] = 5;
    main.values[1] = 11;
    main.values[2] = -7;
    main.values[3] = 13;
    main.i = 2;
    transition { _ -> read(main) }

    state read(main: &mut Main) {
        let v: i32 = main.values[main.i];
        transition v == -7 {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
