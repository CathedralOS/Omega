// Build root. The program-entry root is load-bearing: the array field store
// lane is exercised only once an entry is established and the machine's Unit
// plan is demanded -- a targetless check never reaches it.
machine build(builder: &mut Build) {
    builder.application("indexed_row_array_literal_store");
    builder.depend(Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(linux_arm64::ProgramEntry, Main::main);
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
}
