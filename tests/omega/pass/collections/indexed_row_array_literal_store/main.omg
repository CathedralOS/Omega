// An array literal assigned through an indexed destination is the same
// closed-literal store once per element: the destination's fixed or runtime
// index segment prefixes the leaf roster's literal indices, and the
// selector's bound re-proves from the same facts an element store uses.
// (Promoted: the stage-04 repair this pinned has landed and the fixture
// checks on the release bundle.)
//
//   main.grid[0] = [1, 2, 3]     checks (fixed index)
//   main.grid[i] = [10, 20, 30]  checks under `requires i <= 1` (runtime)
//
// Rows of structural elements ([Cell; N]) take the structural-value route
// instead: each element replaces its own window below the row's index
// (`case_array_literal_row_store_exit`).
use omega_language_std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
    grid: [[i32 in Wrapping; 3]; 2];
}
machine Main::main(main: &mut Main) reaches Console {
    main.grid[0] = [1, 2, 3];
    main.console.exit_process(7);
}
