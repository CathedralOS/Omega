// Owned record transport retains a stored view, not a copied backing array.
data Window { padding: u64; values: &[i32]; }

machine observe(window: Window, position: u64) -> i32 {
    transition position < window.values.len {
        true -> selected(window, position)
        false -> 0
    }
    machine selected(window: Window, position: u64) -> i32
    requires position < window.values.len
    {
        window.values[position]
    }
}

machine main() crashes Trap {
    let values: [i32; 4] = [11, 19, 42, 31];
    let window: Window = Window { padding: 73, values: &values[1..3] };
    let observed: i32 = observe(window, 1);
    transition observed == 42 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
