data Cell [copy] {value:u32 in Wrapping;}
data Cursor {calls:u32 in Wrapping; trace:u32 in Wrapping;}
machine select(cursor:&mut Cursor,digit:u32 in Wrapping)->u64 ensures result < 2 {
 cursor.calls=cursor.calls+1;
 cursor.trace=cursor.trace*10+digit;
 0
}
machine keep(value:u32 in Wrapping)->u32 in Wrapping {value}
machine main() crashes Trap {
 let cells:[[Cell;2];2]=[[Cell{value:7},Cell{value:3}],[Cell{value:5},Cell{value:9}]];
 let mut cursor:Cursor=Cursor{calls:0,trace:0};
 let observed:u32 in Wrapping=keep(cells[select(&mut cursor,1)][select(&mut cursor,2)].value);
 transition observed==7 && cursor.calls==2 && cursor.trace==12 {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
