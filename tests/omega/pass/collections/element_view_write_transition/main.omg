use omega_language_std::console;

// Element view write across a named edge: `release` establishes an
// exclusive `&mut [i32]` view of the bag's cells and stores through it,
// then crosses an ordinary transition with the loan live. The state's
// operation custody must admit the view write — it observes through the
// view's loan and claims no root of its own.

data Bag {
    cells: [i32; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    release(&mut main.bag);

    transition {
        _ -> good(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }
}

machine release(bag: &mut Bag) {
    let cells: &mut [i32] = &mut bag.cells[..];
    cells[2] = 7;
    transition {
        _ -> done()
    }

    state done() {
    }
}
