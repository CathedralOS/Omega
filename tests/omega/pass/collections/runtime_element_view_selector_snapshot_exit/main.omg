data Grid { cells: [u32; 2]; }
data Cursor { index: i64; }

machine value(cursor: &mut Cursor) -> u32 {
    cursor.index = 0;
    42
}

machine store(bytes: &mut [u32], cursor: &mut Cursor) {
    transition cursor.index >= 0 && cursor.index < bytes.len {
        true -> at(bytes, cursor)
        _ -> done()
    }
    state at(bytes: &mut [u32], cursor: &mut Cursor)
    requires cursor.index >= 0 && cursor.index < bytes.len
    {
        bytes[cursor.index] = value(cursor);
        bytes[0] = 9;
    }
    state done() {}
}

machine main() crashes Trap {
    let mut grid: Grid;
    let mut cursor: Cursor = Cursor { index: 1 };
    let bytes: &mut [u32] = grid.cells.as_mut_slice();
    store(bytes, &mut cursor);
    transition grid.cells[1] == 42 && grid.cells[0] == 9 && cursor.index == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
