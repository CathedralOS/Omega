// A runtime-indexed read through a `&[u8; N]` reference: the parameter is a
// bounded byte view whose descriptor is a bare pointer, so its length is the
// static capacity rather than a stored word. `sum_from` walks the borrowed
// array across states, reading `bytes[index]` under `index < bytes.len`.
// 1 + 2 + ... + 8 = 36. `copy_into` copies all but the last byte through
// the same view into a mutable slice, whose sum is 28.
// Expected exit: 70.
use omega_language_std::console;

data Main {
    bytes: [u8; 8];
    copied: [u8; 8];
}

machine sum_from(bytes: &[u8; 8], index: u64, total: u64) -> u64 {
    transition index < bytes.len && index < 8 && total < 2048 {
        true -> add(bytes, index, total)
        _ -> (total)
    }

    state add(bytes: &[u8; 8], index: u64, total: u64) -> u64
    requires index < 8 && total < 2048
    {
        let byte: u8 = bytes[index];
        transition { _ -> sum_from(bytes, index + 1, total + (byte as u64)) }
    }
}

machine copy_into(bytes: &[u8; 8], out: &mut [u8]) {
    transition { _ -> step(bytes, out, 0) }

    state step(bytes: &[u8; 8], out: &mut [u8], index: u64) {
        transition {
            index < 7 && index < out.len -> put(bytes, out, index)
            _ -> done()
        }
    }

    state put(bytes: &[u8; 8], out: &mut [u8], index: u64)
    requires index < 7 && index < out.len
    {
        out[index] = bytes[index];
        transition { _ -> step(bytes, out, index + 1) }
    }

    state done() { }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[0] = 1;
    main.bytes[1] = 2;
    main.bytes[2] = 3;
    main.bytes[3] = 4;
    main.bytes[4] = 5;
    main.bytes[5] = 6;
    main.bytes[6] = 7;
    main.bytes[7] = 8;
    let total: u64 = sum_from(&main.bytes, 0, 0);
    copy_into(&main.bytes, &mut main.copied);
    let copied: u64 = sum_from(&main.copied, 0, 0);
    transition total == 36 && copied == 28 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
