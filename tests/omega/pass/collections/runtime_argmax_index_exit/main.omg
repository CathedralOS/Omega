// argmax: find the INDEX of the maximum element (not the value -- array_max
// already covers the value). The distinguishing move is a conditional INDEX
// CAPTURE: when a new maximum is seen, record the current loop index. Over
// [4, 15, 8, 42, 16, 23] the maximum 42 sits at index 3 (neither first nor last,
// so an off-by-one or a "keep the last index" bug is caught). Exits 70 only when
// best_idx == 3.
use omega_language_std::console;
use omega::language::core::binding;
data Main where 0 <= i, i <= 6, 0 <= best_idx, best_idx <= 6 {
    console: Binding<Console>;
    arr: [i32; 6];
    i: i32;
    best_idx: i32;
    best_val: i32;
    cur: i32;
}
machine Main::main(&mut self) reaches Console {
    self.arr[0] = 4;
    self.arr[1] = 15;
    self.arr[2] = 8;
    self.arr[3] = 42;
    self.arr[4] = 16;
    self.arr[5] = 23;
    self.i = 0;
    self.best_idx = 0;
    self.best_val = 0;

    transition {
        _ -> step(&mut self)
    }

    state step(main: &mut Main) {
        transition main.i < 6 {
            true -> body(main)
            _ -> done(main)
        }
    }
    state body(main: &mut Main) {
        main.cur = main.arr[main.i];
        transition main.cur > main.best_val {
            true -> keep(main)
            _ -> advance(main)
        }
    }
    // New maximum: capture BOTH its value and its index.
    state keep(main: &mut Main) {
        main.best_val = main.cur;
        main.best_idx = main.i;
        transition {
            _ -> advance(main)
        }
    }
    // Re-guard before the increment so `i + 1` stays provably in [0..=6].
    state advance(main: &mut Main) {
        transition main.i < 6 {
            true -> bump(main)
            _ -> step(main)
        }
    }
    state bump(main: &mut Main) {
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }
    state done(main: &mut Main) {
        transition main.best_idx == 3 {
            true -> ok(main)
            false -> bad(main)
        }
    }
    state ok(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
