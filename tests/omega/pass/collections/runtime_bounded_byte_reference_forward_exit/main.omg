// Received `&[u8; N]` and `&mut [u8; N]` loans forwarded whole to further
// calls. Such a parameter is a bounded byte view: its carrier is one pointer
// cell, and its extent is the static capacity. `fill_from` recurses through
// its entry, forwarding the exclusive loan it received and writing through
// `put` at each step; `sum_from` forwards the shared loan the same way. The
// caller then reads the bytes back: 1 + 2 + ... + 8 = 36, and byte 7 is 8.
// Expected exit: 70.
use omega_language_std::console;

data Main {
    bytes: [u8; 8];
}

machine put(bytes: &mut [u8; 8], index: u64) {
    transition index < 8 {
        true -> write(bytes, index)
        _ -> done()
    }

    state write(bytes: &mut [u8; 8], index: u64) {
        bytes[index] = narrow_index(index);
        transition { _ -> done() }
    }

    state done() { }
}

machine narrow_index(index: u64) -> u8 {
    transition index < 255 {
        true -> (index as u8 + 1)
        _ -> (0)
    }
}

machine fill_from(bytes: &mut [u8; 8], index: u64, limit: u64)
terminates by (index, limit) -> Nat::BoundedDistance;
{
    put(bytes, index);
    transition index < limit {
        true -> fill_from(bytes, index + 1, limit)
        _ -> done()
    }

    state done() { }
}

machine sum_from(bytes: &[u8; 8], index: u64, limit: u64, total: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance;
{
    let next: u64 = add_byte(bytes, index, total);
    transition index < limit {
        true -> sum_from(bytes, index + 1, limit, next)
        _ -> (total)
    }
}

// `total` plus byte `index` of the shared loan, capped so the sum stays exact.
machine add_byte(bytes: &[u8; 8], index: u64, total: u64) -> u64 {
    transition index < 8 && total < 4096 {
        true -> add(bytes, index, total)
        _ -> (total)
    }

    state add(bytes: &[u8; 8], index: u64, total: u64) -> u64
    requires index < 8 && total < 4096
    {
        let byte: u8 = bytes[index];
        total + (byte as u64)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    fill_from(&mut main.bytes, 0, 8);
    let total: u64 = sum_from(&main.bytes, 0, 8, 0);
    transition total == 36 && main.bytes[7] == 8 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
