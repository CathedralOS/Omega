// A runtime-indexed element read inside a conditional successor argument.
// `k` is the `dot` state's own scalar parameter, but each arm of the
// conditional transition evaluates its successor arguments in its own arm
// block, which the state's block dominates. The element reads carry `k` as
// a `RuntimeIndex` selector defined in that dominating block: a flat
// `[i32 in Wrapping; 3]` element and a fixed row of a nested
// `[[i32 in Wrapping; 3]; 2]` field. The Wrapping policy stays on the
// element type, so the accumulator's `+` wraps.
//
//   flat    = [10, 20, 5]          -> 35
//   rows[1] = [1, 2, 32]           -> 35
//   exit    = 35 + 35              =  70
//
// Reduced from `samples/cli/collections/matrix_multiply`, whose `dot` state
// reads `self.a[i][k]` in the same successor-argument position.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    flat: [i32 in Wrapping; 3];
    rows: [[i32 in Wrapping; 3]; 2];
}

machine Main::main(&mut self) reaches Console {
    self.flat = [10, 20, 5];
    self.rows = [[0, 0, 0], [1, 2, 32]];
    transition { _ -> dot(0, 0) }
    state dot(&mut self, k: u64, acc: i32 in Wrapping) requires k <= 2 {
        let next_k: u64 = k + 1;
        transition next_k <= 2 {
            true -> dot(next_k, acc + self.flat[k] + self.rows[1][k])
            false -> done(acc + self.flat[k] + self.rows[1][k])
        }
    }
    state done(&mut self, acc: i32 in Wrapping) {
        self.console.exit_process(acc as i32);
    }
}
