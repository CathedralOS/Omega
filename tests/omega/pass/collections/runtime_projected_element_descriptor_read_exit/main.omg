// A stored descriptor's field position must not change its live window.
data Cell { padding: u64; value: i32; active: bool; }
data Window { marker: u64; cells: &[Cell]; }
data Envelope { marker: u64; window: Window; }

machine read(envelope: &Envelope, position: u64) -> i32
{
    transition position < envelope.window.cells.len {
        true -> at(envelope, position)
        false -> 0
    }
    machine at(envelope: &Envelope, position: u64) -> i32
    requires position < envelope.window.cells.len
    {
        envelope.window.cells[position].value
    }
}

machine main() crashes Trap {
    let mut cells: [Cell; 4];
    cells[2].value = 42;
    cells[2].active = true;
    let envelope: Envelope = Envelope {
        marker: 17,
        window: Window { marker: 31, cells: &cells[1..3] }
    };
    transition envelope.window.cells.len > 1 {
        true -> inspect(&envelope)
        false -> bad()
    }
    machine inspect(envelope: &Envelope)
    requires envelope.window.cells.len > 1
    {
        let observed: i32 = read(envelope, 1);
        transition observed == 42 && envelope.window.cells[1].active {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
