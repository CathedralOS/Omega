use omega_language_std::console;
use omega::language::core::binding;

// Copy the entire qualified record through a slice, including a bounded byte
// field and an enum. The source and the unselected destination stay intact.
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Tag [copy] { case First; case Second; }
data Cell [copy] { label: [u8; 8] in Utf8; tag: Tag; value: u64; }
data Bag { cells: [Cell; 2]; }
data Main { console: Binding<Console>; source: Bag; destination: Bag; }

machine copy_selected(source: &Bag, destination: &mut Bag) {
    let input: &[Cell] = source.cells.as_slice();
    let output: &mut [Cell] = destination.cells.as_mut_slice();
    output[0] = input[1];
}

machine initialize(cell: &mut Cell, tag: Tag, value: u64) {
    cell.tag = tag;
    cell.value = value;
}

machine Main::main(&mut self) reaches Console {
    self.source.cells[0].label = "first";
    self.source.cells[1].label = "second";
    self.destination.cells[1].label = "kept";
    initialize(&mut self.source.cells[0], Tag::First, 11);
    initialize(&mut self.source.cells[1], Tag::Second, 39);
    initialize(&mut self.destination.cells[1], Tag::First, 31);
    copy_selected(&self.source, &mut self.destination);
    transition self.destination.cells[0].value == 39
        && self.destination.cells[0].label == "second"
        && self.destination.cells[0].tag == Tag::Second
        && self.destination.cells[1].value == 31
        && self.destination.cells[1].label == "kept"
        && self.destination.cells[1].tag == Tag::First
        && self.source.cells[0].value == 11
        && self.source.cells[0].label == "first"
        && self.source.cells[1].value == 39
        && self.source.cells[1].label == "second"
        && self.source.cells[1].tag == Tag::Second {
        true -> finish(70)
        false -> finish(1)
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
