use omega_language_std::console;

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    Main::fill_literal(&mut main.bag);
    Main::fill_local(&mut main.bag);
    Main::fill_param(&mut main.bag, 3);
    transition
        main.bag.cells[2].value == 7
            && main.bag.cells[1].value == 5
            && main.bag.cells[3].value == 9
    {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(90);
    }
}

machine Main::fill_literal(bag: &mut Bag) {
    let cells: &mut [Cell] = &mut bag.cells[..];
    let cell: &mut Cell = &mut cells[2];
    cell.value = 7;
    transition {
        _ -> done()
    }

    state done() {
    }
}

machine Main::fill_local(bag: &mut Bag) {
    let cells: &mut [Cell] = &mut bag.cells[..];
    let pick: i32 = 1;
    let other: &mut Cell = &mut cells[pick];
    other.value = 5;
    transition {
        _ -> done()
    }

    state done() {
    }
}

machine Main::fill_param(bag: &mut Bag, at: u64) requires at < 4 {
    let cells: &mut [Cell] = &mut bag.cells[..];
    let target: &mut Cell = &mut cells[at];
    target.value = 9;
    transition {
        _ -> done()
    }

    state done() {
    }
}
