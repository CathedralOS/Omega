// An indexed write through a local proves its bound the same way a read does.
// `top` is `depth - 1` behind the guard `depth > 0`, and the data `where`
// bounds `depth` by 4, so `items[top]` is in range for both the store and the
// load. Exits 70 when the written top is read back as the last pushed value.
use omega_language_std::console;

data Stack
where
    depth <= 4,
{
    items: [u64; 4];
    depth: u64;
}

data Main {
    stack: Stack;
}

machine Stack::push(stack: &mut Stack, value: u64)
crashes Trap
{
    transition stack.depth < 4 {
        true -> store(stack, value)
        _ -> full()
    }

    state store(stack: &mut Stack, value: u64) {
        stack.items[stack.depth] = value;
        stack.depth = stack.depth + 1;
    }

    state full() {
        crash Trap;
    }
}

machine Stack::replace_top(stack: &mut Stack, value: u64)
crashes Trap
{
    transition stack.depth > 0 {
        true -> write(stack, value)
        _ -> empty()
    }

    state write(stack: &mut Stack, value: u64) {
        let top: u64 = stack.depth - 1;
        stack.items[top] = value;
    }

    state empty() {
        crash Trap;
    }
}

machine Stack::top(stack: &Stack) -> u64
crashes Trap
{
    transition stack.depth > 0 {
        true -> read(stack)
        _ -> empty()
    }

    state read(stack: &Stack) -> u64 {
        let top: u64 = stack.depth - 1;
        stack.items[top]
    }

    state empty() -> u64 {
        crash Trap;
    }
}

machine Main::main(main: &mut Main) reaches Console
crashes Trap
{
    Stack::push(&mut main.stack, 3);
    Stack::push(&mut main.stack, 5);
    Stack::replace_top(&mut main.stack, 70);
    let top: u64 = Stack::top(&main.stack);
    transition top == 70 {
        true -> ok(main)
        _ -> bad(main)
    }

    state ok(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
