// Expected exit: 0
use omega::language::core::float_operations;
use omega_language_std::console;

data Storage { cells: [[[f64; 2]; 2]; 2]; }
data Row { cells: [f64; 2]; }
data Group { rows: [Row; 2]; }
data Selector { index: u64; }
data Main { }

machine read(storage: &Storage, layer: u64, row: u64, column: u64) -> f64
requires layer <= 1 requires row <= 1 requires column <= 1 {
    storage.cells[layer][row][column]
}

machine identity(value: u64) -> u64 ensures result == value { value }

machine read_parameter(cells: &[[[f64; 2]; 2]; 2], layer: u64, row: u64, column: u64) -> f64
requires layer <= 1 requires row <= 1 requires column <= 1 {
    cells[layer][row][column]
}

machine returned_collection() -> [[[f64; 2]; 2]; 2] {
    [[[11.0, 12.0], [13.0, 14.0]], [[15.0, 47.0], [17.0, 18.0]]]
}

machine Main::main(main: &mut Main) reaches Console {
    let mut storage: Storage;
    storage.cells[1][0][1] = 41.0;
    let selector: Selector = Selector { index: 1 };
    let local: u64 = 0;
    let observed: f64 = read(&storage, selector.index, local, identity(1));
    let parameter_observed: f64 = read_parameter(&storage.cells, selector.index, local, identity(1));
    let mut groups: [Group; 2];
    groups[1].rows[0].cells[1] = 43.0;
    let local_observed: f64 = groups[selector.index].rows[local].cells[identity(1)];
    let returned: [[[f64; 2]; 2]; 2] = returned_collection();
    let returned_observed: f64 = returned[selector.index][local][identity(1)];
    let call_observed: f64 = returned_collection()[selector.index][local][identity(1)];
    transition observed == 41.0 && parameter_observed == 41.0
        && local_observed == 43.0 && returned_observed == 47.0 && call_observed == 47.0 {
        true -> done(main)
        _ -> bad(main)
    }
    state done(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(4); }
}
