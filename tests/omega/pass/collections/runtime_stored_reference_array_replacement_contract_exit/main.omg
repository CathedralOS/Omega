// Expected exit: 0
machine observe(windows: [&mut [u8]; 1], saved: u64) -> bool
requires windows[0].len == 0 && saved == 1
{
    windows[0].len == 0 && saved == 1
}
machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let mut incoming: [u8; 1] = [23];
    let mut windows: [&mut [u8]; 1] = [&mut backing[..]];
    let saved: u64 = windows[0].len;
    windows[0] = &mut incoming[0..0];
    let observed: bool = observe(windows, saved);
    transition observed { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
