// A whole case-array literal stored by a single-state callee (`Main::fill`):
// the ordinary machine body plans the same element establishments and window
// pairs a state graph does, and the caller reads the stored element: exit 7.
use omega_language_std::console;
data Cell {
    case Wall;
    case Floor;
    case Door;
}
data Main {
    grid: [Cell; 3];
}
machine Main::main(main: &mut Main) reaches Console {
    Main::fill(main);
    transition main.grid[1] {
        Cell::Door -> finish(main, 7)
        _ -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
machine Main::fill(main: &mut Main) {
    main.grid = [Cell::Floor, Cell::Door, Cell::Wall];
}
