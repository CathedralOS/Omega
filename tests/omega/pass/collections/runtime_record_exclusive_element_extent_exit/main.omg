data Bucket { items: &mut [u32]; }
machine observe(bucket: &mut Bucket) -> u64 { bucket.items.len }
machine main() crashes Trap {
    let mut values: [u32; 3];
    let mut bucket: Bucket = Bucket { items: &mut values[0..3] };
    let extent: u64 = observe(&mut bucket);
    transition extent == 3 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
