// IEEE fields of a RUNTIME-selected record element compared against
// literals: `main.probes[k].reading == 18.5` drives a transition guard and
// `main.probes[k].scale` is kept in an `f32` local and compared in the
// successor, where `k` is the scanning state's own scalar parameter,
// advanced by one per loop step. Each read is one Terminal
// `PrimitiveScalarRead` whose path is `probes`, `RuntimeIndex`, then the
// plain IEEE field, observed in its exact format at the field's declared
// offset plus `k` times the element stride. Only observation and comparison
// are exercised, no float arithmetic.
//
//   element    tag  reading  scale
//   probes[0]   1    20.5    0.25
//   probes[1]   2    18.5    4.0
//   probes[2]   3    18.5    1.5   <- first reading 18.5 with scale < 2
//   probes[3]   4    24.5    1.5
//
// Elements 1 and 2 share `reading`, and elements 2 and 3 share `scale`, so
// only element 2 passes both comparisons. Reading a wrong element, field,
// format or stride stops elsewhere (exit 71) or nowhere (exit 72). Stopping
// at element 2 -> exit 70.
use omega::language::core::float_operations;
use omega_language_std::console;

data Probe {
    tag: u8;
    reading: f64;
    scale: f32;
}

data Main {
    probes: [Probe; 4];
}

machine Main::main(main: &mut Main) reaches Console {
    main.probes[0].tag = 1;
    main.probes[0].reading = 20.5;
    main.probes[0].scale = 0.25;
    main.probes[1].tag = 2;
    main.probes[1].reading = 18.5;
    main.probes[1].scale = 4.0;
    main.probes[2].tag = 3;
    main.probes[2].reading = 18.5;
    main.probes[2].scale = 1.5;
    main.probes[3].tag = 4;
    main.probes[3].reading = 24.5;
    main.probes[3].scale = 1.5;
    transition { _ -> inspect(main, 0) }

    state inspect(main: &mut Main, k: u64) requires k <= 3 {
        let scale: f32 = main.probes[k].scale;
        transition main.probes[k].reading == 18.5 {
            true -> confirm(main, k, scale)
            false -> advance(main, k)
        }
    }

    state confirm(main: &mut Main, k: u64, scale: f32) requires k <= 3 {
        transition scale < 2.0 {
            true -> found(main, k)
            false -> advance(main, k)
        }
    }

    state advance(main: &mut Main, k: u64) requires k <= 3 {
        transition k < 3 {
            true -> inspect(main, k + 1)
            false -> finish(main, 72)
        }
    }

    state found(main: &mut Main, k: u64) {
        transition k == 2 {
            true -> finish(main, 70)
            false -> finish(main, 71)
        }
    }

    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
