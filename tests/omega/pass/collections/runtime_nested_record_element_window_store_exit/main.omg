data Cell where value >= 0 && value <= 9 { value: i32; }
data Slot { child: Cell; scores: [i32; 2]; tag: u32; }
data Grid { slots: [Slot; 3]; }

machine replace(slots: &mut [Slot]) -> i32
requires slots.len >= 2
{
    slots[1].child.value = 7;
    slots[1].scores[1] = 23;
    slots[1].child.value
}

machine main() crashes Trap {
    let mut grid: Grid;
    let slots: &mut [Slot] = grid.slots.as_mut_slice();
    let window: &mut [Slot] = slots[1..3];
    let observed: i32 = replace(window);
    transition observed == 7 && grid.slots[2].child.value == 7
        && grid.slots[0].child.value == 0 && grid.slots[1].child.value == 0
        && grid.slots[2].scores[1] == 23 && grid.slots[2].scores[0] == 0
        && grid.slots[0].scores[1] == 0 && grid.slots[2].tag == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
