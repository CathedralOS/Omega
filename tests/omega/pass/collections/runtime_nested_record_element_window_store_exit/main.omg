data Cell where value >= 0 && value <= 9 { value: i32; }
data Slot { child: Cell; scores: [i32; 2]; active: bool; tag: u32; }
data Grid { slots: [Slot; 3]; }
data Envelope { items: &[Slot]; }

machine inspect(envelopes: &[Envelope]) -> i32 {
    transition envelopes.len >= 2 && envelopes[0].items.len >= 2
        && envelopes[1].items.len >= 2 {
        true -> selected(envelopes[0].items[1].child.value,
            envelopes[1].items[1].child.value,
            envelopes[1].items[1].scores[1], envelopes[1].items[1].active)
        _ -> (0)
    }
    machine selected(first: i32, second: i32, score: i32, active: bool) -> i32 {
        transition first == 0 && score == 23 && active {
            true -> (second)
            _ -> (0)
        }
    }
}

machine replace(slots: &mut [Slot]) -> i32
requires slots.len >= 2
{
    slots[1].child.value = 7;
    slots[1].scores[1] = 23;
    slots[1].active = true;
    let observed: i32 = slots[1].child.value;
    let score: i32 = slots[1].scores[1];
    let active: bool = slots[1].active;
    transition active && score == 23 {
        true -> (observed)
        _ -> (0)
    }
}

machine main() crashes Trap {
    let mut grid: Grid;
    let slots: &mut [Slot] = &mut grid.slots[..];
    let window: &mut [Slot] = &mut slots[1..3];
    let observed: i32 = replace(window);
    let backing: &[Slot] = &grid.slots[..];
    let first: &[Slot] = backing[0..2];
    let second: &[Slot] = backing[1..3];
    let envelopes: [Envelope; 2] = [Envelope { items: first }, Envelope { items: second }];
    let descriptors: &[Envelope] = &envelopes[..];
    let nested: i32 = inspect(descriptors);
    let empty: &[Envelope] = descriptors[0..0];
    let skipped: i32 = inspect(empty);
    transition observed == 7 && nested == 7 && grid.slots[2].child.value == 7
        && grid.slots[0].child.value == 0 && grid.slots[1].child.value == 0
        && grid.slots[2].scores[1] == 23 && grid.slots[2].scores[0] == 0
        && grid.slots[0].scores[1] == 0 && grid.slots[2].active
        && !grid.slots[0].active && !grid.slots[1].active
        && grid.slots[2].tag == 0 && skipped == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
