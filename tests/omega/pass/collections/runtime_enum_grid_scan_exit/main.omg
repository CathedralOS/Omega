// Scanning an array of enums (a tile grid) by runtime index and matching each cell DIRECTLY:
// `transition self.grid[self.i] { Cell::Wall -> .. }` -- no local bind. A direct runtime-indexed
// enum-array match subject USED to silently take the first arm (the indexed-guard-subject
// miscompile), so this required reading into `self.c` first. It is now fixed at the frontend: the
// per-arm `When(grid[i] is Variant)` guards share one syntax subject handle, so the lowering hoists
// that subject into a SINGLE `let __hoist = self.grid[self.i]` (keyed on the shared handle) that all
// arms test -- exhaustiveness still groups the arms, and the compare reads the right element. This
// locks the direct form. grid = [Wall, Door, Floor, Door, Wall] -> 2 Doors. Exits 70 iff the scan
// counts 2. Differential (native must match the interpreter).
use omega::language::std::console;

data Cell {
    case Wall;
    case Floor;
    case Door;
}

data Main {
    console: Console;
    grid: [Cell; 5];
    i: u32 in Wrapping;
    doors: i32 in Wrapping;
}

machine Main::main(&mut self) {
    self.grid[0] = Cell::Wall;
    self.grid[1] = Cell::Door;
    self.grid[2] = Cell::Floor;
    self.grid[3] = Cell::Door;
    self.grid[4] = Cell::Wall;
    self.i = 0;
    self.doors = 0;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.i < 5 {
            true -> read()
            _ -> check()
        }
    }
    state read(&mut self) {
        // Direct runtime-indexed enum-array MATCH subject -- no local bind.
        transition self.grid[self.i] {
            Cell::Door -> count()
            Cell::Wall -> next()
            Cell::Floor -> next()
        }
    }
    state count(&mut self) {
        self.doors = self.doors + 1;
        transition { _ -> next() }
    }
    state next(&mut self) {
        self.i = self.i + 1;
        transition { _ -> step() }
    }
    state check(&mut self) {
        transition self.doors == 2 {
            true -> ok()
            _ -> bad()
        }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(self.doors as i32); }
}
