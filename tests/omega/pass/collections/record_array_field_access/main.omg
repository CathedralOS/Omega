domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
data CellId {
    case Empty;
    case A1;
    case A2;
}

data Exit {
    command: &[u8] in Utf8;
    destination: CellId;
}

data Room {
    cell: CellId;
    label: &[u8] in Utf8;
    description: &[u8] in Utf8;
    exits: [Exit; 2];
}

data Main {
    console: Console;
    room: Room;
    selected_exit: Exit;
}

machine Main::result_code(&mut self) -> i32 {
    self.room.cell = CellId::A1;
    self.room.label = "A1";
    self.room.description = "A1: a stone entry.";
    self.room.exits[0] = Exit { command: "north", destination: CellId::A2 };
    self.room.exits[1] = Exit { command: "wait", destination: CellId::Empty };
    self.selected_exit = self.room.exits[0];

    self.console.write_line(self.room.label);
    self.console.write_line(self.room.description);
    self.console.write_line(self.selected_exit.command);
    0
}

machine Main::main(&mut self) {
    let result: i32 = self.result_code();
    self.console.exit_process(result);
}
