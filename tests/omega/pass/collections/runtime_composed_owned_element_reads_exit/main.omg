data Cell { value: i32 in Wrapping; }
data Row {
    data: [i32 in Wrapping; 2];
    cells: [Cell; 2];
}

machine main() crashes Trap {
    let mut rows: [Row; 3];
    rows[2].data[1] = 70;
    rows[2].cells[1].value = 42;
    let row: u64 = 2;
    let column: u64 = 1;
    let observed: i32 in Wrapping = rows[row].data[column];
    // Arithmetic in the later selector emits operations before the read.
    // Its bound still belongs to the read, not that intervening arithmetic.
    let base: u64 = 0;
    let field_observed: i32 in Wrapping = rows[row].cells[base + 1].value;
    transition observed == 70 && field_observed == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
