// A runtime-indexed write whose value calls a machine: the value's scalar
// computation owns the call, and the write stores the computed result. One
// write goes through a `&mut [u8]` byte view and one through a `&mut [u32]`
// element view; `text/runtime_number_to_decimal_exit` covers a bounded byte
// field.
use omega_language_std::console;

data Main { bytes: [u8; 4]; words: [u32; 4]; }

machine digit(value: u32) -> u8
requires value < 10
{
    transition { _ -> (48 + value as u8) }
}

machine doubled(value: u32) -> u32
requires value < 1000
{
    transition { _ -> (value * 2) }
}

machine fill(bytes: &mut [u8], words: &mut [u32], index: u64) -> bool
requires index < bytes.len && index < words.len
{
    bytes[index] = digit(7);
    words[index] = doubled(21) + 1;
    transition { _ -> (true) }
}

machine Main::main(main: &mut Main) reaches Console {
    let bytes: &mut [u8] = &mut main.bytes[..];
    let words: &mut [u32] = &mut main.words[..];
    let filled: bool = fill(bytes, words, 2);
    transition main.bytes[2] == 55 && main.words[2] == 43 && main.bytes[1] == 0 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
