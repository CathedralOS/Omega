data Bucket { items: &[u32]; }
data Pair { left: Bucket; right: Bucket; }
machine observe(pair: &Pair) -> u64 {
    let first: u64 = pair.left.items.len;
    let second: u64 = pair.right.items.len;
    transition first == 2 && second == 5 {
        true -> result(0)
        false -> result(1)
    }
    state result(value: u64) -> u64 { value }
}
machine main() crashes Trap {
    let first: [u32; 2] = [10, 20];
    let second: [u32; 5] = [1, 2, 3, 4, 5];
    let first_view: &[u32] = first.as_slice();
    let second_view: &[u32] = second.as_slice();
    let pair: Pair = Pair { left: Bucket { items: first_view }, right: Bucket { items: second_view } };
    let outcome: u64 = observe(&pair);
    transition outcome == 0 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
