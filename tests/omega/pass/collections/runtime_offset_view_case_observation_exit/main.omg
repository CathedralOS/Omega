// Expected exit: 0. Tag reads traverse a view backing once, including an
// offset view forwarded through a machine argument.
data Tag [copy] { case Empty; case Set; }
data Row { tag: Tag; value: u64; }
data Main {}

machine selected(rows: &[Row], index: u64) -> bool
requires index < rows.len
{
    rows[index].tag == Tag::Set && rows[index].value == 42
}

machine Main::main(main: &mut Main) crashes Trap {
    let rows: [Row; 3] = [
        Row { tag: Tag::Empty, value: 7 },
        Row { tag: Tag::Empty, value: 19 },
        Row { tag: Tag::Set, value: 42 }
    ];
    let tail: &[Row] = &rows[1..3];
    transition selected(tail, 1) && !selected(tail, 0) {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
