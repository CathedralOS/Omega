// Compile canary: provider selection is part of the witnessed surface, so
// the build selects the canary worker provider and binds every hosted
// entry even though the driving test only reaches checked trees.

machine build(builder: &mut Build) {
    Build::application(builder, "blocking_executor_custody_claims_compile");
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
