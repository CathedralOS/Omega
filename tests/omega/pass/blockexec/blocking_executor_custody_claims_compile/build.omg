// Compile canary: provider selection is part of the witnessed surface, so
// the build selects the canary worker provider and binds every hosted
// entry even though the driving test only reaches checked trees.

machine build(builder: &mut Build) {
    Build::application(builder, "blocking_executor_custody_claims_compile");
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, linux_arm64);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, linux_x86_64);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, macos_arm64);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, macos_x86_64);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, windows_x86_64);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, uefi_x86_64);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, cross_platform_cli);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, local_unchecked);
    Build::select_provider<WorkerProvider, CanaryWorkerImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
