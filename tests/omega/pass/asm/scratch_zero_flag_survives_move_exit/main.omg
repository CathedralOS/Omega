machine main() crashes Trap {
 let mut output: u32 = 99;
 asm {
entry:
 mov eax, 1;
 sub eax, 1;
 mov eax, 7;
 jmp branch;
branch requires eax == 7:
 jnz wrong;
right requires eax == 7:
 mov output, eax;
 jmp finish;
wrong:
 mov output, 99;
finish:
 mov output, output
 }
 transition output == 7 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
