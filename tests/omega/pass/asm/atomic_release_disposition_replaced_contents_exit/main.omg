// Expected exit: 0. One release store completes one exact linear claim.
use omega::language::core::assembly_model;
data Cell { value: AtomicU64; }
data Ack [linear] { nonce: u64; }
boundary trait Completion {
 machine complete(ack: Ack, word: &mut Cell);
}
proposition acknowledged(ack: Ack, word: &mut Cell) = atomic_release_written<AtomicU64, u64>(&word.value, ack.nonce);
machine reset(word: &mut Cell) { word = Cell { value: 0 }; }
machine finish(ack: Ack, word: &mut Cell) satisfies Completion::complete
ensures acknowledged(ack, word);
{
 reset(word);
 word.value.store(ack.nonce, Publish);
}
CompletionProvider satisfies Completion { Completion::complete = finish; }
machine main() reaches Completion crashes Trap {
 let mut word: Cell;
 let ack: Ack = Ack { nonce: 37 };
 Completion::complete(ack, &mut word);
 let observed: u64 in Wrapping = word.value.load(Receive);
 transition observed == 37 { true -> done() false -> bad() }
 state done() {}
 state bad() { crash Trap; }
}
