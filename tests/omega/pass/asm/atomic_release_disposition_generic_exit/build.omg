machine build(builder: &mut Build) {
 Build::application(builder, "atomic_release_disposition_generic_exit");
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::select_provider<Completion, CompletionProvider>(builder, linux_arm64);
 Build::select_provider<Completion, CompletionProvider>(builder, linux_x86_64);
 Build::select_provider<Completion, CompletionProvider>(builder, macos_arm64);
 Build::select_provider<Completion, CompletionProvider>(builder, macos_x86_64);
 Build::select_provider<Completion, CompletionProvider>(builder, windows_x86_64);
 Build::select_provider<Completion, CompletionProvider>(builder, uefi_x86_64);
 Build::select_provider<Completion, CompletionProvider>(builder, cross_platform_cli);
 Build::select_provider<Completion, CompletionProvider>(builder, local_unchecked);
 Build::select_provider<Completion, CompletionProvider>(builder, alpha_bootstrap);
}
