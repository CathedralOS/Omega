// Compile-only privileged observation: its result carrier and control markers
// must preserve the independently established immutable address-model premise.
use omega::language::core::assembly;
data Geometry { base: addr; }
data Mapping { tables: Geometry; }
data Profile { control: u64; }
data Paging {}
machine Paging::supported(profile: &Profile) -> bool { profile.control != 0 }

uefi_x86_64 machine convert(mapping: &mut Mapping) -> u64
requires addr::Bound == 18446744073709551616
reaches MachineControl
{
    let mut control: u64 = 0;
    asm { read_cr0 control }
    let profile: Profile = Profile { control: control };
    let supported: bool = Paging::supported(&profile);
    mapping.tables.base as u64
}
