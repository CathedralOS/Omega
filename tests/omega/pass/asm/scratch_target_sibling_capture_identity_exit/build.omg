machine build(builder: &mut Build) {
    Build::select_provider<SelectedCountdown, LinuxX8664Countdown>(builder, linux_x86_64);
    Build::select_provider<SelectedCountdown, WindowsX8664Countdown>(builder, windows_x86_64);

 Build::application(builder, "checked_asm_countdown");
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
