// Expected exit: 0.
// The checked seed-2 mov/sub/jnz CFG falls through with eax == 0 and stores output == 0.
machine main() crashes Trap { SelectedCountdown::countdown(2); }
boundary trait SelectedCountdown {
    machine countdown(seed: u32) reaches
requires seed == 2 crashes Trap;
}
LinuxX8664Countdown satisfies SelectedCountdown {
    machine countdown(seed: u32) requires seed == 2 crashes Trap
{
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 0:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
}

WindowsX8664Countdown satisfies SelectedCountdown {
    machine countdown(seed: u32) requires seed == 2 crashes Trap
{
 let mut output: u32 = 99;
 let mut extra: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 0:
  mov output, eax;
  mov extra, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
}
