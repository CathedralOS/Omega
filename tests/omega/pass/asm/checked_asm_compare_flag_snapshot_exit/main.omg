// Expected exit: 0.
machine main() crashes Trap {
 let mut snapshot: u64 = 0;
 let mut preserved: u32 = 99;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 0;
  cmp eax, 1;
  pushfq snapshot;
  jmp observed;
 observed requires eax == 0 requires (snapshot & 2261u64) == 149u64:
  mov preserved, eax
 }
 transition preserved == 0 && (snapshot & 2261u64) == 149u64 {
  true -> finished()
  false -> failed()
 }
}
machine finished() {}
machine failed() crashes Trap { crash Trap; }
