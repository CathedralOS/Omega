machine main() crashes Trap {
 let mut output: u32 = 99;
 asm {
entry:
 mov eax, 1;
 sub eax, 1;
 mov ebx, 2;
 sub ebx, 1;
 jmp branch;
branch requires eax == 0 && ebx == 1:
 jnz right;
wrong:
 mov output, 99;
 jmp finish;
right:
 mov output, ebx;
finish:
 mov output, output
 }
 transition output == 1 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
