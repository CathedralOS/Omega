// Expected exit: 0. A register loaded from a mutable input keeps that snapshot
// across a conditional label edge after the input is written; the arrival
// contract reads the recorded snapshot, not the rewritten place.
machine main() crashes Trap {
    let mut input: u32 = 5;
    let mut output: u32 = 99;
    asm {
    entry:
        jmp branch;
    branch:
        mov eax, 1;
        sub eax, 1;
        mov eax, input;
        mov input, 7;
        jnz after;
    after requires eax == 5:
        mov output, eax
    }
    transition output == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}