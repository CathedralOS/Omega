data Cell { value: u32; }
machine main() crashes Trap {
 let mut values: [u32; 2] = [99, 99];
 let mut cell: Cell = Cell { value: 99 };
 asm {
 entry:
  mov eax, 2;
  sub eax, 1;
  mov values[0], eax;
  mov cell.value, eax
 }
 transition values[0] == 1 && values[1] == 99 && cell.value == 1 {
  true -> done()
  false -> bad()
 }
 machine done() {}
 machine bad() { crash Trap; }
}
