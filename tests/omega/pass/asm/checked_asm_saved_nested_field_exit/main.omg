    let mut output: Envelope = Envelope { inner: Holder { value: 0 } };
    asm where clobbers x0, nzcv {
    entry:
        mov w0, seed;
        cmp w0, w0;
        b.eq equal;
    different requires false:
        mov output.inner.value, 1;
        b done;
    equal requires w0 == 37:
        mov output.inner.value, w0;
    done requires output.inner.value == 37 ensures (match output { Envelope { inner } -> (match inner { Holder { value } -> value == 37 }) }):
        nop
    }
    output.inner.value
}

machine finished() {}
machine failed() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let value: u32 = compare(37);
    transition value == 37 { true -> finished() false -> failed() }
}
