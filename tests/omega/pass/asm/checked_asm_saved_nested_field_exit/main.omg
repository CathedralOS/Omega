data Holder { value: u32; }
data Envelope { inner: Holder; }
// Expected exit: 0.
// Comparing a register with itself establishes the zero flag without changing its value; both label edges preserve the original register.
linux_x86_64 machine compare(seed: u32) -> u32 requires seed == 37 ensures result == 37 {
    let mut output: Envelope = Envelope { inner: Holder { value: 0 } };
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        cmp eax, eax;
        jz equal;
    different requires false:
        mov output.inner.value, 1;
        jmp done;
    equal requires eax == 37:
        mov output.inner.value, eax;
    done requires output.inner.value == 37 ensures (match output { Envelope { inner } -> (match inner { Holder { value } -> value == 37 }) }):
        nop
    }
    output.inner.value
}

