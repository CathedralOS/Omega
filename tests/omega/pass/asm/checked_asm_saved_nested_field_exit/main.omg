    let mut output: Envelope = Envelope { inner: Holder { value: 0 } };
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        cmp eax, eax;
        jz equal;
    different requires false:
        mov output.inner.value, 1;
