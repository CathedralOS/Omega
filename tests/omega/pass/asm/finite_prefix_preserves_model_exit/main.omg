// Expected exit: 0. Executed stores and immutable model facts survive a
// reordered assembly window; skipped stores contribute no proof equations.
machine seven(value: u64) -> u64 requires value == 7 { value }

machine convert(address: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    let mut value: u64 = 99;
    asm {
    entry:
        jmp write;
    finish:
        mov value, value;
        jmp tail;
    skipped:
        mov value, 99;
    write:
        mov value, 7;
        jmp finish;
    tail:
        mov value, value
    }
    let checked: u64 = seven(value);
    let converted: u64 = address as u64;
    converted
}

machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let value: u64 = convert(35 as addr);
    transition value == 35 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
