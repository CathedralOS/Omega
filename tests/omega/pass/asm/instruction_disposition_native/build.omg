machine build(builder: &mut Build) {
    Build::application(builder, "instruction_disposition_native");
    builder.freestanding = true;
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, linux_arm64);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, linux_x86_64);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, macos_arm64);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, macos_x86_64);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, windows_x86_64);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, uefi_x86_64);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, cross_platform_cli);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, local_unchecked);
    Build::select_provider<FinishByChoice, ChoiceFinisher>(builder, alpha_bootstrap);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, linux_arm64);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, linux_x86_64);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, macos_arm64);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, macos_x86_64);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, windows_x86_64);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, uefi_x86_64);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, cross_platform_cli);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, local_unchecked);
    Build::select_provider<FinishEnvelope, EnvelopeFinisher>(builder, alpha_bootstrap);
    Build::select_provider<PairFinish, PairFinisher>(builder, linux_arm64);
    Build::select_provider<PairFinish, PairFinisher>(builder, linux_x86_64);
    Build::select_provider<PairFinish, PairFinisher>(builder, macos_arm64);
    Build::select_provider<PairFinish, PairFinisher>(builder, macos_x86_64);
    Build::select_provider<PairFinish, PairFinisher>(builder, windows_x86_64);
    Build::select_provider<PairFinish, PairFinisher>(builder, uefi_x86_64);
    Build::select_provider<PairFinish, PairFinisher>(builder, cross_platform_cli);
    Build::select_provider<PairFinish, PairFinisher>(builder, local_unchecked);
    Build::select_provider<PairFinish, PairFinisher>(builder, alpha_bootstrap);
    Build::select_provider<Finish, Finisher>(builder, linux_arm64);
    Build::select_provider<Finish, Finisher>(builder, linux_x86_64);
    Build::select_provider<Finish, Finisher>(builder, macos_arm64);
    Build::select_provider<Finish, Finisher>(builder, macos_x86_64);
    Build::select_provider<Finish, Finisher>(builder, windows_x86_64);
    Build::select_provider<Finish, Finisher>(builder, uefi_x86_64);
    Build::select_provider<Finish, Finisher>(builder, cross_platform_cli);
    Build::select_provider<Finish, Finisher>(builder, local_unchecked);
    Build::select_provider<Finish, Finisher>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
