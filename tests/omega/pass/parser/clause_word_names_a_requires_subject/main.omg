// Contract clause words are not reserved. A parameter carrying one of them is
// an ordinary subject of a `requires` or `ensures` proposition, in the first
// position and after a comma, and the real clauses that follow still parse.
machine bounded(
    terminates: u64, reaches: u64, effects: u64, invokes: u64, suspends: u64,
    blocks: u64, crashes: u64, boundary: u64, decreases: u64
) -> u64
    requires terminates <= 3, reaches < 3, effects <= 3, invokes <= 3, suspends <= 3
    requires blocks <= 3, crashes <= 3, boundary <= 4, decreases <= 3
    ensures boundary <= 4
    reaches none
    crashes none
    terminates
{
    boundary
}

machine main() {
    let observed: u64 = bounded(1, 1, 1, 1, 1, 1, 1, 4, 1);
}
