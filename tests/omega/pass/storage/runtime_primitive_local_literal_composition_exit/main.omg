// A primitive local and a byte literal retain distinct storage in one function.
use omega_language_std::console;

machine measure() -> u64 {
    let mut count: u64 = 1;
    let bytes: &[u8] = "abc";
    count = bytes.len;
    count
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let count: u64 = measure();
    transition count == 3 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
