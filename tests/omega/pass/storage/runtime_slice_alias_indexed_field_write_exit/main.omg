use omega_language_std::console;

data Exit {
    destination: u32;
}

data Room {
    exits: [Exit; 4];
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let room: Room = Room {
        exits: [
            Exit { destination: 0 },
            Exit { destination: 0 },
            Exit { destination: 0 },
            Exit { destination: 0 }
        ]
    };
    let exits: &mut [Exit] = room.exits.as_mut_slice();
    let index: u64 = 0;

    exits[index].destination = 1;

    transition room.exits[0].destination == 1 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(201);
    }

    state bad(&mut self) {
        self.console.exit_process(202);
    }
}
