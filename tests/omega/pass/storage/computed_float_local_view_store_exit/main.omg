use omega::language::core::float_operations;
data Values { values: [f64; 2]; }
machine main() crashes Trap {
 let mut values: Values = Values { values: [2.0, 7.0] };
 let view: &mut [f64] = &mut values.values[..];
 view[0] = view[1] - 1.0;
 transition view[0] == 6.0 && view[1] == 7.0 {
  true -> done()
  _ -> bad()
 }
 machine done() { }
 machine bad() { crash Trap; }
}
