// Two states that share one byte field through their own named data parameters.
//
// `fill` replaces the whole field and `stamp` writes one byte of it. Both reach
// the field through the data parameter their own state declares, so the two
// operations name two different places that denote one storage. Terminal
// validation admitted a byte field store only when its record root was the
// machine's own parameter, which a receiver gives every state and a named data
// parameter does not, so the store refused with
// `InvalidStructuralByteSequenceFieldStore`; the indexed write refused the same
// way with `InvalidStructuralByteSequenceFieldAccess`. The content facts the
// indexed write discharges against also had to follow the edge: the extent is
// observed where the field is filled, one state before it is used.
//
// Spelling every state `&mut self` compiled the identical program, which is
// what made this a blindness to the spelling rather than a permission.
//
// The field carries a domain because a plain `[u8; N]` field is a scalar array
// rather than a byte-sequence carrier, and only a carrier has a whole
// replacement and an extent. The sibling
// `forwarded_context_bounded_byte_field_exit` carries such a field without
// operating on it; this one operates on it from two states.
//
// Expected exit: 66.
use omega_language_std::console;

domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    label: [u8; 8] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    transition {
        _ -> fill(main)
    }

    state fill(main: &mut Main) {
        main.label = "abc";
        transition {
            _ -> stamp(main)
        }
    }

    state stamp(main: &mut Main) {
        main.label[0] = 66;
        transition {
            _ -> done(main)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(main.label[0] as i32);
    }
}
