// A caller-backed mutable view keeps one referent across two state transfers.
// The caller observes both writes and untouched sibling fields after return.
use omega_language_std::console;
use omega::language::core::binding;

data Counter { n: i32 in Wrapping; tag: i32; }
data Room { exits: [Counter; 2]; }

machine mutate(room: &mut Room) {
    let exits: &mut [Counter] = &mut room.exits[..];
    transition { _ -> first(exits) }
    state first(exits: &mut [Counter]) {
        let position: u64 = 0;
        exits[position].n = exits[position].n + 1;
        transition { _ -> second(exits) }
    }
    state second(exits: &mut [Counter]) {
        let position: u64 = 1;
        exits[position].n = exits[position].n + 2;
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let room: Room = Room {
        exits: [Counter { n: 10, tag: 31 }, Counter { n: 20, tag: 42 }]
    };
    mutate(&mut room);
    transition room.exits[0].n == 11 && room.exits[1].n == 22
        && room.exits[0].tag == 31 && room.exits[1].tag == 42 {
        true -> good(&main.console)
        _ -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
