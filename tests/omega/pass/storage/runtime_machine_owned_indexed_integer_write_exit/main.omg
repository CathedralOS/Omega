use omega_language_std::console;

data Room {
    exit_count: i32;
}

data Main {
    rooms: [Room; 2];
}

machine Main::main(main: &mut Main) reaches Console {
    let index: u64 = 1;
    main.rooms[index].exit_count = 7;

    let room_slice: &[Room] = &main.rooms[..];
    transition room_slice[index].exit_count == 7 {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &Main) {
        Console::exit_process(79);
    }

    machine bad(main: &Main) {
        Console::exit_process(80);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
