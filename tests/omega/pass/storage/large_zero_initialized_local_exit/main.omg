// A zero-initialized local (`let mut table: Table;`) whose home has more
// scalar leaves than a per-leaf store sequence should spell: two
// `[u8; 65536]` byte arrays plus `[Mark; 16384]` of a mixed record, about
// 180k leaves. The establishment must zero the whole home at runtime; one
// store per leaf would be megabytes of straight-line code, and the leaf
// enumeration refuses expansions this large.
//
// `Main::round` runs twice from the same caller, so both rounds place the
// table in the same stack bytes. Each round first reads cells through
// runtime indices and requires zero — an untouched `Mark` must dispatch as
// its first case (`Blank`, tag 0) with zero common fields — then writes
// those very cells and reads them back. A second round that skipped the
// establishment would observe the first round's writes instead of zero.
// Exit 70 on success; 71-76 name the failed observation.
use omega_language_std::console;

data Mark [copy] {
    start: u64;
    end: u32;
    case Blank;
    case Number(value: u32, negative: bool);
    case Word(length: u16);
}

data Table {
    head: [u8; 65536];
    tail: [u8; 65536];
    marks: [Mark; 16384];
    count: u64;
}

data Main where 0 <= low, low <= 16383, 0 <= high, high <= 16383 {
    low: u64;
    high: u64;
    rounds: u64 in Wrapping;
    failure: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.low = 9;
    main.high = 16383;
    Main::round(main);
    Main::round(main);
    transition main.failure == 0 && main.rounds == 2 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(main.failure); }
}

machine Main::round(main: &mut Main) {
    let mut table: Table;
    transition { _ -> untouched_bytes(main, &mut table) }

    state untouched_bytes(main: &mut Main, table: &mut Table) {
        transition table.head[main.high] == 0 && table.tail[main.low] == 0 && table.count == 0 {
            true -> untouched_mark(main, table)
            _ -> fail(main, 71)
        }
    }

    state untouched_mark(main: &mut Main, table: &mut Table) {
        let untouched: Mark = table.marks[main.high];
        transition untouched {
            Mark::Blank -> untouched_common(main, table, untouched.start, untouched.end)
            _ -> fail(main, 72)
        }
    }

    state untouched_common(main: &mut Main, table: &mut Table, start: u64, end: u32) {
        transition start == 0 && end == 0 {
            true -> write(main, table)
            _ -> fail(main, 73)
        }
    }

    state write(main: &mut Main, table: &mut Table) {
        table.head[main.high] = 41;
        table.tail[main.low] = 29;
        let mut mark: Mark = Mark::Number { value: 11, negative: true };
        mark.start = 3;
        mark.end = 5;
        table.marks[main.high] = mark;
        table.count = 1;
        transition { _ -> written(main, table) }
    }

    state written(main: &mut Main, table: &mut Table) {
        transition table.head[main.high] == 41 && table.tail[main.low] == 29
            && table.head[main.low] == 0 && table.count == 1 {
            true -> written_mark(main, table)
            _ -> fail(main, 74)
        }
    }

    state written_mark(main: &mut Main, table: &mut Table) {
        let written: Mark = table.marks[main.high];
        transition written {
            Mark::Number { value, negative } -> written_payload(main, value, negative, written.start, written.end)
            _ -> fail(main, 75)
        }
    }

    state written_payload(main: &mut Main, value: u32, negative: bool, start: u64, end: u32) {
        transition value == 11 && negative && start == 3 && end == 5 {
            true -> finished(main)
            _ -> fail(main, 76)
        }
    }

    state finished(main: &mut Main) { main.rounds = main.rounds + 1; }
    state fail(main: &mut Main, code: i32) { main.failure = code; }
}
