data Counter { hits: u32 in Wrapping; }

machine produce(counter: &mut Counter) -> u32 ensures result <= 4 {
    counter.hits = counter.hits + 1;
    3
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { hits: 0 };
    let mut value: u32 = produce(&mut counter);
    transition value == 3 && counter.hits == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
