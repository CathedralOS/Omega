use omega_language_std::console;

data Item [copy] {
    value: i32;
}

data Main {
    items: [Item; 2];
    copy: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    let index: u64 = 1;
    main.items[index].value = 23;
    main.copy = main.items[index];

    transition main.copy.value == 23 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(85);
    }

    state bad(main: &mut Main) {
        Console::exit_process(86);
    }
}
