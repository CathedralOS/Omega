use omega_language_std::console;
use omega::language::core::binding;

data Item [copy] {
    value: i32;
}

data Main {
    console: Binding<Console>;
    items: [Item; 2];
    copy: Item;
}

machine Main::main(&mut self) reaches Console {
    let index: u64 = 1;
    self.items[index].value = 23;
    self.copy = self.items[index];

    transition self.copy.value == 23 {
        true -> good(&mut self)
        false -> bad(&mut self)
    }

    state good(main: &mut Main) {
        main.console.exit_process(85);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(86);
    }
}
