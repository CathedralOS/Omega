// Read and store a domain-qualified byte field through a forwarded attached
// data loan.
//
// `pass/storage/forwarded_context_bounded_byte_field_exit` pins CARRYING such
// a field: declaring it no longer breaks the module. This pins operating on
// it, which is a separate admission -- a loan of the record grants its byte
// field nothing, and the read and the store are each validated on their own
// (`InvalidStructuralByteSequenceFieldAccess`,
// `InvalidStructuralByteSequenceFieldStore`). Only the samples exercised this,
// and the sample gates are not the corpus gate, so nothing here guarded it.
//
// The loop reads `main.text[main.i]`, shifts the byte in the modular domain
// byte arithmetic requires, and stores it into `main.out[main.i]` -- both
// sides through the same forwarded `main: &mut Main`, with the index proven by
// the counter's own monotonicity rather than an authored lower bound.
//
// "HELLO" shifted by 3 is "KHOOR"; the exit code is `out[0]`, 'K' = 75.
use omega_language_std::console;

domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    text: [u8; 5] in Utf8;
    out: [u8; 5] in Utf8;
    i: i32;
    ch: u8 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.text = "HELLO";
    main.out = ".....";
    main.i = 0;

    transition {
        _ -> step(main)
    }

    state step(main: &mut Main) {
        transition main.i < 5 {
            true -> shift(main)
            _ -> done(main)
        }
    }

    state shift(main: &mut Main) {
        main.ch = main.text[main.i] as u8 in Wrapping + 3;
        main.out[main.i] = main.ch as u8;
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(main.out[0] as i32);
    }
}
