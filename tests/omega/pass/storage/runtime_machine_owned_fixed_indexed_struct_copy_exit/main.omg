use omega_language_std::console;
use omega::language::core::binding;

data Item {
    value: i32;
}

data Main {
    console: Binding<Console>;
    items: [Item; 2];
    copy: Item;
}

machine Main::main(&mut self) reaches Console {
    self.items[0].value = 17;
    self.copy = self.items[0];

    transition self.copy.value == 17 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(83);
    }

    state bad(&mut self) {
        self.console.exit_process(84);
    }
}
