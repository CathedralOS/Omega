// A local mutable slice retains its local record backing across a state handoff.
// The successor mutates the original first element and observes the write.
// Exit 70 pins the descriptor, backing storage and exclusive-loan transfer.
use omega_language_std::console;
use omega::language::core::binding;
data Counter { n: i32 in Wrapping; }
data Room { exits: [Counter; 2]; }
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let room: Room = Room {
        exits: [ Counter { n: 10 }, Counter { n: 20 } ]
    };
    let exits: &mut [Counter] = room.exits.as_mut_slice();
    transition { _ -> bump_first(main, exits) }

    state bump_first(main: &mut Main, exits: &mut [Counter]) {
        let index: u64 = 0;
        exits[index].n = exits[index].n + 1;
        transition exits[index].n == 11 { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main)  { main.console.exit_process(71); }
}
