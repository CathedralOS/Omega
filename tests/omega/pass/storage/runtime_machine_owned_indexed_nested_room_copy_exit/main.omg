domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Exit {
    distance: i32;
}

data Event {
    reward: i32;
    consumed: bool;
}

data Room {
    description: &[u8] in Utf8;
    exit_count: i32;
    exits: [Exit; 2];
    event: Event;
}

data Main {
    console: Console;
    rooms: [Room; 2];
    copy: Room;
}

machine Main::main(&mut self) {
    let index: u64 = 1;
    self.rooms[index].description = "deep room";
    self.rooms[index].exit_count = 2;
    self.rooms[index].exits[0].distance = 9;
    self.rooms[index].exits[1].distance = 4;
    self.rooms[index].event.reward = 11;
    self.rooms[index].event.consumed = false;

    self.copy = self.rooms[index];

    let copied_desc: bool = self.copy.description == "deep room";
    let copied_count: bool = self.copy.exit_count == 2;
    let copied_exit_a: bool = self.copy.exits[0].distance == 9;
    let copied_exit_b: bool = self.copy.exits[1].distance == 4;
    let copied_reward: bool = self.copy.event.reward == 11;
    let copied_consumed: bool = self.copy.event.consumed == false;

    transition copied_desc && copied_count && copied_exit_a && copied_exit_b && copied_reward && copied_consumed {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(87);
    }

    state bad(&mut self) {
        self.console.exit_process(88);
    }
}