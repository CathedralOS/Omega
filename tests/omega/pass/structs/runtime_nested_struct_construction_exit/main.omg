// Regression: NESTED struct construction -- a struct literal whose field values are
// themselves struct literals, `Rect { top_left: Point { .. }, bottom_right: Point { .. } }`.
//
// This PANICKED the compiler (an arena "span append must be contiguous" assert):
// ExpressionTable::copy_struct_literal_fields appended the outer fields incrementally
// while copying each field value, but copying a struct-valued field appended the
// INNER struct's fields to the same arena mid-loop -- interleaving and breaking the
// outer span. Fixed by reserving the span first and setting each slot (interleave-
// safe). Field-by-field assignment was the workaround.
//
// Constructs a Rect from two Points, reads the nested fields, and computes the width
// and height -- all correct -> exit 70.

use omega_language_std::console;
use omega::language::core::binding;

data Point {
    x: i32 in Trapping;
    y: i32 in Trapping;
}

data Rect {
    top_left: Point;
    bottom_right: Point;
}

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console {
    let rectangle: Rect = Rect {
        top_left: Point { x: 2, y: 3 },
        bottom_right: Point { x: 12, y: 9 },
    };
    let width: i32 in Trapping = rectangle.bottom_right.x - rectangle.top_left.x;
    let height: i32 in Trapping = rectangle.bottom_right.y - rectangle.top_left.y;

    transition rectangle.top_left.y == 3 {
        true -> check_width(context, width, height)
        _ -> bad(context)
    }
    state check_width(context: &mut Main, width: i32 in Trapping, height: i32 in Trapping) {
        transition width == 10 { true -> check_height(context, height) _ -> bad(context) }
    }
    state check_height(context: &mut Main, height: i32 in Trapping) {
        transition height == 6 { true -> good(context) _ -> bad(context) }
    }
    state good(context: &mut Main) {
        context.console.exit_process(70);
    }
    state bad(context: &mut Main) {
        context.console.exit_process(71);
    }
}
