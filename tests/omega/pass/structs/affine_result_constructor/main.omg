use omega_language_std::console;

data Kind { case Other; case Missing; }
data Outcome { case Error(kind: Kind); case Ok; }
data Worker {}
data Main { }

machine Worker::kind() -> Kind { Kind::Missing }
machine Worker::wrap() -> Outcome {
    transition { _ -> finish() }
    machine finish() -> Outcome {
        let kind: Kind = Worker::kind();
        Outcome::Error { kind: kind }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let outcome: Outcome = Worker::wrap();
    transition outcome {
        Outcome::Error { kind } -> inspect(main, kind)
        _ -> failure(main)
    }
    machine inspect(main: &mut Main, kind: Kind) {
        transition kind {
            Kind::Missing -> success(main)
            _ -> failure(main)
        }
    }
    machine success(main: &mut Main) { Console::exit_process(70); }
    machine failure(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
