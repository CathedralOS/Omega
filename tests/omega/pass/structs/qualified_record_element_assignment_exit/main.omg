use omega_language_std::console;

domain [u8; 4]::Utf8(bytes) requires valid_utf8(bytes);
data Direction [copy] { case None; case East; }
data Cell [copy] { value: u64; }
data Exit [copy] {
    command: [u8; 4] in Utf8;
    direction: Direction;
    destination: Cell;
}
data Room { exits: [Exit; 2]; }
data Main { room: Room; command: [u8; 4] in Utf8; direction: Direction; }

machine Room::install(room: &mut Room, command: [u8; 4] in Utf8, direction: Direction, coordinate: u64) {
    transition { _ -> write(room, command, direction, coordinate) }
    state write(room: &mut Room, command: [u8; 4] in Utf8, direction: Direction, coordinate: u64) {
        room.exits[1] = Exit {
            command: command,
            direction: direction,
            destination: Cell { value: coordinate },
        };
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.room.exits[0].destination.value = 55;
    main.command = "east";
    main.direction = Direction::East;
    Room::install(&mut main.room, main.command, main.direction, 7);
    transition main.room.exits[1].command == "east"
        && main.room.exits[1].command.len == 4
        && main.room.exits[1].destination.value == 7
        && main.room.exits[0].destination.value == 55 {
        true -> verify_direction(main)
        false -> finish(main, 1)
    }
    state verify_direction(main: &mut Main) {
        transition main.room.exits[1].direction {
            Direction::East -> finish(main, 70)
            Direction::None -> finish(main, 2)
        }
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
