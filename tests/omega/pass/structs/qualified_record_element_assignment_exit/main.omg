use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Direction [copy] { case None; case East; }
data Cell [copy] { value: u64; }
data Exit [copy] {
    command: [u8; 8] in Utf8;
    direction: Direction;
    destination: Cell;
}
data Room { exits: [Exit; 2]; }
data Main { console: Binding<Console>; room: Room; command: [u8; 8] in Utf8; direction: Direction; }

machine Room::install(&mut self, command: [u8; 8] in Utf8, direction: Direction, coordinate: u64) {
    transition { _ -> write(command, direction, coordinate) }
    state write(&mut self, command: [u8; 8] in Utf8, direction: Direction, coordinate: u64) {
        self.exits[1] = Exit {
            command: command,
            direction: direction,
            destination: Cell { value: coordinate },
        };
    }
}

machine Main::main(&mut self) reaches Console {
    self.room.exits[0].destination.value = 55;
    self.command = "east";
    self.direction = Direction::East;
    self.room.install(self.command, self.direction, 7);
    transition self.room.exits[1].command == "east"
        && self.room.exits[1].command.len == 4
        && self.room.exits[1].destination.value == 7
        && self.room.exits[0].destination.value == 55 {
        true -> verify_direction()
        false -> finish(1)
    }
    state verify_direction(&mut self) {
        transition self.room.exits[1].direction {
            Direction::East -> finish(70)
            Direction::None -> finish(2)
        }
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
