// Case construction whose fields are more than one plain scalar payload,
// stored into a machine field directly and through a local, then observed.
// Each check machine covers one construction family; each failed observation
// exits with its own code, and 70 means every one held.
//
// Common fields beside case payloads (a mixed shape), `check_common_fields`:
//   1-8   a named common field keeps its value and an unnamed one reads zero;
//         the payload reads back from its overlay after the common fields; a
//         common field stores in place without case knowledge and leaves the
//         payload; a case replacement that names no common field zeroes them
//         all -- valid because zero satisfies their default domain; a
//         two-field payload reads back beside the common fields.
//   9-10  the payload-free case, bare and with a named common field.
// Closed-sum payload shapes, `check_closed_payloads`:
//   11-15 scalar, payload-free, two-field and record payloads.
// Local-mediated stores (`let v: T = T::Case { .. }; main.f = v;`),
// `check_local_stores`:
//   16-19 a mixed case, and closed scalar and two-field payloads.
// An erased payload member, `check_erased_member`:
//   20    construction supplies it from its unique nullary constructor and it
//         takes no runtime position, so the runtime payload beside it keeps
//         its value.
// An interval-domained payload member (`i32 in Ten`), `check_interval_member`:
//   21-23 construction proves the member's range obligation, directly and
//         through a local, and the dispatched payload discharges `scale`'s
//         requires through its domain alone.
//
// Separate causes keep their own fixtures: an out-of-range domained literal
// (`fail/ranges/case_payload_domain_literal_out_of_range`), a payload read
// under another case's guard (`fail/ranges/sum_payload_non_case_guard_unproven`),
// a non-interval predicate domain on a payload member
// (`pass/domains/case_payload_predicate_domain_member_exit`), and an
// interval-domained plain record member
// (`pass/domains/record_interval_domain_member_exit`).
use omega_language_std::console;

domain i32::Ten(value) requires 0 <= value && value <= 10;

data Evidence { case Only; }
data Point [copy] { x: i32; y: i32; }

data Event {
    consumed: bool;
    bonus: i32;
    case Nothing;
    case Treasure(gold: i32);
    case Fight(strength: i32, speed: i32);
}

data Command {
    case Off;
    case Dim(amount: i32);
    case Pair(low: i32, high: i32);
    case Place(at: Point);
}

data Certified {
    case Pending;
    case Proven(value: i32, proof [erased]: Evidence);
}

data Level {
    case Dark;
    case Lit(amount: i32 in Ten);
}

data Main {
    event: Event;
    command: Command;
    certified: Certified;
    level: Level;
}

machine Main::main(main: &mut Main) reaches Console {
    Main::check_common_fields(main);
    Main::check_closed_payloads(main);
    Main::check_local_stores(main);
    Main::check_erased_member(main);
    Main::check_interval_member(main);
    Console::exit_process(70);
}

machine Main::check_common_fields(main: &mut Main) reaches Console {
    main.event = Event::Treasure { consumed: true, gold: 50 };
    transition main.event.consumed {
        true -> unnamed_common_zero(main)
        false -> fail(main, 1)
    }

    state unnamed_common_zero(main: &mut Main) {
        transition main.event.bonus == 0 {
            true -> payload_beside_common(main)
            false -> fail(main, 2)
        }
    }

    state payload_beside_common(main: &mut Main) {
        transition main.event {
            Event::Treasure { gold } -> treasure_gold(main, gold)
            _ -> fail(main, 3)
        }
    }

    state treasure_gold(main: &mut Main, gold: i32) {
        transition gold == 50 {
            true -> store_common(main)
            false -> fail(main, 4)
        }
    }

    state store_common(main: &mut Main) {
        main.event.bonus = 9;
        transition main.event {
            Event::Treasure { gold } -> stored_common(main, gold)
            _ -> fail(main, 5)
        }
    }

    state stored_common(main: &mut Main, gold: i32) {
        transition gold == 50 && main.event.bonus == 9 && main.event.consumed {
            true -> replace_case(main)
            false -> fail(main, 6)
        }
    }

    // The replacement names no common field: both read zero afterwards.
    state replace_case(main: &mut Main) {
        main.event = Event::Fight { strength: 3, speed: 4 };
        transition main.event.bonus == 0 && !main.event.consumed {
            true -> fight_payload(main)
            false -> fail(main, 7)
        }
    }

    state fight_payload(main: &mut Main) {
        transition main.event {
            Event::Fight { strength, speed } -> fight_values(main, strength, speed)
            _ -> fail(main, 8)
        }
    }

    state fight_values(main: &mut Main, strength: i32, speed: i32) {
        transition strength == 3 && speed == 4 {
            true -> payload_free_bare(main)
            false -> fail(main, 8)
        }
    }

    state payload_free_bare(main: &mut Main) {
        main.event = Event::Nothing;
        transition main.event {
            Event::Nothing -> payload_free_named(main)
            _ -> fail(main, 9)
        }
    }

    state payload_free_named(main: &mut Main) {
        main.event = Event::Nothing { bonus: 12 };
        transition main.event {
            Event::Nothing -> payload_free_common(main, main.event.bonus)
            _ -> fail(main, 10)
        }
    }

    state payload_free_common(main: &mut Main, bonus: i32) {
        transition bonus == 12 {
            true -> done()
            false -> fail(main, 10)
        }
    }

    state done() {}
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::check_closed_payloads(main: &mut Main) reaches Console {
    main.command = Command::Dim { amount: 7 };
    transition main.command {
        Command::Dim { amount } -> scalar_value(main, amount)
        _ -> fail(main, 11)
    }

    state scalar_value(main: &mut Main, amount: i32) {
        transition amount == 7 {
            true -> payload_free(main)
            false -> fail(main, 11)
        }
    }

    state payload_free(main: &mut Main) {
        main.command = Command::Off;
        transition main.command {
            Command::Off -> multiple(main)
            _ -> fail(main, 12)
        }
    }

    state multiple(main: &mut Main) {
        main.command = Command::Pair { low: 1, high: 2 };
        transition main.command {
            Command::Pair { low, high } -> multiple_values(main, low, high)
            _ -> fail(main, 13)
        }
    }

    state multiple_values(main: &mut Main, low: i32, high: i32) {
        transition low == 1 && high == 2 {
            true -> record(main)
            false -> fail(main, 13)
        }
    }

    state record(main: &mut Main) {
        main.command = Command::Place { at: Point { x: 5, y: 6 } };
        transition main.command {
            Command::Place { at } -> record_values(main, at)
            _ -> fail(main, 14)
        }
    }

    state record_values(main: &mut Main, at: Point) {
        transition at.x == 5 && at.y == 6 {
            true -> done()
            false -> fail(main, 15)
        }
    }

    state done() {}
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::store_local_event(main: &mut Main) {
    let replacement: Event = Event::Treasure { consumed: true, bonus: 3, gold: 8 };
    main.event = replacement;
}

machine Main::store_local_dim(main: &mut Main) {
    let dimmed: Command = Command::Dim { amount: 21 };
    main.command = dimmed;
}

machine Main::store_local_pair(main: &mut Main) {
    let paired: Command = Command::Pair { low: 30, high: 40 };
    main.command = paired;
}

machine Main::store_local_level(main: &mut Main) {
    let lit: Level = Level::Lit { amount: 4 };
    main.level = lit;
}

machine Main::check_local_stores(main: &mut Main) reaches Console {
    Main::store_local_event(main);
    transition main.event {
        Event::Treasure { gold } -> mixed_values(main, gold)
        _ -> fail(main, 16)
    }

    state mixed_values(main: &mut Main, gold: i32) {
        transition gold == 8 && main.event.bonus == 3 && main.event.consumed {
            true -> closed_scalar(main)
            false -> fail(main, 17)
        }
    }

    state closed_scalar(main: &mut Main) {
        Main::store_local_dim(main);
        transition main.command {
            Command::Dim { amount } -> closed_value(main, amount)
            _ -> fail(main, 18)
        }
    }

    state closed_value(main: &mut Main, amount: i32) {
        transition amount == 21 {
            true -> closed_multiple(main)
            false -> fail(main, 18)
        }
    }

    state closed_multiple(main: &mut Main) {
        Main::store_local_pair(main);
        transition main.command {
            Command::Pair { low, high } -> multiple_values(main, low, high)
            _ -> fail(main, 19)
        }
    }

    state multiple_values(main: &mut Main, low: i32, high: i32) {
        transition low == 30 && high == 40 {
            true -> done()
            false -> fail(main, 19)
        }
    }

    state done() {}
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::check_erased_member(main: &mut Main) reaches Console {
    main.certified = Certified::Proven { value: 44 };
    transition main.certified {
        Certified::Proven { value, proof as _ } -> erased_value(main, value)
        Certified::Pending -> fail(main, 20)
    }

    state erased_value(main: &mut Main, value: i32) {
        transition value == 44 {
            true -> done()
            false -> fail(main, 20)
        }
    }

    state done() {}
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::check_interval_member(main: &mut Main) reaches Console {
    main.level = Level::Lit { amount: 7 };
    transition main.level {
        Level::Lit { amount } -> scale(main, amount)
        Level::Dark -> fail(main, 21)
    }

    // `amount` reaches `scale` through its payload domain alone: no guard
    // bounds it, so the requires is discharged by `Ten` membership.
    state scale(main: &mut Main, amount: i32) requires amount >= 0 && amount <= 10 {
        let scaled: i32 = amount * 10;
        transition scaled == 70 {
            true -> through_local(main)
            false -> fail(main, 22)
        }
    }

    state through_local(main: &mut Main) {
        Main::store_local_level(main);
        transition main.level {
            Level::Lit { amount } -> local_value(main, amount)
            Level::Dark -> fail(main, 23)
        }
    }

    state local_value(main: &mut Main, amount: i32) {
        transition amount == 4 {
            true -> done()
            false -> fail(main, 23)
        }
    }

    state done() {}
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
