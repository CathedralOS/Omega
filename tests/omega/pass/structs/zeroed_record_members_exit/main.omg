// Omitted zero-constructible members begin wholly zeroed: a record literal
// spells `count` only, leaving `pts` (an array of scalar-only records) and
// `inner` (a nested record) to EstablishZeroedStructural, and `tail` to the
// declared-type zero mint. Reads back one array element's leaf, a nested
// leaf, and a trailing member. Exits 70.

use omega_language_std::console;

data Point {
    x: i32 in Trapping;
    y: i32 in Trapping;
}

data Inner {
    code: i64 in Trapping;
    flag: bool;
}

data Bag {
    count: i32 in Trapping;
    pts: [Point; 2];
    inner: Inner;
    tail: u8;
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag = Bag { count: 2 };

    transition main.bag.pts[1].x == 0 { true -> check_inner(main) _ -> bad(main) }
    state check_inner(main: &mut Main) {
        transition main.bag.inner.code == 0 { true -> check_flag(main) _ -> bad(main) }
    }
    state check_flag(main: &mut Main) {
        transition main.bag.inner.flag == false { true -> check_tail(main) _ -> bad(main) }
    }
    state check_tail(main: &mut Main) {
        transition main.bag.tail == 0 { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
