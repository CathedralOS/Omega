// Completed view-bearing record elements retain both image-backed byte loans.
domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Tag { label: &[u8] in Utf8; weight: i32; }
data Envelope { elements: [Tag; 2]; }
data Main { console: Binding<Console>; }

machine Main::main(main: &mut Main) reaches Console {
    let left: Tag = Tag { label: "amulet", weight: 3 };
    let right: Tag = Tag { weight: 4, label: "ring" };
    let envelope: Envelope = Envelope { elements: [left, right] };
    transition envelope.elements[0].label == "amulet"
        && envelope.elements[0].weight == 3
        && envelope.elements[1].label == "ring"
        && envelope.elements[1].weight == 4 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
