// RUN CANARY (exit 70) + interpreter differential. DEEP-NESTING WRITE
// paths, each leg asserting the write LANDS and does NOT BLEED into ZII
// neighbors: (1) a struct-in-struct field write (`main.nested.second.b`)
// with the adjacent `a` still 0; (2) a SUM constructed into a struct field
// (`main.holder.msg = Msg::Pong { .. }`) destructured back through the
// nested path; (3) an array-of-struct ELEMENT field write (`main.pair[1].a`
// -- indexed + member combined) with the sibling element and sibling field
// both still 0. The offset math for these shapes (member-path accumulation,
// case_variant tagging at depth, element scaling + field offset) is where a
// layout regression corrupts adjacent storage first.
// exits: 71 = nested write wrong/bled; 72 = sum-in-struct dispatch wrong;
// 73 = nested sum payload wrong; 74 = element field write wrong/bled.
use omega_language_std::console;
data Msg { case Ping(x: i32); case Pong(y: i32, z: i32); }
data Inner { a: u32; b: u32; }
data Outer { first: Inner; second: Inner; }
data Holder { tag: u32; msg: Msg; }
data Main {
    nested: Outer;
    holder: Holder;
    pair: [Inner; 2];
}
machine Main::main(main: &mut Main) {
    Main::build(main);
}
machine Main::build(main: &mut Main) reaches Console {
    main.nested.second.b = 42;
    transition main.nested.second.b == 42 && main.nested.second.a == 0 {
        true -> leg2(main)
        _ -> wrong_nested_write(main)
    }
    state leg2(main: &mut Main) {
        main.holder.msg = Msg::Pong { y: 1, z: 2 };
        transition main.holder.msg {
            Msg::Pong { y, z } -> chk(main, y, z)
            _ -> wrong_sum_in_struct(main)
        }
    }
    state chk(main: &mut Main, y: i32, z: i32) {
        transition y == 1 && z == 2 {
            true -> leg3(main)
            _ -> wrong_sum_payload(main)
        }
    }
    state leg3(main: &mut Main) {
        main.pair[1].a = 7;
        transition main.pair[1].a == 7 && main.pair[0].a == 0 && main.pair[1].b == 0 {
            true -> good(main)
            _ -> wrong_elem_field(main)
        }
    }
    state good(main: &mut Main)               { Console::exit_process(70); }
    state wrong_nested_write(main: &mut Main) { Console::exit_process(71); }
    state wrong_sum_in_struct(main: &mut Main){ Console::exit_process(72); }
    state wrong_sum_payload(main: &mut Main)  { Console::exit_process(73); }
    state wrong_elem_field(main: &mut Main)   { Console::exit_process(74); }
}
