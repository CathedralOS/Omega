use omega::language::core::float_operations;
data Pair [copy] { lower: f64; upper: f64; selected: f64; }
data Narrow [copy] { selected: f32; }
machine choose(source: Pair, pick_lower: bool) -> Pair {
    let mut result: Pair;
    result.selected = match pick_lower { true -> (source.lower) false -> (source.upper) };
    result
}
machine compute(source: Pair, pick_lower: bool) -> Pair {
    let mut result: Pair;
    result.selected = match pick_lower { true -> (source.lower + 0.5) false -> (source.upper - 0.5) };
    result
}
machine replace(destination: &mut Pair, source: Pair, pick_lower: bool) {
    destination.selected = match pick_lower { true -> (source.lower) false -> (source.upper) };
}
machine narrow(pick_lower: bool) -> Narrow {
    let mut result: Narrow;
    result.selected = match pick_lower { true -> (1.25f32) false -> (2.5f32) };
    result
}
machine main() crashes Trap {
    let source: Pair = Pair { lower: -2.0, upper: 3.0, selected: 0.0 };
    let first: Pair = choose(source, true);
    let second: Pair = choose(source, false);
    let computed_first: Pair = compute(source, true);
    let computed_second: Pair = compute(source, false);
    let narrow_first: Narrow = narrow(true);
    let narrow_second: Narrow = narrow(false);
    let mut destination: Pair;
    replace(&mut destination, source, false);
    transition first.selected == -2.0 && second.selected == 3.0
        && computed_first.selected == -1.5 && computed_second.selected == 2.5
        && narrow_first.selected == 1.25f32 && narrow_second.selected == 2.5f32
        && destination.selected == 3.0 {
        true -> done()
        false -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
