// Wide elided member: a record literal spells `tag` only, leaving `wides` —
// an array of records each holding a [u64; 1024] scalar array — to
// EstablishZeroedStructural. The leaf walk must enumerate all 2048 scalar
// elements; a recursion guard that counts each element as a visited cell
// wrongly rejects the shape. Exits 70.

use omega_language_std::console;

data Wide {
    cells: [u64; 1024];
    count: u64;
}

data Bag {
    wides: [Wide; 2];
    tag: u8;
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag = Bag { tag: 7 };

    transition main.bag.wides[1].cells[1023] == 0 {
        true -> check_first(main) _ -> bad(main)
    }
    machine check_first(main: &mut Main) {
        transition main.bag.wides[0].cells[0] == 0 {
            true -> check_count(main) _ -> bad(main)
        }
    }
    machine check_count(main: &mut Main) {
        transition main.bag.wides[0].count == 0 && main.bag.tag == 7 {
            true -> good(main) _ -> bad(main)
        }
    }
    machine good(main: &mut Main) {
        Console::exit_process(70);
    }
    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
