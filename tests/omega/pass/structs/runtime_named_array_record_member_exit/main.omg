// A constructor consumes an ordinary array value, not just literal syntax.
// Its field observations must retain the supplied element order and values.
use omega_language_std::console;

data Packet { samples: [i32; 2]; }
data Main { packet: Packet; }

machine Main::main(context: &mut Main) reaches Console {
    let samples: [i32; 2] = [30, 40];
    context.packet = Packet { samples: samples };
    transition { _ -> inspect(context) }
    state inspect(context: &mut Main) {
        transition context.packet.samples[0] == 30 && context.packet.samples[1] == 40 {
            true -> finish(context, 70)
            false -> finish(context, 1)
        }
    }
    state finish(context: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
