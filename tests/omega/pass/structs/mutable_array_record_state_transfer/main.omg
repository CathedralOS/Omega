use omega_language_std::console;

data Cell { values: [i32; 2]; value: i32; }
data Worker {}
data Main { cell: Cell; }

// State transfer must retain the caller's storage, including its writes.
machine Worker::write(cell: &mut Cell) -> i32 {
    transition { _ -> step(cell, 0) }
    state step(cell: &mut Cell, position: u64) -> i32
    requires position <= 2;
    {
        transition position < 2 {
            true -> store(cell, position)
            false -> finish(cell)
        }
    }
    state store(cell: &mut Cell, position: u64) -> i32
    requires position < 2;
    {
        cell.values[position] = 70;
        cell.value = cell.values[position];
        transition { _ -> step(cell, position + 1) }
    }
    state finish(cell: &mut Cell) -> i32 { cell.value }
}

machine Main::main(main: &mut Main) reaches Console {
    let result: i32 = Worker::write(&mut main.cell);
    transition main.cell.values[0] == 70 && main.cell.values[1] == 70 {
        true -> success(main)
        false -> failure(main)
    }
    state success(main: &mut Main) { Console::exit_process(main.cell.value); }
    state failure(main: &mut Main) { Console::exit_process(71); }
}
