// A non-interval field domain survives nested calls and whole transfer.
// The structural argument preceding value must not shift its scalar slot.
use omega_language_std::console;

domain i32::NotFive(value) requires value != 5;
data Marker [copy] { }
data Gauge { level: i32 in NotFive; }
data Holder { gauge: Gauge; }
data Main { }

machine make_gauge(marker: Marker, value: i32 in NotFive) -> Gauge {
    Gauge { level: value }
}

machine make_holder(marker: Marker, value: i32 in NotFive) -> Holder {
    Holder { gauge: make_gauge(marker, value) }
}

machine Main::main(main: &mut Main) reaches Console {
    let chosen: Gauge = make_gauge(Marker {}, 7);
    let holder: Holder = Holder { gauge: chosen };
    let other: Holder = make_holder(Marker {}, 9);
    transition holder.gauge.level == 7 && other.gauge.level == 9 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
