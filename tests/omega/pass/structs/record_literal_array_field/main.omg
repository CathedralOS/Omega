// A record literal supplies closed primitive array members. Each member lowers
// as one scalar-array establishment whose leaves are the authored elements in
// row-major order, and the enclosing record consumes it as a structural field.
// Reduced from `samples/cli/systems/wire_protocol`.
//
// Local sites (constructed, then discarded):
//   `packet`        the original all-zero `[i32; 4]` reduction;
//   `local_pair`    two array members in one literal;
//   `local_grid`    a nested `[[i32; 2]; 2]` member;
//   `local_framed`  an array beside scalar and nested-record members;
//   `local_outer`   an array member inside a nested record literal.
// Field-store sites, read back in a later state:
//   `main.filled`   element order and the negative operand `0 - 2`;
//   `main.pair`     `[u8; 2]` twice in one literal;
//   `main.grid`     the nested member, flattened outer index first;
//   `main.framed`   a `[i64; 3]` member beside `header` and `tag`;
//   `main.outer`    the array inside the nested `inner` record;
//   `main.stored`   a second negative operand, `0 - 6`.
//
// Observation goes through subject fields. Same-state reads of a record local
// that carries an array member, element reads of a record state parameter, and
// moving such a local into a subject field are separate gaps, as are a named
// array source (`Packet { samples: bare }`) and array payloads of a case
// literal.
use omega_language_std::console;

data Packet {
    samples: [i32; 4];
}

data Pair {
    left: [u8; 2];
    right: [u8; 2];
}

data Grid {
    cells: [[i32; 2]; 2];
}

data Header {
    version: u32;
}

data Framed {
    header: Header;
    samples: [i64; 3];
    tag: u8;
}

data Outer {
    inner: Packet;
    count: i32;
}

data Main {
    filled: Packet;
    pair: Pair;
    grid: Grid;
    framed: Framed;
    outer: Outer;
    stored: Packet;
}

machine Main::main(main: &mut Main) reaches Console {
    let packet: Packet = Packet { samples: [0, 0, 0, 0] };
    let local_pair: Pair = Pair { left: [1, 2], right: [3, 4] };
    let local_grid: Grid = Grid { cells: [[1, 2], [3, 4]] };
    let local_framed: Framed = Framed { header: Header { version: 9 }, samples: [5, 6, 7], tag: 3 };
    let local_outer: Outer = Outer { inner: Packet { samples: [10, 20, 30, 40] }, count: 2 };
    main.filled = Packet { samples: [4, 0 - 2, 7, 1] };
    main.pair = Pair { left: [1, 2], right: [3, 4] };
    main.grid = Grid { cells: [[1, 2], [3, 4]] };
    main.framed = Framed { header: Header { version: 9 }, samples: [5, 6, 7], tag: 3 };
    main.outer = Outer { inner: Packet { samples: [10, 20, 30, 40] }, count: 2 };
    main.stored = Packet { samples: [5, 0 - 6, 7, 8] };
    let constructed: bool = true;
    transition constructed {
        true -> check(main)
        false -> bad(main)
    }

    state check(main: &mut Main) {
        let ok: bool = main.filled.samples[0] == 4
            && main.filled.samples[1] == 0 - 2
            && main.filled.samples[2] == 7
            && main.filled.samples[3] == 1
            && main.pair.left[0] == 1
            && main.pair.left[1] == 2
            && main.pair.right[0] == 3
            && main.pair.right[1] == 4
            && main.grid.cells[0][1] == 2
            && main.grid.cells[1][0] == 3
            && main.framed.header.version == 9
            && main.framed.samples[2] == 7
            && main.framed.tag == 3
            && main.outer.inner.samples[3] == 40
            && main.outer.count == 2
            && main.stored.samples[1] == 0 - 6;
        transition ok {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
