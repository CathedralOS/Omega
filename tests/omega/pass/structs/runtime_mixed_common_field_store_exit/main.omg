data Evidence { case Only; }
data Event {
    enabled: bool;
    common_proof [erased]: Evidence;
    count: i32;
    case Empty;
    case Value(value: i32, proof [erased]: Evidence);
}
data Context { event: Event; }

machine replace(context: &mut Context) {
    let replacement: Event = Event::Value { value: 7 };
    context.event = replacement;
}

machine update(event: &mut Event) {
    event.count = 9;
    event.enabled = true;
}

machine observe(event: &Event) -> bool {
    transition event {
        Event::Value { enabled as _, common_proof as _, count as _, value, proof as _ } -> (value == 7 && event.count == 9 && event.enabled)
        _ -> (false)
    }
}

machine main() crashes Trap {
    let mut context: Context = Context {
        event: Event::Value { enabled: true, count: 4, value: 2 }
    };
    replace(&mut context);
    let reset: bool = !context.event.enabled && context.event.count == 0;
    update(&mut context.event);
    let observed: bool = observe(&context.event);
    transition reset && observed {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
