use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: i32; }
data Worker {}
data Main { console: Binding<Console>; cell: Cell; }

// State transfer must retain the caller's storage, including its writes.
machine Worker::write(cell: &mut Cell) -> i32 {
    transition { _ -> step(cell, 2) }
    state step(cell: &mut Cell, remaining: u64) -> i32 {
        transition remaining > 0 {
            true -> store(cell, remaining)
            false -> finish(cell)
        }
    }
    state store(cell: &mut Cell, remaining: u64) -> i32
    requires remaining > 0;
    {
        cell.value = 70;
        transition { _ -> step(cell, remaining - 1) }
    }
    state finish(cell: &mut Cell) -> i32 { cell.value }
}

machine Main::main(&mut self) reaches Console {
    let result: i32 = Worker::write(&mut self.cell);
    self.console.exit_process(self.cell.value);
}
