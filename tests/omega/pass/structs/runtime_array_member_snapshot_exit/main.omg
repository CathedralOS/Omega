use omega_language_std::console;

data Packet { samples: [i32; 2]; stamp: i32; }
data Main { packet: Packet; samples: [i32; 2]; }

machine stamp(context: &mut Main) -> i32 {
    context.samples[0] = 90;
    7
}

machine Main::main(context: &mut Main) reaches Console {
    context.samples = [30, 40];
    // The first field must snapshot before evaluation of the second field.
    context.packet = Packet { samples: context.samples, stamp: stamp(context) };
    transition { _ -> inspect(context) }
    state inspect(context: &mut Main) {
        transition context.packet.samples[0] == 30 && context.packet.samples[1] == 40
            && context.packet.stamp == 7 && context.samples[0] == 90 {
            true -> finish(context, 70)
            false -> finish(context, 1)
        }
    }
    state finish(context: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
