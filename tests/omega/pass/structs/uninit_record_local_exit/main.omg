// A `let mut` record local with no initializer owns its zeroed shape: the
// declaration establishes the affine root, so the exit drop carries the
// declaration's provenance instead of an unknown claim. Exits 70.

use omega_language_std::console;
use omega::language::core::binding;

data Point {
    x: i32 in Trapping;
    y: i32 in Trapping;
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let mut made: Point;
    self.console.exit_process(70);
}
