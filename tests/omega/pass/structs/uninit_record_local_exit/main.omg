// A `let mut` record local with no initializer owns its zeroed shape: the
// declaration establishes the affine root, so the exit drop carries the
// declaration's provenance instead of an unknown claim. Exits 70.

use omega_language_std::console;

data Point {
    x: i32 in Trapping;
    y: i32 in Trapping;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut made: Point;
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
