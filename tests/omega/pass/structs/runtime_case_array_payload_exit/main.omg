// Array construction is an ordinary value producer inside a case payload.
use omega_language_std::console;

data Packet {
    case Empty;
    case Samples(values: [i32; 2]);
}
data Main { packet: Packet; }

machine Main::main(context: &mut Main) reaches Console {
    context.packet = Packet::Samples { values: [30, 40] };
    transition { _ -> inspect(context) }
    machine inspect(context: &mut Main) {
        transition context.packet {
            Packet::Empty -> finish(context, 1)
            Packet::Samples { values } -> verify(context, values[0], values[1])
        }
    }
    machine verify(context: &mut Main, first: i32, second: i32) {
        transition first == 30 && second == 40 {
            true -> finish(context, 70)
            false -> finish(context, 2)
        }
    }
    machine finish(context: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
