use omega_language_std::console;

data Cell { values: [i32; 2]; count: u64; }
data Worker {}
machine Worker::new() -> Cell { Cell { count: 0 } }
machine Worker::copy(source: &Cell) -> Cell {
    Cell { values: source.values, count: source.count }
}
machine Worker::clone(source: &Cell) -> Cell {
    let mut copied: Cell = Worker::new();
    copied.count = source.count;
    transition { _ -> each(&mut copied, source, 0) }
    machine each(copied: &mut Cell, source: &Cell, position: u64) -> Cell {
        transition position < 2 {
            true -> store(copied, source, position)
            false -> (Worker::copy(copied))
        }
    }
    machine store(copied: &mut Cell, source: &Cell, position: u64) -> Cell
        requires position < 2;
    {
        copied.values[position] = source.values[position];
        transition { _ -> each(copied, source, position + 1) }
    }
}

// The local backing home survives every state; the returned record is a fresh
// copy. Mutating the original after return must not change the copied elements.
data Main { cell: Cell; }
machine Worker::valid(cell: &Cell) -> bool {
    cell.count == 2 && cell.values[0] == 35 && cell.values[1] == 70
}
machine Worker::changed(cell: &Cell) -> bool {
    cell.count == 2 && cell.values[0] == 99 && cell.values[1] == 70
}
machine Main::main(main: &mut Main) reaches Console {
    main.cell.count = 2;
    main.cell.values[0] = 35;
    main.cell.values[1] = 70;
    let copied: Cell = Worker::clone(&main.cell);
    main.cell.values[0] = 99;
    let valid_copy: bool = Worker::valid(&copied);
    let valid_source: bool = Worker::changed(&main.cell);
    transition valid_copy && valid_source {
        true -> success(main)
        false -> failure(main)
    }
    machine success(main: &mut Main) { Console::exit_process(70); }
    machine failure(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
