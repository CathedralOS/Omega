// A state that receives an owned record reads its fixed-array members in
// place. `packet.samples.items[0]` and `packet.samples.items[cursor]` are
// primitive reads of the state's own arrival -- the same block home its
// `packet.depth` field read observes -- not reads of a borrowed join or of a
// copied child. `fill` writes the members through `&mut` first, so the reads
// observe the caller's stores; the runtime selector keeps its bound as the
// state's arrival requirement. Exits 70.

use omega_language_std::console;

data Samples {
    items: [i32; 4];
    length: u64;
}

data Packet {
    samples: Samples;
    depth: i32;
}

data Main {
}

machine fill(packet: &mut Packet) {
    packet.samples.items[0] = 150;
    packet.samples.items[1] = 0 - 2;
    packet.samples.length = 2;
    packet.depth = 0 - 64;
}

machine Main::main(main: &mut Main) reaches Console {
    let packet: Packet = Packet {
        samples: Samples { items: [0, 0, 0, 0], length: 0 },
        depth: 0
    };
    fill(&mut packet);
    transition { _ -> check(main, packet, 1) }

    state check(main: &mut Main, packet: Packet, cursor: u64)
    requires cursor < 4 {
        let fields_ok: bool = packet.samples.items[0] == 150
            && packet.samples.items[cursor] == 0 - 2
            && packet.samples.items[3] == 0
            && packet.samples.length == 2
            && packet.depth == 0 - 64;
        transition fields_ok {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
