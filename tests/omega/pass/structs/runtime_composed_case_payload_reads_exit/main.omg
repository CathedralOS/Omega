// The existing case-field observations compose in one graph. Keep every
// failure code and payload check; splitting the graph must not change validity.
use omega_language_std::console;
use omega::language::core::binding;

domain i32::Ten(value) requires 0 <= value && value <= 10;

data Evidence { case Only; }
data Point [copy] { x: i32; y: i32; }

data Event {
    consumed: bool;
    bonus: i32;
    case Nothing;
    case Treasure(gold: i32);
    case Fight(strength: i32, speed: i32);
}

data Command {
    case Off;
    case Dim(amount: i32);
    case Pair(low: i32, high: i32);
    case Place(at: Point);
}

data Certified {
    case Pending;
    case Proven(value: i32, proof [erased]: Evidence);
}

data Level {
    case Dark;
    case Lit(amount: i32 in Ten);
}

data Main {
    console: Binding<Console>;
    event: Event;
    command: Command;
    certified: Certified;
    level: Level;
}


machine Main::main(main: &mut Main) reaches Console {

    main.event = Event::Treasure { consumed: true, gold: 50 };
    transition main.event.consumed {
        true -> check_common_fields_unnamed_common_zero(main)
        false -> check_common_fields_fail(main, 1)
    }

    state check_common_fields_unnamed_common_zero(main: &mut Main) {
        transition main.event.bonus == 0 {
            true -> check_common_fields_payload_beside_common(main)
            false -> check_common_fields_fail(main, 2)
        }
    }

    state check_common_fields_payload_beside_common(main: &mut Main) {
        transition main.event {
            Event::Treasure { gold } -> check_common_fields_treasure_gold(main, gold)
            _ -> check_common_fields_fail(main, 3)
        }
    }

    state check_common_fields_treasure_gold(main: &mut Main, gold: i32) {
        transition gold == 50 {
            true -> check_common_fields_store_common(main)
            false -> check_common_fields_fail(main, 4)
        }
    }

    state check_common_fields_store_common(main: &mut Main) {
        main.event.bonus = 9;
        transition main.event {
            Event::Treasure { gold } -> check_common_fields_stored_common(main, gold)
            _ -> check_common_fields_fail(main, 5)
        }
    }

    state check_common_fields_stored_common(main: &mut Main, gold: i32) {
        transition gold == 50 && main.event.bonus == 9 && main.event.consumed {
            true -> check_common_fields_replace_case(main)
            false -> check_common_fields_fail(main, 6)
        }
    }

    // The replacement names no common field: both read zero afterwards.
    state check_common_fields_replace_case(main: &mut Main) {
        main.event = Event::Fight { strength: 3, speed: 4 };
        transition main.event.bonus == 0 && !main.event.consumed {
            true -> check_common_fields_fight_payload(main)
            false -> check_common_fields_fail(main, 7)
        }
    }

    state check_common_fields_fight_payload(main: &mut Main) {
        transition main.event {
            Event::Fight { strength, speed } -> check_common_fields_fight_values(main, strength, speed)
            _ -> check_common_fields_fail(main, 8)
        }
    }

    state check_common_fields_fight_values(main: &mut Main, strength: i32, speed: i32) {
        transition strength == 3 && speed == 4 {
            true -> check_common_fields_payload_free_bare(main)
            false -> check_common_fields_fail(main, 8)
        }
    }

    state check_common_fields_payload_free_bare(main: &mut Main) {
        main.event = Event::Nothing;
        transition main.event {
            Event::Nothing -> check_common_fields_payload_free_named(main)
            _ -> check_common_fields_fail(main, 9)
        }
    }

    state check_common_fields_payload_free_named(main: &mut Main) {
        main.event = Event::Nothing { bonus: 12 };
        transition main.event {
            Event::Nothing -> check_common_fields_payload_free_common(main, main.event.bonus)
            _ -> check_common_fields_fail(main, 10)
        }
    }

    state check_common_fields_payload_free_common(main: &mut Main, bonus: i32) {
        transition bonus == 12 {
            true -> check_common_fields_done(main)
            false -> check_common_fields_fail(main, 10)
        }
    }

    state check_common_fields_done(main: &mut Main) { transition { _ -> check_closed_payloads_entry(main) } }
    state check_common_fields_fail(main: &mut Main, code: i32) { main.console.exit_process(code); }


    state check_closed_payloads_entry(main: &mut Main) {
    main.command = Command::Dim { amount: 7 };
    transition main.command {
        Command::Dim { amount } -> check_closed_payloads_scalar_value(main, amount)
        _ -> check_closed_payloads_fail(main, 11)
    }

    }

    state check_closed_payloads_scalar_value(main: &mut Main, amount: i32) {
        transition amount == 7 {
            true -> check_closed_payloads_payload_free(main)
            false -> check_closed_payloads_fail(main, 11)
        }
    }

    state check_closed_payloads_payload_free(main: &mut Main) {
        main.command = Command::Off;
        transition main.command {
            Command::Off -> check_closed_payloads_multiple(main)
            _ -> check_closed_payloads_fail(main, 12)
        }
    }

    state check_closed_payloads_multiple(main: &mut Main) {
        main.command = Command::Pair { low: 1, high: 2 };
        transition main.command {
            Command::Pair { low, high } -> check_closed_payloads_multiple_values(main, low, high)
            _ -> check_closed_payloads_fail(main, 13)
        }
    }

    state check_closed_payloads_multiple_values(main: &mut Main, low: i32, high: i32) {
        transition low == 1 && high == 2 {
            true -> check_closed_payloads_record(main)
            false -> check_closed_payloads_fail(main, 13)
        }
    }

    state check_closed_payloads_record(main: &mut Main) {
        main.command = Command::Place { at: Point { x: 5, y: 6 } };
        transition main.command {
            Command::Place { at } -> check_closed_payloads_record_values(main, at)
            _ -> check_closed_payloads_fail(main, 14)
        }
    }

    state check_closed_payloads_record_values(main: &mut Main, at: Point) {
        transition at.x == 5 && at.y == 6 {
            true -> check_closed_payloads_done(main)
            false -> check_closed_payloads_fail(main, 15)
        }
    }

    state check_closed_payloads_done(main: &mut Main) { transition { _ -> check_local_stores_entry(main) } }
    state check_closed_payloads_fail(main: &mut Main, code: i32) { main.console.exit_process(code); }


    state check_local_stores_entry(main: &mut Main) {
    Main::store_local_event(main);
    transition main.event {
        Event::Treasure { gold } -> check_local_stores_mixed_values(main, gold)
        _ -> check_local_stores_fail(main, 16)
    }

    }

    state check_local_stores_mixed_values(main: &mut Main, gold: i32) {
        transition gold == 8 && main.event.bonus == 3 && main.event.consumed {
            true -> check_local_stores_closed_scalar(main)
            false -> check_local_stores_fail(main, 17)
        }
    }

    state check_local_stores_closed_scalar(main: &mut Main) {
        Main::store_local_dim(main);
        transition main.command {
            Command::Dim { amount } -> check_local_stores_closed_value(main, amount)
            _ -> check_local_stores_fail(main, 18)
        }
    }

    state check_local_stores_closed_value(main: &mut Main, amount: i32) {
        transition amount == 21 {
            true -> check_local_stores_closed_multiple(main)
            false -> check_local_stores_fail(main, 18)
        }
    }

    state check_local_stores_closed_multiple(main: &mut Main) {
        Main::store_local_pair(main);
        transition main.command {
            Command::Pair { low, high } -> check_local_stores_multiple_values(main, low, high)
            _ -> check_local_stores_fail(main, 19)
        }
    }

    state check_local_stores_multiple_values(main: &mut Main, low: i32, high: i32) {
        transition low == 30 && high == 40 {
            true -> check_local_stores_done(main)
            false -> check_local_stores_fail(main, 19)
        }
    }

    state check_local_stores_done(main: &mut Main) { transition { _ -> check_erased_member_entry(main) } }
    state check_local_stores_fail(main: &mut Main, code: i32) { main.console.exit_process(code); }


    state check_erased_member_entry(main: &mut Main) {
    main.certified = Certified::Proven { value: 44 };
    transition main.certified {
        Certified::Proven { value, proof as _ } -> check_erased_member_erased_value(main, value)
        Certified::Pending -> check_erased_member_fail(main, 20)
    }

    }

    state check_erased_member_erased_value(main: &mut Main, value: i32) {
        transition value == 44 {
            true -> check_erased_member_done(main)
            false -> check_erased_member_fail(main, 20)
        }
    }

    state check_erased_member_done(main: &mut Main) { transition { _ -> check_interval_member_entry(main) } }
    state check_erased_member_fail(main: &mut Main, code: i32) { main.console.exit_process(code); }


    state check_interval_member_entry(main: &mut Main) {
    main.level = Level::Lit { amount: 7 };
    transition main.level {
        Level::Lit { amount } -> check_interval_member_scale(main, amount)
        Level::Dark -> check_interval_member_fail(main, 21)
    }

    // `amount` reaches `scale` through its payload domain alone: no guard
    // bounds it, so the requires is discharged by `Ten` membership.
    }

    state check_interval_member_scale(main: &mut Main, amount: i32) requires amount >= 0 && amount <= 10 {
        let scaled: i32 = amount * 10;
        transition scaled == 70 {
            true -> check_interval_member_through_local(main)
            false -> check_interval_member_fail(main, 22)
        }
    }

    state check_interval_member_through_local(main: &mut Main) {
        Main::store_local_level(main);
        transition main.level {
            Level::Lit { amount } -> check_interval_member_local_value(main, amount)
            Level::Dark -> check_interval_member_fail(main, 23)
        }
    }

    state check_interval_member_local_value(main: &mut Main, amount: i32) {
        transition amount == 4 {
            true -> check_interval_member_done(main)
            false -> check_interval_member_fail(main, 23)
        }
    }

    state check_interval_member_done(main: &mut Main) { main.console.exit_process(70); }
    state check_interval_member_fail(main: &mut Main, code: i32) { main.console.exit_process(code); }

}

machine Main::store_local_event(main: &mut Main) {
    let replacement: Event = Event::Treasure { consumed: true, bonus: 3, gold: 8 };
    main.event = replacement;
}

machine Main::store_local_dim(main: &mut Main) {
    let dimmed: Command = Command::Dim { amount: 21 };
    main.command = dimmed;
}

machine Main::store_local_pair(main: &mut Main) {
    let paired: Command = Command::Pair { low: 30, high: 40 };
    main.command = paired;
}

machine Main::store_local_level(main: &mut Main) {
    let lit: Level = Level::Lit { amount: 4 };
    main.level = lit;
}
