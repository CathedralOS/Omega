use omega_language_std::console;
use omega::language::core::binding;
data Info { name: [u8; 4]; }
data Main { console: Binding<Console>; }
machine clone(info: &Info) -> Info {
    Info { name: info.name }
}
machine first(info: &Info) -> i32 { info.name[0] as i32 }
machine Main::main(context: &mut Main) reaches Console {
    let mut info: Info;
    info.name[0] = 70;
    let copied: Info = clone(&info);
    let code: i32 = first(&copied);
    context.console.exit_process(code);
}
