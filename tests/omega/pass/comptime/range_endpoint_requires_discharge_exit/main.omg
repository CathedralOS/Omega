// An authored `requires` clause on a range-endpoint callee discharges at the
// concrete argument: `bounded(256)` re-checks its exact call under literal
// arguments, so `value <= 512` instantiates to `256 <= 512` — proved by the
// same instantiated judgment that refutes the false direction. An argument
// that violates the clause (513) or a premise on a nested callee the caller
// never proved still rejects at checking.
use omega_language_std::console;

machine bounded(value: u64) -> u64
requires value <= 512
{
    transition { _ -> (value) }
}

machine take_bounded(value: u64) -> u64
requires value <= bounded(256)
{ value }

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let kept: u64 = take_bounded(7);
    transition kept == 7 {
        true -> good(main)
        false -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
