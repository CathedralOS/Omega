// A declared range endpoint whose const machine invokes a selected boundary
// machine must execute the provider's ordinary checked body during semantic
// const evaluation -- never a builtin spelling. `Provider::remainder` computes
// `left | right` = 7 where builtin `%` would fold 1, so passing 7 to
// `take_bounded` only type-checks when the provider body actually ran.
use omega_language_std::console;
use omega::language::core::float_operations;

public boundary trait Math {
    machine remainder(left: u64, right: u64) -> u64 reaches terminates;
}
public Provider satisfies Math {
    machine remainder(left: u64, right: u64) -> u64 { left | right }
}
trait Remainder {
    machine % remainder(left: u64, right: u64) -> u64;
}
BoundaryRemainder satisfies Remainder {
    machine remainder(left: u64, right: u64) -> u64 {
        Math::remainder(left, right)
    }
}
machine selected_remainder<Operations satisfies Remainder>(left: u64, right: u64) -> u64 {
    left % right
}

machine limit() -> u64 {
    let left: u64 = 7;
    let right: u64 = 2;
    // The private endpoint program must land the completed anonymous value,
    // not round each operand before the selected provider runs.
    let rounded: f32 = 1.0 + 0.000000059604644775390625000001;
    transition rounded == 1.00000011920928955078125f32 {
        true -> (selected_remainder<BoundaryRemainder>(left, right))
        false -> 0
    }
}

machine take_bounded(value: u64) -> u64 requires value <= limit() { value }

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let bounded: u64 = take_bounded(7);
    transition bounded == 7 {
        true -> (good(main))
        false -> (bad(main))
    }

    machine good(main: &mut Main) reaches Console {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) reaches Console {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
