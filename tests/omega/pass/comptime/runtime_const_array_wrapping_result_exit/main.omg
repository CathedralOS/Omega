// Expected exit: 0. The assertions observe extent, stored value and copy.
machine size() -> u32 in Wrapping { (65536 as u32 in Wrapping) * (65536 as u32 in Wrapping) }
machine main() crashes Trap {
 let slots: [u8; size()];
 transition slots.len == 0 { true -> done() _ -> bad() }
 machine done() { } machine bad() { crash Trap; }
}
