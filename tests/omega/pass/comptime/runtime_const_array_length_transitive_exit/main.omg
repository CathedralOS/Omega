// COMPTIME STAGE 1, TRANSITIVE PURITY: the const-position callee
// `table_size()` itself CALLS another build-time-admissible machine (`base()`); the
// decision-12 inferred effect surface is transitive, so the whole call tree
// is const-evaluable and the reference interpreter folds it to 5 * 3 + 1 =
// 16. The existing comptime canary's callee is a single arithmetic
// expression -- this one pins that const evaluation runs the CALL machinery
// (frame setup, value return), not just expression folding. Runtime ladder
// as in the base canary: both ends of the 16-slot array hold their values
// (index 15 only typechecks if 16 reached the range checker). Exits 70 only
// when both reads are right.

use omega_language_std::console;

data Main {
    slots: [i64; table_size()];
}

machine base() -> u64 {
    transition {
        _ -> 5
    }
}

machine table_size() -> u64 {
    transition {
        _ -> (((base() as u64 in Wrapping) * 3 + 1) as u64)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.slots[0] = 7;
    main.slots[15] = 63;

    transition main.slots[0] == 7 {
        true -> check_last(main)
        false -> bad(main)
    }

    state check_last(main: &mut Main) {
        transition main.slots[15] == 63 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
