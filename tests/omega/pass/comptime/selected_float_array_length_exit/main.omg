use omega::language::core::float_operations;
use omega_language_std::console;

// Named and spelled uses execute their selected primitive Float meanings
// while the array type is evaluated. Runtime indexing consumes that result.
machine slot_count() -> u64 {
    let half: f32 in Saturating = 0.5f32;
    let whole: f32 = Float::add(half, half) as f32;
    transition whole == 1.0f32 { true -> 8 _ -> 0 }
}

data Main {
    slots: [u8; slot_count()];
}

machine Main::main(main: &mut Main) reaches Console {
    main.slots[7] = 63;
    transition main.slots[7] == 63 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
