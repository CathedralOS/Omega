// The outer length job must settle its own array-type prerequisite before
// checking and executing. Declaration order deliberately places the caller first.
use omega_language_std::console;
use omega::language::core::float_operations;

data Main {
    slots: [u8; table_size()];
    extra: [u8; other_size()];
}

data LeafStorage { slots: [u8; leaf_size()]; }

machine table_size() -> u64 {
    let storage: LeafStorage = LeafStorage {};
    storage.slots.len
}

// Both outer jobs use the same leaf type. Its selected provider must settle
// before either outer body can check or run, and the literal is shared.
machine other_size() -> u64 {
    let storage: LeafStorage = LeafStorage {};
    storage.slots.len
}

machine leaf_size() -> u64 {
    let half: f32 in Saturating = 0.5f32;
    let whole: f32 = Float::add(half, half) as f32;
    transition whole == 1.0f32 { true -> 4 _ -> 0 }
}

machine Main::main(main: &mut Main) reaches Console {
    main.slots[3] = 70;
    main.extra[3] = 11;
    transition main.slots[3] == 70 {
        true -> check_extra(main)
        _ -> bad(main)
    }
    state check_extra(main: &mut Main) {
        transition main.extra[3] == 11 { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
