// Expected exit: 0. The assertions observe extent, stored value and copy.
use omega::language::core::float_operations;
public data Matrix<const Rows: u64, const Columns: u64> [copy]
where Rows >= 1 && Rows <= 4 && Columns >= 1 && Columns <= 4 {
    values: [f64; Rows * Columns];
}
machine preserve<const Rows: u64, const Columns: u64>(value: Matrix<Rows, Columns>) -> Matrix<Rows, Columns>
requires Rows >= 1 && Rows <= 4 && Columns >= 1 && Columns <= 4;
{ value }
machine main() crashes Trap {
    let mut source: Matrix<3, 3>;
    source.values[4] = 7.5;
    let copy: Matrix<3, 3> = preserve<3, 3>(source);
    transition copy.values.len == 9 && copy.values[4] == 7.5 { true -> done() _ -> bad() }
    machine done() { } machine bad() { crash Trap; }
}
