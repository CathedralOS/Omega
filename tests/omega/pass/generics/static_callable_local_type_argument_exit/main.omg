machine accept<Kind>(value: Kind) -> bool { true }

machine invoke<machine Routine>() -> bool
where machine Routine<Context>(value: Context) -> bool;
{ Routine<u64>(3u64) }

machine main() crashes Trap {
    let result: bool = invoke<accept>();
    transition result {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
