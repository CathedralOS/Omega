// Fact: an omitted Capacity is inferred as 2 from the actual [u8; 2] type and Length == [u8; Capacity], independently of element values.
// Expected exit: 0
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine marker() -> u64 { 0 }
machine forward<Value [copy], machine Callback>(value: Value) -> Value
where machine Callback() -> u64;
{ value }
machine main() crashes Trap {
    let items: [u8; 2] = [7, 11];
    let observed: u64 = capacity<[u8; 2], 2>(forward<[u8; 2], marker>(items));
    transition observed == 2 { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
