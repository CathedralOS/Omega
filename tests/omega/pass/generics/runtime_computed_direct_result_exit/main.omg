// Expected exit: 0
data Index<Limit:u32> [copy] where value<Limit {value:u32;}
machine create(total:u32[0..=100])->Index<(total+1u32)> {Index{value:0}}
machine probe(total:u32[0..=100])->u32 {create(total).Limit}
machine main() crashes Trap {let observed:u32=probe(3); transition observed==4 {true->done() _->bad()} machine done(){} machine bad() crashes Trap {crash Trap;}}
