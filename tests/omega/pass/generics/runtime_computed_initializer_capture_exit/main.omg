// Expected exit: 0
data Index<Limit:u32> [copy] where value < Limit { value:u32; }
machine payload(origin:&mut u32)->u32 ensures result == 8 { origin=4294967295; 8 }
machine probe(limit:u32)->u32 requires limit>=9 && limit<=10 {
 let mut origin:u32=limit-1u32;
 let indexed:Index<(origin+1u32)> = Index{value:payload(&mut origin)};
 indexed.Limit
}
machine main() crashes Trap {
 let result:u32=probe(9);
 transition result==9 {true->done() _->bad()}
 state done(){} state bad(){crash Trap;}
}
