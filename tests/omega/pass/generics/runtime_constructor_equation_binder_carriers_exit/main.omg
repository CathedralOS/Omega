data Mode<const Inner: u32> [copy] { value: u32; }

data Box<Payload [copy], const Count: u32> [copy]
where Payload == Mode<Count>
{ value: Payload; }

data Reversed<const Count: u32, Payload [copy]> [copy]
where Payload == Mode<Count>
{ value: Payload; }

machine capacity<Payload, const Count: u32>() -> u32
where Payload == Mode<Count>
{ Count }

machine recovered<const Count: u32, Payload>() -> u32
where Payload == Mode<Count>
{ Count }

data Main {
    box: Box<Mode<4> >;
    reversed: Reversed<4>;
    first: u32;
    second: u32;
}

machine main(main: &mut Main) crashes Trap {
    main.box.value.value = 11;
    main.reversed.value.value = 13;
    main.first = capacity<Mode<4>>();
    main.second = recovered<4>();
    transition main.first == 4 && main.second == 4
        && main.box.value.value == 11 && main.reversed.value.value == 13 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
