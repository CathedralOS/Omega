// machine_indexed_stream_dispatch: a machine body constructs, forwards and
// dispatches over a recursive family indexed by a static machine.
//
//   * `Index` is a recursive enum: `Next` carries an `Index` payload.
//   * `Stream<machine S>` binds a static machine index behind
//     `where machine S(index: Index) -> Index`; `Stream::More` stores
//     `tail: Stream<S>` -- recursion through the machine-indexed family.
//   * `forward_schema<identity_schema, succ>` passes a machine through a
//     nested machine parameter; specialization makes every call direct.
//
// The body builds a two-element Stream<succ>, forwards it through
// identity_schema, then destructures the result in two states. Both types are
// recursive by value and therefore proof-only: compile-checked, no entry.
pub data Index {
    case Zero;
    case Next(previous: Index);
}

data Stream<machine S>
where machine S(index: Index) -> Index;
{
    case Empty;
    case More(sample: Index, tail: Stream<S>);
}

machine succ(index: Index) -> Index {
    Index::Next { previous: index }
}

machine identity_schema<machine Chosen>(value: Stream<Chosen>) -> Stream<Chosen>
where machine Chosen(index: Index) -> Index;
{
    value
}

machine forward_schema<machine Schema, machine Selected>(value: Stream<Selected>) -> Stream<Selected>
where machine Schema<machine Inner>(value: Stream<Inner>) -> Stream<Inner>
where machine Inner(index: Index) -> Index;
where machine Selected(index: Index) -> Index;
{
    Schema<Selected>(value)
}

machine dispatch_stream() {
    let tail: Stream<succ> = Stream::Empty;
    let mid: Stream<succ> = Stream::More { sample: succ(Index::Zero), tail: tail };
    let stream: Stream<succ> = Stream::More { sample: Index::Zero, tail: mid };
    let forwarded: Stream<succ> = forward_schema<identity_schema, succ>(stream);
    transition forwarded {
        Stream::More { sample, tail } -> check_tail(tail)
        Stream::Empty -> done(71)
    }

    state check_tail(tail: Stream<succ>) {
        transition tail {
            Stream::More { sample, tail } -> check_empty(tail)
            Stream::Empty -> done(72)
        }
    }

    state check_empty(tail: Stream<succ>) {
        transition tail {
            Stream::Empty -> done(70)
            Stream::More { sample, tail } -> done(73)
        }
    }

    state done(code: i32) {}
}
