// Fields use the caller's extent, never the data declaration's binder.
data Buffer<const N: u64> { items: [u8; N]; }

machine window<const Extent: u64>(buffer: &Buffer<Extent>) -> u64
requires Extent >= 0;
{
    let view: &[u8] = &buffer.items[..Extent];
    transition { _ -> view.len }
}

// Source checks this finite projection without growing every future referent.
data Nest<'next, Value> {
    value: Value;
    next: &'next Nest<'next, [Value; 2]>;
}
machine nested_window<'storage, const Extent: u64>(
    node: &Nest<'storage, Buffer<Extent>>
) -> u64
requires Extent >= 0;
{
    let view: &[u8] = &node.next.value[0].items[..Extent];
    transition { _ -> view.len }
}

machine main() crashes Trap {
    let buffer: Buffer<4> = Buffer { items: [1, 2, 3, 4] };
    transition window<4>(&buffer) == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
