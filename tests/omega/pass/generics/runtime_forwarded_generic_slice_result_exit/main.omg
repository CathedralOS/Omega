// Each helper has a distinct type binder. The returned view keeps the applied
// element type, extent and backing through direct and stored generic results.
machine view<Element>(items: &[Element]) -> &[Element] { items }
machine relay<Value>(items: &[Value]) -> &[Value] { view<Value>(items) }
machine stored<Value>(items: &[Value]) -> &[Value] {
    let result: &[Value] = view<Value>(items);
    result
}
data Main { bytes: [u8; 4]; words: [i32; 2]; }
machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[1] = 70;
    main.words[0] = 42;
    let bytes: &[u8] = relay(&main.bytes);
    let words: &[i32] = stored(&main.words);
    transition bytes.len == 4 && words.len == 2 && bytes[1] == 70 && words[0] == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
