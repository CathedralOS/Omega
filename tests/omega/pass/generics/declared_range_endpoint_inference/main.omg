machine upper_bound<const N: u64>(value: u64[0..=N]) -> u64 { N }
machine exclusive_upper_bound<const N: u64>(value: u64[0..N]) -> u64 { N }

machine inferred(value: u64[0..=256]) -> u64 { upper_bound(value) }
machine computed(value: u64[0..=128 + 128]) -> u64 { upper_bound(value) }
machine full_width(value: u64[0..=18446744073709551615u64 % 512u64]) -> u64 { upper_bound(value) }
machine wide_intermediate(value: u64[0..=9223372036854775808u64 + 256 - 9223372036854775808u64]) -> u64 { upper_bound(value) }
machine computed_exclusive(value: u64[0..128 * 2 + 1]) -> u64 { upper_bound(value) }
machine fractional(value: u64[0..=1 / 2 * 512]) -> u64 { upper_bound(value) }
machine call_fractional() -> u64 { fractional(256) }
machine explicit(value: u64[0..=256]) -> u64 { upper_bound<512>(value) }
machine limit() -> u64 { 256 }
machine named(value: u64[0..=limit()]) -> u64 { upper_bound(value) }
machine call_named() -> u64 { named(256) }
machine named_exclusive(value: u64[0..limit()]) -> u64 { upper_bound(value) }
machine wide_limit() -> u64 { 18446744073709551615 }
machine named_full_width(value: u64[0..=wide_limit()]) -> u64 { upper_bound(value) }
machine named_full_width_exclusive(value: u64[0..wide_limit()]) -> u64 { upper_bound(value) }
machine negative_limit() -> i64 { -1 }
machine named_signed(value: i64[-2..=negative_limit()]) -> i64 { value }
data Limits {}
machine Limits::capacity() -> u64 { 256 }
machine scoped_named(value: u64[0..=Limits::capacity()]) -> u64 { upper_bound(value) }
data OtherLimits {}
machine OtherLimits::capacity() -> u64 { 512 }
machine capacity() -> u64 { 17 }
machine scoped_other(value: u64[0..OtherLimits::capacity()]) -> u64 { upper_bound(value) }
machine free_capacity(value: u64[0..=capacity()]) -> u64 { upper_bound(value) }
machine exclusive_full_u64(value: u64[0..18446744073709551616]) -> u64 { upper_bound(value) }
machine inclusive_to_exclusive(value: u64[0..=256]) -> u64 { exclusive_upper_bound(value) }
machine exclusive_to_inclusive(value: u64[0..257]) -> u64 { upper_bound(value) }
machine typed_exclusive(value: u64[0..7u64 / 2 * 2]) -> u64 { upper_bound(value) }
