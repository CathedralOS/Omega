use omega_language_std::console;

machine upper_bound<const N: u64>(value: u64[0..=N]) -> u64 { N }
machine exclusive_upper_bound<const N: u64>(value: u64[0..N]) -> u64 { N }

machine inferred(value: u64[0..=256]) -> u64 { upper_bound(value) }
machine computed(value: u64[0..=128 + 128]) -> u64 { upper_bound(value) }
machine full_width(value: u64[0..=18446744073709551615u64 % 512u64]) -> u64 { upper_bound(value) }
machine wide_intermediate(value: u64[0..=9223372036854775808u64 + 256 - 9223372036854775808u64]) -> u64 { upper_bound(value) }
machine computed_exclusive(value: u64[0..128 * 2 + 1]) -> u64 { upper_bound(value) }
machine fractional(value: u64[0..=1 / 2 * 512]) -> u64 { upper_bound(value) }
machine call_fractional() -> u64 { fractional(256) }
machine explicit(value: u64[0..=256]) -> u64 { upper_bound<512>(value) }
machine limit() -> u64 { 256 }
machine named(value: u64[0..=limit()]) -> u64 { upper_bound(value) }
machine call_named() -> u64 { named(256) }
machine named_exclusive(value: u64[0..limit()]) -> u64 { upper_bound(value) }
machine wide_limit() -> u64 { 18446744073709551615 }
machine named_full_width(value: u64[0..=wide_limit()]) -> u64 { upper_bound(value) }
machine named_full_width_exclusive(value: u64[0..wide_limit()]) -> u64 { upper_bound(value) }
machine negative_limit() -> i64 { -1 }
machine named_signed(value: i64[-2..=negative_limit()]) -> i64 { value }
data Limits {}
machine Limits::capacity() -> u64 { 256 }
machine scoped_named(value: u64[0..=Limits::capacity()]) -> u64 { upper_bound(value) }
data OtherLimits {}
machine OtherLimits::capacity() -> u64 { 512 }
machine capacity() -> u64 { 17 }
machine scoped_other(value: u64[0..OtherLimits::capacity()]) -> u64 { upper_bound(value) }
machine free_capacity(value: u64[0..=capacity()]) -> u64 { upper_bound(value) }
machine exclusive_full_u64(value: u64[0..18446744073709551616]) -> u64 { upper_bound(value) }
machine inclusive_to_exclusive(value: u64[0..=256]) -> u64 { exclusive_upper_bound(value) }
machine exclusive_to_inclusive(value: u64[0..257]) -> u64 { upper_bound(value) }
machine typed_exclusive(value: u64[0..7u64 / 2 * 2]) -> u64 { upper_bound(value) }
machine endpoint(value: u64) -> u64 { value }
machine argument_named(value: u64[0..=endpoint(256)]) -> u64 { upper_bound(value) }
machine argument_fractional(value: u64[0..=endpoint(1 / 2 * 512)]) -> u64 { upper_bound(value) }
machine argument_full_width(value: u64[0..=endpoint(18446744073709551615u64)]) -> u64 { upper_bound(value) }
machine Limits::endpoint(value: u64) -> u64 { value }
machine argument_scoped(value: u64[0..Limits::endpoint(257)]) -> u64 { upper_bound(value) }
machine choose_endpoint(first: u64, second: u64) -> u64 { second }
machine argument_order(value: u64[0..=choose_endpoint(17, 256)]) -> u64 { upper_bound(value) }
machine nested_argument(value: u64[0..=endpoint(endpoint(limit()))]) -> u64 { upper_bound(value) }
machine nested_arithmetic(value: u64[0..=endpoint(Limits::capacity() / 2 + endpoint(128))]) -> u64 { upper_bound(value) }
machine surrounding_arithmetic(value: u64[0..Limits::capacity() + endpoint(1)]) -> u64 { upper_bound(value) }
machine nested_fractional(value: u64[0..=endpoint(endpoint(1 / 2 * 512))]) -> u64 { upper_bound(value) }
machine nested_full_width(value: u64[0..=endpoint(wide_limit())]) -> u64 { upper_bound(value) }
machine surrounding_full_width(value: u64[0..=wide_limit() % 512u64]) -> u64 { upper_bound(value) }
data BoundedValue [copy] { value: u64[0..=endpoint(endpoint(256))]; }
machine field_bound() -> u64 {
    let bounded: BoundedValue = BoundedValue { value: 0 };
    upper_bound(bounded.value)
}
data ScopedBounds [copy] { first: u64[0..=Limits::capacity()]; second: u64[0..OtherLimits::capacity()]; }
machine field_scoped_exclusive() -> u64 {
    let bounded: ScopedBounds = ScopedBounds { second: 511, first: 256 };
    upper_bound(bounded.second)
}

data Main { console: Console; }
machine Main::main(&mut self) reaches Console {
    let bound: u64 = inferred(0);
    transition bound == 256 {
        true -> passed()
        false -> failed()
    }
    state passed(&mut self) { self.console.exit_process(70); }
    state failed(&mut self) { self.console.exit_process(71); }
}
