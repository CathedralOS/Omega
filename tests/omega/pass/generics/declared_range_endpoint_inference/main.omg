use omega_language_std::console;

machine upper_bound<const N: u64>(value: u64) -> u64 { N }
machine exclusive_upper_bound<const N: u64>(value: u64) -> u64 { N }

machine inferred(value: u64) -> u64 requires value <= 256 { upper_bound<256>(value) }
machine computed(value: u64) -> u64 requires value <= 128 + 128 { upper_bound<256>(value) }
machine full_width(value: u64) -> u64 requires value <= 18446744073709551615u64 % 512u64 { upper_bound<511>(value) }
machine wide_intermediate(value: u64) -> u64 requires value <= 9223372036854775808 + 256 - 9223372036854775808 { upper_bound<256>(value) }
machine computed_exclusive(value: u64) -> u64 requires value < 128 * 2 + 1 { upper_bound<256>(value) }
machine fractional(value: u64) -> u64 requires value <= 1 / 2 * 512 { upper_bound<256>(value) }
machine call_fractional() -> u64 { fractional(256) }
machine explicit(value: u64) -> u64 requires value <= 256 { upper_bound<512>(value) }
machine limit() -> u64 { 256 }
machine named(value: u64) -> u64 requires value <= limit() { upper_bound<256>(value) }
machine call_named() -> u64 { named(256) }
machine named_exclusive(value: u64) -> u64 requires value < limit() { upper_bound<255>(value) }
machine wide_limit() -> u64 { 18446744073709551615 }
machine named_full_width(value: u64) -> u64 requires value <= wide_limit() { upper_bound<18446744073709551615>(value) }
machine named_full_width_exclusive(value: u64) -> u64 requires value < wide_limit() { upper_bound<18446744073709551614>(value) }
machine negative_limit() -> i64 { -1 }
machine named_signed(value: i64) -> i64 requires value >= -2 && value <= negative_limit() { value }
data Limits {}
machine Limits::capacity() -> u64 { 256 }
machine scoped_named(value: u64) -> u64 requires value <= Limits::capacity() { upper_bound<256>(value) }
data OtherLimits {}
machine OtherLimits::capacity() -> u64 { 512 }
machine capacity() -> u64 { 17 }
machine scoped_other(value: u64) -> u64 requires value < OtherLimits::capacity() { upper_bound<511>(value) }
machine free_capacity(value: u64) -> u64 requires value <= capacity() { upper_bound<17>(value) }
machine exclusive_full_u64(value: u64) -> u64 { upper_bound<18446744073709551615>(value) }
machine inclusive_to_exclusive(value: u64) -> u64 requires value <= 256 { exclusive_upper_bound<257>(value) }
machine exclusive_to_inclusive(value: u64) -> u64 requires value < 257 { upper_bound<256>(value) }
machine typed_exclusive(value: u64) -> u64 requires value < 7u64 / 2 * 2 { upper_bound<5>(value) }
machine endpoint(value: u64) -> u64 { value }
machine argument_named(value: u64) -> u64 requires value <= endpoint(256) { upper_bound<256>(value) }
machine argument_fractional(value: u64) -> u64 requires value <= endpoint(1 / 2 * 512) { upper_bound<256>(value) }
machine argument_full_width(value: u64) -> u64 requires value <= endpoint(18446744073709551615u64) { upper_bound<18446744073709551615>(value) }
machine Limits::endpoint(value: u64) -> u64 { value }
machine argument_scoped(value: u64) -> u64 requires value < Limits::endpoint(257) { upper_bound<256>(value) }
machine choose_endpoint(first: u64, second: u64) -> u64 { second }
machine argument_order(value: u64) -> u64 requires value <= choose_endpoint(17, 256) { upper_bound<256>(value) }
machine nested_argument(value: u64) -> u64 requires value <= endpoint(endpoint(limit())) { upper_bound<256>(value) }
machine nested_arithmetic(value: u64) -> u64 requires value <= endpoint(Limits::capacity() / 2 + endpoint(128)) { upper_bound<256>(value) }
machine surrounding_arithmetic(value: u64) -> u64 requires value < Limits::capacity() + endpoint(1) { upper_bound<256>(value) }
machine nested_fractional(value: u64) -> u64 requires value <= endpoint(endpoint(1 / 2 * 512)) { upper_bound<256>(value) }
machine nested_full_width(value: u64) -> u64 requires value <= endpoint(wide_limit()) { upper_bound<18446744073709551615>(value) }
machine surrounding_full_width(value: u64) -> u64 requires value <= wide_limit() % 512u64 { upper_bound<511>(value) }
machine constrained_argument(value: u64) -> u64 requires value <= bounded_endpoint(256) { upper_bound<256>(value) }
machine constrained_result(value: u64) -> u64 requires value <= endpoint(bounded_value()) { upper_bound<256>(value) }
machine constrained_composition(value: u64) -> u64 requires value <= bounded_endpoint(bounded_value()) { upper_bound<256>(value) }
machine constrained_wide(value: u64) -> u64 requires value <= bounded_wide(wide_limit()) { upper_bound<18446744073709551615>(value) }
machine bounded_endpoint(value: u64) -> u64 { value }
machine bounded_value() -> u64 ensures result <= 256 { 256 }
machine bounded_wide(value: u64) -> u64 { value }
machine later_limit() -> u64 { 256 }
data BoundedValue [copy] where value <= endpoint(endpoint(256)) { value: u64; }
data RangeValue<T [copy]> [copy] { value: T; }
machine generic_field_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<256>(bounded.value)
}
machine generic_equivalent_bound() -> u64 {
    let inclusive: RangeValue<u64> = RangeValue { value: 0 };
    let exclusive: RangeValue<u64> = inclusive;
    let computed: RangeValue<u64> = exclusive;
    upper_bound<256>(computed.value)
}
machine generic_wide_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<18446744073709551615>(bounded.value)
}
const RANGE_CAPACITY: u64 = 256;
machine generic_named_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<RANGE_CAPACITY>(bounded.value)
}
machine generic_call_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<256>(bounded.value)
}
machine generic_exclusive_call_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<255>(bounded.value)
}
machine generic_scoped_call_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<256>(bounded.value)
}
machine generic_argument_call_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<256>(bounded.value)
}
machine generic_nested_call_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<256>(bounded.value)
}
machine generic_signed_call_bound() -> i64 {
    let bounded: RangeValue<i64> = RangeValue { value: -2 };
    bounded.value
}
machine generic_free_capacity_bound() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 0 };
    upper_bound<17>(bounded.value)
}
data ForwardRange<T [copy]> [copy] { inner: RangeValue<T>; }
machine generic_narrow_signed_value() -> i8 {
    let bounded: ForwardRange<i8> = ForwardRange { inner: RangeValue { value: -3 } };
    bounded.inner.value
}
machine generic_full_width_value() -> u64 {
    let bounded: RangeValue<u64> = RangeValue { value: 18446744073709551615u64 };
    bounded.value
}
machine generic_forwarded_bound() -> u64 {
    let bounded: ForwardRange<u64> = ForwardRange { inner: RangeValue { value: 0 } };
    upper_bound<256>(bounded.inner.value)
}
machine field_bound() -> u64 {
    let bounded: BoundedValue = BoundedValue { value: 0 };
    upper_bound<256>(bounded.value)
}
data ScopedBounds [copy] where first <= 256 && second < 512 { first: u64; second: u64; }
machine field_scoped_exclusive() -> u64 {
    let bounded: ScopedBounds = ScopedBounds { second: 511, first: 256 };
    upper_bound<511>(bounded.second)
}
machine forward_bound<const K: u64>(value: u64) -> u64 requires value <= K { upper_bound<K>(value) }
machine relay_bound<const J: u64>(value: u64) -> u64 requires value <= J { forward_bound<J>(value) }
machine forwarded_bound(value: u64) -> u64 requires value <= 256 { forward_bound<256>(value) }
machine relayed_bound(value: u64) -> u64 requires value <= 256 { relay_bound<256>(value) }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let bound: u64 = inferred(0);
    let forwarded: u64 = generic_forwarded_bound();
    let signed: i64 = generic_signed_call_bound();
    let narrow: i8 = generic_narrow_signed_value();
    let wide: u64 = generic_full_width_value();
    let symbolic: u64 = forwarded_bound(0);
    let relayed: u64 = relayed_bound(0);
    transition bound == 256 && forwarded == 256 && signed == -2 && narrow == -3 && wide == 18446744073709551615u64 && symbolic == 256 && relayed == 256 {
        true -> passed(main)
        false -> failed(main)
    }
    machine passed(main: &mut Main) { Console::exit_process(70); }
    machine failed(main: &mut Main) { Console::exit_process(71); }
}

machine wrapping_endpoint(value: u8 in Wrapping) -> u64 { (value + 2) as u64 }
machine saturating_endpoint(value: u8 in Saturating) -> u64 { (value + 2) as u64 }
machine wrapping_policy_bound(value: u64) -> u64 requires value <= wrapping_endpoint(255) {
    upper_bound<257>(value)
}
machine saturating_policy_bound(value: u64) -> u64 requires value <= saturating_endpoint(255) {
    upper_bound<257>(value)
}
machine composed_wrapping_policy_bound(value: u64) -> u64 requires value <= wrapping_endpoint(255) + 256 {
    upper_bound<513>(value)
}
machine match_wrapping_policy_bound(value: u64) -> u64 requires value <= wrapping_endpoint((match true { true -> 254, false -> 0 }) + 1) {
    upper_bound<257>(value)
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
