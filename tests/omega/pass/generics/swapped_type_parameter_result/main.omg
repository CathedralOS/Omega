// `swap<A, B>(pair: Pair<A, B>) -> Pair<B, A>` substitutes `A` with `B` and
// `B` with `A`. The claim frontier's substituted multiplicity followed every
// replacement that differed from the current occurrence, so the two
// parameters sent it round for ever and package review of
// `samples/cli/probes/generic_data_match` overflowed the compile stack. An
// occurrence met twice is judged as the declaration's own multiplicity.
data Pair<A, B> {
    first: A;
    second: B;
}

machine swap<A, B>(pair: Pair<A, B>) -> Pair<B, A> {
    Pair { first: pair.second, second: pair.first }
}

machine main() -> i32 {
    let p: Pair<u64, i32> = Pair { first: 20, second: 1 };
    let q: Pair<i32, u64> = swap(p);
    q.first
}
