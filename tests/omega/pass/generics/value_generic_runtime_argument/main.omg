// A runtime-capable value binder `Count: u32` admits an ordinary runtime
// subject: the specialization realizes `Count` as a trailing ordinary
// parameter and each rewritten call site appends its exact subject as an
// argument. Statically known arguments keep the const substitution path, so
// both tuples of one template coexist. A generic caller also forwards its own
// runtime-bound binder as an ordinary argument, and its own `requires`
// contract discharges the callee's obligation on that forwarded subject.
// A contract that mentions the binder denotes that realized parameter, so
// each call site owes the obligation on its own captured subject —
// established here by a literal initializer, a reassigned current value, and
// a dominating transition guard. The same captured subject indexes an
// attached scalar field: `requires Count <= 7` plus the `u32` carrier prove
// `self.values[Count]` in bounds for reads and writes alike, and the
// specialized clone keeps ownership of the attached `values` member so the
// `&mut self` state may write it.

data Main {
    values: [u32; 8];
}

machine prefix_count<Count: u32>(base: u32) -> u32 {
    Count
}

machine forward<K: u32>(base: u32) -> u32 {
    let inner: u32 = prefix_count<K>(base);
    inner
}

machine bounded<Count: u32>(base: u32) -> u32
requires
    Count <= 10;
{
    Count
}

machine forward_bounded<K: u32>(base: u32) -> u32
requires
    K <= 10;
{
    let inner: u32 = bounded<K>(base);
    inner
}

machine Main::at<Count: u32>(&self) -> u32
requires
    Count <= 7;
{
    self.values[Count]
}

machine Main::put<Count: u32>(&mut self, v: u32)
requires
    Count <= 7;
{
    self.values[Count] = v;
}

machine Main::main(&mut self) {
    let n: u32 = 3;
    let direct: u32 = prefix_count<n>(7);
    let forwarded: u32 = forward<n>(7);
    let closed: u32 = prefix_count<4>(7);
    let obliged: u32 = bounded<n>(7);
    let chained: u32 = forward_bounded<n>(7);
    let mut reassigned: u32 = 3;
    reassigned = 4;
    let current: u32 = bounded<reassigned>(7);
    self.put<n>(10);
    reassigned = 5;
    self.put<reassigned>(20);
    let indexed: u32 = self.at<reassigned>();
    let static_indexed: u32 = self.at<3>();
    transition n <= 10 {
        true -> allowed(n)
        false -> denied()
    }
    state allowed(&mut self, n: u32) {
        let guarded: u32 = bounded<n>(7);
    }
    state denied(&mut self) {}
}
