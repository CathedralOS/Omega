// PDI3: an exact state-local equality may discharge an otherwise distinct
// open indexed-domain result. The equality stays evidence; it does not merge
// the two normalized domain identities. The consuming machine's explicit
// conformance bound supplies the spelled operation and its checked law slots.
use omega_language_std::console;
use omega::language::core::binding;

domain<T, const I: u64> T::Indexed<I>;
domain<T, const I: u64, const J: u64> T::PairIndexed<I, J>;

data ZeroHolder {
    value: i64 in Indexed<0>;
}

data Nat {
    tag: u8;
}

trait IndexAdd<Operand> {
    operator + add(a: Operand, b: Operand) -> Operand;
    machine add_comm(a: Operand, b: Operand)
    ensures add(a, b) == add(b, a);
    machine add_assoc(a: Operand, b: Operand, c: Operand)
    ensures add(add(a, b), c) == add(a, add(b, c));
}

machine plus_index(a: u64, b: u64) -> u64
satisfies IndexAdd<u64>::add as Canonical
ensures result == 0
{
    transition { _ -> 0 }
}

machine plus_index_comm(a: u64, b: u64)
satisfies IndexAdd<u64>::add_comm as Canonical
requires plus_index(a, b) == plus_index(b, a)
ensures plus_index(a, b) == plus_index(b, a)
{
    _ = plus_index(a, b);
    _ = plus_index(b, a);
}

machine plus_index_assoc(a: u64, b: u64, c: u64)
satisfies IndexAdd<u64>::add_assoc as Canonical
requires plus_index(plus_index(a, b), c) == plus_index(a, plus_index(b, c))
ensures plus_index(plus_index(a, b), c) == plus_index(a, plus_index(b, c))
{
    _ = plus_index(plus_index(a, b), c);
    _ = plus_index(a, plus_index(b, c));
}

machine retain_identity<T, const A: u64, Canonical: T satisfies IndexAdd<u64>>(
    value: i64 in Indexed<A>
) -> i64 in Indexed<A + 0>
requires A == A + 0
{
    value
}

machine establish_zero<T, const A: u64, Canonical: T satisfies IndexAdd<u64>>(
    a: u64
) -> u64
requires a + 0 == 0
ensures a == a && a + 0 == 0
{
    _ = plus_index(a, 0);
    transition { _ -> 0 }
}

machine retain_cited_zero<T, const A: u64, Canonical: T satisfies IndexAdd<u64>>(
    value: i64 in Indexed<A + 0>
) -> i64 in Indexed<0>
requires A + 0 == 0
{
    _ = establish_zero<T, A, Canonical>(A);
    value
}

machine retain_cited_pair<T, const A: u64, const B: u64, Canonical: T satisfies IndexAdd<u64>>(
    value: i64 in PairIndexed<A + 0, B + 0>
) -> i64 in PairIndexed<0, 0>
requires A + 0 == 0
requires B + 0 == 0
{
    _ = establish_zero<T, A, Canonical>(A);
    _ = establish_zero<T, B, Canonical>(B);
    value
}

machine return_cited_zero<T, const A: u64, Canonical: T satisfies IndexAdd<u64>>(
    a: u64,
    value: i64 in Indexed<A + 0>
) -> i64 in Indexed<A + 0>
requires a + 0 == 0
ensures a + 0 == 0
{
    _ = establish_zero<T, A, Canonical>(a);
    transition { _ -> (0 as i64 in Indexed<A + 0>) }
}

// The field check discharges against this machine's declared requires
// hypothesis, which also establishes the nested call's instantiated
// obligation.
machine retain_nested_result_fact<T, const A: u64, Canonical: T satisfies IndexAdd<u64>>(
    value: i64 in Indexed<A + 0>
) -> ZeroHolder
requires A + 0 == 0
{
    ZeroHolder { value: return_cited_zero<T, A, Canonical>(A, value) }
}

Canonical:
    Nat satisfies IndexAdd<u64>
{
    IndexAdd::add = plus_index;
    IndexAdd::add_comm = plus_index_comm;
    IndexAdd::add_assoc = plus_index_assoc;
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    self.console.exit_process(70);
}
