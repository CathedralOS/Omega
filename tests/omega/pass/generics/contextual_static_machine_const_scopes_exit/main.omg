machine accepts<'borrow, Kind>(value: &'borrow Kind) -> bool { true }

machine apply<const Count: u64, machine Callback>(value: &[u8; Count]) -> bool
where machine Callback(value: &[u8; Count]) -> bool;
{ Callback(value) }

machine first<const Count: u64>(value: &[u8; Count]) -> bool {
    apply<Count, accepts>(value)
}

machine second<const Count: u64>(value: &[u8; Count]) -> bool {
    apply<Count, accepts>(value)
}

machine main() crashes Trap {
    let pair: [u8; 2] = [1u8, 2u8];
    let large: [u8; 17] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8,
        10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8];
    let first_result: bool = first<2>(&pair);
    let second_result: bool = second<17>(&large);
    transition first_result && second_result {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
