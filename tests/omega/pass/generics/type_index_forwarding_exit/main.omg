// Expected exit: 0. Exact type indices survive calls, fields and state transfer.
domain<Value> u64::Tagged<Value>;
domain<Left, Right> u64::Pair<Left, Right>;
domain<Value, const Count: u64> u64::Counted<Value, Count>;
domain<const Enabled: bool> u64::Flagged<Enabled>;
data Word {}
data Other {}
data Box<Value> { value: Value; }
data Holder<Value> { value: u64 in Tagged<Value>; }

machine identity<Value>(value: u64 in Tagged<Value>) -> u64 in Tagged<Value> {
    value
}
machine forward<Value>(value: u64 in Tagged<Value>) -> u64 in Tagged<Value> {
    let local: u64 in Tagged<Value> = identity<Value>(value);
    identity<Value>(local)
}
machine field<Value>(holder: Holder<Value>) -> u64 in Tagged<Value> {
    forward<Value>(holder.value)
}
machine later<Value>(value: u64 in Tagged<Value>) -> u64 in Tagged<Value> {
    transition { _ -> selected(value) }
    machine selected(value: u64 in Tagged<Value>) -> u64 in Tagged<Value> {
        forward<Value>(value)
    }
}
machine pair<Left, Right>(value: u64 in Pair<Left, Right>) -> u64 in Pair<Left, Right> {
    value
}
machine swapped<Left, Right>(value: u64 in Pair<Right, Left>) -> u64 in Pair<Right, Left> {
    pair<Right, Left>(value)
}
machine counted<Value, const Count: u64>(value: u64 in Counted<Value, Count>)
    -> u64 in Counted<Value, Count>
{
    value
}
machine forward_counted<Value, const Count: u64>(value: u64 in Counted<Value, (Count)>)
    -> u64 in Counted<Value, Count>
{
    counted<Value, Count>(value)
}
machine nested<Value>() -> u64 {
    let value: u64 in Tagged<Value> = 29;
    let result: u64 in Tagged<Value> = forward<Value>(value);
    result as u64
}
machine compound<Value>(value: u64 in Tagged<Box<Value>>) -> u64 in Tagged<Box<Value>> {
    forward<Box<Value>>(value)
}
machine forward_compound<Outer>(value: u64 in Tagged<Box<Outer>>) -> u64 in Tagged<Box<Outer>> {
    compound<Outer>(value)
}
machine compound_pair<Left, Right>(value: u64 in Pair<Box<Left>, Box<Right>>)
    -> u64 in Pair<Box<Left>, Box<Right>>
{
    pair<Box<Left>, Box<Right>>(value)
}
machine swapped_compound<Left, Right>(value: u64 in Pair<Box<Right>, Box<Left>>)
    -> u64 in Pair<Box<Right>, Box<Left>>
{
    compound_pair<Right, Left>(value)
}
machine flagged<const Enabled: bool>(value: u64 in Flagged<Enabled>) -> u64 in Flagged<Enabled> {
    value
}
machine forward_flagged<const Enabled: bool>(value: u64 in Flagged<Enabled>) -> u64 in Flagged<Enabled> {
    flagged<Enabled>(value)
}
machine main() crashes Trap {
    let value: u64 in Tagged<Word> = 17;
    let holder: Holder<Word> = Holder { value: value };
    let from_field: u64 in Tagged<Word> = field<Word>(holder);
    let from_state: u64 in Tagged<Word> = later<Word>(from_field);
    let from_nested: u64 = nested<Box<Word>>();
    let compound_value: u64 in Tagged<Box<Word>> = 37;
    let from_compound: u64 in Tagged<Box<Word>> = forward_compound<Word>(compound_value);
    let paired: u64 in Pair<Other, Word> = 31;
    let from_swapped: u64 in Pair<Other, Word> = swapped<Word, Other>(paired);
    let counted_value: u64 in Counted<Word, 7> = 43;
    let from_counted: u64 in Counted<Word, 7> = forward_counted<Word, 7>(counted_value);
    let compound_pair_value: u64 in Pair<Box<Other>, Box<Word>> = 47;
    let from_compound_pair: u64 in Pair<Box<Other>, Box<Word>> =
        swapped_compound<Word, Other>(compound_pair_value);
    let flagged_value: u64 in Flagged<true> = 53;
    let from_flagged: u64 in Flagged<true> = forward_flagged<true>(flagged_value);
    transition from_state == 17 && from_nested == 29 && from_compound == 37
        && from_swapped == 31 && from_counted == 43 && from_compound_pair == 47 && from_flagged == 53 {
        true -> {}
        false -> bad()
    }
    machine bad() { crash Trap; }
}
