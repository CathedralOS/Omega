// Expected exit: 0. The selected map's numeric actual has no hidden borrow;
// forwarding a distinct linear grant must not require an invented loan origin.
use omega::language::core::extent;
use omega::language::core::process_exit;
use omega_language_std::process_exit;

SyntheticRoot satisfies ExtentRootProvider {
    machine grant(storage: Extent) -> Extent { storage }
}
data Word { value: u64; }
trait Carry<Value> {
    machine carry(storage: Extent in Granted, value: Value) -> Extent in Granted;
}
Selected<T, Role> satisfies Carry<T> {
    machine carry(storage: Extent in Granted, value: T) -> Extent in Granted { storage }
}
machine forward<Role>(storage: Extent in Granted) -> Extent in Granted {
    Selected<Word, Role>::carry(storage, Word { value: 37 })
}
machine main() reaches ExtentRootProvider + ProcessExit {
    let storage: Extent in Granted = ExtentRootProvider::grant(Extent { base: 4096, length: 16 });
    let retained: Extent in Granted = forward<u8>(storage);
    transition retained.length == 16 { true -> finish(retained, 0) _ -> finish(retained, 1) }
    machine finish(retained: Extent in Granted, status: i32) { ProcessExit::exit_process(status); }
}
