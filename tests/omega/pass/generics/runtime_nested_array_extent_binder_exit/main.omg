use shapes::Count;
const Count: u64 = 4;
data Counts {}
const Counts::FOUR: u64 = 4;
data Holder<Value [copy]> [copy] { value: Value; }
data Sized<Payload [copy], Element [copy], const Count: u64> [copy]
where Payload == [Element; Count] {
    nested: Holder<[u64; Count]>;
    fixed: Holder<[u64; Counts::FOUR]>;
    payload: Payload;
    identity: shapes::Count;
}
data Main {
    integers: Sized<[u64; 2]>;
    booleans: Sized<[bool; 3]>;
}
machine main(main: &mut Main) crashes Trap {
    main.integers.nested.value[1] = 17;
    main.booleans.nested.value[2] = 31;
    main.integers.payload[1] = 19;
    main.booleans.payload[2] = true;
    main.integers.fixed.value[3] = 23;
    main.integers.identity.value = 29;
    transition main.integers.nested.value[1] == 17
        && main.booleans.nested.value[2] == 31
        && main.integers.payload[1] == 19
        && main.booleans.payload[2]
        && main.integers.fixed.value[3] == 23
        && main.integers.fixed.value.len == 4
        && main.integers.identity.value == 29
        && main.integers.nested.value.len == 2
        && main.booleans.nested.value.len == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
