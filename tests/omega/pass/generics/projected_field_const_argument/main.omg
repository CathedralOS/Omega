// A field read through a generic application is typed in the reader's binders.
// `binding.source` has type `Source<Actors>` with this machine's `Actors`, so a
// transition on it needs no annotation (substitution follows declaration
// identity through field types, const arguments included).
data Source<const Actors: u64> [copy]
requires Actors >= 1
{
    case Input(device: u32);
    case Pursuit(target: u64);
}

data Binding<const Actors: u64> [copy]
requires Actors >= 1, actor < Actors {
    actor: u64;
    source: Source<Actors>;
}

machine route<const Actors: u64>(binding: Binding<Actors>)
terminates
requires Actors >= 1 {
    transition binding.source {
        Source::Input { device } -> done()
        Source::Pursuit { target } -> done()
    }
    machine done() {}
}

machine main() {
    let binding: Binding<2> = Binding { actor: 0, source: Source::Input { device: 7 } };
    route<2>(binding);
}
