// Expected exit: 0
const N: u32 = 0;
const SEVEN: u64 = 7;
machine chosen<const N: u64>() -> u64 ensures result == N { N }
machine forwarded<const N: u64>() -> u64
requires N >= 1
ensures result >= N
{ chosen<N>() }
machine main() crashes Trap {
    let value: u64 = forwarded<SEVEN>();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
