// A sum stores only its active payload. A growing reference edge retains its
// finite identity without demanding another pointee's storage declaration.
data Cell { value: i32; }
data Chain<'next, Element> {
    case End(value: Element);
    case More(target: &'next Chain<'next, [Element; 2]>);
}

machine read_pair<'storage, 'borrow>(node: &'borrow Chain<'storage, [i32; 2]>) -> i32 {
    transition node {
        Chain::End { value } -> (value[0])
        Chain::More { target } -> 0
    }
}

machine read<'storage, 'borrow>(node: &'borrow Chain<'storage, i32>) -> i32 {
    transition node {
        Chain::End { value } -> value
        Chain::More { target } -> (read_pair(target))
    }
}

machine inspect_active<'storage>(inner: &'storage Chain<'storage, [i32; 2]>) -> i32 {
    let node: Chain<'storage, i32> = Chain::More { target: inner };
    read(&node)
}

machine exercise<'storage>(source: &'storage Cell) -> bool {
    let ordinary: Chain<'storage, i32> = Chain::End { value: source.value };
    let inner: Chain<'storage, [i32; 2]> = Chain::End { value: [29, 31] };
    read(&ordinary) == 17 && inspect_active(&inner) == 29
}

// Identically named payload fields stay in distinct case namespaces, even
// beneath a fixed array. Common mixed fields do not acquire a case prefix.
data Selection<'storage> {
    stamp: i32;
    case Left(target: &'storage Cell);
    case Right(target: &'storage Cell);
    case Empty;
}
// Returning and forwarding preserve the active descriptor, not a grant for
// every possible payload. Empty results retain no descriptor at all.
machine select<'storage>(
    left: bool, first: &'storage Cell, second: &'storage Cell
) -> Selection<'storage> {
    transition left {
        true -> Selection::Left { stamp: 3, target: first }
        false -> Selection::Right { stamp: 5, target: second }
    }
}
machine forward_selection<'storage>(value: Selection<'storage>) -> Selection<'storage> {
    value
}
machine empty_selection<'storage>(source: &'storage Cell) -> Selection<'storage> {
    Selection::Empty { stamp: 7 }
}
machine read_selection<'storage>(selection: &Selection<'storage>) -> i32 {
    transition selection {
        Selection::Left { target } -> target.value
        Selection::Right { target } -> target.value
        Selection::Empty -> 0
    }
}
machine exercise_selections<'storage>(source: &'storage Cell, other: &'storage Cell) -> bool {
    let left: Selection<'storage> = select(true, source, other);
    let right: Selection<'storage> = forward_selection(select(false, source, other));
    let vacant: Selection<'storage> = forward_selection(empty_selection(source));
    let direct: Selection<'storage> = forward_selection(Selection::Left { stamp: 11, target: source });
    let selections: [Selection<'storage>; 2] = [left, right];
    read_selection(&selections[0]) == 17 && read_selection(&selections[1]) == 19
        && read_selection(&vacant) == 0 && read_selection(&direct) == 17
}

// Exclusive payloads establish descriptors, not copies of their referents.
// Consuming a whole case or an enclosing record retires the captured loan.
data MutableSelection<'storage> {
    stamp: i32;
    case Left(target: &'storage mut Cell);
    case Right(target: &'storage mut Cell);
    case Empty;
}
data SelectionEnvelope<'storage> {
    selection: MutableSelection<'storage>;
    ready: bool;
}
machine write_exclusive(target: &mut Cell, stamp_matches: bool) -> bool {
    target.value = 23;
    stamp_matches
}
machine consume_exclusive<'storage>(selection: MutableSelection<'storage>) -> bool {
    let stamp_matches: bool = selection.stamp == 3;
    transition selection {
        MutableSelection::Left { target } -> (write_exclusive(&mut target, stamp_matches))
        MutableSelection::Right { target } -> (write_exclusive(&mut target, stamp_matches))
        MutableSelection::Empty -> false
    }
}
machine forward_exclusive<'storage>(selection: MutableSelection<'storage>) -> bool {
    consume_exclusive(selection)
}
machine consume_envelope<'storage>(envelope: SelectionEnvelope<'storage>) -> bool {
    envelope.ready && envelope.selection.stamp == 0
}
machine exercise_exclusive() -> bool {
    let mut cell: Cell = Cell { value: 17 };
    let selection: MutableSelection = MutableSelection::Left { stamp: 3, target: &mut cell };
    let forwarded: bool = forward_exclusive(selection);
    let envelope: SelectionEnvelope = SelectionEnvelope {
        ready: true,
        selection: MutableSelection::Right { target: &mut cell }
    };
    let consumed: bool = consume_envelope(envelope);
    forwarded && consumed && cell.value == 23
}

machine main() crashes Trap {
    let seed: Cell = Cell { value: 17 };
    let other: Cell = Cell { value: 19 };
    transition exercise(&seed) && exercise_selections(&seed, &other) && exercise_exclusive() {
        true -> passed()
        false -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
