// A sum stores only its active payload. A growing reference edge retains its
// finite identity without demanding another pointee's storage declaration.
data Cell { value: i32; }
data Chain<'next, Element> {
    case End(value: Element);
    case More(target: &'next Chain<'next, [Element; 2]>);
}
data ChainHolder<'next, 'bytes> { node: Chain<'next, i32>; bytes: &'bytes [u8]; }
machine byte_value(value: &u8) -> u8 { value }
machine read_holder<'next, 'bytes>(holder: &ChainHolder<'next, 'bytes>) -> u8 {
    transition holder.bytes.len > 0 {
        true -> (byte_value(&holder.bytes[0]))
        false -> 0
    }
}
machine read_first(bytes: &[u8]) -> u8 {
    transition bytes.len > 0 {
        true -> (byte_value(&bytes[0]))
        false -> 0
    }
}
machine forward_bytes<'bytes>(bytes: &'bytes [u8]) -> &'bytes [u8] { bytes }

machine read_pair<'storage, 'borrow>(node: &'borrow Chain<'storage, [i32; 2]>) -> i32 {
    transition node {
        Chain::End { value } -> (value[0])
        Chain::More { target } -> 0
    }
}

machine read<'storage, 'borrow>(node: &'borrow Chain<'storage, i32>) -> i32 {
    transition node {
        Chain::End { value } -> value
        Chain::More { target } -> (read_pair(target))
    }
}

machine inspect_active<'storage>(inner: &'storage Chain<'storage, [i32; 2]>) -> i32 {
    let node: Chain<'storage, i32> = Chain::More { target: inner };
    read(&node)
}

machine exercise<'storage, 'bytes>(source: &'storage Cell, bytes: &'bytes [u8; 4]) -> bool {
    let ordinary: Chain<'storage, i32> = Chain::End { value: source.value };
    let inner: Chain<'storage, [i32; 2]> = Chain::End { value: [29, 31] };
    let holder: ChainHolder<'storage, 'bytes> = ChainHolder {
        node: Chain::End { value: 37 }, bytes: &bytes[..]
    };
    let empty_holder: ChainHolder<'storage, 'bytes> = ChainHolder {
        node: Chain::End { value: 41 }, bytes: &bytes[0..0]
    };
    let offset_holder: ChainHolder<'storage, 'bytes> = ChainHolder {
        node: Chain::End { value: 43 }, bytes: &bytes[1..3]
    };
    // The selected field and byte-view backing do not depend on unrelated
    // growing pointee layouts; both borrow their actual finite projections.
    let projected: &[u8] = forward_bytes(&holder.bytes);
    let first: u8 = byte_value(&bytes[0]);
    let view: &[u8] = &bytes[..];
    let first_reference: &u8 = &view[0];
    let second_reference: &u8 = &view[1];
    read(&ordinary) == 17 && inspect_active(&inner) == 29
        && read(&holder.node) == 37 && first == 71 && first_reference == 71
        && second_reference == 97
        && read_holder(&holder) == 71 && read_first(&holder.bytes) == 71
        && read_first(projected) == 71
        && read_holder(&empty_holder) == 0 && read_first(&empty_holder.bytes) == 0
        && read_holder(&offset_holder) == 97 && read_first(&offset_holder.bytes) == 97
}

// Identically named payload fields stay in distinct case namespaces, even
// beneath a fixed array. Common mixed fields do not acquire a case prefix.
data Selection<'storage> {
    stamp: i32;
    case Left(target: &'storage Cell);
    case Right(target: &'storage Cell);
    case Empty;
}
// Returning and forwarding preserve the active descriptor, not a grant for
// every possible payload. Empty results retain no descriptor at all.
machine select<'storage>(
    left: bool, first: &'storage Cell, second: &'storage Cell
) -> Selection<'storage> {
    transition left {
        true -> Selection::Left { stamp: 3, target: first }
        false -> Selection::Right { stamp: 5, target: second }
    }
}
machine forward_selection<'storage>(value: Selection<'storage>) -> Selection<'storage> {
    value
}
machine empty_selection<'storage>(source: &'storage Cell) -> Selection<'storage> {
    Selection::Empty { stamp: 7 }
}
machine read_selection<'storage>(selection: &Selection<'storage>) -> i32 {
    transition selection {
        Selection::Left { stamp as _, target } -> target.value
        Selection::Right { stamp as _, target } -> target.value
        Selection::Empty -> 0
    }
}
// A join carries one active payload, not simultaneous permissions for both
// alternatives. Copying conditional storage also preserves an empty payload.
data SharedSelection<'storage> [copy] {
    stamp: i32;
    case Left(target: &'storage Cell);
    case Right(target: &'storage Cell);
    case Empty;
}
data SharedHolder<'storage> [copy] { target: &'storage Cell; }
machine held_reference<'storage>(holder: SharedHolder<'storage>) -> &'storage Cell {
    transition { _ -> finish(holder) }
    state finish(holder: SharedHolder<'storage>) -> &'storage Cell { holder.target }
}
data SharedEnvelope<'storage> [copy] { selection: SharedSelection<'storage>; }
machine select_shared<'storage>(
    choice: i32, left: &'storage Cell, right: &'storage Cell
) -> SharedSelection<'storage> {
    transition choice {
        0 -> SharedSelection::Left { stamp: 3, target: left }
        1 -> SharedSelection::Right { stamp: 5, target: right }
        _ -> SharedSelection::Empty { stamp: 7 }
    }
}
machine forward_shared<'storage>(value: SharedSelection<'storage>) -> SharedSelection<'storage> {
    value
}
machine read_shared<'storage>(selection: &SharedSelection<'storage>) -> i32 {
    transition selection {
        SharedSelection::Left { stamp as _, target } -> target.value
        SharedSelection::Right { stamp as _, target } -> target.value
        SharedSelection::Empty -> 0
    }
}
machine read_joined_selection<'storage>(
    choice: i32, left: &'storage Cell, right: &'storage Cell
) -> i32 {
    transition choice {
        0 -> joined(SharedSelection::Left { stamp: 3, target: left })
        1 -> joined(SharedSelection::Right { stamp: 5, target: right })
        _ -> joined(SharedSelection::Empty { stamp: 7 })
    }
    state joined(selection: SharedSelection<'storage>) -> i32 {
        let copied: SharedSelection<'storage> = selection;
        transition copied {
            SharedSelection::Left { stamp as _, target } -> target.value
            SharedSelection::Right { stamp as _, target } -> target.value
            SharedSelection::Empty -> 0
        }
    }
}
machine exercise_selections<'storage>(source: &'storage Cell, other: &'storage Cell) -> bool {
    let left: Selection<'storage> = select(true, source, other);
    let right: Selection<'storage> = forward_selection(select(false, source, other));
    let vacant: Selection<'storage> = forward_selection(empty_selection(source));
    let direct: Selection<'storage> = forward_selection(Selection::Left { stamp: 11, target: source });
    let selections: [Selection<'storage>; 2] = [left, right];
    let holder: SharedHolder<'storage> = SharedHolder { target: source };
    let holders: [SharedHolder<'storage>; 2] = [holder, holder];
    let copied_holders: [SharedHolder<'storage>; 2] = holders;
    let returned_reference: &'storage Cell = held_reference(holder);
    let shared: SharedSelection<'storage> = select_shared(0, source, other);
    let shared_copy: SharedSelection<'storage> = forward_shared(shared);
    let shared_right: SharedSelection<'storage> = forward_shared(select_shared(1, source, other));
    let shared_empty: SharedSelection<'storage> = forward_shared(select_shared(2, source, other));
    let shared_direct: SharedSelection<'storage> = forward_shared(
        SharedSelection::Left { stamp: 11, target: source }
    );
    let shared_array: [SharedSelection<'storage>; 2] = [shared_copy, shared_right];
    let shared_envelope: SharedEnvelope<'storage> = SharedEnvelope { selection: shared };
    let shared_projected: SharedSelection<'storage> = forward_shared(shared_envelope.selection);
    read_selection(&selections[0]) == 17 && read_selection(&selections[1]) == 19
        && read_selection(&vacant) == 0 && read_selection(&direct) == 17
        && read_joined_selection(0, source, other) == 17
        && read_joined_selection(1, source, other) == 19
        && read_joined_selection(2, source, other) == 0
        && copied_holders[0].target.value == 17
        && copied_holders[1].target.value == 17
        && holder.target.value == 17 && holders[0].target.value == 17
        && returned_reference.value == 17
        && read_shared(&shared_array[0]) == 17 && read_shared(&shared_array[1]) == 19
        && read_shared(&shared) == 17 && shared.stamp == 3
        && read_shared(&shared_empty) == 0 && shared_empty.stamp == 7
        && read_shared(&shared_direct) == 17 && shared_direct.stamp == 11
        && read_shared(&shared_projected) == 17 && read_shared(&shared_envelope.selection) == 17
}

// Exclusive payloads establish descriptors, not copies of their referents.
// Consuming a whole case or an enclosing record retires the captured loan.
data MutableSelection<'storage> {
    stamp: i32;
    case Left(target: &'storage mut Cell);
    case Right(target: &'storage mut Cell);
    case Empty;
}
data SelectionEnvelope<'storage> {
    selection: MutableSelection<'storage>;
    ready: bool;
}
machine write_exclusive(target: &mut Cell, stamp_matches: bool) -> bool {
    target.value = 23;
    stamp_matches
}
machine consume_exclusive<'storage>(selection: MutableSelection<'storage>) -> bool {
    let stamp_matches: bool = selection.stamp == 3;
    transition selection {
        MutableSelection::Left { stamp as _, target } -> (write_exclusive(&mut target, stamp_matches))
        MutableSelection::Right { stamp as _, target } -> (write_exclusive(&mut target, stamp_matches))
        MutableSelection::Empty -> false
    }
}
machine forward_exclusive<'storage>(selection: MutableSelection<'storage>) -> bool {
    consume_exclusive(selection)
}
machine consume_envelope<'storage>(envelope: SelectionEnvelope<'storage>) -> bool {
    envelope.ready && envelope.selection.stamp == 0
}
machine exercise_exclusive() -> bool {
    let mut cell: Cell = Cell { value: 17 };
    let selection: MutableSelection = MutableSelection::Left { stamp: 3, target: &mut cell };
    let forwarded: bool = forward_exclusive(selection);
    let envelope: SelectionEnvelope = SelectionEnvelope {
        ready: true,
        selection: MutableSelection::Right { target: &mut cell }
    };
    let consumed: bool = consume_envelope(envelope);
    forwarded && consumed && cell.value == 23
}

machine main() crashes Trap {
    let seed: Cell = Cell { value: 17 };
    let other: Cell = Cell { value: 19 };
    let bytes: [u8; 4] = [71, 97, 116, 101];
    transition exercise(&seed, &bytes) && exercise_selections(&seed, &other) && exercise_exclusive() {
        true -> passed()
        false -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
