machine choose<'first, 'second>(left: &'first u64, right: &'second u64) -> &'first u64 { left }

machine apply<'left, 'right, machine Callback>(left: &'left u64, right: &'right u64) -> &'left u64
where machine Callback(left: &'left u64, right: &'right u64) -> &'left u64;
{ Callback(left, right) }

machine relay<'first, 'second>(left: &'first u64, right: &'second u64) -> &'first u64 {
    apply<choose<'first, 'second>>(left, right)
}

machine main() crashes Trap {
    let left: u64 = 42u64;
    let right: u64 = 17u64;
    let result: &u64 = relay(&left, &right);
    transition result == 42u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
