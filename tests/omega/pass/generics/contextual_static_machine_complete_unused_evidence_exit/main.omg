trait Probe<Kind> { machine probe(value: &Kind) -> bool; }

Positive satisfies Probe<u64> {
    machine probe(value: &u64) -> bool { false }
}

machine accepts<Kind, Evidence satisfies Probe<u64>>(value: &Kind) -> bool { true }

machine apply<Kind, machine Callback>(value: &Kind) -> bool
where machine Callback(value: &Kind) -> bool;
{ Callback(value) }

machine relay<Kind>(value: &Kind) -> bool {
    apply<Kind, accepts<Kind, Positive>>(value)
}

machine main() crashes Trap {
    let value: u64 = 42u64;
    let result: bool = relay<u64>(&value);
    transition result {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
