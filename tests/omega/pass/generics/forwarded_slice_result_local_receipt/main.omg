// Receiving a forwarded generic view in an annotated local, a terminal result
// or a transition value keeps checking when the element carrier corresponds,
// including a mutable view attenuated to shared access.
machine view<Element>(items: &[Element]) -> &[Element] { items }
machine received<Input>(items: &[Input]) -> &[Input] {
    let viewed: &[Input] = view<Input>(items);
    viewed
}
machine forwarded<Input>(items: &[Input]) -> &[Input] { view<Input>(items) }
machine selected<Input>(items: &[Input]) -> &[Input] {
    transition items.len > 0 {
        true -> (view<Input>(items))
        false -> (items)
    }
}
machine concrete(items: &[u8]) -> &[u8] { view<u8>(items) }
machine attenuated(items: &mut [u8]) -> u64 {
    let viewed: &[u8] = &mut items;
    0u64
}
machine main() {}
