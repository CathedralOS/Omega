// Expected exit: 0
// A checker's guarantee keeps the configured helper and its local borrow lifetime.
machine tagged_value<'borrow, const Tag: u64>(value: &'borrow u64) -> u64 reaches terminates { Tag }
machine first<'item>(value: &'item u64) -> u64 ensures result == tagged_value<37>(value) { 37 }
machine second<'item>(value: &'item u64) -> u64 ensures result == tagged_value<91>(value) { 91 }
machine apply<machine Required, machine Checker>(value: &u64) -> u64
requires machine Required<'call>(value: &'call u64) -> u64 reaches terminates;
requires machine Checker<'check>(value: &'check u64) -> u64 ensures result == Required(value);
{ Checker(value) }
machine main() crashes Trap {
    let value: u64 = 0;
    let first_result: u64 = apply<tagged_value<37>, first>(&value);
    let second_result: u64 = apply<tagged_value<91>, second>(&value);
    transition first_result == 37 && second_result == 91 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
