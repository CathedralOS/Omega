// Exact decimal subtraction beyond f64 precision must still leave three slots.
// Fractional intermediates and grouped signed exponents keep their rational value.
data FixedBuffer<const N: u64> { values: [u8; N]; }
data Main {
    precise: FixedBuffer<(9_007_199_254_740_993.0 - 9_007_199_254_740_992.0) + 2>;
    fraction: FixedBuffer<(1.2_5e+0_1 - .5) / 4>;
    exponent: FixedBuffer<3_0.0e-0_1>;
}
machine Main::main(main: &mut Main) crashes Trap {
    main.precise.values[2] = 37;
    main.fraction.values[2] = 38;
    main.exponent.values[2] = 39;
    transition main.precise.values[2] == 37 {
        true -> fraction(main)
        _ -> bad(main)
    }
    machine fraction(main: &mut Main) {
        transition main.fraction.values[2] == 38 {
            true -> exponent(main)
            _ -> bad(main)
        }
    }
    machine exponent(main: &mut Main) {
        transition main.exponent.values[2] == 39 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    machine good(main: &mut Main) {}
    machine bad(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
