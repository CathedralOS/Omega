// Expected exit: 0
// Calling two trait methods while evaluating a constant preserves both results.
data Observation [copy] { first: u64; last: u64; }
trait Reading {
    machine first() -> u64;
    machine last() -> u64;
}
Selected satisfies Reading {
    machine first() -> u64 { 11u64 }
    machine last() -> u64 { 29u64 }
}
machine observed<Operations satisfies Reading>() -> Observation {
    let first: u64 = Operations::first();
    let last: u64 = Operations::last();
    Observation { first: first, last: last }
}
const OBSERVED: Observation = observed<Selected>();
machine main() crashes Trap {
    transition OBSERVED.first == 11u64 && OBSERVED.last == 29u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
