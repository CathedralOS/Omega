use omega_language_std::console;

data Pair { case Both(a: u64 in Wrapping, b: u64 in Wrapping); }
data FixedBuffer<const N: u64> where N >= 2, selected <= 1 {
    items: [Pair; N];
    selected: u64;
    selections: u64 in Wrapping;
}

machine FixedBuffer::select<const N: u64>(buffer: &mut FixedBuffer<N>) -> u64
requires N >= 2
ensures result <= 1;
{
    buffer.selections = buffer.selections + 1;
    transition { _ -> buffer.selected }
}

machine FixedBuffer::total<const N: u64>(buffer: &mut FixedBuffer<N>) -> u64 in Wrapping
requires N >= 2;
{
    transition buffer.items[FixedBuffer::select(buffer)] {
        Pair::Both { a, b } -> sum(a + b)
    }
    machine sum(value: u64 in Wrapping) -> u64 in Wrapping {
        transition { _ -> value }
    }
}

data Main {
    small: FixedBuffer<2>;
    large: FixedBuffer<3>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.small.items[0] = Pair::Both { a: 1, b: 2 };
    main.small.items[1] = Pair::Both { a: 10, b: 20 };
    main.small.selected = 1;
    main.small.selections = 0;
    main.large.items[0] = Pair::Both { a: 3, b: 4 };
    main.large.items[1] = Pair::Both { a: 15, b: 25 };
    main.large.items[2] = Pair::Both { a: 5, b: 6 };
    main.large.selected = 1;
    main.large.selections = 0;
    let small: u64 in Wrapping = FixedBuffer::total(&mut main.small);
    let large: u64 in Wrapping = FixedBuffer::total(&mut main.large);
    transition small == 30 && large == 40
        && main.small.selections == 1 && main.large.selections == 1 {
        true -> finish(main, small + large)
        false -> finish(main, 1)
    }
    machine finish(main: &mut Main, value: u64 in Wrapping) {
        Console::exit_process(value as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
