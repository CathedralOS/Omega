// A literal 0 fits 0..N when the machine requires N >= 1.
// The const parameter does not change, so that requires stays a premise
// of the symbolic return range.
use omega_language_std::console;

machine origin<const N: u64>() -> u64
requires N >= 1 && N <= 8
ensures result < N
{
    0
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let start: u64 = origin<6>();
    transition start == 0 {
        true -> Console::exit_process(0)
        false -> Console::exit_process(1)
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
