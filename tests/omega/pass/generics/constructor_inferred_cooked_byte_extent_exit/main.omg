// Expected exit: 0
// Cooked UTF-8 octets plus one escaped byte infer the exact owned array extent.
data Packet<const Count: u64> [copy] { bytes: [u8; Count]; }
machine consume(value: Packet<3>) -> bool {
    value.bytes[0] == 195u8 && value.bytes[1] == 169u8 && value.bytes[2] == 7u8
}
machine program() crashes Trap {
    transition consume(Packet { bytes: "é\x07" }) { true -> done() false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
