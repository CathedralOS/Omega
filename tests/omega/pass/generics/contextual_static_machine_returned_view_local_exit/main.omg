data Holder<'captured> { reference: &'captured u64; }

machine retained<machine Outer>()
where machine Outer<Context, machine Inner>()
where machine Inner<'fresh>(context: Context, item: &'fresh u64) -> &'fresh u64;
{}

machine select<'invocation, Context>(context: Context, item: &'invocation u64) -> &'invocation u64 { item }

machine apply<'item, Context, machine Callback>(context: Context, item: &'item u64) -> &'item u64
where machine Callback<'fresh>(context: Context, item: &'fresh u64) -> &'fresh u64;
{
    let result: &'item u64 = Callback(context, item);
    result
}

machine relay<'environment, 'item>(context: Holder<'environment>, item: &'item u64) -> &'item u64 {
    let forwarded: &'item u64 = apply<Holder<'environment>, select<Holder<'environment>>>(context, item);
    forwarded
}

machine main() crashes Trap {
    let left: u64 = 17u64;
    let right: u64 = 42u64;
    let context: Holder = Holder { reference: &left };
    let result: &u64 = relay(context, &right);
    transition result == 42u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
