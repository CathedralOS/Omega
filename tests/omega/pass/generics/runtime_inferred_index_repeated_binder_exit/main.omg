// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: local.
// Expected exit: 0
data Counter { value: bool; }
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy]
where view.bytes.len == Count
{ view: View<'storage>; }
machine snapshot<'storage>(source: View<'storage>, counter: &mut Counter) -> Counted<'storage, (source.bytes.len)>
{ counter.value = !counter.value; Counted { view: source } }
trait Counting {
    machine snapshot<'storage>(source: View<'storage>, counter: &mut Counter) -> Counted<'storage, (source.bytes.len)>;
}
Direct satisfies Counting {
    machine snapshot<'storage>(source: View<'storage>, counter: &mut Counter) -> Counted<'storage, (source.bytes.len)>
    { counter.value = !counter.value; Counted { view: source } }
}
machine overwrite<'storage>(slot: &mut View<'storage>) -> u64 { slot.bytes = "123456789"; 0 }
machine seven(value: u64) -> u64 requires value == 7 ensures result == 7 { value }
machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, 7> = selected; seven(saved.view.bytes.len) }
machine receive_inferred<'storage, Count: u64>(selected: Counted<'storage, Count>, ignored: u64) -> u64
requires Count == 7
ensures result == 7
{ receive(selected, ignored) }
machine receive_pair<'storage, Count: u64>(left: Counted<'storage, Count>, right: Counted<'storage, Count>, ignored: u64) -> u64
requires Count == 7
ensures result == 7
{ receive(left, ignored) }
machine main() crashes Trap {
    let mut first_counter: Counter = Counter { value: false };
    let mut second_counter: Counter = Counter { value: false };
    let mut first: View = View { bytes: "1234567", sibling: "tail" };
    let second: View = View { bytes: "1234567", sibling: "tail" };
    let result: u64 = receive_pair(snapshot(first, &mut first_counter), Counting::snapshot(Direct as dyn Counting, second, &mut second_counter), overwrite(&mut first));
    let difference: u64 = result - 7;
    transition first_counter.value && second_counter.value && difference == 0 && first.bytes.len == 9 { true -> done() false -> wrong() }
    state done() {} state wrong() { crash Trap; }
}
