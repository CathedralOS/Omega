// The retained source field selector must rejoin the exact applied field.
machine count<T, machine Predicate>(values: &[T]) -> u64
where machine Predicate(value: &T) -> bool;
{
    transition { _ -> next(values, 0, 0) }
    machine next(values: &[T], position: u64, matched: u64) -> u64
    requires matched <= position && position <= values.len
    {
        transition position < values.len {
            true -> inspect(values, position, matched)
            false -> (matched)
        }
    }
    machine inspect(values: &[T], position: u64, matched: u64) -> u64
    requires matched <= position && position < values.len
    {
        transition Predicate(&values[position]) {
            true -> next(values, position + 1, matched + 1)
            false -> next(values, position + 1, matched)
        }
    }
}


machine positive(value: &i32) -> bool { value > 0 }
machine nonzero(value: &u8) -> bool { value != 0 }
data Batch<T, const Capacity: u64> { values: [T; Capacity]; guard: u64; }
machine scan_batch<T, const Capacity: u64, machine Predicate>(batch: &Batch<T, Capacity>) -> u64
where machine Predicate(value: &T) -> bool;
{ count<Predicate>(&batch.values) }
machine scan_local<T, const Capacity: u64, machine Predicate>(batch: &Batch<T, Capacity>) -> u64
where machine Predicate(value: &T) -> bool;
{ let values: &[T] = &batch.values; count<Predicate>(values) }
machine scan_state<T, const Capacity: u64, machine Predicate>(batch: &Batch<T, Capacity>) -> u64
where machine Predicate(value: &T) -> bool;
{
 transition { _ -> scan(batch) }
 machine scan(batch: &Batch<T, Capacity>) -> u64 { count<Predicate>(&batch.values) }
}
machine make_batch<T,const Capacity: u64>(values: [T;Capacity], guard: u64) -> Batch<T,Capacity> { Batch { values: values, guard: guard } }
machine scan_result() -> u64 {
 let batch: Batch<i32,3> = make_batch([0,1,2], 31);
 count<positive>(&batch.values)
}
machine main() crashes Trap {
 let signed: Batch<i32,3> = Batch { values: [0,1,2], guard: 73 };
 let bytes: Batch<u8,4> = Batch { values: [0,255,1,0], guard: 19 };
 let direct: u64 = scan_batch<positive>(&signed);
 let local: u64 = scan_local<positive>(&signed);
 let state: u64 = scan_state<nonzero>(&bytes);
 let returned: u64 = scan_result();
 transition direct == 2 && local == 2 && state == 2 && returned == 2
     && signed.guard == 73 && bytes.guard == 19 {
  true -> done() false -> wrong()
 }
 machine done() {} machine wrong() { crash Trap; }
}
