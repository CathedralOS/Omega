// Calls with fixed generic arguments must be checked inside generic functions, including unused ones.
// Expected exit: 0.
boundary trait Echo {
    machine echo<const Limit: u64>(value: u64) -> u64 reaches requires Limit > 0;
}
OrdinaryEcho satisfies Echo {
    machine echo<const Limit: u64>(value: u64) -> u64 requires Limit > 0 { value }
}
machine forward<const Tag: bool>(value: u64) -> u64 reaches Echo {
    Echo::echo<1>(value)
}
machine unused<const Tag: bool>() -> u64 reaches Echo {
    Echo::echo<1>(19)
}
machine main() reaches Echo crashes Trap {
    let first: u64 = forward<false>(73);
    let second: u64 = forward<true>(41);
    transition first == 73 && second == 41 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
