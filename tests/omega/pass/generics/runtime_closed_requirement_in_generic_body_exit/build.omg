machine build(builder: &mut Build) {
    Build::application(builder, "closed_requirement_in_generic_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Echo, OrdinaryEcho>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Echo, OrdinaryEcho>(builder, linux_x86_64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Echo, OrdinaryEcho>(builder, linux_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Echo, OrdinaryEcho>(builder, macos_arm64);
}
