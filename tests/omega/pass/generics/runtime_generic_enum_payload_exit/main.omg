// A MONOMORPHIZED generic ENUM with a T-typed payload, matched and destructured natively -- the
// `Optional<T>` shape: `Maybe<i32 in Wrapping>` constructed with `Some { value: 70 }`, matched, and
// the payload forwarded to a sub-state. The case also carries omitted nullary evidence whose
// semantic binding survives checking but whose storage is erased. Exit 70 via the material payload.
// Differential (native must match the interpreter).
use omega::language::std::console;
data Evidence { case Only; }
data Maybe<T> { case None; case Some(value: T, proof [erased]: Evidence); }
data Main { console: Console; m: Maybe<i32 in Wrapping>; }
machine Main::main(&mut self) {
    self.m = Maybe::Some { value: 70 };
    transition self.m {
        Maybe::Some { value, proof as _ } -> take(value)
        Maybe::None -> bad()
    }
    state take(&mut self, v: i32 in Wrapping) { self.console.exit_process(v as i32); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
