machine accepts<Kind>(value: &Kind) -> bool { true }

machine apply<const Count: u64, machine Callback>(value: &[u8; Count]) -> bool
where machine Callback(value: &[u8; Count]) -> bool;
{ Callback(value) }

machine relay<const Count: u64>(value: &[u8; Count]) -> bool {
    apply<Count, accepts>(value)
}

machine main() crashes Trap {
    let values: [u8; 2] = [1u8, 2u8];
    let result: bool = relay<2>(&values);
    transition result {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
