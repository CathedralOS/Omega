
domain<Carrier, const Index: u64> Carrier::Tagged<Index>;

data Box<Payload [copy], const Index: u64> [copy]
where
    Payload == u64::Tagged<Index>
{
    value: Payload;
}

data Reversed<const Index: u64, Payload [copy]> [copy]
where Payload == u64::Tagged<Index>
{ value: Payload; }

data Same<Left, Right, Payload [copy]> [copy]
where
    Left == [Payload; 1],
    Right == [Payload; 1]
{ value: Payload; }

data CarrierBox<Payload [copy], Carrier [copy], const Index: u64> [copy]
where Payload == Carrier::Tagged<Index>
{ value: Payload; }

data Main {
    carrier: CarrierBox<u64 in Tagged<8> >;
    box: Box<u64 in Tagged<8> >;
    reversed: Reversed<8>;
    repeated: Same<[u64 in Tagged<8>; 1], [u64 in Tagged<8>; 1]>;
}

machine main(main: &mut Main) crashes Trap {
    main.carrier.value = 13 as u64 in Tagged<8>;
    main.box.value = 7 as u64 in Tagged<8>;
    main.reversed.value = 9 as u64 in Tagged<8>;
    main.repeated.value = 11 as u64 in Tagged<8>;
    transition main.carrier.value as u64 == 13 && main.box.value as u64 == 7 && main.reversed.value as u64 == 9
        && main.repeated.value as u64 == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
