// Explicit record parameters preserve each const application's identity and
// concrete fixed-array layout across mutation, calls and state transitions.
use omega_language_std::console;

// `items[0]` reads discharge against the symbolic extent: the template must
// declare N >= 1 so index 0 is provably inside every admissible specialization.
data FixedBuffer<const N: u64> where N >= 1 {
    items: [i32 in Wrapping; N];
}

machine FixedBuffer::set_first<const N: u64>(buffer: &mut FixedBuffer<N>, value: i32 in Wrapping)
requires N >= 1;
{
    buffer.items[0] = value;
}

machine FixedBuffer::first<const Extent: u64>(buffer: &FixedBuffer<Extent>) -> i32 in Wrapping
requires Extent >= 1;
{
    let window: &[i32 in Wrapping] = &buffer.items[..Extent];
    transition { _ -> (buffer.items[0]) }
}

machine FixedBuffer::capacity<const N: u64>(buffer: &FixedBuffer<N>, witness: &[u8; N]) -> u64 {
    transition { _ -> N }
}

// A symbolic extent changes layout, not the empty lifetime frontier of u8.
machine preserve<const N: u64>(items: [u8; N]) -> [u8; N] { items }

data Main {
    small: FixedBuffer<2>;
    large: FixedBuffer<4>;
}

machine Main::main(main: &mut Main) reaches Console {
    FixedBuffer::set_first(&mut main.small, 30);
    FixedBuffer::set_first(&mut main.large, 40);
    let small_witness: [u8; 2] = preserve<2>([0, 0]);
    let small_capacity: u64 = FixedBuffer::capacity(&main.small, &small_witness);
    transition small_capacity == 2 {
        true -> check_large(main)
        _ -> fail(main)
    }

    state check_large(main: &mut Main) {
        let large_witness: [u8; 4] = preserve<4>([0, 0, 0, 0]);
        let large_capacity: u64 = FixedBuffer::capacity(&main.large, &large_witness);
        transition large_capacity == 4 {
            true -> finish(main)
            _ -> fail(main)
        }
    }

    state finish(main: &mut Main) {
        let result: i32 in Wrapping = FixedBuffer::first(&main.small) + FixedBuffer::first(&main.large);
        Console::exit_process(result as i32);
    }

    state fail(main: &mut Main) {
        Console::exit_process(71);
    }
}
