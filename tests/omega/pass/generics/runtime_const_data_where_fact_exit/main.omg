// Facts over only const parameters, including membership in an integer domain
// with an evaluable domain body fact, discharge once for the concrete generic
// instance. They are not runtime invariants on the synthesized record.
use omega_language_std::console;

domain u64::Positive(value)
requires
    value > 0;
domain u64::BufferSize(value)
requires
    value in Positive;
    value <= 8;

data FixedBuffer<const N: u64>
where
    N > 0 && N <= 8,
    N in BufferSize,
    used <= N,
{
    used: u64;
    values: [u8; N];
}

data Main {
    buffer: FixedBuffer<4>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.buffer.used = 4;
    main.buffer.values[0] = 66;
    Console::exit_process(main.buffer.values[0] as i32 + main.buffer.used as i32);
}
