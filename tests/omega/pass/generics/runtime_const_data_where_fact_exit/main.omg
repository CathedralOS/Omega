// Facts over only const parameters, including membership in an integer domain
// with an evaluable domain body fact, discharge once for the concrete generic
// instance. They are not runtime invariants on the synthesized record.
use omega_language_std::console;

domain u64::Positive
requires
    self > 0;
domain u64::BufferSize
requires
    self in Positive;
    self <= 8;

data FixedBuffer<const N: u64>
where
    N > 0 && N <= 8,
    N in BufferSize,
    used <= N,
{
    used: u64;
    values: [u8; N];
}

data Main {
    console: Console;
    buffer: FixedBuffer<4>;
}

machine Main::main(&mut self) {
    self.buffer.used = 4;
    self.buffer.values[0] = 66;
    self.console.exit_process(self.buffer.values[0] as i32 + self.buffer.used as i32);
}
