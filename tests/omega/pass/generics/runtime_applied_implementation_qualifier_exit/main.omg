// Expected exit: 0. A qualified named implementation retains its own explicit
// type and constant arguments separately from each method's arguments.
trait Reading<Value> {
    machine read(value: Value) -> Value;
}
trait Operations<Value>: Reading<Value> {
    machine replace(destination: &mut Value, value: Value);
    machine own<const Extra: u64>() -> u64;
    machine echo<Item>(item: Item) -> Item;
}

Selected<Value, const Captured: u64> satisfies Operations<Value> {
    machine read(value: Value) -> Value { value }
    machine replace(destination: &mut Value, value: Value) { destination = value; }
    machine own<const Extra: u64>() -> u64 {
        ((Captured as u64 in Wrapping) + (Extra as u64 in Wrapping)) as u64
    }
    machine echo<Item>(item: Item) -> Item { item }
}

data Record { value: u64; }
machine forward<Value, const Captured: u64>(value: Value) -> Value {
    Selected<Value, Captured>::read(value)
}
machine forward_count<const Captured: u64>() -> u64 {
    Selected<u64, Captured>::own<11>()
}
machine replace<Value>(destination: &mut Value, value: Value) {
    Selected<Value, 31>::replace(destination, value);
}
machine inferred<Item>(item: Item) -> Item {
    Selected<u64, 31>::echo(item)
}

machine main() crashes Trap {
    let first: u64 = Selected<u64, 31>::read(17u64);
    let record: Record = Selected<Record, 43>::read(Record { value: 29 });
    let forwarded: Record = forward<Record, 43>(record);
    let mut changed: u64 = 0;
    Selected<u64, 31>::replace(&mut changed, first);
    let own: u64 = Selected<u64, 31>::own<11>();
    let count: u64 = forward_count<32>();
    let echoed: Record = Selected<u64, 31>::echo(Record { value: 53 });
    let inferred_result: Record = inferred(echoed);
    let mut record_changed: Record = Record { value: 0 };
    replace<Record>(&mut record_changed, forwarded);
    transition first == 17 && record_changed.value == 29 && changed == 17 && own == 42 && count == 43 && inferred_result.value == 53 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
