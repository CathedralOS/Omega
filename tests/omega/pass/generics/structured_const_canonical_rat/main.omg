// Core Rat structural index expressions require canonical representatives.
// Both signs are admitted after cancellation and gcd reduction. This does not
// grant the default-affine Rat carrier permission for named constants.

use omega::language::core::rat;

data RatIndexed<const R: Rat> {
    marker: u8;
}

data Main {
    positive: RatIndexed<(Rat {
        num: IntPair {
            neg: Nat::Zero,
            pos: Nat::Succ { prev: Nat::Zero }
        },
        den: Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } }
    })>;
    negative: RatIndexed<(Rat {
        den: Nat::Succ { prev: Nat::Succ { prev: Nat::Zero } },
        num: IntPair {
            pos: Nat::Zero,
            neg: Nat::Succ { prev: Nat::Zero }
        }
    })>;
}

machine Main::main(&mut self) {
}
