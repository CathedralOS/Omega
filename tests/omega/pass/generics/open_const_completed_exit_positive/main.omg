// Expected exit: 0
trait Reading<const Minimum: u64> { machine read() -> u64 ensures result >= Minimum; }
Selected<const Value: u64> satisfies Reading<Value> { machine read() -> u64 ensures result == Value { Value } }
machine forward<const Minimum: u64, Implementation satisfies Reading<Minimum>>() -> u64 ensures result >= Minimum { Implementation::read() }
machine main() crashes Trap { let value: u64 = forward<7, Selected<7>>(); let difference: u64 = value - 7; transition difference == 0 { true -> done() _ -> bad() } machine done() {} machine bad() { crash Trap; } }
