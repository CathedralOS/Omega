data Choice [copy]
    requires (self in Choice::Empty)
       || ((self in Choice::Point) && self.value <= 60)
{ case Empty; case Point(value: i32); }
const EMPTY: Choice = Choice::Empty;
const POINT: Choice = Choice::Point { value: 60 };
machine select<const VALUE: Choice>() -> i32 { 0 }
machine main() crashes Trap { transition select<EMPTY>() == 0 && select<POINT>() == 0 { true -> done() _ -> bad() } machine done() {} machine bad() { crash Trap; } }
