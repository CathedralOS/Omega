// Expected exit: 0
// A generic wrapper uses the validator promised for its selected helper.

public boundary trait Check<T, machine Valid>
requires machine Valid(accepted: bool, value: &T) -> bool reaches terminates;
{
    machine check(value: &T) -> bool reaches ensures Valid(result, value);
}
public data Cell { value: u64; }
public machine accepts(accepted: bool, value: &Cell) -> bool reaches terminates {
    !accepted || value.value == 37
}
// A separate helper with the same signature does not select the same contract.
public machine accepts_other(accepted: bool, value: &Cell) -> bool reaches terminates {
    !accepted || value.value == 91
}
public Selected satisfies Check<Cell, accepts> {
    machine check(value: &Cell) -> bool ensures accepts(result, value) { value.value == 37 }
}
machine validate<T, machine Valid, machine Validator>(value: &T) -> bool
requires machine Valid(accepted: bool, value: &T) -> bool reaches terminates;
requires machine Validator satisfies Check<T, Valid>::check;
reaches Check
ensures Valid(result, value)
{ Validator(value) }

machine checked(value: &Cell) -> u64 reaches Check {
    let accepted: bool = validate<Cell, accepts, Selected::check>(value);
    transition accepted { true -> use_value(value) _ -> declined() }
    machine use_value(value: &Cell) -> u64 requires value.value == 37 { value.value - 37 }
    machine declined() -> u64 { 91 }
}
machine main() reaches Check crashes Trap {
    let matching: Cell = Cell { value: 37 };
    let other: Cell = Cell { value: 91 };
    let yes: u64 = checked(&matching);
    let no: u64 = checked(&other);
    transition yes == 0 && no == 91 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
