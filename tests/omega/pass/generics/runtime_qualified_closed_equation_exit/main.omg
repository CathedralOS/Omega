use models::Token;
use models::COUNT;

data Projected<Anchor [copy], Token [copy]> [copy]
where Token == models::Token
{ value: Token; anchor: Anchor; }

data Reversed<Anchor [copy], Payload [copy]> [copy]
where models::Token == Payload, Payload == Token
{ value: Payload; anchor: Anchor; }

machine capacity<Payload>() -> u64
where Payload == models::Token
{ 7 }

machine recovered<const Count: u64, Payload>() -> u64
where models::Token == Payload
{ Count }

data Builtin<Anchor [copy], Payload [copy]> [copy]
where Payload == u64
{ value: Payload; anchor: Anchor; }

data Check<const Count: u64> [copy]
where models::COUNT == 4
{ value: u64; }

data Main {
    inferred: Projected<u64>;
    explicit: Projected<u64, models::Token>;
    reversed: Reversed<u64>;
    check: Check<4>;
    builtin: Builtin<u32>;
    first: u64;
    second: u64;
}

machine main(main: &mut Main) crashes Trap {
    main.inferred.value.value = 11;
    main.explicit.value.value = 13;
    main.reversed.value.value = 17;
    main.check.value = 19;
    main.builtin.value = 23;
    main.first = capacity<models::Token>();
    main.second = recovered<4>();
    transition main.first == 7 && main.second == 4
        && main.inferred.value.value == 11 && main.explicit.value.value == 13
        && main.reversed.value.value == 17 && main.check.value == 19 && main.builtin.value == 23 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
