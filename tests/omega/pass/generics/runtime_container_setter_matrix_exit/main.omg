// Container-method surface matrix (Phase 2 slice 1 hardening, 2026-07-08):
// T-typed SETTER (&mut self statement calls, called twice -- cross-call
// state), getter, and an operation that uses the container's parameter only to
// name its data input (touch_count, whose <T> binds the owner, not a value)
// on a container with a parameter-FREE Constrained field (touched: i32 in
// Wrapping). Two fixes pinned: type_reference_mentions_parameter recurses
// Constrained/FixedArray/Slice/Reference shells precisely (a parameter-free
// `in Wrapping` field used to refuse the whole container), and the layout
// builder skips machines attached to generic TEMPLATE data even when they
// declare no type params of their own.
use omega_language_std::console;
use omega::language::core::binding;
data Cell<T> {
    value: T;
    touched: i32 in Wrapping;
}
machine Cell::set<T>(cell: &mut Cell<T>, v: T) {
    cell.value = v;
    cell.touched = cell.touched + 1;
}
// Returning the field through a shared receiver copies it. The container
// and setter do not need this getter-only bound.
machine Cell::get<T [copy]>(cell: &Cell<T>) -> T {
    transition { _ -> (cell.value) }
}
machine Cell::touch_count<T>(cell: &Cell<T>) -> i32 in Wrapping {
    transition { _ -> (cell.touched) }
}
data Main {
    console: Binding<Console>;
    a: Cell<i32>;
    b: Cell<bool>;
}
machine Main::main(main: &mut Main) reaches Console {
    Cell::set(&mut main.a, 41);
    Cell::set(&mut main.a, 42);
    Cell::set(&mut main.b, true);
    let n: i32 = Cell::get(&main.a);
    transition n == 42 {
        true -> check_touches(main)
        false -> no(main)
    }
    state check_touches(main: &mut Main) {
        let t: i32 in Wrapping = Cell::touch_count(&main.a);
        transition t == 2 {
            true -> check_bool(main)
            false -> no(main)
        }
    }
    state check_bool(main: &mut Main) {
        let f: bool = Cell::get(&main.b);
        transition f {
            true -> yes(main)
            false -> no(main)
        }
    }
    state yes(main: &mut Main) { main.console.exit_process(1); }
    state no(main: &mut Main) { main.console.exit_process(2); }
}
