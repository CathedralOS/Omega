trait Probe<Kind> { machine probe(value: &Kind) -> bool; }

Positive satisfies Probe<u64> {
    machine probe(value: &u64) -> bool { value == 42u64 }
}

machine probe<'borrow, Kind, Evidence satisfies Probe<Kind>>(value: &'borrow Kind) -> bool {
    Probe::probe<Kind, Evidence>(value)
}

machine apply<Kind, machine Callback>(value: &Kind) -> bool
where machine Callback(value: &Kind) -> bool;
{ Callback(value) }

machine relay<'item, Kind, Evidence satisfies Probe<Kind>>(value: &'item Kind) -> bool {
    apply<Kind, probe<'item, Kind, Evidence>>(value)
}

machine main() crashes Trap {
    let value: u64 = 42u64;
    let result: bool = relay<u64, Positive>(&value);
    transition result {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
