// Expected exit: 0
// The value parameter Units=7 takes precedence over the const Units=3.
data Units {}
trait Bounded {
    machine value<const Count: u64>(Units: u64) -> u64
    requires Units <= 7
    ensures result <= 7;
}
Selected satisfies Bounded {
    machine value<const Units: u64>(Units: u64) -> u64
    requires Units <= 7
    ensures result <= 7
    { Units }
}
machine selected<Implementation satisfies Bounded>() -> u64
ensures result <= 7
{ Implementation::value<3>(7) }
machine main() crashes Trap {
    let value: u64 = selected<Selected>();
    let difference: u64 = 7u64 - value;
    transition difference == 0 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
