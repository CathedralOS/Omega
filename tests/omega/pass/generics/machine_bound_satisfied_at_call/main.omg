// Frozen decision 13 residue: machine-call instantiations that SATISFY the
// bracket bound stay legal -- a `[copy]` data type, a scalar primitive, and a
// generic caller forwarding its own bounded parameter (`U [copy]` counts as
// carrying `[copy]` in scope) all qualify, through both the attached-method
// path (`copy_it(...)`) and the free-machine path (`copy_free(...)`).

data Light [copy] {
    weight: i32;
}

data Main {
    l: Light;
    n: i32;
}

machine copy_free<T [copy]>(x: &T) {
}

machine copy_it<T [copy]>(x: &T) {
}

machine wrap<U [copy]>(y: &U) {
    copy_it(y);
}

machine Main::main(main: &mut Main) {
    copy_it(&main.l);
    copy_it(&main.n);
    wrap(&main.l);
    copy_free(&main.l);
}
