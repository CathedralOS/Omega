use omega_language_std::console;
use omega::language::core::binding;

data Evidence { case Only; }
data Mixed<T> {
    common: T;
    proof [erased]: Evidence;
    case None;
    case Some(value: T, case_proof [erased]: Evidence);
}

data Main {
    console: Binding<Console>;
    value: Mixed<i32 in Wrapping>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.value = Mixed::Some { common: 7, value: 63 };
    transition main.value {
        Mixed::Some { value, case_proof as _ } -> good(main, value)
        Mixed::None -> bad(main)
    }
    state good(main: &mut Main, value: i32 in Wrapping) {
        main.console.exit_process((main.value.common + value) as i32);
    }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
