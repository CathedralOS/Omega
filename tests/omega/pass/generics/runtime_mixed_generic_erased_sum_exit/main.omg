use omega_language_std::console;

data Evidence { case Only; }
data Mixed<T> {
    common: T;
    proof [erased]: Evidence;
    case None;
    case Some(value: T, case_proof [erased]: Evidence);
}

data Main {
    value: Mixed<i32 in Wrapping>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.value = Mixed::Some { common: 7, value: 63 };
    transition main.value {
        Mixed::Some { common as _, proof as _, value, case_proof as _ } -> good(main, value)
        Mixed::None -> bad(main)
    }
    machine good(main: &mut Main, value: i32 in Wrapping) {
        Console::exit_process((main.value.common + value) as i32);
    }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
