data Box<Value [copy]> [copy] { value: Value; }
machine wrap<Value [copy]>(value: Value) -> Box<Value> { Box { value: value } }
machine capacity<Value [copy], const Size: u64>(value: Value) -> u64
where Value == [u8; Size]
{ Size }
// Expected exit: 0
machine main() crashes Trap {
    let items: [u8; 2] = [7, 11];
    let observed: u64 = capacity(wrap(items).value);
    transition observed == 2 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
