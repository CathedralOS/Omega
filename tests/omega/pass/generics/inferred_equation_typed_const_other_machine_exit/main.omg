// Fact: a selected const call establishes Capacity=2 before an exact array equation and inferred consumer tuple.
// Expected exit: 0
machine extent() -> u64 { 2 }
data IndexedPacket<Value [copy], const Capacity: u64> [copy]
where Value == [u8; Capacity]
{ items: Value; }
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine consume(items: IndexedPacket<[u8; 2], extent()>) -> u64 { capacity(forward(items).items) }
machine relay(items: IndexedPacket<[u8; 2], extent()>) -> u64 { consume(items) }
machine forward<Value [copy]>(value: Value) -> Value { value }
machine main() crashes Trap {
    let items: IndexedPacket<[u8; 2], extent()> = IndexedPacket { items: [7, 11] };
    let observed: u64 = relay(items);
    transition observed == 2 { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
