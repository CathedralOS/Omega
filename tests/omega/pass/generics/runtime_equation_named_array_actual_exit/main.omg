data Counts {}
const Counts::FOUR: u64 = 4;
const Count: u64 = 4;

data Inferred<Payload [copy], Element [copy], const Count: u64> [copy]
where Payload == [Element; Count]
{ value: Payload; marker: Element; }

data Verified<Payload [copy]> [copy]
where Payload == [u64; 4]
{ value: Payload; }

machine capacity<Payload, const Count: u64>() -> u64
where Payload == [u64; Count]
{ Count }

data Main {
    inferred: Inferred<[u64; Counts::FOUR]>;
    verified: Verified<[u64; Count]>;
    nested: Inferred<[[u64; Count]; Counts::FOUR]>;
    result: u64;
}

machine main(main: &mut Main) crashes Trap {
    main.inferred.value[0] = 13;
    main.inferred.marker = 11;
    main.verified.value[0] = 17;
    main.nested.marker[0] = 19;
    main.result = capacity<[u64; Count]>();
    transition main.result == 4 && main.inferred.value[0] == 13
        && main.inferred.marker == 11 && main.verified.value[0] == 17
        && main.nested.marker[0] == 19 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
