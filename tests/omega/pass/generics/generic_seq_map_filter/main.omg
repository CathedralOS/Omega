// Generic recursive sequences with machine parameters:
// `machine map<T, U, machine F>` declares a `where
// machine F(value: T) -> U` bound — `map<increment>` and
// `filter<positive>` instantiate; both machines terminate
// `by items` on the recursive `Seq<T>` structure.
//
//   * `data Seq<T> { case Empty; case Cons(head: T,
//     tail: Seq<T>); }` — self-referential generic sum.
//   * `where machine Predicate(value: &T) -> bool` —
//     machine-param constraint over borrowed subject.
//   * `map<F>(tail)` partial-application recursive call +
//     `choose(...)` state routing the predicate result.
//
// Compile-checked only: no standard-library dependency, no
// ProcessExit provider.

data Seq<T> {
    case Empty;
    case Cons(head: T, tail: Seq<T>);
}

machine increment(value: u64) -> u64 {
    ((value as u64 in Wrapping) + 1) as u64
}

machine positive(value: &i32) -> bool {
    value > 0
}

machine map<T, U, machine F>(items: Seq<T>) -> Seq<U>
where machine F(value: T) -> U;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> Seq::Cons {
            head: F(head),
            tail: map<F>(tail)
        }
    }
}

machine filter<T, machine Predicate>(items: Seq<T>) -> Seq<T>
where machine Predicate(value: &T) -> bool;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> choose(
            Predicate(head),
            head,
            filter<Predicate>(tail)
        )
    }

    machine choose(keep: bool, head: T, tail: Seq<T>) -> Seq<T> {
        transition keep {
            true -> Seq::Cons { head: head, tail: tail }
            false -> tail
        }
    }
}

machine mapped(items: Seq<u64>) -> Seq<u64> {
    map<increment>(items)
}

machine filtered(items: Seq<i32>) -> Seq<i32> {
    filter<positive>(items)
}

data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;
    let items: Seq<u64> = Seq::Cons {
        head: 1,
        tail: Seq::Cons { head: 2, tail: Seq::Empty }
    };
    let bumped: Seq<u64> = mapped(items);
    let signed: Seq<i32> = Seq::Cons {
        head: -3,
        tail: Seq::Cons { head: 7, tail: Seq::Empty }
    };
    let kept: Seq<i32> = filtered(signed);
    transition { _ -> pass(main) }
    machine pass(main: &mut Main) { main.hits = 1; }
}
