// Expected exit: 0
use omega::language::core::iteration;

data Item [copy] { visited: bool; value: u32; }
data Token { visited: bool; }

machine visit(item: &mut Item)
satisfies ElementStep<Item>::apply {
    item.visited = !item.visited;
    item.value = 7;
}

machine visit_token(token: &mut Token)
satisfies ElementStep<Token>::apply {
    token.visited = !token.visited;
}

machine token_visited(token: &Token) -> bool { token.visited }

machine main() crashes Trap {
    let mut items: [Item; 3];
    for_each<Item, visit>(&mut items[..]);
    for_each<Item, visit>(&mut items[0..0]);
    let mut tokens: [Token; 2];
    let view: &mut [Token] = &mut tokens[..];
    for_each<Token, visit_token>(view);
    let first: bool = token_visited(&tokens[0]);
    let second: bool = token_visited(&tokens[1]);
    transition items[0].visited && items[1].visited && items[2].visited
        && items[0].value == 7 && items[1].value == 7 && items[2].value == 7
        && first && second {
        true -> done()
        _ -> failed()
    }
    state done() {}
    state failed() { crash Trap; }
}