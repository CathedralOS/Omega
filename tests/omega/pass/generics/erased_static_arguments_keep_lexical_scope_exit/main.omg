
machine ceiling<Element>() -> u64 { 70 }
data Bounded<Element> where value <= ceiling<&Element>() { value: u64; }

machine unused<Element, const Tag: u8>() -> u64 { 70 }
machine relay<Element>() -> u64 { unused<&Element, 7>() }

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let bounded: Bounded<u8> = Bounded { value: 0 };
    transition relay<u8>() == 70 && bounded.value == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
