// Unused operands still belong to their authored declaration after folding
// the data-field bound and specializing the ordinary calls.
machine ceiling<Element>() -> u64 { 70 }
data Bounded<Element> { value: u64[0..=ceiling<&Element>()]; }

machine unused<Element, const Tag: u8>() -> u64 { 70 }
machine relay<Element>() -> u64 { unused<&Element, 7>() }

data Main { bounded: Bounded<u8>; }
machine Main::main(main: &mut Main) crashes Trap {
    transition relay<u8>() == 70 && main.bounded.value == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
