// Expected exit: 0
trait Arithmetic {machine + add(left:&mut u32,right:u32)->u32 ensures result==9;}
Toggle satisfies Arithmetic {machine add(left:&mut u32,right:u32)->u32 ensures result==9 {left = left ^ 1u32; 9}}
data Index<Limit:u32> [copy] where value<Limit {value:u32;}
machine probe<Operations satisfies Arithmetic>()->bool {let mut flag:u32=0; let indexed:Index<(Operations::add(&mut flag,1u32))> = Index{value:8}; indexed.Limit==9 && flag==1u32}
machine main() crashes Trap {let observed:bool=probe<Toggle>(); transition observed {true->done() _->bad()} state done(){} state bad(){crash Trap;}}
