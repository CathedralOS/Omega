// Expected exit: 0
data Index<Limit: u32> [copy] where value < Limit { value: u32; }
machine make<Count: u32>(value: u32) -> Index<Count>
requires value < Count
{ Index { value: value } }
machine read<Count: u32>(item: Index<Count>) -> u32 { item.value }
machine probe(limit:u32)->u32 requires limit >= 8 && limit <= 9 {
 let item:Index<(limit+1u32)> = Index{value:8}; item.Limit
}
machine main() crashes Trap {
 let observed:u32=probe(9);
 transition observed == 10 { true -> done() _ -> bad() }
 machine done(){} machine bad(){crash Trap;}
}
