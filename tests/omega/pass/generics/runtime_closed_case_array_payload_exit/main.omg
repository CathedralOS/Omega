// Nested payload types come from preparation, not checker-side substitution.
data Choice<Element> {
    case Empty;
    case Full(value: [Element; 2]);
}

machine evaluate(selection: &Choice<i32>) -> i32 {
    transition selection {
        Choice::Empty -> 0
        Choice::Full { value } -> (value[1])
    }
}

machine evaluate_nested(selection: &Choice<[i32; 2]>) -> i32 {
    transition selection {
        Choice::Empty -> 0
        Choice::Full { value } -> (value[1][0])
    }
}

machine main() crashes Trap {
    let selection: Choice<i32> = Choice::Full { value: [17, 29] };
    let nested: Choice<[i32; 2]> = Choice::Full { value: [[31, 37], [41, 43]] };
    transition evaluate(&selection) == 29 && evaluate_nested(&nested) == 41 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
