data Selected<'storage> { reference: &'storage i32; }
data Envelope<Value> { value: Value; }
data Pair<First, Second> { first: First; second: Second; }
data RegionalValue<'storage> { value: i32; }
data RecursiveEdge<'next, Value> {
    value: Value;
    next: &'next RecursiveEdge<'next, [Value; 2]>;
}

// Unused declarations still enter preparation. This field describes an edge,
// not a demand to enumerate the referenced type's growing applications.
data RecursiveRoot<'next> { edge: &'next RecursiveEdge<'next, i32>; }

// Authored dependent bodies are neither concrete views nor invented loans.
// Selected instances still check their complete return and store frontiers.
machine choose<Value>(first: bool, left: Value, right: Value) -> Value {
    transition first { true -> left false -> right }
}
machine relay<Value>(first: bool, left: Value, right: Value) -> Value {
    choose(first, left, right)
}
machine Envelope::replace<Value>(envelope: &mut Envelope<Value>, value: Value) {
    envelope.value = value;
}

trait Identity<Value> { machine forward(value: Value) -> Value; }
trait Wrapped<Value>: Identity<Envelope<Value>> {}

ForwardEnvelope<Value> satisfies Wrapped<Value> {
    machine forward(value: Envelope<Value>) -> Envelope<Value> { value }
}

machine observe<'storage, Operations satisfies Wrapped<Selected<'storage>>>(
    source: &'storage mut i32
) -> i32 {
    let original: Selected<'storage> = Selected { reference: source };
    let envelope: Envelope<Selected<'storage>> = Envelope { value: original };
    let forwarded: Envelope<Selected<'storage>> = Operations::forward(envelope);
    let observed: i32 = forwarded.value.reference;
    // A region argument is not a retained loan. Repeated owned applications
    // consume their prepared fields without discarding the nested actuals.
    let regional: RegionalValue<'storage> = RegionalValue { value: observed };
    let inner: Envelope<RegionalValue<'storage>> = Envelope { value: regional };
    let owned: Envelope<Envelope<RegionalValue<'storage>>> = Envelope { value: inner };
    source = 7;
    owned.value.value.value
}

machine run<'storage>(source: &'storage mut i32) -> i32 {
    observe<ForwardEnvelope<Selected<'storage>>>(source)
}

// Nested actuals capture independent regions; the generic head has no region
// binders of its own. A specialization must retain the application owner's scope.
machine observe_pair<'first, 'second,
    Operations satisfies Wrapped<Pair<Selected<'first>, Selected<'second>>>>(
    first: &'first mut i32, second: &'second mut i32
) -> i64 {
    let first_view: Selected<'first> = Selected { reference: first };
    let second_view: Selected<'second> = Selected { reference: second };
    let pair: Pair<Selected<'first>, Selected<'second>> = Pair {
        first: first_view, second: second_view
    };
    let envelope: Envelope<Pair<Selected<'first>, Selected<'second>>> = Envelope { value: pair };
    let forwarded: Envelope<Pair<Selected<'first>, Selected<'second>>> = Operations::forward(envelope);
    let first_value: i32 = forwarded.value.first.reference;
    let second_value: i32 = forwarded.value.second.reference;
    first = 5;
    second = 7;
    (first_value as i64) + (second_value as i64)
}

machine run_pair<'first, 'second>(first: &'first mut i32, second: &'second mut i32) -> i64 {
    observe_pair<ForwardEnvelope<Pair<Selected<'first>, Selected<'second>>>>(first, second)
}

machine observe_nested<'storage, Operations satisfies Wrapped<Envelope<Selected<'storage>>>>(
    source: &'storage mut i32
) -> i32 {
    let selected: Selected<'storage> = Selected { reference: source };
    let inner: Envelope<Selected<'storage>> = Envelope { value: selected };
    let outer: Envelope<Envelope<Selected<'storage>>> = Envelope { value: inner };
    let forwarded: Envelope<Envelope<Selected<'storage>>> =
        Operations::forward(outer);
    let observed: i32 = forwarded.value.value.reference;
    source = 9;
    observed
}

machine run_nested<'storage>(source: &'storage mut i32) -> i32 {
    observe_nested<ForwardEnvelope<Envelope<Selected<'storage>>>>(source)
}

// The supplying scope crosses array and reference nodes as well as generic
// applications. Both views end before replacement of their backing storage.
machine observe_array<'storage, Operations satisfies Wrapped<[&'storage i32; 2]>>(
    source: &'storage mut i32
) -> i64 {
    let envelope: Envelope<[&'storage i32; 2]> = Envelope { value: [source, source] };
    let forwarded: Envelope<[&'storage i32; 2]> = Operations::forward(envelope);
    let first: i32 = forwarded.value[0];
    let second: i32 = forwarded.value[1];
    source = 11;
    (first as i64) + (second as i64)
}

machine run_array<'storage>(source: &'storage mut i32) -> i64 {
    observe_array<ForwardEnvelope<[&'storage i32; 2]>>(source)
}

// Value's substituted region belongs to the caller. Its following sibling
// still belongs to preserve_sibling's independently named lifetime telescope.
machine preserve_sibling<'outer, Value>(value: Value, sibling: &'outer i32) -> Pair<Value, &'outer i32> {
    Pair { first: value, second: sibling }
}

machine run_mixed<'first, 'second>(first: &'first mut i32, second: &'second mut i32) -> i64 {
    let selected: Selected<'first> = Selected { reference: first };
    let pair: Pair<Selected<'first>, &'second i32> = preserve_sibling(selected, second);
    let first_value: i32 = pair.first.reference;
    let second_value: i32 = pair.second;
    first = 13;
    second = 19;
    (first_value as i64) + (second_value as i64)
}

machine main() crashes Trap {
    let mut choice: Envelope<i32> = relay(false, Envelope { value: 0 }, Envelope { value: 17 });
    let chosen: i32 = choice.value;
    Envelope::replace(&mut choice, 43);
    let mut source: i32 = 17;
    let observed: i32 = run(&mut source);
    let mut first: i32 = 17;
    let mut second: i32 = 25;
    let pair_observed: i64 = run_pair(&mut first, &mut second);
    let nested_observed: i32 = run_nested(&mut source);
    let array_observed: i64 = run_array(&mut source);
    let pair_replacements_correct: bool = first == 5 && second == 7;
    let mixed_observed: i64 = run_mixed(&mut first, &mut second);
    transition chosen == 17 && choice.value == 43 && observed == 17 && source == 11 && pair_observed == 42 && pair_replacements_correct && first == 13 && second == 19 && nested_observed == 7 && array_observed == 18 && mixed_observed == 12 {
        true -> passed()
        false -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
