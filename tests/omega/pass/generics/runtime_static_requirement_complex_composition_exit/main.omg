use omega::language::core::float_operations;
// Natural optical-field algebra: nested operations on generic complex records.
use numerics::complex::complex_carrier_ops::Complex;
trait Arithmetic<Scalar [copy]> {
    machine plus(left: Scalar, right: Scalar) -> Scalar;
    machine minus(left: Scalar, right: Scalar) -> Scalar;
    machine times(left: Scalar, right: Scalar) -> Scalar;
}
Double satisfies Arithmetic<f64> {
    machine plus(left: f64, right: f64) -> f64 { left + right }
    machine minus(left: f64, right: f64) -> f64 { left - right }
    machine times(left: f64, right: f64) -> f64 { left * right }
}
Float satisfies Arithmetic<f32> {
    machine plus(left: f32, right: f32) -> f32 { left + right }
    machine minus(left: f32, right: f32) -> f32 { left - right }
    machine times(left: f32, right: f32) -> f32 { left * right }
}
Shifted satisfies Arithmetic<f64> {
    machine plus(left: f64, right: f64) -> f64 { left + right + 1.0 }
    machine minus(left: f64, right: f64) -> f64 { left - right + 1.0 }
    machine times(left: f64, right: f64) -> f64 { left * right + 1.0 }
}
trait Forwarding<Scalar [copy]> {
    machine identity(value: Scalar) -> Scalar;
    machine forward(value: Scalar) -> Scalar { identity(value) }
}
trait InheritedForwarding<Scalar [copy]>: Forwarding<Scalar> {}
Defaults satisfies InheritedForwarding<f64> {
    machine identity(value: f64) -> f64 { value + 1.0 }
}
machine default_field<Operations satisfies InheritedForwarding<f64>>(value: f64) -> Complex<f64> {
    Complex { real: Operations::forward(value), imaginary: Operations::forward(Operations::forward(value)) }
}
machine doubled(value: f64) -> f64 { value + value }
machine field<Scalar [copy], Operations satisfies Arithmetic<Scalar>>(value: Scalar) -> Complex<Scalar> {
    Complex { real: Arithmetic::plus<Scalar, Operations>(value, value),
              imaginary: Arithmetic::times<Scalar, Operations>(value, value) }
}
machine sum<Scalar [copy], Operations satisfies Arithmetic<Scalar>>(left: Complex<Scalar>, right: Complex<Scalar>) -> Complex<Scalar> {
    Complex {
        real: Arithmetic::plus<Scalar, Operations>(left.real, right.real),
        imaginary: Arithmetic::plus<Scalar, Operations>(left.imaginary, right.imaginary)
    }
}
machine product<Scalar [copy], Operations satisfies Arithmetic<Scalar>>(left: Complex<Scalar>, right: Complex<Scalar>) -> Complex<Scalar> {
    Complex {
        real: Arithmetic::minus<Scalar, Operations>(Arithmetic::times<Scalar, Operations>(left.real, right.real), Arithmetic::times<Scalar, Operations>(left.imaginary, right.imaginary)),
        imaginary: Arithmetic::plus<Scalar, Operations>(Arithmetic::times<Scalar, Operations>(left.real, right.imaginary), Arithmetic::times<Scalar, Operations>(left.imaginary, right.real))
    }
}
data Main { result: Complex<f64>; }
machine main(main: &mut Main) crashes Trap {
    let first: Complex<f64> = Complex { real: 0.5, imaginary: 0.25 };
    let second: Complex<f64> = Complex { real: 1.5, imaginary: -0.75 };
    main.result = sum<f64, Double>(product<f64, Double>(first, second), product<f64, Double>(second, first));
    let inherited: Complex<f64> = default_field<Defaults>(0.25);
    let regular: Complex<f64> = field<f64, Double>(doubled(0.125));
    let single: Complex<f32> = field<f32, Float>(0.25f32);
    let shifted: Complex<f64> = field<f64, Shifted>(doubled(0.125));
    transition main.result.real == 1.875 && main.result.imaginary == 0.0
        && inherited.real == 1.25 && inherited.imaginary == 2.25
        && regular.real == 0.5 && regular.imaginary == 0.0625
        && single.real == 0.5f32 && single.imaginary == 0.0625f32
        && shifted.real == 1.5 && shifted.imaginary == 1.0625 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
