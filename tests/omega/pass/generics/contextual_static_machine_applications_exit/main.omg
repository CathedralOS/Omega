machine identity<Kind>(value: Kind) -> Kind { value }

machine apply<Context, machine Selected>(value: Context) -> Context
where machine Selected(value: Context) -> Context;
{ Selected(value) }

machine main() crashes Trap {
    let number: u64 = apply<u64, identity>(42u64);
    let flag: bool = apply<identity>(true);
    transition number == 42u64 && flag {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
