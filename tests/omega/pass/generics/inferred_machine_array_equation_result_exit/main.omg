// Expected exit: 0
machine produce<Length [copy], const Capacity: u64>(items: Length) -> Length
where Length == [u8; Capacity]
{ items }
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine main() crashes Trap {
    let items: [u8; 2] = produce([7, 11]);
    let observed: u64 = capacity(items);
    transition observed == 2 && items[0] == 7 && items[1] == 11 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
