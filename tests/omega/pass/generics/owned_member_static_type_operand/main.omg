// Expected exit: 0. An owned member's call sees its map's type telescope.
trait Identity { machine keep(value: u64) -> u64; }
machine identity<T>(value: u64) -> u64 { value }
Captured<Role> satisfies Identity {
    machine keep(value: u64) -> u64 { identity<Role>(value) }
}
machine main() crashes Trap {
    let first: u64 = Captured<u64>::keep(37);
    let second: u64 = Captured<i32>::keep(41);
    transition first == 37 && second == 41 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
