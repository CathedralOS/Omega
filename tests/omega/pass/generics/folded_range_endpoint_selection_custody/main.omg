use omega_language_std::console;

machine endpoint(value: u64) -> u64 { value }
machine nested_sum(value: u64) -> u64 requires value <= 1 + 2 * 3 { value }
machine nested_difference(value: u64) -> u64 requires value < 10 - 2 - 3 { value }
machine nested_call(value: u64) -> u64 requires value <= endpoint(endpoint(256) + 1) { value }
data Holder [copy] where value <= 4 * 8 - 2 { value: u64; }
data Wrap<T [copy]> [copy] { value: T; }
domain u64::Bound(value) requires value <= 2 * 64 + 128;
machine wrapped() -> u64 {
    let held: Wrap<u64 in Bound> = Wrap { value: 7 };
    held.value
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let total: u64 = nested_sum(7) + nested_difference(4) + nested_call(257) + wrapped();
    transition total == 275 {
        true -> passed(main)
        false -> failed(main)
    }
    machine passed(main: &mut Main) { Console::exit_process(70); }
    machine failed(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
