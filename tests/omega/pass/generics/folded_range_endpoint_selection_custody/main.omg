// A whole range bound folds to one literal before checking. Operators and
// calls nested inside that bound keep their authored selection custody, so a
// private checking projection that drops these declarations (the hosted
// entry plan's premise discharge) neither loses nor orphans them.
use omega_language_std::console;

machine endpoint(value: u64) -> u64 { value }
machine nested_sum(value: u64[0..=1 + 2 * 3]) -> u64 { value }
machine nested_difference(value: u64[0..10 - 2 - 3]) -> u64 { value }
machine nested_call(value: u64[0..=endpoint(endpoint(256) + 1)]) -> u64 { value }
data Holder [copy] { value: u64[0..=4 * 8 - 2]; }
data Wrap<T [copy]> [copy] { value: T; }
machine wrapped() -> u64 {
    let held: Wrap<u64[0..=2 * 64 + 128]> = Wrap { value: 7 };
    held.value
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let total: u64 = nested_sum(7) + nested_difference(4) + nested_call(257) + wrapped();
    transition total == 275 {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
