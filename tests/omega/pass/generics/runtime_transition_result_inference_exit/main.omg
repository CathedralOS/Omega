// Expected exit: 0. The destination state supplies a generic array result's extent.
machine empty<const Count: u64>() -> [u8; Count] {
    let bytes: [u8; Count];
    bytes
}

machine main() crashes Trap {
    transition { _ -> receive(empty()) }
    state receive(bytes: [u8; 3]) {
        transition bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 0 {
            true -> done()
            _ -> wrong()
        }
    }
    state done() {}
    state wrong() { crash Trap; }
}
