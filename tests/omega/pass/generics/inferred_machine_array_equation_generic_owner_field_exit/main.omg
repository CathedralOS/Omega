// Expected exit: 0
data Packet<Element [copy], const Count: u64> [copy] { items: [Element; Count]; }
data Context { packet: Packet<u8, 2>; }
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine main(context: &mut Context) crashes Trap {
    context.packet.items[0] = 7;
    context.packet.items[1] = 11;
    let observed: u64 = capacity(context.packet.items);
    transition observed == 2 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
