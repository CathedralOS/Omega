data Holder<'held> { reference: &'held u64; }
data Item { value: u64; }

machine pick<'call, Context>(context: Context, item: &'call Item) -> u64 { item.value }

machine apply<Context, machine Callback>(context: Context, item: &Item) -> u64
where machine Callback<'call>(context: Context, item: &'call Item) -> u64;
{ Callback(context, item) }

machine relay<'call>(context: Holder<'call>, item: &'call Item) -> u64 {
    apply<Holder<'call>, pick<Holder<'call>>>(context, item)
}

machine main() crashes Trap {
    let left: u64 = 17u64;
    let right: Item = Item { value: 42u64 };
    let context: Holder = Holder { reference: &left };
    let result: u64 = relay(context, &right);
    transition result == 42u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
