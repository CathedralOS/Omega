data Box<Value [copy]> [copy] { value: Value; }
data Holder<Value [copy]> [copy] { value: Value; }

data Nested<Payload [copy], Element [copy], const Count: u64> [copy]
where Payload == [Element; Count] {
    nested: Holder<Box<[Element; Count]>>;
    direct: Box<Payload>;
}

data Main {
    integers: Nested<[u64; 4]>;
    booleans: Nested<[bool; 2]>;
}

machine main(main: &mut Main) crashes Trap {
    main.integers.nested.value.value[3] = 31;
    main.integers.direct.value[0] = 17;
    main.booleans.nested.value.value[1] = true;
    main.booleans.direct.value[0] = true;
    transition main.integers.nested.value.value[3] == 31
        && main.integers.direct.value[0] == 17
        && main.booleans.nested.value.value[1]
        && main.booleans.direct.value[0]
        && main.integers.nested.value.value.len == 4
        && main.booleans.nested.value.value.len == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
