// A literal const data argument substitutes into the instance's fixed-array
// extent before validation, layout, storage planning, and indexed lowering.
use omega_language_std::console;

data FixedBuffer<T, const N: u64> {
    items: [T; N];
}

data Main {
    buffer: FixedBuffer<i32 in Wrapping, 4>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.buffer.items[3] = 70;
    let result: i32 in Wrapping = main.buffer.items[3];
    Console::exit_process(result as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
