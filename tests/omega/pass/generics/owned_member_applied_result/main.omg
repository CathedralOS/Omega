// Expected exit: 0. A generic caller receives the selected map's applied
// result, not the private realization's unbound T.
data Envelope<T> { case Payload(value: T); }
trait Creator<Value> { machine make(value: Value) -> Envelope<Value>; }
Make<T, Role> satisfies Creator<T> {
    machine make(value: T) -> Envelope<T> { Envelope::Payload { value: value } }
}
machine forward<Role>(value: u64) -> u64 {
    transition Make<u64, Role>::make(value) {
        Envelope::Payload { value } -> value
    }
}
machine main() crashes Trap {
    let first: u64 = forward<u8>(37);
    let second: u64 = forward<i32>(41);
    transition first == 37 && second == 41 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
