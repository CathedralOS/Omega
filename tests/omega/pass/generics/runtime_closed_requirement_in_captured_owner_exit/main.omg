// Expected exit: 0
boundary trait Reading {
    machine read<const Count: u64>() -> u64 reaches
    ensures result == Count;
}
ReadingImplementation satisfies Reading {
    machine read<const Count: u64>() -> u64
    ensures result == Count
    { Count }
}
trait Run {
    machine run() -> u64 reaches Reading ensures result == 7;
}
Captured<T> satisfies Run {
    machine run() -> u64 reaches Reading ensures result == 7
    { Reading::read<7u64>() }
}
machine execute<Implementation satisfies Run>() -> u64
reaches Reading
ensures result == 7
{ Implementation::run() }
machine main() reaches Reading crashes Trap {
    let value: u64 = execute<Captured<u64>>();
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
