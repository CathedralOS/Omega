// Expected exit: 0
data Pair<Left:u32,Right:u32> [copy] where value<Left && value<Right {value:u32;}
machine first(flag:&mut u32)->u32 ensures result==9 {flag=1;9}
machine second(flag:&mut u32)->u32 crashes Trap ensures result==10 {
 let before:u32=flag; flag=2;
 transition before==1 {true->yes() _->no()}
 machine yes()->u32 ensures result==10 {10}
 machine no()->u32 crashes Trap ensures result==10 {crash Trap;}
}
machine main() crashes Trap {
 let mut flag:u32=0;
 let indexed:Pair<(first(&mut flag)),(second(&mut flag))> = Pair{value:8};
 transition indexed.Left==9 && indexed.Right==10 && indexed.value==8 && flag==2 {true->done() _->bad()}
 machine done(){}
 machine bad() crashes Trap {crash Trap;}
}
