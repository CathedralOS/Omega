// Expected exit: 0
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine main() crashes Trap {
    let low: [u8; 2] = [0, 0];
    let high: [u8; 2] = [255, 255];
    let first: u64 = capacity(low);
    let second: u64 = capacity(high);
    transition first == 2 && second == 2 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
