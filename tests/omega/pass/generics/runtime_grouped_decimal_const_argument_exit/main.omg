data FixedBuffer<const N: u64> { values: [u8; N]; }
data Main { buffer: FixedBuffer<1_2.0 / 4>; }
machine Main::main(main: &mut Main) crashes Trap {
    main.buffer.values[2] = 37;
    transition main.buffer.values[2] == 37 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) {}
    machine bad(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
