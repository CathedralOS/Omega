trait Getter { machine get() -> i32 blocks; }
Selected<machine Callback> satisfies Getter
where machine Callback() -> i32;
{
    machine get() -> i32 { Callback() }
}
machine read() -> i32 { 83 }
machine choose<Operations satisfies Getter>() -> i32 blocks; {
    block Operations::get()
}
// Expected exit: 0. Captured Machine selection executes its own checked body.
machine main() blocks; crashes Trap {
    let observed: i32 = block choose<Selected<read>>();
    transition observed == 83 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
