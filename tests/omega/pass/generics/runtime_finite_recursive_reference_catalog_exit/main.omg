// Reference edges retain identity, not an eagerly expanded storage catalog.
// Zero extent still retains its element type; it is not permission to erase
// the growing edge. Held also transports and reads an actual nonempty loan.
data Cell { value: i32; }
data Wrapper<Payload> { payload: Payload; }
data Deep<'storage> { wrapped: Wrapper<Wrapper<&'storage Cell>>; }
data Chain<'next, Element, const Capacity: u64>
where Capacity > 0,
{
    value: Element;
    next: [&'next Chain<'next, [Element; 2], Capacity>; 0];
}
data Held<'borrow, 'storage> { target: &'borrow Chain<'storage, i32, 2>; }
data Loop<'next, Element> {
    value: Element;
    next: [&'next Loop<'next, Element>; 0];
}

// Source checking also visits signatures not selected by the native closure.
data Nest<'next, Element> {
    value: Element;
    next: &'next Nest<'next, [Element; 2]>;
}
machine keep<'region>(value: &'region Nest<'region, u8>) -> &'region Nest<'region, u8> {
    value
}

// Merely naming an impossible specialization does not establish its default
// domain. Indirect wrappers must neither reject it nor expand its reference
// descendants forever. No reachable operation constructs these values.
data BufferReference<'next, Element> { marker: Element; buffer: &Chain<'next, u8, 0>; }
data IndirectBufferReference<'next, Element> { buffer: &BufferReference<'next, Element>; }
data UninhabitedRoot<'next> { buffer: IndirectBufferReference<'next, u8>; }

machine read<'storage, 'borrow>(node: &'borrow Chain<'storage, i32, 2>) -> i32 {
    let held: Held<'borrow, 'storage> = Held { target: node };
    held.target.value
}

machine read_loop<'storage, 'borrow>(node: &'borrow Loop<'storage, i32>) -> i32 {
    node.value
}

// Repeated nominal owners inside an actual argument are finite by-value
// structure, not an invitation to expand a recursive declaration family.
machine nested<'source>(source: &'source Cell) -> i32 {
    let deep: Deep<'source> = Deep {
        wrapped: Wrapper { payload: Wrapper { payload: source } }
    };
    deep.wrapped.payload.payload.value
}

machine exercise<'storage>(source: &'storage Cell) -> bool {
    let node: Chain<'storage, i32, 2> = Chain { value: source.value, next: [] };
    let regular: Loop<'storage, i32> = Loop { value: 29, next: [] };
    read(&node) == 17 && read_loop(&regular) == 29 && nested(source) == 17
}

machine main() crashes Trap {
    let seed: Cell = Cell { value: 17 };
    transition exercise(&seed) { true -> passed() false -> failed() }
    machine passed() {}
    machine failed() { crash Trap; }
}
