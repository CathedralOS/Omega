// Chapter 12 "Static Dispatch" / "Monomorphization": a concrete call to a
// generic machine resolves and instantiates through the normal receiver-call
// path.

data Item {
    value: i32;
}

data Main {
    it: Item;
}

machine Main::use_it<T>(&self, x: &T) {
}

machine Main::main(&mut self) {
    self.use_it(&self.it);
}
