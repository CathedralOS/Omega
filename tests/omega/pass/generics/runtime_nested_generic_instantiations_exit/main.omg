// GENERICS PHASE 3: NESTED generic data. `Pair<T>` contains a `Box<T>` field, so
// `Pair<i32>` needs `Box<i32>` synthesized too, and `Pair<bool>` needs
// `Box<bool>`. The monomorphization desugar now runs to a FIXPOINT: it synthesizes
// `Pair<i32>` whose `a` field is a fresh `Box<i32>` spelling, which the next round
// picks up and monomorphizes (and generic TEMPLATE bodies are skipped so the
// param-arg `Box<T>` inside `Pair<T>` is never mistaken for a concrete instance).
// Before this, a nested generic errored outright ("references unknown data type
// T"). Reads 30 from the i32 pair's box, true from the bool pair's box; exits 30.
use omega_language_std::console;
data Box<T> { value: T; }
data Pair<T> { a: Box<T>; b: T; }
data Main { pi: Pair<i32>; pb: Pair<bool>; r: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.pi.a.value = 30;
    main.pi.b = 7;
    main.pb.a.value = true;
    main.r = main.pi.a.value;
    transition main.pb.a.value == true {
        true -> ok(main)
        false -> bad(main)
    }
    state ok(main: &mut Main) { Console::exit_process(main.r); }
    state bad(main: &mut Main) { Console::exit_process(99); }
}
// Expected exit: 30
