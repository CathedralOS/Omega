// An open capture applies its exact type/const operands before checking calls.
// Expected exit: 0
data First [copy] { value: u64; }
data Second [copy] { value: u64; }
data Role {}

trait Echo<Value [copy]> {
    machine forward(value: Value) -> Value;
}

Selected<Value [copy], Role> satisfies Echo<Value> {
    machine forward(value: Value) -> Value { value }
}

ArraySelected<Element [copy], const Count: u64, Role>
    satisfies Echo<[Element; Count]> {
    machine forward(value: [Element; Count]) -> [Element; Count] { value }
}

machine carry<Role>(first: First, second: Second, values: [u64; 2]) -> bool {
    let one: First = Selected<First, Role>::forward(first);
    let two: Second = Selected<Second, Role>::forward(second);
    let array: [u64; 2] = ArraySelected<u64, 2, Role>::forward(values);
    one.value == 17 && two.value == 29 && array[0] == 31 && array[1] == 41
}

machine main() crashes Trap {
    let answer: bool = carry<Role>(First { value: 17 }, Second { value: 29 }, [31, 41]);
    transition answer { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
