data Counts {}
const Counts::FOUR: u64 = 4;

data Mode<const Count: u64> [copy] { value: u64; }

machine capacity<Payload, const Count: u64>() -> u64
where Payload == Mode<Count>
{ Count }

data Main { result: u64; }

machine main(main: &mut Main) crashes Trap {
    main.result = capacity<Mode<Counts::FOUR>>();
    transition main.result == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
