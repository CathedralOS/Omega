// Independent values: first moments 6; 2x2 determinant 72;
// 3x3 determinant 1728. No specialization may strengthen the generic body.
data Moments<const Width: u64> { values: [i64 in Wrapping; Width]; }
machine first<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping {
    transition Count > 0 { true -> (moments[0]) _ -> (0) }
}
machine mirrored<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping {
    transition 0 < Count { true -> (moments[0]) _ -> (0) }
}
machine negated<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping {
    transition Count <= 0 { true -> (0) _ -> (moments[0]) }
}
machine aliased<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping {
    let nonempty: bool = Count > 0;
    transition nonempty { true -> (moments[0]) _ -> (0) }
}
machine projected<const Count: u64>(moments: &Moments<Count>) -> i64 in Wrapping {
    transition Count > 0 { true -> (moments.values[0]) _ -> (0) }
}
machine polynomial<const Count: u64>(moments: &[i64 in Wrapping; Count], quadratic: bool) -> i64 in Wrapping {
    transition Count >= 5 { true -> evaluate(moments, quadratic) _ -> (0) }
    machine evaluate(moments: &[i64 in Wrapping; Count], quadratic: bool) -> i64 in Wrapping {
        let a: i64 in Wrapping = moments[0]; let b: i64 in Wrapping = moments[1];
        let c: i64 in Wrapping = moments[2]; let d: i64 in Wrapping = moments[3];
        let e: i64 in Wrapping = moments[4];
        transition quadratic { true -> (a*(c*e-d*d)-b*(b*e-c*d)+c*(b*d-c*c)) _ -> (a*c-b*b) }
    }
}
machine ranged<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping {
    transition Count >= 3 { true -> read(&moments[..3]) _ -> (0) }
    machine read(values: &[i64 in Wrapping]) -> i64 in Wrapping {
        transition values.len >= 3 { true -> (values[2]) _ -> (0) }
    }
}
machine required<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping requires Count > 0 { moments[0] }
machine state_required<const Count: u64>(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping requires Count > 0 {
    transition { _ -> read(moments) }
    machine read(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping requires Count > 0 { moments[0] }
}
machine main() crashes Trap {
    let values: [i64 in Wrapping; 5] = [6,0,12,0,48];
    let empty: [i64 in Wrapping; 0];
    let empty_record: Moments<0>;
    let mut record: Moments<6>; record.values = [6,0,12,0,48,9];
    let a: i64 in Wrapping = first<5>(&values); let b: i64 in Wrapping = first<0>(&empty);
    let c: i64 in Wrapping = mirrored<5>(&values); let d: i64 in Wrapping = negated<5>(&values);
    let e: i64 in Wrapping = negated<0>(&empty); let f: i64 in Wrapping = aliased<5>(&values);
    let g: i64 in Wrapping = projected<6>(&record);
    let h: i64 in Wrapping = polynomial<5>(&values, false); let i: i64 in Wrapping = polynomial<5>(&values, true);
    let j: i64 in Wrapping = polynomial<0>(&empty, true); let k: i64 in Wrapping = ranged<5>(&values);
    let l: i64 in Wrapping = required<5>(&values); let m: i64 in Wrapping = state_required<5>(&values);
    let n: i64 in Wrapping = projected<0>(&empty_record);
    let o: i64 in Wrapping = ranged<0>(&empty);
    transition a == 6 && b == 0 && c == 6 && d == 6 && e == 0 && f == 6 && g == 6
        && h == 72 && i == 1728 && j == 0 && k == 12 && l == 6 && m == 6 && n == 0 && o == 0 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
