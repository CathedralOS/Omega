data Counts {}
const Counts::FOUR: u64 = 4;
const Counts::ENABLED: bool = true;

data Mode<const Count: u64> [copy] { value: u64; }
data Flag<const Enabled: bool> [copy] { value: u64; }

machine selected<Payload>() -> u64
where Payload == Mode<Counts::FOUR>
{ 7 }

machine enabled<Payload>() -> u64
where Payload == Flag<Counts::ENABLED>
{ 13 }

data Recovered<Anchor [copy], Payload [copy]> [copy]
where Payload == Mode<Counts::FOUR>
{ value: Payload; anchor: Anchor; }

data Verified<Payload [copy]> [copy]
where Payload == Mode<Counts::FOUR>
{ value: Payload; }

data RecoveredFlag<Anchor [copy], Payload [copy]> [copy]
where Flag<Counts::ENABLED> == Payload
{ value: Payload; anchor: Anchor; }

data Main {
    result: u64; boolean_result: u64;
    recovered: Recovered<u64>; verified: Verified<Mode<4> >;
    flag: RecoveredFlag<u64>;
}

machine main(main: &mut Main) crashes Trap {
    main.result = selected<Mode<4> >();
    main.boolean_result = enabled<Flag<true> >();
    main.recovered.value.value = 11;
    main.verified.value.value = 17;
    main.flag.value.value = 19;
    transition main.result == 7 && main.boolean_result == 13
        && main.recovered.value.value == 11 && main.verified.value.value == 17
        && main.flag.value.value == 19 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
