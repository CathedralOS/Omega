use omega_language_std::console;
use omega::language::core::binding;

domain<Carrier, const Index: u64> Carrier::Tagged<Index>;

data Box<Payload [copy], const Index: u64> [copy]
where
    Payload == u64::Tagged<Index>
{
    value: Payload;
}

data Main {
    console: Binding<Console>;
    box: Box<u64 in Tagged<8> >;
}

machine Main::main(main: &mut Main) reaches Console {
    main.box.value = 7 as u64 in Tagged<8>;
    main.console.exit_process(main.box.value as i32);
}
