use omega_language_std::console;

domain<Carrier, const Index: u64> Carrier::Tagged<Index>;

data Box<Payload [copy], const Index: u64> [copy]
where
    Payload == u64::Tagged<Index>
{
    value: Payload;
}

data Main {
    box: Box<u64 in Tagged<8> >;
}

machine Main::main(main: &mut Main) reaches Console {
    main.box.value = 7 as u64 in Tagged<8>;
    Console::exit_process(main.box.value as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    entry_storage.box.value = 0 as u64 in Tagged<8>;
    Main::main(&mut entry_storage);
}
