machine selected<'source>(value: &'source u64) -> &u64 { value }

machine apply<machine Callback>(value: &u64) -> &u64
where machine Callback<'invocation>(value: &'invocation u64) -> &'invocation u64;
{ Callback(value) }

machine main() crashes Trap {
    let value: u64 = 42u64;
    let result: &u64 = apply<selected>(&value);
    transition result == 42u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
