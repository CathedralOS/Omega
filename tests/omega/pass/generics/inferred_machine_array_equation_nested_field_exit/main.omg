// Expected exit: 0
data Inner { items: [u8; 2]; }
data Outer { inner: Inner; }
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
where Length == [u8; Capacity]
{ Capacity }
machine main(context: &mut Outer) crashes Trap {
    context.inner.items[0] = 7;
    context.inner.items[1] = 11;
    let observed: u64 = capacity(context.inner.items);
    transition observed == 2 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Outer;
    main(&mut entry_storage);
}
