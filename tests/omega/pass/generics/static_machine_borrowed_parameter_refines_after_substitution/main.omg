// A static machine argument whose parameter borrows a concrete element type
// (`&i32`) refines a requirement spelled over the callee's binder (`&T`) once
// the call's own tuple substitutes `T := i32`. The tuple comes from ordinary
// argument inference: a specialized body's payload field (`tail`) denotes its
// receiver's substituted field type, a generic holder's field likewise, and an
// argument that is itself an unapplied generic call (`map<negate>(items)`)
// supplies its binding only once that call is specialized, never its declared
// `Seq<U>` schema. The predicate reaches `filter` directly, through a
// forwarding machine binder (concrete and generic), against a second type
// binder, and as a `&mut T` requirement.

data Seq<T> {
    case Empty;
    case Cons(head: T, tail: Seq<T>);
}

data Holder<T> {
    items: Seq<T>;
}

machine filter<T, machine Predicate>(items: Seq<T>) -> Seq<T>
where machine Predicate(value: &T) -> bool;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> choose(
            Predicate(head),
            head,
            filter<Predicate>(tail)
        )
    }

    machine choose(keep: bool, head: T, tail: Seq<T>) -> Seq<T> {
        transition keep {
            true -> Seq::Cons { head: head, tail: tail }
            false -> tail
        }
    }
}

machine filter_against<T, U, machine Predicate>(items: Seq<T>, bound: U) -> Seq<T>
where machine Predicate(value: &T, bound: &U) -> bool;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> choose(
            Predicate(head, bound),
            head,
            filter_against<Predicate>(tail, bound)
        )
    }

    machine choose(keep: bool, head: T, tail: Seq<T>) -> Seq<T> {
        transition keep {
            true -> Seq::Cons { head: head, tail: tail }
            false -> tail
        }
    }
}

machine filter_touch<T, machine Touch>(items: Seq<T>) -> Seq<T>
where machine Touch(value: &mut T) -> bool;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> step(head, tail)
    }

    machine step(head: T, tail: Seq<T>) -> Seq<T> {
        let current: T = head;
        let keep: bool = Touch(&mut current);
        transition { _ -> choose(keep, current, filter_touch<Touch>(tail)) }
    }

    machine choose(keep: bool, head: T, tail: Seq<T>) -> Seq<T> {
        transition keep {
            true -> Seq::Cons { head: head, tail: tail }
            false -> tail
        }
    }
}

machine map<T, U, machine F>(items: Seq<T>) -> Seq<U>
where machine F(value: T) -> U;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> Seq::Cons {
            head: F(head),
            tail: map<F>(tail)
        }
    }
}

machine count<T>(items: Seq<T>) -> u64
terminates by items;
{
    transition items {
        Seq::Empty -> 0
        Seq::Cons { head, tail } -> bump(count(tail))
    }
}

machine bump(n: u64) -> u64 {
    ((n as u64 in Wrapping) + 1) as u64
}

machine positive(value: &i32) -> bool {
    value > 0
}

machine above(value: &i32, bound: &u8) -> bool {
    value > (bound as i32)
}

machine negate(value: i32) -> i32 {
    ((value as i32 in Wrapping) * -1) as i32
}

machine clear_negative(value: &mut i32) -> bool {
    transition value > 0 {
        true -> kept()
        false -> cleared(value)
    }
    machine kept() -> bool { true }
    machine cleared(value: &mut i32) -> bool {
        value = 0;
        transition { _ -> false }
    }
}

machine keep_concrete<machine P>(items: Seq<i32>) -> Seq<i32>
where machine P(value: &i32) -> bool;
{
    filter<P>(items)
}

machine keep_generic<T, machine P>(items: Seq<T>) -> Seq<T>
where machine P(value: &T) -> bool;
{
    filter<P>(items)
}

machine direct(items: Seq<i32>) -> Seq<i32> {
    filter<positive>(items)
}

machine forwarded_concrete(items: Seq<i32>) -> Seq<i32> {
    keep_concrete<positive>(items)
}

machine forwarded_generic(items: Seq<i32>) -> Seq<i32> {
    keep_generic<positive>(items)
}

machine two_binders(items: Seq<i32>, bound: u8) -> Seq<i32> {
    filter_against<above>(items, bound)
}

machine held(holder: Holder<i32>) -> Seq<i32> {
    filter<positive>(holder.items)
}

machine nested_call_result(items: Seq<i32>) -> u64 {
    count(filter<positive>(map<negate>(items)))
}

machine touched(items: Seq<i32>) -> Seq<i32> {
    filter_touch<clear_negative>(items)
}

machine main() {}
