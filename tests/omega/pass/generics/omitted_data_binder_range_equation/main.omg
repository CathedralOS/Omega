use omega_language_std::console;

// A `where` type equation recovers an omitted trailing data binder from the
// supplied argument's canonical type structure, and an explicit tuple must
// satisfy the equation exactly. A call's declared-range requirement stays
// separate: `upper_bound<512>` remains ordinary range compatibility, not an
// exact type equation.
data TinyBytes<Length, const Capacity: u64>
where
    Length == [u8; Capacity]
{
    storage: [u8; Capacity];
    length: Length;
}

// The constructed direction is a domain-index equation instead of a range
// shell: `Length == u64::AtMost<Capacity>` builds the omitted Length
// application from the supplied Capacity, and the domain's own index is the
// authored capacity argument. Its field remains runtime data with that
// exact qualification; an established domain value enters through an
// explicit `as` mint, and field construction requires routed establishment
// (see the invalid-initializer canary legs).
domain<const Bound: u64> u64::AtMost<Bound>(value)
    requires value <= Bound;

data Bytes<const Capacity: u64, Length [copy]> [copy]
where
    Length == u64::AtMost<Capacity>
{
    storage: [u8; Capacity];
    length: Length;
}

// The specification's domain-index equation selects a fixed 256-byte backing.
data DomainBytes<Length, const Capacity: u64>
where
    Length == u64::AtMost<Capacity>
{
    storage: [u8; Capacity];
    length: Length;
}

data Shapes {
    inclusive: TinyBytes<[u8; 256]>;
    exclusive: TinyBytes<[u8; 256]>;
    explicit: TinyBytes<[u8; 256], 256>;
    kept: Bytes<256>;
    exact: Bytes<256, u64 in AtMost<256> >;
    domain: DomainBytes<u64::AtMost<256> >;
}

machine upper_bound<const N: u64>(value: u64) -> u64 requires value <= N { N }
machine larger(value: u64) -> u64 requires value <= 256 { upper_bound<512>(value) }

machine preserve_constructed(value: Bytes<256>) -> u64 {
    let kept: Bytes<256, u64 in AtMost<256> > = value;
    kept.length as u64
}

// A declared domain index is also an ordinary call-time binder: the supplied
// member's own index selects N. The call edge carries the authored requires
// premise, so it is checked but not build-time admissible.
machine domain_index<const N: u64>(value: u64 in AtMost<N>) -> u64 { N }

machine constructed_index(value: u64 in AtMost<256>) -> u64 {
    domain_index<256>(value)
}

machine constructed_value(value: u64) -> u64 requires value <= 256 {
    let established: u64 in AtMost<256> = value as u64 in AtMost<256>;
    established as u64
}

machine constructed_capacity(value: u64) -> u64 requires value <= 256 {
    let established: u64 in AtMost<256> = value as u64 in AtMost<256>;
    upper_bound<256>(established as u64)
}

data Main {
    storage: [u8; 256];
    length: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.length = 1;
    main.storage[255] = 91;
    let result: i32 = (main.storage[255] as i32) + (main.length as i32);
    Console::exit_process(result);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
