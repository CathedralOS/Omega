// A `where` type equation recovers an omitted trailing data binder from the
// supplied argument's canonical range: `TinyBytes<u64[0..=256]>` binds
// Capacity to 256 before layout, the exclusive spelling `u64[0..257]`
// normalizes to the same interval and selects the same instance, and an
// explicit tuple must satisfy the equation exactly. A call's declared-range
// inference stays separate: `upper_bound<512>` remains ordinary range
// compatibility, not an exact type equation.
data TinyBytes<Length, const Capacity: u64>
where
    Length == u64[0..=Capacity]
{
    storage: [u8; Capacity];
    length: Length;
}

data Main {
    inclusive: TinyBytes<u64[0..=256]>;
    exclusive: TinyBytes<u64[0..257]>;
    explicit: TinyBytes<u64[0..=256], 256>;
}

machine upper_bound<const N: u64>(value: u64[0..=N]) -> u64 { N }
machine larger(value: u64[0..=256]) -> u64 { upper_bound<512>(value) }

// The same equation also constructs an omitted Length from a supplied
// Capacity. Its field remains runtime data with that exact qualification.
data Bytes<const Capacity: u64, Length [copy]> [copy]
where
    Length == u64[0..=Capacity]
{
    storage: [u8; Capacity];
    length: Length;
}

machine preserve_constructed(value: Bytes<256>) -> Bytes<256, u64[0..=256]> { value }

machine constructed_value(value: u64[0..=256]) -> u64 {
    let bytes: Bytes<256> = Bytes { length: value };
    bytes.length
}

machine constructed_capacity(value: u64[0..=256]) -> u64 {
    let bytes: Bytes<256> = Bytes { length: value };
    upper_bound(bytes.length)
}

machine Main::main(&mut self) {
}
