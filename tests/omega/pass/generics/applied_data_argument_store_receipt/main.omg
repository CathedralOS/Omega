// Values whose applied data arguments correspond keep checking at every
// store: a local, a returned value, a transition value, a field store, a
// state argument, a call argument, nested applications and field reads of
// generic instances, with concrete and parameter arguments alike.
data Foo { tag: u8; }
data Holder<T> { value: T; }
data Box<Content> { content: Content; }
data Shelf { slot: Holder<Foo>; item: Foo; }
machine same<T>(item: T) -> T { item }
machine take(value: Holder<Foo>) -> u8 { 0u8 }
machine take_foo(value: Foo) -> u8 { 0u8 }
machine concrete(item: Holder<Foo>, spare: Holder<Foo>, last: Holder<Foo>, nested: Holder<Box<Foo>>, shelf: &mut Shelf, flag: bool) -> Holder<Foo> {
    let mut held: Holder<Foo> = same<Holder<Foo>>(item);
    let boxed: Holder<Box<Foo>> = same<Holder<Box<Foo>>>(nested);
    let inner: Box<Foo> = boxed.value;
    let narrow: Holder<u8> = same<Holder<u8>>(Holder { value: 3u8 });
    let byte: u8 = narrow.value;
    let read: Foo = held.value;
    held.value = Foo { tag: 0u8 };
    shelf.item = same<Foo>(inner.content);
    let taken: u8 = take_foo(read);
    shelf.slot = same<Holder<Foo>>(spare);
    let passed: u8 = take(same<Holder<Foo>>(held));
    transition flag {
        true -> (same<Holder<Foo>>(last))
        false -> finish(same<Holder<Foo>>(last))
    }
    state finish(value: Holder<Foo>) -> Holder<Foo> { value }
}
machine rigid<Input, Output>(source: Holder<Input>, nested: Holder<Box<Output>>, target: &mut Holder<Input>, flag: bool) -> Output {
    let got: Input = source.value;
    target.value = same<Input>(got);
    let inner: Box<Output> = nested.value;
    transition flag {
        true -> (inner.content)
        false -> finish(inner.content)
    }
    state finish(value: Output) -> Output { same<Output>(value) }
}
machine main() {}
