// Expected exit: 0
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy] where view.bytes.len == Count { view: View<'storage>; }
machine snapshot<'storage>(source: View<'storage>) -> Counted<'storage, (source.bytes.len)> { Counted { view: source } }
machine overwrite<'storage>(slot: &mut View<'storage>) -> u64 ensures slot.bytes.len == 9 { slot.bytes = "123456789"; 0 }
machine shifted<'storage>(ignored: u64, selected: Counted<'storage, 9>) -> u64 { 0 }
machine exercise() -> u64 {
    let mut original: View = View { bytes: "1234567", sibling: "tail" };
    shifted(overwrite(&mut original), snapshot(original))
}

machine main() crashes Trap {
    let observed: u64 = exercise();
    transition observed == 0 { true -> done() false -> wrong() }
    state done() {} state wrong() { crash Trap; }
}
