// Field observation must use the closed receiver's declaration at each hop,
// retaining both the actual scalar type and its arithmetic policy.
data Cell<Value> { value: Value; }
data Pair<Value> { nested: Cell<Value>; direct: Value; }

machine main() crashes Trap {
    let integer: Pair<i32 in Wrapping> = Pair {
        nested: Cell { value: (2147483647 as i32 in Wrapping) },
        direct: (1 as i32 in Wrapping)
    };
    let boolean: Pair<bool> = Pair {
        nested: Cell { value: true },
        direct: false
    };
    let total: i32 in Wrapping = integer.nested.value + integer.direct;
    transition total == ((-2147483647 as i32 in Wrapping) - (1 as i32 in Wrapping))
        && boolean.nested.value && !boolean.direct {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
