data Counts {}
const Counts::FOUR: u64 = 4;
const Count: u64 = 4;

data Fixed<Payload [copy], Element [copy]> [copy]
where Payload == [Element; 4] {
    values: [Element; Counts::FOUR];
    bare: [Element; Count];
}

data Mixed<Element [copy], const Count: u64> [copy] {
    fixed: [Element; Counts::FOUR];
    sized: [Element; Count];
}

data Main {
    fixed: Fixed<[u64; 4]>;
    mixed: Mixed<u64, 2>;
}

machine main(main: &mut Main) crashes Trap {
    main.fixed.values[3] = 11;
    main.fixed.bare[3] = 19;
    main.mixed.fixed[3] = 13;
    main.mixed.sized[1] = 17;
    transition main.fixed.values[3] == 11 && main.mixed.fixed[3] == 13
        && main.fixed.bare[3] == 19 && main.mixed.sized[1] == 17
        && main.mixed.sized.len == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
