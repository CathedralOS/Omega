use shapes::Box;
data Holder<Value [copy]> [copy] { value: Value; }
data Nested<Payload [copy], Element [copy], Box> [copy]
where Payload == [Element; 4] {
    nested: Holder<shapes::Box<u64>>;
    payload: Payload;
}
data Main { value: Nested<[u64; 4], u64, bool>; }
machine main(main: &mut Main) crashes Trap {
    main.value.nested.value.value = 31;
    main.value.payload[3] = 17;
    transition main.value.nested.value.value == 31
        && main.value.payload[3] == 17 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
