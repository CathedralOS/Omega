use omega::language::core::drop;

data Token<'backing, Payload> [linear] {
    payload: Payload;
    reference: &'backing i32;
}
machine Token::drop(token: &mut Token<'backing, Payload>) {}

machine make<'storage, Payload>(payload: Payload, reference: &'storage i32)
    -> Token<'storage, Payload>
{
    Token { payload: payload, reference: reference }
}

machine array_value<'storage>(token: &Token<'storage, [u64; 2]>) -> u64 {
    token.payload[1]
}

machine main() crashes Trap {
    let first: i32 = 73;
    let second: i32 = 74;
    let scalar: Token<i32> = make(41, &first);
    let array: Token<[u64; 2]> = make([19, 23], &second);
    let left: i32 = scalar.payload;
    let right: u64 = array.payload[1];
    let called: u64 = array_value(&array);
    let first_seen: i32 = scalar.reference;
    let second_seen: i32 = array.reference;
    drop(scalar);
    drop(array);
    transition left == 41 && right == 23 && called == 23 && first_seen == 73 && second_seen == 74 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
