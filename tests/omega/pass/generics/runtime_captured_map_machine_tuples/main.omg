// Expected exit: 0. Independent complete callback applications.
trait Getter { machine get() -> i32 blocks; }
Selected<machine Callback> satisfies Getter
where machine Callback() -> i32;
{ machine get() -> i32 { Callback() } }
machine read<const Output: i32>() -> i32 { Output }
machine choose<Operations satisfies Getter>() -> i32 blocks; { block Operations::get() }
machine main() blocks; crashes Trap {
 let first: i32 = block choose<Selected<read<2>>>();
 let second: i32 = block choose<Selected<read<4>>>();
 transition first == 2 && second == 4 { true -> done() _ -> bad() }
 state done() {} state bad() { crash Trap; }
}
