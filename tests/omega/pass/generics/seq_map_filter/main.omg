// seq_map_filter: the core Seq<T> higher-order machine surface as user code —
// map<F> and filter<Predicate> take STATIC machine parameters, each call
// specializing the recursive template into direct calls (no runtime callable
// or capture object). First sample to call the core `seq` machines; the only
// prior exercise is a corpus fixture that redefines its own local Seq.
//
// The machine maps 1..5 through `triple` (3,6,9,12,15), keeps the even terms
// via `keep_even` (6,12), then folds to 18 — the recursion goes through
// state machines carrying the Seq value and the running sum.
// Compile-checked only: no standard-library dependency, no ProcessExit
// provider, no run behavior to pin.
// NOTE: `use omega::language::core::seq` currently fails admission — the
// shipped module's `reverse_snoc` ensures contract is rejected ("speaks about
// proof-only Seq, which no entailment tier judges yet"). The local copies
// below are the corpus-spellable subset until the core module is importable.

data Seq<T> {
    case Empty;
    case Cons(head: T, tail: Seq<T>);
}

machine map<T, U, machine F>(items: Seq<T>) -> Seq<U>
where machine F(value: T) -> U;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> Seq::Cons {
            head: F(head),
            tail: map<F>(tail)
        }
    }
}

machine filter<T, machine Predicate>(items: Seq<T>) -> Seq<T>
where machine Predicate(value: &T) -> bool;
terminates by items;
{
    transition items {
        Seq::Empty -> Seq::Empty
        Seq::Cons { head, tail } -> choose(
            Predicate(head),
            head,
            filter<Predicate>(tail)
        )
    }

    machine choose(keep: bool, head: T, tail: Seq<T>) -> Seq<T> {
        transition keep {
            true -> Seq::Cons { head: head, tail: tail }
            false -> tail
        }
    }
}

machine triple(value: u64) -> u64 {
    // Wrapping needs no range premise; the result casts back out of the domain.
    ((value as u64 in Wrapping) * 3) as u64
}

machine keep_even(value: &u64) -> bool {
    value % 2 == 0
}

machine input() -> Seq<u64> {
    Seq::Cons { head: 1, tail:
        Seq::Cons { head: 2, tail:
            Seq::Cons { head: 3, tail:
                Seq::Cons { head: 4, tail:
                    Seq::Cons { head: 5, tail: Seq::Empty } } } } }
}

machine seq_map_filter() {
    let evens: Seq<u64> = filter<keep_even>(map<triple>(input()));
    transition { _ -> fold(evens, 0) }

    machine fold(items: Seq<u64>, sum: u64 in Wrapping) {
        transition items {
            Seq::Cons { head, tail } -> fold(tail, sum + (head as u64 in Wrapping))
            Seq::Empty -> judge(sum)
        }
    }

    machine judge(sum: u64 in Wrapping) {
        transition (sum as u64) == 18 {
            true -> done(70)
            _ -> done(71)
        }
    }

    machine done(code: i32) {}
}
