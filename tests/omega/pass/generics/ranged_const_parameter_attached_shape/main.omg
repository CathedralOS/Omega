// Ordinary const requirements admit exactly capacities 1 through 64.
// Two applications retain their separate layouts and writable array storage.
use omega_language_std::console;

data Buffer<const Capacity: u64> where Capacity >= 1 && Capacity <= 64 {
    items: [i32; Capacity];
}

data Main {
    small: Buffer<2>;
    large: Buffer<64>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.small.items[1] = 30;
    main.large.items[63] = 40;
    transition { _ -> check(main) }

    state check(main: &Main) {
        transition main.small.items[0] == 0 && main.small.items[1] == 30
            && main.large.items[62] == 0 && main.large.items[63] == 40 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &Main) { Console::exit_process(70); }
    state bad(main: &Main) { Console::exit_process(71); }
}
