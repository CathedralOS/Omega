use omega::language::core::drop;

data Token<Payload> [linear] { payload: Payload; }
data Envelope<Payload> { payload: Payload; }
machine Token::drop(token: &mut Token<Payload>) {}

machine make<Payload>(payload: Payload) -> Token<Payload> {
    Token { payload: payload }
}

machine accept<Payload>(payload: &Payload) -> bool { true }

machine read(envelope: &Envelope<i32>) -> i32 { envelope.payload }
machine read_nested(envelope: &Envelope<&Envelope<i32>>) -> i32 { envelope.payload.payload }
machine read_array(envelope: &Envelope<&[Envelope<i32>; 2]>) -> i32 { envelope.payload[1].payload }

machine identity<'storage, Payload>(payload: &'storage Payload) -> &'storage Payload {
    payload
}

machine reborrow<'storage>(payload: &'storage i32) -> i32 {
    let reference: &'storage i32 = identity(&payload);
    reference
}

machine main() crashes Trap {
    let backing: i32 = 73;
    let token: Token<&i32> = make(&backing);
    let accepted: bool = accept(&backing);
    let observed: i32 = token.payload;
    let forwarded: i32 = reborrow(&backing);
    // Each completed child supplies the borrow's type before generic call
    // inference: constructed records, nested borrows and fixed arrays agree.
    let constructed: i32 = read(&Envelope { payload: 91i32 });
    let nested: i32 = read_nested(&Envelope { payload: &Envelope { payload: 37i32 } });
    let array: bool = accept(&[Envelope { payload: 19i32 }]);
    let array_leaf: i32 = read_array(&Envelope { payload: &[Envelope { payload: 47i32 }, Envelope { payload: 53i32 }] });
    drop(token);
    transition observed == 73 && forwarded == 73 && accepted && constructed == 91 && nested == 37 && array && array_leaf == 53 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
