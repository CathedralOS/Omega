// Fact: a selected const call establishes Capacity=2 before an exact array equation and inferred consumer tuple.
// Expected exit: 0
machine extent() -> u64 { 2 }
data IndexedPacket<Value [copy], const Capacity: u64> [copy]
requires Value == [u8; Capacity]
{ items: Value; }
machine capacity<Length [copy], const Capacity: u64>(items: Length) -> u64
requires Length == [u8; Capacity]
{ Capacity }
machine joined(flag: bool, expected_first: u8) -> u64 crashes Trap {
    let left: IndexedPacket<[u8; 2], extent()> = IndexedPacket { items: [7, 11] };
    let right: IndexedPacket<[u8; 2], extent()> = IndexedPacket { items: [19, 23] };
    let items: IndexedPacket<[u8; 2], extent()> = match flag { true -> left, false -> right };
    let observed: u64 = capacity(forward(items).value.items);
    transition items.items[0] == expected_first { true -> observed false -> bad() }
    machine bad() -> u64 crashes Trap { crash Trap; }
}
data Envelope<Value [copy]> [copy] { value: Value; }
machine forward<Value [copy]>(value: Value) -> Envelope<Value> { Envelope { value: value } }
machine main() crashes Trap {
    let left_result: u64 = joined(true, 7u8);
    let right_result: u64 = joined(false, 19u8);
    transition left_result == 2 && right_result == 2 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
