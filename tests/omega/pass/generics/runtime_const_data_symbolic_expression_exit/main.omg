// Symbolic const arguments evaluate before instance synthesis. The direct
// spelling resolves scoped const operands; the forwarded spelling resolves an
// enclosing const parameter plus a scoped const in the concrete clone.
use omega_language_std::console;

data Sizes {
}

const Sizes::BASE: u64 = 2;
const Sizes::STEP: u64 = 1;

data FixedBuffer<const N: u64> {
    items: [i32 in Wrapping; N];
}

data ForwardedBuffer<const N: u64> {
    buffer: FixedBuffer<N + Sizes::BASE>;
}

data Main {
    small: FixedBuffer<Sizes::BASE + Sizes::STEP>;
    forwarded: ForwardedBuffer<2>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.small.items[2] = 30;
    main.forwarded.buffer.items[3] = 40;
    let result: i32 in Wrapping = main.small.items[2] + main.forwarded.buffer.items[3];
    Console::exit_process(result as i32);
}
