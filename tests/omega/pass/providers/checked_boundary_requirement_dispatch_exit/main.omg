// CheckedMath::offset_zero is a one-member boundary trait with an empty
// reach. Build selects the checked adapter. The direct call stays on that
// trait through Terminal Psi, and both engines return the adapter's result.
// Expected exit: 70.
use omega_language_std::console;

public boundary trait CheckedMath {
    machine offset_zero(value: i32) -> i32
    reaches;
}

data CheckedMathProvider {}

machine CheckedMathProvider::offset_zero_impl(value: i32) -> i32
satisfies CheckedMath::offset_zero
{
    value
}

machine length() -> i32 { CheckedMath::offset_zero(9) }

data Main { bytes: [u8; length()]; }

machine Main::main(main: &mut Main)
reaches Console
{
    // The same named requirement executes its checked provider during type
    // evaluation. Index 8 requires the computed length, not a placeholder.
    main.bytes[8] = 1;
    // The result is the installed adapter's, read at runtime: native code
    // passes it straight to the host exit rather than a value computed from
    // it, which normalized foreign-call custody does not yet admit.
    let selected: i32 = CheckedMath::offset_zero(70);
    Console::exit_process(selected);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
