// A public top-level boundary requirement is its own provider slot: the
// `boundary requirement` form (no operator token, no `operator` introducer)
// declares the required operation, a checked adapter `satisfies` it, and the
// unique covering adapter is the declaration-era default. Checking retains
// the public requirement contract and the exact ProviderPlan identity;
// the direct call stays on the requirement through Terminal Psi, and Omega
// installs the selected adapter; the interpreter dispatches the same row.
use omega_language_std::console;
use omega::language::core::binding;

pub data CheckedMath {}

pub boundary requirement CheckedMath::offset_zero(value: i32) -> i32
requires value == value
ensures result == value + 0 && value == value;

data CheckedMathProvider {}

machine CheckedMathProvider::offset_zero_impl(input: i32) -> i32
satisfies CheckedMath::offset_zero
requires input == input
ensures result == input + 0 && input == input
{
    transition { _ -> (input + 0) }
}

data Main { console: Binding<Console>; }

machine Main::main(&mut self)
reaches Console
{
    // The result is the installed adapter's, read at runtime: native code
    // passes it straight to the host exit rather than a value computed from
    // it, which normalized foreign-call custody does not yet admit.
    let selected: i32 = CheckedMath::offset_zero(70);
    self.console.exit_process(selected);
}
