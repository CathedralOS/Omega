// Expected exit: 0. One descendant supplies direct and nested ancestor
// applications beneath the entry's applied data telescope. The record and
// activation use different region names; a helper must preserve the same
// selection.

public boundary trait Parent<Value> { machine read() -> i32 reaches; }
public boundary trait Child: Parent<u64> { machine choose() -> i32 reaches; }

ChildMap satisfies Child {
    Parent::read = read;
    Child::choose = choose;
}
machine read() -> i32 { 37 }
machine choose() -> i32 { 19 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

data Session {}
data Main {
    session: Session;
}

machine observed() -> i32 reaches Parent {
    Parent<u64>::read()
}
machine Main::main(main: &mut Main)
reaches Child + Parent crashes Trap {
    let direct: i32 = observed();
    let nested: i32 = observed();
    let chosen: i32 = Child::choose();
    transition direct == 37 && nested == 37 && chosen == 19 {
        true -> done() _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Child + Parent crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
