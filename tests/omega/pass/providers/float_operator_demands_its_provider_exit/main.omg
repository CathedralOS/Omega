// A float comparison demands its operator requirement's provider plan, so
// each selected target settles the compiler-intrinsic row for `==` and `!=`.
// Expected exit: 0
machine main() crashes Trap {
    let narrow: f32 = -0.0;
    let wide: f64 = 2.5;
    transition narrow == 0.0 && narrow != 1.0 && wide != 2.0 && !(wide == 3.0) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
