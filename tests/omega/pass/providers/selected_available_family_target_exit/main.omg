pub boundary trait ValuePolicy {
    machine read() -> u64;
}
linux_x86_64 machine linux_only() -> u64 { transition { _ -> 7 } }
machine available() -> u64 { transition { _ -> 7 } }
MissingProvider satisfies ValuePolicy { ValuePolicy::read = linux_only; }
AvailableProvider satisfies ValuePolicy { ValuePolicy::read = available; }
data Main {}
machine Main::main(main: &mut Main) reaches ValuePolicy crashes Trap {
    let result: u64 = ValuePolicy::read();
    transition result == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
