// A boundary receives an owned primitive array between scalar arguments.
// The later scalar operand mutates the source; the provider must observe the
// array snapshot captured earlier, while the caller observes the later write.
use omega::language::core::binding;
use omega_language_std::console;

pub boundary trait Thing {
    machine take(first: u64, values: [u8; 4], last: u64) -> i32;
}

data ThingProvider {}
machine ThingProvider::take(first: u64, values: [u8; 4], last: u64) -> i32
satisfies Thing::take {
    transition first == 11 && last == 22
        && values[0] == 30 && values[1] == 40
        && values[2] == 50 && values[3] == 60 {
        true -> 70
        _ -> 73
    }
}

data Main {
    console: Binding<Console>;
    thing: Binding<Thing>;
    buffer: [u8; 4];
}

machine Main::stamp(main: &mut Main) -> u64 {
    main.buffer[0] = 99;
    22
}

machine Main::main(main: &mut Main) reaches Console, Thing {
    main.buffer[0] = 30;
    main.buffer[1] = 40;
    main.buffer[2] = 50;
    main.buffer[3] = 60;
    let result: i32 = main.thing.take(11, main.buffer, Main::stamp(main));
    transition result == 70 && main.buffer[0] == 99 && main.buffer[1] == 40 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(74); }
}
