// PRV4: a CHECKED ADAPTER -- an ordinary machine with a body and a
// requirement-named satisfies edge -- joins the plan derivation as a
// CheckedAdapter row (coverage counts it; its transitive service reach refines
// the requirement's declared ceiling: an effect-free body under an
// effect-free requirement here).
use omega_language_std::console;
boundary trait Echo {
    machine echo(x: i32) -> i32;
}

data EchoProvider {}
machine EchoProvider::echo_adapter(x: i32) -> i32 satisfies Echo::echo {
    transition { _ -> (x) }
}

data Main { console: Console; }
machine Main::main(&mut self) {
    self.console.exit_process(70);
}
