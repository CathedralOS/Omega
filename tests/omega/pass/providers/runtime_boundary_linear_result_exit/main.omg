// A checked provider returns a linear structural result through its boundary
// requirement. The caller's call occurrence mints the result's claims from the
// checked boundary custody; every returning edge of the selected candidate
// transfers the claims live beneath its returned value, so installation joins
// the two rosters by typed path rather than refusing linear carriers. The
// result is received directly, through a local, as a field of a composite
// returned from a later state, and inside another caller state.
use omega::language::core::drop;
use omega_language_std::console;

pub data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
pub domain Token::Issued;
pub data Packet { token: Token; marker: u64; }

pub boundary trait TokenMint {
    machine issue(value: u64) -> Token in Token::Issued;
    machine wrap(token: Token, marker: u64) -> Packet;
}

data TokenMintProvider {}

machine TokenMintProvider::issue(value: u64) -> Token in Token::Issued
satisfies TokenMint::issue
{
    let token: Token in Token::Issued = Token { value: value };
    token
}

machine TokenMintProvider::wrap(token: Token, marker: u64) -> Packet
satisfies TokenMint::wrap
{
    let held: Token = token;
    transition { _ -> finish(held, marker) }
    state finish(held: Token, marker: u64) -> Packet {
        Packet { token: held, marker: marker }
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console, TokenMint {
    let direct: Token = TokenMint::issue(11);
    let packet: Packet = TokenMint::wrap(direct, 19);
    transition { _ -> check(main, packet) }
    state check(main: &mut Main, packet: Packet) {
        let later: Token = TokenMint::issue(17);
        let correct: bool = packet.token.value == 11
            && packet.marker == 19
            && later.value == 17;
        drop(packet.token);
        drop(later);
        transition correct {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}
