// The build root owns the final slot choice and may replace a target package's
// ordinary default without reconstructing any provider rows.
boundary trait Pick {
    machine choose() -> i32 reaches;
}

data FirstProvider { }
machine FirstProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (1) }
}

data SecondProvider { }
machine SecondProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (2) }
}

data CanaryTargetProviders { }
boundary trait SelectedCanaryTargetProvidersProviderDefaults {
    machine provider_defaults(defaults: &mut CanaryTargetProviders) reaches
;
}
CheckedCanaryTargetProvidersProviderDefaults satisfies SelectedCanaryTargetProvidersProviderDefaults {
    machine provider_defaults(defaults: &mut CanaryTargetProviders)
{
    CanaryTargetProviders::select_provider<Pick, FirstProvider>(defaults);
}
}




machine main() { }
