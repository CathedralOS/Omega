use omega_language_std::console;

public boundary trait ArrayValue {
    machine read(values: [i32; 2]) -> i32 reaches;
}
ArrayProvider satisfies ArrayValue {
    ArrayValue::read = first;
}
machine first(values: [i32; 2]) -> i32 { values[0] }

data Main {
    count: u64 in Wrapping;
    total: i32 in Wrapping; 
}
machine Main::main(main: &mut Main) reaches ArrayValue + Console {
    main.count = 0;
    main.total = 0;
    transition { _ -> step(main) }
    machine step(main: &mut Main) {
        let values: [i32; 2] = [35, 7];
        let observed: i32 = ArrayValue::read(values);
        main.total += observed as i32 in Wrapping;
        main.count += 1;
        transition main.count < 2 {
            true -> step(main)
            _ -> done(main)
        }
    }
    machine done(main: &mut Main) {
        Console::exit_process(main.total as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ArrayValue + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
