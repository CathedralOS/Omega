use omega::language::core::ProcessExit;

// glibc mallinfo2 returns an 80-byte record through the SysV hidden result pointer.

public data AllocationStatistics {
    arena: u64;
    ordinary_blocks: u64;
    small_blocks: u64;
    mapped_blocks: u64;
    mapped_bytes: u64;
    unused_bytes: u64;
    freed_bytes: u64;
    allocated_bytes: u64;
    available_bytes: u64;
    releasable_bytes: u64;
}
public boundary trait AllocationProbe {
    machine statistics() -> AllocationStatistics reaches;
    machine allocate(bytes: u64) -> addr reaches;
    machine release(pointer: addr) reaches;
}

// glibc reports these relations for every heap history: the arena splits into
// allocated and available bytes, and the unused field is always zero.
machine consistent(statistics: &AllocationStatistics) -> bool {
    statistics.arena >= statistics.allocated_bytes
        && statistics.arena - statistics.allocated_bytes == statistics.available_bytes
        && statistics.ordinary_blocks >= 1
        && statistics.unused_bytes == 0
        && statistics.freed_bytes <= statistics.available_bytes
        && statistics.releasable_bytes <= statistics.available_bytes
}

// The program's own 64 MiB allocation appears as exactly one more mapped block
// of at least that size, whatever the heap held before.
machine mapped_one_block(first: &AllocationStatistics, second: &AllocationStatistics) -> bool {
    second.mapped_blocks > first.mapped_blocks
        && second.mapped_blocks - first.mapped_blocks == 1
        && second.mapped_bytes > first.mapped_bytes
        && second.mapped_bytes - first.mapped_bytes >= 67108864
}

machine relay(statistics: AllocationStatistics, token: u64) -> AllocationStatistics {
    transition token == 70 {
        true -> complete(statistics)
        _ -> replace()
    }
    machine complete(statistics: AllocationStatistics) -> AllocationStatistics { statistics }
    machine replace() -> AllocationStatistics { AllocationProbe::statistics() }
}

machine collect(token: u64) -> AllocationStatistics {
    let statistics: AllocationStatistics = AllocationProbe::statistics();
    relay(statistics, token)
}

data Main {}
machine Main::main(main: &mut Main) reaches ProcessExit {
    // The first record arrives through `complete`; the second is a fresh call in `replace`.
    let first: AllocationStatistics = collect(70);
    // 64 MiB exceeds glibc's largest mmap threshold, so it becomes one mapped block.
    let pointer: addr = AllocationProbe::allocate(67108864);
    let second: AllocationStatistics = collect(0);
    AllocationProbe::release(pointer);
    transition consistent(&first) && consistent(&second) && mapped_one_block(&first, &second) {
        true -> passed(main)
        _ -> failed(main)
    }
    machine passed(main: &mut Main) reaches ProcessExit { ProcessExit::exit_process(70); }
    machine failed(main: &mut Main) reaches ProcessExit { ProcessExit::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
