// glibc mallinfo2 returns an 80-byte record through the SysV hidden result pointer.
use omega::language::core::external_binding;

public data AllocationStatistics {
    arena: u64;
    ordinary_blocks: u64;
    small_blocks: u64;
    mapped_blocks: u64;
    mapped_bytes: u64;
    unused_bytes: u64;
    freed_bytes: u64;
    allocated_bytes: u64;
    available_bytes: u64;
    releasable_bytes: u64;
}
public data AllocationProbe {}
public boundary requirement AllocationProbe::statistics() -> AllocationStatistics;
public boundary requirement AllocationProbe::exit_with(code: i32);
data AllocationProvider {}
linux_x86_64 machine statistics_binding() -> ForeignBinding<9, 9, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "mallinfo2", version: "GLIBC_2.33",
        },
    }
}
linux_x86_64 machine exit_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "exit", version: "GLIBC_2.2.5",
        },
    }
}
linux_x86_64 machine AllocationProvider::statistics() -> AllocationStatistics
satisfies AllocationProbe::statistics via statistics_binding();
linux_x86_64 machine AllocationProvider::exit_with(code: i32)
satisfies AllocationProbe::exit_with via exit_binding();

machine relay(statistics: AllocationStatistics, token: u64) -> AllocationStatistics {
    transition token == 70 {
        true -> complete(statistics)
        _ -> replace()
    }
    state complete(statistics: AllocationStatistics) -> AllocationStatistics { statistics }
    state replace() -> AllocationStatistics { AllocationProbe::statistics() }
}

machine collect(token: u64) -> AllocationStatistics {
    let statistics: AllocationStatistics = AllocationProbe::statistics();
    relay(statistics, token)
}

data Main {}
machine Main::main(main: &mut Main) {
    let first: AllocationStatistics = collect(70);
    let second: AllocationStatistics = collect(0);
    transition first.arena == 0 && first.ordinary_blocks == 1
        && first.small_blocks == 0 && first.mapped_blocks == 0
        && first.mapped_bytes == 0 && first.unused_bytes == 0
        && first.freed_bytes == 0 && first.allocated_bytes == 0
        && first.available_bytes == 0 && first.releasable_bytes == 0
        && second.arena == first.arena
        && second.ordinary_blocks == first.ordinary_blocks
        && second.releasable_bytes == first.releasable_bytes {
        true -> passed(main)
        _ -> failed(main)
    }
    state passed(main: &mut Main) { AllocationProbe::exit_with(70); }
    state failed(main: &mut Main) { AllocationProbe::exit_with(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
