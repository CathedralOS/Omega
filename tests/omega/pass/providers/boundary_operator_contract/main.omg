// A `boundary operator` declares a checked operator contract with its own
// requires/ensures; the satisfying provider restates both sides and the
// caller discharges the requires by literal.
data CheckedMath {}
boundary operator CheckedMath::offset_zero(value: i32) -> i32
requires value == value
ensures result == value + 0 && value == value;

data CheckedMathProvider {}
machine CheckedMathProvider::offset_zero_impl(input: i32) -> i32
satisfies CheckedMath::offset_zero
requires input == input
ensures result == input + 0 && input == input
{
    transition { _ -> (input + 0) }
}

data Main { out: i32; }

machine Main::main(main: &mut Main) {
    let result: i32 = CheckedMath::offset_zero(70);
    main.out = result;
}

// The public promise and its provider retain the cast's arithmetic policy.
// At 256, Wrapping yields 0 while Saturating yields 255.
boundary operator CheckedMath::low_byte(value: u16) -> u8
ensures result == (value as u8 in Wrapping);

machine CheckedMathProvider::low_byte_impl(input: u16) -> u8
satisfies CheckedMath::low_byte
ensures result == (input as u8 in Wrapping)
{
    input as u8 in Wrapping
}
