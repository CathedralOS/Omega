// Expected exit: 0. Read a stable provider-owned object through its retained descriptor.
use omega::language::core::external_binding;
data VersionByte { value: u8; }
boundary trait Version { machine locate() -> &VersionByte; }
linux_x86_64 machine binding() -> ForeignBinding<9, 20, 11> {
 ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "gnu_get_libc_version", version: "GLIBC_2.2.5" } }
}
linux_x86_64 machine locate_native() -> &VersionByte satisfies Version::locate via binding();
NativeVersion satisfies Version {
 machine locate() -> &VersionByte { locate_native() }
}
data VersionView { version: &VersionByte; }
machine main() reaches Version crashes Trap {
 let view: VersionView = VersionView { version: Version::locate() };
 transition view.version.value != 0 { true -> done() false -> bad() }
 state done() {} state bad() { crash Trap; }
