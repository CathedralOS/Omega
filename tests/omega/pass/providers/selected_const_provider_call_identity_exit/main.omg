// Named and token calls retain their authored requirement while executing the
// Build-selected body, including through a helper and a const-generic use.
// The competing provider and builtin remainder both produce smaller arrays.
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Math {}
boundary machine % Math::remainder(left: u64, right: u64) -> u64;

data DefaultProvider {}
machine DefaultProvider::remainder(left: u64, right: u64) -> u64
satisfies Math::remainder
{
    transition { _ -> (left | right) }
}

data SelectedProvider {}
machine SelectedProvider::remainder(left: u64, right: u64) -> u64
satisfies Math::remainder
{
    transition { _ -> (9) }
}

machine named_limit() -> u64 {
    transition { _ -> (Math::remainder(7, 2)) }
}

machine token_limit() -> u64 {
    let left: u64 = 7;
    let right: u64 = 2;
    transition { _ -> (left % right) }
}

machine helper_limit() -> u64 {
    transition { _ -> (named_limit()) }
}

data Buffer<const N: u64> { values: [u8; N]; }

data Main {
    named: [u8; named_limit()];
    token: [u8; token_limit()];
    nested: Buffer<helper_limit()>;
}

machine Main::main(main: &mut Main) reaches ProcessExit {
    main.named[8] = 70;
    main.token[8] = 70;
    main.nested.values[8] = 70;
    ProcessExit::exit_process(70);
}
