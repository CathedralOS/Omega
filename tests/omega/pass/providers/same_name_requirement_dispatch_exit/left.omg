module left;
use omega_language_std::console;
use omega::language::core::binding;

pub boundary trait Sink { machine emit() -> i32; }
pub data Provider {}
machine Provider::emit() -> i32 satisfies Sink::emit { 11 }

pub data Runner { sink: Binding<Sink>; console: Binding<Console>; }
pub machine Runner::run(context: &mut Runner) reaches Sink, Console
invokes Sink;
invokes Console;
{
    _ = context.sink.emit();
    let observed: i32 = context.sink.emit();
    transition observed == 11 { true -> again(context) _ -> bad(context) }
    state again(context: &mut Runner) {
        _ = context.sink.emit();
        let observed: i32 = context.sink.emit();
        transition observed == 11 { true -> good(context) _ -> bad(context) }
    }
    state good(context: &mut Runner) { context.console.exit_process(70); }
    state bad(context: &mut Runner) { context.console.exit_process(71); }
}
