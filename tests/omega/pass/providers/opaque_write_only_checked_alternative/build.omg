use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "non_owning_reference_erasure");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind<ErasedWrite::write>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "libomega_erasure.dylib", symbol: "_omega_non_observing_store"
        } });
    Build::bind<ErasedWrite::write>(builder, windows_x86_64,
        ForeignBinding::DllImport { import: DllImport::PeByName {
            library: "omega_erasure.dll", export: "omega_non_observing_store"
        } });
    Build::bind<ErasedWrite::write>(builder, linux_x86_64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libomega_erasure.so", symbol: "omega_non_observing_store", version: "OMEGA_1"
        } });
    Build::bind<ErasedWrite::write>(builder, linux_arm64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libomega_erasure.so", symbol: "omega_non_observing_store", version: "OMEGA_1"
        } });
}
