machine build(builder: &mut Build) {
    Build::application(builder, "linear_structural_provider_pure_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<Flow>(builder);
    Build::select_provider<Flow, Provider>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
}
