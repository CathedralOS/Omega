use omega::language::core::drop;
public data Token [linear] { value: i32; }
machine Token::drop(token: &mut Token) {}
public boundary trait Flow { machine forward(token: Token) -> Token reaches; }
data Provider {}
machine Provider::forward(token: Token) -> Token satisfies Flow::forward { token }
machine consume(token: Token) -> i32 { let value: i32 = token.value; drop(token); value }
data Main { }
machine Main::main(context: &mut Main) reaches Flow crashes Trap {
    let token: Token = Flow::forward(Token { value: 7 });
    let value: i32 = consume(token);
    transition value == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

ProviderFlowImplementation satisfies Flow {
    Flow::forward = Provider::forward;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Flow crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
