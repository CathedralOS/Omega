// A fixed-token use closes one exact type application, specializes its checked
// generic realization, and retains the resulting internal call beside an
// independent literal exit.
use omega_language_std::console;

data GenericMath {}

boundary machine % GenericMath::remainder<Element>(
    left: Element,
    right: Element
) -> Element;

data GenericProvider {}

machine GenericProvider::remainder<Value>(left: Value, right: Value) -> Value
satisfies GenericMath::remainder
{
    left
}

data Main { console: Console; }

machine Main::main(&mut self)
reaches Console
{
    let result: i32 = (70 as i32) % (1 as i32);
    self.console.exit_process(70);
}
