// Entry obligations and normal-return guarantees have different storage
// epochs. A foreign output write does not erase the independently returned
// status, but its input observations cannot become post-state equations.
// Whole-body return checking must start at the admitted entry state, including
// exact nominal memberships, rather than a prefix-free refutation context.
data Status [copy] { code: u64; }
data Table { read: addr; scalar: addr; }
data Record { value: u64; }
data Guid [copy] { value: u64; }
domain Guid::Selected requires self.value == 42;
domain<const Axis: u64> u64::Coordinate<Axis>;

boundary trait Reports {
    machine read(table: &Table, protocol: &Guid, output: &mut &Record) -> Status
    reaches
    requires protocol in Guid::Selected
    ensures result.code == 0;
    machine scalar(table: &Table, value: u64) -> Status
    reaches
    requires value == 42
    ensures result.code == 0;
    machine indexed(table: &Table, value: u64) -> Status
    reaches
    requires value in u64::Coordinate<7>
    ensures result.code == 0;
}


FirmwareReports satisfies Reports {
    machine indexed(table: &Table, value: u64) -> Status
    requires value in u64::Coordinate<7>
    ensures result.code == 0; {
        RawNativeReports::indexed(table, value)
    }
    machine read(table: &Table, protocol: &Guid, output: &mut &Record) -> Status
    requires protocol in Guid::Selected
    ensures result.code == 0; {
        RawNativeReports::read(table, protocol, output)
    }
    machine scalar(table: &Table, value: u64) -> Status
    requires value == 42
    ensures result.code == 0; {
        let saved: u64 = value;
        let status: Status = RawNativeReports::scalar(table, saved);
        status
    }
}

machine forward(table: &Table, protocol: &Guid, output: &mut &Record) -> Status
requires protocol in Guid::Selected
ensures result.code == 0; {
    let status: Status = RawNativeReports::read(table, protocol, output);
    status
}

machine scalar_forward(table: &Table, value: u64) -> Status
requires value == 42
ensures result.code == 0; {
    RawNativeReports::scalar(table, value)
}

machine reordered(value: u64, table: &Table) -> Status
requires value == 42
ensures result.code == 0; {
    RawNativeReports::scalar(table, value)
}

machine state_forward(table: &Table, protocol: &Guid, output: &mut &Record) -> Status
requires protocol in Guid::Selected
ensures result.code == 0; {
    transition { _ -> ready(protocol, output, table) }
    machine ready(selected: &Guid, destination: &mut &Record, firmware: &Table) -> Status
    requires selected in Guid::Selected
    {
        RawNativeReports::read(firmware, selected, destination)
    }
}

boundary trait RawNativeReports {
    machine read(table: &Table, protocol: &Guid, output: &mut &Record) -> Status
    reaches
    requires protocol in Guid::Selected
    ensures result.code == 0;
    machine scalar(table: &Table, value: u64) -> Status
    reaches
    requires value == 42
    ensures result.code == 0;
    machine indexed(table: &Table, value: u64) -> Status
    reaches
    requires value in u64::Coordinate<7>
    ensures result.code == 0;
}
