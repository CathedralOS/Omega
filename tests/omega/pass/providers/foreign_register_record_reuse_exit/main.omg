// glibc ldiv returns a 16-byte pair in SysV integer result registers.
use omega::language::core::external_binding;

public data DivisionResult { quotient: i64; remainder: i64; }
public data AllocationProbe {}
public boundary requirement AllocationProbe::statistics(numerator: i64, denominator: i64) -> DivisionResult;
public boundary requirement AllocationProbe::exit_with(code: i32);
data AllocationProvider {}
linux_x86_64 machine statistics_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "ldiv", version: "GLIBC_2.2.5",
        },
    }
}
linux_x86_64 machine exit_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "exit", version: "GLIBC_2.2.5",
        },
    }
}
linux_x86_64 machine AllocationProvider::statistics(numerator: i64, denominator: i64) -> DivisionResult
satisfies AllocationProbe::statistics via statistics_binding();
linux_x86_64 machine AllocationProvider::exit_with(code: i32)
satisfies AllocationProbe::exit_with via exit_binding();

machine relay(result: DivisionResult) -> DivisionResult { result }
machine collect(numerator: i64, denominator: i64) -> DivisionResult {
    let result: DivisionResult = AllocationProbe::statistics(numerator, denominator);
    relay(result)
}
machine observe(result: &DivisionResult) -> i64 { result.quotient }
data Main {}
machine Main::main(main: &mut Main) {
    let first: DivisionResult = collect(73, 10);
    let second: DivisionResult = collect(95, 7);
    let observed: i64 = observe(&first);
    transition observed == 7 && first.quotient == 7 && first.remainder == 3
        && second.quotient == 13 && second.remainder == 4 {
        true -> passed(main)
        _ -> failed(main)
    }
    state passed(main: &mut Main) { AllocationProbe::exit_with(70); }
    state failed(main: &mut Main) { AllocationProbe::exit_with(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
