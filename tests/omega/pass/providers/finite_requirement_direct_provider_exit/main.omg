// Direct machine satisfaction and named maps share executable family
// coordinates; neither may choose a sibling tuple because its ABI matches.
// Count=12 is supported but uncalled: selection must retain the whole roster.
public boundary trait Service {
    machine echo<const Count: u64>(value: i32) -> i32
    reaches
    where Count == 4 || Count == 8 || Count == 12;
}
data Provider {}
machine Provider::echo<const Count: u64>(value: i32) -> i32
satisfies Service::echo {
    transition Count == 4 { true -> (18 as i32) _ -> (27 as i32) }
}
data Providers {}
macos_arm64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, ProviderServiceImplementation>(defaults);
}

linux_x86_64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, ProviderServiceImplementation>(defaults);
}
data Main { }
macos_arm64 machine Main::main(main: &mut Main) reaches Service crashes Trap {
    let first: i32 = Service::echo<4>((17 as i32));
    let second: i32 = Service::echo<8>((25 as i32));
    transition first == 18 && second == 27 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

linux_x86_64 machine Main::main(main: &mut Main) reaches Service crashes Trap {
    let first: i32 = Service::echo<4>((17 as i32));
    let second: i32 = Service::echo<8>((25 as i32));
    transition first == 18 && second == 27 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

ProviderServiceImplementation satisfies Service {
    Service::echo = Provider::echo;
}

// The entry owns ordinary local state; selection supplies no context.
macos_arm64 machine entry_start() reaches Service crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}

linux_x86_64 machine entry_start() reaches Service crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
