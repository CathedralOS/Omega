// Requires locally supplied provider specialization to stay through provider
// selection: the call is only notated as a boundary operator while the
// generic adapter supplies a specialized concrete local provider for this
// exact application, then reaches the selected checked provider.
use omega_language_std::console;

data GenericMath {}

data GenericMathProvider {}

data Math {}

machine GenericMathProvider::identity<Value>(generic: GenericMath, value: Value) -> Value
satisfies Math::identity
{
    value
}

boundary machine + Math::identity<Value>(receiver: GenericMath, value: Value) -> Value;

data Main { }

machine Main::main(main: &mut Main)
reaches Console
{
    let generic: GenericMath = GenericMath {};
    let first: i32 = generic + (70 as i32);
    let other: GenericMath = GenericMath {};
    let second: u64 = other + (11 as u64);
    // One declaration serves two closed applications. Selection must not
    // confuse declaration eligibility with a single executable specialization.
    transition second == 11 {
        true -> success(first)
        _ -> failure()
    }
    machine success(value: i32) reaches Console { Console::exit_process(value); }
    machine failure() reaches Console { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
