// One closed type application specializes its checked generic realization and
// retains the resulting internal call beside an independent literal exit.
use omega_language_std::console;

data GenericMath {}

boundary operator GenericMath::identity<Element>(value: Element) -> Element;

data GenericProvider {}

machine GenericProvider::identity<Value>(value: Value) -> Value
satisfies GenericMath::identity
{
    value
}

data Main { console: Console; }

machine Main::main(&mut self) {
    let result: i32 = GenericMath::identity(70i32);
    self.console.exit_process(70);
}
