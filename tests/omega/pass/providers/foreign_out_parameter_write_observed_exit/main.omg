// A foreign leaf's `&mut` out-parameter write must be observed by the caller.
//
// Every TimeHost provider that reads a kernel clock through a pointer rests on
// this: Linux `clock_gettime` and Windows `QueryPerformanceCounter` both
// deliver their result by writing storage the caller lends them, so a
// compiler that folded the pre-call initializer would silently turn those
// providers into constants — and neither target can be executed from a macOS
// host to catch it. Darwin's `_clock_gettime` has the same signature shape, so
// this fixture falsifies that assumption on a host that CAN run it.
//
// The assertion is deliberately one a folded zero cannot pass: CLOCK_REALTIME
// seconds must be later than 2026-01-01 (1_767_225_600).
// Exits: 70 ok; 71 the call reported failure; 72 the lent storage still reads
// its pre-call initializer.
use omega::language::core::external_binding;
use omega_language_std::console;
use omega::language::core::binding;

pub data ForeignWrittenInstant { seconds: i64; nanoseconds: i64; }

pub boundary trait ForeignOutParameter {
    machine clock_gettime(clock_id: u32, instant: &mut ForeignWrittenInstant) -> i32;
}

macos_arm64 machine foreign_out_parameter_binding() -> ForeignBinding<26, 14, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_clock_gettime",
        },
    }
}

linux_x86_64 machine linux_x86_64_foreign_out_parameter_binding() -> ForeignBinding<9, 13, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "clock_gettime", version: "GLIBC_2.17",
        },
    }
}

macos_arm64 machine foreign_clock_gettime(clock_id: u32, instant: &mut ForeignWrittenInstant) -> i32
    satisfies ForeignOutParameter::clock_gettime
    via foreign_out_parameter_binding();

linux_x86_64 machine foreign_clock_gettime(clock_id: u32, instant: &mut ForeignWrittenInstant) -> i32
    satisfies ForeignOutParameter::clock_gettime
    via linux_x86_64_foreign_out_parameter_binding();

data Main { foreign_out_parameter: Binding<ForeignOutParameter>; console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches ForeignOutParameter + Console {
    let mut instant: ForeignWrittenInstant = ForeignWrittenInstant { seconds: 0, nanoseconds: 0 };
    let status: i32 = ForeignOutParameter::clock_gettime(&main.foreign_out_parameter, 0, &mut instant);
    transition status == 0 {
        true -> check_written(&main.console, instant.seconds)
        _ -> bad(&main.console, 71)
    }

    state check_written(console: &Binding<Console>, seconds: i64) {
        transition seconds > 1767225600 {
            true -> good(console)
            _ -> bad(console, 72)
        }
    }

    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
