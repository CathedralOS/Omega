// Expected exit: 0
// A table leaf reads its function address from the record its first
// parameter borrows. Neither leaf is qualified by a data declaration; the
// binding plan records the borrowed record as the dispatch table. A vtable
// field passes the table as the first argument (strlen reads the text at
// offset 0); a table function does not (abs receives -7, not the table).
use omega::language::core::external_binding;
boundary trait Symbols {
    machine lookup(handle: addr, name: &[u8; 7]) -> addr reaches;
}
data Measured { text: [u8; 8]; measure: addr; }
data Holder { canary: u64; absolute: addr; }
boundary trait Measure { machine length(table: &Measured) -> u64 reaches; }
boundary trait Absolute { machine value(table: &Holder, input: i32) -> i32 reaches; }
machine lookup_binding() -> ForeignBinding<9, 5, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "dlsym", version: "GLIBC_2.34"
    } }
}
linux_x86_64 machine native_lookup(handle: addr, name: &[u8; 7]) -> addr
satisfies Symbols::lookup via lookup_binding();
linux_x86_64 machine measured_length(table: &Measured) -> u64
satisfies Measure::length via ForeignBinding::VtableField(measure);
linux_x86_64 machine holder_absolute(table: &Holder, input: i32) -> i32
satisfies Absolute::value via ForeignBinding::TableFunction(absolute);
machine main() reaches Symbols + Measure + Absolute crashes Trap {
    let length_name: [u8; 7] = "strlen\0";
    let absolute_name: [u8; 7] = "abs\0\0\0\0";
    let length_function: addr = Symbols::lookup(0 as addr, &length_name);
    let absolute_function: addr = Symbols::lookup(0 as addr, &absolute_name);
    let measured: Measured = Measured { text: "hello\0\0\0", measure: length_function };
    let holder: Holder = Holder { canary: 77, absolute: absolute_function };
    let length: u64 = Measure::length(&measured);
    let absolute: i32 = Absolute::value(&holder, -7);
    transition length == 5 && absolute == 7 && holder.canary == 77 {
        true -> accepted()
        _ -> rejected()
    }
    machine accepted() {}
    machine rejected() { crash Trap; }
}
