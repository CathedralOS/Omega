machine build(builder: &mut Build) {
    Build::application(builder, "reference_dispatch_on_demand");
    Build::select_provider<Reading, Chosen>(builder, linux_arm64);
    Build::select_provider<Reading, Chosen>(builder, linux_x86_64);
    Build::select_provider<Reading, Chosen>(builder, macos_arm64);
    Build::select_provider<Reading, Chosen>(builder, macos_x86_64);
    Build::select_provider<Reading, Chosen>(builder, windows_x86_64);
    Build::select_provider<Reading, Chosen>(builder, uefi_x86_64);
    Build::select_provider<Reading, Chosen>(builder, cross_platform_cli);
    Build::select_provider<Reading, Chosen>(builder, local_unchecked);
    Build::select_provider<Reading, Chosen>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
