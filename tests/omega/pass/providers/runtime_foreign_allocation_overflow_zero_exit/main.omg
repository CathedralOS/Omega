// Expected exit: 0.
use omega::language::core::external_binding;
public boundary trait NativeBytes {
    machine allocate(count: u64, width: u64) -> addr reaches;
    machine release(pointer: addr) reaches;
}
public data LibSystemBytes {}


data Main {}
machine Main::main(context: &mut Main) reaches NativeBytes crashes Trap {
    let overflow: addr = NativeBytes::allocate(18446744073709551615u64, 2u64);
    transition overflow == 0 {
        true -> zero()
        _ -> failed()
    }
    machine zero() {
        let empty: addr = NativeBytes::allocate(0u64, 18446744073709551615u64);
        NativeBytes::release(empty);
        NativeBytes::release(0);
    }
    machine failed() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches NativeBytes crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
