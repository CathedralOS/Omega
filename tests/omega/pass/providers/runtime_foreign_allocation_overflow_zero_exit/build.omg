machine build(builder: &mut Build) {
    Build::application(builder, "allocation_adapter_control");
    Build::accept_boundary<NativeBytes>(builder);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, linux_arm64);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, linux_x86_64);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, macos_arm64);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, macos_x86_64);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, windows_x86_64);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, uefi_x86_64);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, cross_platform_cli);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, local_unchecked);
    Build::select_provider<NativeBytes, LibSystemBytes>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
