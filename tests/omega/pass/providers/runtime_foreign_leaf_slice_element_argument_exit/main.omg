// A selected provider lends one element of a borrowed byte slice,
// `&text[2]`, to a foreign leaf, libSystem's `_strlen`, which reads through
// the pointer word a `&u8` formal lowers to. The element's address is the
// slice's backing byte, not its descriptor: over "hello" the leaf measures 3
// from byte 2. The provider answers 70 only then; Main exits with the answer.
// Expected exit: 70.
use omega::language::core::binding;
use omega::language::core::external_binding;
use omega_language_std::console;

pub boundary trait CText {
    machine length(text: &u8) -> u64;
}

macos_arm64 machine c_strlen_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_strlen",
        },
    }
}

linux_x86_64 machine linux_x86_64_c_strlen_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "strlen", version: "GLIBC_2.2.5",
        },
    }
}

macos_arm64 machine c_strlen(text: &u8) -> u64
    satisfies CText::length via c_strlen_binding();

linux_x86_64 machine c_strlen(text: &u8) -> u64
    satisfies CText::length via linux_x86_64_c_strlen_binding();

pub data Words {
    bytes: [u8; 6];
}

pub boundary trait Measure {
    machine measure(text: &[u8]) -> i32 invokes CText;
}

data MeasureProvider {}

macos_arm64 machine MeasureProvider::provider_defaults(defaults: &mut MeasureProvider) {
    MeasureProvider::select_provider<Measure, MeasureProvider>(defaults);
}

linux_x86_64 machine MeasureProvider::provider_defaults(defaults: &mut MeasureProvider) {
    MeasureProvider::select_provider<Measure, MeasureProvider>(defaults);
}

macos_arm64 machine MeasureProvider::measure(text: &[u8]) -> i32 satisfies Measure::measure
{
    transition text.len > 2 {
        true -> lend(text)
        _ -> (72)
    }
    state lend(text: &[u8]) -> i32
    requires text.len > 2
    {
        let element: u64 = c_strlen(&text[2]);
        transition element == 3 {
            true -> (70)
            _ -> (71)
        }
    }
}

linux_x86_64 machine MeasureProvider::measure(text: &[u8]) -> i32 satisfies Measure::measure
{
    transition text.len > 2 {
        true -> lend(text)
        _ -> (72)
    }
    state lend(text: &[u8]) -> i32
    requires text.len > 2
    {
        let element: u64 = c_strlen(&text[2]);
        transition element == 3 {
            true -> (70)
            _ -> (71)
        }
    }
}

data Main {
    console: Binding<Console>;
    measure: Binding<Measure>;
    words: Words;
    result: i32;
}

machine Main::main(main: &mut Main) reaches Console + CText + Measure {
    main.words.bytes[0] = 104;
    main.words.bytes[1] = 101;
    main.words.bytes[2] = 108;
    main.words.bytes[3] = 108;
    main.words.bytes[4] = 111;
    main.words.bytes[5] = 0;
    let view: &[u8] = &main.words.bytes[..];
    main.result = main.measure.measure(view);
    transition main.result == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
