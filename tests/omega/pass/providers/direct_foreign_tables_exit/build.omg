use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "direct_foreign_tables_exit");
    Build::select_provider<Counter, CounterProvider>(builder, linux_arm64);
    Build::select_provider<Counter, CounterProvider>(builder, linux_x86_64);
    Build::select_provider<Counter, CounterProvider>(builder, macos_arm64);
    Build::select_provider<Counter, CounterProvider>(builder, macos_x86_64);
    Build::select_provider<Counter, CounterProvider>(builder, windows_x86_64);
    Build::select_provider<Counter, CounterProvider>(builder, uefi_x86_64);
    Build::select_provider<Counter, CounterProvider>(builder, cross_platform_cli);
    Build::select_provider<Counter, CounterProvider>(builder, local_unchecked);
    Build::select_provider<Counter, CounterProvider>(builder, alpha_bootstrap);
    Build::select_provider<Process, ProcessProvider>(builder, linux_arm64);
    Build::select_provider<Process, ProcessProvider>(builder, linux_x86_64);
    Build::select_provider<Process, ProcessProvider>(builder, macos_arm64);
    Build::select_provider<Process, ProcessProvider>(builder, macos_x86_64);
    Build::select_provider<Process, ProcessProvider>(builder, windows_x86_64);
    Build::select_provider<Process, ProcessProvider>(builder, uefi_x86_64);
    Build::select_provider<Process, ProcessProvider>(builder, cross_platform_cli);
    Build::select_provider<Process, ProcessProvider>(builder, local_unchecked);
    Build::select_provider<Process, ProcessProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);

 Build::bind<ModuleSymbols::module>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "GetModuleHandleA"
    } });
 Build::bind<ModuleSymbols::symbol>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "kernel32.dll", export: "GetProcAddress"
    } });

 Build::bind_vtable_field<RawNativeCounter::query, CounterTable::query>(builder, windows_x86_64);
 Build::bind_table_function<RawNativeProcess::current, ProcessTable::current>(builder, windows_x86_64);
}
