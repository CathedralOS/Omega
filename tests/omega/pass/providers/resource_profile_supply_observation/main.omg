// Expected exit: 0. A selected profile describes its borrowed grant without
// consuming it. This fixture observes data only: its synthetic grant is never
// dereferenced and supplies no evidence of physical initialization.
use omega::language::core::extent;
use omega::language::core::layout;
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data TestMemory {}

SyntheticRoot satisfies ExtentRootProvider {
    machine grant(storage: Extent) -> Extent { storage }
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

data Owner { storage: Extent in Granted; }

machine observe(storage: &Extent in Granted) -> ResourceProfile
reaches ResourceProfileSupply
{
    ResourceProfileSupply<TestMemory>::profile(storage)
}

machine observe_qualified(storage: &Extent in Granted) -> ResourceProfile
reaches ResourceProfileSupply
{
    ResourceProfileSupply<TestMemory>::profile(storage as &Extent in Granted)
}

machine main()
reaches ExtentRootProvider + ResourceProfileSupply + ProcessExit
{
    let storage: Extent in Granted = ExtentRootProvider::grant(
        Extent { base: 4096, length: 16 }
    );
    let owner: Owner = Owner { storage: storage };
    let first: ResourceProfile = ResourceProfileSupply<TestMemory>::profile(&owner.storage);
    let second: ResourceProfile = observe(&owner.storage);
    let third: ResourceProfile =
        ResourceProfileSupply<TestMemory>::profile(&owner.storage as &Extent in Granted);
    let fourth: ResourceProfile = observe_qualified(&owner.storage);
    transition first.region_count == 1 && second.region_count == 1 &&
               third.region_count == 1 && fourth.region_count == 1 &&
               first.regions[0].range.length == 16 &&
               second.regions[0].range.length == 16 &&
               third.regions[0].range.length == 16 &&
               fourth.regions[0].range.length == 16 && owner.storage.length == 16 {
        true -> finish(owner, 0)
        _ -> finish(owner, 1)
    }
    // Ending the process retains the grant; no invented drop discharges it.
    machine finish(owner: Owner, status: i32) {
        ProcessExit::exit_process(status);
    }
}
