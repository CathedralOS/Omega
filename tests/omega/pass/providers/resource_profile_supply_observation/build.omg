machine build(builder: &mut Build) {
    Build::application(builder, "resource_profile_supply_observation");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, linux_arm64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, linux_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, macos_arm64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, macos_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, windows_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, uefi_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, cross_platform_cli);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, local_unchecked);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, alpha_bootstrap);
    Build::accept_boundary<ResourceProfileSupply>(builder);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, linux_arm64);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, linux_x86_64);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, macos_arm64);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, macos_x86_64);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, windows_x86_64);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, uefi_x86_64);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, cross_platform_cli);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, local_unchecked);
    Build::select_provider<ResourceProfileSupply, MemorySupply>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
