// Boundary scalar call result stored directly into a structural field inside a
// composed-control state: `main.stored = Echo::echo(41)` plans a
// BoundaryScalarCall whose ScalarResult feeds a StructuralScalarFieldStore at
// the same authored statement. The authored-statement walk must see the call
// as the statement's producer so the store continuation pairs (regression:
// "Unit graph continuation lost its producing statement" from the Squalr
// native probe, machine probe_control).
// Record results use that same authored assignment, with a move/store/cleanup
// window. Replace a record twice and observe its fields to check both forms.

use omega_language_std::console;

pub boundary trait Echo {
    machine echo(value: i32) -> i32;
}

data EchoProvider {}

machine EchoProvider::echo(value: i32) -> i32 satisfies Echo::echo {
    transition { _ -> (41) }
}

pub data Triple { first: u64; second: u64; third: u64; }
pub boundary trait RecordSource {
    machine receive(seed: u64) -> Triple;
}
data RecordProvider {}
machine RecordProvider::receive(seed: u64) -> Triple satisfies RecordSource::receive {
    Triple { first: seed, second: 23, third: 27 }
}

data Main {
    stored: i32;
    seed: u64;
    earlier: u64;
    result: Triple;
}

machine Main::main(main: &mut Main) reaches Echo, Console, RecordSource {
    transition { _ -> store(main) }
    state store(main: &mut Main) {
        main.stored = Echo::echo(41);
        main.seed = 19;
        main.result = RecordSource::receive(main.seed);
        main.earlier = main.result.first;
        main.seed = 20;
        main.result = RecordSource::receive(main.seed);
        transition main.stored == 41 && main.earlier == 19 && main.result.first == 20 && main.result.second == 23 && main.result.third == 27 {
            true -> done(main)
            _ -> fail(main)
        }
    }
    state done(main: &mut Main) {
        Console::exit_process(70);
    }
    state fail(main: &mut Main) {
        Console::exit_process(71);
    }
}

EchoProviderEchoImplementation satisfies Echo {
    Echo::echo = EchoProvider::echo;
}

RecordProviderRecordSourceImplementation satisfies RecordSource { RecordSource::receive = RecordProvider::receive; }
