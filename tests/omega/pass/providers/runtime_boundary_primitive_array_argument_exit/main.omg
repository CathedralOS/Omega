use omega_language_std::console;

pub boundary trait ArrayReader {
    machine inspect(prefix: i32, values: [u8; 4], suffix: i32) -> i32;
}

data ArrayReaderProvider {}

machine ArrayReaderProvider::inspect(prefix: i32, values: [u8; 4], suffix: i32) -> i32
satisfies ArrayReader::inspect
{
    transition prefix == 30 && suffix == 40 && values[0] == 11 && values[1] == 22 && values[2] == 33 && values[3] == 44 {
        true -> (70)
        _ -> (71)
    }
}

data Main {
    values: [u8; 4];
    result: i32;
}

machine Main::main(main: &mut Main) reaches Console + ArrayReader {
    main.values[0] = 11;
    main.values[1] = 22;
    main.values[2] = 33;
    main.values[3] = 44;
    main.result = ArrayReader::inspect(30, main.values, 40);
    transition main.result == 70 && main.values[0] == 11 && main.values[3] == 44 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}
