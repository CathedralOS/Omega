use omega::language::core::binding;
pub boundary trait Parent<Value> { machine echo(value: Value) -> Value; }
pub boundary trait Child: Parent<i32> { machine choose() -> i32; }
ChildMap satisfies Child {
    Parent::echo = echo;
    Child::choose = choose;
}
machine echo(value: i32) -> i32 { value }
machine choose() -> i32 { 19 }
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}
machine observed(parent: &Binding<Parent<i32>>, value: i32) -> i32 reaches Parent {
    parent.echo(value)
}
data Main { parent: Binding<Parent<i32>>; child: Binding<Child>; }
machine Main::main(main: &mut Main) reaches Child + Parent crashes Trap {
    let chosen: i32 = Child::choose(&main.child);
    let observed: i32 = observed(&main.parent, 37);
    transition chosen == 19 && observed == 37 {
        true -> done() _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
