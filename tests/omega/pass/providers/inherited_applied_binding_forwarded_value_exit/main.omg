public boundary trait Parent<Value> { machine echo(value: Value) -> Value reaches; }
public boundary trait Child: Parent<i32> { machine choose() -> i32 reaches; }
ChildMap satisfies Child {
    Parent::echo = echo;
    Child::choose = choose;
}
machine echo(value: i32) -> i32 { value }
machine choose() -> i32 { 19 }
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}
machine observed(value: i32) -> i32 reaches Parent {
    Parent<i32>::echo(value)
}
data Main { }
machine Main::main(main: &mut Main) reaches Child + Parent crashes Trap {
    let chosen: i32 = Child::choose();
    let observed: i32 = observed(37);
    transition chosen == 19 && observed == 37 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Child + Parent crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
