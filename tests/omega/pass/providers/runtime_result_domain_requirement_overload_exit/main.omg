// Same-name boundary requirements differ only by their normalized result
// dispatch set. Destination context selects the requirement, and provider
// planning must preserve that exact identity through adapter dispatch.
use omega_language_std::console;
use omega::language::core::binding;

pub boundary trait Convert {
    machine convert(value: i32) -> i32;
    machine convert(value: i32) -> i32 in Saturating;
}

data ConvertProvider {}

machine ConvertProvider::ordinary(value: i32) -> i32 satisfies Convert::convert {
    transition { _ -> (69) }
}

machine ConvertProvider::saturating(value: i32) -> i32 in Saturating satisfies Convert::convert {
    transition { _ -> (70 as i32 in Saturating) }
}

data Main {
    console: Binding<Console>;
    converter: Binding<Convert>;
}

machine Main::main(main: &mut Main)
reaches Console, Convert
{
    let ordinary: i32 = main.converter.convert(0);
    let saturated: i32 in Saturating = main.converter.convert(0);
    transition {
        ordinary == 69 && saturated == (70 as i32 in Saturating) -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(77); }
}
