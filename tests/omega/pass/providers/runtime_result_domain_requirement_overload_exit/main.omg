// Same-name boundary requirements differ only by their normalized result
// dispatch set. Destination context selects the requirement, and provider
// planning must preserve that exact identity through adapter dispatch.
use omega_language_std::console;

public boundary trait Convert {
    machine convert(value: i32) -> i32 reaches;
    machine convert(value: i32) -> i32 in Saturating reaches;
}

data ConvertProvider {}

machine ConvertProvider::ordinary(value: i32) -> i32 satisfies Convert::convert {
    transition { _ -> (69) }
}

machine ConvertProvider::saturating(value: i32) -> i32 in Saturating satisfies Convert::convert {
    transition { _ -> (70 as i32 in Saturating) }
}

data Main {
}

machine Main::main(main: &mut Main)
reaches Console, Convert
{
    let ordinary: i32 = Convert::convert(0);
    let saturated: i32 in Saturating = Convert::convert(0);
    transition {
        ordinary == 69 && saturated == (70 as i32 in Saturating) -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(77); }
}

ConvertProviderConvertImplementation satisfies Convert {
    Convert::convert = ConvertProvider::ordinary;
    Convert::convert = ConvertProvider::saturating;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console, Convert
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
