// Deployable native canary: every hosted target selects its exact entry.

machine build(builder: &mut Build) {
    Build::application(builder, "runtime_result_domain_requirement_overload_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, linux_arm64);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, linux_x86_64);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, macos_arm64);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, macos_x86_64);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, windows_x86_64);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, uefi_x86_64);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, cross_platform_cli);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, local_unchecked);
    Build::select_provider<Convert, ConvertProviderConvertImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
