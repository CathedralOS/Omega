// A requires-guarded call, an ensures clause, and an exact subtraction
// the requires fact discharges — the consumer's verifier must
// reconstruct every obligation after the checked-tree state is
// discarded.
machine observed(low: u32, high: u32) -> u32
requires low <= high;
ensures true == true;
terminates;
{
    high - low
}

data Main {}

machine Main::main(main: &mut Main)
terminates;
{
    let diff: u32 = observed(3u32, 9u32);
    transition diff == 6u32 { true -> ok() _ -> wrong() }
    machine ok() {}
    machine wrong() {}
}
