// One selected attached application root receives exact Fused Service
// establishment from its generated entry bridge. A same-shaped non-root owner
// receives no such authority merely because the provider is selected.

public boundary trait Ping {
    machine ping() reaches;
}

data PingProvider { }
machine PingProvider::ping() satisfies Ping::ping { }

data Main {
}

machine Main::main(main: &mut Main)
reaches Ping
{
    Ping::ping();
}

data NonRoot {
}

machine NonRoot::run(non_root: &mut NonRoot)
reaches Ping
{
    Ping::ping();
}

PingProviderPingImplementation satisfies Ping {
    Ping::ping = PingProvider::ping;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Ping
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
