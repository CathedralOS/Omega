
machine build(builder: &mut Build) {
    Build::application(builder, "service_fused_root_establishment");
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, linux_arm64);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, linux_x86_64);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, macos_arm64);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, macos_x86_64);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, windows_x86_64);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, uefi_x86_64);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, cross_platform_cli);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, local_unchecked);
    Build::select_provider<Ping, PingProviderPingImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
