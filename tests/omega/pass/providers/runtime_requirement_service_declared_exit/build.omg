machine build(builder: &mut Build) {
    Build::application(builder, "runtime_requirement_service_declared_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<FilesystemHost, ExplicitClose>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<FilesystemHost, ExplicitClose>(builder, linux_x86_64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<FilesystemHost, ExplicitClose>(builder, linux_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<FilesystemHost, ExplicitClose>(builder, macos_arm64);
}
