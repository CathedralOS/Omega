public boundary trait Console {
    machine exit_process(return_code: i32) reaches Console;
}
public data ConsoleNativeProvider { }
macos_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;
public NativeConsole satisfies Console {
    machine exit_process(return_code: i32) reaches Console { first(return_code); }
}
machine first(return_code: i32) reaches Console {
    let forwarded: i32 = return_code;
    second(identity(forwarded));
}
machine identity(return_code: i32) -> i32 { return_code }
machine second(return_code: i32) reaches Console {
    transition return_code == 70 {
        true -> matching(return_code)
        false -> other(return_code)
    }
    machine matching(return_code: i32) { ConsoleNativeProvider::exit_process(return_code); }
    machine other(return_code: i32) { ConsoleNativeProvider::exit_process(return_code); }
}
macos_arm64 machine ConsoleNativeProvider::provider_defaults(defaults: &mut ConsoleNativeProvider) {
    ConsoleNativeProvider::select_provider<Console, NativeConsole>(defaults);
}
