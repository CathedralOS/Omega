// Expected exit: 0. Structural arguments do not consume scalar positions.
public domain u32::Flags(value) requires (value & 2) == 0;
public data Prefix { marker: u32; }
public boundary trait Gate {
    machine accept(prefix: &Prefix, value: u32 in Flags) -> u32 reaches;
}
data Provider {}
machine Provider::accepted(prefix: &Prefix, value: u32 in Flags) -> u32
    satisfies Gate::accept { value as u32 }
data Main { prefix: Prefix; value: u32; }
machine Main::main(main: &mut Main) reaches Gate crashes Trap {
    main.value = 128;
    let direct: u32 = Gate::accept(&main.prefix, 128);
    let field: u32 = Gate::accept(&main.prefix, main.value);
    transition direct == 128 && field == 128 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}

ProviderGateImplementation satisfies Gate {
    Gate::accept = Provider::accepted;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Gate crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
