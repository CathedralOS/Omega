// Whole and projected loans share established local backing. A scalar call
// precedes construction; two foreign calls read it without consuming it, and
// ordinary reads after those calls must still observe the authored values.
use omega::language::core::external_binding;
use omega_language_std::console;

pub data Pair { first: i64; second: i64; }
pub domain Pair::Ordered(value) requires value.first < value.second;
data Holder { prefix: i64; payload: Pair; }
pub boundary trait Compare {
    // Raw memcmp leaf: both calls below supply the record's exact 16 bytes.
    machine bytes(left: &Pair in Ordered, right: &Pair in Ordered, count: u64) -> i32;
}

macos_arm64 machine compare_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp",
        },
    }
}

linux_x86_64 machine linux_x86_64_compare_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5",
        },
    }
}
macos_arm64 machine compare_bytes(left: &Pair in Ordered, right: &Pair in Ordered, count: u64) -> i32
    satisfies Compare::bytes via compare_binding();

linux_x86_64 machine compare_bytes(left: &Pair in Ordered, right: &Pair in Ordered, count: u64) -> i32
    satisfies Compare::bytes via linux_x86_64_compare_binding();

machine second_value(first: i64) -> i64 requires first >= 0 && first <= 69 ensures result >= 1 && result <= 70 { first + 1 }

data Main { }
machine Main::main(main: &mut Main) reaches Compare + Console {
    let second: i64 = second_value(69);
    let expected: Pair = Pair { first: 69, second: second };
    let actual: Pair = Pair { first: 69, second: 70 };
    let holder: Holder = Holder { prefix: 999, payload: Pair { first: 69, second: 70 } };
    let whole: i32 = Compare::bytes(&actual, &expected, 16);
    let projected: i32 = Compare::bytes(&holder.payload, &expected, 16);
    transition whole == 0 && projected == 0 && actual.second == 70 && holder.prefix == 999 {
        true -> good()
        _ -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}
