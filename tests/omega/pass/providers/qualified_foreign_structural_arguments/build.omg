use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "qualified_foreign_structural_arguments");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind<Compare::bytes>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp",
        },
    });
 Build::bind<Compare::bytes>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5",
        },
    });
}
