use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::application(builder, "runtime_provider_reference_allocation_exit");
 Build::bind(builder, linux_x86_64::ProgramEntry, main);

 Build::bind<Heap::allocate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5" } });
 Build::bind<Heap::initialize>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "memset", version: "GLIBC_2.2.5" } });
}
