machine build(builder: &mut Build) {
    Build::application(builder, "structural_result_field_guarantee_exit");
    Build::select_provider<Factory, RealFactory>(builder, linux_arm64);
    Build::select_provider<Factory, RealFactory>(builder, linux_x86_64);
    Build::select_provider<Factory, RealFactory>(builder, macos_arm64);
    Build::select_provider<Factory, RealFactory>(builder, macos_x86_64);
    Build::select_provider<Factory, RealFactory>(builder, windows_x86_64);
    Build::select_provider<Factory, RealFactory>(builder, uefi_x86_64);
    Build::select_provider<Factory, RealFactory>(builder, cross_platform_cli);
    Build::select_provider<Factory, RealFactory>(builder, local_unchecked);
    Build::select_provider<Factory, RealFactory>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
