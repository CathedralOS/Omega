machine build(builder: &mut Build) {
    Build::application(builder, "runtime_boundary_array_forwarding_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, linux_arm64);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, linux_x86_64);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, macos_arm64);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, macos_x86_64);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, windows_x86_64);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, uefi_x86_64);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, cross_platform_cli);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, local_unchecked);
    Build::select_provider<ArrayReader, ArrayReaderProviderArrayReaderImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
