use omega::language::core::binding;
use omega_language_std::console;

pub boundary trait ArrayReader {
    machine inspect(&mut self, prefix: i32, values: [u8; 4], suffix: i32) -> i32;
}

data ArrayReaderProvider {}

machine ArrayReaderProvider::inspect(array_reader_provider: &mut ArrayReaderProvider, prefix: i32, values: [u8; 4], suffix: i32) -> i32
satisfies ArrayReader::inspect {
    transition prefix == 30 && suffix == 40 && values[0] == 11 && values[1] == 22 && values[2] == 33 && values[3] == 44 {
        true -> (70)
        _ -> (71)
    }
}

data Main {
    console: Binding<Console>;
    reader: Binding<ArrayReader>;
    values: [u8; 4];
    result: i32;
}

machine Main::forward(main: &mut Main, values: [u8; 4]) reaches ArrayReader {
    main.result = main.reader.inspect(30, values, 40);
}

machine Main::main(main: &mut Main) reaches Console + ArrayReader {
    main.values[0] = 11;
    main.values[1] = 22;
    main.values[2] = 33;
    main.values[3] = 44;
    Main::forward(main, main.values);
    transition main.result == 70 && main.values[0] == 11 && main.values[3] == 44 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(72); }
}
