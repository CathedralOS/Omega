// Expected exit: 0. Applied calls preserve an issued qualification, not new authority.
data Token { value: u64; }
data Word {}
data Other {}
domain<Value, Element> Token::Issued<Value, Element> established by Supply::issue;
boundary trait Supply<Value> {
    machine issue<Element>(value: u64) -> Token reaches ensures result in Issued<Value, Element>;
    machine forward<Element>(value: Token in Issued<Value, Element>) -> Token in Issued<Value, Element> reaches;
}
Provider satisfies Supply<Word> {
    machine issue<Element>(value: u64) -> Token { Token { value: value } }
    machine forward<Element>(value: Token in Issued<Word, Element>) -> Token in Issued<Word, Element> { value }
}
machine relay<Value, Element>(value: Token in Issued<Value, Element>) -> Token in Issued<Value, Element>
reaches Supply
{
    let result: Token in Issued<Value, Element> = Supply<Value>::forward<Element>(value);
    Supply<Value>::forward<Element>(result)
}
machine main() reaches Supply crashes Trap {
    let issued: Token in Issued<Word, Other> = Supply<Word>::issue<Other>(29);
    let result: Token in Issued<Word, Other> = relay<Word, Other>(issued);
    let second: Token in Issued<Word, Word> = Supply<Word>::issue<Word>(37);
    let forwarded: Token in Issued<Word, Word> = relay<Word, Word>(second);
    transition result.value == 29 && forwarded.value == 37 { true -> {} false -> bad() }
    state bad() { crash Trap; }
}
