
// Machines can be attached to an opaque boundary type: the type carries no
// fields yet hosts the crossing's contract surface.
pub boundary data WaitSubstrate;

boundary machine WaitSubstrate::park(word: u64) suspends; blocks;
boundary machine WaitSubstrate::wake_one(word: u64);
boundary machine WaitSubstrate::wake_all(word: u64);

data Main {
    substrate: WaitSubstrate;
    word: u64;
}

machine Main::main(main: &mut Main) -> u64 {
    WaitSubstrate::wake_one(main.word);
    transition { _ -> main.word }
}
