machine build(builder: &mut Build) {
    Build::select_provider<SelectedTargetProvidersProviderDefaults, CheckedTargetProvidersProviderDefaults>(builder, macos_arm64);
    Build::select_provider<SelectedTargetProvidersProviderDefaults, CheckedTargetProvidersProviderDefaults>(builder, linux_x86_64);

    Build::application(builder, "inherited_provider_borrowed_result_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
