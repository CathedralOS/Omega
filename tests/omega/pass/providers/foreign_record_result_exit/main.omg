// libc div returns two signed int fields in one public C record.
use omega::language::core::external_binding;
use omega_language_std::console;

public data Division {
    quotient: i32;
    remainder: i32;
}

public boundary trait IntegerDivision {
    machine divide(numerator: i32, denominator: i32) -> Division reaches;
}


data Main {
    negative: Division;
    positive: Division;
}

machine Main::main(main: &mut Main) reaches IntegerDivision + Console {
    main.negative = IntegerDivision::divide(-70, 3);
    main.positive = IntegerDivision::divide(70, 9);
    transition main.negative.quotient == -23 && main.negative.remainder == -1
        && main.positive.quotient == 7 && main.positive.remainder == 7 {
        true -> passed(main)
        _ -> failed(main)
    }
    machine passed(main: &mut Main) { Console::exit_process(70); }
    machine failed(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches IntegerDivision + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
