// libc div returns two signed int fields in one public C record.
use omega::language::core::external_binding;
use omega_language_std::console;

pub data Division {
    quotient: i32;
    remainder: i32;
}

pub boundary trait IntegerDivision {
    machine divide(numerator: i32, denominator: i32) -> Division;
}

macos_arm64 machine division_binding() -> ForeignBinding<26, 4, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_div",
        },
    }
}

linux_x86_64 machine linux_x86_64_division_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "div", version: "GLIBC_2.2.5",
        },
    }
}

macos_arm64 machine divide(numerator: i32, denominator: i32) -> Division
    satisfies IntegerDivision::divide via division_binding();

linux_x86_64 machine divide(numerator: i32, denominator: i32) -> Division
    satisfies IntegerDivision::divide via linux_x86_64_division_binding();

data Main {
    negative: Division;
    positive: Division;
}

machine Main::main(main: &mut Main) reaches IntegerDivision + Console {
    main.negative = IntegerDivision::divide(-70, 3);
    main.positive = IntegerDivision::divide(70, 9);
    transition main.negative.quotient == -23 && main.negative.remainder == -1
        && main.positive.quotient == 7 && main.positive.remainder == 7 {
        true -> passed(main)
        _ -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
