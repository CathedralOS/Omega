machine build(builder: &mut Build) {
    Build::application(builder, "qualified_result_state");
    Build::accept_boundary<Grant>(builder);
    Build::select_provider<Grant, Provider>(builder, linux_arm64);
    Build::select_provider<Grant, Provider>(builder, linux_x86_64);
    Build::select_provider<Grant, Provider>(builder, macos_arm64);
    Build::select_provider<Grant, Provider>(builder, macos_x86_64);
    Build::select_provider<Grant, Provider>(builder, windows_x86_64);
    Build::select_provider<Grant, Provider>(builder, uefi_x86_64);
    Build::select_provider<Grant, Provider>(builder, cross_platform_cli);
    Build::select_provider<Grant, Provider>(builder, local_unchecked);
    Build::select_provider<Grant, Provider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
