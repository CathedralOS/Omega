// PRV4c: the canonical free build root may select one complete test provider
// type without reconstructing individual rows.
boundary trait Pick {
    machine choose() -> i32;
}

data ProductionProvider { }
machine ProductionProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (1) }
}

data TestProvider { }
machine TestProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (2) }
}

data Main { }
machine Main::main(&mut self) { }
