machine build(builder: &mut Build) {
    Build::application(builder, "named_foreign_record_result_contract");
    Build::depend_as(builder, "std", Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder);
    Build::select_representation<std::EfiSystemTable, SystemTableRepresentation>(builder);
    Build::select_provider<ForeignReports, FirmwareReports>(builder);
    Build::bind(builder, uefi_x86_64::ProgramEntry, reports_entry);
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}