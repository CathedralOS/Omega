// A selected foreign leaf's normal return guarantees its status independently
// of the mutable output slot. The portable wrapper must not replay that output.
public data Status [copy] { code: u64; }
public data Table { read: addr; }
public data Record { value: u64; }
public data Output<'scope> { value: &'scope Record; }
public boundary trait ForeignReports {
    machine read<'scope>(table: &'scope Table, output: &mut Output<'scope>) -> Status
    reaches
    ensures result.code == 0;
}
public FirmwareReports satisfies ForeignReports {
    machine read<'scope>(table: &'scope Table, output: &mut Output<'scope>) -> Status
    ensures result.code == 0; {
        Table::read(table, output)
    }
}
uefi_x86_64 machine Table::read<'scope>(
    table: &'scope Table, output: &mut Output<'scope>
) -> Status
satisfies ForeignReports::read via ForeignBinding::TableFunction(read)
ensures result.code == 0;

// The demand. The selection above named a slot nothing required, so the build
// refused it as unknown; a bound target entry whose reach row requires
// `ForeignReports` gives the wrapper a subject again. The entry is the target's
// physical continuation, and the two selections under it are the minimum the
// uefi entry schema asks for (provider_selection.md:3, entry_roots.md:26).
use omega::language::core::extent;
use omega::language::core::representation;
use std::targets::uefi_x86_64::entry;

data SystemTableHeader {
    signature: u64;
    revision: u32;
    header_size: u32;
    crc: u32;
    reserved: u32;
}
SystemTableRepresentation satisfies OpaqueRepresentation<EfiSystemTable, SystemTableHeader> { }

FirmwareBootstrap satisfies UefiPhysicalEntry {
    UefiPhysicalEntry::enter = firmware_entry;
}

machine firmware_entry(image_handle: EfiImageHandle, system_table: &EfiSystemTable) -> EfiStatus
satisfies UefiPhysicalEntry::enter {
    EfiStatus { code: 0x8000000000000002 }
}

machine reports_entry(image: Extent in Granted, storage: Extent in Granted)
reaches ForeignReports {
    let table: Table = Table { read: 4096 };
    let record: Record = Record { value: 0 };
    let mut output: Output = Output { value: &record };
    let status: Status = ForeignReports::read(&table, &mut output);
    transition { _ -> retain(image as Extent, storage as Extent, status) }
    machine retain(image: Extent, storage: Extent, status: Status) {
        transition { _ -> retain(image, storage, status) }
    }
}
