use omega::language::core::binding;
// PRV4d: a target-scoped external leaf using ForeignBinding::Syscall reaches the
// selected target syscall mechanism. The x86 structural test pins the final
// number and instruction; this source also joins the general pass corpus.
pub boundary trait RawProcess {
    machine process_id() -> i64;
    machine process_group(id: i64) -> i64;
    machine exit(code: i32);
}

linux_x86_64 machine process_id_leaf() -> i64
    satisfies RawProcess::process_id
    via ForeignBinding::Syscall(39);

linux_x86_64 machine process_group_leaf(id: i64) -> i64
    satisfies RawProcess::process_group
    via ForeignBinding::Syscall(121);

linux_x86_64 machine exit_leaf(code: i32)
    satisfies RawProcess::exit
    via ForeignBinding::Syscall(60);

linux_arm64 machine process_id_leaf() -> i64
    satisfies RawProcess::process_id
    via ForeignBinding::Syscall(172);

linux_arm64 machine process_group_leaf(id: i64) -> i64
    satisfies RawProcess::process_group
    via ForeignBinding::Syscall(155);

linux_arm64 machine exit_leaf(code: i32)
    satisfies RawProcess::exit
    via ForeignBinding::Syscall(93);

data Main { process: Binding<RawProcess>; pid: i64; pgid_zero: i64; pgid: i64; exit_code: i32; }
machine Main::main(&mut self)
reaches RawProcess
{
    self.exit_code = 70;
    self.pid = self.process.process_id();
    self.pgid_zero = self.process.process_group(0);
    self.pgid = self.process.process_group(self.pid);
    transition self.pid > 0 && self.pgid_zero >= 0 && self.pgid >= 0 { true -> good() _ -> bad() }
    state good(&mut self) { self.process.exit(self.exit_code); }
    state bad(&mut self) { self.process.exit(71); }
}
