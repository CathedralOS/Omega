// PRV4 step 1: the EXTERNAL LEAF surface. A bodyless machine whose
// realization is a compile-time Binding expression -- `satisfies
// Requirement via <Binding>;` -- parses, lowers, and carries the
// ExternalRealization supply mode (the interned normalized rendering is
// its identity). Inert here (never called); the merge-time consumption is
// the next rung.
// Each target binds its own evaluated typed locator through a target-scoped
// `halt_binding` producer: PE by-name on Windows, versioned ELF on both
// Linux profiles, and one Mach-O dylib symbol on macOS AArch64.
use omega::language::core::external_binding;
use omega_language_std::console;
use omega::language::core::service;

boundary trait Shutdown {
    machine halt(code: i32);
}

windows_x86_64 machine halt_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "ExitProcess",
        },
    }
}

linux_x86_64 machine halt_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "exit",
            version: "GLIBC_2.2.5",
        },
    }
}

linux_arm64 machine halt_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "exit",
            version: "GLIBC_2.2.5",
        },
    }
}

macos_arm64 machine halt_binding() -> ForeignBinding<17, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_exit",
        },
    }
}

windows_x86_64 machine halt_leaf(code: i32) satisfies Shutdown::halt via halt_binding();
linux_x86_64 machine halt_leaf(code: i32) satisfies Shutdown::halt via halt_binding();
linux_arm64 machine halt_leaf(code: i32) satisfies Shutdown::halt via halt_binding();
macos_arm64 machine halt_leaf(code: i32) satisfies Shutdown::halt via halt_binding();

data Main { console: Binding<Console>; }
machine Main::main(&mut self)
reaches Console
{
    self.console.exit_process(70);
}
