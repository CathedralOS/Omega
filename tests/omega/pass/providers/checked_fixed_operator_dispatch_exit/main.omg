// A fixed-token boundary signature may select a checked Omega body. Spelled
// as a top-level bodyless `boundary machine - Owner::name(...);`, the token
// identifies the required operator slot and the realization reaches it through
// the ordinary exact `satisfies` relationship without redeclaring the token;
// the token resolves the public slot while execution redirects to the exact
// selected adapter in both checked interpretation and target-selected Terminal
// production, exactly as the `boundary operator` spelling did.
use omega_language_std::Console;

data CheckedMath {}

// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish.
domain i32::Picked;

boundary machine - CheckedMath::select_left(left: i32 in Picked, right: i32 in Picked) -> i32;

data CheckedMathProvider {}

machine CheckedMathProvider::select_left_impl(left: i32 in Picked, right: i32 in Picked) -> i32
satisfies CheckedMath::select_left
{
    transition { _ -> (left as i32) }
}

data Main { }

machine Main::main(main: &mut Main)
reaches Console
{
    // Primitive subtraction would return 67; the selected body returns 70.
    let result: i32 = (70 as i32 in Picked) - (3 as i32 in Picked);
    Console::exit_process(result);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
