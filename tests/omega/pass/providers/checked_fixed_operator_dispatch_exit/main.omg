// A fixed-token boundary operator may select a checked Omega body. The token
// resolves the public operator while execution redirects to the exact selected
// adapter in both checked interpretation and target-selected Terminal production.
use omega::language::std::console;

data CheckedMath {}

boundary operator - CheckedMath::select_left(left: i32, right: i32) -> i32;

data CheckedMathProvider {}

machine CheckedMathProvider::select_left_impl(left: i32, right: i32) -> i32
satisfies CheckedMath::select_left
{
    transition { _ -> left }
}

data Main { console: Console; }

machine Main::main(&mut self) {
    let result: i32 = (70 as i32) - 0;
    self.console.exit_process(result);
}
