// Expected exit: 0. Invocation lifetimes come from the explicit source loan,
// independently of the applied ancestor's ordinary outer type argument.

public boundary trait Parent<Value> {
    machine borrow<'source>(value: &'source Value) -> &'source Value reaches;
    machine borrow_mut<'source>(value: &'source mut Value) -> &'source mut Value reaches;
}
public boundary trait Child: Parent<i32> { machine choose() -> i32 reaches; }
ChildMap satisfies Child {
    Parent::borrow = borrow;
    Parent::borrow_mut = borrow_mut;
    Child::choose = choose;
}
machine borrow<'source>(value: &'source i32) -> &'source i32 { value }
machine borrow_mut<'source>(value: &'source mut i32) -> &'source mut i32 { value }
machine choose() -> i32 { 19 }
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

machine observed<'source>(value: &'source i32)
    -> &'source i32 reaches Parent {
    Parent<i32>::borrow(value)
}
machine observed_mut<'source>(value: &'source mut i32)
    -> &'source mut i32 reaches Parent {
    Parent<i32>::borrow_mut(value)
}

data Main { value: i32; }
machine Main::main(main: &mut Main) reaches Parent + Child crashes Trap {
    main.value = 37;
    let chosen: i32 = Child::choose();
    let borrowed: &i32 = observed(&main.value);
    let result: i32 = borrowed as i32;
    let mutable: &mut i32 = observed_mut(&mut main.value);
    mutable = 43;
    let changed: i32 = mutable as i32;
    let stored: i32 = main.value;
    transition chosen == 19 && result == 37 && changed == 43 && stored == 43 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Parent + Child crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
