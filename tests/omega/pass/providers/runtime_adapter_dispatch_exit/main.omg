// A static boundary call runs through the checked adapter retained by the
// selected named implementation in both engine pipelines.
use omega_language_std::console;
pub boundary trait Echo {
    machine echo(x: i32) -> i32;
}
data EchoProvider {}
machine EchoProvider::echo_adapter(x: i32) -> i32 satisfies Echo::echo {
    transition { _ -> (x) }
}
data Main { }
machine Main::main(main: &mut Main)
reaches Console, Echo
{
    let v: i32 = Echo::echo(70);
    Console::exit_process(v);
}

EchoProviderEchoImplementation satisfies Echo {
    Echo::echo = EchoProvider::echo_adapter;
}
