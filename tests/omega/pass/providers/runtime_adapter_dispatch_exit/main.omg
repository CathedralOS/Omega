// PRV4 ADAPTER DISPATCH (dual-engine): a call through a field whose
// declared type is a boundary trait rewrites -- in BOTH engine pipelines,
// before checking -- to the checked adapter retained by the selected nominal
// provider plan, and runs as ordinary Omega.
use omega_language_std::console;
boundary trait Echo {
    machine echo(x: i32) -> i32;
}
data EchoProvider {}
machine EchoProvider::echo_adapter(x: i32) -> i32 satisfies Echo::echo {
    transition { _ -> (x) }
}
data Main { console: Console; e: Echo; }
machine Main::main(&mut self) {
    let v: i32 = self.e.echo(70);
    self.console.exit_process(v);
}
