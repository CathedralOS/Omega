use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::application(builder, "runtime_provider_reference_deep_exit");
 Build::bind(builder, linux_x86_64::ProgramEntry, main);

 Build::bind<LocaleAccess::locate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "localeconv", version: "GLIBC_2.2.5" } });
}
