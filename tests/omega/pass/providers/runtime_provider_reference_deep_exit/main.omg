// Expected exit: 0. Read a stable provider-owned object through its retained descriptor.
use omega::language::core::external_binding;
data LocaleByte { value: u8; }
data Locale { decimal_point: &LocaleByte; }
boundary trait LocaleAccess { machine locate() -> &Locale reaches; }



machine main() reaches LocaleAccess crashes Trap {
 let locale: &Locale = LocaleAccess::locate();
 transition locale.decimal_point.value == 46 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
