// FIXED 2026-07-20 (was pending/providers/import_call_argument_lost): a
// call through a via-leaf DllImport row on the
// hosted aarch64 path lost its argument -- the capability-keyed
// returns_value() catalog routed authored imports to the NON-returning
// sequence, so the prepended result place marshaled into x0 and every real
// argument shifted. Authored imports now route to the value-returning
// sequence, and BOTH relocation walkers (the BL offset and the operand
// data-address fixups) shift the same way. exit(70) reaches libSystem as
// 70: native exit 70.
// The binding is an evaluated typed locator: `leaf_binding` returns the
// compiler-owned `Binding::DllImport` value carrying one exact Mach-O
// dylib-symbol import, so raw foreign bytes stay data.
use omega::language::core::external_binding;
use omega::language::core::service;

pub boundary trait Leaf {
    machine exit(code: i32) -> i32;
}

macos_arm64 machine leaf_binding() -> Binding<17, 5, 0> {
    Binding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_exit",
        },
    }
}

macos_arm64 machine leaf_exit(code: i32) -> i32 satisfies Leaf::exit via leaf_binding();
data Main { p: Service<Leaf>; }
machine Main::main(&mut self)
reaches Leaf
{
    let rc: i32 = self.p.exit(70);
    let keep: i32 = rc;
}
