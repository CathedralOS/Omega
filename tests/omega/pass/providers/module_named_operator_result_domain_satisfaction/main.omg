// A module source forest must retain a visible named operator family until
// typed satisfaction selects its parameter and result-domain signature.
use omega_language_std::console;
use scoped;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let correct: bool = scoped::calculate();
    transition correct {
        true -> pass(main)
        _ -> fail(main)
    }
    machine pass(main: &mut Main) { Console::exit_process(70); }
    machine fail(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
