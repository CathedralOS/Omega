// A module source forest must retain a visible named operator family until
// typed satisfaction selects its parameter and result-domain signature.
use omega_language_std::console;
use scoped;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let correct: bool = scoped::calculate();
    transition correct {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main) { Console::exit_process(71); }
}
