
machine build(builder: &mut Build) {
    Build::application(builder, "module_named_operator_result_domain_satisfaction");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::select_provider<scoped::Policy::convert, scoped::Provider>(builder, windows_x86_64);
    Build::select_provider<scoped::Policy::convert, scoped::Provider>(builder, linux_x86_64);
    Build::select_provider<scoped::Policy::convert, scoped::Provider>(builder, linux_arm64);
    Build::select_provider<scoped::Policy::convert, scoped::Provider>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
