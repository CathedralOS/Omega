use omega::language::core::binding;
// Boolean tuples retain separate public coordinates despite equal runtime ABI.
// Package review also retains the authored generic crash contract.
pub boundary trait Service {
    machine echo<const Selected: bool>(value: i32) -> i32
    where Selected == true || Selected == false
    crashes Trap value < 0;
}
Provider satisfies Service { Service::echo = echo; }
machine echo<const Selected: bool>(value: i32) -> i32 {
    transition Selected { true -> (18 as i32) _ -> (27 as i32) }
}
data Providers {}
macos_arm64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, Provider>(defaults);
}

linux_x86_64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, Provider>(defaults);
}
data Main { service: Binding<Service>; }
macos_arm64 machine Main::main(main: &mut Main) reaches Service crashes Trap {
    let selected: i32 = Service::echo<true>(&main.service, (17 as i32));
    let other: i32 = Service::echo<false>(&main.service, (25 as i32));
    transition selected == 18 && other == 27 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

linux_x86_64 machine Main::main(main: &mut Main) reaches Service crashes Trap {
    let selected: i32 = Service::echo<true>(&main.service, (17 as i32));
    let other: i32 = Service::echo<false>(&main.service, (25 as i32));
    transition selected == 18 && other == 27 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
