// Checking retains the same application through a nested field and a borrowed
// call. Only the selected entry establishes provider custody.

public boundary trait Reading {
    machine read() -> u64 reaches;
}

ReadingMap satisfies Reading { Reading::read = reading_provider_read; }
machine reading_provider_read() -> u64 { 42 }

// Merely checking a helper's application must not demand an unrelated selection.
public boundary trait Unselected { machine read() -> u64 reaches; }
machine unused() -> u64 reaches Unselected {
    Unselected::read()
}

data Session {}
data Main { session: Session; }

machine read() -> u64 reaches Reading {
    Reading::read()
}

machine Main::main(main: &mut Main) reaches Reading crashes Trap {
    let value: u64 = read();
    transition value == 42 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Reading crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
