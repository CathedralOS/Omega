// A boundary machine's byte-extent requirement (`count <= buffer.len`)
// discharges against the CALLER's sized storage: `&mut main.control`
// supplies `control`'s declared extent at the call site. The forwarded
// `buffer` parameter re-proves the same term inside `pump`, whose
// state-level `requires` carries the length across the boundary.
// `pump` takes the host binding rather than the whole subject, so its
// `buffer` is the only exclusive path to `control`.
pub boundary trait ByteHost {
    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64 reaches ByteHost
    requires
        count <= buffer.len;
}
data Main {
    control: [u8; 64];
    n: i64;
}
machine Main::main(main: &mut Main) reaches ByteHost {
    main.n = ByteHost::read(0, &mut main.control, 64);
    transition { _ -> pump(&mut main.control) }
    state pump(buffer: &mut [u8])
        requires 64 <= buffer.len;
    {
        let count: i64 = ByteHost::read(0, buffer, 64);
    }
}
