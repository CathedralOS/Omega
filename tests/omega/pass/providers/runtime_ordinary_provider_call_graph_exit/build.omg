machine build(builder: &mut Build) {
    Build::application(builder, "ordinary_provider_call_graph");
    Build::select_provider<Choice, Only>(builder, windows_x86_64);
    Build::select_provider<Choice, Only>(builder, linux_x86_64);
    Build::select_provider<Choice, Only>(builder, linux_arm64);
    Build::select_provider<Choice, Only>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, program);
    Build::bind(builder, linux_x86_64::ProgramEntry, program);
    Build::bind(builder, linux_arm64::ProgramEntry, program);
    Build::bind(builder, macos_arm64::ProgramEntry, program);
}
