// Source can check both function bodies without choosing either one.
// Build selects neither provider, so publishing this call must refuse.
boundary trait Pick {
    machine choose() -> i32 reaches;
}

FirstProvider satisfies Pick {
    machine choose() -> i32 { 1 }
}

SecondProvider satisfies Pick {
    machine choose() -> i32 { 2 }
}

machine main() -> i32 { Pick::choose() }

// Keep the original choice observable through an ordinary Unit entry.
machine entry() crashes Trap {
    let result: i32 = main();
    transition result == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
