// Kernel -> import -> kernel result transport, followed by another kernel
// call with a constant argument and an import in a successor block. Earlier
// results survive both entry mechanisms; calls cannot be inventoried from
// import relocations alone. Expected exit: 70 on both Linux architectures.
// Syscall numbers: Linux arch/x86/entry/syscalls/syscall_64.tbl and
// include/uapi/asm-generic/unistd.h (getpid and getpgid).
use omega::language::core::external_binding;

public data ProcessProbe {}
public boundary requirement ProcessProbe::process_id() -> i32;
public boundary requirement ProcessProbe::group_id(process: i32) -> i32;
public boundary requirement ProcessProbe::absolute(value: i32) -> i32
requires value > -2147483648;
public boundary requirement ProcessProbe::exit_with(code: i32);

data ProcessProvider {}
linux_x86_64 machine ProcessProvider::process_id() -> i32
satisfies ProcessProbe::process_id via ForeignBinding::Syscall(39);
linux_arm64 machine ProcessProvider::process_id() -> i32
satisfies ProcessProbe::process_id via ForeignBinding::Syscall(172);
linux_x86_64 machine ProcessProvider::group_id(process: i32) -> i32
satisfies ProcessProbe::group_id via ForeignBinding::Syscall(121);
linux_arm64 machine ProcessProvider::group_id(process: i32) -> i32
satisfies ProcessProbe::group_id via ForeignBinding::Syscall(155);

linux_x86_64 machine linux_x86_64_absolute_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "abs", version: "GLIBC_2.2.5",
        },
    }
}
linux_arm64 machine linux_arm64_absolute_binding() -> ForeignBinding<9, 3, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "abs", version: "GLIBC_2.17",
        },
    }
}
linux_x86_64 machine linux_x86_64_exit_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "exit", version: "GLIBC_2.2.5",
        },
    }
}
linux_arm64 machine linux_arm64_exit_binding() -> ForeignBinding<9, 4, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "exit", version: "GLIBC_2.17",
        },
    }
}
linux_x86_64 machine ProcessProvider::absolute(value: i32) -> i32
satisfies ProcessProbe::absolute via linux_x86_64_absolute_binding();
linux_arm64 machine ProcessProvider::absolute(value: i32) -> i32
satisfies ProcessProbe::absolute via linux_arm64_absolute_binding();
linux_x86_64 machine ProcessProvider::exit_with(code: i32)
satisfies ProcessProbe::exit_with via linux_x86_64_exit_binding();
linux_arm64 machine ProcessProvider::exit_with(code: i32)
satisfies ProcessProbe::exit_with via linux_arm64_exit_binding();

data Main {}
machine Main::main(main: &mut Main) {
    let process: i32 = ProcessProbe::process_id();
    transition process > 0 {
        true -> inspect(main, process)
        _ -> bad(main)
    }
    machine inspect(main: &mut Main, process: i32) requires process > 0 {
        let copied: i32 = ProcessProbe::absolute(process);
        let selected_group: i32 = ProcessProbe::group_id(copied);
        let current_group: i32 = ProcessProbe::group_id(0);
        transition copied == process && selected_group > 0 && selected_group == current_group {
            true -> good(main)
            _ -> bad(main)
        }
    }
    machine good(main: &mut Main) { ProcessProbe::exit_with(70); }
    machine bad(main: &mut Main) { ProcessProbe::exit_with(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
