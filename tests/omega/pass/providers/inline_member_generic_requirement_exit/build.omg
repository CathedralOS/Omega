machine build(builder: &mut Build) {
    Build::application(builder, "inline_member_generic_requirement_exit");
    Build::select_provider<Forward, IdentityProvider>(builder, linux_arm64);
    Build::select_provider<Forward, IdentityProvider>(builder, linux_x86_64);
    Build::select_provider<Forward, IdentityProvider>(builder, macos_arm64);
    Build::select_provider<Forward, IdentityProvider>(builder, macos_x86_64);
    Build::select_provider<Forward, IdentityProvider>(builder, windows_x86_64);
    Build::select_provider<Forward, IdentityProvider>(builder, uefi_x86_64);
    Build::select_provider<Forward, IdentityProvider>(builder, cross_platform_cli);
    Build::select_provider<Forward, IdentityProvider>(builder, local_unchecked);
    Build::select_provider<Forward, IdentityProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
