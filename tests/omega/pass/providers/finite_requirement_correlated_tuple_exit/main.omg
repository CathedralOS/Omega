// Complete tuples, not independent binder sets, define the public roster.
// The second tuple must retain its provider even though no call uses it.
pub boundary trait Service {
    machine echo<const Count: u64, const Stride: u64>(value: i32) -> i32
    where (Count == 4 && Stride == 1) || (Count == 8 && Stride == 2);
}
Provider satisfies Service { Service::echo = echo; }
machine echo<const Count: u64, const Stride: u64>(value: i32) -> i32 {
    transition Count == 4 && Stride == 1 {
        true -> (18 as i32) _ -> (27 as i32)
    }
}
data Providers {}
macos_arm64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, Provider>(defaults);
}

linux_x86_64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, Provider>(defaults);
}
data Main { }
macos_arm64 machine Main::main(main: &mut Main) reaches Service crashes Trap {
    let result: i32 = Service::echo<4, 1>((17 as i32));
    transition result == 18 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

linux_x86_64 machine Main::main(main: &mut Main) reaches Service crashes Trap {
    let result: i32 = Service::echo<4, 1>((17 as i32));
    transition result == 18 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
