use omega::language::core::layout;
// Expected exit: 0. Forward a provider-owned encoded scalar reference.


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}

data PortableByte [copy] { value: i64; }
data RawView { value: LayoutStorage<PortableByte, SignedByte>; }
use omega::language::core::external_binding;
boundary trait Version { machine locate() -> &RawView reaches; }
linux_x86_64 machine binding() -> ForeignBinding<9, 20, 11> {
 ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "gnu_get_libc_version", version: "GLIBC_2.2.5" } }
}
linux_x86_64 machine locate_native() -> &RawView satisfies Version::locate via binding();
NativeVersion satisfies Version {
 machine locate() -> &RawView { locate_native() }
}
boundary trait WideVersion { machine locate() -> &i64 reaches Version; }
WideProvider satisfies WideVersion {
 machine locate() -> &i64 reaches Version {
  let version: &RawView = Version::locate();
  &version.value.value
 }
}
machine main() reaches Version, WideVersion crashes Trap {
 let version: &RawView = Version::locate();
 let widened: &i64 = WideVersion::locate();
 transition widened == version.value.value { true -> done() false -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
