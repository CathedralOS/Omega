use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::application(builder, "runtime_provider_reference_view_exit");
 Build::select_provider<WideVersion, WideProvider>(builder, linux_arm64);
 Build::select_provider<WideVersion, WideProvider>(builder, linux_x86_64);
 Build::select_provider<WideVersion, WideProvider>(builder, macos_arm64);
 Build::select_provider<WideVersion, WideProvider>(builder, macos_x86_64);
 Build::select_provider<WideVersion, WideProvider>(builder, windows_x86_64);
 Build::select_provider<WideVersion, WideProvider>(builder, uefi_x86_64);
 Build::select_provider<WideVersion, WideProvider>(builder, cross_platform_cli);
 Build::select_provider<WideVersion, WideProvider>(builder, local_unchecked);
 Build::select_provider<WideVersion, WideProvider>(builder, alpha_bootstrap);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);

 Build::bind<Version::locate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "gnu_get_libc_version", version: "GLIBC_2.2.5" } });
}
