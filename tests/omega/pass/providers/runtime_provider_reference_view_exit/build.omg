machine build(builder: &mut Build) {
 Build::application(builder, "runtime_provider_reference_view_exit");
 Build::select_provider<Version, NativeVersion>(builder, linux_x86_64);
 Build::select_provider<WideVersion, WideProvider>(builder, linux_x86_64);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
