machine build(builder: &mut Build) {
    Build::application(builder, "named_provider_namespace_independence_exit");
    Build::select_provider<Numbers, SelectedNumbers>(builder, linux_arm64);
    Build::select_provider<Numbers, SelectedNumbers>(builder, linux_x86_64);
    Build::select_provider<Numbers, SelectedNumbers>(builder, macos_arm64);
    Build::select_provider<Numbers, SelectedNumbers>(builder, macos_x86_64);
    Build::select_provider<Numbers, SelectedNumbers>(builder, windows_x86_64);
    Build::select_provider<Numbers, SelectedNumbers>(builder, uefi_x86_64);
    Build::select_provider<Numbers, SelectedNumbers>(builder, cross_platform_cli);
    Build::select_provider<Numbers, SelectedNumbers>(builder, local_unchecked);
    Build::select_provider<Numbers, SelectedNumbers>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
