machine build(builder: &mut Build) {
    Build::application(builder, "linear_structural_provider_return_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<TokenFlow>(builder);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, linux_arm64);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, linux_x86_64);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, macos_arm64);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, macos_x86_64);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, windows_x86_64);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, uefi_x86_64);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, cross_platform_cli);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, local_unchecked);
    Build::select_provider<TokenFlow, TokenProviderTokenFlowImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
