// The same const application under an explicit build selection: the build
// root names `Math::remainder -> Provider`, so the pending application folds
// through `left | right` = 7 and the byte-6 write type-checks. The
// unselected `AltProvider` satisfier (which would fold the literal `9`)
// must stay inert: admission succeeds without ambiguity and the instance
// materializes the selected body's result only.
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega::language::core::service;

data Math {}

boundary machine % Math::remainder(left: u64, right: u64) -> u64;

data Provider {}

machine Provider::remainder(left: u64, right: u64) -> u64
satisfies Math::remainder
{
    transition { _ -> (left | right) }
}

data AltProvider {}

machine AltProvider::remainder(left: u64, right: u64) -> u64
satisfies Math::remainder
{
    transition { _ -> (9) }
}

machine limit() -> u64 {
    let left: u64 = 7;
    let right: u64 = 2;
    transition { _ -> (left % right) }
}

data Buffer<const N: u64> {
    values: [u8; N];
}

data Main {
    exit: Service<ProcessExit>;
    value: Buffer<limit()>;
}

machine Main::main(&mut self) reaches
    ProcessExit
{
    self.value.values[6] = 70;
    self.exit.exit_process(70);
}
