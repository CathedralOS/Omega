// Direct calls retain an exported contract even on a non-public external.
use omega::language::core::external_binding;
public boundary trait Magnitude {
    machine absolute(value: i32) -> i32 reaches requires value > -2147483648;
}
public macos_arm64 machine binding() -> ForeignBinding<26, 4, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_abs"
    } }
}

public linux_x86_64 machine linux_x86_64_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "abs", version: "GLIBC_2.2.5"
    } }
}
macos_arm64 boundary machine absolute(value: i32) -> i32
    satisfies Magnitude::absolute via binding()
    requires value > -2147483648;

linux_x86_64 boundary machine absolute(value: i32) -> i32
    satisfies Magnitude::absolute via linux_x86_64_binding()
    requires value > -2147483648;
data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let value: i32 = absolute(-41);
    transition value == 41 { true -> done() false -> wrong() }
    state done() {}
    state wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
