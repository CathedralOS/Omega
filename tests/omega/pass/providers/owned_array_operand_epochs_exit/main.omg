// Owned array operands snapshot contents at their exact evaluation positions.
// The same source home remains writable after each independent copy completes.
public data ArrayReader {}

public boundary requirement ArrayReader::capture(
    first: u64, values: [u8; 4], last: u64
) -> i32;

public boundary requirement ArrayReader::epochs(
    before: [u8; 4], marker: u64, after: [u8; 4]
) -> i32;

data ArrayReaderProvider {}

machine ArrayReaderProvider::capture(first: u64, values: [u8; 4], last: u64) -> i32
satisfies ArrayReader::capture {
    transition first == 11 && last == 22
        && values[0] == 31 && values[1] == 40
        && values[2] == 50 && values[3] == 60 {
        true -> 70
        _ -> 71
    }
}

machine ArrayReaderProvider::epochs(before: [u8; 4], marker: u64, after: [u8; 4]) -> i32
satisfies ArrayReader::epochs {
    transition marker == 22
        && before[0] == 31 && before[1] == 40
        && before[2] == 50 && before[3] == 60
        && after[0] == 99 && after[1] == 40
        && after[2] == 50 && after[3] == 60 {
        true -> 70
        _ -> 72
    }
}

data Buffer { values: [u8; 4]; effects: u64 in Wrapping; }

machine write31(buffer: &mut Buffer) -> u64 {
    buffer.values[0] = 31;
    buffer.effects += 1;
    11
}

machine write99(buffer: &mut Buffer) -> u64 {
    buffer.values[0] = 99;
    buffer.effects += 1;
    22
}

machine main() crashes Trap {
    let mut buffer: Buffer = Buffer { values: [30, 40, 50, 60], effects: 0 };
    // Capturing before the first scalar observes 30; capturing after the last
    // observes 99. Only the middle operand's completed copy contains 31.
    let captured: i32 = ArrayReader::capture(
        write31(&mut buffer), buffer.values, write99(&mut buffer)
    );
    buffer.values[0] = 31;
    // These two argument occurrences name one mutable home but independent
    // values. Neither a cached copy nor a live source address preserves both.
    let epochs: i32 = ArrayReader::epochs(
        buffer.values, write99(&mut buffer), buffer.values
    );
    transition captured == 70 && epochs == 70
        && buffer.effects == 3
        && buffer.values[0] == 99 && buffer.values[1] == 40
        && buffer.values[2] == 50 && buffer.values[3] == 60 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
