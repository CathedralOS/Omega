// Standard checked adapter. The imported Console package
// implements write/write_line as ordinary Omega machines over write_byte. Exercise both
// runtime-place and literal byte-carrier sources; both must travel through the
// honest borrowed byte-view path and measured byte walk.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 16]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Binding<Console>;
    text: [u8; 16] in Utf8;
}

machine Main::main(&mut self)
reaches Console
{
    self.text = "Field";
    self.console.write("");
    self.console.write(self.text);
    self.console.write_line("");
    self.console.write_line("Literal");
    self.console.write("\x80\xff");
    self.console.exit_process(70);
}
