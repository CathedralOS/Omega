use omega::language::core::binding;
use omega_language_std::console;

pub boundary trait ArrayReader {
    machine inspect(&mut self, prefix: i32, values: [[u8; 2]; 2], suffix: i32) -> i32;
}

data ArrayReaderProvider {}

machine ArrayReaderProvider::inspect(provider: &mut ArrayReaderProvider, prefix: i32, values: [[u8; 2]; 2], suffix: i32) -> i32
satisfies ArrayReader::inspect {
    transition prefix == 30 && suffix == 40 && values[0][0] == 11 && values[0][1] == 22 && values[1][0] == 33 && values[1][1] == 44 {
        true -> (70)
        _ -> (71)
    }
}

data Main {
    console: Binding<Console>;
    reader: Binding<ArrayReader>;
    literal_result: i32;
    local_result: i32;
}

machine Main::main(main: &mut Main) reaches Console + ArrayReader {
    let mut values: [[u8; 2]; 2] = [[11, 22], [33, 0]];
    values[1][1] = 44;
    main.literal_result = main.reader.inspect(30, [[11, 22], [33, 44]], 40);
    main.local_result = main.reader.inspect(30, values, 40);
    transition main.literal_result == 70 && main.local_result == 70 && values[1][1] == 44 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(72); }
}
