// A one-member boundary trait requirement with a consuming contract, supplied
// by a selected external sink. `Receipt` declares no `Receipt::drop` plan, so
// only the requirement call can retire a receipt's claim. The obligation
// reaches the requirement through transition arms that are alternatives, a
// local forwarded into a later state, and projected record members; each call
// returns the sink's result. Each bound target's C library `abs` takes one
// 32-bit integer, which is exactly how SysV x86-64, AAPCS64 and Windows x64
// pass a one-field `i32` record by value, so every result is the receipt's
// code. The same program without the sink is
// `fail/providers/consuming_trait_requirement_without_provider`.
use omega::language::core::external_binding;

pub data Receipt [linear] { code: i32; }

pub boundary trait Acknowledgement {
    machine ack(receipt: Receipt) -> i32;
}

pub data ReceiptSink {}

pub windows_x86_64 machine windows_x86_64_receipt_sink_binding() -> ForeignBinding<10, 3, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    }
}

pub linux_x86_64 machine linux_x86_64_receipt_sink_binding() -> ForeignBinding<9, 3, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    }
}

pub linux_arm64 machine linux_arm64_receipt_sink_binding() -> ForeignBinding<9, 3, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    }
}

pub macos_arm64 machine macos_arm64_receipt_sink_binding() -> ForeignBinding<17, 4, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_abs",
        },
    }
}

windows_x86_64 boundary machine ReceiptSink::ack(receipt: Receipt) -> i32
    satisfies Acknowledgement::ack via windows_x86_64_receipt_sink_binding();
linux_x86_64 boundary machine ReceiptSink::ack(receipt: Receipt) -> i32
    satisfies Acknowledgement::ack via linux_x86_64_receipt_sink_binding();
linux_arm64 boundary machine ReceiptSink::ack(receipt: Receipt) -> i32
    satisfies Acknowledgement::ack via linux_arm64_receipt_sink_binding();
macos_arm64 boundary machine ReceiptSink::ack(receipt: Receipt) -> i32
    satisfies Acknowledgement::ack via macos_arm64_receipt_sink_binding();

data Pair { left: Receipt; right: Receipt; }

machine verify(correct: bool) crashes Trap {
    transition correct {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

machine settle(receipt: Receipt, first: bool) -> i32 reaches Acknowledgement {
    transition first {
        true -> consume_first(receipt)
        _ -> consume_second(receipt)
    }

    state consume_first(receipt: Receipt) -> i32 {
        let held: Receipt = receipt;
        transition { _ -> later(held) }
    }

    state later(held: Receipt) -> i32 {
        Acknowledgement::ack(held)
    }

    state consume_second(receipt: Receipt) -> i32 {
        let code: i32 = Acknowledgement::ack(receipt);
        code % 100 + 100
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Acknowledgement crashes Trap {
    let first: i32 = settle(Receipt { code: 7 }, true);
    let second: i32 = settle(Receipt { code: 8 }, false);
    let pair: Pair = Pair { left: Receipt { code: 1 }, right: Receipt { code: 2 } };
    let left: i32 = Acknowledgement::ack(pair.left);
    let right: i32 = Acknowledgement::ack(pair.right);
    verify(first == 7 && second == 108 && left == 1 && right == 2);
}
