// The selected attached application root receives exact Fused Service
// establishment from its generated entry bridge; a same-shaped non-root
// owner receives no such authority merely because the provider is
// selected — `NonRoot::run` still checks its `reaches Ping` declaration.

pub boundary trait Ping {
    machine ping();
}
data PingProvider { }
machine PingProvider::ping() satisfies Ping::ping { }

data Main {
}
machine Main::main(main: &mut Main)
reaches Ping
{
    Ping::ping();
}

data NonRoot {
}
machine NonRoot::run(non_root: &mut NonRoot)
reaches Ping
{
    Ping::ping();
}
