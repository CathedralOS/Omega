// A bodyless boundary declaration's structural result completes through the
// call route: as the final expression of a value machine and as a local in a
// composed graph. Neither is a structural value produced by a machine body.
pub data Buffer<Element, const Count: u64> { value: i64; }
pub boundary trait Indexing {
    machine [] index<Element, const Count: u64>(
    items: Buffer<Element, Count>, offset: i32
) -> Buffer<Element, Count>
requires Count == Count;

}

IndexingProvider satisfies Indexing {
    Indexing::index = index_buffer;
}
machine index_buffer<Value, const Length: u64>(
    items: Buffer<Value, Length>, offset: i32
) -> Buffer<Value, Length>
{
    Buffer { value: ((items.value as i64 in Wrapping)
        + (offset as i64 in Wrapping)) as i64 }
}

machine pick(items: Buffer<i32, 4>) -> Buffer<i32, 4> reaches Indexing {
    items[(5 as i32)]
}

machine main() reaches Indexing crashes Trap {
    let first: Buffer<i32, 4> = pick(Buffer { value: 30 });
    let second: Buffer<i32, 4> = first[(7 as i32)];
    transition second.value == 42 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
