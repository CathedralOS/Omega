use support::values;

machine build(builder: &mut Build) {
    Build::application(builder, "build_product_adapter_frontiers_exit");
    Build::depend_as(builder, "support", Source::Path { location: "support" });
    Build::build_depend_as(builder, "support", Source::Path { location: "support" });
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, linux_arm64);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, linux_x86_64);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, macos_arm64);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, macos_x86_64);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, windows_x86_64);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, uefi_x86_64);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, cross_platform_cli);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, local_unchecked);
    Build::select_provider<support::Value::read, support::ValueProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
