// A public top-level boundary requirement called in statement position takes
// the value-position route: the call stays on the requirement and Omega
// installs the selected checked adapter; strict result use allows the
// `_ = call();` explicit discard.

use omega_language_std::console;
use omega::language::core::binding;

pub data CheckedMath {}

pub boundary requirement CheckedMath::offset_zero(value: i32) -> i32
requires value == value
ensures result == value + 0 && value == value;

data CheckedMathProvider {}

machine CheckedMathProvider::offset_zero_impl(input: i32) -> i32
satisfies CheckedMath::offset_zero
requires input == input
ensures result == input + 0 && input == input
{
    transition { _ -> (input + 0) }
}

data Main { console: Binding<Console>; }

machine Main::main(&mut self)
reaches Console
{
    _ = CheckedMath::offset_zero(70);
    self.console.exit_process(70i32);
}
