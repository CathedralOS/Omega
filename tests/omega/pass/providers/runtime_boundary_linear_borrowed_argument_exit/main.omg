// A boundary-trait requirement lends a linear value: `weigh(token: &Token)`
// and `tag(token: &Token, marker: u64)` take a shared loan of a `[linear]`
// record. The requirement's checked plan classifies that formal through the
// same signature classifier as the provider's own machine, so the loan is an
// ordinary shared-borrow structural parameter: the caller keeps the referent
// and its single occurrence across the call, and no custody transfers. The
// loan is lent directly from a local, forwarded through a second local, and
// lent again from a later state before the value is consumed.
use omega::language::core::drop;
use omega_language_std::console;

pub data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}

pub boundary trait TokenScale {
    machine weigh(token: &Token) -> u64;
    machine tag(token: &Token, marker: u64) -> bool;
}

data TokenScaleProvider {}

machine TokenScaleProvider::weigh(token: &Token) -> u64
satisfies TokenScale::weigh
{
    token.value
}

machine TokenScaleProvider::tag(token: &Token, marker: u64) -> bool
satisfies TokenScale::tag
{
    token.value == marker
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console, TokenScale {
    let token: Token = Token { value: 11 };
    let direct: u64 = TokenScale::weigh(&token);
    let forwarded: &Token = &token;
    let tagged: bool = TokenScale::tag(forwarded, 11);
    transition { _ -> check(main, token, direct, tagged) }
    state check(main: &mut Main, token: Token, direct: u64, tagged: bool) {
        let later: u64 = TokenScale::weigh(&token);
        let correct: bool = direct == 11 && tagged && later == 11;
        drop(token);
        transition correct {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}
