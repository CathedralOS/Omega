machine build(builder: &mut Build) {
    Build::application(builder, "runtime_boundary_linear_borrowed_argument_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, linux_arm64);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, linux_x86_64);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, macos_arm64);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, macos_x86_64);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, windows_x86_64);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, uefi_x86_64);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, cross_platform_cli);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, local_unchecked);
    Build::select_provider<TokenScale, TokenScaleProviderTokenScaleImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
