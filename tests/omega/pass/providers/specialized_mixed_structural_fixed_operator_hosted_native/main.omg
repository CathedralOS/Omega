// A hosted generic specialization covers mixed operands as well: the exact
// fixed-token use carries one whole owned affine generic operand and one
// fixed-width scalar literal through provider selection, where the locally
// supplied specialized machine produces the scalar result.
// Expected exit: 11.

use omega_language_std::console;

data Buffer<Element, const Count: u64> {
    value: i64;
}

data Indexing {}

boundary machine [] Indexing::index<Element, const Count: u64>(
    items: Buffer<Element, Count>,
    offset: i32
) -> i32
requires Count == Count;

data IndexingProvider {}

machine IndexingProvider::index<Value, const Length: u64>(
    items: Buffer<Value, Length>,
    offset: i32
) -> i32
satisfies Indexing::index
{
    offset
}

machine consume(items: Buffer<i32, 4>) -> i32 {
    items[(11 as i32)]
}

data Main { }

machine Main::main(main: &mut Main)
reaches Console
{
    let items: Buffer<i32, 4> = Buffer { value: 70 };
    Console::exit_process(consume(items));
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
