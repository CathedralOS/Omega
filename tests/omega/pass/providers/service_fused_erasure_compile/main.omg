// The first routed-service rung must retain an exact Fused selection receipt
// before lowering may erase the affine carrier into provider-backed dispatch.
use omega::language::core::service;

pub boundary trait Ping {
    machine ping();
    machine ping_value(value: i32);
}

pub boundary trait Other {
    machine other();
}

data PingProvider { }
machine PingProvider::ping() satisfies Ping::ping { }
machine PingProvider::ping_value(value: i32) satisfies Ping::ping_value { }

data Main {
    service: Service<Ping> in Bound;
}

machine Main::main(&mut self) {
    self.service.ping();
}

// The direct parameter rung retains one owned affine carrier across an ordered
// sequence of calls to the same exact Fused requirement. Its independent
// scalar namespace retains an ordinary immutable input without forwarding,
// borrowing, nesting, or return transport of the affine carrier.
data ParameterHarness { }
machine ParameterHarness::run(service: Service<Ping> in Bound, value: i32) {
    service.ping_value(value);
    service.ping_value(value);
}

// The first forwarding rung moves one whole owned carrier into one internal
// helper. The helper terminates the route with direct calls; forwarding a
// scalar, projecting or borrowing the carrier, or forwarding again remains
// outside this cohort.
machine forwarding_terminal(service: Service<Ping> in Bound) {
    service.ping();
}

machine forwarding_once(service: Service<Ping> in Bound) {
    forwarding_terminal(service);
}

// These declarations remain valid Omega but deliberately have no checked
// Terminal Unit plan in this rung.
machine forwarding_twice(service: Service<Ping> in Bound) {
    forwarding_once(service);
}

machine forwarding_scalar_terminal(
    service: Service<Ping> in Bound,
    value: i32
) {
    service.ping_value(value);
}

machine forwarding_scalar_once(
    service: Service<Ping> in Bound,
    value: i32
) {
    forwarding_scalar_terminal(service, value);
}
