machine build(builder: &mut Build) {
    Build::application(builder, "installation_reach_baseline");
    Build::select_provider<A, AProvider>(builder, linux_x86_64);
    Build::select_provider<B, BProvider>(builder, linux_x86_64);
    Build::select_provider<C, CProvider>(builder, linux_x86_64);
    Build::select_provider<D, DProvider>(builder, linux_x86_64);
    Build::select_provider<X, XProvider>(builder, linux_x86_64);
    Build::select_provider<Y, YProvider>(builder, linux_x86_64);
    Build::select_provider<A, AProvider>(builder, linux_arm64);
    Build::select_provider<B, BProvider>(builder, linux_arm64);
    Build::select_provider<C, CProvider>(builder, linux_arm64);
    Build::select_provider<D, DProvider>(builder, linux_arm64);
    Build::select_provider<X, XProvider>(builder, linux_arm64);
    Build::select_provider<Y, YProvider>(builder, linux_arm64);
    Build::select_provider<A, AProvider>(builder, windows_x86_64);
    Build::select_provider<B, BProvider>(builder, windows_x86_64);
    Build::select_provider<C, CProvider>(builder, windows_x86_64);
    Build::select_provider<D, DProvider>(builder, windows_x86_64);
    Build::select_provider<X, XProvider>(builder, windows_x86_64);
    Build::select_provider<Y, YProvider>(builder, windows_x86_64);
    Build::select_provider<A, AProvider>(builder, macos_arm64);
    Build::select_provider<B, BProvider>(builder, macos_arm64);
    Build::select_provider<C, CProvider>(builder, macos_arm64);
    Build::select_provider<D, DProvider>(builder, macos_arm64);
    Build::select_provider<X, XProvider>(builder, macos_arm64);
    Build::select_provider<Y, YProvider>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
