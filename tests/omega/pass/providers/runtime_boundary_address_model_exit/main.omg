// Expected exit: 0. A boundary retains its address-model requirement.
boundary trait Reader {
    machine read(value: u64) -> u64
    requires addr::Bound == 18446744073709551616;
}
Provider satisfies Reader {
    machine read(value: u64) -> u64
    requires addr::Bound == 18446744073709551616
    { value }
}
data Main {}
machine Main::main(context: &mut Main) reaches Reader crashes Trap
requires addr::Bound == 18446744073709551616
{
    let value: u64 = Reader::read(42);
    transition value == 42 { true -> done() _ -> wrong() }
    state done() {}
    state wrong() { crash Trap; }
}
