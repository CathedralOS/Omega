// A caller-provided capability is the exact requirement application:
// `Folder::write_line` names the passed authority without minting its own,
// and `Main::main` reaches it at entry.
public domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
public boundary trait Folder {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Folder;
}
data Librarian {}
machine archive() reaches Folder {
    Folder::write_line("archive entry");
}
data Main {
    librarian: Librarian;
}
machine Main::main() {
    archive();
}
