machine build(builder: &mut Build) {
    Build::application(builder, "cross_package_public_slot_exit");
    Build::depend_as(builder, "support", Source::Path { location: "support" });
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, linux_arm64);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, linux_x86_64);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, macos_arm64);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, macos_x86_64);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, windows_x86_64);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, uefi_x86_64);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, cross_platform_cli);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, local_unchecked);
    Build::select_provider<support::values::Hidden, support::values::HiddenMap>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
}
