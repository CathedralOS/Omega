// Expected exit: 0. Cross-package provider selection accepts the slot only
// when the dependency publishes it: `conformances.md:68-69` requires public
// visibility across a package boundary, and `public HiddenMap` supplies the one
// admitted realization. The counterpart twin declares the same three
// declarations private and is refused.
use support::values;
use support::values::Hidden;

machine Main::main() reaches Hidden crashes Trap {
    let value: u64 = Hidden::read();
    transition value == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
