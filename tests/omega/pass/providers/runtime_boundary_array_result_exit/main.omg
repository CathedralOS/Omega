use omega_language_std::console;

public boundary trait ArrayFactory {
    machine produce() -> [u8; 2] reaches;
}
data ArrayFactoryProvider {}
machine ArrayFactoryProvider::produce() -> [u8; 2]
satisfies ArrayFactory::produce { [30, 40] }

data Main {
}
machine Main::main(main: &mut Main) reaches Console, ArrayFactory {
    let values: [u8; 2] = ArrayFactory::produce();
    transition values[0] == 30 && values[1] == 40 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(72); }
}

ArrayFactoryProviderArrayFactoryImplementation satisfies ArrayFactory {
    ArrayFactory::produce = ArrayFactoryProvider::produce;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console, ArrayFactory {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
