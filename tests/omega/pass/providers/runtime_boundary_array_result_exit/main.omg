use omega_language_std::console;

pub boundary trait ArrayFactory {
    machine produce() -> [u8; 2];
}
data ArrayFactoryProvider {}
machine ArrayFactoryProvider::produce() -> [u8; 2]
satisfies ArrayFactory::produce { [30, 40] }

data Main {
}
machine Main::main(main: &mut Main) reaches Console, ArrayFactory {
    let values: [u8; 2] = ArrayFactory::produce();
    transition values[0] == 30 && values[1] == 40 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}
