// Predicate qualification changes no fixed-array storage or native reference.
// Both complete arrays cross the leaf, including non-byte WCHAR-like elements.
// Expected exit: 0
use omega::language::core::external_binding;

domain [u8; 4]::TerminatedBytes(bytes) requires bytes[3] == 0;
domain [u16; 4]::TerminatedWords(words) requires words[3] == 0;

boundary trait CompareArrays {
    machine bytes(left: &[u8; 4] in TerminatedBytes, right: &[u8; 4] in TerminatedBytes, count: u64) -> i32
    reaches
    requires count == 4;
    machine words(left: &[u16; 4] in TerminatedWords, right: &[u16; 4] in TerminatedWords, count: u64) -> i32
    reaches
    requires count == 8;
}
macos_arm64 machine macos_compare_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp"
    } }
}
linux_x86_64 machine linux_x86_compare_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5"
    } }
}
linux_arm64 machine linux_arm_compare_binding() -> ForeignBinding<9, 6, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.17"
    } }
}
windows_x86_64 machine windows_compare_binding() -> ForeignBinding<10, 6, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "memcmp"
    } }
}
macos_arm64 machine compare_bytes(left: &[u8; 4] in TerminatedBytes, right: &[u8; 4] in TerminatedBytes, count: u64) -> i32
satisfies CompareArrays::bytes via macos_compare_binding()
requires count == 4;
macos_arm64 machine compare_words(left: &[u16; 4] in TerminatedWords, right: &[u16; 4] in TerminatedWords, count: u64) -> i32
satisfies CompareArrays::words via macos_compare_binding()
requires count == 8;
linux_x86_64 machine compare_bytes(left: &[u8; 4] in TerminatedBytes, right: &[u8; 4] in TerminatedBytes, count: u64) -> i32
satisfies CompareArrays::bytes via linux_x86_compare_binding()
requires count == 4;
linux_x86_64 machine compare_words(left: &[u16; 4] in TerminatedWords, right: &[u16; 4] in TerminatedWords, count: u64) -> i32
satisfies CompareArrays::words via linux_x86_compare_binding()
requires count == 8;
linux_arm64 machine compare_bytes(left: &[u8; 4] in TerminatedBytes, right: &[u8; 4] in TerminatedBytes, count: u64) -> i32
satisfies CompareArrays::bytes via linux_arm_compare_binding()
requires count == 4;
linux_arm64 machine compare_words(left: &[u16; 4] in TerminatedWords, right: &[u16; 4] in TerminatedWords, count: u64) -> i32
satisfies CompareArrays::words via linux_arm_compare_binding()
requires count == 8;
windows_x86_64 machine compare_bytes(left: &[u8; 4] in TerminatedBytes, right: &[u8; 4] in TerminatedBytes, count: u64) -> i32
satisfies CompareArrays::bytes via windows_compare_binding()
requires count == 4;
windows_x86_64 machine compare_words(left: &[u16; 4] in TerminatedWords, right: &[u16; 4] in TerminatedWords, count: u64) -> i32
satisfies CompareArrays::words via windows_compare_binding()
requires count == 8;

machine main() reaches CompareArrays crashes Trap {
    let bytes: [u8; 4] = [97u8, 98u8, 99u8, 0u8];
    let same_bytes: [u8; 4] = [97u8, 98u8, 99u8, 0u8];
    let other_bytes: [u8; 4] = [97u8, 98u8, 100u8, 0u8];
    let words: [u16; 4] = [233u16, 8364u16, 65535u16, 0u16];
    let same_words: [u16; 4] = [233u16, 8364u16, 65535u16, 0u16];
    let other_words: [u16; 4] = [233u16, 8364u16, 65534u16, 0u16];
    let equal_bytes: i32 = compare_bytes(&bytes, &same_bytes, 4);
    let different_bytes: i32 = compare_bytes(&bytes, &other_bytes, 4);
    let equal_words: i32 = compare_words(&words, &same_words, 8);
    let different_words: i32 = compare_words(&words, &other_words, 8);
    transition equal_bytes == 0 && different_bytes != 0 && equal_words == 0 && different_words != 0 {
        true -> done()
        _ -> bad()
    }
    state done() { }
    state bad() { crash Trap; }
}
