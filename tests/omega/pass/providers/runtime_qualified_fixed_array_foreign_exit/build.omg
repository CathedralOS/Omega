use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "qualified_fixed_array_foreign");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);

 Build::bind<CompareArrays::bytes>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp"
    } });
 Build::bind<CompareArrays::words>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_memcmp"
    } });
 Build::bind<CompareArrays::bytes>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5"
    } });
 Build::bind<CompareArrays::words>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.2.5"
    } });
 Build::bind<CompareArrays::bytes>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.17"
    } });
 Build::bind<CompareArrays::words>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcmp", version: "GLIBC_2.17"
    } });
 Build::bind<CompareArrays::bytes>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "memcmp"
    } });
 Build::bind<CompareArrays::words>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "memcmp"
    } });
}
