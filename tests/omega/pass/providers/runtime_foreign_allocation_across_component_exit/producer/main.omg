// Expected exit: 0. macOS binds libSystem `_calloc` and `_free` from this package's build.

public boundary trait NativeBytes {
    machine allocate(count: u64, width: u64) -> addr reaches;
    machine release(pointer: addr) reaches;
}

public boundary trait RawAllocation {
    machine acquire() -> addr reaches NativeBytes;
}
public RawAllocationProvider satisfies RawAllocation {
    machine acquire() -> addr reaches NativeBytes {
        NativeBytes::allocate(1u64, 1u64)
    }
}
public machine component_entry() reaches RawAllocation, NativeBytes
invokes RawAllocation invokes NativeBytes crashes Trap {
    let pointer: addr = RawAllocation::acquire();
    NativeBytes::release(pointer);
}
