// Expected exit: 0.
use omega::language::core::external_binding;
use producer::main;

public boundary trait NativeRelease {
    machine release(pointer: addr) reaches;
}
public data LibSystemRelease {}


machine main() reaches RawAllocation, NativeRelease, NativeBytes crashes Trap {
    let pointer: addr = RawAllocation::acquire();
    transition pointer != 0 {
        true -> release(pointer)
        _ -> failed()
    }
    machine release(pointer: addr) { NativeRelease::release(pointer); }
    machine failed() { crash Trap; }
}
