// `boundary machine` entry with a linear parameter: the state
// entry establishment is realized by the entry prologue's
// inbound argument write — the body observes `handle.raw`,
// releases the claim through `boundary requirement`, and
// returns a value (boundary entries may return, unlike bound
// `Main::main(main: &mut Main)` carriers).
//
//   * `pub data ImageHandle [linear] { raw: addr; }`.
//   * `boundary machine Main::main(handle) -> i32`.
//
// Compile-checked only: no standard-library dependency.

pub data ImageHandle [linear] { raw: addr; }
boundary requirement ImageHandle::release(handle: ImageHandle);

pub data Main {}

boundary machine Main::main(handle: ImageHandle) -> i32 {
    let raw: addr = handle.raw;
    ImageHandle::release(handle);
    transition raw == 0 {
        true -> zero()
        false -> present()
    }

    state zero() -> i32 { 4 }
    state present() -> i32 { 5 }
}
