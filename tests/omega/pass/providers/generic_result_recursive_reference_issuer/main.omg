// An owned qualified payload names a route. A reference sibling is not an
// owned subject and does not recursively expand its referent during discovery.
data Token { value: u64; }
domain Token::Issued established by Issuer::issue;
data Loop<'next, T> { value: T; next: &'next Loop<'next, [T; 2]>; }
data Outcome<'next, T> {
    case Ready(value: T, next: &'next Loop<'next, u8>);
    case Empty;
}
boundary trait Issuer {
    machine issue<'next>(next: &'next Loop<'next, u8>) -> Outcome<'next, Token in Issued> reaches;
}
machine main() {}
