// The root selects a member handle per target: every `main` body is
// target-scoped and calls only its own target's `helper` — neither
// spelling nor the call graph is rewritten.
linux_x86_64 machine helper(value: u32) requires value == 1 {}
windows_x86_64 machine helper(value: u32) requires value == 2 {}
macos_arm64 machine helper(value: u32) requires value == 3 {}
linux_arm64 machine helper(value: u32) requires value == 4 {}
linux_x86_64 machine entry(value: u32) { helper(1); }
windows_x86_64 machine entry(value: u32) { helper(2); }
macos_arm64 machine entry(value: u32) { helper(3); }
linux_arm64 machine entry(value: u32) { helper(4); }

data Main {}
machine Main::main(main: &mut Main) { }
