}


macos_arm64 machine Second::index_buffer<Value, const Length: u64>(items: Buffer<Value, Length>, offset: i32) -> Buffer<Value, Length> { items }

machine main() reaches Indexing crashes Trap {
    let first: Buffer<i32, 4> = Buffer { value: 70 };
    let second: Buffer<u8, 8> = Buffer { value: 20 };
    let selected_first: Buffer<i32, 4> = first[(11 as i32)];
    let selected_second: Buffer<u8, 8> = second[(22 as i32)];
    transition selected_first.value == 81 && selected_second.value == 42 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
