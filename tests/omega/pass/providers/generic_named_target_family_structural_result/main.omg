// Both specializations have the same runtime layout, but distinct identities.
// A provider calls an ordinary helper and constructs a changed record; provider
// lowering must preserve that body rather than fabricate an identity return.
// Record-pattern coverage remains metadata through both provider clones; only
// the extracted field contributes a runtime value.
pub data Buffer<Element, const Count: u64> { value: i64; }
pub boundary trait Indexing {
    machine [] index<Element, const Count: u64>(
        items: Buffer<Element, Count>, offset: i32
    ) -> Buffer<Element, Count>
    requires Count == Count;
}

machine relay<Element, const Count: u64>(
    items: Buffer<Element, Count>
) -> Buffer<Element, Count> {
    items
}

pub data First { }
pub data Second { }

IndexingProvider satisfies Indexing {
    Indexing::index = First::index_buffer;
}
linux_x86_64 machine First::index_buffer<Value, const Length: u64>(
    items: Buffer<Value, Length>, offset: i32
) -> Buffer<Value, Length>
{
    let forwarded: Buffer<Value, Length> = relay(items);
    let { value as forwarded_value } = forwarded;
    Buffer { value: ((forwarded_value as i64 in Wrapping)
        + (offset as i64 in Wrapping)) as i64 }
}


linux_x86_64 machine Second::index_buffer<Value, const Length: u64>(items: Buffer<Value, Length>, offset: i32) -> Buffer<Value, Length> { items }

linux_arm64 machine First::index_buffer<Value, const Length: u64>(
    items: Buffer<Value, Length>, offset: i32
) -> Buffer<Value, Length>
{
    let forwarded: Buffer<Value, Length> = relay(items);
    let { value as forwarded_value } = forwarded;
    Buffer { value: ((forwarded_value as i64 in Wrapping)
        + (offset as i64 in Wrapping)) as i64 }
}


linux_arm64 machine Second::index_buffer<Value, const Length: u64>(items: Buffer<Value, Length>, offset: i32) -> Buffer<Value, Length> { items }

windows_x86_64 machine First::index_buffer<Value, const Length: u64>(
    items: Buffer<Value, Length>, offset: i32
) -> Buffer<Value, Length>
{
    let forwarded: Buffer<Value, Length> = relay(items);
    let { value as forwarded_value } = forwarded;
    Buffer { value: ((forwarded_value as i64 in Wrapping)
        + (offset as i64 in Wrapping)) as i64 }
}


windows_x86_64 machine Second::index_buffer<Value, const Length: u64>(items: Buffer<Value, Length>, offset: i32) -> Buffer<Value, Length> { items }

macos_arm64 machine First::index_buffer<Value, const Length: u64>(
    items: Buffer<Value, Length>, offset: i32
) -> Buffer<Value, Length>
{
    let forwarded: Buffer<Value, Length> = relay(items);
    let { value as forwarded_value } = forwarded;
