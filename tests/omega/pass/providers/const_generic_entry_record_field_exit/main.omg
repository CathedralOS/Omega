// A const-generic record nested in the ProgramEntry receiver rejoins its
// retained storage declaration by member identity — the applied
// declaration's storage members carry instantiation-scoped symbols, not
// the authored member's.
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Buffer<const N: u64> { values: [u8; N]; }

data Main {
    nested: Buffer<9>;
}

machine Main::main(main: &mut Main) reaches ProcessExit {
    main.nested.values[8] = 70;
    ProcessExit::exit_process(70);
}
