// Predicate-qualified scalars are not structural boundary arguments.
use omega::language::core::external_binding;
public domain i32::MagnitudeInput
    requires self > -2147483648; (self & 1) == 0;
public boundary trait Magnitude {
    machine absolute(value: i32 in MagnitudeInput) -> i32
        reaches
        requires 6 in MagnitudeInput;
}


data Main { }
machine Main::main(main: &mut Main) reaches Magnitude crashes Trap {
    let result: i32 = Magnitude::absolute(-128);
    transition result == 128 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Magnitude crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
