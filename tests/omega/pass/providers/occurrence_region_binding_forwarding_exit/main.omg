// Expected exit: 0. Nested fields, a borrowed local and two helper telescopes
// preserve one receiving requirement application without selecting caller regions.

pub boundary trait Reading<Value> { machine read(value: Value) -> i32; }
BorrowedReading<'provider> satisfies Reading<&'provider i32> {
    Reading::read = read;
}
machine read<'provider>(value: &'provider i32) -> i32 { value as i32 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Reading, BorrowedReading>(defaults);
}
linux_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Reading, BorrowedReading>(defaults);
}
linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Reading, BorrowedReading>(defaults);
}
windows_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Reading, BorrowedReading>(defaults);
}
machine stepped<'step>(value: &'step i32)
    -> i32 reaches Reading { Reading<&'step i32>::read(value) }
machine observed<'source>(value: &'source i32)
    -> i32 reaches Reading { stepped(value) }

data Session {
    value: i32;
}
data Main { session: Session; }
machine Main::main<'activation>(main: &'activation mut Main) reaches Reading crashes Trap {
    main.session.value = 37;
    let direct: i32 = observed(&main.session.value);
    let value: &'activation i32 = &main.session.value;
    let saved: i32 = observed(value);
    transition direct == 37 && saved == 37 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
