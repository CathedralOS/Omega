machine build(builder: &mut Build) {
    Build::application(builder, "occurrence_region_binding_forwarding_exit");
    Build::select_provider<Reading, BorrowedReading>(builder, macos_arm64);
    Build::select_provider<Reading, BorrowedReading>(builder, linux_arm64);
    Build::select_provider<Reading, BorrowedReading>(builder, linux_x86_64);
    Build::select_provider<Reading, BorrowedReading>(builder, windows_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
