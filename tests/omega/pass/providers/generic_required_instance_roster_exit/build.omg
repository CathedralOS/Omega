machine build(builder: &mut Build) {
    Build::application(builder, "generic_required_instance_roster_exit");
    Build::select_provider<Forward, Identity>(builder, windows_x86_64);
    Build::select_provider<Forward, Identity>(builder, linux_x86_64);
    Build::select_provider<Forward, Identity>(builder, macos_arm64);
    Build::select_provider<Forward, Identity>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
