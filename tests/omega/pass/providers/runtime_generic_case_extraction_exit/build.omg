machine build(builder: &mut Build) {
    Build::application(builder, "generic_case_extraction");
    Build::accept_boundary<ExtractionProvider>(builder);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, linux_arm64);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, linux_x86_64);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, macos_arm64);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, macos_x86_64);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, windows_x86_64);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, uefi_x86_64);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, cross_platform_cli);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, local_unchecked);
    Build::select_provider<ExtractionProvider<u64, u32>, Extract>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
