// Expected exit: 0. Store and read a provider-owned thread-local object.
use omega::language::core::external_binding;
data ErrorNumber { value: i32; }
boundary trait ErrorAccess { machine locate() -> &mut ErrorNumber reaches; }



machine forward() -> &mut ErrorNumber reaches ErrorAccess { ErrorAccess::locate() }
machine main() reaches ErrorAccess crashes Trap {
 let error: &mut ErrorNumber = forward();
 error.value = 42;
 transition error.value == 42 { true -> done() false -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
