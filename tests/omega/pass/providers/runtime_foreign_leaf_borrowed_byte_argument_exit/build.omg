use omega::language::core::external_binding;
// Darwin-only canary: the leaf binds libSystem's `_strlen`, so only
// macos_arm64 selects the entry.
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_foreign_leaf_borrowed_byte_argument_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind<CText::length>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_strlen",
        },
    });
 Build::bind<CText::length>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "strlen", version: "GLIBC_2.2.5",
        },
    });
}
