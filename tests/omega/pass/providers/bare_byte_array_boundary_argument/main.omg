// A boundary parameter of BARE `[u8; 7]` — an owned closed primitive array
// carrying no domain — plans and realizes as a boundary argument: the entry
// binds a program-entry root so the provider machine's Unit plan is demanded
// and the native leg exercises the full argument path end to end.
//
// The domain-carrying spelling (`take(name: [u8; 7] in CName)` under
// `public domain [u8; 7]::CName(name) requires name[6] == 0`) remains the supported
// contract surface — it engages the requires-contract check by name when the
// caller has not discharged the domain obligation.

use omega_language_std::console;

public boundary trait Sink { machine take(name: [u8; 7]) -> u64 reaches; }

public data SinkProvider { seen: u64; }

public macos_arm64 machine SinkProvider::provider_defaults(defaults: &mut SinkProvider) {
    SinkProvider::select_provider<Sink, SinkProviderSinkImplementation>(defaults);
}

public linux_x86_64 machine SinkProvider::provider_defaults(defaults: &mut SinkProvider) {
    SinkProvider::select_provider<Sink, SinkProviderSinkImplementation>(defaults);
}

public macos_arm64 machine SinkProvider::take(name: [u8; 7]) -> u64 satisfies Sink::take {
    transition { _ -> ret() }
    state ret() -> u64 { 7 }
}

public linux_x86_64 machine SinkProvider::take(name: [u8; 7]) -> u64 satisfies Sink::take {
    transition { _ -> ret() }
    state ret() -> u64 { 7 }
}

data Main {
    buf: [u8; 7];
    out: u64;
}

machine Main::main(main: &mut Main) reaches Console + Sink {
    main.out = Sink::take(main.buf);
    Console::exit_process(0);
}

SinkProviderSinkImplementation satisfies Sink {
    Sink::take = SinkProvider::take;
}
