// Expected exit: 0. Read a stable provider-owned object through its retained descriptor.
use omega::language::core::external_binding;
data VersionByte { value: u8; }
boundary trait Version { machine locate() -> &VersionByte reaches; }



machine main() reaches Version crashes Trap {
 let version: &VersionByte = Version::locate();
 transition { _ -> inspect(version) }
 machine inspect(version: &VersionByte) { transition version.value != 0 { true -> done() false -> bad() } }
 machine done() {} machine bad() { crash Trap; }
}
