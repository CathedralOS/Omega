machine build(builder: &mut Build) {
 Build::application(builder, "runtime_provider_mutable_reference_exit");
 Build::select_provider<ErrorAccess, NativeError>(builder, linux_arm64);
 Build::select_provider<ErrorAccess, NativeError>(builder, linux_x86_64);
 Build::select_provider<ErrorAccess, NativeError>(builder, macos_arm64);
 Build::select_provider<ErrorAccess, NativeError>(builder, macos_x86_64);
 Build::select_provider<ErrorAccess, NativeError>(builder, windows_x86_64);
 Build::select_provider<ErrorAccess, NativeError>(builder, uefi_x86_64);
 Build::select_provider<ErrorAccess, NativeError>(builder, cross_platform_cli);
 Build::select_provider<ErrorAccess, NativeError>(builder, local_unchecked);
 Build::select_provider<ErrorAccess, NativeError>(builder, alpha_bootstrap);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
