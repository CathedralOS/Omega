// The `via` sibling of `checked_boundary_requirement_*`: public boundary-trait
// requirements whose unique covering satisfiers are external leaves.
// Selection keeps each direct call ON the requirement — the requirement is
// itself a boundary declaration, so the call lowers through its retained
// boundary seam (a demanded Terminal boundary keyed on the requirement's
// normalized overload identity) rather than redirecting to an adapter. The
// leaves' evaluated bindings supply the selected plan rows and the retained
// external-binding rows; native realization joins them by that same
// requirement identity and delivers the foreign results through the
// requirements' result places. The interpreter has no provider for authored
// bindings and fails closed on the requirement calls. `absolute` publishes
// its foreign precondition as an ordinary scalar `requires`; the requirement
// declaration retains it in Terminal Psi and every call owes its obligation.

public boundary trait ForeignMath {
    machine absolute(value: i32) -> i32
    reaches
    requires value > -2147483648;
    machine exit_with(code: i32) reaches;
}

data Main {}

machine Main::main(main: &mut Main)
{
    let magnitude: i32 = ForeignMath::absolute(21);
    ForeignMath::exit_with(magnitude);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
