// One descendant selection establishes its exact applied ancestor Binding.
// Value is phantom in the call ABI: choosing Parent<u64>, not just Parent,
// must still be justified by the complete selected Child conformance.

pub boundary trait Parent<Value> { machine read() -> i32; }
pub boundary trait Child: Parent<u64> { machine choose() -> i32; }

ChildMap satisfies Child {
    Parent::read = read;
    Child::choose = choose;
}
machine read() -> i32 { 37 }
machine choose() -> i32 { 19 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

data Main { }
machine Main::main(main: &mut Main) reaches Child + Parent crashes Trap {
    let chosen: i32 = Child::choose();
    let observed: i32 = Parent<u64>::read();
    transition chosen == 19 && observed == 37 {
        true -> done() _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
