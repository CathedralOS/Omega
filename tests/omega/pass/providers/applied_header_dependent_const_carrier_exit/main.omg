// Expected exit: 0. The inherited u64 Type operand completes Count's declared
// carrier before its original signature predicate is copied. Static requirement
// calls preserve the authored Child provider selection.

const Four: u64 = 4;

public boundary trait Parent<Value, const Count: Value> {
    machine read() -> i32 reaches requires Count == Count;
}
public boundary trait Child: Parent<u64, 4> { machine choose() -> i32 reaches; }

ChildMap satisfies Child {
    Parent::read = read;
    Child::choose = choose;
}
machine read() -> i32 { 37 }
machine choose() -> i32 { 19 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

linux_x86_64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}

data Main {}

machine observed() -> i32 reaches Parent {
    Parent<u64, 4>::read()
}
machine nested_observation() -> i32 reaches Parent {
    observed()
}
machine Main::main(main: &mut Main) reaches Child + Parent crashes Trap {
    let direct: i32 = observed();
    let nested: i32 = nested_observation();
    let named: i32 = Parent<u64, Four>::read();
    let chosen: i32 = Child::choose();
    transition direct == 37 && nested == 37 && named == 37 && chosen == 19 {
        true -> done() _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Child + Parent crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
