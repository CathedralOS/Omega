// glibc mallinfo2 returns an 80-byte record through the SysV hidden result pointer.
use omega::language::core::external_binding;

public data AllocationStatistics {
    arena: u64;
    ordinary_blocks: u64;
    small_blocks: u64;
    mapped_blocks: u64;
    mapped_bytes: u64;
    unused_bytes: u64;
    freed_bytes: u64;
    allocated_bytes: u64;
    available_bytes: u64;
    releasable_bytes: u64;
}
public data AllocationProbe {}
public boundary requirement AllocationProbe::statistics() -> AllocationStatistics;
public boundary requirement AllocationProbe::exit_with(code: i32);
data AllocationProvider {}


public boundary requirement AllocationProbe::allocate(bytes: u64) -> addr;
public boundary requirement AllocationProbe::release(pointer: addr);


machine relay(statistics: AllocationStatistics, token: u64) -> AllocationStatistics {
    transition token == 70 {
        true -> complete(statistics)
        _ -> replace()
    }
    machine complete(statistics: AllocationStatistics) -> AllocationStatistics { statistics }
    machine replace() -> AllocationStatistics { AllocationProbe::statistics() }
}

machine collect(token: u64) -> AllocationStatistics {
    let statistics: AllocationStatistics = AllocationProbe::statistics();
    relay(statistics, token)
}

data Main {}
machine Main::main(main: &mut Main) {
    let first: AllocationStatistics = collect(70);
    let pointer: addr = AllocationProbe::allocate(128);
    let second: AllocationStatistics = collect(0);
    AllocationProbe::release(pointer);
    transition first.arena == 0 && first.ordinary_blocks == 1
        && first.small_blocks == 0 && first.mapped_blocks == 0
        && first.mapped_bytes == 0 && first.unused_bytes == 0
        && first.freed_bytes == 0 && first.allocated_bytes == 0
        && first.available_bytes == 0 && first.releasable_bytes == 0
        && second.arena > 0 && second.allocated_bytes > 0
        && second.ordinary_blocks == 1
        && second.small_blocks == 0 && second.mapped_blocks == 0
        && second.mapped_bytes == 0 && second.unused_bytes == 0
        && second.freed_bytes == 0
        && second.available_bytes > 0 && second.available_bytes < second.arena
        && second.releasable_bytes == second.available_bytes {
        true -> passed(main)
        _ -> failed(main)
    }
    machine passed(main: &mut Main) { AllocationProbe::exit_with(70); }
    machine failed(main: &mut Main) { AllocationProbe::exit_with(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
