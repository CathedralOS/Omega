public boundary trait Console {}
// A `data where` constrains a record's scalar field beside a service
// requirement: the facts don't hide the required slot from establishment.
data Session where retries <= 3 {
    retries: u64;
}
data Main {
    session: Session;
}
machine Main::main(main: &mut Main) {
    transition main.session.retries == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
