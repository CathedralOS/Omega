// Expected exit: 0. Observing a borrowed claim does not transfer it to the report.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Report { value: u64; }
data Reports { first: Report; second: Report; }
boundary trait Reader { machine read(token: &Token) -> Report reaches; }
LocalReader satisfies Reader {
    machine read(token: &Token) -> Report { Report { value: token.value } }
}
machine make() -> Token {
    let token: Token = Token { value: 42 };
    token
}
machine main() reaches Reader crashes Trap {
    let token: Token = make();
    let report: Report = Reader::read(&token);
    let reports: Reports = Reports {
        first: Reader::read(&token), second: Reader::read(&token)
    };
    let observed: u64 = report.value;
    drop(token);
    transition observed == 42 && reports.first.value == 42 && reports.second.value == 42 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
