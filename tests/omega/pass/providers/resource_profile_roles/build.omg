machine build(builder: &mut Build) {
    Build::application(builder, "resource_profile_roles");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, linux_arm64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, linux_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, macos_arm64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, macos_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, windows_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, uefi_x86_64);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, cross_platform_cli);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, local_unchecked);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder, alpha_bootstrap);
    Build::accept_boundary<KernelMemorySupply>(builder);
    Build::accept_boundary<FirmwareMemorySupply>(builder);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, linux_arm64);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, linux_x86_64);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, macos_arm64);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, macos_x86_64);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, windows_x86_64);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, uefi_x86_64);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, cross_platform_cli);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, local_unchecked);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder, alpha_bootstrap);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, linux_arm64);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, linux_x86_64);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, macos_arm64);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, macos_x86_64);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, windows_x86_64);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, uefi_x86_64);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, cross_platform_cli);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, local_unchecked);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
