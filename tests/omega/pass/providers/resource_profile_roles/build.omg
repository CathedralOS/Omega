machine build(builder: &mut Build) {
    Build::application(builder, "resource_profile_roles");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<ExtentRootProvider>(builder);
    Build::select_provider<ExtentRootProvider, SyntheticRoot>(builder);
    Build::accept_boundary<KernelMemorySupply>(builder);
    Build::accept_boundary<FirmwareMemorySupply>(builder);
    Build::select_provider<KernelMemorySupply, KernelSupply>(builder);
    Build::select_provider<FirmwareMemorySupply, FirmwareSupply>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
