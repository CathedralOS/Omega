// Expected exit: 0. Two exact static roles select independent profile supply
// for the same borrowed grant. Observing these profiles does not access backing.
use omega::language::core::extent;
use omega::language::core::layout;
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data KernelMemory {}
data FirmwareMemory {}
boundary trait KernelMemorySupply: ResourceProfileSupply<KernelMemory> {}
boundary trait FirmwareMemorySupply: ResourceProfileSupply<FirmwareMemory> {}

SyntheticRoot satisfies ExtentRootProvider {
    machine grant(storage: Extent) -> Extent { storage }
}

KernelSupply satisfies KernelMemorySupply {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

FirmwareSupply satisfies FirmwareMemorySupply {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut transfers: [TransferRule; 16];
        transfers[0] = TransferRule { width_bits: 64, alignment_bytes: 8 };
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: 8 },
            peer: PeerWritability::HostileShared,
            stable: StableCapability::None,
            external: ExternalCapability::Access {
                read: ExternalReadBehavior::Repeatable, write: false,
                transfers: TransferRules { entries: transfers, rule_count: 1 },
            },
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        regions[1] = ResourceRegion {
            range: RelativeRange { offset: 8, length: 8 },
            peer: PeerWritability::HostileShared,
            stable: StableCapability::None,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 2 }
    }
}

machine main()
reaches ExtentRootProvider + ResourceProfileSupply + ProcessExit
{
    let storage: Extent in Granted = ExtentRootProvider::grant(Extent { base: 4096, length: 16 });
    let kernel: ResourceProfile = ResourceProfileSupply<KernelMemory>::profile(&storage);
    let firmware: ResourceProfile = ResourceProfileSupply<FirmwareMemory>::profile(&storage);
    transition kernel.region_count == 1 && firmware.region_count == 2 &&
        kernel.regions[0].range.length == 16 && firmware.regions[0].range.length == 8 &&
        firmware.regions[1].range.offset == 8 && firmware.regions[1].range.length == 8 &&
        storage.length == 16 {
        true -> finish(storage, 0)
        _ -> finish(storage, 1)
    }
    machine finish(storage: Extent in Granted, status: i32) { ProcessExit::exit_process(status); }
}
