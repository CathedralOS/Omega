// An acyclic satisfier inherits the requirement's published guarantee
// without repeating either `terminates;` or a private witness — and a
// `boundary requirement` may publish the same interface (`terminates;`
// + `reaches;`) with its satisfier declared BEFORE it: inheritance
// does not depend on declaration order.
trait Value {
    machine value() -> u64 terminates;
}
machine value() -> u64
satisfies Value::value
{
    7
}
machine direct_value() -> u64
satisfies Direct::value
{
    9
}
data Direct { }
boundary requirement Direct::value() -> u64
terminates
reaches;

data Main {}
machine Main::main(main: &mut Main) {
    let result: u64 = value();
    let direct: u64 = direct_value();
}
