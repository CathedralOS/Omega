// One Build selection covers both overloads. Both calls must use RightProvider,
// not the competing LeftProvider and not primitive subtraction. The public
// requirements and suppliers must also survive the CLI's package review.
use omega_language_std::console;

pub data Math {}
pub boundary machine - Math::choose(left: i32, right: i32) -> i32;
pub boundary machine - Math::choose(left: u32, right: u32) -> u32;

pub data LeftProvider {}
pub machine LeftProvider::signed(left: i32, right: i32) -> i32
satisfies Math::choose { left }
pub machine LeftProvider::unsigned(left: u32, right: u32) -> u32
satisfies Math::choose { left }

pub data RightProvider {}
pub machine RightProvider::signed(left: i32, right: i32) -> i32
satisfies Math::choose { right }
pub machine RightProvider::unsigned(left: u32, right: u32) -> u32
satisfies Math::choose { right }

data Main { }
machine Main::main(main: &mut Main)
reaches Console
{
    let signed: i32 = (3 as i32) - (30 as i32);
    let unsigned: u32 = (90 as u32) - (40 as u32);
    transition signed == 30 && unsigned == 40 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
