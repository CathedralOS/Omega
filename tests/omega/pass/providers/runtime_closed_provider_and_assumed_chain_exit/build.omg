machine build(builder: &mut Build) {
    Build::application(builder, "runtime_closed_provider_and_assumed_chain_exit");
    Build::select_provider<Supplied, Actual>(builder);
    Build::assume_binding_contract<Required::get, Middle::get>(builder);
    Build::assume_binding_contract<Middle::get, Supplied::get>(builder);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
