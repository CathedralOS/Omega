// Two closed slice-range providers retain their own requirement identities
// beside a root-assumed Required -> Middle -> Supplied call returning 7.
// Expected exit: 0.
use omega::language::core::slice;

data Narrow { value: i32; }
data Wide { value: u64; }

boundary trait Required { machine get() -> u32 reaches ensures result <= 7; }
boundary trait Middle { machine get() -> u32 reaches; }
boundary trait Supplied { machine get() -> u32 reaches; }
Actual satisfies Supplied { machine get() -> u32 { 7 } }

machine main() reaches Required crashes Trap {
    let narrow: [Narrow; 2] = [Narrow { value: 1 }, Narrow { value: 2 }];
    let wide: [Wide; 3] = [Wide { value: 3 }, Wide { value: 4 }, Wide { value: 5 }];
    let narrow_view: &[Narrow] = &narrow[..];
    let wide_view: &[Wide] = &wide[..];
    let supplied: u32 = Required::get();
    transition narrow_view.len == 2 && wide_view.len == 3 && supplied == 7 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
