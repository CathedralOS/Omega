// PRV4c: the canonical free build root selects one complete provider for the
// component slot without reconstructing individual rows.
boundary trait Pick {
    machine choose() -> i32;
}

data FirstProvider { }
machine FirstProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (71) }
}

data SecondProvider { }
machine SecondProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (72) }
}

data Main { }
machine Main::main(&mut self) { }
