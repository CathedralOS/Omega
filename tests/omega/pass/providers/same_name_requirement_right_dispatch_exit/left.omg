module left;
use omega_language_std::console;

pub boundary trait Sink { machine emit() -> i32; }
pub data Provider {}
machine Provider::emit() -> i32 satisfies Sink::emit { 11 }

pub data Runner { }
pub machine Runner::run(context: &mut Runner) reaches Sink, Console
invokes Sink;
invokes Console;
{
    _ = Sink::emit();
    let observed: i32 = Sink::emit();
    transition observed == 11 { true -> again(context) _ -> bad(context) }
    state again(context: &mut Runner) {
        _ = Sink::emit();
        let observed: i32 = Sink::emit();
        transition observed == 11 { true -> good(context) _ -> bad(context) }
    }
    state good(context: &mut Runner) { Console::exit_process(70); }
    state bad(context: &mut Runner) { Console::exit_process(71); }
}
