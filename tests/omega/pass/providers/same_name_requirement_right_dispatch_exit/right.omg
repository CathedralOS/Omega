module right;
use omega_language_std::console;

public boundary trait Sink { machine emit() -> i32 reaches; }
public data Provider {}
machine Provider::emit() -> i32 satisfies Sink::emit { 37 }

public data Runner { }
public machine Runner::run(context: &mut Runner) reaches Sink, Console
invokes Sink;
invokes Console;
{
    _ = Sink::emit();
    let observed: i32 = Sink::emit();
    transition observed == 37 { true -> again(context) _ -> bad(context) }
    machine again(context: &mut Runner) {
        _ = Sink::emit();
        let observed: i32 = Sink::emit();
        transition observed == 37 { true -> good(context) _ -> bad(context) }
    }
    machine good(context: &mut Runner) { Console::exit_process(70); }
    machine bad(context: &mut Runner) { Console::exit_process(71); }
}

public ProviderSinkImplementation satisfies Sink {
    Sink::emit = Provider::emit;
}
