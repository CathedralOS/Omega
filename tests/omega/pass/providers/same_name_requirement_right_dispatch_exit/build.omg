machine build(builder: &mut Build) {
    Build::application(builder, "same_name_requirement_right_dispatch_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<right::Sink, right::ProviderSinkImplementation>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, right::Runner::run);
    Build::bind(builder, linux_x86_64::ProgramEntry, right::Runner::run);
    Build::bind(builder, linux_arm64::ProgramEntry, right::Runner::run);
    Build::bind(builder, macos_arm64::ProgramEntry, right::Runner::run);
}
