// Expected exit: 0. Computed and literal const arguments share an exact tuple.
boundary trait Service {
    machine echo<const Count: u64>(value: i32) -> i32
    reaches
    where Count == 4 || Count == 8;
}
Provider satisfies Service {
    machine echo<const Count: u64>(value: i32) -> i32 { value }
}
machine main() reaches Service crashes Trap {
    let first: i32 = Service::echo<(2 + 2)>((17 as i32));
    let second: i32 = Service::echo<8>((25 as i32));
    transition first == 17 && second == 25 {
        true -> {}
        false -> bad()
    }
    state bad() { crash Trap; }
}
