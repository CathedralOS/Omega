machine build(builder: &mut Build) {
    Build::application(builder, "applied_trait_member_inference_probe");
    Build::select_provider<Relay<u8>, ByteRelay>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Relay<u8>, ByteRelay>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Relay<u8>, ByteRelay>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Relay<u8>, ByteRelay>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
