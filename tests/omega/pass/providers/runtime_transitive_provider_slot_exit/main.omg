// Expected exit: 0.
// The application invokes only its portable requirement. Its selected checked
// provider retains the raw requirement as a static dependency, not source data.
use omega_language_std::console;

public boundary trait RawMeasure {
    machine measure(value: i32) -> i32 reaches;
}
public boundary trait PortableMeasure {
    machine measure(value: i32) -> i32 reaches invokes RawMeasure;
}
RawMeasureProvider satisfies RawMeasure {
    machine measure(value: i32) -> i32 { value }
}
PortableMeasureProvider satisfies PortableMeasure {
    machine measure(value: i32) -> i32 invokes RawMeasure; {
        RawMeasure::measure(value)
    }
}
data RawMeasureDefaults { }
data Main { }
machine Main::main(main: &mut Main) reaches Console
invokes PortableMeasure;
invokes Console;
{
    let observed: i32 = PortableMeasure::measure(37);
    transition observed == 37 {
        true -> good()
        false -> bad()
    }
    machine good() { Console::exit_process(0); }
    machine bad() { Console::exit_process(1); }
}

linux_x86_64 machine RawMeasureDefaults::provider_defaults(defaults: &mut RawMeasureDefaults) {
    RawMeasureDefaults::select_provider<RawMeasure, RawMeasureProvider>(defaults);
}

linux_arm64 machine RawMeasureDefaults::provider_defaults(defaults: &mut RawMeasureDefaults) {
    RawMeasureDefaults::select_provider<RawMeasure, RawMeasureProvider>(defaults);
}

macos_arm64 machine RawMeasureDefaults::provider_defaults(defaults: &mut RawMeasureDefaults) {
    RawMeasureDefaults::select_provider<RawMeasure, RawMeasureProvider>(defaults);
}

windows_x86_64 machine RawMeasureDefaults::provider_defaults(defaults: &mut RawMeasureDefaults) {
    RawMeasureDefaults::select_provider<RawMeasure, RawMeasureProvider>(defaults);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console
invokes PortableMeasure;
invokes Console;
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
