machine build(builder: &mut Build) {
    Build::select_provider<SelectedRawMeasureDefaultsProviderDefaults, CheckedRawMeasureDefaultsProviderDefaults>(builder, linux_x86_64);
    Build::select_provider<SelectedRawMeasureDefaultsProviderDefaults, CheckedRawMeasureDefaultsProviderDefaults>(builder, linux_arm64);
    Build::select_provider<SelectedRawMeasureDefaultsProviderDefaults, CheckedRawMeasureDefaultsProviderDefaults>(builder, macos_arm64);
    Build::select_provider<SelectedRawMeasureDefaultsProviderDefaults, CheckedRawMeasureDefaultsProviderDefaults>(builder, windows_x86_64);

    Build::application(builder, "runtime_transitive_provider_slot_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, linux_arm64);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, linux_x86_64);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, macos_arm64);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, macos_x86_64);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, windows_x86_64);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, uefi_x86_64);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, cross_platform_cli);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, local_unchecked);
    Build::select_provider<PortableMeasure, PortableMeasureProvider>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
