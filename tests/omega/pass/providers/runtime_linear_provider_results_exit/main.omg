// Expected exit: 0. Selected adapters preserve linear result custody through
// helper/state forwarding, fresh result construction and projected arguments.
use omega::language::core::drop;

pub data Receipt [linear] { code: i32; }
pub data Pair { left: Receipt; right: Receipt; }
machine Receipt::drop(receipt: &mut Receipt) {}

pub boundary trait Relay {
    machine forward(receipt: Receipt) -> Receipt;
    machine replace(receipt: Receipt) -> Receipt;
    machine pair(left: Receipt, right: Receipt) -> Pair;
}

Adapter satisfies Relay {
    Relay::forward = forward;
    Relay::replace = replace;
    Relay::pair = pair;
}

machine identity(receipt: Receipt) -> Receipt { receipt }

machine forward(receipt: Receipt) -> Receipt {
    let held: Receipt = identity(receipt);
    transition held.code == 7 {
        true -> first(held)
        _ -> other(held)
    }
    state first(receipt: Receipt) -> Receipt { receipt }
    state other(receipt: Receipt) -> Receipt { receipt }
}

machine consume(receipt: Receipt) -> i32 {
    let code: i32 = receipt.code;
    drop(receipt);
    code
}

machine replace(receipt: Receipt) -> Receipt {
    let prior: i32 = consume(receipt);
    let replacement: Receipt = Receipt { code: 10 };
    replacement
}

machine pair(left: Receipt, right: Receipt) -> Pair {
    Pair { left: left, right: right }
}

data Main { }
machine Main::main(main: &mut Main) reaches Relay crashes Trap {
    let first: Receipt = Relay::forward(Receipt { code: 7 });
    let first_code: i32 = consume(first);
    let second: Receipt = Relay::replace(Receipt { code: 9 });
    let second_code: i32 = consume(second);
    let neighbors: Pair = Relay::pair(Receipt { code: 11 }, Receipt { code: 13 });
    let projected: Receipt = Relay::forward(neighbors.left);
    let left_code: i32 = consume(projected);
    let right_code: i32 = consume(neighbors.right);
    transition first_code == 7 && second_code == 10
        && left_code == 11 && right_code == 13 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
