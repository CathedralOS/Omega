machine build(builder: &mut Build) {
    Build::application(builder, "runtime_named_provider_explicit_state_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<CounterOperations, CounterProvider>(builder, linux_arm64);
    Build::select_provider<CounterOperations, CounterProvider>(builder, linux_x86_64);
    Build::select_provider<CounterOperations, CounterProvider>(builder, macos_arm64);
    Build::select_provider<CounterOperations, CounterProvider>(builder, macos_x86_64);
    Build::select_provider<CounterOperations, CounterProvider>(builder, windows_x86_64);
    Build::select_provider<CounterOperations, CounterProvider>(builder, uefi_x86_64);
    Build::select_provider<CounterOperations, CounterProvider>(builder, cross_platform_cli);
    Build::select_provider<CounterOperations, CounterProvider>(builder, local_unchecked);
    Build::select_provider<CounterOperations, CounterProvider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
