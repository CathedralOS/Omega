use omega_language_std::console;

public data Counter { value: i32; }
public boundary trait CounterOperations {
    machine replace(counter: &mut Counter, value: i32) reaches;
    machine read(counter: &Counter) -> i32 reaches;
}

// The selected map owns code. Two explicit state values remain independent.
CounterProvider satisfies CounterOperations {
    CounterOperations::replace = replace_counter;
    CounterOperations::read = read_counter;
}
machine replace_counter(counter: &mut Counter, value: i32) {
    let mut staged: i32 = 0;
    staged = value;
    counter.value = staged;
}
machine read_counter(counter: &Counter) -> i32 { counter.value }

data Main {
    first: Counter;
    second: Counter;
    first_observed: i32;
    second_observed: i32;
}
machine Main::main(main: &mut Main) reaches Console + CounterOperations {
    CounterOperations::replace(&mut main.first, 30);
    CounterOperations::replace(&mut main.second, 40);
    main.first_observed = CounterOperations::read(&main.first);
    main.second_observed = CounterOperations::read(&main.second);
    transition main.first_observed == 30 && main.second_observed == 40 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + CounterOperations {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
