// A temporary authorized schema can contribute an owned scalar constant.
// Expected exit: 0
use omega::language::core::reflect;
data Reading [copy] {
    #8 header: u8;
    #3 sequence: u64;
    #90 case Sample(#1 value: u64, retired #2);
    #7 case Empty;
}
machine image_length() -> u64 reaches terminates {
    let graph: reflect::TypeSchema = reflect::schema<Reading>();
    reflect::schema_image_length(&graph)
}
const LENGTH: u64 = image_length();
machine main() crashes Trap {
    transition LENGTH > 0u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
