// RUN CANARY (exit 70) + interpreter differential. A scalar local initialized
// from member reads through a `&mut` record loan local observes the loan the
// way a guard's member reads do: the copied scalars carry no loan, so the
// loan ends at its last use and the original is then read on its own
// authority. Stores through the loan land in the original's storage.
//
//   value  7 -> 99 through the loan, read back into an immutable local
//   tag    3 read into a mutable local, which is then reassigned to 4;
//          the original keeps 3 because only the copy changed
//   active false -> true through the loan, read back as a bool
use omega_language_std::console;

data Record {
    value: u16;
    tag: u16;
    active: bool;
}

data Main {
    source: Record;
}

machine Main::main(context: &mut Main) reaches Console {
    context.source.value = 7;
    context.source.tag = 3;
    context.source.active = false;
    let view: &mut Record = &mut context.source;
    view.value = 99;
    view.active = true;
    let seen_value: u16 = view.value;
    let mut seen_tag: u16 = view.tag;
    let seen_active: bool = view.active;
    let original_tag: bool = seen_tag == 3;
    seen_tag = 4;
    transition context.source.value == 99
        && context.source.tag == 3
        && context.source.active
        && seen_active
        && seen_value == 99
        && original_tag
        && seen_tag == 4 {
        true -> good(context)
        _ -> bad(context)
    }

    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
