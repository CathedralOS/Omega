// Expected exit: 0
// A rebound shared-reference parameter returns the view it now holds. Both
// candidates borrow caller storage that outlives the call, so returning the
// rebound parameter is valid. At run time the original referent holds 1 and
// the replacement holds 7: the caller must read 7 through the returned view,
// which a lowering that returned the original formal would not.
machine observe<'a>(mut selected: &'a u64, replacement: &'a u64) -> &'a u64 {
    selected = replacement;
    selected
}

machine main() crashes Trap {
    let original: u64 = 1;
    let replacement: u64 = 7;
    let r: &u64 = observe(&original, &replacement);
    transition r == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
