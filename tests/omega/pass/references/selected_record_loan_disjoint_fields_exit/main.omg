// A selected mutable room loan suspends its possible rooms, not siblings.
use omega_language_std::console;
use omega::language::core::binding;

data Marker [copy] { case First; case Second; }
data Room [copy] { value: u64; flag: bool; }
data Level [copy] { rooms: [Room; 3]; start: Marker; counter: u64; }
data Main { console: Binding<Console>; level: Level; }

machine choose(level: &mut Level, first: bool) -> &mut Room {
    transition first {
        true -> &mut level.rooms[0]
        false -> &mut level.rooms[1]
    }
}

machine update(level: &mut Level, first: bool) {
    let room: &mut Room = choose(level, first);
    room.flag = level.start == Marker::First;
    room.value = level.counter;
}

machine Main::main(main: &mut Main) reaches Console {
    main.level.counter = 37;
    main.level.start = Marker::First;
    update(&mut main.level, true);
    main.level.start = Marker::Second;
    update(&mut main.level, false);
    transition main.level.rooms[0].value == 37
        && main.level.rooms[1].value == 37
        && main.level.counter == 37
        && main.level.rooms[0].flag
        && !main.level.rooms[1].flag {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
