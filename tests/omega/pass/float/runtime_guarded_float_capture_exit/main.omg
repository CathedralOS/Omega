// A saved conjunction and captured array selector retain the same value.
// The true upper comparison excludes NaN even after the negated lower bound.
use omega::language::core::float_operations;

machine select(values: &[f64; 2], index: u64) -> f64
requires
    index < 2,
{
    let accepted: bool = !(values[index] < 0.0) && values[index] <= 1.0;
    transition accepted { true -> bounded(values[index]) _ -> 0.0 }
    machine bounded(value: f64) -> f64
    requires
        !(value < 0.0) && value <= 1.0,
    {
        value
    }
}
machine main() crashes Trap {
    let zero: f64 = 0.0;
    let values: [f64; 2] = [0.5, zero / zero];
    transition select(&values, 0) == 0.5 && select(&values, 1) == 0.0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
