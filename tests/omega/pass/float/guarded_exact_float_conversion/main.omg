use omega::language::core::float_operations;

// A source-proof regression, independent of native bounded-float record
// lowering. The selected Float calls must retain their IEEE guard meaning.
// The record travels to the state that writes it as an ordinary argument.
data Guarded { value: f64; converted: i32; }
machine Guarded::convert(guarded: &mut Guarded) {
    transition guarded.value == guarded.value
        && guarded.value >= 0.0 && guarded.value <= 100.0 {
        true -> bounded(guarded)
        _ -> done()
    }
    state bounded(guarded: &mut Guarded) { guarded.converted = guarded.value as i32; }
    state done() {}
}
