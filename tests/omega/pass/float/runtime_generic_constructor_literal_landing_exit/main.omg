use omega::language::core::float_operations;
use omega_language_std::console;

data Cell<T [copy]> [copy] { value: T; }
data Envelope<T [copy]> [copy] { cell: Cell<T>; values: [T; 2]; }
data Outcome<T [copy]> [copy] { case Value(value: T); }
data Main {
    small: Envelope<f32>;
    wide: Cell<f64>;
}

machine rounded_case() -> Outcome<f32> {
    transition { _ -> (Outcome::Value { value: 8388609.499999999999999 }) }
}

machine observe(input: &Cell<f32>) -> f32 { input.value }

machine Main::main(main: &mut Main) reaches Console {
    // Exact decimal lies below the f32 midpoint. A default-f64 landing followed
    // by narrowing would instead choose 8388610 and fail this frozen oracle.
    main.small = Envelope {
        cell: Cell { value: 8388609.499999999999999 },
        values: [8388609.499999999999999, 0.0]
    };
    main.wide = Cell { value: 9007199254740993.0 };
    let borrowed: f32 = observe(&Cell { value: 8388609.499999999999999 });
    let outcome: Outcome<f32> = rounded_case();
    transition outcome {
        Outcome::Value { value } -> check(main, value, borrowed)
    }
    state check(main: &mut Main, value: f32, borrowed: f32) {
        transition main.small.cell.value == 8388609.0f32
            && main.small.values[0] == 8388609.0f32
            && main.small.values[1] == 0.0f32
            && main.wide.value == 9007199254740992.0f64
            && value == 8388609.0f32 && borrowed == 8388609.0f32 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
