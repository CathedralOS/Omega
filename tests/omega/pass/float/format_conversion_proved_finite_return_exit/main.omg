use omega_language_std::Console;
use omega::language::core::F32::from_f64;

// Narrowing an f64 to f32 overflows to infinity for large inputs, so a
// `-> f32 in Finite` result owes a proof at the return. Each machine narrows
// first, then returns the narrowed value only on the arm whose guard bounds
// it inside f32's finite range. `late` puts that arm last, where its proof
// comes from refuting the earlier arm's guard. `main` takes every arm.
machine early(value: f64) -> f32 in Finite {
    let narrowed: f32 = F32::from_f64(value);
    transition narrowed < 3.0e38f32 && narrowed > -3.0e38f32 {
        true -> (narrowed)
        _ -> (0.25f32)
    }
}
machine late(value: f64) -> f32 in Finite {
    let narrowed: f32 = F32::from_f64(value);
    transition narrowed < 3.0e38f32 && narrowed > -3.0e38f32 {
        false -> (0.25f32)
        true -> (narrowed)
    }
}
data Main { }
machine run(main: &mut Main) reaches Console {
    let small: f32 in Finite = early(0.5);
    let large: f32 in Finite = early(1.0e100);
    let late_small: f32 in Finite = late(-0.5);
    let late_large: f32 in Finite = late(-1.0e100);
    transition small == 0.5f32 && large == 0.25f32 && late_small == -0.5f32 && late_large == 0.25f32 {
        true -> good()
        _ -> bad()
    }
    machine good() { Console::exit_process(77); }
    machine bad() { Console::exit_process(78); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    run(&mut entry_storage);
}
