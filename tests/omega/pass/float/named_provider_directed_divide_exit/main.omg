// One divided by three lies strictly between adjacent binary values. Directed
// modes select the neighboring results while ordinary division remains
// nearest-even after each local floating-control-state envelope.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut one32: f32 = 1.0f32;
    let mut three32: f32 = 3.0f32;
    let mut lower32: f32 = 0.333333313465118408203125f32;
    let mut upper32: f32 = 0.3333333432674407958984375f32;
    let mut negative_upper32: f32 = 0.0f32 - upper32;
    let mut positive32: f32 = F32::divide_toward_positive(one32, three32);
    let mut zero32: f32 = F32::divide_toward_zero(one32, three32);
    let mut negative32: f32 = F32::divide_toward_negative(
        0.0f32 - one32,
        three32
    );
    let mut ordinary32: f32 = one32 / three32;

    let mut one64: f64 = 1.0;
    let mut three64: f64 = 3.0;
    let mut lower64: f64 = 0.333333333333333314829616256247390992939472198486328125;
    let mut upper64: f64 = 0.33333333333333337034076748750521801471710205078125;
    let mut negative_upper64: f64 = 0.0 - upper64;
    let mut positive64: f64 = F64::divide_toward_positive(one64, three64);
    let mut zero64: f64 = F64::divide_toward_zero(one64, three64);
    let mut negative64: f64 = F64::divide_toward_negative(0.0 - one64, three64);
    let mut ordinary64: f64 = one64 / three64;

    transition positive32 == upper32
        && zero32 == lower32
        && negative32 == negative_upper32
        && ordinary32 == upper32
        && positive64 == upper64
        && zero64 == lower64
        && negative64 == negative_upper64
        && ordinary64 == lower64 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(77); }
}
