// F5: Saturating float arithmetic clamps only genuine finite-input overflow.
// f32::MAX * 2 becomes +/-f32::MAX in both write and nested operand position;
// division by zero and 0/0 retain their IEEE infinity/NaN results.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    maximum: f32 in Finite & Saturating;
    negative_maximum: f32 in Finite & Saturating;
    two: f32 in Finite & Saturating;
    zero: f32 in Saturating;
    clamped: f32 in Finite & Saturating;
    result: f32 in Saturating;
}

machine Main::main(main: &mut Main) reaches Console {
    main.maximum = 340282346638528859811704183484516925440.0;
    main.negative_maximum = (0.0 - main.maximum) as f32 in Saturating;
    main.two = 2.0;
    main.zero = 0.0;
    let c: f32 in Finite & Saturating = (main.maximum * main.two) as f32 in Saturating;
    main.clamped = c;
    transition main.clamped == main.maximum {
        true -> negative(main)
        _ -> bad(main, 78)
    }

    state negative(main: &mut Main) {
        let c2: f32 in Finite & Saturating = (main.negative_maximum * main.two) as f32 in Saturating;
        main.clamped = c2;
        transition main.clamped == main.negative_maximum {
            true -> nested(main)
            _ -> bad(main, 79)
        }
    }

    state nested(main: &mut Main) {
        transition main.maximum * main.two == main.maximum {
            true -> divide_zero(main)
            _ -> bad(main, 80)
        }
    }

    state divide_zero(main: &mut Main) {
        let r: f32 in Saturating = (main.maximum / main.zero) as f32 in Saturating;
        main.result = r;
        transition main.result > main.maximum {
            true -> invalid(main)
            _ -> bad(main, 81)
        }
    }

    state invalid(main: &mut Main) {
        let r2: f32 in Saturating = (main.zero / main.zero) as f32 in Saturating;
        main.result = r2;
        transition main.result != main.result {
            true -> good(main)
            _ -> bad(main, 82)
        }
    }

    state good(main: &mut Main) { Console::exit_process(77); }
    state bad(main: &mut Main, code2: i32) { Console::exit_process(code2); }
}
