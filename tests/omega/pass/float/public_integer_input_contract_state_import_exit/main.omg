use omega::language::core::float_operations;

data Choice { case First; case Second; }

// Calls in separate state arrivals retain the actual value passed to that path.
machine rounded(value: i32, choice: Choice) -> f32
ensures
    F32::classify(result) == F32::classify(F32::from_i32(value)) &&
    (F32::is_nan(result) || result == F32::from_i32(value)) {
    transition choice {
        Choice::First -> first(value)
        Choice::Second -> second(value)
    }
    machine first(value: i32) -> f32 {
        transition { _ -> (F32::from_i32(value)) }
    }
    machine second(value: i32) -> f32 {
        transition { _ -> (F32::from_i32(value)) }
    }
}

machine main() crashes Trap {
    let first: f32 = rounded(16777217i32, Choice::First);
    let second: f32 = rounded(16777217i32, Choice::Second);
    transition first == 16777216.0f32 && second == 16777216.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
