// Integer truncation is valid below the signed minimum by less than one.
// U64 conversion must also preserve values above the signed hardware range.
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let narrow: i8 in Trapping = I8::from_f32(-128.75f32);
    let signed: i32 in Trapping = I32::from_f64(-2147483648.75);
    let negative_fraction: u64 in Trapping = U64::from_f64(-0.75);
    let high: u64 = U64::from_f64(9223372036854777856.0);
    let saturated: u64 in Saturating = U64::from_f64(18446744073709551616.0);
    let maximum: u64 = 18446744073709551615u64;
    let rounded64: f64 = F64::from_u64(maximum);
    let rounded32: f32 = F32::from_u64(maximum);
    let narrow_value: i8 = narrow as i8;
    let signed_value: i32 = signed as i32;
    let fraction_value: u64 = negative_fraction as u64;
    let saturated_value: u64 = saturated as u64;
    transition {
        narrow_value == -128 && signed_value == -2147483648
            && fraction_value == 0 && high == 9223372036854777856u64
            && saturated_value == maximum
            && rounded64 == 18446744073709551616.0
            && rounded32 == 18446744073709551616.0f32 -> good(&main.console)
        _ -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 77); }
}
