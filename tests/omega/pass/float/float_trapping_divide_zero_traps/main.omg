use omega::language::core::float_operations;

use omega_language_std::console;
data Main {
    console: Console;
    one: f32 in Trapping;
    zero: f32 in Trapping;
    result: f32 in Trapping;
}
machine Main::main(&mut self) {
    self.one = 1.0;
    self.zero = 0.0;
    self.result = self.one / self.zero;
    self.console.exit_process(70);
}
