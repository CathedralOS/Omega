// Nested selected float results keep the exact occurrence policy when
// consumed by the fields of a returned aggregate.
use omega::language::core::float_operations;
use omega_language_std::console;

public data Pair [copy] { first: f64; second: f64; }
machine make_pair(x: f64, y: f64) -> Pair {
    Pair { first: x + y, second: x * (y - 1.0) }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let pair: Pair = make_pair(2.0, 4.0);
    transition pair.first == 6.0 && pair.second == 6.0 {
        true -> good()
        false -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
