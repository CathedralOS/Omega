// Nested selected float results keep the exact occurrence policy when
// consumed by the fields of a returned aggregate.
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

pub data Pair [copy] { first: f64; second: f64; }
machine make_pair(x: f64, y: f64) -> Pair {
    Pair { first: x + y, second: x * (y - 1.0) }
}
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let pair: Pair = make_pair(2.0, 4.0);
    transition pair.first == 6.0 && pair.second == 6.0 {
        true -> good(&main.console)
        false -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
