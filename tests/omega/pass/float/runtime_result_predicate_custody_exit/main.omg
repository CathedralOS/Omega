use omega::language::core::float_operations;

data Values { exact: f64; fraction: f64; }

machine source() -> f64 ensures result == 3.75 { 3.75 }
machine accept(value: f64) -> f32
requires value >= 3.75 && value <= 3.75
ensures result == 3.75f32
{ value as f32 }

machine through_state() -> f32 ensures result == 3.75f32 {
    let captured: f64 = source();
    transition { _ -> complete(captured) }
    machine complete(value: f64) -> f32 requires value == 3.75
    { accept(value) }
}

machine through_field() -> f32 ensures result == 3.75f32 {
    let values: Values = Values { exact: source(), fraction: 0.1f64 };
    accept(values.exact)
}

machine saved_after_write() -> f32 ensures result == 3.75f32 {
    let mut current: f64 = source();
    let captured: f64 = current;
    current = 0.1f64;
    accept(captured)
}

machine main() crashes Trap {
    let state_value: f32 = through_state();
    let field_value: f32 = through_field();
    let saved_value: f32 = saved_after_write();
    transition state_value == 3.75f32 && field_value == 3.75f32 && saved_value == 3.75f32 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
