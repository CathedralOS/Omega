use omega::language::core::abs_f64;

use omega_language_std::ByteRead;
use omega_language_std::Console;
use omega::language::core::F64::from_i32;
data Main {value:f64;}
machine Main::main(main:&mut Main) reaches Console {
 let byte:ByteRead=block Console::read_byte();
 transition byte {ByteRead::Byte{value} -> compute(main,value) _ -> fail(main)}
 machine compute(main:&mut Main,value:i32) {
  main.value=F64::from_i32(value)-48.0;
  transition max(main.value,2.0) == 3.0 && abs_f64(main.value-1.0) <= 0.000000001 {
   true -> good(main) _ -> fail(main)
  }
 }
 machine good(main:&mut Main) {Console::exit_process(70);}
 machine fail(main:&mut Main) {Console::exit_process(71);}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
