use omega::language::core::float_operations;

machine scale(value: f32 in Trapping) -> f32 in Trapping
requires F32::is_finite((value as f32) * 2.00f32)
crashes Trap false {
    value * 2.0f32
}

machine finite_narrow(value: f64 in Trapping) -> f32 in Trapping
requires F32::is_finite(F32::from_f64(value as f64))
crashes Trap false {
    F32::from_f64(value)
}

machine closed_scale() -> f32 in Trapping
crashes Trap false {
    (1.5f32 as f32 in Trapping) * 2.0f32
}

// A Boolean wellness query does not adapt its qualified input value.
machine finite_qualified(value: f32 in Trapping)
requires F32::is_finite(value) {}

machine main() crashes Trap {
    finite_qualified(1.5f32 as f32 in Trapping);
    let result: f32 in Trapping = closed_scale();
    let scaled: f32 in Trapping = scale(1.5f32 as f32 in Trapping);
    let narrowed: f32 in Trapping = finite_narrow(2.5f64 as f64 in Trapping);
    let composed: f32 in Trapping = scale((0.75f32 * 2.0f32) as f32 in Trapping);
    transition result == 3.0f32 && scaled == 3.0f32 && narrowed == 2.5f32 && composed == 3.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
