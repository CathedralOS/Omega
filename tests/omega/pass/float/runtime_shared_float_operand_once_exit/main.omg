use omega_language_std::math;

// abs shares one normalized operand; distinct tick calls remain distinct.
use omega_language_std::console;
use omega::language::core::float_operations;
data Values {value:f64;}
data Main {values:Values;}
machine tick(values:&mut Values)->f64 {
 values.value=values.value+1.0;
 values.value
}
machine Main::main(main:&mut Main) reaches Console {
 let byte:ByteRead=block Console::read_byte();
 transition byte {ByteRead::Byte{value} -> shared(main,value) _ -> fail(main)}
 machine shared(main:&mut Main,value:i32) {
  main.values.value=F64::from_i32(value)-49.0;
  let result:f64=abs_f64(tick(&mut main.values));
  transition result == 1.0 && main.values.value == 1.0 {
   true -> distinct(main) _ -> fail(main)
  }
 }
 machine distinct(main:&mut Main) {
  let result:f64=max_f64(tick(&mut main.values),tick(&mut main.values));
  transition result == 3.0 && main.values.value == 3.0 {
   true -> good(main) _ -> fail(main)
  }
 }
 machine good(main:&mut Main) {Console::exit_process(70);}
 machine fail(main:&mut Main) {Console::exit_process(71);}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
