// Expected exit: 0. Whole primitive observations retain their exact IEEE
// format; capturing a NaN's bits does not make its IEEE comparison reflexive.
use omega::language::core::float_operations;

machine nonnegative64(value: &f64) -> bool
requires value >= 0.0 {
    value >= 0.0
}
machine nonnegative32(value: &f32) -> bool
requires value >= 0.0f32 {
    value >= 0.0f32
}
machine reflexive(value: &f64) -> bool { value == value }

machine main() crashes Trap {
    let wide: f64 = 2.5;
    let narrow: f32 = 2.5f32;
    let nan: f64 = 0.0f64 / 0.0;
    let negative_zero: f64 = -0.0;
    transition nonnegative64(&wide) && nonnegative32(&narrow)
        && !reflexive(&nan) && negative_zero == 0.0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
