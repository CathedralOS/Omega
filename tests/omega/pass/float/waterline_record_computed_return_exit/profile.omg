// Vertical gate silhouette: width is linear between adjacent elevations.
// Nodes are validated before clipping; a zero width is a legitimate tip.
use omega::language::core::float_operations;

public data Node [copy] { elevation: f64; width: f64; }
public data Profile { nodes: [Node; 8]; count: u64 in Wrapping; }
public data WetSegment [copy] {
    lower: f64; upper: f64; lower_width: f64; upper_width: f64;
}

public machine clip(lower: Node, upper: Node, water: f64) -> WetSegment {
    transition water <= lower.elevation {
        true -> dry(lower.elevation)
        false -> choose_top(lower, upper, water)
    }
    machine dry(elevation: f64) -> WetSegment {
        WetSegment { lower: elevation, upper: elevation, lower_width: 0.0, upper_width: 0.0 }
    }
    machine choose_top(lower: Node, upper: Node, water: f64) -> WetSegment {
        transition water < upper.elevation {
            true -> partial(lower, upper, water)
            false -> full(lower, upper)
        }
    }
    machine partial(lower: Node, upper: Node, water: f64) -> WetSegment {
        let fraction: f64 = (water - lower.elevation) / (upper.elevation - lower.elevation);
        WetSegment { lower: lower.elevation, upper: water,
            lower_width: lower.width, upper_width: lower.width + fraction * (upper.width - lower.width) }
    }
    machine full(lower: Node, upper: Node) -> WetSegment {
        WetSegment { lower: lower.elevation, upper: upper.elevation,
            lower_width: lower.width, upper_width: upper.width }
    }
}
