// Frozen IEEE builtin oracle: unordered/equal comparisons pick the right
// operand; reciprocals distinguish the selected signed-zero payload.
use omega::language::core::float_operations;
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let nan32: f32 = 0.0f32 / 0.0f32;
    let nan64: f64 = 0.0f64 / 0.0f64;
    let min_first32: f32 = F32::minimum(nan32, 1.0f32) + 2.0f32;
    let max_second32: f32 = F32::maximum(1.0f32, nan32) + 2.0f32;
    let min_zero32: f32 = 1.0f32 / F32::minimum(0.0f32, F32::negate(0.0f32));
    let max_zero32: f32 = 1.0f32 / F32::maximum(0.0f32, F32::negate(0.0f32));
    let max_first64: f64 = F64::maximum(nan64, 1.0) + 2.0;
    let min_second64: f64 = F64::minimum(1.0, nan64) + 2.0;
    let min_zero64: f64 = 1.0 / F64::minimum(0.0, F64::negate(0.0));
    let max_zero64: f64 = 1.0 / F64::maximum(0.0, F64::negate(0.0));
    transition min_first32 == 3.0f32 && max_second32 != max_second32
        && min_zero32 < 0.0f32 && max_zero32 < 0.0f32
        && max_first64 == 3.0 && min_second64 != min_second64
        && min_zero64 < 0.0 && max_zero64 < 0.0 {
        true -> pass(main)
        false -> fail(main)
    }
    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main) { Console::exit_process(71); }
}
