use omega::language::core::float_operations;

machine scale(value: f32 in Trapping, allow: bool) -> f32 in Trapping
crashes Trap allow {
    transition allow {
        true -> risky(value)
        _ -> 0.0f32 as f32 in Trapping
    }
    machine risky(value: f32 in Trapping) -> f32 in Trapping {
        value * 2.0f32
    }
}

machine narrow(value: f64 in Trapping, allow: bool) -> f32 in Trapping
crashes Trap allow {
    transition allow {
        true -> risky(value)
        _ -> 0.0f32 as f32 in Trapping
    }
    machine risky(value: f64 in Trapping) -> f32 in Trapping {
        F32::from_f64(value)
    }
}

machine main() crashes Trap {
    let scaled: f32 in Trapping = scale(1.5f32 as f32 in Trapping, true);
    let skipped: f32 in Trapping = scale(1.5f32 as f32 in Trapping, false);
    let narrowed: f32 in Trapping = narrow(1.5f64 as f64 in Trapping, true);
    transition scaled == 3.0f32 && skipped == 0.0f32 && narrowed == 1.5f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
