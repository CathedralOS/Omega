use omega::language::core::float_operations;

machine finite_value(value: f32) -> f32
requires F32::is_finite(value) {
    value
}

machine finite_wide(value: f64) -> f64
requires F64::is_finite(value) {
    value
}

machine main() crashes Trap {
    let direct: f32 = finite_value(1i32 as f32);
    let computed: f32 = finite_value((1i32 + 2i32) as f32);
    let changed_carrier: f32 = finite_value((7i8 as i32) as f32);
    let rounded: f32 = finite_value(F32::from_i32(16777217i32));
    let unsigned: f64 = finite_wide(F64::from_u64(18446744073709551615u64));
    let wrapped: f32 = finite_value(((250u8 as u8 in Wrapping) + (10u8 as u8 in Wrapping)) as f32);
    transition direct == 1.0f32 && computed == 3.0f32
        && changed_carrier == 7.0f32 && rounded == 16777216.0f32
        && unsigned == 18446744073709551616.0f64 && wrapped == 4.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
