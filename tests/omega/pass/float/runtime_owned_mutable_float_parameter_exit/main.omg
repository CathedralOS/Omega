// Expected exit: 0.
use omega::language::core::float_operations;
data Context { fraction: f64; narrow: f32; source: f64; }
// The owned formal mutates its callee cell, leaving the caller snapshot intact.
machine advance(mut fraction: f64) -> f64 {
    fraction = fraction + 0.25;
    fraction
}
// Each named arrival owns a different formal, despite matching spelling.
machine advance32(mut fraction: f32) -> f32 {
    fraction = fraction + 0.125f32;
    transition { _ -> complete(fraction) }
    machine complete(mut fraction: f32) -> f32 {
        fraction = fraction + 0.125f32;
        fraction
    }
}
machine negative_zero(mut value: f64) -> f64 {
    value = -0.0;
    value
}
machine supplied() -> f64 { 0.25 }
machine main(context: &mut Context) crashes Trap {
    context.source = supplied();
    let observed: f64 = context.source;
    context.fraction = advance(observed);
    context.narrow = advance32(0.25f32);
    let signed_zero: f64 = negative_zero(context.source);
    transition context.fraction == 0.5 && context.narrow == 0.5f32
        && context.source == 0.25 && observed == 0.25
        && 1.0 / signed_zero < 0.0 {
        true -> done()
        false -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
