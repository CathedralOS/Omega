use omega::language::core::float_operations;
use omega_language_std::console;

// The selected declaration owns the result policy. A namespace that happens
// to be called F32 neither inherits its arguments' policy nor erases its result.
data F32 {}
boundary operator F32::qualify(value: f32) -> f32 in Saturating;

data Provider {}
machine Provider::qualify(value: f32) -> f32 in Saturating
satisfies F32::qualify
{
    value as f32 in Saturating
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: f32 in Saturating = F32::qualify(2.0f32);
    let computed: f32 in Saturating = (result * result) * (result as f32 in Saturating);
    transition computed == 8.0f32 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
