// Float match equality is semantic IEEE equality: `-0.0f32` matches the
// `0.0f32` pattern, and NaN matches NOTHING — a NaN subject falls to
// the wildcard even when every pattern is NaN itself.
use omega::language::core::float_operations;

machine choose32(value: f32, first: f32, second: f32) -> i64 {
    match value { first -> 7, second -> 9, _ -> 11 }
}

machine zeros32() -> i64 { choose32(-0.0f32, 0.0f32, 0.0f32) }

machine nan32() -> i64 {
    let value: f32 = 0.0f32 / 0.0f32;
    choose32(value, value, value)
}

data Main {}

machine Main::main(main: &mut Main) {
    transition zeros32() == 7 && nan32() == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
