use omega::language::core::float_operations;

// Both detached operands must retain the same source relation at invocation.
machine finite_product(left: f32 in Trapping, right: f32 in Trapping) -> f32 in Trapping
requires F32::is_finite((left as f32) * (right as f32))
crashes Trap false {
    left * right
}

// The closed operand has the same semantic value with a different spelling.
machine finite_scale(value: f32 in Trapping) -> f32 in Trapping
requires F32::is_finite((value as f32) * 2.00f32)
crashes Trap false {
    value * 2.0f32
}

machine main() {}
