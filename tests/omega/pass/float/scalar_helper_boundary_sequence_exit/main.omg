// A scalar helper sequences ordinary calls, locals and boundary operations.
// Its result returns to an ordinary caller; no helper name or source pattern
// grants the floating-point applications a checked body.
use omega::language::core::float_operations;
use omega_language_std::console;

machine marker(value: i32) -> i32 { value }

machine shifted_product(value: f32) -> f32 {
    let scale: f32 = 2.0f32;
    let product: f32 = value * scale;
    let offset: i32 = marker(7);
    let shifted: f32 = product - F32::from_i32(offset);
    shifted
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let result: f32 = shifted_product(3.0f32);
    transition result == -1.0f32 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
