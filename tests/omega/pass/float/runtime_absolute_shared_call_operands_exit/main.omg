use omega_language_std::math;

// The std package route binds float operators to boundary calls. The shared
// operand of absolute value must finish once across those call actuals.
use omega::language::core::float_operations;
use omega_language_std::console;
data Counter { calls: u32 in Wrapping; voltage: f64; }
data Main { counter: Counter; positive: f64; }
machine step(counter: &mut Counter) -> f64 {
    counter.calls = counter.calls + 1u32;
    counter.voltage
}
machine Main::main(main: &mut Main) reaches Console {
    main.counter.calls = 0u32;
    main.counter.voltage = -3.0;
    main.positive = 4.0;
    let magnitude: f64 = abs_f64(step(&mut main.counter) - 2.0);
    let positive: f64 = abs_f64(main.positive - 1.0);
    transition magnitude == 5.0 && positive == 3.0 && main.counter.calls == 1u32 {
        true -> pass(main)
        false -> fail(main)
    }
    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main) { Console::exit_process(71); }
}
