// Expected exit: 0
// Psi checks both bodies; Linux realizes only its ordinary integer body.
// A fused operation in the unselected Windows body supplies no Linux ISA demand.
use omega::language::core::float_operations;

boundary trait SelectedSelectedValue {
    machine selected_value() -> i32 reaches
;
}
LinuxX8664SelectedValue satisfies SelectedSelectedValue {
    machine selected_value() -> i32
{ 7 }
}

WindowsX8664SelectedValue satisfies SelectedSelectedValue {
    machine selected_value() -> i32
{
    let value: f64 = F64FusedMultiplyAdd::fused_multiply_add(2.0, 3.0, 1.0);
    transition value == 7.0 {
        true -> correct()
        false -> incorrect()
    }
    machine correct() -> i32 { 7 }
    machine incorrect() -> i32 { 9 }
}
}

machine main() crashes Trap {
    transition SelectedSelectedValue::selected_value() == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
