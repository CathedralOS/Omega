use omega_language_std::math;

// Nested float operator applications compose in authored grouping and order
// (exit 70).
//
// Every operand is a field read, so each application executes at run time.
// With a = 3, b = 4, c = 2 and tenth = 0.1:
//   a * b + c        = 14   (a * (b + c) would be 18)
//   a * (b + c)      = 18   (a * b + c would be 14)
//   c - a * b        = -10  (swapped operands would give 10)
//   a / (b - c)      = 1.5  (swapped operands would give 0.666...)
//   tenth * 3 - 0.3  = 2^-54 exactly: the product rounds to
//                      0.30000000000000004 before the subtraction. A fused
//                      multiply-add would keep the exact product and give
//                      a different result, so this pins two roundings.
//   F64::from_i32(count) * 0.5 + c = 3.5 with count = 3: a named conversion
//                      operator nested under two arithmetic applications.
//   min(a * b, 11.5) = 11.5 and F64::maximum(c - a, 0.5) = 0.5: named
//                      operators (shorthand and explicit) whose outer
//                      application takes a nested operand and a literal.
// The first two are local initializers, the next two are field stores, the
// next two are guard operands, then local initializers and a field store.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    a: f64;
    b: f64;
    c: f64;
    tenth: f64;
    count: i32;
    difference: f64;
    quotient: f64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = 3.0;
    main.b = 4.0;
    main.c = 2.0;
    main.tenth = 0.1;
    main.count = 3;
    let product_sum: f64 = main.a * main.b + main.c;
    transition product_sum == 14.0 {
        true -> grouped(main)
        _ -> fail(main, 71)
    }

    state grouped(main: &mut Main) {
        let grouped_product: f64 = main.a * (main.b + main.c);
        transition grouped_product == 18.0 {
            true -> field_stores(main)
            _ -> fail(main, 72)
        }
    }

    state field_stores(main: &mut Main) {
        main.difference = main.c - main.a * main.b;
        main.quotient = main.a / (main.b - main.c);
        transition main.difference == -10.0 {
            true -> quotient_check(main)
            _ -> fail(main, 73)
        }
    }

    state quotient_check(main: &mut Main) {
        transition main.quotient == 1.5 {
            true -> guards(main)
            _ -> fail(main, 74)
        }
    }

    state guards(main: &mut Main) {
        transition main.a * main.b + main.c == 14.0 {
            true -> rounding(main)
            _ -> fail(main, 75)
        }
    }

    state rounding(main: &mut Main) {
        transition main.tenth * 3.0 - 0.3 == 0.000000000000000055511151231257827021181583404541015625 {
            true -> conversions(main)
            _ -> fail(main, 76)
        }
    }

    state conversions(main: &mut Main) {
        let converted: f64 = F64::from_i32(main.count) * 0.5 + main.c;
        transition converted == 3.5 {
            true -> extrema(main)
            _ -> fail(main, 77)
        }
    }

    state extrema(main: &mut Main) {
        let bounded: f64 = F64::maximum(main.c - main.a, 0.5);
        main.difference = min_f64(main.a * main.b, 11.5);
        transition main.difference == 11.5 && bounded == 0.5 {
            true -> pass(main)
            _ -> fail(main, 78)
        }
    }

    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
