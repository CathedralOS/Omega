use omega::language::core::float_operations;

data Counter { calls: u32 in Wrapping; }

machine sample(counter: &mut Counter) -> f64 in Finite {
    counter.calls = counter.calls + 1u32;
    3.75
}

machine unqualified_sample(counter: &mut Counter) -> f64 {
    sample(counter) as f64
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { calls: 0u32 };
    let first: f64 = sample(&mut counter) as f64;
    let second: f64 = unqualified_sample(&mut counter);
    let calls: u32 in Wrapping = counter.calls;
    transition first == 3.75 && second == 3.75 && calls == 2u32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
