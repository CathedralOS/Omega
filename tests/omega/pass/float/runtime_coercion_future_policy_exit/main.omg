use omega::language::core::float_operations;

machine wrapped(source: f64) -> u8 {
    transition source == 255.0 { true -> convert(source) false -> unused() }
    machine convert(source: f64) -> u8 {
        let value: u8 in Wrapping = source as u8 in Wrapping;
        (value + 1) as u8
    }
    machine unused() -> u8 { 0 }
}
machine clamped() -> u8 {
    let source: f64 = 255.0;
    let value: u8 in Saturating = source as u8 in Saturating;
    (value + 1) as u8
}
machine trapped() -> i32 {
    let value: i32 in Trapping = 3.0f64 as i32 in Trapping;
    (value + 1) as i32
}
machine narrow() -> f32 {
    let value: f32 in Saturating = 3.0f64 as f32 in Saturating;
    value as f32
}

machine main() crashes Trap {
    let wrapping: u8 = wrapped(255.0);
    let saturating: u8 = clamped();
    let trapping: i32 = trapped();
    let narrowed: f32 = narrow();
    transition wrapping == 0 && saturating == 255 && trapping == 4
        && narrowed == 3.0f32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
