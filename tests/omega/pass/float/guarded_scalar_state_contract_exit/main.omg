use omega::language::core::float_operations;

// Complete executable reproduction of the state-contract lowering provision.
// The ordinary checked guard establishes the same authored arrival contract.
machine bounded_integer(value: f64) -> i64 {
    transition value == value && value >= -100.0 && value <= 100.0 {
        true -> bounded(value)
        false -> rejected()
    }
    machine bounded(value: f64) -> i64
    requires value == value && value >= -100.0 && value <= 100.0
    {
        let converted: i64 = I64::from_f64(value);
        transition { _ -> (converted) }
    }
    machine rejected() -> i64 { transition { _ -> (0) } }
}

// A preceding Boolean formal distinguishes authored from dense subject indices;
// f32, strict bounds and inequality retain their own IEEE relation meanings.
machine bounded_single(accepted: bool, value: f32) -> f32 {
    transition accepted && value != 0.0f32 && value < 10.0f32 && value > -10.0f32 {
        true -> bounded(accepted, value)
        false -> rejected()
    }
    machine bounded(accepted: bool, value: f32) -> f32
    requires accepted && value != 0.0f32 && value < 10.0f32 && value > -10.0f32
    { transition { _ -> (value) } }
    machine rejected() -> f32 { transition { _ -> (0.0f32) } }
}

machine main() crashes Trap {
    let positive: i64 = bounded_integer(2.5);
    let negative: i64 = bounded_integer(-2.5);
    let outside: i64 = bounded_integer(101.0);
    let zero_double: f64 = 0.0;
    let one_double: f64 = 1.0;
    let unordered: i64 = bounded_integer(zero_double / zero_double);
    let infinite: i64 = bounded_integer(one_double / zero_double);
    let single: f32 = bounded_single(true, 1.5f32);
    let zero: f32 = bounded_single(true, 0.0f32);
    let refused: f32 = bounded_single(false, 1.5f32);
    transition positive == 2 && negative == -2 && outside == 0 && unordered == 0 && infinite == 0
        && single == 1.5f32 && zero == 0.0f32 && refused == 0.0f32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
