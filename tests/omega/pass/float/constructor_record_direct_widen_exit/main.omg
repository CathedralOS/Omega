use omega::language::core::numeric_conversion;
public data Choice requires self.value >= 0 && self.value <= 255 { value: i32; }
public machine make(value: u8) -> Choice {  Choice { value: value as i32 } }
machine main() crashes Trap { let result: Choice = make(42u8); transition { _ -> inspect(result.value) } machine inspect(value: i32) { transition value == 42 { true -> done() false -> bad() } } machine done() {} machine bad() { crash Trap; } }
