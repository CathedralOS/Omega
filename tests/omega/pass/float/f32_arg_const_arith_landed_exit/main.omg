use omega::language::core::float_operations;

// F2c ARG face, reconciled with the exact-anonymous-constant law: a wholly
// anonymous constant tree stays exact Rat until the transition parameter is
// its first typed destination, then rounds ONCE to f32. Here x is just above
// 2^-24, so exact `1 + x` rounds UP to 1 + 2^-23. This deliberately differs
// from an explicitly f32-landed/runtime tree, whose operations round per-op.
// Guards the validation argument landing (target params zipped with args).
use omega_language_std::console;
data Main { expected: f32; }
machine Main::main(main: &mut Main) reaches Console {
    main.expected = 1.00000011920928955078125;
    transition { _ -> check(main, 1.0 + 0.0000000596046483281043038005) }
    state check(main: &mut Main, got: f32) {
        // Unlike argument landing above, `as` must preserve denotation. This
        // anonymous sum is exactly representable and needs no provisional f64.
        let cast: f32 = (1.0 + 0.00000011920928955078125) as f32;
        transition got == main.expected && cast == main.expected {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main)  { Console::exit_process(71); }
}
