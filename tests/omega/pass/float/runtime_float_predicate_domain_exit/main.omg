// A finite ordered subtraction establishes an f64 predicate domain, and a
// landed literal establishes a weaker bound. Exit 70.
use omega::language::core::float_operations;
use omega_language_std::console;

domain f64::NonnegativeMass(value)
requires value >= 0.0;

domain f64::AdmissibleTotal(value)
requires value >= 0.01;

machine corrected(gross: f64, tare: f64) -> f64 in NonnegativeMass
requires F64::is_finite(gross) && F64::is_finite(tare) && gross >= tare
{
    gross - tare
}

machine fraction(mass: f64 in NonnegativeMass, total: f64 in AdmissibleTotal) -> f64 {
    mass / total
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let total: f64 in AdmissibleTotal = 6.0;
    let mass: f64 in NonnegativeMass = corrected(3.0, 1.0);
    let share: f64 = fraction(mass, total);
    transition mass == 2.0 && share == 2.0 / 6.0 {
        true -> done(main)
        false -> bad(main)
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
