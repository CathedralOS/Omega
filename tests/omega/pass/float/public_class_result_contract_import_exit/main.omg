use omega::language::core::FloatClass;
use omega::language::core::F32::classify;
machine category(value: f32) -> FloatClass
ensures result == F32::classify(value) {
    F32::classify(value)
}
machine main() crashes Trap {
    let observed: FloatClass = category(1.0f32);
    transition observed {
        FloatClass::Normal { negative: false } -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
