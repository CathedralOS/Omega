use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
    maximum: f32 in Trapping;
    two: f32 in Trapping;
    result: f32 in Trapping;
}
machine Main::main(&mut self) reaches Console {
    self.maximum = 340282346638528859811704183484516925440.0;
    self.two = 2.0;
    self.result = self.maximum * self.two;
    self.console.exit_process(70);
}
