// A finite lower cutpoint traps; (-129, -128) still truncates into i8.
use omega::language::core::float_operations;
use omega::language::core::process_exit;
use omega_language_std::process_exit;
use omega_language_std::console;

data Main {
    value: f32;
}

machine Main::main(main: &mut Main) reaches Console + ProcessExit {
    Console::write_line("before lower boundary trap");
    main.value = -129.0f32;
    let converted: i8 in Trapping = I8::from_f32(main.value);
    ProcessExit::exit_process(converted as i8 as i32);
}
