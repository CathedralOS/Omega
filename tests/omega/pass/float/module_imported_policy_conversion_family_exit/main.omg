// A domain module imports result-policy overloads; a root import must not
// turn the core provider's visible conversion family into a missing target.
use omega_language_std::console;
use conversion;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let result: i32 in Saturating = conversion::convert(2.0);
    Console::exit_process(&main.console, result as i32);
}
