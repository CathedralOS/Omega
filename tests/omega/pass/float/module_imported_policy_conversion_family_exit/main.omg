// A domain module imports result-policy overloads; a root import must not
// turn the core provider's visible conversion family into a missing target.
use omega_language_std::console;
use conversion;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: i32 in Saturating = conversion::convert(2.0);
    Console::exit_process(result as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
