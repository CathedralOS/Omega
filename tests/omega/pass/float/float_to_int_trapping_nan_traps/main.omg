use omega::language::core::float_operations;

// A named Trapping conversion rejects NaN rather than inheriting an ISA sentinel.
use omega_language_std::console;
data Main { value: f64; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.value = 0.0f64 / 0.0;
    let converted: i32 in Trapping = I32::from_f64(main.value);
    main.out = converted as i32;
    Console::exit_process(70);
}
machine Main::run(main: &mut Main) { Main::main(main); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
