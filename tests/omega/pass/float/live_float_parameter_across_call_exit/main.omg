use omega::language::core::float_operations;

data Checksum { count: i32 in Saturating; }

machine touch(sink: &mut Checksum) { sink.count = sink.count + 1; }

machine carry(value: f64, sink: &mut Checksum) -> f64 {
    touch(sink);
    (value + 1.0)
}

machine main() crashes Trap {
    let mut sink: Checksum;
    let observed: f64 = carry(41.5, &mut sink);
    transition observed == 42.5 && sink.count == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
