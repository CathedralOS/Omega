use omega::language::core::float_operations;

data Observations { half: bool; rounded: bool; }
machine widen(value: f32) -> f64 { value as f64 }

machine half(value: f64, calls: &mut u64) -> f64 {
    calls = ((calls as u64 in Wrapping) + 1) as u64;
    value / 2.0
}

machine identity(value: f32) -> f32 { value }

machine select(enabled: bool, calls: &mut u64) -> bool {
    enabled && half(1.0, &mut calls) == 0.5
}

machine compare(value: f64, calls: &mut u64) -> Observations {
    Observations {
        half: half(value, &mut calls) == 0.5,
        rounded: identity(16777216.0f32) == 16777216.0 + 1.0
    }
}

machine main() crashes Trap {
    let mut calls: u64 = 0;
    let observed: Observations = compare(1.0, &mut calls);
    let skipped: bool = select(false, &mut calls);
    let selected: bool = select(true, &mut calls);
    let returned_format: bool = widen(0.5f32) == 0.5;
    let retained: bool = (identity(16777216.0f32) as f64) == 16777217.0;
    transition observed.half && observed.rounded && skipped == false && selected && calls == 2
        && returned_format && retained == false {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
