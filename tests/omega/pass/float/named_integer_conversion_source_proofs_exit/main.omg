use omega::language::core::float_operations;

// Named truncation accepts a field's default-domain bound and an incoming
// guard that proves non-NaN plus both range bounds. Exact `as` cannot truncate.
// The data clause preserves
// the former field suffix's [0.0..=100.0] contract without a range type.
use omega_language_std::console;
data Main where bounded >= 0.0 && bounded <= 100.0 {
    bounded: f64;
    unbounded: f64;
    a: i32;
    b: i32;
}
machine Main::main(main: &mut Main) reaches Console {
    main.bounded = 77.9;
    main.a = I32::from_f64(main.bounded);
    main.unbounded = 42.5;
    transition main.unbounded == main.unbounded
        && main.unbounded >= 0.0 && main.unbounded <= 100.0 {
        true -> guarded(main)
        _ -> bad(main)
    }
    state guarded(main: &mut Main) {
        main.b = I32::from_f64(main.unbounded);
        transition main.a == 77 && main.b == 42 { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) { Console::exit_process(78); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
machine Main::run(main: &mut Main) { Main::main(main); }
