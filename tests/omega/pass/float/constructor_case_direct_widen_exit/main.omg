use omega::language::core::numeric_conversion;
public data Choice requires (self in Choice::Eof) || ((self in Choice::Byte) && self.value >= 0 && self.value <= 255) { case Eof; case Byte(value: i32); }
public machine make(value: u8) -> Choice {  Choice::Byte { value: value as i32 } }
machine main() crashes Trap { let result: Choice = make(42u8); transition result { Choice::Byte { value } -> inspect(value) Choice::Eof -> bad() } machine inspect(value: i32) { transition value == 42 { true -> done() false -> bad() } } machine done() {} machine bad() { crash Trap; } }
