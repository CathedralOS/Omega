// An explicit format conversion gives comparisons one selected operand format.
use omega::language::core::float_operations;
machine direct(left: f64, right: f32) -> bool {
    let wide: f64 = F64::from_f32(right);
    left == wide
}
machine guarded(left: f64, right: f32) -> bool {
    transition left < F64::from_f32(right) { true -> true _ -> false }
}
machine literal(value: f64) -> bool { value == 7.0f64 }
machine reversed(value: f32) -> bool { 7.0f32 >= value }
