// F7 exact two-rounding realization for named multiply-then-add plans.
// For each format, (1 + ulp)^2 has a positive residual below one result ulp.
// Rounding the product before adding its rounded cancellation produces zero;
// a fused operation would preserve a positive residual.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    result32: f32;
    result64: f64;
    maximum32: f32 in Saturating;
    two32: f32 in Saturating;
    zero32: f32 in Saturating;
    overflow32: f32;
}

machine Main::main(main: &mut Main) reaches Console {
    let next32: f32 = 1.00000011920928955078125;
    let cancel32: f32 = 0.0f32 - 1.0000002384185791015625;
    // Exercise MTA below another arithmetic root as well as in the direct
    // f64/overflow writes below.
    main.result32 = F32::multiply_then_add(next32, next32, cancel32) + 0.0f32;

    let next64: f64 = 1.0000000000000002220446049250313080847263336181640625;
    let cancel64: f64 =
        0.0 - 1.000000000000000444089209850062616169452667236328125;
    main.result64 = F64::multiply_then_add(next64, next64, cancel64);

    main.maximum32 = 340282346638528859811704183484516925440.0;
    main.two32 = 2.0;
    main.zero32 = 0.0;
    // The named requirement declares bare f32 operands/result. Erase operand
    // policy explicitly; neither those fields nor the destination can request
    // a different provider contract. Finite-input overflow remains infinity.
    main.overflow32 = F32::multiply_then_add(
        main.maximum32 as f32, main.two32 as f32, main.zero32 as f32
    );

    transition main.result32 == 0.0f32 {
        true -> check64(main)
        _ -> fail(main, 71)
    }

    state check64(main: &mut Main) {
        transition main.result64 == 0.0 {
            true -> check_overflow32(main)
            _ -> fail(main, 72)
        }
    }

    state check_overflow32(main: &mut Main) {
        transition main.overflow32 > (main.maximum32 as f32) {
            true -> good(main)
            _ -> fail(main, 73)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
