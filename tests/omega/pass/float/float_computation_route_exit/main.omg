// The reduced float-computation matrix routes without importing
// omega::language::core::float_operations: a copy, an integer comparison, float
// arithmetic, a float ordered comparison and float equality all execute. The
// matrix computes d = 4.0 with flag = false; exit 1 is the authored result and
// exit 2 is a wrong observation.
use omega_language_std::console;
data Main {
    d: f64;
    e: f64;
    flag: bool;
    n: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.n = 7;
    main.e = 2.0;
    main.d = main.e;
    main.flag = main.n > 5;
    main.d = main.d + main.e;
    main.flag = main.d > 211.5;
    main.flag = main.d == main.e;
    transition main.d == 4.0 && main.flag == false {
        true -> authored(main)
        false -> wrong(main)
    }
    machine authored(main: &mut Main) { Console::exit_process(1); }
    machine wrong(main: &mut Main) { Console::exit_process(2); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
