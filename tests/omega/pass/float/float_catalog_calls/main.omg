use omega_language_std::math;

// Float requirement calls are catalog-addressable:
// `F32::square_root(64.0f32)` selects the format even with anonymous
// operands; the bare `min`/`max`/`sqrt` shorthand runs the same
// requirement call — including in comparisons on EITHER side and in
// nested operands.
use omega::language::core::float_operations;
machine f32_result() -> bool {
    F32::square_root(64.0f32) == 8.0
}
data Main {
    low32: f32;
    high32: f32;
    root64: f64;
}
machine Main::main(main: &mut Main) {
    main.low32 = min_f32(4.0f32, 9.0f32);
    main.high32 = max_f32(4.0f32, 9.0f32);
    main.root64 = sqrt_f64(64.0);
    let forward: bool = F32::square_root(64.0f32) == 8.0;
    let reverse: bool = 8.0 == F64::square_root(64.0f64);
    let nested: bool = f32_result() && F32::square_root(64.0f32) < 9.0;
}
