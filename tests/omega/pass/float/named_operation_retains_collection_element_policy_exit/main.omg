use omega::language::core::float_operations;

machine qualify(value: f32) -> f32 in Saturating {
    value as f32 in Saturating
}

machine main() crashes Trap {
    let values: [f32; 1] in Saturating = [(3.4028234663852886e38f32 as f32 in Saturating)];
    let nested: [[f32; 1]; 1] in Saturating = [[(3.4028234663852886e38f32 as f32 in Saturating)]];
    let direct: f32 in Saturating = F32::multiply_then_add(values[0], 2.0f32, 0.0f32);
    let indirect: f32 in Saturating = F32::multiply_then_add(nested[0][0], 2.0f32, 0.0f32);
    // Prepared token calls and ordinary calls share computed result typing;
    // the raw multiply signature must not erase the selected operand policy.
    let operand: f32 in Saturating = qualify(2.0f32);
    let composed: f32 in Saturating = (operand * operand) * (operand as f32 in Saturating);
    transition direct == 3.4028234663852886e38f32
        && indirect == 3.4028234663852886e38f32 && composed == 8.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
