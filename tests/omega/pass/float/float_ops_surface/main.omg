// `use omega::language::core::float_operations` makes primitive f32/f64
// spellings resolve to named Float requirements: `+ - * /` arithmetic
// and `== != <` comparisons both participate; field stores carry f32.
use omega::language::core::float_operations;

data Main {
    left32: f32; right32: f32; sum32: f32; quotient32: f32;
    left64: f64; right64: f64; product64: f64;
}

machine Main::main(main: &mut Main) {
    main.left32 = 6.0;
    main.right32 = 2.0;
    main.sum32 = main.left32 + main.right32;
    main.quotient32 = main.left32 / main.right32;
    main.left64 = 9.0;
    main.right64 = 3.0;
    main.product64 = main.left64 * main.right64;
    transition main.sum32 == 8.0
        && main.quotient32 == 3.0
        && main.product64 == 27.0
        && main.left32 != main.right32
        && main.right32 < main.left32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
