// The named Trapping overload must reject NaN before producing an integer.
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::service;

data Main { console: Binding<Console>; }

machine Main::main(&mut self) reaches Console {
    let nan: f64 = 0.0f64 / 0.0;
    let trapped: i32 in Trapping = I32::from_f64(nan);
    self.console.exit_process(trapped as i32);
}
