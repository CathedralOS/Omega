use omega::language::core::float_operations;

machine widened(value: i16) -> f32 {
    let selected: f32 in Saturating = value as f32 in Saturating;
    selected as f32
}

machine guarded(value: i64) -> f64 {
    let allowed: bool = value == 18014398509481984i64;
    transition allowed {
        true -> convert(value)
        false -> unused()
    }
    machine convert(value: i64) -> f64 {
        let selected: f64 in Trapping = value as f64 in Trapping;
        selected as f64
    }
    machine unused() -> f64 { 0.0f64 }
}

machine bounded(value: i32) -> f32
requires value >= -16777216 && value <= 16777216
{ value as f32 }

data Sample { value: i32; }
machine observe(sample: &Sample) -> f64 {
    sample.value as f64 in Wrapping as f64
}

machine main() crashes Trap {
    let small: f32 = widened(3i16);
    let large: f64 = guarded(18014398509481984i64);
    let low: f32 = bounded(-16777216);
    let high: f32 = bounded(16777216);
    let magnitude: u64 = 9223372036854775808u64;
    let unsigned: f64 = magnitude as f64;
    let rounded: f64 = F64::from_i64(9007199254740993i64);
    let sample: Sample = Sample { value: -7 };
    let field: f64 = observe(&sample);
    transition small == 3.0f32 && large == 18014398509481984.0f64
        && low == -16777216.0f32 && high == 16777216.0f32
        && unsigned == 9223372036854775808.0f64
        && rounded == 9007199254740992.0f64 && field == -7.0f64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
