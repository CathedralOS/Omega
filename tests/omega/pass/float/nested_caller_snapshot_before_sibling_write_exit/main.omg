// Expected exit: 0.
// Valid: a nested invocation captures actuals after preceding siblings.
data Cell { value: f64; }
machine overwrite_nan(cell: &mut Cell) -> u64 {
    cell.value = 0.0f64 / 0.0f64;
    0u64
}
machine demand(value: f64) -> u64 requires value == value { 0u64 }
machine forward(value: f64) -> u64 {
    let unused: bool = match true { true -> true false -> false };
    demand(value)
}
machine consume(first: u64, second: u64) -> u64 { 0u64 }
machine main() {
    let mut cell: Cell = Cell { value: 7.0f64 };
    let result: u64 = consume(forward(cell.value), overwrite_nan(&mut cell));
}
