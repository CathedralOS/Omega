// Owned local fields retain their scalar computation and call ownership.
// Both float carriers, direct calls, arithmetic, and later dense scalar locals
// must compose. Exit 70 witnesses all values; an incorrect store exits 71.
use omega::language::core::float_operations;
use omega_language_std::console;
data Pair [copy] { wide: f64; narrow: f32; }
data Main { }
machine make64(value: f64) -> f64 { value * 2.0 }
machine make32(value: f32) -> f32 { value + 1.5f32 }
machine Main::main(main: &mut Main) reaches Console {
    let mut local: Pair;
    local.wide = make64(3.0);
    local.narrow = make32(2.0f32);
    local.wide = local.wide + 1.0;
    let later: f64 = 8.0;
    transition local.wide == 7.0 && local.narrow == 3.5f32 && later == 8.0 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
