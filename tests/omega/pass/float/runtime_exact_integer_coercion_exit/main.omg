use omega::language::core::float_operations;

machine sample() -> f64 ensures result == 3.0 { 3.0 }
machine exact() -> i32 ensures result == 3 { sample() as i32 }
machine fraction() -> f64 ensures result == 3.75 { 3.75 }
machine truncate() -> i32 ensures result == 3 { I32::from_f64(fraction()) }

machine guarded(value: f64) -> i32 {
    transition value == 3.0 { true -> convert(value) false -> unused() }
    machine convert(value: f64) -> i32 { value as i32 }
    machine unused() -> i32 { 0 }
}

// Every binary64 value in this interval is integral, not just its endpoints.
machine large_integer(value: f64) -> i64
requires value >= 4503599627370496.0 && value <= 4503599627370498.0
{
    value as i64
}

machine main() crashes Trap {
    let value: i32 = exact();
    let truncated: i32 = truncate();
    let observed: i32 = guarded(3.0);
    let large: i64 = large_integer(4503599627370496.0);
    transition value == 3 && truncated == 3 && observed == 3
        && large == 4503599627370496i64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
