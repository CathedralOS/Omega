use omega_language_std::console;
use omega::language::core::float_operations;
machine retain(value: f32 in Finite) -> f32 in Finite {
    transition { _ -> (value) }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: f32 in Finite = retain(0.5);
    transition result == 0.5 { true -> good() _ -> bad() }
    state good() { Console::exit_process(77); }
    state bad() { Console::exit_process(78); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
