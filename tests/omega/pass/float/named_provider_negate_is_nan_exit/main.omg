// F7 exact primitive-expression realizations for named float ProviderPlans.
// Negation preserves the selected named-use root while flipping every sign,
// including signed zero. NaN classification uses the compiler's unary,
// single-evaluation unordered predicate.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    negative_zero32: f32;
    positive_zero32: f32;
    negative_infinity32: f32;
    negative_zero_reciprocal32: f32;
    positive_zero_reciprocal32: f32;
    nan_verdict32: bool;
    infinity_verdict32: bool;
    finite_verdict32: bool;
    negative_zero64: f64;
    positive_zero64: f64;
    negative_infinity64: f64;
    negative_zero_reciprocal64: f64;
    positive_zero_reciprocal64: f64;
    nan_verdict64: bool;
    infinity_verdict64: bool;
    finite_verdict64: bool;
}

machine Main::main(main: &mut Main) reaches Console {
    let zero32: f32 = 0.0f32;
    let nan32: f32 = zero32 / zero32;
    let infinity32: f32 = 1.0f32 / zero32;
    main.negative_zero32 = F32::negate(zero32);
    main.positive_zero32 = F32::negate(main.negative_zero32);
    main.negative_infinity32 = F32::negate(infinity32);
    main.nan_verdict32 = F32::is_nan(nan32);
    main.infinity_verdict32 = F32::is_nan(infinity32);
    main.finite_verdict32 = F32::is_nan(1.0f32);
    main.negative_zero_reciprocal32 = 1.0f32 / main.negative_zero32;
    main.positive_zero_reciprocal32 = 1.0f32 / main.positive_zero32;

    let zero64: f64 = 0.0;
    let nan64: f64 = zero64 / zero64;
    let infinity64: f64 = 1.0 / zero64;
    main.negative_zero64 = F64::negate(zero64);
    main.positive_zero64 = F64::negate(main.negative_zero64);
    main.negative_infinity64 = F64::negate(infinity64);
    main.nan_verdict64 = F64::is_nan(nan64);
    main.infinity_verdict64 = F64::is_nan(infinity64);
    main.finite_verdict64 = F64::is_nan(1.0);
    main.negative_zero_reciprocal64 = 1.0 / main.negative_zero64;
    main.positive_zero_reciprocal64 = 1.0 / main.positive_zero64;

    transition main.negative_zero_reciprocal32 < 0.0f32 {
        true -> check_positive_zero32(main)
        _ -> fail(main, 71)
    }

    state check_positive_zero32(main: &mut Main) {
        transition main.positive_zero_reciprocal32 > 0.0f32 {
            true -> check_infinity32(main)
            _ -> fail(main, 72)
        }
    }
    state check_infinity32(main: &mut Main) {
        transition main.negative_infinity32 < 0.0f32 {
            true -> check_nan32(main)
            _ -> fail(main, 73)
        }
    }
    state check_nan32(main: &mut Main) {
        transition main.nan_verdict32 { true -> check_infinity_not_nan32(main) _ -> fail(main, 74) }
    }
    state check_infinity_not_nan32(main: &mut Main) {
        transition main.infinity_verdict32 == false {
            true -> check_finite_not_nan32(main)
            _ -> fail(main, 75)
        }
    }
    state check_finite_not_nan32(main: &mut Main) {
        transition main.finite_verdict32 == false {
            true -> check_negative_zero64(main)
            _ -> fail(main, 76)
        }
    }
    state check_negative_zero64(main: &mut Main) {
        transition main.negative_zero_reciprocal64 < 0.0 {
            true -> check_positive_zero64(main)
            _ -> fail(main, 77)
        }
    }
    state check_positive_zero64(main: &mut Main) {
        transition main.positive_zero_reciprocal64 > 0.0 {
            true -> check_infinity64(main)
            _ -> fail(main, 78)
        }
    }
    state check_infinity64(main: &mut Main) {
        transition main.negative_infinity64 < 0.0 {
            true -> check_nan64(main)
            _ -> fail(main, 79)
        }
    }
    state check_nan64(main: &mut Main) {
        transition main.nan_verdict64 { true -> check_infinity_not_nan64(main) _ -> fail(main, 80) }
    }
    state check_infinity_not_nan64(main: &mut Main) {
        transition main.infinity_verdict64 == false {
            true -> check_finite_not_nan64(main)
            _ -> fail(main, 81)
        }
    }
    state check_finite_not_nan64(main: &mut Main) {
        transition main.finite_verdict64 == false {
            true -> good(main)
            _ -> fail(main, 82)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
