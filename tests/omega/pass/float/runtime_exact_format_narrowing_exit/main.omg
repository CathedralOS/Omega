use omega::language::core::float_operations;

machine sample() -> f64[3.75..=3.75] { 3.75 }
machine narrowed() -> f32[3.75..=3.75] { sample() as f32 }
machine narrow_parameter(value: f64[-3.75..=-3.75]) -> f32[-3.75..=-3.75] {
    value as f32
}
machine retained_binary32(value: f64[0.1f32..=0.1f32]) -> f32 {
    value as f32
}

machine main() crashes Trap {
    let value: f32[3.75..=3.75] = narrowed();
    let negative: f32[-3.75..=-3.75] = narrow_parameter(-3.75);
    let retained: f32 = retained_binary32(0.1f32 as f64);
    transition value == 3.75f32 && negative == -3.75f32 && retained == 0.1f32 {
        true -> done() false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
