use omega::language::core::float_operations;

machine sample() -> f64 ensures result == 3.75 { 3.75 }
machine narrowed() -> f32 ensures result == 3.75f32 { sample() as f32 }
machine narrow_parameter(value: f64) -> f32
requires value == -3.75
ensures result == -3.75f32
{
    value as f32
}
machine retained_binary32(value: f64) -> f32
requires value == (0.1f32 as f64)
{
    value as f32
}

machine main() crashes Trap {
    let value: f32 = narrowed();
    let negative: f32 = narrow_parameter(-3.75);
    let retained: f32 = retained_binary32(0.1f32 as f64);
    transition value == 3.75f32 && negative == -3.75f32 && retained == 0.1f32 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
