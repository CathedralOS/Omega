// Executable requirement uses survive every record edge, with their checked IEEE selections.
use omega::language::core::float_operations;
use omega_language_std::console;
data Number [copy] { value: f64; }
data Envelope [copy] { number: Number; }
machine shifted(value: f64) -> Envelope {
    transition { _ -> Envelope { number: Number { value: value * 2.0 + 1.0 } } }
}
machine observe(number: Number) -> f64 { number.value }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: Envelope = shifted(3.0);
    let local: Number = Number { value: result.number.value * 2.0 - 0.5 };
    let observed: f64 = observe(Number { value: local.value * 0.5 });
    transition observed == 6.75 && result.number.value == 7.0 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::write("selection=OK\n"); Console::exit_process(70); }
    state bad(main: &mut Main) { Console::write("selection=BAD\n"); Console::exit_process(71); }
}
