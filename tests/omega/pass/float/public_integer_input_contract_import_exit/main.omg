use omega::language::core::float_operations;

machine rounded(value: i32) -> f32
ensures
    F32Classify::classify(result) == F32Classify::classify(F32FromI32::from_i32(value)) &&
    (F32IsNan::is_nan(result) || result == F32FromI32::from_i32(value)) {
    F32FromI32::from_i32(value)
}

machine main() crashes Trap {
    let value: f32 = rounded(16777217i32);
    transition value == 16777216.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
