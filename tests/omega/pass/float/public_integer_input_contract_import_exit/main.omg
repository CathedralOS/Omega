use omega::language::core::F32::from_i32;
use omega::language::core::F32::classify;
use omega::language::core::F32::is_nan;

machine rounded(value: i32) -> f32
ensures
    F32::classify(result) == F32::classify(F32::from_i32(value)) &&
    (F32::is_nan(result) || result == F32::from_i32(value)) {
    F32::from_i32(value)
}

machine main() crashes Trap {
    let value: f32 = rounded(16777217i32);
    transition value == 16777216.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
