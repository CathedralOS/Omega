use omega::language::core::float_operations;

machine finite_value(value: f32) -> f32
requires F32::is_finite(value) {
    value
}

machine main() crashes Trap {
    let wrapped: f32 = finite_value(((250u8 as u8 in Wrapping) + (10u8 as u8 in Wrapping)) as f32);
    let saturated: f32 = finite_value(((250u8 as u8 in Saturating) + (10u8 as u8 in Saturating)) as f32);
    let trapped_policy: f32 = finite_value(((3u8 as u8 in Trapping) + (4u8 as u8 in Trapping)) as f32);
    transition wrapped == 4.0f32 && saturated == 255.0f32 && trapped_policy == 7.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
