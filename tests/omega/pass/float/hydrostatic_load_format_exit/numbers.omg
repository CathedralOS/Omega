// Artifacts use decimal integers in micro-units, rounded half away from zero.
// Maximum model bounds keep scaled loads below 2e18, within signed i64.
use omega_language_std::console;
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

public machine write_integer(value: i64 in Wrapping) reaches Console
invokes Console;
{
    transition value < 0 {
        true -> negative(value)
        false -> magnitude(value)
    }
    machine negative(value: i64 in Wrapping) {
        Console::write("-");
        transition { _ -> magnitude(0 - value) }
    }
    machine magnitude(value: i64 in Wrapping) {
        transition { _ -> find_divisor(value, 1) }
    }
    machine find_divisor(value: i64 in Wrapping, divisor: i64 in Wrapping) {
        transition divisor > 0 {
            true -> grow(value, divisor)
            false -> done()
        }
    }
    machine grow(value: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor > 0
    {
        transition value / divisor >= 10 && divisor < 1000000000000000000 {
            true -> find_divisor(value, divisor * 10)
            false -> emit(value, divisor)
        }
    }
    machine emit(value: i64 in Wrapping, divisor: i64 in Wrapping)
    requires divisor > 0
    {
        let digit: i32 = ((value / divisor) % 10) as i32;
        Console::write_byte(digit + 48);
        transition divisor >= 10 {
            true -> emit(value, divisor / 10)
            false -> done()
        }
    }
    machine done() { }
}

public machine write_scaled(value: f64) reaches Console
invokes Console;
{
    transition value < 0.0 {
        true -> negative(value)
        false -> positive(value)
    }
    machine negative(value: f64) {
        Console::write("-");
        let rounded: i64 in Saturating = I64::from_f64((0.0 - value) * 1000000.0 + 0.5);
        write_integer(rounded as i64 in Wrapping);
    }
    machine positive(value: f64) {
        let rounded: i64 in Saturating = I64::from_f64(value * 1000000.0 + 0.5);
        write_integer(rounded as i64 in Wrapping);
    }
}
