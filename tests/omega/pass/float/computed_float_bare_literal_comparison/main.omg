use omega::language::core::float_operations;

machine f32_result() -> bool {
    F32::square_root(64.0f32) == 8.0
}

machine f64_result() -> bool {
    F64::square_root(64.0f64) == 8.0
}

machine main() crashes Trap {
    let f32_forward: bool = F32::square_root(64.0f32) == 8.0;
    let f32_reverse: bool = 8.0 == F32::square_root(64.0f32);
    let f64_forward: bool = F64::square_root(64.0f64) == 8.0;
    let f64_reverse: bool = 8.0 == F64::square_root(64.0f64);
    transition f32_result() && f64_result()
        && f32_forward && f32_reverse
        && f64_forward && f64_reverse
        && F32::square_root(64.0f32) < 9.0
        && 7.0 < F32::square_root(64.0f32)
        && F64::square_root(64.0f64) <= 8.0
        && 8.0 >= F64::square_root(64.0f64)
        && F32::square_root(64.0f32) != 7.0
        && 7.0 != F64::square_root(64.0f64) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
