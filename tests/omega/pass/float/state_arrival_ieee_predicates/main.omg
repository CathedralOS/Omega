// IEEE arrival contracts preserve unordered semantics and dense scalar positions
// when a structural formal precedes an f32/f64 scalar. Both orientations of a
// literal comparison and two scalar subjects belong to the same predicate owner.
use omega::language::core::float_operations;
use omega_language_std::console;
data Record { observed: i32; }
data Main { record: Record; value: f64; smaller: f32; }
machine land64(record: &mut Record, value: f64) {
    transition value == value && value >= 0.0 && 0.0 <= value && 1000.0 > value && value < 1000.0 {
        true -> bounded(record, value)
        false -> rejected(record)
    }
    state bounded(record: &mut Record, value: f64)
    requires value == value && value >= 0.0 && 0.0 <= value && 1000.0 > value && value < 1000.0
    { record.observed = I32::from_f64(value); }
    state rejected(record: &mut Record) { record.observed = -1; }
}
machine land32(value: f32) -> bool {
    transition value != 0.0f32 && value <= 2.0f32 && 2.0f32 >= value && value > 0.0f32 {
        true -> bounded(value)
        false -> rejected()
    }
    state bounded(value: f32) -> bool
    requires value != 0.0f32 && value <= 2.0f32 && 2.0f32 >= value && value > 0.0f32
    { true }
    state rejected() -> bool { false }
}
machine Main::main(main: &mut Main) reaches Console {
    main.value = 123.75;
    main.smaller = 1.25f32;
    land64(&mut main.record, main.value);
    let landed: bool = land32(main.smaller);
    transition landed && main.record.observed == 123 {
        true -> unordered(main)
        false -> failed(main)
    }
    state unordered(main: &mut Main) {
        main.smaller = 0.0f32 / 0.0f32;
        let rejected: bool = land32(main.smaller);
        transition !rejected { true -> done(main) false -> failed(main) }
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
