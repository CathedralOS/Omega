// Selected numeric imports share exact semantics with native realization.
// ProcessExit authority is explicit and independent of the numeric supplies.
use omega::language::core::float_operations;
use omega::language::core::process_exit;
use omega_language_std::process_exit;

data Main {
    base32: f32;
    one32: f32;
    one64: f64;
}

// A published crash guard captures the field in a private runtime slot.
// Returning the later integer must follow its checked binding, not that slot.
machine convert(main: &Main) -> i32 {
    let converted: i32 in Trapping = I32::from_f64(main.one64);
    let scalar: i32 = converted as i32;
    scalar
}

machine identity(value: i32, bytes: [u8; 2]) -> i32 { value }

machine Main::main(main: &mut Main) reaches ProcessExit {
    main.base32 = 16777216.0f32;
    main.one32 = 1.0f32;
    main.one64 = 1.0;
    let rounded: f32 = main.base32 + main.one32 + main.one32;
    let positive: f32 = F32::divide_toward_positive(main.one32, 3.0f32);
    let toward_zero: f64 = F64::divide_toward_zero(main.one64, 3.0);
    let negative: f64 = F64::divide_toward_negative(0.0 - main.one64, 3.0);
    let square_root: f64 = F64::square_root(16.0);
    let narrow: f32 = F32::from_f64(square_root);
    let widened: f64 = F64::from_f32(narrow);
    let negative_zero: f32 = F32::negate(0.0f32);
    let minimum_zero: f32 = F32::minimum(0.0f32, negative_zero);
    let reciprocal: f32 = main.one32 / minimum_zero;
    let nan: f64 = 0.0f64 / 0.0f64;
    let minimum: f64 = F64::minimum(nan, main.one64);
    let maximum: f64 = F64::maximum(main.one64, nan);
    let maximum_integer: u64 = 18446744073709551615u64;
    let integer_float: f64 = F64::from_u64(maximum_integer);
    let unsigned: u64 in Saturating = U64::from_f64(integer_float);
    let nan_integer: i32 in Saturating = I32::from_f64(nan);
    let truncated: i8 in Trapping = I8::from_f32(-128.75f32);
    let negative_fraction: u8 in Trapping = U8::from_f64(-0.75);
    let signed_minimum: i64 in Trapping = I64::from_f64(-9223372036854775808.0);
    // The outer staged result acquires its source binding after its nested
    // argument temporaries are retired.
    let returned: i32 = identity(convert(main), [11, 29]);
    let unsigned_value: u64 = unsigned as u64;
    let nan_value: i32 = nan_integer as i32;
    let truncated_value: i8 = truncated as i8;
    let fraction_value: u8 = negative_fraction as u8;
    let minimum_value: i64 = signed_minimum as i64;
    let fused: f64 = F64::fused_multiply_add(main.one64, 2.0, 3.0);
    let unfused: f64 = F64::multiply_then_add(main.one64, 2.0, 3.0);
    transition rounded == main.base32
        && positive == 0.3333333432674407958984375f32
        && toward_zero == 0.333333333333333314829616256247390992939472198486328125
        && negative == -0.33333333333333337034076748750521801471710205078125
        && square_root == 4.0 && widened == 4.0
        && reciprocal < 0.0f32 && F32::is_infinite(reciprocal)
        && minimum == main.one64 && F64::is_nan(maximum)
        && integer_float == 18446744073709551616.0
        && unsigned_value == maximum_integer && nan_value == 0
        && truncated_value == -128 && fraction_value == 0
        && minimum_value == -9223372036854775808 && returned == 1
        && fused == 5.0 && unfused == 5.0 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { ProcessExit::exit_process(70); }
    state bad(main: &mut Main) { ProcessExit::exit_process(77); }
}
