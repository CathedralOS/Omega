use omega::language::core::float_operations;

// std math is_finite, natively (2026-07-14): the portable spelling
// `is_finite(x) = (x - x == 0.0)` runs through the real dispatch pipeline
// on all three legs -- a finite runtime value (true), a runtime infinity
// (false: inf - inf = NaN), and a runtime NaN (false: NaN - NaN = NaN).
// The inf/NaN legs ride the ARM-GUARD FAILURE branch inside the inlined
// callee (the no() arm), the exact path the expansion arm-guard distance
// fix routes -- before it, a failed inline arm guard sailed past its
// sibling arm into the caller's failure trailer and both false legs
// answered true. Distinct exit codes name the first leg that misses.
use omega_language_std::math;
use omega_language_std::console;
data Main { console: Console; }
machine Main::main(&mut self) {
    transition { _ -> finite_leg(2.5, 0.0) }
    state finite_leg(&mut self, v: f64, zero: f64) {
        let half: f64 = v * 0.5;
        let verdict: bool = is_finite(half);
        transition verdict == true { true -> inf_leg(v, zero) _ -> bad_finite() }
    }
    state inf_leg(&mut self, v: f64, zero: f64) {
        let inf: f64 = v / zero;
        let verdict: bool = is_finite(inf);
        transition verdict == false { true -> nan_leg(zero) _ -> bad_inf() }
    }
    state nan_leg(&mut self, zero: f64) {
        let nan: f64 = zero / zero;
        let verdict: bool = is_finite(nan);
        transition verdict == false { true -> good() _ -> bad_nan() }
    }
    state good(&self)       { self.console.exit_process(70); }
    state bad_finite(&self) { self.console.exit_process(72); }
    state bad_inf(&self)    { self.console.exit_process(73); }
    state bad_nan(&self)    { self.console.exit_process(74); }
}
