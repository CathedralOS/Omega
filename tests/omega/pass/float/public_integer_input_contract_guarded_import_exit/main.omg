use omega::language::core::float_operations;

// Both return paths import the selected slot's normal-result guarantee.
machine rounded(value: i32, first: bool) -> f32
ensures
    F32::classify(result) == F32::classify(F32::from_i32(value)) &&
    (F32::is_nan(result) || result == F32::from_i32(value)) {
    transition first {
        true -> (F32::from_i32(value))
        false -> (F32::from_i32(value))
    }
}

machine main() crashes Trap {
    let first: f32 = rounded(16777217i32, true);
    let second: f32 = rounded(16777217i32, false);
    transition first == 16777216.0f32 && second == 16777216.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
