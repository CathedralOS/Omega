// The requirement-side intrinsic bridge on the one float intrinsic Terminal
// can execute: `F32::fused_multiply_add` is a top-level `boundary requirement`
// in core, satisfied by a compiler-intrinsic realization, and the direct call
// settles to the selected nearest fused multiply-add as an attached Unit
// local initializer. The operands are the binary32 values 1 + 2^-23 (twice)
// and 2^-24: one rounding of (1 + 2^-23)^2 + 2^-24 is 1 + 3 * 2^-23, while a
// separately rounded product then sum is exactly 1 + 2^-22, so the compare
// distinguishes the fused realization from two roundings.

use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::service;

data Code {}

machine Code::of(fused: f32) -> i32 {
    transition fused > 1.0000002384185791015625f32 {
        true -> (70)
        _ -> (71)
    }
}

data Main { console: Service<Console>; }

machine Main::main(&mut self)
reaches Console
{
    let fused32: f32 = F32::fused_multiply_add(
        1.00000011920928955078125f32,
        1.00000011920928955078125f32,
        0.000000059604644775390625f32
    );
    self.console.exit_process(Code::of(fused32));
}
