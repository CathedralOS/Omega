// Std-free single-rounding FMA probe. x86-64 targets admit AVX+FMA3 explicitly;
// AArch64 realizes the same contract with FMADD.

machine build(builder: &mut Build) {
    Build::application(builder, "fused_multiply_add_single_rounding_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    builder.x86_deployment_features = X86DeploymentFeatures::AvxFma3;
}
