use omega_language_std::math;

// Float shorthand must execute its exact requirement call, including field
// result stores. Neither the builtin alias nor an ISA shortcut supplies it.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    left32: f32;
    right32: f32;
    low32: f32;
    high32: f32;
    root32: f32;
    left64: f64;
    right64: f64;
    low64: f64;
    high64: f64;
    root64: f64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.left32 = 9.0f32;
    main.right32 = 4.0f32;
    main.left64 = 9.0;
    main.right64 = 4.0;
    main.low32 = min_f32(main.left32, main.right32);
    main.high32 = max_f32(main.left32, main.right32);
    main.root32 = sqrt_f32(main.low32);
    main.low64 = min_f64(main.left64, main.right64);
    main.high64 = max_f64(main.left64, main.right64);
    main.root64 = sqrt_f64(main.low64);
    // Explicit catalog calls select their format even with anonymous operands.
    let anonymous_minimum: f32 = min_f32(4.0, 9.0);
    let anonymous_root: f32 = sqrt_f32(4.0);
    transition main.low32 == 4.0f32 && main.high32 == 9.0f32 && main.root32 == 2.0f32
        && main.low64 == 4.0 && main.high64 == 9.0 && main.root64 == 2.0
        && anonymous_minimum == 4.0f32 && anonymous_root == 2.0f32 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
