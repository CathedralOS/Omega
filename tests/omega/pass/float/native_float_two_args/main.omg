use omega::language::core::float_operations;

// PROVES multiple f64 ARGUMENTS marshalled into consecutive float registers
// (v0, v1) alongside a float RETURN (render fire 6). A boundary method with two
// f64 params bound to libm `hypot`: x -> v0, y -> v1 (sequenced by the vreg
// counter, independent of the x-register file), result in d0. As with the sqrt
// canary, the f64 result is round-tripped through the proven `round_nearest`
// float-ARG path to check the stored bits without a float `==` guard:
// hypot(3.0, 4.0) -> 5.0 -> round 5 -> exit 5. A misplaced second arg (both in
// v0, or one in a GPR) yields the wrong hypotenuse -> exit 1. Both arguments
// are direct computations so their independent scratch slots must retain the
// FLOAT class before marshalling.

use omega::language::std::console;

boundary trait Math {
    machine round_nearest(value: f64) -> i64;
    machine hypotenuse(x: f64, y: f64) -> f64;
}

data Main {
    console: Console;
    math: Math;
    a: f64;
    b: f64;
    hyp: f64;
    n: i64;
}

machine Main::main(&mut self) {
    self.a = 3.0;
    self.b = 4.0;
    self.hyp = self.math.hypotenuse(self.a + 0.0, self.b + 0.0);
    self.n = self.math.round_nearest(self.hyp);
    transition self.n == 5 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(5); }
    state bad(&mut self)  { self.console.exit_process(1); }
}
