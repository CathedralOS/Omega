// Named semantic constants need no payload bits when only classification is used.
use omega::language::core::F32::square_root;
use omega::language::core::F64::square_root;
use omega::language::core::F32::is_nan;
use omega::language::core::F64::is_nan;
use omega_language_std::Console;

const NAN32: f32 = F32::square_root(-1.0f32);
const NAN64: f64 = F64::square_root(-1.0f64);
const ALIAS: f32 = NAN32;
machine classify(value: f32) -> bool { F32::is_nan(value) }
const CLASSIFIED: bool = classify(ALIAS) && F64::is_nan(NAN64);

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition CLASSIFIED {
        true -> good()
        _ -> bad()
    }
    machine good() { Console::exit_process(70); }
    machine bad() { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
