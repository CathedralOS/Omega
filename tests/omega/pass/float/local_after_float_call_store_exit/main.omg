// A local declared after a float call-result field store reads its own value
// (exit 70).
//
// `main.sum = a + b` applies the selected float addition and binds
// its result before storing it, so that result takes a dense binding slot
// although no source name reads it. `doubled` is declared after it and must
// still read itself: with a = 1 and b = 4 it is 8, while the stored sum is 5.
// A read that resolved `doubled` to the stored call result would see 5 and
// exit 71.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    sum: f64;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut a: f64 = 1.0;
    let mut b: f64 = 4.0;
    main.sum = a + b;
    let doubled: f64 = b * 2.0;
    transition doubled == 8.0 {
        true -> check_sum(main)
        false -> fail(main, 71)
    }

    state check_sum(main: &mut Main) {
        transition main.sum == 5.0 {
            true -> good(main)
            false -> fail(main, 72)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
