use omega::language::core::float_operations;

// An Exact `as f64` inside a nested machine is proved from what its one
// caller guaranteed. An integer converts exactly when it is `m * 2^e` with
// `|m| <= 2^53`: inside the band, the guard bounds it; past the band, the
// guard pins a value that is an exact multiple. Each caller also takes the
// unguarded branch, so a wrongly selected arm returns the other value.
machine band(value: i64) -> f64 {
    transition value >= -9007199254740992i64 && value <= 9007199254740992i64 {
        true -> convert(value)
        false -> outside()
    }
    machine convert(value: i64) -> f64 { value as f64 }
    machine outside() -> f64 { 1.0f64 }
}

machine scaled(value: i64) -> f64 {
    transition value == 3458764513820540928i64 {
        true -> convert(value)
        false -> other()
    }
    machine convert(value: i64) -> f64 { value as f64 }
    machine other() -> f64 { 2.0f64 }
}

machine main() crashes Trap {
    let inside: f64 = band(-9007199254740992i64);
    let outside: f64 = band(9007199254740993i64);
    let large: f64 = scaled(3458764513820540928i64);
    let other: f64 = scaled(5i64);
    transition inside == -9007199254740992.0f64 && outside == 1.0f64
        && large == 3458764513820540928.0f64 && other == 2.0f64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
