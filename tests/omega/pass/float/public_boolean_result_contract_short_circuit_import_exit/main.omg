use omega::language::core::F32::is_finite;

// Each selected expression outcome retains only its own normal-call facts.
machine finite(value: f32) -> bool
ensures result == F32::is_finite(value) {
    let observed: bool = F32::is_finite(value) || F32::is_finite(value);
    transition { _ -> forward(observed) }
    machine forward(observed: bool) -> bool { observed }
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    transition observed { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
