use omega::language::core::float_operations;
use omega_language_std::console;
data Main where value >= 0.0 && value <= 1.0 { value: f32; }
machine Main::fill(main: &mut Main) {
    transition { _ -> step(main, 0) }
    state step(main: &mut Main, round: u8) {
        transition round < 3 { true -> again(main, round) _ -> done(main) }
    }
    state again(main: &mut Main, round: u8) {
        main.value = 2.0;
        main.value = 0.25;
        transition { _ -> step(main, round + 1) }
    }
    state done(main: &mut Main) {}
}
machine Main::observe(main: &mut Main) reaches Console {
    transition main.value == 0.25 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
machine Main::main(main: &mut Main) reaches Console {
    Main::fill(main);
    Main::observe(main);
}
