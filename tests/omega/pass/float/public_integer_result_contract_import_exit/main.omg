use omega::language::core::float_operations;
machine integer(value: f32) -> i32 in Saturating
ensures result == FloatSemantics::to_i32_saturating(Float::meaning32(value)) {
    let converted: i32 in Saturating = I32::from_f32(value);
    converted
}
machine main() crashes Trap {
    let observed: i32 in Saturating = integer(2.5f32);
    transition observed == 2i32 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
