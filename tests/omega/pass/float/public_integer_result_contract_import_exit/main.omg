use omega::language::core::float_operations;
// A typed local selects the Saturating slot without changing its denotation.
machine saturating_integer(value: f32) -> i32 in Saturating {
    let converted: i32 in Saturating = I32::from_f32(value);
    converted
}

machine integer(value: f32) -> i32 in Saturating
ensures result == saturating_integer(value) {
    let converted: i32 in Saturating = I32::from_f32(value);
    converted
}
machine main() crashes Trap {
    let observed: i32 in Saturating = integer(2.5f32);
    transition observed == 2i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
