use omega_language_std::math;
use omega_language_std::console;
use omega::language::core::float_operations;

// Runtime input prevents a closed NaN-bit materialization from replacing
// observations. IEEE tests do not identify NaN payloads or erase zero signs.
data Main { zero: f64; zero32: f32; }

machine Main::main(main: &mut Main) reaches Console {
    let negative_zero: f64 = F64::negate(main.zero);
    let nan: f64 = main.zero / main.zero;
    let absolute_zero: f64 = abs_f64(negative_zero);
    let absolute_nan: f64 = abs_f64(nan);
    let root_zero: f64 = sqrt_f64(negative_zero);
    let root_negative: f64 = sqrt_f64(main.zero - 1.0);
    let selected_nan: f64 = min_f64(1.0, nan);
    let selected_number: f64 = max_f64(nan, 1.0);
    let clamped_nan: f64 = clamp_f64(nan, 2.0, 4.0);
    let negative_zero32: f32 = F32::negate(main.zero32);
    let nan32: f32 = main.zero32 / main.zero32;
    let absolute_zero32: f32 = abs_f32(negative_zero32);
    let root_zero32: f32 = sqrt_f32(negative_zero32);
    let selected_nan32: f32 = max_f32(1.0f32, nan32);
    let absolute_nan32: f32 = abs_f32(nan32);
    transition 1.0 / absolute_zero > 0.0 && absolute_nan != absolute_nan
        && 1.0 / root_zero < 0.0 && root_negative != root_negative
        && selected_nan != selected_nan && selected_number == 1.0
        && clamped_nan == 2.0 && 1.0f32 / absolute_zero32 > 0.0f32
        && 1.0f32 / root_zero32 < 0.0f32 && selected_nan32 != selected_nan32
        && absolute_nan32 != absolute_nan32 {
        true -> done(main)
        _ -> failed(main)
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
