// The named Trapping overload must reject a finite value whose toward-zero
// result is outside the destination interval.
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::service;

data Main { console: Binding<Console>; value: f64; }

machine Main::main(&mut self) reaches Console {
    self.value = 256.0;
    let trapped: u8 in Trapping = U8::from_f64(self.value);
    self.console.exit_process(trapped as i32);
}
