// Expected exit: 0.
// Checked forwarding preserves the published multiply-then-add contract.
use omega::language::core::float_operations;

machine software32(left: f32, right: f32, addend: f32) -> f32
satisfies F32::multiply_then_add
ensures core::Identity<FloatMeaning>(F32::meaning(result),
    FloatSemantics::multiply_then_add(FloatFormat::BINARY32,
        F32::meaning(left), F32::meaning(right), F32::meaning(addend)))
{
    F32::multiply_then_add(left, right, addend)
}

machine software64(left: f64, right: f64, addend: f64) -> f64
satisfies F64::multiply_then_add
ensures core::Identity<FloatMeaning>(F64::meaning(result),
    FloatSemantics::multiply_then_add(FloatFormat::BINARY64,
        F64::meaning(left), F64::meaning(right), F64::meaning(addend)))
{
    F64::multiply_then_add(left, right, addend)
}

machine main() crashes Trap {
    let next32: f32 = 1.00000011920928955078125;
    let cancel32: f32 = 0.0f32 - 1.0000002384185791015625;
    let next64: f64 = 1.0000000000000002220446049250313080847263336181640625;
    let cancel64: f64 = 0.0 - 1.000000000000000444089209850062616169452667236328125;
    let separate32: f32 = software32(next32, next32, cancel32);
    let separate64: f64 = software64(next64, next64, cancel64);
    transition separate32 == 0.0f32 && separate64 == 0.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
