use omega::language::core::float_operations;

// F3a: `Finite` is a compiler-known core value domain, not a user-declared
// carrier domain. The data's ordinary where clause retains the ranged field's
// finite interval while its value flows to a Finite transition parameter.
use omega_language_std::console;

data Main where ranged >= 0.0 && ranged <= 1.0 {
    direct: f64 in Finite;
    ranged: f32;
}

machine Main::main(main: &mut Main) reaches Console {
    // Writes are an invariant window: transient poison and an out-of-range
    // intermediate are legal because both places are repaired before the
    // transition consumes state.
    main.direct = 0.0f64 / 0.0;
    main.direct = 2.5;
    main.ranged = 2.0;
    main.ranged = 0.5;
    transition { _ -> accepts_range(main, main.ranged) }

    machine accepts_range(main: &Main, value: f32 in Finite) {
        transition value == 0.5 { true -> good(main) _ -> bad(main) }
    }

    machine good(main: &Main) { Console::exit_process(77); }
    machine bad(main: &Main) { Console::exit_process(78); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
