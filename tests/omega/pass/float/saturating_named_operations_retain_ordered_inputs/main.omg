use omega::language::core::float_operations;

// Named operations retain result policy from both implicit and computed inputs.
// Every original input participates in overflow eligibility, in its own format.
machine main() crashes Trap {
    let maximum: f32 in Saturating = 3.4028234663852886e38f32 as f32 in Saturating;
    let implicit: f32 in Saturating = F32::multiply_then_add(maximum, 2.0f32, 0.0f32);
    let negative: f32 in Saturating = F32::multiply_then_add(-3.4028234663852886e38f32 as f32 in Saturating, 2.0f32, 0.0f32);
    let computed: f32 in Saturating = F32::multiply_then_add((1.0f32 as f32 in Saturating) + 2.0f32, 3.0f32, 4.0f32);
    let narrowed: f32 in Saturating = F32::from_f64(1.7976931348623157e308f64 as f64 in Saturating);
    let nested: f32 in Saturating = F32::multiply_then_add(F32::multiply_then_add(maximum, 1.0f32, 0.0f32), 2.0f32, 0.0f32);
    let binary_overflow: f32 in Saturating = (3.4028234663852886e38f32 as f32 in Saturating) * 2.0f32;
    let infinity: f32 = 1.0f32 / 0.0f32;
    let propagated: f32 in Saturating = F32::multiply_then_add(maximum, 2.0f32, infinity as f32 in Saturating);
    let invalid: f32 in Saturating = F32::multiply_then_add(0.0f32 as f32 in Saturating, infinity, 0.0f32);
    let binary_propagated: f32 in Saturating = (infinity as f32 in Saturating) * 2.0f32;
    let binary_invalid: f32 in Saturating = (0.0f32 as f32 in Saturating) * infinity;
    let zero_divisor: f32 in Saturating = (1.0f32 as f32 in Saturating) / 0.0f32;
    let division_overflow: f32 in Saturating = maximum / 0.5f32;
    transition implicit == 3.4028234663852886e38f32
        && negative == -3.4028234663852886e38f32
        && computed == 13.0f32
        && nested == 3.4028234663852886e38f32
        && binary_overflow == 3.4028234663852886e38f32
        && narrowed == 3.4028234663852886e38f32
        && F32::is_infinite(propagated as f32)
        && F32::is_nan(invalid as f32)
        && F32::is_infinite(binary_propagated as f32)
        && F32::is_nan(binary_invalid as f32)
        && F32::is_infinite(zero_divisor as f32)
        && division_overflow == 3.4028234663852886e38f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
