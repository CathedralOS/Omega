// Expected exit: 0
use omega::language::core::float_operations;
data Reading [copy] { values: [f64; 2]; other: f64; }
machine convert(value: f64, index: u64) -> i32
requires index < 2,
{
    let mut reading: Reading = Reading { values: [value, value], other: 0.0 };
    let accepted: bool = reading.values[index] == reading.values[index] && reading.values[index] >= 0.0 && reading.values[index] < 1000000000.0;
    reading.other = 200000000000000000000.0;
    transition accepted {
        true -> finish(I32::from_f64(reading.values[index]), reading.other)
        false -> finish(0, reading.other)
    }
    state finish(converted: i32, observed: f64) -> i32 {
        transition observed == 200000000000000000000.0 {
            true -> converted
            false -> -999
        }
    }
}
machine main() crashes Trap {
    let zero: f64 = 0.0;
    let unordered: f64 = zero / zero;
    transition convert(123.75, 1) == 123 && convert(2000000000.0, 0) == 0 && convert(unordered, 1) == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
