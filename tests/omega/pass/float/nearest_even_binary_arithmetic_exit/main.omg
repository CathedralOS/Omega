// Runtime binary32 and binary64 add, subtract, multiply and divide through
// the selected primitive float providers (exit 70).
//
// Each case rounds an inexact result to nearest, ties to even, and each
// expected value differs from the truncated (round-toward-zero) result:
//   1 + 3*2^-54 -> 1 + 2^-52 (truncation keeps 1)
//   1 - 2^-55   -> 1         (truncation gives 1 - 2^-53)
//   0.1 * 3     -> 0.30000000000000004 (truncation gives 0.29999999999999998)
//   10 / 3      -> 3.3333333333333335 (truncation gives 3.333333333333333)
// and the binary32 analogues with 2^-23 in place of 2^-52. Operands are field
// reads so each operation executes at run time.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    one64: f64;
    tenth64: f64;
    ten64: f64;
    one32: f32;
    tenth32: f32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.one64 = 1.0;
    main.tenth64 = 0.1;
    main.ten64 = 10.0;
    main.one32 = 1.0;
    main.tenth32 = 0.1;
    let sum64: f64 = main.one64 + 0.000000000000000166533453693773481063544750213623046875;
    transition sum64 == 1.0000000000000002220446049250313080847263336181640625 {
        true -> subtract64(main)
        _ -> fail(main, 71)
    }

    state subtract64(main: &mut Main) {
        let difference64: f64 =
            main.one64 - 0.0000000000000000277555756156289135105907917022705078125;
        transition difference64 == 1.0 {
            true -> multiply64(main)
            _ -> fail(main, 72)
        }
    }

    state multiply64(main: &mut Main) {
        let product64: f64 = main.tenth64 * 3.0;
        transition product64 == 0.3000000000000000444089209850062616169452667236328125 {
            true -> divide64(main)
            _ -> fail(main, 73)
        }
    }

    state divide64(main: &mut Main) {
        let quotient64: f64 = main.ten64 / 3.0;
        transition quotient64 == 3.333333333333333481363069950020872056484222412109375 {
            true -> add32(main)
            _ -> fail(main, 74)
        }
    }

    state add32(main: &mut Main) {
        let sum32: f32 = main.one32 + 0.0000000894069671630859375;
        transition sum32 == 1.00000011920928955078125 {
            true -> subtract32(main)
            _ -> fail(main, 75)
        }
    }

    state subtract32(main: &mut Main) {
        let difference32: f32 = main.one32 - 0.00000001490116119384765625;
        transition difference32 == 1.0 {
            true -> multiply32(main)
            _ -> fail(main, 76)
        }
    }

    state multiply32(main: &mut Main) {
        let product32: f32 = main.tenth32 * 3.0;
        transition product32 == 0.300000011920928955078125 {
            true -> divide32(main)
            _ -> fail(main, 77)
        }
    }

    state divide32(main: &mut Main) {
        let quotient32: f32 = main.one32 / 3.0;
        transition quotient32 == 0.3333333432674407958984375 {
            true -> pass(main)
            _ -> fail(main, 78)
        }
    }

    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
