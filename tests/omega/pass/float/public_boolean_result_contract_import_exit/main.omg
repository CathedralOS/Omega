use omega::language::core::float_operations;

// The public slot's exact Boolean guarantee must survive caller import.
machine finite(value: f32) -> bool
ensures result == F32::is_finite(value) {
    F32::is_finite(value)
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    transition observed {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
