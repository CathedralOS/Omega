use omega::language::core::float_operations;

// The public slot's exact Boolean guarantee must survive caller import.
machine finite(value: f32) -> bool
ensures result == F32::is_finite(value) {
    F32::is_finite(value)
}

// The second primitive format retains its own selected public slot.
machine finite_f64(value: f64) -> bool
ensures result == F64::is_finite(value) {
    F64::is_finite(value)
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    let observed_f64: bool = finite_f64(1.0f64);
    transition observed && observed_f64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
