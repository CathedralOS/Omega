// Directed subtraction uses one operation-local rounding direction and restores
// the prior state before ordinary arithmetic. Midpoints below one distinguish
// toward-positive, toward-negative, and toward-zero in both IEEE formats.

use omega::language::core::float_operations;
use omega::language::std::console;

data Main {
    console: Console;
    one32: f32;
    midpoint_delta32: f32;
    below_one32: f32;
    negative_one32: f32;
    negative_below_one32: f32;
    positive32: f32;
    zero32: f32;
    negative32: f32;
    ordinary32: f32;
    one64: f64;
    midpoint_delta64: f64;
    below_one64: f64;
    negative_one64: f64;
    negative_below_one64: f64;
    positive64: f64;
    zero64: f64;
    negative64: f64;
    ordinary64: f64;
}

machine Main::main(&mut self) {
    self.one32 = 1.0f32;
    self.midpoint_delta32 = 0.0000000298023223876953125f32;
    self.below_one32 = 0.999999940395355224609375f32;
    self.negative_one32 = 0.0f32 - self.one32;
    self.negative_below_one32 = 0.0f32 - self.below_one32;
    self.positive32 = F32::subtract_toward_positive(
        self.one32,
        self.midpoint_delta32
    );
    self.negative32 = F32::subtract_toward_negative(
        self.one32,
        self.midpoint_delta32
    );
    self.zero32 = F32::subtract_toward_zero(
        self.negative_one32,
        0.0f32 - self.midpoint_delta32
    );
    self.ordinary32 = self.one32 - self.midpoint_delta32;

    self.one64 = 1.0;
    self.midpoint_delta64 = 0.000000000000000055511151231257827021181583404541015625;
    self.below_one64 = 0.99999999999999988897769753748434595763683319091796875;
    self.negative_one64 = 0.0 - self.one64;
    self.negative_below_one64 = 0.0 - self.below_one64;
    self.positive64 = F64::subtract_toward_positive(
        self.one64,
        self.midpoint_delta64
    );
    self.negative64 = F64::subtract_toward_negative(
        self.one64,
        self.midpoint_delta64
    );
    self.zero64 = F64::subtract_toward_zero(
        self.negative_one64,
        0.0 - self.midpoint_delta64
    );
    self.ordinary64 = self.one64 - self.midpoint_delta64;

    transition self.positive32 == self.one32
        && self.negative32 == self.below_one32
        && self.zero32 == self.negative_below_one32
        && self.ordinary32 == self.one32
        && self.positive64 == self.one64
        && self.negative64 == self.below_one64
        && self.zero64 == self.negative_below_one64
        && self.ordinary64 == self.one64 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(77); }
}
