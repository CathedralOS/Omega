// F7 policy-adapter edge: Trapping checks the semantic RESULT, not whether
// finite operands newly created the non-finite. A NaN produced under the quiet
// default may be selected into a policy-qualified carrier with an explicit
// `as` (selection changes future operations, not the payload), but its next
// Trapping arithmetic operation must trap instead of propagating it to exit 70.

use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    quiet: f64;
    trapped: f64 in Trapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.quiet = 0.0f64 / 0.0;
    main.trapped = main.quiet as f64 in Trapping;
    main.trapped = (main.trapped + 1.0) as f64 in Trapping;
    Console::exit_process(70);
}
