// Runtime conversions into binary64 and binary32 through the selected named
// float providers (exit 70): `F64`/`F32::from_i32`, `from_i64`, `from_u32`,
// the narrow `from_i8`/`from_i16`/`from_u8`/`from_u16`, and
// `F64::from_f32` / `F32::from_f64`.
//
// Each conversion is one flat local initializer over field reads, so it
// executes at run time. Every conversion is total and rounds to nearest,
// ties to even; each inexact case below differs from truncation:
//   i32 -7 and 2^24 + 1 are exact in binary64;
//   2^24 + 3 ties between 2^24 + 2 and 2^24 + 4 in binary32 and lands on the
//   even 2^24 + 4 (truncation keeps 2^24 + 2);
//   i64 2^53 + 3 lands on 2^53 + 4 in binary64, and -(2^53 + 3) on
//   -(2^53 + 4);
//   u32 3000000000 stays positive (a signed reading would be negative), and
//   u32::MAX rounds up to 2^32 in binary32;
//   i8 -100, i16 -30000, u8 250 and u16 65000 convert exactly (the narrow
//   operand is extended explicitly, never read from upper register bits);
//   binary32 0.1 widens exactly, binary64 1 + 3*2^-25 narrows to 1 + 2^-23
//   (truncation gives 1), binary64 1e300 overflows to binary32 infinity, and
//   a NaN stays NaN in both directions.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    exact_i32: i32;
    tie_i32: i32;
    tie_i64: i64;
    negative_tie_i64: i64;
    large_u32: u32;
    maximum_u32: u32;
    tenth32: f32;
    zero32: f32;
    one32: f32;
    near_one64: f64;
    huge64: f64;
    zero64: f64;
    negative_i8: i8;
    negative_i16: i16;
    large_u8: u8;
    large_u16: u16;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut negative_seven: i32 = -7;
    main.exact_i32 = 16777217;
    main.tie_i32 = 16777219;
    main.tie_i64 = 9007199254740995;
    main.negative_tie_i64 = -9007199254740995;
    main.large_u32 = 3000000000;
    main.maximum_u32 = 4294967295;
    main.tenth32 = 0.1f32;
    main.zero32 = 0.0f32;
    main.one32 = 1.0f32;
    main.near_one64 = 1.0000000894069671630859375;
    main.huge64 = 1e300;
    main.zero64 = 0.0;
    main.negative_i8 = -100;
    main.negative_i16 = -30000;
    main.large_u8 = 250;
    main.large_u16 = 65000;
    let converted: f64 = F64::from_i32(negative_seven);
    transition converted == -7.0 {
        true -> exact_i32_64(main)
        _ -> fail(main, 71)
    }

    state exact_i32_64(main: &mut Main) {
        let converted: f64 = F64::from_i32(main.exact_i32);
        transition converted == 16777217.0 {
            true -> tie_i32_32(main)
            _ -> fail(main, 72)
        }
    }

    state tie_i32_32(main: &mut Main) {
        let converted: f32 = F32::from_i32(main.tie_i32);
        transition converted == 16777220.0f32 {
            true -> tie_i64_64(main)
            _ -> fail(main, 73)
        }
    }

    state tie_i64_64(main: &mut Main) {
        let converted: f64 = F64::from_i64(main.tie_i64);
        transition converted == 9007199254740996.0 {
            true -> negative_tie_i64_64(main)
            _ -> fail(main, 74)
        }
    }

    state negative_tie_i64_64(main: &mut Main) {
        let converted: f64 = F64::from_i64(main.negative_tie_i64);
        transition converted == -9007199254740996.0 {
            true -> tie_i64_32(main)
            _ -> fail(main, 75)
        }
    }

    state tie_i64_32(main: &mut Main) {
        let converted: f32 = F32::from_i64(main.tie_i64);
        transition converted == 9007199254740992.0f32 {
            true -> large_u32_64(main)
            _ -> fail(main, 76)
        }
    }

    state large_u32_64(main: &mut Main) {
        let converted: f64 = F64::from_u32(main.large_u32);
        transition converted == 3000000000.0 {
            true -> maximum_u32_32(main)
            _ -> fail(main, 77)
        }
    }

    state maximum_u32_32(main: &mut Main) {
        let converted: f32 = F32::from_u32(main.maximum_u32);
        transition converted == 4294967296.0f32 {
            true -> maximum_u32_64(main)
            _ -> fail(main, 78)
        }
    }

    state maximum_u32_64(main: &mut Main) {
        let converted: f64 = F64::from_u32(main.maximum_u32);
        transition converted == 4294967295.0 {
            true -> widen(main)
            _ -> fail(main, 79)
        }
    }

    state widen(main: &mut Main) {
        let converted: f64 = F64::from_f32(main.tenth32);
        transition converted == 0.100000001490116119384765625 {
            true -> widen_nan(main)
            _ -> fail(main, 80)
        }
    }

    state widen_nan(main: &mut Main) {
        let nan32: f32 = main.zero32 / main.zero32;
        let converted: f64 = F64::from_f32(nan32);
        transition converted != converted {
            true -> narrow(main)
            _ -> fail(main, 81)
        }
    }

    state narrow(main: &mut Main) {
        let converted: f32 = F32::from_f64(main.near_one64);
        transition converted == 1.00000011920928955078125f32 {
            true -> narrow_overflow(main)
            _ -> fail(main, 82)
        }
    }

    state narrow_overflow(main: &mut Main) {
        let converted: f32 = F32::from_f64(main.huge64);
        let infinity32: f32 = main.one32 / main.zero32;
        transition converted == infinity32 {
            true -> narrow_nan(main)
            _ -> fail(main, 83)
        }
    }

    state narrow_nan(main: &mut Main) {
        let nan64: f64 = main.zero64 / main.zero64;
        let converted: f32 = F32::from_f64(nan64);
        transition converted != converted {
            true -> narrow_i8(main)
            _ -> fail(main, 84)
        }
    }

    state narrow_i8(main: &mut Main) {
        let converted: f64 = F64::from_i8(main.negative_i8);
        transition converted == -100.0 {
            true -> narrow_i16(main)
            _ -> fail(main, 85)
        }
    }

    state narrow_i16(main: &mut Main) {
        let converted: f32 = F32::from_i16(main.negative_i16);
        transition converted == -30000.0f32 {
            true -> narrow_u8(main)
            _ -> fail(main, 86)
        }
    }

    state narrow_u8(main: &mut Main) {
        let converted: f64 = F64::from_u8(main.large_u8);
        transition converted == 250.0 {
            true -> narrow_u16(main)
            _ -> fail(main, 87)
        }
    }

    state narrow_u16(main: &mut Main) {
        let converted: f32 = F32::from_u16(main.large_u16);
        transition converted == 65000.0f32 {
            true -> pass(main)
            _ -> fail(main, 88)
        }
    }

    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
