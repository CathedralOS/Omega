// Runtime float-to-integer conversions through the selected named float
// providers (exit 70): `I8`/`I16`/`I32`/`I64`/`U8`/`U16`/`U32::from_f64` and
// `from_f32` in the Saturating domain. Unqualified (Exact) conversions share
// this realization; their `requires` proof does not yet admit a runtime
// field operand, so this fixture exercises the Saturating overloads.
//
// Each conversion is one flat local initializer over field reads, so it
// executes at run time. Every conversion rounds toward zero. Saturating
// clamps to the carrier and maps NaN to zero:
//   i32: 3e9 -> 2147483647, -3e9 -> -2147483648, NaN -> 0,
//        -1234.9 -> -1234;
//   i64: 1e19 -> 9223372036854775807, -1e19 -> -9223372036854775808,
//        -123456789012.75 -> -123456789012;
//   u32: 5e9 -> 4294967295, -5.5 -> 0, 3000000000.75 -> 3000000000,
//        NaN -> 0;
//   binary32 operands: 1e10 -> i32 2147483647, -7.875 -> i32 -7,
//        -1e19 -> i64 minimum, 4e9 -> u32 4000000000, NaN -> u32 0;
//   narrow carriers: 1000 -> i8 127, -1000 -> i8 -128, -1e6 -> i16
//        -32768, -1234.9 -> i16 -1234, 300 -> u8 255, NaN -> u8 0,
//        -5.5 -> u16 0, 70000 -> u16 65535.
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    negative_huge64: f64;
    fraction64: f64;
    enormous64: f64;
    negative_enormous64: f64;
    large_fraction64: f64;
    unsigned_huge64: f64;
    negative_small64: f64;
    unsigned_fraction64: f64;
    zero64: f64;
    huge32: f32;
    fraction32: f32;
    negative_enormous32: f32;
    unsigned32: f32;
    zero32: f32;
    thousand64: f64;
    negative_thousand64: f64;
    negative_million32: f32;
    three_hundred64: f64;
    seventy_thousand32: f32;
}

machine Main::main(&mut self) reaches Console {
    let mut huge64: f64 = 3000000000.0;
    self.negative_huge64 = -3000000000.0;
    self.fraction64 = -1234.9;
    self.enormous64 = 10000000000000000000.0;
    self.negative_enormous64 = -10000000000000000000.0;
    self.large_fraction64 = -123456789012.75;
    self.unsigned_huge64 = 5000000000.0;
    self.negative_small64 = -5.5;
    self.unsigned_fraction64 = 3000000000.75;
    self.zero64 = 0.0;
    self.huge32 = 10000000000.0f32;
    self.fraction32 = -7.875f32;
    self.negative_enormous32 = -10000000000000000000.0f32;
    self.unsigned32 = 4000000000.0f32;
    self.zero32 = 0.0f32;
    self.thousand64 = 1000.0;
    self.negative_thousand64 = -1000.0;
    self.negative_million32 = -1000000.0f32;
    self.three_hundred64 = 300.0;
    self.seventy_thousand32 = 70000.0f32;
    let value: i32 in Saturating = I32::from_f64(huge64);
    transition value == 2147483647 {
        true -> i32_below()
        _ -> fail(71)
    }

    state i32_below(&mut self) {
        let value: i32 in Saturating = I32::from_f64(self.negative_huge64);
        transition value == -2147483648 {
            true -> i32_nan()
            _ -> fail(72)
        }
    }

    state i32_nan(&mut self) {
        let nan64: f64 = self.zero64 / self.zero64;
        let value: i32 in Saturating = I32::from_f64(nan64);
        transition value == 0 {
            true -> i32_toward_zero()
            _ -> fail(73)
        }
    }

    state i32_toward_zero(&mut self) {
        let value: i32 in Saturating = I32::from_f64(self.fraction64);
        transition value == -1234 {
            true -> i64_above()
            _ -> fail(74)
        }
    }

    state i64_above(&mut self) {
        let value: i64 in Saturating = I64::from_f64(self.enormous64);
        transition value == 9223372036854775807 {
            true -> i64_below()
            _ -> fail(75)
        }
    }

    state i64_below(&mut self) {
        let value: i64 in Saturating = I64::from_f64(self.negative_enormous64);
        transition value < -9223372036854775000 {
            true -> i64_toward_zero()
            _ -> fail(76)
        }
    }

    state i64_toward_zero(&mut self) {
        let value: i64 in Saturating = I64::from_f64(self.large_fraction64);
        transition value == -123456789012 {
            true -> u32_above()
            _ -> fail(77)
        }
    }

    state u32_above(&mut self) {
        let value: u32 in Saturating = U32::from_f64(self.unsigned_huge64);
        transition value == 4294967295 {
            true -> u32_negative()
            _ -> fail(78)
        }
    }

    state u32_negative(&mut self) {
        let value: u32 in Saturating = U32::from_f64(self.negative_small64);
        transition value == 0 {
            true -> u32_toward_zero()
            _ -> fail(79)
        }
    }

    state u32_toward_zero(&mut self) {
        let value: u32 in Saturating = U32::from_f64(self.unsigned_fraction64);
        transition value == 3000000000 {
            true -> u32_nan()
            _ -> fail(80)
        }
    }

    state u32_nan(&mut self) {
        let nan64: f64 = self.zero64 / self.zero64;
        let value: u32 in Saturating = U32::from_f64(nan64);
        transition value == 0 {
            true -> i32_from_f32()
            _ -> fail(81)
        }
    }

    state i32_from_f32(&mut self) {
        let value: i32 in Saturating = I32::from_f32(self.huge32);
        transition value == 2147483647 {
            true -> i32_from_f32_toward_zero()
            _ -> fail(82)
        }
    }

    state i32_from_f32_toward_zero(&mut self) {
        let value: i32 in Saturating = I32::from_f32(self.fraction32);
        transition value == -7 {
            true -> i64_from_f32()
            _ -> fail(83)
        }
    }

    state i64_from_f32(&mut self) {
        let value: i64 in Saturating = I64::from_f32(self.negative_enormous32);
        transition value < -9223372036854775000 {
            true -> u32_from_f32()
            _ -> fail(84)
        }
    }

    state u32_from_f32(&mut self) {
        let value: u32 in Saturating = U32::from_f32(self.unsigned32);
        transition value == 4000000000 {
            true -> u32_from_f32_nan()
            _ -> fail(85)
        }
    }

    state u32_from_f32_nan(&mut self) {
        let nan32: f32 = self.zero32 / self.zero32;
        let value: u32 in Saturating = U32::from_f32(nan32);
        transition value == 0 {
            true -> i8_above()
            _ -> fail(86)
        }
    }

    state i8_above(&mut self) {
        let value: i8 in Saturating = I8::from_f64(self.thousand64);
        transition value == 127 {
            true -> i8_below()
            _ -> fail(87)
        }
    }

    state i8_below(&mut self) {
        let value: i8 in Saturating = I8::from_f64(self.negative_thousand64);
        transition value == -128 {
            true -> i16_below()
            _ -> fail(88)
        }
    }

    state i16_below(&mut self) {
        let value: i16 in Saturating = I16::from_f32(self.negative_million32);
        transition value == -32768 {
            true -> i16_toward_zero()
            _ -> fail(89)
        }
    }

    state i16_toward_zero(&mut self) {
        let value: i16 in Saturating = I16::from_f64(self.fraction64);
        transition value == -1234 {
            true -> u8_above()
            _ -> fail(90)
        }
    }

    state u8_above(&mut self) {
        let value: u8 in Saturating = U8::from_f64(self.three_hundred64);
        transition value == 255 {
            true -> u8_nan()
            _ -> fail(91)
        }
    }

    state u8_nan(&mut self) {
        let nan32: f32 = self.zero32 / self.zero32;
        let value: u8 in Saturating = U8::from_f32(nan32);
        transition value == 0 {
            true -> u16_negative()
            _ -> fail(92)
        }
    }

    state u16_negative(&mut self) {
        let value: u16 in Saturating = U16::from_f64(self.negative_small64);
        transition value == 0 {
            true -> u16_above()
            _ -> fail(93)
        }
    }

    state u16_above(&mut self) {
        let value: u16 in Saturating = U16::from_f32(self.seventy_thousand32);
        transition value == 65535 {
            true -> pass()
            _ -> fail(94)
        }
    }

    state pass(&self) { self.console.exit_process(70); }
    state fail(&self, code: i32) { self.console.exit_process(code); }
}
