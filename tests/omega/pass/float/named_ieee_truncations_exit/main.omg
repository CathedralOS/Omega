// Runtime float-to-integer conversions through the selected named float
// providers (exit 70): `I8`/`I16`/`I32`/`I64`/`U8`/`U16`/`U32::from_f64` and
// `from_f32` in the Saturating domain. Unqualified (Exact) conversions share
// this realization; their `requires` proof does not yet admit a runtime
// field operand, so this fixture exercises the Saturating overloads.
//
// Each conversion is one flat local initializer over field reads, so it
// executes at run time. Every conversion rounds toward zero. Saturating
// clamps to the carrier and maps NaN to zero:
//   i32: 3e9 -> 2147483647, -3e9 -> -2147483648, NaN -> 0,
//        -1234.9 -> -1234;
//   i64: 1e19 -> 9223372036854775807, -1e19 -> -9223372036854775808,
//        -123456789012.75 -> -123456789012;
//   u32: 5e9 -> 4294967295, -5.5 -> 0, 3000000000.75 -> 3000000000,
//        NaN -> 0;
//   binary32 operands: 1e10 -> i32 2147483647, -7.875 -> i32 -7,
//        -1e19 -> i64 minimum, 4e9 -> u32 4000000000, NaN -> u32 0;
//   narrow carriers: 1000 -> i8 127, -1000 -> i8 -128, -1e6 -> i16
//        -32768, -1234.9 -> i16 -1234, 300 -> u8 255, NaN -> u8 0,
//        -5.5 -> u16 0, 70000 -> u16 65535.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main {
    negative_huge64: f64;
    fraction64: f64;
    enormous64: f64;
    negative_enormous64: f64;
    large_fraction64: f64;
    unsigned_huge64: f64;
    negative_small64: f64;
    unsigned_fraction64: f64;
    zero64: f64;
    huge32: f32;
    fraction32: f32;
    negative_enormous32: f32;
    unsigned32: f32;
    zero32: f32;
    thousand64: f64;
    negative_thousand64: f64;
    negative_million32: f32;
    three_hundred64: f64;
    seventy_thousand32: f32;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut huge64: f64 = 3000000000.0;
    main.negative_huge64 = -3000000000.0;
    main.fraction64 = -1234.9;
    main.enormous64 = 10000000000000000000.0;
    main.negative_enormous64 = -10000000000000000000.0;
    main.large_fraction64 = -123456789012.75;
    main.unsigned_huge64 = 5000000000.0;
    main.negative_small64 = -5.5;
    main.unsigned_fraction64 = 3000000000.75;
    main.zero64 = 0.0;
    main.huge32 = 10000000000.0f32;
    main.fraction32 = -7.875f32;
    main.negative_enormous32 = -10000000000000000000.0f32;
    main.unsigned32 = 4000000000.0f32;
    main.zero32 = 0.0f32;
    main.thousand64 = 1000.0;
    main.negative_thousand64 = -1000.0;
    main.negative_million32 = -1000000.0f32;
    main.three_hundred64 = 300.0;
    main.seventy_thousand32 = 70000.0f32;
    let value: i32 in Saturating = I32::from_f64(huge64);
    transition value == 2147483647 {
        true -> i32_below(main)
        _ -> fail(main, 71)
    }

    state i32_below(main: &mut Main) {
        let value: i32 in Saturating = I32::from_f64(main.negative_huge64);
        transition value == -2147483648 {
            true -> i32_nan(main)
            _ -> fail(main, 72)
        }
    }

    state i32_nan(main: &mut Main) {
        let nan64: f64 = main.zero64 / main.zero64;
        let value: i32 in Saturating = I32::from_f64(nan64);
        transition value == 0 {
            true -> i32_toward_zero(main)
            _ -> fail(main, 73)
        }
    }

    state i32_toward_zero(main: &mut Main) {
        let value: i32 in Saturating = I32::from_f64(main.fraction64);
        transition value == -1234 {
            true -> i64_above(main)
            _ -> fail(main, 74)
        }
    }

    state i64_above(main: &mut Main) {
        let value: i64 in Saturating = I64::from_f64(main.enormous64);
        transition value == 9223372036854775807 {
            true -> i64_below(main)
            _ -> fail(main, 75)
        }
    }

    state i64_below(main: &mut Main) {
        let value: i64 in Saturating = I64::from_f64(main.negative_enormous64);
        transition value < -9223372036854775000 {
            true -> i64_toward_zero(main)
            _ -> fail(main, 76)
        }
    }

    state i64_toward_zero(main: &mut Main) {
        let value: i64 in Saturating = I64::from_f64(main.large_fraction64);
        transition value == -123456789012 {
            true -> u32_above(main)
            _ -> fail(main, 77)
        }
    }

    state u32_above(main: &mut Main) {
        let value: u32 in Saturating = U32::from_f64(main.unsigned_huge64);
        transition value == 4294967295 {
            true -> u32_negative(main)
            _ -> fail(main, 78)
        }
    }

    state u32_negative(main: &mut Main) {
        let value: u32 in Saturating = U32::from_f64(main.negative_small64);
        transition value == 0 {
            true -> u32_toward_zero(main)
            _ -> fail(main, 79)
        }
    }

    state u32_toward_zero(main: &mut Main) {
        let value: u32 in Saturating = U32::from_f64(main.unsigned_fraction64);
        transition value == 3000000000 {
            true -> u32_nan(main)
            _ -> fail(main, 80)
        }
    }

    state u32_nan(main: &mut Main) {
        let nan64: f64 = main.zero64 / main.zero64;
        let value: u32 in Saturating = U32::from_f64(nan64);
        transition value == 0 {
            true -> i32_from_f32(main)
            _ -> fail(main, 81)
        }
    }

    state i32_from_f32(main: &mut Main) {
        let value: i32 in Saturating = I32::from_f32(main.huge32);
        transition value == 2147483647 {
            true -> i32_from_f32_toward_zero(main)
            _ -> fail(main, 82)
        }
    }

    state i32_from_f32_toward_zero(main: &mut Main) {
        let value: i32 in Saturating = I32::from_f32(main.fraction32);
        transition value == -7 {
            true -> i64_from_f32(main)
            _ -> fail(main, 83)
        }
    }

    state i64_from_f32(main: &mut Main) {
        let value: i64 in Saturating = I64::from_f32(main.negative_enormous32);
        transition value < -9223372036854775000 {
            true -> u32_from_f32(main)
            _ -> fail(main, 84)
        }
    }

    state u32_from_f32(main: &mut Main) {
        let value: u32 in Saturating = U32::from_f32(main.unsigned32);
        transition value == 4000000000 {
            true -> u32_from_f32_nan(main)
            _ -> fail(main, 85)
        }
    }

    state u32_from_f32_nan(main: &mut Main) {
        let nan32: f32 = main.zero32 / main.zero32;
        let value: u32 in Saturating = U32::from_f32(nan32);
        transition value == 0 {
            true -> i8_above(main)
            _ -> fail(main, 86)
        }
    }

    state i8_above(main: &mut Main) {
        let value: i8 in Saturating = I8::from_f64(main.thousand64);
        transition value == 127 {
            true -> i8_below(main)
            _ -> fail(main, 87)
        }
    }

    state i8_below(main: &mut Main) {
        let value: i8 in Saturating = I8::from_f64(main.negative_thousand64);
        transition value == -128 {
            true -> i16_below(main)
            _ -> fail(main, 88)
        }
    }

    state i16_below(main: &mut Main) {
        let value: i16 in Saturating = I16::from_f32(main.negative_million32);
        transition value == -32768 {
            true -> i16_toward_zero(main)
            _ -> fail(main, 89)
        }
    }

    state i16_toward_zero(main: &mut Main) {
        let value: i16 in Saturating = I16::from_f64(main.fraction64);
        transition value == -1234 {
            true -> u8_above(main)
            _ -> fail(main, 90)
        }
    }

    state u8_above(main: &mut Main) {
        let value: u8 in Saturating = U8::from_f64(main.three_hundred64);
        transition value == 255 {
            true -> u8_nan(main)
            _ -> fail(main, 91)
        }
    }

    state u8_nan(main: &mut Main) {
        let nan32: f32 = main.zero32 / main.zero32;
        let value: u8 in Saturating = U8::from_f32(nan32);
        transition value == 0 {
            true -> u16_negative(main)
            _ -> fail(main, 92)
        }
    }

    state u16_negative(main: &mut Main) {
        let value: u16 in Saturating = U16::from_f64(main.negative_small64);
        transition value == 0 {
            true -> u16_above(main)
            _ -> fail(main, 93)
        }
    }

    state u16_above(main: &mut Main) {
        let value: u16 in Saturating = U16::from_f32(main.seventy_thousand32);
        transition value == 65535 {
            true -> pass(main)
            _ -> fail(main, 94)
        }
    }

    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
