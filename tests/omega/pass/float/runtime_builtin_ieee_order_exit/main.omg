use omega_language_std::math;

// The named min/max fixture pins ordered NaN and right-operand tie behavior.
// These identical expectations exercise builtin selection with runtime operands.
use omega_language_std::console;
use omega::language::core::float_operations;
data Main {first:f64;second:f64;tie:f64;small:f32;small_tie:f32;}
machine Main::main(main:&mut Main) reaches Console {
 let byte:ByteRead=block Console::read_byte();
 transition byte {ByteRead::Byte{value} -> compute(main,value) _ -> fail(main)}
 state compute(main:&mut Main,value:i32) {
  let one:f64=F64::from_i32(value)-48.0;
  let zero:f64=one-one;
  let nan:f64=zero/zero;
  let negative_zero:f64=zero/(zero-one);
  main.first=min_f64(nan,one);
  main.second=max_f64(one,nan);
  let tied:f64=max_f64(zero,negative_zero);
  main.tie=one/tied;
  let one32:f32=F32::from_i32(value)-48.0f32;
  let zero32:f32=one32-one32;
  let nan32:f32=zero32/zero32;
  let negative_zero32:f32=zero32/(zero32-one32);
  main.small=max_f32(nan32,one32);
  let tied32:f32=min_f32(zero32,negative_zero32);
  main.small_tie=one32/tied32;
  transition main.first == 1.0 && main.second != main.second && main.tie < 0.0
   && main.small == 1.0f32 && main.small_tie < 0.0f32 {
    true -> good(main) _ -> fail(main)
  }
 }
 state good(main:&mut Main) {Console::exit_process(70);}
 state fail(main:&mut Main) {Console::exit_process(71);}
}
