// Classification distinguishes infinity from NaN and finite values, including
// signed zero and the smallest subnormal. Both interchange formats return bool.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let zero32: f32 = 0.0f32;
    let infinity32: f32 = 1.0f32 / zero32;
    let negative32: f32 = F32::negate(infinity32);
    let nan32: f32 = zero32 / zero32;
    let positive_result32: bool = F32::is_infinite(infinity32);
    let negative_result32: bool = F32::is_infinite(negative32);
    let nan_result32: bool = F32::is_infinite(nan32);
    let zero_result32: bool = F32::is_infinite(-0.0f32);
    let subnormal_result32: bool = F32::is_infinite(1.401298464324817e-45f32);
    let finite_result32: bool = F32::is_infinite(3.4028234663852886e38f32);

    let zero64: f64 = 0.0;
    let infinity64: f64 = 1.0 / zero64;
    let negative64: f64 = F64::negate(infinity64);
    let nan64: f64 = zero64 / zero64;
    let positive_result64: bool = F64::is_infinite(infinity64);
    let negative_result64: bool = F64::is_infinite(negative64);
    let nan_result64: bool = F64::is_infinite(nan64);
    let zero_result64: bool = F64::is_infinite(-0.0);
    let subnormal_result64: bool = F64::is_infinite(4.9406564584124654e-324);
    let finite_result64: bool = F64::is_infinite(1.7976931348623157e308);

    transition {
        positive_result32 && negative_result32
            && nan_result32 == false && zero_result32 == false
            && subnormal_result32 == false && finite_result32 == false
            && positive_result64 && negative_result64
            && nan_result64 == false && zero_result64 == false
            && subnormal_result64 == false && finite_result64 == false -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
