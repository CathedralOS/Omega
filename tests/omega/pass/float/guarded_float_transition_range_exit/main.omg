// A co-located float guard discharges a declared transition requirement.
// `difference >= 0.5 && difference <= 8.0` proves the state requirements,
// including the literal on the left and a field place. Each quotient is 0.5.
use omega::language::core::float_operations;

data Gap { difference: f64; }

machine direct(start_distance: f64, end_distance: f64) -> f64
requires
    start_distance >= 0.0 && start_distance <= 4.0,
    end_distance >= -4.0 && end_distance <= 4.0,
{
    let difference: f64 = start_distance - end_distance;
    transition difference >= 0.5 && difference <= 8.0 {
        true -> admit(start_distance, difference)
        _ -> zero()
    }
    machine admit(start_distance: f64, difference: f64) -> f64
    requires
        start_distance >= 0.0 && start_distance <= 4.0,
        difference >= 0.5 && difference <= 8.0,
    {
        start_distance / difference
    }
    machine zero() -> f64 { 0.0 }
}

machine reversed(start_distance: f64, end_distance: f64) -> f64
requires
    start_distance >= 0.0 && start_distance <= 4.0,
    end_distance >= -4.0 && end_distance <= 4.0,
{
    let difference: f64 = start_distance - end_distance;
    transition 0.5 <= difference && 8.0 >= difference {
        true -> admit(start_distance, difference)
        _ -> zero()
    }
    machine admit(start_distance: f64, difference: f64) -> f64
    requires
        start_distance >= 0.0 && start_distance <= 4.0,
        difference >= 0.5 && difference <= 8.0,
    {
        start_distance / difference
    }
    machine zero() -> f64 { 0.0 }
}

machine through_field(start_distance: f64, end_distance: f64) -> f64
requires
    start_distance >= 0.0 && start_distance <= 4.0,
    end_distance >= -4.0 && end_distance <= 4.0,
{
    let gap: Gap;
    gap.difference = start_distance - end_distance;
    transition gap.difference >= 0.5 && gap.difference <= 8.0 {
        true -> admit(start_distance, gap.difference)
        _ -> zero()
    }
    machine admit(start_distance: f64, difference: f64) -> f64
    requires
        start_distance >= 0.0 && start_distance <= 4.0,
        difference >= 0.5 && difference <= 8.0,
    {
        start_distance / difference
    }
    machine zero() -> f64 { 0.0 }
}

machine main() crashes Trap {
    let direct_fraction: f64 = direct(1.0, -1.0);
    let reversed_fraction: f64 = reversed(1.0, -1.0);
    let field_fraction: f64 = through_field(1.0, -1.0);
    transition direct_fraction == 0.5 && reversed_fraction == 0.5 && field_fraction == 0.5 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
