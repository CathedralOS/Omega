// A co-located float guard discharges a declared transition range.
// `difference >= 0.5 && difference <= 8.0` proves `f64 [0.5..=8.0]`,
// including the literal on the left and a field place. Each quotient is 0.5.
use omega::language::core::float_operations;

data Gap { difference: f64; }

machine direct(start_distance: f64 [0.0..=4.0], end_distance: f64 [-4.0..=4.0]) -> f64 in Finite {
    let difference: f64 = start_distance - end_distance;
    transition difference >= 0.5 && difference <= 8.0 {
        true -> admit(start_distance, difference)
        _ -> zero()
    }
    state admit(start_distance: f64 [0.0..=4.0], difference: f64 [0.5..=8.0]) -> f64 in Finite {
        start_distance / difference
    }
    state zero() -> f64 in Finite { 0.0 }
}

machine reversed(start_distance: f64 [0.0..=4.0], end_distance: f64 [-4.0..=4.0]) -> f64 in Finite {
    let difference: f64 = start_distance - end_distance;
    transition 0.5 <= difference && 8.0 >= difference {
        true -> admit(start_distance, difference)
        _ -> zero()
    }
    state admit(start_distance: f64 [0.0..=4.0], difference: f64 [0.5..=8.0]) -> f64 in Finite {
        start_distance / difference
    }
    state zero() -> f64 in Finite { 0.0 }
}

machine through_field(start_distance: f64 [0.0..=4.0], end_distance: f64 [-4.0..=4.0]) -> f64 in Finite {
    let gap: Gap;
    gap.difference = start_distance - end_distance;
    transition gap.difference >= 0.5 && gap.difference <= 8.0 {
        true -> admit(start_distance, gap.difference)
        _ -> zero()
    }
    state admit(start_distance: f64 [0.0..=4.0], difference: f64 [0.5..=8.0]) -> f64 in Finite {
        start_distance / difference
    }
    state zero() -> f64 in Finite { 0.0 }
}

machine main() crashes Trap {
    let direct_fraction: f64 in Finite = direct(1.0, -1.0);
    let reversed_fraction: f64 in Finite = reversed(1.0, -1.0);
    let field_fraction: f64 in Finite = through_field(1.0, -1.0);
    transition direct_fraction == 0.5 && reversed_fraction == 0.5 && field_fraction == 0.5 {
        true -> done()
        _ -> bad()
    }
    state done() { }
    state bad() { crash Trap; }
}
