use omega::language::core::float_operations;

data Observation [copy] {
    maximum: f32 in Finite & Saturating;
    clamped: f32 in Saturating;
    infinite: f32 in Saturating;
    unordered: f32 in Saturating;
}

// The constructor must retain each requirement's operand-selected adapter:
// finite multiplication overflow clamps; division by zero and NaN stay IEEE.
machine observe(maximum: f32 in Finite & Saturating, zero: f32 in Saturating) -> Observation {
    Observation {
        maximum: maximum,
        clamped: maximum * 2.0f32,
        infinite: maximum / zero,
        unordered: zero / zero
    }
}

// Read through an ordinary shared record parameter. All fields retain their
// original domains and are checked against the constructor's own input copy.
machine verify(observed: &Observation) crashes Trap {
    transition observed.clamped == observed.maximum {
        true -> infinity(observed)
        false -> bad()
    }
    machine infinity(observed: &Observation) {
        transition observed.infinite > observed.maximum {
            true -> nan(observed)
            false -> bad()
        }
    }
    machine nan(observed: &Observation) {
        transition observed.unordered != observed.unordered {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let maximum: f32 in Finite & Saturating = 3.4028234663852886e38f32 as f32 in Saturating;
    let zero: f32 in Saturating = 0.0f32 as f32 in Saturating;
    let observed: Observation = observe(maximum, zero);
    verify(&observed);
}
