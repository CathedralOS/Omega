// Trapping named conversion must reject unordered input, not return an ISA sentinel.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let nan: f64 = 0.0f64 / 0.0;
    let converted: i32 in Trapping = I32::from_f64(nan);
    Console::exit_process(converted as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
