use omega::language::core::float_operations;
data Value { integer: i32; }
machine guarded(value: i32) -> f64 {
    transition value > 0 { true -> F64::from_i32(value) false -> (F64::from_i32(value)) }
}
machine unconditional(value: i32) -> f64 {
    transition { _ -> F64::from_i32(value) }
}
machine field(value: &Value) -> f64 {
    transition { _ -> F64::from_i32(value.integer) }
}
machine equivalent(value: i32) -> f64 {
    let converted: f64 = F64::from_i32(value);
    converted
}
machine main() crashes Trap {
    let object: Value = Value { integer: 7 };
    let first: f64 = guarded(7);
    let negative: f64 = guarded(-7);
    let second: f64 = unconditional(7);
    let third: f64 = field(&object);
    let fourth: f64 = equivalent(7);
    transition first == 7.0 && negative == -7.0 && second == third && third == fourth {
        true -> done() false -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
