use omega::language::core::float_operations;

machine sample() -> f64 ensures result == 0.1f64 { 0.1 }

machine rounded() -> f32 ensures result == 0.1f32 { F32::from_f64(sample()) }

machine open_window(value: f64) -> f64
requires value >= 0.0 && value < 1.0
ensures result >= 0.0 && result < 1.0
{ value }

machine main() crashes Trap {
    let value: f32 = rounded();
    let inside: f64 = open_window(0.5);
    transition value == 0.1f32 && inside == 0.5f64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
