use omega::language::core::float_operations;

domain f32::Measured;
domain f64::Measured;
domain f64::Distance = f64::Measured;
domain i32::Measured;

machine sample() -> f32 { 3.0f32 }
machine narrow() -> f32 in Measured { 3.0f64 as f32 in Measured }
machine integer() -> i32 in Measured { 3.0f64 as i32 in Measured }
machine format_widen() -> f64 in Measured { sample() as f64 in Measured }
machine widen(value: i16) -> f64 in Measured { value as f64 in Measured }
machine observe(value: f64 in Measured) -> f64 { value as f64 }

machine main() crashes Trap {
    let narrowed: f32 in Measured = narrow();
    let integral: i32 in Measured = integer();
    let widened: f64 in Measured = widen(-7i16);
    let formatted: f64 in Measured = format_widen();
    let copied: f64 in Measured = widened;
    let argument: f64 = observe(copied);
    let inline: f64 = observe(11i16 as f64 in Measured);
    let alias: f64 = observe(12i16 as f64 in Distance);
    transition (narrowed as f32) == 3.0f32 && (integral as i32) == 3
        && (widened as f64) == -7.0f64 && argument == -7.0f64 && inline == 11.0f64
        && (formatted as f64) == 3.0f64 && alias == 12.0f64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
