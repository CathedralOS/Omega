// RUN CANARY (exit 70). A float field bounded by its owner's data `where`
// fact runs through attached data. The declaration predicate roster carries
// `value >= 0.0 && value <= 1.0` into Terminal as one IEEE comparison row in
// `f32`: `fill` requires it at entry, its transient 2.0 opens an invariant
// window that the 0.25 store closes, and the row it restores at return is
// proved from the stored bits. `main` then reads the field back.
//
// Migrated from `pending/float/float_range_attached_field`, whose bracketed
// field range `f32 [0.0..=1.0]` omitted the machine's unit plan at the
// attached data shape and left the field unused.
use omega::language::core::float_operations;
use omega_language_std::console;

data Main
where
    value >= 0.0 && value <= 1.0,
{
    value: f32;
}

machine Main::fill(main: &mut Main) {
    main.value = 2.0;
    main.value = 0.25;
}

machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> step(main) }

    state step(main: &mut Main) {
        Main::fill(main);
        transition main.value == 0.25 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }

    state bad(main: &mut Main) { Console::exit_process(71); }
}
