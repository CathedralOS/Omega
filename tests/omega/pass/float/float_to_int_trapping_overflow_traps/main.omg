use omega::language::core::float_operations;

// F4: a policy-tagged out-of-range float-to-int cast traps before the exit.
use omega::language::std::console;
data Main { console: Console; value: f64; out: i32; }
machine Main::main(&mut self) {
    self.value = 100000000000000000000.0;
    self.out = (self.value as i32 in Trapping) as i32;
    self.console.exit_process(70);
}
machine Main::run(&mut self) { self.main(); }
