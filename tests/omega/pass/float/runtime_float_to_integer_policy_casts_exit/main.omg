// Float-to-integer policy casts execute through their selected conversion
// (exit 70). `value as i32 in Saturating` selects the destination-owned
// `I32::from_f64` overload whose result is `i32 in Saturating`: toward-zero
// truncation that clamps to the carrier and maps NaN to zero. The casts sit
// in a field store, a qualified local, an erased local, a guard operand and
// over a nested float application, for f64 and f32 sources and signed and
// unsigned destinations:
//   3e9 -> i32 2147483647, -3e9 -> i32 -2147483648, NaN -> i32 0,
//   -7.9 -> i32 -7 (guard), 20 * 1.8 + 32 -> i32 68,
//   300.5 -> u8 255, -5.5 -> u8 0, -40000.75f32 -> i16 -32768.
// Each wrong value exits with its own code between 71 and 78.
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    negative_huge: f64;
    zero: f64;
    fraction: f64;
    celsius: f64;
    above_byte: f64;
    below_byte: f64;
    below_short: f32;
}

machine Main::main(&mut self) reaches Console {
    let mut huge: f64 = 3000000000.0;
    self.negative_huge = -3000000000.0;
    self.zero = 0.0;
    self.fraction = -7.9;
    self.celsius = 20.0;
    self.above_byte = 300.5;
    self.below_byte = -5.5;
    self.below_short = -40000.75f32;
    let mut high: i32 = (huge as i32 in Saturating) as i32;
    transition high == 2147483647 {
        true -> low(&mut self)
        _ -> fail(&mut self, 71)
    }

    state low(main: &mut Main) {
        let low: i32 in Saturating = main.negative_huge as i32 in Saturating;
        let low_value: i32 = low as i32;
        transition low_value == -2147483648 {
            true -> nan(main)
            _ -> fail(main, 72)
        }
    }

    state nan(main: &mut Main) {
        let nan: f64 = main.zero / main.zero;
        let nan_value: i32 = (nan as i32 in Saturating) as i32;
        transition nan_value == 0 {
            true -> guard(main)
            _ -> fail(main, 73)
        }
    }

    state guard(main: &mut Main) {
        transition (main.fraction as i32 in Saturating) as i32 == -7 {
            true -> nested(main)
            _ -> fail(main, 74)
        }
    }

    state nested(main: &mut Main) {
        let mut fahrenheit: i32 = ((main.celsius * 1.8 + 32.0) as i32 in Saturating) as i32;
        transition fahrenheit == 68 {
            true -> unsigned_high(main)
            _ -> fail(main, 75)
        }
    }

    state unsigned_high(main: &mut Main) {
        let mut byte_high: u8 = (main.above_byte as u8 in Saturating) as u8;
        transition byte_high == 255 {
            true -> unsigned_low(main)
            _ -> fail(main, 76)
        }
    }

    state unsigned_low(main: &mut Main) {
        let byte_low: u8 = (main.below_byte as u8 in Saturating) as u8;
        transition byte_low == 0 {
            true -> short_low(main)
            _ -> fail(main, 77)
        }
    }

    state short_low(main: &mut Main) {
        let mut short_low: i16 = (main.below_short as i16 in Saturating) as i16;
        transition short_low == -32768 {
            true -> good(main)
            _ -> fail(main, 78)
        }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state fail(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
