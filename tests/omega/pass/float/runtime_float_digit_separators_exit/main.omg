// Digit grouping changes spelling, never the exact value or its landing.
// The grouped precision witness also distinguishes one exact rounding to f32
// from an intermediate f64 rounding. Every check must return normally; a mismatch traps.
use omega::language::core::float_operations;

data Main {
    expected: f32;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.expected = 1.000_000_119_209_289_550_781_25;
    transition { _ -> check(main, 1.0 + 0.0000000596046483281043038005) }

    state check(main: &mut Main, got: f32) {
        let decimal: f64 = 1_250.5_0;
        let exponent: f64 = 1.25e+0_3;
        let negative: f64 = -1_25.0E-0_2;
        let leading: f32 = .1_2_5f32;
        let hexadecimal: u32 = 0x0_4_E2;
        let rounding: f32 = 8_388_609.4_999_999_999_999_99f32;
        transition got == main.expected
            && decimal == 1250.5
            && exponent == 1250.0
            && negative == -1.25
            && leading == 0.125f32
            && hexadecimal == 1250
            && rounding == 8388609.0f32 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {}
    state bad(main: &mut Main) { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
