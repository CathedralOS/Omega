// Effectful calls as match subject AND patterns: evaluation is
// left-to-right — the subject runs once, each pattern runs until the
// first hit; `calls` counts 1 subject + 2 pattern evaluations; an
// unselected arm never evaluates `divide(0)`.
use omega::language::core::float_operations;

machine divide(value: i64) -> i64 {
    let numerator: i64 in Trapping = 7;
    (numerator / (value as i64 in Trapping)) as i64
}

machine observe32(calls: &mut i32 in Wrapping, value: f32) -> f32 {
    calls = calls + 1;
    value
}

machine ordered32() -> i32 {
    let mut calls: i32 in Wrapping = 0;
    let result: i64 = match observe32(&mut calls, 2.0f32) {
        observe32(&mut calls, 1.0f32) -> 99,
        observe32(&mut calls, 2.0f32) -> 7,
        observe32(&mut calls, 3.0f32) -> divide(0),
        _ -> divide(0)
    };
    transition result == 7 && calls == 3 { true -> 7 false -> 0 }
}

data Main {}

machine Main::main(main: &mut Main) {
    transition ordered32() == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
