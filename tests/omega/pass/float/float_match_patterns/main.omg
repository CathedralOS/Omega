use omega::language::core::float_operations;
// Floating match subjects dispatch through ordinary value patterns in
// both formats; a parameter name used as a pattern means "subject equals
// this value", `_` catches the rest.
data Narrow [copy] { left: f32; right: f32; }
data Wide { left: f64; right: f64; }
machine choose_projected32(pair: Narrow, first: f32, second: f32) -> i64 {
    match pair.left { first -> 7, second -> 9, _ -> 11 }
}
machine choose_computed64(a: f64, b: f64, first: f64, second: f64) -> i64 {
    match a * b { first -> 7, second -> 9, _ -> 11 }
}
data Main { pair: Narrow; wide: Wide; }
machine Main::main(main: &mut Main) {
    main.pair = Narrow { left: 2.0f32, right: 1.0f32 };
    main.wide = Wide { left: 0.5f64, right: 4.0f64 };
    let picked32: i64 = choose_projected32(main.pair, 1.0f32, 2.0f32);
    let picked64: i64 = choose_computed64(main.wide.left, main.wide.right, 1.0f64, 2.0f64);
    transition picked32 == 9 && picked64 == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
