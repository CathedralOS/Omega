// Expected exit: 0. A literal result still needs the surrounding parameter
// facts when its postcondition compares that result with another operand.
use omega::language::core::float_operations;
machine literal_return(limit:f64) -> f64
requires limit >= 0.0 && limit <= 1.0
ensures result <= limit
{ 0.0 }
machine main() crashes Trap {
 let observed:f64=literal_return(0.25);
 transition observed == 0.0 { true -> done() false -> bad() }
 state done() { }
 state bad() { crash Trap; }
}
