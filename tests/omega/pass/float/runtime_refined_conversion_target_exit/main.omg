use omega::language::core::float_operations;

machine sample() -> f64[3.0..=3.0] { 3.0 }
machine integer() -> i32 { sample() as i32[3..=3] }
machine narrow() -> f32 { sample() as f32[3.0..=3.0] }

machine main() crashes Trap {
    let integral: i32 = integer();
    let narrowed: f32 = narrow();
    transition integral == 3 && narrowed == 3.0f32 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
