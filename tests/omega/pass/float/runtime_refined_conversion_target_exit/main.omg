use omega::language::core::float_operations;

machine sample() -> f64 ensures result == 3.0 { 3.0 }
machine integer() -> i32 ensures result == 3 { sample() as i32 }
machine narrow() -> f32 ensures result == 3.0f32 { sample() as f32 }

machine main() crashes Trap {
    let integral: i32 = integer();
    let narrowed: f32 = narrow();
    transition integral == 3 && narrowed == 3.0f32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
