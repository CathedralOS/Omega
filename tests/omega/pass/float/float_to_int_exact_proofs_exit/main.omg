use omega::language::core::float_operations;

// F4: Exact float-to-int accepts a declared finite range and a sole incoming
// guard that proves non-NaN plus both range bounds.
use omega_language_std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
    bounded: f64 [0.0..=100.0];
    unbounded: f64;
    a: i32;
    b: i32;
}
machine Main::main(main: &mut Main) reaches Console {
    main.bounded = 77.9;
    main.a = main.bounded as i32;
    main.unbounded = 42.5;
    transition main.unbounded == main.unbounded
        && main.unbounded >= 0.0 && main.unbounded <= 100.0 {
        true -> guarded(main)
        _ -> bad(main)
    }
    state guarded(main: &mut Main) {
        main.b = main.unbounded as i32;
        transition main.a == 77 && main.b == 42 { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) { main.console.exit_process(78); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
machine Main::run(main: &mut Main) { Main::main(main); }
