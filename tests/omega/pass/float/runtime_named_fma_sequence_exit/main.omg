// Each fused cancellation retains a positive residual; multiply-then-add
// rounds the product first and yields zero. Reusing the residual in another
// FMA also exercises ordinary runtime operand transport, not constant folding.
use omega::language::core::float_operations;
use omega_language_std::console;

machine repeated_fma(value: f64) -> f64 {
    F64::fused_multiply_add(value, 1.0, 0.0)
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let next32: f32 = 1.00000011920928955078125;
    let cancel32: f32 = 0.0f32 - 1.0000002384185791015625;
    let fused32: f32 = F32::fused_multiply_add(next32, next32, cancel32);
    let separate32: f32 = F32::multiply_then_add(next32, next32, cancel32);
    let next64: f64 = 1.0000000000000002220446049250313080847263336181640625;
    let cancel64: f64 = 0.0 - 1.000000000000000444089209850062616169452667236328125;
    let fused64: f64 = F64::fused_multiply_add(next64, next64, cancel64);
    let separate64: f64 = F64::multiply_then_add(next64, next64, cancel64);
    let repeated64: f64 = repeated_fma(fused64);
    transition fused32 > 0.0f32 && separate32 == 0.0f32 &&
        fused64 > 0.0 && separate64 == 0.0 && repeated64 == fused64 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
