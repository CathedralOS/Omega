use omega::language::core::float_operations;

use omega::language::std::console;
data Main {
    console: Console;
    zero: f32 in Trapping;
    result: f32 in Trapping;
}
machine Main::main(&mut self) {
    self.zero = 0.0;
    self.result = self.zero / self.zero;
    self.console.exit_process(70);
}
