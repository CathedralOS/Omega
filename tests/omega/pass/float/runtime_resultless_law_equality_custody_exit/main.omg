// Expected exit: 70. Theorem-slot equality keeps its proposition identity
// through f32/f64 realization copies; runtime IEEE equality remains ordered.
use omega::language::core::float_operations;
use omega_language_std::console;

trait Reflexive<T> {
    machine same(value: T)
    ensures value == value;
}
machine same32(value: f32)
satisfies Reflexive<f32>::same
ensures value == value
{ }
machine same64(value: f64)
satisfies Reflexive<f64>::same
ensures value == value
{ }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    same32(1.0f32);
    same64(1.0f64);
    let nan32: f32 = 0.0f32 / 0.0f32;
    let nan64: f64 = 0.0f64 / 0.0f64;
    let zero32: f32 = F32::negate(0.0f32);
    let zero64: f64 = F64::negate(0.0f64);
    transition nan32 != nan32 && nan64 != nan64
        && !(nan32 == nan32) && !(nan64 == nan64)
        && zero32 == 0.0f32 && zero64 == 0.0f64 {
        true -> pass(main)
        false -> fail(main)
    }
    state pass(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main) { Console::exit_process(71); }
}
