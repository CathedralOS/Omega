use omega::language::core::float_operations;

machine finite_value(value: f32) -> f32
requires F32::is_finite(value) { value }

machine finite_wide(value: f64) -> f64
requires F64::is_finite(value) { value }

machine converted(value: i32) -> f32 {
    finite_value(F32::from_i32(value))
}

machine converted_wide(value: u64) -> f64 {
    finite_wide(F64::from_u64(value))
}

machine converted_wrapping(value: u8 in Wrapping) -> f32 {
    finite_value(F32::from_u8(value + (10u8 as u8 in Wrapping)))
}

machine nested(value: i32) -> f32 {
    transition { _ -> convert(value) }
    machine convert(input: i32) -> f32 {
        finite_value(F32::from_i32(input))
    }
}

data IntegerSlot { value: i32; }

machine replace(slot: &mut IntegerSlot) -> bool {
    slot.value = 9i32;
    true
}

machine finite_captured(value: f32, replaced: bool) -> f32
requires F32::is_finite(value) { value }

// The completed conversion stays finite even when a later actual changes its
// source. This does not grant replay identity to either runtime invocation.
machine captured_conversion(value: i32) -> f32 {
    let mut slot: IntegerSlot = IntegerSlot { value: value };
    finite_captured(F32::from_i32(slot.value), replace(&mut slot))
}

machine main() crashes Trap {
    let rounded: f32 = converted(16777217i32);
    let wide: f64 = converted_wide(18446744073709551615u64);
    let wrapped: f32 = converted_wrapping(250u8 as u8 in Wrapping);
    let nested_result: f32 = nested(-16777217i32);
    let captured_result: f32 = captured_conversion(16777217i32);
    transition rounded == 16777216.0f32 && wide == 18446744073709551616.0f64
        && wrapped == 4.0f32 && nested_result == -16777216.0f32
        && captured_result == 16777216.0f32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
