use omega::language::core::float_operations;

data Reading { amount: f32 in Finite; }

machine read(value: &Reading) -> f32 in Finite { value.amount }

machine main() crashes Trap {
    let mut value: Reading = Reading { amount: 0.5 };
    value.amount = 0.0f32 / 0.0;
    value.amount = 0.75;
    let observed: f32 in Finite = read(&value);
    transition observed == 0.75 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
