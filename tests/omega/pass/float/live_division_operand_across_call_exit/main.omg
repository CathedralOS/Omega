data Checksum { sum: i32 in Saturating; }

machine accumulate(sink: &mut Checksum, digit: i32 in Saturating) {
    sink.sum = sink.sum + digit;
}

machine digits(sink: &mut Checksum, value: i64 in Saturating) {
    transition { _ -> step(sink, value, 100000000000) }
    machine step(sink: &mut Checksum, value: i64 in Saturating, divisor: i64 in Saturating)
    requires divisor >= 1
    {
        let digit: i64 in Saturating = (value / divisor) % 10;
        accumulate(sink, digit as i32 in Saturating);
        transition divisor >= 10 {
            true -> step(sink, value, divisor / 10)
            false -> done()
        }
    }
    machine done() {}
}

machine main() crashes Trap {
    let mut sink: Checksum;
    digits(&mut sink, 123456);
    transition sink.sum == 21 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
