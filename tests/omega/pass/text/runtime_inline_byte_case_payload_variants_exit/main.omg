// An inline byte field selected through a case payload is observed in place:
// its comparison and live length read the selected case's own storage. The
// payload arrives as a parameter, a local copy, a record field holding the
// sum, and a call result delivered to another state.
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Reply [copy] {
    sequence: u64;
    case Empty;
    case Message(content: [u8; 8] in Utf8);
}
data Envelope [copy] { tag: u64; reply: Reply; }

machine make(content: [u8; 8] in Utf8) -> Reply {
    Reply::Message { content: content, sequence: 3 }
}
machine size(bytes: &[u8]) -> u64 { bytes.len }
machine local_matches(reply: Reply) -> bool {
    transition reply {
        Reply::Message { sequence as _, content } -> (content == "Local" && size(&content) == 5)
        Reply::Empty -> (false)
    }
}
machine field_matches(envelope: &Envelope) -> bool {
    transition envelope.reply {
        Reply::Message { sequence as _, content } -> (content == "Field" && size(&content) == 5)
        Reply::Empty -> (false)
    }
}
machine main() crashes Trap {
    let local: Reply = make("Local");
    let copied: Reply = local;
    let envelope: Envelope = Envelope { tag: 9, reply: make("Field") };
    let valid: bool = local_matches(local) && local_matches(copied)
        && field_matches(&envelope);
    transition valid { true -> other(make("State")) false -> bad() }
    state other(reply: Reply) {
        transition reply {
            Reply::Message { sequence as _, content } -> check(content == "State" && size(&content) == 5)
            Reply::Empty -> bad()
        }
    }
    state check(valid: bool) {
        transition valid { true -> done() false -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}
