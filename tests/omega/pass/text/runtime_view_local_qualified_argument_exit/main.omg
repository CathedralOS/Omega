// A view local declared `in Utf8` keeps that domain through reassignment, so
// it satisfies a formal that requires valid UTF-8.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Room [copy] { label: &[u8] in Utf8; }
data Main { source: Room; }

machine measure(text: &[u8] in Utf8) -> u64 {
    text.len
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.label = "Gate!";
    let mut out_line: &[u8] in Utf8 = "Door";
    out_line = main.source.label;
    let n: u64 = measure(out_line);
    transition n == 5 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
