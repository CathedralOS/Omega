// Exact three-byte owned arrays lend ordinary qualified views.
// Runtime indexes and state forwarding preserve the authored numerical oracle.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::numeric_conversion;

machine digit_sum(text: &[u8; 3] in Utf8) -> i32 in Wrapping {
    transition {
        _ -> step(text, 0, 0)
    }

    state step(text: &[u8; 3] in Utf8, index: i32, sum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0
    {
        transition index < text.len {
            true -> digit(text, index, sum)
            _ -> (sum)
        }
    }

    state digit(text: &[u8; 3] in Utf8, index: i32, sum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0
    {
        let byte: u8 = text[index];
        let value: i32 in Wrapping = (widen_u8_to_i32(byte) as i32 in Wrapping) - 48;
        let next_sum: i32 in Wrapping = sum + value;
        transition index >= 0 && index < 8 {
            true -> advance(text, index, next_sum)
            _ -> (next_sum)
        }
    }

    state advance(text: &[u8; 3] in Utf8, index: i32, sum: i32 in Wrapping) -> i32 in Wrapping
    requires index >= 0 && index < 8
    {
        let next_index: i32 = index + 1;
        transition {
            _ -> step(text, next_index, sum)
        }
    }
}

machine live_length(text: &[u8; 3] in Utf8) -> u64 {
    transition {
        _ -> (text.len)
    }
}

machine forwarded_length(text: &[u8; 3] in Utf8) -> u64 {
    transition {
        _ -> measure(text)
    }

    state measure(text: &[u8; 3] in Utf8) -> u64 {
        transition {
            _ -> (text.len)
        }
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let text: [u8; 3] in Utf8 = "150";
    let sum: i32 in Wrapping = digit_sum(&text);
    let length: u64 = live_length(&text);
    let forwarded: u64 = forwarded_length(&text);
    transition sum == 6 && length == 3 && forwarded == 3 {
        true -> finish(70)
        _ -> finish(71)
    }

    state finish(code: i32) {
        Console::exit_process(code);
    }
}
