// A reassigned borrowed-view local lends its current descriptor to an
// ordinary call: the callee observes the second view's extent, not the first.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }

machine count(bytes: &[u8]) -> u64 {
    bytes.len
}

machine Main::main(main: &mut Main) reaches Console {
    let mut view: &[u8] = "Door";
    view = "Gate!";
    let n: u64 = count(view);
    transition n == 5 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
