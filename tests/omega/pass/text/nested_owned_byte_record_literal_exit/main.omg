use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Direction [copy] { case North; case South; }
data Label [copy] { text: [u8; 8] in Utf8; sibling: u64; }
data Entry [copy] { label: Label; direction: Direction; sibling: u64; }
data Main { entry: Entry; }

machine empty_entry() -> Entry {
    Entry { label: Label { text: "", sibling: 29 }, direction: Direction::North, sibling: 31 }
}

machine named_entry() -> Entry {
    Entry { label: Label { text: "Gate", sibling: 37 }, direction: Direction::South, sibling: 41 }
}

machine Main::main(main: &mut Main) reaches Console {
    main.entry = empty_entry();
    let empty_matches: bool = main.entry.label.text == ""
        && main.entry.label.text.len == 0
        && main.entry.label.sibling == 29
        && main.entry.direction == Direction::North
        && main.entry.sibling == 31;
    main.entry = named_entry();
    transition empty_matches
        && main.entry.label.text == "Gate"
        && main.entry.label.text.len == 4
        && main.entry.label.sibling == 37
        && main.entry.direction == Direction::South
        && main.entry.sibling == 41 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
