// Regression: in-place append to a bounded UTF-8 machine field. The original
// legacy-String route materialized into scratch before appending and once lost
// the "prefix " content. The carrier route has no descriptor or scratch: after
// the reaching-length proof establishes 7 + 5 <= 16, it appends directly to
// the inline bytes and updates the stored length.

domain [u8; 16]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Main {
    console: Console;
    line: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.line = "prefix ";
    self.line = self.line + "omega";
    self.console.write_line(self.line);

    transition self.line == "prefix omega" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
