// Reassigning an initialized borrowed-view local replaces its descriptor.
// A read before the replacement observes the first value, and a read after
// it observes the second.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut out_line: &[u8] in Utf8 = "Gate";
    let first: bool = out_line == "Gate";
    out_line = "Door";
    transition first && out_line == "Door" {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
