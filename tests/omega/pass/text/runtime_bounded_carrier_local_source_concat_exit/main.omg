// #66 owned carrier concat over a FRAME-LOCAL struct-field source, with a FRAME
// carrier field write: `let room: Room; room.label = "Gate"; out_line = "== " +
// room.label + " =="`. Two frame-resident carrier pieces exercised together:
//   * `room.label = "Gate"` writes the carrier `{len, bytes}` off the runtime
//     FRAME base (a `[u8; 8]` carrier is 16 bytes = the String descriptor size, so
//     without the frame case it was mis-written as a `{ptr, len}` descriptor); and
//   * the concat reads `room.label` (a runtime value, not folded) off the frame
//     base via the source-append's `source_in_frame` path.
// Renders "== Gate ==" into the borrowed carrier, exits 70 (the interpreter agrees).
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
domain [u8; 16]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Room {
    label: [u8; 8] in Utf8;
}

data Formatter {
}

machine Formatter::render(&mut self, out_line: &mut [u8; 16] in Utf8) {
    let room: Room;
    room.label = "Gate";
    out_line = "== " + room.label + " ==";
}

data Main {
    console: Console;
    formatter: Formatter;
    line: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.line = "";
    self.formatter.render(&mut self.line);

    transition self.line == "== Gate ==" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
