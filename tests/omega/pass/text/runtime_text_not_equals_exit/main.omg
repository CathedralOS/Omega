// RUN CANARY (exit 70) + interpreter differential. Text INEQUALITY (`!=`)
// in value and guard positions, including the EQUAL-STRINGS leg -- the pin:
// the CompareRuntimeTextStorage encoders IGNORED the negation flag on both
// ISAs, so `!=` behaved as `==` in the frame-slot text-comparison writer's
// preset-1/compare/write-0 pattern (`name != "omega"` with equal strings
// kept the preset 1; native 73 vs interp 70). The encoders now swap which
// outcome takes the external skip under the flag (aarch64: interior branch
// targets; x86: fixup-list routing) -- same widths, same instruction count.
// The unequal-string legs alone CANNOT catch this (they pass under either
// flavor); only the equal-strings `!=` leg distinguishes them.
// exits: 71 = store !=/unequal wrong; 72 = let !=/unequal (place) wrong;
// 73 = equal-strings != read TRUE (the regression face); 74 = guard != wrong.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
data Main { shift: u64; name: [u8; 5] in Utf8; other: [u8; 5] in Utf8; okf: bool; }
machine Main::main(main: &mut Main) {
    main.name = "omega";
    main.other = "delta";
    Main::build(main);
}
machine Main::build(main: &mut Main) reaches Console {
    main.okf = main.name != "wrong";
    transition main.okf {
        true -> leg2(main)
        _ -> wrong_store(main)
    }
    machine leg2(main: &mut Main) {
        let l: bool = main.name != main.other;
        transition l {
            true -> leg3(main)
            _ -> wrong_let_place(main)
        }
    }
    machine leg3(main: &mut Main) {
        let eqfalse: bool = main.name != "omega";
        transition eqfalse {
            true -> wrong_equal_ne(main)
            _ -> leg4(main)
        }
    }
    machine leg4(main: &mut Main) {
        transition main.name != "omega" {
            true -> wrong_guard(main)
            _ -> good(main)
        }
    }
    machine good(main: &mut Main)           { Console::exit_process(70); }
    machine wrong_store(main: &mut Main)    { Console::exit_process(71); }
    machine wrong_let_place(main: &mut Main){ Console::exit_process(72); }
    machine wrong_equal_ne(main: &mut Main) { Console::exit_process(73); }
    machine wrong_guard(main: &mut Main)    { Console::exit_process(74); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
