// Regression: chained in-place appends on a bounded UTF-8 carrier across
// separate statements (`x = "a"; x = x + "b"; x = x + "c";`) then a guard
// `x == "abc"`. The checker follows the running byte length (1, 2, 3), each
// append extends the carrier's inline bytes at its current length, and the
// guard reads that updated carrier rather than a stale legacy scratch buffer.

domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    line: [u8; 16] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.line = "a";
    main.line = main.line + "b";
    main.line = main.line + "c";
    Console::write_line(main.line);

    transition main.line == "abc" {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
