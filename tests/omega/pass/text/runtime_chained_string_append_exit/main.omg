// Regression: chained in-place appends on a bounded UTF-8 carrier across
// separate statements (`x = "a"; x = x + "b"; x = x + "c";`) then a guard
// `x == "abc"`. The checker follows the running byte length (1, 2, 3), each
// append extends the carrier's inline bytes at its current length, and the
// guard reads that updated carrier rather than a stale legacy scratch buffer.

domain [u8; 16]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Main {
    console: Console;
    line: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.line = "a";
    self.line = self.line + "b";
    self.line = self.line + "c";
    self.console.write_line(self.line);

    transition self.line == "abc" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
