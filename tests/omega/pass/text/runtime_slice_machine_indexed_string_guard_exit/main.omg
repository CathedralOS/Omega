domain [u8]::Utf8
requires
    valid_utf8(self);
// A frame-held slice descriptor indexed by a machine field exercises the
// cross-region descriptor write: the descriptor base is in the runtime frame,
// while the selected element index is reloaded from machine storage.
use omega_language_std::console;

data Room {
    label: &[u8] in Utf8;
}

data Main {
    console: Console;
    rooms: [Room; 3];
    index: u64 [0..=2];
}

machine Main::main(&mut self) {
    let room_slice: &mut [Room] = self.rooms.as_mut_slice();
    self.index = 1;
    room_slice[self.index].label = "expected";
    self.index = 2;
    room_slice[self.index].label = "expectes";
    self.index = 0;

    transition room_slice[self.index].label == "expected" {
        true -> fail()
        false -> check_match()
    }

    state check_match(&mut self) {
        let room_slice: &mut [Room] = self.rooms.as_mut_slice();
        self.index = 1;
        transition room_slice[self.index].label == "expected" {
            true -> check_differ()
            false -> fail()
        }
    }

    state check_differ(&mut self) {
        let room_slice: &mut [Room] = self.rooms.as_mut_slice();
        self.index = 2;
        transition room_slice[self.index].label == "expected" {
            true -> fail()
            false -> pass()
        }
    }

    state pass(&mut self) {
        self.console.exit_process(72);
    }

    state fail(&mut self) {
        self.console.exit_process(73);
    }
}
