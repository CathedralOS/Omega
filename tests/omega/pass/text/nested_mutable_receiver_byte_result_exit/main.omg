use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Labels [copy] { first: [u8; 8] in Utf8; second: [u8; 8] in Utf8; }
data Main { generated: u64 in Wrapping; observed: Labels; }

machine Main::next_label(main: &mut Main) -> [u8; 8] in Utf8 {
    main.generated = main.generated + 1;
    transition main.generated == 1 {
        true -> "North"
        false -> "N"
    }
}

machine ordered(first: [u8; 8] in Utf8, second: [u8; 8] in Utf8, destination: &mut Labels) {
    destination.first = first;
    destination.second = second;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut labels: Labels;
    let first_label: [u8; 8] in Utf8 = Main::next_label(main);
    let second_label: [u8; 8] in Utf8 = Main::next_label(main);
    ordered(first_label, second_label, &mut labels);
    main.observed.first = labels.first;
    main.observed.second = labels.second;
    transition main.observed.first == "North" && main.observed.first.len == 5
        && main.observed.second == "N" && main.observed.second.len == 1
        && main.generated == 2 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
