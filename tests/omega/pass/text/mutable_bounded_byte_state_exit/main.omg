use omega_language_std::console;

domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
data Main {
    line: [u8; 16] in Utf8;
    sibling: u64;
}

machine replace(output: &mut [u8; 16] in Utf8)
ensures output in Utf8
{
    transition { _ -> first(output) }
    state first(output: &mut [u8; 16] in Utf8) {
        output = "Gate";
        transition { _ -> second(output) }
    }
    state second(output: &mut [u8; 16] in Utf8) {
        output = "é";
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.line = "old contents";
    main.sibling = 29;
    replace(&mut main.line);
    transition main.line == "é" && main.line.len == 2 && main.sibling == 29 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
