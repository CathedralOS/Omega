use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
data Main {
    console: Binding<Console>;
    line: [u8; 16] in Utf8;
    sibling: u64;
}

machine replace(output: &mut [u8; 16] in Utf8)
ensures output in Utf8
{
    transition { _ -> first(output) }
    state first(output: &mut [u8; 16] in Utf8) {
        output = "Gate";
        transition { _ -> second(output) }
    }
    state second(output: &mut [u8; 16] in Utf8) {
        output = "é";
    }
}

machine Main::main(&mut self) reaches Console {
    self.line = "old contents";
    self.sibling = 29;
    replace(&mut self.line);
    transition self.line == "é" && self.line.len == 2 && self.sibling == 29 {
        true -> finish(70)
        false -> finish(1)
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
