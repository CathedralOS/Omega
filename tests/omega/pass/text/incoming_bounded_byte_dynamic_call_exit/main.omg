        true -> read(bytes)
        _ -> bad()
    }
    state read(bytes: &[u8]) requires bytes.len == 21 {
        transition bytes[0] == 43 && bytes[14] == 46 && bytes[20] == 48 {
            true -> done()
            _ -> bad()
