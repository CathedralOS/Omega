// A machine-owned bounded byte field (`[u8; 5] in Utf8`) read one byte at a
// time: a runtime index in a loop and a literal index in a guard. Each read
// is checked against the field's live length and loads from the field's
// inline backing. "HELLO" sums to 72 + 69 + 76 + 76 + 79 = 372.
// Expected exit: 70.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 5]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    text: [u8; 5] in Utf8;
    i: i32;
    sum: u64 in Wrapping;
}

machine Main::main(&mut self) reaches Console {
    self.text = "HELLO";
    self.i = 0;
    self.sum = 0;
    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.i < 5 {
            true -> add()
            _ -> check()
        }
    }

    state add(&mut self) {
        self.sum = self.sum + self.text[self.i] as u64 in Wrapping;
        self.i = self.i + 1;
        transition {
            _ -> step()
        }
    }

    state check(&mut self) {
        transition self.text[0] == 72 && self.sum == 372 {
            true -> pass()
            _ -> fail()
        }
    }

    state pass(&mut self) {
        self.console.exit_process(70);
    }

    state fail(&mut self) {
        self.console.exit_process(71);
    }
}
