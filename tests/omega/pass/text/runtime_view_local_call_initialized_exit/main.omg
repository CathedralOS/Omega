// A mutable view local initialized by a call stores the call's returned
// descriptor in the local's home, exactly as a later assignment of a call
// result does. The home is then read, reassigned from another call and read
// again.
use omega_language_std::console;

data Main { }

machine pick<'a>(bytes: &'a [u8]) -> &'a [u8] {
    bytes
}

machine Main::main(main: &mut Main) reaches Console {
    let mut view: &[u8] = pick("Gate");
    let gate: bool = view == "Gate";
    view = pick("Door");
    transition gate && view == "Door" {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
