use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);

domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    console: Binding<Console>;
    line: [u8; 32] in Utf8;
    suffix: [u8; 16] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.line = "";
    main.suffix = "omega";

    transition main.suffix {
        _ -> write_line(main, &mut main.line, main.suffix)
    }

    state write_line(
        main: &mut Main,
        out_line: &mut [u8; 32] in Utf8,
        suffix: [u8; 16] in Utf8
    ) {
        out_line = "prefix " + suffix;
        main.console.write_line(out_line);

        // `out_line` holds `main.line` exclusively until this state ends.
        transition { _ -> verify(main) }
    }

    state verify(main: &mut Main) {
        transition main.line == "prefix omega" {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(77);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(78);
    }
}
