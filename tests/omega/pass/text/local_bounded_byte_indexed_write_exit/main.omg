// Live length remains two, not capacity eight. NUL is legal UTF-8; mutation
// must affect only this owned home, not the sibling's identical literal.
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> render() }

    state render() {
        let original: Buffer = Buffer { storage: [97u8, 98u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 2 };
        let mut line: Buffer = Buffer { storage: [97u8, 98u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 2 };
        line.storage[0] = 0;
        line.storage[1] = 65;
        transition line.used == 2 && line.storage[0] == 0 && line.storage[1] == 65
            && original.storage[0] == 97 && original.storage[1] == 98 {
            true -> finish(70)
            _ -> finish(71)
        }
    }

    state finish(code: i32) {
        Console::exit_process(code);
    }
}

// Spare bytes are real fixed-array content; used selects the live prefix.
data Buffer [copy] where used <= 8 { storage: [u8; 8] in Utf8; used: u64; }
