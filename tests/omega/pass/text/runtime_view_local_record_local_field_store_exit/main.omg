// A parameter's view field stored into a declared local record's view field,
// then that local field stored into a qualified borrowed-view local: each
// store installs the same backing and extent, no byte is copied, and the
// view local reads its declared Utf8 home like any other shared view.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Room [copy] { label: &[u8] in Utf8; }

data Main {
    source: Room;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.label = "Gate";
    transition { _ -> observe(main) }

    state observe(main: &mut Main) {
        let room: Room;
        let mut out_line: &[u8] in Utf8;
        room.label = main.source.label;
        out_line = room.label;
        transition out_line == "Gate" {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
