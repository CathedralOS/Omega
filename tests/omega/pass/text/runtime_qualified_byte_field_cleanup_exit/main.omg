// Expected exit: 0
domain [u8]::Ascii(bytes) requires ascii_only(bytes);
data View<'storage> [copy] { bytes: &'storage [u8] in Ascii; }
machine inspect(bytes: &[u8] in Ascii) -> u64 { bytes.len }
machine receive(view: View) -> u64 { inspect(view.bytes) }
machine main() crashes Trap {
    let view: View = View { bytes: "ok" };
    let result: u64 = receive(view);
    transition result == 2 {true -> done() false -> bad()}
    state done() {}
    state bad() { crash Trap; }
}
