domain [u8]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine write_error(text: &[u8] in Utf8);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    self.console.write_error("hello-stderr\n");
    self.console.exit_process(70);
}