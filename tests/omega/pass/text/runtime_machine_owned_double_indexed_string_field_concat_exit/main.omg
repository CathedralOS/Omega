domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::binding;

domain u64::Slot2 requires self <= 1;
data Room {
    description: &[u8] in Utf8;
}

data Main {
    console: Binding<Console>;
    rooms: [[Room; 2]; 2];
    outer: u64 in Slot2;
    inner: u64 in Slot2;
}

machine Main::main(&mut self) reaches Console {
    self.outer = 1;
    self.inner = 1;
    self.rooms[self.outer][self.inner].description = "prefix " + "omega";

    let actual: &[u8] in Utf8 = self.rooms[1][1].description;
    transition actual == "prefix omega" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(83);
    }

    state bad(&mut self) {
        self.console.exit_process(84);
    }
}
