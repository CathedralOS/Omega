use omega_language_std::console;

domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);

// One measured comparison reads inline owner bytes and descriptor-backed bytes.
// Equal contents occupy distinct backing; neither pointer equality nor treating
// a descriptor as inline text can produce the authored result.
data Main {
    owned: TextBuffer;
    viewed: &[u8] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    main.owned = TextBuffer { storage: [111u8, 109u8, 101u8, 103u8, 97u8, 0u8, 0u8, 0u8], used: 5 };
    main.viewed = "omega";
    let same: bool = TextBuffer::equal(&main.owned, main.viewed);
    transition same { true -> different(main) _ -> bad(main) }
    state different(main: &mut Main) {
        main.viewed = "delta";
        let same: bool = TextBuffer::equal(&main.owned, main.viewed);
        transition same { false -> empty(main) _ -> bad(main) }
    }
    state empty(main: &mut Main) {
        main.owned = TextBuffer { storage: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 0 };
        main.viewed = "";
        let same: bool = TextBuffer::equal(&main.owned, main.viewed);
        transition same { true -> good(main) _ -> bad(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}


// A variable-fill value explicitly owns its fixed storage and live length.
// Copies retain both; an accessor borrows and checks the selected copy's prefix.
data TextBuffer [copy] where used <= 8 { storage: [u8; 8] in Utf8; used: u64; }
machine TextBuffer::view(buffer: &TextBuffer) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine TextBuffer::equal(buffer: &TextBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = TextBuffer::view(buffer);
    bytes == expected
}
