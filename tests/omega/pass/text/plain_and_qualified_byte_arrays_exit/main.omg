// One program holding a plain `[u8; 4]` and a `[u8; 4] in Utf8` of the same
// extent. The plain array is fixed storage that a `&[u8; 4]` lends as a
// bounded view; the qualified array is a bounded byte owner with a live
// extent. Each keeps its own structural plan, so reading or lending one never
// reaches the other's representation. Both are read in place, lent to a
// helper, and lent whole into a state cycle that writes through the plain
// loan and reads through both. "GATE" lowered matches "gate": exit 70.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);

machine head(bytes: &[u8; 4]) -> u8 {
    transition { _ -> (bytes[0]) }
}

machine spells_gate(bytes: &[u8]) -> bool {
    transition { _ -> (bytes.len == 4 && bytes == "gate") }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut plain: [u8; 4] = "GATE";
    let text: [u8; 4] in Utf8 = "gate";
    let last: u8 = plain[3];
    let first: u8 = head(&plain);
    let spelled: bool = spells_gate(text);
    transition spelled && first == 71 && text[3] == 101 {
        true -> fold(&main.console, &mut plain, &text, 0, last)
        _ -> finish(&main.console, 72)
    }

    state fold(console: &Binding<Console>, plain: &mut [u8; 4], text: &[u8; 4] in Utf8, position: i32, last: u8)
        requires 0 <= position && position <= 4
    {
        transition position < 4 {
            true -> lower(console, plain, text, position, last)
            _ -> compare(console, plain, text, last)
        }
    }

    state lower(console: &Binding<Console>, plain: &mut [u8; 4], text: &[u8; 4] in Utf8, position: i32, last: u8)
        requires 0 <= position && position < 4
    {
        let lowered: u8 in Wrapping = plain[position] as u8 in Wrapping + 32;
        plain[position] = lowered as u8;
        transition { _ -> fold(console, plain, text, position + 1, last) }
    }

    state compare(console: &Binding<Console>, plain: &mut [u8; 4], text: &[u8; 4] in Utf8, last: u8) {
        transition plain[0] == text[0] && plain[3] == text[3] && last == 69 {
            true -> finish(console, 70)
            _ -> finish(console, 71)
        }
    }

    state finish(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
