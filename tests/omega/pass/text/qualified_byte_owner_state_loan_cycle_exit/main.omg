// Two `[u8; 5] in Utf8` locals lend `&` and `&mut` bounded-owner loans into a
// step/shift state cycle (the caesar-cipher shape). Each indexed read sits
// inside a larger expression or a guard comparison, so it consumes the
// checker's bound verdict for its own `[]` occurrence; the live length of a
// bounded owner is otherwise unknown to Terminal. The store keeps UTF-8
// because checking proves every stored byte ASCII over an all-ASCII carrier.
// "HELLO" shifted by 3 is "KHOOR": exit 70.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let text: [u8; 5] in Utf8 = "HELLO";
    let mut output: [u8; 5] in Utf8 = ".....";
    transition { _ -> step(&main.console, &text, &mut output, 0) }

    state step(console: &Binding<Console>, text: &[u8; 5] in Utf8, output: &mut [u8; 5] in Utf8, position: i32)
        requires 0 <= position && position <= 5
    {
        transition position < 5 {
            true -> shift(console, text, output, position)
            _ -> show(console, output)
        }
    }

    state shift(console: &Binding<Console>, text: &[u8; 5] in Utf8, output: &mut [u8; 5] in Utf8, position: i32)
        requires 0 <= position && position < 5
    {
        let shifted: u8 in Wrapping = text[position] as u8 in Wrapping + 3;
        output[position] = shifted as u8;
        transition { _ -> step(console, text, output, position + 1) }
    }

    state show(console: &Binding<Console>, output: &mut [u8; 5] in Utf8) {
        Console::write_line(console, output);
        transition output[0] == 75 && output[4] == 82 {
            true -> finish(console, 70)
            _ -> finish(console, 71)
        }
    }

    state finish(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
