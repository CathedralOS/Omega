// Reading a `[u8;N] in Utf8` CARRIER byte by a RUNTIME index: `main.text[main.i]`.
// The carrier stores its inline bytes after a leading `len` word, so a runtime
// index must skip that prefix -- the resolver was missing the `+pointer_size`
// adjustment (it read at the len word, returning 0). Now reads the inline byte.
// "abc": text[0]='a'(97), text[2]='c'(99). Self-checks and exits 70.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    text: [u8; 4] in Utf8;
    i: i32 in Trapping;
    a: u8;
    b: u8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.text = "abc";

    transition {
        _ -> compute(main)
    }

    state compute(main: &mut Main) {
        main.i = 0;
        main.a = main.text[main.i]; // 'a' = 97
        main.i = 2;
        main.b = main.text[main.i]; // 'c' = 99
        transition main.a == 97 {
            true -> check_b(main)
            _ -> bad(main)
        }
    }

    state check_b(main: &mut Main) {
        transition main.b == 99 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
