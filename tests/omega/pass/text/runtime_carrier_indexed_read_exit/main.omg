// Exact three-byte owned arrays lend ordinary qualified views.
// Runtime indexes and state forwarding preserve the authored numerical oracle.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    text: [u8; 3] in Utf8;
    i: i32 in Trapping;
    a: u8;
    b: u8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.text = "abc";

    transition {
        _ -> compute(main)
    }

    state compute(main: &mut Main) {
        main.i = 0;
        main.a = main.text[main.i]; // 'a' = 97
        main.i = 2;
        main.b = main.text[main.i]; // 'c' = 99
        transition main.a == 97 {
            true -> check_b(main)
            _ -> bad(main)
        }
    }

    state check_b(main: &mut Main) {
        transition main.b == 99 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
