use omega_language_std::console;
// `main.line.text = "Room " + main.room.label` materializes the concat into the
// `write_line`s it. The nested fields `main.room.label` / `main.line.text` have
// their declared `in Utf8` domain forwarded through the multi-level field-path
// resolver -- enforced at the write and trusted at the host-call read -- so this
// owns its bytes end to end with no `String` and no `{ptr, len}` descriptor.
// Prints "Room A1", exits 0 (the interpreter agrees on both).
pub domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Room {
    label: Buffer4;
}

data Line {
    text: Buffer16;
}

data Main {
    room: Room;
    line: Line;
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    main.room.label = Buffer4 { storage: [65u8, 49u8, 0u8, 0u8], used: 2 };
    main.line.text = Buffer16::join("Room ", Buffer4::view(&main.room.label));

    transition {
        _ -> shutdown(main)
    }


    state shutdown(main: &mut Main) {
        Console::write_line(Buffer16::view(&main.line.text));
        Console::exit_process(0);
    }
}

// Explicit fixed capacity and live-prefix length; qualification belongs to the checked view.
data Buffer4 [copy] where used <= 4 { storage: [u8; 4]; used: u64; }
machine Buffer4::view(buffer: &Buffer4) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine Buffer4::equal(buffer: &Buffer4, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = Buffer4::view(buffer);
    bytes == expected
}

machine Buffer4::copy(storage: &mut [u8; 4], bytes: &[u8], start: u64)
requires start <= 4; bytes.len <= 4 - start {
    transition { _ -> copying(storage, bytes, start, 0) }
    state copying(storage: &mut [u8; 4], bytes: &[u8], start: u64, index: u64)
    requires start <= 4; index <= 4 {
        transition index < bytes.len && start + index < 4 {
            true -> writing(storage, bytes, start, index)
            _ -> done()
        }
    }
    state writing(storage: &mut [u8; 4], bytes: &[u8], start: u64, index: u64)
    requires start <= 4; index < 4; index < bytes.len; start + index < 4 {
        storage[start + index] = bytes[index];
        transition { _ -> copying(storage, bytes, start, index + 1) }
    }
    state done() {}
}
machine Buffer4::join(left: &[u8], right: &[u8]) -> Buffer4 crashes Trap {
    transition left.len <= 4 && right.len <= 4 - left.len {
        true -> joining(left, right)
        _ -> bad()
    }
    state joining(left: &[u8], right: &[u8]) -> Buffer4
    requires left.len <= 4; right.len <= 4 - left.len {
    let mut result: Buffer4;
    Buffer4::copy(&mut result.storage, left, 0);
    Buffer4::copy(&mut result.storage, right, left.len);
    let total: u64 = left.len + right.len;
    transition total <= 4 {
        true -> checked(result, total)
        _ -> bad()
    }
    }
    state checked(result: Buffer4, total: u64) -> Buffer4
    requires total <= 4 {
        let mut value: Buffer4 = result;
        value.used = total;
        value
    }
    state bad() { crash Trap; }
}

// Explicit fixed capacity and live-prefix length; qualification belongs to the checked view.
data Buffer16 [copy] where used <= 16 { storage: [u8; 16]; used: u64; }
machine Buffer16::view(buffer: &Buffer16) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine Buffer16::equal(buffer: &Buffer16, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = Buffer16::view(buffer);
    bytes == expected
}

machine Buffer16::copy(storage: &mut [u8; 16], bytes: &[u8], start: u64)
requires start <= 16; bytes.len <= 16 - start {
    transition { _ -> copying(storage, bytes, start, 0) }
    state copying(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index <= 16 {
        transition index < bytes.len && start + index < 16 {
            true -> writing(storage, bytes, start, index)
            _ -> done()
        }
    }
    state writing(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index < 16; index < bytes.len; start + index < 16 {
        storage[start + index] = bytes[index];
        transition { _ -> copying(storage, bytes, start, index + 1) }
    }
    state done() {}
}
machine Buffer16::join(left: &[u8], right: &[u8]) -> Buffer16 crashes Trap {
    transition left.len <= 16 && right.len <= 16 - left.len {
        true -> joining(left, right)
        _ -> bad()
    }
    state joining(left: &[u8], right: &[u8]) -> Buffer16
    requires left.len <= 16; right.len <= 16 - left.len {
    let mut result: Buffer16;
    Buffer16::copy(&mut result.storage, left, 0);
    Buffer16::copy(&mut result.storage, right, left.len);
    let total: u64 = left.len + right.len;
    transition total <= 16 {
        true -> checked(result, total)
        _ -> bad()
    }
    }
    state checked(result: Buffer16, total: u64) -> Buffer16
    requires total <= 16 {
        let mut value: Buffer16 = result;
        value.used = total;
        value
    }
    state bad() { crash Trap; }
}
