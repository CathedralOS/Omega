// The normal arm replaces the bounded message with a runtime concatenation.
// Its capacity is 32, but only the seven live bytes of "ok temp" may be printed.
// Exact equality also observes the resulting length before accepting exit 70.
use omega_language_std::console;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    label: [u8; 8] in Utf8;
    message: [u8; 32] in Utf8;
    reading: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.label = "temp";
    main.reading = 85;

    transition main.reading > 90 {
        true -> high(main)
        _ -> normal(main)
    }

    state high(main: &mut Main) {
        main.message = "ALERT " + main.label;
        Console::write_line(main.message);
        Console::exit_process(71);
    }

    state normal(main: &mut Main) {
        main.message = "ok " + main.label;
        Console::write_line(main.message);
        transition main.message == "ok temp" {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
