domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::service;

data Room {
    description: &[u8] in Utf8;
}

data Main {
    console: Binding<Console>;
    room: Room;
}

machine Main::main(&mut self) reaches Console {
    self.room.description = "prefix " + "omega";

    transition self.room.description == "prefix omega" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(73);
    }

    state bad(&mut self) {
        self.console.exit_process(74);
    }
}