// Expected exit: 0. Reading a plain view keeps the qualified owner's
// live byte length through locals, borrowed arrivals and owned arrivals.
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Main {}

machine count(bytes: &[u8]) -> u64 { bytes.len }

machine replace(line: &mut [u8; 8] in Utf8) -> bool {
    line = "é";
    let first: bool = count(line) == 2;
    transition { _ -> arrived(line, first) }
    state arrived(line: &mut [u8; 8] in Utf8, first: bool) {
        line = "abc";
        first && count(line) == 3
    }
}

machine owned(line: [u8; 8] in Utf8) -> bool {
    transition { _ -> arrived(line) }
    state arrived(line: [u8; 8] in Utf8) { count(&line) == 4 }
}

machine Main::main(main: &mut Main) crashes Trap {
    let mut line: [u8; 8] in Utf8 = "Gate";
    let local: bool = count(&line) == 4;
    let changed: bool = replace(&mut line);
    let carried: bool = owned("Gate");
    transition local && changed && carried && line == "abc" {
        true -> done() false -> bad()
    }
    state done() {} state bad() { crash Trap; }
}
