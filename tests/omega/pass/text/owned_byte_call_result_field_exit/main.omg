use omega_language_std::console;

domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
data Holder { text: [u8; 16] in Utf8; sibling: u64; }
data Main { holder: Holder; }

machine label(short: bool) -> [u8; 16] in Utf8 {
    transition short {
        true -> "Gate"
        false -> "Branch Room"
    }
}

// The ordinary helper and the caller's composed state graph must both retain
// the exact returned buffer before replacing its destination field.
machine replace(holder: &mut Holder, short: bool) {
    holder.text = label(short);
}

machine Main::main(main: &mut Main) reaches Console {
    main.holder.sibling = 29;
    replace(&mut main.holder, false);
    let longer_matches: bool = main.holder.text == "Branch Room"
        && main.holder.text.len == 11;
    main.holder.text = label(true);
    transition longer_matches
        && main.holder.text == "Gate"
        && main.holder.text.len == 4
        && main.holder.sibling == 29 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
