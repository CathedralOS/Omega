use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
data Holder { text: [u8; 16] in Utf8; sibling: u64; }
data Main { console: Binding<Console>; holder: Holder; }

machine label(short: bool) -> [u8; 16] in Utf8 {
    transition short {
        true -> "Gate"
        false -> "Branch Room"
    }
}

// The ordinary helper and the caller's composed state graph must both retain
// the exact returned buffer before replacing its destination field.
machine replace(holder: &mut Holder, short: bool) {
    holder.text = label(short);
}

machine Main::main(&mut self) reaches Console {
    self.holder.sibling = 29;
    replace(&mut self.holder, false);
    let longer_matches: bool = self.holder.text == "Branch Room"
        && self.holder.text.len == 11;
    self.holder.text = label(true);
    transition longer_matches
        && self.holder.text == "Gate"
        && self.holder.text.len == 4
        && self.holder.sibling == 29 {
        true -> finish(70)
        false -> finish(1)
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
