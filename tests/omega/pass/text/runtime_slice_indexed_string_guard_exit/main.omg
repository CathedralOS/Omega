domain [u8]::Utf8(bytes2)
requires
    valid_utf8(bytes2);
// A &[u8] in Utf8 field of a slice element compared against a literal in GUARD
// position must compare CONTENT, in all three regimes:
//   1. an EMPTY (default-zeroed) field never equals a non-empty literal,
//   2. a field holding the literal's exact bytes equals it,
//   3. a same-length field differing in its last byte does not equal it.
// Before the TextEqualsLiteral guard selection existed, this guard shape
// selected NO compare at all and the first transition arm was taken
// unconditionally -- an empty field "equalled" any literal.
use omega_language_std::console;

data Room {
    name: &[u8] in Utf8;
}

data Main {
    rooms: [Room; 3];
}

machine Main::main(main: &mut Main) reaches Console {
    let match_index: u64 = 1;
    let differ_index: u64 = 2;
    let empty_index: u64 = 0;
    let room_slice: &mut [Room] = &mut main.rooms[0..3];
    room_slice[match_index].name = "expected";
    // Same length as the literal, differing only in the final byte, so the
    // inequality must come from the byte loop rather than the length check.
    room_slice[differ_index].name = "expectes";

    transition room_slice[empty_index].name == "expected" {
        true -> fail(main)
        false -> check_match(main)
    }

    machine check_match(main: &mut Main) {
        let index: u64 = 1;
        let room_slice: &mut [Room] = &mut main.rooms[0..3];
        transition room_slice[index].name == "expected" {
            true -> check_differ(main)
            false -> fail(main)
        }
    }

    machine check_differ(main: &mut Main) {
        let index: u64 = 2;
        let room_slice: &mut [Room] = &mut main.rooms[0..3];
        transition room_slice[index].name == "expected" {
            true -> fail(main)
            false -> pass(main)
        }
    }

    machine pass(main: &mut Main) {
        Console::exit_process(70);
    }

    machine fail(main: &mut Main) {
        Console::exit_process(71);
    }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
