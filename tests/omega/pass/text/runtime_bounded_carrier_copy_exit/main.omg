// Observe whole-byte replacement through direct copies and nested destinations.
// Shorter and empty replacements publish their own live length. Copies preserve
// the source and unrelated sibling storage; successful execution prints the
// actual concatenated field rather than an unrelated constant.
use omega_language_std::console;

domain [u8; 32]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Bucket {
    text: [u8; 32] in Utf8;
    sibling: [u8; 32] in Utf8;
}

data Main {
    greeting: [u8; 32] in Utf8;
    source: [u8; 32] in Utf8;
    bucket: Bucket;
}

machine Main::main(main: &mut Main) reaches Console {
    main.greeting = "Hello, " + "Ada!";
    main.source = "Longer source";
    main.bucket.sibling = "keep";
    transition main.greeting == "Hello, Ada!" {
        true -> copy(main)
        false -> bad(main)
    }

    state copy(main: &mut Main) {
        main.bucket.text = main.source;
        transition main.bucket.text == "Longer source" {
            true -> preserved(main)
            false -> bad(main)
        }
    }

    state preserved(main: &mut Main) {
        transition main.source == "Longer source" && main.bucket.sibling == "keep" {
            true -> shorter(main)
            false -> bad(main)
        }
    }

    state shorter(main: &mut Main) {
        main.source = "Ada";
        transition main.bucket.text == "Longer source" {
            true -> copy_shorter(main)
            false -> bad(main)
        }
    }

    state copy_shorter(main: &mut Main) {
        main.bucket.text = main.source;
        transition main.bucket.text == "Ada" && main.bucket.text.len == 3 {
            true -> empty(main)
            false -> bad(main)
        }
    }

    state empty(main: &mut Main) {
        main.source = "";
        transition main.bucket.text == "Ada" {
            true -> copy_empty(main)
            false -> bad(main)
        }
    }

    state copy_empty(main: &mut Main) {
        main.bucket.text = main.source;
        transition main.bucket.text == "" && main.bucket.text.len == 0 && main.bucket.sibling == "keep" {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::write_line(main.greeting);
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
