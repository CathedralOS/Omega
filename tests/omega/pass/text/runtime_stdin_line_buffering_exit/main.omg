// #66: two sequential `read_line`s into the SAME owned `[u8; 64] in Utf8` carrier,
// each echoed back. The second read overwrites the carrier's inline bytes + length
// (a leading-delimiter is skipped so CRLF is one terminator), so line buffering is
// per-read with no `String`.
use omega_language_std::console;

domain [u8; 64]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Console;
    line: [u8; 64] in Utf8;
}

machine Main::main(&mut self) {
    self.console.read_line(&mut self.line);
    self.console.write_line(self.line);
    self.console.read_line(&mut self.line);
    self.console.write_line(self.line);
    self.console.exit_process(0);
}
