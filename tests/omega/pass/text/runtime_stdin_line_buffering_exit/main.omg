// Echo only each completed reported prefix; normalize CRLF in this caller.
// Fixed input extent and untouched suffix survive every read.
use omega_language_std::console;

data Main {
    line: [u8; 64];
}

machine Main::main(main: &mut Main) reaches Console {
    block Main::echo_line(main);
    block Main::echo_line(main);
    Console::exit_process(0);
}

machine Main::echo_line(main: &mut Main) reaches Console {
    let observed: LineReadResult = block Console::read_line(&mut main.line);
    transition observed {
        LineReadResult::LineComplete { count } -> bounded_input(main, count, true)
        LineReadResult::EndOfInput { count } -> bounded_input(main, count, false)
        LineReadResult::Full { count } -> input_failed(main)
        LineReadResult::Invalid -> input_failed(main)
    }

    // Normalize this command/echo protocol explicitly; the reader preserves raw bytes.
    state bounded_input(main: &mut Main, count: u64, complete: bool) {
        transition count <= main.line.len {
            true -> normal_input(main, count, complete)
            false -> input_failed(main)
        }
    }
    state normal_input(main: &mut Main, count: u64, complete: bool) {
        transition complete {
            true -> completed_input(main, count)
            false -> parsed_input(main, count)
        }
    }
    state completed_input(main: &mut Main, count: u64) {
        transition count > 0 && count <= main.line.len {
            true -> trim_carriage_return(main, count - 1)
            false -> input_failed(main)
        }
    }
    state trim_carriage_return(main: &mut Main, count: u64) {
        transition count > 0 && count <= main.line.len {
            true -> inspect_carriage_return(main, count, count - 1)
            false -> parsed_input(main, count)
        }
    }
    state inspect_carriage_return(main: &mut Main, count: u64, byte_index: u64) {
        transition byte_index < main.line.len && main.line[byte_index] == 13 {
            true -> parsed_input(main, byte_index)
            false -> parsed_input(main, count)
        }
    }

    state parsed_input(main: &mut Main, count: u64) {
        write_prefix(&main.line, count);
    }
    state input_failed(main: &mut Main) { Console::exit_process(1); }
}

// The bound is checked on the exact view before forming its output prefix.
machine write_prefix(bytes: &[u8], count: u64) reaches Console {
    transition count <= bytes.len {
        true -> output(bytes[0..count])
        false -> invalid()
    }
    state output(bytes: &[u8]) {
        Console::write_line(bytes);
    }
    state invalid() { Console::exit_process(1); }
}
