// A scalar needed by repeated fixed-view divisions stays live across output.
// The input selects runtime values; a second call observes caller mutation.
use omega_language_std::console;
data Main { input: [u8; 2]; value: i32 in Wrapping; }
machine digits(main: &mut Main, value: i32 in Wrapping) reaches Console {
    Console::write_byte((value / 100 % 10 + 48) as i32);
    Console::write_byte((value / 10 % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
}
machine Main::main(main: &mut Main) reaches Console {
    let read: LineReadResult = block Console::read_line(&mut main.input);
    transition read {
        LineReadResult::LineComplete { count } -> length(main, count)
        _ -> bad(main)
    }
    state length(main: &mut Main, count: u64) {
        transition count == 2 { true -> select(main) false -> bad(main) }
    }
    state select(main: &mut Main) {
        transition main.input[0] {
            49 -> first(main, 317)
            50 -> first(main, 624)
            _ -> bad(main)
        }
    }
    state first(main: &mut Main, value: i32 in Wrapping) {
        main.value = value;
        digits(main, value);
        main.value = main.value + 1;
        let next: i32 in Wrapping = main.value;
        digits(main, next);
        Console::write_line("");
        Console::exit_process(70);
    }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
