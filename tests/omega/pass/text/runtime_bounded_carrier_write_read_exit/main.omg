// The owned `[u8; N] in Utf8` bounded byte carrier, end to end on native: a
// literal write materializes into the carrier's `{len, bytes}` inline storage
// (len word + content bytes, the carrier OWNS its bytes -- not a `{ptr, len}`
// descriptor aliasing rodata), and the `==` guard reads it back with carrier
// addressing (length at offset 0, content at offset pointer_size) and content-
// compares against the literal. Then two guarded arrivals join at an indexed
// byte store: both must establish the field's ASCII bound independently.
// Exercise each arrival and a rejected non-ASCII input; all checks exit 70.
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    label: [u8; 8] in Utf8;
    byte: u8;
}

machine Main::replace(main: &mut Main, choice: u8, byte: u8) {
    main.label = "Gate";
    transition choice == 0 { true -> supplied(main, byte) _ -> space(main) }
    state supplied(main: &mut Main, byte: u8) {
        main.byte = byte;
        transition main.byte < 128 { true -> write(main) _ -> done() }
    }
    state space(main: &mut Main) {
        main.byte = 32;
        transition main.byte < 128 { true -> write(main) _ -> done() }
    }
    state write(main: &mut Main) { main.label[1] = main.byte; }
    state done() { }
}

machine Main::main(main: &mut Main) reaches Console {
    main.label = "Gate";

    transition main.label == "Gate" {
        true -> supplied(main)
        false -> bad(main)
    }

    state supplied(main: &mut Main) {
        Main::replace(main, 0, 111);
        transition main.label == "Gote" { true -> space(main) _ -> bad(main) }
    }

    state space(main: &mut Main) {
        Main::replace(main, 1, 200);
        transition main.label == "G te" { true -> non_ascii(main) _ -> bad(main) }
    }

    state non_ascii(main: &mut Main) {
        Main::replace(main, 0, 200);
        transition main.label == "Gate" { true -> good(main) _ -> bad(main) }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
