// A refuted guard over an element of a shared view bounds every later read
// of that element: `text[index] < 48 || text[index] > 57` fails, so the next
// arm's `text[index] - 48` is a digit and the exact `u8` subtraction proves.
// The view is a shared loan, so its bytes cannot change, and `index` is an
// immutable parameter. The parser accumulates under Exact arithmetic and
// stops before `value * 10 + digit` could leave `u64`.
// Expected exit: 70.
use omega_language_std::console;

data Main { }

machine parse_digits(text: &[u8], index: u64, value: u64) -> u64
terminates by (index, text.len) -> Nat::BoundedDistance;
{
    transition {
        index >= text.len -> (value)
        text[index] < 48 || text[index] > 57 -> (value)
        value >= 10000 -> (value)
        _ -> parse_digits(text, index + 1, value * 10 + (text[index] - 48) as u64)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let parsed: u64 = parse_digits("4096x", 0, 0);
    transition parsed == 4096 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
