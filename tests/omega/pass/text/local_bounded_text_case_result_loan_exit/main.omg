// A static entry lends a bounded text local to a machine whose result is a
// case value. `leading` forwards the qualified shared loan to a successor
// state, reads the owner's live length there, and returns the first byte,
// read at a literal index against that live length, as a case payload. The
// entry binds the result and dispatches on it. Exits 70 only when the first
// byte of "OK" (79) comes back; an empty or zero-filled reading exits 71 or 72.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Leading {
    case Empty;
    case Byte(value: u64);
}

machine leading(text: &TextBuffer) -> Leading crashes Trap {
    transition {
        _ -> inspect(text)
    }

    state inspect(text: &TextBuffer) -> Leading {
        transition 0 < text.used {
            true -> read(text)
            _ -> (Leading::Empty)
        }
    }

    state read(text: &TextBuffer) -> Leading {
        let byte: u8 = text.storage[0];
        transition {
            _ -> (Leading::Byte { value: byte as u64 })
        }
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let text: TextBuffer = TextBuffer { storage: [79u8, 75u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 2 };
    let lead: Leading = leading(&text);
    transition lead {
        Leading::Byte { value } -> check(value)
        Leading::Empty -> finish(71)
    }

    state check(value: u64) {
        transition value == 79 {
            true -> finish(70)
            _ -> finish(72)
        }
    }

    state finish(code: i32) {
        Console::exit_process(code);
    }
}


// A variable-fill value explicitly owns its fixed storage and live length.
// Copies retain both; an accessor borrows and checks the selected copy's prefix.
data TextBuffer [copy] where used <= 16 { storage: [u8; 16] in Utf8; used: u64; }
machine TextBuffer::view(buffer: &TextBuffer) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine TextBuffer::equal(buffer: &TextBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = TextBuffer::view(buffer);
    bytes == expected
}
