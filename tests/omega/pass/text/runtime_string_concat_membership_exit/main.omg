domain [u8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Main {
    console: Console;
    line: &[u8] in Utf8;
}

machine Main::main(&mut self) {
    self.line = "prefix " + "omega";

    transition self.line == "prefix omega" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(71);
    }

    state bad(&mut self) {
        self.console.exit_process(72);
    }
}
