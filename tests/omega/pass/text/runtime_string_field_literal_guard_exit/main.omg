// A machine-owned &[u8] in Utf8 FIELD compared against a literal in GUARD position
// (the storage-place sibling of the slice-indexed shape): an empty
// (default-zeroed) field must not equal a non-empty literal, and a written
// field must equal its exact bytes. Pinned alongside
// runtime_slice_indexed_string_guard_exit -- before the TextEqualsLiteral
// guard selection existed, BOTH shapes selected no compare and the guard
// silently evaluated true.
domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Main {
    console: Console;
    name: &[u8] in Utf8;
}

machine Main::main(&mut self) {
    transition self.name == "expected" {
        true -> fail()
        false -> check_match()
    }

    state check_match(&mut self) {
        self.name = "expected";
        transition self.name == "expected" {
            true -> pass()
            false -> fail()
        }
    }

    state pass(&mut self) {
        self.console.exit_process(70);
    }

    state fail(&mut self) {
        self.console.exit_process(71);
    }
}
