// Storing a record's view field into a borrowed-view local takes the field's
// backing and extent; no byte is copied.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Room [copy] { label: &[u8] in Utf8; }

data Main {
    source: Room;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.label = "Gate";
    transition { _ -> observe(main) }

    state observe(main: &mut Main) {
        let mut out_line: &[u8] in Utf8;
        out_line = main.source.label;
        transition out_line == "Gate" {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
