// RUN CANARY (exit 70). A literal stored into a shared view field by a
// non-entry machine outlives that machine's activation: the descriptor names
// immutable image storage, not the helper's frame. `name_door` replaces
// `main.name` through its own receiver and `relabel` replaces `room.label`
// through a `&mut Room` reference. `scribble` then runs in the same stack
// region with a literal of its own before the entry reads both fields'
// lengths and bytes. 71 = a wrong extent, 72 = wrong bytes.
use omega_language_std::console;

data Room {
    label: &[u8];
}

data Main {
    name: &[u8];
    room: Room;
}

machine Main::name_door(main: &mut Main) {
    main.name = "Door";
}

machine Main::relabel(room: &mut Room) {
    room.label = "Gate keeper";
}

machine Main::scribble() -> u64 {
    let noise: &[u8] = "XXXXXXXXXXXXXXXXXXXXXXXX";
    (noise.len)
}

machine Main::main(main: &mut Main) reaches Console {
    Main::name_door(main);
    Main::relabel(&mut main.room);
    let noise: u64 = Main::scribble();

    transition main.name.len == 4 && main.room.label.len == 11 && noise == 24 {
        true -> contents(main)
        false -> wrong_extent(main)
    }

    state contents(main: &mut Main) {
        transition main.name == "Door" && main.room.label == "Gate keeper" {
            true -> good(main)
            false -> wrong_bytes(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state wrong_extent(main: &mut Main) {
        Console::exit_process(71);
    }

    state wrong_bytes(main: &mut Main) {
        Console::exit_process(72);
    }
}
