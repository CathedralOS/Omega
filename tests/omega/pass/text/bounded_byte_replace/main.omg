domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
// A mutable bounded-text receiver rewritten across states:
// `&mut TextBuffer` + `ensures output.storage in Utf8` — successive
// literal stores each re-prove the domain on the write side; the
// sibling scalar beside the receiver in the caller keeps its value.
domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
machine replace(output: &mut TextBuffer) crashes Trap
ensures output.storage in Utf8 {
    transition { _ -> first(output) }
    state first(output: &mut TextBuffer) {
        output = TextBuffer { storage: [71u8, 97u8, 116u8, 101u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 4 };
        transition { _ -> second(output) }
    }
    state second(output: &mut TextBuffer) {
        output = TextBuffer { storage: [115u8, 101u8, 99u8, 111u8, 110u8, 100u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 6 };
    }
}
data Main {
    line: TextBuffer;
    sibling: u64;
}
machine Main::main(main: &mut Main) crashes Trap {
    main.line = TextBuffer { storage: [111u8, 108u8, 100u8, 32u8, 99u8, 111u8, 110u8, 116u8, 101u8, 110u8, 116u8, 115u8, 0u8, 0u8, 0u8, 0u8], used: 12 };
    main.sibling = 29;
    replace(&mut main.line);
}


// A variable-fill value explicitly owns its fixed storage and live length.
// Copies retain both; an accessor borrows and checks the selected copy's prefix.
data TextBuffer [copy] where used <= 16 { storage: [u8; 16] in Utf8; used: u64; }
machine TextBuffer::view(buffer: &TextBuffer) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine TextBuffer::equal(buffer: &TextBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = TextBuffer::view(buffer);
    bytes == expected
}
