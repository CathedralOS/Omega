// RUN (exit 70). A `[copy]` record holding a shared text view and a scalar
// crosses three state edges by value. `inspect(main.badge)` copies the record
// out of the receiver into the successor's owned parameter; `confirm(badge)`
// and `last_byte(badge)` then forward that owned arrival whole into the next
// state. The view field travels as its two-word descriptor beside the scalar:
// every copy keeps the literal's image backing and extent, and copy permission
// neither establishes the field's predicate nor extends its loan. Each state
// reads its own copy: the extent and the scalar, then the bytes and the
// scalar, then one indexed byte.
//
//   label = "north" (5 bytes, label[4] = 'h' = 104), rank = 9
//
// exits: 70 = every state saw the view and the rank; 71 = wrong extent or
// rank after the first edge; 72 = wrong bytes or rank after the second edge;
// 73 = wrong extent or byte after the third edge.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Badge [copy] {
    label: &[u8] in Utf8;
    rank: u64;
}

data Main {
    badge: Badge;
}

machine Main::main(main: &mut Main) reaches Console {
    main.badge.label = "north";
    main.badge.rank = 9;
    transition { _ -> inspect(main, main.badge) }

    state inspect(main: &mut Main, badge: Badge) {
        transition badge.label.len == 5 && badge.rank == 9 {
            true -> confirm(main, badge)
            false -> finish(main, 71)
        }
    }

    state confirm(main: &mut Main, badge: Badge) {
        transition badge.label == "north" && badge.rank == 9 {
            true -> last_byte(main, badge)
            false -> finish(main, 72)
        }
    }

    state last_byte(main: &mut Main, badge: Badge) {
        transition badge.label.len > 4 {
            true -> matched(main, badge.label[4] == 104)
            false -> finish(main, 73)
        }
    }

    state matched(main: &mut Main, same: bool) {
        transition same {
            true -> finish(main, 70)
            false -> finish(main, 73)
        }
    }

    state finish(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
