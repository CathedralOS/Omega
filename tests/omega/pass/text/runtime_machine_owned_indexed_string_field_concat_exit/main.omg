domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Room {
    description: &[u8] in Utf8;
}

data Main {
    console: Console;
    rooms: [Room; 2];
    index: u64 [0..=1];
}

machine Main::main(&mut self) {
    self.index = 1;
    self.rooms[self.index].description = "prefix " + "omega";

    let room_slice: &[Room] = self.rooms.as_slice();
    transition room_slice[self.index].description == "prefix omega" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(81);
    }

    state bad(&mut self) {
        self.console.exit_process(82);
    }
}
