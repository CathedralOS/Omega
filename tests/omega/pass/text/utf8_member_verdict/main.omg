// A `&[u8] in Utf8` wire member: the decoder validates UTF-8 at the
// boundary — an honest three-byte `euro` decodes Sound; a hand-crafted
// overlong run decodes Invalid.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
data LabelMessage {
    #0 count: u32;
    #1 label: &[u8] in Utf8;
}
data LabelSample {
    count: u32;
    label: &[u8] in Utf8;
}
data WireVerdict {
    case Invalid;
    case Sound;
}
data Main {
    buffer: [u8; 16];
    read: u64;
    verdict: WireVerdict;
}
machine Main::main(main: &mut Main) {
    // count=7 then a 3-byte label: E2 82 AC (U+20AC euro sign).
    main.buffer[0] = 0;
    main.buffer[1] = 0;
    main.buffer[2] = 7;
    main.buffer[3] = 1;
    main.buffer[4] = 3;
    main.buffer[5] = 226;
    main.buffer[6] = 130;
    main.buffer[7] = 172;
    let decoded: LabelSample;
    decoded.count = 0;
    decoded.label = "";
    LabelMessage::decode(&mut decoded, &main.buffer, &mut main.read, &mut main.verdict);
    transition main.verdict == WireVerdict::Sound && decoded.count == 7 {
        true -> overlong(main)
        _ -> bad()
    }
    machine overlong(main: &mut Main) {
        // Overlong zero: E0 80 80 must decode Invalid.
        main.buffer[5] = 224;
        main.buffer[6] = 128;
        main.buffer[7] = 128;
        main.read = 0;
        main.verdict = WireVerdict::Sound;
        let second: LabelSample;
        second.count = 0;
        second.label = "";
        LabelMessage::decode(&mut second, &main.buffer, &mut main.read, &mut main.verdict);
        transition main.verdict == WireVerdict::Invalid {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() {}
}
