domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
// A string literal supplied on a state edge to a `&[u8] in Utf8` state
// parameter establishes that domain at the edge, and forwarding the
// parameter to another `&[u8] in Utf8` state keeps it. The final state reads
// the forwarded view's length and first byte, so the descriptor must survive
// both edges natively: "no" has length 2 and starts with 110, "yes" would
// have length 3. Exit 70 = the selected literal arrived intact; 71 = wrong
// length or byte.
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    transition false {
        true -> relay(main, "yes")
        false -> relay(main, "no")
    }

    machine relay(main: &mut Main, text: &[u8] in Utf8) {
        transition {
            _ -> consume(main, text)
        }
    }

    machine consume(main: &mut Main, text: &[u8] in Utf8) {
        transition text.len == 2 && text[0] == 110 {
            true -> good(main)
            false -> bad(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
