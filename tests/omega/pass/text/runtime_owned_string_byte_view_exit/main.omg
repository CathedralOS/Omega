// An owned bounded text carrier exposes its initialized prefix as a borrowed
// byte view. Both runtimes must preserve the carrier's runtime length while
// projecting the inline bytes; the view must not expose the unused capacity.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);

use omega_language_std::console;

data Main {
    text: TextBuffer;
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    main.text = TextBuffer { storage: [65u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 1 };
    let bytes: &[u8] in Utf8 = TextBuffer::view(&main.text);

    transition bytes.len > 0 {
        true -> check(main, bytes)
        false -> bad(main)
    }

    machine check(main: &mut Main, bytes: &[u8]) {
        transition bytes[0] == 65 {
            true -> good(main)
            false -> bad(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}


// A variable-fill value explicitly owns its fixed storage and live length.
// Copies retain both; an accessor borrows and checks the selected copy's prefix.
data TextBuffer [copy] where used <= 8 { storage: [u8; 8] in Utf8; used: u64; }
machine TextBuffer::view(buffer: &TextBuffer) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    machine checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    machine bad() -> &[u8] in Utf8 { crash Trap; }
}
machine TextBuffer::equal(buffer: &TextBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = TextBuffer::view(buffer);
    bytes == expected
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
