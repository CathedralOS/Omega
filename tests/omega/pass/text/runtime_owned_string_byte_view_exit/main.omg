// An owned bounded text carrier exposes its initialized prefix as a borrowed
// byte view. Both runtimes must preserve the carrier's runtime length while
// projecting the inline bytes; the view must not expose the unused capacity.
domain [u8]::Utf8
requires
    valid_utf8(self);

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

use omega_language_std::console;

data Main {
    console: Console;
    text: [u8; 8] in Utf8;
}

machine Main::main(&mut self) {
    self.text = "A";
    let bytes: &[u8] in Utf8 = self.text;

    transition bytes.len > 0 {
        true -> check(bytes)
        false -> bad()
    }

    state check(&mut self, bytes: &[u8]) {
        transition bytes[0] == 65 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
