// An owned bounded text carrier exposes its initialized prefix as a borrowed
// byte view. Both runtimes must preserve the carrier's runtime length while
// projecting the inline bytes; the view must not expose the unused capacity.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);

domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    text: [u8; 8] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.text = "A";
    let bytes: &[u8] in Utf8 = main.text;

    transition bytes.len > 0 {
        true -> check(main, bytes)
        false -> bad(main)
    }

    state check(main: &mut Main, bytes: &[u8]) {
        transition bytes[0] == 65 {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
