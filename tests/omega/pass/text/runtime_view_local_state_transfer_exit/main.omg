// A reassigned borrowed-view local forwards its current descriptor to the
// next state, which observes the second view.
use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let mut out_line: &[u8] = "Door";
    out_line = "Gate";
    transition { _ -> check(main, out_line) }

    state check(main: &mut Main, text: &[u8]) {
        transition text == "Gate" {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
