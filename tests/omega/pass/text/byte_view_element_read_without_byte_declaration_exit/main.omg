// A byte view's element is a `u8` leaf even when no program declaration
// names `u8`. Native reads take that leaf's storage from the view itself:
// a parameter, a local copy, a call result and a state parameter, indexed
// directly or compared against a literal.
machine pick(text: &[u8]) -> &[u8] { text }

machine first(text: &[u8]) -> bool { text.len > 0 && text[0] == 110 }

machine copied(text: &[u8]) -> bool {
    let copy: &[u8] = text;
    copy == "new"
}

machine returned(text: &[u8]) -> bool {
    let view: &[u8] = pick(text);
    view.len > 1 && view[1] == 101
}

machine last(text: &[u8]) -> bool {
    transition text.len == 3 {
        true -> check(text)
        false -> no()
    }
    machine check(view: &[u8]) -> bool { view.len == 3 && view[2] == 119 }
    machine no() -> bool { false }
}

machine Main::main() crashes Trap {
    let accepted: bool = first("new") && copied("new") && returned("new") && last("new");
    let refused: bool = first("old") || copied("old") || returned("old") || last("old");
    transition accepted && !refused {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
