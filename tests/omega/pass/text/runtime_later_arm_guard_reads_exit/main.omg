// Each arm of a multi-arm transition evaluates its guard only after every
// earlier arm fails, so an earlier guard can make a later guard's operands
// defined: `index >= text.len -> ..` rules in `text[index]` and
// `byte_at(text, index)` in the arms after it, and so does its negated
// spelling `!(index < text.len)`. The word counter recurses from three arms.
// Expected exit: 70.
use omega_language_std::console;

data Main { }

machine count_words(text: &[u8], index: u64, in_word: bool, count: u64) -> u64
terminates by (index, text.len) -> Nat::BoundedDistance;
requires count <= index
{
    transition {
        index >= text.len -> (count)
        text[index] == 32 -> count_words(text, index + 1, false, count)
        in_word -> count_words(text, index + 1, true, count)
        _ -> count_words(text, index + 1, true, count + 1)
    }
}

machine at_space(text: &[u8], index: u64) -> bool {
    transition {
        index >= text.len -> (false)
        text[index] == 32 -> (true)
        _ -> (false)
    }
}

machine byte_at(text: &[u8], index: u64) -> u8
requires index < text.len
{
    text[index]
}

machine first_space(text: &[u8], index: u64) -> u64
terminates by (index, text.len) -> Nat::BoundedDistance;
{
    transition {
        index >= text.len -> (index)
        byte_at(text, index) == 32 -> (index)
        _ -> first_space(text, index + 1)
    }
}

machine at_space_negated(text: &[u8], index: u64) -> bool {
    transition {
        !(index < text.len) -> (false)
        text[index] == 32 -> (true)
        _ -> (false)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let words: u64 = count_words("the quick  brown fox", 0, false, 0);
    let space: bool = at_space("a b", 1);
    let found: u64 = first_space("ab cd", 0);
    let negated: bool = at_space_negated("a b", 1);
    transition words == 4 && space && found == 2 && negated {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
