// Numeric OUTPUT: rendering an integer to decimal TEXT (itoa) -- a fundamental
// serious-app capability (printing computed numbers, not just exit codes). A
// round-trip: build n = 12345 at RUNTIME (a loop accumulates 5 x 2469 so the value
// is not const-folded), then convert it back to the 5-digit decimal string "12345"
// and assert the carrier equals it. Exercises runtime divide/modulo, computed
// carrier byte writes, and the carrier-vs-literal compare. Exits 70.
//
// The digit conversion writes its named wrapping-narrow result directly into
// the runtime-indexed carrier. This pins value-call-result lowering at an
// indexed destination without a field temporary.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 5]::Utf8(bytes)
requires
    valid_utf8(bytes);
data Main {
    out: [u8; 5] in Utf8;
    n: u32 in Wrapping;
    place: u32 in Wrapping;
    d: u32 in Wrapping;
    ch: u32 in Wrapping;
    i: u32 in Wrapping;
    p: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.out = "XXXXX";
    main.n = 0;
    main.i = 0;
    transition { _ -> build(main) }

    // Build n = 12345 at runtime (5 x 2469) so the conversion runs on a real value.
    state build(main: &mut Main) {
        transition main.i < 5 { true -> build_step(main) _ -> itoa_init(main) }
    }
    state build_step(main: &mut Main) {
        main.n = main.n + 2469;
        main.i = main.i + 1;
        transition { _ -> build(main) }
    }

    // Convert: for each place (10000, 1000, 100, 10, 1) write the digit char.
    state itoa_init(main: &mut Main) {
        main.place = 10000;
        main.p = 0;
        transition { _ -> itoa_loop(main) }
    }
    // `place` runs 10000, 1000, 100, 10, 1 while `p < 5`, but that relation
    // between two fields is not a fact checking derives; the guard states the
    // nonzero divisor that `digit_div`'s Wrapping division requires.
    state itoa_loop(main: &mut Main) {
        transition main.p < 5 && main.place != 0 { true -> digit_div(main) _ -> check(main) }
    }
    state digit_div(main: &mut Main) {
        main.d = main.n / main.place;
        transition { _ -> digit_mod(main) }
    }
    state digit_mod(main: &mut Main) {
        main.d = main.d % 10;
        transition { _ -> digit_write(main) }
    }
    state digit_write(main: &mut Main) {
        main.ch = main.d + 48;
        main.out[main.p] = narrow_u32_to_u8_wrapping(main.ch as u32);
        main.place = main.place / 10;
        main.p = main.p + 1;
        transition { _ -> itoa_loop(main) }
    }

    state check(main: &mut Main) {
        transition main.out == "12345" { true -> ok(main) _ -> bad(main) }
    }
    state ok(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
