// Numeric OUTPUT: rendering an integer to decimal TEXT (itoa) -- a fundamental
// serious-app capability (printing computed numbers, not just exit codes). A
// round-trip: build n = 12345 at RUNTIME (a loop accumulates 5 x 2469 so the value
// is not const-folded), then convert it back to the 5-digit decimal string "12345"
// and assert the carrier equals it. Exercises runtime divide/modulo, computed
// carrier byte writes, and the carrier-vs-literal compare. Exits 70.
//
// The digit conversion writes its named wrapping-narrow result directly into
// the runtime-indexed carrier. This pins value-call-result lowering at an
// indexed destination without a field temporary.

use omega_language_std::console;
use omega::language::core::numeric_conversion;

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 5]::Utf8
requires
    valid_utf8(self);
data Main {
    console: Console;
    out: [u8; 5] in Utf8;
    n: u32 in Wrapping;
    place: u32 in Wrapping;
    d: u32 in Wrapping;
    ch: u32 in Wrapping;
    i: u32 in Wrapping;
    p: u64;
}

machine Main::main(&mut self) {
    self.out = "XXXXX";
    self.n = 0;
    self.i = 0;
    transition { _ -> build() }

    // Build n = 12345 at runtime (5 x 2469) so the conversion runs on a real value.
    state build(&mut self) {
        transition self.i < 5 { true -> build_step() _ -> itoa_init() }
    }
    state build_step(&mut self) {
        self.n = self.n + 2469;
        self.i = self.i + 1;
        transition { _ -> build() }
    }

    // Convert: for each place (10000, 1000, 100, 10, 1) write the digit char.
    state itoa_init(&mut self) {
        self.place = 10000;
        self.p = 0;
        transition { _ -> itoa_loop() }
    }
    state itoa_loop(&mut self) {
        transition self.p < 5 { true -> digit_div() _ -> check() }
    }
    state digit_div(&mut self) {
        self.d = self.n / self.place;
        transition { _ -> digit_mod() }
    }
    state digit_mod(&mut self) {
        self.d = self.d % 10;
        transition { _ -> digit_write() }
    }
    state digit_write(&mut self) {
        self.ch = self.d + 48;
        self.out[self.p] = narrow_u32_to_u8_wrapping(self.ch as u32);
        self.place = self.place / 10;
        self.p = self.p + 1;
        transition { _ -> itoa_loop() }
    }

    state check(&mut self) {
        transition self.out == "12345" { true -> ok() _ -> bad() }
    }
    state ok(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
