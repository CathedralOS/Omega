// A declared borrowed-view local is established by its first whole store.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut out_line: &[u8] in Utf8;
    out_line = "Door";
    transition out_line == "Door" {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
