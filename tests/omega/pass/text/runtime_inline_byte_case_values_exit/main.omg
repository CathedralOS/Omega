// A returned case owns its inline text bytes, live length and common fields.
// Payload loans observe and mutate that storage; a prior copy stays independent.
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Text [copy] { bytes: [u8; 8] in Utf8; }
data Reply [copy] {
    sequence: u64;
    case Empty;
    case Message(content: Text);
}
data DirectReply [copy] {
    header: [u8; 8] in Utf8;
    sequence: u64;
    case Empty;
    case Message(content: [u8; 8] in Utf8);
}

machine make() -> Reply {
    Reply::Message { sequence: 17, content: Text { bytes: "Gate" } }
}
machine observe(reply: Reply) -> bool {
    transition reply {
        Reply::Message { sequence as _, content } -> (reply.sequence == 17 && content.bytes == "Gate")
        Reply::Empty -> (false)
    }
}
machine make_direct() -> DirectReply {
    DirectReply::Message { content: "Next", sequence: 29, header: "Common" }
}
machine observe_direct(reply: DirectReply) -> bool {
    transition reply {
        DirectReply::Message { header as _, sequence as _, content } -> (reply.sequence == 29 && reply.header == "Common" && content == "Next")
        DirectReply::Empty -> (false)
    }
}
machine size(bytes: &[u8]) -> u64 { bytes.len }
machine observe_borrowed(reply: &DirectReply, header_size: u64, content_size: u64) -> bool {
    let common: u64 = size(&reply.header);
    transition reply {
        DirectReply::Message { header as _, sequence as _, content } -> (common == header_size && size(&content) == content_size && content.len == content_size)
        DirectReply::Empty -> (common == header_size && content_size == 0)
    }
}
machine replace(bytes: &mut [u8; 8] in Utf8) -> bool { bytes = "é"; true }
machine edit(reply: &mut DirectReply) -> bool {
    transition reply {
        DirectReply::Message { header as _, sequence as _, content } -> (replace(&mut content))
        DirectReply::Empty -> true
    }
}
machine main() crashes Trap {
    let valid: bool = observe(make());
    transition valid { true -> direct(make_direct()) false -> bad() }
    state direct(reply: DirectReply) {
        let copied: DirectReply = reply;
        let changed: DirectReply = make_direct();
        let before: DirectReply = changed;
        let edited: bool = edit(&mut changed);
        let empty: DirectReply = DirectReply::Empty { header: "Empty", sequence: 0 };
        let blank: DirectReply = DirectReply::Message { header: "", sequence: 0, content: "" };
        let valid: bool = observe_direct(copied) && edited
            && observe_borrowed(&changed, 6, 2) && observe_borrowed(&before, 6, 4)
            && observe_borrowed(&empty, 5, 0) && observe_borrowed(&blank, 0, 0);
        transition valid { true -> done() false -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}
