// #66: stdin `read_line` through the standard Console surface into an owned
// `[u8; N] in Utf8` carrier. The line is read
// straight into the carrier's inline bytes (length at offset 0, content at offset
// pointer_size) -- no `{ptr, len}` descriptor and no separate buffer -- then
// echoed back with `write_line`. Replaces the `String` round-trip with the owned
// carrier end to end.
use omega_language_std::console;

domain [u8; 64]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Console;
    line: [u8; 64] in Utf8;
}

machine Main::main(&mut self) {
    self.console.write("> ");
    self.console.read_line(&mut self.line);
    self.console.write_line(self.line);
    self.console.exit_process(0);
}
