// #66: a stdin command parser over an owned bounded byte carrier. The field's
// zero/default value begins in Utf8, but `Console::read_line` is an UNTRUSTED
// raw-byte write and correctly invalidates that fact. Command recognition does
// not need to assert text validity: it compares the resulting byte view with
// ASCII protocol tokens, and every other byte sequence routes to Invalid.
// This keeps inbound validation honest while exercising the standard Console
// surface with no `String`.
use omega_language_std::console;

domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Parser {
}

machine Parser::resolve(&mut self, line: &[u8]) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

data Main {
    console: Console;
    line: [u8; 32] in Utf8;
    parser: Parser;
    command: Command;
}

machine Main::main(&mut self) {
    self.console.read_line(&mut self.line);
    self.command = self.parser.resolve(&self.line);

    transition self.command {
        Command::Look -> look()
        Command::Quit -> quit()
        Command::Invalid -> invalid()
    }

    state look(&mut self) {
        self.console.write_line("look");
        self.console.exit_process(0);
    }

    state quit(&mut self) {
        self.console.write_line("quit");
        self.console.exit_process(0);
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        self.console.exit_process(1);
    }
}
