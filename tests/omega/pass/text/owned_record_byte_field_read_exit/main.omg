// A record keeps readable byte-field custody across a named state and an
// ordinary owned call. Reading the field constructs independent output bytes;
// it neither consumes the copyable record nor changes its neighboring field.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);

data Label [copy] { text: [u8; 8] in Utf8; sibling: u64; }
data Main {
    console: Binding<Console>;
    source: Label;
    owned_line: [u8; 16] in Utf8;
    shared_line: [u8; 16] in Utf8;
}

machine render_owned(label: Label, output: &mut [u8; 16] in Utf8) {
    output = label.text + "!";
}

machine render_shared(label: &Label, output: &mut [u8; 16] in Utf8) {
    output = label.text + "?";
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.text = "Gate";
    main.source.sibling = 29;
    transition { _ -> render(main) }

    state render(main: &mut Main) {
        render_owned(main.source, &mut main.owned_line);
        render_shared(&main.source, &mut main.shared_line);
        transition main.owned_line == "Gate!"
            && main.owned_line.len == 5
            && main.shared_line == "Gate?"
            && main.shared_line.len == 5
            && main.source.text == "Gate"
            && main.source.text.len == 4
            && main.source.sibling == 29
            && main.source.text == "Gate"
            && main.source.text.len == 4
            && main.source.sibling == 29 {
            true -> finish(main, 70)
            false -> finish(main, 1)
        }
    }

    state finish(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
