// A record keeps readable byte-field custody across a named state and an
// ordinary owned call. Reading the field constructs independent output bytes;
// it neither consumes the copyable record nor changes its neighboring field.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8]::Utf8 requires valid_utf8(self);
domain [u8; 8]::Utf8 requires valid_utf8(self);
domain [u8; 16]::Utf8 requires valid_utf8(self);

data Label [copy] { text: [u8; 8] in Utf8; sibling: u64; }
data Main {
    console: Binding<Console>;
    source: Label;
    owned_line: [u8; 16] in Utf8;
    shared_line: [u8; 16] in Utf8;
}

machine render_owned(label: Label, output: &mut [u8; 16] in Utf8) {
    output = label.text + "!";
}

machine render_shared(label: &Label, output: &mut [u8; 16] in Utf8) {
    output = label.text + "?";
}

machine Main::main(&mut self) reaches Console {
    self.source.text = "Gate";
    self.source.sibling = 29;
    transition { _ -> render(self.source) }

    state render(&mut self, source: Label) {
        render_owned(source, &mut self.owned_line);
        render_shared(&self.source, &mut self.shared_line);
        transition self.owned_line == "Gate!"
            && self.owned_line.len == 5
            && self.shared_line == "Gate?"
            && self.shared_line.len == 5
            && source.text == "Gate"
            && source.text.len == 4
            && source.sibling == 29
            && self.source.text == "Gate"
            && self.source.text.len == 4
            && self.source.sibling == 29 {
            true -> finish(70)
            false -> finish(1)
        }
    }

    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
