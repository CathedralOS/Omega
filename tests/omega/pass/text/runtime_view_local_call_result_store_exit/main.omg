// Assigning a call's returned view to a view local stores that completed
// descriptor in the local's home, as any other descriptor source.
use omega_language_std::console;

data Main { }

machine pick<'a>(bytes: &'a [u8]) -> &'a [u8] {
    bytes
}

machine Main::main(main: &mut Main) reaches Console {
    let mut view: &[u8] = "Door";
    view = pick("Gate");
    transition view == "Gate" {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
