// #66 owned `[u8; N] in Utf8` carrier multi-segment concat into a `&mut` OUT-PARAM
// (the dungeon render-line shape): `out_line = "== " + formatter.label + " =="` writes
// across a machine boundary into a borrowed carrier. The first literal initializes
// the target carrier (len + bytes), the source carrier `formatter.label` is appended at
// the running length, then the trailing literal is appended -- three segments, no
// `String`, no `{ptr, len}` descriptor. `main.line = ""` establishes the
// out-param's `in Utf8` domain before the call. `main.line == "== Gate =="` matches
// (length 10, every byte) -> exit 70.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Formatter {
    label: [u8; 8] in Utf8;
}

machine Formatter::render(formatter: &mut Formatter, out_line: &mut [u8; 16] in Utf8) {
    out_line = "== " + formatter.label + " ==";
}

data Main {
    console: Binding<Console>;
    formatter: Formatter;
    line: [u8; 16] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.formatter.label = "Gate";
    main.line = "";
    Formatter::render(&mut main.formatter, &mut main.line);

    transition main.line == "== Gate ==" {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
