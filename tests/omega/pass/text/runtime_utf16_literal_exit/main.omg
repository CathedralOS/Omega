// `utf16"..."` -- UTF-16 text sugar for UEFI/Windows CHAR16 data (the
// milestone-1 greeting is `utf16"Hello from Omega\r\n\0"`). Desugars AT PARSE
// to the ordinary integer array literal of the string's UTF-16 code units, so
// it fits any `[u16; N]` context, both backends and the interpreter see plain
// integers, and escapes ride the existing string decoder. Verifies 'H' = 72 at
// [0], '\n' = 10 at [17], and the NUL terminator at [18].
use omega_language_std::console;
data Main { msg: [u16; 19]; a: u16; b: u16; c: u16; }
machine Main::main(main: &mut Main) reaches Console {
    main.msg = utf16"Hello from Omega\r\n\0";
    main.a = main.msg[0];
    main.b = main.msg[17];
    main.c = main.msg[18];
    transition main.a == 72 {
        true -> check_nl(main)
        false -> bad(main)
    }
    state check_nl(main: &mut Main) {
        transition main.b == 10 { true -> check_nul(main) false -> bad(main) }
    }
    state check_nul(main: &mut Main) {
        transition main.c == 0 { true -> good(main) false -> bad(main) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
