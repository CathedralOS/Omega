// RUN CANARY (exit 70). A `[copy]` record carrying a shared view field
// crosses a state edge by value: `render(main.source)` copies the record out
// of the receiver into the successor's owned parameter. The copied view keeps
// its source loan's lineage (here the literal's image storage), and copy
// permission establishes no predicate: `label` stays valid UTF-8 because
// every write into the source preserved it. The successor reads the copied
// field's length and bytes. 71 = wrong extent, 72 = wrong bytes.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Room [copy] {
    label: &[u8] in Utf8;
}

data Main {
    source: Room;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.label = "Gate";

    transition {
        _ -> render(main)
    }

    state render(main: &mut Main) {
        transition main.source.label.len == 4 {
            true -> contents(main, main.source)
            false -> wrong_extent(main)
        }
    }

    state contents(main: &mut Main, source: Room) {
        transition source.label == "Gate" {
            true -> good(main)
            false -> wrong_bytes(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state wrong_extent(main: &mut Main) {
        Console::exit_process(71);
    }

    state wrong_bytes(main: &mut Main) {
        Console::exit_process(72);
    }
}
