// RUN CANARY (exit 70) + interpreter differential. A never-written bounded
// UTF-8 carrier is empty `{len, bytes}` text when passed through the host-write
// adapter. This pins the carrier-to-borrowed-view boundary path independently
// of bounded-carrier equality.
use omega::language::std::console;

domain [u8; 16]::Utf8
requires
    valid_utf8(self);

data Main { console: Console; never: [u8; 16] in Utf8; }
machine Main::main(&mut self) {
    self.console.write_line(self.never);
    self.console.write_line("after-zii");
    self.console.exit_process(70);
}
