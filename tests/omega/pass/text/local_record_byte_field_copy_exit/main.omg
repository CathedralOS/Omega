domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
// A field copy observes the local's current bytes after a completed call,
// snapshots them, and preserves them when another call changes the source.
use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Text [copy] { bytes: TextBuffer; }
data Room [copy] { description: Text; }
data Main { output: TextBuffer; }

machine fill(room: &mut Room) crashes Trap {
    room.description.bytes = TextBuffer { storage: [98u8, 101u8, 102u8, 111u8, 114u8, 101u8, 0u8, 0u8], used: 6 };
    room.description.bytes = TextBuffer { storage: [195u8, 169u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 2 };
}

machine change(room: &mut Room) crashes Trap {
    room.description.bytes = TextBuffer { storage: [99u8, 104u8, 97u8, 110u8, 103u8, 101u8, 100u8, 0u8], used: 7 };
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let room: Room;
    fill(&mut room);
    main.output = room.description.bytes;
    change(&mut room);
    let output: &[u8] in Utf8 = TextBuffer::view(&main.output);
    Console::write_line(output);
    Console::exit_process(70);
}


// A variable-fill value explicitly owns its fixed storage and live length.
// Copies retain both; an accessor borrows and checks the selected copy's prefix.
data TextBuffer [copy] where used <= 8 { storage: [u8; 8] in Utf8; used: u64; }
machine TextBuffer::view(buffer: &TextBuffer) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine TextBuffer::equal(buffer: &TextBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = TextBuffer::view(buffer);
    bytes == expected
}
