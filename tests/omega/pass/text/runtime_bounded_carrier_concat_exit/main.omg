// Runtime concatenation copies the literal and the label's live bytes into
// a fresh owned result before replacing text's inline storage. Capacity is a
// bound, not readable content: label has capacity 4 but contains only 2 bytes.
// The separate receiving proof establishes that the result fits text's capacity
// 16. Equality observes the resulting length 7 and every byte; only Room A1
// reaches exit 70.
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 16]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    label: [u8; 4] in Utf8;
    text: [u8; 16] in Utf8;
}

machine Main::main(main: &mut Main) reaches Console {
    main.label = "A1";
    main.text = "Room " + main.label;

    transition main.text == "Room A1" {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
