// A plain `[u8; 4]` record field, nested two records deep, beside a
// `[u8; 4] in Utf8` local lent to a state. The plain field is fixed array
// storage and the qualified local a bounded byte owner, so each keeps its own
// structural plan whichever body is planned first: the field is read by one
// helper declared before the state loan and one declared after it.
// "G..E" stored and read through the field, "gate" through the loan: exit 70.
use omega_language_std::console;

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 4]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Header { tag: [u8; 4]; }
data Packet { header: Header; size: u64; }
data Main { packet: Packet; }

machine Main::first_tag(main: &Main) -> u8 {
    transition { _ -> (main.packet.header.tag[0]) }
}

machine Main::main(main: &mut Main) reaches Console {
    main.packet.header.tag[0] = 71;
    main.packet.header.tag[3] = 69;
    main.packet.size = 4;
    let mut text: [u8; 4] in Utf8 = "gate";
    let first: u8 = Main::first_tag(main);
    let last: u8 = Main::last_tag(main);
    transition { _ -> check(main, &mut text, first, last) }

    state check(main: &mut Main, text: &mut [u8; 4] in Utf8, first: u8, last: u8) {
        transition first == 71 && last == 69 && text[0] == 103 && text[3] == 101
            && main.packet.size == 4 {
            true -> finish(main, 70)
            _ -> finish(main, 71)
        }
    }

    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::last_tag(main: &Main) -> u8 {
    transition { _ -> (main.packet.header.tag[3]) }
}
