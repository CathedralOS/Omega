domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Room [copy] {
    label: &[u8] in Utf8;
}

data Main {
    console: Binding<Console>;
    source: Room;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.label = "Gate";

    transition {
        _ -> render(main)
    }

    state render(main: &mut Main) {
        let room: Room;
        let mut out_line: &[u8] in Utf8;

        room.label = main.source.label;
        out_line = "== " + room.label;

        transition out_line == "== Gate" {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(193);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(194);
    }
}
