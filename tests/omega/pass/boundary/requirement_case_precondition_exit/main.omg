// A boundary requirement's own `requires subject in T::Case` lowers as a tag
// observation of the actual parameter referent, so the requirement call has an
// executable declaration. The selected named implementation writes 41 through
// the case payload; the caller observes it beside an untouched neighbor.
// Expected exit: 0
data Slot { case Absent; case Present(value: i64); }
boundary trait Fill {
    machine fill(chosen: &mut Slot) -> i64 reaches requires chosen in Slot::Present;
}
Filler satisfies Fill {
    machine fill(chosen: &mut Slot) -> i64 requires chosen in Slot::Present {
        chosen.value = 41;
        5
    }
}
machine main() crashes Trap {
    let mut chosen: Slot = Slot::Present { value: 17 };
    let neighbor: i64 = 19;
    let returned: i64 = Fill::fill(&mut chosen);
    transition chosen {
        Slot::Present { value } -> check(returned, value, neighbor)
        _ -> wrong()
    }
    machine check(returned: i64, value: i64, neighbor: i64) crashes Trap {
        transition returned == 5 && value == 41 && neighbor == 19 { true -> done() false -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
