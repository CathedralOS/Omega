// A later state of a receiverless checked machine calls a one-member
// boundary-trait requirement that publishes a nonempty service ceiling, and the
// call's scalar result is the machine's result. `TimedWaitPoll::poll` is bound
// to libSystem's `_poll` on macOS and libc `poll` on Linux; given no descriptors
// it waits out its timeout and returns 0. `TimedWait::wait` reaches its
// `at_once` state before calling it.
// Main brackets the wait with CLOCK_MONOTONIC reads and exits 70 when poll
// returned 0 after at least 20,000,000 nanoseconds, 71 when it returned
// early, and 72 on a nonzero result or a clock that went backwards.
// Expected exit: 70.
use omega_language_std::Console;
use omega_language_std::Clock;
use omega::language::core::narrow_u32_to_i32_wrapping;
use omega::language::core::narrow_i64_to_u64_saturating;

data TimedWait { }

boundary trait TimedWaitPoll {
    machine poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
    reaches
    Clock;
}

// poll reads a signed timeout, so a count above `i32::MAX` is refused.
machine TimedWait::wait(milliseconds: u32) -> i32
reaches
    Clock
{
    transition milliseconds > 2147483647 {
        true -> refused()
        _ -> at_once(milliseconds)
    }
    machine refused() -> i32 { 0 - 1 }
    machine at_once(milliseconds: u32) -> i32 {
        let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
        let ready: i32 = TimedWaitPoll::poll(0, 0, timeout);
        ready
    }
}

data Main {
}

machine Main::main(context: &mut Main) reaches Console + Clock {
    let before: u64 = ElapsedClock::now(6);
    let ready: i32 = TimedWait::wait(20);
    let after: u64 = ElapsedClock::now(6);
    transition after >= before && ready == 0 {
        true -> measure(&mut context, after - before)
        false -> failed(&mut context)
    }
    machine measure(context: &mut Main, elapsed: u64) {
        transition elapsed >= 20000000 {
            true -> waited(&mut context)
            false -> early(&mut context)
        }
    }
    machine waited(context: &mut Main) { Console::exit_process(70); }
    machine early(context: &mut Main) { Console::exit_process(71); }
    machine failed(context: &mut Main) { Console::exit_process(72); }
}

// The scalar clock seam is a libSystem binding on Darwin and a checked timespec
// adapter on Linux. Both expose nanoseconds on CLOCK_MONOTONIC to the same callers.
// The Linux adapter calls `ElapsedClockRead`, so that call is part of the ceiling.
boundary trait ElapsedClock {
    machine now(selector: u32) -> u64 reaches Clock
    invokes ElapsedClockRead;
}
data ElapsedClockImports {}
data ElapsedInstant { seconds: i64; nanoseconds: i64; }
boundary trait ElapsedClockRead {
    machine read(selector: u32, instant: &mut ElapsedInstant) -> i32 reaches;
}

linux_x86_64 machine ElapsedClockImports::now(selector: u32) -> u64
    satisfies ElapsedClock::now reaches Clock {
    let mut instant: ElapsedInstant = ElapsedInstant { seconds: 0, nanoseconds: 0 };
    let status: i32 = ElapsedClockRead::read(1, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        false -> failed()
    }
    machine measured(seconds: i64, nanoseconds: i64) -> u64 {
        let whole: u64 = narrow_i64_to_u64_saturating(seconds);
        let fraction: u64 = narrow_i64_to_u64_saturating(nanoseconds);
        let scaled: u64 in Wrapping = (whole as u64 in Wrapping) * 1000000000;
        let total: u64 in Wrapping = scaled + (fraction as u64 in Wrapping);
        total as u64
    }
    machine failed() -> u64 { 0 }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + Clock {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
