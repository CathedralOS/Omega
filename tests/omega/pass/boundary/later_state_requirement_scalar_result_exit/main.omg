// A later state of a receiverless checked machine calls a top-level
// `boundary requirement` that publishes a nonempty service ceiling, and the
// call's scalar result is the machine's result. `TimedWait::poll` is realized
// by libSystem's `_poll`; given no descriptors it waits out its timeout and
// returns 0. `TimedWait::wait` reaches its `at_once` state before calling it.
// Main brackets the wait with CLOCK_MONOTONIC reads and exits 70 when poll
// returned 0 after at least 20,000,000 nanoseconds, 71 when it returned
// early, and 72 on a nonzero result or a clock that went backwards.
// Expected exit: 70.
use omega_language_std::console;
use omega_language_std::clock;
use omega_language_std::macos_gui;
use omega::language::core::binding;
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;

data TimedWait { }

boundary requirement TimedWait::poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
reaches
    Clock;

data TimedWaitImport { }

macos_arm64 machine timed_wait_poll_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_poll",
        },
    }
}

macos_arm64 machine TimedWaitImport::poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
    satisfies TimedWait::poll
    via timed_wait_poll_binding();

// poll reads a signed timeout, so a count above `i32::MAX` is refused.
machine TimedWait::wait(milliseconds: u32) -> i32
reaches
    Clock
{
    transition milliseconds > 2147483647 {
        true -> refused()
        _ -> at_once(milliseconds)
    }
    state refused() -> i32 { 0 - 1 }
    state at_once(milliseconds: u32) -> i32 {
        let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
        let ready: i32 = TimedWait::poll(0, 0, timeout);
        ready
    }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console + Clock + DarwinClock {
    let before: u64 = darwin_clock_ns(6);
    let ready: i32 = TimedWait::wait(20);
    let after: u64 = darwin_clock_ns(6);
    transition after >= before && ready == 0 {
        true -> measure(&mut context, after - before)
        false -> failed(&mut context)
    }
    state measure(context: &mut Main, elapsed: u64) {
        transition elapsed >= 20000000 {
            true -> waited(&mut context)
            false -> early(&mut context)
        }
    }
    state waited(context: &mut Main) { context.console.exit_process(70); }
    state early(context: &mut Main) { context.console.exit_process(71); }
    state failed(context: &mut Main) { context.console.exit_process(72); }
}
