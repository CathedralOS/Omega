// A later state of a receiverless checked machine calls a top-level
// `boundary requirement` that publishes a nonempty service ceiling, and the
// call's scalar result is the machine's result. `TimedWait::poll` is realized
// by libSystem's `_poll`; given no descriptors it waits out its timeout and
// returns 0. `TimedWait::wait` reaches its `at_once` state before calling it.
// Main brackets the wait with CLOCK_MONOTONIC reads and exits 70 when poll
// returned 0 after at least 20,000,000 nanoseconds, 71 when it returned
// early, and 72 on a nonzero result or a clock that went backwards.
// Expected exit: 70.
use omega_language_std::console;
use omega_language_std::clock;
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;

data TimedWait { }

boundary requirement TimedWait::poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
reaches
    Clock;

data TimedWaitImport { }

macos_arm64 machine timed_wait_poll_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_poll",
        },
    }
}

macos_arm64 machine TimedWaitImport::poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
    satisfies TimedWait::poll
    via timed_wait_poll_binding();

linux_x86_64 machine linux_timed_wait_poll_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "poll", version: "GLIBC_2.2.5"
    } }
}
linux_x86_64 machine TimedWaitImport::poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32) -> i32
    satisfies TimedWait::poll via linux_timed_wait_poll_binding();

// poll reads a signed timeout, so a count above `i32::MAX` is refused.
machine TimedWait::wait(milliseconds: u32) -> i32
reaches
    Clock
{
    transition milliseconds > 2147483647 {
        true -> refused()
        _ -> at_once(milliseconds)
    }
    state refused() -> i32 { 0 - 1 }
    state at_once(milliseconds: u32) -> i32 {
        let timeout: i32 = narrow_u32_to_i32_wrapping(milliseconds);
        let ready: i32 = TimedWait::poll(0, 0, timeout);
        ready
    }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main) reaches Console + Clock {
    let before: u64 = ElapsedClock::now(6);
    let ready: i32 = TimedWait::wait(20);
    let after: u64 = ElapsedClock::now(6);
    transition after >= before && ready == 0 {
        true -> measure(&mut context, after - before)
        false -> failed(&mut context)
    }
    state measure(context: &mut Main, elapsed: u64) {
        transition elapsed >= 20000000 {
            true -> waited(&mut context)
            false -> early(&mut context)
        }
    }
    state waited(context: &mut Main) { context.console.exit_process(70); }
    state early(context: &mut Main) { context.console.exit_process(71); }
    state failed(context: &mut Main) { context.console.exit_process(72); }
}

// The scalar clock seam is foreign on Darwin and a checked timespec adapter
// on Linux. Both expose nanoseconds on CLOCK_MONOTONIC to the same callers.
data ElapsedClock {}
boundary requirement ElapsedClock::now(selector: u32) -> u64 reaches Clock;
data ElapsedClockImports {}
data ElapsedInstant { seconds: i64; nanoseconds: i64; }
data ElapsedClockRead {}
boundary requirement ElapsedClockRead::read(selector: u32, instant: &mut ElapsedInstant) -> i32;

macos_arm64 machine macos_elapsed_binding() -> ForeignBinding<26, 22, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime_nsec_np"
    } }
}
macos_arm64 machine ElapsedClockImports::now(selector: u32) -> u64
    satisfies ElapsedClock::now via macos_elapsed_binding();

linux_x86_64 machine linux_elapsed_binding() -> ForeignBinding<9, 13, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "clock_gettime", version: "GLIBC_2.17"
    } }
}
linux_x86_64 machine ElapsedClockImports::read(selector: u32, instant: &mut ElapsedInstant) -> i32
    satisfies ElapsedClockRead::read via linux_elapsed_binding();

linux_x86_64 machine ElapsedClockImports::now(selector: u32) -> u64
    satisfies ElapsedClock::now reaches Clock {
    let mut instant: ElapsedInstant = ElapsedInstant { seconds: 0, nanoseconds: 0 };
    let status: i32 = ElapsedClockRead::read(1, &mut instant);
    transition status == 0 {
        true -> measured(instant.seconds, instant.nanoseconds)
        false -> failed()
    }
    state measured(seconds: i64, nanoseconds: i64) -> u64 {
        let whole: u64 = narrow_i64_to_u64_saturating(seconds);
        let fraction: u64 = narrow_i64_to_u64_saturating(nanoseconds);
        let scaled: u64 in Wrapping = (whole as u64 in Wrapping) * 1000000000;
        let total: u64 in Wrapping = scaled + (fraction as u64 in Wrapping);
        total as u64
    }
    state failed() -> u64 { 0 }
}
