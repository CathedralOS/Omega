// Darwin-only canary: the requirement's leaf binds libSystem's `_poll` and the
// measurement reads `macos_perf_counter`, so only macos_arm64 selects the entry.
machine build(builder: &mut Build) {
    Build::application(builder, "later_state_requirement_scalar_result_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
}
