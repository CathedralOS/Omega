public data Input [copy] {value:i32;}
public data Envelope [copy] {input:Input;}
public data Reader {}
public boundary requirement Reader::read(source:&Input)->i32
 crashes Trap !(source.value>=0);
data Provider {}
machine Provider::read(source:&Input)->i32 satisfies Reader::read {source.value}
machine safe(actual:&Input)->i32 requires actual.value>=0 {Reader::read(actual)}
machine keep(value:i32)->i32 {value}
data Main {}
machine Main::main(main:&mut Main) crashes Trap {
 let envelope:Envelope=Envelope{input:Input{value:7}};
 let observed:i32=keep(safe(&envelope.input));
 transition observed==7 {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
