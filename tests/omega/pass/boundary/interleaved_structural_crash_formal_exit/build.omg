machine build(builder:&mut Build){
 Build::application(builder,"mixed_scalar_structural_formals");
 Build::select_provider<StructuralRead, Provider>(builder, linux_x86_64);
 Build::select_provider<StructuralRead, Provider>(builder, linux_arm64);
 Build::select_provider<StructuralRead, Provider>(builder, macos_arm64);
 Build::select_provider<StructuralRead, Provider>(builder, windows_x86_64);
 Build::bind(builder,linux_x86_64::ProgramEntry,entry_start);
 Build::bind(builder,linux_arm64::ProgramEntry,entry_start);
 Build::bind(builder,macos_arm64::ProgramEntry,entry_start);
 Build::bind(builder,windows_x86_64::ProgramEntry,entry_start);
}
