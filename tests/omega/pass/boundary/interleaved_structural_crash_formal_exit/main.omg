public data Input [copy] {value:i32;}
public data Reader {}
public boundary requirement Reader::read(prefix:i32,source:&Input,suffix:i32)->i32
 crashes Trap !(prefix==11 && source.value>=0 && suffix==19);
data Provider {}
machine Provider::read(prefix:i32,source:&Input,suffix:i32)->i32 satisfies Reader::read {source.value}
machine safe(actual:&Input)->i32 requires actual.value>=0 {Reader::read(11,actual,19)}
data Main {}
machine Main::main(main:&mut Main) crashes Trap {
 let input:Input=Input{value:7};
 let observed:i32=safe(&input);
 transition observed==7 {true->done() _->bad()}
 state done(){} state bad(){crash Trap;}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
