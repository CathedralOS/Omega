// Expected exit: 0. A named map selects the target member of a foreign family.
use omega::language::core::external_binding;

boundary trait ProcessProbe { machine identity() -> u32 reaches; }
data NativeProcess {}


ProcessProvider satisfies ProcessProbe {
    ProcessProbe::identity = NativeProcess::identity;
}

// Table locators use the same exact member join even when not invoked here.
// This tests plan derivation, not permission to dereference arbitrary tables.
data FunctionTable { direct: addr; virtual_call: addr; }
data OtherTable { padding: u64; virtual_call: addr; }
boundary trait TableProbe {
    machine direct(table: &FunctionTable) -> u64 reaches;
    machine virtual_call(table: &OtherTable) -> u64 reaches;
}


TableProvider satisfies TableProbe {
    machine direct(table: &FunctionTable) -> u64 reaches { RawNativeTableProbe::direct(table) }
    machine virtual_call(table: &OtherTable) -> u64 reaches { RawNativeTableProbe::virtual_call(table) }
}

machine main() reaches ProcessProbe crashes Trap {
    let process: u32 = ProcessProbe::identity();
    transition process > 0 {
        true -> accepted()
        _ -> rejected()
    }
    machine accepted() {}
    machine rejected() { crash Trap; }
}

boundary trait RawNativeTableProbe {
    machine direct(table: &FunctionTable) -> u64 reaches;
    machine virtual_call(table: &OtherTable) -> u64 reaches;
}
