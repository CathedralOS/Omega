machine build(builder: &mut Build) {
    Build::application(builder, "static_opaque_qualifier_exit");
    Build::select_provider<OpaqueRead, Supply>(builder, linux_x86_64);
    Build::select_provider<OpaqueRead, Supply>(builder, linux_arm64);
    Build::select_provider<OpaqueRead, Supply>(builder, macos_arm64);
    Build::select_provider<OpaqueRead, Supply>(builder, windows_x86_64);
    Build::select_provider<GenericRead, Supply>(builder, linux_x86_64);
    Build::select_provider<GenericRead, Supply>(builder, linux_arm64);
    Build::select_provider<GenericRead, Supply>(builder, macos_arm64);
    Build::select_provider<GenericRead, Supply>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
