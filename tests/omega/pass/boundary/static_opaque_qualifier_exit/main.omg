// Expected exit: 0. A static boundary qualifier contributes declaration
// identity, not a runtime value or an implicit representation requirement.
public boundary data OpaqueOwner;
public boundary data GenericOwner<T>;

public boundary trait OpaqueRead {
    machine read(value: u64) -> u64
    reaches;
}
public boundary trait GenericRead {
    machine read(value: u64) -> u64
    reaches;
}

data Supply {}
machine Supply::opaque_read(value: u64) -> u64 satisfies OpaqueRead::read { value }
machine Supply::generic_read(value: u64) -> u64 satisfies GenericRead::read { value }

data Input { value: u64; }

machine forwarded(value: u64) -> u64 { GenericRead::read(value) }

machine main() crashes Trap {
    let input: Input = Input { value: 29 };
    let direct: u64 = OpaqueRead::read(input.value);
    let indirect: u64 = forwarded(direct);
    transition direct == 29 && indirect == 29 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
