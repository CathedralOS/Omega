// Runtime admission control: a known but unoffered descriptor operation must
// not fall through to the native worker's null stdin. The native case reads A.
use omega::language::core::external_binding;
public boundary trait Probe {
    machine read(fd: i32, buffer: &mut u64, count: u64) -> i64
    reaches Probe blocks;
}
linux_x86_64 machine read_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5",
    } }
}
linux_arm64 machine arm_read_binding() -> ForeignBinding<9, 4, 10> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "read", version: "GLIBC_2.17",
    } }
}
linux_x86_64 machine read(fd: i32, buffer: &mut u64, count: u64) -> i64
satisfies Probe::read via read_binding();
linux_arm64 machine read(fd: i32, buffer: &mut u64, count: u64) -> i64
satisfies Probe::read via arm_read_binding();
machine entry_start() reaches Probe blocks; crashes Trap {
    let mut value: u64 = 0;
    let count: i64 = block Probe::read(0, &mut value, 1);
    transition count == 1 && value == 65 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
