// A symbolic selector publishes the same requirement in parameters and fields.
// Expected exit: 0.
trait Reader<Context> {
    machine read(context: &Context) -> u64
    ensures result <= 100;
}

data Counter { value: u64; }

CounterReader satisfies Reader<Counter> {
    machine read(context: &Counter) -> u64
    ensures result <= 100
    {
        transition context.value <= 100 {
            true -> (context.value)
            false -> (100)
        }
    }
}

data ReaderSelection<Context> {
    operations: dyn Reader<Context>;
}

machine forward<Context>(context: &Context, operations: dyn Reader<Context>) -> u64 {
    100 - Reader::read(operations, context)
}

machine from_field<Context>(context: &Context, selection: &ReaderSelection<Context>) -> u64 {
    100 - Reader::read(selection.operations, context)
}

machine main() crashes Trap {
    let counter: Counter = Counter { value: 17 };
    let operations: dyn Reader<Counter> = CounterReader as dyn Reader<Counter>;
    let selection: ReaderSelection<Counter> = ReaderSelection { operations: operations };
    let direct: u64 = forward(&counter, operations);
    let field: u64 = from_field(&counter, &selection);
    transition direct == 83 && field == 83 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
