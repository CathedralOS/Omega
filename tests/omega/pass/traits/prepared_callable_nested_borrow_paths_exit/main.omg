// Expected exit: 0. Scoped trait members and prepared nominal members denote
// the same paths, including two independent regions beneath a case payload.
data Pair<First, Second> {
    first: First;
    second: Second;
}
data Outcome<Value> {
    case Empty;
    case Present(value: Value);
}
trait Flipping<First, Second> {
    machine flip(source: Pair<First, Second>) -> Outcome<Pair<Second, First>>;
}
machine flip<'left, 'right>(source: Pair<&'left i32, &'right i32>)
    -> Outcome<Pair<&'right i32, &'left i32>>
satisfies Flipping<&'left i32, &'right i32>::flip {
    Outcome::Present {
        value: Pair { first: source.second, second: source.first },
    }
}

// Byte descriptors keep two independent backing origins beneath the same
// result case. Binding the record before wrapping it must preserve that join.
machine flip_bytes<'left, 'right>(source: Pair<&'left [u8], &'right [u8]>)
    -> Outcome<Pair<&'right [u8], &'left [u8]>>
satisfies Flipping<&'left [u8], &'right [u8]>::flip {
    let swapped: Pair<&'right [u8], &'left [u8]> =
        Pair { first: source.second, second: source.first };
    Outcome::Present { value: swapped }
}

machine check_byte_views() -> bool {
    let left: [u8; 2] = [17, 19];
    let right: [u8; 3] = [41, 43, 47];
    let input: Pair<&[u8], &[u8]> = Pair { first: &left[..], second: &right[..] };
    let result: Outcome<Pair<&[u8], &[u8]>> = flip_bytes(input);
    transition result {
        Outcome::Present { value } -> inspect(value)
        Outcome::Empty -> false
    }
    machine inspect(value: Pair<&[u8], &[u8]>) -> bool {
        transition value.first.len == 3 && value.second.len == 2 {
            true -> (value.first[1] == 43 && value.second[0] == 17)
            false -> false
        }
    }
}

machine main() crashes Trap {
    let left: i32 = 19;
    let right: i32 = 37;
    let input: Pair<&i32, &i32> = Pair { first: &left, second: &right };
    let result: Outcome<Pair<&i32, &i32>> = flip(input);
    transition result {
        Outcome::Present { value } -> inspect(value)
        Outcome::Empty -> bad()
    }
    machine inspect(value: Pair<&i32, &i32>) {
        transition value.first == 37 && value.second == 19 && check_byte_views() {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
