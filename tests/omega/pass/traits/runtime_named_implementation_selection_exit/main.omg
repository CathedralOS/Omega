// Named implementations satisfy traits; data does not. Two implementations
// supply the same `Incrementable<Counter>` requirement over one data type,
// selected directly by name and through a generic evidence binder; a trait
// over two unrelated data types and a data-free bundle use the same model
// ([named conformances](../../../../../wiki/spec/language/conformances.md#data-and-code-are-independent)).
// Counter ends at 1 + 3 = 4, the conversion stores 40, and the bundle adds 30:
// exit 70.
use omega_language_std::console;

trait Incrementable<T> {
    machine increment(counter: &mut T);
}

trait Convert<Source, Target> {
    machine convert(source: &Source, target: &mut Target);
}

trait Seed {
    machine seed() -> i32;
}

data Counter {
    value: i32 in Wrapping;
}

data Gauge {
    reading: i32 in Wrapping;
}

NormalIncrement satisfies Incrementable<Counter> {
    machine increment(counter: &mut Counter) {
        counter.value = counter.value + 1;
    }
}

TripleIncrement satisfies Incrementable<Counter> {
    machine increment(counter: &mut Counter) {
        counter.value = counter.value + 3;
    }
}

CounterReading satisfies Convert<Counter, Gauge> {
    machine convert(source: &Counter, target: &mut Gauge) {
        target.reading = source.value * 10;
    }
}

Thirty satisfies Seed {
    machine seed() -> i32 {
        30
    }
}

machine apply<T, Operations satisfies Incrementable<T>>(counter: &mut T) {
    Operations::increment(counter);
}

machine transfer<Source, Target, Conversion satisfies Convert<Source, Target>>(
    source: &Source,
    target: &mut Target
) {
    Conversion::convert(source, target);
}

data Main {
    counter: Counter;
    gauge: Gauge;
}

machine Main::main(main: &mut Main) reaches Console {
    main.counter.value = 0;
    NormalIncrement::increment(&mut main.counter);
    apply<Counter, TripleIncrement>(&mut main.counter);
    transfer<Counter, Gauge, CounterReading>(&main.counter, &mut main.gauge);
    let seed: i32 = Thirty::seed();
    let total: i32 in Wrapping = main.gauge.reading + (seed as i32 in Wrapping);
    Console::exit_process(total as i32);
}
