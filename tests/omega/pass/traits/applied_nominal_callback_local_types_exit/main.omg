data Item { code: u64; }
data Other { code: u64; }

trait Visitor<Value> {
    machine visit<Context, machine Callback>(value: &Value, context: Context) -> bool
    where machine Callback(value: &Value, context: Context) -> bool;
    ;
}

machine item_matches<Kind>(value: &Item, context: Kind) -> bool { value.code == 42u64 }
machine other_matches<Kind>(value: &Other, context: Kind) -> bool { value.code == 73u64 }

machine item_visit<Kind, machine Callback>(value: &Item, context: Kind) -> bool
where machine Callback(value: &Item, context: Kind) -> bool;
satisfies Visitor<Item>::visit
{ Callback(value, context) }

machine other_visit<Kind, machine Callback>(value: &Other, context: Kind) -> bool
where machine Callback(value: &Other, context: Kind) -> bool;
satisfies Visitor<Other>::visit
{ Callback(value, context) }

machine apply_item<machine Routine>(value: &Item) -> bool
where machine Routine satisfies Visitor<Item>::visit;
{ Routine<u64, item_matches>(value, 3u64) }

machine apply_other<machine Routine>(value: &Other) -> bool
where machine Routine satisfies Visitor<Other>::visit;
{ Routine<bool, other_matches>(value, true) }

machine main() crashes Trap {
    let item: Item = Item { code: 42u64 };
    let other: Other = Other { code: 73u64 };
    let first: bool = apply_item<item_visit>(&item);
    let second: bool = apply_other<other_visit>(&other);
    transition first && second {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
