// Expected exit 70. Complete (width, depth) tuples govern both the case
// and its packet fields; rebinding selects another complete implementation.
use omega_language_std::console;
data Packet { width: u32; depth: u32; provider: u32; }
data Choice { case Narrow(packet: Packet); case Wide(packet: Packet); }
data Item { marker: u32; }
trait Shape<T> {
    machine code<Width: u32, Depth: u32>(subject: &T) -> Choice
    where (Width == 32 && Depth == 8) || (Width == 16 && Depth == 4);
}
machine Item::code<Width: u32, Depth: u32>(item: &Item) -> Choice satisfies Shape<Item>::code {
    transition Width == 16 {
        true -> Choice::Narrow { packet: Packet { width: Width, depth: Depth, provider: item.marker } }
        false -> Choice::Wide { packet: Packet { width: Width, depth: Depth, provider: item.marker } }
    }
}
machine Item::other<Width: u32, Depth: u32>(item: &Item) -> Choice satisfies Shape<Item>::code {
    transition Width == 16 {
        true -> Choice::Narrow { packet: Packet { width: Width, depth: Depth, provider: 202 } }
        false -> Choice::Wide { packet: Packet { width: Width, depth: Depth, provider: 202 } }
    }
}
Primary satisfies Shape<Item> { Shape::code = Item::code; }
Other satisfies Shape<Item> { Shape::code = Item::other; }
machine scan(selected: dyn Shape<Item>, item: &Item, width: u32, depth: u32) -> Choice
requires (width == 16 && depth == 4) || (width == 32 && depth == 8);
{ Shape::code<width, depth>(selected, item) }
machine valid(choice: Choice, width: u32, depth: u32, provider: u32) -> bool {
    transition choice {
        Choice::Narrow { packet } -> (width == 16 && packet.width == width && packet.depth == depth && packet.provider == provider)
        Choice::Wide { packet } -> (width == 32 && packet.width == width && packet.depth == depth && packet.provider == provider)
    }
}
data Main { item: Item; }
machine Main::main(main: &mut Main) reaches Console {
    main.item.marker = 101;
    let mut selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let first: Choice = scan(selected, &main.item, 16, 4);
    selected = Other as dyn Shape<Item>;
    let second: Choice = scan(selected, &main.item, 32, 8);
    let third: Choice = scan(selected, &main.item, 16, 4);
    transition valid(first, 16, 4, 101) && valid(second, 32, 8, 202) && valid(third, 16, 4, 202) {
        true -> good(main) false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
