data Item { code: u64; }
proposition valid<Type, Tag>(value: &Type);

trait Visitor<Value, Tag> {
    machine visit<machine Callback>(value: &Value) -> bool
    where machine Callback(value: &Value) -> bool requires valid<Value, Tag>(value);
    ;
}

machine visit<machine Callback>(value: &Item) -> bool
where machine Callback(value: &Item) -> bool requires valid<Item, u64>(value);
satisfies Visitor<Item, u64>::visit
{ true }

machine main() {}
