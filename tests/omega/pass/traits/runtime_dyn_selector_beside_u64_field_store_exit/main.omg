// A runtime-selected visitor stores a u64 count through a borrowed record.
// A `dyn` selector is u64 storage too, so the captured field destination must
// resolve to the checked u64 declaration rather than to an equal-shaped row.
// Bump counts two visits; Skip leaves the count alone; exit 70 needs both.
use omega_language_std::console;

data Tally { count: u64; limit: u64; }

trait Visit<Output> {
    machine visit(output: &mut Output) -> bool;
}

machine bump(output: &mut Tally) -> bool {
    transition output.count < output.limit {
        true -> store(output)
        false -> false
    }
    state store(output: &mut Tally) -> bool
    requires output.count < output.limit {
        output.count = output.count + 1;
        true
    }
}

Bump satisfies Visit<Tally> {
    machine visit(output: &mut Tally) -> bool { bump(output) }
}

Skip satisfies Visit<Tally> {
    machine visit(output: &mut Tally) -> bool { false }
}

machine twice(visitor: dyn Visit<Tally>, output: &mut Tally) -> u64 {
    let first: bool = Visit::visit(visitor, output);
    let second: bool = Visit::visit(visitor, output);
    transition first == second {
        true -> output.count
        false -> 0
    }
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let mut tally: Tally = Tally { count: 0, limit: 5 };
    let mut selected: dyn Visit<Tally> = Bump as dyn Visit<Tally>;
    let bumped: u64 = twice(selected, &mut tally);
    selected = Skip as dyn Visit<Tally>;
    let skipped: u64 = twice(selected, &mut tally);
    transition bumped == 2 && skipped == 2 && tally.count == 2 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
