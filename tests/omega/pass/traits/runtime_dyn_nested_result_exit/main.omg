// Nested dynamic results exercise the ordinary hidden-buffer return ABI.
data Payload { first: u64; second: u64; third: u64; fourth: u64; }
data Envelope { payload: Payload; marker: u64; }
trait Produce { machine make(value: u64) -> Payload; }
Forward satisfies Produce {
    machine make(value: u64) -> Payload {
        Payload { first: value, second: 2, third: 3, fourth: 4 }
    }
}
Reverse satisfies Produce {
    machine make(value: u64) -> Payload {
        Payload { first: 4, second: 3, third: 2, fourth: value }
    }
}
machine wrap(selected: dyn Produce, value: u64) -> Envelope {
    Envelope { payload: Produce::make(selected, value), marker: 19 }
}
machine relay(envelope: Envelope) -> Envelope { envelope }
// The enclosing machine result does not change the selected call contract.
machine observe_first(selected: dyn Produce, value: u64) -> u64 {
    let payload: Payload = Produce::make(selected, value);
    payload.first
}
machine main() crashes Trap {
    let mut selected: dyn Produce = Forward as dyn Produce;
    let first: Envelope = relay(wrap(selected, 11));
    selected = Reverse as dyn Produce;
    let second: Envelope = relay(wrap(selected, 17));
    let observed: u64 = observe_first(Forward as dyn Produce, 29);
    transition first.payload.first == 11 && first.payload.second == 2
        && first.payload.third == 3 && first.payload.fourth == 4 && first.marker == 19
        && second.payload.first == 4 && second.payload.second == 3
        && second.payload.third == 2 && second.payload.fourth == 17 && second.marker == 19
        && observed == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
