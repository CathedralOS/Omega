// Expected exit: 0. A default row captures its map's region without replacing
// its fresh invocation telescope, including the unused invocation binder.
trait Reading<Context> {
    machine read<'item, 'unused>(context: Context, item: &'item i32) -> i32 {
        item as i32
    }
}
Reader<'storage> satisfies Reading<&'storage i32> {}

machine invoke<'captured, 'invocation,
    Selected satisfies Reading<&'captured i32>>(
    context: &'captured i32, item: &'invocation i32
) -> i32 { Selected::read(context, item) }
machine observed<'environment, 'call>(
    context: &'environment i32, item: &'call i32
) -> i32 { invoke<Reader<'environment>>(context, item) }

data Main { context: i32; item: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.context = 19;
    main.item = 37;
    let result: i32 = observed(&main.context, &main.item);
    transition result == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
