use omega_language_std::console;
use omega::language::core::binding;

// Byte predicates remain on record fields through a borrowed crash-contract call.
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);

trait Equatable {
    machine equals(subject: &Self, rhs: &Self) -> bool;
}
data Message { active: bool; text: [u8; 8] in Utf8; }
MessageEquatable: Message satisfies Equatable;

data Main { console: Binding<Console>; left: Message; right: Message; }
machine Main::inspect(main: &Main)
crashes Abort
    main.left == main.right
{}

machine Main::main(main: &mut Main) reaches Console
crashes Abort
{
    Main::inspect(main);
    main.console.exit_process(70);
}
