// Expected exit: 0. The member's fresh 'scope is distinct from the map's
// same-spelled captured 'scope; the body's binders may have independent names.
trait Reading<View> {
    machine read<'scope>(context: View, item: &'scope i32) -> i32;
}
Reader<'scope> satisfies Reading<&'scope i32> { Reading::read = read; }
machine read<'context, 'item>(context: &'context i32, item: &'item i32) -> i32 {
    item as i32
}
machine invoke<'captured, 'invocation,
    Selected satisfies Reading<&'captured i32>>(
    context: &'captured i32, item: &'invocation i32
) -> i32 { Selected::read(context, item) }
machine observed<'environment, 'call>(
    context: &'environment i32, item: &'call i32
) -> i32 { invoke<Reader<'environment>>(context, item) }

// A valid uncalled borrowed-result map must retain the same input region.
trait Borrowing<Input, Output> { machine borrow(value: Input) -> Output; }
Same<'mapping> satisfies Borrowing<&'mapping i32, &'mapping i32> {
    Borrowing::borrow = borrow;
}
machine borrow<'source>(value: &'source i32) -> &'source i32 { value }

// Exact requirement edges use the same result-source judgment as named maps.
machine exact_borrow<'source>(value: &'source i32) -> &'source i32
satisfies Borrowing<&'source i32, &'source i32>::borrow { value }

data Main { context: i32; item: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.context = 19;
    main.item = 37;
    let result: i32 = observed(&main.context, &main.item);
    transition result == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
