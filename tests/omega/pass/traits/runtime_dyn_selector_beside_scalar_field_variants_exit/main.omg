// Scalar field stores beside a runtime `dyn` selector, which is u64 storage
// too: an ordinary machine body, a local record copied out, and a nested
// field, with u64, u32 and bool leaves. Each store must name its own checked
// declaration. Exit 70 only when every write is observed.
use omega_language_std::console;

data Inner { mark: u32; seen: bool; }
data Tally { count: u64; limit: u64; inner: Inner; }

trait Visit<Output> {
    machine visit(output: &mut Output) -> bool;
}

Direct satisfies Visit<Tally> {
    machine visit(output: &mut Tally) -> bool {
        output.count = output.limit;
        output.inner.mark = 9;
        output.inner.seen = true;
        true
    }
}

Copied satisfies Visit<Tally> {
    machine visit(output: &mut Tally) -> bool {
        let mut local: Tally = Tally { count: 0, limit: 0, inner: Inner { mark: 0, seen: false } };
        local.count = 4;
        local.inner.mark = 5;
        output.count = local.count;
        output.inner.mark = local.inner.mark;
        output.inner.seen = false;
        true
    }
}

machine apply(visitor: dyn Visit<Tally>, output: &mut Tally) -> bool {
    Visit::visit(visitor, output)
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let mut tally: Tally = Tally { count: 0, limit: 3, inner: Inner { mark: 0, seen: false } };
    let mut selected: dyn Visit<Tally> = Direct as dyn Visit<Tally>;
    let direct: bool = apply(selected, &mut tally);
    let direct_ok: bool = tally.count == 3 && tally.inner.mark == 9 && tally.inner.seen;
    selected = Copied as dyn Visit<Tally>;
    let copied: bool = apply(selected, &mut tally);
    transition direct && copied && direct_ok && tally.count == 4 && tally.inner.mark == 5
        && !tally.inner.seen {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
