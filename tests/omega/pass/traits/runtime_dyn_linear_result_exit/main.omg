// A dynamic return transports the input's exact nested linear claim.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
domain Token::Issued;
data Packet { token: Token in Token::Issued; marker: u64; }
machine issue(value: u64) -> Token in Token::Issued {
    let token: Token in Token::Issued = Token { value: value };
    token
}
trait Routing { machine route(prefix: u64, packet: Packet) -> Packet; }
First satisfies Routing {
    machine route(prefix: u64, packet: Packet) -> Packet {
        Packet { token: packet.token, marker: prefix }
    }
}
Second satisfies Routing {
    machine route(prefix: u64, packet: Packet) -> Packet {
        Packet { token: packet.token, marker: 23 }
    }
}
machine relay(selected: dyn Routing, packet: Packet) -> Packet {
    Routing::route(selected, 19, packet)
}
machine main() crashes Trap {
    let first: Packet = relay(First as dyn Routing,
        Packet { token: issue(11), marker: 0 });
    let second: Packet = relay(Second as dyn Routing,
        Routing::route(First as dyn Routing, 7,
            Packet { token: issue(17), marker: 0 }));
    let correct: bool = first.token.value == 11 && first.marker == 19
        && second.token.value == 17 && second.marker == 23;
    drop(first.token);
    drop(second.token);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
