// Expected exit: 0
// A default's own applied requirement retains the selected map's full telescope.
trait Stage<const Phase: u64> {
    machine value() -> u64;
    machine read() -> u64 { Stage<Phase>::value() }
}

Selected<const Phase: u64, const Answer: u64> satisfies Stage<Phase> {
    machine value() -> u64 { Answer }
}

machine main() crashes Trap {
    let first: u64 = Selected<1u64, 73u64>::read();
    let second: u64 = Selected<1u64, 91u64>::read();
    transition first == 73 && second == 91 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
