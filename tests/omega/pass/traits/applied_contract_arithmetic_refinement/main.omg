const Upper: u32 = 100;
trait Threshold<const Limit: u32> {
    machine limit(value: u32) -> u32
    requires value <= Limit
    ensures result <= Limit;
}
machine cap(argument: u32) -> u32
requires argument <= 200
ensures result <= 90
{
    transition argument <= 90 {
        true -> (argument)
        _ -> 90
    }
}
Conservative satisfies Threshold<Upper> { Threshold::limit = cap; }
trait Inherited: Threshold<Upper> {}
InheritedConservative satisfies Inherited { Threshold::limit = cap; }
machine selected<Implementation satisfies Inherited>(value: u32) -> u32
requires value <= 100
ensures result <= 100
{
    Implementation::limit(value)
}
machine main() crashes Trap {
    let result: u32 = selected<InheritedConservative>(100);
    transition result == 90 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
