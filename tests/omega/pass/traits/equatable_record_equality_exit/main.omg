// Equatable synthesis (frozen decisions 8 + 11): `Point satisfies
// Equatable;` synthesizes structural equality for the record, so `==`/`!=`
// on Point values is legal and compares field by field. Equal points must
// match; a single differing middle field must miss (a compare that only
// reads a prefix of the fields, or compares storage width, takes the wrong
// arm). The conformance also emits a callable Point::equals wrapper over the
// same structural expansion. Exits 70 only when operator and callable faces
// all agree.

use omega_language_std::console;
use omega::language::core::binding;

trait Equatable {
    machine equals(subject: &Self, rhs: &Self) -> bool;
}

data Point {
    x: i32;
    y: i32;
    z: i32;
}

PointEquatable: Point satisfies Equatable;

data OverridePoint {
    value: i32;
}

OverridePointEquatable: OverridePoint satisfies Equatable;

machine OverridePoint::equals(point: &OverridePoint, rhs: &OverridePoint) -> bool {
    false
}

data Main {
    console: Binding<Console>;
    a: Point;
    b: Point;
    c: Point;
    overridden_a: OverridePoint;
    overridden_b: OverridePoint;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = Point { x: 3, y: 7, z: 11 };
    main.b = Point { x: 3, y: 7, z: 11 };
    main.c = Point { x: 3, y: 9, z: 11 };

    let same: bool = main.a == main.b;

    transition same {
        true -> check_callable(main)
        _ -> missed(main)
    }

    state check_callable(main: &mut Main) {
        let callable: bool = Point::equals(&main.a, &main.b);

        transition callable {
            true -> check_callable_unequal(main)
            _ -> missed(main)
        }
    }

    state check_callable_unequal(main: &mut Main) {
        let callable: bool = Point::equals(&main.a, &main.c);

        transition callable {
            false -> check_unequal(main)
            _ -> missed(main)
        }
    }

    state check_unequal(main: &mut Main) {
        let different: bool = main.a != main.c;

        transition different {
            true -> check_written_override(main)
            _ -> missed(main)
        }
    }

    state check_written_override(main: &mut Main) {
        main.overridden_a.value = 1;
        main.overridden_b.value = 1;
        let written_result: bool = main.overridden_a == main.overridden_b;

        transition written_result {
            false -> matched(main)
            _ -> missed(main)
        }
    }

    state matched(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}
