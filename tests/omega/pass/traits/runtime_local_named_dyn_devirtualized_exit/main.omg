use omega_language_std::console;
use omega::language::core::binding;

trait Shape {
    machine code(shape: &Self) -> i32;
}

data Item [copy] {
    value: i32;
}

// Deliberate look-alike: the selected conformance row below, not this ambient
// attached machine, owns dynamic dispatch.
machine Item::code(item: &Item) -> i32 {
    transition {
        _ -> 4
    }
}

Primary: Item satisfies Shape {
    machine code(item: &Item) -> i32 {
        transition {
            _ -> item.value
        }
    }
}

data Main {
    console: Binding<Console>;
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    let erased: &dyn Shape = &main.item as &dyn Item::Primary;
    let result: i32 = erased.code();
    transition result == 0 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
