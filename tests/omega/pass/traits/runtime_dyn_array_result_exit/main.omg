// Fixed arrays retain their own layout through the shared indirect return ABI.
trait Batch { machine make(value: u64) -> [u64; 3]; }
Forward satisfies Batch { machine make(value: u64) -> [u64; 3] { [value, 2, 3] } }
Reverse satisfies Batch { machine make(value: u64) -> [u64; 3] { [3, 2, value] } }
machine produce(selected: dyn Batch, value: u64) -> [u64; 3] {
    Batch::make(selected, value)
}
machine main() crashes Trap {
    let first: [u64; 3] = produce(Forward as dyn Batch, 11);
    let second: [u64; 3] = produce(Reverse as dyn Batch, 17);
    transition first[0] == 11 && first[1] == 2 && first[2] == 3
        && second[0] == 3 && second[1] == 2 && second[2] == 17 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
