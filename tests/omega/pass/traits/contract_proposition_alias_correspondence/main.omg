use predicates;

proposition reversed(left: u32, right: u32) = predicates::valid(right, left);
proposition restored(left: u32, right: u32) = reversed(right, left);

trait Accept {
    machine accept(left: u32, right: u32) -> u32
    requires restored(left, right);
}

Selected satisfies Accept {
    machine accept(first: u32, second: u32) -> u32
    requires predicates::valid(first, second)
    { first }
}

machine main() {}
