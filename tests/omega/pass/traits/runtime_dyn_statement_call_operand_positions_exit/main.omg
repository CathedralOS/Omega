// A statement-position dyn call binds each data operand after the selector to its own formal.
// Expected exit: 0
trait PairCheck {
    machine check(value: u64, other: u64) requires value == 100u64 && other == 7u64 crashes Trap;
}
InlinePair satisfies PairCheck {
    machine check(value: u64, other: u64) requires value == 100u64 && other == 7u64 crashes Trap {
        let difference: u64 = value - other;
        transition difference == 93u64 { true -> done() _ -> bad() }
        machine done() {}
        machine bad() crashes Trap { crash Trap; }
    }
}
machine main() crashes Trap {
    let selected: dyn PairCheck = InlinePair as dyn PairCheck;
    PairCheck::check(selected, 100u64, 7u64);
}
