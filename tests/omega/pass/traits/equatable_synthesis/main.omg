// The sealed `==` route selects the one implementation whose trait
// argument is the operand type; the implementation, not the data type,
// owns the `equals` row. An EMPTY `satisfies Equatable<T> { }` receives
// a synthesized structural row (field-by-field); an authored member or
// a row filled by an ordinary machine reference overrides it; a
// generic evidence binder `Equality satisfies Equatable<T>` selects
// the same rows.
trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}
data Coin {
    value: i32;
    year: i32;
}
CoinEquality satisfies Equatable<Coin> { }
machine equal<T, Equality satisfies Equatable<T>>(left: &T, right: &T) -> bool {
    Equality::equals(left, right)
}
data Mark {
    x: i32;
    y: i32;
}
machine marks_share_x(left: &Mark, right: &Mark) -> bool {
    left.x == right.x
}
MarkByX satisfies Equatable<Mark> {
    machine equals(left: &Mark, right: &Mark) -> bool { marks_share_x(left, right) }
}
data Main {
    a: Coin;
    b: Coin;
    left: Mark;
    right: Mark;
}
machine Main::main(main: &mut Main) {
    main.a = Coin { value: 5, year: 1990 };
    main.b = Coin { value: 5, year: 1991 };
    main.left = Mark { x: 3, y: 7 };
    main.right = Mark { x: 3, y: 8 };
    let same_value: bool = main.a == main.a;
    let structural_miss: bool = main.a != main.b;
    let by_binder: bool = equal<Coin, CoinEquality>(&main.a, &main.b);
    let by_machine_row: bool = main.left == main.right;
}
