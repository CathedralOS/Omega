// Expected native exit: 0. Expected interpreted exit: 0.
use omega::language::core::float_operations;

trait Reflexive<Value> {
    machine same(value: Value)
    ensures value == value;
}

machine reflexive32(value: f32)
satisfies Reflexive<f32>::same
ensures value == value
{}

machine reflexive64(value: f64)
satisfies Reflexive<f64>::same
ensures value == value
{}

machine runtime_same32(value: f32) -> bool { value == value }
machine runtime_same64(value: f64) -> bool { value == value }

machine main() crashes Trap {
    let unordered32: f32 = F32::square_root(-1.0f32);
    let unordered64: f64 = F64::square_root(-1.0f64);
    reflexive32(unordered32);
    reflexive64(unordered64);
    transition !runtime_same32(unordered32) && !runtime_same64(unordered64)
        && runtime_same32(1.0f32) && runtime_same64(1.0f64) {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
