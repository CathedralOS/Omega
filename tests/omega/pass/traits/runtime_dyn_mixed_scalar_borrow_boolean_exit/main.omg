// The selector stays separate from a scalar and a borrowed record. Forwarding
// preserves that mixed ABI, and the selected requirement returns a Boolean.
use omega_language_std::console;

trait Matching<T> {
    machine matches(expected: i32, actual: &T) -> bool;
}

data Amount {
    value: i32 in Wrapping;
}

Exact satisfies Matching<Amount> {
    machine matches(expected: i32, actual: &Amount) -> bool {
        transition { _ -> (expected == actual.value) }
    }
}

data Main {
    amount: Amount;
}

machine Main::main(main: &mut Main) reaches Console {
    main.amount.value = 37;
    let selected: dyn Matching<Amount> = Exact as dyn Matching<Amount>;
    let equal: bool = dispatch(selected, 37, &main.amount);
    let different: bool = dispatch(selected, 38, &main.amount);
    transition equal && !different {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine dispatch(selected: dyn Matching<Amount>, expected: i32, actual: &Amount) -> bool {
    let result: bool = Matching::matches(selected, expected, actual);
    transition { _ -> result }
}
