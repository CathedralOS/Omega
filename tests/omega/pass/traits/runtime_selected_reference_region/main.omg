// Expected exit: 0.
// Scalar formals and selector rebinding cannot change the borrowed input lane.
data Pair { low: i32; high: i32; }
trait Read {
    machine first(padding: i32, pair: &Pair) -> &i32;
}
Low satisfies Read {
    machine first(padding: i32, pair: &Pair) -> &i32 { &pair.low }
}
High satisfies Read {
    machine first(padding: i32, pair: &Pair) -> &i32 { &pair.high }
}
machine read(selected: dyn Read, pair: &Pair) -> &i32 {
    Read::first(selected, 19, pair)
}
machine main() crashes Trap {
    let pair: Pair = Pair { low: 3, high: 7 };
    let mut selected: dyn Read = Low as dyn Read;
    let low: &i32 = read(selected, &pair);
    selected = High as dyn Read;
    let high: &i32 = Read::first(selected, 23, &pair);
    transition low == 3 && high == 7 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
