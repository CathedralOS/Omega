// A generic body may call only the statically known trait surface promised by
// its nominal bound. Specialization selects Counter's authored conformance and
// lowers subject.increment() to Counter::increment; there is no runtime trait
// dictionary. Expected exit: 1.
use omega_language_std::console;

trait Incrementable {
    machine increment(&mut self);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(&mut self) satisfies Incrementable::increment {
    self.value = self.value + 1;
}
CounterIncrementable: Counter satisfies Incrementable;

machine step<T>(subject: &mut T)
where
    T satisfies Incrementable
{
    subject.increment();
}

data Main { console: Console; counter: Counter; }

machine Main::main(&mut self) {
    step(&mut self.counter);
    self.console.exit_process(self.counter.value as i32);
}
