trait Bounded {
    machine take<const Limit: u32>(value: u32) -> u32
    requires value <= Limit;
}
machine identity<const Maximum: u32>(input: u32) -> u32
satisfies Bounded::take
requires input <= Maximum
{ input }
Selected satisfies Bounded { machine take<const Limit: u32>(value: u32) -> u32 requires value <= Limit { identity<Limit>(value) } }
machine main() {}
