// A selector chooses code at runtime; the requirement owns the result shape.
data Pair { first: u64; second: u64; }
trait Factory {
    machine make(value: u64) -> Pair;
}
LeftFactory satisfies Factory {
    machine make(value: u64) -> Pair { Pair { first: value, second: 1 } }
}
RightFactory satisfies Factory {
    machine make(value: u64) -> Pair { Pair { first: 2, second: value } }
}
machine choose(left: bool) -> dyn Factory {
    transition left {
        true -> (LeftFactory as dyn Factory)
        false -> (RightFactory as dyn Factory)
    }
}
machine produce(factory: dyn Factory, value: u64) -> Pair {
    Factory::make(factory, value)
}
machine main() crashes Trap {
    let first: Pair = produce(choose(true), 9);
    let second: Pair = produce(choose(false), 7);
    transition first.first == 9 && first.second == 1
        && second.first == 2 && second.second == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
