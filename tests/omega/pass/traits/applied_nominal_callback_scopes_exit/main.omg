data Item { code: u64; }
data Other { code: u64; }

trait Visitor<Value> {
    machine visit<machine Callback>(value: &Value) -> bool
    where machine Callback(value: &Value) -> bool;
    ;
}

machine item_matches(value: &Item) -> bool { value.code == 42u64 }
machine other_matches(value: &Other) -> bool { value.code == 73u64 }

machine item_visit<machine Callback>(value: &Item) -> bool
where machine Callback(value: &Item) -> bool;
satisfies Visitor<Item>::visit
{ Callback(value) }

machine other_visit<machine Callback>(value: &Other) -> bool
where machine Callback(value: &Other) -> bool;
satisfies Visitor<Other>::visit
{ Callback(value) }

machine apply_item<machine Routine>(value: &Item) -> bool
where machine Routine satisfies Visitor<Item>::visit;
{ Routine<item_matches>(value) }

machine apply_other<machine Routine>(value: &Other) -> bool
where machine Routine satisfies Visitor<Other>::visit;
{ Routine<other_matches>(value) }

machine main() crashes Trap {
    let item: Item = Item { code: 42u64 };
    let other: Other = Other { code: 73u64 };
    let first: bool = apply_item<item_visit>(&item);
    let second: bool = apply_other<other_visit>(&other);
    transition first && second {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
