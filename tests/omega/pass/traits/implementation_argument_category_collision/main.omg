// Data and code may share a spelling. Each trait slot selects its declared
// category, and generic forwarding retains the selected implementation map.
trait Marker { }
data Choice { value: u32; }
Choice satisfies Marker { }

trait Uses<Value, Policy satisfies Marker> { }
trait Concrete: Uses<Choice, Choice> { }
trait Forward<Value, Policy satisfies Marker>: Uses<Value, Policy> { }
ConcreteImplementation satisfies Concrete { }
ForwardImplementation satisfies Forward<Choice, Choice> { }

data Main { }
machine Main::main(main: &mut Main) { }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
