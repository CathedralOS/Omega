// Multi-conformance `dyn Trait` dispatch via call-site monomorphization. The
// call `Shape::code(s)` retains one exact row candidate per complete conformance,
// and each call site's receiver type picks the conformance:
// dispatch(&mut self.c) runs Circle::code() == 9, dispatch(&mut self.q) runs
// Square::code() == 4, so n == 9 * 10 + 4 == 94 -> exit 70. (Pre-fix the dyn
// call resolved to nothing and both calls returned 0.) Mirrors the interpreter
// coverage test dyn_two_impl_dispatch_selects_impl_by_runtime_type.
use omega_language_std::console;
use omega::language::core::binding;

trait Shape {
    machine code(subject: &mut Self) -> i32;
}

data Circle {}

machine Circle::code(circle: &mut Circle) -> i32 {
    transition {
        _ -> 9
    }
}

data Square {}

machine Square::code(square: &mut Square) -> i32 {
    transition {
        _ -> 4
    }
}

CircleShape: Circle satisfies Shape {
    Shape::code = Circle::code;
}
SquareShape: Square satisfies Shape {
    Shape::code = Square::code;
}

data Main {
    console: Binding<Console>;
    c: Circle;
    q: Square;
}

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = Main::dispatch(&mut main.c);
    let b: i32 = Main::dispatch(&mut main.q);
    let n: i32 in Wrapping = (a as i32 in Wrapping) * 10 + (b as i32 in Wrapping);
    transition n == 94 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}

machine Main::dispatch(s: &mut dyn Shape) -> i32 {
    Shape::code(s)
}
