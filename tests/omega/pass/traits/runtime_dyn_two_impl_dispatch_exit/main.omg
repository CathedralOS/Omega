// One helper calls the machine value it receives with the explicit item.
// Two selections must remain distinct: 9 * 10 + 4 == 94 -> exit 70.
// The parameter name also checks that a local callable takes priority over
// the builtin named `abs`. A fixed target or builtin call takes exit 71.
use omega_language_std::Console;

trait Shape<T> {
    machine code(subject: &mut T) -> i32;
}

data Item {
    sides: i32;
}

CircleShape satisfies Shape<Item> {
    machine code(subject: &mut Item) -> i32 {
        transition {
            _ -> 9
        }
    }
}

SquareShape satisfies Shape<Item> {
    machine code(subject: &mut Item) -> i32 {
        transition {
            _ -> subject.sides
        }
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.item.sides = 4;
    let a: i32 = Main::dispatch(CircleShape::code, &mut main.item);
    let b: i32 = Main::dispatch(SquareShape::code, &mut main.item);
    let n: i32 in Wrapping = (a as i32 in Wrapping) * 10 + (b as i32 in Wrapping);
    transition n == 94 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine Main::dispatch(abs: machine(subject: &mut Item) -> i32 reaches none crashes none, item: &mut Item) -> i32 {
    abs(item)
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
