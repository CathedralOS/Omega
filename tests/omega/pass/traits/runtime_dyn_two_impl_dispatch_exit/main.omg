// Runtime implementation selection: one helper dispatches through a selector
// it receives as an ordinary parameter, and two call sites pass different
// named implementations of `Shape<Item>` with the same explicitly passed
// data. The selector names an implementation; it carries no data
// ([dynamic dispatch](../../../../../wiki/spec/terminal-psi/dynamic_dispatch.md)).
// CircleShape reports 9 and SquareShape reads the item's 4 sides:
// 9 * 10 + 4 == 94 -> exit 70.
use omega_language_std::console;

trait Shape<T> {
    machine code(subject: &mut T) -> i32;
}

data Item {
    sides: i32;
}

CircleShape satisfies Shape<Item> {
    machine code(subject: &mut Item) -> i32 {
        transition {
            _ -> 9
        }
    }
}

SquareShape satisfies Shape<Item> {
    machine code(subject: &mut Item) -> i32 {
        transition {
            _ -> subject.sides
        }
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.item.sides = 4;
    let a: i32 = Main::dispatch(CircleShape as dyn Shape<Item>, &mut main.item);
    let b: i32 = Main::dispatch(SquareShape as dyn Shape<Item>, &mut main.item);
    let n: i32 in Wrapping = (a as i32 in Wrapping) * 10 + (b as i32 in Wrapping);
    transition n == 94 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine Main::dispatch(shape: dyn Shape<Item>, item: &mut Item) -> i32 {
    Shape::code(shape, item)
}
