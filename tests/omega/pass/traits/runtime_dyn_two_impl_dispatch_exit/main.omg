// Multi-conformance `dyn Trait` dispatch via call-site monomorphization. The
// call `s.code()` retains one exact row candidate per complete conformance,
// and each call site's receiver type picks the conformance:
// dispatch(&mut self.c) runs Circle::code() == 9, dispatch(&mut self.q) runs
// Square::code() == 4, so n == 9 * 10 + 4 == 94 -> exit 70. (Pre-fix the dyn
// call resolved to nothing and both calls returned 0.) Mirrors the interpreter
// coverage test dyn_two_impl_dispatch_selects_impl_by_runtime_type.
use omega_language_std::console;

trait Shape {
    machine code(&mut self) -> i32;
}

data Circle {}

machine Circle::code(&mut self) -> i32 {
    transition {
        _ -> 9
    }
}

data Square {}

machine Square::code(&mut self) -> i32 {
    transition {
        _ -> 4
    }
}

CircleShape: Circle satisfies Shape {
    Shape::code = Circle::code;
}
SquareShape: Square satisfies Shape {
    Shape::code = Square::code;
}

data Main {
    console: Console;
    c: Circle;
    q: Square;
}

machine Main::main(&mut self) {
    let a: i32 in Wrapping = self.dispatch(&mut self.c);
    let b: i32 in Wrapping = self.dispatch(&mut self.q);
    let n: i32 in Wrapping = a * 10 + b;
    transition n == 94 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::dispatch(&mut self, s: &mut dyn Shape) -> i32 {
    s.code()
}
