// Expected exit: 0. Captured phantom type arguments and fresh member regions
// retain separate owners even when both binders are spelled 'same.
data Marker<'held> {}
data Wrapper<Value> { value: Value; }
trait Reading<Value> {
    machine read<'same>(value: Value, item: &'same i32) -> i32 {
        let retained: Wrapper<Value> = Wrapper { value: value };
        let recovered: Value = retained.value;
        item as i32
    }
}
Mapped<'same> satisfies Reading<Marker<'same>> {}

machine invoke<'captured, 'invocation, Selected satisfies Reading<Marker<'captured>>>(
    marker: Marker<'captured>, item: &'invocation i32
) -> i32 { Selected::read(marker, item) }
machine observed<'storage, 'call>(item: &'call i32, marker: Marker<'storage>) -> i32 {
    invoke<Mapped<'storage>>(marker, item)
}
data Main { item: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.item = 37;
    let marker: Marker = Marker {};
    let result: i32 = observed(&main.item, marker);
    transition result == 37 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
