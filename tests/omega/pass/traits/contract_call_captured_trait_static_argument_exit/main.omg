// Expected exit: 0. Exact trait captures retain their static value at the inherited call requirement.
machine below<const Limit: u32>(value: u32) -> bool { value <= Limit }
trait Bounded<const Maximum: u32> {
    machine take(value: u32) -> u32
    requires below<Maximum>(value);
}
machine identity<const Limit: u32>(input: u32) -> u32
satisfies Bounded<Limit>::take
requires below<Limit>(input)
{ input }
machine main() { let result: u32 = identity<2u32>(1u32); }
