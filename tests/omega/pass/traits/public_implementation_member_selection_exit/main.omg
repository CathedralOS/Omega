// Expected exit: 0
// A consumer selects public implementation members without naming their private helpers.
use support::main;
machine invoke<machine Reader>(value: u64) -> u64
requires machine Reader satisfies Reading<1u64>::read;
{ Reader(value) }
machine invoke_prefix<machine Reader>(value: u64) -> u64
requires machine Reader(value: u64) -> u64;
{ Reader(value) }
machine main() crashes Trap {
    let direct: u64 = Plain::read(10u64);
    let callback: u64 = invoke<Plain::read>(20u64);
    let applied: u64 = Selected<2u64>::read(30u64);
    let prefixed: u64 = Prefixed::read<4u64>(50u64);
    let prefixed_callback: u64 = invoke_prefix<Prefixed::read<8u64> >(60u64);
    transition direct == 11u64 && callback == 21u64 && applied == 28u64 && prefixed == 54u64 && prefixed_callback == 52u64 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
