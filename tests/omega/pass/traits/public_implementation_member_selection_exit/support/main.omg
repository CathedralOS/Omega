public trait Reading<const Tag: u64> {
    machine read(value: u64) -> u64;
}
machine private_helper(value: u64) -> u64 { value ^ 1u64 }
public Plain satisfies Reading<1u64> {
    machine read(value: u64) -> u64 {
        nested(value)
        machine nested(value: u64) -> u64 { private_helper(value) }
    }
}
public Selected<const Tag: u64> satisfies Reading<Tag> {
    machine read(value: u64) -> u64 { value ^ Tag }
}
public trait Prefix {
    machine read<const Tag: u64>(value: u64) -> u64;
}
public Prefixed satisfies Prefix {
    machine read<const Tag: u64>(value: u64) -> u64 { value ^ Tag }
}
Hidden satisfies Reading<1u64> {
    machine read(value: u64) -> u64 { private_helper(value) }
}
