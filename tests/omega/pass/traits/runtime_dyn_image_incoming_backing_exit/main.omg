// Expected exit: 0
// A copied argument retains incoming real backing when another dynamic implementation supplies an immutable image.
data Backing { bytes: [u8; 4]; }
data View<'storage> [copy] { bytes: &'storage [u8]; }
trait Updating {
    machine update<'storage>(slot: &mut View<'storage>) -> bool;
}
Keep satisfies Updating {
    machine update<'storage>(slot: &mut View<'storage>) -> bool { true }
}
Image satisfies Updating {
    machine update<'storage>(slot: &mut View<'storage>) -> bool {
        slot.bytes = "image";
        true
    }
}
machine replace<'storage>(slot: &mut View<'storage>) -> bool {
    slot.bytes = "after";
    true
}
machine choose<'storage>(view: View<'storage>, changed: bool) -> bool {
    view.bytes.len == 4 && changed
}
machine mutate(backing: &mut Backing) -> bool {
    backing.bytes[0] = 9;
    true
}
machine consume(backing: Backing) -> bool { true }
machine main() crashes Trap {
    let mut backing: Backing = Backing { bytes: [1, 2, 3, 4] };
    let mut other: Backing = Backing { bytes: [5, 6, 7, 8] };
    let mut view: View = View { bytes: &backing.bytes[..] };
    let observed: bool = choose(
        match Updating::update(Keep as dyn Updating, &mut view) { true -> view false -> view },
        replace(&mut view) && mutate(&mut other)
    );
    transition observed && view.bytes.len == 5 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
