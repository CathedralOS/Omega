use omega::language::core::F64::negate;

machine build(builder: &mut Build) crashes Trap {
    let observed: f64 = F64::negate(7.0);
    transition observed == -7.0 {
        true -> configured(builder)
        _ -> wrong()
    }
    machine configured(builder: &mut Build) {
        Build::application(builder, "dynamic_float_refinement");
        Build::bind(builder, windows_x86_64::ProgramEntry, main);
        Build::bind(builder, linux_x86_64::ProgramEntry, main);
        Build::bind(builder, macos_arm64::ProgramEntry, main);
        Build::bind(builder, linux_arm64::ProgramEntry, main);
    }
    machine wrong() { crash Trap; }
}
