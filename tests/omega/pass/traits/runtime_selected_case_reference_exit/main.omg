// Expected exit: 0.
// Case namespaces remain distinct when both payloads reuse a field name.
data Pair { low: i32; high: i32; }
data Choice<T> { case First(value: T); case Second(value: T); }
trait Read { machine first(pair: &Pair) -> Choice<&i32>; }
Low satisfies Read {
    machine first(pair: &Pair) -> Choice<&i32> {
        transition pair.low < pair.high {
            true -> Choice::First { value: &pair.low }
            false -> Choice::Second { value: &pair.high }
        }
    }
}
High satisfies Read {
    machine first(pair: &Pair) -> Choice<&i32> {
        transition pair.low < pair.high {
            true -> Choice::Second { value: &pair.high }
            false -> Choice::First { value: &pair.low }
        }
    }
}
machine read(selected: dyn Read, pair: &Pair) -> Choice<&i32> {
    Read::first(selected, pair)
}
machine observed(found: Choice<&i32>) -> i32 {
    transition found {
        Choice::First { value } -> (value)
        Choice::Second { value } -> (value)
    }
}
machine main() crashes Trap {
    let pair: Pair = Pair { low: 3, high: 7 };
    let mut selected: dyn Read = Low as dyn Read;
    let found: Choice<&i32> = read(selected, &pair);
    let low: i32 = observed(found);
    selected = High as dyn Read;
    let other: Choice<&i32> = Read::first(selected, &pair);
    transition low == 3 && observed(other) == 7 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
