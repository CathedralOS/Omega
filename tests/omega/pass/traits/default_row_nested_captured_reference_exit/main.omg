// Expected exit: 0. A composite supplied operand keeps its captured reference
// region beneath a default row's same-spelled, independently fresh invocation.
data Wrapper<Value> { value: Value; }
trait Reading<Value> {
    machine read<'same>(value: Value, item: &'same i32) -> i32 {
        let retained: Wrapper<Value> = Wrapper { value: value };
        let recovered: Value = retained.value;
        item as i32
    }
}
Mapped<'same> satisfies Reading<Wrapper<&'same i32>> {}

machine invoke<'captured, 'invocation,
    Selected satisfies Reading<Wrapper<&'captured i32>>>(
    value: Wrapper<&'captured i32>, item: &'invocation i32
) -> i32 { Selected::read(value, item) }
machine observed<'storage, 'call>(
    context: &'storage i32, item: &'call i32
) -> i32 {
    let value: Wrapper<&'storage i32> = Wrapper { value: context };
    invoke<Mapped<'storage>>(value, item)
}
data Main { context: i32; item: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.context = 19;
    main.item = 37;
    let result: i32 = observed(&main.context, &main.item);
    transition result == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
