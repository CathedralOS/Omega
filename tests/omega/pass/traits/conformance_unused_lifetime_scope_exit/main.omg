// Expected exit: 0
// An unused provider region still comes from the exact caller's telescope.
trait Reading<Value> { machine read(value: Value) -> i32; }
ReadingMap<'first_provider, 'second_provider> satisfies Reading<i32> {
    machine read(value: i32) -> i32 { value }
}
trait Uses<Reader satisfies Reading<i32>> {}
trait Valid<'first_header, 'second_header>:
    Uses<ReadingMap<'second_header, 'first_header>> {}
data Phantom<Contract> {}
trait Captured<'outer> {
    machine inspect<'invocation>(value: Phantom<Uses<ReadingMap<'invocation, 'outer>>>);
    machine inspect_reversed<'invocation>(value: Phantom<Uses<ReadingMap<'outer, 'invocation>>>);
}
machine read_with<Reader satisfies Reading<i32>>(value: i32) -> i32 {
    Reader::read(value)
}
machine invoke<'first_caller, 'second_caller, Marker>(value: i32, marker: Marker) -> i32 {
    read_with<ReadingMap<'second_caller, 'first_caller>>(value)
}
machine main() crashes Trap {
    let result: i32 = invoke<i32>(37, 5);
    transition result == 37 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
