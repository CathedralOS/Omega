// Two predecessors supply different selectors to one state. Each edge carries
// its own selected implementation; the join invents no representative table.
// The counter starts at 5. `Increment` adds 1 and `Double` doubles it; the
// branch below takes `Double`, so the counter ends at 10 -> exit 70.
use omega_language_std::console;

trait Step<T> {
    machine apply(counter: &mut T);
}

data Counter {
    value: i32 in Wrapping;
}

Increment satisfies Step<Counter> {
    machine apply(counter: &mut Counter) {
        counter.value = counter.value + 1;
    }
}

Double satisfies Step<Counter> {
    machine apply(counter: &mut Counter) {
        counter.value = counter.value * 2;
    }
}

data Main {
    counter: Counter;
    double: bool;
}

machine Main::main(main: &mut Main) reaches Console {
    main.counter.value = 5;
    main.double = true;
    transition main.double {
        true -> run(main, Double as dyn Step<Counter>)
        _ -> run(main, Increment as dyn Step<Counter>)
    }

    machine run(main: &mut Main, step: dyn Step<Counter>) {
        Step::apply(step, &mut main.counter);
        transition main.counter.value == 10 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
