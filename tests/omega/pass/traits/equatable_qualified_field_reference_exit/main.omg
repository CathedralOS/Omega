// Qualified-type equality: `Filter.range` is declared `leaf::region::Region`
// and `==` operands are typed through the same qualified reference. Synthesized
// equality joins types by resolved symbol to their declared names, so the
// field's conformance is found and `Filter == Filter` expands structurally.
// Exits 70 only when qualified-spelling field conformance, qualified-spelling
// operands, and unqualified references all agree.
//
// `leaf` declares its own `Equatable` and satisfies `Region` against THAT
// trait; a same-named trait in another package is a different trait, so the
// field's conformance to this one is declared here. Conformances name a bare
// subject and a bare trait, which is why `Region` is also imported unqualified
// -- `leaf::region::Region satisfies Equatable` does not parse. Declaring a
// map for a type another package owns is ordinary: see
// wiki/spec/language/conformances.md, "Another package may declare a
// separately named map".

use omega_language_std::console;
use omega::language::core::binding;
use leaf::region;
use leaf::region::Region;

data Filter {
    range: leaf::region::Region;
}

trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

RegionEquatable: Region satisfies Equatable;
FilterEquatable: Filter satisfies Equatable;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let first: Filter = Filter { range: leaf::region::Region { base_address: 100, region_size: 16 } };
    let same: Filter = Filter { range: leaf::region::Region { base_address: 100, region_size: 16 } };
    let different: Filter = Filter { range: leaf::region::Region { base_address: 100, region_size: 8 } };
    let equal_result: bool = first == same;
    let different_result: bool = first != different;

    transition equal_result && different_result {
        true -> direct_operands()
        _ -> missed()
    }

    state direct_operands(&mut self) {
        let left: leaf::region::Region = leaf::region::Region { base_address: 5, region_size: 4 };
        let right: leaf::region::Region = leaf::region::Region { base_address: 5, region_size: 4 };
        let operand_result: bool = left == right;

        transition operand_result {
            true -> matched()
            _ -> missed()
        }
    }

    state matched(&mut self) {
        self.console.exit_process(70);
    }

    state missed(&mut self) {
        self.console.exit_process(71);
    }
}
