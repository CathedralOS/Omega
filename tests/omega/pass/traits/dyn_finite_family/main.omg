// Finite generic method family: a requirement whose `where` clause is
// one explicit disjunction of complete value-binder tuples is
// selectable at runtime — `where Width == 16 || Width == 32` — and
// the `dyn` selection materializes every roster tuple's realization:
// `Shape::code<16>` and `Shape::code<32>` resolve to their own rows.
trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> i32 where Width == 16 || Width == 32;
}
data Item {
    value: i32;
}
machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape<Item>::code {
    transition { _ -> item.value }
}
Primary satisfies Shape<Item> {
    machine code<Width: u32>(subject: &Item) -> i32 where Width == 16 || Width == 32 { Item::code<Width>(subject) }
}
data Main {
    item: Item;
}
machine Main::run(main: &mut Main) {
    main.item.value = 7;
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let half: i32 = Shape::code<16>(selected, &main.item);
    let full: i32 = Shape::code<32>(selected, &main.item);
}
machine Main::main(main: &mut Main) { }
