// Equatable over a record with a &[u8] in Utf8 field (frozen decisions 8 + 11):
// synthesized structural equality compares text by CONTENT -- length AND
// bytes -- through the backend's value-position text-equals operand, never by
// descriptor words (which would compare pointers). Four compares pin the
// shape: equal contents match; same-length different bytes miss; different
// lengths miss (without entering the byte loop); equal text with a differing
// scalar sibling field misses through the conjunction. Exits 70 only when all
// four are right.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Tag {
    label: &[u8] in Utf8;
    weight: i32;
}

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

TagEquality satisfies Equatable<Tag> { }

data Main {
    left: Tag;
    right: Tag;
}

machine Main::main(main: &mut Main) reaches Console {
    main.left = Tag { label: "amulet", weight: 3 };
    main.right = Tag { label: "amulet", weight: 3 };
    let equal: bool = main.left == main.right;
    transition equal {
        false -> bad(main)
        true -> different_contents(main)
    }

    state different_contents(main: &mut Main) {
        // Same length ("amulet" vs "ambush", six bytes each), different
        // content: only the byte loop can tell them apart.
        main.right = Tag { label: "ambush", weight: 3 };
        let still_equal: bool = main.left == main.right;
        transition still_equal {
            true -> bad(main)
            false -> different_lengths(main)
        }
    }

    state different_lengths(main: &mut Main) {
        // Shared prefix, one byte longer: the length compare must miss
        // before any content is read.
        main.right = Tag { label: "amulets", weight: 3 };
        let length_equal: bool = main.left == main.right;
        transition length_equal {
            true -> bad(main)
            false -> scalar_sibling(main)
        }
    }

    state scalar_sibling(main: &mut Main) {
        // Equal text, different scalar field: the synthesized conjunction
        // (label AND weight) must miss through the non-&[u8] in Utf8 side.
        main.right = Tag { label: "amulet", weight: 4 };
        let weight_equal: bool = main.left == main.right;
        transition weight_equal {
            true -> bad(main)
            false -> done(main)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
