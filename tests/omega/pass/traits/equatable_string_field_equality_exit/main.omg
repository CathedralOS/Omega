// Equatable over a record with a &[u8] in Utf8 field (frozen decisions 8 + 11):
// synthesized structural equality compares text by CONTENT -- length AND
// bytes -- through the backend's value-position text-equals operand, never by
// descriptor words (which would compare pointers). Four compares pin the
// shape: equal contents match; same-length different bytes miss; different
// lengths miss (without entering the byte loop); equal text with a differing
// scalar sibling field misses through the conjunction. Exits 70 only when all
// four are right.

domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data Tag {
    label: &[u8] in Utf8;
    weight: i32;
}

trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

TagEquatable: Tag satisfies Equatable;

data Main {
    console: Console;
    left: Tag;
    right: Tag;
}

machine Main::main(&mut self) {
    self.left = Tag { label: "amulet", weight: 3 };
    self.right = Tag { label: "amulet", weight: 3 };
    let equal: bool = self.left == self.right;
    transition equal {
        false -> bad()
        true -> different_contents()
    }

    state different_contents(&mut self) {
        // Same length ("amulet" vs "ambush", six bytes each), different
        // content: only the byte loop can tell them apart.
        self.right = Tag { label: "ambush", weight: 3 };
        let still_equal: bool = self.left == self.right;
        transition still_equal {
            true -> bad()
            false -> different_lengths()
        }
    }

    state different_lengths(&mut self) {
        // Shared prefix, one byte longer: the length compare must miss
        // before any content is read.
        self.right = Tag { label: "amulets", weight: 3 };
        let length_equal: bool = self.left == self.right;
        transition length_equal {
            true -> bad()
            false -> scalar_sibling()
        }
    }

    state scalar_sibling(&mut self) {
        // Equal text, different scalar field: the synthesized conjunction
        // (label AND weight) must miss through the non-&[u8] in Utf8 side.
        self.right = Tag { label: "amulet", weight: 4 };
        let weight_equal: bool = self.left == self.right;
        transition weight_equal {
            true -> bad()
            false -> done()
        }
    }

    state done(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
