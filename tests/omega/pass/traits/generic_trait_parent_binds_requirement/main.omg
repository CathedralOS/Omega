trait Sink<T> {
    machine put(sink: &mut Self, value: T);
}

trait IntSink: Sink<i32> {
}

data Counter {
    value: i32;
}

data Main {
    counter: Counter;
}

CounterIntSink: Counter satisfies IntSink;

machine Counter::put(counter: &mut Counter, value: i32) satisfies Sink<i32>::put {
    counter.value = value;
}

machine Main::main(main: &mut Main) {
    Counter::put(&mut main.counter, 7);
}
