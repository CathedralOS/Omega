// Expected exit: 0
// A structural refinement checks its existing nominal map at the exact captured region.
data Cell [copy] { value: u64; }
data View<'held> [copy] { reference: &'held Cell; }
trait Reading<Value> { machine read(value: Value) -> u64; }
trait LocalReading<Value> = Reading<Value> { machine * terminates; }
SelectedReading<'held> satisfies Reading<View<'held>> {
    machine read(value: View<'held>) -> u64 reaches terminates { value.reference.value }
}
machine select<'required, Selected satisfies LocalReading<View<'required>>>(value: View<'required>) -> u64 {
    Selected::read(value)
}
machine observe<'left, 'right>(left: &'left Cell, right: &'right Cell) -> u64 {
    let view: View<'left> = View { reference: left };
    select<SelectedReading<'left>>(view)
}
machine main() crashes Trap {
    let left: Cell = Cell { value: 42u64 };
    let right: Cell = Cell { value: 17u64 };
    let observed: u64 = observe(&left, &right);
    transition observed == 42u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
