// A trait requirement names its subject as an ordinary parameter, and its
// satisfier spells the same subject the same way. Both name one exclusive loan
// of the conforming data, so they correspond -- a requirement and its satisfier
// match parameter by parameter
// ([machines](../../../../wiki/spec/language/machines.md#static-declarations-and-explicit-state):
// "Trait requirements and satisfiers use the same explicit parameter
// correspondence").
//
// The retired `&mut self` requirement spelling pinned this correspondence the
// other way; with self receivers retired, the same contract is exercised
// through named subjects on both sides.
//
// Exits 1: `increment` ran exactly once through the named subject.
use omega_language_std::console;
use omega::language::core::binding;

trait Incrementable {
    machine increment(counter: &mut Self);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: &mut Counter) satisfies Incrementable::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable: Counter satisfies Incrementable;

data Main { console: Binding<Console>; counter: Counter; }

machine Main::main(main: &mut Main) reaches Console {
    Counter::increment(&mut main.counter);
    main.console.exit_process(main.counter.value as i32);
}
