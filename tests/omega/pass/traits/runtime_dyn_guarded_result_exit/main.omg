// Every implementation shares one public result, but need not produce every case.
use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Choice { case Empty; case Held(token: Token); }
trait Factory { machine make(value: u64) -> Choice; }
Empty satisfies Factory { machine make(value: u64) -> Choice { Choice::Empty } }
Held satisfies Factory {
    machine make(value: u64) -> Choice { Choice::Held { token: Token { value: value } } }
}
machine produce(selected: dyn Factory, value: u64) -> Choice {
    Factory::make(selected, value)
}
machine consume(choice: Choice) -> u64 {
    transition choice {
        Choice::Empty -> 0
        Choice::Held { token } -> finish(token)
    }
    machine finish(token: Token) -> u64 {
        let value: u64 = token.value;
        drop(token);
        value
    }
}
machine main() crashes Trap {
    let absent: u64 = consume(produce(Empty as dyn Factory, 11));
    let present: u64 = consume(produce(Held as dyn Factory, 17));
    transition absent == 0 && present == 17 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
