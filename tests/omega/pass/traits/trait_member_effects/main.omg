pub boundary trait Sink {
    machine emit(value: i32) reaches Sink;
    machine last() -> i32 reaches Sink;
}
data SinkProvider { }
machine SinkProvider::emit(value: i32)
satisfies Sink::emit {
}
machine SinkProvider::last() -> i32
satisfies Sink::last {
    7
}
pub data Main { }
boundary machine Main::main(main: &mut Main)
reaches Sink
invokes Sink;
{
    Sink::emit(3);
    let seen: i32 = Sink::last();
    transition { _ -> done(main, seen) }
    state done(main: &mut Main, kept: i32) { }
}
