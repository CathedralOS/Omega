machine build(builder: &mut Build) {
    Build::application(builder, "trait_member_effects");
    Build::select_provider<Sink, SinkProvider>(builder, linux_arm64);
    Build::select_provider<Sink, SinkProvider>(builder, linux_x86_64);
    Build::select_provider<Sink, SinkProvider>(builder, macos_arm64);
    Build::select_provider<Sink, SinkProvider>(builder, macos_x86_64);
    Build::select_provider<Sink, SinkProvider>(builder, windows_x86_64);
    Build::select_provider<Sink, SinkProvider>(builder, uefi_x86_64);
    Build::select_provider<Sink, SinkProvider>(builder, cross_platform_cli);
    Build::select_provider<Sink, SinkProvider>(builder, local_unchecked);
    Build::select_provider<Sink, SinkProvider>(builder, alpha_bootstrap);
    builder.freestanding = true;
}
