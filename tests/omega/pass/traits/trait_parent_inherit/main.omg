// A child trait declares its parent: `trait IntSink<S>: Sink<S, i32>`
// binds the parent's requirement; `CounterIntSink satisfies
// IntSink<Counter>` fills the parent member with an inline machine that calls
// `Counter::put`, while the provider itself satisfies
// the parent signature directly.
trait Sink<S, T> {
    machine put(sink: &mut S, value: T);
}
trait IntSink<S>: Sink<S, i32> {
}
data Counter {
    value: i32;
}
machine Counter::put(counter: &mut Counter, value: i32) satisfies Sink<Counter, i32>::put {
    counter.value = value;
}
CounterIntSink satisfies IntSink<Counter> {
    machine put(sink: &mut Counter, value: i32) { Counter::put(sink, value) }
}
data Main {
    counter: Counter;
}
machine Main::main(main: &mut Main) {
    Counter::put(&mut main.counter, 7);
}
