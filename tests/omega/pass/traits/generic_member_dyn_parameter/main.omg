// Conformance substitutes member binders inside a dynamic trait application.
// Expected exit: 0.
trait Reader<Context> {
    machine read(context: &Context) -> u64;
}
trait Forwarder {
    machine read<Value>(value: &Value, reader: dyn Reader<Value>) -> u64;
}
Forward satisfies Forwarder {
    machine read<Item>(value: &Item, reader: dyn Reader<Item>) -> u64 {
        Reader::read(reader, value)
    }
}
data Counter { value: u64; }
CounterReader satisfies Reader<Counter> {
    machine read(context: &Counter) -> u64 { context.value }
}
machine main() crashes Trap {
    let counter: Counter = Counter { value: 17 };
    let reader: dyn Reader<Counter> = CounterReader as dyn Reader<Counter>;
    let result: u64 = Forward::read(&counter, reader);
    transition result == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
