// A selector rebinds to another implementation and is forwarded to a helper
// that dispatches through it. Only the latest selection reaches the helper;
// the item is passed separately and is not captured by either selection.
// Primary would report 99; Bumped reports 99 + 1 == 100 -> exit 70.
use omega_language_std::console;

trait Shape<T> {
    machine code(subject: &T) -> i32;
}

data Item {
    value: i32 in Wrapping;
}

Primary satisfies Shape<Item> {
    machine code(subject: &Item) -> i32 {
        transition {
            _ -> (subject.value as i32)
        }
    }
}

Bumped satisfies Shape<Item> {
    machine code(subject: &Item) -> i32 {
        transition {
            _ -> (subject.value + 1) as i32
        }
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.item.value = 99;
    let mut selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    selected = Bumped as dyn Shape<Item>;
    let result: i32 = dispatch(selected, &main.item);
    transition result == 100 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine dispatch(selected: dyn Shape<Item>, item: &Item) -> i32 {
    let result: i32 = Shape::code(selected, item);
    transition {
        _ -> result
    }
}
