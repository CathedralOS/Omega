// Expected exit: 0. Consistent inherited applications retain their supplying
// region through independently named map, realization and invocation scopes.
trait Reading<Value> { machine read(value: Value) -> i32; }
trait Left<Value>: Reading<Value> {}
trait Right<Value>: Reading<Value> {}
trait Diamond<First, Second>: Left<First> + Right<Second> {}

Consistent<'mapping> satisfies Diamond<&'mapping i32, &'mapping i32> {
    Reading::read = read;
}
machine read<'source>(value: &'source i32) -> i32 { value as i32 }
machine invoke<'caller, Reader satisfies Diamond<&'caller i32, &'caller i32>>(
    value: &'caller i32
) -> i32 { Reader::read(value) }
machine observed<'entry>(value: &'entry i32) -> i32 {
    invoke<Consistent<'entry>>(value)
}

data Main { value: i32; }
machine Main::main(main: &mut Main) crashes Trap {
    main.value = 37;
    let result: i32 = observed(&main.value);
    transition result == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
