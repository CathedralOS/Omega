// One helper calls either machine through its public contract.
// The result bound justifies `9 - shrunk`; the selected results 8 and 6
// produce differences 1 and 3, whose sum must be 4.
// Expected exit: 70
use omega_language_std::Console;

trait Shrink<T> {
    machine shrink(scale: &T, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value;
}

data Scale {
    unit: u8;
}

TrimOne satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value
    {
        transition {
            _ -> (value - 1)
        }
    }
}

TrimThree satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value
    {
        transition {
            _ -> (value - 3)
        }
    }
}

data Main {
    scale: Scale;
}

machine Main::main(main: &mut Main) reaches Console {
    let one: machine(scale: &Scale, value: u64) -> u64 reaches none crashes none
    requires value >= 3 && value <= 100
    ensures result <= value = TrimOne::shrink;
    let three: machine(scale: &Scale, value: u64) -> u64 reaches none crashes none
    requires value >= 3 && value <= 100
    ensures result <= value = TrimThree::shrink;
    let first: u64 = Main::difference(one, &main.scale);
    let second: u64 = Main::difference(three, &main.scale);
    let total: u64 = first + second;
    transition total == 4 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine Main::difference(operation: machine(input: &Scale, amount: u64) -> u64 reaches none crashes none
    requires amount >= 3 && amount <= 100
    ensures result <= amount, scale: &Scale) -> u64
ensures result <= 9
{
    let shrunk: u64 = operation(scale, 9);
    transition {
        _ -> (9 - shrunk)
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
