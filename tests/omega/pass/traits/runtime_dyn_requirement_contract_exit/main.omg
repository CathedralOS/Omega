// A requirement's contract governs a selector call exactly as it governs a
// static call: the caller proves `requires` from its own facts and receives
// `ensures` without knowing which implementation the selector names. Each
// implementation refines that contract where it is declared, so the caller's
// `9 - shrunk` needs no runtime check.
// TrimOne::shrink(9) == 8 and TrimThree::shrink(9) == 6:
// (9 - 8) + (9 - 6) == 4 -> exit 70.
use omega_language_std::console;

trait Shrink<T> {
    machine shrink(scale: &T, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value;
}

data Scale {
    unit: u8;
}

TrimOne satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value
    {
        transition {
            _ -> (value - 1)
        }
    }
}

TrimThree satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value
    {
        transition {
            _ -> (value - 3)
        }
    }
}

data Main {
    scale: Scale;
}

machine Main::main(main: &mut Main) reaches Console {
    let one: dyn Shrink<Scale> = TrimOne as dyn Shrink<Scale>;
    let three: dyn Shrink<Scale> = TrimThree as dyn Shrink<Scale>;
    let first: u64 = Shrink::shrink(one, &main.scale, 9);
    let second: u64 = Shrink::shrink(three, &main.scale, 9);
    let total: u64 = (9 - first) + (9 - second);
    transition total == 4 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
