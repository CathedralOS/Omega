use omega_language_std::console;
use omega::language::core::binding;

trait Shape {
    machine code(shape: &Self) -> i32;
}

data Item {
    value: i32;
}

Primary: Item satisfies Shape {
    machine code(item: &Item) -> i32 {
        transition {
            _ -> item.value
        }
    }
}

data Main {
    console: Binding<Console>;
    decoy: Item;
    selected: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.decoy.value = 4;
    main.selected.value = 99;
    let mut erased: &dyn Shape = &main.decoy as &dyn Item::Primary;
    erased = &main.selected as &dyn Item::Primary;
    let result: i32 = dispatch(erased);
    transition result == 99 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}

machine dispatch(erased: &dyn Shape) -> i32 {
    let result: i32 = erased.code();
    transition {
        _ -> result
    }
}
