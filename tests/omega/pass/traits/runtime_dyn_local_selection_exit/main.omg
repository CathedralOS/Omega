// A local selector built from a named implementation dispatches to that
// implementation's row, not to a same-named machine attached to the data
// type: `Item::code` below is a deliberate look-alike that returns 4. The
// selected row reads the explicitly passed item's value, 0 -> exit 70.
use omega_language_std::console;

trait Shape<T> {
    machine code(subject: &T) -> i32;
}

data Item [copy] {
    value: i32;
}

machine Item::code(item: &Item) -> i32 {
    transition {
        _ -> 4
    }
}

Primary satisfies Shape<Item> {
    machine code(subject: &Item) -> i32 {
        transition {
            _ -> subject.value
        }
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let result: i32 = Shape::code(selected, &main.item);
    transition result == 0 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
