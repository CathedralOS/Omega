domain [u8]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Console;

    machine exit_process(return_code: i32)
    reaches
        Console;
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    self.console.write_line("boundary reach survives syntax");
    self.console.exit_process(0);
}
