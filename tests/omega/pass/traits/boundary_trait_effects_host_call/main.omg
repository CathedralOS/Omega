use omega::language::core::binding;
pub domain [u8]::Utf8
requires
    valid_utf8(self);
pub boundary trait Console {
    machine write_line(text: &[u8] in Utf8)
    reaches
        Console;

    machine exit_process(return_code: i32)
    reaches
        Console;
}

// The package-authored provider that provider selection assembles into the
// Fused plan the entry's `Binding<Console>` field demands. The boundary is
// the checked surface under test; the bodies pin no runtime behavior.
data ConsoleProvider { }

machine ConsoleProvider::write_line(text: &[u8] in Utf8)
satisfies Console::write_line {
}

machine ConsoleProvider::exit_process(return_code: i32)
satisfies Console::exit_process {
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    self.console.write_line("boundary reach survives syntax");
    self.console.exit_process(0);
}
