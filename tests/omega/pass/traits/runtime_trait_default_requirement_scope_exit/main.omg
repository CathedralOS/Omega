// A default body names requirements of its own trait by bare spelling, in the
// trait's scope rather than an implementing data type's, and each named
// implementation runs them through its own rows: `reset` calls `set`, which
// `Resettable` inherits from `Settable`, and `prepare`, another default; the
// generic `Store<Item>` default calls `put` under the conformance's `i32`; and
// the free machine `set` never captures the requirement's spelling. Exits 70
// only when the counter ends at 30 after `prepare` and the slot was written
// twice.
use omega_language_std::console;

trait Settable<T> {
    machine set(subject: &mut T, value: i32);
}

trait Resettable<T>: Settable<T> {
    machine prepare(subject: &mut T) {
        set(subject, 10);
    }

    machine reset(subject: &mut T) {
        prepare(subject);
        set(subject, 30);
    }
}

trait Store<Container, Item> {
    machine put(subject: &mut Container, item: Item);

    machine put_twice(subject: &mut Container, item: Item) {
        put(subject, item);
        put(subject, item);
    }
}

machine set(value: i32) -> i32 {
    value
}

data Counter {
    value: i32;
    prepared: bool;
}

CounterResettable satisfies Resettable<Counter> {
    Settable::set = Counter::set;
}

machine Counter::set(counter: &mut Counter, value: i32) {
    transition value == 10 {
        true -> prepared(counter, value)
        _ -> assigned(counter, value)
    }

    state prepared(counter: &mut Counter, value: i32) {
        counter.prepared = true;
        counter.value = value;
    }

    state assigned(counter: &mut Counter, value: i32) {
        counter.value = value;
    }
}

data Slot {
    value: i32;
    writes: i32 in Wrapping;
}

SlotStore satisfies Store<Slot, i32> {
    Store::put = Slot::put;
}

machine Slot::put(slot: &mut Slot, item: i32) {
    slot.value = item;
    slot.writes = slot.writes + 1;
}

data Main {
    counter: Counter;
    slot: Slot;
}

machine Main::main(main: &mut Main) reaches Console {
    CounterResettable::reset(&mut main.counter);
    SlotStore::put_twice(&mut main.slot, 40);
    transition main.counter.value == 30
        && main.counter.prepared
        && main.slot.value == 40
        && main.slot.writes as i32 == 2 {
        true -> done(main)
        _ -> refused(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state refused(main: &mut Main) {
        Console::exit_process(71);
    }
}
