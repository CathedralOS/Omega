// Application binders can occur only inside a compound argument. They do not
// become invocation binders, and the member's separate telescope still matches.
use omega_language_std::console;

pub trait Readable<Field> {
    machine read<Value>(field: &Field, value: Value) -> Value;
}

pub data Reader {}
machine Reader::read<Element, const Width: u32, Value>(
    field: &[Element; Width], value: Value
) -> Value satisfies Readable<[Element; Width]>::read { value }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let elements: [u8; 2] = [1u8, 2u8];
    let value: i32 = Reader::read<u8, 2, i32>(&elements, 70);
    let other_elements: [u16; 3] = [1u16, 2u16, 3u16];
    let other_value: u64 = Reader::read<u16, 3, u64>(&other_elements, 1u64);
    transition (other_value == 1u64) {
        true -> good(main, value)
        _ -> bad(main)
    }
    state good(main: &mut Main, selected: i32) { Console::exit_process(selected); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
