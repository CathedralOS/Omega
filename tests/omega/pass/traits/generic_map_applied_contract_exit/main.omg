// Expected exit: 0. A selected map substitutes its own const telescope before
// the public trait contract; another application's guarantee cannot stand in.
const Ceiling: u32 = 100;
trait Bounded<const Limit: u32> {
    machine identity(value: u32) -> u32
    requires value <= Limit
    ensures result <= Limit;
}
Identity<const Maximum: u32> satisfies Bounded<Maximum> {
    machine identity(input: u32) -> u32
    requires input <= Maximum
    ensures result <= Maximum
    { input }
}
machine selected<Implementation satisfies Bounded<Ceiling>>(value: u32) -> u32
requires value <= Ceiling
ensures result <= Ceiling
{ Implementation::identity(value) }
machine main() crashes Trap {
    let result: u32 = selected<Identity<Ceiling>>(100);
    let literal: u32 = selected<Identity<100>>(42);
    transition result == 100 && literal == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
