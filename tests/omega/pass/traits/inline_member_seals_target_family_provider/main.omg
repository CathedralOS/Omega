// An inline member whose whole body is one call to a per-target provider family
// keeps that family as its realization, as the reference row it replaces did.
// Every target body satisfies the requirement, and a bodyless boundary body
// publishes no termination proof, so forwarding to it could never discharge the
// requirement's `terminates` assumption.
public boundary trait Console {
    machine write_byte(byte: i32) reaches Console terminates;
}
public data NativeProvider {}
linux_x86_64 boundary machine NativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
linux_arm64 boundary machine NativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
macos_arm64 boundary machine NativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
FamilyConsole satisfies Console {
    machine write_byte(byte: i32) reaches Console terminates { NativeProvider::write_byte(byte) }
}
data Main {}
machine Main::main(main: &mut Main) {}
