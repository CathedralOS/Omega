data Counter {
    value: i32 in Wrapping;
}

trait BoundedCounter {
    machine increment(&mut self, amount: u32)
        ensures amount >= 0;
    machine snapshot(&self);
}

machine Counter::increment(&mut self, amount: u32) satisfies BoundedCounter::increment {
    self.value = self.value + 1;
}

machine Counter::snapshot(&self) {
}

data Main {
}

machine Main::main(&mut self) {
}
