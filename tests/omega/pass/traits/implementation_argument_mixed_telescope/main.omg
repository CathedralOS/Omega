// Code selections keep their authored position among ordinary type arguments.
trait Reading<Value> { machine read(value: Value) -> Value; }
SelectedReading<Value> satisfies Reading<Value> {
    machine read(value: Value) -> Value { value }
}
trait Consumer<Value, Reader satisfies Reading<Value>, Result> { }
trait Forward<Value, Reader satisfies Reading<Value>, Result>:
    Consumer<Value, Reader, Result> { }
trait Concrete: Forward<i32, SelectedReading<i32>, bool> { }
trait LocalReading<Value> = Reading<Value> { machine * blocks false; }
trait RefinedForward<Value, Reader satisfies LocalReading<Value>, Result>:
    Consumer<Value, Reader, Result> { }
trait RefinedConcrete: RefinedForward<i32, SelectedReading<i32>, bool> { }
ConcreteImplementation satisfies Concrete { }
data Main { }
machine Main::main() { }
