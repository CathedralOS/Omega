// A trait requirement that writes `crashes none` admits a member that writes
// `crashes none` and cannot crash, and `advance`, checked against the
// requirement, keeps its own `crashes none`.
// Twin: `fail/traits/crashes_none_requirement_member_crashes`, whose member
// can trap.
// Expected exit: 0
trait Step {
    machine apply(value: u32) -> u32
    crashes none;
}
Holding satisfies Step {
    machine apply(value: u32) -> u32
    crashes none
    {
        value
    }
}
machine advance<Selected satisfies Step>(start: u32) -> u32
crashes none
{
    Selected::apply(start)
}
machine main() crashes Trap {
    let value: u32 = advance<Holding>(0);
    transition value == 0 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
