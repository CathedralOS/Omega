machine build(builder: &mut Build) {
    Build::application(builder, "method_explicit_machine_prefix");
    Build::select_provider<NeedsMachine, SelectedMachine>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, program);
    Build::select_provider<NeedsMachine, SelectedMachine>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, program);
    Build::select_provider<NeedsMachine, SelectedMachine>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, program);
    Build::select_provider<NeedsMachine, SelectedMachine>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, program);
}
