// RUN CANARY (exit 70). A requirement call names its implementation:
// `Ranked::compare<Card, PowerOrder>(&low, &high)` applies `Ranked<Card>`
// through `PowerOrder`'s row and `Ranked::compare<Card, SuitOrder>` through
// `SuitOrder`'s. The two implementations order the same cards oppositely, and
// the generic `Never<Card>` application orders nothing. `rank` applies the
// requirement through its evidence binder, `Ranked::compare<T, Order>`, which
// specialization binds to `SuitOrder` at `rank<Card, SuitOrder>`.
// `SuitDescending` implements `Descending<Card>`, which inherits `Ranked<Card>`,
// so `Ranked::compare<Card, SuitDescending>` selects its inherited row. Exit 70
// shows each call ran its own implementation's machine.
use omega_language_std::console;

trait Ranked<T> {
    machine compare(left: &T, right: &T) -> bool;
}

trait Descending<T> : Ranked<T> {
    machine lowest(left: &T, right: &T) -> bool;
}

data Card { power: i32; suit: i32; }

PowerOrder satisfies Ranked<Card> {
    machine compare(left: &Card, right: &Card) -> bool {
        left.power < right.power
    }
}

SuitOrder satisfies Ranked<Card> {
    machine compare(left: &Card, right: &Card) -> bool {
        left.suit < right.suit
    }
}

Never<T> satisfies Ranked<T> {
    machine compare(left: &T, right: &T) -> bool {
        false
    }
}

SuitDescending satisfies Descending<Card> {
    machine compare(left: &Card, right: &Card) -> bool {
        left.suit > right.suit
    }
    machine lowest(left: &Card, right: &Card) -> bool {
        left.suit < right.suit
    }
}

machine rank<T, Order satisfies Ranked<T>>(left: &T, right: &T) -> bool {
    Ranked::compare<T, Order>(left, right)
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let low: Card = Card { power: 1, suit: 9 };
    let high: Card = Card { power: 8, suit: 2 };
    let by_power: bool = Ranked::compare<Card, PowerOrder>(&low, &high);
    let by_suit: bool = Ranked::compare<Card, SuitOrder>(&low, &high);
    let by_nothing: bool = Ranked::compare<Card, Never<Card>>(&low, &high);
    let by_binder: bool = rank<Card, SuitOrder>(&low, &high);
    let by_inherited: bool = Ranked::compare<Card, SuitDescending>(&low, &high);
    transition (by_power, by_suit, by_nothing, by_binder, by_inherited) {
        (true, false, false, false, true) -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
