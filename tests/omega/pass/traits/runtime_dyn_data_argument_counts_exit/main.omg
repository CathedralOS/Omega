// A selector reaches requirements with zero data arguments and with two data
// arguments of the same type through the same call form: the selector is the
// dispatch operand and every other operand is an ordinary argument. No data
// position is privileged.
// Tens::base() == 10 and Tens::combine(3, 4) == 3 * 10 + 4 == 34:
// 10 + 34 == 44 -> exit 70.
use omega_language_std::console;

trait Arithmetic<T> {
    machine base() -> i32;
    machine combine(left: &T, right: &T) -> i32;
}

data Digit {
    value: i32 in Wrapping;
}

Tens satisfies Arithmetic<Digit> {
    machine base() -> i32 {
        transition {
            _ -> 10
        }
    }
    machine combine(left: &Digit, right: &Digit) -> i32 {
        transition {
            _ -> (left.value * 10 + right.value) as i32
        }
    }
}

data Main {
    left: Digit;
    right: Digit;
}

machine Main::main(main: &mut Main) reaches Console {
    main.left.value = 3;
    main.right.value = 4;
    let operations: dyn Arithmetic<Digit> = Tens as dyn Arithmetic<Digit>;
    let base: i32 = Arithmetic::base(operations);
    let combined: i32 = Arithmetic::combine(operations, &main.left, &main.right);
    transition base == 10 && combined == 34 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
