// Transparent trait refinement: `trait R = Base` declares a structural bound
// over an existing base conformance, narrowed by `machine` clauses carrying
// operational axes only. A refinement is never a `satisfies` target itself —
// evidence binders (`B satisfies R`) are its legal consumers.

trait Logger<T> {
    machine write(subject: &mut T) suspends; blocks;
    machine flush(subject: &mut T);
}

trait LocalLogger<T> = Logger<T> {
    machine * suspends false; blocks false; terminates;
    machine Logger::flush terminates;
}

data Sink {
    pending: i32;
}

machine Sink::write(sink: &mut Sink) satisfies Logger<Sink>::write {
    sink.pending = 0;
}

machine Sink::flush(sink: &mut Sink) satisfies Logger<Sink>::flush {
    sink.pending = 0;
}

SinkLogger satisfies Logger<Sink> {
    Logger::write = Sink::write;
    Logger::flush = Sink::flush;
}

data Main {
}

machine Main::main() {
}
