// Application binders fix the trait contract; invocation binders remain universal.
trait Identity<Element> {
    machine identity(value: Element) -> Element;
}
machine identity<Element>(value: Element) -> Element
satisfies Identity<Element>::identity {
    value
}

trait Select<Context> {
    machine select<Value>(context: Context, value: Value) -> Value;
}
machine select<Context, Value>(context: Context, value: Value) -> Value
satisfies Select<Context>::select {
    value
}

data Envelope<Element> { value: Element; }
trait Tag<Container> {
    machine tagged<Value>(value: Value) -> Value;
}
machine tagged<Element, Value>(value: Value) -> Value
satisfies Tag<Envelope<Element>>::tagged {
    value
}

machine main() crashes Trap {
    let context: i32 = identity<i32>(70);
    let selected: u8 = select<i32, u8>(context, 85);
    let smaller: u8 = identity<u8>(3);
    let tagged: u16 = tagged<i64, u16>(170);
    transition context == 70 && selected == 85 && smaller == 3 && tagged == 170 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
