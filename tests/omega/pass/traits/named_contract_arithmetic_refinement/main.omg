// Expected exit: 0
public boundary trait ExactRead {
    machine read(value: u8) -> u8
    reaches
    ensures result == value;
}
public boundary trait SecondRead {
    machine observe(value: u8) -> u8
    reaches
    ensures result == value;
}
trait LocalForward {
    machine forward(value: u8) -> u8
    ensures result == value;
}
ReadRoute satisfies LocalForward {
    machine forward(value: u8) -> u8
    satisfies ExactRead::read, SecondRead::observe
    ensures result == value
    { value }
}
// The member passes 7 to echo even when its public caller passes 42.
boundary trait LiteralRead {
    machine read(value: u8) -> u8 reaches;
}
machine echo(value: u8) -> u8 satisfies LiteralRead::read reaches { value }
LiteralRoute satisfies LiteralRead {
    machine read(value: u8) -> u8 reaches { echo(7u8) }
}
machine probe_independent() crashes Trap {
    let result: u8 = ExactRead::read(7u8);
    let second: u8 = SecondRead::observe(9u8);
    let literal: u8 = LiteralRead::read(42u8);
    transition result == 7u8 && second == 9u8 && literal == 7u8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// Expected exit: 0
public boundary trait InheritedRead {
    machine read(input: u8) -> u8
    reaches
    ensures result == input;
}
trait InheritedForward {
    machine forward(datum: u8) -> u8;
}
InheritedRoute satisfies InheritedForward {
    machine forward(datum: u8) -> u8
    satisfies InheritedRead::read
    reaches
    { datum }
}
machine consume_inherited(value: u8)
requires value == 9u8
{}
machine probe_inherited() crashes Trap {
    let observed: u8 = InheritedRead::read(9u8);
    consume_inherited(observed);
    transition observed == 9u8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// Expected exit: 0
// The inline member's exact trait application remains an obligation alongside
// the whole implementation map. Calls must retain both distinct arguments.
trait ExactValue<Item> {
    machine forward(value: Item) -> Item;
}
Values satisfies ExactValue<u64> {
    machine forward(value: u64) -> u64 satisfies ExactValue<u64>::forward { value }
}
machine probe_application() crashes Trap {
    transition Values::forward(7u64) == 7u64 && Values::forward(13u64) == 13u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

trait Threshold {
    machine limit(value: u32) -> u32
    requires value <= 100
    ensures result <= 100;
}
// No exact satisfaction edge: the map must judge both directions itself.
machine cap(argument: u32) -> u32
requires argument < 201
ensures result < 91
{
    transition argument < 91 {
        true -> (argument)
        _ -> 90
    }
}
Conservative satisfies Threshold { machine limit(value: u32) -> u32 requires value <= 100 ensures result <= 100 { cap(value) } }
machine main() crashes Trap {
    probe_independent();
    probe_inherited();
    probe_application();
    let selected: dyn Threshold = Conservative as dyn Threshold;
    let value: u32 = Threshold::limit(selected, 100);
    transition value == 90 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
