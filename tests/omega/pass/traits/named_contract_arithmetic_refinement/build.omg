machine build(builder: &mut Build) {
    Build::application(builder, "named_contract_arithmetic_refinement");
    Build::select_provider<ExactRead, ReadRoute>(builder, linux_x86_64);
    Build::select_provider<SecondRead, ReadRoute>(builder, linux_x86_64);
    Build::select_provider<LiteralRead, LiteralRoute>(builder, linux_x86_64);
    Build::select_provider<ExactRead, ReadRoute>(builder, linux_arm64);
    Build::select_provider<SecondRead, ReadRoute>(builder, linux_arm64);
    Build::select_provider<LiteralRead, LiteralRoute>(builder, linux_arm64);
    Build::select_provider<ExactRead, ReadRoute>(builder, macos_arm64);
    Build::select_provider<SecondRead, ReadRoute>(builder, macos_arm64);
    Build::select_provider<LiteralRead, LiteralRoute>(builder, macos_arm64);
    Build::select_provider<ExactRead, ReadRoute>(builder, windows_x86_64);
    Build::select_provider<SecondRead, ReadRoute>(builder, windows_x86_64);
    Build::select_provider<LiteralRead, LiteralRoute>(builder, windows_x86_64);
    Build::select_provider<InheritedRead, InheritedRoute>(builder, linux_x86_64);
    Build::select_provider<InheritedRead, InheritedRoute>(builder, linux_arm64);
    Build::select_provider<InheritedRead, InheritedRoute>(builder, macos_arm64);
    Build::select_provider<InheritedRead, InheritedRoute>(builder, windows_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
