// Expected exit: 0. Qualified sibling calls retain the selecting named map,
// both as statements and as values, including an inherited default body.
data Cell { value: i32; }
trait Access {
    machine put(cell: &mut Cell, value: i32);
    machine read(cell: &Cell) -> i32;
    machine roundtrip(cell: &mut Cell, value: i32) -> i32 {
        Access::put(cell, value);
        Access::read(cell)
    }
}
First satisfies Access {
    machine put(cell: &mut Cell, value: i32) { cell.value = value; }
    machine read(cell: &Cell) -> i32 { cell.value }
    machine roundtrip(cell: &mut Cell, value: i32) -> i32 {
        Access::put(cell, value);
        Access::read(cell)
    }
}
Second satisfies Access {
    machine put(cell: &mut Cell, value: i32) { cell.value = 29; }
    machine read(cell: &Cell) -> i32 { cell.value }
}
trait Reading<Subject> {
    machine get(subject: &Subject) -> i32;
    machine observed(subject: &Subject) -> i32 { Reading::get(subject) }
}
CellReading satisfies Reading<Cell> {
    machine get(subject: &Cell) -> i32 { subject.value }
}
data Main { cell: Cell; }
machine Main::main(main: &mut Main) crashes Trap {
    let first: i32 = First::roundtrip(&mut main.cell, 17);
    let second: i32 = Second::roundtrip(&mut main.cell, 3);
    let observed: i32 = CellReading::observed(&main.cell);
    transition first == 17 && second == 29 && observed == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
