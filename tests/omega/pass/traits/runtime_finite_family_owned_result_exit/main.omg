use omega_language_std::console;
use omega::language::core::drop;

data Token [linear] { value: u64 in Wrapping; }
machine Token::drop(token: &mut Token) {}
domain Token::Issued;
data Packet { token: Token in Token::Issued; marker: u32; }
data Item { calls: u32 in Wrapping; }

machine issue(value: u64 in Wrapping) -> Token in Token::Issued {
    let token: Token in Token::Issued = Token { value: value };
    token
}

trait Shape<T> {
    machine code<Width: u32>(subject: &mut T, packet: Packet) -> Packet
    where Width == 16 || Width == 32 || Width == 64;
}
machine Item::code<Width: u32>(item: &mut Item, packet: Packet) -> Packet satisfies Shape<Item>::code {
    item.calls = item.calls + 1;
    Packet { token: packet.token, marker: Width }
}
machine Item::bumped<Width: u32>(item: &mut Item, packet: Packet) -> Packet satisfies Shape<Item>::code {
    item.calls = item.calls + 1;
    let width: u32 in Wrapping = Width as u32 in Wrapping;
    Packet { token: packet.token, marker: (width + 1) as u32 }
}
Primary satisfies Shape<Item> { Shape::code = Item::code; }
Bumped satisfies Shape<Item> { Shape::code = Item::bumped; }

machine scan(selected: dyn Shape<Item>, item: &mut Item, packet: Packet, width: u32) -> Packet
requires width == 16 || width == 32 || width == 64;
{
    let result: Packet = Shape::code<width>(selected, item, packet);
    result
}

data Main { item: Item; }
machine Main::main(main: &mut Main) reaches Console {
    let mut selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let first: Packet = scan(selected, &mut main.item, Packet { token: issue(7), marker: 0 }, 16);
    let first_marker: u32 = first.marker;
    let first_value: u64 in Wrapping = first.token.value;
    drop(first.token);
    selected = Bumped as dyn Shape<Item>;
    let second: Packet = scan(selected, &mut main.item, Packet { token: issue(9), marker: 0 }, 32);
    let second_marker: u32 = second.marker;
    let second_value: u64 in Wrapping = second.token.value;
    drop(second.token);
    transition first_marker == 16 && first_value == 7 && second_marker == 33 && second_value == 9 && main.item.calls == 2 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
