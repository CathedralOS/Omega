// Finite generic method family: a requirement whose `where` clause is one
// explicit disjunction of complete value-binder tuples is selectable at
// runtime, and the selection alone materializes every roster tuple's
// realization -- no static call demands either one. Both `code<16>` and
// `code<32>` must resolve to their own generated rows.

trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> i32 where Width == 16 || Width == 32;
}

data Item {
    value: i32;
}

machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape<Item>::code {
    transition { _ -> item.value }
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
}

data Main {
    item: Item;
}

machine Main::run(main: &mut Main) {
    main.item.value = 7;
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let half: i32 = Shape::code<16>(selected, &main.item);
    let full: i32 = Shape::code<32>(selected, &main.item);
}
