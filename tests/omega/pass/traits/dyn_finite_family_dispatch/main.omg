// Finite generic method family: a `dyn` requirement whose signature `where`
// clause is one explicit disjunction of complete value-binder tuples admits a
// borrowed dynamic receiver, and the selection alone materializes every roster
// tuple's provider specialization -- no static call site demands either one.
// Both `code<16>` and `code<32>` must resolve to their own generated rows.

trait Shape {
    machine code<Width: u32>(subject: &Self) -> i32 where Width == 16 || Width == 32;
}

data Item {
    value: i32;
}

machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape::code {
    transition { _ -> item.value }
}

Primary: Item satisfies Shape {
    Shape::code = Item::code;
}

data Main {
    item: Item;
}

machine Main::run(main: &mut Main) {
    main.item.value = 7;
    let erased: &dyn Shape = &main.item as &dyn Item::Primary;
    let half: i32 = Shape::code<16>(erased);
    let full: i32 = Shape::code<32>(erased);
}
