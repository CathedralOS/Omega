// `public machine +` binds an operator on borrowed test-owned operands:
// `left + right` invokes the declaration's own checked body yielding
// the wrapped sum 250 + 10 = 260 that no u8 builtin could carry; the
// declaration stays callable by name as `Wrapped::add`.
public data Wrapped { value: u8; }

public machine + Wrapped::add(left: &Wrapped, right: &Wrapped) -> u64 {
    (left.value as u64) + (right.value as u64)
}

machine choose(flag: bool, left: &Wrapped, right: &Wrapped) -> u64 {
    match flag {
        true -> left + right,
        false -> 18446744073709551616 / 18446744073709551616
    }
}

data Main {}

machine Main::main(main: &mut Main) {
    let left: Wrapped = Wrapped { value: 250u8 };
    let right: Wrapped = Wrapped { value: 10u8 };
    let selected: u64 = choose(true, &left, &right);
    let named: u64 = Wrapped::add(&left, &right);
    transition selected == 260 && named == 260 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
