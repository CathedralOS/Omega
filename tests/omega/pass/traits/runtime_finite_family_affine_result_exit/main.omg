// Expected exit 70. The returned affine Packet is
// consumed while an older nominal owner remains live and readable.
use omega_language_std::console;
use omega::language::core::drop;
data Token { value: u32; }
machine Token::drop(token: &mut Token) { token.value = 0; }
data Packet { token: Token; marker: u32; }
data Item { value: u32; }
trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> Packet
    where Width == 16 || Width == 32;
}
machine Item::code<Width: u32>(item: &Item) -> Packet satisfies Shape<Item>::code {
    Packet { token: Token { value: item.value }, marker: Width }
}
Primary satisfies Shape<Item> { Shape::code = Item::code; }
machine scan(selected: dyn Shape<Item>, item: &Item, width: u32) -> Packet
requires width == 16 || width == 32;
{ Shape::code<width>(selected, item) }
machine consume(packet: Packet) -> bool { packet.marker == 32 && packet.token.value == 17 }
data Main { item: Item; }
machine Main::main(main: &mut Main) reaches Console {
    main.item.value = 17;
    let older: Token = Token { value: 91 };
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let packet: Packet = scan(selected, &main.item, 32);
    let accepted: bool = consume(packet);
    let older_intact: bool = older.value == 91;
    drop(older);
    transition accepted && older_intact { true -> good(main) false -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
