// Expected exit: 0
// An implementation argument supplies a checked map, not an invocation of
// every generic member. Only Calling adds a build-time plan demand.
trait Operations { machine identity<Value>(value: Value) -> Value; }
Selected<Capture> satisfies Operations {
    machine identity<Value>(value: Value) -> Value { value }
}
trait Holder<Code satisfies Operations> {}
Held satisfies Holder<Selected<u64>> {}
machine main() {}
