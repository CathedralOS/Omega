domain [u8]::Utf8
requires
    valid_utf8(self);
// `!=` over an Equatable record with a &[u8] in Utf8 field in VALUE position:
// `self.left != self.right` must see the differing `name` fields ("gold" vs
// "iron"; the scalar `id` fields are equal) and exit 70. The state-values
// simplifier De-Morgans the synthesized `equality == false` spelling into
// per-field `!=` compares, so the &[u8] in Utf8 term reaches instruction selection
// as a direct `&[u8] in Utf8 != &[u8] in Utf8` binary; it lowers as the negated text-equals
// leaf (`text_equals(..) == 0`). Before that lowering existed the whole
// initializer write was silently dropped (ZII false -> native exit 71 while
// the interpreter exited 70).

use omega::language::std::console;

data Tag {
    name: &[u8] in Utf8;
    id: i32;
}

trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

TagEquatable: Tag satisfies Equatable;

data Main {
    console: Console;
    left: Tag;
    right: Tag;
}

machine Main::main(&mut self) {
    self.left = Tag { name: "gold", id: 5 };
    self.right = Tag { name: "iron", id: 5 };

    let differ: bool = self.left != self.right;
    transition differ {
        false -> bad()
        true -> good()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}