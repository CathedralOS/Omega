// Defaults flow through both body-level `requires` and header-parent
// composition. A conformance to the child trait alone receives the inherited
// machine. Exits 70 only when each reset ran its own resolution: 30 from the
// required default, 30 through the parent, and 10 from the authored override
// that settles the two conflicting defaults.
use omega_language_std::console;
use omega::language::core::binding;

trait Resettable {
    machine set(subject: &mut Self, value: i32);

    machine reset(subject: &mut Self) {
        set(&mut subject, 30);
    }
}

trait RequiredCounter {
    requires Resettable;
}

trait ParentCounter: Resettable {
}

trait LeftReset {
    machine set(subject: &mut Self, value: i32);

    machine reset(subject: &mut Self) {
        set(&mut subject, 1);
    }
}

trait RightReset {
    machine set(subject: &mut Self, value: i32);

    machine reset(subject: &mut Self) {
        set(&mut subject, 2);
    }
}

trait ResolvedCounter {
    requires LeftReset;
    requires RightReset;
}

data RequiredValue {
    value: i32;
}

RequiredValueRequiredCounter: RequiredValue satisfies RequiredCounter;

machine RequiredValue::set(required_value: &mut RequiredValue, value: i32) {
    required_value.value = value;
}

data ParentValue {
    value: i32;
}

ParentValueParentCounter: ParentValue satisfies ParentCounter;

machine ParentValue::set(parent_value: &mut ParentValue, value: i32) {
    parent_value.value = value;
}

data ResolvedValue {
    value: i32;
}

ResolvedValueResolvedCounter: ResolvedValue satisfies ResolvedCounter;

machine ResolvedValue::set(resolved_value: &mut ResolvedValue, value: i32) {
    resolved_value.value = value;
}

machine ResolvedValue::reset(resolved_value: &mut ResolvedValue) {
    ResolvedValue::set(resolved_value, 10);
}

data Main {
    console: Binding<Console>;
    required_value: RequiredValue;
    parent_value: ParentValue;
    resolved_value: ResolvedValue;
}

machine Main::main(main: &mut Main) reaches Console {
    RequiredValue::reset(&mut main.required_value);
    ParentValue::reset(&mut main.parent_value);
    ResolvedValue::reset(&mut main.resolved_value);
    transition main.required_value.value == 30
        && main.parent_value.value == 30
        && main.resolved_value.value == 10 {
        true -> done(main)
        _ -> refused(main)
    }

    state done(main: &mut Main) {
        main.console.exit_process(70);
    }

    state refused(main: &mut Main) {
        main.console.exit_process(71);
    }
}
