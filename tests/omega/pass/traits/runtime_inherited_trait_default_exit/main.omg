// Defaults flow through header-parent composition. A named implementation of
// the child trait alone receives the inherited machine. Exits 70 only when
// each reset ran its own resolution: 30 from the first child's default, 30
// through the second, and 10 from the authored override that settles the two
// conflicting defaults.
use omega_language_std::console;

trait Resettable<T> {
    machine set(subject: &mut T, value: i32);

    machine reset(subject: &mut T) {
        set(&mut subject, 30);
    }
}

trait RequiredCounter<T>: Resettable<T> {
}

trait ParentCounter<T>: Resettable<T> {
}

trait LeftReset<T> {
    machine set(subject: &mut T, value: i32);

    machine reset(subject: &mut T) {
        set(&mut subject, 1);
    }
}

trait RightReset<T> {
    machine set(subject: &mut T, value: i32);

    machine reset(subject: &mut T) {
        set(&mut subject, 2);
    }
}

trait ResolvedCounter<T>: LeftReset<T> + RightReset<T> {
}

data RequiredValue {
    value: i32;
}

RequiredValueCounter satisfies RequiredCounter<RequiredValue> {
    Resettable::set = RequiredValue::set;
}

machine RequiredValue::set(required_value: &mut RequiredValue, value: i32) {
    required_value.value = value;
}

data ParentValue {
    value: i32;
}

ParentValueCounter satisfies ParentCounter<ParentValue> {
    Resettable::set = ParentValue::set;
}

machine ParentValue::set(parent_value: &mut ParentValue, value: i32) {
    parent_value.value = value;
}

data ResolvedValue {
    value: i32;
}

ResolvedValueCounter satisfies ResolvedCounter<ResolvedValue> {
    LeftReset::set = ResolvedValue::set;
    RightReset::set = ResolvedValue::set;
    LeftReset::reset = ResolvedValue::reset;
    RightReset::reset = ResolvedValue::reset;
}

machine ResolvedValue::set(resolved_value: &mut ResolvedValue, value: i32) {
    resolved_value.value = value;
}

machine ResolvedValue::reset(resolved_value: &mut ResolvedValue) {
    ResolvedValue::set(resolved_value, 10);
}

data Main {
    required_value: RequiredValue;
    parent_value: ParentValue;
    resolved_value: ResolvedValue;
}

machine Main::main(main: &mut Main) reaches Console {
    RequiredValueCounter::reset(&mut main.required_value);
    ParentValueCounter::reset(&mut main.parent_value);
    ResolvedValue::reset(&mut main.resolved_value);
    transition main.required_value.value == 30
        && main.parent_value.value == 30
        && main.resolved_value.value == 10 {
        true -> done(main)
        _ -> refused(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state refused(main: &mut Main) {
        Console::exit_process(71);
    }
}
