// RUN CANARY (exit 70): SINGLE-REQUIREMENT trait conformance (rearrange
// settle 2026-07-18, rung A). The settled CommutativeSemiring surface:
// FREE-machine-shaped requirements (`machine add(a: Self, b: Self) -> Self;`
// -- no Self::), a LAW requirement carrying `ensures`, and machine-by-machine
// conformance: `satisfies Trait::requirement` binds THIS machine to that one
// slot (Self binds the carrier from the satisfier's signature), and
// `satisfies Trait::requirement as Alias` names the satisfier (plural
// algebras -- Nat under (max, add) is the tropical semiring). TWO carriers
// conform: proof-only Peano (the Nat stratum shape -- compile surface only,
// no runtime layout) and RUNTIME i32 (Self binds a primitive), whose
// satisfiers actually run: add32(2, 1) == 3, exit 70.
// Loud-edge siblings: fail/traits/ring_requirement_unknown_rejected,
// ring_requirement_signature_rejected, free_machine_bare_satisfies_rejected.
use omega_language_std::console;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

trait RingOps {
    machine add(a: Self, b: Self) -> Self;
    machine mul(a: Self, b: Self) -> Self;
    machine add_comm(a: Self, b: Self)
    ensures add(a, b) == add(b, a);
}

machine add(a: Peano, b: Peano) -> Peano
satisfies RingOps::add
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: add(pred, b) }
    }
}

machine mul(a: Peano, b: Peano) -> Peano
satisfies RingOps::mul as Standard
terminates by a;
{
    transition a {
        Peano::Zero -> Peano::Zero
        Peano::Succ { pred } -> (add(b, mul(pred, b)))
    }
}

// The RUNTIME carrier: i32 conforms the same slots (Self binds a primitive).
machine add32(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping
satisfies RingOps::add
{
    a + b
}

machine mul32(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping
satisfies RingOps::mul as Standard32
{
    a * b
}

data Main { console: Console; }
machine Main::main(&mut self) {
    let s: i32 in Wrapping = add32(2, 1);
    let p: i32 in Wrapping = mul32(s, 2);
    transition p == 6 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
