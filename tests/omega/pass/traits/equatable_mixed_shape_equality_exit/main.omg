// Equatable over a MIXED data shape (frozen decisions 7 + 11): synthesized
// structural equality is common fields AND tag AND matching payload. Two
// values equal in case, payload, AND common field must compare equal; then
// reconstructing one side WITHOUT naming `consumed` zero-initializes it
// (construction's zero-unless-named rule), so the same case and payload must
// now compare UNEQUAL through the common field alone. Exits 70 only when
// both compares are right. Also the regression net for the boolean-folding
// factor/distribute mutual recursion this shape first exposed.

use omega_language_std::console;

data RoomEvent {
    consumed: bool;
    case Nothing;
    case Treasure(gold: i32);
}

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

RoomEventEquality satisfies Equatable<RoomEvent> { }

data Main {
    left: RoomEvent;
    right: RoomEvent;
}

machine Main::main(main: &mut Main) reaches Console {
    main.left = RoomEvent::Treasure { consumed: true, gold: 5 };
    main.right = RoomEvent::Treasure { consumed: true, gold: 5 };
    let equal: bool = main.left == main.right;
    transition equal {
        false -> bad(main)
        true -> diverge(main)
    }

    state diverge(main: &mut Main) {
        // Same case and payload, different COMMON field: must compare unequal.
        main.right = RoomEvent::Treasure { gold: 5 };
        let still_equal: bool = main.left == main.right;
        transition still_equal {
            true -> bad(main)
            false -> done(main)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
