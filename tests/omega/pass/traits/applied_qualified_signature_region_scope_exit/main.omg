domain<Tag> u64::Tagged<Tag>;

trait Reader<'storage, Tag> {
    machine read(value: &'storage u64 in Tagged<Tag>) -> u64;
}

machine read<'source>(value: &'source u64 in Tagged<u64>) -> u64
satisfies Reader<'source, u64>::read
{ value as u64 }

// Unused satisfaction still validates its complete applied signature.
machine main() {}
