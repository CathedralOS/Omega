// Proof identity remains compact and reflexive regardless of field geometry.
// It does not execute an equality algorithm for floats or nested fixed arrays.
// Each identity names the complete record through all of its declared fields.
data Empty {}
data Packet { elements: [[Empty; 1000000]; 1000000]; }
data Floats { values: [f64; 1]; }

machine compact(left: &Packet, right: &Packet)
crashes Abort core::Identity<Packet>(
    Packet { elements: left.elements },
    Packet { elements: right.elements }
) {}

machine reflexive(packet: &Floats)
crashes Abort core::Identity<Floats>(
    Floats { values: packet.values },
    Floats { values: packet.values }
) { crash Abort; }

machine reflexive_composition(packet: &Floats)
crashes Abort core::Identity<Floats>(
    Floats { values: packet.values },
    Floats { values: packet.values }
) && true { crash Abort; }

machine assumed(left: &Floats, right: &Floats)
requires core::Identity<Floats>(
    Floats { values: left.values },
    Floats { values: right.values }
)
crashes Abort core::Identity<Floats>(
    Floats { values: right.values },
    Floats { values: left.values }
) { crash Abort; }

machine main() {}

machine wrapped(left: &Floats, right: &Floats, condition: bool)
requires (condition && core::Identity<Floats>(
    Floats { values: left.values },
    Floats { values: right.values }
)) || (!condition && !core::Identity<Floats>(
    Floats { values: left.values },
    Floats { values: right.values }
))
crashes Abort (condition && core::Identity<Floats>(
    Floats { values: right.values },
    Floats { values: left.values }
)) || (!condition && !core::Identity<Floats>(
    Floats { values: right.values },
    Floats { values: left.values }
)) { crash Abort; }
