trait Setting { machine set(first: &mut u64, second: &mut u64, value: u64) ensures first == value; }
Correct satisfies Setting {
 machine set(destination: &mut u64, other: &mut u64, replacement: u64) ensures destination == replacement { destination = replacement; }
}
machine main() crashes Trap {
 let mut first: u64 = 1; let mut second: u64 = 2;
 Setting::set(Correct as dyn Setting, &mut first, &mut second, 7);
 transition first == 7 && second == 2 { true -> done() false -> bad() }
 state done() {} state bad() { crash Trap; }
}
