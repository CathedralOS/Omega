// A nominal machine binder inherits the exact trait requirement's contract.
// Its selected declaration names the subject, and the generic body passes it
// explicitly; requirement and satisfier share one named-parameter contract.
// Specialization selects Counter::increment without a runtime dictionary.
// Expected exit: 1.
use omega_language_std::console;
use omega::language::core::binding;

trait Incrementable {
    machine increment(subject: &mut Self);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: &mut Counter) satisfies Incrementable::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable: Counter satisfies Incrementable;

machine step<T, machine Increment>(subject: &mut T)
where machine Increment satisfies Incrementable::increment;
{
    Increment(subject);
}

data Main { console: Binding<Console>; counter: Counter; }

machine Main::main(main: &mut Main) reaches Console {
    step<Counter, Counter::increment>(&mut main.counter);
    main.console.exit_process(main.counter.value as i32);
}
