// A nominal machine binder inherits the exact trait requirement's contract.
// The binder's trait application names the data type, and the generic body
// passes the value explicitly; requirement and satisfier share one
// named-parameter contract.
// Specialization selects Counter::increment without a runtime dictionary.
// Expected exit: 1.
use omega_language_std::console;

trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: &mut Counter) satisfies Incrementable<Counter>::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable satisfies Incrementable<Counter> {
    Incrementable::increment = Counter::increment;
}

machine step<T, machine Increment>(subject: &mut T)
where machine Increment satisfies Incrementable<T>::increment;
{
    Increment(subject);
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) reaches Console {
    step<Counter, Counter::increment>(&mut main.counter);
    Console::exit_process(main.counter.value as i32);
}
