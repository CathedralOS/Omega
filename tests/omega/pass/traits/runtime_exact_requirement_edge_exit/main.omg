// A machine's exact satisfaction edge (`satisfies Incrementable<Counter>::increment`)
// corresponds to its requirement parameter by parameter, under the trait's
// explicit data argument
// ([machines](../../../../wiki/spec/language/machines.md#static-declarations-and-explicit-state):
// "Trait requirements and satisfiers use the same explicit parameter
// correspondence"). A named implementation binds that machine as its row, and
// a call through the implementation runs it.
//
// Exits 1: `increment` ran exactly once through `CounterIncrementable`.
use omega_language_std::console;

trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: &mut Counter) satisfies Incrementable<Counter>::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable satisfies Incrementable<Counter> {
    Incrementable::increment = Counter::increment;
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) reaches Console {
    CounterIncrementable::increment(&mut main.counter);
    Console::exit_process(main.counter.value as i32);
}
