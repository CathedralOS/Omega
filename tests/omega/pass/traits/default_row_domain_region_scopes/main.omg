// Equal erased domain operands retain each map-captured phantom region.
// The default's unused invocation binder remains independent of both.
domain<Tag> u64::Tagged<Tag>;
data Marker<'held> {}

trait Reader<First, Second> {
    machine read<'unused>(value: u64 in Tagged<First> & Tagged<Second>) -> u64 {
        value as u64
    }
}
Mapped<'left, 'right> satisfies Reader<Marker<'right>, Marker<'left>> {}

machine main() {}
