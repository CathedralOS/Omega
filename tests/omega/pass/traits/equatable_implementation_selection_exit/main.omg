// The sealed `==` route selects the one Equatable implementation whose trait
// argument is the operand type; the implementation, not the data type, owns
// the `equals` row. `Coin` has two implementations, so `==` on it would be
// ambiguous, yet a call through either implementation selects exactly its
// row: the synthesized structural row compares every field, the authored row
// only the value. A generic evidence binder selects the same rows. `Player`
// equality recurses into `Pos` through `Pos`'s own implementation. `Mark`
// fills its row with a reference to an ordinary machine, which `==` then
// calls. The same rows also run inside one compound transition guard, on
// either side of `&&`, as a call argument and through an evidence binder's
// own guard: an implementation name qualifies its row and is never a
// runtime receiver. Exits 70 only when every face agrees.

use omega_language_std::console;

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Coin {
    value: i32;
    year: i32;
}

CoinEquality satisfies Equatable<Coin> { }

CoinValueEquality satisfies Equatable<Coin> {
    machine equals(left: &Coin, right: &Coin) -> bool {
        left.value == right.value
    }
}

machine equal<T, Equality satisfies Equatable<T>>(left: &T, right: &T) -> bool {
    Equality::equals(left, right)
}

machine agree<T, Equality satisfies Equatable<T>>(left: &T, right: &T, other: &T) -> bool {
    transition Equality::equals(left, right) && !Equality::equals(left, other) {
        true -> true
        _ -> false
    }
}

machine accept(value: bool) -> bool {
    value
}

data Pos {
    x: i32;
    y: i32;
}

PosEquality satisfies Equatable<Pos> { }

data Player {
    pos: Pos;
    health: i32;
}

PlayerEquality satisfies Equatable<Player> { }

data Mark {
    x: i32;
    y: i32;
}

machine marks_share_x(left: &Mark, right: &Mark) -> bool {
    left.x == right.x
}

MarkByX satisfies Equatable<Mark> {
    Equatable::equals = marks_share_x;
}

data Main {
    old_coin: Coin;
    new_coin: Coin;
    player: Player;
    moved: Player;
    first_mark: Mark;
    second_mark: Mark;
}

machine Main::main(main: &mut Main) reaches Console {
    main.old_coin = Coin { value: 5, year: 1990 };
    main.new_coin = Coin { value: 5, year: 2001 };
    let structural: bool = CoinEquality::equals(&main.old_coin, &main.new_coin);

    transition structural {
        false -> check_value(main)
        _ -> missed(main)
    }

    state check_value(main: &mut Main) {
        let by_value: bool = CoinValueEquality::equals(&main.old_coin, &main.new_coin);

        transition by_value {
            true -> check_binder_structural(main)
            _ -> missed(main)
        }
    }

    state check_binder_structural(main: &mut Main) {
        let structural: bool = equal<Coin, CoinEquality>(&main.old_coin, &main.new_coin);

        transition structural {
            false -> check_binder_value(main)
            _ -> missed(main)
        }
    }

    state check_binder_value(main: &mut Main) {
        let by_value: bool = equal<Coin, CoinValueEquality>(&main.old_coin, &main.new_coin);

        transition by_value {
            true -> check_nested(main)
            _ -> missed(main)
        }
    }

    state check_nested(main: &mut Main) {
        main.player = Player { pos: Pos { x: 1, y: 2 }, health: 9 };
        main.moved = Player { pos: Pos { x: 1, y: 3 }, health: 9 };
        let moved: bool = main.player != main.moved;

        transition moved {
            true -> check_nested_call(main)
            _ -> missed(main)
        }
    }

    state check_nested_call(main: &mut Main) {
        main.moved.pos.y = 2;
        let same: bool = PlayerEquality::equals(&main.player, &main.moved);

        transition same {
            true -> check_reference_row(main)
            _ -> missed(main)
        }
    }

    state check_reference_row(main: &mut Main) {
        main.first_mark = Mark { x: 4, y: 1 };
        main.second_mark = Mark { x: 4, y: 8 };
        let same_x: bool = main.first_mark == main.second_mark;

        transition same_x {
            true -> check_guard_rows(main)
            _ -> missed(main)
        }
    }

    state check_guard_rows(main: &mut Main) {
        transition main.first_mark == main.second_mark
            && CoinValueEquality::equals(&main.old_coin, &main.new_coin)
            && !CoinEquality::equals(&main.old_coin, &main.new_coin)
            && accept(PlayerEquality::equals(&main.player, &main.moved))
            && agree<Coin, CoinValueEquality>(&main.old_coin, &main.new_coin, &main.old_coin) == false {
            true -> matched(main)
            _ -> missed(main)
        }
    }

    state matched(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
