// A literal selection of a const-only finite-family method keeps its declaring roster and returns the selected row's value.
// Expected exit: 0
// Place: local.
public trait Family {
    machine row<const Width: u32, const Lanes: u32>() -> u32 requires Width == 16 && Lanes == 1 || Width == 32 && Lanes == 2;
}
Selected satisfies Family {
    machine row<const Width: u32, const Lanes: u32>() -> u32 requires Width == 16 && Lanes == 1 || Width == 32 && Lanes == 2 { Width }
}
Other satisfies Family {
    machine row<const Width: u32, const Lanes: u32>() -> u32
    requires Width == 16 && Lanes == 1 || Width == 32 && Lanes == 2 {
        transition Width == 16 { true -> 17 false -> 33 }
    }
}
machine selected_width(selection: dyn Family) -> u32 { Family::row<16, 1>(selection) }

trait RuntimeFamily {
    machine row<Width: u32, Lanes: u32>(selected: dyn Family) -> u32
    requires Width == 16 && Lanes == 1 || Width == 32 && Lanes == 2;
}
BridgeToConst satisfies RuntimeFamily {
    machine row<Width: u32, Lanes: u32>(selected: dyn Family) -> u32
    requires Width == 16 && Lanes == 1 || Width == 32 && Lanes == 2 {
        static_forward<Width + 0, Lanes>(selected)
    }
}
public machine static_forward<const Width: u32, const Lanes: u32>(selected: dyn Family) -> u32
requires Width == 16 && Lanes == 1 || Width == 32 && Lanes == 2 {
    Family::row<Width, Lanes>(selected)
}
machine selected_runtime_width(selected: dyn Family, width: u32, lanes: u32) -> u32
requires width == 16 && lanes == 1 || width == 32 && lanes == 2 {
    RuntimeFamily::row<width, lanes>(BridgeToConst as dyn RuntimeFamily, selected)
}
machine exercise_runtime_width(width: u32, lanes: u32, expected_selected: u32, expected_other: u32) crashes Trap
requires width == 16 && lanes == 1 || width == 32 && lanes == 2 {
    let first: u32 = selected_runtime_width(Selected as dyn Family, width, lanes);
    let second: u32 = selected_runtime_width(Other as dyn Family, width, lanes);
    transition first == expected_selected && second == expected_other {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    exercise_runtime_width(16, 1, 16, 17);
    exercise_runtime_width(32, 2, 32, 33);
    let selected: dyn Family = Selected as dyn Family;
    let other: dyn Family = Other as dyn Family;
    let first: u32 = selected_width(selected);
    let second: u32 = selected_width(other);
    transition first == 16 && second == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
