machine build(builder: &mut Build) {
    Build::application(builder, "requirement_evidence_regions");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::accept_boundary<SelectedReading>(builder);
    Build::select_provider<SelectedReading, SelectedReader>(builder, windows_x86_64);
    Build::select_provider<SelectedReading, SelectedReader>(builder, linux_x86_64);
    Build::select_provider<SelectedReading, SelectedReader>(builder, macos_arm64);
    Build::select_provider<SelectedReading, SelectedReader>(builder, linux_arm64);
}
