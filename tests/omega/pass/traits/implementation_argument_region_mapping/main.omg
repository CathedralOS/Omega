// The inherited trait's region is the caller's explicit actual, not the
// similarly spelled region belonging to a separate trait declaration.
data View<'storage> { reference: &'storage i32; }
trait Reading<Value> { machine read(value: Value) -> Value; }
SelectedReading<Value> satisfies Reading<Value> {
    machine read(value: Value) -> Value { value }
}
trait Uses<'required, Reader satisfies Reading<View<'required> > > {}
trait Inherited<'actual>:
    Uses<'actual, SelectedReading<View<'actual> > > {}

machine main() {}

// Requirement invocation regions and captured trait regions keep distinct owners.
data Phantom<Contract> {}
trait Inspect<'captured> {
    machine inspect<'local>(
        local: Phantom<Uses<'local, SelectedReading<View<'local> > > >,
        captured: Phantom<Uses<'captured, SelectedReading<View<'captured> > > >
    );
}
