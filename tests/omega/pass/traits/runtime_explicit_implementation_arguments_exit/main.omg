// Mixed trait arguments keep their categories and positions. The selected
// generic maps supply both an owned structural value and an observable const.
trait Reading<Value> {
    machine read(value: Value) -> Value;
    machine tag() -> i32;
}

SelectedReading<Value, const Tag: i32> satisfies Reading<Value> {
    machine read(value: Value) -> Value { value }
    machine tag() -> i32 { Tag }
}

trait Consumer<Value, Reader satisfies Reading<Value>, Result> {
    machine read(value: Value) -> Value;
    machine tag() -> i32;
    machine echo(value: Result) -> Result;
}

machine forward<Value, Reader satisfies Reading<Value>>(value: Value) -> Value {
    Reading::read<Value, Reader>(value)
}

ConsumerMap<Value, Result, const Tag: i32>
satisfies Consumer<Value, SelectedReading<Value, Tag>, Result> {
    machine read(value: Value) -> Value {
        forward<Value, SelectedReading<Value, Tag>>(value)
    }
    machine tag() -> i32 { Reading::tag<Value, SelectedReading<Value, Tag>>() }
    machine echo(value: Result) -> Result { value }
}

data Packet<Item> { value: Item; }

machine main() crashes Trap {
    let first: Packet<i32> = Consumer::read<
        Packet<i32>, SelectedReading<Packet<i32>, 7>, i32, ConsumerMap<Packet<i32>, i32, 7>
    >(Packet { value: 41 });
    let first_tag: i32 = Consumer::tag<
        Packet<i32>, SelectedReading<Packet<i32>, 7>, i32, ConsumerMap<Packet<i32>, i32, 7>
    >();
    let echoed: i32 = Consumer::echo<
        Packet<i32>, SelectedReading<Packet<i32>, 7>, i32, ConsumerMap<Packet<i32>, i32, 7>
    >(53);
    let second: Packet<i32> = Consumer::read<
        Packet<i32>, SelectedReading<Packet<i32>, 19>, bool, ConsumerMap<Packet<i32>, bool, 19>
    >(Packet { value: 73 });
    let second_tag: i32 = Consumer::tag<
        Packet<i32>, SelectedReading<Packet<i32>, 19>, bool, ConsumerMap<Packet<i32>, bool, 19>
    >();
    let second_echo: bool = Consumer::echo<
        Packet<i32>, SelectedReading<Packet<i32>, 19>, bool, ConsumerMap<Packet<i32>, bool, 19>
    >(true);
    transition first.value == 41 && first_tag == 7 && echoed == 53
        && second.value == 73 && second_tag == 19 && second_echo {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
