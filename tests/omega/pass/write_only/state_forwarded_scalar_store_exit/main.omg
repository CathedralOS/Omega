use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    value: i32;
    neighbor: i32;
}

machine replace(destination: &write i32, value: i32) {
    destination = value;
}

machine forward(destination: &write i32, value: i32) {
    transition { _ -> write_value(&write destination, value) }

    state write_value(destination: &write i32, value: i32) {
        replace(&write destination, value);
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.value = 7;
    main.neighbor = 19;
    forward(&write main.value, 42);
    transition main.value == 42 && main.neighbor == 19 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
