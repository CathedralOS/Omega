use omega_language_std::console;

data Main {
    value: i32;
    neighbor: i32;
}

machine replace(destination: &write i32, value: i32) {
    destination = value;
}

machine forward(destination: &write i32, value: i32) {
    transition { _ -> write_value(&write destination, value) }

    machine write_value(destination: &write i32, value: i32) {
        replace(&write destination, value);
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.value = 7;
    main.neighbor = 19;
    forward(&write main.value, 42);
    transition main.value == 42 && main.neighbor == 19 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
