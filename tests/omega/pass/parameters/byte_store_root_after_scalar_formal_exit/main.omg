// RUN CANARY (exit 70). A byte store names its borrowed destination by
// authored parameter position. Both helpers below put the scalar `index`
// before their destination `target`, so `target` is authored position 2 but
// the second borrowed parameter, and `after` is the third. Each store must
// replace one byte of `target` and leave `before` and `after` as they were.
//
// `replace` is an ordinary machine body. A byte-field byte store that read
// authored position 2 as a dense index among the borrowed parameters would
// write `after` instead (exit 71). `put` is a state graph, whose byte-view
// write resolves its root through the state's own parameters. Any other
// outcome exits 72.
use omega_language_std::console;

domain [u8; 3]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Cell {
    text: [u8; 3] in Utf8;
}

data Main {
    before: Cell;
    target: Cell;
    after: Cell;
    view_before: [u8; 2];
    view_target: [u8; 2];
    view_after: [u8; 2];
}

machine replace(before: &mut Cell, index: u64, target: &mut Cell, after: &mut Cell) requires index <= 2 {
    before.text = "AAA";
    target.text = "BBB";
    after.text = "CCC";
    target.text[index] = 90;
}

machine put(before: &mut [u8], index: u64, target: &mut [u8], after: &mut [u8]) {
    transition index < target.len {
        true -> store(before, index, target, after)
        _ -> skip()
    }

    machine store(before: &mut [u8], index: u64, target: &mut [u8], after: &mut [u8]) {
        target[index] = 9;
    }

    machine skip() {}
}

machine Main::main(main: &mut Main) reaches Console {
    replace(&mut main.before, 1, &mut main.target, &mut main.after);
    put(&mut main.view_before, 1, &mut main.view_target, &mut main.view_after);
    transition main.target.text == "BZB"
        && main.before.text == "AAA"
        && main.after.text == "CCC"
        && main.view_target[1] == 9
        && main.view_before[1] == 0
        && main.view_after[1] == 0 {
        true -> good(main)
        _ -> wrong(main)
    }

    machine wrong(main: &mut Main) {
        transition main.after.text == "CZC" {
            true -> wrote_after(main)
            _ -> other(main)
        }
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine wrote_after(main: &mut Main) { Console::exit_process(71); }
    machine other(main: &mut Main) { Console::exit_process(72); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
