// The guarded-COPY narrowing (keystone catalog item): an UNRANGED `yv` copied
// into a ranged target under a dominating edge guard. `transition self.yv >= 0
// && self.yv <= 9 { true -> store() }` establishes [0..=9] for the copy
// `self.y = self.yv` -- the checker used to bail before consulting the guard
// because the value had no declared range (guards could only REFINE an
// existing range, never establish one). yv=7 -> exit 7.
use omega::language::std::console;

data Main {
    console: Console;
    yv: i32;
    y: i32 [0..=9];
}

machine Main::main(&mut self) {
    self.yv = 7;
    transition self.yv >= 0 && self.yv <= 9 {
        true -> store()
        false -> bad()
    }

    state store(&mut self) {
        self.y = self.yv;
        transition self.y == 7 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(7); }
    state unmatched(&mut self) { self.console.exit_process(0); }
    state bad(&mut self) { self.console.exit_process(8); }
}
