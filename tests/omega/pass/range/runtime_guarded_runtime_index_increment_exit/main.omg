// The RUNTIME-index guarded element increment: `tallies[main.k]` is hoisted to
// the local `t`, the guard `t < 16` admits it to `bump`'s bounded contract,
// and `tallies[ki] = v + 1` is exact under `v < 16`. The revoked element
// suffix `[i32 [0..=16]; 4]` and index suffix `k: u64 [0..=3]` moved to plain
// carriers plus `bump`'s requires: `v < 16` is the increment bound, `ki < 4`
// is the index bound (`main.k`'s literal 2 discharges it at the edge).
// Requires admission matches the guard on the hoisted LOCAL rather than the
// indexed path, so the operand-hoist rename no longer participates.
// ZII tallies[2]=0 -> +1 -> exit 1.
use omega_language_std::console;
data Main {
    tallies: [i32; 4];
    k: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.k = 2;
    let t: i32 = main.tallies[main.k];
    transition t < 16 {
        true -> bump(main, t)
        false -> full(main)
    }
    state bump(main: &mut Main, v: i32) requires v < 16, main.k < 4 {
        main.tallies[main.k] = v + 1;
        transition main.tallies[2] == 1 {
            true -> matched(main)
            false -> unmatched(main)
        }
    }
    state matched(main: &mut Main) { Console::exit_process(1); }
    state unmatched(main: &mut Main) { Console::exit_process(9); }
    state full(main: &mut Main) { Console::exit_process(8); }
}
