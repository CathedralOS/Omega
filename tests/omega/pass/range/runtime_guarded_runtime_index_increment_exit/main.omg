// The RUNTIME-index guarded element increment: `tallies[self.k] < 16` proves
// `tallies[self.k] = tallies[self.k] + 1` into `[i32 [0..=16]; 4]`. Both sides
// of the proof are DE-HOISTED: the operand hoist renames the element read
// (`__hoist_N + 1`) and the indexed GUARD SUBJECT is frontend-hoisted to a
// boolean local in the SOURCE state (`transition __hoist_M {..}`), so the
// obligation resolves each through its state's call-free initializers before
// the structural match. The stability gate re-collects read paths from the
// de-hoisted operands (collection + index), so a k-reassignment or an
// intervening collection write still drops the fact (fail twins).
// ZII tallies[2]=0 -> +1 -> exit 1.
use omega_language_std::console;
data Main {
    console: Console;
    tallies: [i32 [0..=16]; 4];
    k: u64 [0..=3];
}
machine Main::main(&mut self) {
    self.k = 2;
    transition self.tallies[self.k] < 16 {
        true -> bump()
        false -> full()
    }
    state bump(&mut self) {
        self.tallies[self.k] = self.tallies[self.k] + 1;
        transition self.tallies[2] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
