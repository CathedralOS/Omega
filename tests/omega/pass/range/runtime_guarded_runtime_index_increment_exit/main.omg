// Expected exit: 1
// ZII tallies[2] is incremented to1 under the saved element guard. The owner
// retains all four signed0..16 element predicates and its standing k<=3 bound;
// bump's admission carries both bounds on the detached scalar across the call.
use omega_language_std::console;
data Main
requires self.tallies[0] >= 0 && self.tallies[0] <= 16,
    self.tallies[1] >= 0 && self.tallies[1] <= 16,
    self.tallies[2] >= 0 && self.tallies[2] <= 16,
    self.tallies[3] >= 0 && self.tallies[3] <= 16,
    self.k <= 3
{
    tallies: [i32; 4];
    k: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.k = 2;
    let t: i32 = main.tallies[main.k];
    transition t < 16 {
        true -> bump(main, t)
        false -> full(main)
    }
    machine bump(main: &mut Main, v: i32) requires v >= 0 && v < 16 {
        main.tallies[main.k] = v + 1;
        transition main.tallies[2] == 1 {
            true -> matched(main)
            false -> unmatched(main)
        }
    }
    machine matched(main: &mut Main) { Console::exit_process(1); }
    machine unmatched(main: &mut Main) { Console::exit_process(9); }
    machine full(main: &mut Main) { Console::exit_process(8); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
