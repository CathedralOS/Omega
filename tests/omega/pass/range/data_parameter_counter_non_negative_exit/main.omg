// A monotone counter lives in explicitly borrowed data across state edges.
// Its initial zero and increment establish the lower bound without an authored
// nonnegative guard. Index proofs must follow each block's parameter identity.
// The final observed element is 11, which is also the expected exit code.
use omega_language_std::console;
data Main {
    nums: [i32; 2];
    i: i32;
    last: i32;
}
machine Main::main(main: &mut Main) reaches Console {
    main.nums[0] = 7;
    main.nums[1] = 11;
    main.i = 0;
    main.last = 0;
    transition {
        _ -> step(main)
    }
    state step(main: &mut Main) {
        transition main.i < 2 {
            true -> add(main)
            _ -> done(main)
        }
    }
    state add(main: &mut Main) {
        main.last = main.nums[main.i];
        main.i = main.i + 1;
        transition {
            _ -> step(main)
        }
    }
    state done(main: &mut Main) {
        Console::exit_process(main.last);
    }
}
