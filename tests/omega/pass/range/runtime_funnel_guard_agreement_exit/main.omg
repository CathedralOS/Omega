// Both guarded entries to push must justify storing sp in the bounded y field.
// The entry requirement carries the guard; the data predicate keeps the field's
// original 0..=15 restriction after the store. Expected exit: 7.
use omega_language_std::Console;

data Main requires y >= 0 && y <= 15 {
    sp: i32;
    y: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.sp = 7;
    transition main.sp >= 0 && main.sp < 16 {
        true -> push(main)
        false -> bad(main)
    }

    machine other(main: &mut Main) {
        transition main.sp >= 0 && main.sp < 16 {
            true -> push(main)
            false -> bad(main)
        }
    }

    machine push(main: &mut Main) requires main.sp >= 0 && main.sp < 16 {
        main.y = main.sp;
        transition main.y == 7 {
            true -> matched(main)
            false -> unmatched(main)
        }
    }
    machine matched(main: &mut Main) { Console::exit_process(7); }
    machine unmatched(main: &mut Main) { Console::exit_process(0); }
    machine bad(main: &mut Main) { Console::exit_process(8); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
