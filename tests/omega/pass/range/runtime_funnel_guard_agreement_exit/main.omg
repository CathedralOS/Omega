// MULTI-predecessor edge agreement (the last keystone catalog item): TWO
// states funnel into `push` under STRUCTURALLY IDENTICAL guards `sp >= 0 &&
// sp < 16`, and each edge admits `push(main.sp)` against
// `requires 0 <= v && v < 16`. Two fixes compose: the proof side's
// guard-equivalence walker gained literal LEAF arms (identical guards from
// different statements used to compare `false` at `(Integer(0),
// Integer(0))`), and validation joins ALL incoming edge envs per-place
// (interval union). The revoked `y: i32 [0..=15]` field suffix moved to
// `push`'s requires, the checked admission boundary. sp=7 -> exit 7.
use omega_language_std::console;

data Main {
    sp: i32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.sp = 7;
    transition main.sp >= 0 && main.sp < 16 {
        true -> push(main)
        false -> bad(main)
    }

    state other(main: &mut Main) {
        transition main.sp >= 0 && main.sp < 16 {
            true -> push(main)
            false -> bad(main)
        }
    }

    state push(main: &mut Main) requires main.sp >= 0 && main.sp < 16 {
        let mut y: i32 = main.sp;
        transition y == 7 {
            true -> matched(main)
            false -> unmatched(main)
        }
    }
    state matched(main: &mut Main) { Console::exit_process(7); }
    state unmatched(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(8); }
}
