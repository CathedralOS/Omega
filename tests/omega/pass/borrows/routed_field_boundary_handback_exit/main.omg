// Expected exit: 0. A normal exclusive return restores the field's declared
// routed membership, not the payload that occupied it before the call.
data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue(number: u64) -> Ticket in Issued { Ticket { number: number } }
data Holder { ticket: Ticket in Issued; counter: u64; }
boundary trait Change { machine replace(holder: &mut Holder) -> u64 reaches; }
Changer satisfies Change {
    machine replace(holder: &mut Holder) -> u64 {
        holder.ticket = issue(43);
        holder.counter = 11;
        1
    }
}
machine read(ticket: &Ticket in Issued) -> u64 { ticket.number }
machine main() crashes Trap reaches Change {
    let mut holder: Holder = Holder { ticket: issue(17), counter: 0 };
    let status: u64 = Change::replace(&mut holder);
    let observed: u64 = read(&holder.ticket);
    transition status == 1 && observed == 43 && holder.counter == 11 {
        true -> done()
        _ -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
