// Expected exit: 0. Temporary slice descriptors retire without their backing.
data Buffer { bytes: [u8; 8]; status: i32; }
machine fill(bytes: &mut [u8]) -> i32 requires bytes.len >= 1 { bytes[0] = 7; 0 }
machine probe(buffer: &mut Buffer) -> bool {
    buffer.status = fill(&mut buffer.bytes);
    buffer.status == 0 && buffer.bytes[0] == 7
}
machine main() crashes Trap {
    let mut buffer: Buffer;
    let observed: bool = probe(&mut buffer);
    let mut bytes: [u8; 8];
    let status: i32 = fill(&mut bytes);
    transition observed && status == 0 && bytes[0] == 7 {
        true -> done()
        false -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
