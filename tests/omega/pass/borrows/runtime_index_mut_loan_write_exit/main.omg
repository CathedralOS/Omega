// A bounded runtime-index loan writes invocation-local backing. The explicit
// index stays an ordinary parameter; the guard establishes its bounds without
// a scalar range suffix or persistent scratch fields.
// exits: 0 = the write reached the element; 1 = it did not.

use omega_language_std::console;
use omega::language::core::binding;

machine stamp(buffer: &mut [u8; 48], offset: u32) {
    transition offset < 48 {
        true -> write(buffer, offset)
        false -> done()
    }

    state write(buffer: &mut [u8; 48], offset: u32) requires offset < 48 {
        let borrowed: &mut u8 = &mut buffer[offset];
        borrowed = 9;
    }

    state done() {}
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut buffer: [u8; 48];
    stamp(&mut buffer, 0);
    stamp(&mut buffer, 47);
    stamp(&mut buffer, 48);
    transition buffer[0] == 9 && buffer[47] == 9 && buffer[1] == 0 {
        true -> done(&main.console)
        false -> bad(&main.console)
    }

    state done(console: &Binding<Console>) { Console::exit_process(console, 0); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 1); }
}
