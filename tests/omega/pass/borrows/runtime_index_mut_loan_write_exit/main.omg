// Use-through of a bounded runtime-index `&mut` loan: `borrowed = 9` writes
// `self.buf[self.off]` through the loan, keeping its RuntimeIndex segment,
// and the indexed read sees the stored byte.
// exits: 0 = the write reached the element; 1 = it did not.

use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
    off: u32 [0..=47];
}

machine Main::main(main: &mut Main) reaches Console {
    main.off = 0;
    let borrowed: &mut u8 = &mut main.buf[main.off];
    borrowed = 9;
    transition main.buf[main.off] == 9 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        main.console.exit_process(0);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(1);
    }
}
