data Token { value: i32; }
data Reply { case Missing; case Present(value: Token); }

machine make(value: i32) -> Token { Token { value: value } }
machine reply(present: bool) -> Reply {
    transition present {
        true -> (Reply::Present { value: Token { value: 42 } })
        false -> (Reply::Missing)
    }
}
machine choose(present: bool) -> bool {
    // Local establishment, successor arguments and state declarations have
    // distinct orders. Disposal follows the current state declarations.
    let last: Token = make(44);
    let first: Token = make(40);
    let response: Reply = reply(present);
    transition { _ -> inspect(response, 42, first, true, last) }
    machine inspect(response: Reply, expected: i32, first: Token, enabled: bool, last: Token) -> bool {
        transition response {
            Reply::Present { value } -> observe(last, first, value, expected, enabled)
            _ -> (false)
        }
    }
    machine observe(last: Token, first: Token, value: Token, expected: i32, enabled: bool) -> bool {
        enabled && last.value == 44 && first.value == 40 && value.value == expected
    }
}
machine main() crashes Trap {
    let forwarded: bool = choose(true);
    let discarded: bool = choose(false);
    transition forwarded && !discarded {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
