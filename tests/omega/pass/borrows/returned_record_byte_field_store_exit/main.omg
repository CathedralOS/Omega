use omega_language_std::console;

domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
data Holder { text: [u8; 16] in Utf8; sibling: u64; }
data Bag { holders: [Holder; 2]; }
data Main { bag: Bag; }

machine pick(bag: &mut Bag) -> &mut Holder {
    let holders: &mut [Holder] = &mut bag.holders[..];
    transition { _ -> &mut holders[1] }
}

machine label(short: bool) -> [u8; 16] in Utf8 {
    transition short { true -> "Gate" false -> "Branch Room" }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[0].text = "Neighbor";
    let selected: &mut Holder = pick(&mut main.bag);
    selected.text = label(false);
    selected.text = label(true);
    selected.sibling = 29;
    transition main.bag.holders[1].text == "Gate"
        && main.bag.holders[1].text.len == 4
        && main.bag.holders[1].sibling == 29
        && main.bag.holders[0].text == "Neighbor" {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
