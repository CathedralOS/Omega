// Reference access is admitted at the declared field, independent of its shell.
data MutableRecord { bytes: &mut [u8]; }
data MutableChoice { case Writable(bytes: &mut [u8]); }
data SharedRecord { bytes: &[u8]; }
data SharedChoice { case Readable(bytes: &[u8]); }
data Nested { choice: MutableChoice; }
data OwnedRecord { bytes: [u8; 3]; }
data OwnedChoice { case Copied(bytes: [u8; 3]); }

machine mutable_record(bytes: &mut [u8]) { inspect_mutable_record(MutableRecord { bytes: bytes }); }
machine mutable_case(bytes: &mut [u8]) { inspect_mutable_case(MutableChoice::Writable { bytes: bytes }); }
machine mutable_to_shared(bytes: &mut [u8]) { inspect_shared_record(SharedRecord { bytes: bytes }); }
machine nested_case(bytes: &mut [u8]) { inspect_nested(Nested { choice: MutableChoice::Writable { bytes: bytes } }); }
machine explicit_mutable_case(bytes: &mut [u8]) { inspect_mutable_case(MutableChoice::Writable { bytes: &mut bytes[0..0] }); }
machine shared_record() { inspect_shared_record(SharedRecord { bytes: "abc" }); }
machine shared_case() { inspect_shared_case(SharedChoice::Readable { bytes: "abc" }); }
machine owned_record() { inspect_owned_record(OwnedRecord { bytes: "abc" }); }
machine owned_case() { inspect_owned_case(OwnedChoice::Copied { bytes: "abc" }); }

machine inspect_mutable_record(value: MutableRecord) {}
machine inspect_mutable_case(value: MutableChoice) {}
machine inspect_shared_record(value: SharedRecord) {}
machine inspect_shared_case(value: SharedChoice) {}
machine inspect_owned_record(value: OwnedRecord) {}
machine inspect_owned_case(value: OwnedChoice) {}

machine inspect_nested(value: Nested) {}

// An immutable owned binding may carry an exclusive reference; its slot is not the referent.
machine owned_container(value: MutableRecord) { inspect_mutable_case(MutableChoice::Writable { bytes: value.bytes }); }
machine owned_container_shared(value: MutableRecord) { inspect_shared_record(SharedRecord { bytes: value.bytes }); }

// Reborrowing its mutable leaf does not mutate the immutable owned container.
machine owned_container_reborrow(value: MutableRecord) { inspect_mutable_case(MutableChoice::Writable { bytes: &mut value.bytes }); }
data ScalarBorrow { value: &mut u8; }
machine mutable_root_scalar(value: &mut u8) { inspect_scalar(ScalarBorrow { value: &mut value }); }
machine mutable_root_element(bytes: &mut [u8; 1]) { inspect_scalar(ScalarBorrow { value: &mut bytes[0] }); }
machine mutable_call_result(value: &mut u8) { inspect_scalar(ScalarBorrow { value: forward(value) }); }
machine forward(value: &mut u8) -> &mut u8 { value }
machine inspect_scalar(value: ScalarBorrow) {}

// Owned local contents are borrowable; replacing their binding is separate.
machine owned_local_direct() { let value: u8 = 0; inspect_reference(&mut value); }
machine owned_local_record() { let value: u8 = 0; inspect_scalar(ScalarBorrow { value: &mut value }); }
data ScalarChoice { case Lent(value: &mut u8); }
machine owned_local_case() { let value: u8 = 0; inspect_scalar_choice(ScalarChoice::Lent { value: &mut value }); }
machine inspect_reference(value: &mut u8) {}
machine inspect_scalar_choice(value: ScalarChoice) {}
