machine build(builder: &mut Build) {
    Build::application(builder, "carried_field_replacement");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<HostedRestoration, HostedRestorationBody>(builder, windows_x86_64);
    Build::select_provider<HostedRestoration, HostedRestorationBody>(builder, linux_x86_64);
    Build::select_provider<HostedRestoration, HostedRestorationBody>(builder, macos_arm64);
    Build::select_provider<HostedRestoration, HostedRestorationBody>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
