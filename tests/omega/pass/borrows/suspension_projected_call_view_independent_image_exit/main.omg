// Expected exit: 0
// A helper selects the first byte of a returned image-backed window.
machine window() -> &[u8] { &"123456789"[1..8] }
machine first(source: &[u8]) -> &u8
requires source.len > 0
{ &source[0] }
machine main() crashes Trap {
    let selected: &[u8] = window();
    let fallback: u8 = 0;
    let saved: &u8 = match selected.len > 0 {
        true -> first(selected)
        _ -> &fallback
    };
    let observed: u8 = saved;
    transition observed == 50 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
