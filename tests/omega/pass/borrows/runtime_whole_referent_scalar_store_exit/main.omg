// Whole-referent replacement of a scalar through `&mut`, from a state that
// received the loan as a block parameter. exits: 70 = the store reached
// the caller; 71 = it did not.

use omega_language_std::console;

data Main {
    count: u64;
}

machine publish(count: &mut u64, at: u64) {
    transition at > 0 && at < 1000 {
        true -> store(count, at)
        _ -> store(count, 1)
    }

    state store(count: &mut u64, at: u64) requires at < 1000 {
        count = at + 2;
    }
}

machine Main::main(main: &mut Main) reaches Console {
    publish(&mut main.count, 11);
    transition main.count == 13 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
