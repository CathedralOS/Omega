// Whole-referent replacement of a scalar through `&mut`, from a state that
// received the loan as a block parameter. exits: 70 = the store reached
// the caller; 71 = it did not.

use omega_language_std::console;

data Main {
    count: u64;
}

machine publish(count: &mut u64, at: u64) {
    transition at > 0 && at < 1000 {
        true -> store(count, at)
        _ -> store(count, 1)
    }

    machine store(count: &mut u64, at: u64) requires at < 1000 {
        count = at + 2;
    }
}

machine Main::main(main: &mut Main) reaches Console {
    publish(&mut main.count, 11);
    transition main.count == 13 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
