// Expected exit: 0. Selected reborrow formation leaves both parent descriptors usable after the child ends.
data Cell { value: u32; }

machine exercise(choose: bool) -> bool {
    let mut first: Cell = Cell { value: 7 };
    let mut second: Cell = Cell { value: 9 };
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let selected: &mut Cell = match choose {
        true -> &mut first_parent,
        false -> &mut second_parent
    };
    selected.value = 11;
    let observed: u32 = selected.value;
    observed == 11 && first_parent.value == (match choose { true -> 11, false -> 7 })
        && second_parent.value == (match choose { true -> 9, false -> 11 })
}

machine main() crashes Trap {
    let first: bool = exercise(true);
    let second: bool = exercise(false);
    transition first && second {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
