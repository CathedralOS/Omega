// Read through a shared descriptor and referent with nonzero field offsets.
use omega_language_std::console;

data Cell { prefix: i32; value: i32 [0..=100]; ready: bool; }
data Message { stamp: i32; body: &Cell; }
data Main { cell: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.prefix = 29;
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { stamp: 11, body: &main.cell };
    let observed: i32 [0..=100] = message.body.value;
    let ready: bool = message.body.ready;
    let stamp: i32 = message.stamp;
    main.cell.value = 81;
    transition observed == 70 && ready && stamp == 11 && main.cell.value == 81 && main.cell.prefix == 29 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
