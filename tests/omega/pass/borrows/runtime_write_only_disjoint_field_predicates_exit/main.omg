// Parent predicates constrain siblings, not either selected write-only place.
data Row where position <= 1 { values: [i64; 2]; position: u64; }
data Main where phase <= 1 { row: Row; phase: u64; }

machine replace(values: &write [i64; 2], position: u64)
requires position < 2
{
    transition { _ -> store(&write values, position) }
    state store(values: &write [i64; 2], position: u64)
    requires position < 2
    {
        values[position] = -17;
    }
}

machine capture(row: &mut Row) {
    let selected: &write [i64; 2] = &write row.values;
    replace(&write selected, row.position);
}

machine Main::main(main: &mut Main) crashes Trap {
    main.row.values[0] = 85;
    main.row.values[1] = 29;
    main.row.position = 1;
    main.phase = 1;
    replace(&write main.row.values, main.row.position);
    main.row.values[1] = 29;
    capture(&mut main.row);
    transition main.row.values[0] == 85 && main.row.values[1] == -17
        && main.row.position == 1 && main.phase == 1 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
