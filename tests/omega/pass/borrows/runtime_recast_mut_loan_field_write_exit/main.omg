// A member write through a recast `as &mut T` loan of owned bytes lands in the
// original storage: `borrowed.tag = 9` writes the first byte of `main.buf`,
// and the caller observes it after the loan ends.
use omega_language_std::console;

data Desc {
    tag: u32;
}

data Main {
    buf: [u8; 48];
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &mut Desc = &mut main.buf[0] as &mut Desc;
    borrowed.tag = 9;
    transition main.buf[0] == 9 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
