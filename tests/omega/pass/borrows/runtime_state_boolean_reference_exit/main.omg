// Boolean observations read the returned carrier across a state hop.
use omega_language_std::console;

data Main { ready: bool; neighbor: bool; }

machine Main::selected(main: &Main) -> &bool {
    transition { _ -> observe(main) }
    machine observe(owner: &Main) -> &bool { &owner.ready }
}

machine Main::main(main: &mut Main) reaches Console {
    main.ready = true;
    main.neighbor = false;
    let selected: &bool = Main::selected(main);
    transition selected && !main.neighbor {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
