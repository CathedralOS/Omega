// Boolean observations read the returned carrier across a state hop.
use omega_language_std::console;

data Main { ready: bool; neighbor: bool; }

machine Main::selected(main: &Main) -> &bool {
    transition { _ -> observe(main) }
    state observe(owner: &Main) -> &bool { &owner.ready }
}

machine Main::main(main: &mut Main) reaches Console {
    main.ready = true;
    main.neighbor = false;
    let selected: &bool = Main::selected(main);
    transition selected && !main.neighbor {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
