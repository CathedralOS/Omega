// A scalar-returning helper forms stored loans of two distinct bool locals.
// Each observation follows its backing, including when their values reverse.
data Flags<'storage> { current: &'storage bool; opposite: &'storage bool; }

machine observe(initial: bool) -> bool {
    let current: bool = initial;
    let opposite: bool = !initial;
    let flags: Flags = Flags { current: &current, opposite: &opposite };
    flags.current == initial && flags.opposite != initial
}

machine main() crashes Trap {
    transition observe(true) && observe(false) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
