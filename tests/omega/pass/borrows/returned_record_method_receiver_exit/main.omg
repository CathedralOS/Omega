use omega_language_std::console;

data Child { value: u64; }
data Holder { child: Child; sibling: u64; }
data Bag { holders: [Holder; 2]; }
data Main { bag: Bag; }

machine pick(bag: &mut Bag) -> &mut Holder {
    let holders: &mut [Holder] = &mut bag.holders[..];
    transition { _ -> &mut holders[1] }
}

machine Holder::replace(holder: &mut Holder) { holder.child.value = 41; }

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[0].child.value = 17;
    let selected: &mut Holder = pick(&mut main.bag);
    selected.sibling = 29;
    Holder::replace(selected);
    selected.sibling = 31;
    transition main.bag.holders[1].child.value == 41
        && main.bag.holders[1].sibling == 31
        && main.bag.holders[0].child.value == 17 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
