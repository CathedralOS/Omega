// Attribution control: the same descriptor replacement without match capture.
// Expected exit: 0
data Cell { value: i32; }
data Message<'storage> { body: &'storage mut Cell; }
data Carrier<'carrier, 'storage> { message: &'carrier mut Message<'storage>; }
machine replace<'carrier, 'storage>(carrier: Carrier<'carrier, 'storage>, incoming: &'storage mut Cell) -> bool {
    carrier.message.body = incoming;
    true
}
machine store(target: &mut Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine exercise() -> bool {
    let mut original: Cell = Cell { value: 17 };
    let mut incoming: Cell = Cell { value: 19 };
    let spare: Cell = Cell { value: 7 };
    let mut message: Message = Message { body: &mut original };
    let replaced: bool = replace(Carrier { message: &mut message }, &mut incoming);
    let written: bool = store(&mut message.body, 41);
    replaced && written && original.value == 17 && incoming.value == 41 && spare.value == 7
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
