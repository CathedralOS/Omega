// Shared borrow of a record referent returned at a transition tail.
use omega_language_std::console;

data Node {
    value: i32;
    tag: i32;
}

data Holder { node: Node; }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let holder: Holder = Holder { node: Node { value: 7, tag: 3 } };
    let seen: &Node = Holder::first(&holder);
    transition seen.value == 7 { true -> done() _ -> bad() }

    state done() {
        Console::exit_process(181);
    }

    state bad() {
        Console::exit_process(71);
    }
}

machine Holder::first(holder: &Holder) -> &Node {
    transition {
        _ -> &holder.node
    }
}
