// A `&mut [Room]` view of records whose `label` field is declared `in Utf8`,
// forwarded whole to a machine. The callee's parameter owes each element's
// label membership; a loan lends the storage itself, so the call site's
// facts, where the view's element memberships live, are its evidence.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Room [copy] { label: [u8; 8] in Utf8; value: u64; }
data Main { console: Binding<Console>; rooms: [Room; 3]; }

machine visit(rooms: &mut [Room], index: u64) -> u64
requires index < rooms.len
{
    rooms[index].value = 70;
    transition { _ -> (rooms[index].value) }
}

machine Main::main(main: &mut Main) reaches Console {
    main.rooms[0].label = "hall";
    main.rooms[1].label = "vault";
    main.rooms[1].value = 66;
    let rooms: &mut [Room] = main.rooms.as_mut_slice();
    let visited: u64 = visit(rooms, 1);
    transition visited == 70 && main.rooms[1].label == "vault" {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { main.console.exit_process(70); }
    state missed(main: &mut Main) { main.console.exit_process(71); }
}
