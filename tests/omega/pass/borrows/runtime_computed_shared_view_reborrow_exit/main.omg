// The selected source provider returns the actual descriptor and original
// backing loan, not a length-only signature result or a builtin substitution.
pub boundary trait Window {
    machine middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    requires start <= end && end <= bytes.len;
}

WindowProvider satisfies Window {
    Window::middle = middle_window;
}

machine middle_window(bytes: &[u8], start: u64, end: u64) -> &[u8]
requires start <= end && end <= bytes.len {
    bytes[start..end]
}

machine choose(bytes: &[u8], selected: bool) -> &[u8] reaches Window
requires bytes.len >= 3 {
    match selected {
        true -> &Window::middle(bytes, 1, 3),
        false -> bytes
    }
}

data Main { bytes: [u8; 4]; }

machine Main::main(main: &mut Main) reaches Window crashes Trap {
    main.bytes[1] = 70;
    // Reborrowing the returned descriptor must not reconstruct a whole view
    // from its original backing. Selection also retains the producer's arm.
    let middle: &[u8] = &Window::middle(&main.bytes, 1, 3);
    let selected: &[u8] = &choose(&main.bytes, true);
    let skipped: &[u8] = &choose(&main.bytes, false);
    transition middle.len == 2 && middle[0] == 70
        && selected.len == 2 && skipped.len == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
