data Window { }
data WindowBody { }

boundary requirement Window::middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
requires start <= end && end <= bytes.len;

machine WindowBody::middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    satisfies Window::middle
requires start <= end && end <= bytes.len {
    bytes[start..end]
}

machine choose(bytes: &[u8], selected: bool) -> &[u8]
requires bytes.len >= 3 {
    match selected {
        true -> &Window::middle(bytes, 1, 3),
        false -> bytes
    }
}

data Main { bytes: [u8; 4]; }

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[1] = 70;
    // Reborrowing the returned descriptor must not reconstruct a whole view
    // from its original backing. Selection also retains the producer's arm.
    let middle: &[u8] = &Window::middle(&main.bytes, 1, 3);
    let selected: &[u8] = &choose(&main.bytes, true);
    let skipped: &[u8] = &choose(&main.bytes, false);
    transition middle.len == 2 && middle[0] == 70
        && selected.len == 2 && skipped.len == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
