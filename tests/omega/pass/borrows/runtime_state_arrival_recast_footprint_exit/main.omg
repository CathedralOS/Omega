// Expected exit: 0. Byte-region views keep backing across state arrivals.
data Word { value: u64; }
data Storage { bytes: [u8; 8]; }
machine through_parameter(bytes: &[u8; 8]) -> u64 {
 let view: &Word = &bytes[0] as &Word;
 transition { _ -> read(view) }
 machine read(view: &Word) -> u64 { view.value }
}
machine through_field(storage: &Storage) -> u64 {
 let view: &Word = &storage.bytes[0] as &Word;
 transition { _ -> read(view) }
 machine read(view: &Word) -> u64 { view.value }
}
machine through_local() -> u64 {
 let bytes: [u8; 8] = [37, 0, 0, 0, 0, 0, 0, 0];
 let view: &Word = &bytes[0] as &Word;
 transition { _ -> read(view) }
 machine read(view: &Word) -> u64 { view.value }
}
machine main() crashes Trap {
 let storage: Storage = Storage { bytes: [37, 0, 0, 0, 0, 0, 0, 0] };
 let parameter_value: u64 = through_parameter(&storage.bytes);
 let field_value: u64 = through_field(&storage);
 let local_value: u64 = through_local();
 transition parameter_value == 37 && field_value == 37 && local_value == 37 {
  true -> done()
  false -> bad()
 }
 machine done() {}
 machine bad() { crash Trap; }
}
