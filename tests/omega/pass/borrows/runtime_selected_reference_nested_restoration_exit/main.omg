data Main { first: i64; second: i64; }
machine choose<'storage>(first: &'storage mut i64, second: &'storage mut i64, choose_second: bool) -> &'storage mut i64 {
    transition choose_second {
        true -> second
        _ -> first
    }
}
machine update(first: &mut i64, second: &mut i64, choose_second: bool) -> bool {
    let first_parent: &mut i64 = &mut first;
    let second_parent: &mut i64 = &mut second;
    let selected: &mut i64 = choose(first_parent, second_parent, choose_second);
    let nested: &mut i64 = &mut selected;
    nested = 127;
    first_parent == 11 && second_parent == 127
}
machine keep_first<'storage>(first: &'storage mut i64, second: &'storage mut i64) -> &'storage mut i64 {
    first
}
machine update_declared_union(first: &mut i64, second: &mut i64) -> bool {
    let first_parent: &mut i64 = &mut first;
    let second_parent: &mut i64 = &mut second;
    let selected: &mut i64 = keep_first(first_parent, second_parent);
    selected = 13;
    // The declared lifetime retains both inputs even with only one return arm.
    first_parent == 13 && second_parent == 127
}
machine Main::main(main: &mut Main) crashes Trap {
    main.first = 11;
    main.second = 22;
    let restored: bool = update(&mut main.first, &mut main.second, true);
    let declared_restored: bool = update_declared_union(&mut main.first, &mut main.second);
    transition restored && declared_restored && main.first == 13 && main.second == 127 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
