use omega_language_std::console;

data Holder { value: u64; sibling: u64; observed_before: u64; }
data Bag { holders: [Holder; 3]; }
data Main { bag: Bag; }

machine pick(bag: &mut Bag, second: bool) -> &mut Holder {
    let holders: &mut [Holder] = &mut bag.holders[..];
    transition second {
        true -> &mut holders[1]
        false -> &mut holders[0]
    }
}

machine Holder::replace(holder: &mut Holder, value: u64) {
    holder.observed_before = holder.sibling;
    holder.value = value;
}

machine Main::replace_selected(main: &mut Main, second: bool, value: u64) {
    let selected: &mut Holder = pick(&mut main.bag, second);
    selected.sibling = 29;
    Holder::replace(selected, value);
    selected.sibling = 31;
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[2].value = 17;
    Main::replace_selected(main, true, 41);
    Main::replace_selected(main, false, 43);
    transition main.bag.holders[0].value == 43
        && main.bag.holders[1].value == 41
        && main.bag.holders[0].sibling == 31
        && main.bag.holders[1].sibling == 31
        && main.bag.holders[0].observed_before == 29
        && main.bag.holders[1].observed_before == 29
        && main.bag.holders[2].value == 17 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
