// One aggregate may hold exclusive loans of disjoint places: two distinct
// fields in a record literal, and two distinct literal indexes in an array.
use omega_language_std::console;

data Cell { stamp: i32; value: i32 [0..=100]; }
data Pair<'a> { left: &'a mut Cell; right: &'a mut Cell; }
data Main {
    first: Cell;
    second: Cell;
    cells: [Cell; 2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.second.stamp = 5;
    main.second.value = 70;
    main.cells[0].stamp = 7;
    main.cells[0].value = 20;
    main.cells[1].stamp = 9;
    main.cells[1].value = 50;
    let pair: Pair = Pair { left: &mut main.first, right: &mut main.second };
    let row: [&mut Cell; 2] = [&mut main.cells[0], &mut main.cells[1]];
    let right: i32 [0..=100] = pair.right.value;
    let last: i32 [0..=100] = row[1].value;
    transition right == 70 && last == 50 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
