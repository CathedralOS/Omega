// Reborrows observe the returned descriptor, including after its source is
// rebound. The contract uses a callee telescope unrelated to the caller's.
use omega::language::core::slice;

machine middle<Element>(items: &[Element], start: u64, end: u64) -> &[Element]
requires start <= end && end <= items.len
ensures result.len == end - start {
    items[start..end]
}
machine observe(tag: u64, items: &[u8]) -> u64
requires items.len >= 1 {
    items.len
}
machine main() crashes Trap {
    let bytes: [u8; 4] = [10, 70, 42, 1];
    let values: [i32; 3] = [11, 123, 0];
    let mut source: &[u8] = &bytes;
    let saved: &[u8] = middle(source, 1, 3);
    let local: &[u8] = &saved;
    let computed: &[u8] = &middle(&bytes, 1, 3);
    let nested: &[u8] = &middle(middle(&bytes, 1, 4), 1, 2);
    let words: &[i32] = &middle(&values, 1, 3);
    let count: u64 = observe(5, local);
    source = &bytes[0..1];
    let same: bool = local == computed;
    transition same && local.len == 2 && local[0] == 70 && computed.len == 2
        && computed[1] == 42 && nested.len == 1 && nested[0] == 42
        && words.len == 2 && words[0] == 123 && count == 2 {
        true -> done() _ -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
