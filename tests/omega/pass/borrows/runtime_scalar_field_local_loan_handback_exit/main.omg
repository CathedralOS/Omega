data Main where position <= 1 { position: u64; }
machine replace(position: &mut u64)
requires position <= 1
ensures position <= 1
{
    // The arrival bound is not a store-enforced type. Restore it at handback.
    position = 2;
    position = 0;
}
machine Main::main(main: &mut Main) crashes Trap {
    main.position = 1;
    let selected: &mut u64 = &mut main.position;
    replace(&mut selected);
    transition main.position == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
