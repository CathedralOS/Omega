// A borrowed-parameter lifetime forwarded to the result:
// `combine<'destination>(... destination: &'destination mut Cell)
// -> &'destination mut Cell` returns the passed loan so the caller
// keeps writing through it; eight shared `&Cell` operands fold into
// the write.
data Cell [copy] { value: u64; stamp: u64; }
machine combine<'destination>(
    first: &Cell,
    second: &Cell,
    destination: &'destination mut Cell
) -> &'destination mut Cell {
    destination.value = first.value | second.value;
    destination.stamp = 91;
    destination
}
data Main {
    cells: [Cell; 3];
}
machine Main::main(main: &mut Main) {
    main.cells[0].value = 2;
    main.cells[1].value = 4;
    let selected: &mut Cell = combine(&main.cells[0], &main.cells[1], &mut main.cells[2]);
    let reported: u64 = selected.value;
}
