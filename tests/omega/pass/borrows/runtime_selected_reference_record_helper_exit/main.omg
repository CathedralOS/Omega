use omega_language_std::console;

data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; stamp: i32; }
data Envelope<'storage> { held: Held<'storage>; seal: i32; }
data Pair<'first, 'second> { left: Held<'first>; right: Held<'second>; }
data Main { first: Cell; second: Cell; third: Cell; fourth: Cell; }

machine select<'storage>(first: &'storage Cell, second: &'storage Cell, selected: bool) -> Held<'storage> {
    match selected {
        true -> Held { target: first, stamp: 12 },
        false -> Held { target: second, stamp: 13 }
    }
}

machine select_field<'storage>(first: &'storage Cell, second: &'storage Cell, selected: bool) -> Held<'storage> {
    Held {
        target: match selected { true -> first, false -> second },
        stamp: match selected { true -> 12, false -> 13 }
    }
}

machine select_first<'first, 'second>(selected: bool, first: &'first Cell, second: &'second Cell) -> Held<'first> {
    match selected {
        true -> Held { target: first, stamp: 12 },
        false -> Held { target: first, stamp: 13 }
    }
}

machine forward<'storage>(first: &'storage Cell, second: &'storage Cell, selected: bool) -> Held<'storage> {
    transition { _ -> choose(first, second, selected) }
    state choose(first: &'storage Cell, second: &'storage Cell, selected: bool) -> Held<'storage> {
        select_field(first, second, selected)
    }
}

machine verify(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let held: Held = select(&first_parent, &second_parent, selected);
    let observed: i32 = held.target.value;
    first.value = 51;
    second.value = 83;
    let stamp: i32 = held.stamp;
    observed == (match selected { true -> 41, false -> 73 }) &&
        stamp == (match selected { true -> 12, false -> 13 }) &&
        first.value == 51 && second.value == 83
}

machine verify_forwarded(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let held: Held = forward(&first_parent, &second_parent, selected);
    let copied: &Cell = held.target;
    let original: i32 = held.target.value;
    let observed: i32 = copied.value;
    first.value = 51;
    second.value = 83;
    let stamp: i32 = held.stamp;
    original == (match selected { true -> 41, false -> 73 }) && observed == original &&
        stamp == (match selected { true -> 12, false -> 13 }) &&
        first.value == 51 && second.value == 83
}

machine verify_named_lifetime(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let held: Held = select_first(selected, &first, &second);
    second.value = 83;
    let observed: i32 = held.target.value;
    first.value = 51;
    observed == 41 && first.value == 51 && second.value == 83
}

machine verify_nested(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let envelope: Envelope = Envelope {
        held: select(&first_parent, &second_parent, selected), seal: 17
    };
    let observed: i32 = envelope.held.target.value;
    first.value = 51;
    second.value = 83;
    let stamp: i32 = envelope.held.stamp;
    observed == (match selected { true -> 41, false -> 73 }) &&
        stamp == (match selected { true -> 12, false -> 13 }) &&
        envelope.seal == 17 && first.value == 51 && second.value == 83
}

machine pair<'first, 'second>(first: &'first Cell, second: &'second Cell) -> Pair<'first, 'second> {
    Pair {
        left: Held { target: first, stamp: 12 },
        right: Held { target: second, stamp: 13 }
    }
}

machine select_owned<'storage>(first: Held<'storage>, second: Held<'storage>, selected: bool) -> Held<'storage> {
    match selected { true -> first, false -> second }
}

machine verify_owned(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let envelope: Envelope = Envelope {
        held: select_owned(relay_owned(first_input), relay_owned(second_input), selected), seal: 17
    };
    let observed: i32 = envelope.held.target.value;
    first.value = 51;
    second.value = 83;
    observed == (match selected { true -> 41, false -> 73 }) &&
        envelope.held.stamp == (match selected { true -> 12, false -> 13 }) &&
        envelope.seal == 17 && first.value == 51 && second.value == 83
}

machine relay_owned<'storage>(input: Held<'storage>) -> Held<'storage> { input }

machine verify_owned_operands(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let received: Held = select_owned(relay_owned(first_input), relay_owned(second_input), selected);
    let envelope: Envelope = Envelope { held: received, seal: 17 };
    let observed: i32 = envelope.held.target.value;
    first.value = 51;
    second.value = 83;
    observed == (match selected { true -> 41, false -> 73 }) &&
        envelope.held.stamp == (match selected { true -> 12, false -> 13 }) &&
        envelope.seal == 17 && first.value == 51 && second.value == 83
}

machine verify_replacement(first: &mut Cell, second: &mut Cell) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let mut held: Held = first_input;
    held = second_input;
    first.value = 51;
    let observed: i32 = held.target.value;
    second.value = 83;
    observed == 73 && held.stamp == 13 && first.value == 51 && second.value == 83
}

machine verify_fresh_replacement(first: &mut Cell, second: &mut Cell) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let mut held: Held = first_input;
    held = Held { target: &second_parent, stamp: 13 };
    first.value = 51;
    let observed: i32 = held.target.value;
    second.value = 83;
    observed == 73 && held.stamp == 13 && first.value == 51 && second.value == 83
}

machine verify_refilled_occurrences(first: &mut Cell, second: &mut Cell, third: &mut Cell) -> bool {
    first.value = 41;
    second.value = 73;
    third.value = 89;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let third_parent: &mut Cell = &mut third;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let third_input: Held = Held { target: &third_parent, stamp: 14 };
    let mut held: Held = first_input;
    held = second_input;
    let saved: Held = held;
    held = third_input;
    let later: Held = held;
    first.value = 51;
    let earlier: i32 = saved.target.value;
    second.value = 83;
    // The later occurrence must not keep the saved occurrence's backing live.
    let observed: i32 = later.target.value;
    third.value = 99;
    earlier == 73 && observed == 89 && saved.stamp == 13 && later.stamp == 14
        && first.value == 51 && second.value == 83 && third.value == 99
}

machine verify_occupied_refill(first: &mut Cell, second: &mut Cell, third: &mut Cell, fourth: &mut Cell) -> bool {
    first.value = 41;
    second.value = 73;
    third.value = 89;
    fourth.value = 107;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let third_parent: &mut Cell = &mut third;
    let fourth_parent: &mut Cell = &mut fourth;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let third_input: Held = Held { target: &third_parent, stamp: 14 };
    let mut held: Held = first_input;
    held = second_input;
    let saved: Held = held;
    held = third_input;
    // This cleanup settles the occupied third occurrence, never saved's loan.
    held = Held { target: &fourth_parent, stamp: 15 };
    first.value = 51;
    third.value = 99;
    let earlier: i32 = saved.target.value;
    second.value = 83;
    let observed: i32 = held.target.value;
    fourth.value = 117;
    earlier == 73 && observed == 107 && saved.stamp == 13 && held.stamp == 15
        && first.value == 51 && second.value == 83 && third.value == 99 && fourth.value == 117
}

machine verify_selected_refill(first: &mut Cell, second: &mut Cell, third: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    third.value = 89;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let third_parent: &mut Cell = &mut third;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let third_input: Held = Held { target: &third_parent, stamp: 14 };
    let mut held: Held = first_input;
    let saved: Held = held;
    held = second_input;
    let chosen: Held = match selected { true -> held, false -> third_input };
    let earlier: i32 = saved.target.value;
    first.value = 51;
    let observed: i32 = chosen.target.value;
    second.value = 83;
    third.value = 99;
    earlier == 41 && observed == (match selected { true -> 73, false -> 89 })
        && saved.stamp == 12 && chosen.stamp == (match selected { true -> 13, false -> 14 })
        && first.value == 51 && second.value == 83 && third.value == 99
}

machine verify_refill_after_selection(first: &mut Cell, second: &mut Cell, third: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    third.value = 89;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let third_parent: &mut Cell = &mut third;
    // The replacement already exists before the selection consumes its sources.
    let third_input: Held = Held { target: &third_parent, stamp: 14 };
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let mut held: Held = first_input;
    let chosen: Held = match selected { true -> held, false -> second_input };
    held = third_input;
    let observed: i32 = chosen.target.value;
    first.value = 51;
    second.value = 83;
    let later: i32 = held.target.value;
    third.value = 99;
    observed == (match selected { true -> 41, false -> 73 }) && later == 89
        && chosen.stamp == (match selected { true -> 12, false -> 13 }) && held.stamp == 14
        && first.value == 51 && second.value == 83 && third.value == 99
}

machine verify_selected_copy(first: &mut Cell, second: &mut Cell, selected: bool) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let original: Held = Held { target: &first_parent, stamp: 12 };
    let copied: &Cell = original.target;
    let candidate: Held = Held { target: copied, stamp: 13 };
    let other: Held = Held { target: &second_parent, stamp: 14 };
    let chosen: Held = match selected { true -> candidate, false -> other };
    let observed: i32 = chosen.target.value;
    second.value = 83;
    // Retiring the selection does not consume the independently live supplier.
    let earlier: i32 = original.target.value;
    first.value = 51;
    observed == (match selected { true -> 41, false -> 73 }) && earlier == 41
        && original.stamp == 12 && chosen.stamp == (match selected { true -> 13, false -> 14 })
        && first.value == 51 && second.value == 83
}

machine verify_projected(first: &mut Cell, second: &mut Cell) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let held: Held = pair(&first_parent, &second_parent).left;
    second.value = 83;
    let observed: i32 = held.target.value;
    first.value = 51;
    observed == 41 && held.stamp == 12 && first.value == 51 && second.value == 83
}

machine verify_projected_right(first: &mut Cell, second: &mut Cell) -> bool {
    first.value = 41;
    second.value = 73;
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let held: Held = pair(&first_parent, &second_parent).right;
    first.value = 51;
    let observed: i32 = held.target.value;
    second.value = 83;
    observed == 73 && held.stamp == 13 && first.value == 51 && second.value == 83
}

machine Main::main(main: &mut Main) reaches Console {
    let first: bool = verify(&mut main.first, &mut main.second, true);
    let second: bool = verify(&mut main.first, &mut main.second, false);
    let third: bool = verify_forwarded(&mut main.first, &mut main.second, true);
    let fourth: bool = verify_forwarded(&mut main.first, &mut main.second, false);
    let fifth: bool = verify_named_lifetime(&mut main.first, &mut main.second, true);
    let sixth: bool = verify_named_lifetime(&mut main.first, &mut main.second, false);
    let seventh: bool = verify_nested(&mut main.first, &mut main.second, true);
    let eighth: bool = verify_nested(&mut main.first, &mut main.second, false);
    let ninth: bool = verify_projected(&mut main.first, &mut main.second);
    let tenth: bool = verify_projected_right(&mut main.first, &mut main.second);
    let eleventh: bool = verify_owned(&mut main.first, &mut main.second, true);
    let twelfth: bool = verify_owned(&mut main.first, &mut main.second, false);
    let thirteenth: bool = verify_owned_operands(&mut main.first, &mut main.second, true);
    let fourteenth: bool = verify_owned_operands(&mut main.first, &mut main.second, false);
    let fifteenth: bool = verify_replacement(&mut main.first, &mut main.second);
    let sixteenth: bool = verify_fresh_replacement(&mut main.first, &mut main.second);
    let seventeenth: bool = verify_refilled_occurrences(&mut main.first, &mut main.second, &mut main.third);
    let eighteenth: bool = verify_occupied_refill(&mut main.first, &mut main.second, &mut main.third, &mut main.fourth);
    let nineteenth: bool = verify_selected_refill(&mut main.first, &mut main.second, &mut main.third, true);
    let twentieth: bool = verify_selected_refill(&mut main.first, &mut main.second, &mut main.third, false);
    let twenty_first: bool = verify_selected_copy(&mut main.first, &mut main.second, true);
    let twenty_second: bool = verify_selected_copy(&mut main.first, &mut main.second, false);
    let twenty_third: bool = verify_refill_after_selection(&mut main.first, &mut main.second, &mut main.third, true);
    let twenty_fourth: bool = verify_refill_after_selection(&mut main.first, &mut main.second, &mut main.third, false);
    transition first && second && third && fourth && fifth && sixth && seventh && eighth && ninth && tenth && eleventh && twelfth && thirteenth && fourteenth && fifteenth && sixteenth && seventeenth && eighteenth && nineteenth && twentieth && twenty_first && twenty_second && twenty_third && twenty_fourth {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
