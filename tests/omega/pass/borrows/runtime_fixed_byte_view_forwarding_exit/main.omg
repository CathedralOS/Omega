machine observe(value: &[u8; 17]) -> bool { value[16] == 17u8 }

machine relay(value: &[u8; 17]) -> bool { observe(value) }

machine main() crashes Trap {
    let values: [u8; 17] = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8,
        10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8];
    let result: bool = relay(&values);
    transition result {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
