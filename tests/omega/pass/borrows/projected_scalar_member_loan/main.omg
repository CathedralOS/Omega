use omega_language_std::console;

data Main {
    tag: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.tag = 9;
    transition true { _ -> next(main, &main.tag) }

    state next(main: &mut Main, leaf: &u32) {
        transition leaf == 9 { true -> done(main) _ -> bad(main) }
    }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
