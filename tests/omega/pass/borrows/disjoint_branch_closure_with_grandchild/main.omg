data Cell { value: i32; }
data Main { cells: [Cell; 3]; }

machine observe(values: &[Cell]) {}

machine Main::update(main: &mut Main) {
    let parent: &mut [Cell] = &mut main.cells[..];
    let first: &mut Cell = &mut parent[0];
    let second: &mut Cell = &mut parent[1];
    let third: &mut Cell = &mut parent[2];
    let nested: &mut i32 = &mut second.value;
    first = Cell { value: 13 };
    nested = 17;
    third = Cell { value: 40 };
    observe(parent);
}

machine main() crashes Trap {
    let mut value: Main;
    Main::update(&mut value);
    transition value.cells[0].value == 13 && value.cells[1].value == 17 && value.cells[2].value == 40 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
