// Mechanical variants of `writeonly_record_field_store`: the write-only
// reference carrier is established from a nested field, from a state
// parameter in a later state, and inside a record field store that targets
// the referent's own nested record. Every `&write` carrier is an exclusive
// loan whose custody ends once, exactly like a `&mut` carrier's.
use omega_language_std::console;

data Inner {
    value: i32;
    tag: i32;
}

data Node {
    inner: Inner;
    count: i32;
}

data Main {
    node: Node;
}

machine Main::main(main: &mut Main) reaches Console {
    let r: &write Inner = &write main.node.inner;
    r.value = 7;
    r.tag = 3;
    transition main.node.inner.value == 7 { true -> later(main) _ -> bad(main) }

    state later(main: &mut Main) {
        let n: &write Node = &write main.node;
        n.count = 11;
        n.inner.tag = 5;
        transition main.node.count == 11 && main.node.inner.tag == 5 { true -> done(main) _ -> bad(main) }
    }

    state done(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
