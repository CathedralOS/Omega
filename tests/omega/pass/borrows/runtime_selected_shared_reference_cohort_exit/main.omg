use omega_language_std::console;

data Cell { value: i32 [0..=100]; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Held { target: &Cell; stamp: i32; }
data Main { cell: Cell; }

machine verify(cell: &mut Cell, selected: bool) -> bool {
    cell.value = 70;
    cell.ready = true;
    let message: Message = Message { body: &mut cell, stamp: 11 };
    let child: &Cell = &message.body;
    let held: Held = match selected {
        true -> Held { target: child, stamp: 12 },
        false -> Held { target: child, stamp: 13 }
    };
    let observed: i32 [0..=100] = held.target.value;
    let ready: bool = held.target.ready;
    let original: i32 [0..=100] = child.value;
    cell.value = 81;
    let stamp: i32 = message.stamp;
    let held_stamp: i32 = held.stamp;
    observed == 70 && original == 70 && ready && stamp == 11 &&
        held_stamp == (match selected { true -> 12, false -> 13 }) && cell.value == 81
}

machine verify_original_first(cell: &mut Cell, selected: bool) -> bool {
    cell.value = 70;
    cell.ready = true;
    let message: Message = Message { body: &mut cell, stamp: 11 };
    let child: &Cell = &message.body;
    let duplicate: &Cell = child;
    let held: Held = match selected {
        true -> Held { target: child, stamp: 12 },
        false -> Held { target: child, stamp: 13 }
    };
    let original: i32 [0..=100] = child.value;
    let observed: i32 [0..=100] = held.target.value;
    let ready: bool = held.target.ready;
    let copied_observed: i32 [0..=100] = duplicate.value;
    cell.value = 81;
    let stamp: i32 = message.stamp;
    let held_stamp: i32 = held.stamp;
    observed == 70 && original == 70 && copied_observed == 70 && ready && stamp == 11 &&
        held_stamp == (match selected { true -> 12, false -> 13 }) && cell.value == 81
}

machine Main::main(main: &mut Main) reaches Console {
    let first: bool = verify(&mut main.cell, true);
    let second: bool = verify(&mut main.cell, false);
    let third: bool = verify_original_first(&mut main.cell, true);
    let fourth: bool = verify_original_first(&mut main.cell, false);
    transition first && second && third && fourth {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(0); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
