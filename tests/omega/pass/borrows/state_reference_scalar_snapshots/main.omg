// Expected exit: 0.
data Control { count: i32; observed: i32; }
data Carrier { body: &mut Control; }
machine snapshot(control: &mut Control) -> i32 {
    transition { _ -> done(control, control.count) }
    state done(control: &mut Control, value: i32) -> i32 {
        control.count = 9;
        transition { _ -> value }
    }
}
machine Control::main(control: &mut Control) crashes Trap {
    control.count = 4;
    let observed: i32 = snapshot(&mut control);
    control.observed = observed;
    transition control.count == 9 && control.observed == 4 { true -> variants(control) _ -> bad() }
    state variants(control: &mut Control) {
        control.count = 5;
        let first: i32 = local_snapshot(&mut control);
        control.count = 6;
        let second: i32 = field_snapshot(&mut control);
        control.count = 7;
        let third: i32 = result_snapshot(&mut control);
        control.count = 8;
        let fourth: i32 = owned_field_snapshot(&mut control);
        control.count = 9;
        let fifth: i32 = borrowed_field_snapshot(&mut control);
        control.observed = third;
        transition first == 5 && second == 6 && third == 7 && fourth == 8 && fifth == 9 && control.count == 14 { true -> {} _ -> bad() }
    }
    state bad() { crash Trap; }
}

machine local_snapshot(control: &mut Control) -> i32 {
    let reference: &mut Control = &mut control;
    transition { _ -> done(reference, reference.count) }
    state done(reference: &mut Control, value: i32) -> i32 { reference.count = 10; transition { _ -> value } }
}
machine field_snapshot(control: &mut Control) -> i32 {
    let carrier: Carrier = Carrier { body: &mut control };
    transition { _ -> done(carrier.body, carrier.body.count) }
    state done(reference: &mut Control, value: i32) -> i32 { reference.count = 11; transition { _ -> value } }
}
machine count(control: &Control) -> i32 { transition { _ -> control.count } }
machine identity(control: &mut Control) -> &mut Control { transition { _ -> control } }
machine result_snapshot(control: &mut Control) -> i32 {
    let reference: &mut Control = identity(&mut control);
    transition { _ -> done(count(reference), reference) }
    state done(value: i32, reference: &mut Control) -> i32 { reference.count = 12; transition { _ -> value } }
}

machine owned_field_snapshot(control: &mut Control) -> i32 {
    let carrier: Carrier = Carrier { body: &mut control };
    let result: i32 = owning_carrier(carrier);
    transition { _ -> result }
}
machine owning_carrier(carrier: Carrier) -> i32 {
    transition { _ -> done(carrier.body, carrier.body.count) }
    state done(reference: &mut Control, value: i32) -> i32 { reference.count = 13; transition { _ -> value } }
}
machine borrowed_field_snapshot(control: &mut Control) -> i32 {
    let mut carrier: Carrier = Carrier { body: &mut control };
    let result: i32 = borrowing_carrier(&mut carrier);
    transition { _ -> result }
}
machine borrowing_carrier(carrier: &mut Carrier) -> i32 {
    transition { _ -> done(carrier.body, carrier.body.count) }
    state done(reference: &mut Control, value: i32) -> i32 { reference.count = 14; transition { _ -> value } }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Control;
    Control::main(&mut entry_storage);
}
