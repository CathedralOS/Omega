// Every selected constructor transports the same child into its result leaf.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { value: i32; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Held { target: &Cell; stamp: i32; }
data Main { cell: Cell; }

machine verify(cell: &mut Cell, selected: bool) -> bool {
    cell.value = 70;
    cell.ready = true;
    let message: Message = Message { body: &mut cell, stamp: 11 };
    let child: &Cell = &message.body;
    let held: Held = match selected {
        true -> Held { target: child, stamp: 12 },
        false -> Held { target: child, stamp: 13 }
    };
    let observed: i32 = held.target.value;
    let ready: bool = held.target.ready;
    cell.value = 81;
    let stamp: i32 = message.stamp;
    let held_stamp: i32 = held.stamp;
    observed == 70 && ready && stamp == 11 &&
        held_stamp == (match selected { true -> 12, false -> 13 }) && cell.value == 81
}

machine Main::main(main: &mut Main) reaches Console {
    let first: bool = verify(&mut main.cell, true);
    let second: bool = verify(&mut main.cell, false);
    transition first && second {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(0); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
