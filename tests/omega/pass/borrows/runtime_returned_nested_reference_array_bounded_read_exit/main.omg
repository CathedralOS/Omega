// Nested returned arrays retain independent shared loans of repeated backing.
use omega_language_std::console;

data Cell { stamp: i32; value: i32 [0..=100]; ready: bool; }
data Pair { first: Cell; second: Cell; }
data Main {
    cells: Pair;
    index: u64 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells.first.stamp = 3;
    main.cells.first.value = 11;
    main.cells.first.ready = false;
    main.cells.second.stamp = 5;
    main.cells.second.value = 70;
    main.cells.second.ready = true;
    main.index = 1;
    let messages: [[&Cell; 2]; 2] = collect(&main.cells);
    let observed: i32 [0..=100] = messages[0][main.index].value;
    let ready: bool = messages[0][main.index].ready;
    transition observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

machine collect(source: &Pair) -> [[&Cell; 2]; 2] { [[&source.first, &source.second], [&source.second, &source.first]] }
