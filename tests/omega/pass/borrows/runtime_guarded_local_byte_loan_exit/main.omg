// A guarded edge loans whole byte storage, then two state edges forward it.
// Static geometry retains the backing; it needs no captured selector carrier.
// The same edge transfers the loan on either selected sum case. Exit 0.
data Selection { case First; case Second; }
machine main() crashes Trap {
    let bytes: [u8; 3] = "ABC";
    let selected: Selection = Selection::First;
    transition selected {
        Selection::First -> observe(&bytes)
        Selection::Second -> observe(&bytes)
    }
    state observe(bytes: &[u8; 3]) {
        let first: u8 = bytes[0];
        transition first == 65 && bytes[2] == 67 {
            true -> forward(bytes)
            _ -> bad()
        }
    }
    state forward(bytes: &[u8; 3]) {
        transition { _ -> verify(bytes) }
    }
    state verify(bytes: &[u8; 3]) {
        transition bytes[1] == 66 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
