use omega_language_std::console;

domain [u8; 2]::Utf8(bytes) requires valid_utf8(bytes);
data Text { bytes: [u8; 2] in Utf8; }
data Room { description: Text; samples: [u64; 2]; }
data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let room: Room = Room {
        description: Text { bytes: "é" }, samples: [17, 43]
    };
    transition room.description.bytes.len == 2 && room.description.bytes == "é"
        && room.samples.len == 2 && room.samples[1] == 43 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
