// Every selected return uses the replacement descriptor's backing and extent.
data Cell [copy] { value: i32; }
data Choice [copy] { case First; case Second; case Again; }
machine select(items: &mut [Cell; 3], choice: Choice) -> &mut Cell {
    let mut view: &mut [Cell] = &mut items[0..1];
    view = &mut items[1..3];
    transition choice {
        Choice::First -> &mut view[0]
        Choice::Second -> &mut view[1]
        Choice::Again -> &mut view[0]
    }
}
machine main() crashes Trap {
    let mut items: [Cell; 3] = [Cell { value: 11 }, Cell { value: 39 }, Cell { value: 13 }];
    let first: &mut Cell = select(&mut items, Choice::First);
    first.value = 27;
    let second: &mut Cell = select(&mut items, Choice::Second);
    second.value = 31;
    transition items[0].value == 11 && items[1].value == 27 && items[2].value == 31 {
        true -> done() _ -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
