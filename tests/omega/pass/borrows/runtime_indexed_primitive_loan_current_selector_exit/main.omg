// The established selector is read at formation, after its preceding assignment.
data Cell where value <= 1 { prefix: u64; value: u8; suffix: u32; }
data Main { cells: [Cell; 2]; }
machine read(value: &u8) -> u8 { value }
machine verify(value: &u8) crashes Trap {
    transition value == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine select(index: u64, main: &mut Main) -> u8 crashes Trap
requires index < 2
{
    let mut cursor: u64 = 0;
    cursor = index;
    let selected: &mut u8 = &mut main.cells[cursor].value;
    cursor = 0;
    verify(selected);
    read(selected)
}
machine Main::main(main: &mut Main) crashes Trap {
    main.cells[1].value = 1;
    main.cells[1].prefix = 54;
    main.cells[1].suffix = 77;
    let got: u8 = select(1, main);
    transition got == 1 && main.cells[0].value == 0
        && main.cells[1].prefix == 54 && main.cells[1].suffix == 77 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
