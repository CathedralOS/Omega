// Expected exit: 0
data View<'storage> { bytes: &'storage mut [u8]; }
machine edit(view: View) -> u64 requires view.bytes.len == 2 { view.bytes[0] = 71; view.bytes.len }
machine main() crashes Trap {
    let mut items: [u8; 2] = [7u8, 9u8];
    let length: u64 = edit(View { bytes: &mut items[..] });
    transition length == 2 && items[0] == 71 && items[1] == 9 {true -> done() false -> bad()}
    state done() {}
    state bad() { crash Trap; }
}
