// Expected exit: 0
machine window(source: &mut [u64]) -> &mut [u64]
requires source.len == 4 ensures result.len == 2
{ &mut source[1..3] }
machine main() crashes Trap {
    let mut items: [u64; 4] = [7, 8, 9, 10];
    let selected: &mut [u64] = &mut window(&mut items[..])[0..1];
    selected[0] = 41;
    transition items[0] == 7 && items[1] == 41 && items[2] == 9 && items[3] == 10 {
        true -> done() false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
