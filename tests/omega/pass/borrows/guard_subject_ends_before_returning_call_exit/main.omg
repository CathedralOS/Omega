// Expected exit: 0
// A saved case guard does not lend its subject to the selected returning call.
data Frame [copy] { case Empty; case Ready(value: u64); }
machine clear(frames: &mut [Frame; 4], position: u64) -> u64
requires position < 4 {
    frames[position] = Frame::Empty;
    0
}
machine inspect(frames: &mut [Frame; 4], position: u64) -> u64
requires position < 4 {
    transition frames[position] {
        Frame::Ready { value } -> (clear(frames, position))
        Frame::Empty -> (clear(frames, position))
    }
}
machine main() crashes Trap {
    let mut frames: [Frame; 4];
    frames[1] = Frame::Ready { value: 3 };
    let first: u64 = inspect(&mut frames, 1);
    let second: u64 = inspect(&mut frames, 1);
    transition first == 0 && second == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
