// Expected exit: 0. Executed field reads preserve independent arrival facts.
data Cell { value: u64; flag: bool; }

machine pick(cells: &[Cell; 2], second: bool) -> &Cell {
    transition second {
        true -> &cells[1]
        false -> &cells[0]
    }
}

machine inspect(cells: &[Cell; 2], second: bool, retry: u64) -> u64
requires addr::Bound == 18446744073709551616 && retry <= 1
{
    let selected: &Cell = pick(cells, second);
    transition selected.flag && selected.value > 0 {
        true -> finish(selected.value, retry)
        false -> finish(0, retry)
    }
    state finish(value: u64, retry: u64) -> u64
    requires addr::Bound == 18446744073709551616 && retry <= 1
    { value }
}

machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let cells: [Cell; 2] = [
        Cell { value: 19, flag: false },
        Cell { value: 42, flag: true }
    ];
    let first: u64 = inspect(&cells, false, 0);
    let second: u64 = inspect(&cells, true, 1);
    transition first == 0 && second == 42 { true -> done() false -> wrong() }
    state done() {}
    state wrong() { crash Trap; }
}
