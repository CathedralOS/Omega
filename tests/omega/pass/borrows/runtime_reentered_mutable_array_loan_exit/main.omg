// A machine that recurses through its entry with a mutable fixed-array loan
// rebinds the loan at the loop header on every iteration, as it does a
// record loan.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; values: [i32; 6]; }

machine countdown(values: &mut [i32; 6], position: u64) -> u64
terminates by position -> Nat::Descending;
requires position < 6
{
    values[position] = 10 + position as i32;
    transition position > 0 {
        true -> countdown(values, position - 1)
        _ -> (position)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let left: u64 = countdown(&mut main.values, 4);
    transition left == 0 && main.values[0] == 10 && main.values[4] == 14 && main.values[5] == 0 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { main.console.exit_process(70); }
    state missed(main: &mut Main) { main.console.exit_process(71); }
}
