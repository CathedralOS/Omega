// A machine that recurses through its entry with a mutable fixed-array loan
// rebinds the loan at the loop header on every iteration, as it does a
// record loan.
use omega_language_std::console;

data Main { values: [i32; 6]; }

machine countdown(values: &mut [i32; 6], position: u64) -> u64
terminates by position -> Nat::Descending;
requires position < 6
{
    values[position] = 10 + position as i32;
    transition position > 0 {
        true -> countdown(values, position - 1)
        _ -> (position)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let left: u64 = countdown(&mut main.values, 4);
    transition left == 0 && main.values[0] == 10 && main.values[4] == 14 && main.values[5] == 0 {
        true -> reached(main)
        _ -> missed(main)
    }
    machine reached(main: &mut Main) { Console::exit_process(70); }
    machine missed(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
