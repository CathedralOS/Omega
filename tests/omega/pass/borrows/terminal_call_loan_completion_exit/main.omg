// Expected exit: 0
// Terminal-arm completion retires temporary parent descriptors, not the
// descendant loan returned by the callee or named storage retaining it.
data Cell { value: u64; }
data Container { cell: Cell; }
data View<'backing> { cell: &'backing Cell; }

machine child<'backing>(cell: &'backing Cell) -> &'backing u64 { &cell.value }
machine selected_child<'backing>(container: &'backing Container,
                                 choose: bool) -> &'backing u64 {
    transition choose {
        true -> child(&container.cell)
        false -> child(&container.cell)
    }
}

machine stored<'storage, 'backing>(view: &'storage View<'backing>)
    -> &'storage View<'backing> { view }
machine selected_storage<'storage, 'backing>(view: &'storage View<'backing>,
                                            choose: bool) -> &'storage View<'backing> {
    transition choose {
        true -> stored(view)
        false -> stored(view)
    }
}

machine main() crashes Trap {
    let container: Container = Container { cell: Cell { value: 29 } };
    let first: &u64 = selected_child(&container, true);
    let second: &u64 = selected_child(&container, false);
    let view: View = View { cell: &container.cell };
    let stored_first: &View = selected_storage(&view, true);
    let stored_second: &View = selected_storage(&view, false);
    transition first == 29 && second == 29
        && stored_first.cell.value == 29 && stored_second.cell.value == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
