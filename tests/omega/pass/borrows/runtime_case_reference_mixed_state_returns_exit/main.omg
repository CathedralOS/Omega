// A returned variant carries the exclusive loan to its original backing; writing 41 through the active payload changes only that backing.
// A moved-return arm must not hide the constructed arm's distinct backing.
// Expected exit: 0
data Cell { value: i64; }
data Loan<'storage> { case Active(target: &'storage mut Cell); case Empty; }
machine lend<'storage>(source: &'storage mut Cell) -> Loan<'storage> {
    Loan::Active { target: source }
}
machine choose<'storage>(incoming: Loan<'storage>, other: &'storage mut Cell, moved: bool) -> Loan<'storage> {
    transition { _ -> finish(moved, other, incoming) }
    state finish(moved: bool, other: &'storage mut Cell, incoming: Loan<'storage>) -> Loan<'storage> {
        transition moved {
            true -> (incoming)
            false -> (Loan::Active { target: other })
        }
    }
}
machine store(target: &mut Cell, value: i64) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine consume<'storage>(loan: Loan<'storage>, value: i64) -> bool requires value == 41 {
    transition loan {
        Loan::Active { target } -> (store(&mut target, value))
        Loan::Empty -> false
    }
}
machine main() crashes Trap {
    let mut backing: Cell = Cell { value: 17 };
    let mut sibling: Cell = Cell { value: 19 };
    let constructed: Loan = choose(lend(&mut backing), &mut sibling, false);
    let first: bool = consume(constructed, 41);
    let first_correct: bool = first && backing.value == 17 && sibling.value == 41;
    let moved: Loan = choose(lend(&mut backing), &mut sibling, true);
    let second: bool = consume(moved, 41);
    transition first_correct && second && backing.value == 41 && sibling.value == 41 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
