// A payload-free `[copy]` case value read through shared-borrowed storage is
// an ordinary `Unrestricted` leaf: it copies out of the loan into a fresh
// owned value, whether a straight-line `let` binds it, a branch state passes
// it as an argument, or it is an element of a borrowed array. Exits 70 when
// the three copies report First, Second and Second (1 + 2 + 2 = 5, plus 65).
use omega_language_std::console;

data Kind [copy] {
    case First;
    case Second;
}

data Item [copy] {
    kind: Kind;
    count: u64 in Trapping;
}

data Table {
    kinds: [Kind; 4];
    item: Item;
}

machine Kind::tag(kind: Kind) -> u64 in Trapping {
    transition kind {
        Kind::First -> one()
        _ -> two()
    }

    state one() -> u64 in Trapping { 1 }
    state two() -> u64 in Trapping { 2 }
}

// Straight-line: the copied leaf binds a local.
machine Table::item_tag(table: &Table) -> u64 in Trapping {
    let kind: Kind = table.item.kind;
    let tag: u64 in Trapping = Kind::tag(kind);
    tag
}

// Branch states: the copied leaf is a call argument, from a field and from
// an element.
machine Table::branch_tag(table: &Table, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < 4 {
        true -> element(table, index)
        _ -> field(table)
    }

    state element(table: &Table, index: u64 in Trapping) -> u64 in Trapping
    requires index < 4
    {
        let tag: u64 in Trapping = Kind::tag(table.kinds[index]);
        tag
    }

    state field(table: &Table) -> u64 in Trapping {
        let tag: u64 in Trapping = Kind::tag(table.item.kind);
        tag
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let mut table: Table;
    table.kinds[2] = Kind::Second;
    table.item = Item { kind: Kind::Second, count: 0 };
    let first: u64 in Trapping = Table::branch_tag(&table, 0);
    let second: u64 in Trapping = Table::branch_tag(&table, 2);
    let third: u64 in Trapping = Table::branch_tag(&table, 9);
    let item: u64 in Trapping = Table::item_tag(&table);
    transition first + second + third == 5 && item == 2 {
        true -> done(main, 70)
        _ -> done(main, 71)
    }

    state done(main: &mut Main, code: i32) { Console::exit_process(code); }
}
