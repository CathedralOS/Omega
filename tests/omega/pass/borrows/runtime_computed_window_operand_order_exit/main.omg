// Expected exit: 0
machine collection(source_calls: &mut u64) -> &[u8]
requires source_calls == 0 ensures source_calls == 1 && result.len == 9
{ source_calls = 1; "123456789" }
machine first(counter: &mut u64) -> u64
requires counter == 0 ensures counter == 1 && result == 0
{ counter = 1; 0 }
machine last(counter: &mut u64) -> u64
requires counter == 1 ensures counter == 2 && result == 7
{ counter = 2; 7 }
machine main() crashes Trap {
    let mut counter: u64 = 0;
    let mut source_calls: u64 = 0;
    let selected: &[u8] = &collection(&mut source_calls)[first(&mut counter)..last(&mut counter)];
    transition selected.len == 7 && counter == 2 && source_calls == 1 {
        true -> done() false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
