// Discarding a returned shared reference restores mutation before the next statement.
use omega_language_std::console;

data Main {
    value: u8;
    neighbor: u8;
}

machine Main::first(main: &Main) -> &u8 {
    transition { _ -> &main.value }
}

machine Main::main(main: &mut Main) reaches Console {
    main.value = 7;
    main.neighbor = 11;
    _ = Main::first(main);
    main.value = 23;
    transition main.value == 23 && main.neighbor == 11 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
