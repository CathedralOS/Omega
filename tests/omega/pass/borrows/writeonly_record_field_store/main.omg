// WriteOnly borrow of a record referent: field stores through `&write`.
use omega_language_std::console;

data Node {
    value: i32;
    tag: i32;
}

data Main {
    node: Node;
}

machine Main::main(main: &mut Main) reaches Console {
    let r: &write Node = &write main.node;
    r.value = 7;
    r.tag = 3;
    transition main.node.value == 7 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
