use omega_language_std::console;

data Leaf { value: i32; }
data Pair { left: Leaf; right: Leaf; }
data Holder { node: Leaf; pair: Pair; }
data Main { holder: Holder; bytes: [u8; 4]; }

// Each body ends in a final expression whose value is a borrowed view or
// reference. Its checked value plans the completion the same way for every
// spelling: a shared view of a field or of a nested field, an exclusive view
// of a field, a subslice of an array formal, a literal's immutable image
// storage, and a forwarded view formal.
machine node(holder: &Holder) -> &Leaf {
    (&holder.node)
}

machine right(holder: &Holder) -> &Leaf {
    (&holder.pair.right)
}

machine node_mut(holder: &mut Holder) -> &mut Leaf {
    (&mut holder.node)
}

machine middle(bytes: &[u8; 4]) -> &[u8] {
    bytes[1..3]
}

machine label() -> &[u8] {
    ("ok")
}

machine relay(bytes: &[u8]) -> &[u8] {
    bytes
}

machine second_byte(bytes: &[u8]) -> u8 {
    transition bytes.len > 1 {
        true -> read(bytes)
        _ -> (0)
    }

    state read(bytes: &[u8]) -> u8 {
        bytes[1]
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.holder.node.value = 3;
    main.holder.pair.left.value = 5;
    main.holder.pair.right.value = 7;
    main.bytes[1] = 11;
    main.bytes[2] = 13;
    let shared: &Leaf = node(&main.holder);
    let seen: i32 = shared.value;
    let nested: &Leaf = right(&main.holder);
    let deeper: i32 = nested.value;
    let exclusive: &mut Leaf = node_mut(&mut main.holder);
    exclusive.value = 17;
    let narrowed: &[u8] = middle(&main.bytes);
    let forwarded: &[u8] = relay(narrowed);
    let length: u64 = forwarded.len;
    let second: u8 = second_byte(forwarded);
    let text: &[u8] = label();
    let text_length: u64 = text.len;
    transition seen == 3 && deeper == 7 && main.holder.node.value == 17
        && length == 2 && second == 13 && text_length == 2 {
        true -> finish(main, 0)
        _ -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
