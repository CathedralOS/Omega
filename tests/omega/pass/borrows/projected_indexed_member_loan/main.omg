use omega_language_std::console;

data Main {
    buf: [u8; 8];
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[2] = 9;
    transition true { _ -> next(main, &main.buf[2]) }

    state next(main: &mut Main, leaf: &u8) {
        transition leaf == 9 { true -> done(main) _ -> bad(main) }
    }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
