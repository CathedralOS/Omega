// A Unit call statement forwards a mutable view local whole: `mark(view)`
// lends the `&mut [u8]` descriptor exclusively, `check(view)` lends the same
// local shared, and `mark_words(words)` lends a `&mut [u32]` element view.
// Each callee writes or reads through the caller's backing array.
// Expected exit: 70.
use omega_language_std::console;

data Main { bytes: [u8; 4]; words: [u32; 3]; seen: bool; }

machine mark(bytes: &mut [u8]) {
    transition bytes.len > 1 {
        true -> at(bytes)
        _ -> done()
    }
    state at(bytes: &mut [u8]) requires bytes.len > 1 {
        bytes[1] = 9;
    }
    state done() {}
}

machine check(bytes: &[u8], seen: &mut bool) {
    transition bytes.len > 1 {
        true -> at(bytes, seen)
        _ -> done()
    }
    state at(bytes: &[u8], seen: &mut bool) requires bytes.len > 1 {
        seen = bytes[1] == 9;
    }
    state done() {}
}

machine mark_words(words: &mut [u32]) {
    transition words.len > 2 {
        true -> at(words)
        _ -> done()
    }
    state at(words: &mut [u32]) requires words.len > 2 {
        words[2] = 77;
    }
    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    main.seen = false;
    let view: &mut [u8] = &mut main.bytes[..];
    mark(view);
    check(view, &mut main.seen);
    let words: &mut [u32] = &mut main.words[..];
    mark_words(words);
    transition main.bytes[1] == 9 && main.seen && main.words[2] == 77 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
