// A borrowed fixed-array parameter carries across re-entry edges:
// `out: &mut [u8; 17]` forwards through the fill/write_digit loop and
// each element stores through the borrow — a bounded-view carrier, the
// referent stays caller-owned.
machine write_bytes(out: &mut [u8; 17], value: u8, width: u64) -> u64 {
    transition {
        _ -> fill(out, value, width, 0)
    }
    machine fill(out: &mut [u8; 17], value: u8, width: u64, position: u64) -> u64 {
        transition (position < width && position < out.len) {
            true -> write_digit(out, value, width, position)
            false -> (width)
        }
    }
    machine write_digit(out: &mut [u8; 17], value: u8, width: u64, position: u64) -> u64 {
        out[position] = value;
        transition {
            _ -> fill(out, value, width, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

data Main { out: [u8; 17]; written: u64; }

machine Main::main(main: &mut Main) {
    main.written = write_bytes(&mut main.out, 48, 3);
}
