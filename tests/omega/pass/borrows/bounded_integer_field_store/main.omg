use omega_language_std::console;
use omega::language::core::service;

domain [u8; 3]::Utf8 requires valid_utf8(self);
domain [u8; 9]::Ascii requires ascii_only(self);
domain [u8; 0]::NoNul requires no_nul(self);

data Counter [copy] {
    prefix: [u8; 3] in Utf8;
    value: i32;
    middle: [u8; 9] in Ascii;
    signed: i8;
    suffix: [u8; 0] in NoNul;
}

machine Counter::replace(&mut self) {
    self.value = 7;
    self.signed = -3;
}

machine Counter::step(&mut self) {
    transition self.value < 16 && self.signed > -5 {
        true -> update()
        false -> done()
    }
    state update(&mut self) {
        self.value = self.value + 1;
        self.signed = self.signed - 1;
    }
    state done(&mut self) {}
}

data Main {
    console: Binding<Console>;
    text: [u8; 9] in Ascii;
    counter: Counter;
}

machine Main::main(&mut self) reaches Console {
    self.counter.replace();
    self.counter.step();
    // Compare the narrow arithmetic result before another store can truncate
    // it: incorrect zero-extension of the negative input must be observable.
    // (Was: `self.counter.signed + 1 == -3`; a plain i8 field carries no
    // interval bound for the exact-arith `+ 1`, so the comparison observes
    // the stored value directly.)
    transition self.counter.value == 8 && self.counter.signed == -4 {
        true -> success()
        false -> failure()
    }
    state success(&mut self) { self.console.exit_process(70); }
    state failure(&mut self) { self.console.exit_process(71); }
}
