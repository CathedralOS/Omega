use omega_language_std::console;
use omega::language::core::binding;

data Choice [copy] { case First; case Second; case Fallback; }
data Holder { value: u64; sibling: u64; }
data Bag { holders: [Holder; 3]; }
data Main { console: Binding<Console>; bag: Bag; }

machine Bag::pick(&mut self, choice: Choice) -> &mut Holder {
    let slots: &mut [Holder] = self.holders.as_mut_slice();
    transition choice {
        Choice::First -> &mut slots[0]
        Choice::Second -> &mut slots[1]
        _ -> &mut slots[0]
    }
}

machine pick_free(bag: &mut Bag, choice: Choice) -> &mut Holder {
    let slots: &mut [Holder] = bag.holders.as_mut_slice();
    transition choice {
        Choice::First -> &mut slots[0]
        Choice::Second -> &mut slots[1]
        _ -> &mut slots[0]
    }
}

machine Holder::replace(&mut self, value: u64) {
    self.value = value;
    self.sibling = 29;
}

machine Main::main(&mut self) reaches Console {
    self.bag.holders[2].value = 17;
    let selected: &mut Holder = self.bag.pick(Choice::Second);
    selected.replace(41);
    let fallback: &mut Holder = pick_free(&mut self.bag, Choice::Fallback);
    fallback.replace(43);
    transition self.bag.holders[0].value == 43
        && self.bag.holders[1].value == 41
        && self.bag.holders[0].sibling == 29
        && self.bag.holders[1].sibling == 29
        && self.bag.holders[2].value == 17
        && self.bag.holders[2].sibling == 0 {
        true -> finish(70)
        false -> finish(1)
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
