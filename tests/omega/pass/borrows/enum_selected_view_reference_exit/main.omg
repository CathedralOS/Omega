use omega_language_std::console;

data Choice [copy] { case First; case Second; case Fallback; }
data Holder { value: u64; sibling: u64; }
data Bag { holders: [Holder; 3]; }
data Main { bag: Bag; }

machine Bag::pick(bag: &mut Bag, choice: Choice) -> &mut Holder {
    let slots: &mut [Holder] = &mut bag.holders[..];
    transition choice {
        Choice::First -> &mut slots[0]
        Choice::Second -> &mut slots[1]
        _ -> &mut slots[0]
    }
}

machine pick_free(bag: &mut Bag, choice: Choice) -> &mut Holder {
    let slots: &mut [Holder] = &mut bag.holders[..];
    transition {
        choice == Choice::First -> &mut slots[0]
        choice == Choice::Second -> &mut slots[1]
        _ -> &mut slots[0]
    }
}

machine Holder::replace(holder: &mut Holder, value: u64) {
    holder.value = value;
    holder.sibling = 29;
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[2].value = 17;
    let selected: &mut Holder = Bag::pick(&mut main.bag, Choice::Second);
    Holder::replace(selected, 41);
    let fallback: &mut Holder = pick_free(&mut main.bag, Choice::Fallback);
    Holder::replace(fallback, 43);
    transition main.bag.holders[0].value == 43
        && main.bag.holders[1].value == 41
        && main.bag.holders[0].sibling == 29
        && main.bag.holders[1].sibling == 29
        && main.bag.holders[2].value == 17
        && main.bag.holders[2].sibling == 0 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
