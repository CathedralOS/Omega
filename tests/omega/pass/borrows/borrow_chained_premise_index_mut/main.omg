data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self, left_index: u64, mid: u64, right_index: u64)
requires
    left_index <= 3 && mid <= 4 && right_index <= 3 &&
    left_index < mid && mid <= right_index
{
    let view: &mut [Entry] = self.entries.as_mut_slice();
    let left: &mut Entry = &mut view[left_index];
    let right: &mut Entry = &mut view[right_index];
    left = Entry { value: 1 };
    right = Entry { value: 2 };
}
