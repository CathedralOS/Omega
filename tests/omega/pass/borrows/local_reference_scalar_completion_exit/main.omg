use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Text { bytes: [u8; 8] in Utf8; }
data Main { }

machine count() -> u64 {
    let text: Text = Text { bytes: "é" };
    let view: &Text = &text;
    view.bytes.len
}

machine Main::main(main: &mut Main) reaches Console {
    let observed: u64 = count();
    transition observed == 2 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
