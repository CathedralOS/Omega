// A normal owned call transfers the exclusive counter into borrowed output storage; consuming the installed token increments that counter once.
// Expected exit: 0
data Token { drops: &mut [u64; 1]; }
machine settle(token: Token) { token.drops[0] = ((token.drops[0] as u64 in Wrapping) + 1) as u64; }
machine install(slot: &mut Token, incoming: Token) { slot = incoming; }
machine observe(output: &mut [u64; 1], previous: &mut [u64; 1]) crashes Trap {
 let mut token: Token = Token { drops: previous };
 install(&mut token, Token { drops: output });
 settle(token);
 transition output[0] == 1 && previous[0] == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
 let mut output: [u64; 1] = [0]; let mut previous: [u64; 1] = [0];
 observe(&mut output, &mut previous);
}
