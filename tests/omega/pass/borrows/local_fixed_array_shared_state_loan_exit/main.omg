// Shared fixed arrays lend their exact storage across a selected state edge.
// Bytes use a bounded byte carrier; i32 arrays retain their element layout.
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let bytes: [u8; 4] = "ABCD";
    let numbers: [i32; 3] = [5, 17, 29];
    transition numbers[1] == 17 {
        true -> observe(&bytes, &numbers)
        _ -> failed()
    }
    state observe(bytes: &[u8; 4], numbers: &[i32; 3]) {
        Console::write_byte(widen_u8_to_i32(bytes[2]));
        transition numbers[2] == 29 {
            true -> done()
            _ -> failed()
        }
    }
    state done() { Console::exit_process(70); }
    state failed() { Console::exit_process(71); }
}
