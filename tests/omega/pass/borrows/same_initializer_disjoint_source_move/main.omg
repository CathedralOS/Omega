// A transfer before a later sibling loan remains a valid authored order.
// The loan and extraction use disjoint storage; the repair closes the hole.
data Inventory where slots >= 0, slots <= 100 { slots: i32; }
data Bundle { loan: &Inventory; taken: Inventory; }
data Main { first: Inventory; second: Inventory; }

machine Main::peek(main: &mut Main) -> i32 {
    let bundle: Bundle = Bundle {
        taken: main.first,
        loan: &main.second
    };
    let seen: i32 = bundle.loan.slots;
    main.first = Inventory { slots: 77 };
    seen
}

// Earlier loan formation also leaves a disjoint sibling available to move.
machine Main::loan_first(main: &mut Main) -> i32 {
    let bundle: Bundle = Bundle {
        loan: &main.second,
        taken: main.first
    };
    let seen: i32 = bundle.loan.slots;
    main.first = Inventory { slots: 77 };
    seen
}
