// Select the reference carrier before crossing its pointer, then read a field.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { stamp: i32; value: i32; ready: bool; }
data Pair { first: Cell; second: Cell; }
data Main where index <= 1 {
    cells: Pair;
    index: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells.first.stamp = 3;
    main.cells.first.value = 11;
    main.cells.first.ready = false;
    main.cells.second.stamp = 5;
    main.cells.second.value = 70;
    main.cells.second.ready = true;
    main.index = 1;
    let messages: [&Cell; 2] = collect(&main.cells);
    main.index = 0;
    let first: i32 = messages[main.index].value;
    require_cell_value(first);
    main.index = 1;
    let observed: i32 = messages[main.index].value;
    require_cell_value(observed);
    let ready: bool = messages[main.index].ready;
    main.cells.second.value = 81;
    transition first == 70 && observed == 70 && ready && main.cells.second.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

machine collect(source: &Pair) -> [&Cell; 2] { [&source.second, &source.second] }

machine require_cell_value(value: i32)
requires value >= 0 && value <= 100
{}
