// Select the reference carrier before crossing its pointer, then read a field.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { stamp: i32; value: i32; ready: bool; }
data Pair { first: Cell; second: Cell; }
data Main where index <= 1 {
    cells: Pair;
    index: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells.first.stamp = 3;
    main.cells.first.value = 11;
    main.cells.first.ready = false;
    main.cells.second.stamp = 5;
    main.cells.second.value = 70;
    main.cells.second.ready = true;
    main.index = 1;
    let messages: [&mut Cell; 2] = collect(&mut main.cells);
    main.index = 0;
    let first: i32 = messages[main.index].value;
    main.index = 1;
    let observed: i32 = messages[main.index].value;
    let ready: bool = messages[main.index].ready;
    main.cells.second.value = 81;
    transition first == 11 && observed == 70 && ready && main.cells.second.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

machine collect(source: &mut Pair) -> [&mut Cell; 2] { [&mut source.first, &mut source.second] }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
