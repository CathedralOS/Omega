// Rebinding a reference local does not redirect a view made from its old
// value: `kept` borrows the literal "Door" that `view` pointed to, not the
// local `view`, so `view = "Gate"` is allowed and `kept` still reads "Door"
// (exit 70; a redirected alias would exit 71). This was a reject fixture
// written against the opposite rule; state_contracts.md "Mutation and subject
// identity" says replacing a local reference binding changes that binding
// without redirecting aliases made from its previous value.
use omega_language_std::Console;

data Main { }

machine first<'a>(bytes: &'a [u8]) -> &'a [u8] {
    bytes
}

machine Main::main(main: &mut Main) reaches Console {
    let mut view: &[u8] = "Door";
    let kept: &[u8] = first(view);
    view = "Gate";
    transition kept == "Door" {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
