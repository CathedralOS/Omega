// DESCRIPTOR WALK -- the Cathedral M2 memory-map pattern, in-tree: a byte
// buffer holding firmware-style descriptors is walked at a RUNTIME stride
// (`offset + descriptor_size`, never sizeof), each entry re-viewed
// through the §5b record recast (`&buffer[offset] as &Desc`) with member
// reads through the view. Every proof is compiler-side:
//   - the walk bound: the back-edge guard `next <= 32` admits the
//     forwarded offset into the walk states' `requires offset <= 32` contract;
//   - the stride: the guard `0 < stride <= 16` on the descriptor-size parameter
//     bounds `offset + stride`;
//   - the view footprint: `high(offset) + size_of(Desc) <= len(buffer)` through
//     the interval walk's incoming edges give the offset -- the literal 0
//     and the `next <= 32` guard (recast rung C1/C2);
//   - no runtime bounds checks, no linear-counter workaround.
// Three descriptors at offsets 0/16/32 carry kind tags 3, 4, 5 and page
// counts 10, 20, 30; the walk sums the page counts of kind >= 4 entries:
// 20 + 30 = 50.
//
// Expected exit: 50
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Desc { kind: u32; pages: u64; }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut buffer: [u8; 48];
    // Descriptor 0: kind 3, pages 10.
    buffer[0] = 3;
    buffer[8] = 10;
    // Descriptor 1: kind 4, pages 20.
    buffer[16] = 4;
    buffer[24] = 20;
    // Descriptor 2: kind 5, pages 30.
    buffer[32] = 5;
    buffer[40] = 30;
    let descriptor_size: u32 = 16;
    let total: u32 in Wrapping = 0;
    transition { _ -> walk(&buffer, descriptor_size, 0, total) }

    // Each view borrows the entry's local buffer. Coordinates and the
    // accumulator travel as values instead of persistent context fields.
    state walk(buffer: &[u8; 48], descriptor_size: u32, offset: u32, total: u32 in Wrapping) requires offset <= 32 {
        let descriptor: &Desc = &buffer[offset] as &Desc;
        let pages: u64 = descriptor.pages;
        transition descriptor.kind >= 4 {
            true -> tally(buffer, descriptor_size, offset, total, pages)
            _ -> step(buffer, descriptor_size, offset, total)
        }
    }
    state tally(buffer: &[u8; 48], descriptor_size: u32, offset: u32, total: u32 in Wrapping, pages: u64) requires offset <= 32 {
        let counted: u32 in Wrapping =
            narrow_u64_to_u32_wrapping(pages) as u32 in Wrapping;
        let updated_total: u32 in Wrapping = total + counted;
        transition { _ -> step(buffer, descriptor_size, offset, updated_total) }
    }
    state step(buffer: &[u8; 48], descriptor_size: u32, offset: u32, total: u32 in Wrapping) requires offset <= 32 {
        let stride: u32 = descriptor_size;
        transition stride > 0 && stride <= 16 {
            true -> advance(buffer, descriptor_size, offset, total, stride)
            _ -> done(total)
        }
    }
    state advance(buffer: &[u8; 48], descriptor_size: u32, offset: u32, total: u32 in Wrapping, stride: u32) requires offset <= 32 requires stride <= 16 {
        let next: u32 = offset + stride;
        transition next <= 32 {
            true -> walk(buffer, descriptor_size, next, total)
            _ -> done(total)
        }
    }
    state done(total: u32 in Wrapping) {
        let code: i32 = narrow_u32_to_i32_trapping(total as u32);
        Console::exit_process(code);
    }
}
