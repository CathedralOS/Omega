// Expected exit: 0
data Cell { value: i32; }
data Envelope<'storage> [copy] { case Active(cell: &'storage Cell); case Empty; }
machine consume(value: Envelope, ignored: bool) -> i32 {
    match value { Envelope::Active {cell} -> cell.value Envelope::Empty -> 17 }
}
machine mutate(cell: &mut Cell) -> bool { cell.value = 23; true }
machine main() crashes Trap {
    let mut second: Cell = Cell {value: 19};
    let envelope: Envelope = Envelope::Empty;
    let observed: i32 = consume(envelope, mutate(&mut second));
    transition observed == 17 && second.value == 23 {true -> done() false -> bad()}
    state done() {}
    state bad() { crash Trap; }
}
