// Both paths arrive at one captured header. The static path must form the
// same descriptor as the runtime-selected path whenever that header owns one.
data Value { amount: u64; }
machine inspect(dynamic: bool) crashes Trap {
    let values: [Value; 2] = [Value { amount: 11 }, Value { amount: 35 }];
    let mut cursor: u64;
    cursor = 0;
    transition dynamic && cursor < 2 {
        true -> verify(&values[cursor])
        _ -> verify(&values[0])
    }
    machine verify(value: &Value) {
        transition value.amount == 11 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    inspect(false);
    inspect(true);
}
