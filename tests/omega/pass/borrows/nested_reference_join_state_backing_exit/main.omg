// Expected exit: 0.
// Every nested result alternative retains its own captured reference to the
// original array while the successor observes it after leaving the lender.
machine identity<'input>(bytes: &'input [u8; 4]) -> &'input [u8; 4] { bytes }
machine exercise(outer: bool, inner: bool) -> bool {
    let mut bytes: [u8; 4];
    bytes[0] = 37;
    transition {
        _ -> observe(match outer {
            true -> match inner { true -> &bytes, false -> &bytes },
            false -> identity(match inner { true -> &bytes, false -> &bytes })
        })
    }
    state observe(bytes: &[u8; 4]) -> bool { bytes[0] == 37 }
}
machine main() crashes Trap {
    transition exercise(false, false) && exercise(false, true)
        && exercise(true, false) && exercise(true, true) {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
