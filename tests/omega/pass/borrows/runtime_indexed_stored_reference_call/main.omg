data Cell { stamp: u64; value: i32; }
data Message { stamp: u64; body: &Cell; }
data Main { first: Cell; second: Cell; }
machine take(cell: &Cell) -> i32 { cell.value }
machine inspect(messages: &[Message; 2], position: u64) -> i32
requires position < 2 { take(messages[position].body) }
machine Main::main(main: &mut Main) crashes Trap {
    main.first.stamp = 13; main.first.value = 11;
    main.second.stamp = 17; main.second.value = 70;
    let messages: [Message; 2] = [
        Message { stamp: 7, body: &main.first },
        Message { stamp: 9, body: &main.second }
    ];
    let chosen: i32 = inspect(&messages, 1);
    let neighbor: i32 = inspect(&messages, 0);
    transition chosen == 70 && neighbor == 11 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
