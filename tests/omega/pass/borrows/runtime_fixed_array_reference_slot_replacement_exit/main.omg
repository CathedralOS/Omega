// A call replaces one descriptor and case-bearing element, preserving its sibling.
data Cell { value: i32; }
data Marker { case Before; case After; }
data Entry { source: &Cell; marker: Marker; }
data Holder { entries: [Entry; 2]; stamp: i32; }
data Main { first: Cell; second: Cell; replacement: Cell; }

machine replace(holder: &mut Holder, source: &Cell) {
    holder.entries[0] = Entry { source: source, marker: Marker::After };
}

machine is_after(marker: &Marker) -> bool {
    transition marker {
        Marker::After -> true
        Marker::Before -> false
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.first.value = 11;
    main.second.value = 23;
    main.replacement.value = 37;
    let mut holder: Holder = Holder {
        entries: [
            Entry { source: &main.first, marker: Marker::Before },
            Entry { source: &main.second, marker: Marker::Before }
        ],
        stamp: 41
    };
    replace(&mut holder, &main.replacement);
    transition holder.entries[0].source.value == 37
        && holder.entries[1].source.value == 23 && holder.stamp == 41
        && is_after(&holder.entries[0].marker) && !is_after(&holder.entries[1].marker) {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
