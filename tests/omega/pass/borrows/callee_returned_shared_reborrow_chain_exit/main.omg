// Expected exit: 0. Closing a returned child preserves its caller-owned backing.
data Header { left: u64; right: u64; }
data Source { header: Header; }
data Main { source: Source; }

machine parent(source: &Source) -> &Header { &source.header }

machine child(source: &Source) -> &u64 {
    let header: &Header = parent(source);
    let left: &u64 = &header.left;
    left
}

machine Main::main(main: &mut Main) crashes Trap {
    main.source.header.left = 37u64;
    main.source.header.right = 9u64;
    let left: &u64 = child(&main.source);
    transition left == 37u64 && main.source.header.right == 9u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
