// Ordinary scalar-reference calls use projected view backing just like imports.
// A literal mutable selector and a dynamic shared selector retain their bounds.
machine write(value: &mut u8) { value = 41; }
machine read(value: &u8) -> u8 { value }
machine write_first(bytes: &mut [u8]) {
    transition bytes.len > 0 { true -> nonempty(bytes) _ -> done() }
    machine nonempty(bytes: &mut [u8]) { write(&mut bytes[0]); }
    machine done() {}
}
machine read_at(bytes: &[u8], index: u64) -> u8 {
    transition index < bytes.len { true -> nonempty(bytes, index) _ -> 0 }
    machine nonempty(bytes: &[u8], index: u64) -> u8 { read(&bytes[index]) }
}
machine main() crashes Trap {
    let mut bytes: [u8; 6];
    bytes[0] = 11;
    bytes[5] = 13;
    write_first(&mut bytes[2..5]);
    let value: u8 = read_at(&bytes[1..5], 1);
    transition value == 41 && bytes[0] == 11 && bytes[1] == 0
        && bytes[2] == 41 && bytes[3] == 0 && bytes[4] == 0 && bytes[5] == 13 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
