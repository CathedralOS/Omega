// An exclusive local subslice suspends only the parent branch it captured,
// and only until its last use. `middle` is lent to a call; after its last use
// the parent view is read through as a call operand. `left` and `right` are
// disjoint windows of the same local view, so each is lent while the other is
// live; after both last uses the parent is lent whole again, shared and
// exclusively. Each of these parent uses while a child is still live is a
// `fail/borrows/local_subslice_live_parent_*` fixture.
machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine fill(view: &mut [u8], value: u8)
requires view.len >= 2
{
    view[0] = value;
    view[1] = value;
}

machine peek(view: &[u8], at: u64) -> u8
requires at < view.len
{
    view[at]
}

machine ident(value: u8) -> u8 { value }

machine main() crashes Trap {
    let mut bytes: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = &mut bytes[..];
    let middle: &mut [u8] = &mut view[2..4];
    let inside: u8 = peek(middle, 1);
    let copied: u8 = ident(view[3]);
    let left: &mut [u8] = &mut view[0..2];
    let right: &mut [u8] = &mut view[4..6];
    fill(left, 10);
    fill(right, 20);
    zero(left);
    zero(right);
    let seen: u8 = peek(view, 5);
    fill(view, 30);
    // `inside` and `copied` both read 4; left -> 10 10, right -> 20 20,
    // left[0] -> 0, right[0] -> 0, so `peek` sees 20; fill(view) ->
    // 30 30 3 4 0 20 7 8.
    transition inside == 4 && copied == 4 && seen == 20
        && bytes[0] == 30 && bytes[1] == 30 && bytes[2] == 3 && bytes[3] == 4
        && bytes[4] == 0 && bytes[5] == 20 && bytes[6] == 7 && bytes[7] == 8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
