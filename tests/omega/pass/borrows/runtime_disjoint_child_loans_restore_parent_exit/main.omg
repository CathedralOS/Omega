data Cell { value: i32; }

machine total(values: &[Cell]) -> i64
requires values.len == 2
{
    (values[0].value as i64) + (values[1].value as i64)
}

machine replace(values: &mut [Cell], first_index: u64, second_index: u64)
requires values.len == 2,
    first_index < values.len, second_index < values.len,
    first_index != second_index
{
    let first: &mut Cell = &mut values[first_index];
    let second: &mut Cell = &mut values[second_index];
    first = Cell { value: 17 };
    second = Cell { value: 53 };
}

machine main() crashes Trap {
    let mut values: [Cell; 2];
    let parent: &mut [Cell] = &mut values[..];
    replace(parent, 0, 1);
    let first: &mut Cell = &mut parent[0];
    let second: &mut Cell = &mut parent[1];
    first = Cell { value: 19 };
    second = Cell { value: 51 };
    let observed: i64 = total(parent);
    transition observed == 70 && values[0].value == 19 && values[1].value == 51 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
