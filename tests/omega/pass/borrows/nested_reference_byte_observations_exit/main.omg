use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Text { stamp: u64; bytes: [u8; 8] in Utf8; }
data Message { stamp: u64; body: &Text; }
data Envelope { stamp: u64; message: &Message; }
data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let text: Text = Text { stamp: 43, bytes: "é" };
    let message: Message = Message { stamp: 11, body: &text };
    let envelope: Envelope = Envelope { stamp: 12, message: &message };
    let count: u64 = envelope.message.body.bytes.len;
    let same: bool = envelope.message.body.bytes == "é";
    transition count == 2 && same && text.stamp == 43 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
