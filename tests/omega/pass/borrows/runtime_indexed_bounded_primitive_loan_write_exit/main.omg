// A writable indexed loan retains the field's complete receiving range.
data Cell where value <= 1 { prefix: u64; value: u8; suffix: u32; }
data Main { cells: [Cell; 2]; }
machine clear(value: &mut u8)
ensures value <= 1
{ value = 0; }
machine clear_selected(index: u64, main: &mut Main)
requires index < 2
{
    let selected: &mut u8 = &mut main.cells[index].value;
    clear(selected);
}
machine Main::main(main: &mut Main) crashes Trap {
    main.cells[0].value = 1;
    main.cells[1].value = 1;
    main.cells[1].prefix = 123;
    main.cells[1].suffix = 456;
    clear_selected(1, main);
    transition main.cells[1].value == 0 && main.cells[0].value == 1
        && main.cells[1].prefix == 123 && main.cells[1].suffix == 456 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
