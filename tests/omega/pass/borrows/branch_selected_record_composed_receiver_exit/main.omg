use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);

data Direction [copy] {
    case East;
    case West;
}

data CellId [copy] {
    case None;
    case First;
    case Second;
}

data Exit [copy] {
    command: [u8; 8] in Utf8;
    direction: Direction;
    destination: CellId;
}

data Room [copy] {
    exits: [Exit; 1];
    neighbor: u64;
    observed_before: u64;
}

data Bag { rooms: [Room; 3]; }
data CommandSource { tag: u64; }
data Main { bag: Bag; commands: CommandSource; }

machine Bag::pick(bag: &mut Bag, marker: Direction, second: bool) -> &mut Room {
    let room_view: &mut [Room] = &mut bag.rooms[..];
    transition second {
        true -> &mut room_view[1]
        false -> &mut room_view[0]
    }
}

machine CommandSource::next(command_source: &mut CommandSource, direction: Direction) -> [u8; 8] in Utf8 {
    transition direction {
        Direction::East -> "east"
        Direction::West -> "west"
    }
}

machine Room::install(
    room: &mut Room,
    command: [u8; 8] in Utf8,
    direction: Direction,
    destination: CellId
) {
    transition { _ -> write(room, command, direction, destination) }

    state write(
        room: &mut Room,
        command: [u8; 8] in Utf8,
        direction: Direction,
        destination: CellId
    ) {
        room.observed_before = room.neighbor;
        room.neighbor = 31;
        room.exits[0] = Exit {
            command: command,
            direction: direction,
            destination: destination,
        };
    }
}

machine CommandSource::connect(
    command_source: &mut CommandSource,
    bag: &mut Bag,
    direction: Direction,
    destination: CellId,
    second: bool
) {
    let selected: &mut Room = Bag::pick(bag, direction, second);
    Room::install(selected, CommandSource::next(command_source, direction), direction, destination);
}

machine Main::main(main: &mut Main) reaches Console {
    CommandSource::connect(&mut main.commands, &mut main.bag, Direction::East, CellId::First, true);
    CommandSource::connect(&mut main.commands, &mut main.bag, Direction::West, CellId::Second, false);
    transition main.bag.rooms[0].exits[0].command == "west"
        && main.bag.rooms[0].exits[0].command.len == 4
        && main.bag.rooms[0].exits[0].direction == Direction::West
        && main.bag.rooms[0].exits[0].destination == CellId::Second
        && main.bag.rooms[1].exits[0].command == "east"
        && main.bag.rooms[1].exits[0].command.len == 4
        && main.bag.rooms[1].exits[0].direction == Direction::East
        && main.bag.rooms[1].exits[0].destination == CellId::First
        && main.bag.rooms[0].neighbor == 31
        && main.bag.rooms[1].neighbor == 31
        && main.bag.rooms[0].observed_before == 0
        && main.bag.rooms[1].observed_before == 0
        && main.bag.rooms[2].neighbor == 0 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }

    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
