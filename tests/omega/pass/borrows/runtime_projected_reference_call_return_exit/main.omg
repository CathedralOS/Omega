data View { body: &mut i32; }
data Token { code: i32; }
data Outer { inner: View; spare: Token; }

machine select(value: View) -> &mut i32 { value.body }
machine replace(value: &mut i32) { value = 29; }

machine exercise(value: &mut i32) -> i32 {
    let input: Outer = Outer {
        inner: View { body: value },
        spare: Token { code: 12 }
    };
    let held: &mut i32 = select(input.inner);
    replace(held);
    value
}

machine main() crashes Trap {
    let mut value: i32 = 0;
    let observed: i32 = exercise(&mut value);
    transition observed == 29 && value == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
