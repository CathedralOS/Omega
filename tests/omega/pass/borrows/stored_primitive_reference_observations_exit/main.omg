use omega_language_std::console;

data Bundle<'storage> { prefix: i32; value: &'storage i32; flag: &'storage bool; }
data Main { }

machine observe<'storage>(bundle: &Bundle<'storage>) -> i32 {
    transition bundle.flag {
        true -> value(bundle)
        false -> absent()
    }
    state value(bundle: &Bundle<'storage>) -> i32 { bundle.value }
    state absent() -> i32 { 1 }
}

machine Main::main(main: &mut Main) reaches Console {
    let backing: i32 = 42;
    let other: i32 = 39;
    let flag: bool = true;
    let bundle: Bundle = Bundle { prefix: 7, value: &backing, flag: &flag };
    let sibling: Bundle = Bundle { prefix: 9, value: &other, flag: &flag };
    let direct: i32 = bundle.value;
    let unrelated: i32 = sibling.value;
    let selected: i32 = observe(&bundle);
    transition direct == 42 && selected == 42 && unrelated == 39 && bundle.prefix == 7 {
        true -> finish(main, 42)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
