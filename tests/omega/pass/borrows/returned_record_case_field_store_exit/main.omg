use omega_language_std::console;

data Tag [copy] { case Empty; case Set; case Other; }
data Flags { literal: Tag; copied: Tag; }
data Holder { flags: Flags; sibling: u64; }
data Bag { holders: [Holder; 3]; }
data Main { bag: Bag; }

machine pick(bag: &mut Bag, second: bool) -> &mut Holder {
    let holders: &mut [Holder] = &mut bag.holders[..];
    transition second {
        true -> &mut holders[1]
        false -> &mut holders[0]
    }
}

machine fill(bag: &mut Bag, second: bool, value: Tag) {
    let selected: &mut Holder = pick(bag, second);
    selected.flags.literal = Tag::Set;
    selected.flags.copied = value;
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[0].flags.literal = Tag::Other;
    main.bag.holders[0].flags.copied = Tag::Set;
    main.bag.holders[0].sibling = 17;
    main.bag.holders[1].flags.literal = Tag::Empty;
    main.bag.holders[1].flags.copied = Tag::Empty;
    main.bag.holders[1].sibling = 29;
    main.bag.holders[2].flags.literal = Tag::Other;
    main.bag.holders[2].sibling = 37;
    fill(&mut main.bag, true, Tag::Other);
    fill(&mut main.bag, false, Tag::Empty);
    transition main.bag.holders[1].flags.literal == Tag::Set
        && main.bag.holders[1].flags.copied == Tag::Other
        && main.bag.holders[1].sibling == 29
        && main.bag.holders[0].flags.literal == Tag::Set
        && main.bag.holders[0].flags.copied == Tag::Empty
        && main.bag.holders[0].sibling == 17
        && main.bag.holders[2].flags.literal == Tag::Other
        && main.bag.holders[2].sibling == 37 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
