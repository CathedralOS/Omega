// Descriptor offsets restart at each crossing; the final borrow selects one field.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { stamp: i32; value: i32; }
data Message { body: &Cell; }
data Envelope { message: &Message; }
data Main { console: Binding<Console>; cell: Cell; }

machine read_integer(value: &i32) -> i32 { value }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.stamp = 9;
    main.cell.value = 70;
    let message: Message = Message { body: &main.cell };
    let envelope: Envelope = Envelope { message: &message };
    let code: i32 = read_integer(&envelope.message.body.value);
    transition code == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
