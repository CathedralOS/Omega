// A nested reference carrier preserves its backing across unrelated computation.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: i32; }
data Message { body: &Cell; }
data Envelope { stamp: i32; message: Message; }
data Main { console: Binding<Console>; cell: Cell; }

machine read_cell(cell: &Cell) -> i32 { cell.value }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    let envelope: Envelope = Envelope {
        stamp: 12,
        message: Message { body: &main.cell },
    };
    let unrelated: i32 = 6 * 2;
    let code: i32 = read_cell(envelope.message.body);
    transition code == 70 && unrelated == 12 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
