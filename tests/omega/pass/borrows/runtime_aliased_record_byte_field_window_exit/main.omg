// Expected exit: 0
data View<'storage> { bytes: &'storage mut [u8]; }
data Pair<'storage> { left: View<'storage>; right: View<'storage>; }
machine observe(pair: &Pair) -> u64 {
    let source: &View = &pair.right;
    let selected: &[u8] = &source.bytes[..];
    selected.len
}
machine main() crashes Trap {
    let mut left: [u8; 1] = [7u8];
    let mut right: [u8; 2] = [8u8, 9u8];
    let pair: Pair = Pair { left: View { bytes: &mut left[..] }, right: View { bytes: &mut right[..] } };
    let count: u64 = observe(&pair);
    transition count == 2 && left[0] == 7 && right[0] == 8 && right[1] == 9 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
