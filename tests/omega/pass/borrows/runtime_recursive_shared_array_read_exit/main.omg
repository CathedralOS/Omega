// A machine that reads through a shared fixed-array loan and calls itself in
// tail position. The self call re-enters the entry, whose loop header rebinds
// the loan on every iteration; the invocation lends that header the
// signature's shared view, so the header keeps the shared declaration rather
// than claiming the exclusive loan its backedge forwards.
use omega_language_std::console;

data Stack { items: [u32; 8]; count: u64; }

data Main { stack: Stack; }

machine sum(items: &[u32; 8], index: u64, limit: u64, total: u64 in Wrapping) -> u64 in Wrapping
terminates by (index, limit) -> Nat::BoundedDistance;
requires limit <= 8
{
    transition {
        index >= limit -> (total)
        _ -> sum(items, index + 1, limit, total + items[index] as u64 in Wrapping)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.stack.items[0] = 10;
    main.stack.items[1] = 20;
    main.stack.items[2] = 40;
    let mut local: [u32; 8];
    local[0] = 3;
    local[1] = 4;
    let nested: u64 in Wrapping = sum(&main.stack.items, 0, 3, 0);
    let owned: u64 in Wrapping = sum(&local, 0, 2, 0);
    transition nested == 70 && owned == 7 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
