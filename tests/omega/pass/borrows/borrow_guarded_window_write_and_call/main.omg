data WindowBuffer { items: [i32; 4]; }

machine take(slot: &mut i32) {
    slot = 7;
}

machine write_outside_window(context: &mut WindowBuffer, index: u64, cut: u64) -> u64
    requires index <= 3, cut <= 4;
{
    transition {
        index < cut -> forward(context, cut, index)
        _ -> 0
    }
    machine forward(main: &mut WindowBuffer, limit: u64, cursor: u64) -> u64
        requires limit <= 4, cursor <= 3;
    {
        transition { _ -> separate(main, cursor, limit) }
    }
    machine separate(main: &mut WindowBuffer, position: u64, boundary: u64) -> u64
        requires position <= 3, boundary <= 4;
    {
        let held: &mut [i32] = &mut main.items[boundary..4];
        main.items[position] = 3;
        take(&mut main.items[position]);
        held.len
    }
}

machine main() crashes Trap {
    let mut context: WindowBuffer;
    let length: u64 = write_outside_window(&mut context, 1, 2);
    transition length == 2 && context.items[1] == 7 && context.items[2] == 0 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
