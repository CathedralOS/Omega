// A returned record keeps its stored reference while a containing temporary lends it.
// Expected exit: 0.
data Envelope<Payload> { payload: Payload; }

machine wrap<'a>(value: &'a Envelope<i32>) -> Envelope<&'a Envelope<i32>> {
    Envelope { payload: value }
}

machine main() crashes Trap {
    let second: Envelope<i32> = Envelope { payload: 23i32 };
    let produced: &Envelope<&Envelope<&Envelope<i32>>> = &Envelope {
        payload: &wrap(&second)
    };
    transition produced.payload.payload.payload == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
