domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);
use omega_language_std::console;

domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
// The copyable owner stores capacity and live length explicitly. Qualification
// belongs to the borrowed prefix, whose actual bytes are validated.
data TextBuffer [copy] where used <= 16 { storage: [u8; 16] in Utf8; used: u64; }
machine TextBuffer::view(buffer: &TextBuffer) -> &[u8] in Utf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    state bad() { crash Trap; }
}
machine TextBuffer::equal(buffer: &TextBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in Utf8 = TextBuffer::view(buffer);
    bytes == expected
}


data Main {
    line: TextBuffer;
    sibling: u64;
}

machine replace(line: &mut TextBuffer) crashes Trap {
    line = TextBuffer { storage: [195u8, 169u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 2 };
}

// Passing the owner onward must preserve its address and predicate contract,
// whether it entered the machine or arrived through a state transition.
machine forward(line: &mut TextBuffer) -> bool crashes Trap {
    replace(line);
    let first: bool = TextBuffer::equal(&line, "é") && line.used == 2;
    line = TextBuffer { storage: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 0 };
    transition { _ -> arrived(line, first) }

    state arrived(line: &mut TextBuffer, first: bool) {
        replace(line);
        first && TextBuffer::equal(&line, "é") && line.used == 2
    }
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    main.line = TextBuffer { storage: [71u8, 97u8, 116u8, 101u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 4 };
    main.sibling = 29;
    let changed: bool = forward(&mut main.line);
    transition changed && TextBuffer::equal(&main.line, "é") && main.line.used == 2 && main.sibling == 29 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
