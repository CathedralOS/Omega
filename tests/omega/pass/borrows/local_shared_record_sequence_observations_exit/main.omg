use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Text { bytes: [u8; 8] in Utf8; }
data Room { description: Text; samples: [u64; 2]; }
data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let room: Room = Room {
        description: Text { bytes: "é" }, samples: [17, 43]
    };
    let view: &Room = &room;
    transition room.description.bytes.len == 2
        && view.description.bytes.len == 2 && view.description.bytes == "é"
        && view.samples.len == 2 && view.samples[1] == 43 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
