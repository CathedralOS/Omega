// The selected result forwards the access each completed branch already has.
machine exercise(first: &mut u32, second: &mut u32, choose: bool) -> u32 {
    let selected: &mut u32 = match choose {
        true -> first,
        false -> second
    };
    let observed: u32 = selected;
    observed
}

machine main() crashes Trap {
    let mut first: u32 = 7;
    let mut second: u32 = 9;
    let selected_first: u32 = exercise(&mut first, &mut second, true);
    let selected_second: u32 = exercise(&mut first, &mut second, false);
    transition selected_first == 7 && selected_second == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
