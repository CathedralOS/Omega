// Expected exit: 0.
use omega::language::core::option;

data Input { values: [i32; 4]; }
data Record { value: i32; }

machine select<'input, T>(values: &'input [T], position: u64) -> Optional<&'input T>
requires position < values.len
{
    Optional::Some { value: &values[position] }
}

machine relay<'input, T>(values: &'input [T], position: u64) -> Optional<&'input T>
requires position < values.len
{
    select(values, position)
}

machine read(found: Optional<&i32>) -> i32 {
    transition found {
        Optional::Some { value } -> (value)
        Optional::None -> -1
    }
}

machine read_record(found: Optional<&Record>) -> i32 {
    transition found {
        Optional::Some { value } -> (value.value)
        Optional::None -> -1
    }
}

// A nonzero slice of arrays keeps the selected row's original storage home.
machine read_pair(found: Optional<&[i32; 2]>) -> i32 {
    transition found {
        Optional::Some { value } -> (value[1])
        Optional::None -> -1
    }
}

machine capture<'input>(values: &'input [i32]) -> Optional<&'input i32>
requires values.len >= 2
{
    let mut position: u64 = 0;
    let selected: &i32 = &values[position];
    position = 1;
    Optional::Some { value: selected }
}

machine choose<'input>(first: &'input [i32], second: &'input [i32], branch: bool)
-> Optional<&'input i32>
requires first.len > 0 && second.len > 0
{
    transition branch {
        true -> Optional::Some { value: &first[0] }
        false -> Optional::Some { value: &second[0] }
    }
}

machine main() crashes Trap {
    let input: Input = Input { values: [3, 7, 11, 19] };
    let found: Optional<&i32> = select(&input.values, 1);
    let first: i32 = read(found);
    let suffix: &[i32] = input.values[1..];
    let forwarded: Optional<&i32> = relay(suffix, 1);
    let second: i32 = read(forwarded);
    let third: i32 = read(select(&input.values, 3));
    let captured: i32 = read(capture(&input.values));
    let other: [i32; 2] = [23, 29];
    let left: i32 = read(choose(&input.values, &other, true));
    let right: i32 = read(choose(&input.values, &other, false));
    let records: [Record; 2] = [Record { value: 31 }, Record { value: 37 }];
    let record: i32 = read_record(relay(&records, 1));
    let pairs: [[i32; 2]; 3] = [[2, 3], [5, 7], [11, 13]];
    let pair_suffix: &[[i32; 2]] = pairs[1..];
    let pair: i32 = read_pair(relay(pair_suffix, 1));
    transition first == 7 && second == 11 && third == 19
        && captured == 3 && left == 3 && right == 23 && record == 37 && pair == 13 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
