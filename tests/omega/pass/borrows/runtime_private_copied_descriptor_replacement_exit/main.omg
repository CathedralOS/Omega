// Replacing an inline descriptor in a copied argument changes only the callee's copy.
// Expected exit: 0
data Cell { value: i32; }
data View<'storage> [copy] { target: &'storage Cell; }
machine redirect<'storage>(mut view: View<'storage>, replacement: &'storage Cell) -> bool {
    view.target = replacement;
    view.target.value == 19
}
machine exercise() -> bool {
    let first: Cell = Cell { value: 17 };
    let second: Cell = Cell { value: 19 };
    let view: View = View { target: &first };
    let redirected: bool = redirect(view, &second);
    redirected && view.target.value == 17 && first.value == 17 && second.value == 19
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
