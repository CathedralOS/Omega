// A record whose fields mix owned scalars and a shared `&[u8]` view is an
// owned carrier: copying it copies scalars and view descriptors whole, and
// its no-code disposal at state exit needs the same evidence as plain owned
// storage. Binding `sample`, borrowing `s` from its view field, and exiting
// through named edges previously stopped at `edge cleanup: no state plan`
// because the disposal gate admitted plain owned contents only.

data Sample {
    bytes: &[u8];
}

machine held() -> u64 {
    let buf: [u8; 4] = [11, 64, 255, 0];
    let sample: Sample = Sample { bytes: buf[0..3] };
    let s: &[u8] = sample.bytes;
    let matches: bool = s.len == 3;
    transition matches {
        true -> good()
        false -> bad()
    }
    machine good() -> u64 {
        70
    }
    machine bad() -> u64 {
        71
    }
}

machine main() {
    let out: u64 = held();
}
