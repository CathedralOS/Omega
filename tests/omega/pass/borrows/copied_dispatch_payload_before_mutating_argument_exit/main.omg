// Expected exit: 0
// A copied case payload survives mutation of its source by an earlier target operand.
data Item [copy] { case Empty; case Ready(count: u64); }

machine take(item: &mut Item) -> u64 {
    transition item {
        Item::Ready { count } -> clear(mutate(item), item, count)
        Item::Empty -> 0
    }
    machine mutate(item: &mut Item) -> u64 {
        item = Item::Ready { count: 99 };
        0
    }
    machine clear(ignored: u64, item: &mut Item, saved: u64) -> u64 {
        item = Item::Empty;
        saved
    }
}

machine main() crashes Trap {
    let mut item: Item = Item::Ready { count: 42 };
    let count: u64 = take(&mut item);
    let empty: u64 = take(&mut item);
    transition count == 42 && empty == 0 {
        true -> done()
        false -> failed()
    }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
