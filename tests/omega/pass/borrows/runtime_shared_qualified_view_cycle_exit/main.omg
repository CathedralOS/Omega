// A loop over a shared qualified view (`&[u8] in Path`) forwards the same
// loan to its own entry and to a helper on every iteration, the shape of
// std's `Filesystem::mkall_walk`. A shared loan freezes its bytes, so the
// qualification it arrived with holds at every re-entry. The walk stops at
// the path's end and the helper saw the final byte.
// Expected exit: 70.
use omega_language_std::console;
use omega_language_std::filesystem_host;

data Main { last: u64; }

machine is_slash(path: &[u8] in Path, i: u64) -> u64 {
    transition i < path.len {
        true -> at(path, i)
        _ -> (0)
    }
    state at(path: &[u8] in Path, i: u64) -> u64
    requires i < path.len
    {
        transition path[i] == 47 { true -> (1) _ -> (0) }
    }
}

machine walk(main: &mut Main, path: &[u8] in Path, i: u64) -> u64
terminates by (i, path.len) -> Nat::BoundedDistance;
{
    main.last = is_slash(path, i);
    transition i < path.len {
        true -> walk(main, path, i + 1)
        _ -> (i)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.last = 9;
    let stopped: u64 = walk(main, "/tmp/a/b", 0);
    transition stopped == 8 && main.last == 0 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
