use omega_language_std::console;

data Child { value: u64; }
data Holder { child: Child; sibling: u64; }
data Bag { holders: [Holder; 2]; }
data Main { bag: Bag; }

machine pick(bag: &mut Bag) -> &mut Holder {
    let holders: &mut [Holder] = &mut bag.holders[..];
    transition { _ -> &mut holders[1] }
}

machine replace(child: &mut Child) { child.value = 41; }
machine read_child(holder: &Holder) -> u64 { holder.child.value }

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[0].child.value = 17;
    let selected: &mut Holder = pick(&mut main.bag);
    selected.sibling = 29;
    replace(&mut selected.child);
    selected.sibling = 31;
    let changed: u64 = read_child(&main.bag.holders[1]);
    let neighbor: u64 = read_child(&main.bag.holders[0]);
    transition changed == 41
        && main.bag.holders[1].sibling == 31
        && neighbor == 17 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
