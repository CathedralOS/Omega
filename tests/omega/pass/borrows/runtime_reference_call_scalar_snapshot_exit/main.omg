// A scalar binding observes a returned reference once before later mutation.
data Main { value: u64; }
machine identity<'input, T>(value: &'input T) -> &'input T { value }
machine Main::main(main: &mut Main) crashes Trap {
    main.value = 73;
    let captured: u64 = identity(&main.value);
    main.value = 19;
    transition captured == 73 && main.value == 19 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
