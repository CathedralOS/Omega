// `data Point [copy]` — the declared type property verifies because every
// field is structurally copyable, with zero runtime cost. `Holder [copy]`
// qualifies only because `Point` declares the property itself.
data Point [copy] {
    x: i32;
    y: i32;
}
data Holder [copy] {
    p: Point;
    tag: i32;
}
data Main { h: Holder; }
machine Main::main(main: &mut Main) {
    main.h.p.x = 60;
    main.h.p.y = 9;
    main.h.tag = 1;
    transition main.h.p.x + main.h.p.y + main.h.tag == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
