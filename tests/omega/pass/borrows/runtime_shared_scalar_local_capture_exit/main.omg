// Both loans observe the one completed helper result. Taking an address
// must not execute its initializer again or replace its original storage.
use omega_language_std::console;

data Counter { calls: u32 in Wrapping; }
data Main { counter: Counter; }

machine sample(counter: &mut Counter) -> u32 {
    counter.calls = counter.calls + 1 as u32 in Wrapping;
    7
}

machine Main::main(main: &mut Main) reaches Console {
    main.counter.calls = 0;
    let value: u32 = sample(&mut main.counter);
    let first: &u32 = &value;
    let second: &u32 = &value;
    transition first == 7 && second == 7 && main.counter.calls == 1 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
