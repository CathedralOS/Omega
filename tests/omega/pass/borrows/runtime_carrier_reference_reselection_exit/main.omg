// Select the reference carrier before crossing its pointer, then read a field.
use omega_language_std::console;

data Cell { stamp: i32; value: i32; ready: bool; }
data Message { stamp: i32; body: &Cell; }
data Main {
    first: Cell;
    second: Cell;
    index: u64 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.first.ready = false;
    main.second.stamp = 5;
    main.second.value = 70;
    main.second.ready = true;
    main.index = 1;
    let messages: [Message; 2] = [
        Message { stamp: 7, body: &main.first },
        Message { stamp: 9, body: &main.second }
    ];
    main.index = 0;
    let first: i32 = messages[main.index].body.value;
    let first_ready: bool = messages[main.index].body.ready;
    main.index = 1;
    let observed: i32 = messages[main.index].body.value;
    let ready: bool = messages[main.index].body.ready;
    transition first == 11 && !first_ready && observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
