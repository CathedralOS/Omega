// A helper can either keep the original reference or replace it.
// The chosen value must remain readable after a call that may pause.
// Expected exit: 0
public boundary trait Scheduler { machine park() reaches suspends; }
public Immediate satisfies Scheduler { machine park() {} }
public data Cell { value: i32; }
public data Output<T> { body: T; }
data Message { left: i32; body: &Cell; right: i32; }
public boundary trait Installer {
    machine install<'storage>(source: &'storage Output<&'storage mut Cell>, output: &mut Output<&'storage Cell>) reaches;
}
public CheckedInstaller satisfies Installer {
    machine install<'storage>(source: &'storage Output<&'storage mut Cell>, output: &mut Output<&'storage Cell>) {
        output = Output { body: &source.body };
    }
}
machine replace<'storage>(holder: &mut Output<&'storage mut Cell>, replacement: &'storage mut Cell) {
    holder = Output { body: replacement };
}
machine keep() {}
machine maybe_retarget<'storage>(flag: bool, holder: &mut Output<&'storage mut Cell>, replacement: &'storage mut Cell) {
    transition flag { true -> replace(holder, replacement) false -> keep() }
}
machine read(message: Message) -> i32 {
    transition message.left == 5 && message.right == 9 { true -> message.body.value _ -> 0 }
}
machine exercise<'storage>(flag: bool, mut holder: Output<&'storage mut Cell>, replacement: &'storage mut Cell) -> i32 suspends reaches Scheduler + Installer {
    maybe_retarget(flag, &mut holder, replacement);
    let borrowed: &Output<&mut Cell> = &holder;
    let sentinel: Cell = Cell { value: 0 };
    let mut output: Output<&Cell> = Output { body: &sentinel };
    Installer::install(borrowed, &mut output);
    let saved: &Cell = output.body;
    let message: Message = Message { left: 5, body: saved, right: 9 };
    suspend Scheduler::park();
    read(message)
}
machine invoke(flag: bool) -> i32 suspends reaches Scheduler + Installer {
    let mut original: Cell = Cell { value: 11 };
    let mut replacement: Cell = Cell { value: 73 };
    let holder: Output<&mut Cell> = Output { body: &mut original };
    suspend exercise(flag, holder, &mut replacement)
}
machine main() reaches Scheduler + Installer crashes Trap {
    let changed: i32 = suspend invoke(true);
    let unchanged: i32 = suspend invoke(false);
    transition changed == 73 && unchanged == 11 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
