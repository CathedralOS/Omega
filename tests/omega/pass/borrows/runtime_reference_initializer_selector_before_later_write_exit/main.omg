// A reference initializer evaluates a collection's selector before a later
// selector in the same address. When that later selector writes the place the
// earlier one read, the loan still selects the row the earlier read produced:
// the cell at row 1 holds 10, the cell at row 0 holds 20, and the program exits
// 70 only when it reads 10 and the call left the cursor on row 0.
use omega_language_std::console;

data Cell { value: u64 in Wrapping; }
data Holder { cells: [Cell; 4]; }
data Matrix { rows: [Holder; 2]; }
data Cursor where row < 2 { row: u64; }
data Main { matrix: Matrix; cursor: Cursor; }

machine Cursor::advance(cursor: &mut Cursor) -> u64
ensures result < 4
{
    cursor.row = 0;
    2
}

machine probe(matrix: &Matrix, cursor: &mut Cursor) -> u64 in Wrapping {
    let cell: &Cell = &matrix.rows[cursor.row].cells[Cursor::advance(cursor)];
    cell.value
}

machine Main::main(main: &mut Main) reaches Console {
    main.matrix.rows[1].cells[2].value = 10;
    main.matrix.rows[0].cells[2].value = 20;
    main.cursor.row = 1;
    let observed: u64 in Wrapping = probe(&main.matrix, &mut main.cursor);
    transition observed == 10 && main.cursor.row == 0 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
