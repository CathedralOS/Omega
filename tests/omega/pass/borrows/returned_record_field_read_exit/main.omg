// Read the address actually returned by a runtime choice, including a nested
// field offset. A static origin substituted for that address fails one choice.
use omega_language_std::console;

data Child { value: u64; }
data Holder { padding: u64; child: Child; }
data Bag { holders: [Holder; 2]; }
data Main { bag: Bag; }

machine pick(bag: &mut Bag, second: bool) -> &mut Holder {
    let holders: &mut [Holder] = &mut bag.holders[..];
    transition second {
        true -> &mut holders[1]
        false -> &mut holders[0]
    }
}

machine inspect(bag: &mut Bag, second: bool) -> u64 {
    let selected: &mut Holder = pick(bag, second);
    selected.child.value
}

machine Main::main(main: &mut Main) reaches Console {
    main.bag.holders[0].padding = 7;
    main.bag.holders[0].child.value = 17;
    main.bag.holders[1].padding = 11;
    main.bag.holders[1].child.value = 43;
    let second: u64 = inspect(&mut main.bag, true);
    let first: u64 = inspect(&mut main.bag, false);
    transition second == 43 && first == 17 {
        true -> finish(main, 70)
        false -> finish(main, 71)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
