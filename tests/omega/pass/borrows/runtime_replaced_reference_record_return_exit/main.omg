data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; }

machine replaced<'storage>(input: &'storage Cell) -> Held<'storage> {
    let local: Cell = Cell { value: 71 };
    let mut result: Held<'storage> = Held { target: &local };
    result = Held { target: input };
    result
}

machine forward<'storage>(value: Held<'storage>) -> Held<'storage> { value }

machine main() crashes Trap {
    let original: Cell = Cell { value: 17 };
    let returned: Held = replaced(&original);
    let anonymous: Held = forward(replaced(&original));
    let other: Cell = Cell { value: 23 };
    let mut current: Held = Held { target: &other };
    current = replaced(&other);
    current = replaced(&original);
    let named: Held = forward(current);
    transition returned.target.value == 17
        && anonymous.target.value == 17
        && named.target.value == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
