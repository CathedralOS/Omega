data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; }

machine replaced<'storage>(input: &'storage Cell) -> Held<'storage> {
    let local: Cell = Cell { value: 71 };
    let mut result: Held<'storage> = Held { target: &local };
    result = Held { target: input };
    result
}

machine main() crashes Trap {
    let original: Cell = Cell { value: 17 };
    let returned: Held = replaced(&original);
    transition returned.target.value == 17 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
