// The selected source provider returns the actual descriptor and original
// backing loan, not a length-only signature result or a builtin substitution.
data Window { }
data WindowBody { }

boundary requirement Window::middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
requires start <= end && end <= bytes.len;

machine WindowBody::middle(bytes: &[u8], start: u64, end: u64) -> &[u8]
    satisfies Window::middle
requires start <= end && end <= bytes.len {
    bytes[start..end]
}

machine first(bytes: &[u8]) -> u8 {
    transition bytes.len > 0 {
        true -> read(bytes)
        _ -> (0)
    }
    machine read(bytes: &[u8]) -> u8 { bytes[0] }
}

data Main { bytes: [u8; 4]; }

machine Main::main(main: &mut Main) crashes Trap {
    main.bytes[1] = 70;
    let middle: &[u8] = Window::middle(&main.bytes, 1, 3);
    let nested: u8 = first(Window::middle(&main.bytes, 1, 3));
    transition middle.len == 2 && middle[0] == 70 && nested == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
