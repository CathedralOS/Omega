// An exclusive `&mut [i32; 8]` arrival lent whole to a shared `&[i32; 8]`
// formal, from the machine's entry and from a later state that also holds
// a second exclusive array. The callee reads through the same root pointer
// the caller received; Omega legalization routes the whole-root shared loan
// through the arrival's custody exactly like a field or element projection.
// Before, only projected shared loans had that route, so the whole root
// fell through every route with `SourceCustodyMismatch`
// (samples/cli/simulation/game_of_life_glider's `live_neighbors(grid, ..)`).
// Cells 3 and 5 hold 30 and 40, both read back -> exit 70.
use omega_language_std::console;

data Main {
    grid: [i32; 8];
}

machine Main::main(main: &mut Main) reaches Console {
    main.grid[3] = 30;
    main.grid[5] = 40;
    let total: i32 = sum_cells(&mut main.grid);
    transition total == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}

machine sum_cells(grid: &mut [i32; 8]) -> i32 {
    let first: i32 = read_cell(grid, 3);
    let mut scratch: [i32; 8];
    transition { _ -> second(grid, &mut scratch, first) }

    state second(grid: &mut [i32; 8], scratch: &mut [i32; 8], first: i32) -> i32 {
        let value: i32 = read_cell(grid, 5);
        scratch[5] = value;
        transition { _ -> finish(first, value) }
    }
    state finish(first: i32, value: i32) -> i32 {
        transition first == 30 && value == 40 {
            true -> matched()
            _ -> mismatched()
        }
    }
    state matched() -> i32 { 70 }
    state mismatched() -> i32 { 1 }
}

machine read_cell(grid: &[i32; 8], index: i32) -> i32
requires index >= 0 && index < 8;
{
    grid[index]
}
