// A transition over a borrowed sum is the same closed case dispatch an
// owned subject takes: each arm's case edge binds that case's payloads
// and may forward them as successor arguments. Shared and mutable loans
// take the same route; the caller keeps its value.
data Duo {
    case Left(a: u64 in Wrapping);
    case Right(b: u64 in Wrapping, c: u64 in Wrapping);
}

machine Duo::code(duo: &Duo) -> u64 in Wrapping {
    transition duo {
        Duo::Left { a } -> value(a)
        Duo::Right { b, c } -> value(b + c)
    }
    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

machine Duo::code_mutable(duo: &mut Duo) -> u64 in Wrapping {
    transition duo {
        Duo::Left { a } -> value(a)
        Duo::Right { b, c } -> value(b + c)
    }
    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

data Main {}

machine Main::main(main: &mut Main) crashes Trap {
    let left: Duo = Duo::Left { a: 30 };
    let mut right: Duo = Duo::Right { b: 20, c: 20 };
    let first: u64 in Wrapping = Duo::code(&left);
    let second: u64 in Wrapping = Duo::code_mutable(&mut right);
    let again: u64 in Wrapping = Duo::code(&right);
    transition (first + second) == 70 && again == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
