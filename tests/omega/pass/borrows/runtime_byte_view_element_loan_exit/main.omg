// A call lends one element of a byte view (`&bytes[i]` over `&[u8]`,
// `&mut [u8]` or `&mut [u8; 6]`) to a `&u8` or `&mut u8` formal, from the
// machine's own parameter and from a state arrival, at a literal or runtime
// index. The loan names the view's backing byte, so a write through it lands
// in the caller's array and a read sees the byte the view selects.
// Expected exit: 70.
use omega_language_std::console;

data Main { bytes: [u8; 6]; }

machine is_letter_l(byte: &u8) -> bool {
    transition byte == 108 { true -> (true) _ -> (false) }
}

machine set_f(byte: &mut u8) {
    byte = 102;
}

machine first_is_h(text: &[u8]) -> bool
requires text.len > 0
{
    let found: bool = is_letter_h(&text[0]);
    transition found { true -> (true) _ -> (false) }
}

machine is_letter_h(byte: &u8) -> bool {
    transition byte == 104 { true -> (true) _ -> (false) }
}

machine set_in_array(bytes: &mut [u8; 6], index: u64) -> bool
requires index < 6
{
    set_f(&mut bytes[index]);
    transition { _ -> (true) }
}

machine third_is_l(text: &[u8]) -> bool {
    transition text.len > 2 {
        true -> check(text)
        _ -> (false)
    }
    state check(text: &[u8]) -> bool
    requires text.len > 2
    {
        let found: bool = is_letter_l(&text[2]);
        transition found { true -> (true) _ -> (false) }
    }
}

machine set_at(bytes: &mut [u8], index: u64) -> bool {
    transition index < bytes.len {
        true -> at(bytes, index)
        _ -> (false)
    }
    state at(bytes: &mut [u8], index: u64) -> bool
    requires index < bytes.len
    {
        set_f(&mut bytes[index]);
        transition { _ -> (true) }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[0] = 104;
    main.bytes[1] = 101;
    main.bytes[2] = 108;
    main.bytes[3] = 108;
    main.bytes[4] = 111;
    main.bytes[5] = 0;
    let view: &[u8] = &main.bytes[..];
    let found: bool = third_is_l(view);
    let first: bool = first_is_h(view);
    let writable: &mut [u8] = &mut main.bytes[..];
    let stored: bool = set_at(writable, 1);
    let arrayed: bool = set_in_array(&mut main.bytes, 4);
    transition found && first && stored && arrayed
        && main.bytes[1] == 102 && main.bytes[2] == 108 && main.bytes[4] == 102
    {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
