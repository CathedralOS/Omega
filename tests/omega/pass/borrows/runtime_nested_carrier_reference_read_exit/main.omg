// Select the reference carrier before crossing its pointer, then read a field.
use omega_language_std::console;

data Cell { stamp: i32; value: i32; ready: bool; }
data Message { stamp: i32; body: &Cell; }
data Envelope { stamp: i32; message: &Message; }
data Main {
    first: Cell;
    second: Cell;
    index: u64 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.first.ready = false;
    main.second.stamp = 5;
    main.second.value = 70;
    main.second.ready = true;
    main.index = 1;
    let first_message: Message = Message { stamp: 7, body: &main.first };
    let second_message: Message = Message { stamp: 9, body: &main.second };
    let envelopes: [Envelope; 2] = [
        Envelope { stamp: 13, message: &first_message },
        Envelope { stamp: 17, message: &second_message }
    ];
    let observed: i32 = envelopes[main.index].message.body.value;
    let ready: bool = envelopes[main.index].message.body.ready;
    transition observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
