use omega_language_std::console;

data Cell [copy] { value: u64; stamp: u64; }
data Main { cells: [Cell; 9]; }

machine combine<'destination>(
    first: &Cell,
    second: &Cell,
    third: &Cell,
    fourth: &Cell,
    fifth: &Cell,
    sixth: &Cell,
    seventh: &Cell,
    eighth: &Cell,
    destination: &'destination mut Cell
) -> &'destination mut Cell {
    destination.value = first.value | second.value | third.value | fourth.value
        | fifth.value | sixth.value | seventh.value | eighth.value;
    destination.stamp = 91;
    destination
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells[0].value = 2;
    main.cells[1].value = 4;
    main.cells[2].value = 64;
    main.cells[3].value = 2;
    main.cells[4].value = 4;
    main.cells[5].value = 64;
    main.cells[6].value = 2;
    main.cells[7].value = 4;
    main.cells[8].value = 17;
    let first: &Cell = &main.cells[0];
    let selected: &mut Cell = combine(first, &main.cells[1], &main.cells[2], &main.cells[3],
        &main.cells[4], &main.cells[5], &main.cells[6], &main.cells[7],
        &mut main.cells[8]);
    let reported: u64 = selected.value;
    let stamp: u64 = selected.stamp;
    transition reported == 70 && stamp == 91
        && main.cells[8].value == 70 && main.cells[8].stamp == 91
        && main.cells[0].value == 2 && main.cells[7].value == 4 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
