// Expected exit: 0.
// A complete recursive scratch-write frame must preserve the sibling bound.
use omega::language::core::float_operations;
data Work { count: u64; scratch: f64; }
machine main() crashes Trap {
    let mut work: Work;
    work.count = 3;
    transition work.count <= 8 { true -> guarded(&mut work) false -> bad() }
    state guarded(work: &mut Work) requires work.count <= 8 {
        fill(work, 2);
        require_bound(work);
        transition work.scratch == 2.0 && work.count == 3 { true -> good() false -> bad() }
    }
    state good() {  }
    state bad() { crash Trap; }
}
machine fill(work: &mut Work, remaining: u64) {
    transition remaining > 0 { true -> write(work, remaining) false -> done() }
    state write(work: &mut Work, remaining: u64) requires remaining > 0 {
        work.scratch = 2.0;
        transition { _ -> fill(work, remaining - 1) }
    }
    state done() { }
}
machine require_bound(work: &Work) requires work.count <= 8 { }
