// Cross two stored references before retiring both owners and restoring backing.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { prefix: i32; value: i32; ready: bool; }
data Message { stamp: i32; body: &Cell; }
data Envelope { stamp: i32; message: &Message; }
data Main { cell: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.prefix = 29;
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { stamp: 11, body: &main.cell };
    let envelope: Envelope = Envelope { stamp: 12, message: &message };
    let observed: i32 = envelope.message.body.value;
    require_cell_value(observed);
    let ready: bool = envelope.message.body.ready;
    let stamp: i32 = envelope.message.stamp;
    let envelope_stamp: i32 = envelope.stamp;
    main.cell.value = 81;
    transition observed == 70 && ready && stamp == 11 && envelope_stamp == 12 && main.cell.value == 81 && main.cell.prefix == 29 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

machine require_cell_value(value: i32)
requires value >= 0 && value <= 100
{}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
