// Indexed primitive loans retain their caller backing through locals, copies and calls.
data Byte where value >= 0 && value <= 1 { prefix: u64; value: u8; suffix: u32; }
data Row { cells: [Byte; 3]; tag: u64; }
data Main { rows: [Row; 2]; }
machine take(value: &u8) -> u8 { value }
machine verify(value: &u8) crashes Trap {
    transition value == 1 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
machine verify_expected(expected: u8, value: &u8) crashes Trap {
    transition value == expected { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
machine verify_projection(expected: u8, row: u64, main: &Main, column: u64) crashes Trap
requires row < 2, column < 3
{
    verify_expected(expected, &main.rows[row].cells[column].value);
}
machine inspect(row: u64, main: &Main, column: u64) -> u8 crashes Trap {
    transition row < 2 && column < 3 {
        true -> selected(row, main, column)
        _ -> 0
    }
    state selected(row: u64, main: &Main, column: u64) -> u8 {
        let selected_value: &u8 = &main.rows[row].cells[column].value;
        let got: u8 = take(selected_value);
        verify_projection(got, row, main, column);
        verify_expected(got, &main.rows[row].cells[column].value);
        got
    }
}
machine copied_read(row: u64, main: &Main, column: u64) -> u8
requires row < 2, column < 3
{
    let selected_value: &u8 = &main.rows[row].cells[column].value;
    let copied_value: &u8 = selected_value;
    take(copied_value)
}
machine captured_read(row: u64, main: &Main, column: u64) -> u8
requires row < 2, column < 3
{
    let mut later_row: u64 = row;
    let selected_value: &u8 = &main.rows[later_row].cells[column].value;
    later_row = 0;
    let copied_value: &u8 = selected_value;
    take(copied_value)
}
machine exclusive_read(row: u64, main: &mut Main, column: u64) -> u8 crashes Trap
requires row < 2, column < 3
{
    let mut later_row: u64 = row;
    let selected_value: &mut u8 = &mut main.rows[later_row].cells[column].value;
    later_row = 0;
    verify(selected_value);
    take(selected_value)
}
machine Main::main(main: &mut Main) crashes Trap {
    main.rows[1].cells[2].prefix = 123;
    main.rows[1].cells[2].value = 1;
    main.rows[1].cells[2].suffix = 456;
    main.rows[1].tag = 789;
    let chosen: u8 = inspect(1, main, 2);
    let copied: u8 = copied_read(1, main, 2);
    let captured: u8 = captured_read(1, main, 2);
    let exclusive: u8 = exclusive_read(1, main, 2);
    let neighbor: u8 = inspect(1, main, 1);
    let other_row: u8 = inspect(0, main, 2);
    let outside: u8 = inspect(1, main, 3);
    transition chosen == 1 && copied == 1 && captured == 1 && exclusive == 1 && neighbor == 0 && other_row == 0 && outside == 0
        && main.rows[1].cells[2].prefix == 123
        && main.rows[1].cells[2].suffix == 456 && main.rows[1].tag == 789 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
