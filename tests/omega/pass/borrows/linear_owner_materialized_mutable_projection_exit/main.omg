use omega_language_std::console;
use omega::language::core::drop;

data Receipt [linear] { code: i32; stamp: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
machine update(receipt: &mut Receipt, stamp: i32) { receipt.stamp = stamp; }
machine observe(receipt: &Receipt) -> i32 { receipt.code }
machine observe_stamp(stamp: &i32) -> i32 { stamp }
machine observe_and_consume(receipt: Receipt) -> i32 {
    let view: &Receipt = &receipt;
    let observed: i32 = observe(view);
    drop(receipt);
    observed
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut receipt: Receipt = Receipt { stamp: 0, code: 27 };
    let view: &mut Receipt = &mut receipt;
    update(view, 43);
    let observed: i32 = observe(&receipt);
    let stamp_view: &i32 = &receipt.stamp;
    let stamp: i32 = observe_stamp(stamp_view);
    let transferred: i32 = observe_and_consume(receipt);
    transition observed == 27 && stamp == 43 && transferred == 27 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
