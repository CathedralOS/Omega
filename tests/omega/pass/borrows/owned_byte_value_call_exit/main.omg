use omega_language_std::console;

domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);

data Main {
    writer: Writer;
    line: [u8; 16] in Utf8;
    sibling: u64;
}

data Writer {}

machine Writer::replace(value: [u8; 16] in Utf8, line: &mut [u8; 16] in Utf8) {
    line = value;
}

machine returned_line() -> [u8; 16] in Utf8 { "é" }

machine Main::main(main: &mut Main) reaches Console {
    main.sibling = 29;
    Writer::replace("Wanderer", &mut main.line);
    let literal_matches: bool = main.line == "Wanderer" && main.line.len == 8;
    Writer::replace("é", &mut main.line);
    let unicode_matches: bool = main.line == "é" && main.line.len == 2;
    let joined: [u8; 16] in Utf8 = "Ga" + "te";
    Writer::replace(joined, &mut main.line);
    let joined_matches: bool = main.line == "Gate" && main.line.len == 4;
    let returned: [u8; 16] in Utf8 = returned_line();
    Writer::replace(returned, &mut main.line);
    let returned_matches: bool = main.line == "é" && main.line.len == 2;
    Writer::replace("", &mut main.line);
    transition literal_matches && unicode_matches && joined_matches && returned_matches
        && main.line.len == 0 && main.sibling == 29 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
