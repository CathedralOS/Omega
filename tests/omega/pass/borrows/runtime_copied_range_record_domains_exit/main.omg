domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Room [copy] { label: [u8; 8] in Utf8; value: u64; }
data Main { rooms: [Room; 3]; }

machine visit(rooms: &mut [Room], index: u64) -> u64
requires index < rooms.len
{
    rooms[index].value = 70;
    rooms[index].value
}

machine Main::main(main: &mut Main) crashes Trap {
    main.rooms[0].label = "hall";
    main.rooms[1].label = "vault";
    let measured: u64 = main.rooms.len;
    let mut copied: u64 = measured;
    let rooms: &mut [Room] = &mut main.rooms[0..copied];
    copied = 0;
    let before: u64 = rooms[1].value;
    let visited: u64 = visit(rooms, 1);
    transition before == 0 && copied == 0 && visited == 70 && main.rooms[1].label == "vault" {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
