// The carry property's authored spelling: one closed compiler
// property with four mandatory axes — `suspension`, `cpu`,
// `thread`, `address` — declared per data type. Nested and
// case-payload members validate structurally through it.
data Packet [carry(
    suspension: allowed,
    cpu: any,
    thread: any,
    address: movable,
)] {
    id: i32;
    case Empty;
    case Burst(count: i32, priority: u8);
}
data Envelope [carry(
    suspension: allowed,
    cpu: any,
    thread: any,
    address: movable,
)] {
    inner: Packet;
    stamp: i64;
}
data Main {}
machine Main::main(main: &mut Main) { }
