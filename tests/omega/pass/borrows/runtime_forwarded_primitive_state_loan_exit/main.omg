use omega_language_std::console;

data Main { count: u64; }

machine Main::update(main: &mut Main) {
    transition { _ -> first(&mut main.count) }
    state first(value: &mut u64) {
        value = ((value as u64 in Wrapping) + 1) as u64;
        transition { _ -> second(value) }
    }
    state second(value: &mut u64) {
        value = ((value as u64 in Wrapping) + 1) as u64;
        transition value < 70 {
            true -> first(value)
            false -> done()
        }
    }
    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 0;
    Main::update(main);
    transition main.count == 70 {
        true -> matched(main)
        false -> mismatched(main)
    }
    state matched(main: &mut Main) { Console::exit_process(70); }
    state mismatched(main: &mut Main) { Console::exit_process(71); }
}
