use omega_language_std::console;

data Main { count: u64; }

machine Main::update(main: &mut Main) {
    transition { _ -> first(&mut main.count) }
    machine first(value: &mut u64) {
        value = ((value as u64 in Wrapping) + 1) as u64;
        transition { _ -> second(value) }
    }
    machine second(value: &mut u64) {
        value = ((value as u64 in Wrapping) + 1) as u64;
        transition value < 70 {
            true -> first(value)
            false -> done()
        }
    }
    machine done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 0;
    Main::update(main);
    transition main.count == 70 {
        true -> matched(main)
        false -> mismatched(main)
    }
    machine matched(main: &mut Main) { Console::exit_process(70); }
    machine mismatched(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
