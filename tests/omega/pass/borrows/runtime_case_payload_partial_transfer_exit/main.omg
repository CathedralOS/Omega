data Token { value: i32; }
data Pair { first: Token; second: Token; }
data Choice {
    stamp: i32;
    case Present(pair: Pair, unused: Token);
    case Other(first: Token, second: Token, third: Token);
}
data Envelope { choice: Choice; }

machine inspect(envelope: Envelope) -> bool {
    let stamp: i32 = envelope.choice.stamp;
    transition envelope.choice {
        Choice::Present { stamp as _, pair, unused } -> observe(pair.first, stamp)
        _ -> (false)
    }
    state observe(first: Token, stamp: i32) -> bool {
        first.value == 42 && stamp == 44
    }
}

machine main() crashes Trap {
    let envelope: Envelope = Envelope { choice: Choice::Present {
        pair: Pair { first: Token { value: 42 }, second: Token { value: 43 } },
        unused: Token { value: 45 },
        stamp: 44
    } };
    let result: bool = inspect(envelope);
    transition result {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
