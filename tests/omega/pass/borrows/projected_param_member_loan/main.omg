use omega_language_std::console;
use omega::language::core::binding;

data Inner {
    tag: u32;
}

data Main {
    console: Binding<Console>;
    inner: Inner;
}

machine Main::main(&mut self) reaches Console {
    self.inner.tag = 9;
    transition true { _ -> next(&self.inner) }

    state next(&mut self, loan: &Inner) {
        transition loan.tag == 9 { true -> done() _ -> bad() }
    }

    state done(&mut self) {
        self.console.exit_process(0);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
