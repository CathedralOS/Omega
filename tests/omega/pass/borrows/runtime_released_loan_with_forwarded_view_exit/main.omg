use omega_language_std::console;
use omega::language::core::binding;

data Counter { count: u64; }

// The count loan ends at writeback. Forwarding unrelated backing must not
// extend that loan into a state which mutates its former referent.
machine Counter::update(counter: &mut Counter, bytes: &[u8]) {
    transition { _ -> snapshot(counter, &counter.count, bytes) }
    state snapshot(counter: &mut Counter, count: &u64, bytes: &[u8]) {
        let saved: u64 = count;
        transition { _ -> writeback(counter, saved, bytes) }
    }
    state writeback(counter: &mut Counter, saved: u64, bytes: &[u8]) {
        counter.count = ((saved as u64 in Wrapping) + (bytes.len as u64 in Wrapping)) as u64;
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let bytes: [u8; 3];
    let mut counter: Counter;
    counter.count = 67;
    Counter::update(&mut counter, &bytes[..]);
    transition counter.count == 70 {
        true -> matched(&main.console)
        false -> mismatched(&main.console)
    }
    state matched(console: &Binding<Console>) {
        Console::exit_process(console, 70);
    }
    state mismatched(console: &Binding<Console>) {
        Console::exit_process(console, 71);
    }
}
