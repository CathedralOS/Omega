use omega::language::core::binding;
use omega_language_std::console;

data Main { console: Binding<Console>; count: u64; }

// The count loan ends at writeback. Forwarding unrelated backing must not
// extend that loan into a state which mutates its former referent.
machine Main::update(main: &mut Main, bytes: &[u8]) {
    transition { _ -> snapshot(main, &main.count, bytes) }
    state snapshot(main: &mut Main, count: &u64, bytes: &[u8]) {
        let saved: u64 = count;
        transition { _ -> writeback(main, saved, bytes) }
    }
    state writeback(main: &mut Main, saved: u64, bytes: &[u8]) {
        main.count = ((saved as u64 in Wrapping) + (bytes.len as u64 in Wrapping)) as u64;
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let bytes: [u8; 3];
    main.count = 67;
    Main::update(main, &bytes[..]);
    transition main.count == 70 {
        true -> matched(main)
        false -> mismatched(main)
    }
    state matched(main: &mut Main) {
        main.console.exit_process(70);
    }
    state mismatched(main: &mut Main) {
        main.console.exit_process(71);
    }
}
