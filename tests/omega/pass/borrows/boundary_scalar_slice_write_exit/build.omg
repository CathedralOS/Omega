machine build(builder: &mut Build) {
    Build::application(builder, "boundary_scalar_slice_write_exit");
    Build::select_provider<Fill, ScalarWriter>(builder, linux_arm64);
    Build::select_provider<Fill, ScalarWriter>(builder, linux_x86_64);
    Build::select_provider<Fill, ScalarWriter>(builder, macos_arm64);
    Build::select_provider<Fill, ScalarWriter>(builder, macos_x86_64);
    Build::select_provider<Fill, ScalarWriter>(builder, windows_x86_64);
    Build::select_provider<Fill, ScalarWriter>(builder, uefi_x86_64);
    Build::select_provider<Fill, ScalarWriter>(builder, cross_platform_cli);
    Build::select_provider<Fill, ScalarWriter>(builder, local_unchecked);
    Build::select_provider<Fill, ScalarWriter>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
