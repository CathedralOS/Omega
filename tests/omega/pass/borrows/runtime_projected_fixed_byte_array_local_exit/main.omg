// A fixed byte view formed from a record field is a descriptor carrier,
// not an ordinary Reference-shaped carrier. Its local must retain backing.
data Storage { prefix: u64; bytes: [u8; 65536]; numbers: [u32; 17]; suffix: u64; }
data Countdown where remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }

machine identity(value: Countdown) -> Countdown
ensures result.remaining == value.remaining;
{ value }

machine walk(countdown: Countdown, padding: &[u8; 65536])
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition { _ -> iterate(identity(countdown), Countdown { remaining: 4 }, padding) }
    machine iterate(held: Countdown, spare: Countdown, padding: &[u8; 65536]) -> u64 {
        transition held.remaining > 0 {
            true -> iterate(identity(Countdown { remaining: held.remaining - 1 }), spare, padding)
            false -> held.remaining
        }
    }
}

machine read_ends(bytes: &[u8; 65536]) -> u64 {
    (bytes[0] as u64) + (bytes[65535] as u64)
}

machine read_numbers(numbers: &[u32; 17]) -> u64 {
    (numbers[0] as u64) + (numbers[16] as u64)
}

machine main() crashes Trap {
    let mut storage: Storage;
    storage.prefix = 71;
    storage.suffix = 83;
    storage.bytes[0] = 17;
    storage.bytes[65535] = 29;
    storage.numbers[0] = 17;
    storage.numbers[16] = 29;
    let numbers: &[u32; 17] = &storage.numbers;
    let observed_numbers: u64 = read_numbers(numbers);
    let directly_observed_numbers: u64 = (numbers[0] as u64) + (numbers[16] as u64);
    let selected: &[u8; 65536] = &storage.bytes;
    let observed: u64 = read_ends(selected);
    let directly_observed: u64 = (selected[0] as u64) + (selected[65535] as u64);
    let remaining: u64 = walk(Countdown { remaining: 5 }, selected);
    transition observed == 46 && directly_observed == 46 && observed_numbers == 46 && directly_observed_numbers == 46 && remaining == 0 && storage.prefix == 71 && storage.suffix == 83 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
