// An exclusive loan of a plain record, forwarded from one state to the next,
// stays the usable name for its referent through that state's continuations:
// the state reborrows it for a call, and its conditional arms read it after
// the call's writes. When the helper returns, the loan ends and the caller's
// own field reads observe every write made through it.
//
//   pick(1):  count -> observed 1, arm reads values[1] 30 + 1 = 31
//   pick(2):  count -> observed 2, arm reads values[2] 36 + 2 = 38
//   exit 31 + 38 + reads 2 - 1 = 70
//
// An arm that reads an ended loan or a snapshot misses 70.
// Expected exit: 70.

use omega_language_std::console;

data Store {
    values: [i32 in Wrapping; 4];
    reads: i32 in Wrapping;
}

data Main {
    store: Store;
}

machine Store::count(store: &mut Store) -> i32 in Wrapping {
    store.reads = store.reads + 1;
    store.reads
}

machine Store::pick(store: &mut Store, index: i32) -> i32 in Wrapping {
    transition index == 0 {
        true -> (store.values[0])
        _ -> next(store, index)
    }

    state next(store: &mut Store, index: i32) {
        let observed: i32 in Wrapping = Store::count(store);
        transition index == 1 {
            true -> (store.values[1] + observed)
            _ -> (store.values[2] + observed)
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.store.values[1] = 30;
    main.store.values[2] = 36;
    let first: i32 in Wrapping = Store::pick(&mut main.store, 1);
    let second: i32 in Wrapping = Store::pick(&mut main.store, 2);
    let code: i32 in Wrapping = first + second + main.store.reads - 1;
    Console::exit_process(code as i32);
}
