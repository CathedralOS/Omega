// Expected exit: 0
// An erased input has no runtime slot, so it must not shift which input a
// returned reference borrows. Each helper returns its real input from behind
// an erased one: directly, inside a record, through a forwarding call, and
// crossed between two real inputs, and as the second of two real inputs behind
// the erased one. Writing a different input stays allowed.
data Holder<'storage> { target: &'storage mut u64; tag: u64; }
data Pair<'storage> { first: &'storage mut u64; second: &'storage mut u64; }

machine direct<'storage>(witness [erased]: &u64, target: &'storage mut u64) -> &'storage mut u64 { target }
machine wrapped<'storage>(witness [erased]: &u64, tag: u64, target: &'storage mut u64) -> Holder<'storage> {
    Holder { target: target, tag: tag }
}
machine forwarded<'storage>(witness [erased]: &u64, tag: u64, target: &'storage mut u64) -> &'storage mut u64 {
    direct(witness, target)
}
machine crossed<'storage>(left: &'storage mut u64, witness [erased]: &u64, right: &'storage mut u64) -> Pair<'storage> {
    Pair { first: right, second: left }
}

machine second_of_two<'storage>(witness [erased]: &u64, first: &'storage mut u64, second: &'storage mut u64) -> &'storage mut u64 { second }

machine exercise(proof [erased]: &u64, one: &mut u64, two: &mut u64, other: &mut u64) -> u64 {
    let first: &mut u64 = direct(proof, one);
    other = 1;
    first = 10;
    let mut second: Holder = wrapped(proof, 4, two);
    other = 2;
    second.target = 20;
    let third: &mut u64 = forwarded(proof, 4, one);
    other = 3;
    third = 30;
    let mut fourth: Pair = crossed(one, proof, two);
    other = 4;
    fourth.first = 40;
    let fifth: &mut u64 = second_of_two(proof, other, two);
    one = 5;
    fifth = 50;
    two
}

machine main() crashes Trap {
    let proof: u64 = 0;
    let mut one: u64 = 0;
    let mut two: u64 = 0;
    let mut other: u64 = 0;
    let total: u64 = exercise(&proof, &mut one, &mut two, &mut other);
    transition total == 50 && one == 5 && two == 50 && other == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
