// A returned reference transfers into the record; exit must not release its former home.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { value: i32; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Main { cell: Cell; }

machine borrow(cell: &mut Cell) -> &mut Cell { cell }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    main.cell.ready = true;
    let borrowed: &mut Cell = borrow(&mut main.cell);
    let message: Message = Message { body: borrowed, stamp: 11 };
    let observed: i32 = message.body.value;
    let ready: bool = message.body.ready;
    main.cell.value = 81;
    let stamp: i32 = message.stamp;
    transition observed == 70 && ready && stamp == 11 && main.cell.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
