data Held { slot: &mut u32; }
machine replace(slot: &mut u32) { slot = 9; }
machine main() crashes Trap {
    let mut value: u32 = 7;
    let held: Held = Held { slot: &mut value };
    replace(held.slot);
    transition value == 9 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
