// Expected exit: 0. A selected loan retains its captured element after the
// selector changes, and only the selected match arm lends writable storage.
data Cell { value: u32; stamp: u32; }
data Grid where cursor < 3 { cells: [Cell; 3]; cursor: u64; selections: u32 in Wrapping; }
machine next(grid: &mut Grid) -> u64
ensures result < 3
{
    let saved: u64 = grid.cursor;
    grid.selections = grid.selections + 1;
    grid.cursor = 2;
    saved
}
machine choose(grid: &mut Grid, flag: bool) -> &mut Cell {
    match flag {
        true -> &mut grid.cells[next(grid)],
        _ -> &mut grid.cells[0]
    }
}
machine fixed(grid: &mut Grid) -> &mut Cell {
    let index: u64 = 1;
    &mut grid.cells[index]
}
machine captured(grid: &mut Grid) -> &mut Cell {
    let mut index: u64 = 1;
    let selected: &mut Cell = &mut grid.cells[index];
    index = 2;
    selected
}
machine confirm(grid: &mut Grid) {
    let selected: &mut Cell = fixed(grid);
    selected.value = 41;
    let held: &mut Cell = captured(grid);
    held.value = 70;
}
machine relay(grid: &mut Grid, flag: bool) -> &mut Cell {
    choose(grid, flag)
}
machine update(grid: &mut Grid, flag: bool) {
    let selected: &mut Cell = relay(grid, flag);
    selected.value = 70;
}
machine main() crashes Trap {
    let mut grid: Grid;
    grid.cells[0].stamp = 11;
    grid.cells[1].stamp = 17;
    grid.cells[2].stamp = 23;
    grid.cursor = 1;
    update(&mut grid, true);
    transition grid.cells[0].value == 0 && grid.cells[1].value == 70
        && grid.cells[2].value == 0 && grid.cells[1].stamp == 17
        && grid.selections == 1 {
        true -> other(&mut grid)
        _ -> bad()
    }
    machine other(grid: &mut Grid) {
        grid.cells[1].value = 0;
        grid.cursor = 1;
        update(grid, false);
        confirm(grid);
        transition grid.cells[0].value == 70 && grid.cells[1].value == 70
            && grid.cells[2].value == 0 && grid.cells[0].stamp == 11
            && grid.cells[1].stamp == 17 && grid.cells[2].stamp == 23
            && grid.selections == 1 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
