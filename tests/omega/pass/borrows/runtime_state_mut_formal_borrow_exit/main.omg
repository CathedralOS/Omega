// Expected: a later state lends its `mut` scalar formal to `bump`, then
// assigns it from the lent result: 66 becomes 69, then 70, and the program
// exits 70.
use omega_language_std::console;

machine bump(value: &mut u32) {
    value = value / 2 + 36;
}

machine settle(start: u32) -> u32 {
    transition start > 0 {
        true -> adjust(start)
        false -> start
    }
    state adjust(mut amount: u32) {
        bump(&mut amount);
        amount = amount / 3 + 47;
        transition { _ -> amount }
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let settled: u32 = settle(66);
    transition settled == 70 {
        true -> good()
        _ -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}
