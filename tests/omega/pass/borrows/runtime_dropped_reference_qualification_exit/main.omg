// Expected exit: 0. Original borrowed storage retains its live qualification
// after its executable binding disappears at a named-state transfer.
data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue(number: u64) -> Ticket
ensures result in Issued { Ticket { number: number } }

machine preserve(ticket: &mut Ticket) -> bool
requires ticket in Issued
ensures ticket in Issued
{
    transition { _ -> finish() }
    machine finish() -> bool {
        let mut scratch: u64 = 0;
        scratch = 1;
        scratch == 1
    }
}

machine refresh(ticket: &mut Ticket) -> bool
requires ticket in Issued
ensures ticket in Issued
{
    transition { _ -> replace(ticket) }
    machine replace(renamed: &mut Ticket) -> bool {
        renamed = issue(43);
        transition { _ -> finish() }
    }
    machine finish() -> bool { true }
}

machine read(ticket: &Ticket) -> u64
requires ticket in Issued { ticket.number }

machine main() crashes Trap {
    let mut ticket: Ticket = issue(17);
    let unchanged: bool = preserve(&mut ticket);
    let changed: bool = refresh(&mut ticket);
    let observed: u64 = read(&ticket);
    transition unchanged && changed && observed == 43 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
