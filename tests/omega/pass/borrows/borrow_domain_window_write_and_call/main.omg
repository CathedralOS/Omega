domain u64::Upper(value) requires value >= 2;

data WindowBuffer { items: [i32; 4]; }

machine take(slot: &mut i32) {
    slot = 7;
}

machine write_outside_window(context: &mut WindowBuffer, split_point: u64) -> u64
    requires split_point <= 4, split_point in u64::Upper;
{
    let held: &mut [i32] = context.items[split_point..4];
    context.items[0] = 3;
    take(&mut context.items[1]);
    let outside: &mut i32 = &mut context.items[0];
    outside = 5;
    held.len
}

machine main() crashes Trap {
    let mut context: WindowBuffer;
    let length: u64 = write_outside_window(&mut context, 2);
    transition length == 2 && context.items[0] == 5 && context.items[1] == 7 && context.items[2] == 0 {
        true -> passed()
        false -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
