// Copy selectors run once in path order. The owned value is captured before
// later arguments replace its source. A local initializer follows the same law.
data Kind [copy] { case First; case Second; }
data Cursor where row < 2 { row: u64; calls: u32 in Wrapping; }
machine select(cursor: &mut Cursor) -> u64
ensures result < 2
{
    cursor.row = 0;
    cursor.calls = cursor.calls + 1;
    1
}
machine replace(cells: &mut [[Kind; 2]; 2]) -> u32 in Wrapping {
    cells[1][1] = Kind::First;
    0
}
machine tag(kind: Kind, ignored: u32 in Wrapping) -> u32 in Wrapping {
    transition kind {
        Kind::First -> first()
        _ -> second()
    }
    machine first() -> u32 in Wrapping { 1 }
    machine second() -> u32 in Wrapping { 2 }
}
machine local_copy(cells: &[[Kind; 2]; 2], cursor: &mut Cursor) -> u32 in Wrapping crashes Trap {
    let kind: Kind = cells[cursor.row][select(cursor)];
    let value: u32 in Wrapping = tag(kind, 0);
    value
}
machine view_copy(cells: &[Kind], index: u64) -> u32 in Wrapping
requires index < cells.len
{
    let saved: u64 = index;
    let kind: Kind = cells[saved];
    let value: u32 in Wrapping = tag(kind, 0);
    value
}
machine main() crashes Trap {
    let mut cells: [[Kind; 2]; 2] = [[Kind::First, Kind::First], [Kind::First, Kind::First]];
    cells[1][1] = Kind::Second;
    let mut cursor: Cursor = Cursor { row: 1, calls: 0 };
    let first: u32 in Wrapping = tag(cells[cursor.row][select(&mut cursor)], replace(&mut cells));
    cells[1][1] = Kind::Second;
    cursor.row = 1;
    let second: u32 in Wrapping = local_copy(&cells, &mut cursor);
    let flat: [Kind; 2] = [Kind::First, Kind::Second];
    let third: u32 in Wrapping = view_copy(&flat[..], 1);
    transition first == 2 && second == 2 && third == 2 && cursor.row == 0 && cursor.calls == 2 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
