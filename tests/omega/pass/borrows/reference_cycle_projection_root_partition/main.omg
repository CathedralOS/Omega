// A reference-returning machine cycles through two states. Along the cycle the
// second state receives one projection of the chain (`&chain.nodes[position]`)
// after two exact parameters, so the finiteness solver holds five storage roots in
// three components and must address its partition by root, not by component.
data Node { bytes: [u8; 8]; used: u64 }
data Chain { nodes: [Node; 4]; sentinel: Node }

machine find<'c>(chain: &'c Chain, cursor: &'c Node, position: u64) -> &'c [u8] {
    transition { _ -> step(chain, cursor, position) }
    state step(chain: &'c Chain, cursor: &'c Node, position: u64) -> &'c [u8] {
        transition position < 4 {
            true -> check(chain, cursor, &chain.nodes[position], position)
            _ -> (&cursor.bytes[0..0])
        }
    }
    state check(chain: &'c Chain, cursor: &'c Node, node: &'c Node, position: u64) -> &'c [u8]
        requires position < 4
    {
        transition node.used <= 8 {
            true -> (&node.bytes[0..node.used])
            _ -> step(chain, cursor, position + 1)
        }
    }
}

machine Main::main(this: &mut Main) {
    let chain: Chain = Chain { };
    let found: &[u8] = find(&chain, &chain.sentinel, 0);
    let count: u64 = found.len;
}
data Main { }
