// A returned shared reference retains a nonzero fixed index through a state hop.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; buf: [u8; 4]; }

machine Main::second(main: &Main) -> &u8 {
    transition { _ -> selected(main) }
    state selected(owner: &Main) -> &u8 { &owner.buf[1] }
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[0] = 7;
    main.buf[1] = 11;
    let selected: &u8 = Main::second(main);
    transition selected == 11 && main.buf[0] == 7 && main.buf[1] == 11 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
