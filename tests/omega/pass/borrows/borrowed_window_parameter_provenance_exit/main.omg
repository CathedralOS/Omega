// Expected exit: 0
// Borrowed-window moves and replacements preserve provenance when backing or
// replacement values arrive as owned entry parameters, owned block arguments,
// or reassigned locals, without double disposal or a fabricated move window.
data Cell { value: i64; }
data Item { tag: i64; }
data Held<'a> { target: &'a Cell; stamp: i64; }
data Pair<'a> { item: Item; held: Held<'a>; }
data Slot<'a, 'b> { value: &'a mut Held<'b>; }
data PlainSlot<'a> { value: &'a mut Item; }
data Main { left: Cell; right: Cell; extra: Cell; }

machine replace_direct_entry<'a>(mut held: Held<'a>, incoming: Held<'a>) -> bool {
    let slot: &mut Held<'a> = &mut held;
    slot = incoming;
    let observed: i64 = held.target.value;
    observed == 85 && held.stamp == 23
}

machine replace_projected_entry<'a>(mut held: Held<'a>, incoming: Held<'a>) -> bool {
    let mut slot: Slot = Slot { value: &mut held };
    slot.value = incoming;
    let observed: i64 = held.target.value;
    observed == 85 && held.stamp == 23
}

machine replace_owned_carrier_entry<'a>(mut slot: PlainSlot<'a>, incoming: Item) -> bool {
    slot.value = incoming;
    let observed: i64 = slot.value.tag;
    observed == 77
}

machine replace_via_borrowed_carrier_block_parameter<'a>(
    mut slot: PlainSlot<'a>,
    incoming: Item,
    choose: bool
) -> bool {
    transition choose {
        true -> apply(&mut slot, incoming)
        _ -> apply(&mut slot, incoming)
    }

    machine apply(borrowed_slot: &mut PlainSlot<'a>, incoming: Item) -> bool {
        borrowed_slot.value = incoming;
        let observed: i64 = borrowed_slot.value.tag;
        observed == 79
    }
}

machine replace_via_state_incoming<'a>(
    mut held: Held<'a>,
    seed: Held<'a>,
    fallback: &'a Cell,
    choose: bool
) -> bool {
    transition choose {
        true -> apply(held, seed, fallback)
        _ -> apply(held, seed, fallback)
    }

    machine apply(mut arrived: Held<'a>, mut incoming: Held<'a>, fallback: &'a Cell) -> bool {
        let slot: &mut Held<'a> = &mut arrived;
        slot = incoming;
        incoming = Held { target: fallback, stamp: 31 };
        let observed: i64 = arrived.target.value;
        let incoming_ok: bool = incoming.target.value == 50 && incoming.stamp == 31;
        observed == 85 && arrived.stamp == 23 && incoming_ok
    }
}

machine window_move_and_reassigned_local<'a>(
    mut pair: Pair<'a>,
    incoming: Held<'a>,
    fallback: &'a Cell
) -> bool {
    let view: &mut Pair<'a> = &mut pair;
    let moved_item: Item = view.item;
    view.item = Item { tag: 99 };
    let mut local_replacement: Held<'a> = incoming;
    view.held = local_replacement;
    local_replacement = Held { target: fallback, stamp: 19 };
    let item_ok: bool = moved_item.tag == 7 && pair.item.tag == 99;
    let replaced_ok: bool = pair.held.target.value == 85 && pair.held.stamp == 23;
    let reused_ok: bool = local_replacement.target.value == 50 && local_replacement.stamp == 19;
    item_ok && replaced_ok && reused_ok
}

machine main() crashes Trap {
    let mut main: Main = Main {
        left: Cell { value: 11 },
        right: Cell { value: 85 },
        extra: Cell { value: 50 }
    };

    let r1: bool = replace_direct_entry(
        Held { target: &main.left, stamp: 17 },
        Held { target: &main.right, stamp: 23 }
    );
    main.left.value = 29;
    let ok1: bool = r1 && main.left.value == 29;

    main.left.value = 11;
    let r2: bool = replace_projected_entry(
        Held { target: &main.left, stamp: 17 },
        Held { target: &main.right, stamp: 23 }
    );
    main.left.value = 31;
    let ok2: bool = r2 && main.left.value == 31;

    let mut plain_item: Item = Item { tag: 13 };
    let r_carrier: bool = replace_owned_carrier_entry(
        PlainSlot { value: &mut plain_item },
        Item { tag: 77 }
    );
    let ok_carrier: bool = r_carrier && plain_item.tag == 77;

    let r_borrowed_carrier: bool = replace_via_borrowed_carrier_block_parameter(
        PlainSlot { value: &mut plain_item },
        Item { tag: 79 },
        true
    );
    let ok_borrowed_carrier: bool = r_borrowed_carrier && plain_item.tag == 79;

    main.left.value = 11;
    let r3: bool = replace_via_state_incoming(
        Held { target: &main.left, stamp: 17 },
        Held { target: &main.right, stamp: 23 },
        &main.extra,
        true
    );
    main.left.value = 37;
    let ok3: bool = r3 && main.left.value == 37;

    main.left.value = 11;
    let r4: bool = window_move_and_reassigned_local(
        Pair {
            item: Item { tag: 7 },
            held: Held { target: &main.left, stamp: 17 }
        },
        Held { target: &main.right, stamp: 23 },
        &main.extra
    );
    main.left.value = 43;
    let ok4: bool = r4 && main.left.value == 43;

    transition ok1 && ok2 && ok_carrier && ok_borrowed_carrier && ok3 && ok4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
