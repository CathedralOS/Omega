data Cell { value: i64; }
data Held { target: &Cell; stamp: i64; }
data Slot { value: &mut [Held; 2]; }
data Main { left: Cell; right: Cell; }

machine replace(held: &mut Held, incoming: Held) { held = incoming; }

machine Main::main(main: &mut Main) crashes Trap {
    main.left.value = 11;
    main.right.value = 85;
    let mut held: [Held; 2] = [Held { target: &main.left, stamp: 17 }, Held { target: &main.right, stamp: 31 }];
    let incoming: Held = Held { target: &main.right, stamp: 23 };
    let mut slot: Slot = Slot { value: &mut held };
    slot.value[0] = incoming;
    main.left.value = 29;
    let observed: i64 = held[0].target.value;
    let neighbor: i64 = held[1].target.value;
    main.right.value = 41;
    let stamp: i64 = held[0].stamp;
    transition observed == 85 && neighbor == 85 && stamp == 23 && main.left.value == 29 && main.right.value == 41 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
