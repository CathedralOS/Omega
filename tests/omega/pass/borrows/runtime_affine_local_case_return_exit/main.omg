use omega_language_std::console;

data Token { value: i32; }
data Reply { case Missing; case Present(value: Token); }
data Main { }

machine make() -> Token { Token { value: 42 } }
machine reply(present: bool) -> Reply {
    transition present {
        true -> (Reply::Present { value: Token { value: 42 } })
        false -> (Reply::Missing)
    }
}
machine choose(present: bool) -> bool {
    let token: Token = make();
    let response: Reply = reply(present);
    transition { _ -> inspect(response, token) }
    state inspect(response: Reply, token: Token) -> bool {
        transition response {
            Reply::Present { value } -> observe(token, value)
            _ -> (false)
        }
    }
    state observe(token: Token, value: Token) -> bool { token.value == value.value }
}
machine Main::main(context: &mut Main) reaches Console {
    let forwarded: bool = choose(true);
    let discarded: bool = choose(false);
    transition forwarded && !discarded {
        true -> finish(context, 42)
        false -> finish(context, 1)
    }
    state finish(context: &mut Main, code: i32) { Console::exit_process(code); }
}
