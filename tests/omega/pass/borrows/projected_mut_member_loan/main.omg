use omega_language_std::console;
use omega::language::core::binding;

data Inner {
    tag: u32;
}

data Main {
    console: Binding<Console>;
    inner: Inner;
}

machine Main::main(&mut self) reaches Console {
    self.inner.tag = 5;
    transition true { _ -> next(&mut self.inner) }

    state next(&mut self, loan: &mut Inner) {
        loan.tag = 9;
        transition self.inner.tag == 9 { true -> done() _ -> bad() }
    }

    state done(&mut self) {
        self.console.exit_process(0);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
