use omega_language_std::console;
use omega::language::core::binding;

data Inner {
    tag: u32;
}

data Main {
    console: Binding<Console>;
    inner: Inner;
}

machine Main::main(&mut self) reaches Console {
    self.inner.tag = 5;
    transition true { _ -> next(&mut self.inner) }

    // A `&mut` projected loan binds the subtree under its root for the
    // target block's duration: `loan` writes and reads the `self.inner`
    // storage exclusively while the ambient receiver is bound too.
    state next(&mut self, loan: &mut Inner) {
        loan.tag = 9;
        transition loan.tag == 9 { true -> done() _ -> bad() }
    }

    // The loan's name died at the edge: `done` reads the same storage
    // through the receiver root and must observe the loan's write.
    state done(&mut self) {
        transition self.inner.tag == 9 { true -> ok() _ -> stale() }
    }

    state ok(&mut self) {
        self.console.exit_process(0);
    }

    state stale(&mut self) {
        self.console.exit_process(2);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
