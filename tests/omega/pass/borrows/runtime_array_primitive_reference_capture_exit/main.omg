machine replace(slot: &mut u32) { slot = 9; }
machine main() crashes Trap {
    let mut value: u32 = 7;
    let held: [&mut u32; 1] = [&mut value];
    replace(held[0]);
    transition value == 9 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
