// Keep enough reference carriers live to use the full register bank. A
// call-free body can still overwrite the link register through allocation;
// the physical frame must retain an honest unwind continuation.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { stamp: i32; value: i32; ready: bool; }
data Main where index <= 1 {
    first: Cell;
    second: Cell;
    index: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.first.ready = false;
    main.second.stamp = 5;
    main.second.value = 70;
    main.second.ready = true;
    main.index = 0;
    let messages: [&Cell; 32] = [
        &main.first, &main.second, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first
    ];
    let first_observed: i32 = messages[main.index].value;
    require_cell_value(first_observed);
    main.index = 1;
    let observed: i32 = messages[main.index].value;
    require_cell_value(observed);
    let ready: bool = messages[main.index].ready;
    transition first_observed == 11 && observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

machine require_cell_value(value: i32)
requires value >= 0 && value <= 100
{}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
