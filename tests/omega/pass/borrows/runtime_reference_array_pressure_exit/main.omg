// Keep enough reference carriers live to use the full register bank. A
// call-free body can still overwrite the link register through allocation;
// the physical frame must retain an honest unwind continuation.
use omega_language_std::console;

data Cell { stamp: i32; value: i32 [0..=100]; ready: bool; }
data Main {
    first: Cell;
    second: Cell;
    index: u64 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.first.ready = false;
    main.second.stamp = 5;
    main.second.value = 70;
    main.second.ready = true;
    main.index = 0;
    let messages: [&Cell; 32] = [
        &main.first, &main.second, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first,
        &main.first, &main.first, &main.first, &main.first
    ];
    let first_observed: i32 [0..=100] = messages[main.index].value;
    main.index = 1;
    let observed: i32 [0..=100] = messages[main.index].value;
    let ready: bool = messages[main.index].ready;
    transition first_observed == 11 && observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
