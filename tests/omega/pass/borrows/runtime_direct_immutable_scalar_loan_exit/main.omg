// Direct call operands and explicit reference formation must share original
// immutable backing, whether its value is a local or a scalar ingress.
machine observe(value: &u32) -> bool { value == 7 }
machine forward(value: u32) -> bool { observe(&value) }
machine local_forward() -> bool {
    let value: u32 = 7;
    observe(&value)
}
machine replace(value: &mut u32) { value = 9; }
machine mutate(mut value: u32) -> bool {
    let before: bool = value == 7;
    value = 8;
    let assigned: bool = value == 8 && !observe(&value);
    replace(&mut value);
    before && assigned && value == 9 && !observe(&value)
}
machine main() crashes Trap {
    let value: u32 = 7;
    let direct: bool = observe(&value);
    let ingress: bool = forward(7);
    let local: bool = local_forward();
    let mutation: bool = mutate(7);
    let held: &u32 = &value;
    let captured: bool = observe(held);
    transition direct && ingress && local && mutation && captured {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
