// PENDING build root: the pending watcher compiles only `main.omg`, and the
// program-entry root is load-bearing. The omission this fixture pins is
// invisible to a targetless check — it appears only once an entry is
// established and the Unit plan is demanded.
machine build(builder: &mut Build) {
    Build::application(builder, "mut_loan_local_write_through_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(linux_arm64::ProgramEntry, Main::main);
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
}
