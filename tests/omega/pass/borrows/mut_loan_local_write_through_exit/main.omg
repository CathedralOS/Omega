// Use-through of an admitted loan: `borrowed = 9` writes a plain local
// through its `&mut` loan, and the owner reads the stored value back.
// exits: 9 = the write reached `v`; 1 = it did not.

use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut v: u32 = 7;
    let borrowed: &mut u32 = &mut v;
    borrowed = 9;
    transition v == 9 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        Console::exit_process(9);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
