data Cell { value: i32; }
data Cursor where position < 2 { position: u64; }

machine replace(cells: &mut [Cell; 2], cursor: &mut Cursor) {
    cursor.position = 0;
    let selected: &mut Cell = &mut cells[cursor.position];
    cursor.position = 1;
    selected = Cell { value: 70 };
}

machine main() crashes Trap {
    let mut cells: [Cell; 2];
    let mut cursor: Cursor;
    replace(&mut cells, &mut cursor);
    transition cells[0].value == 70 && cells[1].value == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
