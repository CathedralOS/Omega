use omega_language_std::console;

data Cell { value: i32; }
data Carrier<'storage> { marker: i32; reference: &'storage Cell; }
data PrimitiveCarrier { reference: &i32; }
data Main { backing: Cell; }

machine observe(value: &i32) -> i32 { value }

machine transform<'storage>(carrier: Carrier<'storage>) -> Carrier<'storage> {
    transition carrier.marker == 41 {
        true -> increment(1, carrier)
        false -> preserve(carrier, false)
    }
    state increment(amount: i32, carrier: Carrier<'storage>) -> Carrier<'storage> {
        Carrier { marker: ((carrier.marker as i32 in Wrapping) + (amount as i32 in Wrapping)) as i32, reference: carrier.reference }
    }
    state preserve(carrier: Carrier<'storage>, ignored: bool) -> Carrier<'storage> { carrier }
}

machine Main::main(main: &mut Main) reaches Console {
    main.backing.value = 42;
    let primitive: PrimitiveCarrier = PrimitiveCarrier { reference: &main.backing.value };
    let observed: i32 = observe(primitive.reference);
    let initial: Carrier = Carrier { marker: 41, reference: &main.backing };
    let transformed: Carrier = transform(initial);
    let first: i32 = transformed.reference.value;
    let preserved: Carrier = transform(transformed);
    let second: i32 = preserved.reference.value;
    let marker: i32 = preserved.marker;
    transition observed == 42 && first == 42 && second == 42 && marker == 42 {
        true -> finish(main, 42)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
