// Expected exit: 0. An RHS store precedes its enclosing captured store.
data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; }
data Pair<'storage> { selected: Held<'storage>; sibling: Held<'storage>; }

machine replace<'installed, 'returned>(output: &mut Held<'installed>, installed: Held<'installed>, returned: Held<'returned>) -> Held<'returned> {
    output = installed;
    returned
}

machine direct() -> bool {
    let mut left: Cell = Cell { value: 11 };
    let mut right: Cell = Cell { value: 23 };
    let mut third: Cell = Cell { value: 37 };
    let mut held: Held = Held { target: &left };
    held = replace(&mut held, Held { target: &right }, Held { target: &third });
    right.value = 41;
    let observed: i32 = held.target.value;
    third.value = 43;
    observed == 37 && right.value == 41 && third.value == 43
}

machine projected() -> bool {
    let mut left: Cell = Cell { value: 11 };
    let mut right: Cell = Cell { value: 23 };
    let mut third: Cell = Cell { value: 37 };
    let mut pair: Pair = Pair { selected: Held { target: &left }, sibling: Held { target: &left } };
    // The RHS sibling replacement survives the final selected-field store.
    pair.selected = replace(&mut pair.sibling, Held { target: &right }, Held { target: &third });
    left.value = 41;
    let selected: i32 = pair.selected.target.value;
    let sibling: i32 = pair.sibling.target.value;
    right.value = 43;
    third.value = 47;
    selected == 37 && sibling == 23 && left.value == 41 && right.value == 43 && third.value == 47
}

machine install_and_return<'installed, 'returned>(output: &mut Held<'installed>, installed: Held<'installed>, returned: &'returned Cell) -> &'returned Cell {
    output = installed;
    returned
}

machine rebound<'installed, 'returned>(output: &mut Held<'installed>, installed: Held<'installed>, returned: &'returned Cell) -> &'returned Cell {
    let mut view: &Cell = returned;
    view = install_and_return(output, installed, returned);
    view
}

machine rebinding() -> bool {
    let mut left: Cell = Cell { value: 11 };
    let mut right: Cell = Cell { value: 23 };
    let mut third: Cell = Cell { value: 37 };
    let mut held: Held = Held { target: &left };
    let mut view: &Cell = &left;
    view = rebound(&mut held, Held { target: &right }, &third);
    left.value = 41;
    let observed: i32 = held.target.value;
    observed == 23 && view.value == 37 && left.value == 41
}

machine main() crashes Trap {
    transition direct() && projected() && rebinding() {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
