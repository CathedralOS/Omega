// A captured selector and field prefix keep naming the selected descriptor.
data Packet [copy] { bytes: &[u8]; }
machine observe(packets: &[Packet], index: u64) -> u64
requires index < packets.len {
    let view: &[u8] = &packets[index].bytes;
    view.len
}
machine main() crashes Trap {
    let bytes: [u8; 4] = [10, 70, 42, 1];
    let packets: [Packet; 2] = [
        Packet { bytes: &bytes[0..1] },
        Packet { bytes: &bytes[1..3] }
    ];
    let mut index: u64 = 1;
    let view: &[u8] = &packets[index].bytes;
    index = 0;
    let count: u64 = observe(&packets, 1);
    transition view.len == 2 && view[0] == 70 && view[1] == 42 && count == 2 {
        true -> done() _ -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
