// A constructor moves one fixed-array descriptor and preserves its sibling.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: i32 [0..=100]; ready: bool; }
data Message { cells: [&mut Cell; 2]; stamp: i32; }
data Held { target: &mut Cell; stamp: i32; }
data Main { console: Binding<Console>; first: Cell; second: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.first.value = 70;
    main.first.ready = true;
    main.second.value = 12;
    main.second.ready = false;
    let message: Message = Message { cells: [&mut main.first, &mut main.second], stamp: 11 };
    let held: Held = Held { target: message.cells[0], stamp: 13 };
    let observed: i32 [0..=100] = held.target.value;
    let ready: bool = held.target.ready;
    main.first.value = 81;
    let other: i32 [0..=100] = message.cells[1].value;
    main.second.value = 82;
    let stamp: i32 = message.stamp;
    let held_stamp: i32 = held.stamp;
    transition observed == 70 && ready && other == 12 && stamp == 11 && held_stamp == 13 && main.first.value == 81 && main.second.value == 82 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
