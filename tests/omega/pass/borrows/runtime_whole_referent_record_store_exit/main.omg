// Whole-referent replacement of a record through `&mut`: a record literal,
// then a whole owned record copied from a parameter. exits: 70 = both
// replacements reached the caller; 71 = the literal did not; 72 = the copy
// did not.

use omega_language_std::console;

data Point {
    x: u32;
    y: u32;
}

data Main {
    point: Point;
}

machine place(point: &mut Point, x: u32, y: u32) {
    point = Point { x: x, y: y };
}

machine adopt(point: &mut Point, other: Point) {
    point = other;
}

machine Main::main(main: &mut Main) reaches Console {
    place(&mut main.point, 5, 6);
    transition main.point.x == 5 && main.point.y == 6 {
        true -> copied(main)
        _ -> bad_literal(main)
    }

    state copied(main: &mut Main) {
        adopt(&mut main.point, Point { x: 30, y: 40 });
        transition main.point.x == 30 && main.point.y == 40 {
            true -> good(main)
            _ -> bad_copy(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad_literal(main: &mut Main) {
        Console::exit_process(71);
    }

    state bad_copy(main: &mut Main) {
        Console::exit_process(72);
    }
}
