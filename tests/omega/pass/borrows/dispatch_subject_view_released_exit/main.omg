// A match transition reads its subject `decoded` through a generated alias.
// `decoded` holds a view of `main.buffer` inside a case payload. No arm uses
// that payload afterwards (the `Full` arm binds `view` but never passes it),
// so the view's loan ends with the dispatch and `next` may write `main.buffer`.
data View { tail: &[u8]; }
data Res { case Empty; case Full(view: View); }
machine split(bytes: &[u8]) -> Res {
    transition bytes.len >= 1 {
        true -> Res::Full { view: View { tail: bytes[1..bytes.len] } }
        false -> Res::Empty
    }
}
data Main { buffer: [u8; 3]; }
machine run(main: &mut Main) crashes Trap {
    main.buffer[0] = 41;
    let decoded: Res = split(&main.buffer[0..3]);
    transition decoded {
        Res::Full { view } -> next(main)
        Res::Empty -> bad()
    }
    machine next(main: &mut Main) crashes Trap {
        main.buffer[1] = 2;
        transition main.buffer[1] == 2 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut storage: Main;
    run(&mut storage);
}
