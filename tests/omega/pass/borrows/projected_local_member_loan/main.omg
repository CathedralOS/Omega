use omega_language_std::console;
use omega::language::core::binding;

data Inner {
    tag: u32;
}

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let r: Inner = Inner { tag: 9 };
    transition true { _ -> next(main, &r.tag) }

    state next(main: &mut Main, leaf: &u32) {
        transition leaf == 9 { true -> done(main) _ -> bad(main) }
    }

    state done(main: &mut Main) {
        main.console.exit_process(0);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(1);
    }
}
