// A returned child retains its captured selector and backing across rebinds.
data Cell [copy] { value: i32; }
machine capture(items: &mut [Cell; 4]) -> &mut Cell {
    let mut view: &mut [Cell] = &mut items[0..2];
    let mut position: u64 = 1;
    let child: &mut Cell = &mut view[position];
    position = 0;
    view = &mut items[2..4];
    view[0].value = 31;
    child
}
machine main() crashes Trap {
    let mut items: [Cell; 4] = [Cell { value: 11 }, Cell { value: 13 }, Cell { value: 17 }, Cell { value: 19 }];
    let child: &mut Cell = capture(&mut items);
    child.value = 27;
    transition items[0].value == 11 && items[1].value == 27
        && items[2].value == 31 && items[3].value == 19 {
        true -> done() _ -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
