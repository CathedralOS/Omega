data WindowBuffer { items: [i32; 4]; }

machine choose(value: u64) -> u64
    requires 2 <= value, value <= 4;
    ensures result >= 2, result <= 4;
{
    transition value <= 4 {
        true -> value
        false -> 4
    }
}

machine take(slot: &mut i32) {
    slot = 7;
}

machine write_outside_window(context: &mut WindowBuffer, seed: u64) -> u64
    requires 2 <= seed, seed <= 4;
{
    let split_point: u64 = choose(seed);
    let held: &mut [i32] = &mut context.items[split_point..4];
    context.items[0] = 3;
    take(&mut context.items[1]);
    let outside: &mut i32 = &mut context.items[0];
    outside = 5;
    held.len
}

machine main() crashes Trap {
    let mut context: WindowBuffer;
    let length: u64 = write_outside_window(&mut context, 2);
    transition length == 2 && context.items[0] == 5 && context.items[1] == 7 && context.items[2] == 0 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
