data Main { items: [i32; 4]; }

machine choose(value: u64) -> u64
    requires 2 <= value, value <= 4;
    ensures result >= 2, result <= 4;
{
    transition value <= 4 {
        true -> value
        false -> 4
    }
}

machine take(slot: &mut i32) {
    slot = 7;
}

machine Main::main(&mut self, seed: u64) -> u64
    requires 2 <= seed, seed <= 4;
{
    let split_point: u64 = choose(seed);
    let held: &mut [i32] = self.items[split_point..4];
    self.items[0] = 3;
    take(&mut self.items[1]);
    let outside: &mut i32 = &mut self.items[0];
    outside = 5;
    held.len
}
