// Expected exit: 0
data Packet { before: u64; rows: [[u8; 0]; 2]; after: u64; }
machine snapshot(rows: &[[u8; 0]; 2]) -> [u8; 0] { rows[0] }
machine empty(row: &[u8; 0]) -> bool { let view: &[u8] = &row[..]; view.len == 0 }
machine empty_owned(row: [u8; 0]) -> bool { empty(&row) }
machine arrive(row: [u8; 0]) -> bool {
 transition received(row);
 machine received(row: [u8; 0]) -> bool { empty(&row) }
}
machine main() crashes Trap {
 let mut packet: Packet;
 packet.before = 17;
 packet.after = 31;
 let copied: [u8; 0] = snapshot(&packet.rows);
 packet.rows[0] = copied;
 let original: [[u8; 0]; 2] = [[], []];
 let complete: [u8; 0] = snapshot(&original);
 transition empty(&packet.rows[0]) && empty(&packet.rows[1])
  && empty(&complete) && empty_owned(copied) && arrive(complete)
  && packet.before == 17 && packet.after == 31 && size_of<Packet>() == 16 {
  true -> done() _ -> bad()
 }
 machine done() {}
 machine bad() crashes Trap { crash Trap; }
}
