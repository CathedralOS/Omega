// Attribution control: the same descriptor replacement without match capture.
// Expected exit: 0
data Cell { value: i32; }
data Pair { selected: Cell; sibling: Cell; }
data Message<'storage> { body: &'storage mut Cell; }
machine replace<'storage>(message: &mut Message<'storage>, incoming: &'storage mut Pair) -> bool {
    message.body = &mut incoming.selected;
    true
}
machine store(target: &mut Cell, value: i32) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine exercise() -> bool {
    let mut original: Cell = Cell { value: 17 };
    let mut incoming: Pair = Pair { selected: Cell { value: 19 }, sibling: Cell { value: 7 } };
    let spare: Cell = Cell { value: 7 };
    let mut message: Message = Message { body: &mut original };
    let replaced: bool = replace(&mut message, &mut incoming);
    let written: bool = store(&mut message.body, 41);
    replaced && written && original.value == 17 && incoming.selected.value == 41 && incoming.sibling.value == 7 && spare.value == 7
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
