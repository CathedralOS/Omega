// Expected exit: 0.
// Scalar calls transfer reference-carrying storage through the ordinary call lane.
data Held { value: &i32; }
data Envelope { held: Held; }

machine observed(held: Held) -> i32 { held.value }
machine forward(held: Held) -> i32 { observed(held) }
machine capture(value: &i32) -> Held { Held { value: value } }

machine selected(value: &i32, consume: bool) -> i32 {
    let held: Held = Held { value: value };
    match consume {
        true -> observed(held),
        false -> 17,
    }
}

machine main() crashes Trap {
    let value: i32 = 17;
    let local: Held = Held { value: &value };
    let envelope: Envelope = Envelope { held: Held { value: &value } };
    transition observed(local) == 17
        && forward(envelope.held) == 17
        && observed(capture(&value)) == 17
        && selected(&value, true) == 17
        && selected(&value, false) == 17 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
