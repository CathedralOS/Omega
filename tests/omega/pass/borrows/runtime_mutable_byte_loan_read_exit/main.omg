// Reading bytes through an exclusive loan: a swap through `&mut [u8; 5]`,
// a reversal built from it, and a read through a `&mut [u8]` view. An
// exclusive loan that may be written may be read; each read is a snapshot
// of the byte at that point.
use omega_language_std::console;

data Main { bytes: [u8; 5]; more: [u8; 4]; }

machine swap(bytes: &mut [u8; 5], left: u64, right: u64) -> bool
requires left < 5 && right < 5
{
    let held: u8 = bytes[left];
    bytes[left] = bytes[right];
    bytes[right] = held;
    transition { _ -> (true) }
}

machine reverse(bytes: &mut [u8; 5], index: u64) -> bool
terminates by (index, 2) -> Nat::BoundedDistance;
requires index < 2
{
    let swapped: bool = swap(bytes, index, 4 - index);
    transition index + 1 < 2 {
        true -> reverse(bytes, index + 1)
        _ -> (true)
    }
}

machine peek(bytes: &mut [u8], index: u64) -> u8
requires index < bytes.len
{
    transition { _ -> (bytes[index]) }
}

machine Main::main(main: &mut Main) reaches Console {
    main.bytes[0] = 1;
    main.bytes[1] = 2;
    main.bytes[2] = 3;
    main.bytes[3] = 4;
    main.bytes[4] = 5;
    main.more[2] = 9;
    let reversed: bool = reverse(&mut main.bytes, 0);
    let view: &mut [u8] = &mut main.more[..];
    let seen: u8 = peek(view, 2);
    transition main.bytes[0] == 5 && main.bytes[1] == 4 && main.bytes[2] == 3
        && main.bytes[3] == 2 && main.bytes[4] == 1 && seen == 9 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
