// Expected exit: 0. Both array dimensions and the selected field suffix
// survive a local binding and another call returning the captured reference.
data Cell { value: u32; }
data Slot { stamp: u32; cell: Cell; }
data Row { slots: [Slot; 3]; }
data Grid { rows: [Row; 2]; }
machine choose(grid: &mut Grid, row: u64, column: u64, flag: bool) -> &mut Cell
requires row < 2 && column < 3
{
    let selected: &mut Cell = match flag {
        true -> &mut grid.rows[row].slots[column].cell,
        _ -> &mut grid.rows[0].slots[0].cell
    };
    selected
}
machine relay(grid: &mut Grid, row: u64, column: u64, flag: bool) -> &mut Cell
requires row < 2 && column < 3
{
    choose(grid, row, column, flag)
}
machine update(grid: &mut Grid, flag: bool) {
    let selected: &mut Cell = relay(grid, 1, 2, flag);
    selected.value = 70;
}
machine main() crashes Trap {
    let mut grid: Grid;
    grid.rows[1].slots[2].stamp = 17;
    update(&mut grid, true);
    transition grid.rows[1].slots[2].cell.value == 70
        && grid.rows[0].slots[2].cell.value == 0
        && grid.rows[1].slots[0].cell.value == 0
        && grid.rows[1].slots[2].stamp == 17 {
        true -> other(&mut grid)
        _ -> bad()
    }
    machine other(grid: &mut Grid) {
        update(grid, false);
        transition grid.rows[0].slots[0].cell.value == 70
            && grid.rows[1].slots[2].cell.value == 70
            && grid.rows[1].slots[2].stamp == 17 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
