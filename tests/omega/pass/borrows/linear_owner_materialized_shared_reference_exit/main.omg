use omega_language_std::console;
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
machine issue(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}
machine observe(receipt: &Receipt) -> i32 { receipt.code }

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let receipt: Receipt = issue(70);
    let view: &Receipt = &receipt;
    let observed: i32 = observe(view);
    drop(receipt);
    transition observed == 70 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
