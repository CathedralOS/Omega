// Expected exit: 0. A helper writes a reference loaded from a borrowed table.
public data Source { value: u64; }
public data Table { before: u64; services: &Source; sibling: &Source; after: u64; }
public data Output<'a> { before: u64; image: &'a Source; after: u64; }
public boundary trait Discovery {
    machine discover<'a>(services: &'a Source, output: &mut Output<'a>) -> u32
    reaches
    ensures result == 0;
}
public CheckedDiscovery satisfies Discovery {
    machine discover<'a>(services: &'a Source, output: &mut Output<'a>) -> u32
    ensures result == 0
    {
        output.image = services;
        0u32
    }
}
machine probe(table: &Table, expected: u64, sibling: u64) -> u64
reaches Discovery invokes Discovery crashes Trap {
    let empty: Source;
    let mut output: Output = Output { before: 17u64, image: &empty, after: 29u64 };
    let status: u32 = Discovery::discover(table.services, &mut output);
    let mut other: Output = Output { before: 31u64, image: &empty, after: 47u64 };
    let other_status: u32 = Discovery::discover(table.sibling, &mut other);
    transition status == 0u32 && other_status == 0u32
        && output.image.value == expected && other.image.value == sibling
        && output.before == 17u64 && output.after == 29u64
        && other.before == 31u64 && other.after == 47u64
        && table.before == 13u64 && table.after == 19u64 {
        true -> (output.image.value)
        false -> bad()
    }
    machine bad() -> u64 crashes Trap { crash Trap; }
}
machine main() -> u32 reaches Discovery invokes Discovery crashes Trap {
    let first: Source = Source { value: 41u64 };
    let second: Source = Source { value: 73u64 };
    let left: Table = Table { before: 13u64, services: &first, sibling: &second, after: 19u64 };
    let right: Table = Table { before: 13u64, services: &second, sibling: &first, after: 19u64 };
    let a: u64 = probe(&left, 41u64, 73u64);
    let b: u64 = probe(&right, 73u64, 41u64);
    let mut third: Source = Source { value: 91u64 };
    let c: u64 = attenuate(&mut third);
    transition a == 41u64 && b == 73u64 && c == 91u64 {
        true -> (0u32)
        false -> bad()
    }
    machine bad() -> u32 crashes Trap { crash Trap; }
}
// A mutable input may supply the helper's shared reference without increasing access.
machine attenuate(source: &mut Source) -> u64
reaches Discovery invokes Discovery crashes Trap {
    let empty: Source;
    let mut output: Output = Output { before: 53u64, image: &empty, after: 59u64 };
    let status: u32 = Discovery::discover(source, &mut output);
    transition status == 0u32 && output.before == 53u64 && output.after == 59u64 {
        true -> (output.image.value)
        false -> bad()
    }
    machine bad() -> u64 crashes Trap { crash Trap; }
}
