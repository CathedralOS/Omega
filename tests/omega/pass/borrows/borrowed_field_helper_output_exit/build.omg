machine build(builder: &mut Build) {
    Build::application(builder, "borrowed_field_helper_output_exit");
    Build::select_provider<Discovery, CheckedDiscovery>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Discovery, CheckedDiscovery>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Discovery, CheckedDiscovery>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Discovery, CheckedDiscovery>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
