use omega_language_std::console;

domain [u8; 3]::Utf8(bytes) requires valid_utf8(bytes);
data Leaf [copy] { name: [u8; 3] in Utf8; value: u64; }
data Event [copy] { leaf: Leaf; }
data Room [copy] { event: Event; }
data Main { source: Room; destination: Room; }

machine copy_room(source: Room, destination: &mut Room) {
    destination.event.leaf = source.event.leaf;
    // Copying the leaf leaves its source readable.
    destination.event.leaf.value = source.event.leaf.value;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.event.leaf.name = "bat";
    main.source.event.leaf.value = 42;
    main.destination.event.leaf.name = "old";
    main.destination.event.leaf.value = 7;
    copy_room(main.source, &mut main.destination);
    transition main.destination.event.leaf.name == "bat"
        && main.destination.event.leaf.value == 42
        && main.source.event.leaf.value == 42 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
