use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Leaf [copy] { name: [u8; 8] in Utf8; value: u64; }
data Event [copy] { leaf: Leaf; }
data Room [copy] { event: Event; }
data Main { console: Binding<Console>; source: Room; destination: Room; }

machine copy_room(source: Room, destination: &mut Room) {
    destination.event.leaf = source.event.leaf;
    // Copying the leaf leaves its source readable.
    destination.event.leaf.value = source.event.leaf.value;
}

machine Main::main(&mut self) reaches Console {
    self.source.event.leaf.name = "bat";
    self.source.event.leaf.value = 42;
    self.destination.event.leaf.name = "old";
    self.destination.event.leaf.value = 7;
    copy_room(self.source, &mut self.destination);
    transition self.destination.event.leaf.name == "bat"
        && self.destination.event.leaf.value == 42
        && self.source.event.leaf.value == 42 {
        true -> finish(70)
        false -> finish(1)
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
