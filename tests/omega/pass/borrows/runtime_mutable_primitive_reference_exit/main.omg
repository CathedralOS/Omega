// Capturing a mutable primitive lends its existing home. Stores through the
// reference and an ordinary helper must reach that home at each exact width.
machine replace(slot: &mut u32, value: u32) { slot = value; }

machine main() crashes Trap {
    let mut value: u32 = 7;
    let borrowed: &mut u32 = &mut value;
    borrowed = 9;
    replace(borrowed, 42);
    let mut signed: i64 = -3;
    let signed_reference: &mut i64 = &mut signed;
    signed_reference = -17;
    let mut flag: bool = false;
    let flag_reference: &mut bool = &mut flag;
    flag_reference = true;
    transition value == 42 && signed == -17 && flag {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
