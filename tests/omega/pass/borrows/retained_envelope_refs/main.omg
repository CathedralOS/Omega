// A generic envelope carries retained references — including a reference to
// a retained reference (`&retained` where retained is itself `&i32`) — plus a
// `&write` attenuated loan of a mutable local.
public data Envelope<T> { marker: i32; first: T; second: T; }
machine score(e: Envelope<&i32>) -> i32 in Wrapping {
    ((e.marker as i32 in Wrapping) + (e.first as i32 in Wrapping)
        + (e.second as i32 in Wrapping))
}
machine overwrite(value: &write i32) { value = 99; }
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let backing: i32 = 40;
    let retained: &i32 = &backing;
    let other_backing: i32 = 19;
    let carrier: Envelope<&i32> = Envelope {
        marker: 7,
        first: &retained,
        second: &other_backing
    };
    let mut write_backing: i32 = 5;
    let writable: &write i32 = &write write_backing;
    overwrite(&write writable);
    let call_backing: i32 = 42;
    let argument_backing: i32 = 55;
    let argument_carrier: Envelope<&i32> = Envelope {
        marker: 2,
        first: &retained,
        second: &argument_backing
    };
    main.hits = main.hits + score(argument_carrier);
}
