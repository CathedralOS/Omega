// Qualification pre/postconditions preserve existing routed membership without
// an invariant-changing mutable cast. This helper leaves the descriptor intact.
data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket in Issued { Ticket { number: 7 } }
machine preserve(ticket: &mut Ticket)
requires ticket in Issued
ensures ticket in Issued
{}
machine exercise() -> Ticket in Issued {
    let mut ticket: Ticket in Issued = issue();
    preserve(&mut ticket);
    ticket
}
