// Shared byte-carrier record read: `borrowed.tag` decodes the `Desc`
// layout over `buf[0..4]` little-endian. Native and interpreted execution
// exit 0. The high-ID overlay copy and the later dense Console attachment
// must publish one canonical place roster, even when every copy declaration
// was already retained by machine assembly.
use omega_language_std::console;

data Desc {
    tag: u32;
}

data Main {
    buf: [u8; 48];
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &Desc = &main.buf[0] as &Desc;
    transition borrowed.tag == main.buf[0] as u32 { true -> done(main) _ -> bad(main) }

    machine done(main: &mut Main) {
        Console::exit_process(0);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
