// Byte-carrier record referee member read — `borrowed.tag` through a
// recast `as &Desc` shared loan over byte storage. --check passes and the
// checked interpreter exits 0 (`borrowed.tag` decodes the `Desc` layout
// over `buf[0..4]` little-endian); the native leg declines at the abstract
// lowering's `InvalidStructuralLeafCopy` — the byte-carrier overlay has no
// abstract/native realization yet (record-over-bytes carrier family,
// BLOCK-WINDOW adjacency), so this rows `rejected` in the check leg.
use omega_language_std::console;
use omega::language::core::binding;

data Desc {
    tag: u32;
}

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
}

machine Main::main(&mut self) reaches Console {
    let borrowed: &Desc = &self.buf[0] as &Desc;
    transition borrowed.tag == self.buf[0] as u32 { true -> done() _ -> bad() }

    state done(&mut self) {
        self.console.exit_process(0);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
