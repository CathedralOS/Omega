domain [u8; 16]::Utf8(bytes) requires valid_utf8(bytes);

data Main {
    line: [u8; 16] in Utf8;
    sibling: u64;
}

machine Main::replace(main: &mut Main) -> bool {
    main.line = "é";
    true
}

machine observe(value: [u8; 16] in Utf8, replaced: bool, later: [u8; 16] in Utf8) -> bool
requires ascii_only(value) {
    replaced && value == "Gate" && value.len == 4 && later == "é" && later.len == 2
}

machine Main::main(main: &mut Main) crashes Trap {
    main.line = "Gate";
    main.sibling = 29;
    transition ascii_only(main.line) {
        true -> capture(main)
        false -> bad()
    }
    state capture(main: &mut Main)
    requires ascii_only(main.line) {
        let captured: bool = observe(main.line, Main::replace(main), main.line);
        transition captured && main.line == "é" && main.line.len == 2 && main.sibling == 29 {
            true -> done()
            false -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
