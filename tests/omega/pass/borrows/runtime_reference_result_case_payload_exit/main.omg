// Expected exit: 0
// A borrowed result carries exact Some/Held guarantees into a consuming call.
use omega_language_std::console;
data Cell [copy] { case Held(value: u64 in Wrapping); case Empty; }
data Pair<'source> [copy] { target: &'source Cell; }
data Choice<'source> { case Some(payload: Pair<'source>); case Empty; }
machine relay<'source>(choice: &'source Choice<'source>) -> &'source Choice<'source>
requires (choice in Choice::Some) && (choice.payload.target in Cell::Held)
ensures (result in Choice::Some) && (result.payload.target in Cell::Held) {
    choice
}
machine has_value(cell: &Cell, expected: u64 in Wrapping) -> bool
requires cell in Cell::Held { cell.value == expected }
machine main() reaches Console {
    let cell: Cell = Cell::Held { value: 11 };
    let choice: Choice = Choice::Some { payload: Pair { target: &cell } };
    let observed: &Choice = relay(&choice);
    let okay: bool = has_value(observed.payload.target, 11);
    transition okay { true -> done() _ -> wrong() }
    state done() { Console::exit_process(0); }
    state wrong() { Console::exit_process(85); }
}
