// Select the reference carrier before crossing its pointer, then read a field.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { stamp: i32; value: i32 [0..=100]; ready: bool; }
data Main {
    console: Binding<Console>;
    first: Cell;
    second: Cell;
    index: u64 [0..=1];
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.first.ready = false;
    main.second.stamp = 5;
    main.second.value = 70;
    main.second.ready = true;
    main.index = 1;
    let messages: [[&Cell; 2]; 2] = [[&main.first, &main.second], [&main.second, &main.first]];
    let observed: i32 [0..=100] = messages[0][main.index].value;
    let ready: bool = messages[0][main.index].ready;
    transition observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
