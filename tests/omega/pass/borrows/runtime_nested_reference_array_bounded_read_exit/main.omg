// Select the reference carrier before crossing its pointer, then read a field.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { stamp: i32; value: i32; ready: bool; }
data Main where index <= 1 {
    first: Cell;
    second: Cell;
    index: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.first.ready = false;
    main.second.stamp = 5;
    main.second.value = 70;
    main.second.ready = true;
    main.index = 1;
    let messages: [[&Cell; 2]; 2] = [[&main.first, &main.second], [&main.second, &main.first]];
    let observed: i32 = messages[0][main.index].value;
    require_cell_value(observed);
    let ready: bool = messages[0][main.index].ready;
    transition observed == 70 && ready {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

// This consumes the initializer's actual facts; it cannot establish a bound
// that the referenced field did not already supply.
machine require_cell_value(value: i32)
requires value >= 0 && value <= 100
{}
