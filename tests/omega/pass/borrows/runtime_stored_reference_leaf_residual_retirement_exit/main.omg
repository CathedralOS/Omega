// The first leaf ends in the body; the second remains live until the transition.
use omega_language_std::console;

data Cell where value >= 0, value <= 100 { value: i32; ready: bool; }
data Pair { first: &Cell; second: &Cell; stamp: i32; }
data Main { first: Cell; second: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.first.value = 70;
    main.first.ready = true;
    main.second.value = 11;
    main.second.ready = true;
    let pair: Pair = Pair { first: &main.first, second: &main.second, stamp: 29 };
    let observed: i32 = pair.first.value;
    main.first.value = 81;
    let stamp: i32 = pair.stamp;
    transition observed == 70 && stamp == 29 && main.first.value == 81 && pair.second.ready && pair.second.value == 11 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
