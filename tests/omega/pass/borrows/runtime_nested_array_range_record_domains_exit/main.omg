domain [u8; 5]::Utf8(bytes) requires valid_utf8(bytes);
data Room [copy] { label: [u8; 5] in Utf8; value: u64; }
data Group [copy] { room: Room; }
data Main { groups: [[Group; 2]; 2]; }

machine inspect(groups: &[[Group; 2]], index: u64) -> u64
requires index < groups.len
{
    groups[index][1].room.value
}

machine Main::main(main: &mut Main) crashes Trap {
    main.groups[1][1].room.label = "vault";
    main.groups[1][1].room.value = 70;
    let middle: &[[Group; 2]] = &main.groups[1..2];
    let observed: u64 = inspect(middle, 0);
    transition observed == 70 && main.groups[1][1].room.label == "vault" {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
