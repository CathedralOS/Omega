use omega_language_std::console;

// The reference is not the first field: its address must be loaded from the
// carrier before applying any referent-relative geometry.
data Counter { value: u64; }
data Carrier { count: u64; destination: &mut u64; record: &mut Counter; }
machine Carrier::set_count(carrier: &mut Carrier) {
    carrier.count = 7;
    // A borrowed aggregate retains access to its stored reference; it need
    // not arrive as an owned affine descriptor to write the referent's field.
    carrier.record.value = 13;
}

machine inspect(destination: &mut u64, observed: &u64, record: &mut Counter) -> u64 {
    let mut carrier: Carrier = Carrier { count: 0, destination: destination, record: record };
    Carrier::set_count(&mut carrier);
    carrier.destination = 11;
    match observed == 59 && carrier.count == 7 { true -> 70, false -> 71 }
}

data Main { value: u64; scratch: u64; counter: Counter; }
machine Main::main(context: &mut Main) reaches Console {
    context.value = 59;
    context.scratch = 0;
    let result: u64 = inspect(&mut context.scratch, &context.value, &mut context.counter);
    transition result == 70 && context.scratch == 11 && context.value == 59
        && context.counter.value == 13 {
        true -> finish(context, 70)
        false -> finish(context, 71)
    }
    state finish(context: &mut Main, code: i32) { Console::exit_process(code); }
}
