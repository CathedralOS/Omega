// Moving one field leaves the unrelated owned sibling for exit cleanup.
use omega_language_std::console;

data View { body: &mut i32; }
data Token { code: i32; }
data Outer { inner: View; spare: Token; }
machine select(value: View) -> &mut i32 { value.body }
machine replace(value: &mut i32) { value = 29; }
machine exercise(value: &mut i32) -> i32 {
    let input: Outer = Outer { inner: View { body: value }, spare: Token { code: 12 } };
    let held: &mut i32 = select(input.inner);
    replace(held);
    value
}

data Main { value: i32; }
machine Main::main(main: &mut Main) reaches Console {
    let result: i32 = exercise(&mut main.value);
    Console::exit_process(result);
}
