use omega_language_std::console;

domain [u8; 8]::Utf8(bytes) requires valid_utf8(bytes);
data Tag [copy] { case First; case Second; }
data Cell [copy] { label: [u8; 8] in Utf8; tag: Tag; value: u64; }
data Main { cells: [Cell; 2]; }

machine fill(cell: &mut Cell, tag: Tag, value: u64) {
    cell.tag = tag;
    cell.value = value;
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells[0].label = "first";
    main.cells[1].label = "second";
    let view: &mut [Cell] = &mut main.cells[..];
    fill(&mut view[0], Tag::First, 31);
    fill(&mut view[1], Tag::Second, 39);
    transition main.cells[0].value == 31
        && main.cells[1].value == 39
        && main.cells[0].label == "first"
        && main.cells[1].label == "second"
        && main.cells[0].tag == Tag::First
        && main.cells[1].tag == Tag::Second {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
