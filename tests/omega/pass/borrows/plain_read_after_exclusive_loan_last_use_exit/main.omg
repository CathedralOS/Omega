// Reads stay available wherever no live exclusive loan suspends the storage
// they observe. `head` reads an element outside the branch `middle` suspends;
// `seen` reads through the parent view after `middle`'s last use; `first`
// reads the owner beside the live direct subslice `tail`, and `last` reads
// what `tail` wrote after its last use; `observed` reads a scalar after its
// `&mut` loan's last use; `right_seen` reads a field disjoint from the live
// `&mut pair.left`; `again` and `through` read storage a shared loan holds,
// which freezes mutation but not observation. The same reads while the
// exclusive loan is live are `fail/borrows/plain_read_during_live_exclusive_loan`.
data Pair { left: u32; right: u32; }

machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine peek(view: &[u8], at: u64) -> u8
requires at < view.len
{
    view[at]
}

machine main() crashes Trap {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = &mut items[..];
    let middle: &mut [u8] = &mut view[2..4];
    let head: u8 = view[0];
    let inside: u8 = peek(middle, 1);
    let seen: u8 = view[3];
    let tail: &mut [u8] = &mut items[6..8];
    let first: u8 = items[0];
    zero(tail);
    let last: u8 = items[6];
    let mut value: u32 = 7;
    let borrowed: &mut u32 = &mut value;
    borrowed = 9;
    let observed: u32 = value;
    let mut pair: Pair = Pair { left: 1, right: 2 };
    let left: &mut u32 = &mut pair.left;
    let right_seen: u32 = pair.right;
    left = 5;
    let shared: &u32 = &value;
    let again: u32 = value;
    let through: u32 = shared;
    // head 1, inside and seen 4 (items[3]), first 1, last 0 after `zero`,
    // observed 9 after the write through `borrowed`, right_seen 2, pair.left
    // 5 after the write through `left`, again and through 9.
    transition head == 1 && inside == 4 && seen == 4 && first == 1 && last == 0
        && observed == 9 && right_seen == 2 && pair.left == 5 && again == 9
        && through == 9 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
