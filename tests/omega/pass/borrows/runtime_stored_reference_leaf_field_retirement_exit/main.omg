// End the reference leaf before mutating its backing storage; retain the scalar sibling.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: i32 [0..=100]; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Main { console: Binding<Console>; cell: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { body: &mut main.cell, stamp: 11 };
    let observed: i32 [0..=100] = message.body.value;
    let ready: bool = message.body.ready;
    main.cell.value = 81;
    let stamp: i32 = message.stamp;
    transition observed == 70 && ready && stamp == 11 && main.cell.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
