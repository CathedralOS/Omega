data Buffer { values: [u32; 5]; }
data Rows { values: &[[u32; 2]]; }

machine read(value: &u32) -> u32 { value }
machine set(value: &mut u32, replacement: u32) {
    transition { _ -> store(value, replacement) }
    machine store(value: &mut u32, replacement: u32) { value = replacement; }
}
machine inspect(values: &[u32]) -> u32
requires values.len >= 2 { read(&values[0]) }
machine nested_element(rows: &Rows) -> u32 {
    transition rows.values.len > 0 {
        true -> at(rows)
        _ -> 0
    }
    machine at(rows: &Rows) -> u32
    requires rows.values.len > 0 { read(&rows.values[0][1]) }
}

machine change(values: &mut [u32]) -> u32
requires values.len >= 3 {
    transition { _ -> apply(values) }
    machine apply(values: &mut [u32]) -> u32
    requires values.len >= 3 {
        set(&mut values[1], 71);
        let narrow: &[u32] = &values[1..3];
        inspect(narrow)
    }
}

machine main() crashes Trap {
    let mut values: [u32; 5] = [90, 10, 20, 30, 99];
    let changed: u32 = change(&mut values[1..4]);
    let shared: &[u32] = &values[2..4];
    let observed: u32 = inspect(shared);
    let mut buffer: Buffer = Buffer { values: [80, 40, 50, 60, 88] };
    let field_changed: u32 = change(&mut buffer.values[1..4]);
    let matrix: [[u32; 2]; 2] = [[11, 12], [21, 22]];
    let rows: Rows = Rows { values: &matrix[1..2] };
    let nested: u32 = nested_element(&rows);
    transition changed == 71 && observed == 71 && field_changed == 71 && nested == 22
        && values[0] == 90 && values[1] == 10 && values[2] == 71
        && values[3] == 30 && values[4] == 99
        && buffer.values[0] == 80 && buffer.values[1] == 40
        && buffer.values[2] == 71 && buffer.values[3] == 60
        && buffer.values[4] == 88 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
