data Cell { stamp: u64; value: i32; }
data Cells { padding: u64; slots: [Cell; 2]; }
data Message { stamp: u64; body: &Cells; }
data Main { first: Cells; second: Cells; }
machine take(value: &i32) -> i32 { value }
machine inspect(messages: &[Message; 2], outer: u64, inner: u64) -> i32
requires outer < 2 && inner < 2 { take(&messages[outer].body.slots[inner].value) }
machine Main::main(main: &mut Main) crashes Trap {
    main.first.slots[0].value = 11; main.first.slots[1].value = 12;
    main.second.slots[0].value = 70; main.second.slots[1].value = 71;
    let messages: [Message; 2] = [
        Message { stamp: 7, body: &main.first },
        Message { stamp: 9, body: &main.second }
    ];
    let chosen: i32 = inspect(&messages, 1, 1);
    let neighbor: i32 = inspect(&messages, 0, 1);
    let other: i32 = inspect(&messages, 1, 0);
    transition chosen == 71 && neighbor == 12 && other == 70 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
