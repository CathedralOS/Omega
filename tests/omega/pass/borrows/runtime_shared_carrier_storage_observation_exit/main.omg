use omega_language_std::console;
use omega::language::core::binding;

data Value { payload: u64; }
data Carrier { value: &Value; }
data View { carrier: &Carrier; }
data Main { console: Binding<Console>; }

machine read(carrier: &Carrier, view: &View) -> bool {
    carrier.value.payload == 73 && view.carrier.value.payload == 73
}

machine Main::main(main: &mut Main) reaches Console {
    let value: Value = Value { payload: 73 };
    let carrier: Carrier = Carrier { value: &value };
    let view: View = View { carrier: &carrier };
    let observed: bool = read(&carrier, &view);
    transition observed {
        true -> done(main)
        _ -> failed(main)
    }
    state done(main: &mut Main) { Console::exit_process(&main.console, 0); }
    state failed(main: &mut Main) { Console::exit_process(&main.console, 71); }
}
