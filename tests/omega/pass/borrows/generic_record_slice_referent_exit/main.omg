// A generic record field `&'a T` bound to the unsized slice `[u8]` must keep
// the slice's length: `holder.item` is a descriptor, so `len == 3` and the
// third byte reads 3 (exit 0; a lost length would trap). The generic machine
// form `first<T>(value: &T) -> &T` with `T = [u8]` already runs; the record
// form is refused during lowering ("loan retirement requires a descriptor
// carrier", raised in stage 06 operation_frame.rs when a leaf that is not a
// reference shape lacks descriptor cleanup); the cause is not yet diagnosed.
data Holder<'a, T> { item: &'a T; }
machine main() crashes Trap {
    let bytes: [u8; 3] = [1, 2, 3];
    let holder: Holder<[u8]> = Holder { item: &bytes[..] };
    transition holder.item.len == 3 && holder.item[2] == 3 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
