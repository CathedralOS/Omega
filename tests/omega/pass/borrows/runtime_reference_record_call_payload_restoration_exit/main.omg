// Borrowed calls end the reference before a later scalar-sibling observation.
use omega_language_std::console;

data Cell { value: i32 [0..=100]; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Main { cell: Cell; }

machine inspect(cell: &Cell) -> i32 {
    transition cell.ready { true -> good(cell) _ -> bad(cell) }
    state good(cell: &Cell) -> i32 { cell.value }
    state bad(cell: &Cell) -> i32 { 71 }
}

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { body: &mut main.cell, stamp: 11 };
    let observed: i32 = inspect(message.body);
    let stamp: i32 = message.stamp;
    main.cell.value = 81;
    transition observed == 70 && stamp == 11 && main.cell.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
