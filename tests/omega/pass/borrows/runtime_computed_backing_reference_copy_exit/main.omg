// Copy the stored descriptor, not its temporary carrier or the input it names.
// Nested reference crossings and a runtime selector retain address order.
// Expected exit: 0.
data Envelope<Payload> { payload: Payload; }
data Cell { value: i32; }
data Pair<'storage> { prefix: i32; values: [Envelope<&'storage Envelope<i32>>; 2]; }
data Choice<'storage> [copy] {
    case Empty;
    case Some(target: &'storage Envelope<i32>);
}

machine forward<'input>(value: &'input Envelope<i32>) -> &'input Envelope<i32> {
    let inner: &Envelope<&Envelope<i32>> = &Envelope { payload: value };
    let outer: &Envelope<&Envelope<&Envelope<i32>>> = &Envelope { payload: inner };
    outer.payload.payload
}

// A returned carrier lends its own temporary home; its nested reference still
// names the caller's input. The callee's region is not a caller declaration.
machine wrap<'returned>(value: &'returned Envelope<i32>) -> Envelope<&'returned Envelope<i32>> {
    Envelope { payload: value }
}

machine indexed<'input>(first: &'input Envelope<i32>, second: &'input Envelope<i32>, position: u64) -> &'input Envelope<i32>
requires position <= 1
{
    let values: &Pair = &Pair {
        prefix: 31i32,
        values: [Envelope { payload: first }, Envelope { payload: second }]
    };
    values.values[position].payload
}

// The common backing exists before selection; each nested alternative creates
// only its own backing. Retirement follows those births, not the merged roster.
machine selected(choice: bool, alternate: bool) -> i32 {
    let first: Envelope<i32> = Envelope { payload: 17i32 };
    let second: Envelope<i32> = Envelope { payload: 23i32 };
    let third: Envelope<i32> = Envelope { payload: 31i32 };
    let common: &Envelope<&Envelope<i32>> = &Envelope { payload: &first };
    let view: &Envelope<&Envelope<i32>> = match choice {
        true -> common,
        false -> match alternate {
            true -> &Envelope { payload: &second },
            false -> &Envelope { payload: &third }
        }
    };
    view.payload.payload
}

// A stored slice retires through affine cleanup rather than reference release.
machine selected_view(choice: bool) -> u64 {
    let first: [Cell; 1] = [Cell { value: 17i32 }];
    let second: [Cell; 2] = [Cell { value: 23i32 }, Cell { value: 31i32 }];
    let view: &Envelope<&[Cell]> = match choice {
        true -> &Envelope { payload: &first[..] },
        false -> &Envelope { payload: &second[..] }
    };
    view.payload.len
}

machine main() crashes Trap {
    let first: Envelope<i32> = Envelope { payload: 17i32 };
    let second: Envelope<i32> = Envelope { payload: 23i32 };
    let nested: &Envelope<i32> = forward(&first);
    let produced: &Envelope<&Envelope<&Envelope<i32>>> = &Envelope { payload: &wrap(&second) };
    let left: &Envelope<i32> = indexed(&first, &second, 0);
    let right: &Envelope<i32> = indexed(&first, &second, 1);
    transition nested.payload == 17 && produced.payload.payload.payload == 23
        && left.payload == 17 && right.payload == 23
        && selected(true, false) == 17 && selected(false, true) == 23
        && selected(false, false) == 31 && selected_view(true) == 1
        && selected_view(false) == 2 {
        true -> empty_array()
        false -> bad()
    }
    // Declared reference slots in inactive cases are not resident loans.
    // A runtime selector still has declared coverage when no slot is live.
    machine empty_array() {
        let values: [Choice; 2] = [Choice::Empty, Choice::Empty];
        let position: u64 = 1;
        let selected: Choice = values[position];
        transition selected {
            Choice::Empty -> done()
            Choice::Some { target } -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
