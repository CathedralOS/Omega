// Scalar locals initialized from member reads through a `&mut` record
// loan observe the loan the way a guard's member reads do: copied
// scalars carry no loan, the loan ends at its last use, and the
// original is then read on its own authority.
data Record { value: u16; tag: u16; active: bool; }

data Main { source: Record; }

machine Main::main(main: &mut Main) {
    main.source.value = 7;
    main.source.tag = 3;
    main.source.active = false;
    let view: &mut Record = &mut main.source;
    view.value = 99;
    view.active = true;
    let seen_value: u16 = view.value;
    let mut seen_tag: u16 = view.tag;
    let seen_active: bool = view.active;
    seen_tag = 4;
    transition main.source.value == 99
        && main.source.tag == 3
        && main.source.active
        && seen_active
        && seen_value == 99
        && seen_tag == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
