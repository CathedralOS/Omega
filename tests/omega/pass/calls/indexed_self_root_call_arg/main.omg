use omega_language_std::console;

pub data Elem {
    value: u64;
}

machine Elem::clone_of(source: &Elem) -> Elem {
    Elem { value: source.value }
}

machine List::get(list: &List, position: u64) -> Elem requires position < 4 {
    (Elem::clone_of(&list.items[position]))
}

pub data List {
    items: [Elem; 4];
}

data Main {
    list: List;
    at: u64;
}

machine Main::probe(main: &Main, i: u64) -> Elem requires i < 4 {
    (Elem::clone_of(&main.list.items[i]))
}

machine Main::probe_get(main: &Main, i: u64) -> Elem requires i < 4 {
    (List::get(&main.list, i))
}

machine Main::main(main: &mut Main) reaches Console {
    main.at = 2;
    main.list.items[2].value = 70;
    let a: Elem = Main::probe(main, main.at);
    let b: Elem = Main::probe_get(main, main.at);

    transition (a.value == 70 && b.value == 70) {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
