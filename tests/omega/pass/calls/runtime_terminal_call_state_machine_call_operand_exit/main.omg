// A terminal named call whose callee has internal states (`nearer` enters
// `forward` or `backward`) resolves its arm path to the machine, while a
// body-only callee resolves to its entry state; the flow call rows name the
// entry state either way. The planner compared the authored spelling, so a
// multi-state callee's terminal call was never recognized and the calls in
// its arguments (`scaled(seed + 1)`) were sequenced as a second outer call of
// the same statement ("outer calls: duplicate statement call"). The callee
// is now identified by its resolved entry state. The entry state and an
// internal state each complete through such a call; exit 70 when both
// nearest candidates are selected (6 and 8).
use omega_language_std::console;
data Main { }
machine nearer(current: u64, candidate: u64, best: u64, positive: bool) -> u64 {
    transition positive { true -> forward(current, candidate, best) _ -> backward(current, candidate, best) }
    state forward(current: u64, candidate: u64, best: u64) -> u64 { transition candidate > current && candidate < best { true -> candidate _ -> best } }
    state backward(current: u64, candidate: u64, best: u64) -> u64 { transition candidate < current && candidate > best { true -> candidate _ -> best } }
}
machine scaled(value: u64 in Wrapping) -> u64 in Wrapping {
    transition value < 1000 { true -> (value * 2) _ -> value }
}
machine boundary(energy: u64, seed: u64 in Wrapping, positive: bool) -> u64 {
    let far: u64 = match positive { true -> 1000000 _ -> 0 };
    let first: u64 = nearer(energy, scaled(seed) as u64, far, positive);
    transition { _ -> nearer(energy, scaled(seed + 1) as u64, first, positive) }
}
machine staged(energy: u64, seed: u64 in Wrapping) -> u64 {
    transition energy < 100 { true -> narrow(energy, seed) _ -> (energy) }
    state narrow(energy: u64, seed: u64 in Wrapping) -> u64 {
        let far: u64 = 1000000;
        transition { _ -> nearer(energy, scaled(seed + 2) as u64, far, true) }
    }
}
machine Main::main(main: &mut Main) reaches Console {
    let endpoint: u64 = boundary(1, 3, true);
    let later: u64 = staged(1, 2);
    transition endpoint == 6 && later == 8 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
