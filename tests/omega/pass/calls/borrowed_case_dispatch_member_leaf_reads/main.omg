// Case dispatch on a borrowed sum-typed block parameter: the arm reads its
// payload members and a nested leaf through the edge-carried referent.
use omega_language_std::console;
use omega::language::core::binding;

data Leaf [copy] {
    v: i32 in Wrapping;
}

data Inner [copy] {
    leaf: Leaf;
    other: i32 in Wrapping;
}

data Shape {
    case Point;
    case Line(inner: Inner, tag: i32 in Wrapping);
}

data Main {
    console: Binding<Console>;
    shape: Shape;
}

machine Main::main(&mut self) reaches Console {
    self.shape = Shape::Line {
        inner: Inner { leaf: Leaf { v: 7 }, other: 3 },
        tag: 9,
    };
    transition { _ -> inspect(&self.shape) }
    state after_inspect(&mut self) {
        transition self.shape {
            Shape::Line { inner, tag } -> use_inner(inner)
            _ -> bad(72)
        }
    }
    state use_inner(&mut self, inner: Inner) {
        transition inner.leaf.v == 7 {
            true -> loaned(inner)
            _ -> bad(73)
        }
    }
    state loaned(&mut self, inner: Inner) {
        transition { _ -> read_leaf(&inner.leaf) }
    }
    state read_leaf(&mut self, leaf: &Leaf) {
        transition leaf.v == 7 {
            true -> good()
            _ -> bad(74)
        }
    }
    state inspect(&mut self, shape: &Shape) {
        transition shape {
            Shape::Line { inner, tag } -> via_loan(inner, tag)
            _ -> bad(75)
        }
    }
    state via_loan(&mut self, inner: Inner, tag: i32 in Wrapping) {
        transition inner.leaf.v == 7 && tag == 9 {
            true -> good()
            _ -> bad(76)
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}

