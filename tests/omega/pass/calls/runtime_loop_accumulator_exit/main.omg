// RECURSIVE ACCUMULATOR: `sum(n - 1, acc + n)` -- the loop-carried
// argument writes used to run IN PLACE and in order, so `acc + n` read the
// ALREADY-DECREMENTED n (the parallel-assignment hazard; sum(5,0) natively
// computed 10). The overlap detector now collects every place read inside
// binary/cast argument operands, so the transition stages through scratch.
// sum(5,0) -> 15 -> exit 1.
use omega_language_std::console;
data Main {
    console: Console;
}
machine Main::sum(&mut self, n: u64, acc: u64 in Wrapping)
terminates by n;
-> u64 in Wrapping
{
    transition n > 0 {
        true -> sum(n - 1, acc + (n as u64 in Wrapping))
        false -> acc
    }
}
machine Main::main(&mut self) {
    let total: u64 in Wrapping = self.sum(5, 0);
    transition total == 15 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
