// Case-scrutinee transition on `self` with Named at-state targets plus a
// scalar `(0)` Value fallback (ScanResultsResponse::get_result_address shape).
// The `statement sequence: unsupported statement kind` gate is admitted past
// it; this shape clears both stage-04 routes and declines in Terminal
// production at `InvalidTerminalModule(UnknownStructuralArgument)` -- the
// arm-bound case payload's place is not registered for the named-target call
// at emission time (composed-control emission, case-payload territory).
use omega_language_std::console;
use omega::language::core::binding;

data ListResponse {
    value: u64;
}

machine ListResponse::get_result_address(&self, position: u64) -> u64 {
    self.value
}

data QueryResponse {
    value: u64;
}

machine QueryResponse::get_result_address(&self, position: u64) -> u64 {
    self.value
}

data Response {
    case List(response: ListResponse);
    case Query(response: QueryResponse);
    case Empty;
}

machine Response::get_result_address(&self, position: u64) -> u64 {
    transition self {
        Response::List { response } -> at(response, position)
        Response::Query { response } -> at_query(response, position)
        _ -> (0)
    }
    state at(&self, response: ListResponse, position: u64) -> u64 {
        response.get_result_address(position)
    }
    state at_query(&self, response: QueryResponse, position: u64) -> u64 {
        response.get_result_address(position)
    }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let response: Response = Response::List { response: ListResponse { value: 7 } };
    let address: u64 = response.get_result_address(0);
    transition {
        _ -> done()
    }

    state done(&mut self) {
        self.console.exit_process(0);
    }
}
