// Case-scrutinee transition on `self` with Named at-state targets plus a
// scalar `(0)` Value fallback (ScanResultsResponse::get_result_address shape).
// The `statement sequence: unsupported statement kind` gate is admitted past
// it; this shape clears both stage-04 routes and declines in Terminal
// production at `InvalidTerminalModule(UnknownStructuralArgument)` -- the
// arm-bound case payload's place is not registered for the named-target call
// at emission time (composed-control emission, case-payload territory).
use omega_language_std::console;
use omega::language::core::binding;

data ListResponse {
    value: u64;
}

machine ListResponse::get_result_address(list_response: &ListResponse, position: u64) -> u64 {
    list_response.value
}

data QueryResponse {
    value: u64;
}

machine QueryResponse::get_result_address(query_response: &QueryResponse, position: u64) -> u64 {
    query_response.value
}

data Response {
    case List(response: ListResponse);
    case Query(response: QueryResponse);
    case Empty;
}

machine Response::get_result_address(response: &Response, position: u64) -> u64 {
    transition response {
        Response::List { response } -> at(response, position)
        Response::Query { response } -> at_query(response, position)
        _ -> (0)
    }
    state at(response: &ListResponse, position: u64) -> u64 {
        ListResponse::get_result_address(response, position)
    }
    state at_query(response: &QueryResponse, position: u64) -> u64 {
        QueryResponse::get_result_address(response, position)
    }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let response: Response = Response::List { response: ListResponse { value: 7 } };
    let address: u64 = Response::get_result_address(&response, 0);
    transition {
        _ -> done(main)
    }

    state done(main: &mut Main) {
        main.console.exit_process(0);
    }
}
