// Expected exit: 0.
// Selecting Success from pick(Gate{threshold:5}) transports exact above(gate.threshold) evidence and preserves threshold 5.
data Outcome [copy] { case Success; case Failure; }
data Gate [copy] { threshold: u32; }
trait Evidence {}
proposition above(limit: u32) evidence Evidence;
Fresh satisfies Evidence {}
proposition pair(limit: u32, count: u32) evidence Evidence;
machine pick(gate: Gate, count: u32) -> Outcome
ensures Outcome::Success -> { selected: pair(gate.threshold, count); }
{ selected = Fresh; Outcome::Success }
machine probe(gate: Gate) -> bool {
 let mut count: u32 = 5;
 let before: u32 = count;
 let saved: Outcome = pick(gate, count);
 count = 6;
 transition saved {
  Outcome::Success { ; selected: proof } -> accepted(gate, before; proof)
  _ -> (false)
 }
 machine accepted(gate: Gate, count: u32) -> bool
 requires incoming: pair(gate.threshold, count)
 { gate.threshold == 5 && count == 5 }
}
machine main() crashes Trap {
 transition probe(Gate { threshold: 5 }) { true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
