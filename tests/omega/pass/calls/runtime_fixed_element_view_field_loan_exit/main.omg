// A stored shared text view inside a fixed array's element is lent whole to a
// shared view formal: `main.names[1].command` addresses the descriptor the
// element stores, below a field and a literal index, exactly as a view field
// directly below the record would. The two lines come out in the order the
// calls name them, not the order the elements were stored, and the counts
// beside each view stay intact.
//
// exits: 70 = both views were lent in place and the neighbouring counts are
// unchanged; 71 = a count moved.

domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Name {
    command: &[u8] in Utf8;
    count: u64;
}

data Main {
    names: [Name; 2];
}

machine Main::main(main: &mut Main) reaches Console {
    main.names[0].command = "north";
    main.names[0].count = 3;
    main.names[1].command = "wait";
    main.names[1].count = 9;
    Console::write_line(main.names[1].command);
    Console::write_line(main.names[0].command);
    transition main.names[0].count == 3 && main.names[1].count == 9 {
        true -> finish(main, 70)
        _ -> finish(main, 71)
    }

    state finish(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
