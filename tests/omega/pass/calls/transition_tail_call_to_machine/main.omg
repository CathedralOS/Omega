// A transition arm whose target calls another machine completes the caller
// with that call (wiki/spec/language/state_contracts.md, "Terminal calls in
// transition arms"); an internal state target stays a jump. Each machine in
// this chain observes what reached it and tail-calls the next:
//
//   main              stores `stored = 5`, then `_ -> Main::with_argument(main, 7)`:
//                     a tail call with an ordinary argument after a store.
//   with_argument     checks `value == 7 && stored == 5` (else 71) and jumps
//                     to an internal state whose `_ -> Main::without_arguments(main)`
//                     tail-calls with no arguments and no preceding store.
//   without_arguments makes an ordinary call (`Main::mark(main)`), then jumps to an
//                     internal state that checks `marks == 1` (else 72) and
//                     jumps again to tail-call `Main::finish(main)`.
//
// Tail calls here sit in unconditional arms. A tail call directly in a guarded
// arm (`true -> Main::finish(main)`) is pinned separately by
// `calls/conditional_arm_tail_call_to_machine_exit`.
//   finish            exits 70.
//
// A tail call that fell through, ran an arm twice or lost its argument would
// exit with a failure code instead.
use omega_language_std::console;

data Main {
    stored: i32;
    marks: u32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.marks = 0;
    main.stored = 5;
    transition { _ -> Main::with_argument(main, 7) }
}

machine Main::with_argument(main: &mut Main, value: i32) reaches Console
requires 0 <= value && value <= 100
{
    transition value == 7 && main.stored == 5 {
        true -> accepted(main)
        false -> fail(main, 71)
    }
    state accepted(main: &mut Main) {
        transition { _ -> Main::without_arguments(main) }
    }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::mark(main: &mut Main) {
    main.marks = main.marks + 1;
}

machine Main::without_arguments(main: &mut Main) reaches Console {
    Main::mark(main);
    transition { _ -> marked(main) }
    state marked(main: &mut Main) {
        transition main.marks == 1 {
            true -> finishing(main)
            false -> fail(main, 72)
        }
    }
    state finishing(main: &mut Main) {
        transition { _ -> Main::finish(main) }
    }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}

machine Main::finish(main: &mut Main) reaches Console {
    Console::exit_process(70);
}
