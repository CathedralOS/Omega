// A transition arm whose target calls another machine completes the caller
// with that call (wiki/spec/language/state_contracts.md, "Terminal calls in
// transition arms"); an internal state target stays a jump. Each machine in
// this chain observes what reached it and tail-calls the next:
//
//   main              stores `stored = 5`, then `_ -> self.with_argument(7)`:
//                     a tail call with an ordinary argument after a store.
//   with_argument     checks `value == 7 && stored == 5` (else 71) and jumps
//                     to an internal state whose `_ -> self.without_arguments()`
//                     tail-calls with no arguments and no preceding store.
//   without_arguments makes an ordinary call (`self.mark()`), then jumps to an
//                     internal state that checks `marks == 1` (else 72) and
//                     jumps again to tail-call `self.finish()`.
//
// Tail calls here sit in unconditional arms. A tail call directly in a guarded
// arm (`true -> self.finish()`) is pinned separately by
// `calls/conditional_arm_tail_call_to_machine_exit`.
//   finish            exits 70.
//
// A tail call that fell through, ran an arm twice or lost its argument would
// exit with a failure code instead.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    stored: i32;
    marks: u32 in Wrapping;
}

machine Main::main(&mut self) reaches Console {
    self.marks = 0;
    self.stored = 5;
    transition { _ -> self.with_argument(7) }
}

machine Main::with_argument(&mut self, value: i32) reaches Console
requires 0 <= value && value <= 100
{
    transition value == 7 && self.stored == 5 {
        true -> accepted()
        false -> fail(71)
    }
    state accepted(&mut self) {
        transition { _ -> self.without_arguments() }
    }
    state fail(&mut self, code: i32) { self.console.exit_process(code); }
}

machine Main::mark(&mut self) {
    self.marks = self.marks + 1;
}

machine Main::without_arguments(&mut self) reaches Console {
    self.mark();
    transition { _ -> marked() }
    state marked(&mut self) {
        transition self.marks == 1 {
            true -> finishing()
            false -> fail(72)
        }
    }
    state finishing(&mut self) {
        transition { _ -> self.finish() }
    }
    state fail(&mut self, code: i32) { self.console.exit_process(code); }
}

machine Main::finish(&mut self) reaches Console {
    self.console.exit_process(70);
}
