// Machine-array reads at FRAME indices as BINARY OPERANDS
// (`self.arr[k] + self.cells[j].v` -- incl. a range-refined struct element
// FIELD) and as a transition ARGUMENT (`self.report(self.arr[k])`). The field
// projection pins that synthetic operand hoists retain the leaf's declared
// range instead of becoming an unprovable ranged-local store.
// 9+30=39 -> report(9) -> 1.
use omega_language_std::console;
use omega::language::core::binding;
domain i32::I320To50 requires 0 <= self && self <= 50;
domain i32::I320To40 requires 0 <= self && self <= 40;
domain u64::U640To3 requires self <= 3;
domain u64::U640To2 requires self <= 2;
data Cell {
    v: i32 in I320To50;
}
data Main {
    console: Binding<Console>;
    arr: [i32 in I320To40; 4];
    cells: [Cell; 3];
}
machine Main::main(&mut self) {
    self.arr[2] = 9;
    self.cells[1].v = 30;
    transition { _ -> self.pick(2, 1) }
}
machine Main::pick(&mut self, k: u64 in U640To3, j: u64 in U640To2) reaches Console {
    let sum: i32 = self.arr[k] + self.cells[j].v;
    transition sum == 39 {
        true -> self.report(self.arr[k])
        false -> no()
    }
    state no(&mut self) { self.console.exit_process(2); }
}
machine Main::report(&mut self, got: i32) reaches Console {
    transition got == 9 {
        true -> yes()
        false -> half()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state half(&mut self) { self.console.exit_process(3); }
}
