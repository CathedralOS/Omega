use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "direct_target_foreign_scalar_result_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);

 Build::bind<Magnitude::absolute>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_abs",
        },
    });
 Build::bind<Magnitude::absolute>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.2.5",
        },
    });
 Build::bind<Magnitude::absolute>(builder, linux_arm64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "abs",
            version: "GLIBC_2.17",
        },
    });
 Build::bind<Magnitude::absolute>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "msvcrt.dll",
            export: "abs",
        },
    });
}
