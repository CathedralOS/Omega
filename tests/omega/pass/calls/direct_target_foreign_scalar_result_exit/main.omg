// Expected exit: 0
// A target-specific ordinary body retains the exact direct foreign scalar call.
use omega::language::core::external_binding;

public boundary trait Magnitude {
    machine absolute(value: i32) -> i32 reaches;
}


boundary trait SelectedObserve {
    machine observe() -> i32 reaches Magnitude;
}
CheckedObserve satisfies SelectedObserve {
    machine observe() -> i32 reaches Magnitude
{ Magnitude::absolute(-70) }
}




machine main() reaches Magnitude crashes Trap {
    transition SelectedObserve::observe() == 70 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
