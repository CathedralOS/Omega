// A state-graph issuer's authored `ensures result in Ticket::Issued` clause
// registers the returned carrier for the structural domain catalog exactly as
// an ordinary body's clause does: no declaration here spells `Ticket in
// Issued`, so the membership the receiving call and the issuer's result
// declaration publish reaches the catalog only through that clause. The
// constructor child then carries the issued ticket past its replacement.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue(marker: i32) -> Ticket
ensures result in Ticket::Issued {
    transition marker == 9 {
        true -> exact()
        false -> other(marker)
    }
    state exact() -> Ticket { Ticket { amount: 41, marker: 9 } }
    state other(marker: i32) -> Ticket { Ticket { amount: 41, marker: marker } }
}

data Envelope [copy] { ticket: Ticket; replaced: bool; }
data Main { ticket: Ticket; }

machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine observe(value: Envelope)
requires value.ticket in Ticket::Issued
crashes Trap {
    transition value.replaced && value.ticket.amount == 41 && value.ticket.marker == 9 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.ticket = Ticket::issue(9);
    observe(Envelope { ticket: main.ticket, replaced: Main::replace(main) });
    transition main.ticket.amount == 0 && main.ticket.marker == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
