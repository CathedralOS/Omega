machine read(value: &i32) -> i32 { value }
machine replace(value: &mut i32) -> i32 ensures value == 2i32 {
    value = 2i32;
    value
}
machine pair(left: i32, right: i32) -> bool { left == 1i32 && right == 2i32 }
machine main() crashes Trap {
    let mut value: i32 = 1i32;
    let matched: bool = pair(read(&value), replace(&mut value));
    value = 1i32;
    let skipped: bool = false && pair(read(&value), replace(&mut value));
    transition matched && !skipped && value == 1i32 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
