use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Binding<Console>;
    line: [u8; 64];
}

machine Main::main(&mut self) reaches Console {
    self.console.write("> ");
    _ = block self.console.read_line(&mut self.line);
    self.console.write_line("read");
    self.console.exit_process(0);
}
