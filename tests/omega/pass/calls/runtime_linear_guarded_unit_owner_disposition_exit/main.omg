use omega_language_std::Console;
use omega::language::core::drop;

data Receipt [linear] dropped by drop_receipt { code: i32; }

machine drop_receipt(receipt: &mut Receipt) {}

machine consume(receipt: Receipt) {
    drop(receipt);
}

machine relay(receipt: Receipt, selected: bool) {
    transition {
        selected -> consume(receipt)
        _ -> consume(receipt)
    }
}

machine main() reaches Console {
    let first: Receipt = Receipt { code: 7 };
    relay(first, true);
    let second: Receipt = Receipt { code: 13 };
    relay(second, false);
    transition { _ -> Console::exit_process(0) }
}
