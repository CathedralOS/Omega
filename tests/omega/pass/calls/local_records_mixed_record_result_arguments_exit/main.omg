// A static machine lends two distinct local records to one record-returning
// call: `&mut left` exclusively and `&right` shared. Neither loan aliases the
// other, and the returned `Report` holds only plain numeric fields, so both
// loans end with the call. A completed local record also lends one element
// of its record array through the same calls: `&mut board.tallies[1]` is the
// projected exclusive loan and `&board.tallies[1]` the projected shared
// observation. A scalar-field loan below that element increments its hits,
// and the record-returning callee forwards both loans to a successor state.
// Exits 70 only when the reports and every local show exactly the writes
// made through the exclusive loans.

use omega_language_std::console;

data Tally { hits: i32 in Wrapping; misses: i32 in Wrapping; }
data Board { tallies: [Tally; 2]; }
data Report { total: i32 in Wrapping; }

machine Tally::bump(tally: &mut Tally, by: i32 in Wrapping) {
    tally.hits = tally.hits + by;
}

machine Tally::peek(tally: &Tally) -> i32 in Wrapping {
    tally.hits
}

machine bump_hit(hits: &mut i32 in Wrapping) {
    hits = hits + 1;
}

machine Tally::absorb(into: &mut Tally, from: &Tally) -> Report {
    transition { _ -> apply(into, from) }

    state apply(into: &mut Tally, from: &Tally) {
        into.hits = into.hits + from.hits;
        transition { _ -> (Report { total: into.hits + into.misses }) }
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut left: Tally;
    let mut right: Tally;
    Tally::bump(&mut left, 30);
    Tally::bump(&mut right, 40);
    let merged: Report = Tally::absorb(&mut left, &right);
    let mut board: Board;
    Tally::bump(&mut board.tallies[0], 30);
    Tally::bump(&mut board.tallies[1], 40);
    bump_hit(&mut board.tallies[1].hits);
    let projected: Report = Tally::absorb(&mut board.tallies[1], &right);
    let peeked: i32 in Wrapping = Tally::peek(&board.tallies[1]);
    transition merged.total == 70 && left.hits == 70 && right.hits == 40
        && projected.total == 81 && board.tallies[1].hits == 81
        && board.tallies[0].hits == 30 && peeked == 81 {
        true -> done(70)
        _ -> done(71)
    }

    state done(code: i32) {
        Console::exit_process(code);
    }
}
