use omega_language_std::console;

data Main { scratch: i32; }

machine unrelated() -> i32 { 3 }
machine expected() -> i32 { 70 }

machine Main::main(main: &mut Main) reaches Console {
    // Both values are i32: confusing their namespaces must not silently exit 3.
    main.scratch = unrelated();
    let authored: i32 = expected();
    let copied: i32 = authored;
    main.scratch = copied;
    Console::exit_process(copied);
}
machine Main::run(main: &mut Main) { Main::main(main); }
