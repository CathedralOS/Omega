// A `&mut self` machine that takes a BY-VALUE CASE-BEARING parameter must
// persist writes to `main.<field>` made in a dispatched substate: after
// `main.apply(Event::Insert { cents: 50 })`, `main.register.balance` must
// equal 50.  Exits 70 on success.
//
// Regression canary for the 2026-06 fix: InlineBranching argument
// materialization now handles StructLiteral arguments, writing the case tag
// and each payload field into the target parameter slot so the transition
// guard sees the correct variant and the substate write-back reaches the
// caller.

use omega_language_std::console;

data Event {
    case Idle;
    case Insert(cents: i32 in Wrapping);
}

data Register [copy] {
    balance: i32 in Wrapping;
}

data Main {
    register: Register;
}

machine Main::main(main: &mut Main) reaches Console {
    Main::apply(main, Event::Insert { cents: 50 });
    transition main.register.balance == 50 {
        true -> report(main, 70)
        _ -> not_fifty(main)
    }
    machine not_fifty(main: &mut Main) {
        transition main.register.balance == 0 {
            true -> report(main, 80)
            _ -> report(main, 81)
        }
    }
    machine report(main: &mut Main, code: i32 in Wrapping) {
        Console::exit_process(code as i32);
    }
}

machine Main::apply(main: &mut Main, event: Event) {
    transition event {
        Event::Insert { cents } -> add_balance(main, cents)
        _ -> idle()
    }
    machine add_balance(main: &mut Main, cents: i32 in Wrapping) {
        main.register.balance = main.register.balance + cents;
    }
    machine idle() {
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
