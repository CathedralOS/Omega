// Case values constructed inline as call arguments move whole into the call:
// `self.apply(Event::Add { amount: 3 })` establishes the value for the
// argument and nothing else reads it. Two such temporaries in successive
// statements of a state graph, one carrying a payload and one without, each
// dispatched exhaustively by the callee with no `_` arm, so every arm consumes
// the owned subject. Exits 70 only when both dispatches reached their arms.

use omega_language_std::console;
use omega::language::core::binding;

data Event {
    case Add(amount: i32 in Wrapping);
    case Bonus;
}

data Tally [copy] {
    total: i32 in Wrapping;
}

data Main {
    console: Binding<Console>;
    tally: Tally;
}

machine Main::main(&mut self) reaches Console {
    Main::apply(&mut self, Event::Add { amount: 3 });
    Main::apply(&mut self, Event::Bonus);
    transition self.tally.total == 13 {
        true -> report(70)
        _ -> report(71)
    }
    state report(&mut self, code: i32 in Wrapping) {
        self.console.exit_process(code as i32);
    }
}

machine Main::apply(main: &mut Main, event: Event) {
    transition event {
        Event::Add { amount } -> add(main, amount)
        Event::Bonus -> bonus(main)
    }
    state add(main: &mut Main, amount: i32 in Wrapping) {
        main.tally.total = main.tally.total + amount;
    }
    state bonus(main: &mut Main) {
        main.tally.total = main.tally.total + 10;
    }
}
