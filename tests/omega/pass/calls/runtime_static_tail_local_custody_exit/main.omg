// Retain rank evidence across the fused multi-machine state roster, without
// requiring the acyclic finishing states to carry the countdown parameter.
// Static tail calls and sibling states keep explicit loans, not a machine instance.
data Counter { value: u64; }

machine Counter::even(counter: &mut Counter, remaining: u64) -> u64
terminates by remaining;
{
    transition remaining == 0 {
        true -> finish(counter)
        _ -> Counter::odd(counter, remaining - 1)
    }
    machine finish(counter: &mut Counter) -> u64 {
        counter.value = 70;
        counter.value
    }
}

machine Counter::odd(counter: &mut Counter, remaining: u64) -> u64
terminates by remaining;
{
    transition remaining == 0 {
        true -> finish(counter)
        _ -> Counter::even(counter, remaining - 1)
    }
    machine finish(counter: &mut Counter) -> u64 {
        counter.value = 71;
        counter.value
    }
}

machine main() crashes Trap {
    let mut counter: Counter;
    let answer: u64 = Counter::even(&mut counter, 1000);
    transition answer == 70 && counter.value == 70 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
