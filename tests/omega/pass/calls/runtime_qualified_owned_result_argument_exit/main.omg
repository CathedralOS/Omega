domain u64::Small(value) requires 1 <= value && value <= 100;
data Packet { value: u64 in Small; }

machine make() -> Packet { Packet { value: 41 } }
machine observe(packet: Packet) -> bool { packet.value == 41 }

machine main() crashes Trap {
    let packet: Packet = make();
    let observed: bool = observe(packet);
    transition observed {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
