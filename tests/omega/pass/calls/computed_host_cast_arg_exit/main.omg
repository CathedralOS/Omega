// A numeric cast used directly as a scalar host-boundary argument reuses the
// ordinary conversion writer in the argument's reserved scratch slot.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    value: u8;
}

machine Main::main(&mut self) reaches Console {
    self.value = 70;
    self.console.exit_process(self.value as i32);
}
