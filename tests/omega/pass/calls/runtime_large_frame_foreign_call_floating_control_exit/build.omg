// This control executes a Darwin foreign binding; other hosts do not select it.
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_large_frame_foreign_call_floating_control_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
