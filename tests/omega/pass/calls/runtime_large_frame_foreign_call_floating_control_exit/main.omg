// A foreign call above a 64 KiB local: the FPCR save and restore slot around
// the call lies past the 32760 bytes `str`/`ldr` reach from `sp` on AArch64.
// The restore forms the slot address in `x9` before loading the saved FPCR
// into it; the save keeps the FPCR in `x9` and forms the address in IP0.
// Exits with `abs(-70)`, 70, once the saved FPCR is restored.
use omega::language::core::external_binding;
use omega_language_std::console;

public boundary trait Magnitude {
    machine absolute(value: i32) -> i32 reaches;
}


data Big {
    bytes: [u8; 65536] in Trapping;
    length: u64 in Trapping;
}

machine Big::fill(big: &mut Big, value: u8 in Trapping) {
    big.bytes[65535] = value;
    big.length = 65536;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console + Magnitude
crashes Trap
{
    let mut big: Big;
    Big::fill(&mut big, 70);
    let magnitude: i32 = Magnitude::absolute(0 - (big.bytes[65535] as i32));
    Console::exit_process(magnitude);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console + Magnitude
crashes Trap
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
