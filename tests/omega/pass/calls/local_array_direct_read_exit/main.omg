// A local array keeps one backing across a borrowed writer and direct reads.
// The untouched element also checks that zero establishment and projection
// offsets refer to that backing rather than an argument-copy temporary.
use omega_language_std::console;
use omega::language::core::binding;

machine stamp(bytes: &mut [u8]) {
    transition bytes.len >= 4 {
        true -> write(bytes)
        _ -> skip()
    }
    state write(bytes: &mut [u8]) {
        bytes[0] = 70;
        bytes[3] = 5;
    }
    state skip() {}
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut buffer: [u8; 4];
    stamp(&mut buffer);
    let first: u8 = buffer[0];
    let untouched: u8 = buffer[2];
    let last: u8 = buffer[3];
    transition first == 70 && untouched == 0 && last == 5 {
        true -> done(&main.console)
        _ -> failed(&main.console)
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state failed(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
