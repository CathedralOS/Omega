// Expected exit: 0. Nested scalar operands retain their checked call namespace.
data Cell { value: u64; }
data Pair { first: Cell; second: u64; }
machine cell(value: u64) -> Cell { Cell { value: value } }
machine read(cell: Cell) -> u64 { cell.value }
machine main() crashes Trap {
    let pair: Pair = Pair { first: cell(11), second: read(cell(17)) + 0 };
    transition pair.first.value == 11 && pair.second == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
