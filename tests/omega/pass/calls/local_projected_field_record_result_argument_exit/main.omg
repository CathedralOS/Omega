// A static machine lends one field of its local record, `&mut outer.tally`,
// to a machine that updates it and returns a fresh `Report`. The loan
// presents exactly that subtree and moves nothing out of the local; the
// report holds only plain numeric fields, so the loan ends with each call.
// Exits 70 only when both reports and the caller's own field agree.

use omega_language_std::console;

data Tally { hits: i32 in Wrapping; misses: i32 in Wrapping; }
data Report { total: i32 in Wrapping; }
data Outer { height: i32 in Wrapping; tally: Tally; }

machine Tally::record(tally: &mut Tally, hits: i32 in Wrapping, misses: i32 in Wrapping) -> Report {
    tally.hits = tally.hits + hits;
    tally.misses = tally.misses + misses;
    transition { _ -> (Report { total: tally.hits + tally.misses }) }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut outer: Outer;
    let first: Report = Tally::record(&mut outer.tally, 30, 0);
    let second: Report = Tally::record(&mut outer.tally, 0, 10);
    transition first.total == 30 && second.total == 40 && outer.tally.hits == 30 && outer.height == 0 {
        true -> done(70)
        _ -> done(71)
    }

    state done(code: i32) {
        Console::exit_process(code);
    }
}
