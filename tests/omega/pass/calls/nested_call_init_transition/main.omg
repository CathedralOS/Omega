// Nested calls inside a local initializer, a transition scrutinee, a
// transition arm payload (including a call whose receiver is another call's
// result and a call nested inside an outer call's argument), and a named
// target's argument — every nested call must be consumed into the outer
// call roster for the body to admit a unit plan.
use omega_language_std::console;

pub data Sum [copy] {
    case First;
    case Second(payload: u64);
}

pub data Parse {
    case Parsed(value: Cell);
    case Refused;
}

pub data Cell {
    big: [u8; 64];
    sum: Sum;
    len: u64;
}

data Main {
}

machine Cell::fresh(sum: Sum, len: u64) -> Cell {
    transition { _ -> (Cell { sum: sum, len: len }) }
}

machine Cell::get_sum(cell: &Cell) -> Sum {
    cell.sum
}

machine Cell::get_len(cell: &Cell) -> u64 {
    cell.len
}

machine Sum::size(sum: &Sum, unit: u64) -> u64 {
    transition sum {
        Sum::First -> (unit)
        Sum::Second { payload } -> (payload)
    }
}

machine Cell::size_of_sum(cell: &Cell, unit: u64) -> u64 {
    transition cell.sum {
        Sum::First -> (unit)
        Sum::Second { payload } -> (payload)
    }
}

machine bump(x: u64) -> u64 {
    transition { _ -> (x | 1) }
}

// API SHAPE 1 (AnonymousValueString::clone): `let mut` local initialized by a
// structural-result call whose arguments hold nested calls.
machine clone_cell(source: &Cell) -> Cell {
    let mut value: Cell = Cell::fresh(Cell::get_sum(source), Cell::get_len(source));
    transition { _ -> (value) }
}

// API SHAPE 1b: record-literal field holding a nested call inside a local
// initializer.
machine init_field_call(source: &Cell) -> u64 {
    let cell: Cell = Cell { sum: Cell::get_sum(source), len: Cell::get_len(source) };
    transition { _ -> (cell.len) }
}

// API SHAPE 2 (holds): transition arm `(expr)` payload carrying nested
// scalar calls.
machine Main::holds(result: Parse, want_len: u64, want_size: u64) -> bool {
    transition result {
        Parse::Parsed { value } -> (Cell::get_len(&value) == want_len
            && Sum::size(&Cell::get_sum(&value), 1) == want_size)
        Parse::Refused -> (false)
    }
}

// API SHAPE 5 (ContainerType::get_total_size_in_bytes): arm payload is a
// call whose argument is itself a payload-bound call + a cast.
machine sat_mul(left: u64 in Saturating, right: u64 in Saturating) -> u64 {
    (left * right) as u64
}
machine size_of(sum: Sum, unit: u64) -> u64 {
    transition sum {
        Sum::First -> (unit)
        Sum::Second { payload } -> (sat_mul(payload as u64 in Saturating, unit as u64 in Saturating))
    }
}
machine size_via_call(cell: Cell) -> u64 {
    transition Cell::get_sum(&cell) {
        Sum::First -> (1)
        Sum::Second { payload } -> (payload)
    }
}

// API SHAPE 3: nested scalar call inside a named-target transition argument.
machine Main::next_arg(x: u64) -> u64 {
    transition { _ -> finish(bump(x)) }
    state finish(y: u64) -> u64 {
        transition { _ -> (y) }
    }
}

// Nested call inside a named-target arm argument (call-in-call).
machine Main::target_arg_nested(x: u64) -> u64 {
    transition { _ -> finish(bump(bump(x))) }
    state finish(y: u64) -> u64 {
        transition { _ -> (y) }
    }
}

// API SHAPE 4: call inside the transition scrutinee expression.
machine scrutinee_call(x: u64) -> u64 {
    transition bump(x) {
        _ -> (x)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let cell: Cell = Cell { sum: Sum::Second { payload: 5 }, len: 2 };
    let parsed: Parse = Parse::Parsed { value: cell };
    Console::exit_process(0);
}
