use omega_language_std::console;
use omega::language::core::layout;

public data Words [copy] { first: u64; second: u64; third: u64; }


public Aligned32 satisfies FixedLayout<Words> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
    Plan { entries: entries, entry_count: 3, size_fixed: 32, size_is_dynamic: false, align: 32 }
}
}

public Aligned64 satisfies FixedLayout<Words> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
    Plan { entries: entries, entry_count: 3, size_fixed: 64, size_is_dynamic: false, align: 64 }
}
}

machine select_values(first: LayoutStorage<Words, Aligned32>, second: LayoutStorage<Words, Aligned64>) -> LayoutStorage<Words, Aligned64> {
    let mut result: LayoutStorage<Words, Aligned64>;
    result.first = first.third;
    result.second = second.first;
    result.third = first.second;
    result
}

data Main { first: LayoutStorage<Words, Aligned32>; second: LayoutStorage<Words, Aligned64>; }
machine Main::main(main: &mut Main) reaches Console
invokes Console
{
    main.first.first = 17;
    main.first.second = 91;
    main.first.third = 43;
    main.second.first = 101;
    main.second.second = 202;
    main.second.third = 303;
    let result: LayoutStorage<Words, Aligned64> = select_values(main.first, main.second);
    transition result.first == 43 && result.second == 101 && result.third == 91
        && main.first.first == 17 && main.first.second == 91 && main.first.third == 43
        && main.second.first == 101 && main.second.second == 202 && main.second.third == 303 {
        true -> done()
        _ -> failed()
    }
    machine done() { Console::exit_process(0); }
    machine failed() { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console
invokes Console
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
