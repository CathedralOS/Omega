domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data CellId {
    case C0;
    case C1;
    case C2;
}

data Cell {
    label: &[u8] in Utf8;
    value: i32;
}

data Bag {
    cells: [Cell; 3];
}

data Main {
    console: Console;
    bag: Bag;
}

machine Main::main(&mut self) {
    self.fill(&mut self.bag, CellId::C0);

    transition self.bag.cells[0].label == "Gate" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(186);
    }

    state bad(&mut self) {
        self.console.exit_process(187);
    }
}

machine Main::fill(&mut self, bag: &mut Bag, cell_id: CellId) {
    let cell: &mut Cell = self.pick(bag, cell_id);
    cell.label = identity_text("Gate");
    cell.value = 7;
}

machine Main::pick(&mut self, bag: &mut Bag, cell_id: CellId) -> &mut Cell {
    let cells: &mut [Cell] = bag.cells.as_mut_slice();

    transition cell_id {
        CellId::C0 -> &mut cells[0]
        CellId::C1 -> &mut cells[1]
        _ -> &mut cells[2]
    }
}

machine identity_text<'text>(text: &'text [u8] in Utf8) -> &'text [u8] in Utf8 {
    transition {
        _ -> text
    }
}
