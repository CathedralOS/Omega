use omega_language_std::console;
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine relay(receipt: Receipt, selected: bool) -> i32 {
    transition selected {
        true -> consume(receipt)
        false -> consume(receipt)
    }
}

machine main() reaches Console {
    let first: Receipt = Receipt { code: 7 };
    let first_result: i32 = relay(first, true);
    let second: Receipt = Receipt { code: 13 };
    let second_result: i32 = relay(second, false);
    transition first_result == 7 && second_result == 13 {
        true -> Console::exit_process(0)
        false -> Console::exit_process(1)
    }
}
