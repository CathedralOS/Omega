// RUN CANARY (exit 70). A whole `[u8; 4]` lent to a `&mut [u8]` or `&[u8]`
// parameter is one borrowed byte view over the array's own storage, both for
// a field under the receiver and for a machine-local backing. The byte-view
// and the `u8` element-view readings describe the same loan; the call still
// presents exactly one descriptor with the array's four-byte extent, and the
// writes land in the lent array.
//
// Exit 71 = the field loan missed its writes, 72 = the local loan did.
use omega_language_std::console;

data Main {
    bytes: [u8; 4];
}

machine stamp(bytes: &mut [u8]) {
    transition bytes.len >= 4 {
        true -> write(bytes)
        _ -> skip()
    }

    state write(bytes: &mut [u8]) {
        bytes[0] = 70;
        bytes[3] = 5;
    }

    state skip() { }
}

machine peek(bytes: &[u8], position: u64) -> u64 {
    transition position < bytes.len {
        true -> read(bytes, position)
        _ -> (0)
    }

    state read(bytes: &[u8], position: u64) -> u64 {
        let value: u8 = bytes[position];
        transition { _ -> (value as u64) }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    stamp(&mut main.bytes);
    let mut local: [u8; 4];
    stamp(&mut local);
    let field_first: u64 = peek(&main.bytes, 0);
    let field_last: u64 = peek(&main.bytes, 3);
    let local_first: u64 = peek(&local, 0);
    let local_untouched: u64 = peek(&local, 2);
    transition field_first == 70 && field_last == 5 {
        true -> check_local(main, local_first, local_untouched)
        _ -> failed(main, 71)
    }

    state check_local(main: &mut Main, first: u64, untouched: u64) {
        transition first == 70 && untouched == 0 {
            true -> done(main)
            _ -> failed(main, 72)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state failed(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
