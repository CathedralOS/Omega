data Node { value: u64; }

machine identity(node: &Node) -> &Node { node }

machine ordinary(node: &Node) -> &Node {
    let result: &Node = identity(node);
    result
}

machine choose(node: &Node, take: bool) -> &Node {
    transition take {
        true -> identity(node)
        _ -> ordinary(node)
    }
}

machine mixed(node: &Node, take: bool) -> &Node {
    transition take {
        true -> identity(node)
        _ -> (node)
    }
}

machine main() crashes Trap {
    let first: Node = Node { value: 70 };
    let second: Node = Node { value: 71 };
    let first_result: &Node = choose(&first, true);
    let first_value: u64 = first_result.value;
    let second_result: &Node = choose(&second, false);
    let second_value: u64 = second_result.value;
    let ordinary_result: &Node = ordinary(&first);
    let ordinary_value: u64 = ordinary_result.value;
    let mixed_first: &Node = mixed(&first, true);
    let mixed_first_value: u64 = mixed_first.value;
    let mixed_second: &Node = mixed(&second, false);
    transition first_value == 70 && second_value == 71 && ordinary_value == 70
        && mixed_first_value == 70 && mixed_second.value == 71 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
