use omega_language_std::console;
machine decimal(value: u64 in Wrapping) reaches Console {
    transition { _ -> scale(value, 1) }
    machine scale(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor <= value / 10 {
            true -> scale(value, divisor * 10)
            false -> emit(value, divisor)
        }
    }
    machine emit(value: u64 in Wrapping, divisor: u64 in Wrapping) {
        transition divisor > 0 { true -> digit(value, divisor) false -> done() }
    }
    machine digit(value: u64 in Wrapping, divisor: u64 in Wrapping)
    requires divisor > 0 {
        Console::write_byte((value / divisor % 10 + 48) as i32);
        transition { _ -> emit(value % divisor, divisor / 10) }
    }
    machine done() {}
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    decimal(288);
    Console::write_line("");
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
