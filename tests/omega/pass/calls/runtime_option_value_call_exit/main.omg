// A value-machine that RETURNS a sum type (Option), called in a loop with each result
// matched -- the idiomatic functional shape for fallible/optional functions (find, lookup,
// parse). Distinct from errors/runtime_result_match_exit (which builds the enum into a
// FIELD inline): here the enum is the RETURN VALUE of a machine call, so the arm of the
// callee constructs `Opt::Some { value: x }` / `Opt::None`, the caller binds it with `let`,
// and matches it -- all inside a loop over the inputs. `classify(x)` returns Some(x) when x
// is positive, else None; over [5, -3, 7] that is Some(5), None, Some(7), so the Some values
// sum to 12 and one None is counted. Exits 70.
use omega_language_std::console;

data Opt {
    case Some(value: i32 in Wrapping);
    case None;
}

data Main {
    vals: [i32; 3];
    i: i32 in Wrapping;
    x: i32 in Wrapping;
    acc: i32 in Wrapping;   // sum of Some values
    nones: i32 in Wrapping; // count of None
}

// a function that returns an Option -- the callee's arms construct the enum result
machine classify(x: i32 in Wrapping) -> Opt {
    transition x > 0 { true -> Opt::Some { value: x } _ -> Opt::None }
}

machine Main::main(main: &mut Main) reaches Console {
    main.vals = [5, 0 - 3, 7];
    main.i = 0;
    main.acc = 0;
    main.nones = 0;
    transition { _ -> loop(main) }

    state loop(main: &mut Main) {
        transition main.i >= 0 && main.i < 3 { true -> call(main) _ -> verify(main) }
    }
    state call(main: &mut Main) {
        main.x = main.vals[main.i] as i32 in Wrapping;
        // call the Option-returning function, bind, and match the result
        let r: Opt = classify(main.x);
        transition r {
            Opt::Some { value } -> got(main, value)
            Opt::None -> nada(main)
        }
    }
    state got(main: &mut Main, v: i32 in Wrapping) {
        main.acc = main.acc + v;
        main.i = main.i + 1;
        transition { _ -> loop(main) }
    }
    state nada(main: &mut Main) {
        main.nones = main.nones + 1;
        main.i = main.i + 1;
        transition { _ -> loop(main) }
    }

    state verify(main: &mut Main) {
        transition main.acc == 12 && main.nones == 1 { true -> good(main) _ -> wrong(main) }
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state wrong(main: &mut Main) {
        Console::exit_process(main.acc as i32); // surface the sum on regression
    }
}
