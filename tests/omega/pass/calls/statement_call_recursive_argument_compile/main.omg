// REGRESSION PIN (2026-07-12): a statement call whose ARGUMENT calls a
// self-recursive machine (`lemma(q, add(p, q));`) used to overflow the
// compile thread -- the state-values simplifier's guarded-helper
// comparison expanded the recursive callee's model, re-entered the
// simplifier with the cycle stack already popped, and grew the argument
// one constructor-read per round (`a.prev`, `a.prev.prev`, ..) without
// bound. REENTRANT_SIMPLIFY_DEPTH_LIMIT now caps the re-entrancy budget:
// past it the expression stays unsimplified (the canonicalizer's ordinary
// "no match" behavior), and this program simply compiles. Value-position
// nested call args keep their own honest fence ("a value-call argument
// cannot itself be a machine call yet").
use omega_language_std::console;
use omega::language::core::service;
data Main { console: Service<Console>; }
machine Main::main(&mut self) reaches Console { self.console.exit_process(70); }

// Local `Peano`/`peano_add` names: `core` exports `Nat` and `add`, so the
// fixture declares its own chain under non-colliding spellings.
data Peano { case Zero; case Succ(prev: Peano); }

machine peano_add(a: Peano, b: Peano) -> Peano
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { prev } -> Peano::Succ { prev: peano_add(prev, b) }
    }
}

machine lemma(x: Peano, y: Peano) { }

machine consumer(p: Peano, q: Peano) {
    lemma(q, peano_add(p, q));
}
