// Existing references cross generic calls without a second authored borrow.
// Both nominal and structural machine binders increment the same counter.
// Expected exit: 2.
use omega_language_std::console;

trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter {
    value: i32 in Wrapping;
}

machine Counter::increment(counter: &mut Counter) satisfies Incrementable<Counter>::increment {
    counter.value = counter.value + 1;
}
CounterIncrementable satisfies Incrementable<Counter> {
    Incrementable::increment = Counter::increment;
}

// The two helpers own distinct type parameters; the explicit applications
// connect them by identity while preserving the existing mutable reference.
machine nominal_step<StepSubject, machine Increment>(subject: &mut StepSubject)
where machine Increment satisfies Incrementable<StepSubject>::increment;
{
    Increment(subject);
}

machine nominal_forward<ForwardedSubject, machine Increment>(subject: &mut ForwardedSubject)
where machine Increment satisfies Incrementable<ForwardedSubject>::increment;
{
    nominal_step<ForwardedSubject, Increment>(subject);
}

machine structural_step<StepSubject, machine Increment>(subject: &mut StepSubject)
where machine Increment(target: &mut StepSubject);
{
    Increment(subject);
}

machine structural_forward<ForwardedSubject, machine Increment>(subject: &mut ForwardedSubject)
where machine Increment(target: &mut ForwardedSubject);
{
    structural_step<ForwardedSubject, Increment>(subject);
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) reaches Console {
    nominal_forward<Counter, Counter::increment>(&mut main.counter);
    structural_forward<Counter, Counter::increment>(&mut main.counter);
    Console::exit_process(main.counter.value as i32);
}
