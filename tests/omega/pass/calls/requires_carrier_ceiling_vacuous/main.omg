// `s <= u64::MAX` holds of every u64 by carrier extent and discharges
// without evidence -- the literal exceeds the i64 operand read.
use omega_language_std::console;

machine echo(scale: u64) -> u64
requires scale <= 18446744073709551615
{
    transition { _ -> (scale) }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let s: u64 = opaque();
    let r: u64 = echo(s);
    Console::exit_process(70);
}

machine opaque() -> u64 {
    transition { _ -> (4u64) }
}
