// Expected exit: 0.
// Selecting Success from pick(Gate{threshold:5}) transports exact above(gate.threshold) evidence and preserves threshold 5.
data Outcome [copy] { case Success; case Failure; }
data Gate [copy] { threshold: u32; }
trait Evidence {}
proposition above(limit: u32) evidence Evidence;
Fresh satisfies Evidence {}
data Envelope [copy] { gate: Gate; }
data Holder [copy] { payload: Envelope; }
machine pick(tag: u32, first: Envelope, second: Envelope) -> Outcome
ensures Outcome::Success -> { selected: above(first.gate.threshold); other: above(second.gate.threshold); }
{ selected = Fresh; other = Fresh; Outcome::Success }
machine probe() -> bool {
 let holder: Holder = Holder { payload: Envelope { gate: Gate { threshold: 5 } } };
 let other: Envelope = Envelope { gate: Gate { threshold: 6 } };
 transition pick(9, holder.payload, other) {
  Outcome::Success { ; selected: proof, other: different } -> (holder.payload.gate.threshold == 5 && other.gate.threshold == 6)
  _ -> (false)
 }
}
machine main() crashes Trap {
 transition probe() { true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
