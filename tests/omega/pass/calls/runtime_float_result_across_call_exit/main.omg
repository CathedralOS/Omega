use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::float_operations;
machine read_value(console: &mut Binding<Console>) -> i32 reaches Console {
    let observed: ByteRead = block console.read_byte();
    transition observed { ByteRead::Eof -> (0 - 1) ByteRead::Byte { value } -> value }
}
machine transform(value: f64) -> f64 { value * 1.5 + 0.25 }
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let raw: i32 = block read_value(&mut main.console);
    let value: f64 = F64::from_i32(raw);
    let first: f64 = transform(value);
    let second: f64 = transform(value + 0.5);
    main.console.write_byte(70);
    transition first == (0.0 - 1.25) && second == (0.0 - 0.5) { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { main.console.write_byte(10); main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.write_byte(88); main.console.write_byte(10); main.console.exit_process(71); }
}
