use omega_language_std::console;
use omega::language::core::float_operations;
machine read_value() -> i32 reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed { ByteRead::Eof -> (0 - 1) ByteRead::Byte { value } -> value }
}
machine transform(value: f64) -> f64 { value * 1.5 + 0.25 }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let raw: i32 = block read_value();
    let value: f64 = F64::from_i32(raw);
    let first: f64 = transform(value);
    let second: f64 = transform(value + 0.5);
    Console::write_byte(70);
    transition first == (0.0 - 1.25) && second == (0.0 - 0.5) { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::write_byte(10); Console::exit_process(70); }
    state bad(main: &mut Main) { Console::write_byte(88); Console::write_byte(10); Console::exit_process(71); }
}
