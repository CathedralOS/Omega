// RUN CANARY (exit 70). A literal element of a call result's scalar array is
// observed from the completed value, like a field of that value: the result
// has no storage for an indexed read to name. Each `make(..)` occurrence sits
// to the right of `&&`, so it runs only when the guard reaches it, and each
// selection keeps the builtin `[]` meaning at the carrier the walk reaches:
// an element leaf below a field, a record element whose field is read, a
// Boolean element below a record element, and the same reads in a later
// state. Any wrong element or skipped evaluation exits 71.
use omega_language_std::console;

data Row [copy] { v: i32; flags: [bool; 2]; }
data Inner [copy] { bytes: [u8; 4]; }
data Table [copy] { inner: Inner; rows: [Row; 3]; }

machine make(seed: u8) -> Table {
    Table {
        inner: Inner { bytes: [seed, 2, 7, 9] },
        rows: [
            Row { v: 1, flags: [false, true] },
            Row { v: 5, flags: [true, false] },
            Row { v: 9, flags: [false, false] }
        ]
    }
}

data Main { seed: u8; }

machine Main::main(main: &mut Main) reaches Console {
    main.seed = 3;
    transition main.seed == 3 && make(main.seed).inner.bytes[2] == 7
        && make(main.seed).rows[1].v == 5 && make(main.seed).inner.bytes[0] == main.seed
        && make(main.seed).rows[0].flags[1] {
        true -> later(main)
        _ -> bad(main)
    }
    state later(main: &mut Main) {
        transition main.seed != 4 && !make(main.seed).rows[2].flags[0] && make(main.seed).rows[2].v == 9 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
