// The param-arm face: a value call whose callee's ARM states mutate a &mut
// PARAM (ParameterOrAlias kind, not MachineOwned). One call, one selected
// arm -> tally.count should be 1. Exit = the raw count. The callee lives on
// its own data family so the call's shared receiver cannot overlap the
// &mut Tally argument (that distinct aliasing fence would fire first).
// This program is ACCEPTED: &mut record parameters on arm states transfer
// their storage across state transitions, and the composed scalar call
// rejoins the authored position of the projected receiver actual
// (`main.picker`). Exit 1 proves `hi` ran once against the caller's Tally.
use omega_language_std::console;

data Tally { count: i32 in Wrapping; }
data Picker {}
data Main { picker: Picker; tally: Tally; v: i32; }
machine Picker::pick(x: i32, tally: &mut Tally) -> i32 {
    transition x > 0 { true -> hi(tally) _ -> lo(tally) }
    state hi(tally: &mut Tally) -> i32 {
        tally.count = tally.count + 1;
        100
    }
    state lo(tally: &mut Tally) -> i32 {
        tally.count = tally.count + 10;
        200
    }
}
machine Main::main(main: &mut Main) reaches Console {
    main.v = 5;
    let n: i32 = Picker::pick(main.v, &mut main.tally);
    transition n == 100 { true -> report(main) _ -> bad(main, 99) }
    state report(main: &mut Main) { Console::exit_process(main.tally.count as i32); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
