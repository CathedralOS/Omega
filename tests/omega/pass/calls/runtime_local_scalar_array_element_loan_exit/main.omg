// A call borrows one element of initialized local array storage. Its write
// remains visible to the caller without changing the neighboring element.
use omega_language_std::console;

data Main { }

machine write_marker(value: &mut u32) {
    value = 70;
}

machine Main::main(main: &mut Main) reaches Console {
    let values: [u32; 2] = [10, 20];
    let position: u64 = 1;
    write_marker(&mut values[position]);
    transition values[0] == 10 && values[1] == 70 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
