// A non-scalar case payload remains a constructed call argument, including
// its nested enum or owned record. Both calls are reached, and the caller
// observes the selected case through the factory's returned record. The
// affine payload moves into its callee, which owns its selected-case cleanup.
// The sibling Context argument owns both its explicit scalar field and the
// synthesized zero initializer for padding; neither belongs to the case.
use omega_language_std::console;

data ScanCompareTypeImmediate [copy] {
    case Equal;
    case NotEqual;
}
data ScanCompareType [copy] {
    case Immediate(compare_type: ScanCompareTypeImmediate);
    case Relative;
}
data ValueFormat [copy] {
    case Decimal;
    case Hexadecimal;
}

data Payload { value: u64; }
data Context { padding: [u64; 2]; value: u64; }
data Message {
    case Present(payload: Payload);
    case Empty;
}

data Output { value: u64; }
machine Output::from_format(format: ValueFormat) -> Output {
    transition format {
        ValueFormat::Decimal -> (Output { value: 10 })
        ValueFormat::Hexadecimal -> (Output { value: 0 })
    }
}
machine Output::from_array(values: [u64; 2]) -> Output {
    Output { value: values[1] }
}
machine Output::from_compare(context: Context, compare: ScanCompareType) -> Output {
    transition compare {
        ScanCompareType::Immediate { compare_type } -> (Output { value: context.value })
        ScanCompareType::Relative -> (Output { value: 0 })
    }
}
machine Output::from_message(message: Message) -> Output {
    transition message {
        Message::Present { payload } -> (Output { value: 40 })
        Message::Empty -> (Output { value: 0 })
    }
}
machine Output::forward(output: Output) -> Output {
    Output { value: output.value }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let comparison: Output = Output::from_compare(
        Context { value: 30 },
        ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal }
    );
    let message: Output = Output::from_message(
        Message::Present { payload: Payload { value: 40 } }
    );
    let forwarded: Output = Output::forward(message);
    let constructed: bool = construct();
    transition comparison.value == 30 && forwarded.value == 40 && constructed {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}

// Scalar-returning callers retain the same constructed argument occurrences
// as Unit callers, including simple cases, nested payloads and scalar arrays.
machine construct() -> bool {
    let format: Output = Output::from_format(ValueFormat::Decimal);
    let comparison: Output = Output::from_compare(
        Context { value: 30 },
        ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal }
    );
    let message: Output = Output::from_message(
        Message::Present { payload: Payload { value: 40 } }
    );
    let forwarded: Output = Output::forward(message);
    let array: Output = Output::from_array([11, 29]);
    format.value == 10 && comparison.value == 30 && forwarded.value == 40 && array.value == 29
}
