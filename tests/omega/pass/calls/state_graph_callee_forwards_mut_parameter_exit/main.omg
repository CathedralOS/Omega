// A value-returning helper forwards its `&mut Main` parameter from state to
// state, and each state's exit arms read through the loan that state
// received. The last state forwards the loan nowhere: its own exit arms are
// the loan's final uses, so the loan must stay live into those arms. The
// scalar helper returns one table slot, the record helper a `Reading` built
// from one; both read the caller's current storage, not a snapshot.
//
//   read_at(main, 1)     second state, true arm   20
//   read_at(main, 2)     third state, true arm    45
//   read_at(main, 3)     third state, false arm   60
//   table[2] = 50, then
//   read_at(main, 2)     third state, true arm    50
//   reading_at(main, 3)  third state, false arm   { 60, 3 }
//
// Exit 71: a scalar result is wrong. Exit 72: the record result is wrong.
// Expected exit: 70.

use omega_language_std::console;

data Reading {
    value: i32;
    index: i32;
}

data Main {
    table: [i32; 4];
}

machine Main::read_at(main: &mut Main, index: i32) -> i32 {
    transition index == 0 {
        true -> (main.table[0])
        _ -> second(main, index)
    }

    state second(main: &mut Main, index: i32) {
        transition index == 1 {
            true -> (main.table[1])
            _ -> third(main, index)
        }
    }

    state third(main: &mut Main, index: i32) {
        transition index == 2 {
            true -> (main.table[2])
            _ -> (main.table[3])
        }
    }
}

machine Main::reading_at(main: &mut Main, index: i32) -> Reading {
    transition index == 0 {
        true -> (Reading { value: main.table[0], index: 0 })
        _ -> second(main, index)
    }

    state second(main: &mut Main, index: i32) {
        transition index == 1 {
            true -> (Reading { value: main.table[1], index: 1 })
            _ -> third(main, index)
        }
    }

    state third(main: &mut Main, index: i32) {
        transition index == 2 {
            true -> (Reading { value: main.table[2], index: 2 })
            _ -> (Reading { value: main.table[3], index: 3 })
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.table[0] = 5;
    main.table[1] = 20;
    main.table[2] = 45;
    main.table[3] = 60;
    let second: i32 = Main::read_at(main, 1);
    let third: i32 = Main::read_at(main, 2);
    let last: i32 = Main::read_at(main, 3);
    main.table[2] = 50;
    let rewritten: i32 = Main::read_at(main, 2);
    let reading: Reading = Main::reading_at(main, 3);
    let reading_value: i32 = reading.value;
    let reading_index: i32 = reading.index;
    transition second == 20 && third == 45 && last == 60 && rewritten == 50 {
        true -> check_record(main, reading_value, reading_index)
        _ -> finish(main, 71)
    }

    state check_record(main: &mut Main, value: i32, index: i32) {
        transition value == 60 && index == 3 {
            true -> finish(main, 70)
            _ -> finish(main, 72)
        }
    }

    state finish(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
