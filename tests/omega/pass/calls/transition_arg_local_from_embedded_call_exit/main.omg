// RUN CANARY (exit 70). A local whose initializer CONTAINS a value call
// (`let r1 = base + main.calc.double_val(6) * 3`) passed as a TRANSITION
// ARGUMENT to another state must copy the local's slot, not be folded back into
// its initializer and re-materialized in the target state.
//
// Regression guard: argument resolution folded such a local into its
// initializer and tried to re-evaluate it in the TARGET state -- but the
// embedded call's result scratch lives in the SOURCE state's frame and is not
// reproducible there, so the target's parameter slot was never written (it held
// garbage) and the program miscompiled (native exit 73). Only a TOP-LEVEL call
// blocked the fold; a call nested in a binary did not. Fixed by blocking the
// inline fold whenever the initializer contains a result-producing call, so the
// local stays a place and its slot is copied into the parameter.

use omega_language_std::console;

data Calc {}

data Main {
    calc: Calc;
}

machine Calc::double_val(n: i32 in Wrapping) -> i32 in Wrapping {
    transition {
        _ -> (n * 2)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut base: i32 in Wrapping = 10;
    let r1: i32 in Wrapping = base + Calc::double_val(6) * 3;  // 46
    transition r1 == 46 {
        true -> step2(main, r1)
        _ -> bad(main)
    }
    state step2(main: &mut Main, r1: i32 in Wrapping) {
        transition r1 == 46 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
