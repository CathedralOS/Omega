// GUARDED-ARM VALUE CALLS WITH A COMPUTED ARGUMENT (task #45's V1 gate,
// graduated): a guarded arm's value call rewrites to a synthesized
// continuation state. `dbl(x)` keeps every argument a bare NAME of an
// enclosing state parameter; `dbl(x + 1)` additionally evaluates a computed
// argument through the spliced continuation, whose operation proof
// obligation the backend now discharges. pick(60) takes the true arm,
// dbl(61) returns 122, and main exits 70.
use omega_language_std::console;
use omega::language::core::service;
data Main { console: Service<Console>; }
machine dbl(x: i32 [0..=1001]) -> i32 {
    transition { _ -> (x + x) }
}
machine pick(x: i32 [0..=1000]) -> i32 {
    transition x > 50 { true -> (dbl(x + 1)) _ -> (x) }
}
machine Main::main(&mut self) reaches Console {
    let p: i32 = pick(60);
    transition p == 122 { true -> good() _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
}
