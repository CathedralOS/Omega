// GUARDED-ARM VALUE CALLS WITH A COMPUTED ARGUMENT: a guarded arm's value
// call is evaluated inside the selected arm, operands first. `dbl(x + 1)`
// computes its argument and calls at the authored point; pick(60) takes the
// true arm, dbl(61) returns 122, and main exits 70.
use omega_language_std::console;
use omega::language::core::binding;
domain i32::I320To1001 requires 0 <= self && self <= 1001;
domain i32::I320To1000 requires 0 <= self && self <= 1000;
data Main { console: Binding<Console>; }
machine dbl(x: i32 in I320To1001) -> i32 {
    transition { _ -> (x + x) }
}
machine pick(x: i32 in I320To1000) -> i32 {
    transition x > 50 { true -> (dbl(x + 1)) _ -> (x) }
}
machine Main::main(&mut self) reaches Console {
    let p: i32 = pick(60);
    transition p == 122 { true -> good() _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
}
