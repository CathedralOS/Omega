module builtin_named_machine_call_exit;

use omega_language_std::console;

// Authored machines spelled like the compiler's `clamp` and `max` builtins
// shadow them. Each bare call selects the declaration in this module with its
// own arity, `requires` and result, where the builtins would need three and
// two operands. The calls sit in a let initializer, a value cast, a terminal
// value and a guard comparison: lowering keeps a builtin-spelled call in
// place in the last three before resolution, and the selected machine must
// still run there.
machine clamp(value: u32) -> u32
    requires value <= 4;
{
    value + 1
}

machine max(value: u32) -> u32
    requires value <= 4;
{
    value + 40
}

machine forward(value: u32) -> u32
    requires value <= 4;
{
    max(value)
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let limited: u32 = clamp(3);
    let widened: u64 = (max(2) as u64) + 1;
    let forwarded: u32 = forward(3);
    transition limited == 4 && widened == 43 && forwarded == 43 {
        true -> compared()
        false -> failed()
    }
    state compared() {
        transition max(2) == 42 {
            true -> passed()
            false -> failed()
        }
    }
    state passed() { Console::exit_process(7); }
    state failed() { Console::exit_process(90); }
}
