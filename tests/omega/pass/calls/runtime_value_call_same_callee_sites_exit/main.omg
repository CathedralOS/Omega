// Same-callee value calls, multiple sites per state, DISPATCH path -- the
// three shapes the old shared-result-slot fence rejected (or silently missed),
// all delivering per-site since the deferral contiguity work (faces #4/#5):
// (1) two field stores (f=dbl(5), g=dbl(6));
// (2) discriminating THREE sites incl. const-indexed elements
//     (h=dbl(8), arr[0]=dbl(6), arr[2]=dbl(7));
// (3) LC1b let-then-copy-to-field (the fence's accepted false negative).
// Every site must hold ITS call's result -- a shared slot delivers the LAST
// result to all sites. exit 70 = all nine values right; 71..79 name the site.
use omega_language_std::console;
data Main {
    console: Console;
    f: i32 in Wrapping;
    g: i32 in Wrapping;
    h: i32 in Wrapping;
    arr: [i32 in Wrapping; 4];
    p: i32 in Wrapping;
    q: i32 in Wrapping;
}
machine Main::dbl(&self, x: i32 in Wrapping) -> i32 in Wrapping {
    let r: i32 in Wrapping = x * 2;
    transition r >= 0 { _ -> done(r) }
    state done(&self, v: i32 in Wrapping) -> i32 in Wrapping { v }
}
machine Main::main(&mut self) {
    self.f = self.dbl(5);
    self.g = self.dbl(6);
    transition self.f == 10 { true -> chk_g() _ -> bad(71) }

    state chk_g(&mut self) {
        transition self.g == 12 { true -> three_sites() _ -> bad(72) }
    }

    state three_sites(&mut self) {
        self.h = self.dbl(8);
        self.arr[0] = self.dbl(6);
        self.arr[2] = self.dbl(7);
        transition self.h == 16 { true -> chk_0() _ -> bad(73) }
    }

    state chk_0(&mut self) {
        transition self.arr[0] == 12 { true -> chk_2() _ -> bad(74) }
    }

    state chk_2(&mut self) {
        transition self.arr[2] == 14 { true -> lc1b() _ -> bad(75) }
    }

    state lc1b(&mut self) {
        let a: i32 in Wrapping = self.dbl(2);
        let b: i32 in Wrapping = self.dbl(3);
        self.p = a;
        self.q = b;
        transition self.p == 4 { true -> chk_q() _ -> bad(76) }
    }

    state chk_q(&mut self) {
        transition self.q == 6 { true -> good() _ -> bad(77) }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
