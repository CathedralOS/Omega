// A result-bearing machine receives a borrowed `&mut Rng`, forwards it through
// two mutating calls, guards on the count, then enters a trailing state that
// mutates and guards the same receiver again. Each guard must observe the
// mutations made before its own authored phase: the outer guard sees 2 calls
// and the trailing guard sees 3. Exits 71/72 distinguish an outer/trailing
// guard evaluated against a stale or flattened phase.
use omega_language_std::console;

data Rng { seed: u64 in Wrapping; calls: u32 in Wrapping; }
data Main { rng: Rng; }

machine bump(r: &mut Rng) {
    r.seed = r.seed + 7;
    r.calls = r.calls + 1;
}

machine draw(random: &mut Rng) -> u32 {
    bump(random);
    bump(random);
    transition random.calls == 2 {
        true -> after(random)
        _ -> (71)
    }
    state after(random: &mut Rng) -> u32 {
        bump(random);
        transition random.calls == 3 {
            true -> (70)
            _ -> (72)
        }
    }
}

machine Main::main(context: &mut Main) reaches Console {
    let r: u32 = draw(&mut context.rng);
    transition r == 70 {
        true -> good(context)
        _ -> bad(context)
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state bad(context: &mut Main) { Console::exit_process(71); }
}
