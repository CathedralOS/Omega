machine build(builder: &mut Build) {
    Build::application(builder, "callback_owned_indirect_record");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Prepare, PrepareProvider>(builder);
    Build::select_provider<Invoke, InvocationProvider>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
