machine build(builder: &mut Build) {
 Build::application(builder, "user32_window_procedure_registration");
 Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
 Build::select_provider<Registrar, RegistrarProvider>(builder, linux_arm64);
 Build::select_provider<Registrar, RegistrarProvider>(builder, linux_x86_64);
 Build::select_provider<Registrar, RegistrarProvider>(builder, macos_arm64);
 Build::select_provider<Registrar, RegistrarProvider>(builder, macos_x86_64);
 Build::select_provider<Registrar, RegistrarProvider>(builder, windows_x86_64);
 Build::select_provider<Registrar, RegistrarProvider>(builder, uefi_x86_64);
 Build::select_provider<Registrar, RegistrarProvider>(builder, cross_platform_cli);
 Build::select_provider<Registrar, RegistrarProvider>(builder, local_unchecked);
 Build::select_provider<Registrar, RegistrarProvider>(builder, alpha_bootstrap);
 Build::select_provider<ClassApi, Imports>(builder, linux_arm64);
 Build::select_provider<ClassApi, Imports>(builder, linux_x86_64);
 Build::select_provider<ClassApi, Imports>(builder, macos_arm64);
 Build::select_provider<ClassApi, Imports>(builder, macos_x86_64);
 Build::select_provider<ClassApi, Imports>(builder, windows_x86_64);
 Build::select_provider<ClassApi, Imports>(builder, uefi_x86_64);
 Build::select_provider<ClassApi, Imports>(builder, cross_platform_cli);
 Build::select_provider<ClassApi, Imports>(builder, local_unchecked);
 Build::select_provider<ClassApi, Imports>(builder, alpha_bootstrap);
 Build::select_provider<ContextApi, Imports>(builder, linux_arm64);
 Build::select_provider<ContextApi, Imports>(builder, linux_x86_64);
 Build::select_provider<ContextApi, Imports>(builder, macos_arm64);
 Build::select_provider<ContextApi, Imports>(builder, macos_x86_64);
 Build::select_provider<ContextApi, Imports>(builder, windows_x86_64);
 Build::select_provider<ContextApi, Imports>(builder, uefi_x86_64);
 Build::select_provider<ContextApi, Imports>(builder, cross_platform_cli);
 Build::select_provider<ContextApi, Imports>(builder, local_unchecked);
 Build::select_provider<ContextApi, Imports>(builder, alpha_bootstrap);
 Build::select_provider<ModuleApi, Imports>(builder, linux_arm64);
 Build::select_provider<ModuleApi, Imports>(builder, linux_x86_64);
 Build::select_provider<ModuleApi, Imports>(builder, macos_arm64);
 Build::select_provider<ModuleApi, Imports>(builder, macos_x86_64);
 Build::select_provider<ModuleApi, Imports>(builder, windows_x86_64);
 Build::select_provider<ModuleApi, Imports>(builder, uefi_x86_64);
 Build::select_provider<ModuleApi, Imports>(builder, cross_platform_cli);
 Build::select_provider<ModuleApi, Imports>(builder, local_unchecked);
 Build::select_provider<ModuleApi, Imports>(builder, alpha_bootstrap);
 Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
