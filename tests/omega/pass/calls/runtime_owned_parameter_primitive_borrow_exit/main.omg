data Pair { first: u8; second: u8; }

machine read(value: &u8) -> u8 { value }

machine inspect(pair: Pair) -> u8 { read(&pair.first) }

machine main() crashes Trap {
    let pair: Pair = Pair { first: 17, second: 23 };
    let observed: u8 = inspect(pair);
    transition observed == 17 {
        true -> passed()
        _ -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
