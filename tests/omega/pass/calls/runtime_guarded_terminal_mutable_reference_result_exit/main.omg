data Node { value: u64; }

machine identity(node: &mut Node) -> &mut Node { node }

machine ordinary(node: &mut Node) -> &mut Node {
    let result: &mut Node = identity(node);
    result
}

machine choose(node: &mut Node, take: bool) -> &mut Node {
    transition take {
        true -> identity(node)
        _ -> ordinary(node)
    }
}

machine mixed(node: &mut Node, take: bool) -> &mut Node {
    transition take {
        true -> identity(node)
        _ -> (node)
    }
}

machine main() crashes Trap {
    let mut first: Node = Node { value: 70 };
    let mut second: Node = Node { value: 71 };
    let first_result: &mut Node = choose(&mut first, true);
    let first_value: u64 = first_result.value;
    let second_result: &mut Node = choose(&mut second, false);
    let second_value: u64 = second_result.value;
    let ordinary_result: &mut Node = ordinary(&mut first);
    let ordinary_value: u64 = ordinary_result.value;
    let mixed_first: &mut Node = mixed(&mut first, true);
    let mixed_first_value: u64 = mixed_first.value;
    let mixed_second: &mut Node = mixed(&mut second, false);
    transition first_value == 70 && second_value == 71 && ordinary_value == 70
        && mixed_first_value == 70 && mixed_second.value == 71 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
