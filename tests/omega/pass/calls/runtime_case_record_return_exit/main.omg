// Case observations retain the owned subject until the selected value returns.
// Its disposal must join the unused parameters in reverse declaration order.
use omega_language_std::console;

data Direction { case Left; case Right; case Up; case Down; }
data Spare { value: u64; }
data Output [copy] { value: u64; }
data Main { total: u64 in Saturating; }

machine make(first: Spare, direction: Direction, last: Spare) -> Output {
    transition direction {
        Direction::Left -> Output { value: 20 }
        Direction::Right -> Output { value: 50 }
        Direction::Up -> Output { value: 30 }
        Direction::Down -> Output { value: 40 }
    }
}

machine delta(direction: Direction) -> Output {
    transition direction {
        Direction::Left -> Output { value: 1 }
        Direction::Right -> Output { value: 2 }
        Direction::Up -> Output { value: 3 }
        Direction::Down -> Output { value: 4 }
    }
}

machine Main::direct(main: &mut Main, direction: Direction) {
    let output: Output = delta(direction);
    main.total = main.total + (output.value as u64 in Saturating);
}

machine Main::step(main: &mut Main, direction: Direction) {
    let first: Spare = Spare { value: 1 };
    let last: Spare = Spare { value: 2 };
    let output: Output = make(first, direction, last);
    main.total = main.total + (output.value as u64 in Saturating);
}

machine Main::main(main: &mut Main) reaches Console {
    main.total = 0;
    Main::step(main, Direction::Left);
    Main::step(main, Direction::Right);
    Main::direct(main, Direction::Left);
    Main::direct(main, Direction::Right);
    Main::direct(main, Direction::Up);
    Main::direct(main, Direction::Down);
    transition main.total == 80 {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
