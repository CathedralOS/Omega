// A record carrying `data Session where retries <= 3` facts can carry its
// nested service: the facts constrain the record's scalar field; they do not
// hide the requirement application from establishment through the nested
// record.
public boundary trait Host {
    machine ping() reaches Host;
}
data Session where retries <= 3 {
    retries: u64;
}
data Main {
    session: Session;
}
machine Main::main(main: &mut Main) reaches Host {
    Host::ping();
    transition main.session.retries <= 3 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
