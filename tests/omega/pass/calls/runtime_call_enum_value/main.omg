// A call result lands in the receiver's enum field as a runtime value:
// `item = self.pick()`. The deployable shape matches the sibling runtime
// canaries: the stored case is checked in a guard ladder and the process
// exits 70 only when exact.

use omega_language_std::console;
use omega::language::core::service;

data ItemKind {
    case RustedDagger;
    case DeepKey;
}

data Main {
    console: Service<Console>;
    item: ItemKind;
}

machine Main::main(&mut self) reaches Console {
    self.item = self.pick();

    transition self.item == ItemKind::DeepKey {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::pick(&mut self) -> ItemKind {
    ItemKind::DeepKey
}
