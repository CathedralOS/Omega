// A constant machine's tail expression exposes the same closed constructor
// as a value transition. The zero-valued Point passed below meets take's
// exact identity requirement after Point::zero unfolds; Shape::Unit meets
// count's requirement in the same way. The differing-constructor control is
// fail/calls/struct_constant_requires_argument_rejected.
use omega_language_std::Console;
data Point { x: u64; y: u64; }
data Shape {
    case Unit;
    case Scaled(factor: u64);
}
data Main { }
machine Point::zero() -> Point {
    Point {
        x: 0,
        y: 0,
    }
}
machine Shape::unit() -> Shape {
    Shape::Unit
}
machine Main::take(p: Point) -> u64
    requires core::Identity<Point>(p, Point::zero())
{
    p.y
}
machine Main::count(s: Shape) -> u64
    requires core::Identity<Shape>(s, Shape::unit())
{
    transition s {
        Shape::Unit -> (0)
        Shape::Scaled { factor } -> (factor)
    }
}
machine Main::main(main: &mut Main) reaches Console {
    let taken: u64 = Main::take(Point {
        x: 0,
        y: 0,
    });
    let counted: u64 = Main::count(Shape::Unit);
    transition taken == 0 && counted == 0 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
