// A constant machine whose body is a tail expression (`{ Point { x: 0, y: 0 } }`)
// unfolds to its closed constructor exactly as one spelled as a value
// transition does, in both directions of the instantiated judgment:
// `Main::take(Point { x: 0, y: 0 })` under `requires p == Point::zero()`
// instantiates to `Point { x: 0, y: 0 } == Point { x: 0, y: 0 }` and is
// proven; a case constant (`Shape::unit()` yielding `Shape::Unit`) proves the
// same way. The refuted direction is pinned by
// fail/calls/struct_constant_requires_argument_rejected.
use omega_language_std::console;
data Point { x: u64; y: u64; }
data Shape {
    case Unit;
    case Scaled(factor: u64);
}
data Main { }
machine Point::zero() -> Point {
    Point {
        x: 0,
        y: 0,
    }
}
machine Shape::unit() -> Shape {
    Shape::Unit
}
machine Main::take(p: Point) -> u64
    requires p == Point::zero();
{
    p.y
}
machine Main::count(s: Shape) -> u64
    requires s == Shape::unit();
{
    transition s {
        Shape::Unit -> (0)
        Shape::Scaled { factor } -> (factor)
    }
}
machine Main::main(main: &mut Main) reaches Console {
    let taken: u64 = Main::take(Point {
        x: 0,
        y: 0,
    });
    let counted: u64 = Main::count(Shape::Unit);
    transition taken == 0 && counted == 0 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
