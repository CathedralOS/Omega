// An enum-attached machine with omitted erased evidence matching BARE `self`
// (the enum-method idiom):
// `transition signal { Signal::Green -> .. }` inside `Signal::go_value(signal: &Signal)`,
// called as `Signal::go_value(&main.s)`. The guard subject resolves to the attached
// value's TAG at the receiver's storage base
// (resolve_machine_owned_self_case_tag_place_in_table, threaded to the
// CALLEE's machine via the expansion's branch_key -- the caller's machine
// resolved `self` to the caller's own attached data before). All three
// cases DISCRIMINATE, including the non-ZII last tag; a bool designed-false
// leg guards against always-first-arm coincidence.
// exit 70 = all legs right; 71..74 name the leg.
use omega_language_std::console;
data Evidence { case Only; }
data Signal { proof [erased]: Evidence; case Red; case Amber; case Green; }
machine Signal::go_value(signal: &Signal) -> i32 {
    transition signal {
        Signal::Green -> g(signal)
        Signal::Amber -> a(signal)
        _ -> r(signal)
    }
    machine g(signal: &Signal) -> i32 { 30 }
    machine a(signal: &Signal) -> i32 { 20 }
    machine r(signal: &Signal) -> i32 { 10 }
}
machine Signal::is_green(signal: &Signal) -> bool {
    transition signal { Signal::Green -> yes(signal) _ -> no(signal) }
    machine yes(signal: &Signal) -> bool { true }
    machine no(signal: &Signal) -> bool { false }
}
data Main { s: Signal; v1: i32; v2: i32; v3: i32; flag: bool; }
machine Main::main(main: &mut Main) reaches Console {
    main.s = Signal::Green;
    main.v1 = Signal::go_value(&main.s);
    transition main.v1 == 30 { true -> leg2(main) _ -> bad(main, 71) }
    machine leg2(main: &mut Main) {
        main.s = Signal::Amber;
        main.v2 = Signal::go_value(&main.s);
        transition main.v2 == 20 { true -> leg3(main) _ -> bad(main, 72) }
    }
    machine leg3(main: &mut Main) {
        main.s = Signal::Red;
        main.v3 = Signal::go_value(&main.s);
        transition main.v3 == 10 { true -> leg4(main) _ -> bad(main, 73) }
    }
    machine leg4(main: &mut Main) {
        // Designed-false: Red is NOT green.
        main.flag = Signal::is_green(&main.s);
        transition main.flag { true -> bad(main, 74) _ -> good(main) }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
