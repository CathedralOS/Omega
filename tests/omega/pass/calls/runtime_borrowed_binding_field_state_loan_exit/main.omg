// A hosted entry passes its stored count to a state: `speak(main.count)`. The
// state applies the exact console requirement and forwards the same ordinary
// data to a second state, which writes again and exits.
//
// exits: 70 = both writes ran through the direct requirement with the stored
// count; 71 = the count did not arrive.

use omega_language_std::console;

data Main {
    count: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 3;
    transition { _ -> speak(main.count) }

    state speak(count: u64) {
        Console::write_line("first");
        transition count == 3 {
            true -> finish(70)
            _ -> finish(71)
        }
    }

    state finish(code: i32) {
        Console::write_line("second");
        Console::exit_process(code);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
