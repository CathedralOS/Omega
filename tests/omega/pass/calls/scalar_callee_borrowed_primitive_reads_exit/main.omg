// A scalar-returning machine reads its `&u8` formal through the loan, never
// through a caller-side snapshot. The caller lends a mutable primitive local
// whole, then one element of its receiver's byte array twice around a store
// to that element, and finally the same element to a machine whose scalar
// formal precedes the borrowed one. Exits 70 only when every read observed
// the current storage; 71..74 name the read that did not.
use omega_language_std::console;

data Main {
    buf: [u8; 4];
}

machine is_seventy(leaf: &u8) -> bool {
    transition leaf == 70 { true -> (true) _ -> (false) }
}

machine above(limit: u8, leaf: &u8) -> bool {
    transition leaf > limit { true -> (true) _ -> (false) }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut value: u8 = 70;
    let whole: bool = is_seventy(&value);
    main.buf[1] = 69;
    let before: bool = is_seventy(&main.buf[1]);
    main.buf[1] = 70;
    let after: bool = is_seventy(&main.buf[1]);
    let mixed: bool = above(69, &main.buf[1]);
    transition whole {
        true -> check_before(main, before, after, mixed)
        _ -> failed(main, 71)
    }

    state check_before(main: &mut Main, before: bool, after: bool, mixed: bool) {
        transition before {
            true -> failed(main, 72)
            _ -> check_after(main, after, mixed)
        }
    }

    state check_after(main: &mut Main, after: bool, mixed: bool) {
        transition after {
            true -> check_mixed(main, mixed)
            _ -> failed(main, 73)
        }
    }

    state check_mixed(main: &mut Main, mixed: bool) {
        transition mixed {
            true -> done(main)
            _ -> failed(main, 74)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state failed(main: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
