// Returning calls lend the referent of a stored descriptor, not the descriptor
// itself. Whole, projected and forwarded loans still mutate the original home.
machine put(slot: &mut u32, value: u32) -> u32 { slot = value; value }
machine relay(slot: &mut u32, value: u32) -> u32 { put(slot, value) }
machine observe(slot: &u32) -> u32 { slot }
data View<'body, 'spare> { body: &'body mut u32; spare: &'spare mut u32; stamp: u32; }
machine select<'body, 'spare>(value: View<'body, 'spare>) -> &'body mut u32 { value.body }
machine select_after_sibling<'body, 'spare>(value: View<'body, 'spare>) -> &'body mut u32 {
    let picked: &mut u32 = value.body;
    let changed: u32 = put(value.spare, 45);
    picked
}
data Held<'body> { body: &'body mut u32; }
machine repack_after_sibling<'body, 'spare>(value: View<'body, 'spare>) -> &'body mut u32 {
    let picked: &mut u32 = value.body;
    let changed: u32 = put(value.spare, 47);
    let held: Held = Held { body: picked };
    held.body
}

data Pair { first: u32; second: u32; }
machine main() crashes Trap {
    let mut cells: [u32; 2] = [7, 8];
    let held: &mut u32 = &mut cells[1];
    let written: u32 = relay(held, 42);
    let mut pair: Pair = Pair { first: 9, second: 10 };
    let held_pair: &mut Pair = &mut pair;
    let projected: u32 = put(&mut held_pair.second, 43);
    let mut scalar: u32 = 5;
    let shared: &u32 = &scalar;
    let shared_result: u32 = observe(shared);
    let mut next: u32 = 11;
    let mut untouched: u32 = 12;
    let view: View = View { body: &mut next, spare: &mut untouched, stamp: 13 };
    let returned: &mut u32 = select(view);
    let returned_write: u32 = put(returned, 44);
    let mut delayed: u32 = 14;
    let mut sibling: u32 = 15;
    let delayed_view: View = View { body: &mut delayed, spare: &mut sibling, stamp: 16 };
    let delayed_return: &mut u32 = select_after_sibling(delayed_view);
    let delayed_write: u32 = put(delayed_return, 46);
    let mut repacked: u32 = 17;
    let mut spare: u32 = 18;
    let repacked_view: View = View { body: &mut repacked, spare: &mut spare, stamp: 19 };
    let repacked_return: &mut u32 = repack_after_sibling(repacked_view);
    let repacked_write: u32 = put(repacked_return, 48);
    transition written == 42 && projected == 43 && shared_result == 5
        && cells[0] == 7 && cells[1] == 42
        && pair.first == 9 && pair.second == 43 && scalar == 5
        && returned_write == 44 && next == 44 && untouched == 12
        && delayed_write == 46 && delayed == 46 && sibling == 45
        && repacked_write == 48 && repacked == 48 && spare == 47 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
