use omega::language::core::external_binding;
// Each host executes its selected libc strnlen.
machine build(builder: &mut Build) {
    Build::application(builder, "runtime_boundary_computed_selector_order_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind<CText::length>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_strnlen",
        },
    });
 Build::bind<CText::length>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "strnlen", version: "GLIBC_2.2.5",
        },
    });
}
