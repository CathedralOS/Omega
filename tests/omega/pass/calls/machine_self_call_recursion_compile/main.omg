// PASS CANARY: unmeasured call-spelled self-recursion (measured-recursion
// ruling 2026-07-18, MR1). A recursive CALL spelling (`true ->
// self.countdown(remaining - 1)`) on an unmeasured machine folds the
// self-prefixed arm target onto the same bare loop-back edge
// `-> countdown(..)` spells (constant stack, may legally diverge), so it
// compiles end to end on the native route. The measured twin RUNS:
// pass/calls/runtime_measured_tail_recursion_exit.
data Main {
}
machine Main::countdown(&mut self, remaining: u64) -> u64
{
    transition remaining > 0 {
        true -> self.countdown(remaining - 1)
        false -> 7
    }
}
machine Main::main(&mut self) {
    let value: u64 = self.countdown(2);
    transition value == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { }
    state no(&mut self) { }
}
