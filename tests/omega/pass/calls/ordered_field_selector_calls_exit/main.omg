// Each row/column selector is captured at its argument position. Later scalar
// effects must not change an earlier loan; moving the effect first selects the
// new cell. Distinct extents and indices also detect exchanged snapshots.
use omega_language_std::console;

data Cell { value: u64 in Wrapping; }
data Holder { cells: [Cell; 4]; }
data Matrix { rows: [Holder; 2]; }
data Cursor where row < 2, position < 4 { row: u64; position: u64; }
data Main { matrix: Matrix; cursor: Cursor; }

machine Cursor::advance(cursor: &mut Cursor) -> u64 in Wrapping {
    cursor.row = 0;
    cursor.position = 1;
    0
}
machine read_after(cell: &Cell, ignored: u64 in Wrapping) -> u64 in Wrapping {
    cell.value + ignored
}
machine read_before(ignored: u64 in Wrapping, cell: &Cell) -> u64 in Wrapping {
    cell.value + ignored
}
machine probe(matrix: &Matrix, cursor: &mut Cursor) -> bool {
    let first: u64 in Wrapping = read_after(&matrix.rows[cursor.row].cells[cursor.position], Cursor::advance(cursor));
    cursor.row = 1;
    cursor.position = 2;
    let second: u64 in Wrapping = read_before(Cursor::advance(cursor), &matrix.rows[cursor.row].cells[cursor.position]);
    first == 10 && second == 20
}
machine Main::main(main: &mut Main) reaches Console {
    main.matrix.rows[1].cells[2].value = 10;
    main.matrix.rows[0].cells[1].value = 20;
    main.cursor.row = 1;
    main.cursor.position = 2;
    let correct: bool = probe(&main.matrix, &mut main.cursor);
    transition correct {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
