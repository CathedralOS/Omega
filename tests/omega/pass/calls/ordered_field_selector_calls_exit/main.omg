// Each row/column selector is captured at its argument position. Later scalar
// effects must not change an earlier loan; moving the effect first selects the
// new cell. Distinct extents and indices also detect exchanged snapshots.
use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: u64 in Wrapping; }
data Holder { cells: [Cell; 4]; }
data Matrix { rows: [Holder; 2]; }
data Cursor { row: u64[0..2]; position: u64[0..4]; }
data Main { console: Binding<Console>; matrix: Matrix; cursor: Cursor; }

machine Cursor::advance(&mut self) -> u64 in Wrapping {
    self.row = 0;
    self.position = 1;
    0
}
machine read_after(cell: &Cell, ignored: u64 in Wrapping) -> u64 in Wrapping {
    cell.value + ignored
}
machine read_before(ignored: u64 in Wrapping, cell: &Cell) -> u64 in Wrapping {
    cell.value + ignored
}
machine probe(matrix: &Matrix, cursor: &mut Cursor) -> bool {
    let first: u64 in Wrapping = read_after(&matrix.rows[cursor.row].cells[cursor.position], cursor.advance());
    cursor.row = 1;
    cursor.position = 2;
    let second: u64 in Wrapping = read_before(cursor.advance(), &matrix.rows[cursor.row].cells[cursor.position]);
    first == 10 && second == 20
}
machine Main::main(&mut self) reaches Console {
    self.matrix.rows[1].cells[2].value = 10;
    self.matrix.rows[0].cells[1].value = 20;
    self.cursor.row = 1;
    self.cursor.position = 2;
    let correct: bool = probe(&self.matrix, &mut self.cursor);
    transition correct {
        true -> good()
        false -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
