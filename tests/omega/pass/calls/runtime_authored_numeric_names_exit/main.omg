machine abs(value: i32) -> i32
requires value >= -3i32 && value <= 3i32;
{ 7i32 }

machine max(left: i32, right: i32) -> i32 { 42i32 }

machine main() crashes Trap {
    let absolute: i32 = abs(-3i32);
    let maximum: i32 = max(2i32, 3i32);
    transition absolute == 7i32 && maximum == 42i32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
