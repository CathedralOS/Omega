// An affine local record lends one unrestricted leaf to a scalar-returning
// machine: a primitive field (`&pair.high`) and one element of a byte-array
// field (`&words.bytes[1]`). Each loan observes the local's own storage in
// place, so a store to another element before its loan is what the callee
// reads. Exits 70 only when every loan read the expected byte; 71..74 name
// the loan that did not.
use omega_language_std::console;
use omega::language::core::binding;

data Pair { low: u8; high: u8; }
data Words { count: u8; bytes: [u8; 4]; }

machine is_seventy(leaf: &u8) -> bool {
    transition leaf == 70 { true -> (true) _ -> (false) }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let pair: Pair = Pair { low: 3, high: 70 };
    let words: Words = Words { count: 4, bytes: [1, 70, 3, 4] };
    let field: bool = is_seventy(&pair.high);
    let sibling: bool = is_seventy(&pair.low);
    let element: bool = is_seventy(&words.bytes[1]);
    words.bytes[2] = 70;
    let stored: bool = is_seventy(&words.bytes[2]);
    transition field {
        true -> check_sibling(&main.console, sibling, element, stored)
        _ -> failed(&main.console, 71)
    }

    state check_sibling(console: &Binding<Console>, sibling: bool, element: bool, stored: bool) {
        transition sibling {
            true -> failed(console, 72)
            _ -> check_element(console, element, stored)
        }
    }

    state check_element(console: &Binding<Console>, element: bool, stored: bool) {
        transition element {
            true -> check_stored(console, stored)
            _ -> failed(console, 73)
        }
    }

    state check_stored(console: &Binding<Console>, stored: bool) {
        transition stored {
            true -> done(console)
            _ -> failed(console, 74)
        }
    }

    state done(console: &Binding<Console>) { Console::exit_process(console, 70); }

    state failed(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
