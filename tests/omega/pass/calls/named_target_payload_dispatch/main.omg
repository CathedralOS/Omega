// Named-target arm-bound payload dispatch: `transition wrap` binds the case
// payload `list` and forwards it as the structural argument of the named
// state's block parameter. The argument roster registers it and the machine
// verifies end-to-end (the documented `UnknownStructuralArgument` on this
// shape is dead). Companion wall pin: nested_call_tail_roots_exit.

use omega_language_std::console;

data ItemList {
    items: [u64; 4];
    count: u64;
}

machine ItemList::get_count(item_list: &ItemList) -> u64 {
    item_list.count
}

data Wrap {
    case Has(list: ItemList);
    case Empty;
}

machine Wrap::get_count(wrap: &Wrap) -> u64 {
    transition wrap {
        Wrap::Has { list } -> at(list)
        _ -> (0)
    }
    state at(list: &ItemList) -> u64 {
        ItemList::get_count(list)
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    transition {
        _ -> done(main)
    }
    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}
