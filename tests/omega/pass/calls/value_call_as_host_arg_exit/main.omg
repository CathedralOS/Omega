// A nested authored value call in host-call argument position executes before
// the boundary operation and marshals directly from its call-result slot.
use omega_language_std::console;

machine dbl(x: i32 in Wrapping) -> i32 {
    let r: i32 in Wrapping = x * 2;
    transition { _ -> (r as i32) }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(dbl(35));
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
