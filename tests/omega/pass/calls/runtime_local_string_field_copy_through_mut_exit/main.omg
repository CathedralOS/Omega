// Regression: copying a `let` local struct's bounded text field out through a
// mutable carrier parameter must reach the caller. The local-field write was
// mis-lowered as a machine-storage write at the frame slot's numeric offset
// (aliasing the machine-storage region base), so the pointee stayed empty.
// Fixed by honoring the resolved storage region (frame vs machine) in the
// string-descriptor write selection.

use omega_language_std::console;

domain [u8]::Utf8
requires
    valid_utf8(self);

domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data Holder {
    stored: [u8; 32] in Utf8;
}

data Main {
    console: Console;
    line: [u8; 32] in Utf8;
}

machine Main::main(&mut self) {
    self.set_from_local_field(&mut self.line);
    self.console.write_line(self.line);

    transition self.line == "FROM_LOCAL_FIELD" {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::set_from_local_field(&mut self, out_line: &mut [u8; 32] in Utf8) {
    let local: Holder;
    local.stored = "FROM_LOCAL_FIELD";
    out_line = local.stored;
}
