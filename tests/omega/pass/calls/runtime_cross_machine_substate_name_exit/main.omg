// Two machines each have a sub-state named `try1`: Picker::pick and Main::read_at. A NAMED
// transition target (`try1(idx)`) must resolve to a SIBLING state of the CURRENT machine, not
// collide on the shared name and run the OTHER machine's body. So after `self.picker.pick(2)`
// (whose `try1` returns a literal) runs, `self.read_at(4)` must still dispatch through read_at's
// OWN `try1`/`try2`/`try3` to return `self.table[4]` -- not pick's `try1` literal.
//
// pick(2) = 4 (key 2 != 0,1 -> pick's try1 `_` arm yields 4); read_at(4) = table[4] = 60. The
// check discriminates: the bug returned 4 (pick's literal) for read_at, so v != 60. Exit 70.
use omega_language_std::console;

data Picker {}

data Main {
    console: Console;
    table: [i32; 5];
    picker: Picker;
}

machine Picker::pick(&mut self, key: i32) -> i32 {
    transition key == 0 {
        true -> (0)
        _ -> try1(key)
    }
    state try1(&mut self, key: i32) {
        transition key == 1 {
            true -> (2)
            _ -> (4)
        }
    }
}

machine Main::read_at(&mut self, idx: i32) -> i32 {
    transition idx == 0 {
        true -> (self.table[0])
        _ -> try1(idx)
    }
    state try1(&mut self, idx: i32) {
        transition idx == 1 {
            true -> (self.table[1])
            _ -> try2(idx)
        }
    }
    state try2(&mut self, idx: i32) {
        transition idx == 2 {
            true -> (self.table[2])
            _ -> try3(idx)
        }
    }
    state try3(&mut self, idx: i32) {
        transition idx == 3 {
            true -> (self.table[3])
            _ -> (self.table[4])
        }
    }
}

machine Main::main(&mut self) {
    self.table[0] = 3;
    self.table[1] = 7;
    self.table[2] = 14;
    self.table[3] = 30;
    self.table[4] = 60;

    let i: i32 = self.picker.pick(2);
    let v: i32 = self.read_at(4);

    transition v == 60 && i == 4 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(v); // surface read_at's wrong value (the bug returned 4)
    }
}
