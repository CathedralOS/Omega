// Two machines each have a sub-state named `try1`: Picker::pick and Main::read_at. A NAMED
// transition target (`try1(idx)`) must resolve to a SIBLING state of the CURRENT machine, not
// collide on the shared name and run the OTHER machine's body. So after `Picker::pick(2)`
// (whose `try1` returns a literal) runs, `Main::read_at(main, 4)` must still dispatch through read_at's
// OWN `try1`/`try2`/`try3` to return `main.table[4]` -- not pick's `try1` literal.
//
// pick(2) = 4 (key 2 != 0,1 -> pick's try1 `_` arm yields 4); read_at(4) = table[4] = 60. The
// check discriminates: the bug returned 4 (pick's literal) for read_at, so v != 60. Exit 70.
use omega_language_std::console;

data Picker {}

data Main {
    table: [i32; 5];
    picker: Picker;
}

machine Picker::pick(key: i32) -> i32 {
    transition key == 0 {
        true -> (0)
        _ -> try1(key)
    }
    state try1(key: i32) {
        transition key == 1 {
            true -> (2)
            _ -> (4)
        }
    }
}

machine Main::read_at(main: &mut Main, idx: i32) -> i32 {
    transition idx == 0 {
        true -> (main.table[0])
        _ -> try1(main, idx)
    }
    state try1(main: &mut Main, idx: i32) {
        transition idx == 1 {
            true -> (main.table[1])
            _ -> try2(main, idx)
        }
    }
    state try2(main: &mut Main, idx: i32) {
        transition idx == 2 {
            true -> (main.table[2])
            _ -> try3(main, idx)
        }
    }
    state try3(main: &mut Main, idx: i32) {
        transition idx == 3 {
            true -> (main.table[3])
            _ -> (main.table[4])
        }
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.table[0] = 3;
    main.table[1] = 7;
    main.table[2] = 14;
    main.table[3] = 30;
    main.table[4] = 60;

    let i: i32 = Picker::pick(2);
    let v: i32 = Main::read_at(main, 4);

    transition v == 60 && i == 4 {
        true -> good(main)
        _ -> bad(main, v)
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad(main: &mut Main, v: i32) {
        Console::exit_process(v); // surface read_at's wrong value (the bug returned 4)
    }
}
