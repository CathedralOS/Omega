use omega_language_std::console;

data Cell {
    value: i32;
    tag: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    bag: Bag;
}

machine Main::main(main: &mut Main) reaches Console {
    Main::fill(&mut main.bag);

    transition main.bag.cells[2].value == 7 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(181);
    }

    state bad(main: &mut Main) {
        Console::exit_process(182);
    }
}

machine Main::fill(bag: &mut Bag) {
    let cell: &mut Cell = Main::pick(bag);
    cell.value = 7;
    cell.tag = 9;
}

machine Main::pick(bag: &mut Bag) -> &mut Cell {
    let cells: &mut [Cell] = &mut bag.cells[..];
    transition {
        _ -> &mut cells[2]
    }
}
