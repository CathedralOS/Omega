data Node { value: u64; }
machine choose(node: &mut Node, take: bool) -> &mut Node crashes Trap {
    transition take { true -> (node) }
    crash Trap;
}
machine identity(node: &mut Node) -> &mut Node { node }
machine call_result(node: &mut Node, take: bool) -> &mut Node crashes Trap {
    transition take { true -> identity(node) }
    crash Trap;
}
machine scalar_result(take: bool) -> u64 crashes Trap {
    transition take { true -> (70) }
    crash Trap;
}
machine normal() {}
machine unit_result(take: bool) crashes Trap {
    transition take { true -> normal() }
    crash Trap;
}
machine main() crashes Trap {
    let mut node: Node = Node { value: 70 };
    let result: &mut Node = choose(&mut node, true);
    let first_value: u64 = result.value;
    let from_call: &mut Node = call_result(&mut node, true);
    let call_value: u64 = from_call.value;
    let scalar: u64 = scalar_result(true);
    unit_result(true);
    transition first_value == 70 && call_value == 70 && scalar == 70 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
