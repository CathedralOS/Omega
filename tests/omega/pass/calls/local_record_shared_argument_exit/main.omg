// A static machine lends its local record `&mut` to a writer and then `&` to
// a scalar-returning reader. The record's wrapping field domain rides both
// loans; the shared loan observes the value the exclusive one wrote, and the
// local keeps its storage throughout. Exits 70 only when the reader saw the
// writer's update through the caller's own local.

use omega_language_std::console;

data Score { points: i32 in Wrapping; }

machine Score::bump(score: &mut Score, by: i32 in Wrapping) {
    score.points = score.points + by;
}

machine Score::read(score: &Score) -> i32 {
    transition { _ -> (score.points as i32) }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut score: Score;
    Score::bump(&mut score, 70);
    let seen: i32 = Score::read(&score);
    Console::exit_process(seen);
}
