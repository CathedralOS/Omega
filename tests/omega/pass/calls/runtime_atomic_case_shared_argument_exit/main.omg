// A completed scalar word initializes an owned atomic payload cell, not a
// packed snapshot. The case returned by make must survive a shared call.
// This pins formation and transport; payload reads still require atomic access.
data Choice { case Cell(counter: AtomicU32); case Empty; }

machine make() -> Choice { Choice::Cell { counter: 3 } }
machine inspect(choice: &Choice) -> bool {
    transition choice {
        Choice::Cell { counter } -> (true)
        _ -> (false)
    }
}

machine main() crashes Trap {
    let choice: Choice = make();
    let observed: bool = inspect(&choice);
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
