// A LOCAL whose address escapes into a sibling-state transition (`&mut random`)
// must keep its frame storage while the sibling runs. The sibling's guard is a
// value call whose inlined callee chain (should_carve -> chance -> range ->
// next_u32) allocates guard call-results and chain locals; if the frame stacker
// overlays sibling states within one call context, those land INSIDE the
// still-referenced RandomState, and next_u32's write through `&mut state` at
// pointee offset 0 clobbers the first arm's guard result byte. Both arm compares
// then fail and the dispatch silently falls through to the continuation, skipping
// hall_two -- the dungeon "generation stalls after the first should_carve" bug.
// The unused pass-through `seed: u64` shifts the layout so the overlap hits the
// result byte (mirrors MazeBuilder::build's signature).
//
// Expected: build runs hall_two, room_count == 8 -> exit 70.
use omega_language_std::console;

data RandomState {
    seed: u64;
    calls: u64;
}

data Random {
}

machine Random::next_u32(
    random: &mut Random,
    state: &mut RandomState
    ) -> u32 {
    state.seed = ((state.seed as u64 in Wrapping) + 1) as u64;

    transition {
        _ -> 7
    }
}

machine Random::range(
    random: &mut Random,
    state: &mut RandomState,
    exclusive_max: u32
    ) -> u32
requires 1 <= exclusive_max
{
    let raw: u32 = Random::next_u32(random, state);

    transition {
        _ -> (raw % exclusive_max)
    }
}

machine Random::chance(
    random: &mut Random,
    state: &mut RandomState,
    numerator: u32,
    denominator: u32
    ) -> bool
requires 1 <= denominator
{
    let roll: u32 = Random::range(random, state, denominator);

    transition {
        _ -> (roll < numerator)
    }
}

data Level {
    room_count: u64;
    deepest_depth: u32;
}

data MazeBuilder {
    rng: Random;
}

machine MazeBuilder::build(
    maze_builder: &mut MazeBuilder,
    seed: u64,
    level: &mut Level
) {
    let random: RandomState;

    level.room_count = 2;

    transition {
        _ -> maybe_side(maze_builder, level, &mut random)
    }


    state maybe_side(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        transition MazeBuilder::should_carve(maze_builder, random) {
            true -> hall_two(maze_builder, level, random)
            false -> hall_two(maze_builder, level, random)
        }
    }

    state hall_two(
        maze_builder: &mut MazeBuilder,
        level: &mut Level,
        random: &mut RandomState
    ) {
        level.room_count = 8;
    }
}

machine MazeBuilder::should_carve(
    maze_builder: &mut MazeBuilder,
    random: &mut RandomState
    ) -> bool {
    let rolled: bool = Random::chance(&mut maze_builder.rng, random, 50, 100);

    transition {
        _ -> rolled
    }
}

data Dungeon {
    maze: MazeBuilder;
    level: Level;
}

machine Dungeon::initialize(
    dungeon: &mut Dungeon,
    seed: u64
) {
    MazeBuilder::build(&mut dungeon.maze, seed, &mut dungeon.level);
}

data Main {
    dungeon: Dungeon;
}

machine Main::run(main: &mut Main) -> i32 {
    Dungeon::initialize(&mut main.dungeon, 7);

    transition {
        main.dungeon.level.room_count == 8 -> probe_correct(main)
        main.dungeon.level.room_count == 2 -> probe_stalled(main)
        _ -> probe_other(main)
    }

    state probe_correct(main: &mut Main) -> i32 { 70 }
    state probe_stalled(main: &mut Main) -> i32 { 2 }
    state probe_other(main: &mut Main) -> i32 { 77 }
}

machine Main::main(main: &mut Main) reaches Console {
    let result: i32 = Main::run(main);
    Console::exit_process(result);
}
