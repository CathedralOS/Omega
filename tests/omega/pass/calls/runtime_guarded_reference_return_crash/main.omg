data Node { value: u64; }
machine choose(node: &mut Node, take: bool) -> &mut Node crashes Trap {
    transition take { true -> (node) false -> failed() }
    machine failed() -> &mut Node { crash Trap; }
}
// A normal return must finish successfully, so only choose's authored crash
// can satisfy the trap oracle. A wrong returned value must not hide behind
// another trap in the caller.
machine main() crashes Trap {
    let mut node: Node = Node { value: 70 };
    let result: &mut Node = choose(&mut node, false);
}
