domain [u8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Banner {
    console: Console;
}

machine Banner::entry(&mut self) {
    self.console.write_line("nested");
}

data Main {
    banner: Banner;
    console: Console;
}

machine Main::main(&mut self) {
    self.banner.entry();
    self.console.write_line("continued");
    self.console.exit_process(0);
}
