domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Banner {
}

machine Banner::entry(banner: &mut Banner) reaches Console {
    Console::write_line("nested");
}

data Main {
    banner: Banner;
}

machine Main::main(main: &mut Main) reaches Console {
    Banner::entry(&mut main.banner);
    Console::write_line("continued");
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
