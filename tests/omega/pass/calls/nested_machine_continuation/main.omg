domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
use omega::language::core::service;

data Banner {
    console: Service<Console>;
}

machine Banner::entry(&mut self) reaches Console {
    self.console.write_line("nested");
}

data Main {
    banner: Banner;
    console: Service<Console>;
}

machine Main::main(&mut self) reaches Console {
    self.banner.entry();
    self.console.write_line("continued");
    self.console.exit_process(0);
}
