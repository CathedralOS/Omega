// Equal value-only call results retain ordinary denotational equality.
data Pair [copy] { first: i32; second: i32; }
data Main {}

machine identity(value: i32) -> i32 { value }

machine observe(value: Pair) -> bool
requires value.first == value.second {
    value.first == value.second
}

machine exercise(value: i32) crashes Trap {
    let same: bool = observe(Pair { first: identity(value), second: identity(value) });
    transition same { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

machine Main::main(main: &mut Main) crashes Trap { exercise(42); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
