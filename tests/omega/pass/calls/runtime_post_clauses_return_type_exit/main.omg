// V5: `-> u64` AFTER the terminates clause, non-recursive -- the parser
// used to silently DROP the return type (the machine parsed as void).
use omega::language::std::console;
data Main {
    console: Console;
}
machine Main::pick(&mut self, x: u64)
terminates;
-> u64
{
    transition x > 0 {
        true -> 5
        false -> 7
    }
}
machine Main::main(&mut self) {
    let value: u64 = self.pick(1);
    transition value == 5 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
