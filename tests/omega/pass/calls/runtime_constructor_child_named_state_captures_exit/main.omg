// Equal unknown child captures precede a later source mutation.
data Pair [copy] { first: i32; replaced: bool; second: i32; }
data Holder { amount: i32; }

machine Holder::replace(holder: &mut Holder, replacement: i32) -> bool {
    holder.amount = replacement;
    true
}

data Main {}

machine exercise(initial: i32, replacement: i32) crashes Trap {
    let mut holder: Holder = Holder { amount: initial };
    transition { _ -> selected(Pair {
        first: holder.amount,
        second: holder.amount,
        replaced: Holder::replace(&mut holder, replacement)
    }, initial) }

    machine selected(captured: Pair, wanted: i32)
    requires captured.first == captured.second {
        transition captured.first == wanted && captured.second == wanted && captured.replaced {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine Main::main(main: &mut Main) crashes Trap {
    exercise(42, 7);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
