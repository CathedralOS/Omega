// A call nested as another call's argument lowers through the scalar
// evaluation lane, which admits only callees whose contract asks nothing of
// the caller. An arithmetic policy on a parameter (`u64 in Wrapping`) governs
// the callee's own operations and is no such requirement, so a structural
// result built from policy parameters nests both in a `let` initializer and
// in a transition guard. Exits 70 when both nested calls observe 30 + 40.
use omega_language_std::console;

data Duo {
    case Left(a: u64 in Wrapping);
    case Right(b: u64 in Wrapping, c: u64 in Wrapping);
}

machine Duo::make(b: u64 in Wrapping, c: u64 in Wrapping) -> Duo {
    Duo::Right { b: b, c: c }
}

machine Duo::code(duo: Duo) -> u64 in Wrapping {
    transition duo {
        Duo::Left { a } -> value(a)
        Duo::Right { b, c } -> value(b + c)
    }

    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let total: u64 in Wrapping = Duo::code(Duo::make(30, 40));
    transition total == 70 {
        true -> guarded(main)
        _ -> done(main, 71)
    }

    machine guarded(main: &mut Main) {
        transition Duo::code(Duo::make(30, 40)) == 70 {
            true -> done(main, 70)
            _ -> done(main, 72)
        }
    }

    machine done(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
