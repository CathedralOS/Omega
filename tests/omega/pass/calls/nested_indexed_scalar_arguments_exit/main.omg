// An indexed call result is an ordinary scalar actual beside a shared loan.
use omega_language_std::console;

data Cell { value: u64 in Wrapping; }
data Main where position < 4 { cells: [Cell; 4]; position: u64; }

machine Cell::read(cell: &Cell) -> u64 in Wrapping { cell.value }
machine read_cell(cell: &Cell) -> u64 in Wrapping { cell.value }
machine combine(cell: &Cell, value: u64 in Wrapping) -> u64 in Wrapping {
    cell.value + value
}
machine Main::main(main: &mut Main) reaches Console {
    main.cells[0].value = 20;
    main.cells[2].value = 50;
    main.position = 2;
    let explicit: u64 in Wrapping = combine(&main.cells[0], read_cell(&main.cells[main.position]));
    let receiver: u64 in Wrapping = combine(&main.cells[0], Cell::read(&main.cells[main.position]));
    transition explicit == 70 && receiver == 70 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
