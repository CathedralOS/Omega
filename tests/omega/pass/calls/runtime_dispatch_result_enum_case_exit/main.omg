// RUN CANARY (exit 70) -- a dispatched value call whose TERMINAL constructs
// an ENUM CASE with a payload (`-> Verdict::Yes { score: acc }`), the shape
// EVERY wrapper result returns through. Served by the case-literal terminal
// return-write (edges.rs, 2026-07-09h): zero the slot (ZII), write the case
// tag, then each named field at its ABSOLUTE variant offset (static ints,
// bools, resolvable places incl. whole arrays; NESTED literals recurse;
// bare nullary cases tag-only). Unservable fields stay loud via the
// call-result blocker. Differential.
use omega_language_std::console;
data Verdict {
    case Nope;
    case Yes(score: i32 in Wrapping);
}
data Main { result: Verdict; }
machine Main::count(main: &mut Main, i: u64, j: u64, acc: i32 in Wrapping)
terminates by (j, i) -> Nat::BoundedDistance;
-> Verdict
{
    transition j < i {
        true -> count(main, i, j + 1, acc + 5)
        false -> leaf(acc)
    }
    // ENUM-case terminal with a payload from a param.
    state leaf(acc: i32 in Wrapping) -> Verdict { Verdict::Yes { score: acc } }
}
machine Main::main(main: &mut Main) reaches Console {
    main.result = Main::count(main, 3, 0, 0);
    transition main.result {
        Verdict::Yes { score } -> ck(main, score)
        Verdict::Nope -> bad(main, 71)
    }
    state ck(main: &mut Main, score: i32 in Wrapping) {
        transition score == 15 { true -> good(main) _ -> bad(main, 72) }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
