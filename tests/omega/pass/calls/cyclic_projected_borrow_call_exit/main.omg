// A projected unit call inside a control cycle:
// `holder.cells[position].copy_from(&source.cells[position])` passes one
// borrowed element per argument on every loop traversal. The terminal
// verifier admits the shape once three bookkeeping lookups line up:
// unrestricted subloans resolve an argument's root through block
// parameters (the state-parameter rebinding channel) as well as machine
// parameters, the block-parameter argument arm replays the selector's
// published bound for runtime-indexed borrow paths, and a cyclic block's
// unit-call eligibility treats an unrestricted subloan as the transient
// per-traversal loan it is.

use omega_language_std::console;

data Cell {
    value: u64;
}

machine Cell::copy_from(cell: &mut Cell, source: &Cell) {
    cell.value = source.value;
}

data Holder {
    cells: [Cell; 4];
}

machine Holder::copy_all(holder: &mut Holder, source: &Holder) {
    transition { _ -> copy(holder, source, 0) }

    state copy(holder: &mut Holder, source: &Holder, position: u64) {
        transition position < 4 {
            true -> step(holder, source, position)
            false -> done(holder)
        }
    }

    state step(holder: &mut Holder, source: &Holder, position: u64) {
        Cell::copy_from(&mut holder.cells[position], &source.cells[position]);
        transition { _ -> copy(holder, source, position + 1) }
    }

    state done(holder: &mut Holder) { }
}

data Main {
    source: Holder;
    target: Holder;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.cells[0].value = 10;
    main.source.cells[1].value = 20;
    main.source.cells[2].value = 30;
    main.source.cells[3].value = 40;

    Holder::copy_all(&mut main.target, &main.source);

    transition main.target.cells[2].value == 30 {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
