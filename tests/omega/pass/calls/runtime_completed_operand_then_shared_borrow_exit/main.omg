data Counter { trace:u32 in Wrapping; calls:u32 in Wrapping; }
machine mark(counter:&mut Counter,digit:u32 in Wrapping)->u32 in Wrapping {
 counter.trace=counter.trace*10+digit;
 counter.calls=counter.calls+1;
 digit
}
machine join(left:u32 in Wrapping,right:u32 in Wrapping)->u32 in Wrapping {left*10+right}
machine keep(value:u32 in Wrapping)->u32 in Wrapping {value}
machine observe(value:u32 in Wrapping,counter:&Counter)->u32 in Wrapping {value*10+counter.trace}
machine main() crashes Trap {
 let mut counter:Counter=Counter{trace:0,calls:0};
 let observed:u32 in Wrapping=observe(mark(&mut counter,4),&counter);
 transition observed==44 && counter.trace==4 && counter.calls==1 {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
