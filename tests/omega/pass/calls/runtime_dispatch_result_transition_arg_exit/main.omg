// RUN CANARY (exit 70) -- a dispatched value call's result consumed DIRECTLY
// as a TRANSITION ARGUMENT (`true -> check(self.count(3, 0, 0))`). Was a live
// unfenced silent-wrong (native 71: the callee ran on ZII arguments and the
// result slot mismatched); fixed across three connected gaps (2026-07-09,
// open-work #7 matrix):
//  1. clone terminals stamp CallResultReturn from the plan's ROLE
//     (RuntimeStateCallEdge.is_value -- the old operation-sniffing heuristic
//     missed transition-embedded calls);
//  2. the terminal return-write keys its slot on the RETURN-TARGET dispatch
//     case (state_call_result_slot_for_dispatch), agreeing with the reader;
//  3. statement_call_arguments descends into TRANSITION target-argument /
//     guard expressions, so the dispatched callee's params materialize (the
//     backend_report diff showed the direct spelling initialized NOTHING
//     while the let-bound twin wrote 3/0/0).
// Differential.
use omega_language_std::console;
data Main { console: Console; }
machine Main::count(&mut self, i: u64, j: u64, acc: i32 in Wrapping)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32 in Wrapping
{
    transition j < i {
        true -> count(i, j + 1, acc + 4)
        false -> leaf(acc)
    }
    state leaf(&mut self, acc: i32 in Wrapping) -> i32 in Wrapping { acc }
}
machine Main::main(&mut self) {
    // The dispatched call's result rides a TRANSITION ARGUMENT into check().
    transition true { true -> check(self.count(3, 0, 0)) _ -> bad() }
    state check(&mut self, n: i32 in Wrapping) {
        transition n == 12 { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
