// Target::initialize reads a [copy] record out of a nested field of an
// explicitly borrowed context and passes it to a by-value parameter. The callee
// must observe the copied value and the caller's source must be left
// unchanged — a copy projection duplicates the place, it does not move it.
use omega_language_std::console;

data SourceId [copy] { value: u32 in Trapping; }
data Src { id: SourceId; length: u32 in Trapping; }
data Holder { source: Src; }
data Target { seen: u32 in Trapping; }

machine Target::initialize(target: &mut Target, id: SourceId, length: u64 in Trapping) {
    target.seen = id.value;
}

data Main { holder: Holder; target: Target; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> parse(main) }
    state parse(main: &mut Main) {
        main.holder.source.id.value = 7;
        main.holder.source.length = 3;
        Target::initialize(&mut main.target, main.holder.source.id,
            main.holder.source.length as u64 in Trapping
        );
        transition { _ -> done(main) }
    }
    state done(main: &mut Main) {
        transition main.target.seen == 7 {
            true -> source_ok(main)
            _ -> bad_seen(main)
        }
    }
    state source_ok(main: &mut Main) {
        transition main.holder.source.id.value == 7 {
            true -> pass(main)
            _ -> bad_source(main)
        }
    }
    state pass(main: &mut Main) {
        Console::exit_process(70);
    }
    state bad_seen(main: &mut Main) {
        Console::exit_process(71);
    }
    state bad_source(main: &mut Main) {
        Console::exit_process(72);
    }
}
