// Copy-projection call argument: `Target::initialize(&mut self.target, // self.holder.source.id, ...)` reads a `[copy]` record out of a nested field
// of a borrowed receiver and passes it to a by-value parameter. The callee
// must observe the copied value and the caller's source must be left
// unchanged — a copy projection duplicates the place, it does not move it.
use omega_language_std::console;
use omega::language::core::binding;

data SourceId [copy] { value: u32 in Trapping; }
data Src { id: SourceId; length: u32 in Trapping; }
data Holder { source: Src; }
data Target { seen: u32 in Trapping; }

machine Target::initialize(target: &mut Target, id: SourceId, length: u64 in Trapping) {
    target.seen = id.value;
}

data Main { console: Binding<Console>; holder: Holder; target: Target; }
machine Main::main(&mut self) reaches Console {
    transition { _ -> parse() }
    state parse(&mut self) {
        self.holder.source.id.value = 7;
        self.holder.source.length = 3;
        Target::initialize(&mut self.target, self.holder.source.id,
            self.holder.source.length as u64 in Trapping
        );
        transition { _ -> done() }
    }
    state done(&mut self) {
        transition self.target.seen == 7 {
            true -> source_ok()
            _ -> bad_seen()
        }
    }
    state source_ok(&mut self) {
        transition self.holder.source.id.value == 7 {
            true -> pass()
            _ -> bad_source()
        }
    }
    state pass(&mut self) {
        self.console.exit_process(70);
    }
    state bad_seen(&mut self) {
        self.console.exit_process(71);
    }
    state bad_source(&mut self) {
        self.console.exit_process(72);
    }
}
