// A transition's guard SUBJECT evaluates exactly ONCE per transition evaluation.
// The parser lowers `transition Main::roll(x) { true -> a false -> b }` into one
// guard per arm, each holding a copy of the subject call; the backend must run
// the callee a single time and let every arm's comparison reuse that result
// (native: one branch prelude, per-arm value-selection leafs; interpreter:
// per-frame guard-call memo). The callee counts its invocations through a
// `&mut Tally`, returns FALSE so the SECOND arm is the one taken (the reuse
// path), and the probe ladder asserts exactly one increment.
//
// Regression shapes this pins:
// - callee body spliced into the caller AND emitted via the branch prelude
//   (double execution per evaluation),
// - one eager evaluation PER ARM (double execution for a two-arm subject).
use omega_language_std::console;

data Tally {
    calls: u64;
    pad: u64;
}

data Main {
    tally: Tally;
}

machine Main::roll(
    tally: &mut Tally
    ) -> bool {
    tally.calls = ((tally.calls as u64 in Wrapping) + 1) as u64;

    transition {
        _ -> false
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.tally.calls = 40;
    main.tally.pad = 0;

    transition {
        _ -> decide(main)
    }


    state decide(main: &mut Main) {
        transition Main::roll(&mut main.tally) {
            true -> report(main)
            false -> report(main)
        }
    }

    state report(main: &mut Main) {
        transition {
            main.tally.calls == 40 -> exit_never_ran(main)
            main.tally.calls == 41 -> exit_once(main)
            main.tally.calls == 42 -> exit_twice(main)
            _ -> exit_other(main)
        }
    }

    state exit_never_ran(main: &mut Main) { Console::exit_process(10); }
    state exit_once(main: &mut Main) { Console::exit_process(70); }
    state exit_twice(main: &mut Main) { Console::exit_process(2); }
    state exit_other(main: &mut Main) { Console::exit_process(77); }
}
