data Pair [copy] { first: i32; second: i32; replaced: bool; }
data Holder { amount: i32; }

machine replace(holder: &mut Holder, replacement: i32) -> bool {
    holder.amount = replacement;
    true
}

machine observe(value: Pair, expected: i32)
requires value.first == value.second
crashes Trap {
    transition value.replaced && value.first == expected && value.second == expected {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine exercise(initial: i32, replacement: i32) crashes Trap {
    let mut holder: Holder = Holder { amount: initial };
    let saved: Pair = Pair {
        first: holder.amount,
        second: holder.amount,
        replaced: replace(&mut holder, replacement),
    };
    observe(saved, initial);
}

machine main() crashes Trap { exercise(41, 9); }
