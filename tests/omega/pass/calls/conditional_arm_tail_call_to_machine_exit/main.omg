// A terminal machine call directly in a guarded transition arm completes the
// caller with that call; the untaken arm's call must not run
// (wiki/spec/language/state_contracts.md, "Terminal calls in transition
// arms"). `main` checks a stored value and takes `true -> self.finish()`,
// which exits 70; the `false` arm tail-calls `self.wrong()`, which exits 71.
// `calls/transition_tail_call_to_machine` covers tail calls in unconditional
// arms.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    stored: i32;
}

machine Main::main(&mut self) reaches Console {
    self.stored = 5;
    transition self.stored == 5 {
        true -> self.finish()
        false -> self.wrong()
    }
}

machine Main::finish(&mut self) reaches Console {
    self.console.exit_process(70);
}

machine Main::wrong(&mut self) reaches Console {
    self.console.exit_process(71);
}
