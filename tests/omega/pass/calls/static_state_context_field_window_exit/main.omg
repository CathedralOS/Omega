use omega_language_std::math;

// A static entry forwards its lent `context: &mut Main` into a state, and the
// state lends fixed-array fields of that context as borrowed views. Across
// the edge `context` carries the record's address, not a copy, so each view
// presents a window of the entry's own storage. The same `pause: [u8; 4]`
// backing passes as `&mut [u8]` to a Unit-result writer, as `&[u8]` to a
// scalar-result reader and as `&mut [u8]` to the structural-result Console
// reader; `values: [i32; 3]` passes as `&[i32]` to a scalar-result reader.
// `input.txt` supplies the line.
//
//   entry: values[1] = 11
//   lend:  stamp  -> pause[1] = 5, seen = 5
//          read_line("ab\n") -> pause = "ab\n", count 3
//          first = 97, second = 98, largest(values) = 11
//
// Exits 70 only when every loan observed and updated the context's storage.

use omega_language_std::console;

data Main {
    pause: [u8; 4];
    values: [i32; 3];
}

machine stamp(bytes: &mut [u8]) {
    transition bytes.len > 1 {
        true -> write(bytes)
        _ -> skip()
    }

    state write(bytes: &mut [u8]) {
        bytes[1] = 5;
    }

    state skip() { }
}

machine peek(bytes: &[u8], position: u64) -> u64 {
    transition position < bytes.len {
        true -> read(bytes, position)
        _ -> (0)
    }

    state read(bytes: &[u8], position: u64) -> u64 {
        let value: u8 = bytes[position];
        transition { _ -> (value as u64) }
    }
}

machine largest(values: &[i32], current: i32) -> i32 {
    transition values.len > 0 {
        true -> largest(values[1..], max_i32(current, values[0]))
        false -> (current)
    }
}

machine Main::main(context: &mut Main) reaches Console {
    context.values[1] = 11;
    transition { _ -> lend(context) }

    state lend(context: &mut Main) {
        stamp(&mut context.pause);
        let seen: u64 = peek(&context.pause, 1);
        let line: LineReadResult = block Console::read_line(&mut context.pause);
        let first: u64 = peek(&context.pause, 0);
        let second: u64 = peek(&context.pause, 1);
        let high: i32 = largest(&context.values, 0);
        transition line {
            LineReadResult::LineComplete { count } -> check(context, seen, count, first, second, high)
            _ -> refused(context, 71)
        }
    }

    state check(context: &mut Main, seen: u64, count: u64, first: u64, second: u64, high: i32) {
        transition seen == 5 && count == 3 && first == 97 && second == 98 && high == 11 {
            true -> done(context)
            _ -> refused(context, 72)
        }
    }

    state done(context: &mut Main) {
        Console::exit_process(70);
    }

    state refused(context: &mut Main, code: i32) {
        Console::exit_process(code);
    }
}
