// `let v = Main::next(&mut state)` where the callee mutates the state and
// returns the NEW value must deliver the POST-mutation value (interpreter
// semantics). Pre-fix the native backend emitted the call-result value
// selection at the StateCall body operation, BEFORE the splice's flattened
// mutation ops, so `v` carried the PRE-mutation value (native exit 2,
// interpreter 70); the selection is now deferred to the statement's
// LocalStorage operation, after the callee's effects.
use omega_language_std::console;
use omega::language::core::numeric_conversion;

data Tally {
    calls: u64;
    pad: u64;
}

data Main {
    tally: Tally;
}

machine Main::next(
    tally: &mut Tally
    ) -> u32 {
    tally.calls = ((tally.calls as u64 in Wrapping) + 1) as u64;

    transition {
        _ -> (narrow_u64_to_u32_trapping(tally.calls))
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.tally.calls = 40;
    main.tally.pad = 0;
    let v: u32 = Main::next(&mut main.tally);

    transition {
        v == 41 -> exit_post(main)
        v == 40 -> exit_stale(main)
        _ -> exit_other(main)
    }


    state exit_post(main: &mut Main) { Console::exit_process(70); }
    state exit_stale(main: &mut Main) { Console::exit_process(2); }
    state exit_other(main: &mut Main) { Console::exit_process(77); }
}
