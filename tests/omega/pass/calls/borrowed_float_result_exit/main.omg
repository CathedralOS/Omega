use omega::language::core::float_operations;
use omega_language_std::console;

data Main { }

machine echo(value: f32, scratch: &mut f32) -> f32 { value }

machine Main::main(main: &mut Main) reaches Console {
    let mut scratch: f32 = 3.0f32;
    let result: f32 = echo(2.5f32, &mut scratch);
    let outcome: i32 = match result { 2.5f32 -> 70, _ -> 71 };
    Console::exit_process(outcome);
}
