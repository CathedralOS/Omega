use omega_language_std::console;

data Room {
    exit_count: u32;
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let rooms: [Room; 1] = [Room { exit_count: 0 }];
    let from_index: u64 = 0;

    bump(&mut rooms[from_index]);

    transition from_index == 0 {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(171);
    }

    state bad(main: &mut Main) {
        Console::exit_process(172);
    }
}

machine bump(room: &mut Room) {
    room.exit_count = 1;
}
