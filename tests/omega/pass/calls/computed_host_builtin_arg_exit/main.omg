// Scalar builtins are pure value operations, so a direct host-boundary
// argument can materialize through the same scratch writer as binary values.
use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Service<Console>;
    low: i32;
    high: i32;
}

machine Main::main(&mut self) reaches Console {
    self.low = 7;
    self.high = 70;
    self.console.exit_process(max(self.low, self.high));
}
