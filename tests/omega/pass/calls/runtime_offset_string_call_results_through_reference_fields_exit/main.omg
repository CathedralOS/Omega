domain [u8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;

data CellId {
    case C0;
    case C1;
    case C2;
}

data Cell {
    cell: CellId;
    depth: u32;
    branch: u32;
    label: &[u8] in Utf8;
    description: &[u8] in Utf8;
}

data Bag {
    cells: [Cell; 3];
}

data Main {
    console: Console;
    bag: Bag;
}

machine Main::main(&mut self) {
    self.fill(&mut self.bag, CellId::C0);

    transition {
        self.bag.cells[0].label == "Gate" && self.bag.cells[0].description == "Deep room" -> render()
        _ -> bad()
    }

    state render(&mut self) {
        let line: &[u8] in Utf8 = "== " + self.bag.cells[0].label + " ==";

        transition line == "== Gate ==" {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(196);
    }

    state bad(&mut self) {
        self.console.exit_process(197);
    }
}

machine Main::fill(&mut self, bag: &mut Bag, cell_id: CellId) {
    let cell: &mut Cell = self.pick(bag, cell_id);
    cell.cell = cell_id;
    cell.depth = 9;
    cell.branch = 0;
    cell.label = identity_text("Gate");
    cell.description = identity_text("Deep room");
}

machine Main::pick(&mut self, bag: &mut Bag, cell_id: CellId) -> &mut Cell {
    let cells: &mut [Cell] = bag.cells.as_mut_slice();

    transition cell_id {
        CellId::C0 -> &mut cells[0]
        CellId::C1 -> &mut cells[1]
        _ -> &mut cells[2]
    }
}

machine identity_text<'text>(text: &'text [u8] in Utf8) -> &'text [u8] in Utf8 {
    transition {
        _ -> text
    }
}
