// The empty affine local is consumed only on the selected true arm. The
// other arm owes its no-code disposal, without running the consumer.
data Token {}

machine consume(token: Token, count: &mut u64) -> bool {
    count = ((count as u64 in Wrapping) + 1) as u64;
    true
}

machine choose(selected: bool, count: &mut u64) -> bool {
    let token: Token = Token {};
    transition selected {
        true -> consume(token, count)
        false -> false
    }
}

machine main() crashes Trap {
    let mut count: u64 = 0;
    let skipped: bool = choose(false, &mut count);
    let consumed: bool = choose(true, &mut count);
    transition skipped == false && consumed && count == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
