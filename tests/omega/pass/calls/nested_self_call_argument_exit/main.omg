// Byte-sequence subslice argument on a self-receiver call:
// `Sink::probe(&main.sink, bytes[..])` — probe is a `&self` method whose whole-view
// slice argument lowers as a byte-sequence subslice, so the call's arguments
// walk the nested argument schedule. The exact-positional gate must
// materialize the implicit receiver as a positional argument instead of
// declining ("no exact positional signature").
//
// Mirrors mini-probe's `Reader::read_bytes(&main.reader, &main.info, 0, &mut main.buf)`
// receiver calls carrying byte-view arguments.

use omega_language_std::console;
use omega::language::core::binding;

data Sink {
    filled: u64;
}

machine Sink::probe(sink: &Sink, bytes: &[u8]) {
    transition bytes.len == 8 {
        true -> empty(sink)
        _ -> empty(sink)
    }

    state empty(sink: &Sink) {}
}

data Main {
    console: Binding<Console>;
    sink: Sink;
    buf: [u8; 8];
}

machine Main::emit(main: &Main, bytes: &[u8]) {
    Sink::probe(&main.sink, bytes[..]);
}

machine Main::main(main: &mut Main) reaches Console {
    main.sink = Sink { filled: 0 };
    main.buf[0] = 9;
    Main::emit(main, &main.buf);

    transition main.buf[0] == 9 {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}
