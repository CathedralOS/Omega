// A case payload loan keeps its original storage through two named states
// and a runtime-selected ordinary call argument.
use omega_language_std::console;

data Cell { value: u64 in Wrapping; }
data Cells { values: [Cell; 4]; }
data Choice { case Full(cells: Cells); case Empty; }
data Main { }

machine Cell::read(cell: &Cell) -> u64 in Wrapping { cell.value }
machine read_cell(cell: &Cell) -> u64 in Wrapping { cell.value }

machine Choice::probe(choice: &Choice, position: u64) -> bool {
    transition choice {
        Choice::Full { cells } -> select(cells, position)
        _ -> (false)
    }
    state select(cells: &Cells, position: u64) -> bool {
        transition position < 4 {
            true -> read(cells, position)
            false -> (false)
        }
    }
    state read(cells: &Cells, position: u64) -> bool {
        let receiver: u64 in Wrapping = Cell::read(&cells.values[position]) + 1;
        let argument: u64 in Wrapping = read_cell(&cells.values[position]) + 1;
        receiver == 70 && argument == 70
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let full: Choice = Choice::Full { cells: Cells {
        values: [Cell { value: 3 }, Cell { value: 4 }, Cell { value: 69 }, Cell { value: 6 }]
    } };
    let empty: Choice = Choice::Empty;
    let selected: bool = Choice::probe(&full, 2);
    let other: bool = Choice::probe(&full, 1);
    let outside: bool = Choice::probe(&full, 4);
    let absent: bool = Choice::probe(&empty, 2);
    transition selected && !other && !outside && !absent {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
