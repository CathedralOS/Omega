// Value calls as internal transition arguments, observed through the
// delivered values and through an effect that depends on call order.
// Reduced from `samples/cli/systems/vending_machine`, whose spelling is
// `transition main.a == 35 { true -> report(main.make_change(100, 55), 17) }`.
//
// `amount()` is a free machine whose own state graph returns 1 (its range
// contract admits the `+ 1` below): the direct
// argument delivers it to `handle`, a local-binding control delivers the same
// value, and an arithmetic control delivers `amount() + 1`. `record` appends
// its digit to `trace` (trace * 10 + digit) and returns the digit, so two
// calls in one argument list deliver 1 and 2 to their own parameters and
// leave `trace` at 12 only when they run left to right; right to left would
// leave 21. A later argument's effect must not reach an earlier argument
// that already read the same storage: `snapshot(main.trace, main.record(3))`
// delivers 12 then 3 and leaves `trace` at 123. Exit 70 means every value
// arrived in order.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    trace: u32 in Wrapping;
}

machine amount() -> i32
ensures 0 <= result && result <= 1
{
    transition { _ -> out() }
    state out() -> i32 { 1 }
}

machine Main::record(main: &mut Main, digit: u32) -> u32
requires digit <= 9
ensures result <= 9
{
    main.trace = main.trace * 10 + (digit as u32 in Wrapping);
    digit
}

machine Main::main(main: &mut Main) reaches Console {
    main.trace = 0;
    transition { _ -> handle(main, amount()) }

    state handle(main: &mut Main, delivered: i32) {
        transition delivered == 1 {
            true -> bind_local(main)
            false -> bad(main, 71)
        }
    }

    state bind_local(main: &mut Main) {
        let bound: i32 = amount();
        transition { _ -> handle_local(main, bound) }
    }

    state handle_local(main: &mut Main, delivered: i32) {
        transition delivered == 1 {
            true -> take_arithmetic(main)
            false -> bad(main, 72)
        }
    }

    state take_arithmetic(main: &mut Main) {
        transition { _ -> handle_arithmetic(main, amount() + 1) }
    }

    state handle_arithmetic(main: &mut Main, delivered: i32) {
        transition delivered == 2 {
            true -> take_ordered(main)
            false -> bad(main, 73)
        }
    }

    state take_ordered(main: &mut Main) {
        transition true {
            true -> ordered(main, Main::record(main, 1), Main::record(main, 2))
            false -> bad(main, 74)
        }
    }

    state ordered(main: &mut Main, first: u32, second: u32) {
        transition first == 1 && second == 2 && main.trace == 12 {
            true -> take_snapshot(main)
            false -> bad(main, 75)
        }
    }

    state take_snapshot(main: &mut Main) {
        transition { _ -> snapshot(main, main.trace, Main::record(main, 3)) }
    }

    state snapshot(main: &mut Main, before: u32 in Wrapping, digit: u32) {
        transition before == 12 && digit == 3 && main.trace == 123 {
            true -> good(main)
            false -> bad(main, 76)
        }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
