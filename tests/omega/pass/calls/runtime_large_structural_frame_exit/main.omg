// Preserve both ends of a large local across a by-value call, then carry
// its observed result through a separate record factory and borrowed call.
use omega_language_std::console;

data Buffer { values: [i32; 8192]; marker: i32; }
data Ticket { code: i32; }
machine ticket(code: i32) -> Ticket { Ticket { code: code } }
machine read(ticket: &Ticket) -> i32 { ticket.code }

machine inspect(values: [i32; 8192], marker: i32) -> i32 {
    transition values[0] == 11 && values[8191] == 13
        && marker == 17 {
        true -> 70
        _ -> 71
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut buffer: Buffer;
    buffer.values[0] = 11;
    buffer.values[8191] = 13;
    buffer.marker = 17;
    let observed: i32 = inspect(buffer.values, buffer.marker);
    let result: Ticket = ticket(observed);
    let code: i32 = read(&result);
    Console::exit_process(code);
}
