use omega_language_std::console;

data Main { }

machine Main::measure(main: &Main, bytes: &[u8]) -> u64 reaches Console {
    Console::write_line(bytes);
    bytes.len
}

machine report(length: u64) -> u64 reaches Console {
    Console::write_byte(33);
    length
}

machine Main::main(main: &mut Main) reaches Console {
    let first: u64 = Main::measure(main, "abc");
    let second: u64 = Main::measure(main, "");
    let reported: u64 = report(first);
    transition reported == 3 {
        true -> check_empty(main, second)
        false -> failed(main)
    }
    state check_empty(main: &mut Main, length: u64) {
        transition length == 0 {
            true -> passed(main)
            false -> failed(main)
        }
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
