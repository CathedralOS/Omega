use omega::language::core::float_operations;
data Context { value: i32; }
machine from_i32(value: i32) -> i32 { value }
machine parameter(value: i32) -> bool {
    transition F64::from_i32(value) == 37.0 {
        true -> yes()
        false -> no()
    }
    state yes() -> bool { true }
    state no() -> bool { false }
}
machine main(context: &mut Context) crashes Trap {
    context.value = 37;
    let local: i32 = 37;
    let result: bool = parameter(local);
    transition F64::from_i32(context.value) == 37.0
        && F32::from_i32(local) == 37.0 && from_i32(37) == 37 && result {
        true -> other(local)
        false -> bad()
    }
    state other(value: i32) {
        transition F64::from_i32(from_i32(value)) == 37.0 { true -> done() false -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
