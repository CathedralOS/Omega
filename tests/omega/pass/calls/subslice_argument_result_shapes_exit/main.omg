// A call lends a subslice whatever its result binds. A Unit result binds
// nothing, a discarded or stored scalar binds a dense value, and a structural
// result binds a whole value; none of them changes how the subslice argument
// is lent. The arguments cover an inline subslice of a fixed array (local or
// parameter), an inline subslice of a view parameter, local subslice bindings
// of a view, and a whole view. Scalar-result calls over the same storage run
// between the Unit calls, so a skipped or misplaced write shows up in a later
// read.
data Pair { left: u8; right: u8; }
data Tally { old: u8; pair: Pair; }

machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine fill(view: &mut [u8], value: u8)
requires view.len >= 2
{
    view[0] = value;
    view[1] = value;
}

machine swap_out(view: &mut [u8], value: u8) -> u8
requires view.len >= 1
{
    let old: u8 = view[0];
    view[0] = value;
    old
}

machine peek(view: &[u8], at: u64) -> u8
requires at < view.len
{
    view[at]
}

machine pair_of(view: &mut [u8], value: u8) -> Pair
requires view.len >= 2
{
    view[1] = value;
    Pair { left: view[0], right: view[1] }
}

// A fixed array parameter lends subslices of itself between scalar calls.
machine through_array(items: &mut [u8; 8]) -> u8 {
    zero(&mut items[2..4]);
    let old: u8 = swap_out(&mut items[4..6], 40);
    fill(&mut items[6..8], 7);
    let last: u8 = peek(&items[6..8], 1);
    transition old == 5 && last == 7 {
        true -> kept()
        _ -> lost()
    }
    machine kept() -> u8 { 5 }
    machine lost() -> u8 { 0 }
}

// A view parameter lends an inline subslice to a Unit call.
machine fill_head(view: &mut [u8])
requires view.len >= 8
{
    fill(&mut view[0..2], 11);
}

// A view parameter lends an inline subslice to a scalar call.
machine swap_tail(view: &mut [u8]) -> u8
requires view.len >= 8
{
    swap_out(&mut view[5..6], 17)
}

// A view parameter lends itself whole to a Unit call.
machine clear(view: &mut [u8])
requires view.len >= 1
{
    zero(view);
}

machine main() crashes Trap {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    zero(&mut items[1..3]);
    let first: u8 = peek(&items[0..2], 1);
    let old_array: u8 = through_array(&mut items);
    let mut bytes: [u8; 8] = [21, 22, 23, 24, 25, 26, 27, 28];
    let mut tally: Tally = Tally { old: 0, pair: Pair { left: 0, right: 0 } };
    let view: &mut [u8] = &mut bytes[..];
    let tail: &mut [u8] = &mut view[6..8];
    let middle: &mut [u8] = &mut view[2..4];
    fill(tail, 13);
    zero(middle);
    let old_middle: u8 = swap_out(middle, 33);
    _ = swap_out(middle, 34);
    tally.old = swap_out(middle, 35);
    let pair: Pair = pair_of(middle, 36);
    tally.pair = pair_of(tail, 14);
    fill_head(view);
    let old_tail: u8 = swap_tail(view);
    clear(view);
    zero(view);
    // items: zero[1..3] -> 1 0 0 4 5 6 7 8; through_array -> 1 0 0 4 40 6 7 7
    // bytes: tail -> 21 22 23 24 25 26 13 13; middle -> 0, 33, 34, 35, then
    //        [3] = 36; tail [7] = 14; fill_head -> 11 11 35 36 ...;
    //        swap_tail -> [5] = 17; clear -> 0 11 35 36 25 17 13 14
    transition first == 0 && old_array == 5 && old_middle == 0 && old_tail == 26
        && tally.old == 34 && pair.left == 35 && pair.right == 36
        && tally.pair.left == 13 && tally.pair.right == 14
        && items[0] == 1 && items[1] == 0 && items[2] == 0 && items[3] == 4
        && items[4] == 40 && items[5] == 6 && items[6] == 7 && items[7] == 7
        && bytes[0] == 0 && bytes[1] == 11 && bytes[2] == 35 && bytes[3] == 36
        && bytes[4] == 25 && bytes[5] == 17 && bytes[6] == 13 && bytes[7] == 14 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
