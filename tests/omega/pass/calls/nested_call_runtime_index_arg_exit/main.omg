// Runtime-index borrowed members as nested call arguments:
// `Item::clone(&list.items[i])` as a transition value target. The selector
// is walked the way the checker numbers it (collection direct, index
// separate), and the borrowed element reaches the callee's structural
// signature. `items[0]` holds 70, so probing index 0 exits 70; any other
// element exits 71.

use omega_language_std::console;

data Item {
    value: u64;
}

machine Item::clone(source: &Item) -> Item {
    Item { value: source.value }
}

data List {
    items: [Item; 4];
    enabled: bool;
}

machine List::probe(list: &List, i: u64) -> Item requires i <= 3 {
    transition list.enabled {
        true -> (Item::clone(&list.items[i]))
        _ -> (Item { value: 0 })
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let l: List = List {
        items: [Item { value: 70 }, Item { value: 1 }, Item { value: 2 }, Item { value: 3 }],
        enabled: true,
    };
    let cloned: Item = List::probe(&l, 0);

    transition cloned.value == 70 {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
