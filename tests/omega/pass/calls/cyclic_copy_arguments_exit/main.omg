// Unit and scalar calls consume the same copy payload in a cycle, whether
// the payload is constructed here or returned by another ordinary call.
use omega_language_std::console;

data Kind [copy] { case First; case Second; }
data Counter { observed: u64; total: u64 in Wrapping; }
data Main { counter: Counter; }

machine choose(position: u64) -> Kind {
    transition position < 2 { true -> Kind::First false -> Kind::Second }
}

machine observe(counter: &mut Counter, kind: Kind) {
    transition kind {
        Kind::First -> first(counter)
        Kind::Second -> second(counter)
    }
    state first(counter: &mut Counter) { counter.observed = 1; }
    state second(counter: &mut Counter) { counter.observed = 2; }
}

machine value(kind: Kind) -> u64 in Wrapping {
    transition kind { Kind::First -> 1 Kind::Second -> 2 }
}

machine Counter::count(counter: &mut Counter) {
    transition { _ -> scan(counter, 0) }
    state scan(counter: &mut Counter, position: u64) {
        transition position < 4 {
            true -> step(counter, position)
            false -> done()
        }
    }
    state step(counter: &mut Counter, position: u64) {
        observe(counter, Kind::First);
        counter.total = counter.total + value(Kind::First);
        let kind: Kind = choose(position);
        observe(counter, kind);
        counter.total = counter.total + value(kind);
        transition { _ -> scan(counter, position + 1) }
    }
    state done() {}
}

machine Main::main(main: &mut Main) reaches Console {
    Counter::count(&mut main.counter);
    transition main.counter.total == 10 && main.counter.observed == 2 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
