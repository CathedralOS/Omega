data Node { value: u64; }
data Pair { left: Node; right: Node; }
data Outer { anchor: u64; pair: Pair; }

machine pick(pair: &mut Pair, second: bool) -> &mut Node {
    transition second {
        true -> &mut pair.right
        false -> &mut pair.left
    }
}

machine relay(pair: &mut Pair, second: bool) -> &mut Node {
    let selected: &mut Node = pick(pair, second);
    selected
}

machine observe(pair: &mut Pair, second: bool) -> u64 {
    let selected: &mut Node = relay(pair, second);
    selected.value
}

machine change(pair: &mut Pair, second: bool, value: u64) {
    let selected: &mut Node = relay(pair, second);
    selected.value = value;
}

machine observe_outer(outer: &mut Outer, second: bool) -> u64 {
    let selected: &mut Node = relay(&mut outer.pair, second);
    selected.value
}

machine main() crashes Trap {
    let mut pair: Pair = Pair { left: Node { value: 17 }, right: Node { value: 43 } };
    let right: u64 = observe(&mut pair, true);
    let left: u64 = observe(&mut pair, false);
    change(&mut pair, true, 44);
    change(&mut pair, false, 18);
    let mut outer: Outer = Outer {
        anchor: 91,
        pair: Pair { left: Node { value: 101 }, right: Node { value: 103 } }
    };
    let nested_right: u64 = observe_outer(&mut outer, true);
    let nested_left: u64 = observe_outer(&mut outer, false);
    transition right == 43 && left == 17
        && pair.left.value == 18 && pair.right.value == 44
        && nested_left == 101 && nested_right == 103 && outer.anchor == 91 {
        true -> passed()
        false -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
