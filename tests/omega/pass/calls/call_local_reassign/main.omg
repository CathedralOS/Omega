// A call-initialized mutable local can be overwritten by a literal and
// reassigned from a second call in a multi-state machine; the composed body
// rejoins both whole stores to the local.
machine echo(value: i32) -> i32 {
    value
}

data Main { total: i32; }

machine Main::main(main: &mut Main) {
    let mut seed: i32 = 70;
    let mut total: i32 = echo(seed);
    let first: i32 = total;
    total = 71;
    total = echo(first);
    transition first == 70 && total == 70 {
        true -> good(main, total)
        false -> bad(main)
    }
    machine good(main: &mut Main, total: i32) { main.total = total; }
    machine bad(main: &mut Main) { main.total = 0; }
}
