// The two cyclic entries use different parameter positions. Finishing states
// retain only the borrowed local; repeated invocations observe both writes.
data Counter { value: u64; }

machine Counter::even(counter: &mut Counter, remaining: u64) -> u64
terminates by remaining;
{
    transition remaining == 0 {
        true -> finish(counter)
        _ -> Counter::odd(remaining - 1, counter)
    }
    machine finish(counter: &mut Counter) -> u64 {
        counter.value = 70;
        counter.value
    }
}

machine Counter::odd(remaining: u64, counter: &mut Counter) -> u64
terminates by remaining;
{
    transition remaining == 0 {
        true -> finish(counter)
        _ -> Counter::even(counter, remaining - 1)
    }
    machine finish(counter: &mut Counter) -> u64 {
        counter.value = 71;
        counter.value
    }
}

machine main() crashes Trap {
    let mut counter: Counter;
    let first: u64 = Counter::even(&mut counter, 1000);
    let observed_first: u64 = counter.value;
    let second: u64 = Counter::odd(1000, &mut counter);
    transition first == 70 && observed_first == 70 && second == 71 && counter.value == 71 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
