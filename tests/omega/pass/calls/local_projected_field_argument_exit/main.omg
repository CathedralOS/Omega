// A static machine lends one field of its local record, `&mut screen.banner`,
// to a machine that takes the field's own type. The loan presents exactly that
// subtree and moves nothing out of the local: the write lands in
// `screen.banner`, and the local is still whole for the read that follows.
// Exits 70 only when the projected loan updated the caller's field.

use omega_language_std::console;

data Banner { width: i32 in Wrapping; }
data Screen { banner: Banner; height: i32 in Wrapping; }

machine Banner::widen(banner: &mut Banner, by: i32 in Wrapping) {
    banner.width = banner.width + by;
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut screen: Screen;
    Banner::widen(&mut screen.banner, 70);
    Console::exit_process(screen.banner.width as i32);
}
