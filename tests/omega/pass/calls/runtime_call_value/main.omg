domain [u8]::Utf8
requires
    valid_utf8(self);

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

use omega_language_std::console;

data Main {
    console: Console;
    label: [u8; 8] in Utf8;
}

machine Main::main(&mut self) {
    self.label = self.name();
    transition self.label == "hello" {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::name(&mut self) -> [u8; 8] in Utf8 {
    "hello"
}
