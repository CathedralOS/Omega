// RUN CANARY (exit 70) -- a dispatched value call with MULTI-ARM terminals
// (`big -> acc` place / `small -> 0 - acc` binary) called at TWO sites taking
// OPPOSITE arms, results bound to FIELDS. The binary arm's terminal was the
// silent fallthrough (native 72 vs interp 70); the place arm delivered. Pins
// per-arm terminal delivery across both terminal kinds + the field-binding
// return path. Differential.
use omega::language::std::console;
data Main { console: Console; low: i32 in Wrapping; high: i32 in Wrapping; }
machine Main::classify(&mut self, i: u64, j: u64, acc: i32 in Wrapping)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32 in Wrapping
{
    transition j < i {
        true -> classify(i, j + 1, acc + 2)
        false -> pick(acc)
    }
    state pick(&mut self, acc: i32 in Wrapping) -> i32 in Wrapping {
        transition acc > 5 { true -> big(acc) false -> small(acc) }
    }
    state big(&mut self, acc: i32 in Wrapping) -> i32 in Wrapping { acc }
    state small(&mut self, acc: i32 in Wrapping) -> i32 in Wrapping { 0 - acc }
}
machine Main::main(&mut self) {
    // 4 iterations x 2 = 8 > 5 -> big -> 8; 2 iterations x 2 = 4 -> small -> -4.
    self.high = self.classify(4, 0, 0);
    self.low = self.classify(2, 0, 0);
    transition self.high == 8 { true -> ck_low() _ -> bad(71) }
    state ck_low(&mut self) {
        transition self.low == -4 { true -> good() _ -> bad(72) }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
