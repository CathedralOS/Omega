// A whole-place `&mut` out-param loans a caller-owned structural result
// binding into a CheckedBody callee: `find` writes through `out` into the
// caller's `found`, and both writes must be visible after the call. Exits
// 70 only when the mutable loan reaches the binding's whole extent.
use omega_language_std::console;

data Item {
    key: i32;
    val: i32;
}

data Store {
}

machine find(key: i32, out: &mut Item) {
    out.key = key;
    out.val = 5;
}

data Main {
    store: Store;
}

machine Main::main(main: &mut Main) reaches Console {
    let found: Item = Item { key: 0, val: 0 };
    find(2, &mut found);

    transition found.val == 5 {
        true -> check_key(main, found)
        false -> bad(main)
    }
    // Carry the Console-bearing receiver to good/bad even without a direct read.
    machine check_key(main: &mut Main, found: Item) {
        transition found.key == 2 {
            true -> good(main)
            false -> bad(main)
        }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
