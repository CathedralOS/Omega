// A value (machine) call keeps its occurrence and its result when it is not
// the root of the expression its site lowers. Each shape below computes a
// value that the program checks, with its own failure code:
//
//   71  `twelve() + 0` in a local           (call under arithmetic)
//   72  `(twelve())`                        (parentheses are transparent)
//   73  `twelve() as i64`                   (a cast parent)
//   74  `twelve() == 12` as a Boolean local (a comparison parent)
//   75  `0 - twelve()` and `1 + twelve()`   (call as either operand)
//   76  `Main::add(main, twelve(), twelve())`      (calls as call arguments)
//   77  `main.total = twelve() * 2`         (a field store)
//   78  `transition twelve() + 1 == 13`     (a guard subject)
//   79  `Main::tick(main) * 10 + Main::tick(main)`    (ordered, single invocation: 12)
//   80  `false && Main::tick(main) == 3`         (the right operand never runs)
//
// Exit 70 means every call ran exactly as often as authored and its result
// reached the enclosing expression. The repair was 508b04b168f, retaining
// named terminal calls through ordinary call planning.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    total: i32;
    ticks: u32 in Wrapping;
}

machine twelve() -> i32
ensures result == 12
{
    transition { _ -> (12) }
}

machine Main::add(main: &mut Main, left: i32, right: i32) -> i32
requires 0 <= left && left <= 100 && 0 <= right && right <= 100
{
    left + right
}

machine Main::tick(main: &mut Main) -> u32 in Wrapping {
    main.ticks = main.ticks + 1;
    main.ticks
}

machine Main::main(main: &mut Main) reaches Console {
    main.ticks = 0;
    let sum: i32 = twelve() + 0;
    transition sum == 12 {
        true -> parenthesized(main)
        false -> bad(main, 71)
    }

    state parenthesized(main: &mut Main) {
        let bare: i32 = (twelve());
        transition bare == 12 {
            true -> cast(main)
            false -> bad(main, 72)
        }
    }

    state cast(main: &mut Main) {
        let wide: i64 = twelve() as i64;
        transition wide == 12 {
            true -> compare(main)
            false -> bad(main, 73)
        }
    }

    state compare(main: &mut Main) {
        let equal: bool = twelve() == 12;
        transition equal {
            true -> either_side(main)
            false -> bad(main, 74)
        }
    }

    state either_side(main: &mut Main) {
        let negated: i32 = 0 - twelve();
        let raised: i32 = 1 + twelve();
        transition negated == -12 && raised == 13 {
            true -> arguments(main)
            false -> bad(main, 75)
        }
    }

    state arguments(main: &mut Main) {
        let doubled: i32 = Main::add(main, twelve(), twelve());
        transition doubled == 24 {
            true -> store(main)
            false -> bad(main, 76)
        }
    }

    state store(main: &mut Main) {
        main.total = twelve() * 2;
        transition main.total == 24 {
            true -> guard(main)
            false -> bad(main, 77)
        }
    }

    state guard(main: &mut Main) {
        transition twelve() + 1 == 13 {
            true -> ordered(main)
            false -> bad(main, 78)
        }
    }

    state ordered(main: &mut Main) {
        let digits: u32 in Wrapping = Main::tick(main) * 10 + Main::tick(main);
        transition digits == 12 && main.ticks == 2 {
            true -> short_circuit(main)
            false -> bad(main, 79)
        }
    }

    state short_circuit(main: &mut Main) {
        let skipped: bool = false && Main::tick(main) == 3;
        transition !skipped && main.ticks == 2 {
            true -> good(main)
            false -> bad(main, 80)
        }
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
