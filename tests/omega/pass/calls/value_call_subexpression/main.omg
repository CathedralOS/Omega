// A value (machine) call keeps its occurrence even when it is NOT the root
// of the expression its construction site lowers. Every parented shape that
// once dropped the call now checks and executes:
//
//   let r: i32 = self.twelve();            checks   (call is the whole thing)
//   let r: i32 = (self.twelve());          checks   (parens are transparent)
//   let r: i32 = self.twelve() + 0;        checks   (this fixture)
//   let r: i64 = self.twelve() as i64;     checks   (a CAST parent)
//   let f: bool = self.twelve() == 12;     checks
//   let r: i32 = 0 - self.twelve();        checks
//   let r: i32 = self.add(self.twelve(), self.twelve());        checks
//   self.base = self.add(self.twelve(), 0);                    checks
//   transition { _ -> good(self.twelve() + 0) }                checks
//   _ = self.add(self.twelve(), 1);                            checks
//
// Each shape was verified end-to-end natively on 2026-09-29: the inner calls
// execute and their results reach the outer expression (exit codes carry the
// computed values). The repair was 508b04b168f, retaining named terminal
// calls through ordinary call planning.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    base: i32;
}

machine Main::twelve(&mut self) -> i32 {
    transition { _ -> (12) }
}

machine Main::main(&mut self) reaches Console {
    self.base = 1;
    transition { _ -> check() }

    state check(&mut self) {
        let result: i32 = self.twelve() + 0;
        transition { _ -> good() }
    }

    state good(&mut self) {
        self.console.exit_process(0);
    }
}
