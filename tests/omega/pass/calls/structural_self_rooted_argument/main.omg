// A shared parameter is forwarded as the whole structural argument of another
// static machine. Its storage identity comes from that parameter, never from
// the machine's qualified owner. Exercise the helpers from a local record.

data Filter { count: u64; }

data Main { filter: Filter; }

machine Filter::clone(filter: &Filter) -> Filter {
    Filter { count: filter.count }
}

machine Filter::cloned_count(filter: &Filter) -> u64 {
    let cloned: Filter = Filter::clone(filter);
    cloned.count
}

machine Main::main() crashes Trap {
    let mut main: Main;
    main.filter.count = 17;
    let count: u64 = Filter::cloned_count(&main.filter);
    transition count == 17 && main.filter.count == 17 {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
