// ENT2c guarded target-argument calls execute only inside the selected arm.
// The first call-bearing arm is not taken and must leave `hits` at zero. The
// second is taken, must increment exactly once, and must deliver 7 to the
// original target state. Follow-on arms forward a ranged state parameter
// through two calls (pinning left-to-right delivery), an explicitly typed
// source local, and nested calls inside a binary target argument. Exit 70
// covers both engines.
// Supply the data reference last so nested effects finish before the outer
// call or successor acquires its mutable argument. Effects stay in their arm.
use omega_language_std::console;

data Main {
    hits: u64 in Wrapping;
}

machine Main::bump_and_value(value: u32, main: &mut Main) -> u32
requires value <= 20
ensures result <= 20
{
    main.hits = main.hits + 1;
    value
}

machine Main::main(main: &mut Main) reaches Console {
    main.hits = 0;
    transition false {
        true -> consume(Main::bump_and_value(7, main), main)
        false -> check_skipped(main)
    }

    machine check_skipped(main: &mut Main) {
        transition main.hits == 0 {
            true -> take_call(main)
            false -> bad(main, 71)
        }
    }

    machine take_call(main: &mut Main) {
        transition true {
            true -> consume(Main::bump_and_value(7, main), main)
            false -> bad(main, 72)
        }
    }

    machine consume(delivered: u32, main: &mut Main) {
        transition delivered == 7 && main.hits == 1 {
            true -> reset_pair(main)
            false -> bad(main, 73)
        }
    }

    machine reset_pair(main: &mut Main) {
        main.hits = 0;
        transition { _ -> take_pair(main, 10) }
    }

    machine take_pair(main: &mut Main, seed: u32)
    requires seed <= 10
    {
        transition true {
            true -> consume_pair(
                Main::bump_and_value(seed, main),
                Main::bump_and_value(seed + 1, main),
                main
            )
            false -> bad(main, 74)
        }
    }

    machine consume_pair(first: u32, second: u32, main: &mut Main) {
        transition first == 10 && second == 11 && main.hits == 2 {
            true -> reset_local(main)
            false -> bad(main, 75)
        }
    }

    machine reset_local(main: &mut Main) {
        main.hits = 0;
        transition { _ -> take_local(main) }
    }

    machine take_local(main: &mut Main) {
        let seed: u32 = 20;
        transition true {
            true -> consume_local(Main::bump_and_value(seed, main), main)
            false -> bad(main, 76)
        }
    }

    machine consume_local(delivered: u32, main: &mut Main) {
        transition delivered == 20 && main.hits == 1 {
            true -> reset_nested(main)
            false -> bad(main, 77)
        }
    }

    machine reset_nested(main: &mut Main) {
        main.hits = 0;
        transition { _ -> take_nested(main) }
    }

    machine take_nested(main: &mut Main) {
        let seed: u32 = 20;
        transition true {
            true -> consume_nested(
                Main::bump_and_value(Main::bump_and_value(seed, main), main) + 1,
                main
            )
            false -> bad(main, 78)
        }
    }

    machine consume_nested(delivered: u32, main: &mut Main) {
        transition delivered == 21 && main.hits == 2 {
            true -> good(main)
            false -> bad(main, 79)
        }
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
