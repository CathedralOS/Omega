use omega::language::core::float_operations;

// RUN CANARY (exit 70, differential) -- a FLOAT value-call RETURN delivers:
// `passthru(3.5)` comes back 3.5. The frame-slot value writer was missing
// its FLOAT arm entirely (a float value fell through the int/enum/string/
// pointee arms, the writer returned None, and the call-result slot stayed
// ZII -- the folded terminal return then copied 0.0). Floats write as their
// IEEE-754 bit pattern; an f32 slot takes the landing-aware single-rounded
// bits. The RUNTIME-float-local ARG twin is still pinned pending
// (float_local_value_call_arg_divergence).
use omega_language_std::console;
machine passthru(x: f64) -> f64 {
    transition { _ -> (x) }
}
data Main { console: Console; }
machine Main::main(&mut self) {
    let out: f64 = passthru(3.5);
    transition out == 3.5 { true -> good() _ -> bad() }
    state good(&self) { self.console.exit_process(70); }
    state bad(&self) { self.console.exit_process(71); }
}
