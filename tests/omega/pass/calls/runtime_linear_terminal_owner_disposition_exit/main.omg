use omega_language_std::console;
use omega::language::core::drop;

data Receipt [linear] { code: i32; }

machine Receipt::drop(receipt: &mut Receipt) {}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    drop(receipt);
    observed
}

machine relay(receipt: Receipt) -> i32 {
    transition { _ -> consume(receipt) }
}

machine main() reaches Console {
    let issued: Receipt = Receipt { code: 7 };
    let forwarded: Receipt = issued;
    let observed: i32 = relay(forwarded);
    transition observed == 7 {
        true -> Console::exit_process(0)
        false -> Console::exit_process(1)
    }
}
