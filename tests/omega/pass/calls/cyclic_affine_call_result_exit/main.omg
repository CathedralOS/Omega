// A cyclic block that mints a fresh affine record by call each traversal:
// `Cell::blanked(position)` produces a claim-free owned result, two unit
// calls borrow the local result place (`&mut scratch` / `&scratch`), and
// the loop's back edge discards it before re-entering the cycle head. The
// terminal verifier admits the shape once eligibility counts an affine
// call result's disposal as proven by the frontier replay itself — the
// result place enters `owned_places` at the call and the fixed-point join
// rejects any traversal that fails to dispose it.

use omega_language_std::console;

data Cell {
    value: u64;
}

machine Cell::blanked(seed: u64) -> Cell {
    transition { _ -> (Cell { value: seed }) }
}

machine Cell::copy_from(cell: &mut Cell, source: &Cell) {
    cell.value = source.value;
}

data Holder {
    cells: [Cell; 4];
}

machine Holder::refresh(holder: &mut Holder) {
    transition { _ -> scan(holder, 0) }

    state scan(holder: &mut Holder, position: u64) {
        transition position < 4 {
            true -> step(holder, position)
            false -> done(holder)
        }
    }

    state step(holder: &mut Holder, position: u64) {
        let mut scratch: Cell = Cell::blanked(position);
        Cell::copy_from(&mut scratch, &holder.cells[position]);
        Cell::copy_from(&mut holder.cells[position], &scratch);
        transition { _ -> scan(holder, position + 1) }
    }

    state done(holder: &mut Holder) { }
}

data Main {
    holder: Holder;
}

machine Main::main(main: &mut Main) reaches Console {
    main.holder.cells[0].value = 10;
    main.holder.cells[1].value = 20;
    main.holder.cells[2].value = 30;
    main.holder.cells[3].value = 40;

    Holder::refresh(&mut main.holder);

    transition main.holder.cells[2].value == 30 {
        true -> done(main)
        false -> missed(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
