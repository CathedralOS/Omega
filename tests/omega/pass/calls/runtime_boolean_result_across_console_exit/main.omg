use omega_language_std::console;
use omega::language::core::binding;
machine read_value(console: &mut Binding<Console>) -> i32 reaches Console {
    let observed: ByteRead = block console.read_byte();
    transition observed { ByteRead::Eof -> (0 - 1) ByteRead::Byte { value } -> value }
}
machine classify(value: i32) -> bool { value == (0 - 1) }
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let value: i32 = block read_value(&mut main.console);
    let observed: bool = classify(value);
    main.console.write_byte(66);
    transition observed { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { main.console.write_byte(10); main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.write_byte(88); main.console.write_byte(10); main.console.exit_process(71); }
}
