use omega_language_std::console;
machine read_value() -> i32 reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed { ByteRead::Eof -> (0 - 1) ByteRead::Byte { value } -> value }
}
machine classify(value: i32) -> bool { value == (0 - 1) }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let value: i32 = block read_value();
    let observed: bool = classify(value);
    Console::write_byte(66);
    transition observed { true -> good(main) _ -> bad(main) }
    machine good(main: &mut Main) { Console::write_byte(10); Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::write_byte(88); Console::write_byte(10); Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
