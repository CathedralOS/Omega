use omega_language_std::console;
machine read_value() -> i32 reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed { ByteRead::Eof -> (0 - 1) ByteRead::Byte { value } -> value }
}
machine classify(value: i32) -> bool { value == (0 - 1) }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let value: i32 = block read_value();
    let observed: bool = classify(value);
    Console::write_byte(66);
    transition observed { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::write_byte(10); Console::exit_process(70); }
    state bad(main: &mut Main) { Console::write_byte(88); Console::write_byte(10); Console::exit_process(71); }
}
