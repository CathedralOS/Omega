use omega_language_std::console;

data Node { value: u64; }
data Pair { left: Node; right: Node; }
data Outer { anchor: u64; pair: Pair; }

machine pick(pair: &mut Pair, second: bool) -> &mut Node {
    transition { _ -> select(pair, second) }
    machine select(pair: &mut Pair, second: bool) -> &mut Node {
        transition second {
            true -> selected(9, &mut pair.right)
            false -> selected(7, &mut pair.left)
        }
    }
    machine selected(marker: u64, node: &mut Node) -> &mut Node { node }
}

machine relay(pair: &mut Pair, second: bool) -> &mut Node {
    let selected: &mut Node = pick(pair, second);
    selected
}

machine observe(pair: &mut Pair, second: bool) -> u64 {
    let selected: &mut Node = relay(pair, second);
    selected.value
}

machine change(pair: &mut Pair, second: bool, value: u64) {
    let selected: &mut Node = relay(pair, second);
    selected.value = value;
}

machine observe_outer(outer: &mut Outer, second: bool) -> u64 {
    let selected: &mut Node = relay(&mut outer.pair, second);
    selected.value
}

machine shared_identity(node: &Node) -> &Node { node }

machine shared_pick(pair: &Pair, second: bool) -> &Node {
    transition { _ -> select(second, pair) }
    machine select(second: bool, pair: &Pair) -> &Node {
        transition second {
            true -> selected(&pair.right)
            false -> selected(&pair.left)
        }
    }
    machine selected(node: &Node) -> &Node {
        let forwarded: &Node = shared_identity(node);
        forwarded
    }
}

machine shared_relay(pair: &Pair, second: bool) -> &Node {
    let selected: &Node = shared_pick(pair, second);
    selected
}

machine observe_shared(pair: &Pair, second: bool) -> u64 {
    let selected: &Node = shared_relay(pair, second);
    selected.value
}

machine main() reaches Console {
    let mut pair: Pair = Pair { left: Node { value: 17 }, right: Node { value: 43 } };
    let right: u64 = observe(&mut pair, true);
    let left: u64 = observe(&mut pair, false);
    let shared_right: u64 = observe_shared(&pair, true);
    let shared_left: u64 = observe_shared(&pair, false);
    change(&mut pair, true, 44);
    change(&mut pair, false, 18);
    let mut outer: Outer = Outer {
        anchor: 91,
        pair: Pair { left: Node { value: 101 }, right: Node { value: 103 } }
    };
    let nested_right: u64 = observe_outer(&mut outer, true);
    let nested_left: u64 = observe_outer(&mut outer, false);
    transition right == 43 && left == 17
        && shared_right == 43 && shared_left == 17
        && pair.left.value == 18 && pair.right.value == 44
        && nested_left == 101 && nested_right == 103 && outer.anchor == 91 {
        true -> Console::exit_process(0)
        false -> Console::exit_process(1)
    }
}
