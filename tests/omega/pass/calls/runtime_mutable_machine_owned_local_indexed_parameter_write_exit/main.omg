use omega_language_std::console;
use omega::language::core::service;

data Item {
    value: i32;
    tag: i32;
}

data Main {
    console: Service<Console>;
    items: [Item; 2];
}

machine Main::touch_tag(&mut self, item: &mut Item) {
    item.tag = 0;
}

machine Main::main(&mut self) reaches Console {
    self.items[0].tag = 1;
    self.items[1].tag = 2;
    let index: u64 = 0;
    self.touch_tag(&mut self.items[index]);

    transition self.items[0].tag == 0 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(173);
    }

    state bad(&mut self) {
        self.console.exit_process(174);
    }
}
