// A declared range is proven at every delivery from the facts of the
// delivered value: a literal, a narrower declared range, a local's literal
// initializer, and the guard and arithmetic facts at the call's own
// evaluation point. Statement calls and calls nested in expressions use the
// same judgment.
machine admit(value: f64) -> f64 requires value >= 0.0 && value <= 0.5 { value }

machine outer(value: f64) -> f64 { value }

machine forward(value: f64) -> f64 requires value >= 0.0 && value <= 0.25 {
    let bounded: f64 = value;
    let result: f64 = outer(admit(bounded));
    result
}

machine literal() -> f64 {
    let quarter: f64 = 0.25;
    let bounded: f64 = 0.5;
    _ = admit(quarter);
    _ = admit(bounded);
    admit(0.125)
}

machine count(value: u64) -> u64 requires value <= 4 { value }

machine pick(index: u64) -> u64 {
    transition index < 4 {
        true -> step(index)
        _ -> (0)
    }

    machine step(index: u64) -> u64 {
        let wrapped: u64 = index % 4;
        _ = count(index + 1);
        _ = count(wrapped);
        let result: u64 = count(wrapped + 1);
        transition { _ -> (result) }
    }
}

machine main() {
    _ = forward(0.125);
    _ = literal();
    _ = pick(2);
}
