// Marked terminal machine calls retain their ordinary operational envelope.
// Contextual acknowledgement words followed by '(' remain callable names.
public machine wait() -> bool blocks; { true }
machine block() -> bool { true }
machine suspend() -> bool { true }
public machine relay_block() -> bool blocks; {
    transition { _ -> block wait() }
}
machine contextual() -> bool { transition { _ -> block() } }
machine contextual_suspend() -> bool { transition { _ -> suspend() } }
machine main() crashes Trap {
    let waited: bool = block relay_block();
    let named: bool = contextual();
    let named_suspend: bool = contextual_suspend();
    transition waited && named && named_suspend {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
