data Sample { value: u64; }
data Snapshot [copy] { value: u64; }

machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}
machine make(count: &mut u64) -> Sample { Sample { value: tick(count) } }
machine ordered(first: &Sample, middle: u64, last: &Sample) -> bool {
    first.value == 1 && middle == 2 && last.value == 3
}
machine observe_owned(value: &Sample) -> u64 { value.value }
machine selected(enabled: bool, count: &mut u64) -> bool {
    enabled && ordered(
        &make(count),
        observe_owned(&Sample { value: tick(count) }),
        &Sample { value: tick(count) }
    )
}
machine observe(value: &Snapshot) -> u64 { value.value }
machine consume(value: &Sample, count: &mut u64) {
    count = value.value;
}
machine consume_copy(value: &Snapshot, count: &mut u64) {
    count = value.value;
}
machine main() crashes Trap {
    let mut count: u64 = 0;
    let skipped: bool = selected(false, &mut count);
    let result: bool = selected(true, &mut count);
    let copy: u64 = observe(&Snapshot { value: tick(&mut count) });
    consume(&Sample { value: 9 }, &mut count);
    let consumed: bool = count == 9;
    consume_copy(&Snapshot { value: 11 }, &mut count);
    transition skipped == false && result && copy == 4 && consumed && count == 11 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
