// Whole owned arguments preserve every byte independently of the caller's ABI.
// The first relay has the callee's signature; the second adds a scalar input.
data Payload { first: u64; second: u64; third: u64; }

machine observe(payload: Payload) crashes Trap {
    transition payload.first == 11 && payload.second == 22 && payload.third == 33 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine relay(payload: Payload) crashes Trap { observe(payload); }

machine mixed(marker: i32, payload: Payload) crashes Trap {
    observe(payload);
    transition marker == 77 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    relay(Payload { first: 11, second: 22, third: 33 });
    mixed(77, Payload { first: 11, second: 22, third: 33 });
}
