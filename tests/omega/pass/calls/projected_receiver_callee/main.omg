// A ranked callee entered through a projected receiver:
// `Cursor::step(&mut engine.cursor, start)` borrows the `cursor`
// field as the callee's whole receiver, and the callee's ranked
// backedge keeps that same projected referent as its subject. The
// caller/callee join preserves the exact projection, callee identity,
// return/cleanup, and the caller-visible write — `u64 [0..=8]`
// interval return spelled on both.
data Cursor where remaining <= 8 { remaining: u64; }
machine Cursor::step(cursor: &mut Cursor, remaining: u64) -> u64
requires remaining <= 8
ensures result <= 8
terminates by remaining -> Nat::Descending;
{
    transition remaining > 0 {
        true -> Cursor::step(cursor, remaining - 1)
        false -> done(cursor)
    }
    machine done(cursor: &mut Cursor) -> u64 {
        cursor.remaining = 0;
        0
    }
}
data Engine { cursor: Cursor; }
machine Engine::run(engine: &mut Engine) -> u64
ensures result <= 8 {
    let start: u64 = engine.cursor.remaining;
    _ = Cursor::step(&mut engine.cursor, start);
    engine.cursor.remaining
}

data Main { engine: Engine; }
machine Main::main(main: &mut Main) {
    main.engine.cursor.remaining = 5;
    _ = Engine::run(&mut main.engine);
}
