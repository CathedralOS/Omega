// Primitive array observations retain the selected payload's original path.
data Sample { values: [u64; 3]; }
data Reply {
    case Values(first: Sample, second: Sample);
    case Empty;
}
data DirectReply {
    case Values(items: [u64; 3]);
    case Empty;
}
data Receipt { value: u64; }
data Row { value: u64; receipt: Receipt; }
data RowReply { case Values(rows: [Row; 2]); case Empty; }

machine Receipt::drop(receipt: &mut Receipt) { receipt.value = 0; }

machine inspect_rows(reply: &RowReply, position: u64) -> bool {
    transition position < 2 {
        true -> selected(reply, position)
        false -> (false)
    }
    machine selected(reply: &RowReply, position: u64) -> bool {
        transition reply {
            RowReply::Values { rows } ->
                (rows[position].value == 69 && rows[position].receipt.value == 13)
            RowReply::Empty -> (false)
        }
    }
}

machine read_direct(reply: DirectReply, position: u64) -> u64 {
    transition position < 3 {
        true -> selected(reply, position)
        false -> 0
    }
    machine selected(reply: DirectReply, position: u64) -> u64 {
        transition reply {
            DirectReply::Values { items } -> (items[position])
            DirectReply::Empty -> 0
        }
    }
}

machine read(reply: Reply, position: u64) -> u64 {
    transition position < 3 {
        true -> selected(reply, position)
        false -> 0
    }
    machine selected(reply: Reply, position: u64) -> u64 {
        transition reply {
            Reply::Values { first, second } ->
                (((first.values[position] as u64 in Wrapping) * 10)
                    + (second.values[position] as u64 in Wrapping)) as u64
            Reply::Empty -> 0
        }
    }
}

machine main() crashes Trap {
    let selected: u64 = read(Reply::Values {
        first: Sample { values: [1, 6, 3] },
        second: Sample { values: [4, 9, 5] }
    }, 1);
    let neighbor: u64 = read(Reply::Values {
        first: Sample { values: [1, 6, 3] },
        second: Sample { values: [4, 9, 5] }
    }, 2);
    let empty: u64 = read(Reply::Empty, 1);
    let direct: u64 = read_direct(DirectReply::Values { items: [7, 8, 9] }, 1);
    let direct_neighbor: u64 = read_direct(DirectReply::Values { items: [7, 8, 9] }, 2);
    let outside: u64 = read_direct(DirectReply::Values { items: [7, 8, 9] }, 3);
    let direct_empty: u64 = read_direct(DirectReply::Empty, 1);
    let rows: RowReply = RowReply::Values { rows: [
        Row { value: 4, receipt: Receipt { value: 7 } },
        Row { value: 69, receipt: Receipt { value: 13 } }
    ] };
    let observed: bool = inspect_rows(&rows, 1);
    let retained: bool = inspect_rows(&rows, 1);
    let other_row: bool = inspect_rows(&rows, 0);
    transition selected == 69 && neighbor == 35 && empty == 0
        && direct == 8 && direct_neighbor == 9 && outside == 0 && direct_empty == 0
        && observed && retained && !other_row {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
