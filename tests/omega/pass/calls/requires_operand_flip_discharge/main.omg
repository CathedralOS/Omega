// A requires clause written `1 <= scale` while the caller's guard proves
// `scale >= 1` -- the operand-flipped spelling of the one bound.
use omega_language_std::console;

machine rounded(value: u64, scale: u64) -> u64
requires 1 <= scale
{
    transition { _ -> (value / scale) }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let s: u64 = opaque();
    transition s >= 1 {
        true -> run(main, s)
        _ -> bad(main)
    }
    state run(main: &mut Main, s: u64) {
        let r: u64 = rounded(10, s);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) { Console::exit_process(71); }
}

machine opaque() -> u64 {
    transition { _ -> (4u64) }
}
