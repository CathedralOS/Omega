// Borrowed-receiver scalar return: `count(&main.buf)` calls a
// `&self` machine carrying one `&[u8]` structural parameter and returning
// u64. The callee leaves its receiver ambient on the attachment carrier, so
// the call's structural arguments carry one slot the forwarded roster
// rejoins around — admission, qualifier replay, source custody, and transfer
// shape all compare around the ambient position.
//
// Mirrors Squalr's `main.reader.read_bytes(&main.info, 0, &mut main.buf)`
// field-receiver scalar calls carrying byte-view arguments.

use omega_language_std::console;
use omega::language::core::binding;

data Probe {
    base: u64;
}

machine count(bytes: &[u8]) -> u64 {
    (bytes.len)
}

data Main {
    console: Binding<Console>;
    probe: Probe;
    buf: [u8; 8];
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[0] = 1;
    let n: u64 = count(&main.buf);
    transition n == 8 {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        main.console.exit_process(70);
    }

    state missed(main: &mut Main) {
        main.console.exit_process(71);
    }
}
