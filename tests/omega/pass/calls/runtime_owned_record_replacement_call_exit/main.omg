// Each move consumes one value; replacing its home establishes the next one.
data Item { number: i32; }
data Main {}

machine take(item: Item) -> i32 { item.number }

machine Main::main() crashes Trap {
    let mut item: Item = Item { number: 17 };
    let first: i32 = take(item);
    item = Item { number: 42 };
    let second: i32 = take(item);
    item = Item { number: 85 };
    let third: i32 = take(item);
    transition first == 17 && second == 42 && third == 85 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
