// Expected exit: 0
use omega_language_std::console;
data Main { big: u64; }
machine take(value: i64) -> i64 requires value > 0 { value }
machine Main::main(main: &mut Main) reaches Console {
    main.big = 7;
    let view: &i64 = &main.big as &i64;
    let result: i64 = take(view);
    transition result == 7 { true -> done() _ -> wrong() }
    machine done() { Console::exit_process(0); }
    machine wrong() { Console::exit_process(71); }
}
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
