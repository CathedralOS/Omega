use omega_language_std::console;
use omega::language::core::binding;
pub data Value {}
pub boundary requirement Value::read(value: i32) -> i32;
data ValueProvider {}
machine ValueProvider::read(value: i32) -> i32 satisfies Value::read { (value) }
machine forward(value: i32) -> i32 {
    transition value == 70 {
        true -> Value::read(value)
        _ -> Value::read(71)
    }
}
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let selected: i32 = forward(70);
    let fallback: i32 = forward(0);
    transition selected == 70 && fallback == 71 {
        true -> good(&main.console)
        _ -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 74); }
}
