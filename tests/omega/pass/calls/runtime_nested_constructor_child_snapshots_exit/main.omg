// expressions.md: constructors evaluate authored fields, not declaration order;
// array children complete in index order. Nested copies keep their own epoch.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Envelope [copy] { replaced: bool; ticket: Ticket; }
data Nested [copy] { marker: i32; envelope: Envelope; }
data Main { ticket: Ticket; }

machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine Main::replace_and_return(main: &mut Main) -> Ticket {
    main.ticket = Ticket { amount: 0, marker: 0 };
    main.ticket
}

machine observe_nested(value: Nested)
requires value.envelope.ticket in Ticket::Issued
crashes Trap {
    transition value.marker == 7 && value.envelope.replaced && value.envelope.ticket.amount == 41 && value.envelope.ticket.marker == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine observe_array(value: [Ticket; 2])
requires value[0] in Ticket::Issued
crashes Trap {
    transition value[0].amount == 41 && value[0].marker == 9 && value[1].amount == 0 && value[1].marker == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.ticket = Ticket::issue();
    observe_nested(Nested {
        envelope: Envelope { ticket: main.ticket, replaced: Main::replace(main) },
        marker: 7
    });
    main.ticket = Ticket::issue();
    observe_array([main.ticket, Main::replace_and_return(main)]);
    transition main.ticket.amount == 0 && main.ticket.marker == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
