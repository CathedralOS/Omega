// Lifetime arguments are erased regions, so a factory result and the
// bare nominal local must retain the same runtime carrier identity.
use omega_language_std::console;

data Input { value: u64; }
data Output<'region> { value: u64; }
data Envelope<'region> { output: Output<'region>; marker: u64; observed: u64; literal_result: u64; }
data Marker [copy] { case Expected; case Unexpected; }
data MarkerRecord [copy] { value: u64; }

machine Output::make<'region>(input: Input) -> Output<'region> {
    Output { value: ((input.value as u64 in Wrapping) + (20 as u64 in Wrapping)) as u64 }
}
machine Output::read_value(output: &Output) -> u64 { output.value }
machine Envelope::select() -> Marker { Marker::Expected }
machine Envelope::marker(marker: Marker) -> u64 {
    transition marker {
        Marker::Expected -> (70)
        Marker::Unexpected -> (0)
    }
}
machine Envelope::read_marker(envelope: &Envelope) -> u64 { envelope.marker }
machine Envelope::read_observed(envelope: &Envelope) -> u64 { envelope.observed }
machine Envelope::literal(marker_record: MarkerRecord) -> u64 { marker_record.value }
machine Envelope::read_literal(envelope: &Envelope) -> u64 { envelope.literal_result }
machine Envelope::wrap<'region>(output: Output<'region>) -> Envelope<'region> {
    let observed_value: u64 = Output::read_value(output);
    let selected_marker: Marker = Envelope::select();
    let selected_record: MarkerRecord = MarkerRecord { value: 70 };
    // The moved field must retain the record root and the following call.
    // The returned record and this nested record argument share one statement.
    Envelope {
        output: output,
        marker: Envelope::marker(selected_marker),
        observed: observed_value,
        literal_result: Envelope::literal(selected_record)
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let output: Output = Output::make(Input { value: 50 });
    let result: u64 = Output::read_value(output);
    let envelope: Envelope = Envelope::wrap(output);
    let marker: u64 = Envelope::read_marker(envelope);
    let observed: u64 = Envelope::read_observed(envelope);
    let literal: u64 = Envelope::read_literal(envelope);
    transition result == 70 && marker == 70 && observed == 70 && literal == 70 {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
