// RUN CANARY (exit 70) -- the ORIGINAL same-type contained-receiver
// aliasing repro, PROMOTED from the fail fence 2026-07-10r when
// per-instance receiver dispatch landed: `Counter::increment(&mut main.b)` used to
// mutate `main.a` (by-TYPE storage resolution picked the first Counter;
// memory: contained-machine-same-type-aliasing). The dispatch clone now
// runs on the RECEIVER's storage (BackendPlan::receiver_bases), so a x1 +
// b x1 leaves b.value == 1. Statement-position method calls dispatch, so
// this covers the common std-authoring shape; the INLINE value-call route
// stays fenced (pending/time/value_machine_receiver_field_postentry).
use omega_language_std::console;
use omega::language::core::binding;
data Counter { value: i32 in Wrapping; }
machine Counter::increment(counter: &mut Counter) {
    counter.value = counter.value + 1;
    transition { _ -> done() }
    state done() { }
}
data Main { console: Binding<Console>; a: Counter; b: Counter; }
machine Main::main(main: &mut Main) reaches Console {
    Counter::increment(&mut main.a);
    Counter::increment(&mut main.b);
    transition main.b.value == 1 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
