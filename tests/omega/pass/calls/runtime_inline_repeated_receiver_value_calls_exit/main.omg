// Repeated stateful inline calls with the SAME target, receiver, and literal
// argument must read their own ordinal result slots, including a nested
// occurrence. Aliasing the nested call to its identical sibling exits 69.
use omega_language_std::console;

data Gauge { value: i32 in Wrapping; }

machine Gauge::next(&mut self, delta: i32 in Wrapping) -> i32 in Wrapping {
    self.value = self.value + 1;
    transition { _ -> (self.value + delta) }
}

data Main { console: Console; gauge: Gauge; }

machine Main::main(&mut self) {
    self.gauge.value = 0;
    let total: i32 in Wrapping = 64 + self.gauge.next(0) + self.gauge.next(self.gauge.next(0));
    self.console.exit_process(total as i32);
}
