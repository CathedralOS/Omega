// Projected membership uses the same captured child for a constructor and a
// named argument. A later operand replaces the source after either copy.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;
machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Envelope [copy] { ticket: Ticket; }
data Main { envelope: Envelope; }

machine Main::replace(main: &mut Main) -> bool {
    main.envelope.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine observe(value: Envelope, replaced: bool)
requires value.ticket in Ticket::Issued
crashes Trap {
    transition replaced && value.ticket.amount == 41 && value.ticket.marker == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.envelope.ticket = Ticket::issue();
    observe(Envelope { ticket: main.envelope.ticket }, Main::replace(main));
    main.envelope.ticket = Ticket::issue();
    observe(main.envelope, Main::replace(main));
    transition main.envelope.ticket.amount == 0 && main.envelope.ticket.marker == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
