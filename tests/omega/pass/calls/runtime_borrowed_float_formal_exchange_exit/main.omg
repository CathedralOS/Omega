use omega::language::core::float_operations;
use omega_language_std::console;

// RUN CANARY (exit 70) + interpreter differential. Borrowed IEEE formals read
// and replace their callers' original binary32 and binary64 cells through the
// scalar reference codec. The decoded payload is the value's IEEE bits; a
// float register appears only where an ABI transfer requires one.
data Main {
    wide: f64;
}

machine exchange_narrow(cell: &mut f32, replacement: f32) -> f32 {
    let previous: f32 = cell;
    cell = replacement;
    previous
}

machine exchange_wide(cell: &mut f64, replacement: f64) -> f64 {
    let previous: f64 = cell;
    cell = replacement;
    previous
}

machine Main::main(main: &mut Main) reaches Console {
    let mut narrow: f32 = 2.5f32;
    main.wide = -0.75f64;
    let old_narrow: f32 = exchange_narrow(&mut narrow, 1.25f32);
    let old_wide: f64 = exchange_wide(&mut main.wide, 8.5f64);
    transition old_narrow == 2.5f32
        && narrow == 1.25f32
        && old_wide == -0.75f64
        && main.wide == 8.5f64 {
        true -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
