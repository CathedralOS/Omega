// SHARED `&Struct` param in a NON-boundary machine -- the first RUN coverage
// of this shape in the corpus. `read(&main.inner)` passes a shared reference;
// the callee reads both fields as assignment RHS/operand and guards on one.
// CONVENTION LOCKED HERE: a non-boundary shared `&Struct` arg is spilled by
// CONTENT into the param slot (flat member reads are correct); the pointee
// resolver must NOT treat it as a pointer (it did -- dereferencing the spilled
// field value as an address segfaulted, probed 2026-07-04). `&mut` slots and
// boundary-machine `&Struct` params hold REAL pointers and keep the pointee
// path. inner = {7, 35}; got = a + b = 42 -> exit 42.
use omega_language_std::console;
use omega::language::core::binding;
data Inner {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
}
data Main {
    console: Binding<Console>;
    inner: Inner;
    got: i32 in Wrapping;
}
machine Main::main(main: &mut Main) reaches Console {
    main.inner.a = 7;
    main.inner.b = 35;
    main.got = Main::read(&main.inner);
    transition main.got == 42 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(42); }
    state bad(main: &mut Main) { main.console.exit_process(main.got as i32); }
}
// `read` RETURNS its value rather than writing it through the caller's record.
// Taking `&mut Main` beside `&main.inner` would read the shared projection
// through the record's own exclusive loan, which exclusivity refuses; the
// shared `&Struct` parameter this fixture exists to cover is unaffected.
machine Main::read(r: &Inner) -> i32 in Wrapping {
    // assignment RHS through the ref param (both fields), then a guard on one
    let first: i32 in Wrapping = r.a;
    let sum: i32 in Wrapping = first + r.b;
    transition r.a == 7 {
        true -> add(sum)
        false -> zero()
    }
    state add(total: i32 in Wrapping) {
        transition { _ -> add2(total) }
    }
    state add2(total: i32 in Wrapping) {
        transition { _ -> (total) }
    }
    state zero() {
        transition { _ -> (1) }
    }
}
