// RUN CANARY (exit 70) + interpreter differential. MR2 complete: a
// MEASURED machine's TERMINAL tail self-call (`self.countdown(n - 1)` as
// the fall-through after the base case) rewrites at parse onto the bare
// loop-back edge, and the ranking witness proves the decrease through
// the FALL-THROUGH COMPLEMENT: control reaching the loop refutes the
// prior exit guard (`n == 0 -> 7`), and a refuted base case IS the
// positivity the countdown proof needs. (This was the pinned MR2
// frontier; the complement route landed 2026-07-11. En route: the
// default-order inference misread ANY constrained scalar -- `u64 in
// Trapping`, `u64 [0..=100]` -- as a SLICE because the constraint shell
// renders brackets; kinds now classify the unwrapped base.) The
// arithmetic on the rewritten unguarded edge proves in the EXACT domain:
// validation's S4 value-env narrows later statements by the negated
// guard of every exit-if-true transition (fall_through_narrowed_env),
// including refuted-equality point exclusion (n == 0 refuted on
// [0..=100] gives n in [1..=100], so n - 1 fits).
// Non-decreasing and missing-base-case twins refuse:
// fail/calls/terminal_tail_nondecreasing_rejected.
use omega_language_std::console;
data Main { console: Console; }
machine Main::countdown(&mut self, n: u64 [0..=100]) -> u64
terminates by n;
{
    transition n == 0 { true -> 7 }
    self.countdown(n - 1)
}
machine Main::main(&mut self) {
    let s: u64 = self.countdown(4);
    transition s == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
