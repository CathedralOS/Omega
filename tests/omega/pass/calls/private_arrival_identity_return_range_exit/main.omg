// `evaluate` returns its input, which its own `requires` bounds to
// [20, 60]. That return range reaches the nested `step` through its one
// arrival, which proves `60u64 - val` and `val - 20u64`. `main` passes two
// different values in range.
machine evaluate(v: u64) -> u64 requires v >= 20 && v <= 60 { v }

machine run(a: u64) crashes Trap requires a >= 20 && a <= 60 {
    let joined: u64 = evaluate(a);
    transition true {
        true -> step(joined, a)
        _ -> bad()
    }
    machine step(val: u64, expected: u64) {
        let diff1: u64 = 60u64 - val;
        let diff2: u64 = val - 20u64;
        transition diff1 + diff2 == 40 && val == expected {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    run(25);
    run(60);
}
