// ItemCount::get_count is a one-member boundary trait with an empty reach.
// The caller projects a request field into that requirement. Expected exit: 0.
public data Items { count: u64; }
data Request { items: Items; }
public boundary trait ItemCount {
    machine get_count(items: &Items) -> u64
    reaches;
}
data ItemsProvider {}
machine ItemsProvider::get_count(items: &Items) -> u64 satisfies ItemCount::get_count { items.count }
machine count(request: &Request, selected: bool) -> u64 {
    transition selected {
        true -> ItemCount::get_count(&request.items)
        _ -> ItemCount::get_count(&request.items)
    }
}
machine main() crashes Trap {
    let first: Request = Request { items: Items { count: 70 } };
    let second: Request = Request { items: Items { count: 71 } };
    let selected: u64 = count(&first, true);
    let fallback: u64 = count(&second, false);
    transition selected == 70 && fallback == 71 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
