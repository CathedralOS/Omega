public data Items { count: u64; }
data Request { items: Items; }
public boundary requirement Items::get_count(items: &Items) -> u64;
data ItemsProvider {}
machine ItemsProvider::get_count(items: &Items) -> u64 satisfies Items::get_count { items.count }
machine count(request: &Request, selected: bool) -> u64 {
    transition selected {
        true -> Items::get_count(&request.items)
        _ -> Items::get_count(&request.items)
    }
}
machine main() crashes Trap {
    let first: Request = Request { items: Items { count: 70 } };
    let second: Request = Request { items: Items { count: 71 } };
    let selected: u64 = count(&first, true);
    let fallback: u64 = count(&second, false);
    transition selected == 70 && fallback == 71 {
        true -> good()
        _ -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
