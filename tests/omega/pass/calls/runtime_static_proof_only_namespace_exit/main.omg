// A declaration namespace is not implicit by-value activation storage.
// Recursive mathematical data has no native layout; its static machine does.
data Recursive { next: Recursive; }

machine Recursive::answer() -> i32 { 70 }

machine main() crashes Trap {
    let answer: i32 = Recursive::answer();
    transition answer == 70 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
