// Call-with-return over an EFFECTFUL RECURSIVE (`terminates`) walk -- the
// DIRECT face. Historically FENCED (the inline-branching route could not
// loop, so the per-iteration `self.bump(..)` silently never executed: native
// counted 0 separators vs the interpreter's 2). Dispatch call-with-return
// replaced the fence; this canary pins the capability: count the '/'
// separators of "a/b/c" through the recursive walk. Exit 70.
use omega_language_std::console;
data Main { console: Console; n: i32 in Wrapping; r: i32; }
machine Main::walk(&mut self, path: &[u8], i: u64, acc: i32)
terminates by (i, path.len) -> Nat::BoundedDistance;
-> i32
{
    self.bump(path, i);
    transition i < path.len {
        true -> walk(path, i + 1, acc)
        false -> done(acc)
    }
    state done(&mut self, acc: i32) -> i32 {
        let result: i32 = self.n as i32;
        result
    }
}
machine Main::bump(&mut self, path: &[u8], i: u64) {
    transition i < path.len {
        true -> look(path, i)
        false -> skip()
    }
    state look(&mut self, path: &[u8], i: u64) {
        transition path[i] == 47 {
            true -> hit()
            false -> skip()
        }
    }
    state hit(&mut self) {
        self.n = self.n + 1;
        transition { _ -> skip() }
    }
    state skip(&mut self) { }
}
machine Main::main(&mut self) {
    self.n = 0;
    self.r = self.walk("a/b/c", 0, 0);
    let c: i32 = self.r;
    transition c == 2 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
