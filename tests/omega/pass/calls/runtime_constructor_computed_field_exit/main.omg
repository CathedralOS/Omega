// A type-scoped constructor whose result literal COMPUTES fields inline
// (`Pair8 { a: n / 100, b: 7 }`) delivers NATIVELY now: the decomposed field
// writes used to DROP their member suffix (append_place_suffix's catch-all
// returned the receiver unchanged), so the last field's value clobbered the
// whole struct at root size (silent for <=8-byte structs, the loud 16-byte
// fence otherwise). make(3500) -> {35, 7} -> exit 1.
use omega_language_std::console;
data Pair8 {
    a: u32;
    b: u32;
}
data Main {
    p: Pair8;
}
machine Pair8::make(n: u32) -> Pair8
requires n <= 10000
{
    transition { _ -> Pair8 { a: n / 100, b: 7 } }
}
machine Main::main(main: &mut Main) reaches Console {
    main.p = Pair8::make(3500);
    transition main.p.a == 35 && main.p.b == 7 {
        true -> yes(main)
        false -> no(main)
    }
    state yes(main: &mut Main) { Console::exit_process(1); }
    state no(main: &mut Main) { Console::exit_process(2); }
}
