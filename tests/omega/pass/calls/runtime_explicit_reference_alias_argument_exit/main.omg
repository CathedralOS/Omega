data Cell { value: i64; }
data Main { cell: Cell; neighbor: i64; }

machine set(destination: &mut i64, value: i64) { destination = value; }
machine forward(destination: &mut i64, value: i64) { set(destination, value); }

machine Main::main(main: &mut Main) crashes Trap {
    main.neighbor = 85;
    let parent: &mut Cell = &mut main.cell;
    let leaf: &mut i64 = &mut parent.value;
    set(leaf, 7);
    forward(leaf, 9);
    transition main.cell.value == 9 && main.neighbor == 85 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
