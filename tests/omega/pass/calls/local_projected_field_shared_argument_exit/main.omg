// A static machine lends one field of its local record by shared borrow,
// `&dash.engine`, to machines that take the field's own type: one returns
// nothing and one returns a scalar. The loan presents exactly that subtree,
// moves nothing out of the local, and permits no write. Exits 70 only when
// both callees read the caller's field through the loan.

use omega_language_std::console;

data Engine { rpm: i32 in Wrapping; }
data Dash { engine: Engine; speed: i32 in Wrapping; }

machine Engine::check(engine: &Engine) reaches Console {
    transition engine.rpm == 70 {
        true -> fine()
        false -> fail()
    }
    state fine() { }
    state fail() { Console::exit_process(71); }
}

machine Engine::rpm(engine: &Engine) -> i32 {
    engine.rpm as i32
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let dash: Dash = Dash { engine: Engine { rpm: 70 }, speed: 3 };
    Engine::check(&dash.engine);
    let rpm: i32 = Engine::rpm(&dash.engine);
    Console::exit_process(rpm);
}
