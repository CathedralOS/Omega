data Node { value: u64; }
machine identity(node: &mut Node) -> &mut Node { node }
machine generic_identity<T>(value: &mut T) -> &mut T { value }
machine choose(node: &mut Node, take: bool) -> &mut Node {
    transition take {
        true -> identity(node)
        _ -> identity(node)
    }
}
machine main() crashes Trap {
    let mut node: Node = Node { value: 70 };
    let first: &mut Node = choose(&mut node, true);
    first.value = 71;
    let first_value: u64 = first.value;
    let second: &mut Node = choose(&mut node, false);
    second.value = 72;
    let second_value: u64 = second.value;
    let generic: &mut Node = generic_identity<Node>(&mut node);
    generic.value = 73;
    transition first_value == 71 && second_value == 72 && node.value == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
