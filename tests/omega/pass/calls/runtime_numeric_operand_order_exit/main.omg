use omega_language_std::math;

data Counter where value >= -1 && value <= 1 {
    calls: u32 in Wrapping;
    value: i32;
}

machine step(counter: &mut Counter) -> i32 ensures result >= -2 && result <= -2 {
    counter.calls = counter.calls + 1u32;
    counter.value = 1i32;
    -2i32
}

machine magnitude(counter: &mut Counter) -> i32 ensures result >= 2 && result <= 2 {
    abs_i32(step(counter))
}

machine ordered_second(counter: &mut Counter, expected: u32) -> i32 ensures result >= 1 && result <= 1 crashes Trap {
    let observed: u32 in Wrapping = counter.calls;
    transition observed == expected {
        true -> increment(counter)
        false -> bad()
    }
    machine increment(counter: &mut Counter) -> i32 {
        counter.calls = counter.calls + 1u32;
        1i32
    }
    machine bad() -> i32 { crash Trap; }
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { calls: 0u32, value: -1i32 };
    let direct: i32 = abs_i32(step(&mut counter));
    let minimum: i32 = min_i32(step(&mut counter), step(&mut counter));
    let maximum: i32 = max_i32(step(&mut counter), ordered_second(&mut counter, 4u32));
    let clamped: i32 = clamp_i32(step(&mut counter), -1i32, 1i32);
    let first: i32 = magnitude(&mut counter);
    let second: i32 = magnitude(&mut counter);
    let skipped: bool = false && abs_i32(step(&mut counter)) == 2i32;
    counter.value = -1i32;
    let snapshot: i32 = abs_i32(counter.value + step(&mut counter));
    let calls: u32 in Wrapping = counter.calls;
    transition direct == 2i32 && minimum == -2i32 && maximum == 1i32
        && clamped == -1i32 && first == 2i32 && second == 2i32
        && skipped == false && snapshot == 3i32 && calls == 9u32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
