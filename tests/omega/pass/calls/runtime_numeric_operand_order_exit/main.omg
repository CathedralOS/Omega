data Counter {
    calls: u32 in Wrapping;
    value: i32 [-1..=1];
}

machine step(counter: &mut Counter) -> i32 [-2..=-2] {
    counter.calls = counter.calls + 1u32;
    counter.value = 1i32;
    -2i32
}

machine magnitude(counter: &mut Counter) -> i32 [2..=2] {
    abs(step(counter))
}

machine ordered_second(counter: &mut Counter, expected: u32) -> i32 [1..=1] crashes Trap {
    let observed: u32 in Wrapping = counter.calls;
    transition observed == expected {
        true -> increment(counter)
        false -> bad()
    }
    state increment(counter: &mut Counter) -> i32 [1..=1] {
        counter.calls = counter.calls + 1u32;
        1i32
    }
    state bad() -> i32 [1..=1] { crash Trap; }
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { calls: 0u32, value: -1i32 };
    let direct: i32 = abs(step(&mut counter));
    let minimum: i32 = min(step(&mut counter), step(&mut counter));
    let maximum: i32 = max(step(&mut counter), ordered_second(&mut counter, 4u32));
    let clamped: i32 = clamp(step(&mut counter), -1i32, 1i32);
    let first: i32 = magnitude(&mut counter);
    let second: i32 = magnitude(&mut counter);
    let skipped: bool = false && abs(step(&mut counter)) == 2i32;
    counter.value = -1i32;
    let snapshot: i32 = abs(counter.value + step(&mut counter));
    let calls: u32 in Wrapping = counter.calls;
    transition direct == 2i32 && minimum == -2i32 && maximum == 1i32
        && clamped == -1i32 && first == 2i32 && second == 2i32
        && skipped == false && snapshot == 3i32 && calls == 9u32 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
