// Expected exit: 0. Scalar branches prepare indexed structural Module operands once.
data Row { value: i64 in Wrapping; }
data Main { rows: [Row; 4]; index: u64; }
machine write(row: &mut Row, value: i64 in Wrapping) { row.value = value; }
machine choose(rows: &mut [Row; 4], index: u64) -> i64 in Wrapping requires index < 4 {
    transition index == 2 { true -> two(rows, index) _ -> other(rows, index) }
    machine two(rows: &mut [Row; 4], index: u64) -> i64 in Wrapping requires index < 4 {
        write(&mut rows[index], 17);
        rows[index].value
    }
    machine other(rows: &mut [Row; 4], index: u64) -> i64 in Wrapping requires index < 4 {
        write(&mut rows[index], 29);
        rows[index].value
    }
}
machine Main::main(main: &mut Main) crashes Trap {
    main.index = 2;
    let first: i64 in Wrapping = choose(&mut main.rows, main.index);
    main.index = 1;
    let second: i64 in Wrapping = choose(&mut main.rows, main.index);
    transition first == 17 && second == 29 && main.rows[2].value == 17 && main.rows[1].value == 29 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
