// A `&mut` machine argument rebinds through an UNRANKED control cycle's
// block-parameter channel, then is re-borrowed whole into a unit machine
// call. The terminal CallUnit argument spells the place with an empty path
// and `MutableBorrow` access — a call-scoped loan created and released
// inside the operation, the same custody pattern the cyclic eligibility arm
// admits for persistent receivers. The arm now reaches the block-parameter
// rebinding channel as well, so this shape checks.
//
// Reduced from squalr's `Mini` provider loop — `module: &mut NormalizedModule`
// carried through the cycle and forwarded to `module.set_module_name(...)`,
// where the arg place is the block parameter of the machine's `&mut` input.

use omega_language_std::console;

data Sink {
    value: u64 in Wrapping;
}

machine Sink::bump(sink: &mut Sink) {
    sink.value = sink.value + 1 as u64 in Wrapping;
}

data Driver {
    ticks: u64 in Wrapping;
}

machine Driver::drive(driver: &mut Driver, sink: &mut Sink, more: bool) {
    transition { _ -> go(driver, sink, more) }

    state go(driver: &mut Driver, sink: &mut Sink, more: bool) {
        transition more {
            true -> step(driver, sink)
            false -> done(driver)
        }
    }

    state step(driver: &mut Driver, sink: &mut Sink) {
        Sink::bump(sink);
        driver.ticks = driver.ticks + 1 as u64 in Wrapping;
        transition driver.ticks > 4 {
            true -> go(driver, sink, false)
            false -> go(driver, sink, true)
        }
    }

    state done(driver: &mut Driver) { }
}

data Main {
    driver: Driver;
    sink: Sink;
}

machine Main::main(main: &mut Main) reaches Console {
    Driver::drive(&mut main.driver, &mut main.sink, true);
    Console::exit_process(0);
}
