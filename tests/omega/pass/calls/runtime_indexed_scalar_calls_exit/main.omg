// Both receiver and explicit argument loans select the runtime array element.
use omega_language_std::console;

data Cell { value: u64 in Wrapping; }
data Main { cells: [Cell; 4]; }

machine Cell::read(cell: &Cell) -> u64 in Wrapping { cell.value }
machine read_cell(cell: &Cell) -> u64 in Wrapping { cell.value }

machine Main::probe(main: &Main, position: u64) -> bool {
    transition position < 4 {
        true -> read(main, position)
        false -> (false)
    }
    machine read(main: &Main, position: u64) -> bool {
        let receiver: u64 in Wrapping = Cell::read(&main.cells[position]) + 1;
        let argument: u64 in Wrapping = read_cell(&main.cells[position]) + 1;
        receiver == 70 && argument == 70
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.cells[2].value = 69;
    let selected: bool = Main::probe(main, 2);
    let other: bool = Main::probe(main, 1);
    let outside: bool = Main::probe(main, 4);
    transition selected && !other && !outside {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
