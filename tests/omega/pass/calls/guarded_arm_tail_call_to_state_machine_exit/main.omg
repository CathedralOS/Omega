// A guarded arm's terminal machine call invokes a multi-state machine that
// keeps its borrowed receiver, passing a field read as an ordinary argument
// (wiki/spec/language/state_contracts.md, "Terminal calls in transition
// arms"). `check` tail-calls `verify(main.k)` only on its true arm; `verify`
// exits 70 when it received 5. The false arm and a wrong value exit 71.
//
// The receiver-and-argument shape of `slices/domained_runtime_end_subslice_exit`
// without its subslice: the arm call must carry the caller's receiver loan,
// which `calls/conditional_arm_tail_call_to_machine_exit` (single-state
// callees) never needs.
use omega_language_std::console;

data Main {
    k: u64;
}

machine Main::main(main: &mut Main) {
    main.k = 5;
    transition {
        _ -> Main::check(main, 7)
    }
}

machine Main::check(main: &mut Main, limit: u64) reaches Console {
    let k_value: u64 = main.k;
    transition main.k < limit {
        true -> Main::verify(main, k_value)
        false -> bad(main)
    }
    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine Main::verify(main: &mut Main, length: u64) reaches Console {
    transition length == 5 {
        true -> good(main)
        false -> wrong(main)
    }
    state good(main: &mut Main) {
        Console::exit_process(70);
    }
    state wrong(main: &mut Main) {
        Console::exit_process(71);
    }
}
