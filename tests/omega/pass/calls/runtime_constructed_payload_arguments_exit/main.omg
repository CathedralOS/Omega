data Sample { value: u64; }
data Reply {
    case Values(first: Sample, second: Sample);
    case Empty;
}

machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}

machine read(reply: Reply) -> u64 {
    transition reply {
        Reply::Values { first, second } ->
            (((first.value as u64 in Wrapping) * 10)
                + (second.value as u64 in Wrapping)) as u64
        Reply::Empty -> 0
    }
}

machine selected(enabled: bool, count: &mut u64) -> bool {
    enabled && read(Reply::Values {
        second: Sample { value: tick(count) },
        first: Sample { value: tick(count) }
    }) == 21
}

machine main() crashes Trap {
    let mut count: u64 = 0;
    let skipped: bool = selected(false, &mut count);
    let produced: bool = selected(true, &mut count);
    let empty: bool = read(Reply::Empty) == 0;
    transition skipped == false && produced && empty && count == 2 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
