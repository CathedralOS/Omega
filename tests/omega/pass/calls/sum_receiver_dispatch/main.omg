// A carrier-qualified static machine may borrow a SUM, not just a
// record: `Transition::equals(transition: &Transition, ...)` dispatches
// on the borrowed sum's cases, and its states receive the
// discriminated other explicitly.
data Transition [copy] {
    case First;
    case Second;
}
data Main {
    left: Transition;
    right: Transition;
}
machine Transition::equals(transition: &Transition, other: &Transition) -> bool {
    transition transition {
        Transition::First -> first(other)
        Transition::Second -> second(other)
    }
    machine first(other: &Transition) -> bool {
        transition other {
            Transition::First -> (true)
            Transition::Second -> (false)
        }
    }
    machine second(other: &Transition) -> bool {
        transition other {
            Transition::Second -> (true)
            Transition::First -> (false)
        }
    }
}
machine Main::main(main: &mut Main) {
    let same: bool = Transition::equals(&main.left, &main.right);
}
