// RUN CANARY (exit 70). One state makes two inline value calls into the same
// data family through DIFFERENT receivers. Each call must read its own
// receiver: `b` is `self.second`'s 9, not `self.first`'s 7. A by-type
// fallback that resolves both calls to the first matching base returns 7 for
// `b` and exits 71, which is the silent wrong answer this canary exists to
// catch -- it is a value check, not a refusal.
use omega_language_std::console;
use omega::language::core::binding;

data Tally { count: i32 in Wrapping; }

machine Tally::get(&mut self) -> i32 in Wrapping {
    transition true { true -> done(self.count) }
    state done(&mut self, value: i32 in Wrapping) -> i32 in Wrapping { value }
}

data Holder { first: Tally; second: Tally; }

machine Holder::run(&mut self) -> i32 in Wrapping {
    self.first.count = 7;
    self.second.count = 9;
    let a: i32 in Wrapping = self.first.get();
    let b: i32 in Wrapping = self.second.get();
    transition true { true -> done(a, b) }
    state done(&mut self, a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping { b }
}

data Main {
    console: Binding<Console>;
    holder: Holder;
    flag: i32 in Wrapping;
}

machine Main::main(&mut self) reaches Console {
    self.flag = self.holder.run();
    transition self.flag == 9 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
