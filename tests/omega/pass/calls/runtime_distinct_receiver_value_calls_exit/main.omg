// RUN CANARY (exit 70). One state makes two inline value calls into the same
// data family through DIFFERENT receivers. Each call must read its own
// receiver: `b` is `holder.second`'s 9, not `holder.first`'s 7. A by-type
// fallback that resolves both calls to the first matching base returns 7 for
// `b` and exits 71, which is the silent wrong answer this canary exists to
// catch -- it is a value check, not a refusal.
use omega_language_std::console;
use omega::language::core::binding;

data Tally { count: i32 in Wrapping; }

machine Tally::get(tally: &mut Tally) -> i32 in Wrapping {
    transition true { true -> done(tally.count) }
    state done(value: i32 in Wrapping) -> i32 in Wrapping { value }
}

data Holder { first: Tally; second: Tally; }

machine Holder::run(holder: &mut Holder) -> i32 in Wrapping {
    holder.first.count = 7;
    holder.second.count = 9;
    let a: i32 in Wrapping = Tally::get(&mut holder.first);
    let b: i32 in Wrapping = Tally::get(&mut holder.second);
    transition true { true -> done(a, b) }
    state done(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping { b }
}

data Main {
    console: Binding<Console>;
    holder: Holder;
    flag: i32 in Wrapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.flag = Holder::run(&mut main.holder);
    transition main.flag == 9 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
