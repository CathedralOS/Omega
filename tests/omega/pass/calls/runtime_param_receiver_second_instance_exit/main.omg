// RUN CANARY (exit 70) -- PARAM-BINDING SERVE (landed 2026-07-11i,
// flipped from fail/calls/param_receiver_multi_instance_rejected): a
// spliced helper takes `&mut Tally` and calls through the param while
// TWO Tally instances exist; the caller passes the SECOND. The receiver
// chain walk binds `t := &mut main.second` at the descent (param
// environment) and resolves the param-receiver hop to second's storage
// -- the by-type walk read FIRST (silent-wrong 7-for-9 before the
// fence, then fenced, now SERVED). Tally::get(&mut t) = 9 -> exit 70.
use omega_language_std::console;
data Tally { count: i32 in Wrapping; }
machine Tally::get(tally: &mut Tally) -> i32 in Wrapping {
    transition true { true -> done(tally.count) }
    state done(value: i32 in Wrapping) -> i32 in Wrapping { value }
}
data Holder { first: Tally; second: Tally; }
machine Holder::probe(t: &mut Tally) -> i32 in Wrapping {
    let v: i32 in Wrapping = Tally::get(&mut t);
    transition true { true -> done(v) }
    state done(v: i32 in Wrapping) -> i32 in Wrapping { v }
}
machine Holder::run(holder: &mut Holder) -> i32 in Wrapping {
    holder.first.count = 7;
    holder.second.count = 9;
    let v: i32 in Wrapping = Holder::probe(&mut holder.second);
    transition true { true -> done(v) }
    state done(v: i32 in Wrapping) -> i32 in Wrapping { v }
}
data Main { holder: Holder; flag: i32 in Wrapping; }
machine Main::main(main: &mut Main) reaches Console {
    main.flag = Holder::run(&mut main.holder);
    transition main.flag == 9 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
