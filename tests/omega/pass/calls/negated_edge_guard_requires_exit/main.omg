// A negated transition arm carries the complement of its guard as contract
// evidence: `check` requires `v < 100`, and the `_ ->` continuation of
// `v >= 100` proves exactly that bound, so the requires discharges without a
// restated premise. The argument is a call result, not a literal, so no
// constant folding can stand in for the entailment.
use omega_language_std::console;

machine check(v: u64)
requires v < 100u64
{}

data Main {
}

machine opaque() -> u64 {
    transition { _ -> (7u64) }
}

machine Main::main(main: &mut Main) reaches Console {
    let v: u64 = opaque();
    transition v >= 100u64 {
        true -> bad(main)
        _ -> then(main, v)
    }
    state then(main: &mut Main, v: u64) {
        check(v);
        Console::exit_process(70);
    }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
