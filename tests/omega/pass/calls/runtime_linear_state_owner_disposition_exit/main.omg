use omega_language_std::console;
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

machine consume_pair(first: Receipt, second: Receipt) -> bool {
    let first_code: i32 = first.code;
    let second_code: i32 = second.code;
    drop(first);
    drop(second);
    first_code == 29 && second_code == 17
}

machine relay(first: Receipt, second: Receipt) -> bool {
    transition { _ -> handoff(second, first) }

    machine handoff(first: Receipt, second: Receipt) -> bool {
        transition { _ -> consume_pair(first, second) }
    }
}

machine main() reaches Console {
    let first: Receipt = Receipt { code: 17 };
    let second: Receipt = Receipt { code: 29 };
    let forwarded: Receipt = first;
    let forwarded_second: Receipt = second;
    let observed: bool = relay(forwarded, forwarded_second);
    transition observed {
        true -> Console::exit_process(0)
        false -> Console::exit_process(1)
    }
}
