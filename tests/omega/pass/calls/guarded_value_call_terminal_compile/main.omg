// PASS CANARY: a guarded arm's value call rewrites to a synthesized
// continuation state only when every argument is a bare NAME of an
// enclosing state parameter. The computed argument (`dbl(x + 1)`) shape
// also compiles end to end on the native route: the checked-stage fence
// and the lowering-time operation-proof obligation that once refused it
// were both retired upstream.
use omega::language::std::console;
use omega::language::core::service;
data Main { console: Service<Console>; }
machine dbl(x: i32 [0..=1001]) -> i32 {
    transition { _ -> (x + x) }
}
machine pick(x: i32 [0..=1000]) -> i32 {
    transition x > 50 { true -> (dbl(x + 1)) _ -> (x) }
}
machine Main::main(&mut self) reaches Console {
    let p: i32 = pick(60);
    transition p == 122 { true -> good() _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
}
