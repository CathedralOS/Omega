// PASS CANARY: a guarded arm's value call, with a computed argument
// (`dbl(x + 1)`), is evaluated inside the selected arm at its authored point
// and compiles end to end on the native route; resolution synthesizes no
// continuation state for it.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine dbl(x: i32 [0..=1001]) -> i32 {
    transition { _ -> (x + x) }
}
machine pick(x: i32 [0..=1000]) -> i32 {
    transition x > 50 { true -> (dbl(x + 1)) _ -> (x) }
}
machine Main::main(&mut self) reaches Console {
    let p: i32 = pick(60);
    transition p == 122 { true -> good() _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
}
