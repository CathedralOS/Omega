// A structural-returning call borrows only the selected payload. The result
// owns fresh contents, the original stays readable, and the empty arm never
// evaluates the payload call.
use omega_language_std::console;

data Payload { value: u64 in Wrapping; }
machine Payload::clone(source: &Payload) -> Payload {
    Payload { value: source.value + 1 }
}
machine Payload::read(source: &Payload) -> u64 { source.value as u64 }

data Selection {
    case Found(payload: Payload);
    case Empty;
}
machine Selection::clone(source: &Selection) -> Selection {
    transition source {
        Selection::Found { payload } -> (Selection::Found {
            payload: Payload::clone(payload)
        })
        Selection::Empty -> (Selection::Empty)
    }
}
machine Selection::read(source: &Selection) -> u64 {
    transition source {
        Selection::Found { payload } -> (Payload::read(payload))
        Selection::Empty -> (0)
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let source: Selection = Selection::Found { payload: Payload { value: 41 } };
    let cloned: Selection = Selection::clone(&source);
    let empty: Selection = Selection::Empty;
    let cloned_empty: Selection = Selection::clone(&empty);
    transition Selection::read(&source) == 41
        && Selection::read(&cloned) == 42
        && Selection::read(&cloned_empty) == 0 {
        true -> done(main)
        _ -> failed(main)
    }
    machine done(main: &mut Main) { Console::exit_process(70); }
    machine failed(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
