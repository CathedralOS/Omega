// V8: 3-arg ROTATION through a self-transition loop -- the full
// parallel-assignment cycle (`-> rot(k-1, b, c, a)`). rot(3, 1,2,3):
// (1,2,3)->(2,3,1)->(3,1,2)->(1,2,3) -> a==1 -> exit 1.
use omega_language_std::console;
data Main {
    console: Console;
}
machine Main::rot(&mut self, k: u64, a: u64, b: u64, c: u64)
terminates by k;
-> u64
{
    transition k > 0 {
        true -> rot(k - 1, b, c, a)
        false -> a
    }
}
machine Main::main(&mut self) {
    let r: u64 = self.rot(3, 1, 2, 3);
    transition r == 1 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
