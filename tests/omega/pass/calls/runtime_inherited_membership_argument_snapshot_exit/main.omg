// Requirement and implementation formal names differ. The issued owned
// argument completes before the later operand replaces its source, so its
// membership and bytes belong to the saved copy, not the caller's new value.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

trait Consumer {
    machine observe(ticket: Ticket, replaced: bool) -> bool
    requires ticket in Ticket::Issued;
}

machine observe(saved_ticket: Ticket, did_replace: bool) -> bool
satisfies Consumer::observe {
    did_replace && saved_ticket.amount == 41 && saved_ticket.marker == 9
}

data Main { ticket: Ticket; }

machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine Main::main(main: &mut Main) crashes Trap {
    main.ticket = Ticket::issue();
    let captured: bool = observe(main.ticket, Main::replace(main));
    transition captured && main.ticket.amount == 0 && main.ticket.marker == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
