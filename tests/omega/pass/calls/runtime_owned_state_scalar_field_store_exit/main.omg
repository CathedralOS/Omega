// Whole owned homes retain direct write authority at entry and continuation.
// The nested store preserves the sibling; values arrive through ordinary calls.
use omega_language_std::console;
data Counter { value: u64; untouched: u64; }
data Envelope { inner: Counter; marker: u64; }
machine entry_update(mut counter: Counter, replacement: u64) -> Counter {
    counter.value = replacement;
    counter
}
machine state_update(envelope: Envelope, replacement: u64) -> Envelope {
    transition { _ -> update(envelope, replacement) }
    state update(mut envelope: Envelope, replacement: u64) -> Envelope {
        envelope.inner.value = replacement;
        envelope
    }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let direct: Counter = entry_update(Counter { value: 1, untouched: 11 }, 5);
    transition direct.value == 5 && direct.untouched == 11 {
        true -> compose(direct, main)
        false -> bad(main)
    }
    state compose(direct: Counter, main: &mut Main) {
        let carried: Envelope = state_update(Envelope { inner: direct, marker: 13 }, 7);
        transition carried.inner.value == 7 && carried.inner.untouched == 11 && carried.marker == 13 {
            true -> good(main)
            false -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
