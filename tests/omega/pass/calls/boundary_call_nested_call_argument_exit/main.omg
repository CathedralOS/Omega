// An ordinary nested call produces a boundary operand before the enclosing
// invocation. Its local initializer uses the same exact call ownership as
// direct scalar operands, without hoisting the conversion into another local.
// Windows only: the boundary binds kernel32 CloseHandle. The zero-initialized
// handle is invalid, so CloseHandle returns 0 and the program exits 70
// (71 otherwise). Target checking alone does not establish that native result.
use omega_language_std::console;
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;

data Io { }

boundary requirement Io::c_close_handle(handle: i64) -> i32
reaches
    Console;

data IoImports { }

windows_x86_64 machine close_handle_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "CloseHandle",
        },
    }
}

windows_x86_64 machine IoImports::c_close_handle(handle: i64) -> i32
    satisfies Io::c_close_handle
    via close_handle_binding();

data Main {
    handle: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    let ok: i32 = Io::c_close_handle(
        narrow_u64_to_i64_wrapping(main.handle)
    );
    transition ok == 0 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
