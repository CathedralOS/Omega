// Deployable native canary: only windows_x86_64 binds kernel32 CloseHandle.
use omega::language::core::external_binding;

machine build(builder: &mut Build) {
    Build::application(builder, "boundary_call_nested_call_argument_exit");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../source/library/std"
    }));
    Build::bind<Io::c_close_handle>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "CloseHandle",
        },
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
