// A guarded transition arm naming another machine completes a value-returning
// caller with that callee's result, beside an arm that returns a literal
// (wiki/spec/language/state_contracts.md, "Terminal calls in transition
// arms"). Only the selected arm runs; the other arm's call must not.
//
//   choose  a one-state receiver machine: `true -> self.add(value, 5)` beside
//           `false -> 1`. `choose(60)` returns 65 and records 60;
//           `choose(10)` returns 1 and leaves the record untouched.
//   staged  the same guarded call (`self.add(value, 7)` beside `false -> 3`)
//           in an internal state reached by a jump: `staged(40)` returns 47,
//           `staged(20)` returns 3 without calling.
//   inspect a machine without a receiver: `true -> Main::confirm(view[1..],
//           index)` beside `false -> 0`, forwarding a subslice to a
//           multi-state callee that reads its element at `index`:
//           `inspect(view, 0)` reads the second entry, 9; an index past the
//           view returns 0.
//
// Each wrong leg exits with its own code (71-74); every leg agreeing
// exits 70.
use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: i32;
}

data Main {
    console: Binding<Console>;
    last: i32;
    entries: [Entry; 4];
}

machine Main::add(&mut self, value: i32, bias: i32) -> i32
requires 0 <= value && value <= 100 && 0 <= bias && bias <= 100;
{
    self.last = value;
    transition { _ -> (value + bias) }
}

machine Main::choose(&mut self, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition value > 50 {
        true -> self.add(value, 5)
        false -> 1
    }
}

machine Main::staged(&mut self, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition value > 10 {
        true -> deciding(value)
        false -> 2
    }
    state deciding(&mut self, value: i32) -> i32
    requires 0 <= value && value <= 100;
    {
        transition value > 30 {
            true -> self.add(value, 7)
            false -> 3
        }
    }
}

machine Main::confirm(tail: &[Entry], chosen: u64) -> i32 {
    transition chosen < tail.len {
        true -> emit(tail[chosen].value)
        false -> 4
    }
    state emit(first: i32) -> i32 {
        transition { _ -> first }
    }
}

machine Main::inspect(view: &[Entry], index: u64) -> i32 {
    transition view.len >= 1 && index < view.len {
        true -> Main::confirm(view[1..], index)
        false -> 0
    }
}

machine Main::main(&mut self) reaches Console {
    self.last = 0;
    self.entries[1].value = 9;
    let taken: i32 = self.choose(60);
    transition taken == 65 && self.last == 60 {
        true -> skipping()
        false -> fail(71)
    }
    state skipping(&mut self) {
        let skipped: i32 = self.choose(10);
        transition skipped == 1 && self.last == 60 {
            true -> staging()
            false -> fail(72)
        }
    }
    state staging(&mut self) {
        let staged: i32 = self.staged(40);
        let declined: i32 = self.staged(20);
        transition staged == 47 && declined == 3 && self.last == 40 {
            true -> inspecting()
            false -> fail(73)
        }
    }
    state inspecting(&mut self) {
        let view: &[Entry] = self.entries.as_slice();
        let first: i32 = Main::inspect(view, 0);
        let past: i32 = Main::inspect(view, 7);
        transition first == 9 && past == 0 {
            true -> done()
            false -> fail(74)
        }
    }
    state done(&mut self) { self.console.exit_process(70); }
    state fail(&mut self, code: i32) { self.console.exit_process(code); }
}
