// A guarded transition arm naming another machine completes a value-returning
// caller with that callee's result, beside an arm that returns a literal
// (wiki/spec/language/state_contracts.md, "Terminal calls in transition
// arms"). Only the selected arm runs; the other arm's call must not.
//
//   choose  a one-state receiver machine: `true -> Main::add(main, value, 5)` beside
//           `false -> 1`. `choose(60)` returns 65 and records 60;
//           `choose(10)` returns 1 and leaves the record untouched.
//   staged  the same guarded call (`Main::add(main, value, 7)` beside `false -> 3`)
//           in an internal state reached by a jump: `staged(40)` returns 47,
//           `staged(20)` returns 3 without calling.
//   inspect a machine without a receiver: `true -> Main::confirm(view[1..],
//           index)` beside `false -> 0`, forwarding a subslice to a
//           multi-state callee that reads its element at `index`:
//           `inspect(view, 0)` reads the second entry, 9; an index past the
//           view returns 0.
//
// Each wrong leg exits with its own code (71-74); every leg agreeing
// exits 70.
use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    last: i32;
    entries: [Entry; 4];
}

machine Main::add(main: &mut Main, value: i32, bias: i32) -> i32
requires 0 <= value && value <= 100 && 0 <= bias && bias <= 100;
{
    main.last = value;
    transition { _ -> (value + bias) }
}

machine Main::choose(main: &mut Main, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition value > 50 {
        true -> Main::add(main, value, 5)
        false -> 1
    }
}

machine Main::staged(main: &mut Main, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition value > 10 {
        true -> deciding(main, value)
        false -> 2
    }
    state deciding(main: &mut Main, value: i32) -> i32
    requires 0 <= value && value <= 100;
    {
        transition value > 30 {
            true -> Main::add(main, value, 7)
            false -> 3
        }
    }
}

machine Main::confirm(tail: &[Entry], chosen: u64) -> i32 {
    transition chosen < tail.len {
        true -> emit(tail[chosen].value)
        false -> 4
    }
    state emit(first: i32) -> i32 {
        transition { _ -> first }
    }
}

machine Main::inspect(view: &[Entry], index: u64) -> i32 {
    transition view.len >= 1 && index < view.len {
        true -> Main::confirm(view[1..], index)
        false -> 0
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.last = 0;
    main.entries[1].value = 9;
    let taken: i32 = Main::choose(main, 60);
    transition taken == 65 && main.last == 60 {
        true -> skipping(main)
        false -> fail(main, 71)
    }
    state skipping(main: &mut Main) {
        let skipped: i32 = Main::choose(main, 10);
        transition skipped == 1 && main.last == 60 {
            true -> staging(main)
            false -> fail(main, 72)
        }
    }
    state staging(main: &mut Main) {
        let staged: i32 = Main::staged(main, 40);
        let declined: i32 = Main::staged(main, 20);
        transition staged == 47 && declined == 3 && main.last == 40 {
            true -> inspecting(main)
            false -> fail(main, 73)
        }
    }
    state inspecting(main: &mut Main) {
        let view: &[Entry] = &main.entries[..];
        let first: i32 = Main::inspect(view, 0);
        let past: i32 = Main::inspect(view, 7);
        transition first == 9 && past == 0 {
            true -> done(main)
            false -> fail(main, 74)
        }
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
