// An unconditional transition arm naming another machine completes a
// value-returning caller with that callee's result
// (wiki/spec/language/state_contracts.md, "Terminal calls in transition
// arms"); an internal state target stays a jump. Each leg forwards an `i32`
// result through `_ -> callee(..)` with scalar arguments:
//
//   forward  a one-state receiver machine tail-calls `Main::add(main, value, 5)`.
//   staged   jumps to its internal state `adding`, whose closing arm
//            tail-calls `Main::add(main, value, 7)`: the call is that state's last
//            operation and its bound result is the state's returned value.
//   pick     a machine without a receiver forwards a borrowed view and an
//            index to `Main::at`, which reads the selected element.
//
// `add` records the argument it received, so a leg that skipped the callee
// or passed a wrong operand also fails. Each wrong result exits with its own
// code (71-73); every leg agreeing exits 70.
use omega_language_std::console;

data Entry {
    value: i32;
}

data Main {
    last: i32;
    entries: [Entry; 4];
}

machine Main::add(main: &mut Main, value: i32, bias: i32) -> i32
requires 0 <= value && value <= 100 && 0 <= bias && bias <= 100;
{
    main.last = value;
    transition { _ -> (value + bias) }
}

machine Main::forward(main: &mut Main, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition { _ -> Main::add(main, value, 5) }
}

machine Main::staged(main: &mut Main, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition { _ -> adding(main, value) }
    state adding(main: &mut Main, value: i32) -> i32
    requires 0 <= value && value <= 100;
    {
        transition { _ -> Main::add(main, value, 7) }
    }
}

machine Main::at(view: &[Entry], index: u64) -> i32 {
    transition index < view.len {
        true -> (view[index].value)
        false -> (0)
    }
}

machine Main::pick(view: &[Entry], index: u64) -> i32 {
    transition { _ -> Main::at(view, index) }
}

machine Main::main(main: &mut Main) reaches Console {
    main.last = 0;
    main.entries[2].value = 30;
    let forwarded: i32 = Main::forward(main, 60);
    let forwarded_argument: i32 = main.last;
    let staged: i32 = Main::staged(main, 20);
    let staged_argument: i32 = main.last;
    let view: &[Entry] = &main.entries[..];
    let picked: i32 = Main::pick(view, 2);
    transition forwarded == 65 && forwarded_argument == 60 {
        true -> check_staged(main, staged, staged_argument, picked)
        false -> fail(main, 71)
    }
    state check_staged(main: &mut Main, staged: i32, staged_argument: i32, picked: i32) {
        transition staged == 27 && staged_argument == 20 {
            true -> check_picked(main, picked)
            false -> fail(main, 72)
        }
    }
    state check_picked(main: &mut Main, picked: i32) {
        transition picked == 30 {
            true -> done(main)
            false -> fail(main, 73)
        }
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state fail(main: &mut Main, code: i32) { Console::exit_process(code); }
}
