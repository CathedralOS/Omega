// An unconditional transition arm naming another machine completes a
// value-returning caller with that callee's result
// (wiki/spec/language/state_contracts.md, "Terminal calls in transition
// arms"); an internal state target stays a jump. Each leg forwards an `i32`
// result through `_ -> callee(..)` with scalar arguments:
//
//   forward  a one-state receiver machine tail-calls `self.add(value, 5)`.
//   staged   jumps to its internal state `adding`, whose closing arm
//            tail-calls `self.add(value, 7)`: the call is that state's last
//            operation and its bound result is the state's returned value.
//   pick     a machine without a receiver forwards a borrowed view and an
//            index to `Main::at`, which reads the selected element.
//
// `add` records the argument it received, so a leg that skipped the callee
// or passed a wrong operand also fails. Each wrong result exits with its own
// code (71-73); every leg agreeing exits 70.
use omega_language_std::console;
use omega::language::core::binding;

data Entry {
    value: i32;
}

data Main {
    console: Binding<Console>;
    last: i32;
    entries: [Entry; 4];
}

machine Main::add(&mut self, value: i32, bias: i32) -> i32
requires 0 <= value && value <= 100 && 0 <= bias && bias <= 100;
{
    self.last = value;
    transition { _ -> (value + bias) }
}

machine Main::forward(&mut self, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition { _ -> self.add(value, 5) }
}

machine Main::staged(&mut self, value: i32) -> i32
requires 0 <= value && value <= 100;
{
    transition { _ -> adding(value) }
    state adding(&mut self, value: i32) -> i32
    requires 0 <= value && value <= 100;
    {
        transition { _ -> self.add(value, 7) }
    }
}

machine Main::at(view: &[Entry], index: u64) -> i32 {
    transition index < view.len {
        true -> (view[index].value)
        false -> (0)
    }
}

machine Main::pick(view: &[Entry], index: u64) -> i32 {
    transition { _ -> Main::at(view, index) }
}

machine Main::main(&mut self) reaches Console {
    self.last = 0;
    self.entries[2].value = 30;
    let forwarded: i32 = self.forward(60);
    let forwarded_argument: i32 = self.last;
    let staged: i32 = self.staged(20);
    let staged_argument: i32 = self.last;
    let view: &[Entry] = self.entries.as_slice();
    let picked: i32 = Main::pick(view, 2);
    transition forwarded == 65 && forwarded_argument == 60 {
        true -> check_staged(staged, staged_argument, picked)
        false -> fail(71)
    }
    state check_staged(&mut self, staged: i32, staged_argument: i32, picked: i32) {
        transition staged == 27 && staged_argument == 20 {
            true -> check_picked(picked)
            false -> fail(72)
        }
    }
    state check_picked(&mut self, picked: i32) {
        transition picked == 30 {
            true -> done()
            false -> fail(73)
        }
    }
    state done(&mut self) { self.console.exit_process(70); }
    state fail(&mut self, code: i32) { self.console.exit_process(code); }
}
