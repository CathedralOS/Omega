// FROZEN DECISION 9 -- STRICT RESULT USE: `_ = call();` both compiles AND still
// EXECUTES the callee. roll() increments its &mut tally and returns bool; the
// explicitly-discarded statement call must bump the counter exactly once.
// calls == 41 -> exit 70 (executed once); 40 -> exit 10 (discard dropped the
// call entirely); 42 -> exit 3 (executed twice).
use omega_language_std::console;
use omega::language::core::binding;

data Tally {
    calls: u64;
    pad: u64;
}

data Main {
    console: Binding<Console>;
    tally: Tally;
}

machine Main::roll(
    tally: &mut Tally
    ) -> bool {
    tally.calls = ((tally.calls as u64 in Wrapping) + 1) as u64;

    transition {
        _ -> true
    }
}

machine Main::main(&mut self) reaches Console {
    self.tally.calls = 40;
    self.tally.pad = 0;

    transition {
        _ -> discard_call(&mut self)
    }

    state discard_call(main: &mut Main) {
        _ = Main::roll(&mut main.tally);

        transition {
            _ -> report(main)
        }
    }

    state report(main: &mut Main) {
        transition {
            main.tally.calls == 41 -> exit_correct(main)
            main.tally.calls == 40 -> exit_lost(main)
            main.tally.calls == 42 -> exit_doubled(main)
            _ -> exit_other(main)
        }
    }

    state exit_correct(main: &mut Main) { main.console.exit_process(70); }
    state exit_lost(main: &mut Main) { main.console.exit_process(10); }
    state exit_doubled(main: &mut Main) { main.console.exit_process(3); }
    state exit_other(main: &mut Main) { main.console.exit_process(77); }
}
