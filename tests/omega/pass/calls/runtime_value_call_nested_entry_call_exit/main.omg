// Deferral face #5: a NESTED value call inside the callee's entry.
// `Probe::make` assigns `probe.flag = Helper::check(&probe.helper, 1)` and guards on
// flag -- through an OUTER value call, the nested callee splices a THIRD
// source_key between the middle callee's ops, so a defer/fire scan that
// stops at the first foreign key never sees the middle callee's flag
// mutation. The outer leaf then fired at the StateCall, computing the
// caller's result from ZII flag=false (wrong arm, silently).
// The splice run ends at the CALLER's next own op, not at the first
// foreign source_key.
// exit 70 = both shapes guard on the delivered flag; 71 = nested-only
// entry read ZII; 72 = stores-around-the-nested-call variant read ZII.
use omega_language_std::console;
use omega::language::core::binding;
data Verdict { case No; case Yes; }
data Helper { seen: i32; }
machine Helper::check(helper: &mut Helper, x: i32) -> bool {
    helper.seen = x;
    transition helper.seen == 1 { true -> yes() _ -> no() }
    state yes() -> bool { true }
    state no() -> bool { false }
}
data Probe { helper: Helper; flag: bool; }
machine Probe::make(probe: &mut Probe) -> Verdict {
    probe.flag = Helper::check(&mut probe.helper, 1);
    transition probe.flag { true -> mk_yes() _ -> mk_no() }
    state mk_yes() -> Verdict { Verdict::Yes }
    state mk_no() -> Verdict { Verdict::No }
}
data Sensor { seen: i32; }
machine Sensor::check(sensor: &mut Sensor, x: i32) -> bool {
    sensor.seen = x;
    transition sensor.seen == 2 { true -> yes() _ -> no() }
    state yes() -> bool { true }
    state no() -> bool { false }
}
data Bracket { sensor: Sensor; a: i32; flag: bool; b: i32; }
machine Bracket::make(bracket: &mut Bracket) -> Verdict {
    bracket.a = 1;
    bracket.flag = Sensor::check(&mut bracket.sensor, 2);
    bracket.b = 3;
    transition bracket.flag { true -> mk_yes() _ -> mk_no() }
    state mk_yes() -> Verdict { Verdict::Yes }
    state mk_no() -> Verdict { Verdict::No }
}
data Main { console: Binding<Console>; probe: Probe; bracket: Bracket; v1: Verdict; v2: Verdict; }
machine Main::main(main: &mut Main) reaches Console {
    main.v1 = Probe::make(&mut main.probe);
    transition main.v1 { Verdict::Yes -> step2(main) _ -> bad(main, 71) }
    state step2(main: &mut Main) {
        main.v2 = Bracket::make(&mut main.bracket);
        transition main.v2 { Verdict::Yes -> good(main) _ -> bad(main, 72) }
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
