// RUN CANARY (exit 70) -- the LEGAL shape the borrow-mutability check
// (2026-07-18) must keep accepting: a `&mut` PARAMETER forwarded by bare
// name to another `&mut` parameter. `step(c)` passes a Name, not a `&mut`
// node (a shared `&` vanishes at parse time), so a SYNTACTIC mutability
// check would false-positive here -- the enforcement resolves the name's
// declaration instead. The callee writes through the double-hopped
// reference and the caller observes it via the aliased field once the
// loan has ended: `step` holds `c` exclusively, so it cannot read `main.c`
// itself, and `verify` reads it after the edge that drops `c`.
// exit 71 = the forwarded write missed main.c.

use omega_language_std::console;

data Counter { n: i32 in Wrapping; }
data Main { c: Counter; }

machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> enter(main, &mut main.c) }

    machine enter(main: &mut Main, c: &mut Counter) {
        transition { _ -> step(main, c) }
    }
    machine step(main: &mut Main, c: &mut Counter) {
        c.n = c.n + 59;
        transition { _ -> verify(main) }
    }
    machine verify(main: &mut Main) {
        transition main.c.n == 59 { true -> good(main) _ -> bad(main) }
    }

    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main)  { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
