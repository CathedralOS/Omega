use omega_language_std::console;
data Walker {}
machine Walker::walk(position: u64) -> u64 {
    transition position < 3 {
        true -> step(position)
        false -> (position)
    }
    state step(position: u64) -> u64 {
        Walker::walk(((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
    }
}
data Main { status: u64; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> gate(main) }
    state gate(main: &mut Main) {
        main.status = 1;
        transition { _ -> verify(main) }
    }
    state verify(main: &mut Main) {
        let value: u64 = Walker::walk(0);
        transition value == 3 { true -> yes(main) false -> no(main) }
    }
    state yes(main: &mut Main) { Console::exit_process(70); }
    state no(main: &mut Main) { Console::exit_process(71); }
}
