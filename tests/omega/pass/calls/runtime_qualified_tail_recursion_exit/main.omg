use omega_language_std::console;
data Walker {}
machine Walker::walk(position: u64) -> u64 {
    transition position < 3 {
        true -> step(position)
        false -> (position)
    }
    machine step(position: u64) -> u64 {
        Walker::walk(((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
    }
}
data Main { status: u64; }
machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> gate(main) }
    machine gate(main: &mut Main) {
        main.status = 1;
        transition { _ -> verify(main) }
    }
    machine verify(main: &mut Main) {
        let value: u64 = Walker::walk(0);
        transition value == 3 { true -> yes(main) false -> no(main) }
    }
    machine yes(main: &mut Main) { Console::exit_process(70); }
    machine no(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
