// A static machine lends one field of its local record, `&mut screen.banner`,
// to a machine that writes it and returns a scalar. A scalar result carries
// no custody, so the loan ends with the call: the second call borrows the same
// field again and sees the first call's write. Exits 70 only when both results
// and the caller's own field agree.

use omega_language_std::console;
use omega::language::core::binding;

data Banner { width: i32 in Wrapping; }
data Screen { height: i32 in Wrapping; banner: Banner; }

machine Banner::widen(banner: &mut Banner, by: i32 in Wrapping) -> i32 {
    banner.width = banner.width + by;
    transition { _ -> (banner.width as i32) }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut screen: Screen;
    let first: i32 = Banner::widen(&mut screen.banner, 30);
    let second: i32 = Banner::widen(&mut screen.banner, 40);
    transition first == 30 && second == 70 && screen.banner.width == 70 {
        true -> done(&main.console, 70)
        _ -> done(&main.console, 71)
    }

    state done(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
