// A callee's body executes exactly ONCE per written call, in every call role.
// roll() is an inline-branching callee (it has a transition) that counts its
// invocations through `&mut Tally`. One statement-position call (dispatched)
// plus one assignment-position call (inline-branching) = exactly 2 increments.
//
// Regression shape this pins: an inline-branching ASSIGNMENT-VALUE call had its
// callee statements emitted BOTH by the runtime-bodies splice and by the branch
// prelude expansion, so `let ok = Main::roll(&mut tally)` incremented twice per
// call (43/44 below). The splice is the executor for non-guard roles; non-guard
// preludes carry no callee operations.
use omega_language_std::console;
use omega::language::core::binding;

data Tally {
    calls: u64;
    pad: u64;
}

data Main {
    console: Binding<Console>;
    tally: Tally;
}

machine Main::roll(
    tally: &mut Tally
    ) -> bool {
    tally.calls = ((tally.calls as u64 in Wrapping) + 1) as u64;

    transition {
        _ -> true
    }
}

machine Main::main(&mut self) reaches Console {
    self.tally.calls = 40;
    self.tally.pad = 0;

    transition {
        _ -> statement_call(&mut self)
    }


    state statement_call(main: &mut Main) {
        _ = Main::roll(&mut main.tally);

        transition {
            _ -> assignment_call(main)
        }
    }

    state assignment_call(main: &mut Main) {
        let ok: bool = Main::roll(&mut main.tally);

        transition {
            _ -> report(main)
        }
    }

    state report(main: &mut Main) {
        transition {
            main.tally.calls == 42 -> exit_correct(main)
            main.tally.calls == 43 -> exit_one_doubled(main)
            main.tally.calls == 44 -> exit_both_doubled(main)
            main.tally.calls == 40 -> exit_lost(main)
            _ -> exit_other(main)
        }
    }

    state exit_correct(main: &mut Main) { main.console.exit_process(70); }
    state exit_one_doubled(main: &mut Main) { main.console.exit_process(2); }
    state exit_both_doubled(main: &mut Main) { main.console.exit_process(3); }
    state exit_lost(main: &mut Main) { main.console.exit_process(10); }
    state exit_other(main: &mut Main) { main.console.exit_process(77); }
}
