// A static entry lends its local record, whole and by one field, to
// value-returning helpers that forward the loan from their entry state into a
// later state. That later state transfers the loan nowhere: its exit arms read
// it last, so the loan must stay live into those arms.
//
//   record(&mut ledger.tally, 30, 10)   tally { hits 30, misses 10 }
//   total(&mut ledger.tally, 2)         later state, false arm   40
//   report(&mut ledger.tally, 1)        later state, true arm    { 10 }
//   height(&mut ledger, 1)              later state, true arm    ledger.height 0
//
// Exit 71: the scalar result is wrong. Exit 72: the record result is wrong.
// Exit 73: the whole-record loan read the wrong field. Expected exit: 70.

use omega_language_std::console;
use omega::language::core::binding;

data Tally { hits: i32 in Wrapping; misses: i32 in Wrapping; }
data Report { total: i32 in Wrapping; }
data Ledger { height: i32 in Wrapping; tally: Tally; }

machine Tally::record(tally: &mut Tally, hits: i32 in Wrapping, misses: i32 in Wrapping) {
    tally.hits = tally.hits + hits;
    tally.misses = tally.misses + misses;
}

machine Tally::total(tally: &mut Tally, pick: i32) -> i32 in Wrapping {
    transition pick == 0 {
        true -> (tally.hits)
        _ -> later(tally, pick)
    }

    state later(tally: &mut Tally, pick: i32) {
        transition pick == 1 {
            true -> (tally.misses)
            _ -> (tally.hits + tally.misses)
        }
    }
}

machine Tally::report(tally: &mut Tally, pick: i32) -> Report {
    transition pick == 0 {
        true -> (Report { total: tally.hits })
        _ -> later(tally, pick)
    }

    state later(tally: &mut Tally, pick: i32) {
        transition pick == 1 {
            true -> (Report { total: tally.misses })
            _ -> (Report { total: tally.hits + tally.misses })
        }
    }
}

machine Ledger::height(ledger: &mut Ledger, pick: i32) -> i32 in Wrapping {
    transition pick == 0 {
        true -> (ledger.tally.hits)
        _ -> later(ledger, pick)
    }

    state later(ledger: &mut Ledger, pick: i32) {
        transition pick == 1 {
            true -> (ledger.height)
            _ -> (ledger.tally.misses)
        }
    }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut ledger: Ledger;
    Tally::record(&mut ledger.tally, 30, 10);
    let both: i32 in Wrapping = Tally::total(&mut ledger.tally, 2);
    let report: Report = Tally::report(&mut ledger.tally, 1);
    let height: i32 in Wrapping = Ledger::height(&mut ledger, 1);
    transition both == 40 {
        true -> check_report(&main.console, report.total, height)
        _ -> done(&main.console, 71)
    }

    state check_report(console: &Binding<Console>, total: i32 in Wrapping, height: i32 in Wrapping) {
        transition total == 10 {
            true -> check_height(console, height)
            _ -> done(console, 72)
        }
    }

    state check_height(console: &Binding<Console>, height: i32 in Wrapping) {
        transition height == 0 {
            true -> done(console, 70)
            _ -> done(console, 73)
        }
    }

    state done(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
