// Binding a short-circuit value keeps exactly the selected call schedule.
machine record(value: &mut i32, replacement: i32, answer: bool) -> bool {
    value = replacement;
    answer
}

machine identity(value: bool) -> bool ensures result == value { value }

machine integer(value: i32) -> i32 ensures result == value { value }

machine evaluate() -> bool {
    // Its earlier carrier is independent of the later Boolean result.
    let unused: i32 = integer(70) + integer(1);
    true
}

machine main() crashes Trap {
    let evaluated: bool = evaluate();
    let mut observed: i32 = 0;
    let skipped_or: bool = record(&mut observed, 1, true) || record(&mut observed, 2, false);
    let first: i32 = observed;
    let skipped_and: bool = record(&mut observed, 3, false) && record(&mut observed, 4, true);
    let second: i32 = observed;
    let executed_or: bool = record(&mut observed, 5, false) || record(&mut observed, 6, true);
    let final_value: i32 = observed;
    let ignored: bool = identity(false) || identity(false);
    transition evaluated && first == 1 && second == 3 && final_value == 6 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
