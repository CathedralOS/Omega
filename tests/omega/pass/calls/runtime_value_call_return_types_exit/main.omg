// Value-returning calls (functions) across RETURN TYPES, the working core. A
// value-call is a method whose body is an expression (or value-arm transition),
// called in value position. This locks the cases that work:
//   - i32 return + multiple args
//   - STRUCT return (`-> Point { Point { .. } }`)
//   - ENUM return (`-> Tag { Tag::Found { .. } }`)
//   - bool return used in a guard
//   - a value-call result passed to another value-call VIA A LOCAL (the un-nested
//     form), e.g. `let inner = add(1,2); add(inner, 3)`.
//
// NOTE the un-nesting: a value-call written DIRECTLY as an argument to another
// VALUE-call -- `add(add(1,2), 3)` -- silently miscompiles (returns the inner result,
// not the outer). A value-call arg to a STATEMENT call works (the dungeon does this).
// The sound pattern is to bind the inner call to a local first. Exits 70.

use omega_language_std::console;

data Point {
    x: i32 in Trapping;
    y: i32 in Trapping;
}

data Tag {
    case Found(v: i32 in Trapping);
    case Missing;
}

data Main {
}

machine add(a: i32 in Wrapping, b: i32 in Wrapping) -> i32 in Wrapping {
    a + b
}
machine mk_point() -> Point {
    Point { x: 30, y: 12 }
}
machine mk_tag() -> Tag {
    Tag::Found { v: 28 }
}
machine positive(x: i32 in Trapping) -> bool {
    x > 0
}

machine Main::main(main: &mut Main) reaches Console {
    let s: i32 in Wrapping = add(30, 40);
    let p: Point = mk_point();
    let t: Tag = mk_tag();
    let b: bool = positive(5);
    let inner: i32 in Wrapping = add(1, 2);
    let nested: i32 in Wrapping = add(inner, 3);

    transition s == 70 { true -> check_point(main, p, t, b, nested) _ -> bad(main, 71) }

    machine check_point(main: &mut Main, p: Point, t: Tag, b: bool, nested: i32 in Wrapping) {
        transition p.x == 30 { true -> check_bool(main, t, b, nested) _ -> bad(main, 72) }
    }
    machine check_bool(main: &mut Main, t: Tag, b: bool, nested: i32 in Wrapping) {
        transition b { true -> check_nested(main, t, nested) _ -> bad(main, 73) }
    }
    machine check_nested(main: &mut Main, t: Tag, nested: i32 in Wrapping) {
        transition nested == 6 { true -> check_tag(main, t) _ -> bad(main, 74) }
    }
    machine check_tag(main: &mut Main, t: Tag) {
        transition t { Tag::Found { v } -> check_v(main, v) Tag::Missing -> bad(main, 75) }
    }
    machine check_v(main: &mut Main, v: i32 in Trapping) {
        transition v == 28 { true -> good(main) _ -> bad(main, 76) }
    }

    machine good(main: &mut Main) {
        Console::exit_process(70);
    }
    machine bad(main: &mut Main, code: i32 in Trapping) {
        Console::exit_process(code as i32);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
