data Counter { hits: u32 in Wrapping; }

machine produce(value: u32, counter: &mut Counter) -> u32
requires value <= 20
ensures result <= 20 {
    counter.hits = counter.hits + 1;
    value
}

machine accept(value: u32) -> u32
requires value <= 20 {
    value
}

machine main() crashes Trap {
    let mut counter: Counter = Counter { hits: 0 };
    let observed: u32 = accept(produce(7, &mut counter));
    transition observed == 7 && counter.hits == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
