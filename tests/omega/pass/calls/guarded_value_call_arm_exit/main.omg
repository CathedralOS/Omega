// GUARDED-ARM VALUE CALLS: `cond -> (call(args))` evaluates the call inside
// the selected arm, at its authored point -- no continuation state is
// synthesized, and the callee runs ONLY when the arm is taken. Both arms
// observed: pick(60) takes the true arm (dbl -> 120); pick(10) takes the
// else arm (raw 10, dbl NOT run). RUNS exit 70.
use omega_language_std::console;
data Main { }
machine dbl(x: i32) -> i32
requires
    0 <= x && x <= 1000;
{
    transition { _ -> (x + x) }
}
machine pick(x: i32) -> i32
requires
    0 <= x && x <= 1000;
{
    transition x > 50 { true -> (dbl(x)) _ -> (x) }
}
machine Main::main(main: &mut Main) reaches Console {
    let hot: i32 = pick(60);
    let cold: i32 = pick(10);
    transition hot == 120 {
        true -> check_cold(main, cold)
        _ -> bad(main)
    }
    machine check_cold(main: &mut Main, cold: i32) {
        transition cold == 10 { true -> good(main) _ -> bad(main) }
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(1); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
