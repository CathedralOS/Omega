// GUARDED-ARM VALUE CALLS: `cond -> (call(args))` evaluates the call inside
// the selected arm, at its authored point -- no continuation state is
// synthesized, and the callee runs ONLY when the arm is taken. Both arms
// observed: pick(60) takes the true arm (dbl -> 120); pick(10) takes the
// else arm (raw 10, dbl NOT run). RUNS exit 70.
use omega_language_std::console;
use omega::language::core::service;
data Main { console: Binding<Console>; }
machine dbl(x: i32 [0..=1000]) -> i32 {
    transition { _ -> (x + x) }
}
machine pick(x: i32 [0..=1000]) -> i32 {
    transition x > 50 { true -> (dbl(x)) _ -> (x) }
}
machine Main::main(&mut self) reaches Console {
    let hot: i32 = pick(60);
    let cold: i32 = pick(10);
    transition hot == 120 {
        true -> check_cold(cold)
        _ -> bad()
    }
    state check_cold(&mut self, cold: i32) {
        transition cold == 10 { true -> good() _ -> bad() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(1); }
}
