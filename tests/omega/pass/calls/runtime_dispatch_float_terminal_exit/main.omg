use omega::language::core::float_operations;

// RUN CANARY (exit 70) -- a dispatched value call whose terminal is a FLOAT
// place (`-> acc`, acc: f64). DISCOVERED SERVING 2026-07-10s while pinning
// the fence's delivery-place granularity: the matrix's "float terminals
// bail" row was STALE -- the place-copy serve (CopyRuntimeStorage) is
// type-agnostic, so a float PLACE terminal round-trips byte-exact (1.5 in,
// 1.5 out through the frame result slot). Float BINARY terminals
// (`-> acc + 0.5`) remain the bail row (the binary serve is integer-only).
use omega_language_std::console;
data Main { }
machine Main::pick(main: &mut Main, n: i32, acc: f64)
terminates by n -> Nat::Descending;
-> f64
{
    transition n > 0 { true -> pick(main, n - 1, acc) false -> leaf(main, acc) }
    state leaf(main: &mut Main, acc: f64) -> f64 { acc }
}
machine Main::main(main: &mut Main) reaches Console {
    let x: f64 = Main::pick(main, 2, 1.5);
    transition x > 1.0 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
