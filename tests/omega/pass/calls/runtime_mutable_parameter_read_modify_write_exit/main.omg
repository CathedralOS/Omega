use omega::language::std::console;

data Room {
    exit_count: u32 in Wrapping;
}

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    let rooms: [Room; 1] = [Room { exit_count: 0 }];
    let from_index: u64 = 0;

    self.bump(&mut rooms[from_index]);

    transition rooms[0].exit_count == 1 {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(191);
    }

    state bad(&mut self) {
        self.console.exit_process(192);
    }
}

machine Main::bump(&mut self, room: &mut Room) {
    room.exit_count = room.exit_count + 1;
}
