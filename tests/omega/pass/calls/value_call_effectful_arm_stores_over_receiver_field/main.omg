// State-BODIED arms: the selected arm mutates a field BEFORE returning the
// struct, and the caller stores that struct over its own `self.vec`.
// Checking plans `Main::main` as a composed state graph whose assignment
// displaces the old `vec` through a borrowed-storage window (move-out, store
// of the call result, discard of the displaced value); Psi lowering emits and
// Terminal verification reconstructs that window, and target lowering now
// realizes the `MoveStructuralField`/`StoreStructuralField` pair it used to
// stop at. This was a fail canary pinning that stop as
// `UnsupportedControlFlow`. The program was always valid, so it now pins the
// realization rather than the refusal.
data Vec2 { x: i32 in Wrapping; y: i32 in Wrapping; }
data Main {
    d: i32; hits: i32 in Wrapping; vec: Vec2; }
machine Main::delta(&mut self, d: i32) -> Vec2 {
    transition d == 1 { true -> pos() _ -> neg() }
    state pos(&mut self) -> Vec2 {
        self.hits = self.hits + 1;
        Vec2 { x: 3, y: 4 }
    }
    state neg(&mut self) -> Vec2 {
        self.hits = self.hits + 10;
        Vec2 { x: 7, y: 9 }
    }
}
machine Main::main(&mut self) {
    self.d = 1;
    self.vec = self.delta(self.d);
    transition self.vec.x == 3 { true -> chk_y() _ -> bad(71) }
    state chk_y(&mut self) {
        transition self.vec.y == 4 { true -> chk_hits() _ -> bad(72) }
    }
    state chk_hits(&mut self) {
        transition self.hits == 1 { true -> good() _ -> bad(73) }
    }
    state good(&mut self) { }
    state bad(&mut self, code: i32) { }
}
