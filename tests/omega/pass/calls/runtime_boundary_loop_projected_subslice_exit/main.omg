// Each iteration creates and completes its own mutable descriptor loan.
// The next iteration must not inherit its predecessor's expired loan.
use omega_language_std::console;

pub boundary trait Fill { machine fill(bytes: &mut [u8], value: u8); }
FillProvider satisfies Fill { Fill::fill = fill; }
machine fill(bytes: &mut [u8], value: u8) {
    transition bytes.len > 0 { true -> write(bytes, value) _ -> done() }
    state write(bytes: &mut [u8], value: u8) { bytes[0] = value; }
    state done() { }
}
data Main { bytes: [u8; 8]; start: u64 [0..=7]; }
machine Main::main(main: &mut Main) reaches Fill + Console {
    main.bytes[0] = 11;
    main.bytes[7] = 13;
    main.start = 2;
    transition { _ -> again(main) }
    state again(main: &mut Main) {
        transition main.start < 5 { true -> write(main) _ -> verify(main) }
    }
    state write(main: &mut Main) {
        Fill::fill(&mut main.bytes[main.start..7], 29);
        main.start = main.start + 1;
        transition { _ -> again(main) }
    }
    state verify(main: &mut Main) {
        transition main.bytes[0] == 11 && main.bytes[2] == 29
            && main.bytes[3] == 29 && main.bytes[4] == 29 && main.bytes[7] == 13 {
            true -> good()
            _ -> bad()
        }
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(71); }
}
