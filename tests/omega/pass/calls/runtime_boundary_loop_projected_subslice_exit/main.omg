// Each iteration creates and completes its own mutable descriptor loan.
// The next iteration must not inherit its predecessor's expired loan.
use omega_language_std::console;

public boundary trait Fill { machine fill(bytes: &mut [u8], value: u8) reaches; }
FillProvider satisfies Fill { Fill::fill = fill; }
machine fill(bytes: &mut [u8], value: u8) {
    transition bytes.len > 0 { true -> write(bytes, value) _ -> done() }
    machine write(bytes: &mut [u8], value: u8) { bytes[0] = value; }
    machine done() { }
}
data Main where start <= 7 { bytes: [u8; 8]; start: u64; }
machine Main::main(main: &mut Main) reaches Fill + Console {
    main.bytes[0] = 11;
    main.bytes[7] = 13;
    main.start = 2;
    transition { _ -> again(main) }
    machine again(main: &mut Main) {
        transition main.start < 5 { true -> write(main) _ -> verify(main) }
    }
    machine write(main: &mut Main) {
        Fill::fill(&mut main.bytes[main.start..7], 29);
        main.start = main.start + 1;
        transition { _ -> again(main) }
    }
    machine verify(main: &mut Main) {
        transition main.bytes[0] == 11 && main.bytes[2] == 29
            && main.bytes[3] == 29 && main.bytes[4] == 29 && main.bytes[7] == 13 {
            true -> good()
            _ -> bad()
        }
    }
    machine good() { Console::exit_process(70); }
    machine bad() { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Fill + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
