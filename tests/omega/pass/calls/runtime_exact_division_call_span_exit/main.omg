use omega_language_std::console;
use omega::language::core::binding;
machine observe(console: &mut Binding<Console>, value: u64, divisor: u64) -> bool
reaches Console
requires divisor > 0 {
    let quotient: u64 = value / divisor;
    console.write_byte(65);
    let remainder: u64 = value % divisor;
    console.write_line("");
    quotient == 28 && remainder == 8
}
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let result: bool = observe(&mut main.console, 288, 10);
    transition result { true -> good(main) false -> bad(main) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
