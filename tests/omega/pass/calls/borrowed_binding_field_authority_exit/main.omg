// A record may hold a borrowed `&Binding<R>` and supply it as explicit call
// authority, including from the value a cleanup hook receives.
use omega::language::core::binding;
use omega::language::core::drop;

pub boundary trait Character {
    machine echo(value: i32) -> i32 terminates;
}
CharacterImplementation satisfies Character {
    Character::echo = echo;
}
machine echo(value: i32) -> i32 { value }

data Holder<'loan> { character: &'loan Binding<Character>; offset: i32; }
machine shared_field(holder: &Holder) -> i32 reaches Character {
    Character::echo(holder.character, holder.offset)
}
machine exclusive_field(holder: &mut Holder) -> i32 reaches Character {
    holder.offset = 41;
    Character::echo(holder.character, holder.offset)
}

data Token<'loan> { character: &'loan Binding<Character>; value: i32; }
machine Token::drop(token: &mut Token<'loan>) reaches Character {
    token.value = Character::echo(token.character, token.value);
}

data Main { character: Binding<Character>; }
machine Main::main(main: &mut Main) reaches Character crashes Trap {
    let mut holder: Holder = Holder { character: &main.character, offset: 40 };
    let shared: i32 = shared_field(&holder);
    let exclusive: i32 = exclusive_field(&mut holder);
    let token: Token = Token { character: &main.character, value: 7 };
    transition shared == 40 && exclusive == 41 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
