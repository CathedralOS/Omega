// Expected exit: 0. Real memcpy returns caller-buffer values at every scalar width.
// Fixed-size inputs expose exact C storage; shared scalar loans may use narrower codecs.
use omega_language_std::calling;
use omega::language::core::external_binding;
use omega::language::core::float_operations;
data ScalarResultPolicies {}
data LinuxScalarResultPolicies {}
SnapshotCalling satisfies CallingPolicy { CallingPolicy::plan = snapshot_plan; }
boundary trait SnapshotU8: Calling<SnapshotCalling> {
    machine copy(value: &[u8; 1], count: u64) -> u8 requires count == 1;
}
linux_x86_64 machine snapshot_U8(value: &[u8; 1], count: u64) -> u8
satisfies SnapshotU8::copy via snapshot_binding()
requires count == 1;
NativeSnapshotU8 satisfies SnapshotU8 { SnapshotU8::copy = snapshot_U8; }
boundary trait SnapshotI8: Calling<SnapshotCalling> {
    machine copy(value: &[u8; 1], count: u64) -> i8 requires count == 1;
}
linux_x86_64 machine snapshot_I8(value: &[u8; 1], count: u64) -> i8
satisfies SnapshotI8::copy via snapshot_binding()
requires count == 1;
NativeSnapshotI8 satisfies SnapshotI8 { SnapshotI8::copy = snapshot_I8; }
boundary trait SnapshotU16: Calling<SnapshotCalling> {
    machine copy(value: &[u8; 2], count: u64) -> u16 requires count == 2;
}
linux_x86_64 machine snapshot_U16(value: &[u8; 2], count: u64) -> u16
satisfies SnapshotU16::copy via snapshot_binding()
requires count == 2;
NativeSnapshotU16 satisfies SnapshotU16 { SnapshotU16::copy = snapshot_U16; }
boundary trait SnapshotI16: Calling<SnapshotCalling> {
    machine copy(value: &[u8; 2], count: u64) -> i16 requires count == 2;
}
linux_x86_64 machine snapshot_I16(value: &[u8; 2], count: u64) -> i16
satisfies SnapshotI16::copy via snapshot_binding()
requires count == 2;
NativeSnapshotI16 satisfies SnapshotI16 { SnapshotI16::copy = snapshot_I16; }
