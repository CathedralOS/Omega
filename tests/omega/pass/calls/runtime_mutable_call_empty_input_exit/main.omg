// Variant of runtime_mutable_call_before_transition_args_exit pinning its
// authored failure path: empty input is EndOfInput(0), so both engines take
// the failure exit 72. EOF is distinct from a failed host read, which traps.
use omega_language_std::console;

data Loader where cursor <= 16383 {
    line: [u8; 8];
    tags: [u8; 16384] in Trapping;
    firsts: [u8; 16384] in Trapping;
    starts: [u64 in Wrapping; 16384] in Trapping;
    ends: [u64 in Wrapping; 16384] in Trapping;
    cursor: u64;
    tag: u8;
    first: u8;
    start: u64 in Wrapping;
    end: u64 in Wrapping;
}

machine Loader::fill(loader: &mut Loader) {
    transition loader.cursor < 16384 {
        true -> present(loader, loader.cursor)
        false -> absent(loader)
    }

    state present(loader: &mut Loader, index: u64)
    requires index <= 16383
    {
        // `tags`/`firsts` are `[u8; N] in Trapping`, so an element reads as
        // `u8 in Trapping` while `tag`/`first` are bare `u8`. A typed value
        // keeps its policy across a store, so dropping `Trapping` is spelled
        // rather than implicit. `starts`/`ends` need no cast: their elements
        // are already `u64 in Wrapping`, which is what `start`/`end` hold.
        loader.tag = loader.tags[index] as u8;
        loader.first = loader.firsts[index] as u8;
        loader.start = loader.starts[index];
        loader.end = loader.ends[index];
    }

    state absent(loader: &mut Loader) {
        loader.tag = 0;
        loader.first = 0;
        loader.start = 0;
        loader.end = 0;
    }
}

machine Loader::run(loader: &mut Loader) reaches Console {
    let observed: LineReadResult = block Console::read_line(&mut loader.line);
    transition observed {
        LineReadResult::LineComplete { count } -> bounded_input(loader, count)
        LineReadResult::EndOfInput { count } -> bounded_input(loader, count)
        LineReadResult::Full { count } -> bad(loader)
        LineReadResult::Invalid -> bad(loader)
    }
    state bounded_input(loader: &mut Loader, count: u64) {
        transition count >= 4 && count <= loader.line.len {
            true -> loaded_input(loader)
            false -> bad(loader)
        }
    }
    state loaded_input(loader: &mut Loader) {
        // The input bytes retain their bare policy. Select the destination's
        // future Trapping operations explicitly without changing their values.
        loader.tags[1] = loader.line[0] as u8 in Trapping;
        loader.firsts[1] = loader.line[1] as u8 in Trapping;
        loader.starts[1] = loader.line[2] as u64 in Wrapping;
        loader.ends[1] = loader.line[3] as u64 in Wrapping;
        loader.cursor = 1;
        Loader::fill(loader);
        transition { _ -> loaded(loader, loader.tag,
            loader.first,
            loader.start,
            loader.end
        ) }

    }

    state loaded(
        loader: &mut Loader,
        tag: u8,
        first: u8,
        start: u64 in Wrapping,
        end: u64 in Wrapping
    ) {
        transition tag == 5 && first == 27 && start == 33 && end == 44 {
            true -> good(loader)
            false -> bad(loader)
        }
    }

    state good(loader: &mut Loader) { Console::exit_process(70); }
    state bad(loader: &mut Loader) { Console::exit_process(72); }
}

data Main {
    loader: Loader;
}

machine Main::main(main: &mut Main) {
    block Loader::run(&mut main.loader);
}
