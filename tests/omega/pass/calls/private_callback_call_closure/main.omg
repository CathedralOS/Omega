use omega_language_std::calling;
use omega_language_std::console;
use omega::language::core::external_binding;

pub data CallbackPolicies { }
pub InitializerCalling satisfies CallingPolicy {
    CallingPolicy::plan = CallbackPolicies::initializer;
}
pub OnceCalling satisfies CallingPolicy {
    CallingPolicy::plan = CallbackPolicies::once;
}
pub ProcessIdCalling satisfies CallingPolicy {
    CallingPolicy::plan = CallbackPolicies::process_id;
}

macos_arm64 machine CallbackPolicies::process_id(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.has_result = true;
    plan.call.result = CallbackPolicies::result_word(4);
    BoundaryPlanResult::Accepted { plan: CallbackPolicies::finish(plan) }
}

macos_arm64 machine CallbackPolicies::initializer(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 0 && !signature.has_result {
        true -> accept()
        _ -> reject()
    }
    state accept() -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan;
        let mut callback: BoundaryEntryPlan = CallbackPolicies::finish(plan);
        // Placement is identical to the ordinary void(void) body, but its
        // clobber promise is not: the zero-work entry shortcut is inapplicable.
        callback.call.ordinary_clobbers.registers[9] = callback.call.ordinary_clobbers.registers[40];
        callback.call.ordinary_clobbers.registers[26] = callback.call.ordinary_clobbers.registers[41];
        callback.call.ordinary_clobbers.register_count = 40;
        BoundaryPlanResult::Accepted { plan: callback }
    }
    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "initializer must be void(void)" },
        }
    }
}

macos_arm64 machine CallbackPolicies::once(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 1 && signature.has_result
        && (signature.native_parameter_count == 1 || signature.native_parameter_count == 2)
        && signature.callback_demand_count <= 1 {
        true -> accept(signature)
        _ -> reject()
    }
    state accept(signature: BoundarySignature) -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan;
        plan.call.parameter_count = signature.native_parameter_count;
        plan.call.parameters[0] = CallbackPolicies::word(8, 0);
        plan.call.parameters[1] = CallbackPolicies::word(8, 1);
        plan.call.has_result = true;
        plan.call.result = CallbackPolicies::result_word(4);
        plan.call.callback_materialization_count = signature.callback_demand_count;
        plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
        plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
        BoundaryPlanResult::Accepted { plan: CallbackPolicies::finish(plan) }
    }
    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "invalid pthread_once telescope" },
        }
    }
}

machine CallbackPolicies::placed_word(bytes: u64, register: MachineRegister) -> ValuePlacement {
    let mut value: ValuePlacement;
    value.shape.class = AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = ValueLocation::Register {
        register: register,
        value_byte_offset: 0,
        byte_size: bytes,
    };
    value
}

machine CallbackPolicies::word(bytes: u64, register: u64) -> ValuePlacement {
    CallbackPolicies::placed_word(bytes, MachineRegister::Aarch64X { index: register })
}

machine CallbackPolicies::finish(output: BoundaryEntryPlan) -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan = output;
    plan.call.convention = CallingConvention::Aapcs64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.call.ordinary_clobbers.register_count = 42;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::Aarch64X { index: 6 };
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::Aarch64X { index: 7 };
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::Aarch64X { index: 9 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::Aarch64X { index: 10 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::Aarch64X { index: 11 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::Aarch64X { index: 12 };
    plan.call.ordinary_clobbers.registers[13] = MachineRegister::Aarch64X { index: 13 };
    plan.call.ordinary_clobbers.registers[14] = MachineRegister::Aarch64X { index: 14 };
    plan.call.ordinary_clobbers.registers[15] = MachineRegister::Aarch64X { index: 15 };
    plan.call.ordinary_clobbers.registers[16] = MachineRegister::Aarch64X { index: 16 };
    plan.call.ordinary_clobbers.registers[17] = MachineRegister::Aarch64X { index: 17 };
    plan.call.ordinary_clobbers.registers[18] = MachineRegister::Aarch64V { index: 0 };
    plan.call.ordinary_clobbers.registers[19] = MachineRegister::Aarch64V { index: 1 };
    plan.call.ordinary_clobbers.registers[20] = MachineRegister::Aarch64V { index: 2 };
    plan.call.ordinary_clobbers.registers[21] = MachineRegister::Aarch64V { index: 3 };
    plan.call.ordinary_clobbers.registers[22] = MachineRegister::Aarch64V { index: 4 };
    plan.call.ordinary_clobbers.registers[23] = MachineRegister::Aarch64V { index: 5 };
    plan.call.ordinary_clobbers.registers[24] = MachineRegister::Aarch64V { index: 6 };
    plan.call.ordinary_clobbers.registers[25] = MachineRegister::Aarch64V { index: 7 };
    plan.call.ordinary_clobbers.registers[26] = MachineRegister::Aarch64V { index: 16 };
    plan.call.ordinary_clobbers.registers[27] = MachineRegister::Aarch64V { index: 17 };
    plan.call.ordinary_clobbers.registers[28] = MachineRegister::Aarch64V { index: 18 };
    plan.call.ordinary_clobbers.registers[29] = MachineRegister::Aarch64V { index: 19 };
    plan.call.ordinary_clobbers.registers[30] = MachineRegister::Aarch64V { index: 20 };
    plan.call.ordinary_clobbers.registers[31] = MachineRegister::Aarch64V { index: 21 };
    plan.call.ordinary_clobbers.registers[32] = MachineRegister::Aarch64V { index: 22 };
    plan.call.ordinary_clobbers.registers[33] = MachineRegister::Aarch64V { index: 23 };
    plan.call.ordinary_clobbers.registers[34] = MachineRegister::Aarch64V { index: 24 };
    plan.call.ordinary_clobbers.registers[35] = MachineRegister::Aarch64V { index: 25 };
    plan.call.ordinary_clobbers.registers[36] = MachineRegister::Aarch64V { index: 26 };
    plan.call.ordinary_clobbers.registers[37] = MachineRegister::Aarch64V { index: 27 };
    plan.call.ordinary_clobbers.registers[38] = MachineRegister::Aarch64V { index: 28 };
    plan.call.ordinary_clobbers.registers[39] = MachineRegister::Aarch64V { index: 29 };
    plan.call.ordinary_clobbers.registers[40] = MachineRegister::Aarch64V { index: 30 };
    plan.call.ordinary_clobbers.registers[41] = MachineRegister::Aarch64V { index: 31 };
    plan.state.initial_regime = MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}

pub boundary trait Initializer: Calling<InitializerCalling> {
    machine call() reaches Console + ProcessId
    invokes Console;
    invokes ProcessId;
}

pub boundary trait ProcessId: Calling<ProcessIdCalling> {
    machine current() -> i32;
}

// Darwin declares getpid(void) -> pid_t, a signed 32-bit result. This import
// is used only in the callback, never by the application entry.
macos_arm64 machine process_id_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_getpid",
        },
    }
}
macos_arm64 machine process_id_leaf() -> i32
satisfies ProcessId::current
via process_id_binding();

// Darwin's public pthread_once_t is a long signature followed by eight opaque
// bytes on LP64. This package owns the foreign control representation.
pub data OnceControl { signature: u64; opaque: u64; }

pub boundary trait OnceRegistrar: Calling<OnceCalling> {
    machine execute<machine Handler>(control: &mut OnceControl, native callback initialize from Handler) -> i32
    where machine Handler satisfies Initializer::call;
    invokes Initializer;
}

trait ByteReader<T> {
    machine read(subject: &mut T) -> i32;
}
data ByteValue { character: i32; }
ReadByte satisfies ByteReader<ByteValue> {
    machine read(subject: &mut ByteValue) -> i32 { subject.character }
}
machine read_byte(reader: dyn ByteReader<ByteValue>, subject: &mut ByteValue) -> i32 {
    ByteReader::read(reader, subject)
}

machine emit(character: i32[0..=255]) reaches Console + ProcessId {
    let process: i32 = ProcessId::current();
    let mut byte: ByteValue = ByteValue { character: character };
    let selected: i32 = read_byte(ReadByte as dyn ByteReader<ByteValue>, &mut byte);
    transition process > 0 && selected == character {
        true -> write(character)
        _ -> failed()
    }
    state write(character: i32[0..=255]) { Console::write_byte(character); }
    state failed() { Console::exit_process(73); }
}

pub data Initialization { }
pub machine Initialization::call() satisfies Initializer::call reaches Console + ProcessId
invokes Console;
invokes ProcessId;
{
    Console::write("A");
    emit(10);
}

macos_arm64 machine once_binding() -> ForeignBinding<26, 13, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_pthread_once",
        },
    }
}

macos_arm64 machine once_leaf<machine Handler>(control: &mut OnceControl) -> i32
where machine Handler satisfies Initializer::call;
satisfies OnceRegistrar::execute
via once_binding();

data Main { control: OnceControl; first_status: i32; second_status: i32; }

machine Main::main(main: &mut Main) reaches OnceRegistrar + Initializer + Console + ProcessId
invokes OnceRegistrar;
invokes Console;
{
    initialize_control(&mut main.control);
    main.first_status = OnceRegistrar::execute<Initialization::call>(&mut main.control);
    main.second_status = OnceRegistrar::execute<Initialization::call>(&mut main.control);
    transition main.first_status == 0 && main.second_status == 0 {
        true -> done()
        _ -> failed()
    }
    state done() { }
    state failed() { Console::exit_process(71); }
}


machine CallbackPolicies::result_word(bytes: u64) -> ValuePlacement {
    CallbackPolicies::word(bytes, 0)
}

machine LinuxCallbackPolicies::word(bytes: u64, register: u64) -> ValuePlacement {
    transition register {
        0 -> CallbackPolicies::placed_word(bytes, MachineRegister::X86Rdi)
        1 -> CallbackPolicies::placed_word(bytes, MachineRegister::X86Rsi)
        2 -> CallbackPolicies::placed_word(bytes, MachineRegister::X86Rdx)
        3 -> CallbackPolicies::placed_word(bytes, MachineRegister::X86Rcx)
        4 -> CallbackPolicies::placed_word(bytes, MachineRegister::X86R8)
        _ -> CallbackPolicies::placed_word(bytes, MachineRegister::X86R9)
    }
}

machine LinuxCallbackPolicies::finish(output: BoundaryEntryPlan) -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan = output;
    plan.call.convention = CallingConvention::SystemVAMD64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.call.ordinary_clobbers.register_count = 25;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::X86Rsi;
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::X86Rdi;
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::X86R8;
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::X86R9;
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::X86R10;
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::X86R11;
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::X86Xmm { index: 0 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::X86Xmm { index: 1 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::X86Xmm { index: 2 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::X86Xmm { index: 3 };
    plan.call.ordinary_clobbers.registers[13] = MachineRegister::X86Xmm { index: 4 };
    plan.call.ordinary_clobbers.registers[14] = MachineRegister::X86Xmm { index: 5 };
    plan.call.ordinary_clobbers.registers[15] = MachineRegister::X86Xmm { index: 6 };
    plan.call.ordinary_clobbers.registers[16] = MachineRegister::X86Xmm { index: 7 };
    plan.call.ordinary_clobbers.registers[17] = MachineRegister::X86Xmm { index: 8 };
    plan.call.ordinary_clobbers.registers[18] = MachineRegister::X86Xmm { index: 9 };
    plan.call.ordinary_clobbers.registers[19] = MachineRegister::X86Xmm { index: 10 };
    plan.call.ordinary_clobbers.registers[20] = MachineRegister::X86Xmm { index: 11 };
    plan.call.ordinary_clobbers.registers[21] = MachineRegister::X86Xmm { index: 12 };
    plan.call.ordinary_clobbers.registers[22] = MachineRegister::X86Xmm { index: 13 };
    plan.call.ordinary_clobbers.registers[23] = MachineRegister::X86Xmm { index: 14 };
    plan.call.ordinary_clobbers.registers[24] = MachineRegister::X86Xmm { index: 15 };
    plan.state.initial_regime = MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}

machine LinuxCallbackPolicies::result_word(bytes: u64) -> ValuePlacement {
    CallbackPolicies::placed_word(bytes, MachineRegister::X86Rax)
}

data LinuxCallbackPolicies {}


linux_x86_64 machine CallbackPolicies::process_id(signature: BoundarySignature) -> BoundaryPlanResult
{
    let mut plan: BoundaryEntryPlan;
    plan.call.has_result = true;
    plan.call.result = LinuxCallbackPolicies::result_word(4);
    BoundaryPlanResult::Accepted { plan: LinuxCallbackPolicies::finish(plan) }
}

linux_x86_64 machine CallbackPolicies::initializer(signature: BoundarySignature) -> BoundaryPlanResult
{
    transition signature.parameter_count == 0 && !signature.has_result {
        true -> accept()
        _ -> reject()
    }
    state accept() -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan;
        let mut callback: BoundaryEntryPlan = LinuxCallbackPolicies::finish(plan);
        // Preserve R10 across this callback; the ordinary helper still has
        // the complete volatile register bank.
        callback.call.ordinary_clobbers.registers[7] = callback.call.ordinary_clobbers.registers[24];
        callback.call.ordinary_clobbers.register_count = 24;
        BoundaryPlanResult::Accepted { plan: callback }
    }
    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "initializer must be void(void)" },
        }
    }
}

linux_x86_64 machine CallbackPolicies::once(signature: BoundarySignature) -> BoundaryPlanResult
{
    transition signature.parameter_count == 1 && signature.has_result
        && (signature.native_parameter_count == 1 || signature.native_parameter_count == 2)
        && signature.callback_demand_count <= 1 {
        true -> accept(signature)
        _ -> reject()
    }
    state accept(signature: BoundarySignature) -> BoundaryPlanResult {
        let mut plan: BoundaryEntryPlan;
        plan.call.parameter_count = signature.native_parameter_count;
        plan.call.parameters[0] = LinuxCallbackPolicies::word(8, 0);
        plan.call.parameters[1] = LinuxCallbackPolicies::word(8, 1);
        plan.call.has_result = true;
        plan.call.result = LinuxCallbackPolicies::result_word(4);
        plan.call.callback_materialization_count = signature.callback_demand_count;
        plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
        plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
        BoundaryPlanResult::Accepted { plan: LinuxCallbackPolicies::finish(plan) }
    }
    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "invalid pthread_once telescope" },
        }
    }
}

linux_x86_64 machine linux_process_id_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "getpid", version: "GLIBC_2.2.5",
        },
    }
}

linux_x86_64 machine process_id_leaf() -> i32
satisfies ProcessId::current
via linux_process_id_binding();


linux_x86_64 machine linux_once_binding() -> ForeignBinding<9, 12, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "pthread_once", version: "GLIBC_2.34",
        },
    }
}

linux_x86_64 machine once_leaf<machine Handler>(control: &mut OnceControl) -> i32
where machine Handler satisfies Initializer::call;
satisfies OnceRegistrar::execute
via linux_once_binding();

macos_arm64 machine initialize_control(control: &mut OnceControl) {
    control.signature = 0x30B1BCBA;
    control.opaque = 0;
}
// glibc pthread_once_t is an initially zero 32-bit word. The shared carrier
// provides that word as its prefix; its remaining bytes are unused on Linux.
linux_x86_64 machine initialize_control(control: &mut OnceControl) {
    control.signature = 0;
    control.opaque = 0;
}
