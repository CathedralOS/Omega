// A static machine lends its own zero-initialized local byte array to other
// machines through borrowed byte views. The same local backing passes as
// `&mut [u8]` to a Unit-result writer, as `&[u8]` to a scalar-result reader,
// and as `&mut [u8]` to the structural-result Console reader; each callee
// sees the array's exact four-byte extent and every write lands in the
// caller's storage. `input.txt` supplies the line. Exits 70 only when every
// loan observed and updated the one local array.

use omega_language_std::console;

machine stamp(bytes: &mut [u8]) {
    transition bytes.len > 1 {
        true -> write(bytes)
        _ -> skip()
    }

    state write(bytes: &mut [u8]) {
        bytes[1] = 5;
    }

    state skip() { }
}

machine peek(bytes: &[u8], position: u64) -> u64 {
    transition position < bytes.len {
        true -> read(bytes, position)
        _ -> (0)
    }

    state read(bytes: &[u8], position: u64) -> u64 {
        let value: u8 = bytes[position];
        transition { _ -> (value as u64) }
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut buffer: [u8; 4];
    stamp(&mut buffer);
    let seen: u64 = peek(&buffer, 1);
    let line: LineReadResult = block Console::read_line(&mut buffer);
    let first: u64 = peek(&buffer, 0);
    let second: u64 = peek(&buffer, 1);
    transition line {
        LineReadResult::LineComplete { count } -> check(seen, count, first, second)
        _ -> refused(71)
    }

    state check(seen: u64, count: u64, first: u64, second: u64) {
        transition seen == 5 && count == 3 && first == 97 && second == 98 {
            true -> done()
            _ -> refused(72)
        }
    }

    state done() {
        Console::exit_process(70);
    }

    state refused(code: i32) {
        Console::exit_process(code);
    }
}
