// A call in operand position applies an exact boundary-trait requirement
// exactly as a statement call does: directly, through a forwarded machine and
// through a nested operand.

public boundary trait Character {
    machine echo(value: i32) -> i32 reaches;
}
CharacterImplementation satisfies Character {
    Character::echo = echo;
}
machine echo(value: i32) -> i32 { value }

machine inner(value: i32) -> i32 reaches Character {
    Character::echo(value)
}
machine outer(value: i32) -> i32 reaches Character {
    Character::echo(value)
}
machine relay() -> i32 reaches Character {
    outer(inner(20))
}

data Main { }
machine Main::main(main: &mut Main) reaches Character crashes Trap {
    let direct: i32 = outer(inner(10));
    let forwarded: i32 = relay();
    let borrowed: i32 = outer(inner(30));
    transition direct == 10 && forwarded == 20 && borrowed == 30 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Character crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
