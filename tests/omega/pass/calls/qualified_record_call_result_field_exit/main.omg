use omega_language_std::console;

domain [u8; 3]::Utf8(bytes) requires valid_utf8(bytes);
data Leaf [copy] { name: [u8; 3] in Utf8; value: u64 in Wrapping; }
data Destination [copy] { first: Leaf; second: Leaf; guard: u64; }
data Builder { generated: u64 in Wrapping; }
data Main { builder: Builder; destination: Destination; }

machine Builder::make(builder: &mut Builder) -> Leaf {
    builder.generated = builder.generated + 1;
    let leaf: Leaf;
    leaf.name = "bat";
    leaf.value = builder.generated;
    transition { _ -> leaf }
}

machine Builder::install(builder: &mut Builder, destination: &mut Destination) {
    destination.first = Builder::make(builder);
    destination.second = Builder::make(builder);
}

machine Main::main(main: &mut Main) reaches Console {
    main.destination.guard = 9;
    Builder::install(&mut main.builder, &mut main.destination);
    transition main.destination.first.name == "bat"
        && main.destination.first.name.len == 3
        && main.destination.first.value == 1
        && main.destination.second.name == "bat"
        && main.destination.second.value == 2
        && main.destination.guard == 9
        && main.builder.generated == 2 {
        true -> finish(main, 70)
        false -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
