// A static machine keeps its tally in an ordinary local and lends the whole
// local `&mut` to a machine that updates it and returns a fresh `Report`.
// The report holds only plain numeric fields, so it cannot retain the loan:
// each loan ends with its call, the second call sees the first call's write,
// and the local is whole again for the reads that follow. Exits 70 only when
// both reports and the caller's own local agree.

use omega_language_std::console;
use omega::language::core::binding;

data Tally { hits: i32 in Wrapping; misses: i32 in Wrapping; }
data Report { total: i32 in Wrapping; }

machine Tally::record(tally: &mut Tally, hits: i32 in Wrapping, misses: i32 in Wrapping) -> Report {
    tally.hits = tally.hits + hits;
    tally.misses = tally.misses + misses;
    transition { _ -> (Report { total: tally.hits + tally.misses }) }
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut tally: Tally;
    let first: Report = Tally::record(&mut tally, 30, 0);
    let second: Report = Tally::record(&mut tally, 0, 10);
    transition first.total == 30 && second.total == 40 && tally.hits == 30 && tally.misses == 10 {
        true -> done(&main.console, 70)
        _ -> done(&main.console, 71)
    }

    state done(console: &Binding<Console>, code: i32) {
        Console::exit_process(console, code);
    }
}
