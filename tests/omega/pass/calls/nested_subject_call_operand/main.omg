// Arguments evaluate left to right: the nested call releases its mutable
// loan before the outer call's later argument borrows the same record.
// Reversing those arguments rejects in static_subject_delayed_loan.

data Main { hits: u64 in Wrapping; }

machine Main::bump(value: u64 in Wrapping, main: &mut Main) -> u64 in Wrapping {
    main.hits = main.hits + 1;
    value + 1
}

machine Main::main(main: &mut Main) -> u64 in Wrapping {
    Main::bump(Main::bump(3, main), main)
}
