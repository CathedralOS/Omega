// WALL-POSITION PIN: the api census's "nested calls require a direct
// initializer or Unit call root" gate (emission/call_source_custody/authored/
// nested.rs statement-root arm) is already dead for every census shape —
// tail calls returning the state's non-Unit type now mint their root. Each
// shape below declines at a deeper wall instead, and this fixture pins the
// first one:
//   * tails passing `&item_list.items[i]` — InvalidStructuralArgumentPath in
//     terminal-psi verification (indexed-member borrow argument paths)
//   * `x.f()` / `wrap.f[i].f()` subject tails — StructuralCallContractMismatch
//     in abstract-operations initial validation
//   * calls as or inside transition Value targets with runtime indexes — the
//     authored walk's Indexed arm now admits runtime selectors (nested.rs);
//     these shapes instead reach StructuralCallContractMismatch in omega-side
//     abstract-operations InitialValidation (see
//     nested_call_runtime_index_arg_exit)
//   * case-payload parameters used as receivers — past "Unit graph
//     case-payload subject type drifted"; arm-bound payload dispatch
//     (`Has { list } -> at(list)`) verifies — see named_target_payload_dispatch
//   * `let w = Wrap::Has { .. }` — the whole-sum establishment now admits as
//     a completed-source argument (the prior UnknownStructuralArgument wall
//     is dead), and this fixture's current wall is instead
//     UnsupportedStructuralCase: EstablishStructuralCase has no abstract-
//     operations variant (contract-slot lane)
// Landed as evidence for the census family; revisit as each wall opens.

use omega_language_std::console;

data Item {
    x: i32;
}

machine Item::clone(source: &Item) -> Item {
    Item { x: source.x }
}

machine Item::default() -> Item {
    Item { x: 0 }
}

data ItemList {
    items: [Item; 64];
    count: u64;
}

machine ItemList::get(item_list: &ItemList, position: u64) -> Item {
    transition position < item_list.count && position < 64 {
        true -> clone_at(item_list, position)
        false -> (Item::default())
    }
    state clone_at(item_list: &ItemList, position: u64) -> Item {
        Item::clone(&item_list.items[position])
    }
}

machine ItemList::get_count(item_list: &ItemList) -> u64 {
    item_list.count
}

data Holder {
    list: ItemList;
}

// receiver-form tail on a member-path field, structural return
machine Holder::get(holder: &Holder, position: u64) -> Item {
    ItemList::get(&holder.list, position)
}

// receiver-form tail on a member-path field, scalar return
machine Holder::get_count(holder: &Holder) -> u64 {
    ItemList::get_count(&holder.list)
}

// call spelled directly as a transition Value target
machine Holder::get_cursor(holder: &Holder, index: u64) -> Item {
    transition index < 64 {
        true -> (Item::clone(&holder.list.items[index]))
        false -> (Item::default())
    }
}

data Parse {
    case Parsed(value: Item);
    case Refused;
}

// call nested inside a case-payload constructor in a Value target
machine Holder::parse(holder: &Holder, index: u64) -> Parse {
    transition index < 64 && index < holder.list.count {
        true -> (Parse::Parsed { value: Item::clone(&holder.list.items[index]) })
        false -> (Parse::Refused)
    }
}

data Wrap {
    case Has(list: ItemList);
    case Empty;
}

// case-payload parameter used as a call receiver, scalar tail
machine Wrap::get_count(wrap: &Wrap) -> u64 {
    transition wrap {
        Wrap::Has { list } -> at(list)
        _ -> (0)
    }
    state at(list: &ItemList) -> u64 {
        ItemList::get_count(list)
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let holder: Holder = Holder { list: ItemList { count: 1 } };
    let out: Item = Holder::get(&holder, 0);
    let n: u64 = Holder::get_count(&holder);
    let c: Item = Holder::get_cursor(&holder, 0);
    let p: Parse = Holder::parse(&holder, 0);
    let w: Wrap = Wrap::Has { list: ItemList { count: 2 } };
    let m: u64 = Wrap::get_count(&w);
    transition {
        _ -> done(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}
