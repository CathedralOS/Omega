data Tag [copy] { case Empty; case Selected; }
data Output [copy] { value: u64; }
data Marker [copy] { value: u64; }

machine write(first: Marker, tag: Tag, value: &mut i32, values: [u64; 2], last: Marker) {
    transition first.value == 3 && tag == Tag::Selected && values[1] == 13 && last.value == 5 {
        true -> selected(value)
        false -> done()
    }
    machine selected(value: &mut i32) { value = 7; }
    machine done() {}
}

machine inspect(first: Marker, tag: Tag, values: [u64; 2], last: Marker) -> bool {
    first.value == 3 && tag == Tag::Selected && values[0] == 11
        && values[1] == 13 && last.value == 5
}

machine make(first: Marker, tag: Tag, values: [u64; 2], last: Marker) -> Output {
    transition first.value == 3 && tag == Tag::Selected && last.value == 5 {
        true -> Output { value: values[1] }
        false -> Output { value: 0 }
    }
}

machine main() crashes Trap {
    let mut value: i32 = 0;
    let first: Marker = Marker { value: 3 };
    let last: Marker = Marker { value: 5 };
    let values: [u64; 2] = [11, 13];
    write(first, Tag::Selected, &mut value, values, last);
    let written: bool = value == 7 && first.value == 3 && last.value == 5;
    let inspected: bool = inspect(first, Tag::Selected, values, last);
    let output: Output = make(first, Tag::Selected, values, last);
    transition written && inspected && output.value == 13 && value == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
