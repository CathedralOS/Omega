use omega_language_std::console;

data Buffer {
    bytes: [u8; 16] in Trapping;
    length: u64;
    ready: bool;
}

data Token [copy] {
    start: u64;
    case Empty;
    case Full(value: u64);
}

data Workspace {
    source: Buffer;
    output: Buffer;
    tokens: [Token; 2] in Trapping;
    cursor: u64 in Trapping;
}

data Main { }

machine Buffer::initialize(buffer: &mut Buffer, length: u64) {
    buffer.length = length;
    buffer.ready = true;
}

machine Workspace::initialize(workspace: &mut Workspace, length: u64) {
    Buffer::initialize(&mut workspace.source, length);
    Buffer::initialize(&mut workspace.output, length);
    workspace.cursor = 0;
}

machine Main::main(context: &mut Main) reaches Console {
    let mut workspace: Workspace;
    Workspace::initialize(&mut workspace, 35);
    transition workspace.output.ready {
        true -> project(context, &workspace)
        _ -> rejected(context)
    }

    state project(context: &mut Main, workspace: &Workspace) {
        transition { _ -> observe(context, &workspace.source, &workspace.output) }
    }

    state observe(context: &mut Main, source: &Buffer, output: &Buffer) {
        transition source.length == 35 && output.length == 35 {
            true -> accepted(context)
            _ -> rejected(context)
        }
    }

    state accepted(context: &mut Main) { Console::exit_process(70); }
    state rejected(context: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
