// The nested-value-call guard-ZII miscompile, pinned FIXED (promoted from
// tests/omega/pending/calls/nested_value_call_guard_zii): an inlined callee
// that TRANSITIONS on a nested sibling call's result must read the WRITTEN
// result, not the slot's pre-store ZII tag. Root cause: a bare-call binding
// (`let since = Duration::checked_subtract(..)`) whose local ALSO had storage
// minted a call-result slot carrying the SAME name -- the guarded arms'
// terminal writes re-resolve the slot by NAME and landed in whichever slot
// matched first, so the guard read the other slot's ZII.
//
// Every leg here asserts a NON-ZII arm (the designed-false discrimination
// lesson: the ZII-coinciding arms pass under both correct and buggy
// emission):
//   1. saturating_subtract forward pair -> exact Ok value (ZII would be ZERO)
//   2. is_greater_than on a > b -> true   (Ordering ZII = Less -> false)
//   3. is_less_than on a > b   -> false  (guard-ZII Less would say true)
//   4. saturating_add unclamped -> exact sum (ZII DurationResult = Overflow
//      -> would clamp to MAX)
// Expected exit: 70.
use omega_language_std::time;

use omega_language_std::console;

data Main {
}

machine Main::main(context: &mut Main) reaches Console {
    let first: Duration = Duration { seconds: 5, subsecond_nanoseconds: 400000000 };
    let second: Duration = Duration { seconds: 2, subsecond_nanoseconds: 100000000 };
    let elapsed: Duration = Duration::saturating_subtract(&first, second);
    transition elapsed.seconds == 3 {
        true -> check_sub_nanos(context, first, second, elapsed.subsecond_nanoseconds)
        false -> fail_sub_seconds(context)
    }
    state check_sub_nanos(context: &mut Main, first: Duration, second: Duration, nanoseconds: u32) {
        transition nanoseconds == 300000000 {
            true -> check_greater(context, first, second)
            false -> fail_sub_nanos(context)
        }
    }
    state check_greater(context: &mut Main, first: Duration, second: Duration) {
        let greater: bool = Duration::is_greater_than(&first, second);
        transition greater {
            true -> check_less(context, first, second)
            false -> fail_greater(context)
        }
    }
    state check_less(context: &mut Main, first: Duration, second: Duration) {
        let less: bool = Duration::is_less_than(&first, second);
        transition less {
            true -> fail_less(context)
            false -> check_add(context, first, second)
        }
    }
    state check_add(context: &mut Main, first: Duration, second: Duration) {
        let total: Duration = Duration::saturating_add(&first, second);
        transition total.seconds == 7 {
            true -> check_add_nanos(context, total.subsecond_nanoseconds)
            false -> fail_add_seconds(context)
        }
    }
    state check_add_nanos(context: &mut Main, nanoseconds: u32) {
        transition nanoseconds == 500000000 {
            true -> good(context)
            false -> fail_add_nanos(context)
        }
    }
    state good(context: &mut Main) { Console::exit_process(70); }
    state fail_sub_seconds(context: &mut Main) { Console::exit_process(1); }
    state fail_sub_nanos(context: &mut Main) { Console::exit_process(2); }
    state fail_greater(context: &mut Main) { Console::exit_process(3); }
    state fail_less(context: &mut Main) { Console::exit_process(4); }
    state fail_add_seconds(context: &mut Main) { Console::exit_process(5); }
    state fail_add_nanos(context: &mut Main) { Console::exit_process(6); }
}
