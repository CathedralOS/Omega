use omega_language_std::console;
use omega::language::core::binding;

data Payload { value: i32; }

machine identity(payload: Payload) -> Payload { payload }

machine forward(payload: Payload, selected: bool) -> i32 {
    transition selected {
        true -> take(identity(payload))
        false -> take(Payload { value: 71 })
    }
    state take(payload: Payload) -> i32 { payload.value }
}

machine mark_value(console: &Binding<Console>, value: i32) -> i32 reaches Console {
    Console::write_byte(console, value);
    value
}

machine mark_selection(console: &Binding<Console>, marker: i32, selected: bool) -> bool reaches Console {
    Console::write_byte(console, marker);
    selected
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let selected: i32 = forward(Payload { value: mark_value(&main.console, 70) }, mark_selection(&main.console, 84, true));
    let unselected: i32 = forward(Payload { value: mark_value(&main.console, 72) }, mark_selection(&main.console, 78, false));
    transition selected == 70 && unselected == 71 {
        true -> good(&main.console)
        false -> bad(&main.console)
    }
    state good(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state bad(console: &Binding<Console>) { Console::exit_process(console, 72); }
}
