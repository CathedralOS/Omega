// Calls borrow an arm-bound payload and forward the scalar argument.
// Leaf observes its own stored value; Empty observes the forwarded argument.
// Both results must agree before the hosted program exits 70.

use omega_language_std::console;

data Payload {
    case Leaf(value: u64);
    case Empty;
}

machine Payload::read_at(payload: &Payload, at: u64) -> u64 {
    transition payload {
        Payload::Leaf { value } -> (value)
        Payload::Empty -> (at)
    }
}

data Sum {
    case Found(p: Payload);
    case Missing;
}

machine Sum::probe(sum: &Sum, position: u64) -> u64 {
    transition sum {
        Sum::Found { p } -> (Payload::read_at(&p, position))
        Sum::Missing -> (0)
    }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let s: Sum = Sum::Found { p: Payload::Leaf { value: 69 } };

    let empty: Sum = Sum::Found { p: Payload::Empty };

    transition Sum::probe(&s, 1) == 69 && Sum::probe(&empty, 70) == 70 {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
