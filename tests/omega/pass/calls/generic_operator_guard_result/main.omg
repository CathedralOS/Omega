operator identity<T>(value: T) -> T;
operator second<A, B>(left: A, right: B) -> B;
data Context { integer: i32; real: f64; }
machine inspect(context: &Context, value: i32) {
    let local: i32 = value;
    let control: i32 = identity<i32>(value);
    transition identity<i32>(value) == control && identity(local) == control
        && identity(context.integer) == control {
        true -> another(context, value)
        false -> done()
    }
    machine another(context: &Context, value: i32) {
        transition second<i32, f64>(value, context.real) == context.real
            && second(value, context.real) == context.real {
            true -> done()
            false -> done()
        }
    }
    machine done() {}
}
machine main() {}
