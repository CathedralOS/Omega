// Element-argument type checking at static machine-call boundaries:
// a value call binding an element-view argument whose element type AGREES with
// the callee's declared parameter checks cleanly -- both a forwarded view
// local (`walk(view)`) and an owned local-array lend (`walk(&items)`). The
// element-view argument check only compares concrete element types; the
// matching shapes it must keep admitting exercise both the slice-view and
// fixed-array element extraction.
// Both paths must return the final element, not merely accept the argument.

machine walk(values: &[i32 in Wrapping]) -> i32
terminates by values -> Slice::Length;
{
    transition { _ -> scan(values) }

    machine scan(values: &[i32 in Wrapping]) -> i32 {
        transition values.len > 0 {
            true -> emit(values[0], values[1..])
            false -> done()
        }
    }

    machine emit(element: i32 in Wrapping, values: &[i32 in Wrapping]) -> i32 {
        transition values.len > 0 {
            true -> emit(values[0], values[1..])
            false -> (element as i32)
        }
    }

    machine done() -> i32 { (0) }
}

machine main() crashes Trap {
    let mut items: [i32 in Wrapping; 4];
    items[0] = 5;
    items[1] = 10;
    items[2] = 15;
    items[3] = 20;

    let view: &[i32 in Wrapping] = &items[..];
    let from_view: i32 = walk(view);
    let from_array: i32 = walk(&items);

    transition from_view == 20 {
        true -> check_array(from_array)
        _ -> bad()
    }

    machine check_array(result: i32) {
        transition result == 20 {
            true -> good()
            _ -> bad()
        }
    }

    machine good() {}
    machine bad() { crash Trap; }
}
