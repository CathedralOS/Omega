// COMPILE CANARY (element-argument type checking at machine-call boundaries):
// a value call binding an element-view argument whose element type AGREES with
// the callee's declared parameter checks cleanly -- both a forwarded view
// local (`walk(s)`) and an owned-array lend (`walk(&self.arr)`). The
// element-view argument check only compares concrete element types; the
// matching shapes it must keep admitting exercise both the slice-view and
// fixed-array element extraction.

data Walker {}

data Main {
    arr: [i32 in Wrapping; 4];
    walker: Walker;
}

machine Walker::walk(&mut self, s: &[i32 in Wrapping]) -> i32
terminates by s -> Slice::Length;
{
    transition { _ -> scan(s) }

    state scan(s: &[i32 in Wrapping]) -> i32 {
        transition s.len > 0 {
            true -> emit(s[0], s[1..])
            false -> done()
        }
    }

    state emit(b: i32 in Wrapping, s: &[i32 in Wrapping]) -> i32 {
        transition s.len > 0 {
            true -> emit(s[0], s[1..])
            false -> done()
        }
    }

    state done() -> i32 { (0) }
}

machine Main::main(&mut self) {
    self.arr[0] = 5;
    self.arr[1] = 10;
    self.arr[2] = 15;
    self.arr[3] = 20;

    let s: &[i32 in Wrapping] = self.arr.as_slice();
    let n: i32 = self.walker.walk(s);
    let m: i32 = self.walker.walk(&self.arr);

    transition n == 0 {
        true -> count(m)
        _ -> bad()
    }

    state count(&mut self, r: i32) {
        transition r == 0 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {}
    state bad(&mut self) {}
}
