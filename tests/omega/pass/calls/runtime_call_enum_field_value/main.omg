// A call result lands in a carrier's enum field as a runtime value:
// `reward.item = self.pick()`. The deployable shape matches the sibling
// runtime canaries: the stored case is checked in a guard ladder and the
// process exits 70 only when exact.

use omega_language_std::console;
use omega::language::core::binding;

data ItemKind {
    case RustedDagger;
    case DeepKey;
}

data Reward {
    item: ItemKind
}

data Main {
    console: Binding<Console>;
    reward: Reward;
}

machine Main::main(&mut self) reaches Console {
    self.reward.item = self.pick();

    transition self.reward.item == ItemKind::DeepKey {
        true -> good()
        false -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

machine Main::pick(&mut self) -> ItemKind {
    ItemKind::DeepKey
}
