// Runtime (non-constant) exit code: `exit_process(self.v)` where `self.v` is a
// computed i32 field, not a compile-time literal. Previously the encoder ignored a
// runtime-storage operand and the process silently exited 0; now the exit-code
// register is loaded from the value's storage slot. Computes 5 + 65 = 70 and exits
// with that exact value (so a passing run is exit code 70, NOT 0 and NOT a literal).

use omega_language_std::console;

data Main {
    console: Console;
    v: i32;
}

machine Main::main(&mut self) {
    self.v = 5;
    self.v = self.v + 65; // 70, a runtime value (not constant-folded into the call)
    self.console.exit_process(self.v);
}
