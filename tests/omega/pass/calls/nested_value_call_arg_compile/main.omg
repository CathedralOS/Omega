// COMPILE CANARY (promoted from fail/ when the checked tree admitted
// nested initializer calls): a machine call nested as a bound value-call's
// argument (`let out = self.double(self.inc(3))`) checks cleanly.
use omega_language_std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
}
machine Main::inc(&self, x: i32) -> i32
    requires 0 <= x && x <= 10
    ensures 1 <= result && result <= 11
{
    transition { _ -> (x + 1) }
}
machine Main::double(&self, x: i32) -> i32
    requires 0 <= x && x <= 20
{
    transition { _ -> (x + x) }
}
machine Main::main(&mut self) reaches Console
{
    let out: i32 = self.double(self.inc(3));
    transition out == 8 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self)
    { self.console.exit_process(1); }
    state no(&mut self)
    { self.console.exit_process(2); }
}
