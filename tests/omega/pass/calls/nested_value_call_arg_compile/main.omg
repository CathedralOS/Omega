// COMPILE CANARY (promoted from fail/ when the checked tree admitted
// nested initializer calls): a machine call nested as a bound value-call's
// argument (`let out = double(inc(3))`) checks cleanly.
use omega_language_std::console;
data Main {
}
machine inc(x: i32) -> i32
    requires 0 <= x && x <= 10
    ensures 1 <= result && result <= 11
{
    transition { _ -> (x + 1) }
}
machine double(x: i32) -> i32
    requires 0 <= x && x <= 20
{
    transition { _ -> (x + x) }
}
machine Main::main(main: &mut Main) reaches Console
{
    let out: i32 = double(inc(3));
    transition out == 8 {
        true -> yes(main)
        false -> no(main)
    }
    state yes(main: &mut Main)
    { Console::exit_process(1); }
    state no(main: &mut Main)
    { Console::exit_process(2); }
}
