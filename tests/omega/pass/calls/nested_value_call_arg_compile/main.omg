// COMPILE CANARY (promoted from fail/ when the checked tree admitted
// nested initializer calls): a machine call nested as a bound value-call's
// argument (`let out = self.double(self.inc(3))`) checks cleanly.
use omega_language_std::console;
data Main {
    console: Console;
}
machine Main::inc(&self, x: i32 [0..=10]) -> i32 {
    let r: i32 [1..=11] = x + 1;
    transition { _ -> r }
}
machine Main::double(&self, x: i32 [0..=20]) -> i32 {
    let r: i32 [0..=40] = x + x;
    transition { _ -> r }
}
machine Main::main(&mut self) reaches Console {
    let out: i32 = self.double(self.inc(3));
    transition out == 8 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
