use omega_language_std::calling;
use omega::language::core::external_binding;

public data InitializerPolicy { }
public InitializerCalling satisfies CallingPolicy {
    CallingPolicy::plan = InitializerPolicy::plan;
}

machine InitializerPolicy::plan(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 0 && !signature.has_result {
        true -> accept()
        _ -> reject()
    }
    state accept() -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::SystemVAMD64;
        output.call.stack_alignment = 16;
        output.call.entry_control = EntryControl::CallReturn;
        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }
    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "initializer must be void(void)" },
        }
    }
}

public boundary trait Initializer: Calling<InitializerCalling> {
    machine call() reaches;
}

public data OncePolicy { }
public OnceCalling satisfies CallingPolicy {
    CallingPolicy::plan = OncePolicy::plan;
}

machine OncePolicy::plan(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 1 && signature.has_result
        && (signature.native_parameter_count == 1 || signature.native_parameter_count == 2)
        && signature.callback_demand_count <= 1 {
        true -> accept(signature)
        _ -> reject()
    }
    state accept(signature: BoundarySignature) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::SystemVAMD64;
        output.call.parameter_count = signature.native_parameter_count;
        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = 8;
        output.call.parameters[0].shape.alignment = 8;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rdi,
            value_byte_offset: 0,
            byte_size: 8,
        };
        output.call.parameters[1].shape.class = AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = 8;
        output.call.parameters[1].shape.alignment = 8;
        output.call.parameters[1].location_count = 1;
        output.call.parameters[1].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rsi,
            value_byte_offset: 0,
            byte_size: 8,
        };
        output.call.has_result = true;
        output.call.result.shape.class = AbiValueClass::Integer;
        output.call.result.shape.byte_size = 4;
        output.call.result.shape.alignment = 4;
        output.call.result.location_count = 1;
        output.call.result.locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rax,
            value_byte_offset: 0,
            byte_size: 4,
        };
        output.call.callback_materialization_count = signature.callback_demand_count;
        output.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
        output.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
        output.call.ordinary_clobbers.register_count = 25;
        output.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = MachineRegister::X86Rsi;
        output.call.ordinary_clobbers.registers[4] = MachineRegister::X86Rdi;
        output.call.ordinary_clobbers.registers[5] = MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[6] = MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[7] = MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[8] = MachineRegister::X86R11;
        output.call.ordinary_clobbers.registers[9] = MachineRegister::X86Xmm { index: 0 };
        output.call.ordinary_clobbers.registers[10] = MachineRegister::X86Xmm { index: 1 };
        output.call.ordinary_clobbers.registers[11] = MachineRegister::X86Xmm { index: 2 };
        output.call.ordinary_clobbers.registers[12] = MachineRegister::X86Xmm { index: 3 };
        output.call.ordinary_clobbers.registers[13] = MachineRegister::X86Xmm { index: 4 };
        output.call.ordinary_clobbers.registers[14] = MachineRegister::X86Xmm { index: 5 };
        output.call.ordinary_clobbers.registers[15] = MachineRegister::X86Xmm { index: 6 };
        output.call.ordinary_clobbers.registers[16] = MachineRegister::X86Xmm { index: 7 };
        output.call.ordinary_clobbers.registers[17] = MachineRegister::X86Xmm { index: 8 };
        output.call.ordinary_clobbers.registers[18] = MachineRegister::X86Xmm { index: 9 };
        output.call.ordinary_clobbers.registers[19] = MachineRegister::X86Xmm { index: 10 };
        output.call.ordinary_clobbers.registers[20] = MachineRegister::X86Xmm { index: 11 };
        output.call.ordinary_clobbers.registers[21] = MachineRegister::X86Xmm { index: 12 };
        output.call.ordinary_clobbers.registers[22] = MachineRegister::X86Xmm { index: 13 };
        output.call.ordinary_clobbers.registers[23] = MachineRegister::X86Xmm { index: 14 };
        output.call.ordinary_clobbers.registers[24] = MachineRegister::X86Xmm { index: 15 };
        output.call.stack_alignment = 16;
        output.call.entry_control = EntryControl::CallReturn;
        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }
    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "invalid pthread_once telescope" },
        }
    }
}

public boundary trait OnceRegistrar: Calling<OnceCalling> {
    machine execute<machine Handler>(word: &mut i32, native callback initialize from Handler) -> i32
    where machine Handler satisfies Initializer::call;
    reaches
    invokes Initializer;
}

public data Initialization { }
public machine Initialization::call() satisfies Initializer::call { }

linux_x86_64 machine once_binding() -> ForeignBinding<9, 12, 10> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libc.so.6",
            symbol: "pthread_once",
            version: "GLIBC_2.34",
        },
    }
}

linux_x86_64 machine once_leaf<machine Handler>(word: &mut i32) -> i32
where machine Handler satisfies Initializer::call;
satisfies OnceRegistrar::execute
via once_binding();

data Main { word: i32; status: i32; }

machine Main::main(main: &mut Main) reaches OnceRegistrar + Initializer
invokes OnceRegistrar;
{
    main.word = 0;
    main.status = OnceRegistrar::execute<Initialization::call>(&mut main.word);
}
