// Field-path byte-range argument on a self-receiver call:
// `self.sink.fill(&mut self.buf[..])` — the range projects a fixed byte
// array below the `self` parameter, so the call's argument is an exclusive
// byte range rooted at a parameter path.

use omega_language_std::console;
use omega::language::core::binding;

data Sink {
    filled: u64;
}

machine Sink::fill(&mut self, bytes: &mut [u8]) {
    transition bytes.len >= 1 {
        true -> filled(bytes)
        _ -> skipped()
    }

    state filled(&mut self, bytes: &mut [u8]) {
        bytes[0] = 9;
        self.filled = bytes.len;
    }

    state skipped(&mut self) {
        self.filled = 0;
    }
}

data Main {
    console: Binding<Console>;
    sink: Sink;
    buf: [u8; 8];
}

machine Main::main(&mut self) reaches Console {
    self.sink = Sink { filled: 0 };
    self.buf[0] = 0;
    self.sink.fill(&mut self.buf[..]);

    transition self.sink.filled == 8 && self.buf[0] == 9 {
        true -> done()
        _ -> missed()
    }

    state done(&mut self) {
        self.console.exit_process(70);
    }

    state missed(&mut self) {
        self.console.exit_process(71);
    }
}
