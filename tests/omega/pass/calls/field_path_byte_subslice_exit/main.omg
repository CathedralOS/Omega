// Field-path byte-range argument on a self-receiver call:
// `Sink::fill(&mut main.sink, &mut main.buf[..])` — the range projects a fixed byte
// array below the subject parameter, so the call's argument is an exclusive
// byte range rooted at a parameter path.

use omega_language_std::console;

data Sink {
    filled: u64;
}

machine Sink::fill(sink: &mut Sink, bytes: &mut [u8]) {
    transition bytes.len >= 1 {
        true -> filled(sink, bytes)
        _ -> skipped(sink)
    }

    state filled(sink: &mut Sink, bytes: &mut [u8]) {
        bytes[0] = 9;
        sink.filled = bytes.len;
    }

    state skipped(sink: &mut Sink) {
        sink.filled = 0;
    }
}

data Main {
    sink: Sink;
    buf: [u8; 8];
}

machine Main::main(main: &mut Main) reaches Console {
    main.sink = Sink { filled: 0 };
    main.buf[0] = 0;
    Sink::fill(&mut main.sink, &mut main.buf[..]);

    transition main.sink.filled == 8 && main.buf[0] == 9 {
        true -> done(main)
        _ -> missed(main)
    }

    state done(main: &mut Main) {
        Console::exit_process(70);
    }

    state missed(main: &mut Main) {
        Console::exit_process(71);
    }
}
