// Closed selected constructor computation discharges true requirements.
// Expression and transition tails, local and parameter returns share one body evaluator.
// Expected exit: 0.
// Expected output contains: constructor checks=8
use omega_language_std::console;
data Point [copy] { x: u64; y: u64; }
data Main { point: Point; }
machine Point::zero() -> Point { Point { x: 0, y: 0 } }
machine Point::from_x(value: u64) -> Point { Point { x: value, y: 0 } }
machine Point::local_zero() -> Point { let value: u64 = 0; Point { x: value, y: 0 } }
machine Point::terminal_zero() -> Point { transition { _ -> Point { x: 0, y: 0 } } }
machine take(point: Point) -> u64 requires point == Point::zero(); { point.x }
machine take_parameter(point: Point) -> u64 requires point == Point::from_x(0); { point.x }
machine take_local(point: Point) -> u64 requires point == Point::local_zero(); { point.x }
machine take_terminal(point: Point) -> u64 requires point == Point::terminal_zero(); { point.x }
machine take_projection(point: Point) -> u64 requires point.x == Point::zero().x; { point.x }
machine Main::main(main: &mut Main) reaches Console {
    let result: u64 = take(Point { x: 0, y: 0 });
    transition result == 0 { true -> parameter(main) _ -> wrong(main) }
    state parameter(main: &mut Main) {
        let result: u64 = take_parameter(Point { x: 0, y: 0 });
        transition result == 0 { true -> local_return(main) _ -> wrong(main) }
    }
    state local_return(main: &mut Main) {
        let result: u64 = take_local(Point { x: 0, y: 0 });
        transition result == 0 { true -> terminal(main) _ -> wrong(main) }
    }
    state terminal(main: &mut Main) {
        let result: u64 = take_terminal(Point { x: 0, y: 0 });
        transition result == 0 { true -> local_argument(main) _ -> wrong(main) }
    }
    state local_argument(main: &mut Main) {
        let value: Point = Point { x: 0, y: 0 };
        let result: u64 = take(value);
        transition result == 0 { true -> field_argument(main) _ -> wrong(main) }
    }
    state field_argument(main: &mut Main) {
        main.point = Point { x: 0, y: 0 };
        let result: u64 = take(main.point);
        transition result == 0 { true -> copied_store(main) _ -> wrong(main) }
    }
    state copied_store(main: &mut Main) {
        main.point = Point { x: 0, y: 0 };
        let saved: Point = main.point;
        main.point = Point { x: 1, y: 0 };
        let result: u64 = take(saved);
        transition result == 0 { true -> projection(main) _ -> wrong(main) }
    }
    state projection(main: &mut Main) {
        let result: u64 = take_projection(Point { x: 0, y: 0 });
        transition result == 0 { true -> done(main) _ -> wrong(main) }
    }
    state done(main: &mut Main) { Console::write_line("constructor checks=8"); Console::exit_process(0); }
    state wrong(main: &mut Main) { Console::exit_process(9); }
}
