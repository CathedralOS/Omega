// Checking applies an exact boundary-trait requirement through a nested helper
// and a later state; merely checking a helper's unselected requirement must not
// demand an unrelated selection.

public boundary trait Reading {
    machine read() -> u64 reaches;
}
data ReadingProvider {}
machine ReadingProvider::read() -> u64 satisfies Reading::read { 42 }

public boundary trait Unselected { machine read() -> u64 reaches; }
machine unused() -> u64 reaches Unselected {
    Unselected::read()
}

data Session { }
data Main { session: Session; }

machine read() -> u64 reaches Reading {
    Reading::read()
}

machine Main::main(main: &mut Main) reaches Reading crashes Trap {
    let value: u64 = read();
    transition value == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
