// The saved input and live mutable formal have independent postconditions.
// Writing the live source retires copied-input substitutions, but the callee's
// guarantee on its new contents must establish the following call.
data Main { amount: i32; }

machine replace(value: i32, main: &mut Main) -> bool
requires value < 0
ensures
    value < 0;
    main.amount > 0
{
    main.amount = 7;
    value == -41
}

machine take_positive(value: i32) -> bool
requires value > 0 {
    value == 7
}

machine Main::main(main: &mut Main) crashes Trap {
    main.amount = -41;
    let captured: bool = replace(main.amount, main);
    let restored: bool = take_positive(main.amount);
    transition captured && restored && main.amount == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
