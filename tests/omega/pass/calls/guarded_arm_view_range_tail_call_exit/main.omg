// A guarded transition arm naming another machine passes a runtime range of
// a borrowed view (wiki/spec/language/state_contracts.md, "Terminal calls in
// transition arms"). The arm narrows its view only when selected, and the
// length its guard observed bounds the range:
//
//   bytes     `self.measure(path[0..self.k])` narrows a byte view parameter
//             to an end held in a field, guarded by `self.k < path.len`.
//   domained  the same range over a `&[u8] in Path` parameter supplies a
//             plain `&[u8]` formal; the narrowed view leaves the domain behind.
//   elements  `self.count(items[lo..hi])` narrows an element view parameter.
//
// Each callee records the length it received. A wrong length exits 71-73;
// every leg agreeing exits 70.

domain [u8]::Path(bytes)
requires
    no_nul(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    k: u64;
    seen: u64;
    entries: [i32; 5];
}

machine Main::measure(&mut self, prefix: &[u8]) {
    self.seen = prefix.len;
}

machine Main::count(&mut self, sub: &[i32]) {
    self.seen = sub.len;
}

machine Main::bytes(&mut self, path: &[u8]) {
    transition self.k < path.len {
        true -> self.measure(path[0..self.k])
        false -> skipped()
    }
    state skipped(&mut self) { self.seen = 0; }
}

machine Main::domained(&mut self, path: &[u8] in Path) {
    transition self.k < path.len {
        true -> self.measure(path[0..self.k])
        false -> skipped()
    }
    state skipped(&mut self) { self.seen = 0; }
}

machine Main::elements(&mut self, items: &[i32], lo: u64, hi: u64) {
    transition lo <= hi && hi <= items.len {
        true -> self.count(items[lo..hi])
        false -> skipped()
    }
    state skipped(&mut self) { self.seen = 0; }
}

machine Main::main(&mut self) reaches Console {
    self.k = 5;
    self.bytes("/adir/x");
    let bytes_seen: u64 = self.seen;
    self.k = 3;
    self.domained("/adir/x");
    let domained_seen: u64 = self.seen;
    let items: &[i32] = self.entries.as_slice();
    self.elements(items, 1, 3);
    let elements_seen: u64 = self.seen;
    transition bytes_seen == 5 {
        true -> check_domained(domained_seen, elements_seen)
        false -> fail(71)
    }
    state check_domained(&mut self, domained_seen: u64, elements_seen: u64) {
        transition domained_seen == 3 {
            true -> check_elements(elements_seen)
            false -> fail(72)
        }
    }
    state check_elements(&mut self, elements_seen: u64) {
        transition elements_seen == 2 {
            true -> done()
            false -> fail(73)
        }
    }
    state done(&mut self) { self.console.exit_process(70); }
    state fail(&mut self, code: i32) { self.console.exit_process(code); }
}
