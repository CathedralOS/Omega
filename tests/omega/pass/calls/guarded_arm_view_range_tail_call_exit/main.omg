// A guarded transition arm naming another machine passes a runtime range of
// a borrowed view (wiki/spec/language/state_contracts.md, "Terminal calls in
// transition arms"). The arm narrows its view only when selected, and the
// length its guard observed bounds the range:
//
//   bytes     `Main::measure(main, path[0..main.k])` narrows a byte view parameter
//             to an end held in a field, guarded by `main.k < path.len`.
//   domained  the same range over a `&[u8] in Path` parameter supplies a
//             plain `&[u8]` formal; the narrowed view leaves the domain behind.
//   elements  `Main::count(&mut main.seen, items[lo..hi])` narrows an element view parameter.
//
// Each callee records the length it received. A wrong length exits 71-73;
// every leg agreeing exits 70.

domain [u8]::Path(bytes)
requires
    no_nul(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    k: u64;
    seen: u64;
    entries: [i32; 5];
}

machine Main::measure(main: &mut Main, prefix: &[u8]) {
    main.seen = prefix.len;
}

machine Main::count(seen: &mut u64, sub: &[i32]) {
    seen = sub.len;
}

machine Main::bytes(main: &mut Main, path: &[u8]) {
    transition main.k < path.len {
        true -> Main::measure(main, path[0..main.k])
        false -> skipped(main)
    }
    state skipped(main: &mut Main) { main.seen = 0; }
}

machine Main::domained(main: &mut Main, path: &[u8] in Path) {
    transition main.k < path.len {
        true -> Main::measure(main, path[0..main.k])
        false -> skipped(main)
    }
    state skipped(main: &mut Main) { main.seen = 0; }
}

machine Main::elements(seen: &mut u64, items: &[i32], lo: u64, hi: u64) {
    transition lo <= hi && hi <= items.len {
        true -> Main::count(seen, items[lo..hi])
        false -> skipped(seen)
    }
    state skipped(seen: &mut u64) { seen = 0; }
}

machine Main::main(main: &mut Main) reaches Console {
    main.k = 5;
    Main::bytes(main, "/adir/x");
    let bytes_seen: u64 = main.seen;
    main.k = 3;
    Main::domained(main, "/adir/x");
    let domained_seen: u64 = main.seen;
    let items: &[i32] = main.entries.as_slice();
    Main::elements(&mut main.seen, items, 1, 3);
    let elements_seen: u64 = main.seen;
    transition bytes_seen == 5 {
        true -> check_domained(main, domained_seen, elements_seen)
        false -> fail(main, 71)
    }
    state check_domained(main: &mut Main, domained_seen: u64, elements_seen: u64) {
        transition domained_seen == 3 {
            true -> check_elements(main, elements_seen)
            false -> fail(main, 72)
        }
    }
    state check_elements(main: &mut Main, elements_seen: u64) {
        transition elements_seen == 2 {
            true -> done(main)
            false -> fail(main, 73)
        }
    }
    state done(main: &mut Main) { main.console.exit_process(70); }
    state fail(main: &mut Main, code: i32) { main.console.exit_process(code); }
}
