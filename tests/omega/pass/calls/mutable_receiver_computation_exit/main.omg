// An embedded mutable receiver call executes once before its local crosses a state edge.
use omega_language_std::console;
use omega::language::core::binding;

data Counter { count: i32 in Wrapping; }
data Main {
    console: Binding<Console>;
    base: i32 in Wrapping;
    counter: Counter;
}

machine Counter::double(counter: &mut Counter, value: i32 in Wrapping) -> i32 in Wrapping {
    counter.count = counter.count + 1;
    value * 2
}

machine Main::main(&mut self) reaches Console {
    self.base = 10;
    self.counter.count = 0;
    let result: i32 in Wrapping = self.base + Counter::double(&mut self.counter, 6) * 3;
    transition { _ -> observe(result) }
    state observe(&mut self, result: i32 in Wrapping) {
        transition result == 46 {
            true -> count()
            _ -> bad()
        }
    }
    state count(&mut self) {
        transition self.counter.count == 1 {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
