// An embedded mutable receiver call executes once before its local crosses a state edge.
use omega_language_std::console;

data Counter { count: i32 in Wrapping; }
data Main {
    base: i32 in Wrapping;
    counter: Counter;
}

machine Counter::double(counter: &mut Counter, value: i32 in Wrapping) -> i32 in Wrapping {
    counter.count = counter.count + 1;
    value * 2
}

machine Main::main(main: &mut Main) reaches Console {
    main.base = 10;
    main.counter.count = 0;
    let result: i32 in Wrapping = main.base + Counter::double(&mut main.counter, 6) * 3;
    transition { _ -> observe(main, result) }
    state observe(main: &mut Main, result: i32 in Wrapping) {
        transition result == 46 {
            true -> count(main)
            _ -> bad(main)
        }
    }
    state count(main: &mut Main) {
        transition main.counter.count == 1 {
            true -> good(main)
            _ -> bad(main)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
