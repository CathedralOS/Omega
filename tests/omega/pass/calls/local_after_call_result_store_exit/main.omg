// Locals declared after a call-result field store keep their own source
// custody and values (exit 70).
//
// `stored = echo(..)` stores a checked-body call's result straight into
// a field. The `let`s after it are keyed in their source roles by the locals
// declared before them, whatever binding slot the plan gives the stored
// result: `second` is 4 and `third` is 7 while the stored value is 1. Counting
// the store in that key rejected the program, and a read that resolved
// `second` to the stored result would see 1 and exit 71.
use omega_language_std::console;

data Main {
}

machine echo(value: i32) -> i32 {
    value
}

machine seven() -> i32 {
    7
}

machine Main::main(main: &mut Main) reaches Console {
    let mut a: i32 = 1;
    let mut b: i32 = 4;
    let mut stored: i32 = echo(a);
    let second: i32 = echo(b);
    let third: i32 = seven();
    transition second == 4 && third == 7 && stored == 1 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
