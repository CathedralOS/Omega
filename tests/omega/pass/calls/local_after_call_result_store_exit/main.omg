// Locals declared after a call-result field store keep their own source
// custody and values (exit 70).
//
// `self.stored = echo(..)` stores a checked-body call's result straight into
// a field. The `let`s after it are keyed in their source roles by the locals
// declared before them, whatever binding slot the plan gives the stored
// result: `second` is 4 and `third` is 7 while the stored value is 1. Counting
// the store in that key rejected the program, and a read that resolved
// `second` to the stored result would see 1 and exit 71.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    a: i32;
    b: i32;
    stored: i32;
}

machine echo(value: i32) -> i32 {
    value
}

machine seven() -> i32 {
    7
}

machine Main::main(&mut self) reaches Console {
    self.a = 1;
    self.b = 4;
    self.stored = echo(self.a);
    let second: i32 = echo(self.b);
    let third: i32 = seven();
    transition second == 4 && third == 7 && self.stored == 1 {
        true -> good()
        false -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
