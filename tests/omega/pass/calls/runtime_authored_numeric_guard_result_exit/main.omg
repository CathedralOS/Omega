machine min(left: i32, right: i32) -> bool { true }

data Values { first: i32; second: i32; }

machine Values::check(values: &Values) crashes Trap {
    transition min(values.first, values.second) == true {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let values: Values = Values { first: 2i32, second: 3i32 };
    Values::check(&values);
}
