use omega_language_std::calling;
use omega_language_std::console;
use omega::language::core::external_binding;

pub data Policies { }
pub PrepareCalling satisfies CallingPolicy {
    CallingPolicy::plan = Policies::prepare;
}
pub InvokeCalling satisfies CallingPolicy {
    CallingPolicy::plan = Policies::invoke;
}
pub TransformCalling satisfies CallingPolicy {
    CallingPolicy::plan = Policies::transform;
}

macos_arm64 machine Policies::prepare(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = 5;
    plan.call.parameters[0] = Policies::word(8, 0);
    plan.call.parameters[1] = Policies::word(4, 1);
    plan.call.parameters[2] = Policies::word(4, 2);
    plan.call.parameters[3] = Policies::word(8, 3);
    plan.call.parameters[4] = Policies::word(8, 4);
    plan.call.has_result = true;
    plan.call.result = Policies::result_word(4);
    BoundaryPlanResult::Accepted { plan: Policies::finish(plan) }
}

macos_arm64 machine Policies::invoke(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = signature.native_parameter_count;
    plan.call.parameters[0] = Policies::word(8, 0);
    plan.call.parameters[1] = Policies::word(8, 1);
    plan.call.parameters[2] = Policies::word(8, 2);
    plan.call.parameters[3] = Policies::word(8, 3);
    plan.call.callback_materialization_count = signature.callback_demand_count;
    plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
    plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
    BoundaryPlanResult::Accepted { plan: Policies::finish(plan) }
}

machine Policies::record(register: u64) -> ValuePlacement {
    let mut placement: ValuePlacement;
    placement.shape.class = AbiValueClass::Integer;
    placement.shape.byte_size = 24;
    placement.shape.alignment = 8;
    placement.location_count = 1;
    placement.locations[0] = ValueLocation::Indirect {
        pointer: IndirectPointerLocation::Register {
            register: MachineRegister::Aarch64X { index: register }
        },
        has_copy: false, copy_stack_byte_offset: 0,
        byte_size: 24, alignment: 8,
    };
    placement
}

macos_arm64 machine Policies::transform(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = 1;
    plan.call.parameters[0] = Policies::record(0);
    plan.call.has_result = true;
    plan.call.result = Policies::record(8);
    let mut callback: BoundaryEntryPlan = Policies::finish(plan);
    // Remove X9 and V16 from the ordinary clobbers without changing placement.
    // The ordinary helper still uses the complete internal clobber bank.
    callback.call.ordinary_clobbers.registers[9] = callback.call.ordinary_clobbers.registers[40];
    callback.call.ordinary_clobbers.registers[26] = callback.call.ordinary_clobbers.registers[41];
    callback.call.ordinary_clobbers.register_count = 40;
    BoundaryPlanResult::Accepted { plan: callback }
}

machine Policies::placed_word(bytes: u64, register: MachineRegister) -> ValuePlacement {
    let mut value: ValuePlacement;
    value.shape.class = AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = ValueLocation::Register {
        register: register,
        value_byte_offset: 0,
        byte_size: bytes,
    };
    value
}

machine Policies::word(bytes: u64, register: u64) -> ValuePlacement {
    Policies::placed_word(bytes, MachineRegister::Aarch64X { index: register })
}

machine Policies::finish(output: BoundaryEntryPlan) -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan = output;
    plan.call.convention = CallingConvention::Aapcs64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.call.ordinary_clobbers.register_count = 42;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::Aarch64X { index: 6 };
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::Aarch64X { index: 7 };
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::Aarch64X { index: 9 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::Aarch64X { index: 10 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::Aarch64X { index: 11 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::Aarch64X { index: 12 };
    plan.call.ordinary_clobbers.registers[13] = MachineRegister::Aarch64X { index: 13 };
    plan.call.ordinary_clobbers.registers[14] = MachineRegister::Aarch64X { index: 14 };
    plan.call.ordinary_clobbers.registers[15] = MachineRegister::Aarch64X { index: 15 };
    plan.call.ordinary_clobbers.registers[16] = MachineRegister::Aarch64X { index: 16 };
    plan.call.ordinary_clobbers.registers[17] = MachineRegister::Aarch64X { index: 17 };
    plan.call.ordinary_clobbers.registers[18] = MachineRegister::Aarch64V { index: 0 };
    plan.call.ordinary_clobbers.registers[19] = MachineRegister::Aarch64V { index: 1 };
    plan.call.ordinary_clobbers.registers[20] = MachineRegister::Aarch64V { index: 2 };
    plan.call.ordinary_clobbers.registers[21] = MachineRegister::Aarch64V { index: 3 };
    plan.call.ordinary_clobbers.registers[22] = MachineRegister::Aarch64V { index: 4 };
    plan.call.ordinary_clobbers.registers[23] = MachineRegister::Aarch64V { index: 5 };
    plan.call.ordinary_clobbers.registers[24] = MachineRegister::Aarch64V { index: 6 };
    plan.call.ordinary_clobbers.registers[25] = MachineRegister::Aarch64V { index: 7 };
    plan.call.ordinary_clobbers.registers[26] = MachineRegister::Aarch64V { index: 16 };
    plan.call.ordinary_clobbers.registers[27] = MachineRegister::Aarch64V { index: 17 };
    plan.call.ordinary_clobbers.registers[28] = MachineRegister::Aarch64V { index: 18 };
    plan.call.ordinary_clobbers.registers[29] = MachineRegister::Aarch64V { index: 19 };
    plan.call.ordinary_clobbers.registers[30] = MachineRegister::Aarch64V { index: 20 };
    plan.call.ordinary_clobbers.registers[31] = MachineRegister::Aarch64V { index: 21 };
    plan.call.ordinary_clobbers.registers[32] = MachineRegister::Aarch64V { index: 22 };
    plan.call.ordinary_clobbers.registers[33] = MachineRegister::Aarch64V { index: 23 };
    plan.call.ordinary_clobbers.registers[34] = MachineRegister::Aarch64V { index: 24 };
    plan.call.ordinary_clobbers.registers[35] = MachineRegister::Aarch64V { index: 25 };
    plan.call.ordinary_clobbers.registers[36] = MachineRegister::Aarch64V { index: 26 };
    plan.call.ordinary_clobbers.registers[37] = MachineRegister::Aarch64V { index: 27 };
    plan.call.ordinary_clobbers.registers[38] = MachineRegister::Aarch64V { index: 28 };
    plan.call.ordinary_clobbers.registers[39] = MachineRegister::Aarch64V { index: 29 };
    plan.call.ordinary_clobbers.registers[40] = MachineRegister::Aarch64V { index: 30 };
    plan.call.ordinary_clobbers.registers[41] = MachineRegister::Aarch64V { index: 31 };
    plan.state.initial_regime = MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}


pub data OwnedRecord [copy] { first: u64; second: u64; third: u64; }

// Darwin arm64 ffi.h: ffi_type is 24 bytes and ffi_cif has the extra
// aarch64_nfixedargs word, making its aligned extent 40 bytes.
pub data IntegerType { size: u64; alignment: u16; kind: u16; elements: u64; }
pub data TypeElements { first: &IntegerType; second: &IntegerType; third: &IntegerType; terminator: u64; }
pub data PairType { size: u64; alignment: u16; kind: u16; elements: &TypeElements; }
pub data ArgumentTypes { pair: &PairType; }
// ffi_call consumes the CIF prefix. This explicit shared metadata carrier
// keeps the actual type records available throughout that invocation.
pub data PreparedInterface { interface: ForeignInterface; types: &ArgumentTypes; }
pub data ForeignInterface [copy] {
    abi: u32; argument_count: u32; argument_types: addr; result_type: addr;
    stack_bytes: u32; flags: u32; fixed_arguments: u32;
}
pub data ArgumentValues { pair: &OwnedRecord; }

pub boundary trait Prepare: Calling<PrepareCalling> {
    machine prepare(
        interface: &mut ForeignInterface, abi: u32, count: u32,
        result_type: &PairType, argument_types: &ArgumentTypes
    ) -> u32;
}
pub boundary trait Transform: Calling<TransformCalling> {
    machine transform(pair: OwnedRecord) -> OwnedRecord;
}
pub boundary trait Invoke: Calling<InvokeCalling> {
    machine invoke<machine Handler>(
        interface: &PreparedInterface, native callback transform from Handler,
        result: &mut OwnedRecord, arguments: &ArgumentValues
    )
    where machine Handler satisfies Transform::transform;
    invokes Transform;
}

machine transformed(pair: OwnedRecord) -> OwnedRecord {
    OwnedRecord { first: pair.third, second: pair.first, third: pair.second }
}
pub data Handler { }
pub machine Handler::transform(pair: OwnedRecord) -> OwnedRecord
satisfies Transform::transform
{
    transformed(pair)
}

macos_arm64 machine prepare_binding() -> ForeignBinding<21, 13, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libffi.dylib", symbol: "_ffi_prep_cif",
        },
    }
}
macos_arm64 machine prepare_leaf(
    interface: &mut ForeignInterface, abi: u32, count: u32,
    result_type: &PairType, argument_types: &ArgumentTypes
) -> u32
satisfies Prepare::prepare
via prepare_binding();

macos_arm64 machine invoke_binding() -> ForeignBinding<21, 9, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libffi.dylib", symbol: "_ffi_call",
        },
    }
}
macos_arm64 machine invoke_leaf<machine Selected>(
    interface: &PreparedInterface, result: &mut OwnedRecord, arguments: &ArgumentValues
)
where machine Selected satisfies Transform::transform;
satisfies Invoke::invoke
via invoke_binding();

data Main {
    interface: ForeignInterface;
    input: OwnedRecord; result: OwnedRecord;
}
machine Main::main(main: &mut Main) reaches Prepare + Invoke + Transform + Console
invokes Prepare;
invokes Invoke;
invokes Console;
{
    let integer: IntegerType = IntegerType { size: 8, alignment: 8, kind: 11, elements: 0 };
    let elements: TypeElements = TypeElements { first: &integer, second: &integer, third: &integer, terminator: 0 };
    let pair: PairType = PairType { size: 24, alignment: 8, kind: 13, elements: &elements };
    let argument_types: ArgumentTypes = ArgumentTypes { pair: &pair };
    let status: u32 = Prepare::prepare(&mut main.interface, ffi_abi(), 1,
        &pair, &argument_types);
    let prepared: PreparedInterface = PreparedInterface {
        interface: main.interface, types: &argument_types
    };
    main.input = OwnedRecord { first: 17, second: 91, third: 43 };
    let arguments: ArgumentValues = ArgumentValues { pair: &main.input };
    Invoke::invoke<Handler::transform>(&prepared, &mut main.result, &arguments);
    transition status == 0
        && main.result.first == 43 && main.result.second == 17 && main.result.third == 91
        && main.input.first == 17 && main.input.second == 91 && main.input.third == 43 {
        true -> done()
        _ -> failed()
    }
    state done() { Console::exit_process(0); }
    state failed() { Console::exit_process(71); }
}


machine Policies::result_word(bytes: u64) -> ValuePlacement {
    Policies::word(bytes, 0)
}

machine LinuxPolicies::word(bytes: u64, register: u64) -> ValuePlacement {
    transition register {
        0 -> Policies::placed_word(bytes, MachineRegister::X86Rdi)
        1 -> Policies::placed_word(bytes, MachineRegister::X86Rsi)
        2 -> Policies::placed_word(bytes, MachineRegister::X86Rdx)
        3 -> Policies::placed_word(bytes, MachineRegister::X86Rcx)
        4 -> Policies::placed_word(bytes, MachineRegister::X86R8)
        _ -> Policies::placed_word(bytes, MachineRegister::X86R9)
    }
}

machine LinuxPolicies::finish(output: BoundaryEntryPlan) -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan = output;
    plan.call.convention = CallingConvention::SystemVAMD64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.call.ordinary_clobbers.register_count = 25;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::X86Rsi;
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::X86Rdi;
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::X86R8;
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::X86R9;
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::X86R10;
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::X86R11;
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::X86Xmm { index: 0 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::X86Xmm { index: 1 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::X86Xmm { index: 2 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::X86Xmm { index: 3 };
    plan.call.ordinary_clobbers.registers[13] = MachineRegister::X86Xmm { index: 4 };
    plan.call.ordinary_clobbers.registers[14] = MachineRegister::X86Xmm { index: 5 };
    plan.call.ordinary_clobbers.registers[15] = MachineRegister::X86Xmm { index: 6 };
    plan.call.ordinary_clobbers.registers[16] = MachineRegister::X86Xmm { index: 7 };
    plan.call.ordinary_clobbers.registers[17] = MachineRegister::X86Xmm { index: 8 };
    plan.call.ordinary_clobbers.registers[18] = MachineRegister::X86Xmm { index: 9 };
    plan.call.ordinary_clobbers.registers[19] = MachineRegister::X86Xmm { index: 10 };
    plan.call.ordinary_clobbers.registers[20] = MachineRegister::X86Xmm { index: 11 };
    plan.call.ordinary_clobbers.registers[21] = MachineRegister::X86Xmm { index: 12 };
    plan.call.ordinary_clobbers.registers[22] = MachineRegister::X86Xmm { index: 13 };
    plan.call.ordinary_clobbers.registers[23] = MachineRegister::X86Xmm { index: 14 };
    plan.call.ordinary_clobbers.registers[24] = MachineRegister::X86Xmm { index: 15 };
    plan.state.initial_regime = MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}

machine LinuxPolicies::result_word(bytes: u64) -> ValuePlacement {
    Policies::placed_word(bytes, MachineRegister::X86Rax)
}

data LinuxPolicies {}


linux_x86_64 machine Policies::prepare(signature: BoundarySignature) -> BoundaryPlanResult
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = 5;
    plan.call.parameters[0] = LinuxPolicies::word(8, 0);
    plan.call.parameters[1] = LinuxPolicies::word(4, 1);
    plan.call.parameters[2] = LinuxPolicies::word(4, 2);
    plan.call.parameters[3] = LinuxPolicies::word(8, 3);
    plan.call.parameters[4] = LinuxPolicies::word(8, 4);
    plan.call.has_result = true;
    plan.call.result = LinuxPolicies::result_word(4);
    BoundaryPlanResult::Accepted { plan: LinuxPolicies::finish(plan) }
}

linux_x86_64 machine Policies::invoke(signature: BoundarySignature) -> BoundaryPlanResult
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = signature.native_parameter_count;
    plan.call.parameters[0] = LinuxPolicies::word(8, 0);
    plan.call.parameters[1] = LinuxPolicies::word(8, 1);
    plan.call.parameters[2] = LinuxPolicies::word(8, 2);
    plan.call.parameters[3] = LinuxPolicies::word(8, 3);
    plan.call.callback_materialization_count = signature.callback_demand_count;
    plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
    plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
    BoundaryPlanResult::Accepted { plan: LinuxPolicies::finish(plan) }
}

linux_x86_64 machine Policies::transform(signature: BoundarySignature) -> BoundaryPlanResult {
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = 1;
    plan.call.parameters[0] = LinuxPolicies::argument();
    plan.call.has_result = true;
    plan.call.result = LinuxPolicies::returned();
    let mut callback: BoundaryEntryPlan = LinuxPolicies::finish(plan);
    // Preserve R10 across this callback, independently of its placement.
    callback.call.ordinary_clobbers.registers[7] = callback.call.ordinary_clobbers.registers[24];
    callback.call.ordinary_clobbers.register_count = 24;
    BoundaryPlanResult::Accepted { plan: callback }
}

machine LinuxPolicies::argument() -> ValuePlacement {
    let mut placement: ValuePlacement;
    placement.shape.class = AbiValueClass::Integer;
    placement.shape.byte_size = 24;
    placement.shape.alignment = 8;
    placement.location_count = 3;
    placement.locations[0] = ValueLocation::Stack {
        stack_byte_offset: 0, value_byte_offset: 0,
        byte_size: 8, alignment: 8,
    };
    placement.locations[1] = ValueLocation::Stack {
        stack_byte_offset: 8, value_byte_offset: 8,
        byte_size: 8, alignment: 8,
    };
    placement.locations[2] = ValueLocation::Stack {
        stack_byte_offset: 16, value_byte_offset: 16,
        byte_size: 8, alignment: 8,
    };
    placement
}

machine LinuxPolicies::returned() -> ValuePlacement {
    let mut placement: ValuePlacement;
    placement.shape.class = AbiValueClass::Integer;
    placement.shape.byte_size = 24;
    placement.shape.alignment = 8;
    placement.location_count = 1;
    placement.locations[0] = ValueLocation::Indirect {
        pointer: IndirectPointerLocation::Register { register: MachineRegister::X86Rdi },
        has_copy: false, copy_stack_byte_offset: 0,
        byte_size: 24, alignment: 8,
    };
    placement
}

linux_x86_64 machine linux_prepare_binding() -> ForeignBinding<11, 12, 15> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libffi.so.8", symbol: "ffi_prep_cif", version: "LIBFFI_BASE_8.0",
        },
    }
}

linux_x86_64 machine prepare_leaf(
    interface: &mut ForeignInterface, abi: u32, count: u32,
    result_type: &PairType, argument_types: &ArgumentTypes
) -> u32
satisfies Prepare::prepare
via linux_prepare_binding();


linux_x86_64 machine linux_invoke_binding() -> ForeignBinding<11, 8, 15> {
    ForeignBinding::DllImport {
        import: DllImport::ElfVersioned {
            object: "libffi.so.8", symbol: "ffi_call", version: "LIBFFI_BASE_8.0",
        },
    }
}

linux_x86_64 machine invoke_leaf<machine Selected>(
    interface: &PreparedInterface, result: &mut OwnedRecord, arguments: &ArgumentValues
)
where machine Selected satisfies Transform::transform;
satisfies Invoke::invoke
via linux_invoke_binding();

// libffi target ABI discriminants from the platform ffi headers.
macos_arm64 machine ffi_abi() -> u32 { 1 }
linux_x86_64 machine ffi_abi() -> u32 { 2 }
