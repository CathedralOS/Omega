use omega_language_std::console;
use omega::language::core::binding;

data Counter { value: i32; marker: i32; }
data Store { counters: [Counter; 2]; marker: i32; }
data Main { console: Binding<Console>; counter: Counter; store: Store; }

machine Counter::fill(&mut self) { self.value = 42; }
machine update(counter: &mut Counter) -> i32 {
    transition { _ -> mutate(counter) }
    state mutate(counter: &mut Counter) -> i32 {
        counter.fill();
        counter.marker = 7;
        counter.value
    }
}
machine update_projected(store: &mut Store) -> i32 {
    transition { _ -> mutate(store) }
    state mutate(store: &mut Store) -> i32 {
        store.counters[0].fill();
        store.marker = 7;
        store.counters[0].value
    }
}
machine Main::main(context: &mut Main) reaches Console {
    let result: i32 = update(&mut context.counter);
    let projected: i32 = update_projected(&mut context.store);
    transition result == 42 && context.counter.marker == 7 && context.store.marker == 7 {
        true -> finish(context, projected)
        false -> finish(context, 1)
    }
    state finish(context: &mut Main, code: i32) {
        context.console.exit_process(code);
    }
}
