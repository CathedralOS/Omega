use omega_language_std::console;

data Helper {}
machine Helper::measure(bytes: &[u8]) -> u64 { bytes.len }

data Main { bytes: [u8; 41]; }
machine Main::main(main: &mut Main) reaches Console {
    let observed: u64 = Helper::measure(&main.bytes[1..41]);
    Main::report(main, observed);
}
machine Main::report(main: &mut Main, observed: u64) reaches Console {
    transition observed == 40 {
        true -> finish(main, 70)
        false -> finish(main, 71)
    }
    machine finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
