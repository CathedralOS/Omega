use omega_language_std::console;
use omega::language::core::binding;

data Helper {}
machine Helper::measure(bytes: &[u8]) -> u64 { bytes.len }

data Main { console: Binding<Console>; bytes: [u8; 41]; }
machine Main::main(&mut self) reaches Console {
    let observed: u64 = Helper::measure(&self.bytes[1..41]);
    self.report(observed);
}
machine Main::report(&mut self, observed: u64) reaches Console {
    transition observed == 40 {
        true -> finish(70)
        false -> finish(71)
    }
    state finish(&mut self, code: i32) { self.console.exit_process(code); }
}
