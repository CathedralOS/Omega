// Expected exit: 0
// A returning expression can pass an established local into its nested calls.
data Link { case Empty; case Value(byte: u8); }
data Chain { bytes: [u8; 8]; links: [Link; 2]; marker: u64; }
data Path { chain: Chain; }
machine chain_default() -> Chain { (Chain { marker: 73 }) }
machine path_default() -> Path { (Path { chain: chain_default() }) }
machine parse(text: &[u8]) -> Path {
    let built: Path = path_default();
    transition { _ -> scan(built, text, 0) }
    machine scan(built: Path, text: &[u8], position: u64) -> Path {
        transition position < text.len {
            true -> scan(built, text, position + 1)
            false -> (built)
        }
    }
}
machine relay(value: Path) -> Path { (value) }
machine select(first: bool) -> Path {
    let built: Path = path_default();
    transition first {
        true -> (relay(built))
        false -> (Path { chain: Chain { marker: 91 } })
    }
}
machine main() crashes Trap {
    verify(parse("abc"), 73);
    verify(parse(""), 73);
    verify(select(true), 73);
    verify(select(false), 91);
}
machine verify(result: Path, expected: u64) crashes Trap {
    transition result.chain.marker == expected && result.chain.bytes[0] == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
