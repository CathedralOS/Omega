// A scalar value-machine call compared to an INTEGER literal directly in a
// guard subject WORKS: the syntax lowering hoists the call into a shared
// `let` temp (`hoist_scalar_value_call_comparison`), typed from the callee's
// DECLARED return, and the guard compares the materialized local. Both legs
// DISCRIMINATE (the historical bug took the true arm unconditionally):
// dbl(5) == 11 must take the FALSE arm; dbl(5) == 10 the true arm; and a
// NotEqual designed-false leg closes the operator family.
// exit 70 = all three legs right; 71/72/73 name the leg.
use omega::language::std::console;
data Main { console: Console; }
machine Main::dbl(&self, x: i32 in Wrapping) -> i32 in Wrapping {
    let r: i32 in Wrapping = x * 2;
    transition { _ -> r }
}
machine Main::main(&mut self) {
    transition self.dbl(5) == 11 { true -> bad(71) _ -> chk_true() }
    state chk_true(&mut self) {
        transition self.dbl(5) == 10 { true -> chk_ne() _ -> bad(72) }
    }
    state chk_ne(&mut self) {
        transition self.dbl(6) != 12 { true -> bad(73) _ -> good() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
