// Every scalar destination evaluates the inner receiver call before the outer
// call, exactly once. Result, hit count and decimal trace all contribute to 70.
use omega_language_std::console;

data Main {
    hits: u64 in Wrapping;
    trace: u64 in Wrapping;
    saved: u64 in Wrapping;
}

machine Main::bump(main: &mut Main, value: u64 in Wrapping) -> u64 in Wrapping {
    main.hits = main.hits + 1;
    main.trace = main.trace * 10 + value;
    value + 1
}

machine Main::returned(main: &mut Main) -> u64 in Wrapping {
    let inner: u64 in Wrapping = Main::bump(main, 3);
    Main::bump(main, inner)
}

machine Main::initialized(main: &mut Main) -> u64 in Wrapping {
    let inner: u64 in Wrapping = Main::bump(main, 5);
    let value: u64 in Wrapping = Main::bump(main, inner);
    value
}

machine Main::assigned(main: &mut Main) -> u64 in Wrapping {
    let mut value: u64 in Wrapping = 0;
    let inner: u64 in Wrapping = Main::bump(main, 7);
    value = Main::bump(main, inner);
    value
}

machine Main::main(main: &mut Main) reaches Console {
    main.hits = 0;
    main.trace = 0;
    let value: u64 in Wrapping = Main::returned(main);
    transition value == 5 && main.hits == 2 && main.trace == 34 {
        true -> initializer(main)
        false -> bad(main, 71)
    }
    state initializer(main: &mut Main) {
        main.hits = 0;
        main.trace = 0;
        let value: u64 in Wrapping = Main::initialized(main);
        transition value == 7 && main.hits == 2 && main.trace == 56 {
            true -> assignment(main)
            false -> bad(main, 72)
        }
    }
    state assignment(main: &mut Main) {
        main.hits = 0;
        main.trace = 0;
        let value: u64 in Wrapping = Main::assigned(main);
        transition value == 9 && main.hits == 2 && main.trace == 78 {
            true -> field_store(main)
            false -> bad(main, 73)
        }
    }
    state field_store(main: &mut Main) {
        main.hits = 0;
        main.trace = 0;
        let inner: u64 in Wrapping = Main::bump(main, 9);
        main.saved = Main::bump(main, inner);
        transition main.saved == 11 && main.hits == 2 && main.trace == 100 {
            true -> good(main)
            false -> bad(main, 74)
        }
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}
