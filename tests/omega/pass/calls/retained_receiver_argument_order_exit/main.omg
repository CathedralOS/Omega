use omega_language_std::console;

data Tag [copy] { case First; case Second; }
data Receiver { sentinel: u64; }
data Main { receiver: Receiver; tag: Tag; }

machine Receiver::accept(receiver: &mut Receiver, tag: Tag) {}
machine Receiver::observe(receiver: &mut Receiver, tag: Tag) {
    transition tag {
        Tag::First -> first(receiver)
        _ -> second(receiver)
    }
    state first(receiver: &mut Receiver) { receiver.sentinel = 11; }
    state second(receiver: &mut Receiver) { receiver.sentinel = 41; }
}

machine Main::main(main: &mut Main) reaches Console {
    main.receiver.sentinel = 29;
    main.tag = Tag::Second;
    Receiver::accept(&mut main.receiver, main.tag);
    let before: u64 = main.receiver.sentinel;
    Receiver::observe(&mut main.receiver, main.tag);
    transition {
        before == 29 && main.receiver.sentinel == 41 && main.tag == Tag::Second -> finish(main, 70)
        _ -> finish(main, 1)
    }
    state finish(main: &mut Main, code: i32) { Console::exit_process(code); }
}
