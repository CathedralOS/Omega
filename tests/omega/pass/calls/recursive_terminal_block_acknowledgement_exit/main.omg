// Expected exit: 0.
// A published blocking ceiling pins caller acknowledgement even for a body
// that completes without waiting. Every recursive invocation retains it.
public machine step() -> bool blocks; ensures result == true; { true }
data Context { visits: i32 in Wrapping; }
machine scan(context: &mut Context, remaining: i32 in Wrapping) -> bool
requires remaining >= 0;
ensures result == true;
{
    let ready: bool = block step();
    context.visits = context.visits + 1;
    transition ready && remaining > 0 {
        true -> block scan(context, remaining - 1)
        _ -> ready
    }
}
machine parenthesized(context: &mut Context, remaining: i32 in Wrapping) -> bool {
    let ready: bool = block step();
    context.visits = context.visits + 1;
    transition remaining > 0 {
        true -> (block parenthesized(context, remaining - 1))
        _ -> ready
    }
}
machine Context::qualified(context: &mut Context, remaining: i32 in Wrapping) -> bool {
    let ready: bool = block step();
    context.visits = context.visits + 1;
    transition remaining > 0 { true -> block Context::qualified(context, remaining - 1) _ -> ready }
}
machine main(context: &mut Context) crashes Trap {
    context.visits = 0;
    let first: bool = block scan(context, 3);
    let second: bool = block parenthesized(context, 2);
    let third: bool = block Context::qualified(context, 1);
    transition first && second && third && context.visits == 9 { true -> {} _ -> bad() }
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    block main(&mut entry_storage);
}
