// Recursive Unit calls reborrow caller-owned data. Each suspended
// caller retains its scalar depth and contributes it again after the call.
use omega_language_std::console;
data Counter { value: u64 in Trapping; }
machine visit(counter: &mut Counter, depth: u64) {
    transition depth > 0 { true -> next(counter, depth) false -> done() }
    machine next(counter: &mut Counter, depth: u64) {
        let mut retained: Counter;
        retained.value = depth as u64 in Trapping;
        counter.value = counter.value + (depth as u64 in Trapping);
        visit(counter, depth - 1);
        counter.value = counter.value + retained.value;
    }
    machine done() { }
}
machine main() reaches Console {
    let mut counter: Counter;
    let mut untouched: Counter;
    untouched.value = 100 as u64 in Trapping;
    visit(&mut counter, 6);
    transition counter.value == 42 && untouched.value == 100 { true -> good() false -> bad() }
    machine good() { Console::write_line("borrowed Unit frames: 42"); Console::exit_process(70); }
    machine bad() { Console::exit_process(71); }
}
