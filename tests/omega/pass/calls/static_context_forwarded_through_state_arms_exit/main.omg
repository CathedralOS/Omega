// A static context lent to a helper stays that helper's usable name for the
// caller's storage in every state the helper forwards it to. A state's
// conditional arms read the forwarded loan, a forwarded state calls further
// helpers with it, and each read or call reborrows the caller's record rather
// than a snapshot of it. The context carries a Console binding, so every
// helper borrows a provider-bearing record.
//
//   entry:          values = [5, 12, 20, 33]
//   move_to_front:  take(3) reads 33 in `read`'s last arm, taken 0 -> 1;
//                   read(0) reads 5 in the entry arm; values = [33, 5, 20, 33]
//   read(2)         20 from `read`'s last state
//   read(0)         33, the helper's earlier store
//   pair(1)         Pair { low: 5, high: 20 } from `pair`'s last state
//   exit 20 + 33 + 5 + 20 - 7 - taken 1 = 70
//
// A read that lands on a stale copy or an ended loan misses 70.
// Expected exit: 70.

use omega_language_std::console;

data Pair {
    low: i32 in Wrapping;
    high: i32 in Wrapping;
}

data Main {
    values: [i32 in Wrapping; 4];
    taken: i32 in Wrapping;
}

// Scalar result: the forwarded loan is read in each state's arms.
machine Main::read(context: &mut Main, index: i32) -> i32 in Wrapping {
    transition index == 0 {
        true -> (context.values[0])
        _ -> second(context, index)
    }

    state second(context: &mut Main, index: i32) {
        transition index == 1 {
            true -> (context.values[1])
            _ -> third(context, index)
        }
    }

    state third(context: &mut Main, index: i32) {
        transition index == 2 {
            true -> (context.values[2])
            _ -> (context.values[3])
        }
    }
}

// Scalar result: a call through the loan, then a store through it.
machine Main::take(context: &mut Main, index: i32) -> i32 in Wrapping {
    let value: i32 in Wrapping = Main::read(context, index);
    context.taken = context.taken + 1;
    transition { _ -> (value) }
}

// Unit result: a forwarded state calls scalar helpers, then stores.
machine Main::move_to_front(context: &mut Main, index: i32) {
    transition index == 0 {
        true -> done(context)
        _ -> shift(context, index)
    }

    state shift(context: &mut Main, index: i32) {
        let value: i32 in Wrapping = Main::take(context, index);
        let front: i32 in Wrapping = Main::read(context, 0);
        context.values[0] = value;
        context.values[1] = front;
    }

    state done(context: &mut Main) {}
}

// Record result: the forwarded loan is read in the last state's arms.
machine Main::pair(context: &mut Main, index: i32) -> Pair {
    transition index == 0 {
        true -> (Pair { low: context.values[0], high: context.values[1] })
        _ -> next(context, index)
    }

    state next(context: &mut Main, index: i32) {
        transition index == 1 {
            true -> (Pair { low: context.values[1], high: context.values[2] })
            _ -> (Pair { low: context.values[2], high: context.values[3] })
        }
    }
}

machine Main::main(context: &mut Main) reaches Console {
    context.values[0] = 5;
    context.values[1] = 12;
    context.values[2] = 20;
    context.values[3] = 33;
    Main::move_to_front(context, 3);
    let third: i32 in Wrapping = Main::read(context, 2);
    let first: i32 in Wrapping = Main::read(context, 0);
    let pair: Pair = Main::pair(context, 1);
    let code: i32 in Wrapping = third + first + pair.low + pair.high - 7 - context.taken;
    Console::exit_process(code as i32);
}
