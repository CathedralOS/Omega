use omega_language_std::console;
use omega::language::core::binding;

data Cell { value: i32; }
data Main {
    console: Binding<Console>;
    cell: Cell;
}

machine Cell::get() -> i32 {
    transition { _ -> done() }
    state done() -> i32 { 70 }
}

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 41;
    let result: i32 = Cell::get();
    main.console.exit_process(result);
}
