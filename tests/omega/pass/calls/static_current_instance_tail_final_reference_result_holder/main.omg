// The reference-returning call establishes a captured result holder in step.
// Tail actuals read its field, mutate through it, then transport it last.
// Its descriptor remains available until the checked transfer stages actuals.
// The backing Counter belongs to the caller and survives every cycle.
data Counter { value: u64 in Wrapping; }
data Main { value: u64; }
machine lend(counter: &mut Counter) -> &mut Counter { counter }
machine advance(counter: &mut Counter) -> u64 in Wrapping {
    counter.value = counter.value + 1;
    counter.value
}
machine countdown<const Flag: bool>(remaining: u64, copied: u64 in Wrapping,
    latest: u64 in Wrapping, counter: &mut Counter) -> u64 in Wrapping
where Flag == true
terminates by remaining -> Nat::Descending;
{
    transition remaining > 1 {
        true -> step(remaining - 1, copied, latest, counter)
        false -> copied
    }
    state step(remaining: u64, copied: u64 in Wrapping,
        latest: u64 in Wrapping, counter: &mut Counter) -> u64 in Wrapping
    requires remaining > 0
    {
        let held: &mut Counter = lend(counter);
        countdown<true>(remaining - 1, held.value, advance(held), held)
    }
}
machine Main::main(main: &mut Main) crashes Trap {
    let mut counter: Counter;
    counter.value = 0;
    let result: u64 in Wrapping = countdown<true>(6, 0, 0, &mut counter);
    transition result == 2 && counter.value == 3 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
