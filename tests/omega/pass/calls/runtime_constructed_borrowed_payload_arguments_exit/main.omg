data Sample { value: u64; }
data Reply {
    marker: u64;
    case Values(first: Sample, second: Sample);
    case Empty;
}

machine tick(count: &mut u64) -> u64 {
    count = ((count as u64 in Wrapping) + 1) as u64;
    count
}

machine read(reply: &Reply) -> bool {
    transition reply {
        Reply::Values { marker as _, first, second } ->
            (first.value == 2 && second.value == 1 && reply.marker == 0)
        Reply::Empty -> (reply.marker == 3)
    }
}

machine selected(enabled: bool, count: &mut u64) -> bool {
    enabled && read(Reply::Values {
        second: Sample { value: tick(count) },
        first: Sample { value: tick(count) }
    })
}

machine main() crashes Trap {
    let mut count: u64 = 0;
    let skipped: bool = selected(false, &mut count);
    let produced: bool = selected(true, &mut count);
    let empty: bool = read(Reply::Empty { marker: tick(&mut count) });
    transition skipped == false && produced && empty && count == 3 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
