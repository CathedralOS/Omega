data Output { value: u64; }
data Choice { case Left(value: u64); case Right(value: u64); }
data Counter { order: u64 in Wrapping; }
machine mark(counter: &mut Counter, tag: u64 in Wrapping) -> u64 in Wrapping {
    counter.order = counter.order * 10 + tag;
    tag
}
machine identity(choice: Choice, counter: &mut Counter) -> Choice {
    counter.order = counter.order * 10 + 2;
    choice
}
machine forward(before: u64 in Wrapping, choice: Choice, after: u64 in Wrapping, counter: &mut Counter) -> Choice {
    counter.order = counter.order * 10 + 4;
    choice
}
machine make(value: u64) -> Output { Output { value: value } }
machine choose(choice: Choice, counter: &mut Counter) -> Output {
    transition forward(mark(counter, 1), identity(choice, counter), mark(counter, 3), counter) {
        Choice::Left { value } -> make(value)
        Choice::Right { value } -> make(value)
    }
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { order: 0 };
    let first: Output = choose(Choice::Left { value: 70 }, &mut counter);
    let second: Output = choose(Choice::Right { value: 71 }, &mut counter);
    transition first.value == 70 && second.value == 71 && counter.order == 12341234 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
