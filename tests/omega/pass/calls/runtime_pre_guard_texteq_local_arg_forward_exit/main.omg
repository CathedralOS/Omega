// The branch prelude must materialize a call-free text-equality local before
// transition argument capture. Forwarding `x` from the nested edge must see
// the initialized slot rather than its zero-initialized value.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega_language_std::console;
data Store { name: [u8; 8] in Utf8; }
machine Store::check(&mut self, idx: i32) -> bool {
    transition idx == 0 {
        true -> arm_a(idx)
        _ -> arm_b()
    }
    state arm_a(&mut self, idx: i32) -> bool {
        let x: bool = self.name == "omega";
        transition idx == 0 {
            true -> fwd(x)
            _ -> (false)
        }
    }
    state fwd(&mut self, v: bool) -> bool { transition { _ -> (v) } }
    state arm_b(&mut self) -> bool { transition { _ -> (false) } }
}
data Main { console: Console; s: Store; }
machine Main::main(&mut self) {
    self.s.name = "omega";
    let r: bool = self.s.check(0);
    transition r {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
