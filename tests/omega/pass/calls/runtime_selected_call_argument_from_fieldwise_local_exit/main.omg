// A structural local declared without an initializer and established one
// field store at a time is the same call-argument home as one built from a
// whole literal. A selected (`&&`-guarded) consuming call of one of its fields
// is owned by the guard's computation, not scheduled as a statement call.
data Token { value: u64; byte: i32; }
data Pair<Value> { first: Value; second: Value; }

machine consume(token: Token) -> u64 { token.value }

machine fieldwise_then_selected(enabled: bool) -> bool {
    let mut selected: bool = enabled;
    let mut pair: Pair<Token>;
    pair.first = Token { value: 9, byte: 65 };
    pair.second = Token { value: 10, byte: 66 };
    let observed: bool = selected && consume(pair.first) == 9;
    selected = !selected;
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && pair.second.value == 10 && youngest.value == 11
}

machine selected_during_construction(enabled: bool) -> bool {
    let mut selected: bool = enabled;
    let mut pair: Pair<Token>;
    pair.first = Token { value: 9, byte: 65 };
    let observed: bool = selected && consume(pair.first) == 9;
    selected = !selected;
    pair.second = Token { value: 10, byte: 66 };
    let youngest: Token = Token { value: 11, byte: 67 };
    (observed == enabled) && selected != enabled && pair.second.value == 10 && youngest.value == 11
}

machine verify(accepted: bool) crashes Trap {
    transition accepted { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    verify(fieldwise_then_selected(false));
    verify(fieldwise_then_selected(true));
    verify(selected_during_construction(false));
    verify(selected_during_construction(true));
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
