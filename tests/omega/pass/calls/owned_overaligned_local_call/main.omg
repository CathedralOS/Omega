use omega::language::core::layout;

public data Words [copy] { first: u64; second: u64; third: u64; }


public Aligned32 satisfies FixedLayout<Words> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 16 } };
    LayoutPlan { entries: entries, entry_count: 3, size_fixed: 32, size_is_dynamic: false, align: 32 }
}
}

public Aligned64 satisfies FixedLayout<Words> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 16 } };
    LayoutPlan { entries: entries, entry_count: 3, size_fixed: 64, size_is_dynamic: false, align: 64 }
}
}

machine select_values(first: LayoutStorage<Words, Aligned32>, second: LayoutStorage<Words, Aligned64>) -> LayoutStorage<Words, Aligned64> {
    let mut result: LayoutStorage<Words, Aligned64>;
    result.first = first.third;
    result.second = second.first;
    result.third = first.second;
    result
}

machine main() crashes Trap {
    let mut first: LayoutStorage<Words, Aligned32>;
    let mut second: LayoutStorage<Words, Aligned64>;
    first.first = 17;
    first.second = 91;
    first.third = 43;
    second.first = 101;
    second.second = 202;
    second.third = 303;
    let result: LayoutStorage<Words, Aligned64> = select_values(first, second);
    transition result.first == 43 && result.second == 101 && result.third == 91
        && first.first == 17 && first.second == 91 && first.third == 43
        && second.first == 101 && second.second == 202 && second.third == 303 {
        true -> done()
        _ -> failed()
    }
    machine done() { }
    machine failed() { crash Trap; }
}
