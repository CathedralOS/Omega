// RUN CANARY (exit 70) + interpreter differential. The binary value is first
// stored in a local, then passed to a state-machine call from a state whose
// guarded re-entry proves the ranged `index` parameter. Selection must copy
// the local slot; re-expanding its initializer as an unlowered CallArgument is
// neither necessary nor sound.
use omega_language_std::console;
data CellId { case Empty; case R00; case R01; case R02; case R03; }
data Room { cell: CellId; tag: i32; }
data Level { rooms: [Room; 4]; room_count: u64; }
data Builder { }
data Main { console: Console; builder: Builder; level: Level; }

machine Main::main(&mut self) {
    self.builder.build(&mut self.level);
    transition self.level.rooms[2].tag == 103 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
machine Builder::build(&mut self, level: &mut Level) {
    level.room_count = 4;
    transition { _ -> carve_at(level, 0) }
    state carve_at(&mut self, level: &mut Level, index: u64 [0..=3]) {
        let tag: i32 = 100 + index;
        self.carve(level, tag);
        let next: u64 = index + 1;
        transition next < 4 { true -> carve_at(level, next) false -> {} }
    }
}
machine Builder::carve(&mut self, level: &mut Level, tag: i32) {
    let rooms: &mut [Room] = level.rooms.as_mut_slice();
    rooms[2].tag = tag;
}
