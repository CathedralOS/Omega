// RUN CANARY (exit 70) + interpreter differential. The binary value is first
// stored in a local, then passed to a state-machine call from a state whose
// guarded re-entry proves the `index <= 3` arrival requirement. Selection must copy
// the local slot; re-expanding its initializer as an unlowered CallArgument is
// neither necessary nor sound.
use omega_language_std::console;
data CellId { case Empty; case R00; case R01; case R02; case R03; }
data Room { cell: CellId; tag: i32; }
data Level { rooms: [Room; 4]; room_count: u64; }
data Builder { }
data Main { builder: Builder; level: Level; }

machine Main::main(main: &mut Main) reaches Console {
    Builder::build(&mut main.level);
    transition main.level.rooms[2].tag == 103 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
machine Builder::build(level: &mut Level) {
    level.room_count = 4;
    transition { _ -> carve_at(level, 0) }
    state carve_at(level: &mut Level, index: u64)
    requires index <= 3
    {
        let tag: i32 = 100 + (index as i32);
        carve(level, tag);
        let next: u64 = index + 1;
        transition next < 4 { true -> carve_at(level, next) false -> {} }
    }
}
machine carve(level: &mut Level, tag: i32) {
    let rooms: &mut [Room] = &mut level.rooms[..];
    rooms[2].tag = tag;
}
