// RUN CANARY (exit 70) -- a MACHINE ARRAY passed as a SLICE argument to a
// dispatched value call passing a machine array as a slice argument beside a
// DISJOINT mutable field projection (`Main::pick(&mut main.picked, main.nums, ..)`
// with `nums: [i32; 4]`). Lending the whole subject beside a shared view of its
// own field is refused, correctly, so the two projections compose per argument,
// the element read through the field-carrier idiom. Before the fix
// (2026-07-09m) this shape had NO descriptor strategy: the value fell
// through every arm, and a [i32; 4]'s 16 bytes coincidentally matched the
// descriptor size, so the RAW ARRAY BYTES became the data POINTER -- a
// native SIGSEGV ([u8; 4] took a different wrong path and read garbage).
// Fixed: the bare fixed-array-place arm in slice_descriptors.rs writes the
// {ptr = region_base + offset, len = N} descriptor
// (WriteRuntimeStorageAddressToRuntimeFrame carries the source REGION, so
// machine and frame arrays both relocate). Differential.
use omega_language_std::console;
data Main { nums: [i32; 4]; picked: i32; }
machine Main::pick(picked: &mut i32, s: &[i32], i: u64, j: u64)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32
{
    transition j < i {
        true -> pick(picked, s, i, j + 1)
        false -> leaf(picked, s, j)
    }
    state leaf(picked: &mut i32, s: &[i32], j: u64) -> i32 {
        transition j < s.len { true -> leaf_go(picked, s, j) _ -> leaf_zero() }
    }
    state leaf_go(picked: &mut i32, s: &[i32], j: u64) -> i32 {
        // element -> borrowed scalar destination, then a read terminal.
        picked = s[j];
        transition true { _ -> leaf_out(picked) }
    }
    state leaf_out(picked: &mut i32) -> i32 { picked }
    state leaf_zero() -> i32 { 0 }
}
machine Main::main(main: &mut Main) reaches Console {
    main.nums[0] = 5;
    main.nums[1] = 6;
    main.nums[2] = 7;
    main.nums[3] = 8;
    // Loop to j == 2, then return s[2] == 7.
    let n: i32 = Main::pick(&mut main.picked, main.nums, 2, 0);
    transition n == 7 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
