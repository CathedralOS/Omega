// RUN CANARY (exit 70) -- a MACHINE ARRAY passed as a SLICE argument to a
// dispatched value call (`self.pick(self.nums, ..)` with `nums: [i32; 4]`),
// the element read through the field-carrier idiom. Before the fix
// (2026-07-09m) this shape had NO descriptor strategy: the value fell
// through every arm, and a [i32; 4]'s 16 bytes coincidentally matched the
// descriptor size, so the RAW ARRAY BYTES became the data POINTER -- a
// native SIGSEGV ([u8; 4] took a different wrong path and read garbage).
// Fixed: the bare fixed-array-place arm in slice_descriptors.rs writes the
// {ptr = region_base + offset, len = N} descriptor
// (WriteRuntimeStorageAddressToRuntimeFrame carries the source REGION, so
// machine and frame arrays both relocate). Differential.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; nums: [i32; 4]; picked: i32; }
machine Main::pick(main: &mut Main, s: &[i32], i: u64, j: u64)
terminates by (j, i) -> Nat::BoundedDistance;
-> i32
{
    transition j < i {
        true -> pick(main, s, i, j + 1)
        false -> leaf(main, s, j)
    }
    state leaf(main: &mut Main, s: &[i32], j: u64) -> i32 {
        transition j < s.len { true -> leaf_go(main, s, j) _ -> leaf_zero() }
    }
    state leaf_go(main: &mut Main, s: &[i32], j: u64) -> i32 {
        // The canonical idiom: element -> FIELD, field-read terminal.
        main.picked = s[j];
        transition true { _ -> leaf_out(main) }
    }
    state leaf_out(main: &mut Main) -> i32 { main.picked }
    state leaf_zero() -> i32 { 0 }
}
machine Main::main(main: &mut Main) reaches Console {
    main.nums[0] = 5;
    main.nums[1] = 6;
    main.nums[2] = 7;
    main.nums[3] = 8;
    // Loop to j == 2, then return s[2] == 7.
    let n: i32 = Main::pick(main, main.nums, 2, 0);
    transition n == 7 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
