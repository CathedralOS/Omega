// A static entry forwards its lent context bare into one helper after
// another. Each call reborrows the referent the `context` carrier names; a
// projected store or an earlier helper's writes change that referent's
// contents, never which storage the carrier names, so every later forward
// still reaches the same record.
//
//   entry:  bump(context)        count 0  -> 20
//           context.count += 5   count 20 -> 25
//           add(context, 10)     count 25 -> 35, result 35
//           bump(context)        count 35 -> 55
//   finish: add(context, 5)      count 55 -> 60, result 60 (state parameter)
//           bump(context)        count 60 -> 80
//   exit 80 - 60 + 35 + 15 = 70
//
// Any forward that lands on a snapshot or a stale carrier loses a write and
// misses 70. Expected exit: 70.

use omega_language_std::console;

data Main {
    count: i32 in Wrapping;
}

machine Main::bump(context: &mut Main) {
    context.count = context.count + 20;
}

machine Main::add(context: &mut Main, by: i32 in Wrapping) -> i32 in Wrapping {
    context.count = context.count + by;
    context.count
}

machine Main::main(context: &mut Main) reaches Console {
    Main::bump(context);
    context.count = context.count + 5;
    let first: i32 in Wrapping = Main::add(context, 10);
    Main::bump(context);
    transition { _ -> finish(context, first) }

    state finish(context: &mut Main, first: i32 in Wrapping) {
        let second: i32 in Wrapping = Main::add(context, 5);
        Main::bump(context);
        let code: i32 in Wrapping = context.count - second + first + 15;
        Console::exit_process(code as i32);
    }
}
