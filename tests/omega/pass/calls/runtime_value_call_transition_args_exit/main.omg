// Value-machine calls as DIRECT transition arguments deliver per-argument
// (dispatch path). Pins the three shapes the retired validator stopgap
// rejected: a call beside a literal (a=10, b=7), the SAME callee twice
// (a=10, b=12 -- capture pairing by call ordinal), and two DIFFERENT
// callees (a=10, b=18 -- delivery pairing by argument rank).
// exit 70 = all six params right; 71..76 name the wrong param.
use omega::language::std::console;
data Main { console: Console; k: i32; }
machine Main::dbl(&self, x: i32 in Wrapping) -> i32 in Wrapping {
    let r: i32 in Wrapping = x * 2;
    transition { _ -> r }
}
machine Main::tpl(&self, x: i32 in Wrapping) -> i32 in Wrapping {
    let r: i32 in Wrapping = x * 3;
    transition { _ -> r }
}
machine Main::main(&mut self) {
    self.k = 1;
    transition self.k == 1 { true -> lit_pair(self.dbl(5), 7) _ -> bad(78) }

    state lit_pair(&mut self, a: i32 in Wrapping, b: i32 in Wrapping) {
        transition a == 10 { true -> lit_pair_b(b) _ -> bad(71) }
    }
    state lit_pair_b(&mut self, b: i32 in Wrapping) {
        transition b == 7 { true -> same_pair(self.dbl(5), self.dbl(6)) _ -> bad(72) }
    }

    state same_pair(&mut self, a: i32 in Wrapping, b: i32 in Wrapping) {
        transition a == 10 { true -> same_pair_b(b) _ -> bad(73) }
    }
    state same_pair_b(&mut self, b: i32 in Wrapping) {
        transition b == 12 { true -> diff_pair(self.dbl(5), self.tpl(6)) _ -> bad(74) }
    }

    state diff_pair(&mut self, a: i32 in Wrapping, b: i32 in Wrapping) {
        transition a == 10 { true -> diff_pair_b(b) _ -> bad(75) }
    }
    state diff_pair_b(&mut self, b: i32 in Wrapping) {
        transition b == 18 { true -> good() _ -> bad(76) }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
