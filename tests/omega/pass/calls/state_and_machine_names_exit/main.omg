// Calls select machines; transition destinations select internal states.
machine finish(value: u64) -> u64 { value }

data Helper {}
machine Helper::run() -> u64 {
    let value: u64 = finish(42);
    transition { _ -> finish(value) }
    state finish(value: u64) -> u64 { 43 }
}

data Main {}
machine Main::main(&mut self) crashes Trap {
    let value: u64 = Helper::run();
    transition value == 43 { true -> done() _ -> bad() }
    state done(&mut self) {}
    state bad(&mut self) { crash Trap; }
}
