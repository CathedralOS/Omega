// RUN CANARY (exit 70). Guards sequential read-modify-write on a self field
// across repeated sub-machine calls: `self.s.total = self.s.total + 1` inside
// `accum()`, called 5 times from `main`, must accumulate to 5.
//
// Registered as a pending miscompile (the stale-static-fold "second face" of
// the scalar-width-rederivation smell -- the read was feared to fold to the
// ZII entry value 0 on every call, emitting a constant store of 1 so total
// stuck at 1, native exit 72). Verified FIXED: the emitted code does a real
// load-add-store per call (`storage@0 = storage@0/4 Add 1`), NOT a constant
// fold, so live storage accumulates. (Closed by the binary-write
// static-value invalidation; the pending entry was stale.) Kept as a RUN
// canary so the regression cannot return silently.
//
// Interpreter and native x64 both exit 70 (total == 5 after 5 increments).

use omega::language::std::console;

data S [copy] {
    // Wrapping DECLARED: an unbounded counter increment is overflow-capable and
    // the nested-field exact check now enforces the decision-17 obligation
    // (no silent wrap). 5 increments never actually wrap.
    total: i32 in Wrapping;
}

data Main {
    console: Console;
    s: S;
}

// Increment self.s.total by 1. When called N times sequentially,
// self.s.total should equal N. On native the stale-fold bug gives total==1.
machine Main::accum(&mut self) {
    self.s.total = self.s.total + 1;
}

machine Main::main(&mut self) {
    self.accum();
    self.accum();
    self.accum();
    self.accum();
    self.accum();

    // Correct: total == 5.
    transition self.s.total == 5 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(72); }
}
