// MR4 ADMISSION (2026-07-20): a MEASURED all-tail mutual pair whose every
// edge PROVES the strict measure decrease (the `m == 0`-guarded base arm +
// `m - 1` tail-argument v1 shape) is ADMITTED -- the dispatch loop lowers
// every transition arm target as a SetDispatchState jump over ONE overlaid
// frame region, so the cycle runs on CONSTANT stack. n = 100000 keeps the
// interpreter oracle inside its 10M-step budget; the native TCO witness is
// the 40M-alternation probe (recorded in the ledger) -- the lowering has NO
// call instruction at all, only SetDispatchState jumps.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let r: u64 = Main::ping(main, 100000);
    transition r == 0 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
machine Main::ping(main: &mut Main, n: u64)
terminates by n;
-> u64
{
    transition n == 0 {
        true -> (0)
        _ -> Main::pong(main, n - 1)
    }
}
machine Main::pong(main: &mut Main, n: u64)
terminates by n;
-> u64
{
    transition n == 0 {
        true -> (0)
        _ -> Main::ping(main, n - 1)
    }
}
