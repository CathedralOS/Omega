// Expected exit: 0
machine identity(value: u64) -> u64 { 0 }
machine main() crashes Trap {
    let observed: u64 = forward(42);
    transition observed == 42 { true -> good() _ -> bad() }
    machine forward(value: u64) -> u64 {
        let copied: u64 = identity(value);
        (copied)
        machine identity(value: u64) -> u64 { value }
    }
    machine good() {}
    machine bad() crashes Trap { crash Trap; }
}
