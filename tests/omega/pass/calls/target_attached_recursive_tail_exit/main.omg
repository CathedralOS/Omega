// Expected exit: 0. Exact declaration-qualified target recursion is a
// constant-stack transfer. Another method's private state named walk does not
// make the entry overload set ambiguous.
public machine tick() -> bool blocks; terminates; { true }
data Walker {}

boundary trait SelectedWalkerWalk {
    machine walk(remaining: u64) -> u64 reaches
requires remaining <= 4;
ensures result == 0;
terminates;
}
CheckedWalkerWalk satisfies SelectedWalkerWalk {
    machine walk(remaining: u64) -> u64
requires remaining <= 4;
ensures result == 0;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        let ready: bool = block tick();
        transition ready { true -> block CheckedWalkerWalk::walk(remaining - 1) false -> 0 }
    }
}
}







machine Walker::unrelated() -> u64 {
    transition { _ -> walk() }
    machine walk() -> u64 { 1 }
}
machine main() crashes Trap {
    let value: u64 = block SelectedWalkerWalk::walk(4);
    let other: u64 = Walker::unrelated();
    transition value == 0 && other == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
