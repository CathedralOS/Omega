// Expected exit: 0. Exact declaration-qualified target recursion is a
// constant-stack transfer. Another method's private state named walk does not
// make the entry overload set ambiguous.
public machine tick() -> bool blocks; terminates; { true }
data Walker {}

windows_x86_64 machine Walker::walk(remaining: u64) -> u64
requires remaining <= 4;
ensures result == 0;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        let ready: bool = block tick();
        transition ready { true -> block Walker::walk(remaining - 1) false -> 0 }
    }
}

linux_x86_64 machine Walker::walk(remaining: u64) -> u64
requires remaining <= 4;
ensures result == 0;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        let ready: bool = block tick();
        transition ready { true -> block Walker::walk(remaining - 1) false -> 0 }
    }
}

macos_arm64 machine Walker::walk(remaining: u64) -> u64
requires remaining <= 4;
ensures result == 0;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        let ready: bool = block tick();
        transition ready { true -> block Walker::walk(remaining - 1) false -> 0 }
