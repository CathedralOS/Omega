linux_arm64 machine Walker::walk(remaining: u64) -> u64
requires remaining <= 4;
ensures result == 0;
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> 0 }
    machine step(remaining: u64) -> u64 requires remaining > 0 && remaining <= 4 {
        let ready: bool = block tick();
        transition ready { true -> block Walker::walk(remaining - 1) false -> 0 }
    }
}

machine Walker::unrelated() -> u64 {
    transition { _ -> walk() }
    machine walk() -> u64 { 1 }
}
machine main() crashes Trap {
    let value: u64 = block Walker::walk(4);
    let other: u64 = Walker::unrelated();
    transition value == 0 && other == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
