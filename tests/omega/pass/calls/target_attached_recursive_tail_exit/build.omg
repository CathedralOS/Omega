machine build(builder: &mut Build) {
    Build::select_provider<SelectedWalkerWalk, CheckedWalkerWalk>(builder, windows_x86_64);
    Build::select_provider<SelectedWalkerWalk, CheckedWalkerWalk>(builder, linux_x86_64);
    Build::select_provider<SelectedWalkerWalk, CheckedWalkerWalk>(builder, macos_arm64);
    Build::select_provider<SelectedWalkerWalk, CheckedWalkerWalk>(builder, linux_arm64);

    Build::application(builder, "target_attached_recursive_tail_exit");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
