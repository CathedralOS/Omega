    value: u32 in Saturating,
    divisor: u32 in Saturating
) -> u32 in Saturating
requires 0u32 == 0u32
ensures 0u32 == 0u32
{
    transition 1u32 <= divisor {
        true -> finish_saturating_remainder_guarded_right(value % divisor)
        _ -> finish_saturating_remainder_guarded_right(0u32)
    }

    state finish_saturating_remainder_guarded_right(value: u32 in Saturating) -> u32 in Saturating {
        value
    }
}

machine terminal_exact_divide_guarded_negative_right(value: i32, divisor: i32) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
{
    transition divisor <= -2i32 {
        true -> finish_exact_divide_guarded_negative_right(value / divisor)
        _ -> finish_exact_divide_guarded_negative_right(0i32)
    }

    state finish_exact_divide_guarded_negative_right(value: i32) -> i32 {
        value
    }
}

machine terminal_exact_divide_guarded_negative_one_range(value: i32, divisor: i32) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
{
    transition divisor <= -1i32 {
        true -> prove_exact_divide_negative_one_dividend(value, divisor)
        _ -> finish_exact_divide_negative_one_range(0i32)
    }

    state prove_exact_divide_negative_one_dividend(value: i32, divisor: i32) -> i32 {
        transition -2147483647i32 <= value {
            true -> finish_exact_divide_negative_one_range(value / divisor)
            _ -> finish_exact_divide_negative_one_range(0i32)
        }
    }

    state finish_exact_divide_negative_one_range(value: i32) -> i32 {
        value
    }
}

machine terminal_wrapping_divide_guarded_negative_one_range(
    value: i32 in Wrapping,
    divisor: i32 in Wrapping
) -> i32 in Wrapping
requires 0i32 == 0i32
ensures 0i32 == 0i32
{
    transition divisor <= -1i32 {
        true -> finish_wrapping_divide_negative_one_range(value / divisor)
        _ -> finish_wrapping_divide_negative_one_range(0i32)
    }

    state finish_wrapping_divide_negative_one_range(value: i32 in Wrapping) -> i32 in Wrapping {
        value
    }
}

machine terminal_boolean_not_equal_runtime(left: bool, right: bool) -> bool
requires true == true
ensures true == true
{
    left != right
}

machine terminal_boolean_and(left: bool, right: bool) -> bool
requires true == true
ensures true == true
{
    left && right
}

machine terminal_boolean_or(left: bool, right: bool) -> bool
requires true == true
ensures true == true
{
    left || right
}

machine terminal_boolean_equal_and_equal(first: bool, second: bool, third: bool) -> bool
requires true == true
ensures true == true
{
    (first == second) && (second == third)
}

machine terminal_boolean_short_circuit_equality(
    first: bool,
    second: bool,
    third: bool
) -> bool
requires true == true
ensures true == true
{
    (first && second) == (second || third)
}

machine terminal_ninth_boolean(
    first: bool,
    second: bool,
    third: bool,
    fourth: bool,
    fifth: bool,
    sixth: bool,
    seventh: bool,
    eighth: bool,
    ninth: bool
) -> bool
requires true == true
ensures true == true
{
    ninth
}

machine terminal_boolean_chain(
    first: bool,
    second: bool,
    third: bool,
    fourth: bool,
    fifth: bool,
    sixth: bool,
    seventh: bool,
    eighth: bool,
    ninth: bool
) -> bool
requires true == true
ensures true == true
{
    transition { _ -> carry(ninth) }
    state carry(value: bool) -> bool {
        transition { _ -> finish(value) }
    }
    state finish(value: bool) -> bool { value }
}

machine terminal_boolean_chain_short_circuit_return(value: bool) -> bool
requires true == true
ensures true == true
{
    transition { _ -> finish(value) }
    state finish(value: bool) -> bool { value || !value }
}

machine terminal_boolean_chain_short_circuit_binding(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    transition { _ -> carry(first && second) }
    state carry(value: bool) -> bool {
        transition { _ -> finish(value) }
    }
    state finish(value: bool) -> bool { value }
}

machine terminal_boolean_chain_short_circuit_tuple(
    first: bool,
    second: bool,
    third: bool,
    fourth: bool
) -> bool
requires true == true
ensures true == true
{
    transition { _ -> bind_tuple(first, second, third, fourth) }
    state bind_tuple(first: bool, second: bool, third: bool, fourth: bool) -> bool {
        transition { _ -> finish_tuple(first || second, third && fourth) }
    }
    state finish_tuple(any: bool, both: bool) -> bool { any == both }
}

machine terminal_boolean_tuple_wrong_contract() -> bool
requires false == false
ensures false == false
{
    transition { _ -> carry_known_tuple(true, false) }
    state carry_known_tuple(first: bool, second: bool) -> bool {
        transition { _ -> finish_known_tuple(first || second, second) }
    }
    state finish_known_tuple(any: bool, both: bool) -> bool { any }
}

machine terminal_boolean_chain_wrong_contract() -> bool
requires false == false
ensures false == false
{
    transition { _ -> finish(true) }
    state finish(value: bool) -> bool { value }
}

machine terminal_abort() -> i32
crashes Abort
{
    crash Abort;
}

machine terminal_explicit_true_abort() -> i32
crashes Abort
    true
{
    crash Abort;
}

machine terminal_wide_trap() -> i32
crashes Trap
{
    crash Trap;
}

machine terminal_path_guarded_trap(flag: bool) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
crashes Trap
    flag
{
    transition {
        flag -> fail()
        _ -> succeed()
    }

    state fail() -> i32 {
        crash Trap;
    }

    state succeed() -> i32 { 0i32 }
}

machine terminal_integer_guarded_trap(
    value: i32 in Wrapping,
    limit: i32 in Wrapping
) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
crashes Trap
    value + 1i32 >= limit
{
    transition {
        value + 1i32 >= limit -> fail()
        _ -> succeed()
    }

    state fail() -> i32 {
        crash Trap;
    }

    state succeed() -> i32 { 0i32 }
}

machine terminal_transitive_guarded_trap(left: i32, middle: i32, right: i32) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
crashes Trap
    left < right
{
    transition {
        left < middle && middle <= right -> fail()
        _ -> succeed()
    }

    state fail() -> i32 {
        crash Trap;
    }

    state succeed() -> i32 { 0i32 }
}

machine terminal_implied_guarded_trap(flag: bool) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
crashes Trap
    flag
{
    transition {
        !!flag -> fail()
        _ -> succeed()
    }

    state fail() -> i32 {
        crash Trap;
    }

    state succeed() -> i32 { 0i32 }
}

machine terminal_unpublished_abort() -> i32 {
    crash Abort;
}

data Main {}
machine Main::main(&mut self) {}
