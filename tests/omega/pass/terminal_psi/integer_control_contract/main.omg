machine terminal_boolean_guarded_trap(flag: bool) -> bool
requires true == true
ensures true == true
crashes Trap
    flag
{
    transition flag {
        true -> fail_boolean()
        _ -> succeed_boolean()
    }

    state fail_boolean() -> bool {
        crash Trap;
    }

    state succeed_boolean() -> bool { true }
}

machine terminal_two_crash_leaves(trap: bool, abort: bool) -> i32
requires 0i32 == 0i32
ensures 0i32 == 0i32
crashes Trap
    trap
crashes Abort
    abort
{
    transition {
        trap -> fail_trap()
        _ -> check_abort(abort)
    }

    state check_abort(abort: bool) -> i32 {
        transition {
            abort -> fail_abort()
            _ -> succeed()
        }
    }

    state fail_trap() -> i32 {
        crash Trap;
    }

    state fail_abort() -> i32 {
        crash Abort;
    }

    state succeed() -> i32 { 0i32 }
}

