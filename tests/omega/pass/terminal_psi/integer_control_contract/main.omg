// Source-to-terminal-Psi canary. The Psi-owned producer lowers these checked
// machines to self-contained semantic modules plus proofs; verification and
// execution then proceed after all frontend trees are dropped.
trait TerminalEvidence {
    machine observe(value: i32) ensures value == value;
}

proposition terminal_relation<T, const Limit: u32, machine Generator>(value: T);

proposition terminal_relation_alias<T, const Limit: u32, machine Generator>(value: T) =
    terminal_relation<T, Limit, Generator>(value);

proposition terminal_witness(value: i32) evidence TerminalEvidence;

machine terminal_proposition_forward()
requires terminal_relation_alias<i32, 7, terminal_constant>(7i32)
ensures terminal_relation_alias<i32, 7, terminal_constant>(7i32)
{
}

machine terminal_constant() -> i32
requires 7i32 == 7i32
ensures 7i32 == 7i32
{
    transition { _ -> pass(7i32) }
    state pass(value: i32) -> i32 { 7i32 }
}

machine terminal_direct_integer_constant() -> u8
requires 42u8 == 42u8
ensures 42u8 == 42u8
{
    42u8
}

machine terminal_exact_literal_narrowing() -> u8
requires 127u8 == 127u8
ensures 127u8 == 127u8
{
    127u64 as u8
}

machine terminal_guarded_exact_narrow(value: u64, ignored: u64) -> u8
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition value <= 255u64 {
        true -> finish(value as u8)
        _ -> finish(0u8)
    }

    state finish(value: u8) -> u8 { value }
}

machine terminal_address_reflexive(value: addr) -> bool
requires true == true
ensures true == true
{
    value == value
}

machine terminal_closed_integer_chain() -> u8 in Wrapping
requires 42u8 == 42u8
ensures 42u8 == 42u8
{
    transition { _ -> add(10u8) }
    state add(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value + 20u8) }
    }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value + 12u8 }
}

// The legacy checked-tree prover accepts this unrelated reflexive contract;
// the terminal producer must recompute the closed chain and reject it.
machine terminal_closed_integer_chain_wrong_contract() -> u8 in Wrapping
requires 41u8 == 41u8
ensures 41u8 == 41u8
{
    transition { _ -> add(10u8) }
    state add(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value + 20u8) }
    }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value + 12u8 }
}

machine terminal_known_integer_graph_wrong_contract() -> u8 in Wrapping
requires 8u8 == 8u8
ensures 8u8 == 8u8
{
    transition 1u8 < 2u8 {
        true -> selected_known_integer(7u8)
        _ -> ignored_known_integer(9u8)
    }
    state selected_known_integer(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish_known_integer(value) }
    }
    state ignored_known_integer(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish_known_integer(value) }
    }
    state finish_known_integer(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_known_boolean_binding_wrong_contract() -> u8 in Wrapping
requires 8u8 == 8u8
ensures 8u8 == 8u8
{
    transition { _ -> select_known_boolean(true && false, 7u8, 9u8) }
    state select_known_boolean(
        condition: bool,
        high: u8 in Wrapping,
        low: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition condition {
            true -> finish_known_boolean(high)
            _ -> finish_known_boolean(low)
        }
    }
    state finish_known_boolean(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_wrapping_add() -> u8 in Wrapping
requires 44u8 == 44u8
ensures 44u8 == 44u8
{
    transition { _ -> calculate(200u8) }
    state calculate(value: u8 in Wrapping) -> u8 in Wrapping { value + 100u8 }
}

machine terminal_scalar_locals(value: u8 in Wrapping) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    let incremented: u8 in Wrapping = value + 5u8;
    let doubled: u8 in Wrapping = incremented * 2u8;
    doubled
}

machine terminal_boolean_local(value: bool) -> bool
requires true == true
ensures true == true
{
    let inverted: bool = !value;
    inverted
}

machine terminal_call_identity(value: bool) -> bool
requires true == true
ensures true == true
{
    value
}

machine terminal_call_second(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    second
}

machine terminal_call_forward(flag: bool) -> bool
requires true == true
ensures true == true
{
    let forwarded: bool = terminal_call_identity(flag);
    forwarded
}

machine terminal_call_short_argument(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let forwarded: bool = terminal_call_second(first && second, first || second);
    forwarded
}

machine terminal_call_guarded_callee(flag: bool) -> bool
requires true == true
ensures true == true
crashes Trap
    flag
{
    transition flag {
        true -> fail()
        _ -> succeed()
    }

    state fail() -> bool {
        crash Trap;
    }

    state succeed() -> bool { false }
}

machine terminal_call_guarded_caller(flag: bool) -> bool
requires true == true
ensures true == true
crashes Trap
{
    let forwarded: bool = !flag;
    let result: bool = terminal_call_guarded_callee(forwarded);
    result
}

machine terminal_call_guarded_first(first: bool, second: bool, third: bool) -> bool
requires true == true
ensures true == true
crashes Trap
    !third
{
    transition !third {
        true -> fail()
        _ -> succeed()
    }

    state fail() -> bool {
        crash Trap;
    }

    state succeed() -> bool { false }
}

machine terminal_call_short_guarded(first: bool, second: bool) -> bool
requires true == true
ensures true == true
crashes Trap
{
    let result: bool = terminal_call_guarded_first(first, !(first && second), first && second);
    result
}

machine terminal_short_circuit_boolean_local(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    joined
}

machine terminal_consumed_short_circuit_boolean_local(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    !joined
}

machine terminal_reused_short_circuit_boolean_local(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    joined == joined
}

machine terminal_branched_short_circuit_boolean_local(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    transition joined {
        true -> joined_true()
        _ -> joined_false()
    }

    state joined_true() -> bool { true }
    state joined_false() -> bool { false }
}

machine terminal_two_short_circuit_boolean_locals(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    let either: bool = first || second;
    joined == either
}

machine terminal_short_circuit_local_then_short_circuit_return(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    joined || first
}

machine terminal_short_circuit_local_jump(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    transition { _ -> finish_short_circuit_local_jump(joined) }

    state finish_short_circuit_local_jump(value: bool) -> bool { value }
}

machine terminal_short_circuit_local_nested_jump(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    transition { _ -> finish_short_circuit_local_nested_jump(joined || first) }

    state finish_short_circuit_local_nested_jump(value: bool) -> bool { value }
}

machine terminal_short_circuit_local_nested_jump_tuple(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    transition {
        _ -> finish_short_circuit_local_nested_jump_tuple(
            joined || first,
            joined && second
        )
    }

    state finish_short_circuit_local_nested_jump_tuple(left: bool, right: bool) -> bool {
        left == right
    }
}

machine terminal_short_circuit_local_conditional_edge(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    transition first {
        true -> finish_short_circuit_local_conditional_edge(joined || first)
        _ -> finish_short_circuit_local_conditional_edge(joined && second)
    }

    state finish_short_circuit_local_conditional_edge(value: bool) -> bool { value }
}

machine terminal_short_circuit_local_guard(first: bool, second: bool) -> bool
requires true == true
ensures true == true
{
    let joined: bool = first && second;
    transition joined || first {
        true -> finish_short_circuit_local_guard(true)
        _ -> finish_short_circuit_local_guard(false)
    }

    state finish_short_circuit_local_guard(value: bool) -> bool { value }
}

machine terminal_short_circuit_local_crash(first: bool, second: bool) -> bool
crashes Abort
{
    let joined: bool = first && second;
    crash Abort;
}

machine terminal_saturating_add() -> u8 in Saturating
requires 255u8 == 255u8
ensures 255u8 == 255u8
{
    transition { _ -> calculate(200u8) }
    state calculate(value: u8 in Saturating) -> u8 in Saturating { value + 100u8 }
}

machine terminal_wrapping_subtract() -> u8 in Wrapping
requires 251u8 == 251u8
ensures 251u8 == 251u8
{
    transition { _ -> calculate(5u8) }
    state calculate(value: u8 in Wrapping) -> u8 in Wrapping { value - 10u8 }
}

machine terminal_saturating_subtract() -> u8 in Saturating
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition { _ -> calculate(5u8) }
    state calculate(value: u8 in Saturating) -> u8 in Saturating { value - 10u8 }
}

machine terminal_wrapping_multiply() -> u8 in Wrapping
requires 4u8 == 4u8
ensures 4u8 == 4u8
{
    transition { _ -> calculate(20u8) }
    state calculate(value: u8 in Wrapping) -> u8 in Wrapping { value * 13u8 }
}

machine terminal_saturating_multiply() -> u8 in Saturating
requires 255u8 == 255u8
ensures 255u8 == 255u8
{
    transition { _ -> calculate(20u8) }
    state calculate(value: u8 in Saturating) -> u8 in Saturating { value * 13u8 }
}

machine terminal_ninth_parameter(
    first: u8,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8
) -> u8
requires 77u8 == 77u8
ensures 77u8 == 77u8
{
    ninth
}

machine terminal_runtime_wrapping_add(
    first: u8 in Wrapping,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 44u8 == 44u8
ensures 44u8 == 44u8
{
    ninth + first
}

machine terminal_runtime_nested_wrapping(
    first: u8 in Wrapping,
    second: u8 in Wrapping,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 132u8 == 132u8
ensures 132u8 == 132u8
{
    (ninth + first) * second
}

machine terminal_runtime_jump_wrapping(
    first: u8 in Wrapping,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 135u8 == 135u8
ensures 135u8 == 135u8
{
    transition { _ -> finish(ninth + first) }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value * 3u8 }
}

machine terminal_runtime_chain_wrapping(
    first: u8 in Wrapping,
    second: u8,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 134u8 == 134u8
ensures 134u8 == 134u8
{
    transition { _ -> multiply(ninth + first) }
    state multiply(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value * 3u8) }
    }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value - 1u8 }
}

machine terminal_runtime_multi_binding(
    first: u8 in Wrapping,
    second: u8 in Wrapping,
    third: u8,
    fourth: u8,
    fifth: u8,
    sixth: u8,
    seventh: u8,
    eighth: u8,
    ninth: u8 in Wrapping
) -> u8 in Wrapping
requires 137u8 == 137u8
ensures 137u8 == 137u8
{
    transition { _ -> combine(ninth + first, second + 1u8) }
    state combine(left: u8 in Wrapping, right: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(left * right, right - 1u8) }
    }
    state finish(product: u8 in Wrapping, adjustment: u8 in Wrapping) -> u8 in Wrapping {
        product + adjustment
    }
}

machine terminal_runtime_conditional(
    condition: bool,
    when_true: u8 in Wrapping,
    when_false: u8 in Wrapping
) -> u8 in Wrapping
requires 17u8 == 17u8
ensures 17u8 == 17u8
{
    transition condition {
        true -> selected_true(when_true, when_false)
        _ -> selected_false(when_false, when_true)
    }
    state selected_true(value: u8 in Wrapping, adjustment: u8 in Wrapping) -> u8 in Wrapping {
        value + adjustment + 3u8
    }
    state selected_false(value: u8 in Wrapping, factor: u8 in Wrapping) -> u8 in Wrapping {
        value * factor + 2u8
    }
}

machine terminal_nested_integer_branch(
    first: bool,
    second: bool,
    high: u8 in Wrapping,
    middle: u8 in Wrapping,
    low: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition first {
        true -> first_selected(second, high, middle)
        _ -> low_selected(low)
    }
    state first_selected(
        second: bool,
        high: u8 in Wrapping,
        middle: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition second {
            true -> high_selected(high)
            _ -> middle_selected(middle)
        }
    }
    state high_selected(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value) }
    }
    state middle_selected(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value) }
    }
    state low_selected(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish(value) }
    }
    state finish(value: u8 in Wrapping) -> u8 in Wrapping { value + 1u8 }
}

machine terminal_integer_computed_boolean_binding(
    first: bool,
    second: bool,
    high: u8 in Wrapping,
    low: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition { _ -> choose_computed_boolean(first != second, high, low) }
    state choose_computed_boolean(
        different: bool,
        high: u8 in Wrapping,
        low: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition different {
            true -> finish_computed_boolean(high)
            _ -> finish_computed_boolean(low)
        }
    }
    state finish_computed_boolean(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_integer_short_circuit_boolean_binding(
    first: bool,
    second: bool,
    high: u8 in Wrapping,
    low: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition { _ -> choose_short_circuit_boolean(first && second, high, low) }
    state choose_short_circuit_boolean(
        both: bool,
        high: u8 in Wrapping,
        low: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition both {
            true -> finish_short_circuit_boolean(high)
            _ -> finish_short_circuit_boolean(low)
        }
    }
    state finish_short_circuit_boolean(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_integer_conditional_short_circuit_boolean_binding(
    select: bool,
    first: bool,
    second: bool,
    high: u8 in Wrapping,
    low: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition select {
        true -> choose_conditional_short_circuit_boolean(first && second, high, low)
        _ -> skip_conditional_short_circuit_boolean(low)
    }
    state choose_conditional_short_circuit_boolean(
        both: bool,
        high: u8 in Wrapping,
        low: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition both {
            true -> finish_conditional_short_circuit_boolean(high)
            _ -> finish_conditional_short_circuit_boolean(low)
        }
    }
    state skip_conditional_short_circuit_boolean(
        value: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition { _ -> finish_conditional_short_circuit_boolean(value) }
    }
    state finish_conditional_short_circuit_boolean(
        value: u8 in Wrapping
    ) -> u8 in Wrapping {
        value
    }
}

machine terminal_unconditional_mixed_scalar_graph(
    first: bool,
    second: bool,
    value: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition { _ -> carry_mixed_scalar(first && second, value) }
    state carry_mixed_scalar(
        both: bool,
        value: u8 in Wrapping
    ) -> u8 in Wrapping {
        transition { _ -> finish_mixed_scalar(both, value + 1u8) }
    }
    state finish_mixed_scalar(
        proof_side_value: bool,
        value: u8 in Wrapping
    ) -> u8 in Wrapping {
        value
    }
}

machine terminal_nested_jump_expression(
    choose_add: bool,
    value: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition choose_add {
        true -> add_selected(value)
        _ -> multiply_selected(value)
    }
    state add_selected(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish_computed(value + 1u8) }
    }
    state multiply_selected(value: u8 in Wrapping) -> u8 in Wrapping {
        transition { _ -> finish_computed(value * 2u8) }
    }
    state finish_computed(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_conditional_edge_expression(
    choose_add: bool,
    value: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition choose_add {
        true -> finish_selected(value + 1u8)
        _ -> finish_selected(value * 2u8)
    }
    state finish_selected(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_short_circuit_edge_expression(
    first: bool,
    second: bool,
    value: u8 in Wrapping
) -> u8 in Wrapping
requires 0u8 == 0u8
ensures 0u8 == 0u8
{
    transition first && second {
        true -> finish_short_selected(value + 1u8)
        _ -> finish_short_selected(value * 2u8)
    }
    state finish_short_selected(value: u8 in Wrapping) -> u8 in Wrapping { value }
}

machine terminal_literal_conditional(value: u8 in Wrapping) -> u8 in Wrapping
requires 20u8 == 20u8
ensures 20u8 == 20u8
{
    transition true {
        true -> selected_true(value)
        _ -> selected_false(value)
    }
    state selected_true(value: u8 in Wrapping) -> u8 in Wrapping { value + 3u8 }
    state selected_false(value: u8 in Wrapping) -> u8 in Wrapping { value * 2u8 }
}

machine terminal_boolean_conditional(
    condition: bool,
    when_true: bool,
    when_false: bool
) -> bool
requires true == true
ensures true == true
{
    transition condition {
        true -> selected_true(when_true)
        _ -> selected_false(when_false)
    }
    state selected_true(value: bool) -> bool { value }
    state selected_false(value: bool) -> bool { value }
}

machine terminal_boolean_conditional_short_circuit_arms(
    condition: bool,
    when_true: bool,
    when_false: bool
) -> bool
requires true == true
ensures true == true
{
    transition condition {
        true -> selected_true(when_true)
        _ -> selected_false(when_false)
    }
    state selected_true(value: bool) -> bool { value && !value }
    state selected_false(value: bool) -> bool { value || !value }
}

machine terminal_boolean_conditional_short_circuit_guard(
    first: bool,
    second: bool,
    fallback: bool
) -> bool
requires true == true
ensures true == true
{
    transition first && second {
        true -> selected_true(first)
        _ -> selected_false(fallback)
    }
    state selected_true(value: bool) -> bool { value }
    state selected_false(value: bool) -> bool { value }
}

machine terminal_nested_boolean_control(
    first: bool,
    second: bool,
    gate: bool,
    high: bool,
    middle: bool,
    low: bool
) -> bool
requires true == true
ensures true == true
{
    transition first && gate {
        true -> inspect_second(second, high, middle)
        _ -> low_selected(low)
    }
    state inspect_second(second: bool, high: bool, middle: bool) -> bool {
        transition second {
            true -> finish_boolean(high)
            _ -> finish_boolean(middle)
        }
    }
    state low_selected(value: bool) -> bool {
        transition { _ -> finish_boolean(value || !value) }
    }
    state finish_boolean(value: bool) -> bool { value || !value }
}

machine terminal_boolean_computed_conditional_edges(
    first: bool,
    second: bool,
    third: bool,
    fourth: bool,
    fallback: bool
) -> bool
requires true == true
ensures true == true
{
    transition first && second {
        true -> staged_boolean_edge(first || third, third && fourth)
        _ -> direct_boolean_edge(!fallback, fallback)
    }
    state staged_boolean_edge(any: bool, both: bool) -> bool {
        transition { _ -> finish_boolean_edge(any, both) }
    }
    state direct_boolean_edge(inverted: bool, original: bool) -> bool {
        transition { _ -> finish_boolean_edge(inverted, original) }
    }
    state finish_boolean_edge(left: bool, right: bool) -> bool { left == right }
}

machine terminal_mixed_scalar_boolean_graph(
    choose_less: bool,
    left: u8 in Wrapping,
    right: u8 in Wrapping
) -> bool
requires true == true
ensures true == true
{
    transition { _ -> compare_mixed_scalar(choose_less, left + 1u8, right * 2u8) }
    state compare_mixed_scalar(
        choose_less: bool,
        left: u8 in Wrapping,
        right: u8 in Wrapping
    ) -> bool {
        transition choose_less {
            true -> finish_mixed_boolean(left < right)
            _ -> finish_mixed_boolean(left == right)
        }
    }
    state finish_mixed_boolean(value: bool) -> bool { value }
}

machine terminal_mixed_scalar_boolean_short_circuit(
    first: bool,
    second: bool,
    value: u8 in Wrapping,
    limit: u8 in Wrapping
) -> bool
requires true == true
ensures true == true
{
    transition { _ -> finish_mixed_short_circuit(first && second, value + 1u8, limit) }
    state finish_mixed_short_circuit(
        selected: bool,
