// Structural scalar trait operators: a trait crowns a fixed token on a named
// requirement (`operator < before`), a generic caller resolves the token
// through its evidence binder's selected implementation, the requirement stays
// callable through a named implementation without token syntax, and a concrete
// declaration crowns the canonical token meaning for its operand signature.
trait Ranked<T> {
    operator < before(left: T, right: T) -> bool;
}

data Card { rank: i32; }

Ascending satisfies Ranked<Card> {
    machine before(left: Card, right: Card) -> bool {
        left.rank < right.rank
    }
}

machine choose<Element, Order satisfies Ranked<Element>>(
    left: Element,
    right: Element
) -> bool {
    left < right
}

machine named_requirement_call(left: Card, right: Card) -> bool {
    Ascending::before(left, right)
}

machine < Card::less_by_rank(left: Card, right: Card) -> bool {
    left.rank < right.rank
}

machine crowned_less(left: Card, right: Card) -> bool {
    left < right
}

machine main()
terminates;
{
}
