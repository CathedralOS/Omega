machine build(builder: &mut Build) {
    Build::application(builder, "content_custody_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<PortIo, RegionPort>(builder, linux_arm64);
    Build::select_provider<PortIo, RegionPort>(builder, linux_x86_64);
    Build::select_provider<PortIo, RegionPort>(builder, macos_arm64);
    Build::select_provider<PortIo, RegionPort>(builder, macos_x86_64);
    Build::select_provider<PortIo, RegionPort>(builder, windows_x86_64);
    Build::select_provider<PortIo, RegionPort>(builder, uefi_x86_64);
    Build::select_provider<PortIo, RegionPort>(builder, cross_platform_cli);
    Build::select_provider<PortIo, RegionPort>(builder, local_unchecked);
    Build::select_provider<PortIo, RegionPort>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
