// A RUN canary in shape as well as name: `Root::main` establishes an owned
// `Region` and invokes `Root::enter`, whose `reaches PortIo` boundary read
// is the subject -- content custody surviving a boundary observation. The
// entry was empty until now, so the `_exit` suffix promised an execution the
// fixture never performed and the declaration was all it pinned.
//
// The owned input is CONSTRUCTED here, which is legal because
// `domain Region::Owned` names no `established by` clause. A domain gated by
// one -- as in `core/content_retained_custody_round_trip`, whose
// `Buffer::Owned` is established by `Writer::complete` -- cannot be entered
// this way: "an annotation cannot establish routed qualification", and such a
// fixture waits on BOUNDARY-ISSUANCE for a first claim.
data ByteUnit {}

data CountedQuantity<Unit> {
    magnitude: u64;
}

trait Content<A> {
    machine project(subject: &Self) -> A;
}

pub data Region [linear] {
    length: u64;
}

domain Region::Owned;

machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: region.length }
}

boundary trait PortIo {}

boundary machine Region::read_status(self) -> u8
reaches PortIo
ensures true;

data Root {}

machine Root::enter(region: Region in Owned) -> u8
reaches PortIo
{
    let status: u8 = region.read_status();
    status
}

machine Root::main(&mut self) reaches PortIo {
    let region: Region in Owned = Region { length: 4 };
    _ = Root::enter(region);
}
