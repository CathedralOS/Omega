// COMPILE-ONLY today, despite the `_exit` suffix. That suffix is the run
// canary convention (build, execute, exit 70), and this fixture meets none
// of it: there is no `build.omg`, no console binding, and `Root::main` is
// empty, so nothing invokes `Root::enter` -- the machine that actually
// carries the subject, a `Region in Owned` whose content custody survives a
// `reaches PortIo` boundary read. What it does pin is that the declaration
// and its custody CHECK; the execution the name promises is owed, either by
// giving it an invoking entry and a run harness or by renaming it.
//
// CANARY-CORPUS records the general shape: an empty entry may be an honest
// compile canary or a missing customer, and only the fixture's own stated
// subject separates them. This header is that statement.
data ByteUnit {}

data CountedQuantity<Unit> {
    magnitude: u64;
}

trait Content<A> {
    machine project(subject: &Self) -> A;
}

pub data Region [linear] {
    length: u64;
}

domain Region::Owned;

machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: region.length }
}

boundary trait PortIo {}

boundary machine Region::read_status(self) -> u8
reaches PortIo
ensures true;

data Root {}

machine Root::enter(region: Region in Owned) -> u8
reaches PortIo
{
    let status: u8 = region.read_status();
    status
}

machine Root::main(&mut self) {}
