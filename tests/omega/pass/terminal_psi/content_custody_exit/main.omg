// Expected exit: 70
// An existing unrouted owned claim crosses a selected boundary read. The
// provider observes the original region, consumes it through its owner cleanup,
// and the caller observes the status. Selection creates no fresh authority.
use omega::language::core::content;
use omega::language::core::drop;
use omega_language_std::console;

public data ByteUnit {}

public data Region [linear] {
    length: u64;
}

machine Region::drop(region: &mut Region) {}

public domain Region::Owned;

public machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.length) as Nat }
}

public boundary trait PortIo {
    machine read_status(region: Region in Owned) -> u8;
}

public RegionPort satisfies PortIo {
    machine read_status(region: Region in Owned) -> u8 {
        let expected: bool = region.length == 4;
        drop(region);
        transition expected {
            true -> 47
            _ -> 48
        }
    }
}

data Root {}

machine Root::enter(region: Region in Owned) -> u8
reaches PortIo
{
    let status: u8 = PortIo::read_status(region);
    status
}

machine Root::read_after_local(region: Region in Owned) -> u8 {
    let staged: Region in Owned = region;
    let expected: bool = staged.length == 4;
    drop(staged);
    transition expected {
        true -> 47
        _ -> 48
    }
}

machine observe_region(region: &Region in Owned) -> bool {
    region.length == 4
}

machine Root::read_after_borrow(region: Region in Owned, enabled: bool) -> u8 {
    let expected: bool = enabled && observe_region(&region);
    drop(region);
    transition expected {
        true -> 47
        _ -> 48
    }
}

machine consume_region(region: Region in Owned) -> bool {
    drop(region);
    true
}

machine Root::conditionally_consume(region: Region in Owned, enabled: bool) -> u8 {
    let consumed: bool = enabled && consume_region(region);
    transition consumed {
        true -> 47
        _ -> 48
    }
}

machine main() reaches Console, PortIo {
    let region: Region in Owned = Region { length: 4 };
    let status: u8 = Root::enter(region);
    let another: Region in Owned = Region { length: 4 };
    let local_status: u8 = Root::read_after_local(another);
    let selected: Region in Owned = Region { length: 4 };
    let selected_status: u8 = Root::conditionally_consume(selected, true);
    let skipped: Region in Owned = Region { length: 4 };
    let skipped_status: u8 = Root::conditionally_consume(skipped, false);
    let borrowed: Region in Owned = Region { length: 4 };
    let borrowed_status: u8 = Root::read_after_borrow(borrowed, true);
    transition status == 47 && local_status == 47 && selected_status == 47 && skipped_status == 48 && borrowed_status == 47 {
        true -> good()
        _ -> bad()
    }
    state good() { Console::exit_process(70); }
    state bad() { Console::exit_process(72); }
}
