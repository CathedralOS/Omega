// Expected exit: 70
// The same existing owned claims pass through direct and nested returns, with
// ordinary scratch arguments and locals, before the entry observes their fields
// and discharges each claim exactly once through the owner's cleanup.
use omega::language::core::content;
use omega::language::core::drop;
use omega_language_std::console;

public data ByteUnit {}

public data Region [linear] {
    length: u64;
}

public data WideRegion [linear] {
    base: u64;
    length: u64;
}

data Scratch {
    marker: u64;
}

data EmptyScratch {}

machine Region::drop(region: &mut Region) {}
machine WideRegion::drop(region: &mut WideRegion) {}

public domain Region::Owned;
public domain WideRegion::WideOwned;

public machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.length) as Nat }
}

public machine WideOwned::content(region: &WideRegion) -> CountedQuantity<ByteUnit>
satisfies Content<WideRegion, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.length) as Nat }
}

data Main {}

machine Main::forward(region: Region in Owned) -> Region in Owned {
    region
}

machine Main::through_call(region: Region in Owned) -> Region in Owned {
    Main::forward(region)
}

machine Main::forward_wide(region: WideRegion in WideOwned) -> WideRegion in WideOwned {
    region
}

machine Main::through_call_wide(region: WideRegion in WideOwned) -> WideRegion in WideOwned {
    Main::forward_wide(region)
}

machine Main::forward_and_drop(region: Region in Owned, scratch: Scratch) -> Region in Owned {
    region
}

machine Main::forward_and_drop_eight(
    region: Region in Owned,
    scratch_1: Scratch,
    scratch_2: Scratch,
    scratch_3: Scratch,
    scratch_4: Scratch,
    scratch_5: Scratch,
    scratch_6: Scratch,
    scratch_7: Scratch,
    scratch_8: Scratch
) -> Region in Owned {
    region
}

machine Main::forward_with_local(region: Region in Owned) -> Region in Owned {
    let scratch: EmptyScratch = EmptyScratch {};
    region
}

machine Main::forward_with_two_locals(region: Region in Owned) -> Region in Owned {
    let first: EmptyScratch = EmptyScratch {};
    let second: EmptyScratch = EmptyScratch {};
    region
}

machine Main::forward_with_local_and_drop(
    region: Region in Owned,
    scratch: Scratch
) -> Region in Owned {
    let local: EmptyScratch = EmptyScratch {};
    region
}

machine Main::main(main: &mut Main) reaches Console {
    let original: Region in Owned = Region { length: 4 };
    let forwarded: Region in Owned = Main::forward(original);
    let nested: Region in Owned = Main::through_call(forwarded);
    let scratch: Region in Owned = Main::forward_and_drop(nested, Scratch { marker: 1 });
    let many: Region in Owned = Main::forward_and_drop_eight(
        scratch,
        Scratch { marker: 1 }, Scratch { marker: 2 },
        Scratch { marker: 3 }, Scratch { marker: 4 },
        Scratch { marker: 5 }, Scratch { marker: 6 },
        Scratch { marker: 7 }, Scratch { marker: 8 },
    );
    let local: Region in Owned = Main::forward_with_local(many);
    let locals: Region in Owned = Main::forward_with_two_locals(local);
    let retained: Region in Owned = Main::forward_with_local_and_drop(
        locals, Scratch { marker: 9 },
    );
    let wide: WideRegion in WideOwned = WideRegion { base: 37, length: 6 };
    let direct_wide: WideRegion in WideOwned = Main::forward_wide(wide);
    let retained_wide: WideRegion in WideOwned = Main::through_call_wide(direct_wide);
    let correct: bool = retained.length == 4
        && retained_wide.base == 37 && retained_wide.length == 6;
    drop(retained);
    drop(retained_wide);
    transition correct {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(72); }
}
