// A lineage envelope is an ordinary sum over separately declared era shapes.
// Ordinary case matching selects V1 even though Current is written first.

use omega::language::std::console;

data CounterV1 {
    counter: i32;
}

data Counter {
    count: i32;
    timestamp: i32;
}

data CounterHistory {
    case Invalid;
    case V1(v1: CounterV1);
    case Current(current: Counter);
}

data Main {
    console: Console;
    raw: CounterHistory;
}

machine Main::main(&mut self) {
    let old: CounterV1 = CounterV1 { counter: 0 };
    self.raw = CounterHistory::V1 { v1: old };
    transition self.raw {
        CounterHistory::Invalid -> bad()
        CounterHistory::Current { current } -> new_era(current.count)
        CounterHistory::V1 { v1 } -> old_era(v1.counter)
    }
    state old_era(&mut self, counter: i32) {
        transition counter == 0 {
            true -> good()
            false -> bad()
        }
    }
    state new_era(&mut self, count: i32) {
        self.console.exit_process(72);
    }
    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
