// One `ensures` may list several facts. Each listed fact is its own
// published guarantee with its own exit proof, and a later `requires`
// list consumes them together: `release` needs both `count > 0` (its
// exact subtraction cannot go below zero) and `count <= slots.len`.
data Counter {
    slots: [i32; 4];
    count: u64;
}
machine Counter::reset(counter: &mut Counter)
ensures
    counter.count < counter.slots.len
{
    counter.count = 0;
}
machine Counter::bump(counter: &mut Counter)
requires
    counter.count < counter.slots.len
ensures
    counter.count > 0,
    counter.count <= counter.slots.len
{
    counter.count = counter.count + 1;
}
machine Counter::release(counter: &mut Counter)
requires
    counter.count > 0,
    counter.count <= counter.slots.len
{
    counter.count = counter.count - 1;
}

data Main { counter: Counter; }
machine Main::main(main: &mut Main) {
    Counter::reset(&mut main.counter);
    Counter::bump(&mut main.counter);
    Counter::release(&mut main.counter);
}
