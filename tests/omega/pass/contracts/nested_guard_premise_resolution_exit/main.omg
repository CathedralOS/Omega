// Completed scalar carrier bounds must not recursively replay prior helpers.
// This retains Cathedral dock arithmetic with a runtime branch oracle.
// Expected exit: 0
public machine select_i32(condition: bool, when_true: i32, when_false: i32) -> i32 {
    transition condition {
        true -> (when_true)
        _ -> (when_false)
    }
}

public machine select_sat(condition: bool, when_true: i32 in Saturating, when_false: i32 in Saturating) -> i32 in Saturating {
    transition condition {
        true -> (when_true)
        _ -> (when_false)
    }
}

public machine add_i32(a: i32, b: i32) -> i32 {
    ((a as i32 in Saturating) + (b as i32 in Saturating)) as i32
}

public machine max_sat(a: i32 in Saturating, b: i32 in Saturating) -> i32 in Saturating {
    transition a > b {
        true -> (a)
        _ -> (b)
    }
}


machine columns(first: bool, second: bool, third: bool, canvas: i32 in Saturating, divider: i32 in Saturating, w0: i32 in Saturating, w1: i32 in Saturating, total: i32 in Saturating) -> i32 in Saturating
requires total > 0 {
    let visible: i32 = add_i32(select_i32(first, 1, 0), add_i32(select_i32(second, 1, 0), select_i32(third, 1, 0)));
    let gaps: i32 in Saturating = max_sat((visible - 1) as i32 in Saturating, 0);
    let available: i32 in Saturating = max_sat(canvas - (divider * gaps), 0);
    let first_width: i32 in Saturating = select_sat(first, select_sat(!second && !third, available, (available * w0) / total), 0);
    let remaining: i32 in Saturating = max_sat(available - first_width, 0);
    let second_width: i32 in Saturating = select_sat(second, select_sat(!third, remaining, (available * w1) / total), 0);
    let third_width: i32 in Saturating = select_sat(third, max_sat(remaining - second_width, 0), 0);
    first_width + second_width + third_width
}
machine main() crashes Trap {
    let none: i32 in Saturating = columns(false, false, false, 100, 2, 1, 1, 3);
    let one: i32 in Saturating = columns(true, false, false, 100, 2, 1, 1, 3);
    let two: i32 in Saturating = columns(true, true, false, 100, 2, 1, 1, 3);
    let three: i32 in Saturating = columns(true, true, true, 100, 2, 1, 1, 3);
    let below: i32 in Saturating = max_sat(-7, 0);
    let above: i32 in Saturating = max_sat(5, 0);
    transition none == 0 && one == 100 && two == 98 && three == 96 && below == 0 && above == 5 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
