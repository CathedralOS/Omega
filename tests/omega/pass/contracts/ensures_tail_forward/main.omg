// A named tail return contract: `forward` declares
// `ensures result == 70` and discharges it by forwarding the callee's
// result through a bare tail-call transition arm — the call edge
// forwards `answer`'s own `ensures result == 70`.
machine answer() -> i32
    ensures result == 70
{ 70 }
machine forward() -> i32
    ensures result == 70
{ transition { _ -> answer() } }
data Main { result: i32; }
machine Main::main(main: &mut Main) {
    main.result = forward();
    transition main.result == 70 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
