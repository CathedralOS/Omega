// Expected exit: 0
machine descend(n: u64, previous: u64) -> u64
requires n <= previous && previous <= 1000
terminates by n -> Nat::Descending;
ensures result <= previous
{
    transition n > 0 {
        true -> descend(n - 1, n)
        false -> previous
    }
}


machine main() crashes Trap {
    let result: u64 = descend(3, 9);
    let called_result: u64 = descend_call(3, 9);
    transition result == 1 && called_result == 1 { true -> done() false -> wrong() }
}
machine done() {}
machine wrong() crashes Trap { crash Trap; }

machine descend_call(n: u64, previous: u64) -> u64
requires n <= previous && previous <= 1000
terminates by n -> Nat::Descending;
ensures result <= previous
{
    transition n > 0 {
        true -> descend_call(n - 1, n)
        false -> identity(previous)
    }
}
machine identity(value: u64) -> u64 ensures result == value { value }
