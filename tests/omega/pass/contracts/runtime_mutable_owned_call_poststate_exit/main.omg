machine changed(mut value: i32) -> i32 ensures result == value {
    value = 7i32;
    7i32
}

machine unchanged(value: i32) -> i32 ensures result == value {
    value
}

data Counter { value: i32; }
machine complete(mut counter: Counter) -> i32
ensures counter.value == 8i32 && result == 8i32 {
    counter.value = 8i32;
    8i32
}

machine main() crashes Trap {
    let returned: i32 = changed(1i32);
    let preserved: i32 = unchanged(3i32);
    let completed: i32 = complete(Counter { value: 0i32 });
    asm { observed requires returned == 7i32 && preserved == 3i32 && completed == 8i32: nop }
    transition returned == 7i32 && preserved == 3i32 && completed == 8i32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
