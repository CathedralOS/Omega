// A guard carried back across an intermediate state keeps every conjunct the
// state's writes do not reach. `first` pops `main.a`, which retires the
// guard's `main.a.count` conjuncts but not its `main.b.count` conjuncts, so
// `second` may still pop `main.b` on that guard alone. The same holds through
// separate state parameters.
//
//   first    pops a (7)
//   second   pops b (5)
//   third    pops left (7)
//   fourth   pops right (5)
//
// Exits 24 only when all four pops see their pushed values.

use omega_language_std::console;
use omega::language::core::binding;

data Stack {
    items: [i32; 4];
    count: u64;
}

machine Stack::pop(stack: &mut Stack) -> i32
requires stack.count >= 1 && stack.count <= 4 {
    stack.count = stack.count - 1;
    stack.items[stack.count]
}

data Main {
    a: Stack;
    b: Stack; console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = Stack { items: [7, 0, 0, 0], count: 1 };
    main.b = Stack { items: [5, 0, 0, 0], count: 1 };
    transition main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
        true -> first(&main.console, main)
        _ -> failed(&main.console)
    }
    state first(console: &Binding<Console>, main: &mut Main) {
        let value: i32 = Stack::pop(&mut main.a);
        transition { _ -> second(console, main, value == 7) }
    }
    state second(console: &Binding<Console>, main: &mut Main, matched: bool) {
        let value: i32 = Stack::pop(&mut main.b);
        main.a.count = 1;
        main.b.count = 1;
        transition matched && value == 5
            && main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
            true -> third(console, &mut main.a, &mut main.b)
            _ -> failed(console)
        }
    }
    state third(console: &Binding<Console>, left: &mut Stack, right: &mut Stack) {
        let value: i32 = Stack::pop(left);
        transition { _ -> fourth(console, right, value == 7) }
    }
    state fourth(console: &Binding<Console>, right: &mut Stack, matched: bool) {
        let value: i32 = Stack::pop(right);
        transition matched && value == 5 {
            true -> passed(console)
            _ -> failed(console)
        }
    }
    state passed(console: &Binding<Console>) { Console::exit_process(console, 24); }
    state failed(console: &Binding<Console>) { Console::exit_process(console, 1); }
}
