use omega::language::core::float_operations;
data Reading { case Empty; case Full(value: f64); }
machine read(reading: &Reading) -> f64
requires reading in Reading::Full
crashes Trap reading.value < 0.0 {
    transition reading.value < 0.0 {
        true -> invalid()
        false -> reading.value
    }
    machine invalid() -> f64 { crash Trap; }
}
// Identical payload spellings retain the declaring case through patterns.
data Alternative { case First(value: f64); case Second(marker: u64, value: f64); }
machine select(reading: &Alternative) -> f64 {
    transition reading {
        Alternative::First { value as first } -> first
        Alternative::Second { marker as _, value as second } -> second
    }
}
machine main() crashes Trap {
    let reading: Reading = Reading::Full { value: 2.0 };
    let value: f64 = read(&reading);
    let first: Alternative = Alternative::First { value: 3.0 };
    let second: Alternative = Alternative::Second { marker: 91, value: 4.0 };
    let first_value: f64 = select(&first);
    let second_value: f64 = select(&second);
    transition value == 2.0 && first_value == 3.0 && second_value == 4.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
