// Expected exit: 0. Completing a quoted byte-view argument retains its selected
// parameter carrier and the earlier scalar snapshot used by the next argument.
data Main { record: [u8; 146]; }

public boundary trait Writer {
    machine write(path: &[u8], bytes: &mut [u8]) -> i32 reaches;
}

public ByteWriter satisfies Writer {
    machine write(path: &[u8], bytes: &mut [u8]) -> i32 {
        transition path.len == 1 && bytes.len > 0 {
            true -> write_first(bytes)
            _ -> 1
        }
        state write_first(bytes: &mut [u8]) requires bytes.len > 0; {
            bytes[0] = 17;
            0
        }
    }
}

public boundary trait GenericWriter<Element> {
    machine write(path: &[Element], bytes: &mut [u8]) -> i32 reaches;
}
public GenericByteWriter satisfies GenericWriter<u8> {
    machine write(path: &[u8], bytes: &mut [u8]) -> i32 {
        ByteWriter::write(path, bytes)
    }
}

public boundary trait NestedWriter {
    machine write(paths: [&[u8]; 1], bytes: &mut [u8]) -> i32 reaches;
}
public NestedByteWriter satisfies NestedWriter {
    machine write(paths: [&[u8]; 1], bytes: &mut [u8]) -> i32 {
        ByteWriter::write(paths[0], bytes)
    }
}

windows_x86_64 machine endpoint() -> u64 ensures result >= 129 && result <= 145 { 145 }
linux_x86_64 machine endpoint() -> u64 ensures result >= 129 && result <= 145 { 145 }
macos_arm64 machine endpoint() -> u64 ensures result >= 129 && result <= 145 { 145 }
linux_arm64 machine endpoint() -> u64 ensures result >= 129 && result <= 145 { 129 }

machine Main::main(main: &mut Main) crashes Trap
reaches Writer + GenericWriter + NestedWriter
invokes Writer; invokes GenericWriter; invokes NestedWriter;
{
    main.record[0] = 93;
    let end: u64 = endpoint();
    main.record[end] = 94;
    let status: i32 = Writer::write(".", &mut main.record[1..end]);
    let generic_status: i32 = GenericWriter<u8>::write(".", &mut main.record[1..end]);
    let nested_status: i32 = NestedWriter::write(["."], &mut main.record[1..end]);
    transition status == 0 && generic_status == 0 && nested_status == 0 && main.record[0] == 93
        && main.record[1] == 17 && main.record[end] == 94 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
