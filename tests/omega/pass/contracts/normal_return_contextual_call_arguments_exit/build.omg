machine build(builder: &mut Build) {
    Build::application(builder, "normal_return_contextual_call_arguments");
    Build::select_provider<Writer, ByteWriter>(builder, linux_arm64);
    Build::select_provider<Writer, ByteWriter>(builder, linux_x86_64);
    Build::select_provider<Writer, ByteWriter>(builder, macos_arm64);
    Build::select_provider<Writer, ByteWriter>(builder, macos_x86_64);
    Build::select_provider<Writer, ByteWriter>(builder, windows_x86_64);
    Build::select_provider<Writer, ByteWriter>(builder, uefi_x86_64);
    Build::select_provider<Writer, ByteWriter>(builder, cross_platform_cli);
    Build::select_provider<Writer, ByteWriter>(builder, local_unchecked);
    Build::select_provider<Writer, ByteWriter>(builder, alpha_bootstrap);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, linux_arm64);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, linux_x86_64);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, macos_arm64);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, macos_x86_64);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, windows_x86_64);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, uefi_x86_64);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, cross_platform_cli);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, local_unchecked);
    Build::select_provider<GenericWriter, GenericByteWriter>(builder, alpha_bootstrap);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, linux_arm64);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, linux_x86_64);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, macos_arm64);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, macos_x86_64);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, windows_x86_64);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, uefi_x86_64);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, cross_platform_cli);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, local_unchecked);
    Build::select_provider<NestedWriter, NestedByteWriter>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
}
