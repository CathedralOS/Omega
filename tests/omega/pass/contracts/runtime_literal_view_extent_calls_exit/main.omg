machine two_bytes(bytes: &[u8]) -> u64
requires bytes.len == 2
{
    bytes.len
}

machine no_bytes(bytes: &[u8]) -> u64
requires bytes.len == 0
{
    bytes.len
}

machine main() crashes Trap {
    let saved: &[u8] = "ab";
    let forwarded: &[u8] = saved;
    let direct: u64 = two_bytes("ab");
    let local: u64 = two_bytes(forwarded);
    let embedded_zero: u64 = two_bytes("\0x");
    let encoded: u64 = two_bytes("\xC3\xA9");
    let empty: u64 = no_bytes("");
    let bounded: [u8; 2] in Utf8 = "ab";
    let empty_bounded: [u8; 0] in Utf8 = "";
    let fixed: [u8; 2];
    let bounded_length: u64 = two_bytes(&bounded);
    let bounded_empty_length: u64 = no_bytes(&empty_bounded);
    let fixed_length: u64 = two_bytes(&fixed);
    transition direct == 2 && local == 2 && embedded_zero == 2 && encoded == 2 && empty == 0
        && bounded_length == 2 && bounded_empty_length == 0 && fixed_length == 2 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
domain [u8; 2]::Utf8(bytes)
requires valid_utf8(bytes);

domain [u8; 0]::Utf8(bytes) requires valid_utf8(bytes);
