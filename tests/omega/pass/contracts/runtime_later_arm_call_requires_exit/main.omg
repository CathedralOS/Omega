// A call in a later transition arm passes arguments the refuted earlier arms
// have already bounded. `sum`'s `requires index <= 4` holds for
// `index + 1` after `index >= 4 ->` is refuted, and `step`'s
// `requires count < 10 && count >= 1` holds for `count` once `count == 0`
// and `count >= 10` are refuted.
use omega_language_std::console;

data Main { values: [u32; 4]; }

machine sum(values: &[u32; 4], index: u64, total: u64 in Wrapping) -> u64 in Wrapping
terminates by (index, 4) -> Nat::BoundedDistance;
requires index <= 4
{
    transition {
        index >= 4 -> (total)
        _ -> sum(values, index + 1, total + values[index] as u64 in Wrapping)
    }
}

machine step(count: u64) -> u64
requires count < 10 && count >= 1
{
    transition { _ -> (count * 7) }
}

machine scaled(count: u64) -> u64 {
    transition {
        count == 0 -> (0)
        count >= 10 -> (1)
        _ -> step(count)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.values[0] = 10;
    main.values[1] = 20;
    main.values[3] = 5;
    let total: u64 in Wrapping = sum(&main.values, 0, 0);
    let none: u64 = scaled(0);
    let many: u64 = scaled(12);
    let some: u64 = scaled(5);
    transition total as u64 == 35 && none == 0 && many == 1 && some == 35 {
        true -> reached(main)
        _ -> missed(main)
    }
    state reached(main: &mut Main) { Console::exit_process(70); }
    state missed(main: &mut Main) { Console::exit_process(71); }
}
