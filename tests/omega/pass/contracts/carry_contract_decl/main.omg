// Carry contracts: `[carry(suspension: allowed, cpu: any, thread: any,
// address: movable)]` on data and on a type parameter, a zero-extent array
// `[&i32; 0]` with `[]` literal, and a nested `Portable<Empty>` carry.
data Empty [carry(suspension: allowed, cpu: any, thread: any, address: movable)] {
    elements: [&i32; 0];
    marker: i32;
}
data Portable<T [carry(suspension: allowed, cpu: any, thread: any, address: movable)]>
[carry(suspension: allowed, cpu: any, thread: any, address: movable)] {
    payload: T;
}
data Main { hits: i32 in Wrapping; }
machine Main::main(main: &mut Main) {
    let portable: Portable<Empty> = Portable {
        payload: Empty { elements: [], marker: 42 },
    };
    transition portable.payload.marker == 42 {
        true -> done(main)
        _ -> bad(main)
    }
    machine done(main: &mut Main) {
        main.hits = main.hits + 1;
    }
    machine bad(main: &mut Main) { }
}
