machine window(mut count: u64, values: &[u8]) -> &[u8]
requires values.len == 2u64
ensures result.len == count && result.len == 2u64 {
    count = 2u64;
    values
}

machine main() crashes Trap {
    let values: [u8; 2] = "AB";
    let view: &[u8] = window(1u64, &values);
    asm { observed requires view.len == 2u64: nop }
    transition view.len == 2u64 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
