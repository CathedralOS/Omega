// An effectful call as a `==` operand: the boundary's `requires
// right >= 0` is discharged by the sibling operand's own `ensures
// value >= 0` — `mut` on a machine param lets the param be loaned
// `&mut` inside the body.
boundary machine == Integer::equal(left: i32, right: i32) -> bool
requires right >= 0;

machine prepare(value: &mut i32) -> i32
ensures value >= 0 {
    value = 1;
    0
}

machine compare(mut value: i32) -> bool {
    prepare(&mut value) == value
}

data Main {}

machine Main::main(main: &mut Main) {
    transition compare(5) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
