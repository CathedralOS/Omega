// Expected exit: 0
data Counter { value: u64; }
data View<'storage> { counter: &'storage mut Counter; }
machine capture<'storage>(counter: &'storage mut Counter) -> View<'storage> {
    View { counter: counter }
}
machine consume(counter: &Counter) -> bool requires counter.value == 0 {
    counter.value == 0
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 7 };
    let captured: View = capture(&mut counter);
    let reference: &mut Counter = captured.counter;
    reference.value = 0;
    transition consume(reference) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
