// Expected exit: 0
data Counter { remaining: u64; }
data Wrapper { counter: Counter; }
machine issue() -> Wrapper ensures result.counter.remaining == 32 { Wrapper { counter: Counter { remaining: 32 } } }
machine take(counter: &mut Counter, available: u64, requested: u64) -> u64
requires counter.remaining == available && requested <= available
ensures counter.remaining == available - requested, result == requested
{ counter.remaining = available - requested; requested }
machine consume(counter: &Counter, taken: u64) -> bool
requires counter.remaining == 24, taken == 8
{ counter.remaining == 24 && taken == 8 }
machine main() crashes Trap {
    let initial: Wrapper = issue();
    let mut current: Counter = initial.counter;
    let taken: u64 = take(&mut current, 32, 8);
    transition consume(&current, taken) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
