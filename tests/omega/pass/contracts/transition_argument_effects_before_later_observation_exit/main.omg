// Expected exit: 0. An earlier actual writes before a later scalar actual is observed.
data Cell { value: u64; }
machine replace(cell: &mut Cell) -> bool ensures cell.value == 9 {
    cell.value = 9;
    false
}
public machine finish(ignored: bool, observed: u64) requires observed == 9 crashes Trap {
    transition observed == 9 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 7 };
    transition { _ -> finish(replace(&mut cell), cell.value) }
}
