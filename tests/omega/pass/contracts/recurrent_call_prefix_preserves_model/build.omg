machine build(builder: &mut Build) {
    Build::application(builder, "recurrent_call_prefix_preserves_model");
    Build::select_provider<Poll, ReadOnce>(builder, linux_arm64);
    Build::select_provider<Poll, ReadOnce>(builder, linux_x86_64);
    Build::select_provider<Poll, ReadOnce>(builder, macos_arm64);
    Build::select_provider<Poll, ReadOnce>(builder, macos_x86_64);
    Build::select_provider<Poll, ReadOnce>(builder, windows_x86_64);
    Build::select_provider<Poll, ReadOnce>(builder, uefi_x86_64);
    Build::select_provider<Poll, ReadOnce>(builder, cross_platform_cli);
    Build::select_provider<Poll, ReadOnce>(builder, local_unchecked);
    Build::select_provider<Poll, ReadOnce>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
