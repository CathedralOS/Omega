// Expected exit: 0. A later recurrent arm cannot erase the selected call's premises.
data Status [copy] { code: u64; }
data Device { pending: u64; }
boundary trait Poll {
    machine poll(device: &mut Device) -> Status reaches;
}
ReadOnce satisfies Poll {
    machine poll(device: &mut Device) -> Status {
        let code: u64 = device.pending;
        device.pending = 0;
        Status { code: code }
    }
}
machine read(device: &mut Device, retry: u64) -> u64
reaches Poll
invokes Poll;
requires addr::Bound == 18446744073709551616 && retry <= 1
{
    transition { _ -> inspect(device, retry) }
    machine inspect(device: &mut Device, retry: u64) -> u64
    requires addr::Bound == 18446744073709551616 && retry <= 1
    {
        let status: Status = Poll::poll(device);
        let code: u64 = status.code;
        transition code == 0 {
            true -> finish(retry)
            _ -> inspect(device, retry)
        }
    }
    machine finish(retry: u64) -> u64
    requires addr::Bound == 18446744073709551616 && retry <= 1
    { 42 }
}
machine main() crashes Trap
reaches Poll
invokes Poll;
requires addr::Bound == 18446744073709551616
{
    let mut device: Device = Device { pending: 1 };
    let first: u64 = read(&mut device, 0);
    let second: u64 = read(&mut device, 1);
    transition first == 42 && second == 42 && device.pending == 0 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
