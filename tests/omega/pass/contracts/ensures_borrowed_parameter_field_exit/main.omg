// A guarantee may name a field below a borrowed parameter of another type.
// `Scope::open` resets the caller's `Picker` through `picker: &mut Picker`
// and returns its own record; the caller names that same `Picker` before
// and after the call, so `picker.picks < picker.limit.len` substitutes to the
// caller's place and discharges `Picker::take`'s requirement.
//
//   open   picks 0      ensures picks < limit.len; returns depth 1
//   take   picks 0 -> 1 requires picks < limit.len; returns 1
//
// Exits 70 only when `take` returns 1 and the scope's depth is 1.

use omega_language_std::console;
use omega::language::core::binding;

data Picker {
    limit: [i32; 4];
    picks: u64;
}

data Scope {
    depth: u32;
}

machine Scope::open(picker: &mut Picker) -> Scope
ensures
    picker.picks < picker.limit.len
{
    picker.picks = 0;
    Scope { depth: 1 }
}

machine Picker::take(picker: &mut Picker) -> u64
requires
    picker.picks < picker.limit.len
{
    picker.picks = picker.picks + 1;
    picker.picks
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut picker: Picker;
    let scope: Scope = Scope::open(&mut picker);
    let taken: u64 = Picker::take(&mut picker);
    transition taken == 1 && scope.depth == 1 {
        true -> done(&main.console)
        _ -> failed(&main.console)
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 70); }
    state failed(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
