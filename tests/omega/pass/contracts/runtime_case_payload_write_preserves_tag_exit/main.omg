// Expected exit: 0. Ordinary exclusive payload updates obey the same
// discriminator lifetime as shared atomic events.
data Choice { case Cell(value: u32); case Empty; }
data Envelope { item: Choice; stamp: u32; }
machine make() -> Choice
ensures (result in Choice::Cell) && result.value == 3 {
    Choice::Cell { value: 3 }
}
machine update(choice: &mut Choice)
requires choice in Choice::Cell {
    choice.value = 9;
    let resident: u32 = observe(choice);
}
machine update_nested(envelope: &mut Envelope)
requires envelope.item in Choice::Cell {
    envelope.item.value = 11;
    let resident: u32 = observe(&envelope.item);
}
machine observe(choice: &Choice) -> u32
requires choice in Choice::Cell { choice.value }
machine main() crashes Trap {
    let mut choice: Choice = make();
    choice.value = 7;
    let before: u32 = observe(&choice);
    update(&mut choice);
    let resident: u32 = observe(&choice);
    let mut envelope: Envelope = Envelope {
        item: Choice::Cell { value: 5 }, stamp: 17
    };
    update_nested(&mut envelope);
    let nested: u32 = observe(&envelope.item);
    transition before == 7 && resident == 9 && nested == 11 && envelope.stamp == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
