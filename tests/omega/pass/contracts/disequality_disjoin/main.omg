// In-range disequal indexes select disjoint singleton elements:
// `requires left_index != right_index` supplies the compatibility
// evidence for TWO coexisting `&mut` element loans drawn from one
// `&mut entries[..]` view (the stated relation is evidence, not extra
// loan authority — the equal-index twin is a corpus fail).
data Entry {
    value: i32;
}
data Main {
    entries: [Entry; 2];
}
machine Main::main(main: &mut Main, left_index: u64, right_index: u64)
requires
    left_index <= 1,
    right_index <= 1,
    left_index != right_index
{
    let view: &mut [Entry] = &mut main.entries[..];
    let left: &mut Entry = &mut view[left_index];
    let right: &mut Entry = &mut view[right_index];
    left = Entry { value: 1 };
    right = Entry { value: 2 };
}
