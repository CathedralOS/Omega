data Packet { rows: [[u8; 2]; 2] }

machine letter(packet: &Packet, index: u64) -> u64
requires index < 2 && packet.rows[0][index] >= 97;
{
    (packet.rows[0][index] - 97) as u64
}

machine guarded(packet: &Packet, index: u64) -> u64 {
    transition {
        index >= 2 -> 999
        packet.rows[0][index] < 97 -> 998
        _ -> letter(packet, index)
    }
}

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let packet: Packet = Packet { rows: [[97, 122], [90, 65]] };
    let selected: u64 = guarded(&packet, 1);
    let outside: u64 = guarded(&packet, 2);
    transition selected == 25 && outside == 999 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
