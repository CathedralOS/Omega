// A guarantee may name a field below a borrowed parameter of another
// type: `Scope::open` resets the caller's `Picker` through
// `picker: &mut Picker` and returns its own record; the caller names
// that same `Picker` before and after, so
// `picker.picks < picker.limit.len` substitutes to the caller's place
// and discharges `Picker::take`'s requirement.
data Picker {
    limit: [i32; 4];
    picks: u64;
}
data Scope {
    depth: u32;
}
machine Scope::open(picker: &mut Picker) -> Scope
ensures
    picker.picks < picker.limit.len
{
    picker.picks = 0;
    Scope { depth: 1 }
}
machine Picker::take(picker: &mut Picker) -> u64
requires
    picker.picks < picker.limit.len
{
    picker.picks = picker.picks + 1;
    picker.picks
}

data Main {}
machine Main::main(main: &mut Main) {
    let mut picker: Picker;
    let scope: Scope = Scope::open(&mut picker);
    let taken: u64 = Picker::take(&mut picker);
}
