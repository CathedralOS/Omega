trait Worker {
    machine value(input: u64) -> u64 requires input < 10 terminates;
    machine other(input: u64) -> u64 terminates; requires input < 10;
}

machine value(input: u64) -> u64
terminates;
requires input < 10
ensures result == input {
    input
}

machine ranked(remaining: u64) -> u64
terminates;
terminates by remaining -> Nat::Descending;
{
    remaining
}