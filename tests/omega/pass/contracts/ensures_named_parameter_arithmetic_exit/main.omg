// A named exclusive parameter carries the same live field guarantees as self.
// arm(4) stores 5; tick consumes both guarantees and returns 4.
// Normal exit is 0; an incorrect observed result traps.
data Countdown { remaining: u32 in Wrapping; }

machine Countdown::arm(timer: &mut Countdown, start: u32 in Wrapping)
requires start < 8
ensures
    timer.remaining > 0;
    timer.remaining - 1 < 8
{
    timer.remaining = start + 1;
}

machine Countdown::tick(&mut self) -> u32 in Wrapping
requires
    self.remaining > 0;
    self.remaining - 1 < 8
{
    self.remaining = self.remaining - 1;
    self.remaining
}

data Main { timer: Countdown; }

machine Main::main(&mut self) crashes Trap {
    Countdown::arm(&mut self.timer, 4);
    let remaining: u32 in Wrapping = self.timer.tick();
    transition remaining == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
