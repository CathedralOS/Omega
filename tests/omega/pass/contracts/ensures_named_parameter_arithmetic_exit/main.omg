// A named exclusive parameter carries the same live field guarantees the
// retired receiver did.
// arm(4) stores 5; tick consumes both guarantees and returns 4.
// Normal exit is 0; an incorrect observed result traps.
data Countdown { remaining: u32 in Wrapping; }

machine Countdown::arm(timer: &mut Countdown, start: u32 in Wrapping)
requires start < 8
ensures
    timer.remaining > 0;
    timer.remaining - 1 < 8
{
    timer.remaining = start + 1;
}

machine Countdown::tick(countdown: &mut Countdown) -> u32 in Wrapping
requires
    countdown.remaining > 0;
    countdown.remaining - 1 < 8
{
    countdown.remaining = countdown.remaining - 1;
    countdown.remaining
}

data Main { timer: Countdown; }

machine Main::main(main: &mut Main) crashes Trap {
    Countdown::arm(&mut main.timer, 4);
    let remaining: u32 in Wrapping = Countdown::tick(&mut main.timer);
    transition remaining == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
