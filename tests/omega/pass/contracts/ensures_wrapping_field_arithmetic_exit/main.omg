// A guarantee over a `Wrapping` field keeps the field's own arithmetic:
// `countdown.remaining - 1` subtracts modulo 2^32 in the contract exactly as it
// does in the body. The exit proof of `remaining - 1 < 8` therefore needs
// the no-wrap fact `1 <= remaining` before it may map `remaining < 9` down
// by one; `remaining = start + 1` with `start < 8` supplies both.
//
//   arm(4)  remaining 5   ensures remaining > 0; remaining - 1 < 8
//   tick    remaining 4   requires both facts, returns the new count
//
// Exits 70 only when `tick` returns 4.

use omega_language_std::console;
use omega::language::core::binding;

data Countdown {
    remaining: u32 in Wrapping;
}

machine Countdown::arm(countdown: &mut Countdown, start: u32 in Wrapping)
requires
    start < 8
ensures
    countdown.remaining > 0;
    countdown.remaining - 1 < 8
{
    countdown.remaining = start + 1;
}

machine Countdown::tick(countdown: &mut Countdown) -> u32 in Wrapping
requires
    countdown.remaining > 0;
    countdown.remaining - 1 < 8
{
    countdown.remaining = countdown.remaining - 1;
    countdown.remaining
}

data Main {
    console: Binding<Console>;
    timer: Countdown;
}

machine Main::main(main: &mut Main) reaches Console {
    Countdown::arm(&mut main.timer, 4);
    let left: u32 in Wrapping = Countdown::tick(&mut main.timer);
    transition left == 4 {
        true -> done(main)
        _ -> failed(main)
    }
    state done(main: &mut Main) { main.console.exit_process(70); }
    state failed(main: &mut Main) { main.console.exit_process(71); }
}
