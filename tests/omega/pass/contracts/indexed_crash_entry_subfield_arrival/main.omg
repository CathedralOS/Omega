// Fact: the exact selected element items[index] == 7 discharges the callee's indexed zero crash guard and returns that same 7 without a caller crash ceiling.
// Expected exit: 0
// Place: other_state.
machine maybe_zero(items: &[u64; 2], index: u64) -> u64
requires index < 2
crashes Trap items[index] == 0
{
    transition items[index] == 0 { true -> bad() false -> (items[index]) }
    machine bad() -> u64 { crash Trap; }
}
public data Holder { items: [u64; 2]; }
public machine read_seven(holder: &Holder, index: u64) -> u64
requires index < 2
requires holder.items[index] == 7
{
    transition { _ -> consume(&holder.items, index) }
    machine consume(values: &[u64; 2], selected: u64) -> u64
    requires selected < 2
    { maybe_zero(values, selected) }
}
machine main() crashes Trap {
    let holder: Holder = Holder { items: [7, 11] };
    transition holder.items[0] == 7 { true -> finish(read_seven(&holder, 0)) _ -> bad() }
    machine finish(observed: u64) {
        transition observed == 7 { true -> done() _ -> bad() }
    }
    machine done() {} machine bad() { crash Trap; }
}
