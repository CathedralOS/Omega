machine letter(text: &[u8], index: u64) -> u64
requires index < text.len && text[index] >= 97;
{
    (text[index] - 97) as u64
}

machine through_state(text: &[u8], index: u64) -> u64 {
    transition {
        index >= text.len -> 999
        text[index] < 97 -> 998
        _ -> read(text, index)
    }
    machine read(text: &[u8], index: u64) -> u64
    requires index < text.len && text[index] >= 97;
    {
        (text[index] - 97) as u64
    }
}

machine through_call(text: &[u8], index: u64) -> u64 {
    transition {
        index >= text.len -> 999
        text[index] < 97 -> 998
        _ -> letter(text, index)
    }
}

machine valid_letter(text: &[u8], index: u64) -> bool
requires index < text.len && text[index] >= 97;
{ true }
machine through_guard(text: &[u8], index: u64) -> u64 {
    transition {
        index >= text.len -> 999
        text[index] < 97 -> 998
        valid_letter(text, index) -> letter(text, index)
        _ -> 997
    }
}

machine through_short_circuit(text: &[u8], index: u64) -> u64 {
    transition {
        index < text.len && text[index] >= 97 && valid_letter(text, index) -> letter(text, index)
        _ -> 999
    }
}

data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    let bytes: [u8; 3] = [97, 122, 90];
    let first: u64 = through_call(&bytes[..], 0);
    let second: u64 = through_call(&bytes[..], 1);
    let third: u64 = through_state(&bytes[..], 1);
    let fourth: u64 = through_state(&bytes[..], 2);
    let fifth: u64 = through_call(&bytes[..], 3);
    let sixth: u64 = through_guard(&bytes[..], 1);
    let seventh: u64 = through_short_circuit(&bytes[..], 1);
    let eighth: u64 = through_short_circuit(&bytes[..], 3);
    transition first == 0 && second == 25 && third == 25 && fourth == 998 && fifth == 999 && sixth == 25 && seventh == 25 && eighth == 999 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
