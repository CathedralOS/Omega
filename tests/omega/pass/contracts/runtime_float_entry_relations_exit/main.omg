use omega::language::core::float_operations;
data Reading { value: f64; peer: f64; }
data Envelope { reading: Reading; }
machine same(reading: &Reading) -> f64
crashes Trap reading.value != reading.peer {
    transition reading.value == reading.peer {
        true -> reading.value
        false -> invalid()
    }
    machine invalid() -> f64 { crash Trap; }
}
machine forward(envelope: &Envelope) -> f64
crashes Trap envelope.reading.value != envelope.reading.peer {
    same(&envelope.reading)
}
machine ordered(reading: &Reading, limit: f64) -> f64
crashes Trap !(reading.value < limit) {
    transition reading.value < limit {
        true -> reading.value
        false -> invalid()
    }
    machine invalid() -> f64 { crash Trap; }
}
machine main() crashes Trap {
    let envelope: Envelope = Envelope { reading: Reading { value: -0.0, peer: 0.0 } };
    let zero: f64 = forward(&envelope);
    let ordered_zero: f64 = ordered(&envelope.reading, 1.0);
    transition zero == 0.0 && ordered_zero == 0.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
