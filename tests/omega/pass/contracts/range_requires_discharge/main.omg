// An authored `requires` clause on a range-endpoint callee discharges
// at the concrete argument: `bounded(256)` re-checks its exact call
// under literal arguments, so `value <= 512` instantiates to
// `256 <= 512` — proved by the same instantiated judgment that
// refutes the false direction.
machine bounded(value: u64) -> u64
requires value <= 512
{
    transition { _ -> (value) }
}
machine take_bounded(value: u64) -> u64 requires value <= bounded(256) { value }

data Main {}
machine Main::main(main: &mut Main) {
    let kept: u64 = take_bounded(7);
}
