// `s <= 5` on u64 is not vacuous -- the ceiling sits inside the carrier --
// but the argument is a call whose result constant-folds, so the
// instantiated premise `4 <= 5` is decided-true and the call discharges.
use omega_language_std::console;

machine echo(scale: u64) -> u64
requires scale <= 5
{
    transition { _ -> (scale) }
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let s: u64 = opaque();
    let r: u64 = echo(s);
    Console::exit_process(70);
}

machine opaque() -> u64 {
    transition { _ -> (4u64) }
}
