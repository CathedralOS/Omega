// A returned Unit guarantee preserves Saturating field arithmetic.
// arm(4) stores 5; tick consumes its guarantees and returns 4.
// Exits 70 only when the returned field has the authored value.

use omega_language_std::console;

data Countdown {
    remaining: u32 in Saturating;
}

machine Countdown::arm(countdown: &mut Countdown, start: u32 in Saturating)
requires
    start < 8
ensures
    countdown.remaining > 0;
    countdown.remaining - 1 < 8
{
    countdown.remaining = start + 1;
}

machine Countdown::tick(countdown: &mut Countdown) -> u32 in Saturating
requires
    countdown.remaining > 0;
    countdown.remaining - 1 < 8
{
    countdown.remaining = countdown.remaining - 1;
    countdown.remaining
}

data Main {
    timer: Countdown;
}

machine Main::main(main: &mut Main) reaches Console {
    Countdown::arm(&mut main.timer, 4);
    let left: u32 in Saturating = Countdown::tick(&mut main.timer);
    transition left == 4 {
        true -> done(main)
        _ -> failed(main)
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
