// A bounded distance proved through a conjunction guard: either
// conjunct of `index < limit && index < 4096` that names the bound
// keeps the cursor below it, for a scalar bound and for a collection
// length alike.
data Main {}
machine count_to(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance
{
    transition index < limit && index < 4096 {
        true -> count_to(index + 1, limit)
        _ -> (index)
    }
}
machine count_in(bytes: &[u8], index: u64) -> u64
terminates by (index, bytes.len) -> Nat::BoundedDistance
{
    transition index < 4096 && index < bytes.len {
        true -> count_in(bytes, index + 1)
        _ -> (index)
    }
}
machine Main::main(main: &mut Main) { }
