// Expected exit: 0.
use omega_language_std::console;

data Vitality [copy] where maximum >= 0, current >= 0 && current <= maximum {
    current: i32; maximum: i32;
}
data Actor<const Rooms: u64> [copy] where Rooms >= 1, room < Rooms, facing < 4 {
    room: u64; facing: u32; vitality: Vitality;
}
data Actors<const Capacity: u64, const Rooms: u64>
where Capacity >= 1, Rooms >= 1, count <= Capacity {
    items: [Actor<Rooms>; Capacity]; count: u64;
}
data Command [copy] where direction >= -1 && direction < 4 { direction: i32; }
data Commands<const Capacity: u64> where Capacity >= 1 { items: [Command; Capacity]; }
data Main { actors: Actors<2, 4>; commands: Commands<2>; }

machine turn<const Rooms: u64>(mut actor: Actor<Rooms>) -> Actor<Rooms>
terminates;
requires Rooms >= 1 {
    actor.facing = 1;
    actor
}
machine consume<const Rooms: u64>(actor: Actor<Rooms>, direction: i32) -> Actor<Rooms>
terminates;
requires Rooms >= 1 && actor.room < Rooms && direction >= -1 && direction < 4 { actor }

machine advance<const Rooms: u64>(actors: &mut [Actor<Rooms>], commands: &[Command])
terminates;
terminates by actors -> Slice::Length;
requires Rooms >= 1 && actors.len == commands.len {
    transition actors.len > 0 { true -> head(actors, commands) _ -> done() }
    machine head(actors: &mut [Actor<Rooms>], commands: &[Command])
    requires Rooms >= 1 && actors.len > 0 && actors.len == commands.len {
        let changed: Actor<Rooms> = turn<Rooms>(actors[0]);
        actors[0] = consume<Rooms>(changed, commands[0].direction);
        transition { _ -> advance(&mut actors[1..], commands[1..]) }
    }
    machine done() {}
}
machine tick<const Capacity: u64, const Rooms: u64>(actors: &mut Actors<Capacity, Rooms>, commands: &Commands<Capacity>)
terminates;
requires Capacity >= 1 && Rooms >= 1 {
    let count: u64 = actors.count;
    advance<Rooms>(&mut actors.items[..count], &commands.items[..count]);
}
machine Main::main(main: &mut Main) reaches Console {
    main.actors.items[0] = Actor { room: 3, vitality: Vitality { current: 12, maximum: 12 } };
    main.actors.count = 2;
    main.commands.items[0] = Command { direction: -1 };
    tick<2, 4>(&mut main.actors, &main.commands);
    transition main.actors.items[0].room == 3 && main.actors.items[0].facing == 1
        && main.actors.items[0].vitality.current == 12 && main.actors.items[1].facing == 1 {
        true -> passed()
        _ -> failed()
    }
    machine passed() { Console::exit_process(0); }
    machine failed() { Console::exit_process(1); }
}
// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
