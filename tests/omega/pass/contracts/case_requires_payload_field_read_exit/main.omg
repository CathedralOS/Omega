// A callee whose entry requires a case reads that case's non-atomic payload
// field. The requires clause, not a test in the callee, establishes the case:
// the read lowers in place by reference and by value, and an arm guard over
// another subject reads it without planning a dispatch on `choice`.
data Choice { case Cell(counter: u32); case Empty; }

data Mode { case On; case Off; }

machine make() -> Choice ensures result in Choice::Cell { Choice::Cell { counter: 3 } }

machine observe(choice: &Choice) -> u32 requires choice in Choice::Cell { choice.counter }

machine take(choice: Choice) -> u32 requires choice in Choice::Cell { choice.counter }

machine pick(choice: &Choice, mode: Mode) -> u32 requires choice in Choice::Cell {
    transition mode {
        Mode::On {} if choice.counter == 3 -> hit()
        _ -> miss()
    }
    machine hit() -> u32 { 7 }
    machine miss() -> u32 { 9 }
}

machine main() crashes Trap {
    let choice: Choice = make();
    let resident: u32 = observe(&choice);
    let routed: u32 = pick(&choice, Mode::On);
    let consumed: u32 = take(choice);
    transition resident == 3 && routed == 7 && consumed == 3 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
