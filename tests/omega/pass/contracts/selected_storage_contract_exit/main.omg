// Expected exit: 0
data Counter { remaining: u64; }
machine take(counter: &mut Counter, available: u64, requested: u64) -> u64
requires counter.remaining == available && requested <= available
ensures counter.remaining == available - requested, result == requested
{
    counter.remaining = available - requested;
    requested
}
machine retain(value: u64) -> u64 ensures result == value { value }
machine consume(counter: &Counter, first: u64, second: u64) -> bool
requires counter.remaining == 24 && first == 16 && second == 8
{ counter.remaining == 24 && first == 16 && second == 8 }

machine exercise(select: bool) -> bool {
    let mut counter: Counter = Counter { remaining: 48 };
    let first: u64 = match select { true -> take(&mut counter, 48, 16), false -> take(&mut counter, 48, 16) };
    let second: u64 = retain(take(&mut counter, 32, 8));
    consume(&counter, first, second)
}
machine main() crashes Trap {
    let correct: bool = exercise(true) && exercise(false);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
