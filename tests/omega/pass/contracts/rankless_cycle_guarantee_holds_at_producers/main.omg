// Two unranked machines tail-call each other and both promise `result == 5`.
// Neither promise is cited to prove the other, which would be a citation
// cycle (`contracts.md`). Instead every return that execution can reach
// produces the literal 5, so both promises hold as partial correctness
// (`termination.md`). The negative twin changes one of those producers to 6.
machine first(remaining: u64) -> u64
ensures result == 5
{
    transition remaining > 0 {
        true -> second(remaining - 1)
        false -> 5
    }
}

machine second(remaining: u64) -> u64
ensures result == 5
{
    transition remaining > 0 {
        true -> first(remaining - 1)
        false -> 5
    }
}

machine main() {
    let observed: u64 = first(3);
}
