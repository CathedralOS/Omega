// A contract may index an array literal written in place: `[3u64, 9u64][1]`
// denotes the element 9, exactly as indexing the constant
// `const SOURCE: [u64; 2] = [3, 9]` does. The call proves `9 <= limit` from its
// argument, and the unsuffixed `7` takes the element's `u64` type.
// Exit 70 means both calls ran and returned their limits.
use omega_language_std::console;

machine bounded(limit: u64) -> u64
requires [3u64, 9u64][1] <= limit
requires [3u64][0] <= 7
{
    limit
}

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let first: u64 = bounded(9);
    let second: u64 = bounded(61);
    transition first + second == 70 {
        true -> ok(main)
        false -> bad(main)
    }

    machine ok(main: &mut Main) {
        Console::exit_process(70);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
