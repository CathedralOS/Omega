// A guarantee over a policy field keeps the field's own arithmetic:
// `countdown.remaining - 1` subtracts modulo 2^32 (Wrapping) or clamps
// (Saturating) in the contract exactly as in the body — the exit proof
// of `remaining - 1 < 8` needs `1 <= remaining` supplied by the
// `start + 1` store under `requires start < 8`.
data WrapTimer {
    remaining: u32 in Wrapping;
}
data SaturatingTimer {
    remaining: u32 in Saturating;
}
machine WrapTimer::arm(timer: &mut WrapTimer, start: u32 in Wrapping)
requires
    start < 8
ensures
    timer.remaining > 0,
    timer.remaining - 1 < 8
{
    timer.remaining = start + 1;
}
machine WrapTimer::tick(timer: &mut WrapTimer) -> u32 in Wrapping
requires
    timer.remaining > 0,
    timer.remaining - 1 < 8
{
    timer.remaining = timer.remaining - 1;
    timer.remaining
}
machine SaturatingTimer::arm(timer: &mut SaturatingTimer, start: u32 in Saturating)
requires
    start < 8
ensures
    timer.remaining > 0,
    timer.remaining - 1 < 8
{
    timer.remaining = start + 1;
}
machine SaturatingTimer::tick(timer: &mut SaturatingTimer) -> u32 in Saturating
requires
    timer.remaining > 0,
    timer.remaining - 1 < 8
{
    timer.remaining = timer.remaining - 1;
    timer.remaining
}

data Main { wrap: WrapTimer; sat: SaturatingTimer; }
machine Main::main(main: &mut Main) {
    WrapTimer::arm(&mut main.wrap, 4);
    let w: u32 in Wrapping = WrapTimer::tick(&mut main.wrap);
    SaturatingTimer::arm(&mut main.sat, 4);
    let s: u32 in Saturating = SaturatingTimer::tick(&mut main.sat);
}
