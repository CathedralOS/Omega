// A saved call result keeps its callee's case guarantee. Later calls that
// require that case accept the saved local by reference and by value, after
// an intervening reference-operand call whose contract is not imported.
data Choice { case Cell(counter: u32); case Empty; }

machine make() -> Choice ensures result in Choice::Cell { Choice::Cell { counter: 3 } }

machine observe(choice: &Choice, amount: u32) -> u32 requires choice in Choice::Cell { amount }

machine take(choice: Choice, amount: u32) -> u32 requires choice in Choice::Cell { amount }

machine main() crashes Trap {
    let choice: Choice = make();
    let first: u32 = observe(&choice, 3);
    let second: u32 = observe(&choice, 4);
    let third: u32 = take(choice, 5);
    transition first == 3 && second == 4 && third == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
