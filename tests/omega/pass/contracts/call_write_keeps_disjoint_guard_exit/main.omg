// A call's write frame retires only the guard facts it may overlap. `pop`
// writes its `&mut Stack` argument, so popping `main.a` keeps the entry
// guard's bound on `main.b.count` for the next pop in the same state. The same
// holds when the two stacks arrive as separate state parameters.
//
//   both     pops a (7) then b (5) under one guard
//   apart    pops left (7) then right (5) as parameters
//
// Exits 24 only when both pairs of pops see their pushed values.

use omega_language_std::console;
use omega::language::core::binding;

data Stack {
    items: [i32; 4];
    count: u64;
}

machine Stack::pop(stack: &mut Stack) -> i32
requires stack.count >= 1 && stack.count <= 4 {
    stack.count = stack.count - 1;
    stack.items[stack.count]
}

data Main {
    a: Stack;
    b: Stack; console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    main.a = Stack { items: [7, 0, 0, 0], count: 1 };
    main.b = Stack { items: [5, 0, 0, 0], count: 1 };
    transition main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
        true -> both(&main.console, main)
        _ -> failed(&main.console)
    }
    state both(console: &Binding<Console>, main: &mut Main) {
        let first: i32 = Stack::pop(&mut main.a);
        let second: i32 = Stack::pop(&mut main.b);
        main.a.count = 1;
        main.b.count = 1;
        transition first == 7 && second == 5
            && main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
            true -> apart(console, &mut main.a, &mut main.b)
            _ -> failed(console)
        }
    }
    state apart(console: &Binding<Console>, left: &mut Stack, right: &mut Stack) {
        let first: i32 = Stack::pop(left);
        let second: i32 = Stack::pop(right);
        transition first == 7 && second == 5 {
            true -> passed(console)
            _ -> failed(console)
        }
    }
    state passed(console: &Binding<Console>) { Console::exit_process(console, 24); }
    state failed(console: &Binding<Console>) { Console::exit_process(console, 1); }
}
