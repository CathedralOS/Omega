// Expected exit: 0
data Counter { value: u64; }
machine consume(counter: &Counter) -> bool requires counter.value == 7 { counter.value == 7 }
machine main() crashes Trap {
    let counter: Counter = Counter { value: 7 };
    let view: &u64 = &counter.value;
    let observed: addr = address_of(view);
    transition consume(&counter) && observed == address_of(&counter.value) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
