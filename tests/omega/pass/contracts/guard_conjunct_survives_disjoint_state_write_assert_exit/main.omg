// Expected exit: 0
// Package-free value-assertion variant of guard_conjunct_survives_disjoint_state_write_exit.
// All guarded operations and value assertions remain unchanged; only success/failure reporting differs.
// A guard carried back across an intermediate state keeps every conjunct the
// state's writes do not reach. `first` pops `main.a`, which retires the
// guard's `main.a.count` conjuncts but not its `main.b.count` conjuncts, so
// `second` may still pop `main.b` on that guard alone. The same holds through
// separate state parameters.
//
//   first    pops a (7)
//   second   pops b (5)
//   third    pops left (7)
//   fourth   pops right (5)
//
// Returns normally only when all four pops see their pushed values.


data Stack {
    items: [i32; 4];
    count: u64;
}

machine Stack::pop(stack: &mut Stack) -> i32
requires stack.count >= 1 && stack.count <= 4 {
    stack.count = stack.count - 1;
    stack.items[stack.count]
}

data Main {
    a: Stack;
    b: Stack;
}

machine Main::main(main: &mut Main) crashes Trap {
    main.a = Stack { items: [7, 0, 0, 0], count: 1 };
    main.b = Stack { items: [5, 0, 0, 0], count: 1 };
    transition main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
        true -> first(main)
        _ -> failed()
    }
    machine first(main: &mut Main) {
        let value: i32 = Stack::pop(&mut main.a);
        transition { _ -> second(main, value == 7) }
    }
    machine second(main: &mut Main, matched: bool) {
        let value: i32 = Stack::pop(&mut main.b);
        main.a.count = 1;
        main.b.count = 1;
        transition matched && value == 5
            && main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
            true -> third(&mut main.a, &mut main.b)
            _ -> failed()
        }
    }
    machine third(left: &mut Stack, right: &mut Stack) {
        let value: i32 = Stack::pop(left);
        transition { _ -> fourth(right, value == 7) }
    }
    machine fourth(right: &mut Stack, matched: bool) {
        let value: i32 = Stack::pop(right);
        transition matched && value == 5 {
            true -> passed()
            _ -> failed()
        }
    }
    machine passed() {}
    machine failed() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
