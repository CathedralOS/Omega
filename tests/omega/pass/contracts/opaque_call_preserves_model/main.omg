// Expected exit: 0. Unknown reference writes preserve only detached facts.
data Value [copy] { number: u64; }
data View<'scope> { value: &'scope Value; }
boundary trait Replace {
    machine replace<'scope>(view: &mut View<'scope>, value: &'scope Value) -> u64 reaches;
}

ReplaceValue satisfies Replace {
    machine replace<'scope>(view: &mut View<'scope>, value: &'scope Value) -> u64 {
        view.value = value;
        0
    }
}

// Exposing the stored reference makes its old origin unusable. The call does
// not change the address model or an already copied scalar value.
machine after_call(address: addr) -> u64
reaches Replace
invokes Replace;
requires addr::Bound == 18446744073709551616
{
    let first: Value = Value { number: 7 };
    let second: Value = Value { number: 11 };
    let mut view: View = View { value: &first };
    let saved: u64 = view.value.number;
    let status: u64 = Replace::replace(&mut view, &second);
    let mut observed: Value = Value { number: 0 };
    observed.number = view.value.number;
    let converted: u64 = address as u64;
    let fresh: u64 = 7;
    exact_seven(saved);
    exact_seven(fresh);
    transition observed.number == 11 {
        true -> converted
        _ -> 0
    }
}

machine exact_seven(value: u64) requires value == 7 {}

machine main() crashes Trap
reaches Replace
invokes Replace;
requires addr::Bound == 18446744073709551616
{
    let converted: u64 = after_call(18446744073709551615 as addr);
    transition converted == 18446744073709551615 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
