machine build(builder: &mut Build) {
    Build::application(builder, "opaque_call_preserves_model");
    Build::select_provider<Replace, ReplaceValue>(builder, linux_arm64);
    Build::select_provider<Replace, ReplaceValue>(builder, linux_x86_64);
    Build::select_provider<Replace, ReplaceValue>(builder, macos_arm64);
    Build::select_provider<Replace, ReplaceValue>(builder, macos_x86_64);
    Build::select_provider<Replace, ReplaceValue>(builder, windows_x86_64);
    Build::select_provider<Replace, ReplaceValue>(builder, uefi_x86_64);
    Build::select_provider<Replace, ReplaceValue>(builder, cross_platform_cli);
    Build::select_provider<Replace, ReplaceValue>(builder, local_unchecked);
    Build::select_provider<Replace, ReplaceValue>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
