use omega::language::core::float_operations;

// A guard's evaluated call prefix must not resurrect invocation-entry contents.
data Measurement { value: f64; other: f64; }

machine replace(value: &mut f64) -> bool { value = -1.0; true }

machine read(measurement: &mut Measurement) -> f64
crashes Trap measurement.value < 0.0 {
    transition replace(&mut measurement.other) && measurement.value < 0.0 {
        true -> invalid()
        false -> measurement.value
    }
    state invalid() -> f64 { crash Trap; }
}

machine main() crashes Trap {
    let mut measurement: Measurement = Measurement { value: 2.0, other: 1.0 };
    let value: f64 = read(&mut measurement);
    transition value == 2.0 && measurement.other == -1.0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
