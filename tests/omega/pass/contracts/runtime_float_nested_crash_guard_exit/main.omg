use omega::language::core::float_operations;
data Reading { value: f32; }
data Envelope { reading: Reading; }
machine read(enabled: bool, envelope: &Envelope, limit: f32) -> f32
crashes Trap enabled && envelope.reading.value < limit {
    transition enabled && envelope.reading.value < limit {
        true -> invalid(false, 99.0f32)
        false -> envelope.reading.value
    }
    machine invalid(decoy: bool, unrelated: f32) -> f32 { crash Trap; }
}
machine main() crashes Trap {
    let envelope: Envelope = Envelope { reading: Reading { value: 2.0f32 } };
    let first: f32 = read(true, &envelope, 1.0f32);
    let second: f32 = read(false, &envelope, 3.0f32);
    transition first == 2.0f32 && second == 2.0f32 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
