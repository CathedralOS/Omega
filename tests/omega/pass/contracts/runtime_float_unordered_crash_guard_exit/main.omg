use omega::language::core::float_operations;
data Reading { value: f64; }
machine ordered(reading: &Reading) -> f64
crashes Trap !(reading.value < 1.0) {
    transition reading.value < 1.0 {
        true -> reading.value
        false -> invalid()
    }
    machine invalid() -> f64 { crash Trap; }
}
machine main() crashes Trap {
    let zero: f64 = 0.0;
    let reading: Reading = Reading { value: zero / zero };
    let value: f64 = ordered(&reading);
}
