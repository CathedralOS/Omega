// Expected exit: 0
// A selected callable keeps its authored zero input condition.
machine compute(counter: &mut u64) -> u64
requires counter == 0
{ counter = counter + 1; 0 }

machine apply(visits: &mut u64) -> u64
{ compute(visits) }

public machine invoke<machine Callback>(visits: &mut u64) -> u64
requires machine Callback(visits: &mut u64) -> u64
requires visits == 0;
requires visits == 0
{ Callback(visits) }

machine main() crashes Trap {
    let mut visits: u64 = 0;
    let index: u64 = invoke<apply>(&mut visits);
    transition visits == 1 && index == 0 {
        true -> done() false -> wrong()
    }
    machine done() {} machine wrong() { crash Trap; }
}
