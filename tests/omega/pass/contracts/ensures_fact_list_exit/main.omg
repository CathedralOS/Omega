// One `ensures` may list several facts. Each listed fact is its own
// published guarantee with its own exit proof, and a later `requires` list
// consumes them together: `release` needs both `count > 0` (its exact
// subtraction cannot go below zero) and `count <= slots.len`.
//
//   reset    count 0       ensures count < slots.len
//   bump     count 0 -> 1  ensures count > 0; count <= slots.len
//   release  count 1 -> 0  requires count > 0; count <= slots.len
//   reset, bump            count 1
//
// Exits 70 only when the final count is exactly 1.

use omega_language_std::console;
use omega::language::core::binding;

data Counter {
    slots: [i32; 4];
    count: u64;
}

machine Counter::reset(&mut self)
ensures
    self.count < self.slots.len
{
    self.count = 0;
}

machine Counter::bump(&mut self)
requires
    self.count < self.slots.len
ensures
    self.count > 0;
    self.count <= self.slots.len
{
    self.count = self.count + 1;
}

machine Counter::release(&mut self)
requires
    self.count > 0;
    self.count <= self.slots.len
{
    self.count = self.count - 1;
}

data Main {
    console: Binding<Console>;
    counter: Counter;
}

machine Main::main(&mut self) reaches Console {
    self.counter.reset();
    self.counter.bump();
    self.counter.release();
    self.counter.reset();
    self.counter.bump();
    transition self.counter.count == 1 {
        true -> done()
        _ -> failed()
    }
    state done(&mut self) { self.console.exit_process(70); }
    state failed(&mut self) { self.console.exit_process(71); }
}
