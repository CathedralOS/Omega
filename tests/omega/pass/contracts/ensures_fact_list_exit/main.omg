// One `ensures` may list several facts. Each listed fact is its own
// published guarantee with its own exit proof, and a later `requires` list
// consumes them together: `release` needs both `count > 0` (its exact
// subtraction cannot go below zero) and `count <= slots.len`.
//
//   reset    count 0       ensures count < slots.len
//   bump     count 0 -> 1  ensures count > 0; count <= slots.len
//   release  count 1 -> 0  requires count > 0; count <= slots.len
//   reset, bump            count 1
//
// Exits 70 only when the final count is exactly 1.

use omega_language_std::console;

data Counter {
    slots: [i32; 4];
    count: u64;
}

machine Counter::reset(counter: &mut Counter)
ensures
    counter.count < counter.slots.len
{
    counter.count = 0;
}

machine Counter::bump(counter: &mut Counter)
requires
    counter.count < counter.slots.len
ensures
    counter.count > 0;
    counter.count <= counter.slots.len
{
    counter.count = counter.count + 1;
}

machine Counter::release(counter: &mut Counter)
requires
    counter.count > 0;
    counter.count <= counter.slots.len
{
    counter.count = counter.count - 1;
}

data Main {
    counter: Counter;
}

machine Main::main(main: &mut Main) reaches Console {
    Counter::reset(&mut main.counter);
    Counter::bump(&mut main.counter);
    Counter::release(&mut main.counter);
    Counter::reset(&mut main.counter);
    Counter::bump(&mut main.counter);
    transition main.counter.count == 1 {
        true -> done(main)
        _ -> failed(main)
    }
    state done(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
