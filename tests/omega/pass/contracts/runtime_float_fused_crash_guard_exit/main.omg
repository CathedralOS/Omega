use omega::language::core::float_operations;
data Reading { value: f64; }
machine ping(reading: &Reading, count: u64)
terminates by count;
-> f64
crashes Trap reading.value < 0.0 {
    transition count == 0 {
        true -> reading.value
        false -> pong(reading, count - 1)
    }
}
machine pong(reading: &Reading, count: u64)
terminates by count;
-> f64
crashes Trap reading.value < 0.0 {
    transition count == 0 {
        true -> finish(reading)
        false -> ping(reading, count - 1)
    }
    machine finish(reading: &Reading) -> f64 {
        transition reading.value < 0.0 {
            true -> invalid()
            false -> reading.value
        }
    }
    machine invalid() -> f64 { crash Trap; }
}

machine main() crashes Trap {
    let reading: Reading = Reading { value: 2.0 };
    let value: f64 = ping(&reading, 3);
    transition value == 2.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
