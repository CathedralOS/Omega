// Compile only: selected-provider custody retains every physical port write
// through a sequence, an ordinary helper call and a selected state.
use omega::language::core::assembly;
public data Device { marker: u64; }
public boundary trait PortSequence {
    machine emit(device: &mut Device, enabled: bool) reaches PortIo;
}
PortSequenceNative satisfies PortSequence { machine emit(device: &mut Device, enabled: bool) reaches PortIo { emit_realization(device, enabled) } }
machine second(device: &mut Device) reaches PortIo {
    asm clobbers r10, r11, r15, rax, rdx { out 0x2F8, 0x42 }
    device.marker = 2;
}
machine emit_realization(device: &mut Device, enabled: bool) reaches PortIo {
    asm clobbers r10, r11, r15, rax, rdx { out 0x3F8, 0x41 }
    second(device);
    transition enabled { true -> selected(device) false -> done() }
    machine selected(device: &mut Device) {
        asm clobbers r10, r11, r15, rax, rdx { out 0x3F8, 0x43 }
        device.marker = 3;
    }
    machine done() {}
}
machine main() reaches PortSequence + PortIo {
    let mut device: Device = Device { marker: 0 };
    PortSequence::emit(&mut device, true);
}
