// COMPILE CANARY (linux_x86_64 freestanding): RFLAGS save/restore are explicit
// u64 value operations. Their realized push/pop sequences leave RSP unchanged,
// and restore carries machine-control reach plus boot-root authority.
use omega::language::core::assembly;

data Main {
    saved_flags: u64;
}

machine Main::main(&mut self) reaches MachineControl {
    asm where clobbers r10, r15 {
        pushfq self.saved_flags;
        cli;
        popfq self.saved_flags
    }
}

target linux_x86_64 {
}

target linux_arm64 {
}
