// AArch64 EL1 system-register access: structured
// `read_<sysreg>`/`write_<sysreg>` spellings with exact-u64
// value flow and declared scratch clobbers — sctlr, tcr,
// ttbr0/1, mair, vbar, tpidr, esr, far.
//
//   * `machine Main::main(main: &mut Main) reaches
//     MachineControl`.
//   * `asm clobbers x9, x10, x11, x15`.
//
// Compile-checked only: freestanding target.

use omega::language::core::assembly;

data Main {
    value: u64;
}

machine Main::main(main: &mut Main) reaches MachineControl {
    asm clobbers x9, x10, x11, x15 {
        read_sctlr_el1 main.value;
        write_sctlr_el1 main.value;
        read_tcr_el1 main.value;
        write_tcr_el1 main.value;
        read_ttbr0_el1 main.value;
        write_ttbr0_el1 main.value;
        read_ttbr1_el1 main.value;
        write_ttbr1_el1 main.value;
        read_mair_el1 main.value;
        write_mair_el1 main.value;
        read_vbar_el1 main.value;
        write_vbar_el1 main.value;
        read_tpidr_el1 main.value;
        write_tpidr_el1 main.value;
        read_esr_el1 main.value;
        read_far_el1 main.value
    }
}
