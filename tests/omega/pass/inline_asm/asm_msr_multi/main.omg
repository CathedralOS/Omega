// Multi-service reach + MSR: `reaches MachineControl +
// PortIo` declares both privileged services; `rdmsr
// main.result, main.index` / `wrmsr main.index, main.value`
// keep exact operand boundaries around the privileged
// envelope.
//
//   * `out`/`in` + `rdmsr`/`wrmsr` in one asm block.
//   * `data Main` carries every operand type (u16 port, u8
//     byte, u32 index, u64 value/result).
//
// Compile-checked only: freestanding target.

use omega::language::core::assembly;

data Main {
    port: u16;
    byte: u8;
    index: u32;
    value: u64;
    result: u64;
}

machine Main::main(main: &mut Main)
reaches MachineControl + PortIo
{
    asm clobbers rax, rcx, rdx, r10, r11, r15 {
        out main.port, main.byte;
        in main.byte, main.port;
        rdmsr main.result, main.index;
        wrmsr main.index, main.value
    }
}
