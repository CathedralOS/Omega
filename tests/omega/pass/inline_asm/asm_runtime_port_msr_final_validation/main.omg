// COMPILE CANARY (linux_x86_64 freestanding): runtime port and MSR operands keep
// their exact operand boundaries around independently validated privileged
// opcode envelopes. Reads also retain their compiler-owned destination
// relocations.
use omega::language::core::assembly;

data Main {
    port: u16;
    byte: u8;
    index: u32;
    value: u64;
    result: u64;
}

machine Main::main(main: &mut Main)
reaches MachineControl + PortIo
{
    asm where clobbers rax, rcx, rdx, r10, r11, r15 {
        out main.port, main.byte;
        in main.byte, main.port;
        rdmsr main.result, main.index;
        wrmsr main.index, main.value
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches MachineControl + PortIo
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
