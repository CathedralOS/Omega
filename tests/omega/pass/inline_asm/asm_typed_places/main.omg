// Typed Omega places as assembly memory operands: `str
// main.value, main.buffer[0]` / `ldr` spell their operand as
// a real place — the access lowers to the same checked
// assignment the place's provenance, permission and
// exact-type contract carries. Bracketed `[address]` raw
// addresses keep refusing.
//
//   * Scalar field + array element as str/ldr operands.
//
// Compile-checked only: freestanding target.

data Main {
    value: u64;
    buffer: [u64; 4];
}

machine Main::main(main: &mut Main) {
    asm {
        str main.value, main.buffer[0];
        ldr main.value, main.buffer[0]
    }
}
