// Compile witness: target-family crash inference distinguishes catalogued
// processor observations from authored machine calls. Hardware faults are not
// language crash routes, and the MachineControl authority remains required.
use omega::language::core::assembly;

linux_x86_64 machine observe() -> u64 reaches MachineControl {
    let mut control: u64 = 0;
    asm { read_cr0 control }
    asm { write_cr0 control }
    asm { read_cr2 control }
    asm { read_cr3 control }
    asm { write_cr3 control }
    asm { read_cr4 control }
    asm { write_cr4 control }
    control
}

machine main() reaches MachineControl {
    let control: u64 = observe();
}
