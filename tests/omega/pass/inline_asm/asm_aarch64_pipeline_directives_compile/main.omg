// COMPILE CANARY: the AArch64 pipeline-directive set isb plus the complete
// architectural hint family yield/wfe/wfi/sev/sevl and the ISA-neutral nop
// carry the same zero-operand, authority-free contract shape as the x86
// counterparts; target applicability remains catalog metadata while the
// check surface is targetless.
data Main {}

machine Main::main(&mut self) {
    asm where clobbers none {
        isb;
        yield;
        nop;
        wfe;
        wfi;
        sev;
        sevl
    }
}
