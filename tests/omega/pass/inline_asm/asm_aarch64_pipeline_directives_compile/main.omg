// COMPILE CANARY: the AArch64 pipeline-directive pair isb/yield carries the
// same zero-operand, authority-free contract shape as its x86 counterparts;
// target applicability remains catalog metadata while the check surface is
// targetless.
data Main {}

machine Main::main(&mut self) {
    asm where clobbers none {
        isb;
        yield
    }
}
