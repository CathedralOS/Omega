// The contracted AArch64 unordered memory transfers
// `ldr`/`str` spell their memory operand as a typed Omega place, so the
// access lowers to the same checked assignment the place's own provenance,
// permission and exact-type contract carries. Bracketed `[address]` raw
// addresses keep refusing; ordered, width-suffixed and unscaled spellings are
// separate contracts. The x86 bodies use the corresponding typed-place mov.
// Expected exit: 0.

data Main {
    value: u64;
    buffer: [u64; 4];
}

linux_arm64 machine transfer(main: &mut Main) {
    asm {
        str main.value, main.buffer[0];
        ldr main.value, main.buffer[0]
    }
}

macos_arm64 machine transfer(main: &mut Main) {
    asm {
        str main.value, main.buffer[0];
        ldr main.value, main.buffer[0]
    }
}

windows_x86_64 machine transfer(main: &mut Main) {
    asm {
        mov main.buffer[0], main.value;
        mov main.value, main.buffer[0]
    }
}

linux_x86_64 machine transfer(main: &mut Main) {
    asm {
        mov main.buffer[0], main.value;
        mov main.value, main.buffer[0]
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main = Main {
        value: 37,
        buffer: [0, 0, 0, 0]
    };
    transfer(&mut entry_storage);
    transition entry_storage.value == 37 && entry_storage.buffer[0] == 37 {
        true -> done()
        false -> bad()
    }

    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
