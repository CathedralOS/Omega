// `asm` block contract: `requires main.ready` +
// `clobbers {r15, r11, rax, r10, rdx}` + `ensures main.ready`
// — the exact realized register union, plus field operands
// `out main.port, main.status; in main.status, main.port`.
//
//   * `data Main { port, status, ready }` field operands.
//   * Machine `reaches PortIo` + `requires main.ready`.
//
// Compile-checked only: freestanding target, port I/O is
// privileged.

use omega::language::core::assembly;

data Main { port: u16; status: u8; ready: bool; }

machine Main::main(main: &mut Main) reaches PortIo
requires main.ready
{
    asm
        requires main.ready
        clobbers r15, r11, rax, r10, rdx
        ensures main.ready
    {
        out main.port, main.status;
        in main.status, main.port
    }
}
