// COMPILE CANARY (linux_x86_64 freestanding): control-register access uses
// structured, exact-u64 value flow and exposes the realized scratch clobbers.
use omega::language::core::assembly;

data Main {
    value: u64;
}

machine Main::main(&mut self) reaches MachineControl {
    asm where clobbers rax, r10, r11, r15 {
        read_cr0 self.value;
        write_cr0 self.value;
        read_cr2 self.value;
        read_cr3 self.value;
        write_cr3 self.value;
        read_cr4 self.value;
        write_cr4 self.value
    }
}
