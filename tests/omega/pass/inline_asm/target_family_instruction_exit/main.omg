// Expected exit: 0.
// Catalogued instructions do not become missing machine dependencies in a
// target-family crash envelope. The returned value is still observed at runtime.
boundary trait SelectedHelper {
    machine helper(value: u64) -> u64 reaches
;
}
CheckedHelper satisfies SelectedHelper {
    machine helper(value: u64) -> u64
{ asm { nop } value }
}




machine main() crashes Trap {
    let value: u64 = SelectedHelper::helper(73);
    transition value == 73 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
