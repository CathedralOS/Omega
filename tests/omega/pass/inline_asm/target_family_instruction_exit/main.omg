// Expected exit: 0.
// Catalogued instructions do not become missing machine dependencies in a
// target-family crash envelope. The returned value is still observed at runtime.
windows_x86_64 machine helper(value: u64) -> u64 { asm { nop } value }
linux_x86_64 machine helper(value: u64) -> u64 { asm { nop } value }
linux_arm64 machine helper(value: u64) -> u64 { asm { nop } value }
macos_arm64 machine helper(value: u64) -> u64 { asm { nop } value }

machine main() crashes Trap {
    let value: u64 = helper(73);
    transition value == 73 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
