// `asm clobbers` is an exact block contract: the union of the
// realized out/in sequences is {rax, rdx, r10, r11, r15}; declaration
// order is not semantic.
use omega::language::core::assembly;

data Main { port: u16; status: u8; ready: bool; }

machine Main::main(main: &mut Main) reaches PortIo
requires main.ready
{
    asm
        requires main.ready
        clobbers r15, r11, rax, r10, rdx
        ensures main.ready
    {
        out main.port, main.status;
        in main.status, main.port
    }
}
