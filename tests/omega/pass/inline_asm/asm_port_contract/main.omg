// Port-I/O contract: `asm clobbers r10, r11, r15, rax,
// rdx { out 0x3F8, 0x41 }` — an immediate port identity
// lowered through checked assembly; `reaches PortIo` on the
// machine declares the privileged service.
//
//   * Clobber set is an exact block contract (order-free).
//   * Immediate `out <port>, <byte>`.
//
// Compile-checked only: freestanding target, port I/O is
// privileged.

use omega::language::core::assembly;

machine main() reaches PortIo {
    asm clobbers r10, r11, r15, rax, rdx {
        out 0x3F8, 0x41
    }
}
