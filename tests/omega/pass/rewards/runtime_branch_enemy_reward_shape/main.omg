data ItemKind { case RustedDagger; case HealingCharm; }
data RewardKind { case Gold; case GoldAndItem; }

data Reward {
    kind: RewardKind;
    gold: u32 in Wrapping;
    item: ItemKind;
}

data Enemy {
    depth: u32 in Wrapping;
}

data RandomState {}

data Main {
}

machine Main::main(
    &mut self,
    enemy: Enemy,
    random: &mut RandomState,
    reward: &mut Reward
) {
    transition self.chance(random, 1, 4) {
        true -> enemy_item(enemy, random, reward)
        false -> enemy_gold(enemy, random, reward)
    }
    

    state enemy_item(
        &mut self,
        enemy: Enemy,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.kind = RewardKind::GoldAndItem;
        reward.gold = 1 + enemy.depth + self.range(random, 5);
        reward.item = self.roll_item(enemy.depth as u32, random);
    }

    state enemy_gold(
        &mut self,
        enemy: Enemy,
        random: &mut RandomState,
        reward: &mut Reward
    ) {
        reward.kind = RewardKind::Gold;
        reward.gold = 2 + enemy.depth * 2 + self.range(random, 6);
        reward.item = ItemKind::RustedDagger;
    }


}

machine Main::range(&mut self, random: &mut RandomState, limit: u32) -> u32 {
    1
    
}

machine Main::chance(&mut self, random: &mut RandomState, top: u32, bottom: u32) -> bool {
    true
    
}

machine Main::roll_item(
    &mut self,
    depth: u32,
    random: &mut RandomState
    ) -> ItemKind {
    transition {
        depth > 1 -> ItemKind::HealingCharm
        _ -> ItemKind::RustedDagger
    }
}
