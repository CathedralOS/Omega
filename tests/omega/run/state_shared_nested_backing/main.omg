// Expected exit: 0
domain [u16; 4]::Terminated(words) requires words[3] == 0;
data Name<'scope> { words: &'scope [u16; 4] in Terminated; }
data Attributes<'scope> { name: &'scope Name<'scope>; }
machine final_word(word: u16) -> u16 requires word == 0 { word }
machine consume<'scope>(attributes: &Attributes<'scope>) -> u16 {
    final_word(attributes.name.words[3])
}
data Main {}
machine Main::main(main: &mut Main) crashes Trap {
    transition { _ -> create() }
    machine create() {
        let mut words: [u16; 4];
        words[3] = 0;
        let name: Name = Name { words: &words };
        let left: Attributes = Attributes { name: &name };
        let right: Attributes = Attributes { name: &name };
        transition { _ -> inspect(&left, &right) }
    }
    machine inspect(left: &Attributes, right: &Attributes) {
        let result: u16 = consume(left);
        transition result == 0 { true -> finish(right) false -> failed() }
    }
    machine finish(right: &Attributes) {
        let result: u16 = consume(right);
        transition result == 0 { true -> done() false -> failed() }
    }
    machine done() {}
    machine failed() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
