// Two correlated binders select a finite family row: the roster admits the
// exact pairs (16,4) and (32,8) without enumerating a range, and the runtime
// selector matches the complete tuple before calling through one named
// conformance:
//   scan(Primary, 16,4) = 20 + 16 + 4     == 40
//   scan(Bumped,  32,8) = 20 + 32 + 8 + 1 == 61
use omega_language_std::console;

trait Shape<T> {
    machine code<Width: u32, Depth: u32>(subject: &T) -> u32 where (Width == 16 && Depth == 4) || (Width == 32 && Depth == 8);
}

data Item {
    value: u32 in Wrapping;
}

machine Item::code<Width: u32, Depth: u32>(item: &Item) -> u32 satisfies Shape<Item>::code {
    let w: u32 in Wrapping = Width as u32 in Wrapping;
    let d: u32 in Wrapping = Depth as u32 in Wrapping;
    let r: u32 = (item.value + w + d) as u32;
    transition {
        _ -> r
    }
}

machine Item::lifted_code<Width: u32, Depth: u32>(item: &Item) -> u32 satisfies Shape<Item>::code {
    let w: u32 in Wrapping = Width as u32 in Wrapping;
    let d: u32 in Wrapping = Depth as u32 in Wrapping;
    let r: u32 = (item.value + w + d + 1) as u32;
    transition {
        _ -> r
    }
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
}

Bumped satisfies Shape<Item> {
    Shape::code = Item::lifted_code;
}

machine scan(selected: dyn Shape<Item>, item: &Item, w: u32, d: u32) -> u32
requires
    (w == 16 && d == 4) || (w == 32 && d == 8);
{
    let r: u32 = Shape::code<w, d>(selected, item);
    transition {
        _ -> r
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.item.value = 20;
    let mut selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let first: u32 = scan(selected, &main.item, 16, 4);
    selected = Bumped as dyn Shape<Item>;
    let second: u32 = scan(selected, &main.item, 32, 8);
    transition first == 40 && second == 61 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
