// Expected exit: 0. Each qualified operand uses only guarantees already available
// at its completion, including authored field order independent of declaration order.
data Amount [copy] { number: u64; }
data Envelope [copy] { amount: Amount; }
domain Amount::Positive(amount) requires amount.number > 0;
data Pair { amount: Amount in Positive; checked: u64; }

machine validate(number: u64) -> u64
ensures number > 0
crashes Trap {
    transition number > 0 {
        true -> accepted(number)
        false -> refused()
    }
    machine accepted(number: u64) -> u64 requires number > 0 { number }
    machine refused() -> u64 { crash Trap; }
}

machine identity(amount: Amount) -> Amount
ensures result.number == amount.number { amount }

machine direct(number: u64) -> Pair crashes Trap {
    Pair { checked: validate(number), amount: Amount { number: number } }
}

machine local(number: u64) -> Pair crashes Trap {
    let amount: Amount = Amount { number: number };
    Pair { checked: validate(number), amount: amount }
}

machine field(envelope: Envelope) -> Pair crashes Trap {
    Pair { checked: validate(envelope.amount.number), amount: envelope.amount }
}

machine returned(amount: Amount) -> Pair crashes Trap {
    Pair { checked: validate(amount.number), amount: identity(amount) }
}

machine selected(number: u64, choose: bool) -> Pair crashes Trap {
    Pair {
        checked: match choose { true -> validate(number), false -> validate(number) },
        amount: Amount { number: number }
    }
}

machine join(checked: u64, amount: Amount in Positive) -> Pair {
    Pair { amount: amount, checked: checked }
}

machine argument(number: u64) -> Pair crashes Trap {
    join(validate(number), Amount { number: number })
}

machine main() crashes Trap {
    let first: Pair = direct(3);
    let second: Pair = local(5);
    let third: Pair = field(Envelope { amount: Amount { number: 7 } });
    let fourth: Pair = returned(Amount { number: 11 });
    let fifth: Pair = selected(13, true);
    let sixth: Pair = selected(17, false);
    let seventh: Pair = argument(19);
    transition first.amount.number == 3 && second.amount.number == 5
        && third.amount.number == 7 && fourth.amount.number == 11
        && fifth.amount.number == 13 && sixth.amount.number == 17
        && seventh.amount.number == 19 {
        true -> done()
        false -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
