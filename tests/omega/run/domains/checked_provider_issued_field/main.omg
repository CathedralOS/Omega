// Expected exit: 0.
public data Resource { identity: u64; }
public domain Resource::Open(resource) requires resource.identity != 0 established by acquire;
public data Package { resource: Resource in Open; }
machine acquire() -> Resource in Open { Resource { identity: 73 } }
public boundary trait Source { machine open() -> Package reaches; }
data CheckedSource {}
machine CheckedSource::open() -> Package satisfies Source::open {
    Package { resource: acquire() }
}
machine forward() -> Package reaches Source { Source::open() }
machine close(resource: Resource in Open) crashes Trap {
    transition resource.identity == 73 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
data Main { }
machine Main::main(context: &mut Main) reaches Source crashes Trap {
    let package: Package = forward();
    transition { _ -> received(package.resource) }
    machine received(resource: Resource in Open) { close(resource); }
}

CheckedSourceSourceImplementation satisfies Source {
    Source::open = CheckedSource::open;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Source crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
