machine build(builder: &mut Build) {
    Build::application(builder, "contextual_domain_cast_exit");
    Build::bind(builder, macos_arm64::ProgramEntry, contextual_check);
    Build::bind(builder, linux_arm64::ProgramEntry, contextual_check);
    Build::bind(builder, linux_x86_64::ProgramEntry, contextual_check);
    Build::bind(builder, windows_x86_64::ProgramEntry, contextual_check);
}
