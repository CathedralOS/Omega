// Expected exit: 0. A case guard borrows established routed payload storage.
data Owner { value: u64; }
domain Owner::Open(owner) requires owner.value != 0 established by issue;
data Attempt { case Error; case Ok(owner: Owner in Open); }
machine issue() -> Owner in Open { Owner { value: 41 } }
machine acquire() -> Attempt { Attempt::Ok { owner: issue() } }
machine observe(owner: &Owner in Open) -> u64 { owner.value }
machine release(owner: Owner in Open) {}
machine receive(attempt: Attempt) -> u64 {
    transition attempt {
        Attempt::Ok { owner } -> owned(owner)
        _ -> (0)
    }
    state owned(owner: Owner in Open) -> u64 {
        let value: u64 = observe(&owner);
        release(owner);
        value
    }
}
machine main() crashes Trap {
    let attempt: Attempt = acquire();
    transition attempt {
        Attempt::Ok { owner } -> owned(owner)
        _ -> wrong()
    }
    state owned(owner: Owner in Open) {
        let observed: u64 = observe(&owner);
        release(owner);
        let forwarded: u64 = receive(acquire());
        transition observed == 41 && forwarded == 41 { true -> done() false -> wrong() }
    }
    state done() {}
    state wrong() { crash Trap; }
}
