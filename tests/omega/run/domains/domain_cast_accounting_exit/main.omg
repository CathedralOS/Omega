// Expected exit: 0.
// A domain cast states what happens to every domain its operand's type
// carries (domains.md, "Domain-only casts"): `=D` keeps, `-D` removes and
// `+D` adds, and the result carries exactly the kept and added domains.
// `both` carries a unit tag and a predicate domain; the casts below add
// both to a plain value, keep both, keep one while removing the other,
// and remove both, each by name.
domain i32::Km;

domain i32::Positive requires self > 0;

machine plain_of(distance: i32 in Km) -> i32 { distance as -Km }

machine sum_of(distance: i32 in Km & Positive) -> i32 { distance as -Km -Positive }

machine main() crashes Trap {
    let start: i32 = 5;
    let both: i32 in Km & Positive = start as +Km +Positive;
    let same: i32 in Km & Positive = both as =Km =Positive;
    let km: i32 in Km = both as =Km -Positive;
    let plain: i32 = both as -Km -Positive;
    transition plain == 5 && plain_of(km) == 5 && sum_of(same) == 5 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
