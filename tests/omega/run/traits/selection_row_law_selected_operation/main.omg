// Expected exit: 0.
// A trait law is stated over the trait's own operations: `positive` promises
// `encode(value) > 0`. `WireCodec` selects the existing `encode_message` for
// `encode` and the existing lemma `encode_positive`, which was proved about
// `encode_message`, for the law. The law is read against the implementation's
// selections, so the lemma applies as it stands and no forwarding member
// restates it. The fail twin `fail/traits/selection_row_law_other_operation`
// differs only in the machine its `encode` row selects.
data Message { value: u64; }
trait LawCodec<T> {
    machine encode(value: &T) -> u64 terminates;
    machine positive(value: &T)
    ensures encode(value) > 0;
}
machine encode_message(value: &Message) -> u64 terminates
ensures result == 8
{ 8 }
machine encode_zero(value: &Message) -> u64 terminates
ensures result == 0
{ 0 }
machine encode_positive(value: &Message)
ensures encode_message(value) > 0
{}
WireCodec satisfies LawCodec<Message> {
    LawCodec::encode = encode_message;
    LawCodec::positive = encode_positive;
}
machine main() crashes Trap {
    let message: Message = Message { value: 8 };
    let observed: u64 = WireCodec::encode(&message);
    transition observed == 8 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
