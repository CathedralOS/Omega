machine build(builder: &mut Build) {
    Build::application(builder, "named_map_record_result_contract");
    Build::select_provider<Reports, CheckedReports>(builder, linux_arm64);
    Build::select_provider<Reports, CheckedReports>(builder, linux_x86_64);
    Build::select_provider<Reports, CheckedReports>(builder, macos_arm64);
    Build::select_provider<Reports, CheckedReports>(builder, macos_x86_64);
    Build::select_provider<Reports, CheckedReports>(builder, windows_x86_64);
    Build::select_provider<Reports, CheckedReports>(builder, uefi_x86_64);
    Build::select_provider<Reports, CheckedReports>(builder, cross_platform_cli);
    Build::select_provider<Reports, CheckedReports>(builder, local_unchecked);
    Build::select_provider<Reports, CheckedReports>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
