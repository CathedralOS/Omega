// Expected exit: 0. A crash ceiling does not change linear result transport.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

machine stop(item: Receipt) -> Receipt crashes Trap { crash Trap; }

machine choose(returning: bool, item: Receipt) -> Receipt crashes Trap {
    transition returning {
        true -> (item)
        false -> stop(item)
    }
}

machine main() crashes Trap {
    let received: Receipt = choose(true, Receipt { code: 47 });
    let correct: bool = received.code == 47;
    drop(received);
    transition correct { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
