// Expected exit: 0
// An empty array owns no elements, even when its element type is linear.
use omega::language::core::content;
use omega::language::core::extent;
use omega::language::core::drop;
data Units {}
data Envelope [linear] { quantity: u64; slots: [Extent; 0]; }
domain Envelope::Accounted;
machine Accounted::content(value: &Envelope) -> CountedQuantity<Units>
satisfies Content<Envelope, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(value.quantity) as Nat }
}
machine renew(whole: Envelope in Accounted) -> Envelope in Accounted
ensures Accounted::content(old(&whole)) == Accounted::content(&result) {
    Envelope { quantity: whole.quantity, slots: [] }
}

machine Envelope::drop(value: &mut Envelope) {}
machine main() crashes Trap {
    let whole: Envelope in Accounted = Envelope { quantity: 23, slots: [] };
    let renewed: Envelope in Accounted = renew(whole);
    let correct: bool = renewed.quantity == 23;
    drop(renewed);
    transition correct { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
