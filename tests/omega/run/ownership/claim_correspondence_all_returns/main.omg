// Expected exit: 0. Normal-return custody includes direct and named exits;
// unresolved returning alternatives are not absent, crash-only edges are not
// returns, and recursive invariant forwarding keeps the input identity.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }
data Routing {}

machine Routing::pack(swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition swap {
        false -> (Pair { left: left, right: right })
        true -> (Pair { left: right, right: left })
    }
}

machine Routing::route(direct: bool, swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition direct {
        true -> (Pair { left: left, right: right })
        false -> Routing::pack(swap, left, right)
    }
}

machine Routing::receive(direct: bool, swap: bool, left: Receipt, right: Receipt) -> Pair {
    let result: Pair = Routing::route(direct, swap, left, right);
    result
}

machine check(direct: bool, swap: bool, expected_left: i32, expected_right: i32) -> bool {
    let result: Pair = Routing::receive(direct, swap, Receipt { code: 13 }, Receipt { code: 29 });
    let correct: bool = result.left.code == expected_left && result.right.code == expected_right;
    let { left, right } = result;
    drop(left);
    drop(right);
    correct
}

machine carry(again: bool, item: Receipt) -> Receipt {
    transition again {
        false -> (item)
        true -> carry(false, item)
    }
}

machine stop(item: Receipt) -> Receipt crashes Trap { crash Trap; }

machine choose(returning: bool, item: Receipt) -> Receipt crashes Trap {
    transition returning {
        true -> (item)
        false -> stop(item)
    }
}

machine main() crashes Trap {
    let direct: bool = check(true, true, 13, 29);
    let ordered: bool = check(false, false, 13, 29);
    let swapped: bool = check(false, true, 29, 13);
    let carried: Receipt = carry(true, Receipt { code: 41 });
    let recursive: bool = carried.code == 41;
    drop(carried);
    let chosen: Receipt = choose(true, Receipt { code: 47 });
    let normal: bool = chosen.code == 47;
    drop(chosen);
    transition direct && ordered && swapped && recursive && normal {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
