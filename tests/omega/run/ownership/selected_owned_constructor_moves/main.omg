// Expected exit: 0. Each selected branch moves the same live source once.
use omega::language::core::drop;
data Token [linear] { value: i32; }
machine Token::drop(token: &mut Token) {}
machine consume(token: Token) -> i32 { drop(token); 0 }
machine observe(token: &Token) -> i32 { token.value }
data Envelope { token: Token; }
machine after(first: i32, envelope: Envelope) -> i32 { consume(envelope.token) }
machine selected(token: Token, choice: bool) -> i32 {
    let result: i32 = match choice {
        true -> after(observe(&token), Envelope { token: token }),
        false -> after(0, Envelope { token: token }),
    };
    result
}
machine main() crashes Trap {
    let left: i32 = selected(Token { value: 17 }, true);
    let right: i32 = selected(Token { value: 29 }, false);
    transition left == 0 && right == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
