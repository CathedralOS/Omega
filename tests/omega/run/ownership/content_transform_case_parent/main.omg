// Expected exit: 0
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { start: u64; end: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.start) as Nat, end: embed(region.end) as Nat }
}
data Holder { case Filled(region: Region in Owned); }
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(holder: Holder, cut: u64) -> Pieces
requires holder in Holder::Filled;
    holder.region.start <= cut && cut <= holder.region.end
ensures Owned::content(old(&holder.region)) == separate(
    Owned::content(&result.left), Owned::content(&result.right)) {
    let left: Region = Region { start: holder.region.start, end: cut };
    let right: Region = Region { start: cut, end: holder.region.end };
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let pieces: Pieces = split(Holder::Filled { region: Region { start: 10, end: 90 } }, 30);
    let correct: bool = pieces.left.start == 10 && pieces.left.end == 30
        && pieces.right.start == 30 && pieces.right.end == 90;
    drop(pieces.left);
    drop(pieces.right);
    transition correct { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
