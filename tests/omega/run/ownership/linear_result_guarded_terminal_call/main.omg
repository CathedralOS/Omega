// Expected exit: 0. Selected-arm facts cover the terminal call's crash route.
use omega::language::core::drop;
data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
machine stop(item: Receipt) -> Receipt crashes Trap { crash Trap; }
machine choose(stopping: bool, item: Receipt) -> Receipt crashes Trap stopping {
    transition stopping { true -> stop(item) false -> (item) }
}
machine relay(stopping: bool, item: Receipt) -> Receipt {
    transition { _ -> choose(stopping, item) }
}
machine main() crashes Trap {
    let received: Receipt = relay(false, Receipt { code: 47 });
    let correct: bool = received.code == 47;
    drop(received);
    transition correct { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
