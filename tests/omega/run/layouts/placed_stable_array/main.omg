// Expected exit: 0
// Indexed Stable array access preserves each element and its original backing.
use omega::language::core::layout;
public data Values { words: [u64; 2]; }
public data StablePlacement {}
machine StablePlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 16, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}
machine main() crashes Trap {
    let mut value: Values = Values { words: [17, 41] };
    let observed: bool = exchange(Placed::view_mut<StablePlacement, Values>(&mut value));
    transition observed && value.words[0] == 29 && value.words[1] == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exchange(view: &mut Placed<StablePlacement, Values>) -> bool {
    let first: u64 = placed_read(&view.words[0]);
    let second: u64 = placed_read(&view.words[1]);
    replace(view, 0, 29);
    replace(view, 1, 73);
    let updated_first: u64 = placed_read(&view.words[0]);
    let updated_second: u64 = placed_read(&view.words[1]);
    first == 17 && second == 41 && updated_first == 29 && updated_second == 73
}

machine replace(view: &mut Placed<StablePlacement, Values>, selected: u64, value: u64)
requires selected < 2
{
    placed_write(&mut view.words[selected], value);
}
