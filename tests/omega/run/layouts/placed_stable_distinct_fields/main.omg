// Expected exit: 0
// Scalar and distinct array fields keep separate permission identities.
use omega::language::core::layout;
public data Values { sentinel: u64; readonly: [u64; 2]; writable: [u64; 3]; }
public data StablePlacement {}
machine StablePlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 24 } };
    let services: [u64; 32];
    let scalar: AccessPlan = AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: false, exposure: Exposure::Exported });
    let readonly: AccessPlan = AccessPlan::with(scalar, schema.fields[1].key,
        FieldAccess::Stable { read: true, write: false, exposure: Exposure::Exported });
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 3, size_fixed: 48, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(readonly, schema.fields[2].key,
            FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}
machine main() crashes Trap {
    let mut value: Values = Values { sentinel: 911, readonly: [17, 19], writable: [31, 37, 41] };
    let observed: bool = exchange(Placed::view_mut<StablePlacement, Values>(&mut value), 2);
    transition observed && value.sentinel == 911 && value.readonly[0] == 17 && value.readonly[1] == 19
        && value.writable[0] == 31 && value.writable[1] == 37 && value.writable[2] == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exchange(view: &mut Placed<StablePlacement, Values>, index: u64) -> bool
requires index < 3
{
    let sentinel: u64 = placed_read(&view.sentinel);
    let readonly: u64 = placed_read(&view.readonly[1]);
    let before: u64 = placed_read(&view.writable[index]);
    placed_write(&mut view.writable[index], 73u64);
    let after: u64 = placed_read(&view.writable[index]);
    sentinel == 911 && readonly == 19 && before == 41 && after == 73
}
