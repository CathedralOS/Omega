// Expected exit: 0
// Nested dynamic selectors retain one parent region and preserve neighboring words.
use omega::language::core::layout;
public data Values { sentinel: u64; words: [[u64; 3]; 2]; }
public data StablePlacement {}
machine StablePlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 2, size_fixed: 56, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[1].key,
            FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}
machine main() crashes Trap {
    let mut value: Values = Values { sentinel: 911, words: [[17, 19, 23], [31, 37, 41]] };
    let observed: bool = exchange(Placed::view_mut<StablePlacement, Values>(&mut value), 1, 2);
    transition observed && value.sentinel == 911 && value.words[0][0] == 17 && value.words[0][2] == 23
        && value.words[1][0] == 31 && value.words[1][1] == 37 && value.words[1][2] == 73 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exchange(view: &mut Placed<StablePlacement, Values>, row: u64, column: u64) -> bool
requires row < 2 && column < 3
{
    let before: u64 = placed_read(&view.words[row][column]);
    placed_write(&mut view.words[row][column], 73u64);
    let after: u64 = placed_read(&view.words[row][column]);
    before == 41 && after == 73
}
