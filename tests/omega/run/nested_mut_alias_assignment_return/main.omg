// Run: omega run --both tests/omega/run/nested_mut_alias_assignment_return/main.omg
// Nested mutable calls preserve the seeded generator state and print "yes".
use omega_language_std::console;

data RandomState {
    seed: u64 in Wrapping;
    calls: u64 in Wrapping;
}

data Random {
}

machine seed(
    value: u64,
    state: &mut RandomState
) {
    state.seed = value as u64 in Wrapping;
    state.calls = 0;
}

machine next_u32(
    state: &mut RandomState
) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;

    ((state.seed >> 32) as u32 in Wrapping) as u32
}

machine range(
    state: &mut RandomState,
    exclusive_max: u32
) -> u32
requires exclusive_max > 0
{
    let raw: u32 = next_u32(state);

    raw % exclusive_max
}

machine random_chance(
    random: &mut Random,
    state: &mut RandomState,
    numerator: u32,
    denominator: u32
) -> bool
requires denominator > 0
{
    let roll: u32 = range(state, denominator);

    roll < numerator
}

data Generator {
    rng: Random;
}

machine run(generator: &mut Generator) reaches Console {
    let mut random: RandomState;
    seed(1, &mut random);

    let carve: bool = should_carve(generator, &mut random, 1);

    transition carve {
        true -> yes(generator)
        false -> no(generator)
    }
    machine yes(generator: &mut Generator) {
        Console::write_line("yes");
    }

    machine no(generator: &mut Generator) {
        Console::write_line("no");
    }
}

machine should_carve(
    generator: &mut Generator,
    random: &mut RandomState,
    depth: u32
) -> bool {
    let chance: u32 = 99;
    let rolled: bool = random_chance(&mut generator.rng, random, chance, 100);

    rolled
}

data Main {
    generator: Generator;
}

machine main(context: &mut Main) reaches Console {
    run(&mut context.generator);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
