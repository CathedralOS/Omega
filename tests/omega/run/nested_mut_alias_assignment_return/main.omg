use omega::language::std::console;

data RandomState {
    seed: u64;
    calls: UInt;
}

data Random {
}

machine Random::seed(
    &mut self,
    value: u64,
    state: &mut RandomState
) {
    state.seed = value;
    state.calls = 0;
}

machine Random::next_u32(
    &mut self,
    state: &mut RandomState
    ) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;

    ((state.seed >> 32) as u32)
}

machine Random::range(
    &mut self,
    state: &mut RandomState,
    exclusive_max: u32
    ) -> u32 {
    let raw: u32 = self.next_u32(state);

    raw % exclusive_max
}

machine Random::chance(
    &mut self,
    state: &mut RandomState,
    numerator: u32,
    denominator: u32
    ) -> bool {
    let roll: u32 = self.range(state, denominator);

    roll < numerator
}

data Generator {
    console: Console;
    rng: Random;
}

machine Generator::run(&mut self) {
    let random: RandomState;
    self.rng.seed(1, &mut random);

    let carve: bool = self.should_carve(&mut random, 1);

    transition carve {
        true -> yes()
        false -> no()
    }
    


    state yes(&mut self) {
        self.console.write_line("yes");
    }

    state no(&mut self) {
        self.console.write_line("no");
    }
}

machine Generator::should_carve(
    &mut self,
    random: &mut RandomState,
    depth: u32
    ) -> bool {
    let chance: u32 = 99;
    let rolled: bool = self.rng.chance(random, chance, 100);

    rolled
}

data Main {
    generator: Generator;
}

machine Main::main(&mut self) -> i32 {
    self.generator.run();
    0
}
