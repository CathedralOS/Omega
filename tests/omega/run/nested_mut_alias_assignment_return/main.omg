use omega::language::std::console;
use omega::language::core::binding;

data RandomState {
    seed: u64 in Wrapping;
    calls: u64 in Wrapping;
}

data Random {
}

machine Random::seed(
    value: u64,
    state: &mut RandomState
) {
    state.seed = value as u64 in Wrapping;
    state.calls = 0;
}

machine Random::next_u32(
    state: &mut RandomState
    ) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;

    ((state.seed >> 32) as u32 in Wrapping) as u32
}

machine Random::range(
    state: &mut RandomState,
    exclusive_max: u32
    ) -> u32 {
    let raw: u32 = Random::next_u32(state);

    raw % exclusive_max
}

machine Random::chance(
    random: &mut Random,
    state: &mut RandomState,
    numerator: u32,
    denominator: u32
    ) -> bool {
    let roll: u32 = random.range(state, denominator);

    roll < numerator
}

data Generator {
    console: Binding<Console>;
    rng: Random;
}

machine Generator::run(generator: &mut Generator) reaches Console {
    let random: RandomState;
    Random::seed(1, &mut random);

    let carve: bool = Generator::should_carve(generator, &mut random, 1);

    transition carve {
        true -> yes(generator)
        false -> no(generator)
    }
    


    state yes(generator: &mut Generator) {
        generator.console.write_line("yes");
    }

    state no(generator: &mut Generator) {
        generator.console.write_line("no");
    }
}

machine Generator::should_carve(
    generator: &mut Generator,
    random: &mut RandomState,
    depth: u32
    ) -> bool {
    let chance: u32 = 99;
    let rolled: bool = Random::chance(&mut generator.rng, random, chance, 100);

    rolled
}

data Main {
    generator: Generator;
}

machine Main::main(&mut self) -> i32 reaches Console {
    Generator::run(&mut self.generator);
    0
}
