// Expected exit: 0
// A portable provider's direct callees must exist on the selected target.
// The remaining provider calls an ordinary boundary dependency; that is not
// an absent target body and still closes through normal provider selection.

use omega_language_std::console;

boundary trait Value {
    machine read() -> i32 reaches;
    machine other() -> i32 reaches;
}
boundary trait Upstream { machine read() -> i32 reaches; }

PortableValue satisfies Value {
    machine read() -> i32 { selected_member() }
    machine other() -> i32 { 0 }
}
SourceValue satisfies Upstream {
    machine read() -> i32 { 42 }
}
FirmwareValue satisfies Value {
    machine read() -> i32 { bridge(2) }
    machine other() -> i32 { 0 }
}
// The foreign sibling must not contaminate the selected member's closure.
macos_arm64 machine selected_member() -> i32 { Upstream::read() }
linux_arm64 machine selected_member() -> i32 { Upstream::read() }
linux_x86_64 machine selected_member() -> i32 { Upstream::read() }
windows_x86_64 machine selected_member() -> i32 { Upstream::read() }
uefi_x86_64 machine selected_member() -> i32 { absent_on_uefi() }
linux_x86_64 machine absent_on_uefi() -> i32 { 1 }
machine bridge(remaining: u64) -> i32
terminates by remaining;
{ transition { _ -> nested_bridge(remaining) } }
// The absent leaf also propagates through a recursive direct-call component.
machine nested_bridge(remaining: u64) -> i32
terminates by remaining;
{
    let value: i32 = firmware_only();
    transition remaining > 0 { true -> again(remaining) false -> value }
    state again(remaining: u64) -> i32 requires remaining > 0
    { transition { _ -> bridge(remaining - 1) } }
}
uefi_x86_64 machine firmware_only() -> i32 { 63 }

machine main() reaches Console {
    transition Value::read() == 42 && Value::other() == 0 {
        true -> done()
        false -> wrong()
    }
    state done() { Console::exit_process(0); }
    state wrong() { Console::exit_process(1); }
}
