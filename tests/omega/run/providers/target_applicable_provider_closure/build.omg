machine build(builder: &mut Build) {
    Build::application(builder, "target_applicable_provider_closure");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Value, PortableValue>(builder, macos_arm64);
    Build::select_provider<Value, PortableValue>(builder, linux_arm64);
    Build::select_provider<Value, PortableValue>(builder, linux_x86_64);
    Build::select_provider<Value, PortableValue>(builder, windows_x86_64);
    Build::select_provider<Upstream, SourceValue>(builder, macos_arm64);
    Build::select_provider<Upstream, SourceValue>(builder, linux_arm64);
    Build::select_provider<Upstream, SourceValue>(builder, linux_x86_64);
    Build::select_provider<Upstream, SourceValue>(builder, windows_x86_64);
}
