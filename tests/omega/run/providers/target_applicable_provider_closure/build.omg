machine build(builder: &mut Build) {
    Build::select_provider<SelectedSelectedMember, CheckedSelectedMember>(builder, macos_arm64);
    Build::select_provider<SelectedSelectedMember, CheckedSelectedMember>(builder, linux_arm64);
    Build::select_provider<SelectedSelectedMember, CheckedSelectedMember>(builder, linux_x86_64);
    Build::select_provider<SelectedSelectedMember, CheckedSelectedMember>(builder, windows_x86_64);
    Build::select_provider<SelectedAbsentOnUefi, CheckedAbsentOnUefi>(builder, linux_x86_64);

    Build::application(builder, "target_applicable_provider_closure");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
