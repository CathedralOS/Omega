module conversion_probe;
use omega::language::core::float_operations;
use omega_language_std::console;
use omega::language::core::binding;

pub data Main { console: Binding<Console>; }
// Named modules must not make unchanged core provider families disappear.
// The byte is runtime input so the conversion also crosses native/Terminal.
pub machine Main::main(application: &mut Main) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition block application.console.read_byte() {
        ByteRead::Byte { value } -> convert(application, value)
        _ -> missing(application)
    }
    state convert(application: &mut Main, value: i32) {
        let floating: f64 = F64::from_i32(value) + 0.75;
        let converted: i32 in Saturating = I32::from_f64(floating);
        transition converted == 65 {
            true -> done(application)
            false -> wrong(application)
        }
    }
    state done(application: &mut Main) {
        application.console.write_line("converted=65");
        application.console.exit_process(0);
    }
    state missing(application: &mut Main) { application.console.exit_process(2); }
    state wrong(application: &mut Main) { application.console.exit_process(3); }
}
