// A suffix on an operator chooses the overflow policy for that one operation:
// `%` wraps, `|` saturates and `!` traps. The operands and the result stay
// plain integers, so nothing here carries a policy domain except the
// comparison values each machine builds to show the two spellings agree.
use omega_language_std::console;
const STEP: u32 = 4000000000;
// A constant computed by a machine makes the compiler check a projection of
// this program that leaves out the machines below; their suffixed operators
// must not disturb it.
const LIMIT: u32 = limit();
data Main {
    total: u32;
}

machine limit() -> u32 { 7 }

machine wrapping_sum(a: u32, b: u32) -> u32 {
    a +% b
}

machine wrapping_unsigned(a: u32, b: u32) -> bool {
    let sum: u32 = a +% b;
    let difference: u32 = b -% a;
    let product: u32 = a *% a;
    let qa: u32 in Wrapping = a as u32 in Wrapping;
    let qb: u32 in Wrapping = b as u32 in Wrapping;
    sum == ((qa + qb) as u32) && difference == ((qb - qa) as u32) && product == ((qa * qa) as u32)
        && sum == 1 && difference == 3 && product == 1
}

machine wrapping_signed(a: i32, b: i32) -> bool {
    let sum: i32 = a +% b;
    let difference: i32 = b -% a;
    let product: i32 = a *% 2;
    let qa: i32 in Wrapping = a as i32 in Wrapping;
    let qb: i32 in Wrapping = b as i32 in Wrapping;
    sum == ((qa + qb) as i32) && difference == ((qb - qa) as i32) && product == ((qa * 2) as i32)
        && sum == -2147483648 && difference == -2147483646 && product == -2
}

machine saturating_unsigned(a: u8, b: u8) -> bool {
    let sum: u8 = a +| b;
    let difference: u8 = b -| a;
    let product: u8 = a *| b;
    let qa: u8 in Saturating = a as u8 in Saturating;
    let qb: u8 in Saturating = b as u8 in Saturating;
    sum == ((qa + qb) as u8) && difference == ((qb - qa) as u8) && product == ((qa * qb) as u8)
        && sum == 255 && difference == 0 && product == 255
}

machine saturating_signed(a: i32, b: i32) -> bool {
    let sum: i32 = a +| b;
    let difference: i32 = b -| a;
    let product: i32 = a *| b;
    let qa: i32 in Saturating = a as i32 in Saturating;
    let qb: i32 in Saturating = b as i32 in Saturating;
    sum == ((qa + qb) as i32) && difference == ((qb - qa) as i32) && product == ((qa * qb) as i32)
        && sum == 2147483647 && difference == -2147483646 && product == 2147483647
}

machine trapping_unsigned(a: u64, b: u64) -> bool crashes Trap {
    let sum: u64 = a +! b;
    let difference: u64 = a -! b;
    let product: u64 = a *! b;
    let qa: u64 in Trapping = a as u64 in Trapping;
    let qb: u64 in Trapping = b as u64 in Trapping;
    sum == ((qa + qb) as u64) && difference == ((qa - qb) as u64) && product == ((qa * qb) as u64)
        && sum == 42 && difference == 38 && product == 80
}

machine trapping_signed(a: i32, b: i32) -> bool crashes Trap {
    let sum: i32 = a +! b;
    let difference: i32 = a -! b;
    let product: i32 = a *! b;
    let qa: i32 in Trapping = a as i32 in Trapping;
    let qb: i32 in Trapping = b as i32 in Trapping;
    sum == ((qa + qb) as i32) && difference == ((qa - qb) as i32) && product == ((qa * qb) as i32)
        && sum == -38 && difference == -42 && product == -80
}

// Signed MIN / -1 and MIN % -1: Wrapping keeps MIN and zero, Saturating
// clamps the quotient to MAX. Neither licenses a zero divisor.
machine minimum_quotient(value: i32, divisor: i32) -> bool
    requires divisor != 0
{
    let wrapped: i32 = value /% divisor;
    let wrapped_rest: i32 = value %% divisor;
    let clamped: i32 = value /| divisor;
    let clamped_rest: i32 = value %| divisor;
    wrapped == -2147483648 && wrapped_rest == 0 && clamped == 2147483647 && clamped_rest == 0
}

// Shift counts: `%` reduces the count modulo the width, `|` keeps the Exact
// count proof, and `!` checks the count when the shift runs.
machine shifts(value: u32, count: u32) -> bool crashes Trap
    requires count == 33
{
    let reduced_left: u32 = value <<% count;
    let reduced_right: u32 = value >>% count;
    let proved_left: u32 = value <<| 4;
    let proved_right: u32 = value >>| 4;
    let checked_left: u32 = value <<! 3;
    let checked_right: u32 = value >>! 3;
    reduced_left == 96 && reduced_right == 24 && proved_left == 768 && proved_right == 3
        && checked_left == 384 && checked_right == 6
}

// A guard that rules the overflow out removes the crash route, so this
// public machine publishes no `crashes Trap`.
public machine guarded_sum(left: u64, right: u64) -> u64
    requires left <= 1000, right <= 1000
{
    left +! right
}

// The same wrapping operation carried through a field, a named constant, a
// match join, a transition guard, a nested machine and a call result.
machine field_and_constant(main: &mut Main) -> u32 {
    main.total = main.total +% STEP;
    main.total +% STEP
}

machine joined(a: u32, b: u32, forward: bool) -> u32 {
    let result: u32 = match forward {
        true -> a +% b,
        _ -> b -% a
    };
    result
}

machine nested(a: u32) -> u32 {
    transition a +% LIMIT > 17 {
        true -> high(a)
        _ -> low(a)
    }
    machine high(a: u32) -> u32 { a *% 1000000000 }
    machine low(a: u32) -> u32 { a -% 11 }
}

machine chained(a: u32, b: u32) -> u32 {
    (a +% b) *% (b -% a) +% joined(a, b, true)
}

machine placements(main: &mut Main) -> bool {
    main.total = 1000000000;
    let placed: u32 = field_and_constant(main);
    placed == 410065408 && main.total == 705032704
        && joined(4294967295, 2, true) == 1 && joined(3, 2, false) == 4294967295
        && nested(12) == 3410065408 && nested(10) == 4294967295
        && chained(4294967295, 2) == 4
}

machine main(main: &mut Main) reaches Console crashes Trap {
    let wrapped: bool = wrapping_unsigned(4294967295, 2) && wrapping_signed(2147483647, 1);
    let clamped: bool = saturating_unsigned(250, 10) && saturating_signed(2147483647, 1);
    let checked: bool = trapping_unsigned(40, 2) && trapping_signed(-40, 2);
    let quotient: bool = minimum_quotient(-2147483648, -1);
    let shifted: bool = shifts(48, 33);
    let guarded: u64 = guarded_sum(40, 2);
    let placed: bool = placements(main) && wrapping_sum(4294967295, 2) == 1;
    transition wrapped && clamped && checked && quotient && shifted && guarded == 42 && placed {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
