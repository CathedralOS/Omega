use omega_language_std::console;
use omega::language::core::float_operations;

// Both carriers retain boundary requirement selections below their initializer.
data Pair { left: f64; right: f64; }
data Main { }
machine Main::main(root: &mut Main) reaches Console {
    let pair: Pair = Pair { left: 12.0 / 3.0, right: 10.0 / 2.0 };
    let values: [f64; 2] = [18.0 / 3.0, 28.0 / 4.0];
    transition pair.left == 4.0 && pair.right == 5.0 && values[0] == 6.0 && values[1] == 7.0 {
        true -> success(root)
        false -> failure(root)
    }
    state success(root: &mut Main) {
        Console::exit_process(0);
    }
    state failure(root: &mut Main) {
        Console::exit_process(1);
    }
}
