// `%!` traps on signed `MIN % -1`: the remainder would be zero, but the
// quotient it belongs to does not fit `i32`. `%%` and `%|` return zero for
// the same operands in run/arithmetic/policy_operators_match_policy_domains.
use omega_language_std::console;
data Main { }

machine rest(value: i32, divisor: i32) -> i32 crashes Trap
    requires divisor != 0
{
    value %! divisor
}

machine subject() -> bool crashes Trap {
    rest(-2147483648, -1) == 0
}

// Reaching either exit means the operation returned instead of trapping.
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    transition subject() {
        true -> returned(main)
        _ -> returned_other(main)
    }
    machine returned(main: &mut Main) { Console::exit_process(70); }
    machine returned_other(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
