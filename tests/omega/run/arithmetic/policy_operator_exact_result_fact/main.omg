// A `!` operation that returns did not trap, so its result equals the exact
// mathematical result. The Exact operations that follow rely on that: the
// operands carry no bound of their own, and `sum - left` fits `u64` only
// because `sum` is known to be `left + right`.
use omega_language_std::Console;
data Main { }

machine regained(left: u64, right: u64) -> u64 crashes Trap {
    let sum: u64 = left +! right;
    sum - left
}

machine restored(left: u64, right: u64) -> u64 crashes Trap {
    let difference: u64 = left -! right;
    difference + right
}

// The same fact through operands that carry the `Trapping` domain.
machine regained_qualified(left: u64, right: u64) -> u64 crashes Trap {
    let trapping_left: u64 in Trapping = left as u64 in Trapping;
    let trapping_right: u64 in Trapping = right as u64 in Trapping;
    let sum: u64 = (trapping_left + trapping_right) as u64;
    sum - left
}

machine subject() -> bool crashes Trap {
    regained(40, 2) == 2 && restored(40, 2) == 40 && regained_qualified(40, 2) == 2
}

machine Main::main(main: &mut Main) reaches Console crashes Trap {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
