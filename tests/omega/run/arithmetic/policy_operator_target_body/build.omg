machine build(builder: &mut Build) {
    Build::application(builder, "policy_operator_target_body");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::select_provider<SelectedMix, ArmMix>(builder, macos_arm64);
    Build::select_provider<SelectedMix, X86Mix>(builder, linux_x86_64);
    Build::select_provider<SelectedMix, ArmMix>(builder, linux_arm64);
    Build::select_provider<SelectedMix, X86Mix>(builder, windows_x86_64);
}
