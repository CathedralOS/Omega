// A match publishes two windows of length 2. A call returns the selected
// window inside a record. The caller writes through a local, that field, a
// parameter, and the call result.
// Expected native exit: 0
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

data Held<'samples> { values: &'samples mut [f64]; }

machine window<'samples>(samples: &'samples mut [f64; 4], which: i64) -> &'samples mut [f64]
ensures result.len == 2
{
    match which {
        0 -> &mut samples[0..2]
        _ -> &mut samples[2..4]
    }
}

machine hold<'samples>(samples: &'samples mut [f64]) -> Held<'samples>
requires samples.len == 2
ensures result.values.len == 2
{
    Held { values: samples }
}

machine write_pair(window: &mut [f64])
requires window.len >= 2 {
    window[0] = 0.0;
    window[1] = 1.0;
}

machine main() crashes Trap {
    let mut trace: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let view: &mut [f64] = window(&mut trace, 0);
    let leading: Held = hold(view);
    write_pair(leading.values);
    let span: u64 = leading.values.len;
    transition span == 2 {
        true -> tail(&mut trace)
        false -> bad()
    }
    state tail(trace: &mut [f64; 4]) {
        let selected: &mut [f64] = window(trace, 1);
        let trailing: Held = hold(selected);
        write_pair(trailing.values);
        let first: i32 in Saturating = I32::from_f64(trace[0]);
        let second: i32 in Saturating = I32::from_f64(trace[1]);
        let third: i32 in Saturating = I32::from_f64(trace[2]);
        let fourth: i32 in Saturating = I32::from_f64(trace[3]);
        transition first == 0 && second == 1 && third == 0 && fourth == 1 {
            true -> done()
            false -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
