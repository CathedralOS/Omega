use omega_language_std::console;

machine emit(character: i32, enabled: bool) reaches Console requires character >= 0 && character <= 255 {
    transition enabled {
        true -> output(character)
        false -> skipped()
    }
    state output(character: i32) requires character >= 0 && character <= 255 {
        Console::write_byte(character);
    }
    state skipped() { }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    emit(88, false);
    emit(65, true);
    emit(10, true);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
