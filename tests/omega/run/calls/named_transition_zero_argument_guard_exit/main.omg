// Expected exit: 0. Exact dyadic arithmetic must produce 15 twice.
// A guarded named machine transition retains dense scalar arguments beside
// interleaved borrows, including the literals and the guard call ordinal.
use omega::language::core::float_operations;
data Cell { value: f64; }
machine weighted(left: &Cell, shift: i32 in Wrapping, right: &Cell, index: u32 in Saturating, weight: f64, tail: f64) -> f64 {
    weight*left.value+tail*right.value+F64::from_i32(shift as i32)+F64::from_u32(index as u32)
}
machine choose() -> bool { true }
machine route(left: &Cell, right: &Cell, first: bool) -> f64 {
    transition choose() {
        true -> weighted(left, 2, right, 3, 0.25, 0.75)
        false -> weighted(right, -2, left, 4, 0.5, 0.5)
    }
}
machine main() crashes Trap {
    let left: Cell = Cell { value: 4.0 };
    let right: Cell = Cell { value: 12.0 };
    let first: f64 = route(&left, &right, true);
    let second: f64 = route(&left, &right, false);
    transition first == 15.0 && second == 15.0 {
        true -> done() false -> bad()
    }
    state done() { }
    state bad() { crash Trap; }
}
