// Expected exit: 0. The saved bool subject preserves its scalar call operand.
use omega::language::core::float_operations;
machine choose(value: bool) -> bool { value }
machine route(first: bool) -> f64 {
 transition choose(first) { true -> 15.0 false -> 10.0 }
}
machine main() crashes Trap {
 let first: f64 = route(true); let second: f64 = route(false);
 transition first == 15.0 && second == 10.0 { true -> done() false -> bad() }
 state done() { } state bad() { crash Trap; }
}
