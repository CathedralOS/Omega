// Expected exit: 0.
use omega::language::core::binding;

pub boundary trait Character {
    machine echo(value: i32) -> i32;
    machine store(output: &mut i32, value: i32);
}
CharacterImplementation satisfies Character {
    Character::echo = echo;
    Character::store = store;
}
machine echo(value: i32) -> i32 { value }
machine store(output: &mut i32, value: i32) { output = value; }
data Main { character: Binding<Character>; value: i32; phase: i32; }
machine letter() -> i32 { 65 }
machine authority<'loan>(character: &'loan Binding<Character>) -> &'loan Binding<Character> { character }
machine choose_authority<'loan>(first: &'loan Binding<Character>, second: &'loan Binding<Character>, choose_first: bool) -> &'loan Binding<Character> {
    transition choose_first { true -> first _ -> second }
}
machine selected(first: &Binding<Character>, second: &Binding<Character>, choose_first: bool) -> i32 reaches Character {
    Character::echo(choose_authority(first, second, choose_first), 65)
}
machine sequenced_authority<'loan>(character: &'loan Binding<Character>, phase: &mut i32) -> &'loan Binding<Character> {
    phase = 1;
    character
}
machine ordinary_argument(phase: &mut i32) -> i32 {
    let previous: i32 = phase;
    phase = 2;
    transition previous == 1 { true -> 65 _ -> 0 }
}
machine forwarded(character: &Binding<Character>, output: &mut i32) reaches Character {
    Character::store(character, output, letter());
}
machine touch(context: &mut Main) { context.value = 65; }
machine Main::main(context: &mut Main) reaches Character crashes Trap {
    forwarded(&context.character, &mut context.value);
    Character::store(authority(&context.character), &mut context.value, Character::echo(&context.character, letter()));
    touch(context);
    let result: i32 = Character::echo(authority(&context.character), context.value);
    _ = Character::echo(&context.character, result);
    let ordered: i32 = Character::echo(sequenced_authority(&context.character, &mut context.phase), ordinary_argument(&mut context.phase));
    let chosen: i32 = selected(&context.character, &context.character, false);
    context.phase = 0;
    _ = Character::echo(sequenced_authority(&context.character, &mut context.phase), ordinary_argument(&mut context.phase));
    transition result == 65 && ordered == 65 && chosen == 65 && context.phase == 2 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
