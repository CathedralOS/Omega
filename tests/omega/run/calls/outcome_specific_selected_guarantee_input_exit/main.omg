// A caller arm selects outputs of the callee's outcome-specific guarantees
// whose propositions name the callee's scalar input: `above(threshold)` and
// `both(threshold, result)`. The caller's instantiated applications name
// the call's own argument and result, so each selected row carries an
// argument substitution to the call's scalar argument (and, for `both`, the
// result substitution too). Exit 0 means the selected arm ran in the entry
// machine and in a scalar-result helper.
use omega_language_std::console;

data Outcome [copy] {
    case Success;
    case Failure;
}

trait Evidence {
}

proposition above(limit: u32) evidence Evidence;
proposition both(limit: u32, value: Outcome) evidence Evidence;

Fresh satisfies Evidence {
}

data Main {
}

machine pick(threshold: u32) -> Outcome
ensures Outcome::Success -> { selected: above(threshold); mixed: both(threshold, result); }
{
    transition threshold > 3 {
        true -> succeed()
        false -> fail()
    }

    state succeed() {
        selected = Fresh;
        mixed = Fresh;
        Outcome::Success
    }

    state fail() {
        Outcome::Failure
    }
}

machine check(threshold: u32) -> bool {
    transition pick(threshold) {
        Outcome::Success { ; selected: proof, mixed: witness } -> (true)
        _ -> (false)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let high: u32 = 5;
    transition pick(high) {
        Outcome::Success { ; selected: proof, mixed: witness } -> helper(main, check(7))
        _ -> bad(main)
    }

    state helper(main: &mut Main, valid: bool) {
        transition valid {
            true -> ok(main)
            false -> bad(main)
        }
    }

    state ok(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
