use omega_language_std::console;
// Regression: the block parameter has repeated fixed-register uses across calls.
machine number(value: i32 in Saturating) reaches Console
{
    transition value < 0 { true -> negative(value) false -> positive(value) }
    machine negative(value: i32 in Saturating) {
        Console::write("-");
        transition { _ -> positive(0 - value) }
    }
    machine positive(value: i32 in Saturating) {
        Console::write_byte(((value / 1000000 % 10) + 48) as i32);
        Console::write_byte(((value / 100000 % 10) + 48) as i32);
        Console::write_byte(((value / 10000 % 10) + 48) as i32);
        Console::write_byte(((value / 1000 % 10) + 48) as i32);
        Console::write_byte(((value / 100 % 10) + 48) as i32);
        Console::write_byte(((value / 10 % 10) + 48) as i32);
        Console::write_byte(((value / 1 % 10) + 48) as i32);
        Console::write_line("");
    }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    number(1234567);
    number(0 - 2345678);
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
