// Table projections and four carried arguments survive repeated native calls.
use omega_language_std::console;
data Row { cost: u64 in Wrapping; score: u64 in Wrapping;
    feasible: u64 in Wrapping; code: u64 in Wrapping; }
data Table { rows: [Row; 8]; }
data Budget { minimum: u64 in Wrapping; }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let mut table: Table;
    Table::load(&mut table);
    let mut budget: Budget;
    budget.minimum = 12;
    Main::report(main, &table, &budget);
    Console::exit_process(0);
}
machine Table::load(table: &mut Table) {
    transition { _ -> row(table, 0) }
    state row(table: &mut Table, position: u64 in Wrapping) {
        transition position < 8 {
            true -> store(table, position)
            false -> { }
        }
    }
    state store(table: &mut Table, position: u64 in Wrapping) {
        table.rows[position].cost = position + 2;
        table.rows[position].score = position * 3 + 5;
        table.rows[position].feasible = position + 1;
        table.rows[position].code = position * 4;
        transition { _ -> row(table, position + 1) }
    }
}
machine Main::number(main: &mut Main, value: u64 in Wrapping) reaches Console {
    Console::write_byte(((value / 1000) % 10) as i32 + 48);
    Console::write_byte(((value / 100) % 10) as i32 + 48);
    Console::write_byte(((value / 10) % 10) as i32 + 48);
    Console::write_byte((value % 10) as i32 + 48);
}
machine Main::report(main: &mut Main, table: &Table, budget: &Budget) reaches Console {
    transition { _ -> row(main, table, budget, 0) }
    state row(main: &mut Main, table: &Table, budget: &Budget, position: u64 in Wrapping) {
        transition position < 8 {
            true -> emit(main, table, budget, position)
            false -> finish(main, budget)
        }
    }
    state emit(main: &mut Main, table: &Table, budget: &Budget, position: u64 in Wrapping) {
        Console::write("row="); Main::number(main, position);
        Console::write(" cost="); Main::number(main, table.rows[position].cost);
        Console::write(" score="); Main::number(main, table.rows[position].score);
        Console::write(" feasible="); Main::number(main, table.rows[position].feasible);
        Console::write(" code="); Main::number(main, table.rows[position].code);
        Console::write_byte(10);
        transition { _ -> row(main, table, budget, position + 1) }
    }
    state finish(main: &mut Main, budget: &Budget) {
        Console::write("minimum="); Main::number(main, budget.minimum);
        Console::write_byte(10);
    }
}
