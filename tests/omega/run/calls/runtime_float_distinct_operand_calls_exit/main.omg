use omega::language::core::min_f64;

module numeric_distinct;
use omega_language_std::ByteRead;
use omega_language_std::Console;
use omega::language::core::F64::from_i32;
use omega::language::core::I32::from_f64;

public data Counter { calls: u32 in Wrapping; }
public data Main { counter: Counter; }

machine step(counter: &mut Counter, value: i32) -> f64 {
    counter.calls = counter.calls + 1u32;
    F64::from_i32(value)
}

public machine main(application: &mut Main) reaches Console
invokes Console
blocks
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> observe(application, value)
        _ -> bad(application)
    }
    machine observe(application: &mut Main, value: i32) {
        let observed: f64 = min_f64(step(&mut application.counter, value), step(&mut application.counter, value));
        let converted: i32 in Saturating = I32::from_f64(observed);
        transition converted == 65 && application.counter.calls == 2u32 {
            true -> done(application)
            false -> bad(application)
        }
    }
    machine done(application: &mut Main) {
        Console::write_line("minimum=65 calls=2");
        Console::exit_process(0);
    }
    machine bad(application: &mut Main) { Console::exit_process(3); }
}

// The hosted entry takes no arrival parameters; it owns the program's
// storage and passes it to `main` explicitly.
public machine entry_start() reaches Console
invokes Console
blocks
crashes Trap
{
    let mut entry_storage: Main = Main { counter: Counter { calls: 0 } };
    block main(&mut entry_storage);
}
