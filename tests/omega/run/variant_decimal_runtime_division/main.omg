use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let input: ByteRead = block Console::read_byte();
    transition input {
        ByteRead::Byte { value } -> format(main, value as u64 in Wrapping)
        ByteRead::Eof -> finish(main)
    }
    machine format(main: &mut Main, value: u64 in Wrapping) {
        number(value);
        transition { _ -> finish(main) }
    }
    machine finish(main: &mut Main) { Console::exit_process(0); }
}
public machine number(value: u64 in Wrapping) reaches Console
invokes Console;
{
    transition { _ -> digit(value, 10000000000000000000, false) }
    machine digit(value: u64 in Wrapping, divisor: u64 in Wrapping, started: bool) {
        transition divisor > 0 {
            true -> calculate(value, divisor, started)
            _ -> stop()
        }
    }
    machine calculate(value: u64 in Wrapping, divisor: u64 in Wrapping, started: bool) {
        let current: u64 in Wrapping = value / divisor;
        transition current > 0 || started || divisor == 1 {
            true -> write(value, divisor, current)
            _ -> next(value, divisor, false)
        }
    }
    machine write(value: u64 in Wrapping, divisor: u64 in Wrapping, current: u64 in Wrapping) {
        transition current < 10 {
            true -> write_digit(value, divisor, current)
            _ -> stop()
        }
    }
    machine write_digit(value: u64 in Wrapping, divisor: u64 in Wrapping, current: u64 in Wrapping) {
        let byte: u64 in Wrapping = current + 48;
        Console::write_byte(narrow_u64_to_i32_exact(byte as u64));
        transition { _ -> next(value % divisor, divisor, true) }
    }
    machine next(value: u64 in Wrapping, divisor: u64 in Wrapping, started: bool) {
        transition divisor > 1 {
            true -> digit(value, divisor / 10, started)
            _ -> stop()
        }
    }
    machine stop() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
