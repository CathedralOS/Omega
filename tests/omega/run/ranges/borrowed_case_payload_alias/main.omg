// Expected exit: 0.
// A selected payload retains the default-domain bound of the borrowed input.
data Text
    requires (self in Text::Empty)
        || ((self in Text::Present) && self.length <= 4u64)
{
    case Empty;
    case Present(bytes: [u8; 4], length: u64);
}
machine length(text: &mut Text) -> u64 {
    let alias: &mut Text = text;
    transition alias {
        Text::Present { bytes, length } -> read(&bytes[0..length])
        Text::Empty -> 0u64
    }
    machine read(bytes: &[u8]) -> u64 { bytes.len }
}
machine main() crashes Trap {
    let bytes: [u8; 4];
    let mut text: Text = Text::Present { bytes: bytes, length: 3u64 };
    transition length(&mut text) == 3u64 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
