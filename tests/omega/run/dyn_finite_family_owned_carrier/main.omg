// An owned linear carrier moves once through a finite-family dispatch:
// `scan` constructs a `Packet`, moves it once into the family's `Width`
// binder call, and the selected implementation consumes the token exactly
// once (moving it twice or leaking it would not check); the scalar result
// flows back through the dispatch merge. Rebinding the selector changes
// the provider as in the scalar fixture:
//   scan(Primary, 16) stores 16 * 100      == 1600
//   scan(Bumped,  32) stores 32 * 100 + 1  == 3201
use omega_language_std::console;
use omega::language::core::drop;

data Token [linear] { value: u64 in Wrapping; }
machine Token::drop(token: &mut Token) {}
domain Token::Issued;
data Packet { token: Token in Token::Issued; marker: u64; }

machine issue(value: u64 in Wrapping) -> Token in Token::Issued {
    let token: Token in Token::Issued = Token { value: value };
    token
}

trait Shape<T> {
    machine code<Width: u32>(subject: &mut T, packet: Packet) where Width == 16 || Width == 32 || Width == 64;
    machine poke(subject: &mut T, packet: Packet);
}

data Item {
    value: u64 in Wrapping;
    marker: u64;
}

machine Item::code<Width: u32>(item: &mut Item, packet: Packet) satisfies Shape<Item>::code {
    let w: u64 in Wrapping = Width as u64 in Wrapping;
    item.marker = (w * 100) as u64;
    drop(packet.token);
}

machine Item::lifted_code<Width: u32>(item: &mut Item, packet: Packet) satisfies Shape<Item>::code {
    let w: u64 in Wrapping = Width as u64 in Wrapping;
    item.marker = (w * 100 + 1) as u64;
    drop(packet.token);
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
    Shape::poke = Item::poke;
}

Bumped satisfies Shape<Item> {
    Shape::code = Item::lifted_code;
    Shape::poke = Item::poke;
}

machine Item::poke(item: &mut Item, packet: Packet) satisfies Shape<Item>::poke {
    item.marker = 5;
    drop(packet.token);
}

machine scan(selected: dyn Shape<Item>, item: &mut Item, seed: u64 in Wrapping, w: u32) -> u64
requires
    w == 16 || w == 32 || w == 64;
{
    let packet: Packet = Packet { token: issue(seed), marker: 0 };
    Item::poke(item, packet);
    let packet2: Packet = Packet { token: issue(seed), marker: 0 };
    Shape::code<w>(selected, item, packet2);
    transition {
        _ -> item.marker
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.item.value = 0;
    let mut selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let first: u64 = scan(selected, &mut main.item, 7, 16);
    selected = Bumped as dyn Shape<Item>;
    let second: u64 = scan(selected, &mut main.item, 9, 32);
    transition first == 1600 && second == 3201 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
