// Shared `&` borrows of parameter-rooted places: `&self.size`,
// `&self.buf[0]` literal index. Reading each referent in the
// transition guard reads through the admitted loans.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    size: u32;
    buf: [u8; 48];
}

machine Main::main(&mut self) reaches Console {
    self.size = 5;
    let len: &u32 = &self.size;
    let first: &u8 = &self.buf[0];
    transition len == self.size { true -> done() _ -> bad() }

    state done(&mut self) {
        self.console.exit_process(0);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
