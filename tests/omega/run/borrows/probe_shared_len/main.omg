// Shared `&` borrows of parameter-rooted places: `&main.size`,
// `&main.buf[0]` literal index. Reading each referent in the
// transition guard reads through the admitted loans.
use omega_language_std::console;

data Main {
    size: u32;
    buf: [u8; 48];
}

machine Main::main(main: &mut Main) reaches Console {
    main.size = 5;
    let len: &u32 = &main.size;
    let first: &u8 = &main.buf[0];
    transition len == main.size { true -> done(main) _ -> bad(main) }

    machine done(main: &mut Main) {
        Console::exit_process(0);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
