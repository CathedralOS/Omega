machine build(builder: &mut Build) {
    Build::application(builder, "conditional_disjoint_field_loans_exit");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, macos_arm64::ProgramEntry, split_guard::Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, split_guard::Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, split_guard::Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, split_guard::Main::main);
}
