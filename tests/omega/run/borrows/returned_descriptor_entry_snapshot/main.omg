// Expected exit: 0
// A returned descriptor saved before replacement retains its entry occurrence.
data Cell [copy] { value: u64; }
data Slot<'input> { target: &'input Cell; }
data Saved<'input> { target: &'input Cell; }

machine direct<'input>(slot: &mut Slot<'input>, replacement: &'input Cell) -> &'input Cell {
    let saved: &'input Cell = slot.target;
    slot.target = replacement;
    saved
}

machine aggregate<'input>(slot: &mut Slot<'input>, replacement: &'input Cell) -> Saved<'input> {
    let saved: &'input Cell = slot.target;
    slot.target = replacement;
    Saved { target: saved }
}

machine number(value: &Cell) -> u64 { value.value }

machine main() crashes Trap {
    let left: Cell = Cell { value: 11 };
    let right: Cell = Cell { value: 22 };
    let mut first: Slot = Slot { target: &left };
    let original: &Cell = direct(&mut first, &right);
    let old_direct: u64 = number(original);
    let new_direct: u64 = number(first.target);
    let mut second: Slot = Slot { target: &right };
    let copied: Saved = aggregate(&mut second, &left);
    let old_aggregate: u64 = number(copied.target);
    let new_aggregate: u64 = number(second.target);
    transition old_direct == 11 && new_direct == 22 && old_aggregate == 22 && new_aggregate == 11 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
