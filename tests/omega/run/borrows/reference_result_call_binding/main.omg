// A reference returned by a static machine remains a reference when bound to
// a local. Its referent must survive the call and retain its source identity;
// copying a scalar result is not a substitute for this behavior.
use omega_language_std::console;

data Main {
    count: u32;
}

machine Main::borrow_count(main: &Main) -> &u32 {
    transition { _ -> out(main) }
    state out(main: &Main) -> &u32 { &main.count }
}

machine Main::main(main: &mut Main) reaches Console {
    main.count = 3;
    let borrowed: &u32 = Main::borrow_count(main);
    Console::exit_process(0);
}
