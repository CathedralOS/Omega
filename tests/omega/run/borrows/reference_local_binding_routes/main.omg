// A shared reference bound to a local must retain the exact projected source.
// Reduced from samples/cli/systems/descriptor_walk. Other reference producers
// use the same local-binding semantics rather than receiver-specific routes.
use omega_language_std::console;

data Main {
    size: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &u32 = &main.size;
    transition { _ -> done(main) }

    machine done(main: &mut Main) {
        Console::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
