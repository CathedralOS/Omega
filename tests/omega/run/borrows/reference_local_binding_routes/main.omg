// A shared reference bound to a local must retain the exact projected source.
// Reduced from samples/cli/systems/descriptor_walk. Other reference producers
// use the same local-binding semantics rather than receiver-specific routes.
use omega_language_std::console;

data Main {
    size: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &u32 = &main.size;
    transition { _ -> done(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}
