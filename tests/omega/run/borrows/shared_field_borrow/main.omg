// Shared `&` borrows of parameter-rooted places: `&main.size`,
// `&main.buf` `&main.buf[0]` literal index. These were the
// narrow routing family the shared arm already admitted on paper, but a
// `&` local registers a structural value root and died at the
// structural-value block's root-identity gate before reaching the loan
// arm — the reorder that runs the loan arms first is what admits them.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    size: u32;
    buf: [u8; 48];
}

machine Main::main(main: &mut Main) reaches Console {
    let len: &u32 = &main.size;
    let first: &u8 = &main.buf[0];
    transition { _ -> done(main) }

    state done(main: &mut Main) {
        main.console.exit_process(0);
    }
}
