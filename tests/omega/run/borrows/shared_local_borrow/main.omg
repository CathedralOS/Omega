// Shared `&` borrow of a plain LOCAL — the shared counterpart of
// `local_mut_borrow`. The shared place-loan arm admits the same three
// shapes the exclusive arm does: a place rooted at a structural
// parameter or at an earlier local of this state. Reading `borrowed`
// in the transition guard reads through the admitted loan.
use omega_language_std::console;

data Main {
    size: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    let v: u32 = 7;
    let borrowed: &u32 = &v;
    transition borrowed == 7 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
