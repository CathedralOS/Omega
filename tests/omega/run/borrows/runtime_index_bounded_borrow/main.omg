// PENDING pin — REFERENCE-LOCAL-BINDING-ROUTES residual (2026-09-29 f4b3db3):
// omits at 'statement sequence: local data: structural call binding'.
// Bounded runtime-index `&mut` — index proof discharges, then same wall.
use omega_language_std::console;

data Main {
    buf: [u8; 48];
    off: u32 [0..=47];
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &mut u8 = &mut main.buf[main.off];
    transition { _ -> done(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}
