// Shared `&` returned at a transition tail: `first` borrows
// `&main.buf[0]` through its transition's exit arm, and `main` reads the
// referent back after the call.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
}

machine Main::first(main: &Main) -> &u8 {
    transition {
        _ -> &main.buf[0]
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[0] = 7;
    _ = Main::first(main);
    transition main.buf[0] == 7 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        main.console.exit_process(0);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(1);
    }
}
