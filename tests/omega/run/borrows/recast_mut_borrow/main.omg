// PENDING pin — REFERENCE-LOCAL-BINDING-ROUTES residual (2026-09-29 f4b3db3):
// omits at 'statement sequence: local data: structural call binding'.
// Recast `as &mut T` of an element — same wall.
use omega_language_std::console;
use omega::language::core::binding;

data Desc {
    tag: u32;
}

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
}

machine Main::main(&mut self) reaches Console {
    let borrowed: &mut Desc = &mut self.buf[0] as &mut Desc;
    transition { _ -> done() }

    state done(&mut self) {
        self.console.exit_process(0);
    }
}
