// PENDING pin — REFERENCE-LOCAL-BINDING-ROUTES residual (2026-09-29 f4b3db3):
// omits at 'statement sequence: local data: structural call binding'.
// Recast `as &mut T` of an element — same wall.
use omega_language_std::console;

data Desc {
    tag: u32;
}

data Main {
    buf: [u8; 48];
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &mut Desc = &mut main.buf[0] as &mut Desc;
    transition { _ -> done(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}
