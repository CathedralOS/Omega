// Whole-element store through an indexed admitted loan.
// `borrowed` captures `main.buf[main.off]` — the canonical place ends in a
// stored-field runtime index, and the store's primitive projection must
// evaluate the field selector and bound it against the array's extent.
use omega_language_std::console;

data Main where off <= 47 {
    buf: [u8; 48];
    off: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.off = 3;
    let borrowed: &mut u8 = &mut main.buf[main.off];
    borrowed = 9;
    transition main.buf[3] == 9 { true -> done(main) _ -> bad(main) }

    machine done(main: &mut Main) {
        Console::exit_process(0);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
