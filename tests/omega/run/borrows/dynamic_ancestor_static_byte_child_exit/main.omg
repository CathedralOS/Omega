// Expected exit: 42
// A runtime index and a fixed index both loan one record from a local array.
// The record's byte field is ordinary storage. Reading one byte through that
// field, a parameter, and the call result must observe the bytes written into
// the local: 20 on the dynamic arm and 22 on the fixed arm.
use omega_language_std::console;

data Cell { bytes: [u8; 4]; }

machine select(rows: &[Cell; 2], index: u64, dynamic: bool) -> u64 in Wrapping {
    transition index < 2 {
        true -> choose(rows, index, dynamic)
        _ -> (0)
    }
    machine choose(rows: &[Cell; 2], index: u64, dynamic: bool) -> u64 in Wrapping {
        transition dynamic {
            true -> cell(&rows[index])
            _ -> cell(&rows[1])
        }
    }
    machine cell(value: &Cell) -> u64 in Wrapping {
        transition { _ -> bytes(&value.bytes, 1) }
    }
    machine bytes(value: &[u8; 4], index: u64) -> u64 in Wrapping {
        transition index < 4 {
            true -> scalar(&value[index])
            _ -> (0)
        }
    }
    machine scalar(value: &u8) -> u64 in Wrapping { value as u64 in Wrapping }
}

machine calculate() -> u64 in Wrapping {
    let mut rows: [Cell; 2];
    rows[0].bytes[1] = 20;
    rows[1].bytes[1] = 22;
    let first: u64 in Wrapping = select(&rows, 0, true);
    let second: u64 in Wrapping = select(&rows, 0, false);
    (first + second)
}

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let result: u64 in Wrapping = calculate();
    transition result == 42 {
        true -> exit(main, 42)
        _ -> exit(main, 43)
    }
    machine exit(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
