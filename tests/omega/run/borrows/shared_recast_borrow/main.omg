// Shared `&` borrow of a recast place — the shared counterpart of
// `recast_mut_borrow`. `&p as &T` lowers to a shared borrow of the cast
// node; the arm peels the RecastShared cast to its operand place and
// skips referent equality (the §5b judgment already proved the shapes
// compatible).
use omega_language_std::console;

data Desc {
    tag: u32;
}

data Main {
    buf: [u8; 48];
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &Desc = &main.buf[0] as &Desc;
    transition { _ -> done(main) }

    machine done(main: &mut Main) {
        Console::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
