// Expected exit: 0
// A false outgoing guard still installs its completed descriptor replacement before the next arm.
use omega_language_std::console;
data Cell [copy] { case Held(value: u64 in Wrapping); case Empty; }
data Pair<'source> [copy] { target: &'source Cell; }
data Choice<'source> { case Some(payload: Pair<'source>); }
data Buffer<'source> { values: [Choice<'source>; 2]; }
machine replace<'source>(buffer: &mut Buffer<'source>, next: &'source Cell) -> bool {
    buffer.values[0] = Choice::Some { payload: Pair { target: next } };
    true
}
machine has_value(cell: &Cell, expected: u64 in Wrapping) -> bool
requires cell in Cell::Held {
    cell.value == expected
}
machine main() reaches Console {
    let original_cell: Cell = Cell::Held { value: 11 };
    let next_cell: Cell = Cell::Held { value: 73 };
    let mut buffer: Buffer = Buffer { values: [
        Choice::Some { payload: Pair { target: &original_cell } },
        Choice::Some { payload: Pair { target: &original_cell } }
    ] };
    transition { !replace(&mut buffer, &next_cell) -> wrong()
        _ -> checked(true, (buffer.values[0] in Choice::Some)
                && (buffer.values[0].payload.target in Cell::Held)
                && has_value(buffer.values[0].payload.target, 73)) }
    machine checked(replaced: bool, observed: bool) {
        transition replaced && observed { true -> done() _ -> wrong() }
    }
    machine done() { Console::exit_process(0); }
    machine wrong() { Console::exit_process(81); }
}
