// A `&`-record loan local mints no established place: the member read
// `plain.tag` resolves the structural parameter the loan captured plus the
// canonical `desc` prefix below it, so the referee record's leaf verifies.
use omega_language_std::console;

data Desc {
    tag: u32;
}

data Main {
    buf: [u8; 48];
    desc: Desc;
}

machine Main::main(main: &mut Main) reaches Console {
    let plain: &Desc = &main.desc;
    transition plain.tag == main.buf[0] as u32 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
