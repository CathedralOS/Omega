// Expected exit: 0
// A copied reference payload crosses its descriptor before a state borrows
// the referent. The original owner stays live through the observation.
use omega::language::core::option;
data Cell [copy] { value: u64; }
machine select(cell: &Cell) -> Optional<&Cell> {
    Optional::Some { value: cell }
}
machine observe(cell: &Cell) -> u64 {
    let selected: Optional<&Cell> = select(cell);
    transition selected {
        Optional::Some { value } -> read(value)
        Optional::None -> 0
    }
    machine read(value: &Cell) -> u64 { value.value }
}
machine main() crashes Trap {
    let cell: Cell = Cell { value: 41 };
    let observed: u64 = observe(&cell);
    transition observed == 41 && cell.value == 41 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
