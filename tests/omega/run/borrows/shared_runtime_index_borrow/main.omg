// Shared `&` borrow of a runtime-indexed element — the shared
// counterpart of `runtime_index_bounded_borrow`. The bounded selector
// discharges the index proof upstream; the loan arm retains the
// `RuntimeIndex` segment for the terminal's bound re-proof. Reading
// `borrowed` in the guard reads through the admitted loan.
use omega_language_std::console;

data Main {
    buf: [u8; 48];
    off: u32 [0..=47];
}

machine Main::main(main: &mut Main) reaches Console {
    main.buf[0] = 3;
    main.off = 0;
    let borrowed: &u8 = &main.buf[main.off];
    transition borrowed == main.buf[main.off] { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }

    state bad(main: &mut Main) {
        Console::exit_process(1);
    }
}
