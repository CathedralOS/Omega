// Shared `&` borrow of a runtime-indexed element — the shared
// counterpart of `runtime_index_bounded_borrow`. The bounded selector
// discharges the index proof upstream; the loan arm retains the
// `RuntimeIndex` segment for the terminal's bound re-proof. Reading
// `borrowed` in the guard reads through the admitted loan.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
    off: u32 [0..=47];
}

machine Main::main(&mut self) reaches Console {
    self.buf[0] = 3;
    self.off = 0;
    let borrowed: &u8 = &self.buf[self.off];
    transition borrowed == self.buf[self.off] { true -> done(&mut self) _ -> bad(&mut self) }

    state done(main: &mut Main) {
        main.console.exit_process(0);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(1);
    }
}
