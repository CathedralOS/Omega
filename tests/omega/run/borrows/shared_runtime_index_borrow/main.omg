// Shared `&` borrow of a runtime-indexed element — the shared
// counterpart of `runtime_index_bounded_borrow`. The bounded selector
// discharges the index proof upstream; the loan arm retains the
// `RuntimeIndex` segment for the terminal's bound re-proof.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
    off: u32 [0..=47];
}

machine Main::main(&mut self) reaches Console {
    let borrowed: &u8 = &self.buf[self.off];
    transition { _ -> done() }

    state done(&mut self) {
        self.console.exit_process(0);
    }
}
