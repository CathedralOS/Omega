machine build(builder: &mut Build) {
    Build::application(builder, "independent_invocation_reference_results");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Replies, Code>(builder, windows_x86_64);
    Build::select_provider<Replies, Code>(builder, linux_x86_64);
    Build::select_provider<Replies, Code>(builder, macos_arm64);
    Build::select_provider<Replies, Code>(builder, linux_arm64);
}
