// An ordinary mutable reference to a local scalar writes the local storage.
// Keeping a transition after the write exercises custody through state control.
// Expected exit: 9, not the stale initializer 7.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(main: &mut Main) reaches Console {
    let mut v: u32 = 7;
    let borrowed: &mut u32 = &mut v;
    borrowed = 9;
    transition v == 9 { true -> done(main) _ -> bad(main) }

    state done(main: &mut Main) {
        main.console.exit_process(9);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(1);
    }
}
