// Expected exit: 0
data Row { value: i32; }
data Grid { rows: [Row; 2]; }
data Label { bytes: [u8; 3]; }
machine label_bytes(label: &Label) -> &[u8] { &label.bytes[..] }
machine set_row(grid: &mut Grid, index: u64, value: i32) requires index < 2u64 {
    grid.rows[index].value = value;
}
machine main() crashes Trap {
    let mut grid: Grid = Grid { rows: [Row { value: 3 }, Row { value: 5 }] };
    set_row(&mut grid, 1, 9);
    let label: Label = Label { bytes: "Arc" };
    let text: &[u8] = label_bytes(&label);
    transition text.len == 3u64 && grid.rows[0].value == 3 && grid.rows[1].value == 9 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
