// Probe: is a direct runtime-indexed write on a plain u8 fixed-array
// field admitted at all? `[i32;4]` writes plan WriteOnlyPrimitiveStore;
// if `[u8;N]` writes omit, the indexed-write wall predates loan aliases.
use omega_language_std::console;

data Main {
    buf: [u8; 48];
    off: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    main.off = 0;
    main.buf[main.off] = 9;
    transition main.buf[main.off] == 9 { true -> done(main) _ -> bad(main) }

    machine done(main: &mut Main) {
        Console::exit_process(9);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(1);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
