// Expected exit: 0. Every construct here is inside route one's scalar subset,
// including crash routes and a guarantee over `result`, so structure-only
// elaboration lowers this program and the Terminal interpreter runs it.
// `halved` promises its result is at most its input; `main` publishes a
// `Trap` route that its nested `wrong` takes when the halving is not 42.
// Here it is 42, so the normal arm runs. Its twin
// `scalar_crash_route_trap` differs only in the input and takes the crash.
machine halved(value: u32) -> u32 requires value <= 1000 ensures result <= value {
    value / 2
}
machine main() crashes Trap {
    let half: u32 = halved(84);
    transition half == 42 {
        true -> done()
        false -> wrong()
    }
    machine done() { }
    machine wrong() { crash Trap; }
}
