machine build(builder: &mut Build) {
    Build::application(builder, "target_family_forwarded_result");
    Build::select_provider<Values, ForwardedValues>(builder, linux_arm64);
    Build::select_provider<Values, ForwardedValues>(builder, linux_x86_64);
    Build::select_provider<Values, ForwardedValues>(builder, macos_arm64);
    Build::select_provider<Values, ForwardedValues>(builder, macos_x86_64);
    Build::select_provider<Values, ForwardedValues>(builder, windows_x86_64);
    Build::select_provider<Values, ForwardedValues>(builder, uefi_x86_64);
    Build::select_provider<Values, ForwardedValues>(builder, cross_platform_cli);
    Build::select_provider<Values, ForwardedValues>(builder, local_unchecked);
    Build::select_provider<Values, ForwardedValues>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
