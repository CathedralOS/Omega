// The first scalar operand is a snapshot. A later ignored result does not
// make that snapshot equal to the caller's subsequently overwritten binding.
machine overwrite(value: &mut u64) -> u64 { value = 9; 0 }
machine bounded(count: u64, ignored: u64) -> u64 requires count <= 8 { count }
machine main() crashes Trap {
    let mut count: u64 = 2;
    let observed: u64 = bounded(count, overwrite(&mut count));
    transition observed == 2 && count == 9 {
        true -> done()
        false -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
