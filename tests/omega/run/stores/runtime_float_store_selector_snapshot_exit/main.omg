module float_store_snapshot;
use omega_language_std::console;
use omega::language::core::float_operations;

pub data Main { values: [f64; 2]; index: i32 in Wrapping; }

machine produced(index: &mut i32 in Wrapping, value: i32) -> f64 {
    index = 0;
    F64::from_i32(value)
}

pub machine Main::main(application: &mut Main) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> guard(application, value, 1)
        _ -> bad(application)
    }
    state guard(application: &mut Main, value: i32, index: i32 in Wrapping) {
        transition index >= 0 && index < 2 {
            true -> store(application, value, index)
            false -> bad(application)
        }
    }
    state store(application: &mut Main, value: i32, index: i32 in Wrapping) {
        application.index = index;
        application.values[application.index] = produced(&mut application.index, value);
        let stored: i32 in Saturating = I32::from_f64(application.values[1]);
        let untouched: i32 in Saturating = I32::from_f64(application.values[0]);
        transition stored == 65 && untouched == 0 && application.index == 0 {
            true -> done(application) false -> bad(application)
        }
    }
    state done(application: &mut Main) {
        Console::write_line("selected index=1 value=65 next index=0");
        Console::exit_process(0);
    }
    state bad(application: &mut Main) { Console::exit_process(3); }
}
