module indexed_float_store;
use omega_language_std::console;
use omega::language::core::binding;
use omega::language::core::float_operations;

pub data Main { console: Binding<Console>; values: [f64; 2]; }

pub machine Main::main(application: &mut Main) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition block application.console.read_byte() {
        ByteRead::Byte { value } -> guard(application, value, 1)
        _ -> bad(application)
    }
    state guard(application: &mut Main, value: i32, index: i32 in Wrapping) {
        transition index >= 0 && index < 2 {
            true -> store(application, value, index)
            false -> bad(application)
        }
    }
    state store(application: &mut Main, value: i32, index: i32 in Wrapping) {
        application.values[index] = F64::from_i32(value);
        application.values[index] = application.values[index] + 1.0;
        let observed: i32 in Saturating = I32::from_f64(application.values[index]);
        transition observed == 66 { true -> done(application) false -> bad(application) }
    }
    state done(application: &mut Main) {
        application.console.write_line("indexed value=66");
        application.console.exit_process(0);
    }
    state bad(application: &mut Main) { application.console.exit_process(3); }
}
