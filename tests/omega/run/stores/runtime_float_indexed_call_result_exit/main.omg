module indexed_float_store;
use omega_language_std::ByteRead;
use omega_language_std::Console;
use omega::language::core::F64::from_i32;
use omega::language::core::I32::from_f64;

public data Main { values: [f64; 2]; }

public machine main(application: &mut Main) reaches Console
invokes Console
blocks
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> guard(application, value, 1)
        _ -> bad(application)
    }
    machine guard(application: &mut Main, value: i32, index: i32 in Wrapping) {
        transition index >= 0 && index < 2 {
            true -> store(application, value, index)
            false -> bad(application)
        }
    }
    machine store(application: &mut Main, value: i32, index: i32 in Wrapping) {
        application.values[index] = F64::from_i32(value);
        application.values[index] = application.values[index] + 1.0;
        let observed: i32 in Saturating = I32::from_f64(application.values[index]);
        transition observed == 66 { true -> done(application) false -> bad(application) }
    }
    machine done(application: &mut Main) {
        Console::write_line("indexed value=66");
        Console::exit_process(0);
    }
    machine bad(application: &mut Main) { Console::exit_process(3); }
}

// The hosted entry takes no arrival parameters; it owns the program's
// storage and passes it to `main` explicitly.
public machine entry_start() reaches Console
invokes Console
blocks
crashes Trap
{
    let mut entry_storage: Main;
    block main(&mut entry_storage);
}
