domain [u8]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
}

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Main {
    console: Console;
    choice: Command;
    health: i32;
}

machine Main::main(&mut self) {
    self.health = 10;

    transition self.health == 0 {
        true -> dead()
        false -> choose()
    }
    

    state choose(&mut self) {
        self.choice = Command::Invalid;

        transition self.choice {
            Command::Look -> look()
            Command::Quit -> quit()
            Command::Invalid -> invalid()
        }
    }

    state dead(&mut self) {
        self.console.write_line("dead");
    }

    state look(&mut self) {
        self.console.write_line("look");
    }

    state quit(&mut self) {
        self.console.write_line("quit");
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
    }
}