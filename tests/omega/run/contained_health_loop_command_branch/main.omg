use omega::language::core::service;
// #66: a contained command-loop with a health gate, over an owned
// `[u8; N] in LineUtf8` carrier (no `String`). Each iteration checks health, then
// reads a line into the carrier, borrows it as a `&[u8] in LineUtf8` view, resolves a
// Command enum directly, and loops until `quit`.
pub domain [u8]::LineUtf8
requires
    valid_utf8(self);
pub domain [u8; 16]::LineUtf8
requires
    valid_utf8(self);
pub boundary trait Console {
    machine write_line(text: &[u8] in LineUtf8);
    machine read_line(out_line: &mut [u8; 16] in LineUtf8);
    machine exit_process(return_code: i32);
}

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Parser {
}

machine Parser::resolve(&mut self, line: &[u8] in LineUtf8) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

data Game {
    console: Service<Console>;
    line: [u8; 16] in LineUtf8;
    parser: Parser;
    command: Command;
    health: i32;
}

machine Game::run(&mut self) reaches Console {
    self.health = 10;
    transition { _ -> prompt() }


    state prompt(&mut self) {
        transition self.health == 0 {
            true -> dead()
            false -> read_command()
        }
    }

    state read_command(&mut self) {
        self.console.read_line(&mut self.line);
        self.command = self.parser.resolve(&self.line);

        transition self.command {
            Command::Look -> look()
            Command::Quit -> finished()
            Command::Invalid -> invalid()
        }
    }

    state dead(&mut self) {
        self.console.write_line("dead");
        self.console.exit_process(2);
    }

    state look(&mut self) {
        self.console.write_line("look");
        transition { _ -> prompt() }
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
        transition { _ -> prompt() }
    }

    state finished(&mut self) {
    }
}

data Main {
    game: Game;
}

machine Main::main(&mut self) -> i32 {
    transition { _ -> running() }


    state running(&mut self) {
        self.game.run();
        transition { _ -> shutdown() }
    }

    state shutdown(&mut self) {
        0
    }
}
