// Expected exit: 0. Expected output contains: look
// #66: a contained command-loop with a health gate, over an owned
// explicit storage-and-length owner. Each iteration checks health, then
// reads a line into the carrier, borrows it as a `&[u8] in LineUtf8` view, resolves a
// Command enum directly, and loops until `quit`.
pub domain [u8]::LineUtf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

machine read_command_line() -> LineBuffer
reaches Console
blocks;
crashes Trap
{
    let mut buffer: [u8; 16] = "                ";
    let result: LineReadResult = block Console::read_line(&mut buffer);
    transition result {
        LineReadResult::LineComplete { count } -> completed(&buffer, count)
        LineReadResult::EndOfInput { count } -> completed(&buffer, count)
        _ -> invalid()
    }
    state completed(buffer: &[u8; 16], count: u64) -> LineBuffer {
        transition count > 0 && count <= 16 {
            true -> trim(buffer, count)
            _ -> LineBuffer::snapshot("quit")
        }
    }
    state trim(buffer: &[u8; 16], count: u64) -> LineBuffer
    requires count > 0 && count <= 16
    {
        transition buffer[count - 1] == 10 {
            true -> validate(buffer, count - 1)
            _ -> validate(buffer, count)
        }
    }
    state validate(buffer: &[u8; 16], count: u64) -> LineBuffer
    requires count <= 16
    {
        let prefix: &[u8] = &buffer[0..count];
        transition valid_utf8(prefix) && prefix.len <= 16 {
            true -> snapshot(prefix)
            _ -> invalid()
        }
    }
    state snapshot(prefix: &[u8] in LineUtf8) -> LineBuffer
    requires prefix.len <= 16
    {
        LineBuffer::snapshot(prefix)
    }
    state invalid() -> LineBuffer { crash Trap; }
}


data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Parser {
}

machine resolve(line: &[u8] in LineUtf8) -> Command {
    transition {
        line == "look" -> Command::Look
        line == "quit" -> Command::Quit
        _ -> Command::Invalid
    }
}

data Game {
    line: LineBuffer;
    parser: Parser;
    command: Command;
    health: i32;
}

machine Game::run(game: &mut Game) reaches Console
blocks;
crashes Trap
{
    game.health = 10;
    transition { _ -> prompt(game) }


    state prompt(game: &mut Game) {
        transition game.health == 0 {
            true -> dead(game)
            false -> read_command(game)
        }
    }

    state read_command(game: &mut Game) {
        game.line = block read_command_line();
        let line: &[u8] in LineUtf8 = LineBuffer::view(&game.line);
        game.command = resolve(line);

        transition game.command {
            Command::Look -> look(game)
            Command::Quit -> finished()
            Command::Invalid -> invalid(game)
        }
    }

    state dead(game: &mut Game) {
        Console::write_line("dead");
        Console::exit_process(2);
    }

    state look(game: &mut Game) {
        Console::write_line("look");
        transition { _ -> prompt(game) }
    }

    state invalid(game: &mut Game) {
        Console::write_line("invalid");
        transition { _ -> prompt(game) }
    }

    state finished() {
    }
}

data Main {
    game: Game;
}

machine Main::main(main: &mut Main) reaches Console
blocks;
crashes Trap
{
    transition { _ -> running(main) }


    state running(main: &mut Main) {
        block Game::run(&mut main.game);
        transition { _ -> shutdown() }
    }

    state shutdown() {
        Console::exit_process(0);
    }
}

// Explicit fixed capacity and live-prefix length; qualification belongs to the checked view.
data LineBuffer [copy] where used <= 16 { storage: [u8; 16]; used: u64; }
machine LineBuffer::view(buffer: &LineBuffer) -> &[u8] in LineUtf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in LineUtf8) -> &[u8] in LineUtf8 { bytes }
    state bad() { crash Trap; }
}
machine LineBuffer::equal(buffer: &LineBuffer, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in LineUtf8 = LineBuffer::view(buffer);
    bytes == expected
}

machine LineBuffer::copy(storage: &mut [u8; 16], bytes: &[u8], start: u64)
requires start <= 16; bytes.len <= 16 - start {
    transition { _ -> copying(storage, bytes, start, 0) }
    state copying(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index <= 16 {
        transition index < bytes.len && start + index < 16 {
            true -> writing(storage, bytes, start, index)
            _ -> done()
        }
    }
    state writing(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index < 16; index < bytes.len; start + index < 16 {
        storage[start + index] = bytes[index];
        transition { _ -> copying(storage, bytes, start, index + 1) }
    }
    state done() {}
}
machine LineBuffer::join(left: &[u8], right: &[u8]) -> LineBuffer crashes Trap {
    transition left.len <= 16 && right.len <= 16 - left.len {
        true -> joining(left, right)
        _ -> bad()
    }
    state joining(left: &[u8], right: &[u8]) -> LineBuffer
    requires left.len <= 16; right.len <= 16 - left.len {
    let mut result: LineBuffer;
    LineBuffer::copy(&mut result.storage, left, 0);
    LineBuffer::copy(&mut result.storage, right, left.len);
    let total: u64 = left.len + right.len;
    transition total <= 16 {
        true -> checked(result, total)
        _ -> bad()
    }
    }
    state checked(result: LineBuffer, total: u64) -> LineBuffer
    requires total <= 16 {
        let mut value: LineBuffer = result;
        value.used = total;
        value
    }
    state bad() { crash Trap; }
}

machine LineBuffer::snapshot(text: &[u8] in LineUtf8) -> LineBuffer
crashes Trap
requires text.len <= 16 { LineBuffer::join("", text) }
