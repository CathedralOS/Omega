// Expected exit: 0. A loop is a machine whose transition arm calls it again.
// `halve` and `step` call each other in terminal position and promise no
// termination, so the cycle owes no ranking: it lowers to blocks with a jump
// back and runs without growing the stack. `step` requires `count > 1` on
// every arrival, and the arm's guard in `halve` proves it each time round.
// From 40 the count goes 40, 20, 10, 5, 2, 1, and the loop returns the last
// count above one, 2; `main` takes the crash arm on anything else. Its twin
// `fail/termination/productive_scalar_loop_arrival_unproved` differs only in
// which value the guard tests.
machine halve(count: u32, last: u32) -> u32 {
    transition count > 1 {
        true -> step(count, last)
        false -> last
    }
}
machine step(count: u32, last: u32) -> u32 requires count > 1 {
    transition {
        _ -> halve(count / 2, count)
    }
}
machine main() crashes Trap {
    let last: u32 = halve(40, 0);
    transition last == 2 {
        true -> done()
        false -> wrong()
    }
    machine done() { }
    machine wrong() { crash Trap; }
}
