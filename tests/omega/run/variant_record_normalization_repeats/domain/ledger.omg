use domain::normalization;
use domain::sequence;
// First-seen canonical ordering is stable. Equal rows merge provenance masks.
// Different rows conflict when their closed reference intervals intersect.
// This deliberately conservative synthetic conflict model includes insertions
// at deletion endpoints; no diploidy or biological pathogenicity is inferred.
public data Ledger {
    variants: [Variant; 32];
    count: u64 in Wrapping;
    conflicts: u64 in Wrapping;
    merged: u64 in Wrapping;
}
public machine source_mask(source: u64 in Wrapping) -> u64 in Wrapping {
    transition { _ -> double(source, 0, 1) }
    machine double(source: u64 in Wrapping, index: u64 in Wrapping, value: u64 in Wrapping) -> u64 in Wrapping {
        transition index < source && index < 8 {
            true -> double(source, index + 1, value * 2)
            _ -> value
        }
    }
}
public machine Ledger::add(ledger: &mut Ledger, variant: &Variant) -> u64 in Wrapping {
    transition { _ -> search(ledger, variant, 0) }
    machine search(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        transition index < ledger.count && index < 32 {
            true -> compare(ledger, variant, index)
            _ -> capacity(ledger, variant)
        }
    }
    machine compare(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        let previous: Variant = ledger.variants[index];
        let same: bool = Sequence::equal(&previous.inserted, &variant.inserted);
        transition previous.contig == variant.contig && previous.position == variant.position
            && previous.removed == variant.removed && same {
            true -> merge(ledger, variant, index)
            _ -> search(ledger, variant, index + 1)
        }
    }
    machine merge(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        let previous: Variant = ledger.variants[index];
        let mut combined: Variant = previous;
        combined.provenance = previous.provenance | variant.provenance;
        ledger.variants[index] = combined;
        ledger.merged = ledger.merged + 1;
        (1)
    }
    machine capacity(ledger: &mut Ledger, variant: &Variant) -> u64 in Wrapping {
        transition ledger.count < 32 {
            true -> conflicts(ledger, variant, 0)
            _ -> 2
        }
    }
    machine conflicts(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        transition index < ledger.count && index < 32 {
            true -> overlap(ledger, variant, index)
            _ -> store(ledger, variant)
        }
    }
    machine overlap(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        let previous: Variant = ledger.variants[index];
        transition previous.contig == variant.contig
            && previous.position <= variant.position + variant.removed
            && variant.position <= previous.position + previous.removed {
            true -> conflict(ledger, variant, index)
            _ -> conflicts(ledger, variant, index + 1)
        }
    }
    machine conflict(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        ledger.conflicts = ledger.conflicts + 1;
        transition { _ -> conflicts(ledger, variant, index + 1) }
    }
    machine store(ledger: &mut Ledger, variant: &Variant) -> u64 in Wrapping {
        let index: u64 in Wrapping = ledger.count;
        transition index < 32 {
            true -> write(ledger, variant, index)
            _ -> 2
        }
    }
    machine write(ledger: &mut Ledger, variant: &Variant, index: u64 in Wrapping) -> u64 in Wrapping {
        ledger.variants[index] = Variant {
            contig: variant.contig, position: variant.position, removed: variant.removed,
            inserted: variant.inserted, provenance: variant.provenance
        };
        ledger.count = index + 1;
        (0)
    }
}
