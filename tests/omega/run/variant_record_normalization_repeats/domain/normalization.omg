use domain::sequence;

public data Variant [copy] {
    contig: u64 in Wrapping;
    position: u64 in Wrapping;
    removed: u64 in Wrapping;
    inserted: Sequence;
    provenance: u64 in Wrapping;
}
public data Normalization {
    canonical: Variant;
    haplotype: Sequence;
    cost: u64 in Wrapping;
    status: u64 in Wrapping;
}
// Validate the declared reference allele before constructing the haplotype.
// Canonical ordering is (removed+inserted, position, removed). For a fixed
// haplotype and candidate coordinates, the inserted sequence is uniquely fixed.
public machine normalize(reference: &Sequence, position: u64 in Wrapping,
                      removed: &Sequence, inserted: &Sequence, result: &mut Normalization) {
    result.status = 1;
    transition reference.length <= 8 && position <= reference.length
        && removed.length <= 4 && inserted.length <= 4
        && position + removed.length <= reference.length {
        true -> reference_match(reference, position, removed, inserted, result, 0)
        _ -> stop()
    }
    machine reference_match(reference: &Sequence, position: u64 in Wrapping,
                          removed: &Sequence, inserted: &Sequence,
                          result: &mut Normalization, index: u64 in Wrapping) {
        transition index < removed.length {
            true -> base_match(reference, position, removed, inserted, result, index)
            _ -> construct(reference, position, removed, inserted, result)
        }
    }
    machine base_match(reference: &Sequence, position: u64 in Wrapping,
                     removed: &Sequence, inserted: &Sequence,
                     result: &mut Normalization, index: u64 in Wrapping) {
        let observed: u64 in Wrapping = Sequence::base(reference, position + index);
        let declared: u64 in Wrapping = Sequence::base(removed, index);
        transition observed == declared {
            true -> reference_match(reference, position, removed, inserted, result, index + 1)
            _ -> mismatch(result)
        }
    }
    machine mismatch(result: &mut Normalization) { result.status = 2; }
    machine construct(reference: &Sequence, position: u64 in Wrapping,
                    removed: &Sequence, inserted: &Sequence, result: &mut Normalization) {
        result.haplotype.length = 0;
        let prefix: bool = Sequence::copy_range(reference, 0, position, &mut result.haplotype);
        let middle: bool = Sequence::copy_range(inserted, 0, inserted.length, &mut result.haplotype);
        let suffix: bool = Sequence::copy_range(reference, position + removed.length,
            reference.length - position - removed.length, &mut result.haplotype);
        transition prefix && middle && suffix {
            true -> classify(reference, result)
            _ -> stop()
        }
    }
    machine classify(reference: &Sequence, result: &mut Normalization) {
        let unchanged: bool = Sequence::equal(reference, &result.haplotype);
        transition unchanged {
            true -> noop(result)
            _ -> start(reference, result)
        }
    }
    machine noop(result: &mut Normalization) { result.status = 3; }
    machine start(reference: &Sequence, result: &mut Normalization) {
        result.cost = 25;
        transition { _ -> position_scan(reference, result, 0) }
    }
    machine position_scan(reference: &Sequence, result: &mut Normalization, position: u64 in Wrapping) {
        transition position <= reference.length {
            true -> width_scan(reference, result, position, 0)
            _ -> finished(result)
        }
    }
    machine width_scan(reference: &Sequence, result: &mut Normalization,
                     position: u64 in Wrapping, removed: u64 in Wrapping) {
        transition removed <= 4 && position + removed <= reference.length {
            true -> candidate(reference, result, position, removed)
            _ -> position_scan(reference, result, position + 1)
        }
    }
    machine candidate(reference: &Sequence, result: &mut Normalization,
                    position: u64 in Wrapping, removed: u64 in Wrapping) {
        let length: u64 in Wrapping = result.haplotype.length;
        let inserted: u64 in Wrapping = length + removed - reference.length;
        transition length + removed >= reference.length {
            true -> insertion_width(reference, result, position, removed, inserted)
            _ -> width_scan(reference, result, position, removed + 1)
        }
    }
    machine insertion_width(reference: &Sequence, result: &mut Normalization,
                          position: u64 in Wrapping, removed: u64 in Wrapping,
                          inserted: u64 in Wrapping) {
        transition inserted <= 4 && removed + inserted < result.cost {
            true -> test(reference, result, position, removed, inserted)
            _ -> width_scan(reference, result, position, removed + 1)
        }
    }
    machine test(reference: &Sequence, result: &mut Normalization,
               position: u64 in Wrapping, removed: u64 in Wrapping, inserted: u64 in Wrapping) {
        let equivalent: bool = equivalent_edit(reference, &result.haplotype, position, removed, inserted);
        transition equivalent {
            true -> save(reference, result, position, removed, inserted)
            _ -> width_scan(reference, result, position, removed + 1)
        }
    }
    machine save(reference: &Sequence, result: &mut Normalization,
               position: u64 in Wrapping, removed: u64 in Wrapping, inserted: u64 in Wrapping) {
        result.canonical.position = position;
        result.canonical.removed = removed;
        result.canonical.inserted.length = 0;
        let copied: bool = Sequence::copy_range(&result.haplotype, position, inserted, &mut result.canonical.inserted);
        result.cost = removed + inserted;
        transition copied {
            true -> width_scan(reference, result, position, removed + 1)
            _ -> stop()
        }
    }
    machine finished(result: &mut Normalization) {
        transition result.cost < 25 {
            true -> accepted(result)
            _ -> stop()
        }
    }
    machine accepted(result: &mut Normalization) { result.status = 0; }
    machine stop() { }
}
// Prefix and suffix equality prove the candidate reproduces the exact haplotype.
machine equivalent_edit(reference: &Sequence, haplotype: &Sequence,
                         position: u64 in Wrapping, removed: u64 in Wrapping,
                         inserted: u64 in Wrapping) -> bool {
    transition { _ -> prefix(reference, haplotype, position, removed, inserted, 0) }
    machine prefix(reference: &Sequence, haplotype: &Sequence, position: u64 in Wrapping,
                 removed: u64 in Wrapping, inserted: u64 in Wrapping, index: u64 in Wrapping) -> bool {
        transition index < position {
            true -> prefix_item(reference, haplotype, position, removed, inserted, index)
            _ -> suffix(reference, haplotype, position, removed, inserted, 0)
        }
    }
    machine prefix_item(reference: &Sequence, haplotype: &Sequence, position: u64 in Wrapping,
                      removed: u64 in Wrapping, inserted: u64 in Wrapping, index: u64 in Wrapping) -> bool {
        let first: u64 in Wrapping = Sequence::base(reference, index);
        let second: u64 in Wrapping = Sequence::base(haplotype, index);
        transition first == second {
            true -> prefix(reference, haplotype, position, removed, inserted, index + 1)
            _ -> false
        }
    }
    machine suffix(reference: &Sequence, haplotype: &Sequence, position: u64 in Wrapping,
                 removed: u64 in Wrapping, inserted: u64 in Wrapping, index: u64 in Wrapping) -> bool {
        transition position + removed + index < reference.length {
            true -> suffix_item(reference, haplotype, position, removed, inserted, index)
            _ -> true
        }
    }
    machine suffix_item(reference: &Sequence, haplotype: &Sequence, position: u64 in Wrapping,
                      removed: u64 in Wrapping, inserted: u64 in Wrapping, index: u64 in Wrapping) -> bool {
        let first: u64 in Wrapping = Sequence::base(reference, position + removed + index);
        let second: u64 in Wrapping = Sequence::base(haplotype, position + inserted + index);
        transition first == second {
            true -> suffix(reference, haplotype, position, removed, inserted, index + 1)
            _ -> false
        }
    }
}
