// Private bounded sequence storage. A,C,G,T use codes 1,2,3,4; zero is absent.
// Accessors keep physical array bounds explicit even for rejected runtime inputs.
pub data Sequence [copy] {
    bases: [u64 in Wrapping; 12];
    length: u64 in Wrapping;
}
pub machine Sequence::base(sequence: &Sequence, position: u64 in Wrapping) -> u64 in Wrapping {
    transition position < 12 && position < sequence.length {
        true -> read(sequence, position)
        _ -> 0
    }
    state read(sequence: &Sequence, position: u64 in Wrapping) -> u64 in Wrapping {
        sequence.bases[position]
    }
}
pub machine Sequence::append(sequence: &mut Sequence, value: u64 in Wrapping) -> bool {
    let position: u64 in Wrapping = sequence.length;
    transition position < 12 && value > 0 && value <= 4 {
        true -> store(sequence, position, value)
        _ -> false
    }
    state store(sequence: &mut Sequence, position: u64 in Wrapping, value: u64 in Wrapping) -> bool {
        sequence.bases[position] = value;
        sequence.length = position + 1;
        (true)
    }
}
pub machine Sequence::copy_range(source: &Sequence, start: u64 in Wrapping,
                                 count: u64 in Wrapping, destination: &mut Sequence) -> bool {
    transition { _ -> copy(source, start, count, destination, 0) }
    state copy(source: &Sequence, start: u64 in Wrapping, count: u64 in Wrapping,
               destination: &mut Sequence, index: u64 in Wrapping) -> bool {
        transition index < count {
            true -> append(source, start, count, destination, index)
            _ -> true
        }
    }
    state append(source: &Sequence, start: u64 in Wrapping, count: u64 in Wrapping,
                 destination: &mut Sequence, index: u64 in Wrapping) -> bool {
        let value: u64 in Wrapping = Sequence::base(source, start + index);
        let stored: bool = Sequence::append(destination, value);
        transition stored {
            true -> copy(source, start, count, destination, index + 1)
            _ -> false
        }
    }
}
pub machine Sequence::equal(left: &Sequence, right: &Sequence) -> bool {
    transition left.length == right.length {
        true -> compare(left, right, 0)
        _ -> false
    }
    state compare(left: &Sequence, right: &Sequence, index: u64 in Wrapping) -> bool {
        transition index < left.length {
            true -> item(left, right, index)
            _ -> true
        }
    }
    state item(left: &Sequence, right: &Sequence, index: u64 in Wrapping) -> bool {
        let first: u64 in Wrapping = Sequence::base(left, index);
        let second: u64 in Wrapping = Sequence::base(right, index);
        transition first == second {
            true -> compare(left, right, index + 1)
            _ -> false
        }
    }
}
