use domain::sequence;
// LF-delimited R<contig>:<reference> or V<contig>:<position>:<ref>:<alt>:<source>.
// Coordinates and source ids are single decimal digits. '-' is an empty allele.
public data Input {
    kind: u64 in Wrapping;
    contig: u64 in Wrapping;
    position: u64 in Wrapping;
    source: u64 in Wrapping;
    removed: Sequence;
    inserted: Sequence;
    valid: bool;
}
machine character(line: &[u8; 64], count: u64 in Wrapping, index: u64 in Wrapping) -> u64 in Wrapping {
    transition index < 64 && index < count {
        true -> read(line, index)
        _ -> 0
    }
    machine read(line: &[u8; 64], index: u64 in Wrapping) -> u64 in Wrapping {
        line[index] as u64 in Wrapping
    }
}
public machine parse(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input) {
    input.valid = false;
    input.removed.length = 0;
    input.inserted.length = 0;
    let kind: u64 in Wrapping = character(line, count, 0);
    let contig: u64 in Wrapping = character(line, count, 1);
    let separator: u64 in Wrapping = character(line, count, 2);
    transition contig >= 48 && contig <= 49 && separator == 58 && count <= 64 {
        true -> kind_select(line, count, input, kind, contig - 48)
        _ -> stop()
    }
    machine kind_select(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                      kind: u64 in Wrapping, contig: u64 in Wrapping) {
        input.contig = contig;
        transition kind {
            82 -> reference(line, count, input)
            86 -> variant(line, count, input)
            _ -> stop()
        }
    }
    machine reference(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input) {
        input.kind = 0;
        transition { _ -> sequence(line, count, input, 3, 0) }
    }
    machine variant(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input) {
        input.kind = 1;
        let position: u64 in Wrapping = character(line, count, 3);
        let separator: u64 in Wrapping = character(line, count, 4);
        transition position >= 48 && position <= 56 && separator == 58 {
            true -> variant_start(line, count, input, position - 48)
            _ -> stop()
        }
    }
    machine variant_start(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input, position: u64 in Wrapping) {
        input.position = position;
        transition { _ -> sequence(line, count, input, 5, 0) }
    }
    machine sequence(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                   index: u64 in Wrapping, field: u64 in Wrapping) {
        let byte: u64 in Wrapping = character(line, count, index);
        transition byte {
            65 -> append(line, count, input, index, field, 1)
            67 -> append(line, count, input, index, field, 2)
            71 -> append(line, count, input, index, field, 3)
            84 -> append(line, count, input, index, field, 4)
            45 -> empty(line, count, input, index, field)
            58 -> separator(line, count, input, index, field)
            10 -> end(line, count, input, index)
            0 -> end(line, count, input, index)
            _ -> stop()
        }
    }
    machine append(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                 index: u64 in Wrapping, field: u64 in Wrapping, base: u64 in Wrapping) {
        transition field == 0 {
            true -> removed(line, count, input, index, base)
            _ -> inserted(line, count, input, index, base)
        }
    }
    machine removed(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                  index: u64 in Wrapping, base: u64 in Wrapping) {
        let accepted: bool = Sequence::append(&mut input.removed, base);
        transition accepted && input.removed.length <= 8 {
            true -> sequence(line, count, input, index + 1, 0)
            _ -> stop()
        }
    }
    machine inserted(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                   index: u64 in Wrapping, base: u64 in Wrapping) {
        let accepted: bool = Sequence::append(&mut input.inserted, base);
        transition accepted && input.inserted.length <= 4 {
            true -> sequence(line, count, input, index + 1, 1)
            _ -> stop()
        }
    }
    machine empty(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                index: u64 in Wrapping, field: u64 in Wrapping) {
        let next: u64 in Wrapping = character(line, count, index + 1);
        transition next == 58 && input.kind == 1 {
            true -> empty_check(line, count, input, index, field)
            _ -> stop()
        }
    }
    machine empty_check(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                      index: u64 in Wrapping, field: u64 in Wrapping) {
        transition (field == 0 && input.removed.length == 0) || (field == 1 && input.inserted.length == 0) {
            true -> separator(line, count, input, index + 1, field)
            _ -> stop()
        }
    }
    machine separator(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                    index: u64 in Wrapping, field: u64 in Wrapping) {
        transition input.kind == 1 && input.removed.length <= 4 {
            true -> next_field(line, count, input, index, field)
            _ -> stop()
        }
    }
    machine next_field(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                     index: u64 in Wrapping, field: u64 in Wrapping) {
        transition field == 0 {
            true -> sequence(line, count, input, index + 1, 1)
            _ -> provenance(line, count, input, index + 1)
        }
    }
    machine provenance(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                     index: u64 in Wrapping) {
        let source: u64 in Wrapping = character(line, count, index);
        let next: u64 in Wrapping = character(line, count, index + 1);
        transition source >= 48 && source <= 55 && (next == 10 || index + 1 == count) {
            true -> provenance_end(line, count, input, index, source - 48)
            _ -> stop()
        }
    }
    machine provenance_end(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input,
                         index: u64 in Wrapping, source: u64 in Wrapping) {
        transition index + 1 == count || index + 2 == count {
            true -> provenance_save(input, source)
            _ -> stop()
        }
    }
    machine provenance_save(input: &mut Input, source: u64 in Wrapping) {
        input.source = source;
        input.valid = true;
    }
    machine end(line: &[u8; 64], count: u64 in Wrapping, input: &mut Input, index: u64 in Wrapping) {
        let ending: u64 in Wrapping = character(line, count, index);
        transition input.kind == 0 && input.removed.length > 0
            && (index == count || (index + 1 == count && ending == 10)) {
            true -> reference_end(input)
            _ -> stop()
        }
    }
    machine reference_end(input: &mut Input) { input.valid = true; }
    machine stop() { }
}
