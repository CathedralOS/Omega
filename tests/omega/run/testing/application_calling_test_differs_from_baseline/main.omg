// Expected exit: 0.
// Negative control for expected_application_baseline.txt: this application
// calls one of its own tests, so that test belongs to the application and its
// Terminal program differs from the baseline's. The oracle records
// `application-baseline:differs`, showing it detects retained test code.
trait Tests {
    machine arithmetic()
        crashes Trap;
}

machine addition_is_correct()
satisfies Tests::arithmetic
crashes Trap
{
    transition 2u32 + 3u32 != 5u32 {
        true -> failed()
        _ -> passed()
    }

    machine failed() crashes Trap {
        crash Trap;
    }

    machine passed() { }
}

machine subtraction_is_correct()
satisfies Tests::arithmetic
crashes Trap
{
    transition 5u32 - 3u32 != 2u32 {
        true -> failed()
        _ -> passed()
    }

    machine failed() crashes Trap {
        crash Trap;
    }

    machine passed() { }
}

machine main() crashes Trap {
    addition_is_correct();
}
