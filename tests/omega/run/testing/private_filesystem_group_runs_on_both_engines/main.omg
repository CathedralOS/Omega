// Expected exit: 0.
// A test group that names std's `FilesystemService` slot runs each test over a
// private filesystem its runner creates empty: the interpreter answers the
// kernel calls std's POSIX provider makes, and the native test runs over an
// empty tmpfs root. Both tests create the same journal with `create_new`, which
// succeeds only when no earlier invocation's file survives, then read it back.
// The second also lists the root, which holds exactly its own directory and
// journal. The host's `/etc` is absent, so the backing cannot reach the real
// filesystem.
// The tests bind only the Linux targets, whose kernel calls the runner backs.
use omega_language_std::File;
use omega_language_std::OpenResult;
use omega_language_std::IoResult;
use omega_language_std::UnitResult;
use omega_language_std::Filesystem;
use omega_language_std::FilesystemService;
use omega_language_std::Filesystem::create_new;
use omega_language_std::Filesystem::write;
use omega_language_std::Filesystem::close;
use omega_language_std::Filesystem::read_all;
use omega_language_std::Filesystem::exists;
use omega_language_std::Filesystem::create_dir;
use omega_language_std::Filesystem::read_dir_count;

trait Tests {
    machine journal()
        crashes Trap
        blocks
        reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
        invokes FilesystemService;
}

machine journal_starts_empty()
satisfies Tests::journal
crashes Trap
blocks
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
{
    let mut fs: Filesystem;
    transition block Filesystem::exists(&mut fs, "/etc") {
        true -> failed()
        _ -> block create(&mut fs)
    }

    machine create(fs: &mut Filesystem)
    crashes Trap
    blocks
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
    {
        let created: OpenResult = block Filesystem::create_new(fs, "/journal.txt");
        transition created {
            OpenResult::Ok { file } -> block write(fs, file)
            _ -> failed()
        }
    }

    machine write(fs: &mut Filesystem, file: File)
    crashes Trap
    blocks
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
    {
        let written: IoResult = block Filesystem::write(fs, file, "entry");
        let closed: UnitResult = block Filesystem::close(fs, file);
        transition written {
            IoResult::Ok { count } -> block read(fs, count)
            _ -> failed()
        }
    }

    machine read(fs: &mut Filesystem, written: u64)
    crashes Trap
    blocks
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
    {
        let mut buffer: [u8; 16];
        let read: IoResult = block Filesystem::read_all(fs, "/journal.txt", &mut buffer, 16);
        transition read {
            IoResult::Ok { count } -> check(written, count, buffer[0], buffer[4])
            _ -> failed()
        }
    }

    machine check(written: u64, read: u64, first: u8, last: u8) crashes Trap {
        transition written == 5 && read == 5 && first == 101 && last == 121 {
            true -> passed()
            _ -> failed()
        }
    }

    machine failed() crashes Trap {
        crash Trap;
    }

    machine passed() { }
}

machine journal_lists_its_directory()
satisfies Tests::journal
crashes Trap
blocks
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
{
    let mut fs: Filesystem;
    let made: UnitResult = block Filesystem::create_dir(&mut fs, "/notes");
    transition made {
        UnitResult::Ok -> block create(&mut fs)
        _ -> failed()
    }

    machine create(fs: &mut Filesystem)
    crashes Trap
    blocks
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
    {
        let created: OpenResult = block Filesystem::create_new(fs, "/journal.txt");
        transition created {
            OpenResult::Ok { file } -> block list(fs, file)
            _ -> failed()
        }
    }

    machine list(fs: &mut Filesystem, file: File)
    crashes Trap
    blocks
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration
    {
        let closed: UnitResult = block Filesystem::close(fs, file);
        let counted: IoResult = block Filesystem::read_dir_count(fs, "/");
        transition counted {
            IoResult::Ok { count } -> check(count)
            _ -> failed()
        }
    }

    machine check(entries: u64) crashes Trap {
        transition entries == 2 {
            true -> passed()
            _ -> failed()
        }
    }

    machine failed() crashes Trap {
        crash Trap;
    }

    machine passed() { }
}

machine main() { }
