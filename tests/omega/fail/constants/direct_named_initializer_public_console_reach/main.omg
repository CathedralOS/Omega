public boundary trait Console {}

trait Reading {
    machine read(value: u64) -> u64
        requires value == 7
        ensures result == value
        reaches Console
        terminates;
}

Chosen satisfies Reading {
    machine read(value: u64) -> u64
        requires value == 7
        ensures result == value
        reaches
        terminates
    { value }
}

const VALUE: u64 = Chosen::read(7u64);

machine main() crashes Trap {
    transition VALUE == 7u64 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
