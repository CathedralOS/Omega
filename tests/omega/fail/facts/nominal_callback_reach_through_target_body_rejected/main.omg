// Invalid: `noise` has no `satisfies StepContract::step`, so the selection
// cannot establish the binder contract. A nominal Step callback selection contributes its specialized reach row;
// its result is produced inside target-specific caller bodies.
// Place: another target body.
// Expected exit: 0
trait StepContract {
    machine step(value: u64) -> u64;
}

machine noise(value: u64) -> u64
{
    7
}

machine bump(value: u64) -> u64
satisfies StepContract::step
{
    42
}

machine walk<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
{
    Step(value)
}

linux_x86_64 machine relay(value: u64) -> u64 {
    walk<noise>(value)
}
linux_arm64 machine relay(value: u64) -> u64 {
    walk<noise>(value)
}
macos_arm64 machine relay(value: u64) -> u64 {
    walk<noise>(value)
}
windows_x86_64 machine relay(value: u64) -> u64 {
    walk<noise>(value)
}

machine main() crashes Trap {
    transition relay(35) == 42u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
