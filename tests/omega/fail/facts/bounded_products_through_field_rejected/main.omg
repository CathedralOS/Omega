// Bounded u64 factors a <= 50 and b <= 50 make a * b fit in result <= 2500 without a domain or widening.
// Invalid: one operand bound is removed, so the exact product may overflow u64.
// Expected exit: 0
data Factors where left <= 50 {
    left: u64;
    right: u64;
}

machine mul(factors: Factors) -> u64
ensures result <= 2500
{
    factors.left * factors.right
}

machine main() crashes Trap {
    let upper: Factors = Factors { left: 50, right: 50 };
    let sample: Factors = Factors { left: 30, right: 40 };
    transition mul(sample) == 1200 && mul(upper) == 2500 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
