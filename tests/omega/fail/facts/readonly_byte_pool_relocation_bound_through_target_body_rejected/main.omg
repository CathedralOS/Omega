// Fact: a read-only byte-pool slice literal ("omega") establishes a static 5-byte length bound (bytes.len >= 5u64 && bytes.len <= 5u64), proving safe indexed byte projection bytes[4u64] and exact length subtraction bytes.len - 5u64 across all nine places.
// Place: another target body (invalid twin).

machine inspect_bytes(bytes: &[u8]) -> u64 crashes Trap
requires bytes.len >= 5u64 && bytes.len <= 5u64
ensures result == 0u64
{
    let b: u8 = bytes[4u64];
    let diff: u64 = bytes.len - 5u64;
    transition b == 97u8 {
        true -> ok(diff)
        _ -> bad()
    }
    machine ok(d: u64) -> u64 {
        d
    }
    machine bad() -> u64 {
        crash Trap;
    }
}

linux_x86_64 machine evaluate_bytes() -> u64 crashes Trap
ensures result == 0u64
{
    let bytes: &[u8] = "omeg";
    inspect_bytes(bytes)
}

linux_arm64 machine evaluate_bytes() -> u64 crashes Trap
ensures result == 0u64
{
    let bytes: &[u8] = "omeg";
    inspect_bytes(bytes)
}

macos_arm64 machine evaluate_bytes() -> u64 crashes Trap
ensures result == 0u64
{
    let bytes: &[u8] = "omeg";
    inspect_bytes(bytes)
}

windows_x86_64 machine evaluate_bytes() -> u64 crashes Trap
ensures result == 0u64
{
    let bytes: &[u8] = "omeg";
    inspect_bytes(bytes)
}

machine probe() -> u64 crashes Trap
ensures result == 0u64
{
    evaluate_bytes()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
