// Dispatching a trait method through a dynamic trait carrier (dyn / trait conformance) whose contract establishes result <= 88u64 preserves the return bound across the selector and data lanes, discharging exact subtraction 88u64 - result.
// Expected rejection: exact arithmetic in machine main state entry local diff may overflow `u64`.
trait PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64;
}

ActualEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64
    ensures result <= 89u64
    {
        89u64
    }
}

machine alternate_value() -> u64 ensures result <= 89u64 { 89u64 }
AlternateEvaluator satisfies PayloadEvaluator {
    machine compute(base: u64) -> u64 ensures result <= 89u64 { alternate_value() }
}
machine evaluate(condition: bool) -> u64 {
    let selector: dyn PayloadEvaluator = match condition {
        true -> ActualEvaluator as dyn PayloadEvaluator,
        false -> AlternateEvaluator as dyn PayloadEvaluator,
    };
    let result: u64 = PayloadEvaluator::compute(selector, 10u64);
    88u64 - result
}
machine main() crashes Trap {
    transition evaluate(true) == 50u64 && evaluate(false) == 40u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
