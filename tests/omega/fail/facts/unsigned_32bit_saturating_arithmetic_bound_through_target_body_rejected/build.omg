machine build(builder: &mut Build) {
    Build::select_provider<SelectedSatTarget, CheckedSatTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedSatTarget, CheckedSatTarget>(builder, linux_arm64);
    Build::select_provider<SelectedSatTarget, CheckedSatTarget>(builder, macos_arm64);
    Build::select_provider<SelectedSatTarget, CheckedSatTarget>(builder, windows_x86_64);

    Build::application(builder, "unsigned_32bit_saturating_arithmetic_bound_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
