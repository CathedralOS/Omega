// Fact: 32-bit unsigned saturating addition lhs +| rhs with bounded interval 50u32 <= sum <= 100u32 establishes 50u32 <= sum <= 100u32 across all nine places so exact subtractions 100u32 - sum and sum - 50u32 are safe.
// Place: another target body (invalid twin). The lhs upper bound is widened to 81u32 so sum reaches 101u32, underflowing 100u32 - sum.
// Expected diagnostic: may overflow `u32`

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSatTarget {
    machine sat_target(lhs: u32, rhs: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 40 && lhs <= 81 && rhs >= 10 && rhs <= 20;
}

X86SatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: u32, rhs: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 40 && lhs <= 81 && rhs >= 10 && rhs <= 20
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: u32 in Saturating = lhs as u32 in Saturating;
        let b: u32 in Saturating = rhs as u32 in Saturating;
        let sat_sum: u32 in Saturating = a + b;
        let sum: u32 = sat_sum as u32;
        let headroom: u32 = 100u32 - sum;
        let margin: u32 = sum - 50u32;
        headroom + margin
    }
}

ArmSatTarget satisfies SelectedSatTarget {
    machine sat_target(lhs: u32, rhs: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 40 && lhs <= 81 && rhs >= 10 && rhs <= 20
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: u32 in Saturating = lhs as u32 in Saturating;
        let b: u32 in Saturating = rhs as u32 in Saturating;
        let sat_sum: u32 in Saturating = a + b;
        let sum: u32 = sat_sum as u32;
        let headroom: u32 = 100u32 - sum;
        let margin: u32 = sum - 50u32;
        headroom + margin
    }
}

machine probe() -> u32 {
    SelectedSatTarget::sat_target(60u32, 15u32)
}

machine main() crashes Trap {
    transition probe() == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
