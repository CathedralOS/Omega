// A finite-family method on a borrowed record returns a descriptor of the original backing, and reading its first byte yields 11.
// Expected exit: 0
data Packet<'bytes> [copy] { bytes: &'bytes u8; }
trait Windowing {
 machine window<Width: u32>(source: &Packet) -> Packet
 where Width == 16 || Width == 32;
}
Header satisfies Windowing {
 machine window<Width: u32>(source: &Packet) -> Packet
 where Width == 16 || Width == 32 { let local: u8 = 11; Packet { bytes: &local } }
}
machine dispatch(selected: dyn Windowing, source: &Packet, width: u32) -> Packet
requires width == 16 || width == 32 {
 Windowing::window<width>(selected, source)
}
machine main() crashes Trap {
 let source: u8 = 11;
 let selected: dyn Windowing = Header as dyn Windowing;
 let packet: Packet = Packet { bytes: &source };
 let result: Packet = dispatch(selected, &packet, 16);
 transition result.bytes == 11 { true -> done() false -> bad() }
 state done() {}
 state bad() { crash Trap; }
}
