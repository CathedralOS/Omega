// A finite-family method on a borrowed record returns a descriptor of the original backing, and reading its first byte yields 11.
// Expected exit: 0
data BackingPacket [copy] { original: u8; }
data Packet [copy] { bytes: u8; }
trait Windowing {
    machine window<Width: u32>(source: &Packet) -> &Packet
    requires Width == 16 || Width == 32;
}
Header satisfies Windowing {
    machine window<Width: u32>(source: &Packet) -> &Packet
    requires Width == 16 || Width == 32 {
        let local: Packet = Packet { bytes: 11 }; &local
    }
}
machine dispatch(selected: dyn Windowing, source: &Packet, width: u32) -> &Packet
requires width == 16 || width == 32 {
    Windowing::window<width>(selected, source)
}
machine viewed_dispatch(source: &BackingPacket, width: u32) -> &Packet
requires width == 16 || width == 32 {
    let viewed: &Packet = source as &Packet;
    dispatch(Header as dyn Windowing, viewed, width)
}
machine main() crashes Trap {
    let packet: BackingPacket = BackingPacket { original: 11 };
    let first: &Packet = viewed_dispatch(&packet, 16);
    let second: &Packet = viewed_dispatch(&packet, 32);
    let other: BackingPacket = BackingPacket { original: 23 };
    let third: &Packet = viewed_dispatch(&other, 16);
    transition first.bytes == 11 && second.bytes == 11 && packet.original == 11
        && third.bytes == 23 && other.original == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
