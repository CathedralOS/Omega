// A finite-family method on a borrowed record returns a descriptor of the original backing, and reading its first byte yields 11.
// Expected exit: 0
data Packet<'bytes> [copy] { bytes: &'bytes u8; }
trait Windowing { machine window<Width: u32>(source: &Packet) -> Packet where Width == 16 || Width == 32; }
Header satisfies Windowing { machine window<Width: u32>(source: &Packet) -> Packet where Width == 16 || Width == 32 { Packet { bytes: source.bytes } } }
machine dispatch(selected: dyn Windowing, source: &Packet, width: u32) -> Packet
requires width == 16 || width == 32 { Windowing::window<width>(selected, source) }
machine replace_and_dispatch<'bytes>(source: &mut Packet<'bytes>, replacement: Packet<'bytes>, width: u32) -> Packet<'bytes>
requires width == 16 || width == 32 {
 let local: u8 = 11;
 source = Packet { bytes: &local };
 dispatch(Header as dyn Windowing, source, width)
}
machine main() crashes Trap {
 let before: u8 = 29; let after: u8 = 11;
 let mut packet: Packet = Packet { bytes: &before };
 let result: Packet = replace_and_dispatch(&mut packet, Packet { bytes: &after }, 16);
 transition result.bytes == 11 && packet.bytes == 11 { true -> done() false -> bad() }
 machine done() {}
 machine bad() crashes Trap { crash Trap; }
}
