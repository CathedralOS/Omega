// A finite-family method on a borrowed record returns a descriptor of the original backing, and reading its first byte yields 11.
// Expected exit: 0
data Packet [copy] { bytes: u8; }
data Holder [copy] { packet: Packet; }
trait Windowing {
    machine window<Width: u32>(source: &Packet) -> &Packet
    requires Width == 16 || Width == 32;
}
Header satisfies Windowing {
    machine window<Width: u32>(source: &Packet) -> &Packet
    requires Width == 16 || Width == 32 {
        let local: Packet = Packet { bytes: 11 }; &local
    }
}
machine dispatch(selected: dyn Windowing, source: &Packet, width: u32) -> &Packet
requires width == 16 || width == 32 {
    Windowing::window<width>(selected, source)
}
machine joined<'bytes>(source: &'bytes Packet, holder: &'bytes Holder, choice: bool, width: u32) -> &'bytes Packet
requires width == 16 || width == 32 {
    let selected: &Packet = match choice {
        true -> source,
        false -> &holder.packet,
    };
    dispatch(Header as dyn Windowing, selected, width)
}
machine incoming<'bytes>(first: &'bytes Packet, second: &'bytes Packet, choice: bool, width: u32) -> &'bytes Packet
requires width == 16 || width == 32 {
    let selected: &Packet = match choice {
        true -> first,
        false -> second,
    };
    dispatch(Header as dyn Windowing, selected, width)
}
machine main() crashes Trap {
    let packet: Packet = Packet { bytes: 11 };
    let holder: Holder = Holder { packet: Packet { bytes: 23 } };
    let first: &Packet = joined(&packet, &holder, true, 16);
    let second: &Packet = joined(&packet, &holder, true, 32);
    let third: &Packet = joined(&packet, &holder, false, 16);
    let fourth: &Packet = joined(&packet, &holder, false, 32);
    let input_a: &Packet = incoming(&packet, &holder.packet, true, 16);
    let input_b: &Packet = incoming(&packet, &holder.packet, false, 32);
    transition first.bytes == 11 && second.bytes == 11 && packet.bytes == 11
        && third.bytes == 23 && fourth.bytes == 23 && holder.packet.bytes == 23
        && input_a.bytes == 11 && input_b.bytes == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
