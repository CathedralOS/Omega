use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, windows_x86_64);
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, linux_x86_64);
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, macos_arm64);
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, linux_arm64);

    Build::application(builder, "selected_provider_issuance");
    Build::accept_boundary<InitialSupply>(builder);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, linux_arm64);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, linux_x86_64);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, macos_arm64);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, macos_x86_64);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, windows_x86_64);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, uefi_x86_64);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, cross_platform_cli);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, local_unchecked);
    Build::select_provider<InitialSupply, InitialSupplyProvider>(builder, alpha_bootstrap);
    Build::accept_boundary<Writer>(builder);
    Build::select_provider<Writer, WriterProvider>(builder, linux_arm64);
    Build::select_provider<Writer, WriterProvider>(builder, linux_x86_64);
    Build::select_provider<Writer, WriterProvider>(builder, macos_arm64);
    Build::select_provider<Writer, WriterProvider>(builder, macos_x86_64);
    Build::select_provider<Writer, WriterProvider>(builder, windows_x86_64);
    Build::select_provider<Writer, WriterProvider>(builder, uefi_x86_64);
    Build::select_provider<Writer, WriterProvider>(builder, cross_platform_cli);
    Build::select_provider<Writer, WriterProvider>(builder, local_unchecked);
    Build::select_provider<Writer, WriterProvider>(builder, alpha_bootstrap);
    Build::accept_boundary<NativeBytes>(builder);
    Build::select_provider<NativeBytes, HostedBytes>(builder, linux_arm64);
    Build::select_provider<NativeBytes, HostedBytes>(builder, linux_x86_64);
    Build::select_provider<NativeBytes, HostedBytes>(builder, macos_arm64);
    Build::select_provider<NativeBytes, HostedBytes>(builder, macos_x86_64);
    Build::select_provider<NativeBytes, HostedBytes>(builder, windows_x86_64);
    Build::select_provider<NativeBytes, HostedBytes>(builder, uefi_x86_64);
    Build::select_provider<NativeBytes, HostedBytes>(builder, cross_platform_cli);
    Build::select_provider<NativeBytes, HostedBytes>(builder, local_unchecked);
    Build::select_provider<NativeBytes, HostedBytes>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);

 Build::bind<NativeBytes::allocate>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_calloc", } });
 Build::bind<NativeBytes::release>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_free", } });
 Build::bind<NativeBytes::allocate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5", } });
 Build::bind<NativeBytes::release>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "free", version: "GLIBC_2.2.5", } });
 Build::bind<NativeBytes::allocate>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.17", } });
 Build::bind<NativeBytes::release>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "free", version: "GLIBC_2.17", } });
 Build::bind<NativeBytes::allocate>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "msvcrt.dll", export: "calloc", } });
 Build::bind<NativeBytes::release>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "msvcrt.dll", export: "free", } });
}
