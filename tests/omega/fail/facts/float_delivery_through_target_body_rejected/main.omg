// Inclusive f64 0.0 <= value <= 0.25 entails admit's 0.0 <= value <= 0.5.
// Reject: missing narrow upper-bound proof at admit(value).
use omega::language::core::float_operations;
data Reading [copy] where value >= 0.0 { value: f64; }
machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }
linux_x86_64 machine probe(reading: Reading) -> f64 { admit(reading.value) }
linux_arm64 machine probe(reading: Reading) -> f64 { admit(reading.value) }
macos_arm64 machine probe(reading: Reading) -> f64 { admit(reading.value) }
windows_x86_64 machine probe(reading: Reading) -> f64 { admit(reading.value) }
machine main() crashes Trap {
    let reading: Reading = Reading { value: 0.25 };
    let observed: f64 = probe(reading);
    transition observed == 0.25 { true -> done() _ -> bad() }
    state done() { }
    state bad() { crash Trap; }
}
