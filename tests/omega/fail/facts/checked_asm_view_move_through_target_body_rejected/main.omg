// An x86 mov through a typed view index copies the indexed element by the place's ordinary assignment.
// Expected exit: 0.
machine main() crashes Trap { fill(); }
linux_x86_64 machine fill() crashes Trap {
    let mut values: [u32; 2] = [7, 9];
    asm {
        mov eax, 37;
        mov [values], eax
    }
    transition values[0] == 37 && values[1] == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
