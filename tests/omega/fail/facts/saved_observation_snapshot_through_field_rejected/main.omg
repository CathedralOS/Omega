// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine capture<'source, View>(source: View, marker: &mut u64, event: u64) -> View where View == &'source u64 { marker = event; source }

data Note { before: u64; observed: u64; after: u64; }
machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine main() crashes Trap {
    let mut marker: u64 = 0;
    let mut items: [u64; 2] = [7, 1];
    let saved: u64 = capture<&u64>(&items[0], &mut marker, 11);
    items[0] = 4;
    let note: Note = Note { before: 11, observed: saved, after: 13 };
    transition agree(note.observed, items[0]) == 7 && items[1] == 4 && marker == 11 && note.before == 11 && note.after == 13 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
