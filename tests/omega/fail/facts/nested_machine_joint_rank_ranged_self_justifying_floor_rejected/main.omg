// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
machine count(counter: &mut u64, remaining: u64, cap: u64)
terminates
terminates by remaining in (cap - 1)..=7
requires remaining <= 7 && remaining >= cap - 1
{
    transition cap > 0 && remaining >= cap {
        true -> forward(remaining, cap, counter)
        false -> done()
    }
    machine forward(pending: u64, cap: u64, counter: &mut u64)
    requires cap > 0 && pending >= cap && pending <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        transition { _ -> count(counter, pending - 1, cap) }
    }
    machine done() {}
}
machine perform(counter: &mut u64, select: bool) {
    let remaining: u64 = match select { true -> 7 false -> 0 };
    count(counter, remaining, 1);
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
