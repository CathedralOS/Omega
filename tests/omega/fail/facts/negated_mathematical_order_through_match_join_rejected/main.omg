// Fact: a named negated integer-order predicate establishes value <= 5 for exact 5u64 - value.
// Expected exit: 0
let within(limit: u64, value: u64): core::Strict<0> = !(value > limit);
domain u64::Small(value) requires within(5, value);
machine establish() -> u64 in Small {
    let mut value: u64 in Small = 0;
    value = 6;
    value
}
machine choose(flag: bool) -> u64 { let value: u64 in Small = match flag { true -> establish(), false -> establish() }; 5u64 - value }
machine probe() -> u64 { let left: u64 = choose(true); let right: u64 = choose(false); transition left == right { true -> left _ -> 0 } }
machine main() crashes Trap {
    transition probe() == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
