// Fact: 16-bit signed wrapping addition lhs +% rhs with bounded interval 350i16 <= sum <= 600i16 establishes 350i16 <= sum <= 600i16 across all nine places so exact subtractions 600i16 - sum and sum - 350i16 are safe.
// Place: target_body. Each hosted target body computes the 16-bit signed wrapping addition and verifies the bounds.
// Expected exit: 0
machine verify_sum(value: i16) -> i16
    requires value >= 350 && value <= 600
{
    let head: i16 = 600 - value;
    let tail: i16 = value - 350;
    head + tail
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 300 && lhs <= 500 && rhs >= 50 && rhs <= 101;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 300 && lhs <= 500 && rhs >= 50 && rhs <= 101
    {
        SelectedBodyCheck::require_tag(17u64);
        let a: i16 in Wrapping = lhs as i16 in Wrapping;
        let b: i16 in Wrapping = rhs as i16 in Wrapping;
        let wrapped: i16 in Wrapping = a + b;
        let sum: i16 = wrapped as i16;
        verify_sum(sum)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(lhs: i16, rhs: i16) -> i16
        reaches SelectedBodyCheck crashes Trap
        requires lhs >= 300 && lhs <= 500 && rhs >= 50 && rhs <= 101
    {
        SelectedBodyCheck::require_tag(29u64);
        let a: i16 in Wrapping = lhs as i16 in Wrapping;
        let b: i16 in Wrapping = rhs as i16 in Wrapping;
        let wrapped: i16 in Wrapping = a + b;
        let sum: i16 = wrapped as i16;
        verify_sum(sum)
    }
}









machine evaluate() -> i16
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(400, 80)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i16 = evaluate();
    transition res == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
