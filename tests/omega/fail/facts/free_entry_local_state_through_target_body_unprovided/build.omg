machine build(builder: &mut Build) {
    Build::select_provider<SelectedFinish, CheckedFinish>(builder, linux_x86_64);
    Build::select_provider<SelectedFinish, CheckedFinish>(builder, linux_arm64);
    Build::select_provider<SelectedFinish, CheckedFinish>(builder, macos_arm64);
    Build::select_provider<SelectedFinish, CheckedFinish>(builder, windows_x86_64);

    Build::application(builder, "free_entry_local_state_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_arm64::ProgramEntry, start);
    Build::bind(builder, macos_arm64::ProgramEntry, start);
    Build::bind(builder, windows_x86_64::ProgramEntry, start);
}
