// A data binding retains the producer's equality between two u64 fields so subtracting the lower binding from the upper binding is exact.
// Expected exit: 0
data Pair [copy] { lower: u64; upper: u64; }
machine bind_components(pair: Pair, expected: u64) -> bool {
    let Pair { lower as low, upper as high } = pair;
    let difference: u64 = high - low;
    difference == 0 && low == expected && high == expected
}
machine produce(value: u64) -> Pair { Pair { lower: value, upper: value } }
data Holder { pair: Pair; }
machine exercise(expected: u64) -> bool {
    let holder: Holder = Holder { pair: produce(expected) };
    bind_components(holder.pair, expected)
}
machine main() crashes Trap {
    transition exercise(17) && exercise(23) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
