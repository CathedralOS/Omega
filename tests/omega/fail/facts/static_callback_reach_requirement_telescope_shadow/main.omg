// A static callback retains its exact selection and bounded reach through a conformance invocation; its transported result discharges 37 - result.
// Expected exit: 0
public boundary trait Console {}
public boundary trait Extra {}
proposition bounded(value: u64) = value <= 37;
proposition alternate(value: u64) = value <= 37;
trait Anchor { machine anchor(value: u64) -> u64; }
trait OtherAnchor { machine anchor(value: u64) -> u64; }
public trait StepContract<proposition Predicate, machine Requirement>
where proposition Predicate(value: u64);
{
    machine step(value: u64) -> u64
    reaches Console terminates;
    requires value <= 37
    ensures result <= 37;
}
machine quiet(value: u64) -> u64
satisfies StepContract<bounded, Anchor::anchor>::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine second(value: u64) -> u64
satisfies StepContract<bounded, Anchor::anchor>::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine traverse<bounded, machine Step>(value: u64) -> u64
where machine Step satisfies StepContract<bounded, Anchor::anchor>::step;
terminates;
requires value <= 37
ensures result <= 37
{
    transition { _ -> Step(value) }
}
machine main() reaches crashes Trap {
    let value: u64 = traverse<u64, quiet>(37);
    let margin: u64 = 37 - value;
    transition margin == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
