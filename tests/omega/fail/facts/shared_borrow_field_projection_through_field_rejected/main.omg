// Fact: projecting a bounded field through a shared borrow preserves its exact static upper bound without moving the backing record, discharging exact subtraction 90u64 - used across all nine places.
// Place: field (invalid twin). Field bound is widened to used <= 91, and the projected field carries an opaque `requires seed <= 91` value, so the widened bound is all the checker knows: exact subtraction 90u64 - used may underflow.
// Expected diagnostic: exact subtraction underflow
data Window where used <= 91, {
    used: u64;
}

data ViewHolder {
    view: &Window;
}

machine evaluate(seed: u64) -> u64
requires seed <= 91
{
    let window: Window = Window { used: seed };
    let holder: ViewHolder = ViewHolder { view: &window };
    let used: u64 = holder.view.used;
    let diff: u64 = 90u64 - used;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate(40);
    transition diff == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
