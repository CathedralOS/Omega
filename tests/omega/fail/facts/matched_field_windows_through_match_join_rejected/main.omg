// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the joined end is 2 on one arm and 3 on the other, so the two
// spellings of that coordinate disagree on length.
machine from_join<'row>(items: &'row mut [u8; 4], which: i64, flag: bool) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..(match flag { true -> which + 2, false -> 3 })]
        _ -> &mut items[2..4]
    }
}

machine main() crashes Trap {
    let mut left: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_join(&mut left, 0, true);
    transition window.len == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
