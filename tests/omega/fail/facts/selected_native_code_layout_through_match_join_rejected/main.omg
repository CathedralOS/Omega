// The exact selected executable application supplies a nonzero native entry and finite attributed code regions at runtime.
// Reject: late native metadata cannot determine a same-product semantic constant.
use omega::language::core::code_layout;
machine selected<T, const Salt: u64>(value: T) -> T { value }
machine inspect(layout: &CodeLayout) -> bool
terminates;
{
    transition layout.regions.len > 0 { true -> region(layout) _ -> false }
    machine region(layout: &CodeLayout) -> bool
    requires layout.regions.len > 0
    {
        layout.entry != 0 && layout.regions[0].base == layout.entry && layout.regions[0].length > 0
    }
}
machine fetch(branch: bool) -> CodeLayout terminates; {
    match branch { true -> code_layout<selected<u64, 7>>(), false -> code_layout<selected<u64, 7>>() }
}
machine witness() -> bool terminates; {
    let left: CodeLayout = fetch(true);
    let right: CodeLayout = fetch(false);
    inspect(&left) && inspect(&right)
}
const OBSERVED: bool = witness();
machine main() crashes Trap {
    transition OBSERVED { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
