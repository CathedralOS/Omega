// A selected implementation returns one of its Utf8 inputs, and the returned view keeps the Utf8 membership its consumer requires.
// Place: other machine; each row forwards its input to another machine that returns a local alias.
// Reject twin: the requirement no longer promises Utf8 on its returned view.
public domain [u8]::Utf8 requires valid_utf8(self);
trait Payload {
    machine window<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8) -> &'input [u8];
}
machine relay<'held>(view: &'held [u8] in Utf8) -> &'held [u8] in Utf8 {
    let bytes: &'held [u8] in Utf8 = view;
    bytes
}
First satisfies Payload {
    machine window<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8) -> &'input [u8] {
        relay(first)
    }
}
Second satisfies Payload {
    machine window<'input>(first: &'input [u8] in Utf8, second: &'input [u8] in Utf8) -> &'input [u8] {
        relay(second)
    }
}
machine classify(bytes: &[u8] in Utf8) -> u64 {
    match bytes == "abc" {
        true -> 3
        false -> accented(bytes)
    }
}
machine accented(bytes: &[u8]) -> u64 {
    match bytes == "é" {
        true -> 2
        false -> 9
    }
}
machine main() crashes Trap {
    let accent: &[u8] in Utf8 = "é";
    let word: &[u8] in Utf8 = "abc";
    let chosen_first: dyn Payload = First as dyn Payload;
    let chosen_second: dyn Payload = Second as dyn Payload;
    let first: u64 = classify(Payload::window(chosen_first, accent, word));
    let second: u64 = classify(Payload::window(chosen_second, accent, word));
    transition first == 2 && second == 3 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
