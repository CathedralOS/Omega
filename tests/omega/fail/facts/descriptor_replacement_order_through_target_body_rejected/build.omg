machine build(builder: &mut Build) {
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, windows_x86_64);
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, linux_x86_64);
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, macos_arm64);
    Build::select_provider<SelectedTransport, CheckedTransport>(builder, linux_arm64);

    Build::application(builder, "replacement_rhs_probe");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
