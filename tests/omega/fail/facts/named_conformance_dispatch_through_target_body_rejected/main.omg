// A named implementation Selected satisfies Arithmetic<i32> dispatches its inline combine member on explicit i32 operands and preserves the bounded result across all nine places.
trait Arithmetic<Value> {
    machine combine(left: Value, right: Value) -> Value
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures result == left + right
    blocks;
}

Selected satisfies Arithmetic<i32> {
    machine combine(left: i32, right: i32) -> i32
    requires 0 <= left && left <= 50
    requires 0 <= right && right <= 50
    ensures result == left + right
    blocks
    {
        left + right
    }
}

machine apply<Operations satisfies Arithmetic<i32>>(left: i32, right: i32) -> i32
blocks
requires 0 <= left && left <= 50
requires 0 <= right && right <= 50
ensures result == left + right
{
    block Operations::combine(left, right)
}

// Place: another target body (invalid twin). The target bodies lack the right operand bound.
// Expected exit: 0
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedProbe {
    machine probe(a: i32, b: i32) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    blocks
    requires 0 <= a && a <= 50;
}
X86Probe satisfies SelectedProbe {
    machine probe(a: i32, b: i32) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    blocks
    requires 0 <= a && a <= 50
    {
        SelectedBodyCheck::require_tag(17u64);
        block apply<Selected>(a, b)
    }
}
ArmProbe satisfies SelectedProbe {
    machine probe(a: i32, b: i32) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    blocks
    requires 0 <= a && a <= 50
    {
        SelectedBodyCheck::require_tag(29u64);
        block apply<Selected>(a, b)
    }
}


machine main() blocks crashes Trap {
    let result: i32 = block SelectedProbe::probe(20, 22);
    transition result == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() blocks crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    block main();
}
machine arm_entry() blocks crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    block main();
}
