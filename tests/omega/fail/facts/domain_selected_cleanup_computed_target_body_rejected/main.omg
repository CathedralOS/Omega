// The selected cleanup application retains code == 7 and its exclusive output reference through transport, then writes 7 to the original backing exactly once.
// Place: target_body. Computed static cleanup application.
// Expected exit: 0
data Counter { before: u64; value: u64; invocations: u64 in Wrapping; after: u64; }
data Keeper { output: &mut Counter; code: u64; }
domain<const Code: u64> Keeper::Held<Code> dropped by release_keeper<Code + 0> requires self.code == 7;
machine release_keeper<const Code: u64>(keeper: &mut Keeper) requires keeper.code == 7 {
    keeper.output.value = Code;
    keeper.output.invocations = keeper.output.invocations + 1;
}
machine observe(keeper: &Keeper in Held<7>) {}
machine consume(keeper: Keeper in Held<7>) {}
machine check(output: &Counter, wanted: u64) crashes Trap {
    transition output.before == 317 && output.after == 929 && output.value == 7 && output.invocations == wanted {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedConsume {
    machine consume(keeper: Keeper in Held<7>)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires keeper.code == 7;
}

X86Consume satisfies SelectedConsume {
    machine consume(keeper: Keeper in Held<7>)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires keeper.code == 7
    {
        SelectedBodyCheck::require_tag(17u64);

    }
}

ArmConsume satisfies SelectedConsume {
    machine consume(keeper: Keeper in Held<7>)
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires keeper.code == 7
    {
        SelectedBodyCheck::require_tag(29u64);

    }
}


machine exercise(output: &mut Counter, flag: bool, wanted_tag: u64) crashes Trap {
    SelectedConsume::consume(Keeper { output: output, code: 6 });
}
machine main() crashes Trap {
    let mut first: Counter = Counter { before: 317, value: 93, invocations: 0, after: 929 };
    exercise(&mut first, true, 11);
    check(&first, 1);
    let mut second: Counter = Counter { before: 317, value: 84, invocations: 9, after: 929 };
    exercise(&mut second, false, 22);
    check(&second, 10);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
