machine build(builder: &mut Build) {
    Build::select_provider<SelectedSubtractTarget, CheckedSubtractTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedSubtractTarget, CheckedSubtractTarget>(builder, linux_arm64);
    Build::select_provider<SelectedSubtractTarget, CheckedSubtractTarget>(builder, macos_arm64);
    Build::select_provider<SelectedSubtractTarget, CheckedSubtractTarget>(builder, windows_x86_64);

    Build::application(builder, "signed_16bit_exact_subtraction_bound_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
