// Fact: a value live across two sequential machine calls preserves its static bound 40u64 <= saved <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: target_body. Each hosted target body preserves the bounded value across two sequential calls.
// Expected exit: 0
machine step1(x: u64) -> u64
    requires x == 10
    ensures result == 11
{
    11
}

machine step2(x: u64) -> u64
    requires x == 11
    ensures result == 12
{
    12
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(saved: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires saved >= 39 && saved <= 80;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(saved: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires saved >= 39 && saved <= 80
    {
        SelectedBodyCheck::require_tag(17u64);
        let c1: u64 = step1(10);
        let c2: u64 = step2(c1);
        let res: u64 = saved;
        let head: u64 = 80 - res;
        let underflow: u64 = res - 40;
        transition head + underflow == 40 && c2 == 12 {
            true -> done()
            _ -> bad()
        }
        machine done() -> i32 { 0 }
        machine bad() -> i32 { 1 }
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(saved: u64) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires saved >= 39 && saved <= 80
    {
        SelectedBodyCheck::require_tag(29u64);
        let c1: u64 = step1(10);
        let c2: u64 = step2(c1);
        let res: u64 = saved;
        let head: u64 = 80 - res;
        let underflow: u64 = res - 40;
        transition head + underflow == 40 && c2 == 12 {
            true -> done()
            _ -> bad()
        }
        machine done() -> i32 { 0 }
        machine bad() -> i32 { 1 }
    }
}









machine evaluate() -> i32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(39)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let outcome: i32 = evaluate();
    transition outcome == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}


machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
