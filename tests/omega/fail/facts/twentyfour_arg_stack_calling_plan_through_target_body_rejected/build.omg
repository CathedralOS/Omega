machine build(builder: &mut Build) {
    Build::select_provider<SelectedEvaluate24, CheckedEvaluate24>(builder, linux_x86_64);
    Build::select_provider<SelectedEvaluate24, CheckedEvaluate24>(builder, linux_arm64);
    Build::select_provider<SelectedEvaluate24, CheckedEvaluate24>(builder, macos_arm64);
    Build::select_provider<SelectedEvaluate24, CheckedEvaluate24>(builder, windows_x86_64);

    Build::application(builder, "twentyfour_arg_stack_calling_plan_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
