// Fact: a runtime dyn trait selector dispatches an inline conformance member over explicit data arguments to establish 100u64 when subtracting 100u64.
// Place: another machine (invalid twin). The right operand violates the required combine contract.
// Expected exit: 0

trait WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
}

UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        left + right
    }
}

machine forward(selector: dyn WeightedCombine, left: u64, right: u64) -> u64
requires left >= 60u64 && left <= 60u64
requires right >= 39u64 && right <= 39u64
ensures result >= 100u64 && result <= 100u64
{
    WeightedCombine::combine(selector, left, right)
}

machine probe(a: u64, b: u64) -> u64
requires a >= 60u64 && a <= 60u64
requires b >= 39u64 && b <= 39u64
ensures result >= 100u64 && result <= 100u64
{
    let selector: dyn WeightedCombine = UnitCombine as dyn WeightedCombine;
    forward(selector, a, b)
}

machine main() crashes Trap {
    let total: u64 = probe(60u64, 39u64);
    let diff: u64 = total - 100u64;
    transition diff == 0u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
