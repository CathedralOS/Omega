// Fact: an 8-bit unsigned u8 division of bounded inputs (dividend >= 120u8 && dividend <= 120u8, divisor >= 4u8 && divisor <= 4u8) establishes quotient >= 30u8 && quotient <= 30u8 so exact 8-bit subtraction quotient - 30u8 is proved underflow-free across all nine places.
// Place: const name. The bounds and quotient limits reference declared symbolic constants.
// Invalid control: divisor upper bound widened to 5u8, allowing quotient as low as 24u8 and failing subtraction quotient - 30u8.
// Expected rejection: may overflow `u8`

const DIVIDEND_VAL: u8 = 120u8;
const DIVISOR_VAL: u8 = 4u8;
const DIVISOR_MAX: u8 = 5u8;
const QUOTIENT_BOUND: u8 = 30u8;

machine divide_const(dividend: u8, divisor: u8) -> i32
    requires dividend >= DIVIDEND_VAL && dividend <= DIVIDEND_VAL;
    requires divisor >= DIVISOR_VAL && divisor <= DIVISOR_MAX;
{
    let quotient: u8 = dividend / divisor;
    let check: u8 = quotient - QUOTIENT_BOUND;
    transition quotient == QUOTIENT_BOUND && check == 0u8 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = divide_const(120u8, 4u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
