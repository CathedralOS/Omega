// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Place: const_name.
// Expected exit: 0
data Counter { value: bool; }
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy]
where view.bytes.len == Count
{ view: View<'storage>; }
machine end_and_reset(start: &mut u64) -> u64
ensures result == 8, start == 0
{ start = 0; 8 }
machine snapshot<'storage>(source: View<'storage>, start: u64, end: u64, counter: &mut Counter) -> Counted<'storage, (end - start)>
requires start <= end && end <= source.bytes.len
{ counter.value = !counter.value; Counted { view: View { bytes: &source.bytes[start..end], sibling: source.sibling } } }
trait Counting {
    machine snapshot<'storage>(source: View<'storage>, start: u64, end: u64, counter: &mut Counter) -> Counted<'storage, (end - start)>
    requires start <= end && end <= source.bytes.len;
}
Direct satisfies Counting {
    machine snapshot<'storage>(source: View<'storage>, start: u64, end: u64, counter: &mut Counter) -> Counted<'storage, (end - start)>
    requires start <= end && end <= source.bytes.len
    { counter.value = !counter.value; Counted { view: View { bytes: &source.bytes[start..end], sibling: source.sibling } } }
}
machine overwrite<'storage>(slot: &mut View<'storage>) -> u64 { slot.bytes = "123456789"; 0 }
machine seven(value: u64) -> u64 requires value == 7 ensures result == 7 { value }
const REQUIRED_LENGTH: u64 = 7;
machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
ensures result == 7
{ let saved: Counted<'storage, REQUIRED_LENGTH> = selected; seven(saved.view.bytes.len) }
machine receive_inferred<'storage, Count: u64>(selected: Counted<'storage, Count>, ignored: u64) -> u64
requires Count == 7
ensures result == 7
{ receive(selected, ignored) }
machine main() crashes Trap {
    let storage: [u8; 9] = [11, 12, 49, 50, 51, 52, 53, 54, 55];
    let mut direct_counter: Counter = Counter { value: false };
    let mut direct: View = View { bytes: &storage[..], sibling: "tail" };
    let mut direct_start: u64 = 2;
    let observed: u64 = receive_inferred(snapshot(direct, direct_start, end_and_reset(&mut direct_start), &mut direct_counter), overwrite(&mut direct));
    let difference: u64 = observed - 7;
    let mut public_counter: Counter = Counter { value: false };
    let mut public: View = View { bytes: &storage[..], sibling: "tail" };
    let mut public_start: u64 = 2;
    let public_observed: u64 = receive_inferred(Counting::snapshot(Direct as dyn Counting, public, public_start, end_and_reset(&mut public_start), &mut public_counter), overwrite(&mut public));
    let public_difference: u64 = public_observed - 7;
    transition direct_start == 0 && public_start == 0 && direct_counter.value && public_counter.value && difference == 0 && public_difference == 0 && direct.bytes.len == 9 && public.bytes.len == 9 && direct.sibling.len == 4 && public.sibling.len == 4 {
        true -> done() false -> wrong()
    }
    state done() {} state wrong() { crash Trap; }
}
