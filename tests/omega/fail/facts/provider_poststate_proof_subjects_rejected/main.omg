public data ProofNat { case Zero; case More(previous: ProofNat); }
public trait Bounds {
    machine keep(first: ProofNat, second: ProofNat)
    requires first == ProofNat::Zero
    ensures second == ProofNat::Zero;
}
Direct satisfies Bounds {
    machine keep(first: ProofNat, second: ProofNat)
    requires first == ProofNat::Zero
    ensures first == ProofNat::Zero
    {}
}
machine main() {}
