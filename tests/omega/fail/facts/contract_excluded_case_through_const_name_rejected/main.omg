// A generic extractor whose contract states `T == i32` (or `T == bool`) owes no arm for the case whose default domain states the other type, so `extract_int` lists only `Integer` and `extract_flag` only `Boolean`: they return `7` and `9` from `Value<i32>`, `true` and `false` from `Value<bool>`.
// Expected error: match does not cover its subject
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine extract_int<T>(v: Value<T>) -> T {
    match v {
        Value::Integer { value } -> value
    }
}
machine extract_flag<T>(v: Value<T>) -> T requires T == bool {
    match v {
        Value::Boolean { value } -> value
    }
}
const SEVEN: i32 = 7;
const NINE: i32 = 9;
const MARKED: bool = true;
const CLEARED: bool = false;
machine main() crashes Trap {
    let number: Value<i32> = Value::Integer { value: SEVEN };
    let other_number: Value<i32> = Value::Integer { value: NINE };
    let flag: Value<bool> = Value::Boolean { value: MARKED };
    let other_flag: Value<bool> = Value::Boolean { value: CLEARED };
    transition extract_int(number) == SEVEN && extract_int(other_number) == NINE
        && extract_flag(flag) == MARKED && extract_flag(other_flag) == CLEARED {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
