// Fact: a static index bound idx < 8u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 8].
// Place: call_result. The index arrives from a helper call with an ensures result < 8 contract.
// Expected exit: 0
machine supply_index(index: u64) -> u64
requires index <= 8
ensures result <= 8
{
    index
}

machine read_element(values: [u64; 8], index: u64) -> u64
requires index <= 8
{
    let picked_index: u64 = supply_index(index);
    values[picked_index]
}

machine main() crashes Trap {
    let arr: [u64; 8] = [10, 20, 30, 40, 50, 60, 70, 80];
    let elem: u64 = read_element(arr, 5);
    transition elem == 60 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
