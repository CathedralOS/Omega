// Fact: a slice view (&[u64]) whose length is guarded (view.len >= 3u64) proves safe indexed element read at view[2u64] and preserves the length lower bound to discharge exact subtraction view.len - 3u64 across all nine places.
// Place: another machine (invalid twin). Reading index 3 exceeds the guarded length bound of 3 elements.
// Expected diagnostic: slice index out of bounds

use omega::language::core::slice;

machine target_reader(view: &[u64]) -> i32
    requires view.len >= 3
{
    let elem: u64 = view[3];
    let diff: u64 = view.len - 3u64;
    transition elem == 30u64 && diff == 1u64 {
        true -> done()
        _ -> bad()
    }
    machine done() -> i32 { 0 }
    machine bad() -> i32 { crash Trap; }
}

machine forwarder(view: &[u64]) -> i32
    requires view.len >= 3
{
    target_reader(view)
}

machine main() crashes Trap {
    let items: [u64; 4] = [10u64, 20u64, 30u64, 40u64];
    let view: &[u64] = &items[..];
    let res: i32 = forwarder(view);
    transition res == 0 {
        true -> pass()
        _ -> fail()
    }
    machine pass() {}
    machine fail() { crash Trap; }
}
