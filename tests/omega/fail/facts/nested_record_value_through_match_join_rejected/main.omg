// A nested record Envelope preserves its inner Header bound header.limit <= 50 and sibling payload across value transport so header.limit + payload <= 100 in all nine places.
// Invalid: match join does not guarantee header.limit <= 50, so header.limit + payload may overflow u64.
// Expected exit: 0

data Header [copy] {
    tag: u64;
    limit: u64;
}

data Envelope [copy] {
    header: Header;
    payload: u64;
}

machine choose(first: Envelope, second: Envelope, choose_first: bool) -> Envelope
requires first.header.limit <= 50 && first.payload <= 50
    && second.payload <= 50
    && first.header.tag == 7 && second.header.tag == 7
ensures result.payload <= 50 && result.header.tag == 7
{
    match choose_first {
        true -> first
        false -> second
    }
}

machine sum_envelope(first: Envelope, second: Envelope, choose_first: bool) -> u64
requires first.header.limit <= 50 && first.payload <= 50
    && second.header.limit <= 50 && second.payload <= 50
    && first.header.tag == 7 && second.header.tag == 7
ensures result <= 100
{
    let selected: Envelope = choose(first, second, choose_first);
    selected.header.limit + selected.payload
}

machine probe(first: Envelope, second: Envelope, choose_first: bool) -> u64
requires first.header.limit <= 50 && first.payload <= 50
    && second.header.limit <= 50 && second.payload <= 50
    && first.header.tag == 7 && second.header.tag == 7
ensures result <= 100
{
    sum_envelope(first, second, choose_first)
}

machine main() crashes Trap {
    let first: Envelope = Envelope {
        header: Header { tag: 7, limit: 20 },
        payload: 22,
    };
    let second: Envelope = Envelope {
        header: Header { tag: 7, limit: 20 },
        payload: 22,
    };
    let sum1: u64 = probe(first, second, true);
    let sum2: u64 = probe(first, second, false);
    transition first.header.tag == 7 && sum1 == 42 && sum2 == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
