// Fact: a value live across six sequential machine calls preserves its static bound 40u64 <= saved <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Place: another target body. Each hosted target body preserves the bounded value across six sequential calls.
// Expected exit: 0
machine step1(x: u64) -> u64
    requires x == 10
    ensures result == 11
{
    11
}

machine step2(x: u64) -> u64
    requires x == 11
    ensures result == 12
{
    12
}

machine step3(x: u64) -> u64
    requires x == 12
    ensures result == 13
{
    13
}

machine step4(x: u64) -> u64
    requires x == 13
    ensures result == 14
{
    14
}

machine step5(x: u64) -> u64
    requires x == 14
    ensures result == 15
{
    15
}

machine step6(x: u64) -> u64
    requires x == 15
    ensures result == 16
{
    16
}

linux_x86_64 machine compute_target_body(saved: u64) -> i32
    requires saved >= 39 && saved <= 80
{
    let c1: u64 = step1(10);
    let c2: u64 = step2(c1);
    let c3: u64 = step3(c2);
    let c4: u64 = step4(c3);
    let c5: u64 = step5(c4);
    let c6: u64 = step6(c5);
    let res: u64 = saved;
    let head: u64 = 80 - res;
    let underflow: u64 = res - 40;
    transition head + underflow == 40 && c6 == 16 {
        true -> done()
        _ -> bad()
    }
    state done() -> i32 { 0 }
    state bad() -> i32 { 1 }
}

