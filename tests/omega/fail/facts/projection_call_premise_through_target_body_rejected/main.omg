// A call precondition is a projection term. The call records that
// projection fact, and the caller reads the record.
// Place: target_body.
// Expected exit: 0
data Mark [copy] { kept: bool; }

machine project(mark: Mark) -> bool
requires mark.kept
{
    mark.kept
}

machine hold(direct: bool) -> bool
requires direct == true
{
    true
}

boundary trait SelectedObserve {
    machine observe() -> bool reaches
;
}
CheckedObserve satisfies SelectedObserve {
    machine observe() -> bool
{
    let mark: Mark = Mark { kept: false };
    let direct: bool = project(mark);
    hold(direct)
}
}







machine main() crashes Trap {
    transition SelectedObserve::observe() {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
