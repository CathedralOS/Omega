// Invalid: a machine binder cannot become a same-named global result data type.
data Callback [copy] { value: u64; }
machine marker() -> u64 { 7 }
machine selected<Length [copy], machine Callback, const Capacity: u64>(items: Length) -> Callback
where machine Callback() -> u64;
where Length == [u8; Capacity]
{ Callback { value: Capacity } }
machine main() {
    let items: [u8; 2] = [7, 11];
    let observed: Callback = selected<[u8; 2], marker>(items);
}
