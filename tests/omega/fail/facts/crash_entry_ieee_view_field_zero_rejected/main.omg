// Control: an entry integer proved equal to 0 makes maybe_zero's 0.0 Trap route live.
machine maybe_zero(value: f32) -> f32
crashes Trap value == 0.0
{
    transition value == 0.0 { true -> bad() false -> (value) }
    machine bad() -> f32 { crash Trap; }
}
public data Packet { bits: i32; marker: i32; }
public machine read_bits(packet: &Packet) -> f32
requires packet.bits == 0
{
    let view: &f32 = &packet.bits as &f32;
    let observed: f32 = view;
    maybe_zero(observed)
}
machine main() crashes Trap {
    let packet: Packet = Packet { bits: 0, marker: 11 };
    let observed: f32 = read_bits(&packet);
    transition observed == 1.0 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
