// A call that may change the array must invalidate its saved terminator guarantee.
boundary trait Text {
    machine change<const Count: u64>(text: &mut [u8; Count]) -> u64 reaches;
    machine length<const Count: u64>(text: &[u8; Count]) -> u64
    requires Count > 0
    requires text[Count - 1] == 0
    reaches;
}
machine forward<const Extent: u64>(title: &mut [u8; Extent]) -> u64
requires Extent > 0
requires title[Extent - 1] == 0
reaches Text
{
    let ignored: u64 = Text::change<Extent>(title);
    Text::length<Extent>(title)
}
