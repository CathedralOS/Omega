// Fact: a 16-bit unsigned u16 exact multiplication of bounded inputs (lhs >= 20u16 && lhs <= 30u16, rhs >= 15u16 && rhs <= 25u16) establishes prod >= 300u16 && prod <= 750u16 so exact 16-bit subtractions 750u16 - prod and prod - 300u16 are proved overflow-free across all nine places.
// Invalid: rhs upper bound widened to 26u16 so prod can reach 780u16, overflowing 750u16 - prod.
// Expected exit: 0

machine mul_local(lhs: u16, rhs: u16) -> u16
requires lhs >= 20 && lhs <= 30 && rhs >= 15 && rhs <= 26
{
    let local_lhs: u16 = lhs;
    let local_rhs: u16 = rhs;
    let prod: u16 = local_lhs * local_rhs;
    let headroom: u16 = 750u16 - prod;
    let margin: u16 = prod - 300u16;
    headroom + margin
}

machine probe() -> u16 {
    mul_local(25u16, 20u16)
}

machine main() crashes Trap {
    transition probe() == 450 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
