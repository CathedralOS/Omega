machine build(builder: &mut Build) {
    Build::select_provider<SelectedWritten, CheckedWritten>(builder, macos_arm64);
    Build::select_provider<SelectedWritten, CheckedWritten>(builder, linux_x86_64);
    Build::select_provider<SelectedWritten, CheckedWritten>(builder, linux_arm64);
    Build::select_provider<SelectedWritten, CheckedWritten>(builder, windows_x86_64);

    Build::application(builder, "installed_entry_storage_target_body_invalid");
    Build::bind(builder, macos_arm64::ProgramEntry, start);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
    Build::bind(builder, linux_arm64::ProgramEntry, start);
    Build::bind(builder, windows_x86_64::ProgramEntry, start);
}
