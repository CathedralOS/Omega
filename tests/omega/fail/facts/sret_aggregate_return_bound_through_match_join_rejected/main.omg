// Fact: returning a 24-byte three-field structural record (Triple { a: u64, b: u64, c: u64 }) through an indirect sret aggregate return slot preserves its postcondition bound (result.c <= 90u64), discharging exact subtraction 90u64 - result.c across all nine places.
// Invalid: c field is 91u64 exceeding 90u64 bound, so 90u64 - c underflows. Place: match_join.
// Expected diagnostic: may overflow `u64`

data Triple [copy] where
    a >= 20u64 && a <= 20u64,
    b >= 30u64 && b <= 30u64,
    c >= 91u64 && c <= 91u64
{
    a: u64;
    b: u64;
    c: u64;
}

machine make_triple() -> Triple
ensures result.c >= 91u64 && result.c <= 91u64
{
    Triple {
        a: 20,
        b: 30,
        c: 91,
    }
}

machine make_triple_true() -> Triple
ensures result.c >= 91u64 && result.c <= 91u64
{
    Triple {
        a: 20,
        b: 30,
        c: 91,
    }
}

machine make_triple_false() -> Triple
ensures result.c >= 91u64 && result.c <= 91u64
{
    Triple {
        a: 20,
        b: 30,
        c: 91,
    }
}

machine probe(flag: bool) -> u64
{
    let t: Triple = match flag {
        true -> make_triple_true(),
        false -> make_triple_false(),
    };
    let remaining: u64 = 90u64 - t.c;
    let sum_ab: u64 = t.a + t.b;
    remaining - sum_ab
}

machine main() crashes Trap {
    transition probe(true) == 0 && probe(false) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
