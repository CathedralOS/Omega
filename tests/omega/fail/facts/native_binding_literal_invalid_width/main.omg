// Expected exit: 0
domain u8::Small requires self < 16;
data Packet[copy] { bytes: [u8; 2]; }
machine produce() -> Packet { Packet { bytes: "\x07" } }
machine main() crashes Trap {
 let packet: Packet = produce();
 transition packet.bytes[0] == 7 { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
