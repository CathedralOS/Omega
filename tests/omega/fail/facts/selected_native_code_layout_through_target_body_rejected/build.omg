machine build(builder: &mut Build) {
    Build::select_provider<SelectedTargetWitness, CheckedTargetWitness>(builder, linux_x86_64);
    Build::select_provider<SelectedTargetWitness, CheckedTargetWitness>(builder, linux_arm64);
    Build::select_provider<SelectedTargetWitness, CheckedTargetWitness>(builder, macos_arm64);
    Build::select_provider<SelectedTargetWitness, CheckedTargetWitness>(builder, windows_x86_64);

    Build::application(builder, "invalid_selected_native_code_layout_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
