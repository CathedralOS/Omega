// Every target body uses a runtime count to index a byte view.
// Rejected: every body receives count == items.len, so `Index < items.len`
// cannot be discharged at read_at.
linux_x86_64 machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

linux_arm64 machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

macos_arm64 machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

windows_x86_64 machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

machine main() crashes Trap {
    let bytes: [u8; 4] = [9, 8, 7, 6];
    let count: u32 = 4;
    transition read_at<count>(&bytes[..]) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
