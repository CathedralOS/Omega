// A scalar store of zero through the u32 view restores Pair.start and its mixed parent predicate before returning the parent.
// Expected exit: 0
public data Pair [copy]
requires self.start >= 0 && self.start <= self.end,
{
    before: u32;
    start: i32;
    end: i32;
    after: u32;
    marker: u32;
    origin: u32;
}
public data Envelope [copy] { case Some(pair: Pair); case None; }
machine forward<'storage>(view: &'storage mut u32, marker: &mut u32) -> &'storage mut u32 { marker = 19; view = 0xFFFFFFFFu32; view }
public machine inspect(outer: &mut Envelope)
requires outer in Envelope::Some, outer.pair.start >= 0, outer.pair.start <= outer.pair.end,
{
    let replacement: u32 = 0u32;
    outer.pair.marker = 11;
    let formed: &mut u32 = &mut outer.pair.start as &mut u32;
    let view: &mut u32 = forward(formed, &mut outer.pair.marker);
    view = 0xFFFFFFFFu32;
    view = replacement;
    outer.pair.end = 10;
}
machine main() crashes Trap {
    let mut first: Envelope = Envelope::Some { pair: Pair { before: 0x13579BDF, start: 3, end: 10, after: 0x2468ACE0, marker: 0, origin: 11 } };
    inspect(&mut first);
    let mut second: Envelope = Envelope::Some { pair: Pair { before: 0x13579BDF, start: 5, end: 10, after: 0x2468ACE0, marker: 0, origin: 13 } };
    inspect(&mut second);
    transition first.pair.start == 0 && first.pair.end == 10 && first.pair.marker == 19 && first.pair.origin == 11
        && second.pair.start == 0 && second.pair.end == 10 && second.pair.marker == 19 && second.pair.origin == 13
        && first.pair.before == 0x13579BDF && first.pair.after == 0x2468ACE0
        && second.pair.before == 0x13579BDF && second.pair.after == 0x2468ACE0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
