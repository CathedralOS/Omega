// Case Point(lo, hi) where lo == hi makes hi - lo exact in u64, without a guard or Wrapping.
// Expected exit: 0
// Case `where` equality bounds: `Interval::Point { lo, hi }` with
// `where lo == hi` contributes the equality into the destructured
// arm — `hi - lo` cannot underflow there, so the subtraction
// discharges without a guard or Wrapping domain.
//
//   * `case Point(lo: u64, hi: u64) where lo == hi` — payload
//     equality gate.
//   * `main.width = hi - lo` — exact subtraction proven by the
//     arm's contributed equality.
//   * `hits` records the reached arm.

data Interval
    requires (self in Interval::Empty) || ((self in Interval::Point))
{
    case Empty;
    case Point(lo: u64, hi: u64);
}

data Main {
    interval: Interval;
    left_guard: u64; width: u64; right_guard: u64;
    hits: i32 in Wrapping;
}

machine run_main(main: &mut Main) crashes Trap {
    main.hits = 0;
    main.width = 99;
    main.interval = Interval::Point { lo: 17, hi: 17 };
    guarded_width(main);
}

machine guarded_width(main: &mut Main) crashes Trap {

    transition main.interval {
        Interval::Point { lo, hi } -> take(lo, hi, main)
        Interval::Empty -> fail(main)
    }
    machine take(lo: u64, hi: u64, main: &mut Main) {
        main.width = hi - lo;
        transition main.width == 0 {
            true -> pass(main)
            _ -> fail(main)
        }
    }
    machine pass(main: &mut Main) { main.hits = 1; }
    machine fail(main: &mut Main) { main.hits = -1; crash Trap; }
}


// Observe the caller's original home and adjacent cells after return.
machine entry_start() crashes Trap {
    let mut entry_storage: Main = Main { interval: Interval::Empty {}, left_guard: 101, width: 99, right_guard: 107, hits: 31 };
    run_main(&mut entry_storage);
    transition entry_storage.width == 0 && entry_storage.left_guard == 101 && entry_storage.right_guard == 107 && entry_storage.hits == 1 {
        true -> observed()
        false -> writeback_failed()
    }
    machine observed() {}
    machine writeback_failed() { crash Trap; }
}
