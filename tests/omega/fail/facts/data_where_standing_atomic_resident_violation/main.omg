// Expected rejection: the atomic resident must be valid after every store.
// Restoring 99 later cannot excuse publishing 101 through shared atomic access.
public data Cell requires self.value <= 100 { value: AtomicU32; }
public machine overwrite(cell: &Cell) {
    cell.value.store(101, NoOrdering);
    cell.value.store(99, NoOrdering);
}
machine main() {
    let cell: Cell;
    overwrite(&cell);
}
