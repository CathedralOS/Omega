// A write through a returned reference must invalidate the original array's terminator.
boundary trait Text {
    machine borrow<'a, const Input: u64, const Output: u64>(text: &'a mut [u8; Input]) -> &'a mut [u8; Output] reaches;
    machine change<const Count: u64>(text: &mut [u8; Count]) -> u64 reaches;
    machine length<const Count: u64>(text: &[u8; Count]) -> u64
    requires Count > 0
    requires text[Count - 1] == 0
    reaches;
}
machine forward<const Extent: u64>(title: &mut [u8; Extent]) -> u64
requires Extent > 0
requires title[Extent - 1] == 0
reaches Text
{
    let ignored: u64 = Text::change<Extent>(Text::borrow<Extent, Extent>(title));
    Text::length<Extent>(title)
}
