// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
public trait ReadContract { machine read() -> u64 reaches Mark invokes Mark; }
public machine read_service() -> u64 satisfies ReadContract::read invokes Mark; { Mark::read() }
machine call_mark<machine Read>() -> u64
where machine Read satisfies ReadContract::read;
{ Read() }

data Hold { value: u64; }
machine main() reaches crashes Trap {
    let hold: Hold = Hold { value: call_mark<read_service>() };
    transition hold.value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
