// Fact: adding two bounded 16-bit unsigned u16 values (lhs >= 100u16 && lhs <= 200u16 and rhs >= 150u16 && rhs <= 300u16) establishes the exact post-addition interval (sum >= 250u16 && sum <= 500u16), discharging both 500u16 - sum and sum - 250u16 across all nine places.
// Invalid: rhs upper bound widened to 301u16 so sum reaches 501u16, overflowing 500u16 - sum.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedComputeTarget {
    machine compute_target(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 301;
}

X86ComputeTarget satisfies SelectedComputeTarget {
    machine compute_target(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 301
    {
        SelectedBodyCheck::require_tag(17u64);
        let sum: u16 = lhs + rhs;
        let headroom: u16 = 500u16 - sum;
        let margin: u16 = sum - 250u16;
        headroom + margin
    }
}

ArmComputeTarget satisfies SelectedComputeTarget {
    machine compute_target(lhs: u16, rhs: u16) -> u16
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires lhs >= 100 && lhs <= 200 && rhs >= 150 && rhs <= 301
    {
        SelectedBodyCheck::require_tag(29u64);
        let sum: u16 = lhs + rhs;
        let headroom: u16 = 500u16 - sum;
        let margin: u16 = sum - 250u16;
        headroom + margin
    }
}

machine probe() -> u16 {
    SelectedComputeTarget::compute_target(150u16, 200u16)
}

machine main() crashes Trap {
    transition probe() == 250 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
