// A call inside a generic abstract signature is the premise under the exact
// type actual. The signature records that call's result, and the caller reads
// the record.
// Place: target_body.
// Expected exit: 0
machine premise<T>(kept: T) -> bool {
    false
}

machine hold(direct: bool) -> bool
requires direct == true
{
    direct
}

machine witness<T>(kept: T) -> bool
requires premise<T>(kept)
{
    premise<T>(kept)
}

machine apply<T, machine Observe>(kept: T) -> bool
requires machine Observe(kept: T) -> bool
requires premise<T>(kept);
requires premise<T>(kept)
{
    Observe(kept)
}

linux_x86_64 machine observe() -> bool {
    let kept: bool = true;
    let direct: bool = apply<bool, witness<bool>>(kept);
    hold(direct)
}

linux_arm64 machine observe() -> bool {
    let kept: bool = true;
    let direct: bool = apply<bool, witness<bool>>(kept);
    hold(direct)
}

macos_arm64 machine observe() -> bool {
    let kept: bool = true;
    let direct: bool = apply<bool, witness<bool>>(kept);
    hold(direct)
}

macos_x86_64 machine observe() -> bool {
    let kept: bool = true;
    let direct: bool = apply<bool, witness<bool>>(kept);
    hold(direct)
}

windows_x86_64 machine observe() -> bool {
    let kept: bool = true;
    let direct: bool = apply<bool, witness<bool>>(kept);
    hold(direct)
}

machine main() crashes Trap {
    transition observe() {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
