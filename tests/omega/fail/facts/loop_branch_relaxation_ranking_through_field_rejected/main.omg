// Fact: a ranked multi-state countdown loop across a wide conditional branch span establishes an exact 100u64 accumulator bound when subtracting 100u64.
// Expected diagnostic: exact subtraction underflow

machine loop_calc(remaining: u64, accumulated: u64) -> u64
requires remaining <= 10 && accumulated == 99
terminates by remaining;
ensures result >= 99 && result <= 99
{
    transition remaining > 0 {
        true -> step_a(remaining, accumulated)
        false -> done(accumulated)
    }

    machine step_a(rem: u64, acc: u64) -> u64
    requires rem <= 10 && rem > 0 && acc == 99
    {
        let a1: u64 = acc + 1;
        let a2: u64 = a1 + 1;
        let a3: u64 = a2 + 1;
        let a4: u64 = a3 + 1;
        let a5: u64 = a4 + 1;
        let a6: u64 = a5 + 1;
        let a7: u64 = a6 + 1;
        let a8: u64 = a7 + 1;
        let a9: u64 = a8 + 1;
        let a10: u64 = a9 + 1;
        let a11: u64 = a10 + 1;
        let a12: u64 = a11 + 1;
        let s1: u64 = a12 - 1;
        let s2: u64 = s1 - 1;
        let s3: u64 = s2 - 1;
        let s4: u64 = s3 - 1;
        let s5: u64 = s4 - 1;
        let s6: u64 = s5 - 1;
        let s7: u64 = s6 - 1;
        let s8: u64 = s7 - 1;
        let s9: u64 = s8 - 1;
        let s10: u64 = s9 - 1;
        let s11: u64 = s10 - 1;
        let s12: u64 = s11 - 1;
        transition rem > 1 {
            true -> step_b(rem - 1, s12)
            false -> done(s12)
        }
    }

    machine step_b(rem: u64, acc: u64) -> u64
    requires rem <= 9 && rem > 0 && acc == 99
    {
        let b1: u64 = acc + 1;
        let b2: u64 = b1 + 1;
        let b3: u64 = b2 + 1;
        let b4: u64 = b3 + 1;
        let b5: u64 = b4 + 1;
        let b6: u64 = b5 + 1;
        let b7: u64 = b6 + 1;
        let b8: u64 = b7 + 1;
        let b9: u64 = b8 + 1;
        let b10: u64 = b9 + 1;
        let b11: u64 = b10 + 1;
        let b12: u64 = b11 + 1;
        let t1: u64 = b12 - 1;
        let t2: u64 = t1 - 1;
        let t3: u64 = t2 - 1;
        let t4: u64 = t3 - 1;
        let t5: u64 = t4 - 1;
        let t6: u64 = t5 - 1;
        let t7: u64 = t6 - 1;
        let t8: u64 = t7 - 1;
        let t9: u64 = t8 - 1;
        let t10: u64 = t9 - 1;
        let t11: u64 = t10 - 1;
        let t12: u64 = t11 - 1;
        transition rem > 1 {
            true -> step_a(rem - 1, t12)
            false -> done(t12)
        }
    }

    machine done(acc: u64) -> u64
    requires acc == 99
    {
        acc
    }
}

data TotalCarrier {
    total: u64;
}

machine evaluate(carrier: TotalCarrier) -> u64
requires carrier.total >= 99 && carrier.total <= 99
ensures result == 0
{
    carrier.total - 100
}

machine main() crashes Trap {
    let res: u64 = loop_calc(10, 99);
    let carrier: TotalCarrier = TotalCarrier { total: res };
    let diff: u64 = evaluate(carrier);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
