// Expected exit: 0
data Carrier<'storage> { marker: i32; reference: &'storage i32; }
domain Carrier::Ready(carrier) requires carrier.marker == 41;
machine inspect<'storage>(carrier: Carrier<'storage>) -> i32
requires carrier.marker == 41
{
    let qualified: Carrier<'storage> in Ready = carrier;
    let stale: i32 = carrier.reference;
    qualified.reference
}
machine main() crashes Trap {
    let backing: i32 = 42;
    let raw: Carrier = Carrier { marker: 41, reference: &backing };
    let observed: i32 = inspect(raw);
    transition observed == 42 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
