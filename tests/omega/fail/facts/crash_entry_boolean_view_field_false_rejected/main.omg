// Control: an entry byte proved equal to 0 makes maybe_clear's false Trap route live.
machine maybe_clear(value: bool) -> bool
crashes Trap value == false
{
    transition value == false { true -> bad() false -> (value) }
    machine bad() -> bool { crash Trap; }
}
public data Byte where value >= 0 && value <= 1 { value: u8; }
public data Packet { flag: Byte; marker: u64; }
public machine read_flag(packet: &Packet) -> bool
requires packet.flag.value == 0
{
    let view: &bool = &packet.flag.value as &bool;
    let observed: bool = view;
    maybe_clear(observed)
}
machine main() crashes Trap {
    let packet: Packet = Packet { flag: Byte { value: 0 }, marker: 11 };
    let observed: bool = read_flag(&packet);
    transition observed == true { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
