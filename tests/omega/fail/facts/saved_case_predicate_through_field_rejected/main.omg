// A saved case verdict selects the same unwritten case payload after a disjoint case replacement.
// Expected exit: 0
domain u64::Divisor(value) requires value > 0;
data Choice [copy] { case Empty; case Full(amount: u64 in Divisor); }
machine clear(destination: &mut Choice) { destination = Choice::Empty; }
machine capture<'storage, Value>(choice: Value, other: &mut Choice) -> Value where Value == &'storage mut Choice { clear(other); choice }
data Holder { before: u64; choice: Choice; other: Choice; after: u64; }
machine probe(input: Choice) -> u64 {
    let mut holder: Holder = Holder { before: 11, choice: input, other: Choice::Full { amount: 7 }, after: 13 };
    let saved: bool = capture<&mut Choice>(&mut holder.choice, &mut holder.other) in Choice::Full;
    let alias: bool = saved;
    clear(&mut holder.choice);
    let ordinary: u64 = 9;
    let result: u64 = match alias { true -> 490 / holder.choice.amount false -> 0 };
    transition holder.other in Choice::Empty && holder.before == 11 && holder.after == 13 { true -> result false -> 777 }
}
machine main() crashes Trap {
    let observed: u64 = probe(Choice::Full { amount: 7 });
    let absent: u64 = probe(Choice::Empty);
    transition observed == 70 && absent == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
