// Fact: `left == right` on `f64` selects the declared operator without importing `omega::language::core::float_operations`. A copy of an `f64` is not this fact. The values are 212.0 and 2.0, so the comparison is false.
// Place: target_body. One comparison body per hosted target; the entry machine calls the selected body.
// Invalid (mixed format): the right operand's format is f32, so `left == right`
// has no declared operator and no builtin route; checking refuses.
// Expected diagnostic: builtin `==` cannot combine `f64` and `f32`
linux_x86_64 machine equal_operands(left: f64, right: f32) -> bool { left == right }
linux_arm64 machine equal_operands(left: f64, right: f32) -> bool { left == right }
macos_arm64 machine equal_operands(left: f64, right: f32) -> bool { left == right }
windows_x86_64 machine equal_operands(left: f64, right: f32) -> bool { left == right }
machine main() crashes Trap {
    let equal: bool = equal_operands(212.0, 2.0);
    transition equal { true -> bad() _ -> done() }
    state done() {}
    state bad() { crash Trap; }
}
