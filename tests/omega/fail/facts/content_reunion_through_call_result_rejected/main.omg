// One owned root may be partitioned and reconstructed from its complete live descendant claims; equal geometry alone supplies no ownership.
// Expected exit: 0
use omega::language::core::content;
use omega::language::core::drop;

data Region [linear] { base: u64; length: u64; }

domain Region::Owned established by issue;

machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat }
}

machine issue() -> Region in Owned
ensures result.base == 10, result.length == 48
{ Region { base: 10, length: 48 } }

machine Region::drop(region: &mut Region) {}

data Parts { left: Region in Owned; right: Region in Owned; }

machine rebuild_region(region: Region in Owned) -> Region in Owned
requires region.base <= 58 && region.length <= 58 - region.base
ensures result.base == region.base, result.length == region.length,
    Owned::content(old(&region)) == Owned::content(&result)
{
    let { base, length } = region;
    Region { base: base, length: length }
}

machine retire_empty_tail(left: Region in Owned, right: Region in Owned) -> Region in Owned
requires left.base <= 58 && left.length <= 58 - left.base
    && right.base == left.base + left.length && right.length == 0
ensures result.base == left.base, result.length == left.length,
    separate(Owned::content(old(&left)), Owned::content(old(&right))) == Owned::content(&result)
{
    drop(right);
    let rebuilt: Region in Owned = rebuild_region(left);
    rebuilt
}

machine finish_reunion(whole: Region in Owned) -> Region in Owned
requires whole.base == 10 && whole.length == 48
ensures result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let parts: Parts = partition(whole, 48);
    let joined: Region in Owned = retire_empty_tail(parts.left, parts.right);
    let { base, length } = joined;
    Region { base: base, length: length }
}

machine merge(left: Region in Owned, right: Region in Owned) -> Region in Owned
requires left.base <= 58 && left.length <= 58 - left.base
    && right.base == left.base + left.length && right.length <= 58 - right.base
ensures result.base == left.base, result.length == left.length + right.length,
    separate(Owned::content(old(&left)), Owned::content(old(&right))) == Owned::content(&result)
{
    let { base as left_base, length as left_length } = left;
    let { base as right_base, length as right_length } = right;
    Region { base: left_base, length: left_length + right_length }
}

machine partition(whole: Region in Owned, requested: u64) -> Parts
requires whole.base <= 58 && whole.length <= 58 - whole.base && requested <= whole.length
ensures
    result.left.base == whole.base,
    result.left.length == requested,
    result.right.length == whole.length - requested,
    result.right.base == whole.base + requested,
    Owned::content(old(&whole)) == separate(Owned::content(&result.left), Owned::content(&result.right))
{
    let { base, length } = whole;
    Parts { left: Region { base: base, length: requested },
        right: Region { base: base + requested, length: length - requested } }
}

machine rejoin(whole: Region in Owned, requested: u64) -> Region
requires whole.base == 10 && whole.length == 48 && requested <= whole.length
ensures result in Owned,
    result.base == whole.base, result.length == whole.length,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let parts: Parts = partition(issue(), requested);
    drop(whole);
    let left: Region in Owned = parts.left;
    let right: Region in Owned = parts.right;
    let joined: Region in Owned = merge(left, right);
    let finished: Region in Owned = finish_reunion(joined);
    let { base, length } = finished;
    let reunited: Region = Region { base: base, length: length };
    reunited
}

machine deliver(requested: u64) -> Region
requires requested <= 48
ensures result in Owned, result.base == 10, result.length == 48
{ rejoin(issue(), requested) }

machine exercise(requested: u64) -> bool
requires requested <= 48
{
    let reunited: Region in Owned = deliver(requested);
    let correct: bool = reunited.base == 10 && reunited.length == 48;
    drop(reunited);
    correct
}

machine main() crashes Trap {
    let empty: bool = exercise(0);
    let interior: bool = exercise(16);
    let full: bool = exercise(48);
    transition empty && interior && full { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
