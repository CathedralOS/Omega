// A parameter with no bound cannot index an array.
machine read_parameter(index: u64) -> u8 {
    let values: [u8; 3] = [7, 8, 9];
    values[index]
}
machine main() crashes Trap {
    transition read_parameter(1) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
