// Fact: an 8-bit signed i8 arithmetic right shift of a bounded input (val >= 100i8 && val <= 100i8) by 2u32 bits establishes shifted >= 25i8 && shifted <= 25i8 so exact 8-bit signed subtraction shifted - 25i8 is proved overflow-free across all nine places.
// Invalid: target bodies shift 104i8 >> 2u32 = 26i8, violating verify_shifted contract. Place: target_body.
// Expected diagnostic: cannot prove requires contract for call verify_shifted

machine verify_shifted(shifted: i8) -> i32
requires shifted >= 25i8 && shifted <= 25i8
{
    let check: i8 = shifted - 25i8;
    0i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86VerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let val: i8 = 104i8;
        let shift: u32 = 2u32;
        let shifted: i8 = val >> shift;
        verify_shifted(shifted)
    }
}

ArmVerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let val: i8 = 104i8;
        let shift: u32 = 2u32;
        let shifted: i8 = val >> shift;
        verify_shifted(shifted)
    }
}

machine probe() -> i32 {
    SelectedVerifyTarget::verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
