// A const name outside the array length cannot index.
const SLOT: u64 = 3;
machine read_const() -> u8 {
    let values: [u8; 3] = [7, 8, 9];
    values[SLOT]
}
machine main() crashes Trap {
    transition read_const() == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
