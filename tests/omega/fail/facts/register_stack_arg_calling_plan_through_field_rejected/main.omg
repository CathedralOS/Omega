// Fact: passing seven bounded integer arguments (`a1` through `a7` with `a7 <= 85u64`) across register and stack ABI slots preserves the stack-passed argument's static bound (`a7 <= 85u64`), discharging exact subtraction `85u64 - a7` across all nine places.
// Place: field (invalid twin).
// Expected diagnostic: exact subtraction underflow

data SevenArgs where
    f1 == 10u64, f2 == 20u64, f3 == 30u64, f4 == 40u64, f5 == 50u64,
    f6 == 60u64, f7 == 86u64
{
    f1: u64;
    f2: u64;
    f3: u64;
    f4: u64;
    f5: u64;
    f6: u64;
    f7: u64;
}

machine calling_plan_seven(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
ensures
    result <= 86u64 && result == a7
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    (prefix - 210) + a7
}

machine probe(args: SevenArgs) -> u64 {
    let val: u64 = calling_plan_seven(
        args.f1, args.f2, args.f3, args.f4, args.f5, args.f6, args.f7
    );
    85u64 - val
}

machine main() crashes Trap {
    let args: SevenArgs = SevenArgs {
        f1: 10, f2: 20, f3: 30, f4: 40, f5: 50, f6: 60, f7: 86
    };
    transition probe(args) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
