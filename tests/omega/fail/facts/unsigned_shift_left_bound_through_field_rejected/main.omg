// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Invalid: operand is bounded to 24u64, so 24 << 2 is 96, underflowing subtraction by 100u64. Place: field.
// Expected exit: 0

data ShiftPacket {
    val: u64;
    shift: u32;
}

machine shift_field(packet: ShiftPacket) -> u64
requires packet.val >= 24 && packet.val <= 24 && packet.shift == 2
{
    let shifted: u64 = packet.val << packet.shift;
    shifted - 100u64
}

machine probe() -> u64 {
    let packet: ShiftPacket = ShiftPacket { val: 24u64, shift: 2 };
    shift_field(packet)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
