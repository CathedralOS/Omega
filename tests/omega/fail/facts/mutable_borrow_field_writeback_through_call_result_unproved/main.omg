// Fact: Updating a record field through an exclusive mutable borrow (`&mut Counter`) and retiring the loan establishes the updated field bound (`counter.used <= 80u64`) while preserving unrelated fields, discharging exact subtraction `80u64 - counter.used` across all nine places.
// Place: call_result. The helper machine takes the borrow, writes back, and returns the updated Counter.
// Invalid control: widens the field's declared bound to `used <= 81u64` and writes 81 through the
// same exclusive borrow, so the post-writeback aggregate no longer proves `80u64 - counter.used` in range.
// Expected rejection: exact arithmetic in machine `main` state `entry` local `diff` may overflow `u64`

data Counter [copy] where used <= 81u64 {
    used: u64;
    limit: u64;
}

machine mutate_and_return() -> Counter {
    let mut c: Counter = Counter { used: 0u64, limit: 80u64 };
    let r: &mut Counter = &mut c;
    r.used = 81u64;
    c
}

machine main() crashes Trap {
    let c: Counter = mutate_and_return();
    let diff: u64 = 80u64 - c.used;
    transition diff == 0u64 && c.limit == 80u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
