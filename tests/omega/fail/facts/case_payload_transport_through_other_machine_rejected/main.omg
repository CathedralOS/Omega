// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.

data Outcome [copy] {
    case Empty;
    case Ready(value: u64) where value <= 80;
}

machine inspect(outcome: Outcome) -> u64
    ensures result <= 60
{
    transition outcome {
        Outcome::Ready { value } -> (value + 10)
        Outcome::Empty {} -> 0
    }
}

machine eval(outcome: Outcome) -> u64
    ensures result <= 60
{
    inspect(outcome)
}

machine main() crashes Trap {
    let a: Outcome = Outcome::Ready { value: 32 };
    let b: Outcome = Outcome::Empty {};
    transition eval(a) == 42 && eval(b) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
