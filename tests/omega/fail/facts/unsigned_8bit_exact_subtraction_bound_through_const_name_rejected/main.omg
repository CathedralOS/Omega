// Fact: 8-bit unsigned exact subtraction lhs - rhs with 100u8 <= lhs <= 180u8 and 20u8 <= rhs <= 40u8 establishes 60u8 <= diff <= 160u8 so 160u8 - diff and diff - 60u8 are safe.
// Place: const name (invalid twin). Constant LHS_VAL is widened to 181u8 so diff reaches 161u8, underflowing 160u8 - diff.
// Expected diagnostic: may overflow `u8`

const LHS_VAL: u8 = 181u8;
const RHS_VAL: u8 = 20u8;

machine sub_const() -> u8 {
    let diff: u8 = LHS_VAL - RHS_VAL;
    let headroom: u8 = 160u8 - diff;
    let margin: u8 = diff - 60u8;
    headroom + margin
}

machine probe() -> u8 {
    sub_const()
}

machine main() crashes Trap {
    transition probe() == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
