data ProofNat { case Zero; case Succ(prev: ProofNat); }
data Rank {}
measure Rank::Flat(value: u64) -> u64 { value * 0 + 1 }
machine erased(n: ProofNat, remaining: u64) -> ProofNat
requires remaining <= 7
terminates by remaining -> Rank::Flat in 0..=1
{ transition remaining > 0 { true -> erased(n, remaining - 1) false -> n } }
machine main() {}
