machine build(builder: &mut Build) {
    Build::select_provider<SelectedShiftTarget, CheckedShiftTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedShiftTarget, CheckedShiftTarget>(builder, linux_arm64);
    Build::select_provider<SelectedShiftTarget, CheckedShiftTarget>(builder, macos_arm64);
    Build::select_provider<SelectedShiftTarget, CheckedShiftTarget>(builder, windows_x86_64);

    Build::application(builder, "unsigned_8bit_shift_left_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
