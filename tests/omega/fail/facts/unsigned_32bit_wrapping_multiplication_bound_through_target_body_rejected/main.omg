// Fact: 32-bit unsigned wrapping multiplication lhs *% rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Place: another target body. Target-scoped implementations across all four platforms verify the bounds.
// Invalid control: lhs upper bound widened to 21u32, allowing prod up to 210u32 and failing exact headroom subtraction.
// Expected rejection: may overflow `u32`

linux_x86_64 machine multiply_target(lhs: u32, rhs: u32) -> i32
    requires lhs >= 10u32 && lhs <= 21u32;
    requires rhs >= 5u32 && rhs <= 10u32;
{
    let a: u32 in Wrapping = lhs as u32 in Wrapping;
    let b: u32 in Wrapping = rhs as u32 in Wrapping;
    let p_wrap: u32 in Wrapping = a * b;
    let prod: u32 = p_wrap as u32;
    let headroom: u32 = 200u32 - prod;
    let margin: u32 = prod - 50u32;
    transition prod == 120u32 && headroom + margin == 150u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

