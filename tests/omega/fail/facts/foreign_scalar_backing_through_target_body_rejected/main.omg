// A shared inline scalar-field loan exports its original backing through the thin foreign ABI without changing adjacent fields.
// Expected exit: 0
use omega::language::core::external_binding;
const WORD: u32 = 172180033;
data Cell [copy] { prefix: u32; word: u32; suffix: u32; }
data Envelope [copy] { cell: Cell; }
public boundary trait Words {
    machine write(descriptor: i32, word: &u32, count: u64) -> i64 reaches;
}
public boundary trait WindowsWords {
    machine write(descriptor: i32, word: &u32, count: u32) -> i32 reaches;
}


// This witness exports exact bytes; MSVCRT stdout must not translate LF.
public boundary trait WindowsDescriptorMode {
    machine set_mode(descriptor: i32, mode: i32) -> i32 reaches;
}


machine demand(result: bool) crashes Trap {
    transition result { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
macos_arm64 machine across() crashes Trap {
    let mut backing: Cell = Cell { prefix: 1650614882, word: WORD, suffix: 1684300900 };
    let selected: &u32 = &backing.word;
    backing.word = 0;
    let written: i64 = Words::write(1, selected, 4);
    demand(written == 4 && backing.prefix == 1650614882 && backing.word == WORD && backing.suffix == 1684300900);
}
linux_x86_64 machine across() crashes Trap {
    let mut backing: Cell = Cell { prefix: 1650614882, word: WORD, suffix: 1684300900 };
    let selected: &u32 = &backing.word;
    backing.word = 0;
    let written: i64 = Words::write(1, selected, 4);
    demand(written == 4 && backing.prefix == 1650614882 && backing.word == WORD && backing.suffix == 1684300900);
}
linux_arm64 machine across() crashes Trap {
    let mut backing: Cell = Cell { prefix: 1650614882, word: WORD, suffix: 1684300900 };
    let selected: &u32 = &backing.word;
    backing.word = 0;
    let written: i64 = Words::write(1, selected, 4);
    demand(written == 4 && backing.prefix == 1650614882 && backing.word == WORD && backing.suffix == 1684300900);
}
windows_x86_64 machine across() crashes Trap {
    let previous_mode: i32 = WindowsDescriptorMode::set_mode(1, 32768);
    demand(previous_mode != -1);
    let mut backing: Cell = Cell { prefix: 1650614882, word: WORD, suffix: 1684300900 };
    let selected: &u32 = &backing.word;
    backing.word = 0;
    let written: i32 = WindowsWords::write(1, selected, 4);
    demand(written == 4 && backing.prefix == 1650614882 && backing.word == WORD && backing.suffix == 1684300900);
}
machine main() crashes Trap { across(); }
