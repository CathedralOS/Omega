// Fact: a four-word structural aggregate returned and passed by value preserves field refinement bounds summing to 100u64 across indirect return homes when subtracting 100u64.
// Place: field (invalid twin).
// Expected diagnostic: exact subtraction underflow

data Quartet [copy] where
    first >= 10u64 && first <= 10u64,
    second >= 20u64 && second <= 20u64,
    third >= 30u64 && third <= 30u64,
    fourth >= 39u64 && fourth <= 39u64
{
    first: u64;
    second: u64;
    third: u64;
    fourth: u64;
}

data Container [copy] {
    quartet: Quartet;
}

machine make_quartet() -> Quartet {
    Quartet {
        first: 10,
        second: 20,
        third: 30,
        fourth: 39,
    }
}

machine probe() -> u64 {
    let container: Container = Container { quartet: make_quartet() };
    let total: u64 = container.quartet.first + container.quartet.second + container.quartet.third + container.quartet.fourth;
    total - 100
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
