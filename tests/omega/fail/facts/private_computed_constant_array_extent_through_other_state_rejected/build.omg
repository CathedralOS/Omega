machine build_extent(input: u64) -> u64
requires input == 1
ensures result == 1
{ input }
const BUILD_SIZE: u64 = 1 + 0;
const BUILD_SOURCE: [u64; BUILD_SIZE] = [3 + 0];
const BUILD_ALIAS: [u64; 1] = BUILD_SOURCE;
machine build(builder: &mut Build) {
    let items: [u64; build_extent(1)] = BUILD_ALIAS;
    transition items[0] == 3 {
        true -> original_configuration(builder)
        _ -> wrong_configuration(builder)
    }
}
machine wrong_configuration(builder: &mut Build) {
    Build::application(builder, "private_computed_array_extent_wrong");
    Build::bind(builder, linux_x86_64::ProgramEntry, incorrect);
    Build::bind(builder, linux_arm64::ProgramEntry, incorrect);
    Build::bind(builder, windows_x86_64::ProgramEntry, incorrect);
    Build::bind(builder, macos_arm64::ProgramEntry, incorrect);
}

machine original_configuration(builder: &mut Build) {
    Build::application(builder, "computed_constant_array_extent");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
