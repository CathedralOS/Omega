// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress [copy] { values: [u64; 2]; selected: u64; canary: u64; }
measure Progress::Remaining(value: Progress) -> u64 { value.values[value.selected] }
machine count(counter: &mut u64, remaining: &mut Progress) crashes Trap
requires remaining.values[remaining.selected] <= 7
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.values[remaining.selected] > 0 {
        true -> forward(remaining, counter)
        false -> done()
    }
    machine forward(pending: &mut Progress, counter: &mut u64) crashes Trap
    requires pending.selected < 2 && pending.values[pending.selected] > 0 && pending.values[pending.selected] <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        pending.values[pending.selected] = pending.values[pending.selected] - 1;
        transition { _ -> count(counter, pending) }
    }
    machine done() {}
}
machine perform(counter: &mut u64, active: bool, second: bool) crashes Trap {
    let amount: u64 = match active { true -> 7 false -> 0 };
    let selected: u64 = match second { true -> 1 false -> 0 };
    let values: [u64; 2] = match second { true -> [919, amount] false -> [amount, 919] };
    let mut remaining: Progress = Progress { values: values, selected: selected, canary: 641 };
    count(counter, &mut remaining);
    let preserved: bool = match second {
        true -> remaining.values[0] == 919 && remaining.values[1] == 0
        false -> remaining.values[0] == 0 && remaining.values[1] == 919
    };
    transition preserved && remaining.canary == 641 && remaining.selected == selected {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true, false);
    let first: bool = counted == 10;
    perform(&mut counted, false, false);
    perform(&mut counted, true, true);
    let second: bool = counted == 17;
    perform(&mut counted, false, true);
    transition first && second && counted == 17 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
