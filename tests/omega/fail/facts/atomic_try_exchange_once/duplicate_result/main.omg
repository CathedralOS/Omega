use omega::language::core::layout;
data Cells { selected: AtomicU32; untouched: AtomicU32; }
machine main() {
    let cells: Cells;
    cells.selected.store(10, NoOrdering);
    let outcome: AtomicTryExchangeOnceOutcome<u32> = cells.selected.try_exchange_once(10, 99, ReceivePublish, Receive);
    let moved: AtomicTryExchangeOnceOutcome<u32> = outcome;
    let again: AtomicTryExchangeOnceOutcome<u32> = outcome;
}
