// Expected exit: 0.
// A non-observing single attempt returns the proposed u32 on failure and the displaced u32 on commit.
// Discarding the whole result must still evaluate the proposal exactly once.
use omega::language::core::AtomicTryExchangeOnceOutcome;
data Cells { selected: AtomicU32; untouched: AtomicU32; }

machine proposal(calls: &mut u64) -> u32
    requires calls < 2
{
    calls = calls + 1;
    99
}

machine discard_attempt(cells: &Cells, calls: &mut u64)
    requires calls < 2
{
    let unused: AtomicTryExchangeOnceOutcome<u32> = cells.selected.compare_exchange_once(9, proposal(calls), ReceivePublish, Receive);
}

machine main() crashes Trap {
    let cells: Cells;
    let mut calls: u64 = 0;
    cells.selected.store(10, NoOrdering);
    cells.untouched.store(17, NoOrdering);
    discard_attempt(&cells, &mut calls);
    transition calls == 1 && cells.selected.load(NoOrdering) == 10 && cells.untouched.load(NoOrdering) == 17 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
