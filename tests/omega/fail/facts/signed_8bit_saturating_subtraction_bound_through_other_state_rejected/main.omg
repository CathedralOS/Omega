// Fact: 8-bit signed saturating subtraction lhs -| rhs with bounded interval 40i8 <= diff <= 90i8 establishes 40i8 <= diff <= 90i8 across all nine places so exact subtractions 90i8 - diff and diff - 40i8 are safe.
// Invalid: widened lhs produces diff of 95i8 across state transition, failing verify_diff requires contract.

machine compute_sat(lhs: i8 in Saturating, rhs: i8 in Saturating) -> i8 in Saturating {
    lhs - rhs
}

machine verify_diff(diff: i8) -> i32
    requires diff >= 40 && diff <= 90
{
    let headroom: i8 = 90 - diff;
    let margin: i8 = diff - 40;
    let total: i8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

machine main() crashes Trap {
    let lhs: i8 in Saturating = 105;
    let rhs: i8 in Saturating = 10;
    let diff_sat: i8 in Saturating = compute_sat(lhs, rhs);
    let diff: i8 = diff_sat as i8;
    transition true {
        true -> step(diff)
        _ -> bad()
    }
    state step(forwarded: i8) {
        let check: i32 = verify_diff(forwarded);
        transition check == 0 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}
