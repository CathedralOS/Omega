// Fact: 8-bit unsigned wrapping addition lhs +% rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Invalid: widened inputs produce sum of 105u8, failing produce_sum ensures contract.

machine verify_sum(sum: u8) -> i32
    requires sum >= 50 && sum <= 100
{
    let headroom: u8 = 100 - sum;
    let margin: u8 = sum - 50;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

machine produce_sum(lhs: u8 in Wrapping, rhs: u8 in Wrapping) -> u8
    requires lhs as u8 >= 40 && lhs as u8 <= 85, rhs as u8 >= 10 && rhs <= 20
    ensures result >= 50 && result <= 100
{
    let wrapped: u8 in Wrapping = lhs + rhs;
    wrapped as u8
}

machine main() crashes Trap {
    let lhs: u8 in Wrapping = 85;
    let rhs: u8 in Wrapping = 20;
    let sum: u8 = produce_sum(lhs, rhs);
    let check: i32 = verify_sum(sum);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
