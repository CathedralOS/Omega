// Fact: an entry f32 equal to -0.0 discharges maybe_nonzero's value != 0.0 Trap crash guard without a caller crash ceiling, because the guard reads recorded IEEE equality and -0.0 compares equal to 0.0.
// Expected exit: 0
// Control: an entry f32 proved equal to 1.0 keeps maybe_nonzero's value != 0.0 Trap route live.
machine maybe_nonzero(value: f32) -> f32
crashes Trap value != 0.0
{
    transition value != 0.0 { true -> bad() false -> (value) }
    state bad() { crash Trap; }
}
public const ONE: f32 = 1.0;
public machine read_zero(value: f32) -> f32
requires value == ONE
{
    let observed: f32 = value;
    maybe_nonzero(observed)
}
machine main() crashes Trap {
    let observed: f32 = read_zero(ONE);
    transition observed == 0.0 { true -> done() _ -> bad() }
    state done() {} state bad() { crash Trap; }
}
