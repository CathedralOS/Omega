machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left _ -> right }
}
machine trial(buffer: &mut [u8], other: &mut [u8], count: u64) -> u64 {
    let mut current: &mut [u8] = buffer;
    let capacity: u64 = minimum(minimum(count, current.len), 2147483647);
    current = other;
    let prefix: &mut [u8] = &mut current[0..capacity];
    prefix.len
}
machine main() crashes Trap {
    let mut bytes: [u8; 16];
    let mut other: [u8; 8];
    let observed: u64 = trial(&mut bytes[..], &mut other[..], 13);
    transition observed == 13 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
