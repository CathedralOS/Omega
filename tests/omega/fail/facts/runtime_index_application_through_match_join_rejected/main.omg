// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0
data Index<Limit: u32> [copy] where value < Limit { value: u32; }
machine probe(first:u32,second:u32,flag:bool)->u32
requires first>=9 && first<=10 && second>=9 && second<=10
{
 let limit:u32=match flag {true->first, false->second};
 let indexed:Index<limit> = Index{value:10};
 indexed.value
}
machine main() crashes Trap {
 let first:u32=probe(9,10,true);
 let second:u32=probe(9,10,false);
 transition first==8 && second==8 { true->done() _->bad() }
 machine done(){}
 machine bad(){crash Trap;}
}
