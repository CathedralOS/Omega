// A field holding a closed result of 9 does not discharge `scale <= 5`.
machine echo(scale: u64) -> u64
requires scale <= 5
{
    scale
}

machine nine() -> u64 { 9u64 }

data Reading { scale: u64; }
data Main { hits: i32 in Wrapping; }

machine Main::main(main: &mut Main) {
    main.hits = 0;

    let reading: Reading = Reading { scale: nine() };
    let r: u64 = echo(reading.scale);
    transition r == 4 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
