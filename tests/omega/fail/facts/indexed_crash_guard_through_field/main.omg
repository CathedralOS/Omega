// Fact: the exact selected element items[index] == 7 discharges the callee's indexed zero crash guard and returns that same 7 without a caller crash ceiling.
// Expected exit: 0
// Place: field.
machine maybe_zero(items: &[u64; 2], index: u64) -> u64
requires index < 2
crashes Trap items[index] == 0
{
    transition items[index] == 0 { true -> bad() false -> (items[index]) }
    state bad() { crash Trap; }
}
public data Selection [copy] { index: u64; }
public machine read_seven(items: &[u64; 2], selection: Selection) -> u64
requires selection.index < 2
{ maybe_zero(items, selection.index) }
machine main() crashes Trap {
    let items: [u64; 2] = [7, 11];
    transition items[0] == 7 { true -> finish(read_seven(&items, Selection { index: 0 })) _ -> bad() }
    state finish(observed: u64) {
        transition observed == 7 { true -> done() _ -> bad() }
    }
    state done() {} state bad() { crash Trap; }
}
