// A finite-family result retains its exclusive input counter through storage and forwarding, and consuming that result increments the counter once.
// Expected exit: 0
// Place: target_body.
data Token dropped by drop_token { drops: &mut [u64; 1]; }
machine drop_token(token: &mut Token) {
    token.drops[0] = ((token.drops[0] as u64 in Wrapping) + 1) as u64;
}
data Ticket { token: Token; marker: u32; }
trait Family {
    machine row<Width: u32>(ticket: Ticket) -> Ticket requires Width == 16 || Width == 32;
}
First satisfies Family {
    machine row<Width: u32>(ticket: Ticket) -> Ticket requires Width == 16 || Width == 32 {
        let mut local: [u64; 1] = [0];
        Ticket { token: Token { drops: &mut local }, marker: Width }
    }
}
Second satisfies Family {
    machine row<Width: u32>(ticket: Ticket) -> Ticket requires Width == 16 || Width == 32 {
        let mut local: [u64; 1] = [0];
        Ticket { token: Token { drops: &mut local }, marker: Width }
    }
}
data Stored { ticket: Ticket; }
machine dispatch(selected: dyn Family, ticket: Ticket, width: u32) -> Ticket
requires width == 16 || width == 32
{ Family::row<width>(selected, ticket) }
machine forward(ticket: Ticket) -> Ticket { ticket }
machine observe(selected: dyn Family, drops: &mut [u64; 1], width: u32) -> bool
requires width == 16 || width == 32
{
    let stored: Stored = Stored { ticket: dispatch(selected, Ticket { token: Token { drops: drops }, marker: 0 }, width) };
    transition { _ -> finish(forward(stored.ticket), width) }
    machine finish(ticket: Ticket, width: u32) -> bool {
        let correct: bool = ticket.marker == width;
        correct
    }
}
machine check(drops: &mut [u64; 1]) crashes Trap {
    let first: bool = observe(First as dyn Family, drops, 16);
    let first_settled: bool = drops[0] == 1;
    let second: bool = observe(Second as dyn Family, drops, 32);
    transition first && first_settled && second && drops[0] == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedHelper {
    machine helper(counter: &mut [u64; 1]) reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}
X86Helper satisfies SelectedHelper {
    machine helper(counter: &mut [u64; 1]) reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        check(counter);
    }
}
ArmHelper satisfies SelectedHelper {
    machine helper(counter: &mut [u64; 1]) reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        check(counter);
    }
}
machine main() crashes Trap {
    let mut counter: [u64; 1] = [0];
    SelectedHelper::helper(&mut counter);
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
