// Fact: a 16-bit signed i16 arithmetic right shift of a bounded input (val >= 480i16 && val <= 480i16) by 2u32 bits establishes shifted >= 120i16 && shifted <= 120i16 so exact 16-bit signed subtraction shifted - 120i16 is proved overflow-free across all nine places.
// Place: target_body. Each hosted target body computes the 16-bit signed arithmetic right shift and verifies the bounds.
// Expected exit: 0
machine verify_shifted(shifted: i16) -> i32
    requires shifted >= 120 && shifted <= 120
{
    let sub: i16 = shifted - 120;
    sub as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 476 && val <= 480;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 476 && val <= 480
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: i16 = val >> 2u32;
        verify_shifted(shifted)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 476 && val <= 480
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: i16 = val >> 2u32;
        verify_shifted(shifted)
    }
}









machine evaluate() -> i32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(480)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
