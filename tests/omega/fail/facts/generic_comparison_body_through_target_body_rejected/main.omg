// A generic comparison body returns false. The call records that boolean,
// and the caller reads the record.
// Place: target_body.
// Expected exit: 0
machine same<T>(left: T, right: T) -> bool {
    true
}

machine compare<T>(left: T, right: T) -> bool {
    same<T>(left, right)
}

machine hold(direct: bool) -> bool
requires direct == false
{
    true
}

linux_x86_64 machine observe() -> bool {
    let direct: bool = compare<u64>(1u64, 1u64);
    hold(direct)
}

linux_arm64 machine observe() -> bool {
    let direct: bool = compare<u64>(1u64, 1u64);
    hold(direct)
}

macos_arm64 machine observe() -> bool {
    let direct: bool = compare<u64>(1u64, 1u64);
    hold(direct)
}

windows_x86_64 machine observe() -> bool {
    let direct: bool = compare<u64>(1u64, 1u64);
    hold(direct)
}

machine main() crashes Trap {
    transition observe() {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
