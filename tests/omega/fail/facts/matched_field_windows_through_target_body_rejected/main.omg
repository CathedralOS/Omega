// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: `items[2..3]` in the arm that does not pin `which` publishes length 1
// in every target body, so no target publishes the promised 2.
linux_x86_64 machine from_target<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..which + 2]
        _ -> &mut items[2..3]
    }
}

linux_arm64 machine from_target<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..which + 2]
        _ -> &mut items[2..3]
    }
}

macos_arm64 machine from_target<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..which + 2]
        _ -> &mut items[2..3]
    }
}

windows_x86_64 machine from_target<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..which + 2]
        _ -> &mut items[2..3]
    }
}

machine main() crashes Trap {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_target(&mut bytes, 0);
    transition window.len == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
