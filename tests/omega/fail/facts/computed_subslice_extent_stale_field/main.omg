use omega::language::core::slice;
machine can_window(items: &[u8], low: u64) -> bool { items.len == 4 && low <= 2 }
data Cursor { low: u64; }
machine read(items: &[u8], cursor: &mut Cursor) -> u8
requires can_window(items, cursor.low) == true
{
    cursor.low = 3;
    let view: &[u8] = items[cursor.low + 0u64..cursor.low + 2u64];
    view[1]
}
machine main() crashes Trap {
    let items: [u8; 4] = [11u8, 23u8, 37u8, 53u8];
    let mut cursor: Cursor = Cursor { low: 1 };
    transition read(&items, &mut cursor) == 37u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
