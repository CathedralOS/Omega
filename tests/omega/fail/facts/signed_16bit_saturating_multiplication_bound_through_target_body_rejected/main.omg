windows_x86_64 machine verify_target() -> i32 {
    let lhs: i16 = 21i16;
    let rhs: i16 = 10i16;
    let w_lhs: i16 in Saturating = lhs as i16 in Saturating;
    let w_rhs: i16 in Saturating = rhs as i16 in Saturating;
    let prod_sat: i16 in Saturating = w_lhs * w_rhs;
    let prod: i16 = prod_sat as i16;
    verify_prod(prod)
}

machine probe() -> i32 {
    verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
