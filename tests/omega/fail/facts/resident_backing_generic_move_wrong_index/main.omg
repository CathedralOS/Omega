// Expected rejection: index compatibility condition
// A granted vacant extent retains actual backing through transport, initialization, permitted writes, and extraction.
use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Resident;
use omega::language::core::VacantContentTransfer;
use omega::language::core::VacantExtentParts;
use omega::language::core::split_vacant_extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Granted::content;
use omega::language::core::ExtentRootProvider;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::RelativeRange;
use omega::language::core::StableCapability;
use omega::language::core::ExternalCapability;
use omega::language::core::AtomicCapability;
use omega::language::core::PeerWritability;
use omega::language::core::ResourceRegion;
use omega::language::core::ResourceProfile;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::AccessOutcome;
use omega::language::core::AccessExtraction;
use omega::language::core::ProcessExit;
use omega::language::core::IntervalSet;
use omega::language::core::Nat;

data TestMemory {}
public data Word { prefix: u64; value: u64; suffix: u64; }
public data WordPlacement {}
public data OtherPlacement {}
machine OtherPlacement::plan(schema: Schema) -> AccessPlan { WordPlacement::plan(schema) }

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 16 } };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 3, size_fixed: 24, size_is_dynamic: false, align: 8 };
    let first: AccessPlan = AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported });
    let second: AccessPlan = AccessPlan::with(first, schema.fields[1].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported });
    AccessPlan::with(second, schema.fields[2].key,
        FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported })
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

boundary trait NativeAllocation {
    machine allocate(count: u64, width: u64) -> addr reaches;
}
TestRoots satisfies ExtentRootProvider {
    machine grant(root: Extent) -> Extent { root }
}
TestVacant satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
        ensures result in Granted,
            core::Identity<IntervalSet<Nat>>(
                Granted::content(old(&storage)),
                Granted::content(&result)
            )
    { storage as Extent }
}


// A generic move must carry the resident's exact T custody, not copy bytes
// while pretending both allocations contain the same owned value.
data Relocated<P, T> {
    old: Extent in Granted & Vacant;
    current: Extent in Granted & Resident<P, T>;
}
machine relocate<P, T, Role>(source: Extent in Granted & Resident<P, T>,
    destination: Extent in Granted & Vacant) -> Relocated<P, T>
crashes Trap
{
    transition NativeAccess<P, T, Role>::move_out(source) {
        AccessExtraction::Moved { storage, value } -> install<P, T, Role>(storage, destination, value)
    }
    machine install<P, T, Role>(old: Extent in Granted & Vacant,
        destination: Extent in Granted & Vacant, value: T) -> Relocated<P, T> {
        transition NativeAccess<P, T, Role>::initialize(destination, value) {
            AccessOutcome::Ready { view } -> Relocated { old: old, current: view }
            AccessOutcome::Rejected { returned, reason } -> fail<P, T>()
        }
    }
    machine fail<P, T>() -> Relocated<P, T> { crash Trap; }
}

machine consume(value: Word, cleaned: &mut u64) crashes Trap {
    let { prefix, value as payload, suffix } = value;
    transition prefix == 101 && payload == 17 && suffix == 103 {
        true -> record(cleaned)
        false -> bad()
    }
    machine record(cleaned: &mut u64) { cleaned = 1; }
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    let address: addr = NativeAllocation::allocate(1, 64);
    transition address != 0 { true -> allocated(address) false -> bad() }
    machine allocated(address: addr) {
        let grant: Extent in Granted = ExtentRootProvider::grant(Extent { base: address, length: 64 });
        let vacant: Extent in Granted & Vacant = VacantContentTransfer::transfer(grant);
        transition vacant.length == 64 { true -> partition(vacant) false -> bad() }
    }
    machine partition(vacant: Extent in Granted & Vacant) requires vacant.length == 64 {
        let parts: VacantExtentParts = split_vacant_extent(vacant, 32);
        transition NativeAccess<WordPlacement, Word, TestMemory>::initialize(
            parts.taken, Word { prefix: 101, value: 17, suffix: 103 }) {
            AccessOutcome::Ready { view } -> move_value(view, parts.rest)
            AccessOutcome::Rejected { returned, reason } -> bad()
        }
    }
    machine move_value(original: Extent in Granted & Resident<WordPlacement, Word>,
        replacement: Extent in Granted & Vacant) {
        let moved: Relocated<OtherPlacement, Word> =
            relocate<OtherPlacement, Word, TestMemory>(original, replacement);
        transition NativeAccess<OtherPlacement, Word, TestMemory>::move_out(moved.current) {
            AccessExtraction::Moved { storage, value } -> finish(moved.old, storage, value)
        }
    }
    machine finish(old: Extent in Granted & Vacant, current: Extent in Granted & Vacant, value: Word) {
        let mut cleaned: u64 = 0;
        consume(value, &mut cleaned);
        transition cleaned == 1 && old.base != current.base {
            true -> done(old, current)
            false -> bad()
        }
    }
    machine done(old: Extent in Granted & Vacant, current: Extent in Granted & Vacant) {
        ProcessExit::exit_process(0);
    }
    machine bad() { crash Trap; }
}
