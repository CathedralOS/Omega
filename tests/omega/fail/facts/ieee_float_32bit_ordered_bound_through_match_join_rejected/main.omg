// Fact: a 32-bit IEEE f32 ordered comparison guard (reading >= 1.25f32 && reading <= 2.75f32) establishes a finite, non-NaN sub-interval that satisfies a downstream contract requiring reading >= 1.0f32 && reading <= 3.0f32 across all nine places.
// Invalid: upper bound is 3.5f32 which exceeds downstream requires bound 3.0f32. Place: match_join.
// Expected diagnostic: cannot prove requires contract for call verify_f32_window

data Reading [copy] where value >= 1.25f32 && value <= 3.5f32 {
    value: f32;
}

machine verify_f32_window(reading: f32) -> i32
requires reading >= 1.0f32 && reading <= 3.0f32
{
    transition reading >= 1.25f32 && reading <= 2.75f32 {
        true -> ok()
        _ -> out_of_window()
    }
    machine ok() -> i32 { 0i32 }
    machine out_of_window() -> i32 { 1i32 }
}

machine probe(left: Reading, right: Reading, choice: bool) -> i32 {
    let value: f32 = match choice {
        true -> left.value,
        false -> right.value,
    };
    verify_f32_window(value)
}

machine main() crashes Trap {
    let low: Reading = Reading { value: 1.75f32 };
    let high: Reading = Reading { value: 2.25f32 };
    transition probe(high, low, true) == 0 && probe(high, low, false) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
