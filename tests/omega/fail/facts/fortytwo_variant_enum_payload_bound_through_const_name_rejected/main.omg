// Fact: matching a 42-variant tagged enum payload FortyTwoChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64), V20(u64), V21(u64), V22(u64), V23(u64), V24(u64), V25(u64), V26(u64), V27(u64), V28(u64), V29(u64), V30(u64), V31(u64), V32(u64), V33(u64), V34(u64), V35(u64), V36(u64), V37(u64), V38(u64), V39(u64), V40(u64), V41(u64), V42(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.

const MAX_RES: u64 = 80u64;
const MIN_RES: u64 = 40u64;

data FortyTwoChoice [copy] {
    case V1(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V2(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V3(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V4(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V5(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V6(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V7(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V8(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V9(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V10(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V11(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V12(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V13(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V14(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V15(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V16(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V17(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V18(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V19(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V20(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V21(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V22(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V23(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V24(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V25(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V26(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V27(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V28(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V29(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V30(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V31(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V32(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V33(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V34(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V35(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V36(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V37(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V38(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V39(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V40(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V41(v: u64) where v >= MIN_RES && v <= MAX_RES;
    case V42(v: u64) where v >= 39u64 && v <= MAX_RES;
}

machine verify_payload(value: u64) -> u64
    requires value >= MIN_RES && value <= MAX_RES
{
    let headroom: u64 = MAX_RES - value;
    let margin: u64 = value - MIN_RES;
    headroom + margin
}

machine extract(choice: FortyTwoChoice) -> u64 {
    transition choice {
        FortyTwoChoice::V1 { v } -> v
        FortyTwoChoice::V2 { v } -> v
        FortyTwoChoice::V3 { v } -> v
        FortyTwoChoice::V4 { v } -> v
        FortyTwoChoice::V5 { v } -> v
        FortyTwoChoice::V6 { v } -> v
        FortyTwoChoice::V7 { v } -> v
        FortyTwoChoice::V8 { v } -> v
        FortyTwoChoice::V9 { v } -> v
        FortyTwoChoice::V10 { v } -> v
        FortyTwoChoice::V11 { v } -> v
        FortyTwoChoice::V12 { v } -> v
        FortyTwoChoice::V13 { v } -> v
        FortyTwoChoice::V14 { v } -> v
        FortyTwoChoice::V15 { v } -> v
        FortyTwoChoice::V16 { v } -> v
        FortyTwoChoice::V17 { v } -> v
        FortyTwoChoice::V18 { v } -> v
        FortyTwoChoice::V19 { v } -> v
        FortyTwoChoice::V20 { v } -> v
        FortyTwoChoice::V21 { v } -> v
        FortyTwoChoice::V22 { v } -> v
        FortyTwoChoice::V23 { v } -> v
        FortyTwoChoice::V24 { v } -> v
        FortyTwoChoice::V25 { v } -> v
        FortyTwoChoice::V26 { v } -> v
        FortyTwoChoice::V27 { v } -> v
        FortyTwoChoice::V28 { v } -> v
        FortyTwoChoice::V29 { v } -> v
        FortyTwoChoice::V30 { v } -> v
        FortyTwoChoice::V31 { v } -> v
        FortyTwoChoice::V32 { v } -> v
        FortyTwoChoice::V33 { v } -> v
        FortyTwoChoice::V34 { v } -> v
        FortyTwoChoice::V35 { v } -> v
        FortyTwoChoice::V36 { v } -> v
        FortyTwoChoice::V37 { v } -> v
        FortyTwoChoice::V38 { v } -> v
        FortyTwoChoice::V39 { v } -> v
        FortyTwoChoice::V40 { v } -> v
        FortyTwoChoice::V41 { v } -> v
        FortyTwoChoice::V42 { v } -> v
    }
}

machine probe(choice: FortyTwoChoice) -> u64 {
    let res: u64 = extract(choice);
    verify_payload(res)
}

machine main() crashes Trap {
    let p: FortyTwoChoice = FortyTwoChoice::V42 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
