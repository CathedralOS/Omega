// After an opaque callback, fresh count <= slots.len and preserved immutable fuel > 0 admit the nested call's slots.len - count and fuel - 1.
// Expected exit: 0
public data CompactBinary {}
public data Ctx { slots: &mut [u64]; count: u64; valid: bool; }
public data Observation [copy] { remaining: u64; fuel_left: u64; }
const INITIAL_FUEL: u64 = 2u64;
public machine CompactBinary::read_record<machine Plan>(slots: &mut [u64], fuel: u64, choose: bool) -> Observation
requires machine Plan(context: &mut Ctx);
requires fuel >= 0u64
{
    let mut context: Ctx = Ctx { slots: slots, count: 0u64, valid: true };
    let selected: u64 = fuel;
    Plan(&mut context);
    transition context.valid && context.count <= context.slots.len {
        true -> parse(&mut context, selected)
        false -> Observation { remaining: 99u64, fuel_left: 99u64 }
    }
    machine parse(context: &mut Ctx, fuel: u64) -> Observation
    requires context.count <= context.slots.len && fuel > 0u64
    {
        Observation { remaining: context.slots.len - context.count, fuel_left: fuel - 1u64 }
    }
}
machine PlanGood(context: &mut Ctx) { context.count = context.slots.len; }
machine PlanFalse(context: &mut Ctx) { context.valid = false; }
machine main() crashes Trap {
    let mut first: [u64; 4] = [0x13579BDFu64, 7u64, 11u64, 0x2468ACE0u64];
    let first_result: Observation = CompactBinary::read_record<PlanGood>(&mut first[1u64..3u64], INITIAL_FUEL, true);
    let mut second: [u64; 4] = [0x13579BDFu64, 7u64, 11u64, 0x2468ACE0u64];
    let second_result: Observation = CompactBinary::read_record<PlanGood>(&mut second[1u64..3u64], INITIAL_FUEL, false);
    let mut third: [u64; 4] = [0x13579BDFu64, 7u64, 11u64, 0x2468ACE0u64];
    let invalid: Observation = CompactBinary::read_record<PlanFalse>(&mut third[1u64..3u64], INITIAL_FUEL, false);
    transition first_result.remaining == 0u64 && first_result.fuel_left == 1u64
        && second_result.remaining == 0u64 && second_result.fuel_left == 1u64
        && invalid.remaining == 99u64 && invalid.fuel_left == 99u64
        && first[0] == 0x13579BDFu64 && first[3] == 0x2468ACE0u64
        && first[1] == 7u64 && first[2] == 11u64
        && second[0] == 0x13579BDFu64 && second[3] == 0x2468ACE0u64
        && second[1] == 7u64 && second[2] == 11u64
        && third[0] == 0x13579BDFu64 && third[3] == 0x2468ACE0u64
        && third[1] == 7u64 && third[2] == 11u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
