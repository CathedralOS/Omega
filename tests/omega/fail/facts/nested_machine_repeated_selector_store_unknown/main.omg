// Distinct captured element selectors preserve the untouched sibling across one exact store.
// Expected exit: 0
data Progress [copy] { values: [u64; 2]; canary: u64; }
machine hold(value: Progress) -> Progress requires value.values[1] <= 919 { value }
machine example(pending: Progress, selected: u64) -> Progress
requires pending.values[1] <= 919 && selected < 2
{
    let mut next: Progress = pending;
    next.values[selected] = 920;
    hold(next)
}
machine main() crashes Trap {
    let initial: Progress = Progress { values: [641, 919], canary: 373 };
    let result: Progress = example(initial, 0);
    transition result.values[0] == 920 && result.values[1] == 919 && result.canary == 373 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
