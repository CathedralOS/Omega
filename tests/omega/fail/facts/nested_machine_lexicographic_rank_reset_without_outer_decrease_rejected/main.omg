// Joint private arrivals retain a lexicographic rank while lower components reset after a strict higher-component decrease.
// Expected exit: 0
data Progress [copy] { outer: u64; inner: u64; canary: u64; }
measure Progress::Steps lexicographic { outer, inner }
machine count(counter: &mut u64, progress: Progress) crashes Trap
terminates
terminates by progress -> Progress::Steps
requires progress.outer <= 1 && progress.inner <= 2
{
    transition progress.inner > 0 {
        true -> step(counter, progress)
        false -> next_row(counter, progress)
    }
    machine step(counter: &mut u64, progress: Progress) crashes Trap
    terminates
    terminates by progress -> Progress::Steps
    requires progress.outer <= 1 && progress.inner > 0 && progress.inner <= 2
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Progress = Progress { outer: progress.outer, inner: progress.inner - 1, canary: progress.canary };
        transition { _ -> count(counter, next) }
    }
    machine next_row(counter: &mut u64, progress: Progress) crashes Trap
    terminates
    terminates by progress -> Progress::Steps
    requires progress.outer <= 1 && progress.inner == 0
    {
        transition progress.outer > 0 {
            true -> count(counter, Progress { outer: progress.outer, inner: 2, canary: progress.canary })
            false -> done(progress.canary)
        }
    }
    machine done(canary: u64) crashes Trap {
        transition canary == 641 { true -> finish() false -> bad() }
    }
    machine finish() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, active: bool) crashes Trap { invoke(counter, match active { true -> Progress { outer: 1, inner: 2, canary: 641 } false -> Progress { outer: 0, inner: 0, canary: 641 } }); }
machine invoke(counter: &mut u64, progress: Progress) crashes Trap
requires progress.outer <= 1 && progress.inner <= 2
{ count(counter, progress); }
machine main() crashes Trap {
    let mut counter: u64 = 3;
    perform(&mut counter, true);
    let traversed: bool = counter == 7;
    perform(&mut counter, false);
    transition traversed && counter == 7 { true -> done() false -> bad() }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
