// Expected rejection: the children omit the requested prefix.
// An admitted no-wrap domain predicate proves base + requested fits addr when requested < length.
// Numeric return-proof witness only; Region owns no storage authority.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { base: addr; length: u64; }
machine Region::drop(region: &mut Region) {}
let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;
domain Region::Bounded(region) requires no_wrap(region.base, region.length);
machine Bounded::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet {
        start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat
    }
}
data Pieces { left: Region in Bounded; right: Region in Bounded; }
machine region(base: addr, length: u64, ceiling: addr) -> Region in Bounded
requires embed(base) + embed(length) <= embed(ceiling)
ensures result.base == base && result.length == length
{ Region { base: base, length: length } }
machine split(whole: Region in Bounded, requested: u64) -> Pieces
requires requested < whole.length
ensures Bounded::content(old(&whole)) == separate(
    Bounded::content(&result.left), Bounded::content(&result.right))
{
    let left: Region = Region { base: whole.base, length: 0 };
    let right: Region = Region {
        base: whole.base + requested,
        length: whole.length - requested
    };
    drop(whole);
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let pieces: Pieces = split(region(10, 80, 100), 20);
    let correct: bool = pieces.left.base == 10 && pieces.left.length == 20
        && pieces.right.base == 30 && pieces.right.length == 60;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
