// Computed constant array extents preserve the selected value 3 through an alias.
const SIZE: u64 = 1 + 0;
const SOURCE: [u64; SIZE] = [3 + 0];
const ALIAS: [u64; 1] = SOURCE;
machine check_param(arr: &[u64; SIZE]) -> bool {
    arr[1] == 3
}
machine main() crashes Trap {
    let local_arr: [u64; SIZE] = ALIAS;
    transition check_param(&local_arr) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
