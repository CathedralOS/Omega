windows_x86_64 machine evaluate() -> u64 {
    let value: u64 = block countdown(4, 61);
    60u64 - value
}

linux_x86_64 machine evaluate() -> u64 {
    let value: u64 = block countdown(4, 61);
    60u64 - value
}

macos_arm64 machine evaluate() -> u64 {
    let value: u64 = block countdown(4, 61);
    60u64 - value
}

linux_arm64 machine evaluate() -> u64 {
    let value: u64 = block countdown(4, 61);
    60u64 - value
}
machine main() crashes Trap {
    let difference: u64 = block evaluate();
    transition difference == 0 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
