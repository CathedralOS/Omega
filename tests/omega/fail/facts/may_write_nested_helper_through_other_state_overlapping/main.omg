// An outer helper that calls an inner helper to pick one of two mutable inputs and write through that result preserves a disjoint index-bound fact on the other input.
// Expected exit: 0
// Place: other_state.

machine choose<'storage>(chosen: &'storage mut u64, other: &'storage mut u64, pick_chosen: bool) -> &'storage mut u64 {
    transition pick_chosen {
        true -> chosen
        _ -> other
    }
}


machine relay<'storage>(chosen: &'storage mut u64, other: &'storage mut u64, pick_chosen: bool) -> &'storage mut u64 {
    choose(chosen, other, pick_chosen)
}

machine overwrite(slot: &mut u64) -> u64 in Wrapping {
    slot = 9;
    (1 as u64 in Wrapping)
}

machine add(first: u64 in Wrapping, second: u64 in Wrapping) -> u64 in Wrapping {
    first + second
}

machine main() crashes Trap {
    let mut chosen: u64 = 0;
    let mut other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    let zero: u64 in Wrapping = 0;
    let marker: u64 in Wrapping = add(overwrite(relay(&mut chosen, &mut other, false)), zero);
    transition { _ -> read(items, other, chosen, marker) }
    machine read(items: [u8; 4], index: u64, chosen: u64, marker: u64 in Wrapping)
    requires index < 4
    {
        transition (marker as u64) == 1 && chosen == 9 && items[index] == 7 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
