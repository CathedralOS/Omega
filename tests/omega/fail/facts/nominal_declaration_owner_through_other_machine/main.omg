// A library Token retains its declaring owner when it reaches library::read.
// Expected exit: 0
use shared::copied::Token;
use shared::library::read;
data Relay {}
machine Relay::forward(token: Token) -> u8 { read(token) }
machine transported() -> u8 { Relay::forward(Token { value: 7 }) }
machine main() crashes Trap {
    transition transported() == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
