// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: const name. The bounds and shift parameters reference declared symbolic constants.
// Invalid control: val lower bound weakened to 25u16, allowing shifted as low as 100u16 and failing subtraction shifted - 120u16.
// Expected rejection: may overflow `u16`

const INPUT_MIN: u16 = 25u16;
const INPUT_VAL: u16 = 30u16;
const SHIFT_AMOUNT: u16 = 2u16;
const EXPECTED_VAL: u16 = 120u16;

machine shift_const(val: u16) -> i32
    requires val >= INPUT_MIN && val <= INPUT_VAL;
{
    let shifted: u16 = val << SHIFT_AMOUNT;
    let check: u16 = shifted - EXPECTED_VAL;
    transition shifted == EXPECTED_VAL && check == 0u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = shift_const(30u16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
