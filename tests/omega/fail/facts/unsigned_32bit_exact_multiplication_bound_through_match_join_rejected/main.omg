// Fact: a 32-bit unsigned u32 exact multiplication of bounded inputs (lhs >= 20u32 && lhs <= 30u32, rhs >= 15u32 && rhs <= 25u32) establishes prod >= 300u32 && prod <= 750u32 so exact 32-bit subtractions 750u32 - prod and prod - 300u32 are proved overflow-free across all nine places.
// Place: match join. The product is synthesized across conditional match branches.
// Invalid control: rhs upper bound widened to 26u32, allowing product up to 780u32 and failing subtraction 750u32 - prod.
// Expected rejection: may overflow `u32`

machine multiply_match_join(lhs: u32, rhs: u32, choose: bool) -> i32
    requires lhs >= 20u32 && lhs <= 30u32;
    requires rhs >= 15u32 && rhs <= 26u32;
{
    let prod: u32 = match choose {
        true -> lhs * rhs,
        false -> lhs * rhs
    };
    let headroom: u32 = 750u32 - prod;
    let margin: u32 = prod - 300u32;
    transition prod == 500u32 && headroom + margin == 450u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = multiply_match_join(25u32, 20u32, true);
    let res2: i32 = multiply_match_join(25u32, 20u32, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
