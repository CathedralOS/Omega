// Fact: a 4-level nested structural record RootRec { outer: Outer { mid: Middle { inner: Inner { val: u64 } } } } preserves the leaf field bound 40u64 <= root.outer.mid.inner.val <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.
// Invalid: upper bound 81 allows res 81, causing 80u64 - res to underflow. Place: field.
// Expected diagnostic: may overflow `u64`

data Inner [copy] {
    val: u64;
}

data Middle [copy] {
    inner: Inner;
}

data Outer [copy] {
    mid: Middle;
}

data RootRec [copy] {
    outer: Outer;
}

data Container [copy] {
    root: RootRec;
}

machine compute_field(c: Container) -> i32
requires c.root.outer.mid.inner.val >= 40u64 && c.root.outer.mid.inner.val <= 81u64
{
    let res: u64 = c.root.outer.mid.inner.val;
    let headroom: u64 = 80u64 - res;
    let margin: u64 = res - 40u64;
    0i32
}

machine probe() -> i32 {
    let c: Container = Container {
        root: RootRec {
            outer: Outer {
                mid: Middle {
                    inner: Inner {
                        val: 60u64,
                    },
                },
            },
        },
    };
    compute_field(c)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
