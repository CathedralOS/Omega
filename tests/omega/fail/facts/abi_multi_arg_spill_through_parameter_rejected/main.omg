// Fact: a ten-argument weighted scalar call preserves exact positional argument order across register and stack ABI slots when subtracting 100u64.
// Place: parameter (invalid twin).
// Expected diagnostic: exact subtraction underflow

machine weighted_ten_sum(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64
) -> u64
requires
    a1 == 1u64 && a2 == 2u64 && a3 == 3u64 && a4 == 4u64 && a5 == 5u64 &&
    a6 == 6u64 && a7 == 7u64 && a8 == 8u64 && a9 == 24u64 && a10 == 39u64
ensures
    result == 99u64
{
    a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10
}

machine probe(
    p1: u64,
    p2: u64,
    p3: u64,
    p4: u64,
    p5: u64,
    p6: u64,
    p7: u64,
    p8: u64,
    p9: u64,
    p10: u64
) -> u64
requires
    p1 == 1u64 && p2 == 2u64 && p3 == 3u64 && p4 == 4u64 && p5 == 5u64 &&
    p6 == 6u64 && p7 == 7u64 && p8 == 8u64 && p9 == 24u64 && p10 == 39u64
{
    let total: u64 = weighted_ten_sum(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10);
    total - 100
}

machine main() crashes Trap {
    transition probe(1, 2, 3, 4, 5, 6, 7, 8, 24, 39) == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
