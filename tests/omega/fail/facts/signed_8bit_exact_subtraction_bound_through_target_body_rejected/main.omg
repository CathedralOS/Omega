// Fact: 8-bit signed exact subtraction lhs - rhs with 60i8 <= lhs <= 100i8 and 10i8 <= rhs <= 20i8 establishes 40i8 <= diff <= 90i8 so 90i8 - diff and diff - 40i8 are safe.
// Invalid: widened rhs upper bound produces diff down to 35i8, failing exercise requires contract.

machine compute_diff(lhs: i8, rhs: i8) -> i8
    requires lhs >= 60 && lhs <= 100, rhs >= 10 && rhs <= 25
{
    lhs - rhs
}

machine verify_diff(diff: i8) -> i32
    requires diff >= 40 && diff <= 90
{
    let headroom: i8 = 90 - diff;
    let margin: i8 = diff - 40;
    let sum: i8 = headroom + margin;
    let check: i8 = sum - 50;
    check as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 40 && val <= 90;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 40 && val <= 90
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_diff(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 40 && val <= 90
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_diff(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: i8 = 60;
    let rhs: i8 = 25;
    let diff: i8 = compute_diff(lhs, rhs);
    let check: i32 = SelectedProbe::exercise(diff);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
