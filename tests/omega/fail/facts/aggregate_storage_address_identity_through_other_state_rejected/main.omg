// Compatible references to a live Pair expose the same nonzero address without retaining a loan.
// Expected exit: 0.
data Pair [copy] { left: u64; right: u64; }
machine expose(value: &Pair) -> addr { address_of(value) }
machine probe() -> bool {
    let mut value: Pair = Pair { left: 7, right: 11 };
    transition { _ -> inspect(value) }
    state inspect(mut value: Pair) -> bool {
    let original: addr = address_of(value);
    let forwarded: addr = expose(&value);
    value.left = 13;
    let current: addr = address_of(value);
    original != 0 && original == forwarded && original == current && value.left == 13
    }
}
machine main() crashes Trap {
    transition probe() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
