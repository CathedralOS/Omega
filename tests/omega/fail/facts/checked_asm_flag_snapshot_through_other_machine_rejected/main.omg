// Expected exit: 0.
// Subtraction establishes ZF; a structured snapshot carries that bit to a label.
machine main() crashes Trap {
 let mut snapshot: u64 = 0;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 1;
  sub eax, 1;
  pushfq snapshot;
  jmp observed;
 observed requires (snapshot & 64u64) == 64u64:
  nop
 }
 forward(snapshot);
 transition (snapshot & 64u64) == 64u64 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}

machine forward(snapshot: u64) requires (snapshot & 64u64) == 64u64 crashes Trap {
 consume(snapshot ^ 64u64);
}

machine consume(snapshot: u64) requires (snapshot & 64u64) == 64u64 crashes Trap {
 asm { observed requires (snapshot & 64u64) == 64u64: nop }
 transition (snapshot & 64u64) == 64u64 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
