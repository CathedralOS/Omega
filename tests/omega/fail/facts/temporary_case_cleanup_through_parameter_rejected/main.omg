// Bonus.value == 2 survives each place into an affine case common field with omitted zero storage and normal shared-call cleanup.
// Expected exit: 0
data Bonus [copy] { value: u64; }
data Event where omitted == 0, { omitted: u64; details: Bonus; case Treasure(gold: u64); }
machine observe(event: &Event) -> bool { event.omitted == 0 && event.details.value == 2 }
machine consume(value: Bonus) -> bool
requires value.value == 2 {
    observe(Event::Treasure { gold: 1, details: value })
}
machine through_parameter(value: Bonus) -> bool
requires value.value == 2 { consume(value) }
machine main() crashes Trap {
    let accepted: bool = through_parameter(Bonus { value: 1 });
    transition accepted { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
