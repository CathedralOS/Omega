// Fact: a generic transfer conserves the complete counted content of its owned input.
// Expected exit: 0
// Counted model only; this carrier grants no access to physical storage.
use omega::language::core::content;
use omega::language::core::drop;
data Units {}
data Payload {}
data Region [linear] dropped by cleanup_region { amount: u64; }
machine cleanup_region(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<Units>
satisfies Content<Region, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(region.amount) as Nat }
}
trait Transfer<T> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures Owned::content(old(&region)) == Owned::content(&result);
}
ConservingTransfer satisfies Transfer<Payload> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures Owned::content(old(&region)) == Owned::content(&result)
    { drop(region); Region { amount: 28 } }
}
machine observe(region: Region in Owned) -> u64 {
    let observed: u64 = region.amount;
    drop(region);
    observed
}
// The tag makes a wrong selected arm observable without changing the counted payload.
data BranchValue { region: Region in Owned; selected: bool; }
machine choose(region: Region in Owned, select: bool) -> BranchValue {
    transition select { true -> left(region) _ -> right(region) }
    machine left(region: Region in Owned) -> BranchValue {
        BranchValue { region: ConservingTransfer::transfer(region), selected: true }
    }
    machine right(region: Region in Owned) -> BranchValue {
        BranchValue { region: ConservingTransfer::transfer(region), selected: false }
    }
}
machine exercise(select: bool) -> u64 {
    let chosen: BranchValue = choose(Region { amount: 29 }, select);
    let selected: bool = chosen.selected;
    let amount: u64 = observe(chosen.region);
    transition selected == select { true -> checked(amount) _ -> wrong_arm() }
    machine checked(amount: u64) -> u64 { amount }
    machine wrong_arm() -> u64 { 0 }
}
machine main() crashes Trap {
    let first: u64 = exercise(true);
    let second: u64 = exercise(false);
    transition first == 29 && second == 29 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
