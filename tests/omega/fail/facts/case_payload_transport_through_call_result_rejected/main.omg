// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.

data Outcome [copy] {
    case Empty;
    case Ready(value: u64) where value <= 80;
}

machine fetch(flag: bool) -> Outcome {
    transition flag {
        true -> (Outcome::Ready { value: 32 })
        false -> (Outcome::Empty {})
    }
}

machine eval(flag: bool) -> u64
    ensures result <= 60
{
    let outcome: Outcome = fetch(flag);
    transition outcome {
        Outcome::Ready { value } -> (value + 10)
        Outcome::Empty {} -> 0
    }
}

machine main() crashes Trap {
    transition eval(true) == 42 && eval(false) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
