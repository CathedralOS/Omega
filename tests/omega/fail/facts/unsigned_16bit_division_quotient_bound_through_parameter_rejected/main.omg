// Fact: a 16-bit unsigned u16 division of bounded inputs (dividend >= 400u16 && dividend <= 400u16, divisor >= 8u16 && divisor <= 8u16) establishes quotient >= 50u16 && quotient <= 50u16 so exact 16-bit subtraction quotient - 50u16 is proved underflow-free across all nine places.
// Invalid: divisor upper bound widened to 10u16 so quotient can be 40u16, underflowing subtraction by 50u16.
// Expected exit: 0

machine div_param(dividend: u16, divisor: u16) -> u16
requires dividend >= 400 && dividend <= 400 && divisor >= 8 && divisor <= 10
{
    let quotient: u16 = dividend / divisor;
    quotient - 50u16
}

machine probe() -> u16 {
    div_param(400u16, 8u16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
