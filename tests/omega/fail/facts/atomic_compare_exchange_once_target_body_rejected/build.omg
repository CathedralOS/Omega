machine build(builder: &mut Build) {
    Build::select_provider<SelectedAttempt, LinuxX8664Attempt>(builder, linux_x86_64);
    Build::select_provider<SelectedAttempt, WindowsX8664Attempt>(builder, windows_x86_64);
    Build::select_provider<SelectedAttempt, WindowsX8664Attempt>(builder, linux_arm64);
    Build::select_provider<SelectedAttempt, WindowsX8664Attempt>(builder, macos_arm64);

    Build::application(builder, "atomic_compare_exchange_once");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
