public domain [u8]::Utf8 requires valid_utf8(self);
public machine stale(storage: &mut [u8; 4]) -> &[u8] in Utf8 crashes Trap {
    let saved: bool = valid_utf8(&storage[..2]);
    storage[0] = 255u8;
    let bytes: &[u8] = &storage[..2];
    transition saved { true -> finish(bytes) false -> invalid() }
    machine finish(bytes: &[u8] in Utf8) -> &[u8] in Utf8 { bytes }
    machine invalid() -> &[u8] in Utf8 crashes Trap { crash Trap; }
}
machine main() {}
