// Control: an entry integer proved equal to 0 makes maybe_zero's 0.0 Trap route live.
machine maybe_zero(value: f32) -> f32
crashes Trap value == 0.0
{
    transition value == 0.0 { true -> bad() false -> (value) }
    machine bad() -> f32 { crash Trap; }
}
public machine read_bits(value: i32, flag: bool) -> f32
requires value == 0
{
    let view: &f32 = &value as &f32;
    let viewed: f32 = view;
    let observed: f32 = match flag { true -> viewed, false -> viewed };
    maybe_zero(observed)
}
machine main() crashes Trap {
    let first: f32 = read_bits(0, true);
    let second: f32 = read_bits(0, false);
    transition first == 1.0 && second == 1.0 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
