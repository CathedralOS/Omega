windows_x86_64 machine calling_plan_seven(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    let val: u64 = (prefix - 210) + a7;
    85u64 - val
}

machine probe() -> u64 {
    calling_plan_seven(10, 20, 30, 40, 50, 60, 86)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
