// Fact: passing seven bounded integer arguments (`a1` through `a7` with `a7 <= 85u64`) across register and stack ABI slots preserves the stack-passed argument's static bound (`a7 <= 85u64`), discharging exact subtraction `85u64 - a7` across all nine places.
// Place: another target body (invalid twin).
// Expected diagnostic: exact subtraction underflow

linux_x86_64 machine calling_plan_seven(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    let val: u64 = (prefix - 210) + a7;
    85u64 - val
}

linux_arm64 machine calling_plan_seven(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
    let val: u64 = (prefix - 210) + a7;
    85u64 - val
}

macos_arm64 machine calling_plan_seven(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64, a6: u64, a7: u64
) -> u64
requires
    a1 == 10u64 && a2 == 20u64 && a3 == 30u64 && a4 == 40u64 && a5 == 50u64 &&
    a6 == 60u64 && a7 <= 86u64
{
    let prefix: u64 = a1 + a2 + a3 + a4 + a5 + a6;
