// Fact: a slice view (&[u64]) whose length is guarded (view.len >= 3u64) proves safe indexed element read at view[2u64] and preserves the length lower bound to discharge exact subtraction view.len - 3u64 across all nine places.
// Place: const name (invalid twin). Named constant INDEX is 3, which exceeds the guarded length bound of 3 elements.
// Expected diagnostic: slice index out of bounds

use omega::language::core::slice;

const INDEX: u64 = 3;
const SUBTRAHEND: u64 = 3;

machine read_guarded(view: &[u64]) -> i32
    requires view.len >= SUBTRAHEND
{
    let elem: u64 = view[INDEX];
    let diff: u64 = view.len - SUBTRAHEND;
    transition elem == 30u64 && diff == 1u64 {
        true -> done()
        _ -> bad()
    }
    state done() -> i32 { 0 }
    state bad() -> i32 { 1 }
}

machine main() crashes Trap {
    let items: [u64; 4] = [10u64, 20u64, 30u64, 40u64];
    let view: &[u64] = &items[..];
    let res: i32 = read_guarded(view);
    transition res == 0 {
        true -> pass()
        _ -> fail()
    }
    state pass() {}
    state fail() { crash Trap; }
}
