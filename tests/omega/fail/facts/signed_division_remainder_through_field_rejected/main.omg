// Fact: computing the signed remainder (%) of a non-negative bounded i64 dividend by a positive bounded i64 divisor (divisor == 4i64) establishes the remainder bound (0 <= rem < 4) to safely index a 4-element array across all nine places.
// Invalid: divisor is 5i64, so rem can be 4, exceeding array length 4. Place: field.
// Expected exit: 0

data DivisorPacket {
    dividend: i64;
    divisor: i64;
}

machine compute_field(packet: DivisorPacket) -> u8
requires packet.dividend >= 0i64 && packet.divisor == 5i64
{
    let rem: i64 = packet.dividend % packet.divisor;
    let idx: u64 = rem as u64;
    let arr: [u8; 4] = [10, 20, 30, 40];
    arr[idx]
}

machine probe() -> u8 {
    let packet: DivisorPacket = DivisorPacket { dividend: 14i64, divisor: 5i64 };
    compute_field(packet)
}

machine main() crashes Trap {
    transition probe() == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
