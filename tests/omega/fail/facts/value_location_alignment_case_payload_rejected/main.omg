// A payload field named `x` exists in both cases, with different storage. The
// query cannot tell which case is active, so it must not report the first
// case's u64 alignment for a value that holds the u8 case.
data Slot { tag: u8; case Wide(x: u64); case Narrow(x: u8); }

machine slack_of(s: &Slot) -> u64
{
    align_of(s.x) - 8u64
}

machine main() {
    let s: Slot = Slot::Narrow { tag: 1u8, x: 2u8 };
    let r: u64 = slack_of(&s);
}
