machine build(builder: &mut Build) {
    Build::select_provider<SelectedObserve, WindowsX8664Observe>(builder, windows_x86_64);
    Build::select_provider<SelectedObserve, LinuxX8664Observe>(builder, linux_x86_64);
    Build::select_provider<SelectedObserve, LinuxX8664Observe>(builder, linux_arm64);
    Build::select_provider<SelectedObserve, LinuxX8664Observe>(builder, macos_arm64);

    Build::application(builder, "generic_case_subject_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
