use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::application(builder, "nominal_loan_local");
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, linux_arm64);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, linux_x86_64);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, macos_arm64);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, macos_x86_64);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, windows_x86_64);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, uefi_x86_64);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, cross_platform_cli);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, local_unchecked);
 Build::select_provider<Console, ConsoleNativeProviderConsoleImplementation>(builder, alpha_bootstrap);
 Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);

 Build::bind<PosixConsoleIo::write>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
    } });
 Build::bind<WindowsConsoleIo::write>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "_write"
    } });

 Build::bind<PosixConsoleIo::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
 Build::bind<PosixConsoleIo::write>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
}
