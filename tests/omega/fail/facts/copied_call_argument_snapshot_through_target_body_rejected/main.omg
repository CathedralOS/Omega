// A copied first argument equal to 7 stays 7 when the second argument overwrites its former home with 9.
// Place: target_body.
// The first copied operand is 9 and cannot establish the required 7.
machine overwrite(slot: &mut u64) -> u64
ensures slot == 9
{
    slot = 9;
    0
}
machine seven(value: u64) -> u64
requires value == 7
ensures result == 7
{
    value
}
windows_x86_64 machine receive(first: u64, ignored: u64) -> u64
requires first == 7
ensures result == 7
{
    seven(first)
}

linux_x86_64 machine receive(first: u64, ignored: u64) -> u64
requires first == 7
ensures result == 7
{
    seven(first)
}

macos_arm64 machine receive(first: u64, ignored: u64) -> u64
requires first == 7
ensures result == 7
{
    seven(first)
}

linux_arm64 machine receive(first: u64, ignored: u64) -> u64
requires first == 7
ensures result == 7
{
    seven(first)
}

machine main() crashes Trap {
    let mut source: u64 = 9;
    let observed: u64 = receive(source, overwrite(&mut source));
    let difference: u64 = observed - 7;
    transition difference == 0 && source == 9 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
