// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
const MARK_VALUE: u64 = 7;
public boundary trait Mark {
    machine read() -> u64
        reaches Mark terminates;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { MARK_VALUE }
}
machine checked_mark() -> u64 terminates; { Mark::read() }
machine first(count: u64) -> u64
terminates by count;
{
    transition count > 0 { true -> second(count - 1) false -> checked_mark() }
}
machine second(count: u64) -> u64 terminates by count; {
    transition count > 0 { true -> first(count - 1) false -> checked_mark() }
}
machine main() reaches crashes Trap {
    let value: u64 = first(2);
    transition value == MARK_VALUE { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
