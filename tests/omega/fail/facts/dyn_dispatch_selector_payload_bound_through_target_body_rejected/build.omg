machine build(builder: &mut Build) {
    Build::application(builder, "dyn_dispatch_selector_payload_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Build::accept_boundary<SelectedCompute>(builder);
    Build::select_provider<SelectedCompute, X86Compute>(builder, windows_x86_64);
    Build::select_provider<SelectedCompute, X86Compute>(builder, linux_x86_64);
    Build::select_provider<SelectedCompute, ArmCompute>(builder, macos_arm64);
    Build::select_provider<SelectedCompute, ArmCompute>(builder, linux_arm64);
}
