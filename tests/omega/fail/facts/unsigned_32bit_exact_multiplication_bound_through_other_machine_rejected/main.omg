// Fact: a 32-bit unsigned u32 exact multiplication of bounded inputs (lhs >= 20u32 && lhs <= 30u32, rhs >= 15u32 && rhs <= 25u32) establishes prod >= 300u32 && prod <= 750u32 so exact 32-bit subtractions 750u32 - prod and prod - 300u32 are proved overflow-free across all nine places.
// Place: another machine. The product is forwarded to another machine for interval verification.
// Invalid control: rhs upper bound widened to 26u32, allowing product up to 780u32 and failing subtraction 750u32 - prod.
// Expected rejection: may overflow `u32`

machine forward_eval(p: u32) -> i32
    requires p >= 300u32 && p <= 780u32;
{
    let headroom: u32 = 750u32 - p;
    let margin: u32 = p - 300u32;
    transition p == 500u32 && headroom + margin == 450u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine multiply_other_machine(lhs: u32, rhs: u32) -> i32
    requires lhs >= 20u32 && lhs <= 30u32;
    requires rhs >= 15u32 && rhs <= 26u32;
{
    let prod: u32 = lhs * rhs;
    forward_eval(prod)
}

machine main() crashes Trap {
    let res: i32 = multiply_other_machine(25u32, 20u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
