// Expected rejection: a partial read cannot establish its own index bound.
machine observe(view: &[u64], slot: u64) -> u64
terminates;
terminates by view[slot];
requires view[slot] == slot && view[slot] < view.len;
{ view[slot] }
machine main() crashes Trap {
    let values: [u64; 2] = [0, 1];
    let value: u64 = observe(&values[..], 1);
    transition value == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
