// Expected rejection: a true invariant cannot erase a state cycle that violates its authored termination promise
// Vector constructors bind their exact length and sum. Induction proves the
// sum bound used by the executing consumer; proof payloads remain erased.
data Vector<Length: u64, Total: u64> {
    case Nil where Length == 0 && Total == 0;
    case Cons(previous: u64, previous_total: u64, head: u64,
              tail [erased]: Vector<previous, previous_total>)
        where head <= 10 && embed(previous) + 1 == embed(Length)
              && embed(previous_total) + embed(head) == embed(Total);
}
let retain<Length: u64, Total: u64>(value: Vector<Length, Total>): Vector<Length, Total> = value;

machine vector_bound<Length: u64, Total: u64>(evidence [erased]: Vector<Length, Total>)
terminates by Length;
ensures embed(Total) <= 10 * embed(Length)
{
    transition { _ -> spinning() }
    machine spinning() { transition { _ -> spinning() } }
}

machine bounded<Length: u64, Total: u64>(evidence [erased]: Vector<Length, Total>) -> u64
requires Length <= 8
{
    vector_bound<Length, Total>(evidence);
    80u64 - Total
}
machine main() crashes Trap {
    let nil [erased]: Vector<0, 0> = Vector::Nil;
    let one [erased]: Vector<1, 7> = Vector::Cons { previous: 0, previous_total: 0, head: 7, tail: nil };
    let kept [erased]: Vector<1, 7> = retain<1, 7>(one);
    let result: u64 = bounded<1, 7>(kept);
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
