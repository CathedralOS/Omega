// Fact: zero-extending a bounded 8-bit unsigned u8 value (narrow >= 40u8 && narrow <= 160u8) to u32 (narrow as u32) preserves the exact interval (wide >= 40u32 && wide <= 160u32), discharging exact 32-bit subtractions 160u32 - wide and wide - 40u32 across all nine places.
// Invalid: narrow upper bound 161 allows wide 161, so 160u32 - w underflows. Place: local.
// Expected diagnostic: may overflow `u32`

machine compute_local(narrow: u8) -> i32
requires narrow >= 40u8 && narrow <= 161u8
{
    let wide: u32 = narrow as u32;
    let w: u32 = wide;
    let headroom: u32 = 160u32 - w;
    let margin: u32 = w - 40u32;
    0i32
}

machine probe() -> i32 {
    compute_local(100u8)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
