machine build(builder: &mut Build) {
    Build::select_provider<SelectedExtent, CheckedExtent>(builder, linux_x86_64);
    Build::select_provider<SelectedExtent, CheckedExtent>(builder, linux_arm64);
    Build::select_provider<SelectedExtent, CheckedExtent>(builder, macos_arm64);
    Build::select_provider<SelectedExtent, CheckedExtent>(builder, windows_x86_64);

    Build::application(builder, "generic_array_view_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
