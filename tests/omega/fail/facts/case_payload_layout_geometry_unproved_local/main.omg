// Fact: querying size_of and align_of on a multi-variant case type establishes its exact
// discriminant-plus-payload layout geometry (size 16, align 8), discharging exact
// subtraction size - (align * 2u64) == 0u64.
// Place: local.
// Invalid: the payload variant is replaced by a payloadless case, so the type
// geometry becomes size 4 / align 4 and the subtraction has bounds [-4, -4].
// Expected exit: 0

data Packet {
    case Empty;
    case Other;
}

machine main() crashes Trap {
    let s: u64 = size_of<Packet>();
    let a: u64 = align_of<Packet>();
    let local_size: u64 = s;
    let local_align: u64 = a;
    let diff: u64 = local_size - (local_align * 2u64);
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
