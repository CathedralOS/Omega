// Fact: a provider-settled boundary call whose contract establishes result >= 99u64 && result <= 99u64 discharges exact subtraction result - 100u64.
// Place: other_state. The boundary call result passed as an argument across a state machine transition.
// Expected rejection: exact arithmetic in machine `run` state `evaluate` may overflow `u64`.
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 99u64 && result <= 99u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 99u64 && result <= 99u64 {
        99
    }
}

machine run() -> u64 reaches Provider {
    transition { _ -> evaluate(Provider::get()) }
    state evaluate(val: u64) requires val >= 99u64 && val <= 99u64 {
        transition { _ -> finish(val - 100u64) }
    }
    state finish(outcome: u64) -> u64 { outcome }
}

machine main() crashes Trap {
    transition run() == 0u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
