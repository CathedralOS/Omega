// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: field (invalid twin). Plain u32 record fields without in Wrapping do not prove an exact shift.
data ShiftPayload where shift < 4 {
    val: u32;
    shift: u32;
}

machine shift_round_trip(payload: ShiftPayload) -> u32 {
    let shifted: u32 = payload.val << payload.shift;
    shifted >> payload.shift
}

machine probe(val: u32, shift: u32) -> u32
    requires shift < 4
{
    let payload: ShiftPayload = ShiftPayload { val: val, shift: shift };
    shift_round_trip(payload)
}

machine main() crashes Trap {
    let val: u32 = 21;
    let shift: u32 = 1;
    let recovered: u32 = probe(val, shift);
    let shifted: u32 = val << shift;
    transition shifted == 42 && recovered == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
