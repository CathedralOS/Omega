data Snapshot { value:u64; }
machine main() crashes Trap {
 let mut object:Snapshot=Snapshot{value:0};
 observe(&mut object);
 transition (object.value&64u64)==64u64 { true->done() false->bad() }
 machine done(){} machine bad(){crash Trap;}
}
machine observe(object:&mut Snapshot) {
 asm { entry:mov eax,1; sub eax,1; pushfq object.value; mov object.value,0u64; jmp observed;
 observed requires (object.value&64u64)==64u64:nop }
}
