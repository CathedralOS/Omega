// A borrowed match join records the selected place, and a later projection read uses that recorded referent. The consumer reads the joined field.
// Place: other_machine.
// The twin requires the other field.

data Pair { kept: i64; other: i64; }

machine choose() -> bool
ensures result == true
{
    true
}

machine read_field(place: &Pair) -> i64
requires place.other == 17
{
    place.other
}

machine apply(chosen: &Pair, spare: &Pair) -> i64 {
    let joined: &Pair = match choose() {
        true -> chosen
        false -> spare
    };
    read_field(joined)
}

machine forward(chosen: &Pair, spare: &Pair) -> i64 {
    apply(chosen, spare)
}

machine main() crashes Trap {
    let chosen: Pair = Pair { kept: 17, other: 5 };
    let spare: Pair = Pair { kept: 0, other: 8 };
    let observed: i64 = forward(&chosen, &spare);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    state done() {}
    state wrong() { crash Trap; }
}
