// Fact: indexing a fixed-size array field inside a structural record (row.cells[idx]) with a bounded index (idx < 4u64) proves safe element projection and preserves the element bound (elem <= 80u64) to discharge exact subtraction 80u64 - elem across all nine places.
// Invalid: target bodies require row.cells[idx] <= 81, so 80u64 - elem may overflow u64.
// Expected exit: 0

data Row [copy] {
    cells: [u64; 4];
}

linux_x86_64 machine read_and_sub(row: Row, idx: u64) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    let elem: u64 = row.cells[idx];
    let spare: u64 = 80u64 - elem;
    spare
}

linux_arm64 machine read_and_sub(row: Row, idx: u64) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    let elem: u64 = row.cells[idx];
    let spare: u64 = 80u64 - elem;
    spare
}

macos_arm64 machine read_and_sub(row: Row, idx: u64) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    let elem: u64 = row.cells[idx];
    let spare: u64 = 80u64 - elem;
    spare
}

windows_x86_64 machine read_and_sub(row: Row, idx: u64) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    let elem: u64 = row.cells[idx];
    let spare: u64 = 80u64 - elem;
    spare
}

machine probe(row: Row, idx: u64) -> u64
requires idx < 4 && row.cells[idx] <= 81
{
    read_and_sub(row, idx)
}

machine main() crashes Trap {
    let row: Row = Row { cells: [10, 20, 50, 80] };
    transition row.cells[2] <= 80 {
        true -> run(row)
        _ -> bad()
    }
    machine run(r: Row) {
        let spare: u64 = probe(r, 2);
        transition spare == 30 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
