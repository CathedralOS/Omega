// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the other arm selects `items[2..3]`, so the arm that does not pin
// `index` publishes length 1 and the two arms disagree on length.
machine from_local<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    let index: i64 = which;
    match index {
        0 -> &mut items[0..index + 2]
        _ -> &mut items[2..3]
    }
}
machine main() crashes Trap {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_local(&mut bytes, 0);
    transition window.len == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
