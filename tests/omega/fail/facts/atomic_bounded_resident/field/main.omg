// Expected exit: 0.
// A shared atomic store preserves its resident bound and ordering, and a load carries that bound into Exact subtraction.
use omega::language::core::atomic;
data Cell where value <= 100 { value: AtomicU32; }
machine publish(cell: &Cell, value: u32) requires value <= 101 { cell.value.store(value, Publish); }
data Held where observed <= 100 { observed: u32; }
machine main() crashes Trap {
    let cell: Cell;
    publish(&cell, 41);
    Atomic::fence(FenceOrdering::Receive);
    let held: Held = Held { observed: cell.value.load(Receive) };
    let observed: u32 = held.observed;
    let remaining: u32 = 100 - observed;
    transition remaining == 59 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
