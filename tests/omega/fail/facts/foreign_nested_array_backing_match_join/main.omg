data Route { value: u64; }
machine forward<'a>(pending: Pending<'a> in Pending::Retained, route: &mut Route, tag: u64) -> Pending<'a> in Pending::Retained
ensures result in Pending::Retained {
    route.value = tag;
    pending
}
data Main {}
machine run_main(main: &mut Main, choose: bool) reaches Writer crashes Trap {
    let capacity: Capacity in Capacity::Available = Writer::acquire();
    let mut buffer: Buffer in Buffer::Owned = Buffer { marker: 91, cells: [Cell { value: 305419896 }, Cell { value: 37 }, Cell { value: 1515863100 }] };
    let original: u64 = buffer.cells[1].value;
    let pending: Pending in Pending::Retained = Writer::register(capacity, &mut buffer);
    let mut observed_route: Route = Route { value: 0 };
    let routed: Pending in Pending::Retained = match choose { true -> forward(pending, &mut observed_route, 66051), false -> forward(pending, &mut observed_route, 513) };
    let route: u64 = observed_route.value;
    let forbidden: u64 = buffer.cells[1].value;
    let mut observed: u64 = 0;
    let returned: Capacity in Capacity::Available = Writer::complete(routed, &mut observed);
    Writer::release(returned);
    let remaining: u64 = 2147483647u64 - buffer.cells[1].value;
    let value: u64 = buffer.cells[1].value;
    let marker: u64 = buffer.marker;
    let left_guard: u64 = buffer.cells[0].value;
    let right_guard: u64 = buffer.cells[2].value;
    drop(buffer);
    transition remaining == 2147483574 && observed == 73 && value == 73 && original == 37 && marker == 91 && left_guard == 305419896 && right_guard == 1515863100 && ((choose && route == 66051) || (!choose && route == 513)) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Writer crashes Trap {
    let mut entry_storage: Main;
    run_main(&mut entry_storage, true);
    run_main(&mut entry_storage, false);
}
