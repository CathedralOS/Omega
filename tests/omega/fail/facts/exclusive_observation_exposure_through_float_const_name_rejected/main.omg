// A saved observation that kept is 7 stays valid across a complete non-writing exclusive call.
// This twin writes the saved float, invalidating its live equality with the observation.
const MARK: f64 = 7.0;
data Ends { kept: f64; other: f64; }
machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == MARK
{
    observed
}

machine expose(slot: &mut f64) -> f64 {
    slot = 8.0;
    slot
}

machine main() crashes Trap {
    let mut item: Ends = Ends { kept: MARK, other: 1.0 };
    let saved: f64 = item.kept;
    let held: f64 = expose(&mut item.kept);
    let agreed: f64 = agree(saved, item.kept);
    transition agreed == MARK && item.kept == MARK && item.other == 1.0 { true -> done(held) _ -> bad() }
    machine done(held: f64) {}
    machine bad() { crash Trap; }
}
