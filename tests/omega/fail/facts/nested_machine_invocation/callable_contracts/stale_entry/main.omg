// Expected exit: 0
// Callable public post-state facts refer to the changed storage, not its entry value.
data Cell { value: u64; }
machine provider(cell: &mut Cell)
requires cell.value == 5
ensures cell.value == 9
{ cell.value = 9; }
machine apply<machine Change>(cell: &mut Cell)
requires machine Change(item: &mut Cell) requires item.value == 5 ensures item.value == 5;
requires cell.value == 5
ensures cell.value == 5
{
    inner(cell);
    machine inner(item: &mut Cell)
    requires item.value == 5
    ensures item.value == 5
    { Change(item); }
}
machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 5 };
    apply<provider>(&mut cell);
    transition cell.value == 5 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
