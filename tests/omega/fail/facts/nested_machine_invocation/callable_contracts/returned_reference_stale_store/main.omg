// Invalid: a returned mutable reference can still mutate its original storage.
machine lend(value: &mut u64) -> &mut u64
requires value == 5
ensures value == 5
{ value }
machine write(value: &mut u64) { value = 9; }
machine require_five(value: u64)
requires value == 5
{}
machine main() {
    let mut value: u64 = 5;
    let alias: &mut u64 = lend(&mut value);
    alias = 9;
    require_five(value);
}
