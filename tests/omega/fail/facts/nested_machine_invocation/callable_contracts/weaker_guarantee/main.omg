// Expected exit: 0
machine positive(value: u64) -> u64
requires value > 0
ensures result >= value
{ value }
machine apply<machine Transform>(value: u64) -> u64
requires machine Transform(item: u64) -> u64 requires item > 0 ensures result == item;
requires value > 0
ensures result == value
{
    inner(value)
    machine inner(item: u64) -> u64
    requires item > 0
    ensures result == item
    { Transform(item) }
}
machine main() crashes Trap {
    transition apply<positive>(42) == 42 { true -> done() _ -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
