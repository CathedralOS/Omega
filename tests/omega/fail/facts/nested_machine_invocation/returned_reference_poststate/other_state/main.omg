// An exact returned mutable view observes its current post-call value while earlier scalar observations stay unchanged.
// Expected exit: 0
machine lend(value: &mut u64) -> &mut u64
requires value == 5
ensures value == 5
ensures result == 5
{ value }
machine write(value: &mut u64)
ensures value == 8
{ value = 8; }
machine main() crashes Trap {
    let mut value: u64 = 5;
    let alias: &mut u64 = lend(&mut value);
    let before: u64 = outer(alias);
    transition before == 5 && value == 9 { true -> done() false -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }

    machine outer(alias: &mut u64) -> u64
    requires alias == 5
    crashes Trap
    {
        inspect(alias)
        machine inspect(alias: &mut u64) -> u64
        requires alias == 5
        crashes Trap
        {
            let before: u64 = alias;
            write(alias);
            let gap: u64 = alias - 9;
            transition before == 5 && gap == 0 { true -> keep(before) false -> failed() }
            machine keep(before: u64) -> u64 { before }
            machine failed() -> u64 crashes Trap { crash Trap; }
        }
    }
}
