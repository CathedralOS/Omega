// Expected exit: 0
machine choose<'view>(first: &'view mut u64, second: &'view mut u64, flag: bool) -> &'view mut u64
requires first == 5 && second == 5
ensures first == 5 && second == 5
ensures result == 5
{
    transition flag { true -> left(first) false -> right(second) }
    machine left(value: &'view mut u64) -> &'view mut u64 requires value == 5 ensures result == 5 { value }
    machine right(value: &'view mut u64) -> &'view mut u64 requires value == 5 ensures result == 5 { value }
}
machine write(value: &mut u64) ensures value == 9 { value = 9; }
machine main() crashes Trap {
    let mut first: u64 = 5;
    let mut second: u64 = 5;
    let alias: &mut u64 = choose(&mut first, &mut second, true);
    write(alias);
    let gap_left: u64 = first - 9;
    let gap_right: u64 = second - 9;
    transition gap_left == 0 && gap_right == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
