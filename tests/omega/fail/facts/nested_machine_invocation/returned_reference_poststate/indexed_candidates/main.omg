// Must reject: updating one selected pointer cannot establish nine on both backing cells.
machine lend(value: &mut u64) -> &mut u64 requires value == 5 ensures result == 5 ensures value == 5 { value }
machine write(value: &mut u64) ensures value == 9 { value = 9; }
machine exercise(index: u64)
requires index < 2
crashes Trap
{
    let mut first: u64 = 5;
    let mut second: u64 = 5;
    let aliases: [&mut u64; 2] = [lend(&mut first), lend(&mut second)];
    write(aliases[index]);
    let gap_left: u64 = first - 9;
    let gap_right: u64 = second - 9;
    transition gap_left == 0 && gap_right == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap { exercise(0); }
