// An exact returned mutable view observes its current post-call value while earlier scalar observations stay unchanged.
// Expected exit: 0
machine lend(value: &mut u64) -> &mut u64
requires value == 5
ensures value == 5
ensures result == 5
{ value }
machine write(value: &mut u64)
ensures value == 8
{ value = 8; }
boundary trait SelectedView {
    machine inspect(alias: &mut u64) -> u64 requires alias == 5 reaches crashes Trap;
}
X86View satisfies SelectedView {
    machine inspect(alias: &mut u64) -> u64
    requires alias == 5
    crashes Trap
    {
        let before: u64 = alias;
        write(alias);
        let gap: u64 = alias - 9;
        transition before == 5 && gap == 0 { true -> keep() false -> failed() }
        machine keep() -> u64 { 17 }
        machine failed() -> u64 crashes Trap { crash Trap; }
    }
}
ArmView satisfies SelectedView {
    machine inspect(alias: &mut u64) -> u64
    requires alias == 5
    crashes Trap
    {
        let before: u64 = alias;
        write(alias);
        let gap: u64 = alias - 9;
        transition before == 5 && gap == 0 { true -> keep() false -> failed() }
        machine keep() -> u64 { 29 }
        machine failed() -> u64 crashes Trap { crash Trap; }
    }
}
machine exercise(expected: u64)
reaches SelectedView
invokes SelectedView
crashes Trap
{
    let mut value: u64 = 5;
    let alias: &mut u64 = lend(&mut value);
    let tag: u64 = SelectedView::inspect(alias);
    transition tag == expected && value == 9 { true -> done() false -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
machine x86_entry() reaches SelectedView invokes SelectedView crashes Trap { exercise(17); }
machine arm_entry() reaches SelectedView invokes SelectedView crashes Trap { exercise(29); }
