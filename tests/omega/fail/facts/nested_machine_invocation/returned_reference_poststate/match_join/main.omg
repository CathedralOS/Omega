// An exact returned mutable view observes its current post-call value while earlier scalar observations stay unchanged.
// Expected exit: 0
machine lend(value: &mut u64) -> &mut u64
requires value == 5
ensures value == 5
ensures result == 5
{ value }
machine write(value: &mut u64)
ensures value == 8
{ value = 8; }
machine tagged<'view>(value: &'view mut u64, trace: &mut u64, tag: u64) -> &'view mut u64
requires value == 5
ensures value == 5
ensures result == 5
ensures trace == tag
{
    trace = tag;
    lend(value)
}
machine exercise(choice: bool, expected: u64) crashes Trap {
    let mut value: u64 = 5;
    let mut trace: u64 = 0;
    let alias: &mut u64 = match choice {
        true -> tagged(&mut value, &mut trace, 17)
        false -> tagged(&mut value, &mut trace, 29)
    };
    let before: u64 = alias;
    write(alias);
    let gap: u64 = alias - 9;
    transition before == 5 && gap == 0 && value == 9 && trace == expected { true -> done() false -> failed() }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    exercise(true, 17);
    exercise(false, 29);
}
