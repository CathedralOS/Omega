machine keep_then_write(value: u64, destination: &mut u64) -> u64
ensures result == value {
    let saved: u64 = value;
    destination = 2;
    saved
}
machine demand_equal(left: u64, right: u64) requires left == right {}
machine main() {
    let mut current: u64 = 1;
    let saved: u64 = keep_then_write(current, &mut current);
    demand_equal(saved, current);
}
