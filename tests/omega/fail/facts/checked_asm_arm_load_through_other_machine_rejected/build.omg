machine build(builder: &mut Build) {
    Build::select_provider<SelectedReadPlace, LinuxArm64ReadPlace>(builder, linux_arm64);
    Build::select_provider<SelectedReadPlace, LinuxArm64ReadPlace>(builder, macos_arm64);
    Build::select_provider<SelectedReadPlace, WindowsX8664ReadPlace>(builder, windows_x86_64);
    Build::select_provider<SelectedReadPlace, WindowsX8664ReadPlace>(builder, linux_x86_64);

    Build::application(builder, "checked_asm_arm_load_other_machine_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
