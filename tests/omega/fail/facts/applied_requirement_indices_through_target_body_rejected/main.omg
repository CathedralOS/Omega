// Expected exit: 0. Applied requirements preserve exact type-indexed contracts.
data Payload { value: u64; }
domain<Value> Payload::Tagged<Value>;
domain<Outer, Inner> Payload::Pair<Outer, Inner>;
data Word {}
data Other {}
data Box<Value> { value: Value; }
data Holder<Value> { value: Payload in Tagged<Value>; }
boundary trait Identity<Value> {
    machine identity(value: Payload in Tagged<Value>) -> Payload in Tagged<Value> reaches;
    machine compound(value: Payload in Tagged<Box<Value>>) -> Payload in Tagged<Box<Value>> reaches;
    machine paired<Element>(value: Payload in Pair<Value, Element>) -> Payload in Pair<Value, Element> reaches;
    machine stated(value: Payload in Tagged<Value>) -> Payload in Tagged<Value>
    reaches
    requires value in Tagged<Value>
    ensures result in Tagged<Value>;
}
Provider satisfies Identity<Word> {
    machine identity(value: Payload in Tagged<Word>) -> Payload in Tagged<Word> { value }
    machine compound(value: Payload in Tagged<Box<Word>>) -> Payload in Tagged<Box<Word>> { value }
    machine paired<Element>(value: Payload in Pair<Word, Element>) -> Payload in Pair<Word, Element> { value }
    machine stated(value: Payload in Tagged<Word>) -> Payload in Tagged<Word>
    requires value in Tagged<Word>
    ensures result in Tagged<Word>;
    { value }
}
linux_x86_64 machine forward<Value, Alt>(value: Payload in Tagged<Value>) -> Payload in Tagged<Value>
reaches Identity
{
    let result: Payload in Tagged<Value> = Identity<Value>::identity(value);
    Identity<Value>::identity(result)
}
linux_arm64 machine forward<Value, Alt>(value: Payload in Tagged<Value>) -> Payload in Tagged<Value>
reaches Identity
{
    let result: Payload in Tagged<Value> = Identity<Value>::identity(value);
    Identity<Value>::identity(result)
}
macos_arm64 machine forward<Value, Alt>(value: Payload in Tagged<Value>) -> Payload in Tagged<Value>
reaches Identity
{
    let result: Payload in Tagged<Value> = Identity<Value>::identity(value);
    Identity<Value>::identity(result)
}
windows_x86_64 machine forward<Value, Alt>(value: Payload in Tagged<Value>) -> Payload in Tagged<Value>
reaches Identity
{
    let result: Payload in Tagged<Alt> = Identity<Value>::identity(value);
    Identity<Value>::identity(result)
}
machine field<Value>(holder: Holder<Value>) -> Payload in Tagged<Value>
reaches Identity
{
    forward<Value, Other>(holder.value)
}
machine forward_pair<Outer, Inner>(value: Payload in Pair<Outer, Inner>) -> Payload in Pair<Outer, Inner>
reaches Identity
{
    Identity<Outer>::paired<Inner>(Identity<Outer>::paired<Inner>(value))
}
machine later<Value>(value: Payload in Tagged<Value>) -> Payload in Tagged<Value>
reaches Identity
{
    transition { _ -> selected(value) }
    state selected(value: Payload in Tagged<Value>) -> Payload in Tagged<Value> {
        Identity<Value>::stated(value)
    }
}
machine main() reaches Identity crashes Trap {
    let value: Payload in Tagged<Word> = Payload { value: 29 };
    let holder: Holder<Word> = Holder { value: value };
    let result: Payload in Tagged<Word> = field<Word>(holder);
    let from_state: Payload in Tagged<Word> = later<Word>(result);
    let compound_value: Payload in Tagged<Box<Word>> = Payload { value: 37 };
    let from_compound: Payload in Tagged<Box<Word>> = Identity<Word>::compound(compound_value);
    let pair_value: Payload in Pair<Word, Other> = Payload { value: 43 };
    let from_pair: Payload in Pair<Word, Other> = forward_pair<Word, Other>(pair_value);
    let other_pair: Payload in Pair<Word, Word> = Payload { value: 47 };
    let from_other_pair: Payload in Pair<Word, Word> = forward_pair<Word, Word>(other_pair);
    transition from_state.value == 29 && from_compound.value == 37
        && from_pair.value == 43 && from_other_pair.value == 47 {
        true -> {}
        false -> bad()
    }
    state bad() { crash Trap; }
}
