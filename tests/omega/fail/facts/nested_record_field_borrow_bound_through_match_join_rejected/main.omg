// Fact: projecting a nested inner record field through a shared borrow preserves its exact static upper bound without moving either record, discharging exact subtraction 72u64 - quota across all nine places.
// Place: match_join (invalid twin). Inner field bound is widened to quota <= 73, and the projected field carries an opaque `requires seed <= 73` value, so the widened bound is all the checker knows: exact subtraction 72u64 - quota may underflow.
// Expected diagnostic: exact subtraction underflow
data Inner where quota <= 73, {
    quota: u64;
    tag: u64;
}

data Outer {
    inner: Inner;
    header: u64;
}

machine evaluate(seed: u64, flag: bool) -> u64
requires seed <= 73
{
    let outer: Outer = Outer {
        inner: Inner { quota: seed, tag: 7 },
        header: 10,
    };
    let view: &Outer = match flag {
        true -> &outer
        false -> &outer
    };
    let quota: u64 = view.inner.quota;
    let diff: u64 = 72u64 - quota;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate(30, true);
    transition diff == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
