// Fact: 8-bit unsigned saturating addition lhs +| rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Place: const name. The bounds and sum limits reference declared symbolic constants.
// Invalid control: lhs upper bound widened to 85u8, allowing sum up to 105u8 and failing exact headroom subtraction.
// Expected rejection: may overflow `u8`

const LHS_MIN: u8 = 40u8;
const LHS_MAX: u8 = 85u8;
const RHS_MIN: u8 = 10u8;
const RHS_MAX: u8 = 20u8;
const SUM_MIN: u8 = 50u8;
const SUM_MAX: u8 = 100u8;

machine add_const(lhs: u8, rhs: u8) -> i32
    requires lhs >= LHS_MIN && lhs <= LHS_MAX;
    requires rhs >= RHS_MIN && rhs <= RHS_MAX;
{
    let a: u8 in Saturating = lhs as u8 in Saturating;
    let b: u8 in Saturating = rhs as u8 in Saturating;
    let s_sat: u8 in Saturating = a + b;
    let sum: u8 = s_sat as u8;
    let headroom: u8 = SUM_MAX - sum;
    let margin: u8 = sum - SUM_MIN;
    transition sum == 75u8 && headroom + margin == 50u8 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = add_const(60u8, 15u8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
