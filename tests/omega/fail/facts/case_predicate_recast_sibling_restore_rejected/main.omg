// A sibling overwritten through a recast view formed before the window cannot restore the predicate.
data Interval<const Bound: u64> [copy]
    requires (self in Interval::Empty)
        || ((self in Interval::Range) && self.lo <= self.hi && self.hi <= Bound)
{
    case Empty;
    case Range(lo: u64, hi: u64);
}
machine restore(span: &mut Interval<32>)
    requires span in Interval::Range
{
    let view: &mut i64 = &mut span.lo as &mut i64;
    let saved_hi: u64 = span.hi;
    span.hi = 0;
    view = 31;
    span.hi = saved_hi;
}
machine main() {
    let mut span: Interval<32> = Interval::Range { lo: 17, hi: 21 };
    restore(&mut span);
}
