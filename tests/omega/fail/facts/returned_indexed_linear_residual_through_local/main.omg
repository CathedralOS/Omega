// Seed.code == 7 survives into the unconsumed element of a returned array owner; consuming element zero preserves the original residual claim.
// Expected exit: 0
const SEED_CODE: u64 = 8;
data Seed [copy] { code: u64; }
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt)
requires receipt.code == 7
{
    receipt.code = 0;
}
data Pair { items: [Receipt; 2]; }
machine issue(code: u64) -> Pair
ensures result.items[0].code == 7 && result.items[1].code == code
{
    Pair { items: [Receipt { code: 7 }, Receipt { code: code }] }
}
machine consume(receipt: Receipt) -> u64
requires receipt.code == 7
ensures result == 7
{
    receipt.code
}
machine main() crashes Trap {
    let seed: Seed = Seed { code: SEED_CODE };
    let difference: u64 = consume(issue(seed.code).items[0]) - 7;
    transition difference == 0 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
