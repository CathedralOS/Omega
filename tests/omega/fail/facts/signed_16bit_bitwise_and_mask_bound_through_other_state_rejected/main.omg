// Fact: 16-bit signed bitwise AND mask raw & 63i16 with bounded interval 40i16 <= masked <= 63i16 establishes 40i16 <= masked <= 63i16 across all nine places so exact subtractions 63i16 - masked and masked - 40i16 are safe.
// Invalid: widened mask 127 produces forwarded == 116 > 63, failing verify_masked requires contract.

machine compute_mask(raw: i16) -> i16
    requires raw >= 116 && raw <= 116
{
    raw & 127i16
}

machine verify_masked(masked: i16) -> i32
    requires masked >= 40 && masked <= 63
{
    let headroom: i16 = 63 - masked;
    let margin: i16 = masked - 40;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

machine main() crashes Trap {
    let raw: i16 = 116;
    let masked: i16 = compute_mask(raw);
    transition true {
        true -> step(masked)
        _ -> bad()
    }
    machine step(forwarded: i16) {
        let check: i32 = verify_masked(forwarded);
        transition check == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
