machine build(builder: &mut Build) {
    Build::application(builder, "fixed_layout_byte_roundtrip_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, x86_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_entry);
    Build::select_provider<SelectedDecode, X86Decode>(builder, windows_x86_64);
    Build::select_provider<SelectedDecode, X86Decode>(builder, linux_x86_64);
    Build::select_provider<SelectedDecode, ArmDecode>(builder, macos_arm64);
    Build::select_provider<SelectedDecode, ArmDecode>(builder, linux_arm64);
}
