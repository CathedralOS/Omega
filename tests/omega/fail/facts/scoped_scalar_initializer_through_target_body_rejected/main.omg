// A const-generic scoped domain family proves a literal initializer against the exact instance it was declared with, and the consumed value is 3.
// Expected exit: 0
domain<const Bound: u64> u64::BelowIndex<Bound>(value) requires value < Bound;
// Place: another target body. Each of the four hosted targets establishes the scoped instance.
machine verify(observed: u64 in BelowIndex<4>, flag: bool) crashes Trap {
    transition (flag && (observed as u64) == 3) || (!flag && (observed as u64) == 3) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
windows_x86_64 machine exercise(flag: bool) crashes Trap {
    let scoped: u64 in BelowIndex<4> = 4;
    verify(scoped, flag);
}
linux_x86_64 machine exercise(flag: bool) crashes Trap {
    let scoped: u64 in BelowIndex<4> = 3;
    verify(scoped, flag);
}
macos_arm64 machine exercise(flag: bool) crashes Trap {
    let scoped: u64 in BelowIndex<4> = 3;
    verify(scoped, flag);
}
linux_arm64 machine exercise(flag: bool) crashes Trap {
    let scoped: u64 in BelowIndex<4> = 3;
    verify(scoped, flag);
}
machine main() crashes Trap { exercise(true); exercise(false); }
