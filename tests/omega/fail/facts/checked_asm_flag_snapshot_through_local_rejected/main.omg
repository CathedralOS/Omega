// Expected exit: 0.
// Subtraction establishes ZF; a structured snapshot carries that bit to a label.
machine main() crashes Trap {
 let mut snapshot: u64 = 0;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 1;
  sub eax, 1;
  pushfq snapshot;
  jmp observed;
 observed requires (snapshot & 64u64) == 64u64:
  nop
 }
 let local_snapshot: u64 = snapshot ^ 64u64;
 asm { observed requires (local_snapshot & 64u64) == 64u64: nop }
 transition (local_snapshot & 64u64) == 64u64 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
