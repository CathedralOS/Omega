// A selected open index operation records the distributivity law its trait declares, so a
// generic body takes a value indexed `A * (B + C)` as `A * B + A * C`, and the call records
// that identity.
// Production: commutative semiring. Commutativity and associativity compose with the law,
// so `(A + B) * (C + D)` and `D * B + C * A + A * D + B * C` are one polynomial.
// Expected exit: 0
domain<T, const I: u64> T::Indexed<I>;

trait IndexSemiring {
    operator + add(a: u64, b: u64) -> u64 terminates;
    operator * multiply(a: u64, b: u64) -> u64 terminates;
    machine add_comm(a: u64, b: u64)
    ensures add(a, b) == add(b, a);
    machine add_assoc(a: u64, b: u64, c: u64)
    ensures add(add(a, b), c) == add(a, add(b, c));
    machine multiply_assoc(a: u64, b: u64, c: u64)
    ensures multiply(multiply(a, b), c) == multiply(a, multiply(b, c));
    machine distribute(a: u64, b: u64, c: u64)
    ensures multiply(a, add(b, c)) == add(multiply(a, b), multiply(a, c));
}

// Both selected operations are constant three: normalization consumes the laws the
// conformance proves, not integer arithmetic.
machine plus_index(a: u64, b: u64) -> u64
satisfies IndexSemiring::add as Canonical
ensures result == 3
{
    transition { _ -> 3 }
}

machine times_index(a: u64, b: u64) -> u64
satisfies IndexSemiring::multiply as Canonical
ensures result == 3
{
    transition { _ -> 3 }
}

machine plus_index_comm(a: u64, b: u64)
satisfies IndexSemiring::add_comm as Canonical
requires plus_index(a, b) == plus_index(b, a)
ensures plus_index(a, b) == plus_index(b, a)
{
}

machine plus_index_assoc(a: u64, b: u64, c: u64)
satisfies IndexSemiring::add_assoc as Canonical
requires plus_index(plus_index(a, b), c) == plus_index(a, plus_index(b, c))
ensures plus_index(plus_index(a, b), c) == plus_index(a, plus_index(b, c))
{
}

machine times_index_assoc(a: u64, b: u64, c: u64)
satisfies IndexSemiring::multiply_assoc as Canonical
requires times_index(times_index(a, b), c) == times_index(a, times_index(b, c))
ensures times_index(times_index(a, b), c) == times_index(a, times_index(b, c))
{
}

machine times_index_distribute(a: u64, b: u64, c: u64)
satisfies IndexSemiring::distribute as Canonical
requires times_index(a, plus_index(b, c)) == plus_index(times_index(a, b), times_index(a, c))
ensures times_index(a, plus_index(b, c)) == plus_index(times_index(a, b), times_index(a, c))
{
}

Canonical satisfies IndexSemiring
{
    machine add(a: u64, b: u64) -> u64
    terminates {
        plus_index(a, b)
    }
    machine multiply(a: u64, b: u64) -> u64
    terminates {
        times_index(a, b)
    }
    machine add_comm(a: u64, b: u64)
    ensures plus_index(a, b) == plus_index(b, a) {
        plus_index_comm(a, b);
    }
    machine add_assoc(a: u64, b: u64, c: u64)
    ensures plus_index(plus_index(a, b), c) == plus_index(a, plus_index(b, c)) {
        plus_index_assoc(a, b, c);
    }
    machine multiply_assoc(a: u64, b: u64, c: u64)
    ensures times_index(times_index(a, b), c) == times_index(a, times_index(b, c)) {
        times_index_assoc(a, b, c);
    }
    machine distribute(a: u64, b: u64, c: u64)
    ensures times_index(a, plus_index(b, c)) == plus_index(times_index(a, b), times_index(a, c)) {
        times_index_distribute(a, b, c);
    }
}

// The body needs both products to be one polynomial for every conformance of the trait:
// each sum factor expands, and the monomials and their factors sort.
machine rearrange<const A: u64, const B: u64, const C: u64, const D: u64, Algebra satisfies IndexSemiring>(
    raw: i64
) -> i64 {
    let source: i64 in Indexed<(A + B) * (C + D)> = raw as i64 in Indexed<(A + B) * (C + D)>;
    let moved: i64 in Indexed<D * B + C * A + A * D + B * C> = source;
    moved as i64
}

machine main() crashes Trap {
    let raw: i64 = 41;
    let moved: i64 = rearrange<2, 3, 4, 5, Canonical>(raw);
    transition moved == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
