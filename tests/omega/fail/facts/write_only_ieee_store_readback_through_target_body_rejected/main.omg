// Fact: an IEEE f64 computed and stored through a write-only borrow (&write) preserves its exact bit pattern on readback, satisfying the 0.75 comparison across all nine places
// Invalid: the store observes the write-only referent. Place: another target body.
// Expected diagnostic: reads write-only parameter

machine store(r: &write f64) { r = 6.0 / 8.0; let _x: f64 = r; }

boundary trait SelectedExpected {
    machine expected() -> f64 reaches
;
}
CheckedExpected satisfies SelectedExpected {
    machine expected() -> f64
{ 0.75 }
}




machine main() crashes Trap {
    let mut slot: f64;
    store(&write slot);
    let v: f64 = slot;
    transition v == SelectedExpected::expected() { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
