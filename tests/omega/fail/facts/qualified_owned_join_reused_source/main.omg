// Joining a predicate-qualified value transfers its source exactly once.
data Region { base: addr; length: u64; }
let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;
domain Region::Bounded(region)
requires no_wrap(region.base, region.length);
machine consume(region: Region in Bounded) {}
machine reuse(whole: Region in Bounded, flag: bool) {
    let selected: Region in Bounded = match flag { true -> whole, false -> whole };
    consume(selected);
    consume(whole);
}
