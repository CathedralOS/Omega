// Expected exit: 0.
// The checked seed-2 mov/sub/jnz CFG falls through with eax == 0.
// This twin keeps the ranked-decrease witness and breaks only the fallthrough.
machine main() terminates by eax -> Nat::Descending; crashes Trap {
 let seed: u32 = 2;
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, seed;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 1:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
