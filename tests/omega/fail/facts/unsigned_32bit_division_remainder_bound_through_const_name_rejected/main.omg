// Fact: A 32-bit unsigned u32 remainder operation (dividend % divisor where divisor >= 16u32 && divisor <= 16u32) establishes rem <= 15u32 so exact 32-bit subtraction 15u32 - rem is proved underflow-free across all nine places.
// Place: const name. The bounds and remainder limits reference declared symbolic constants.
// Invalid control: divisor upper bound widened to 17u32, allowing rem as high as 16u32 and failing subtraction 15u32 - rem.
// Expected rejection: may overflow `u32`

const DIVISOR_EXACT: u32 = 16u32;
const DIVISOR_MAX: u32 = 17u32;
const MAX_REMAINDER: u32 = 15u32;

machine remainder_const(dividend: u32, divisor: u32) -> i32
    requires divisor >= DIVISOR_EXACT && divisor <= DIVISOR_MAX;
{
    let rem: u32 = dividend % divisor;
    let headroom: u32 = MAX_REMAINDER - rem;
    transition rem == 11u32 && headroom == 4u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_const(43u32, 16u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
