// Fact: querying size_of and align_of on a multi-variant case type establishes its exact
// discriminant-plus-payload layout geometry (size 16, align 8), discharging exact
// subtraction size - (align * 2u64) == 0u64.
// Place: target_body.
// Invalid: the payload variant is replaced by a payloadless case, so the type
// geometry becomes size 4 / align 4 and the subtraction has bounds [-4, -4].
// Expected exit: 0

data Packet {
    case Empty;
    case Other;
}

boundary trait SelectedComputeGeometry {
    machine compute_geometry() -> u64 reaches
;
}
CheckedComputeGeometry satisfies SelectedComputeGeometry {
    machine compute_geometry() -> u64
{
    size_of<Packet>() - (align_of<Packet>() * 2u64)
}
}







machine probe() -> u64 {
    SelectedComputeGeometry::compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
