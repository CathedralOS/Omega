// Route control: the declared float comparison is selected by exact operand
// formats. `left == right` with an f64 left operand and an f32 right operand has
// no declared operator and no builtin route, so checking refuses.
// Expected diagnostic: builtin `==` cannot combine `f64` and `f32`
machine main() crashes Trap {
    let mut left: f64 = 212.0;
    let mut right: f32 = 2.0;
    let mut equal: bool = left == right;
    transition equal { true -> bad() _ -> done() }
    machine done() {}
    machine bad() { crash Trap; }
}
