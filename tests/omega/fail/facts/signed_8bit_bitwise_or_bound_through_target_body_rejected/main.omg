// Fact: 8-bit signed bitwise OR base | 32i8 with bounded interval 40i8 <= combined <= 63i8 establishes 40i8 <= combined <= 63i8 across all nine places so exact subtractions 63i8 - combined and combined - 40i8 are safe.
// Expected exit: 1

machine verify_combined(value: i8) -> i8
requires value >= 40i8 && value <= 63i8
{
    let headroom: i8 = 63i8 - value;
    let margin: i8 = value - 40i8;
    transition headroom == 11i8 && margin == 12i8 {
        true -> 0i8
        _ -> 1i8
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(base: i8) -> i8
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(base: i8) -> i8
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let combined: i8 = base | 32i8;
        transition combined >= 40i8 && combined <= 64i8 {
            true -> step(combined)
            _ -> bad()
        }
        machine step(c: i8) -> i8 {
            verify_combined(c)
        }
        machine bad() -> i8 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(base: i8) -> i8
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let combined: i8 = base | 32i8;
        transition combined >= 40i8 && combined <= 64i8 {
            true -> step(combined)
            _ -> bad()
        }
        machine step(c: i8) -> i8 {
            verify_combined(c)
        }
        machine bad() -> i8 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: i8 = SelectedProbe::exercise(20i8);
    transition rc == 0i8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
