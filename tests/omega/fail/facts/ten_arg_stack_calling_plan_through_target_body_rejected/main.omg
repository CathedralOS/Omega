// Fact: a 10-argument machine call across register and stack ABI lanes preserves the 10th stack-spilled argument bound 40u64 <= a10 <= 80u64 across all nine places so 80u64 - carried and carried - 40u64 are safe.
// Place: target_body. Each hosted target body executes the 10-argument call across target ABI lanes and verifies the bounds.
// Expected exit: 0
machine verify_carried(carried: u64) -> u64
    requires carried >= 40 && carried <= 80
{
    let head: u64 = 80 - carried;
    let tail: u64 = carried - 40;
    head + tail
}

machine relay_ten(
    a1: u64, a2: u64, a3: u64, a4: u64, a5: u64,
    a6: u64, a7: u64, a8: u64, a9: u64, a10: u64
) -> u64
    ensures result == a10
{
    a10
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(v10: u64) -> u64
        reaches SelectedBodyCheck crashes Trap
        requires v10 >= 40 && v10 <= 81;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(v10: u64) -> u64
        reaches SelectedBodyCheck crashes Trap
        requires v10 >= 40 && v10 <= 81
    {
        SelectedBodyCheck::require_tag(17u64);
        let carried: u64 = relay_ten(1, 2, 3, 4, 5, 6, 7, 8, 9, v10);
        verify_carried(carried)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(v10: u64) -> u64
        reaches SelectedBodyCheck crashes Trap
        requires v10 >= 40 && v10 <= 81
    {
        SelectedBodyCheck::require_tag(29u64);
        let carried: u64 = relay_ten(1, 2, 3, 4, 5, 6, 7, 8, 9, v10);
        verify_carried(carried)
    }
}









machine evaluate() -> u64
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(60)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: u64 = evaluate();
    transition res == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
