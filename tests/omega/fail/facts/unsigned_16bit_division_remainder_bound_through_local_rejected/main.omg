// Fact: a 16-bit unsigned u16 remainder operation (dividend % divisor where divisor >= 16u16 && divisor <= 16u16) establishes rem <= 15u16 so exact 16-bit subtraction 15u16 - rem is proved underflow-free across all nine places.
// Invalid: divisor upper bound widened to 17u16 so rem can be 16u16, underflowing subtraction from 15u16.
// Expected exit: 0

machine rem_local(dividend: u16, divisor: u16) -> u16
requires dividend >= 43 && dividend <= 43 && divisor >= 16 && divisor <= 17
{
    let local_dividend: u16 = dividend;
    let local_divisor: u16 = divisor;
    let rem: u16 = local_dividend % local_divisor;
    15u16 - rem
}

machine probe() -> u16 {
    rem_local(43u16, 16u16)
}

machine main() crashes Trap {
    transition probe() == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
