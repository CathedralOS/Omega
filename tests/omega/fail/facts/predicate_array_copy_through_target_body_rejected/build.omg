machine build(builder: &mut Build) {
    Build::select_provider<SelectedEvaluate, CheckedEvaluate>(builder, windows_x86_64);
    Build::select_provider<SelectedEvaluate, CheckedEvaluate>(builder, linux_x86_64);
    Build::select_provider<SelectedEvaluate, CheckedEvaluate>(builder, macos_arm64);
    Build::select_provider<SelectedEvaluate, CheckedEvaluate>(builder, linux_arm64);

    Build::application(builder, "predicate_array_copy_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
