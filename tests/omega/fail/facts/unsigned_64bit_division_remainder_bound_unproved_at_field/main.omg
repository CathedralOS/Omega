// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: field. The bounded operands are stored within a nominal record field.
// Invalid control: divisor upper bound widened to 65u64, allowing rem as high as 64u64 and failing subtraction 63u64 - rem.
// Expected rejection: may overflow `u64`

data Operands {
    dividend: u64;
    divisor: u64;
}

machine remainder_field(dividend: u64, divisor: u64) -> i32
    requires divisor >= 64u64 && divisor <= 65u64;
{
    let ops: Operands = Operands { dividend: dividend, divisor: divisor };
    let rem: u64 = ops.dividend % ops.divisor;
    let headroom: u64 = 63u64 - rem;
    transition rem == 13u64 && headroom == 50u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_field(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
