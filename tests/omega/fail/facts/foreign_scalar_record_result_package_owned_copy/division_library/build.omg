use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::package(builder, "division_library");
 Build::select_provider<main::IntegerDivision, main::HostDivision>(builder, windows_x86_64);
 Build::select_provider<main::IntegerDivision, main::HostDivision>(builder, linux_x86_64);
 Build::select_provider<main::IntegerDivision, main::HostDivision>(builder, macos_arm64);
 Build::select_provider<main::IntegerDivision, main::HostDivision>(builder, linux_arm64);
 Build::bind<main::RawDivision::divide>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_lldiv" } });
 Build::bind<main::RawDivision::divide>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "lldiv", version: "GLIBC_2.2.5" } });
 Build::bind<main::RawDivision::divide>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "lldiv", version: "GLIBC_2.17" } });
 Build::bind<main::RawDivision::divide>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "api-ms-win-crt-utility-l1-1-0.dll", export: "lldiv" } });
}
