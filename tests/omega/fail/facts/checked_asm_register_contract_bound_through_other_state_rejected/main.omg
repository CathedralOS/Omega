// A checked asm block (or target-scoped checked assembly helper) with explicit register operand bindings and contract (result <= 96u64) establishes the post-assembly bound, discharging exact subtraction 96u64 - result.
// Expected rejection: exact arithmetic in machine main state evaluate local diff may overflow `u64`.
boundary trait SelectedReadAsm {
    machine read_asm() -> u64 reaches
ensures result <= 97u64;
}
LinuxX8664ReadAsm satisfies SelectedReadAsm {
    machine read_asm() -> u64 ensures result <= 97u64
{
    let mut val: u32 = 0;
    asm {
    entry:
        mov eax, 97;
        jmp done;
    done requires eax <= 97:
        mov val, eax
    }
    val as u64
}
}



LinuxArm64ReadAsm satisfies SelectedReadAsm {
    machine read_asm() -> u64 ensures result <= 97u64
{
    97u64
}
}



machine main() crashes Trap {
    transition { _ -> evaluate(SelectedReadAsm::read_asm()) }
    machine evaluate(val: u64) requires val <= 97u64 {
        let diff: u64 = 96u64 - val;
        transition diff == 0u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
