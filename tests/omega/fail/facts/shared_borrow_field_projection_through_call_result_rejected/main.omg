// Fact: projecting a bounded field through a shared borrow preserves its exact static upper bound without moving the backing record, discharging exact subtraction 90u64 - used across all nine places.
// Place: call_result (invalid twin). Field bound is widened to used <= 91, and the projected field carries an opaque `requires seed <= 91` value, so the widened bound is all the checker knows: exact subtraction 90u64 - used may underflow.
// Expected diagnostic: exact subtraction underflow
data Window requires used <= 91, {
    used: u64;
}

machine borrow_window(w: &Window) -> &Window {
    w
}

machine evaluate(seed: u64) -> u64
requires seed <= 91
{
    let window: Window = Window { used: seed };
    let view: &Window = borrow_window(&window);
    let used: u64 = view.used;
    let diff: u64 = 90u64 - used;
    diff
}

machine main() crashes Trap {
    let diff: u64 = evaluate(40);
    transition diff == 50 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
