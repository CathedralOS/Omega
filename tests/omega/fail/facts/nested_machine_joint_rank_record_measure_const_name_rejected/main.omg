// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Progress [copy] { lower: u64; upper: u64; canary: u64; }
measure Progress::Remaining(value: Progress) -> u64 { value.upper - value.lower }
const Limit: u64 = 7;
machine count(counter: &mut u64, remaining: Progress) crashes Trap
requires remaining.lower <= remaining.upper && remaining.upper <= 7
terminates
terminates by remaining -> Progress::Remaining
{
    transition remaining.lower < remaining.upper {
        true -> forward(remaining, counter)
        false -> finish(remaining.lower, remaining.upper, remaining.canary)
    }
    machine forward(pending: Progress, counter: &mut u64) crashes Trap
    requires pending.lower < pending.upper && pending.upper <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Progress = Progress { lower: pending.lower + 0, upper: pending.upper, canary: pending.canary };
        transition { _ -> count(counter, next) }
    }
    machine finish(lower: u64, upper: u64, canary: u64) crashes Trap {
        transition lower == upper && canary == 641 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    transition select {
        true -> count(counter, Progress { lower: 0, upper: Limit, canary: 641 })
        false -> count(counter, Progress { lower: 7, upper: 7, canary: 641 })
    }
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
