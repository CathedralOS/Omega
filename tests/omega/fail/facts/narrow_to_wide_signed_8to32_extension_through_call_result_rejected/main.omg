// Fact: sign-extending a bounded 8-bit signed i8 value (narrow >= 30i8 && narrow <= 100i8) to i32 (narrow as i32) preserves the exact interval (wide >= 30i32 && wide <= 100i32), discharging exact 32-bit signed subtractions 100i32 - wide and wide - 30i32 across all nine places.
// Place: call result. The wide value is received from a helper call returning the sign-extended result.
// Invalid control: narrow upper bound widened to 101i8, allowing wide up to 101i32 and failing exact headroom check.
// Expected rejection: not provably representable

machine widen(n: i8) -> i32
    requires n >= 30i8 && n <= 101i8;
    ensures result >= 30i32 && result <= 101i32;
{
    n as i32
}

machine extend_call_result(narrow: i8) -> i32
    requires narrow >= 30i8 && narrow <= 101i8;
{
    let wide: i32 = widen(narrow);
    let headroom: i32 = 100i32 - wide;
    let margin: i32 = wide - 30i32;
    let check_h: u32 = headroom as u32;
    let check_m: u32 = margin as u32;
    transition wide == 60i32 && headroom + margin == 70i32 && check_h + check_m == 70u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = extend_call_result(60i8);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
