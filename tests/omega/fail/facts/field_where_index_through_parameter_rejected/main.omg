// No standing where bound. The call cannot prove `read_at`'s requires.

data Main {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine read_at(main: &Main, index: u64) -> i32 in Wrapping
requires 0 <= index && index <= 3
{
    main.arr[index + 1]
}

machine use(main: &Main) -> i32 in Wrapping {
    read_at(main, main.k)
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = use(main);
    transition { _ -> successor(main) }
    state successor(main: &mut Main) {
        main.r = use(main);
        main.hits = main.r;
    }
}
