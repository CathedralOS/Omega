// Fact: 64-bit unsigned bitwise XOR raw ^ 15u64 with bounded interval 40u64 <= xored <= 63u64 establishes 40u64 <= xored <= 63u64 across all nine places so exact subtractions 63u64 - xored and xored - 40u64 are safe.
// Invalid: widened XOR operand 127 produces xored == 68 > 63, failing verify_xored requires contract.

machine compute_xor(raw: u64) -> u64
    requires raw >= 59 && raw <= 59
{
    raw ^ 127u64
}

machine verify_xored(xored: u64) -> i32
    requires xored >= 40 && xored <= 63
{
    let headroom: u64 = 63 - xored;
    let margin: u64 = xored - 40;
    let total: u64 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

data XorCarrier {
    xored: u64;
}

machine main() crashes Trap {
    let raw: u64 = 59;
    let carrier: XorCarrier = XorCarrier { xored: compute_xor(raw) };
    let check: i32 = verify_xored(carrier.xored);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
