// Fact: 64-bit unsigned bitwise OR base | 32u64 with bounded interval 40u64 <= combined <= 63u64 establishes 40u64 <= combined <= 63u64 across all nine places so exact subtractions 63u64 - combined and combined - 40u64 are safe.
// Place: match join (invalid twin). The false match arm yields 64u64 so joined result reaches 127 > 63, failing contract for verify_combined.
// Expected diagnostic: cannot prove requires contract for call

machine choose_base(flag: bool) -> u64
ensures result >= 16 && result <= 64
{
    match flag {
        true -> 20u64,
        false -> 64u64,
    }
}

machine verify_combined(combined: u64) -> u64
requires combined >= 40 && combined <= 63
{
    let headroom: u64 = 63u64 - combined;
    let margin: u64 = combined - 40u64;
    headroom + margin
}

// The flag arrives as a formal parameter, so the operand is bounded by what
// holds for every flag; a constant actual would expose the helper's exact result.
machine bitwise_or_join(flag: bool) -> u64 {
    let base: u64 = choose_base(flag);
    let combined: u64 = base | 32u64;
    verify_combined(combined)
}

machine probe() -> u64 {
    bitwise_or_join(true)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
