// The const_name carrier is u8, so membership in the u16 domain Small is ill-formed and must reject.
// A u8 value is a member of the u8 domain Small (self <= 10) only on its own u8 carrier, so 10 - value is exact.

domain u16::Small requires self <= 10;

const LEVEL: u8 = 7;

machine headroom() -> u8 requires LEVEL in Small {
    10 - LEVEL
}

machine main() crashes Trap {
    transition headroom() == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
