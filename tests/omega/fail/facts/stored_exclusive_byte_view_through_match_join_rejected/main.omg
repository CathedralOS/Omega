// An exclusive byte view stored in a fixed array preserves its one-byte extent and byte 19 through owned transport.
// Place: match_join.
// Expected rejection: the empty descriptor does not satisfy the read's live bound.
machine choose() -> bool { true }

machine main() crashes Trap {
    let mut backing: [u8; 1] = [19];
    let windows: [&mut [u8]; 1] = [&mut backing[0..0]];
    let selected: [&mut [u8]; 1] = match choose() {
        true -> windows
        false -> windows
    };
    let length: u64 = selected[0].len;
    let observed: bool = selected[0][0] == 19 && length == 1;
    transition observed {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
