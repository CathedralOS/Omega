// Every private arrival supplies an integer from 0 through 255, so exact narrowing to u8 preserves its value.
data Parts { prefix: u64; hi: u32 in Trapping; marker: u64; lo: u32 in Trapping; suffix: u64; }
machine pack(parts: &mut Parts) -> u8 {
    transition parts.hi < 17 { true -> second(&mut parts) false -> (0) }
    machine second(parts: &mut Parts) -> u8 {
        parts.marker = 99;
        transition parts.lo < 16 { true -> emit(&parts) false -> (0) }
    }
    machine emit(parts: &Parts) -> u8 { ((parts.hi * 16) + parts.lo) as u8 }
}
machine main() crashes Trap {
    let mut first_parts: Parts = Parts { prefix: 11, hi: 0, marker: 0, lo: 7, suffix: 17 };
    let mut second_parts: Parts = Parts { prefix: 11, hi: 14, marker: 0, lo: 7, suffix: 17 };
    let mut zero_parts: Parts = Parts { prefix: 11, hi: 0, marker: 0, lo: 0, suffix: 17 };
    let mut maximum_parts: Parts = Parts { prefix: 11, hi: 15, marker: 0, lo: 15, suffix: 17 };
    let mut outside_parts: Parts = Parts { prefix: 11, hi: 16, marker: 0, lo: 0, suffix: 17 };
    let first: u8 = pack(&mut first_parts);
    let second: u8 = pack(&mut second_parts);
    let zero: u8 = pack(&mut zero_parts);
    let maximum: u8 = pack(&mut maximum_parts);
    let outside: u8 = pack(&mut outside_parts);
    transition first == 7 && second == 231 && zero == 0 && maximum == 255 && outside == 0
        && first_parts.marker == 99 && second_parts.marker == 99 && zero_parts.marker == 99 && maximum_parts.marker == 99 && outside_parts.marker == 0
        && first_parts.prefix == 11 && first_parts.suffix == 17 && second_parts.prefix == 11 && second_parts.suffix == 17
        && zero_parts.prefix == 11 && zero_parts.suffix == 17 && maximum_parts.prefix == 11 && maximum_parts.suffix == 17 && outside_parts.prefix == 11 && outside_parts.suffix == 17 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
