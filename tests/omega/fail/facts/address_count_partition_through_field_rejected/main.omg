// The bounded count and address ceiling justify an exact split with disjoint content equal to the original interval.
// Intended rejection. Address/count partition preserves exact disjoint interval content.
// Numeric interval partition only: this local carrier grants no storage rights.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { base: addr; length: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet {
        start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat
    }
}
data Request [copy] { count: u64; }
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, length: u64, ceiling: addr) -> Pieces
requires embed(whole.base) + embed(whole.length) <= embed(ceiling)
ensures Owned::content(old(&whole)) == separate(
    Owned::content(&result.right), Owned::content(&result.left))
{
    let request: Request = Request { count: length };
    let left: Region in Owned = Region { base: whole.base, length: request.count };
    let right: Region in Owned = Region { base: whole.base + request.count, length: whole.length - request.count };
    drop(whole);
    Pieces { left: left, right: right }
}
machine main() crashes Trap {
    let whole: Region in Owned = Region { base: 10, length: 80 };
    let pieces: Pieces = split(whole, 20, 100);
    let correct: bool = pieces.left.base == 10 && pieces.left.length == 20
        && pieces.right.base == 30 && pieces.right.length == 60;
    let { left, right } = pieces;
    drop(left);
    drop(right);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
