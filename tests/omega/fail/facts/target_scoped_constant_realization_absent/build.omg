machine build(builder: &mut Build) {
    Build::select_provider<SelectedTargetProvidersProviderDefaults, CheckedTargetProvidersProviderDefaults>(builder, linux_x86_64);
    Build::select_provider<SelectedTargetProvidersProviderDefaults, CheckedTargetProvidersProviderDefaults>(builder, windows_x86_64);
    Build::select_provider<SelectedTargetProvidersProviderDefaults, CheckedTargetProvidersProviderDefaults>(builder, linux_arm64);
    Build::select_provider<SelectedTargetProvidersProviderDefaults, CheckedTargetProvidersProviderDefaults>(builder, macos_arm64);
    Build::select_provider<SelectedExpected, LinuxX8664Expected>(builder, linux_x86_64);
    Build::select_provider<SelectedExpected, WindowsX8664Expected>(builder, windows_x86_64);
    Build::select_provider<SelectedExpected, LinuxX8664Expected>(builder, linux_arm64);
    Build::select_provider<SelectedExpected, WindowsX8664Expected>(builder, macos_arm64);

    Build::application(builder, "target_scoped_constant_realization");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
