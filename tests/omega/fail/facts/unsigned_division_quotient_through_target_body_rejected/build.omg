machine build(builder: &mut Build) {
    Build::application(builder, "unsigned_division_quotient_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<SelectedComputation, X86Computation>(builder, linux_x86_64);
    Build::select_provider<SelectedComputation, X86Computation>(builder, windows_x86_64);
    Build::select_provider<SelectedComputation, ArmComputation>(builder, linux_arm64);
    Build::select_provider<SelectedComputation, ArmComputation>(builder, macos_arm64);
}
