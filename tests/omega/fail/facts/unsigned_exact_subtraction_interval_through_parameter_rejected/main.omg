// Fact: Subtracting two bounded unsigned u64 values (minuend >= 80u64 && minuend <= 100u64 and subtrahend >= 20u64 && subtrahend <= 30u64) establishes the exact post-subtraction interval (diff >= 50u64 && diff <= 80u64), discharging both diff - 50u64 and 80u64 - diff across all nine places.
// Place: parameter. The difference of the unsigned subtraction is forwarded as a machine parameter.
// Expected exit: 0
machine forward_param(d: u64) -> u64
    ensures result == d
{
    d
}

machine subtract_parameter(minuend: u64, subtrahend: u64) -> i32
    requires minuend >= 79 && minuend <= 100 && subtrahend >= 20 && subtrahend <= 30
{
    let diff: u64 = minuend - subtrahend;
    let transported: u64 = forward_param(diff);
    let lower: u64 = transported - 50;
    let upper: u64 = 80 - transported;
    let sum: u64 = lower + upper;
    sum as i32
}

machine evaluate() -> i32 {
    subtract_parameter(90, 25)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 30 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
