// Fact: For a u64 count from 1 through 4095, the exact u16 byte count count * 2 + 0 has remainder zero modulo 2 and constructs an EvenLength.
// Expected exit: 0
const OFFSET: u64 = 1;
data EvenLength where length % 2 == 0 { length: u16; }
machine observe(value: EvenLength) -> u16 { value.length }
const SCALE: u64 = 2;
machine probe(count: u64) -> u16 requires count > 0 && count < 4096 {
    let length: u16 = (count * SCALE + OFFSET) as u16;
    observe(EvenLength { length: length })
}
machine main() crashes Trap {
    transition probe(7) == 14 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
