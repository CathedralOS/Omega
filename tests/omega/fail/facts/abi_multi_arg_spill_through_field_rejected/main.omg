// Fact: a ten-argument weighted scalar call preserves exact positional argument order across register and stack ABI slots when subtracting 100u64.
// Place: field (invalid twin).
// Expected diagnostic: exact subtraction underflow

data TenArgs where
    f1 == 1u64, f2 == 2u64, f3 == 3u64, f4 == 4u64, f5 == 5u64,
    f6 == 6u64, f7 == 7u64, f8 == 8u64, f9 == 24u64, f10 == 39u64
{
    f1: u64;
    f2: u64;
    f3: u64;
    f4: u64;
    f5: u64;
    f6: u64;
    f7: u64;
    f8: u64;
    f9: u64;
    f10: u64;
}

machine weighted_ten_sum(
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64
) -> u64
requires
    a1 == 1u64 && a2 == 2u64 && a3 == 3u64 && a4 == 4u64 && a5 == 5u64 &&
    a6 == 6u64 && a7 == 7u64 && a8 == 8u64 && a9 == 24u64 && a10 == 39u64
ensures
    result == 99u64
{
    a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10
}

machine probe(args: TenArgs) -> u64 {
    let total: u64 = weighted_ten_sum(
        args.f1, args.f2, args.f3, args.f4, args.f5,
        args.f6, args.f7, args.f8, args.f9, args.f10
    );
    total - 100
}

machine main() crashes Trap {
    let args: TenArgs = TenArgs {
        f1: 1, f2: 2, f3: 3, f4: 4, f5: 5,
        f6: 6, f7: 7, f8: 8, f9: 24, f10: 39
    };
    transition probe(args) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
