// Logical right shift on a bounded u64 value by a bounded shift count establishes the exact post-shift interval, discharging exact subtraction shifted - 100u64.
// Invalid: successor state requires bound is weakened to 399..399, so 399 >> 2 == 99 underflows shifted - 100.
// Expected rejection: exact arithmetic in machine `main` state `compute` local `res` may overflow `u64`.

machine main() crashes Trap {
    transition 399 >= 399 && 399 <= 399 && 2 >= 2 && 2 <= 2 {
        true -> compute(399, 2)
        _ -> bad()
    }

    state compute(val: u64, shift: u64)
    requires val >= 399 && val <= 399 && shift >= 2 && shift <= 2
    {
        let shifted: u64 = val >> shift;
        let res: u64 = shifted - 100;
        transition res == 0 {
            true -> done()
            _ -> bad()
        }
    }

    state done() {}
    state bad() { crash Trap; }
}
