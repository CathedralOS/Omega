// A match on one evaluation of a copyable flag returns the exclusive loan of the selected primitive, writes 41 through that loan, and leaves the unselected primitive unchanged.
// Place: const_name. Reject twin: the source is used while that loan is live.
const DECIDE: bool = true;

machine choose(counter: &mut u64) -> bool
requires counter == 0
{
    counter = 1;
    DECIDE
}

machine main() crashes Trap {
    let mut chosen: i64 = 17;
    let mut other: i64 = 0;
    let mut visits: u64 = 0;
    let selected: &mut i64 = match choose(&mut visits) {
        true -> &mut chosen
        false -> &mut other
    };
    chosen = 7;
    selected = 41;
    let observed: i64 = selected;
    transition observed == 41 && chosen == 41 && other == 0 && visits == 1 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
