// A call precondition is a projection term. The call records that
// projection fact, and the caller reads the record.
// Place: other_machine.
// Expected exit: 0
data Mark [copy] { kept: bool; }

machine project(mark: Mark) -> bool
requires mark.kept
{
    mark.kept
}

machine hold(direct: bool) -> bool
requires direct == true
{
    true
}

machine observe(mark: Mark) -> bool
requires mark.kept
{
    project(mark)
}

machine relay(mark: Mark) -> bool
requires mark.kept
{
    observe(mark)
}

machine main() crashes Trap {
    let mark: Mark = Mark { kept: false };
    let direct: bool = relay(mark);
    transition hold(direct) {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
