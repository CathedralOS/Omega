// Fact: querying size_of and align_of on a two-field u64 structural record (Pair { lo: u64, hi: u64 }) establishes its exact layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Composition: ordinary call results supply a private arrival before the same subtraction.
// Expected exit: 0

data Pair {
    lo: u64;
}

machine query_size() -> u64 { size_of<Pair>() }
machine query_align() -> u64 { align_of<Pair>() }

machine main() crashes Trap {
    let s: u64 = query_size();
    let a: u64 = query_align();
    transition true {
        true -> compute(s, a)
        _ -> bad()
    }
    machine compute(size: u64, align: u64) {
        let diff: u64 = size - (align * 2u64);
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
