// A fixed-extent array [u64; 2] preserves its in-bounds index contract index < 2 and independent element values across all nine places.
// Invalid: the record constraint is weakened to index <= 2, so the field index may exceed length 2.
// Expected exit: 0
data Container where index <= 2 {
    values: [u64; 2];
    index: u64;
}

machine read_element(container: Container) -> u64 {
    container.values[container.index]
}

machine main() crashes Trap {
    let container: Container = Container { values: [19, 42], index: 1 };
    transition container.values[0] == 19 && container.values[1] == 42 && read_element(container) == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
