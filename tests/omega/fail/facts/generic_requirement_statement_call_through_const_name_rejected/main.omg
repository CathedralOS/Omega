// A statement-position call of the generic boundary requirement `Mark::record<T>` from a generic
// caller applies the caller's open `T` to the requirement's formals, so the provider's write of
// `label` into `hits` is observed after the call.
// Place: const_name.
// Expected exit: 0
boundary trait Mark {
    machine record<T>(value: &T, label: u64, hits: &mut u64) reaches;
}

Counting satisfies Mark {
    machine record<T>(value: &T, label: u64, hits: &mut u64) { hits = label; }
}

const MARK: u64 = 9;
const OTHER_MARK: u64 = 5;
const SUBJECT: i32 = 7;
const OTHER: u8 = 3;

machine notify<T>(value: &T, label: u64, hits: &mut u64) {
    Mark::record<T>(&label, label, hits);
}

machine main() crashes Trap {
    let subject: i32 = SUBJECT;
    let other: u8 = OTHER;
    let mut first: u64 = 0;
    let mut second: u64 = 0;
    notify<i32>(&subject, MARK, &mut first);
    notify<u8>(&other, OTHER_MARK, &mut second);
    transition first == MARK && second == OTHER_MARK { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
