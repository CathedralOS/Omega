// Changing the incoming descriptor must invalidate invocation identity.
data Descriptor { base: addr; length: u64; }

data Pair {
    first: Descriptor;
    second: Descriptor;
}

machine carry(first: Descriptor, second: Descriptor,
    remaining: u64) -> Pair
ensures result.first.base == first.base, result.second.base == second.base
terminates by remaining
{
    transition remaining > 0 {
        true -> carry(second, first, remaining - 1)
        false -> Pair { first: first, second: second }
    }
}

machine main() {}
