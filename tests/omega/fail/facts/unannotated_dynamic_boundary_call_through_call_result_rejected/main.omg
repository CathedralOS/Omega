// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
public boundary trait Mark {
    machine read() -> u64
        reaches Mark;
}
MarkerMark satisfies Mark {
    machine read() -> u64 { 7 }
}
trait ReadContract { machine read() -> u64 reaches Mark invokes Mark; }
Selected satisfies ReadContract { machine read() -> u64 { 7 } }
machine call_mark(selected: dyn ReadContract) -> u64 { ReadContract::read(selected) }

machine take() -> u64 reaches {
    call_mark(Selected as dyn ReadContract)
}
machine main() crashes Trap {
    let value: u64 = take();
    transition value == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
