use omega::language::core::activation;
machine main() crashes Trap {
    transition Activation::try_claim<8>(3) {
        ActivationClaimAttempt::Established { claim } -> live(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    state live(claim: ActivationClaim) {
        let mut owner: ActivationClaim = claim;
        let bytes: &mut [u8] = ActivationClaim::bytes(&mut owner);
        ActivationClaim::release(owner);
        let length: u64 = bytes.len;
        transition length == 3 { true -> done() false -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}
