// Fact: a 32-bit signed i32 remainder operation (dividend % divisor where dividend >= 0i32 && dividend <= 100i32, divisor >= 16i32 && divisor <= 16i32) establishes rem >= 0i32 && rem <= 15i32 so exact 32-bit signed subtraction 15i32 - rem is proved overflow-free across all nine places.
// Invalid: widening divisor <= 17i32 allows result 16i32, violating ensures contract in choose_rem. Place: match_join.
// Expected diagnostic: cannot prove ensures contract for exit from choose_rem

machine verify_rem(rem: i32) -> i32
requires rem >= 0i32 && rem <= 15i32
{
    let headroom: i32 = 15i32 - rem;
    0i32
}

machine choose_rem(flag: bool, dividend: i32, divisor: i32) -> i32
requires dividend >= 0i32 && dividend <= 100i32 && divisor >= 16i32 && divisor <= 17i32
ensures result >= 0i32 && result <= 15i32
{
    match flag {
        true -> dividend % divisor,
        false -> dividend % divisor,
    }
}

machine compute_join(dividend: i32, divisor: i32) -> i32
requires dividend >= 0i32 && dividend <= 100i32 && divisor >= 16i32 && divisor <= 17i32
{
    verify_rem(choose_rem(true, dividend, divisor))
}

machine probe() -> i32 {
    compute_join(43i32, 16i32)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
