// Fact: 64-bit signed bitwise AND mask raw & 63i64 with bounded interval 40i64 <= masked <= 63i64 establishes 40i64 <= masked <= 63i64 across all nine places so exact subtractions 63i64 - masked and masked - 40i64 are safe.
// Place: local (invalid twin). The raw lower bound is widened to 64i64 so masked reaches 0 < 40, failing contract for verify_masked.
// Expected diagnostic: cannot prove requires contract for call

machine verify_masked(masked: i64) -> i64
requires masked >= 40 && masked <= 63
{
    let headroom: i64 = 63i64 - masked;
    let margin: i64 = masked - 40i64;
    headroom + margin
}

machine bitwise_and_local(raw: i64) -> i64
requires raw >= 64 && raw <= 127
{
    let local_raw: i64 = raw;
    let local_mask: i64 = 63i64;
    let masked: i64 = local_raw & local_mask;
    verify_masked(masked)
}

machine probe() -> i64 {
    bitwise_and_local(116i64)
}

machine main() crashes Trap {
    transition probe() == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
