// A match subject is one evaluation of a computed root, the selected exclusive loan records that root, and the consumer writes 41 through that recorded loan.
// Place: call_result.
// The source is used while the loan is live.


machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = 1;
    0
}

machine select<'a>(chosen: &'a mut [i64; 2], other: &'a mut [i64; 2], visits: &mut u64) -> &'a mut i64 {
    match chosen[compute(visits)] {
        17 -> &mut chosen[0]
        _ -> &mut other[0]
    }
}

machine main() crashes Trap {
    let mut chosen: [i64; 2] = [17, 5];
    let mut other: [i64; 2] = [0, 8];
    let mut visits: u64 = 0;
    let selected: &mut i64 = select(&mut chosen, &mut other, &mut visits);
    chosen = [7, 7];
    selected = 41;
    transition selected == 41 && visits == 1 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
