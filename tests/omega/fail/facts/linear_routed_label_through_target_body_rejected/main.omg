// Fact: an issued linear claim can gain a route-free label without losing its issued qualification.
// Expected exit: 0
use omega::language::core::drop;

data Claim [linear] { value: u64; }
domain Claim::Issued established by issue;
domain Claim::Label;
domain Claim::Tagged = Claim::Issued & Claim::Label;
machine Claim::drop(claim: &mut Claim) { claim.value = 0; }
machine issue(value: u64) -> Claim in Issued { Claim { value: value } }
machine consume(claim: Claim in Issued & Label) -> u64 {
    let observed: u64 = claim.value;
    drop(claim);
    observed
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedLabel {
    machine label(claim: Claim in Issued) -> Claim in Tagged
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Label satisfies SelectedLabel {
    machine label(claim: Claim in Issued) -> Claim in Tagged
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        claim as Claim in Tagged
    }
}

ArmLabel satisfies SelectedLabel {
    machine label(claim: Claim in Issued) -> Claim in Tagged
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        claim as Claim in Tagged
    }
}


machine exercise(select: bool) -> u64 { consume(SelectedLabel::label(Claim { value: 29 })) }

machine main() crashes Trap {
    let first: u64 = exercise(true);
    let second: u64 = exercise(false);
    transition first == 29 && second == 29 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
