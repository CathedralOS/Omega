use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_indirect_float_record_result");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind<AffineTransforms::make>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/Versions/A/CoreGraphics",
            symbol: "_CGAffineTransformMake"
        } });
    Build::select_provider<AffineObservation, NativeAffineObservation>(builder, macos_arm64);
    Build::select_provider<AffineObservation, NativeAffineObservation>(builder, linux_x86_64);
    Build::select_provider<AffineObservation, NativeAffineObservation>(builder, linux_arm64);
    Build::select_provider<AffineObservation, NativeAffineObservation>(builder, windows_x86_64);
}
