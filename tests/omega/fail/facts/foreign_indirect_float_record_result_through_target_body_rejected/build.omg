use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, macos_arm64);
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, linux_x86_64);
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, linux_arm64);
    Build::select_provider<SelectedObserve, CheckedObserve>(builder, windows_x86_64);

    Build::application(builder, "foreign_indirect_float_record_result");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);

 Build::bind<AffineTransforms::make>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/System/Library/Frameworks/CoreGraphics.framework/Versions/A/CoreGraphics", symbol: "_CGAffineTransformMake"
    } });
}
