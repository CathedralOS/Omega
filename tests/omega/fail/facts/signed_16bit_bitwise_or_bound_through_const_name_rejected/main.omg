// Fact: 16-bit signed bitwise OR base | 32i16 with bounded interval 40i16 <= combined <= 63i16 establishes 40i16 <= combined <= 63i16 across all nine places so exact subtractions 63i16 - combined and combined - 40i16 are safe.
// Invalid: widened mask 64 produces combined == 84 > 63, failing verify_combined requires contract.

machine compute_or(base: i16) -> i16
    requires base >= 20 && base <= 20
{
    base | 64i16
}

machine verify_combined(combined: i16) -> i32
    requires combined >= 40 && combined <= 63
{
    let headroom: i16 = 63 - combined;
    let margin: i16 = combined - 40;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

const BASE_VAL: i16 = 20;

machine main() crashes Trap {
    let combined: i16 = compute_or(BASE_VAL);
    let check: i32 = verify_combined(combined);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
