// The remainder `value % width` is below `width`, so when `width` is proved
// equal to a view's length it indexes that view.
// Invalid: width is one greater than the view length, so the remainder may equal the length. Place: field. A record field carries the width equal to the view's length.
// Expected exit: 0
data Window [copy] {
    width: u64;
}

machine pick(value: u64, buckets: &[u8], window: Window) -> u8
requires buckets.len > 0 && buckets.len < 100 && window.width == buckets.len as u64 + 1
{
    buckets[value % window.width]
}

machine main() crashes Trap {
    let buckets: [u8; 4] = [7, 8, 9, 6];
    let window: Window = Window { width: 5 };
    transition pick(10, &buckets[..], window) == 9 && pick(15, &buckets[..], window) == 6 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
