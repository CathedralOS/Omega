data ProofNat { case Zero; case Succ(prev: ProofNat); }
data Rank {}
measure Rank::Bad(value: u64) -> u64 { (value + 18446744073709551615u64) * 0 + 1 }
machine erased(n: ProofNat, remaining: u64) -> ProofNat
requires remaining >= 4 && remaining <= 7
terminates by remaining -> Rank::Bad in 0..=1
{ n }
machine main() {}
