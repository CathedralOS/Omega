// An affine Room with count 10 and executable nominal cleanup retains original backing through a successor-state loan; successor observes 10, and owner cleans exactly once after loan closes.
// Expected error: contextual cleanup prerequisite

// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    terminates;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    terminates;
}

data Room { count: u32 in Wrapping; }
machine Room::drop(room: &mut Room)
requires room.count == 10
reaches Console
{
 Console::write_byte(68);
 room.count = 99;
}
machine scope(choice: bool) reaches Console crashes Trap {
 let room: Room = match choice { true -> Room { count: 11 } false -> Room { count: 11 } };
 transition { _ -> observe(&mut room) }
 machine observe(room: &mut Room) {
  Console::write_byte(79);
  transition room.count == 11 { true -> seen() false -> bad() }
 }
 machine seen() {}
 machine bad() { crash Trap; }

}
data Main {}
machine Main::main(main: &mut Main) reaches Console crashes Trap { scope(true); scope(false); }

PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
