// Fact: a 32-bit signed i32 left shift of a bounded input (val >= 15i32 && val <= 15i32) by 2u32 bits establishes shifted >= 60i32 && shifted <= 60i32 so exact 32-bit signed subtraction shifted - 60i32 is proved overflow-free across all nine places.
// Place: target_body. Each hosted target body computes the 32-bit signed left shift and verifies the bounds.
// Expected exit: 0
machine verify_shifted(shifted: i32) -> i32
    requires shifted >= 60 && shifted <= 60
{
    shifted - 60
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine compute_target_body(val: i32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 14 && val <= 15;
}

X86Probe satisfies SelectedProbe {
    machine compute_target_body(val: i32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 14 && val <= 15
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: i32 = val << 2u32;
        verify_shifted(shifted)
    }
}

ArmProbe satisfies SelectedProbe {
    machine compute_target_body(val: i32) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 14 && val <= 15
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: i32 = val << 2u32;
        verify_shifted(shifted)
    }
}









machine evaluate() -> i32
    reaches SelectedProbe, SelectedBodyCheck crashes Trap
{
    SelectedProbe::compute_target_body(15)
}

machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
