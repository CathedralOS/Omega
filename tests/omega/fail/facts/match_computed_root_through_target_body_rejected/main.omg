// A match subject is one evaluation of a computed root, the selected exclusive loan records that root, and the consumer writes 41 through that recorded loan.
// Place: target_body.
// The source is used while the loan is live.


machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = 1;
    0
}

linux_x86_64 machine apply(chosen: &mut [i64; 2], other: &mut [i64; 2], visits: &mut u64) -> i64 {
    let selected: &mut i64 = match chosen[compute(visits)] {
        17 -> &mut chosen[0]
        _ -> &mut other[0]
    };
    chosen = [7, 7];
    selected = 41;
    selected
}

linux_arm64 machine apply(chosen: &mut [i64; 2], other: &mut [i64; 2], visits: &mut u64) -> i64 {
    let selected: &mut i64 = match chosen[compute(visits)] {
        17 -> &mut chosen[0]
        _ -> &mut other[0]
    };
    chosen = [7, 7];
    selected = 41;
    selected
}

macos_arm64 machine apply(chosen: &mut [i64; 2], other: &mut [i64; 2], visits: &mut u64) -> i64 {
    let selected: &mut i64 = match chosen[compute(visits)] {
        17 -> &mut chosen[0]
        _ -> &mut other[0]
    };
    chosen = [7, 7];
    selected = 41;
    selected
}

windows_x86_64 machine apply(chosen: &mut [i64; 2], other: &mut [i64; 2], visits: &mut u64) -> i64 {
    let selected: &mut i64 = match chosen[compute(visits)] {
        17 -> &mut chosen[0]
        _ -> &mut other[0]
    };
    chosen = [7, 7];
    selected = 41;
    selected
}

machine main() crashes Trap {
    let mut chosen: [i64; 2] = [17, 5];
    let mut other: [i64; 2] = [0, 8];
    let mut visits: u64 = 0;
    let observed: i64 = apply(&mut chosen, &mut other, &mut visits);
    transition observed == 41 && visits == 1 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
