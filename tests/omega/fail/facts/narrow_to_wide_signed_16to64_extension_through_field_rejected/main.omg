// Fact: sign-extending a bounded 16-bit signed i16 value (narrow >= 300i16 && narrow <= 500i16) to i64 (narrow as i64) preserves the exact interval (wide >= 300i64 && wide <= 500i64), discharging exact 64-bit signed subtractions 500i64 - wide and wide - 300i64 across all nine places.
// Place: field (invalid twin). Narrow bound is widened to 501i16, causing contract verification for verify_wide to fail closed.
// Expected diagnostic: cannot prove requires contract for call verify_wide

data WideBox {
    val: i64;
}

machine verify_wide(wide: i64) -> i32 requires wide >= 300i64 && wide <= 500i64 {
    let headroom: i64 = 500i64 - wide;
    let margin: i64 = wide - 300i64;
    let sum: i64 = headroom + margin;
    let check: i64 = sum - 200i64;
    check as i32
}

machine ext_field(narrow: i16) -> i32 requires narrow >= 300i16 && narrow <= 501i16 {
    let wide: i64 = narrow as i64;
    let box: WideBox = WideBox { val: wide };
    verify_wide(box.val)
}

machine probe() -> i32 {
    ext_field(400i16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
