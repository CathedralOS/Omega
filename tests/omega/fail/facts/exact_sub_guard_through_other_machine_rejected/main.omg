// Invalid control for the other-machine place. `requires remaining <= 5` does not prove
// `remaining >= 2`, so `remaining - 2` is not exact u64. No domain, no `as`.

machine publish(remaining: u64) -> u64
requires
    remaining <= 5;
ensures
    result == remaining;
{
    remaining
}

machine deduct(value: u64) -> u64
requires
    value <= 5;
{
    value - 2
}

machine walk(remaining: u64) -> u64
requires
    remaining <= 5;
{
    deduct(publish(remaining))
}

data Main {
    hits: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.hits = 0;
    transition walk(4) == 2 {
        true -> pass(main)
        _ -> fail(main)
    }
    state pass(main: &mut Main) { main.hits = 1; }
    state fail(main: &mut Main) { main.hits = -1; }
}
