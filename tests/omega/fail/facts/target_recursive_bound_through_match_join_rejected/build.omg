machine build(builder: &mut Build) {
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, windows_x86_64);
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, linux_x86_64);
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, macos_arm64);
    Build::select_provider<SelectedCountdown, CheckedCountdown>(builder, linux_arm64);

    Build::application(builder, "target_recursive_bound_match_join");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
