// Fact: A 64-bit unsigned u64 remainder operation (dividend % divisor where divisor >= 64u64 && divisor <= 64u64) establishes rem <= 63u64 so exact 64-bit subtraction 63u64 - rem is proved underflow-free across all nine places.
// Place: call result. The remainder is received from a helper call returning the remainder result.
// Invalid control: divisor upper bound widened to 65u64, allowing rem as high as 64u64 and failing subtraction 63u64 - rem.
// Expected rejection: may overflow `u64`

machine compute_remainder(d: u64, s: u64) -> u64
    requires s >= 64u64 && s <= 65u64;
    ensures result <= 64u64;
{
    d % s
}

machine remainder_call_result(dividend: u64, divisor: u64) -> i32
    requires divisor >= 64u64 && divisor <= 65u64;
{
    let rem: u64 = compute_remainder(dividend, divisor);
    let headroom: u64 = 63u64 - rem;
    transition rem == 13u64 && headroom == 50u64 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = remainder_call_result(205u64, 64u64);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
