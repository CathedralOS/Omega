// A const-generic scoped domain family proves a literal initializer against the exact instance it was declared with, and the consumed value is 3.
// Expected exit: 0
domain<const Bound: u64> u64::BelowIndex<Bound>(value) requires value < Bound;
// Place: field. The scoped initializer establishes the record field.
data Holder { scoped: u64 in BelowIndex<4>; }
machine verify(observed: u64 in BelowIndex<4>, flag: bool) crashes Trap {
    transition (flag && (observed as u64) == 3) || (!flag && (observed as u64) == 3) {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine exercise(flag: bool) crashes Trap {
    let holder: Holder = Holder { scoped: 4 };
    let observed: u64 in BelowIndex<4> = holder.scoped;
    verify(observed, flag);
}
machine main() crashes Trap { exercise(true); exercise(false); }
