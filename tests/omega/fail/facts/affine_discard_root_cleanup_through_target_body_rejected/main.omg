// Fact: an unconsumed nominal resource whose drop contract requires valid == 1u64 executes deterministic affine scope-exit cleanup while preserving result <= 50u64 so 50u64 - result succeeds.
// Expected exit: 0

data Counter {
    value: u64;
}

data Resource {
    dropped: &mut Counter;
    valid: u64;
    value: u64;
}

machine Resource::drop(resource: &mut Resource)
requires resource.valid == 1u64
{
    resource.dropped.value = resource.valid;
    resource.valid = 0u64;
}

machine verify(result: u64, dropped: &Counter)
requires result <= 50u64
crashes Trap
{
    let diff: u64 = 50u64 - result;
    transition diff == 20u64 && dropped.value == 1u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(dropped: &mut Counter) -> u64
        reaches SelectedBodyCheck crashes Trap
        ensures result <= 50u64;
}

X86Probe satisfies SelectedProbe {
    machine exercise(dropped: &mut Counter) -> u64
        reaches SelectedBodyCheck crashes Trap
        ensures result <= 50u64
    {
        SelectedBodyCheck::require_tag(17u64);
        let res: Resource = Resource { dropped: dropped, valid: 0u64, value: 30u64 };
        res.value
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(dropped: &mut Counter) -> u64
        reaches SelectedBodyCheck crashes Trap
        ensures result <= 50u64
    {
        SelectedBodyCheck::require_tag(29u64);
        let res: Resource = Resource { dropped: dropped, valid: 0u64, value: 30u64 };
        res.value
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let mut dropped: Counter = Counter { value: 0u64 };
    let val: u64 = SelectedProbe::exercise(&mut dropped);
    verify(val, &dropped);
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
