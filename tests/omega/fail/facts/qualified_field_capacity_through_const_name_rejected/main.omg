// Fact: a qualified field supplies a split contract that preserves the exact remaining-capacity relation.
// Expected exit: 0
// Numeric model only: these domains grant no access to physical storage.
data Tail { length: u64; }
domain Tail::Tracked;
domain Tail::Partitionable;
data Strategy where remaining == tail.length {
    tail: Tail in Tracked & Partitionable;
    remaining: u64;
}
data Parts {
    taken: Tail in Tracked & Partitionable;
    rest: Tail in Tracked & Partitionable;
}
data Issued { strategy: Strategy; allocation: Tail; }
machine check_length(tail: &Tail, expected: u64)
requires tail.length == expected
{}
machine split(whole: Tail in Tracked & Partitionable, length: u64) -> Parts
requires length <= whole.length
ensures result.rest.length == whole.length - length,
    result.taken.length == length
{
    Parts {
        taken: Tail { length: length },
        rest: Tail { length: whole.length - length },
    }
}
const request: u64 = 16;
machine allocate(strategy: Strategy, length: u64, select: bool) -> Issued
requires length <= strategy.remaining
{
    let tail: Tail in Tracked & Partitionable = strategy.tail;
    let parts: Parts = split(tail, length);
    check_length(&parts.taken, length);
    Issued {
        strategy: Strategy { tail: parts.rest, remaining: strategy.remaining },
        allocation: parts.taken,
    }
}
machine main() crashes Trap {
    let first: Issued = allocate(Strategy { tail: Tail { length: 48 }, remaining: 48 }, request, true);
    let second: Issued = allocate(Strategy { tail: Tail { length: 48 }, remaining: 48 }, request, false);
    transition first.strategy.remaining == 32 && first.strategy.tail.length == 32
        && first.allocation.length == 16 && second.strategy.remaining == 32
        && second.strategy.tail.length == 32 && second.allocation.length == 16 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
