// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the const name SPAN is 3, so the arm `which == 0` window has
// length 3 and disagrees with the other arm's length 2.
const SPAN: i64 = 3;

machine from_const<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> &mut items[0..which + SPAN]
        _ -> &mut items[2..4]
    }
}
machine main() crashes Trap {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_const(&mut bytes, 0);
    transition window.len == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
