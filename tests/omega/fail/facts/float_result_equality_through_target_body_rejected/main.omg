// A returned f64 equals the live field it came from.
data Ends { kept: f64; other: f64; }
machine read_kept(item: &Ends) -> f64
requires item.kept == 7.0
ensures result == item.kept && result == 7.0
{
    item.other
}

machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}
linux_x86_64 machine observe(item: &Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = read_kept(item);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> agreed }
}

linux_arm64 machine observe(item: &Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = read_kept(item);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> agreed }
}

macos_arm64 machine observe(item: &Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = read_kept(item);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> agreed }
}

windows_x86_64 machine observe(item: &Ends) -> f64
requires item.kept == 7.0
{
    let saved: f64 = read_kept(item);
    let agreed: f64 = agree(saved, item.kept);
    transition { _ -> agreed }
}

machine main() crashes Trap {
    let item: Ends = Ends { kept: 7.0, other: 1.0 };
    transition observe(&item) == 7.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
