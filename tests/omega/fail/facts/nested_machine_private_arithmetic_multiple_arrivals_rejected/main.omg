// Every private arrival carries a positive value, so the helper can form value - 1.
machine probe(value: u64, select: bool) -> u64 {
    transition value > 0 { true -> route(value, select) false -> 0 }
    machine route(value: u64, select: bool) -> u64 {
        transition select { true -> apply(value) false -> apply(0) }
    }
    machine apply(value: u64) -> u64 { value - 1 }
}
machine main() crashes Trap {
    let first: u64 = probe(7, true);
    let second: u64 = probe(9, false);
    let zero: u64 = probe(0, true);
    transition first == 6 && second == 8 && zero == 0 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
