// Fact: matching a 6-variant tagged enum payload Packet { Alpha(u64), Beta(u64), Gamma(u64), Delta(u64), Epsilon(u64), Zeta(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.

data Packet [copy] {
    case Alpha(v: u64) where v >= 40u64 && v <= 80u64;
    case Beta(v: u64) where v >= 40u64 && v <= 80u64;
    case Gamma(v: u64) where v >= 40u64 && v <= 80u64;
    case Delta(v: u64) where v >= 40u64 && v <= 80u64;
    case Epsilon(v: u64) where v >= 40u64 && v <= 80u64;
    case Zeta(v: u64) where v >= 39u64 && v <= 80u64;
}

machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine choose(flag: bool, first: u64, second: u64) -> u64
    requires first >= 40u64 && first <= 80u64 && second >= 40u64 && second <= 80u64
    ensures result >= 40u64 && result <= 80u64
{
    transition flag {
        true -> first
        false -> second
    }
}

machine extract(packet: Packet) -> u64 {
    transition packet {
        Packet::Alpha { v } -> v
        Packet::Beta { v } -> v
        Packet::Gamma { v } -> v
        Packet::Delta { v } -> v
        Packet::Epsilon { v } -> v
        Packet::Zeta { v } -> v
    }
}

machine probe(flag: bool, packet: Packet) -> u64 {
    let res: u64 = extract(packet);
    let joined: u64 = choose(flag, res, 60u64);
    verify_payload(joined)
}

machine main() crashes Trap {
    let p: Packet = Packet::Zeta { v: 60u64 };
    let combined: u64 = probe(true, p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
