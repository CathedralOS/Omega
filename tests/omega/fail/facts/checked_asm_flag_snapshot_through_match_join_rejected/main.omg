// Expected exit: 0.
// Subtraction establishes ZF; a structured snapshot carries that bit to a label.
machine main() crashes Trap {
 observe_branch(true);
 observe_branch(false);
}

machine observe_branch(branch: bool) crashes Trap {
 let mut left: u64 = 0;
 let mut right: u64 = 0;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 1;
  sub eax, 1;
  pushfq left;
  mov eax, 2;
  sub eax, 2;
  pushfq right;
  jmp observed;
 observed requires (left & 64u64) == 64u64 requires (right & 64u64) == 64u64:
  nop
 }
 let joined: u64 = match branch { true -> left, false -> right ^ 64u64 };
 asm { observed requires (joined & 64u64) == 64u64: nop }
 transition (joined & 64u64) == 64u64 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
