// Expected exit: 0.
// Subtraction establishes ZF; a structured snapshot carries that bit to a label.
machine main() crashes Trap {
 let mut snapshot: u64 = 0;
 asm where clobbers rax, rflags, r10, r15 {
 entry:
  mov eax, 1;
  sub eax, 1;
  pushfq snapshot;
  jmp observed;
 observed requires (snapshot & 64u64) == 64u64:
  nop
 }
 transition { _ -> next(snapshot ^ 64u64) }
 machine next(carried: u64) requires (carried & 64u64) == 64u64 {
  asm { observed requires (carried & 64u64) == 64u64: nop }
  transition (carried & 64u64) == 64u64 { true -> done() false -> bad() }
 }
 machine done() {}
 machine bad() { crash Trap; }
}
