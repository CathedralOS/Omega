machine build(builder: &mut Build) {
    Build::select_provider<SelectedUpdate, CheckedUpdate>(builder, macos_arm64);
    Build::select_provider<SelectedUpdate, CheckedUpdate>(builder, linux_arm64);
    Build::select_provider<SelectedUpdate, CheckedUpdate>(builder, linux_x86_64);
    Build::select_provider<SelectedUpdate, CheckedUpdate>(builder, windows_x86_64);

    Build::application(builder, "stable_transfer");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
