// A static callback retains its exact selection and bounded reach through a conformance invocation; its transported result discharges 37 - result.
// Expected exit: 0
public boundary trait Console {}
public boundary trait Extra {}
public trait Marker { machine mark(value: u64) -> u64; }
MarkerCode satisfies Marker { machine mark(value: u64) -> u64 { value } }
OtherMarkerCode satisfies Marker { machine mark(value: u64) -> u64 { value } }
public trait StepContract<Operations satisfies Marker> {
    machine step(value: u64) -> u64
    reaches Console terminates;
    requires value <= 37
    ensures result <= 37;
}
machine quiet(value: u64) -> u64
satisfies StepContract<MarkerCode>::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine second(value: u64) -> u64
satisfies StepContract<MarkerCode>::step
terminates;
requires value <= 37
ensures result <= 37
{ value }
machine traverse<Operations satisfies Marker, machine Step>(value: u64) -> u64
where machine Step satisfies StepContract<Operations>::step;
terminates;
requires value <= 37
ensures result <= 37
{
    transition value == 0 { true -> Step(value) _ -> Step(value) }
}
machine main() reaches crashes Trap {
    let value: u64 = traverse<OtherMarkerCode, quiet>(37);
    let margin: u64 = 37 - value;
    transition margin == 0 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
