// Another machine's requires stays unproved when the result has no bound.
machine produced(index: u64) -> u64 { index }
machine consumed(index: u64) -> u8
requires index < 3
{
    let values: [u8; 3] = [7, 8, 9];
    values[index]
}
machine read_other(index: u64) -> u8 {
    consumed(produced(index))
}
machine main() crashes Trap {
    transition read_other(1) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
