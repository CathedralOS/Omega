// Invalid: a conformance binder cannot become a same-named global equation element type.
data Evidence [copy] { value: u64; }
trait Probe<Value> { machine probe(value: &Value) -> u64; }
Positive satisfies Probe<[Evidence; 2]> { machine probe(value: &[Evidence; 2]) -> u64 { 7 } }
machine selected<Length [copy], const Capacity: u64, Evidence satisfies Probe<Length>>(items: Length) -> u64
where Length == [Evidence; Capacity]
{ Capacity }
machine main() {
    let items: [Evidence; 2] = [Evidence { value: 7 }, Evidence { value: 11 }];
    let observed: u64 = selected<[Evidence; 2], Positive>(items);
}
