// A literal is not a saved-flags place.
use omega::language::core::assembly;

machine main() reaches MachineControl crashes Trap {
    restore();
}

machine restore() reaches MachineControl crashes Trap {
    let mut saved: u64 = 0;
    asm where clobbers rax, rflags, r10, r15 {
        entry:
            mov eax, 1;
            sub eax, 1;
            pushfq saved;
    }
    asm where clobbers r10, r15 {
        entry:
            popfq 0;
        observed requires (saved & 64u64) == 64u64:
            nop
    }
    transition (saved & 64u64) == 64u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
