// Fact: 8-bit signed saturating multiplication lhs *| rhs with bounded interval 40i8 <= prod <= 96i8 establishes 40i8 <= prod <= 96i8 across all nine places so exact subtractions 96i8 - prod and prod - 40i8 are safe.
// Place: const name (invalid twin). Constant LHS_VAL is widened to 13i8 so prod reaches 104i8 > 96i8, failing contract for verify_prod.
// Expected diagnostic: cannot prove requires contract for call

machine verify_prod(value: i8) -> i8 requires value >= 40i8 && value <= 96i8 {
    let headroom: i8 = 96i8 - value;
    let margin: i8 = value - 40i8;
    headroom + margin
}

const LHS_VAL: i8 = 13i8;
const RHS_VAL: i8 = 8i8;

machine sat_const() -> i8 {
    let a: i8 in Saturating = LHS_VAL as i8 in Saturating;
    let b: i8 in Saturating = RHS_VAL as i8 in Saturating;
    let sat_prod: i8 in Saturating = a * b;
    let prod: i8 = sat_prod as i8;
    verify_prod(prod)
}

machine probe() -> i8 {
    sat_const()
}

machine main() crashes Trap {
    transition probe() == 56 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
