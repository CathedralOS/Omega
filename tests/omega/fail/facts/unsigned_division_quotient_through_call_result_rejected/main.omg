// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Invalid: quotient is 99, so subtracting 100u64 underflows. Place: call_result.
// Expected diagnostic: may overflow `u64`

machine compute_quotient() -> u64
ensures result >= 99 && result <= 99
{
    396u64 / 4u64
}

machine probe() -> i32 {
    let quotient: u64 = compute_quotient();
    let diff: u64 = quotient - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
