// Fact: a 16-bit signed i16 remainder operation (dividend % divisor where dividend >= 0i16 && dividend <= 100i16, divisor >= 16i16 && divisor <= 16i16) establishes rem >= 0i16 && rem <= 15i16 so exact 16-bit signed subtraction 15i16 - rem is proved overflow-free across all nine places.
// Invalid: widening divisor <= 17i16 allows rem 16i16, violating step requires contract. Place: other_state.
// Expected diagnostic: cannot prove requires contract for call step

machine verify_rem(rem: i16) -> i32
requires rem >= 0i16 && rem <= 15i16
{
    let headroom: i16 = 15i16 - rem;
    0i32
}

machine verify_state(dividend: i16, divisor: i16) -> i32
requires dividend >= 0i16 && dividend <= 100i16 && divisor >= 16i16 && divisor <= 17i16
{
    transition {
        _ -> step(dividend % divisor)
    }
    state step(rem: i16) -> i32
    requires rem >= 0i16 && rem <= 15i16
    {
        verify_rem(rem)
    }
}

machine probe() -> i32 {
    verify_state(43i16, 16i16)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
