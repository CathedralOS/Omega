// Fact: a 16-bit signed i16 left shift of a bounded input (val >= 30i16 && val <= 30i16) by 2u32 bits establishes shifted >= 120i16 && shifted <= 120i16 so exact 16-bit signed subtraction shifted - 120i16 is proved overflow-free across all nine places.
// Invalid: weakened val produces shifted == 116, failing exercise requires contract.

machine compute_shift(val: i16) -> i16
    requires val >= 29 && val <= 30
{
    val << 2u32
}

machine verify_shifted(shifted: i16) -> i32
    requires shifted >= 120 && shifted <= 120
{
    let check: i16 = shifted - 120;
    check as i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 120 && val <= 120;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 120 && val <= 120
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_shifted(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 120 && val <= 120
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_shifted(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let val: i16 = 29;
    let shifted: i16 = compute_shift(val);
    let check: i32 = SelectedProbe::exercise(shifted);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
