satisfies Writer::register via windows_x86_64_register_binding();
windows_x86_64 machine complete<'source>(pending: Pending<'source> in Pending::Retained, observed: &mut u64) -> Capacity
satisfies Writer::complete via windows_x86_64_complete_binding();
windows_x86_64 machine release(capacity: Capacity in Capacity::Available) satisfies Writer::release via windows_x86_64_release_binding();
const ORIGINAL: u64 = 37;
data Main {}
machine Main::main(main: &mut Main) reaches Writer crashes Trap {
    let capacity: Capacity in Capacity::Available = Writer::acquire();
    let mut buffer: Buffer in Buffer::Owned = Buffer { value: ORIGINAL };
    let original: u64 = buffer.value;
    let pending: Pending = Writer::register(capacity, &mut buffer);
    let forbidden: u64 = buffer.value;
    let mut observed: u64 = 0;
    let returned: Capacity in Capacity::Available = Writer::complete(pending, &mut observed);
    Writer::release(returned);
    let value: u64 = buffer.value;
    drop(buffer);
    transition observed == 73 && value == 73 && original == 37 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Writer crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
