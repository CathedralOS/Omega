// Counter.value <= 60 makes exact i32 70 + value representable without a per-call bound.
// Expected exit: 0
public machine bounded(value: &i32) -> bool { value <= 60 }
public data Counter<'storage> [copy] { before: i32; value: &'storage i32; after: i32; marker: i32; }
machine read(value: &i32) -> i32 ensures result == value, { value }
public data Holder<'counter, 'storage> [copy] { prefix: i32; counter: &'counter Counter<'storage>; suffix: i32; }
public data Backing [copy] requires self.value <= 60 { value: i32; }
const HIGH: Backing = Backing { value: 60 };
const LOW: Backing = Backing { value: -17 };
public machine produce<'storage>(backing: &'storage Backing, marker: i32) -> Counter<'storage> {
    Counter { before: 17, value: &backing.value, after: 53, marker: marker }
}
public machine compute(holder: &Holder) -> i32 {
    let value: i32 = read(holder.counter.value);
    70 + value
}
machine main() crashes Trap {
    let high: Backing = HIGH;
    let low: Backing = LOW;
    let mut first: Counter = produce(&high, 19);
    let mut second: Counter = produce(&low, 23);
    let first_holder: Holder = Holder { prefix: 31, counter: &first, suffix: 47 };
    let second_holder: Holder = Holder { prefix: 31, counter: &second, suffix: 47 };
    transition compute(&first_holder) == 130 && compute(&second_holder) == 53
        && first.before == 17 && first.after == 53 && first.marker == 19
        && second.before == 17 && second.after == 53 && second.marker == 23
        && first_holder.prefix == 31 && first_holder.suffix == 47
        && second_holder.prefix == 31 && second_holder.suffix == 47
        && high.value == 60 && low.value == -17 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
