// A call inside an abstract signature is the premise. The signature
// records that call's result, and the caller reads the record.
// Place: other_machine.
// Expected exit: 0
machine premise(kept: bool) -> bool {
    false
}

machine hold(direct: bool) -> bool
requires direct == true
{
    direct
}

machine witness<const Marker: u64>(kept: bool) -> bool
requires premise(kept)
{
    premise(kept)
}

machine apply<machine Observe>(kept: bool) -> bool
where machine Observe(kept: bool) -> bool
requires premise(kept);
requires premise(kept)
{
    Observe(kept)
}

const DIRECT: bool = apply<witness<1>>(true);

machine observe(direct: bool) -> bool
requires direct == true
{
    hold(direct)
}

machine relay(direct: bool) -> bool
requires direct == true
{
    observe(direct)
}

machine main() crashes Trap {
    transition relay(DIRECT) {
        true -> done()
        _ -> bad()
    }
}

machine done() {}
machine bad() crashes Trap { crash Trap; }
