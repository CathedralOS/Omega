// Fact: querying size_of and align_of on a 64-bit slice view (&[u64]) establishes its exact two-word (ptr, len) descriptor geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Invalid: querying thin pointer &u64 (size == 8u64, align == 8u64), so target-scoped compute_geometry() underflows u64.
// Expected exit: 0

linux_x86_64 machine compute_geometry() -> u64 {
    size_of<&u64>() - (align_of<&u64>() * 2u64)
}

linux_arm64 machine compute_geometry() -> u64 {
    size_of<&u64>() - (align_of<&u64>() * 2u64)
}

macos_arm64 machine compute_geometry() -> u64 {
    size_of<&u64>() - (align_of<&u64>() * 2u64)
}

windows_x86_64 machine compute_geometry() -> u64 {
    size_of<&u64>() - (align_of<&u64>() * 2u64)
}

machine probe() -> u64 {
    compute_geometry()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
