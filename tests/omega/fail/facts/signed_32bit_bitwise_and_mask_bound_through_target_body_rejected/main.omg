// Fact: 32-bit signed bitwise AND mask raw & 63i32 with bounded interval 40i32 <= masked <= 63i32 establishes 40i32 <= masked <= 63i32 across all nine places so exact subtractions 63i32 - masked and masked - 40i32 are safe.
// Invalid: mask 127 produces masked 116, violating verify_masked contract. Place: target_body.
// Expected diagnostic: cannot prove requires contract for call verify_masked

machine verify_masked(masked: i32) -> i32
requires masked >= 40i32 && masked <= 63i32
{
    let headroom: i32 = 63i32 - masked;
    let margin: i32 = masked - 40i32;
    0i32
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86VerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let raw: i32 = 116i32;
        let res: i32 = raw & 127i32;
        verify_masked(res)
    }
}

ArmVerifyTarget satisfies SelectedVerifyTarget {
    machine verify_target() -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let raw: i32 = 116i32;
        let res: i32 = raw & 127i32;
        verify_masked(res)
    }
}

machine probe() -> i32 {
    SelectedVerifyTarget::verify_target()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
