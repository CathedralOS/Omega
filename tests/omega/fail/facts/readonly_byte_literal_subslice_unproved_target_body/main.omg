// Fact: a checked subslice of an immutable byte-view literal preserves its exact window length of 10u64 when multiplied by 10u64 and subtracting 100u64.
// Place: another target body (invalid twin).
// Expected diagnostic: exact subtraction underflow

linux_x86_64 machine evaluate_window() -> u64 {
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..11u64];
    let total: u64 = window.len * 10u64;
    total - 100u64
}

linux_arm64 machine evaluate_window() -> u64 {
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..11u64];
    let total: u64 = window.len * 10u64;
    total - 100u64
}

macos_arm64 machine evaluate_window() -> u64 {
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..11u64];
    let total: u64 = window.len * 10u64;
    total - 100u64
}

windows_x86_64 machine evaluate_window() -> u64 {
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..11u64];
    let total: u64 = window.len * 10u64;
    total - 100u64
}

machine probe() -> u64 {
    evaluate_window()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
