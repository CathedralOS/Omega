machine build(builder: &mut Build) {
    Build::application(builder, "linear_owner_borrowed_projection_target_body");
    Build::bind(builder, linux_x86_64::ProgramEntry, selected_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, selected_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, selected_entry);
    Build::bind(builder, windows_x86_64::ProgramEntry, selected_entry);
}
