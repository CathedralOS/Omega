// Expected exit: 0
// A Vector constructor with a copyable type parameter preserves Total <= 10 * Length; Length <= 8 proves exact 80u64 - Total.
data Vector<T [copy], Length: u64, Total: u64> {
    case Nil where Length == 0 && Total == 0;
    case Cons(previous: u64, previous_total: u64, head: u64, marker: T,
              tail [erased]: Vector<T, previous, previous_total>)
        where head <= 10 && embed(previous) + 1 == embed(Length)
              && embed(previous_total) + embed(head) == embed(Total);
}

machine vector_bound<T [copy], Length: u64, Total: u64>(evidence [erased]: Vector<T, Length, Total>)
terminates by Length;
ensures embed(Total) <= 10 * embed(Length)
{
    transition evidence {
        Vector::Nil { .. } -> done()
        Vector::Cons { previous, previous_total, head, tail, .. } -> step(previous, previous_total, head, tail)
    }
    machine done() requires Length == 0 && Total == 0 {}
    machine step(previous: u64, previous_total: u64, head: u64, tail [erased]: Vector<T, previous, previous_total>)
    requires head <= 10 && embed(previous) + 1 == embed(Length)
             && embed(previous_total) + embed(head) == embed(Total)
    {
        vector_bound<T, previous, previous_total>(tail);
    }
}

machine bounded<T [copy], Length: u64, Total: u64>(evidence [erased]: Vector<T, Length, Total>) -> u64
requires Length <= 8
{
    vector_bound<T, Length, Total>(evidence);
    80u64 - Total
}
machine main() crashes Trap {
    let nil [erased]: Vector<bool, 0, 0> = Vector::Nil;
    let one [erased]: Vector<bool, 1, 7> = Vector::Cons { previous: 0, previous_total: 0, head: 7, marker: true, tail: nil };
    let kept [erased]: Vector<bool, 1, 7> = one;
    let result: u64 = bounded<bool, 1, 8>(kept);
    transition result == 73 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
