// Invalid: a named conformance binder is not a same-named global type in a bare equation.
data Evidence [copy] { value: u64; }
trait Probe<Value> { machine probe(value: &Value) -> u64; }
Positive satisfies Probe<Evidence> { machine probe(value: &Evidence) -> u64 { 7 } }
machine selected<Length [copy], const Capacity: u64, Evidence satisfies Probe<Length>>(items: Length) -> u64
where Length == Evidence
{ Capacity }
machine main() {
    let items: Evidence = Evidence { value: 7 };
    let observed: u64 = selected<Evidence, 2, Positive>(items);
}
