// Fact: 64-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i64 <= prod <= 200i64 establishes 50i64 <= prod <= 200i64 across all nine places so exact subtractions 200i64 - prod and prod - 50i64 are safe.
// Place: call result (invalid twin). The helper ensures upper bound is widened to 21i64 so prod reaches 210i64 > 200i64, failing contract for verify_prod.
// Expected diagnostic: cannot prove requires contract for call

machine verify_prod(value: i64) -> i64 requires value >= 50i64 && value <= 200i64 {
    let headroom: i64 = 200i64 - value;
    let margin: i64 = value - 50i64;
    headroom + margin
}

machine get_lhs() -> i64 ensures result >= 10 && result <= 21 {
    21i64
}

machine get_rhs() -> i64 ensures result >= 5 && result <= 10 {
    10i64
}

machine sat_call_result() -> i64 {
    let lhs: i64 = get_lhs();
    let rhs: i64 = get_rhs();
    let a: i64 in Wrapping = lhs as i64 in Wrapping;
    let b: i64 in Wrapping = rhs as i64 in Wrapping;
    let wrap_prod: i64 in Wrapping = a * b;
    let prod: i64 = wrap_prod as i64;
    verify_prod(prod)
}

machine probe() -> i64 {
    sat_call_result()
}

machine main() crashes Trap {
    transition probe() == 150 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
