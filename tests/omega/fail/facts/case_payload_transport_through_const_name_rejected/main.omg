// A multi-variant Outcome sum carries its active payload value <= 50 across the place so matching Outcome::Ready adds 10 within result <= 60.

data Outcome [copy]
    requires (self in Outcome::Empty)
       || ((self in Outcome::Ready) && self.value <= 80)
{
    case Empty;
    case Ready(value: u64);
}

const READY: Outcome = Outcome::Ready { value: 32 };
const EMPTY: Outcome = Outcome::Empty {};

machine eval(outcome: Outcome) -> u64
    ensures result <= 60
{
    transition outcome {
        Outcome::Ready { value } -> (value + 10)
        Outcome::Empty {} -> 0
    }
}

machine main() crashes Trap {
    transition eval(READY) == 42 && eval(EMPTY) == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
