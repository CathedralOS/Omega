// A linear Token [linear] carries its exact payload across the place and retires through its explicit consuming machine on every normal exit.
// Place: call result. A call result yields the linear Token before retirement.
// Expected exit: 0
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
machine retire(token: Token) -> u64 {
    let v: u64 = token.value;
    drop(token);
    v
}

machine produce() -> Token {
    Token { value: 42 }
}

machine probe() -> u64 {
    let token: Token = produce();
    let first: u64 = retire(token);
    retire(token)
}

machine main() crashes Trap {
    transition probe() == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
