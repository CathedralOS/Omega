linux_arm64 machine countdown(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
    let mut output: u32 = 99;
    asm where clobbers x0, x1, nzcv {
    entry:
        mov w0, seed;
        b loop;
    loop requires w0 > 0:
        subs w1, w0, 1;
        mov w0, w1;
        b.ne loop;
    done requires w0 == 1 ensures output == 0:
        mov output, w0
    }
    output
}

macos_arm64 machine countdown(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
    let mut output: u32 = 99;
    asm where clobbers x0, x1, nzcv {
    entry:
        mov w0, seed;
        b loop;
    loop requires w0 > 0:
        subs w1, w0, 1;
        mov w0, w1;
        b.ne loop;
    done requires w0 == 1 ensures output == 0:
        mov output, w0
    }
    output
}

machine joined(branch: bool) -> u32 ensures result == 0 {
    match branch { true -> countdown(2), false -> countdown(2) }
}
machine finished() {}
machine failed() crashes Trap { crash Trap; }
machine observe_zero(value: u32) crashes Trap requires value == 0 {
    transition value == 0 { true -> finished() false -> failed() }
}
machine main() crashes Trap {
    let left: u32 = joined(true);
    let right: u32 = joined(false);
    observe_zero(left);
    observe_zero(right);
}
