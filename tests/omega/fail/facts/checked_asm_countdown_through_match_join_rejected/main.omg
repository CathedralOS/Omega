// Expected exit: 0.
// The checked seed-2 mov/sub/jnz CFG falls through with eax == 0 and stores output == 0.
linux_x86_64 machine countdown(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
    let mut output: u32 = 99;
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        jmp loop;
    loop requires eax > 0:
        sub eax, 1;
        jnz loop;
    done requires eax == 1 ensures output == 0:
        mov output, eax
    }
    output
}

windows_x86_64 machine countdown(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
    let mut output: u32 = 99;
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        jmp loop;
    loop requires eax > 0:
        sub eax, 1;
        jnz loop;
    done requires eax == 1 ensures output == 0:
        mov output, eax
    }
    output
}

macos_x86_64 machine countdown(seed: u32) -> u32 requires seed == 2 ensures result == 0 {
    let mut output: u32 = 99;
    asm where clobbers rax, rflags {
    entry:
        mov eax, seed;
        jmp loop;
    loop requires eax > 0:
        sub eax, 1;
        jnz loop;
