// Masking an unsigned scalar with a constant bitmask (val & 63u64) establishes the upper bound (masked <= 63u64), discharging exact subtraction 63u64 - masked.
// Expected rejection: exact arithmetic in machine main state evaluate local diff may overflow `u64`.
machine main() crashes Trap {
    let val: u64 = 100u64;
    transition { _ -> evaluate(val & 64u64) }
    machine evaluate(masked: u64) requires masked <= 64u64 {
        let diff: u64 = 63u64 - masked;
        transition diff == 27u64 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
