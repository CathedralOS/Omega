// Fact: 32-bit unsigned saturating multiplication lhs *| rhs with bounded interval 50u32 <= prod <= 200u32 establishes 50u32 <= prod <= 200u32 across all nine places so exact subtractions 200u32 - prod and prod - 50u32 are safe.
// Expected exit: 1

machine verify_prod(value: u32) -> u32
requires value >= 50u32 && value <= 200u32
{
    let headroom: u32 = 200u32 - value;
    let margin: u32 = value - 50u32;
    transition headroom == 80u32 && margin == 70u32 {
        true -> 0u32
        _ -> 1u32
    }
}

machine compute_prod(lhs: u32 in Saturating, rhs: u32 in Saturating) -> u32 crashes Trap
ensures result >= 50u32 && result <= 201u32
{
    let prod_sat: u32 in Saturating = lhs * rhs;
    let prod: u32 = prod_sat as u32;
    transition prod >= 50u32 && prod <= 201u32 {
        true -> pass(prod)
        _ -> bad()
    }
    machine pass(p: u32) -> u32 { p }
    machine bad() -> u32 { crash Trap; }
}

machine exercise(lhs: u32 in Saturating, rhs: u32 in Saturating) -> u32 crashes Trap {
    let prod: u32 = compute_prod(lhs, rhs);
    verify_prod(prod)
}

machine main() crashes Trap {
    let rc: u32 = exercise(15u32, 8u32);
    transition rc == 0u32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
