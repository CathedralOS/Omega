// Fact: a copyable C quotient/remainder record preserves both signed fields and independent earlier-call contents through transport and copying into the consuming operation.
// Expected exit: 0
use omega::language::core::external_binding;
public data Division { quotient: i64; remainder: i64; }
public boundary trait IntegerDivision {
 machine divide(numerator: i64, denominator: i64) -> Division reaches;
}


machine consume(first: Division, copied: Division) -> bool reaches IntegerDivision {
 let second: Division = IntegerDivision::divide(70000000000, 9);
 first.quotient == -23333333333 && first.remainder == -1
 && copied.quotient == -23333333333 && copied.remainder == -1
 && second.quotient == 7777777777 && second.remainder == 7
}
machine receive(value: Division) -> bool reaches IntegerDivision { consume(value, value) }
trait Observation {
 machine observe(expected_tag: u64) -> bool reaches IntegerDivision;
}
MacObservation satisfies Observation {
 machine observe(expected_tag: u64) -> bool reaches IntegerDivision {
  transition expected_tag == 17u64 { true -> selected() false -> wrong_selection() }
  machine selected() -> bool reaches IntegerDivision { receive(IntegerDivision::divide(-70000000000, 3)) }
  machine wrong_selection() -> bool { false }
 }
}
WindowsObservation satisfies Observation {
 machine observe(expected_tag: u64) -> bool reaches IntegerDivision {
  transition expected_tag == 29u64 { true -> selected() false -> wrong_selection() }
  machine selected() -> bool reaches IntegerDivision { receive(IntegerDivision::divide(-70000000000, 3)) }
  machine wrong_selection() -> bool { false }
 }
}
LinuxObservation satisfies Observation {
 machine observe(expected_tag: u64) -> bool reaches IntegerDivision {
  transition expected_tag == 43u64 { true -> selected() false -> wrong_selection() }
  machine selected() -> bool reaches IntegerDivision { receive(IntegerDivision::divide(-70000000000, 3)) }
  machine wrong_selection() -> bool { false }
 }
}
LinuxArmObservation satisfies Observation {
 machine observe(expected_tag: u64) -> bool reaches IntegerDivision {
  transition expected_tag == 61u64 { true -> selected() false -> wrong_selection() }
  machine selected() -> bool reaches IntegerDivision { receive(IntegerDivision::divide(-70000000000, 3)) }
  machine wrong_selection() -> bool { false }
 }
}
machine journey<Observed satisfies Observation>(expected_tag: u64) reaches IntegerDivision crashes Trap {
 transition Observed::observe(expected_tag) { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
machine mac_entry() reaches IntegerDivision crashes Trap { journey<MacObservation>(17u64); }
machine windows_entry() reaches IntegerDivision crashes Trap { journey<WindowsObservation>(29u64); }
machine linux_entry() reaches IntegerDivision crashes Trap { journey<LinuxObservation>(43u64); }
machine linux_arm_entry() reaches IntegerDivision crashes Trap { journey<LinuxArmObservation>(61u64); }
