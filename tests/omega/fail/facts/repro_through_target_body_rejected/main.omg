// Checked IEEE guard value == value && value >= 0.0 && value < 1000000000.0 proves I32::from_f64(value) is finite and in range.
// Invalid: the guard and target-body preconditions omit the upper bound value < 1000000000.0, so I32::from_f64(value) is not proved in range.
// Expected exit: 0
use omega::language::core::float_operations;
linux_x86_64 machine convert(value: f64) -> i32
requires value == value && value >= 0.0
{ I32::from_f64(value) }
linux_arm64 machine convert(value: f64) -> i32
requires value == value && value >= 0.0
{ I32::from_f64(value) }
macos_arm64 machine convert(value: f64) -> i32
requires value == value && value >= 0.0
{ I32::from_f64(value) }
windows_x86_64 machine convert(value: f64) -> i32
requires value == value && value >= 0.0
{ I32::from_f64(value) }
machine bounded(value: f64) -> i32 {
    transition value == value && value >= 0.0 {
        true -> convert(value)
        false -> zero()
    }
    machine zero() -> i32 { 0 }
}

machine main() crashes Trap {
    let inside: i32 = bounded(123.75);
    transition inside == 123 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
