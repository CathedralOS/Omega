// Expected exit: 0
// Selected<Base + 4> at Base = 3 supplies at least seven before exact value - 7.
trait Reading<const Minimum: u64> {
    machine read(destination: &mut u64) ensures destination >= Minimum;
}
Selected<const Value: u64> satisfies Reading<Value> {
    machine read(destination: &mut u64) ensures destination == Value { destination = Value; }
}
machine selected<const Minimum: u64, Implementation satisfies Reading<Minimum>>() -> u64
ensures result >= Minimum
{
    let mut value: u64 = 0;
    Implementation::read(&mut value);
    value = 0;
    value
}
machine construct<const Base: u64>() -> u64
requires Base <= 100
ensures result >= Base + 4
{ selected<Base + 4, Selected<Base + 4>>() }
const VALUE: u64 = construct<3>();
machine main() crashes Trap {
    let value: u64 = VALUE;
    let runtime_value: u64 = construct<3>();
    let difference: u64 = value - 7;
    let runtime_difference: u64 = runtime_value - 7;
    transition difference == 0 && runtime_difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
