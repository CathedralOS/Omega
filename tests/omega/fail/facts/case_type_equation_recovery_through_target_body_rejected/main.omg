// Matching `Value::Integer` or `Value::Boolean` recovers `T == i32` or `T == bool` from the data's default domain, so the generic extractor `extract<T>(v: Value<T>) -> T` returns each payload as `T`, and the specialization for `Value<i32>` or `Value<bool>` keeps only the arm its instance admits.
// Expected error: return value expects `T`, but the value is delivered as `bool`
public data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || (self in Value::Boolean)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine extract<T>(v: Value<T>) -> T {
    match v {
        Value::Integer { value } -> value
        Value::Boolean { value } -> value
    }
}
boundary trait ValueProvider {
    machine number() -> Value<i32> reaches;
    machine other_number() -> Value<i32> reaches;
    machine flag() -> Value<bool> reaches;
    machine other_flag() -> Value<bool> reaches;
}
HostedValue satisfies ValueProvider {
    machine number() -> Value<i32> { Value::Integer { value: 7 } }
    machine other_number() -> Value<i32> { Value::Integer { value: 9 } }
    machine flag() -> Value<bool> { Value::Boolean { value: true } }
    machine other_flag() -> Value<bool> { Value::Boolean { value: false } }
}
machine main() crashes Trap {
    let number: Value<i32> = ValueProvider::number();
    let other_number: Value<i32> = ValueProvider::other_number();
    let flag: Value<bool> = ValueProvider::flag();
    let other_flag: Value<bool> = ValueProvider::other_flag();
    transition extract(number) == 7 && extract(other_number) == 9
        && extract(flag) == true && extract(other_flag) == false {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
