// Seed.code == 7 survives each place into the unconsumed second field of a returned Pair, so consuming first by value preserves the original sibling claim through normal cleanup.
// Expected exit: 0
const SEED_CODE: u64 = 8;
data Seed [copy] { code: u64; }
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt)
requires receipt.code == 7
{
    receipt.code = 0;
}
data Pair { first: Receipt; second: Receipt; }
machine issue(code: u64) -> Pair
ensures result.first.code == 7 && result.second.code == code
{
    Pair { first: Receipt { code: 7 }, second: Receipt { code: code } }
}
machine consume(receipt: Receipt) -> u64
requires receipt.code == 7
ensures result == 7
{
    receipt.code
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedAcross {
    machine across()
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Across satisfies SelectedAcross {
    machine across()
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let seed: Seed = Seed { code: SEED_CODE };
        let difference: u64 = consume(issue(seed.code).first) - 7;
        transition difference == 0 { true -> done() false -> bad() }
        machine done() {}
        machine bad() { crash Trap; }
    }
}

ArmAcross satisfies SelectedAcross {
    machine across()
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let seed: Seed = Seed { code: SEED_CODE };
        let difference: u64 = consume(issue(seed.code).first) - 7;
        transition difference == 0 { true -> done() false -> bad() }
        machine done() {}
        machine bad() { crash Trap; }
    }
}


machine main() crashes Trap {
    SelectedAcross::across();
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
