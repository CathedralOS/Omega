// A ranked terminal cycle of nested machines whose every edge acknowledges `suspend` adds each parked step's answer and forwards the total to its ordinary caller.
// Place: target body. A Build-selected named implementation runs the cycle; each implementation adds its own tag.
// Rejected: the ancestor edge omits the `suspend` its callee's envelope requires.
public boundary trait Scheduler {
    machine advance(value: u64) -> u64 reaches suspends;
}
InlineScheduler satisfies Scheduler {
    machine advance(value: u64) -> u64 { (value as u64 in Wrapping * 3) as u64 }
}
machine sum(total: u64, remaining: u64) -> u64 reaches Scheduler suspends terminates by remaining {
    transition remaining == 0 {
        true -> total
        false -> suspend step(total, remaining)
    }
    machine step(total: u64, remaining: u64) -> u64 reaches Scheduler suspends
    requires remaining > 0
    {
        let seen: u64 = suspend Scheduler::advance(remaining);
        transition { _ -> suspend fold(total, seen, remaining) }
    }
    machine fold(total: u64, seen: u64, remaining: u64) -> u64 reaches Scheduler suspends
    requires remaining > 0
    {
        let next: u64 = ((total as u64 in Wrapping) + (seen as u64 in Wrapping)) as u64;
        transition { _ -> sum(next, remaining - 1) }
    }
}
boundary trait SelectedCycle {
    machine run(rounds: u64) -> u64 reaches Scheduler invokes Scheduler suspends;
}
X86Cycle satisfies SelectedCycle {
    machine run(rounds: u64) -> u64 reaches Scheduler invokes Scheduler suspends {
        suspend sum(17, rounds)
    }
}
ArmCycle satisfies SelectedCycle {
    machine run(rounds: u64) -> u64 reaches Scheduler invokes Scheduler suspends {
        suspend sum(29, rounds)
    }
}
machine check(expected_full: u64, expected_empty: u64) reaches Scheduler SelectedCycle suspends crashes Trap {
    let full: u64 = suspend SelectedCycle::run(100000);
    let empty: u64 = suspend SelectedCycle::run(0);
    transition full == expected_full && empty == expected_empty {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine x86_entry() reaches Scheduler SelectedCycle crashes Trap {
    suspend check(15000150017, 17);
}
machine arm_entry() reaches Scheduler SelectedCycle crashes Trap {
    suspend check(15000150029, 29);
}
