// Fact: 8-bit unsigned bitwise XOR raw ^ 15u8 with bounded interval 40u8 <= xored <= 63u8 establishes 40u8 <= xored <= 63u8 across all nine places so exact subtractions 63u8 - xored and xored - 40u8 are safe.
// Place: other_state. A state transition forwards the bitwise XOR result to a successor state.
// Expected exit: 0
machine verify_xored(res: u8) -> i32
    requires res >= 40 && res <= 63
{
    let head: u8 = 63 - res;
    let tail: u8 = res - 40;
    let sum: i32 = (head as i32) + (tail as i32);
    sum - 23
}

machine compute_other_state(raw: u8) -> i32
    requires raw >= 64 && raw <= 64
{
    let xored: u8 = raw ^ 15;
    transition { _ -> step(xored) }
    machine step(s: u8) -> i32 {
        verify_xored(s)
    }
}

machine evaluate() -> i32 {
    compute_other_state(64)
}

machine main() crashes Trap {
    let res: i32 = evaluate();
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
