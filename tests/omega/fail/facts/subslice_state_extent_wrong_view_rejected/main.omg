// Expected exit: 0. A guarded subslice retains its geometry around a content write.
machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left _ -> right }
}
machine write_first(buffer: &mut [u8]) requires buffer.len >= 1024 {
    buffer[0] = 17;
}
machine trial(buffer: &mut [u8], count: u64) -> u8 {
    let capacity: u64 = minimum(count, buffer.len);
    transition { _ -> transfer(&mut buffer[0..capacity]) }
    machine transfer(buffer: &mut [u8]) -> u8 {
        let other: [u8; 1024];
        transition other.len >= 1024 { true -> extended(buffer) _ -> 0 }
    }
    machine extended(buffer: &mut [u8]) -> u8
    requires buffer.len >= 1024;
    {

        let position: u64 = buffer.len - 4;
        let saved: u8 = buffer[position];
        write_first(buffer);
        buffer[position] = saved;
        buffer[position]
    }
}
machine main() crashes Trap {
    let mut bytes: [u8; 1026];
    bytes[0] = 91;
    bytes[1021] = 84;
    bytes[1025] = 92;
    let saved: u8 = trial(&mut bytes[1..1025], 18446744073709551615);
    transition saved == 84 && bytes[0] == 91 && bytes[1] == 17
        && bytes[1021] == 84 && bytes[1025] == 92 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
