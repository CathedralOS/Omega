// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: local. The shifted value is transported through intermediate local bindings.
// Invalid control: val lower bound weakened to 25u16, allowing shifted as low as 100u16 and failing subtraction shifted - 120u16.
// Expected rejection: may overflow `u16`

machine shift_local(val: u16) -> i32
    requires val >= 25u16 && val <= 30u16;
{
    let v: u16 = val;
    let s: u16 = v << 2u16;
    let shifted: u16 = s;
    let check: u16 = shifted - 120u16;
    transition shifted == 120u16 && check == 0u16 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = shift_local(30u16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
