// Another state receives the standing field and still discharges
// `arr[index + 1]`. The arrival requires is proved from `main.k`.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

data Main where 0 <= k, k <= 4 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine use(main: &Main) -> i32 in Wrapping {
    transition { _ -> pick(main, main.k) }
    machine pick(main: &Main, index: u64) -> i32 in Wrapping
    requires 0 <= index && index <= 4
    {
        main.arr[index + 1]
    }
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = use(main);
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = use(main);
        main.hits = main.r;
    }
}
