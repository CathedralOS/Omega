// A runtime limit from 9 to 10 binds Index<limit>, retaining payload 8 below the exact captured limit.
// Expected exit: 0

domain<const Bound:u64> u64::AtMost<Bound>(value) requires value <= Bound;
data Index<const Max:u64,Limit:u64 in AtMost<Max>> [copy] where value<Limit {value:u64;}
data Observation [copy] {payload:u64;limit:u64;}

machine construct(total:u64[8..=9])->Observation {
 let indexed:Index<10,((total+1u64) as u64 in AtMost<10>)> = Index{value:10};
 Observation{payload:indexed.value,limit:(indexed.Limit as u64)}
}

const Minimum:u64=8;
const Maximum:u64=9;
machine probe(total:u64[Minimum..=Maximum])->Observation {construct(total)}
machine main() crashes Trap {
 let first:Observation=probe(8);
 let second:Observation=probe(9);
 transition first.payload==8 && first.limit==9 && second.payload==8 && second.limit==10 {true->done() _->bad()}
 machine done() {}
 machine bad() crashes Trap {crash Trap;}
}
