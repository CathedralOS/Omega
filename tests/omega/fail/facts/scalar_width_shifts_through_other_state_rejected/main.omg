// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: another state (invalid twin). Successor state with plain u32 without in Wrapping may overflow.
machine shift_round_trip(val: u32, shift: u32) -> u32
    requires shift < 4
{
    transition { _ -> perform_shift(val, shift) }
    machine perform_shift(v: u32, s: u32) -> u32
        requires s < 4
    {
        let shifted: u32 = v << s;
        shifted >> s
    }
}

machine probe(val: u32, shift: u32) -> u32
    requires shift < 4
{
    shift_round_trip(val, shift)
}

machine main() crashes Trap {
    let val: u32 = 21;
    let shift: u32 = 1;
    let recovered: u32 = probe(val, shift);
    let shifted: u32 = val << shift;
    transition shifted == 42 && recovered == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
