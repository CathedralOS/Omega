// A checked call publishes its complete Mark reach, so an empty ceiling cannot hide it.
// Expected exit: 0
use support::values;
MarkerMark satisfies Mark { machine read() -> u64 { 7 } }
machine main() reaches crashes Trap {
    let value: u64 = fetch_mark();
    transition { _ -> check(value) }
    state check(value: u64) {
        transition value == 7 { true -> done() _ -> bad() }
    }
    state done() {}
    state bad() { crash Trap; }
}
