data Snapshot { value:u64; }
machine main() crashes Trap {
 let mut object:Snapshot=Snapshot{value:0};
 observe(&mut object);
 transition { _ -> done() }
 machine done(){}
}
machine clear(object:&mut Snapshot) { object.value=0u64; }
machine observe(object:&mut Snapshot) {
 asm { mov eax,1; sub eax,1; pushfq object.value }
 let alias:&mut Snapshot=&mut object;
 clear(alias);
 asm { observed requires (object.value&64u64)==64u64:nop }
}
