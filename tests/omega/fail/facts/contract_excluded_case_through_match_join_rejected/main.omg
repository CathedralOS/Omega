// A generic extractor whose contract states `T == i32` (or `T == bool`) owes no arm for the case whose default domain states the other type, so `extract_int` lists only `Integer` and `extract_flag` only `Boolean`: they return `7` and `9` from `Value<i32>`, `true` and `false` from `Value<bool>`.
// Expected error: match does not cover its subject
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine extract_int<T>(v: Value<T>) -> T {
    match v {
        Value::Integer { value } -> value
    }
}
machine extract_flag<T>(v: Value<T>) -> T requires T == bool {
    match v {
        Value::Boolean { value } -> value
    }
}
machine join_int(choose: bool, left: Value<i32>, right: Value<i32>) -> i32 {
    let joined: Value<i32> = match choose { true -> left, false -> right };
    extract_int(joined)
}
machine join_flag(choose: bool, left: Value<bool>, right: Value<bool>) -> bool {
    let joined: Value<bool> = match choose { true -> left, false -> right };
    extract_flag(joined)
}
machine main() crashes Trap {
    let number: Value<i32> = Value::Integer { value: 7 };
    let other_number: Value<i32> = Value::Integer { value: 9 };
    let flag: Value<bool> = Value::Boolean { value: true };
    let other_flag: Value<bool> = Value::Boolean { value: false };
    transition join_int(true, number, other_number) == 7 && join_int(false, number, other_number) == 9
        && join_flag(true, flag, other_flag) == true && join_flag(false, flag, other_flag) == false {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
