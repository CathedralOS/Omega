// `Held` selects release_keeper but states no code predicate, and the caller hands the generic `forward<T>` an owner whose code is 6.
// Production: an erased generic formal receives a named-domain qualified owner; the hook's `requires keeper.code == 7` becomes a prerequisite of the call.
// Expected: rejected at the call, because the caller's value does not establish the hook clause.
data Counter { value: u64; invocations: u64 in Wrapping; }
data Keeper { output: &mut Counter; code: u64; }
domain Keeper::Held dropped by release_keeper;
machine release_keeper(keeper: &mut Keeper) requires keeper.code == 7 {
    keeper.output.value = keeper.code;
    keeper.output.invocations = keeper.output.invocations + 1;
}
machine check(output: &Counter) crashes Trap {
    transition output.value == 7 && output.invocations == 1 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine forward<T>(value: T) {}
machine main() crashes Trap {
    let mut output: Counter = Counter { value: 0, invocations: 0 };
    let keeper: Keeper in Held = Keeper { output: &mut output, code: 6 };
    forward(keeper);
    check(&output);
}
