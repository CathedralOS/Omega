// Independently authored selected-index snapshot falsifier.
// Expected exit: 0
data Payload [copy] { case Pending(count: u64); case Empty; }
machine [] replacement(items: &[Payload; 1], index: u64) -> Payload
requires index < 1;
ensures result in Payload::Empty;
{ Payload::Empty {} }
machine consume(picked: Payload)
requires picked in Payload::Pending;
{}
machine main() {
 let items: [Payload; 1] = [Payload::Pending { count: 7 }];
 consume(items[0]);
}
