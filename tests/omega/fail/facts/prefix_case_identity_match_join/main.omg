// Fact: Numbered mixed data preserves the active payload bound, common field and neighbor canaries; schema case 90 is authored first and remains the ordinary zero case.
// Expected exit: 0

domain u64::PayloadValue requires self <= 80;

data Reading [copy] {
    #1 common: u64;
    #90 case Sample(#1 value: u64 in PayloadValue, retired #2);
    #7 case Empty;
}

data Neighbors [copy] {
    left: u64;
    reading: Reading;
    right: u64;
}

machine join_reading(first: Reading, second: Reading, use_first: bool) -> Reading {
    transition use_first { true -> first _ -> second }
}

machine evaluate(reading: Reading, expected_common: u64) -> u64
ensures result <= 60
crashes Trap
{
    let local_reading: Reading = reading;
    transition local_reading.common == expected_common {
        true -> inspect(local_reading)
        _ -> bad()
    }
    machine inspect(selected: Reading) -> u64 {
        transition selected {
            Reading::Sample { value, .. } -> (value + 10)
            Reading::Empty { .. } -> 3
        }
    }
    machine bad() -> u64 { crash Trap; }
}

machine main() crashes Trap {
    let neighbors: Neighbors = Neighbors {
        left: 305419896,
        reading: Reading::Sample { common: 91, value: 32 },
        right: 1515863100,
    };
    let fallback: Reading = Reading::Empty { common: 73 };
    let zero_value: Reading;
    let selected_sample: Reading = join_reading(neighbors.reading, fallback, true);
    let selected_fallback: Reading = join_reading(neighbors.reading, fallback, false);
    let selected_zero: Reading = join_reading(zero_value, fallback, true);
    let sample_result: u64 = evaluate(selected_sample, 91);
    let fallback_result: u64 = evaluate(selected_fallback, 73);
    let zero_result: u64 = evaluate(selected_zero, 0);
    transition sample_result == 42 && fallback_result == 3 && zero_result == 10
        && neighbors.left == 305419896 && neighbors.right == 1515863100
        && neighbors.reading.common == 91 && fallback.common == 73 && zero_value.common == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
