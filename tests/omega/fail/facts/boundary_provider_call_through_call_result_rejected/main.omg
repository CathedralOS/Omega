// Fact: a provider-settled boundary call whose contract establishes result >= 99u64 && result <= 99u64 discharges exact subtraction result - 100u64.
// Place: call_result. The boundary call result returned across a machine call boundary.
// Expected rejection: exact arithmetic in a machine or state may overflow `u64`.
boundary trait Provider {
    machine get() -> u64 reaches ensures result >= 99u64 && result <= 99u64;
}

Actual satisfies Provider {
    machine get() -> u64 ensures result >= 99u64 && result <= 99u64 {
        99
    }
}

machine run() -> u64 reaches Provider {
    acquire() - 100u64
}

machine acquire() -> u64 reaches Provider ensures result >= 99u64 && result <= 99u64 {
    Provider::get()
}

machine main() crashes Trap {
    transition run() == 0u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
