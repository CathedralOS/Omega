// Every call to entry names the visible machine and supplies all three declared parameters.
data Note { value: u64; tag: u64; nonce: u64; }
const FIRST: u64 = 7;
const SECOND: u64 = 9;
machine probe(select: bool) -> Note {
    transition select { true -> next(FIRST, select) false -> next(SECOND, select) }
    machine next(value: u64, select: bool) -> Note {
        transition { _ -> entry(value, select) }
    }
    machine entry(value: u64, select: bool, nonce: u64) -> Note {
        let tag: u64 = match select { true -> 11, false -> 13 };
        Note { value: value, tag: tag, nonce: nonce }
    }
}
machine main() crashes Trap {
    let first: Note = probe(true);
    let second: Note = probe(false);
    transition first.value == 7 && first.tag == 11 && first.nonce == 17 && second.value == 9 && second.tag == 13 && second.nonce == 17 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
