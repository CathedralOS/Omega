use omega::language::core::activation;
machine main() crashes Trap {
    transition Activation::try_claim<8>(3) {
        ActivationClaimAttempt::Established { claim } -> first(claim)
        ActivationClaimAttempt::Rejected -> bad()
    }
    state first(first: ActivationClaim) {
        transition Activation::try_claim<8>(3) {
            ActivationClaimAttempt::Established { claim } -> second(first, claim)
            ActivationClaimAttempt::Rejected -> rejected(first)
        }
    }
    state second(first: ActivationClaim, second: ActivationClaim) {
        ActivationClaim::release(first);
        ActivationClaim::release(second);
    }
    state rejected(first: ActivationClaim) { ActivationClaim::release(first); crash Trap; }
    state bad() { crash Trap; }
}
