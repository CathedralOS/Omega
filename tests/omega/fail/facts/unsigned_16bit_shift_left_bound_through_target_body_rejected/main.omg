// Fact: A 16-bit unsigned u16 logical left shift of a bounded input (val >= 30u16 && val <= 30u16) by 2u16 bits establishes shifted >= 120u16 && shifted <= 120u16 so exact 16-bit subtraction shifted - 120u16 is proved underflow-free across all nine places.
// Place: another target body. Target-scoped implementations across all four platforms verify the bounds.
// Invalid control: val lower bound weakened to 25u16, allowing shifted as low as 100u16 and failing subtraction shifted - 120u16.
// Expected rejection: may overflow `u16`

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedShiftTarget {
    machine shift_target(val: u16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 25u16 && val <= 30u16;
}

X86ShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 25u16 && val <= 30u16
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u16 = val << 2u16;
        let check: u16 = shifted - 120u16;
        transition shifted == 120u16 && check == 0u16 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

ArmShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 25u16 && val <= 30u16
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u16 = val << 2u16;
        let check: u16 = shifted - 120u16;
        transition shifted == 120u16 && check == 0u16 {
            true -> pass()
            _ -> fail()
        }
        machine pass() -> i32 { 0 }
        machine fail() -> i32 { 1 }
    }
}

machine main() crashes Trap {
    let res: i32 = SelectedShiftTarget::shift_target(30u16);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
