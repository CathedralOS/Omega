// Fact: 8-bit unsigned bitwise AND mask raw & 63u8 with bounded interval 40u8 <= masked <= 63u8 establishes 40u8 <= masked <= 63u8 across all nine places so exact subtractions 63u8 - masked and masked - 40u8 are safe.
// Invalid: widened mask 127 produces masked == 116 > 63, failing exercise requires contract.

machine compute_mask(raw: u8) -> u8
    requires raw >= 116 && raw <= 116
{
    raw & 127u8
}

machine verify_masked(masked: u8) -> i32
    requires masked >= 40 && masked <= 63
{
    let headroom: u8 = 63 - masked;
    let margin: u8 = masked - 40;
    let total: u8 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 63;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 63
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_masked(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: u8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
        requires val >= 40 && val <= 63
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_masked(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let raw: u8 = 116;
    let masked: u8 = compute_mask(raw);
    let check: i32 = SelectedProbe::exercise(masked);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
