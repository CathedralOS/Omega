// Fact: align_of(value) observes the storage location of a live u64 place, the referent of a &u64, or the first element of a nonempty [u64] slice, and reports that location's guaranteed alignment, at least 8u64 on every hosted target, discharging exact subtraction alignment - 8u64 across all nine places.
// Invalid: the contracted field is a u32, whose guaranteed alignment is only 4u64, so the requires clause cannot hold for any caller.

data Holder { tag: u8; cell: u32; small: u32; }

machine slack_of(holder: &Holder) -> u64
requires align_of(holder.cell) >= 8u64
{
    let alignment: u64 = align_of(holder.cell);
    alignment - 8u64
}

machine neighbour_alignments(holder: &Holder) -> u64
requires align_of(holder.tag) >= 1u64 && align_of(holder.small) >= 4u64
{
    align_of(holder.tag) * 10u64 + align_of(holder.small)
}

machine main() crashes Trap {
    let holder: Holder = Holder { tag: 3u8, cell: 41u32, small: 7u32 };
    let slack: u64 = slack_of(&holder);
    let neighbours: u64 = neighbour_alignments(&holder);
    transition slack == 0u64 && neighbours == 14u64 && holder.cell == 41u32 && holder.tag == 3u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
