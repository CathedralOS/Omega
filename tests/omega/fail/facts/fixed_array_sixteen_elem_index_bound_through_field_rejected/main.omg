// Fact: a static index bound idx < 16u64 carried through the place proves safe fixed-size array indexing arr[idx] on [u64; 16].
// Place: field. A record field carries the bounded index alongside the fixed-extent array.
// Invalid: the record constraint is weakened to index <= 16u64, so the field index may exceed length 16.
// Expected rejection: cannot prove index

data Container where index <= 16u64 {
    values: [u64; 16];
    index: u64;
}

machine read_element(container: Container) -> u64 {
    container.values[container.index]
}

machine main() crashes Trap {
    let arr: [u64; 16] = [
        10u64, 20u64, 30u64, 40u64, 50u64, 60u64, 70u64, 80u64,
        90u64, 100u64, 110u64, 120u64, 130u64, 140u64, 150u64, 160u64
    ];
    let container: Container = Container { values: arr, index: 11u64 };
    let elem: u64 = read_element(container);
    transition elem == 120u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
