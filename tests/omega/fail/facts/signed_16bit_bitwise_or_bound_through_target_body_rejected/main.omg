// Fact: 16-bit signed bitwise OR base | 32i16 with bounded interval 40i16 <= combined <= 63i16 establishes 40i16 <= combined <= 63i16 across all nine places so exact subtractions 63i16 - combined and combined - 40i16 are safe.
// Invalid: widened mask 64 produces combined == 84 > 63, failing exercise requires contract.

machine compute_or(base: i16) -> i16
    requires base >= 20 && base <= 20
{
    base | 64i16
}

machine verify_combined(combined: i16) -> i32
    requires combined >= 40 && combined <= 63
{
    let headroom: i16 = 63 - combined;
    let margin: i16 = combined - 40;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 40 && val <= 63;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 40 && val <= 63
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_combined(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 40 && val <= 63
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_combined(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let base: i16 = 20;
    let combined: i16 = compute_or(base);
    let check: i32 = SelectedProbe::exercise(combined);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
