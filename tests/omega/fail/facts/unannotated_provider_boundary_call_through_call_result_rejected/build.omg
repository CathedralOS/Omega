machine build(builder: &mut Build) {
    Build::application(builder, "unannotated_provider_boundary_call_through_call_result");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Mark, MarkerMark>(builder, linux_x86_64);
    Build::select_provider<Mark, MarkerMark>(builder, linux_arm64);
    Build::select_provider<Mark, MarkerMark>(builder, macos_arm64);
    Build::select_provider<Mark, MarkerMark>(builder, windows_x86_64);
    Build::select_provider<Backend, BackendProvider>(builder, linux_x86_64);
    Build::select_provider<Backend, BackendProvider>(builder, linux_arm64);
    Build::select_provider<Backend, BackendProvider>(builder, macos_arm64);
    Build::select_provider<Backend, BackendProvider>(builder, windows_x86_64);
}
