// An x86 mov through a typed view index copies the indexed element by the place's ordinary assignment.
// Expected exit: 0.
data Cells { values: [u32; 2]; }
machine main() crashes Trap {
    let mut cells: Cells = Cells { values: [7, 9] };
    fill(&mut cells);
}
machine fill(cells: &mut Cells) crashes Trap {
    asm {
        mov eax, 37;
        mov [cells.values], eax
    }
    transition cells.values[0] == 37 && cells.values[1] == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
