machine build(builder: &mut Build) {
    Build::application(builder, "dynamic_trait_dispatch_through_target_body_invalid");
    Build::accept_boundary<SelectedCombine>(builder);
    Build::select_provider<SelectedCombine, X86Combine>(builder, windows_x86_64);
    Build::select_provider<SelectedCombine, X86Combine>(builder, linux_x86_64);
    Build::select_provider<SelectedCombine, ArmCombine>(builder, macos_arm64);
    Build::select_provider<SelectedCombine, ArmCombine>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, arm_main);
    Build::bind(builder, linux_arm64::ProgramEntry, arm_main);
}
