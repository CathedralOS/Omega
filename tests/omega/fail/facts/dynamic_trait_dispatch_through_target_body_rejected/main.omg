// Fact: a runtime dyn trait selector dispatches an inline conformance member over explicit data arguments to establish 100u64 when subtracting 100u64.
// Place: another target body (invalid twin). The target bodies lack the right operand bound.
// Expected exit: 0

trait WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
}

UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        left + right
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}
X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
boundary trait SelectedProbe {
    machine probe(a: u64, b: u64) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires a >= 60u64 && a <= 60u64;
}
X86Probe satisfies SelectedProbe {
    machine probe(a: u64, b: u64) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires a >= 60u64 && a <= 60u64
    {
        SelectedBodyCheck::require_tag(17u64);
        let selector: dyn WeightedCombine = UnitCombine as dyn WeightedCombine;
        let total: u64 = WeightedCombine::combine(selector, a, b);
        let diff: u64 = total - 100u64;
        diff as i32
    }
}
ArmProbe satisfies SelectedProbe {
    machine probe(a: u64, b: u64) -> i32 reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    requires a >= 60u64 && a <= 60u64
    {
        SelectedBodyCheck::require_tag(29u64);
        let selector: dyn WeightedCombine = UnitCombine as dyn WeightedCombine;
        let total: u64 = WeightedCombine::combine(selector, a, b);
        let diff: u64 = total - 100u64;
        diff as i32
    }
}

machine main() crashes Trap {
    let result: i32 = SelectedProbe::probe(60u64, 40u64);
    transition result == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
