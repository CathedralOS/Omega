// Fact: a checked subslice of an immutable byte-view literal preserves its exact window length of 10u64 when multiplied by 10u64 and subtracting 100u64.
// Place: parameter (invalid twin).
// Expected diagnostic: exact subtraction underflow

machine compute(window_len: u64) -> u64
requires window_len == 9u64
ensures result == 90u64
{
    window_len * 10u64
}

machine probe() -> u64 {
    let bytes: &[u8] = "0123456789ABCD";
    let window: &[u8] = bytes[2u64..11u64];
    let total: u64 = compute(window.len);
    total - 100u64
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
