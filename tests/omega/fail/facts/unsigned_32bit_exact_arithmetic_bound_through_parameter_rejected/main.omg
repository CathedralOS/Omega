// Fact: Adding two bounded 32-bit unsigned u32 values (lhs >= 20u32 && lhs <= 40u32 and rhs >= 30u32 && rhs <= 50u32) establishes the exact post-addition interval (sum >= 50u32 && sum <= 90u32), discharging both 90u32 - sum and sum - 50u32 across all nine places.
// Place: parameter. The bounded u32 operands are operated on directly through parameter bindings.
// Invalid control: rhs upper bound widened to 51u32, allowing sum up to 91u32 and failing headroom subtraction.
// Expected rejection: may overflow `u32`

machine evaluate(lhs: u32, rhs: u32) -> i32
    requires lhs >= 20u32 && lhs <= 40u32;
    requires rhs >= 30u32 && rhs <= 51u32;
{
    let sum: u32 = lhs + rhs;
    let headroom: u32 = 90u32 - sum;
    let margin: u32 = sum - 50u32;
    transition sum == 70u32 && headroom == 20u32 && margin == 20u32 {
        true -> pass()
        _ -> fail()
    }
    machine pass() -> i32 { 0 }
    machine fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res: i32 = evaluate(30u32, 40u32);
    transition res == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
