// A linear Token [linear] carries its exact payload across the place and retires through its explicit consuming machine on every normal exit.
// Place: field. An enclosing record field carries the linear Token before retirement.
// Expected exit: 0
use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
machine retire(token: Token) -> u64 {
    let v: u64 = token.value;
    drop(token);
    v
}

data Holder {
    item: Token;
}

machine probe() -> u64 {
    let holder: Holder = Holder { item: Token { value: 42 } };
    let first: u64 = retire(holder.item);
    retire(holder.item)
}

machine main() crashes Trap {
    transition probe() == 42 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
