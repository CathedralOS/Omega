// A saved observation that items[0] is 7 stays provable across a complete, non-writing exclusive call on that element.
// This twin writes 8 through the borrowed element, so the saved observation is stale.
machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine expose(slot: &mut u64) -> u64 {
    slot = 8;
    slot
}

machine hold(items: &mut [u64; 2], observed: u64) -> u64
requires observed == items[0] && observed == 7
{
    let held: u64 = expose(&mut items[0]);
    let agreed: u64 = agree(observed, items[0]);
    transition { _ -> finish(agreed, held) }
    machine finish(agreed: u64, held: u64) -> u64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

machine main() crashes Trap {
    let mut items: [u64; 2] = [7, 1];
    let saved: u64 = items[0];
    transition hold(&mut items, saved) == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
