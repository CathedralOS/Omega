// Checked IEEE guard value == value && value >= 0.0 && value < 1000000000.0 proves I32::from_f64(value) is finite and in range.
// Invalid: the guard omits the upper bound value < 1000000000.0, so I32::from_f64(copied) is not proved in range.
// Expected exit: 0
use omega::language::core::float_operations;
machine bounded(value: f64) -> i32 {
    let copied: f64 = value;
    transition value == value && value >= 0.0 {
        true -> finish(I32::from_f64(copied))
        false -> zero()
    }
    machine finish(observed: i32) -> i32 { observed }
    machine zero() -> i32 { 0 }
}

machine main() crashes Trap {
    let inside: i32 = bounded(123.75);
    transition inside == 123 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
