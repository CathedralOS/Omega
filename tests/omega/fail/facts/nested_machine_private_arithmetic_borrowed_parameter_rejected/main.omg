// Every private arrival carries a positive value, so the helper can form value - 1.
data Storage { value: u64; touched: u64; canary: u64; }
data Note { value: u64; tag: u64; }
machine probe(value: u64, select: bool, output: &mut Storage) -> Note {
    transition value > 0 {
        true -> apply(0, select, output)
        false -> Note { value: 0, tag: 0 }
    }
    machine apply(value: u64, select: bool, output: &mut Storage) -> Note {
        output.value = value;
        checked(output, select)
        machine checked(storage: &mut Storage, select: bool) -> Note {
            storage.touched = 5;
            let value: u64 = storage.value;
            let result: u64 = value - 1;
            let tag: u64 = match select { true -> 11, false -> 13 };
            Note { value: result, tag: tag }
        }
    }
}
machine main() crashes Trap {
    let mut output: Storage = Storage { value: 77, touched: 0, canary: 33 };
    let first: Note = probe(7, true, &mut output);
    let second: Note = probe(9, false, &mut output);
    let zero: Note = probe(0, true, &mut output);
    transition output.value == 9 && output.touched == 5 && output.canary == 33 && first.value == 6 && first.tag == 11 && second.value == 8 && second.tag == 13 && zero.value == 0 && zero.tag == 0 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
