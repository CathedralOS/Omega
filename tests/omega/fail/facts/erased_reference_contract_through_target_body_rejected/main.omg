// An erased &i32 witness whose referent is 7 discharges witness == 7 at keep without a runtime witness argument, read, storage or cleanup.
// Expected exit: 0
machine keep(runtime: i32, witness [erased]: &i32) -> i32
requires witness == 7 { runtime }
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedSelected {
    machine selected(flag: bool) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Selected satisfies SelectedSelected {
    machine selected(flag: bool) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let runtime: i32 = match flag { true -> 41, false -> 42 };
        let value: i32 = 8;
        keep(runtime, &value)
    }
}

ArmSelected satisfies SelectedSelected {
    machine selected(flag: bool) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let runtime: i32 = match flag { true -> 41, false -> 42 };
        let value: i32 = 8;
        keep(runtime, &value)
    }
}


machine exercise(flag: bool) -> i32 {
    SelectedSelected::selected(flag)
}
machine verify(result: i32, flag: bool) crashes Trap {
    transition (flag && result == 41) || (!flag && result == 42) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine run(flag: bool) crashes Trap {
    let result: i32 = exercise(flag);
    verify(result, flag);
}
machine main() crashes Trap { run(true); run(false); }
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}

// The separate record-only twin below transports the same field fact through this place.
// Erased primitive and record references discharge their value-7 requirements at keep_record without runtime witness arguments, reads, storage or cleanup.
// Expected exit: 0
data record_Witness { value: i32; }
machine keep_record(runtime: i32, witness [erased]: &i32, record [erased]: &record_Witness) -> i32
requires witness == 7
requires record.value == 7 { runtime }
boundary trait record_SelectedBodyCheck {
    machine record_require_tag(tag: u64) reaches crashes Trap;
}

record_X86BodyCheck satisfies record_SelectedBodyCheck {
    machine record_require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> record_done() false -> record_wrong() }
        machine record_done() {}
        machine record_wrong() { crash Trap; }
    }
}

record_ArmBodyCheck satisfies record_SelectedBodyCheck {
    machine record_require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> record_done() false -> record_wrong() }
        machine record_done() {}
        machine record_wrong() { crash Trap; }
    }
}

boundary trait record_SelectedSelected {
    machine record_selected(flag: bool) -> i32
        reaches record_SelectedBodyCheck invokes record_SelectedBodyCheck crashes Trap;
}

record_X86Selected satisfies record_SelectedSelected {
    machine record_selected(flag: bool) -> i32
        reaches record_SelectedBodyCheck invokes record_SelectedBodyCheck crashes Trap
    {
        record_SelectedBodyCheck::record_require_tag(17u64);
        let runtime: i32 = match flag { true -> 41, false -> 42 };
        let value: i32 = 7;
        let record: record_Witness = record_Witness { value: 8 };
        keep_record(runtime, &value, &record)
    }
}

record_ArmSelected satisfies record_SelectedSelected {
    machine record_selected(flag: bool) -> i32
        reaches record_SelectedBodyCheck invokes record_SelectedBodyCheck crashes Trap
    {
        record_SelectedBodyCheck::record_require_tag(29u64);
        let runtime: i32 = match flag { true -> 41, false -> 42 };
        let value: i32 = 7;
        let record: record_Witness = record_Witness { value: 8 };
        keep_record(runtime, &value, &record)
    }
}


machine record_exercise(flag: bool) -> i32 {
    record_SelectedSelected::record_selected(flag)
}
machine record_verify(result: i32, flag: bool) crashes Trap {
    transition (flag && result == 41) || (!flag && result == 42) {
        true -> record_done()
        false -> record_bad()
    }
    machine record_done() {}
    machine record_bad() { crash Trap; }
}
machine record_run(flag: bool) crashes Trap {
    let result: i32 = record_exercise(flag);
    record_verify(result, flag);
}
machine record_main() crashes Trap { record_run(true); record_run(false); }
machine record_x86_entry() crashes Trap {
    record_SelectedBodyCheck::record_require_tag(17u64);
    record_main();
}
machine record_arm_entry() crashes Trap {
    record_SelectedBodyCheck::record_require_tag(29u64);
    record_main();
}
