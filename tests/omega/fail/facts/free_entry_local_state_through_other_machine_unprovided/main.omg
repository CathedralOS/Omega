// A free entry owns and cleans an ordinary local tally of 7, and the hosted contract supplies no provisioned ZII context.
// Place: other_machine.
// Expected exit: 0
data Tally { total: u64; }
data Mark { slot: &mut Tally; code: u64; }
machine Mark::drop(mark: &mut Mark) requires mark.code == 7 {
    mark.slot.total = mark.code;
}
machine settle(mark: &Mark) {}
machine supply() -> u64 ensures result == 7 {
    7
}
machine relay() -> u64 ensures result == 7 {
    supply()
}
machine start(unprovided: u64) crashes Trap {
    let code: u64 = relay();
    let mut tally: Tally = Tally { total: 0 };
    settle(&Mark { slot: &mut tally, code: code });
    transition tally.total == 7 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
