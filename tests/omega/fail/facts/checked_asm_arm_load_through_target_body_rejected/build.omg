machine build(builder: &mut Build) {
    Build::select_provider<SelectedLoad, LinuxArm64Load>(builder, linux_arm64);
    Build::select_provider<SelectedLoad, LinuxArm64Load>(builder, macos_arm64);
    Build::select_provider<SelectedLoad, WindowsX8664Load>(builder, windows_x86_64);
    Build::select_provider<SelectedLoad, WindowsX8664Load>(builder, linux_x86_64);

    Build::application(builder, "checked_asm_arm_load_target_body_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
