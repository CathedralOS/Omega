// Fact: logical left shift (<<) on a bounded unsigned u64 value (25u64 << 2) establishes the exact post-shift bound (100u64), discharging exact subtraction shifted - 100u64 across all nine places.
// Invalid: operand is bounded to 24u64, so 24 << 2 is 96, underflowing subtraction by 100u64. Place: another target body.
// Expected exit: 0

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedShiftTarget {
    machine shift_target(val: u64, shift: u32) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 24 && val <= 24 && shift == 2;
}

X86ShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u64, shift: u32) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 24 && val <= 24 && shift == 2
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u64 = val << shift;
        shifted - 100u64
    }
}

ArmShiftTarget satisfies SelectedShiftTarget {
    machine shift_target(val: u64, shift: u32) -> u64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires val >= 24 && val <= 24 && shift == 2
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u64 = val << shift;
        shifted - 100u64
    }
}

machine probe() -> u64 {
    SelectedShiftTarget::shift_target(24u64, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
