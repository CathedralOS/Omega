machine minimum(left: u64, right: u64) -> u64
ensures result <= left && result <= right &&
    ((left < right && result == left) || (left >= right && result == right)) {
    transition { left < right -> left _ -> right }
}
machine prepare(output: &mut [u8; 4096]) -> bool { output[0] = 1; true }
machine trial(buffer: &mut [u8], other: &[u8], count: u64) -> u64 {
    let mut terminated: [u8; 4096];
    let fits: bool = prepare(&mut terminated);
    transition fits { true -> consume(terminated, buffer, other, count) _ -> 0 }
    machine consume(terminated: [u8; 4096], buffer: &mut [u8], other: &[u8], count: u64) -> u64 {
        let capacity: u64 = minimum(minimum(count, other.len), 2147483647);
        let prefix: &mut [u8] = &mut buffer[0..capacity];
        prefix.len
    }
}
machine main() crashes Trap {
    let mut bytes: [u8; 8];
    let other: [u8; 16];
    let first: u64 = trial(&mut bytes[..], &other[..], 13);
    let second: u64 = trial(&mut bytes[..], &other[..], 0);
    transition first == 8 && second == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
