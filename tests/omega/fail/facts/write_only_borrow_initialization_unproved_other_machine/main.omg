// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: other machine. Another machine receives and forwards the initialized slot value before exact subtraction.
// Expected diagnostic: exact subtraction underflow

domain u64::SlotDomain(v)
requires
    v >= 99u64 && v <= 100u64;

data BoxedSlot {
    value: u64 in SlotDomain;
}

machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 99u64;
}

machine evaluate_slot(forwarded: u64 in SlotDomain) -> u64 {
    forwarded - 100u64
}

machine forward_slot(slot: &BoxedSlot) -> u64 {
    evaluate_slot(slot.value)
}

machine probe() -> u64 {
    let mut slot: BoxedSlot = BoxedSlot { value: 99u64 };
    initialize_slot(&write slot);
    forward_slot(&slot)
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
