// Fact: a write-only borrow (&write) initializes a destination slot to 100u64 and restores owner readability across call completion when subtracting 100u64.
// Place: other machine (invalid twin).
// Expected diagnostic: exact subtraction underflow

data BoxedSlot {
    value: u64;
}

machine initialize_slot(destination: &write BoxedSlot) {
    destination.value = 99;
}

machine forward_verifier(val: u64) crashes Trap {
    verify_slot(val);
}

machine verify_slot(observed: u64) crashes Trap {
    transition observed == 99 {
        true -> check(observed)
        _ -> bad()
    }
    state check(v: u64) {
        let diff: u64 = v - 100;
        transition diff == 0 {
            true -> done()
            _ -> bad()
        }
    }
    state done() {}
    state bad() { crash Trap; }
}

machine main() crashes Trap {
    let mut slot: BoxedSlot = BoxedSlot { value: 0 };
    initialize_slot(&write slot);
    forward_verifier(slot.value);
}
