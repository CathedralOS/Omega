// Fact: a 16-bit unsigned u16 division of bounded inputs (dividend >= 400u16 && dividend <= 400u16, divisor >= 8u16 && divisor <= 8u16) establishes quotient >= 50u16 && quotient <= 50u16 so exact 16-bit subtraction quotient - 50u16 is proved underflow-free across all nine places.
// Invalid: named constant DIVISOR set to 10u16 so quotient is 40u16, underflowing subtraction by 50u16.
// Expected exit: 0

const DIVIDEND: u16 = 400u16;
const DIVISOR: u16 = 10u16;

machine div_const() -> u16 {
    let quotient: u16 = DIVIDEND / DIVISOR;
    quotient - 50u16
}

machine probe() -> u16 {
    div_const()
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
