// Fact: 32-bit unsigned wrapping addition lhs +% rhs with a bounded interval guard (50u32 <= sum <= 100u32) establishes 50u32 <= sum <= 100u32 across all nine places so exact subtractions 100u32 - sum and sum - 50u32 are safe.
// Expected exit: 0

machine verify_sum(value: u32) -> u32
requires value >= 50u32 && value <= 100u32
{
    let headroom: u32 = 100u32 - value;
    let margin: u32 = value - 50u32;
    transition headroom == 25u32 && margin == 25u32 {
        true -> 0u32
        _ -> 1u32
    }
}

machine exercise(lhs: u32 in Wrapping, rhs: u32 in Wrapping) -> u32 crashes Trap {
    let sum_wrap: u32 in Wrapping = lhs + rhs;
    let sum: u32 = sum_wrap as u32;
    transition sum >= 50u32 && sum <= 101u32 {
        true -> step(sum)
        _ -> bad()
    }
    state step(s: u32) -> u32 requires s >= 50u32 && s <= 101u32 {
        transition { _ -> next_step(s) }
    }
    state next_step(s: u32) -> u32 requires s >= 50u32 && s <= 101u32 {
        verify_sum(s)
    }
    state bad() { crash Trap; }
}

machine main() crashes Trap {
    let rc: u32 = exercise(60u32, 15u32);
    transition rc == 0u32 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
