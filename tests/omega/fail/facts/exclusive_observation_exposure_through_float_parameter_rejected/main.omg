// A saved observation that the kept float is 7 stays provable across a complete non-writing exclusive call on that float.
// This twin writes the saved float, invalidating its live equality with the observation.
data Ends { kept: f64; other: f64; }
machine agree(observed: f64, current: f64) -> f64
requires observed == current && observed == 7.0
{
    observed
}

machine expose(slot: &mut f64) -> f64 {
    slot = 8.0;
    slot
}

machine hold(item: &mut Ends, observed: f64) -> f64
requires observed == item.kept && observed == 7.0
{
    let held: f64 = expose(&mut item.kept);
    let agreed: f64 = agree(observed, item.kept);
    transition { _ -> finish(agreed, held) }
    machine finish(agreed: f64, held: f64) -> f64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

machine main() crashes Trap {
    let mut item: Ends = Ends { kept: 7.0, other: 1.0 };
    let saved: f64 = item.kept;
    transition hold(&mut item, saved) == 7.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
