// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
machine count(counter: &mut u64, items: &[u8], cursor: u64, stop: u64)
requires cursor <= stop && stop <= items.len
requires (stop as u8) <= 7
terminates
terminates by (cursor, stop) -> Nat::BoundedDistance
{
    transition cursor < stop {
        true -> forward(counter, items, cursor, stop)
        false -> done()
    }
    machine forward(counter: &mut u64, view: &[u8], position: u64, ceiling: u64)
    requires position < ceiling && ceiling <= view.len && ceiling <= 7
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        transition position < 3 {
            true -> count(counter, view, position + 1, ceiling)
            false -> count(counter, view, position, ceiling - 1)
        }
    }
    machine done() {}
}
machine exercise(view: &[u8])
requires view.len == 7
crashes Trap
{
    let mut counter: u64 = 3;
    count(&mut counter, view, 0, 7);
    transition counter == 10 { true -> complete(view, counter) false -> bad() }
    machine complete(view: &[u8], previous: u64)
    requires view.len == 7 && previous == 10
    {
        let mut counter: u64 = previous;
        count(&mut counter, view, 7, 7);
        transition counter == 10 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    let items: [u8; 7];
    exercise(&items[..]);
}
