// A selected checked provider closes SelectedLimit::limit() to 7; requires value <= SelectedLimit::limit() carries that bound into exact subtraction 7 - value.
// Expected: reject the named formation or fact obligation
public boundary trait Endpoint {
    machine upper() -> u64 reaches terminates;
}
public Actual satisfies Endpoint {
    machine upper() -> u64 { 7 }
}
boundary trait SelectedLimit {
    machine limit() -> u64 reaches
;
}
LinuxX8664Limit satisfies SelectedLimit {
    machine limit() -> u64
{ 6 }
}
LinuxArm64Limit satisfies SelectedLimit {
    machine limit() -> u64
{ Endpoint::upper() }
}


boundary trait SelectedDormantDemand {
    machine dormant_demand() -> u64 reaches
;
}
CheckedDormantDemand satisfies SelectedDormantDemand {
    machine dormant_demand() -> u64
{ bounded(7) }
}



machine bounded(value: u64) -> u64
requires value <= SelectedLimit::limit()
ensures result <= SelectedLimit::limit()
{ value }
public machine main() crashes Trap {
    let value: u64 = bounded(7);
    let difference: u64 = 7u64 - value;
    transition difference == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
