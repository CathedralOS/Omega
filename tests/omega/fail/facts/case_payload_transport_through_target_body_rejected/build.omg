machine build(builder: &mut Build) {
    Build::select_provider<SelectedEval, CheckedEval>(builder, linux_x86_64);
    Build::select_provider<SelectedEval, CheckedEval>(builder, linux_arm64);
    Build::select_provider<SelectedEval, CheckedEval>(builder, macos_arm64);
    Build::select_provider<SelectedEval, CheckedEval>(builder, windows_x86_64);

    Build::application(builder, "case_payload_transport_target_body_invalid");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
