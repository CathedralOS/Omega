// Fact: an 8-bit unsigned u8 logical left shift of a bounded input (val >= 25u8 && val <= 25u8) by 2u32 bits establishes shifted >= 100u8 && shifted <= 100u8 so exact 8-bit subtraction shifted - 100u8 is proved underflow-free across all nine places.
// Invalid: val lower bound weakened to 20u8 so shifted can be 80u8, underflowing subtraction by 100u8.
// Expected exit: 0

machine shift_state(val: u8, shift: u32) -> u8
requires val >= 20 && val <= 25 && shift == 2
{
    transition {
        _ -> step(val, shift)
    }
    machine step(v: u8, s: u32) -> u8
    requires v >= 20 && v <= 25 && s == 2
    {
        let shifted: u8 = v << s;
        shifted - 100u8
    }
}

machine probe() -> u8 {
    shift_state(20u8, 2)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
