// Fact: 8-bit unsigned saturating addition lhs +| rhs with bounded interval 50u8 <= sum <= 100u8 establishes 50u8 <= sum <= 100u8 across all nine places so exact subtractions 100u8 - sum and sum - 50u8 are safe.
// Place: match join. The saturating sum is synthesized across conditional match branches.
// Invalid control: lhs upper bound widened to 85u8, allowing sum up to 105u8 and failing exact headroom subtraction.
// Expected rejection: may overflow `u8`

machine add_match_join(lhs: u8, rhs: u8, choose: bool) -> i32
    requires lhs >= 40u8 && lhs <= 85u8;
    requires rhs >= 10u8 && rhs <= 20u8;
{
    let a: u8 in Saturating = lhs as u8 in Saturating;
    let b: u8 in Saturating = rhs as u8 in Saturating;
    let sum: u8 = match choose {
        true -> (a + b) as u8,
        false -> (a + b) as u8
    };
    let headroom: u8 = 100u8 - sum;
    let margin: u8 = sum - 50u8;
    transition sum == 75u8 && headroom + margin == 50u8 {
        true -> pass()
        _ -> fail()
    }
    state pass() -> i32 { 0 }
    state fail() -> i32 { 1 }
}

machine main() crashes Trap {
    let res1: i32 = add_match_join(60u8, 15u8, true);
    let res2: i32 = add_match_join(60u8, 15u8, false);
    transition res1 == 0 && res2 == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
