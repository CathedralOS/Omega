// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected exit: 0
data Counts [copy] { value: u64; climbs: u64; shrinks: u64; }
machine count(counter: &mut Counts, items: &[u8], cursor: u64, stop: u64)
requires stop < 7
requires cursor <= stop + 1 && stop + 1 <= items.len
terminates
terminates by (cursor, stop + 1) -> Nat::BoundedDistance
{
    transition cursor < stop + 1 {
        true -> forward(counter, items, cursor, stop)
        false -> done()
    }
    machine forward(counter: &mut Counts, view: &[u8], position: u64, ceiling: u64)
    requires ceiling < 7
    requires position < ceiling + 1 && ceiling + 1 <= view.len
    {
        counter.value = ((counter.value as u64 in Wrapping) + 1) as u64;
        let climb: u64 in Wrapping = match position < 3 { true -> 1 false -> 0 };
        let shrink: u64 in Wrapping = match position < 3 { true -> 0 false -> 1 };
        counter.climbs = ((counter.climbs as u64 in Wrapping) + climb) as u64;
        counter.shrinks = ((counter.shrinks as u64 in Wrapping) + shrink) as u64;
        transition position < 3 {
            true -> count(counter, view, position + 1, ceiling)
            false -> count(counter, view, position, ceiling - 0)
        }
    }
    machine done() {}
}
machine perform(counter: &mut Counts, items: &[u8], select: bool)
requires items.len == 7
{
    count(counter, items, match select { true -> 0 false -> 7 }, 6);
}
machine exercise(view: &[u8])
requires view.len == 7
crashes Trap
{
    let mut counter: Counts = Counts { value: 3, climbs: 0, shrinks: 0 };
    perform(&mut counter, view, true);
    transition counter.value == 10 && counter.climbs == 3 && counter.shrinks == 4 { true -> complete(view, counter) false -> bad() }
    machine complete(view: &[u8], previous: Counts)
    requires view.len == 7 && previous.value == 10 && previous.climbs == 3 && previous.shrinks == 4
    {
        let mut counter: Counts = previous;
        perform(&mut counter, view, false);
        transition counter.value == 10 && counter.climbs == 3 && counter.shrinks == 4 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() crashes Trap {
    let items: [u8; 7];
    exercise(&items[..]);
}
