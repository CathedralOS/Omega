machine build(builder: &mut Build) {
    Build::application(builder, "target_layout_derived_constant_field");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);

    Build::select_provider<Answer, Small>(builder, linux_x86_64);
    Build::select_provider<Answer, Large>(builder, windows_x86_64);
    Build::select_provider<Answer, Small>(builder, linux_arm64);
    Build::select_provider<Answer, Large>(builder, macos_arm64);
    Build::select_provider<ExpectedExtent, FourByteExpectation>(builder, linux_x86_64);
    Build::select_provider<ExpectedExtent, EightByteExpectation>(builder, windows_x86_64);
    Build::select_provider<ExpectedExtent, FourByteExpectation>(builder, linux_arm64);
    Build::select_provider<ExpectedExtent, EightByteExpectation>(builder, macos_arm64);
}
