data Counter { len: u64; }
machine replace(counter: &mut Counter) { counter.len = 16; }
machine equal(left: u64, right: u64) requires left == right {}
machine main() {
    let mut counter: Counter = Counter { len: 8 };
    let saved: u64 = counter.len;
    replace(&mut counter);
    // A user field named len is mutable content, not builtin view geometry.
    equal(counter.len, saved);
}
