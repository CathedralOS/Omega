// Fact: matching a 31-variant tagged enum payload ThirtyOneChoice { V1(u64), V2(u64), V3(u64), V4(u64), V5(u64), V6(u64), V7(u64), V8(u64), V9(u64), V10(u64), V11(u64), V12(u64), V13(u64), V14(u64), V15(u64), V16(u64), V17(u64), V18(u64), V19(u64), V20(u64), V21(u64), V22(u64), V23(u64), V24(u64), V25(u64), V26(u64), V27(u64), V28(u64), V29(u64), V30(u64), V31(u64) } where every arm satisfies 40u64 <= v <= 80u64 preserves 40u64 <= res <= 80u64 across all nine places so exact subtractions 80u64 - res and res - 40u64 are safe.

data ThirtyOneChoice [copy] {
    case V1(v: u64) where v >= 40u64 && v <= 80u64;
    case V2(v: u64) where v >= 40u64 && v <= 80u64;
    case V3(v: u64) where v >= 40u64 && v <= 80u64;
    case V4(v: u64) where v >= 40u64 && v <= 80u64;
    case V5(v: u64) where v >= 40u64 && v <= 80u64;
    case V6(v: u64) where v >= 40u64 && v <= 80u64;
    case V7(v: u64) where v >= 40u64 && v <= 80u64;
    case V8(v: u64) where v >= 40u64 && v <= 80u64;
    case V9(v: u64) where v >= 40u64 && v <= 80u64;
    case V10(v: u64) where v >= 40u64 && v <= 80u64;
    case V11(v: u64) where v >= 40u64 && v <= 80u64;
    case V12(v: u64) where v >= 40u64 && v <= 80u64;
    case V13(v: u64) where v >= 40u64 && v <= 80u64;
    case V14(v: u64) where v >= 40u64 && v <= 80u64;
    case V15(v: u64) where v >= 40u64 && v <= 80u64;
    case V16(v: u64) where v >= 40u64 && v <= 80u64;
    case V17(v: u64) where v >= 40u64 && v <= 80u64;
    case V18(v: u64) where v >= 40u64 && v <= 80u64;
    case V19(v: u64) where v >= 40u64 && v <= 80u64;
    case V20(v: u64) where v >= 40u64 && v <= 80u64;
    case V21(v: u64) where v >= 40u64 && v <= 80u64;
    case V22(v: u64) where v >= 40u64 && v <= 80u64;
    case V23(v: u64) where v >= 40u64 && v <= 80u64;
    case V24(v: u64) where v >= 40u64 && v <= 80u64;
    case V25(v: u64) where v >= 40u64 && v <= 80u64;
    case V26(v: u64) where v >= 40u64 && v <= 80u64;
    case V27(v: u64) where v >= 40u64 && v <= 80u64;
    case V28(v: u64) where v >= 40u64 && v <= 80u64;
    case V29(v: u64) where v >= 40u64 && v <= 80u64;
    case V30(v: u64) where v >= 40u64 && v <= 80u64;
    case V31(v: u64) where v >= 39u64 && v <= 80u64;
}

machine verify_payload(value: u64) -> u64
    requires value >= 40u64 && value <= 80u64
{
    let headroom: u64 = 80u64 - value;
    let margin: u64 = value - 40u64;
    headroom + margin
}

machine extract(choice: ThirtyOneChoice) -> u64 {
    transition choice {
        ThirtyOneChoice::V1 { v } -> v
        ThirtyOneChoice::V2 { v } -> v
        ThirtyOneChoice::V3 { v } -> v
        ThirtyOneChoice::V4 { v } -> v
        ThirtyOneChoice::V5 { v } -> v
        ThirtyOneChoice::V6 { v } -> v
        ThirtyOneChoice::V7 { v } -> v
        ThirtyOneChoice::V8 { v } -> v
        ThirtyOneChoice::V9 { v } -> v
        ThirtyOneChoice::V10 { v } -> v
        ThirtyOneChoice::V11 { v } -> v
        ThirtyOneChoice::V12 { v } -> v
        ThirtyOneChoice::V13 { v } -> v
        ThirtyOneChoice::V14 { v } -> v
        ThirtyOneChoice::V15 { v } -> v
        ThirtyOneChoice::V16 { v } -> v
        ThirtyOneChoice::V17 { v } -> v
        ThirtyOneChoice::V18 { v } -> v
        ThirtyOneChoice::V19 { v } -> v
        ThirtyOneChoice::V20 { v } -> v
        ThirtyOneChoice::V21 { v } -> v
        ThirtyOneChoice::V22 { v } -> v
        ThirtyOneChoice::V23 { v } -> v
        ThirtyOneChoice::V24 { v } -> v
        ThirtyOneChoice::V25 { v } -> v
        ThirtyOneChoice::V26 { v } -> v
        ThirtyOneChoice::V27 { v } -> v
        ThirtyOneChoice::V28 { v } -> v
        ThirtyOneChoice::V29 { v } -> v
        ThirtyOneChoice::V30 { v } -> v
        ThirtyOneChoice::V31 { v } -> v
    }
}

machine probe(choice: ThirtyOneChoice) -> u64 {
    let res: u64 = extract(choice);
    transition {
        _ -> consume(res)
    }

    machine consume(forwarded: u64) -> u64
    requires
        forwarded >= 40u64 && forwarded <= 80u64
    {
        verify_payload(forwarded)
    }
}

machine main() crashes Trap {
    let p: ThirtyOneChoice = ThirtyOneChoice::V31 { v: 60u64 };
    let combined: u64 = probe(p);
    transition combined == 40u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
