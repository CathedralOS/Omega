// Expected exit: 0.
// An atomic value operand is checked once against the cell's `u32` carrier: a `u32` operand exchanges the resident, and an operand of another carrier reports one implicit conversion.
use omega::language::core::atomic;
data Cell { value: AtomicU32; }
machine perform(cell: &Cell, wide: u64) -> u32 {
    let narrow: u32 = 7;
    let prior: u32 = cell.value.compare_exchange(wide, narrow, NoOrdering, NoOrdering);
    prior
}
machine main() crashes Trap {
    let cell: Cell;
    _ = perform(&cell, 7);
    transition { _ -> done() }
    machine done() {}
}
