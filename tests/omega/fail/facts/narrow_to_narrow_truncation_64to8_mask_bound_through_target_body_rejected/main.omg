// Fact: masking an unsigned 64-bit integer to 5 bits and narrowing through u8 ((x & 31u64) as u8 as u64) preserves the exact upper bound (truncated <= 31u64), discharging exact subtraction 31u64 - truncated across all nine places.
// Expected exit: 0

machine verify(diff: u64) crashes Trap {
    transition diff == 13u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

linux_x86_64 machine exercise(truncated: u64) requires truncated <= 32u64 crashes Trap {
    let diff: u64 = 31u64 - truncated;
    verify(diff);
}

linux_arm64 machine exercise(truncated: u64) requires truncated <= 32u64 crashes Trap {
    let diff: u64 = 31u64 - truncated;
    verify(diff);
}

macos_arm64 machine exercise(truncated: u64) requires truncated <= 32u64 crashes Trap {
    let diff: u64 = 31u64 - truncated;
    verify(diff);
}

windows_x86_64 machine exercise(truncated: u64) requires truncated <= 32u64 crashes Trap {
    let diff: u64 = 31u64 - truncated;
    verify(diff);
}

machine main() crashes Trap {
    let x: u64 = 466u64;
    exercise((x & 32u64) as u8 as u64);
}
