// A returned variant carries the exclusive loan to its original backing; writing 41 through the active payload changes only that backing.
// Place: target_body.
// Expected exit: 0
data Cell { value: i64; }
data Loan<'storage> { case Active(target: &'storage mut Cell); case Empty; }
machine lend<'storage>(source: &'storage mut Cell) -> Loan<'storage> {
    Loan::Active { target: source }
}
machine store(target: &mut Cell, value: i64) -> bool requires value == 41 {
    target.value = value;
    target.value == 41
}
machine consume<'storage>(loan: Loan<'storage>, value: i64) -> bool requires value == 41 {
    transition loan {
        Loan::Active { target } -> (store(&mut target, value))
        Loan::Empty -> false
    }
}
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedForward {
    machine forward<'storage>(loan: Loan<'storage>) -> Loan<'storage>
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Forward satisfies SelectedForward {
    machine forward<'storage>(loan: Loan<'storage>) -> Loan<'storage>
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
     loan 
    }
}

ArmForward satisfies SelectedForward {
    machine forward<'storage>(loan: Loan<'storage>) -> Loan<'storage>
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
     loan 
    }
}


machine store_code(source: &Cell) -> i64 ensures result == 41 {
    let observation: i64 = source.value;
    transition observation == 19 { true -> 41 false -> 41 }
}
machine main() crashes Trap {
    let mut backing: Cell = Cell { value: 17 };
    let sibling: Cell = Cell { value: 19 };
    let loan: Loan = SelectedForward::forward(lend(&mut backing));
    let written: bool = consume(loan, store_code(&backing));
    transition written && backing.value == 41 && sibling.value == 19 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
