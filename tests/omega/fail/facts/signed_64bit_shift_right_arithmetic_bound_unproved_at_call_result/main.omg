// Fact: a 64-bit signed i64 arithmetic right shift of a bounded input (val >= 300i64 && val <= 300i64) by 2u64 bits establishes shifted >= 75i64 && shifted <= 75i64 so exact 64-bit signed subtraction shifted - 75i64 is proved overflow-free across all nine places.
// Invalid: weakened val produces shifted == 74, failing produce_shifted ensures contract.

machine verify_shifted(shifted: i64) -> i64
    requires shifted >= 75 && shifted <= 75
{
    shifted - 75
}

machine produce_shifted(val: i64) -> i64
    requires val >= 296 && val <= 300
    ensures result >= 75 && result <= 75
{
    val >> 2u64
}

machine main() crashes Trap {
    let val: i64 = 296;
    let shifted: i64 = produce_shifted(val);
    let check: i64 = verify_shifted(shifted);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
