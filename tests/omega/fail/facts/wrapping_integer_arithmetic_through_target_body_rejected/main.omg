// Masking an unsigned scalar with a constant bitmask (val & 63u64) establishes the upper bound (masked <= 63u64), discharging exact subtraction 63u64 - masked.
// Expected rejection: exact arithmetic in machine compute state entry terminal expression may overflow `u64`.
linux_x86_64 machine compute(val: u64) -> u64 {
    let masked: u64 = val & 64u64;
    63u64 - masked
}

linux_arm64 machine compute(val: u64) -> u64 {
    let masked: u64 = val & 64u64;
    63u64 - masked
}

windows_x86_64 machine compute(val: u64) -> u64 {
    let masked: u64 = val & 64u64;
    63u64 - masked
}

macos_arm64 machine compute(val: u64) -> u64 {
    let masked: u64 = val & 64u64;
    63u64 - masked
}

machine main() crashes Trap {
    let diff: u64 = compute(100u64);
    transition diff == 27u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
