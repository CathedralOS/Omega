// Clamping or bounding an unsigned sum/value at a ceiling (`clamped >= 10u64 && clamped <= 100u64`) establishes both lower and upper interval bounds across all nine places, discharging exact subtraction `100u64 - clamped` and `clamped - 10u64` without overflow.
// Place: another state (invalid twin). The successor state bound is widened to c <= 101u64.

machine compute(val: u64) -> u64
    requires val >= 10u64 && val <= 101u64
{
    transition { _ -> perform(val) }
    machine perform(c: u64) -> u64
        requires c >= 10u64 && c <= 101u64
    {
        let headroom: u64 = 100u64 - c;
        let above_floor: u64 = c - 10u64;
        headroom + above_floor
    }
}

machine main() {
    let total: u64 = compute(60u64);
}
