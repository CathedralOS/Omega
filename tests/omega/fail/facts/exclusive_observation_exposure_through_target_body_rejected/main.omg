// A saved observation that items[0] is 7 stays provable across an exclusive loan of a different element.
// This twin exclusively borrows the observed element and does not write it, so the observation is no longer valid.
machine agree(observed: u64, current: u64) -> u64
requires observed == current && observed == 7
{
    observed
}

machine expose(slot: &mut u64) -> u64 {
    slot
}

linux_x86_64 machine observe(items: &mut [u64; 2]) -> u64
requires items[0] == 7
{
    let saved: u64 = items[0];
    let held: u64 = expose(&mut items[0]);
    let agreed: u64 = agree(saved, items[0]);
    transition { _ -> finish(agreed, held) }
    state finish(agreed: u64, held: u64) -> u64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

linux_arm64 machine observe(items: &mut [u64; 2]) -> u64
requires items[0] == 7
{
    let saved: u64 = items[0];
    let held: u64 = expose(&mut items[0]);
    let agreed: u64 = agree(saved, items[0]);
    transition { _ -> finish(agreed, held) }
    state finish(agreed: u64, held: u64) -> u64 {
        transition held == held { true -> agreed _ -> agreed }
    }
}

