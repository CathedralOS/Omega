// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Invalid: quotient is 99, so subtracting 100u64 underflows. Place: const_name.
// Expected diagnostic: may overflow `u64`

const QUOTIENT: u64 = 396u64 / 4u64;

machine probe() -> i32 {
    let quotient: u64 = QUOTIENT;
    let diff: u64 = quotient - 100u64;
    diff as i32
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
