// A match selects one of two references, the join records that reference, and the consumer reads through the recorded reference.
// Place: other_state.
// The twin selects the other reference.

machine choose() -> bool
ensures result == true
{
    true
}

machine read_through(place: &i64) -> i64
requires place == 17
{
    place
}

machine main() crashes Trap {
    let chosen: i64 = 17;
    let spare: i64 = 5;
    transition { _ -> pick(&chosen, &spare) }

    state pick(chosen: &i64, spare: &i64) {
        let joined: &i64 = match choose() {
            true -> spare
            false -> chosen
        };
        let observed: i64 = read_through(joined);
        transition observed == 17 {
            true -> done()
            false -> wrong()
        }
    }

    state done() {}
    state wrong() { crash Trap; }
}
