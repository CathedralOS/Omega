// Expected exit: 0
// Selected<Base + 4> at Base = 3 supplies at least seven before exact value - 7.
data Adjustment [copy] { before: u64; amount: u64; after: u64; }
machine zero() -> Adjustment { Adjustment { before: 13, amount: 0, after: 17 } }
const OFFSET: Adjustment = zero();
public trait Reading<const Minimum: u64> {
    machine read() -> u64 ensures result >= Minimum;
}
public Selected<const Value: u64> satisfies Reading<Value> {
    machine read() -> u64 ensures result == Value { Value + OFFSET.amount }
}
public machine selected<const Minimum: u64, Implementation satisfies Reading<Minimum>>() -> u64
ensures result >= Minimum
{ Implementation::read() }
public machine construct<const Base: u64>() -> u64
requires Base <= 100
ensures result >= Base + 4
{ selected<Base + 4, Selected<Base + 3>>() }
