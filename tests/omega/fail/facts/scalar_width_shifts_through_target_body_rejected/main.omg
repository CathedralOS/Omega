// A bounded shift count shift < 4 on a Wrapping u32 value preserves in-width shift validity and recovers the original scalar across all nine places.
// Place: another target body (invalid twin). Target bodies shifting plain u32 without in Wrapping may overflow.
boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedShiftRoundTrip {
    machine shift_round_trip(val: u32, shift: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires shift < 4;
}

X86ShiftRoundTrip satisfies SelectedShiftRoundTrip {
    machine shift_round_trip(val: u32, shift: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires shift < 4
    {
        SelectedBodyCheck::require_tag(17u64);
        let shifted: u32 = val << shift;
        shifted >> shift
    }
}

ArmShiftRoundTrip satisfies SelectedShiftRoundTrip {
    machine shift_round_trip(val: u32, shift: u32) -> u32
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap requires shift < 4
    {
        SelectedBodyCheck::require_tag(29u64);
        let shifted: u32 = val << shift;
        shifted >> shift
    }
}


machine probe(val: u32, shift: u32) -> u32
    requires shift < 4
{
    SelectedShiftRoundTrip::shift_round_trip(val, shift)
}

machine main() crashes Trap {
    let val: u32 = 21;
    let shift: u32 = 1;
    let recovered: u32 = probe(val, shift);
    let shifted: u32 = val << shift;
    transition shifted == 42 && recovered == 21 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
