// The standing field fact copied into a local still discharges
// `arr[index + 1]`. `read` does not see the literal store of `k`.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

data Main where 0 <= k, k <= 4 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine read(main: &Main) -> i32 in Wrapping {
    let index: u64 = main.k;
    main.arr[index + 1]
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = read(main);
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = read(main);
        main.hits = main.r;
    }
}
