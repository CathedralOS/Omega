// Fact: querying size_of and align_of on a two-field u64 structural record (Pair { lo: u64, hi: u64 }) establishes its exact layout geometry (size == 16u64 and align == 8u64), discharging exact subtraction size - (align * 2u64) across all nine places.
// Invalid: Pair has a single field lo: u64 (size == 8u64, align == 8u64), so target-scoped compute_geometry() underflows u64.
// Expected exit: 0

data Pair {
    lo: u64;
}

boundary trait Geometry {
    machine compute() -> u64 reaches terminates;
}
ArmGeometry satisfies Geometry {
    machine compute() -> u64 { size_of<Pair>() - (align_of<Pair>() * 2u64) }
}
OtherGeometry satisfies Geometry {
    machine compute() -> u64 { size_of<Pair>() - (align_of<Pair>() * 2u64) }
}

machine probe() -> u64 {
    Geometry::compute()
}

machine main() crashes Trap {
    let diff: u64 = probe();
    transition diff == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
