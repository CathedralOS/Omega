// A private helper preserves the invocation rank on a tail edge, and every complete cycle strictly descends while advancing the explicit counter once.
// Expected rejection: cannot form specification payload projection
data Payload { case Pending(count: u64); case Empty; }
data Remaining { canary: u64; inner: Payload; }
machine count(counter: &mut u64, remaining: Remaining) crashes Trap
terminates;
terminates by remaining.inner.count;
requires remaining.inner.count <= 7;
{
    transition remaining.inner.count > 0 {
        true -> forward(remaining, counter)
        false -> finish(remaining.canary)
    }
    machine forward(pending: Remaining, counter: &mut u64) crashes Trap
    requires pending.inner in Payload::Pending, pending.inner.count > 0 && pending.inner.count <= 7;
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        let next: Remaining = Remaining { canary: pending.canary, inner: Payload::Pending { count: pending.inner.count - 1 } };
        transition { _ -> count(counter, next) }
    }
    machine finish(canary: u64) crashes Trap {
        transition canary == 641 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine perform(counter: &mut u64, select: bool) crashes Trap {
    let remaining: Remaining = match select {
        true -> Remaining { canary: 641, inner: Payload::Pending { count: 7 } }
        false -> Remaining { canary: 641, inner: Payload::Pending { count: 0 } }
    };
    count(counter, remaining);
}
machine main() crashes Trap {
    let mut counted: u64 = 3;
    perform(&mut counted, true);
    let matched: bool = counted == 10;
    perform(&mut counted, false);
    transition matched && counted == 10 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
