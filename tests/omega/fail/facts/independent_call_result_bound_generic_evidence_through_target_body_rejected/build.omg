machine build(builder: &mut Build) {
    Build::application(builder, "independent_call_result_bound_generic_evidence_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::select_provider<Evaluation, WindowsEvaluation>(builder, windows_x86_64);
    Build::select_provider<Evaluation, LinuxEvaluation>(builder, linux_x86_64);
    Build::select_provider<Evaluation, MacosEvaluation>(builder, macos_arm64);
    Build::select_provider<Evaluation, LinuxArmEvaluation>(builder, linux_arm64);
}
