// Fact: 32-bit unsigned bitwise OR base | 32u32 with bounded interval 40u32 <= combined <= 63u32 establishes 40u32 <= combined <= 63u32 across all nine places so exact subtractions 63u32 - combined and combined - 40u32 are safe.
// Place: call_result. The bitwise OR result is returned from a callee invocation.
// Expected exit: 0
machine verify_combined(res: u32) -> u32
    requires res >= 40 && res <= 63
{
    let head: u32 = 63 - res;
    let tail: u32 = res - 40;
    head + tail
}

machine or_helper(v: u32) -> u32
    requires v >= 64 && v <= 64
    ensures result >= 96 && result <= 96
{
    v | 32
}

machine compute_call_result(base: u32) -> u32
    requires base >= 64 && base <= 64
{
    let combined: u32 = or_helper(base);
    verify_combined(combined)
}

machine evaluate() -> u32 {
    compute_call_result(64)
}

machine main() crashes Trap {
    let res: u32 = evaluate();
    transition res == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
