// A local copy of an unproved index does not invent a bound.
machine read_local(index: u64) -> u8 {
    let values: [u8; 3] = [7, 8, 9];
    let chosen: u64 = index;
    values[chosen]
}
machine main() crashes Trap {
    transition read_local(1) == 8 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
