// Fact: an unsigned u64 quotient from 400u64 divided by 4u64 equals 100u64 when subtracting 100u64.
// Invalid: quotient is 99, so subtracting 100u64 underflows. Place: parameter.
// Expected diagnostic: may overflow `u64`

machine verify_parameter(quotient: u64) -> i32
requires quotient >= 99 && quotient <= 99
{
    let diff: u64 = quotient - 100u64;
    diff as i32
}

machine probe() -> i32 {
    let q: u64 = 396u64 / 4u64;
    verify_parameter(q)
}

machine main() crashes Trap {
    transition probe() == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
