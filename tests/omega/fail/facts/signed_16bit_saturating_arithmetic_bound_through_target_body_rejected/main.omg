// Fact: 16-bit signed saturating addition lhs +| rhs with bounded interval 350i16 <= sum <= 600i16 establishes 350i16 <= sum <= 600i16 across all nine places so exact subtractions 600i16 - sum and sum - 350i16 are safe.
// Expected exit: 0

machine verify_sum(value: i16) -> i32
requires value >= 350i16 && value <= 600i16
{
    let sub_hi: i16 = 600i16 - value;
    let sub_lo: i16 = value - 350i16;
    let diff: i16 = (sub_hi + sub_lo) - 250i16;
    transition diff == 0i16 {
        true -> 0i32
        _ -> 1i32
    }
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(lhs: i16 in Saturating, rhs: i16 in Saturating) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap;
}

X86Probe satisfies SelectedProbe {
    machine exercise(lhs: i16 in Saturating, rhs: i16 in Saturating) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        let sum_sat: i16 in Saturating = lhs + rhs;
        let sum: i16 = sum_sat as i16;
        transition sum >= 350i16 && sum <= 601i16 {
            true -> step(sum)
            _ -> bad()
        }
        machine step(s: i16) -> i32 {
            verify_sum(s)
        }
        machine bad() -> i32 { crash Trap; }
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(lhs: i16 in Saturating, rhs: i16 in Saturating) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck
        crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        let sum_sat: i16 in Saturating = lhs + rhs;
        let sum: i16 = sum_sat as i16;
        transition sum >= 350i16 && sum <= 601i16 {
            true -> step(sum)
            _ -> bad()
        }
        machine step(s: i16) -> i32 {
            verify_sum(s)
        }
        machine bad() -> i32 { crash Trap; }
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let rc: i32 = SelectedProbe::exercise(400i16, 80i16);
    transition rc == 0i32 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
