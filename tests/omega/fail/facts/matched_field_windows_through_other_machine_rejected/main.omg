// A match arm treats its integer pattern as the subject's value, so in the arm
// `which == 0` the window `items[0..which + 2]` has length 2, the same length
// as the other arm, and the returned window publishes length 2.
// Invalid control: the other arm hands `open_end` the coordinate 3 while that machine
// requires its `end` to be 2, so the handed coordinate is structurally false.
machine open_end<'row>(items: &'row mut [u8; 4], end: i64) -> &'row mut [u8]
    requires end == 2
    ensures result.len == 2
{
    &mut items[0..end]
}

machine from_machine<'row>(items: &'row mut [u8; 4], which: i64) -> &'row mut [u8]
    ensures result.len == 2
{
    match which {
        0 -> open_end(items, which + 2)
        _ -> open_end(items, 3)
    }
}
machine main() crashes Trap {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let window: &mut [u8] = from_machine(&mut bytes, 0);
    transition window.len == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
