machine build(builder: &mut Build) {
    Build::application(builder, "checked_asm_arm_load_other_state_invalid");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<SelectedMain, X86Main>(builder, linux_x86_64);
    Build::select_provider<SelectedMain, ArmMain>(builder, linux_arm64);
    Build::select_provider<SelectedMain, ArmMain>(builder, macos_arm64);
    Build::select_provider<SelectedMain, X86Main>(builder, windows_x86_64);
}
