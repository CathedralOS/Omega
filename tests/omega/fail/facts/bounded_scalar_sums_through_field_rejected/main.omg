// Bounded u64 operands a <= 50 and b <= 50 make the exact sum
// a + b fit result <= 100; no Wrapping domain and no as.
// Place: field (invalid twin). Plain u64 record fields do not prove an exact sum.
data Pair {
    left: u64;
    right: u64;
}

machine add(pair: Pair) -> u64 {
    pair.left + pair.right
}

machine main() crashes Trap {
    let sample: Pair = Pair { left: 30, right: 40 };
    let upper: Pair = Pair { left: 50, right: 50 };
    transition add(sample) == 70 && add(upper) == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
