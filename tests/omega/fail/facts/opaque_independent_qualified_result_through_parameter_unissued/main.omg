// Expected exit: 0
// Existing routed membership on an owned opaque result from a checked independent provider survives transport into the next qualified consuming call, preserving libc hosts 66051 and 513 and replacement 1027.
use producer::main;
public data AddressBox { value: InternetAddress in Classified; }
public data AddressPair { first: InternetAddress in Classified; second: InternetAddress; }

machine consume(first: InternetAddress in Classified, second: InternetAddress) -> bool reaches AddressParts, AddressBridge {
    let mut pair: AddressPair = AddressPair { first: first, second: second };
    let old_host: u32 = AddressBridge::classified_host(pair.first);
    pair.first = classify(AddressBridge::make(10, 1027));
    let sibling_host: u32 = AddressBridge::host(pair.second);
    let replacement_host: u32 = AddressBridge::host(pair.first as InternetAddress);
    old_host == 66051 && sibling_host == 513 && replacement_host == 1027
}
machine receive(first: InternetAddress in Classified) -> bool reaches AddressParts, AddressBridge { consume(first, AddressBridge::make(44048, 513)) }
machine observe() -> bool reaches AddressParts, AddressBridge { receive(AddressBridge::classified_make(10, 66051)) }

machine main() reaches AddressParts, AddressBridge crashes Trap {
 transition observe() { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
