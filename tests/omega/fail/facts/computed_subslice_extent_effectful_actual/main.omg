use omega::language::core::slice;
data Cursor { low: u64; }
machine bump(cursor: &mut Cursor) -> u64 { cursor.low = 3; 0 }
machine can_window(items: &[u8], low: u64, marker: u64) -> bool {
    items.len == 4 && low <= 2 && marker == 0
}
machine read(items: &[u8], cursor: &mut Cursor) -> u8 {
    let allowed: bool = can_window(items, cursor.low, bump(cursor));
    match allowed {
        true -> items[cursor.low + 0u64..cursor.low + 2u64][1]
        _ -> 0u8
    }
}
machine main() crashes Trap {
    let items: [u8; 4] = [11u8, 23u8, 37u8, 53u8];
    let mut cursor: Cursor = Cursor { low: 1 };
    transition read(&items, &mut cursor) == 37u8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
