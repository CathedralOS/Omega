machine build(builder: &mut Build) {
    Build::select_provider<SelectedConsume, CheckedConsume>(builder, windows_x86_64);
    Build::select_provider<SelectedConsume, CheckedConsume>(builder, linux_x86_64);
    Build::select_provider<SelectedConsume, CheckedConsume>(builder, macos_arm64);
    Build::select_provider<SelectedConsume, CheckedConsume>(builder, linux_arm64);

    Build::application(builder, "domain_selected_cleanup_through_target_body_rejected");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
