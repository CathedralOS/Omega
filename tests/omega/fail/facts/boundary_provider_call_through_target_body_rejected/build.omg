machine build(builder: &mut Build) {
    Build::select_provider<SelectedCompute, CheckedCompute>(builder, linux_x86_64);
    Build::select_provider<SelectedCompute, CheckedCompute>(builder, linux_arm64);
    Build::select_provider<SelectedCompute, CheckedCompute>(builder, windows_x86_64);
    Build::select_provider<SelectedCompute, CheckedCompute>(builder, macos_arm64);

    Build::application(builder, "boundary_provider_call_through_target_body_rejected");
    Build::select_provider<Provider, Actual>(builder, linux_arm64);
    Build::select_provider<Provider, Actual>(builder, linux_x86_64);
    Build::select_provider<Provider, Actual>(builder, macos_arm64);
    Build::select_provider<Provider, Actual>(builder, macos_x86_64);
    Build::select_provider<Provider, Actual>(builder, windows_x86_64);
    Build::select_provider<Provider, Actual>(builder, uefi_x86_64);
    Build::select_provider<Provider, Actual>(builder, cross_platform_cli);
    Build::select_provider<Provider, Actual>(builder, local_unchecked);
    Build::select_provider<Provider, Actual>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
