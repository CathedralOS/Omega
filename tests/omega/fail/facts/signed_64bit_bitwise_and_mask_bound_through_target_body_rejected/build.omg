machine build(builder: &mut Build) {
    Build::select_provider<SelectedBitwiseAndTarget, CheckedBitwiseAndTarget>(builder, linux_x86_64);
    Build::select_provider<SelectedBitwiseAndTarget, CheckedBitwiseAndTarget>(builder, linux_arm64);
    Build::select_provider<SelectedBitwiseAndTarget, CheckedBitwiseAndTarget>(builder, macos_arm64);
    Build::select_provider<SelectedBitwiseAndTarget, CheckedBitwiseAndTarget>(builder, windows_x86_64);

    Build::application(builder, "signed_64bit_bitwise_and_mask_bound");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
