// A match selects a primitive local, the join records that local as the origin, and the consumer reads the recorded value.
// Place: target_body.
// The twin selects the other local.

machine choose() -> bool
ensures result == true
{
    true
}

machine read_origin(value: i64) -> i64
requires value == 17
{
    value
}

linux_x86_64 machine apply(chosen: i64, spare: i64) -> i64 {
    let joined: i64 = match choose() {
        true -> spare
        false -> chosen
    };
    read_origin(joined)
}

linux_arm64 machine apply(chosen: i64, spare: i64) -> i64 {
    let joined: i64 = match choose() {
        true -> spare
        false -> chosen
    };
    read_origin(joined)
}

macos_arm64 machine apply(chosen: i64, spare: i64) -> i64 {
    let joined: i64 = match choose() {
        true -> spare
        false -> chosen
    };
    read_origin(joined)
}

windows_x86_64 machine apply(chosen: i64, spare: i64) -> i64 {
    let joined: i64 = match choose() {
        true -> spare
        false -> chosen
    };
    read_origin(joined)
}

machine main() crashes Trap {
    let observed: i64 = apply(17, 5);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
