// A call result that returns the standing field still discharges
// `arr[current(main) + 1]`. `current` ensures the where bound, and
// `use` indexes the result with no guard.
//
// Reject control: k <= 4 allows index + 1 == 5 out of bounds for length 5.

data Main where 0 <= k, k <= 4 {
    arr: [i32 in Wrapping; 5];
    k: u64;
    r: i32 in Wrapping;
    hits: i32 in Wrapping;
}

machine current(main: &Main) -> u64
ensures 0 <= result && result <= 4
{
    main.k
}

machine use(main: &Main) -> i32 in Wrapping {
    main.arr[current(main) + 1]
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    main.r = use(main);
    transition { _ -> successor(main) }
    machine successor(main: &mut Main) {
        main.r = use(main);
        main.hits = main.r;
    }
}
