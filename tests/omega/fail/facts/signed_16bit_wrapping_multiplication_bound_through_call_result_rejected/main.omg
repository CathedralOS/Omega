// Fact: 16-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i16 <= prod <= 200i16 establishes 50i16 <= prod <= 200i16 across all nine places so exact subtractions 200i16 - prod and prod - 50i16 are safe.
// Invalid: widened inputs produce product of 220i16, failing produce_prod ensures contract.

machine verify_prod(prod: i16) -> i32
    requires prod >= 50 && prod <= 200
{
    let headroom: i16 = 200 - prod;
    let margin: i16 = prod - 50;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 150;
    check
}

machine produce_prod(lhs: i16 in Wrapping, rhs: i16 in Wrapping) -> i16
    requires lhs as i16 >= 10 && lhs as i16 <= 22, rhs as i16 >= 5 && rhs as i16 <= 10
    ensures result >= 50 && result <= 200
{
    let wrapped: i16 in Wrapping = lhs * rhs;
    wrapped as i16
}

machine main() crashes Trap {
    let lhs: i16 in Wrapping = 22;
    let rhs: i16 in Wrapping = 10;
    let prod: i16 = produce_prod(lhs, rhs);
    let check: i32 = verify_prod(prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
