machine build(builder: &mut Build) {
    Build::select_provider<SelectedRun, CheckedRun>(builder, linux_x86_64);
    Build::select_provider<SelectedRun, CheckedRun>(builder, linux_arm64);
    Build::select_provider<SelectedRun, CheckedRun>(builder, macos_arm64);
    Build::select_provider<SelectedRun, CheckedRun>(builder, windows_x86_64);

    Build::application(builder, "callee_saved_across_nested_calls_unproved_target_body");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
