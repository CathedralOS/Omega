machine build(builder: &mut Build) {
    Build::application(builder, "buffered_representation_agreement_target_body");
    Build::select_provider<AnswerDelivery, SecondDelivery>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main_other);
    Build::select_provider<AnswerDelivery, SecondDelivery>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main_other);
    Build::select_provider<AnswerDelivery, FirstDelivery>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main_arm);
    Build::select_provider<AnswerDelivery, SecondDelivery>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main_other);
}
