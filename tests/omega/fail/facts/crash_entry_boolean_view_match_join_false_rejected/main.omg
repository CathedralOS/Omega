// Control: an entry byte proved equal to 0 makes maybe_clear's false Trap route live.
machine maybe_clear(value: bool) -> bool
crashes Trap value == false
{
    transition value == false { true -> bad() false -> (value) }
    machine bad() -> bool { crash Trap; }
}
public data Byte where value >= 0 && value <= 1 { value: u8; }
public machine read_flag(byte: &Byte, flag: bool) -> bool
requires byte.value == 0
{
    let view: &bool = &byte.value as &bool;
    let viewed: bool = view;
    let observed: bool = match flag { true -> viewed, false -> viewed };
    maybe_clear(observed)
}
machine main() crashes Trap {
    let byte: Byte = Byte { value: 0 };
    let first: bool = read_flag(&byte, true);
    let second: bool = read_flag(&byte, false);
    transition first == true && second == true { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
