// Fact: 16-bit signed wrapping multiplication lhs *% rhs with bounded interval 50i16 <= prod <= 200i16 establishes 50i16 <= prod <= 200i16 across all nine places so exact subtractions 200i16 - prod and prod - 50i16 are safe.
// Invalid: widened lhs produces product of 220i16 across target body, failing exercise requires contract.

machine compute_wrap(lhs: i16 in Wrapping, rhs: i16 in Wrapping) -> i16 in Wrapping {
    lhs * rhs
}

machine verify_prod(prod: i16) -> i32
    requires prod >= 50 && prod <= 200
{
    let headroom: i16 = 200 - prod;
    let margin: i16 = prod - 50;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 150;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 50 && val <= 200;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 50 && val <= 200
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_prod(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i16) -> i32
        reaches SelectedBodyCheck crashes Trap
        requires val >= 50 && val <= 200
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_prod(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: i16 in Wrapping = 22;
    let rhs: i16 in Wrapping = 10;
    let prod_wrapped: i16 in Wrapping = compute_wrap(lhs, rhs);
    let prod: i16 = prod_wrapped as i16;
    let check: i32 = SelectedProbe::exercise(prod);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
