// Fact: 8-bit signed saturating addition lhs +| rhs with bounded interval 50i8 <= sum <= 100i8 establishes 50i8 <= sum <= 100i8 across all nine places so exact subtractions 100i8 - sum and sum - 50i8 are safe.
// Invalid: widened inputs produce sum of 105i8, failing exercise requires contract.

machine compute_sat(lhs: i8 in Saturating, rhs: i8 in Saturating) -> i8 in Saturating {
    lhs + rhs
}

machine verify_sum(sum: i8) -> i32
    requires sum >= 50 && sum <= 100
{
    let headroom: i8 = 100 - sum;
    let margin: i8 = sum - 50;
    let total: i8 = headroom + margin;
    let check: i32 = (total as i32) - 50;
    check
}

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 50 && val <= 100;
}

X86Probe satisfies SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 50 && val <= 100
    {
        SelectedBodyCheck::require_tag(17u64);
        verify_sum(val)
    }
}

ArmProbe satisfies SelectedProbe {
    machine exercise(val: i8) -> i32
        reaches SelectedBodyCheck invokes SelectedBodyCheck; crashes Trap
        requires val >= 50 && val <= 100
    {
        SelectedBodyCheck::require_tag(29u64);
        verify_sum(val)
    }
}









machine main()
    reaches SelectedProbe, SelectedBodyCheck
    crashes Trap
{
    let lhs: i8 in Saturating = 85;
    let rhs: i8 in Saturating = 20;
    let sum_sat: i8 in Saturating = compute_sat(lhs, rhs);
    let sum: i8 = sum_sat as i8;
    let check: i32 = SelectedProbe::exercise(sum);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}
machine arm_entry() reaches SelectedProbe, SelectedBodyCheck crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
