// Fact: 16-bit signed bitwise XOR raw ^ 15i16 with bounded interval 40i16 <= xored <= 63i16 establishes 40i16 <= xored <= 63i16 across all nine places so exact subtractions 63i16 - xored and xored - 40i16 are safe.
// Invalid: widened XOR operand 127 produces xored == 68 > 63, failing exercise requires contract.

machine compute_xor(raw: i16) -> i16
    requires raw >= 59 && raw <= 59
{
    raw ^ 127i16
}

machine verify_xored(xored: i16) -> i32
    requires xored >= 40 && xored <= 63
{
    let headroom: i16 = 63 - xored;
    let margin: i16 = xored - 40;
    let total: i16 = headroom + margin;
    let check: i32 = (total as i32) - 23;
    check
}

linux_x86_64 machine exercise(val: i16) -> i32
    requires val >= 40 && val <= 63
{
    verify_xored(val)
}

windows_x86_64 machine exercise(val: i16) -> i32
    requires val >= 40 && val <= 63
{
    verify_xored(val)
}

linux_arm64 machine exercise(val: i16) -> i32
    requires val >= 40 && val <= 63
{
    verify_xored(val)
}

macos_arm64 machine exercise(val: i16) -> i32
    requires val >= 40 && val <= 63
{
    verify_xored(val)
}

machine main() crashes Trap {
    let raw: i16 = 59;
    let xored: i16 = compute_xor(raw);
    let check: i32 = exercise(xored);
    transition check == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
