// Invalid: the actual 7.25 does not satisfy the requirement's own
// `requires value == 7.0`, so the call is refused.
boundary trait Observe {
    machine observe(value: f64) -> f64 reaches requires value == 7.0;
}
Code satisfies Observe {
    machine observe(value: f64) -> f64 requires value == 7.0 { value + 0.5 }
}
machine main() crashes Trap {
    transition Observe::observe(7.25) == 7.5 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
