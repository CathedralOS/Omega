machine build(builder: &mut Build) {
    Build::application(builder, "named_foreign_provider_wrong_table");
    Build::select_provider<Probe, ProbeProvider>(builder, linux_arm64);
    Build::select_provider<Probe, ProbeProvider>(builder, linux_x86_64);
    Build::select_provider<Probe, ProbeProvider>(builder, macos_arm64);
    Build::select_provider<Probe, ProbeProvider>(builder, macos_x86_64);
    Build::select_provider<Probe, ProbeProvider>(builder, windows_x86_64);
    Build::select_provider<Probe, ProbeProvider>(builder, uefi_x86_64);
    Build::select_provider<Probe, ProbeProvider>(builder, cross_platform_cli);
    Build::select_provider<Probe, ProbeProvider>(builder, local_unchecked);
    Build::select_provider<Probe, ProbeProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);

 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, windows_x86_64);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, linux_x86_64);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, macos_arm64);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, linux_arm64);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, macos_x86_64);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, uefi_x86_64);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, cross_platform_cli);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, local_unchecked);
 Build::bind_table_function<RawNativeProbe::read, ActualTable::call>(builder, alpha_bootstrap);
}
