// Naming a provider independently does not let another record supply the
// table field: it resolves only in the record the leaf borrows.
data ActualTable { call: addr; }
data BorrowedTable { other: addr; }
boundary trait Probe { machine read(table: &BorrowedTable) -> u64 reaches; }
machine borrowed_read(table: &BorrowedTable) -> u64
    satisfies Probe::read via ForeignBinding::TableFunction(call);
ProbeProvider satisfies Probe { machine read(table: &BorrowedTable) -> u64 { borrowed_read(table) } }
machine main() {}
