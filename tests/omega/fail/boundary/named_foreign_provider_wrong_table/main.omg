// Naming a provider independently does not relax exact table-borrow identity.
data ActualTable { call: addr; }
data SameShapeTable { call: addr; }
boundary trait Probe { machine read(table: &SameShapeTable) -> u64 reaches; }

ProbeProvider satisfies Probe { machine read(table: &SameShapeTable) -> u64 reaches { RawNativeProbe::read(table) } }
machine main() {}

boundary trait RawNativeProbe {
    machine read(table: &SameShapeTable) -> u64 reaches;
}
