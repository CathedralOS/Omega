// A boundary requirement's case precondition still binds its callers: lowering
// the requirement's own `requires chosen in Slot::Present` grants the caller no
// fact.
// Invalid: the caller passes the payload-free case, so the requirement
// precondition is unproved.
data Slot { case Absent; case Present(value: i64); }
boundary trait Fill {
    machine fill(chosen: &mut Slot) -> i64 reaches requires chosen in Slot::Present;
}
Filler satisfies Fill {
    machine fill(chosen: &mut Slot) -> i64 requires chosen in Slot::Present {
        chosen.value = 41;
        5
    }
}
machine main() crashes Trap {
    let mut chosen: Slot = Slot::Absent;
    let neighbor: i64 = 19;
    let returned: i64 = Fill::fill(&mut chosen);
    transition chosen {
        Slot::Present { value } -> check(returned, value, neighbor)
        _ -> wrong()
    }
    machine check(returned: i64, value: i64, neighbor: i64) crashes Trap {
        transition returned == 5 && value == 41 && neighbor == 19 { true -> done() false -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
