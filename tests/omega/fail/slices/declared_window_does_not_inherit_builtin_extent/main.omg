// A selected range machine may return storage unrelated to its endpoint.
data Channels { source: [u8; 4]; other: [u8; 1]; }
data Main { channels: Channels; }

machine [..] Channels::window(channels: &Channels, start: u64, end: u64) -> &[u8]
requires start == 0, end == 4
{
    &channels.other[..]
}

machine require_all(bytes: &[u8]) requires bytes.len == 4 {}

machine Main::main(main: &mut Main) {
    let selected: &[u8] = main.channels[0..main.channels.source.len];
    require_all(selected);
}
