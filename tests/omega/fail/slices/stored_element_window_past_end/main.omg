// Index 2 is outside a window whose length is 2.
data Cell [copy] { real: i32; imaginary: i32; }
data Held<'row> { cells: &'row mut [Cell]; }

machine half<'row>(row: &'row mut [Cell; 4], which: i64) -> &'row mut [Cell]
ensures result.len == 2
{
    match which {
        0 -> &mut row[0..2]
        _ -> &mut row[2..4]
    }
}

machine main() {
    let mut row: [Cell; 4] = [
        Cell { real: 1, imaginary: 5 },
        Cell { real: -1, imaginary: 2 },
        Cell { real: 3, imaginary: -2 },
        Cell { real: 4, imaginary: 8 }
    ];
    let view: &mut [Cell] = half(&mut row, 0);
    let mut held: Held = Held { cells: view };
    transition held.cells.len == 2 {
        true -> observe(&mut held)
        false -> done()
    }
    state observe(held: &mut Held) requires held.cells.len == 2 {
        let _past: Cell = held.cells[2];
    }
    state done() {}
}
