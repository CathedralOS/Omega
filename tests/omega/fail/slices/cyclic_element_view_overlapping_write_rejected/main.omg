// A mutable element view forwarded through a cycle still writes the selected caller element and leaves its neighbor unchanged.
// This twin writes through a second window of the same caller storage. The two loans overlap.
machine write(items: &mut [i32])
requires items.len > 1
{
    transition { _ -> carry(items, &mut items[0..2], 0) }
    machine carry(items: &mut [i32], overlap: &mut [i32], seen: u64)
    requires items.len > 1 && overlap.len > 0
    {
        transition seen == 0 {
            true -> carry(items, overlap, 1)
            false -> store(overlap)
        }
    }
    machine store(overlap: &mut [i32])
    requires overlap.len > 0
    {
        overlap[0] = 23;
    }
}
machine main() crashes Trap {
    let mut items: [i32; 2];
    let view: &mut [i32] = &mut items[..];
    write(view);
    transition items[0] == 23 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
