data Cell [copy] { value: u32; }
data Window<'input> { values: &'input mut [Cell]; }

machine select<'input>(windows: &'input mut [Window<'input>]) -> &'input mut [Cell]
requires windows.len == 1 {
    &mut windows[0].values[..]
}

machine escape<'input>(input: &'input mut [Cell]) -> &'input mut [Cell] {
    let mut local: [Cell; 1] = [Cell { value: 7 }];
    let mut windows: [Window; 1] = [Window { values: &mut local[..] }];
    select(&mut windows[..])
}

machine main() {}
