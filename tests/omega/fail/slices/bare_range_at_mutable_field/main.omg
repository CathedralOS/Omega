// A constructed `&mut [T]` field is another author's declaration: a bare
// range `items[1..3]` there is still the shared view
// `bare-range-reference-access` forms, and `&mut items[1..3]` is the
// mutable spelling.
data Window { cells: &mut [i32]; }
machine write(items: &mut [i32])
requires items.len > 3
{
    let window: Window = Window { cells: items[1..3] };
    window.cells[0] = 23;
}
machine main() {}
