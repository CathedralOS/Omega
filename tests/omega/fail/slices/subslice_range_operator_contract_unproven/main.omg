// Importing slice helpers leaves builtin bounds in force.

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine inspect(main: &mut Main) -> u64 {
    // The invalid tail still owes both ordered builtin range bounds.
    let view: &[Entry] = &main.entries;
    let tail: &[Entry] = view[9..4];
    tail.len
}
