data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self) -> u64 {
    transition {
        _ -> 0
    }

    state choose(&mut self, entries: &[Entry], end: u64) -> u64 {
        transition {
            _ -> length(entries[..end])
        }
    }

    state length(&mut self, entries: &[Entry]) -> u64 {
        transition {
            _ -> entries.len
        }
    }
}
