domain i32::Positive(value) requires 0<value && value<=100;
machine copy(items:&[i32 in Positive]) -> i32 in Positive requires items.len>2 {items[2]}
machine main() crashes Trap {
 let mut items:[i32 in Positive;3]; items[0]=11; items[1]=39;
 let view:&[i32 in Positive]=&items[..]; let chosen:i32 in Positive=copy(view);
 transition chosen>0 {true ->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
