// Intended invalid: separate call results guarantee only nonempty windows.
// The first result has length 1; the second has length 3. Their equal field
// names cannot prove equal lengths at an ordinary call.
data Held<'row> { values: &'row [u8]; }

machine span<'row>(items: &'row [u8; 4], which: i64) -> Held<'row>
ensures result.values.len >= 1
{
    match which {
        0 -> Held { values: &items[0..1] }
        _ -> Held { values: &items[1..4] }
    }
}

machine demand_same(left: &[u8], right: &[u8])
requires left.len == right.len
{}

machine main() {
    let first: [u8; 4] = [1, 2, 3, 4];
    let second: [u8; 4] = [5, 6, 7, 8];
    let short: Held = span(&first, 0);
    let long: Held = span(&second, 1);
    demand_same(short.values, long.values);
}
