data Cursor { offset: u64; bytes: [u8; 64]; }
machine read(cursor: &mut Cursor) -> u8 {
    transition cursor.offset < cursor.bytes.len {
        true -> replace(cursor)
        false -> (0)
    }
    machine replace(cursor: &mut Cursor) -> u8 {
        cursor.offset = cursor.offset + 1;
        cursor.bytes[cursor.offset]
    }
}
