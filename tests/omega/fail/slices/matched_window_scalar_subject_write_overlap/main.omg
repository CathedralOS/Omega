data Coordinate where value <= 2 { value: u64; }
machine reset(value: &mut u64) -> u64
requires value <= 2
ensures value <= 2
ensures value == 1
ensures result == 0 { value = 1; 0 }
machine keep<'a>(ignored: u64, values: &'a mut [u8]) -> &'a mut [u8] { values }
machine collide(first: &mut [u8], second: &mut u8) {}
machine main() {
    let mut values: [u8; 4] = [1, 2, 3, 4];
    let mut which: Coordinate = Coordinate { value: 0 };
    let view: &mut [u8] = match which.value {
        0 -> keep(reset(&mut which.value), &mut values[which.value..which.value + 2])
        _ -> &mut values[0..2]
    };
    collide(view, &mut values[2]);
}
