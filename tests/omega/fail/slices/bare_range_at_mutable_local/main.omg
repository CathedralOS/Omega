// A bare range `items[1..3]` forms a shared view. An expected `&mut [T]`
// local never inserts the mutable borrow (`bare-range-reference-access`);
// the mutable subrange is spelled `&mut items[1..3]`, as the pass fixture
// `runtime_explicit_mutable_range_local_forwarding_exit` shows.
machine write(items: &mut [i32])
requires items.len > 3
{
    let window: &mut [i32] = items[1..3];
    window[0] = 23;
}
machine main() {}
