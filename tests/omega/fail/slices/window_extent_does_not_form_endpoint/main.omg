// Expected exit: 0

data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
machine selected<'storage>(source: View<'storage>, start: u64) -> View<'storage>
requires source.bytes.len == 9 && source.sibling.len == 4 && start == 18446744073709551615u64
ensures result.bytes.len == 7, result.sibling.len == 4
{ View { bytes: &source.bytes[start..start + 7], sibling: source.sibling } }
machine main() {
    let source: View = View { bytes: "123456789", sibling: "tail" };
    let value: View = selected(source, 18446744073709551615u64);
}
