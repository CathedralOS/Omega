// A bare window `items[1..2]` carries no borrow spelling of its own, so at a
// named call it is the shared loan the `[..]` adaptation forms even when the
// collection is a `&mut [i32]` parameter. Lending it to a `&mut` parameter
// is spelled `&mut items[1..2]`; the sibling pass fixture
// `runtime_mutable_subslice_state_forwarding_exit` shows that spelling.
machine fill(items: &mut [i32])
requires items.len > 0
{
    items[0] = 23;
}

machine write(items: &mut [i32])
requires items.len > 1
{
    fill(items[1..2]);
}
