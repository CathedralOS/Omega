// After `s = replacement` the slice local views `replacement`, whose entry
// requirement only guarantees one element. The length fact about `selected`
// no longer describes `s`, so `s[1]` must reject.
machine observe_view(selected: &[u64], replacement: &[u64]) -> u64
requires selected.len > 1 && replacement.len > 0 {
    let mut s: &[u64] = selected;
    s = replacement;
    s[1]
}

machine main() {}
