// Slice::Length is supported, but forwarding the same slice does not decrease
// that measure. Moving only the index cannot justify the recurrent arrival.

data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = &main.entries[..];

    transition {
        _ -> Main::walk(view, 0)
    }
}

machine Main::walk(entries: &[Entry], index: u64) -> u64
terminates by entries -> Slice::Length
{
    transition index < entries.len {
        true -> walk(entries, index + 1)
        false -> index
    }
}
