data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
    start: u64;
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();
    transition {
        _ -> choose(view, self.start)
    }

    state choose(&mut self, entries: &[Entry], start: u64) -> u64 {
        let tail: &[Entry] = entries[start..];
        tail.len
    }
}
