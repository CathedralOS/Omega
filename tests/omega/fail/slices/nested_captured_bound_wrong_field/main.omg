data Cell [copy] { value: u32; }
data Window<'input> { values: &'input mut [Cell]; other: &'input mut [Cell]; }
machine replace(windows: &mut [Window], outer: u64, inner: u64, replacement: Cell)
requires outer < windows.len && inner < windows[outer].values.len {
    // Capturing the same outer selector cannot donate a sibling's extent.
    windows[outer].other[inner] = replacement;
}
machine main() {}
