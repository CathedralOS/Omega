machine read(values: &[u32], position: u64) -> u32
requires position < values.len;
{
    values[position]
}

machine wrong(first: &[u32], second: &[u32], position: u64) -> u32 {
    transition position < first.len {
        true -> other(second, position)
        false -> 0
    }
    machine other(values: &[u32], position: u64) -> u32 {
        let observed: u32 = read(values, position);
        observed
    }
}
