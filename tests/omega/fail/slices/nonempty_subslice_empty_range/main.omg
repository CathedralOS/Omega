// A nonempty source can yield an empty view, so its domain is not inherited.
domain [u8]::Nonempty(bytes) requires non_empty(bytes);
machine inspect(bytes: &[u8] in Nonempty) {}
machine relay(bytes: &[u8] in Nonempty) { inspect(bytes[0..0]); }
data Main {}
machine Main::main(main: &mut Main) { relay("A"); }
