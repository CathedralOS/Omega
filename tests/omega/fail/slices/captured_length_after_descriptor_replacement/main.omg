machine observe(initial: &[u32], replacement: &[u32]) -> u32 {
    let mut items: &[u32] = initial;
    let count: u64 = items.len;
    items = replacement;
    // The scalar keeps its value, but no longer measures this descriptor.
    transition count >= 2 {
        true -> (items[1])
        false -> (0)
    }
}
machine main() {}
