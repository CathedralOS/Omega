machine read(items: &[u8], index: u64 in Wrapping) -> u8
requires index < items.len
{
    let mut position: u64 = index as u64;
    let before: u8 = items[position as u64];
    position = items.len;
    items[position as u64]
}

machine main() -> u8 {
    let items: [u8; 2] = [2, 3];
    read(&items[..], 1)
}
