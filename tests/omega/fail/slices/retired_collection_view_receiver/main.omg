// The receiver-style collection views `as_slice()` and `as_mut_slice()` are
// retired: a whole-collection view is the ordinary borrow `&entries[..]`.
// The retired spelling names no declaration and is an unresolved call.
data Entry { value: i32; }
data Main { entries: [Entry; 4]; }

machine Main::main(main: &mut Main) -> u64 {
    let view: &[Entry] = main.entries.as_slice();
    view.len
}
