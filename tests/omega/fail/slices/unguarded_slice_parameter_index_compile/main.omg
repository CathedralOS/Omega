data Entry {
    value: i32;
}

data Main {
}

machine Main::main() -> i32 {
    transition {
        _ -> 0
    }

    machine choose(entries: &[Entry], index: u64) -> i32 {
        transition {
            _ -> accept(entries[index].value)
        }
    }

    machine accept(value: i32) -> i32 {
        transition {
            _ -> value
        }
    }
}
