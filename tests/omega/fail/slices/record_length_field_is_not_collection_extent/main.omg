// A record field named `len` is an observed integer, not array metadata.
data Limit { len: u64; }
data Main { bytes: [u8; 3]; limit: Limit; }

machine require_all(bytes: &[u8]) requires bytes.len == 3 {}

machine Main::main(main: &mut Main) {
    main.limit.len = 1;
    let prefix: &[u8] = &main.bytes[0..main.limit.len];
    require_all(prefix);
}
