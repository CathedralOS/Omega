// A UTF-8 source does not authorize cutting inside a multibyte code point.
domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
machine inspect(bytes: &[u8] in Utf8) {}
machine relay(bytes: &[u8] in Utf8) {
    transition bytes.len > 0 {
        true -> inspect(bytes[0..1])
        false -> empty()
    }
    state empty() {}
}
data Main {}
machine Main::main(main: &mut Main) { relay("é"); }
