// FAIL CANARY -- a helper describes `launch` for the Linux ARM64 entry slot
// and the caller binds that description into the Windows x86-64 slot. The
// description keeps the slot it was checked against; `roots.bind` requires
// the authored slot to match it rather than re-checking the machine against
// a different target's slot.
machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_description_slot_mismatch");
    builder.roots.bind(windows_x86_64::ProgramEntry, describe(builder, "linux_arm64::ProgramEntry"));
}

machine describe(builder: &mut Build, slot: &[u8]) -> ProductEntryRef {
    builder.product.entry("launch", slot)
}
