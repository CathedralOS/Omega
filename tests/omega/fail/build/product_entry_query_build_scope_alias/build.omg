// FAIL CANARY -- `support` is a build-scope alias: the build source imports
// the helper package's `setup` module as a host library, and the helper
// declares `pub machine launch()`. A product-entry query through that alias
// still rejects. Only a product dependency authorizes a qualified product
// path; a build edge grants no product selection scope, and the query never
// falls back to the build-context declaration of the same name.
use support::setup;

machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_query_build_scope_alias");
    Build::build_depend_as(builder, "support", Source::Path { location: "helper" });
    let entry: ProductEntryRef = builder.product.entry("support::setup::launch", "windows_x86_64::ProgramEntry");
    builder.roots.bind(windows_x86_64::ProgramEntry, entry);
}
