// FAIL CANARY -- `support` is issued only as a Build dependency. Its helper
// declares `public machine launch()`, but that edge grants no Product selection
// scope. The Product query must reject that alias. Do not directly import an
// unexecuted Build dependency: explicit provider readiness replaced that old
// host-library route, which would reject before exercising this obligation.

machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_query_build_scope_alias");
    Build::build_depend_as(builder, "support", Source::Path { location: "helper" });
    let entry: ProductEntryRef = BuildProduct::entry(&builder.product, "support::setup::launch", "windows_x86_64::ProgramEntry");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry);
}
