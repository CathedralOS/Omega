machine build(builder: &mut Build) { Build::application(builder, "layout_scoped_macos_probe"); Build::depend(builder, Source::Path { location: "kit" }); Build::bind(builder, macos_arm64::ProgramEntry, main); Build::bind(builder, windows_x86_64::ProgramEntry, main); Build::bind(builder, linux_x86_64::ProgramEntry, main); Build::bind(builder, linux_arm64::ProgramEntry, main); }
