// FAIL CANARY -- a build helper reaches an ordinary runtime boundary. The
// transitive reach remains visible at the root and cannot become build
// authority merely by hiding behind a helper. The standard library enters
// through ordinary edges: a `Build::dependency` registration feeds the product source and
// a `Build::build_dependency` registration feeds this build-scope source; an ordinary package edge
// still grants no build authority over a runtime boundary service.
use omega_language_std::Console;

machine write_build_log(builder: &mut Build)
reaches Console
{
    Console::write_line("ordinary runtime boundary");
}

machine build(builder: &mut Build) {
    Build::application(builder, "build_effects_undeclared");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    let std_registration_2: DependencyRegistration = Build::build_dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    write_build_log(builder);
}
