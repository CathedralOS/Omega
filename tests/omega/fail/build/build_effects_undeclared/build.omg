// FAIL CANARY -- build.omg reaching FilesystemHost WITHOUT declaring that
// canonical service in its public ceiling. The staging service is allowed,
// but inferred reach may not silently widen the build contract.
use omega::language::std::filesystem_host;

machine write_build_asset(builder: &mut Build)
reaches FilesystemHost
{
    let output: &[u8] in Path = builder.output.resolve("asset.bin");
    let descriptor: i32 = builder.filesystem.create(output, 438);
    _ = builder.filesystem.close(descriptor);
}

machine build(builder: &mut Build) {
    builder.application("build-effects-undeclared");
    write_build_asset(builder);
}
