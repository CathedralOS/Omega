// FAIL CANARY -- `first::launch` and `second::launch` both satisfy the
// hosted ProgramEntry slot, and the query names only the shared leaf. The
// slot signature selects among visible candidates; declaration order never
// breaks the tie, so the query rejects as ambiguous rather than taking the
// first match.
machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_query_ambiguous_leaf");
    let entry: ProductEntryRef = builder.product.entry("launch", "windows_x86_64::ProgramEntry");
    builder.roots.bind(windows_x86_64::ProgramEntry, entry);
}
