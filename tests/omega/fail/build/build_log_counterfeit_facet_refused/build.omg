// `BuildLog::write_line` takes the activation's log facet as its first
// explicit operand, so the operand is what carries build-logging authority.
// An authored `BuildLog {}` has the same static shape as the compiler-issued
// facet and holds no log slot, and build evaluation refuses it.
//
// This case also pins that the call reaches the evaluator at all: the facet
// check is the only thing that can refuse it, so a dispatcher that never
// selects the facet family would compile this clean.
machine build(builder: &mut Build) {
    Build::application(builder, "build_log_counterfeit_facet_refused");
    let counterfeit: BuildLog = BuildLog {};
    BuildLog::write_line(&mut counterfeit, "counterfeit line");
}
