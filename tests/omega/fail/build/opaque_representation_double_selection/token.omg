use omega::language::core::OpaqueRepresentation;

public boundary data Token [copy];
public data TokenBytes [copy] {
    value: u32;
}
public data TokenWide [copy] {
    value: u32;
}
public TokenRepresentation satisfies OpaqueRepresentation<Token, TokenBytes> { }
public TokenWideRepresentation satisfies OpaqueRepresentation<Token, TokenWide> { }
