// FAIL CANARY. `Gate` is a package-local boundary trait no named map
// satisfies on any target, so it is not a provider slot the build can
// select: the selection names a provider (`LatchProvider`, a map of the
// unrelated `Latch` trait) for an unknown slot. Contrast
// pass/build/named_map_target_family_rows_exit, whose map's target-scoped
// rows make the same local trait a selectable slot.
use omega_language_std::console;

pub boundary trait Gate { machine open() -> i32; }
pub boundary trait Latch { machine hold() -> i32; }
LatchProvider satisfies Latch { Latch::hold = hold; }
machine hold() -> i32 { 1 }

data Main { held: i32; }
machine Main::main(main: &mut Main) reaches Latch + Console {
    main.held = Latch::hold();
    Console::exit_process(70);
}
