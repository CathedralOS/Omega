// FAIL CANARY. Gate is a declared package-local boundary trait without a
// matching provider candidate. LatchProvider supplies the distinct Latch slot;
// equal source visibility cannot satisfy Gate's nominal requirement.
use omega_language_std::console;

public boundary trait Gate { machine open() -> i32 reaches; }
public boundary trait Latch { machine hold() -> i32 reaches; }
LatchProvider satisfies Latch {
    machine hold() -> i32 reaches { 1 }
}

data Main { held: i32; }
machine run_entry(main: &mut Main) reaches Latch + Console {
    main.held = Latch::hold();
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Latch + Console {
    let mut entry_storage: Main;
    run_entry(&mut entry_storage);
}
