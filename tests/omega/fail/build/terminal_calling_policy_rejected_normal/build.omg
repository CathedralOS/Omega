machine build(builder: &mut Build) {
    Build::application(builder, "terminal_calling_policy_rejected_normal");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Input, InputMap>(builder, macos_arm64);
    Build::select_provider<Input, InputMap>(builder, linux_arm64);
    Build::select_provider<Input, InputMap>(builder, windows_x86_64);
    Build::select_provider<Input, InputMap>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
