use omega_language_std::BoundarySignature;
use omega_language_std::CallingPolicyRejection;
use omega_language_std::BoundaryPlanResult;
use omega_language_std::CallingPolicy;
use omega_language_std::Calling;

public boundary trait Input: Calling<RejectedCalling> {
    machine value(input: u64) -> u64 reaches;
}
InputMap satisfies Input { machine value(input: u64) -> u64 { input } }
public RejectedCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "normal Terminal rejection" }
        }
    }
}
machine main() reaches Input {
    let observed: u64 = Input::value(73u64);
}
