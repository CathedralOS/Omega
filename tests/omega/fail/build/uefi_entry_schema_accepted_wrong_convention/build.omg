machine build(builder: &mut Build) {
    Build::application(builder, "uefi_entry_schema_accepted_wrong_convention");
    Build::depend(builder, Source::Path { location: "vendor" });
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
    Build::bind(builder, uefi_x86_64::ProgramEntry, launch);
}
