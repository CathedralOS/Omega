use omega::language::core::extent;
use omega_language_std::calling;

// A different explicitly accepted entry-contract package. The schema keeps the
// contract's declaration names and source path, but its calling policy plans
// the UEFI physical surface on System V AMD64 — a coherent ABI on its own that
// the selected `uefi_x86_64::ProgramEntry` slot does not accept.
data EfiImageHandle {
    raw: addr;
}

boundary data EfiSystemTable;

data EfiStatus {
    code: u64;
}

boundary trait UefiPhysicalEntry {
    machine enter(
        image_handle: EfiImageHandle,
        system_table: &EfiSystemTable
    ) -> EfiStatus reaches;
}

data SystemVUefi { }
SystemVUefiCallingPolicy satisfies CallingPolicy {
    CallingPolicy::plan = SystemVUefi::plan;
}

machine SystemVUefi::plan(
    signature: BoundarySignature
) -> BoundaryPlanResult
    satisfies CallingPolicy::plan
{
    transition signature.parameter_count == 2 {
        true -> select_surface(signature)
        _ -> reject()
    }

    state select_surface(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.has_result {
            true -> accept_physical(
                signature,
                signature.parameters[0],
                signature.parameters[1],
                signature.result
            )
            _ -> accept_semantic(
                signature,
                signature.parameters[0],
                signature.parameters[1]
            )
        }
    }

    state accept_semantic(
        signature: BoundarySignature,
        image: u64,
        initial_storage: u64
    ) -> BoundaryPlanResult {
        transition image < 256 && initial_storage < 256 {
            true -> build(signature, image, initial_storage)
            _ -> reject()
        }
    }

    state build(
        signature: BoundarySignature,
        image: u64,
        initial_storage: u64
    ) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::SystemVAMD64;
        output.call.parameter_count = 2;

        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[image].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[image].alignment;
        output.call.parameters[0].location_count = 2;
        output.call.parameters[0].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rdi,
            value_byte_offset: 0,
            byte_size: 8,
        };
        output.call.parameters[0].locations[1] = ValueLocation::Register {
            register: MachineRegister::X86Rsi,
            value_byte_offset: 8,
            byte_size: 8,
        };

        output.call.parameters[1].shape.class = AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = signature.shapes[initial_storage].byte_size;
        output.call.parameters[1].shape.alignment = signature.shapes[initial_storage].alignment;
        output.call.parameters[1].location_count = 2;
        output.call.parameters[1].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rdx,
            value_byte_offset: 0,
            byte_size: 8,
        };
        output.call.parameters[1].locations[1] = ValueLocation::Register {
            register: MachineRegister::X86Rcx,
            value_byte_offset: 8,
            byte_size: 8,
        };

        output.call.ordinary_clobbers.register_count = 9;
        output.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = MachineRegister::X86Rsi;
        output.call.ordinary_clobbers.registers[4] = MachineRegister::X86Rdi;
        output.call.ordinary_clobbers.registers[5] = MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[6] = MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[7] = MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[8] = MachineRegister::X86R11;
        output.call.stack_alignment = 16;
        output.call.entry_control = EntryControl::CallReturn;

        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state accept_physical(
        signature: BoundarySignature,
        image_handle: u64,
        system_table: u64,
        status: u64
    ) -> BoundaryPlanResult {
        transition image_handle < 256 && system_table < 256 && status < 256 {
            true -> build_physical(signature, image_handle, system_table, status)
            _ -> reject()
        }
    }

    state build_physical(
        signature: BoundarySignature,
        image_handle: u64,
        system_table: u64,
        status: u64
    ) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::SystemVAMD64;
        output.call.parameter_count = 2;

        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[image_handle].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[image_handle].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rdi,
            value_byte_offset: 0,
            byte_size: signature.shapes[image_handle].byte_size,
        };

        output.call.parameters[1].shape.class = AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = signature.shapes[system_table].byte_size;
        output.call.parameters[1].shape.alignment = signature.shapes[system_table].alignment;
        output.call.parameters[1].location_count = 1;
        output.call.parameters[1].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rsi,
            value_byte_offset: 0,
            byte_size: signature.shapes[system_table].byte_size,
        };

        output.call.has_result = true;
        output.call.result.shape.class = AbiValueClass::Integer;
        output.call.result.shape.byte_size = signature.shapes[status].byte_size;
        output.call.result.shape.alignment = signature.shapes[status].alignment;
        output.call.result.location_count = 1;
        output.call.result.locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rax,
            value_byte_offset: 0,
            byte_size: signature.shapes[status].byte_size,
        };

        output.call.ordinary_clobbers.register_count = 9;
        output.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = MachineRegister::X86Rsi;
        output.call.ordinary_clobbers.registers[4] = MachineRegister::X86Rdi;
        output.call.ordinary_clobbers.registers[5] = MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[6] = MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[7] = MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[8] = MachineRegister::X86R11;
        output.call.stack_alignment = 16;
        output.call.entry_control = EntryControl::CallReturn;

        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        BoundaryPlanResult::Accepted { plan: output }
    }

    state reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection {
                reason: "UefiApplication requires two program-storage roots",
            },
        }
    }
}

boundary trait UefiApplication: ProgramStorageEntry + UefiPhysicalEntry + Calling<SystemVUefiCallingPolicy> {
}
