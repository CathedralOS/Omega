public boundary trait Reading<const Tag: u64> {
    machine total() -> u64 reaches ensures result >= 1000u64;
}
FirstReading<const Tag: u64> satisfies Reading<Tag> {
    machine total() -> u64 ensures result >= 1000u64 {
        match Tag { 17u64 -> 1117u64, _ -> 1129u64 }
    }
}
SecondReading<const Tag: u64> satisfies Reading<Tag> {
    machine total() -> u64 ensures result >= 1000u64 {
        match Tag { 17u64 -> 2117u64, _ -> 2129u64 }
    }
}
// A target-keyed provider call establishes total >= 1000, so exact subtraction total - 1000 preserves the selected provider result.
// Product-only machine execution is unavailable to the Build descriptor.
machine journey(expected: u64) reaches Reading crashes Trap {
    let total: u64 = Reading<17u64>::total();
    let difference: u64 = total - 1000u64;
    transition difference == expected { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine first_entry() reaches Reading crashes Trap { journey(117u64); }
machine second_entry() reaches Reading crashes Trap { journey(1117u64); }

trait TagValue { machine value() -> u64; }
TagMaker<T> satisfies TagValue { machine value() -> u64 { 17u64 } }
