machine build(builder: &mut Build) {
    Build::application(builder, "build_target_provider_local");
    Build::bind(builder, windows_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, second_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, second_entry);
    Build::select_provider<Reading<17u64>, FirstReading<(TagMaker<u64>::value())>>(builder, windows_x86_64);
    Build::select_provider<Reading<17u64>, FirstReading<(TagMaker<u64>::value())>>(builder, macos_x86_64);
    Build::select_provider<Reading<17u64>, FirstReading<(TagMaker<u64>::value())>>(builder, linux_x86_64);
    Build::select_provider<Reading<17u64>, SecondReading<(TagMaker<u64>::value())>>(builder, macos_arm64);
    Build::select_provider<Reading<17u64>, SecondReading<(TagMaker<u64>::value())>>(builder, linux_arm64);
}
