    requires machine Fatal15 satisfies FatalVector15::enter;
    requires machine Fatal16 satisfies FatalVector16::enter;
    requires machine Fatal17 satisfies FatalVector17::enter;
    requires machine Fatal18 satisfies FatalVector18::enter;
    requires machine Fatal19 satisfies FatalVector19::enter;
    requires machine Fatal20 satisfies FatalVector20::enter;
