    requires machine Fatal23 satisfies FatalVector23::enter;
    requires machine Fatal24 satisfies FatalVector24::enter;
    requires machine Fatal25 satisfies FatalVector25::enter;
    requires machine Fatal26 satisfies FatalVector26::enter;
    requires machine Fatal27 satisfies FatalVector27::enter;
    requires machine Fatal28 satisfies FatalVector28::enter;
    requires machine Fatal29 satisfies FatalVector29::enter;
    requires machine Fatal30 satisfies FatalVector30::enter;
    requires machine Fatal31 satisfies FatalVector31::enter;
    requires machine Timer satisfies CathedralTimerRoot::enter;
    reaches MachineControl + PortIo
    invokes StaticInterruptTableValidation invokes StaticInterruptWork
    crashes Trap
    ensures result == false {
        let mut stacks: [StaticInterruptStack; 4] = [
            StaticInterruptStack { words: &mut storage.double_fault_stack[1..512], ist: 1u8 },
            StaticInterruptStack { words: &mut storage.nmi_stack[1..512], ist: 2u8 },
            StaticInterruptStack { words: &mut storage.machine_check_stack[1..512], ist: 3u8 },
            StaticInterruptStack { words: &mut storage.irq_stack[1..512], ist: 4u8 }
        ];
        let arrivals: [StaticInterruptArrival; 33] = complete_arrivals(profile);
        X86StaticInterruptScope::run<
            BootstrapInterruptRegistrar::install<Fatal00, Fatal01, Fatal02, Fatal03, Fatal04, Fatal05, Fatal06, Fatal07, Fatal08, Fatal09, Fatal10, Fatal11, Fatal12, Fatal13, Fatal14, Fatal15, Fatal16, Fatal17, Fatal18, Fatal19, Fatal20, Fatal21, Fatal22, Fatal23, Fatal24, Fatal25, Fatal26, Fatal27, Fatal28, Fatal29, Fatal30, Fatal31, Timer>, GateSlot32,
            BootstrapIdt, BootstrapInterruptContext, table_policy,
            BootstrapInterruptTableValidator::validate, TimerEventLoop::run,
            PicTimerAcknowledgement::complete, 5
        >(table, &mut storage.gdt, &storage.task_bytes,
            &mut stacks[..], &arrivals[..], context)
    }
}

public BootstrapInterruptRegistrarCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 4 && signature.native_parameter_count == 4
            && signature.has_result && signature.callback_binder_count == 33
            && signature.callback_demand_count == 33 {
            true -> accept(signature)
            _ -> reject()
        }
        machine accept(signature: BoundarySignature) -> BoundaryPlanResult { build(signature) }
        machine build(signature: BoundarySignature) -> BoundaryPlanResult {
            let mut plan: BoundaryEntryPlan;
            plan.call.convention = CallingConvention::SystemVAMD64;
            plan.call.parameter_count = 4;
            plan.call.parameters[0].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rdi, value_byte_offset: 0, byte_size: 8 };
            plan.call.parameters[1].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[1].location_count = 1;
            plan.call.parameters[1].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rsi, value_byte_offset: 0, byte_size: 8 };
            plan.call.parameters[2].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[2].location_count = 1;
            plan.call.parameters[2].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rdx, value_byte_offset: 0, byte_size: 8 };
            plan.call.parameters[3].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[3].location_count = 1;
            plan.call.parameters[3].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rcx, value_byte_offset: 0, byte_size: 8 };
            plan.call.has_result = true;
            plan.call.result.shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 1, alignment: 1 };
            plan.call.result.location_count = 1;
            plan.call.result.locations[0] = ValueLocation::Register { register: MachineRegister::X86Rax, value_byte_offset: 0, byte_size: 1 };
            plan.call.callback_materialization_count = 33;
            plan.call.stack_alignment = 16;
            plan.call.entry_control = EntryControl::CallReturn;
            plan.state.initial_regime = MachineRegime::X86Long64;
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.permitted_transitive_use.instruction_pointer = true;
            plan.state.permitted_transitive_use.stack_pointer = true;
            plan.state.permitted_transitive_use.control_state = true;
            plan.state.stack = EntryStack::ProviderSelected;
            plan.state.preemption = Preemption::NotApplicable;
            transition materialize_slots(&mut plan, &signature, 0, 33) {
                true -> accepted_plan(plan)
                _ -> reject()
            }
        }
        machine accepted_plan(plan: BoundaryEntryPlan) -> BoundaryPlanResult {
            BoundaryPlanResult::Accepted { plan: plan }
        }
        machine reject() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "complete exception floor requires four borrows, 33 exact slots and a Boolean refusal result" } }
        }

        machine materialize_slots(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature,
            index: u64, remaining: u64) -> bool
        terminates by remaining {
            transition index < 33 && remaining > 0 {
                true -> inspect_slot(plan, signature, index, remaining)
                _ -> (index == 33)
            }
            machine inspect_slot(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature,
                index: u64, remaining: u64) -> bool
            requires index < 33 && remaining > 0 {
                let requirement: u64 = signature.callback_demands[index].requirement;
                let binder: u64 = exact_binder(signature, requirement, 0, 33, false, 0);
                transition binder != 0 && no_earlier_demand(signature, requirement, index, 0, 33) {
                    true -> materialize_slot(plan, signature, index, remaining, binder)
                    _ -> false
                }
            }
            machine materialize_slot(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature,
                index: u64, remaining: u64, binder: u64) -> bool
            requires index < 33 && remaining > 0 {
                plan.call.callback_materializations[index].binder = binder;
                plan.call.callback_materializations[index].destination = signature.callback_demands[index].destination;
                materialize_slots(plan, signature, index + 1, remaining - 1)
            }
        }
        machine exact_binder(signature: &BoundarySignature, requirement: u64,
            index: u64, remaining: u64, found: bool, selected: u64) -> u64
        terminates by remaining {
            transition index < 33 && remaining > 0 {
                true -> inspect_binder(signature, requirement, index, remaining, found, selected)
                _ -> selected
            }
            machine inspect_binder(signature: &BoundarySignature, requirement: u64,
                index: u64, remaining: u64, found: bool, selected: u64) -> u64
            requires index < 33 && remaining > 0 {
                transition signature.callback_binders[index].requirement == requirement {
                    true -> matched_binder(signature, requirement, index, remaining, found)
                    _ -> exact_binder(signature, requirement, index + 1, remaining - 1, found, selected)
                }
            }
            machine matched_binder(signature: &BoundarySignature, requirement: u64,
                index: u64, remaining: u64, found: bool) -> u64
            requires index < 33 && remaining > 0 {
                transition found {
                    true -> 0
                    _ -> exact_binder(signature, requirement, index + 1, remaining - 1,
                        true, signature.callback_binders[index].binder)
                }
            }
        }
        machine no_earlier_demand(signature: &BoundarySignature, requirement: u64,
            stop: u64, index: u64, remaining: u64) -> bool
        terminates by remaining {
            transition index < stop && index < 33 && remaining > 0 {
                true -> inspect_demand(signature, requirement, stop, index, remaining)
                _ -> (index == stop)
            }
            machine inspect_demand(signature: &BoundarySignature, requirement: u64,
                stop: u64, index: u64, remaining: u64) -> bool
            requires index < 33 && remaining > 0 {
                transition signature.callback_demands[index].requirement == requirement {
                    true -> false
                    _ -> no_earlier_demand(signature, requirement, stop, index + 1, remaining - 1)
                }
            }
        }

    }
}

public data BootstrapInterruptContext { before: u64; fatal: [BootstrapFatalExceptionDiagnosticState; 32]; after: u64; }

proposition timer_acknowledgement_completed(acknowledgement: InterruptAcknowledgement)
    = port_written(0x20, 0x20);

public PicTimerAcknowledgement satisfies InterruptAcknowledgementCompletion {
    machine complete(acknowledgement: InterruptAcknowledgement)
    reaches PortIo
    requires acknowledgement in InterruptAcknowledgement::Pending
    ensures timer_acknowledgement_completed(acknowledgement)
    {
        asm ensures timer_acknowledgement_completed(acknowledgement)
        clobbers r10, r11, r15, rax, rdx {
            out 0x20, 0x20
        }
    }
}

public machine install_bootstrap_interrupts(storage: &mut TaskStateStorage)
reaches MachineControl + PortIo + BootstrapInterruptRegistrar
invokes BootstrapInterruptRegistrar
crashes Trap ensures false {
    asm { cli }
    let mut retained: RetainedIdt;
    retained.before = 0x1122334455667788u64;
    retained.after = 0x8877665544332211u64;
    initialize_table(&mut retained.table);
    let mut context: BootstrapInterruptContext;
    context.before = 0x13579BDF2468ACE0u64;
    context.after = 0xFEDCBA9876543210u64;
    context.fatal[0].vector.store(0, NoOrdering);
    context.fatal[0].published.store(0, NoOrdering);
    context.fatal[1].vector.store(0, NoOrdering);
    context.fatal[1].published.store(0, NoOrdering);
    context.fatal[2].vector.store(0, NoOrdering);
    context.fatal[2].published.store(0, NoOrdering);
    context.fatal[3].vector.store(0, NoOrdering);
    context.fatal[3].published.store(0, NoOrdering);
    context.fatal[4].vector.store(0, NoOrdering);
    context.fatal[4].published.store(0, NoOrdering);
    context.fatal[5].vector.store(0, NoOrdering);
    context.fatal[5].published.store(0, NoOrdering);
    context.fatal[6].vector.store(0, NoOrdering);
    context.fatal[6].published.store(0, NoOrdering);
    context.fatal[7].vector.store(0, NoOrdering);
    context.fatal[7].published.store(0, NoOrdering);
    context.fatal[8].vector.store(0, NoOrdering);
    context.fatal[8].published.store(0, NoOrdering);
    context.fatal[9].vector.store(0, NoOrdering);
    context.fatal[9].published.store(0, NoOrdering);
    context.fatal[10].vector.store(0, NoOrdering);
    context.fatal[10].published.store(0, NoOrdering);
    context.fatal[11].vector.store(0, NoOrdering);
    context.fatal[11].published.store(0, NoOrdering);
    context.fatal[12].vector.store(0, NoOrdering);
    context.fatal[12].published.store(0, NoOrdering);
    context.fatal[13].vector.store(0, NoOrdering);
    context.fatal[13].published.store(0, NoOrdering);
    context.fatal[14].vector.store(0, NoOrdering);
    context.fatal[14].published.store(0, NoOrdering);
    context.fatal[15].vector.store(0, NoOrdering);
    context.fatal[15].published.store(0, NoOrdering);
    context.fatal[16].vector.store(0, NoOrdering);
    context.fatal[16].published.store(0, NoOrdering);
    context.fatal[17].vector.store(0, NoOrdering);
    context.fatal[17].published.store(0, NoOrdering);
    context.fatal[18].vector.store(0, NoOrdering);
    context.fatal[18].published.store(0, NoOrdering);
    context.fatal[19].vector.store(0, NoOrdering);
    context.fatal[19].published.store(0, NoOrdering);
    context.fatal[20].vector.store(0, NoOrdering);
    context.fatal[20].published.store(0, NoOrdering);
    context.fatal[21].vector.store(0, NoOrdering);
    context.fatal[21].published.store(0, NoOrdering);
    context.fatal[22].vector.store(0, NoOrdering);
    context.fatal[22].published.store(0, NoOrdering);
    context.fatal[23].vector.store(0, NoOrdering);
    context.fatal[23].published.store(0, NoOrdering);
    context.fatal[24].vector.store(0, NoOrdering);
    context.fatal[24].published.store(0, NoOrdering);
    context.fatal[25].vector.store(0, NoOrdering);
    context.fatal[25].published.store(0, NoOrdering);
    context.fatal[26].vector.store(0, NoOrdering);
    context.fatal[26].published.store(0, NoOrdering);
    context.fatal[27].vector.store(0, NoOrdering);
    context.fatal[27].published.store(0, NoOrdering);
    context.fatal[28].vector.store(0, NoOrdering);
    context.fatal[28].published.store(0, NoOrdering);
    context.fatal[29].vector.store(0, NoOrdering);
    context.fatal[29].published.store(0, NoOrdering);
    context.fatal[30].vector.store(0, NoOrdering);
    context.fatal[30].published.store(0, NoOrdering);
    context.fatal[31].vector.store(0, NoOrdering);
    context.fatal[31].published.store(0, NoOrdering);
    storage.double_fault_stack[0] = 0xA1B2C3D4E5F60718u64;
    storage.double_fault_stack[512] = 0x81706F5E4D3C2B1Au64;
    storage.double_fault_stack[513] = 0x96A5B4C3D2E1F087u64;
    storage.nmi_stack[0] = 0xA1B2C3D4E5F60718u64;
    storage.nmi_stack[512] = 0x81706F5E4D3C2B1Au64;
    storage.nmi_stack[513] = 0x96A5B4C3D2E1F087u64;
    storage.machine_check_stack[0] = 0xA1B2C3D4E5F60718u64;
    storage.machine_check_stack[512] = 0x81706F5E4D3C2B1Au64;
    storage.machine_check_stack[513] = 0x96A5B4C3D2E1F087u64;
    storage.irq_stack[0] = 0xA1B2C3D4E5F60718u64;
    storage.irq_stack[512] = 0x81706F5E4D3C2B1Au64;
    storage.irq_stack[513] = 0x96A5B4C3D2E1F087u64;
    let profile: ProfileArrivalFrames = fatal_frames();
    let refused: bool = BootstrapInterruptRegistrar::install<
        FatalHandler00::enter, FatalHandler01::enter, FatalHandler02::enter, FatalHandler03::enter, FatalHandler04::enter, FatalHandler05::enter, FatalHandler06::enter, FatalHandler07::enter, FatalHandler08::enter, FatalHandler09::enter, FatalHandler10::enter, FatalHandler11::enter, FatalHandler12::enter, FatalHandler13::enter, FatalHandler14::enter, FatalHandler15::enter, FatalHandler16::enter, FatalHandler17::enter, FatalHandler18::enter, FatalHandler19::enter, FatalHandler20::enter, FatalHandler21::enter, FatalHandler22::enter, FatalHandler23::enter, FatalHandler24::enter, FatalHandler25::enter, FatalHandler26::enter, FatalHandler27::enter, FatalHandler28::enter, FatalHandler29::enter, FatalHandler30::enter, FatalHandler31::enter, BootstrapTimerHandler::enter
    >(&mut retained.table, storage, &context, &profile);
    crash Trap;
}

// Source-derived native-admission control only. Never execute installed CPU code here.
public machine start()
invokes TaskStatePreparation
invokes BootstrapInterruptRegistrar
crashes Abort
crashes Trap
requires addr::Bound == 18446744073709551616 {
    let mut storage: TaskStateStorage;
    let activated: bool = TaskStatePreparation::activate(&mut storage);
    transition activated {
        true -> installed(&mut storage)
        _ -> refused()
    }
    machine installed(storage: &mut TaskStateStorage)
    requires addr::Bound == 18446744073709551616 ensures false {
        install_bootstrap_interrupts(storage);
        crash Trap;
    }
    machine refused() ensures false { crash Trap; }
}


// Every route forwards the very same owned Pending occurrence. There is no
// context-view application anywhere in this fixture.
machine forward_acknowledgement(acknowledgement: InterruptAcknowledgement in Pending)
reaches MachineControl + PortIo {
    complete_installed_interrupt<PicTimerAcknowledgement::complete>(acknowledgement);
}
trait DynamicArrivalForwarding {
    machine forward(acknowledgement: InterruptAcknowledgement in Pending)
    reaches MachineControl + PortIo;
}
DynamicArrival satisfies DynamicArrivalForwarding {
    machine forward(acknowledgement: InterruptAcknowledgement in Pending)
    reaches MachineControl + PortIo {
        complete_installed_interrupt<OtherCompletion::complete>(acknowledgement);
    }
}
public BootstrapTimerHandler satisfies CathedralTimerRoot {
    machine enter(acknowledgement: InterruptAcknowledgement in Pending)
    reaches MachineControl + PortIo {
        let mode: u8 = read_route(0x20u16);
        transition mode {
            0 -> direct(acknowledgement)
            1 -> ordinary(acknowledgement)
            2 -> dynamic(acknowledgement)
            _ -> forward_forever(acknowledgement)
        }
        machine direct(acknowledgement: InterruptAcknowledgement in Pending) {
            complete_installed_interrupt<PicTimerAcknowledgement::complete>(acknowledgement);
        }
        machine ordinary(acknowledgement: InterruptAcknowledgement in Pending) {
            forward_acknowledgement(acknowledgement);
        }
        machine dynamic(acknowledgement: InterruptAcknowledgement in Pending) {
            let selected: dyn DynamicArrivalForwarding = DynamicArrival as dyn DynamicArrivalForwarding;
            DynamicArrivalForwarding::forward(selected, acknowledgement);
        }
    }
}
machine read_route(port: u16) -> u8 reaches PortIo {
    let mut mode: u8 = 0;
    asm clobbers rax, rdx, r10, r15 { in mode, port; }
    mode
}
machine forward_forever(acknowledgement: InterruptAcknowledgement in Pending)
reaches MachineControl + PortIo ensures false {
    forward_acknowledgement(acknowledgement);
    transition { _ -> wait() }
    machine wait() { asm { hlt } transition { _ -> wait() } }
}
public TimerEventLoop satisfies StaticInterruptWork<BootstrapInterruptContext> {
    machine run(context: &BootstrapInterruptContext)
    reaches MachineControl + PortIo ensures false {
        transition { _ -> wait() }
        machine wait() { asm { hlt } transition { _ -> wait() } }
    }
}

// The twin chooses this exact operation only from its dynamic forwarding body.
// Equal argument shape and the same delegated PIC action do not make it the
// completion operation selected by Scope.
OtherCompletion satisfies InterruptAcknowledgementCompletion {
    machine complete(acknowledgement: InterruptAcknowledgement)
    requires acknowledgement in InterruptAcknowledgement::Pending
    reaches PortIo {
        PicTimerAcknowledgement::complete(acknowledgement);
    }
}
