public data TaskStateSegment [copy] { reserved_1: u32; privilege_stack_table: [u64; 3]; reserved_2: u64; interrupt_stack_table: [u64; 7]; reserved_3: u64; reserved_4: u16; iomap_base: u16; }

public machine encode_TaskStateSegment(value: &TaskStateSegment) -> [u8; 104] {
    let mut output: [u8; 104];
    output[0] = ((value.reserved_1 >> 0) & 255) as u8;
    output[1] = ((value.reserved_1 >> 8) & 255) as u8;
    output[2] = ((value.reserved_1 >> 16) & 255) as u8;
    output[3] = ((value.reserved_1 >> 24) & 255) as u8;
    output[4] = ((value.privilege_stack_table[0] >> 0) & 255) as u8;
    output[5] = ((value.privilege_stack_table[0] >> 8) & 255) as u8;
    output[6] = ((value.privilege_stack_table[0] >> 16) & 255) as u8;
    output[7] = ((value.privilege_stack_table[0] >> 24) & 255) as u8;
    output[8] = ((value.privilege_stack_table[0] >> 32) & 255) as u8;
    output[9] = ((value.privilege_stack_table[0] >> 40) & 255) as u8;
    output[10] = ((value.privilege_stack_table[0] >> 48) & 255) as u8;
    output[11] = ((value.privilege_stack_table[0] >> 56) & 255) as u8;
    output[12] = ((value.privilege_stack_table[1] >> 0) & 255) as u8;
    output[13] = ((value.privilege_stack_table[1] >> 8) & 255) as u8;
    output[14] = ((value.privilege_stack_table[1] >> 16) & 255) as u8;
    output[15] = ((value.privilege_stack_table[1] >> 24) & 255) as u8;
    output[16] = ((value.privilege_stack_table[1] >> 32) & 255) as u8;
    output[17] = ((value.privilege_stack_table[1] >> 40) & 255) as u8;
    output[18] = ((value.privilege_stack_table[1] >> 48) & 255) as u8;
    output[19] = ((value.privilege_stack_table[1] >> 56) & 255) as u8;
    output[20] = ((value.privilege_stack_table[2] >> 0) & 255) as u8;
    output[21] = ((value.privilege_stack_table[2] >> 8) & 255) as u8;
    output[22] = ((value.privilege_stack_table[2] >> 16) & 255) as u8;
    output[23] = ((value.privilege_stack_table[2] >> 24) & 255) as u8;
    output[24] = ((value.privilege_stack_table[2] >> 32) & 255) as u8;
    output[25] = ((value.privilege_stack_table[2] >> 40) & 255) as u8;
    output[26] = ((value.privilege_stack_table[2] >> 48) & 255) as u8;
    output[27] = ((value.privilege_stack_table[2] >> 56) & 255) as u8;
    output[28] = ((value.reserved_2 >> 0) & 255) as u8;
    output[29] = ((value.reserved_2 >> 8) & 255) as u8;
    output[30] = ((value.reserved_2 >> 16) & 255) as u8;
    output[31] = ((value.reserved_2 >> 24) & 255) as u8;
    output[32] = ((value.reserved_2 >> 32) & 255) as u8;
    output[33] = ((value.reserved_2 >> 40) & 255) as u8;
    output[34] = ((value.reserved_2 >> 48) & 255) as u8;
    output[35] = ((value.reserved_2 >> 56) & 255) as u8;
    output[36] = ((value.interrupt_stack_table[0] >> 0) & 255) as u8;
    output[37] = ((value.interrupt_stack_table[0] >> 8) & 255) as u8;
    output[38] = ((value.interrupt_stack_table[0] >> 16) & 255) as u8;
    output[39] = ((value.interrupt_stack_table[0] >> 24) & 255) as u8;
    output[40] = ((value.interrupt_stack_table[0] >> 32) & 255) as u8;
    output[41] = ((value.interrupt_stack_table[0] >> 40) & 255) as u8;
    output[42] = ((value.interrupt_stack_table[0] >> 48) & 255) as u8;
    output[43] = ((value.interrupt_stack_table[0] >> 56) & 255) as u8;
    output[44] = ((value.interrupt_stack_table[1] >> 0) & 255) as u8;
    output[45] = ((value.interrupt_stack_table[1] >> 8) & 255) as u8;
    output[46] = ((value.interrupt_stack_table[1] >> 16) & 255) as u8;
    output[47] = ((value.interrupt_stack_table[1] >> 24) & 255) as u8;
    output[48] = ((value.interrupt_stack_table[1] >> 32) & 255) as u8;
    output[49] = ((value.interrupt_stack_table[1] >> 40) & 255) as u8;
    output[50] = ((value.interrupt_stack_table[1] >> 48) & 255) as u8;
    output[51] = ((value.interrupt_stack_table[1] >> 56) & 255) as u8;
    output[52] = ((value.interrupt_stack_table[2] >> 0) & 255) as u8;
    output[53] = ((value.interrupt_stack_table[2] >> 8) & 255) as u8;
    output[54] = ((value.interrupt_stack_table[2] >> 16) & 255) as u8;
    output[55] = ((value.interrupt_stack_table[2] >> 24) & 255) as u8;
    output[56] = ((value.interrupt_stack_table[2] >> 32) & 255) as u8;
    output[57] = ((value.interrupt_stack_table[2] >> 40) & 255) as u8;
    output[58] = ((value.interrupt_stack_table[2] >> 48) & 255) as u8;
    output[59] = ((value.interrupt_stack_table[2] >> 56) & 255) as u8;
    output[60] = ((value.interrupt_stack_table[3] >> 0) & 255) as u8;
    output[61] = ((value.interrupt_stack_table[3] >> 8) & 255) as u8;
    output[62] = ((value.interrupt_stack_table[3] >> 16) & 255) as u8;
    output[63] = ((value.interrupt_stack_table[3] >> 24) & 255) as u8;
    output[64] = ((value.interrupt_stack_table[3] >> 32) & 255) as u8;
    output[65] = ((value.interrupt_stack_table[3] >> 40) & 255) as u8;
    output[66] = ((value.interrupt_stack_table[3] >> 48) & 255) as u8;
    output[67] = ((value.interrupt_stack_table[3] >> 56) & 255) as u8;
    output[68] = ((value.interrupt_stack_table[4] >> 0) & 255) as u8;
    output[69] = ((value.interrupt_stack_table[4] >> 8) & 255) as u8;
    output[70] = ((value.interrupt_stack_table[4] >> 16) & 255) as u8;
    output[71] = ((value.interrupt_stack_table[4] >> 24) & 255) as u8;
    output[72] = ((value.interrupt_stack_table[4] >> 32) & 255) as u8;
    output[73] = ((value.interrupt_stack_table[4] >> 40) & 255) as u8;
    output[74] = ((value.interrupt_stack_table[4] >> 48) & 255) as u8;
    output[75] = ((value.interrupt_stack_table[4] >> 56) & 255) as u8;
    output[76] = ((value.interrupt_stack_table[5] >> 0) & 255) as u8;
    output[77] = ((value.interrupt_stack_table[5] >> 8) & 255) as u8;
    output[78] = ((value.interrupt_stack_table[5] >> 16) & 255) as u8;
    output[79] = ((value.interrupt_stack_table[5] >> 24) & 255) as u8;
    output[80] = ((value.interrupt_stack_table[5] >> 32) & 255) as u8;
    output[81] = ((value.interrupt_stack_table[5] >> 40) & 255) as u8;
    output[82] = ((value.interrupt_stack_table[5] >> 48) & 255) as u8;
    output[83] = ((value.interrupt_stack_table[5] >> 56) & 255) as u8;
    output[84] = ((value.interrupt_stack_table[6] >> 0) & 255) as u8;
    output[85] = ((value.interrupt_stack_table[6] >> 8) & 255) as u8;
    output[86] = ((value.interrupt_stack_table[6] >> 16) & 255) as u8;
    output[87] = ((value.interrupt_stack_table[6] >> 24) & 255) as u8;
    output[88] = ((value.interrupt_stack_table[6] >> 32) & 255) as u8;
    output[89] = ((value.interrupt_stack_table[6] >> 40) & 255) as u8;
    output[90] = ((value.interrupt_stack_table[6] >> 48) & 255) as u8;
    output[91] = ((value.interrupt_stack_table[6] >> 56) & 255) as u8;
    output[92] = ((value.reserved_3 >> 0) & 255) as u8;
    output[93] = ((value.reserved_3 >> 8) & 255) as u8;
    output[94] = ((value.reserved_3 >> 16) & 255) as u8;
    output[95] = ((value.reserved_3 >> 24) & 255) as u8;
    output[96] = ((value.reserved_3 >> 32) & 255) as u8;
    output[97] = ((value.reserved_3 >> 40) & 255) as u8;
    output[98] = ((value.reserved_3 >> 48) & 255) as u8;
    output[99] = ((value.reserved_3 >> 56) & 255) as u8;
    output[100] = ((value.reserved_4 >> 0) & 255) as u8;
    output[101] = ((value.reserved_4 >> 8) & 255) as u8;
    output[102] = ((value.iomap_base >> 0) & 255) as u8;
    output[103] = ((value.iomap_base >> 8) & 255) as u8;
    output
}

public data X86IstStackClass [copy]
requires self.stack_class >= 1 && self.stack_class <= 7
    && self.ist_index >= 1 && self.ist_index <= 7
{
    stack_class: u64;
    ist_index: u8;
}
public const X86_MASKABLE_IRQ_STACK: X86IstStackClass = X86IstStackClass {
    stack_class: 4,
    ist_index: 4,
};

public data CathedralAcknowledgementCarrier {
    physical_root: u64;
    execution: u64;
    invocation: u64;
    policy: u64;
    acknowledgement: u64;
}

public CathedralAcknowledgementRepresentation satisfies OpaqueRepresentation<
    InterruptAcknowledgement, CathedralAcknowledgementCarrier
> {}

public CathedralX86InterruptPolicy satisfies CallingPolicy {
    machine plan(
        signature: BoundarySignature
    ) -> BoundaryPlanResult
    {
        transition signature.parameter_count == 1 && !signature.has_result {
            true -> accept(signature, signature.parameters[0])
            _    -> reject()
        }

        machine accept(signature: BoundarySignature, acknowledgement: u64) -> BoundaryPlanResult {
            transition acknowledgement < 256 {
                true -> build(signature, acknowledgement)
                _    -> reject()
            }
        }

        machine build(signature: BoundarySignature, acknowledgement: u64) -> BoundaryPlanResult {
            let mut output: BoundaryEntryPlan;
            output.call.convention = CallingConvention::SystemVAMD64;
            output.call.parameter_count = 1;
            output.call.parameters[0].shape.class = AbiValueClass::Integer;
            output.call.parameters[0].shape.byte_size = signature.shapes[acknowledgement].byte_size;
            output.call.parameters[0].shape.alignment = signature.shapes[acknowledgement].alignment;
            output.call.parameters[0].location_count = 1;
            output.call.parameters[0].locations[0] = ValueLocation::Stack {
                stack_byte_offset: 0,
                value_byte_offset: 0,
                byte_size: signature.shapes[acknowledgement].byte_size,
                alignment: 8,
            };
            output.call.stack_alignment = 16;
            output.call.entry_control = EntryControl::InterruptReturn;

            output.state.initial_regime = MachineRegime::X86Long64;
            output.state.interrupted_state.general_registers = true;
            output.state.interrupted_state.vector_registers = true;
            output.state.interrupted_state.flags = true;
            output.state.interrupted_state.instruction_pointer = true;
            output.state.interrupted_state.stack_pointer = true;
            output.state.saved_state.general_registers = true;
            output.state.saved_state.flags = true;
            output.state.saved_state.instruction_pointer = true;
            output.state.saved_state.stack_pointer = true;
            output.state.restored_state.general_registers = true;
            output.state.restored_state.flags = true;
            output.state.restored_state.instruction_pointer = true;
            output.state.restored_state.stack_pointer = true;
            output.state.permitted_transitive_use.general_registers = true;
            output.state.permitted_transitive_use.flags = true;
            output.state.permitted_transitive_use.instruction_pointer = true;
            output.state.permitted_transitive_use.stack_pointer = true;
            output.state.permitted_transitive_use.segment_state = true;
            output.state.stack = EntryStack::Dedicated {
                class: X86_MASKABLE_IRQ_STACK.stack_class,
            };
            output.state.preemption = Preemption::Masked;
            BoundaryPlanResult::Accepted { plan: output }
        }

        machine reject() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected {
                reason: CallingPolicyRejection {
                    reason: "Cathedral's x86 interrupt root requires one acknowledgement",
                },
            }
        }
    }
}

public boundary trait CathedralTimerRoot:
    InterruptEntry + Calling<CathedralX86InterruptPolicy>
{
}

public data BootstrapFatalExceptionDiagnosticState {
    vector: AtomicU32;
    published: AtomicU32;
}

public machine BootstrapFatalExceptionDiagnosticState::record_and_abort(
    diagnostic: &BootstrapFatalExceptionDiagnosticState,
    vector: u32
)
requires 0 <= vector && vector <= 31
crashes Abort
{
    diagnostic.vector.store(vector, NoOrdering);
    let prior_published: u32 = diagnostic.published.fetch_or(1, Publish);
    crash Abort;
}

public boundary trait TaskStatePreparation {
    machine activate(storage: &mut TaskStateStorage) -> bool
    requires addr::Bound == 18446744073709551616
    reaches MachineControl + TaskRegisterControl
    invokes TaskRegisterControl
    crashes Abort;
}

public BootstrapTaskStatePreparation satisfies TaskStatePreparation {
    machine activate(storage: &mut TaskStateStorage) -> bool
    requires addr::Bound == 18446744073709551616
    reaches MachineControl + TaskRegisterControl
    invokes TaskRegisterControl
    crashes Abort
    { activate_task(storage) }
}

public data TaskStateStorage {
    before: u64;
    gdt: [u64; 5];
    gdt_after: u64;
    task: TaskStateSegment;
    task_bytes: [u8; 104];
    double_fault_stack: [u64; 514];
    nmi_stack: [u64; 514];
    machine_check_stack: [u64; 514];
    irq_stack: [u64; 514];
    after: u64;
}

machine activate_task(storage: &mut TaskStateStorage) -> bool
requires addr::Bound == 18446744073709551616
reaches MachineControl + TaskRegisterControl
invokes TaskRegisterControl
crashes Abort
{
    storage.before = 0x13579BDF2468ACE0;
    storage.after = 0xFEDCBA9876543210;
    storage.gdt_after = 0xBADC0FFEE0DDF00D;
    let double_fault_top: u64 = (address_of(&storage.double_fault_stack[512]) as u64) & 0xFFFFFFFFFFFFFFF0;
    let nmi_top: u64 = (address_of(&storage.nmi_stack[512]) as u64) & 0xFFFFFFFFFFFFFFF0;
    let machine_check_top: u64 = (address_of(&storage.machine_check_stack[512]) as u64) & 0xFFFFFFFFFFFFFFF0;
    let irq_top: u64 = (address_of(&storage.irq_stack[512]) as u64) & 0xFFFFFFFFFFFFFFF0;
    storage.task = TaskStateSegment {
        reserved_1: 0,
        privilege_stack_table: [irq_top, 0, 0],
        reserved_2: 0,
        interrupt_stack_table: [double_fault_top, nmi_top, machine_check_top, irq_top, 0, 0, 0],
        reserved_3: 0, reserved_4: 0, iomap_base: 104,
    };
    storage.task_bytes = encode_TaskStateSegment(&storage.task);
    let task_base: u64 = address_of(&storage.task_bytes[0]) as u64;
    storage.gdt[0] = 0;
    storage.gdt[1] = 0x00AF9B000000FFFF;
    storage.gdt[2] = 0x00CF93000000FFFF;
    storage.gdt[3] = 103 | ((task_base & 0xFFFFFF) << 16)
        | (0x89u64 << 40) | (((task_base >> 24) & 255) << 56);
    storage.gdt[4] = task_base >> 32;
    let table_base: u64 = address_of(&storage.gdt[0]) as u64;
    let desired: [u8; 10] = gdtr_bytes(39, table_base);
    asm { cli }
    asm clobbers r10 { lgdt &desired }

    let activated: bool = TaskRegisterControl::activate<5>(
        &mut storage.gdt, &storage.task_bytes, 24);
    activated && task_state_selected(storage)
}

public machine task_state_selected(storage: &TaskStateStorage) -> bool
requires addr::Bound == 18446744073709551616
reaches MachineControl + TaskRegisterControl
invokes TaskRegisterControl
{
    let selected: u16 = TaskRegisterControl::selector();
    let task_base: u64 = address_of(&storage.task_bytes[0]) as u64;
    let busy_descriptor: u64 = 103 | ((task_base & 0xFFFFFF) << 16)
        | (0x8Bu64 << 40) | (((task_base >> 24) & 255) << 56);
    selected == 24
        && storage.gdt[0] == 0
        && storage.gdt[1] == 0x00AF9B000000FFFF
        && storage.gdt[2] == 0x00CF93000000FFFF
        && storage.gdt[3] == busy_descriptor
        && storage.gdt[4] == (task_base >> 32)
        && storage.gdt_after == 0xBADC0FFEE0DDF00D
        && storage.before == 0x13579BDF2468ACE0
        && storage.after == 0xFEDCBA9876543210
}

machine gdtr_bytes(limit: u16, base: u64) -> [u8; 10] {
    [
        (limit & 255) as u8, (limit >> 8) as u8,
        (base & 255) as u8, ((base >> 8) & 255) as u8,
        ((base >> 16) & 255) as u8, ((base >> 24) & 255) as u8,
        ((base >> 32) & 255) as u8, ((base >> 40) & 255) as u8,
        ((base >> 48) & 255) as u8, (base >> 56) as u8
    ]
}

public InterruptedFatalCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 1 && !signature.has_result {
            true -> accept()
            _ -> reject()
        }
        machine accept() -> BoundaryPlanResult {
            let mut plan: BoundaryEntryPlan;
            plan.call.convention = CallingConvention::SystemVAMD64;
            plan.call.parameter_count = 1;
            plan.call.parameters[0].shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = ValueLocation::Register { register: MachineRegister::X86Rdi, value_byte_offset: 0, byte_size: 8 };
            plan.call.stack_alignment = 16;
            plan.call.entry_control = EntryControl::InterruptReturn;
            plan.state.initial_regime = MachineRegime::X86Long64;
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.permitted_transitive_use.instruction_pointer = true;
            plan.state.permitted_transitive_use.stack_pointer = true;
            plan.state.permitted_transitive_use.control_state = true;
            plan.state.stack = EntryStack::Interrupted;
            plan.state.preemption = Preemption::Masked;
            BoundaryPlanResult::Accepted { plan: plan }
        }
        machine reject() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "fatal entry requires its installed context and cannot return" } }
        }
    }
}

