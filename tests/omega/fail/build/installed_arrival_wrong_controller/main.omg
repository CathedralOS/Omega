public boundary trait BootstrapInterruptRegistrar: Calling<BootstrapInterruptRegistrarCalling> {
    machine install<machine Fatal00, machine Fatal01, machine Fatal02, machine Fatal03, machine Fatal04, machine Fatal05, machine Fatal06, machine Fatal07, machine Fatal08, machine Fatal09, machine Fatal10, machine Fatal11, machine Fatal12, machine Fatal13, machine Fatal14, machine Fatal15, machine Fatal16, machine Fatal17, machine Fatal18, machine Fatal19, machine Fatal20, machine Fatal21, machine Fatal22, machine Fatal23, machine Fatal24, machine Fatal25, machine Fatal26, machine Fatal27, machine Fatal28, machine Fatal29, machine Fatal30, machine Fatal31, machine Timer>(
        table: &mut BootstrapIdt, storage: &mut TaskStateStorage,
        context: &BootstrapInterruptContext, profile: &ProfileArrivalFrames
    ) -> bool
    requires machine Fatal00 satisfies FatalVector00::enter;
    requires machine Fatal01 satisfies FatalVector01::enter;
    requires machine Fatal02 satisfies FatalVector02::enter;
    requires machine Fatal03 satisfies FatalVector03::enter;
    requires machine Fatal04 satisfies FatalVector04::enter;
    requires machine Fatal05 satisfies FatalVector05::enter;
    requires machine Fatal06 satisfies FatalVector06::enter;
    requires machine Fatal07 satisfies FatalVector07::enter;
    requires machine Fatal08 satisfies FatalVector08::enter;
    requires machine Fatal09 satisfies FatalVector09::enter;
