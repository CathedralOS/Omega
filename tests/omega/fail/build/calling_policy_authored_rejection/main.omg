// A selected map whose member forwards to the plan machine is valid without a
// separate machine satisfaction edge. Its authored policy rejection still
// prevents boundary realization. The callee does not satisfy CallingPolicy::plan,
// and adding that edge would stop testing a plan map with no satisfaction edge.
use omega_language_std::calling;

data LocalPolicy { }
LocalPolicyCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult { LocalPolicy::plan(signature) }
}

machine LocalPolicy::plan(signature: BoundarySignature) -> BoundaryPlanResult {
    BoundaryPlanResult::Rejected {
        reason: CallingPolicyRejection { reason: "local" },
    }
}

boundary trait LocalEntry: Calling<LocalPolicyCalling> {
    machine enter(value: u64) -> u64 reaches;
}

machine main() {}
