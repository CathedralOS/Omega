machine build(builder: &mut Build) {
    Build::application(builder, "static_service_exclusion_relayed");
    Build::select_provider<left::Sink, left::QuietSink>(builder, linux_arm64);
    Build::select_provider<left::Sink, left::QuietSink>(builder, linux_x86_64);
    Build::select_provider<left::Sink, left::QuietSink>(builder, macos_arm64);
    Build::select_provider<left::Sink, left::QuietSink>(builder, macos_x86_64);
    Build::select_provider<left::Sink, left::QuietSink>(builder, windows_x86_64);
    Build::select_provider<left::Sink, left::QuietSink>(builder, uefi_x86_64);
    Build::select_provider<left::Sink, left::QuietSink>(builder, cross_platform_cli);
    Build::select_provider<left::Sink, left::QuietSink>(builder, local_unchecked);
    Build::select_provider<left::Sink, left::QuietSink>(builder, alpha_bootstrap);
    Build::select_provider<right::Sink, right::QuietSink>(builder, linux_arm64);
    Build::select_provider<right::Sink, right::QuietSink>(builder, linux_x86_64);
    Build::select_provider<right::Sink, right::QuietSink>(builder, macos_arm64);
    Build::select_provider<right::Sink, right::QuietSink>(builder, macos_x86_64);
    Build::select_provider<right::Sink, right::QuietSink>(builder, windows_x86_64);
    Build::select_provider<right::Sink, right::QuietSink>(builder, uefi_x86_64);
    Build::select_provider<right::Sink, right::QuietSink>(builder, cross_platform_cli);
    Build::select_provider<right::Sink, right::QuietSink>(builder, local_unchecked);
    Build::select_provider<right::Sink, right::QuietSink>(builder, alpha_bootstrap);
    configure(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}

machine configure(builder: &mut Build) {
    Build::exclude_service<left::Sink>(builder);
}
