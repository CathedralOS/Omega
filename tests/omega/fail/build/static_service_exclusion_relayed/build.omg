machine build(builder: &mut Build) {
    Build::application(builder, "static_service_exclusion_relayed");
    Build::select_provider<left::Sink, left::QuietSink>(builder);
    Build::select_provider<right::Sink, right::QuietSink>(builder);
    configure(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}

machine configure(builder: &mut Build) {
    Build::exclude_service<left::Sink>(builder);
}
