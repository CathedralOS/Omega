// FAIL CANARY -- the query's slot owner names no target profile. The slot
// string is a locator for a declared target's root slot, not free text, so
// the query rejects before any binding exists.
machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_query_unknown_target");
    let entry: ProductEntryRef = builder.product.entry("launch", "unknown_target::ProgramEntry");
    builder.roots.bind(windows_x86_64::ProgramEntry, entry);
}
