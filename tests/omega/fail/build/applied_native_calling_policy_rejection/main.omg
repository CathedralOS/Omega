// A natively bound application of a generic boundary is still called through
// the boundary's declared calling policy. build.omg binds `Magnitude<i32>::of`
// to msvcrt `abs`; `Magnitude<Value>` declares `Calling<LocalPolicyCalling>`,
// and that policy rejects every signature, so the build must be refused with
// the policy's own reason. Before the policy was evaluated for a native
// application, this program was accepted and called `abs` through the target
// default. Without the `Calling` relationship it is
// pass/capabilities/windows_applied_requirement_import_exit.
use omega_language_std::Console;
use omega_language_std::BoundarySignature;
use omega_language_std::CallingPolicyRejection;
use omega_language_std::BoundaryPlanResult;
use omega_language_std::CallingPolicy;
use omega_language_std::Calling;
public data LocalPolicy { }
public LocalPolicyCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult { LocalPolicy::plan(signature) }
}
machine LocalPolicy::plan(signature: BoundarySignature) -> BoundaryPlanResult {
    BoundaryPlanResult::Rejected {
        reason: CallingPolicyRejection { reason: "local" },
    }
}
public boundary trait Magnitude<Value>: Calling<LocalPolicyCalling> { machine of(value: i32) -> i32 reaches; }
data Main { m: i32; v: i32; }
machine Main::main(main: &mut Main) reaches Magnitude + Console {
    main.v = 0 - 42;
    main.m = Magnitude<i32>::of(main.v);
    transition main.m == 42 { true -> good(main) _ -> bad(main, 71) }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Magnitude + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
