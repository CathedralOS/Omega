machine build(builder: &mut Build) {
    Build::package(builder, "generated_declarations");
    let source: BuildPath = BuildSource::resolve(&builder.source, "generated.txt");
    let reader: i32 = BuildSource::open(&builder.source, source, 0);
    let mut bytes: [u8; 526];
    _ = BuildSource::read(&builder.source, reader, &mut bytes, 526);
    _ = BuildSource::close(&builder.source, reader);
    let output: BuildPath = BuildOutput::resolve(&builder.output, "generated.omg");
    let writer: i32 = BuildOutput::create(&mut builder.output, output, 0);
    _ = BuildOutput::write(&mut builder.output, writer, &bytes);
    _ = BuildOutput::close(&mut builder.output, writer);
    BuildOutput::include_source(&mut builder.output, output);
}
