// Expected exit: 0
module main;
use kit::generated::answer;

// Generated code in this package reads this authored seed. The earlier main
// keeps its exact imported answer rather than seeing the later local answer.
machine seed() -> u64 { 7u64 }

machine main() crashes Trap {
    let observed: u64 = answer();
    transition observed == 6u64 {
        true -> passed()
        _ -> failed()
    }
    state passed() {}
    state failed() { crash Trap; }
}
