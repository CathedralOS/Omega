// The build.omg protocol is EXACTLY `machine build(b: &mut Build)` -- one
// parameter. A second parameter has no build-time argument to bind, so the
// shared project-entry projection rejects before build-time evaluation (never
// silently ZII the extra parameter).
use omega::language::std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) {
    self.console.exit_process(0);
}
