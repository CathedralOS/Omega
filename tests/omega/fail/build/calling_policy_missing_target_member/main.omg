// A selected named policy map owns a target-family contract, not permission to
// execute another deployment's body when the chosen deployment has no member.
use omega_language_std::calling;

data TargetPolicy {}
TargetPolicyCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        TargetPolicy::plan(signature)
    }
}

macos_arm64 machine TargetPolicy::plan(signature: BoundarySignature) -> BoundaryPlanResult 
    satisfies CallingPolicy::plan
{
    BoundaryPlanResult::Rejected {
        reason: CallingPolicyRejection { reason: "unselected member" },
    }
}

boundary trait LocalEntry: Calling<TargetPolicyCalling> {
    machine enter(value: u64) -> u64 reaches;
}

machine main() {}
