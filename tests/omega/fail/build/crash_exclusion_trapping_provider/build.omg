// Trap is excluded from the product while the selected assertion provider is
// the checking implementation, whose failing branch traps: the exclusion must
// reject even though the asserted condition holds. ControlFlowCleanup is
// enabled to show the optional optimization does not decide the verdict.
machine build(builder: &mut Build) {
    Build::application(builder, "crash_exclusion_trapping_provider");
    Build::depend(builder, Source::Path { location: "../../../packages/assert-kit" });
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::CheckingAssertProvider>(builder);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
