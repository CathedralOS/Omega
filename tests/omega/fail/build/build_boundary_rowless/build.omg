// FAIL CANARY -- build.omg calls a custom runtime boundary trait. Build-time
// authority comes only from compiler-owned Build facets; no runtime boundary
// service is a staging service.
boundary trait BuildLog { machine write_line(text: &[u8]); }

data Logger {
    log: BuildLog;
}

machine configure_log(builder: &mut Build)
reaches
    BuildLog
{
    let mut logger: Logger;
    logger.log.write_line("configuring");
    builder.freestanding = false;
}

machine build(builder: &mut Build)
reaches
    Console
{
    builder.application("build-boundary-rowless");
    configure_log(builder);
}
