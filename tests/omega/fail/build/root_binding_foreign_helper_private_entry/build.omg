// FAIL CANARY -- a build-dependency helper borrows the root Build and binds
// the owner's private `launch` as a static product operand. The operand
// resolves in the product context of the package that authored the
// `roots.bind` statement, so the helper cannot name its caller's entry.
use support::configure;

machine build(builder: &mut Build) {
    Build::application(builder, "root_binding_foreign_helper_private_entry");
    Build::build_depend_as(builder, "support", Source::Path { location: "helper" });
    configure::configure(builder);
}
