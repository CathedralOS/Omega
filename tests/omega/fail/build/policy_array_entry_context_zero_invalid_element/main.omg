// Peeling an arithmetic policy from a context array reaches the element's
// own zero judgment; it does not excuse it. A Slot whose level range
// excludes zero cannot inhabit zero storage, so the hosted context is not
// provisioned even though the array's own policy constrains nothing.
data Slot [copy] where level >= 1 && level <= 3 {
    level: u8;
}

data Main {
    slots: [Slot; 2] in Trapping;
}

machine Main::main(main: &mut Main) {
    main.slots[0] = Slot { level: 2 };
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
