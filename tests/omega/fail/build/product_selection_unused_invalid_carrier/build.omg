machine build(builder: &mut Build) { Build::application(builder, "unused_invalid_selection"); Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::bind(builder, macos_arm64::ProgramEntry, main); }
machine unused(builder: &mut Build) { Build::select_representation<Token, TokenRepresentation>(builder); }
