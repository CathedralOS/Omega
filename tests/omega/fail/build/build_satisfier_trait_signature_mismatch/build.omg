// Retaining the described trait must preserve its signature checking.
public data HostRoot {}
boundary machine HostRoot::grant(root: i32) -> Extent
satisfies ExtentRootProvider::grant;

machine build(builder: &mut Build) {
    Build::package(builder, "build_satisfier_trait_signature_mismatch");
    Build::select_provider<ExtentRootProvider, Root>(builder, linux_arm64);
    Build::select_provider<ExtentRootProvider, Root>(builder, linux_x86_64);
    Build::select_provider<ExtentRootProvider, Root>(builder, macos_arm64);
    Build::select_provider<ExtentRootProvider, Root>(builder, macos_x86_64);
    Build::select_provider<ExtentRootProvider, Root>(builder, windows_x86_64);
    Build::select_provider<ExtentRootProvider, Root>(builder, uefi_x86_64);
    Build::select_provider<ExtentRootProvider, Root>(builder, cross_platform_cli);
    Build::select_provider<ExtentRootProvider, Root>(builder, local_unchecked);
    Build::select_provider<ExtentRootProvider, Root>(builder, alpha_bootstrap);
}
