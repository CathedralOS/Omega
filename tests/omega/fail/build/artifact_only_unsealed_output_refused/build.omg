// The sealing control for
// `artifact_only_required_output_completion`: the same artifact-only
// build with the `close` that retires the writer removed, so `manifest.txt`
// still has a live writer when the build asks to complete its obligation.
//
// `complete` cannot accept an open writer, so it returns
// `OutputCompletion::Retry` with the obligation and the file custody handed
// back. The build's only disposition for the returned obligation is the
// authored `fail`, whose failure is sticky: the activation can never publish a
// successful product set, and the artifact-only mode's required-output demand
// is therefore unmet.

machine build(builder: &mut Build) {
    Build::application(builder, "artifact_only_unsealed_output_refused");
    Build::artifact_only(builder);
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "manifest.txt");
    let path: BuildPath = BuildOutput::resolve(&builder.output, "manifest.txt");
    let descriptor: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, descriptor, "omega artifact\n");
    let settled: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, path);
    settle(builder, settled);
}

machine settle(builder: &mut Build, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> unsealed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {
    }
    // The obligation is linear: the retry arm has to dispose of it, and a
    // sticky failure is the only disposition this build can offer.
    machine unsealed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "staged output never sealed");
    }
}
