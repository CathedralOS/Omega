machine build(builder: &mut Build) {
    Build::application(builder, "uefi_physical_entry_excluded_crash");
    Build::depend(builder, Source::Path { location: "vendor" });
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_arm64);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_x86_64);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_arm64);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_x86_64);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, windows_x86_64);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, uefi_x86_64);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, cross_platform_cli);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, local_unchecked);
    Build::select_provider<vendor::UefiPhysicalEntry, FirmwareBootstrap>(builder, alpha_bootstrap);
    Build::bind(builder, uefi_x86_64::ProgramEntry, kernel_entry);
    Build::exclude_crash(builder, CrashCause::Trap);
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}
