use omega::language::core::StaticInterruptCompletionPermit;
machine build(builder: &mut Build) {
    Build::application(builder, "installed_arrival_without_context");
    builder.freestanding = true;
    let mut std_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../../../../source/library/std" });
    dependency::with_alias(&mut std_dependency, "std");
    let std_registration: DependencyRegistration = Build::dependency(builder, std_dependency);
    Build::select_representation<InterruptAcknowledgement, CathedralAcknowledgementRepresentation>(builder);
    Build::select_representation<StaticInterruptCompletionPermit, StaticInterruptCompletionPermitRepresentation>(builder);
    Build::select_provider<BootstrapInterruptRegistrar, CheckedBootstrapInterruptRegistrar>(builder, linux_x86_64);
    Build::select_provider<TaskStatePreparation, BootstrapTaskStatePreparation>(builder, linux_x86_64);
    Build::accept_boundary<TaskRegisterControl>(builder);
    Build::select_provider<TaskRegisterControl, X86TaskRegisterControl>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, start);
}
