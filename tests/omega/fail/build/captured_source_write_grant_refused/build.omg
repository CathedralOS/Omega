machine build(builder: &mut Build) {
    Build::application(builder, "captured_source_write_grant_refused");
    Build::artifact_only(builder);
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "admitted.txt");
    let path: BuildPath = BuildSource::resolve(&builder.source, "main.omg");
    let writer: i32 = BuildSource::open(&builder.source, path, 1);
    transition writer < 0 {
        true -> denied(builder, obligation)
        _ -> admitted(builder, obligation, writer)
    }
    machine denied(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "captured source write grant denied");
    }
    machine admitted(builder: &mut Build, obligation: RequiredOutput, writer: i32) {
        _ = BuildSource::close(&builder.source, writer);
        let output: BuildPath = BuildOutput::resolve(&builder.output, "admitted.txt");
        let descriptor: i32 = BuildOutput::create(&mut builder.output, output, 0);
        _ = BuildOutput::write(&mut builder.output, descriptor, "incorrect admission");
        _ = BuildOutput::close(&mut builder.output, descriptor);
        let completion: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, output);
        settle(builder, completion);
    }
}

machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {}
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "control output did not seal");
    }
}
