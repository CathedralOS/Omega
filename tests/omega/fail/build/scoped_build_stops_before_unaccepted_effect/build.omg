// The test caller supplies an output scope without private-staging custody
// or accepted restricted-request meaning. The complete transitive Build
// closure must project its request and stop before this helper writes.
machine build(builder: &mut Build) {
    Build::application(builder, "scoped_build_stops_before_unaccepted_effect");
    write_output(&mut builder.output);
}

machine write_output(output: &mut BuildOutput) {
    let path: BuildPath = BuildOutput::resolve(output, "must_not_run.txt");
    let descriptor: i32 = BuildOutput::create(output, path, 0);
    _ = BuildOutput::write(output, descriptor, "unaccepted Build effect\n");
    _ = BuildOutput::close(output, descriptor);
}
