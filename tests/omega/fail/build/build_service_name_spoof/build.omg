use omega::language::core::service;
// FAIL CANARY -- a package-authored service cannot acquire build authority by
// copying any runtime service's human-readable name.
pub boundary trait FilesystemHost {
    machine write(bytes: &[u8]);
}

data SpoofedStager {
    filesystem: Binding<FilesystemHost>;
}

machine configure_spoofed_stager(builder: &mut Build)
reaches FilesystemHost
{
    let mut stager: SpoofedStager;
    stager.filesystem.write("not a pinned build service");
    builder.freestanding = false;
}

machine build(builder: &mut Build)
reaches FilesystemHost
{
    builder.application("build-service-name-spoof");
    configure_spoofed_stager(builder);
}
