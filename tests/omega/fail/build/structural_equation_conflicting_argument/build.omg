machine capacity<Storage, const Capacity: u64>() -> u64
where Storage == [u8; Capacity]
{ Capacity }

machine selected_helper() -> u64 {
    // Explicit arguments are fixed; inference cannot overwrite 7 with 8.
    capacity<[u8; 8], 7>()
}

machine build(builder: &mut Build) {
    Build::package(builder, "structural_equation_conflicting_argument");
    let invalid: u64 = selected_helper();
}
