// The same ABI width is requested explicitly through Calling, so the retained
// projection refusal must be consumed before the policy can run.
use omega_language_std::calling;
RefusePolicy satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "unexpected policy execution" }
        }
    }
}
