machine build(builder: &mut Build) {
    Build::application(builder, "staging_overwrite_refused");
    Build::artifact_only(builder);
    let path: BuildPath = BuildOutput::resolve(&builder.output, "sealed.txt");
    let writer: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, writer, "retained bytes");
    _ = BuildOutput::close(&mut builder.output, writer);
    let replacement: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, replacement, "replacement bytes");
    _ = BuildOutput::close(&mut builder.output, replacement);
}
