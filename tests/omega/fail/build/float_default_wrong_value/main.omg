// Expected exit: 0.
// IEEE implication uses selected meaning, subject identity, format and strictness.
trait Small32 { machine get() -> f32 ensures result >= 0.0f32 && result <= 0.5f32; }
Reverse32 satisfies Small32 {
    machine get() -> f32 ensures 0.25f32 <= result && 0.25f32 >= result { 0.25f32 }
}
const UNUSED: dyn Small32 = Reverse32 as dyn Small32;
trait Zero { machine get() -> f64 ensures result >= 0.0 && result <= 0.0; }
NegativeZero satisfies Zero {
    machine get() -> f64 ensures result == -0.0 { -0.0 }
}
trait Rounded32 { machine get() -> f32 ensures result <= 16777216.0f32; }
Rounded satisfies Rounded32 {
    machine get() -> f32 ensures result <= 16777217.0f32 { 16777217.0f32 }
}
trait Interval {
    machine get(value: f64) -> f64
    requires value >= 0.25 && value <= 0.25
    ensures result >= 0.0 && result <= 0.5;
}
WeakerInput satisfies Interval {
    machine get(input: f64) -> f64
    requires input >= 0.0 && input <= 0.5
    ensures result > 0.0 && result < 0.5
    { 0.25 }
}
trait Generic<T> { machine get() -> f64; }
GenericQuarter satisfies Generic<f64> { machine get() -> f64 { 0.25 } }
const CLOSED: dyn Generic<f64> = GenericQuarter as dyn Generic<f64>;
machine integral(value: u64) -> u64 { value }
machine rounded_input(value: f32) -> f32 { value }
machine main() crashes Trap {
    let small: dyn Small32 = Reverse32 as dyn Small32;
    let zero: dyn Zero = NegativeZero as dyn Zero;
    let rounded: dyn Rounded32 = Rounded as dyn Rounded32;
    let interval: dyn Interval = WeakerInput as dyn Interval;
    let first: f32 = Small32::get(small);
    let second: f64 = Zero::get(zero);
    let third: f32 = Rounded32::get(rounded);
    let fourth: f64 = Interval::get(interval, 0.25);
    let fifth: f64 = Generic::get(CLOSED);
    let sixth: u64 = integral(2.0);
    let seventh: f32 = rounded_input(16777217.0);
    transition seventh == 16777216.0f32 && sixth == 2 && fifth == 0.25 && first == 0.25f32 && second == 0.0 && third == 16777216.0f32 && fourth == 0.25 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
