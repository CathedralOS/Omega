machine build(builder: &mut Build) {
 Build::application(builder, "numeric_invocation_ordinary_override");
 Build::bind(builder, windows_x86_64::ProgramEntry, main);
 Build::select_provider<F32IsNan, CheckedNan>(builder, windows_x86_64);
 Build::bind(builder, linux_x86_64::ProgramEntry, main);
 Build::select_provider<F32IsNan, CheckedNan>(builder, linux_x86_64);
 Build::bind(builder, macos_arm64::ProgramEntry, main);
 Build::select_provider<F32IsNan, CheckedNan>(builder, macos_arm64);
 Build::bind(builder, linux_arm64::ProgramEntry, main);
 Build::select_provider<F32IsNan, CheckedNan>(builder, linux_arm64);
 Build::bind(builder, macos_x86_64::ProgramEntry, main);
 Build::select_provider<F32IsNan, CheckedNan>(builder, macos_x86_64);
}
