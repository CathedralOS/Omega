public data Cell { number: u64; }
public boundary trait Echo {
 machine echo(home: &mut Cell) -> u64 reaches
 requires home.number > 0
 ensures result == home.number;
}
machine view(value: u64) -> u64 requires value > 0 ensures result == value { value }
EchoProvider satisfies Echo {
 machine echo(home: &mut Cell) -> u64
 requires home.number > 0
 ensures result == view(home.number)
 { home.number = 0; 0u64 }
}
machine main() {}
