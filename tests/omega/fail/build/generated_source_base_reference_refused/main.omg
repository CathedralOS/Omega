use omega_language_std::console;

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    transition ANSWER == 73 {
        true -> correct(main)
        _ -> incorrect(main)
    }
    state correct(main: &mut Main) { Console::exit_process(73); }
    state incorrect(main: &mut Main) { Console::exit_process(74); }
}
