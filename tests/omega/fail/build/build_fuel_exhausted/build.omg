machine build(builder: &mut Build) {
    Build::application(builder, "build_fuel_exhausted");
    Build::artifact_only(builder);
    let obligation: RequiredOutput = BuildOutput::require(&mut builder.output, "output.txt");
    let path: BuildPath = BuildOutput::resolve(&builder.output, "output.txt");
    let writer: i32 = BuildOutput::create(&mut builder.output, path, 0);
    _ = BuildOutput::write(&mut builder.output, writer, "four");
    _ = BuildOutput::close(&mut builder.output, writer);
    let completion: OutputCompletion = BuildOutput::complete(&mut builder.output, obligation, path);
    settle(builder, completion);
}

machine settle(builder: &mut Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder)
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: &mut Build) {}
    machine failed(builder: &mut Build, obligation: RequiredOutput) {
        BuildOutput::fail(&mut builder.output, obligation, "output did not seal");
    }
}
