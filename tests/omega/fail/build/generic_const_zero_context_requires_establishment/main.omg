// Static arguments are not fields in the zero image. The first application
// admits zero; its answer cannot certify another application of the same owner.
data Gate<const Number: u64> where Number == 0 {
    code: u8;
}

// Independently named method binders leave application preparation to typed Psi.
machine Gate::inspect<const Selected: u64>(gate: &Gate<Selected>) {}

data Context {
    admitted: Gate<0>;
    refused: Gate<2>;
}

machine main(context: &mut Context) {}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
