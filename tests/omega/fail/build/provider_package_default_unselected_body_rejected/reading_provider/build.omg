machine build(builder: &mut Build) {
    Build::package(builder, "reading_provider");
    Build::select_provider<Reading, FirstReading>(builder, windows_x86_64);
    Build::select_provider<Reading, FirstReading>(builder, linux_x86_64);
    Build::select_provider<Reading, SecondReading>(builder, macos_arm64);
    Build::select_provider<Reading, SecondReading>(builder, linux_arm64);
}
