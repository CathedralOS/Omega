machine build(builder: &mut Build) {
    Build::application(builder, "boundary_simultaneous_type_frame");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Shape<U, u64>, SelectedShape>(builder, macos_arm64);
    Build::select_provider<Shape<U, u64>, SelectedShape>(builder, linux_arm64);
    Build::select_provider<Shape<U, u64>, SelectedShape>(builder, windows_x86_64);
    Build::select_provider<Shape<U, u64>, SelectedShape>(builder, linux_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
