// FAIL CANARY -- the query names a slot the target profile does not declare.
// A description is issued only against an actual required root slot, so the
// query rejects before any binding exists.
machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_query_undeclared_slot");
    let entry: ProductEntryRef = BuildProduct::entry(&builder.product, "launch", "windows_x86_64::UndeclaredEntry");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry);
}
