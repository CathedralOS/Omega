// Expected rejection: the selected nonreturning ProcessExit service is reachable.
// An ordinary scalar-declared call exits before its receiving local exists.
use omega::language::core::process_exit;
use omega_language_std::process_exit;

machine stop_scalar() -> u64 reaches ProcessExit {
    ProcessExit::exit_process(0);
}
machine main() reaches ProcessExit {
    let absent: u64 = stop_scalar();
    ProcessExit::exit_process(43);
}
