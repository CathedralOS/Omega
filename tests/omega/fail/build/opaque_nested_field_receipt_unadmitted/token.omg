use omega::language::core::representation;

public boundary data Token [copy];
public data TokenBytes [copy] {
    value: u64;
}
public TokenRepresentation satisfies OpaqueRepresentation<Token, TokenBytes> { }

// An ordinary record nested in the Build context still fields the opaque: its
// `[copy]` claim needs a settled receipt that cannot exist before selection.
public data TokenPair {
    quotient: Token;
    remainder: Token;
}
