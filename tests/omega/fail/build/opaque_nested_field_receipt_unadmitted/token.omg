use omega::language::core::representation;

pub boundary data Token [copy];
pub data TokenBytes [copy] {
    value: u64;
}
pub TokenRepresentation satisfies OpaqueRepresentation<Token, TokenBytes> { }

// An ordinary record nested in the Build context still fields the opaque: its
// `[copy]` claim needs a settled receipt that cannot exist before selection.
pub data TokenPair {
    quotient: Token;
    remainder: Token;
}
