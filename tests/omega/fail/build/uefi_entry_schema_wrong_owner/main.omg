use omega::language::core::extent;
use forged::targets::uefi_x86_64::entry;

machine launch(image: Extent in Granted, storage: Extent in Granted) {
    transition { _ -> retain(image as Extent, storage as Extent) }
    machine retain(image: Extent, storage: Extent) {
        transition { _ -> retain(image, storage) }
    }
}
