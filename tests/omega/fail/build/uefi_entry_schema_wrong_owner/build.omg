machine build(builder: &mut Build) {
    Build::application(builder, "uefi_entry_schema_wrong_owner");
    Build::depend(builder, Source::Path { location: "forged" });
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
    Build::bind(builder, uefi_x86_64::ProgramEntry, launch);
}
