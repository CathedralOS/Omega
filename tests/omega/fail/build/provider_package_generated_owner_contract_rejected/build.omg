machine build(builder: &mut Build) {
    Build::application(builder, "build_target_provider_generated_dependency");
    let reading_provider_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "reading_provider" }));
    let reading_implementations_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "reading_provider/reading_implementations" }));
    Build::bind(builder, windows_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, first_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, second_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, second_entry);
}
