machine build(builder: &mut Build) {
    Build::application(builder, "component_assumption_policy_missing");
    builder.privileged_services.port_io = true;
    Build::depend_as(builder, "mechanism", Source::Path { location: "../../../pass/build/component_assumption_policy_accepted/mechanism" });
    Build::select_provider<mechanism::Signal, mechanism::Serial>(builder, linux_x86_64, CompositionMode::Independent);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
