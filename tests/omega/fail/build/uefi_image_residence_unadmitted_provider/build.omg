machine build(builder: &mut Build) {
    Build::application(builder, "uefi_image_residence_unadmitted_provider");
    let mut std_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../../../../source/library/std" });
    dependency::with_alias(&mut std_dependency, "std");
    let std_registration: DependencyRegistration = Build::dependency(builder, std_dependency);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_arm64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, linux_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_arm64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, macos_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, windows_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, uefi_x86_64);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, cross_platform_cli);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, local_unchecked);
    Build::select_provider<std::UefiPhysicalEntry, FirmwareBootstrap>(builder, alpha_bootstrap);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, linux_arm64);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, linux_x86_64);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, macos_arm64);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, macos_x86_64);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, windows_x86_64);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, uefi_x86_64);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, cross_platform_cli);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, local_unchecked);
    Build::select_provider<ProgramImage, UnadmittedImageProvider>(builder, alpha_bootstrap);
    Build::select_representation<std::EfiSystemTable, SystemTableRepresentation>(builder);
    Build::bind(builder, uefi_x86_64::ProgramEntry, kernel_entry);
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}
