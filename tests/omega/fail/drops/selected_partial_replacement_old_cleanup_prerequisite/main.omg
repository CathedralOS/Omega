// The new field cannot establish the skipped old field's hook prerequisite.
data Token { ready: bool; }
data Pair { first: Token; second: Token; }
machine Token::drop(token: &mut Token) requires token.ready {}
machine prepare(token: &mut Token) ensures token.ready { token.ready = true; }
machine consume(token: Token) -> bool {
    let mut owned: Token = token;
    prepare(&mut owned);
    true
}
machine choose(enabled: bool) {
    let mut pair: Pair = Pair { first: Token { ready: false }, second: Token { ready: true } };
    let observed: bool = enabled && consume(pair.first);
    pair.first = Token { ready: true };
}
machine main() { choose(false); }
