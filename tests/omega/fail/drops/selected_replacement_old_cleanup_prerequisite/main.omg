// A valid replacement cannot justify dropping the skipped old occurrence.
data Token { ready: bool; }
machine Token::drop(token: &mut Token) requires token.ready {}
machine prepare(token: &mut Token) ensures token.ready { token.ready = true; }
machine consume(token: Token) -> bool {
    let mut owned: Token = token;
    prepare(&mut owned);
    true
}
machine choose(enabled: bool) {
    let mut token: Token = Token { ready: false };
    let observed: bool = enabled && consume(token);
    token = Token { ready: true };
}
machine main() { choose(false); }
