data Receipt [linear] { value: u64; }
machine Receipt::drop(receipt: &mut Receipt) { receipt.value = 0; }
data OptionalReceipt {
    ready: bool;
    case Empty;
    case Held(receipt: Receipt);
}
machine OptionalReceipt::drop(owner: &mut OptionalReceipt)
requires owner.ready
{}
machine main() {
    let owner: OptionalReceipt;
}
