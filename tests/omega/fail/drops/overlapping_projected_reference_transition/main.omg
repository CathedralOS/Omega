use omega_language_std::console;

data Leaf { value: i32; }
data View { body: &mut Leaf; }
data Outer { leftover: Leaf; selected: View; }
data Main { value: Leaf; }

machine exercise(input: Outer) -> i32 {
    transition { _ -> finish(input.selected, input.selected) }
    state finish(first: View, second: View) -> i32 { first.body.value }
}

machine Main::main(main: &mut Main) reaches Console {
    main.value.value = 29;
    let input: Outer = Outer {
        leftover: Leaf { value: 7 }, selected: View { body: &mut main.value }
    };
    let observed: i32 = exercise(input);
    Console::exit_process(observed);
}
