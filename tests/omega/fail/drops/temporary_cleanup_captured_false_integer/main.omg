data Token { value: u64; marker: u64; }
machine Token::drop(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}
machine replace(source: &mut u64) -> u64 { source = 7; 0 }
machine read(token: &Token) -> u64 { token.value }
machine main() -> u64 {
    let mut source: u64 = 8;
    read(&Token { value: source, marker: replace(&mut source) })
}
