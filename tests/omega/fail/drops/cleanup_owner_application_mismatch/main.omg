data Reversed<'left, 'right> dropped by release_reversed<'left, 'right> {
    left: &'left i32;
    right: &'right i32;
}
machine release_reversed<'left, 'right>(value: &mut Reversed<'right, 'left>) {}

data Specialized<const Count: u64> dropped by release_specialized<Count> { values: [u8; Count]; }
machine release_specialized<const Count: u64>(value: &mut Specialized<7>) {}

machine main() {}
