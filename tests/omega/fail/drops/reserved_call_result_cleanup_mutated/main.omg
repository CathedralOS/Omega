domain u64::Positive requires 1 <= self;
data Token dropped by drop_token { value: u64 in Positive; }
data Holder<T> { value: T; }
machine drop_token(token: &mut Token) requires token.value == 42 { token.value = 1; }
machine token() -> Token ensures result.value == 42 { Token { value: 42 } }
machine main() {
    let mut holder: Holder<Token>;
    holder.value = token();
    holder.value.value = 43;
}
