// Erasure cannot turn a semantic linear obligation into trivial runtime cleanup.
data Evidence [linear] { case Only; }
data Event {
    proof [erased]: Evidence;
    case Present(value: i32);
}
machine observe(event: &Event) -> i32 { 7 }
machine main() {
    let observed: i32 = observe(Event::Present { value: 7 });
}
