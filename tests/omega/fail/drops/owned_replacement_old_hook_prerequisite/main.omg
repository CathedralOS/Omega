data Token dropped by drop_token { value: u64; }

machine drop_token(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}

machine main() {
    let mut token: Token = Token { value: 8 };
    // The new value's valid cleanup cannot justify disposing the old one.
    token = Token { value: 7 };
}
