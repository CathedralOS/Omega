data Token { value: u64; }

machine Token::drop(token: &mut Token) {
    transition { _ -> finish(token) }
    machine finish(token: &mut Token) { token.value = 0; }
}

machine main() {
    let mut token: Token = Token { value: 7 };
    // Only transitions inside the executing hook may select its own states.
    transition { _ -> Token::drop::finish(&mut token) }
}
