data Receipt [linear] { value: u64; }
data Owner { first: Receipt; second: Receipt; }

machine Receipt::drop(receipt: &mut Receipt)
requires receipt.value == 9
{
    receipt.value = 0;
}

machine Owner::drop(owner: &mut Owner)
requires owner.first.value == 7 && owner.second.value == 13
ensures owner.first.value == owner.second.value && owner.second.value == 9
{
    owner.first.value = 9;
    owner.second.value = 9;
}

machine inspect(owner: &Owner) -> bool {
    owner.first.value == 7 && owner.second.value == 13
}

machine main() crashes Trap {
    let observed: bool = inspect(Owner {
        first: Receipt { value: 7 },
        second: Receipt { value: 13 }
    });
    transition observed {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
