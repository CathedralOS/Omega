data Token dropped by drop_token { ready: bool; value: u64; }
machine drop_token(token: &mut Token)
requires token.ready && token.value == 7
{ token.ready = false; }
machine retire<T>(value: T) {}
machine forward<T>(value: T) { retire(value); }
machine main() {
    let token: Token = Token { ready: true, value: 8 };
    forward(token);
}
