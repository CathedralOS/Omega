data Seed [copy] { code: u64; }
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) requires receipt.code == 7 {}
data Pair { first: Receipt; second: Receipt; }
machine Pair::drop(pair: &mut Pair) {}
machine observe(receipt: &Receipt) {}
machine produced() -> Seed ensures result.code == 7 { Seed { code: 7 } }
machine clear(seed: &mut Seed) -> Receipt {
    seed.code = 0;
    Receipt { code: 7 }
}
machine change(receipt: &mut Receipt) { receipt.code = 0; }
machine main() {
    let seed: Seed = produced();
    let mut pair: Pair = Pair {
        first: Receipt { code: 7 }, second: Receipt { code: seed.code }
    };
    change(&mut pair.second);
    observe(&pair.second);
}
