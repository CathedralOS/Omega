data Room dropped by drop_room { count: u32 in Wrapping; }
machine drop_room(room: &mut Room) requires room.count == 10 { room.count = 99; }
machine main() {
 let mut room: Room = Room { count: 10 };
 transition { _ -> first(&mut room) }
 machine first(room: &mut Room) { transition { _ -> second(room) } }
 machine second(room: &mut Room) { transition { _ -> last(room) } }
 machine last(room: &mut Room) { room.count = 11; }
}
