// FAIL canary: the executable cleanup slice admits only zero-argument
// calls in a `drop` body. Calling `Teardown::unlock(7)` exercises the
// call-arguments arm of the slice recognizer and must reject with the
// same fence diagnostic as every other non-slice shape.

data Guard {
    handle: i32;
}

data Teardown {
}

machine Teardown::unlock(code: i32) {
}

machine Guard::drop(&mut self) {
    Teardown::unlock(7);
}

data Main {
}

machine Main::main(&mut self) {
    let g: Guard = Guard { handle: 7 };
}
