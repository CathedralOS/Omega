data Token dropped by drop_token { value: u64; ready: bool; }
data Owner dropped by drop_owner { token: Token; }

machine drop_token(token: &mut Token)
requires token.value == 9 && token.ready
{
    token.value = 0;
    token.ready = false;
}

machine drop_owner(owner: &mut Owner) {
    // The earlier selected hook's transitive writes retire the call guarantee.
    revise(&mut owner.token);
}

machine revise(token: &mut Token) {
    token.value = 8;
}

machine prepare(token: &mut Token)
ensures token.value == 9 && token.ready
{
    token.value = 9;
    token.ready = true;
}

machine main() {
    let mut owner: Owner = Owner { token: Token { value: 7, ready: false } };
    prepare(&mut owner.token);
}
