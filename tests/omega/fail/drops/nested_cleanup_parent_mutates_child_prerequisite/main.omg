data Token { value: u64; }
data Owner { token: Token; }

machine Token::drop(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}

machine Owner::drop(owner: &mut Owner) {
    // Parent cleanup runs first. Its write invalidates the following child's
    // prerequisite; the child's old value cannot prove that later obligation.
    owner.token.value = 8;
}

machine main() {
    let owner: Owner = Owner { token: Token { value: 7 } };
    transition { _ -> done() }
    machine done() {}
}
