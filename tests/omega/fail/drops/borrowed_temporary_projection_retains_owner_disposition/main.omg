data Receipt [linear] dropped by drop_receipt { code: u64; }
data Pending [linear] { code: u64; }

machine drop_receipt(receipt: &mut Receipt) {}

data Pair dropped by drop_pair { first: Receipt; second: Pending; }
machine drop_pair(pair: &mut Pair) {}

machine inspect(receipt: &Receipt) -> u64 { receipt.code }

machine main() {
    let observed: u64 = inspect(Pair {
        first: Receipt { code: 7 },
        second: Pending { code: 13 }
    }.first);
}
