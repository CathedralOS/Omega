data Receipt [linear] { code: u64; }
data Pending [linear] { code: u64; }

machine Receipt::drop(receipt: &mut Receipt) {}

data Pair { first: Receipt; second: Pending; }
machine Pair::drop(pair: &mut Pair) {}

machine inspect(receipt: &Receipt) -> u64 { receipt.code }

machine main() {
    let observed: u64 = inspect(Pair {
        first: Receipt { code: 7 },
        second: Pending { code: 13 }
    }.first);
}
