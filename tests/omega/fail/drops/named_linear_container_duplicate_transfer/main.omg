data Receipt [linear] dropped by drop_receipt { code: u64; }
data Envelope { receipt: Receipt; }
machine drop_receipt(receipt: &mut Receipt) { receipt.code = 0; }
machine consume(receipt: Receipt) {}
machine main() {
    let envelope: Envelope = Envelope { receipt: Receipt { code: 13 } };
    consume(envelope.receipt);
    consume(envelope.receipt);
}
