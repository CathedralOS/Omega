data Child dropped by drop_child { value: u64; ready: bool; }
data Element dropped by drop_element { child: Child; }

machine drop_child(child: &mut Child)
requires child.value == 9 && child.ready
{
    child.value = 0;
    child.ready = false;
}

machine drop_element(element: &mut Element)
requires element.child.value == 9 && element.child.ready
ensures element.child.value == 9 && element.child.ready
{}

machine select() -> u64 ensures result == 0 { 0 }

machine replace(elements: &mut [Element])
requires elements.len >= 3,
    elements[0].child.value == 9, elements[0].child.ready,
    elements[1].child.value == 4, elements[1].child.ready
{
    let tail: &mut [Element] = &mut elements[1..3];
    tail[select()] = Element { child: Child { value: 9, ready: true } };
}

machine main() {}
