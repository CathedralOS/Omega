// The callee displaces a value whose automatic cleanup writes counter.drops
// through the loan it held; the caller's fact must not survive that call.
data Counter { drops: u64 in Wrapping; }
data AffineLeaf<'storage> dropped by drop_affine_leaf<'storage> { counter: &'storage mut Counter; }
machine drop_affine_leaf<'storage>(leaf: &mut AffineLeaf<'storage>) {
    leaf.counter.drops = leaf.counter.drops + 1;
}
machine demand_zero(counter: &mut Counter) requires counter.drops == 0 {}
machine displace<'storage>(counter: &'storage mut Counter, other: &'storage mut Counter) {
    let mut leaf: AffineLeaf<'storage> = AffineLeaf { counter: counter };
    leaf = AffineLeaf { counter: other };
}
machine main() {
    let mut counter: Counter = Counter { drops: 0 };
    let mut other: Counter = Counter { drops: 0 };
    displace(&mut counter, &mut other);
    demand_zero(&mut counter);
}
