// FAIL canary: cleanup helpers must be exact-empty — a helper whose own
// body carries statements exercises the empty-helper arm of the slice
// recognizer. Nesting a call inside the helper does not substitute for
// an empty body, so the drop must reject.

data Guard {
    handle: i32;
}

data Teardown {
}

machine Teardown::unlock() {
    Teardown::flush();
}

machine Teardown::flush() {
}

machine Guard::drop(&mut self) {
    Teardown::unlock();
}

data Main {
}

machine Main::main(&mut self) {
    let g: Guard = Guard { handle: 7 };
}
