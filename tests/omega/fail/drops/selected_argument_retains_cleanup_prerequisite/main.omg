data Token { ready: bool; }
domain Token::Tagged(token);
machine Token::drop(token: &mut Token) requires token.ready {}
machine prepare(token: &mut Token) ensures token.ready { token.ready = true; }
machine consume(token: Token) {
    let mut owned: Token = token;
    prepare(&mut owned);
}
machine exercise(choice: bool) {
    let retained: Token = Token { ready: false };
    consume(match choice {
        true -> retained as Token in Tagged
        false -> Token { ready: true } as Token in Tagged
    });
}
machine main() { exercise(false); }
