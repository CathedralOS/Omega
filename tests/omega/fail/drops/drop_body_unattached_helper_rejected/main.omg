// FAIL canary: every helper a `drop` body calls must attach to a data
// type. `unlock` is a free machine with no attachment, so the call
// exercises the helper-attachment arm of the slice recognizer and must
// reject.

data Guard {
    handle: i32;
}

machine unlock() {
}

machine Guard::drop(&mut self) {
    unlock();
}

data Main {
}

machine Main::main(&mut self) {
    let g: Guard = Guard { handle: 7 };
}
