data Room dropped by drop_room { count: u32 in Wrapping; }
machine drop_room(room: &mut Room) requires room.count == 10 { room.count = 99; }
machine later(mut count: u32 in Wrapping) ensures count == 10 { count = 10; }
machine main() {
 let room: Room = Room { count: 11 };
 transition { _ -> later(room.count) }
}
