data Leaf { value: i32; }
data Token { child: Leaf; }
data Container { token: Token; }

machine Token::drop(token: &mut Token) {}

machine detached(container: Container) {
    let token: Token = container.token;
    // Detaching the nominal owner does not permit splitting its receiver.
    transition { _ -> done(token.child) }
    state done(selected: Leaf) {}
}

machine main() {
    let container: Container = Container {
        token: Token { child: Leaf { value: 7 } }
    };
    // A plain parent may transfer token whole, but cannot split the receiver
    // that Token::drop must receive intact on this edge.
    transition { _ -> done(container.token.child) }
    state done(selected: Leaf) {}
}
