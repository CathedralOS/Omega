data Child { value: u64; }
data Element { child: Child; }

machine Child::drop(child: &mut Child)
requires child.value == 7
{
    child.value = 0;
}

machine Element::drop(element: &mut Element)
ensures element.child.value == 8
{
    element.child.value = 8;
}

machine replace(elements: &mut [Element; 2], selected: u64)
requires selected <= 1
{
    elements[selected] = Element { child: Child { value: 7 } };
}

machine main() {}
