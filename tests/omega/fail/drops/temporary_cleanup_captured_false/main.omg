data Token { ready: bool; value: u64; }

machine Token::drop(token: &mut Token)
requires token.ready
{
    token.ready = false;
}

machine set(flag: &mut bool) -> u64 {
    flag = true;
    7
}

machine read(token: &Token) -> u64 { token.value }

machine main() -> u64 {
    let mut flag: bool = false;
    // A later sibling cannot repair the false value already established in
    // the anonymous owner that dies on read's continuation.
    read(&Token { ready: flag, value: set(&mut flag) })
}
