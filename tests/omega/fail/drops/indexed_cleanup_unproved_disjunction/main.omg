data Owner dropped by drop_owner { values: [u64; 2]; }
machine drop_owner(owner: &mut Owner)
requires owner.values[1] == 7
{
    owner.values[1] = 0;
}
// A true disjunction does not supply its first branch or a new caller demand.
machine finish(value: u64)
requires value == 7 || value == 8
{
    let owner: Owner = Owner { values: [7, value] };
}
machine main() { finish(7); }
