// FAIL canary: every helper a `drop` body calls must attach to a data
// type with no members (the marker-carrier rule). `Util` declares a
// member, so `Util::flush()` exercises the membered-attachment arm of
// the slice recognizer and must reject.

data Guard {
    handle: i32;
}

data Util {
    flag: i32;
}

machine Util::flush() {
}

machine Guard::drop(&mut self) {
    Util::flush();
}

data Main {
}

machine Main::main(&mut self) {
    let g: Guard = Guard { handle: 7 };
}
