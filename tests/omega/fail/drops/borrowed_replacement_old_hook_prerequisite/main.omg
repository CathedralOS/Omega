data Token { value: u64; }
data Holder { token: Token; }

machine Token::drop(token: &mut Token)
requires token.value == 7
{
    token.value = 0;
}

machine replace(holder: &mut Holder)
requires holder.token.value == 8
ensures holder.token.value == 7
{
    // The replacement is valid, but the old token cannot be cleaned up.
    holder.token = Token { value: 7 };
}

// All authored bodies are checked, including an uncalled helper. No later
// lexical cleanup should mask the missing old-value prerequisite here.
machine main() {}
