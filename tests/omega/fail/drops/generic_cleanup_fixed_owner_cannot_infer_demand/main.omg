data Token dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token)
requires token.value == 7
{ token.value = 0; }
// A generic parameter does not authorize inventing a caller demand for this
// independent, fixed-type local. Its invalid cleanup remains a body error.
machine retire<T>(value: T) {
    let token: Token = Token { value: 8 };
}
machine main() { retire(1u64); }
