data Token { ready: bool; value: u64; }
machine Token::drop(token: &mut Token) requires token.ready { token.ready = false; }
machine make_token() -> Token ensures result.ready == true { Token { ready: true, value: 7 } }
machine read(token: &Token) -> u64 { token.value }
data Bundle { token: Token; }
machine Bundle::drop(bundle: &mut Bundle) { bundle.token.ready = false; }
machine make_bundle() -> Bundle ensures result.token.ready == true { Bundle { token: Token { ready: true, value: 7 } } }
machine main() { let bundle: Bundle = make_bundle(); }
