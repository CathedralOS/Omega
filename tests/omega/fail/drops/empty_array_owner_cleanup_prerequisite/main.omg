domain u64::Positive requires 1 <= self;
data Token { value: u64 in Positive; }
data Holder { tokens: [Token; 0]; ready: bool; }

machine Holder::drop(holder: &mut Holder)
requires holder.ready
{
    holder.ready = false;
}

machine main() {
    // No Token exists. The array's element domain cannot turn this complete
    // zero-valued Holder into unfinished construction and skip its hook.
    let holder: Holder;
}
