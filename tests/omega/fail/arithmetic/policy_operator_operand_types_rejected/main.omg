// A suffixed operator takes two operands in one bare fixed-width integer
// carrier. Each machine breaks that rule one way: two different carriers, a
// float, a wholly anonymous calculation, a generic carrier, and a shift count
// that carries a domain.
use omega_language_std::console;
data Main { }

machine mismatched(a: u32, b: u64) -> u32 { a +% b }

machine floating(a: f64, b: f64) -> f64 { a +% b }

machine anonymous() -> u32 { 1 +% 2 }

machine generic<T>(a: T, b: T) -> T { a +% b }

machine qualified_count(value: u32, count: u32 in Wrapping) -> u32 { value <<% count }

machine subject() -> bool {
    mismatched(1, 2) == 3
}

machine Main::main(main: &mut Main) reaches Console {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
