// A result copied at selector 0 cannot use a nonzero read at selector 1.
// Compile-checked only: no ProgramEntry and no native oracle.
machine coordinate(value: u32) -> u32 ensures result == value { value }
machine main(items: &[u32; 2]) {
    let mut index: u64 = 0;
    let value: u32 = coordinate(items[index]);
    index = 1;
    transition items[index] != 0u32 {
        true -> divide(value)
        _ -> done()
    }
    machine divide(value: u32) { let quotient: u32 = 1u32 / value; }
    machine done() {}
}
