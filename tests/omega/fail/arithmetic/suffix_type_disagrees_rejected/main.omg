// CR4a's loud edge: a width suffix chooses the literal's type AT THE
// SPELLING, so a destination whose declared type disagrees is an error --
// silently stripping the suffix (the old behavior) made it meaningless;
// silently honoring it would steer signedness/width decisions against the
// declared type. Domain is not part of the check (suffixes land the TYPE;
// the destination's arithmetic domain stays contextual).
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) {
    let x: u32 = 5i8;
    Console::exit_process(70);
}
