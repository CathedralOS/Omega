machine bit(count: u32, ceiling: u32, bypass: bool) -> u64 {
    transition bypass {
        true -> calculate(count)
        false -> decide(count, ceiling)
    }
    state decide(count: u32, ceiling: u32) -> u64 {
        let valid: bool = count < ceiling && ceiling <= 64u32;
        transition valid {
            true -> calculate(count)
            false -> empty()
        }
    }
    state calculate(count: u32) -> u64 { 1u64 << count }
    state empty() -> u64 { 0u64 }
}
