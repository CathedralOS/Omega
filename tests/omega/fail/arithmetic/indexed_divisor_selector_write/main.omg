machine quotient(values: &[i64 in Wrapping; 2], index: u64) -> i64 in Wrapping
requires index < 2
requires values[index] != 0 {
    transition { _ -> divided(values, index) }
    machine divided(values: &[i64 in Wrapping; 2], mut index: u64) -> i64 in Wrapping
    requires index < 2
    requires values[index] != 0 {
        index = 1;
        let numerator: i64 in Wrapping = 20;
        numerator / values[index]
    }
}
machine main() { }
