// Each integer delivery owns one carrier/policy conversion diagnostic.
// Explicit policy erasure remains mandatory at every value boundary.
data Values { number: u32; }
machine consume(value: u32) {}
machine erase(value: u32 in Wrapping) -> u32 { value }
machine main() {
    let qualified: u32 in Wrapping = 7;
    let plain: u32 = qualified;
    consume(qualified);
    let array: [u32; 1] = [qualified];
    let record: Values = Values { number: qualified };
    let mut output: Values;
    output.number = qualified;
}
