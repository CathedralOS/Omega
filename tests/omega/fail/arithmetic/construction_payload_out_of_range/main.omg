// FAIL canary: constructing a range-refined payload field with an out-of-range
// literal is rejected -- the bound a destructure arm trusts must hold at every
// construction site (fact-catalog soundness). 9999 is outside [0..=15].
use omega::language::std::console;
use omega::language::core::binding;
data Slot { case Found(index: i32 [0..=15]); case Full; }
data Main { console: Binding<Console>; }
machine Main::run(main: &mut Main, s: Slot) {
    transition s { Slot::Found { index } -> done(main, index) Slot::Full -> stop(main) }
    state done(main: &mut Main, n: i32) { main.console.exit_process(0); }
    state stop(main: &mut Main) { main.console.exit_process(0); }
}
machine Main::main(main: &mut Main) { Main::run(main, Slot::Found { index: 9999 }); }
