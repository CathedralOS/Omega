// Must reject: the returned scalar is 1, while the caller's field is now 2.
// A pre-call captured argument cannot donate a post-call equality to that field.
data Cell { value: u32; }
machine capture(value: u32, cell: &mut Cell) -> u32
ensures result == value;
{
    cell.value = 2u32;
    value
}
machine main() {
    let mut cell: Cell = Cell { value: 1u32 };
    let captured: u32 = capture(cell.value, &mut cell);
    let difference: u32 = captured - cell.value;
}
