// One possible arrival with a representable nonnegative count bypasses the joint capacity guard.
data Reader where received <= 16384, count >= 0, count <= 16384 { received: u64; count: i64; }
machine Reader::advance(reader: &mut Reader, check: bool) {
    transition check { true -> room(reader) _ -> bypass(reader) }
    state room(reader: &mut Reader) {
        transition reader.count as u64 <= 16384 - reader.received {
            true -> store(reader)
            _ -> done()
        }
    }
    state bypass(reader: &mut Reader) { transition { _ -> store(reader) } }
    state store(reader: &mut Reader) {
        reader.received = reader.received + reader.count as u64;
        transition { _ -> done() }
    }
    state done() { }
}
