data Reader { received: u64 [0..=16384]; count: i64; }
machine Reader::advance(reader: &mut Reader) {
    transition reader.count > 0 { true -> room(reader) _ -> done() }
    state room(reader: &mut Reader) {
        transition reader.count as u64 <= 16384 - reader.received {
            true -> store(reader)
            _ -> done()
        }
    }
    state store(reader: &mut Reader) {
        reader.count = 16384;
        reader.received = reader.received + reader.count as u64;
        transition { _ -> done() }
    }
    state done() { }
}
