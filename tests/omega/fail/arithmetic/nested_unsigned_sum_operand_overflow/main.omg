// A bounded parent still evaluates its overflowing Exact child.
machine tally(value: u64) -> u64 {
    ((value + 1) % 100 * 2 + value % 100 * 3 + value % 100 * 5 + value % 100 * 7 + value % 100 * 11 + value % 100 * 13 + value % 100 * 17 + value % 100 * 19 + value % 100 * 23 + value % 100 * 29 + value % 100 * 31 + value % 100 * 37 + value % 100 * 41) % 191 + 1
}
machine main() {}
