// A store OUTSIDE a constant-expression range bound: `x: i32 [0 - 1..=40]`
// folds to `[-1..=40]`, so `self.x = 100` must reject exactly like a literal
// bound. Before the const-eval, the expression bound silently behaved
// UNBOUNDED and this compiled.
use omega::language::std::console;

data Main {
    console: Console;
    x: i32 [0 - 1..=40];
}

machine Main::main(&mut self) {
    self.x = 100;
    self.console.exit_process(1);
}
