// UTF-8 paths become UTF-16 code units, including the terminator. Typed u16
// storage establishes Windows WCHAR alignment; the foreign leaf borrows the
// entire fixed buffer, not a one-byte reference used beyond its claimed extent.
// Return the unit count, or -1 for NUL input, malformed UTF-8 or insufficient
// output. A written prefix never authorizes an OS call after failure.
// Output is the raw adapter's fixed native path capacity; no generic view ABI is needed.
use omega::language::core::numeric_conversion;

data WindowsPathCharacter {
    valid: bool;
    point: u32;
    next_input: u64;
}

data WindowsPathStep {
    status: i32;
    next_input: u64;
    next_output: u64;
}

machine windows_path_step(path: &[u8], output: &mut [u16; 4096], input_offset: u64, output_offset: u64) -> WindowsPathStep {
    transition output_offset < output.len {
        true -> position(path, output, input_offset, output_offset)
        false -> bad()
    }
    machine position(path: &[u8], output: &mut [u16; 4096], input_offset: u64, output_offset: u64) -> WindowsPathStep {
        transition input_offset < path.len {
            true -> decode(path, output, input_offset, output_offset)
            false -> terminate(output, output_offset)
        }
    }
    machine decode(path: &[u8], output: &mut [u16; 4096], input_offset: u64, output_offset: u64) -> WindowsPathStep {
        let character: WindowsPathCharacter = windows_path_character(path, input_offset);
        transition character.valid {
            true -> emit(output, character, output_offset)
            false -> bad()
        }
    }
    machine emit(output: &mut [u16; 4096], character: WindowsPathCharacter, output_offset: u64) -> WindowsPathStep {
        transition character.point < 65536 {
            true -> single(output, character, output_offset)
            false -> pair(output, character, output_offset)
        }
    }
    machine single(output: &mut [u16; 4096], character: WindowsPathCharacter, output_offset: u64) -> WindowsPathStep {
        output[output_offset] = narrow_u32_to_u16_wrapping(character.point);
        WindowsPathStep { status: 0, next_input: character.next_input, next_output: output_offset + 1 }
    }
    machine pair(output: &mut [u16; 4096], character: WindowsPathCharacter, output_offset: u64) -> WindowsPathStep {
        let next_output: u64 = output_offset + 1;
        transition next_output <= output.len {
            true -> emit_pair(output, character, output_offset, next_output)
            false -> bad()
        }
    }
    machine emit_pair(output: &mut [u16; 4096], character: WindowsPathCharacter, output_offset: u64, next_output: u64) -> WindowsPathStep {
        let above: u32 = character.point - 65536;
        output[output_offset] = narrow_u32_to_u16_wrapping(55296 + (above / 1024));
        output[next_output] = narrow_u32_to_u16_wrapping(56320 + (above % 1024));
        WindowsPathStep { status: 0, next_input: character.next_input, next_output: next_output + 1 }
    }
    machine terminate(output: &mut [u16; 4096], output_offset: u64) -> WindowsPathStep {
        output[output_offset] = 0;
        WindowsPathStep { status: 1, next_input: 0, next_output: output_offset + 1 }
    }
    machine bad() -> WindowsPathStep {
        WindowsPathStep { status: -1, next_input: 0, next_output: 0 }
    }
}

// Decode one scalar. Reject overlong encodings, UTF-16 surrogates, out-of-range
// scalars and embedded NUL before returning a character to the encoder.
machine windows_path_character(path: &[u8], offset: u64) -> WindowsPathCharacter {
    transition offset < path.len { true -> lead(path, offset) false -> bad() }
    machine lead(path: &[u8], offset: u64) -> WindowsPathCharacter {
        let first: u8 = path[offset];
        transition first > 0 && first < 128 {
            true -> valid(widen_u8_to_u32(first), offset + 1)
            false -> multibyte(path, offset, first)
        }
    }
    machine multibyte(path: &[u8], offset: u64, first: u8) -> WindowsPathCharacter {
        let second_offset: u64 = offset + 1;
        transition first >= 194 && first <= 244 && second_offset < path.len {
            true -> second(path, first, second_offset)
            false -> bad()
        }
    }
    machine second(path: &[u8], first: u8, offset: u64) -> WindowsPathCharacter {
        let second: u8 = path[offset];
        transition second >= 128 && second < 192 {
            true -> width(path, first, second, offset + 1)
            false -> bad()
        }
    }
    machine width(path: &[u8], first: u8, second: u8, next: u64) -> WindowsPathCharacter {
        transition first < 224 {
            true -> valid((widen_u8_to_u32(first & 31) << 6) | widen_u8_to_u32(second & 63), next)
            false -> third_room(path, first, second, next)
        }
    }
    machine third_room(path: &[u8], first: u8, second: u8, offset: u64) -> WindowsPathCharacter {
        transition offset < path.len { true -> third(path, first, second, offset) false -> bad() }
    }
    machine third(path: &[u8], first: u8, second: u8, offset: u64) -> WindowsPathCharacter {
        let third: u8 = path[offset];
        transition third >= 128 && third < 192 {
            true -> third_width(path, first, second, third, offset + 1)
            false -> bad()
        }
    }
    machine third_width(path: &[u8], first: u8, second: u8, third: u8, next: u64) -> WindowsPathCharacter {
        transition first < 240 {
            true -> three(first, second, third, next)
            false -> fourth_room(path, first, second, third, next)
        }
    }
    machine three(first: u8, second: u8, third: u8, next: u64) -> WindowsPathCharacter {
        let point: u32 = (widen_u8_to_u32(first & 15) << 12)
            | (widen_u8_to_u32(second & 63) << 6) | widen_u8_to_u32(third & 63);
        transition point >= 2048 && (point < 55296 || point > 57343) {
            true -> valid(point, next)
            false -> bad()
        }
    }
    machine fourth_room(path: &[u8], first: u8, second: u8, third: u8, offset: u64) -> WindowsPathCharacter {
        transition offset < path.len { true -> fourth(path, first, second, third, offset) false -> bad() }
    }
    machine fourth(path: &[u8], first: u8, second: u8, third: u8, offset: u64) -> WindowsPathCharacter {
        let fourth: u8 = path[offset];
        let point: u32 = (widen_u8_to_u32(first & 7) << 18)
            | (widen_u8_to_u32(second & 63) << 12)
            | (widen_u8_to_u32(third & 63) << 6) | widen_u8_to_u32(fourth & 63);
        transition fourth >= 128 && fourth < 192 && point >= 65536 && point <= 1114111 {
            true -> valid(point, offset + 1)
            false -> bad()
        }
    }
    machine valid(point: u32, next: u64) -> WindowsPathCharacter {
        WindowsPathCharacter { valid: true, point: point, next_input: next }
    }
    machine bad() -> WindowsPathCharacter {
        WindowsPathCharacter { valid: false, point: 0, next_input: 0 }
    }
}

// Expected exit: 0. Prefix guards retain their numeric consequences across
// independent UTF decoding observations and indexed output writes.
machine main() crashes Trap {
    let mut output: [u16; 4096];
    let ascii: WindowsPathStep = windows_path_step("A", &mut output, 0, 0);
    let ascii_unit: u16 = output[0];
    let two: WindowsPathStep = windows_path_step("é", &mut output, 0, 0);
    let two_unit: u16 = output[0];
    let three: WindowsPathStep = windows_path_step("界", &mut output, 0, 0);
    let three_unit: u16 = output[0];
    let pair: WindowsPathStep = windows_path_step("𐀀", &mut output, 0, 0);
    transition ascii.status == 0 && ascii.next_input == 1 && ascii.next_output == 1
        && two.status == 0 && two.next_input == 2 && two.next_output == 1
        && three.status == 0 && three.next_input == 3 && three.next_output == 1
        && pair.status == 0 && pair.next_input == 4 && pair.next_output == 2
        && ascii_unit == 65 && two_unit == 233 && three_unit == 30028
        && output[0] == 55296 && output[1] == 56320 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
