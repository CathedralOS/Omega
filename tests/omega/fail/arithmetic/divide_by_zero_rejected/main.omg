// A divisor that is provably zero (a literal 0 here) always traps; it is
// rejected at compile time like an out-of-range literal, not left to fault at
// runtime (native idiv #DE / interpreter trap).
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) { let x: i32 = 5 / 0; Console::exit_process(x); }
