data Cursor { offset: u64; available: u64; }
machine replace_offset(cursor: &mut Cursor) -> u64 {
    cursor.offset = 18446744073709551615;
    0
}
machine advance(cursor: &mut Cursor, length: u64) {
    transition cursor.offset <= cursor.available && cursor.available <= 64 {
        true -> inspect(cursor, length)
        false -> done()
    }
    machine inspect(cursor: &mut Cursor, length: u64) {
        let start: u64 = cursor.offset;
        let limit: u64 = cursor.available;
        transition length <= limit - start {
            true -> commit(replace_offset(cursor), cursor, cursor.offset, length)
            false -> done()
        }
    }
    machine commit(tag: u64, destination: &mut Cursor, start: u64, length: u64) {
        destination.offset = start + length;
    }
    machine done() {}
}
