// Twin of `small_sum` in run/arithmetic/policy_operator_contracts with `+!`
// in place of `+%` in its `requires`. A trapping operation can transfer
// control, so it forms no specification term
// (wiki/spec/proofs/contracts.md#total-arithmetic).
use omega_language_std::Console;
data Main { }

machine small_sum(a: u32, b: u32) -> u32
    requires a +! b < 10
    ensures result == a +% b
{
    a +% b
}

machine subject() -> bool {
    small_sum(4000000000, 294967300) == 4
}

machine Main::main(main: &mut Main) reaches Console {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
