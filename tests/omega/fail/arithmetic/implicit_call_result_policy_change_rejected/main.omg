// A declared Exact result stays Exact even when interval inference contributes
// no arithmetic policy. Ordinary stores cannot add another policy implicitly.
machine produce(value: u32) -> u32 { value }

machine bounded(value: u32) -> u32
requires value <= 9
ensures result <= 9
{ value }

machine main() {
    let wrapping: u32 in Wrapping = produce(7);
    let saturating: u32 in Saturating = produce(7);
    let trapping: u32 in Trapping = produce(7);
    let guaranteed: u32 in Wrapping = bounded(7);
}
