public data Condition { selected: bool; }

machine next(rest: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping
requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
{ count }

boundary trait Replace {
    machine run(condition: &mut Condition) reaches;
}

machine stale(rest: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping
requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
reaches Replace
{
    let mut condition: Condition = Condition { selected: rest >= 10 };
    Replace::run(&mut condition);
    transition condition.selected {
        true -> next(rest - 10, count + 1)
        _ -> (count)
    }
}
