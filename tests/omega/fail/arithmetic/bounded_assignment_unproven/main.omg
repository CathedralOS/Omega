// FAIL canary: assigning an out-of-range value to a range-refined field is
// rejected. The declared range a later narrowing trusts must hold at EVERY
// write, not just construction/initialization -- assignment was the one write
// position left unenforced (#63). `x` is [0..=100]; 9999 is outside it.
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; x: i32 [0..=100]; }
machine Main::main(main: &mut Main) {
    main.x = 9999;
    main.console.exit_process(0);
}
