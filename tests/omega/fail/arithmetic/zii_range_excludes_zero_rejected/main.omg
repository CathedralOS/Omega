// A declared nonzero bound cannot establish an observation of zeroed storage.
// A readable parameter would already carry that establishment obligation;
// this local deliberately has no initializer to discharge it.
data Divisor
requires
    value >= 1,
    value <= 100,
{
    value: i32;
}

machine main() {
    let divisor: Divisor;
    let remainder: i32 = 10 % divisor.value;
}
