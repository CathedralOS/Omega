// FAIL canary: a range that excludes zero now gates machine-attached storage.
// Reading m before establishment cannot exploit its declared nonzero bound.
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; m: i32 [1..=100]; q: i32; }
machine Main::main(main: &mut Main) {
    main.q = 10 % main.m;
    main.console.exit_process(0);
}
