data Cursor { offset: u64; available: u64; }
machine advance(cursor: &mut Cursor, length: u64, bounded: bool) {
    transition bounded {
        true -> inspect(cursor, length)
        false -> commit(cursor, 18446744073709551615, 1)
    }
    machine inspect(cursor: &mut Cursor, length: u64) {
        transition cursor.offset <= cursor.available && cursor.available <= 64 {
            true -> available(cursor, length)
            false -> done()
        }
    }
    machine available(cursor: &mut Cursor, length: u64) {
        let start: u64 = cursor.offset;
        let limit: u64 = cursor.available;
        transition length <= limit - start {
            true -> commit(cursor, start, length)
            false -> done()
        }
    }
    machine commit(destination: &mut Cursor, start: u64, length: u64) {
        destination.offset = start + length;
    }
    machine done() {}
}
