// Negative twin of `wrapping_sum` in
// run/arithmetic/policy_operators_match_policy_domains. The only difference is
// that the left operand carries a policy domain. A suffixed operator neither
// reads nor removes a domain, so the qualified operand rejects until a cast
// removes its domain.
data Main { }

machine wrapping_sum(a: u32 in Wrapping, b: u32) -> u32 {
    a +% b
}
