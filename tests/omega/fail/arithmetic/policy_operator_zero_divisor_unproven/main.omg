// Twin of `minimum_quotient` in
// run/arithmetic/policy_operators_match_policy_domains without its
// `requires divisor != 0`. Wrapping and Saturating define the unrepresentable
// quotient; neither invents a result for a zero divisor, so every one of the
// four operations still owes the nonzero-divisor proof.
use omega_language_std::console;
data Main { }

machine minimum_quotient(value: i32, divisor: i32) -> bool {
    let wrapped: i32 = value /% divisor;
    let wrapped_rest: i32 = value %% divisor;
    let clamped: i32 = value /| divisor;
    let clamped_rest: i32 = value %| divisor;
    wrapped == -2147483648 && wrapped_rest == 0 && clamped == 2147483647 && clamped_rest == 0
}

machine subject() -> bool {
    minimum_quotient(-2147483648, -1)
}

machine Main::main(main: &mut Main) reaches Console {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
