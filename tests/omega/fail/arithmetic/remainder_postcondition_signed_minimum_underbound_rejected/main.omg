machine bounded(value: i64) -> i64
    ensures result >= -9223372036854775806, result <= 9223372036854775807
{
    value % -9223372036854775808i64
}
machine main() crashes Trap {
    let high: i64 = bounded(9223372036854775807i64);
    let low: i64 = bounded(-9223372036854775807i64);
