// A provider body must prove exact coercion for its own unrestricted slice,
// independently of the requirement namespace or its erased lifetime telescope.
// Wrapping qualifies the result; it cannot truncate this arbitrary u64 count.
public data CellSource {}

public boundary requirement CellSource::read<'a>(source: &'a [u8]) -> i32;

data CellSourceProvider {}

machine CellSourceProvider::read_impl<'a>(source: &'a [u8]) -> i32
satisfies CellSource::read
{
    transition { _ -> ((source.len as u16 in Wrapping) as i32) }
}

machine main() -> i32 { transition { _ -> (41) } }
