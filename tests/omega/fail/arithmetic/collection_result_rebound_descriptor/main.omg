machine count(mut values: &[u8], other: &[u8]) -> u64
ensures result <= values.len {
    values = other;
    values.len
}
machine rejected() -> u8 {
    let small: [u8; 1];
    let large: [u8; 3];
    let destination: [u8; 2];
    let count: u64 = count(&small[..], &large[..]);
    destination[count]
}
