machine next(rest: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping
requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
{ count }

machine wrong(rest: u64 in Trapping, count: u64 in Trapping, flag: bool) -> u64 in Trapping
requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
{
    let selected: bool = rest >= 10 && flag;
    transition selected {
        false -> next(rest - 10, count + 1)
        _ -> (count)
    }
}

machine require_below(rest: u64 in Trapping) -> u64 in Trapping
requires rest < 10
{ rest }

machine incorrect_denial(rest: u64 in Trapping, flag: bool) -> u64 in Trapping {
    let selected: bool = rest >= 10 && flag;
    transition selected {
        false -> require_below(rest)
        _ -> (rest)
    }
}
