domain u32::Custom;

machine < u32::Custom::custom(left: u32 in Custom, right: u32) -> bool {
    true
}

machine shift(count: u32 in Custom) -> u64 {
    let valid: bool = count < 64u32;
    transition valid {
        true -> calculate(count)
        false -> empty()
    }
    machine calculate(count: u32 in Custom) -> u64 { 8u64 >> count }
    machine empty() -> u64 { 0 }
}
