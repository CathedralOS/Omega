// Truncating the observation does not constrain the original wider value.
use omega::language::core::numeric_conversion;

data Values where source <= 1000, result <= 10 { source: u64; result: u64; }
machine Values::store(values: &mut Values) {
    transition narrow_u64_to_u8_wrapping(values.source) <= 10 {
        true -> bounded(values)
        _ -> done()
    }
    machine bounded(values: &mut Values) {
        values.result = values.source;
        transition { _ -> done() }
    }
    machine done() { }
}
