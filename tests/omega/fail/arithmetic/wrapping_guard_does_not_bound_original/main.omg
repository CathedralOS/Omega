// Truncating the observation does not constrain the original wider value.
data Values { source: u64 [0..=1000]; result: u64 [0..=10]; }
machine Values::store(values: &mut Values) {
    transition (values.source as u8 in Wrapping) <= 10 {
        true -> bounded(values)
        _ -> done()
    }
    state bounded(values: &mut Values) {
        values.result = values.source;
        transition { _ -> done() }
    }
    state done() { }
}
