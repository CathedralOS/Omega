// An extent of 201 cannot bound an index into an array of length 200.
// Compile-checked only: no ProgramEntry and no native oracle.
data Main {
    hits: i32 in Wrapping;
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    grid: [i32; 200] in Wrapping;
    larger_grid: [i32; 201] in Wrapping;
}
machine Main::main(main: &mut Main) {
    let a: i32 in Wrapping = main.a;
    let b: i32 in Wrapping = main.b;
    transition b * 20 + a >= 0 && b * 20 + a < main.larger_grid.len {
        true -> put(main, a, b)
        _ -> done(main)
    }
    machine put(main: &mut Main, a: i32 in Wrapping, b: i32 in Wrapping) {
        main.grid[b * 20 + a] = 7;
        main.hits = 1;
    }
    machine done(main: &mut Main) { main.hits = -1; }
}
