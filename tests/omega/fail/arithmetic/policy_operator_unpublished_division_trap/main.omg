// Twin of `guarded_quotient` and `guarded_rest` in
// run/arithmetic/policy_operator_division_matches_policy_domains without
// their `requires`. `/!` on a signed carrier can trap on a zero divisor and
// on `MIN / -1`, and `%!` on an unsigned carrier on a zero divisor, so a
// public machine that publishes no `crashes Trap` rejects.
use omega_language_std::Console;
data Main { }

public machine guarded_quotient(value: i32, divisor: i32) -> i32 {
    value /! divisor
}

public machine guarded_rest(value: u32, divisor: u32) -> u32 {
    value %! divisor
}

machine subject() -> bool {
    guarded_quotient(-7, 2) == -3 && guarded_rest(7, 2) == 1
}

machine Main::main(main: &mut Main) reaches Console {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
