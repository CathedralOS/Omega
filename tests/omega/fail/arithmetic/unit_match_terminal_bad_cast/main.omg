// The selected Unit call still owes formation of its out-of-range operand.
machine main() {
    let mut result: u64 = 0;
    select(&mut result, true, -1);
}
machine select(result: &mut u64, chosen: bool, value: i32) {
    match chosen {
        true -> store(result, value as u64)
        false -> store(result, 7u64)
    }
}
machine store(result: &mut u64, value: u64) { result = value; }
