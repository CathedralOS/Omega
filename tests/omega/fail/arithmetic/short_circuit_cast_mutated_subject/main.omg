data Counter { value: u32; }

machine change(counter: &mut Counter) -> bool {
    counter.value = 300u32;
    true
}

machine narrow(counter: &mut Counter) -> bool {
    (counter.value <= 255u32 && change(&mut counter)) && (counter.value as u8) == 42u8
}

machine main() {
    let mut counter: Counter;
    let result: bool = narrow(&mut counter);
}
