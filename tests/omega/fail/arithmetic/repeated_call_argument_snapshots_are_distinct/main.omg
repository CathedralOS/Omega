// Must reject: two same-spelled calls return 1 and 2 in authored order.
// Denotational target/argument syntax cannot identify those captured results.
data Cell { value: u32; }
machine capture(value: u32, cell: &mut Cell) -> u32
ensures result == value;
{
    cell.value = 2u32;
    value
}
machine main() {
    let mut cell: Cell = Cell { value: 1u32 };
    let difference: u32 = capture(cell.value, &mut cell) - capture(cell.value, &mut cell);
}
