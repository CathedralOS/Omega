// FAIL canary: a direct `main.<field>` write to a field that does not exist (a typo
// -- `main.cont` for `main.count`) is rejected at type-check with a clear "data X has
// no field Y" error, NOT the misleading "not mutable" message and NOT an opaque
// backend "needs mutation lowering". The check is scoped to direct `main.<field>`
// targets against the machine's top-level data fields; nested / local / versioned
// targets are left to the writable-roots and version-access diagnostics.

use omega::language::std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    count: i32 in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.cont = 5; // typo -- the field is `count`
    transition { _ -> done(main) }
    state done(main: &mut Main) {
        main.console.exit_process(main.count);
    }
}
