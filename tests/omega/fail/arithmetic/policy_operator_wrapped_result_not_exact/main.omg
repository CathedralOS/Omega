// Twin of `regained` in run/arithmetic/policy_operator_exact_result_fact
// with `+%` and `+|` in place of `+!`. A wrapped or clamped sum can differ
// from `left + right`, so nothing proves that `sum - left` fits `u64`.
use omega_language_std::Console;
data Main { }

machine regained_wrapped(left: u64, right: u64) -> u64 {
    let sum: u64 = left +% right;
    sum - left
}

machine regained_clamped(left: u64, right: u64) -> u64 {
    let sum: u64 = left +| right;
    sum - left
}

machine subject() -> bool {
    regained_wrapped(40, 2) == 2 && regained_clamped(40, 2) == 2
}

machine Main::main(main: &mut Main) reaches Console {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
