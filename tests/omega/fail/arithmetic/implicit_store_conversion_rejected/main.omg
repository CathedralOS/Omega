// A typed value keeps its own carrier across a store: storing the `u32`
// state into the `i32` output is an implicit conversion even though both
// are Exact integers, because the typed value does not take the
// destination's type. Decision 17 rejects it; spelling `main.state as i32`
// is the escape.
use omega_language_std::console;
data Main { state: u32; output: i32; }
machine Main::main(main: &mut Main) {
    main.state = 7;
    main.output = main.state;
    let o: i32 = main.output;
    Console::exit_process(o);
}
