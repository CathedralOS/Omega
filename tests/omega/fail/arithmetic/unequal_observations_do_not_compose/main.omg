machine quotient(value: u32, intermediary: u32) -> u32 {
    let valid: bool = value != intermediary && intermediary != 0u32;
    transition { _ -> decide(value, valid) }
    machine decide(value: u32, valid: bool) -> u32 {
        transition valid {
            true -> calculate(value)
            false -> empty()
        }
    }
    machine calculate(value: u32) -> u32 { 10u32 / value }
    machine empty() -> u32 { 0u32 }
}
