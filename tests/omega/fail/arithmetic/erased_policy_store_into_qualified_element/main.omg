// The refused twin of
// pass/collections/qualified_element_read_modify_write_retains_policy_exit.
// `as i32` is an explicit same-carrier policy erasure: the wrapped sum becomes
// a bare Exact `i32`. Storing that value back into an element of a
// `[i32; 4] in Wrapping` array would select the Wrapping policy implicitly at
// the store, and policy selection is explicit (numeric values, "Policy
// selection and erasure are explicit ... incompatible policies do not mix
// implicitly"). The store needs `as i32 in Wrapping`, or no erasure at all.
data Counts { values: [i32; 4] in Wrapping; }
machine main() {
    let mut counts: Counts;
    counts.values[1] = 5;
    counts.values[1] = (counts.values[1] + 1) as i32;
}
