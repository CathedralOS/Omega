// Twin of the `<<|` and `>>|` shifts in
// run/arithmetic/policy_operators_match_policy_domains with a count nothing
// bounds. Saturating defines value overflow, not an invalid count, so both
// shifts still owe the Exact proof that the count is below the width.
use omega_language_std::Console;
data Main { }

machine clamped_left(value: u32, count: u32) -> u32 {
    value <<| count
}

machine clamped_right(value: u32, count: u32) -> u32 {
    value >>| count
}

machine subject() -> bool {
    clamped_left(48, 4) == 768 && clamped_right(48, 4) == 3
}

machine Main::main(main: &mut Main) reaches Console {
    transition subject() {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
