// FAIL canary: an Exact (undomained) arithmetic op whose operand is a value-machine
// CALL with an unconstrained integer return is rejected by decision-17 (the return
// range is unproven). The diagnostic must NAME the call and point at the actionable
// fix -- annotate the CALLEE'S return type -- rather than only the generic "constrain
// the operands' range" (which is unactionable at the call site). Locks the
// value-call-aware overflow hint.

use omega_language_std::console;

data Main {
    s: i32 in Wrapping;
}

machine triple(x: i32 in Wrapping) -> i32 {
    let t: i32 in Wrapping = x * 3;
    // Erase the policy explicitly so only the caller's Exact addition rejects.
    transition { _ -> (t as i32) }
}

machine Main::main(main: &mut Main, input: i32 in Wrapping) reaches Console {
    // Unknown captured input keeps the unconstrained return range; Exact +100
    // can overflow even though every return in triple is now followed.
    main.s = triple(input) + 100;
    transition { _ -> done(main) }
    state done(main: &mut Main) {
        Console::exit_process(main.s as i32);
    }
}
