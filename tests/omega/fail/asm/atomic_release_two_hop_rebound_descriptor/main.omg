// REFUSE: rebinding the first descriptor of a two-hop path does not move the prior store.
use omega::language::core::atomic_release_written;
data Cell { value: AtomicU64; }
data Holder { word: &Cell; }
data Envelope { holder: &Holder; }
data Ack [linear] { nonce: u64; }
boundary trait Completion { machine complete(ack: Ack, mut envelope: &Envelope, other: &Envelope) reaches; }
proposition acknowledged(ack: Ack, envelope: &Envelope) = atomic_release_written<AtomicU64, u64>(&envelope.holder.word.value, 1);
data Confirmation {}
machine Confirmation::finish(ack: Ack, mut envelope: &Envelope, other: &Envelope) satisfies Completion::complete
ensures acknowledged(ack, envelope)
{ envelope.holder.word.value.store(1, Publish); envelope = other; }
CompletionProvider satisfies Completion { machine complete(ack: Ack, mut envelope: &Envelope, other: &Envelope) { Confirmation::finish(ack, envelope, other) } }
machine main() {}
