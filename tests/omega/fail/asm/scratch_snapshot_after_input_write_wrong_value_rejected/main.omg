// The arrival contract asks for the rewritten place value instead of the
// register snapshot, so the edge cannot prove it.
machine main() crashes Trap {
    let mut input: u32 = 5;
    let mut output: u32 = 99;
    asm {
    entry:
        jmp branch;
    branch:
        mov eax, 1;
        sub eax, 1;
        mov eax, input;
        mov input, 7;
        jnz after;
    after requires eax == 7:
        mov output, eax
    }
    transition output == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}