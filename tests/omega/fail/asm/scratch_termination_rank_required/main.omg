// Expected exit: 0.
// The checked seed-2 mov/sub/jnz CFG falls through with eax == 0 and stores output == 0.
machine main() terminates; crashes Trap {
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, 2;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 0:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
