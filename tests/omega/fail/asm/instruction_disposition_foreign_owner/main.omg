use omega::language::core::assembly;
use omega::language::core::assembly_model;
use omega::language::core::interrupt;
boundary trait ForeignCompletion {
    machine finish(token: InterruptAcknowledgement) reaches MachineControl;
}
ForeignFinisher satisfies ForeignCompletion { machine finish(token: InterruptAcknowledgement) reaches MachineControl { finish_realization(token) } }
proposition finished(token: InterruptAcknowledgement) = model_specific_written(2059, 0);
machine finish_realization(token: InterruptAcknowledgement)
satisfies ForeignCompletion::finish
reaches MachineControl
ensures finished(token)
{
    let index: u32 = 2059;
    let value: u64 = 0;
    asm ensures finished(token) { wrmsr index, value }
}
machine main() {}
