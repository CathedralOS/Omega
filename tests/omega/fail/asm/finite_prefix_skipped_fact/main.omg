// The skipped write cannot establish seven, even though it appears later in
// lexical source order. The address-model premise itself remains valid.
machine seven(value: u64) -> u64 requires value == 7 { value }
machine convert(address: addr) -> u64
requires addr::Bound == 18446744073709551616
{
    let mut value: u64 = 99;
    asm {
    entry:
        jmp tail;
    skipped:
        mov value, 7;
    tail:
        mov value, value
    }
    let checked: u64 = seven(value);
    address as u64
}
