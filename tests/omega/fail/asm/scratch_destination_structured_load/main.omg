// Reject a composite scratch destination before scalar versioning.
machine main() crashes Trap {
 let value: u32 = 2;
 let mut output: u32 = 99;
 asm {
 entry:
  mov w0, 2;
  ldr w0[0], value;
  b loop;
 loop requires w0 > 0:
  subs w0, w0, 1;
  b.ne loop;
 done requires w0 == 0:
  mov output, w0
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() crashes Trap { crash Trap; }
}
