boundary operator - u32::replacement(left: u32 in Wrapping, right: u32 in Wrapping) -> u32 in Wrapping;
machine main() crashes Trap {
 let mut output: u32 = 99;
 asm {
entry:
 mov eax, 2;
 sub eax, 1;
 mov output, eax
 }
 transition output { 1 -> done() _ -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
