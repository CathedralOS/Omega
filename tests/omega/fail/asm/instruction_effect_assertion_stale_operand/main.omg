use omega::language::core::port_written;
data PortCell { port: u16; }
machine observe(cell: &mut PortCell, byte: u8) reaches PortIo {
    cell.port = 32;
    asm ensures port_written(cell.port, byte) { out cell.port, byte }
    cell.port = 33;
    asm ensures port_written(cell.port, byte) { nop }
}
machine main() {}
