boundary operator == u32::replacement(left: u32, right: u32) -> bool;
machine main() crashes Trap {
 let mut output: u32 = 99;
 asm {
entry:
 mov eax, 1;
 sub eax, 1;
 jmp branch;
branch:
 jnz wrong;
right:
 mov output, 0;
 jmp finish;
wrong:
 mov output, 99;
finish:
 mov output, output
 }
 transition output { 0 -> done() _ -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
