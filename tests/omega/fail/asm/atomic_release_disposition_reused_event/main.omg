// REFUSE: an unperformed, mismatched or already spent store cannot settle a claim.
use omega::language::core::assembly_model;
data Cell { value: AtomicU64; }
data Ack [linear] { nonce: u64; }
boundary trait Completion {
 machine complete(first: Ack, second: Ack, word: &Cell) requires first.nonce == second.nonce;
}
proposition acknowledged(ack: Ack, word: &Cell) = atomic_release_written<AtomicU64, u64>(&word.value, ack.nonce);
machine finish(first: Ack, second: Ack, word: &Cell) satisfies Completion::complete
requires first.nonce == second.nonce;
ensures acknowledged(first, word);
ensures acknowledged(second, word);
{
 word.value.store(first.nonce, Publish);

}
CompletionProvider satisfies Completion { Completion::complete = finish; }
machine main() reaches Completion crashes Trap {
 let mut word: Cell;
 let ack: Ack = Ack { nonce: 37 };
 let other: Ack = Ack { nonce: 37 };
 Completion::complete(ack, other, &word);
 let observed: u64 in Wrapping = word.value.load(Receive);
 transition observed == 37 { true -> done() false -> bad() }
 state done() {}
 state bad() { crash Trap; }
}
