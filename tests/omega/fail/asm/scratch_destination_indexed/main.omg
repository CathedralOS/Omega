// Reject a composite scratch destination before scalar versioning.
machine main() crashes Trap {
 let mut output: u32 = 99;
 asm {
 entry:
  mov eax, 2;
  mov eax[0], 2;
  jmp loop;
 loop requires eax > 0:
  sub eax, 1;
  jnz loop;
 done requires eax == 0:
  mov output, eax
 }
 transition output == 0 { true -> done() false -> bad() }
 machine done() {}
 machine bad() { crash Trap; }
}
