// A provider holds no state, so no route supplies a provider value or
// receiver: a trait requirement cannot take a boundary trait as a parameter
// for an implementation to receive. The requirement is reached by calling it
// directly.
boundary trait Counter {
    machine next(value: i32) -> i32 reaches;
}

trait Use {
    machine apply(counter: &mut Counter) -> i32;
}

machine main() -> i32 {
    0
}
