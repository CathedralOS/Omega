// A reachable fixed-token boundary operator with no satisfier: `==` on these
// operands resolves to `Integer::equal`, a bodyless boundary declaration, and
// nothing satisfies it. Provider admission refuses the program rather than
// substituting builtin equality. The same program with a selected checked
// satisfier is `pass/operators/runtime_selected_operator_requires_after_effects_exit`.
// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish.
domain i32::Counted requires self >= -1000000; self <= 1000000;

boundary machine == Integer::equal(left: i32 in Counted, right: i32 in Counted) -> bool
requires right >= 0;

machine prepare(value: &mut i32 in Counted) -> i32 in Counted
ensures value >= 0 {
    value = 1;
    1
}

machine direct(value: i32 in Counted) -> bool {
    let mut held: i32 in Counted = value;
    prepare(&mut held) == held
}

machine deferred(value: i32 in Counted) -> bool {
    transition { _ -> later(value) }
    machine later(value: i32 in Counted) -> bool {
        let mut held: i32 in Counted = value;
        prepare(&mut held) == held
    }
}

machine through_locals(value: i32 in Counted) -> bool {
    let mut held: i32 in Counted = value;
    let prepared: i32 in Counted = prepare(&mut held);
    let equal: bool = prepared == held;
    equal
}

machine main() crashes Trap {
    let first: bool = direct(5);
    let second: bool = deferred(5);
    let third: bool = through_locals(5);
    transition first && second && third {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
