use omega::language::core::binding;

public boundary trait Reading { machine read() -> i32; }
Reader satisfies Reading { machine read() -> i32 { 42 } }
data Context { reading: Binding<Reading>; }

machine read(binding: &mut Binding<Reading>) -> i32 reaches Reading {
    ((binding.read() as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32
}

machine main() reaches Reading {
    // A carrier's erased native representation is not construction authority.
    let fabricated: Context = Context { reading: Binding {} };
    let value: i32 = read(&mut fabricated.reading);
}
