use omega::language::core::external_binding;
// A table field resolves only in the record the leaf's first parameter
// borrows; a same-named field of another declaration cannot supply it.
data Actual { invoke: addr; }
data Lookalike { other: addr; }
boundary trait Query { machine query(table: &Lookalike) -> u32 reaches; }
windows_x86_64 machine lookalike_query(table: &Lookalike) -> u32
satisfies Query::query via ForeignBinding::TableFunction(invoke);
machine main() reaches Query {
    let table: Lookalike;
    let result: u32 = lookalike_query(&table);
}
