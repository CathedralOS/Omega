use omega::language::core::external_binding;
data Actual { invoke: addr; }
data Lookalike { invoke: addr; }
boundary trait Query { machine query(table: &Lookalike) -> u32; }
windows_x86_64 machine Actual::query(table: &Lookalike) -> u32
satisfies Query::query via ForeignBinding::TableFunction(invoke);
machine main() reaches Query {
    let table: Lookalike;
    let result: u32 = Actual::query(&table);
}
