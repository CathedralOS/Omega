use omega::language::core::service;
// A direct call to a public top-level boundary requirement executes only
// through a selected provider. With no checked adapter satisfying the
// requirement there is no plan to select, and settlement rejects the call
// before either engine could reach the bodyless declaration.
pub boundary trait Console {
    machine exit_process(return_code: i32);
}

pub data CheckedMath {}

pub boundary requirement CheckedMath::offset_zero(value: i32) -> i32;

data Main { console: Binding<Console>; }

machine Main::main(&mut self)
reaches Console
{
    let selected: i32 = CheckedMath::offset_zero(70);
    self.console.exit_process(selected);
}
