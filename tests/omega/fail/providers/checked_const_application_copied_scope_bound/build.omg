machine build(builder: &mut Build) {
    Build::application(builder, "checked_const_application_copied_scope_bound");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Math::remainder, Provider>(builder, linux_arm64);
    Build::select_provider<Math::remainder, Provider>(builder, linux_x86_64);
    Build::select_provider<Math::remainder, Provider>(builder, macos_arm64);
    Build::select_provider<Math::remainder, Provider>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
