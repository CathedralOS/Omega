use omega::language::core::external_binding;
boundary trait Process { machine current() -> u32 reaches; }
boundary trait Other { machine unrelated() reaches; }
trait Restricted { machine current() -> u32 reaches Other; }
data Native {}


RestrictedProvider satisfies Restricted {
    machine current() -> u32 reaches Other, Process {
        Process::current()
    }
}
machine main() {}
