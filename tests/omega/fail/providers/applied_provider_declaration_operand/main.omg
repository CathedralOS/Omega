// Build selects a declaration, never a conformance instance. This applied
// map is otherwise well-formed; its instance arguments cannot become selection.
boundary trait Reading<Value> { machine read(value: Value) -> Value reaches; }
ReadingMap<Value> satisfies Reading<Value> {
    machine read(value: Value) -> Value { value }
}
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Reading, ReadingMap<i32>>(defaults);
}
machine main() {}
