// Named implementations remain distinct candidates. Two complete
// candidates for one demanded slot require an explicit build override; the
// compiler must never merge or choose them by source order.
boundary trait Pick {
    machine choose() -> i32 reaches;
}

FirstProvider satisfies Pick {
    machine choose() -> i32 { 1 }
}

SecondProvider satisfies Pick {
    machine choose() -> i32 { 2 }
}

machine main() -> i32 { Pick::choose() }
