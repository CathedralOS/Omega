// External leaves name a closed ForeignBinding case explicitly. The bare-field
// shorthand belonged only to legacy `provides ... over Table` rows and must
// not make ForeignBinding look like an open, package-extensible sum.
boundary trait Output {
    machine write(this: addr);
}
data OutputTable { write: addr; }
machine OutputTable::write_leaf(this: addr) satisfies Output::write via ForeignBinding::write;

data Main { }
machine Main::main(&mut self) { }
