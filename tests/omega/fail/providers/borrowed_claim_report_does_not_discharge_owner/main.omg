// Disposing of an observation cannot discharge the borrowed owner's claim.
use omega::language::core::drop;
data Token [linear] { value: u64; }
data Report { value: u64; }
boundary trait Reader { machine read(token: &Token) -> Report reaches; }
machine make() -> Token {
    let token: Token = Token { value: 42 };
    token
}
machine main() reaches Reader {
    let token: Token = make();
    let report: Report = Reader::read(&token);
    drop(report);
}
