module mismatch_probe;
use omega_language_std::console;

pub data Conversion {}
pub boundary operator Conversion::read(value: i32) -> i32;
pub boundary operator Conversion::read(value: f64) -> f64;
data Supplier {}
// Presence of an overloaded family cannot authorize this bool signature.
machine Supplier::wrong(value: bool) -> bool satisfies Conversion::read { value }
pub data Main { }
pub machine Main::main(application: &mut Main) reaches Console
invokes Console;
{
    Console::exit_process(0);
}
