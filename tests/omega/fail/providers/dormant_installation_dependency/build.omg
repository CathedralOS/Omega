machine build(builder: &mut Build) {
    Build::application(builder, "dormant_installation_dependency");
    Build::select_provider<Selected, SelectedProvider>(builder, macos_arm64);
    Build::select_provider<Selected, SelectedProvider>(builder, linux_x86_64);
    Build::select_provider<Selected, SelectedProvider>(builder, linux_arm64);
    Build::select_provider<Selected, SelectedProvider>(builder, windows_x86_64);
}
