use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "generic_import_owner_control");
    Build::bind<OtherText::length>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_strlen"
    } });
    Build::bind<OtherText::length>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.2.5"
    } });
    Build::bind<OtherText::length>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "strlen", version: "GLIBC_2.17"
    } });
    Build::bind<OtherText::length>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "msvcrt.dll", export: "strlen"
    } });
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
