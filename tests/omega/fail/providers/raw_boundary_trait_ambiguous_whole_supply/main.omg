// A raw boundary trait whose whole requirement set is supplied by two checked
// providers, both selected for the same target, is ambiguous: Build must not
// choose one by source order or merge them.
public boundary trait RawStamp {
    machine stamp() -> i32 reaches;
}

FirstStampProvider satisfies RawStamp {
    machine stamp() -> i32 { 1 }
}

SecondStampProvider satisfies RawStamp {
    machine stamp() -> i32 { 2 }
}

machine main() reaches RawStamp crashes Trap {
    transition RawStamp::stamp() == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
