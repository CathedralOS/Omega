use omega::language::core::binding;
// The borrowed phantom argument carries an elided region even though neither
// boundary trait declares a lifetime. Erased carrier equality cannot settle
// Parent's competing choices through Child's whole map.
pub boundary trait Parent<Value> { machine read() -> i32; }
pub boundary trait Child: Parent<&u64> { machine choose() -> i32; }
ChildMap satisfies Child {
    Parent::read = shared;
    Child::choose = shared;
}
FirstParentMap satisfies Parent<&u64> { Parent::read = shared; }
SecondParentMap satisfies Parent<&u64> { Parent::read = shared; }
machine shared() -> i32 { 1 }
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}
data Main { child: Binding<Child>; }
machine Main::main(main: &mut Main) reaches Child + Parent {
    let chosen: i32 = Child::choose(&main.child);
}
