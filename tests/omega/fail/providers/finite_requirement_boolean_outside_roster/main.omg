use omega::language::core::binding;
// The Boolean carrier is valid, but the exact public predicate is false.
pub boundary trait Service {
    machine echo<const Selected: bool>(value: i32) -> i32 where Selected == true;
}
Provider satisfies Service { Service::echo = echo; }
machine echo<const Selected: bool>(value: i32) -> i32 { value }
data Providers {}
macos_arm64 machine Providers::provider_defaults(defaults: &mut Providers) {
    Providers::select_provider<Service, Provider>(defaults);
}
data Main { service: Binding<Service>; }
macos_arm64 machine Main::main(main: &mut Main) reaches Service {
    let result: i32 = Service::echo<false>(&main.service, (17 as i32));
}
