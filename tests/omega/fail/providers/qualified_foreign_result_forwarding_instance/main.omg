data Status [copy] { code: u64; }
data Table { read: addr; }
domain<const Axis: u64> u64::Coordinate<Axis>;
boundary trait Reports {
    machine read(table: &Table, value: u64) -> Status
    reaches
    requires value in u64::Coordinate<7>
    ensures result.code == 0;
}


// The domain family matches, but the complete instance does not.
machine wrong(table: &Table, value: u64) -> Status
requires value in u64::Coordinate<8>
ensures result.code == 0; {
    Reports::read(table, value)
}
