// A provider holds no state, so no route supplies a provider value or
// receiver: applying a boundary trait to type arguments still names a
// requirement, so a data field cannot borrow it as runtime data. The
// requirement is reached by calling it directly.
boundary trait Identity<Value> {
    machine identity(value: i32) -> i32 reaches;
}

data Holder {
    identity: &mut Identity<i32>;
}

machine main() -> i32 {
    0
}
