use omega::language::core::drop;
data Root [linear] dropped by drop_root { value: u64; }
machine drop_root(root: &mut Root) {}
domain Root::Granted established by Grant::grant;
boundary trait Grant {
    machine grant(root: Root) -> Root reaches ensures result in Root::Granted;
}
data Main {}
machine Main::main(context: &mut Main) {
    let root: Root = Root { value: 42 };
    transition { _ -> consume(root) }
    machine consume(root: Root in Granted) { drop(root); }
}
