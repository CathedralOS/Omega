use omega_language_std::filesystem;
use omega_language_std::posix_filesystem_host;
use omega::language::core::filesystem_authority;

// A portable binding is not a raw POSIX receiver. Provider dependencies do not
// give the application a second role for the same slot.
//
// RECORDED REACHABILITY GAP. The redesign retired this program's subject:
// `Filesystem` is now an empty declaration and the raw host requirement takes a
// scalar descriptor (`PosixFilesystemHost::write(fd: i32, bytes: &[u8])`), so a
// slot-typed value cannot reach the receiver position at all. Measured: passing
// the portable value yields "argument `fd` for state `write` expects `i32`, got
// `member access`" and "binds a `Filesystem` value into a scalar argument",
// while a `dyn`-selector mismatch yields "a `dyn Second` selector cannot call
// `First::read`: `Second` does not inherit `First`". The authored rule
// "qualified call target belongs to a different requirement"
// (checking/src/declarations/traits/dynamic.rs:816) is still emitted and this
// fixture is its only pin. Filed as `psi:unreached-guard-reachability`: find
// the construct family that reaches 816, or apply the same branch-and-pin
// question as the operator-retention twin.
data Main { filesystem: Filesystem; }
machine Main::main(main: &mut Main) reaches FilesystemContentWrite {
    let result: i64 = PosixFilesystemHost::write(&main.filesystem.host, 1, "x");
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches FilesystemContentWrite {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
