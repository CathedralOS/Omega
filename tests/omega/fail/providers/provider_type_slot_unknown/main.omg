// The slot has a valid candidate, but ReadRoute does not satisfy it.
public boundary trait ExactRead { machine read(value: u8) -> u8 reaches ensures result == value; }
public boundary trait SecondRead { machine observe(value: u8) -> u8 reaches ensures result == value; }
trait LocalForward { machine forward(value: u8) -> u8 ensures result == value; }
ReadRoute satisfies LocalForward {
    machine forward(value: u8) -> u8 satisfies SecondRead::observe
    ensures result == value { value }
}
AvailableRead satisfies ExactRead { machine read(value: u8) -> u8 reaches ensures result == value { value } }
machine main() {}
