machine build(builder: &mut Build) {
    Build::application(builder, "boundary_lent_linear_satisfier_narrowed");
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, linux_arm64);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, linux_x86_64);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, macos_arm64);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, macos_x86_64);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, windows_x86_64);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, uefi_x86_64);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, cross_platform_cli);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, local_unchecked);
    Build::select_provider<TokenScale, TokenScaleProvider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
