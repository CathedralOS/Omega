// A boundary-trait requirement lends a linear value: `weigh(token: &Token)`
// takes a shared loan every satisfier must accept as declared. This satisfier
// narrows the loan to `&Token in Token::Issued`, so a caller lending any
// `Token` would reach a body whose qualification the requirement never
// promised. The conformance check refuses the satisfier at its parameter;
// `pass/providers/runtime_boundary_linear_borrowed_argument_exit` is the
// same program with the satisfier declared as the requirement is.
use omega::language::core::drop;

pub data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
pub domain Token::Issued;

pub boundary trait TokenScale {
    machine weigh(token: &Token) -> u64;
}

data TokenScaleProvider {}

machine TokenScaleProvider::weigh(token: &Token in Token::Issued) -> u64
satisfies TokenScale::weigh
{
    token.value
}

data Main { }

machine Main::main(main: &mut Main) reaches TokenScale {
    let token: Token = Token { value: 11 };
    let direct: u64 = TokenScale::weigh(&token);
    drop(token);
}
