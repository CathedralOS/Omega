// Invalid control: a Windows family call from a linux_x86_64 entry must be
// refused by provider admission rather than silently selecting nothing.

machine build(builder: &mut Build) {
    Build::application(builder, "windows_filesystem_host_unprovided_on_linux");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../source/library/std"
    }));
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
}
