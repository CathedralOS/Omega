// A linux_x86_64 program must not call WindowsFilesystemHost: the family
// trait declares the kernel32 HANDLE seam and only the windows_x86_64 target
// supplies a provider for it. Provider supply must refuse the call.
use omega_language_std::windows_filesystem_host;
use omega_language_std::console;

data Main { }

machine Main::main(main: &mut Main) reaches Console + WindowsFilesystemHost {
    let error: u32 = WindowsFilesystemHost::last_error();
    Console::exit_process(0);
}
