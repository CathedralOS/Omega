use omega::language::core::external_binding;
public data AddressProbe {}
public boundary requirement AddressProbe::release(pointer: addr);
data Imports {}
linux_x86_64 machine release_binding() -> ForeignBinding<9, 4, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "free", version: "GLIBC_2.2.5",
    } }
}
linux_x86_64 machine Imports::release(pointer: u64)
satisfies AddressProbe::release via release_binding();
machine main() {}
