// A machine-level exact edge serves selection only for the requirement it
// names. This member satisfies the sibling requirement `Reading::peek` of the
// same trait, while another provider legitimately satisfies `Reading::read`,
// so selecting it for `Reading` must still reject at admission.

public boundary trait Reading {
    machine read() -> u64 reaches;
    machine peek() -> u64 reaches;
}

data DecoyProvider {}
machine DecoyProvider::read() -> u64 satisfies Reading::read { 7 }

data ReadingProvider {}
machine ReadingProvider::peek() -> u64 satisfies Reading::peek { 42 }

data Session {}
data Main { session: Session; }

machine read() -> u64 reaches Reading {
    Reading::read()
}

machine Main::main(main: &mut Main) reaches Reading crashes Trap {
    let value: u64 = read();
    transition value == 7 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Reading crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
