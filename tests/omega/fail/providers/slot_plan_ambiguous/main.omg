// Two fully covering provider types for one slot on the selected target are
// ambiguous. Implicit selection is only ever unique; a slot owner must choose
// one type explicitly. This pins the derived-plan rule without retaining an
// authored `provides` compatibility table.
boundary trait Pick {
    machine choose() -> i32;
}
data ProviderA { }
data ProviderB { }
cross_platform_cli machine ProviderA::choose_leaf() -> i32 satisfies Pick::choose via Binding::VtableSlot(1);
cross_platform_cli machine ProviderB::choose_leaf() -> i32 satisfies Pick::choose via Binding::VtableSlot(2);
data Main { }
machine Main::main(&mut self) {
}
