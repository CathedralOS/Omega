// A provider holds no state, so no route supplies a provider value or
// receiver: a generic argument of a data field cannot borrow a boundary trait
// either. The requirement is reached by calling it directly.
boundary trait Counter {
    machine next(value: i32) -> i32 reaches;
}

data Envelope<T> {
    payload: T;
}

data Holder {
    envelope: Envelope<&mut Counter>;
}

machine main() -> i32 {
    0
}
