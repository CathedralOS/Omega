use omega_language_std::BoundarySignature;
use omega_language_std::CallingPolicyRejection;
use omega_language_std::BoundaryPlanResult;
use omega_language_std::CallingPolicy;
use omega_language_std::Calling;
RejectCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "direct foreign policy refuses" }
        }
    }
}
boundary trait Process: Calling<RejectCalling> { machine current() -> u32 reaches; }
machine main() reaches Process { let result: u32 = Process::current(); }
