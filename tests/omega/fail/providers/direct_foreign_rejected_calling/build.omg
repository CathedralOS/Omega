use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "direct_foreign_rejected_calling");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::bind(builder, windows_x86_64::ProgramEntry, main);

    Build::bind<Process::current>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "kernel32.dll", export: "GetCurrentProcessId" },
    });
}
