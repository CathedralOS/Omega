// An inherited Parent<u64> roster cannot settle another applied Parent<bool>
// slot merely because the phantom argument does not affect the call ABI.
use omega::language::core::binding;
pub boundary trait Parent<Value> { machine read() -> i32; }
pub boundary trait Child: Parent<u64> { machine choose() -> i32; }
ChildMap satisfies Child {
    Parent::read = shared;
    Child::choose = shared;
}
FirstBoolMap satisfies Parent<bool> { Parent::read = shared; }
SecondBoolMap satisfies Parent<bool> { Parent::read = shared; }
machine shared() -> i32 { 1 }
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
}
data Main { parent: Binding<Parent<bool>>; child: Binding<Child>; }
machine Main::main(main: &mut Main) reaches Child + Parent {
    let chosen: i32 = Child::choose(&main.child);
    let read: i32 = main.parent.read();
}
