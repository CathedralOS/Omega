// Two loaded target packages cannot silently claim different defaults for the
// same slot. The build root may override this explicitly; absent an override,
// the conflict is loud.
boundary trait Pick {
    machine choose() -> i32 reaches;
}

data FirstProvider { }
machine FirstProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (1) }
}

data SecondProvider { }
machine SecondProvider::choose() -> i32 satisfies Pick::choose {
    transition { _ -> (2) }
}

data FirstTargetPackage { }
windows_x86_64 machine FirstTargetPackage::provider_defaults(defaults: &mut FirstTargetPackage) {
    FirstTargetPackage::select_provider<Pick, FirstProvider>(defaults);
}
linux_x86_64 machine FirstTargetPackage::provider_defaults(defaults: &mut FirstTargetPackage) {
    FirstTargetPackage::select_provider<Pick, FirstProvider>(defaults);
}
linux_arm64 machine FirstTargetPackage::provider_defaults(defaults: &mut FirstTargetPackage) {
    FirstTargetPackage::select_provider<Pick, FirstProvider>(defaults);
}
macos_arm64 machine FirstTargetPackage::provider_defaults(defaults: &mut FirstTargetPackage) {
    FirstTargetPackage::select_provider<Pick, FirstProvider>(defaults);
}

data SecondTargetPackage { }
windows_x86_64 machine SecondTargetPackage::provider_defaults(defaults: &mut SecondTargetPackage) {
    SecondTargetPackage::select_provider<Pick, SecondProvider>(defaults);
}
linux_x86_64 machine SecondTargetPackage::provider_defaults(defaults: &mut SecondTargetPackage) {
    SecondTargetPackage::select_provider<Pick, SecondProvider>(defaults);
}
linux_arm64 machine SecondTargetPackage::provider_defaults(defaults: &mut SecondTargetPackage) {
    SecondTargetPackage::select_provider<Pick, SecondProvider>(defaults);
}
macos_arm64 machine SecondTargetPackage::provider_defaults(defaults: &mut SecondTargetPackage) {
    SecondTargetPackage::select_provider<Pick, SecondProvider>(defaults);
}

machine main() { }
