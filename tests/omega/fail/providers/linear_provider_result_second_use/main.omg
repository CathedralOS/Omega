use omega::language::core::drop;

public data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
public boundary trait Relay { machine forward(receipt: Receipt) -> Receipt reaches; }
Adapter satisfies Relay { Relay::forward = forward; }
machine forward(receipt: Receipt) -> Receipt { receipt }

machine main() reaches Relay {
    let result: Receipt = Relay::forward(Receipt { code: 7 });
    drop(result);
    drop(result);
}
