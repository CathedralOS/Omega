
public data Counter { value: i32; }
public boundary trait CounterOperations {
    machine read(counter: &Counter) -> i32 reaches;
}
public boundary trait OtherOperations {
    machine read(counter: &Counter) -> i32 reaches;
}
machine read_counter(counter: &Counter) -> i32
satisfies OtherOperations::read { counter.value }

// Equal names and signatures cannot substitute a different requirement owner.
WrongProvider satisfies CounterOperations {
    OtherOperations::read = read_counter;
}

data Main {
    counter: Counter;
    observed: i32;
}
machine Main::main(main: &mut Main) reaches CounterOperations {
    main.observed = CounterOperations::read(&main.counter);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches CounterOperations {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
