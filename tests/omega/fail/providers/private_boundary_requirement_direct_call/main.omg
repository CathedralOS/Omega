use omega::language::core::binding;
// Only a public, receiver-free top-level boundary requirement may be called
// directly through its selected provider. A private requirement is a symbol
// for contracts, not an executable declaration: the ordinary bodyless
// boundary symbol fence keeps rejecting the call even though an adapter
// satisfies it.
pub boundary trait Console {
    machine exit_process(return_code: i32);
}

data CheckedMath {}

boundary requirement CheckedMath::offset_zero(value: i32) -> i32;

data CheckedMathProvider {}

machine CheckedMathProvider::offset_zero_impl(input: i32) -> i32
satisfies CheckedMath::offset_zero
{
    transition { _ -> (input + 0) }
}

data Main { console: Binding<Console>; }

machine Main::main(&mut self)
reaches Console
{
    let selected: i32 = CheckedMath::offset_zero(70);
    self.console.exit_process(selected);
}
