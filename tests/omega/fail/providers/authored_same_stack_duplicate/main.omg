// A realization admits one same-stack demand.
public boundary trait TextOutput { machine output_string(this: addr) reaches; }
data Protocol { output_string: addr; }
uefi_x86_64 machine Protocol::output(this: addr)
    satisfies TextOutput::output_string
    via ForeignBinding::VtableField(output_string)
    stack 4096 bytes;
    stack 8192 bytes;

machine main() {}
