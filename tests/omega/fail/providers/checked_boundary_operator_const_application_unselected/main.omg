// A provider-dependent const application whose boundary operator never
// gains a selected satisfier has no fold to land: the deferred const
// argument must refuse rather than materialize the application from thin
// air. There is no `Provider` and no build selection, so `limit()`'s `%`
// call has no body the selected execution can run.
use omega::language::core::ProcessExit;

data Math {}

// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish.
domain u64::Operand;
boundary machine % Math::remainder(left: u64 in Operand, right: u64 in Operand) -> u64;

machine limit() -> u64 {
    let left: u64 in Operand = 7;
    let right: u64 in Operand = 2;
    transition { _ -> (left % right) }
}

data Buffer<const N: u64> {
    values: [u8; N];
}

data Main {
    value: Buffer<limit()>;
}

machine Main::main(main: &mut Main) reaches
    ProcessExit
{
    main.value.values[6] = 70;
    ProcessExit::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches
    ProcessExit
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
