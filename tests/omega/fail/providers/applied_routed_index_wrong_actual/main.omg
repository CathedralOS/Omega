data Token { value: u64; }
data Word {}
data Other {}
domain<Value> Token::Issued<Value> established by Supply::issue;
boundary trait Supply<Value> {
    machine issue() -> Token reaches ensures result in Issued<Value>;
    machine forward(value: Token in Issued<Value>) -> Token in Issued<Value> reaches;
}
machine relay<Value>(value: Token in Issued<Value>) -> Token in Issued<Value>
reaches Supply
{
    Supply<Value>::forward(value)
}
machine wrong() reaches Supply {
    let issued: Token in Issued<Word> = Supply<Word>::issue();
    let result: Token in Issued<Other> = relay<Other>(issued);
}
