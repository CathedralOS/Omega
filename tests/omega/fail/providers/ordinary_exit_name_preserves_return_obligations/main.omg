// An ordinary same-named service has normal completion. Confined package
// discovery must not make the caller's false return obligation unreachable.
use omega::language::core::binding;
pub boundary trait Console {
    machine exit_process(return_code: i32) reaches Console;
}
data ReturningProvider {}
machine ReturningProvider::exit_process(return_code: i32)
satisfies Console::exit_process
reaches Console
{}
pub machine impossible(console: &mut Binding<Console>)
reaches Console
invokes console;
ensures false;
{
    console.exit_process(0);
}
