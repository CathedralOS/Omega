// A shared source cannot supply an applied requirement's `&mut` parameter
// that the mutable result borrows from.
pub boundary trait Parent<Value> {
    machine borrow_mut<'source>(value: &'source mut Value) -> &'source mut Value;
}

machine invalid<'source>(value: &'source i32)
    -> &'source mut i32 reaches Parent {
    Parent<i32>::borrow_mut(value)
}
