public boundary trait Service {
    machine echo<const Count: u64>(value: i32) -> i32
    reaches
    where Count == 4 || Count == 8;
}
Provider satisfies Service { Service::echo = echo; }
machine echo<const Count: u64>(value: i32) -> i32 { value }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Service, Provider>(defaults);
}

data Main { }
macos_arm64 machine Main::main(main: &mut Main) reaches Service {
    let value: i32 = Service::echo<16>((17 as i32));
}

// The entry owns ordinary local state; selection supplies no context.
macos_arm64 machine entry_start() reaches Service {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
