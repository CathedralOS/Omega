machine build(builder: &mut Build) {
    Build::application(builder, "public_boundary_wrong_applied_calling_geometry");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<OnceRegistrar, OnceProvider>(builder);
    Build::select_provider<ProcessId, ProcessIdProvider>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
