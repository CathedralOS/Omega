use omega::language::core::binding;
pub data Token [linear] { value: u64; }
pub boundary trait Flow { machine forward(token: Token) -> Token; }
data Provider {}
machine Provider::forward(token: Token) -> Token satisfies Flow::forward { token }
data Harness { flow: Binding<Flow>; }
machine consume(token: Token) -> Token { token }
machine Harness::duplicate(harness: &Harness, token: Token) -> Token reaches Flow {
    let issued: Token = harness.flow.forward(token);
    let first: Token = consume(issued);
    let second: Token = consume(issued);
    first
}
machine main() {}
