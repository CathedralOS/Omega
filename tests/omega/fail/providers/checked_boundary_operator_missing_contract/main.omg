// A checked body is not an admitted leaf: it must prove the boundary
// operator's public result contract before its ProviderPlan can be selected.
use omega::language::core::narrow_u16_to_u8_wrapping;
use omega::language::core::narrow_u16_to_u8_saturating;

data CheckedMath {}

boundary operator CheckedMath::identity(value: i32) -> i32
ensures result == value;

data CheckedMathProvider {}

machine CheckedMathProvider::identity_impl(input: i32) -> i32
satisfies CheckedMath::identity
{
    transition { _ -> (input) }
}

machine main() {}

// The public promise and its provider retain the cast's arithmetic policy.
// At 256, Wrapping yields 0 while Saturating yields 255.
boundary operator CheckedMath::low_byte(value: u16) -> u8
ensures result == (narrow_u16_to_u8_wrapping(value));

machine CheckedMathProvider::low_byte_impl(input: u16) -> u8
satisfies CheckedMath::low_byte
ensures result == (narrow_u16_to_u8_saturating(input))
{
    narrow_u16_to_u8_saturating(input)
}
