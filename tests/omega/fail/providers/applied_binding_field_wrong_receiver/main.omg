// A bool provider cannot settle the same field declaration applied to u8.
// The consumer demands that u8 application; no argument-type mismatch masks it.
// The entry context is an exact data declaration, so the two applications of
// `Session` are exact field types rather than one generic context applied to
// `u64`: provider selection still has to answer the `Session<u8>` field.

public boundary trait Reading<Value> { machine read() -> i32 reaches; }
public boundary trait UnsignedReading: Reading<u64> { machine choose_unsigned() -> i32 reaches; }
public boundary trait BooleanReading: Reading<bool> { machine choose_boolean() -> i32 reaches; }
UnsignedMap satisfies UnsignedReading {
    Reading::read = unsigned_read;
    UnsignedReading::choose_unsigned = choose_unsigned;
}
BooleanMap satisfies BooleanReading {
    Reading::read = boolean_read;
    BooleanReading::choose_boolean = choose_boolean;
}
machine unsigned_read() -> i32 { 37 }
machine boolean_read() -> i32 { 53 }
machine choose_unsigned() -> i32 { 19 }
machine choose_boolean() -> i32 { 29 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<UnsignedReading, UnsignedMap>(defaults);
    TargetProviders::select_provider<BooleanReading, BooleanMap>(defaults);
}
data Session<Value> { value: Value; }
data Wrapper<Value> { value: Value; }
data Main {
    unsigned: Session<u64>;
    boolean: Session<u8>;
    nested: Wrapper<Wrapper<Session<u64>>>;
}
machine unsigned_observed(session: &Session<u64>) -> i32 reaches Reading {
    Reading<u64>::read()
}
machine boolean_observed(session: &Session<u8>) -> i32 reaches Reading {
    Reading<u8>::read()
}
machine Main::main(main: &mut Main)
reaches Reading + UnsignedReading + BooleanReading crashes Trap {
    let first: i32 = unsigned_observed(&main.unsigned);
    let second: i32 = boolean_observed(&main.boolean);
    let nested: i32 = unsigned_observed(&main.nested.value.value);
    let unsigned: i32 = UnsignedReading::choose_unsigned();
    let boolean: i32 = BooleanReading::choose_boolean();
    transition first == 37 && second == 53 && nested == 37 && unsigned == 19 && boolean == 29 {
        true -> done() _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
