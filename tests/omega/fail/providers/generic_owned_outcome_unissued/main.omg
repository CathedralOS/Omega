// Expected exit: 0. Qualified owned payloads survive generic outcomes,
// provider states, nested records, calls and caller-side case selection.
use omega_language_std::process_exit;

public data Token { value: u64; }
public domain Token::Issued established by Issuer::issue, Issuer::nested, mint;
public data Outcome<T> {
    case Ready(value: T);
    case Empty;
}
public data Wrapper<T> { value: T; }
public boundary trait Issuer {
    machine issue(present: bool) -> Outcome<Token in Issued> reaches;
    machine nested() -> Outcome<Wrapper<Wrapper<Token in Issued>>> reaches;
}
machine mint(value: u64) -> Token in Issued { Token { value: value } }
Provider satisfies Issuer {
    machine issue(present: bool) -> Outcome<Token in Issued> {
        transition present {
            true -> ready()
            false -> empty()
        }
        machine ready() -> Outcome<Token in Issued> {
            Outcome::Ready { value: Token { value: 29 } }
        }
        machine empty() -> Outcome<Token in Issued> { Outcome::Empty }
    }
    machine nested() -> Outcome<Wrapper<Wrapper<Token in Issued>>> {
        Outcome::Ready { value: Wrapper { value: Wrapper { value: mint(41) } } }
    }
}
machine observe(value: Token in Issued) -> u64 { value.value }
machine inspect(outcome: Outcome<Token in Issued>) -> u64 {
    transition outcome {
        Outcome::Ready { value } -> observe(value)
        Outcome::Empty -> 0
    }
}
machine inspect_nested(outcome: Outcome<Wrapper<Wrapper<Token in Issued>>>) -> u64 {
    transition outcome {
        Outcome::Ready { value } -> observe(value.value.value)
        Outcome::Empty -> 0
    }
}
machine main() reaches Issuer + ProcessExit {
    let present: u64 = inspect(Issuer::issue(true));
    let absent: u64 = inspect(Issuer::issue(false));
    let nested: u64 = inspect_nested(Issuer::nested());
    transition present == 29 && absent == 0 && nested == 41 {
        true -> good()
        false -> bad()
    }
    machine good() { ProcessExit::exit_process(0); }
    machine bad() { ProcessExit::exit_process(1); }
}
