machine build(builder: &mut Build) {
    Build::application(builder, "owned_outcome");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::accept_boundary<Issuer>(builder);
    Build::select_provider<Issuer, Provider>(builder, linux_arm64);
    Build::select_provider<Issuer, Provider>(builder, linux_x86_64);
    Build::select_provider<Issuer, Provider>(builder, macos_arm64);
    Build::select_provider<Issuer, Provider>(builder, macos_x86_64);
    Build::select_provider<Issuer, Provider>(builder, windows_x86_64);
    Build::select_provider<Issuer, Provider>(builder, uefi_x86_64);
    Build::select_provider<Issuer, Provider>(builder, cross_platform_cli);
    Build::select_provider<Issuer, Provider>(builder, local_unchecked);
    Build::select_provider<Issuer, Provider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
