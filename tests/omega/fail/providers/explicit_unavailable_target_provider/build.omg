machine build(builder: &mut Build) {
    Build::application(builder, "explicit_unavailable_target_provider");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Value, FirmwareValue>(builder, linux_arm64);
    Build::select_provider<Value, FirmwareValue>(builder, linux_x86_64);
    Build::select_provider<Value, FirmwareValue>(builder, macos_arm64);
    Build::select_provider<Value, FirmwareValue>(builder, macos_x86_64);
    Build::select_provider<Value, FirmwareValue>(builder, windows_x86_64);
    Build::select_provider<Value, FirmwareValue>(builder, uefi_x86_64);
    Build::select_provider<Value, FirmwareValue>(builder, cross_platform_cli);
    Build::select_provider<Value, FirmwareValue>(builder, local_unchecked);
    Build::select_provider<Value, FirmwareValue>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
