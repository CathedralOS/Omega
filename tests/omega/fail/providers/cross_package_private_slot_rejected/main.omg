// The dependency's private boundary trait is not selectable from this package:
// `conformances.md:68-69` requires public visibility for cross-package
// selection, so the Build declaration's slot operand resolves to nothing
// visible. The rejected declaration is the Build operand, which makes this twin
// refuse during checked compilation. Its counterpart,
// `pass/providers/cross_package_public_slot_exit`, publishes the same three
// declarations and runs.
use support::values;
use support::values::Hidden;

machine Main::main() reaches Hidden {
    let value: u64 = Hidden::read();
}
