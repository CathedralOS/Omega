data Token { value: u64; }
domain Token::Issued(value) requires value.value == 7 established by Issuer::issue;
boundary trait Issuer {
    machine issue(output: &mut Token) ensures output in Token::Issued;
}
Provider satisfies Issuer {
    machine issue(renamed: &mut Token) { renamed.value = 8; }
}
Later satisfies Issuer {
    machine issue(renamed: &mut Token) {
        transition { _ -> finish(renamed) }
        state finish(output: &mut Token) { output.value = 8; }
    }
}
machine main() {}
