use omega::language::core::binding;

public boundary trait First<Value> { machine read() -> i32; }
public boundary trait Second<Value> { machine read() -> i32; }
public boundary trait Child: First<i32> + Second<u64> {}

data Holder { child: Binding<Child>; }
machine inspect(holder: &Holder) -> i32 reaches Child + First + Second {
    holder.child.read()
}
