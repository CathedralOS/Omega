// One dynamic selector cannot answer a member name that two inherited
// requirements realize differently: `First<i32>::read` and `Second<u64>::read`
// are distinct applications, so `holder.child.read()` is ambiguous even though
// both declare a `read` of the same arity. The former `Binding<Child>` carrier
// is retired; the selector is the surviving receiver, and the obligation this
// fixture pins is unchanged.

trait First<Value> { machine read() -> i32; }
trait Second<Value> { machine read() -> i32; }
trait Child: First<i32> + Second<u64> {}

data Holder { child: dyn Child; }
machine inspect(holder: &Holder) -> i32 {
    holder.child.read()
}