machine build(builder: &mut Build) {
    Build::application(builder, "implicit_method_unused_count_underdetermined");
    Build::select_provider<UnusedCount, CheckedUnusedCount>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<UnusedCount, CheckedUnusedCount>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<UnusedCount, CheckedUnusedCount>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<UnusedCount, CheckedUnusedCount>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
