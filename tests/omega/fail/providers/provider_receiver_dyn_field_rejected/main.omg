// A provider holds no state, so a data field cannot hold a `dyn` boundary
// trait either: no provider-backed field carrier exists for installation to
// establish. The requirement is reached by calling it directly.
boundary trait Counter {
    machine next(value: i32) -> i32 reaches;
}

data Holder {
    counter: dyn Counter;
}

machine main() -> i32 {
    0
}
