machine build(builder: &mut Build) {
    Build::application(builder, "selected_parent_scope");
    Build::select_provider<Child, ChildMap>(builder, macos_arm64);
    Build::select_provider<Child, ChildMap>(builder, linux_arm64);
    Build::select_provider<Child, ChildMap>(builder, linux_x86_64);
    Build::select_provider<Child, ChildMap>(builder, windows_x86_64);
    Build::select_provider<Parent, ParentMap>(builder, macos_arm64);
    Build::select_provider<Parent, ParentMap>(builder, linux_arm64);
    Build::select_provider<Parent, ParentMap>(builder, linux_x86_64);
    Build::select_provider<Parent, ParentMap>(builder, windows_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
