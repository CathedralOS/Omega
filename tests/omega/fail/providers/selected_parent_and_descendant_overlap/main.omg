// Expected exit: 0
// Calling Parent does not demand an unrequested descendant's extra slot.
boundary trait Parent { machine read() -> u64 reaches; }
boundary trait Child: Parent { machine extra() -> u64 reaches; }

ParentMap satisfies Parent { machine read() -> u64 { 73 } }
ChildMap satisfies Child {
    machine read() -> u64 { 11 }
    machine extra() -> u64 { 19 }
}

machine main() reaches Parent crashes Trap {
    let value: u64 = Parent::read();
    transition value == 73 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
