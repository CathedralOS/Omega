// A second view cannot supply the first view's bounds contract.
boundary trait Window {
    machine at(first: &[u8], second: &[u8], index: u64) -> u8
    reaches
    requires index < first.len;
}

data Provider {}
machine Provider::at(first: &[u8], second: &[u8], index: u64) -> u8
satisfies Window::at
requires index < second.len {
    second[index]
}
machine main() {}
