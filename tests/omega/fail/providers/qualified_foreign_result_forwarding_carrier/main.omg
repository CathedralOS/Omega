data Status [copy] { code: u64; }
data Table { read: addr; }
data Guid [copy] { value: u64; }
data View { protocol: &mut Guid; }
domain Guid::Selected requires self.value == 42;
boundary trait Reports {
    machine read(table: &Table, view: View) -> Status
    reaches
    requires view.protocol in Guid::Selected
    ensures result.code == 0;
}


// Owning the descriptor carrier does not detach its live reference leaves.
machine wrong(table: &Table, view: View) -> Status
requires view.protocol in Guid::Selected
ensures result.code == 0; {
    view.protocol.value = 0;
    Reports::read(table, view)
}
