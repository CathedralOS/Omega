// Equal realizer bodies do not permit mixing selecting owners. The Child
// choice owns Parent's entire roster; another authored Parent map competes.
public boundary trait Parent { machine read() -> i32 reaches; }
public boundary trait Child: Parent { machine choose() -> i32 reaches; }
ChildMap satisfies Child {
    Parent::read = shared;
    Child::choose = shared;
}
ParentMap satisfies Parent { Parent::read = shared; }
machine shared() -> i32 { 1 }
data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, ChildMap>(defaults);
    TargetProviders::select_provider<Parent, ParentMap>(defaults);
}
data Main { }
machine Main::main(main: &mut Main) reaches Child + Parent {
    let chosen: i32 = Child::choose();
    let read: i32 = Parent::read();
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Child + Parent {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
