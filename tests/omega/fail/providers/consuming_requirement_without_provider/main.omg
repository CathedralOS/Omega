// A reachable consuming boundary requirement with no provider: `Receipt::ack`
// is declared and called, but nothing satisfies it, so provider admission
// refuses the program instead of inventing a disposition for the receipt.
// `pass/ownership/linear_transfer_and_consume` is the same program with an
// external sink satisfying the requirement.
use omega_language_std::console;

data Receipt [linear] {
    code: i32;
}

boundary requirement Receipt::ack(receipt: Receipt);

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let issued: Receipt = Receipt { code: 7 };
    let forwarded: Receipt = issued;
    Receipt::ack(forwarded);
    Console::exit_process(0);
}
