data Token { value: u64; }
domain Token::Opaque;
domain Token::Issued
requires self in Token::Opaque, self.value == 7
established by Issuer::issue;
boundary trait Issuer { machine issue() -> Token reaches ensures result in Token::Issued; }
Provider satisfies Issuer { machine issue() -> Token { Token { value: 8 } } }
machine main() {}
