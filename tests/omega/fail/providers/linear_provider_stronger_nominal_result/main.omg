use omega::language::core::drop;
public data Token [linear] { value: i32; }
machine Token::drop(token: &mut Token) {}
public domain Token::Marked;
public data Box<T> { token: T; }
public boundary trait Flow { machine issue() -> Box<Token> reaches; }
data Provider {}
machine Provider::issue() -> Box<Token in Token::Marked> satisfies Flow::issue {
    let token: Token in Token::Marked = Token { value: 7 };
    Box { token: token }
}
machine main() {}
