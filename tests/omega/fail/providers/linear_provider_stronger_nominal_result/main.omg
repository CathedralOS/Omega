use omega::language::core::drop;
pub data Token [linear] { value: i32; }
machine Token::drop(token: &mut Token) {}
pub domain Token::Marked;
pub data Box<T> { token: T; }
pub boundary trait Flow { machine issue() -> Box<Token>; }
data Provider {}
machine Provider::issue() -> Box<Token in Token::Marked> satisfies Flow::issue {
    let token: Token in Token::Marked = Token { value: 7 };
    Box { token: token }
}
machine main() {}
