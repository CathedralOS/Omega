// A provider is its satisfier machines and holds no state: a satisfier
// declares no parameter its requirement lacks. Each conformance path below
// adds a leading provider-state parameter that its requirement does not
// declare, and each rejects for that reason. No caller could supply that
// parameter without an implicit provider receiver.

data TallyState { total: u32; }

pub boundary trait Tally {
    machine add(amount: u32) -> u32;
    machine reset() -> u32;
}

// Exact satisfaction edge.
data DirectTally {}
machine DirectTally::add(state: &mut TallyState, amount: u32) -> u32
satisfies Tally::add
{
    amount
}

// Named implementation map: an inline row and an exact reference row.
machine stateful_reset(state: &mut TallyState) -> u32 {
    0
}
MappedTally satisfies Tally {
    machine add(state: &mut TallyState, amount: u32) -> u32 {
        amount
    }
    Tally::reset = stateful_reset;
}

// Foreign-bound external leaf.
boundary trait Process {
    machine exit(code: i32);
}
machine stateful_exit(state: &mut TallyState, code: i32)
satisfies Process::exit
via ForeignBinding::Syscall(60);

// Top-level, operator and token-bearing boundary requirements.
pub data Arithmetic {}
pub boundary requirement Arithmetic::count(value: u64) -> u64;
boundary operator Arithmetic::offset(value: i32) -> i32;
boundary machine - Arithmetic::select_left(left: i32, right: i32) -> i32;

machine stateful_count(state: &mut TallyState, value: u64) -> u64
satisfies Arithmetic::count
{
    value
}
machine stateful_offset(state: &mut TallyState, value: i32) -> i32
satisfies Arithmetic::offset
{
    value
}
machine stateful_select_left(state: &mut TallyState, left: i32, right: i32) -> i32
satisfies Arithmetic::select_left
{
    left
}

machine main() { }
