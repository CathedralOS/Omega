// One erased lifetime parameter of `combined` cannot take two conflicting
// ordinary borrow constraints in a single call: its two arguments carry
// different source regions. The former `Binding<Reading<&'r i32>>` carrier is
// retired; the surviving carrier is a data type whose field is that reference,
// so the obligation this fixture pins is unchanged and still reached.

data Slot<'r> { value: &'r i32; }
machine combined<'source>(first: &Slot<'source>, second: &Slot<'source>) -> i32 { 0 }
data Main<'left, 'right> {
    left: Slot<'left>;
    right: Slot<'right>;
}
machine Main::main<'left, 'right>(main: &mut Main<'left, 'right>) {
    let observed: i32 = combined(&main.left, &main.right);
}