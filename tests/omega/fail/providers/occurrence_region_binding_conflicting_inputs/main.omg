use omega::language::core::binding;

public boundary trait Reading<Value> { machine read(value: Value) -> i32; }
BorrowedReading<'provider> satisfies Reading<&'provider i32> {
    Reading::read = read;
}
machine read<'provider>(value: &'provider i32) -> i32 { value as i32 }
machine combined<'source>(first: &Binding<Reading<&'source i32>>,
    second: &Binding<Reading<&'source i32>>, value: &'source i32) -> i32 reaches Reading {
    first.read(value)
}
data Main<'left, 'right> {
    first: Binding<Reading<&'left i32>>;
    second: Binding<Reading<&'right i32>>;
    value: i32;
}
machine Main::main<'left, 'right>(main: &mut Main<'left, 'right>) reaches Reading {
    let observed: i32 = combined(&main.first, &main.second, &main.value);
    let first: &Binding<Reading<&'left i32>> = &main.first;
    let second: &Binding<Reading<&'right i32>> = &main.second;
    let saved: i32 = combined(first, second, &main.value);
}
