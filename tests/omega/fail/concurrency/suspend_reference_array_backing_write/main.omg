
pub boundary trait Scheduler { machine advance() suspends; }

machine invalid() suspends; reaches Scheduler {
    let mut backing: i32 = 42;
    let references: [&i32; 2] = [&backing, &backing];
    suspend Scheduler::advance();
    let first: i32 = references[0];
    backing = 99;
    let second: i32 = references[1];
}

machine main() {}
