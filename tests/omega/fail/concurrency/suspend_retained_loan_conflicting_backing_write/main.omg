
pub boundary trait Scheduler { machine advance() suspends; }
machine observe(value: &i32) -> i32 { value }

machine invalid() suspends; reaches Scheduler {
    let mut backing: i32 = 40;
    let retained: &i32 = &backing;
    suspend Scheduler::advance();
    backing = 99;
    let observation: i32 = observe(retained);
}

machine main() {}
