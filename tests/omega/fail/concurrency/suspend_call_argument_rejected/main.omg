use omega::language::core::service;
pub data Cell {
    value: i32;
}

pub data Message {
    body: &Cell;
}

pub boundary trait Scheduler {
    machine park(message: Message) suspends;
}

data Main {
    scheduler: Binding<Scheduler>;
    cell: Cell;
}

machine Main::main(&mut self) suspends; reaches Scheduler {
    let message: Message = Message { body: &self.cell };
    suspend self.scheduler.park(message);
}
