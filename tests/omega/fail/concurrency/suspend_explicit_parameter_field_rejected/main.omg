use omega::language::core::binding;

boundary data Lease;

data Message {
    lease: Lease;
    value: i32;
}
pub boundary trait Scheduler { machine park() suspends; }

// A field read keeps its explicit parameter root live across the call.
machine inspect(message: Message, scheduler: Binding<Scheduler>)
suspends; reaches Scheduler {
    suspend scheduler.park();
    let value: i32 = message.value;
}

machine main() {}
