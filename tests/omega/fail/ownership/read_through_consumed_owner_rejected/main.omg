// An ordinary machine with a by-value parameter consumes its argument exactly
// as `drop` does; neither the name `drop` nor a cleanup hook decides the
// transfer. After `consume(g)` the caller's `g` holds no established value,
// so reading `g.handle` through it rejects.

data Guard {
    handle: i32;
}

machine consume(value: Guard) {
}

data Main {}

machine Main::main() -> i32 {
    let g: Guard = Guard { handle: 7 };
    consume(g);
    g.handle
}
