use omega::language::core::external_binding;

data Receipt [linear] {
    code: i32;
}

// Hook-less linear obligation: the declared consuming contract is the
// authorized terminal disposition.
boundary requirement Receipt::ack(receipt: Receipt);

data ReceiptSink {}


machine consume(receipt: Receipt) -> i32 {
    Receipt::ack(receipt);
    17
}
machine forward(receipt: Receipt) -> Receipt { receipt }
data Envelope { receipt: Receipt; }
machine consume_envelope(envelope: Envelope) -> i32 { consume(envelope.receipt) }
machine first(left: i32, right: i32) -> i32 { left }
machine invalid(choice: i32) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    match choice {
        0 -> first(consume(forward(receipt)), consume(receipt)),
        consume(receipt) -> 17,
        _ -> 23,
    }
}
