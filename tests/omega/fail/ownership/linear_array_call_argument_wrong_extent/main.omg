// Value-position calls owe the same recursive array formation checks as
// statement calls, even when every supplied child has valid linear custody.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

machine make(code: i32) -> Receipt {
    let receipt: Receipt = Receipt { code: code };
    receipt
}

machine settle(receipts: [Receipt; 2]) -> i32 {
    let first: Receipt = receipts[0];
    let second: Receipt = receipts[1];
    drop(first);
    drop(second);
    0
}

machine settle_nested(receipts: [[Receipt; 1]; 2]) -> i32 {
    let first: Receipt = receipts[0][0];
    let second: Receipt = receipts[1][0];
    drop(first);
    drop(second);
    0
}

machine pair() -> [Receipt; 2] {
    [make(1), make(2)]
}

machine settle_one_row(receipts: [[Receipt; 1]; 1]) -> i32 {
    let first: Receipt = receipts[0][0];
    drop(first);
    0
}

machine main() {
    let wrong_outer: i32 = settle([make(1)]);
    let wrong_inner: i32 = settle_nested([[make(1)], [make(2), make(3)]]);
    let wrong_selected: i32 = settle(match true {
        true -> [make(1)], false -> [make(2)]
    });
    let wrong_computed_row: i32 = settle_one_row([pair()]);
}
