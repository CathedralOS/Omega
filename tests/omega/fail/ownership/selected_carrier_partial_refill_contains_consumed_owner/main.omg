data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; stamp: i32; }

machine invalid(first: &Cell, second: &Cell, selected: bool) -> i32 {
    let mut held: Held = Held { target: first, stamp: 12 };
    let other: Held = Held { target: second, stamp: 13 };
    let chosen: Held = match selected { true -> held, false -> other };
    // Establishing a scalar child cannot refill the consumed containing owner.
    held.stamp = 14;
    chosen.target.value
}
