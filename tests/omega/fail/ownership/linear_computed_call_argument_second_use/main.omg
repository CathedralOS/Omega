// FAIL: a computed call inside an arithmetic expression receives a linear
// local by value; a later call cannot receive it again.
data Receipt [linear] { code: i32; }

boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    ReceiptAck::ack(receipt);
    observed
}

machine main() {
    let local: Receipt = Receipt { code: 4 };
    let offset: i32 = ((consume(local) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    let again: i32 = consume(local);
}
