// Moving one region cannot discharge a neighboring linear region, whether
// the optional payload is known present or its case is still unknown.
data Token [linear] { value: u32; }
data Slot { case Empty; case Held(token: Token); }
data Mixed { required: Token; slot: Slot; }

machine forget_required(value: Mixed) -> Slot { value.slot }
machine forget_unknown(value: Mixed) -> Token { value.required }

machine forget_selected_payload(required: Token, payload: Token) -> Token {
    let known: Mixed = Mixed {
        required: required,
        slot: Slot::Held { token: payload }
    };
    known.required
}

machine main() {}
