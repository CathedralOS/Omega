// A skipped path may retain runtime custody, but a later source use cannot
// assume the condition skipped a move on every admitted invocation.
data Token { value: u64; }
data Wrapped { token: Token; }
machine consume(value: Wrapped) -> u64 { value.token.value }
machine choose(enabled: bool) -> u64 {
    let token: Token = Token { value: 9 };
    let observed: bool = enabled && consume(Wrapped { token: token }) == 9;
    token.value
}
machine main() -> u64 { choose(false) }
