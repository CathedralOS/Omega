use omega::language::core::drop;
pub data Token [linear] { code: u8; }
machine Token::drop(token: &mut Token) {}
pub domain Token::Issued established by TokenRoot::grant;
pub boundary trait TokenRoot {
    machine grant(token: Token) -> Token ensures result in Token::Issued;
}
machine observe(first: Token in Issued, second: Token in Issued) {
    drop(first);
    drop(second);
}
machine invalid() reaches TokenRoot {
    let token: Token = TokenRoot::grant(Token { code: 11 });
    observe(token, token);
}
