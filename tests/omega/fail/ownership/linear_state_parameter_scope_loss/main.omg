// FAIL: a linear value crosses into a state that consumes a different value
// and never disposes of the one it received.
data Receipt [linear] { code: i32; }

boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    ReceiptAck::ack(receipt);
    observed
}

machine main() {
    let issued: Receipt = Receipt { code: 1 };
    transition { _ -> holding(issued) }

    machine holding(held: Receipt) {
        let observed: i32 = consume(Receipt { code: 2 });
    }
}
