// A mutable index names storage, not the earlier selected value. Re-spelling
// it after mutation must not repair the original hole.
data Token dropped by drop_token { byte: i32; }
machine drop_token(token: &mut Token) { token.byte = 0; }

machine misplaced(tokens: &mut [Token])
requires tokens.len >= 2
{
    let mut at: u64 = 0;
    let first: Token = tokens[at];
    at = 1;
    tokens[at] = first;
}
machine main() {}
