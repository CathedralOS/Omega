machine build(builder: &mut Build) {
    Build::application(builder, "selected_restoration_unrelated_root");
    let borrowed_partition_support_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../support/borrowed_partition_support" }));
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
