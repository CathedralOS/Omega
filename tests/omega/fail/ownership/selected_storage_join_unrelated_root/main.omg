// Reject: the replacement branch supplies a fresh root, not the original content.
use borrowed_partition_support::main;
use omega::language::core::content;
use omega::language::core::drop;
machine rejoin(whole: Region in Owned, select: bool) -> Region
requires whole.length == 48
ensures result in Owned, result.length == 48,
    Owned::content(old(&whole)) == Owned::content(&result)
{
    let mut strategy: Strategy = Strategy { tail: whole, remaining: 48 };
    let first: Region in Owned = match select {
        true -> carve(&mut strategy, 48, 16),
        false -> replace_and_carve(&mut strategy),
    };
    let { length as first_length } = first;
    let { length as rest_length } = strategy.tail;
    Region { length: first_length + rest_length }
}
machine exercise(select: bool) -> bool {
    let returned: Region in Owned = rejoin(issue(), select);
    let correct: bool = returned.length == 48;
    drop(returned);
    correct
}
machine main() crashes Trap {
    transition exercise(true) && exercise(false) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine replace_and_carve(strategy: &mut Strategy) -> Region in Owned
requires strategy.tail.length == 48
ensures result.length == 16, strategy.tail.length == 32, strategy.remaining == 32
{
    let previous: Region in Owned = strategy.tail;
    drop(previous);
    let parts: Parts = partition(issue(), 16);
    strategy.tail = parts.rest;
    strategy.remaining = 32;
    parts.taken
}
