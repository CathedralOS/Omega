use omega::language::core::drop;
data Token [linear] dropped by drop_token { value: i32; }
machine drop_token(token: &mut Token) {}
machine consume(token: Token) -> i32 { drop(token); 0 }
data Envelope { token: Token; }
machine after(first: i32, envelope: Envelope) -> i32 { consume(envelope.token) }
machine invalid(token: Token, choice: bool) -> i32 {
    let selected: i32 = match choice {
        true -> after(consume(token), Envelope { token: token }),
        false -> after(0, Envelope { token: token }),
    };
    selected
}
