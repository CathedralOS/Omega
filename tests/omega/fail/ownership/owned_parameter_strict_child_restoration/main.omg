// A consumed parameter has no containing value through which a child store
// can establish a replacement. Only an exact or containing whole store can.
data Holder { value: i32; }

machine consume(holder: Holder) {}

machine invalid(prefix: i32, mut holder: Holder) {
    consume(holder);
    holder.value = prefix;
}

machine main() {
    invalid(7, Holder { value: 1 });
}
