// FAIL canary (decision 21): an explicitly constructed linear value creates
// one obligation and may not disappear through ordinary scope cleanup.
data Receipt [linear] {
    code: i32;
}

data Main {}

machine Main::main() -> i32 {
    let receipt: Receipt = Receipt { code: 7 };
    // Observing a scalar lends the storage; it cannot discharge its owner.
    let observed: i32 = receipt.code;
    0
}
