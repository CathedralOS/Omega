// FAIL: a projected owned argument moves exactly the claim beneath its path; the same member cannot be projected into a second call.
data Receipt [linear] { code: i32; }

boundary requirement Receipt::ack(receipt: Receipt);

data Pair { left: Receipt; right: Receipt; }

machine pass(receipt: Receipt) -> Receipt {
    receipt
}

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine issue(first: i32, second: i32) -> Pair {
    let left: Receipt = Receipt { code: first };
    let right: Receipt = Receipt { code: second };
    Pair { left: left, right: right }
}

machine settle(pair: Pair) {
    let left: Receipt = pair.left;
    let right: Receipt = pair.right;
    Receipt::ack(left);
    Receipt::ack(right);
}

machine main() {
    let first: Pair = issue(1, 2);
    Receipt::ack(first.left);
    Receipt::ack(first.left);
    Receipt::ack(first.right);
}
