data Receipt [linear] { code: i32; }
boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}
machine consume(receipt: Receipt) -> i32 {
    ReceiptAck::ack(receipt);
    17
}
machine incomplete(choice: bool) -> i32 {
    let receipt: Receipt = Receipt { code: 17 };
    transition choice {
        true -> (consume(receipt))
        false -> (23)
    }
}
