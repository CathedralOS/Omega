use omega::language::core::CountedQuantity;
use omega::language::core::Content;
use omega::language::core::drop;
data Slot { }
data Capacity [linear] dropped by drop_capacity { }
domain Capacity::Held established by acquire;
machine Held::content(capacity: &Capacity) -> CountedQuantity<Slot>
satisfies Content<Capacity, CountedQuantity<Slot>>::project {
 CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
machine drop_capacity(capacity: &mut Capacity) { }
machine acquire() -> Capacity in Capacity::Held { Capacity { } }
// No authorized origin for Held is in this parameter's contract. Unlike
// weakening and requalifying an already-held claim, this would mint authority.
machine forge(capacity: Capacity) -> Capacity in Capacity::Held {
 capacity as Capacity in Capacity::Held
}
machine main() {}
