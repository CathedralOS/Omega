data Token [linear] { value: u64; }
domain Token::Issued established by issue;
data Slot { case Empty; case Held(token: Token); }
data Inventory { slots: [Slot; 2048]; }
machine issue(value: u64) -> Token in Issued { Token { value: value } }
machine value(token: &Token in Issued) -> u64 { token.value }
machine invalid(inventory: &Inventory, position: u64) -> u64
requires position < 2048
{
    transition &inventory.slots[position] {
        Slot::Empty -> 0
        Slot::Held { token } -> value(token)
    }
}
