// The receiving array retains a separate obligation below each index.
// Consuming one does not discharge its sibling.
data Receipt [linear] { code: i32; }
boundary requirement Receipt::ack(receipt: Receipt);
machine settle(receipts: [Receipt; 2]) {
    Receipt::ack(receipts[0]);
}
machine make(code: i32) -> Receipt {
    let receipt: Receipt = Receipt { code: code };
    receipt
}
machine main() {
    settle([make(1), make(2)]);
}
