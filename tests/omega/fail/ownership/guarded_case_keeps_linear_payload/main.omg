// Missing a guarded arm does not prove that its payload is absent.
// When selected is false, the Held receipt still needs a disposition.
data Receipt [linear] { code: i32; }
data Choice { case Empty; case Held(receipt: Receipt); }
boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}
machine consume(receipt: Receipt) -> i32 {
    ReceiptAck::ack(receipt);
    17
}
machine selected(value: Choice, selected: bool) -> i32 {
    match value {
        Choice::Held { receipt } if selected -> consume(receipt),
        _ -> 23,
    }
}
