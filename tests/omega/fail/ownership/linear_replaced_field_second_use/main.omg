// A replacement brings one new claim, not permission to consume it twice.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }

machine make(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine consume(receipt: Receipt) { drop(receipt); }

machine main() {
    let mut pair: Pair = Pair { left: make(1), right: make(2) };
    consume(pair.left);
    pair.left = make(3);
    consume(pair.left);
    consume(pair.left);
    consume(pair.right);
}
