// FAIL: a linear value carried into a state is consumed by a call there and
// then carried again across the state's edge; a claim transfers only once.
data Receipt [linear] { code: i32; }

boundary requirement Receipt::ack(receipt: Receipt);

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    Receipt::ack(receipt);
    observed
}

machine main() {
    let issued: Receipt = Receipt { code: 1 };
    transition { _ -> holding(issued) }

    machine holding(held: Receipt) {
        let observed: i32 = consume(held);
        transition { _ -> again(held) }
    }

    machine again(last: Receipt) {
        Receipt::ack(last);
    }
}
