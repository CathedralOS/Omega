data Receipt [linear] {
    code: i32;
}

machine Receipt::ack(self) {}

data Pair {
    left: Receipt;
    right: Receipt;
}

data Main {}

machine Main::pack(swap: bool, left: Receipt, right: Receipt) -> Pair {
    transition swap {
        false -> (Pair { left: left, right: right })
        true -> (Pair { left: right, right: left })
    }
}

machine Main::issue(&mut self) -> Pair {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    // Each output path names a different input on different terminal arms, so
    // the checked callee can only record a conditional claim join. Checked
    // semantics admits the join as evidence; production refuses because
    // Terminal has no exit-alternative correspondence for it yet.
    transition { _ -> Main::pack(false, left, right) }
}

machine Main::main(&mut self) {
    let returned: Pair = self.issue();
    let left: Receipt = returned.left;
    let right: Receipt = returned.right;
    Receipt::ack(left);
    Receipt::ack(right);
}
