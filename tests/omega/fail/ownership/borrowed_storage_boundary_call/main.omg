boundary machine sample() -> i32 ensures true;

machine wrapped_sample() -> i32 { sample() }

data Inventory { slots: i32; }
data Main { inventory: Inventory; }

machine Main::replace(main: &mut Main) {
    let taken: Inventory = main.inventory;
    let reading: i32 = wrapped_sample();
    main.inventory = move taken;
}

machine Main::main() -> i32 { 0 }
