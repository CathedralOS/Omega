data Receipt [linear] dropped by drop_receipt { code: u64; }
machine drop_receipt(receipt: &mut Receipt) {}
data Parent [linear] dropped by drop_parent { receipt: Receipt; }
machine drop_parent(parent: &mut Parent) {}

machine main() {
    let receipt: Receipt = Receipt { code: 7 };
    let parent: Parent = Parent { receipt: receipt };
    let repeated: Receipt = receipt;
}
