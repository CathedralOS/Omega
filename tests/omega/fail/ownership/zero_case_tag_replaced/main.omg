// The exact stored sibling loses its zero-selected tag after replacement.
domain u64::Positive(value) requires value > 0;
data Slot { case Empty; case Held(value: u64 in Positive); }
data Inventory { slots: [Slot; 4]; }
machine empty(slot: &Slot) requires slot in Slot::Empty {}
machine invalid() -> Inventory {
    let mut inventory: Inventory;
    inventory.slots[0] = Slot::Held { value: 7 };
    empty(&inventory.slots[0]);
    inventory
}
