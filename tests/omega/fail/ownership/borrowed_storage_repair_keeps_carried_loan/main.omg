data Carrier<'storage> { reference: &'storage i32; }
data Holder<'storage> { carrier: Carrier<'storage>; }

machine identity<'storage>(carrier: Carrier<'storage>) -> Carrier<'storage> {
    carrier
}

machine repair<'storage>(holder: &mut Holder<'storage>) {
    let removed: Carrier<'storage> = holder.carrier;
    holder.carrier = identity(removed);
}

machine main() -> i32 {
    let mut backing: i32 = 42;
    let mut holder: Holder = Holder {
        carrier: Carrier { reference: &backing }
    };
    repair(&mut holder);
    backing = 7;
    holder.carrier.reference
}
