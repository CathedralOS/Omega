// Retiring an absent payload never permits a second transfer of a live one.
use omega::language::core::drop;

data Token [linear] { value: u32; }
machine Token::drop(token: &mut Token) {}
data Slot { case Empty; case Held(token: Token); }
data Holder { slot: Slot; }

machine forward(value: Holder) -> Holder { value }
machine consume(value: Holder) {
    transition value.slot {
        Slot::Empty -> done()
        Slot::Held { token } -> drop(token)
    }
    machine done() {}
}

machine main() {
    let value: Holder = Holder { slot: Slot::Held { token: Token { value: 70 } } };
    let first: Holder = forward(Holder { slot: value.slot });
    let second: Holder = forward(Holder { slot: value.slot });
    consume(first);
    consume(second);
}
