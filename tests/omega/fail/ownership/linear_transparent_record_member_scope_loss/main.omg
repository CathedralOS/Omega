// FAIL canary (decision 21): a transparent affine record contributes no
// nominal claim of its own, so each contained linear member is an independent
// path-indexed obligation. Extracting and consuming one member leaves the
// other undischarged, and ordinary scope cleanup may not retire it.
data Receipt [linear] {
    code: i32;
}

boundary requirement Receipt::ack(receipt: Receipt);

data Pair {
    left: Receipt;
    right: Receipt;
}

data Main {}

machine Main::main() -> i32 {
    let left: Receipt = Receipt { code: 1 };
    let right: Receipt = Receipt { code: 2 };
    let pair: Pair = Pair { left: left, right: right };
    let extracted_left: Receipt = pair.left;
    Receipt::ack(extracted_left);
    0
}
