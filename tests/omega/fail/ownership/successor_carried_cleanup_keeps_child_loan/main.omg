// Forwarding the cleanup receiver does not dispose its child on departure.
// Its parent cannot be supplied alongside that still-live exclusive loan.
data Counter { value: u64; }
data Cleanup { counter: &mut Counter; }

machine Cleanup::drop(cleanup: &mut Cleanup) {
    cleanup.counter.value = 17;
}

machine internal(counter: &mut Counter) -> u64 {
    let cleanup: Cleanup = Cleanup { counter: counter };
    transition { _ -> entered(cleanup, counter) }
    machine entered(cleanup: Cleanup, counter: &mut Counter) -> u64 {
        counter.value = 29;
        counter.value
    }
}

machine main() -> u64 {
    let mut counter: Counter = Counter { value: 0 };
    internal(&mut counter)
}
