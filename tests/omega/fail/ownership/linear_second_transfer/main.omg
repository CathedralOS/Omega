// FAIL canary (decision 21): transfer is conservation, not copying. A place
// cannot supply the same linear obligation twice.
data Receipt [linear] {
    code: i32;
}

boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

data Main {}

machine Main::main() -> i32 {
    let receipt: Receipt = Receipt { code: 7 };
    ReceiptAck::ack(receipt);
    ReceiptAck::ack(receipt);
    0
}
