use omega::language::core::drop;

data Token<Payload> [linear] { payload: Payload; }
machine Token::drop(token: &mut Token<Payload>) {}

machine make<Payload>(payload: Payload) -> Token<Payload> {
    Token { payload: payload }
}

machine main() {
    let token: Token<i32> = make(41);
    drop(token);
    drop(token);
}
