use omega::language::core::drop;

data Token<Payload> [linear] dropped by drop_token<Payload> { payload: Payload; }
machine drop_token<Payload>(token: &mut Token<Payload>) {}

machine make<Payload>(payload: Payload) -> Token<Payload> {
    Token { payload: payload }
}

machine main() {
    let token: Token<i32> = make(41);
    drop(token);
    drop(token);
}
