// A later argument in the same selected arm cannot read an already moved owner.
data Ticket { value: u64; }
machine take(ticket: Ticket) -> u64 { ticket.value }
machine compare(left: u64, right: u64) -> bool { left == right }
machine invalid(selected: bool, ticket: Ticket) -> bool {
    match selected {
        true -> compare(take(ticket), ticket.value)
        false -> true
    }
}
