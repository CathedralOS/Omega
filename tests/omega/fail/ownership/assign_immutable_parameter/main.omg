data Main {
    value: i32;
}

machine Main::main(main: &mut Main) -> i32 {
    transition {
        _ -> overwrite(main.value)
    }
    

    state overwrite(input_value: i32) {
        input_value = 2;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown() {
        0
    }
}
