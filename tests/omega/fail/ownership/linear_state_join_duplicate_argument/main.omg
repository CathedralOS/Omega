// Destination-local claim names cannot duplicate a single incoming obligation.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

machine exchange(swap: bool, left: Receipt, right: Receipt) {
    transition swap {
        true -> received(right, left)
        _ -> received(left, left)
    }
    machine received(first: Receipt, second: Receipt) {
        drop(first);
        drop(second);
    }
}
machine main() {
    exchange(false, Receipt { code: 1 }, Receipt { code: 2 });
}
