// FAIL canary (decision 21): one path transfers the receipt while the other
// retains it at state exit. Resource joins reconcile exactly.
data Receipt [linear] { code: i32; }
boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

data Main { choose_first: bool; }

machine Main::main(main: &mut Main) -> i32 {
    let receipt: Receipt = Receipt { code: 7 };
    transition main.choose_first {
        true -> consume(receipt)
        _ -> leave_live()
    }

    machine consume(receipt: Receipt) -> i32 {
        ReceiptAck::ack(receipt);
        0
    }

    machine leave_live() -> i32 { 0 }
}
