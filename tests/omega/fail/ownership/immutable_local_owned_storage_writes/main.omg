// An ordinary local declared without `mut` cannot modify its own storage
// (ownership.md, owned local mutability): writing an owned field, writing an
// array element and lending `&write` each need a `mut` binding.
data Pair { first: u8; second: u8; }

machine put(value: &write u8) { value = 5; }

machine main() {
    let pair: Pair = Pair { first: 1, second: 2 };
    pair.first = 3;
    let values: [u8; 2] = [1, 2];
    values[0] = 3;
    let slot: u8 = 1;
    put(&write slot);
}
