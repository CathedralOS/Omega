// A nominal cleanup still uses the exclusive child. Last explicit use does
// not restore its parent for a call evaluated before the cleanup.
data Counter { value: u64; }
data Cleanup { counter: &mut Counter; }

machine Cleanup::drop(cleanup: &mut Cleanup) {
    cleanup.counter.value = 17;
}

machine prepare(counter: &mut Counter) -> u64 {
    counter.value = 7;
    counter.value
}

machine internal(counter: &mut Counter) -> u64 {
    let cleanup: Cleanup = Cleanup { counter: counter };
    transition { _ -> entered(prepare(counter), counter) }
    machine entered(captured: u64, counter: &mut Counter) -> u64 {
        counter.value = 29;
        captured
    }
}

machine main() -> u64 {
    let mut counter: Counter = Counter { value: 0 };
    internal(&mut counter)
}
