// Early disposal through the ordinary consuming `omega::language::core::drop`
// transfers the whole guard into the callee, whose cleanup edge runs
// `drop_guard`. The caller's `g` then holds no established value, so reading
// a field through it is a use of a consumed owner: the scalar must be read
// before the transfer, not after.

use omega::language::core::drop;

data Guard dropped by drop_guard {
    handle: i32;
}

machine drop_guard(guard: &mut Guard) {
}

data Main {}

machine Main::main() -> i32 {
    let g: Guard = Guard { handle: 7 };
    drop(g);
    g.handle
}
