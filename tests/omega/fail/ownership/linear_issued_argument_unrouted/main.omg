use omega::language::core::drop;
public data Token [linear] { code: u8; }
machine Token::drop(token: &mut Token) {}
public domain Token::Issued established by TokenRoot::grant;
public boundary trait TokenRoot {
    machine grant(token: Token) -> Token reaches ensures result in Token::Issued;
}
machine observe(first: Token in Issued, second: Token in Issued) -> bool {
    drop(first);
    drop(second);
    true
}
machine invalid() -> bool reaches TokenRoot {
    let token: Token = Token { code: 11 };
    observe(token, TokenRoot::grant(Token { code: 26 })) == true
}
