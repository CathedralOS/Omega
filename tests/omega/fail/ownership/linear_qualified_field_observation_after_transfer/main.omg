// A qualified field read borrows live storage. It cannot resurrect the
// consumed owner or observe a field whose value was moved before reseating.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
domain Receipt::Issued;
machine Receipt::drop(receipt: &mut Receipt) {}
data Slot { receipt: Receipt in Receipt::Issued; }

machine issue(code: i32) -> Receipt in Receipt::Issued {
    let receipt: Receipt in Receipt::Issued = Receipt { code: code };
    receipt
}
machine consume(receipt: Receipt in Receipt::Issued) { drop(receipt); }

machine consumed() {
    let receipt: Receipt in Receipt::Issued = issue(1);
    consume(receipt);
    let observed: i32 = ((receipt.code as i32 in Wrapping) + (0 as i32 in Wrapping)) as i32;
}

// Installing an owned parameter transfers its occurrence into caller storage;
// its qualification must not keep the consumed parameter available afterward.
machine reused_replacement(slot: &mut Slot, replacement: Receipt in Receipt::Issued) {
    let previous: Receipt in Receipt::Issued = slot.receipt;
    slot.receipt = replacement;
    consume(previous);
    consume(replacement);
}

machine main() {
    let mut slot: Slot = Slot { receipt: issue(2) };
    let vacated: Receipt in Receipt::Issued = slot.receipt;
    let observed: i32 = ((slot.receipt.code as i32 in Wrapping) + (0 as i32 in Wrapping)) as i32;
    consume(vacated);
    slot.receipt = issue(3);
    consume(slot.receipt);
}
