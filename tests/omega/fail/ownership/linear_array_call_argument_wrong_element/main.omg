// Custody does not establish type identity. A valid claim for Other cannot
// supply one element of a Receipt array merely because their layouts agree.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
data Other [linear] { code: i32; }
machine Other::drop(other: &mut Other) {}

machine make(code: i32) -> Receipt {
    let receipt: Receipt = Receipt { code: code };
    receipt
}

machine other(code: i32) -> Other {
    let result: Other = Other { code: code };
    result
}

machine settle(receipts: [Receipt; 2]) -> i32 {
    let first: Receipt = receipts[0];
    let second: Receipt = receipts[1];
    drop(first);
    drop(second);
    0
}

machine main() {
    let wrong_element: i32 = settle([other(1), make(2)]);
}
