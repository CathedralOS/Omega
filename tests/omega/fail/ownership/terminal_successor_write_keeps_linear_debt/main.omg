// A named terminal machine call is not an internal arrival. It executes
// before caller cleanup, so its new linear payload cannot be discarded.
data Token [linear] { value: u64; }
data Slot { case Empty; case Held(token: Token); }

machine install(slot: &mut Slot)
requires slot in Slot::Empty;
{
    slot = Slot::Held { token: Token { value: 7 } };
}

machine main() {
    let mut slot: Slot = Slot::Empty;
    transition { _ -> install(&mut slot) }
}
