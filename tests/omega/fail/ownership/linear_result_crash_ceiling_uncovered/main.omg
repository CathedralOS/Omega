// A linear result does not weaken the authored crash ceiling.
use omega::language::core::drop;
data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
machine stop(item: Receipt) -> Receipt crashes Trap { crash Trap; }
machine choose(returning: bool, item: Receipt) -> Receipt crashes Trap false {
    transition returning {
        true -> (item)
        false -> stop(item)
    }
}

machine main() crashes Trap {
    let received: Receipt = choose(false, Receipt { code: 47 });
    drop(received);
}
