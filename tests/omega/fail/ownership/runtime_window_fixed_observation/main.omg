// A fixed element can be the element a runtime selector vacated. Without
// disjointness evidence it cannot be observed before restoration.
data Token dropped by drop_token { byte: i32; }
machine drop_token(token: &mut Token) { token.byte = 0; }

machine observe(tokens: &mut [Token], at: u64) -> i32
requires tokens.len >= 2, at < tokens.len
{
    let first: Token = tokens[at];
    let stale: i32 = tokens[0].byte;
    tokens[at] = first;
    stale
}
machine main() {}
