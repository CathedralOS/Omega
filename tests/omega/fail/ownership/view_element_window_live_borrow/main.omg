// Replacing a view element opens a restoration window on it. A live shared
// borrow of that element overlaps the window and rejects.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }
machine mint(byte: i32) -> Token { Token { byte: byte } }
machine refill(tokens: &mut [Token]) -> i32
requires tokens.len >= 2
{
    let held: &Token = &tokens[0];
    tokens[0] = mint(68);
    held.byte
}
machine main() {}
