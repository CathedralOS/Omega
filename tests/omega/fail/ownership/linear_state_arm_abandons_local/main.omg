// FAIL: a state passes an inline construction to a call, then carries its own
// linear local across one arm only; the other arm abandons it.
data Receipt [linear] { code: i32; }

boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

machine consume(receipt: Receipt) -> i32 {
    let observed: i32 = receipt.code;
    ReceiptAck::ack(receipt);
    observed
}

machine main() {
    transition { _ -> holding(2) }

    machine holding(code: i32) {
        let observed: i32 = consume(Receipt { code: code });
        let carried: Receipt = Receipt { code: observed };
        transition observed == 2 {
            true -> finishing(carried)
            _ -> skipping()
        }
    }

    machine finishing(last: Receipt) {
        ReceiptAck::ack(last);
    }

    machine skipping() {}
}
