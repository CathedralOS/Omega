use omega::language::core::drop;

data Inventory [linear] dropped by drop_inventory { slots: i32; }
machine drop_inventory(inventory: &mut Inventory) {}

machine take_live(inventory: &mut Inventory) -> i32 {
    let forwarded: &mut Inventory = inventory;
    let observation: &i32 = &forwarded.slots;
    let removed: Inventory = forwarded;
    forwarded = removed;
    observation
}
