// FAIL canary: a borrowed-storage hole must be repaired on every exit edge.
// Moving `self.inventory` out opens a restoration window; the `Drop` arm
// exits with the field still absent, so the unrepaired hole rejects.
data Inventory { slots: i32; }
data Choice {
    case Keep;
    case Drop;
}
data Main { inventory: Inventory; }

machine Main::restore(&mut self, taken: Inventory) -> i32 {
    self.inventory = move taken;
    0
}

machine Main::apply(&mut self, choice: Choice) -> i32 {
    let taken: Inventory = self.inventory;
    transition choice {
        Choice::Keep -> self.restore(taken)
        Choice::Drop -> 0
    }
}
