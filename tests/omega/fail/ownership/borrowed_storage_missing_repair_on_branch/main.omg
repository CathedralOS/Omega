// FAIL canary: a borrowed-storage hole must be repaired on every exit edge.
// Moving `main.inventory` out opens a restoration window; the `Drop` arm
// exits with the field still absent, so the unrepaired hole rejects.
data Inventory { slots: i32; }
data Choice {
    case Keep;
    case Drop;
}
data Main { inventory: Inventory; }

machine Main::restore(main: &mut Main, taken: Inventory) -> i32 {
    main.inventory = move taken;
    0
}

machine Main::apply(main: &mut Main, choice: Choice) -> i32 {
    let taken: Inventory = main.inventory;
    transition choice {
        Choice::Keep -> Main::restore(main, taken)
        Choice::Drop -> 0
    }
}
