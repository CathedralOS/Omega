data Token [linear] { value: u64; }
data Pair { case Present(left: Token, right: Token); }
data Returned { first: Token; second: Token; third: Token; }
machine produce(left: Token, right: Token) -> Pair {
    Pair::Present { left: left, right: right }
}
machine duplicate(left: Token, right: Token) -> Returned {
    transition produce(left, right) {
        Pair::Present { left, right } -> Returned { first: left, second: right, third: left }
    }
}
