// Equal version-pinned captures still name absent storage: equality must not
// admit a read between extraction and replacement.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }

machine observe(tokens: &mut [Token], initial: u64)
requires tokens.len >= 2, initial < 2
{
    let mut at: u64 = initial;
    let first: Token = tokens[at];
    let observed: i32 = tokens[at].byte;
    tokens[at] = first;
}
machine main() {}
