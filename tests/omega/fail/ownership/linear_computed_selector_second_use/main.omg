// A computed selector invocation consumes the explicit owner. Copying its
// dispatch word cannot revive the original claim for a later static call.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

trait Settlement<T> { machine settle(value: T) -> i32; }
Observed satisfies Settlement<Receipt> {
    machine settle(value: Receipt) -> i32 {
        let code: i32 = value.code;
        drop(value);
        code
    }
}

machine consume(value: Receipt) { drop(value); }
machine main() {
    let selected: dyn Settlement<Receipt> = Observed as dyn Settlement<Receipt>;
    let original: Receipt = Receipt { code: 7 };
    let total: i32 = ((Settlement::settle(selected, original) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    consume(original);
}
