// Historical establishment cannot revive a sibling whose storage was moved.
data Receipt [linear] { value: u64; }
data Token { value: u64; }
data Pair { receipt: Receipt; token: Token; }
machine Receipt::drop(receipt: &mut Receipt) { receipt.value = 0; }
machine consume_receipt(receipt: Receipt) -> u64 { receipt.value }
machine consume_token(token: Token) -> u64 { token.value }

machine choose(enabled: bool) -> bool {
    let pair: Pair = Pair {
        receipt: Receipt { value: 9 },
        token: Token { value: 7 }
    };
    _ = consume_receipt(pair.receipt);
    _ = consume_token(pair.token);
    enabled && consume_token(pair.token) == 7
}
machine main() -> bool { choose(false) }
