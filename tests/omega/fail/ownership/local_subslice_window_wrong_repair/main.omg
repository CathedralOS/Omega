// Repairing another element cannot return the local view's original loan.
data Token dropped by drop_token { byte: i32; }
machine drop_token(token: &mut Token) { token.byte = 0; }

machine misplaced(tokens: &mut [Token])
requires tokens.len >= 3
{
    let tail: &mut [Token] = &mut tokens[1..3];
    let first: Token = tail[0];
    tail[1] = first;
}

machine main() {}
