// A call consumes an affine actual even when its result carries no custody.
// A backedge cannot restore that owner by naming its consumed state parameter.
public data Token { value: i32; }
public boundary trait Consume { machine take(token: Token) reaches; }
machine main(token: Token) reaches Consume {
    transition { _ -> cycle(token) }
    machine cycle(token: Token) {
        Consume::take(token);
        transition { _ -> cycle(token) }
    }
}
