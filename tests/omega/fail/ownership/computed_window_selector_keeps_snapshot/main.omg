// An additive computation over mutable storage captures an immutable value,
// not a promise to read that storage again when the hole is repaired.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }

machine misplaced(tokens: &mut [Token])
requires tokens.len >= 2
{
    let mut at: u64 = 0;
    let chosen: u64 = at + 0;
    let first: Token = tokens[chosen];
    at = 1;
    tokens[at] = first;
}
machine main() {}
