// The selected operator returns one, not the builtin sum. Its captured
// result cannot identify the hole with the unchanged parameter at zero.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }

trait IndexAdd {
    operator + add(left: u8, right: u8) -> u8;
}

Selected satisfies IndexAdd {
    machine add(left: u8, right: u8) -> u8 { 1 }
}

machine misplaced<Addition satisfies IndexAdd>(tokens: &mut [Token], at: u8)
requires tokens.len >= 256, at == 0
{
    let chosen: u8 = at + 0;
    let first: Token = tokens[chosen];
    tokens[at] = first;
}
machine main() {}
