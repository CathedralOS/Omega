// An argument call executes before successor cleanup. Its write must retire
// the prior Empty observation; the newly installed linear payload is owed.
data Token [linear] { value: u64; }
data Slot { case Empty; case Held(token: Token); }

machine install(slot: &mut Slot) -> bool
requires slot in Slot::Empty;
{
    slot = Slot::Held { token: Token { value: 7 } };
    true
}

machine main() {
    let mut slot: Slot = Slot::Empty;
    transition { _ -> done(install(&mut slot)) }
    machine done(installed: bool) {}
}
