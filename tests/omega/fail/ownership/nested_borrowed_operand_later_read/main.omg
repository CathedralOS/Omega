use omega::language::core::drop;

data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Holder { token: Token; }

machine identity(token: Token) -> Token { token }
machine transform(token: Token, value: u64) -> Token {
    drop(token);
    Token { value: value }
}

machine repair(holder: &mut Holder) {
    holder.token = transform(identity(holder.token), holder.token.value);
}
