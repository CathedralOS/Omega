use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Pair { left: Token; right: Token; }
machine missing(selected: bool, first: Token, second: Token) -> Pair {
    match selected {
        true -> Pair { left: first, right: second },
        false -> Pair { left: first, right: Token { value: 29 } },
    }
}
