data Leaf { value: u64; }
data Envelope<Value> dropped by drop_envelope<Value> { case Held(value: Value); }
machine drop_envelope<Value>(envelope: &mut Envelope<Value>) {}

machine produce(value: Leaf) -> Envelope<Leaf> {
    Envelope::Held { value: value }
}
machine detach(value: Leaf) -> Leaf {
    // A captured generic result still owes its owner's intact cleanup receiver.
    transition produce(value) {
        Envelope::Held { value } -> value
    }
}
