data Token { value: u64; }
data Pair { left: Token; right: Token; }
machine borrowed(selected: bool, left: Token, right: Token) -> u64 {
    let view: &Token = &left;
    let pair: Pair = match selected {
        true -> Pair { left: left, right: right },
        false -> Pair { left: left, right: right },
    };
    view.value
}
