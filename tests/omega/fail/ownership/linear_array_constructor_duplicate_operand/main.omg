// Completing one array child consumes the original claim. A second child
// cannot call the forwarding machine with that same original owner.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
machine forward(receipt: Receipt) -> Receipt { receipt }
machine settle(receipts: [Receipt; 2]) {
    drop(receipts[0]);
    drop(receipts[1]);
}
machine main() {
    let original: Receipt = Receipt { code: 1 };
    settle([forward(original), forward(original)]);
}
