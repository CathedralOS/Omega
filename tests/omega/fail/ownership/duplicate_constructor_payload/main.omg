// Source checking rejects the second transfer from the selected payload before
// constructor custody completion can publish overlapping claims.
data Token { value: i32; }
data Choice { case Present(value: Token); case Empty; }
data Pair { first: Token; second: Token; }

machine duplicate(choice: Choice) -> Pair {
    transition choice {
        Choice::Present { value } -> Pair { first: value, second: value }
        Choice::Empty -> Pair { first: Token { value: 0 }, second: Token { value: 1 } }
    }
}

data Main { }
machine Main::main(main: &mut Main) {
    let pair: Pair = duplicate(Choice::Present { value: Token { value: 7 } });
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
