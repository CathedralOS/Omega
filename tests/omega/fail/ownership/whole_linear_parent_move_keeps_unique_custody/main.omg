use omega::language::core::drop;

data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token) {}
data Envelope [linear] dropped by drop_envelope { token: Token; marker: u64; }
machine drop_envelope(envelope: &mut Envelope) {}
domain Envelope::Moved;

machine main() {
    let original: Envelope = Envelope {
        token: Token { value: 29 }, marker: 17
    };
    let moved: Envelope in Moved = original;
    drop(moved);
    drop(original);
}
