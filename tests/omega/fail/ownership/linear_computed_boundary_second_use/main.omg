// A completion receipt transfers the original owner's claim, not a copy of it.
use omega::language::core::drop;

public data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}
public boundary trait Settlement { machine settle(value: Receipt) -> i32 reaches; }
machine consume(value: Receipt) { drop(value); }

machine main() reaches Settlement {
    let original: Receipt = Receipt { code: 7 };
    let total: i32 = ((Settlement::settle(original) as i32 in Wrapping) + (1 as i32 in Wrapping)) as i32;
    consume(original);
}
