// A forwarding child call cannot revive the original claim when its result
// becomes a constructor member. The enclosing owner receives that claim once.
use omega::language::core::drop;

data Receipt [linear] dropped by drop_receipt { code: i32; }
machine drop_receipt(receipt: &mut Receipt) {}
data Pair { left: Receipt; right: Receipt; }

machine forward(receipt: Receipt) -> Receipt { receipt }
machine consume(receipt: Receipt) { drop(receipt); }
machine settle(pair: Pair) {
    consume(pair.left);
    consume(pair.right);
}

machine main() {
    let original: Receipt = Receipt { code: 1 };
    settle(Pair { left: forward(original), right: Receipt { code: 2 } });
    consume(original);
}
