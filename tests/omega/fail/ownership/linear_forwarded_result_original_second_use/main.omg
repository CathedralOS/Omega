// Returning an input continues its claim; it cannot revive the moved owner.
// A qualification changes neither that claim identity nor its moved status.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
domain Receipt::Issued;
machine Receipt::drop(receipt: &mut Receipt) {}

machine issue(code: i32) -> Receipt in Issued {
    let issued: Receipt in Issued = Receipt { code: code };
    issued
}

machine identity(receipt: Receipt in Issued) -> Receipt in Issued { receipt }

machine consume(receipt: Receipt) { drop(receipt); }

machine main() {
    let original: Receipt in Issued = issue(11);
    let forwarded: Receipt in Issued = identity(original);
    consume(original);
    consume(forwarded);
}
