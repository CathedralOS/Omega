// Returning an input continues its claim; it cannot revive the moved owner.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

machine issue(code: i32) -> Receipt {
    let issued: Receipt = Receipt { code: code };
    issued
}

machine identity(receipt: Receipt) -> Receipt { receipt }

machine consume(receipt: Receipt) { drop(receipt); }

machine main() {
    let original: Receipt = issue(11);
    let forwarded: Receipt = identity(original);
    consume(original);
    consume(forwarded);
}
