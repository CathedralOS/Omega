// The helper writes the selector through a loan. Its old snapshot cannot
// license repair through a second capture of the now-changed selector.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }
machine redirect(index: &mut u64) { index = 1; }

machine misplaced(tokens: &mut [Token])
requires tokens.len >= 2
{
    let mut at: u64 = 0;
    let first: Token = tokens[at];
    redirect(&mut at);
    tokens[at] = first;
}
machine main() {}
