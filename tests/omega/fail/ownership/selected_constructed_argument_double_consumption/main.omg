data Held { value: &i32; }
data Wrapped { held: Held; }
machine consume(held: Held) -> i32 { held.value }
machine consume_wrapped(wrapped: Wrapped) -> i32 { consume(wrapped.held) }
machine first(left: i32, right: i32) -> i32 { left }
machine selected(value: &i32, choice: bool) -> i32 {
    let held: Held = Held { value: value };
    match choice {
        true -> first(consume_wrapped(Wrapped { held: held }), consume(held)),
        false -> 23,
    }
}
