// FAIL canary: a place inside absent borrowed storage has no value to read.
// Moving `main.inventory` out opens a restoration window; reading
// `main.inventory.slots` while the hole is open rejects before the restore.
data Inventory { slots: i32; }
data Main { inventory: Inventory; }

machine Main::peek(main: &mut Main) -> i32 {
    let taken: Inventory = main.inventory;
    let seen: i32 = main.inventory.slots;
    main.inventory = move taken;
    seen
}
