use omega::language::core::drop;

data Token<'storage> [linear] { value: u64; reference: &'storage i32; }
machine Token::drop(token: &mut Token<'storage>) {}
data Choice<'storage> {
    case Success(token: Token<'storage>);
    case Failure(token: Token<'storage>);
}

machine forward<'storage>(choice: Choice<'storage>) -> Choice<'storage> { choice }
machine consume<'storage>(choice: Choice<'storage>) {
    transition choice {
        Choice::Success { token } -> drop(token)
        Choice::Failure { token } -> drop(token)
    }
}

machine main() {
    let backing: i32 = 73;
    let choice: Choice = Choice::Success { token: Token {
        value: 41, reference: &backing
    } };
    let returned: Choice = forward(choice);
    consume(returned);
    consume(returned);
}
