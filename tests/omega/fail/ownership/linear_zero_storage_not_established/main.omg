// FAIL canary (decision 21): implicit zero-fill initializes bits only. It does
// not manufacture the value/obligation needed to transfer this place.
data Receipt [linear] {
    code: i32;
}

boundary trait ReceiptAck {
    machine ack(receipt: Receipt) reaches;
}

data Main {}

machine Main::main() -> i32 {
    let receipt: Receipt;
    ReceiptAck::ack(receipt);
    0
}
