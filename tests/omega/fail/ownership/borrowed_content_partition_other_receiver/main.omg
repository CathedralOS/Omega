// Reject: the exact borrowed allocator's coupling is not restored.
use omega::language::core::content;
use omega::language::core::drop;
data ByteUnit {}
data Region [linear] { length: u64; }
domain Region::Owned established by issue;
machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: embed(region.length) as Nat }
}
machine issue() -> Region in Owned ensures result.length == 48 {
    Region { length: 48 }
}
machine Region::drop(region: &mut Region) {}
data Parts { taken: Region in Owned; rest: Region in Owned; }
data Strategy where remaining == tail.length { tail: Region in Owned; remaining: u64; }
machine partition(whole: Region in Owned, requested: u64) -> Parts
requires requested <= whole.length
ensures result.taken.length == requested,
    result.rest.length == whole.length - requested,
    Owned::content(old(&whole)) == separate(Owned::content(&result.taken), Owned::content(&result.rest))
{
    let { length } = whole;
    Parts { taken: Region { length: requested }, rest: Region { length: length - requested } }
}
machine carve(strategy: &mut Strategy, other: &mut Strategy, remaining: u64, requested: u64) -> Region in Owned
requires remaining == strategy.tail.length && requested <= remaining
ensures result.length == requested, strategy.tail.length == remaining - requested
{
    let tail: Region in Owned = strategy.tail;
    let parts: Parts = partition(tail, requested);
    strategy.tail = parts.rest;
    other.remaining = remaining - requested;
    parts.taken
}
machine main() crashes Trap {
    let mut strategy: Strategy = Strategy { tail: issue(), remaining: 48 };
    let mut other: Strategy = Strategy { tail: issue(), remaining: 48 };
    let first: Region in Owned = carve(&mut strategy, &mut other, 48, 16);
    let second: Region in Owned = carve(&mut strategy, &mut other, 32, 8);
    let correct: bool = first.length == 16 && second.length == 8 && strategy.tail.length == 24 && strategy.remaining == 24;
    drop(first);
    drop(second);
    drop(strategy.tail);
    drop(other.tail);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
