// A prior empty result cannot erase the payload established by a later write.
data Token [linear] { value: u32; }
data Slot { case Empty; case Held(token: Token); }
data Holder { slot: Slot; }
machine empty() -> Holder { Holder { slot: Slot::Empty } }
machine forward(value: Holder) -> Holder { value }
machine main() {
    let mut value: Holder = empty();
    value.slot = Slot::Held { token: Token { value: 70 } };
    let returned: Holder = forward(Holder { slot: value.slot });
}
