// Replacing a whole element through an exclusive slice parameter selects
// it against the view's runtime length. Nothing proves element 2 exists in a
// view only known to hold two elements, so checking rejects the store rather
// than trapping at run time.
data Token { byte: i32; }
machine Token::drop(token: &mut Token) { token.byte = 0; }
machine mint(byte: i32) -> Token { Token { byte: byte } }
machine refill(tokens: &mut [Token])
requires tokens.len >= 2
{
    tokens[2] = mint(68);
}
machine main() {}
