// Reestablishment supplies one owned value, not permission to consume it twice.
data Item { number: i32; }
data Main {}
machine take(item: Item) -> i32 { item.number }

machine Main::main() -> i32 {
    let mut item: Item = Item { number: 17 };
    let first: i32 = take(item);
    item = Item { number: 42 };
    let second: i32 = take(item);
    take(item)
}
