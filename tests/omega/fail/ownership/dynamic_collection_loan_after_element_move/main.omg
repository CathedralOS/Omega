// An unknown-index write cannot refresh a collection with a moved child.
// The containing mutable loan must refuse before any completion can run.
data Token [linear] { value: u64; }
data Inventory { tokens: [Token; 2]; }
machine write(inventory: &mut Inventory, position: u64)
requires position < 2
{
    inventory.tokens[position].value = 97;
}
machine invalid(position: u64) -> Token
requires position < 2
{
    let mut inventory: Inventory = Inventory {
        tokens: [Token { value: 29 }, Token { value: 73 }]
    };
    let taken: Token = inventory.tokens[0];
    write(&mut inventory, position);
    taken
}
