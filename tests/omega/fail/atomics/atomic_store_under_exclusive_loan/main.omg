// REFUSE: shared atomic access does not reach a cell an exclusive loan still holds.
data Cell { counter: AtomicU64; }

machine main() crashes Trap {
    let mut cell: Cell = Cell { counter: 3 };
    let exclusive: &mut Cell = &mut cell;
    cell.counter.store(23, NoOrdering);
    let seen_atomic_observed: u64 = exclusive.counter.load(NoOrdering);
    let seen: u64 in Wrapping = seen_atomic_observed as u64 in Wrapping;
    transition seen == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
