use omega::language::core::atomic;
data Options { ordering: FenceOrdering; }
data View { item: &mut Options; }
machine wrap(value: &mut Options) -> View
ensures result.item.ordering in FenceOrdering::Publish {
    value.ordering = FenceOrdering::Publish;
    View { item: value }
}
machine exercise(incoming: FenceOrdering) {
    let options: Options = Options { ordering: FenceOrdering::Publish };
    let view: View = wrap(&mut options);
    view.item.ordering = incoming;
    Atomic::fence(view.item.ordering);
}
