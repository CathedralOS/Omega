use omega::language::core::layout;


data Payload [copy] { value: u32; }
data View { payload: LayoutStorage<Payload, Policy>; }
Policy satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates {
        let facts: LayoutTargetFacts = layout_target_facts(&target);
        transition {
            facts.profile == "macos_arm64" -> on_macos_arm64(schema)
            facts.profile == "linux_x86_64" -> on_linux_x86_64(schema)
            _ -> unsupported_target()
        }
        machine on_macos_arm64(schema: Schema) -> Plan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::IntegerAt { offset: 0, stored_width: 8, interpretation: IntegerInterpretation::Unsigned } };
    Plan { entries: entries, entry_count: 1, size_fixed: 1, size_is_dynamic: false, align: 1 }
}
        machine on_linux_x86_64(schema: Schema) -> Plan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::IntegerAt { offset: 0, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    Plan { entries: entries, entry_count: 1, size_fixed: 2, size_is_dynamic: false, align: 2 }
}
        machine unsupported_target() -> Plan reaches terminates {
            let entries: [FieldEntry; 64];
            Plan { entries: entries, entry_count: 0, size_fixed: 0, size_is_dynamic: false, align: 0 }
        }
    }
}

machine write(out: &mut u32, value: u32) { out = value; }
machine forward(out: &mut u32, value: u32) { write(out, value); }
machine program() crashes Trap {
    let mut view: View;
    forward(&mut view.payload.value, 300);
    transition view.payload.value == 37 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
