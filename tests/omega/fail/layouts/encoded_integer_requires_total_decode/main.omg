use omega::language::core::layout;
// Every encoded bit pattern must decode into the declared logical carrier.


UnsignedWord satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 64,
            interpretation: IntegerInterpretation::Unsigned,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 8,
        size_is_dynamic: false,
        align: 8,
    }
}
}
data PortableByte [copy] { value: i64; }
data Main { value: LayoutStorage<PortableByte, UnsignedWord>; }
machine Main::main(main: &mut Main) { main.value.value = 0; }
