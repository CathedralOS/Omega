// A requirement call stores 200 into a signed eight-bit field through a
// type-generic implementation. Its open template body has no concrete write
// type to judge, so Psi refuses rather than accepting an unchecked store.
use omega::language::core::Schema;
use omega::language::core::IntegerInterpretation;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::LayoutTarget;
use omega::language::core::LayoutStorage;
use omega::language::core::FixedLayout;


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::IntegerAt {
            offset: 0, stored_width: 8, interpretation: IntegerInterpretation::Signed,
        },
    };
    LayoutPlan { entries: entries, entry_count: 1, size_fixed: 1, size_is_dynamic: false, align: 1 }
}
}
data PortableByte [copy] { value: i64; }
data Memory { bytes: [u8; 2]; }
public boundary trait Put<V> {
    machine put(destination: &mut V, value: V) reaches;
}
Any<V> satisfies Put<V> {
    machine put(destination: &mut V, value: V) { destination = value; }
}
machine main(memory: &mut Memory) crashes Trap {
    memory.bytes[1] = 85;
    let packed: &mut LayoutStorage<PortableByte, SignedByte> = &mut memory.bytes[0] as &mut LayoutStorage<PortableByte, SignedByte>;
    let value: i64 = 200;
    Put<i64>::put(&mut packed.value, value);
    transition memory.bytes[0] == 70 && memory.bytes[1] == 85 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Memory;
    main(&mut entry_storage);
}
