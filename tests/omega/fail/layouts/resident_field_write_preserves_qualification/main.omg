// A resident field's existing qualification is still required by a write
// through a helper. The raw value 29 cannot replace a Seventeen member.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

public domain u64::Seventeen(value) requires value == 17;
public data Word { value: u64 in Seventeen; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

MemorySupply satisfies ResourceProfileSupply<TestMemory> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile {
        let services: [u64; 32];
        let mut regions: [ResourceRegion; 32];
        regions[0] = ResourceRegion {
            range: RelativeRange { offset: 0, length: storage.length },
            peer: PeerWritability::Exclusive,
            stable: StableCapability::ReadWrite,
            external: ExternalCapability::None,
            atomic: AtomicCapability::None,
            reach: BoundaryReach { services: services, service_count: 0 },
        };
        ResourceProfile { regions: regions, region_count: 1 }
    }
}

machine carry(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> Extent in Granted & Resident<WordPlacement, Word> { storage }

machine attempt(storage: Extent in Granted & Vacant, expected_reason: u64)
    -> PlacementReturn<Extent in Granted & Vacant, Word>
reaches ResourceProfileSupply crashes Trap
{
    transition NativePlacement<WordPlacement, Word, TestMemory>::initialize(storage, Word { value: 17 }) {
        PlacementOutcome::Ready { view } -> extract(view)
        PlacementOutcome::Rejected { returned, reason } -> unexpected(returned)
    }
    machine extract(storage: Extent in Granted & Resident<WordPlacement, Word>)
        -> PlacementReturn<Extent in Granted & Vacant, Word> {
        let mut retained: Extent in Granted & Resident<WordPlacement, Word> = carry(storage);
        overwrite(Placed::view_resident_mut<WordPlacement, Word>(&mut retained));
        transition NativePlacement<WordPlacement, Word, TestMemory>::move_out(retained) {
            PlacementExtraction::Moved { storage, value } -> check_value(storage, value)
        }
    }
    machine check_value(storage: Extent in Granted & Vacant, value: Word)
        -> PlacementReturn<Extent in Granted & Vacant, Word> {
        transition value.value == 29 {
            true -> done(storage, value)
            false -> unexpected(PlacementReturn { source: storage, custody: value })
        }
    }
    machine done(storage: Extent in Granted & Vacant, value: Word)
        -> PlacementReturn<Extent in Granted & Vacant, Word> {
        PlacementReturn { source: storage, custody: value }
    }
    machine unexpected(returned: PlacementReturn<Extent in Granted & Vacant, Word>)
        -> PlacementReturn<Extent in Granted & Vacant, Word> { crash Trap; }
}


machine overwrite(view: &mut Placed<WordPlacement, Word>) crashes Trap {
    placed_write(&mut view.value, 29u64);
}


