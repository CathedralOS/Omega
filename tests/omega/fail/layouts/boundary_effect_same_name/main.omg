use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
boundary trait Writer {
 machine replace(storage:&mut Extent in Granted) reaches;
}
// This unrelated function must not supply Writer::replace's effect summary.
machine replace(storage:&mut Extent in Granted) {}
machine keep(root:Extent in Granted)->Extent in Granted reaches Writer {
 let mut storage:Extent in Granted=root;
 Writer::replace(&mut storage);
 storage
}
machine main() {}
