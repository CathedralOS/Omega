// A policy's private call closure still owes each concrete callee premise.
// Removing unrelated runtime bodies from its probe must not grant this call.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::Access;

public data Register { value: u64; }
public data CheckedPolicy {}
machine CheckedPolicy::limit(value: u64) -> u64
requires value <= 7
{ value }

machine CheckedPolicy::plan(schema: Schema) -> AccessPlan {
    let size: u64 = CheckedPolicy::limit(8);
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries, entry_count: 1,
            size_fixed: size, size_is_dynamic: false, align: 8,
        };
    let mut reach: BoundaryReach;
    AccessPlan::with_reach(
        AccessPlan::inaccessible(layout),
        reach
    )
}
machine inspect(view: &mut Access<CheckedPolicy, Register>) {}
machine main() {}
