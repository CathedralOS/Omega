// Numbered schema canonical order follows stable identity, independently of authored field order.
// Fact: An ordinary FixedLayout<Pair in Pair::Ready> application preserves the established Delivered fact on Pair.lo, so reading lo and subtracting 42u64 remains justified through each storage transport and execution uses the authored lo-at-8 representation.
// Expected exit: 0
use omega::language::core::layout;
use omega::language::core::option;
public domain u64::Delivered requires self >= 42u64 && self <= 42u64;
public data Pair [copy] { #8 hi: u64; #9 lo: u64 in Delivered; retired #7; }
public domain Pair::Ready requires self.hi == 9u64;
PairLayout satisfies FixedLayout<Pair in Pair::Ready> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let first_is_lo: bool = match schema.fields[0].identity {
            Optional::Some { value } -> value == 6u64
            Optional::None -> false
        };
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 8 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 0 } };
        Plan { entries: entries, entry_count: 2, size_fixed: 16, size_is_dynamic: false, align: match first_is_lo && schema.retired_field_identity_count == 1u64 && schema.retired_field_identities[0] == 7u64 { true -> 8u64 _ -> 0u64 } }
    }
}
machine make() -> LayoutStorage<Pair in Pair::Ready, PairLayout> {
    let mut value: LayoutStorage<Pair in Pair::Ready, PairLayout>;
    value.lo = 42u64;
    value.hi = 9u64;
    value
}
machine main() crashes Trap {
    let original: LayoutStorage<Pair in Pair::Ready, PairLayout> = make();
    let value: LayoutStorage<Pair in Pair::Ready, PairLayout> = original;
    let difference: u64 = value.lo - 42u64;
    let bytes: &[u8; 16] = &value as &[u8; 16];
    transition difference == 0u64 && value.hi == 9u64 && bytes[8] == 42u8 && bytes[0] == 9u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
