machine eight() requires size_of<u64>() == 8 {}
machine impossible() requires size_of<u64>() == 0 {}
boundary trait SelectedScoped {
    machine scoped() reaches
;
}
MacosArm64Scoped satisfies SelectedScoped {
    machine scoped()
{ eight(); }
}
WindowsX8664Scoped satisfies SelectedScoped {
    machine scoped()
{ impossible(); }
}
machine program() { SelectedScoped::scoped(); }
