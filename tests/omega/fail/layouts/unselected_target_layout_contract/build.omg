// No Windows executable is requested, but its authored body still owes its
// constant proof. Selecting macOS cannot hide the false Windows predicate.
machine build(builder: &mut Build) {
    Build::select_provider<SelectedScoped, MacosArm64Scoped>(builder, macos_arm64);
    Build::select_provider<SelectedScoped, WindowsX8664Scoped>(builder, windows_x86_64);

    Build::application(builder, "unselected_target_layout_contract");
    Build::bind(builder, macos_arm64::ProgramEntry, program);
}
