// A layout cannot make a borrowed field into a repeatable proof value.
// A policy reads ordinary fields through selected storage geometry; its checked
// result must distinguish the matching and nonmatching field values.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::LayoutTarget;
use omega::language::core::LayoutStorage;
use omega::language::core::FixedLayout;
data Payload [copy] { left: &u64; value: u64; right: u64; }
Policy satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
        entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 16 } };
        LayoutPlan { entries: entries, entry_count: 3, size_fixed: 24, size_is_dynamic: false, align: 8 }
    }
}
machine policy(accepted: bool, storage: &LayoutStorage<Payload, Policy>, expected: u64) -> bool
reaches terminates { !accepted || storage.value == expected }
machine validate(storage: &LayoutStorage<Payload, Policy>, expected: u64) -> bool
ensures policy(result, storage, expected) { storage.value == expected }
machine main() {}
