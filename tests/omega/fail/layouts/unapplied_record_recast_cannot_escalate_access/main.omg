// Retaining a recast description does not supply a physical application.
// Expected exit: 0
use omega::language::core::layout;
data Payload [copy] { value: u64; }
Policy satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
        Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 }
    }
}
machine describe(bytes: &[u8; 8]) {
    let view: &mut LayoutStorage<Payload, Policy> = &bytes[0] as &mut LayoutStorage<Payload, Policy>;
}
machine main() {}
