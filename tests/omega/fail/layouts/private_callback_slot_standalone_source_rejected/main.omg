// A plan-laid layout citing a named conformance from a standalone source:
// retained placement custody binds hermetic source identities, and a
// standalone root's declarations have the non-hermetic `User` origin. The
// same source as a `Build::package` root is
// `pass/layouts/private_callback_slot_demand_compile`.
use omega::language::core::layout;

boundary trait WindowProcedure {
    machine call(message: u64) -> u64 reaches;
}

data Spread {
}

WndClassWindowProcedureSlot satisfies PrivateCallbackSlot<
    Spread,
    WindowProcedure::call
> { }

machine Spread::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let plan: Plan = Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 16,
        size_is_dynamic: false,
        align: 8,
    };
    Plan::place_private<WndClassWindowProcedureSlot>(plan, 8)
}

data ForeignRecord {
    payload: u64;
}

data Main {
    value: Spread<ForeignRecord>;
}

machine Main::main() {
}
