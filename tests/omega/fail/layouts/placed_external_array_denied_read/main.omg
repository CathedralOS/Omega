// Must reject: the same indexed read has no read permission.
// Cathedral needs this operation to snapshot an active paging root whose
// accessed bits may be updated by hardware. This hosted control uses ordinary
// RAM supply and establishes neither firmware backing nor a CR3 transition.
use omega::language::core::layout;

public data Words { entries: [u64; 512]; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: fields, entry_count: 1, size_fixed: 4096, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::None, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine snapshot(view: &Placed<WordPlacement, Words>) -> [u64; 512] {
    let entries: [u64; 512];
    transition { _ -> copy(view, 0, entries) }
    machine copy(view: &Placed<WordPlacement, Words>, next: u64, entries: [u64; 512]) -> [u64; 512]
    requires next <= 512
    {
        transition next < 512 {
            true -> read(view, next, entries)
            _ -> entries
        }
    }
    machine read(view: &Placed<WordPlacement, Words>, next: u64, entries: [u64; 512]) -> [u64; 512]
    requires next < 512
    {
        let mut copied: [u64; 512] = entries;
        copied[next] = placed_read(&view.entries[next]);
        transition { _ -> copy(view, next + 1, copied) }
    }
}

machine main() crashes Trap {
    let mut words: Words;
    words.entries[0] = 17;
    words.entries[256] = 41;
    words.entries[511] = 73;
    let copied: [u64; 512] = snapshot(Placed::view<WordPlacement, Words>(&words));
    words.entries[256] = 97;
    let updated: [u64; 512] = snapshot(Placed::view<WordPlacement, Words>(&words));
    transition copied[0] == 17 && copied[255] == 0 && copied[256] == 41 && copied[511] == 73 &&
               updated[0] == 17 && updated[256] == 97 && updated[511] == 73 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
