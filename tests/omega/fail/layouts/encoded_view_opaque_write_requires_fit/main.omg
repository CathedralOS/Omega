use omega::language::core::binding;
// A slice selector must retain partial-width IntegerAt descendants.
// An opaque mutable call cannot establish the fit of its intermediate writes.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField
where
    size <= 4096,
    1 <= align,
    align <= 16,
{
    key: u64;
    size: u64;
    align: u64;
    number: i64;
    kind: FieldKind;
}
data Schema
where
    field_count <= 32,
{ fields: [SchemaField; 32]; field_count: u64; }
data IntegerInterpretation { case Signed; case Unsigned; }
data FieldPlan {
    case IntegerAt(offset: u64, stored_width: u64, interpretation: IntegerInterpretation);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

pub data SignedByte { }
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}

pub data PortableByte [copy] { value: i64; }
pub data RawView { value: SignedByte<PortableByte>; }
pub boundary trait EncodedWriter { machine write(value: &mut RawView); }
machine write_first(encoded_writer: &Binding<EncodedWriter>, bytes: &mut [RawView]) reaches EncodedWriter {
    transition bytes.len > 0 { true -> change(encoded_writer, bytes) _ -> done() }
    state change(encoded_writer: &Binding<EncodedWriter>, bytes: &mut [RawView]) { EncodedWriter::write(encoded_writer, &mut bytes[0]); }
    state done() {}
}
machine main() {}
