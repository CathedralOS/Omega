use omega::language::core::layout;
// A slice selector must retain partial-width IntegerAt descendants.
// An opaque mutable call cannot establish the fit of its intermediate writes.


public SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    LayoutPlan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}

public data PortableByte [copy] { value: i64; }
public data RawView { value: LayoutStorage<PortableByte, SignedByte>; }
public boundary trait EncodedWriter { machine write(value: &mut RawView) reaches; }
machine write_first(bytes: &mut [RawView]) reaches EncodedWriter {
    transition bytes.len > 0 { true -> change(bytes) _ -> done() }
    machine change(bytes: &mut [RawView]) { EncodedWriter::write(&mut bytes[0]); }
    machine done() {}
}
machine main() {}
