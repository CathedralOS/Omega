use omega::language::core::layout;

data Word { value: u64; }
domain Word::Tagged;
domain [Word; 2]::TaggedArray;
data Payload {
    word: Word in Tagged;
    words: [Word in Tagged; 2];
    array: [Word; 2] in TaggedArray;
}


Packed satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key, representation: FieldPlan::At { offset: 7 },
    };
    entries[2] = FieldEntry {
        key: schema.fields[2].key, representation: FieldPlan::At { offset: 24 },
    };
    LayoutPlan {
        entries: entries, entry_count: 3,
        size_fixed: 40, size_is_dynamic: false, align: 8,
    }
}
}

data View { payload: LayoutStorage<Payload, Packed>; }

machine main() crashes Trap {
    transition size_of<View>() == 40 && align_of<View>() == 8 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
