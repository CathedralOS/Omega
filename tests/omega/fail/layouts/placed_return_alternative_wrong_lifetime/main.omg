// The second alternative cannot escape through the first input's lifetime.
use omega::language::core::layout;
public data Words { entries: [u64; 2]; }
public data WordPlacement {}
public data NoReturnedStorage {}
machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: fields, entry_count: 1, size_fixed: 16, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: false, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}
machine borrow_words<'a, 'b>(first: &'a Words, second: &'b Words, choose_first: bool) -> PlacementOutcome<&'a Placed<WordPlacement, Words>, NoReturnedStorage, PlacementInitializationFailure> {
    transition choose_first {
        true -> first_view(first)
        false -> second_view(second)
    }
    machine first_view(first: &'a Words) -> PlacementOutcome<&'a Placed<WordPlacement, Words>, NoReturnedStorage, PlacementInitializationFailure> {
        PlacementOutcome::Ready { view: Placed::view<WordPlacement, Words>(first) }
    }
    machine second_view(second: &'b Words) -> PlacementOutcome<&'a Placed<WordPlacement, Words>, NoReturnedStorage, PlacementInitializationFailure> {
        PlacementOutcome::Ready { view: Placed::view<WordPlacement, Words>(second) }
    }
}
machine main() {}
