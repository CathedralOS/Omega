use omega::language::core::layout;
// A policy cannot replace the canonical Core Schema with a local ABI.
// This retains the old smaller metadata shape and its payload predicate as
// a rejected FixedLayout signature override.
data Identity {
    case None;
    case Some(value: u64) where value < 7;
}

data ConstrainedSchemaField { key: u64; identity: Identity; }
data ConstrainedSchema { fields: [ConstrainedSchemaField; 32]; field_count: u64; }

Contiguous satisfies FixedLayout<Payload> {
    machine plan(schema: ConstrainedSchema, target: LayoutTarget) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
}
}
data Payload { #7 value: u32; }
data View { payload: LayoutStorage<Payload, Contiguous>; }
machine main() { let view: View; }
