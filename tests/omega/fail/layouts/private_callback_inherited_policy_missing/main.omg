// Expected rejection: foreign callback registration requires an explicit selected callback calling plan
// The parent requirement has no calling convention for the registered handler.
// The handler and unused sibling cannot supply the missing selection.
use omega_language_std::AbiValueClass;
use omega_language_std::AbiValueShape;
use omega_language_std::BoundarySignature;
use omega_language_std::MachineRegister;
use omega_language_std::ValueLocation;
use omega_language_std::ValuePlacement;
use omega_language_std::CallingConvention;
use omega_language_std::EntryControl;
use omega_language_std::MachineRegime;
use omega_language_std::EntryStack;
use omega_language_std::Preemption;
use omega_language_std::BoundaryEntryPlan;
use omega_language_std::CallingPolicyRejection;
use omega_language_std::BoundaryPlanResult;
use omega_language_std::CallingPolicy;
use omega_language_std::Calling;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::PrivateCallbackSlot;
use omega::language::core::LayoutPlan::place_private;
use omega::language::core::LayoutTarget;
use omega::language::core::LayoutStorage;
use omega::language::core::FixedLayout;
public data CallbackPolicy {}
public DescriptorCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 1 && signature.native_parameter_count == 1
            && signature.has_result && signature.callback_demand_count <= 1 && signature.callback_binder_count <= 1 {
            true -> accepted(signature)
            _ -> rejected()
        }
        machine accepted(signature: BoundarySignature) -> BoundaryPlanResult
        requires signature.callback_demand_count <= 1 {
            let mut plan: BoundaryEntryPlan;
            plan.call.parameter_count = 1;
            plan.call.parameters[0] = CallbackPolicy::word();
            plan.call.has_result = true;
            plan.call.result = CallbackPolicy::word();
            plan.call.callback_materialization_count = signature.callback_demand_count;
            plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
            plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
            let mut selected: BoundaryEntryPlan = CallbackPolicy::finish(plan);
            // Preserve v31 for callbacks; the registrar keeps all 42 native clobbers.
            selected.call.ordinary_clobbers.register_count = 41u64 + signature.callback_demand_count;
            BoundaryPlanResult::Accepted { plan: selected }
        }
        machine rejected() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "one word parameter and result required" } }
        }
    }
}
// An unused sibling reads its input from x1 and leaves vector registers untouched.
// Selecting that plan for the x0 callback would change the handler's result.
public UnusedDescriptorCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 1 && signature.native_parameter_count == 1
            && signature.has_result && signature.callback_demand_count <= 1 && signature.callback_binder_count <= 1 {
            true -> accepted(signature)
            _ -> rejected()
        }
        machine accepted(signature: BoundarySignature) -> BoundaryPlanResult {
            let mut plan: BoundaryEntryPlan;
            plan.call.parameter_count = 1;
            plan.call.parameters[0] = CallbackPolicy::word();
            plan.call.has_result = true;
            plan.call.result = CallbackPolicy::word();
            plan.call.callback_materialization_count = signature.callback_demand_count;
            plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
            plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
            let mut scalar_plan: BoundaryEntryPlan = CallbackPolicy::finish(plan);
            scalar_plan.call.parameters[0].locations[0] = ValueLocation::Register {
                register: MachineRegister::Aarch64X { index: 1 }, value_byte_offset: 0, byte_size: 8
            };
            scalar_plan.call.ordinary_clobbers.register_count = 18;
            scalar_plan.state.permitted_transitive_use.vector_registers = false;
            BoundaryPlanResult::Accepted { plan: scalar_plan }
        }
        machine rejected() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "one word parameter and result required" } }
        }
    }
}
machine CallbackPolicy::word() -> ValuePlacement {
    let mut value: ValuePlacement;
    value.shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: 8, alignment: 8 };
    value.location_count = 1;
    value.locations[0] = ValueLocation::Register { register: MachineRegister::Aarch64X { index: 0 }, value_byte_offset: 0, byte_size: 8 };
    value
}
machine CallbackPolicy::finish(output: BoundaryEntryPlan) -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan = output;
    plan.call.convention = CallingConvention::Aapcs64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.call.ordinary_clobbers.register_count = 42;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::Aarch64X { index: 6 };
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::Aarch64X { index: 7 };
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::Aarch64X { index: 9 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::Aarch64X { index: 10 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::Aarch64X { index: 11 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::Aarch64X { index: 12 };
    plan.call.ordinary_clobbers.registers[13] = MachineRegister::Aarch64X { index: 13 };
    plan.call.ordinary_clobbers.registers[14] = MachineRegister::Aarch64X { index: 14 };
    plan.call.ordinary_clobbers.registers[15] = MachineRegister::Aarch64X { index: 15 };
    plan.call.ordinary_clobbers.registers[16] = MachineRegister::Aarch64X { index: 16 };
    plan.call.ordinary_clobbers.registers[17] = MachineRegister::Aarch64X { index: 17 };
    plan.call.ordinary_clobbers.registers[18] = MachineRegister::Aarch64V { index: 0 };
    plan.call.ordinary_clobbers.registers[19] = MachineRegister::Aarch64V { index: 1 };
    plan.call.ordinary_clobbers.registers[20] = MachineRegister::Aarch64V { index: 2 };
    plan.call.ordinary_clobbers.registers[21] = MachineRegister::Aarch64V { index: 3 };
    plan.call.ordinary_clobbers.registers[22] = MachineRegister::Aarch64V { index: 4 };
    plan.call.ordinary_clobbers.registers[23] = MachineRegister::Aarch64V { index: 5 };
    plan.call.ordinary_clobbers.registers[24] = MachineRegister::Aarch64V { index: 6 };
    plan.call.ordinary_clobbers.registers[25] = MachineRegister::Aarch64V { index: 7 };
    plan.call.ordinary_clobbers.registers[26] = MachineRegister::Aarch64V { index: 16 };
    plan.call.ordinary_clobbers.registers[27] = MachineRegister::Aarch64V { index: 17 };
    plan.call.ordinary_clobbers.registers[28] = MachineRegister::Aarch64V { index: 18 };
    plan.call.ordinary_clobbers.registers[29] = MachineRegister::Aarch64V { index: 19 };
    plan.call.ordinary_clobbers.registers[30] = MachineRegister::Aarch64V { index: 20 };
    plan.call.ordinary_clobbers.registers[31] = MachineRegister::Aarch64V { index: 21 };
    plan.call.ordinary_clobbers.registers[32] = MachineRegister::Aarch64V { index: 22 };
    plan.call.ordinary_clobbers.registers[33] = MachineRegister::Aarch64V { index: 23 };
    plan.call.ordinary_clobbers.registers[34] = MachineRegister::Aarch64V { index: 24 };
    plan.call.ordinary_clobbers.registers[35] = MachineRegister::Aarch64V { index: 25 };
    plan.call.ordinary_clobbers.registers[36] = MachineRegister::Aarch64V { index: 26 };
    plan.call.ordinary_clobbers.registers[37] = MachineRegister::Aarch64V { index: 27 };
    plan.call.ordinary_clobbers.registers[38] = MachineRegister::Aarch64V { index: 28 };
    plan.call.ordinary_clobbers.registers[39] = MachineRegister::Aarch64V { index: 29 };
    plan.call.ordinary_clobbers.registers[40] = MachineRegister::Aarch64V { index: 30 };
    plan.call.ordinary_clobbers.registers[41] = MachineRegister::Aarch64V { index: 31 };
    plan.state.initial_regime = MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}

public boundary trait Callback {
    machine call(value: u64) -> u64 reaches;
}
public boundary trait TimerCallback: Callback + Calling<DescriptorCalling> {}
public boundary trait UnusedTimerCallback: Callback + Calling<UnusedDescriptorCalling> {}

public boundary trait Registrar: Calling<DescriptorCalling> {
    machine register<machine Handler>(gate: &LayoutStorage<TimerGate, TimerGateLayout>) -> u64
    requires machine Handler satisfies Callback::call;
    reaches invokes Callback;
}
public data TimerGate {
    selector: u16;
    ist: u8;
    attributes: u8;
    reserved: u32;
}
public TimerGateEntry satisfies PrivateCallbackSlot<TimerGate, TimerGateLayout, TimerCallback::call> {}
public TimerGateLayout satisfies FixedLayout<TimerGate> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 2 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 4 } };
        entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 5 } };
        entries[3] = FieldEntry { key: schema.fields[3].key, representation: FieldPlan::At { offset: 12 } };
        let plan: LayoutPlan = LayoutPlan { entries: entries, entry_count: 4, size_fixed: 16, size_is_dynamic: false, align: 8 };
        let low: LayoutPlan = LayoutPlan::place_private<TimerGateEntry>(plan,
            FieldPlan::Bits { container: 0, container_width: 16, destination_lsb: 0, source_lsb: 0, width: 16 });
        let middle: LayoutPlan = LayoutPlan::place_private<TimerGateEntry>(low,
            FieldPlan::Bits { container: 6, container_width: 16, destination_lsb: 0, source_lsb: 16, width: 16 });
        LayoutPlan::place_private<TimerGateEntry>(middle,
            FieldPlan::Bits { container: 8, container_width: 32, destination_lsb: 0, source_lsb: 32, width: 32 })
    }
}

TimerHandler satisfies TimerCallback {
    machine call(value: u64) -> u64 { value ^ 85u64 }
}
machine start() reaches Registrar crashes Trap {
    let mut gate: LayoutStorage<TimerGate, TimerGateLayout>;
    gate.selector = 4660u16;
    gate.ist = 5u8;
    gate.attributes = 142u8;
    gate.reserved = 2309737967u32;
    let result: u64 = Registrar::register<TimerHandler::call>(&gate);
    transition result == 0u64 && gate.selector == 4660u16 && gate.ist == 5u8
        && gate.attributes == 142u8 && gate.reserved == 2309737967u32 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
