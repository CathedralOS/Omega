// A statically selected implementation still invokes the closed public
// lifecycle contract. Its malformed plan cannot disappear with retargeting.
use omega::language::core::extent;
use omega::language::core::layout;

public data Word { value: u64; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 8 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::inaccessible(layout),
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine initialize(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
{
    AccessOutcome::Rejected {
        returned: AccessReturn { source: storage, custody: value },
        reason: AccessInitializationFailure::IncompatibleSupply,
    }
}
boundary machine move_out(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> AccessExtraction<Extent in Granted & Vacant, Word>;

Selected satisfies AccessLifecycle<WordPlacement, Word> {
    AccessLifecycle::initialize = initialize;
    AccessLifecycle::move_out = move_out;
}

machine exercise(storage: Extent in Granted & Vacant, value: Word)
    -> AccessOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        AccessReturn<Extent in Granted & Vacant, Word>,
        AccessInitializationFailure
    >
reaches AccessLifecycle + ResourceProfileSupply
{
    Selected::initialize(storage, value)
}
