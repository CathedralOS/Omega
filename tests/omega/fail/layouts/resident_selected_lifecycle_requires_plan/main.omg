// A statically selected implementation still invokes the closed public
// lifecycle contract. Its malformed plan cannot disappear with retargeting.
use omega::language::core::extent;
use omega::language::core::layout;

public data Word { value: u64; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        },
        access: AccessPlan::inaccessible(&schema),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine initialize(storage: Extent in Granted & Vacant, value: Word)
    -> PlacementOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        PlacementReturn<Extent in Granted & Vacant, Word>,
        PlacementInitializationFailure
    >
{
    PlacementOutcome::Rejected {
        returned: PlacementReturn { source: storage, custody: value },
        reason: PlacementInitializationFailure::IncompatibleSupply,
    }
}
boundary machine move_out(storage: Extent in Granted & Resident<WordPlacement, Word>)
    -> PlacementExtraction<Extent in Granted & Vacant, Word>;

Selected satisfies PlacementLifecycle<WordPlacement, Word> {
    PlacementLifecycle::initialize = initialize;
    PlacementLifecycle::move_out = move_out;
}

machine exercise(storage: Extent in Granted & Vacant, value: Word)
    -> PlacementOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        PlacementReturn<Extent in Granted & Vacant, Word>,
        PlacementInitializationFailure
    >
reaches PlacementLifecycle + ResourceProfileSupply
{
    Selected::initialize(storage, value)
}
