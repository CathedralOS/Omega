// A result tied to left cannot borrow right, even with identical geometry.
use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::ExternalRead;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::Access;
use omega::language::core::AccessOutcome;
use omega::language::core::AccessBorrowReturn;
use omega::language::core::Access::view_extent;
use omega::language::core::AccessInitializationFailure;

data TestMemory {}

public data Word { value: u64; }
public data WordPlacement {}
machine WordPlacement::plan(schema: Schema) -> AccessPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    let layout: LayoutPlan = LayoutPlan { entries: fields, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 };
    let services: [u64; 32];
    AccessPlan::with_reach(
        AccessPlan::with(AccessPlan::inaccessible(layout), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: false, exposure: Exposure::Exported }),
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine attempt<'left, 'right>(left: &'left Extent in Granted, right: &'right Extent in Granted)
    -> AccessOutcome<&'left Access<WordPlacement, Word>, AccessBorrowReturn, AccessInitializationFailure>
reaches ResourceProfileSupply
{
    let outcome: AccessOutcome<&'right Access<WordPlacement, Word>, AccessBorrowReturn, AccessInitializationFailure> =
        Access::view_extent<WordPlacement, Word, TestMemory>(right);
    outcome
}
