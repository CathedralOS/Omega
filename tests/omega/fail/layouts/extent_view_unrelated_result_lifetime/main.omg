// A result tied to left cannot borrow right, even with identical geometry.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

public data Word { value: u64; }
public data WordPlacement {}
machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: fields, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: false, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine attempt<'left, 'right>(left: &'left Extent in Granted, right: &'right Extent in Granted)
    -> PlacementOutcome<&'left Placed<WordPlacement, Word>, PlacementBorrowReturn, PlacementInitializationFailure>
reaches ResourceProfileSupply
{
    let outcome: PlacementOutcome<&'right Placed<WordPlacement, Word>, PlacementBorrowReturn, PlacementInitializationFailure> =
        Placed::view_extent<WordPlacement, Word, TestMemory>(right);
    outcome
}
