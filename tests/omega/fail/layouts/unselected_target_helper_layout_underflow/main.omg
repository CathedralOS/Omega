use omega::language::core::layout;


data Payload [copy] { value: u32; }
Policy satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan reaches terminates; {
        let facts: LayoutTargetFacts = layout_target_facts(&target);
        transition {
            facts.profile == "macos_arm64" -> on_macos_arm64(schema)
            facts.profile == "linux_x86_64" -> on_linux_x86_64(schema)
            facts.profile == "linux_arm64" -> on_linux_arm64(schema)
            facts.profile == "windows_x86_64" -> on_windows_x86_64(schema)
            _ -> unsupported_target()
        }
        machine on_macos_arm64(schema: Schema) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 4 }
}
        machine on_linux_x86_64(schema: Schema) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
}
        machine on_linux_arm64(schema: Schema) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 4 }
}
        machine on_windows_x86_64(schema: Schema) -> Plan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
}
        machine unsupported_target() -> Plan reaches terminates; {
            let entries: [FieldEntry; 64];
            Plan { entries: entries, entry_count: 0, size_fixed: 0, size_is_dynamic: false, align: 0 }
        }
    }
}
boundary trait LayoutExpectedSize { machine expected_size() -> u64 reaches; }
MacosArm64LayoutExpectedSize satisfies LayoutExpectedSize {
    machine expected_size() -> u64 { 8 }
}
LinuxX8664LayoutExpectedSize satisfies LayoutExpectedSize {
    machine expected_size() -> u64 { 4 }
}
LinuxArm64LayoutExpectedSize satisfies LayoutExpectedSize {
    machine expected_size() -> u64 { 8 }
}
WindowsX8664LayoutExpectedSize satisfies LayoutExpectedSize {
    machine expected_size() -> u64 { 4 }
}

// The selected macOS layout has eight bytes; Windows has four.
// This portable helper's intermediate underflows only in the sibling capsule.
// Its final expression cannot cancel the child's formation obligation.
machine geometry() -> u64 {
    let payload: LayoutStorage<Payload, Policy>;
    let bytes: u64 = size_of<LayoutStorage<Payload, Policy>>();
    let excess: u64 = bytes - 6;
    excess + 6
}
boundary trait LayoutScoped { machine scoped() reaches; }
MacosArm64LayoutScoped satisfies LayoutScoped {
    machine scoped() {}
}
WindowsX8664LayoutScoped satisfies LayoutScoped {
    machine scoped() { let observed: u64 = geometry(); }
}


machine main() { LayoutScoped::scoped(); }
