use omega::language::core::layout;


data HiddenSchema { word: u64; }

public LayoutPolicy satisfies FixedLayout<HiddenSchema> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 }
}
}

// A public policy cannot launder a private schema through its generated type.
boundary machine observe(value: LayoutStorage<HiddenSchema, LayoutPolicy>);

machine Main::main() -> i32 { 0 }
