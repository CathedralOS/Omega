// The returned exclusive view keeps its original extent loan live.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

machine overlap<'storage, P, T>(storage: &'storage mut Extent in Granted)
    -> AccessOutcome<&'storage mut Access<P, T>, AccessBorrowReturn, AccessInitializationFailure>
reaches ResourceProfileSupply
{
    let outcome: AccessOutcome<&'storage mut Access<P, T>, AccessBorrowReturn, AccessInitializationFailure> =
        Access::view_extent_mut<P, T, TestMemory>(storage);
    let observed: u64 = storage.length;
    outcome
}
