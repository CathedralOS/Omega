// The returned exclusive view keeps its original extent loan live.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

machine overlap<'storage, P, T>(storage: &'storage mut Extent in Granted)
    -> PlacementOutcome<&'storage mut Placed<P, T>, PlacementBorrowReturn, PlacementInitializationFailure>
reaches ResourceProfileSupply
{
    let outcome: PlacementOutcome<&'storage mut Placed<P, T>, PlacementBorrowReturn, PlacementInitializationFailure> =
        Placed::view_extent_mut<P, T, TestMemory>(storage);
    let observed: u64 = storage.length;
    outcome
}
