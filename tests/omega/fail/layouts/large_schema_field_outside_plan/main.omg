// Full-width schema sizes do not permit a field to extend beyond its plan.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::LayoutTarget;
use omega::language::core::LayoutStorage;
use omega::language::core::FixedLayout;

data Payload { bytes: [u8; 65536]; }

Packed satisfies FixedLayout<Payload> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 },
    };
    LayoutPlan {
        entries: entries, entry_count: 1,
        size_fixed: 4096, size_is_dynamic: false, align: 1,
    }
}
}
data View { payload: LayoutStorage<Payload, Packed>; }
machine measure() -> u64 { size_of<View>() }
