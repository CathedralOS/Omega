use omega::language::core::layout;
// An exclusive loan of an IntegerAt leaf cannot reach a boundary callee through
// an ordinary helper. The callee has no checked body, so it may write any `i64`
// over the formal's whole footprint; only proven-fitting writes enter the
// one-byte backing. Native thin-pointer export lends an exclusive scalar
// descriptor at its logical width because this admission rejects narrower
// backing first.


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    LayoutPlan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}

data PortableByte [copy] { value: i64; }
data RawView { value: LayoutStorage<PortableByte, SignedByte>; }
public boundary trait Fill { machine fill(value: &mut i64) reaches; }
machine forward(value: &mut i64) reaches Fill { Fill::fill(value); }
data Main { bytes: [u8; 2]; }
machine Main::main(main: &mut Main) reaches Fill {
    let view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    forward(&mut view.value.value);
}
