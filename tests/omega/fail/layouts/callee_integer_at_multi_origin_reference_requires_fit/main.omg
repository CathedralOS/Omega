use omega::language::core::layout;
// A selected encoded reference still requires a fitting write.


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    LayoutPlan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}
data PortableByte [copy] { value: i64; }
data RawView { value: LayoutStorage<PortableByte, SignedByte>; }

data Sources<'storage> {
    first: &'storage mut i64;
    second: &'storage mut i64;
}
data Main { bytes: [u8; 2]; ordinary: i64; }

machine choose<'storage>(sources: Sources<'storage>, second: bool) -> &'storage mut i64 {
    transition second {
        true -> sources.second
        _ -> sources.first
    }
}
machine write_selected(first: &mut i64, second: &mut i64, choose_second: bool, value: i64) {
    let sources: Sources = Sources { first: first, second: second };
    let selected: &mut i64 = choose(sources, choose_second);
    selected = value;
}

machine Main::main(main: &mut Main) {
    main.bytes[0] = 0;
    main.ordinary = 1;
    let first_view: &mut RawView = &mut main.bytes[0] as &mut RawView;
    let first: &mut i64 = &mut first_view.value.value;
    write_selected(first, &mut main.ordinary, false, 128);
}
