use omega::language::core::layout;


SignedByte satisfies FixedLayout<PortableByte> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates; {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::IntegerAt {
            offset: 0,
            stored_width: 8,
            interpretation: IntegerInterpretation::Signed,
        },
    };
    LayoutPlan {
        entries: entries,
        entry_count: 1,
        size_fixed: 1,
        size_is_dynamic: false,
        align: 1,
    }
}
}
data PortableByte [copy] where value >= -1 && value <= 1 { value: i64; }
data RawView { value: LayoutStorage<PortableByte, SignedByte>; }
data ForeignByte { value: i8; }
data Main { value: RawView; }
machine Main::main(main: &mut Main) {
    let physical: &mut ForeignByte = &mut main.value as &mut ForeignByte;
    physical.value = 127;
}
