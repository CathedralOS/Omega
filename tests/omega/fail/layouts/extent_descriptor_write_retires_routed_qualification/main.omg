// A descriptor write through an alias is not an external-content write.
// Its prior routed qualification cannot justify this normal-return guarantee.
use omega::language::core::extent;

domain Extent::Registered established by register;

machine register(storage: Extent in Granted) -> Extent in Granted
ensures result in Registered
{
    storage
}

machine corrupt(storage: &mut Extent in Granted)
requires storage in Registered
ensures storage in Registered
{
    let alias: &mut Extent in Granted = storage;
    alias.length = 0u64;
}
