// Host-supplied enum payloads owe the declared active-case predicate too.
// This policy uses a smaller schema roster, not the bundled metadata shape.
data Identity
    requires (self in Identity::None)
       || ((self in Identity::Some) && self.value < 7)
{
    case None;
    case Some(value: u64);
}
data SchemaField { key: u64; identity: Identity; }
data Schema { fields: [SchemaField; 32]; field_count: u64; }
data FieldPlan { case At(offset: u64); }
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64]; entry_count: u64;
    size_fixed: u64; size_is_dynamic: bool; align: u64;
}
data Contiguous {}
machine Contiguous::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    Plan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
}
data Payload { #7 value: u32; }
data View { payload: Contiguous<Payload>; }
machine main() { let view: View; }
