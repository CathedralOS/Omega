// A shared extent loan cannot create the exclusive counterpart of View.
use omega::language::core::extent;
use omega::language::core::layout;

data TestMemory {}

machine widen<'storage, P, T>(storage: &'storage Extent in Granted)
    -> AccessOutcome<&'storage mut Access<P, T>, AccessBorrowReturn, AccessInitializationFailure>
reaches ResourceProfileSupply
{
    Access::view_extent_mut<P, T, TestMemory>(storage)
}
