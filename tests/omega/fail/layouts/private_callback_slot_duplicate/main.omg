// FAIL CANARY. One exact private callback slot may occur only once in one
// normalized native layout plan; authored offsets never distinguish identity.
use omega::language::core::layout;

boundary trait Callback {
    machine call(value: u64) -> u64;
}

data Spread {
    entries: [FieldEntry; 64];
}

CallbackSlot:
    Spread satisfies PrivateCallbackSlot<Callback::call>;

machine Spread::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let plan: Plan = Plan {
        entries: self.entries,
        entry_count: 1,
        size_fixed: 24,
        size_is_dynamic: false,
        align: 8,
    };
    let once: Plan = Plan::place_private<CallbackSlot>(plan, 8);
    Plan::place_private<CallbackSlot>(once, 16)
}

data ForeignRecord { payload: u64; }
data Main { value: Spread<ForeignRecord>; }
machine Main::main(&mut self) { }
