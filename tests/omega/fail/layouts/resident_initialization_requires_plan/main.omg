// Initialization must validate its own plan without a later Placed view.
use omega::language::core::extent;
use omega::language::core::layout;

public data Word { value: u64; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 8 },
    };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan {
            entries: entries, entry_count: 1, size_fixed: 8,
            size_is_dynamic: false, align: 8,
        },
        access: AccessPlan::inaccessible(&schema),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine initialize(storage: Extent in Granted & Vacant, value: Word)
    -> PlacementOutcome<
        Extent in Granted & Resident<WordPlacement, Word>,
        PlacementReturn<Extent in Granted & Vacant, Word>,
        PlacementInitializationFailure
    >
reaches PlacementLifecycle + ResourceProfileSupply
{
    Placed::initialize_owned<WordPlacement, Word>(storage, value)
}
