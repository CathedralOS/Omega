data Cell { code: u64; tag: u64; }
trait Equality<T> { operator == related(left: T, right: T) -> bool; }
Never satisfies Equality<u64> {
    machine related(left: u64, right: u64) -> bool { false }
}
machine required<E satisfies Equality<u64>>() requires size_of<Cell>() == 16 {}
machine program() { required<Never>(); }
