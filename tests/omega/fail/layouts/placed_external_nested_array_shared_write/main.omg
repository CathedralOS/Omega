// Must reject: a shared source borrow cannot authorize a write.
// original storage, and the caller's exclusive borrow.
use omega::language::core::layout;
public data Values { words: [[u64; 2]; 2]; }
public data ExternalPlacement {}
machine ExternalPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 32, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: true, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}
machine replace(view: &Placed<ExternalPlacement, Values>, row: u64, column: u64, value: u64)
requires row < 2 && column < 2
{
    placed_write(&mut view.words[row][column], value);
}
machine exchange(view: &mut Placed<ExternalPlacement, Values>) -> bool {
    let first: u64 = placed_read(&view.words[0][1]);
    let second: u64 = placed_read(&view.words[1][0]);
    replace(view, 0, 1, 29);
    replace(view, 1, 0, 73);
    let updated_first: u64 = placed_read(&view.words[0][1]);
    let updated_second: u64 = placed_read(&view.words[1][0]);
    first == 17 && second == 41 && updated_first == 29 && updated_second == 73
}
machine main() crashes Trap {
    let mut value: Values = Values { words: [[5, 17], [41, 11]] };
    let observed: bool = exchange(Placed::view_mut<ExternalPlacement, Values>(&mut value));
    transition observed && value.words[0][0] == 5 && value.words[0][1] == 29 &&
               value.words[1][0] == 73 && value.words[1][1] == 11 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
