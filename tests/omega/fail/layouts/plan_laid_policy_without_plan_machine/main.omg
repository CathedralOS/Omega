// PLAN-LAID VALUE TYPES, the misuse face: applying type arguments to a
// NON-GENERIC data definition that declares no `plan` machine is neither a
// generic instantiation nor a layout-policy application. The diagnostic must
// say both halves so the fix is obvious either way.
use omega_language_std::console;

data NotAPolicy {
    value: i32;
}

data Pairish {
    a: i32;
    b: i32;
}

data Main {
    payload: NotAPolicy<Pairish>;
}

machine Main::main(main: &mut Main) {
    Console::exit_process(0);
}
