// The read-only transmit policy cannot authorize the authored write.
// An externally installed placed view retains its exact backing through subordinate read/write calls and retirement.
use omega::language::core::layout;

public data Registers {
    status: u32;
    transmit: u8;
}

public data RegPlacement {}

machine RegPlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    entries[1] = FieldEntry {
        key: schema.fields[1].key,
        representation: FieldPlan::At { offset: 4 },
    };
    let layout: LayoutPlan = LayoutPlan {
            entries: entries,
            entry_count: 2,
            size_fixed: 8,
            size_is_dynamic: false,
            align: 4,
        };
    let access: AccessPlan = AccessPlan::inaccessible(layout);
    transition { _ -> place_status(schema, access) }

    machine place_status(
        schema: Schema,
        access: AccessPlan
    ) -> AccessPlan {
        let status_key: u64 = schema.fields[0].key;
        transition { _ -> place_transmit(
            schema,
            AccessPlan::with(
                access,
                status_key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            )) }
    }

    machine place_transmit(
        schema: Schema,
        access: AccessPlan
    ) -> AccessPlan {
        transition { _ -> finish(
            AccessPlan::with(
                access,
                schema.fields[1].key,
                FieldAccess::External {
                    read: ExternalRead::Read,
                    write: false,
                    exposure: Exposure::Exported,
                },
            )) }
    }

    machine finish(
        access: AccessPlan
    ) -> AccessPlan {
        let mut services: [u64; 32];
        services[0] = 7;
        AccessPlan::with_reach(
            access,
            BoundaryReach {
                services: services,
                service_count: 0,
            }
        )
    }
}

machine inspect(view: &mut Access<RegPlacement, Registers>) -> u32 {
    write(&mut view.transmit, 9u8);
    read(&view.status)
}

machine inspect_bound(view: &mut Access<RegPlacement, Registers>) -> u32 {
    let status: u32 = read(&view.status);
    status
}

machine main(view: &mut Access<RegPlacement, Registers>) crashes Trap {
    let written_status: u32 = inspect(view);
    let bound_status: u32 = inspect_bound(view);
    transition written_status == 41u32 && bound_status == 41u32 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
