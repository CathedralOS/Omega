// PLAN-LAID VALUE TYPES, the value-type gate: a policy whose plan is DYNAMIC
// cannot appear in type position -- values need offsets, bytes need mints
// (wiki/spec/layouts/plans.md). The rejection must name the policy.
use omega::language::std::console;

data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data SchemaField {
    key: u64;
    size: u64 [0..=4096];
    align: u64 [1..=16];
    number: i64;
    kind: FieldKind;
}
data Schema {
    fields: [SchemaField; 32];
    field_count: u64 [0..=32];
}
data FieldPlan {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, destination_lsb: u64, source_lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data FieldEntry { key: u64; placement: FieldPlan; }
data Plan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

data Streamy {}
machine Streamy::plan(&mut self, schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    // Distinct offsets so placement VALIDATION passes; the plan is rejected
    // in type position purely for being dynamic.
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 4 } };
    transition { _ -> done(schema, entries) }

    state done(&mut self, schema: Schema, entries: [FieldEntry; 64]) -> Plan {
        Plan {
            entries: entries,
            entry_count: schema.field_count,
            size_fixed: 0,
            size_is_dynamic: true,
            align: 1,
        }
    }
}

data Pairish {
    a: i32;
    b: i32;
}

data Main {
    console: Console;
    payload: Streamy<Pairish>;
}

machine Main::main(&mut self) {
    self.console.exit_process(0);
}
