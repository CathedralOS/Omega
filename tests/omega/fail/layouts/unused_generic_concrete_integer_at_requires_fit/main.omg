// Must reject the concrete write even in an unused template.
use omega::language::core::layout;

data SignedByte {}
machine SignedByte::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::IntegerAt {
            offset: 0, stored_width: 8, interpretation: IntegerInterpretation::Signed,
        },
    };
    Plan { entries: entries, entry_count: 1, size_fixed: 1, size_is_dynamic: false, align: 1 }
}
data PortableByte [copy] { value: i64; }
data Memory { bytes: [u8; 2]; }
machine store(destination: &mut i64, value: i64) { destination = value; }
machine unused<T>(value: T) {
    let mut storage: [u8; 2];
    let packed: &mut SignedByte<PortableByte> = &mut storage[0] as &mut SignedByte<PortableByte>;
    store(&mut packed.value, 200);
}
machine main() {}
