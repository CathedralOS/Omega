    requires machine Handler1 satisfies Callback::call;
    requires machine Handler2 satisfies Callback::call;
    requires machine Handler3 satisfies Callback::call;
    requires machine Handler4 satisfies Callback::call;
    requires machine Handler5 satisfies Callback::call;
    requires machine Handler6 satisfies Callback::call;
