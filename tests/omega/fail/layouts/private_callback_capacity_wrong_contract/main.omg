    late: LayoutStorage<GateGroup1, GateGroup1Layout>;
    after: u64;
}
public CallbackTableLayout satisfies FixedLayout<CallbackTable> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 8 } };
        entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 264 } };
        entries[3] = FieldEntry { key: schema.fields[3].key, representation: FieldPlan::At { offset: 536 } };
        LayoutPlan { entries: entries, entry_count: 4, size_fixed: 544, size_is_dynamic: false, align: 8 }
    }
}
machine group_fields(entries: &mut [FieldEntry; 64], schema: &Schema, index: u64, count: u64, remaining: u64)
terminates by remaining {
    transition index < count && index < 17 && remaining > 0 {
        true -> put(entries, schema, index, count, remaining)
        _ -> {}
    }
    machine put(entries: &mut [FieldEntry; 64], schema: &Schema, index: u64, count: u64, remaining: u64)
    requires index < 17 && remaining > 0 {
        entries[index] = FieldEntry { key: schema.fields[index].key, representation: FieldPlan::At { offset: index * 16 } };
        group_fields(entries, schema, index + 1, count, remaining - 1)
    }
}

machine fill_materializations(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature, index: u64, remaining: u64)
terminates by remaining
{
    transition index < 33 && remaining > 0 {
        true -> put(plan, signature, index, remaining)
        _ -> {}
    }
    machine put(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature, index: u64, remaining: u64)
    requires index < 33 && remaining > 0 {
        plan.call.callback_materializations[index].binder = wrong_binder(signature, index);
        plan.call.callback_materializations[index].destination = signature.callback_demands[index].destination;
        fill_materializations(plan, signature, index + 1, remaining - 1)
    }
}

// The roster has one last-entry contract. Its demand may occur anywhere: swap
// that binder with the fixed binder at its actual position, leaving all other
// matching positions alone. Native validation checks every resulting join.
machine slot_binder(signature: &BoundarySignature, index: u64) -> u64
requires index < 33 {
    transition {
        signature.callback_binders[index].requirement == signature.callback_demands[index].requirement -> signature.callback_binders[index].binder
        signature.callback_binders[32].requirement == signature.callback_demands[index].requirement -> signature.callback_binders[32].binder
        _ -> variable_position_binder(signature, 0, 33)
    }
}
machine variable_position_binder(signature: &BoundarySignature, index: u64, remaining: u64) -> u64
terminates by remaining
{
    transition index < 33 && remaining > 0 {
        true -> inspect(signature, index, remaining)
        _ -> signature.callback_binders[0].binder
    }
    machine inspect(signature: &BoundarySignature, index: u64, remaining: u64) -> u64
    requires index < 33 && remaining > 0 {
        transition signature.callback_demands[index].requirement == signature.callback_binders[32].requirement {
            true -> signature.callback_binders[index].binder
            _ -> variable_position_binder(signature, index + 1, remaining - 1)
        }
    }
}


machine handler(value: u64) -> u64 satisfies Callback::call { value ^ 85u64 }
machine last_handler(value: u64) -> u64 satisfies LastCallback::call { value ^ 23u64 }
machine initialize(gate: &mut LayoutStorage<TimerGate, TimerGateLayout>) {
    gate.selector = 4660u16; gate.ist = 5u8; gate.attributes = 142u8; gate.reserved = 2309737967u32;
}
machine initialize_last(gate: &mut LayoutStorage<TimerGate, LastGateLayout>) {
    gate.selector = 4660u16; gate.ist = 5u8; gate.attributes = 142u8; gate.reserved = 2309737967u32;
}
