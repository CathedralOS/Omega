machine wrong_binder(signature: &BoundarySignature, index: u64) -> u64
requires index < 33 {
    let selected: u64 = slot_binder(signature, index);
    transition {
        selected == signature.callback_binders[0].binder -> signature.callback_binders[32].binder
        selected == signature.callback_binders[32].binder -> signature.callback_binders[0].binder
        _ -> selected
    }
}
