// Geometry and a resource profile cannot prove facts about external contents.
use omega::language::core::extent;
use omega::language::core::layout;

public data Word where value == 17 { value: u64; }
public data WordPlacement {}

machine WordPlacement::plan(schema: Schema) -> PlacementPlan {
    let mut fields: [FieldEntry; 64];
    fields[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: fields, entry_count: 1, size_fixed: 8, size_is_dynamic: false, align: 8 },
        access: AccessPlan::with(AccessPlan::inaccessible(&schema), schema.fields[0].key,
            FieldAccess::External { read: ExternalRead::Read, write: false, exposure: Exposure::Exported }),
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine attempt(storage: &Extent in Granted) -> u64 reaches ResourceProfileSupply {
    transition Placed::view_extent<WordPlacement, Word>(storage) {
        PlacementOutcome::Ready { view } -> (placed_read(&view.value))
        PlacementOutcome::Rejected { returned, reason } -> 0
    }
}
