use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::ExtentRootProvider;
RootProvider satisfies ExtentRootProvider {
    machine grant(geometry: Extent) -> Extent { geometry }
}
machine consume(root: Extent in Granted) -> Extent { root as Extent }
machine direct(geometry: Extent) -> Extent {
    let unqualified: Extent = RootProvider::grant(geometry);
    consume(unqualified)
}
