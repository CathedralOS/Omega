// TLB custody is a linear debt: the shootdown token minted by `unmap`
// cannot be dropped at scope exit, so a teardown that forgets it rejects
// (wiki/spec/resources/extents.md "Mapping and reclamation").
use omega::language::core::assembly;
use omega::language::core::extent;

data TranslationActivationFact {
    identity: u64;
}

data TranslationCompletionFact {
    identity: u64;
}

data TranslationInstallObligations {
    facts: [TranslationActivationFact; 2];
}

data TranslationReleaseObligations {
    facts: [TranslationCompletionFact; 2];
}

boundary data MappingToken [linear];

data Mapping [linear] {
    token: MappingToken;
    install: TranslationInstallObligations;
    release: TranslationReleaseObligations;
}

domain Mapping::Pending
established by TranslationAuthority::map;

domain Mapping::Installed
established by TranslationAuthority::activate;

boundary data Shootdown [linear];

domain Shootdown::Owed;

data Unmapped {
    destination: Extent in Granted;
    source: Extent in Granted;
    shootdown: Shootdown in Owed;
}

boundary trait TranslationAuthority {
    machine map(
        source: Extent in Granted,
        destination: Extent in Granted,
        install: TranslationInstallObligations,
        release: TranslationReleaseObligations
    ) -> Mapping
    requires
        source.length == destination.length
    ensures
        result in Mapping::Pending;

    machine activate(pending: Mapping in Pending) -> Mapping
    ensures
        result in Mapping::Installed;

    machine unmap(active: Mapping in Installed) -> Unmapped;
}

boundary requirement Shootdown::discharge(self)
reaches MachineControl
requires
    self in Shootdown::Owed;

machine teardown_without_discharge(
    authority: &TranslationAuthority,
    source: Extent in Granted,
    destination: Extent in Granted
) -> Extent
requires
    source.length == destination.length
reaches TranslationAuthority + MachineControl
{
    let install: TranslationInstallObligations = TranslationInstallObligations {
        facts: [
            TranslationActivationFact { identity: 1 },
            TranslationActivationFact { identity: 2 }
        ],
    };
    let release: TranslationReleaseObligations = TranslationReleaseObligations {
        facts: [
            TranslationCompletionFact { identity: 3 },
            TranslationCompletionFact { identity: 4 }
        ],
    };
    let pending: Mapping in Pending =
        authority.map(source, destination, install, release);
    let installed: Mapping in Installed = authority.activate(pending);
    let unmapped: Unmapped = authority.unmap(installed);
    let shootdown: Shootdown in Owed = unmapped.shootdown;
    let released_destination: Extent in Granted = unmapped.destination;
    released_destination as Extent
}

data Main {
}

machine Main::main(&mut self) {
}
