// An explicitly active nested grant must not disappear when only the
// enclosing quantity is conserved.
use omega::language::core::CountedQuantity;
use omega::language::core::Content;
use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
data Units {}
data Box<T> { value: T; }
data Envelope [linear] {
    quantity: u64;
    case Occupied(storage: Box<Extent in Granted>);
    case Empty;
}
domain Envelope::Accounted;
machine Accounted::content(value: &Envelope) -> CountedQuantity<Units>
satisfies Content<Envelope, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(value.quantity) as Nat }
}
machine renew_empty(whole: Envelope in Accounted) -> Envelope in Accounted
requires whole in Envelope::Occupied
ensures core::Identity<CountedQuantity<Units>>(
    Accounted::content(old(&whole)),
    Accounted::content(&result)
) {
    Envelope::Empty { quantity: whole.quantity }
}
