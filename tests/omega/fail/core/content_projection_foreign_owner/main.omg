use omega::language::core::CountedQuantity;
use omega::language::core::Content;

data ByteUnit {}

data Region [linear] {}

domain Region::Owned;

machine Foreign::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: Nat::Zero }
}
