// A first read after an alias write supplies no callable-entry snapshot.
// The issued pieces use the post-write value, so conservation must refuse.
use omega::language::core::CountedQuantity;
use omega::language::core::Content;
use omega::language::core::drop;

public data ByteUnit {}

public data Region [linear] dropped by drop_region {
    remaining: u64;
}

machine drop_region(region: &mut Region) {}

public domain Region::Owned;

public machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

public data SplitResult {
    left: Region in Owned;
    right: Region in Owned;
}

public boundary trait RegionSplit {
    machine split(mut whole: Region in Owned, head: u64) -> SplitResult
    reaches
    requires head <= whole.remaining
    ensures
        core::Identity<CountedQuantity<ByteUnit>>(
            Owned::content(old(&whole)),
            separate(
                Owned::content(&result.left),
                Owned::content(&result.right),
            )
        );
}

machine replace(region: &mut Region) { region.remaining = 0; }

data RegionSplitProvider { }

machine RegionSplitProvider::split(mut whole: Region in Owned, head: u64) -> SplitResult
satisfies RegionSplit::split
requires head <= whole.remaining
ensures
    core::Identity<CountedQuantity<ByteUnit>>(
        Owned::content(old(&whole)),
        separate(
            Owned::content(&result.left),
            Owned::content(&result.right),
        )
    )
{
    replace(&mut whole);
    let left: Region in Owned = Region { remaining: head };
    let right: Region in Owned = Region { remaining: whole.remaining };
    drop(whole);
    SplitResult { left: left, right: right }
}

machine main() {}
