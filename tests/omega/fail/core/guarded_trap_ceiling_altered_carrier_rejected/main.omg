// The ceiling `input > 255u16` is exact for a u8 target, but this conversion's
// carrier is i8: inputs 128 through 255 trap without a declared route. The
// crash predicate belongs to the conversion's actual target carrier. The
// caller's argument disproves the route, so the conversion site inside
// `narrow` is the only undischarged obligation.
use omega_language_std::console;
use omega::language::core::binding;

machine narrow(input: u16) -> i8
crashes Trap input > 255u16 {
    (input as i8 in Trapping) as i8
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let result: i8 = narrow(70u16);
    transition result == 70i8 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
