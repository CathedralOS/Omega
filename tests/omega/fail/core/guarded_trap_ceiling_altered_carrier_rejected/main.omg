// The i8 conversion rejects inputs above 127, but the declared Trap ceiling
// only names inputs above 255. The explicit invalid branch must remain
// uncovered even though this caller supplies an in-range value.
use omega_language_std::console;

machine narrow(input: u16) -> i8
crashes Trap input > 255u16 {
    transition input > 127u16 {
        true -> invalid(input)
        _ -> (input as i8)
    }
    state invalid(input: u16) -> i8
    requires input > 127u16
    { crash Trap; }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: i8 = narrow(70u16);
    transition result == 70i8 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
