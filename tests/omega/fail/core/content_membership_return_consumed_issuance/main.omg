// An issuer cannot call consumed content fresh supply. Constructed children
// retain their separate claims even when their producers return bare carriers.
use omega::language::core::content;

data Ticket [linear] { amount: u64; }
domain Ticket::Owned established by Issuer::combine;
machine Owned::content(ticket: &Ticket) -> CountedQuantity<Nat>
satisfies Content<Ticket, CountedQuantity<Nat>>::project {
    CountedQuantity { magnitude: embed(ticket.amount) as Nat }
}
data Pair { left: Ticket in Owned; right: Ticket in Owned; }
boundary trait Issuer {
    machine combine(pair: Pair) -> Ticket in Owned reaches;
}
machine forward(ticket: Ticket in Owned) -> Ticket
ensures result in Owned { ticket }

machine combine(left: Ticket in Owned, right: Ticket in Owned) -> Ticket in Owned
reaches Issuer
invokes Issuer;
{
    Issuer::combine(Pair { left: forward(left), right: forward(right) })
}
machine main() {}
