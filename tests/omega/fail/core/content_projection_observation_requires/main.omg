use omega::language::core::content;

data ByteUnit {}
data Region [linear] { remaining: u64; }
domain Region::Owned;

machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
requires region.remaining != 0
{
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

// Normalizing this exact observation forms its subject, not the projection's
// selected precondition. No prior requires fact establishes nonzero content.
boundary trait Forward {
    machine forward(whole: Region in Owned) -> Region in Owned
    reaches
    ensures Owned::content(old(&whole)) == Owned::content(&result);
}
