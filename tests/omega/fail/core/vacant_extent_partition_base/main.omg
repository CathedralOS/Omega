use omega::language::core::extent;

// Empty content does not justify inventing a different prefix address. The
// split's scalar contract preserves the actual base even when no bytes remain.
machine empty_request(whole: Extent in Granted & Vacant) -> VacantExtentParts
ensures result.taken.base != whole.base,
        result.taken.length == 0, result.rest.length == whole.length
{
    split_vacant_extent(whole, 0)
}

machine main() {}
