use omega::language::core::extent;
use omega::language::core::program_image;

machine consume_granted(root: Extent in Granted) -> Extent {
    root as Extent
}

machine numeric_image_observation_is_not_a_root() -> Extent
reaches ProgramImage
{
    let boundary: addr = ProgramImage::retained_suffix_start();
    let unqualified: Extent = Extent { base: boundary, length: 16 };
    consume_granted(unqualified)
}
