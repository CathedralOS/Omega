// Numeric page-walk validation grants no mapping authority. The mapping
// carrier is an ordinary linear record so the authored obligation sets stay
// readable on it, but its provider identity is opaque boundary data: it has
// no public constructor, so source cannot spell a value carrying the
// `Installed` state `unmap` requires -- only the provider's establishing
// routes mint it (wiki/spec/resources/extents.md).
use omega::language::core::extent;

data TranslationActivationFact {
    identity: u64;
}

data TranslationCompletionFact {
    identity: u64;
}

data TranslationInstallObligations {
    facts: [TranslationActivationFact; 2];
}

data TranslationReleaseObligations {
    facts: [TranslationCompletionFact; 2];
}

boundary data MappingToken [linear];

data Mapping [linear] {
    token: MappingToken;
    source_base: addr;
    source_length: u64;
    destination_base: addr;
    destination_length: u64;
    install: TranslationInstallObligations;
    release: TranslationReleaseObligations;
}

domain Mapping::Pending
established by TranslationAuthority::map;

domain Mapping::Installed
established by TranslationAuthority::activate;

boundary data Shootdown [linear];

domain Shootdown::Owed;

data Unmapped {
    destination: Extent in Granted;
    source: Extent in Granted;
    shootdown: Shootdown in Owed;
}

boundary trait TranslationAuthority {
    machine map(
        source: Extent in Granted,
        destination: Extent in Granted,
        install: TranslationInstallObligations,
        release: TranslationReleaseObligations
    ) -> Mapping
    requires
        source.length == destination.length
    ensures
        result in Mapping::Pending;

    machine activate(pending: Mapping in Pending) -> Mapping
    ensures
        result in Mapping::Installed;

    machine unmap(active: Mapping in Installed) -> Unmapped;
}

machine forged_mapping_is_unqualified(authority: &TranslationAuthority)
reaches TranslationAuthority
{
    // Spelling the provider-owned token's runtime fields is rejected
    // outright: no forged value ever reaches `unmap`'s `Installed`
    // requirement, even though the geometry and obligation sets themselves
    // are ordinary authored data.
    let forged: Mapping = Mapping {
        token: MappingToken {
            root: 1,
            invocation: 2,
        },
        source_base: 4096 as addr,
        source_length: 4096,
        destination_base: 8192 as addr,
        destination_length: 4096,
        install: TranslationInstallObligations {
            facts: [
                TranslationActivationFact { identity: 1 },
                TranslationActivationFact { identity: 2 }
            ],
        },
        release: TranslationReleaseObligations {
            facts: [
                TranslationCompletionFact { identity: 3 },
                TranslationCompletionFact { identity: 4 }
            ],
        },
    };
    authority.unmap(forged);
}

data Main {
}

machine Main::main(&mut self) {
}
