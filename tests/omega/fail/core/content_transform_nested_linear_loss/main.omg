// Unqualified geometry owns no grant, but its linear custody still cannot vanish.
use omega::language::core::content;
use omega::language::core::extent;
data Units {}
data Envelope [linear] {
    quantity: u64;
    case Occupied(storage: Extent);
    case Empty;
}
domain Envelope::Accounted;
machine Accounted::content(value: &Envelope) -> CountedQuantity<Units>
satisfies Content<Envelope, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(value.quantity) as Nat }
}
machine discard_nested(whole: Envelope in Accounted) -> Envelope in Accounted
ensures Accounted::content(old(&whole)) == Accounted::content(&result) {
    Envelope::Empty { quantity: whole.quantity }
}
