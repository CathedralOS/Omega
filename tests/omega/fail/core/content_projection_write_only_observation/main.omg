use omega::language::core::content;

data ByteUnit {}
data Region [linear] { remaining: u64; }
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: embed(region.remaining) as Nat }
}

// Neither implicit shared lending nor an explicit shared wrapper can read a
// write-only subject. The enclosing storage matters as well as the leaf.
boundary trait Direct {
    machine observe(whole: &write Region in Owned)
    reaches
    ensures Owned::content(old(whole)) == Owned::content(whole);
}
data Envelope { region: Region in Owned; }
boundary trait Nested {
    machine observe(whole: &write Envelope)
    reaches
    ensures Owned::content(old(&whole.region)) == Owned::content(&whole.region);
}
