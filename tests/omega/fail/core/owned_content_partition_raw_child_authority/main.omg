// An eventual parent transformation cannot backdate qualification of a raw
// child used in an earlier declaration.
use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Granted::content;
use omega::language::core::IntervalSet;
use omega::language::core::Nat;
data Pieces { left: Extent in Granted; right: Extent in Granted; }
machine split(whole: Extent in Granted, requested: u64) -> Pieces
requires requested < whole.length
ensures core::Identity<IntervalSet<Nat>>(
    Granted::content(old(&whole)),
    separate(
        Granted::content(&result.left), Granted::content(&result.right))
) {
    let left: Extent in Granted = Extent { base: whole.base, length: requested };
    let right: Extent = Extent {
        base: whole.base + requested, length: whole.length - requested
    };
    Pieces { left: left, right: right }
}
