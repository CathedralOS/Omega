// Rejected: the sibling never acquired Ready.
// The complete return contract preserves a routed claim on a bare carrier.
// This is numeric custody, not an admission of physical memory backing.
use omega::language::core::content;
use omega::language::core::drop;

data Ticket [linear] { amount: u64; }
domain Ticket::Owned established by issue;
domain Ticket::Ready established by MarkReady::transfer;
machine Owned::content(ticket: &Ticket) -> CountedQuantity<Nat>
satisfies Content<Ticket, CountedQuantity<Nat>>::project {
    CountedQuantity { magnitude: embed(ticket.amount) as Nat }
}
machine Ready::content(ticket: &Ticket) -> CountedQuantity<Nat>
satisfies Content<Ticket, CountedQuantity<Nat>>::project {
    CountedQuantity { magnitude: embed(ticket.amount) as Nat }
}
machine issue() -> Ticket in Owned { Ticket { amount: 64 } }
machine Ticket::drop(ticket: &mut Ticket) {}

boundary trait MarkReady {
    machine transfer(ticket: Ticket in Owned) -> Ticket
    reaches
    ensures result in Owned & Ready,
            Owned::content(old(&ticket)) == Owned::content(&result);
}
ReadyProvider satisfies MarkReady {
    machine transfer(ticket: Ticket in Owned) -> Ticket
    ensures result in Owned,
            Owned::content(old(&ticket)) == Owned::content(&result)
    { ticket }
}

boundary trait ForwardOwned {
    machine transfer(ticket: Ticket in Owned) -> Ticket in Owned reaches;
}
OwnedProvider satisfies ForwardOwned {
    machine transfer(ticket: Ticket in Owned) -> Ticket in Owned { ticket }
}

data Bundle { ready: Ticket in Owned & Ready; sibling: Ticket in Owned; }
boundary trait ForwardBundle {
    machine transfer(bundle: Bundle) -> Bundle
    reaches
    ensures separate(Owned::content(old(&bundle.ready)), Owned::content(old(&bundle.sibling)))
                == separate(Owned::content(&result.ready), Owned::content(&result.sibling)),
            Ready::content(old(&bundle.ready)) == Ready::content(&result.ready);
}
BundleProvider satisfies ForwardBundle {
    machine transfer(bundle: Bundle) -> Bundle
    ensures separate(Owned::content(old(&bundle.ready)), Owned::content(old(&bundle.sibling)))
                == separate(Owned::content(&result.ready), Owned::content(&result.sibling)),
            Ready::content(old(&bundle.ready)) == Ready::content(&result.ready)
    { bundle }
}

machine direct(ticket: Ticket in Owned) -> Ticket
ensures result in Owned,
        Owned::content(old(&ticket)) == Owned::content(&result)
{ ticket }

machine local(ticket: Ticket in Owned) -> Ticket
ensures result in Owned {
    let saved: Ticket in Owned = ticket;
    saved
}

data Holder { ticket: Ticket in Owned; }
machine field(holder: Holder) -> Ticket
ensures result in Owned {
    let { ticket } = holder;
    ticket
}

machine joined(ticket: Ticket in Owned, selected: bool) -> Ticket
ensures result in Owned {
    transition selected {
        true -> (ticket)
        _ -> (ticket)
    }
}

// A derived result consumes the same membership judgment as a qualified
// result field: the equation and exact parent custody must both hold.
machine reconstruct(ticket: Ticket in Owned) -> Ticket
ensures result in Owned,
        Owned::content(old(&ticket)) == Owned::content(&result)
{
    let { amount } = ticket;
    Ticket { amount: amount }
}

machine inspect(ticket: Ticket in Owned) -> bool {
    let correct: bool = ticket.amount == 64;
    drop(ticket);
    correct
}

machine inspect_ready(ticket: Ticket in Owned & Ready) -> bool {
    let correct: bool = ticket.amount == 64;
    drop(ticket);
    correct
}

machine prepare(ticket: Ticket in Owned) -> Ticket in Owned & Ready
reaches MarkReady + ForwardOwned
invokes MarkReady;
invokes ForwardOwned;
{
    MarkReady::transfer(ForwardOwned::transfer(ticket))
}

machine main()
reaches MarkReady + ForwardOwned + ForwardBundle
invokes MarkReady;
invokes ForwardOwned;
invokes ForwardBundle;
crashes Trap {
    let first: bool = inspect(direct(issue()));
    let second: bool = inspect(local(issue()));
    let third: bool = inspect(field(Holder { ticket: issue() }));
    let fourth: bool = inspect(joined(issue(), true));
    let fifth: bool = inspect(joined(issue(), false));
    let sixth: bool = inspect(reconstruct(issue()));
    let seventh: bool = inspect_ready(prepare(issue()));
    let bundle: Bundle = ForwardBundle::transfer(Bundle {
        ready: prepare(issue()), sibling: issue()
    });
    let { ready, sibling } = bundle;
    let eighth: bool = inspect_ready(ready);
    let ninth: bool = inspect_ready(sibling);
    transition first && second && third && fourth && fifth && sixth && seventh && eighth && ninth {
        true -> done()
        _ -> wrong()
    }
    state done() {}
    state wrong() { crash Trap; }
}
