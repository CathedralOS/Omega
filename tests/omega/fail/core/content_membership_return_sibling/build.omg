machine build(builder: &mut Build) {
    Build::application(builder, "content_membership_return");
    Build::accept_boundary<MarkReady>(builder);
    Build::select_provider<MarkReady, ReadyProvider>(builder);
    Build::accept_boundary<ForwardOwned>(builder);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder);
    Build::accept_boundary<ForwardBundle>(builder);
    Build::select_provider<ForwardBundle, BundleProvider>(builder);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
