machine build(builder: &mut Build) {
    Build::application(builder, "content_membership_return");
    Build::accept_boundary<MarkReady>(builder);
    Build::select_provider<MarkReady, ReadyProvider>(builder, linux_arm64);
    Build::select_provider<MarkReady, ReadyProvider>(builder, linux_x86_64);
    Build::select_provider<MarkReady, ReadyProvider>(builder, macos_arm64);
    Build::select_provider<MarkReady, ReadyProvider>(builder, macos_x86_64);
    Build::select_provider<MarkReady, ReadyProvider>(builder, windows_x86_64);
    Build::select_provider<MarkReady, ReadyProvider>(builder, uefi_x86_64);
    Build::select_provider<MarkReady, ReadyProvider>(builder, cross_platform_cli);
    Build::select_provider<MarkReady, ReadyProvider>(builder, local_unchecked);
    Build::select_provider<MarkReady, ReadyProvider>(builder, alpha_bootstrap);
    Build::accept_boundary<ForwardOwned>(builder);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, linux_arm64);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, linux_x86_64);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, macos_arm64);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, macos_x86_64);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, windows_x86_64);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, uefi_x86_64);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, cross_platform_cli);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, local_unchecked);
    Build::select_provider<ForwardOwned, OwnedProvider>(builder, alpha_bootstrap);
    Build::accept_boundary<ForwardBundle>(builder);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, linux_arm64);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, linux_x86_64);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, macos_arm64);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, macos_x86_64);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, windows_x86_64);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, uefi_x86_64);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, cross_platform_cli);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, local_unchecked);
    Build::select_provider<ForwardBundle, BundleProvider>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
