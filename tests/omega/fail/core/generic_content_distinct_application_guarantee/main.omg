// Expected exit: 0. Substituted guarantees keep distinct formal scopes.
use omega::language::core::content;
use omega::language::core::drop;
data Units {}
const FirstExpected: u64 = 29;
const SecondExpected: u64 = 30;
data Region [linear] { amount: u64; marker: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> CountedQuantity<Units>
satisfies Content<Region, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(region.amount) as Nat }
}
trait Transfer<const Expected: u64> {
    machine transfer(region: Region in Owned) -> Region in Owned
    ensures Owned::content(old(&region)) == Owned::content(&result),
        result.marker == Expected;
}
First satisfies Transfer<FirstExpected> {
machine transfer(region: Region in Owned) -> Region in Owned
ensures Owned::content(old(&region)) == Owned::content(&result),
    result.marker == 29
{
    let amount: u64 = region.amount;
    drop(region);
    Region { amount: amount, marker: 29 }
}
}
Second satisfies Transfer<SecondExpected> {
machine transfer(region: Region in Owned) -> Region in Owned
ensures Owned::content(old(&region)) == Owned::content(&result),
    result.marker == 29
{
    let amount: u64 = region.amount;
    drop(region);
    Region { amount: amount, marker: 29 }
}
}
machine main() crashes Trap {
    let one: Region in Owned = First::transfer(Region { amount: 7, marker: 0 });
    let two: Region in Owned = Second::transfer(Region { amount: 9, marker: 0 });
    let correct: bool = one.amount == 7 && one.marker == 29
        && two.amount == 9 && two.marker == 30;
    drop(one);
    drop(two);
    transition correct { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
