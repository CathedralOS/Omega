// An Exact library conversion owes its `requires` at every call. `value` is
// an unconstrained u32, so `value <= 65535` is unproven and the call
// rejects. The caller's own argument (70) does not reach inside `narrow`;
// a dominating guard, a `requires`, or a policy-bearing conversion is the
// escape.
use omega::language::core::numeric_conversion;
use omega_language_std::console;

machine narrow(value: u32) -> u16 {
    narrow_u32_to_u16_exact(value)
}

data Main {
    source: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source = 70;
    let converted: u16 = narrow(main.source);
    let code: i32 = converted as i32;
    Console::exit_process(code);
}
