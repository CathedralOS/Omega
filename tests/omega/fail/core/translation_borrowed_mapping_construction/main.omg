// The borrowed-source carrier is ordinary data, but its provider identity
// half is not: `BorrowedMappingToken` is opaque boundary data with no
// public constructor, so source cannot assemble a `BorrowedMapping` and
// requalify it `Installed` -- only the provider's establishing routes mint
// the token (wiki/spec/resources/extents.md "Mapping and reclamation").
// The authored geometry and obligation sets beside it are ordinary data
// and change nothing about that gate.
use omega::language::core::extent;

data TranslationActivationFact {
    identity: u64;
}

data TranslationCompletionFact {
    identity: u64;
}

data TranslationInstallObligations {
    facts: [TranslationActivationFact; 2];
}

data TranslationReleaseObligations {
    facts: [TranslationCompletionFact; 2];
}

boundary data BorrowedMappingToken [linear];

data BorrowedMapping [linear] {
    token: BorrowedMappingToken;
    held_source: &Extent in Granted;
    source_base: addr;
    source_length: u64;
    destination_base: addr;
    destination_length: u64;
    install: TranslationInstallObligations;
    release: TranslationReleaseObligations;
}

domain BorrowedMapping::Pending
established by TranslationAuthority::map_borrowed;

domain BorrowedMapping::Installed
established by TranslationAuthority::activate_borrowed;

data UnmappedBorrowed {
    destination: Extent in Granted;
    shootdown: &Extent in Granted;
}

boundary trait TranslationAuthority {
    machine map_borrowed(
        source: &Extent in Granted,
        destination: Extent in Granted,
        install: TranslationInstallObligations,
        release: TranslationReleaseObligations
    ) -> BorrowedMapping
    requires
        source.length == destination.length
    ensures
        result in BorrowedMapping::Pending;

    machine activate_borrowed(pending: BorrowedMapping in Pending)
        -> BorrowedMapping
    ensures
        result in BorrowedMapping::Installed;

    machine unmap_borrowed(active: BorrowedMapping in Installed)
        -> UnmappedBorrowed;
}

machine forged_borrowed_is_unqualified(
    authority: &TranslationAuthority,
    source: Extent in Granted
) -> UnmappedBorrowed
reaches TranslationAuthority
{
    // Spelling the provider-owned token's runtime fields is rejected
    // outright: no forged carrier ever reaches `unmap_borrowed`'s
    // `Installed` requirement.
    let forged: BorrowedMapping = BorrowedMapping {
        token: BorrowedMappingToken {
            identity: 7,
        },
        held_source: &source,
        source_base: 4096 as addr,
        source_length: 4096,
        destination_base: 8192 as addr,
        destination_length: 4096,
        install: TranslationInstallObligations {
            facts: [
                TranslationActivationFact { identity: 1 },
                TranslationActivationFact { identity: 2 }
            ],
        },
        release: TranslationReleaseObligations {
            facts: [
                TranslationCompletionFact { identity: 3 },
                TranslationCompletionFact { identity: 4 }
            ],
        },
    };
    let installed: BorrowedMapping in Installed = forged;
    authority.unmap_borrowed(installed)
}

data Main {
}

machine Main::main(&mut self) {
}
