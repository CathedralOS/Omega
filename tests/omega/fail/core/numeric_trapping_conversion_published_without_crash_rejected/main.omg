// A published machine names every crash cause it may commit; omitting a
// cause forbids it. Calling a trapping conversion from a `pub` machine
// therefore needs `crashes Trap`, unlike a private body, whose crash ceiling
// is inferred.
use omega::language::core::numeric_conversion;
use omega_language_std::console;

pub machine narrow(value: u16) -> u8 {
    narrow_u16_to_u8_trapping(value)
}

data Main {
    source: u16;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source = 70;
    let converted: u8 = narrow(main.source);
    let code: i32 = converted as i32;
    Console::exit_process(code);
}
