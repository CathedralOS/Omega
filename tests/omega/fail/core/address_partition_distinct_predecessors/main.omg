// A joined state cannot choose one of two different incoming entry identities.
use omega::language::core::content;
use omega::language::core::drop;
data Region [linear] { base: addr; length: u64; }
machine Region::drop(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.base) as Nat,
        end: (embed(region.base) + embed(region.length)) as Nat }
}
machine choose(whole: Region in Owned, other: Region in Owned, first: bool) -> Region in Owned
ensures Owned::content(old(&whole)) == Owned::content(&result)
{
    transition first {
        true -> finish(whole, other)
        false -> finish(other, whole)
    }
    machine finish(selected: Region in Owned, discarded: Region in Owned) -> Region in Owned {
        drop(discarded);
        selected
    }
}
