// Observing a reference-bearing value captures its descriptor, not future referent contents.
use omega::language::core::content;
data Unit {}
data Cell { value: u64; }
data View<'storage> [linear] { target: &'storage mut Cell; }
domain View::Owned;
machine Owned::content<'storage>(view: &View<'storage>) -> CountedQuantity<Unit>
satisfies Content<View<'storage>, CountedQuantity<Unit>>::project {
    CountedQuantity { magnitude: embed(view.target.value) as Nat }
}
machine observe<'storage>(view: &View<'storage>) -> u64 { view.target.value }
machine unchanged<'storage>(mut view: View<'storage> in Owned) -> View<'storage> in Owned
ensures Owned::content(old(&view)) == Owned::content(&result)
{
    let captured: u64 = observe(&view);
    view.target.value = 0;
    view
}
