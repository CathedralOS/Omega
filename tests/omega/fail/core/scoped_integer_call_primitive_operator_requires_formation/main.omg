// A selected primitive-domain operation returns nine, never the builtin sum.
domain i16::Degrees;
machine + i16::Degrees::replace(left: i16, right: i16) -> i16 { 9i16 }
machine restricted(value: i16) -> i16
requires value == 0i16
ensures result == value { value }
machine caller(left: i16, right: i16)
requires left == 0i16 && right == 0i16
requires restricted((left as i16 in Degrees) + (right as i16 in Degrees))
    == restricted((left as i16 in Degrees) + (right as i16 in Degrees)) {}
machine main() {}
