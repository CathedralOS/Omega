use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "opaque_factory");
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind<Factory::acquire>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_getpid" } });
}
