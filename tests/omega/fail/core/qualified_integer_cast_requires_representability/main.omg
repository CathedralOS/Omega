// A target arithmetic policy qualifies future operations. It cannot change
// this value, even when the machine publishes a Trap ceiling.
machine wrapping(value: i16) -> u8 in Wrapping {
    value as u8 in Wrapping
}
machine saturating(value: i16) -> i8 in Saturating {
    value as i8 in Saturating
}
machine trapping(value: u16) -> i8 in Trapping crashes Trap {
    value as i8 in Trapping
}
// Constant evaluation cannot turn a policy qualification into conversion.
machine constant_saturating() -> i8 in Saturating {
    200i16 as i8 in Saturating
}
machine negative_wrapping() -> u64 in Wrapping {
    (-1i16) as u64 in Wrapping
}
