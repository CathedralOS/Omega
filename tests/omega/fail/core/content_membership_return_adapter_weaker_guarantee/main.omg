// A checked adapter of a boundary requirement does not confer the
// requirement's admitted membership on a direct call. The adapter guarantees
// only `Granted`, so the caller's `Vacant` conjunct must be refused. The
// admitted crossing is the requirement's own call; this fixture pins the
// direct realization call that is not it.
use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::VacantContentTransfer;
use omega::language::core::Extent::Granted;
use omega::language::core::Granted::content;
use omega::language::core::IntervalSet;
use omega::language::core::Nat;
Adapter satisfies VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
    ensures result in Granted,
            core::Identity<IntervalSet<Nat>>(
                Granted::content(old(&storage)),
                Granted::content(&result)
            )
    { storage }
}
machine direct(storage: Extent in Granted) -> Extent
ensures result in Granted & Vacant
{ Adapter::transfer(storage) }
machine main() {}
