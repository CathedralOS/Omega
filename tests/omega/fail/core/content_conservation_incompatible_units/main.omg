use omega::language::core::content;

public data ByteUnit {}
public data WordUnit {}
public data Region [linear] { length: u64; }
public domain Region::Bytes;
public domain Region::Words;

public machine Bytes::content(region: &Region) -> CountedQuantity<ByteUnit>
satisfies Content<Region, CountedQuantity<ByteUnit>>::project
{ CountedQuantity { magnitude: embed(region.length) as Nat } }

public machine Words::content(region: &Region) -> CountedQuantity<WordUnit>
satisfies Content<Region, CountedQuantity<WordUnit>>::project
{ CountedQuantity { magnitude: embed(region.length) as Nat } }

data Pieces { left: Region in Bytes; right: Region in Words; }
trait InvalidSplit {
    machine split(whole: Region in Bytes) -> Pieces
    ensures Bytes::content(old(&whole))
        == separate(Bytes::content(&result.left), Words::content(&result.right));
}
machine main() {}
