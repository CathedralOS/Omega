// Independent input guards produce independent crash sites. The ceiling
// covers invalid `low`, but cannot cover invalid `high`. Exact coercions on
// the successful path do not introduce any implicit crash behavior.
use omega_language_std::console;

machine pack(low: u16, high: u16) -> u16
crashes Trap low > 255u16 {
    transition low > 255u16 {
        true -> invalid_low(low, high)
        _ -> check_high(low, high)
    }

    machine check_high(low: u16, high: u16) -> u16
    requires low <= 255u16
    {
        transition high > 255u16 {
            true -> invalid_high(low, high)
            _ -> exact(low, high)
        }
    }
    machine exact(low: u16, high: u16) -> u16
    requires low <= 255u16, high <= 255u16
    {
        let low_byte: u8 = low as u8;
        let high_byte: u8 = high as u8;
        (low_byte as u16) + (high_byte as u16)
    }
    machine invalid_low(low: u16, high: u16) -> u16
    requires low > 255u16
    { crash Trap; }
    machine invalid_high(low: u16, high: u16) -> u16
    requires high > 255u16
    { crash Trap; }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let packed: u16 = pack(30u16, 40u16);
    transition packed == 70u16 {
        true -> good(main)
        false -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
