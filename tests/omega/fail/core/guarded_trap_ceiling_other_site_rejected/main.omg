// Each Trapping conversion is its own site with its own operand. The ceiling
// covers the conversion of `low` but not the conversion of `high`, so the
// second site's trap is uncovered even though both predicates have the same
// shape. The caller's arguments disprove the route, so the uncovered site
// inside `pack` is the only undischarged obligation.
use omega_language_std::console;
use omega::language::core::binding;

machine pack(low: u16, high: u16) -> u16
crashes Trap low > 255u16 {
    let low_byte: u8 = (low as u8 in Trapping) as u8;
    let high_byte: u8 = (high as u8 in Trapping) as u8;
    (low_byte as u16) + (high_byte as u16)
}

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let packed: u16 = pack(30u16, 40u16);
    transition packed == 70u16 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
