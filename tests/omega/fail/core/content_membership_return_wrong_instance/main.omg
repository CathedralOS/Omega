use omega::language::core::Extent;
use omega::language::core::Extent::Resident;
use omega::language::core::Extent::Granted;
data First {}
data Second {}
data Value { number: u64; }
machine change(storage: Extent in Granted & Resident<First, Value>) -> Extent
ensures result in Granted & Resident<Second, Value> { storage }
machine main() {}
