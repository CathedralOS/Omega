data Token [linear] { value: u64; }
data Pair { left: Token; right: Token; }
machine replace(choice: u64) -> Pair {
    let mut pair: Pair = match choice {
        0 -> Pair { left: Token { value: 1 }, right: Token { value: 2 } },
        _ -> Pair { left: Token { value: 3 }, right: Token { value: 4 } },
    };
    pair = match choice {
        0 -> Pair { left: Token { value: 5 }, right: Token { value: 6 } },
        _ -> Pair { left: Token { value: 7 }, right: Token { value: 8 } },
    };
    pair
}
