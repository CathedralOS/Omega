use omega::language::core::drop;
data Ticket [linear] { amount: u64; }
domain Ticket::Owned established by issue;
machine issue() -> Ticket in Owned { Ticket { amount: 64 } }
machine Ticket::drop(ticket: &mut Ticket) {}
machine choose(ticket: Ticket in Owned, selected: bool) -> Ticket
ensures result in Owned {
    transition selected {
        true -> (ticket)
        _ -> replace(ticket)
    }
    machine replace(ticket: Ticket in Owned) -> Ticket {
        drop(ticket);
        Ticket { amount: 64 }
    }
}
machine main() {}
