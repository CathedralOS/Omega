data Input [copy] { value: i16; }
// This selected operation returns nine rather than any builtin arithmetic.
machine + Input::replace(left: Input, right: Input) -> i16
ensures result == 9i16 { 9i16 }
machine identity(value: i16) -> i16 ensures result == value { value }
machine caller(left: Input, right: Input) -> i16
ensures (identity(left + right) as i16 in Saturating) == result { left.value }
machine main() {}
