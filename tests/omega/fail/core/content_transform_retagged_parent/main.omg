// Entry Empty evidence cannot waive an active payload installed by a later write.
use omega::language::core::content;
use omega::language::core::drop;
data Units {}
data Ticket [linear] { quantity: u64; }
machine Ticket::drop(value: &mut Ticket) {}
domain Ticket::Counted;
machine Counted::content(value: &Ticket) -> CountedQuantity<Units>
satisfies Content<Ticket, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(value.quantity) as Nat }
}
machine identity_ticket(value: Ticket in Counted) -> Ticket in Counted
ensures Counted::content(old(&value)) == Counted::content(&result) {
    Ticket { quantity: value.quantity }
}
data Box<T> { value: T; }
data Choice {
    case Occupied(storage: Box<Ticket in Counted>);
    case Empty;
}
data Envelope [linear] { quantity: u64; payload: Choice; }
domain Envelope::Accounted;
machine Accounted::content(value: &Envelope) -> CountedQuantity<Units>
satisfies Content<Envelope, CountedQuantity<Units>>::project {
    CountedQuantity { magnitude: embed(value.quantity) as Nat }
}
machine renew_empty(mut whole: Envelope in Accounted, ticket: Ticket in Counted) -> Envelope in Accounted
requires whole.payload in Choice::Empty
ensures Accounted::content(old(&whole)) == Accounted::content(&result) {
    let quantity: u64 = whole.quantity;
    whole.payload = Choice::Occupied { storage: Box { value: ticket } };
    Envelope { quantity: quantity, payload: Choice::Empty {} }
}
