// A pending mapping is not installed translations: unmapping requires the
// exact `Installed` state, so `unmap` on a `Pending` carrier rejects
// (wiki/spec/resources/extents.md "Mapping and reclamation").
use omega::language::core::extent;

public data TranslationActivationFact {
    identity: u64;
}

public data TranslationCompletionFact {
    identity: u64;
}

public data TranslationInstallObligations {
    facts: [TranslationActivationFact; 2];
}

public data TranslationReleaseObligations {
    facts: [TranslationCompletionFact; 2];
}

public boundary data MappingToken [linear];

public data Mapping [linear] {
    token: MappingToken;
    source_base: addr;
    source_length: u64;
    destination_base: addr;
    destination_length: u64;
    install: TranslationInstallObligations;
    release: TranslationReleaseObligations;
}

public domain Mapping::Pending
established by TranslationAuthority::map;

public domain Mapping::Installed
established by TranslationAuthority::activate;

public boundary data Shootdown [linear];

public domain Shootdown::Owed;

public data Unmapped {
    destination: Extent in Granted;
    source: Extent in Granted;
    shootdown: Shootdown in Owed;
}

public boundary trait TranslationAuthority {
    machine map(
        source: Extent in Granted,
        destination: Extent in Granted,
        install: TranslationInstallObligations,
        release: TranslationReleaseObligations
    ) -> Mapping
    reaches
    requires
        source.length == destination.length
    ensures
        result in Mapping::Pending;

    machine activate(pending: Mapping in Pending) -> Mapping
    reaches
    ensures
        result in Mapping::Installed;

    machine unmap(active: Mapping in Installed) -> Unmapped reaches;
}

machine unmap_early(source: Extent in Granted, destination: Extent in Granted) -> Unmapped
requires
    source.length == destination.length
reaches TranslationAuthority
{
    let install: TranslationInstallObligations = TranslationInstallObligations {
        facts: [
            TranslationActivationFact { identity: 1 },
            TranslationActivationFact { identity: 2 }
        ],
    };
    let release: TranslationReleaseObligations = TranslationReleaseObligations {
        facts: [
            TranslationCompletionFact { identity: 3 },
            TranslationCompletionFact { identity: 4 }
        ],
    };
    let pending: Mapping in Pending =
        TranslationAuthority::map(source, destination, install, release);
    TranslationAuthority::unmap(pending)
}

machine main() {
}
