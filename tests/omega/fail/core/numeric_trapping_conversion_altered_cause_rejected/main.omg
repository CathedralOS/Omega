// A trapping conversion publishes `crashes Trap`. This caller authors only an
// Abort ceiling, so the callee's Trap route is uncovered: a different crash
// cause is not a substitute for the one the operation commits.
use omega::language::core::numeric_conversion;
use omega_language_std::console;

machine narrow(value: u16) -> u8
crashes Abort
{
    narrow_u16_to_u8_trapping(value)
}

data Main {
    source: u16;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source = 70;
    let converted: u8 = narrow(main.source);
    let code: i32 = converted as i32;
    Console::exit_process(code);
}
