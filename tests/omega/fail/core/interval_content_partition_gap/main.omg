// Exact interval partition prerequisite for backed kernel allocation.
// Expected rejection: the returned intervals do not establish the authored partition.
use omega::language::core::IntervalSet;
use omega::language::core::Content;
use omega::language::core::drop;
use omega::language::core::Nat;

data Region [linear] dropped by drop_region { start: u64; end: u64; }
machine drop_region(region: &mut Region) {}
domain Region::Owned;
machine Owned::content(region: &Region) -> IntervalSet<Nat>
satisfies Content<Region, IntervalSet<Nat>>::project {
    IntervalSet { start: embed(region.start) as Nat, end: embed(region.end) as Nat }
}
data Pieces { left: Region in Owned; right: Region in Owned; }
machine split(whole: Region in Owned, cut: u64) -> Pieces
requires whole.start <= cut && cut <= whole.end
ensures core::Identity<IntervalSet<Nat>>(
    Owned::content(old(&whole)),
    separate(
        Owned::content(&result.left), Owned::content(&result.right))
)
{
    let left: Region in Owned = Region { start: whole.start, end: cut };
    let right: Region in Owned = Region { start: whole.end, end: whole.end };
    drop(whole);
    Pieces { left: left, right: right }
}
