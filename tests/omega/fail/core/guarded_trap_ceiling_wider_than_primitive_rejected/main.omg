// A guarded Trap ceiling must cover exactly its primitive's trap condition.
// `u16 -> u8` in Trapping traps for every input above 255, but this ceiling
// names only inputs above 256: input 256 would trap without a declared crash
// route, so checking rejects the machine.
machine narrow(input: u16) -> u8
crashes Trap input > 256u16 {
    (input as u8 in Trapping) as u8
}

use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let result: u8 = narrow(255u16);
    transition result == 255u8 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
