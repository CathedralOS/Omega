// A containing content transaction cannot qualify an earlier explicit cast.
use omega::language::core::extent;
use omega::language::core::content;
data Pieces { left: Extent in Granted; right: Extent in Granted; }
machine split(whole: Extent in Granted, requested: u64) -> Pieces
requires requested < whole.length
ensures Granted::content(old(&whole)) == separate(
    Granted::content(&result.left), Granted::content(&result.right)) {
    Pieces {
        left: Extent { base: whole.base, length: requested } as Extent in Granted,
        right: Extent {
            base: whole.base + requested, length: whole.length - requested
        }
    }
}
