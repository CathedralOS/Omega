use omega::language::core::extent;
use omega::language::core::content;
machine invalid(whole: Extent in Granted) -> VacantExtentParts
requires whole.length == 48
ensures Granted::content(old(&whole)) == separate(
    Granted::content(&result.taken), Granted::content(&result.rest))
{
    let { base, length } = whole;
    VacantExtentParts {
        taken: Extent { base: base, length: 16 },
        rest: Extent { base: base + 16, length: length - 16 },
    }
}
machine main() {}
