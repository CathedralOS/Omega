// Having a parent and producing plausible children is not a partition proof.
use omega::language::core::extent;

data Pieces { left: Extent in Granted; right: Extent in Granted; }

machine split(whole: Extent in Granted, requested: u64) -> Pieces
requires requested < whole.length
{
    let left: Extent = Extent { base: whole.base, length: requested };
    let right: Extent = Extent {
        base: whole.base + requested,
        length: whole.length - requested
    };
    Pieces { left: left, right: right }
}
