// Signed narrowing has two invalid regions. This explicit conversion body
// crashes for either region, while its contract covers only the upper one.
// Carrying the original input into the crash state must preserve that debt.
use omega_language_std::console;

machine narrow(input: i16) -> i8
crashes Trap input > 127i16 {
    transition input < -128i16 || input > 127i16 {
        true -> invalid(input)
        _ -> (input as i8)
    }
    state invalid(input: i16) -> i8 { crash Trap; }
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let result: i8 = narrow(70i16);
    transition result == 70i8 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
