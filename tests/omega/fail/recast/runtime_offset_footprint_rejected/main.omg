// FAIL CANARY (rung C1 footprint): `off: u32 [0..=9]` admits offset 9,
// where a 4-byte view would read bytes 9..13 of a 12-byte region --
// refused at the declaration through the offset's enforced interval.
use omega::language::std::console;
data Main { console: Console; buf: [u8; 12]; k: u32 [0..=9]; out: i32; }
machine Main::main(&mut self) {
    self.buf[4] = 1;
    self.buf[5] = 2;
    self.buf[6] = 3;
    self.buf[7] = 4;
    self.k = 4;
    transition self.k == 4 { true -> read(self.k) _ -> bad() }
    state read(&mut self, off: u32 [0..=9]) {
        let v: &u32 = &self.buf[off] as &u32;
        transition v == 67305985 {
            true -> good()
            _ -> bad()
        }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
}
