// FAIL CANARY: a mutable record view owes fact implication in both
// directions. Arbitrary byte writes cannot preserve a constrained field.
domain u16::Small(value)
requires
    value <= 10;

data Facted {
    value: u16 in Small;
}

data Main {
    bytes: [u8; 2];
}

machine Main::main(main: &mut Main) {
    let view: &mut Facted = &mut main.bytes[0] as &mut Facted;
    view.value = 1;
}
