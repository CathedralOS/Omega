// A symbolic address-model premise does not bound a runtime buffer offset.
machine read(buffer: &[u8; 16], offset: u64 in Trapping) -> u64
requires addr::Bound == 18446744073709551616
{
    transition { _ -> inspect(buffer, offset) }
    state inspect(buffer: &[u8; 16], offset: u64 in Trapping) -> u64
    requires addr::Bound == 18446744073709551616
    {
        let word: &u64 = &buffer[offset] as &u64;
        word
    }
}
