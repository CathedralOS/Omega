// FAIL CANARY: a field bounded by its owner's `where` facts keeps that bound
// under a mutable alias. `byte` stores only 0 and 1; an `&mut i8` view could
// store 2, so the view owes representation equivalence it cannot prove. The
// equivalent `&mut bool` alias stays legal
// (`pass/recast/runtime_bool_representation_recast_exit`).
data Main
requires
    byte >= 0 && byte <= 1,
{
    byte: u8;
}

machine Main::main(main: &mut Main) {
    let bits: &mut i8 = &mut main.byte as &mut i8;
    bits = 2;
}
