// FAIL CANARY: a `where` fact relating two fields is not a bound on either
// leaf alone, so the leaf-wise representation comparison cannot preserve it.
// Such records stay outside the typed aggregate recast judgment.
data Ordered
where
    low <= high,
{
    low: i32;
    high: i32;
}

data Pair {
    first: i32;
    second: i32;
}

data Main {
    pair: Pair;
}

machine Main::main(main: &mut Main) {
    let view: &Ordered = &main.pair as &Ordered;
}
