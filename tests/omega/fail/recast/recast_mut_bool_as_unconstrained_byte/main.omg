// FAIL CANARY: a mutable alias owes representation equivalence in both
// directions. `bool` stores only the bytes 0 and 1, while an unconstrained
// `&mut u8` view could store 2 into the Boolean, which no `bool` read could
// then interpret. The revoked `&mut u8 [0..=1]` local spelling has no
// canonical replacement: a local reference cannot carry a range.
data Main {
    flag: bool;
}

machine Main::main(main: &mut Main) {
    let flag_bits: &mut u8 = &mut main.flag as &mut u8;
    flag_bits = 0;
}
