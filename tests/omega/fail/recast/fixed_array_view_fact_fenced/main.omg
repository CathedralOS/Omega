use omega::language::std::console;

data Main {
    console: Console;
    bytes: [u8; 4];
}

machine Main::main(&mut self) {
    // Raw bytes do not prove bool's established {0, 1} representation.
    let flags: &[bool; 4] = &self.bytes[0] as &[bool; 4];
    transition flags[0] {
        true -> done()
        false -> done()
    }

    state done(&mut self) { self.console.exit_process(0); }
}
