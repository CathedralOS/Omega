// A mutable record view held in a local suspends `main.pair_bytes` until its
// last use, so writing that field through the forwarded owner before the
// view's last write overlaps two exclusive loans
// (wiki/spec/language/ownership.md#borrows-and-aliases).
data Pair {
    low: u16;
    high: u16;
}

data Main {
    pair_bytes: [u8; 12];
}

machine Main::main(main: &mut Main) {
    let pairs: &mut [Pair] = &mut main.pair_bytes[4] as &mut [Pair];
    transition pairs.len > 1 {
        true -> write_pairs(main, pairs)
        _ -> done(main)
    }

    machine write_pairs(main: &mut Main, pairs: &mut [Pair]) {
    main.pair_bytes[4] = 0;
    pairs[0].low = 0x0201;
    transition { _ -> done(main) }
    }

    machine done(main: &mut Main) {}
}

machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
