// FAIL CANARY: equal width and equal range cardinality do not establish
// representation equivalence. The target admits bit pattern 101 while the
// source admits bit pattern 0, so either mutable alias could invalidate the
// other view's range fact.
data SignedBounded
where
    value >= 0 && value <= 100,
{
    value: i32;
}

data ShiftedUnsigned
where
    value >= 1 && value <= 101,
{
    value: u32;
}

data Main {
    value: SignedBounded;
}

machine Main::main(main: &mut Main) {
    let view: &mut ShiftedUnsigned = &mut main.value as &mut ShiftedUnsigned;
}
