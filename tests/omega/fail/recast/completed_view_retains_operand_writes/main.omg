data Word [copy] { value: u64; }
data Retry { count: u64; }
machine offset(retry: &mut Retry) -> u64 in Trapping ensures result == 0 {
    retry.count = 2;
    0
}
machine read(buffer: &[u8; 16], retry: &mut Retry) -> u64
requires addr::Bound == 18446744073709551616 && retry.count <= 1
{
    let word: &Word = &buffer[offset(retry)] as &Word;
    transition { _ -> finish(word.value, retry.count) }
    machine finish(value: u64, retry: u64) -> u64
    requires addr::Bound == 18446744073709551616 && retry <= 1
    { value }
}
