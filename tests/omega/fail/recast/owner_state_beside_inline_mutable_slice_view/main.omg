// The owner may arrive beside a mutable view of its own field, but the view
// suspends `main.tail_bytes` until its last use: writing that field through
// the owner while the view is still forwarded overlaps two exclusive loans
// (wiki/spec/language/ownership.md#borrows-and-aliases).
data Main
requires k <= 4,
{
    tail_bytes: [u8; 8];
    k: u32;
}

machine Main::main(main: &mut Main) {
    main.k = 3;
    transition main.k < 4 {
        true -> write_tail(main, &mut main.tail_bytes[main.k] as &mut [u8])
        _ -> done(main)
    }

    machine write_tail(main: &mut Main, tail: &mut [u8]) {
    main.tail_bytes[7] = 1;
    transition tail.len > 4 {
        true -> write_tail_bytes(main, tail)
        _ -> done(main)
    }
    }

    machine write_tail_bytes(main: &mut Main, tail: &mut [u8]) {
    tail[4] = 9;
    transition { _ -> done(main) }
    }

    machine done(main: &mut Main) {}
}

machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
