// Must reject: source.count stays eight; Counter.count views source.first.
pub data Counter { count: u64; pad: u64; }
pub data Source { first: u64; count: u64; }
pub boundary trait Parent {
    machine reset(counter: &mut Counter) ensures counter.count <= 7u64;
}
pub boundary trait Child: Parent {}
Good satisfies Child { Parent::reset = reset; }
machine reset(counter: &mut Counter)
ensures counter.count <= 7u64, counter.count <= 3u64
{ counter.count = 3u64; }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Child, Good>(defaults);
}
data Main { source: Source; values: [i32; 8]; }
machine Main::main(main: &mut Main) reaches Child + Parent crashes Trap {
    main.source.first = 12u64;
    main.source.count = 8u64;
    Parent::reset(&mut main.source as &mut Counter);
    let observed: i32 = main.values[main.source.count];
    transition observed == 0 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
