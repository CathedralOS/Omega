// The dominating guard `offset <= 16` is retired by the call before the
// recast forms, so at the recast NOTHING bounds the offset: the callee's
// write is not a postcondition the caller reads back. That is the
// unproven-offset reason, and it is the one pinned here. The direct-write
// sibling `incoming_offset_invalidated_before_capture` keeps the footprint
// reason instead, because its own assignment leaves an exact offset (32) the
// checker reads and can name. Until 2026-10-05 both reported the footprint
// reason "at offset 4294967295", which is `u32`'s carrier maximum rather than
// any offset either program contains.
machine invalidate(offset: &mut u32) { offset = 32; }
data Desc { kind: u32; pages: u64; }
machine capture(buffer: &[u8; 32], offset: &mut u32) -> u32 {
    transition offset <= 16 {
        true -> read(buffer, offset)
        _ -> 0
    }
    machine read(buffer: &[u8; 32], offset: &mut u32) -> u32 {
        invalidate(offset);
        let descriptor: &Desc = &buffer[offset] as &Desc;
        (descriptor.kind)
    }
}
