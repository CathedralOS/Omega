machine invalidate(offset: &mut u32) { offset = 32; }
data Desc { kind: u32; pages: u64; }
machine capture(buffer: &[u8; 32], offset: &mut u32) -> u32 {
    transition offset <= 16 {
        true -> read(buffer, offset)
        _ -> 0
    }
    state read(buffer: &[u8; 32], offset: &mut u32) -> u32 {
        invalidate(offset);
        let descriptor: &Desc = &buffer[offset] as &Desc;
        (descriptor.kind)
    }
}
