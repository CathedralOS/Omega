// FAIL CANARY: a shared record view may weaken its source's `where` bounds
// leaf by leaf but cannot strengthen them. `0.0..=1.0` does not establish
// `0.0..=0.5`, so reading through the view could observe a value its own
// declaration forbids.
use omega::language::core::float_operations;

data Reading
where
    value >= 0.0 && value <= 1.0,
{
    value: f32;
}

data TightReading
where
    value >= 0.0 && value <= 0.5,
{
    value: f32;
}

data Main {
    reading: Reading;
}

machine Main::main(main: &mut Main) {
    let view: &TightReading = &main.reading as &TightReading;
}
