// FAIL CANARY: §5b rule 1 -- a recast re-views the SAME bytes, so source
// and target shapes must agree on total size. `&i64 as &f32` (8 vs 4
// bytes) refuses at the rung-A scalar judgment (validation
// recasts.rs).
use omega_language_std::console;
data Main { x: i64; }
machine Main::main(main: &mut Main) {
    main.x = 3;
    let v: &f32 = &main.x as &f32;
    transition v > 2.9 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main)  { Console::exit_process(71); }
}
