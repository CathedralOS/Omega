use omega::language::std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    bytes: [u8; 7];
}

machine Main::main(main: &mut Main) {
    let words: &[u16] = &main.bytes as &[u16];
    transition words.len == 3 {
        true -> done(main)
        false -> done(main)
    }

    state done(main: &mut Main) { main.console.exit_process(0); }
}
