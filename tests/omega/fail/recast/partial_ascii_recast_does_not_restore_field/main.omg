// An ASCII prefix cannot restore a qualified field's corrupted trailing bytes.
domain [u8; 8]::Ascii requires ascii_only(self);
data Packet { bytes: [u8; 8] in Ascii; }

machine corrupt(packet: &mut Packet)
requires packet.bytes.len >= 8 {
    let all: &mut u64 = &mut packet.bytes[0] as &mut u64;
    all = 18446744073709551615;
    let prefix: &mut [u8; 4] = &mut packet.bytes[0] as &mut [u8; 4];
    prefix = "safe";
}
