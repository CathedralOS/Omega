// FAIL CANARY: negative twin of `pass/recast/returned_qualified_reference_exit`.
// A returned qualification view names the same `Ticket` storage as its
// input, but the qualification it presents must still be proved. `Other` is
// established only by `issue_other`, so a `Labelled` ticket cannot be
// returned as `&Ticket in Ticket::Other`.
data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
domain Ticket::Label;
domain Ticket::Other established by issue_other;
machine issue_other() -> Ticket in Ticket::Other { Ticket { number: 23 } }
domain Ticket::Labelled = Ticket::Issued & Ticket::Label;
machine issue() -> Ticket in Ticket::Labelled { Ticket { number: 17 } }
machine retain<'storage>(ticket: &'storage Ticket in Ticket::Labelled) -> &'storage Ticket in Ticket::Other {
    ticket as &Ticket in Ticket::Other
}
machine main() {
    let ticket: Ticket in Ticket::Labelled = issue();
    let view: &Ticket in Ticket::Other = retain(&ticket);
}
