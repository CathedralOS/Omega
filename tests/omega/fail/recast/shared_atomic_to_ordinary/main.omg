machine view(value: &AtomicU64) { let ordinary: &u64 = value as &u64; }
data Main { value: AtomicU64; }
machine Main::main(main: &mut Main) { view(&main.value); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
