data Word [copy] { value: u64; }
machine read(buffer: &[u8; 16], offset: u64 in Trapping, retry: u64) -> u64
requires addr::Bound == 18446744073709551616 && offset <= 8 && retry <= 1
{
    let word: &Word = &buffer[offset] as &Word;
    transition word.value > 0 {
        true -> finish(word.value, retry)
        _ -> finish(0, retry)
    }
    machine finish(value: u64, retry: u64) -> u64
    requires addr::Bound == 4294967296 && retry <= 1
    { value }
}
