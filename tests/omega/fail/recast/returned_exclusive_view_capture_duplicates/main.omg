// FAIL CANARY: exclusive twin of
// `pass/recast/returned_same_type_view_capture_exit`. A shared view held in a
// `mut` local may be recast into a second alias, because shared loans may
// duplicate. An exclusive view may not: recasting it again while the first
// recast alias is still live would give two writers to the same `Header`.
data Header { left: u64; right: u64; }

machine capture<'input>(first: &'input mut Header, second: &'input mut Header) -> &'input mut Header {
    let mut view: &mut Header = first as &mut Header;
    let child: &mut Header = view as &mut Header;
    let again: &mut Header = view as &mut Header;
    again.left = 5u64;
    view = second as &mut Header;
    child
}
