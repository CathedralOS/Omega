data Value { number: u64; }
data Alternate { number: u64; }

machine observe(marker: u64, value: &mut Value) -> u64 {
    transition { _ -> access(marker, value as &mut Alternate) }
    machine access(marker: u64, view: &mut Alternate) -> u64 {
        view.number = 29;
        view.number
    }
}

machine require_seventeen(value: u64)
requires value == 17
{}

machine main() crashes Trap {
    let mut value: Value = Value { number: 17 };
    transition value.number == 17 {
        true -> inspect(value)
        _ -> wrong()
    }
    machine inspect(mut value: Value)
    requires value.number == 17
    {
        let observed: u64 = observe(7, &mut value);
        require_seventeen(value.number);
        transition observed == 17 {
            true -> done()
            _ -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
