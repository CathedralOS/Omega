// A stored descriptor and named-state transfer do not extend local backing.
data Window<'storage> { bytes: &'storage [u8; 8]; }
machine escape() -> &u64 {
    let bytes: [u8; 8] = [37, 0, 0, 0, 0, 0, 0, 0];
    let window: Window = Window { bytes: &bytes };
    let view: &u64 = &window.bytes[0] as &u64;
    transition { _ -> decode(view) }
    machine decode(value: &u64) -> &u64 { value }
}
