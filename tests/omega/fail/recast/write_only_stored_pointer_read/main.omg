data Cell { value: i64; }
data Slot { value: &mut Cell; }
machine overwrite(slot: &write Slot) {
    let view: &write i64 = slot.value.value as &write i64;
    view = 73;
}
machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 0 };
    let mut slot: Slot = Slot { value: &mut cell };
    overwrite(&write slot);
}
