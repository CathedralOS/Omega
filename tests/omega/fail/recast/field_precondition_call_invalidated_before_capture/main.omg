data Desc { kind: u32; pages: u64; }
data Cursor { offset: u32; }
machine invalidate(cursor: &mut Cursor) { cursor.offset = 32; }
machine capture(buffer: &[u8; 32], cursor: &mut Cursor) -> u32
requires cursor.offset <= 16 {
    invalidate(cursor);
    let descriptor: &Desc = &buffer[cursor.offset] as &Desc;
    (descriptor.kind)
}
