// The `requires cursor.offset <= 16` arrival fact is retired by the call
// before the recast forms, so at the recast NOTHING bounds the offset: the
// callee's write is not a postcondition the caller reads back. That is the
// unproven-offset reason, and it is the one pinned here. The direct-write
// sibling `field_precondition_invalidated_before_capture` keeps the footprint
// reason instead, because its own assignment leaves an exact offset (32) the
// checker reads and can name. Until 2026-10-05 both reported the footprint
// reason "at offset 4294967295", which is `u32`'s carrier maximum rather than
// any offset either program contains.
data Desc { kind: u32; pages: u64; }
data Cursor { offset: u32; }
machine invalidate(cursor: &mut Cursor) { cursor.offset = 32; }
machine capture(buffer: &[u8; 32], cursor: &mut Cursor) -> u32
requires cursor.offset <= 16 {
    invalidate(cursor);
    let descriptor: &Desc = &buffer[cursor.offset] as &Desc;
    (descriptor.kind)
}
