data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
domain Ticket::Label;
domain Ticket::Labelled = Ticket::Issued & Ticket::Label;
machine issue() -> Ticket in Ticket::Labelled { Ticket { number: 17 } }
machine escape<'storage>(input: &'storage Ticket in Ticket::Labelled) -> &'storage Ticket in Ticket::Issued {
    let ticket: Ticket in Ticket::Labelled = issue();
    (&ticket) as &Ticket in Ticket::Issued
}
machine main() {
    let ticket: Ticket in Ticket::Labelled = issue();
    let escaped: &Ticket in Ticket::Issued = escape(&ticket);
    let observed: u64 = escaped.number;
}
