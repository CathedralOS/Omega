// Owner-measured diagnostic split (2026-07-11, M2 blocker 2's rider): a
// recognized interior recast whose runtime OFFSET has no bound used to
// fall through to the FORM errors ("not a scalar primitive or an
// all-scalar record" -- misleading: this Desc IS all-scalar). The
// judgment now answers three ways, and the unproven-offset case names
// the real failure and all three discharge routes (declared range,
// dominating incoming guard, boundary-ensures witness).
use omega_language_std::console;
data Desc { a: u32; b: u32; }
data Main { buf: [u8; 16]; }
machine Main::main(main: &mut Main, offset: u32) {
    transition { _ -> read(main, offset) }
    state read(main: &mut Main, off: u32) {
        let d: &Desc = &main.buf[off] as &Desc;
        transition { _ -> yes(main) }
    }
    state yes(main: &mut Main) { Console::exit_process(70); }
}
