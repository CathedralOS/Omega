// FAIL CANARY (rung-A fence): a recast re-views storage at an executable
// position -- a reference-typed let initializer, a guard operand, a call
// argument, a nested expression -- where the positional sweep in validation
// recasts.rs judges it in place. Proof-only fact positions (`requires`/
// `ensures`) produce no runtime borrow and stay fenced: this machine-level
// `requires` holds a recast outside every executable statement root.
data Main { bits: i32; }
machine Main::main(&mut self)
requires (&self.bits as &u32) == 0u32
{
    self.bits = 0;
}
