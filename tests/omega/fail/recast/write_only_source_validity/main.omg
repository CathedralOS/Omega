domain u32::Small(value) requires value <= 10;
data Original { value: u32 in Small; }
data Viewed { value: u32; }
machine overwrite(storage: &write Original) {
    let view: &write Viewed = storage as &write Viewed;
    view.value = 73;
}
machine main() crashes Trap {
    let mut original: Original = Original { value: 0 };
    overwrite(&write original);
}
