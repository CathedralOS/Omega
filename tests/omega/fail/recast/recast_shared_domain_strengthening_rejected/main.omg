// FAIL CANARY: Wide does not imply Narrow. A shared recast may forget an
// established domain fact, but it may not manufacture a stronger one merely
// because both domains use the same carrier and storage layout.
domain u32::Wide(value)
requires
    value <= 100;

domain u32::Narrow(value)
requires
    value in u32::Wide;
    value <= 10;

data Main {
    value: u32 in Wide;
}

machine Main::main(main: &mut Main) {
    let view: &u32 in Narrow = &main.value as &u32;
}
