// FAIL CANARY (rung B footprint): `&main.buf[9] as &u32` needs 4 bytes
// at offset 9 of a 12-byte region -- the view would read past the buffer;
// §5b rule 1 is byte-granular and refuses at the declaration.
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; buf: [u8; 12]; out: i32; }
machine Main::main(main: &mut Main) {
    // Little-endian u32 at bytes 4..8: 0x0400_0000 | 0x03_0000 | 0x0200 | 0x01 = 0x04030201.
    main.buf[4] = 1;
    main.buf[5] = 2;
    main.buf[6] = 3;
    main.buf[7] = 4;
    let v: &u32 = &main.buf[9] as &u32;
    transition v == 67305985 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main)  { main.console.exit_process(71); }
}
