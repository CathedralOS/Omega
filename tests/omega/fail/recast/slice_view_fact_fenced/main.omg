use omega::language::std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    bytes: [u8; 4];
}

machine Main::main(&mut self) {
    let flags: &[bool] = &self.bytes as &[bool];
    transition flags.len == 4 {
        true -> done()
        false -> done()
    }

    state done(&mut self) { self.console.exit_process(0); }
}
