// FAIL CANARY: a mutable view's equivalent `where` bounds hold only because
// every write through the view re-proves the view's own declaration. Storing
// 150 into a `0..=100` field and leaving it there at the loan's end must
// reject, or the source record would observe a value its bounds forbid.
data SignedRecord
where
    signed_value >= 0 && signed_value <= 100,
{
    signed_value: i16;
}

data UnsignedRecord
where
    unsigned_value >= 0 && unsigned_value <= 100,
{
    unsigned_value: u16;
}

data Main {
    source: SignedRecord;
}

machine Main::main(main: &mut Main) {
    let view: &mut UnsignedRecord = &mut main.source as &mut UnsignedRecord;
    view.unsigned_value = 150;
}
