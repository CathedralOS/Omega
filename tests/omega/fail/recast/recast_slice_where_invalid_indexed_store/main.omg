// A mutable aggregate slice keeps each element's declaration-owned predicate.
// Geometry and an admitted equivalent view cannot authorize a wider store.
data Narrow
where signed_value >= 0 && signed_value <= 100,
{
    signed_value: i16;
    enabled: bool;
}

data Exact
where unsigned_value <= 100,
{
    unsigned_value: u16;
    active: bool;
}

data Main {
    source: [Narrow; 2];
}

machine write_invalid(values: &mut [Exact], selected: u64)
requires selected < values.len,
{
    values[selected].unsigned_value = 101;
}

machine Main::main(main: &mut Main) {
    let view: &mut [Exact] = &mut main.source as &mut [Exact];
    transition view.len > 1 {
        true -> write_invalid(view, 1)
        _ -> done(main)
    }
    machine done(main: &mut Main) { }
}
