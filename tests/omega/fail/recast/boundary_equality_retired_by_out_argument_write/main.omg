// `size == cap && cap <= 8` would bound `size` through `cap`, but `refill`
// writes `main.cap` after `get_map` returns. That write retires both the
// equality and the bound on `cap`, so nothing bounds `size` at the recast.
// The pass sibling `pass/dependent/boundary_equality_recast_witness_compile`
// is the same program without the write.
pub boundary trait Firmware {
    machine get_map(size: &mut u32, cap: &mut u32)
    ensures size == cap && cap <= 8;
    machine refill(cap: &mut u32);
}

data Main {
    buf: [u8; 12];
    size: u32;
    cap: u32;
}

machine Main::main(main: &mut Main) reaches Firmware {
    Firmware::get_map(&mut main.size, &mut main.cap);
    Firmware::refill(&mut main.cap);
    transition { _ -> read(main.size, main.cap, main) }

    state read(size: u32, cap: u32, main: &mut Main) {
        let word: &u32 = &main.buf[size] as &u32;
    }
}
