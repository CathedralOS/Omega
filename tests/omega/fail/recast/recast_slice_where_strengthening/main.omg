// A shared aggregate slice must imply every target leaf predicate, not merely
// happen to contain a fitting zero in the current source.
data Narrow
requires signed_value >= 0 && signed_value <= 100,
{
    signed_value: i16;
    enabled: bool;
}

data TooNarrow
requires unsigned_value <= 50,
{
    unsigned_value: u16;
    active: bool;
}

data Main {
    source: [Narrow; 2];
}

machine Main::main(main: &mut Main) {
    let view: &[TooNarrow] = &main.source as &[TooNarrow];
}
