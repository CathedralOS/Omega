// FAIL CANARY: negative twin of
// `pass/recast/runtime_mutable_equivalent_range_recast_exit`. The `i32` and
// `u32` ranges hold the same bit patterns, so the mutable view is established,
// but a write through it must still leave the lender valid. 101 has the same
// bits in both carriers and lies outside `0..=100`, so the lender's
// `requires` facts stay unproved when the loan ends.
data SignedBounded
requires
    value >= 0 && value <= 100,
{
    value: i32;
}

data UnsignedBounded
requires
    value <= 100,
{
    value: u32;
}

data Main {
    value: SignedBounded;
}

machine Main::main(main: &mut Main) {
    let view: &mut UnsignedBounded = &mut main.value as &mut UnsignedBounded;
    view.value = 101;
}
