// Returning a view of local storage must fail its lifetime obligation.
// Leave the result unused so this tests the return itself, without first
// requiring a backing address for an invalid caller store.
data Original { value: u32; }
data Viewed { value: u32; }
machine escape() -> &write Viewed {
    let mut original: Original = Original { value: 0 };
    original as &write Viewed
}
machine main() crashes Trap {
    let view: &write Viewed = escape();
}
