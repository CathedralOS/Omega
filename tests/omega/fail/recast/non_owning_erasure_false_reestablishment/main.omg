data Storage { value: u32; }
domain Storage::Issued established by issue;
machine issue(value: u32) -> Storage in Issued { Storage { value: value } }
data Holder { slot: Storage in Issued; }
machine overwrite(storage: &write Storage in Issued) ensures storage in Issued {
    let view: &write Storage = storage as &write Storage;
    view = Storage { value: 73 };
}
machine main() {}
