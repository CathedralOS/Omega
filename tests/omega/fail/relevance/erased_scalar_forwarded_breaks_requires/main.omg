// The erased term a call supplies is checked, not ignored: `main` supplies 50
// for the erased `limit`, so `forward`'s `requires n < limit` is `70 < 50`.
// The pass twin `erased_scalar_forwarded_exit` supplies 100 and differs in
// nothing else.
machine keep(n: i32, bound [erased]: i32) -> i32
requires
    n < bound
{
    n
}

machine forward(n: i32, limit [erased]: i32) -> i32
requires
    n < limit
{
    keep(n, limit)
}

machine main() {
    let kept: i32 = forward(70, 50);
}
