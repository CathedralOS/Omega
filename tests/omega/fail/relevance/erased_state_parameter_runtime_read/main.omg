// Control for erased_parameter_named_transition_forward: forwarding `bound`
// into the erased state parameter is proof material, but the target state
// may not read it at runtime.
data Main {
    total: i32;
}

machine Main::main(&mut self) {
    self.record(3, 10);
}

machine Main::record(&mut self, n: i32, bound [erased]: i32)
requires
    n < bound
{
    transition { _ -> store(n, bound) }
    state store(&mut self, n: i32, bound [erased]: i32)
    requires
        n < bound
    {
        self.total = bound;
    }
}
