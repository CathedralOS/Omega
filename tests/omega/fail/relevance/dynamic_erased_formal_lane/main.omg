// A `&dyn` descriptor call carries subject arity only: a requirement whose
// signature declares an `[erased]` formal can never receive its proof-only
// actual through the descriptor lane, so the call is refused at check time
// by name rather than surfacing as an unadmitted dispatch plan.
trait Measure {
    machine measure(item: &Self, proof [erased]: i32) -> bool;
}

data Item [copy] {
    value: bool;
}

Primary: Item satisfies Measure {
    machine measure(item: &Item, proof [erased]: i32) -> bool {
        transition { _ -> item.value }
    }
}

data Main [copy] {
    item: Item;
}

machine Main::main(main: &Main) {
    let erased: &dyn Measure = &main.item as &dyn Item::Primary;
    let result: bool = erased.measure(3);
}
