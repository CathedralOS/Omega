// An `[erased]` parameter has no runtime value: reading it in the runtime
// body would charge storage and transfer for a proof-side binding. The
// requires clause may cite `bound`; the assignment below may not.
data Main {
}

machine Main::main(&mut self) {
    self.record(3, 10);
}

machine Main::record(&mut self, n: i32, bound [erased]: i32)
requires
    n < bound
{
    let mut total: i32 = bound;
}
