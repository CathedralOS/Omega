// A checked provider cannot hide a callback edge behind a local helper when
// the satisfied bodyless requirement omits that binding from `invokes`. The
// requirement admits the service reach, so only the hidden synchronous
// invocation edge is refused.

pub boundary trait Handler {
    machine handle();
}

pub boundary trait EventSource<Source> {
    machine fire(source: &mut Source)
    reaches
        Handler;
}

data EventProvider {
}

machine forward(event_provider: &mut EventProvider)
reaches
    Handler
{
    Handler::handle();
}

machine EventProvider::fire_checked(event_provider: &mut EventProvider)
satisfies EventSource<EventProvider>::fire
{
    forward(event_provider);
}
