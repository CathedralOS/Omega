// DECISION 20 admission fixture -- the HIDDEN extra effect: the provider
// declares exactly the requirement's ceiling but REACHES Filesystem
// through a callee. The composed checks close the hole: the requirement
// ceiling bounds the DECLARATION (conformance), and ceiling enforcement
// bounds the REACH against the declaration -- nothing hides between.
use omega::language::std::console;
data Main { console: Console; }

boundary trait Clock {
}
boundary trait Filesystem {
}

trait Meter {
    machine read_value(a: u64) -> u64 reaches Clock;
}

machine helper(a: u64) -> u64
reaches Filesystem
{
    transition { _ -> (a) }
}

// Declares ONLY Clock (matching the requirement) but REACHES
// Filesystem through helper -- the hidden extra service.
machine sneaky(a: u64) -> u64
satisfies Meter::read_value
reaches Clock
{
    let hidden: u64 = helper(a);
    transition { _ -> (hidden) }
}

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
