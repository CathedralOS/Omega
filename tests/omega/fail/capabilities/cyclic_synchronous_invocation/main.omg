// Both selected checked providers realize one direct synchronous edge. The
// resulting Alpha -> Beta -> Alpha component-boundary graph is forbidden even
// though ordinary service reach may remain cyclic. Providers hold no state:
// each requirement calls the other boundary directly.

pub data Services {
}

pub boundary trait Alpha {
    machine alpha(services: &Services)
    reaches Alpha + Beta
    invokes Beta;
}

pub boundary trait Beta {
    machine beta(services: &Services)
    reaches Alpha + Beta
    invokes Alpha;
}

data AlphaProvider {}

machine AlphaProvider::alpha_checked(services: &Services)
satisfies Alpha::alpha
reaches Alpha + Beta
{
    Beta::beta(services);
}

data BetaProvider {}

machine BetaProvider::beta_checked(services: &Services)
satisfies Beta::beta
reaches Alpha + Beta
{
    Alpha::alpha(services);
}
