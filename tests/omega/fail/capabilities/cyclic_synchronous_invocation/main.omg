use omega::language::core::binding;
// Both selected checked providers realize one direct synchronous edge. The
// resulting Alpha -> Binding<Beta> -> Binding<Alpha> component-boundary graph is forbidden even
// though ordinary service reach may remain cyclic. Providers hold no state:
// each requirement passes the caller's service bindings explicitly.

pub data Services {
    alpha: Binding<Alpha>;
    beta: Binding<Beta>;
}

pub boundary trait Alpha {
    machine alpha(services: &Services)
    invokes Beta;
}

pub boundary trait Beta {
    machine beta(services: &Services)
    invokes Alpha;
}

data AlphaProvider {}

machine AlphaProvider::alpha_checked(services: &Services)
satisfies Alpha::alpha
reaches Beta
{
    services.beta.beta(services);
}

data BetaProvider {}

machine BetaProvider::beta_checked(services: &Services)
satisfies Beta::beta
reaches Alpha
{
    services.alpha.alpha(services);
}
