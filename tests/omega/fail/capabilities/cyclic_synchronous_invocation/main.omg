use omega::language::core::binding;
// Both selected checked providers realize one direct synchronous edge. The
// resulting Alpha -> Binding<Beta> -> Binding<Alpha> component-boundary graph is forbidden even
// though ordinary service reach may remain cyclic.

pub boundary trait Alpha {
    machine alpha()
    invokes Beta;
}

pub boundary trait Beta {
    machine beta()
    invokes Alpha;
}

data AlphaProvider {
    beta: Binding<Beta>;
}

machine AlphaProvider::alpha_checked(alpha_provider: &mut AlphaProvider)
satisfies Alpha::alpha
{
    alpha_provider.beta.beta();
}

data BetaProvider {
    alpha: Binding<Alpha>;
}

machine BetaProvider::beta_checked(beta_provider: &mut BetaProvider)
satisfies Beta::beta
{
    beta_provider.alpha.alpha();
}
