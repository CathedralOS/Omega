// Declared service-reach rows are ceilings; a concrete
// machine "may not declare a new effect outside the trait requirement." The trait
// requires only `Console`, but the implementation declares `Filesystem` too,
// which is outside the trait ceiling and is rejected.

boundary trait Console {
    machine write_line(text: &[u8])
    reaches
        Console;
}

boundary trait Filesystem {
}

data MyConsole {
    id: i32;
}

machine MyConsole::write_line(text: &[u8]) satisfies Console::write_line
reaches
    Console
    Filesystem
{
}

data Main {
    console: MyConsole;
}

machine Main::main(&mut self) {
    self.console.write_line("x");
}
