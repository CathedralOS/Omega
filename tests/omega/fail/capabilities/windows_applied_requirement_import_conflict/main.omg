// One application has one slot, so it takes one locator. build.omg binds
// `Magnitude<i32>::of` to msvcrt `abs` and again to `labs`; the two rows name
// the same slot with different imports and must be refused as a conflict.
// pass/capabilities/windows_applied_requirement_import_exit binds `abs` and
// `labs` too, but at the two applications `<i32>` and `<i64>`, and is accepted.
use omega_language_std::Console;
public boundary trait Magnitude<Value> { machine of(value: i32) -> i32 reaches; }
data Main { m: i32; v: i32; }
machine Main::main(main: &mut Main) reaches Magnitude + Console {
    main.v = 0 - 42;
    main.m = Magnitude<i32>::of(main.v);
    transition main.m == 42 { true -> good(main) _ -> bad(main, 71) }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main, code: i32) { Console::exit_process(code); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Magnitude + Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
