// Tail-ward reclaim refuses a live resident: `release` merges the newest
// allocation back into the tail through `merge`, which demands `Vacant` on
// both parts, so `returned` cannot carry an issued extent still holding
// `Resident<SlotPlacement, Slot>` — an occupied region must be retired
// before it returns, exactly like `reset`
// (`tests/omega/fail/memory/bump_allocator_reset_with_live_resident`). The
// pass-side sibling (`tests/omega/pass/memory/bump_allocator_canary`,
// `exercise_release`) releases only vacant regions.
use omega::language::core::extent;
use omega::language::core::content;

data Split {
    taken: Extent in Granted & Vacant;
    rest: Extent in Granted & Vacant;
}

boundary trait ExtentPartition {
    machine split(whole: Extent in Granted & Vacant, length: u64) -> Split
    ensures
        Granted::content(old(&whole))
        == separate(
            Granted::content(&result.taken),
            Granted::content(&result.rest),
        );

    machine merge(parts: Split) -> Extent
    ensures
        result in Granted & Vacant,
        separate(
            Granted::content(old(&parts.taken)),
            Granted::content(old(&parts.rest)),
        )
        == Granted::content(&result);
}

data Bump {
    tail: Extent in Granted & Vacant;
    remaining: u64;
}

data Issued {
    strategy: Bump;
    allocation: Extent in Granted & Vacant;
}

data Slot [copy] {
    value: u32;
}

data SlotPlacement {}

data Occupied {
    storage: Extent in Granted & Resident<SlotPlacement, Slot>;
}

boundary trait ResidentStorage {
    machine place(storage: Extent in Granted & Vacant, value: Slot) -> Occupied
    ensures
        Granted::content(old(&storage)) == Granted::content(&result.storage);
}

machine allocate(partition: &ExtentPartition, strategy: Bump, length: u64) -> Issued
requires
    length <= strategy.remaining
reaches ExtentPartition
{
    let tail: Extent in Granted & Vacant = strategy.tail;
    let parts: Split = partition.split(tail, length);
    let taken: Extent in Granted & Vacant = parts.taken;
    let rest: Extent in Granted & Vacant = parts.rest;
    Issued {
        strategy: Bump {
            tail: rest,
            remaining: strategy.remaining - length,
        },
        allocation: taken,
    }
}

// Return the newest tail-adjacent allocation while older allocations stay
// live: `returned` must be `Vacant` for the fold into the tail.
machine release(
    partition: &ExtentPartition,
    strategy: Bump,
    returned: Extent in Granted & Vacant
) -> Bump
reaches ExtentPartition
{
    let tail: Extent in Granted & Vacant = strategy.tail;
    let grown: Extent in Granted & Vacant = partition.merge(Split {
        taken: returned,
        rest: tail,
    });
    let restored_residual: u64 = grown.length;
    Bump { tail: grown, remaining: restored_residual }
}

// Allocate, establish one resident, then attempt to release the still-occupied
// region: passing `placed.storage` as `returned` drops `Resident<...>` to
// satisfy the `Vacant` parameter and rejects at the call.
machine exercise(
    partition: &ExtentPartition,
    storage: &ResidentStorage,
    whole: Extent in Granted & Vacant,
    capacity: u64
) -> Extent
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition, ResidentStorage
{
    let issued_first: Issued = allocate(
        partition,
        Bump { tail: whole, remaining: capacity },
        16,
    );
    let issued_second: Issued = allocate(
        partition,
        issued_first.strategy,
        32,
    );
    let placed: Occupied = storage.place(issued_second.allocation, Slot { value: 7 });
    let grown: Bump = release(partition, issued_second.strategy, placed.storage);
    let first_allocation: Extent in Granted & Vacant = issued_first.allocation;
    let whole_again: Extent in Granted & Vacant = partition.merge(Split {
        taken: first_allocation,
        rest: grown.tail,
    });
    whole_again as Extent
}

data Main {}

machine Main::main(&mut self) {}
