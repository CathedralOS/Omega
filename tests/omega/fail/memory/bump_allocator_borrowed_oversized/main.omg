use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Granted;
use alloc::bump::Bump;
use alloc::bump::allocate;

// An accurate capacity count does not justify a request larger than the tail.
data Held { strategy: Bump; allocation: Extent in Granted & Vacant; }
machine invalid(whole: Extent in Granted & Vacant) -> Held
requires whole.length == 16
{
    let mut strategy: Bump = Bump::open(whole);
    let allocation: Extent in Granted & Vacant = allocate(&mut strategy, 32, 16);
    Held { strategy: strategy, allocation: allocation }
}
machine main() {}
