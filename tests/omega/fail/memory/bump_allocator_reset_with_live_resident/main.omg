use omega::language::core::Extent;
use omega::language::core::Resident;
use omega::language::core::Extent::Granted;
use alloc::bump::Bump;
use alloc::bump::reset;
data Policy {}
data Word { value: u64; }
// Matching geometry does not turn live resident contents into vacant storage.
machine invalid(strategy: Bump, live: Extent in Granted & Resident<Policy, Word>) -> Bump
requires live.base == strategy.base,
    embed(live.length) + embed(strategy.remaining) == embed(strategy.capacity)
{ reset(strategy, live) }
machine main() {}
