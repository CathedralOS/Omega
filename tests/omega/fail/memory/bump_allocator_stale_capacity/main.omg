use omega::language::core::extent;
use alloc::bump;

// The first allocation ends its strategy loan, but invalidates the old count.
data Held {
    strategy: Bump;
    first: Extent in Granted & Vacant;
    second: Extent in Granted & Vacant;
}
machine invalid(whole: Extent in Granted & Vacant) -> Held
requires whole.length == 48
{
    let mut strategy: Bump = Bump { tail: whole, remaining: 48 };
    let first: Extent in Granted & Vacant = allocate(&mut strategy, 16, 48);
    let second: Extent in Granted & Vacant = allocate(&mut strategy, 8, 48);
    Held { strategy: strategy, first: first, second: second }
}
machine main() {}
