use omega::language::core::extent;
use alloc::bump;

// Truncation keeps a prefix of the live buffer, so its bound is the buffer's
// own length — not the strategy's residual tail, which the cursor already
// issued past. Keeping more than the buffer holds has no capacity premise.
machine invalid(buffer: Extent in Granted & Vacant) -> VacantExtentParts
requires buffer.length == 16
{ split_vacant_extent(buffer, 17) }

machine main() {}
