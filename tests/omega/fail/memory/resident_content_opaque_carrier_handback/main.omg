// Must reject: a wrapper cannot hide an opaque writer behind a named carrier.
use omega::language::core::extent;
data Policy {}
data Word { value: u64; }
data LoanHolder {
    storage: &mut Extent in Granted & Resident<Policy, Word>;
}
boundary trait OpaqueWrite {
    machine overwrite(holder: LoanHolder) reaches;
}
machine forward(holder: LoanHolder)
reaches OpaqueWrite
invokes OpaqueWrite;
{
    OpaqueWrite::overwrite(holder);
}
machine exercise(mut storage: Extent in Granted & Resident<Policy, Word>)
    -> Extent in Granted & Resident<Policy, Word>
reaches OpaqueWrite
{
    forward(LoanHolder { storage: &mut storage });
    storage
}
