// A released extent is retired content, not tail: the monotonic cursor does
// not move, so the strategy's residual is the live issued total and cannot
// authorize a request the released bytes would have to satisfy. Offering the
// rewound residual as the allocation's capacity premise — the pre-monotonic
// reading — must be refused before `reset` recomposes the backing.
use omega::language::core::extent;
use omega::language::core::content;
use alloc::bump;

// Every claim the refused attempt would have left behind, so the rejection
// under test is the only failure reported.
data Held {
    released: Released;
    first: Extent in Granted & Vacant;
    third: Extent in Granted & Vacant;
}

machine invalid(whole: Extent in Granted & Vacant, capacity: u64) -> Held
requires
    48 <= capacity;
    capacity == whole.length
reaches ExtentPartition
{
    let mut strategy: Bump = Bump { tail: whole, remaining: capacity };
    let first: Extent in Granted & Vacant = allocate(&mut strategy, 16, capacity);
    check_remaining(strategy.remaining, capacity, 16);
    let available: u64 = strategy.remaining;
    let second: Extent in Granted & Vacant = allocate(&mut strategy, 32, available);
    let released: Released = release(strategy, second);
    // The retired thirty-two bytes are unavailable: `available` is the residual
    // the rewind would restore, not the residual the strategy carries.
    let third: Extent in Granted & Vacant = allocate(&mut released.strategy, 24, available);
    Held { released: released, first: first, third: third }
}

machine main() {}