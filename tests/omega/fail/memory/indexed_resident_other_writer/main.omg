// A computed argument's checked handback cannot excuse another formal's write.
data First {}
data Slot { value: u64; }
domain<P> Slot::Resident<P> established by initialize;
data Storage<P> { resident: Slot in Resident<P>; }
machine initialize<P>(value: u64) -> Slot in Resident<P> { Slot { value: value } }
machine replace_and_corrupt(valid: &mut Storage<First>, raw: &mut u64) {
    valid.resident = initialize<First>(43);
    raw = 99;
}
machine choose<'a>(left: &'a mut Storage<First>, right: &'a mut Storage<First>, first: bool) -> &'a mut Storage<First> {
    transition first { true -> left _ -> right }
}
machine read(slot: &Slot in Resident<First>) -> u64 { slot.value }
machine exercise(first: bool) -> u64 {
    let mut left: Storage<First> = Storage { resident: initialize<First>(17) };
    let mut right: Storage<First> = Storage { resident: initialize<First>(29) };
    let mut third: Storage<First> = Storage { resident: initialize<First>(31) };
    replace_and_corrupt(choose(&mut left, &mut right, first), &mut third.resident.value);
    read(&third.resident)
}
machine main() {}
