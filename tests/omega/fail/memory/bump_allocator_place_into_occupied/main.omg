// An occupied slot cannot be placed again: `ResidentStorage::place` requires
// `Vacant` storage, and an established allocation carries
// `Resident<SlotPlacement, Slot>` instead, so the second establishment has
// no `Vacant` premise. The pass-side sibling
// (`tests/omega/pass/memory/bump_allocator_canary`, `exercise_resident`)
// retires before the storage can be reused.
use omega::language::core::extent;
use omega::language::core::content;

public data Split {
    taken: Extent in Granted & Vacant;
    rest: Extent in Granted & Vacant;
}

public boundary trait ExtentPartition {
    machine split(whole: Extent in Granted & Vacant, length: u64) -> Split
    reaches
    ensures
        Granted::content(old(&whole))
        == separate(
            Granted::content(&result.taken),
            Granted::content(&result.rest),
        ),
        Vacant::content(old(&whole))
        == separate(Vacant::content(&result.taken), Vacant::content(&result.rest));

    machine merge(parts: Split) -> Extent
    reaches
    ensures
        result in Granted & Vacant,
        separate(
            Granted::content(old(&parts.taken)),
            Granted::content(old(&parts.rest)),
        )
        == Granted::content(&result),
        separate(Vacant::content(old(&parts.taken)), Vacant::content(old(&parts.rest)))
        == Vacant::content(&result);
}

public data Slot [copy] {
    value: u32;
}

public data SlotPlacement {}

public data Occupied {
    storage: Extent in Granted & Resident<SlotPlacement, Slot>;
}

public data Retired {
    storage: Extent in Granted & Vacant;
    value: Slot;
}

public boundary trait ResidentStorage {
    machine place(storage: Extent in Granted & Vacant, value: Slot) -> Occupied
    reaches
    ensures
        Granted::content(old(&storage)) == Granted::content(&result.storage);

    machine read(placed: &Occupied) -> Slot reaches;

    machine retire(placed: Occupied) -> Retired
    reaches
    ensures
        Granted::content(old(&placed.storage)) == Granted::content(&result.storage);
}

machine exercise(whole: Extent in Granted & Vacant) -> Extent
reaches ExtentPartition, ResidentStorage
{
    let parts: Split = ExtentPartition::split(whole, 16);
    let vacant: Extent in Granted & Vacant = parts.taken;
    let tail: Extent in Granted & Vacant = parts.rest;
    let placed: Occupied = ResidentStorage::place(vacant, Slot { value: 7 });
    let again: Occupied = ResidentStorage::place(placed.storage, Slot { value: 9 });
    let retired: Retired = ResidentStorage::retire(again);
    let released: Extent in Granted & Vacant = retired.storage;
    let recomposed: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: released,
        rest: tail,
    });
    recomposed as Extent
}

machine main() {}
