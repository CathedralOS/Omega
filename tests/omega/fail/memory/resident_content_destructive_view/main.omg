// A destructive resident accessor cannot silently preserve a complete Resident.
use omega::language::core::Extent;
use omega::language::core::Extent::Resident;
use omega::language::core::Extent::Granted;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::ExternalRead;
use omega::language::core::FieldAccess;
use omega::language::core::BoundaryReach;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::inaccessible;
use omega::language::core::AccessPlan::with;
use omega::language::core::AccessPlan::with_reach;
use omega::language::core::Access;
use omega::language::core::Access::view_resident_mut;

public data Word { value: u64; }
public data DestructivePlacement {}

machine DestructivePlacement::plan(schema: Schema) -> AccessPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        representation: FieldPlan::At { offset: 0 },
    };
    let layout: LayoutPlan = LayoutPlan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(layout), schema.fields[0].key,
        FieldAccess::External {
            read: ExternalRead::Take, write: true, exposure: Exposure::Exported
        }
    );
    let services: [u64; 32];
    AccessPlan::with_reach(
        access,
        BoundaryReach { services: services, service_count: 0 }
    )
}

machine cannot_borrow(
    storage: &mut Extent in Granted & Resident<DestructivePlacement, Word>
) {
    let view: &mut Access<DestructivePlacement, Word> =
        Access::view_resident_mut<DestructivePlacement, Word>(storage);
}
