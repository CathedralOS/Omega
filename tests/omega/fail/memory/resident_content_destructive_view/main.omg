// A destructive resident accessor cannot silently preserve a complete Resident.
use omega::language::core::extent;
use omega::language::core::layout;

public data Word { value: u64; }
public data DestructivePlacement {}

machine DestructivePlacement::plan(schema: Schema) -> PlacementPlan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 0 },
    };
    let access: AccessPlan = AccessPlan::with(
        AccessPlan::inaccessible(&schema), schema.fields[0].key,
        FieldAccess::External {
            read: ExternalRead::Take, write: true, exposure: Exposure::Exported
        }
    );
    let services: [u64; 32];
    PlacementPlan {
        layout: Plan { entries: entries, entry_count: 1, size_fixed: 8,
                       size_is_dynamic: false, align: 8 },
        access: access,
        reach: BoundaryReach { services: services, service_count: 0 },
    }
}

machine cannot_borrow(
    storage: &mut Extent in Granted & Resident<DestructivePlacement, Word>
) {
    let view: &mut Placed<DestructivePlacement, Word> =
        Placed::view_resident_mut<DestructivePlacement, Word>(storage);
}
