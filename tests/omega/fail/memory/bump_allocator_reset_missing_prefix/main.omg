use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Granted;
use alloc::bump;
// A matching base does not discharge an outstanding allocation's capacity.
machine invalid(strategy: Bump, retired: Extent in Granted & Vacant) -> Bump
requires retired.base == strategy.base,
    strategy.capacity == 32, strategy.remaining == 8, retired.length == 16
{ reset(strategy, retired) }
machine main() {}
