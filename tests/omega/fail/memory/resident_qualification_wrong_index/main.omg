// A checked nested qualification cannot replace the exact resident placement
// instance with another instance at the next completed operand occurrence.
use omega::language::core::extent;
data Native {}
data Network {}
data Payload [copy] { value: u64; }
machine mismatch(storage: Extent in Granted & Resident<Native, Payload>) -> Extent {
    let forged: Extent in Resident<Network, Payload> =
        (storage as Extent in Resident<Native, Payload>)
        as Extent in Resident<Network, Payload>;
    forged as Extent
}
machine main() {}
