use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Granted;
use alloc::bump::Bump;
// A counter cannot enlarge the concrete tail.
machine invalid(whole: Extent in Granted & Vacant) -> Bump
requires whole.length == 16
{
    let base: addr = whole.base;
    Bump { tail: whole, remaining: 32, base: base, capacity: 16 }
}
machine main() {}
