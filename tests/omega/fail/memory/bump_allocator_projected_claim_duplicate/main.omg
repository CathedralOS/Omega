use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::merge_vacant_extents;
use omega::language::core::Extent::Granted;
data Pair {
    left: Extent in Granted & Vacant;
    right: Extent in Granted & Vacant;
}
// Even empty geometry does not duplicate a projected linear carrier.
machine invalid(parts: Pair) -> Pair
requires parts.left.length == 0
{
    let merged: Extent in Granted & Vacant = merge_vacant_extents(parts.left, parts.left);
    Pair { left: merged, right: parts.right }
}
machine main() {}
