// Satisfying a boundary requirement does not grant its admitted authority to a
// checked body. The body still owes absence of live content on its exact input.
use omega::language::core::extent;
use omega::language::core::content;
use omega::language::core::nat;
machine pretend(storage: Extent in Granted) -> Extent
satisfies VacantContentTransfer::transfer
ensures
    result in Granted & Vacant,
    core::Identity<IntervalSet<Nat>>(Granted::content(old(&storage)), Granted::content(&result))
{
    storage as Extent
}
machine direct(storage: Extent in Granted) -> Extent
ensures result in Granted & Vacant {
    pretend(storage)
}
machine main() {}
