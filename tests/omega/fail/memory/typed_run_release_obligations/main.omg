use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Granted;
use omega::language::core::Run;
use omega::language::core::Run::release_empty;

// Zero occupied bytes cannot discharge a run whose element count is unknown:
// a zero-footprint linear value still owes its disposition.
machine missing_count<P, T>(run: Run<P, T> in Live<P, T>) -> Extent in Granted & Vacant
requires run.storage.length == 0
{
    Run::release_empty<P, T>(run)
}

machine main() {}
