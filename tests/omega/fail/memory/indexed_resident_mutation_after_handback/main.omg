// A restored qualification is live evidence, not a permanent field annotation.
data First {}
data Slot { value: u64; }
domain<P> Slot::Resident<P> established by initialize;
data Storage<P> { resident: Slot in Resident<P>; }
machine initialize<P>(value: u64) -> Slot in Resident<P> { Slot { value: value } }
machine replace<P>(storage: &mut Storage<P>, replacement: Slot in Resident<P>) -> Slot in Resident<P> {
    let previous: Slot in Resident<P> = storage.resident;
    storage.resident = replacement;
    previous
}
machine read(slot: &Slot in Resident<First>) -> u64 { slot.value }
machine exercise() -> u64 {
    let mut storage: Storage<First> = Storage { resident: initialize<First>(17) };
    let previous: Slot in Resident<First> = replace<First>(&mut storage, initialize<First>(29));
    storage.resident.value = 99;
    read(&storage.resident)
}
machine main() {}
