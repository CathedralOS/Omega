use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::package(builder, "native_bindings_native_allocation_unissued_release_rejected");

 Build::bind<NativeHeap::allocate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "malloc", version: "GLIBC_2.2.5",
    } });
 Build::bind<NativeHeap::release>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "free", version: "GLIBC_2.2.5",
    } });
}
