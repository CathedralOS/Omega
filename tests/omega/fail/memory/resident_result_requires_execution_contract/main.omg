// Must reject: an ordinary opaque machine cannot borrow the compiler
// primitive's normal-completion contract by copying its result signature.
use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Resident;
use omega::language::core::Extent::Granted;
use omega::language::core::ResourceProfile;
use omega::language::core::AccessOutcome;
use omega::language::core::AccessReturn;
use omega::language::core::AccessInitializationFailure;

public data Policy {}
public data Word { value: u64; }

boundary machine initialize_from_profile(
    storage: Extent in Granted & Vacant,
    value: Word,
    profile: ResourceProfile
) -> AccessOutcome<
    Extent in Granted & Resident<Policy, Word>,
    AccessReturn<Extent in Granted & Vacant, Word>,
    AccessInitializationFailure
>;

machine exercise(
    storage: Extent in Granted & Vacant,
    value: Word,
    profile: ResourceProfile
) -> AccessOutcome<
    Extent in Granted & Resident<Policy, Word>,
    AccessReturn<Extent in Granted & Vacant, Word>,
    AccessInitializationFailure
> {
    initialize_from_profile(storage, value, profile)
}
