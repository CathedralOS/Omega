// The guarded element increment's soundness twin: a `< 17` guard admits 16,
// and `bump`'s `v < 16` requires rejects the edge (16 + 1 = 17 used to exceed
// the revoked element range [0..=16]; the bound now lives on the admission
// contract).
use omega::language::std::console;
use omega::language::core::service;
data Main {
    console: Binding<Console>;
    tallies: [i32; 4];
}
machine Main::main(&mut self) reaches Console {
    transition self.tallies[1] < 17 {
        true -> bump(self.tallies[1])
        false -> full()
    }
    state bump(&mut self, t: i32) requires t < 16 {
        self.tallies[1] = t + 1;
        transition self.tallies[1] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
