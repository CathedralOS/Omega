// Writing 100 invalidates the earlier 0..=9 guard before the copy to Main.y.
// The fresh value cannot satisfy store's arrival requirement or the field bound.
use omega_language_std::Console;

data Main requires y >= 0 && y <= 9 {
    yv: i32;
    y: i32;
}

machine Main::main(main: &mut Main, yv_in: i32) reaches Console {
    main.yv = yv_in;
    transition main.yv >= 0 && main.yv <= 9 {
        true -> stale(main)
        false -> bad(main)
    }

    machine stale(main: &mut Main) {
        main.yv = 100;
        let w: i32 = main.yv;
        transition { _ -> store(main, w) }
    }
    machine store(main: &mut Main, v: i32) requires v >= 0 && v <= 9 {
        main.y = v;
        transition main.y == 7 { true -> m(main) false -> m(main) }
    }
    machine m(main: &mut Main) { Console::exit_process(1); }
    machine bad(main: &mut Main) { Console::exit_process(8); }
}
