// The guarded-copy STABILITY twin: the edge guard establishes [0..=9] for
// `main.yv`, but a write to `main.yv` before the bounded call invalidates the
// fact -- at `stale`'s call edge the re-read `w` is the fresh 100, so
// `store`'s `v <= 9` requires must reject (without staleness,
// `yv = 100; store(yv)` would "prove" through the stale guard). `yv` is a
// runtime parameter so the guard's interval is what the guard edge sees.
use omega_language_std::console;

data Main {
    yv: i32;
}

machine Main::main(main: &mut Main, yv_in: i32) reaches Console {
    main.yv = yv_in;
    transition main.yv >= 0 && main.yv <= 9 {
        true -> stale(main)
        false -> bad(main)
    }

    state stale(main: &mut Main) {
        main.yv = 100;
        let w: i32 = main.yv;
        transition { _ -> store(main, w) }
    }
    state store(main: &mut Main, v: i32) requires v >= 0 && v <= 9 {
        let mut y: i32 = v;
        transition y == 7 { true -> m(main) false -> m(main) }
    }
    state m(main: &mut Main) { Console::exit_process(1); }
    state bad(main: &mut Main) { Console::exit_process(8); }
}
