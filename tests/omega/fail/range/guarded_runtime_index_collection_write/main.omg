// The runtime-index guarded increment's COLLECTION-stability twin: a write
// into the collection (`tallies[0] = 5`) between the guard and the bounded
// call may alias the guarded element (index-blind), so the re-read `u` has no
// bound and `bump`'s `v < 16` requires must reject at `interpose`'s edge.
// (Was: the increment's bounded-assignment obligation on the revoked
// `[i32 [0..=16]; 4]` element suffix; the bound now lives on the admission
// contract.)
use omega::language::std::console;
use omega::language::core::service;
data Main {
    console: Binding<Console>;
    tallies: [i32; 4];
    k: u64;
}
machine Main::main(&mut self) reaches Console {
    self.k = 2;
    let t: i32 = self.tallies[self.k];
    transition t < 16 {
        true -> interpose(self.k)
        false -> full()
    }
    state interpose(&mut self, ki: u64) requires ki < 4 {
        self.tallies[0] = 5;
        let u: i32 = self.tallies[ki];
        transition { _ -> bump(u, ki) }
    }
    state bump(&mut self, v: i32, ki: u64) requires v < 16, ki < 4 {
        self.tallies[ki] = v + 1;
        transition self.tallies[2] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
