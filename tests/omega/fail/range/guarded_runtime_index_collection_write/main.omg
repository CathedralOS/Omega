// Storing16 is within the owner's element domain. Incrementing the same
// selected cell to17 cannot restore that domain at handback. No stronger
// admission precondition masks the owner obligation.
data Main
requires self.tallies[0] >= 0 && self.tallies[0] <= 16,
    self.tallies[1] >= 0 && self.tallies[1] <= 16,
    self.tallies[2] >= 0 && self.tallies[2] <= 16,
    self.tallies[3] >= 0 && self.tallies[3] <= 16,
    self.k <= 3
{
    tallies: [i32; 4];
    k: u64;
}

machine Main::main(main: &mut Main) {
    main.k = 2;
    interpose(main, main.k);
}

machine interpose(main: &mut Main, ki: u64)
requires ki < 4
{
    main.tallies[ki] = 16;
    let observed: i32 = main.tallies[ki];
    main.tallies[ki] = observed + 1;
}
