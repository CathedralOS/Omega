// The runtime-index guarded increment's COLLECTION-stability twin: a write
// into the collection (`tallies[0] = 5`) between the guard and the bounded
// call may alias the guarded element (index-blind), so the re-read `u` has no
// bound and `bump`'s `v < 16` requires must reject at `interpose`'s edge.
// (Was: the increment's bounded-assignment obligation on the revoked
// `[i32 [0..=16]; 4]` element suffix; the bound now lives on the admission
// contract.)
use omega_language_std::console;
data Main {
    tallies: [i32; 4];
    k: u64;
}
machine Main::main(main: &mut Main) reaches Console {
    main.k = 2;
    let t: i32 = main.tallies[main.k];
    transition t < 16 {
        true -> interpose(main, main.k)
        false -> full(main)
    }
    state interpose(main: &mut Main, ki: u64) requires ki < 4 {
        main.tallies[0] = 5;
        let u: i32 = main.tallies[ki];
        transition { _ -> bump(main, u, ki) }
    }
    state bump(main: &mut Main, v: i32, ki: u64) requires v < 16, ki < 4 {
        main.tallies[ki] = v + 1;
        transition main.tallies[2] == 1 {
            true -> matched(main)
            false -> unmatched(main)
        }
    }
    state matched(main: &mut Main) { Console::exit_process(1); }
    state unmatched(main: &mut Main) { Console::exit_process(9); }
    state full(main: &mut Main) { Console::exit_process(8); }
}
