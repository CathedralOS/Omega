// The funnel agreement's soundness twin: one of the two edges into `push` is
// UNGUARDED (`_ ->`), so `other`'s call cannot discharge the `v < 16`
// requires -- the bound holds on only one incoming edge. `sp` is a runtime
// parameter so both edges are live. (Was: `y: i32 [0..=15]` field suffix.)
use omega_language_std::console;

data Main {
    sp: i32;
}

machine Main::main(main: &mut Main, sp_in: i32) reaches Console {
    main.sp = sp_in;
    transition main.sp >= 0 && main.sp < 16 {
        true -> push(main)
        false -> other(main)
    }

    state other(main: &mut Main) {
        transition { _ -> push(main) }
    }

    state push(main: &mut Main) requires main.sp >= 0 && main.sp < 16 {
        let mut y: i32 = main.sp;
        transition y == 7 { true -> m(main) false -> m(main) }
    }
    state m(main: &mut Main) { Console::exit_process(1); }
}
