// The unguarded entry to push cannot justify copying sp into bounded Main.y.
// Runtime input keeps both entries live; only the guarded entry proves 0..=15.
use omega_language_std::Console;

data Main requires y >= 0 && y <= 15 {
    sp: i32;
    y: i32;
}

machine Main::main(main: &mut Main, sp_in: i32) reaches Console {
    main.sp = sp_in;
    transition main.sp >= 0 && main.sp < 16 {
        true -> push(main)
        false -> other(main)
    }

    machine other(main: &mut Main) {
        transition { _ -> push(main) }
    }

    machine push(main: &mut Main) requires main.sp >= 0 && main.sp < 16 {
        main.y = main.sp;
        transition main.y == 7 { true -> m(main) false -> m(main) }
    }
    machine m(main: &mut Main) { Console::exit_process(1); }
}
