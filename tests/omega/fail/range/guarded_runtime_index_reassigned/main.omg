// The runtime-index guarded increment's INDEX-stability twin: `self.k` is
// reassigned between the guard and the bounded call, so the guard's fact
// about `tallies[k-at-entry]` must not apply to `tallies[k-now]` -- `bump`'s
// `v < 16` requires must reject at `interpose`'s edge.
use omega::language::std::console;
use omega::language::core::service;
data Main {
    console: Binding<Console>;
    tallies: [i32; 4];
    k: u64;
}
machine Main::main(&mut self) reaches Console {
    self.k = 2;
    let t: i32 = self.tallies[self.k];
    transition t < 16 {
        true -> interpose()
        false -> full()
    }
    state interpose(&mut self) {
        self.k = 3;
        let u: i32 = self.tallies[self.k];
        transition { _ -> bump(u, self.k) }
    }
    state bump(&mut self, v: i32, ki: u64) requires v < 16, ki < 4 {
        self.tallies[ki] = v + 1;
        transition self.tallies[2] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
