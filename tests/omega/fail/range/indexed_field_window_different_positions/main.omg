data Cell where left == right { left: i32; right: i32; }
data Grid { cells: [Cell; 2]; selected: u64; }

// The wildcard valuation cannot pretend both stores selected the same cell.
machine Grid::main(grid: &mut Grid) {
    grid.cells[grid.selected].left = 1;
    grid.selected = 1;
    grid.cells[grid.selected].right = 1;
}
