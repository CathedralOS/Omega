use omega_language_std::wire;
use omega::language::core::reflect;
// N1 wire face: wire schemas serialize runtime bytes; a proof-only
// mention has no encoding.
use omega_language_std::console;
data Nat { case Zero; case Succ(prev: Nat); }
data Msg {
    #0 n: Nat;
}
data Main { }
machine Main::main(main: &mut Main) {
    let mut fields: [ScalarSlot; 1];
    let mut context: ScalarPlanContext = ScalarPlanContext { slots: &mut fields[..], count: 0u64, valid: true };
    reflect::inspect_record_fields<Msg, CompactBinary::plan_scalar>(&mut context);
    Console::exit_process(0);
}

machine entry_start() reaches Console { let mut storage: Main; Main::main(&mut storage); }
