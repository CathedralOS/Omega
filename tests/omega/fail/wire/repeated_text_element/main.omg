// Wire REPEATED fields: only stage 2 scalar elements (i32/i64/u32/u64/bool)
// have an honest packed encoding today. Repeated borrowed text makes every
// element runtime-sized -- the compile-time worst case the out-buffer
// guarantee rests on would not exist, so the encode
// call loudly instead of half-supporting it.

use omega::language::std::console;

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data NameList {
    #0 names: [[u8; 8] in Utf8; 4];
}

data NameListValue {
    names: [[u8; 8] in Utf8; 4];
}

data Main {
    console: Console;
    buffer: [u8; 64];
    written: u64;
}

machine Main::main(&mut self) {
    let msg: NameListValue = NameListValue {
        names: ["a", "b", "c", "d"]
    };

    NameList::encode(&msg, &mut self.buffer, &mut self.written);

    self.console.exit_process(70);
}
