machine build(builder: &mut Build) {
    builder.application("wire_compatibility_migration_retired_identity_reuse");
    builder.depend(Source::Path { location: "../../../../../source/library/std" });
    builder.require_wire_compatibility<
        ArchiveStore,
        CounterLineage,
        CounterV3,
        CounterV1,
        CompleteMigration
    >();
}
