machine build(builder: &mut Build) {
    Build::application(builder, "wire_compatibility_migration_retired_identity_reuse");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    builder.require_wire_compatibility<
        ArchiveStore,
        CounterLineage,
        CounterV3,
        CounterV1,
        CompleteMigration
    >();
}
