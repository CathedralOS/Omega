machine build(builder: &mut Build) {
    Build::application(builder, "wire_compatibility_migration_retired_identity_reuse");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::require_wire_compatibility<
        ArchiveStore,
        CounterLineage,
        CounterV3,
        CounterV1,
        CompleteMigration
    >(builder);
}
