module second;

use omega_language_std::format_lineage;

pub data Lineage {
}

pub data CounterV1 {
    #1 counter: i32;
}

pub data Counter {
    #1 counter: i32;
    #2 timestamp: i32;
}

pub machine Counter::from_v1(
    old: CounterV1,
    out: &mut Counter
) satisfies FormatMigration<Lineage, CounterV1, Counter>::migrate {
    out.counter = old.counter;
    out.timestamp = 0;
}
