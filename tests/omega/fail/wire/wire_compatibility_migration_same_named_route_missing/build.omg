machine build(builder: &mut Build) {
    builder.application("wire_compatibility_migration_same_named_route_missing");
    builder.depend(Source::Path { location: "../../../../../source/library/std" });
    builder.require_wire_compatibility<
        ArchiveStore,
        first::Lineage,
        first::Counter,
        first::CounterV1,
        CompleteMigration
    >();
}
