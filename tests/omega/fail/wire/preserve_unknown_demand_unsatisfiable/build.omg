machine build(builder: &mut Build) {
    builder.application("preserve_unknown_demand_unsatisfiable");
    builder.require_wire_compatibility<
        RelayChannel,
        MessageLineage,
        LocalMessage,
        PeerMessage,
        Readable,
        Writable,
        PreserveUnknown,
        Canonical,
        CompleteMigration
    >();
}
