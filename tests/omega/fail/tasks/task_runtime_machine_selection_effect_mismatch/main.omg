use omega::language::core::task;

// MP6/TR3: TaskRuntime's machine-parameter contract admits suspension and blocking,
// not arbitrary service reach. A selected target must refine that authored
// contract at specialization; whole-program inference cannot widen it.
boundary trait DiskIo {
}
pub boundary data Disk;
boundary machine Disk::touch(value: i32) reaches DiskIo;

data Job {
    value: i32;
}

data Worker { }
machine Worker::run(job: Job) -> i32 reaches DiskIo {
    let value: i32 = job.value;
    Disk::touch(value);
    value
}

machine Task::settle<T>(task: Task<T>) -> TaskOutcome<T> {
    suspend block Task::finish(task)
}

data Main {
}

machine Main::probe(main: &mut Main) reaches TaskRuntime {
    let job: Job = Job { value: 7 };
    let task: Task<i32> = TaskRuntime::start<i32, Job, Worker::run>(job);
    _ = suspend block Task::settle(task);
}

machine Main::main(main: &mut Main) { }
