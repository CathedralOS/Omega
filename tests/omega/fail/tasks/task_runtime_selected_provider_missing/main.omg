use omega::language::core::task;
use omega::language::core::binding;

// A TaskRuntime value is not enough to manufacture runtime authority. A
// concrete activation must bind to a retained selected provider plan.
data Job {
    value: i32;
}

data Worker { }
machine Worker::run(job: Job) -> i32 {
    job.value
}

machine Task::settle<T>(task: Task<T>) -> TaskOutcome<T> {
    suspend block Task::finish(task)
}

data Main {
    runtime: &Binding<TaskRuntime>;
}

machine Main::probe(main: &mut Main) reaches TaskRuntime {
    let job: Job = Job { value: 7 };
    let task: Task<i32> = main.runtime.start<i32, Job, Worker::run>(job);
    _ = suspend block Task::settle(task);
}

machine Main::main() { }
