// Counts and addresses have separate carriers; indexing accepts any integer
// with the required bound (wiki/spec/language/counts_and_addresses.md).
// `usize` does not resolve as a builtin type.
use omega_language_std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; n: usize; }
machine Main::main(main: &mut Main) { main.console.exit_process(70); }
