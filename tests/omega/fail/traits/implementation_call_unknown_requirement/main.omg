// FAIL CANARY. A call through a named implementation selects that
// implementation's row for the named requirement. `decrement` is no
// requirement of `Incrementable`, so the call names no row.
trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter { value: i32 in Wrapping; }

NormalIncrement satisfies Incrementable<Counter> {
    machine increment(counter: &mut Counter) {
        counter.value = counter.value + 1;
    }
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) {
    NormalIncrement::decrement(&mut main.counter);
}
