// FAIL CANARY.
// A law row is checked against the operations the same implementation selects.
// `WireCodec` selects `encode_zero` for `encode`, but its law row selects a
// lemma proved about `encode_message`. That lemma says nothing about
// `encode_zero`, so the law `encode(value) > 0` is not established and the
// row rejects. The run twin `run/traits/selection_row_law_selected_operation`
// selects `encode_message`.
data Message { value: u64; }
trait LawCodec<T> {
    machine encode(value: &T) -> u64 terminates;
    machine positive(value: &T)
    ensures encode(value) > 0;
}
machine encode_message(value: &Message) -> u64 terminates
ensures result == 8
{ 8 }
machine encode_zero(value: &Message) -> u64 terminates
ensures result == 0
{ 0 }
machine encode_positive(value: &Message)
ensures encode_message(value) > 0
{}
WireCodec satisfies LawCodec<Message> {
    LawCodec::encode = encode_zero;
    LawCodec::positive = encode_positive;
}
machine main() crashes Trap {
    let message: Message = Message { value: 8 };
    let observed: u64 = WireCodec::encode(&message);
    transition observed == 8 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
