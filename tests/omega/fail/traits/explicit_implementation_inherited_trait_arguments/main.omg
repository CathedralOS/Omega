// FAIL CANARY. An implementation of a trait that inherits the requirement's
// trait supplies the parent at the application its inheritance edge
// substitutes. `CardDescending` implements `Descending<Card>`, whose parent
// edge is `Ranked<T>` with `T = Card`, so `Ranked::compare<Gem, CardDescending>`
// names a parent application it does not supply.
trait Ranked<T> {
    machine compare(left: &T, right: &T) -> bool;
}

trait Descending<T> : Ranked<T> {
    machine lowest(left: &T, right: &T) -> bool;
}

data Card { power: i32; }
data Gem { power: i32; }

CardDescending satisfies Descending<Card> {
    machine compare(left: &Card, right: &Card) -> bool {
        left.power > right.power
    }
    machine lowest(left: &Card, right: &Card) -> bool {
        left.power < right.power
    }
}

machine rank(left: &Gem, right: &Gem) -> bool {
    Ranked::compare<Gem, CardDescending>(left, right)
}
