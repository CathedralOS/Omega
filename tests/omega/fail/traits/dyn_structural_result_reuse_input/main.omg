use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
trait Relay { machine relay(token: Token) -> Token; }
Identity satisfies Relay { machine relay(token: Token) -> Token { token } }
machine probe() {
    let token: Token = Token { value: 7 };
    let result: Token = Relay::relay(Identity as dyn Relay, token);
    drop(result);
    drop(token);
}
