// Expected: reject
// Cathedral selects an inherited interrupt requirement through its child trait.
// This smaller witness requires the same declaration lookup without hardware.
data Box<Value> { value: Value; }
boundary trait Base<Payload, Mark> {
    machine value(input: u64) -> u64 reaches;
}
boundary trait Left<Value, Mark>: Base<Box<Value>, Mark> {}
boundary trait Right<Value, Mark>: Base<Box<Value>, Mark> {}
boundary trait Derived<Value, Mark>: Left<Value, Mark> + Right<Value, u64> {}

machine selected(input: u64) -> u64 satisfies Base<Box<u64>, bool>::value { input ^ 9u64 }
machine forward<machine Handler>(input: u64) -> u64
requires machine Handler satisfies Derived<u64, bool>::value;
{
    Handler(input)
}
machine start() crashes Trap {
    transition forward<selected>(2) == 11 && forward<selected>(4) == 13 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
