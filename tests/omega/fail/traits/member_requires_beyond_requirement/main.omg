// A member may not demand a premise its requirement lacks: a caller that
// reaches it through the requirement, here a selector call, proves only the
// requirement's `requires`. `Strict` asks for `value <= 50`, which callers
// of `Shrink::shrink` never prove, so its conformance rejects.

trait Shrink<T> {
    machine shrink(scale: &T, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value;
}

data Scale {
    unit: u8;
}

Strict satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 50
    ensures result <= value
    {
        transition {
            _ -> (value - 1)
        }
    }
}

machine probe(scale: &Scale) -> u64 {
    let strict: dyn Shrink<Scale> = Strict as dyn Shrink<Scale>;
    let first: u64 = Shrink::shrink(strict, scale, 80);
    transition {
        _ -> first
    }
}
