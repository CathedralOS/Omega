// A trait's `machine Requirement` header parameter names a declaration; it
// carries no signature, so it cannot be forwarded where a callable is due.
machine apply<machine Worker>(value: u64) -> u64
requires machine Worker(value: u64) -> u64;
{ Worker(value) }

trait StepContract<machine Requirement>
{
    machine step(value: u64) -> u64
    ensures result == apply<Requirement>(value);
}

machine main() {}
