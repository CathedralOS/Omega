// Phantom type operands carry no physical input source for region elision.
data Marker<Value> { code: i32; }
trait Reading<Value> { machine read(value: Value) -> i32; }
Wrong<'region> satisfies Reading<Marker<&'region i32>> { Reading::read = read; }
machine read(value: Marker<&i32>) -> i32 { 37 }
data Main {}
machine Main::main(main: &mut Main) {}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
