trait Sink<T> {
    machine put(&mut self, value: T);
}

trait IntSink: Sink<i32> {
}

data Counter {
    value: i32;
}

data Main {
    counter: Counter;
}

CounterIntSink: Counter satisfies IntSink;

machine Counter::put(&mut self, value: bool) satisfies Sink<i32>::put {
    self.value = 0;
}

machine Main::main(&mut self) {
}
