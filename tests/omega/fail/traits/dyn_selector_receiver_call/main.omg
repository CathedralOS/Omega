// A selector is a dispatch operand, not a receiver: the call names the
// requirement through its trait and passes the selector first.

trait Shape<T> {
    machine code(subject: &T) -> i32;
}

data Item {
    value: i32;
}

Primary satisfies Shape<Item> {
    machine code(subject: &Item) -> i32 {
        transition { _ -> subject.value }
    }
}

machine run(item: &Item) {
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let result: i32 = selected.code(item);
}
