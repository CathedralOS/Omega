// An executable comparison that always answers true does not establish
// structural identity: the crash clause names identity explicitly, so the
// `true` arm's crash is not covered by it.
data Packet { value: u64; }
trait Equatable<T> { machine equals(left: &T, right: &T) -> bool; }
Always satisfies Equatable<Packet> {
    machine equals(left: &Packet, right: &Packet) -> bool { true }
}
machine inspect(left: &Packet, right: &Packet)
crashes Abort core::Identity<Packet>(left, right) {
    transition left == right {
        true -> failed()
        false -> done()
    }
    machine failed() { crash Abort; }
    machine done() {}
}
machine main() {
    let left: Packet;
    let right: Packet;
    inspect(&left, &right);
}
