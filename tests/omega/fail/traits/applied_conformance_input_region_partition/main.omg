// One body binder cannot instantiate at two independent captured inputs.
trait Reading<First, Second> { machine read(first: First, second: Second) -> i32; }
Wrong<'left, 'right> satisfies Reading<&'left i32, &'right i32> {
    Reading::read = read;
}
machine read<'same>(first: &'same i32, second: &'same i32) -> i32 { 37 }
data Main {}
machine Main::main(main: &mut Main) {}
