// Equal outer reference regions do not erase a different referee region.
trait Reading<Value> { machine read(value: Value) -> i32; }
trait Left<Value>: Reading<Value> {}
trait Right<Value>: Reading<Value> {}
trait Diamond<First, Second>: Left<First> + Right<Second> {}
Ambiguous<'outer, 'left, 'right> satisfies
    Diamond<&'outer &'left i32, &'outer &'right i32> {
    machine read<'source>(value: &'outer &'source i32) -> i32 { read_realization(value) }
}
machine read_realization<'outer, 'source>(value: &'outer &'source i32) -> i32 { 37 }
data Main {}
machine Main::main(main: &mut Main) {}
