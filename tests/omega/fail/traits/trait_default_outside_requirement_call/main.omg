// A trait default body sees only its own trait's requirements. `Resettable`
// declares no `set`; the child trait `Counter` adds one and both
// implementations below supply it, yet the default authored in `Resettable`
// cannot name it: the trait's author cannot see what an implementation adds.
// An inline `set` row forwarding to `Value::set` and an authored `set` row reject
// the same call.
trait Resettable<T> {
    machine reset(subject: &mut T) {
        set(subject, 30);
    }
}

trait Counter<T>: Resettable<T> {
    machine set(subject: &mut T, value: i32);
}

data Value {
    value: i32;
}

ValueCounter satisfies Counter<Value> {
    machine set(value: &mut Value, next: i32) { Value::set(value, next) }
}

machine Value::set(value: &mut Value, next: i32) {
    value.value = next;
}

data Gauge {
    value: i32;
}

GaugeCounter satisfies Counter<Gauge> {
    machine set(gauge: &mut Gauge, next: i32) {
        gauge.value = next;
    }
}
