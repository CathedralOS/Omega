trait Reading<Value> { machine read(value: Value) -> i32; }
ReadingMap<'unused> satisfies Reading<i32> {
    machine read(value: i32) -> i32 { value }
}
trait Uses<Reader satisfies Reading<i32>> {}
data Phantom<Contract> {}
trait Captured<'outer> {
    machine first<'first>(value: Phantom<Uses<ReadingMap<'first>>>);
    // A sibling's binder is not part of this signature's lexical scope.
    machine second<'second>(value: Phantom<Uses<ReadingMap<'first>>>);
}
machine main() {}
