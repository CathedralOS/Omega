machine build(builder: &mut Build) {
    Build::application(builder, "public_implementation_private_members_rejected");
    let mut support_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../../../pass/traits/public_implementation_member_selection_exit/support" });
    dependency::with_alias(&mut support_dependency, "support");
    let support_registration: DependencyRegistration = Build::dependency(builder, support_dependency);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
