// A selector call owes the requirement's `requires` for its own operands,
// paired after the selector: `value` is the call's third operand, 200, not
// the borrowed `scale` beside the selector.

trait Shrink<T> {
    machine shrink(scale: &T, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value;
}

data Scale {
    unit: u8;
}

TrimOne satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value
    {
        transition {
            _ -> (value - 1)
        }
    }
}

machine probe(scale: &Scale) -> u64 {
    let one: dyn Shrink<Scale> = TrimOne as dyn Shrink<Scale>;
    let first: u64 = Shrink::shrink(one, scale, 200);
    transition {
        _ -> first
    }
}
