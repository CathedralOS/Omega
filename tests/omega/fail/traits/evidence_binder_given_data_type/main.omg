// FAIL CANARY. Data does not satisfy traits: a data type is not a named
// implementation, so it cannot fill an evidence binder.
trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter { value: i32 in Wrapping; }

machine apply<T, Operations satisfies Incrementable<T>>(counter: &mut T) {
    Operations::increment(counter);
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) {
    apply<Counter, Counter>(&mut main.counter);
}
