// Equatable prerequisites are checked at the IMPLEMENTATION: a field whose
// type is itself a structural record/sum must also have an Equatable
// implementation, otherwise the synthesized field-by-field expansion has no
// equality to recurse into.

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Pos {
    x: i32;
    y: i32;
}

data Player {
    pos: Pos;
    health: i32;
}

PlayerEquality satisfies Equatable<Player> { }

machine main() {
}
