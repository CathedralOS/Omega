trait Fraction { machine get() -> f64 ensures result >= 0.0 && result <= 0.5; }
Quarter satisfies Fraction { machine get() -> f64 ensures result >= 0.25 && result <= 0.25 { 0.25 } }
machine exact(value: f64) requires value >= 0.25 && value <= 0.25 {}
machine main() { let selected: dyn Fraction = Quarter as dyn Fraction; exact(Fraction::get(selected)); }
