// FAIL CANARY. An exact satisfaction edge corresponds to its requirement
// parameter by parameter under the trait's explicit arguments:
// `Incrementable<Counter>::increment` takes `&mut Counter`, and
// `Counter::increment` here takes `&mut Other`, so the edge is refused.
//
// Matching by position alone would accept this, silently satisfying
// `Incrementable<Counter>` with a machine that never touches a `Counter`.
trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter {
    value: i32 in Wrapping;
}

data Other {
    value: i32 in Wrapping;
}

machine Counter::increment(other: &mut Other) satisfies Incrementable<Counter>::increment {
    other.value = other.value + 1;
}
CounterIncrementable satisfies Incrementable<Counter> {
    Incrementable::increment = Counter::increment;
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) {
    main.counter.value = 0;
}
