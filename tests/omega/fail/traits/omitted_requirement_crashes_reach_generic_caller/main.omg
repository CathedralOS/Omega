// A requirement that omits `crashes` defers to the selection: an application
// "receives ... the selected published routes, disproved routes removed"
// (wiki/spec/language/effects.md, "Static binder contract dependencies").
// `Trapping::apply` publishes `crashes Trap value == 0`, and nothing in
// `advance` rules out `start == 0`, so `advance<Trapping>` may crash and its
// `crashes none` is broken, whatever argument a caller passes ("a favorable
// selection never rescues an invalid body"). Before the selected routes
// reached the application, this program was accepted, and with an argument
// of zero it trapped on both engines.
// Twin: `pass/traits/omitted_requirement_crashes_ruled_out_exit`, whose
// `advance` requires `start >= 1`.
// Expected: reject the Trap route `advance<Trapping>` receives from its call
trait Step {
    machine apply(value: u32) -> u32;
}
Trapping satisfies Step {
    machine apply(value: u32) -> u32
    crashes Trap value == 0
    {
        transition value == 0 { true -> bad() false -> value }
        machine bad() -> u32 crashes Trap { crash Trap; }
    }
}
machine advance<Selected satisfies Step>(start: u32) -> u32
crashes none
{
    Selected::apply(start)
}
machine main() crashes Trap {
    let value: u32 = advance<Trapping>(3);
    transition value == 3 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
