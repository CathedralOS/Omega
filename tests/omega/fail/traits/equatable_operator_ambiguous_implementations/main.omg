// The sealed `==` route selects at most one Equatable implementation for an
// operand type. Two implementations of `Equatable<Coin>` may coexist and be
// called by name, but `==` on `Coin` cannot choose between them.

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Coin {
    value: i32;
    year: i32;
}

CoinEquality satisfies Equatable<Coin> { }

CoinValueEquality satisfies Equatable<Coin> {
    machine equals(left: &Coin, right: &Coin) -> bool {
        left.value == right.value
    }
}

data Main {
    left: Coin;
    right: Coin;
}

machine Main::main(main: &mut Main) {
    let same: bool = main.left == main.right;
}
