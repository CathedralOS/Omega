// A selector is constructed from a named implementation, never from a data
// place: `dyn` does not search for an implementation of a value's type, and
// the data is passed to each call instead.

trait Shape<T> {
    machine code(subject: &T) -> i32;
}

data Item {
    value: i32;
}

Primary satisfies Shape<Item> {
    machine code(subject: &Item) -> i32 {
        transition { _ -> subject.value }
    }
}

machine run(item: Item) {
    let selected: dyn Shape<Item> = item as dyn Shape<Item>;
}
