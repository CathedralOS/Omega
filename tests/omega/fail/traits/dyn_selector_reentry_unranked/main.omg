// An implementation can re-enter itself through a selector: `rewalk` builds a
// selector naming `Loop` and calls the requirement through it, and `Loop`'s
// row calls `rewalk`. The call names the requirement's slot, not `Loop`, so
// termination treats a selector call as an edge to every implementation
// selected for that slot. This unranked cycle through runtime selection
// rejects instead of passing as a call to a bodyless requirement.

trait Walk<T> {
    machine walk(subject: &T) -> i32;
}

data Node {
    depth: i32;
}

Loop satisfies Walk<Node> {
    machine walk(subject: &Node) -> i32 {
        let result: i32 = rewalk(subject);
        transition {
            _ -> result
        }
    }
}

machine rewalk(node: &Node) -> i32 {
    let again: dyn Walk<Node> = Loop as dyn Walk<Node>;
    let result: i32 = Walk::walk(again, node);
    transition {
        _ -> result
    }
}
