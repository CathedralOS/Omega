// Equal generic heads and equal layout do not identify nested type arguments.
data Packet { value: i32; }
data OtherPacket { value: i32; }
data Envelope<Value> { value: Value; }
trait Reading<Value> { machine read(value: Value) -> Value; }
SelectedReading<Value> satisfies Reading<Value> {
    machine read(value: Value) -> Value { value }
}
trait Consumer<Value, Reader satisfies Reading<Value>> {}
trait Invalid:
    Consumer<Envelope<Packet>, SelectedReading<Envelope<OtherPacket>>> {}
