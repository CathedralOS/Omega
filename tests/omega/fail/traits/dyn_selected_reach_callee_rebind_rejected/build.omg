machine build(builder: &mut Build) {
    Build::application(builder, "dyn_selected_reach_callee_rebind_rejected");
    Build::select_provider<Journal, InlineJournal>(builder, linux_x86_64);
    Build::select_provider<Journal, InlineJournal>(builder, linux_arm64);
    Build::select_provider<Journal, InlineJournal>(builder, windows_x86_64);
    Build::select_provider<Journal, InlineJournal>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
