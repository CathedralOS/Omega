// Expected diagnostic: machine `observe` publishes service reach `<none>`
// A callee rebinds a quiet selector to a journaled selection through `&mut`; the later dispatch reaches `Journal`.

public boundary trait Journal {
    machine note(value: u64) -> u64
    ensures result == value
    reaches Journal;
}

InlineJournal satisfies Journal {
    machine note(value: u64) -> u64 ensures result == value { value }
}

public trait Source {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result >= 100u64
    reaches Journal;
}

JournaledSource satisfies Source {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result >= 100u64
    reaches Journal
    {
        let noted: u64 = Journal::note(value);
        noted + 1u64
    }
}

QuietSource satisfies Source {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result >= 100u64
    { value }
}

machine rebind(selected: &mut dyn Source) -> u64 { selected = JournaledSource as dyn Source; 0u64 }

public machine observe(value: u64) -> u64
requires value == 100u64
ensures result >= 100u64
reaches
{
    let mut selected: dyn Source = QuietSource as dyn Source;
    let ignored: u64 = rebind(&mut selected);
    Source::get(selected, value)
}

machine main() crashes Trap {
    let observed: u64 = observe(100u64);
    let difference: u64 = observed - 100u64;
    transition difference == 1u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
