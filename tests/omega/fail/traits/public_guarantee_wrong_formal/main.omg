trait Setting { machine set(first: &mut u64, second: &mut u64, value: u64) ensures first == value; }
Wrong satisfies Setting {
 machine set(first: &mut u64, second: &mut u64, value: u64) ensures second == value { second = value; }
}
machine main() crashes Trap {
 let mut first: u64 = 1; let mut second: u64 = 2;
 Setting::set(Wrong as dyn Setting, &mut first, &mut second, 7);
 transition first == 7 { true -> done() false -> bad() }
 state done() {} state bad() { crash Trap; }
}
