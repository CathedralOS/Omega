// A conformance item is checked against WRITTEN members: `Point satisfies
// Shape;` with no written `Point::code` is an error because the requirement
// has no default body.

trait Shape {
    machine code(&mut self) -> i32;
}

data Point {
    x: i32;
}

PointShape: Point satisfies Shape;

data Main {
    value: i32;
}

machine Main::main(&mut self) {
}
