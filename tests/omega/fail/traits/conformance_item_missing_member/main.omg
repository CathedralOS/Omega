// A named implementation owns one complete closed map: `PointShape satisfies
// Shape<Point> { }` supplies no `code` row, and the requirement has no
// default body, so the map is incomplete.

trait Shape<T> {
    machine code(subject: &mut T) -> i32;
}

data Point {
    x: i32;
}

PointShape satisfies Shape<Point> { }

data Main {
    value: i32;
}

machine Main::main() {
}
