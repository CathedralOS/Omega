// Equal-shaped members still owe their own input region. The implementation
// preserves the input order while its requirement promises the opposite order.
data Pair<First, Second> { first: First; second: Second; }
data Outcome<Value> { case Empty; case Present(value: Value); }
trait Flipping<First, Second> {
    machine flip(source: Pair<First, Second>) -> Outcome<Pair<Second, First>>;
}
machine flip<'left, 'right>(source: Pair<&'left i32, &'right i32>)
    -> Outcome<Pair<&'left i32, &'right i32>>
satisfies Flipping<&'left i32, &'right i32>::flip {
    Outcome::Present { value: source }
}
machine main() {}
