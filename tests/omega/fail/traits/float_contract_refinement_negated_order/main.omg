trait Fraction { machine get() -> f64 ensures result >= 0.0 && result <= 0.5; }
Quarter satisfies Fraction { machine get() -> f64 ensures !(result < 0.0) { 0.25 } }
machine main() crashes Trap { let selected: dyn Fraction = Quarter as dyn Fraction; let observed: f64 = Fraction::get(selected); transition observed == 0.25 { true -> done() _ -> bad() } machine done() {} machine bad() { crash Trap; } }
