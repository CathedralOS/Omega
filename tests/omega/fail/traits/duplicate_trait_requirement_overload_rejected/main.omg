// Two requirements in one trait with the same name and identical parameter
// signatures collapse to one normalized overload identity: the result
// dispatch set is empty, and predicate-only result refinements do not
// distinguish overloads.
data PollResult {
    code: i32;
}

trait Poller {
    machine poll(&mut self, out: &mut PollResult) -> u32;
    machine poll(&mut self, out: &mut PollResult) -> u32;
}

data Main {}

machine Main::main(&mut self) {}
