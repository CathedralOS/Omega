// `dyn Data::Implementation` named a data carrier and an implementation in the
// selector type. A selector type names only a trait application; the
// implementation is chosen by `Implementation as dyn Trait<Data>`.

trait Shape<T> {
    machine code(subject: &T) -> i32;
}

data Item {
    value: i32;
}

machine inspect(value: &dyn Item::Primary) {}
