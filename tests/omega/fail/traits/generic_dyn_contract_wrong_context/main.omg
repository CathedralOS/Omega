trait Reader<Context> {
    machine read(context: &Context) -> u64;
}

data Other { value: u64; }
data ReaderSelection<Context> { operations: dyn Reader<Context>; }

machine forward<Context>(context: &Other, operations: dyn Reader<Context>) -> u64 {
    Reader::read(operations, context)
}

machine from_field<Context>(context: &Other, selection: &ReaderSelection<Context>) -> u64 {
    Reader::read(selection.operations, context)
}
