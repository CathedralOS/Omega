// A selector names exactly the trait application its implementation
// satisfies. `Primary` implements `Shape<Item>`; converting it to
// `dyn Shape<Other>` would select rows typed for a different data type.

trait Shape<T> {
    machine code(subject: &T) -> i32;
}

data Item {
    value: i32;
}

data Other {
    value: i32;
}

Primary satisfies Shape<Item> {
    machine code(subject: &Item) -> i32 {
        transition { _ -> subject.value }
    }
}

machine run() {
    let selected: dyn Shape<Other> = Primary as dyn Shape<Other>;
}
