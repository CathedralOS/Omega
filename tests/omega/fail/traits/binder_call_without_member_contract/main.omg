// Expected error: `Write::try_from` authors `reaches none terminates`, and a
// call that names it directly may rely on that (see the pass fixture
// `direct_member_own_contract_exit`). Here the same member is reached through
// the binder `W`. A binder call has only what `TryFrom::try_from` publishes,
// which is nothing, even when the binder is applied to `Write`.
// The checker stops at the law in `covers`; with that law removed the
// terminating caller `wrap` is refused with "cannot prove published
// termination".
use omega::language::core::conversion;

data Pair [copy] { first: u8; last: u8; }
data Frame [copy] { tag: u8; first: u8; last: u8; }
data Failure [copy] { case InvalidTag; }

Write satisfies TryFrom<Pair, Frame, Failure> {
    machine try_from(source: Pair) -> Result<Frame, Failure> reaches none terminates {
        Result::Ok { value: Frame { tag: 165u8, first: source.first, last: source.last } }
    }
}

machine covers<W satisfies TryFrom<Pair, Frame, Failure>>(value: Pair) reaches none terminates
ensures W::try_from(value) in Result::Ok { }

machine wrap<W satisfies TryFrom<Pair, Frame, Failure>>(source: Pair) -> Result<Frame, Failure>
reaches none terminates
{ W::try_from(source) }

machine main() crashes Trap {
    let pair: Pair = Pair { first: 17u8, last: 29u8 };
    covers<Write>(pair);
    transition wrap<Write>(pair) {
        Result::Err { error as error } -> bad()
        Result::Ok { value as frame } -> inspect(frame)
    }
    machine inspect(frame: Frame) {
        transition frame.tag == 165u8 && frame.first == 17u8 && frame.last == 29u8 {
            true -> done()
            false -> bad()
        }
    }
    machine done() { }
    machine bad() { crash Trap; }
}
