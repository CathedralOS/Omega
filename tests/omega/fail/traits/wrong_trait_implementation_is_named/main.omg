// Expected error: Other implements Loose, not Reading, so it cannot fill the
// Reader slot of Carrier. The refusal names Other, the implementation the
// author wrote.
trait Reading {
    machine floor() -> u64 ensures result >= 7;
}

Seven satisfies Reading {
    machine floor() -> u64 ensures result >= 7 { 7 }
}

trait Loose {
    machine floor() -> u64 ensures result >= 6;
}

Other satisfies Loose {
    machine floor() -> u64 ensures result >= 6 { 6 }
}

trait Carrier<Mark, Reader satisfies Reading, Tag> {
    machine floor() -> u64 ensures result >= 7 {
        Reading::floor<Reader>()
    }
}

Chosen satisfies Carrier<u64, Other, i32> { }

machine main() crashes Trap {
    let value: u64 = Chosen::floor();
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
