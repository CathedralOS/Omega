// Lifetime-only trait telescopes are exact application operands too.
trait Reading<'scope> { machine read(value: &'scope i32) -> i32; }
trait Left<'scope>: Reading<'scope> {}
trait Right<'scope>: Reading<'scope> {}
trait Diamond<'first, 'second>: Left<'first> + Right<'second> {}
Ambiguous<'left, 'right> satisfies Diamond<'left, 'right> {
    machine read<'source>(value: &'source i32) -> i32 { read_realization(value) }
}
machine read_realization<'source>(value: &'source i32) -> i32 { value as i32 }
data Main {}
machine Main::main(main: &mut Main) {}
