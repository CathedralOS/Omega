data Packet { value: u64; }
machine leaf(left: &Packet, right: &Packet)
requires core::Identity<Packet>(Packet { value: left.value }, Packet { value: right.value }) {}
machine inspect(left: &mut Packet, right: &Packet)
requires core::Identity<Packet>(Packet { value: left.value }, Packet { value: right.value }) {
    left.value = 9;
    leaf(left, right);
}
machine main() {}
