// An ordinary machine sharing compiler vocabulary still receives executable
// conformance applications. No declaration role can erase its missing region.
trait Reading<Value> { machine read(value: Value) -> i32; }
ReadingMap<'unused> satisfies Reading<i32> {
    machine read(value: i32) -> i32 { value }
}
data SelectionHelper {}
machine SelectionHelper::select_provider<Reader satisfies Reading<i32>>(value: i32) -> i32 {
    Reader::read(value)
}
machine main() {
    let result: i32 = SelectionHelper::select_provider<ReadingMap>(37);
}
