data Heavy { code: u64; }
trait Expected<Value> { machine test(value: &Value) -> bool; }
trait Alternate<Value> { machine test(value: &Value) -> bool; }

machine wrong<Kind>(value: &Kind) -> bool
satisfies Alternate<Kind>::test
{ true }

machine apply<machine Selected>(value: &Heavy) -> bool
requires machine Selected satisfies Expected<Heavy>::test;
{ Selected(value) }

machine main() {
    let value: Heavy = Heavy { code: 42u64 };
    let result: bool = apply<wrong>(&value);
}
