// A member must guarantee every conclusion its requirement states: a caller
// that reaches it through the requirement, here a selector call, assumes
// `result <= value` and subtracts without a runtime check. `Grow` states no
// `ensures` and returns `value + 1`, so its conformance rejects.

trait Shrink<T> {
    machine shrink(scale: &T, value: u64) -> u64
    requires value >= 3 && value <= 100
    ensures result <= value;
}

data Scale {
    unit: u8;
}

Grow satisfies Shrink<Scale> {
    machine shrink(scale: &Scale, value: u64) -> u64
    requires value >= 3 && value <= 100
    {
        transition {
            _ -> (value + 1)
        }
    }
}

machine probe(scale: &Scale) -> u64 {
    let grow: dyn Shrink<Scale> = Grow as dyn Shrink<Scale>;
    let first: u64 = Shrink::shrink(grow, scale, 9);
    transition {
        _ -> (9 - first)
    }
}
