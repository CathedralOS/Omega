// The same predicate declaration at different static operands is not one fact.
machine below<const Limit: u32>(value: u32) -> bool { value <= Limit }
trait Bounded {
    machine take<const First: u32, const Second: u32>(value: u32) -> u32
    requires below<First>(value);
}
machine identity<const Left: u32, const Right: u32>(input: u32) -> u32
satisfies Bounded::take
requires below<Right>(input)
{ input }
machine main() {}
