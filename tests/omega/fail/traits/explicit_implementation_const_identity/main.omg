// A matching trait and carrier do not erase the selected map's const tuple.
trait Reading<Value> { machine tag() -> i32; }
SelectedReading<Value, const Tag: i32> satisfies Reading<Value> {
    machine tag() -> i32 { Tag }
}
trait Consumer<Value, Reader satisfies Reading<Value>> {
    machine tag() -> i32;
}
ConsumerMap<Value, const Tag: i32>
satisfies Consumer<Value, SelectedReading<Value, Tag>> {
    machine tag() -> i32 { Tag }
}
machine invalid() -> i32 {
    Consumer::tag<i32, SelectedReading<i32, 19>, ConsumerMap<i32, 7>>()
}
