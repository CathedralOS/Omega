// FAIL CANARY.
// A selection row keeps the selected machine's own contract, and that contract
// must refine the requirement it fills. `Codec::decode` accepts every `input`;
// `decode_nonzero` requires `input > 0`, so it asks more of its caller than the
// slot promises and the row rejects. The run twin
// `run/traits/selection_row_existing_machines` selects `decode_message`.
data Message { value: u64; }
trait Codec<T> {
    machine encode(value: &T) -> u64 terminates;
    machine decode(input: u64, out: &mut T) terminates;
}
machine encode_message(value: &Message) -> u64 terminates { value.value }
machine decode_message(input: u64, out: &mut Message) terminates { out.value = input; }
machine decode_nonzero(input: u64, out: &mut Message) terminates
requires input > 0
{
    out.value = input;
}
WireCodec satisfies Codec<Message> {
    Codec::encode = encode_message;
    Codec::decode = decode_nonzero;
}
machine save<T, Format satisfies Codec<T>>(value: &T) -> u64 { Format::encode(value) }
machine main() crashes Trap {
    let mut message: Message = Message { value: 0 };
    WireCodec::decode(8, &mut message);
    let observed: u64 = save<Message, WireCodec>(&message);
    transition observed == 8 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
