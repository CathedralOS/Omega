// FAIL CANARY. An evidence binder accepts only a named implementation of its
// exact trait application. `GaugeIncrement` implements `Incrementable<Gauge>`,
// so it cannot supply `Operations satisfies Incrementable<Counter>` even
// though its requirement has the same name and shape.
trait Incrementable<T> {
    machine increment(counter: &mut T);
}

data Counter { value: i32 in Wrapping; }
data Gauge { value: i32 in Wrapping; }

GaugeIncrement satisfies Incrementable<Gauge> {
    machine increment(counter: &mut Gauge) {
        counter.value = counter.value + 1;
    }
}

machine apply<T, Operations satisfies Incrementable<T>>(counter: &mut T) {
    Operations::increment(counter);
}

data Main { counter: Counter; }

machine Main::main(main: &mut Main) {
    apply<Counter, GaugeIncrement>(&mut main.counter);
}
