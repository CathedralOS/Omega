// Equal carrier and scope do not make separate const binders equal values.
trait Bounded<const Limit: u32> {
    machine identity(value: u32) -> u32
    requires value <= Limit
    ensures result <= Limit;
}
Wrong<const Maximum: u32, const Other: u32> satisfies Bounded<Maximum> {
    machine identity(input: u32) -> u32
    requires input <= Maximum
    ensures result <= Maximum
    { Other }
}
machine main() {}
