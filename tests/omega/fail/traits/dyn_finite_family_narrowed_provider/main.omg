// A runtime value selects a finite generic family row through the ordinary
// named-conformance selector. `scan` forwards its runtime `w` parameter into
// the family's `Width` binder: the caller's own `requires` clause proves the
// membership disjunction, so no static tuple is named at the dispatch site.
// Rebinding the selector changes the provider (Primary adds nothing, Bumped
// adds one), so the observed results differ across rows and providers:
//   scan(Primary, 16) = 99 + 16     == 115
//   scan(Bumped,  32) = 99 + 32 + 1 == 132
use omega_language_std::console;

trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> u32 where Width == 64 || Width == 16 || Width == 16 || Width == 32;
}

data Item {
    value: u32 in Wrapping;
}

machine Item::code<Width: u32>(item: &Item) -> u32 satisfies Shape<Item>::code
requires
    Width == 16 || Width == 32; {
    let w: u32 in Wrapping = Width as u32 in Wrapping;
    let r: u32 = (item.value + w) as u32;
    transition {
        _ -> r
    }
}

machine Item::lifted_code<Width: u32>(item: &Item) -> u32 satisfies Shape<Item>::code {
    let w: u32 in Wrapping = Width as u32 in Wrapping;
    let r: u32 = (item.value + w + 1) as u32;
    transition {
        _ -> r
    }
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
}

Bumped satisfies Shape<Item> {
    Shape::code = Item::lifted_code;
}

machine scan(selected: dyn Shape<Item>, item: &Item, w: u32) -> u32
requires
    w == 16 || w == 32 || w == 64;
{
    let r: u32 = Shape::code<w>(selected, item);
    transition {
        _ -> r
    }
}

data Main {
    item: Item;
}

machine Main::main(main: &mut Main) reaches Console {
    main.item.value = 99;
    let mut selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let first: u32 = scan(selected, &main.item, 16);
    selected = Bumped as dyn Shape<Item>;
    let second: u32 = scan(selected, &main.item, 32);
    transition first == 115 && second == 132 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}
