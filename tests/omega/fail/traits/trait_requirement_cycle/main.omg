trait A {
    requires B;
    machine a(thing: &mut Thing);
}

trait B {
    requires A;
    machine b(thing: &mut Thing);
}

data Thing {
    value: i32;
}

data Main {
    thing: Thing;
}

machine Thing::a(thing: &mut Thing) satisfies A::a {
    thing.value = 1;
}

machine Thing::b(thing: &mut Thing) satisfies B::b {
    thing.value = 2;
}

machine Main::main() {
}
