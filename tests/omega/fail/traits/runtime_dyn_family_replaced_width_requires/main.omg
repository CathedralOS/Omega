// A finite-family result retains the captured ordinary input index through selection, forwarding and storage, and its payload remains 7.
// Expected exit: 0
// Place: parameter.
data Indexed<Limit: u32> { value: u32; selected_width: u32; }
trait Family { machine row<Width: u32>(first: u32, limit: u32) -> Indexed<limit> requires Width == 16 || Width == 32; }
machine produce<Span: u32>(payload: u32, bound: u32) -> Indexed<bound> satisfies Family::row { Indexed { value: payload, selected_width: Span } }
Selected satisfies Family { machine row<Width: u32>(first: u32, limit: u32) -> Indexed<limit> requires Width == 16 || Width == 32 { produce<Width>(first, limit) } }
Other satisfies Family { machine row<Width: u32>(first: u32, limit: u32) -> Indexed<limit> requires Width == 16 || Width == 32 { produce<Width>(first, limit) } }
machine input(slot: &mut u32) -> u32 ensures slot == 64 { slot = 64; 7 }
machine create(selected: dyn Family, width: u32) -> Indexed<16> crashes Trap
requires width == 16 || width == 32
{
    let mut selected_width: u32 = width;
    let mut limit: u32 = 16;
    let saved: u32 = limit;
    let item: Indexed<saved> = Family::row<selected_width>(selected, input(&mut selected_width), limit);
    transition selected_width == 32 && limit == 16 { true -> item false -> bad() }
    machine bad() -> Indexed<16> crashes Trap { crash Trap; }
}
machine check(item: Indexed<16>) crashes Trap {
    transition item.value == 7 && item.selected_width == 32 { true -> done() false -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
machine pass(item: Indexed<16>) crashes Trap { check(item); }
machine transport(selected: dyn Family, width: u32) crashes Trap
requires width == 16 || width == 32
{ pass(create(selected, width)); }
machine main() crashes Trap { transport(Selected as dyn Family, 16); transport(Other as dyn Family, 32); }
