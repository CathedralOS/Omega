// Fact: a runtime dyn trait selector dispatches an inline conformance member over explicit data arguments to establish 100u64 when subtracting 100u64.
// Place: field. The dyn trait selector is stored in a record field before dispatching combine.
// Expected exit: 0

trait WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64;
}

UnitCombine satisfies WeightedCombine {
    machine combine(left: u64, right: u64) -> u64
    requires left >= 60u64 && left <= 60u64
    requires right >= 40u64 && right <= 40u64
    ensures result >= 100u64 && result <= 100u64
    {
        left + right
    }
}

data Dispatcher {
    selector: dyn WeightedCombine;
}

machine first_selector(selectors: &[dyn WeightedCombine; 2]) -> dyn WeightedCombine { selectors[0] }

machine probe(a: u64, b: u64) -> u64
requires a >= 60u64 && a <= 60u64
requires b >= 40u64 && b <= 40u64
ensures result >= 100u64 && result <= 100u64
{
    let mut selectors: [dyn WeightedCombine; 2];
    selectors[0] = UnitCombine as dyn WeightedCombine;
    selectors[0] = UnitCombine as dyn WeightedCombine;
    let dispatcher: Dispatcher = Dispatcher {selector: first_selector(&selectors)};
    WeightedCombine::combine(dispatcher.selector, a, b)
}

machine main() crashes Trap {
    let total: u64 = probe(60u64, 40u64);
    let diff: u64 = total - 100u64;
    transition diff == 0u64 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
