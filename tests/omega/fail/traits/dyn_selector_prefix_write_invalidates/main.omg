trait Fraction { machine get() -> f64; }
Quarter satisfies Fraction { machine get() -> f64 { 0.25 } }
machine replace(value: &mut f64) { value = 0.75; }
machine admit(value: f64) requires value >= 0.0 && value <= 0.5 {}
machine probe(value: f64) requires value >= 0.0 && value <= 0.25 {
    let mut current: f64 = value;
    let selected: dyn Fraction = Quarter as dyn Fraction;
    replace(&mut current);
    admit(current);
}
machine main() {}
