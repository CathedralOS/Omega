// Regions are still part of an application when no physical loan leaf uses
// them. The nominal phantom argument must not collapse the inherited paths.
data Phantom<'scope> {}
trait Reading<Value> { machine read(value: Value) -> i32; }
trait Left<Value>: Reading<Value> {}
trait Right<Value>: Reading<Value> {}
trait Diamond<First, Second>: Left<First> + Right<Second> {}
Ambiguous<'left, 'right> satisfies Diamond<Phantom<'left>, Phantom<'right>> {
    machine read<'source>(value: Phantom<'source>) -> i32 { read_realization(value) }
}
machine read_realization<'source>(value: Phantom<'source>) -> i32 { 37 }
data Main {}
machine Main::main(main: &mut Main) {}
