// Expected diagnostic: machine `journaled_observe` publishes service reach `<none>`
// One private helper dispatches under a quiet and a journaled selection; the journaled caller cannot publish an empty reach row.

public boundary trait Journal {
    machine note(value: u64) -> u64
    ensures result == value
    reaches Journal;
}

InlineJournal satisfies Journal {
    machine note(value: u64) -> u64 ensures result == value { value }
}

public trait Source {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result >= 100u64
    reaches Journal;
}

JournaledSource satisfies Source {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result >= 100u64
    reaches Journal
    {
        let noted: u64 = Journal::note(value);
        noted + 1u64
    }
}

QuietSource satisfies Source {
    machine get(value: u64) -> u64
    requires value == 100u64
    ensures result >= 100u64
    { value }
}

machine relay(selected: dyn Source, value: u64) -> u64
requires value == 100u64
ensures result >= 100u64
{ Source::get(selected, value) }

public machine quiet_observe(value: u64) -> u64
requires value == 100u64
ensures result >= 100u64
reaches
{ relay(QuietSource as dyn Source, value) }

public machine journaled_observe(value: u64) -> u64
requires value == 100u64
ensures result >= 100u64
reaches 
{ relay(JournaledSource as dyn Source, value) }

machine main() crashes Trap {
    let quiet_difference: u64 = quiet_observe(100u64) - 100u64;
    let journaled_difference: u64 = journaled_observe(100u64) - 100u64;
    transition quiet_difference == 0u64 && journaled_difference == 1u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
