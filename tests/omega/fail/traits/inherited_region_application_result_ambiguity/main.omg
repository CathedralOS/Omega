// Erased input/output carriers agree, but the two inherited rows promise
// different result regions. Selecting the first path cannot discharge both.
trait Reading<Input, Output> { machine read(value: Input) -> Output; }
trait Left<Input>: Reading<Input, Input> {}
trait Right<Input, Output>: Reading<Input, Output> {}
trait Diamond<Input, Output>: Left<Input> + Right<Input, Output> {}
Ambiguous<'left, 'right> satisfies Diamond<&'left i32, &'right i32> {
    machine read(value: &'left i32) -> &'right i32 { read_realization(value) }
}
machine read_realization<'source>(value: &'source i32) -> &'source i32 { value }
data Main {}
machine Main::main(main: &mut Main) {}
