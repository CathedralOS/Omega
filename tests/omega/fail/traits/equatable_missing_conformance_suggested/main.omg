// `==` on a structural type WITHOUT an Equatable implementation is an error
// that suggests the one-line fix (frozen decision 11): records and
// payload-bearing sums only get structural equality through a named
// implementation `TypeEquality satisfies Equatable<Type> { }`.

data Point {
    x: i32;
    y: i32;
}

data Main {
    a: Point;
    b: Point;
}

machine Main::main(main: &mut Main) {
    let mut hit: bool = main.a == main.b;
}
