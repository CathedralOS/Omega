data Item { code: u64; }

trait Visitor<Value> {
    machine visit<Context, machine Callback>(value: &Value, context: Context) -> bool
    requires machine Callback(value: &Value, context: Context) -> bool;
    ;
}

machine wrong_context(value: &Item, context: bool) -> bool { context }

machine consumer<machine Routine>(value: &Item) -> bool
requires machine Routine satisfies Visitor<Item>::visit;
{ Routine<u64, wrong_context>(value, 3u64) }

machine main() {}
