// FAIL CANARY. Data does not satisfy traits: the retired
// `PointArea: Point satisfies Area;` declaration, which made the data a
// subject and discovered rows from machines attached to it, is rejected in
// favor of a named implementation with explicit rows,
// `PointArea satisfies Area<Point> { Area::area = Point::area; }`.
trait Area<Shape> {
    machine area(shape: &Shape) -> u64;
}

data Point {
    x: u64;
}

machine Point::area(shape: &Point) -> u64 {
    shape.x
}

PointArea: Point satisfies Area;

machine main() {
}
