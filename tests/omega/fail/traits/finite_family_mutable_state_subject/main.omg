data Packet { value: u32; }
trait Factory {
    machine make<Width: u32>() -> Packet where Width == 16 || Width == 32;
}
machine produce<Width: u32>() -> Packet satisfies Factory::make {
    Packet { value: Width }
}
Selected satisfies Factory { Factory::make = produce; }

machine choose(selected: dyn Factory) -> Packet {
    transition { _ -> changed(selected, 16) }
    machine changed(selected: dyn Factory, mut width: u32) -> Packet
    requires width == 16 || width == 32;
    {
        width = 7;
        Factory::make<width>(selected)
    }
}
