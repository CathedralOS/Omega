// FAIL CANARY. A requirement call through an evidence binder applies the
// binder's own trait application. `Order` is bound as `Ranked<T>`, so
// `Ranked::compare<Card, Order>` inside `rank<T, ...>` names an application
// the binder does not promise, even where `T` will be `Card`.
trait Ranked<T> {
    machine compare(left: &T, right: &T) -> bool;
}

data Card { power: i32; }

machine rank<T, Order satisfies Ranked<T>>(left: &Card, right: &Card) -> bool {
    Ranked::compare<Card, Order>(left, right)
}
