// FAIL CANARY. A requirement call's trait arguments must be its named
// implementation's own trait application. `PowerOrder` implements
// `Ranked<Card>`, so `Ranked::compare<Gem, PowerOrder>` names an application
// it does not satisfy, even though `Gem` has the same fields as `Card`.
trait Ranked<T> {
    machine compare(left: &T, right: &T) -> bool;
}

data Card { power: i32; }
data Gem { power: i32; }

PowerOrder satisfies Ranked<Card> {
    machine compare(left: &Card, right: &Card) -> bool {
        left.power < right.power
    }
}

machine rank(left: &Gem, right: &Gem) -> bool {
    Ranked::compare<Gem, PowerOrder>(left, right)
}
