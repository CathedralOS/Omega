machine build(builder: &mut Build) {
    Build::application(builder, "method_conflicting_actuals");
    Build::select_provider<Echo, SelectedEcho>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, program);
    Build::select_provider<Echo, SelectedEcho>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, program);
    Build::select_provider<Echo, SelectedEcho>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, program);
    Build::select_provider<Echo, SelectedEcho>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, program);
}
