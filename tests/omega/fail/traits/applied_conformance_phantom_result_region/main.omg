// Equal physical source loans do not equate the referee's phantom regions.
data Phantom<'region> { value: i32; }
trait Reading<Input, Output> { machine read(value: Input) -> Output; }
Wrong<'outer, 'left, 'right> satisfies
    Reading<&'outer Phantom<'left>, &'outer Phantom<'right>> {
    Reading::read = read;
}
machine read<'source, 'phantom>(value: &'source Phantom<'phantom>)
    -> &'source Phantom<'phantom> { value }
data Main {}
machine Main::main(main: &mut Main) {}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
