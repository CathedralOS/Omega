// An exact edge must not promise a result region independent of its source.
trait Borrowing<Input, Output> { machine borrow(value: Input) -> Output; }
machine borrow<'source, 'other>(value: &'source i32) -> &'source i32
satisfies Borrowing<&'source i32, &'other i32>::borrow { value }
data Main {}
machine Main::main(main: &mut Main) {}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
