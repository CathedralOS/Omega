trait Reading<Value> { machine read(value: Value) -> i32; }
ReadingMap<'unused> satisfies Reading<i32> {
    machine read(value: i32) -> i32 { value }
}
machine read_with<Reader satisfies Reading<i32>>(value: i32) -> i32 {
    Reader::read(value)
}
machine invoke<'actual>(value: i32) -> i32 {
    read_with<ReadingMap<'undeclared>>(value)
}
machine main() { let result: i32 = invoke(37); }
