// A selector call inside an implementation's own row dispatches at runtime:
// `Walk::walk(again, subject)` passes a selector before the requirement's
// operand, so it is not a static call of this block's `walk` row. Here the
// selector names `Loop` itself, so the row can re-enter itself through the
// dispatch edge, and that unranked cycle rejects.

trait Walk<T> {
    machine walk(subject: &T) -> i32;
}

data Node {
    depth: i32;
}

Loop satisfies Walk<Node> {
    machine walk(subject: &Node) -> i32 {
        let again: dyn Walk<Node> = Loop as dyn Walk<Node>;
        let result: i32 = Walk::walk(again, subject);
        transition {
            _ -> result
        }
    }
}
