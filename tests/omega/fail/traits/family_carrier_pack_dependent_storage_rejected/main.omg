// A bare carrier family names the total carrier over every index pack. Its
// Type binder is stored in a field, so its borrow frontier depends on the
// unknown pack (`T` may be a reference) and cannot be compared with the
// realizer's `Holder<T>`. A machine-indexed family has no such field.
data Holder<T> {
    value: T;
}

proposition held<T>(value: Holder<T>) = true;

trait Holding<C, proposition Held>
where proposition Held(value: C);
{
    machine hold(value: C)
    ensures Held(value);
}

machine hold_any<T>(value: Holder<T>)
satisfies Holding<Holder, held>::hold
ensures held<T>(value)
{
}

machine main() {
}
