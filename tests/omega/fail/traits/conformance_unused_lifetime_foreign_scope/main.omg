trait Reading<Value> { machine read(value: Value) -> i32; }
ReadingMap<'provider> satisfies Reading<i32> {
    machine read(value: i32) -> i32 { value }
}
machine read_with<Reader satisfies Reading<i32>>(value: i32) -> i32 {
    Reader::read(value)
}
machine unrelated<'foreign>(value: i32) -> i32 { value }
// This uncalled body still owes admission; another machine's region cannot
// supply its operand, nor can the provider's unused binder.
machine unused<'local>(value: i32) -> i32 {
    read_with<ReadingMap<'foreign>>(value)
}
machine main() {}
