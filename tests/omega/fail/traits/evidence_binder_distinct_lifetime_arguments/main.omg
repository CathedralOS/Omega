data Selected<'region> { reference: &'region i32; }

trait Identity<Value> { machine forward(value: Value) -> Value; }
IdentityMap<Value> satisfies Identity<Value> {
    machine forward(value: Value) -> Value { value }
}

machine observe<'first, Operations satisfies Identity<Selected<'first>>>(
    value: Selected<'first>
) {}

// Equal runtime carriers do not make these two caller regions interchangeable.
machine run<'left, 'right>(
    left: Selected<'left>, right: Selected<'right>
) {
    observe<IdentityMap<Selected<'right>>>(left);
}

machine main() {}
