// A recursive type has no synthesized Equatable row yet: the inline
// field-by-field expansion would not terminate, so the implementation is
// rejected cleanly.

trait Equatable<T> {
    machine equals(left: &T, right: &T) -> bool;
}

data Node {
    value: i32;
    next: Node;
}

NodeEquality satisfies Equatable<Node> { }

machine main() {
}
