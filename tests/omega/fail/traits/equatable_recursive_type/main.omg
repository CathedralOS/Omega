// A recursive type cannot satisfy Equatable yet: the synthesized inline
// field-by-field expansion would not terminate, so the conformance item is
// rejected cleanly (recorded as future work alongside the callable
// synthesized `equals` machine).

trait Equatable {
    machine equals(value: &Self, other: &Self) -> bool;
}

data Node {
    value: i32;
    next: Node;
}

NodeEquatable: Node satisfies Equatable;

machine main() {
}
