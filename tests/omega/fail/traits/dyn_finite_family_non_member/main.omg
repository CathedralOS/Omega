// A dynamic call on a finite generic method family must spell exactly one
// declared roster tuple. `code<64>` is not a member of
// `Width == 16 || Width == 32`, so no table row exists for it -- the call
// rejects by naming the roster, never silently dispatches.

trait Shape<T> {
    machine code<Width: u32>(subject: &T) -> i32 where Width == 16 || Width == 32;
}

data Item {
    value: i32;
}

machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape<Item>::code {
    transition { _ -> item.value }
}

Primary satisfies Shape<Item> {
    Shape::code = Item::code;
}

data Main {
    item: Item;
}

machine Main::run(main: &mut Main) {
    let selected: dyn Shape<Item> = Primary as dyn Shape<Item>;
    let missing: i32 = Shape::code<64>(selected, &main.item);
}
