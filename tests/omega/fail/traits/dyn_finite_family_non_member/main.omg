// FAIL canary: a `dyn` call on a finite generic method family must spell
// exactly one declared roster tuple. `code<64>` is not a member of
// `Width == 16 || Width == 32`, so no family row exists for it -- the call
// must reject by naming the roster, never silently dispatch.

trait Shape {
    machine code<Width: u32>(subject: &Self) -> i32 where Width == 16 || Width == 32;
}

data Item {
    value: i32;
}

machine Item::code<Width: u32>(item: &Item) -> i32 satisfies Shape::code {
    transition { _ -> item.value }
}

Primary: Item satisfies Shape {
    Shape::code = Item::code;
}

data Main {
    item: Item;
}

machine Main::run(main: &mut Main) {
    let erased: &dyn Shape = &main.item as &dyn Item::Primary;
    let missing: i32 = Shape::code<64>(erased);
}
