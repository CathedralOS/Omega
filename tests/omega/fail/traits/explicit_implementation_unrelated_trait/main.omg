// FAIL CANARY. A requirement call selects a row of an implementation of the
// trait that declares the requirement. `Heavier` implements `Weighed<Card>`,
// whose `compare` has the same name and shape as `Ranked::compare`, but it is
// not an implementation of `Ranked` and supplies no row for it.
trait Ranked<T> {
    machine compare(left: &T, right: &T) -> bool;
}

trait Weighed<T> {
    machine compare(left: &T, right: &T) -> bool;
}

data Card { power: i32; }

Heavier satisfies Weighed<Card> {
    machine compare(left: &Card, right: &Card) -> bool {
        left.power < right.power
    }
}

machine rank(left: &Card, right: &Card) -> bool {
    Ranked::compare<Card, Heavier>(left, right)
}
