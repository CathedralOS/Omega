// Expected exit: 0
boundary trait ExactRead {
    machine read(value: u8) -> u8
    ensures result == value;
}
trait LocalForward {
    machine forward(value: u8) -> u8
    ensures result == value;
}
ReadRoute satisfies LocalForward {
    machine forward(value: u8) -> u8
    ensures result == value
    { value }
}
machine main() crashes Trap {
    let result: u8 = ExactRead::read(7u8);
    transition result == 7u8 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
