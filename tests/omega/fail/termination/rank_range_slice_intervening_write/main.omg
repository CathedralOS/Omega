// FAIL CANARY. `scan_a` writes its ranked `entries` input before the
// component call. The write frame overlaps a ranking premise, so the
// entry-relative length no longer describes the call's actual arguments even
// though the passed expressions keep their spellings.
data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> self.scan_a(view, 4)
    }
}

machine Main::scan_a(&mut self, mut entries: &[Entry], capacity: u64)
requires entries.len <= capacity;
terminates by entries -> Slice::Length in 0..=capacity;
-> u64 {
    entries = entries;
    transition entries.len > 0 {
        true -> self.scan_b(entries[1..], capacity)
        false -> 0
    }
}

machine Main::scan_b(&mut self, entries: &[Entry], capacity: u64)
requires entries.len <= capacity;
terminates by entries -> Slice::Length in 0..=capacity;
-> u64 {
    transition entries.len > 0 {
        true -> self.scan_a(entries[1..], capacity)
        false -> 0
    }
}
