// A self-ranked walk measured by its cursor's distance to a slice length,
// whose loop edge keeps the cursor where it was. Reading the length as a
// rank observation must not excuse the arrival's strict decrease.
machine walk(path: &[u8], index: u64)
terminates by (index, path.len) -> Nat::BoundedDistance
{
    transition index < path.len {
        true -> walk(path, index)
        _ -> done()
    }
    machine done() { }
}
machine main() { walk("abc", 0); }
