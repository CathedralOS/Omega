// Fact: a nested helper ranked by a declared measure over an owned child of
// its record parameter (`terminates by pending.held -> Countdown::Remaining in
// 0..=5`) is accepted when every recursive call builds a child whose measure
// is smaller. This twin rebuilds the child with the same `remaining`, so
// its rank does not decrease and the helper must be rejected.
data Countdown requires remaining <= 5 { remaining: u64; }
data Bundle { held: Countdown; spare: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }
machine walk(start: u64) -> u64
requires start <= 5
terminates by start in 0..=5 {
    transition { _ -> iterate(Bundle { held: Countdown { remaining: start }, spare: 4 }) }
    machine iterate(pending: Bundle) -> u64
    terminates by pending.held -> Countdown::Remaining in 0..=5 {
        transition pending.held.remaining > 0 {
            true -> iterate(Bundle { held: Countdown { remaining: pending.held.remaining }, spare: pending.spare })
            false -> pending.held.remaining
        }
    }
}
machine main() crashes Trap {
    let result: u64 = walk(5);
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
