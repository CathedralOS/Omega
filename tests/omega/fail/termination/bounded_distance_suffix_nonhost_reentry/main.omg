// The host implementation finishes, but the other supplied implementation
// re-enters the root. Portable suffix relevance must include both.
boundary trait Selection {
    machine selected() -> u64 reaches;
}
MacSelection satisfies Selection {
    machine selected() -> u64 { 37 }
}
LinuxSelection satisfies Selection {
    machine selected() -> u64 { walk(0, 4) }
}
machine walk(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance
{
    transition index < limit {
        true -> walk(index + 1, limit)
        _ -> done()
    }
    machine done() -> u64 { Selection::selected() }
}
machine program() { let result: u64 = walk(0, 4); }
