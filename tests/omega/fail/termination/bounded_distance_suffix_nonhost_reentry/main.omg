// The host member finishes, but the other retained member re-enters the root.
// Portable suffix relevance must include both members.
boundary trait SelectedSelected {
    machine selected() -> u64 reaches
;
}
MacosArm64Selected satisfies SelectedSelected {
    machine selected() -> u64
{ 37 }
}
LinuxX8664Selected satisfies SelectedSelected {
    machine selected() -> u64
{ walk(0, 4) }
}
machine walk(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance;
{
    transition index < limit {
        true -> walk(index + 1, limit)
        _ -> done()
    }
    machine done() -> u64 { SelectedSelected::selected() }
}
machine program() { let result: u64 = walk(0, 4); }
