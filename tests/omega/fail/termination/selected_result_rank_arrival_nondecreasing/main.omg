use omega::language::core::binding;
pub boundary trait RankReader { machine observe(value: i32) -> i32
terminates
requires value >= 0 && value <= 9
ensures result == value;
}
CheckedReader satisfies RankReader {
    machine observe(value: i32) -> i32
    requires value >= 0 && value <= 9;
    ensures result == value;
    { value }
}
machine require_identity(actual: i32, expected: i32) -> i32
requires actual == expected;
{ actual }
machine countdown(reader: &Binding<RankReader>, remaining: i32) -> i32
requires remaining >= 0 && remaining <= 9;
terminates by remaining -> Nat::Descending in 0..=9;
reaches RankReader
{
    transition remaining > 0 {
        true -> countdown(reader, reader.observe(remaining))
        false -> remaining
    }
}
