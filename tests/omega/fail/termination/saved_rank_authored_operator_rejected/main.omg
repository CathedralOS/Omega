// An actual u32 subtraction override must not become builtin arithmetic just
// because its left operand is a saved local. Its declaration gives no descent.
data Math {}
boundary machine - Math::subtract(left: u32, right: u32) -> u32;

data Main {}
machine Main::count(remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition remaining > 0 {
        true -> hold(remaining)
        false -> remaining
    }
    machine hold(pending: u32) -> u32
    requires pending > 0 && pending <= 9
    {
        let saved: u32 = pending;
        transition { _ -> Main::step(saved - 1) }
    }
}

machine Main::step(remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition { _ -> Main::count(remaining) }
}
