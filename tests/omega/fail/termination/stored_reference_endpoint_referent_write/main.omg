// A forwarded reference descriptor is not a snapshot of its referent.
// Even a self-copy writes the invocation-fixed endpoint's exact path.
data Wrap where 4 <= remaining, remaining <= 500 { remaining: u64; }
data Indirect { target: &mut Wrap; }

machine walk(remaining: u64, mut indirect: Indirect)
    requires 0 <= remaining && remaining <= 4
terminates by remaining -> Nat::Descending in 0..=indirect.target.remaining;
-> u64 {
    indirect.target.remaining = indirect.target.remaining;
    transition remaining > 0 {
        true -> walk(remaining - 1, indirect)
        false -> remaining
    }
}
