// Reject: a write, call, or alias invalidates the entry-relative ranking.
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy]
where view.bytes.len == Count
{ view: View<'storage>; }
machine previous(value: u64) -> u64
requires value > 0
ensures result == value - 1
{ value - 1 }
machine ready(value: &mut u64) -> bool
ensures result == true && value == 2
{ value = 2; true }
machine retain_counted<'storage, Count: u64>(selected: Counted<'storage, Count>, mut remaining: u64)
requires remaining <= 2
terminates by remaining -> Nat::Descending in 0..=2;
-> Counted<'storage, Count>
{
    transition ready(&mut remaining) {
        true -> retain_counted<Count>(selected, previous(remaining))
        false -> selected
    }
}
machine main() {}
