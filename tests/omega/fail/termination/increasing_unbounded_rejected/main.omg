// TPR3 (decision 23): an unbounded increasing view is NOT a well-founded
// ranking -- the bound is part of the view. The rejection is DIRECTED at the
// bounded spelling `Nat::IncreasingTo(limit)` instead of a bare
// "cannot prove".

data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition {
        _ -> Main::climb(main, 4, 0)
    }
}

machine Main::climb(main: &mut Main, limit: u64, index: u64)
terminates by index -> Nat::Increasing;
-> u64
{
    transition index < limit {
        true -> climb(main, limit, index + 1)
        false -> index
    }
}
