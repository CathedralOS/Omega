// FAIL CANARY. `value * 0 + 1` normalizes to the constant 1: no term reaches
// the parameter, so the subject's descent says nothing about the rank and the
// view is not admitted for this subject.
data Countdown {}

measure Countdown::Flat(value: u8) -> u8 { value * 0 + 1 }

machine walk(remaining: u8 [0..=100])
terminates by remaining -> Countdown::Flat in 0..=200;
-> u8 {
    transition remaining > 0 {
        true -> walk(remaining - 1)
        false -> remaining
    }
}
