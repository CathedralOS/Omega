// INVALID: the Wrapping subject `n` decrements under a guard about `acc`
// that says nothing about `n`, so `n - 1` may wrap to the carrier maximum and
// the recursion has no natural rank. The sibling
// `pass/termination/wrapping_subject_guarded_descent` ranks the same update
// under a dominating `n > 0` guard; this control pins that the guard, not the
// policy spelling, is what admits a Wrapping subject.

data Main {
}

machine Main::main(main: &mut Main) {
    let total: u64 in Wrapping = Main::drain(main, 4, 0);
}

machine Main::drain(main: &mut Main, n: u64 in Wrapping, acc: u64 in Wrapping) -> u64 in Wrapping
terminates by n
{
    transition acc < 10 {
        true -> drain(main, n - 1, acc + 1)
        false -> acc
    }
}
