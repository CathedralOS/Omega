// FAIL CANARY. Every edge in this same-shaped machine SCC merely forwards the
// rank, leaving a non-strict cycle with no well-founded progress.
data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> Main::scan_a(&mut self, 4) }
}

machine Main::scan_a(main: &mut Main, remaining: u64)
terminates by remaining;
-> u64
{
    transition remaining > 0 {
        true -> Main::scan_b(main, remaining)
        false -> 0
    }
}

machine Main::scan_b(main: &mut Main, remaining: u64)
terminates by remaining;
-> u64
{
    transition remaining > 0 {
        true -> Main::scan_a(main, remaining)
        false -> 0
    }
}
