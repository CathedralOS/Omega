// Fact: a nested helper ranked by a declared measure over its record parameter
// (`terminates by held -> Countdown::Remaining in 0..=5`) is accepted when each
// recursive call passes a call result whose ranked field is fixed by the
// callee's public `ensures result.remaining == value.remaining` and that actual
// lowers the measure.
// This twin passes `remaining: held.remaining`, so the arriving rank equals
// the source rank and the helper must be rejected.
data Countdown requires remaining <= 5 { remaining: u64; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }

machine identity(value: Countdown) -> Countdown
ensures result.remaining == value.remaining
{ value }

machine walk(countdown: Countdown) -> u64
terminates by countdown -> Countdown::Remaining in 0..=5 {
    transition {
        _ -> iterate(identity(countdown), Countdown { remaining: 4 })
    }
    machine iterate(held: Countdown, spare: Countdown) -> u64
    terminates by held -> Countdown::Remaining in 0..=5 {
        transition held.remaining > 0 {
            true -> iterate(identity(Countdown { remaining: held.remaining }), spare)
            false -> held.remaining
        }
    }
}

machine main() crashes Trap {
    let result: u64 = walk(Countdown { remaining: 5 });
    transition result == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
