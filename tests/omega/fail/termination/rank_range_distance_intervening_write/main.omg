// FAIL CANARY. `scan_a` writes its ranked `index` input before the component
// call. The write frame overlaps a ranking premise, so the entry-relative
// distance no longer describes the call's actual arguments even though the
// passed expressions keep their spellings.
data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.scan_a(0, 4) }
}

machine Main::scan_a(&mut self, mut index: u64 [0..=4], limit: u64 [0..=4])
requires index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    index = index;
    transition index < limit {
        true -> self.scan_b(index, limit)
        false -> index
    }
}

machine Main::scan_b(&mut self, index: u64 [0..=4], limit: u64 [0..=4])
requires index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    transition index < limit {
        true -> self.scan_a(index + 1, limit)
        false -> index
    }
}
