// The bounded distance written backwards: `(limit, index)` binds the climbing
// index as the UPPER subject, so the ranked distance is the true distance's
// negation and cannot decrease as the index climbs. The checker recognizes the
// inversion -- the swapped subjects prove as the named bounded distance -- and
// the diagnostic names the right shape instead of a bare "cannot prove".

data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition {
        _ -> Main::walk(main, 4, 0)
    }
}

machine Main::walk(main: &mut Main, limit: u64, index: u64)
terminates by (limit, index);
-> u64
{
    transition index < limit {
        true -> walk(main, limit, index + 1)
        false -> index
    }
}
