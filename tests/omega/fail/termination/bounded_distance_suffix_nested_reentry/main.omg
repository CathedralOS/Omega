// A finishing initializer still executes its nested helper before returning.
// That helper resets the ranked root, so this suffix cannot discard the rank.
machine identity(value: u64) -> u64 { value }
machine reenter() -> u64 { walk(0, 4) }
machine walk(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance;
{
    transition index < limit {
        true -> walk(index + 1, limit)
        _ -> done()
    }
    machine done() -> u64 {
        let result: u64 = identity(reenter());
        result
    }
}
machine program() { let result: u64 = walk(0, 4); }
