// FAIL CANARY. `remaining - stride` names `right` the moved copy of
// `remaining`, demoting `left` to a stale snapshot. `step(left)` then passes
// the slot that no longer carries the rank: `n` claims no `remaining` role,
// so the call has no evidence the callee receives the descended
// continuation.
data Main {}

machine Main::main(&mut self) -> u32 {
    transition { _ -> self.count(9, 1) }
}

machine Main::count(&mut self, remaining: u32 [0..=9], stride: u32 [1..=5])
terminates by remaining in 0..=9;
-> u32 {
    transition remaining >= stride {
        true -> pair(remaining, remaining - stride, stride)
        false -> remaining
    }
    state pair(left: u32 [0..=9], right: u32 [0..=9], step: u32 [1..=5]) {
        transition left > 0 {
            true -> self.step(left, step)
            false -> right
        }
    }
}

machine Main::step(&mut self, n: u32 [0..=9], stride: u32 [1..=5])
terminates by n in 0..=9;
-> u32 {
    transition n >= stride {
        true -> self.count(n - stride, stride)
        false -> n
    }
}
