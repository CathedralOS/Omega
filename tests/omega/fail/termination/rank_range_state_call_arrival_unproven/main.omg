// FAIL CANARY. `hold(remaining, cap - 1)` moves the carried ceiling at the
// arrival: `bound` denotes `cap - 1`, not the pinned `cap`, so neither layer
// can conserve the endpoint. The component judgment now rejects first -- the
// site's premise `0..=cap` has no carrier still denoting `cap` -- and the
// member's own rank-range judgment cannot pin the moved endpoint either.

data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.outer(6, 4) }
}

machine Main::outer(&mut self, cap: u64, remaining: u64)
requires remaining <= cap;
terminates by remaining in 0..=cap;
-> u64 {
    transition remaining > 0 && cap > 0 {
        true -> hold(remaining, cap - 1)
        false -> remaining
    }
    state hold(pending: u64, bound: u64) {
        transition pending > 0 {
            true -> self.inner(pending, bound)
            false -> pending
        }
    }
}

machine Main::inner(&mut self, n: u64, limit: u64)
terminates by n;
-> u64 {
    transition n > 0 && n <= limit {
        true -> self.outer(limit, n - 1)
        false -> n
    }
}
