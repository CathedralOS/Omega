// FAIL CANARY. The subordinate site consumes `outer`'s range invariant
// `0 <= pending <= bound`, but the invariant never authorizes replacing the
// carried endpoint: `inner(pending, pending)` forwards the subject carrier
// where the authored ceiling `cap` must travel, so the unranged member
// cannot conserve that endpoint back to `outer` and the component rejects.

data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.outer(6, 4) }
}

machine Main::outer(&mut self, cap: u64, remaining: u64)
requires remaining <= cap;
terminates by remaining in 0..=cap;
-> u64 {
    transition remaining > 0 {
        true -> hold(remaining, cap)
        false -> remaining
    }
    state hold(pending: u64, bound: u64) {
        transition pending > 0 {
            true -> self.inner(pending, pending)
            false -> pending
        }
    }
}

machine Main::inner(&mut self, n: u64, limit: u64)
terminates by n;
-> u64 {
    transition n > 0 && n <= limit {
        true -> self.outer(limit, n - 1)
        false -> n
    }
}
