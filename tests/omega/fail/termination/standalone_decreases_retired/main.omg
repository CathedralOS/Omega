// TPR1 (decision 23): a standalone `decreases` clause is RETIRED -- the
// witness attaches to the guarantee as `terminates by ...;`.
use omega::language::std::console;
data Main { console: Console; }
machine countdown(n: u64) -> u64
decreases n
{
    transition n {
        0 -> (0)
        _ -> (countdown(n - 1))
    }
}
machine Main::main(&mut self) { self.console.exit_process(70); }
