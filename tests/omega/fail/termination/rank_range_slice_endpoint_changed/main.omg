// FAIL CANARY. Both members pin their authored ceiling to the `capacity`
// endpoint input. `scan_a` substitutes that pinned endpoint with the
// collection's own length metadata, so the transported ceiling no longer
// equals the pinned input: the changed endpoint invalidates the preserved
// premise.
data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[Entry] = self.entries.as_slice();

    transition {
        _ -> self.scan_a(view, 4)
    }
}

machine Main::scan_a(&mut self, entries: &[Entry], capacity: u64)
requires entries.len <= capacity;
terminates by entries -> Slice::Length in 0..=capacity;
-> u64 {
    transition entries.len > 0 {
        true -> self.scan_b(entries[1..], entries.len)
        false -> 0
    }
}

machine Main::scan_b(&mut self, entries: &[Entry], capacity: u64)
requires entries.len <= capacity;
terminates by entries -> Slice::Length in 0..=capacity;
-> u64 {
    transition entries.len > 0 {
        true -> self.scan_a(entries[1..], capacity)
        false -> 0
    }
}
