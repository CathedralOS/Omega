// FAIL CANARY. Forwarding the projected slice unchanged keeps the produced
// length coordinate identical: the cyclic `step -> step` edge cannot prove
// strict descent of `current.items`'s length even though the record literal
// respells the ranked carrier.
data Bag { items: &[u32]; }

machine walk(bag: Bag, capacity: u64)
requires bag.items.len <= capacity;
terminates by bag.items -> Slice::Length in 0..=capacity;
-> u64 {
    transition { _ -> step(bag, capacity) }
    state step(current: Bag, bound: u64) {
        transition current.items.len > 0 {
            true -> step(Bag { items: current.items }, bound)
            false -> 0
        }
    }
}
