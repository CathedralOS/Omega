// FAIL CANARY. `scan_a` lends its ranked `index` to `bump`, a checked-body
// callee that writes through the exclusive borrow. The call's complete write
// frame reaches a premise carrier before the component edge, so the
// entry-relative ranking no longer describes the call's actual arguments.
data Main {}

machine Main::main(&mut self) -> u64 {
    transition { _ -> self.scan_a(0, 4) }
}

machine Main::bump(&mut self, value: &mut u64) {
    value = 0;
}

machine Main::scan_a(&mut self, mut index: u64 [0..=4], limit: u64 [0..=4])
requires index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    self.bump(&mut index);
    transition index < limit {
        true -> self.scan_b(index + 1, limit)
        false -> index
    }
}

machine Main::scan_b(&mut self, index: u64 [0..=4], limit: u64 [0..=4])
requires index <= limit;
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4;
-> u64 {
    transition index < limit {
        true -> self.scan_a(index + 1, limit)
        false -> index
    }
}
