// FAIL CANARY. `scan_a` lends its ranked `index` to `bump`, a checked-body
// callee that writes through the exclusive borrow. The call's complete write
// frame reaches a premise carrier before the component edge, so the
// entry-relative ranking no longer describes the call's actual arguments.
data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition { _ -> Main::scan_a(main, 0, 4) }
}

machine bump(value: &mut u64) {
    value = 0;
}

machine Main::scan_a(main: &mut Main, mut index: u64, limit: u64) -> u64
requires index <= 4 && limit <= 4 && index <= limit
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4 {
    bump(&mut index);
    // Re-establish call bounds after the write, not the original rank.
    transition index < limit && limit <= 4 {
        true -> Main::scan_b(main, index + 1, limit)
        false -> index
    }
}

machine Main::scan_b(main: &mut Main, index: u64, limit: u64) -> u64
requires index <= 4 && limit <= 4 && index <= limit
terminates by (index, limit) -> Nat::BoundedDistance in 0..=4 {
    transition index < limit {
        true -> Main::scan_a(main, index + 1, limit)
        false -> index
    }
}
