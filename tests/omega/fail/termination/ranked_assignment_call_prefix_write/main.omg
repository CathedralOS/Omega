data Scratch { observed: u32; }

machine reset(value: &mut u32) -> u32 {
    value = 9;
    0
}

machine keep(value: u32) -> u32 { value }

machine countdown(scratch: &mut Scratch, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(scratch, remaining) }
    machine scan(scratch: &mut Scratch, mut remaining: u32) -> u32
    requires remaining <= 9;
    {
        // A disjoint destination does not hide a nested write to the rank.
        scratch.observed = keep(reset(&mut remaining)) + 0;
        transition remaining > 0 {
            true -> scan(scratch, remaining - 1)
            false -> scratch.observed
        }
    }
}

machine main() {}
