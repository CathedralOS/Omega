machine wrapping_step(value: u8 in Wrapping) -> u8
ensures result == value - 1;
{ (value - 1) as u8 }
machine wrapping_countdown(remaining: u8) -> u8
terminates by remaining -> Nat::Descending in 0..=255;
{
    transition remaining < 255 {
        true -> wrapping_countdown(wrapping_step(remaining as u8 in Wrapping))
        false -> remaining
    }
}

machine saturating_step(value: u8 in Saturating) -> u8
ensures result == value - 1;
{ (value - 1) as u8 }
machine saturating_countdown(remaining: u8) -> u8
terminates by remaining -> Nat::Descending in 0..=255;
{
    transition remaining < 255 {
        true -> saturating_countdown(saturating_step(remaining as u8 in Saturating))
        false -> remaining
    }
}
