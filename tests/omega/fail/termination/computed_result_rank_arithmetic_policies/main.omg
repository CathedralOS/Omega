// INVALID: a step computed under a Wrapping or Saturating policy supplies no
// descending rank. The step's `ensures result == value - 1` denotes the
// natural `value - 1` only where that value lands in the carrier, and the
// countdown guard `remaining < 255` admits `remaining == 0`: the Wrapping step
// then climbs to 255 and the Saturating step stalls at 0. Each arriving rank
// is therefore only its carrier interval, which satisfies the authored range
// but never a strict decrease, so both countdowns refuse at the recurrent
// arrival. A `remaining >= 1` guard would make the same step a proven
// descent (`pass/termination/wrapping_subject_guarded_descent`).

machine wrapping_step(value: u8 in Wrapping) -> u8
ensures result == value - 1
{ (value - 1) as u8 }
machine wrapping_countdown(remaining: u8) -> u8
terminates by remaining -> Nat::Descending in 0..=255
{
    transition remaining < 255 {
        true -> wrapping_countdown(wrapping_step(remaining as u8 in Wrapping))
        false -> remaining
    }
}

machine saturating_step(value: u8 in Saturating) -> u8
ensures result == value - 1
{ (value - 1) as u8 }
machine saturating_countdown(remaining: u8) -> u8
terminates by remaining -> Nat::Descending in 0..=255
{
    transition remaining < 255 {
        true -> saturating_countdown(saturating_step(remaining as u8 in Saturating))
        false -> remaining
    }
}
