// FAIL CANARY. `stride` declares no positive floor, so `live - step` is not
// strict descent evidence: a permitted zero step repeats the same live
// rank. Bounds on the captured values cannot prove progress.
machine walk(remaining: u32, stride: u32)
requires remaining <= 9;
terminates by remaining in 0..=9;
-> u32 {
    transition { _ -> pair(remaining, remaining, stride) }
    machine pair(live: u32, saved: u32, step: u32) -> u32
    requires live <= 9 && saved <= 9;
    {
        transition live >= step {
            true -> pair(live - step, saved, step)
            false -> live
        }
    }
}
