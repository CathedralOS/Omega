// A constant-bound distance whose guard admits the bound itself: at index 8
// the step to 9 leaves the distance below 8 at zero, so no edge decrease
// holds and the ranking is rejected.
data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition {
        _ -> Main::walk(main, 0)
    }
}

machine Main::walk(main: &mut Main, index: u64)
terminates by (index, 8) -> Nat::BoundedDistance;
-> u64
{
    transition index < 9 {
        true -> walk(main, index + 1)
        false -> index
    }
}
