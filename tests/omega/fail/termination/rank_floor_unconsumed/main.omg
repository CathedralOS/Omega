// The distance reaches zero when index reaches limit. The authored floor of
// one is therefore unproved, irrespective of whether nonzero floors are
// supported for other ranked programs.
use omega::language::std::console;
use omega::language::core::service;
data Main { console: Binding<Console>; }
machine Main::climb(&mut self, limit: u64, index: u64)
terminates by index -> Nat::IncreasingTo(limit) in 1..=limit;
-> u64
{
    transition index < limit {
        true -> climb(limit, index + 1)
        false -> index
    }
}
machine Main::main(&mut self) reaches Console {
    let value: u64 = self.climb(4, 0);
    self.console.exit_process(70);
}
