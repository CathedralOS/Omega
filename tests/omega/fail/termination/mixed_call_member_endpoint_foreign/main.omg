// FAIL CANARY. A mixed-range call component must conserve the projected
// endpoint `limits.cap`: `outer` pins `remaining in 0..=limits.cap` and the
// unranged `inner` hands back `spare`, a record that never traced to the
// authored input (it arrives as a fresh literal). Membership
// `n - 1 <= spare.cap` still proves from the authored requires, but the
// ceiling coordinate at the `outer` boundary is `spare.cap` rather than the
// transported `bounds.cap`, so the dependent endpoint is not conserved.
data Limits { cap: u64 [0..=9]; }

machine outer(remaining: u64, limits: Limits)
requires remaining <= limits.cap;
terminates by remaining in 0..=limits.cap;
-> u64 {
    transition remaining > 0 {
        true -> inner(remaining, limits, Limits { cap: 5 })
        false -> remaining
    }
}

machine inner(n: u64, bounds: Limits, spare: Limits)
requires n <= bounds.cap && n <= spare.cap;
terminates by n;
-> u64 {
    transition n > 0 {
        true -> outer(n - 1, spare)
        false -> n
    }
}
