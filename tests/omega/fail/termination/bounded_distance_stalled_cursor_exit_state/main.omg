// A bounded-distance loop with an exit state whose loop edge keeps the
// cursor where it was. The entry needs no `index <= limit`, but the arrival
// still owes a strict decrease.
machine fill(index: u64, limit: u64)
terminates by (index, limit) -> Nat::BoundedDistance;
{
    transition index < limit { true -> fill(index, limit) _ -> done() }
    machine done() { }
}
machine main() { fill(0, 4); }
