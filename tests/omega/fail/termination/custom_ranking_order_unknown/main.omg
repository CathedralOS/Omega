data Card {
    power: u64;
}

data Main {
}

machine Main::main(main: &mut Main) {
    let value: u64 = Main::weaken(main, 3);
}

machine Main::weaken(main: &mut Main, power: u64) -> u64
terminates by power -> Card::PowerOrder
{
    transition power > 0 {
        true -> weaken(main, power - 1)
        false -> power
    }
}
