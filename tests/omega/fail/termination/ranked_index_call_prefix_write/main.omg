machine reset_index(value: &mut u32) -> u64
ensures result == 0
{
    value = 9;
    0
}

machine countdown(values: &mut [u32; 2], remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(values, remaining) }
    machine scan(values: &mut [u32; 2], mut remaining: u32) -> u32
    requires remaining <= 9;
    {
        // The store misses remaining, but evaluating its index resets it.
        values[reset_index(&mut remaining)] = 0;
        transition remaining > 0 {
            true -> scan(values, remaining - 1)
            false -> remaining
        }
    }
}

machine main() {}
