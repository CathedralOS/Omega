// A decreasing raw difference does not preserve the view's fixed upper bound.
machine first(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance {
    transition index < limit {
        true -> second(index, limit - 1)
        false -> index
    }
}

machine second(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance {
    transition index < limit {
        true -> first(index, limit - 1)
        false -> index
    }
}
