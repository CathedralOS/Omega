// FAIL CANARY: a measured proof-only SCC must pass a strict case-payload
// subterm on every edge. Forwarding the ranking subject unchanged would admit
// an infinite proof computation and must reject.
data ProofNat {
    case Zero;
    case Succ(prev: ProofNat);
}

machine main() {}

machine left(n: ProofNat) -> ProofNat
terminates by n;
{
    right(n)
}

machine right(n: ProofNat) -> ProofNat
terminates by n;
{
    left(n)
}
