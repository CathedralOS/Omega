// FAIL CANARY. `items` is rebound between arrival and the call: the write
// `items = items[1..]` changes the produced length the authored ceiling
// names, so the entry-spelled endpoint `items.len` no longer denotes the
// transported input at the call site.
data Main {
    entries: [u64; 4];
}

machine Main::main(&mut self) -> u64 {
    let view: &[u64] = self.entries.as_slice();

    transition {
        _ -> self.outer(3, view)
    }
}

machine Main::outer(&mut self, remaining: u64, mut items: &[u64])
requires items.len >= remaining;
terminates by remaining in 0..=items.len;
-> u64 {
    items = items[1..];
    transition remaining > 0 {
        true -> self.inner(remaining - 1, items)
        false -> remaining
    }
}

machine Main::inner(&mut self, n: u64, bag: &[u64])
requires bag.len >= n;
terminates by n in 0..=bag.len;
-> u64 {
    transition n > 0 {
        true -> self.outer(n, bag)
        false -> n
    }
}
