data Countdown where remaining <= 5 { remaining: u64; }
data Bundle { held: Countdown; spare: Countdown; }
measure Countdown::Remaining(countdown: Countdown) -> u64 { countdown.remaining }

machine identity(value: Countdown) -> Countdown { value }

machine walk(countdown: Countdown)
terminates by countdown -> Countdown::Remaining in 0..=5;
-> u64 {
    transition {
        _ -> iterate(Bundle {
            held: identity(countdown),
            spare: Countdown { remaining: 4 }
        })
    }
    machine iterate(pending: Bundle) -> u64 {
        transition pending.spare.remaining > 0 {
            true -> iterate(Bundle {
                held: identity(pending.held),
                spare: Countdown { remaining: pending.spare.remaining - 1 }
            })
            false -> pending.held.remaining
        }
    }
}

machine main() {
    let result: u64 = walk(Countdown { remaining: 5 });
}
