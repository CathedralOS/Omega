// Each recursive occurrence needs its own classified tail edge.
machine first(remaining: u64, limit: u64)
terminates by remaining;
crashes Trap
{
    transition remaining > 0 { true -> step(remaining, limit) false -> base(limit) }
    machine step(remaining: u64, limit: u64) requires remaining > 0 {
        second(remaining, limit);
        transition { _ -> second(remaining, limit) }
    }
    machine base(limit: u64) {
        transition limit <= 10 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
machine second(remaining: u64, limit: u64)
terminates by remaining;
crashes Trap
{
    transition remaining > 0 { true -> step(remaining, limit) false -> base(limit) }
    machine step(remaining: u64, limit: u64) requires remaining > 0 {
        transition { _ -> first(remaining - 1, limit) }
    }
    machine base(limit: u64) {
        transition limit <= 10 { true -> done() false -> bad() }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
