// FAIL CANARY. A constant arithmetic tree folding to zero is still no
// decrement: `inner - (1 - 1)` preserves the component, so the scan_a/scan_b
// cycle keeps the shared rank forever.

data Progress {
    outer: u64;
    inner: u64;
}

measure Progress::Steps lexicographic { outer, inner }

data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition {
        _ -> Main::scan_a(main, Progress { outer: 1, inner: 8 })
    }
}

machine Main::scan_a(main: &mut Main, progress: Progress)
terminates by progress -> Progress::Steps;
-> u64
{
    transition progress.inner > 1 {
        true -> Main::scan_b(main, progress)
        false -> 0
    }
}

machine Main::scan_b(main: &mut Main, progress: Progress)
terminates by progress -> Progress::Steps;
-> u64
{
    transition progress.inner > 1 {
        true -> Main::scan_a(main, Progress {
            outer: progress.outer,
            inner: progress.inner - (1 - 1),
        })
        false -> 0
    }
}
