// Arrival facts do not survive an assignment to a mutable bound.
machine walk(index: u64, mut limit: u64) -> u64
requires index <= limit && limit <= 10
terminates by index -> Nat::IncreasingTo(limit) in 0..=(limit + 1)
{
    limit = 18446744073709551615;
    let endpoint: u64 = limit + 1;
    endpoint
}

machine main() -> u64 { walk(0, 4) }
