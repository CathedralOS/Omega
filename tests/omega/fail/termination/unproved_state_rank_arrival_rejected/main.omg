// An outgoing call may use a state's requires only because every incoming
// edge must establish it. Unconditionally entering hold does not prove > 0.
data Main {}

machine Main::count(remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition { _ -> hold(remaining) }
    machine hold(pending: u32) -> u32
    requires pending > 0 && pending <= 9
    {
        transition { _ -> Main::next(pending - 1) }
    }
}

machine Main::next(remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition { _ -> Main::count(remaining) }
}
