// Invalid: the selected implementation terminates, but another supplied one
// re-enters the ranked root. Psi checks every supplied implementation
// independently of target selection, so the unranked cycle through the
// unselected implementation is refused.
boundary trait Selection {
    machine selected() -> u64 reaches;
}
X86Selection satisfies Selection {
    machine selected() -> u64 { 17 }
}
ArmSelection satisfies Selection {
    machine selected() -> u64 { walk(0, 4) }
}
machine walk(index: u64, limit: u64) -> u64
terminates by (index, limit) -> Nat::BoundedDistance
{
    transition index < limit {
        true -> walk(index + 1, limit)
        _ -> done()
    }
    machine done() -> u64 { Selection::selected() }
}
machine x86_entry() crashes Trap {
    let tag: u64 = walk(0, 4);
    transition tag == 17 { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
