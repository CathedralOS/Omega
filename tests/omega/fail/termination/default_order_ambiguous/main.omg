data Main {}

machine Main::main(main: &mut Main) -> i32 {
    transition {
        _ -> Main::countdown(main, 2)
    }
}

machine Main::countdown(main: &mut Main, remaining: i32)
terminates by remaining;
-> i32
{
    transition remaining > 0 {
        true -> countdown(main, remaining - 1)
        false -> remaining
    }
}
