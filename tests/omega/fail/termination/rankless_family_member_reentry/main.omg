// Every supplied implementation contributes to recurrence, including one no
// target selects.
boundary trait Selection {
    machine selected() -> u32 reaches;
}
MacSelection satisfies Selection {
    machine selected() -> u32 { 37 }
}
LinuxSelection satisfies Selection {
    machine selected() -> u32 { count(0) }
}
machine count(remaining: u32) -> u32 terminates by remaining {
    transition remaining > 0 { true -> count(remaining - 1) false -> finish() }
    machine finish() -> u32 { Selection::selected() }
}
