// Every target member contributes to recurrence, including a non-host member.
macos_arm64 machine selected() -> u32 { 37 }
linux_x86_64 machine selected() -> u32 { count(0) }
machine count(remaining: u32) terminates by remaining; -> u32 {
    transition remaining > 0 { true -> count(remaining - 1) false -> finish() }
    machine finish() -> u32 { selected() }
}
