// TPR4 (decision 23): a bodyless requirement authors the PUBLIC guarantee
// with bare `terminates;` -- the ranking witness belongs to the
// IMPLEMENTATION that discharges the inherited claim, never to the
// requirement (there is no body to prove).
use omega_language_std::console;
trait Worker<W> {
    machine run(worker: &mut W, n: u64) -> u64 terminates by n;
}
data Main { }
machine Main::main(main: &mut Main) { Console::exit_process(70); }
