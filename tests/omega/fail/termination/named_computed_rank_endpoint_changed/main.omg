machine walk(remaining: u64 [0..=5], cap: u64 [0..=20])
terminates by remaining in 0..(cap / 5 + 6);
-> u64 {
    transition { _ -> iterate(cap, remaining) }
    state iterate(limit: u64 [0..=20], pending: u64 [0..=5]) {
        transition pending > 0 {
            true -> iterate(0, pending - 1)
            false -> pending
        }
    }
}

data Main {}
machine Main::main(&mut self) {}
