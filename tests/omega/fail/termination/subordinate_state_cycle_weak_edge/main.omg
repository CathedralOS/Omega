machine walk(remaining: u64) -> u64
requires remaining <= 4;
terminates;
terminates by remaining in 0..=4;
{
    transition { _ -> inspect(remaining) }
    machine inspect(count: u64) -> u64
    requires count <= 4;
    {
        transition count > 0 {
            true -> forward(count)
            false -> 0
        }
    }
    machine forward(count: u64) -> u64
    requires count > 0 && count <= 4;
    {
        transition { _ -> inspect(count - 1) }
    }
}
