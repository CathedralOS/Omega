// A readonly outer call or builtin addition cannot hide an inner exclusive
// write to the protected rank. Resetting to 9 before each step repeats 8.
trait RankWriter {
    machine replace(value: &mut u32) -> u32 terminates;
}

Resetting satisfies RankWriter {
    machine replace(value: &mut u32) -> u32 {
        value = 9;
        0
    }
}

trait RankKeeper {
    machine keep(value: u32) -> u32 terminates;
}

Keeping satisfies RankKeeper {
    machine keep(value: u32) -> u32 { value }
}

machine nested_countdown(selected: dyn RankWriter, keeper: dyn RankKeeper, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(selected, keeper, remaining) }
    machine scan(selected: dyn RankWriter, keeper: dyn RankKeeper, mut remaining: u32) -> u32
    requires remaining <= 9;
    {
        let observed: u32 = RankKeeper::keep(keeper, RankWriter::replace(selected, &mut remaining));
        transition remaining > 0 {
            true -> scan(selected, keeper, remaining - 1)
            false -> observed
        }
    }
}

machine composed_countdown(selected: dyn RankWriter, keeper: dyn RankKeeper, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(selected, keeper, remaining) }
    machine scan(selected: dyn RankWriter, keeper: dyn RankKeeper, mut remaining: u32) -> u32
    requires remaining <= 9;
    {
        let observed: u32 = RankWriter::replace(selected, &mut remaining) + 0;
        transition remaining > 0 {
            true -> scan(selected, keeper, remaining - 1)
            false -> observed
        }
    }
}

machine main() {
    let selected: dyn RankWriter = Resetting as dyn RankWriter;
    let keeper: dyn RankKeeper = Keeping as dyn RankKeeper;
    let nested: u32 = nested_countdown(selected, keeper, 4);
    let composed: u32 = composed_countdown(selected, keeper, 4);
}
