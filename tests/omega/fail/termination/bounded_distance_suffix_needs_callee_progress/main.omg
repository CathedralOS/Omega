// Empty invokes prevents re-entry; it supplies no termination guarantee.
// Local rank erasure must not establish this machine's published promise.
public boundary trait Output { machine emit_byte(byte: i32) reaches Output; }
public data Provider {}
boundary machine Provider::emit_byte(byte: i32) satisfies Output::emit_byte;
machine walk(index: u64, limit: u64)
terminates;
terminates by (index, limit) -> Nat::BoundedDistance;
reaches Output
{
    transition index < limit {
        true -> walk(index + 1, limit)
        _ -> done()
    }
    machine done() { Provider::emit_byte(10); }
}
machine program() reaches Output { walk(0, 4); }
