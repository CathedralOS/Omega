data Main { observed: u64; }

machine Main::main(&mut self) {}

machine Main::first(&mut self, remaining: u64 [0..=5], cap: u64 [0..=20])
terminates by remaining in 0..(cap / 5 + 6);
-> u64 {
    transition remaining > 0 {
        true -> self.second(0, remaining)
        false -> remaining
    }
}

machine Main::second(&mut self, limit: u64 [0..=20], pending: u64 [0..=5])
terminates by pending;
-> u64 {
    transition pending > 0 {
        true -> self.first(pending - 1, limit)
        false -> pending
    }
}
