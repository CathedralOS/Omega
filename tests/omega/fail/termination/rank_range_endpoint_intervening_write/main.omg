// FAIL CANARY. The pinned view bound `limit` is stored to before the
// transition. The endpoint is a premise carrier, so the store invalidates the
// invocation-fixed range even though the self-copy writes an in-range value.
data Main {}

machine Main::main(main: &mut Main) -> u64 {
    transition { _ -> Main::walk(main, 0, 4, 0) }
}

machine Main::walk(main: &mut Main, index: u64, mut limit: u64, mut count: u64) -> u64
requires index <= limit && 0 <= limit && limit <= 10
terminates by index -> Nat::IncreasingTo(limit) in 0..=(limit + 1) {
    limit = limit;
    transition index < limit && limit <= 10 {
        true -> walk(main, index + 1, limit, count)
        false -> count
    }
}
