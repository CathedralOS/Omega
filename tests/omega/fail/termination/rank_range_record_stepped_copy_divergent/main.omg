// FAIL CANARY. `second`'s literal is a computed non-step arrival, so it
// keeps its contested claim on the required `remaining` — but it transports
// the carrier's stale leaf `first.left`, not the step `first.left - 1`.
// The copies are held equal only while every arrival agrees, and this one
// does not.
data Pair { left: u32 [0..=5]; }

machine walk(remaining: u32 [0..=5])
terminates by remaining in 0..=5;
-> u32 {
    transition { _ -> s(Pair { left: remaining }, Pair { left: remaining }) }
    state s(first: Pair, second: Pair) {
        transition first.left > 0 {
            true -> s(Pair { left: first.left - 1 }, Pair { left: first.left })
            false -> first.left
        }
    }
}
