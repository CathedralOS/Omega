machine first(remaining: u64) -> bool
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> false }
    machine step(remaining: u64) -> bool requires remaining > 0 {
        transition second(remaining) { true -> second(remaining) false -> false }
    }
}
machine second(remaining: u64) -> bool
terminates by remaining;
{
    transition remaining > 0 { true -> step(remaining) false -> false }
    machine step(remaining: u64) -> bool requires remaining > 0 {
        transition { _ -> first(remaining - 1) }
    }
}
