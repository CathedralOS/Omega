// An exclusive requirement argument invalidates the protected rank premise.
// Resetting the rank to 9 before each step repeats 8 instead of decreasing.
trait RankWriter {
    machine replace(value: &mut u32) -> u32 terminates;
}

Resetting satisfies RankWriter {
    machine replace(value: &mut u32) -> u32 {
        value = 9;
        0
    }
}

machine countdown(selected: dyn RankWriter, remaining: u32) -> u32
requires remaining <= 9;
terminates by remaining in 0..=9;
{
    transition { _ -> scan(selected, remaining) }
    machine scan(selected: dyn RankWriter, mut remaining: u32) -> u32
    requires remaining <= 9;
    {
        let observed: u32 = RankWriter::replace(selected, &mut remaining);
        transition remaining > 0 {
            true -> scan(selected, remaining - 1)
            false -> observed
        }
    }
}

machine main() {
    let selected: dyn RankWriter = Resetting as dyn RankWriter;
    let result: u32 = countdown(selected, 4);
}
