// Invalid: an unselected supplied implementation re-enters its caller through a
// non-tail call. Every supplied implementation is checked whatever Build selects,
// so the cycle owes a tail edge it does not have.
boundary trait Selection {
    machine selected(n: u64) -> u64 reaches;
}
X86Selection satisfies Selection {
    machine selected(n: u64) -> u64 { 17 }
}
ArmSelection satisfies Selection {
    machine selected(n: u64) -> u64 { again(n) }
}
machine again(n: u64) -> u64 reaches {
    let x: u64 = Selection::selected(n);
    x
}
machine x86_entry() crashes Trap {
    let tag: u64 = again(0);
    transition tag == 17 { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
