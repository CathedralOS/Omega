// FAIL CANARY. The ranking descends, but an attached/runtime SCC cannot keep
// caller frames alive. The same structural non-tail shape is accepted for
// free proof-only machines by the proof-stratum companion canary.
// Negation consumes each returned value without an unrelated overflow premise.
data Main {}

machine Main::main(main: &mut Main) -> bool {
    transition { _ -> Main::left(main, 4) }
}

machine Main::left(main: &mut Main, remaining: u64) -> bool
terminates by remaining
{
    transition remaining > 0 {
        true -> (!Main::right(main, remaining - 1))
        false -> false
    }
}

machine Main::right(main: &mut Main, remaining: u64) -> bool
terminates by remaining
{
    transition remaining > 0 {
        true -> (!Main::left(main, remaining - 1))
        false -> false
    }
}
