// FAIL CANARY. `[0..=200] * 2` fits the authored range `0..=400` but not the
// `u8` carrier the measure produces: membership in the range is not formation,
// and the entry judgment must prove both from the subject's bounds.
data Countdown {}

measure Countdown::Doubled(value: u8) -> u8 { value * 2 }

machine walk(remaining: u8 [0..=200])
terminates by remaining -> Countdown::Doubled in 0..=400;
-> u8 {
    transition remaining > 0 {
        true -> walk(remaining - 1)
        false -> remaining
    }
}
