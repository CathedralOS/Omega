data Countdown { remaining: u64; }
measure Countdown::Remaining(value: Countdown) -> u64 { value.remaining }

machine walk(mut value: Countdown) -> u64
requires value.remaining <= 5;
terminates by value -> Countdown::Remaining in 0..=5;
{
    let ready: bool = value.remaining > 0;
    value.remaining = 0;
    transition ready {
        true -> walk(Countdown { remaining: value.remaining - 1 })
        false -> value.remaining
    }
}
