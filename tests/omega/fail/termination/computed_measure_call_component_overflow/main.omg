// FAIL CANARY. `scan_b`'s `[0..=200] * 2` fits its authored range `0..=400`
// but not the `u8` carrier the measure produces, so the member's initial
// rank is unproven and the component has no shared ranking.
data Countdown {}

measure Countdown::Doubled(value: u8) -> u8 { value * 2 }

data Main {}

machine Main::main(&mut self) -> u8 {
    transition { _ -> self.scan_a(100) }
}

machine Main::scan_a(&mut self, remaining: u8 [0..=100])
terminates by remaining -> Countdown::Doubled in 0..=200;
-> u8 {
    transition remaining > 0 {
        true -> self.scan_b(remaining)
        false -> remaining
    }
}

machine Main::scan_b(&mut self, pending: u8 [0..=200])
terminates by pending -> Countdown::Doubled in 0..=400;
-> u8 {
    transition pending > 0 {
        true -> self.scan_a(pending - 1)
        false -> pending
    }
}
