// FAIL CANARY. The component judgment witnesses cross-machine call edges
// only; a member's internal arrivals stay with its own ranking judgment.
// `hold(pending)` loops back with the rank unchanged, so `count(3)` really
// does stall inside `hold` even though the `step -> count(n - 1)` edge is
// strict.

data Main {}

machine Main::main(&mut self) -> u32 {
    transition { _ -> self.count(5) }
}

machine Main::count(&mut self, remaining: u32 [0..=9])
terminates by remaining in 0..=9;
-> u32 {
    transition remaining > 0 { true -> hold(remaining) false -> remaining }

    state hold(pending: u32 [0..=9]) {
        transition pending > 5 { true -> self.step(pending) false -> hold(pending) }
    }
}

machine Main::step(&mut self, n: u32 [0..=9])
terminates by n in 0..=9;
-> u32 {
    transition n > 0 { true -> self.count(n - 1) false -> n }
}
