// A stored field named len is not collection metadata. The unranged member
// changes the ranged member's endpoint, despite decreasing the scalar rank.
data Cells where len >= 4 && len <= 10 { len: u64; bytes: [u8; 4]; }

machine ranged(cells: Cells, remaining: u64) -> u64
requires remaining <= cells.len;
terminates by remaining -> Nat::Descending in 0..=cells.len;
{
    transition remaining > 0 {
        true -> unranged(cells, remaining - 1)
        false -> remaining
    }
}

machine change_length(cells: &mut Cells) -> u8 {
    cells.len = 5;
    7
}

machine unranged(mut cells: Cells, remaining: u64) -> u64
requires remaining <= cells.len;
terminates by remaining -> Nat::Descending;
{
    // The element store preserves the array's extent, but its operand call
    // does not preserve the separate endpoint. Restoring a bounded value
    // does not restore the entry-relative observation.
    cells.bytes[0] = change_length(&mut cells);
    cells.len = 4;
    transition remaining > 0 && remaining <= cells.len {
        true -> ranged(cells, remaining - 1)
        false -> remaining
    }
}
