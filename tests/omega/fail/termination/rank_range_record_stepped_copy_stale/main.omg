// A bounded snapshot may be returned after the live measure decreases, but
// it cannot reset the cyclic measure on a recurrent edge. The finishing
// state reenters s with the old snapshot instead of completing the walk.
data Pair { left: u32 [0..=5]; }

machine walk(remaining: u32 [0..=5])
terminates by remaining in 0..=5;
-> u32 {
    transition { _ -> s(Pair { left: remaining }, remaining) }
    state s(pair: Pair, copy: u32 [0..=5]) {
        transition pair.left > 0 {
            true -> s(Pair { left: pair.left - 1 }, copy)
            false -> finish(copy)
        }
    }
    state finish(result: u32 [0..=5]) {
        transition { _ -> s(Pair { left: result }, result) }
    }
}
