// The state requires a positive step, but the prefix overwrites that input.
// Reading the arrival fact after the store would "prove" a nondecreasing cycle.
data Main {}

machine Main::count(remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition remaining > 0 {
        true -> hold(1, remaining)
        false -> remaining
    }
    machine hold(mut step: u32, pending: u32) -> u32
    requires step == 1 && pending > 0 && pending <= 9
    {
        step = 0;
        transition { _ -> Main::next(pending - step) }
    }
}

machine Main::next(remaining: u32)
terminates by remaining in 0..=9;
-> u32
requires remaining <= 9
{
    transition { _ -> Main::count(remaining) }
}
