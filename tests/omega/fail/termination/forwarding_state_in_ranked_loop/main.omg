// A guard state inside a ranked loop forwards `index` unchanged. Decision 23
// requires every transition inside the loop to decrease the rank, so the
// refusal names the forwarding transition.
machine argmax(items: &[i32; 5], index: u64, best: u64) -> u64
requires best < 5
terminates by index -> Nat::IncreasingTo(5);
{
    transition index < 5 {
        true -> step(items, index, best)
        false -> best
    }
    state step(items: &[i32; 5], index: u64, best: u64) requires index < 5, best < 5 {
        transition items[index] > items[best] {
            true -> argmax(items, index + 1, index)
            false -> argmax(items, index + 1, best)
        }
    }
}
machine main() {
    let items: [i32; 5] = [4, -2, 17, 9, 17];
    let found: u64 = argmax(&items, 0, 0);
}
