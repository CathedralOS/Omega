// A descending rank over unrestricted u64 is not bounded by 100. The one
// literal caller does not establish the private body's input contract.
use omega::language::std::console;
data Main { console: Console; }
machine Main::countdown(&mut self, n: u64) -> u64
terminates by n in 0..=100;
{
    transition n > 0 {
        true -> self.countdown(n - 1)
        false -> 0
    }
}
machine Main::main(&mut self) {
    let value: u64 = self.countdown(3);
    self.console.exit_process(70);
}
