// This rank-free state is recurrent through an ordinary terminal tail call.
// The zero-rank cycle bypasses the other member's strict descent.
machine left(remaining: u64)
terminates by remaining in 0..=9;
-> u64
requires remaining <= 9
{
    transition remaining > 0 {
        true -> right(remaining)
        false -> finish()
    }
    machine finish() -> u64 { left(0) }
}

machine right(remaining: u64)
terminates by remaining in 0..=9;
-> u64
requires remaining > 0 && remaining <= 9
{
    transition { _ -> left(remaining - 1) }
}

machine main() {
    let observed: u64 = left(0);
}
