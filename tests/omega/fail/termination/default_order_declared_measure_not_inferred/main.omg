data Card {
    power: u64;
}

measure Card::PowerOrder(card: Card) -> u64 { card.power }

data Main {
}

machine Main::main(main: &mut Main) {
    let value: u64 = Main::weaken(main, Card { power: 3 });
}

machine Main::weaken(main: &mut Main, card: Card)
terminates by card;
-> u64
{
    transition card.power > 0 {
        true -> weaken(main, Card { power: card.power - 1 })
        false -> card.power
    }
}
