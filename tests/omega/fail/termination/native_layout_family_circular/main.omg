boundary trait SelectedSelectedFamily {
    machine selected_family<T>(value: u64) -> u64 reaches
terminates;
}
CheckedSelectedFamily satisfies SelectedSelectedFamily {
    machine selected_family<T>(value: u64) -> u64 terminates;
{ CheckedSelectedFamily::selected_family<T>(value) }
}



machine checked_caller(value: u64) -> u64 terminates; { SelectedSelectedFamily::selected_family<u64>(value) }
machine main() {}
