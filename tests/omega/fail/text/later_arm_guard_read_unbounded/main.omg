// A later arm's guard reads `text[index]`, but no earlier arm bounds `index`:
// refuting `flag` says nothing about the slice, so the read is rejected.
machine at_space(text: &[u8], index: u64, flag: bool) -> bool {
    transition {
        flag -> (false)
        text[index] == 32 -> (true)
        _ -> (false)
    }
}

machine main() -> bool {
    transition { _ -> (at_space("a b", 1, false)) }
}
