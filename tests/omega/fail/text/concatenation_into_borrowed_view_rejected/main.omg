// A concatenation establishes owned bytes in fresh activation storage. That
// result may replace a bounded owner or field, but it never becomes a borrowed
// view (wiki/spec/terminal-psi/structural_access.md,
// `EstablishByteSequenceConcatenation`): `out_line` is a `&[u8] in Utf8` view
// with no capacity to bound the operands and no storage to hold the result.
// Checking rejects the store. The valid spelling stores the concatenation into
// a bounded `[u8; N] in Utf8` carrier whose capacity bounds both operands, as
// `pass/text/runtime_text_builder` does.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Room [copy] {
    label: &[u8] in Utf8;
}

data Main {
    source: Room;
}

machine Main::main(main: &mut Main) reaches Console {
    main.source.label = "Gate";

    transition {
        _ -> render(main)
    }

    state render(main: &mut Main) {
        let room: Room;
        let mut out_line: &[u8] in Utf8;

        room.label = main.source.label;
        out_line = "== " + room.label;

        transition out_line == "== Gate" {
            true -> good(main)
            false -> bad(main)
        }
    }

    state good(main: &mut Main) {
        Console::exit_process(193);
    }

    state bad(main: &mut Main) {
        Console::exit_process(194);
    }
}
