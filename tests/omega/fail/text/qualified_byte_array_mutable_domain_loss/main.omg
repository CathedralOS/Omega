// A mutable element loan cannot weaken the owner's encoding promise.
domain [u8; 2]::Utf8 requires valid_utf8(self);
domain [u8; 2]::Ascii requires ascii_only(self);
machine replace(bytes: &mut [u8; 2] in Utf8) -> bool { bytes = "é"; true }
machine bad(entries: &mut [[u8; 2] in Ascii; 2]) -> bool {
    replace(&mut entries[1])
}
