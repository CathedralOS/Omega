// The concat-domain law admits `self.line + "omega"` into the Utf8 domain (both
// operands are valid UTF-8, and UTF-8 is concat-preserving), so the DOMAIN half
// of the write is established. The LENGTH-FITS guard then rejects it: a `[u8; 16]`
// carrier receives a proven 13-byte value, and appending 5 more reaches 18 --
// beyond the 16-byte inline storage. This is the no-overflow theorem for bounded
// text carriers: the checker follows the straight-line running length, admits a
// chain that still fits, and rejects the first write that provably cannot fit.
domain [u8; 16]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Main {
    console: Console;
    line: [u8; 16] in Utf8;
}

machine Main::main(&mut self) {
    self.line = "1234567890123";
    self.line = self.line + "omega";
    self.console.exit_process(70);
}
