domain [u8]::SnapshotUtf8(bytes) requires valid_utf8(bytes);
machine copy(short: &[u8] in SnapshotUtf8, other: &[u8] in SnapshotUtf8,
    output: &mut Buffer16)
crashes Trap
requires short.len <= 16 {
    let mut observed: &[u8] in SnapshotUtf8 = short;
    observed = other;
    output = Buffer16::snapshot(observed);
}

// Explicit fixed capacity and live-prefix length; qualification belongs to the checked view.
data Buffer16 [copy] where used <= 16 { storage: [u8; 16]; used: u64; }
machine Buffer16::view(buffer: &Buffer16) -> &[u8] in SnapshotUtf8 crashes Trap {
    let bytes: &[u8] = &buffer.storage[..buffer.used];
    transition valid_utf8(bytes) {
        true -> checked(bytes)
        false -> bad()
    }
    state checked(bytes: &[u8] in SnapshotUtf8) -> &[u8] in SnapshotUtf8 { bytes }
    state bad() { crash Trap; }
}
machine Buffer16::equal(buffer: &Buffer16, expected: &[u8]) -> bool crashes Trap {
    let bytes: &[u8] in SnapshotUtf8 = Buffer16::view(buffer);
    bytes == expected
}

machine Buffer16::copy(storage: &mut [u8; 16], bytes: &[u8], start: u64)
requires start <= 16; bytes.len <= 16 - start {
    transition { _ -> copying(storage, bytes, start, 0) }
    state copying(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index <= 16 {
        transition index < bytes.len && start + index < 16 {
            true -> writing(storage, bytes, start, index)
            _ -> done()
        }
    }
    state writing(storage: &mut [u8; 16], bytes: &[u8], start: u64, index: u64)
    requires start <= 16; index < 16; index < bytes.len; start + index < 16 {
        storage[start + index] = bytes[index];
        transition { _ -> copying(storage, bytes, start, index + 1) }
    }
    state done() {}
}
machine Buffer16::join(left: &[u8], right: &[u8]) -> Buffer16 crashes Trap {
    transition left.len <= 16 && right.len <= 16 - left.len {
        true -> joining(left, right)
        _ -> bad()
    }
    state joining(left: &[u8], right: &[u8]) -> Buffer16
    requires left.len <= 16; right.len <= 16 - left.len {
    let mut result: Buffer16;
    Buffer16::copy(&mut result.storage, left, 0);
    Buffer16::copy(&mut result.storage, right, left.len);
    let total: u64 = left.len + right.len;
    transition total <= 16 {
        true -> checked(result, total)
        _ -> bad()
    }
    }
    state checked(result: Buffer16, total: u64) -> Buffer16
    requires total <= 16 {
        let mut value: Buffer16 = result;
        value.used = total;
        value
    }
    state bad() { crash Trap; }
}

machine Buffer16::snapshot(text: &[u8] in SnapshotUtf8) -> Buffer16
crashes Trap
requires text.len <= 16 { Buffer16::join("", text) }
