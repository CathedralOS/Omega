// A guard over `text[index]` says nothing about `text[other]`: the element
// key names the index, so the subtraction on another element stays unproven.
machine digit(text: &[u8], index: u64, other: u64) -> u8 {
    transition {
        index >= text.len || other >= text.len -> (0)
        text[index] < 48 -> (0)
        _ -> (text[other] - 48)
    }
}

machine main() -> u8 {
    transition { _ -> (digit("42", 0, 1)) }
}
