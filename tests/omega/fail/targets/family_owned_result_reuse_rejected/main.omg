// A family return transfers one owner; dispatch cannot make it reusable.
use omega::language::core::drop;
data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}

linux_x86_64 machine produce() -> Receipt { Receipt { code: 42 } }
windows_x86_64 machine produce() -> Receipt { Receipt { code: 42 } }
linux_arm64 machine produce() -> Receipt { Receipt { code: 42 } }
macos_arm64 machine produce() -> Receipt { Receipt { code: 42 } }

machine main() {
    let receipt: Receipt = produce();
    drop(receipt);
    drop(receipt);
}
