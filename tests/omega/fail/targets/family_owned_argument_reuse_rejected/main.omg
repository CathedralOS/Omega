// The portable family head consumes the caller's owned claim exactly once.
use omega::language::core::drop;

data Receipt [linear] { code: i32; }
machine Receipt::drop(receipt: &mut Receipt) {}

linux_x86_64 machine Receipt::consume(receipt: Receipt) { drop(receipt); }
macos_arm64 machine Receipt::consume(receipt: Receipt) { drop(receipt); }

machine main() {
    let receipt: Receipt = Receipt { code: 12 };
    Receipt::consume(receipt);
    Receipt::consume(receipt);
}
