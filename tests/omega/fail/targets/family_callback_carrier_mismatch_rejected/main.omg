linux_arm64 machine choose<machine Selected>(value: u64) -> bool
requires machine Selected(argument: u64) -> bool;
{ Selected(value) }

macos_arm64 machine choose<machine Callback>(value: u64) -> bool
requires machine Callback(argument: bool) -> bool;
{ Callback(true) }

// No call is needed to expose an incompatible retained declaration.
machine main() {}
