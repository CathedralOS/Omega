// An unrequested body still owes its explicitly declared trait obligation.
trait Number<T> { machine value(value: &T) -> u32; }
trait Predicate<T> { machine value(value: &T) -> bool; }
data Helper { seed: u32; }

linux_x86_64 machine Helper::value(value: &Helper) -> u32
satisfies Number<Helper>::value { 7 }
reserved_target machine Helper::value(value: &Helper) -> u32
satisfies Predicate<Helper>::value { 7 }

machine main() { }
