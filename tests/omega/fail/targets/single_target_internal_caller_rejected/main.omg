// A portable caller demands a body that only UEFI supplies. A development
// host's realization must refuse the call, never silently omit its operation.
// The same-target positive control retains a UEFI caller and helper without
// demanding their realization. This control currently pins the early refusal;
// moving it to Omega realization remains part of the target-family outcome.
use omega_language_std::console;

data Helper { seed: i32; }

uefi_x86_64 machine Helper::paradigm_internal() -> i32 {
    transition { _ -> 63 }
}

data Main { helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = Helper::paradigm_internal();
    transition a == 63 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code2: i32) { Console::exit_process(code2); }
}
