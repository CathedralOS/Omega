// Every body implements the family's one callable signature, even when the
// requested target neither selects nor calls the incompatible member.
data Helper { seed: u32; }

boundary trait SelectedHelperValue {
    machine value(helper: &Helper) -> u32 reaches
;
}
LinuxX8664HelperValue satisfies SelectedHelperValue {
    machine value(helper: &Helper) -> u32
{
    transition { _ -> 63 }
}
}

MacosArm64HelperValue satisfies SelectedHelperValue {
    machine value(helper: &Helper) -> u32
{
    transition { _ -> 7 }
}
}

uefi_x86_64 machine Helper::value(helper: &Helper) -> bool {
    transition { _ -> true }
}

machine main() { }
