// The reach half of the inert-sibling rule. The bound entry does not call the
// foreign-only family itself: it calls a portable relay that does. The relay
// is reached from the realized entry, so its call demands a body this hosted
// realization does not have and rejects, naming the relay as the caller. The
// family has bodies for two targets the build never realizes, so the refusal
// names both. `pass/targets/unreached_foreign_body_caller_exit` keeps the same
// relay shape without a reaching call.
use omega_language_std::console;

data Helper { seed: i32; }

macos_x86_64 machine Helper::firmware_only(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}
uefi_x86_64 machine Helper::firmware_only(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}

machine Helper::relay(helper: &Helper) -> i32 {
    transition { _ -> (Helper::firmware_only(helper)) }
}

data Main { helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = Helper::relay(&main.helper);
    transition a == 63 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main, code2: i32) { Console::exit_process(code2); }
}
