// Deployable target-filter canary: every hosted target selects its exact
// entry, so the inert-sibling rejection is the same on each of them. The
// rule refuses only calls the selected entry reaches, so the canary needs a
// real application root rather than a bare `--check`. The inert callee is
// declared by the `paradigm_internals` dependency package, not this root.

machine build(builder: &mut Build) {
    Build::application(builder, "single_target_internal_package_statement_caller_rejected");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::depend(builder, Source::Path { location: "../../../../../tests/omega/packages/paradigm-internals" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
