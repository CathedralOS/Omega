machine yes() -> bool ensures result { true }

linux_arm64 machine choose<machine Selected>() -> bool
where machine Selected() -> bool ensures result;
{ Selected() }

macos_arm64 machine choose<machine Callback>() -> bool
where machine Callback() -> bool ensures !result;
{ Callback() }

// This selection supplies the first member's guarantee, not the second's.
// Portable admission must reject before realizing either member.
machine main() { let value: bool = choose<yes>(); }
