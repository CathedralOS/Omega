// The same checked portable interface is valid source, but every bound hosted
// realization lacks its exact member. Never substitute the firmware body.
data Firmware {}
uefi_x86_64 machine Firmware::read() -> u64 { 42 }

data Main {}
machine Main::main(main: &mut Main) {
    let value: u64 = Firmware::read();
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
