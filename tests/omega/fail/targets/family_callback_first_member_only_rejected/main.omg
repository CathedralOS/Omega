machine narrow(value: u64) -> bool requires value <= 64 { value == 42 }

linux_arm64 machine choose<machine Selected>(value: u64) -> bool
requires machine Selected(argument: u64) -> bool requires argument <= 64;
requires value <= 64
{ Selected(value) }

macos_arm64 machine choose<machine Callback>(value: u64) -> bool
requires machine Callback(argument: u64) -> bool requires argument <= 128;
requires value <= 128
{ Callback(value) }

// Satisfying the copied head's first demand is insufficient, even though
// this particular value would also meet the callback's narrower premise.
machine main() { let result: bool = choose<narrow>(42); }
