machine narrow(value: u64) -> bool requires value <= 64 { value == 42 }

linux_arm64 machine choose<machine Selected>(value: u64) -> bool
requires machine Selected(argument: u64) -> bool requires argument <= 64;
requires value <= 64
{ Selected(value) }

macos_arm64 machine choose<machine Callback>(value: u64) -> bool
requires machine Callback(argument: u64) -> bool requires argument <= 128;
requires value <= 128
{ Callback(value) }

// An open forwarding body must discharge every member's demand, not wait
// for one concrete specialization to accidentally exercise the discrepancy.
machine forward<machine Forward>(value: u64) -> bool
requires machine Forward(argument: u64) -> bool requires argument <= 64;
requires value <= 64
{ choose<Forward>(value) }

machine main() { let result: bool = forward<narrow>(42); }
