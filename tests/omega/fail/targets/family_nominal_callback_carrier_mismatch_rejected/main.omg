trait Handler<Value> { machine call(value: Value) -> bool; }

linux_arm64 machine choose<machine Selected>() -> bool
requires machine Selected satisfies Handler<u64>::call;
{ Selected(42u64) }

macos_arm64 machine choose<machine Callback>() -> bool
requires machine Callback satisfies Handler<bool>::call;
{ Callback(true) }

// The trait declaration is identical, but its applied argument carriers
// differ. Even an unreachable family must not publish that false telescope.
machine main() {}
