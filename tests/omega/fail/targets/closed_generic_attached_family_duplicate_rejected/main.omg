data Cell<Value [copy]> [copy] { value: Value; code: u64; }

linux_x86_64 machine Cell::read<Value [copy]>(cell: &Cell<Value>) -> u64 { cell.code }
linux_x86_64 machine Cell::read<Value [copy]>(cell: &Cell<Value>) -> u64 { 7 }

data Main { narrow: Cell<u32>; wide: Cell<u64>; }
machine Main::main(main: &mut Main) {
    let narrow: u64 = Cell::read(&main.narrow);
    let wide: u64 = Cell::read(&main.wide);
}
