trait Handler<Value> { machine call() -> bool; }
machine yes() -> bool satisfies Handler<u64>::call { true }

linux_arm64 machine choose<machine Selected>() -> bool
requires machine Selected satisfies Handler<u64>::call;
{ Selected() }

macos_arm64 machine choose<machine Callback>() -> bool
requires machine Callback satisfies Handler<bool>::call;
{ Callback() }

// Equal carriers and a first-member satisfaction do not grant the non-first
// member's distinct applied authority, even for a phantom trait argument.
machine main() { let answer: bool = choose<yes>(); }
