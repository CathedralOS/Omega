trait Handler { machine call() -> bool; }

// The provider requires an intermediate callable that accepts arbitrary
// structural leaves. A caller may only have an intermediate callable whose
// leaves require Handler::call, so this provider strengthens the outer input.
machine incompatible<machine Middle>() -> bool
where machine Middle<machine Leaf>() -> bool
where machine Leaf() -> bool;
{ true }

linux_arm64 machine choose<machine Selected>() -> bool
where machine Selected<machine Intermediate>() -> bool
where machine Intermediate<machine Inner>() -> bool
where machine Inner satisfies Handler::call;
{ true }

macos_arm64 machine choose<machine Callback>() -> bool
where machine Callback<machine Other>() -> bool
where machine Other<machine Nested>() -> bool
where machine Nested satisfies Handler::call;
{ true }

machine main() { let answer: bool = choose<incompatible>(); }
