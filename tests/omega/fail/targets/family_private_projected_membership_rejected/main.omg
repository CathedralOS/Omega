// A selected member's qualified local is not a public result promise.
use omega::language::core::drop;

data Receipt [linear] { code: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
domain Receipt::Positive requires self.code > 0;
data Slot { receipt: Receipt; }

linux_x86_64 machine produce() -> Slot {
    let private: Receipt in Receipt::Positive = Receipt { code: 42 };
    Slot { receipt: private }
}
macos_arm64 machine produce() -> Slot {
    let private: Receipt in Receipt::Positive = Receipt { code: 42 };
    Slot { receipt: private }
}

machine main() {
    let slot: Slot = produce();
    let receipt: Receipt in Receipt::Positive = slot.receipt;
    drop(receipt);
}
