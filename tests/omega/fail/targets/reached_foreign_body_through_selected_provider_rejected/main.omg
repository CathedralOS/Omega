// Provider dispatch is reach. The entry calls only the boundary requirement
// `Value::read`; the build selects the portable `RelayValue` provider, whose
// body calls a UEFI-only machine. A hosted realization installs that provider,
// so the call demands a body the target does not have and rejects, naming the
// provider as the caller. `pass/targets/unreached_foreign_body_caller_exit`
// keeps the same provider shape unselected.
use omega_language_std::console;

data Helper { seed: i32; }

uefi_x86_64 machine Helper::firmware_only(input: i32) -> i32 {
    transition { _ -> 63 }
}

pub data Value {}
pub boundary requirement Value::read(input: i32) -> i32;

pub data RelayValue {}
machine RelayValue::read(input: i32) -> i32
satisfies Value::read { Helper::firmware_only(input) }

data Main { }

machine Main::main(main: &mut Main) reaches Console {
    let selected: i32 = Value::read(70);
    Console::exit_process(selected);
}
