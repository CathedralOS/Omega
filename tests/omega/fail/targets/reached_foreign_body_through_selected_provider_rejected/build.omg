// Deployable target-filter canary: every hosted target selects its exact
// entry, so the refusal is the same on each of them. Only a realized entry
// demands an implementation, so the canary needs a real application root
// rather than a bare `--check`.

machine build(builder: &mut Build) {
    Build::application(builder, "reached_foreign_body_through_selected_provider_rejected");
    Build::select_provider<Value::read, RelayValue>(builder, linux_arm64);
    Build::select_provider<Value::read, RelayValue>(builder, linux_x86_64);
    Build::select_provider<Value::read, RelayValue>(builder, macos_arm64);
    Build::select_provider<Value::read, RelayValue>(builder, macos_x86_64);
    Build::select_provider<Value::read, RelayValue>(builder, windows_x86_64);
    Build::select_provider<Value::read, RelayValue>(builder, uefi_x86_64);
    Build::select_provider<Value::read, RelayValue>(builder, cross_platform_cli);
    Build::select_provider<Value::read, RelayValue>(builder, local_unchecked);
    Build::select_provider<Value::read, RelayValue>(builder, alpha_bootstrap);
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
}
