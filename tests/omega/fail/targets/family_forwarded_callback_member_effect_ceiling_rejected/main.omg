public machine may_block(value: u64) -> bool blocks; { value == 42 }

linux_arm64 machine choose<machine Selected>(value: u64) -> bool
where machine Selected(argument: u64) -> bool blocks;
requires true
blocks;
{ block Selected(value) }

macos_arm64 machine choose<machine Callback>(value: u64) -> bool
where machine Callback(argument: u64) -> bool;
{ Callback(value) }

machine forward<machine Forward>(value: u64) -> bool
where machine Forward(argument: u64) -> bool blocks;
requires true
blocks;
{ block choose<Forward>(value) }

machine main() blocks; { let result: bool = block forward<may_block>(42); }
