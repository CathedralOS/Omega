// The portable relay head has no body to walk. Its selected macOS member calls
// an ordinary bridge, which demands a missing firmware body. Other members do
// not reach that bridge; a Windows realization remains usable.
data Firmware {}
uefi_x86_64 machine Firmware::read() -> u64 { 7 }

machine bridge() -> u64 { Firmware::read() }

data Relay {}
windows_x86_64 machine Relay::read() -> u64 { 17 }
linux_x86_64 machine Relay::read() -> u64 { 17 }
linux_arm64 machine Relay::read() -> u64 { 17 }
macos_arm64 machine Relay::read() -> u64 { bridge() }

data Main {}
machine Main::main(main: &mut Main) {
    let value: u64 = Relay::read();
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
