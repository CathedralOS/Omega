// A target-scoped body is checked in every compilation. `darwin_poll` was a
// macOS std leaf no loaded declaration provides any longer, so this call
// resolves to nothing. The refusal names the call instead of reporting an
// anonymous incomplete crash envelope for `pace`.
use omega_language_std::Console;

macos_arm64 machine pace(timeout: i32)
reaches ClockObservation + ExecutionDelay
{
    let status: i32 = darwin_poll(0, 0, timeout);
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
