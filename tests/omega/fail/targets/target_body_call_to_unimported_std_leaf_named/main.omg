// A target-scoped body is checked in every compilation. std's `darwin_poll`
// leaf lives in its macOS implementation module, which `macos_gui` does not
// re-export, so this call selects no declaration. The refusal names the call
// instead of reporting an anonymous incomplete crash envelope for `pace`.
use omega_language_std::console;
use omega_language_std::macos_gui;

macos_arm64 machine pace(timeout: i32)
reaches ClockObservation + ExecutionDelay
{
    let status: i32 = darwin_poll(0, 0, timeout);
}

data Main { }
machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
