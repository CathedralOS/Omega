trait Handler<Value> { machine call() -> bool; }

machine incompatible<machine Nested>() -> bool
requires machine Nested satisfies Handler<bool>::call;
{ true }

linux_arm64 machine choose<machine Selected>() -> bool
requires machine Selected<machine Inner>() -> bool
requires machine Inner satisfies Handler<u64>::call;
;
{ true }

macos_arm64 machine choose<machine Callback>() -> bool
requires machine Callback<machine Other>() -> bool
requires machine Other satisfies Handler<bool>::call;
;
{ true }

// Even an unused generic operand must admit the complete argument tuple.
// The supplied higher-order body cannot accept the first member's nested
// Handler<u64> authority merely because Handler<bool> has the same carrier.
machine main() { let answer: bool = choose<incompatible>(); }
