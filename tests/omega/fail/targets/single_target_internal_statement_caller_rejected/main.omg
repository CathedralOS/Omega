// The STATEMENT-call half of the inert-sibling rule. Its value-call sibling,
// `single_target_internal_caller_rejected`, binds the result
// (`let a: i32 = main.helper.paradigm_internal();`); this one discards it and
// calls as an ordinary statement, which walks a different arm of
// `target_machines.rs::reject_reached_inert_sibling_calls` -- that pass
// walks statement AND expression calls, and only the expression arm had a
// command-level fixture.
//
// Same rule: a target-scoped machine implemented by exactly ONE non-selected
// target is that target's paradigm internal, dropped with its callers. A
// SURVIVING portable caller is not filtered, so its call names a body this
// build never realizes and must reject loudly rather than compile around the
// hole.
//
// `uefi_x86_64` is the scope for the reason the sibling records: a name that
// resolves to no real target (`demo_target`) is dropped before resolution and
// fails as an ordinary unresolved name, never reaching this rule. Only a real
// profile that is nobody's development host produces an inert sibling that
// SURVIVES into typed trees.
use omega_language_std::console;

data Helper { seed: i32; }

uefi_x86_64 machine Helper::record_paradigm_event() {
    transition { _ -> done() }
    state done() { }
}

data Main { helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    Helper::record_paradigm_event();
    Console::exit_process(70);
}
