// Deployable target-filter canary: every hosted target selects its exact
// entry, so the inert-sibling rejection is the same on each of them. The
// rule runs at the end of product-target selection, so the canary needs a
// real application root rather than a bare `--check`.

machine build(builder: &mut Build) {
    Build::application(builder, "single_target_internal_statement_caller_rejected");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
