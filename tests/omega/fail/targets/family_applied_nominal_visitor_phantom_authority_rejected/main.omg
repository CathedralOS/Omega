data Item { code: u64; }

trait Visitor<Value, Tag> {
    machine visit<machine Callback>(value: &Value) -> bool
    where machine Callback(value: &Value) -> bool;
    ;
}

machine matches(value: &Item) -> bool { value.code == 42u64 }

machine invoke<machine Callback>(value: &Item) -> bool
where machine Callback(value: &Item) -> bool;
satisfies Visitor<Item, u64>::visit, Visitor<Item, bool>::visit
{ Callback(value) }

linux_arm64 machine choose<machine Routine>(value: &Item) -> bool
where machine Routine satisfies Visitor<Item, u64>::visit;
{ Routine<matches>(value) }

linux_x86_64 machine choose<machine Operation>(value: &Item) -> bool
where machine Operation satisfies Visitor<Item, bool>::visit;
{ Operation<matches>(value) }

macos_arm64 machine choose<machine Schema>(value: &Item) -> bool
where machine Schema satisfies Visitor<Item, u32>::visit;
{ Schema<matches>(value) }

windows_x86_64 machine choose<machine Action>(value: &Item) -> bool
where machine Action satisfies Visitor<Item, u64>::visit;
{ Action<matches>(value) }

machine main() crashes Trap {
    let item: Item = Item { code: 42u64 };
    transition choose<invoke>(&item) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
