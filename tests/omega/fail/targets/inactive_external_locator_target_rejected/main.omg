use omega::language::core::external_binding;

data ForeignCall {}
boundary requirement ForeignCall::perform();
data ForeignLeaf {}

// Checking every authored member includes normalizing its own physical
// locator. A Windows leaf cannot borrow the selected macOS locator meaning.
windows_x86_64 machine ForeignLeaf::perform()
    satisfies ForeignCall::perform via incompatible_binding();

windows_x86_64 machine incompatible_binding() -> ForeignBinding<17, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_exit",
        },
    }
}

machine main() {}
