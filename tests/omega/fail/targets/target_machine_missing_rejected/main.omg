// A CONTRACT machine name -- one implemented by TWO OR MORE non-selected
// targets -- must be a targeted clean error naming who does provide one (a
// selected target missing its contract row), never the generic
// unresolved-name diagnostic. Two implementers is the evidence the name is a
// portable-contract surface; a SINGLE foreign implementer is that target's
// paradigm internal and filters silently instead (see
// pass/targets/single_target_internal_machine_skipped). `demo_target`/
// `demo_target2` resolve to no real target, so both target-scoped machines are
// inert on every host. That target-selection discipline makes this canary
// host-portable.
use omega::language::std::console;

data Helper { seed: i32; }

demo_target machine Helper::pick(&self) -> i32 {
    transition { _ -> 63 }
}

demo_target2 machine Helper::pick(&self) -> i32 {
    transition { _ -> 64 }
}

data Main { console: Console; helper: Helper; }

machine Main::main(&mut self) {
    let a: i32 = self.helper.pick();
    transition a == 63 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code2: i32) { self.console.exit_process(code2); }
}
