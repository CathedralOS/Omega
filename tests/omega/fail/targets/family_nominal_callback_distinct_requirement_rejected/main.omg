trait Handler { machine call() -> bool; }
trait Predicate { machine evaluate() -> bool; }
machine yes() -> bool satisfies Handler::call { true }

linux_arm64 machine choose<machine Selected>() -> bool
where machine Selected satisfies Handler::call;
{ Selected() }

macos_arm64 machine choose<machine Callback>() -> bool
where machine Callback satisfies Predicate::evaluate;
{ Callback() }

machine main() { let answer: bool = choose<yes>(); }
