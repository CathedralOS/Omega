// A body of a non-selected target is checked on every host: a type error in
// a `demo_target` body rejects the compile even though `demo_target` resolves
// to no real target and nothing portable calls the body.
use omega_language_std::console;
use omega::language::core::binding;

data Helper { seed: i32; }

demo_target machine Helper::paradigm_internal(&self) -> i32 {
    let wrong: i32 = true;
    transition { _ -> wrong }
}

data Main { console: Binding<Console>; helper: Helper; }

machine Main::main(main: &mut Main) reaches Console {
    let a: i32 = main.helper.seed;
    transition a == 0 { true -> good(main) _ -> bad(main, 71) }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main, code2: i32) { main.console.exit_process(code2); }
}
