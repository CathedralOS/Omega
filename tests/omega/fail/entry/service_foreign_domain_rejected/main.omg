// Intrinsic `Service<R>` validity is closed: any authored domain
// qualification on the carrier rejects at source checking rather than
// degrading to a structural field.
use omega::language::core::service;

pub boundary trait Ping {
    machine ping();
}
data PingProvider { }
machine PingProvider::ping() satisfies Ping::ping { }

domain<T> T::Foreign;

data Main {
    service: Service<Ping> in Foreign;
}

machine Main::main(&mut self) {
    self.service.ping();
}
