use omega_language_std::console;

data Sample { case Reading(value: u64); case Empty; }
data Phase { case Ready; case Idle; }
data Context { sample: Sample; phase: Phase; }
data Main { }

machine clear(context: &mut Context) -> bool {
    context.sample = Sample::Empty {};
    true
}

machine read(context: &mut Context) -> u64 {
    // The middle conjunct replaces the sum the first conjunct observed. The
    // final conjunct's selected case names another place and cannot revive
    // the retired case of `context.sample`.
    transition (context.sample in Sample::Reading) && clear(context)
        && (context.phase in Phase::Ready) {
        true -> (context.sample.value)
        false -> (0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut context: Context = Context {
        sample: Sample::Reading { value: 69 },
        phase: Phase::Ready {},
    };
    let value: u64 = read(&mut context);
    transition value == 0 {
        true -> finish(main)
        false -> finish(main)
    }
    state finish(main: &mut Main) { Console::exit_process(70); }
}
