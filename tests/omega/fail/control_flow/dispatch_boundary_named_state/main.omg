// Each authored dispatch owes its own total coverage. A later statement
// or separate block cannot supply the missing outcome.
machine choose(take: bool) -> u64 crashes Trap {
 transition { _ -> selected(take) }
 machine selected(take: bool) -> u64 {
  transition take { true -> (70) }
  crash Trap;
 }
}
machine main() crashes Trap { let result: u64 = choose(false); }
