data Token [linear] { value: u32; }
machine leak(output: &mut u32, token: Token) {
 transition { _ -> tail(output, token) }
 machine tail(output: &mut u32, token: Token) {
  output = 7;
  transition { _ -> {} }
 }
}
machine main() {
 let mut output: u32 = 99;
 let token: Token = Token { value: 1 };
 leak(&mut output, token);
}
