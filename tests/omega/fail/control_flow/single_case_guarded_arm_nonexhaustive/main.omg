// A one-case sum is covered by its sole case only when that arm is
// unconditional. A guard leaves the dispatch without an outcome when it fails,
// so the sole guarded arm is not exhaustive and the transition needs a `_` arm.

data Carried [copy] {
    case Value(handle: u64 in Wrapping);
}

machine Carried::code(carried: Carried) -> u64 in Wrapping {
    transition carried {
        Carried::Value { handle } if handle == 70 -> value(handle)
    }

    machine value(code: u64 in Wrapping) -> u64 in Wrapping {
        code
    }
}
