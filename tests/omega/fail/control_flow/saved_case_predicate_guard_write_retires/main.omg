domain u64::Divisor(value) requires value > 0;
data Choice [copy] { case Empty; case Full(amount: u64 in Divisor); }
machine clear(choice: &mut Choice) -> bool { choice = Choice::Empty; false }
machine quotient(mut choice: Choice) -> u64 {
    let saved: bool = choice in Choice::Full;
    transition {
        clear(&mut choice) -> 0
        saved -> 490 / choice.amount
        _ -> 0
    }
}
machine main() {}
