use omega::language::core::float_operations;
use omega_language_std::console;

data Sample { case Reading(value: f64); case Empty; }
data Context { sample: Sample; }
data Main { }

machine clear(context: &mut Context) -> bool {
    context.sample = Sample::Empty {};
    true
}

machine read(context: &mut Context) -> f64 {
    // The first conjunct's result is true, but its storage fact is retired
    // by the second conjunct. Completing the guard must not restore it.
    transition (context.sample in Sample::Reading) && clear(context) {
        true -> (context.sample.value)
        false -> (0.0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut context: Context = Context { sample: Sample::Reading { value: 2.5 } };
    let value: f64 = read(&mut context);
    transition value == 0.0 {
        true -> finish(main)
        false -> finish(main)
    }
    state finish(main: &mut Main) { Console::exit_process(70); }
}
