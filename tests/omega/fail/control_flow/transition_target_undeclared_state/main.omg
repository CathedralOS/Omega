// A terminal call naming no machine entry or callable requirement is rejected
// at checking. `vanished` is not declared beside `good`, so the arm cannot
// select a transition target.
use omega_language_std::Console;
data Main {
}
machine Main::main(main: &mut Main) {
    let x: i32 = 5;
    transition x == 3 {
        true -> good(main)
        _ -> vanished(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
}
