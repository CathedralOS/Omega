// A transition arm naming no state, machine, parameter or requirement is an
// unresolved name at checking. Before, checking accepted it and the program
// stopped later on an unrelated lowering invariant (an unresolved authored
// call, or a service-reach mismatch from the half-planned body).
use omega_language_std::console;
data Main {
}
machine Main::main(main: &mut Main) {
    let x: i32 = 5;
    transition x == 3 {
        true -> good(main)
        _ -> vanished(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
}
