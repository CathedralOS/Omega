// FAIL CANARY: marginal coverage is not Cartesian coverage. Every Direction
// and every Outcome appears, but the off-diagonal pairs are absent; accepting
// this matrix would permit a silent runtime fall-through.
use omega_language_std::console;

data Direction {
    case Left;
    case Right;
}

data Outcome {
    case Miss;
    case Hit;
}

data Main {
    direction: Direction;
    result: Outcome;
}

machine Main::main(main: &mut Main) {
    transition (main.direction, main.result) {
        (Direction::Left, Outcome::Miss) -> done(main)
        (Direction::Right, Outcome::Hit) -> done(main)
    }

    state done(main: &mut Main) { Console::exit_process(70); }
}
