// FAIL CANARY: bindings introduced by different tuple subjects share one arm
// scope, so duplicate names are ambiguous and require an explicit rename.
data Pair { left: i32; right: i32; }
data Main { a: Pair; b: Pair; }
machine Main::main(main: &mut Main) {
    transition (main.a, main.b) {
        (Pair { left as value, right as _ }, Pair { left as value, right as _ }) -> done(value)
        _ -> done(0)
    }
    machine done(value: i32) {}
}
