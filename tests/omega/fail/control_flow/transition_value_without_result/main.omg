// A unit machine's state (no result on the state or its machine) ends a transition
// arm with a value, `_ -> (this)`. Checking rejects it: the state has no result to
// deliver the value into, and lowering has no row that returns a value from a unit
// state, so accepting it would only fail at realization. The terminal arm is `_ -> {}`.
data Counter { count: u64 }

machine Counter::wipe(this: &mut Counter) {
    transition { _ -> step(this, 0) }
    state step(this: &mut Counter, position: u64) {
        transition position < 4 {
            true -> one(this, position)
            _ -> (this)
        }
    }
    state one(this: &mut Counter, position: u64) requires position < 4 {
        this.count = 7;
        transition { _ -> step(this, position + 1) }
    }
}

machine Main::main(this: &mut Main) {
    let mut counter: Counter = Counter { count: 0 };
    Counter::wipe(&mut counter);
}
data Main { }
