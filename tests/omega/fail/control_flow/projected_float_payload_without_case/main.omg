use omega::language::core::float_operations;
use omega_language_std::console;

data Sample {
    case Reading(value: f64);
    case Empty;
}

data Context { sample: Sample; }
data Main { }

// A readable loan supplies access, not proof that Reading is active.
machine read(context: &Context) -> f64 {
    context.sample.value
}

machine Main::main(main: &mut Main) reaches Console {
    let context: Context = Context { sample: Sample::Empty {} };
    let value: f64 = read(&context);
    transition value == 0.0 {
        true -> finish(main)
        false -> finish(main)
    }
    machine finish(main: &mut Main) { Console::exit_process(70); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
