data Sample { case Reading(value: u64); case Empty; }
data Context { sample: Sample; }
data Verdict [copy] { case Observed(value: bool); }

machine clear(context: &mut Context) -> bool {
    context.sample = Sample::Empty {};
    true
}

machine read(context: &mut Context) -> u64 {
    // A constructor is not stable merely because its shape is literal.
    // Evaluating its child replaces the case observed by the first conjunct.
    transition (context.sample in Sample::Reading)
        && (Verdict::Observed { value: clear(context) } in Verdict::Observed) {
        true -> (context.sample.value)
        false -> (0)
    }
}

machine main() {
    let mut context: Context = Context { sample: Sample::Reading { value: 70 } };
    let observed: u64 = read(&mut context);
}
