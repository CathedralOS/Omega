use omega::language::core::drop;
data Receipt [linear] { value: u64; }
machine Receipt::drop(receipt: &mut Receipt) {}
machine make() -> Receipt { Receipt { value: 7 } }
machine main() {
    let receipt: Receipt = make();
    transition { _ -> consume(receipt, receipt) }
    machine consume(first: Receipt, second: Receipt) { drop(first); drop(second); }
}
