use omega::language::core::float_operations;
use omega_language_std::console;

data Sample { case Reading(value: f64); case Empty; }
data Context { sample: Sample; }
data Main { }

machine clear(context: &mut Context) -> bool {
    context.sample = Sample::Empty {};
    false
}

machine read(context: &mut Context) -> f64 {
    // Equality with false is a live final operand, not a contradictory arm
    // that may be omitted while recovering the guard's last observation.
    transition (context.sample in Sample::Reading) && (clear(context) == false) {
        true -> (context.sample.value)
        false -> (0.0)
    }
}

machine Main::main(main: &mut Main) reaches Console {
    let mut context: Context = Context { sample: Sample::Reading { value: 2.5 } };
    let value: f64 = read(&mut context);
    transition value == 0.0 {
        true -> finish(main)
        false -> finish(main)
    }
    state finish(main: &mut Main) { Console::exit_process(70); }
}
