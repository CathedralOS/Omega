// A nested machine called terminally must complete with its caller's result: a
// different one cannot become the caller's result. Before, checking accepted
// this and the state graph planner declined the machine late — at terminal
// lowering — behind a bare `does not lower` with no source diagnostic.
machine Main::main(main: &mut Main) {
    transition (main.hits == 0) {
        _ -> checked(main)
    }
    machine checked(main: &mut Main) -> i32 { 42 }
}
data Main { hits: i32; }
