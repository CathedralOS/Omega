// A state may restate the machine's result, but a different one cannot be
// fused into the machine's one callable graph. Before, checking accepted
// this and the state graph planner declined the machine late — at terminal
// lowering — behind a bare `does not lower` with no source diagnostic.
machine Main::main(main: &mut Main) {
    transition (main.hits == 0) {
        _ -> checked(main)
    }
    machine checked(main: &mut Main) -> i32 { 42 }
}
data Main { hits: i32; }
