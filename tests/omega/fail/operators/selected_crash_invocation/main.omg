// Core also declares f32 and f64 Float::equal. This boundary over the
// package's own `Compared` domain is the selected crashing equal; compare
// publishes Abort, so the Trap route stays uncovered. The domain is the
// binding's home: bare i32 operands would join the core's primitive family.
domain i32::Compared;

boundary machine == Float::equal(left: i32 in Compared, right: i32 in Compared) -> bool crashes Trap;

machine compare(left: i32 in Compared, right: i32 in Compared) -> bool crashes Abort {
    left == right
}
