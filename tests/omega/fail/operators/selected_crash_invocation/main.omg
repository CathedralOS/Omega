// This i32 boundary is the selected crashing equal; compare publishes Abort,
// so the Trap route stays uncovered. The requirement lives in this package's
// own `Comparison` home: core's `Float` home is not open to authored rows.
boundary machine == Comparison::equal(left: i32, right: i32) -> bool crashes Trap;

machine compare(left: i32, right: i32) -> bool crashes Abort {
    left == right
}
