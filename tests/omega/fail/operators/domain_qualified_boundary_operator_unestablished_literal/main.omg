// The runnable `pass/operators/domain_qualified_boundary_operator_exit` with one
// change: `Counted` now names `count` as its establishment route. A bare literal
// operand no longer arrives in the domain for free; only `count` may introduce
// membership, so the operator's `7` operand must reject.
domain i32::Counted established by count;

boundary machine == Integer::equal(left: i32 in Counted, right: i32 in Counted) -> bool;

data CheckedEquality {}

machine CheckedEquality::equal(left: i32 in Counted, right: i32 in Counted) -> bool
satisfies Integer::equal
{
    left <= right && left >= right
}

machine count(value: i32) -> i32 in Counted { value }

machine echo(value: i32 in Counted) -> i32 in Counted { value }

machine nested(value: i32 in Counted, other: i32 in Counted) -> bool {
    value == 7 && !(echo(other) == value)
}

machine statement(value: i32 in Counted) -> bool {
    let equal: bool = value == 7;
    equal
}

machine main() crashes Trap {
    let seven: i32 in Counted = count(7);
    let eight: i32 in Counted = count(8);
    let five: i32 in Counted = count(5);
    let nine: i32 in Counted = count(9);
    let matching: bool = nested(seven, nine);
    let mismatched_literal: bool = nested(eight, nine);
    let mismatched_call: bool = nested(seven, seven);
    let statement_matching: bool = statement(seven);
    let statement_above: bool = statement(nine);
    let statement_below: bool = statement(five);
    transition matching && !mismatched_literal && !mismatched_call
        && statement_matching && !statement_above && !statement_below {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
