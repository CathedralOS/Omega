// A selected relation is not numeric equality, even in a length contract.
public trait Equality<T> { operator == related(left: T, right: T) -> bool; }
Always satisfies Equality<u64> {
    machine related(left: u64, right: u64) -> bool { true }
}
boundary machine window<E satisfies Equality<u64>>(items: &[u8], start: u64, end: u64) -> &[u8]
requires start <= end
ensures result.len == end - start;
machine requires_one(items: &[u8]) requires items.len == 1 {}
machine main() {
    let items: [u8; 3] = [1, 2, 3];
    let result: &[u8] = window<Always>(&items, 0, 1);
    requires_one(result);
}
