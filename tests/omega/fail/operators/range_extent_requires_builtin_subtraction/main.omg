// A selected subtraction is not an ordinary endpoint difference.
public trait Difference<T> { operator - subtract(left: T, right: T) -> T; }
Unrelated satisfies Difference<u64> {
    machine subtract(left: u64, right: u64) -> u64 { 3 }
}
boundary machine window<D satisfies Difference<u64>>(items: &[u8], start: u64, end: u64) -> &[u8]
requires start <= end
ensures result.len == end - start;
machine requires_one(items: &[u8]) requires items.len == 1 {}
machine main() {
    let items: [u8; 3] = [1, 2, 3];
    let result: &[u8] = window<Unrelated>(&items, 0, 1);
    requires_one(result);
}
