// Settled ambiguity rule across both introducer spellings: `machine +` and
// `operator +` share one token/owner/shape binding space. Both bindings spell
// `+` for the owner `Wrapped` over the same `(&Wrapped, &Wrapped)` operand
// shape, so the second declaration rejects even though it arrives through the
// other introducer.

data Wrapped { value: u8; }

machine + Wrapped::add(left: &Wrapped, right: &Wrapped) -> u64 {
    (left.value as u64) + (right.value as u64)
}

operator + Wrapped::plus(left: &Wrapped, right: &Wrapped) -> u64;

data Main {
}

machine Main::main(&mut self) {
}
