// An inverted range `[10..=5]` (low bound > high bound) is the empty set -- no
// value can satisfy it. Since range endpoints normalized (2026-09-12), the
// empty DECLARATION is legal but every range clause is a store-enforced
// invariant: storing 7 into `y` fails the "not provably within its declared
// range" check, so the malformed bound can never silently accept a value
// the way it used to (100, 7, 3, -50 all "passed" `[10..=5]`).
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(&mut self) {
    let y: i32 [10..=5] = 7; // empty range -- no store can satisfy it
    self.console.exit_process(0);
}
