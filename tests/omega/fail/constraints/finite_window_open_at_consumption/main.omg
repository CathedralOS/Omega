use omega::language::std::console;
use omega::language::core::service;

data Main {
    console: Binding<Console>;
    value: f64 in Finite;
}

machine Main::main(&mut self) {
    self.value = 0.0f64 / 0.0;
    transition { _ -> consume() }

    state consume(&self) { self.console.exit_process(77); }
}
