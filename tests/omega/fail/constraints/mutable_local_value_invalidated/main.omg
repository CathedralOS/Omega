// A legal writable call still replaces the local's current value
// (fact_validity.md, mutation and current-storage facts): after `replace`
// writes 8, neither a computed nor a literal initializer proves the old 7.
machine replace(value: &mut u8) { value = 8; }

machine produce_computed() -> u8
ensures result == 7
{
    let mut saved: u8 = 3 + 4;
    replace(&mut saved);
    saved
}

machine produce_literal() -> u8
ensures result == 7
{
    let mut saved: u8 = 7;
    replace(&mut saved);
    saved
}

machine main() {
    _ = produce_computed();
    _ = produce_literal();
}
