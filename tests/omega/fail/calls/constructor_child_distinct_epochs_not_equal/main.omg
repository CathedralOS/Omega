// Two reads of one source at different child completions are not equal
// without a premise relating the unknown original value to its replacement.
data Pair [copy] { first: i32; replaced: bool; second: i32; }
data Main { amount: i32; }

machine Main::replace(main: &mut Main, replacement: i32) -> bool {
    main.amount = replacement;
    true
}

machine observe(value: Pair)
requires value.first == value.second {}

machine main(initial: i32, replacement: i32) {
    let mut holder: Main = Main { amount: initial };
    observe(Pair { first: holder.amount, replaced: Main::replace(&mut holder, replacement), second: holder.amount });
}
