// The exact selected executable application supplies a nonzero native entry and finite attributed code regions at runtime.
// Reject: owning the layout record cannot grant writes through its shared regions.
use omega::language::core::CodeLayout;
machine selected<T, const Salt: u64>(value: T) -> T { value }
machine overwrite(layout: &mut CodeLayout)
requires layout.regions.len > 0
{
    layout.regions[0].base = layout.entry;
}
machine main() {
    let mut layout: CodeLayout = code_layout<selected<u64, 7>>();
    transition layout.regions.len > 0 {
        true -> overwrite(&mut layout)
        _ -> done()
    }
    machine done() {}
}
