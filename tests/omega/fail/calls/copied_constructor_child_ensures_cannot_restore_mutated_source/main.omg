// The guarantee describes the issued child captured before its later sibling
// replaces the backing source; it cannot reissue that source at invocation.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Envelope [copy] { ticket: Ticket; replaced: bool; }
data Main { ticket: Ticket; }

machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine saved(value: Envelope)
requires value.ticket in Ticket::Issued
ensures value.ticket in Ticket::Issued {}

machine require_issued(ticket: Ticket)
requires ticket in Ticket::Issued {}

machine main() {
    let mut holder: Main;
    holder.ticket = Ticket::issue();
    saved(Envelope { ticket: holder.ticket, replaced: Main::replace(&mut holder) });
    require_issued(holder.ticket);
}
