use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_scalar_indirect_result_wrong_width_rejected");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, main);

    Build::bind<Snapshot::copy>(builder, linux_x86_64, ForeignBinding::DllImport {
        import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "memcpy", version: "GLIBC_2.14" },
    });
}
