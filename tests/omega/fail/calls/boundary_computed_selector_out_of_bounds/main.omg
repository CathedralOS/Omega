// The computed boundary selector is exactly one past the local array.
use omega::language::core::external_binding;
public boundary trait CText { machine length(text: &u8, limit: u64) -> u64 reaches; }
macos_arm64 machine binding() -> ForeignBinding<26, 8, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_strnlen",
        },
    }
}
macos_arm64 machine c_strnlen(text: &u8, limit: u64) -> u64
satisfies CText::length via binding();
machine choose() -> u64 { 4 }
machine main() reaches CText {
    let bytes: [u8; 4] = "abc\0";
    let mut result: u64 = c_strnlen(&bytes[choose()], 1);
}
