// Constructor fields complete left to right. Issuing the source in a later
// field cannot grant membership to the earlier unissued ticket copy.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Envelope [copy] { ticket: Ticket; repaired: bool; }
data Main { ticket: Ticket; }

machine Main::repair(main: &mut Main) -> bool
ensures main.ticket in Ticket::Issued {
    main.ticket = Ticket::issue();
    true
}

machine observe(value: Envelope)
requires value.ticket in Ticket::Issued {}

machine main() {
    let mut holder: Main;
    observe(Envelope { ticket: holder.ticket, repaired: Main::repair(&mut holder) });
}
