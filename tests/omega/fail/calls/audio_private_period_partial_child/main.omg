// The incoming guarded period makes the original remainder operation defined.
// Expected exit: 0
public data State { phase: i32 in Wrapping; period: i32 in Wrapping; }
machine main() crashes Trap {
 transition probe(109,31) == 16 && probe(7,3) == 1 && probe(7,0) == 0 { true -> done() _ -> failed() }
 machine done() {}
 machine failed() { crash Trap; }
}
machine probe(phase: i32 in Wrapping, period: i32 in Wrapping) -> i32 in Wrapping {
 let mut cell: State;
 cell.phase = phase;
 cell.period = period;
 transition cell.period > 0 { true -> sample(&mut cell) _ -> (0) }
machine sample(cell: &mut State) -> i32 in Wrapping {
 cell.phase = ((cell.phase / (cell.period - cell.period)) * 0) % cell.period;
 cell.phase
}
}
