// Twin of pass/calls/subslice_argument_keeps_unrelated_facts: without the
// entry fact `position < this.count`, the same call to `compare` cannot be
// proved. The surviving facts come from the entry contract, not from the
// subslice argument or the call.
public boundary trait Read {}
data Table { count: u64; items: [u8; 4]; }
data Providers { reads: u64; }

machine Providers::read_bytes(this: &mut Providers, address: u64, values: &mut [u8]) -> bool
reaches Read
{
    this.reads = ((this.reads as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    (true)
}

machine Table::restore(this: &mut Table, providers: &mut Providers, position: u64, n: u64) -> u64
    requires position < 4 && n < 5;
reaches Read
{
    let mut buffer: [u8; 4];
    let ok: bool = Providers::read_bytes(&mut providers, 4096, &mut buffer[0 .. n]);
    transition ok {
        true -> compare(this, providers, position, &buffer[0 .. n])
        _ -> (0)
    }
    machine compare(this: &mut Table, providers: &mut Providers, position: u64, current: &[u8]) -> u64
        requires position < this.count && position < 4;
    {
        (this.items[position] as u64)
    }
}

machine Main::main(this: &mut Main) reaches Read {
    let mut table: Table = Table { count: 3, items: [0, 0, 0, 0] };
    let mut providers: Providers = Providers { reads: 0 };
    let value: u64 = Table::restore(&mut table, &mut providers, 1, 2);
    transition { _ -> done() }
    machine done() {}
}
data Main { }
