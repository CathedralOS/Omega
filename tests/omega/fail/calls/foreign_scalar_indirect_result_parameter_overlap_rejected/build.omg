use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_scalar_indirect_result_parameter_overlap_rejected");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::select_provider<Snapshot, NativeSnapshot>(builder, linux_arm64);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, linux_x86_64);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, macos_arm64);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, macos_x86_64);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, windows_x86_64);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, uefi_x86_64);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, cross_platform_cli);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, local_unchecked);
    Build::select_provider<Snapshot, NativeSnapshot>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);

 Build::bind<Snapshot::copy>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcpy", version: "GLIBC_2.14",
    } });
}
