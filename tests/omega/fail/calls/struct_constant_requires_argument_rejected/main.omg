// A record constructor argument is termifiable when every field termifies:
// `Point { x: 1, y: 0 }` under `p == Point::zero()` instantiates to
// `Point { x: 1, y: 0 } == Point { x: 0, y: 0 }` — structurally false.
// Constant machine applications (`Point::zero()`) normalize to the same
// closed constructor shape before the equation is judged.
use omega_language_std::console;
data Point { x: u64; y: u64; }
data Main { }
machine Point::zero() -> Point {
    Point {
        x: 0,
        y: 0,
    }
}
machine Main::take(p: Point) -> u64
    requires p == Point::zero();
{
    p.y
}
machine Main::main(main: &mut Main) reaches Console {
    let result: u64 = Main::take(Point {
        x: 1,
        y: 0,
    });
    Console::exit_process(0);
}
