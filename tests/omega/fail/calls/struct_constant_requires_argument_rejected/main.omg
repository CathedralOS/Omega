// Forming a record's mathematical value requires every field to form.
// The call below passes x=1 while take requires exact identity with the
// zero-valued Point. Unfolding Point::zero exposes that differing field,
// so the required identity must reject.
use omega_language_std::Console;
data Point { x: u64; y: u64; }
data Main { }
machine Point::zero() -> Point {
    Point {
        x: 0,
        y: 0,
    }
}
machine Main::take(p: Point) -> u64
    requires core::Identity<Point>(p, Point::zero())
{
    p.y
}
machine Main::main(main: &mut Main) reaches Console {
    let result: u64 = Main::take(Point {
        x: 1,
        y: 0,
    });
    Console::exit_process(0);
}
