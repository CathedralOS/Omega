// Unknown reads separated by a write cannot share one equality identity.
data Pair [copy] { first: i32; replaced: bool; second: i32; }
data Holder { amount: i32; }

machine Holder::replace(holder: &mut Holder, replacement: i32) -> bool {
    holder.amount = replacement;
    true
}

trait PairConsumer {
    machine observe(pair: Pair, expected: i32) -> bool
    requires pair.first == pair.second;
}

machine observe(captured: Pair, wanted: i32) -> bool
satisfies PairConsumer::observe {
    captured.first == wanted && captured.second == wanted && captured.replaced
}

machine main(initial: i32, replacement: i32) {
    let mut holder: Holder = Holder { amount: initial };
    let accepted: bool = observe(Pair {
        first: holder.amount,
        replaced: Holder::replace(&mut holder, replacement),
        second: holder.amount
    }, initial);
}
