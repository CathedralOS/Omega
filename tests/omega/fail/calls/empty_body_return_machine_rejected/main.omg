// V2: value-returning machine with an EMPTY body -- `machine get -> i32 { }`.
use omega_language_std::console;
data Main {
}
machine Main::get() -> i32 {
}
machine Main::main(main: &mut Main) {
    let r: i32 = Main::get();
    transition r == 0 {
        true -> yes(main)
        false -> no(main)
    }
    state yes(main: &mut Main) { Console::exit_process(1); }
    state no(main: &mut Main) { Console::exit_process(2); }
}
