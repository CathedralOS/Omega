// V2: value-returning machine with an EMPTY body -- `machine get -> i32 { }`.
use omega::language::std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
}
machine Main::get() -> i32 {
}
machine Main::main(&mut self) {
    let r: i32 = Main::get();
    transition r == 0 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
