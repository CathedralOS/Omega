// A routed guarantee describes the saved owned argument, never the newer
// contents of its original source after a later operand replaced them.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Main { ticket: Ticket; }

machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine saved(ticket: Ticket, changed: bool) -> bool
requires ticket in Ticket::Issued
ensures ticket in Ticket::Issued {
    changed
}

machine require_issued(ticket: Ticket)
requires ticket in Ticket::Issued {}

machine main() {
    let mut holder: Main;
    holder.ticket = Ticket::issue();
    let captured: bool = saved(holder.ticket, Main::replace(&mut holder));
    require_issued(holder.ticket);
}
