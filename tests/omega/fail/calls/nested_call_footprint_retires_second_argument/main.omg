// The second nested call must invalidate its own storage, not reuse the first
// call's footprint merely because both invoke the same machine in one statement.
data Cells { first: u64; second: u64; }
machine replace(cell: &mut u64, value: u64) -> bool { cell = value; true }
machine both(first: bool, second: bool) -> bool { first && second }
machine bounded(value: u64) requires value <= 8 {}

machine main() {
    let mut cells: Cells;
    cells.first = 1;
    cells.second = 2;
    transition cells.second <= 8 {
        true -> write(&mut cells)
        false -> done()
    }
    state write(cells: &mut Cells) requires cells.second <= 8 {
        let completed: bool = both(replace(&mut cells.first, 3), replace(&mut cells.second, 9));
        bounded(cells.second);
    }
    state done() {}
}
