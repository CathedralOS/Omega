// The negative twin of run/calls/outcome_specific_selected_guarantee_inputs_exit.
// Only the declaring machine assigns its evidence output, so `pick` owes its
// `Success` guarantee at the terminal call `succeed()` and discharges it from
// `succeed`'s own guarantee. Here `succeed` guarantees the fact on `Failure`
// instead, while it returns `Success`, so nothing supplies `pick`'s guarantee.
data Outcome [copy] {
    case Success;
    case Failure;
}

trait Evidence {
}

proposition selected_ready() evidence Evidence;

Fresh satisfies Evidence {
}

machine pick(threshold: u32) -> Outcome
ensures Outcome::Success -> { selected: selected_ready(); }
{
    transition threshold > 3 {
        true -> succeed()
        false -> fail()
    }

    machine succeed() -> Outcome
    ensures Outcome::Failure -> { selected: selected_ready(); }
    {
        Outcome::Success
    }

    machine fail() -> Outcome {
        Outcome::Failure
    }
}

machine main() {
    transition pick(5) {
        Outcome::Success { ; selected: proof } -> {}
        _ -> {}
    }
}
