domain [u8; 4]::Utf8(bytes) requires valid_utf8(bytes);

data Main {
    line: [u8; 4] in Utf8;
}

machine Main::replace(main: &mut Main) -> bool {
    main.line = [195u8, 169u8, 0u8, 0u8];
    true
}

machine saved_ascii(value: [u8; 4] in Utf8, replaced: bool) -> bool
requires ascii_only(value)
ensures ascii_only(value) {
    replaced
}

machine take_ascii(value: [u8; 4] in Utf8)
requires ascii_only(value) {}

machine Main::main(main: &mut Main) {
    main.line = "Gate";
    transition ascii_only(main.line) {
        true -> capture(main)
        false -> done()
    }
    state capture(main: &mut Main)
    requires ascii_only(main.line) {
        let captured: bool = saved_ascii(main.line, Main::replace(main));
        // The postcondition describes the captured value, not this newer text.
        take_ascii(main.line);
    }
    state done() {}
}
