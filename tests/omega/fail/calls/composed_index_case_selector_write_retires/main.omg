// Reject: changing key invalidates the earlier empty-slot check.
use omega::language::core::drop;

data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token) { token.value = 0; }
data Slot { case Empty; case Held(storage: Token); }
data Pool { before: u64; slots: [Slot; 8192]; after: u64; }

data Calls { count: u64; }
machine payload(value: u64, calls: &mut Calls) -> u64 {
    calls.count = ((calls.count as u64 in Wrapping) + 1) as u64;
    value
}

machine reserve(owner: &mut Pool, next: u64, key: u64, value: u64, calls: &mut Calls) -> u64
requires addr::Bound == 18446744073709551616 && next < 8192 && key < 8192 && key <= 8191 - next
{
    transition owner.slots[next + key] in Slot::Empty {
        true -> take(owner, next, key, payload(value, calls))
        _ -> 83
    }
    machine take(owner: &mut Pool, next: u64, mut key: u64, value: u64) -> u64
    requires addr::Bound == 18446744073709551616 && next < 8192 && key < 8192 && key <= 8191 - next &&
        (owner.slots[next + key] in Slot::Empty)
    {
        key = 0;
        transition { _ -> keep(owner, next, key, value) }
    }
    machine keep(owner: &mut Pool, next: u64, key: u64, value: u64) -> u64
    requires addr::Bound == 18446744073709551616 && next < 8192 && key < 8192 && key <= 8191 - next &&
        (owner.slots[next + key] in Slot::Empty)
    {
        owner.slots[next + key] = Slot::Held { storage: Token { value: value } };
        value
    }
}
machine read(slot: &Slot) -> u64 {
    match slot {
        Slot::Empty -> 0
        Slot::Held { storage } -> storage.value
    }
}
machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let slots: [Slot; 8192];
    let mut owner: Pool = Pool { before: 91, slots: slots, after: 97 };
    let mut calls: Calls = Calls { count: 0 };
    let first: u64 = reserve(&mut owner, 1, 1, 47, &mut calls);
    let fallback: u64 = reserve(&mut owner, 1, 1, 59, &mut calls);
    let second: u64 = reserve(&mut owner, 2, 1, 59, &mut calls);
    let valid: bool = first == 47 && fallback == 83 && second == 59 &&
        read(&owner.slots[2]) == 47 && read(&owner.slots[3]) == 59 &&
        read(&owner.slots[1]) == 0 && read(&owner.slots[4]) == 0 && owner.before == 91 && owner.after == 97 && calls.count == 2;
    drop(owner);
    transition valid { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
