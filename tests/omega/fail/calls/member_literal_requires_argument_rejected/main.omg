// A field read off a closed constructor termifies to that field's term:
// `Point { x: 0, y: 5 }.x` is 0, so `d != 0` is structurally false at this
// call. Member receivers that stay symbolic keep the opaque whole-expression
// name rather than guessing.
use omega_language_std::console;
data Point { x: u64; y: u64; }
data Main { }
machine Main::take(d: u64) -> u64
    requires d != 0;
{
    d
}
machine Main::main(main: &mut Main) {
    let result: u64 = Main::take(Point {
        x: 0,
        y: 5,
    }.x);
    Console::exit_process(0);
}
