// FROZEN DECISION 9 -- STRICT RESULT USE: a statement-position call whose callee
// returns a non-unit value is a compile error unless the discard is explicit
// (`_ = call();`). `roll()` returns bool; the bare statement call must reject.
data Main {
    value: i32;
}

machine Main::roll() -> bool {
    transition {
        _ -> true
    }
}

machine Main::main(main: &mut Main) -> i32 {
    transition {
        _ -> drop_result(main)
    }

    state drop_result(main: &mut Main) {
        Main::roll();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown() {
        0
    }
}
