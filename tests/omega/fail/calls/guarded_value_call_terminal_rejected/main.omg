// FAIL CANARY (task #45's V1 gate): a guarded arm's value call rewrites
// to a synthesized continuation state ONLY when every argument is a bare
// NAME of an enclosing state parameter (the synthesized state's parameter
// types copy over). A computed argument (`dbl(x + 1)`) remains beyond the
// supported lowering: the original emission fence (`reached emission as an
// unclassified zero-width row`) was retired upstream, checked semantics now
// admits this shape, and the native route still refuses it at lowering --
// the arm's spliced continuation carries an operation proof obligation the
// current backend cannot discharge (`OperationProofUnavailable`).
use omega::language::std::console;
use omega::language::core::service;
data Main { console: Service<Console>; }
machine dbl(x: i32 [0..=1001]) -> i32 {
    transition { _ -> (x + x) }
}
machine pick(x: i32 [0..=1000]) -> i32 {
    transition x > 50 { true -> (dbl(x + 1)) _ -> (x) }
}
machine Main::main(&mut self) reaches Console {
    let p: i32 = pick(60);
    transition p == 122 { true -> good() _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
}
