use omega::language::core::external_binding;


data RegistrarImports {}


public boundary trait Handler { machine notify() reaches; }
public boundary trait Registrar<Value> {
    machine install<machine Callback>() -> i32
    requires machine Callback satisfies Handler::notify;
    reaches;
}

data CallbackBody {}
machine CallbackBody::notify() satisfies Handler::notify {}

machine main() reaches Registrar crashes Trap {
    let code: i32 = Registrar<u64>::install<CallbackBody::notify>();
    transition code == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
