use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "foreign_applied_callback_requires_selected_entry_plan");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind<LineRaster<u64>::draw>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "gdi32.dll", export: "LineDDA" },
    });
}
