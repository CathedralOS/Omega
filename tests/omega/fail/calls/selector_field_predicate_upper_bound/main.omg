// A call may supply a one-past selector. An inclusive arrival premise must
// not satisfy the data's exclusive index bound at the write.
data Cursor requires row < 2, position < 4 {
    row: u64;
    position: u64;
}

machine replace_row(cursor: &mut Cursor, row: u64)
requires row <= 2
{
    cursor.row = row;
}

machine replace_position(cursor: &mut Cursor, position: u64)
requires position <= 4
{
    cursor.position = position;
}
