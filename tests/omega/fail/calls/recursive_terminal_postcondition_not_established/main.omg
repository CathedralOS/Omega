public machine step() -> bool blocks; { true }
data Context { value: i32; }
machine scan(context: &mut Context, remaining: i32 in Wrapping) -> bool
ensures context.value == 0;
{
    let ready: bool = block step();
    transition remaining > 0 { true -> block scan(context, remaining - 1) _ -> ready }
}
machine main(context: &mut Context) {
    context.value = 1;
    let observed: bool = block scan(context, 2);
}
