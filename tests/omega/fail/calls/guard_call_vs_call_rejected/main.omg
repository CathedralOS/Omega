// BACKSTOP FENCE: guard-call shapes the frontend hoist does NOT cover (here
// Call-vs-Call -- no integer-literal side) still have no runtime lowering.
// The emission blocker that rejected them (`reached emission as an
// unclassified zero-width row`) was retired upstream; checked semantics now
// admits the shape, and the native route still refuses it at the
// transitive Unit-plan admission wall.
use omega::language::std::console;
data Main { console: Console; }
machine Main::dbl(&self, x: i32 in Wrapping) -> i32 in Wrapping {
    let r: i32 in Wrapping = x * 2;
    transition { _ -> r }
}
machine Main::main(&mut self) reaches Console {
    transition self.dbl(5) == self.dbl(6) { true -> bad(71) _ -> good() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
