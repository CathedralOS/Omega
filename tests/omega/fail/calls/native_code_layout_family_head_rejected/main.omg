// Unsupported bodyless-family metadata must reject explicitly.
use omega::language::core::code_layout;
boundary trait SelectedSelected {
    machine selected<T>(value: T) -> T reaches
;
}
CheckedSelected satisfies SelectedSelected {
    machine selected<T>(value: T) -> T
{ value }
}



machine main() { code_layout<SelectedSelected::selected<u64>>(); }
