machine build(builder: &mut Build) {
    Build::select_provider<SelectedSelected, CheckedSelected>(builder, linux_x86_64);
    Build::select_provider<SelectedSelected, CheckedSelected>(builder, linux_arm64);
    Build::select_provider<SelectedSelected, CheckedSelected>(builder, macos_arm64);
    Build::select_provider<SelectedSelected, CheckedSelected>(builder, windows_x86_64);

    Build::application(builder, "selected_native_code_layout_local");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
}
