// A copied generic field fact retains its original numeric carrier.
use omega_language_std::console;
data Holder<T [copy]> [copy] { value: T; }
data Main { big: Holder<u64>; }
machine take(value: i64) -> u64 requires value > 0; { 0 }
machine Main::main(main: &mut Main) reaches Console {
 main.big = Holder { value: 18446744073709551615 };
 let view: &Holder<i64> = &main.big as &Holder<i64>;
 let result: u64 = take(view.value);
 Console::exit_process(0);
}
