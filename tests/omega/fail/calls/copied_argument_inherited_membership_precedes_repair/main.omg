// An inherited requirement applies to the already-copied argument. Issuing
// its source in a later operand cannot grant authority to that earlier value.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Main { ticket: Ticket; }

machine Main::repair(main: &mut Main) -> bool
ensures main.ticket in Ticket::Issued {
    main.ticket = Ticket::issue();
    true
}

trait Consumer {
    machine observe(ticket: Ticket, repaired: bool) -> bool
    requires ticket in Ticket::Issued;
}

machine observe(ticket: Ticket, repaired: bool) -> bool
satisfies Consumer::observe {
    repaired
}

machine main() {
    let mut holder: Main;
    let observed: bool = observe(holder.ticket, Main::repair(&mut holder));
}
