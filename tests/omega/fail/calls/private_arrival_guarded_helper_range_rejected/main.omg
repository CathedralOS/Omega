// Twin of pass/calls/private_arrival_guarded_helper_range_exit: the bound reaches 61,
// so `60u64 - val` in the nested `step` may underflow.
machine helper(v: u64) -> u64 {
    transition v >= 20 && v <= 61 {
        true -> v
        _ -> 40
    }
}

machine run(a: u64, expected: u64) crashes Trap {
    let joined: u64 = helper(a);
    transition true {
        true -> step(joined, expected)
        _ -> bad()
    }
    machine step(val: u64, expected: u64) {
        let diff1: u64 = 60u64 - val;
        let diff2: u64 = val - 20u64;
        transition diff1 + diff2 == 40 && val == expected {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine main() crashes Trap {
    run(100, 40);
    run(30, 30);
}
