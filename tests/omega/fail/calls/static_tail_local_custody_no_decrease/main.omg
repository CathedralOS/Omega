// Finishing states do not make a rank-preserving mutual cycle terminate.
data Counter { value: u64; }

machine Counter::even(counter: &mut Counter, remaining: u64) -> u64
terminates by remaining;
{
    transition remaining == 0 {
        true -> finish(counter)
        _ -> Counter::odd(remaining, counter)
    }
    machine finish(counter: &mut Counter) -> u64 {
        counter.value = 70;
        counter.value
    }
}

machine Counter::odd(remaining: u64, counter: &mut Counter) -> u64
terminates by remaining;
{
    transition remaining == 0 {
        true -> finish(counter)
        _ -> Counter::even(counter, remaining)
    }
    machine finish(counter: &mut Counter) -> u64 {
        counter.value = 71;
        counter.value
    }
}

machine main() -> u64 {
    let mut counter: Counter;
    Counter::even(&mut counter, 10)
}
