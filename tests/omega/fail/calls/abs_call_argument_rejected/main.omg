use omega::language::std::console;
use omega::language::core::service;
machine pick(x: i32) -> i32 {
    transition {
        x > 0 -> 100
        _ -> 200
    }
}
data Main {
    console: Binding<Console>;
    x: i32 in Wrapping;
}
machine Main::main(&mut self) {
    self.x = abs(pick(5));
    self.console.exit_process(0);
}
