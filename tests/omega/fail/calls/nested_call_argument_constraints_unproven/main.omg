// A call nested in an expression delivers its arguments as a statement call
// does: each argument proves the parameter's declared constraints where it is
// evaluated. Only statement calls (`_ = admit(20.0);`) used to be proven; a
// call in a local initializer, a terminal expression or another call's
// argument admitted 20.0 against `[0.0..=0.5]`, and `left / right` against
// `in Finite`.
machine admit(value: f64) -> f64 requires value >= 0.0 && value <= 0.5 { value }

machine finite(value: f64 in Finite) -> f64 { value }

machine outer(value: f64) -> f64 { value }

machine initialized() -> f64 {
    let result: f64 = admit(20.0);
    result
}

machine terminal() -> f64 {
    admit(30.0)
}

machine nested() -> f64 {
    let result: f64 = outer(admit(40.0));
    result
}

machine divided(left: f64, right: f64) -> f64 {
    let result: f64 = finite(left / right);
    result
}

machine main() {
    _ = initialized();
    _ = terminal();
    _ = nested();
    _ = divided(1.0, 0.0);
}
