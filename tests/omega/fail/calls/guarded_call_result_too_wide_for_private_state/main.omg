// A private state that omits `requires` may rely only on what its arrival
// proves. Here the guard is `high < 32`, so `high * 16 + low` can reach 511 and
// the exact cast to `u8` in `emit` must be rejected.
data Source
requires
    length <= 64,
{
    bytes: [u8; 64] in Trapping;
    length: u64;
}

data Tape {
    source: Source;
    cursor: u64 in Trapping;
    last: u8;
    accepted: bool;
}

machine push(tape: &mut Tape, byte: u8) { tape.last = byte; }

machine byte_or_nul(source: &Source, index: u64 in Trapping) -> u8 {
    transition index < source.length {
        true -> retain(source, index)
        _ -> absent()
    }
    machine retain(source: &Source, index: u64 in Trapping) -> u8 {
        transition index < 64 {
            true -> read(source, index)
            _ -> absent()
        }
    }
    machine read(source: &Source, index: u64 in Trapping) -> u8
    requires index < 64
    {
        (&source.bytes as -Trapping)[index as -Trapping]
    }
    machine absent() -> u8 { 0 }
}

machine digit(byte: u32 in Trapping) -> u32 in Trapping {
    transition byte >= 48 && byte <= 57 {
        true -> decimal(byte)
        _ -> lower(byte)
    }
    machine decimal(byte: u32 in Trapping) -> u32 in Trapping { byte - 48 }
    machine lower(byte: u32 in Trapping) -> u32 in Trapping { transition byte >= 97 && byte <= 102 { true -> lower_yes(byte) _ -> none() } }
    machine lower_yes(byte: u32 in Trapping) -> u32 in Trapping { byte - 87 }
    machine none() -> u32 in Trapping { 4294967295 }
}

machine run(tape: &mut Tape) {
    scan(tape)
    machine scan(tape: &mut Tape) {
        transition tape.cursor < tape.source.length { true -> begin(tape) _ -> done() }
    }
    machine begin(tape: &mut Tape) {
        let index1: u64 in Trapping = tape.cursor + 1;
        let index2: u64 in Trapping = tape.cursor + 2;
        transition index2 < tape.source.length { true -> first(tape, index1, index2) _ -> done() }
    }
    machine first(tape: &mut Tape, index1: u64 in Trapping, index2: u64 in Trapping) {
        let source_byte: u8 = byte_or_nul(&tape.source, index1);
        let high: u32 in Trapping = digit(source_byte as u32 in Trapping);
        transition high < 32 { true -> second(tape, index2, high) _ -> done() }
    }
    machine second(tape: &mut Tape, index2: u64 in Trapping, high: u32 in Trapping) {
        let source_byte: u8 = byte_or_nul(&tape.source, index2);
        let low: u32 in Trapping = digit(source_byte as u32 in Trapping);
        transition low < 16 { true -> emit(tape, high, low) _ -> done() }
    }
    machine emit(tape: &mut Tape, high: u32 in Trapping, low: u32 in Trapping) {
        let byte: u8 = (high * 16 + low) as u8;
        push(tape, byte);
        tape.cursor = tape.cursor + 3;
        transition tape.accepted { true -> scan(tape) _ -> done() }
    }
    machine done() {}
}

machine main() {
    let mut tape: Tape;
    tape.source.length = 0;
    tape.cursor = 0;
    tape.last = 0;
    tape.accepted = false;
    run(&mut tape);
}
