data Node { value: u64; }
// The nested arm can still complete normally, so it owes returned reference
// origins; its normal route returns a view of its own local and must reject.
machine choose(node: &mut Node, take: bool) -> &mut Node crashes Trap {
    transition take { true -> (node) false -> failed(take) }
    machine failed(again: bool) -> &mut Node crashes Trap {
        let mut local: Node = Node { value: 1 };
        transition again { true -> (&mut local) false -> boom() }
        machine boom() -> &mut Node { crash Trap; }
    }
}
machine main() crashes Trap {
    let mut node: Node = Node { value: 70 };
    let result: &mut Node = choose(&mut node, false);
}
