// A nominal record cannot hide referent/descriptor authority in a closed fact call.
use omega_language_std::console;
const ZERO: u64 = 0;
data View [copy] { value: &u64; }
data Main { }
machine View::zero() -> View { View { value: &ZERO } }
machine take(point: View) -> u64 requires point.value == View::zero().value; { 0 }
machine Main::main(main: &mut Main) reaches Console {
 let result: u64 = take(View { value: &ZERO }); Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
