// MR4 admission negative twin (2026-07-20): the all-tail measured shape
// QUALIFIES but ping's edge passes `n` unchanged -- the strict decrease is
// unprovable and the cycle keeps its refusal, verdict naming the edge.
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) {
    let r: u64 = self.ping(6);
    transition r == 0 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(1); }
}
machine Main::ping(&mut self, n: u64)
terminates by n;
-> u64
{
    transition n == 0 {
        true -> (0)
        _ -> self.pong(n)
    }
}
machine Main::pong(&mut self, n: u64)
terminates by n;
-> u64
{
    transition n == 0 {
        true -> (0)
        _ -> self.ping(n - 1)
    }
}
