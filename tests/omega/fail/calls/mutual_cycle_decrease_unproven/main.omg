// Both tail calls preserve n. No complete cycle decreases the joint rank,
// so a measured signature alone cannot establish termination.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let r: u64 = Main::ping(main, 6);
    transition r == 0 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
machine Main::ping(main: &mut Main, n: u64)
terminates by n;
-> u64
{
    transition n == 0 {
        true -> (0)
        _ -> Main::pong(main, n)
    }
}
machine Main::pong(main: &mut Main, n: u64)
terminates by n;
-> u64
{
    transition n == 0 {
        true -> (0)
        _ -> Main::ping(main, n)
    }
}
