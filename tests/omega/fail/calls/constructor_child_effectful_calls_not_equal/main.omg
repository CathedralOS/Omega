// Identical call arguments do not identify distinct effectful results.
data Pair [copy] { first: bool; second: bool; }
data Holder { ready: bool; }

machine Holder::flip(holder: &mut Holder) -> bool {
    let saved: bool = holder.ready;
    holder.ready = !holder.ready;
    saved
}

machine observe(value: Pair)
requires value.first == value.second {}

machine main(initial: bool) {
    let mut holder: Holder = Holder { ready: initial };
    observe(Pair {
        first: Holder::flip(&mut holder),
        second: Holder::flip(&mut holder)
    });
}
