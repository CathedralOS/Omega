use omega_language_std::Console;
data Point [copy] { x: u64; y: u64; }
data Main { point: Point; }
machine Point::zero() -> Point { Point { x: 0, y: 0 } }
machine take(point: Point) -> u64 requires core::Identity<Point>(point, Point::zero()) { point.y }
machine bad(main: &mut Main) requires core::Identity<Point>(main.point, Point::zero()) {
 main.point = Point { x: 1, y: 0 };
 let result: u64 = take(main.point);
}
machine Main::main(main: &mut Main) reaches Console { Console::exit_process(0); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
