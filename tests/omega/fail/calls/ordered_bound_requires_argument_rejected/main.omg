// An ordered requires fact judges over the same folded operands equality
// uses: `1 + 1` under `d > 5` instantiates to `2 > 5` — structurally false,
// not merely unproven. Symbolic operands stay with the positive prover.
use omega_language_std::console;
data Main { }
machine Main::pick(d: u64) -> u64
    requires d > 5;
{
    d
}
machine Main::main(main: &mut Main) {
    let result: u64 = Main::pick(1 + 1);
    Console::exit_process(0);
}
