// FAIL CANARY: BARE reassignment of a plain `let` local refuses -- the
// binding is immutable (`let mut` is the reassignable spelling). Before
// the gate this shape compiled and natively read the STALE initializer
// (a silent fold divergence, interp disagreed). Member/index fills
// (`q.x = 3`) and writes through `&mut`-typed views stay ungated (the
// ZII fill idiom and pointee writes respectively).
use omega_language_std::console;
data Main { out: i32; }
machine Main::main(main: &mut Main) {
    let x: u32 = 1;
    x = 2;
    main.out = x as i32;
    Console::exit_process(main.out);
}
