// Namespace selection does not admit an actual runtime receiver in fact projection.
use omega_language_std::console;
data Point [copy] { x: u64; y: u64; }
data Main { }
machine Point::zero(point: Point) -> Point { Point { x: 0, y: 0 } }
machine take(point: Point) -> u64 requires point.x == point.zero().x; { point.y }
machine Main::main(main: &mut Main) reaches Console {
 let result: u64 = take(Point { x: 0, y: 0 }); Console::exit_process(0);
}
