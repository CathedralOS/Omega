// An unformed divergent result cannot supply a structural contradiction.
use omega_language_std::console;
use omega::language::core::binding;
data Point [copy] { x: u64; y: u64; }
data Main { console: Binding<Console>; }
machine diverge() -> u64 { transition { _ -> again() } state again() -> u64 { transition { _ -> again() } } }
machine Point::zero() -> Point { transition { _ -> Point { x: 0, y: diverge() } } }
machine take(point: Point) -> u64 requires point.x == Point::zero().x; { point.x }
machine Main::main(main: &mut Main) reaches Console { let result: u64 = take(Point { x: 1, y: 0 }); main.console.exit_process(0); }
