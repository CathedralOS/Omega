// Attached calls select their parameter family from the actual operands.
data Selector {}
data Payload { value: u64; }
machine Selector::choose(value: u64) -> u64 { 11u64 }
machine Selector::choose(value: Payload) -> u64 { value.value }
machine start() crashes Trap {
    let scalar: u64 = Selector::choose(73u64);
    let record: u64 = Selector::choose(true);
    transition scalar == 11u64 && record == 37u64 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
