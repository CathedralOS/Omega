// A completed arithmetic value copied into a local remains zero. Its use
// cannot satisfy a nonzero divisor requirement; initializer replay is not
// needed to reject it. Declare host reach so it pins the contract failure.
use omega_language_std::console;
data Main { }
machine Main::scale(value: u64, divisor: u64) -> u64
    requires divisor != 0;
{
    value / divisor
}
machine Main::main(main: &mut Main) reaches Console {
    let d: u64 = 1 - 1;
    let result: u64 = Main::scale(10, d);
    Console::exit_process(0);
}
