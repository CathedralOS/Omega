// An immutable local's provenance is its declared initial value: passing `d`
// where `let d = 1 - 1` is the same as passing 0, so `divisor != 0` is
// structurally false at this call. A mutable local cannot be folded this way
// because its value at the call site is not its declaration.
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::scale(value: u64, divisor: u64) -> u64
    requires divisor != 0;
{
    value / divisor
}
machine Main::main(main: &mut Main) {
    let d: u64 = 1 - 1;
    let result: u64 = Main::scale(10, d);
    main.console.exit_process(0);
}
