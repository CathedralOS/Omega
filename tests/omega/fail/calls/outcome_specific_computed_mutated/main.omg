// Expected exit: 0.
// Selecting Success from pick(Gate{threshold:5}) transports exact above(current.threshold + 1) evidence and preserves threshold 5.
data Outcome [copy] { case Success; case Failure; }
data Gate [copy] { threshold: u32; }
trait Evidence {}
proposition above(limit: u32) evidence Evidence;
Fresh satisfies Evidence {}
machine pick(current: Gate) -> Outcome
ensures Outcome::Success -> { selected: above(current.threshold + 1); }
{ selected = Fresh; Outcome::Success }
machine probe(gate: Gate) -> bool {
 let mut current: Gate = gate;
 let before: Gate = current;
 let saved: Outcome = pick(current);
 current.threshold = 6;
 transition saved {
  Outcome::Success { ; selected: proof } -> accepted(current; proof)
  _ -> (false)
 }
 machine accepted(current: Gate) -> bool
 requires incoming: above(current.threshold + 1)
 { current.threshold == 6 }
}
machine main() crashes Trap {
 transition probe(Gate { threshold: 5 }) { true -> done() _ -> bad() }
 machine done() {} machine bad() { crash Trap; }
}
