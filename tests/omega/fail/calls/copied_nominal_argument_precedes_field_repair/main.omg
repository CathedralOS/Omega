// Arguments complete left to right (expressions.md). Repairing the source
// after the owned copy cannot establish that copy's declared field domain.
domain i32::Positive(value) requires value > 0;
data Gauge [copy] { level: i32 in Positive; }

machine repair(level: &mut i32) -> bool
ensures level > 0
{
    level = 7;
    true
}

machine observe(value: Gauge, repaired: bool) -> bool {
    repaired
}

machine main() {
    let mut gauge: Gauge;
    let observed: bool = observe(gauge, repair(&mut gauge.level));
}
