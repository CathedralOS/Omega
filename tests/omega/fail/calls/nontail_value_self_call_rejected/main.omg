// MR3 (runtime recursion is TAIL-ONLY): `3 * main.triple(n - 1)` keeps
// the frame alive past the call -- the result feeds the multiply -- so
// even on a MEASURED machine the spelling refuses, naming why it is not
// tail and pointing at the tail arm / explicit-storage restructurings.
// (The owner amendment CUT non-tail runtime recursion; depth lives in
// storage the author sizes.)
use omega_language_std::console;
data Main { }
machine Main::triple(main: &mut Main, n: u64) -> u64
terminates by n;
{
    transition n > 0 {
        true -> 3 * Main::triple(main, n - 1)
        false -> 1
    }
}
machine Main::main(main: &mut Main) {
    let value: u64 = Main::triple(main, 1);
    transition value == 3 {
        true -> yes(main)
        false -> no(main)
    }
    state yes(main: &mut Main) { Console::exit_process(1); }
    state no(main: &mut Main) { Console::exit_process(2); }
}
