// A borrowed match join records the selected place, and a later projection read uses that recorded referent. The consumer reads the joined field.
// Fields retain their values through a local, nested call and named state.
// Every normal exit must preserve the same declared input correspondence.
// Expected exit: 0

data Pair { kept: i64; other: i64; }

machine choose() -> bool
ensures result == true
{
    true
}

machine read_field(place: &Pair) -> i64
requires place.kept == 17
{
    place.kept
}

machine construct_pair(kept: i64, other: i64) -> Pair {
    Pair { kept: kept, other: other }
}

machine make_pair(kept: i64, other: i64) -> Pair {
    let made: Pair = construct_pair(kept, other);
    transition { _ -> finish(made, other) }
    state finish(pair: Pair, flag: i64) -> Pair {
        transition flag == 0 {
            true -> Pair { kept: pair.kept, other: pair.other }
            false -> Pair { kept: pair.other, other: pair.other }
        }
    }
}

machine main() crashes Trap {
    let chosen: Pair = make_pair(17, 5);
    let spare: Pair = make_pair(0, 8);
    let joined: &Pair = match choose() {
        true -> &chosen
        false -> &spare
    };
    let observed: i64 = read_field(joined);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    state done() {}
    state wrong() { crash Trap; }
}
