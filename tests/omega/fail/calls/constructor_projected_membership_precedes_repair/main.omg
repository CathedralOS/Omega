// The copied constructor child is unissued. A later operand issues the source
// only after that child has completed, so observe must reject the old value.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;
machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Envelope [copy] { ticket: Ticket; }
data Main { envelope: Envelope; }

machine Main::repair(main: &mut Main) -> bool
ensures main.envelope.ticket in Ticket::Issued {
    main.envelope.ticket = Ticket::issue();
    true
}

machine observe(value: Envelope, repaired: bool)
requires value.ticket in Ticket::Issued {}

machine main() {
    let mut holder: Main;
    observe(Envelope { ticket: holder.envelope.ticket }, Main::repair(&mut holder));
}
