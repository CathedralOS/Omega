use omega_language_std::math;

data Counter { calls: u32 in Wrapping; }

machine pair(left: &mut Counter, right: &mut Counter) -> i32 ensures result >= -2 && result <= -2 {
    left.calls = left.calls + 1u32;
    right.calls = right.calls + 1u32;
    -2i32
}

machine main() {
    let mut counter: Counter = Counter { calls: 0u32 };
    let observed: i32 = abs_i32(pair(&mut counter, &mut counter) + 1i32);
}
