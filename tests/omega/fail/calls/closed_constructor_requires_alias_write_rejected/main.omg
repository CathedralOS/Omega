use omega_language_std::console;
data Point [copy] { x: u64; y: u64; }
data Main { point: Point; }
machine Point::zero() -> Point { Point { x: 0, y: 0 } }
machine take(point: Point) -> u64 requires point == Point::zero(); { point.y }
machine mutate(point: &mut Point) { point.x = 1; }
machine Main::main(main: &mut Main) reaches Console {
 main.point = Point { x: 0, y: 0 };
 let alias: &mut Point = &mut main.point;
 mutate(alias);
 let result: u64 = take(main.point);
 Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
