// FAIL CANARY: a mutual machine-call cycle without a joint `terminates by`
// witness is rejected. Decision 23 permits only ranked, tail-position runtime
// SCCs; this unranked pair remains illegal.
use omega::language::std::console;
data Main { console: Console; }
machine Main::scan_a(&mut self, n: u32 in Wrapping) -> u32 in Wrapping {
    transition n < 3 {
        true -> step(n)
        _ -> (99)
    }
    state step(&mut self, n: u32 in Wrapping) {
        let next: u32 in Wrapping = n + 1;
        match n == 2 {
            true -> n
            false -> self.scan_b(next)
        }
    }
}
machine Main::scan_b(&mut self, n: u32 in Wrapping) -> u32 in Wrapping {
    match n < 3 {
        true -> self.scan_a(n)
        false -> (99)
    }
}
machine Main::main(&mut self) {
    let r: u32 in Wrapping = self.scan_a(0);
    transition r == 2 {
        true -> observed()
        _ -> other()
    }
    state observed(&mut self) { self.console.exit_process(70); }
    state other(&mut self)    { self.console.exit_process(71); }
}
