// A value call whose target names NOTHING anywhere used to compile and
// silently bind 0 (ZII) -- `let y: i32 = bogus_fn(1)` took whatever arm the
// zero picked. Now a compile error from the complete value-call resolution.
use omega::language::std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
}
machine Main::main(main: &mut Main) {
    let y: i32 = bogus_fn(1);
    transition y == 0 {
        true -> yes(main)
        false -> no(main)
    }
    state yes(main: &mut Main) { main.console.exit_process(1); }
    state no(main: &mut Main) { main.console.exit_process(2); }
}
