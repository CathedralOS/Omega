// The invalid take requirement rejects before final specification-call totality admission.
use omega_language_std::Console;
data Point [copy] { x: u64; y: u64; }
data Main { }
machine first() -> u64 { second() }
machine second() -> u64 { first() }
machine Point::zero() -> Point { let ignored: u64 = first(); Point { x: 0, y: 0 } }
machine take(point: Point) -> u64 requires core::Identity<Point>(point, Point::zero()) { point.x }
machine Main::main(main: &mut Main) reaches Console { let result: u64 = take(Point { x: 1, y: 0 }); Console::exit_process(0); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
