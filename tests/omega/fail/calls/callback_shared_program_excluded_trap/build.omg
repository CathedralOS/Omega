use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "callback_shared_program_excluded_trap");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::exclude_crash(builder, CrashCause::Trap);

 Build::bind<LineRaster::draw>(builder, windows_x86_64, ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "gdi32.dll", export: "LineDDA" },
    });
}
