use omega_language_std::calling;
use omega_language_std::console;
use omega::language::core::external_binding;
use omega::language::core::binding;

pub data CallbackPolicies { }
pub PointCalling satisfies CallingPolicy {
    CallingPolicy::plan = CallbackPolicies::point;
}
pub LineCalling satisfies CallingPolicy {
    CallingPolicy::plan = CallbackPolicies::line;
}

machine CallbackPolicies::point(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = 3;
    plan.call.parameters[0] = CallbackPolicies::word(4, MachineRegister::X86Rcx);
    plan.call.parameters[1] = CallbackPolicies::word(4, MachineRegister::X86Rdx);
    plan.call.parameters[2] = CallbackPolicies::word(8, MachineRegister::X86R8);
    let mut callback: BoundaryEntryPlan = CallbackPolicies::finish(plan);
    // Keep the genuine Microsoft argument geometry, with a stronger R10/XMM5
    // preservation promise than the ordinary body. This requires an adapter.
    callback.call.ordinary_clobbers.registers[5] = callback.call.ordinary_clobbers.registers[11];
    callback.call.ordinary_clobbers.register_count = 11;
    BoundaryPlanResult::Accepted { plan: callback }
}

machine CallbackPolicies::line(signature: BoundarySignature) -> BoundaryPlanResult
satisfies CallingPolicy::plan
{
    let mut plan: BoundaryEntryPlan;
    plan.call.parameter_count = signature.native_parameter_count;
    plan.call.parameters[0] = CallbackPolicies::word(4, MachineRegister::X86Rcx);
    plan.call.parameters[1] = CallbackPolicies::word(4, MachineRegister::X86Rdx);
    plan.call.parameters[2] = CallbackPolicies::word(4, MachineRegister::X86R8);
    plan.call.parameters[3] = CallbackPolicies::word(4, MachineRegister::X86R9);
    plan.call.parameters[4] = CallbackPolicies::stack_word(32);
    plan.call.parameters[5] = CallbackPolicies::stack_word(40);
    plan.call.has_result = true;
    plan.call.result = CallbackPolicies::word(4, MachineRegister::X86Rax);
    plan.call.callback_materialization_count = signature.callback_demand_count;
    plan.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
    plan.call.callback_materializations[0].destination = signature.callback_demands[0].destination;
    BoundaryPlanResult::Accepted { plan: CallbackPolicies::finish(plan) }
}

machine CallbackPolicies::word(bytes: u64, register: MachineRegister) -> ValuePlacement {
    let mut placement: ValuePlacement;
    placement.shape.class = AbiValueClass::Integer;
    placement.shape.byte_size = bytes;
    placement.shape.alignment = bytes;
    placement.location_count = 1;
    placement.locations[0] = ValueLocation::Register {
        register: register, value_byte_offset: 0, byte_size: bytes,
    };
    placement
}

machine CallbackPolicies::stack_word(offset: u64) -> ValuePlacement {
    let mut placement: ValuePlacement;
    placement.shape.class = AbiValueClass::Integer;
    placement.shape.byte_size = 8;
    placement.shape.alignment = 8;
    placement.location_count = 1;
    placement.locations[0] = ValueLocation::Stack {
        stack_byte_offset: offset, value_byte_offset: 0, byte_size: 8, alignment: 8,
    };
    placement
}

machine CallbackPolicies::finish(output: BoundaryEntryPlan) -> BoundaryEntryPlan {
    let mut plan: BoundaryEntryPlan = output;
    plan.call.convention = CallingConvention::MicrosoftX64;
    plan.call.stack_alignment = 16;
    plan.call.shadow_bytes = 32;
    plan.call.entry_control = EntryControl::CallReturn;
    plan.call.ordinary_clobbers.register_count = 13;
    plan.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
    plan.call.ordinary_clobbers.registers[3] = MachineRegister::X86R8;
    plan.call.ordinary_clobbers.registers[4] = MachineRegister::X86R9;
    plan.call.ordinary_clobbers.registers[5] = MachineRegister::X86R10;
    plan.call.ordinary_clobbers.registers[6] = MachineRegister::X86R11;
    plan.call.ordinary_clobbers.registers[7] = MachineRegister::X86Xmm { index: 0 };
    plan.call.ordinary_clobbers.registers[8] = MachineRegister::X86Xmm { index: 1 };
    plan.call.ordinary_clobbers.registers[9] = MachineRegister::X86Xmm { index: 2 };
    plan.call.ordinary_clobbers.registers[10] = MachineRegister::X86Xmm { index: 3 };
    plan.call.ordinary_clobbers.registers[11] = MachineRegister::X86Xmm { index: 4 };
    plan.call.ordinary_clobbers.registers[12] = MachineRegister::X86Xmm { index: 5 };
    plan.state.initial_regime = MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = EntryStack::ProviderSelected;
    plan.state.preemption = Preemption::NotApplicable;
    plan
}

pub data CallbackState [copy] {
    observed: bool;
    last_x: i32;
    last_y: i32;
}
pub boundary trait PointProcedure: Calling<PointCalling> {
    machine visit(x: i32, y: i32, context: &mut CallbackState) crashes Trap;
}
pub boundary trait LineRaster: Calling<LineCalling> {
    machine draw<machine Handler>(
        start_x: i32, start_y: i32, end_x: i32, end_y: i32,
        native callback point from Handler, context: &mut CallbackState
    ) -> i32
    where machine Handler satisfies PointProcedure::visit;
    invokes PointProcedure;
}

pub data PointHandler { }
pub machine PointHandler::visit(x: i32, y: i32, context: &mut CallbackState)
satisfies PointProcedure::visit
crashes Trap
{
    crash Trap;
}

windows_x86_64 machine line_binding() -> ForeignBinding<9, 7, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName { library: "gdi32.dll", export: "LineDDA" },
    }
}
windows_x86_64 machine line_leaf<machine Selected>(
    start_x: i32, start_y: i32, end_x: i32, end_y: i32,
    context: &mut CallbackState
) -> i32
where machine Selected satisfies PointProcedure::visit;
satisfies LineRaster::draw
via line_binding();

data Main { context: CallbackState; console: Binding<Console>; line_raster: Binding<LineRaster>; }
machine Main::main(main: &mut Main) reaches LineRaster + PointProcedure + Console
invokes LineRaster;
invokes Console;
{
    main.context = CallbackState { observed: false, last_x: 0, last_y: 0 };
    let status: i32 = LineRaster::draw<PointHandler::visit>(&main.line_raster, 2, 4, 5, 4, &mut main.context);
    transition status != 0 && main.context.observed
        && main.context.last_x == 4 && main.context.last_y == 4 {
        true -> done(&main.console)
        _ -> failed(&main.console)
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 0); }
    state failed(console: &Binding<Console>) { Console::exit_process(console, 71); }
}
