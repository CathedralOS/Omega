data Counter { hits: u32 in Wrapping; }

machine produce(value: u32, counter: &mut Counter) -> u32
requires value <= 21
ensures result <= 21 {
    counter.hits = counter.hits + 1;
    value
}

machine accept(value: u32)
requires value <= 20 {}

machine main() {
    let mut counter: Counter = Counter { hits: 0 };
    accept(produce(21, &mut counter));
}
