// V1: VOID callee in VALUE position -- `let r: i32 = main.act()`.
use omega::language::std::console;
use omega::language::core::binding;
data Main {
    console: Binding<Console>;
    n: i32;
}
machine Main::act(main: &mut Main) {
    main.n = 5;
}
machine Main::main(main: &mut Main) {
    let r: i32 = Main::act(main);
    transition r == 0 {
        true -> yes(main)
        false -> no(main)
    }
    state yes(main: &mut Main) { main.console.exit_process(1); }
    state no(main: &mut Main) { main.console.exit_process(2); }
}
