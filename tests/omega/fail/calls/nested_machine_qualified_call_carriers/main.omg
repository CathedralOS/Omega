// Qualification cannot reach a nested machine from outside its enclosing
// machine. Each carrier names a different private helper of `outer`: a value
// call, a dispatch subject, a generic call with static arguments, and a
// terminal call. Each is refused at the call for that rule.
machine outer<T>(value: u64, item: T) -> u64 {
    let kept: T = generic_helper<T>(item);
    let same: u64 = subject_helper(value);
    terminal_helper(value_helper(same))
    machine value_helper(item: u64) -> u64 { item }
    machine subject_helper(item: u64) -> u64 { item }
    machine generic_helper<U>(item: U) -> U { item }
    machine terminal_helper(item: u64) -> u64 { item }
}
machine main() crashes Trap {
    let value: u64 = outer::value_helper(42);
    let kept: u64 = outer::generic_helper<u64>(value);
    transition outer::subject_helper(kept) == 42 { true -> finish(kept) _ -> bad() }
    machine finish(value: u64) { let relayed: u64 = relay(value); }
    machine bad() crashes Trap { crash Trap; }
}
machine relay(value: u64) -> u64 {
    transition { _ -> outer::terminal_helper(value) }
}
