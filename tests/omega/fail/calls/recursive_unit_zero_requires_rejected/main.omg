// Permitting a cyclic callable roster must preserve call preconditions.
use omega_language_std::console;
machine recurse(value: u64)
requires value > 0
{
    transition value > 1 { true -> next(value) false -> done() }
    machine next(value: u64) { recurse(value - 1); }
    machine done() { }
}
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    recurse(0);
    Console::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
