// Permitting a cyclic callable roster must preserve call preconditions.
use omega_language_std::console;
use omega::language::core::binding;
machine recurse(value: u64)
requires value > 0
{
    transition value > 1 { true -> next(value) false -> done() }
    state next(value: u64) { recurse(value - 1); }
    state done() { }
}
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    recurse(0);
    Console::exit_process(&main.console, 0);
}
