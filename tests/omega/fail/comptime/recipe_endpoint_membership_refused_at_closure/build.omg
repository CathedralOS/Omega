machine build(builder: &mut Build) {
    Build::application(builder, "recipe_endpoint_membership_refused_at_closure");
    Build::select_provider<Math, Provider>(builder, linux_arm64);
    Build::select_provider<Math, Provider>(builder, linux_x86_64);
    Build::select_provider<Math, Provider>(builder, macos_arm64);
    Build::select_provider<Math, Provider>(builder, macos_x86_64);
    Build::select_provider<Math, Provider>(builder, windows_x86_64);
    Build::select_provider<Math, Provider>(builder, uefi_x86_64);
    Build::select_provider<Math, Provider>(builder, cross_platform_cli);
    Build::select_provider<Math, Provider>(builder, local_unchecked);
    Build::select_provider<Math, Provider>(builder, alpha_bootstrap);
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
}
