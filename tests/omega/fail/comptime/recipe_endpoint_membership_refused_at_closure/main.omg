// A declared range endpoint that is a provider-dependent constant recipe
// keeps its membership obligation through the shared judgment: the argument
// 9 must be at most `limit()`, and the target closure, which runs the
// selected provider body to 7, refuses the call instead of admitting an
// unbounded parameter.
use omega_language_std::console;

data Math {}

boundary machine % Math::remainder(left: u64, right: u64) -> u64;

data Provider {}

machine Provider::remainder(left: u64, right: u64) -> u64
satisfies Math::remainder
{
    transition { _ -> (left | right) }
}

machine limit() -> u64 {
    let left: u64 = 7;
    let right: u64 = 2;
    transition { _ -> (left % right) }
}

machine take_bounded(value: u64[0..=limit()]) -> u64 { value }

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let bounded: u64 = take_bounded(9);
    Console::exit_process(70);
}
