// A declared range endpoint that is a provider-dependent constant recipe
// keeps its membership obligation through the shared judgment: the argument
// 9 must be at most `limit()`, and the target closure, which runs the
// selected provider body to 7, refuses the call instead of admitting an
// unbounded parameter.
use omega_language_std::console;

public boundary trait Math {
    machine remainder(left: u64, right: u64) -> u64 reaches terminates;
}
public Provider satisfies Math {
    machine remainder(left: u64, right: u64) -> u64 { left | right }
}
trait Remainder {
    machine % remainder(left: u64, right: u64) -> u64;
}
BoundaryRemainder satisfies Remainder {
    machine remainder(left: u64, right: u64) -> u64 {
        Math::remainder(left, right)
    }
}
machine selected_remainder<Operations satisfies Remainder>(left: u64, right: u64) -> u64 {
    left % right
}

machine limit() -> u64 {
    let left: u64 = 7;
    let right: u64 = 2;
    transition { _ -> (selected_remainder<BoundaryRemainder>(left, right)) }
}

machine take_bounded(value: u64) -> u64 requires value <= limit() { value }

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let bounded: u64 = take_bounded(9);
    Console::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
