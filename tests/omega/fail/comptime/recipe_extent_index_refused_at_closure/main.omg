// A fixed array whose extent is a provider-dependent constant recipe keeps
// its index obligation through the shared judgment: checking records that
// the index 8 must lie below `slot_count()`, and the target closure, which
// evaluates the recipe to 8 under the selected Float meaning, refuses the
// store instead of trusting a guessed extent.
use omega::language::core::float_operations;
use omega_language_std::console;

machine slot_count() -> u64 {
    let half: f32 in Saturating = 0.5f32;
    let whole: f32 = Float::add(half, half) as f32;
    transition whole == 1.0f32 { true -> 8 _ -> 0 }
}

data Main {
    slots: [u8; slot_count()];
}

machine Main::main(main: &mut Main) reaches Console {
    main.slots[8] = 63;
    Console::exit_process(70);
}
