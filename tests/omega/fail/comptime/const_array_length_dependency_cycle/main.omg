data FirstStorage { slots: [u8; first_size()]; }
data SecondStorage { slots: [u8; second_size()]; }

machine first_size() -> u64 {
    let storage: SecondStorage = SecondStorage {};
    storage.slots.len
}

machine second_size() -> u64 {
    let storage: FirstStorage = FirstStorage {};
    storage.slots.len
}

machine main() { }
