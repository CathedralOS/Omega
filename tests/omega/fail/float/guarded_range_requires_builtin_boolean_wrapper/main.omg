// Even a Boolean wrapper owes its selected equality meaning before its
// operand can be treated as a true IEEE comparison.
// The operator's declared home: bare primitive operands would join the
// core's primitive operator family, which only the core may publish.
public domain bool::Flag;
public boundary machine == Unrelated::equal(left: bool in Flag, right: bool in Flag) -> bool;
machine select(value: f64) -> f64 {
    transition (((value >= 0.0 && value <= 1.0) as bool in Flag) == (true as bool in Flag)) {
        true -> bounded(value)
        _ -> 0.0
    }
    machine bounded(value: f64) -> f64
        requires value >= 0.0 && value <= 1.0
    {
        value
    }
}
machine main() {}
