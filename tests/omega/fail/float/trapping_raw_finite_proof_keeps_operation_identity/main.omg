use omega::language::core::float_operations;

machine scale(value: f32 in Trapping) -> f32 in Trapping
requires F32::is_finite((value as f32) * 2.0f32)
crashes Trap false {
    value / 0.0f32
}

// A finite source in the wider format does not prove the narrowed result finite.
machine wrong_format(value: f64 in Trapping) -> f32 in Trapping
requires F64::is_finite(value as f64)
crashes Trap false {
    F32::from_f64(value)
}
