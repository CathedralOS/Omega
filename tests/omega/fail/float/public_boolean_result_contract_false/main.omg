use omega::language::core::F32::is_finite;

// Returning false cannot establish the public finite predicate for all values.
machine finite(value: f32) -> bool
ensures result == F32::is_finite(value) {
    false
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    transition observed {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
