data Reading { value: f64; }
machine overwrite(value: &mut f64) -> bool {
    let zero: f64 = 0.0;
    value = zero / zero;
    true
}
machine mutating_guard(reading: &mut Reading) -> f64 {
    transition {
        reading.value >= 0.0 && reading.value <= 1.0
            && overwrite(&mut reading.value) -> bounded(reading.value)
        _ -> 0.0
    }
    state bounded(changed: f64 [0.0..=1.0]) -> f64 { changed }
}
machine stale_guard(value: f64) -> f64 {
    let mut current: f64 = value;
    let accepted: bool = current >= 0.0 && current <= 1.0;
    let zero: f64 = 0.0;
    current = zero / zero;
    transition accepted { true -> bounded(current) _ -> 0.0 }
    state bounded(stale: f64 [0.0..=1.0]) -> f64 { stale }
}
machine reassigned_guard(value: f64) -> f64 {
    let mut accepted: bool = value >= 0.0 && value <= 1.0;
    accepted = true;
    transition accepted { true -> bounded(value) _ -> 0.0 }
    state bounded(reassigned: f64 [0.0..=1.0]) -> f64 { reassigned }
}
machine change_index(index: &mut u64 [0..2]) -> bool { index = 1; true }
machine changed_selector(values: &[f64; 2]) -> f64 {
    let mut selected: u64 [0..2] = 0;
    transition {
        values[selected] >= 0.0 && values[selected] <= 1.0
            && change_index(&mut selected) -> bounded(values[selected])
        _ -> 0.0
    }
    state bounded(selected: f64 [0.0..=1.0]) -> f64 { selected }
}
machine main() {}
