machine overwrite(value: &mut f64) -> bool {
    let zero: f64 = 0.0;
    value = zero / zero;
    true
}
machine mutating_guard(reading: &mut f64) -> f64 {
    transition {
        reading >= 0.0 && reading <= 1.0
            && overwrite(reading) -> bounded(reading)
        _ -> 0.0
    }
    machine bounded(changed: f64) -> f64
        requires changed >= 0.0 && changed <= 1.0
    { changed }
}
machine stale_guard(value: f64) -> f64 {
    let mut current: f64 = value;
    let accepted: bool = current >= 0.0 && current <= 1.0;
    let zero: f64 = 0.0;
    current = zero / zero;
    transition accepted { true -> bounded(current) _ -> 0.0 }
    machine bounded(stale: f64) -> f64
        requires stale >= 0.0 && stale <= 1.0
    { stale }
}
machine reassigned_guard(value: f64) -> f64 {
    let mut accepted: bool = value >= 0.0 && value <= 1.0;
    accepted = true;
    transition accepted { true -> bounded(value) _ -> 0.0 }
    machine bounded(reassigned: f64) -> f64
        requires reassigned >= 0.0 && reassigned <= 1.0
    { reassigned }
}
machine change_index(index: &mut u64) -> bool { index = 1; true }
machine changed_selector(values: &[f64; 2]) -> f64 {
    let mut selected: u64 = 0;
    transition {
        values[selected] >= 0.0 && values[selected] <= 1.0
            && change_index(&mut selected) -> bounded(values[selected])
        _ -> 0.0
    }
    machine bounded(selected: f64) -> f64
        requires selected >= 0.0 && selected <= 1.0
    { selected }
}
machine main() {}
