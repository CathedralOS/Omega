use omega::language::core::F32::from_f64;

// Twin of pass/float/format_conversion_proved_finite_return_exit: each
// returning arm's guard bounds the narrowed value from above only, so
// `-inf` (from a large negative input) still reaches a `Finite` return,
// whether the arm comes first or last.
machine early(value: f64) -> f32 in Finite {
    let narrowed: f32 = F32::from_f64(value);
    transition narrowed < 3.0e38f32 {
        true -> (narrowed)
        _ -> (0.25f32)
    }
}
machine late(value: f64) -> f32 in Finite {
    let narrowed: f32 = F32::from_f64(value);
    transition narrowed < 3.0e38f32 {
        false -> (0.25f32)
        true -> (narrowed)
    }
}
