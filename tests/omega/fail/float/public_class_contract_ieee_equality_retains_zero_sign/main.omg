use omega::language::core::float_operations;

// IEEE equality admits either signed zero. It supplies no positive-sign
// identity with which to replace the original classification subject.
machine category(value: f32) -> FloatClass
requires value == 0.0f32
ensures result == F32::classify(value) {
    FloatClass::Zero { negative: false }
}

machine main() crashes Trap {
    let observed: FloatClass = category(-0.0f32);
    transition observed {
        FloatClass::Zero { negative: true } -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
