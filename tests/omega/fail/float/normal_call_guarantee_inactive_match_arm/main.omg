use omega::language::core::float_operations;

// Its guarantee holds only after a normal return. The false path crashes.
machine only_true(value: bool) -> bool
ensures value == true
crashes Trap {
    transition value {
        true -> (true)
        false -> stopped()
    }
    state stopped() { crash Trap; }
}

// A skipped call cannot make the hypotheses contradictory and prove this law.
machine invalid(value: f32) -> bool
ensures result == FloatSemantics::is_finite(Float::meaning32(value))
crashes Trap {
    let ignored: bool = match false { true -> only_true(false), false -> false };
    transition { _ -> (false) }
}

machine main() crashes Trap {
    let observed: bool = invalid(1.0f32);
}
