use omega::language::core::float_operations;

data FloatSlot { value: f32; }

machine repair(slot: &mut FloatSlot) -> bool {
    slot.value = 0.0f32;
    true
}

machine finite_captured(value: f32, repaired: bool)
requires F32::is_finite(value) {}

// The first actual is an unconstrained Float snapshot. Repairing its source
// during the second actual cannot supply that earlier value's classification.
machine main(value: f32) {
    let mut slot: FloatSlot = FloatSlot { value: value };
    finite_captured(slot.value, repair(&mut slot));
}
