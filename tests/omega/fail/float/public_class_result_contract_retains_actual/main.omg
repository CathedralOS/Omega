use omega::language::core::float_operations;

// Both actuals are zeros; the classification still retains their own signs.
machine category(value: f32, other: f32) -> FloatClass
ensures result == F32Classify::classify(value) {
    F32Classify::classify(other)
}

machine main() crashes Trap {
    let observed: FloatClass = category(0.0f32, -0.0f32);
    transition observed {
        FloatClass::Zero { negative: false } -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
