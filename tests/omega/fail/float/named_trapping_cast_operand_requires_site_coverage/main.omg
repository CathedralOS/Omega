use omega::language::core::float_operations;

// Explicit argument qualification selects the same result adapter as a named
// qualified input. The raw overflow cannot fit the false Trap ceiling.
machine overflow() -> f32 in Trapping
crashes Trap false {
    F32::multiply_then_add(3.4028234663852886e38f32 as f32 in Trapping, 2.0f32, 0.0f32)
}
machine main() {}
