use omega::language::core::float_operations;

machine finite_value(value: f32) -> f32
requires F32::is_finite(value) { value }

// Finiteness applies only after this addition completes. It cannot cover
// the overflowing source operation under the explicitly false crash ceiling.
machine converted(value: u8 in Trapping) -> f32
crashes Trap false {
    finite_value(F32::from_u8(value + (10u8 as u8 in Trapping)))
}

machine main() {
    let value: f32 = converted(250u8 as u8 in Trapping);
}
