// The inclusive upper guard admits exactly 2^64, outside u64.
use omega::language::core::float_operations;
machine convert(values: &[f64; 2], index: u64) -> u64
requires index < 2,
{
    let accepted: bool = values[index] >= 0.0 && values[index] <= 18446744073709551616.0;
    transition accepted {
        true -> finish(U64::from_f64(values[index]))
        false -> finish(0)
    }
    state finish(converted: u64) -> u64 { converted }
}
machine main() {}
