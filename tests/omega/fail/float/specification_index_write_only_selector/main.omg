// A precondition may not index with a write-only selector. A plain `u8`
// selector would be in bounds for 256 elements by its carrier alone, but
// `&write u8` storage is never observed, so `values[position]` has no
// readable selector value and the precondition cannot be formed.
machine probe(values: &[u64; 256], position: &write u8) -> u64
requires values[position] >= 0
{
    0
}
machine main() {}
