use omega::language::core::float_operations;
machine admit(value:f64)->f64 requires value>=0.0 && value<=0.5 {value}
// The entry fact covers values[start]; after the selector changes, the
// read of values[position] no longer has it, so admit's requirement fails.
machine probe(values:&[f64;2], start:u64)->f64
requires start < 2 && values[start]>=0.0 && values[start]<=0.25
{let mut position:u64=start;position=1;let observed:f64=match true {true->values[position],false->values[position]};admit(observed)}
