// Frozen assumption control: a detached f32 copy keeps its capture epoch across a later write through its original i32 storage.
// Expected rejection for the reachable uncovered Trap route; probe is not executed.
machine forward(value: f32, ignored: u64) -> f32
crashes Trap value != 0.0
{
    transition value != 0.0 { true -> bad() false -> (value) }
    machine bad() -> f32 { crash Trap; }
}
public machine probe() -> u64 {
    let mut source: i32 = 1065353216;
    let view: &f32 = &source as &f32;
    let detached: f32 = view;
    source = 0;
    let second: f32 = detached;
    let captured: f32 = forward(second, 0);
    0
}

machine main() {}
