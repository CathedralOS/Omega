use omega::language::core::float_operations;

// The same runtime shape and leaf name grant no sealed FloatSemantics law.
data Counterfeit {}

machine Counterfeit::is_finite(value: f32) -> bool {
    false
}

machine finite(value: f32) -> bool
ensures result == F32::is_finite(value) {
    Counterfeit::is_finite(value)
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    transition observed {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
