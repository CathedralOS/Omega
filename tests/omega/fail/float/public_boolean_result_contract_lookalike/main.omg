use omega::language::core::float_operations;

// The same runtime shape and leaf name grant no sealed FloatSemantics law.
data Counterfeit {}

machine Counterfeit::is_finite(value: f32) -> bool {
    false
}

machine finite(value: f32) -> bool
ensures result == FloatSemantics::is_finite(Float::meaning32(value)) {
    Counterfeit::is_finite(value)
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    transition observed {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
