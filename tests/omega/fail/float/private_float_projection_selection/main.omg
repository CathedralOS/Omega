use omega::language::core::float_operations;

// The public slot's exact Boolean guarantee must survive caller import.
machine finite(value: f32) -> bool
ensures result == FloatSemantics::is_finite(Float::meaning32(value)) {
    F32::is_finite(value)
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32);
    transition observed {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
