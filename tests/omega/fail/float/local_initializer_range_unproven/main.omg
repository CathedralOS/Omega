// A local's declared range is owed by its initializer, the local's first
// store, as an assignment owes it (ounded = 20.0 was already refused).
// The initializer of let bounded: f64 [0.0..=0.5] was never proven: a
// literal 20.0 and an unconstrained parameter both compiled, and every later
// read trusted the range.
machine literal() -> f64
    ensures result >= 0.0 && result <= 0.5
{
    let bounded: f64 = 20.0;
    bounded
}

machine forwarded(value: f64) -> f64
    ensures result >= 0.0 && result <= 0.5
{
    let bounded: f64 = value;
    bounded
}

machine main() {
    _ = literal();
    _ = forwarded(20.0);
}
