// Route control: the matrix's arithmetic position keeps the same operand format.
// `d + e` with an f64 left operand and an f32 right operand has no route.
// Expected diagnostic: cannot combine
machine main() crashes Trap {
    let mut d: f64 = 2.0;
    let mut e: f32 = 2.0;
    let mut sum: f64 = d + e;
    transition sum == 4.0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
