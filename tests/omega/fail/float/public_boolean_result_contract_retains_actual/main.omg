use omega::language::core::F32::is_finite;

// The return observes other, while the published relation names value.
machine finite(value: f32, other: f32) -> bool
ensures result == F32::is_finite(value) {
    F32::is_finite(other)
}

machine main() crashes Trap {
    let observed: bool = finite(1.0f32, 0.0f32 / 0.0f32);
    transition observed {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
