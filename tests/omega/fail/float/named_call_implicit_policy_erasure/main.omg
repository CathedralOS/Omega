use omega::language::core::float_operations;

// This user-owned named boundary requirement has the same apparent float
// carrier shape as a core operation. Its F32 namespace grants no sealed policy
// adaptation, so Saturating actuals cannot enter its declared bare parameters.
boundary operator F32::combine(left: f32, right: f32, addend: f32) -> f32;

machine invalid(value: f32 in Saturating) {
    let result: f32 in Saturating = F32::combine(value, value, value);
}

data Main {}
machine Main::main(main: &mut Main) { invalid(2.0f32 as f32 in Saturating); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
