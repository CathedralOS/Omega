use omega::language::core::float_operations;

machine saturating_increment(value: f32) -> u8 in Saturating {
    let converted: u8 in Saturating = U8::from_f32(value);
    converted + (10u8 as u8 in Saturating)
}

// The body wraps before selecting the result policy. This cannot satisfy the
// helper's saturated result even though every conversion and proof call is total.
machine increment(value: f32) -> u8 in Saturating
ensures result == saturating_increment(value) {
    let converted: u8 in Saturating = U8::from_f32(value);
    ((converted as u8 in Wrapping) + (10u8 as u8 in Wrapping)) as u8 in Saturating
}

machine main() crashes Trap {
    let observed: u8 in Saturating = increment(250.0f32);
    transition observed == 255u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
