// A selected boundary with the same token and carrier supplies no IEEE law.
public boundary machine < Unrelated::less(left: f64, right: f64) -> bool;
public boundary machine + Unrelated::add(left: u64, right: u64) -> u64
    ensures result < 2;
machine select(value: f64) -> f64 {
    transition value >= 0.0 && value < 1.0 {
        true -> bounded(value)
        _ -> 0.0
    }
    machine bounded(value: f64) -> f64
        requires value >= 0.0 && value <= 1.0
    { value }
}
// Authored addition need not select element zero, despite its constant spelling.
machine coordinate(values: &[f64; 2]) -> f64 {
    let zero: u64 = 0;
    transition values[zero + 0u64] >= 0.0 && values[zero + 0u64] <= 1.0 {
        true -> bounded(values[0])
        _ -> 0.0
    }
    machine bounded(selected: f64) -> f64
        requires selected >= 0.0 && selected <= 1.0
    { selected }
}
machine main() {}
