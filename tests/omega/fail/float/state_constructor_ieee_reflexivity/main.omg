// Preparing a recursive constructor's type grants no identity-equality law.
// The state parameter is IEEE even though the entry reuses its name for u32.
data Chain<T> {
    case Empty;
    case Cons(head: T, tail: Chain<T>);
}

machine invalid(value: u32, tail: Chain<f64>) {
    transition { _ -> conclude(0.0f64 / 0.0f64, tail) }
    machine conclude(value: f64, tail: Chain<f64>)
    requires
        (Chain::Cons { head: value, tail: Chain::Cons { head: value, tail: tail } })
        == (Chain::Cons { head: value, tail: Chain::Cons { head: value, tail: tail } })
    {}
}

machine main() {}
