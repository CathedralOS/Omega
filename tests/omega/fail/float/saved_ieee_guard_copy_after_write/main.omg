use omega::language::core::float_operations;
// A copy made after a write observes the new value, not the earlier guard.
machine convert(value: f64) -> i32 {
    let mut current: f64 = value;
    let accepted: bool = current == current && current >= 0.0 && current < 1000000000.0;
    current = 200000000000000000000.0;
    let copied: f64 = current;
    transition accepted {
        true -> finish(I32::from_f64(copied))
        false -> zero()
    }
    state finish(observed: i32) -> i32 { observed }
    state zero() -> i32 { 0 }
}
machine main() {}
