// Exchanging multiplier and addend proves a different operation contract.
use omega::language::core::float_operations;
use omega::language::core::float_semantics;

machine software32(left: f32, right: f32, addend: f32) -> f32
satisfies F32::multiply_then_add
ensures core::Identity<FloatMeaning>(F32::meaning(result),
    FloatSemantics::multiply_then_add(FloatFormat::BINARY32,
        F32::meaning(left), F32::meaning(addend), F32::meaning(right)))
{
    F32::multiply_then_add(left, addend, right)
}

machine software64(left: f64, right: f64, addend: f64) -> f64
satisfies F64::multiply_then_add
ensures core::Identity<FloatMeaning>(F64::meaning(result),
    FloatSemantics::multiply_then_add(FloatFormat::BINARY64,
        F64::meaning(left), F64::meaning(addend), F64::meaning(right)))
{
    F64::multiply_then_add(left, addend, right)
}

machine main() {}
