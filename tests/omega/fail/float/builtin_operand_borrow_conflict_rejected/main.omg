use omega_language_std::math;

use omega::language::core::float_operations;
data Values {x:f64;}
data Main {values:Values;}
machine pair(left:&mut Values,right:&Values)->f64 {left.x+right.x}
machine Main::main(main:&mut Main) {
 let value:f64=abs_f64(pair(&mut main.values,&main.values));
 main.values.x=value;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
