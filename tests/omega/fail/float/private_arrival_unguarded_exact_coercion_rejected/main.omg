// Invalid: the private `convert` gains a second arrival from the unguarded arm,
// so `value == 3.0` no longer holds on every arrival and the Exact cast cannot
// prove the operand integral.

machine guarded(value: f64) -> i32 {
    transition value == 3.0 { true -> convert(value) false -> convert(value) }
    machine convert(value: f64) -> i32 { value as i32 }
}

machine main() crashes Trap {
    let observed: i32 = guarded(3.0);
    transition observed == 3 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
