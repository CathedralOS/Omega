use omega::language::core::float_operations;

machine scale(value: f32 in Trapping, allow: bool) -> f32 in Trapping
crashes Trap allow {
    transition allow {
        false -> risky(value)
        _ -> 0.0f32 as f32 in Trapping
    }
    machine risky(value: f32 in Trapping) -> f32 in Trapping {
        value * 2.0f32
    }
}
