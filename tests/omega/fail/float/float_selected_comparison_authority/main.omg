public trait Equality<T> { operator == related(left: T, right: T) -> bool; }
Always satisfies Equality<f64> {
    machine related(left: f64, right: f64) -> bool { true }
}

// A selected arbitrary relation is not evidence of IEEE equality.
boundary machine supply<Relation satisfies Equality<f64>>(value: f64) -> f64
ensures result == value;

machine require_one(value: f64)
requires value == 1.0
{}

machine probe() { require_one(supply<Always>(1.0)); }
machine main() {}
