use omega::language::core::float_operations;

machine rounded32() -> f32 { 16777217i32 as f32 in Saturating as f32 }
machine rounded64() -> f64 { 9007199254740993i64 as f64 in Trapping as f64 }
machine unsigned_loss() -> f64 {
    let value: u64 = 18446744073709551615u64;
    value as f64
}
machine unknown(value: i64) -> f64 { value as f64 }
machine endpoints_are_not_enough(value: i64) -> f64
requires value >= 18014398509481984i64 && value <= 18014398509481988i64
{ value as f64 in Wrapping as f64 }

data Sample { value: i64; converted: f64; }
machine stale_guard(sample: &mut Sample) {
    transition sample.value == 18014398509481984i64 {
        true -> guarded(sample)
        false -> done()
    }
    machine guarded(sample: &mut Sample) {
        sample.value = 18014398509481985i64;
        sample.converted = sample.value as f64;
    }
    machine done() {}
}
