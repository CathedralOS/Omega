// False ordered comparisons also admit NaN. Neither a negation nor a
// refuted earlier exit establishes membership in an ordered range.
machine negated_bounds(unordered: f64) -> f64 {
    transition !(unordered < 0.0) && !(unordered > 1.0) {
        true -> bounded(unordered)
        _ -> 0.0
    }
    state bounded(negated: f64 [0.0..=1.0]) -> f64 { negated }
}
machine false_exit_bounds(unordered: f64) -> f64 {
    transition {
        unordered < 0.0 -> outside()
        unordered > 1.0 -> outside()
        _ -> bounded(unordered)
    }
    state outside() -> f64 { 0.0 }
    state bounded(prior: f64 [0.0..=1.0]) -> f64 { prior }
}
machine inequality_is_not_ordered(unordered: f64) -> f64 {
    transition unordered != 2.0 && !(unordered < 0.0) && !(unordered > 1.0) {
        true -> bounded(unordered)
        _ -> 0.0
    }
    state bounded(inequality: f64 [0.0..=1.0]) -> f64 { inequality }
}
machine nan_only(unordered: f64) -> f64 {
    transition !(unordered < 1.0) && !(unordered > 0.0) {
        true -> bounded(unordered)
        _ -> 0.0
    }
    state bounded(empty_ordered: f64 [0.0..=1.0]) -> f64 { empty_ordered }
}
machine narrow_negation(unordered: f32) -> f32 {
    transition !(unordered < 0.0f32) && !(unordered > 1.0f32) {
        true -> bounded(unordered)
        _ -> 0.0f32
    }
    state bounded(narrow: f32 [0.0f32..=1.0f32]) -> f32 { narrow }
}
machine wrong_subject(ordered: f64, unordered: f64) -> f64 {
    transition ordered >= 0.0 && ordered <= 1.0 {
        true -> bounded(unordered)
        _ -> 0.0
    }
    state bounded(other: f64 [0.0..=1.0]) -> f64 { other }
}
machine integer_view(unordered: f64) -> f64 {
    transition (&unordered as &u64) == (&unordered as &u64)
        && !(unordered < 0.0) && !(unordered > 1.0) {
        true -> bounded(unordered)
        _ -> 0.0
    }
    state bounded(recast: f64 [0.0..=1.0]) -> f64 { recast }
}
machine main() {}
