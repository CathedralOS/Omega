// Different landed floating formats do not implicitly convert in comparisons.
machine direct(left: f64, right: f32) -> bool { left == right }
machine guarded(left: f64, right: f32) -> bool {
    transition left < right { true -> true _ -> false }
}
machine literal(value: f64) -> bool { value == 7.0f32 }
machine reversed(value: f64) -> bool { 7.0f32 >= value }
data Pair { wide: f64; narrow: f32; }
machine fields(pair: &Pair) -> bool { pair.wide != pair.narrow }
machine selected(value: f64, values: &[f32; 2]) -> bool { value <= values[0] }
