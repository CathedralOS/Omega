use omega::language::core::float_operations;

// Computing or casting an argument grants no authority to this user-owned
// named requirement. An F32 namespace and bare float signature do not make it
// a sealed core policy adapter; its parameters remain the declared bare f32.
boundary operator F32::combine(left: f32, right: f32, addend: f32) -> f32;

machine invalid(value: f32 in Saturating) {
    let result: f32 in Saturating = F32::combine(
        value * value, value as f32 in Saturating, value
    );
}
