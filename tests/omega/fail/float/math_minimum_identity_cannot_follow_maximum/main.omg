// A maximum result does not establish the minimum helper's meaning.
use omega::language::core::math;
use omega::language::core::float_operations;

machine wrong_minimum(left: f64, right: f64) -> f64
ensures core::Identity<FloatMeaning>(
    F64::meaning(result),
    FloatSemantics::minimum(F64::meaning(left), F64::meaning(right)))
{
    max_f64(left, right)
}

machine main() {}
