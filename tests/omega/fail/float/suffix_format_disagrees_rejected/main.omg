// F2a's loud edge (the float twin of the integer suffix check): a width
// suffix chooses the literal's FORMAT at the spelling, so a destination
// declaring the other format is an error -- an f32-suffixed literal in an
// f64 place would silently mean the f32-rounded value.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) {
    let x: f64 = 1.5f32;
    Console::exit_process(70);
}
