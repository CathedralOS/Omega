// The specification_index_reference_selector_exit program without the
// `position < 2` conjuncts: nothing bounds the borrowed selectors before
// `values[position]` is formed, so the precondition cannot be formed.
machine admit(value: f64) -> f64 requires value >= 0.0 && value <= 0.5 { value }
machine probe(values: &[f64; 2], position: &mut u64) -> f64
requires values[position] >= 0.0 && values[position] <= 0.25
{
    let observed: f64 = values[position];
    admit(observed)
}
machine peek(values: &[f64; 2], position: &u64) -> f64
requires values[position] >= 0.0 && values[position] <= 0.25
{
    values[position]
}
machine main() crashes Trap {
    let values: [f64; 2] = [0.1, 0.2];
    let mut position: u64 = 1;
    let read: f64 = probe(&values, &mut position);
    transition read == 0.2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
