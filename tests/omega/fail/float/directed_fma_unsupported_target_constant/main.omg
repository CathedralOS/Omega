// No target declares a directed-rounding fused multiply-add realization, so a
// constant cannot be computed with one either. The compiler must name the
// operation and the target instead of computing 3.25 some other way.
use omega::language::core::float_operations;

const FUSED: f64 = F64::fused_multiply_add_toward_zero(1.5f64, 2.0f64, 0.25f64);

machine main() crashes Trap {
    transition FUSED == 3.25f64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
