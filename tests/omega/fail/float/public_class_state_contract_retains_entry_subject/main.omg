use omega::language::core::float_operations;

// The owning guarantee names the entry value. The next state's same-spelled
// parameter receives other and must retain its distinct declaration identity.
machine category(value: f32, other: f32) -> FloatClass
ensures result == F32::classify(value) {
    transition { _ -> next(other) }
    machine next(value: f32) -> FloatClass {
        F32::classify(value)
    }
}

machine main() crashes Trap {
    let observed: FloatClass = category(0.0f32, -0.0f32);
    transition observed {
        FloatClass::Zero { negative: false } -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
