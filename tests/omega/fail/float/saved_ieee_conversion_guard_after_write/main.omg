use omega::language::core::float_operations;
// A saved true guard does not prove bounds for storage written afterwards.
machine convert(value: f64) -> i32 {
    let mut current: f64 = value;
    let accepted: bool = current == current && current >= 0.0 && current < 1000000000.0;
    current = 200000000000000000000.0;
    transition accepted {
        true -> finish(I32::from_f64(current))
        false -> zero()
    }
    machine finish(observed: i32) -> i32 { observed }
    machine zero() -> i32 { 0 }
}
machine main() {}
