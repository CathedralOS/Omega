use omega::language::core::float_operations;

domain i32::Four(value) requires value == 4;
domain f32::Measured;
domain i32::Measured;
domain i32::Issued established by Issuer::issue;
trait Issuer {
    machine issue() -> i32 ensures result in Issued;
}

machine wrong_predicate() -> i32 in Four { 3.0f64 as i32 in Four }
machine unauthorized() -> i32 in Issued { 3.0f64 as i32 in Issued }
machine fractional() -> i32 in Measured { 3.75f64 as i32 in Measured }
machine lossy() -> f32 in Measured { 3.0000000000000004f64 as f32 in Measured }
machine main() {}
