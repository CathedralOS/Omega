use omega::language::core::float_operations;

// Its guarantee holds only after a normal return. The false path crashes.
machine only_true(value: bool) -> bool
ensures value == true
crashes Trap {
    transition value {
        true -> (true)
        false -> stopped()
    }
    machine stopped() -> bool { crash Trap; }
}

// A skipped call cannot make the hypotheses contradictory and prove this law.
machine invalid(value: f32) -> bool
ensures result == F32::is_finite(value)
crashes Trap {
    let ignored: bool = false && only_true(false);
    transition { _ -> (false) }
}

machine main() crashes Trap {
    let observed: bool = invalid(1.0f32);
}
