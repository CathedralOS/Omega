// The inclusive upper guard admits exactly 2^63, outside i64.
use omega::language::core::float_operations;
machine convert(values: &[f64; 2], index: u64) -> i64
requires index < 2,
{
    let accepted: bool = values[index] >= 0.0 && values[index] <= 9223372036854775808.0;
    transition accepted {
        true -> finish(I64::from_f64(values[index]))
        false -> finish(0)
    }
    machine finish(converted: i64) -> i64 { converted }
}
machine main() {}
