use omega::language::core::float_operations;

// A matching leaf name does not supply the sealed truncation guarantee.
machine from_f64(value: f64) -> i32 { 99 }
machine lookalike(value: f64) -> i32
    requires value >= 3.75 && value <= 3.75
    ensures result >= 3 && result <= 3
{
    from_f64(value)
}
