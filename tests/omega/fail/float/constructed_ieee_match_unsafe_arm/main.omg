// Inclusive f64 0.0 <= value <= 0.25 entails admit's 0.0 <= value <= 0.5.
// Expected exit: 0
use omega::language::core::float_operations;
data Reading [copy] where value >= 0.0 && value <= 0.25 { value: f64; }
machine admit(value: f64) -> f64
requires value >= 0.0 && value <= 0.5
{ value }
machine probe(left: Reading, right: f64, choice: bool) -> f64 {
    let value: f64 = match choice { true -> left.value, false -> right };
    admit(value)
}
machine main() crashes Trap {
    let reading: Reading = Reading { value: 0.25 };
    let observed: f64 = probe(reading, 0.75, true);
    let other: f64 = probe(reading, 0.75, false);
    transition observed == 0.25 && other == 0.125 { true -> done() _ -> bad() }
    state done() { }
    state bad() { crash Trap; }
}
