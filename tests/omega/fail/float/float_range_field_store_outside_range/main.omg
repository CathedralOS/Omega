// The field's range excludes its upper endpoint, so storing 0.5 is refused.
// pass/float/float_range_field_storage_exit is the admitted storage.
data Ratio [copy] where value >= 0.0 && value < 0.5 {
    value: f32;
}

machine main() {
    let mut built: Ratio = Ratio { value: 0.25 };
    built.value = 0.5;
}
