// A selected authored operation owns heterogeneous operand meaning.
domain f64::Measured;
machine == f64::Measured::equal_formats(left: f64 in Measured, right: f32) -> bool
requires left >= 0.0
{ true }
machine + f64::Measured::add_formats(left: f64 in Measured, right: f32) -> f64 { left as f64 }
machine calculate(left: f64 in Measured, right: f32) -> bool
requires left >= 0.0
{
    let combined: f64 = left + right;
    transition left == right { true -> (combined == left) _ -> false }
}
machine invalid() -> bool {
    let negative: f64 in Measured = -1.0f64 as f64 in Measured;
    transition negative == 1.0f32 { true -> true _ -> false }
}
