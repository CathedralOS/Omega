use omega::language::core::float_operations;

machine sample() -> f64[3.0..=3.0] { 3.0 }
machine outside() -> i32 { sample() as i32[4..=4] }
machine float_outside() -> f32 { sample() as f32[4.0..=4.0] }
machine excluded() -> f32 { sample() as f32[0.0..3.0] }
machine fractional() -> i32 { 3.75f64 as i32[3..=3] }
machine rounded() -> f32 { 3.0000000000000004f64 as f32[3.0..=3.0] }
