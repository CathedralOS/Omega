use omega::language::core::float_operations;

machine source() -> f64 ensures result == 3.75 { 3.75 }
machine accept(value: f64) -> f32 requires value == 3.75 { value as f32 }

machine stale() -> f32 {
    let mut current: f64 = source();
    current = 0.1f64;
    accept(current)
}

machine wrong_value() -> f32 {
    let known: f64 = source();
    accept(0.1f64)
}
