use omega::language::core::FloatFormat;
use omega::language::core::FloatMeaning;
use omega::language::core::FloatSemantics::from_integer;

// The signature matches one sealed overload, but this declaration does not own it.
machine FloatSemantics::from_integer(format: FloatFormat, value: i16) -> FloatMeaning;

machine convert(value: i16) -> f64 { value as f64 }
