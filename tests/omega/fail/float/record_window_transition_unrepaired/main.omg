use omega::language::core::float_operations;

data Sample where value >= 0.0 && value <= 1.0 { value: f32; }
data Envelope { child: Sample; }

machine inspect(envelope: &mut Envelope) {
    envelope.child.value = 2.0;
    transition { _ -> consume(&envelope.child) }
    state consume(child: &Sample) {}
}
