// Expected reject: declared boundary result/argument formats remain exact.
use omega::language::core::float_operations;
use omega_language_std::console;
data Main { integer: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.integer = 7;
    transition F64::from_i32(7.0f64) == 7.0 { true -> second(main) _ -> bad(main) }
    state second(main: &mut Main) {
        transition 7.0 == F32::from_i32(main.integer) { true -> helper(main) _ -> bad(main) }
    }
    state helper(main: &mut Main) {
        transition converted(main.integer) == 7.0 { true -> {} _ -> bad(main) }
    }
    state bad(main: &mut Main) { Console::exit_process(77); }
}
machine converted(value: i32) -> f64 {
    transition F64::from_i32(value) >= 7.0 { true -> (F64::from_i32(value)) _ -> 0.0 }
}
