// Inline Assembly: structured memory-access mnemonics `ldr`/`str` are not in the
// known-contract accepted set, so the block is refused. Load/store contract
// emission is a future rung (privileged_effects_and_binary_trust brief); until
// then an unknown mnemonic does not compile rather than being smuggled through
// opaquely.

data Main {
    value: i32;
}

machine Main::main(&mut self) {
    asm {
        ldr x0, [src]
        str x0, [dst]
    }
}
