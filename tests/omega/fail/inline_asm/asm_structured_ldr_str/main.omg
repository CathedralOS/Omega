// Inline Assembly: `ldr`/`str` are contracted memory transfers whose memory
// operand must be a typed Omega place — a bracketed `[...]` raw address is not
// an expression, so the block still refuses (wiki/spec/build/hardware_
// materialization.md). Spell authorized access as a typed place such as
// `self.buffer[index]`.

data Main {
    value: i32;
}

machine Main::main(&mut self) {
    asm {
        ldr x0, [src]
        str x0, [dst]
    }
}
