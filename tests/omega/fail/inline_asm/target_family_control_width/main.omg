use omega::language::core::assembly;
boundary trait SelectedObserve {
    machine observe() -> u32 reaches MachineControl;
}
CheckedObserve satisfies SelectedObserve {
    machine observe() -> u32 reaches MachineControl
{
    let mut control: u32 = 0;
    asm { read_cr0 control }
    control
}
}
machine main() reaches MachineControl { let control: u32 = SelectedObserve::observe(); }
