// The nested emitter explicitly excludes all services, so its port write
// violates that ceiling even when a transition selects the emitter.

public machine emit_selected_state(ready: u8) {
    transition ready == 1 { true -> emit() _ -> idle() }
    machine emit() reaches {
        asm clobbers r10, r11, r15, rax, rdx {
            out 0x3F8, 0x45
        }
    }
    machine idle() {}
}
