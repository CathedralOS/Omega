// A shared reference cannot receive the hardware descriptor snapshot.
public data Buffer { before: u8; bytes: [u8; 10]; after: u8; }
machine main() reaches MachineControl {
    let mut buffer: Buffer = Buffer { before: 17, bytes: [17,17,17,17,17,17,17,17,17,17], after: 17 };
    capture(&buffer.bytes);
    consume(buffer.after);
}
machine capture(destination: &[u8; 10]) reaches MachineControl {
    asm clobbers r10 { sgdt destination }
}
machine consume(value: u8) requires value == 17 {}
