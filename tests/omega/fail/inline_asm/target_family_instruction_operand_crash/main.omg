use omega::language::core::assembly;

machine selector(fail: bool) -> u32 crashes Trap {
    transition fail {
        true -> wrong()
        false -> ready()
    }
    machine wrong() -> u32 { crash Trap; }
    machine ready() -> u32 { 3221225600 }
}

linux_x86_64 machine observe(fail: bool) -> u64 reaches MachineControl {
    let mut result: u64 = 0;
    asm { rdmsr result, selector(fail) }
    result
}

machine main() reaches MachineControl crashes Trap { let result: u64 = observe(true); }
