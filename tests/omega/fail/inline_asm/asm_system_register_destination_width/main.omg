use omega::language::core::assembly;
data Main { value: u32; }
machine Main::main(main: &mut Main) reaches MachineControl {
    asm where clobbers x9, x15 { read_sctlr_el1 main.value; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches MachineControl {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
