use omega::language::core::assembly;
data Main { port: u16; byte: u8; }
machine Main::main(main: &mut Main) reaches PortIo {
    asm where clobbers rax, rdx, r10, r11, r15 { out main.port, main.byte; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches PortIo {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
