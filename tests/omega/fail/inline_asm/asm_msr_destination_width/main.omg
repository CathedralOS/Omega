use omega::language::core::assembly;
data Main { index: u32; value: u32; }
machine Main::main(main: &mut Main) reaches MachineControl {
    asm where clobbers rax, rcx, rdx, r10, r11, r15 { rdmsr main.value, main.index; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches MachineControl {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
