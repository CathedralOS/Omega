// Mixing a BOOLEAN operand with a NUMERIC one in a binary op (`main.b + 5`,
// `main.b < main.n`, `main.b == main.n`) used to compile with a C-style bool->{0,1}
// coercion (`true + 5` -> 6). Modern languages reject this magic coercion; Omega
// now does too (settled 2026-07-05, Zach). A comparison RESULT into a numeric slot
// (`let n: i32 = a < b`) is a DIFFERENT, intended coercion and stays valid.
use omega_language_std::console;
data Main { b: bool; }
machine Main::main(main: &mut Main) {
    main.b = true;
    let n: i32 = main.b + 5;
    Console::exit_process(n);
}
