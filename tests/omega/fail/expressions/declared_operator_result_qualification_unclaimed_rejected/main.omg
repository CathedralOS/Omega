// The body declares no result qualification, so the call result is not in Large and the
// consumer that needs the membership refuses it. The positive twin differs only by the
// `in Large` declared on the result.
domain u64::Large requires self > 255;

data Wrapped { value: u8; }

machine + Wrapped::add(left: &Wrapped, right: &Wrapped) -> u64 {
    (left.value as u64) + (right.value as u64) + 256
}

machine decode(sum: u64 in Large) -> u64 {
    sum - 256
}

machine combine(left: &Wrapped, right: &Wrapped) -> u64 {
    decode(left + right)
}

machine main() crashes Trap {
    let left: Wrapped = Wrapped { value: 250 };
    let right: Wrapped = Wrapped { value: 10 };
    let total: u64 = combine(&left, &right);
    transition total == 260 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
