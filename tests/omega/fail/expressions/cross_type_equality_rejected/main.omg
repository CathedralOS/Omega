// Comparing two DIFFERENT data types with `==` (`main.p == main.q` for `p: P`,
// `q: Q`) silently expanded to a POSITIONAL field compare (`p.x == q.x && ..`),
// reading Q's bytes as if they were a P, and ran to a garbage bool. Structural
// equality is synthesized from ONE resolved type name, so the mismatch is caught
// at the expansion site now (before lowering). Same-type `==` stays valid.
trait Equatable<T> { machine equals(left: &T, right: &T) -> bool; }
use omega_language_std::console;
data P { x: i32; y: i32; }
data Q { a: i32; b: i32; }
PEquality satisfies Equatable<P> { }
QEquality satisfies Equatable<Q> { }
data Main { p: P; q: Q; }
machine Main::main(main: &mut Main) {
    main.p = P { x: 1, y: 2 };
    main.q = Q { a: 1, b: 2 };
    let mismatched: bool = main.p == main.q;
    Console::exit_process(0);
}
