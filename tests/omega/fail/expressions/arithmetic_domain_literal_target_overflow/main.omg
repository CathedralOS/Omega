// FAIL CANARY. Frozen decision 17, stage S4 (literal-target folding): a
// bare-literal exact computation is range-checked against its DESTINATION type.
// `200 + 100` = 300 does not fit `u8`, so `let c: u8 = 200 + 100` is rejected as
// an exact-arithmetic overflow (it would otherwise silently wrap to 44). Opt into
// a domain (`u8 in Wrapping`/`Saturating`) or widen for a defined result.

use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) {
    let c: u8 = 200 + 100;   // 300 overflows u8 -> rejected
    transition c == 44 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
