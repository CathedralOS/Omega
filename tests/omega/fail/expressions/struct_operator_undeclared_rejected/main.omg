// Arithmetic/ordering on a struct with NO declared operator (`main.a + main.b`
// for a plain `data P`) used to compile silently to a garbage byte op. Only
// `==`/`!=` (Equatable) or a declared `domain P::... { operator ... }` meaning
// operates on a data type. Rejected via the `resolve_spelling` authority (empty
// candidate set for a concrete-data receiver). `Quantity + Quantity` stays valid.
use omega::language::std::console;
use omega::language::core::binding;
data P { x: i32; }
data Main { console: Binding<Console>; a: P; b: P; }
machine Main::main(main: &mut Main) { let c: P = main.a + main.b; main.console.exit_process(0); }
