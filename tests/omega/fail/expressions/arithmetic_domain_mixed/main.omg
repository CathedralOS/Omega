// FAIL CANARY. Frozen decision 17, stage S2: mixed arithmetic domains are
// rejected. `a` is `Wrapping` and `b` is `Saturating`, so `a + b` mixes
// two different explicit domains -- illegal without an explicit `as` cast.

use omega::language::std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) {
    let mut a: u8 in Wrapping = 200;
    let mut b: u8 in Saturating = 100;
    let c: u8 in Wrapping = a + b;   // Wrapping + Saturating -> rejected
    transition c == 44 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
