// Casting a struct to a numeric type (`main.p as i32`) silently reinterpreted the
// struct's bytes as a number. `as` converts between scalar types only. Rejected now.
use omega_language_std::console;
data P { x: i32; y: i32; }
data Main { p: P; }
machine Main::main(main: &mut Main) { main.p = P { x: 7, y: 9 }; let n: i32 = main.p as i32; Console::exit_process(n); }
