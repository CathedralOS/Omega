// Testing an enum value's membership in a case of a DIFFERENT enum (`main.c in
// Direction::North` for `c: Color`) lowered to a raw TAG test across unrelated
// types: Color::Red and Direction::North both tag 0, so it spuriously read TRUE
// (confirmed miscompile, exit 1). The membership sibling of the cross-enum `==`
// hole. Rejected at the case-membership lowering now. Same-enum membership
// (`main.c in Color::Red`, incl. transition match-arm desugars) stays valid.
use omega::language::std::console;
use omega::language::core::binding;
data Color { case Red; case Green; }
data Direction { case North; case South; }
data Main { console: Binding<Console>; c: Color; }
machine Main::main(main: &mut Main) {
    main.c = Color::Red;
    transition main.c in Direction::North { true -> hit(main) _ -> miss(main) }
    state hit(main: &mut Main) { main.console.exit_process(1); }
    state miss(main: &mut Main) { main.console.exit_process(2); }
}
