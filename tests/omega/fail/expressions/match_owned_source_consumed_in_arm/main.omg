// An arm that moves an owned value consumes it for the whole region: reading
// it after the dispatch is a use-after-move even when every arm moved it.
data Category { case Other; case Missing; }
machine accept(category: Category) {}
machine classify(flag: bool, category: Category) -> Category {
    let kept: Category = match flag {
        true -> category,
        _ -> category
    };
    accept(category);
    kept
}
