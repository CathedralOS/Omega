machine build(builder: &mut Build) {
    Build::application(builder, "declared_operator_private_helper_selected");
    let mut lib_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "lib" });
    dependency::with_alias(&mut lib_dependency, "lib");
    let lib_registration: DependencyRegistration = Build::dependency(builder, lib_dependency);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
