// A match product stored through an exclusive borrow must carry the field's
// exact type: borrowed-window custody is not a bare-carrier escape.
data Pair { left: u64; right: u64; }
data Category { case Other; case Missing; }
data Main { category: Category; }
machine Main::main(main: &mut Main) {
    transition true {
        true -> assign(main)
        _ -> assign(main)
    }
    machine assign(main: &mut Main) {
        main.category = match main.category {
            Category::Other -> Pair { left: 1, right: 2 },
            _ -> Pair { left: 3, right: 4 }
        };
    }
}
