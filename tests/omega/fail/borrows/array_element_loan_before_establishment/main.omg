// Zero-filled storage is not an established Cell. Writing another element
// cannot authorize a readable loan of this element's unsatisfied default domain.
domain i32::Positive(value) requires value >= 1;
data Cell { value: i32 in Positive; }
machine inspect(value: &Cell) -> i32 { value.value }
machine main() -> i32 {
    let mut cells: [Cell; 2];
    cells[0].value = 1;
    inspect(&cells[1])
}
