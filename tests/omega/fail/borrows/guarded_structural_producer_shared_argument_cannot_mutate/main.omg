data Window [copy] { len: u64; }
data Counter { calls: u64; }
data Envelope { counter: Counter; }
data Main {}

machine collection(counter: &mut Counter) -> Window {
    counter.calls = 1;
    Window { len: counter.calls }
}

machine [..] Window::range(window: Window, start: u64, end: u64) -> u64 {
    window.len
}

machine choose(envelope: &Envelope, enabled: bool) -> u64 {
    match enabled {
        true -> collection(&mut envelope.counter)[..1],
        false -> 0
    }
}

machine Main::main(main: &mut Main) {}
