// Rebinding a shared-reference parameter to an invocation-local slot and
// returning it hands the caller a view of storage that dies with the call.
// The parameter's declared lifetime belonged to the original referent; the
// rebind replaced that descriptor, so the return must reject exactly as the
// same rebind of a reference local does.
machine observe<'a>(mut selected: &'a u64, replacement: &'a u64) -> &'a u64 {
    let local: u64 = 7;
    selected = &local;
    selected
}

machine main() crashes Trap {
    let original: u64 = 1;
    let replacement: u64 = 7;
    let r: &u64 = observe(&original, &replacement);
    transition r == 7 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
