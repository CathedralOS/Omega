// An earlier pending transfer cannot erase a later concrete supplier obligation.
data Slot<'data> { target: &'data u64; }
data Writer<'owner, 'data> { destination: &'owner mut Slot<'data>; }
data Reply<T> { value: T; status: u64; }
boundary trait Forward<T> { machine call(value: T) -> T reaches; }
boundary trait Replace {
    machine call<'owner, 'data>(writer: Writer<'owner, 'data>) -> u64 reaches;
}

machine symbolic_then_concrete<'owner, 'data, T>(
    value: T, writer: Writer<'owner, 'data>
) -> Reply<T> {
    let forwarded: T = Forward<T>::call(value);
    let status: u64 = Replace::call(writer);
    Reply { value: forwarded, status: status }
}
