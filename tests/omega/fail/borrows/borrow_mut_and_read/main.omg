data Main {
    value: i32;
}

machine Main::main(main: &mut Main) -> i32 {
    transition {
        _ -> copy(&mut main.value, main.value)
    }
    

    state copy(out_value: &mut i32, input_value: i32) {
        out_value = input_value;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown() {
        0
    }
}
