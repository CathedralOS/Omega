// The subject operand forwards the binding's `&mut` loan to the `main` formal
// and holds it for the whole call, while the next operand lends a shared view
// of `main.arr`: `take` would overwrite `arr[0]` through its own subject while
// reading it through `sub`. The named-binding spelling
// `Main::take(main, main.arr[0..2])` is rejected for that pair of operands.

data Main { arr: [i32; 5]; }

machine Main::take(main: &mut Main, sub: &[i32]) -> i32 {
    main.arr[0] = 7;
    transition sub.len >= 1 { true -> (sub[0]) false -> 0 }
}

machine Main::main(main: &mut Main) -> i32 {
    let seen: i32 = Main::take(main, main.arr[0..2]);
    (seen)
}
