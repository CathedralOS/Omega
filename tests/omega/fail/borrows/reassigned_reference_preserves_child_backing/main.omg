// Replacing a descriptor cannot release the backing retained by its child.
data Header { left: u64; right: u64; }
data Main { first: Header; second: Header; }

machine Main::main(main: &mut Main) crashes Trap {
    let mut view: &Header = &main.first as &Header;
    let child: &Header = view as &Header;
    view = &main.second as &Header;
    main.first.left = 42u64;
    transition child.left == 42u64 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
