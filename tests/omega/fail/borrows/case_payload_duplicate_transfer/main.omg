data Token { value: i32; }
data Choice { case Present(value: Token); case Empty; }

machine inspect(choice: Choice) -> bool {
    transition choice {
        Choice::Present { value } -> observe(value, value)
        _ -> (false)
    }
    machine observe(first: Token, second: Token) -> bool {
        first.value == second.value
    }
}

machine main() crashes Trap {
    let result: bool = inspect(Choice::Present { value: Token { value: 42 } });
    transition result { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
