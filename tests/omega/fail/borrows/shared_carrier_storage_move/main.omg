data Value { payload: u64; }
data Carrier { value: &Value; }

machine take(carrier: Carrier) { }
machine read(carrier: &Carrier) -> u64 { carrier.value.payload }

machine main() {
    let value: Value = Value { payload: 73 };
    let carrier: Carrier = Carrier { value: &value };
    let alias: &Carrier = &carrier;
    take(carrier);
    let observed: u64 = read(alias);
}
