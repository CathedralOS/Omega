data Locator { case Module(name: [u8; 2]); case Empty; }
machine name(locator: &Locator) -> &[u8] {
    transition locator { Locator::Module { name } -> (&name[0..2]) Locator::Empty -> ("") }
}
machine first(bytes: &[u8]) -> u8 {
    transition bytes.len > 0 { true -> read(bytes) false -> (0) }
    machine read(bytes: &[u8]) -> u8 requires bytes.len > 0 { bytes[0] }
}
machine main() {
    let mut locator: Locator = Locator::Module { name: [73, 91] };
    let bytes: &[u8] = name(&locator);
    locator = Locator::Empty;
    let result: u8 = first(bytes);
}
