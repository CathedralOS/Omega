machine invalid(matrix: &[[u64; 13]; 33]) -> &mut [u64; 13] { &mut matrix[2] }
machine explicit<'a>(matrix: &'a [[u64; 13]; 33]) -> &'a mut [u64; 13] { &mut matrix[2] }
machine generic<T>(matrix: &[[T; 13]; 33]) -> &mut [T; 13] { &mut matrix[2] }
machine main() {
    let matrix: [[u64; 13]; 33];
    let row: &mut [u64; 13] = invalid(&matrix);
    row[0] = 7;
    let generic_row: &mut [u64; 13] = generic(&matrix);
    generic_row[0] = 9;
}
