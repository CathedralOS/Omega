// A record literal cannot hold an exclusive loan of a cell together with a
// shared loan of one of that cell's fields.
use omega_language_std::console;

data Cell { stamp: i32; value: i32 [0..=100]; }
data View<'a> { writer: &'a mut Cell; reader: &'a i32 [0..=100]; }
data Main {
    first: Cell;
    second: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.second.stamp = 5;
    main.second.value = 70;
    let view: View = View { writer: &mut main.first, reader: &main.first.value };
    view.writer.value = 70;
    let observed: i32 [0..=100] = view.reader;
    transition observed == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
