// Expected exit: 0
data Leaf<'storage> [copy] { value: &'storage [u8]; }
data Pair<'first, 'second> [copy] { head: Leaf<'first>; tail: Leaf<'second>; }
trait Joining {
    machine join<'left, 'right>(first: &'left [u8], second: &'right [u8]) -> Pair<'left, 'right>
    requires first.len > 0 && second.len > 0
    ensures result.head.value.len > 0, result.tail.value.len > 0;
}
Separate satisfies Joining {
    machine join<'left, 'right>(first: &'left [u8], second: &'right [u8]) -> Pair<'right, 'left>
    requires first.len > 0 && second.len > 0
    ensures result.head.value.len > 0, result.tail.value.len > 0
    { Pair { head: Leaf { value: second }, tail: Leaf { value: first } } }
}
machine main() crashes Trap {
    let first: [u8; 7] = [11, 12, 13, 14, 15, 16, 17];
    let second: [u8; 4] = [29, 30, 31, 32];
    let selected: Pair = Joining::join(Separate as dyn Joining, &first[..], &second[..]);
    transition selected.head.value[0] == 11u8 && selected.tail.value[0] == 29u8
        && selected.head.value.len == 7 && selected.tail.value.len == 4 {
        true -> done() false -> wrong()
    }
    state done() {} state wrong() { crash Trap; }
}
