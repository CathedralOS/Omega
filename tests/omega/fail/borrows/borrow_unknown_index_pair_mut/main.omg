data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 2];
}

machine Main::main(main: &mut Main, left_index: u64, right_index: u64) {
    let view: &mut [Entry] = main.entries.as_mut_slice();
    let left: &mut Entry = &mut view[left_index];
    let right: &mut Entry = &mut view[right_index];
    left = Entry { value: 1 };
    right = Entry { value: 2 };
}
