data Storage {
    value: i32;
}

machine main() {
    let mut storage: Storage;
    let alias: &mut i32 = &mut storage.value;
    alias = 3;
    use_value(&mut storage.value);
    write_alias(alias);
}

machine use_value(value: &mut i32) {
    value = 1;
}

machine write_alias(value: &mut i32) {
    value = 2;
}
