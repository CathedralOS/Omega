data Cell requires value >= 0 && value <= 1 { value: u8; }
data Main { cells: [Cell; 2]; }
machine take(value: &u8) -> u8 { value }
machine observe(main: &mut Main) -> u8 {
    let mut selector: u64 = 1;
    let selected_value: &u8 = &main.cells[selector].value;
    let copied_value: &u8 = selected_value;
    selector = 0;
    main.cells[1].value = 1;
    take(copied_value)
}
