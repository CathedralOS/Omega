// A local record lent `&` stays borrowed until the loan's last use: moving
// the local into a call before then would take storage out from under it.

data Score { points: i32 in Wrapping; }

machine Score::take(score: Score) { }

machine Score::read(score: &Score) -> i32 {
    transition { _ -> (score.points as i32) }
}

machine main() {
    let score: Score;
    let alias: &Score = &score;
    Score::take(score);
    let seen: i32 = Score::read(alias);
}
