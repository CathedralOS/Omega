// An exclusive child suspends its parent's branch for observation as well as
// mutation. `middle` captures `view[2..4]` and is written after the call, so
// lending `view` shared would let `peek` observe bytes `middle` still owns.
// The parent view comes from an explicit borrow here and from `as_mut_slice`
// in `local_subslice_live_parent_mutable_argument`; both lend the same
// captured storage.
machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine peek(view: &[u8], at: u64) -> u8
requires at < view.len
{
    view[at]
}

machine observe() -> u8 {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = &mut items;
    let middle: &mut [u8] = view[2..4];
    let seen: u8 = peek(view, 3);
    zero(middle);
    seen
}
