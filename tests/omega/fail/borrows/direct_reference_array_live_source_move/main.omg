// A stored shared reference keeps its referent in place until its last read.
data Inventory { slots: i32 [0..=100]; }
data Main { inventory: Inventory; }

machine Main::peek(main: &mut Main) -> i32 {
    let loans: [&Inventory; 1] = [&main.inventory];
    let taken: Inventory = main.inventory;
    let seen: i32 [0..=100] = loans[0].slots;
    main.inventory = move taken;
    seen
}
