// Forwarding the result cannot release another field of its supplied operand.
data Cell { value: i32; spare: i32; }
data Envelope { cell: Cell; marker: i32; }
machine pick(cell: &mut Cell) -> &mut i32 { &mut cell.value }
machine forward(value: &mut i32) -> &mut i32 { value }
machine main() {
    let mut envelope: Envelope;
    let cell: &mut Cell = &mut envelope.cell;
    let selected: &mut i32 = forward(pick(cell));
    envelope.cell.spare = 5;
    selected = 70;
}
