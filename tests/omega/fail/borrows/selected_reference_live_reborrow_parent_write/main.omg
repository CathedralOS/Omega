machine keep_first<'storage>(first: &'storage mut i64, second: &'storage mut i64) -> &'storage mut i64 {
    first
}
machine conflicting(first: &mut i64, second: &mut i64) {
    let first_view: &mut i64 = &mut first;
    let second_view: &mut i64 = &mut second;
    let selected: &mut i64 = keep_first(first_view, second_view);
    // The declared second parent stays suspended despite only one return arm.
    second_view = 0;
    selected = 1;
}
