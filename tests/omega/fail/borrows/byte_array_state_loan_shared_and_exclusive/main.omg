// A fixed byte array cannot be lent to one state as both a shared view and
// an exclusive one: the exclusive writer would change what the reader sees.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console {
    let mut bytes: [u8; 5] = "HELLO";
    transition { _ -> both(&main.console, &bytes, &mut bytes) }
    state both(console: &Binding<Console>, text: &[u8; 5], output: &mut [u8; 5]) {
        output[0] = 74;
        transition text[0] == 74 {
            true -> finish(console, 70)
            _ -> finish(console, 71)
        }
    }
    state finish(console: &Binding<Console>, code: i32) { Console::exit_process(console, code); }
}
