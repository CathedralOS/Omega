// A possibly selected child stays live until the selected result's last read.
data Cell where value >= 0 && value <= 100 { value: i32; }
data Message { body: &mut Cell; stamp: i32; }
data Held { target: &Cell; stamp: i32; }

machine invalid(first: &mut Cell, second: &Cell, selected: bool) -> i32 {
    let message: Message = Message { body: &mut first, stamp: 11 };
    let child: &Cell = &message.body;
    let held: Held = match selected {
        true -> Held { target: child, stamp: 12 },
        false -> Held { target: second, stamp: 13 }
    };
    first.value = 81;
    held.target.value
}
