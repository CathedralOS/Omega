data Cell { value: i32; }
data Window { cells: &[Cell]; }
data Envelope { window: Window; }

machine main() crashes Trap {
    let mut cells: [Cell; 2];
    let envelope: Envelope = Envelope { window: Window { cells: &cells[..] } };
    cells[1].value = 42;
    transition envelope.window.cells.len > 1 {
        true -> inspect(&envelope)
        false -> done()
    }
    machine inspect(envelope: &Envelope)
    requires envelope.window.cells.len > 1
    {
        let observed: i32 = envelope.window.cells[1].value;
    }
    machine done() {}
}
