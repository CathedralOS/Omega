// Ending a terminal call's temporary parent descriptor must not end the
// returned child's loan or permit mutation of its backing.
data Cell { value: u64; }
data Container { cell: Cell; }
machine child<'backing>(cell: &'backing Cell) -> &'backing u64 { &cell.value }
machine selected_child<'backing>(container: &'backing Container,
                                 choose: bool) -> &'backing u64 {
    transition choose {
        true -> child(&container.cell)
        false -> child(&container.cell)
    }
}
machine invalid(container: &mut Container, choose: bool) -> u64 {
    let value: &u64 = selected_child(container, choose);
    container.cell.value = 0;
    value
}
