// Leaving the selected arm does not retire a reference carried to its successor.
data Choice { case Full(value: u64); case Empty; }
data Frame where selected < 2 { items: [Choice; 2]; selected: u64; }
machine reject() -> u64 {
    let mut frame: Frame;
    frame.items[0] = Choice::Empty;
    frame.items[1] = Choice::Full { value: 70 };
    frame.selected = 1;
    let held: &Choice = &frame.items[1];
    transition frame.items[frame.selected] {
        Choice::Full { value } -> saved(&mut frame, held, value)
        Choice::Empty -> (0)
    }
    machine saved(frame: &mut Frame, held: &Choice, snapshot: u64) -> u64 {
        frame.items[1] = Choice::Empty;
        transition held {
            Choice::Full { value } -> (value)
            Choice::Empty -> (snapshot)
        }
    }
}
