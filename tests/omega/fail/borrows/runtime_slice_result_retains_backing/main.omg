use omega::language::core::option;

machine choose<'input>(first: &'input [i32], second: &'input [i32], branch: bool)
-> Optional<&'input i32>
requires first.len > 0 && second.len > 0
{
    transition branch {
        true -> Optional::Some { value: &first[0] }
        false -> Optional::Some { value: &second[0] }
    }
}

machine read(found: Optional<&i32>) -> i32 {
    transition found {
        Optional::Some { value } -> (value)
        Optional::None -> -1
    }
}

machine invalid() {
    let first: [i32; 2] = [3, 7];
    let mut second: [i32; 2] = [11, 19];
    let found: Optional<&i32> = choose(&first, &second, true);
    second[0] = 23;
    let observed: i32 = read(found);
}

machine main() {}
