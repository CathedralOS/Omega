// A view field's name cannot make its original backing bytes disjoint.
data Header { left: u64; right: u64; }
data View { prefix: u64; middle: Header; tail: u64; }
data Source { first: u64; second: u64; third: u64; fourth: u64; }
data Main { source: Source; }

machine middle(source: &Source) -> &Header {
    let view: &View = source as &View;
    let selected: &Header = &view.middle;
    selected
}

machine Main::main(main: &mut Main) crashes Trap {
    let held: &Header = middle(&main.source);
    main.source.second = 42u64;
    transition held.left == 42u64 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
