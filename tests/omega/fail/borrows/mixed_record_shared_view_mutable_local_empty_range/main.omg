// Mutable ownership of the carrier cannot strengthen a shared field loan.
data Mixed {
    shared: &[u32];
    exclusive: &mut [u32];
}

machine violate(mut current: Mixed) {
    let requested: &mut [u32] = &mut current.shared[0..0];
    let observed: u64 = requested.len;
}

machine main() {
    let shared_values: [u32; 1] = [7];
    let mut exclusive_values: [u32; 1];
    let current: Mixed = Mixed {
        shared: shared_values.as_slice(),
        exclusive: &mut exclusive_values[0..1]
    };
    violate(current);
}
