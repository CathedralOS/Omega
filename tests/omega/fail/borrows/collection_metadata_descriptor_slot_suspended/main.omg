data Holder<'a> [copy] { before: u64; view: &'a [u8]; after: u64; }

machine exercise() -> bool {
    let values: [u8; 3] = [11, 37, 91];
    let mut holder: Holder = Holder { before: 101, view: &values[..], after: 203 };
    let alias: &mut Holder = &mut holder;
    let exclusive: &mut Holder = &mut alias;
    let length: u64 = alias.view.len;
    length == 3 && exclusive.before == 101
}
