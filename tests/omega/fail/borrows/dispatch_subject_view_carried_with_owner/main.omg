// Negative twin of dispatch_subject_view_released_exit: the `Full` arm now
// passes its payload `view` beside `main`. That view still borrows
// `main.buffer`, so handing `main` over exclusively with it must reject; the
// carried child loan cannot outlive the parent loan the dispatch would end.
data View { tail: &[u8]; }
data Res { case Empty; case Full(view: View); }
machine split(bytes: &[u8]) -> Res {
    transition bytes.len >= 1 {
        true -> Res::Full { view: View { tail: bytes[1..bytes.len] } }
        false -> Res::Empty
    }
}
data Main { buffer: [u8; 3]; }
machine run(main: &mut Main) crashes Trap {
    main.buffer[0] = 41;
    let decoded: Res = split(&main.buffer[0..3]);
    transition decoded {
        Res::Full { view } -> keep(main, view)
        Res::Empty -> bad()
    }
    machine keep(main: &mut Main, view: View) crashes Trap {
        main.buffer[1] = 2;
        transition view.tail.len == 2 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
machine main() crashes Trap {
    let mut storage: Main;
    run(&mut storage);
}
