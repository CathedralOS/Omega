// Constructing the record retains the exclusive view loan until its last use.
data Held { items: &mut [u32]; }
machine main() crashes Trap {
    let mut values: [u32; 3];
    let held: Held = Held { items: &mut values[0..3] };
    values[0] = 99;
    let observed: u64 = held.items.len;
    transition observed == 3 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
