// Whole-value assignment through a shared loan: `verdict = Sound` where
// `verdict: &Verdict` writes storage the loan may only observe. Only an
// exclusive `&mut` loan lends its whole referent for replacement.

data Verdict {
    case Invalid;
    case Sound;
}

data Main {
    verdict: Verdict;
}

machine settle(verdict: &Verdict) {
    verdict = Verdict::Sound;
}

machine Main::main(main: &mut Main) {
    settle(&main.verdict);
}
