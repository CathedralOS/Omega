data Entry {
    value: i32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self, left_index: u64 [0..=3], mid: u64 [0..=4], other: u64 [0..=4], right_index: u64 [0..=3])
requires
    left_index < mid && other <= right_index
{
    let view: &mut [Entry] = self.entries.as_mut_slice();
    let left: &mut Entry = &mut view[left_index];
    let right: &mut Entry = &mut view[right_index];
    left = Entry { value: 1 };
    right = Entry { value: 2 };
}
