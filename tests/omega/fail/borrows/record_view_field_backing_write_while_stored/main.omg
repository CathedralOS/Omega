// A view stored into a local record's field keeps its backing loaned until
// the record's last read: writing the backing between the store and that
// read rejects, exactly as it does for a view stored into a view local.
data Room [copy] {
    label: &[u8];
}

data Main {
    buffer: [u8; 4];
}

machine Main::main(main: &mut Main) -> bool {
    let room: Room;
    room.label = main.buffer[0..2];
    main.buffer[0] = 65;
    room.label == "AB"
}
