// An independent selector read grants no reborrow authority over a held loan.
// Both captures select byte zero, so accepting both would create exclusive aliases.
data Main
requires position < 2;
{
    position: u64;
    bytes: [u8; 2];
}

machine Main::main(main: &mut Main) {
    main.position = 0;
    let held: &mut u8 = &mut main.bytes[main.position];
    main.position = 0;
    let fresh: &mut u8 = &mut main.bytes[main.position];
    held = 7;
    fresh = 11;
}
