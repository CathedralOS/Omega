// Expected exit: 0
public data Counter { count: u64; other: u64; }
machine Counter::advance(counter: &mut Counter, independent: &mut u64) -> u64 {
    transition { _ -> observe(counter, &mut counter.count) }
    machine observe(counter: &mut Counter, child: &mut u64) -> u64 {
        child = 5;
        counter.count
    }
}
machine main() crashes Trap {
    let mut first: Counter = Counter { count: 7, other: 13 };
    let mut second: Counter = Counter { count: 2, other: 19 };
    let seen: u64 = Counter::advance(&mut first, &mut second.count);
    transition seen == 7 && first.count == 7 && first.other == 13
        && second.count == 5 && second.other == 19 {
        true -> {}
        false -> bad()
    }
    machine bad() crashes Trap { crash Trap; }
}
