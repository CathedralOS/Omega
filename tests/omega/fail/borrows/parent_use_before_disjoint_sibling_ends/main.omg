data Cell { value: i32; }

machine observe(values: &[Cell]) {}

machine replace(values: &mut [Cell])
requires values.len == 2
{
    let first: &mut Cell = &mut values[0];
    let second: &mut Cell = &mut values[1];
    first = Cell { value: 17 };
    // Ending one branch cannot authorize a whole-parent observation while
    // the other branch remains live.
    observe(values);
    second = Cell { value: 53 };
}
