// Writing the loaned field itself while its exclusive loan is live is
// refused: `s.a = 5` overlaps the loan of `s.a` that `put` uses afterwards.
// Only the written field differs from the accepted sibling-field twin.
data Pair { a: i64; b: i64; }
machine put(target: &mut i64) { target = 3; }
machine main() crashes Trap {
    let mut s: Pair;
    s.a = 1;
    s.b = 2;
    let loaned: &mut i64 = &mut s.a;
    s.a = 5;
    put(loaned);
    transition s.a == 3 && s.b == 5 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
