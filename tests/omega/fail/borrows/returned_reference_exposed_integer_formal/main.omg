// A literal actual does not survive exposing the callee's owned formal.
machine install_one(value: &mut u64)
ensures value == 1 {
    value = 1;
}
machine choose<'input>(values: &'input mut [u64; 2], mut position: u64) -> &'input u64
requires position < 2 {
    install_one(&mut position);
    &values[position]
}
machine observe(value: &u64) -> u64 { value }
machine entry() -> u64 {
    let mut values: [u64; 2] = [7, 11];
    let selected: &u64 = choose(&mut values, 0);
    values[1] = 19;
    observe(selected)
}
