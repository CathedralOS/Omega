data Pair { low: i32; high: i32; }
trait Read {
    machine first(padding: i32, pair: &Pair) -> &i32;
}
Low satisfies Read {
    machine first(padding: i32, pair: &Pair) -> &i32 { &pair.low }
}
High satisfies Read {
    machine first(padding: i32, pair: &Pair) -> &i32 { &pair.high }
}
machine main() -> i32 {
    let mut pair: Pair = Pair { low: 3, high: 7 };
    let mut selected: dyn Read = Low as dyn Read;
    let view: &i32 = Read::first(selected, 19, &pair);
    selected = High as dyn Read;
    pair.low = 9;
    (view)
}
