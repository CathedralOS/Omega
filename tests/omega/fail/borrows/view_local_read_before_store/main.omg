// A declared borrowed-view local has no descriptor until a store
// establishes it: reading it first names no backing and must reject.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let mut out_line: &[u8] in Utf8;
    transition out_line == "" {
        true -> good(main)
        false -> bad(main)
    }

    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
