// Expected exit: 0
// Reentering a ranked return component uses the recurring selector, not its first invocation's scalar snapshot.
machine choose<'storage>(values: &'storage mut [u64; 2], counter: &mut u64, index: u64, remaining: u64) -> &'storage mut u64
requires index < 2;
terminates;
terminates by remaining;
{
    transition remaining > 0 {
        true -> step(values, counter, index, remaining)
        false -> &mut values[index]
    }
    machine step(values: &'storage mut [u64; 2], counter: &mut u64, selected: u64, pending: u64) -> &'storage mut u64
    requires selected < 2;
    requires pending > 0;
    {
        counter = ((counter as u64 in Wrapping) + 1) as u64;
        transition { _ -> choose(values, counter, 1, pending - 1) }
    }
}
machine false_guarantee() -> u64 ensures result == 23; {
    let mut values: [u64; 2] = [11, 23];
    let mut counter: u64 = 3;
    let selected: &mut u64 = choose(&mut values, &mut counter, 0, 7);
    selected = 99;
    values[1]
}
machine main() {}
