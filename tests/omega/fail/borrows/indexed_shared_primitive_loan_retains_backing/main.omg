data Byte requires value >= 0 && value <= 1 { prefix: u64; value: u8; suffix: u32; }
data Row { cells: [Byte; 3]; tag: u64; }
data Main { rows: [Row; 2]; }
machine take(value: &u8) -> u8 { value }
machine read(main: &mut Main, row: u64, column: u64) -> u8
requires row < 2, column < 3
{
    let selected_value: &u8 = &main.rows[row].cells[column].value;
    let copied_value: &u8 = selected_value;
    main.rows[row].cells[column].value = 1;
    take(copied_value)
}
