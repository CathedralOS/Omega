data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; stamp: i32; }
data Main { source: Cell; selected: bool; }

machine invalid<'storage>(source: &'storage Cell, selected: bool) -> Held<'storage> {
    let local: Cell = Cell { value: 73 };
    match selected {
        true -> Held { target: source, stamp: 12 },
        false -> Held { target: &local, stamp: 13 }
    }
}

machine Main::main(main: &mut Main) -> i32 {
    let held: Held = invalid(&main.source, main.selected);
    held.target.value
}
