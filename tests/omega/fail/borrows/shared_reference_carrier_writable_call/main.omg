data Cell { stamp: u64; value: i32; }
data Message { stamp: u64; body: &mut Cell; }
data Main { first: Cell; second: Cell; }
machine take(value: &mut i32) -> i32 { value = 99; value }
machine inspect(messages: &[Message; 2], position: u64) -> i32
requires position < 2 { take(&mut messages[position].body.value) }

// A dispatch binding retains the enclosing shared access. Its declared
// exclusive descriptor cannot grant access that the shared case does not lend.
data Choice { case Held(body: &mut Cell); case Empty; }
machine inspect_choice(selection: &Choice) -> i32 {
    transition selection {
        Choice::Held { body } -> (take(&mut body.value))
        Choice::Empty -> 0
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.first.stamp = 13; main.first.value = 11;
    main.second.stamp = 17; main.second.value = 70;
    let messages: [Message; 2] = [
        Message { stamp: 7, body: &mut main.first },
        Message { stamp: 9, body: &mut main.second }
    ];
    let chosen: i32 = inspect(&messages, 1);
    let neighbor: i32 = inspect(&messages, 0);
    transition chosen == 70 && neighbor == 11 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
