// Expected error: state `done` receives `control` while local borrow `child` is still active
data Control { value: i32; }
machine transfer(control: &mut Control) {
    let child: &i32 = &control.value;
    transition { _ -> done(control, control.value, child) }
    machine done(control: &mut Control, value: i32, child: &i32) { control.value = value; let observed: i32 = child; }
}
