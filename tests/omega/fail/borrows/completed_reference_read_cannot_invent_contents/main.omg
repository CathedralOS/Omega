data Cell { value: u64; }
machine pick(cells: &[Cell; 2], second: bool) -> &Cell {
    transition second {
        true -> &cells[1]
        false -> &cells[0]
    }
}
machine inspect(cells: &[Cell; 2], second: bool, retry: u64) -> u64
requires addr::Bound == 18446744073709551616 && retry <= 1
{
    let selected: &Cell = pick(cells, second);
    transition { _ -> finish(selected.value, retry) }
    machine finish(value: u64, retry: u64) -> u64
    requires addr::Bound == 18446744073709551616 && retry <= 1 && value == 42
    { value }
}
