// A completed argument keeps the selected loan until its consuming call.
data Cell { value: i32; }
data View<'storage> [copy] { target: &'storage Cell; }
data Envelope<'storage> [copy] { case Active(cell: &'storage Cell); case Empty; }
machine replace<'storage>(view: &mut View<'storage>, incoming: &'storage Cell) -> bool {
    view.target = incoming;
    true
}
machine choose<'storage>(view: View<'storage>, changed: bool) -> Envelope<'storage> {
    Envelope::Active { cell: view.target }
}
machine mutate(cell: &mut Cell) -> bool { cell.value = 23; true }
machine main() crashes Trap {
    let mut first: Cell = Cell { value: 17 };
    let second: Cell = Cell { value: 19 };
    let mut view: View = View { target: &second };
    let observed: i32 = match choose(match replace(&mut view, &first) { true -> view false -> view }, replace(&mut view, &second) && mutate(&mut first)) {
        Envelope::Active { cell } -> cell.value
        Envelope::Empty -> 0
    };
    transition observed == 17 && view.target.value == 19 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
