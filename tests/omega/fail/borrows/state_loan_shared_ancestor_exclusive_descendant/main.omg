data Room { count: u32 in Wrapping; }
data SharedHolder<'a> { room: &'a Room; }
data MutableHolder<'a> { room: &'a mut Room; }
machine owned_holder(room: &Room) {
 let mut holder: SharedHolder = SharedHolder { room: room };
 transition { _ -> observe(&mut holder.room.count) }
 machine observe(count: &mut u32 in Wrapping) { count = 11; }
}
machine shared_holder(holder: &MutableHolder) {
 transition { _ -> observe(&mut holder.room.count) }
 machine observe(count: &mut u32 in Wrapping) { count = 11; }
}
machine main() {}
