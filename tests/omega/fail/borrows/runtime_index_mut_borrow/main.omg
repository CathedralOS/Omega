// Negative pin — REFERENCE-LOCAL-BINDING-ROUTES sibling (verified rejecting
// on 233d30cb1ce): an UNBOUNDED runtime index `&mut main.buf[main.off]`
// fails the static index proof — `main.off` carries no declared range,
// where-fact, guard, or tracked value, and indexing has no runtime bound
// check to fall back to. The bounded sibling
// (run/borrows/runtime_index_bounded_borrow) declares `off: u32 [0..=47]`
// and runs natively.
use omega_language_std::console;

data Main {
    buf: [u8; 48];
    off: u32;
}

machine Main::main(main: &mut Main) reaches Console {
    let borrowed: &mut u8 = &mut main.buf[main.off];
    transition { _ -> done(main) }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
