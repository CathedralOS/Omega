// A three-byte backing cannot supply a four-byte fixed view state loan.
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) reaches Console {
    let bytes: [u8; 3] = "ABC";
    transition { _ -> observe(&bytes) }
    state observe(bytes: &[u8; 4]) { Console::exit_process(70); }
}
