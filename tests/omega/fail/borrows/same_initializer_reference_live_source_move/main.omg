// Record fields evaluate in authored order: the loan precedes extraction.
data Inventory { slots: i32 [0..=100]; }
data Bundle { loan: &Inventory; taken: Inventory; }
data Main { inventory: Inventory; }

machine Main::peek(main: &mut Main) -> i32 {
    let bundle: Bundle = Bundle {
        loan: &main.inventory,
        taken: main.inventory
    };
    let seen: i32 [0..=100] = bundle.loan.slots;
    main.inventory = Inventory { slots: 77 };
    seen
}
