// One exclusive branch cannot donate permission to a shared alternative.
machine exercise(first: &mut u32, second: &u32, choose: bool) -> u32 {
    let selected: &mut u32 = match choose {
        true -> first,
        false -> second
    };
    let observed: u32 = selected;
    observed
}

machine main() -> u32 {
    let mut first: u32 = 7;
    let second: u32 = 9;
    exercise(&mut first, &second, true)
}
