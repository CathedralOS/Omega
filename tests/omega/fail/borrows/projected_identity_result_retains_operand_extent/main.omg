// Returning the whole operand still creates a call-held lifetime obligation.
// Projecting the result must retain it after the intermediate holder expires.
data Cell { value: i32; }
data Pair { first: Cell; second: Cell; }
data Envelope { cells: Pair; marker: i32; }
machine identity(source: &mut Pair) -> &mut Pair { source }
machine main() {
    let mut envelope: Envelope;
    let whole: &mut Pair = identity(&mut envelope.cells);
    let selected: &mut Cell = &mut whole.first;
    envelope.cells.second.value = 5;
    selected.value = 70;
}
