data Cell { value: u64; }
machine change<'storage>(source: &'storage mut Cell) -> &'storage Cell { source.value = 9; source }
machine apply<'storage, machine Callback>(source: &'storage mut Cell) -> &'storage Cell
where machine Callback<'fresh>(source: &'fresh mut Cell) -> &'fresh Cell;
{ Callback(source) }
machine seven(value: u64) -> u64 requires value == 7 ensures result == 7 { value }
machine main() {
    let mut storage: Cell = Cell { value: 7 };
    let selected: &Cell = apply<change>(&mut storage);
    let observed: u64 = seven(selected.value);
}
