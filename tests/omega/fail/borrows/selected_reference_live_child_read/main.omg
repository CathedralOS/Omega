// Alternative origins of one descriptor are not competing loans. A child
// descriptor is: it suspends the selected parent until the child's last use.
data Node { value: u64; }
data Pair { left: Node; right: Node; }
data Outer { anchor: u64; pair: Pair; }

machine pick(pair: &mut Pair, second: bool) -> &mut Node {
    transition second {
        true -> &mut pair.right
        false -> &mut pair.left
    }
}

machine invalid(outer: &mut Outer, second: bool) -> u64 {
    let selected: &mut Node = pick(&mut outer.pair, second);
    let child: &mut Node = &mut selected;
    let observed: u64 = selected.value;
    child.value = observed;
    observed
}
