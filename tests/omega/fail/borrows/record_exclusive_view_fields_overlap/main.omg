// Distinct field names do not make overlapping exclusive windows disjoint.
data Held { left: &mut [u32]; right: &mut [u32]; }
machine main() {
    let mut values: [u32; 3];
    let held: Held = Held {
        left: &mut values[0..2],
        right: &mut values[0..2]
    };
    let observed: u64 = held.right.len;
}
