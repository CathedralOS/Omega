// The selected payload loan cannot overlap fresh access through its original parent.
// Expected rejection: overlapping exclusive access.
data Cell { value: i32; }
data Message { body: &mut Cell; }
data Envelope { case Active(message: &mut Message); case Empty; }
machine write_and_read(target: &mut Cell, owner: &mut Message) -> bool {
    target.value = 41;
    target.value == 41 && owner.body.value == 7
}
machine exercise() -> bool {
    let mut backing: Cell = Cell { value: 17 };
    let mut other_backing: Cell = Cell { value: 7 };
    let mut container: Message = Message { body: &mut backing };
    let mut other_container: Message = Message { body: &mut other_backing };
    let envelope: Envelope = Envelope::Active { message: &mut container };
    match envelope {
        Envelope::Active { message as selected } -> write_and_read(&mut selected.body, &mut container)
        Envelope::Empty -> false
    }
}
machine main() crashes Trap {
    transition exercise() { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
