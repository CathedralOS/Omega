// A machine's states share the receiver authority its entry received. `run`
// enters through `&Main`, so no state may claim `&mut Main`: the jump into
// `next` would let it write storage the caller lent only for observation.
// The complement, a `&Main` state of a `&mut Main` machine jumping into a
// `&mut Main` sibling, stays accepted because that machine's entry holds the
// exclusive authority.

data Main { count: u64; other: u64; }

machine Main::run(main: &Main) -> u64 {
    transition { _ -> next(main) }
    state next(main: &mut Main) -> u64 {
        main.count = 4;
        (main.count)
    }
}

machine Main::through_shared_state(main: &Main) -> u64 {
    transition { _ -> look(main) }
    state look(main: &Main) -> u64 {
        transition { _ -> write(main) }
    }
    state write(main: &mut Main) -> u64 {
        main.other = 5;
        (main.other)
    }
}
