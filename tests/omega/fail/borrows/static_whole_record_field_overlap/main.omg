// The callee only writes a disjoint field, but its whole-record argument
// still establishes a loan overlapping the separately forwarded field loan.
data Store { first: u64; second: u64; }

machine Store::write_other(store: &mut Store, field: &mut u64) {
    store.second = 2;
    field = 3;
}

machine probe(store: &mut Store) {
    let field: &mut u64 = &mut store.first;
    Store::write_other(store, field);
}
