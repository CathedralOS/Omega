// Every evaluated read is judged where its statement evaluates it, whatever
// expression it sits in: an assignment's value, an operand of a comparison,
// a field of a constructed record, and a comparison passed as a call operand.
// Each reads storage an exclusive loan still suspends, since that loan is
// used after the read. `plain_read_during_live_exclusive_loan` covers reads
// that initialize a binding directly, and
// `float_comparison_read_during_live_exclusive_loan` a float comparison.
data Pair { left: u32; right: u32; }

machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine truth(value: bool) -> bool { value }

machine assignment_value() -> u32 {
    let mut value: u32 = 7;
    let mut other: u32 = 0;
    let borrowed: &mut u32 = &mut value;
    other = value;
    borrowed = 9;
    other
}

machine comparison_operand() -> bool {
    let mut value: u32 = 7;
    let lent: &mut u32 = &mut value;
    let bigger: bool = value > 3;
    lent = 9;
    bigger
}

machine record_field() -> u32 {
    let mut value: u32 = 7;
    let held: &mut u32 = &mut value;
    let pair: Pair = Pair { left: value, right: 1 };
    held = 9;
    pair.left
}

machine call_operand_comparison() -> bool {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = items.as_mut_slice();
    let middle: &mut [u8] = view[2..4];
    let seen: bool = truth(view[3] == 4);
    zero(middle);
    seen
}
