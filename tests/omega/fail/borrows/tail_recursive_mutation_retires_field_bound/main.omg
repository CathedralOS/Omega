// A real write to the guarded field must retire the old bound.
data Work { count: u64; scratch: f64; }
machine main() {
    let mut work: Work; work.count = 3;
    transition work.count <= 8 { true -> guarded(&mut work) false -> done() }
    machine guarded(work: &mut Work) requires work.count <= 8 {
        fill(work, 2); require_bound(work);
    }
    machine done() { }
}
machine fill(work: &mut Work, remaining: u64) {
    transition remaining > 0 { true -> write(work, remaining) false -> done() }
    machine write(work: &mut Work, remaining: u64) requires remaining > 0 {
        work.count = 9; transition { _ -> fill(work, remaining - 1) }
    }
    machine done() { }
}
machine require_bound(work: &Work) requires work.count <= 8 { }
