// Classifying the existing primitive home does not authorize its owner to
// read while the exclusive reference remains live at a later use.
machine observe(value: &u32) -> u32 { value }

machine exercise() -> u32 {
    let mut value: u32 = 7;
    let borrowed: &mut u32 = &mut value;
    let observed: u32 = observe(&value);
    borrowed = 9;
    observed
}
