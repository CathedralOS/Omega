// A previous iteration keeps a view of the buffer while the next rewrites it.
data Buffer { bytes: [u8; 2]; }
machine cycle(buffer: &mut Buffer, previous: &[u8], repeat: bool) -> u64 {
    buffer.bytes[0] = 65;
    let current: &[u8] = &buffer.bytes[0..2];
    transition repeat {
        true -> cycle(buffer, current, false)
        _ -> previous.len
    }
}
machine main() -> u64 {
    let mut buffer: Buffer;
    cycle(&mut buffer, "ok", true)
}
