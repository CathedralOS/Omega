// Two real inputs sit behind an erased one and the second is returned, so
// writing that second input while the reference is live must still reject.
machine second_of_two<'storage>(witness [erased]: &u64, first: &'storage mut u64, second: &'storage mut u64) -> &'storage mut u64 { second }

machine conflicting(proof: &u64, one: &mut u64, two: &mut u64) -> u64 {
    let chosen: &mut u64 = second_of_two(proof, one, two);
    two = 1;
    chosen = 10;
    two
}
