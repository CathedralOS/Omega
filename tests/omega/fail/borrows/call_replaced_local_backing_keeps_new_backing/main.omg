// A call that replaces `state.stored` with `&y` moves the live borrow to `y`:
// writing `y` while `state.stored` is still read later must be rejected.
data B { value: u64; }
data Main<'a> { stored: &'a B; }
machine store<'a>(main: &mut Main<'a>, source: &'a B) { main.stored = source; }
machine main() crashes Trap {
    let mut x: B = B { value: 1 };
    let mut y: B = B { value: 2 };
    let first: &B = &x;
    let second: &B = &y;
    let mut state: Main = Main { stored: first };
    store(&mut state, second);
    y.value = 5;
    let v: u64 = state.stored.value;
    transition v == 5 && x.value == 1 { true -> good() _ -> bad() }
    machine good() {}
    machine bad() { crash Trap; }
}
