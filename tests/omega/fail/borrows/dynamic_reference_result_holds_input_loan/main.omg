// A precise selected backing does not narrow the exclusive input loan
// retained by a helper's returned reference.
data Cell { value: u32; }
data Grid where cursor < 3 { cells: [Cell; 3]; cursor: u64; }
machine choose(grid: &mut Grid, flag: bool) -> &mut Cell {
    match flag {
        true -> &mut grid.cells[grid.cursor],
        _ -> &mut grid.cells[0]
    }
}
machine main() {
    let mut grid: Grid;
    grid.cursor = 1;
    let selected: &mut Cell = choose(&mut grid, true);
    grid.cursor = 2;
    selected.value = 70;
}
