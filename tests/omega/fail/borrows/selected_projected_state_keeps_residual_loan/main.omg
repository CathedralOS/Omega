
// This fixture explicitly assumes finite, normal completion of one byte write
// from its reviewed external provider. It does not strengthen std::Console.
public boundary trait Console {
    machine write_byte(byte: i32)
    reaches Console
    terminates;
}

boundary trait PosixConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    terminates;
}

// All bound targets are little-endian: the low byte is the first byte.
boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    terminates;
}

// An exclusive reference moves into another binding. Writing through the receiving
// binding changes the original backing; the following read must see 41.

data Counter { value: u64; }
data Carrier { output: &mut Counter; byte: i32; }
data Marker { byte: i32; }
data Keeper { carrier: Carrier; code: u64; }
data Pair { first: Carrier; second: Marker; }
machine Carrier::drop(carrier: &mut Carrier) reaches Console {
    Console::write_byte(carrier.byte);
}
machine Marker::drop(marker: &mut Marker) reaches Console {
    Console::write_byte(marker.byte);
}
machine Keeper::drop(keeper: &mut Keeper)
    requires keeper.code == 41
    reaches Console
{
    keeper.carrier.output.value = keeper.code;
}
machine observe(keeper: &Keeper) {}
machine exercise(pick: bool) reaches Console crashes Trap {
    let mut output: Counter = Counter { value: 0 };
    let mut spare: Counter = Counter { value: 0 };
    let original: Pair = Pair { first: Carrier { output: &mut output, byte: 65 }, second: Marker { byte: 88 } };
    let marker: Marker = Marker { byte: 77 };
    let alternate: Pair = Pair { first: Carrier { output: &mut spare, byte: 66 }, second: Marker { byte: 89 } };
    let selected: Carrier = match pick { true -> original.first, false -> alternate.first };
    let observed_output: u64 = output.value;
    let observed_spare: u64 = spare.value;
    transition { _ -> finish(selected) }
    machine finish(receiver: Carrier) {
        observe(&Keeper { carrier: receiver, code: 41 });
    }
}

data Main {}
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    exercise(true);
    exercise(false);
}
PosixConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mut cell: i32 = byte;
    let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
}
}

WindowsConsoleWrite satisfies Console {
    machine write_byte(byte: i32)

reaches Console
{
    let mut cell: i32 = byte;
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
