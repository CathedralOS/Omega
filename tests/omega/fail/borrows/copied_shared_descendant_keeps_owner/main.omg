use omega::language::core::drop;
data Receipt { value: u64; }
data SharedViews<'borrow> { first: &'borrow Receipt; second: &'borrow Receipt; }
machine split<'borrow>(receipt: &'borrow Receipt) -> SharedViews<'borrow> {
    SharedViews { first: receipt, second: receipt }
}
machine main() {
    let receipt: Receipt = Receipt { value: 17 };
    let views: SharedViews = split(&receipt);
    let first: u64 = views.first.value;
    drop(receipt);
    let second: u64 = views.second.value;
}
