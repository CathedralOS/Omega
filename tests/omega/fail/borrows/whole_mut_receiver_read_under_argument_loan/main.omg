// A whole `&mut` receiver reads the field its own call's argument lends
// exclusively: `counter` suspends `count` for the whole call, so the callee
// reading `main.count` after writing through `counter` would observe the
// aliased store. A read through a receiver helper is the callee's read too.

data Main { count: u64; other: u64; }

machine Main::peek(main: &Main) -> u64 { (main.count) }

machine Main::read_after(main: &mut Main, counter: &mut u64) -> u64 {
    counter = 5;
    let seen: u64 = main.count;
    (seen)
}

machine Main::read_through_helper(main: &mut Main, counter: &mut u64) -> u64 {
    counter = 5;
    (Main::peek(main))
}

machine Main::value_receiver_form(main: &mut Main) -> u64 {
    let seen: u64 = Main::read_through_helper(main, &mut main.count);
    (seen)
}

machine Main::main(main: &mut Main) -> u64 {
    let seen: u64 = Main::read_after(main, &mut main.count);
    (seen)
}
