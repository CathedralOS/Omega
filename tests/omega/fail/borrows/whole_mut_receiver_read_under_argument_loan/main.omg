// A whole `&mut` receiver reads the field its own call's argument lends
// exclusively: `counter` suspends `count` for the whole call, so the callee
// reading `self.count` after writing through `counter` would observe the
// aliased store. A read through a receiver helper is the callee's read too.

data Main { count: u64; other: u64; }

machine Main::peek(&self) -> u64 { (self.count) }

machine Main::read_after(&mut self, counter: &mut u64) -> u64 {
    counter = 5;
    let seen: u64 = self.count;
    (seen)
}

machine Main::read_through_helper(&mut self, counter: &mut u64) -> u64 {
    counter = 5;
    (self.peek())
}

machine Main::value_receiver_form(main: &mut Main) -> u64 {
    let seen: u64 = main.read_through_helper(&mut main.count);
    (seen)
}

machine Main::main(&mut self) -> u64 {
    let seen: u64 = self.read_after(&mut self.count);
    (seen)
}
