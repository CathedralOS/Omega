data Cell { value: i32; }

machine first<'storage>(chosen: &'storage Cell, retained: &'storage Cell) -> &'storage Cell {
    chosen
}

machine invalid(chosen: &mut Cell, retained: &mut Cell) -> i32 {
    let chosen_parent: &mut Cell = &mut chosen;
    let retained_parent: &mut Cell = &mut retained;
    let selected: &Cell = first(&chosen_parent, &retained_parent);
    // Exact result geometry does not discharge the other declared lifetime.
    retained.value = 83;
    selected.value
}
