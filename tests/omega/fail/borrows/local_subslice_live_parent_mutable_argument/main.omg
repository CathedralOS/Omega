// `middle` is an exclusive subslice of the local view `view` and is used after
// each call below, so it suspends the branch `view[2..4]` it captured until
// that last use. Lending `view` whole lends the suspended branch too, whatever
// the call's result binds, and a call that receives the parent beside its
// live child holds both at once. A grandchild suspends its parent the same
// way: `inner` is formed through `outer`, which is formed through `view`.
// A call operand is judged at the storage the operand's loan captured, as the
// direct write `view[2] = 9` is in the same position. Lending `view` after
// `middle`'s last use is
// `pass/borrows/local_subslice_parent_lent_after_last_use_exit`.
machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine swap_out(view: &mut [u8], value: u8) -> u8
requires view.len >= 1
{
    let old: u8 = view[0];
    view[0] = value;
    old
}

machine both(left: &mut [u8], right: &mut [u8])
requires left.len >= 1 && right.len >= 1
{
    left[0] = 1;
    right[0] = 2;
}

machine unit_result() {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = items.as_mut_slice();
    let middle: &mut [u8] = view[2..4];
    zero(view);
    zero(middle);
}

machine scalar_result() -> u8 {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = items.as_mut_slice();
    let middle: &mut [u8] = view[2..4];
    let old: u8 = swap_out(view, 9);
    zero(middle);
    old
}

machine parent_beside_child() {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = items.as_mut_slice();
    let middle: &mut [u8] = view[2..4];
    both(view, middle);
}

machine child_of_child() {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = items.as_mut_slice();
    let outer: &mut [u8] = view[0..4];
    let inner: &mut [u8] = outer[1..3];
    zero(outer);
    zero(inner);
}
