data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket in Issued { Ticket { number: 7 } }
machine corrupt(ticket: &mut Ticket) -> bool
requires ticket in Issued
ensures ticket in Issued
{
    transition { _ -> replace(ticket) }
    machine replace(renamed: &mut Ticket) -> bool {
        renamed = Ticket { number: 7 };
        transition { _ -> finish() }
    }
    machine finish() -> bool { true }
}
