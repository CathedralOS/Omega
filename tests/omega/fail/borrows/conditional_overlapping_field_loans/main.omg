module split_guard;
use omega_language_std::console;

pub data Cell { value: i32 in Wrapping; }
pub data Main { left: Cell; right: Cell; }

machine split(source: &Cell, destination: &mut Cell) -> bool {
    destination.value = source.value + 1;
    destination.value == 66
}

pub machine Main::main(application: &mut Main) reaches Console
invokes Console;
blocks;
crashes Trap
{
    transition block Console::read_byte() {
        ByteRead::Byte { value } -> initialize(application, value)
        _ -> failure(application)
    }
    state initialize(application: &mut Main, value: i32) {
        application.left.value = value as i32 in Wrapping;
        // Simultaneous shared/exclusive sibling loans have one root and disjoint paths.
        transition split(&application.left, &mut application.left) {
            true -> confirm(application)
            false -> failure(application)
        }
    }
    state confirm(application: &mut Main) {
        transition application.right.value == 66 {
            true -> success(application)
            false -> failure(application)
        }
    }
    state success(application: &mut Main) {
        Console::write_line("split loans observed");
        Console::exit_process(0);
    }
    state failure(application: &mut Main) { Console::exit_process(3); }
}
