data Main {
    value: i32;
}

machine Main::main(main: &mut Main) -> i32 {
    transition {
        _ -> swap(&mut main.value, &mut main.value)
    }
    

    machine swap(left: &mut i32, right: &mut i32) -> i32 {
        left = right;

        transition {
            _ -> shutdown()
        }
    }

    machine shutdown() -> i32 {
        0
    }
}
