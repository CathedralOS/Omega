data Main {
    value: i32;
}

machine Main::main(&mut self) -> i32 {
    transition {
        _ -> swap(&mut self.value, &mut self.value)
    }
    

    state swap(left: &mut i32, right: &mut i32) {
        left = right;

        transition {
            _ -> shutdown()
        }
    }

    state shutdown() {
        0
    }
}
