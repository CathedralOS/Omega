// Matching member spelling is not evidence about the selected referent.
data Bounded requires value >= 0, value <= 100 { value: i32; }
data Plain { value: i32; }

machine require_cell_value(value: i32)
requires value >= 0 && value <= 100
{}

machine read(cells: &[&Plain; 2], selected: u64)
requires selected < 2
{
    let observed: i32 = cells[selected].value;
    require_cell_value(observed);
}
