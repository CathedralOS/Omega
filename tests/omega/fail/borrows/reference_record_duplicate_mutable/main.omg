// A record literal cannot hold two live exclusive loans of one field.
use omega_language_std::console;

data Cell { stamp: i32; value: i32 [0..=100]; }
data Pair<'a> { left: &'a mut Cell; right: &'a mut Cell; }
data Main {
    first: Cell;
    second: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.second.stamp = 5;
    main.second.value = 70;
    let pair: Pair = Pair { left: &mut main.first, right: &mut main.first };
    let observed: i32 [0..=100] = pair.right.value;
    transition observed == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
