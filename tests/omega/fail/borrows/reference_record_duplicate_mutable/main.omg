// A record literal cannot hold two live exclusive loans of one field.
use omega_language_std::console;

data Cell where value >= 0 && value <= 100 { stamp: i32; value: i32; }
data Pair<'a> { left: &'a mut Cell; right: &'a mut Cell; }
data Main {
    first: Cell;
    second: Cell;
}

machine Main::main(main: &mut Main) reaches Console {
    main.first.stamp = 3;
    main.first.value = 11;
    main.second.stamp = 5;
    main.second.value = 70;
    let pair: Pair = Pair { left: &mut main.first, right: &mut main.first };
    let observed: i32 = pair.right.value;
    transition observed == 70 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
