// A potentially normal sibling still owes its reference lifetime; it cannot
// be omitted as if it were a crash-only path.
data Node { value: u64; }
machine choose(node: &mut Node, take: bool) -> &mut Node {
    transition take { true -> (node) false -> invalid() }
    machine invalid() -> &mut Node {
        let mut local: Node = Node { value: 71 };
        &mut local
    }
}
machine main() {
    let mut node: Node = Node { value: 70 };
    let result: &mut Node = choose(&mut node, false);
}
