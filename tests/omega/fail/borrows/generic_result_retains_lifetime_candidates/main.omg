data Envelope<T> { payload: T; }

machine choose<'storage>(first: &'storage i32, second: &'storage i32)
-> Envelope<&'storage i32> {
    Envelope { payload: first }
}

machine invalid() {
    let first: i32 = 42;
    let mut second: i32 = 19;
    let selected: &i32 = choose(&first, &second).payload;
    second = 7;
    let observed: i32 = selected;
}

machine main() {}
