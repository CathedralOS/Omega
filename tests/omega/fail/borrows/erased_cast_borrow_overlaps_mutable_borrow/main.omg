// An erasing cast drops a domain meaning but leaves the value in its
// operand's storage, so borrowing the cast still borrows `t`.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine both(a: &mut Ticket in Ticket::Held, b: &Ticket) { a.number = b.number; }
machine main() {
    let mut t: Ticket in Ticket::Held = issue();
    both(&mut t, &(t as Ticket));
}
