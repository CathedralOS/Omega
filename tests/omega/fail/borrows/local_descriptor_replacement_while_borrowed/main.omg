// A borrow of a local descriptor retains that slot through its last use.
data Token { identity: u64; }
machine exercise() -> u64 {
    let left: Token = Token { identity: 37 };
    let right: Token = Token { identity: 43 };
    let mut view: &Token = &left;
    let borrowed: & &Token = &view;
    view = &right;
    borrowed.identity
}
