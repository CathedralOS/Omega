// A read observes the storage it names. A live exclusive loan suspends the
// branch it captured until its last use, so reading that branch by any other
// path rejects, as a write or a call operand there does. Each read below runs
// while the exclusive loan is still live, because that loan is used after it:
// through the parent view `middle` was formed from, through the owner
// `middle` borrows directly, and of a scalar lent whole by `&mut`. Reads
// after the loan's last use, of a disjoint field, and under a shared loan are
// `pass/borrows/plain_read_after_exclusive_loan_last_use_exit`.
machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine read_through_parent_view() -> u8 {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = &mut items[..];
    let middle: &mut [u8] = &mut view[2..4];
    let seen: u8 = view[3];
    zero(middle);
    seen
}

machine read_direct_owner() -> u8 {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let middle: &mut [u8] = &mut items[2..4];
    let seen: u8 = items[2];
    zero(middle);
    seen
}

machine read_scalar_owner() -> u32 {
    let mut value: u32 = 7;
    let borrowed: &mut u32 = &mut value;
    let observed: u32 = value;
    borrowed = 9;
    observed
}

// A selected case retains its exclusive descriptor's loan. The backing stays
// unavailable until the consuming call, just as for a bare reference.
data Cell { value: i32; }
data Selection<'storage> {
    case Held(target: &'storage mut Cell);
    case Empty;
}
machine consume_selection<'storage>(selection: Selection<'storage>) {}
machine read_case_owner() -> i32 {
    let mut cell: Cell = Cell { value: 17 };
    let selection: Selection = Selection::Held { target: &mut cell };
    let observed: i32 = cell.value;
    consume_selection(selection);
    observed
}
