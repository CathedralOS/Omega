data Ticket [copy] { number: u64; }
data Held<'storage> { target: &'storage mut Ticket; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket in Issued { Ticket { number: 7 } }
machine corrupt<'storage>(ticket: &'storage mut Ticket) -> bool
requires ticket in Issued
ensures ticket in Issued
{
    let held: Held<'storage> = Held { target: ticket };
    transition { _ -> replace(held) }
    machine replace(mut held: Held<'storage>) -> bool {
        held.target = Ticket { number: 7 };
        transition { _ -> finish() }
    }
    machine finish() -> bool { true }
}
