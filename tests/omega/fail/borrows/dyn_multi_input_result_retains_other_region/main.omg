// The selected value of a copied first argument remains 7 when the second argument replaces its former descriptor home with a view of 9.
// Expected exit: 0

data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
trait Windowing {
    machine window<'storage>(packet: &'storage [u8], tail: &'storage [u8]) -> View<'storage>
    requires packet.len == 9 && tail.len == 4
    ensures result.bytes.len == 7, result.sibling.len == 4;
}
Header satisfies Windowing {
    machine window<'storage>(packet: &'storage [u8], tail: &'storage [u8]) -> View<'storage>
    requires packet.len == 9 && tail.len == 4
    ensures result.bytes.len == 7, result.sibling.len == 4
    { View { bytes: &packet[0..7], sibling: tail } }
}
Trailer satisfies Windowing {
    machine window<'storage>(packet: &'storage [u8], tail: &'storage [u8]) -> View<'storage>
    requires packet.len == 9 && tail.len == 4
    ensures result.bytes.len == 7, result.sibling.len == 4
    { View { bytes: &packet[2..9], sibling: tail } }
}
machine choose(first: bool) -> dyn Windowing {
    transition first { true -> (Header as dyn Windowing) false -> (Trailer as dyn Windowing) }
}
machine receive<'storage>(selected: &'storage [u8], ignored: u64) -> u64
requires selected.len == 7
ensures result == 7
{ selected.len }
machine mutate(selected: &mut [u8; 4]) -> u64 { selected[0] = 0u8; 0 }
machine main() {
    let mut storage: [u8; 9] = [11, 2, 29, 4, 5, 6, 7, 8, 9];
    let mut sibling: [u8; 4] = [20, 21, 22, 23];
    let observed: u64 = receive(Windowing::window(choose(true), &storage[..], &sibling[..]).bytes, mutate(&mut sibling));
}
