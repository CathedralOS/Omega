// A readable intermediate pointer keeps its actual child loan live.
data Cell { value: i64; }
data Held { target: &mut Cell; }

machine invalid(held: &mut Held) -> i64 {
    let child: &Cell = &held.target;
    held.target.value = 85;
    child.value
}

machine main() {
    let mut cell: Cell = Cell { value: 11 };
    let mut held: Held = Held { target: &mut cell };
    let observed: i64 = invalid(&mut held);
}
