data Cell { value: i32; }
data Message { body: &Cell; }
data Envelope { message: Message; }

machine read_cell(cell: &Cell) -> i32 { cell.value }

machine exercise(cell: &mut Cell) -> i32 {
    let envelope: Envelope = Envelope { message: Message { body: cell } };
    cell.value = 71;
    read_cell(envelope.message.body)
}
