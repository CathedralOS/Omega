// The stored parent descriptor remains until its explicit child borrow ends.
use omega_language_std::console;

data Cell { value: i32 [0..=100]; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Main { cell: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { body: &mut main.cell, stamp: 11 };
    let child: &Cell = &message.body;
    let observed: i32 [0..=100] = child.value;
    main.cell.value = 81;
    let ready: bool = child.ready;
    let stamp: i32 = message.stamp;
    transition observed == 70 && ready && stamp == 11 && main.cell.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
