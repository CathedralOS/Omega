use omega::language::core::drop;

data Token<'storage> [linear] { reference: &'storage i32; }
machine Token::drop(token: &mut Token<'storage>) {}

machine retain<'storage>(token: Token<'storage>) -> &'storage i32 {
    let reference: &'storage i32 = token.reference;
    drop(token);
    reference
}

machine main() -> i32 {
    let mut backing: i32 = 41;
    let token: Token = Token { reference: &backing };
    let reference: &i32 = retain(token);
    backing = 42;
    reference
}
