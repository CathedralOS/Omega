// Borrowing a record literal that holds a borrow of `second` keeps that
// input loan until the borrow's last use, even though the literal, its
// contents and the outer borrow all form in one statement.
data Envelope<Payload> { payload: Payload; }

machine main() crashes Trap {
    let mut second: Envelope<i32> = Envelope { payload: 23i32 };
    let produced: &Envelope<&Envelope<i32>> = &Envelope { payload: &second };
    second.payload = 29i32;
    transition produced.payload.payload == 23 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
