data Envelope<Payload> { payload: Payload; }

machine escape() -> Envelope<&Envelope<i32>> {
    Envelope { payload: &Envelope { payload: 5i32 } }
}

machine main() crashes Trap {
    let escaped: Envelope<&Envelope<i32>> = escape();
    transition escaped.payload.payload == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
