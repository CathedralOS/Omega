// Applied boundary arguments retain their concrete writable descriptor slots.
// A symbolic sibling cannot suppress the required destination/backing relation.
data Slot<'data> { target: &'data u64; }
data Writer<'owner, 'data> { destination: &'owner mut Slot<'data>; }
data Mixed<'owner, 'data, Value> { value: Value; writer: Writer<'owner, 'data>; }
boundary trait Replace<Value> { machine call(value: Value) -> u64 reaches; }
boundary trait Store<Value> { machine call(value: Value) reaches; }

machine expression<'owner, 'data>(writer: Writer<'owner, 'data>) -> u64 {
    Replace<Writer<'owner, 'data>>::call(writer)
}
machine statement<'owner, 'data>(writer: Writer<'owner, 'data>) -> u64 {
    Store<Writer<'owner, 'data>>::call(writer);
    0
}
machine mixed_expression<'owner, 'data, Value>(value: Mixed<'owner, 'data, Value>) -> u64 {
    Replace<Mixed<'owner, 'data, Value>>::call(value)
}
