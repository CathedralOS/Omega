// Selecting one returned case must not erase other declared lifetime inputs.
data Cell { value: i32; }
data Selection<'storage> {
    case Left(target: &'storage Cell);
    case Right(target: &'storage Cell);
}

machine select<'storage>(
    left: bool, first: &'storage Cell, second: &'storage Cell
) -> Selection<'storage> {
    transition left {
        true -> Selection::Left { target: first }
        false -> Selection::Right { target: second }
    }
}

machine read<'storage>(selection: &Selection<'storage>) -> i32 {
    transition selection {
        Selection::Left { target } -> target.value
        Selection::Right { target } -> target.value
    }
}

machine invalid<'storage>(first: &'storage Cell, second: &'storage mut Cell) -> i32 {
    let selected: Selection<'storage> = select(true, first, second);
    second.value = 23;
    read(&selected)
}
