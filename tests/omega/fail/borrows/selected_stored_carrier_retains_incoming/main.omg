// Expected exit: 0.
data Cell { value: i32; }
data Held { target: &Cell; }
machine install(output: &mut Held, input: Held) -> i32 {
    output = input;
    23
}
machine selected(choice: bool) -> bool {
    let mut left: Cell = Cell { value: 11 };
    let mut right: Cell = Cell { value: 85 };
    let mut held: Held = Held { target: &left };
    let installed: i32 = match choice {
        true -> install(&mut held, Held { target: &right }),
        false -> 0,
    };
    left.value = 99;
    let observed: i32 = held.target.value;
    left.value = 29;
    right.value = 41;
    match choice {
        true -> installed == 23 && observed == 85,
        false -> installed == 0 && observed == 11,
    }
}
machine main() crashes Trap {
    transition selected(true) && selected(false) {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
