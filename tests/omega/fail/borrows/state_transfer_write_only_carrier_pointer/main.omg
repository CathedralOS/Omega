// Expected error: reads field `body` from write-only parameter `carrier`
// Address formation cannot read the old pointer stored in write-only storage.
data Control { value: i32; }
data Carrier { body: &mut Control; }
machine transfer(carrier: &write Carrier) {
    transition { _ -> done(carrier.body) }
    machine done(reference: &write Control) { reference.value = 2; }
}
