data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket
ensures result in Issued { Ticket { number: 7 } }
machine fail_to_issue(ticket: &mut Ticket, choose: bool) -> bool
ensures ticket in Issued
{
    let mut private: Ticket = Ticket { number: 0 };
    transition choose {
        true -> qualify(ticket)
        _ -> qualify(&mut private)
    }
    machine qualify(selected: &mut Ticket) -> bool {
        selected = issue();
        transition { _ -> finish() }
    }
    machine finish() -> bool { true }
}
