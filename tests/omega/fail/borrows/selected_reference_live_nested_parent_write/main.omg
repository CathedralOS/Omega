machine choose<'storage>(first: &'storage mut i64, second: &'storage mut i64, choose_second: bool) -> &'storage mut i64 {
    transition choose_second {
        true -> second
        _ -> first
    }
}
machine conflicting(first: &mut i64, second: &mut i64) {
    let first_parent: &mut i64 = &mut first;
    let second_parent: &mut i64 = &mut second;
    let selected: &mut i64 = choose(first_parent, second_parent, false);
    let nested: &mut i64 = &mut selected;
    second_parent = 0;
    nested = 1;
}
