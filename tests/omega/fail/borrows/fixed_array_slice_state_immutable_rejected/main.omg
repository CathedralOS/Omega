// An established shared array loan cannot create an exclusive slice loan.
// Descriptor compatibility does not confer write authority.
machine change(values: &[u8; 4]) {
    transition { _ -> write(&mut values) }
    machine write(values: &mut [u8]) {}
}
machine main() {
    let values: [u8; 4] = [51, 52, 53, 54];
    change(&values);
}
