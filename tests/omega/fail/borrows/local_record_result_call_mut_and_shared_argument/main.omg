// A local record lent `&mut` into a record-returning call is still one
// exclusive loan: lending the same local `&` to that call as well aliases the
// storage the callee writes. A plain result does not relax the argument
// overlap rule.

data Tally { hits: i32 in Wrapping; misses: i32 in Wrapping; }
data Report { total: i32 in Wrapping; }

machine Tally::absorb(into: &mut Tally, from: &Tally) -> Report {
    into.hits = into.hits + from.hits;
    transition { _ -> (Report { total: into.hits + into.misses }) }
}

machine main() {
    let mut tally: Tally;
    let merged: Report = Tally::absorb(&mut tally, &tally);
}
