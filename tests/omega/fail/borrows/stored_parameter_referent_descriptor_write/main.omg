// The same mutable reference parameter cannot move into two records: after
// the first store transfers the loan, the second store has no authority.
data Leaf { count: u64 in Wrapping }
data Payload { guard: &mut Leaf }
data Box { child: &mut Payload }

machine probe(payload: &mut Payload) -> u64 in Wrapping {
    let mut b: Box = Box { child: payload };
    let mut c: Box = Box { child: payload };
    b.child.guard.count + c.child.guard.count
}
