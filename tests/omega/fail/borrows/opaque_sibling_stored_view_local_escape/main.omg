// An opaque sibling is not a descriptor slot, but it cannot hide a real
// stored view's local backing when the containing carrier survives a return.
boundary data Token;
data Text { bytes: &[u8]; }
data Holder { token: Token; text: Text; }

machine replace(holder: &mut Holder) {
    let bytes: [u8; 4] = [65, 66, 67, 68];
    holder.text = Text { bytes: &bytes[..] };
}
