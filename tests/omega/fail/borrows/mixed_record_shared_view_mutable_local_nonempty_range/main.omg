// The record's writable owner and exclusive sibling cannot widen this shared field.
data Mixed { shared: &[u32]; exclusive: &mut [u32]; }

machine violate(mut current: Mixed)
requires current.shared.len > 0;
{
    let requested: &mut [u32] = &mut current.shared[0..1];
    transition requested.len > 0 {
        true -> write(requested)
        false -> done()
    }
    machine write(values: &mut [u32])
    requires values.len > 0;
    { values[0] = 99; }
    machine done() {}
}

machine main() crashes Trap {
    let shared_values: [u32; 1] = [7];
    let mut exclusive_values: [u32; 1];
    let shared: &[u32] = &shared_values[..];
    let current: Mixed = Mixed {
        shared: shared,
        exclusive: &mut exclusive_values[0..1]
    };
    transition current.shared.len > 0 && shared.len > 0 {
        true -> invoke(current, shared)
        false -> bad()
    }
    machine invoke(current: Mixed, original: &[u32])
    requires current.shared.len > 0 && original.len > 0;
    {
        violate(current);
        let observed: u32 = original[0];
        transition observed == 7 {
            true -> done()
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
