// A carrier-qualified call has no receiver exemption: its first argument
// keeps its loan while the nested second argument tries to borrow it again.
data Main { hits: u64 in Wrapping; }

machine Main::bump(main: &mut Main, value: u64 in Wrapping) -> u64 in Wrapping {
    main.hits = main.hits + 1;
    value + 1
}

machine Main::main(main: &mut Main) -> u64 in Wrapping {
    Main::bump(main, Main::bump(main, 3))
}
