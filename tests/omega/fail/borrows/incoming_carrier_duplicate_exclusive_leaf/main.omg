data Carrier<'storage> { reference: &'storage mut i32; }
data Pair<'storage> {
    first: &'storage mut i32;
    second: &'storage mut i32;
}

machine duplicate<'storage>(carrier: Carrier<'storage>) -> Pair<'storage> {
    Pair { first: carrier.reference, second: carrier.reference }
}

machine main() -> i32 { 0 }
