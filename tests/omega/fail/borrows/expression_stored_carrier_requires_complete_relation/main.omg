data Cell { value: i32; }
data Held<'a> { target: &'a Cell; }
machine install<'a>(output: &mut Held<'a>, input: Held<'a>) -> i32 { output = input; 23 }
machine forward_written<'a>(counter: &mut i32, value: Held<'a>) -> Held<'a> { counter = 1; value }
machine main() {
    let mut left: Cell = Cell { value: 11 };
    let mut right: Cell = Cell { value: 85 };
    let mut held: Held = Held { target: &left };
    let mut counter: i32 = 0;
    let installed: i32 = install(&mut held, forward_written(&mut counter, Held { target: &right }));
    right.value = 99;
    let observed: i32 = held.target.value;
}
