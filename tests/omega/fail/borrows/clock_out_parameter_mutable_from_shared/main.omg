// A selected clock out-parameter cannot elevate a shared observation to a write.

public data Instant { seconds: i64; nanoseconds: i64; }
public boundary trait ClockProbe {
    machine read(selector: u32, instant: &mut Instant) -> i32 reaches;
}
data Main { }

machine Main::main(main: &mut Main) reaches ClockProbe {
    let instant: Instant = Instant { seconds: 0, nanoseconds: 0 };
    let shared: &Instant = &instant;
    let status: i32 = ClockProbe::read(0, shared);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ClockProbe {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
