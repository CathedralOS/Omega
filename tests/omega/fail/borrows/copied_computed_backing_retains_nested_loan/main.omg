data Envelope<Payload> { payload: Payload; }

machine observe(view: &Envelope<&Envelope<i32>>) -> i32 { view.payload.payload }

machine main() crashes Trap {
    let mut original: Envelope<i32> = Envelope { payload: 17i32 };
    let view: &Envelope<&Envelope<i32>> = &Envelope { payload: &original };
    let alias: &Envelope<&Envelope<i32>> = view;
    original.payload = 19i32;
    transition observe(alias) == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
