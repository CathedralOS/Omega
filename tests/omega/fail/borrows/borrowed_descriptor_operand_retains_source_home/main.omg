// A completed argument keeps the selected loan until its consuming call.
data Cell { value: i32; }
data View<'storage> [copy] { target: &'storage Cell; }
data Envelope<'storage> [copy] { case Active(cell: &'storage Cell); case Empty; }
machine replace<'storage>(view: &mut View<'storage>, incoming: &'storage Cell) -> bool {
    view.target = incoming;
    true
}
machine inspect<'storage>(view: &View<'storage>, changed: bool) -> i32 { view.target.value }
machine main() crashes Trap {
    let first: Cell = Cell { value: 17 };
    let second: Cell = Cell { value: 19 };
    let mut view: View = View { target: &first };
    let observed: i32 = inspect(&view, replace(&mut view, &second));
    transition observed == 17 && view.target.value == 19 {
        true -> done() false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
