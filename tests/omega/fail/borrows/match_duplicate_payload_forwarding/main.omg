// Two forwarded exclusive descriptors cannot borrow the same captured payload.
data Counter { value: u32 in Wrapping; }
data Note { counter: &mut Counter; value: i32; }
machine append(left: &mut Counter, right: &mut Counter) -> bool {
    left.value = left.value + 1;
    right.value = right.value + 1;
    true
}
machine inspect(note: Note) -> bool {
    match note { Note { counter, value as _ } -> append(counter, counter) }
}
machine main() {
    let mut counter: Counter = Counter { value: 0 };
    let note: Note = Note { counter: &mut counter, value: 41 };
    let observed: bool = inspect(note);
}
