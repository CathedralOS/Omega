// A pending registration keeps its buffer lent after register returns: Pending<'source>
// retains the loan of main.buffer until completion consumes it. Carrying it into the
// terminal call wait() does not end that loan early, so writing the buffer inside wait
// before completion must reject. The pass twin writes only after completion.
use omega::language::core::content;
public data ByteUnit {}
public data Buffer { value: u64; }
public domain Buffer::Owned;
machine Owned::content(buffer: &Buffer) -> CountedQuantity<ByteUnit>
satisfies Content<Buffer, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Pending<'source> [linear] { slot: u64; }
public domain Pending::Retained established by Reader::register;
machine Retained::content<'source>(pending: &Pending<'source>) -> CountedQuantity<ByteUnit>
satisfies Content<Pending<'source>, CountedQuantity<ByteUnit>>::project {
    CountedQuantity { magnitude: Nat::Succ { prev: Nat::Zero } }
}
public data Capacity [linear] { token: u64; }
public domain Capacity::Available established by Reader::acquire, Reader::complete;
public boundary trait Reader {
    machine acquire() -> Capacity reaches ensures result in Capacity::Available crashes Trap;
    machine register<'source>(capacity: Capacity in Capacity::Available, buffer: &'source Buffer in Buffer::Owned) -> Pending<'source>
    reaches
    ensures result in Pending::Retained crashes Trap;
    machine complete<'source>(pending: Pending<'source> in Pending::Retained, observed: &mut u64) -> Capacity
    reaches
    ensures result in Capacity::Available crashes Trap;
    machine release(capacity: Capacity in Capacity::Available) reaches crashes Trap;
}
data Main { buffer: Buffer; }
machine Main::run(main: &mut Main) reaches Reader crashes Trap {
    let capacity: Capacity in Capacity::Available = Reader::acquire();
    let pending: Pending = Reader::register(capacity, &main.buffer);
    transition { _ -> wait(main, pending) }

    machine wait(main: &mut Main, pending: Pending in Pending::Retained) reaches Reader crashes Trap {
        main.buffer.value = 99;
        let mut observed: u64 = 0;
        let returned: Capacity in Capacity::Available = Reader::complete(pending, &mut observed);
        Reader::release(returned);
        transition observed == 37 { true -> done(main) _ -> bad(main) }
    }

    machine done(main: &mut Main) {}
    machine bad(main: &mut Main) crashes Trap { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Reader crashes Trap {
    let mut entry_storage: Main = Main { buffer: Buffer { value: 37 } };
    Main::run(&mut entry_storage);
}
