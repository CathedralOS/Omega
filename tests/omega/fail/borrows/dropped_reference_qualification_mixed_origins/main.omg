data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket in Issued { Ticket { number: 7 } }
machine corrupt_one(left: &mut Ticket, right: &mut Ticket, choose: bool) -> bool
requires left in Issued, right in Issued
ensures left in Issued, right in Issued
{
    transition choose {
        true -> replace(left)
        _ -> replace(right)
    }
    machine replace(selected: &mut Ticket) -> bool {
        selected = Ticket { number: 7 };
        transition { _ -> finish() }
    }
    machine finish() -> bool { true }
}
