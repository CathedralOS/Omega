data Cell [copy] { value: i32; }
machine escape<'storage>(owned: Cell, input: &'storage Cell) -> &'storage Cell { &owned }
machine main() crashes Trap {
    let original: Cell = Cell { value: 17 };
    let escaped: &Cell = escape(original, &original);
    transition escaped.value == 17 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
