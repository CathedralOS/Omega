// A whole `&mut` receiver call reads what its callee reads while every loan
// live around the call stays live. `view` is used after the call, so its
// exclusive loan suspends `count` across it: `peek_count` reading
// `self.count` observes storage `view` rewrites afterwards, although no
// operand of the call names `view`. A read through a receiver helper is the
// callee's read too. The complement, `view` last used before the call, is
// `pass/borrow/runtime_method_view_write_after_last_use_exit`'s use-ranged
// loan.

data Main { count: u64; other: u64; }

machine Main::peek(&self) -> u64 { (self.count) }

machine Main::peek_count(&mut self) -> u64 { (self.count) }

machine Main::peek_through(&mut self) -> u64 { (self.peek()) }

machine Main::read_through_helper(&mut self) -> u64 {
    let other_view: &mut u64 = &mut self.count;
    let seen: u64 = self.peek_through();
    other_view = 4;
    (seen)
}

machine Main::run(&mut self) -> u64 {
    let view: &mut u64 = &mut self.count;
    let seen: u64 = self.peek_count();
    view = 3;
    (seen)
}
