data Window<'input> { bytes: &'input [u8]; }
machine select<'input>(bytes: &'input [u8], start: u64, end: u64) -> Window<'input> {
    transition { _ -> capture(bytes, start, end) }
    state capture(bytes: &'input [u8], start: u64, end: u64) -> Window<'input> {
        Window { bytes: &bytes[start..end] }
    }
}
machine main() {}
