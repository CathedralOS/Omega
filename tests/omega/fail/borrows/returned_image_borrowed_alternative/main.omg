// An image alternative cannot erase the other alternative's backing loan.
machine choose<'storage>(bytes: &'storage [u8], image: bool) -> &'storage [u8] {
    transition image { true -> ("image") false -> (bytes) }
}
machine mutate(bytes: &mut [u8; 4]) { bytes[0] = 9; }
machine main() -> u64 {
    let mut bytes: [u8; 4] = [1, 2, 3, 4];
    let selected: &[u8] = choose(&bytes[..], false);
    mutate(&mut bytes);
    length(selected)
    machine length(selected: &[u8]) -> u64 { selected.len }
}
