// Moving a descriptor into a constructor does not release its live referent.
use omega_language_std::console;

data Cell where value >= 0 && value <= 100 { value: i32; ready: bool; }
data Message { body: &mut Cell; stamp: i32; }
data Held { target: &mut Cell; stamp: i32; }
data Main { cell: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { body: &mut main.cell, stamp: 11 };
    let held: Held = Held { target: message.body, stamp: 12 };
    let observed: i32 = held.target.value;
    main.cell.value = 81;
    let ready: bool = held.target.ready;
    let stamp: i32 = message.stamp;
    let held_stamp: i32 = held.stamp;
    transition observed == 70 && ready && stamp == 11 && held_stamp == 12 && main.cell.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
