// The temporary record may die after selected returns. Its returned field
// still holds the original backing while the later operand tries to write it.
data Packet<'bytes> [copy] { bytes: &'bytes [u8]; }
machine selected<'bytes>(packet: &Packet<'bytes>) -> &'bytes [u8] { packet.bytes }
machine observe(bytes: &[u8], changed: u64) -> u64 { changed }
machine mutate(bytes: &mut [u8]) -> u64 {
    transition bytes.len > 0u64 { true -> write(bytes) false -> 0u64 }
    machine write(bytes: &mut [u8]) -> u64 { bytes[0u64] = 9u8; 0u64 }
}
machine conflict<'bytes>(bytes: &'bytes mut [u8]) {
    let observed: u64 = observe(selected(&Packet<'bytes> { bytes: &bytes[..] }), mutate(bytes));
}
machine main() {
    let mut bytes: [u8; 1] = [42u8];
    conflict(&mut bytes[..]);
}
