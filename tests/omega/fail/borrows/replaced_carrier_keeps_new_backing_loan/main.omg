data Cell { value: i32; }
data Carrier<'storage> { reference: &'storage Cell; }
data Holder<'storage> { carrier: Carrier<'storage>; }

machine reject_live_write() -> i32 {
    let previous: Cell = Cell { value: 39 };
    let mut replacement: Cell = Cell { value: 42 };
    let mut holder: Holder = Holder {
        carrier: Carrier { reference: &previous }
    };
    holder.carrier = Carrier { reference: &replacement };
    replacement.value = 7;
    holder.carrier.reference.value
}
