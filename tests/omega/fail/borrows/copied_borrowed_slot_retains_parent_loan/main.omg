data Holder<'a> [copy] { value: &'a u64; }

machine main() crashes Trap {
    let mut original: u64 = 7;
    let replacement: u64 = 42;
    let parent: &mut u64 = &mut original;
    let mut holder: Holder = Holder { value: &replacement };
    let slot: &mut Holder = &mut holder;
    slot.value = &parent;
    let copied: &u64 = slot.value;
    slot.value = &replacement;
    parent = 9;
    let observed: u64 = copied;
    transition observed == 7 && parent == 9 && slot.value == 42 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
