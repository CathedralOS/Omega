data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; stamp: i32; }
data Envelope<'storage> { held: Held<'storage>; seal: i32; }
data Pair<'first, 'second> { left: Held<'first>; right: Held<'second>; }

machine select<'storage>(first: &'storage Cell, second: &'storage Cell, selected: bool) -> Held<'storage> {
    match selected {
        true -> Held { target: first, stamp: 12 },
        false -> Held { target: second, stamp: 13 }
    }
}

machine invalid(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    // Even a known first selection retains the declared second lifetime input.
    let held: Held = select(&first_parent, &second_parent, true);
    let copied: &Cell = held.target;
    let original: i32 = held.target.value;
    second.value = 83;
    copied.value
}

machine invalid_nested(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let envelope: Envelope = Envelope {
        held: select(&first_parent, &second_parent, true), seal: 17
    };
    second.value = 83;
    envelope.held.target.value
}

machine pair<'first, 'second>(first: &'first Cell, second: &'second Cell) -> Pair<'first, 'second> {
    Pair {
        left: Held { target: first, stamp: 12 },
        right: Held { target: second, stamp: 13 }
    }
}

machine invalid_projected(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let held: Held = pair(&first_parent, &second_parent).left;
    first.value = 51;
    held.target.value
}
