data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; stamp: i32; }
data Envelope<'storage> { held: Held<'storage>; seal: i32; }
data Pair<'first, 'second> { left: Held<'first>; right: Held<'second>; }

machine select<'storage>(first: &'storage Cell, second: &'storage Cell, selected: bool) -> Held<'storage> {
    match selected {
        true -> Held { target: first, stamp: 12 },
        false -> Held { target: second, stamp: 13 }
    }
}

machine invalid(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    // Even a known first selection retains the declared second lifetime input.
    let held: Held = select(&first_parent, &second_parent, true);
    let copied: &Cell = held.target;
    let original: i32 = held.target.value;
    second.value = 83;
    copied.value
}

machine invalid_nested(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let envelope: Envelope = Envelope {
        held: select(&first_parent, &second_parent, true), seal: 17
    };
    second.value = 83;
    envelope.held.target.value
}

machine pair<'first, 'second>(first: &'first Cell, second: &'second Cell) -> Pair<'first, 'second> {
    Pair {
        left: Held { target: first, stamp: 12 },
        right: Held { target: second, stamp: 13 }
    }
}

machine invalid_projected(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let held: Held = pair(&first_parent, &second_parent).left;
    first.value = 51;
    held.target.value
}

machine select_owned<'storage>(first: Held<'storage>, second: Held<'storage>, selected: bool) -> Held<'storage> {
    match selected { true -> first, false -> second }
}

machine invalid_owned(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let envelope: Envelope = Envelope {
        held: select_owned(first_input, second_input, true), seal: 17
    };
    // The declared common lifetime keeps even the unselected input's loan.
    second.value = 83;
    envelope.held.target.value
}

machine invalid_replacement(first: &mut Cell, second: &mut Cell) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let mut held: Held = first_input;
    held = second_input;
    // Replacing the old carrier must not release the newly installed loan.
    second.value = 83;
    held.target.value
}

machine invalid_selected_refill(first: &mut Cell, second: &mut Cell, third: &mut Cell, selected: bool) -> i32 {
    let first_parent: &mut Cell = &mut first;
    let second_parent: &mut Cell = &mut second;
    let third_parent: &mut Cell = &mut third;
    let first_input: Held = Held { target: &first_parent, stamp: 12 };
    let second_input: Held = Held { target: &second_parent, stamp: 13 };
    let third_input: Held = Held { target: &third_parent, stamp: 14 };
    let mut held: Held = first_input;
    let saved: Held = held;
    held = second_input;
    let chosen: Held = match selected { true -> held, false -> third_input };
    // Refilling a variable does not retire the selected receiving value's loan.
    second.value = 83;
    chosen.target.value
}
