// A copied element read through the parent view is still a read of storage
// the live exclusive child `middle` owns: `view[3]` lies inside the branch
// `view[2..4]` that `middle` suspends until its last use.
machine zero(view: &mut [u8])
requires view.len >= 1
{
    view[0] = 0;
}

machine ident(value: u8) -> u8 { value }

machine read_through_parent() -> u8 {
    let mut items: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let view: &mut [u8] = items.as_mut_slice();
    let middle: &mut [u8] = view[2..4];
    let seen: u8 = ident(view[3]);
    zero(middle);
    seen
}
