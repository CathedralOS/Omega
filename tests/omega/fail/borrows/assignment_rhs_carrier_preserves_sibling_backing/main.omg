data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; }
data Pair<'storage> { selected: Held<'storage>; sibling: Held<'storage>; }
machine replace<'installed, 'returned>(output: &mut Held<'installed>, installed: Held<'installed>, returned: Held<'returned>) -> Held<'returned> {
    output = installed;
    returned
}
machine main() -> i32 {
    let mut left: Cell = Cell { value: 11 };
    let mut right: Cell = Cell { value: 23 };
    let mut third: Cell = Cell { value: 37 };
    let mut pair: Pair = Pair { selected: Held { target: &left }, sibling: Held { target: &left } };
    pair.selected = replace(&mut pair.sibling, Held { target: &right }, Held { target: &third });
    right.value = 41;
    pair.sibling.target.value
}
