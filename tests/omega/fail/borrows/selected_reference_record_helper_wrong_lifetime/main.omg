data Cell { value: i32; }
data Held<'storage> { target: &'storage Cell; }

machine invalid<'first, 'second>(selected: bool, first: &'first Cell, second: &'second Cell) -> Held<'first> {
    match selected {
        true -> Held { target: first },
        false -> Held { target: second }
    }
}

machine invalid_direct<'first, 'second>(selected: bool, first: &'first Cell, second: &'second Cell) -> &'first Cell {
    match selected { true -> first, false -> second }
}
