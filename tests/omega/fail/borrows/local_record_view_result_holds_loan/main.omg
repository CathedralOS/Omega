// A loan of a local ends with a call only when the call's result cannot hold
// it. A returned `&mut` view borrows the lent local itself, so the local stays
// loaned until the view's last use: writing the local before then is rejected.
// A plain record result has no such view, which is why its loan ends at the
// call.

data Cell { value: i32 in Wrapping; }
data Tally { cells: [Cell; 2]; hits: i32 in Wrapping; }

machine Tally::pick(tally: &mut Tally) -> &mut Cell {
    transition { _ -> &mut tally.cells[1] }
}

machine main() {
    let mut tally: Tally;
    let cell: &mut Cell = Tally::pick(&mut tally);
    tally.hits = 5;
    cell.value = 7;
}
