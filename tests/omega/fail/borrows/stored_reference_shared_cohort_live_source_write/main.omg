// Shared leaves retire separately; backing mutation waits for the complete cohort.
use omega_language_std::console;

data Cell where value >= 0 && value <= 100 { value: i32; ready: bool; }
data Message { first: &Cell; prefix: i32; second: &Cell; stamp: i32; }
data Main { cell: Cell; }

machine Main::main(main: &mut Main) reaches Console {
    main.cell.value = 70;
    main.cell.ready = true;
    let message: Message = Message { first: &main.cell, prefix: 29, second: &main.cell, stamp: 11 };
    let observed: i32 = message.first.value;
    let prefix: i32 = message.prefix;
    main.cell.value = 81;
    let ready: bool = message.second.ready;
    let stamp: i32 = message.stamp;
    transition observed == 70 && ready && prefix == 29 && stamp == 11 && main.cell.value == 81 {
        true -> good(main)
        _ -> bad(main)
    }
    machine good(main: &mut Main) { Console::exit_process(70); }
    machine bad(main: &mut Main) { Console::exit_process(71); }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
