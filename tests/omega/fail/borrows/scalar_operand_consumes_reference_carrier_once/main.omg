// A scalar computation does not copy the ownership of an exclusive carrier.
data Held { value: &mut i32; }
machine observed(held: Held) -> i32 { held.value }
machine main() crashes Trap {
    let mut value: i32 = 17;
    let held: Held = Held { value: &mut value };
    transition observed(held) == 17 && observed(held) == 17 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
