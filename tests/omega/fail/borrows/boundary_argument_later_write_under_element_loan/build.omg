use omega::language::core::external_binding;
machine build(builder: &mut Build) {
 Build::package(builder, "native_bindings_boundary_argument_later_write_under_element_loan");

 Build::bind<CText::length>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_strnlen",
        },
    });
}
