// Expected rejection: the copied active payload still holds first.
data Cell { value: i32; }
data Envelope<'storage> [copy] { case Active(cell: &'storage Cell); case Empty; }
machine install<'storage>(slot: &mut Envelope<'storage>, cell: &'storage Cell) -> bool {
    slot = Envelope::Active {cell: cell};
    true
}
machine clear<'storage>(slot: &mut Envelope<'storage>) -> bool { slot = Envelope::Empty; true }
machine consume(value: Envelope, ignored: bool) -> i32 {
    match value { Envelope::Active {cell} -> cell.value Envelope::Empty -> 17 }
}
machine mutate(cell: &mut Cell) -> bool { cell.value = 23; true }
machine main() crashes Trap {
    let mut first: Cell = Cell {value: 17};
    let mut envelope: Envelope = Envelope::Empty;
    let observed: i32 = consume(match install(&mut envelope, &first) {true -> envelope false -> envelope}, clear(&mut envelope) && mutate(&mut first));
    transition observed == 17 {true -> done() false -> bad()}
    machine done() {}
    machine bad() { crash Trap; }
}
