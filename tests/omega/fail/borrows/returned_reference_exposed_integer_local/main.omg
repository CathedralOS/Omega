// A literal actual does not survive exposing the callee's private integer local.
machine install_one(value: &mut u64[0..=1])
ensures value == 1 {
    value = 1;
}
machine choose<'input>(values: &'input mut [u64; 2], position: u64[0..=1]) -> &'input u64
requires position < 2 {
    let mut selected_position: u64[0..=1] = position;
    install_one(&mut selected_position);
    &values[selected_position]
}
machine observe(value: &u64) -> u64 { value }
machine entry() -> u64 {
    let mut values: [u64; 2] = [7, 11];
    let selected: &u64 = choose(&mut values, 0);
    values[1] = 19;
    observe(selected)
}
