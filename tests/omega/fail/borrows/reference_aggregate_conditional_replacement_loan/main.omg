data Cell { value: i64; }
data Held { target: &Cell; stamp: i64; }
data Main { left: Cell; right: Cell; }

machine replace(held: &mut Held, incoming: Held, change: bool) {
    transition change { true -> set(held, incoming) _ -> done() }
    machine set(held: &mut Held, incoming: Held) { held = incoming; }
    machine done() {}
}

machine Main::main(main: &mut Main) crashes Trap {
    main.left.value = 11;
    main.right.value = 85;
    let mut held: Held = Held { target: &main.left, stamp: 17 };
    let incoming: Held = Held { target: &main.right, stamp: 23 };
    replace(&mut held, incoming, false);
    main.left.value = 29;
    let observed: i64 = held.target.value;
    main.right.value = 41;
    let stamp: i64 = held.stamp;
    transition observed == 85 && stamp == 23 && main.left.value == 29 && main.right.value == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
