// Reading one shared leaf does not end the other member of its cohort.
data Cell { value: i32; }
data Pair { first: Cell; second: Cell; }

machine collect(source: &Pair) -> [&Cell; 2] {
    [&source.second, &source.second]
}

machine exercise(source: &mut Pair) -> i32 {
    let messages: [&Cell; 2] = collect(source);
    let first: i32 = messages[0].value;
    source.second.value = 81;
    messages[1].value
}
