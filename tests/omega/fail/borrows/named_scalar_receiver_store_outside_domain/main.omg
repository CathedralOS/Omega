// Expected exit: 0
// Index evaluation captures matrix[row] before evaluating the outer selector.
// advance changes row from 0 to 1 and returns column 0. The selected value is
// matrix[0][0] = 11; reading matrix[1][0] = 22 instead exits 71.
use omega_language_std::console;

domain u64::Index(value) requires value < 2;

machine advance(row: &mut u64 in Index) -> u64 in Index {
    row = 2;
    0
}

machine main() reaches Console {
    let matrix: [[u64; 2]; 2] = [[11, 12], [22, 23]];
    let mut row: u64 in Index = 0;
    transition matrix[row][advance(&mut row)] {
        11 -> done()
        _ -> wrong()
    }
    state done() { Console::exit_process(0); }
    state wrong() { Console::exit_process(71); }
}
