// The terminal callee must not regain a field still held by caller cleanup.
// The nominal hook keeps this loan live until the whole invocation completes;
// no argument transfers the pending carrier into read_parent.
data Main { count: u64; }
data Pending dropped by close_pending { count: &mut u64; }

machine close_pending(pending: &mut Pending) { pending.count = 9; }

machine Main::read_later(main: &mut Main) -> u64 {
    let pending: Pending = Pending { count: &mut main.count };
    transition { _ -> read_parent(main) }
    machine read_parent(main: &mut Main) -> u64 { main.count }
}

machine main() {
    let mut storage: Main = Main { count: 7 };
    let observed: u64 = Main::read_later(&mut storage);
}
