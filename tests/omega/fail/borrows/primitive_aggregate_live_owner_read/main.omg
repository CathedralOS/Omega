data Held { slot: &mut u32; }
machine observe(value: &u32) -> u32 { value }
machine replace(slot: &mut u32) { slot = 9; }

machine exercise() -> u32 {
    let mut value: u32 = 7;
    let held: Held = Held { slot: &mut value };
    let observed: u32 = observe(&value);
    replace(held.slot);
    observed
}
