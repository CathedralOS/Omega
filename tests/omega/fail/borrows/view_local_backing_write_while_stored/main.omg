// A view stored into a local keeps its backing loaned until the local's
// last read: mutating the backing between the store and that read rejects.
data Main {
    buffer: [u8; 4];
}

machine Main::main(main: &mut Main) -> bool {
    let mut out_line: &[u8];
    out_line = main.buffer[0..2];
    main.buffer[0] = 65;
    out_line == "AB"
}
