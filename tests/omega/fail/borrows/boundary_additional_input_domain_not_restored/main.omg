data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue() -> Ticket in Issued { Ticket { number: 7 } }
boundary trait Change {
    machine replace(ticket: &mut Ticket)
    reaches
    requires ticket in Issued;
}
machine read(ticket: &Ticket in Issued) -> u64 { ticket.number }
machine exercise() -> u64 reaches Change {
    let mut ticket: Ticket in Issued = issue();
    Change::replace(&mut ticket);
    read(&ticket)
}
