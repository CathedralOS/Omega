// A parent and child share call provenance without becoming disjoint peers.
data Cell { value: i32; }
data Pair { first: Cell; second: Cell; }
machine identity(source: &mut Pair) -> &mut Pair { source }
machine pick(source: &mut Pair) -> &mut Cell { &mut source.first }
machine main() {
    let mut pair: Pair;
    let whole: &mut Pair = identity(&mut pair);
    let child: &mut Cell = pick(whole);
    whole.second.value = 5;
    child.value = 70;
}
