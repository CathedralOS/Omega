// A child projected from a returned parent still suspends that parent.
data Cell { value: i32; }
data Pair { first: Cell; second: Cell; }
machine identity(source: &mut Pair) -> &mut Pair { source }
machine main() {
    let mut pair: Pair;
    let whole: &mut Pair = identity(&mut pair);
    let child: &mut Cell = &mut whole.first;
    whole.second.value = 5;
    child.value = 70;
}
