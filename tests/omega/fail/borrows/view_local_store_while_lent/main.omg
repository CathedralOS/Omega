// A view the callee returns keeps the local's loan until its last use:
// replacing the local's descriptor before then rejects.
use omega_language_std::console;
use omega::language::core::binding;

data Main { console: Binding<Console>; }

machine first<'a>(bytes: &'a [u8]) -> &'a [u8] {
    bytes
}

machine Main::main(main: &mut Main) reaches Console {
    let mut view: &[u8] = "Door";
    let kept: &[u8] = first(view);
    view = "Gate";
    transition kept == "Door" {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { main.console.exit_process(70); }
    state bad(main: &mut Main) { main.console.exit_process(71); }
}
