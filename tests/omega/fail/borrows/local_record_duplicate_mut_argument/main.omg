// A static machine may lend its local record `&mut` to a call, but only once
// per call: two exclusive loans of the same local alias one storage location.

data Score { points: i32 in Wrapping; }

machine Score::join(left: &mut Score, right: &mut Score) {
    left.points = left.points + right.points;
}

machine main() {
    let mut score: Score;
    Score::join(&mut score, &mut score);
}
