data Ticket [copy] { number: u64; }
domain Ticket::Issued established by issue;
machine issue(number: u64) -> Ticket in Issued { Ticket { number: number } }
data Holder { ticket: Ticket in Issued; }
boundary trait Change { machine replace(holder: &mut Holder) reaches; }
machine exact(value: u64) requires value == 17 {}
machine exercise() reaches Change {
    let mut holder: Holder = Holder { ticket: issue(17) };
    Change::replace(&mut holder);
    exact(holder.ticket.number);
}
