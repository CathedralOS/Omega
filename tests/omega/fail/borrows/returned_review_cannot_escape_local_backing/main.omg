data Header { left: u64; right: u64; }
data AliasHeader { first: u64; second: u64; }

machine escape() -> &AliasHeader {
    let header: Header = Header { left: 37u64, right: 9u64 };
    let view: &AliasHeader = header as &AliasHeader;
    view
}

machine main() {
    let view: &AliasHeader = escape();
}
