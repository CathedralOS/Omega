// The returned reference borrows the real input behind the erased one, so
// writing that input while the reference is live must still reject.
machine direct<'storage>(witness [erased]: &u64, target: &'storage mut u64) -> &'storage mut u64 { target }

machine conflicting(proof: &u64, one: &mut u64) -> u64 {
    let first: &mut u64 = direct(proof, one);
    one = 1;
    first = 10;
    one
}
