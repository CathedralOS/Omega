data Cell { value: i32; }
data View<'storage> [copy] { target: &'storage Cell; }
machine mutate(counter: &mut Cell) -> bool { counter.value = 23; true }
machine receive(view: View, ignored: bool) -> i32 { view.target.value }
machine relay(view: View, counter: &mut Cell) -> i32 {
    let mut saved: View = view;
    saved.target = &counter;
    receive(saved, mutate(counter))
}
machine main() {
    let first: Cell = Cell {value: 17};
    let view: View = View {target: &first};
    let mut counter: Cell = Cell {value: 19};
    let observed: i32 = relay(view, &mut counter);
}
