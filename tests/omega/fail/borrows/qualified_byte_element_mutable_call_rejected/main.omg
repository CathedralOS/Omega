// A primitive element loan must preserve the enclosing byte field's domain.
// The explicit length premise isolates the domain failure from bounds checking.
domain [u8; 4]::Ascii(bytes) requires ascii_only(bytes);
data Packet { bytes: [u8; 4] in Ascii; }

machine corrupt(leaf: &mut u8) -> bool { leaf = 255; true }

machine Packet::main(packet: &mut Packet) {
    transition packet.bytes.len > 1 {
        true -> change(packet)
        _ -> done(packet)
    }
    machine done(packet: &mut Packet) {}
    machine change(packet: &mut Packet) requires packet.bytes.len > 1 {
        let changed: bool = corrupt(&mut packet.bytes[1]);
    }
}
