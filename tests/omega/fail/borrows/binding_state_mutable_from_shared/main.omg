// Upgrading a shared borrow to mutable access must reject: `forward` receives
// `&Cell` and its successor state declares `&mut Cell` for the same storage.
data Cell { count: i64; }

machine forward(cell: &Cell) -> i64 {
    transition { _ -> finish(cell) }
    machine finish(cell: &mut Cell) -> i64 { 7i64 }
}
