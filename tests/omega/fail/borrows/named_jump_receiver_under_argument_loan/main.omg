// A named jump to a sibling state hands the caller's own data record to the
// successor, which holds the jump's argument loans for its whole run. The
// exclusive loan of `main.count` suspends that field, so a `&mut Main`
// successor may neither read nor write it through its own subject, and a
// `&Main` successor's shared subject overlaps the exclusive child outright.
//
// The subject arrives as an ordinary argument, so the pairwise overlap rule
// sees `main` beside `&mut main.count` and would report `main` as mutable more
// than once -- blaming duplication for what is a parent beside its own child.
// [ownership](wiki/spec/language/ownership.md) says an exclusive child suspends
// the corresponding parent branch, so the successor's footprint is what decides,
// and these diagnostics name the suspended field and the access that reaches it.

data Main { count: u64; other: u64; }

machine Main::read_form(main: &mut Main) -> u64 {
    transition { _ -> read_after(main, &mut main.count) }
    state read_after(main: &mut Main, counter: &mut u64) -> u64 {
        counter = 5;
        let seen: u64 = main.count;
        (seen)
    }
}

machine Main::write_form(main: &mut Main) -> u64 {
    transition { _ -> write_through_subject(main, &mut main.count) }
    state write_through_subject(main: &mut Main, counter: &mut u64) -> u64 {
        main.count = 7;
        counter = 5;
        (0)
    }
}

machine Main::shared_form(main: &mut Main) -> u64 {
    transition { _ -> observe(main, &mut main.count) }
    state observe(main: &Main, counter: &mut u64) -> u64 {
        counter = 5;
        let seen: u64 = main.count;
        (seen)
    }
}
