// A declared view local holds no descriptor until a store establishes it:
// lending it to a call first names no backing and must reject.
use omega_language_std::console;

data Main { }

machine count(bytes: &[u8]) -> u64 {
    bytes.len
}

machine Main::main(main: &mut Main) reaches Console {
    let mut view: &[u8];
    let n: u64 = count(view);
    transition n == 0 {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
