data Candidates<'storage> {
    first: &'storage i32;
    second: &'storage i32;
}

data Selected<'storage> { reference: &'storage i32; }

machine select<'storage>(candidates: Candidates<'storage>) -> Selected<'storage> {
    Selected { reference: candidates.first }
}

machine invalid(first: &mut i32, second: &mut i32) {
    let candidates: Candidates = Candidates { first: first, second: second };
    let selected: Selected = select(candidates);
    second = 7;
    let observed: i32 = selected.reference;
}

machine main() {}
