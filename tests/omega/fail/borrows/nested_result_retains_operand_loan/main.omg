data Held { value: &mut u64; }

machine hold(value: &mut u64) -> Held { Held { value: value } }

machine bump(value: &mut u64) -> u64 {
    value = ((value as u64 in Wrapping) + 1) as u64;
    value
}

machine observe(held: Held, changed: u64) -> u64 { held.value }

machine main() {
    let mut value: u64 = 0;
    // The first completed call returns the loan itself inside an owned record.
    // Its completion cannot release backing needed by the outer invocation.
    let answer: u64 = observe(hold(&mut value), bump(&mut value));
}
