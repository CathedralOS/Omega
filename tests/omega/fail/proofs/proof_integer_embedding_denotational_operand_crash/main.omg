use omega::language::core::nat;

machine observed(value: u64) -> u64 crashes Trap {
    value
}

// Removing the embedding's nonoperational edge must still visit its operand.
// The observed machine's declared crash route prevents a total value meaning.
machine magnitude(value: u64) -> Nat {
    embed(observed(value)) as Nat
}

machine invalid(value: u64)
requires magnitude(value) == magnitude(value)
{}

machine main() {}
