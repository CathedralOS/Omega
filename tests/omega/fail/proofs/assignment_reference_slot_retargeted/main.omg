data Cell [copy] { value: u64; }
data Holder { cell: &mut Cell; }
machine retarget(holder: &mut Holder, replacement: &mut Cell) -> u64
ensures result == 11 { holder.cell = replacement; 11 }
machine demand(value: u64) requires value == 11 {}
machine invalid() {
    let mut previous: Cell = Cell { value: 0 };
    let mut replacement: Cell = Cell { value: 99 };
    let mut holder: Holder = Holder { cell: &mut previous };
    holder.cell.value = retarget(&mut holder, &mut replacement);
    demand(holder.cell.value);
}
machine main() {}
