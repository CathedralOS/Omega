data Context { count: u64; }
machine overwrite(context: &mut Context) -> u64 { context.count = 9; 6 }
machine main(context: &mut Context) {
    transition context.count < overwrite(context) { true -> bounded(context) false -> done() }
    state bounded(context: &Context) requires context.count < 6 { }
    state done() { }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
