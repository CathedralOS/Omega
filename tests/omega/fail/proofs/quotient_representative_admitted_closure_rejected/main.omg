use omega::language::core::relation;

pub data Representative {
    case Zero;
    case Next(previous: Representative);
}

pub proposition equivalent(a: Representative, b: Representative) = a == b;

machine equivalent_reflexive(a: Representative)
ensures a == a
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires a == b
ensures b == a
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    a == b
    b == c
ensures a == c
{
}

RepresentativeEquivalence: satisfies Equivalence<Representative, equivalent> {
    Reflexive::reflexive = equivalent_reflexive;
    Symmetric::symmetric = equivalent_symmetric;
    Transitive::transitive = equivalent_transitive;
}

data EquivalenceClass = Representative % equivalent
where equivalent satisfies
    Equivalence<Representative, equivalent>
    as RepresentativeEquivalence;

boundary machine observe(value: Representative) -> bool;

// The representative declaration is an ordinary checked body; only its
// transitive call closure reaches the boundary seam. Acceptance must hold
// under a policy refusing quotient assumptions, so the closure decides.
//
// The closure check is unreachable today: bodyless boundary machines are
// symbols for contracts only, so `observe(value)` is refused at call-site
// validation before quotient validation runs. The pinned diagnostic now
// names that earlier gate (same masking class as the boundary/theorem
// siblings).
pub machine representative(value: Representative) -> Representative {
    let seen: bool = observe(value);
    value
}

machine representative_respects(left: Representative, right: Representative)
requires equivalent(left, right)
ensures equivalent(representative(left), representative(right))
{
}

machine admitted(value: EquivalenceClass) -> EquivalenceClass {
    Quotient::define<representative, representative_respects>(value)
}
