trait Equatable<T> { machine equals(left: &T, right: &T) -> bool; }
data Holder { flag: bool; }
HolderEquality satisfies Equatable<Holder> { }
data Input { count: u64; }
machine guarded(value: u64) -> bool requires value != 0 { true }
domain Input::Invalid requires HolderEquality::equals(
    &(Holder { flag: guarded(0) }), &(Holder { flag: true }));
data InvalidCase
    requires ((self in InvalidCase::Cell) && guarded(0))
{ case Cell(count: u64); }
data SiblingCases
    requires ((self in SiblingCases::Established) && self.count != 0 && guarded(self.count))
       || ((self in SiblingCases::Unestablished) && guarded(self.count))
{
    case Established(count: u64);
    case Unestablished(count: u64);
}
