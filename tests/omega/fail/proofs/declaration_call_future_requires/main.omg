machine guarded(value: u64) -> bool requires value != 0 { true }
data Input { count: u64; }
domain Input::Invalid(value) requires guarded(value.count), value.count != 0;
data InvalidData where guarded(count), count != 0 { count: u64; }
data InvalidCase { case Cell(count: u64) where guarded(count), count != 0; }
