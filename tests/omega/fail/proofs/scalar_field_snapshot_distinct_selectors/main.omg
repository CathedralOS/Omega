data Holder { value: u64; }
machine demand_same(left: u64, right: u64) requires left == right {}
machine inspect(holders: &mut [Holder; 2], index: u64, other: u64)
requires index < 2 && other < 2 && index <= other {
    let before: u64 = holders[index].value;
    let after: u64 = holders[other].value;
    demand_same(before, after);
}
machine main() {}
