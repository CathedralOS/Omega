// False twin of proofs/proof_inductive_gauss_sum (ladder rung L7). The
// ensures is off by one: 2 * gauss_sum(n, acc) == 2*acc + n*(n+1) + 1. The
// inductive STEP is self-consistent (assuming the false contract for n - 1
// "proves" it for n), so rejection must come from the BASE arm: under
// n == 0 the wrapped values cannot satisfy the off-by-one guarantee with
// `result := acc`. The engine must refuse that arm; it need not prove the
// negation of the wrapped equality. Pins that induction cannot launder a false
// theorem past its base case. Wrapping keeps this the exact negative twin of
// the universal residue-ring theorem instead of adding overflow obligations.

data Main {
}

machine Main::main(main: &mut Main) {
    let total: u64 in Wrapping = Main::gauss_sum(main, 4, 0);
}

machine Main::gauss_sum(main: &mut Main, n: u64 in Wrapping, acc: u64 in Wrapping) -> u64 in Wrapping
terminates by n;
ensures
    result * 2 == acc * 2 + n * (n + 1) + 1
{
    transition n > 0 {
        true -> gauss_sum(main, n - 1, acc + n)
        false -> acc
    }
}
