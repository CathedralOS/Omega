use omega::language::core::nat;
data Observation { value: Nat; other: Nat; }
machine project<machine Read>(index: Nat) -> Nat
requires machine Read(index: Nat) -> Observation terminates;
{
    let observation: Observation = Read(index);
    transition { _ -> observation.value }
}
machine unproved<machine First, machine Second>(index: Nat)
requires machine First(index: Nat) -> Observation terminates;
requires machine Second(index: Nat) -> Observation terminates;
ensures
    project<First>(index) == (First(index)).other
{
}
machine main() {}
