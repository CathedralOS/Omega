use omega::language::core::float_operations;

// NaN takes the fallback despite failing both ordered comparisons.
machine unordered_is_not_positive(value: f64) -> f64
ensures value < 0.0 || (value >= 0.0 && Float::meaning64(result) == Float::meaning64(value))
{
    transition {
        value < 0.0 -> (0.0)
        _ -> (value)
    }
}
