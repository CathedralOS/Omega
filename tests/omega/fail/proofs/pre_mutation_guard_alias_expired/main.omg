data Context { count: u64; }
machine overwrite(context: &mut Context) -> bool { context.count = 9; true }
machine main() {
    let mut record: Context = Context { count: 0 };
    let alias: &mut Context = &mut record;
    transition alias.count < 6 && overwrite(alias) { true -> bounded(alias) false -> done() }
    machine bounded(value: &Context) requires value.count < 6 { }
    machine done() { }
}
