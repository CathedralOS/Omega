use omega::language::core::slice;
data View<'data> [copy] { samples: &'data [u8]; }
data Envelope<'data> [copy] { child: View<'data>; }
machine read<'data>(value: Envelope<'data>, index: u64) -> u8
requires index < value.child.samples.len { value.child.samples[index] }
machine invalid<'data>(current: &mut Envelope<'data>, replacement: View<'data>, index: u64) -> u8
requires index < replacement.samples.len {
 let saved: Envelope = Envelope { child: current.child };
 current.child = replacement;
 read(saved, index)
}
