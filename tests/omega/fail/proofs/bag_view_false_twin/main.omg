// False twin of proofs/proof_bag_view_reflexivity. Entry assumes identity
// of the packaged BagView descriptors; exit demands its negation. This
// unproved exit obligation must reject.

use omega::language::core::seq;

machine false_bag_distinct(before: &[u64], items: &[u64])
requires
    core::Identity<BagView>(Bag(items), Bag(before))
ensures
    !core::Identity<BagView>(Bag(items), Bag(before))
{
}

machine main() {
}
