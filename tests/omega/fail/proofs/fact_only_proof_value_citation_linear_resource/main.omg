data Token [linear] {}
data Evidence { case Empty; case Node(next: Evidence, token: Token); }
machine reflexive(value: Evidence) ensures value == value {}
data Context {}
machine main(context: &mut Context) {
    reflexive(Evidence::Node { next: Evidence::Empty, token: Token {} });
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
