// An identity helper leaves the recursive rank unchanged. An unrelated
// constant-zero relation cannot establish that this recursion decreases.
data Nat {
    case Zero;
    case Succ(prev: Nat);
}

machine saturating_sub(left: Nat, right: Nat) -> Nat {
    transition { _ -> Nat::Zero }
}

machine unchanged(value: Nat) -> Nat {
    transition { _ -> value }
}

machine descend(value: Nat) -> Nat
terminates by value
requires saturating_sub(value, value) == Nat::Zero
{
    transition { _ -> forward(value) }

    machine forward(value: Nat) -> Nat {
        let next: Nat = unchanged(value);
        transition { _ -> descend(next) }
    }
}

machine main() {}
