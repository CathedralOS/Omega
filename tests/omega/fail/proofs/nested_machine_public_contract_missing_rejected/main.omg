// A public body is checked for arbitrary inputs, regardless of the known caller.
machine same(left: u64, right: u64) -> u64 requires left == right { left }
public machine public_value(left: u64, right: u64) -> u64 {
    let selected: u64 = match true { true -> left false -> left };
    same(selected, right)
}
machine main() { let result: u64 = public_value(7, 7); }
