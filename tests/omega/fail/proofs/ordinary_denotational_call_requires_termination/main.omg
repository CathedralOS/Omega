machine stalled(value: f32) -> u8 in Saturating {
    transition { _ -> again(value) }
    machine again(value: f32) -> u8 in Saturating {
        transition { _ -> again(value) }
    }
}

machine harmless(value: f32) -> u8 in Saturating
requires stalled(value) == stalled(value)
ensures stalled(value) == stalled(value) {
    0u8 as u8 in Saturating
}

machine main() crashes Trap {
    let observed: u8 in Saturating = 0u8 as u8 in Saturating;
    transition observed == 0u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
