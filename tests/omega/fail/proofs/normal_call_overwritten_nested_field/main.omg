// Expected exit: 0
data Pair { count: u64; marker: u64; }
data Holder { pair: Pair; outer: u64; }
machine update(record: &mut Holder) -> u64
requires record.outer >= record.pair.marker, record.outer >= 7
ensures record.pair.count == 1,
    embed(result) + embed(record.pair.marker) == embed(record.outer) {
    record.pair.count = 1;
    record.pair.marker = 6;
    record.outer - record.pair.marker
}
machine need(value: u64) requires value == 2 {}
machine main() crashes Trap {
    let mut record: Holder = Holder { pair: Pair { count: 0, marker: 7 }, outer: 9 };
    let value: u64 = update(&mut record);
    need(value);
    transition value == 2 && record.pair.count == 1 && record.pair.marker == 7 && record.outer == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
