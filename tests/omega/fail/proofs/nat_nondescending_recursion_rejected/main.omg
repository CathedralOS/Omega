// FAIL CANARY: a MEASURED proof machine whose self-call passes the SAME
// measure back (`spin(n)` under `terminates by n`). The structural-descent
// check demands the measure-position argument be a case-payload subterm
// (the arm-bound `prev`); the unchanged `n` proves nothing and the
// refusal names the binding idiom.
use omega::language::core::nat;
use omega_language_std::console;
data Main { }
machine Main::main(main: &mut Main) { Console::exit_process(70); }
machine spin(n: Nat) -> Nat
terminates by n;
{
    transition n {
        Nat::Zero -> Nat::Zero
        Nat::Succ { prev } -> Nat::Succ { prev: spin(n) }
    }
}
