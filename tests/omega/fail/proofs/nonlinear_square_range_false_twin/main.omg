// False twin of proofs/proof_nonlinear_square_range (ladder rung L5). With a
// in 0..=10, a * a reaches 100, so `ensures a * a in 0..=99` is wrong at the
// upper corner. Accepted today; interval products (nonlinear arithmetic) must
// reject it.

machine false_square_bounded(a: u64)
requires
    a in 0..=10
ensures
    a * a in 0..=99
{
}

data Main {
}

machine Main::main(&mut self) {
}
