// Selected executable equality can return true for a different case. It does
// not establish the tag required by the called machine.
data Choice [copy] { case First; case Second; }

trait Equatable<Value> {
    machine equals(left: &Value, right: &Value) -> bool
    ensures result == true;
}
AlwaysEqual satisfies Equatable<Choice> {
    machine equals(left: &Choice, right: &Choice) -> bool
    ensures result == true
    { true }
}

machine require_first(value: Choice) -> u64
requires value in Choice::First
{ 1u64 }

machine guarded(value: Choice) -> u64 {
    transition value == Choice::First {
        true -> require_first(value)
        false -> 0u64
    }
}

machine main() {
    _ = guarded(Choice::Second);
}
