// Captured scalar returns preserve a byte class through guarded state transfers.
// An unconstrained helper input keeps both guarded outcomes feasible. The
// high-byte return removes UTF-8 evidence even when another state returns ASCII.
domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
domain [u8; 1]::Utf8(bytes) requires valid_utf8(bytes);

machine consume(bytes: &[u8] in Utf8) {}

machine mapped_byte(value: u16) -> u8 {
    transition value > 127 {
        true -> outside()
        _ -> inside(value)
    }
    machine inside(value: u16) -> u8 {
        let masked: u16 = value & 127;
        masked as u8
    }
    machine outside() -> u8 { 255 }
}

data Main { bytes: [u8; 1] in Utf8; }
machine Main::write_byte(main: &mut Main, value: u16) {
    main.bytes = "A";
    main.bytes[0] = mapped_byte(value);
    consume(main.bytes);
}
machine Main::main(main: &mut Main) { Main::write_byte(main, 300); }
