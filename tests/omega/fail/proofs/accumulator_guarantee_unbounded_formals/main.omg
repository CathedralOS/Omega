// Unbounded twin of the free-loop accumulation claim
// `ensures result == acc + remaining` over ranked `climb`. The same
// loop spelled on bare `u64` formals drops the declared entry ranges — the
// arrival certificates that make `acc + remaining` provably in range — so
// the exact-arithmetic obligation (decision 17) rejects the contract and the
// backedge argument before any guarantee transport is attempted.
use omega_language_std::console;

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    let total: u64 = climb(4, 10);
    transition total == 14 {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        Console::exit_process(70);
    }

    state bad(main: &mut Main) {
        Console::exit_process(71);
    }
}

machine climb(remaining: u64, acc: u64) -> u64
terminates by remaining -> Nat::Descending;
ensures result == acc + remaining
{
    transition remaining > 0 {
        true -> climb(remaining - 1, acc + 1)
        false -> (acc + remaining)
    }
}
