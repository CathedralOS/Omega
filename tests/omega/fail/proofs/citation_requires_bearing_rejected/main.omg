// SITE DISCHARGE negative (ch10 "Citing Proofs"): a theorem applies only
// at operands satisfying its REQUIRES. The citer has no hypothesis
// establishing `x == y`, so the instantiated requires cannot discharge and
// the citation refuses -- naming the undischarged fact. (`sym` itself
// PROVES fine; the discharged twin is pass/proofs/citation_requires_discharged.)
use omega::language::core::nat;

use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }

machine sym(a: Nat, b: Nat)
requires
    a == b
ensures
    b == a
{
}

machine conditional_cite(x: Nat, y: Nat)
ensures
    y == x
{
    sym(x, y);
}
