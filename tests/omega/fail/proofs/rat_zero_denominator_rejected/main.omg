// A rational constructor cannot admit a zero denominator even when gcd(n, 0)
// is positive: the resolved value call instantiates and refutes that requires
// fact before construction.
use omega::language::core::rat;

machine invalid_rat() -> Rat {
    mk_rat(
        Nat::Succ { prev: Nat::Zero },
        Nat::Zero,
        Nat::Succ { prev: Nat::Zero }
    )
}

data Main {
}

machine Main::main(&mut self) {
}
