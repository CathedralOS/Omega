use omega::language::core::nat;

machine stalled(value: u64) -> u64 {
    transition { _ -> again(value) }
    machine again(value: u64) -> u64 {
        transition { _ -> again(value) }
    }
}

// The proof term terminates, but evaluating its operand does not.
machine magnitude(value: u64) -> Nat {
    embed(stalled(value)) as Nat
}

machine invalid(value: u64)
requires magnitude(value) == magnitude(value)
{}

machine main() {}
