use omega::language::core::Equivalence;

data Representative {
    case Zero;
    case Next(previous: Representative);
}

proposition equivalent(a: Representative, b: Representative) = core::Identity<Representative>(a, b);

machine equivalent_reflexive(a: Representative)
ensures core::Identity<Representative>(a, a)
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires core::Identity<Representative>(a, b)
ensures core::Identity<Representative>(b, a)
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    core::Identity<Representative>(a, b)
    core::Identity<Representative>(b, c)
ensures core::Identity<Representative>(a, c)
{
}

RepresentativeEquivalence satisfies Equivalence<Representative, equivalent> {
    machine reflexive(value: Representative) ensures equivalent(value, value) { equivalent_reflexive(value) }
    machine symmetric(left: Representative, right: Representative) requires equivalent(left, right) ensures equivalent(right, left) { equivalent_symmetric(left, right) }
    machine transitive(left: Representative, middle: Representative, right: Representative) requires equivalent(left, middle), equivalent(middle, right) ensures equivalent(left, right) { equivalent_transitive(left, middle, right) }
}

data EquivalenceClass = Representative % equivalent
requires equivalent satisfies
    Equivalence<Representative, equivalent>
    as RepresentativeEquivalence;

machine representative(value: Representative) -> Representative
requires core::Identity<Representative>(value, value)
{
    value
}

machine representative_respects(left: Representative, right: Representative)
requires
    equivalent(left, right)
    core::Identity<Representative>(left, left)
    core::Identity<Representative>(right, right)
ensures equivalent(representative(left), representative(right))
{
}

machine representative_transports(left: Representative, right: Representative)
requires
    core::Identity<Representative>(left, left)
    core::Identity<Representative>(right, right)
ensures
    core::Identity<Representative>(left, left)
    core::Identity<Representative>(right, right)
{
}

// `define` has exactly one Congruence role. There is no `define` transport
// role, so a third selection is surplus rather than a finer contract.
machine admitted(value: EquivalenceClass) -> EquivalenceClass {
    Quotient::define<
        representative,
        representative_respects,
        representative_transports
    >(value)
}
