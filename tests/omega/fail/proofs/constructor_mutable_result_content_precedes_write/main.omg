// A reference result's contents are not a detached constructor snapshot.
data Cell [copy] { value: u64; }
data Pair { cell: &mut Cell; marker: u64; }
machine keep(cell: &mut Cell) -> &mut Cell
requires cell.value == 11;
ensures result.value == 11;
{ cell }
machine overwrite(cell: &mut Cell) -> u64 { cell.value = 99; 0 }
machine demand(value: u64) requires value == 11 {}
machine invalid(cell: &mut Cell) -> u64 requires cell.value == 11 {
    let pair: Pair = Pair { cell: keep(cell), marker: overwrite(cell) };
    demand(pair.cell.value);
    pair.cell.value
}
machine main() crashes Trap {
    let mut cell: Cell = Cell { value: 11 };
    let observed: u64 = invalid(&mut cell);
    transition observed == 99 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
