// FAIL CANARY: a consumer cites core add_zero_right's proven right-identity
// theorem but claims an unrelated result is Zero. A cited FACT cannot launder
// a false conclusion.
use omega::language::core::nat;
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
machine bogus(a: Nat) -> Nat
ensures
    result == Nat::Zero
{
    add_zero_right(a);
    transition { _ -> a }
}
