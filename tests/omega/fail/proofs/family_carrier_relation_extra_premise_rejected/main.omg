// A machine-indexed family's law premise is recovered at the realizer's own
// packs. `ordered` is opaque, so the requirement grants exactly
// `ordered<Left, Right>(left, right)`; requiring the reversed pair is a
// premise callers of the requirement never prove.
use omega::language::core::relation;

data Index {
}

data Chain<machine Step>
where machine Step(index: Index) -> Index;
{
    case End;
    case Link(next: Chain<Step>);
}

proposition ordered<machine Left, machine Right>(
    left: Chain<Left>,
    right: Chain<Right>
);

machine ordered_symmetric<machine Left, machine Right>(
    left: Chain<Left>,
    right: Chain<Right>
)
where machine Left(index: Index) -> Index;
where machine Right(index: Index) -> Index;
satisfies Symmetric<Chain, ordered>::symmetric
requires ordered<Right, Left>(right, left)
ensures ordered<Right, Left>(right, left)
{
}

machine main() {
}
