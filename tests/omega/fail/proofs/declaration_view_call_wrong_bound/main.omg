// Reject both direct and chained views: erasure cannot establish a stronger bound.
data Counter { value: u64; }
domain Counter::One(counter) requires counter.value == 1;
domain Counter::Nonnegative(counter) requires counter.value >= 0;
data Bundle { counter: Counter in One & Nonnegative; }

machine consume(counter: &Counter) -> u64
requires counter.value >= 2 && addr::Bound == 18446744073709551616
{ counter.value - 1 }

machine visit(counter: Counter in One) -> u64 crashes Trap
requires addr::Bound == 18446744073709551616
{
    let observed: u64 = consume(&counter as &Counter);
    transition observed == 0 { true -> done(counter) _ -> wrong() }
    machine done(counter: Counter in One) -> u64 { counter.value }
    machine wrong() -> u64 { crash Trap; }
}

machine main() crashes Trap
requires addr::Bound == 18446744073709551616
{
    let result: u64 = visit(Counter { value: 1 });
    let nested: u64 = visit_nested(Bundle { counter: Counter { value: 1 } });
    transition result == 1 && nested == 1 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}

// Both retained views observe the same original field, including after the
// first reference is stored in a local. Neither grants a new qualification.
machine visit_nested(bundle: Bundle) -> u64 crashes Trap
requires bundle.counter.value >= 1 && addr::Bound == 18446744073709551616
{
    let narrowed: &Counter in Nonnegative = &bundle.counter as &Counter in Nonnegative;
    let observed: u64 = consume(narrowed as &Counter);
    transition observed == 0 { true -> done(bundle) _ -> wrong() }
    machine done(bundle: Bundle) -> u64 { bundle.counter.value }
    machine wrong() -> u64 { crash Trap; }
}
