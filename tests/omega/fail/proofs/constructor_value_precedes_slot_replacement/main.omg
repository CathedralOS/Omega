data Pair [copy] { view: &[u8]; marker: u64; }
data Holder [copy] { view: &[u8]; }
machine replace(holder: &mut Holder, replacement: &[u8]) -> u64
ensures holder.view.len == replacement.len { holder.view = replacement; 0 }
machine invalid(short: &[u8], long: &[u8]) -> u8
requires short.len == 1 && long.len == 1024 {
    let mut holder: Holder = Holder { view: short };
    let pair: Pair = Pair { view: holder.view, marker: replace(&mut holder, long) };
    pair.view[1023]
}
machine main() {}
