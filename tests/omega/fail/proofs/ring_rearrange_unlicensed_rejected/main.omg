// NO SCOPE-SNIFFING (the rearrange settle's central ruling): comm and assoc
// lemmas for `plus` are IN SCOPE below -- proven, importable, sitting right
// there -- but NOTHING declares a CommutativeSemiring conformance, so the
// rearrange tier has no license and the shuffle lemma must fence exactly as
// before the tier existed. Whether a proof compiles must never depend on
// what happens to be in scope (the Lean CommRing-instance precedent).
use omega_language_std::Console;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

machine plus(a: Peano, b: Peano) -> Peano
terminates by a
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: plus(pred, b) }
    }
}

machine plus_assoc(a: Peano, b: Peano, c: Peano) -> Peano
terminates by a
ensures
    core::Identity<Peano>((plus(plus(a, b), c)), (plus(a, plus(b, c))))
{
    transition a {
        Peano::Zero -> Peano::Zero
        Peano::Succ { pred } -> Peano::Succ { pred: plus_assoc(pred, b, c) }
    }
}

// A shuffle only rearrangement could bridge -- with no conformance
// declared, it must stay fenced (its truth is beside the point; the LICENSE
// is the point).
machine needs_rearrange(a: Peano, b: Peano, c: Peano) -> Peano
terminates by a
ensures
    core::Identity<Peano>((plus(b, plus(a, c))), (plus(a, plus(b, c))))
{
    transition a {
        Peano::Zero -> Peano::Zero
        Peano::Succ { pred } -> Peano::Succ { pred: needs_rearrange(pred, b, c) }
    }
}

data Main { }
machine Main::main(main: &mut Main) { Console::exit_process(70); }

// Individually checked rows retain the whole trait application. Neither one
// below supplies both laws for one application over Peano.
data FirstTag {}
data SecondTag {}
trait ApplicationJoin<T, Marker> {
    machine combine(a: T, b: T) -> T terminates;
    machine comm(a: T, b: T)
    ensures core::Identity<T>(combine(a, b), combine(b, a));
    machine assoc(a: T, b: T, c: T)
    ensures core::Identity<T>(combine(combine(a, b), c), combine(a, combine(b, c)));
}

machine application_nand(a: Peano, b: Peano) -> Peano
satisfies ApplicationJoin<Peano, FirstTag>::combine as FirstApplication
terminates
{
    transition a {
        Peano::Zero -> left_zero(b)
        Peano::Succ { pred } -> left_successor(b)
    }
    machine left_zero(b: Peano) -> Peano { Peano::Succ { pred: Peano::Zero } }
    machine left_successor(b: Peano) -> Peano {
        transition b {
            Peano::Zero -> Peano::Succ { pred: Peano::Zero }
            Peano::Succ { pred } -> Peano::Zero
        }
    }
}

machine application_and(a: Peano, b: Peano) -> Peano
satisfies ApplicationJoin<Peano, SecondTag>::combine as SecondApplication
terminates
{
    transition a {
        Peano::Zero -> left_zero(b)
        Peano::Succ { pred } -> left_successor(b)
    }
    machine left_zero(b: Peano) -> Peano { Peano::Zero }
    machine left_successor(b: Peano) -> Peano {
        transition b {
            Peano::Zero -> Peano::Zero
            Peano::Succ { pred } -> Peano::Succ { pred: Peano::Zero }
        }
    }
}

machine application_comm(a: Peano, b: Peano)
satisfies ApplicationJoin<Peano, FirstTag>::comm as FirstApplication
ensures core::Identity<Peano>(application_nand(a, b), application_nand(b, a))
{
    transition a {
        Peano::Zero -> case_zero(b)
        Peano::Succ { pred } -> case_successor(b)
    }
    machine case_zero(b: Peano) {
        transition b {
            Peano::Zero -> case_zero_zero()
            Peano::Succ { pred } -> case_zero_successor()
        }
        machine case_zero_zero() {
            // The selected operations reduce to the same constructor here.
        }
        machine case_zero_successor() {
            // The selected operations reduce to the same constructor here.
        }
    }
    machine case_successor(b: Peano) {
        transition b {
            Peano::Zero -> case_successor_zero()
            Peano::Succ { pred } -> case_successor_successor()
        }
        machine case_successor_zero() {
            // The selected operations reduce to the same constructor here.
        }
        machine case_successor_successor() {
            // The selected operations reduce to the same constructor here.
        }
    }
}

machine application_assoc(a: Peano, b: Peano, c: Peano)
satisfies ApplicationJoin<Peano, SecondTag>::assoc as SecondApplication
ensures core::Identity<Peano>(application_and(application_and(a, b), c), application_and(a, application_and(b, c)))
{
    transition a {
        Peano::Zero -> case_zero(b, c)
        Peano::Succ { pred } -> case_successor(b, c)
    }
    machine case_zero(b: Peano, c: Peano) {
        transition b {
            Peano::Zero -> case_zero_zero(c)
            Peano::Succ { pred } -> case_zero_successor(c)
        }
        machine case_zero_zero(c: Peano) {
            transition c {
                Peano::Zero -> case_zero_zero_zero()
                Peano::Succ { pred } -> case_zero_zero_successor()
            }
            machine case_zero_zero_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_zero_zero_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
        machine case_zero_successor(c: Peano) {
            transition c {
                Peano::Zero -> case_zero_successor_zero()
                Peano::Succ { pred } -> case_zero_successor_successor()
            }
            machine case_zero_successor_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_zero_successor_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
    }
    machine case_successor(b: Peano, c: Peano) {
        transition b {
            Peano::Zero -> case_successor_zero(c)
            Peano::Succ { pred } -> case_successor_successor(c)
        }
        machine case_successor_zero(c: Peano) {
            transition c {
                Peano::Zero -> case_successor_zero_zero()
                Peano::Succ { pred } -> case_successor_zero_successor()
            }
            machine case_successor_zero_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_successor_zero_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
        machine case_successor_successor(c: Peano) {
            transition c {
                Peano::Zero -> case_successor_successor_zero()
                Peano::Succ { pred } -> case_successor_successor_successor()
            }
            machine case_successor_successor_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_successor_successor_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
    }
}

// This is false at Zero, Zero, Succ { pred: Zero }. The checked
// commutative NAND row cannot borrow the associative AND row's license.
machine mixed_application_associativity(a: Peano, b: Peano, c: Peano)
ensures core::Identity<Peano>(application_nand(application_nand(a, b), c), application_nand(a, application_nand(b, c)))
{}

// Even the same complete trait application cannot combine laws whose
// selected operation entries belong to different families.
trait FamilyJoin<T> {
    machine combine(a: T, b: T) -> T terminates;
    machine comm(a: T, b: T)
    ensures core::Identity<T>(combine(a, b), combine(b, a));
    machine assoc(a: T, b: T, c: T)
    ensures core::Identity<T>(combine(combine(a, b), c), combine(a, combine(b, c)));
}

machine family_nand(a: Peano, b: Peano) -> Peano
satisfies FamilyJoin<Peano>::combine as CommutativeNand
terminates
{
    transition a {
        Peano::Zero -> left_zero(b)
        Peano::Succ { pred } -> left_successor(b)
    }
    machine left_zero(b: Peano) -> Peano { Peano::Succ { pred: Peano::Zero } }
    machine left_successor(b: Peano) -> Peano {
        transition b {
            Peano::Zero -> Peano::Succ { pred: Peano::Zero }
            Peano::Succ { pred } -> Peano::Zero
        }
    }
}

machine family_and(a: Peano, b: Peano) -> Peano
satisfies FamilyJoin<Peano>::combine as AssociativeAnd
terminates
{
    transition a {
        Peano::Zero -> left_zero(b)
        Peano::Succ { pred } -> left_successor(b)
    }
    machine left_zero(b: Peano) -> Peano { Peano::Zero }
    machine left_successor(b: Peano) -> Peano {
        transition b {
            Peano::Zero -> Peano::Zero
            Peano::Succ { pred } -> Peano::Succ { pred: Peano::Zero }
        }
    }
}

machine family_comm(a: Peano, b: Peano)
satisfies FamilyJoin<Peano>::comm as CommutativeNand
ensures core::Identity<Peano>(family_nand(a, b), family_nand(b, a))
{
    transition a {
        Peano::Zero -> case_zero(b)
        Peano::Succ { pred } -> case_successor(b)
    }
    machine case_zero(b: Peano) {
        transition b {
            Peano::Zero -> case_zero_zero()
            Peano::Succ { pred } -> case_zero_successor()
        }
        machine case_zero_zero() {
            // The selected operations reduce to the same constructor here.
        }
        machine case_zero_successor() {
            // The selected operations reduce to the same constructor here.
        }
    }
    machine case_successor(b: Peano) {
        transition b {
            Peano::Zero -> case_successor_zero()
            Peano::Succ { pred } -> case_successor_successor()
        }
        machine case_successor_zero() {
            // The selected operations reduce to the same constructor here.
        }
        machine case_successor_successor() {
            // The selected operations reduce to the same constructor here.
        }
    }
}

machine family_assoc(a: Peano, b: Peano, c: Peano)
satisfies FamilyJoin<Peano>::assoc as AssociativeAnd
ensures core::Identity<Peano>(family_and(family_and(a, b), c), family_and(a, family_and(b, c)))
{
    transition a {
        Peano::Zero -> case_zero(b, c)
        Peano::Succ { pred } -> case_successor(b, c)
    }
    machine case_zero(b: Peano, c: Peano) {
        transition b {
            Peano::Zero -> case_zero_zero(c)
            Peano::Succ { pred } -> case_zero_successor(c)
        }
        machine case_zero_zero(c: Peano) {
            transition c {
                Peano::Zero -> case_zero_zero_zero()
                Peano::Succ { pred } -> case_zero_zero_successor()
            }
            machine case_zero_zero_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_zero_zero_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
        machine case_zero_successor(c: Peano) {
            transition c {
                Peano::Zero -> case_zero_successor_zero()
                Peano::Succ { pred } -> case_zero_successor_successor()
            }
            machine case_zero_successor_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_zero_successor_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
    }
    machine case_successor(b: Peano, c: Peano) {
        transition b {
            Peano::Zero -> case_successor_zero(c)
            Peano::Succ { pred } -> case_successor_successor(c)
        }
        machine case_successor_zero(c: Peano) {
            transition c {
                Peano::Zero -> case_successor_zero_zero()
                Peano::Succ { pred } -> case_successor_zero_successor()
            }
            machine case_successor_zero_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_successor_zero_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
        machine case_successor_successor(c: Peano) {
            transition c {
                Peano::Zero -> case_successor_successor_zero()
                Peano::Succ { pred } -> case_successor_successor_successor()
            }
            machine case_successor_successor_zero() {
                // The selected operations reduce to the same constructor here.
            }
            machine case_successor_successor_successor() {
                // The selected operations reduce to the same constructor here.
            }
        }
    }
}

// This is false at Zero, Zero, Succ { pred: Zero }. The checked
// commutative NAND row cannot borrow the associative AND row's license.
machine mixed_family_associativity(a: Peano, b: Peano, c: Peano)
ensures core::Identity<Peano>(family_nand(family_nand(a, b), c), family_nand(a, family_nand(b, c)))
{}
