// Expected exit: 0
// Both exhaustive case arms depart; the closed cycle reaches an ordinary process exit.
use omega::language::core::ProcessExit;

public data Claim { case Idle; case Claimed(time: u64); }
machine work(claim: Claim) reaches ProcessExit ensures false {
    transition { _ -> wait(claim) }
    machine wait(claim: Claim) reaches ProcessExit {
        transition claim {
            Claim::Idle -> sleep()
            Claim::Claimed { time } -> received(time)
        }
    }
    machine sleep() reaches ProcessExit {
        transition { _ -> wait(Claim::Claimed { time: 73u64 }) }
    }
    machine received(time: u64) reaches ProcessExit {}
}
machine main() reaches ProcessExit { work(Claim::Idle); }
