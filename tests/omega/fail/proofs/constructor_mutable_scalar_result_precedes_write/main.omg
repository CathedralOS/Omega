// A primitive-reference numeric observation reads backing, not carrier identity.
data Pair { value: &mut u64; marker: u64; }
machine keep(value: &mut u64) -> &mut u64
requires value == 11;
ensures result == 11;
{ value }
machine overwrite(value: &mut u64) -> u64 { value = 99; 0 }
machine demand(value: u64) requires value == 11 {}
machine invalid(value: &mut u64) -> u64 requires value == 11 {
    let pair: Pair = Pair { value: keep(value), marker: overwrite(value) };
    demand(pair.value);
    pair.value
}
machine main() crashes Trap {
    let mut value: u64 = 11;
    let observed: u64 = invalid(&mut value);
    transition observed == 99 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
