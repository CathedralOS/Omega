use omega::language::core::nat;
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }

// A refutable axiom: the engine veto must refuse, grants notwithstanding.
boundary machine false_axiom() -> Nat
ensures
    (Nat::Zero) == (Nat::Succ { prev: Nat::Zero });

machine Main::main(&mut self) {
    self.console.exit_process(70);
}
