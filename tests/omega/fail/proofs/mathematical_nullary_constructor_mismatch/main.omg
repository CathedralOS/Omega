// The other case cannot satisfy identity with the declared First constructor.
use omega::language::core::nat;
data Choice [copy] { case First; case Other; }
let is_zero(value: Nat): core::Strict<0> = core::Identity<Nat>(value, Nat::Zero);
let is_first(value: Choice): core::Strict<0> = core::Identity<Choice>(value, Choice::First);
machine zero_fact() reaches terminates
ensures is_zero(Nat::Zero)
{ }
machine consume(value: Choice) -> u64
requires is_first(value)
{ 41u64 }
machine main() {
    let result: u64 = consume(Choice::Other);
}
