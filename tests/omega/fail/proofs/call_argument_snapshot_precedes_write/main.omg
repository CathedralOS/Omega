data Snapshot [copy] { value: u64; }
machine acquire(value: u64, slot: &mut u64) -> Snapshot
ensures result.value == value { slot = 0; Snapshot { value: value } }
machine demand(value: u64) requires value == 0 {}
machine invalid() {
    let mut value: u64 = 77;
    let snapshot: Snapshot = acquire(value, &mut value);
    demand(snapshot.value);
}
machine main() {}
