// Fail canary: the managed quotient admission never lifts a representative
// whose termination is progress-conditional. `representative` terminates
// only under the `fuel` profile premise its callers must supply, so the
// checked termination oracle cannot answer it unconditional and the
// proof-only bridge refuses the batch at the termination fence.

use omega::language::core::relation;

data Representative {
    case Zero;
    case Next(previous: Representative);
}

pub data Fuel [copy] {
    rank: u64;
}

pub domain Fuel::Rank
satisfies ProgressProfile
established by Stepper::seed;

boundary trait Stepper {
    machine seed(fuel: Fuel) -> Fuel in Rank;

    machine step(fuel: Fuel, value: Representative) -> Representative
    requires fuel in Fuel::Rank
    terminates;
}

// A checked-body conformance inherits the requirement's published
// progress premise: its own interface stays conditional on the caller
// supplying a `Rank`-qualified `fuel` even though the body is pure.
machine helper(fuel: Fuel, value: Representative) -> Representative
satisfies Stepper::step
{
    value
}

proposition equivalent(a: Representative, b: Representative) = a == b;

machine equivalent_reflexive(a: Representative)
ensures a == a
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires
    a == b
ensures b == a
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    a == b
    b == c
ensures a == c
{
}

RepresentativeEquivalence: satisfies Equivalence<Representative, equivalent> {
    Reflexive::reflexive = equivalent_reflexive;
    Symmetric::symmetric = equivalent_symmetric;
    Transitive::transitive = equivalent_transitive;
}

data EquivalenceClass = Representative % equivalent
where equivalent satisfies
    Equivalence<Representative, equivalent>
    as RepresentativeEquivalence;

machine representative(fuel: Fuel, value: Representative) -> Representative {
    helper(fuel, value)
}

machine representative_respects(fuel: Fuel, left: Representative, right: Representative)
requires
    equivalent(left, right)
ensures equivalent(representative(fuel, left), representative(fuel, right))
{
}

machine representative_transports(fuel: Fuel, left: Representative, right: Representative)
{
}

machine admitted(fuel: Fuel, value: EquivalenceClass) -> EquivalenceClass {
    Quotient::lift<
        representative,
        representative_respects,
        representative_transports
    >(fuel, value)
}

data Main {
}

machine Main::main(&mut self) {
}
