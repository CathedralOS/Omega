data Partial {}
boundary operator Partial::value(input: f32) -> u8 in Saturating
crashes Trap;

machine harmless(value: f32) -> u8 in Saturating
requires Partial::value(value) == Partial::value(value)
ensures Partial::value(value) == Partial::value(value) {
    0u8 as u8 in Saturating
}

machine main() {}
