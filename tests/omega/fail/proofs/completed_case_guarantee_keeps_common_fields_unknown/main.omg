// Completion imports the declared Empty tag, not the zero common fields of
// a bare Empty constructor. The actual returned value is marked.
data Tree {
    marked: bool;
    case Empty;
    case Node(child: Tree);
}

machine make_empty(marked: bool) -> Tree
ensures result in Tree::Empty
terminates
{ Tree::Empty { marked: marked } }

machine needs_unmarked_empty(value: Tree) -> Tree
requires value in Tree::Empty
requires value.marked == false
terminates
{ value }

machine completed_call() -> Tree
terminates
{
    let value: Tree = make_empty(true);
    needs_unmarked_empty(value)
}
