// NEGATIVE 1: the law satisfier proves NOTHING (no ensures) -> must error.
use omega::language::std::console;
use omega::language::core::binding;
data Peano { case Zero; case Succ(pred: Peano); }
trait RingOps2<T> {
    machine add(a: T, b: T) -> T;
    machine add_assoc(a: T, b: T, c: T)
    ensures add(add(a, b), c) == add(a, add(b, c));
}
machine plus(a: Peano, b: Peano) -> Peano
satisfies RingOps2<Peano>::add
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: plus(pred, b) }
    }
}
machine lawless(a: Peano, b: Peano, c: Peano)
satisfies RingOps2<Peano>::add_assoc
{
}
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) { main.console.exit_process(70); }
