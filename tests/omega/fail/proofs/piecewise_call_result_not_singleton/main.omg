machine reflected(value: i32) -> i32
requires value >= -2 && value <= 2
ensures (value < 0 && result == 0 - value) ||
    (value >= 0 && result == value)
{
    transition { value < 0 -> (0 - value) _ -> (value) }
}

machine varied(value: i32) -> i32
requires value >= -2 && value <= 2
{
    // Keeping only the zero branch would wrongly permit this addition.
    reflected(value) + 2147483647
}
