// The authored endpoint subtraction means1, so this guarantee does not state builtin end-start.
domain u64::Twisted;
machine - u64::Twisted::subtract(left: u64 in Twisted, right: u64 in Twisted) -> u64
ensures result == 1
{ 1 }
machine wrong(bytes: &[u8], start: u64 in Twisted, end: u64 in Twisted) -> &[u8]
requires bytes.len >= 1
ensures result.len == end - start
{ bytes[0..1] }
machine need_two(bytes: &[u8]) requires bytes.len == 2 {}
machine main() {
    let bytes: [u8; 2];
    let start: u64 in Twisted = 0;
    let end: u64 in Twisted = 2;
    let selected: &[u8] = wrong(&bytes, start, end);
    need_two(selected);
}
