data Flags { bits: [bool; 2]; }

machine initialize(flags: &mut Flags)
ensures flags.bits[1]
{
    flags.bits[1] = true;
}

machine require_ready(flags: &Flags)
requires flags.bits[1]
{}

machine main() {
    let mut flags: Flags = Flags { bits: [false, false] };
    initialize(&mut flags);
    flags.bits[1] = false;
    require_ready(&flags);
}
