// N4 first slice, consumption twin: core Nat is proof-only (N1's
// classification: recursive data has no layout), so a machine field
// holding it refuses at the machine face with the chain named.
use omega::language::core::nat;
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; n: Nat; }
machine Main::main(&mut self) {
    self.console.exit_process(0);
}
