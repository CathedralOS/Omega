// N4 first slice, consumption twin: core Nat is proof-only (N1's
// classification: recursive data has no layout). A record holding it cannot
// be supplied as an explicit runtime parameter. Its namespace adds no storage.
use omega::language::core::nat;
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; n: Nat; }
machine Main::main(main: &mut Main) {
    main.console.exit_process(0);
}
