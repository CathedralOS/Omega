machine apply<machine Transform>(left: u64, right: u64, tag: u64) -> Note
where machine Transform(first: u64, second: u64, event: u64) -> Note;
{ Transform(left, right, tag) }
// Expected exit: 0
// Every actual arrival establishes the nested helper's equality.
data Note { value: u64; tag: u64; }
machine same(left: u64, right: u64) -> u64
requires left == right; ensures result == left; { left }
machine probe(value: u64, select: bool) -> Note {
    let ignored: Note = apply<forward>(value, 3, 17);
    transition select {
        true -> forward(value, value, 11)
        false -> forward(value, value, 13)
    }
    machine forward(left: u64, right: u64, tag: u64) -> Note {
        Note { value: same(left, right), tag: tag }
    }
}
machine main() crashes Trap {
    let first: Note = probe(7, true);
    let second: Note = probe(9, false);
    transition first.value == 7 && first.tag == 11 && second.value == 9 && second.tag == 13 {
        true -> done() false -> bad()
    }
    machine done() {} machine bad() crashes Trap { crash Trap; }
}
