// Unfolding a premise grants exactly its body. `before` is not symmetric, so
// its unfolded premise `left.x < right.x` cannot prove `right.x < left.x`.
use omega::language::core::relation;

data Point {
    x: u32;
}

proposition before(left: Point, right: Point) = left.x < right.x;

machine before_symmetric(left: Point, right: Point)
satisfies Symmetric<Point, before>::symmetric
requires before(left, right)
ensures before(right, left)
{
}

machine main() {}
