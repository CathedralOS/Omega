// Checking-only invalid control: execution returns true, never false.
// The lexically earlier skipped block must not establish the returned value.
machine choose() -> bool {
    asm {
    entry:
        jmp live;
    skipped:
        jmp no();
    live:
        jmp yes()
    }
    state no() -> bool { false }
    state yes() -> bool { true }
}

machine demand(value: bool) -> bool
requires value == false
{
    value
}

machine main() -> bool {
    demand(choose())
}
