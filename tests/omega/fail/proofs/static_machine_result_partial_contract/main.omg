use omega::language::core::nat;
data Observation { value: Nat; }
machine project<machine Read>(index: Nat) -> Nat
requires machine Read(index: Nat) -> Observation;
{
    let observation: Observation = Read(index);
    transition { _ -> observation.value }
}
machine unproved<machine Read>(index: Nat)
requires machine Read(index: Nat) -> Observation;
requires
    project<Read>(index) == Nat::Zero
ensures
    project<Read>(index) == Nat::Zero
{
}
machine main() {}
