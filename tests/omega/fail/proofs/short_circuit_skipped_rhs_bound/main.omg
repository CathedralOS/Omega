data Context { count: u64; }
machine skip(context: &mut Context) -> bool { context.count = 9; true }
machine main(context: &mut Context) {
    transition skip(context) || context.count < 6 { true -> bounded(context) false -> done() }
    state bounded(context: &Context) requires context.count < 6 { }
    state done() { }
}
