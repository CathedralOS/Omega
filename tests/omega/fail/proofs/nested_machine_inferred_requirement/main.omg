// An identity fact on one arrival cannot justify a different incoming path.
data Branch {
    case End;
    case Next(child: Branch);
}

machine same(left: Branch, right: Branch)
requires core::Identity<Branch>(left, right)
{}

machine visit(value: Branch) {
    transition value {
        Branch::End -> forward(Branch::End, Branch::End)
        Branch::Next { child } -> forward(child, Branch::End)
    }

    machine forward(left: Branch, right: Branch) {
        same(left, right);
    }
}

machine main() {
    visit(Branch::Next { child: Branch::End });
}
