// `total = N + 1` reads the const binder `N`, whose carrier admits 100. The
// later `let N` is a different binding: its narrow initializer must not
// stand in for the binder when proving the bounded store.
domain u64::Total(value) requires value <= 4;
domain u64::Narrow(value) requires value <= 3;

machine shadow<const N: u64>(narrow: &[u64 in Narrow; 4]) -> u64
requires N <= 100;
{
    let mut total: u64 in Total = 0;
    total = N + 1;
    let N: u64 = narrow[0];
    transition { _ -> (total) }
}

machine main() {}
