// A later call changes the returned reference's live contents.
data Cell [copy] { value: u64; }

machine restore(cell: &mut Cell) -> &mut Cell
ensures result.value == 11 {
    cell.value = 11;
    cell
}

machine reset(value: &mut u64) { value = 99; }

machine invalid(cell: &mut Cell) -> u64
ensures result == 11 {
    let returned: &mut Cell = restore(cell);
    reset(&mut returned.value);
    returned.value
}
