use omega::language::core::float_operations;

machine invalid_absolute(value: f64) -> f64
ensures
    (value < 0.0 && F64::meaning(result) == FloatSemantics::negate(FloatFormat::BINARY64, F64::meaning(value))) ||
    (value >= 0.0 && F64::meaning(result) == F64::meaning(value))
{
    transition {
        value < 0.0 -> (F64::negate(value))
        _ -> (value)
    }
}