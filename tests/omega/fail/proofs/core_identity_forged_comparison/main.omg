// A selected comparison that always returns true supplies no Id bridge.
trait Equatable<T> { machine equals(left: &T, right: &T) -> bool reaches terminates; }
data Pair [copy] { first: u8; last: u8; }
AlwaysEqual satisfies Equatable<Pair> {
    machine equals(left: &Pair, right: &Pair) -> bool reaches terminates
    ensures result == true { true }
}
machine require_identity(left: Pair, right: Pair)
requires core::Identity<Pair>(left, right)
{ }
machine forged(left: Pair, right: Pair)
requires left == right
{
    require_identity(left, right);
}
// The checked body above must reject under the selected comparison premise.
machine main() { }

// An ordinary true Boolean predicate gains no core identity authority by name.
machine Identity<T>(left: Pair, right: Pair) -> bool reaches terminates
ensures result == true
{ true }
machine forged_name(left: Pair, right: Pair)
requires Identity<Pair>(left, right)
{
    require_identity(left, right);
}
