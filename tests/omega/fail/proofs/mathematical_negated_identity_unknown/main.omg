// Independent subjects do not establish either identity or its negation.
data Pair [copy] { first: u8; last: u8; }
let different<A: core::Type<0>>(left: A, right: A): core::Strict<0> =
    !core::Identity<A>(left, right);
let same_twice<A: core::Type<0>>(left: A, right: A): core::Strict<0> =
    !!core::Identity<A>(left, right);
machine arbitrary(left: Pair, right: Pair) reaches terminates
ensures different<Pair>(left, right)
{ }
machine main() { }
