// False twin of proofs/proof_addition_commutativity (ladder rung L4).
// Mathematical a + b == b + a + 1 normalizes to 0 == 1. Embedding makes
// every term well-formed, so normalization must reject the false claim
// rather than stopping at an unrelated Exact u64 overflow obligation.

machine false_add_commutative(a: u64, b: u64)
ensures
    embed(a) + embed(b) == embed(b) + embed(a) + 1
{
}

data Main {
}

machine Main::main(&mut self) {
}
