machine start(value: u64 in Trapping) {
    transition value <= 99 {
        true -> loop(value, 0)
        _ -> done()
    }
    state loop(rest: u64 in Trapping, count: u64 in Trapping)
    requires count <= 9 && embed(rest) + embed(count) * 10 <= 99
    {
        transition rest >= 10 {
            true -> loop(rest - 10, count + 2)
            _ -> done()
        }
    }
    state done() { }
}
