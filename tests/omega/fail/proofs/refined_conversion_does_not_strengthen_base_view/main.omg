use omega::language::core::Result;
use omega::language::core::TryFrom;
data Pair [copy] { first: u8; last: u8; }
data Frame [copy] { tag: u8; first: u8; last: u8; }
data Failure [copy] { case InvalidTag; }
trait ValueConversion<Source, Destination, Error> = TryFrom<Source, Destination, Error> {
    machine * reaches suspends false blocks false terminates;
}
// Both bounds have the same base trait application. Only Strong has progress.
trait Strong<Encode satisfies ValueConversion<Pair, Frame, Failure>> {
    machine coverage(value: Pair) reaches terminates
    ensures Encode::try_from(value) in Result::Ok;
}
trait Weak<Encode satisfies TryFrom<Pair, Frame, Failure>> {
    machine unlicensed(value: Pair)
    ensures core::Identity<Result<Frame, Failure>>(Encode::try_from(value), Encode::try_from(value));
}
machine main() { }
