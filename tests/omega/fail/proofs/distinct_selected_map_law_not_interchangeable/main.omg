use omega::language::core::Result;
use omega::language::core::TryFrom;
data Pair [copy] { first: u8; last: u8; }
data Frame [copy] { tag: u8; first: u8; last: u8; }
data Failure [copy] { case InvalidTag; }
trait ValueConversion<Source, Destination, Error> = TryFrom<Source, Destination, Error> {
    machine * reaches suspends false blocks false terminates;
}
// Equal endpoint types and public contracts do not identify selected maps.
machine distinct_maps<
    Left satisfies ValueConversion<Pair, Pair, Failure>,
    Right satisfies ValueConversion<Pair, Pair, Failure>>(value: Pair)
requires core::Identity<Result<Pair, Failure>>(Left::try_from(value), Result::Ok { value: value })
ensures core::Identity<Result<Pair, Failure>>(Right::try_from(value), Result::Ok { value: value })
{ }
machine main() { }
