// Expected rejection: the field changed after the helper checked it.
// The old true result must not justify subtracting 37 from the changed field.

public data Cell {
    value: u64;
}

public machine accepts(accepted: bool, value: &Cell) -> bool reaches terminates {
    !accepted || value.value == 37
}
machine check(value: &Cell) -> bool
ensures accepts(result, value) {
    value.value == 37
}

machine checked(value: &mut Cell) -> u64 {
    let accepted: bool = check(value);
    value.value = 91;
    transition accepted {
        true -> use_value(value)
        _ -> declined()
    }
    machine use_value(value: &Cell) -> u64
    requires value.value == 37 {
        value.value - 37
    }
    machine declined() -> u64 { 91 }
}
machine main() crashes Trap {
    let mut matching: Cell = Cell { value: 37 };
    let mut other: Cell = Cell { value: 91 };
    let yes: u64 = checked(&mut matching);
    let no: u64 = checked(&mut other);
    transition yes == 0 && no == 91 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
