data Counter { value: u64; }
domain Counter::Nonnegative(counter) requires counter.value >= 0;
machine consume(counter: &Counter) -> u64
requires counter.value >= 1 && addr::Bound == 18446744073709551616
{ counter.value - 1 }
machine caller(counter: &mut Counter in Nonnegative) -> u64
requires counter.value >= 1 && addr::Bound == 18446744073709551616
{
    counter.value = 0;
    consume(counter as &Counter)
}
