data Context { count: u64; }
machine overwrite(context: &mut Context) -> bool { context.count = 9; true }
machine main(context: &mut Context) {
    transition context.count < 6 && overwrite(context) { true -> bounded(context) false -> done() }
    state bounded(context: &Context) requires context.count < 6 { }
    state done() { }
}
