// FAIL CANARY: doubled-precision closeness and a positive middle denominator
// establish a zero target residual; citing that checked theorem must refute a
// claim that the same residual is positive.
use omega::language::core::rat;

machine false_close_triangle(
    left: Rat,
    middle: Rat,
    right: Rat,
    precision: Nat
)
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, middle.den)) == Nat::Zero;
    (rat_close(left, middle, add(precision, precision))) == Nat::Zero;
    (rat_close(middle, right, add(precision, precision))) == Nat::Zero
ensures
    (rat_close(left, right, precision)) ==
        (Nat::Succ { prev: Nat::Zero })
{
    rat_close_triangle_split(left, middle, right, precision);
}

data Main {
}

machine Main::main(&mut self) {
