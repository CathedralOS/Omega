// A known zero cannot satisfy the negation of that same exact identity.
use omega::language::core::Nat;
use omega_language_std::Console;
data Main { }
machine Main::main(main: &mut Main) { Console::exit_process(70); }
machine bogus(a: Nat)
requires
    core::Identity<Nat>(a, Nat::Zero)
ensures
    !core::Identity<Nat>(a, Nat::Zero)
{
}
