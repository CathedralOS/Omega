machine bounded(value: i32, lower: i32, upper: i32) -> i32
requires lower <= upper
ensures result >= lower && result <= upper &&
    ((value < lower && result == lower) ||
     (value > upper && result == upper) ||
     (value >= lower && value <= upper && result == value))
{
    transition {
        value < lower -> (upper)
        value > upper -> (upper)
        _ -> (value)
    }
}
