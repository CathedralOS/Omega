// False twin of proofs/proof_congruence_add_constant (ladder rung L3).
// a == b entails mathematical a + 1 == b + 1, never a + 1 == b + 2.
// Embed before adding so rejection tests the false conclusion under the
// equality premise, not unrelated Exact u64 overflow.

machine false_add_congruence(a: u64, b: u64)
requires
    a == b
ensures
    embed(a) + 1 == embed(b) + 2
{
