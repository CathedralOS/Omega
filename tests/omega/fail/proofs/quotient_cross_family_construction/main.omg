use omega::language::core::relation;

data Index {
    case Zero;
    case Next(previous: Index);
}

data Stream<machine S>
where machine S(index: Index) -> Index;
{
    case Empty;
    case More(sample: Index, tail: Stream<S>);
}

data OtherStream<machine S>
where machine S(index: Index) -> Index;
{
    case Empty;
    case More(sample: Index, tail: OtherStream<S>);
}

boundary machine source(index: Index) -> Index;

proposition equivalent<machine A, machine B>(a: Stream<A>, b: Stream<B>) = a == b;

machine equivalent_reflexive<machine A>(a: Stream<A>)
where machine A(index: Index) -> Index;
ensures a == a
{
}

machine equivalent_symmetric<machine A, machine B>(a: Stream<A>, b: Stream<B>)
where machine A(index: Index) -> Index;
where machine B(index: Index) -> Index;
requires a == b
ensures b == a
{
}

machine equivalent_transitive<machine A, machine B, machine C>(
    a: Stream<A>,
    b: Stream<B>,
    c: Stream<C>
)
where machine A(index: Index) -> Index;
where machine B(index: Index) -> Index;
where machine C(index: Index) -> Index;
requires
    a == b
    b == c
ensures a == c
{
}

StreamEquivalence: satisfies Equivalence<Stream, equivalent> {
    Reflexive::reflexive = equivalent_reflexive;
    Symmetric::symmetric = equivalent_symmetric;
    Transitive::transitive = equivalent_transitive;
}

data EquivalenceClass = Stream % equivalent
where equivalent satisfies
    Equivalence<Stream, equivalent>
    as StreamEquivalence;

machine bad(value: OtherStream<source>) -> EquivalenceClass {
    value as EquivalenceClass
}

data Main {
}

machine Main::main(&mut self) {
}
