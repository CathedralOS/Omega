data Flags { bits: [bool; 2]; }

machine initialize(flags: &mut Flags)
ensures flags.bits[1]
{
    flags.bits[1] = true;
}

machine require_selected(flags: &Flags, index: u64)
requires index < 2, flags.bits[index]
{}

// A dynamic observation cannot inherit a different literal index's truth.
machine main() {
    let mut flags: Flags = Flags { bits: [false, false] };
    initialize(&mut flags);
    let index: u64 = 0;
    require_selected(&flags, index);
}
