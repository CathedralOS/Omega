// The leaf inherits `reaches Wait` from its governing requirement, so a caller
// whose authored ceiling is empty cannot hide that reach behind the leaf.
boundary trait Wait {
    machine pause(timeout: i32) -> i64
    reaches Wait
    blocks;
}

data WaitSyscalls { }

linux_x86_64 machine WaitSyscalls::pause(timeout: i32) -> i64
    satisfies Wait::pause
    via ForeignBinding::Syscall(7);

linux_x86_64 machine pause_once()
reaches
blocks
{
    let status: i64 = block WaitSyscalls::pause(0);
}
