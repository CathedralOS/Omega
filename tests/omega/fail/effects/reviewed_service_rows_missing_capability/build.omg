machine build(builder: &mut Build) {
    Build::package(builder, "reviewed_service_rows_missing_capability");
    let mut reviewed_service_dependency: DependencyDescription = dependency::from_source(Source::Path {
        location: "../../../pass/effects/reviewed_service_rows_exit/library"
    });
    dependency::with_alias(&mut reviewed_service_dependency, "reviewed_service");
    let reviewed_service_registration: DependencyRegistration = Build::dependency(builder, reviewed_service_dependency);
}
