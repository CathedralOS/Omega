use omega::language::core::FilesystemContentWrite;

public boundary trait SurfacePresentation {}
public boundary trait NativeFilesystem {
    machine write_cache() reaches FilesystemContentWrite;
}
public boundary trait GraphicsPlatform {
    machine present() reaches SurfacePresentation invokes NativeFilesystem;
}

machine write_cache() reaches FilesystemContentWrite invokes NativeFilesystem {
    NativeFilesystem::write_cache();
}

data Renderer {}
machine Renderer::present() satisfies GraphicsPlatform::present
invokes NativeFilesystem {
    write_cache();
}