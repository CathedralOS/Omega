
public boundary trait Read {}
public boundary trait Handler { machine read() -> u64 reaches Read; }
public boundary trait Registrar {
    machine execute<machine Callback>() -> u64
    where machine Callback satisfies Handler::read;
    reaches
    invokes Handler;
}
machine read_callback() -> u64 satisfies Handler::read reaches Read { 7 }

// Opaque synchronous entry cannot hide the exact callback's read capability.
machine missing_capability() -> u64 reaches Registrar {
    Registrar::execute<read_callback>()
}
