use omega_language_std::macos_gui;

public boundary trait PresentationClient {
    machine send(receiver: u64, selector: u64) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
        FilesystemNamespaceMutation + ProcessInput + ProcessOutput +
        ProcessExit
    invokes ObjectiveC;
}

public RuntimePresentation satisfies PresentationClient {
    machine send(receiver: u64, selector: u64) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit
    invokes ObjectiveC; {
        ObjectiveC::send(receiver, selector)
    }
}