pub boundary trait Console {}
pub trait StepContract {
    machine step(value: u64) -> u64 reaches Console terminates;
}
machine selected(value: u64) -> u64
satisfies StepContract::step
reaches Console
terminates;
{
    value
}
pub machine traverse<machine Step>(value: u64) -> u64
where machine Step satisfies StepContract::step;
terminates;
{
    Step(value)
}
machine length() -> u64 { traverse<selected>(7) }
data Buffer { bytes: [u8; length()]; }
