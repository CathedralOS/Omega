// File-length authority cannot select FileDispositionInfo (class 4).
use omega_language_std::targets::windows_x86_64::windows_filesystem_file_control_native;
use omega::language::core::filesystem_authority;

machine change_disposition() -> i32
reaches FilesystemContentWrite + FilesystemMetadataMutation {
    let input: WindowsNativeFileEndOfFileInfo = WindowsNativeFileEndOfFileInfo { length: 0 };
    block WindowsFilesystemFileControlIo::end_of_file(0, 4, &input, 8)
}
