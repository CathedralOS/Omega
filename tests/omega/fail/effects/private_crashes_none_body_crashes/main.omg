// A private machine that writes `crashes none` has promised no crash route,
// which is a different thing from omitting the clause to request inference.
// `risky` makes that promise and its `bad` arm runs `crash Trap;`, so the body
// breaks it; `main` declaring `crashes Trap` must not absorb the route on
// `risky`'s behalf. Twin: `fail/effects/crashes_none_rejects_trap` is the same
// program with `public machine risky`.
// Expected: reject the body's uncovered Trap route
machine risky(ready: bool) crashes none {
    transition ready { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
machine main() reaches none crashes Trap {
    risky(true);
}
