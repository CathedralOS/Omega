// SQOS_PRESENT plus SECURITY_IMPERSONATION is not anonymous acquisition.
use omega_language_std::targets::windows_x86_64::windows_filesystem_metadata_native;
use omega::language::core::filesystem_authority;

machine checked_metadata_open(path: &[u16; 4096] in WindowsNativePath) -> i64
reaches FilesystemMetadataQuery {
