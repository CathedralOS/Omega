use omega_language_std::File;
use omega_language_std::IoResult;
use omega_language_std::Filesystem;
use omega_language_std::FilesystemService;
use omega::language::core::FilesystemContentRead;

// Direct boundary use needs the write capability, even for a closed handle.
public machine read_only(filesystem: &mut Filesystem) -> IoResult
blocks
reaches FilesystemContentRead
invokes FilesystemService
{
    block FilesystemService::write(File { handle: 0 }, "x")
}

data Main { filesystem: Filesystem; }
machine Main::main(main: &mut Main) {
    let result: IoResult = block read_only(&mut main.filesystem);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    block Main::main(&mut entry_storage);
}
