// A namespace-only native contract cannot enable MOVEFILE_COPY_ALLOWED.
use omega_language_std::targets::windows_x86_64::windows_filesystem_native;
use omega::language::core::filesystem_authority;

machine copy_through_rename() -> i32
reaches FilesystemNamespaceMutation {
    let mut from: [u16; 4096];
    let mut to: [u16; 4096];
    from[4095] = 0;
    to[4095] = 0;
    block WindowsFilesystemIo::c_rename_file(&from, &to, 2)
}
