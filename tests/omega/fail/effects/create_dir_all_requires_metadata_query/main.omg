// Existing-directory acceptance queries metadata; the wrapper cannot hide it.
use omega_language_std::filesystem;
use omega::language::core::filesystem_authority;

public machine create_without_query(path: &[u8] in Path) -> UnitResult
blocks;
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes FilesystemService;
{
    block FilesystemService::create_dir_all(path)
}
