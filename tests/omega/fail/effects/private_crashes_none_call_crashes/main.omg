// A private machine that writes `crashes none` has promised no crash route, so
// a call whose callee can still trap breaks that promise. `divide` traps when
// its denominator is zero and `quotient` passes zero, so the route is live at
// the call; `main` declaring `crashes Trap` must not absorb it on `quotient`'s
// behalf. Twin: `pass/effects/private_crashes_none_call_disproved_exit` passes
// a nonzero denominator, which disproves the route.
// Expected: reject the call's uncovered Trap route
machine divide(numerator: u64, denominator: u64) -> u64
crashes Trap denominator == 0u64
{
    transition denominator == 0u64 {
        true -> bad()
        false -> (numerator / denominator)
    }
    machine bad() -> u64 crashes Trap { crash Trap; }
}
machine quotient() -> u64 crashes none {
    divide(12u64, 0u64)
}
machine main() reaches none crashes Trap {
    let value: u64 = quotient();
    transition value == 4u64 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
