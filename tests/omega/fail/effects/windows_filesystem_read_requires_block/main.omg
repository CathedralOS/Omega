// Synchronous raw I/O can occupy its worker, even for an empty request.
use omega_language_std::WindowsFilesystemHost;
use omega::language::core::FilesystemContentRead;

machine read(handle: u64, buffer: &mut [u8]) -> i64
reaches FilesystemContentRead {
    WindowsFilesystemHost::read_file(handle, buffer, 0)
}
