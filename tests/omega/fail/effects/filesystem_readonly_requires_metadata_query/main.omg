// A read-modify-write permission request cannot hide its metadata query.
use omega_language_std::filesystem;
use omega::language::core::filesystem_authority;

machine mutate_without_query(path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation
invokes FilesystemService;
{
    FilesystemService::set_permissions(path, Permissions::Readonly { value: true })
}
