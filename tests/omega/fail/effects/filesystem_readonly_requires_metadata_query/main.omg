// A read-modify-write permission request cannot hide its metadata query.
use omega_language_std::UnitResult;
use omega_language_std::Permissions;
use omega_language_std::FilesystemService;
use omega::language::core::FilesystemMetadataMutation;

machine mutate_without_query(path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation
invokes FilesystemService
{
    block FilesystemService::set_permissions(path, Permissions::Readonly { value: true })
}
