// SOUNDNESS BOUNDARY for the relational loop-head invariant. Both incoming
// edges establish `main.i < main.items.len`, but the head increments `main.i`
// before indexing. The relation described the old value and must be forgotten
// on reassignment; a one-character carrier reaches the access with i == len.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Main {
    items: [u8; 8] in Utf8;
    i: u64;
    value: u8;
}

machine Main::main(main: &mut Main) {
    main.items = "x";
    main.i = 0;
    transition main.i < main.items.len {
        true -> loop_(main)
        false -> done()
    }

    state loop_(main: &mut Main) {
        main.i = main.i + 1;
        main.value = main.items[main.i];
        transition main.i < main.items.len {
            true -> loop_(main)
            false -> done()
        }
    }

    state done() { }
}
