// The arrival proves i <= main.count only for that observation. Replacing
// count invalidates it: forwarding i must establish the deeper state's
// precondition against the new count, not replay the previous arrival fact.
use omega_language_std::console;
use omega::language::core::binding;
data Main where count <= 11 { console: Binding<Console>; items: [u8; 12]; count: u32; j: u32; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.count = 8;
    main.j = 6;
    transition main.j <= main.count { true -> read(main, main.j) _ -> bad(main) }
    state read(main: &mut Main, i: u32) requires i <= main.count {
        main.count = 3;
        transition main.out == 0 { true -> deeper(main, i) _ -> bad(main) }
    }
    state deeper(main: &mut Main, k: u32) requires k <= main.count {
        main.out = main.items[k] as i32;
        main.console.exit_process(main.out);
    }
    state bad(main: &mut Main) { main.console.exit_process(9); }
}
