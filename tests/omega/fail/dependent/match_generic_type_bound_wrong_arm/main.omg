// CASE-CONSTRAINTS impossible-arm coverage is not coverage: `T == i32`
// refutes `Integer` on `Value<bool>`, so a `match` covering only the
// impossible arm leaves the possible `Boolean` case uncovered.
data Value<T> [copy]
    requires ((self in Value::Integer) && T == i32)
       || ((self in Value::Boolean) && T == bool)
{
    case Integer(value: i32);
    case Boolean(value: bool);
}
machine flag(v: Value<bool>) -> bool {
    match v {
        Value::Integer { value } -> value != 0
    }
}
