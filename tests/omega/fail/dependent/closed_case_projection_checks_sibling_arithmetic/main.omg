// A selected closed payload cannot hide an unsafe evaluated sibling.
data Interval [copy] 
    requires (self in Interval::Empty) || ((self in Interval::Point) && (self.lo == self.hi))
{
    case Empty;
    case Point(lo: u64, hi: u64, sibling: u64);
}
data Main { amount: u64; width: u64; }
machine Main::main(main: &mut Main) {
    transition (Interval::Point { lo: 4, hi: 4, sibling: main.amount + 1 }) {
        Interval::Point { lo, hi, sibling as _ } -> take(lo, hi, main)
        Interval::Empty -> done()
    }
    machine take(lo: u64, hi: u64, main: &mut Main) { main.width = hi - lo; }
    machine done() {}
}
