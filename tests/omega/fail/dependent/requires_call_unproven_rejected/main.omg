// FAIL CANARY: calling a machine whose `requires` names field facts the
// CALLER has not established refuses -- the contract prover demands the
// fact at the call site ("establish it before the call"). The guarded
// sibling shape PASSES since the incoming-guard intake landed
// (pass/dependent/runtime_requires_guarded_call_exit); this pin keeps
// the truly-unguarded refusal, and guard-then-write-before-the-call
// also refuses (the caller state's own preservation scan).
use omega_language_std::console;
use omega::language::core::numeric_conversion;
data Main { a: u32; b: u32; out: i32; }
machine Main::main(main: &mut Main) reaches Console {
    main.a = 9;
    main.b = 3;
    Main::helper(main);
    Console::exit_process(main.out);
}
machine Main::helper(main: &mut Main) requires main.a <= main.b {
    let diff: u32 = main.b - main.a;
    main.out = narrow_u32_to_i32_trapping(diff);
}
