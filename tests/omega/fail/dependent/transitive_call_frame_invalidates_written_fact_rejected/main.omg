// FAIL CANARY. A transitive summary must carry an inner write back through
// its sibling caller and invalidate the outer caller's pre-call fact.
data Main {
    stable: u32;
    result: u32;
}

machine Main::main(main: &mut Main) {
    main.stable = 5;
    Main::middle(main);
    main.result = main.stable + 1;
}

machine Main::middle(main: &mut Main) {
    Main::touch(main);
}

machine Main::touch(main: &mut Main) {
    main.stable = 1;
}
