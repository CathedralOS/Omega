// FAIL CANARY. The saved local observation is exact, not permissive: `n`
// denotes `items.len` itself, so `requires rest.len < capacity` cannot hold --
// a length is never strictly below itself, and the boundary still rejects
// rather than discharging a false obligation.
data Main {
}

machine Main::main(&mut self) -> u64 {
    let items: &[i32] = &[7, 8, 9];
    transition { _ -> self.outer(items) }
}

machine Main::outer(&mut self, items: &[i32]) -> u64 {
    let n: u64 = items.len;
    transition { _ -> self.inner(items, n) }
}

machine Main::inner(&mut self, rest: &[i32], capacity: u64) -> u64
requires rest.len < capacity
{
    transition rest.len > 0 {
        true -> 3
        false -> 0
    }
}
