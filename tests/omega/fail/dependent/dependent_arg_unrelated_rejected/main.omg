// FAIL CANARY (R1a): a transition argument into a dependent-ranged
// parameter with NO relating guard and no floor discharge refuses -- the
// obligation `arg <= main.count` is the caller's, and nothing here proves
// it (`j: u32` is unbounded above; count's declared minimum is 0).
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; items: [u8; 12]; count: u32 [0..=11]; j: u32; out: i32; }
machine Main::main(main: &mut Main) {
    main.count = 8;
    main.j = 6;
    transition main.j == 6 { true -> read(main, main.j) _ -> read(main, 0) }
    state read(main: &mut Main, i: u32 [0..=main.count]) {
        main.out = main.items[i] as i32;
        main.console.exit_process(main.out);
    }
}
