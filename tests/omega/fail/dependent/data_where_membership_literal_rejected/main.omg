// FAIL CANARY. Membership gates are per-value proofs: an empty byte literal
// does not satisfy the domain's declared `non_empty(self)` fact.
domain [u8]::NonEmpty
requires
    non_empty(self);
data Message
where
    text in NonEmpty,
{
    text: &[u8];
}

data Main {
}

machine Main::main(&mut self) {
    let message: Message = Message { text: "" };
}
