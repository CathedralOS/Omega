// CASE-CONSTRAINTS match-contributed case facts control: the selected
// case's `where` contributes only what it declares -- `lo <= hi` does not
// prove the reversed `lo - hi`, which may underflow `u64` and stays
// rejected inside the same arm shape that the pass canary admits.
data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { interval: Interval; }
machine Main::main(&mut self) {
    self.interval = Interval::Range { lo: 1, hi: 5 };
    transition self.interval {
        Interval::Range { lo, hi } -> span(lo - hi)
        _ -> bad()
    }
    state span(&mut self, width: u64) {}
    state bad(&mut self) {}
}
