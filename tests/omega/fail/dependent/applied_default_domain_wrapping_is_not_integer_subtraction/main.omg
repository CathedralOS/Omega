data Counter<const Limit: u8> where count <= Limit { count: u8 in Wrapping; }

machine Counter::set<const Bound: u8>(counter: &mut Counter<Bound>, value: u8 in Wrapping)
requires value <= 5;
{
    counter.count = value - 10;
}

data Main { counter: Counter<20>; }
machine Main::main(main: &mut Main) {
    Counter::set(&mut main.counter, 3);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
