// FAIL CANARY. A local array carries no `where` fact, and its cell 0 holds
// 9, so nothing establishes the callee's collection-predicate requirement.

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

machine first(cells: &[i32; 4]) -> i32
requires cells_valid(cells) == true
{
    transition { _ -> (cells[0]) }
}

data Main {
    seen: i32;
}

machine Main::main(context: &mut Main) {
    let mut cells: [i32; 4];
    cells[0] = 9;
    context.seen = first(&cells);
}
