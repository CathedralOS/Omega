// FAIL CANARY. A call is a consumption point, and start=10/end=0 cannot
// re-establish the attached data's standing start <= end fact there.
public boundary trait Console { machine exit_process(return_code: i32) reaches; }
data Main
where
    start <= end,
{
    start: i32;
    end: i32;
}
machine Main::main(main: &mut Main) {
    main.start = 10;
    Console::exit_process(70);
}
