data Counter<const Limit: u64> where count <= Limit { count: u64; }

machine Counter::set<const Bound: u64>(counter: &mut Counter<Bound>, mut value: u64)
requires value <= Bound;
{
    value = 5;
    counter.count = value;
}

data Main { counter: Counter<4>; }
machine Main::main(main: &mut Main) {
    Counter::set(&mut main.counter, 3);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
