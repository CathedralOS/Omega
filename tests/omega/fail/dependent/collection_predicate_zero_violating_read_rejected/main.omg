// FAIL CANARY. The collection predicate requires the first cell to be 1, so
// exploring it at the zeroed cells returns `false`: `Grid` stays gated and
// reading it before construction is refused.

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    state at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    state at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    state at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
    seen: i32;
}

machine Main::main(main: &mut Main) {
    main.seen = main.grid.board[2];
}
