// Ordinary local zero storage does not establish Grid's complete predicate.
// Borrowing Main must prove it before the caller can observe that value.
machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
    seen: i32;
}

machine Main::main(main: &mut Main) {
    main.seen = main.grid.board[2];
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
