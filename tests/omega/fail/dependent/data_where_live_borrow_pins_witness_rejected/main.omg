// FAIL CANARY. A live borrow into a dependent record pins every sibling named
// by its default-domain coupling; end cannot change while the start view lives.
data Map
where
    start <= end,
{
    start: i32;
    end: i32;
}
data Main { map: Map; }
machine Main::main(main: &mut Main) {
    main.map.start = 10;
    main.map.end = 20;
    let view: &mut i32 = &mut main.map.start;
    main.map.end = 30;
    touch(view);
}
machine touch(value: &mut i32) { value = 10; }
