// Descent proves termination, not element bounds. The predicate must actually
// inspect the selected coordinate, and inspecting another array grants nothing.
machine visits_only(values: &[i32]) -> bool { skip(values, values.len) }
machine skip(values: &[i32], remaining: u64) -> bool
requires remaining <= values.len
terminates;
terminates by remaining in 0..=values.len;
{
    transition remaining > 0 {
        true -> skip(values, remaining - 1)
        false -> (true)
    }
}
machine uncited_cell(values: &[i32], selected: u64)
requires visits_only(values) == true
requires selected < values.len
ensures values[selected] >= 0 && values[selected] <= 255
{}

machine valid_values(values: &[i32]) -> bool { check_values(values, values.len) }
machine check_values(values: &[i32], remaining: u64) -> bool
requires remaining <= values.len
terminates;
terminates by remaining in 0..=values.len;
{
    transition remaining > 0 { true -> inspect(values, remaining) false -> (true) }
    machine inspect(values: &[i32], remaining: u64) -> bool
    requires remaining > 0 && remaining <= values.len
    {
        let selected: u64 = remaining - 1;
        transition values[selected] >= 0 && values[selected] <= 255 {
            true -> check_values(values, selected)
            false -> (false)
        }
    }
}
machine wrong_subject(values: &[i32], checked: &[i32], selected: u64)
requires valid_values(checked) == true
requires selected < values.len
ensures values[selected] >= 0 && values[selected] <= 255
{}

machine stronger_than_predicate(values: &[i32], selected: u64)
requires valid_values(values) == true && selected < values.len
ensures values[selected] <= 254
{}
