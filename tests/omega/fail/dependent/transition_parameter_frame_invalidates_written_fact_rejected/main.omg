// FAIL TWIN: the transitioned `$P0` frame instantiates to `self.stable`, so
// the caller's earlier exact value cannot prove the following Exact addition.
data Main {
    stable: u32;
    result: u32;
}

machine Main::main(&mut self) {
    self.stable = 5;
    transition_write(&mut self.stable);
    self.result = self.stable + 1;
}

machine transition_write(value: &mut u32) {
    transition { _ -> write(value) }

    state write(slot: &mut u32) {
        slot = 1;
    }
}
