// Zero selects the first case; satisfying another case proves nothing about it.
data Choice
    requires ((self in Choice::Selected) && self.value >= 1 && self.value <= 100)
       || (self in Choice::Empty)
{
    case Selected(value: i32);
    case Empty;
}
data Context { choice: Choice; }
machine main() {
    let context: Context = Context {};
}
