// Reject: zero does not establish the incoming record's domain.
data Payload { value: u64; }
data Coupled where count == payload.value && count >= 1 {
    payload: Payload;
    count: u64;
}
data Envelope { item: Coupled; }
machine replace(record: &mut Coupled, value: u64)
requires value >= 1
ensures record.count == value
{
    record.payload = Payload { value: value };
    record.count = value;
}
machine main() crashes Trap {
    let mut envelope: Envelope = Envelope { item: Coupled { payload: Payload { value: 0 }, count: 0 } };
    replace(&mut envelope.item, 11);
    transition envelope.item.count == 11 && envelope.item.payload.value == 11 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
