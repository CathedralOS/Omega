// Reject: a write through an alias retires the earlier field observation.
data Pair { left: u64; right: u64; }
machine consume(value: u64) requires value == 7 {}
machine overwrite(pair: &mut Pair) { pair.left = 9; }
machine exercise(pair: &mut Pair) {
    pair.left = 7;
    pair.right = 1;
    let alias: &mut Pair = pair;
    overwrite(alias);
    consume(pair.left);
}
machine main() {}
