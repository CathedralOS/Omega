// CASE-CONSTRAINTS match-contributed case facts (ch12): the `Range` arm
// contributes the authored `lo <= hi` on the exact subject -- not any
// bound, and not the mirrored `hi <= lo`. Forwarding the destructured
// bindings swapped leaves the target state's `requires` unproved.
data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { interval: Interval; }
machine Main::main(&mut self) {
    self.interval = Interval::Range { lo: 1, hi: 5 };
    transition self.interval {
        Interval::Range { lo, hi } -> take(hi, lo)
        Interval::Empty -> done()
    }
    state take(&mut self, lo: u64, hi: u64)
    requires
        lo <= hi
    {
    }
    state done(&mut self) { }
}
