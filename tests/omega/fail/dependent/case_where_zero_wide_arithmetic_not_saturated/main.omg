// Contract arithmetic is mathematical, not saturation of the checker's i64
// interval storage. At zero the left side is 2^63, not 2^63 - 1.
data Choice {
    case Selected(value: u64)
    where value + 9223372036854775807 + 1 <= 9223372036854775807;
    case Empty;
}
data Context { choice: Choice; }
machine main() {
    let context: Context = Context {};
}
