// FAIL CANARY. Copying an unbounded `i32` into a `cells_valid` cell does
// not restore the predicate. The proved set of the stored value is the
// whole carrier, so the element window stays open at state exit. A value
// proved to lie in 0..=1 does restore it
// (pass/dependent/collection_predicate_proved_element_store).

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }
    state at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }
    state at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }
    state at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
}

machine store_unbounded(context: &mut Main, bit: i32) {
    context.grid.board[0] = bit;
}

machine Main::main(context: &mut Main) {
    store_unbounded(context, 1);
}
