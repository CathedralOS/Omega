machine cite(values: &[i32], selected: u64)
requires selected < values.len
requires values[selected] >= 0 && values[selected] <= 255
ensures values[selected] >= 0 && values[selected] <= 255
{}

machine too_small(values: &[i32], selected: u64) -> i32
requires selected < values.len
requires values[selected] >= 0 && values[selected] <= 255
ensures result <= 255
{
    cite(values, selected);
    let observed: i32 = values[selected];
    transition { _ -> (observed + 1) }
}

machine changed_selector(values: &[i32], mut selected: u64) -> i32
requires values.len > 0 && selected < values.len
requires values[selected] >= 0 && values[selected] <= 255
ensures result <= 255
{
    cite(values, selected);
    selected = 0;
    transition { _ -> (values[selected]) }
}
