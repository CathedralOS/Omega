// CASE-CONSTRAINTS generic case-data coverage: `T == bool` refutes on
// `Value<i32>`, so `Boolean` is the impossible case here -- covering only it
// still leaves the possible `Integer` case uncovered.
data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}
data Main { v: Value<i32>; }
machine Main::main(&mut self) {
    self.v = Value::Integer { value: 5 };
    transition self.v {
        Value::Boolean { value } -> done()
    }
    state done(&mut self) {}
}
