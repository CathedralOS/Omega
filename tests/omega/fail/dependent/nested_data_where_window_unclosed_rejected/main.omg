// FAIL CANARY. self.map.start opens Map's window and the call cannot consume
// the enclosing machine while start=10/end=0 violates Map's default domain.
use omega::language::std::console;
data Map
where
    start <= end,
{
    start: i32;
    end: i32;
}
data Main { console: Console; map: Map; }
machine Main::main(&mut self) {
    self.map.start = 10;
    self.console.exit_process(70);
}
