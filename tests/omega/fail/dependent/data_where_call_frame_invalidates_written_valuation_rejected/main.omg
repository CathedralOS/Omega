// FAIL CANARY (R5 default-domain frame soundness): the sibling call replaces
// main.pair, so the predecessor's right == 20 valuation cannot survive it.
// Writing left = 15 afterward is not proven to restore left <= right.
data Pair
where
    left <= right,
{
    left: i32;
    right: i32;
}

data Main {
    pair: Pair;
}

machine Main::main(main: &mut Main) {
    main.pair.right = 20;
    transition { _ -> update(main) }

    state update(main: &mut Main) {
        Main::replace_pair(main);
        main.pair.left = 15;
    }
}

machine Main::replace_pair(main: &mut Main) {
    main.pair = Pair { left: 0, right: 5 };
}
