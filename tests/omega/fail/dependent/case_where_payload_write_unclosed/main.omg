// CASE-CONSTRAINTS stale facts: a payload store leaving `lo <= hi` FALSE
// opens an invariant window on `self.interval`. A scalar field read while
// the window is open is legal (it cannot observe the case coupling), but a
// call is a consumption point -- the broken `Range` constraint may not
// escape through it.
data Interval {
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { interval: Interval; }
machine Main::main(&mut self) {
    self.interval = Interval::Range { lo: 1, hi: 5 };
    self.interval.hi = 0;
    self.helper();
    state helper(&mut self) { }
}
