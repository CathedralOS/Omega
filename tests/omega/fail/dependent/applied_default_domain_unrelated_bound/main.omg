data Counter<const Limit: u64> where count <= Limit { count: u64; }

machine Counter::set<const Bound: u64, const Ceiling: u64>(
    counter: &mut Counter<Bound>, value: u64
)
requires value <= Ceiling
{
    counter.count = value;
}

// Source checking owes the schematic body even without a concrete call.
machine main() {}
