// The outer record has storage, but its qualified child excludes zero.
// Looking through that child's qualification for field geometry cannot
// establish the child or authorize an observation of its zeroed payload.
data Guarded [copy] { code: i32; }
domain Guarded::Positive(value) requires value.code > 0;
domain Guarded::PositiveAlias = Positive;
domain Guarded::Issued established by Guarded::issue;
domain Guarded::IssuedAlias = Issued;
machine Guarded::issue() -> Guarded ensures result in Guarded::Issued {
    Guarded { code: 1 }
}
data Envelope { guarded: Guarded in Guarded::Positive; }
data GenericEnvelope<T> { guarded: T; }
data MixedApplications {
    first: GenericEnvelope<i32>;
    guarded: GenericEnvelope<Guarded in Guarded::Positive>;
}
data ReversedApplications {
    guarded: GenericEnvelope<Guarded in Guarded::Positive>;
    first: GenericEnvelope<i32>;
}
data RoutedEnvelope { guarded: Guarded in Guarded::IssuedAlias; }
data FloatingEnvelope { value: f64[0.25..=0.5]; }
data ExclusiveFloatingEnvelope { value: f32[-0.5..0.0]; }

machine untouched() {}
machine observe(envelope: &Envelope) -> i32 { envelope.guarded.code }

machine main() {
    let envelope: Envelope;
    let observed: i32 = envelope.guarded.code;
    let after_call: Envelope;
    untouched();
    let observed_after_call: i32 = after_call.guarded.code;
    let generic: GenericEnvelope<Guarded in Guarded::Positive>;
    let observed_generic: i32 = generic.guarded.code;
    let mixed: MixedApplications;
    let observed_mixed: i32 = mixed.guarded.guarded.code;
    let reversed: ReversedApplications;
    let observed_reversed: i32 = reversed.guarded.guarded.code;
    let via_helper: Envelope;
    let observed_helper: i32 = observe(&via_helper);
    let floating: FloatingEnvelope;
    let observed_floating: f64 = floating.value;
    let alias: GenericEnvelope<Guarded in Guarded::PositiveAlias>;
    let observed_alias: i32 = alias.guarded.code;
    let routed: RoutedEnvelope;
    let observed_routed: i32 = routed.guarded.code;
    let exclusive: ExclusiveFloatingEnvelope;
    let observed_exclusive: f32 = exclusive.value;
}
