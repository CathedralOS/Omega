machine valid_values(values: &[i32]) -> bool { check_values(values, values.len) }
machine check_values(values: &[i32], remaining: u64) -> bool
requires remaining <= values.len
terminates;
terminates by remaining in 0..=values.len;
{
    transition remaining > 0 { true -> inspect(values, remaining) false -> (true) }
    machine inspect(values: &[i32], remaining: u64) -> bool
    requires remaining > 0 && remaining <= values.len
    {
        let selected: u64 = remaining - 1;
        transition values[selected] >= 0 && values[selected] <= 255 {
            true -> check_values(values, selected)
            false -> (false)
        }
    }
}
machine bad_replacement(values: &mut [i32], selected: u64)
requires selected < values.len
requires valid_values(values) == true
ensures valid_values(values) == true
{ values[selected] = 300; }

machine no_prior_predicate(values: &mut [i32], selected: u64)
requires selected < values.len
ensures valid_values(values) == true
{ values[selected] = 40; }

machine wrong_collection(values: &mut [i32], checked: &[i32], selected: u64)
requires selected < values.len
requires valid_values(checked) == true
ensures valid_values(values) == true
{ values[selected] = 40; }

machine partial_restoration(values: &mut [i32])
requires values.len >= 2
requires valid_values(values) == true
ensures valid_values(values) == true
{
    values[0] = 300;
    values[1] = 40;
}

// Even a valid byte can break a relation between coordinates. Preservation
// follows from the actual predicate, never from element bounds alone.
machine paired(values: &[i32]) -> bool {
    transition values.len == 2 { true -> compare(values) false -> (true) }
    machine compare(values: &[i32]) -> bool
    requires values.len == 2
    { transition { _ -> (values[0] == values[1]) } }
}
machine breaks_pair(values: &mut [i32])
requires values.len == 2
requires paired(values) == true
ensures paired(values) == true
{ values[0] = 1; }

// An unprojected state requirement still needs its own checked arrival.
machine bad_arrival(values: &mut [i32], spoil: bool)
requires values.len > 0
requires valid_values(values) == true
{
    transition spoil { true -> corrupt(values) false -> consume(values) }
    machine corrupt(values: &mut [i32])
    requires values.len > 0
    requires valid_values(values) == true
    {
        values[0] = 300;
        transition { _ -> consume(values) }
    }
    machine consume(values: &mut [i32])
    requires valid_values(values) == true
    {}
}
