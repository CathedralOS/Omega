// CASE-CONSTRAINTS coverage through established contradictions, open side:
// only a constraint the instance REFUTES may drop a case from coverage.
// `Range`'s `lo <= hi` is undecidable at coverage time on `Window<i32>` --
// it depends on runtime payload values -- so `Range` stays a possible case
// and an arm set naming only `Empty` is non-exhaustive. The decided sibling
// is `pass/dependent/case_where_generic_type_bound_coverage`, where the
// refuted `T == i32` fact drops `Integer` on `Value<bool>`.
data Window<T> {
    marker: T;
    case Empty;
    case Range(lo: u64, hi: u64) where lo <= hi;
}
data Main { window: Window<i32>; }
machine Main::main(&mut self) {
    self.window = Window::Empty { marker: 0 };
    transition self.window {
        Window::Empty -> done()
    }
    state done(&mut self) {}
}
