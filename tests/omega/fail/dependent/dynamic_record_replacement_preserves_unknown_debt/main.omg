data Cell where left == right, { left: i32; right: i32; }
data Grid { cells: [Cell; 2]; }
domain u64::Positive(value) requires 1 <= value;
data Gated { value: u64 in Positive; }

machine existing_debt(debt: &mut Grid, index: u64) requires index < 2 {
    debt.cells[0].left = 1;
    debt.cells[index] = Cell { left: 2, right: 2 };
}

machine stale_snapshot(stale: &mut Grid, index: u64) requires index < 2 {
    stale.cells[0] = Cell { left: 1, right: 1 };
    stale.cells[index] = Cell { left: 2, right: 2 };
    stale.cells[0].left = 1;
}

machine transported_snapshot(transport: &mut Grid, index: u64) requires index < 2 {
    transport.cells[0] = Cell { left: 1, right: 1 };
    transition { _ -> finish(transport, index) }
    machine finish(transport: &mut Grid, index: u64) requires index < 2 {
        transport.cells[index] = Cell { left: 2, right: 2 };
        transport.cells[0].left = 1;
    }
}

machine missing_elements(index: u64) requires index < 2 {
    let mut raw: [Gated; 2];
    raw[index] = Gated { value: 42 };
    let observed: u64 = raw[0].value;
}
