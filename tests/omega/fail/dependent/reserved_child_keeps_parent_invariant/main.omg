domain u64::Positive requires 1 <= self;
data Token { value: u64 in Positive; }
data Coupled<T> where start <= end, { value: T; start: i32; end: i32; }
machine inspect(holder: &Coupled<Token>) -> u64 { holder.value.value }
machine main() { let mut holder: Coupled<Token>; holder.start = 10; holder.value = Token { value: 42 }; let observed: u64 = inspect(&holder); }

machine invalidated() {
    let mut established: Coupled<Token> = Coupled {
        value: Token { value: 42 }, start: 0, end: 0
    };
    established.start = 10;
    established.value = Token { value: 42 };
    let observed: u64 = inspect(&established);
}
