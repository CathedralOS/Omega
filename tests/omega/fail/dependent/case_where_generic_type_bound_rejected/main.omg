// CASE-CONSTRAINTS generic case-data synthesis: `T == i32` refutes on
// `Value<bool>`, so the instance's `Integer` case carries the literal-false
// witness and construction is the gate.
data Value<T> {
    case Integer(value: T) where T == i32;
    case Boolean(value: T) where T == bool;
}
data Main { v: Value<bool>; }
machine Main::main(&mut self) {
    self.v = Value::Integer { value: false };
}
