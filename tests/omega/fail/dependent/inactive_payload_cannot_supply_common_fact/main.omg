data Restricted [copy] where value <= 5 { value: u64; }
data Plain [copy] { value: u64; }
data Choice [copy] {
    case A(item: Restricted);
    case B(item: Plain);
}
machine need(value: u64) requires value <= 5 {}
machine inspect(choice: Choice) {
    transition choice {
        Choice::A { item } -> done()
        Choice::B { item } -> selected(item)
    }
    machine selected(item: Plain) { need(item.value); }
    machine done() {}
}
machine main() { inspect(Choice::B { item: Plain { value: 100 } }); }
