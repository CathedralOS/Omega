// FAIL CANARY. A caller that breaks a collection invariant cannot pass the
// broken storage to a callee: storing 2 into a cell opens a window on
// `context.grid`, and the call, a consumption point, rejects it. Terminal
// carries the same invariant as the callee's entry rows, which no caller
// store of 2 can discharge.

machine cells_valid(cells: &[i32; 4]) -> bool {
    transition cells[0] == 0 || cells[0] == 1 {
        true -> at_1(cells)
        _ -> (false)
    }

    machine at_1(cells: &[i32; 4]) -> bool {
        transition cells[1] == 0 || cells[1] == 1 {
            true -> at_2(cells)
            _ -> (false)
        }
    }

    machine at_2(cells: &[i32; 4]) -> bool {
        transition cells[2] == 0 || cells[2] == 1 {
            true -> at_3(cells)
            _ -> (false)
        }
    }

    machine at_3(cells: &[i32; 4]) -> bool {
        transition cells[3] == 0 || cells[3] == 1 {
            true -> (true)
            _ -> (false)
        }
    }
}

data Grid where cells_valid(&board) == true {
    board: [i32; 4];
}

data Main {
    grid: Grid;
}

machine Main::keep(context: &mut Main) {
    context.grid.board[0] = 1;
}

machine Main::main(context: &mut Main) {
    context.grid.board[1] = 2;
    Main::keep(context);
}
