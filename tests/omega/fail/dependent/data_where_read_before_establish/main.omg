// An entry bridge cannot lend zero storage as a valid Main: its Player
// field needs establishment. An ordinary incoming &mut Main would already
// satisfy the declared domains; qualification creates no storage exception.
data Player
where
    health >= 1,
{
    health: i32;
}
data Main { champion: Player; }
machine Main::main(main: &mut Main) {
    let strength: i32 = main.champion.health;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
