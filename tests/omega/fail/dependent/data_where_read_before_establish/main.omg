// Ordinary local zero storage cannot be borrowed as an established Main:
// its Player field excludes zero. An established incoming borrow still
// carries its declared domains independently of the caller's machine name.
data Player
where
    health >= 1,
{
    health: i32;
}
data Main { champion: Player; }
machine Main::main(main: &mut Main) {
    let strength: i32 = main.champion.health;
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
