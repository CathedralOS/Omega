// CASE-CONSTRAINTS generic case-data fence: a case `where` fact that names a
// TYPE parameter has no fact-position substitution on synthesized instances
// yet -- `T` would dangle on `Value<i32>::Integer`, so the template refuses
// rather than drop or mis-bind it. Facts over only the case's own payload
// names and `const` binders already ride instances.
data Value<T> {
    case Integer(value: T) where T == i32;
}
data Main { }
machine Main::main(&mut self) {
}
