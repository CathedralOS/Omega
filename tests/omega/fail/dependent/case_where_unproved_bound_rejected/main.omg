// CASE-CONSTRAINTS slice 1: UNKNOWN bounds are refused, not assumed --
// `lo <= hi` over runtime-valued fields cannot fold at construction, so
// the literal cannot prove the selected case's constraint.
data Interval 
    requires (self in Interval::Empty) || ((self in Interval::Range) && (self.lo <= self.hi))
{
    case Empty;
    case Range(lo: u64, hi: u64);
}
data Main { interval: Interval; lo: u64; hi: u64; }
machine Main::main(main: &mut Main) {
    main.interval = Interval::Range { lo: main.lo, hi: main.hi };
}
