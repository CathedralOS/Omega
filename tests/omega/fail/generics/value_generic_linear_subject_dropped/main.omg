// The realized trailing parameter of a runtime-bound `Value` binder is an
// ordinary owned argument, so a linear subject keeps its exact-once custody
// inside the body: `take` reads `V.id` but never transfers or consumes `V`
// itself, and the shared dynamic body must reject rather than silently erase
// the obligation.

data Token [linear] {
    id: u32;
}

machine take<V: Token>() -> u32 {
    V.id
}

machine Main::main(&mut self) {
    let t: Token = Token { id: 7 };
    let a: u32 = take<t>();
}
