use omega::language::core::float_operations;
data Observation [copy] { value: f64; }
trait Positive {
    machine calculate(value: f64) -> f64 requires value > 0.0;
}
Implementation satisfies Positive {
    machine calculate(value: f64) -> f64 { value }
}
machine wrap<Operations satisfies Positive>(value: f64) -> Observation {
    Observation { value: Positive::calculate<Operations>(value) }
}
machine main() { let result: Observation = wrap<Implementation>(0.25); }
