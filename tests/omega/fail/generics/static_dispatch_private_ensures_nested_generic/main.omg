// A realization's private ensures never becomes the caller's guarantee.
trait Pick { machine pick(left: i32, right: i32) -> i32; }
Seven satisfies Pick {
    machine pick(left: i32, right: i32) -> i32 ensures result == 7 { 7 }
}
machine choose<Implementation satisfies Pick>(left: i32, right: i32) -> i32 {
    Implementation::pick(left, right)
}
machine relay<Inner satisfies Pick>() -> i32 { choose<Inner>(1, 2) }
machine hold(picked: i32) -> bool
requires picked == 7
{ true }
machine main() crashes Trap {
    let picked: i32 = relay<Seven>();
    transition hold(picked) { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
