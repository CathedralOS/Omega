// Scalar and aggregate const field arguments retain their separate carriers.
use omega_language_std::console;
data Configuration [copy] { minimum: u64; }
data Chosen<const Setting: Configuration> {}
data Gate<const Number: u64> where Number == 0 { code: u8; }
data Holder {
    gate: Gate<0>;
    selected: Chosen<(Configuration { minimum: true })>;
}
machine main() reaches Console {
    let holder: Holder;
    Console::exit_process(holder.gate.code as i32);
}
