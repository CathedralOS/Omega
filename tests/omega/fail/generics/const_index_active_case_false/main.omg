data Choice [copy] 
    requires (self in Choice::Empty) || ((self in Choice::Point) && (self.value <= 60))
{ case Empty; case Point(value: i32); }
const POINT: Choice = Choice::Point { value: 61 };
machine select<const VALUE: Choice>() -> i32 { 0 }
machine main() { let result: i32 = select<POINT>(); }
