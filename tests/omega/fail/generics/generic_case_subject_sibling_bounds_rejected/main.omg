// Expected exit: 0
// Sibling applications have identical payload layouts but different case facts.
data Mark<const Limit: u64> [copy] {
    case Value(value: u64) where value <= Limit;
    case Empty;
}
const LIMIT: u64 = 100;
const EMPTY: Mark<LIMIT> = Mark::Empty;
machine narrow() -> Mark<LIMIT> { Mark::Value { value: 7 } }
machine broad() -> Mark<200> { Mark::Value { value: 71 } }
machine observe(selected: &Mark<LIMIT>) -> u64
ensures result <= 10
{
    transition selected {
        Mark::Value { value } -> value
        Mark::Empty -> 0
    }
}
machine observe_broad() -> u64
ensures result <= 200
{
    transition broad() {
        Mark::Value { value } -> value
        Mark::Empty -> 0
    }
}
machine observe_empty() -> u64 {
    transition EMPTY in Mark::Empty { true -> 0 _ -> 1 }
}
machine main() crashes Trap {
    let selected: Mark<LIMIT> = narrow();
    transition observe(&selected) == 7 && observe_broad() == 71 && observe_empty() == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
