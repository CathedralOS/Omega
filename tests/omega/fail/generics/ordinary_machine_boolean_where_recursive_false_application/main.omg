// The caller's Flag==true hypothesis belongs to the original invocation.
// It cannot establish countdown<false>'s separately substituted predicate.
// The recursive tail edge strictly decreases remaining under remaining>0.
data Main { value: u64; }

machine countdown<const Flag: bool>(remaining: u64) -> u64
where Flag == true
terminates by remaining -> Nat::Descending;
{
    transition remaining > 0 {
        true -> (countdown<false>(remaining - 1))
        false -> 7
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    let result: u64 = countdown<true>(2);
    transition result == 7 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
