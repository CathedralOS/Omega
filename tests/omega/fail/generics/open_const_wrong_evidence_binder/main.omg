// Expected exit: 0
trait Reading<const Minimum: u64> {
    machine read() -> u64 ensures result >= Minimum;
}
Selected<const Value: u64> satisfies Reading<Value> {
    machine read() -> u64 ensures result == Value { Value }
}
machine selected<const Low: u64, const High: u64, First satisfies Reading<Low>, Second satisfies Reading<High>>() -> u64
ensures result >= High
{ First::read() }
const VALUE: u64 = selected<3, 7, Selected<3>, Selected<7>>();
machine main() crashes Trap {
    let value: u64 = VALUE;
    let difference: u64 = value - 7;
    transition difference == 0 { true -> done() _ -> bad() }
    machine done() {} machine bad() { crash Trap; }
}
