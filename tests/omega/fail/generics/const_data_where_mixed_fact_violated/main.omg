// A default-domain fact mixing a runtime field and a const parameter remains
// on the concrete record after the const operand is substituted.
data FixedBuffer<const N: u64>
where
    used <= N,
{
    used: u64;
    values: [u8; N];
}

data Main {
    buffer: FixedBuffer<4>;
}

machine Main::main(&mut self) {
    self.buffer.used = 5;
}
