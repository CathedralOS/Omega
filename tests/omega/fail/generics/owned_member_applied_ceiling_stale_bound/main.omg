// A selected generic member's substituted mutable carrier still invalidates
// the caller's pre-call lower bound; the numeric-carrier repair cannot erase it.
trait Change<Value> { machine replace(destination: &mut Value, value: Value); }
Selected<Value, Role> satisfies Change<Value> {
    machine replace(destination: &mut Value, value: Value) { destination = value; }
}
machine wrong(value: &mut u64) -> u64
requires value >= 1
{
    Selected<u64, u8>::replace(value, 0);
    value - 1
}
