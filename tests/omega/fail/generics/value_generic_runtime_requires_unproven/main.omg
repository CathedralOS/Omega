// A contract fact that mentions a runtime-bound `Value` binder denotes the
// realized trailing parameter: the rewritten call owes the requirement on
// its captured subject. Reassignment replaces that subject, so the stale
// initializer's proof cannot stand in for the current value.

machine bounded<Count: u32>(base: u32) -> u32
requires
    Count <= 10;
{
    Count
}

machine Main::main(&mut self) {
    let mut n: u32 = 3;
    n = 99;
    let late: u32 = bounded<n>(7);
}
