// An explicit destination cannot replace the selected map's u64 result.
data Envelope<T> { case Payload(value: T); }
trait Creator<Value> { machine make(value: Value) -> Envelope<Value>; }
Make<T, Role> satisfies Creator<T> {
    machine make(value: T) -> Envelope<T> { Envelope::Payload { value: value } }
}
machine forward<Role>(value: u64) -> bool {
    let result: Envelope<bool> = Make<u64, Role>::make(value);
    transition result { Envelope::Payload { value } -> value }
}
machine main() { let observed: bool = forward<u8>(37); }
