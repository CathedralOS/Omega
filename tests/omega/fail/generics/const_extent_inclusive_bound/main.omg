// `index <= Count` includes the one-past-end position. That comparison must
// not prove an element read.
data Row<const Count: u64> { values: [i64 in Wrapping; Count]; }
machine read<const Count: u64>(row: &Row<Count>, index: u64) -> i64 in Wrapping {
    transition index <= Count { true -> take(row, index) _ -> (0) }
    state take(row: &Row<Count>, index: u64) -> i64 in Wrapping { row.values[index] }
}
machine main() crashes Trap {
    let mut row: Row<2>;
    row.values[0] = 1;
    row.values[1] = 2;
    let value: i64 in Wrapping = read<2>(&row, 2);
    transition value == 0 { true -> done() _ -> done() }
    state done() {}
}
