machine build(builder: &mut Build) {
    Build::application(builder, "closed_requirement_mutable_argument_stale_entry");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::accept_boundary<Reading>(builder);
    Build::select_provider<Reading, ReadingImplementation>(builder, windows_x86_64);
    Build::select_provider<Reading, ReadingImplementation>(builder, linux_x86_64);
    Build::select_provider<Reading, ReadingImplementation>(builder, macos_arm64);
    Build::select_provider<Reading, ReadingImplementation>(builder, linux_arm64);
}
