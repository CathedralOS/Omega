data Holder<'held> { reference: &'held u64; }

machine pick<'call>(context: Holder<'call>, item: &'call u64) -> &'call u64 {
    context.reference
}

machine apply<Context, machine Callback>(context: Context, item: &u64) -> &u64
requires machine Callback<'call>(context: Context, item: &'call u64) -> &'call u64;
{ Callback(context, item) }

machine relay<'call>(context: Holder<'call>, item: &'call u64) -> &'call u64 {
    apply<Holder<'call>, pick>(context, item)
}

machine main() {}
