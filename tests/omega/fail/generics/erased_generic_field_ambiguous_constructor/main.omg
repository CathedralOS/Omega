// A receiving application does not select an erased constructor.
data Evidence { case First; case Second; }
data Mixed<T> {
    common: T;
    proof [erased]: Evidence;
    case Some(value: T, case_proof [erased]: Evidence);
}
data Main { value: Mixed<u64>; }
machine Main::main(main: &mut Main) {
    main.value = Mixed::Some { common: 7, value: 63 };
}
