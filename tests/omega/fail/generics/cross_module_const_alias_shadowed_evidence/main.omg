// A cross-module const alias keeps its exporting declaration as a callable,
// premise and implementation argument. The consumer's same-spelled `MARKER`
// is 3, so selecting it would refute `Marker == 7`, trap the body result, and
// leave `- 7` unproved.
// Expected: rejected; one argument names the local MARKER (3), not the alias.
use values::ALIAS;
const MARKER: u64 = 3;

machine premise(kept: bool) -> bool { true }

machine witness<const Marker: u64>(kept: bool) -> bool
requires premise(kept)
requires Marker == 7
{
    Marker == 7
}

machine apply<machine Observe>(kept: bool) -> bool
requires machine Observe(kept: bool) -> bool
requires premise(kept);
requires premise(kept)
{
    Observe(kept)
}

trait Reading<const Minimum: u64> {
    machine read() -> u64 ensures result >= Minimum;
}

Selected<const Value: u64> satisfies Reading<Value> {
    machine read() -> u64 ensures result == Value { Value }
}

machine selected<const Minimum: u64, Implementation satisfies Reading<Minimum>>() -> u64
ensures result >= Minimum
{ Implementation::read() }

machine read_seven<machine Callback>() -> u64
requires machine Callback() -> u64 ensures result >= 7;
{ Callback() }

const INITIALIZED: bool = apply<witness<ALIAS>>(true);

machine main() crashes Trap {
    let observed: bool = apply<witness<ALIAS>>(true);
    let direct: u64 = selected<ALIAS, Selected<MARKER>>();
    let applied: u64 = read_seven<selected<ALIAS, Selected<ALIAS>>>();
    let direct_rest: u64 = direct - 7;
    let applied_rest: u64 = applied - 7;
    transition observed && INITIALIZED && direct_rest == 0 && applied_rest == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
