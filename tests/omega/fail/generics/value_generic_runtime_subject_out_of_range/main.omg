// A runtime subject bound to a ranged `Value` carrier stores into the realized
// trailing parameter, and that store enforces the declared range: a `u32[0..=20]`
// argument cannot prove `<= 10`, so the call must reject until a dominating
// guard or narrower dependent bound establishes it.

machine ident<Count: u32[0..=10]>() -> u32 {
    Count
}

machine helper(n: u32[0..=20]) -> u32 {
    ident<n>()
}

machine Main::main(&mut self) {
    let n: u32 = 4;
    let a: u32 = helper(n);
}
