machine step<const Degree: u64>(base: i64 in Wrapping) -> i64 in Wrapping { base }
machine main() crashes Trap {
    let degree: u64 = 1;
    let value: i64 in Wrapping = step<degree - 1>(10);
    transition value == 10 { true -> done() _ -> bad() }
    state done() { }
    state bad() { crash Trap; }
}
