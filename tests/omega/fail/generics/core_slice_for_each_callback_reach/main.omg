use omega::language::core::iteration;

data Item { value: u32; }

boundary trait Output {
    machine write() reaches Output;
}

machine effectful(item: &mut Item)
satisfies ElementStep<Item>::apply
reaches Output invokes Output; {
    Output::write();
}

machine main() {
    let mut items: [Item; 1];
    for_each<Item, effectful>(&mut items[..]);
}