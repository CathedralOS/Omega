trait Updating {machine update(slot:&mut u32);}
Updater satisfies Updating {machine update(slot:&mut u32) {slot=9;}}
machine one(value:u32) requires value==1 {}
machine probe<Operations satisfies Updating>() {let mut slot:u32=1; Operations::update(&mut slot); one(slot);}
machine main() {probe<Updater>();}
