use models;
use other;
machine capacity<Payload>() -> u64
where Payload == models::Token
{ 7 }
data Main { result: u64; }
machine main(main: &mut Main) { main.result = capacity<other::Token>(); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
