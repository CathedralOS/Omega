data Holder<'held> { reference: &'held u64; }

machine pick<'call, Context>(context: Context, item: &'call u64) -> &'call u64 { item }

machine apply<'item, Context, machine Callback>(context: Context, item: &'item u64) -> &'item u64
requires machine Callback<'call>(context: Context, item: &'call u64) -> &'call u64;
{ Callback(context, item) }

machine relay<'call>(context: Holder<'call>, item: &'call u64) -> &'call u64 {
    apply<Holder<'call>, pick<Holder<'call>>>(context, item)
}

machine main() -> u64 {
    let left: u64 = 17u64;
    let mut right: u64 = 42u64;
    let context: Holder = Holder { reference: &left };
    let result: &u64 = relay(context, &right);
    right = 99u64;
    result
}
