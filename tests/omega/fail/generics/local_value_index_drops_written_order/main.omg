// A local dependent type cannot reuse an ordering invalidated by a write.
data View<'storage> [copy] { bytes: &'storage [u8]; }
data Counted<'storage, Count: u64> [copy] where view.bytes.len == Count { view: View<'storage>; }
machine invalid<'storage>(source: View<'storage>, mut start: u64, end: u64)
requires start <= end && end == 7 && source.bytes.len == 7
{
    start = 9;
    let value: Counted<'storage, (end - start)> = Counted { view: source };
}
machine main() {
    invalid(View { bytes: "1234567" }, 2, 7);
}
