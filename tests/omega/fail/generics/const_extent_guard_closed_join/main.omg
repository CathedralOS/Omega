machine read(values: &[i64 in Wrapping; 0], enabled: bool) -> i64 in Wrapping {
 transition enabled { true -> selected(values) _ -> maybe(values) }
 machine maybe(values: &[i64 in Wrapping; 0]) -> i64 in Wrapping { transition 0u64 > 0u64 { true -> selected(values) _ -> (0) } }
 machine selected(values: &[i64 in Wrapping; 0]) -> i64 in Wrapping { values[0] }
}
