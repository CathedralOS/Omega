machine first<const Count: u64>(moments: &[i64 in Wrapping; Count],enabled: bool) -> i64 in Wrapping { transition enabled { true -> read(moments) _ -> checked(moments) } machine checked(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping { transition Count > 0 { true -> read(moments) _ -> (0) } } machine read(moments: &[i64 in Wrapping; Count]) -> i64 in Wrapping { moments[0] } }
machine main() { let moments: [i64 in Wrapping; 5]; let value: i64 in Wrapping = first<5>(&moments,false); }
