// A callback whose published result violates the inferred complete contract must reject.
public machine typed<Item, const Callback: machine(value: Item) -> Item>(value: Item) -> Item {
    Callback(value)
}
public machine generic_forward<Value, const Selected: machine>(value: Value) -> Value {
    nested(value)
    machine nested(value: Value) -> Value {
        typed<Value, Selected>(value)
    }
}
public machine identity(value: u32) -> u32 { value }

public machine origin<
    const Callback: machine(value: u32) -> u32
        requires value == 37u32
        ensures result == value
        terminates
>(value: u32) -> u32
requires value == 37u32
ensures result == value
terminates {
    Callback(value)
}
public machine forward<const Selected: machine>(value: u32) -> u32
requires value == 37u32
ensures result == value
terminates {
    relay<Selected>(value)
}
public machine relay<const Renamed: machine>(value: u32) -> u32
requires value == 37u32
ensures result == value
terminates {
    let first: u32 = origin<Renamed>(value);
    origin<Renamed>(first)
}
public machine selected(value: u32) -> u32
requires value == 37u32
ensures result == 38u32
terminates { 38u32 }

machine main() crashes Trap {
    let generic: u32 = generic_forward<u32, identity>(43u32);
    let answer: u32 = forward<selected>(37u32);
    transition generic == 43u32 && answer == 37u32 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
