// `advance` promises `result <= 18`. That is true of the only use this program
// makes, `advance<Shift>`, because `Shift::apply` returns at most 17. It is
// not true of `advance` as declared: `Step::apply` promises only
// `result <= 20`, so the body can return 21. A generic body is checked against
// its requirement's contract, and one caller's selection cannot make it valid.
// The run twin `run/generics/implementation_parameter_contract` promises
// `result <= 21` and also selects `Double`.
trait Step {
    machine apply(value: u32) -> u32
    requires value <= 10
    ensures result <= 20
    crashes none;
}
Shift satisfies Step {
    machine apply(value: u32) -> u32
    requires value <= 12
    ensures result <= 17
    crashes none
    {
        value + 5
    }
}
machine advance<Selected satisfies Step>(start: u32) -> u32
requires start <= 10
ensures result <= 18
crashes none
{
    Selected::apply(start) + 1
}
machine main() crashes Trap {
    let shifted: u32 = advance<Shift>(4);
    transition shifted == 10 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
