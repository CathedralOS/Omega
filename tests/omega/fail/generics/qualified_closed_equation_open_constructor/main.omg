use models::Token;
machine recovered<const Count: u64, Payload>() -> u64
where Payload == models::Token
{ Count }
data Main { result: u64; }
machine main(main: &mut Main) { main.result = recovered<4>(); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
