// Expected exit: 0
data Indexed<Limit: u32> [copy] { value: u32; }
machine receive(limit: u32, item: Indexed<limit>) -> u32 { item.Limit }
machine forward(mut limit: u32, item: Indexed<limit>) -> u32 { let captured: u32 = limit; limit = 13; receive(limit, item) }
machine main() crashes Trap {
    let item: Indexed<7> = Indexed { value: 1 };
    let selected: u32 = forward(7, item);
    transition selected == 7 { true -> done() false -> wrong() }
    machine done() {} machine wrong() { crash Trap; }
}
