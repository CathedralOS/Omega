data Heavy { code: u64; }

machine accepts<Kind [copy]>(value: &Kind) -> bool { true }

machine apply<const Count: u64, machine Callback>(value: &[Heavy; Count]) -> bool
requires machine Callback(value: &[Heavy; Count]) -> bool;
{ Callback(value) }

machine relay<const Count: u64>(value: &[Heavy; Count]) -> bool {
    apply<Count, accepts>(value)
}

machine main() {}
