data Mode<const Inner: u32> [copy] { value: u64; }

machine capacity<Payload, const Count: i32>() -> i32
where Payload == Mode<Count>
{ Count }

data Main { result: i32; }

machine main(main: &mut Main) crashes Trap {
    main.result = capacity<Mode<4>>();
    transition main.result == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
