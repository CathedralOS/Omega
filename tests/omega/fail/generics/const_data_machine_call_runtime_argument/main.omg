// A local type's closed-call probe must use its original lexical bindings.
// The runtime local shadows the constant and cannot become a static argument.
const count: u64 = 4;

machine length(value: u64) -> u64 { value }

data Buffer<const Capacity: u64> {
    slots: [u8; Capacity];
}

machine main() {
    let count: u64 = 3;
    let buffer: Buffer<length(count)> = Buffer {};
}
