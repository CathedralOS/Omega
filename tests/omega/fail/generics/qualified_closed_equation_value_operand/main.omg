use models::COUNT;
machine capacity<Payload>() -> u64
where Payload == models::COUNT
{ 7 }
data Main { result: u64; }
machine main(main: &mut Main) { main.result = capacity<u64>(); }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
