// Must reject: an explicit conflicting application is not reselected by
// changing the producer's body or proving its destination obligations.
data Box<Value> { value: u64; }

machine empty<Value>() -> Box<Value> { Box { value: 0 } }
machine identity<Value>(value: Value) -> Value { value }
machine observe(value: &Box<u64>) -> u64 { value.value }

machine main() crashes Trap {
    let mut values: [Box<u64>; 2];
    values[0] = identity<Box<u32>>(empty());
    values[1] = identity<Box<u64>>(empty());
    let borrowed: u64 = observe(&empty());
    transition values[0].value == 0 && values[1].value == 0 && borrowed == 0 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
