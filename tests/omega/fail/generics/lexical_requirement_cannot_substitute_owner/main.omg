// Intended rejection.
// Member-local Units=7 is independent of the outer Units=3.
data Units {}
const Counts::THREE: u64 = 3;
trait Bounded<const Units: u64> {
    machine value<const Units: u64>(input: u64) -> u64
    requires input <= Units
    ensures result <= Units;
}
Selected<const Outer: u64> satisfies Bounded<Outer> {
    machine value<const Units: u64>(input: u64) -> u64
    requires input <= Units && input <= Outer
    ensures result <= Units
    { input }
}
machine selected<Implementation satisfies Bounded<Counts::THREE>>() -> u64
ensures result <= 7
{ Implementation::value<7>(0) }
machine main() crashes Trap {
    let value: u64 = selected<Selected<3>>();
    let difference: u64 = 7u64 - value;
    transition difference == 7 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
