trait Operations<Value> {
    machine put(destination: &mut Value, value: Value, count: u64)
        requires count > 0;
}
Selected<Value, const Captured: u64> satisfies Operations<Value> {
    machine put(destination: &mut Value, value: Value, count: u64) {
        destination = value;
    }
}
machine main() {
    let mut destination: u64 = 0;
    Selected<u64, 31>::put(&mut destination, 17u64, 0u64);
}
