// Expected exit: 0
trait Flags {
 machine choose<const Flag:bool>(ignored:u32)->bool ensures result == Flag;
}
Direct satisfies Flags {
 machine choose<const Flag:bool>(ignored:u32)->bool ensures result == Flag { Flag }
}
machine need_true(value:bool) requires value == true {}
machine need_false(value:bool) requires value == false {}
machine main() crashes Trap {
 let first:bool=Direct::choose<true>(0);
 let second:bool=Direct::choose<false>(0);
 need_true(first);
 need_true(second);
 transition first && !second {true->done() _->bad()}
 machine done(){} machine bad(){crash Trap;}
}
