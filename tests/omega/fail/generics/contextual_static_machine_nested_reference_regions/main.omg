machine collapsed<'outer, 'inner>(value: &'outer &'outer u64) -> u64 { 0u64 }

machine apply<'one, 'two, machine Callback>(value: &'one &'two u64) -> u64
requires machine Callback<'first, 'second>(value: &'first &'second u64) -> u64;
{ Callback(value) }

machine relay<'one, 'two>(value: &'one &'two u64) -> u64 {
    apply<collapsed>(value)
}

machine main() {}
