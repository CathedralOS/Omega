machine accepts<Kind, const Unused: u64>(value: &Kind) -> bool { true }

machine apply<const Count: u64, machine Callback>(value: &[u8; Count]) -> bool
requires machine Callback(value: &[u8; Count]) -> bool;
{ Callback(value) }

machine relay<const Count: u64>(value: &[u8; Count]) -> bool {
    apply<Count, accepts>(value)
}

machine main() {}
