trait Probe<Kind> { machine probe(value: &Kind) -> bool; }

machine probe<Kind, Evidence satisfies Probe<Kind>>(value: &Kind) -> bool {
    Probe::probe<Kind, Evidence>(value)
}

machine apply<Kind, machine Callback>(value: &Kind) -> bool
requires machine Callback(value: &Kind) -> bool;
{ Callback(value) }

machine relay<Kind, Evidence satisfies Probe<bool>>(value: &Kind) -> bool {
    apply<Kind, probe<Kind, Evidence>>(value)
}

machine main() {}
