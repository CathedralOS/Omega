data Marker<'held> { value: u64; }

machine pick<'call>(context: Marker<'call>) -> u64 { context.value }

machine apply<Context, machine Callback>(context: Context) -> u64
requires machine Callback<'fresh>(context: Context) -> u64;
{ Callback(context) }

machine relay<'call>(context: Marker<'call>) -> u64 {
    apply<Marker<'call>, pick>(context)
}

machine main() {}
