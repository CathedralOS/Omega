// A generic body checks each admitted alternative under its own type
// equation, so the `T == u64` alternative's `width(result)` is `width(u64)`.
// Each specialization keeps that selection rather than re-selecting the
// alternative its own type makes statically false.
// Expected: rejected; width(u64) is 64, so the u64 alternative cannot hold.
machine width(value: u32) -> u32 { value - value + 32u32 }
machine width(value: u64) -> u32 { ((value - value) as u32) + 64u32 }

machine pick<T>() -> T
requires T == u32 || T == u64
ensures (T == u32 && width(result) == 32u32) || (T == u64 && width(result) == 32u32)
{
    transition T == u32 {
        true -> (7u32)
        _ -> (7u64)
    }
}

machine main() crashes Trap {
    let narrow: u32 = pick<u32>();
    let wide: u64 = pick<u64>();
    transition narrow == 7u32 && wide == 7u64 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
