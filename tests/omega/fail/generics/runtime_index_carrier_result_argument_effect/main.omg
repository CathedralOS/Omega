data Indexed<Limit:u32>{value:u32;}
machine change(slot:&mut u32)->u32 { slot=13; 0 }
machine create(first:u32,limit:u32)->Indexed<limit> { Indexed{value:31} }
machine preserve()->u32 { let mut limit:u32=7; let saved:u32=limit; let item:Indexed<saved> = create(change(&mut limit),limit); item.value }
