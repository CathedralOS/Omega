use models::MAX;
data Check<const Count: u64> [copy]
where models::MAX + 1 == 256
{ value: u64; }
data Main { check: Check<4>; }
machine main(main: &mut Main) { main.check.value = 19; }

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
