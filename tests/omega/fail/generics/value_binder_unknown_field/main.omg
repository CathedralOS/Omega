// A dotted static argument is a runtime field only when that field exists on
// a local or parameter. An unknown member stays an evidence projection and
// cannot select the value binder.

data Held { count: u32; }

machine read_at<Index: u32>(items: &[u8]) -> u8
requires Index < items.len;
{
    items[Index]
}

machine main() {
    let bytes: [u8; 1] = [1];
    let held: Held = Held { count: 0 };
    let value: u8 = read_at<held.missing>(&bytes[..]);
    value
}
