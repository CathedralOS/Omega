data Extraction<Value> { case Moved(value: Value); case Empty; }
machine unpack<Value>(result: Extraction<Value>, fallback: Value) -> Value {
    transition result in Extraction::Empty {
        true -> result.value
        false -> fallback
    }
}
machine main(result: Extraction<u64>) -> u64 { unpack<u64>(result, 0) }
