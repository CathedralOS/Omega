// Expected exit: 0
data View<'storage> [copy] { bytes: &'storage [u8]; sibling: &'storage [u8]; }
machine overwrite<'storage>(slot: &mut View<'storage>, replacement: &'storage [u8]) -> u64 { slot.bytes = replacement; 0 }
data Counted<'storage, Count: u64> [copy]
where view.bytes.len == Count
{ view: View<'storage>; }
machine snapshot<'storage>(source: View<'storage>) -> Counted<'storage, (source.bytes.len)>
{ Counted { Count: 9, view: source } }
machine receive<'storage>(selected: Counted<'storage, 7>, ignored: u64) -> u64
requires selected.view.bytes.len == 7
ensures result == 7
{ selected.view.bytes.len }
machine main() crashes Trap {
    let storage: [u8; 7] = [49, 50, 51, 52, 53, 54, 55];
    let mut original: View = View { bytes: &storage[..], sibling: "tail" };
    let observed: u64 = receive(snapshot(original), overwrite(&mut original, "123456789"));
    let difference: u64 = observed - 7;
    transition difference == 0 && original.bytes.len == 9 && original.sibling.len == 4 {
        true -> done() false -> wrong()
    }
    state done() {} state wrong() { crash Trap; }
}
