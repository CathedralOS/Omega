data Extraction<Value> { case Moved(stamp: u64); case Empty; }
machine unpack<Value>(result: &mut Extraction<Value>, fallback: u64) -> u64 {
    transition result in Extraction::Moved {
        true -> replaced(result)
        false -> fallback
    }
    machine replaced(result: &mut Extraction<Value>) -> u64 {
        result = Extraction::Empty {};
        result.stamp
    }
}
machine main(result: &mut Extraction<u64>) -> u64 { unpack<u64>(result, 0) }
