// A runtime-capable value binder whose carrier is linear data binds the exact
// subject under ordinary ownership: the call transfers the linear argument
// into the realized trailing parameter. Binding the same subject to a second
// call would duplicate custody, so the reuse must reject.

data Token [linear] {
    id: u32;
}

machine Token::settle(self) {}

machine take<V: Token>() -> u32 {
    let out: u32 = V.id;
    Token::settle(V);
    out
}

machine Main::main(&mut self) {
    let t: Token = Token { id: 7 };
    let a: u32 = take<t>();
    let b: u32 = take<t>();
}
