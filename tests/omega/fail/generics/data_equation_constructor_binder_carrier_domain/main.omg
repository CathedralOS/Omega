domain<Carrier, const Index: u32> Carrier::Tagged<Index>;

data Box<const Index: u64, Payload [copy]> [copy]
where Payload == u64::Tagged<Index>
{ value: Payload; }

data Main { box: Box<4>; }

machine main(main: &mut Main) crashes Trap {
    main.box.value = 7 as u64 in Tagged<4>;
    transition main.box.value as u64 == 7 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
