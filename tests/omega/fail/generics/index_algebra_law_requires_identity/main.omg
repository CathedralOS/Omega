domain<T, const I: u64> T::Indexed<I>;

trait Related<Value> {
    operator == related(left: Value, right: Value) -> bool;
}

trait IndexOperations<Index>: Related<Index> {
    operator + add(left: Index, right: Index) -> Index;
    machine purported_commutativity(left: Index, right: Index)
    ensures add(left, right) == add(right, left);
}

// A selected Boolean relation does not prove that the two values are equal.
machine reorder<const Left: u64, const Right: u64,
    Operations satisfies IndexOperations<u64>>(
    value: i64 in Indexed<Left + Right>
) -> i64 in Indexed<Right + Left> {
    value
}
