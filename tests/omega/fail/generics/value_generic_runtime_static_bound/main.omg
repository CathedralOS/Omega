// A runtime-capable value binder `Bound: u64` admits an ordinary runtime
// subject only in executable positions. Its use in the returned range bound is
// a static type position the runtime subject cannot determine, so the call
// must reject rather than silently erasing the bound.

machine ranged<Bound: u64>() -> u64[0..=Bound] {
    Bound
}

machine Main::main(&mut self) {
    let n: u64 = 7;
    let total: u64 = ranged<n>();
}
