// A default-domain fact that depends only on const parameters is an
// instantiation-time obligation. The false specialization must not synthesize.
// References remove layout demands, not the obligations reached through them.
data FixedBuffer<const N: u64>
where
    N > 0,
{
    values: [u8; N];
}

// The wrappers bind only types. Their dependency on the const-bearing leaf,
// rather than a const binder of their own, must retain specialization work.
data BufferReference<Element> { marker: Element; buffer: &FixedBuffer<0>; }
data IndirectBufferReference<Element> { buffer: &BufferReference<Element>; }
data Main { buffer: IndirectBufferReference<u8>; }

machine main() {}
