// A false machine-backed domain fact rejects the concrete const-generic
// instance before the membership reaches ordinary proof validation.
machine is_buffer_size(value: u64) -> bool {
    value > 0 && value <= 8
}

domain u64::BufferSize
requires
    is_buffer_size(self);
data FixedBuffer<const N: u64>
where
    N in BufferSize,
{
    values: [u8; N];
}

data Main {
    buffer: FixedBuffer<9>;
}

machine Main::main(&mut self) {}
