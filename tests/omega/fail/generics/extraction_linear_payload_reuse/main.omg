use omega::language::core::drop;
data Token [linear] { value: u64; }
machine Token::drop(token: &mut Token) {}
data Extraction<Value> { case Moved(value: Value); }
machine unpack<Value>(result: Extraction<Value>) -> Value {
    transition result { Extraction::Moved { value } -> value }
}
machine reuse(result: Extraction<Token>) {
    let first: Token = unpack<Token>(result);
    drop(first);
    let second: Token = unpack<Token>(result);
    drop(second);
}
