// A static argument to a runtime-capable value binder takes the closed
// specialization path, where the `requires` contract is evaluated against the
// literal subject: `99 <= 10` is statically false, so the call must reject
// rather than emit a body whose requirement was never established.

machine bounded<Count: u32>(base: u32) -> u32
requires
    Count <= 10;
{
    Count
}

machine Main::main(&mut self) {
    let late: u32 = bounded<99>(7);
}
