domain<T, const I: u64> T::Indexed<I>;

trait IndexOperations<Index> {
    operator + add(left: Index, right: Index) -> Index;
    operator == related(left: Index, right: Index) -> bool;
}

machine indexed<const Left: u64, const Right: u64,
    Operations satisfies IndexOperations<u64>>() -> i64 in Indexed<Left + Right>
{
    70 as i64 in Indexed<Left + Right>
}

machine relation_is_not_equality<const Left: u64, const Right: u64,
    Operations satisfies IndexOperations<u64>>()
requires Left <= 1000
requires Right <= 1000
requires Left + Right == 4
{
    let invalid: i64 in Indexed<4> = indexed<Left, Right, Operations>();
}
