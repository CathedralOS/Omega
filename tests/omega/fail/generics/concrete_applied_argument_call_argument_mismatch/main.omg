// A call argument owes its formal the applied data arguments too: `take`
// receives a `Holder<Foo>`, not the `Holder<Bar>` a call delivered.
data Foo { tag: u8; }
data Bar { tag: u8; }
data Holder<T> { value: T; }
machine same<T>(item: T) -> T { item }
machine take(value: Holder<Foo>) -> u8 { 0u8 }
machine wrong(item: Holder<Bar>) -> u8 { take(same<Holder<Bar>>(item)) }
machine main() {}
