data Indexed<Limit:u32>{value:u32;}
data Tagged<T,const Count:u32,Limit:u32>{value:T;}
machine preserve(limit:u32,value:u32)->u32 { let items:[Indexed<limit>;1] = [Indexed{value:value}]; let item:Tagged<[Indexed<limit>;1],3,limit> = Tagged{value:items}; let wrong:Tagged<[Indexed<limit>;2],3,limit> = item; wrong.value[0].value }
