use omega::language::core::float_operations;
pub data Observation [copy] { value: f64; }
pub trait Blocking { machine calculate(value: f64) -> f64 blocks; }
Implementation satisfies Blocking { machine calculate(value: f64) -> f64 { value } }
boundary machine wrap<Operations satisfies Blocking>(value: f64) -> Observation {
    Observation { value: Blocking::calculate<Operations>(value) }
}
machine main() {}
