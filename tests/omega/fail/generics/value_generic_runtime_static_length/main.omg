// A runtime-bound `Value` binder is realized as an ordinary parameter, so it
// cannot determine static layout: a local fixed array's extent is decided at
// specialization time, and `[u8; Count]` under a runtime subject must reject
// rather than reserve a maximum or invent dynamic stack layout.

machine ident<Count: u32>() -> u32 {
    let a: [u8; Count];
    Count
}

machine Main::main(&mut self) {
    let n: u32 = 3;
    let a: u32 = ident<n>();
}
