// Expected rejection: the configured helper returns 37, which does not equal 38.
// Changing only the call argument breaks the precondition.

machine tagged_value<const Tag: u64>(value: u64) -> u64 reaches terminates { Tag }
machine apply<machine Callback>(value: u64) -> u64
requires machine Callback(value: u64) -> u64 reaches terminates;
requires Callback(value) == value
{ Callback(value) }
machine main() crashes Trap {
    let first: u64 = apply<tagged_value<37>>(38);
    let second: u64 = apply<tagged_value<91>>(91);
    transition first == 37 && second == 91 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
