
domain<Carrier, const Index: u64> Carrier::Tagged<Index>;

data Box<Payload [copy], const Index: u64> [copy]
requires
    Payload == u64::Tagged<Index>
{
    value: Payload;
}

data Reversed<const Index: u64, Payload [copy]> [copy]
requires Payload == u64::Tagged<Index>
{ value: Payload; }

data Same<Left, Right, Payload [copy]> [copy]
requires
    Left == [Payload; 1],
    Right == [Payload; 1]
{ value: Payload; }

data Main {
    box: Box<u64 in Tagged<8> >;
    reversed: Reversed<8>;
    repeated: Same<[u64 in Tagged<8>; 1], [i64 in Tagged<8>; 1]>;
}

machine main() {}
