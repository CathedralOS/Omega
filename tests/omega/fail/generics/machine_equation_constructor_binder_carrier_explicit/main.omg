data Mode<const Inner: u32> [copy] { value: u64; }

machine capacity<Payload, const Count: u64>() -> u64
where Payload == Mode<Count>
{ Count }

data Main { result: u64; }

machine main(main: &mut Main) crashes Trap {
    main.result = capacity<Mode<4>, 4>();
    transition main.result == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
