// Different applications of one selected map cannot share an index equality.
// Neither AC law is required to retain the operation's exact identity.
domain<T, const I: u64> T::Indexed<I>;
trait IndexAdd<Operand> { operator + add(a: Operand, b: Operand) -> Operand; }

Selected<const Output: u64> satisfies IndexAdd<u64> {
    machine add(a: u64, b: u64) -> u64 { transition { _ -> Output } }
}

machine indexed<const A: u64, const B: u64, Algebra satisfies IndexAdd<u64>>()
    -> i64 in Indexed<A + B>
{
    70 as i64 in Indexed<A + B>
}

machine establish_three<Algebra satisfies IndexAdd<u64>>(a: u64, b: u64) -> u64
requires a <= 1000
requires b <= 1000
requires a + b == 3
ensures a + b == 3
{ transition { _ -> 3 } }

machine cannot_borrow_other_application() {
    _ = establish_three<Selected<3>>(1, 2);
    let wrong: i64 in Indexed<3> = indexed<1, 2, Selected<4>>();
}
