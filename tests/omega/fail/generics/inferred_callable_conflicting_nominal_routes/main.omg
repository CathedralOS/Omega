// An uncalled wrapper still publishes one nominal route, not an intersection of nominal identities.
public trait First<Value> { machine apply(value: Value) -> Value; }
public trait Second { machine apply(value: u32) -> u32; }

public machine use_first<const Callback: First<u32>::apply>(value: u32) -> u32 {
    Callback(value)
}

public machine use_second<const Callback: Second::apply>(value: u32) -> u32 {
    Callback(value)
}

public machine use_wide<const Callback: First<u64>::apply>(value: u64) -> u64 {
    Callback(value)
}

public machine wrapper<const Selected: machine, const Typed: machine>(value: u32, wide: u64) -> u32 {
    let first: u32 = use_first<Selected>(value);
    let second: u32 = use_second<Selected>(first);
    let typed: u32 = use_first<Typed>(second);
    let ignored: u64 = use_wide<Typed>(wide);
    typed
}

machine main() {}
