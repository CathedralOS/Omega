// An uncalled wrapper still publishes one nominal route, not an intersection of nominal identities.
public trait First { machine apply(value: u32) -> u32; }
public trait Second { machine apply(value: u32) -> u32; }

public machine use_first<const Callback: First::apply>(value: u32) -> u32 {
    Callback(value)
}

public machine use_second<const Callback: Second::apply>(value: u32) -> u32 {
    Callback(value)
}

public machine wrapper<const Selected: machine>(value: u32) -> u32 {
    let first: u32 = use_first<Selected>(value);
    use_second<Selected>(first)
}

machine main() {}
