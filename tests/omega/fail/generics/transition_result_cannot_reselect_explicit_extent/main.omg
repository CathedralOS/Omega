// Reject: a receiving state cannot override an explicitly selected array extent.
machine empty<const Count: u64>() -> [u8; Count] {
    let bytes: [u8; Count];
    bytes
}

machine main() crashes Trap {
    transition { _ -> receive(empty<2>()) }
    machine receive(bytes: [u8; 3]) {
        transition bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 0 {
            true -> done()
            _ -> wrong()
        }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
