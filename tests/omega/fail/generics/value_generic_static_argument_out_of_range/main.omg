// A runtime-capable value binder still honors its declared carrier range for
// static arguments: `ident<99>` names a closed specialization, so the bound
// `[0..=10]` is decided at specialization and must reject rather than admit a
// body whose realized subject cannot inhabit its carrier.

machine ident<Count: u32[0..=10]>() -> u32 {
    Count
}

machine Main::main(&mut self) {
    let b: u32 = ident<99>();
}
