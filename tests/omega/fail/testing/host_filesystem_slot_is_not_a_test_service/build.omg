machine build(builder: &mut Build) {
    Build::application(builder, "host_filesystem_slot_is_not_a_test_service");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../../../../source/library/std"
    }));
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    _ = builder.tests.group<Tests::journal>();
    _ = builder.tests.service<Tests::journal, omega_language_std::PosixFilesystemHost>();
}
