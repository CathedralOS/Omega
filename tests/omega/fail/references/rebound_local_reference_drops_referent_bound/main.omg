// Rebinding a reference local replaces the binding; it does not store through
// it. `s` starts at `a`, whose entry requirement bounds it, then names `b`,
// which has no bound. `s - 5` reads `b` and may underflow, so it must reject.
// Before the repair the checker related `a` and `b` as equal and accepted it.
machine observe(a: &u64, b: &u64) -> u64
requires a >= 5 {
    let mut s: &u64 = a;
    s = b;
    s - 5
}

machine main() crashes Trap {
    let a: u64 = 9;
    let b: u64 = 0;
    let r: u64 = observe(&a, &b);
    transition r == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
