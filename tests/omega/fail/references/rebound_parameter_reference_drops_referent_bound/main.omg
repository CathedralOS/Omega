// A `mut` shared-reference parameter rebinds the same way as a local: after
// `selected = replacement`, the entry requirement on the original referent no
// longer describes `selected`, so `selected - 5` may underflow and must reject.
machine observe(mut selected: &u64, replacement: &u64) -> u64
requires selected >= 5 {
    selected = replacement;
    selected - 5
}

machine main() crashes Trap {
    let a: u64 = 9;
    let b: u64 = 0;
    let r: u64 = observe(&a, &b);
    transition r == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
