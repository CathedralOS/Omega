data Ticket [copy] { amount: i32; }
domain Ticket::Issued established by Ticket::issue;
machine Ticket::issue() -> Ticket ensures result in Ticket::Issued {
    Ticket { amount: 41 }
}
machine Ticket::lookalike() -> Ticket { Ticket { amount: 41 } }
data Envelope [copy] { ticket: Ticket in Issued; }
data Main { ticket: Ticket; sibling: Ticket; }
machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 41 };
    true
}
machine observe(values: [Envelope; 2]) {}
machine literal() {
    observe([
        Envelope { ticket: Ticket::issue() },
        Envelope { ticket: Ticket { amount: 41 } }
    ]);
}
machine stale(main: &mut Main) {
    main.ticket = Ticket::issue();
    let replaced: bool = Main::replace(main);
    observe([
        Envelope { ticket: Ticket::issue() },
        Envelope { ticket: main.ticket }
    ]);
}
machine sibling(main: &mut Main) {
    main.ticket = Ticket::issue();
    observe([
        Envelope { ticket: main.ticket },
        Envelope { ticket: main.sibling }
    ]);
}
machine lookalike() {
    observe([
        Envelope { ticket: Ticket::issue() },
        Envelope { ticket: Ticket::lookalike() }
    ]);
}
