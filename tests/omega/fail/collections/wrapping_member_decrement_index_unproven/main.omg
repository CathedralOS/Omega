// A wrapped `count - 1` is the maximum when `count` is zero, so a Wrapping
// member decrement does not carry the field's former bound one lower and the
// read after it stays unproven.
data Stack { items: [u32; 8]; count: u64 in Wrapping; }

machine take(stack: &mut Stack) -> u32
requires stack.count <= 8
{
    stack.count = stack.count - 1;
    stack.items[stack.count]
}

machine main() -> u32 {
    transition { _ -> (0) }
}
