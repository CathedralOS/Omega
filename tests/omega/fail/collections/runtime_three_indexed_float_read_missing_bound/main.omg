// Expected error: cannot prove index `row` is within length 2
use omega::language::core::float_operations;

data Storage { cells: [[[f64; 2]; 2]; 2]; }

machine read(storage: &Storage, layer: u64, row: u64, column: u64) -> f64
requires layer <= 1 requires column <= 1 {
    storage.cells[layer][row][column]
}

machine main() {
    let storage: Storage;
    let observed: f64 = read(&storage, 1, 2, 1);
}
