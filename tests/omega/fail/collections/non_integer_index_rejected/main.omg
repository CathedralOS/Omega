// An index into fixed-array or slice geometry is an integer operand
// (spec/language/counts_and_addresses.md, separate roles). A `f64`, `f32` or
// `bool` index, or a floating subslice endpoint, is a type error at the
// index, not a bounds obligation that the range checker fails to prove.
machine pick(values: [u8; 4], position: f64) -> u8 {
    values[position]
}

machine store(values: &mut [u8], position: f32) {
    values[position] = 7;
}

machine choose(values: [u8; 2], flag: bool) -> u8 {
    values[flag]
}

machine window(values: &[u8], start: f64) -> u64 {
    let view: &[u8] = &values[start..];
    view.len
}

machine main() {}
