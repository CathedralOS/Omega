// The same value fits the outer extent three but not the inner extent two.
// Proving the outer selection cannot authorize the second indexing occurrence.
data Row { data: [i32 in Wrapping; 2]; }

machine main() {
    let mut rows: [Row; 3];
    let mut index: u64 = 1;
    index = 2;
    let observed: i32 in Wrapping = rows[index].data[index];
}
