// A deeper nested runtime-indexed write: `self.cube[a][b][0] = v` on a 3D array
// with TWO runtime outer indices and a CONST final index silently NO-OPPED
// (cube[1][1][0] = 99 then reading it back gave 7, not 99). The write fence
// that rejected it (`needs mutation lowering`) was retired upstream; checked
// semantics now admits the shape, and the native route still refuses it at
// the transitive Unit-plan admission wall. A single base-closest runtime
// index (`grid[i][0]`, `arr[i]`) stays lowerable and valid.
data Main { cube: [[[i32; 2]; 2]; 2]; a: i32; b: i32; }
machine Main::main(&mut self) {
    self.cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
    self.a = 1;
    self.b = 1;
    self.cube[self.a][self.b][0] = 99;
    transition { _ -> done() }
    state done(&mut self) { }
}
