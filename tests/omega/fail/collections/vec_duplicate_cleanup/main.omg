// Vec cleanup is consumption, not idempotent disposal: `close` takes the
// linear vec by value, so a second close on the same place asks the same
// linear obligation to be supplied twice and must be rejected.

use alloc::vec;
use omega::language::core::binding;

data Main {}

machine Main::main(vec_disposal: &Binding<VecDisposal>) -> i32 reaches VecDisposal {
    let vec: Vec = Vec {
        live: 0,
        rung: 0,
        len: 0,
    };
    VecDisposal::close(vec_disposal, vec);
    VecDisposal::close(vec_disposal, vec);
    0
}
