// Vec cleanup is consumption, not idempotent disposal: `cleanup` takes the
// linear vec by value, so a second cleanup on the same place asks the same
// linear obligation to be supplied twice and must be rejected.

data Vec [linear] {
    items: [i32; 4];
    length: u64 in Wrapping;
}

machine Vec::cleanup(self) {}

data Main {}

machine Main::main() -> i32 {
    let vec: Vec = Vec {
        items: [0, 0, 0, 0],
        length: 0,
    };
    Vec::cleanup(vec);
    Vec::cleanup(vec);
    0
}
