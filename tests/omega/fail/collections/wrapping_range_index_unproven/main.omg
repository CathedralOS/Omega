// SUPERSEDED SETUP, SAME SOUNDNESS OUTCOME
// (`range-constraints-require-exact-domain`, 2026-07-13): this
// canary originally pinned that a WRAPPING-domained range must not discharge
// an index bound (the range is permissive at stores, so feeding it to the
// index prover would read out of bounds; the Exact-domain gate rejected the
// INDEX). That decision made the `[range] in Wrapping` declaration itself
// ill-formed ("this is just a compile error"), so the rejection now fires at
// the DECLARATION, before the index prover ever sees it -- strictly earlier,
// same out-of-bounds read prevented. The expected fragment tracks the
// declaration-level diagnostic; types/range_under_non_exact_domain_rejected
// pins the store-context flavor of the same rule.
use omega_language_std::console;

data Main {
    arr: [i32; 5];
    i: u64 [0..=4] in Wrapping;
}

machine Main::main(main: &mut Main) {
    transition { _ -> read(main) }
    state read(main: &mut Main) {
        let v: i32 = main.arr[main.i];
        transition v == 0 { true -> m(main) false -> m(main) }
    }
    state m(main: &mut Main) { Console::exit_process(1); }
}
