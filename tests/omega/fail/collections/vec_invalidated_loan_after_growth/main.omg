// A loan into a vec's backing must not survive growth: `grow8to16` needs
// exclusive `&mut` access to `main.b8` (the resident store), but the `slots`
// borrow of `main.b8.e` is still live (it is used after the call), so the
// growth call is rejected while the loan is active.

use alloc::vec;

data Main {
    v: Vec;
    b8: Backing8;
    b16: Backing16;
}

machine Main::main(main: &mut Main) {
    let slots: &mut [u32] = main.b8.e.as_mut_slice();
    let r16: Request = Request::Denied;
    _ = Vec::grow8to16(&mut main.v, &mut main.b8, &mut main.b16, r16);
    slots[0] = 1;
}
