// An authored comparison does not establish the builtin index bound: the
// guard `index < items.len` selects the domain-family `<` for the
// `Custom`-bound operand, so the read cannot prove `index` within the slice.
// Without the binding the builtin `<` narrows `index` and the read checks.
domain u64::Custom;

machine < u64::Custom::custom(left: u64 in Custom, right: u64) -> bool {
    true
}

machine read(items: &[u8], index: u64 in Custom) -> u8 {
    transition {
        index < items.len -> (items[index])
        _ -> 0
    }
}
