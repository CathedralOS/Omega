// The written index is `depth - 1` behind `depth > 0`, but the data `where`
// admits a depth of 5 over four items, so `top` may be 4: the store rejects.
data Stack
where
    depth <= 5,
{
    items: [u64; 4];
    depth: u64;
}

machine Stack::replace_top(stack: &mut Stack, value: u64)
crashes Trap
{
    transition stack.depth > 0 {
        true -> write(stack, value)
        _ -> empty()
    }

    machine write(stack: &mut Stack, value: u64) {
        let top: u64 = stack.depth - 1;
        stack.items[top] = value;
    }

    machine empty() {
        crash Trap;
    }
}
