// A declared range that does NOT fit the array: `i: u64 [0..=5]` indexing
// `[i32; 5]` (high == length) must still reject -- the range only discharges
// the upper bound when high < length.
use omega_language_std::console;

data Main where i <= 5 {
    arr: [i32; 5];
    i: u64;
}

machine Main::main(main: &mut Main) reaches Console {
    transition { _ -> read(main) }
    machine read(main: &mut Main) {
        let v: i32 = main.arr[main.i];
        transition v == 0 { true -> m(main) false -> m(main) }
    }
    machine m(main: &mut Main) { Console::exit_process(1); }
}
