// A proved bound never authorizes storing a byte outside the owner's domain.
domain [u8; 2]::Ascii(bytes) requires ascii_only(bytes);
machine main() {
    let mut bytes: [u8; 2] in Ascii = "ab";
    corrupt(&mut bytes, 0);
}
machine corrupt(bytes: &mut [u8; 2] in Ascii, index: u64)
    requires index < bytes.len
{
    bytes[index] = 255;
}
