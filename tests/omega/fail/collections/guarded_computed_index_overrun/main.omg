// The right operand of `||` runs when the left one fails, so
// `position < 5 ||` leaves `position + 1` free to reach 6.
machine rises(values: &[i32; 6], position: u64) -> bool
requires position < 6
{
    transition position < 5 || values[position + 1] > values[position] {
        true -> (true)
        _ -> (false)
    }
}

machine main() -> i32 {
    transition { _ -> (0) }
}
