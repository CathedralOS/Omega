// ALLOCATOR STORY STAGE 1: `push` onto a fixed-capacity vec carries the
// proof obligation `length < items.len` (spare room), and a call site with
// NO established fact about the length must be rejected — there is no
// growth path and no runtime trap to fall back to. Here `main` pushes onto
// the ZII vector without any prior contract guarantee (no clear/push chain),
// so the capacity obligation cannot be discharged.

data FixedVecI32x4 {
    items: [i32; 4];
    length: u64 in Wrapping;
}

machine FixedVecI32x4::push(fixed_vec_i32x4: &mut FixedVecI32x4, value: i32)
requires
    fixed_vec_i32x4.length < fixed_vec_i32x4.items.len
{
    let slots: &mut [i32] = fixed_vec_i32x4.items.as_mut_slice();
    let index: u64 in Wrapping = fixed_vec_i32x4.length;
    slots[index] = value;
    fixed_vec_i32x4.length = fixed_vec_i32x4.length + 1;
}

data Main {
    vec: FixedVecI32x4;
}

machine Main::main(main: &mut Main) {
    FixedVecI32x4::push(&mut main.vec, 7);
}
