data Main {
    items: [u8; 4];
    index: u32 in Wrapping;
}

machine Main::run(&mut self) {
    self.index = 2;
    transition { _ -> fill() }
    state fill(&mut self) {
        let value: u8 = self.items[self.index];
        self.index = self.index - 3;
        transition self.index > 0 { true -> fill() _ -> {} }
    }
}
