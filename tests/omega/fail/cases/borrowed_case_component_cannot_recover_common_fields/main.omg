// A borrowed case view cannot recover the whole Message's common fields.
data Message [copy] {
    stamp: u64;
    case Received(value: u64);
    case Empty;
}

machine inspect(message: &Message) -> u64 {
    match message {
        Message { stamp as _, case as operation } -> match &operation {
            Message { stamp as value, case as _ } -> value
            _ -> 99
        }
    }
}

machine main() crashes Trap {
    let received: Message = Message::Received { stamp: 11, value: 7 };
    let empty: Message = Message::Empty { stamp: 19 };
    let payload: u64 = inspect(&received);
    let fallback: u64 = inspect(&empty);
    transition payload == 7 && fallback == 99 && received.stamp == 11 && empty.stamp == 19 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
