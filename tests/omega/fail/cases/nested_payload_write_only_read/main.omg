data Details [copy] { prefix: u64; mode: u32; }
data Outcome [copy] { case Error; case Ok(details: Details); }
data Envelope [copy] { prefix: u64; outcome: Outcome; }

machine read_unavailable(envelope: &write Envelope) -> u32 {
    transition envelope.outcome {
        Outcome::Ok { details } -> (details.mode)
        Outcome::Error -> 0
    }
}
