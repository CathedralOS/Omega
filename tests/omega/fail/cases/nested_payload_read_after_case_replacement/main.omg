data Details [copy] { prefix: u64; mode: u32; }
data Outcome [copy] { case Error; case Ok(details: Details); }
data Envelope [copy] { prefix: u64; outcome: Outcome; }

machine read_stale(envelope: &mut Envelope) -> u32
requires envelope.outcome in Outcome::Ok;
{
    envelope.outcome = Outcome::Error;
    envelope.outcome.details.mode
}
