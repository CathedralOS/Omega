// The identity laws are present, but the nullary slots are not connected to
// the literals 0 and 1. `Indexed<N + 0>` stays distinct from `Indexed<N>`.
domain<T, const I: u64> T::Indexed<I>;

trait IndexAdditive {
    machine index_zero() -> u64 terminates;
    machine index_one() -> u64 terminates;
    machine + add(left: u64, right: u64) -> u64 terminates;
    machine * multiply(left: u64, right: u64) -> u64 terminates;
    machine add_right(value: u64)
    ensures add(value, index_zero()) == value;
    machine mul_right(value: u64)
    ensures multiply(value, index_one()) == value;
}

trait IndexUnits : IndexAdditive {
    machine tag() -> u64 terminates;
}

machine zero_value() -> u64
satisfies IndexAdditive::index_zero as Canonical
ensures result == 0
{
    0
}

machine one_value() -> u64
satisfies IndexAdditive::index_one as Canonical
ensures result == 1
{
    1
}

machine plus_value(left: u64, right: u64) -> u64
satisfies IndexAdditive::add as Canonical
{
    transition right == 0 { true -> left false -> left }
}

machine times_value(left: u64, right: u64) -> u64
satisfies IndexAdditive::multiply as Canonical
{
    transition right == 1 { true -> left false -> left }
}

Canonical satisfies IndexUnits
{
    machine index_zero() -> u64
    terminates {
        zero_value()
    }
    machine index_one() -> u64
    terminates {
        one_value()
    }
    machine add(left: u64, right: u64) -> u64
    terminates {
        plus_value(left, right)
    }
    machine multiply(left: u64, right: u64) -> u64
    terminates {
        times_value(left, right)
    }
    machine add_right(value: u64)
    ensures plus_value(value, 0) == value {
    }
    machine mul_right(value: u64)
    ensures times_value(value, 1) == value {
    }
    machine tag() -> u64
    terminates {
        1
    }
}

// Each assignment is the identity the two laws license. `N + 1` is not one of them.
machine drop_zero<const N: u64, Algebra satisfies IndexUnits>(raw: i64) -> i64 {
    let added: i64 in Indexed<N + 0> = raw as i64 in Indexed<N + 0>;
    let plain: i64 in Indexed<N> = added;
    plain as i64
}

machine drop_one<const N: u64, Algebra satisfies IndexUnits>(raw: i64) -> i64 {
    let scaled: i64 in Indexed<N * 1> = raw as i64 in Indexed<N * 1>;
    let plain: i64 in Indexed<N> = scaled;
    plain as i64
}

machine observe(raw: i64) -> i64 {
    let added: i64 = drop_zero<COUNT, Canonical>(raw);
    let scaled: i64 = drop_one<COUNT, Canonical>(raw);
    transition added == scaled { true -> done(scaled) _ -> bad() }
    machine done(value: i64) -> i64 { value }
    machine bad() -> i64 { crash Trap; }
}

machine relay<const N: u64, Algebra satisfies IndexUnits>(raw: i64) -> i64 {
    let added: i64 = drop_zero<N, Algebra>(raw);
    drop_one<N, Algebra>(added)
}

machine produced() -> i64 {
    41
}

data Held [copy] { raw: i64; }

const COUNT: u64 = 8;
const RAW: i64 = 41;

boundary trait SelectedBodyCheck {
    machine require_tag(tag: u64) reaches crashes Trap;
}

X86BodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 17u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

ArmBodyCheck satisfies SelectedBodyCheck {
    machine require_tag(tag: u64) crashes Trap {
        transition tag == 29u64 { true -> done() false -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}

boundary trait SelectedObserve {
    machine observe() -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap;
}

X86Observe satisfies SelectedObserve {
    machine observe() -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(17u64);
        observe(41)
    }
}

ArmObserve satisfies SelectedObserve {
    machine observe() -> i64
        reaches SelectedBodyCheck invokes SelectedBodyCheck crashes Trap
    {
        SelectedBodyCheck::require_tag(29u64);
        observe(41)
    }
}

machine main() crashes Trap {
    let from_local: i64 = drop_zero<COUNT, Canonical>(41);
    let from_local_one: i64 = drop_one<COUNT, Canonical>(from_local);
    let held: Held = Held { raw: 41 };
    let from_field: i64 = observe(held.raw);
    let from_parameter: i64 = observe(41);
    let from_call: i64 = observe(produced());
    let flag: bool = true;
    let joined: i64 = match flag { true -> 41, false -> 58 };
    let from_match: i64 = observe(joined);
    let from_const: i64 = observe(RAW);
    transition {
        _ -> check(
            41,
            from_local_one,
            from_field,
            from_parameter,
            from_call,
            from_match,
            from_const
        )
    }
    machine check(
        raw: i64,
        from_local: i64,
        from_field: i64,
        from_parameter: i64,
        from_call: i64,
        from_match: i64,
        from_const: i64
    ) {
        let from_state: i64 = observe(raw);
        let from_machine: i64 = relay<COUNT, Canonical>(raw);
        let from_target: i64 = SelectedObserve::observe();
        transition from_local == 41 && from_field == 41 && from_parameter == 41
            && from_call == 41 && from_match == 41 && from_const == 41
            && from_state == 41 && from_machine == 41 && from_target == 41 {
            true -> done()
            _ -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine x86_entry() crashes Trap {
    SelectedBodyCheck::require_tag(17u64);
    main();
}

machine arm_entry() crashes Trap {
    SelectedBodyCheck::require_tag(29u64);
    main();
}
