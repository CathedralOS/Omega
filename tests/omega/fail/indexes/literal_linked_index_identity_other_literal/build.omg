machine build(builder: &mut Build) {
    Build::application(builder, "literal_linked_index_identity_other_literal");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, linux_x86_64);
    Build::select_provider<SelectedObserve, X86Observe>(builder, linux_x86_64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, linux_arm64);
    Build::select_provider<SelectedObserve, ArmObserve>(builder, linux_arm64);
    Build::select_provider<SelectedBodyCheck, ArmBodyCheck>(builder, macos_arm64);
    Build::select_provider<SelectedObserve, ArmObserve>(builder, macos_arm64);
    Build::select_provider<SelectedBodyCheck, X86BodyCheck>(builder, windows_x86_64);
    Build::select_provider<SelectedObserve, X86Observe>(builder, windows_x86_64);
}
