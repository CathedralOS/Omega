// Fact: the exact selected element items[index] == 7 discharges the callee's indexed zero crash guard and returns that same 7 without a caller crash ceiling.
// Expected exit: 0
// Place: parameter.
machine maybe_zero(items: &[u64; 2], index: u64) -> u64
requires index < 2
crashes Trap items[index] == 0
{
    transition items[index] == 0 { true -> bad() false -> (items[index]) }
    machine bad() -> u64 { crash Trap; }
}
machine clear(value: &mut u64) -> u64
ensures value == 1
{ value = 1; 0 }
machine preserve_after(ignored: u64, index: u64) -> u64
requires index < 2
ensures result == index
ensures result < 2
{ index }
public machine read_seven(items: &[u64; 2], index: u64) -> u64
requires index < 2
requires items[index] == 7
{ let mut selected: u64 = index; let carried: u64 = match clear(&mut selected) == 0 { true -> selected, false -> selected }; maybe_zero(items, carried % 2) }
machine main() crashes Trap {
    let items: [u64; 2] = [7, 11];
    transition items[0] == 7 { true -> finish(read_seven(&items, 0)) _ -> bad() }
    machine finish(observed: u64) {
        transition observed == 7 { true -> done() _ -> bad() }
    }
    machine done() {} machine bad() { crash Trap; }
}
