// A nonselected target's differing result cannot become a portable guarantee.
public data Status [copy] { code: u64; }
public boundary trait Reports {
    machine status() -> Status reaches ensures result.code == 7;
}
public ForwardedReports satisfies Reports {
    machine status() -> Status ensures result.code == 7; {
        SelectedSelectedStatus::selected_status()
    }
}
boundary trait SelectedSelectedStatus {
    machine selected_status() -> Status reaches
ensures result.code == 7;
}
CheckedSelectedStatus satisfies SelectedSelectedStatus {
    machine selected_status() -> Status
ensures result.code == 7;
{ Status { code: 7 } }
}
reserved_target machine selected_status() -> Status
ensures result.code == 8; { Status { code: 8 } }
machine main() { }
