// Refuting `index >= 5` leaves `index + 1` free to reach 5, so the later
// arm's call does not meet `requires index <= 4`.
machine walk(index: u64) -> u64
terminates by (index, 9) -> Nat::BoundedDistance;
requires index <= 4
{
    transition {
        index >= 5 -> (index)
        _ -> walk(index + 1)
    }
}

machine main() -> u64 {
    transition { _ -> (0) }
}
