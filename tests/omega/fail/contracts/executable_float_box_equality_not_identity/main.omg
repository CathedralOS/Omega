// An executable comparison may equate signed zeros without proving data Id.
data Floating [copy] { value: f64; }
trait Equatable<Value> {
    machine equals(left: &Value, right: &Value) -> bool;
}
FloatingEquality satisfies Equatable<Floating> {
    machine equals(left: &Floating, right: &Floating) -> bool { left.value == right.value }
}

machine demand_identity(left: Floating, right: Floating) -> u64
requires left == right
{ 0u64 }

machine guarded(left: Floating, right: Floating) -> u64 {
    transition left == right {
        true -> demand_identity(left, right)
        false -> 1u64
    }
}
machine main() {
    _ = guarded(Floating { value: -0.0f64 }, Floating { value: 0.0f64 });
}
