data Child { value: u64; }
data Pair { first: Child; second: u64; }

machine replace(pair: &mut Pair)
requires pair.first.value == 7
ensures pair.first.value == 7
{
    let alias: &mut Pair = pair;
    alias = Pair { first: Child { value: 8 }, second: 9 };
}

machine overwrite(pair: &mut Pair)
ensures pair.first.value == 7
{
    pair = Pair { first: Child { value: 7 }, second: 9 };
    pair.first.value = 8;
}

machine main() {}
