// Captured integer reasoning must retain the selected arithmetic policy.
// At 255, wrapping yields 0 and saturating yields 255; neither is greater.
machine wrapping_greater(actual: u8 in Wrapping, prior: u8 in Wrapping)
requires actual > prior {}
machine wrapping_step(value: u8 in Wrapping) {
 wrapping_greater(value + 1, value);
}
machine saturating_greater(actual: u8 in Saturating, prior: u8 in Saturating)
requires actual > prior {}
machine saturating_step(value: u8 in Saturating) {
 saturating_greater(value + 1, value);
}
// An IEEE value can lie strictly between zero and one.
machine at_least_one(value: f64) requires value >= 1.0 {}
machine positive_float(value: f64) requires value > 0.0 {
 at_least_one(value);
}
