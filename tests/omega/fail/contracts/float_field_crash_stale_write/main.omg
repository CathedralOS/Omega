use omega::language::core::float_operations;

// A published crash guard observes the invocation-entry floating field.
data Measurement { value: f64; other: f64; }

machine read(measurement: &mut Measurement) -> f64
crashes Trap measurement.value < 0.0 {
    measurement.value = -1.0;
    transition measurement.value < 0.0 {
        true -> invalid()
        false -> measurement.value
    }
    machine invalid() -> f64 { crash Trap; }
}

machine main() crashes Trap {
    let mut measurement: Measurement = Measurement { value: 2.0, other: 1.0 };
    let value: f64 = read(&mut measurement);
    transition value == 2.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
