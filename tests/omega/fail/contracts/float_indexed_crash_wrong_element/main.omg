use omega::language::core::float_operations;
data Reading<T> { value: T; }
machine read(values: &[Reading<f64>; 2]) -> f64
crashes Trap values[0].value < 0.0 {
    transition values[1].value < 0.0 {
        true -> invalid()
        false -> (values[1].value)
    }
    machine invalid() -> f64 { crash Trap; }
}
machine main() crashes Trap {
    let values: [Reading<f64>; 2] = [Reading { value: -1.0 }, Reading { value: 2.0 }];
    let value: f64 = read(&values);
    transition value == 2.0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
