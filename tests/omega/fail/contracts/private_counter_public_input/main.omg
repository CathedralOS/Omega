// Reject: a public entry accepts arbitrary input even when its visible source caller supplies 0.

machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = counter + 1;
    0
}

public machine apply(visits: &mut u64) -> u64 {
    compute(visits)
}

machine main() {
    let mut visits: u64 = 0;
    let index: u64 = apply(&mut visits);
}
