// Equal tags and byte contents do not identify two different slice descriptors.
data Packet<'buffer> { tag: u8; output: &'buffer mut [u8]; }

machine replace_buffer<'buffer>(incoming: Packet<'buffer>, other: &'buffer mut [u8]) -> Packet<'buffer>
ensures result == incoming
{ Packet { tag: incoming.tag, output: other } }

machine main() {
    let mut first: [u8; 3] = [41u8, 43u8, 47u8];
    let mut second: [u8; 3] = [41u8, 43u8, 47u8];
    _ = replace_buffer(Packet { tag: 37u8, output: &mut first[0u64..3u64] }, &mut second[0u64..3u64]);
}
