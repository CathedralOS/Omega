pub boundary trait Addition {
    machine combine(first: u32, second: u32) -> u32
    terminates
    requires (first <= 4) && (second <= 4)
    ensures result == first + second;
}

data AdditionProvider {}

machine AdditionProvider::combine(left: u32, right: u32) -> u32
satisfies Addition::combine
terminates;
requires (left <= 4) && (right <= 4);
ensures result == left;
{ left }

machine main() { _ = AdditionProvider::combine(2, 3); }
