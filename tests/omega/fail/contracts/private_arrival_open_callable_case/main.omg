// Reject: the direct caller selects Present, but the callable arrival's interface
// states no case and passes Absent, so the helper cannot read the payload.
public data Slot { case Absent; case Present(value: i64); }

machine read_root(s: &mut Slot) -> i64 { s.value }

public machine invoke_root<machine Reader>(s: &mut Slot) -> i64
requires machine Reader(s: &mut Slot) -> i64;
{ Reader(s) }

machine main() crashes Trap {
    let mut first: Slot = Slot::Present { value: 17 };
    let mut second: Slot = Slot::Absent;
    let a: i64 = read_root(&mut first);
    let b: i64 = invoke_root<read_root>(&mut second);
    transition a == 17 && b == 5 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
