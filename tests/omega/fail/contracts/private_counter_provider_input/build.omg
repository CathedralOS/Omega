machine build(builder: &mut Build) {
    Build::application(builder, "private_counter_provider_input");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<CounterTick, LinuxX86Counter>(builder, linux_x86_64);
    Build::select_provider<CounterTick, LinuxArmCounter>(builder, linux_arm64);
    Build::select_provider<CounterTick, MacCounter>(builder, macos_arm64);
    Build::select_provider<CounterTick, WindowsCounter>(builder, windows_x86_64);
}
