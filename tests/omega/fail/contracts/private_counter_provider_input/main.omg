// Reject: a selected provider has independent inputs; one visible source caller supplying 0 cannot strengthen its input contract.

machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = counter + 1;
    0
}

machine apply(visits: &mut u64) -> u64 {
    compute(visits)
}

boundary trait CounterTick {
    machine tick(visits: &mut u64) -> u64
    reaches;
}

LinuxX86Counter satisfies CounterTick {
    machine tick(visits: &mut u64) -> u64
    reaches {
        apply(visits)
    }
}

LinuxArmCounter satisfies CounterTick {
    machine tick(visits: &mut u64) -> u64
    reaches {
        apply(visits)
    }
}

MacCounter satisfies CounterTick {
    machine tick(visits: &mut u64) -> u64
    reaches {
        apply(visits)
    }
}

WindowsCounter satisfies CounterTick {
    machine tick(visits: &mut u64) -> u64
    reaches {
        apply(visits)
    }
}

machine main() {
    let mut visits: u64 = 0;
    let index: u64 = CounterTick::tick(&mut visits);
}
