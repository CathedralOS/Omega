// Known callers cannot narrow a helper that explicitly accepts every value.
machine main() crashes Trap {
    let direct: u64 = previous(2);
    let forwarded: u64 = forward(3);
    let guarded_value: u64 = guarded(5);
    let guarded_zero: u64 = guarded(0);
    transition direct == 1 && forwarded == 2 && guarded_value == 4 && guarded_zero == 0 {
        true -> done()
        false -> bad()
    }

    machine previous(value: u64) -> u64
    requires true
    {
        value - 1
    }

    machine forward(value: u64) -> u64
    requires true
    {
        take(value)
        machine take(input: u64) -> u64 { input - 1 }
    }

    machine done() {}
    machine bad() crashes Trap { crash Trap; }

    machine guarded(value: u64) -> u64
    requires true
    {
        transition value > 0 {
            true -> step(value)
            false -> 0
        }
        machine step(input: u64) -> u64 { input - 1 }
    }
}
