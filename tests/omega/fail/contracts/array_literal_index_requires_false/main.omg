// The negative twin of pass/contracts/array_literal_index_requires_exit:
// `[3u64, 9u64][1]` is 9, so a call with limit 8 cannot establish
// `9 <= limit`. Reading the wrong element (3) would wrongly accept it.
machine bounded(limit: u64) -> u64
requires [3u64, 9u64][1] <= limit
requires [3u64][0] <= 7
{
    limit
}

machine main() {
    let first: u64 = bounded(8);
}
