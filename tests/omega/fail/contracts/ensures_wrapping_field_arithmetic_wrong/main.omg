// Soundness pin for wrapping field arithmetic in a guarantee: with
// `start = 0` the stored `remaining` is 0, and `remaining - 1` on a
// `Wrapping` field is 2^32 - 1, not -1. `start < 8` bounds the difference
// only when `1 <= remaining` rules out the wrap, and nothing establishes
// that here. The guarantee must be refused rather than read as exact
// arithmetic; `pass/contracts/ensures_wrapping_field_arithmetic_exit`
// stores `start + 1` and is accepted.

data Countdown {
    remaining: u32 in Wrapping;
}

machine Countdown::arm(countdown: &mut Countdown, start: u32 in Wrapping)
requires
    start < 8
ensures
    countdown.remaining - 1 < 8
{
    countdown.remaining = start;
}

data Main {
    timer: Countdown;
}

machine Main::main(main: &mut Main) {
    Countdown::arm(&mut main.timer, 0);
}
