machine nonempty(bytes: &[u8])
requires bytes.len > 0
{}

machine one_byte(bytes: &[u8])
requires bytes.len == 1
{}

machine empty_is_not_nonempty() {
    nonempty("");
}

machine codepoints_are_not_bytes() {
    one_byte("\xC3\xA9");
}

machine replaced_descriptor_is_not_its_initializer() {
    let mut bytes: &[u8] = "ab";
    bytes = "";
    nonempty(bytes);
}
// Capacity belongs to an explicit owner; its empty prefix remains empty.
data Buffer where used <= 8 { storage: [u8; 8]; used: u64; }
machine live(buffer: &Buffer) -> &[u8] { &buffer.storage[..buffer.used] }
machine capacity_is_not_live_length() {
    let buffer: Buffer;
    let bytes: &[u8] = live(&buffer);
    nonempty(bytes);
}
machine projected_capacity_is_not_live_length() {
    let buffer: Buffer = Buffer { storage: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8], used: 0 };
    let bytes: &[u8] = live(&buffer);
    nonempty(bytes);
}
