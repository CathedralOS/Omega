data Main { items: [u64; 2]; }
machine walk(items: &mut [u64])
terminates;
terminates by items -> Slice::Length;
{
    transition items.len > 0 { true -> head(items) _ -> done() }
    machine head(items: &mut [u64]) requires items.len > 0 {
        items[0] = 1;
        transition { _ -> walk(items) }
    }
    machine done() {}
}
machine Main::main(main: &mut Main) { walk(&mut main.items[..]); }