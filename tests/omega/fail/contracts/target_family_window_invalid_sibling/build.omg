machine build(builder: &mut Build) {
    Build::select_provider<SelectedWindow, LinuxX8664Window>(builder, linux_x86_64);
    Build::select_provider<SelectedWindow, LinuxX8664Window>(builder, linux_arm64);
    Build::select_provider<SelectedWindow, LinuxX8664Window>(builder, macos_arm64);
    Build::select_provider<SelectedWindow, WindowsX8664Window>(builder, windows_x86_64);

    Build::application(builder, "target_family_window_invalid_sibling");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
