// Host selection must still check another retained body.
boundary trait SelectedWindow {
    machine window<'a>(items: &'a mut [u8; 4]) -> &'a mut [u8] reaches
ensures result.len == 2;
}
LinuxX8664Window satisfies SelectedWindow {
    machine window<'a>(items: &'a mut [u8; 4]) -> &'a mut [u8]
ensures result.len == 2
{ &mut items[0..2] }
}


WindowsX8664Window satisfies SelectedWindow {
    machine window<'a>(items: &'a mut [u8; 4]) -> &'a mut [u8] ensures result.len == 2
{ &mut items[0..1] }
}
machine need(items: &mut [u8]) requires items.len >= 2 { items[0] = 9; items[1] = 8; }
machine main() {
 let mut items: [u8; 4] = [1, 2, 3, 4];
 let view: &mut [u8] = SelectedWindow::window(&mut items);
 need(view);
}
