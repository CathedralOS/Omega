// A good result producer cannot hide another producer that violates the bound.
machine first(remaining: u64) -> u64
    requires remaining <= 8u64
    ensures result <= 256u64
{
    transition remaining > 0u64 {
        true -> second(remaining - 1u64)
        false -> (17u64)
    }
}
machine second(remaining: u64) -> u64
    requires remaining <= 8u64
    ensures result <= 256u64
{
    transition remaining > 0u64 {
        true -> first(remaining - 1u64)
        false -> (257u64)
    }
}
machine main() {}
