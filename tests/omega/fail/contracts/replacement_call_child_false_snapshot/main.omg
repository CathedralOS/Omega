data Child { value: u64; }
data Pair { first: Child; second: u64; }

machine false_producer() -> u64 ensures result == 9 { 8 }
machine replacement_value() -> u64 ensures result == 9 { 9 }
machine bounded_value() -> u64 ensures result >= 8 && result <= 10 { 8 }

// A provisional call guarantee never excuses a false producer contract.
machine install_false(pair: &mut Pair) ensures pair.first.value == 9 {
    pair = Pair { first: Child { value: false_producer() }, second: 5 };
}

// The installed snapshot belongs to the member and retires on an overwrite.
machine overwrite(pair: &mut Pair) ensures pair.first.value == 9 {
    pair = Pair { first: Child { value: replacement_value() }, second: 5 };
    pair.first.value = 8;
}

// A completed interval is not an exact scalar observation.
machine install_interval(pair: &mut Pair) ensures pair.first.value == 9 {
    pair = Pair { first: Child { value: bounded_value() }, second: 5 };
}

machine main() {}
