data Counter { value: u64; }
machine address_of(counter: &mut Counter) -> u64 { counter.value = 0; 19 }
machine consume(counter: &Counter) -> bool requires counter.value == 7 { counter.value == 7 }
machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 7 };
    let observed: u64 = address_of(&mut counter);
    transition consume(&counter) && observed == 19 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
