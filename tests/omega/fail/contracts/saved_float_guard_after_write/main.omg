use omega::language::core::float_operations;
data Reading { value: f64; }
machine accept(reading: &Reading, count: u64)
requires reading.value >= 0.0 && count <= 4;
{}
machine main() {
    let mut reading: Reading = Reading { value: 1.0 };
    let ready: bool = reading.value >= 0.0;
    reading.value = -1.0;
    transition ready {
        true -> accept(&reading, 0)
        false -> done()
    }
    machine done() {}
}
