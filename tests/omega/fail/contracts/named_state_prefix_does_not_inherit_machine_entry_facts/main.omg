machine accept(value: u32) requires value == 1 {}

machine bad(value: u32, remaining: u32)
requires value == 1 && remaining <= 9
terminates by remaining in 0..=9
{
    transition { _ -> later(2, remaining) }
    machine later(value: u32, remaining_steps: u32) requires remaining_steps <= 9 terminates by remaining_steps in 0..=9 {
        accept(value);
        transition remaining_steps > 0 {
            true -> later(value, remaining_steps - 1)
            false -> done()
        }
    }
    machine done() {}
}

machine main() { bad(1, 2); }
