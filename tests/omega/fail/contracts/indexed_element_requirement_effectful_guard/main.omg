machine letter(text: &[u8], index: u64) -> u64
requires index < text.len && text[index] >= 97
{ (text[index] - 97) as u64 }
machine reset(text: &mut [u8], index: u64) -> bool
requires index < text.len
{
    text[index] = 0;
    false
}
machine invalid(text: &mut [u8], index: u64) -> u64
requires index < text.len && text[index] >= 97
{
    transition {
        reset(text, index) -> 0
        _ -> letter(text, index)
    }
}
