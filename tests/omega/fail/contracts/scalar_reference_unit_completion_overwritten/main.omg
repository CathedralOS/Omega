// Expected exit: 0.
// Completed scalar referent stores prove unit-exit guarantees across exact state origins.
machine zero(output: &mut u32) ensures output == 0 {
    transition { _ -> stored(output) }
    machine stored(destination: &mut u32) {
        destination = 0;
        overwrite(&mut destination);
        transition { _ -> {} }
    }
}
machine zero_implicit(output: &mut u32) ensures output == 0 {
    output = 0;
}
machine observe_zero(value: u32) requires value == 0 {}
machine main() crashes Trap {
    let mut changed: u32 = 99;
    let mut initialized: u32 = 99;
    zero(&mut changed);
    zero_implicit(&mut initialized);
    observe_zero(changed);
    observe_zero(initialized);
    transition changed == 0 && initialized == 0 { true -> {} false -> bad() }
    machine bad() { crash Trap; }
}

machine overwrite(value: &mut u32) { value = 1; }
