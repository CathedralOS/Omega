data Layout { origin: u64; }

machine walk(left: &Layout, right: &Layout, remaining: u64) -> i32
terminates by remaining -> Nat::Descending
requires left.origin == 0 {
    transition remaining > 0 {
        true -> walk(right, left, remaining - 1)
        false -> 0
    }
}

machine main() -> i32 { 0 }
