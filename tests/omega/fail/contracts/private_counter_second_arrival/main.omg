// Reject: a second actual call supplies a counter of 1, so apply cannot assume every arrival supplies 0.

machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = counter + 1;
    0
}

machine apply(visits: &mut u64) -> u64 {
    compute(visits)
}

machine main() {
    let mut first: u64 = 0;
    let mut second: u64 = 1;
    let first_index: u64 = apply(&mut first);
    let second_index: u64 = apply(&mut second);
}
