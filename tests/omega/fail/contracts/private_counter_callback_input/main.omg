// Reject: an escaping helper cannot assume its callback contract admits only a counter of 0.

machine compute(counter: &mut u64) -> u64
requires counter == 0
{
    counter = counter + 1;
    0
}

machine apply(visits: &mut u64) -> u64 {
    compute(visits)
}

public machine invoke<machine Callback>(visits: &mut u64) -> u64
requires machine Callback(visits: &mut u64) -> u64;
{
    Callback(visits)
}

machine main() {
    let mut visits: u64 = 0;
    let index: u64 = invoke<apply>(&mut visits);
}
