// A call's write frame retires the guard facts it overlaps. The first pop
// writes `main.a`, so the entry guard no longer bounds `main.a.count` for the
// second pop in the same state.

data Stack {
    items: [i32; 4];
    count: u64;
}

machine Stack::pop(stack: &mut Stack) -> i32
requires stack.count >= 1 && stack.count <= 4 {
    stack.count = stack.count - 1;
    stack.items[stack.count]
}

data Main {
    a: Stack;
    b: Stack;
}

machine Main::main(main: &mut Main) {
    transition main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
        true -> twice(main)
        _ -> done()
    }
    machine twice(main: &mut Main) {
        let first: i32 = Stack::pop(&mut main.a);
        let second: i32 = Stack::pop(&mut main.a);
        transition { _ -> done() }
    }
    machine done() {}
}
