// A selected private helper must satisfy every independently admitted input.
// Zero/one and zero/unrestricted alternatives cannot be conjoined or omitted.
machine require_zero(counter: &mut u64) -> u64
requires counter == 0
{ counter = counter + 1; 0 }
machine zero_or_one(visits: &mut u64) -> u64 { require_zero(visits) }
machine zero_or_any(visits: &mut u64) -> u64 { require_zero(visits) }

public machine both_inputs<machine Zero, machine One>(first: &mut u64, second: &mut u64)
requires machine Zero(zero: &mut u64) -> u64
requires zero == 0;
requires machine One(one: &mut u64) -> u64
requires one == 1;
requires first == 0, second == 1
{ _ = Zero(first); _ = One(second); }

public machine open_inputs<machine Zero, machine Any>(first: &mut u64, second: &mut u64)
requires machine Zero(zero: &mut u64) -> u64
requires zero == 0;
requires machine Any(value: &mut u64) -> u64;
requires first == 0
{ _ = Zero(first); _ = Any(second); }

machine main() {
    let mut zero: u64 = 0;
    let mut one: u64 = 1;
    both_inputs<zero_or_one, zero_or_one>(&mut zero, &mut one);
    let mut bounded: u64 = 0;
    let mut unrestricted: u64 = 0;
    open_inputs<zero_or_any, zero_or_any>(&mut bounded, &mut unrestricted);
}
