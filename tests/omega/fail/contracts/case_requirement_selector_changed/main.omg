data Choice { case Cell(value: u32); case Empty; }
data Position { index: u64; }
machine observe(choice: &Choice) -> u32
requires choice in Choice::Cell { choice.value }
machine exercise(choices: &[Choice; 2], position: &mut Position) -> u32
requires position.index < 2
requires choices[position.index] in Choice::Cell {
    position.index = 1;
    observe(&choices[position.index])
}
