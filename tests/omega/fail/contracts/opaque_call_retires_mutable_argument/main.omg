data Value [copy] { number: u64; }
data View<'scope> { value: &'scope Value; }
boundary trait Replace {
    machine replace<'scope>(view: &mut View<'scope>, value: &'scope Value, output: &mut Value) -> u64 reaches;
}

machine after_call(output: &mut Value)
reaches Replace
invokes Replace;
requires output.number == 7
{
    let first: Value = Value { number: 7 };
    let second: Value = Value { number: 11 };
    let mut view: View = View { value: &first };
    let status: u64 = Replace::replace(&mut view, &second, output);
    exact_seven(output.number);
}

machine exact_seven(value: u64) requires value == 7 {}
