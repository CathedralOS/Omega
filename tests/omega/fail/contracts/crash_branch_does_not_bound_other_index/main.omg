// A checked cell does not bound a different selected element on the surviving path.
machine check_other(cells: &[i32], index: u64) crashes Trap
requires index < cells.len && cells.len > 0
{
    transition cells[0] < 0 || cells[0] > 255 {
        true -> bad()
        false -> receive(cells, index)
    }
    machine bad() { crash Trap; }
    machine receive(cells: &[i32], index: u64)
    requires index < cells.len
    requires cells[index] >= 0 && cells[index] <= 255
    {}
}
machine main() {}
