// Unknown fields do not preserve a known borrowed field across a selected call.
data Value [copy] { number: u64; }
data Carrier<'scope, Other> { other: Other; value: &'scope Value; }
trait Replace<Other> {
    machine replace<'scope>(carrier: &mut Carrier<'scope, Other>, value: &'scope Value) -> u64;
}

machine after_call<'scope, Other, Selected satisfies Replace<Other>>(
    carrier: &mut Carrier<'scope, Other>, value: &'scope Value) -> u64
requires carrier.value.number == 7
ensures result == 7 {
    let status: u64 = Selected::replace(carrier, value);
    carrier.value.number
}

machine main() { }
