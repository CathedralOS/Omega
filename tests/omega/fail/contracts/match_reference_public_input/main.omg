// A match selects one of two references, the join records that reference, and the consumer reads through the recorded reference.
// Reject: every actual or public input must establish the selected referent is 17.

machine choose() -> bool
ensures result == true
{
    true
}

machine read_through(place: &i64) -> i64
requires place == 17
{
    place
}

public machine apply(chosen: &i64, spare: &i64) -> i64 {
    let joined: &i64 = match choose() {
        true -> chosen
        false -> spare
    };

    read_through(joined)
}

machine main() crashes Trap {
    let chosen: i64 = 17;
    let spare: i64 = 5;
    let observed: i64 = apply(&chosen, &spare);
    transition observed == 17 {
        true -> done()
        false -> wrong()
    }

    machine done() {}
    machine wrong() { crash Trap; }
}
