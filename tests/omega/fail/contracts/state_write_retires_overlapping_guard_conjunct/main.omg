// A guard carried back across an intermediate state loses every conjunct the
// state's writes may reach. `first` pops `main.b`, so the entry guard's
// `main.b.count` conjuncts no longer hold when `second` pops `main.b` again.

data Stack {
    items: [i32; 4];
    count: u64;
}

machine Stack::pop(stack: &mut Stack) -> i32
requires stack.count >= 1 && stack.count <= 4 {
    stack.count = stack.count - 1;
    stack.items[stack.count]
}

data Main {
    a: Stack;
    b: Stack;
}

machine Main::main(main: &mut Main) {
    transition main.a.count >= 1 && main.a.count <= 4 && main.b.count >= 1 && main.b.count <= 4 {
        true -> first(main)
        _ -> done()
    }
    machine first(main: &mut Main) {
        let value: i32 = Stack::pop(&mut main.b);
        transition { _ -> second(main) }
    }
    machine second(main: &mut Main) {
        let value: i32 = Stack::pop(&mut main.b);
        transition { _ -> done() }
    }
    machine done() {}
}
