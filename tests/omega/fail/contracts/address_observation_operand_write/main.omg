data Counter { value: u64; }
machine erase(counter: &mut Counter) -> u64 ensures result == 0 { counter.value = 0; 0 }
machine consume(counter: &Counter) -> bool requires counter.value == 7 { counter.value == 7 }
machine main() crashes Trap {
    let mut counter: Counter = Counter { value: 7 };
    let values: [u64; 2] = [3, 5];
    let observed: addr = address_of(&values[erase(&mut counter)]);
    transition consume(&counter) && observed != 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
