// Entry bounds do not constrain a parameter after mutation.
machine first(remaining: u64) -> u64
    requires remaining <= 8u64
    ensures result <= 256u64
{
    transition remaining > 0u64 {
        true -> second(remaining - 1u64, 0u64)
        false -> (17u64)
    }
}
machine second(remaining: u64, mut value: u64) -> u64
    requires remaining <= 8u64 && value <= 256u64
    ensures result <= 256u64
{
    value = 257u64;
    transition remaining > 0u64 {
        true -> first(remaining - 1u64)
        false -> (value)
    }
}
machine main() {}
