data Cell { value: i32; }
machine needs_one(value: i32) -> i32 requires value == 1 { value }
machine reset(cell: &mut Cell) { cell.value = 0; }
machine reset_value(cell: &mut Cell) -> i32 { cell.value = 0; 0 }
machine quiet(value: i32) {}
machine mutate_guard(cell: &mut Cell) -> bool { cell.value = 0; true }
machine outer(cell: &mut Cell) -> i32 requires cell.value == 1 {
 transition mutate_guard(cell) {
  true -> needs_one(cell.value)
  false -> 0
 }
}
