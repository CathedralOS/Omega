data Child { value: u64; ready: bool; }
data Element { child: Child; }

machine replacement() -> Element
ensures result.child.value == 9 && result.child.ready
{
    Element { child: Child { value: 9, ready: true } }
}

machine replace(elements: &mut [Element])
requires elements.len >= 2
ensures elements[1].child.value == 9 && elements[1].child.ready
{
    elements[1] = replacement();
    elements[1].child.value = 4;
    elements[1].child.ready = false;
}

machine main() {}
