data Pair { first: u64; second: u64; }

machine carry(first: u64, second: u64, remaining: u64) -> Pair
ensures result.first == first, result.second == second
terminates by remaining {
    transition remaining > 0 {
        true -> step(first, second, remaining)
        false -> Pair { first: second, second: first }
    }
    machine step(first: u64, second: u64, remaining: u64) -> Pair
    requires remaining > 0
    ensures result.first == first, result.second == second {
        transition { _ -> carry(first, second, remaining - 1) }
    }
}
