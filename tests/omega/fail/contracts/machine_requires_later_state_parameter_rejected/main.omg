// A machine `requires` clause is its entry state's arrival contract, so it
// reads only the entry parameters. `later_bound` is a later state's parameter:
// the clause never binds it, and that state's declared `u64` must not lend
// the premise an unsigned operand that proves `values[0]` on a slice.
machine first(values: &[u8], index: u64) -> u8
requires later_bound < values.len;
{
    transition { _ -> finish(values[0], 1) }

    machine finish(value: u8, later_bound: u64) -> u8 {
        transition { _ -> (value) }
    }
}

machine main() {}
