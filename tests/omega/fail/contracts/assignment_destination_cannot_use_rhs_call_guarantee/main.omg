// Expected check: reject destination bounds before any RHS guarantee.
machine zero_only(index: u64) -> u64 ensures index == 0 crashes Trap {
    transition index == 0 { true -> (0u64) false -> bad() }
    machine bad() -> u64 crashes Trap { crash Trap; }
}
public machine exercise(items: &mut [u64; 1], index: u64)  crashes Trap {
    items[index] = zero_only(index);
}
machine main() crashes Trap {
    let mut items: [u64; 1] = [641];
    exercise(&mut items, 0);
    transition items[0] == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
