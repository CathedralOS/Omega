// Reject: a later write replaces the selected field, so the arrival at the helper
// must carry the case written last, which is Absent.
public data Slot { case Absent; case Present(value: i64); }
data Rec { before: u64; slot: Slot; after: u64; }

machine read_field(r: &mut Rec) -> i64 { r.slot.value }

machine main() crashes Trap {
    let mut direct: Rec = Rec { before: 1, slot: Slot::Present { value: 29 }, after: 2 };
    direct.slot = Slot::Absent;
    let c: i64 = read_field(&mut direct);
    transition c == 29 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
