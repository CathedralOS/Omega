// An entry requirement establishes only the case it names. Reading another
// case's payload under it is not a proven payload access.
data Choice { case Cell(counter: u32); case Empty; }

machine observe(choice: &Choice) -> u32 requires choice in Choice::Empty { choice.counter }

machine main() crashes Trap {
    let choice: Choice = Choice::Empty;
    let resident: u32 = observe(&choice);
    transition resident == 3 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
