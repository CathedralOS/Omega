// `s <= 5` on u64 is not vacuous -- the ceiling sits inside the carrier
// and unguarded evidence cannot reach it.
use omega_language_std::console;
use omega::language::core::binding;

machine echo(scale: u64) -> u64
requires scale <= 5
{
    transition { _ -> (scale) }
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let s: u64 = self.opaque();
    let r: u64 = echo(s);
    self.console.exit_process(70);
}

machine Main::opaque(&mut self) -> u64 {
    transition { _ -> (4u64) }
}
