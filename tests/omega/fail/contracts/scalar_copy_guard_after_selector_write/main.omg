// Expected error contains: cannot prove
use omega_language_std::console;
data Main { items: [u8; 64]; saved: u8; other: u64; }
machine Main::main(main: &mut Main) reaches Console {
    let read: LineReadResult = block Console::read_line(&mut main.items);
    transition read { LineReadResult::LineComplete { count } -> inspect(main, 0) _ -> done(main) }
    state inspect(main: &mut Main, selector: u64) requires selector < 64 {
        let mut selected: u64 = selector;
        let copied: u8 = main.items[selected];
        selected = (selected + 1) % 64;
        transition copied >= 48 && copied <= 49 { true -> bounded(main, selected) false -> done(main) }
    }
    state bounded(main: &mut Main, selector: u64) requires selector < 64 requires main.items[selector] >= 48 requires main.items[selector] <= 49 {
        Console::exit_process(42);
    }
    state done(main: &mut Main) { Console::exit_process(0); }
}
