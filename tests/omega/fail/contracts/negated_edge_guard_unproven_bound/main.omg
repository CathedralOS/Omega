// Soundness pin for negated edge-guard entailment: the `_ ->` continuation
// of `v >= 100` establishes `v < 100`, which does NOT prove the callee's
// `requires v < 50` (v could be 75). The entailment must refuse rather than
// over-admit the complement.
machine check(v: u64)
requires v < 50u64
{}

data Main {}

machine Main::opaque(&mut self) -> u64 {
    transition { _ -> (75u64) }
}

machine Main::main(&mut self) {
    let v: u64 = self.opaque();
    transition v >= 100u64 {
        true -> bad()
        _ -> then(v)
    }
    state then(&mut self, v: u64) {
        check(v);
    }
    state bad(&mut self) {}
}
