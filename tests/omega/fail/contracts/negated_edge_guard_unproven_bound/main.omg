// Soundness pin for negated edge-guard entailment: the `_ ->` continuation
// of `v >= 100` establishes `v < 100`, which does NOT prove the callee's
// `requires v < 50` (v could be 75). The entailment must refuse rather than
// over-admit the complement.
machine check(v: u64)
requires v < 50u64
{}

machine opaque() -> u64 {
    transition { _ -> (75u64) }
}

machine main() {
    let v: u64 = opaque();
    transition v >= 100u64 {
        true -> bad()
        _ -> then(v)
    }
    state then(v: u64) {
        check(v);
    }
    state bad() {}
}
