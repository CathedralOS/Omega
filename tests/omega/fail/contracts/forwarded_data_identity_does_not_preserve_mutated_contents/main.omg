// Forwarding keeps the slice length, while a write replaces its current byte.
data Packet<'buffer> { tag: u8; output: &'buffer mut [u8]; }
data Slot<'buffer> { before: u8; answer: Packet<'buffer>; after: u8; }

machine through_field<'buffer>(incoming: Packet<'buffer>) -> Slot<'buffer>
ensures result.answer == incoming
{ Slot { before: 83u8, answer: incoming, after: 89u8 } }

machine need_unchanged(before: u8, after: u8)
requires before == after
{}

machine stale<'buffer>(incoming: Packet<'buffer>)
requires incoming.output.len >= 3u64
{
    let slot: Slot<'buffer> = through_field(incoming);
    let returned: Packet<'buffer> = slot.answer;
    let before: u8 = returned.output[1u64];
    returned.output[1u64] = 97u8;
    need_unchanged(before, returned.output[1u64]);
}

machine main() {
    let mut storage: [u8; 5] = [79u8, 41u8, 43u8, 47u8, 81u8];
    stale(Packet { tag: 37u8, output: &mut storage[1u64..4u64] });
}
