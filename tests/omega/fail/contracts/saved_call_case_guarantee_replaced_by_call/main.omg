// A saved call result's case guarantee does not survive a callee that
// replaces the whole case-bearing value through a mutable reference.
data Choice { case Cell(counter: u32); case Empty; }

machine make() -> Choice ensures result in Choice::Cell { Choice::Cell { counter: 3 } }

machine clear(choice: &mut Choice) -> u32 {
    choice = Choice::Empty {};
    0
}

machine observe(choice: &Choice) -> u32 requires choice in Choice::Cell { choice.counter }

machine main() crashes Trap {
    let mut choice: Choice = make();
    let cleared: u32 = clear(&mut choice);
    let resident: u32 = observe(&choice);
    transition resident == cleared {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
