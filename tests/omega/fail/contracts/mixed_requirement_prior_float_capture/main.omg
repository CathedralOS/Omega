use omega::language::core::float_operations;
machine replace(value: &mut f64) -> u64
ensures result == 0
{ value = 2.0; 0 }
machine compare(before: f64, count: u64, after: f64)
requires before == after && count <= 4
{}
machine main() {
    let mut value: f64 = 1.0;
    compare(value, replace(&mut value), value);
}
