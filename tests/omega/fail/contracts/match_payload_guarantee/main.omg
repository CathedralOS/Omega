// Expected exit: 0
// A contract match binds the payload of its selected case, not a sibling's field.
data Reply {
    case Kept(number: u64, neighbor: u64);
    case Refused(number: u64, neighbor: u64);
}

machine choose(input: u64, keep: bool) -> Reply
ensures (match result {
    Reply::Kept { number, neighbor } -> number == input && neighbor == 23,
    Reply::Refused { number, neighbor } -> number == input && neighbor == 41,
})
{
    transition keep {
        true -> kept(input)
        false -> refused(input)
    }
    machine kept(input: u64) -> Reply { Reply::Kept { number: input, neighbor: 23 } }
    machine refused(input: u64) -> Reply { Reply::Refused { number: input, neighbor: 41 } }
}

machine inspect(reply: Reply) -> u64 crashes Trap {
    transition reply {
        Reply::Kept { number, neighbor } -> kept(number, neighbor)
        Reply::Refused { number, neighbor } -> refused(number, neighbor)
    }
    machine kept(number: u64, neighbor: u64) -> u64 crashes Trap {
        transition neighbor == 23 && number == 17 {
            true -> done()
            false -> bad()
        }
        machine done() -> u64 { 101 }
        machine bad() -> u64 { crash Trap; }
    }
    machine refused(number: u64, neighbor: u64) -> u64 crashes Trap {
        transition neighbor == 41 && number == 29 {
            true -> done()
            false -> bad()
        }
        machine done() -> u64 { 202 }
        machine bad() -> u64 { crash Trap; }
    }
}

// The selected case's public guarantee survives the call and payload forwarding.
machine roundtrip(input: u64, keep: bool) -> u64
ensures result == input
{
    transition choose(input, keep) {
        Reply::Kept { number, neighbor } -> kept(number, neighbor)
        Reply::Refused { number, neighbor } -> refused(number, neighbor)
    }
    machine kept(number: u64, neighbor: u64) -> u64
    requires neighbor == 23
    { number }
    machine refused(number: u64, neighbor: u64) -> u64
    requires neighbor == 23
    { number }
}

// Keeping two results must not conflate the first call's payload with the second.
machine second_result(input: u64, other: u64, keep: bool) -> u64
ensures result == input
{
    let first: Reply = choose(input, keep);
    transition choose(other, keep) {
        Reply::Kept { number, neighbor } -> done(number)
        Reply::Refused { number, neighbor } -> done(number)
    }
    machine done(number: u64) -> u64 { number }
}

machine main() crashes Trap {
    let first: u64 = inspect(choose(17, true));
    let second: u64 = inspect(choose(29, false));
    let forwarded_kept: u64 = roundtrip(17, true);
    let forwarded_refused: u64 = roundtrip(29, false);
    let other_kept: u64 = second_result(17, 31, true);
    let other_refused: u64 = second_result(29, 43, false);
    transition first == 101 && second == 202 && forwarded_kept == 17 && forwarded_refused == 29 && other_kept == 31 && other_refused == 43 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
