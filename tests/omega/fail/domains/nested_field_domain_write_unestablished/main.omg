// #66 soundness: a domained NESTED field (`main.inner.tag in Ascii`) must enforce
// its domain at the write, exactly like a one-level field. Before the multi-level
// field-path resolver, `attached_data_field_type` walked only `main.field`, so a
// nested-field write SILENTLY BYPASSED the domain check -- a non-ascii literal
// would have been accepted into an `Ascii` field. It is now rejected: the prover
// cannot establish `"café"` (a multibyte `é`) is `ascii_only`.
domain [u8]::Ascii(bytes)
requires
    ascii_only(bytes);
use omega_language_std::console;

data Inner {
    tag: &[u8] in Ascii;
}

data Main {
    inner: Inner;
}

machine Main::main(main: &mut Main) reaches Console {
    main.inner.tag = "café";
    Console::exit_process(70);
}
