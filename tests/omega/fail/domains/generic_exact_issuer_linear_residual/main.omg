data Ticket { value: u64; }
data First {}
data Wrapper [linear] { ticket: Ticket in Issued<First>; retained: u64; }
domain<P> Ticket::Issued<P> established by issue;
machine issue<P>() -> Ticket in Issued<P> { Ticket { value: 73 } }
machine read(ticket: Ticket in Issued<First>) -> u64 { ticket.value }
machine main() {
    let wrapper: Wrapper = Wrapper { ticket: issue<First>(), retained: 19 };
    let observed: u64 = read(wrapper.ticket);
}
