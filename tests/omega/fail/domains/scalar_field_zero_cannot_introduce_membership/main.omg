// Invalid: a numeric zero cannot introduce routed membership.
domain u64::Issued(value) requires value >= 0 established by issue;
boundary trait Consume { machine accept(value: u64 in Issued) reaches; }
Actual satisfies Consume { machine accept(value: u64 in Issued) {} }
machine issue(value: u64) -> u64 in Issued { value }
data Payload { value: u64 in Issued; }
machine main() {
    let value: Payload;
    Consume::accept(value.value);
}
