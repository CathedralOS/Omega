// `&(issued as Ticket)` lends a value whose issued meaning was erased. Its
// bytes stay in `issued`, but a parameter that requires `Ticket::Held` on
// its referent must not find that meaning again.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine observe(ticket: &Ticket in Ticket::Held) {}
machine main() {
    let issued: Ticket in Ticket::Held = issue();
    observe(&(issued as Ticket));
}
