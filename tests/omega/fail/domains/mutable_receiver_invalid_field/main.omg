domain [u8; 8]::NonEmpty(bytes) requires non_empty(bytes);
data Label { text: [u8; 8] in NonEmpty; }
data Packet { label: Label; }
machine Packet::consume(&mut self) {}

machine main() {
    let mut packet: Packet;
    // Zero storage is not an established Packet: a method call owes exactly
    // the same nonempty field obligation as a named argument would.
    packet.consume();
}
