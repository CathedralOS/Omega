// The class an element store re-mints at the carrier is live evidence, not a
// licence: a SECOND store that replaces another byte with a non-ASCII one
// splits the scalar the carrier held, retires the minted class, and the normal
// return must refuse the field's declared domain again.
domain [u8; 4]::Utf8(bytes) requires valid_utf8(bytes);

data Buffer { label: [u8; 4] in Utf8; }

machine store(buffer: &mut Buffer, byte: u8) {
    buffer.label = "Gate";
    transition byte < 128 {
        true -> write(buffer, byte)
        _ -> keep(buffer)
    }
    machine write(buffer: &mut Buffer, byte: u8) {
        buffer.label[1] = byte;
        buffer.label[0] = 200;
    }
    machine keep(buffer: &mut Buffer) { }
}