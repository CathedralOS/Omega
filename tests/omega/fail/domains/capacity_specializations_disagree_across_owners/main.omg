// `std::calling` declares `pub domain [u8; 256]::Utf8 requires valid_utf8(self)`.
// A fixed-array target normalizes its capacity out of the name, so this is the
// same name under a different owner. Its facts disagree, and a use site cannot
// select between them by declaration order.
domain [u8; 8]::Utf8
requires
    self.len == 8;

data Main {
    items: [u8; 8] in Utf8;
}

machine Main::main(&mut self) {
}
