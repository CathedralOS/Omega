// An erased value stored as a case payload keeps no issued meaning.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine consume(t: Ticket in Ticket::Held) {}
data Wrap { case Some(ticket: Ticket); case None; }
machine main() {
    let issued: Ticket in Ticket::Held = issue();
    let wrapped: Wrap = Wrap::Some { ticket: issued as Ticket };
    transition wrapped { Wrap::Some { ticket } -> consume(ticket) Wrap::None -> done() }
    machine done() {}
}
