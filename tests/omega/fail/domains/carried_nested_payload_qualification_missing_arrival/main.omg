data Ticket [copy] { value: u64; }
domain Ticket::Issued established by mint;
data Choice { case Ready(ticket: Ticket); case Empty; }
data Envelope { choice: Choice; }

machine mint(value: u64) -> Ticket
ensures result in Issued
{ Ticket { value: value } }

machine inspect(choose: bool) {
    transition choose {
        true -> forward(Envelope { choice: Choice::Ready { ticket: mint(73) } })
        false -> forward(Envelope { choice: Choice::Ready { ticket: Ticket { value: 73 } } })
    }
    state forward(envelope: Envelope) {
        transition envelope.choice {
            Choice::Ready { ticket } -> verify(ticket)
            Choice::Empty -> done()
        }
    }
    state verify(ticket: Ticket in Issued) {}
    state done() {}
}
