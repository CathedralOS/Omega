data Player {
    health: i32;
}

domain Player::Valid(player)
requires
    player.health >= 0;

domain Player::Alive(player)
requires
    player in Player::Valid;
    player.health > 0;

data Main {
    player: Player;
}

machine heal(player: &mut Player)
requires
    player in Player::Valid
ensures
    player in Player::Alive
{
    player.health = 10;
}

machine Main::main(main: &mut Main) {
    heal(&mut main.player);
}
