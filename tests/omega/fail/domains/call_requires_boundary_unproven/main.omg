use omega::language::core::service;
// Chapter 18 makes a boundary trait signature's `requires` the CALLER's proof
// obligation, the same way a boundary trait machine's `requires` is. Calls
// through platform-typed contained objects never produced a call obligation
// (the platform signature target was invisible to borrow/contract collection),
// so the platform contract was vacuous; it must reject.

pub data Item {
    value: i32;
}

pub domain Item::Ready
requires
    self.value > 0;

pub boundary trait Console {
    machine show(item: &Item)
    requires
        item in Item::Ready;
}

data Main {
    console: Binding<Console>;
    item: Item;
}

machine Main::main(&mut self) reaches Console {
    self.console.show(&self.item);
}
