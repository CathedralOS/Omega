// Expected exit: 0
domain u64::Positive requires self > 0;
data Cell { value:u64; }
machine walk(cell:&mut Cell,n:u64)->u64 requires n<=3; {
 transition n>0 {true->step(cell,n) _->(0)}
 machine step(cell:&mut Cell,n:u64)->u64 requires n>0 && n<=3; {
  let local:u64 in Positive = 0 as u64 in Positive;
  cell.value=local;
  transition n==1 {true->(local) _->walk(cell,n-1)}
 }
}
machine main() crashes Trap {
 let mut cell:Cell; cell.value=0;
 transition walk(&mut cell,2)==3 && cell.value==3 {true->done() _->failed()}
 machine done() {} machine failed() {crash Trap;}
}
