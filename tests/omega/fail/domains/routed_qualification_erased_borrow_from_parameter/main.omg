// A parameter declared `Ticket::Held` still lends an erased value through
// `&(t as Ticket)`: the call's own entry facts about `t` must not satisfy
// a referent requirement the cast removed.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine observe(ticket: &Ticket in Ticket::Held) -> u64 { ticket.number }
machine outer(t: Ticket in Ticket::Held) -> u64 { observe(&(t as Ticket)) }
machine main() {
    let issued: Ticket in Ticket::Held = issue();
    let n: u64 = outer(issued);
}
