domain u64::NonZero requires self != 0;
data Handle { value: u64; }
domain Handle::Open
requires self.value != 0
established by translate;
machine translate(items: &[u64; 2], position: &mut u64) -> Handle in Open
requires position < 2
requires items[position] in NonZero {
    position = 0;
    Handle { value: items[position] }
}
