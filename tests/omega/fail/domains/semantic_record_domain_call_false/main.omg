// A record domain that homes `+` still owes its field predicate at every
// admission: a negative quantity cannot reach `combine`.
data Quantity { value: i32; }

domain Quantity::Additive(quantity) requires quantity.value >= 0;

machine + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity
requires right in Quantity::Additive
{
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}

machine combine(a: Quantity, b: Quantity) -> bool
requires a in Quantity::Additive, b in Quantity::Additive
{
    a.value < b.value
}

machine main() -> bool {
    transition { _ -> combine(Quantity { value: -3 }, Quantity { value: 4 }) }
}
