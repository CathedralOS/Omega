// A checked result guarantee does not survive a write to the observed field.
data Resource [copy] { identity: u64; }
domain Resource::Open(resource) requires resource.identity != 0;
machine acquire() -> Resource ensures result.identity == 19 {
    Resource { identity: 19 }
}
machine main() {
    let mut resource: Resource = acquire();
    resource.identity = 0;
    let resources: [Resource in Open; 1] = [resource];
}
