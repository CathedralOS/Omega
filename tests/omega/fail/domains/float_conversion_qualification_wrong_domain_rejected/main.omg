use omega::language::core::I32::from_f64;

// Twin of pass/domains/float_conversion_qualification_transport_exit: the
// returned and passed conversions are qualified into `Positive`, which their
// value satisfies, but the return type and parameter require `Three`. A
// qualification establishes only the domain it names.
domain i32::Three requires self == 3;
domain i32::Positive requires self > 0;

machine exact(value: f64) -> i32 in Three {
    transition value == 3.0f64 {
        true -> (3.0f64 as i32 in Three)
        _ -> (3 as i32 in Three)
    }
}
machine truncated() -> i32 in Three { I32::from_f64(3.75f64) as i32 in Positive }
machine observe(value: i32 in Three) -> i32 { value as i32 }

machine main() crashes Trap {
    let returned: i32 = observe(exact(3.0f64));
    let other: i32 = observe(exact(4.0f64));
    let passed: i32 = observe(I32::from_f64(3.75f64) as i32 in Positive);
    let returned_truncated: i32 = observe(truncated());
    let direct: i32 = I32::from_f64(4.75f64);
    transition returned == 3 && other == 3 && passed == 3 && returned_truncated == 3
        && direct == 4 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
