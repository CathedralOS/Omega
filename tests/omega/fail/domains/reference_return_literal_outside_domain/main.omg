// A returned literal is the result's only evidence: `pick` promises
// `&[u8] in Utf8` and its arm returns "\xff", whose octets are not valid
// UTF-8. The return obligation judges the literal's bytes, so the machine is
// rejected rather than relying on storage the literal does not have. The
// admitted twin is pass/control_flow/runtime_branching_helper_string.
domain [u8]::Utf8
requires
    valid_utf8(self);
data Main {
    out: &[u8] in Utf8;
}

machine Main::main(main: &mut Main) {
    let flag: bool = true;
    let picked: &[u8] in Utf8 = Main::pick(flag);
    main.out = picked;
}

machine Main::pick(flag: bool) -> &[u8] in Utf8 {
    transition flag {
        true -> "Gate"
        false -> "\xff"
    }
}
