domain i32::Positive
requires
    self >= 0;

domain i32::Degrees;

machine + i32::Degrees::add(left: i32, right: i32) -> i32 {
    ((left as i32 in Wrapping) + (right as i32 in Wrapping)) as i32
}

domain i32::PositiveDegrees = Positive & Degrees;

data Main {
}

machine Main::main(&mut self) {
    let angle: i32 in PositiveDegrees = 90 as i32 in PositiveDegrees;
    let raw: i32 = angle;
}
