// Zero now selects Ready, so the untouched element must establish PositiveSmall.
domain u64::PositiveSmall(value) requires value > 0 && value < 8;

data Frame [copy] {
    case Ready(value: u64 in PositiveSmall);
    case Empty;
}

machine consume(frames: &[Frame; 2]) -> u64 {
    transition frames[1] {
        Frame::Empty -> 0
        Frame::Ready { value } -> (value + 1)
    }
}

machine main() crashes Trap {
    let mut frames: [Frame; 2];
    frames[0] = Frame::Ready { value: 3 };
    transition consume(&frames) == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
