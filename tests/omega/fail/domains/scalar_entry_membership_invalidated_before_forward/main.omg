// Expected exit: 0.
domain u64::AtLeast100(value) requires value >= 100 established by issue;
boundary trait Consume { machine subtract(mut value: u64) -> u64 reaches requires value in AtLeast100; }
machine reduce(value: u64 in AtLeast100) -> u64 { value - 100 }
Actual satisfies Consume {
    machine subtract(mut value: u64) -> u64 requires value in AtLeast100 { value = 99; reduce(value) }
}
machine issue(value: u64) -> u64 in AtLeast100 requires value >= 100 { value }
machine main() crashes Trap {
    let value: u64 in AtLeast100 = issue(100);
    let difference: u64 = Consume::subtract(value);
    transition difference == 0 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
