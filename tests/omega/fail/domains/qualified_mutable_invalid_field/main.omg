// Exact positive-length arrays are always nonempty. NoNul supplies the
// zero-excluding field invariant exercised by this establishment control.
domain [u8; 8]::NoNul(bytes) requires no_nul(bytes);
data Label { text: [u8; 8] in NoNul; }
data Packet { label: Label; }
machine Packet::consume(packet: &mut Packet) {}

machine main() {
    let mut packet: Packet;
    // A qualified declaration cannot waive ordinary argument establishment.
    Packet::consume(&mut packet);
}
