domain [u8; 8]::NonEmpty(bytes) requires non_empty(bytes);
data Label { text: [u8; 8] in NonEmpty; }
data Packet { label: Label; }
machine Packet::consume(packet: &mut Packet) {}

machine main() {
    let mut packet: Packet;
    // A qualified declaration cannot waive ordinary argument establishment.
    Packet::consume(&mut packet);
}
