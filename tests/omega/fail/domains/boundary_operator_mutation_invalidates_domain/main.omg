// A named boundary/operator call with a mutable operand must invalidate facts
// about that operand unless its own contract re-establishes them. Otherwise an
// arbitrary host mutation could preserve a stale NoNul claim.
// The stored `&mut` field is forwarded through a `&mut` binding: under exact
// call permissions a bare projection lends only immutable access.
domain [u8]::NoNul
requires
    no_nul(self);

boundary operator Text::overwrite(text: &mut [u8]) -> ();

data Main {
    text: &mut [u8];
}

machine Main::consume(text: &[u8])
requires
    text in NoNul
{
}

machine Main::main(&mut self)
requires
    self.text in NoNul
{
    let t: &mut [u8] = self.text;
    Text::overwrite(t);
    Main::consume(t);
}
