// Excluding a case never permits access to its payload.
domain i32::NonZero(value) requires value != 0;
data Divisor [copy] { case Unset; case By(amount: i32 in NonZero); }

machine quotient(divisor: Divisor) -> i32 {
    transition divisor in Divisor::By {
        false -> (490 / divisor.amount)
        true -> 0
    }
}

machine main() crashes Trap {
    transition quotient(Divisor::By { amount: 7 }) == 70
        && quotient(Divisor::Unset) == 0 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
