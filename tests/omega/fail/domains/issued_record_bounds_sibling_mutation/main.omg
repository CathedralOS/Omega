data Handle { value: u64; ignored: u64; }
domain Handle::Open(handle) requires handle.value != 0 established by issue;
machine clear(value: &mut u64) -> u64 { value = 0; 0 }
machine issue(input: u32) -> Handle in Open {
    let mut value: u64 = (input as u64) + 1;
    let ignored: u64 = clear(&mut value);
    Handle { value: value, ignored: ignored }
}
