use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "imported_provider_unissued_result");
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);

    Build::bind<Source::open>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol { install_name: "/usr/lib/libSystem.B.dylib", symbol: "_getpid" },
    });
}
