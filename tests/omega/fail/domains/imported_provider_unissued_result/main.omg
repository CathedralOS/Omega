use omega::language::core::external_binding;

public data Resource { identity: u64; }
public domain Resource::Open established by acquire;
machine acquire() -> Resource in Open { Resource { identity: 73 } }
public boundary trait Source { machine open() -> Resource in Open reaches; }
data ImportedSource {}
machine imported_binding() -> ForeignBinding<26, 7, 0> {
    ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
        install_name: "/usr/lib/libSystem.B.dylib", symbol: "_getpid",
    } }
}
macos_arm64 machine ImportedSource::open() -> Resource in Open
satisfies Source::open via imported_binding();
machine close(resource: Resource in Open) {}
data Main { }
machine Main::main(context: &mut Main) reaches Source { close(Source::open()); }
