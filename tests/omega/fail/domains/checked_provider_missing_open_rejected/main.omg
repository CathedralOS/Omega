// Reject: the open member calls a machine that does not satisfy Source::open.
public data Resource { identity: u64; }
public domain Resource::Open requires self.identity != 0 established by acquire;
machine acquire() -> Resource in Open { Resource { identity: 73 } }
public boundary trait Source { machine open() -> Resource in Open reaches; }
data CheckedSource {}
machine CheckedSource::open() -> Resource in Open satisfies Source::open { acquire() }
machine close(resource: Resource in Open) crashes Trap {
    transition resource.identity == 73 { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
data Main { }
machine Main::main(context: &mut Main) reaches Source crashes Trap {
    close(Source::open());
}

CheckedSourceSourceImplementation satisfies Source {
    machine open() -> Resource in Open reaches {
        CheckedSource::missing()
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Source crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
