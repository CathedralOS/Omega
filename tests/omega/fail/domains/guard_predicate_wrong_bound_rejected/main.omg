// The guard's predicate does not establish the domain: `source <= 5` admits
// values the predicate-only domain `requires v <= 3` refuses, so the
// transition into the qualified parameter must reject.
domain u64::Small(v) requires v <= 3;

machine producer(source: u64) -> u64 in Small crashes Trap {
    transition source <= 5 {
        true -> checked(source)
        _ -> bad()
    }
    machine checked(source: u64 in Small) -> u64 in Small { source }
    machine bad() -> u64 in Small { crash Trap; }
}

data Main { value: u64; }
machine Main::main(main: &mut Main) crashes Trap {
    let observed: u64 in Small = producer(2);
    transition observed == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
