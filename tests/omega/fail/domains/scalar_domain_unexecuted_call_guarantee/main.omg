domain i64::Issued(value) requires value >= 0 established by issue;
machine query(input: i64) -> i64 ensures result >= 0 {
    transition input >= 0 { true -> (input) _ -> (0) }
}
machine issue(input: i64) -> i64 in Issued {
    let value: i64 = match input >= 0 {
        true -> query(input),
        false -> input
    };
    value
}
