use omega::language::core::binding;
pub data Resource { identity: u64; }
pub domain Resource::Open established by acquire;
machine acquire() -> Resource in Open { Resource { identity: 73 } }
pub boundary trait Source { machine open() -> Resource in Open; }
machine close(resource: Resource in Open) {}
data Main { source: Binding<Source>; }
machine Main::main(context: &mut Main) reaches Source { close(Source::open(&context.source)); }
