// A compound transition guard is an ordinary call position: an owned formal
// that names an `established by` membership still requires the checked route
// to have established it. A literal construction cannot mint `Ticket::Issued`,
// so the call on the right of `&&` is refused exactly as a statement call is.
data Ticket { amount: i32; }
domain Ticket::Issued established by Ticket::issue;
machine Ticket::issue() -> Ticket ensures result in Ticket::Issued {
    Ticket { amount: 41 }
}
machine amount(ticket: Ticket in Issued) -> i32 {
    ticket.amount
}
machine main() crashes Trap {
    let issued: Ticket = Ticket::issue();
    transition amount(issued) == 41 && amount(Ticket { amount: 41 }) == 41 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
