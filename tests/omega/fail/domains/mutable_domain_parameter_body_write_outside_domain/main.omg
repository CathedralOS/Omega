// A `mut` parameter's declared domain stays on the binding inside the body:
// an assignment must preserve it. This is `mirror` from
// `pass/domains/mutable_domain_parameter_exit` with its update moved outside
// `Counted` (value + 200 can exceed 100); it must reject.
domain i32::Counted
    requires self >= 0;
    self <= 100;

machine mirror(mut value: i32 in Counted) -> i32 {
    value = value + 200;
    value
}

machine main() crashes Trap {
    let small: i32 = mirror(5);
    transition small == 205 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
