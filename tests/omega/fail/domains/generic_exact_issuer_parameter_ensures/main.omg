data Ticket { value: u64; }
data First {}
domain<P> Ticket::Issued<P> established by issue;
machine issue<P>(ticket: &Ticket) -> Ticket in Issued<P>
ensures ticket in Issued<P>
{ Ticket { value: ticket.value } }
machine main() {
    let ticket: Ticket = Ticket { value: 73 };
    let issued: Ticket in Issued<First> = issue<First>(&ticket);
}
