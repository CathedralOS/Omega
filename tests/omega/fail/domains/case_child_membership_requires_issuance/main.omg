// Equal bytes, another issuer, an inactive payload and an earlier write
// cannot supply the required child's exact membership.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;
domain Ticket::OtherIssued established by Ticket::other;

machine Ticket::issue() -> Ticket ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}
machine Ticket::other() -> Ticket ensures result in Ticket::OtherIssued {
    Ticket { amount: 41, marker: 9 }
}

data Event [copy] {
    common: Ticket in Issued;
    replaced: bool;
    case Packed(payload: Ticket in Issued);
    case Empty;
}
data Main { ticket: Ticket; }
machine observe(event: Event) {}
machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 41, marker: 9 };
    true
}

machine forged_common() {
    observe(Event::Packed {
        common: Ticket { amount: 41, marker: 9 },
        payload: Ticket::issue()
    });
}
machine forged_payload() {
    observe(Event::Packed {
        common: Ticket::issue(),
        payload: Ticket { amount: 41, marker: 9 }
    });
}
machine stale_common(main: &mut Main) {
    main.ticket = Ticket::issue();
    observe(Event::Packed {
        replaced: Main::replace(main),
        common: main.ticket,
        payload: Ticket::issue()
    });
}
machine wrong_payload_issuer() {
    observe(Event::Packed {
        common: Ticket::issue(),
        payload: Ticket::other()
    });
}
machine inactive_payload_forged_common() {
    observe(Event::Empty { common: Ticket { amount: 41, marker: 9 } });
}
