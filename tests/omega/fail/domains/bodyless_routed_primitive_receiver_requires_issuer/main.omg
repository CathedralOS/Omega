// Expected exit: 0
// A bodyless nominal domain retains its exact issuer without a numeric predicate.
use omega_language_std::console;
domain u64::IssuedIndex established by issue;
machine issue(value: u64) -> u64 in IssuedIndex { value }
machine replace(row: &mut u64 in IssuedIndex) {
    row = 1;
}
machine main() reaches Console {
    let mut row: u64 in IssuedIndex = issue(0);
    replace(&mut row);
    transition row { 1 -> done() _ -> wrong() }
    state done() { Console::exit_process(0); }
    state wrong() { Console::exit_process(71); }
}
