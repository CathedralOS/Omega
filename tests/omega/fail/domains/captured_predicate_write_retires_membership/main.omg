// A true captured Boolean does not preserve the earlier conjunct's domain
// fact after its later conjunct overwrites that fact's subject.
domain u64::Small(v) requires v <= 3;
data Value { number: u64; }
machine overwrite(value: &mut Value) -> u64 { value.number = 9; 0 }
machine producer(source: u64) -> u64 in Small crashes Trap {
    let mut value: Value = Value { number: source };
    transition value.number <= 3 && overwrite(&mut value) == 0 {
        true -> checked(value.number)
        _ -> bad()
    }
    machine checked(value: u64 in Small) -> u64 in Small { value }
    machine bad() -> u64 in Small { crash Trap; }
}
machine main() crashes Trap {
    let observed: u64 in Small = producer(2);
    transition observed == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
