// Binding-site operator selection (chapter 8): only declarations, mints, and
// signature `requires` select semantic operator meaning. Nothing selects
// `Quantity::Additive` for `left`, and `Quantity` has no builtin `+`, so the use
// is rejected. Adding
// `requires left in Quantity::Additive` makes this exact program compile (see
// pass/domains/domain_operator_proven_fact_selects_meaning).

data Quantity {
    value: i32;
}

domain Quantity::Additive
requires
    self.value >= 0;

machine + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity {
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}

data Main {
}

machine Main::combine(&self, left: Quantity, right: Quantity) {
    let sum: Quantity = left + right;
}

machine Main::main(&mut self) {
}
