data Player {
    health: i32;
}

domain Player::Valid(player)
requires
    player.health >= 0;
    player.health <= 100;

domain Player::Alive(player)
requires
    player in Player::Valid;
    player.health > 0;

data Main {
    player: Player;
}

machine mark_valid(player: &mut Player)
ensures
    player in Player::Valid
{
    player.health = 0;
}

machine break_valid(player: &mut Player) {
    player.health = 200;
}

machine heal(player: &mut Player)
requires
    player in Player::Valid
ensures
    player in Player::Alive
{
    player.health = 10;
}

machine Main::main(&mut self) {
    mark_valid(&mut self.player);
    break_valid(&mut self.player);
    heal(&mut self.player);
}
