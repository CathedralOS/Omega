data Player {
    health: i32;
}

domain Player::Valid(player)
requires
    player.health >= 0;
    player.health <= 100;

domain Player::Alive(player)
requires
    player in Player::Valid;
    player.health > 0;

data Main {
    player: Player;
}

machine mark_valid(player: &mut Player)
ensures
    player in Player::Valid
{
    player.health = 0;
}

// An ordinary same-named callable retains its writes; only align_of is a query.
machine size_of<T>(player: &mut Player, measured: u64) {
    player.health = 200;
}

machine heal(player: &mut Player)
requires
    player in Player::Valid
ensures
    player in Player::Alive
{
    player.health = 10;
}

machine Main::main(main: &mut Main) {
    mark_valid(&mut main.player);
    size_of<u8>(&mut main.player, align_of<u64>());
    heal(&mut main.player);
}
