// Field note (review 661a4d50c0af..7d03d489e3d9): unregistered — roster::
// registered_{pass,fail}_canaries_* fail on this pair; add both to the
// canary_suite rosters (CHECKED_ONLY_* or the domains roster) before relying on them.
// A local declared into a predicate domain must initialize from an
// established source: `raw` is a bare i64 with no hypothesis bounding it,
// so declaring `carried` in Km from it owes the predicate obligation the
// initializer cannot discharge.

domain i64::Km
requires
    self >= 0;

machine copy_unproved(raw: i64) {
    let carried: i64 in Km = raw;
}
