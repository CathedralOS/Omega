// The returned literal ends in 7, so it does not satisfy `self[3] == 0` and
// cannot enter the domain. Twin of run/domains/wide_array_literal_membership_exit.
domain [u16; 4]::Wide requires self[3] == 0;

machine main() crashes Trap {
    let returned: [u16; 4] in Wide = literal_wide();
    let local: [u16; 4] in Wide = [1u16, 2u16, 3u16, 0u16];
    let head: u16 = first(&returned);
    let tail: u16 = last(&returned);
    let other: u16 = first(&local);
    transition head == 111 && tail == 0 && other == 1 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

machine first(wide: &[u16; 4] in Wide) -> u16 { wide[0] }
machine last(wide: &[u16; 4] in Wide) -> u16 { wide[3] }

machine literal_wide() -> [u16; 4] in Wide {
    [111u16, 109u16, 101u16, 7u16]
}
