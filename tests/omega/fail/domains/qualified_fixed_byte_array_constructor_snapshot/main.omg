domain [u8; 4]::Utf8(bytes) requires valid_utf8(bytes);
data Row { bytes: [u8; 4] in Utf8; }
machine observe_before(bytes: &[u8; 4] in Utf8) -> bool
requires bytes == "Gate" { true }
machine observe_after(bytes: &[u8; 4] in Utf8) -> bool
requires bytes == "Gate" { true }
machine main() {
    let mut row: Row = Row { bytes: "Gate" };
    transition row.bytes == "Gate" {
        true -> checked(row)
        false -> done()
    }
    state checked(mut row: Row)
    requires row.bytes == "Gate" {
    let before: bool = observe_before(&row.bytes);
    row.bytes[0] = 76u8;
    let after: bool = observe_after(&row.bytes);
    }
    state done() {}
}
