// An explicit qualification into an operator-homing domain proves the
// domain's predicates; a literal zero refutes `value > 0`.
pub domain u64::Distance(value) requires value > 0;

pub operator + u64::Distance::add(left: u64 in u64::Distance, right: u64 in u64::Distance)
    -> u64 in u64::Distance;

machine measure(a: u64 in Distance) -> bool { (a as u64) > 1 }

machine main() -> bool {
    transition { _ -> measure(0 as u64 in Distance) }
}
