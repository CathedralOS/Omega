data Token {
    value: u64;
}

domain Token::Issued
established by TokenIssuer::issue;

trait TokenIssuer {
    machine issue(value: u64) -> Token
    ensures
        result in Token::Issued;
}

machine main() {
    let raw: Token = Token { value: 7 };
    let forged: Token in Issued = raw as Token in Issued;
}
