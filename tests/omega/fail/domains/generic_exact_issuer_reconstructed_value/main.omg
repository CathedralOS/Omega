data Ticket { value: u64; }
data First {}
data Second {}
domain<P> Ticket::Issued<P> established by issue;
machine issue<P>(value: u64) -> Ticket in Issued<P> { Ticket { value: value } }
machine rebuild<P>(ticket: Ticket in Issued<P>) -> Ticket in Issued<P> {
    Ticket { value: ticket.value }
}
machine main() { let ticket: Ticket in Issued<First> = rebuild<First>(issue<First>(73)); }
