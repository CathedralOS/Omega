// Expected exit: 0. Issued payload evidence survives an owned state transfer.
data Ticket [copy] { value: u64; }
domain Ticket::Issued established by mint;
data Choice { case Ready(ticket: Ticket); case Empty; }
data Envelope { choice: Choice; counter: u64; }

machine mint(value: u64) -> Ticket
ensures result in Issued
{ Ticket { value: value } }

machine inspect(envelope: &mut Envelope) -> u64 {
    envelope.counter = 1;
    transition { _ -> forwarded(envelope) }
    machine forwarded(envelope: &mut Envelope) -> u64 { observe(envelope) }
}

machine observe(envelope: &Envelope) -> u64 {
    transition envelope.choice {
        Choice::Ready { ticket } -> (ticket.value)
        Choice::Empty -> 0
    }
}
machine main() crashes Trap {
    let mut envelope: Envelope = Envelope { choice: Choice::Ready { ticket: Ticket { value: 73 } }, counter: 0 };
    let observed: u64 = inspect(&mut envelope);
    transition observed != 0 && observed % 8 == 1 && observed <= 128 {
        true -> forward(envelope)
        _ -> wrong()
    }
    machine forward(envelope: Envelope) {
        transition envelope.choice {
            Choice::Ready { ticket } -> verify(ticket)
            Choice::Empty -> wrong()
        }
    }
    machine verify(ticket: Ticket in Issued) {
        transition ticket.value == 73 { true -> done() _ -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
