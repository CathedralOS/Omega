// A record storing a borrowed erasing cast `View { t: &(issued as Ticket) }`
// cannot later supply the erased domain through field projection `observe(v.t)`.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine observe(ticket: &Ticket in Ticket::Held) -> u64 { ticket.number }
data View [copy] { t: &Ticket; }
machine main() {
    let issued: Ticket in Ticket::Held = issue();
    let v: View = View { t: &(issued as Ticket) };
    let n: u64 = observe(v.t);
}
