// A captured transition subject bounds `buffer.used` and then CALLS a machine
// that replaces it. The bound a taken arm mints must come from a predicate
// whose operands the capture cannot overwrite: recovery refuses a captured
// initializer that runs a machine body, so the indexed store's byte stays
// unbounded and the normal return keeps refusing the field's domain.
// (Without that refusal the stale `buffer.used < 128` would bound a byte that
// is 200 by the time the arm jumps, and the store would keep a class the value
// no longer has.)
domain [u8; 4]::Utf8(bytes) requires valid_utf8(bytes);

data Buffer { label: [u8; 4] in Utf8; used: u8; }

machine Buffer::overwrite(buffer: &mut Buffer) -> bool {
    buffer.used = 200;
    true
}

machine store(buffer: &mut Buffer) {
    buffer.label = "Gate";
    transition buffer.used < 128 && Buffer::overwrite(buffer) {
        true -> write(buffer, buffer.used)
        _ -> keep(buffer)
    }
    machine write(buffer: &mut Buffer, byte: u8) { buffer.label[1] = byte; }
    machine keep(buffer: &mut Buffer) { }
}