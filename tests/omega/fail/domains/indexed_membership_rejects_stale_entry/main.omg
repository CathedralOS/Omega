// Earlier siblings replace storage before the qualified operand completes.
// An entry value of 3 cannot establish Except<9> for the later value of 9.
domain<const Excluded: u64> u64::Except<Excluded>(value) requires value != Excluded;
data Source { value: u64; }
data Holder { changed: u64; scoped: u64 in Except<9>; }
data AfterCall { copied: u64 in Except<9>; }

machine overwrite(source: &mut Source) -> u64 in Except<9>
ensures source.value == 9 {
    source.value = 9;
    3
}

machine invalid_record() {
    let mut source: Source = Source { value: 3 };
    let holder: Holder = Holder { changed: overwrite(&mut source) as u64, scoped: source.value };
}

machine invalid_array() {
    let mut source: Source = Source { value: 3 };
    let values: [u64 in Except<9>; 2] = [overwrite(&mut source), source.value];
}

machine assign(source: &mut Source, value: u64)
ensures source.value == value {
    source.value = value;
}

machine invalid_after_call() {
    let mut source: Source = Source { value: 9 };
    assign(&mut source, 3);
    source.value = 9;
    let after: AfterCall = AfterCall { copied: source.value };
}
machine main() {}
