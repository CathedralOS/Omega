use omega::language::core::float_operations;

domain i32::Three(value) requires value == 3;
domain i32::Positive(value) requires value > 0;
domain i32::Never(value) requires false;
domain i32::Issued(value) requires value > 0 established by Issuer::issue;
trait Issuer { machine issue() -> i32 ensures result in Issued; }

machine wrong_conversion() -> i32 in Three {
    I32::from_f64(4.75f64) as i32 in Three
}

machine wrong_anonymous() -> i32 in Three { (1 + 3) as i32 in Three }

// The leaf name cannot supply the selected builtin's result guarantee.
machine from_f64(value: f64) -> i32 { 99 }
machine lookalike() -> i32 in Three {
    from_f64(3.75f64) as i32 in Three
}

machine unknown(value: i32) -> i32 in Positive { value as i32 in Positive }

machine overwritten() -> i32 in Positive {
    let mut value: i32 = 1;
    value = 0;
    value as i32 in Positive
}

machine later_guard(value: i32) {
    let premature: i32 in Positive = value as i32 in Positive;
    transition value > 0 { true -> done() false -> done() }
    machine done() {}
}

machine counterfeit() -> i32 in Issued {
    I32::from_f64(3.0f64) as i32 in Issued
}

machine false_predicate() -> i32 in Never {
    I32::from_f64(3.0f64) as i32 in Never
}

machine main() {}
