// A true first constituent cannot waive the later zero-excluding predicate.
domain u32::Small(value) requires value <= 5;
domain u32::NonZero(value) requires value != 0;
domain u32::SmallNonZero = u32::Small & u32::NonZero;

data Main { value: u32 in SmallNonZero; }
machine Main::main(main: &mut Main) {}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
