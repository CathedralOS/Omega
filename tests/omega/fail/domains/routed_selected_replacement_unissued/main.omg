// Expected exit: 0
// Owned routed payloads keep their membership across selected replacement and clear.
domain u64::Issued(value) requires value > 0 established by issue;
machine issue() -> u64 in Issued { 3 }
data Frame [copy] { case Empty; case Ready(value: u64 in Issued); }
machine replace(frames: &mut [Frame; 4096], position: u64, payload: u64 in Issued) -> u64
requires position < 4096 {
    frames[position] = Frame::Ready { value: payload };
    transition { _ -> read(frames, position) }
    machine read(frames: &mut [Frame; 4096], position: u64) -> u64
    requires position < 4096 {
        transition frames[position] {
            Frame::Empty -> 99
            Frame::Ready { value } -> clear(frames, position, value)
        }
    }
    machine clear(frames: &mut [Frame; 4096], position: u64, value: u64 in Issued) -> u64
    requires position < 4096 {
        frames[position] = Frame::Empty;
        transition { _ -> verify(frames, position, value) }
    }
    machine verify(frames: &mut [Frame; 4096], position: u64, value: u64 in Issued) -> u64
    requires position < 4096 {
        transition frames[position] {
            Frame::Empty -> (value - 1)
            Frame::Ready { value as _ } -> 99
        }
    }
}
machine main() crashes Trap {
    let mut frames: [Frame; 4096];
    let observed: u64 = replace(&mut frames, 3, 3);
    transition observed == 2 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
