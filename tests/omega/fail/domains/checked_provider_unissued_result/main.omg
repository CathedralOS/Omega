public data Resource { identity: u64; }
public domain Resource::Open(resource) requires resource.identity != 0 established by acquire;
machine acquire() -> Resource in Open { Resource { identity: 73 } }
public boundary trait Source { machine open() -> Resource in Open reaches; }
data FabricatedSource {}
machine FabricatedSource::open() -> Resource in Open satisfies Source::open {
    Resource { identity: 73 }
}
machine close(resource: Resource in Open) {}
data Main { }
machine Main::main(context: &mut Main) reaches Source { close(Source::open()); }
