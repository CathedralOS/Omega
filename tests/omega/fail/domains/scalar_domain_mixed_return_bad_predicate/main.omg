domain i64::Nonnegative(value) requires value >= 0 established by seed, choose;
machine seed() -> i64 in Nonnegative { 17 }
machine choose(old: bool, existing: i64 in Nonnegative) -> i64 in Nonnegative {
    transition old { true -> (existing) _ -> (-1) }
}
machine main() crashes Trap {
    let existing: i64 in Nonnegative = seed();
    let value: i64 in Nonnegative = choose(false, existing);
    transition value == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
