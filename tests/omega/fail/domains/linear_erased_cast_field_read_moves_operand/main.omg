// Reading a field of an erasing cast reads the operand's storage. For a
// linear token the cast moves `t`, so the field read is a use after that
// move, exactly as it is without the erasure.
use omega::language::core::drop;
data Token [linear] dropped by drop_token { value: u64; }
machine drop_token(token: &mut Token) {}
domain Token::Held established by issue;
machine issue(value: u64) -> Token in Token::Held { Token { value: value } }
machine read(token: &Token) -> u64 { token.value }
machine take(token: Token) -> u64 { let v: u64 = token.value; drop(token); v }
data Box [linear] { token: Token; tail: u64; }
machine main() {
    let t: Token in Token::Held = issue(3);
    let n: u64 = (t as Token).value;
}
