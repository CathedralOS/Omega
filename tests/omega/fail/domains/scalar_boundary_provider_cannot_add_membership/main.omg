// An issued scalar is at least 100; a boundary parameter preserves membership and justifies exact subtraction.
// Expected exit: 0.
const START: u64 = 100;
domain u64::AtLeast100(value) requires value >= 100 established by issue;
boundary trait Consume { machine subtract(value: u64 in AtLeast100) -> u64 reaches; }
domain u64::Extra(value) requires value >= 100 established by issue_extra;
machine issue_extra(value: u64) -> u64 in Extra requires value >= 100 { value }
Actual satisfies Consume {
    machine subtract(value: u64 in AtLeast100) -> u64 requires value in Extra { value - 100 }
}
machine issue(value: u64) -> u64 in AtLeast100 requires value >= 100 { value }

machine main() crashes Trap {
    let value: u64 in AtLeast100 = issue(START);
    let difference: u64 = Consume::subtract(value);
    transition difference == 0 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
