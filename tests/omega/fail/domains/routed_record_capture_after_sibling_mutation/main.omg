data Ticket [copy] { number: u64; }
domain Ticket::Issued(ticket) requires ticket.number != 0 established by issue;
machine issue() -> Ticket in Ticket::Issued { Ticket { number: 17 } }
machine clear(number: &mut u64) -> u64 { number = 0; 0 }
data Pair { ticket: Ticket in Ticket::Issued; changed: u64; }
machine capture() -> Pair {
 let mut ticket: Ticket in Ticket::Issued = issue();
 Pair { changed: clear(&mut ticket.number), ticket: ticket }
}
machine main() { }
