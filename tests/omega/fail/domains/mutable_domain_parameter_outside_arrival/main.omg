// A `mut` parameter's declared domain is still the caller's arrival
// obligation: rebinding inside the body does not let a caller pass a value
// outside `Counted`. This is `pass/domains/mutable_domain_parameter_exit` with
// one argument moved outside the domain (105 > 100); it must reject.
domain i32::Counted
    requires self >= 0;
    self <= 100;

machine mirror(mut value: i32 in Counted) -> i32 {
    value = 100 - value;
    value
}

machine relay(value: i32 in Counted) -> i32 {
    transition { _ -> rewrite(value) }
    machine rewrite(mut held: i32 in Counted) -> i32 {
        held = 100 - held;
        held
    }
}

machine main() crashes Trap {
    let small: i32 = mirror(5);
    let large: i32 = mirror(105);
    let relayed: i32 = relay(30);
    transition small == 95 && large == 79 && relayed == 70 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
