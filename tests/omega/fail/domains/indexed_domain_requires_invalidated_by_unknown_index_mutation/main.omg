// An unknown bounded input can alias items[0]; it is not identity_index(1).
data Item [copy] {
    value: i32;
    tag: i32;
}

domain Item::Valid(item)
requires
    item.value > 0;

data Main {
    items: [Item; 2];
}

machine Main::mark_valid(item: &mut Item)
ensures
    item in Item::Valid
{
    item.value = 1;
}

machine Main::accept(item: Item)
requires
    item in Item::Valid
{
}

machine Main::identity_index(index: u64) -> u64 {
    index
}

machine Main::main(main: &mut Main, unknown: u64)
requires unknown < 2u64
{
    let index: u64 = Main::identity_index(unknown);
    Main::mark_valid(&mut main.items[0]);
    main.items[index].value = 0;
    Main::accept(main.items[0]);
}
