// A view local declared `in Utf8` keeps that domain at every store: bytes
// with no UTF-8 evidence cannot replace its descriptor.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main { buffer: [u8; 4]; }

machine Main::main(main: &mut Main) reaches Console {
    let mut out_line: &[u8] in Utf8 = "Door";
    out_line = main.buffer[0..2];
    transition out_line == "Do" {
        true -> good(main)
        false -> bad(main)
    }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(71); }
}
