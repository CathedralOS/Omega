data Ticket { value: u64; }
data First {}
domain<P> Ticket::Issued<P> established by issue;
machine consume<P>(ticket: Ticket in Issued<P>) -> u64 { ticket.value }
machine issue<P>(value: u64) -> Ticket in Issued<P> {
    let ticket: Ticket = Ticket { value: value };
    let observed: u64 = consume<P>(ticket);
    Ticket { value: observed }
}
machine main() { let ticket: Ticket in Issued<First> = issue<First>(73); }
