domain u64::NonZero requires self != 0;
data Handle { value: u64; }
domain Handle::Open
requires self.value != 0
established by translate;
machine translate(items: &[u64], position: u64) -> Handle in Open
requires position < items.len
requires items[position] in NonZero {
    // items[0] may be nonzero while position itself is zero.
    Handle { value: position }
}
