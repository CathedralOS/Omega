// `issued as Ticket` erases the issued meaning; passed straight to a call
// that requires `Ticket::Held`, it must not find it again on `issued`.
data Ticket [copy] { number: u64; }
domain Ticket::Held established by issue;
machine issue() -> Ticket in Ticket::Held { Ticket { number: 17 } }
machine consume(t: Ticket in Ticket::Held) {}
machine main() {
    let issued: Ticket in Ticket::Held = issue();
    consume(issued as Ticket);
}
