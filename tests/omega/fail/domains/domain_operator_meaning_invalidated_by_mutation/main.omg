// Flow-established membership never activates operator meaning. The call to
// `mark_additive` proves a predicate fact about `self.total`, but no declaration,
// mint, or signature `requires` selects the semantic `Quantity::Additive`
// theory for that binding. The later mutation is deliberately irrelevant to
// resolution: this use would remain rejected even without `scramble`.

data Quantity {
    value: i32;
}

domain Quantity::Additive
requires
    self.value >= 0;

operator + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity;

data Main {
    total: Quantity;
}

machine Main::mark_additive(&mut self, quantity: &mut Quantity)
ensures
    quantity in Quantity::Additive
{
    quantity.value = 0;
}

machine Main::scramble(&mut self, quantity: &mut Quantity) {
    quantity.value = -1;
}

machine Main::main(&mut self) {
    self.mark_additive(&mut self.total);
    self.scramble(&mut self.total);
    let sum: Quantity = self.total + self.total;
}
