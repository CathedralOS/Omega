// A resolved declaration retains its crash contract despite reserved spelling.
trait ByteCheck {
    machine valid_utf8(bytes: [u8; 4]) -> bool crashes Trap;
}
Crashing satisfies ByteCheck {
    machine valid_utf8(bytes: [u8; 4]) -> bool crashes Trap { crash Trap; }
}
machine main() crashes Trap false {
    let result: bool = Crashing::valid_utf8([65u8, 0u8, 0u8, 0u8]);
}
