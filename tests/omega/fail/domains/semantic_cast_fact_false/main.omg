// The mint's PREDICATE face: `5 as i64 in Km` with `value >= 10` is a
// FALSE fact at the literal -- decision 19's "predicate obligation not
// discharged" refusal class.
use omega_language_std::console;
data Main { }
domain i64::Km(value)
requires
    value >= 10;
machine Main::main(main: &mut Main) {
    let distance: i64 = 5 as i64 in Km;
    transition distance == 5 { true -> good(main) _ -> bad(main) }
    state good(main: &mut Main) { Console::exit_process(70); }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
