// ASCII includes zero; copying a nested field cannot establish NoNul.
domain [u8; 4]::Ascii requires ascii_only(self);
domain [u8; 4]::NoNul requires no_nul(self);
data Source { bytes: [u8; 4] in Ascii; }
machine narrow(source: &Source) -> [u8; 4] in NoNul { source.bytes }
machine main() { let source: Source; _ = narrow(&source); }
