public data Socket [copy] {
    connected: bool;
    authenticated: bool;
}

public domain Socket::Connected
requires
    self.connected;

public domain Socket::Authenticated
requires
    self.authenticated;

public domain Socket::Usable =
    Socket::Connected & Socket::Authenticated;

machine consume(socket: Socket)
requires
    socket in Socket::Usable
{
}

data Main {
    socket: Socket;
}

machine Main::main(main: &mut Main)
requires
    main.socket in Socket::Connected
{
    consume(main.socket);
}
