pub data Socket {
    connected: bool;
    authenticated: bool;
}

pub domain Socket::Connected(socket)
requires
    socket.connected;

pub domain Socket::Authenticated(socket)
requires
    socket.authenticated;

pub domain Socket::Usable =
    Socket::Connected & Socket::Authenticated;

machine consume(socket: Socket)
requires
    socket in Socket::Usable
{
}

data Main {
    socket: Socket;
}

machine Main::main(main: &mut Main)
requires
    main.socket in Socket::Connected
{
    consume(main.socket);
}
