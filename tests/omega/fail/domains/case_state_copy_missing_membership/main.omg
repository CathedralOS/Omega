data Range [copy] { start: u64; length: u64; }
domain Range::Nonempty(range) requires range.length > 0;
// This payload carries no Nonempty evidence; selecting its case adds none.
data Outcome { case Ready(range: Range); case Rejected; }
machine inspect(outcome: Outcome) -> u64 {
    transition outcome {
        Outcome::Ready { range } -> consume(range)
        Outcome::Rejected -> 0
    }
    machine consume(range: Range in Nonempty) -> u64 { range.length - 1 }
}
