// Chapter 8: competing *participating* domain meanings for one use are a
// compile error. Each operand selects one semantic facet, and both domains bind
// `+` over the same `(Quantity, Quantity)` operand tuple, so this use is
// ambiguous. Merely declaring both domains is legal; see the matching pass
// canary `domain_operator_inactive_same_carrier_coexists`. Keeping the facets
// on different bindings also avoids the independently invalid act of selecting
// two denotation/dimension domains on one binding.

data Quantity {
    value: i32;
}

domain Quantity::Linear
requires
    self.value >= 0;

operator + Quantity::Linear::add(left: Quantity, right: Quantity) -> Quantity;

domain Quantity::Cyclic
requires
    self.value >= 0;

operator + Quantity::Cyclic::add(left: Quantity, right: Quantity) -> Quantity;

data Main {}

machine Main::combine(
    &self,
    left: Quantity in Linear,
    right: Quantity in Cyclic
) {
    let sum: Quantity = left + right;
}

machine Main::main(&mut self) {}
