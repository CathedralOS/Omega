data Ticket { value: u64; }
data First {}
domain<P> Ticket::Issued<P> established by issue;
machine issue<P>() -> Ticket ensures result in Issued<P> { Ticket { value: 73 } }
machine forward<P>(ticket: Ticket in Issued<P>) -> Ticket in Issued<P> { ticket }
machine main() {
    let ticket: Ticket = issue<First>();
    let moved: Ticket in Issued<First> = forward<First>(ticket);
    let duplicate: Ticket in Issued<First> = forward<First>(ticket);
}
