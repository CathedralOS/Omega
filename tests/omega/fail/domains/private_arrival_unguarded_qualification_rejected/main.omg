// Invalid: the private helper gains a second arrival from the unguarded arm, so
// the caller's `value > 0` no longer holds on every arrival and the
// qualification cast cannot prove `Positive`.
domain i32::Positive requires self > 0;

machine guarded(value: i32) -> i32 {
    transition value > 0 { true -> positive(value) false -> positive(value) }
    machine positive(value: i32) -> i32 { (value as i32 in Positive) as i32 }
    machine empty() -> i32 { 0 }
}

machine main() crashes Trap {
    let taken: i32 = guarded(4);
    let fallback: i32 = guarded(-2);
    transition taken == 4 && fallback == 0 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
