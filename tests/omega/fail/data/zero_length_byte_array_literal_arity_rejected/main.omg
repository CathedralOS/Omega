// A fixed-array literal must supply exactly the declared element count:
// `[1]` hands one element to a `[u8; 0]` place and must reject -- literal
// copying neither truncates nor pads.
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(&mut self) reaches Console { let xs: [u8; 0] = [1]; self.console.exit_process(0); }
