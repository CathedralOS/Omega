// A qualified PAYLOAD-BEARING case member without construction denotes only
// its domain, so `==` against it is a category error that suggests `in`.
// (The brace form `Command::Move { dx: 1 }` is a constructed value and gets
// the separate structural-equality interim error instead.)

data Command {
    case None;
    case Move(dx: i32);
}

data Main {
    cmd: Command;
}

machine Main::main(&mut self) {
    let mut hit: bool = self.cmd == Command::Move;
}
