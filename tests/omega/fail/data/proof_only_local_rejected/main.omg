// N1 local face: a local slot is runtime storage; proof-only `Nat` has
// no layout to store.
use omega::language::std::console;
data Nat { case Zero; case Succ(prev: Nat); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let n: Nat = Nat::Zero;
    self.console.exit_process(0);
}
