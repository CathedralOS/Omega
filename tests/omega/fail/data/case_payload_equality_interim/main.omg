// Interim equality rule (frozen decision 8): `==` against a PAYLOAD-BEARING
// case is a compile error until structural `equals` synthesis lands (a tag
// compare would silently ignore the payload). Payload-less cases keep the
// free tag compare.

data Command {
    case None;
    case Move(steps: i32);
}

data Main {
    cmd: Command;
}

machine Main::main(&mut self) {
    let mut hit: bool = self.cmd == Command::Move { steps: 1 };
}
