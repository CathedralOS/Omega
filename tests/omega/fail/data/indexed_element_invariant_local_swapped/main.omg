// The read invariant gives current <= maximum, not the reverse, so swapping
// the fields cannot be proved to satisfy the default domain.
data Vitality [copy]
requires maximum >= 0, current >= 0 && current <= maximum {
    current: i32;
    maximum: i32;
}

data Actor [copy] {
    vitality: Vitality;
}

data Set {
    items: [Actor; 2];
}

machine heal(set: &mut Set, selected: u64) requires selected < 2 {
    let vitality: Vitality = set.items[selected].vitality;
    set.items[selected].vitality = Vitality { current: vitality.maximum, maximum: vitality.current };
}

machine main() {}
