// Opaque boundary data has no public representation. A package cannot mint a
// value by spelling an empty record literal.
boundary data Token;
boundary data GenericToken<T>;
data Envelope { token: GenericToken<i32>; }

machine main() {
    let token: Token = Token { };
    // Generic member deferral cannot supply constructor authority, including
    // below an otherwise ordinary record literal.
    let generic: Envelope = Envelope { token: GenericToken {} };
}
