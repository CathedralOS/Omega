// A call in an earlier field invalidates a later read's old scalar bound.
data Bounded where value <= 5 { stamp: u64; value: u64; }
machine overwrite(value: &mut u64) -> u64 {
    value = 7;
    0
}
machine invalid() -> Bounded {
    let mut current: u64 = 5;
    transition current <= 5 {
        true -> Bounded { stamp: overwrite(&mut current), value: current }
        false -> Bounded { stamp: 0, value: 0 }
    }
}
