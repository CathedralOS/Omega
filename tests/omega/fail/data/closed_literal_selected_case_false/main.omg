data Cell [copy] where value <= 7 { value: u64; }
data Packet [copy] requires (count <= 2) && (
        ((self in Packet::Ready) && self.marker == 9)
    )
{
    count: u64;
    cells: [Cell; 2];
    case Ready(marker: u64);
}

machine main() {
    let packet: Packet = Packet::Ready {
        cells: [Cell { value: 7 }, Cell {}],
        marker: 8,
        count: 2
    };
}
