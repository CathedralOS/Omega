// A computed window carried inside a record has length 2, and write_pair writes its original backing.
// Reject: the computed window has length 1, so hold cannot establish the length-2 fact.
use omega::language::core::float_operations;
use omega::language::core::numeric_conversion;

data Held<'samples> { values: &'samples mut [f64]; }
data Outcome<'samples> {
    case Some(held: Held<'samples>) where held.values.len == 2;
    case Empty;
}

machine window<'samples>(samples: &'samples mut [f64; 4], which: i64) -> &'samples mut [f64]
ensures result.len == 1
{
    match which {
        0 -> &mut samples[0..which + 1]
        _ -> &mut samples[2..3]
    }
}

machine hold<'samples>(samples: &'samples mut [f64]) -> Held<'samples>
requires samples.len == 2
ensures result.values.len == 2
{
    Held { values: samples }
}

machine write_pair<'samples>(held: Held<'samples>)
requires held.values.len >= 2
{
    held.values[0] = 0.0;
    held.values[1] = 1.0;
}

machine acquire<'samples>(samples: &'samples mut [f64; 4]) -> Outcome<'samples> {
    Outcome::Some { held: hold(window(samples, 0)) }
}

machine apply<'samples>(outcome: Outcome<'samples>) {
    transition outcome {
        Outcome::Some { held } -> selected(held)
        Outcome::Empty -> done()
    }
    machine selected(held: Held<'samples>) {
        write_pair(held);
    }
    machine done() {}
}

machine main() crashes Trap {
    let mut samples: [f64; 4] = [9.0, 9.0, 9.0, 9.0];
    let outcome: Outcome = acquire(&mut samples);
    apply(outcome);
    let first: i32 in Saturating = I32::from_f64(samples[0]);
    let second: i32 in Saturating = I32::from_f64(samples[1]);
    let third: i32 in Saturating = I32::from_f64(samples[2]);
    let fourth: i32 in Saturating = I32::from_f64(samples[3]);
    transition first == 0 && second == 1 && third == 9 && fourth == 9 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
