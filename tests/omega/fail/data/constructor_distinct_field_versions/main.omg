data Snapshot where before == after {
    before: u64;
    effect: u64;
    after: u64;
}

machine replace(value: &mut u64) -> u64 ensures value == 1 {
    value = 1;
    0
}

machine main() {
    let mut value: u64 = 0;
    let snapshot: Snapshot = Snapshot {
        before: value,
        effect: replace(&mut value),
        after: value
    };
}
