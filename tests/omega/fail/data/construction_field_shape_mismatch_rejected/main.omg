// Constructing a struct with an ARRAY value in a scalar field (`P { x: self.xs }`)
// used to compile silently. The shape check now covers construction fields.
use omega::language::std::console;
data P { x: i32; }
data Main { console: Console; xs: [i32; 3]; }
machine Main::main(&mut self) { let p: P = P { x: self.xs }; self.console.exit_process(0); }
