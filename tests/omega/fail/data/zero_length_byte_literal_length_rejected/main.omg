// A quoted byte literal must supply exactly the declared byte count:
// `"a"` hands one byte to an owned `[u8; 0]` place and must reject -- literal
// copying neither truncates nor pads.
use omega::language::std::console;
use omega::language::core::binding;
data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console { let xs: [u8; 0] = "a"; main.console.exit_process(0); }
