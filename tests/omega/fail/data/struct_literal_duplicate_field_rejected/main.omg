// A field named more than once in a struct literal is ambiguous -- only the
// FIRST value is stored, the rest silently dropped (`Point { x: 1, x: 2 }` kept
// x == 1). Rejected now, mirroring the duplicate-member rejection on the data
// DECLARATION.
use omega_language_std::console;
data Point { x: i32; y: i32; }
data Main { }
machine Main::main(main: &mut Main) { let p: Point = Point { x: 1, x: 2, y: 3 }; let r: i32 = p.x; Console::exit_process(r); }
