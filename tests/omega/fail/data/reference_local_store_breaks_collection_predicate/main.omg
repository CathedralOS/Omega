// `poke` writes `b.cells[0]` through the reference local `v`, so `B`'s
// collection predicate must be re-proved at the return. 300 breaks it.
machine first_small(cells: &[u64; 4]) -> bool { cells[0] <= 4 }

data B requires first_small(&cells) == true {
    cells: [u64; 4];
}

machine poke(b: &mut B) {
    let v: &mut [u64; 4] = &mut b.cells;
    v[0] = 300;
}

machine main() {}
