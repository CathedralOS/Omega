// A port read must be declared where it is emitted: this is the
// asm_port_in_immediate program with an explicitly empty reach ceiling on the
// machine that performs `in`, so checking must refuse it.

data Main {
    byte: u8;
}

machine Main::main(main: &mut Main) reaches {
    asm clobbers rax, rdx, r10, r15 {
        in main.byte, 0x3F8
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches PortIo {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
