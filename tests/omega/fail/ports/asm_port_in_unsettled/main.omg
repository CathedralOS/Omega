// `in` resolves its declared `u8` result type, but no checked unit operation
// arm exists for a port read yet: the machine reports an Incomplete plan gap
// at the call's planning phase rather than carrying a settled port effect
// into the artifact.
use omega::language::core::assembly;

data Main {
    byte: u8;
}

machine Main::main(main: &mut Main) reaches PortIo {
    asm where clobbers rax, rdx, r10, r15 {
        in main.byte, 0x3F8
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches PortIo {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
