// Exit authority alone does not admit a missing value in storage whose lender
// may survive the domain. A syntactic later crash supplies no such admission.
use omega::language::core::process_exit;
data Token [linear] { value: u64; }
data Holder { token: Token; }
machine ordinary(holder: &mut Holder) reaches ProcessExit {
    let detached: Token = holder.token;
    ProcessExit::exit_process(0);
}
machine composed(holder: &mut Holder) reaches ProcessExit {
    transition { _ -> finish(holder) }
    machine finish(holder: &mut Holder) {
        let detached: Token = holder.token;
        ProcessExit::exit_process(0);
    }
}
