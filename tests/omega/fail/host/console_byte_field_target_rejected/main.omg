// FAIL canary: `self.r = block self.console.read_byte()` (a FIELD assignment
// target) is outside read_byte's served shape -- the composite owns the
// whole ByteRead result and serves the `let r: ByteRead = ...` LOCAL slot
// only today. The refusal must stay LOUD (the alternative is a silently-ZII
// field, the cardinal sin); it surfaces as the unit-plan local-construction
// omission at the assignment, reported through ProgramEntry establishment.
// Remove when field-target byte reads gain a lowering.
use omega_language_std::console;
use omega::language::core::service;

data Main {
    console: Service<Console>;
    r: ByteRead;
}

machine Main::main(&mut self)
reaches Console
{
    self.r = block self.console.read_byte();
    transition self.r {
        ByteRead::Byte { value } -> got(value)
        _ -> fin()
    }
    state got(&mut self, value: i32 [0..=255]) { self.console.exit_process(value); }
    state fin(&mut self) { self.console.exit_process(70); }
}
