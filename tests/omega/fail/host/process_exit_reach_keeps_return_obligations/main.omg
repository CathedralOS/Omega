use omega::language::core::process_exit;
data Token [linear] { value: i32; }
machine returning() {}
machine maybe_exit(exit: bool) reaches ProcessExit {
    transition exit {
        true -> ProcessExit::exit_process(0)
        _ -> returning()
    }
}
machine main() reaches ProcessExit {
    let token: Token = Token { value: 7 };
    maybe_exit(false);
}
