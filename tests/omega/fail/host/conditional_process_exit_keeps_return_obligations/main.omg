// The selected exit arm has no successor; the returning arm still owes Token.
use omega::language::core::process_exit;
data Token [linear] { value: u64; }
machine returning() {}
machine conditional(should_exit: bool) reaches ProcessExit {
    let token: Token = Token { value: 42 };
    transition should_exit {
        true -> ProcessExit::exit_process(0)
        _ -> returning()
    }
}
machine main() {}
