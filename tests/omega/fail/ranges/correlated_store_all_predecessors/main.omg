data Limited where value <= 320 { value: u64; }
data Input where total <= 320, amount <= 1000 { total: u64; amount: u64; }
machine write(output: &mut Limited, input: &Input, choose_first: bool)
requires input.amount <= 321 - input.total
{
    transition choose_first {
        true -> guarded(output, input)
        false -> unguarded(output, input)
    }
    machine guarded(output: &mut Limited, input: &Input) {
        transition input.amount <= 320 - input.total {
            true -> store(output, input)
            false -> done()
        }
    }
    machine unguarded(output: &mut Limited, input: &Input) {
        transition { _ -> store(output, input) }
    }
    machine store(output: &mut Limited, input: &Input) {
        output.value = input.total + input.amount;
    }
    machine done() {}
}
