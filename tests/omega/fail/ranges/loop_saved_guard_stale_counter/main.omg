// The saved Boolean observes the old index, not the next loop arrival.
data Main { items: [u8; 3]; index: u64 in Trapping; }
machine Main::main(main: &mut Main) {
    main.index = 0;
    transition { _ -> body(main) }
    machine body(main: &mut Main) {
        main.items[main.index] = 7;
        transition { _ -> test(main) }
    }
    machine test(main: &mut Main) {
        let has_next: bool = main.index < 3;
        main.index = main.index + 1;
        transition has_next { true -> body(main) false -> done(main) }
    }
    machine done(main: &mut Main) {}
}
