data Limited where value <= 320 { value: u64; }
data Input where total <= 320, amount <= 1000 { total: u64; amount: u64; }
machine clobber(input: &mut Input) -> u64 ensures result <= 1000 {
    input.amount = 321;
    input.amount
}
machine write(output: &mut Limited, input: &mut Input)
requires input.amount <= 320 - input.total
{
    output.value = input.total + clobber(input);
}
