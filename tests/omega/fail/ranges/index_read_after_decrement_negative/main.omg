// MUST be rejected. A DECREASING counter: the loop guard `i >= 0` holds at the
// body's ENTRY, but the body reads `nums[i]` AGAIN after `i = i - 1` -- when `i`
// entered at 0 that second read is `nums[-1]`, out of bounds (negative). The
// loop-invariant upper bound (i < N) does not bound i below, and the guard's
// `i >= 0` is stale after the decrement, so the post-mutation read must not
// prove. Regression guard exposed by the decreasing-counter loop invariant.

use omega::language::std::console;

data Main {
    console: Console;
    nums: [i32; 4] in Trapping;
    i: i32 in Trapping;
    a: i32;
    b: i32;
}

machine Main::main(&mut self) {
    self.nums[0] = 1;
    self.nums[1] = 2;
    self.nums[2] = 3;
    self.nums[3] = 4;
    self.i = 3;

    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        transition self.i >= 0 {
            true -> body()
            _ -> done()
        }
    }

    state body(&mut self) {
        self.a = self.nums[self.i];
        self.i = self.i - 1;
        self.b = self.nums[self.i];
        transition {
            _ -> loop_()
        }
    }

    state done(&mut self) {
        self.console.exit_process(0);
    }
}
