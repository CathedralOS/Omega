// SOUNDNESS PIN for the sum-payload narrowing (landed 2026-07-08, migrated
// off the revoked `[0..=50]`/`[0..=1000]` suffixes). Payload membership in
// `Fifty` is admitted ONLY under a case-proving guard (a transition arm).
// DIRECT payload access outside a case-arm (`self.got = self.p.v`) has no
// such guard -- the active case may not be the one that owns `v` -- so the
// access is a checked partial op (here `p = Two{w:900}`, reading `One`'s
// payload field on a `Two`-active value traps at runtime) and the read must
// NOT be admitted. If the narrowing ever leaks to direct access, this would
// falsely compile. MUST reject with the expected fragment.
use omega::language::std::console;
use omega::language::core::service;
domain i32::Fifty requires 0 <= self && self <= 50;
domain i32::Thousand requires 0 <= self && self <= 1000;
data P { case One(v: i32 in Fifty); case Two(w: i32 in Thousand); }
data Main { console: Binding<Console>; got: i32 in Fifty; p: P; }
machine Main::main(&mut self) reaches Console {
    self.p = P::Two { w: 900 };
    self.got = self.p.v;
    self.console.exit_process(self.got);
}
machine Main::run(&mut self) { self.main(); }
