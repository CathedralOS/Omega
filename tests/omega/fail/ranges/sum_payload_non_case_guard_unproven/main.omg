// SOUNDNESS PIN for the sum-payload narrowing (landed 2026-07-08, migrated
// off the revoked `[0..=50]`/`[0..=1000]` suffixes). The narrowing requires a
// guard that proves `main.p`'s CASE -- not just any guard. Here `main.p.v` is
// passed as a transition argument under a guard on a DIFFERENT place
// (`main.flag`), which says nothing about `main.p`'s case (`p = Two{w:900}`,
// so `main.p.v` reads `One`'s field on a `Two`-active value -- a checked
// partial op). The payload must NOT be admitted: no `Equal(main.p, P::Case)`
// conjunct exists, so the argument's domain membership stays unestablished.
// MUST reject with the expected fragment.
use omega::language::std::console;
use omega::language::core::binding;
domain i32::Fifty(value) requires 0 <= value && value <= 50;
domain i32::Thousand(value) requires 0 <= value && value <= 1000;
data P { case One(v: i32 in Fifty); case Two(w: i32 in Thousand); }
data Main { console: Binding<Console>; flag: bool; p: P; }
machine Main::main(main: &mut Main) reaches Console {
    main.p = P::Two { w: 900 };
    main.flag = true;
    transition main.flag {
        true -> use_v(main, main.p.v)
        false -> use_v(main, 0)
    }
    state use_v(main: &mut Main, x: i32 in Fifty) { main.console.exit_process(x); }
}
machine Main::run(main: &mut Main) { Main::main(main); }
