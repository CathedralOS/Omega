// MUST be rejected. The original SIGSEGV: a SIGNED decreasing counter whose loop
// guard floors it BELOW zero (`j >= -10`), so it runs 3,2,1,0,-1,...,-10 and
// reads `nums[-1]..nums[-10]` -- out of bounds (negative), a confirmed segfault
// before the lower-bound check existed. The loop-invariant upper bound (j < 4)
// does NOT bound j below, and the guard `j >= -10` does not establish `j >= 0`,
// so the signed index has no `>= 0` proof and the access must be rejected.
// (An unsigned index would be non-negative by type; a signed one must prove it.)

use omega_language_std::console;

data Main {
    nums: [i32; 4];
    j: i32 in Trapping;
    sum: i32 in Trapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.nums[0] = 1;
    main.nums[1] = 2;
    main.nums[2] = 3;
    main.nums[3] = 4;
    main.j = 3;
    main.sum = 0;

    transition {
        _ -> loop_(main)
    }

    state loop_(main: &mut Main) {
        transition main.j >= 0 - 10 {
            true -> body(main)
            _ -> done(main)
        }
    }

    state body(main: &mut Main) {
        main.sum = main.sum + (main.nums[main.j] as i32 in Trapping);
        main.j = main.j - 1;
        transition {
            _ -> loop_(main)
        }
    }

    state done(main: &mut Main) {
        Console::exit_process(0);
    }
}
