// A case literal proves its payload member's domain before the value exists:
// `Level::Lit { amount: 11 }` names a value outside `Ten`, so construction
// rejects rather than establishing a payload whose bounded carrier cannot
// hold it. The in-range twin is `pass/structs/case_field_type_store_shapes`.
// MUST reject with the expected fragment.
use omega_language_std::console;

domain i32::Ten(value) requires 0 <= value && value <= 10;

data Level {
    case Dark;
    case Lit(amount: i32 in Ten);
}

data Main {
    level: Level;
}

machine Main::main(main: &mut Main) reaches Console {
    main.level = Level::Lit { amount: 11 };
    Console::exit_process(0);
}
