// SOUNDNESS (G1): an INCREMENTING counter has no decreasing-counter invariant.
// `main.i` starts at 0 and the body does `main.i = main.i + 1` (an INCREMENT,
// not a decrement), guarded by `main.i != 7` -- so `i` reaches 4, 5, 6 while
// indexing `[i32; 4]`, which is out of bounds. The loop-invariant fact must NOT
// seed for an increment, so the index obligation stays UNPROVEN and the program
// is rejected.

use omega::language::std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    nums: [i32; 4];
    i: i32 in Trapping;
    acc: i32 in Trapping;
}

machine Main::main(main: &mut Main) reaches Console {
    main.nums[0] = 1;
    main.nums[1] = 2;
    main.nums[2] = 3;
    main.nums[3] = 4;
    main.i = 0;
    main.acc = 0;

    transition {
        _ -> loop_(main)
    }

    state loop_(main: &mut Main) {
        transition main.i != 7 {
            true -> body(main)
            _ -> done(main)
        }
    }

    state body(main: &mut Main) {
        main.acc = main.acc + (main.nums[main.i] as i32 in Trapping);
        main.i = main.i + 1;
        transition {
            _ -> loop_(main)
        }
    }

    state done(main: &mut Main) {
        transition main.acc == 10 {
            true -> good(main)
            _ -> bad(main)
        }
    }

    state good(main: &mut Main) {
        main.console.exit_process(70);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(71);
    }
}
