// SOUNDNESS (G1): an INCREMENTING counter has no decreasing-counter invariant.
// `self.i` starts at 0 and the body does `self.i = self.i + 1` (an INCREMENT,
// not a decrement), guarded by `self.i != 7` -- so `i` reaches 4, 5, 6 while
// indexing `[i32; 4]`, which is out of bounds. The loop-invariant fact must NOT
// seed for an increment, so the index obligation stays UNPROVEN and the program
// is rejected.

use omega::language::std::console;

data Main {
    console: Console;
    nums: [i32; 4] in Trapping;
    i: i32 in Trapping;
    acc: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.nums[0] = 1;
    self.nums[1] = 2;
    self.nums[2] = 3;
    self.nums[3] = 4;
    self.i = 0;
    self.acc = 0;

    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        transition self.i != 7 {
            true -> body()
            _ -> done()
        }
    }

    state body(&mut self) {
        self.acc = self.acc + self.nums[self.i];
        self.i = self.i + 1;
        transition {
            _ -> loop_()
        }
    }

    state done(&mut self) {
        transition self.acc == 10 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
