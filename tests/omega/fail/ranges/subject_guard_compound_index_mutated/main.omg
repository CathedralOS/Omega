data Main {
    a: i32 in Wrapping;
    b: i32 in Wrapping;
    grid: [i32; 200] in Wrapping;
}

machine Main::main(main: &mut Main) {
    main.a = 1;
    main.b = 1;
    transition main.b * 20 + main.a >= 0 && main.b * 20 + main.a < 200 { true -> put(main) _ -> done(main) }

    state put(main: &mut Main) { main.b = 200; main.grid[main.b * 20 + main.a] = 7; }
    state done(main: &mut Main) {}
}
