// A saved comparison cannot establish the replacement descriptor's length.
machine bounded(mut bytes: &[u8]) -> u64 {
    let too_short: bool = bytes.len < 4u64;
    bytes = "x";
    transition {
        too_short -> 0u64
        _ -> length(&bytes[0..4])
    }
    machine length(bytes: &[u8]) -> u64 { bytes.len }
}
machine main() crashes Trap {
    let short: u64 = bounded("abc");
    let long: u64 = bounded("abcdef");
    transition short == 0u64 && long == 4u64 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
