public machine step() -> bool blocks; { true }
data Context { value: i32; }
machine scan(first: &mut Context, second: &mut Context, remaining: i32 in Wrapping) -> bool {
    let ready: bool = block step();
    transition remaining > 0 { true -> block scan(first, first, remaining - 1) _ -> ready }
}
data Main { left: Context; right: Context; }
machine main(main: &mut Main) {
    let observed: bool = block scan(&mut main.left, &mut main.right, 2);
}
