// FAIL canary: a whole-leaf store into a plain declared domain leaf
// (`[u8; 8] in Utf8`) is admitted because the ordinary write-side domain
// check discharges membership on the stored value. A partial write cannot
// re-establish whole-value membership, so an element store into the
// domain-qualified carrier stays outside the projection envelope.

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data Limited {
    label: [u8; 8] in Utf8;
}

machine replace(limited: &write Limited) {
    limited.label[0] = 120;
}

data Main {
}

machine Main::main(&mut self) {
}
