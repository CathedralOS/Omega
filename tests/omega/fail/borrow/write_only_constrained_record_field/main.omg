// FAIL canary: only an exact integer primitive whose constraints are closed
// literal ranges is an admissible write-only record-field leaf. An
// arithmetic-policy qualified field is still outside that slice: `&write`
// cannot attest a policy-qualified leaf's replacement content.

data Limited {
    value: u32 in Wrapping;
}

machine replace(limited: &write Limited, next: u32 in Wrapping) {
    limited.value = next;
}

data Main {
}

machine Main::main(&mut self) {
}
