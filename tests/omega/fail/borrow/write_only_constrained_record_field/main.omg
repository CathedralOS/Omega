// FAIL canary: the admitted qualified leaves are the closed literal-ranged
// integer and the arithmetic-policy-only integer — neither a declared domain
// nor a named constraint on the leaf is a behaviour tag. `[u8; 8] in Utf8`
// is a membership predicate the write-only place cannot establish, so a
// domain-qualified leaf stays outside the projection envelope.

domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data Limited {
    label: [u8; 8] in Utf8;
}

machine replace(limited: &write Limited, next: [u8; 8] in Utf8) {
    limited.label = next;
}

data Main {
}

machine Main::main(&mut self) {
}
