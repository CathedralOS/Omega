// FAIL canary (lifetimes stage 2): every input sharing the returned view's
// explicit lifetime is a possible source, so mutating ANY of them while the
// view is live must reject.

machine pick<'a>(first: &'a mut i32, second: &'a mut i32) -> &'a mut i32 {
    transition {
        _ -> first
    }
}

machine exercise<'a>(first: &'a mut i32, second: &'a mut i32) {
    let selected: &'a mut i32 = pick(first, second);
    second = 1;
    selected = 2;
}

data Main {
}

machine Main::main(&mut self) {
}
