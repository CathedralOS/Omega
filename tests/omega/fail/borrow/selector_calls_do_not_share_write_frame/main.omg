// A caller-specific write choice must not become a shared state summary.
machine choose<'storage>(chosen: &'storage mut u64, other: &'storage mut u64, pick_chosen: bool) -> &'storage mut u64 {
    transition pick_chosen {
        true -> chosen
        _ -> other
    }
}

machine touch(chosen: &mut u64, other: &mut u64, pick_chosen: bool) {
    let slot: &mut u64 = choose(chosen, other, pick_chosen);
    slot = 9;
}

machine main() {
    let mut first: u64 = 0;
    let mut first_other: u64 = 1;
    touch(&mut first, &mut first_other, true);
    let mut chosen: u64 = 0;
    let mut other: u64 = 1;
    touch(&mut chosen, &mut other, false);
    let items: [u8; 4] = [4, 7, 8, 9];
    let invalid: u8 = items[other];
}
