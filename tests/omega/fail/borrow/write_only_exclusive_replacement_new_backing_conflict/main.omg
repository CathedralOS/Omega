data Cell { value: i64; }
data Held { target: &mut Cell; stamp: i64; }
data Main { left: Cell; right: Cell; }

machine replace(held: &write Held, incoming: Held) { held = incoming; }

machine Main::main(main: &mut Main) crashes Trap {
    main.left.value = 11;
    main.right.value = 85;
    let mut held: Held = Held { target: &mut main.left, stamp: 17 };
    let incoming: Held = Held { target: &mut main.right, stamp: 23 };
    replace(&write held, incoming);
    main.right.value = 89;
    main.left.value = 29;
    let observed: i64 = held.target.value;
    main.right.value = 41;
    let stamp: i64 = held.stamp;
    transition observed == 89 && stamp == 23 && main.left.value == 29 && main.right.value == 41 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
