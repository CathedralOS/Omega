// A returned reference choice does not describe all writes already performed.
machine choose<'storage>(chosen: &'storage mut u64, other: &'storage mut u64) -> &'storage mut u64 {
    chosen = 9;
    other
}

machine overwrite(slot: &mut u64) {
    slot = 9;
}

machine main() {
    let mut chosen: u64 = 0;
    let mut other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    overwrite(choose(&mut chosen, &mut other));
    let invalid: u8 = items[chosen];
}
