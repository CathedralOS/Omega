// Vec mutation/reallocation must reject while borrowed slice views are still
// active, mirroring the array/slice owner-write rule.

use omega::language::core::vec;

data Main {
    items: Vec<u8>;
}

machine Main::main(main: &mut Main) {
    let view: &[u8] = Vec::as_slice(&main.items);
    Vec::push(&mut main.items, 7);
    read_alias(view);
}

machine read_alias(items: &[u8]) {
}
