machine observe_extent(
    references: &[&write [i32; 2]; 2],
    position: &write u64
) -> u64 {
    references[position].len
}

machine array_from_value(value: i32) -> [i32; 2] { [value, 0] }

machine observe_producer(source: &write i32) -> u64 {
    array_from_value(source).len
}

machine main() {}
