// A changed selector must not preserve the written referent's index bound.
// Intended invalid: other is overwritten with 9 before indexing four elements.
trait Equality<T> { operator == related(left: T, right: T) -> bool; }
Never satisfies Equality<bool> {
    machine related(left: bool, right: bool) -> bool { false }
}

machine choose<'storage, Relation satisfies Equality<bool>>(chosen: &'storage mut u64, other: &'storage mut u64, mut pick_chosen: bool) -> &'storage mut u64 {
    transition {
        pick_chosen == true -> chosen
        _ -> other
    }
}

machine overwrite(slot: &mut u64) -> u64 in Wrapping {
    slot = 9;
    (1 as u64 in Wrapping)
}

machine main() crashes Trap {
    let mut chosen: u64 = 0;
    let mut other: u64 = 1;
    let items: [u8; 4] = [4, 7, 8, 9];
    let marker: u64 in Wrapping = overwrite(choose<Never>(&mut chosen, &mut other, true));
    let found: u8 = items[other];
    transition found == 7 && (marker as u64) == 1 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
