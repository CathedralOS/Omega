// A mutable loan of an array field, one of its elements, or a nested record
// field ends with the owner's `requires` re-proved for what the place holds.
// None of these callees guarantees the bound, so each loan is refused.
data Inner { x: u64; }
data Bag requires cells[0] <= 4 && cells[1] <= 4 && inner.x <= 4 {
    cells: [u64; 4];
    inner: Inner;
}
machine set_cells(cells: &mut [u64; 4]) { cells[0] = 300; }
machine set_cell(cell: &mut u64) { cell = 300; }
machine set_inner(inner: &mut Inner) { inner.x = 300; }
machine poke(bag: &mut Bag) {
    set_cells(&mut bag.cells);
    set_cell(&mut bag.cells[1]);
    set_inner(&mut bag.inner);
}
machine main() {
    let mut bag: Bag;
    poke(&mut bag);
}
