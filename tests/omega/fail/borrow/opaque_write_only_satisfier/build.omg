use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::application(builder, "opaque_write_only_satisfier");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind<Sink::write>(builder, windows_x86_64, ForeignBinding::Syscall { number: 1 });
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind<Sink::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind<Sink::write>(builder, macos_arm64, ForeignBinding::Syscall { number: 1 });
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind<Sink::write>(builder, linux_arm64, ForeignBinding::Syscall { number: 1 });
}
