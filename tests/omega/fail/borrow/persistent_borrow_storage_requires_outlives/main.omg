// A dependent store does not invent a loan in its template. Its selected
// reference-carrying instance still owes persistent-owner propagation.
data Cell<Value> {
    stored: Value;
}

data Main<'storage> {
    storage: Cell<&'storage mut i32>;
}

machine Cell::set<Value>(storage: &mut Cell<Value>, source: Value) {
    storage.stored = source;
}

machine Main::store<'storage>(
    main: &mut Main<'storage>,
    source: &'storage mut i32
) {
    Cell::set(&mut main.storage, source);
}

machine Main::main<'storage>(main: &mut Main<'storage>) {
}
