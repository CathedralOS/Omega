// FAIL canary (lifetimes stage 1, elision-only output-borrow linkage): a
// machine returning a view with MULTIPLE non-self candidate ref inputs is
// ambiguous -- the elision rules cannot decide which input the returned view
// borrows. The author must use explicit lifetime tags (the tick spelling of
// frozen decision 15) to link the output to exactly one input. Rejected at the
// declaration.

use omega::language::std::console;

data Cell {
    value: i32;
}

data Bag {
    cells: [Cell; 4];
}

data Main {
    console: Console;
    first: Bag;
    second: Bag;
}

machine pick_either(a: &mut Bag, b: &mut Bag) -> &mut Cell {
    let cells: &mut [Cell] = a.cells.as_mut_slice();
    transition {
        _ -> &mut cells[2]
    }
}

machine Main::main(&mut self) {
    let cell: &mut Cell = pick_either(&mut self.first, &mut self.second);
    cell.value = 7;
    self.console.exit_process(70);
}
