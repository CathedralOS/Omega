// FAIL canary: admitting a contract-bounded value into a write-only record
// place does not relax the admission obligation. A source whose own contract
// is absent cannot prove containment in the callee's bound, so the call is
// rejected like any other unproven store. (Was: the `u8 [0..=10]` field
// suffix carried the bounded-assignment obligation; the bound now lives on
// `replace`'s requires contract.)

data Limited {
    value: u8;
}

machine replace(limited: &write Limited, next: u8) requires next <= 10 {
    limited.value = next;
}

machine drive(limited: &write Limited, source: u8) {
    replace(&write limited, source);
}

data Main {
}

machine Main::main(&mut self) {
}
