// FAIL canary (decision 15): nested checked aggregates cannot launder a local
// loan through a machine result. `Envelope.retained` validly borrows the input,
// but its nested `Message.body` borrows `owned`; the valid first source must not
// hide the dangling second source when the outer value is returned. A separate
// dependent payload does not exempt the template's already known view leaves.

data Message {
    body: &i32;
}

data Envelope<Value> {
    retained: &i32;
    message: Message;
    value: Value;
}

data Main {
    seed: i32;
}

machine bad<Value>(seed: &i32, value: Value) -> Envelope<Value> {
    let owned: i32 = 9;
    let envelope: Envelope<Value> = Envelope {
        retained: seed,
        message: Message { body: &owned },
        value: value
    };
    transition {
        _ -> envelope
    }
}

machine Main::main(main: &mut Main) {
    let envelope: Envelope<i32> = bad(&main.seed, 5);
}
