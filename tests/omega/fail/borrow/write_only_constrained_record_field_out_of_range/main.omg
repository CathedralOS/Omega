// FAIL canary: admitting a contract-bounded value into a write-only record
// place does not relax the admission obligation. A literal outside the
// declared contract is rejected like any other unproven store. (Was: the
// `u8 [0..=10]` field suffix carried the bounded-assignment obligation; the
// bound now lives on `fill`'s requires contract.)

data Limited {
    value: u8;
}

machine fill(limited: &write Limited, depth: u8) requires depth <= 10 {
    limited.value = depth;
}

machine drive(limited: &write Limited) {
    fill(&write limited, 20);
}

data Main {
}

machine Main::main(&mut self) {
}
