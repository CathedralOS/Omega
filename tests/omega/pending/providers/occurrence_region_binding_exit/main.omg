// Expected exit: 0. A selected provider declaration is independent of the
// caller's region. The Binding occurrence supplies the complete region scope.
// Frontier: PSI-TARGET-FAMILIES must retain that scope through preparation and
// receiving installation; declaration selection cannot instantiate it early.
// Current refusal: closed requirement needs a retained exact region application.
use omega::language::core::binding;

pub boundary trait Reading<Value> {
    machine read(value: Value) -> i32;
}
BorrowedReading<'provider> satisfies Reading<&'provider i32> {
    Reading::read = read;
}
machine read<'provider>(value: &'provider i32) -> i32 { value as i32 }

data TargetProviders {}
macos_arm64 machine TargetProviders::provider_defaults(defaults: &mut TargetProviders) {
    TargetProviders::select_provider<Reading, BorrowedReading>(defaults);
}
machine observed<'source>(reading: &Binding<Reading<&'source i32>>, value: &'source i32)
    -> i32 reaches Reading { reading.read(value) }

data Main<'entry> {
    reading: Binding<Reading<&'entry i32>>;
    value: i32;
}
machine Main::main<'entry>(main: &'entry mut Main<'entry>) reaches Reading crashes Trap {
    main.value = 37;
    let result: i32 = observed(&main.reading, &main.value);
    transition result == 37 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
