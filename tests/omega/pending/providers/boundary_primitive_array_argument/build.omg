// PENDING build root: the program-entry binding is load-bearing -- the
// omission this fixture pins appears only once an entry is established and the
// Unit plan is demanded. Only macos_arm64 is bound because the provider below
// is declared for that target.
// `builder.identifier` admits only `A-Z a-z 0-9 .` -- no underscores. Spelling
// it after the fixture's directory name makes the whole program fail Build
// validation BEFORE anything is planned, and the fixture then "reproduces" an
// error that has nothing to do with what it pins. That happened to this file.
machine build(builder: &mut Build) {
    builder.application("boundary_primitive_array_argument");
    builder.identifier = "com.omega.boundaryarray";
    builder.depend(Source::Path { location: "../../../../../source/library/std" });
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
}
