// PENDING: storing a CONCATENATION into a byte-sequence carrier omits the
// machine's unit plan at `structural field store: byte sequence carrier`.
// The carrier is recognized — this is not the bare-`[u8; N]` problem that
// stops the gui samples — the value is what has no plan.
//
// Isolated over one program, changing only the assigned expression:
//
//   self.greeting = "Hello";                        OK
//   self.greeting = "Hello, " + self.name;          OMITTED
//   self.greeting = self.name + "!";                OMITTED
//   self.greeting = "Hello, " + self.name + "!";    OMITTED
//
// So a literal lands and either operand order of a concatenation does not.
// Three samples wait on exactly this, and all three are building text from
// a name or a label: `samples/cli/basics/text_greeting`
// (`self.greeting = "Hello, " + self.name + "!"`),
// `samples/cli/systems/status_report`, and
// `samples/cli/text/string_catalog`.
//
// The site is
// `04_typed-trees-to-checked-trees/src/execution/terminal_unit/structural_scalar_store/mod.rs`,
// which recognizes the `BoundedOwned` carrier and then finds no planned
// value for it. Promote to `pass/text/` with an exit comparing the result
// when concatenation lands.
use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 8]::Utf8
requires
    valid_utf8(self);
domain [u8; 32]::Utf8
requires
    valid_utf8(self);

data Main {
    console: Binding<Console>;
    name: [u8; 8] in Utf8;
    greeting: [u8; 32] in Utf8;
}

machine Main::main(&mut self) reaches Console {
    self.name = "Ada";
    self.greeting = "Hello, " + self.name + "!";
    transition self.greeting == "Hello, Ada!" {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
