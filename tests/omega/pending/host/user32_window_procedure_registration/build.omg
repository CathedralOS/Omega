// FFIVAL canary build root: the pending watcher compiles only `main.omg`
// (Check product, no target), but the authored declaration is retained so
// promotion to `pass/host/` needs no new wiring. The window-procedure
// registration is the authored root on every hosted target; the foreign
// callback leg itself is exercised only where the provider supplies it —
// other hosts report the leg unavailable.
machine build(builder: &mut Build) {
    Build::application(builder, "user32_window_procedure_registration");
    Build::depend(builder, Source::Path { location: "../../../../../source/library/std" });
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
