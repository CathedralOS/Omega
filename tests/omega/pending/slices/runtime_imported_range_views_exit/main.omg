use omega::language::core::slice;

data Entry { value: i32; }
data Main { entries: [Entry; 4]; }

machine Main::main(main: &mut Main) crashes Trap {
    let whole: &[Entry] = &main.entries[..];
    transition whole.len == 4 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
