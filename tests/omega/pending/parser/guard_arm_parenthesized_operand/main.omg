// Current refusal: expected transition pattern
// A guard arm in a transition with no subject cannot begin with a
// parenthesized operand. The parser takes the opening parenthesis for the
// start of a tuple pattern and stops at the comparison operator, 24:24 below.
// With no subject there is nothing for a tuple pattern to decompose, so the
// parenthesis can only open an expression; this is valid source the parser
// does not reach, not a language rejection rule.
//
// Variants that bound the refusal. Both check, and exit 0 on both engines
// when given a `ProgramEntry` binding:
//
//   - the operand bound first: `let high: u64 in Wrapping = value & 0xC0;`
//     and the arm `high != 0x80 -> done()`;
//   - the same expression as a Boolean subject:
//     `transition (value & 0xC0) != 0x80 { true -> done() _ -> bad() }`.
//
// compiler_request.md names multi-arm subjectless blocks among the valid
// transition forms; no specification text gives a grammar for the guard.
//
// Expected after the parser accepts the guard: checks, and exits 0.
machine main() crashes Trap {
    let value: u64 in Wrapping = 0xC1;
    transition {
        (value & 0xC0) != 0x80 -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
