module policies;

use compose;

public machine banner() -> &[u8] {
    "topology policy"
}

// `publish` from the contract's operation table: the composition project
// reads its admitted inputs (request, verified component descriptions,
// owner digests and wiring) through the passed source facet, composes the
// deployment plan, and serializes it into the output stream behind the
// caller's required-output obligation. The facets arrive as parameters, so
// the package never holds Build authority of its own.
public machine publish(output: &mut BuildOutput, source: &BuildSource, log: &mut BuildLog, descriptor: i32) {
    let mut work: compose::Compose;
    compose::Compose::publish(&mut work, source, output, log, descriptor);
}
