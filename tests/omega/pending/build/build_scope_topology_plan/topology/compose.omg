    machine merge_ck(compose: &mut Compose) {
        transition (compose.j < compose.imp_n[compose.h1] || compose.m < compose.exp_n[compose.h1]) && compose.k < 16 && compose.ok {
            true -> merge_pick(compose)
            _ -> merge_fin(compose)
