// The composition engine: reads the project's admitted inputs through the
// source facet, composes the canonical deployment plan per the topology
// reference contract, and serializes it to the caller's required output.
//
// Wire layout follows the topology contract exactly: LE integers, u32 length
// prefixes, sorted rosters, and the v1 tag table. Every composition fact is
// reconstructed from the admitted description bytes and owner digests here —
// nothing is copied from a caller-written plan inventory.
//
// Input layout (owner-supplied, confined to inputs/; `..` or absolute
// escapes are refused before evaluation — pinned by the package-manager
// confinement suite):
//   request.bin     — the canonical TopologyRequest bytes.
//   components.bin  — {u32 n} + per-instance {u32 desc_len, desc bytes,
//                     profile[32], u32 export_n, export_n × contract[32]},
//                     in request-roster order; each contract is the one the
//                     component verifier derived for that export surface.
//   bindings.bin    — {u32 n} + {ii,is,ei,es u32 + transport[32]}, canonical.

module compose;

use digest;
use omega::language::core::numeric_conversion;

public data Compose {
    ok: bool;
    i: u64 in Wrapping;
    j: u64 in Wrapping;
    k: u64 in Wrapping;
    m: u64 in Wrapping;
    h0: u64 in Wrapping;
    h1: u64 in Wrapping;
    h2: u64 in Wrapping;
    h3: u64 in Wrapping;
    d0: u64 in Wrapping;
    d1: u64 in Wrapping;
    t64: u64 in Wrapping;
    acc: u64 in Wrapping;
    b8: u8;
    w8: u8;
    errtag: [u8; 8];
    w32: u32;
    cur: u64 in Wrapping;
    src: u64 in Wrapping;
    cp: u64 in Wrapping;
    cb: u64 in Wrapping;
    ja: u64 in Wrapping;
    jb: u64 in Wrapping;
    jc: u64 in Wrapping;
    jd: u64 in Wrapping;
    je: u64 in Wrapping;
    jf: u64 in Wrapping;
    jg: u64 in Wrapping;
    n_svc: u64 in Wrapping;
    n_prov: u64 in Wrapping;
    n_obl: u64 in Wrapping;
    dr_n: u64 in Wrapping;

    req: [u8; 8192];
    req_n: u64 in Wrapping;
    rq: u64 in Wrapping;
    meta: [u8; 8192];
    meta_n: u64 in Wrapping;
    mq: u64 in Wrapping;
    desc: [u8; 8192];
    desc_n: u64 in Wrapping;
    dq: u64 in Wrapping;
    bind: [u8; 8192];
    bind_n: u64 in Wrapping;
    bq: u64 in Wrapping;

    ident: [u8; 32];
    strbuf: [u8; 256];
    str_n: u64 in Wrapping;
    commit: [u8; 32];

    dig: digest::Sha256;
    digest32: [u8; 32];
    desc_id: [u8; 32];

    n_inst: u64 in Wrapping;
    n_pol: u64 in Wrapping;
    n_tr: u64 in Wrapping;
    n_acp: u64 in Wrapping;
    n_bind: u64 in Wrapping;
    n_meta: u64 in Wrapping;

    names: [u8; 1024];
    name_len: [u64 in Wrapping; 8];
    subjects: [u8; 256];
    transports: [u8; 256];
    accepted: [u8; 1024];
    verifier: [u8; 32];

    pol_tag: [u8; 8];
    pol_off: [u64 in Wrapping; 8];
    pol_len: [u64 in Wrapping; 8];
    pol_s: [u64 in Wrapping; 8];
    pol_t: [u64 in Wrapping; 8];
    pol_v: [u64 in Wrapping; 8];
    sel_mask: u64 in Wrapping;
    sel_n: u64 in Wrapping;
    name_idx: u64 in Wrapping;

    profiles: [u8; 256];
    closures: [u8; 256];
    inst_asm_n: [u64 in Wrapping; 8];
    inst_asm: [u8; 2048];
    imp_n: [u64 in Wrapping; 8];
    imp_slot: [u64 in Wrapping; 64];
    imp_contract: [u8; 2048];
    exp_n: [u64 in Wrapping; 8];
    derived_exp_n: [u64 in Wrapping; 8];
    exp_contract: [u8; 2048];
    ep_n: [u64 in Wrapping; 8];
    ep_slot: [u64 in Wrapping; 128];
    ep_dir: [u8; 128];
    ep_contract: [u8; 4096];

    b_ii: [u64 in Wrapping; 16];
    b_is: [u64 in Wrapping; 16];
    b_ei: [u64 in Wrapping; 16];
    b_es: [u64 in Wrapping; 16];
    b_tr: [u8; 512];
    prev_key: u64 in Wrapping;
    cur_key: u64 in Wrapping;

    adj: [u8; 64];
    visited: [u8; 8];
    queue: [u64 in Wrapping; 16];
    qh: u64 in Wrapping;
    qn: u64 in Wrapping;
    // The queue tail, computed before its bound is guarded so the indexed
    // store names a field rather than an expression.
    qi: u64 in Wrapping;
    parent: [u64 in Wrapping; 8];
    has_parent: [u8; 8];
    excl_mask: u64 in Wrapping;
    src_mask: u64 in Wrapping;
    tgt_mask: u64 in Wrapping;
    reach: [u8; 8];
    path: [u64 in Wrapping; 8];
    path_n: u64 in Wrapping;
    found: bool;
    vtx: u64 in Wrapping;

    pol_out: [u8; 8];
    pol_kind: [u8; 8];
    pol_wit_n: [u64 in Wrapping; 8];
    pol_wit: [u8; 64];
    pol_reach_n: [u64 in Wrapping; 8];
    pol_reach: [u8; 64];

    out: [u8; 16384];
    out_len: u64 in Wrapping;
}

// ---- byte readers ---------------------------------------------------------

machine Compose::rd(compose: &mut Compose) {
    transition compose.cur == 0 && compose.rq < 8192 && compose.rq < compose.req_n {
        true -> rd_req(compose)
        _ -> rd_meta_g(compose)
    }
    machine rd_meta_g(compose: &mut Compose) {
        transition compose.cur == 1 && compose.mq < 8192 && compose.mq < compose.meta_n {
            true -> rd_meta(compose)
            _ -> rd_desc_g(compose)
        }
    }
    machine rd_desc_g(compose: &mut Compose) {
        transition compose.cur == 2 && compose.dq < 8192 && compose.dq < compose.desc_n {
            true -> rd_desc(compose)
            _ -> rd_bind_g(compose)
        }
    }
    machine rd_bind_g(compose: &mut Compose) {
        transition compose.cur == 3 && compose.bq < 8192 && compose.bq < compose.bind_n {
            true -> rd_bind(compose)
            _ -> rd_bad(compose)
        }
    }
    machine rd_req(compose: &mut Compose) {
        compose.b8 = compose.req[compose.rq];
        compose.rq = compose.rq + 1;
        transition { _ -> rd_done() }
    }
    machine rd_meta(compose: &mut Compose) {
        compose.b8 = compose.meta[compose.mq];
        compose.mq = compose.mq + 1;
        transition { _ -> rd_done() }
    }
    machine rd_desc(compose: &mut Compose) {
        compose.b8 = compose.desc[compose.dq];
        compose.dq = compose.dq + 1;
        transition { _ -> rd_done() }
    }
    machine rd_bind(compose: &mut Compose) {
        compose.b8 = compose.bind[compose.bq];
        compose.bq = compose.bq + 1;
        transition { _ -> rd_done() }
    }
    machine rd_bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 114;
        compose.errtag[1] = 100;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> rd_done() }
    }
    machine rd_done() {
    }
}

machine Compose::ru32(compose: &mut Compose) {
    compose.acc = 0;
    Compose::rd(compose);
    compose.acc = compose.acc + (compose.b8 as u64 in Wrapping);
    Compose::rd(compose);
    compose.acc = compose.acc + ((compose.b8 as u64 in Wrapping) << 8);
    Compose::rd(compose);
    compose.acc = compose.acc + ((compose.b8 as u64 in Wrapping) << 16);
    Compose::rd(compose);
    compose.acc = compose.acc + ((compose.b8 as u64 in Wrapping) << 24);
    compose.w32 = narrow_u64_to_u32_wrapping(compose.acc as u64);
    transition { _ -> done() }
    machine done() {
    }
}

machine Compose::skip(compose: &mut Compose, n: u64 in Wrapping) {
    compose.j = 0;
    transition { _ -> loop_s(compose, n) }
    machine loop_s(compose: &mut Compose, n: u64 in Wrapping) {
        transition compose.j < n && compose.j < 8192 && compose.ok {
            true -> step(compose, n)
            _ -> done()
        }
    }
    machine step(compose: &mut Compose, n: u64 in Wrapping) {
        Compose::rd(compose);
        compose.j = compose.j + 1;
        transition { _ -> loop_s(compose, n) }
    }
    machine done() {
    }
}

machine Compose::rdident(compose: &mut Compose) {
    compose.j = 0;
    transition { _ -> loop_s(compose) }
    machine loop_s(compose: &mut Compose) {
        transition compose.j < 32 && compose.ok {
            true -> prep(compose)
            _ -> done()
        }
    }
    machine prep(compose: &mut Compose) {
        compose.h0 = compose.j;
        transition compose.h0 < 32 {
            true -> apply(compose)
            _ -> bad(compose)
        }
    }
    machine apply(compose: &mut Compose) {
        Compose::rd(compose);
        compose.ident[compose.h0] = compose.b8;
        compose.j = compose.j + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 105;
        compose.errtag[1] = 100;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

machine Compose::rdstr(compose: &mut Compose) {
    Compose::ru32(compose);
    compose.t64 = compose.w32 as u64 in Wrapping;
    transition compose.t64 < 256 && compose.ok {
        true -> init(compose)
        _ -> bad(compose)
    }
    machine init(compose: &mut Compose) {
        compose.str_n = compose.t64;
        compose.j = 0;
        transition { _ -> loop_s(compose) }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.j < compose.str_n && compose.j < 256 && compose.ok {
            true -> prep(compose)
            _ -> done()
        }
    }
    machine prep(compose: &mut Compose) {
        compose.h0 = compose.j;
        transition compose.h0 < 256 {
            true -> apply(compose)
            _ -> bad(compose)
        }
    }
    machine apply(compose: &mut Compose) {
        Compose::rd(compose);
        compose.strbuf[compose.h0] = compose.b8;
        compose.j = compose.j + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 115;
        compose.errtag[1] = 116;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Resolve strbuf against the instance roster: sets name_idx or clears ok.
machine Compose::resolve_name(compose: &mut Compose) {
    compose.name_idx = 255;
    compose.i = 0;
    transition { _ -> loop_s(compose) }
    machine loop_s(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 && compose.name_idx == 255 {
            true -> check_len(compose)
            _ -> done()
        }
    }
    machine check_len(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> cmp_len(compose)
            _ -> bad(compose)
        }
    }
    machine cmp_len(compose: &mut Compose) {
        transition compose.name_len[compose.h0] == compose.str_n {
            true -> start_cmp(compose)
            _ -> next_i(compose)
        }
    }
    machine start_cmp(compose: &mut Compose) {
        compose.k = 0;
        compose.found = true;
        transition { _ -> cmp_loop(compose) }
    }
    machine cmp_loop(compose: &mut Compose) {
        transition compose.k < compose.str_n && compose.k < 256 && compose.found {
            true -> prep_cmp(compose)
            _ -> after_cmp(compose)
        }
    }
    machine prep_cmp(compose: &mut Compose) {
        compose.h1 = compose.i * 128 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 1024 && compose.h2 < 256 {
            true -> do_cmp(compose)
            _ -> bad(compose)
        }
    }
    machine do_cmp(compose: &mut Compose) {
        transition compose.names[compose.h1] != compose.strbuf[compose.h2] {
            true -> not_eq(compose)
            _ -> next_k(compose)
        }
    }
    machine not_eq(compose: &mut Compose) {
        compose.found = false;
        transition { _ -> next_k(compose) }
    }
    machine next_k(compose: &mut Compose) {
        compose.k = compose.k + 1;
        transition { _ -> cmp_loop(compose) }
    }
    machine after_cmp(compose: &mut Compose) {
        transition compose.found {
            true -> got(compose)
            _ -> next_i(compose)
        }
    }
    machine got(compose: &mut Compose) {
        compose.name_idx = compose.i;
        transition { _ -> done() }
    }
    machine next_i(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 114;
        compose.errtag[1] = 110;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Read one selector (u32 count + names) into a bitmask on sel_mask.
// Members must resolve to roster instances; count bounded by roster size.
machine Compose::rd_selector(compose: &mut Compose) {
    Compose::ru32(compose);
    compose.sel_n = compose.w32 as u64 in Wrapping;
    compose.sel_mask = 0;
    transition compose.sel_n <= 8 && compose.ok {
        true -> init(compose)
        _ -> bad(compose)
    }
    machine init(compose: &mut Compose) {
        compose.j = 0;
        transition { _ -> loop_s(compose) }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.j < compose.sel_n && compose.j < 8 && compose.ok {
            true -> one(compose)
            _ -> done()
        }
    }
    machine one(compose: &mut Compose) {
        Compose::rdstr(compose);
        Compose::resolve_name(compose);
        transition compose.name_idx < 8 && compose.ok {
            true -> setbit(compose)
            _ -> bad(compose)
        }
    }
    machine setbit(compose: &mut Compose) {
        compose.sel_mask = compose.sel_mask | ((1 as u64 in Wrapping) << compose.name_idx);
        compose.j = compose.j + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 114;
        compose.errtag[1] = 115;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- emitters -------------------------------------------------------------

machine Compose::emit_u8(compose: &mut Compose) {
    transition compose.out_len < 16384 {
        true -> apply(compose)
        _ -> bad(compose)
    }
    machine apply(compose: &mut Compose) {
        compose.out[compose.out_len] = compose.w8;
        compose.out_len = compose.out_len + 1;
        transition { _ -> done() }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

machine Compose::emit_u32(compose: &mut Compose) {
    compose.acc = (compose.w32 as u64 in Wrapping);
    compose.w8 = narrow_u64_to_u8_wrapping(compose.acc as u64);
    Compose::emit_u8(compose);
    compose.w8 = narrow_u64_to_u8_wrapping((compose.acc >> 8) as u64);
    Compose::emit_u8(compose);
    compose.w8 = narrow_u64_to_u8_wrapping((compose.acc >> 16) as u64);
    Compose::emit_u8(compose);
    compose.w8 = narrow_u64_to_u8_wrapping((compose.acc >> 24) as u64);
    Compose::emit_u8(compose);
    transition { _ -> done() }
    machine done() {
    }
}

// Emit 32 bytes from a chosen field array: `compose.h0` = byte base, `compose.src`
// selects the array (0=commit 1=digest32 2=ep_contract 3=b_tr 4=inst_asm
// 5=profiles 6=closures 7=subjects 8=verifier 9=transports).
machine Compose::emit_ident(compose: &mut Compose) {
    compose.k = 0;
    transition { _ -> loop_s(compose) }
    machine loop_s(compose: &mut Compose) {
        transition compose.k < 32 && compose.ok {
            true -> prep(compose)
            _ -> done()
        }
    }
    machine prep(compose: &mut Compose) {
        compose.h1 = compose.h0 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 4096 && compose.h2 < 32 && compose.out_len < 16384 {
            true -> pick(compose)
            _ -> bad(compose)
        }
    }
    machine pick(compose: &mut Compose) {
        transition compose.src == 0 {
            true -> from_commit(compose)
            _ -> pick1(compose)
        }
    }
    machine pick1(compose: &mut Compose) {
        transition compose.src == 1 {
            true -> from_digest(compose)
            _ -> pick2(compose)
        }
    }
    machine pick2(compose: &mut Compose) {
        transition compose.src == 2 {
            true -> from_ep(compose)
            _ -> pick3(compose)
        }
    }
    machine pick3(compose: &mut Compose) {
        transition compose.src == 3 && compose.h1 < 512 {
            true -> from_tr(compose)
            _ -> pick4(compose)
        }
    }
    machine pick4(compose: &mut Compose) {
        transition compose.src == 4 && compose.h1 < 2048 {
            true -> from_asm(compose)
            _ -> pick5(compose)
        }
    }
    machine pick5(compose: &mut Compose) {
        transition compose.src == 5 && compose.h1 < 256 {
            true -> from_profile(compose)
            _ -> pick6(compose)
        }
    }
    machine pick6(compose: &mut Compose) {
        transition compose.src == 6 && compose.h1 < 256 {
            true -> from_closure(compose)
            _ -> pick7(compose)
        }
    }
    machine pick7(compose: &mut Compose) {
        transition compose.src == 7 && compose.h1 < 256 {
            true -> from_subject(compose)
            _ -> pick8(compose)
        }
    }
    machine pick8(compose: &mut Compose) {
        transition compose.src == 8 && compose.h2 < 32 {
            true -> from_verifier(compose)
            _ -> pick9(compose)
        }
    }
    machine pick9(compose: &mut Compose) {
        transition compose.src == 9 && compose.h1 < 256 {
            true -> from_transports(compose)
            _ -> bad(compose)
        }
    }
    machine from_commit(compose: &mut Compose) {
        compose.w8 = compose.commit[compose.h2];
        transition { _ -> put(compose) }
    }
    machine from_digest(compose: &mut Compose) {
        compose.w8 = compose.digest32[compose.h2];
        transition { _ -> put(compose) }
    }
    machine from_ep(compose: &mut Compose) {
        compose.w8 = compose.ep_contract[compose.h1];
        transition { _ -> put(compose) }
    }
    machine from_tr(compose: &mut Compose) {
        compose.w8 = compose.b_tr[compose.h1];
        transition { _ -> put(compose) }
    }
    machine from_asm(compose: &mut Compose) {
        compose.w8 = compose.inst_asm[compose.h1];
        transition { _ -> put(compose) }
    }
    machine from_profile(compose: &mut Compose) {
        compose.w8 = compose.profiles[compose.h1];
        transition { _ -> put(compose) }
    }
    machine from_closure(compose: &mut Compose) {
        compose.w8 = compose.closures[compose.h1];
        transition { _ -> put(compose) }
    }
    machine from_subject(compose: &mut Compose) {
        compose.w8 = compose.subjects[compose.h1];
        transition { _ -> put(compose) }
    }
    machine from_verifier(compose: &mut Compose) {
        compose.w8 = compose.verifier[compose.h2];
        transition { _ -> put(compose) }
    }
    machine from_transports(compose: &mut Compose) {
        compose.w8 = compose.transports[compose.h1];
        transition { _ -> put(compose) }
    }
    machine put(compose: &mut Compose) {
        compose.out[compose.out_len] = compose.w8;
        compose.out_len = compose.out_len + 1;
        compose.k = compose.k + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- request decode -------------------------------------------------------
// Layout: magic u32 | ver u32 | n_inst u32 | {name,subject}x | n_pol u32 |
// {tag,3 selectors}x | verifier[32] | n_tr u32 | tr[32]x | n_acp u32 | asm[32]x

machine Compose::decode_req(compose: &mut Compose) {
    compose.rq = 0;
    compose.cur = 0;
    Compose::ru32(compose);
    transition compose.w32 == 1280332881 && compose.ok {
        true -> ver(compose)
        _ -> bad(compose)
    }
    machine ver(compose: &mut Compose) {
        Compose::ru32(compose);
        transition compose.w32 == 1 && compose.ok {
            true -> insts(compose)
            _ -> bad(compose)
        }
    }
    machine insts(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.n_inst = compose.w32 as u64 in Wrapping;
        transition compose.n_inst > 0 && compose.n_inst <= 8 && compose.ok {
            true -> inst_init(compose)
            _ -> bad(compose)
        }
    }
    machine inst_init(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> inst_loop(compose) }
    }
    machine inst_loop(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 && compose.ok {
            true -> inst_name(compose)
            _ -> pols(compose)
        }
    }
    machine inst_name(compose: &mut Compose) {
        Compose::rdstr(compose);
        compose.h0 = compose.i;
        transition compose.h0 < 8 && compose.ok {
            true -> set_len(compose)
            _ -> bad(compose)
        }
    }
    machine set_len(compose: &mut Compose) {
        compose.name_len[compose.h0] = compose.str_n;
        compose.k = 0;
        transition { _ -> name_copy(compose) }
    }
    machine name_copy(compose: &mut Compose) {
        transition compose.k < compose.str_n && compose.k < 128 {
            true -> prep_nc(compose)
            _ -> inst_subj(compose)
        }
    }
    machine prep_nc(compose: &mut Compose) {
        compose.h1 = compose.i * 128 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 1024 && compose.h2 < 256 {
            true -> do_nc(compose)
            _ -> bad(compose)
        }
    }
    machine do_nc(compose: &mut Compose) {
        compose.names[compose.h1] = compose.strbuf[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> name_copy(compose) }
    }
    machine inst_subj(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> subj_copy(compose) }
    }
    machine subj_copy(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_sc(compose)
            _ -> inst_next(compose)
        }
    }
    machine prep_sc(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 256 && compose.h2 < 32 {
            true -> do_sc(compose)
            _ -> bad(compose)
        }
    }
    machine do_sc(compose: &mut Compose) {
        compose.subjects[compose.h1] = compose.ident[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> subj_copy(compose) }
    }
    machine inst_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> inst_loop(compose) }
    }
    machine pols(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.n_pol = compose.w32 as u64 in Wrapping;
        transition compose.n_pol <= 8 && compose.ok {
            true -> pol_init(compose)
            _ -> bad(compose)
        }
    }
    machine pol_init(compose: &mut Compose) {
        compose.cp = 0;
        transition { _ -> pol_loop(compose) }
    }
    machine pol_loop(compose: &mut Compose) {
        transition compose.cp < compose.n_pol && compose.cp < 8 && compose.ok {
            true -> pol_off_set(compose)
            _ -> verifier_r(compose)
        }
    }
    machine pol_off_set(compose: &mut Compose) {
        compose.pol_off[compose.cp] = compose.rq;
        transition { _ -> pol_tag_r(compose) }
    }
    machine pol_tag_r(compose: &mut Compose) {
        Compose::rd(compose);
        transition compose.ok && compose.cp < 8 {
            true -> pol_tag_set(compose)
            _ -> bad(compose)
        }
    }
    machine pol_tag_set(compose: &mut Compose) {
        compose.pol_tag[compose.cp] = compose.b8;
        transition compose.b8 == 1 || compose.b8 == 2 {
            true -> pol_s_r(compose)
            _ -> bad(compose)
        }
    }
    machine pol_s_r(compose: &mut Compose) {
        Compose::rd_selector(compose);
        transition compose.ok {
            true -> pol_s_set(compose)
            _ -> bad(compose)
        }
    }
    machine pol_s_set(compose: &mut Compose) {
        transition compose.sel_n > 0 && compose.cp < 8 {
            true -> pol_s_ok(compose)
            _ -> bad(compose)
        }
    }
    machine pol_s_ok(compose: &mut Compose) {
        compose.pol_s[compose.cp] = compose.sel_mask;
        transition { _ -> pol_t_r(compose) }
    }
    machine pol_t_r(compose: &mut Compose) {
        Compose::rd_selector(compose);
        transition compose.ok {
            true -> pol_t_set(compose)
            _ -> bad(compose)
        }
    }
    machine pol_t_set(compose: &mut Compose) {
        transition compose.sel_n > 0 && compose.cp < 8 {
            true -> pol_t_ok(compose)
            _ -> bad(compose)
        }
    }
    machine pol_t_ok(compose: &mut Compose) {
        compose.pol_t[compose.cp] = compose.sel_mask;
        transition { _ -> pol_v_r(compose) }
    }
    machine pol_v_r(compose: &mut Compose) {
        Compose::rd_selector(compose);
        transition compose.ok && compose.cp < 8 {
            true -> pol_v_set(compose)
            _ -> bad(compose)
        }
    }
    machine pol_v_set(compose: &mut Compose) {
        compose.pol_v[compose.cp] = compose.sel_mask;
        transition compose.cp < 8 {
            true -> pol_len_set(compose)
            _ -> bad(compose)
        }
    }
    machine pol_len_set(compose: &mut Compose) {
        compose.pol_len[compose.cp] = compose.rq - compose.pol_off[compose.cp];
        transition compose.cp < 8 {
            true -> pol_arity_ck(compose)
            _ -> bad(compose)
        }
    }
    machine pol_arity_ck(compose: &mut Compose) {
        transition (compose.pol_tag[compose.cp] == 1 && compose.sel_n == 0) || (compose.pol_tag[compose.cp] == 2 && compose.sel_n > 0) {
            true -> pol_disj_g(compose)
            _ -> bad(compose)
        }
    }
    machine pol_disj_g(compose: &mut Compose) {
        transition compose.cp < 8 {
            true -> pol_disj(compose)
            _ -> bad(compose)
        }
    }
    machine pol_disj(compose: &mut Compose) {
        compose.t64 = (compose.pol_s[compose.cp] & compose.pol_t[compose.cp]) | (compose.pol_s[compose.cp] & compose.pol_v[compose.cp]) | (compose.pol_t[compose.cp] & compose.pol_v[compose.cp]);
        transition compose.t64 == 0 {
            true -> pol_next(compose)
            _ -> bad(compose)
        }
    }
    machine pol_next(compose: &mut Compose) {
        compose.cp = compose.cp + 1;
        transition { _ -> pol_loop(compose) }
    }
    machine verifier_r(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> ver_copy(compose) }
    }
    machine ver_copy(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_vc(compose)
            _ -> transports_r(compose)
        }
    }
    machine prep_vc(compose: &mut Compose) {
        compose.h2 = compose.k;
        transition compose.h2 < 32 {
            true -> do_vc(compose)
            _ -> bad(compose)
        }
    }
    machine do_vc(compose: &mut Compose) {
        compose.verifier[compose.h2] = compose.ident[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> ver_copy(compose) }
    }
    machine transports_r(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.n_tr = compose.w32 as u64 in Wrapping;
        transition compose.n_tr > 0 && compose.n_tr <= 8 && compose.ok {
            true -> tr_init(compose)
            _ -> bad(compose)
        }
    }
    machine tr_init(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> tr_loop(compose) }
    }
    machine tr_loop(compose: &mut Compose) {
        transition compose.i < compose.n_tr && compose.i < 8 && compose.ok {
            true -> tr_one(compose)
            _ -> acp_r(compose)
        }
    }
    machine tr_one(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> tr_copy(compose) }
    }
    machine tr_copy(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_tc(compose)
            _ -> tr_next(compose)
        }
    }
    machine prep_tc(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 256 && compose.h2 < 32 {
            true -> do_tc(compose)
            _ -> bad(compose)
        }
    }
    machine do_tc(compose: &mut Compose) {
        compose.transports[compose.h1] = compose.ident[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> tr_copy(compose) }
    }
    machine tr_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> tr_loop(compose) }
    }
    machine acp_r(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.n_acp = compose.w32 as u64 in Wrapping;
        transition compose.n_acp <= 32 && compose.ok {
            true -> acp_init(compose)
            _ -> bad(compose)
        }
    }
    machine acp_init(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> acp_loop(compose) }
    }
    machine acp_loop(compose: &mut Compose) {
        transition compose.i < compose.n_acp && compose.i < 32 && compose.ok {
            true -> acp_one(compose)
            _ -> fin(compose)
        }
    }
    machine acp_one(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> acp_copy(compose) }
    }
    machine acp_copy(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_ac(compose)
            _ -> acp_next(compose)
        }
    }
    machine prep_ac(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 1024 && compose.h2 < 32 {
            true -> do_ac(compose)
            _ -> bad(compose)
        }
    }
    machine do_ac(compose: &mut Compose) {
        compose.accepted[compose.h1] = compose.ident[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> acp_copy(compose) }
    }
    machine acp_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> acp_loop(compose) }
    }
    machine fin(compose: &mut Compose) {
        transition compose.rq == compose.req_n && compose.ok {
            true -> done()
            _ -> bad(compose)
        }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- description analysis -------------------------------------------------
// Skip `n` raw bytes inside `desc` (cur must be 2).
machine Compose::dskip(compose: &mut Compose, n: u64 in Wrapping) {
    compose.j = 0;
    transition { _ -> loop_s(compose, n) }
    machine loop_s(compose: &mut Compose, n: u64 in Wrapping) {
        transition compose.j < n && compose.j < 8192 && compose.dq < 8192 && compose.dq < compose.desc_n {
            true -> step(compose, n)
            _ -> check(compose, n)
        }
    }
    machine step(compose: &mut Compose, n: u64 in Wrapping) {
        Compose::rd(compose);
        compose.j = compose.j + 1;
        transition { _ -> loop_s(compose, n) }
    }
    machine check(compose: &mut Compose, n: u64 in Wrapping) {
        transition compose.j == n {
            true -> done()
            _ -> bad(compose)
        }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 100;
        compose.errtag[1] = 115;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Skip one tagged-evidence group: u8 class/kind tag + identity string +
// u8 evidence tag (+32 digest when nonzero). Used for entries, outgoing,
// custody rows inside a description.
machine Compose::dskip_row(compose: &mut Compose) {
    Compose::rd(compose);
    transition compose.ok {
        true -> str(compose)
        _ -> bad(compose)
    }
    machine str(compose: &mut Compose) {
        Compose::rdstr(compose);
        transition compose.ok {
            true -> ev(compose)
            _ -> bad(compose)
        }
    }
    machine ev(compose: &mut Compose) {
        Compose::rd(compose);
        transition compose.ok {
            true -> ev_g(compose)
            _ -> bad(compose)
        }
    }
    machine ev_g(compose: &mut Compose) {
        transition compose.b8 == 0 {
            true -> done()
            _ -> ev_digest(compose)
        }
    }
    machine ev_digest(compose: &mut Compose) {
        compose.t64 = 32;
        let t64_value: u64 in Wrapping = compose.t64;
        Compose::dskip(compose, t64_value);
        transition { _ -> done() }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 100;
        compose.errtag[1] = 114;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Skip a roster of tagged-evidence rows: u32 n + dskip_row x n.
machine Compose::dskip_rows(compose: &mut Compose) {
    Compose::ru32(compose);
    compose.t64 = compose.w32 as u64 in Wrapping;
    transition compose.t64 <= 64 && compose.ok {
        true -> init(compose)
        _ -> bad(compose)
    }
    machine init(compose: &mut Compose) {
        compose.dr_n = compose.t64;
        compose.jg = 0;
        transition { _ -> loop_s(compose) }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.jg < compose.dr_n && compose.jg < 64 && compose.ok {
            true -> one(compose)
            _ -> done()
        }
    }
    machine one(compose: &mut Compose) {
        Compose::dskip_row(compose);
        compose.jg = compose.jg + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 100;
        compose.errtag[1] = 82;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Parse the current `desc` buffer for instance `compose.i`: imports (slot +
// contract), exports (identity strings -> contract digests), assumptions;
// every other section is skipped over. Ends with the endpoint merge.
machine Compose::analyze_desc(compose: &mut Compose) {
    compose.dq = 0;
    compose.cur = 2;
    // magic[8] + schema u32 + frontier u8
    compose.t64 = 13;
    let t64_value: u64 in Wrapping = compose.t64;
    Compose::dskip(compose, t64_value);
    transition compose.ok {
        true -> art(compose)
        _ -> bad_01(compose)
    }
    machine art(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        let t64_value2: u64 in Wrapping = compose.t64;
        Compose::dskip(compose, t64_value2);
        transition compose.ok {
            true -> imps(compose)
            _ -> bad_02(compose)
        }
    }
    machine imps(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        transition compose.t64 <= 8 && compose.ok {
            true -> imp_init(compose)
            _ -> bad_03(compose)
        }
    }
    machine imp_init(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> imp_set_n(compose)
            _ -> bad_04(compose)
        }
    }
    machine imp_set_n(compose: &mut Compose) {
        compose.imp_n[compose.h0] = compose.t64;
        compose.ja = 0;
        transition { _ -> imp_loop(compose) }
    }
    machine imp_loop(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 && compose.ok {
            true -> imp_g(compose)
            _ -> bad_03b(compose)
        }
    }
    machine imp_g(compose: &mut Compose) {
        transition compose.ja < compose.imp_n[compose.h0] && compose.ja < 8 && compose.ok {
            true -> imp_slot_r(compose)
            _ -> exps(compose)
        }
    }
    machine imp_slot_r(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.h1 = compose.i * 8 + compose.ja;
        transition compose.ok && compose.h1 < 64 {
            true -> imp_slot_w(compose)
            _ -> bad_05(compose)
        }
    }
    machine imp_slot_w(compose: &mut Compose) {
        compose.imp_slot[compose.h1] = compose.w32 as u64 in Wrapping;
        transition { _ -> imp_str(compose) }
    }
    machine imp_str(compose: &mut Compose) {
        Compose::rdstr(compose);
        transition compose.ok {
            true -> imp_c(compose)
            _ -> bad_06(compose)
        }
    }
    machine imp_c(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> imp_c_loop(compose) }
    }
    machine imp_c_loop(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_ic(compose)
            _ -> imp_next(compose)
        }
    }
    machine prep_ic(compose: &mut Compose) {
        compose.h2 = compose.i * 256 + compose.ja * 32 + compose.k;
        compose.h3 = compose.k;
        transition compose.h2 < 2048 && compose.h3 < 32 {
            true -> do_ic(compose)
            _ -> bad_07(compose)
        }
    }
    machine do_ic(compose: &mut Compose) {
        compose.imp_contract[compose.h2] = compose.ident[compose.h3];
        compose.k = compose.k + 1;
        transition { _ -> imp_c_loop(compose) }
    }
    machine imp_next(compose: &mut Compose) {
        compose.ja = compose.ja + 1;
        transition { _ -> imp_loop(compose) }
    }
    machine exps(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        transition compose.t64 <= 8 && compose.ok {
            true -> exp_init(compose)
            _ -> bad_08(compose)
        }
    }
    machine exp_init(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> exp_set(compose)
            _ -> bad_09(compose)
        }
    }
    // The description names each export surface; its contract is the one
    // the verifier derived for it, already read with the instance record.
    // Both rosters list the same exports, so their counts must agree.
    machine exp_set(compose: &mut Compose) {
        compose.exp_n[compose.h0] = compose.t64;
        compose.jb = 0;
        transition compose.t64 == compose.derived_exp_n[compose.h0] {
            true -> exp_loop(compose)
            _ -> bad_11(compose)
        }
    }
    machine exp_loop(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 && compose.ok {
            true -> exp_g(compose)
            _ -> bad_08b(compose)
        }
    }
    machine exp_g(compose: &mut Compose) {
        transition compose.jb < compose.exp_n[compose.h0] && compose.jb < 8 && compose.ok {
            true -> exp_str(compose)
            _ -> rest(compose)
        }
    }
    machine exp_str(compose: &mut Compose) {
        Compose::rdstr(compose);
        transition compose.ok {
            true -> exp_next(compose)
            _ -> bad_10(compose)
        }
    }
    machine exp_next(compose: &mut Compose) {
        compose.jb = compose.jb + 1;
        transition { _ -> exp_loop(compose) }
    }
    // entries, outgoing, service_bounds, custody, providers, provider_closure,
    // obligations: all skipped.
    machine rest(compose: &mut Compose) {
        Compose::dskip_rows(compose);
        transition compose.ok {
            true -> rest2(compose)
            _ -> bad_14(compose)
        }
    }
    machine rest2(compose: &mut Compose) {
        Compose::dskip_rows(compose);
        transition compose.ok {
            true -> svc(compose)
            _ -> bad_15(compose)
        }
    }
    machine svc(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        transition compose.t64 <= 32 && compose.ok {
            true -> svc_init(compose)
            _ -> bad_16(compose)
        }
    }
    machine svc_init(compose: &mut Compose) {
        compose.n_svc = compose.t64;
        compose.jc = 0;
        transition { _ -> svc_loop(compose) }
    }
    machine svc_loop(compose: &mut Compose) {
        transition compose.jc < compose.n_svc && compose.jc < 32 && compose.ok {
            true -> svc_str(compose)
            _ -> cust(compose)
        }
    }
    machine svc_str(compose: &mut Compose) {
        Compose::rdstr(compose);
        transition compose.ok {
            true -> svc_n(compose)
            _ -> bad_17(compose)
        }
    }
    machine svc_n(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = (compose.w32 as u64 in Wrapping) * 8;
        let t64_value3: u64 in Wrapping = compose.t64;
        Compose::dskip(compose, t64_value3);
        compose.jc = compose.jc + 1;
        transition { _ -> svc_loop(compose) }
    }
    machine cust(compose: &mut Compose) {
        Compose::dskip_rows(compose);
        transition compose.ok {
            true -> provs(compose)
            _ -> bad_18(compose)
        }
    }
    machine provs(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        transition compose.t64 <= 32 && compose.ok {
            true -> prov_init(compose)
            _ -> bad_19(compose)
        }
    }
    machine prov_init(compose: &mut Compose) {
        compose.n_prov = compose.t64;
        compose.jd = 0;
        transition { _ -> prov_loop(compose) }
    }
    machine prov_loop(compose: &mut Compose) {
        transition compose.jd < compose.n_prov && compose.jd < 32 && compose.ok {
            true -> prov_head(compose)
            _ -> prov_cl(compose)
        }
    }
    machine prov_head(compose: &mut Compose) {
        compose.t64 = 40;
        let t64_value4: u64 in Wrapping = compose.t64;
        Compose::dskip(compose, t64_value4);
        transition compose.ok {
            true -> prov_n(compose)
            _ -> bad_20(compose)
        }
    }
    machine prov_n(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.d0 = compose.w32 as u64 in Wrapping;
        compose.m = 0;
        transition { _ -> prov_strs(compose) }
    }
    machine prov_strs(compose: &mut Compose) {
        transition compose.m < compose.d0 && compose.m < 32 && compose.ok {
            true -> prov_one(compose)
            _ -> prov_next(compose)
        }
    }
    machine prov_one(compose: &mut Compose) {
        Compose::rdstr(compose);
        compose.m = compose.m + 1;
        transition { _ -> prov_strs(compose) }
    }
    machine prov_next(compose: &mut Compose) {
        compose.jd = compose.jd + 1;
        transition { _ -> prov_loop(compose) }
    }
    machine prov_cl(compose: &mut Compose) {
        compose.t64 = 32;
        let t64_value5: u64 in Wrapping = compose.t64;
        Compose::dskip(compose, t64_value5);
        transition compose.ok {
            true -> obls(compose)
            _ -> bad_21(compose)
        }
    }
    // obligations: u8 kind + identity string + detail[32]
    machine obls(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        transition compose.t64 <= 32 && compose.ok {
            true -> obl_init(compose)
            _ -> bad_22(compose)
        }
    }
    machine obl_init(compose: &mut Compose) {
        compose.n_obl = compose.t64;
        compose.je = 0;
        transition { _ -> obl_loop(compose) }
    }
    machine obl_loop(compose: &mut Compose) {
        transition compose.je < compose.n_obl && compose.je < 32 && compose.ok {
            true -> obl_one(compose)
            _ -> asms(compose)
        }
    }
    machine obl_one(compose: &mut Compose) {
        Compose::rd(compose);
        Compose::rdstr(compose);
        Compose::rdstr(compose);
        compose.je = compose.je + 1;
        transition { _ -> obl_loop(compose) }
    }
    machine asms(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.t64 = compose.w32 as u64 in Wrapping;
        transition compose.t64 <= 8 && compose.ok {
            true -> asm_init(compose)
            _ -> bad_23(compose)
        }
    }
    machine asm_init(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> asm_set(compose)
            _ -> bad_24(compose)
        }
    }
    machine asm_set(compose: &mut Compose) {
        compose.inst_asm_n[compose.h0] = compose.t64;
        compose.jf = 0;
        transition { _ -> asm_loop(compose) }
    }
    machine asm_loop(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 && compose.ok {
            true -> asm_g(compose)
            _ -> bad_24b(compose)
        }
    }
    machine asm_g(compose: &mut Compose) {
        transition compose.jf < compose.inst_asm_n[compose.h0] && compose.jf < 8 && compose.ok {
            true -> asm_one(compose)
            _ -> realiz(compose)
        }
    }
    machine asm_one(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> asm_cp(compose) }
    }
    machine asm_cp(compose: &mut Compose) {
