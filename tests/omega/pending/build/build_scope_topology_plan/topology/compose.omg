// ---- components.bin decode ------------------------------------------------
// {u32 n} then n × {u32 desc_len, desc bytes, profile[32], u32 export_n,
// export_n × contract[32]}. The desc bytes
// are hashed (identity), analyzed (endpoints+assumptions), and the verified
// closure recomputed as sha256(closure-domain || desc_identity || profile).
machine Compose::decode_meta(compose: &mut Compose) {
    compose.mq = 0;
    compose.cur = 1;
    Compose::ru32(compose);
    compose.n_meta = compose.w32 as u64 in Wrapping;
    transition compose.n_meta == compose.n_inst && compose.ok {
        true -> init(compose)
        _ -> bad_34(compose)
    }
    machine init(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> loop_s(compose) }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.i < compose.n_meta && compose.i < 8 && compose.ok {
            true -> len_r(compose)
            _ -> done()
        }
    }
    machine len_r(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.desc_n = compose.w32 as u64 in Wrapping;
        transition compose.desc_n > 0 && compose.desc_n <= 8000 && compose.ok {
            true -> cp_init(compose)
            _ -> bad_35(compose)
        }
    }
    machine cp_init(compose: &mut Compose) {
        compose.j = 0;
        transition { _ -> cp_loop(compose) }
    }
    machine cp_loop(compose: &mut Compose) {
        transition compose.j < compose.desc_n && compose.j < 8192 && compose.ok {
            true -> cp_one(compose)
            _ -> prof(compose)
        }
    }
    machine cp_one(compose: &mut Compose) {
        Compose::rd(compose);
        compose.h1 = compose.j;
        transition compose.h1 < 8192 {
            true -> cp_w(compose)
            _ -> bad_36(compose)
        }
    }
    machine cp_w(compose: &mut Compose) {
        compose.desc[compose.h1] = compose.b8;
        compose.j = compose.j + 1;
        transition { _ -> cp_loop(compose) }
    }
    machine prof(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> prof_cp(compose) }
    }
    machine prof_cp(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_pc(compose)
            _ -> dc_count(compose)
        }
    }
    machine prep_pc(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 256 && compose.h2 < 32 {
            true -> do_pc(compose)
            _ -> bad_37(compose)
        }
    }
    machine do_pc(compose: &mut Compose) {
        compose.profiles[compose.h1] = compose.ident[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> prof_cp(compose) }
    }
    // The verifier-derived export contracts, in the description's export
    // roster order: an export endpoint carries this contract, never a
    // digest of its surface name.
    machine dc_count(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.h0 = compose.i;
        transition compose.w32 <= 8 && compose.h0 < 8 && compose.ok {
            true -> dc_set(compose)
            _ -> bad_45(compose)
        }
    }
    machine dc_set(compose: &mut Compose) {
        compose.derived_exp_n[compose.h0] = compose.w32 as u64 in Wrapping;
        compose.jb = 0;
        transition { _ -> dc_loop(compose) }
    }
    machine dc_loop(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> dc_row(compose)
            _ -> bad_45(compose)
        }
    }
    machine dc_row(compose: &mut Compose) {
        transition compose.jb < compose.derived_exp_n[compose.h0] && compose.jb < 8 {
            true -> dc_bytes(compose)
            _ -> meta_end(compose)
        }
    }
    machine dc_bytes(compose: &mut Compose) {
        compose.k = 0;
        transition { _ -> dc_byte_loop(compose) }
    }
    machine dc_byte_loop(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> dc_byte(compose)
            _ -> dc_next(compose)
        }
    }
    machine dc_byte(compose: &mut Compose) {
        Compose::rd(compose);
        compose.h2 = compose.i * 256 + compose.jb * 32 + compose.k;
        transition compose.h2 < 2048 && compose.ok {
            true -> dc_store(compose)
            _ -> bad_46(compose)
        }
    }
    machine dc_store(compose: &mut Compose) {
        compose.exp_contract[compose.h2] = compose.b8;
        compose.k = compose.k + 1;
        transition { _ -> dc_byte_loop(compose) }
    }
    machine dc_next(compose: &mut Compose) {
        compose.jb = compose.jb + 1;
        transition { _ -> dc_loop(compose) }
    }
    machine meta_end(compose: &mut Compose) {
        // every instance record is consumed in roster order
        transition { _ -> analyze(compose) }
    }
    machine analyze(compose: &mut Compose) {
        Compose::analyze_desc(compose);
        transition compose.ok {
            true -> did(compose)
            _ -> bad_38(compose)
        }
    }
    // desc_id = sha256("omega-component-description-v1" || u64 len || desc)
    machine did(compose: &mut Compose) {
        compose.dig.msg_n = compose.desc_n + 38;
        compose.k = 0;
        transition { _ -> did_dom(compose) }
    }
    machine did_dom(compose: &mut Compose) {
        transition compose.k < 30 {
            true -> prep_dd(compose)
            _ -> did_len(compose)
        }
    }
    machine prep_dd(compose: &mut Compose) {
        compose.h1 = compose.k;
        transition compose.h1 < 30 && compose.h1 < 8192 {
            true -> do_dd(compose)
            _ -> bad_39(compose)
        }
    }
    machine do_dd(compose: &mut Compose) {
        let domain: &[u8] = "omega-component-description-v1";
        compose.dig.msg[compose.h1] = domain[compose.h1];
        compose.k = compose.k + 1;
        transition { _ -> did_dom(compose) }
    }
    // u64 LE length word at bytes 30..38
    machine did_len(compose: &mut Compose) {
        compose.acc = compose.desc_n;
        compose.k = 0;
        transition { _ -> did_len_l(compose) }
    }
    machine did_len_l(compose: &mut Compose) {
        transition compose.k < 8 {
            true -> did_len_p(compose)
            _ -> did_loop_start(compose)
        }
    }
    machine did_len_p(compose: &mut Compose) {
        compose.h1 = 30 + compose.k;
        compose.h2 = 30 + compose.k;
        transition compose.h1 < 8192 && compose.h2 < 8192 {
            true -> did_len_w(compose)
            _ -> bad_39(compose)
        }
    }
    machine did_len_w(compose: &mut Compose) {
        compose.dig.msg[compose.h1] = narrow_u64_to_u8_wrapping(compose.acc as u64);
        compose.acc = compose.acc >> 8;
        compose.k = compose.k + 1;
        transition { _ -> did_len_l(compose) }
    }
    machine did_loop_start(compose: &mut Compose) {
        compose.k = 0;
        transition { _ -> did_loop(compose) }
    }
    machine did_loop(compose: &mut Compose) {
        transition compose.k < compose.desc_n && compose.k < 8192 {
            true -> prep_did(compose)
            _ -> did_run(compose)
        }
    }
    machine prep_did(compose: &mut Compose) {
        compose.h1 = compose.k;
        compose.h2 = 38 + compose.k;
        transition compose.h1 < 8192 && compose.h2 < 8192 {
            true -> do_did(compose)
            _ -> bad_39(compose)
        }
    }
    machine do_did(compose: &mut Compose) {
        compose.dig.msg[compose.h2] = compose.desc[compose.h1];
        compose.k = compose.k + 1;
        transition { _ -> did_loop(compose) }
    }
    machine did_run(compose: &mut Compose) {
        digest::Sha256::digest(&mut compose.dig);
        compose.k = 0;
        transition { _ -> did_cp(compose) }
    }
    machine did_cp(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_dc(compose)
            _ -> clo_pre(compose)
        }
    }
    machine prep_dc(compose: &mut Compose) {
        compose.h1 = compose.k;
        transition compose.h1 < 32 {
            true -> do_dc(compose)
            _ -> bad_40(compose)
        }
    }
    machine do_dc(compose: &mut Compose) {
        compose.desc_id[compose.h1] = compose.dig.out32[compose.h1];
        compose.k = compose.k + 1;
        transition { _ -> did_cp(compose) }
    }
    // closure = sha256("omega-verified-component-closure-v1" || desc_id || profile)
    machine clo_pre(compose: &mut Compose) {
        compose.dig.msg_n = 35 + 64;
        compose.k = 0;
        transition { _ -> clo_dom(compose) }
    }
    machine clo_dom(compose: &mut Compose) {
        transition compose.k < 35 {
            true -> prep_cd(compose)
            _ -> clo_did(compose)
        }
    }
    machine prep_cd(compose: &mut Compose) {
        compose.h1 = compose.k;
        transition compose.h1 < 35 && compose.h1 < 8192 {
            true -> do_cd(compose)
            _ -> bad_41(compose)
        }
    }
    machine do_cd(compose: &mut Compose) {
        let domain: &[u8] = "omega-verified-component-closure-v1";
        compose.dig.msg[compose.h1] = domain[compose.h1];
        compose.k = compose.k + 1;
        transition { _ -> clo_dom(compose) }
    }
    machine clo_did(compose: &mut Compose) {
        compose.k = 0;
        transition { _ -> clo_did_loop(compose) }
    }
    machine clo_did_loop(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_cl(compose)
            _ -> clo_pr(compose)
        }
    }
    machine prep_cl(compose: &mut Compose) {
        compose.h1 = 35 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 8192 && compose.h2 < 32 {
            true -> do_cl(compose)
            _ -> bad_42(compose)
        }
    }
    machine do_cl(compose: &mut Compose) {
        compose.dig.msg[compose.h1] = compose.desc_id[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> clo_did_loop(compose) }
    }
    machine clo_pr(compose: &mut Compose) {
        compose.k = 0;
        transition { _ -> clo_pr_loop(compose) }
    }
    machine clo_pr_loop(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_cp(compose)
            _ -> clo_run(compose)
        }
    }
    machine prep_cp(compose: &mut Compose) {
        compose.h1 = 67 + compose.k;
        compose.h2 = compose.i * 32 + compose.k;
        transition compose.h1 < 8192 && compose.h2 < 256 {
            true -> do_cp(compose)
            _ -> bad_43(compose)
        }
    }
    machine do_cp(compose: &mut Compose) {
        compose.dig.msg[compose.h1] = compose.profiles[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> clo_pr_loop(compose) }
    }
    machine clo_run(compose: &mut Compose) {
        digest::Sha256::digest(&mut compose.dig);
        compose.k = 0;
        transition { _ -> clo_cp(compose) }
    }
    machine clo_cp(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> prep_cc(compose)
            _ -> inst_next(compose)
        }
    }
    machine prep_cc(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 256 && compose.h2 < 32 {
            true -> do_cc(compose)
            _ -> bad_44(compose)
        }
    }
    machine do_cc(compose: &mut Compose) {
        compose.closures[compose.h1] = compose.dig.out32[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> clo_cp(compose) }
    }
    machine inst_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        compose.cur = 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
    machine bad_45(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_45_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_45_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 116;
        compose.errtag[2] = 52;
        compose.errtag[3] = 53;
        transition { _ -> bad(compose) }
    }
    machine bad_46(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_46_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_46_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 117;
        compose.errtag[2] = 52;
        compose.errtag[3] = 54;
        transition { _ -> bad(compose) }
    }
    machine bad_34(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_34_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_34_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 105;
        compose.errtag[2] = 51;
        compose.errtag[3] = 52;
        transition { _ -> bad(compose) }
    }
    machine bad_35(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_35_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_35_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 106;
        compose.errtag[2] = 51;
        compose.errtag[3] = 53;
        transition { _ -> bad(compose) }
    }
    machine bad_36(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_36_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_36_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 107;
        compose.errtag[2] = 51;
        compose.errtag[3] = 54;
        transition { _ -> bad(compose) }
    }
    machine bad_37(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_37_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_37_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 108;
        compose.errtag[2] = 51;
        compose.errtag[3] = 55;
        transition { _ -> bad(compose) }
    }
    machine bad_38(compose: &mut Compose) {
        transition { _ -> bad(compose) }
    }
    machine bad_39(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_39_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_39_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 110;
        compose.errtag[2] = 51;
        compose.errtag[3] = 57;
        transition { _ -> bad(compose) }
    }
    machine bad_40(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_40_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_40_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 111;
        compose.errtag[2] = 52;
        compose.errtag[3] = 48;
        transition { _ -> bad(compose) }
    }
    machine bad_41(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_41_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_41_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 112;
        compose.errtag[2] = 52;
        compose.errtag[3] = 49;
        transition { _ -> bad(compose) }
    }
    machine bad_42(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_42_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_42_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 113;
        compose.errtag[2] = 52;
        compose.errtag[3] = 50;
        transition { _ -> bad(compose) }
    }
    machine bad_43(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_43_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_43_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 114;
        compose.errtag[2] = 52;
        compose.errtag[3] = 51;
        transition { _ -> bad(compose) }
    }
    machine bad_44(compose: &mut Compose) {
        transition compose.errtag[0] == 63 {
            true -> bad_44_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad_44_s(compose: &mut Compose) {
        compose.errtag[0] = 66;
        compose.errtag[1] = 115;
        compose.errtag[2] = 52;
        compose.errtag[3] = 52;
        transition { _ -> bad(compose) }
    }
}

// ---- bindings.bin decode --------------------------------------------------
// {u32 n} then n x {ii,is,ei,es u32 + transport[32]}. Validates endpoint
// existence, direction, transport membership, canonical order, and complete
// import coverage; builds the demand-side adjacency adj[ii*8+ei]=1.
machine Compose::decode_bind(compose: &mut Compose) {
    compose.bq = 0;
    compose.cur = 3;
    // clear adjacency
    compose.j = 0;
    transition { _ -> clr(compose) }
    machine clr(compose: &mut Compose) {
        transition compose.j < 64 {
            true -> clr_w(compose)
            _ -> cnt(compose)
        }
    }
    machine clr_w(compose: &mut Compose) {
        compose.adj[compose.j] = 0;
        compose.j = compose.j + 1;
        transition { _ -> clr(compose) }
    }
    machine cnt(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.n_bind = compose.w32 as u64 in Wrapping;
        transition compose.n_bind <= 16 && compose.ok {
            true -> init(compose)
            _ -> bad(compose)
        }
    }
    machine init(compose: &mut Compose) {
        compose.i = 0;
        compose.prev_key = 0;
        transition { _ -> loop_s(compose) }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.i < compose.n_bind && compose.i < 16 && compose.ok {
            true -> e_ii(compose)
            _ -> coverage(compose)
        }
    }
    machine e_ii(compose: &mut Compose) {
        Compose::ru32(compose);
        compose.h0 = compose.i;
        transition compose.ok && compose.h0 < 16 {
            true -> e_ii_w(compose)
            _ -> bad(compose)
        }
    }
    machine e_ii_w(compose: &mut Compose) {
        compose.b_ii[compose.h0] = compose.w32 as u64 in Wrapping;
        transition compose.b_ii[compose.h0] < compose.n_inst {
            true -> e_is(compose)
            _ -> bad(compose)
        }
    }
    machine e_is(compose: &mut Compose) {
        Compose::ru32(compose);
        transition compose.ok && compose.h0 < 16 {
            true -> e_is_w(compose)
            _ -> bad(compose)
        }
    }
    machine e_is_w(compose: &mut Compose) {
        compose.b_is[compose.h0] = compose.w32 as u64 in Wrapping;
        transition { _ -> e_ei(compose) }
    }
    machine e_ei(compose: &mut Compose) {
        Compose::ru32(compose);
        transition compose.ok && compose.h0 < 16 {
            true -> e_ei_w(compose)
            _ -> bad(compose)
        }
    }
    machine e_ei_w(compose: &mut Compose) {
        compose.b_ei[compose.h0] = compose.w32 as u64 in Wrapping;
        transition compose.b_ei[compose.h0] < compose.n_inst {
            true -> e_es(compose)
            _ -> bad(compose)
        }
    }
    machine e_es(compose: &mut Compose) {
        Compose::ru32(compose);
        transition compose.ok && compose.h0 < 16 {
            true -> e_es_w(compose)
            _ -> bad(compose)
        }
    }
    machine e_es_w(compose: &mut Compose) {
        compose.b_es[compose.h0] = compose.w32 as u64 in Wrapping;
        transition { _ -> e_tr(compose) }
    }
    machine e_tr(compose: &mut Compose) {
        Compose::rdident(compose);
        compose.k = 0;
        transition { _ -> e_tr_cp(compose) }
    }
    machine e_tr_cp(compose: &mut Compose) {
        transition compose.k < 32 {
            true -> e_tr_prep(compose)
            _ -> e_tr_ok(compose)
        }
    }
    machine e_tr_prep(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 512 && compose.h2 < 32 {
            true -> e_tr_do(compose)
            _ -> bad(compose)
        }
    }
    machine e_tr_do(compose: &mut Compose) {
        compose.b_tr[compose.h1] = compose.ident[compose.h2];
        compose.k = compose.k + 1;
        transition { _ -> e_tr_cp(compose) }
    }
    // order: keys (ii,is,ei,es) strictly increase — lexicographic compare
    // against the previous binding.
    machine e_tr_ok(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.i == 0 {
            true -> e_ie_g(compose)
            _ -> e_cmp(compose)
        }
    }
    machine e_ie_g(compose: &mut Compose) {
        transition compose.h0 < 16 {
            true -> e_imp_exists(compose)
            _ -> bad(compose)
        }
    }
    machine e_cmp(compose: &mut Compose) {
        compose.h3 = compose.i - 1;
        transition compose.h3 < 16 && compose.h0 < 16 {
            true -> e_cmp_do(compose)
            _ -> bad(compose)
        }
    }
    machine e_cmp_do(compose: &mut Compose) {
        transition compose.b_ii[compose.h0] > compose.b_ii[compose.h3] ||
                   (compose.b_ii[compose.h0] == compose.b_ii[compose.h3] && compose.b_is[compose.h0] > compose.b_is[compose.h3]) ||
                   (compose.b_ii[compose.h0] == compose.b_ii[compose.h3] && compose.b_is[compose.h0] == compose.b_is[compose.h3] && compose.b_ei[compose.h0] > compose.b_ei[compose.h3]) ||
                   (compose.b_ii[compose.h0] == compose.b_ii[compose.h3] && compose.b_is[compose.h0] == compose.b_is[compose.h3] && compose.b_ei[compose.h0] == compose.b_ei[compose.h3] && compose.b_es[compose.h0] > compose.b_es[compose.h3]) {
            true -> e_ie_g(compose)
            _ -> bad(compose)
        }
    }
    // import endpoint (ii, is) must exist with dir=0 in ep table of inst ii
    machine e_imp_exists(compose: &mut Compose) {
        compose.j = 0;
        compose.found = false;
        compose.h1 = compose.b_ii[compose.h0];
        transition compose.h1 < 8 {
            true -> ie_loop(compose)
            _ -> bad(compose)
        }
    }
    machine ie_loop(compose: &mut Compose) {
        transition compose.h1 < 8 && compose.j < compose.ep_n[compose.h1] && compose.j < 16 && !compose.found {
            true -> ie_pick(compose)
            _ -> ie_done(compose)
        }
    }
    machine ie_pick(compose: &mut Compose) {
        compose.h3 = compose.h1 * 16 + compose.j;
        transition compose.h3 < 128 && compose.h0 < 16 {
            true -> ie_cmp(compose)
            _ -> bad(compose)
        }
    }
    machine ie_cmp(compose: &mut Compose) {
        transition compose.ep_slot[compose.h3] == compose.b_is[compose.h0] && compose.ep_dir[compose.h3] == 0 {
            true -> ie_hit(compose)
            _ -> ie_next(compose)
        }
    }
    machine ie_hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> ie_done(compose) }
    }
    machine ie_next(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition compose.h1 < 8 {
            true -> ie_loop(compose)
            _ -> bad(compose)
        }
    }
    machine ie_done(compose: &mut Compose) {
        transition compose.found && compose.h0 < 16 {
            true -> e_exp_exists(compose)
            _ -> bad(compose)
        }
    }
    // export endpoint (ei, es) must exist with dir=1
    machine e_exp_exists(compose: &mut Compose) {
        compose.j = 0;
        compose.found = false;
        compose.h1 = compose.b_ei[compose.h0];
        transition compose.h1 < 8 {
            true -> ee_loop(compose)
            _ -> bad(compose)
        }
    }
    machine ee_loop(compose: &mut Compose) {
        transition compose.h1 < 8 && compose.j < compose.ep_n[compose.h1] && compose.j < 16 && !compose.found {
            true -> ee_pick(compose)
            _ -> ee_done(compose)
        }
    }
    machine ee_pick(compose: &mut Compose) {
        compose.h3 = compose.h1 * 16 + compose.j;
        transition compose.h3 < 128 && compose.h0 < 16 {
            true -> ee_cmp(compose)
            _ -> bad(compose)
        }
    }
    machine ee_cmp(compose: &mut Compose) {
        transition compose.ep_slot[compose.h3] == compose.b_es[compose.h0] && compose.ep_dir[compose.h3] == 1 {
            true -> ee_hit(compose)
            _ -> ee_next(compose)
        }
    }
    machine ee_hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> ee_done(compose) }
    }
    machine ee_next(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> ee_loop(compose) }
    }
    machine ee_done(compose: &mut Compose) {
        transition compose.found {
            true -> e_tr_mem(compose)
            _ -> bad(compose)
        }
    }
    // transport must appear in the request's transport set
    machine e_tr_mem(compose: &mut Compose) {
        compose.j = 0;
        compose.found = false;
        transition { _ -> tm_loop(compose) }
    }
    machine tm_loop(compose: &mut Compose) {
        transition compose.j < compose.n_tr && compose.j < 8 && !compose.found {
            true -> tm_prep(compose)
            _ -> tm_done(compose)
        }
    }
    machine tm_prep(compose: &mut Compose) {
        compose.k = 0;
        compose.t64 = 1;
        transition { _ -> tm_cmp(compose) }
    }
    machine tm_cmp(compose: &mut Compose) {
        transition compose.k < 32 && compose.t64 == 1 {
            true -> tm_idx(compose)
            _ -> tm_dec(compose)
        }
    }
    machine tm_idx(compose: &mut Compose) {
        compose.h1 = compose.i * 32 + compose.k;
        compose.h2 = compose.j * 32 + compose.k;
        transition compose.h1 < 512 && compose.h2 < 256 {
            true -> tm_do(compose)
            _ -> bad(compose)
        }
    }
    machine tm_do(compose: &mut Compose) {
        transition compose.b_tr[compose.h1] != compose.transports[compose.h2] {
            true -> tm_neq(compose)
            _ -> tm_next(compose)
        }
    }
    machine tm_neq(compose: &mut Compose) {
        compose.t64 = 0;
        transition { _ -> tm_done_j(compose) }
    }
    machine tm_next(compose: &mut Compose) {
        compose.k = compose.k + 1;
        transition { _ -> tm_cmp(compose) }
    }
    machine tm_dec(compose: &mut Compose) {
        transition compose.k == 32 {
            true -> tm_hit(compose)
            _ -> tm_done_j(compose)
        }
    }
    machine tm_hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> tm_done_j(compose) }
    }
    machine tm_done_j(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> tm_loop(compose) }
    }
    machine tm_done(compose: &mut Compose) {
        transition compose.found {
            true -> e_adj_g(compose)
            _ -> bad(compose)
        }
    }
    // edge: import.instance -> export.instance
    machine e_adj_g(compose: &mut Compose) {
        transition compose.h0 < 16 {
            true -> e_adj(compose)
            _ -> bad(compose)
        }
    }
    machine e_adj(compose: &mut Compose) {
        compose.h1 = compose.b_ii[compose.h0] * 8 + compose.b_ei[compose.h0];
        transition compose.h1 < 64 {
            true -> e_adj_w(compose)
            _ -> bad(compose)
        }
    }
    machine e_adj_w(compose: &mut Compose) {
        compose.adj[compose.h1] = 1;
        compose.i = compose.i + 1;
        transition { _ -> loop_s(compose) }
    }
    // every declared import must be bound exactly once (order+scan ensure it)
    machine coverage(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> cov_i(compose) }
    }
    machine cov_i(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 && compose.ok {
            true -> cov_j(compose)
            _ -> fin(compose)
        }
    }
    machine cov_j(compose: &mut Compose) {
        compose.j = 0;
        transition { _ -> cov_jl(compose) }
    }
    machine cov_jl(compose: &mut Compose) {
        compose.h1 = compose.i;
        transition compose.h1 < 8 {
            true -> cov_jl2(compose)
            _ -> bad(compose)
        }
    }
    machine cov_jl2(compose: &mut Compose) {
        transition compose.j < compose.imp_n[compose.h1] && compose.j < 8 && compose.ok {
            true -> cov_scan(compose)
            _ -> cov_next_i(compose)
        }
    }
    machine cov_scan(compose: &mut Compose) {
        compose.m = 0;
        compose.found = false;
        compose.h2 = compose.i * 8 + compose.j;
        transition compose.h2 < 64 {
            true -> cov_bl(compose)
            _ -> bad(compose)
        }
    }
    machine cov_bl(compose: &mut Compose) {
        transition compose.m < compose.n_bind && compose.m < 16 && !compose.found {
            true -> cov_bp(compose)
            _ -> cov_bd(compose)
        }
    }
    machine cov_bp(compose: &mut Compose) {
        compose.h3 = compose.m;
        transition compose.h3 < 16 && compose.h2 < 64 {
            true -> cov_bc(compose)
            _ -> bad(compose)
        }
    }
    machine cov_bc(compose: &mut Compose) {
        transition compose.b_ii[compose.h3] == compose.i && compose.b_is[compose.h3] == compose.imp_slot[compose.h2] {
            true -> cov_bh(compose)
            _ -> cov_bn(compose)
        }
    }
    machine cov_bh(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> cov_bd(compose) }
    }
    machine cov_bn(compose: &mut Compose) {
        compose.m = compose.m + 1;
        transition { _ -> cov_bl(compose) }
    }
    machine cov_bd(compose: &mut Compose) {
        transition compose.found {
            true -> cov_next_j(compose)
            _ -> bad(compose)
        }
    }
    machine cov_next_j(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> cov_jl(compose) }
    }
    machine cov_next_i(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> cov_i(compose) }
    }
    machine fin(compose: &mut Compose) {
        transition compose.bq == compose.bind_n && compose.ok {
            true -> done()
            _ -> bad(compose)
        }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 98;
        compose.errtag[1] = 100;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- graph traversals -----------------------------------------------------
// reachable_from(src_mask, excl_mask): worklist traversal mirroring the
// reference — visited seeded with sources, successors expanded in index
// order, pop-last (LIFO); result = visited minus excluded, in reach[].
machine Compose::reach_go(compose: &mut Compose) {
    compose.i = 0;
    transition { _ -> init_loop(compose) }
    machine init_loop(compose: &mut Compose) {
        transition compose.i < 8 {
            true -> init_one(compose)
            _ -> seed(compose)
        }
    }
    machine init_one(compose: &mut Compose) {
        compose.visited[compose.i] = 0;
        compose.reach[compose.i] = 0;
        compose.i = compose.i + 1;
        transition { _ -> init_loop(compose) }
    }
    machine seed(compose: &mut Compose) {
        compose.i = 0;
        compose.qn = 0;
        transition { _ -> seed_loop(compose) }
    }
    machine seed_loop(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 {
            true -> seed_chk(compose)
            _ -> work(compose)
        }
    }
    machine seed_chk(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition (compose.src_mask >> compose.h0) & 1 == 1 && compose.h0 < 8 {
            true -> seed_w(compose)
            _ -> seed_next(compose)
        }
    }
    machine seed_w(compose: &mut Compose) {
        transition compose.qn < 16 && compose.h0 < 8 {
            true -> seed_w2(compose)
            _ -> bad(compose)
        }
    }
    machine seed_w2(compose: &mut Compose) {
        compose.visited[compose.h0] = 1;
        compose.queue[compose.qn] = compose.h0;
        compose.qn = compose.qn + 1;
        transition { _ -> seed_next(compose) }
    }
    machine seed_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> seed_loop(compose) }
    }
    machine work(compose: &mut Compose) {
        transition compose.qn > 0 && compose.qn <= 16 {
            true -> pop(compose)
            _ -> sweep(compose)
        }
    }
    machine pop(compose: &mut Compose) {
        compose.qn = compose.qn - 1;
        transition compose.qn < 16 {
            true -> pop_w(compose)
            _ -> bad(compose)
        }
    }
    machine pop_w(compose: &mut Compose) {
        compose.vtx = compose.queue[compose.qn];
        compose.j = 0;
        transition { _ -> succ(compose) }
    }
    machine succ(compose: &mut Compose) {
        transition compose.j < compose.n_inst && compose.j < 8 {
            true -> succ_g(compose)
            _ -> work(compose)
        }
    }
    machine succ_g(compose: &mut Compose) {
        compose.h0 = compose.vtx * 8 + compose.j;
        compose.h1 = compose.j;
        transition compose.h0 < 64 && compose.h1 < 8 {
            true -> succ_chk(compose)
            _ -> bad(compose)
        }
    }
    machine succ_chk(compose: &mut Compose) {
        transition compose.adj[compose.h0] == 1 && ((compose.excl_mask >> compose.h1) & 1) == 0 && compose.visited[compose.h1] == 0 {
            true -> succ_w(compose)
            _ -> succ_next(compose)
        }
    }
    machine succ_w(compose: &mut Compose) {
        compose.visited[compose.h1] = 1;
        transition compose.qn < 16 {
            true -> succ_push(compose)
            _ -> bad(compose)
        }
    }
    machine succ_push(compose: &mut Compose) {
        compose.queue[compose.qn] = compose.h1;
        compose.qn = compose.qn + 1;
        transition { _ -> succ_next(compose) }
    }
    machine succ_next(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> succ(compose) }
    }
    machine sweep(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> sweep_loop(compose) }
    }
    machine sweep_loop(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 {
            true -> sweep_chk(compose)
            _ -> done()
        }
    }
    machine sweep_chk(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> sweep_do(compose)
            _ -> bad(compose)
        }
    }
    machine sweep_do(compose: &mut Compose) {
        transition compose.visited[compose.h0] == 1 && ((compose.excl_mask >> compose.h0) & 1) == 0 {
            true -> sweep_yes(compose)
            _ -> sweep_no(compose)
        }
    }
    machine sweep_yes(compose: &mut Compose) {
        compose.reach[compose.h0] = 1;
        transition { _ -> sweep_next(compose) }
    }
    machine sweep_no(compose: &mut Compose) {
        transition { _ -> sweep_next(compose) }
    }
    machine sweep_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> sweep_loop(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// shortest_path(src_mask, tgt_mask, excl_mask): multi-source BFS over
// canonical successors; on hit, walks parents back. found=false if none.
machine Compose::spath(compose: &mut Compose) {
    compose.i = 0;
    transition { _ -> init_loop(compose) }
    machine init_loop(compose: &mut Compose) {
        transition compose.i < 8 {
            true -> init_one(compose)
            _ -> seed(compose)
        }
    }
    machine init_one(compose: &mut Compose) {
        compose.visited[compose.i] = 0;
        compose.has_parent[compose.i] = 0;
        compose.parent[compose.i] = 0;
        compose.i = compose.i + 1;
        transition { _ -> init_loop(compose) }
    }
    // visited starts at excluded; sources enqueue only if not excluded
    machine seed(compose: &mut Compose) {
        compose.i = 0;
        compose.qh = 0;
        compose.qn = 0;
        compose.found = false;
        transition { _ -> seed_loop(compose) }
    }
    machine seed_loop(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 {
            true -> seed_chk(compose)
            _ -> work(compose)
        }
    }
    machine seed_chk(compose: &mut Compose) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> seed_bits(compose)
            _ -> bad(compose)
        }
    }
    machine seed_bits(compose: &mut Compose) {
        transition ((compose.src_mask >> compose.h0) & 1) == 1 && ((compose.excl_mask >> compose.h0) & 1) == 0 {
            true -> seed_w(compose)
            _ -> seed_excl(compose)
        }
    }
    machine seed_excl(compose: &mut Compose) {
        transition ((compose.excl_mask >> compose.h0) & 1) == 1 {
            true -> seed_xw(compose)
            _ -> seed_next(compose)
        }
    }
    machine seed_xw(compose: &mut Compose) {
        compose.visited[compose.h0] = 1;
        transition { _ -> seed_next(compose) }
    }
    machine seed_w(compose: &mut Compose) {
        transition compose.qn < 16 {
            true -> seed_w2(compose)
            _ -> bad(compose)
        }
    }
    machine seed_w2(compose: &mut Compose) {
        compose.visited[compose.h0] = 1;
        compose.t64 = compose.qh + compose.qn;
        transition compose.t64 < 16 {
            true -> seed_wq(compose)
            _ -> bad(compose)
        }
    }
    machine seed_wq(compose: &mut Compose) {
        compose.queue[compose.t64] = compose.h0;
        compose.qn = compose.qn + 1;
        transition { _ -> seed_next(compose) }
    }
    machine seed_next(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> seed_loop(compose) }
    }
    machine work(compose: &mut Compose) {
        transition compose.qn > 0 && compose.qn <= 16 && !compose.found {
            true -> pop(compose)
            _ -> trace(compose)
        }
    }
    machine pop(compose: &mut Compose) {
        transition compose.qh < 16 {
            true -> pop_w(compose)
            _ -> bad(compose)
        }
    }
    machine pop_w(compose: &mut Compose) {
        compose.vtx = compose.queue[compose.qh];
        compose.qh = compose.qh + 1;
        compose.qn = compose.qn - 1;
        transition { _ -> is_tgt(compose) }
    }
    machine is_tgt(compose: &mut Compose) {
        compose.h0 = compose.vtx;
        transition compose.h0 < 8 {
            true -> tgt_chk(compose)
            _ -> bad(compose)
        }
    }
    machine tgt_chk(compose: &mut Compose) {
        transition ((compose.tgt_mask >> compose.h0) & 1) == 1 {
            true -> hit(compose)
            _ -> expand(compose)
        }
    }
    machine hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> trace(compose) }
    }
    machine expand(compose: &mut Compose) {
        compose.j = 0;
        transition { _ -> succ(compose) }
    }
    machine succ(compose: &mut Compose) {
        transition compose.j < compose.n_inst && compose.j < 8 && !compose.found {
            true -> succ_g(compose)
            _ -> work(compose)
        }
    }
    machine succ_g(compose: &mut Compose) {
        compose.h0 = compose.vtx * 8 + compose.j;
        compose.h1 = compose.j;
        transition compose.h0 < 64 && compose.h1 < 8 {
            true -> succ_chk(compose)
            _ -> bad(compose)
        }
    }
    machine succ_chk(compose: &mut Compose) {
        transition compose.adj[compose.h0] == 1 && compose.visited[compose.h1] == 0 {
            true -> succ_w(compose)
            _ -> succ_next(compose)
        }
    }
    machine succ_w(compose: &mut Compose) {
        compose.visited[compose.h1] = 1;
        compose.parent[compose.h1] = compose.vtx;
        compose.has_parent[compose.h1] = 1;
        compose.qi = compose.qh + compose.qn;
        transition compose.qn < 16 && compose.qi < 16 {
            true -> succ_push(compose)
            _ -> bad(compose)
        }
    }
    machine succ_push(compose: &mut Compose) {
        compose.queue[compose.qi] = compose.h1;
        compose.qn = compose.qn + 1;
        transition { _ -> succ_next(compose) }
    }
    machine succ_next(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> succ(compose) }
    }
    // walk parent chain from vtx, collecting reversed path
    machine trace(compose: &mut Compose) {
        transition compose.found {
            true -> tr_init(compose)
            _ -> done()
        }
    }
    machine tr_init(compose: &mut Compose) {
        compose.path_n = 0;
        compose.m = compose.vtx;
        transition { _ -> tr_loop(compose) }
    }
    machine tr_loop(compose: &mut Compose) {
        transition compose.path_n < 8 && compose.m < 8 {
            true -> tr_push(compose)
            _ -> rev(compose)
        }
    }
    machine tr_push(compose: &mut Compose) {
        compose.h0 = compose.path_n;
        transition compose.h0 < 8 {
            true -> tr_w(compose)
            _ -> bad(compose)
        }
    }
    machine tr_w(compose: &mut Compose) {
        compose.path[compose.h0] = compose.m;
        compose.path_n = compose.path_n + 1;
        transition { _ -> tr_up(compose) }
    }
    machine tr_up(compose: &mut Compose) {
        compose.h0 = compose.m;
        transition compose.h0 < 8 {
            true -> tr_up2(compose)
            _ -> bad(compose)
        }
    }
    machine tr_up2(compose: &mut Compose) {
        transition compose.has_parent[compose.h0] == 1 {
            true -> tr_p(compose)
            _ -> rev(compose)
        }
    }
    machine tr_p(compose: &mut Compose) {
        compose.m = compose.parent[compose.h0];
        transition { _ -> tr_loop(compose) }
    }
    // reverse path[] in place
    machine rev(compose: &mut Compose) {
        compose.i = 0;
        transition { _ -> rev_loop(compose) }
    }
    machine rev_loop(compose: &mut Compose) {
        compose.d0 = compose.path_n / 2;
        transition compose.i < compose.d0 && compose.i < 8 {
            true -> rev_prep(compose)
            _ -> done()
        }
    }
    machine rev_prep(compose: &mut Compose) {
        compose.h0 = compose.i;
        compose.h1 = compose.path_n - 1 - compose.i;
        transition compose.h0 < 8 && compose.h1 < 8 {
            true -> rev_do(compose)
            _ -> bad(compose)
        }
    }
    machine rev_do(compose: &mut Compose) {
        compose.t64 = compose.path[compose.h0];
        compose.path[compose.h0] = compose.path[compose.h1];
        compose.path[compose.h1] = compose.t64;
        compose.i = compose.i + 1;
        transition { _ -> rev_loop(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- policy evaluation ----------------------------------------------------
// For each policy: resolve masks (done at decode), then evaluate per
// predicate. no_route: satisfied iff reachable(sources) disjoint targets.
// only_via: needs a source->target path; then reduced reach (excluding via)
// must not reach targets. Outcomes recorded as tags + index lists.
machine Compose::eval_all(compose: &mut Compose) {
    compose.cp = 0;
    transition { _ -> loop_s(compose) }
    machine loop_s(compose: &mut Compose) {
        transition compose.cp < compose.n_pol && compose.cp < 8 && compose.ok {
            true -> setup(compose)
            _ -> done()
        }
    }
    machine setup(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> disp(compose)
            _ -> bad(compose)
        }
    }
    machine disp(compose: &mut Compose) {
        compose.src_mask = compose.pol_s[compose.h0];
        compose.tgt_mask = compose.pol_t[compose.h0];
        compose.excl_mask = compose.pol_v[compose.h0];
        transition compose.pol_tag[compose.h0] == 1 {
            true -> nr_reach(compose)
            _ -> ov_path(compose)
        }
    }
    // no_route
    machine nr_reach(compose: &mut Compose) {
        compose.excl_mask = 0;
        Compose::reach_go(compose);
        transition compose.ok {
            true -> nr_check(compose)
            _ -> bad(compose)
        }
    }
    machine nr_check(compose: &mut Compose) {
        // any reached target => violated with shortest bypass witness
        compose.j = 0;
        compose.found = false;
        transition { _ -> nr_scan(compose) }
    }
    machine nr_scan(compose: &mut Compose) {
        transition compose.j < compose.n_inst && compose.j < 8 && !compose.found {
            true -> nr_c(compose)
            _ -> nr_dec(compose)
        }
    }
    machine nr_c(compose: &mut Compose) {
        compose.h1 = compose.j;
        transition compose.h1 < 8 {
            true -> nr_c2(compose)
            _ -> bad(compose)
        }
    }
    machine nr_c2(compose: &mut Compose) {
        transition compose.reach[compose.h1] == 1 && ((compose.tgt_mask >> compose.h1) & 1) == 1 {
            true -> nr_hit(compose)
            _ -> nr_next(compose)
        }
    }
    machine nr_hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> nr_dec(compose) }
    }
    machine nr_next(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> nr_scan(compose) }
    }
    machine nr_dec(compose: &mut Compose) {
        transition compose.found {
            true -> nr_bypass(compose)
            _ -> nr_sat(compose)
        }
    }
    machine nr_bypass(compose: &mut Compose) {
        compose.excl_mask = 0;
        Compose::spath(compose);
        transition compose.ok && compose.found {
            true -> rec_bypass_g(compose)
            _ -> bad(compose)
        }
    }
    machine rec_bypass_g(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> rec_bypass(compose)
            _ -> bad(compose)
        }
    }
    machine rec_bypass(compose: &mut Compose) {
        compose.pol_out[compose.h0] = 2;
        compose.pol_kind[compose.h0] = 1;
        compose.pol_wit_n[compose.h0] = compose.path_n;
        compose.k = 0;
        transition { _ -> rec_bp_loop(compose) }
    }
    machine rec_bp_loop(compose: &mut Compose) {
        transition compose.k < compose.path_n && compose.k < 8 {
            true -> rec_bp_p(compose)
            _ -> next_i(compose)
        }
    }
    machine rec_bp_p(compose: &mut Compose) {
        compose.h1 = compose.h0 * 8 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 64 && compose.h2 < 8 {
            true -> rec_bp_w(compose)
            _ -> bad(compose)
        }
    }
    machine rec_bp_w(compose: &mut Compose) {
        compose.pol_wit[compose.h1] = narrow_u64_to_u8_wrapping(compose.path[compose.h2] as u64);
        compose.k = compose.k + 1;
        transition { _ -> rec_bp_loop(compose) }
    }
    machine nr_sat(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> nr_sat_w(compose)
            _ -> bad(compose)
        }
    }
    machine nr_sat_w(compose: &mut Compose) {
        compose.pol_out[compose.h0] = 1;
        compose.pol_kind[compose.h0] = 0;
        compose.pol_wit_n[compose.h0] = 0;
        // reachable list = reach[] ascending
        compose.j = 0;
        compose.pol_reach_n[compose.h0] = 0;
        transition { _ -> nr_rr(compose) }
    }
    machine nr_rr(compose: &mut Compose) {
        compose.h1 = compose.h0;
        transition compose.j < compose.n_inst && compose.j < 8 {
            true -> nr_rc(compose)
            _ -> next_i(compose)
        }
    }
    machine nr_rc(compose: &mut Compose) {
        compose.h2 = compose.j;
        transition compose.h2 < 8 {
            true -> nr_rc2(compose)
            _ -> bad(compose)
        }
    }
    machine nr_rc2(compose: &mut Compose) {
        transition compose.reach[compose.h2] == 1 && compose.h0 < 8 {
            true -> nr_push(compose)
            _ -> nr_rn(compose)
        }
    }
    machine nr_push(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> nr_push2(compose)
            _ -> bad(compose)
        }
    }
    machine nr_push2(compose: &mut Compose) {
        compose.h3 = compose.h0 * 8 + compose.pol_reach_n[compose.h0];
        transition compose.h3 < 64 && compose.pol_reach_n[compose.h0] < 8 {
            true -> nr_pw(compose)
            _ -> bad(compose)
        }
    }
    machine nr_pw(compose: &mut Compose) {
        compose.pol_reach[compose.h3] = narrow_u64_to_u8_wrapping(compose.h2 as u64);
        compose.pol_reach_n[compose.h0] = compose.pol_reach_n[compose.h0] + 1;
        transition { _ -> nr_rn(compose) }
    }
    machine nr_rn(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> nr_rr(compose) }
    }
    // only_via
    machine ov_path(compose: &mut Compose) {
        compose.excl_mask = 0;
        Compose::spath(compose);
        transition compose.ok {
            true -> ov_path_g(compose)
            _ -> bad(compose)
        }
    }
    machine ov_path_g(compose: &mut Compose) {
        transition compose.found {
            true -> ov_reach(compose)
            _ -> rec_disc(compose)
        }
    }
    machine rec_disc(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> rec_disc_w(compose)
            _ -> bad(compose)
        }
    }
    machine rec_disc_w(compose: &mut Compose) {
        compose.pol_out[compose.h0] = 2;
        compose.pol_kind[compose.h0] = 2;
        compose.pol_wit_n[compose.h0] = 0;
        compose.pol_reach_n[compose.h0] = 0;
        transition { _ -> next_i(compose) }
    }
    machine ov_reach(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> ov_reach_w(compose)
            _ -> bad(compose)
        }
    }
    // save the found path before the reduced traversal overwrites it
    machine ov_reach_w(compose: &mut Compose) {
        compose.pol_wit_n[compose.h0] = compose.path_n;
        compose.k = 0;
        transition { _ -> ov_cp(compose) }
    }
    machine ov_cp(compose: &mut Compose) {
        transition compose.k < compose.path_n && compose.k < 8 {
            true -> ov_cp_p(compose)
            _ -> ov_red_g(compose)
        }
    }
    machine ov_red_g(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> ov_red(compose)
            _ -> bad(compose)
        }
    }
    machine ov_cp_p(compose: &mut Compose) {
        compose.h1 = compose.h0 * 8 + compose.k;
        compose.h2 = compose.k;
        transition compose.h1 < 64 && compose.h2 < 8 {
            true -> ov_cp_w(compose)
            _ -> bad(compose)
        }
    }
    machine ov_cp_w(compose: &mut Compose) {
        compose.pol_wit[compose.h1] = narrow_u64_to_u8_wrapping(compose.path[compose.h2] as u64);
        compose.k = compose.k + 1;
        transition { _ -> ov_cp(compose) }
    }
    machine ov_red(compose: &mut Compose) {
        compose.excl_mask = compose.pol_v[compose.h0];
        Compose::reach_go(compose);
        transition compose.ok {
            true -> ov_check(compose)
            _ -> bad(compose)
        }
    }
    machine ov_check(compose: &mut Compose) {
        compose.j = 0;
        compose.found = false;
        transition { _ -> ov_scan(compose) }
    }
    machine ov_scan(compose: &mut Compose) {
        transition compose.j < compose.n_inst && compose.j < 8 && !compose.found {
            true -> ov_c(compose)
            _ -> ov_dec(compose)
        }
    }
    machine ov_c(compose: &mut Compose) {
        compose.h1 = compose.j;
        transition compose.h1 < 8 {
            true -> ov_c2(compose)
            _ -> bad(compose)
        }
    }
    machine ov_c2(compose: &mut Compose) {
        transition compose.reach[compose.h1] == 1 && ((compose.tgt_mask >> compose.h1) & 1) == 1 {
            true -> ov_hit(compose)
            _ -> ov_next(compose)
        }
    }
    machine ov_hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> ov_dec(compose) }
    }
    machine ov_next(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> ov_scan(compose) }
    }
    machine ov_dec(compose: &mut Compose) {
        transition compose.found {
            true -> ov_bypass(compose)
            _ -> ov_sat(compose)
        }
    }
    machine ov_bypass(compose: &mut Compose) {
        compose.h1 = compose.cp;
        transition compose.h1 < 8 {
            true -> ov_bypass_r(compose)
            _ -> bad(compose)
        }
    }
    machine ov_bypass_r(compose: &mut Compose) {
        compose.excl_mask = compose.pol_v[compose.h1];
        Compose::spath(compose);
        transition compose.ok && compose.found {
            true -> rec_bypass_g(compose)
            _ -> bad(compose)
        }
    }
    machine ov_sat(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> ov_sat_w(compose)
            _ -> bad(compose)
        }
    }
    machine ov_sat_w(compose: &mut Compose) {
        compose.pol_out[compose.h0] = 1;
        compose.pol_kind[compose.h0] = 0;
        // witness path already in pol_wit; record reduced reachable
        compose.j = 0;
        compose.pol_reach_n[compose.h0] = 0;
        transition { _ -> nr_rr(compose) }
    }
    machine next_i(compose: &mut Compose) {
        compose.cp = compose.cp + 1;
        transition { _ -> loop_s(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- emission -------------------------------------------------------------
// Emit instance `compose.cp`'s name: u32 len + bytes from names[].
machine Compose::emit_name(compose: &mut Compose) {
    compose.h0 = compose.cp;
    transition compose.h0 < 8 {
        true -> len(compose)
        _ -> bad(compose)
    }
    machine len(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.name_len[compose.h0] as u64);
        Compose::emit_u32(compose);
        compose.k = 0;
        transition compose.h0 < 8 {
            true -> loop_s(compose)
            _ -> bad(compose)
        }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.h0 < 8 && compose.k < compose.name_len[compose.h0] && compose.k < 128 && compose.ok {
            true -> prep(compose)
            _ -> done()
        }
    }
    machine prep(compose: &mut Compose) {
        compose.h1 = compose.cp * 128 + compose.k;
        transition compose.h1 < 1024 {
            true -> put(compose)
            _ -> bad(compose)
        }
    }
    machine put(compose: &mut Compose) {
        compose.w8 = compose.names[compose.h1];
        Compose::emit_u8(compose);
        compose.k = compose.k + 1;
        transition compose.h0 < 8 {
            true -> loop_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Emit the raw call bytes of policy `compose.cp` verbatim (copied from the
// admitted request span — preserves canonical call encoding).
machine Compose::emit_pol_call(compose: &mut Compose) {
    compose.h0 = compose.cp;
    transition compose.h0 < 8 {
        true -> init(compose)
        _ -> bad(compose)
    }
    machine init(compose: &mut Compose) {
        compose.k = 0;
        transition compose.h0 < 8 {
            true -> loop_s(compose)
            _ -> bad(compose)
        }
    }
    machine loop_s(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> loop_s2(compose)
            _ -> bad(compose)
        }
    }
    machine loop_s2(compose: &mut Compose) {
        compose.h1 = compose.pol_off[compose.h0] + compose.k;
        transition compose.k < compose.pol_len[compose.h0] && compose.h1 < 8192 && compose.ok {
            true -> put_g(compose)
            _ -> done()
        }
    }
    machine put_g(compose: &mut Compose) {
        transition compose.h1 < 8192 {
            true -> put(compose)
            _ -> bad(compose)
        }
    }
    machine put(compose: &mut Compose) {
        compose.w8 = compose.req[compose.h1];
        Compose::emit_u8(compose);
        compose.k = compose.k + 1;
        transition compose.h0 < 8 {
            true -> loop_s(compose)
            _ -> bad(compose)
        }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Emit instance `compose.cp`: name, role, component description, endpoints.
machine Compose::emit_inst(compose: &mut Compose) {
    Compose::emit_name(compose);
    compose.w8 = 0;
    Compose::emit_u8(compose);
    compose.h0 = compose.cp * 32;
    transition compose.h0 < 256 {
        true -> subj(compose)
        _ -> bad(compose)
    }
    machine subj(compose: &mut Compose) {
        compose.src = 7;
        Compose::emit_ident(compose);
        transition { _ -> prof(compose) }
    }
    machine prof(compose: &mut Compose) {
        compose.src = 5;
        Compose::emit_ident(compose);
        transition { _ -> comp(compose) }
    }
    machine comp(compose: &mut Compose) {
        compose.w8 = 1;
        Compose::emit_u8(compose);
        compose.src = 6;
        Compose::emit_ident(compose);
        transition { _ -> asms(compose) }
    }
    machine asms(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> asm_n(compose)
            _ -> bad(compose)
        }
    }
    machine asm_n(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.inst_asm_n[compose.h0] as u64);
        Compose::emit_u32(compose);
        compose.j = 0;
        transition { _ -> asm_loop(compose) }
    }
    machine asm_loop(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 && compose.j < compose.inst_asm_n[compose.h0] && compose.j < 8 && compose.ok {
            true -> asm_one(compose)
            _ -> eps(compose)
        }
    }
    machine asm_one(compose: &mut Compose) {
        compose.h0 = compose.cp * 256 + compose.j * 32;
        compose.src = 4;
        Compose::emit_ident(compose);
        compose.j = compose.j + 1;
        transition { _ -> asm_loop(compose) }
    }
    machine eps(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> ep_n(compose)
            _ -> bad(compose)
        }
    }
    machine ep_n(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.ep_n[compose.h0] as u64);
        Compose::emit_u32(compose);
        compose.j = 0;
        transition compose.h0 < 8 {
            true -> ep_loop(compose)
            _ -> bad(compose)
        }
    }
    machine ep_loop(compose: &mut Compose) {
        transition compose.h0 < 8 && compose.j < compose.ep_n[compose.h0] && compose.j < 16 && compose.ok {
            true -> ep_slot(compose)
            _ -> done()
        }
    }
    machine ep_slot(compose: &mut Compose) {
        compose.h1 = compose.cp * 16 + compose.j;
        transition compose.h1 < 128 {
            true -> ep_sw(compose)
            _ -> bad(compose)
        }
    }
    machine ep_sw(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.ep_slot[compose.h1] as u64);
        Compose::emit_u32(compose);
        compose.w8 = compose.ep_dir[compose.h1];
        Compose::emit_u8(compose);
        transition { _ -> ep_c(compose) }
    }
    machine ep_c(compose: &mut Compose) {
        compose.h0 = compose.h1 * 32;
        compose.src = 2;
        Compose::emit_ident(compose);
        compose.j = compose.j + 1;
        transition { _ -> ep_loop_r(compose) }
    }
    machine ep_loop_r(compose: &mut Compose) {
        compose.h0 = compose.cp;
        transition compose.h0 < 8 {
            true -> ep_loop(compose)
            _ -> bad(compose)
        }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Emit binding `compose.cp`: ii, is, ei, es u32s + transport[32] from b_tr.
machine Compose::emit_bind(compose: &mut Compose) {
    compose.h0 = compose.cp;
    transition compose.h0 < 16 {
        true -> e1(compose)
        _ -> bad(compose)
    }
    machine e1(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.b_ii[compose.h0] as u64);
        Compose::emit_u32(compose);
        transition { _ -> e2(compose) }
    }
    machine e2(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.b_is[compose.h0] as u64);
        Compose::emit_u32(compose);
        transition { _ -> e3(compose) }
    }
    machine e3(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.b_ei[compose.h0] as u64);
        Compose::emit_u32(compose);
        transition { _ -> e4(compose) }
    }
    machine e4(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.b_es[compose.h0] as u64);
        Compose::emit_u32(compose);
        transition { _ -> etr(compose) }
    }
    machine etr(compose: &mut Compose) {
        compose.h0 = compose.cp * 32;
        compose.src = 3;
        Compose::emit_ident(compose);
        transition { _ -> done() }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// Emit policy `compose.cp`: verifier identity + verbatim call + outcome record.
machine Compose::emit_pol(compose: &mut Compose) {
    compose.src = 8;
    compose.h0 = 0;
    Compose::emit_ident(compose);
    Compose::emit_pol_call(compose);
    compose.h0 = compose.cp;
    transition compose.h0 < 8 && compose.ok {
        true -> shape(compose)
        _ -> bad(compose)
    }
    machine shape(compose: &mut Compose) {
        transition compose.pol_out[compose.h0] == 1 && compose.h0 < 8 {
            true -> sat(compose)
            _ -> vio_g(compose)
        }
    }
    machine vio_g(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> vio(compose)
            _ -> bad(compose)
        }
    }
    machine sat(compose: &mut Compose) {
        compose.w8 = 1;
        Compose::emit_u8(compose);
        transition compose.pol_tag[compose.h0] == 1 && compose.h0 < 8 {
            true -> nr_cert(compose)
            _ -> ov_cert_g(compose)
        }
    }
    machine ov_cert_g(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> ov_cert(compose)
            _ -> bad(compose)
        }
    }
    // no_route certificate: indices{reachable}
    machine nr_cert(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> nr_cert2(compose)
            _ -> bad(compose)
        }
    }
    machine nr_cert2(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.pol_reach_n[compose.h0] as u64);
        Compose::emit_u32(compose);
        compose.k = 0;
        transition { _ -> nr_cl(compose) }
    }
    machine nr_cl(compose: &mut Compose) {
        transition compose.h0 < 8 && compose.k < compose.pol_reach_n[compose.h0] && compose.k < 8 && compose.ok {
            true -> nr_cp(compose)
            _ -> done()
        }
    }
    machine nr_cp(compose: &mut Compose) {
        compose.h1 = compose.h0 * 8 + compose.k;
        transition compose.h1 < 64 {
            true -> nr_cw(compose)
            _ -> bad(compose)
        }
    }
    machine nr_cw(compose: &mut Compose) {
        compose.w32 = compose.pol_reach[compose.h1] as u32;
        Compose::emit_u32(compose);
        compose.k = compose.k + 1;
        transition { _ -> nr_cl(compose) }
    }
    // only_via certificate: indices{path} + indices{reachable}
    machine ov_cert(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.pol_wit_n[compose.h0] as u64);
        Compose::emit_u32(compose);
        compose.k = 0;
        transition { _ -> ov_pl(compose) }
    }
    machine ov_pl(compose: &mut Compose) {
        transition compose.h0 < 8 && compose.k < compose.pol_wit_n[compose.h0] && compose.k < 8 && compose.ok {
            true -> ov_pp(compose)
            _ -> nr_cert_g(compose)
        }
    }
    machine nr_cert_g(compose: &mut Compose) {
        transition compose.h0 < 8 {
            true -> nr_cert(compose)
            _ -> bad(compose)
        }
    }
    machine ov_pp(compose: &mut Compose) {
        compose.h1 = compose.h0 * 8 + compose.k;
        transition compose.h1 < 64 {
            true -> ov_pw(compose)
            _ -> bad(compose)
        }
    }
    machine ov_pw(compose: &mut Compose) {
        compose.w32 = compose.pol_wit[compose.h1] as u32;
        Compose::emit_u32(compose);
        compose.k = compose.k + 1;
        transition { _ -> ov_pl(compose) }
    }
    // violations: bypass => kind 1 + indices{path}; disconnected => kind 2
    machine vio(compose: &mut Compose) {
        compose.w8 = 2;
        Compose::emit_u8(compose);
        transition compose.pol_kind[compose.h0] == 1 && compose.h0 < 8 {
            true -> bp(compose)
            _ -> disc(compose)
        }
    }
    machine bp(compose: &mut Compose) {
        compose.w8 = 1;
        Compose::emit_u8(compose);
        compose.w32 = narrow_u64_to_u32_wrapping(compose.pol_wit_n[compose.h0] as u64);
        Compose::emit_u32(compose);
        compose.k = 0;
        transition { _ -> bp_l(compose) }
    }
    machine bp_l(compose: &mut Compose) {
        transition compose.h0 < 8 && compose.k < compose.pol_wit_n[compose.h0] && compose.k < 8 && compose.ok {
            true -> bp_p(compose)
            _ -> done()
        }
    }
    machine bp_p(compose: &mut Compose) {
        compose.h1 = compose.h0 * 8 + compose.k;
        transition compose.h1 < 64 {
            true -> bp_w(compose)
            _ -> bad(compose)
        }
    }
    machine bp_w(compose: &mut Compose) {
        compose.w32 = compose.pol_wit[compose.h1] as u32;
        Compose::emit_u32(compose);
        compose.k = compose.k + 1;
        transition { _ -> bp_l(compose) }
    }
    machine disc(compose: &mut Compose) {
        compose.w8 = 2;
        Compose::emit_u8(compose);
        transition { _ -> done() }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- assumptions ⊆ accepted ----------------------------------------------
// Every instance assumption consumed from a description must be among the
// request's accepted-assumption identities.
machine Compose::check_asm(compose: &mut Compose) {
    compose.i = 0;
    transition { _ -> i_loop(compose) }
    machine i_loop(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 && compose.ok {
            true -> j_init(compose)
            _ -> done()
        }
    }
    machine j_init(compose: &mut Compose) {
        compose.j = 0;
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> j_loop(compose)
            _ -> bad(compose)
        }
    }
    machine j_loop(compose: &mut Compose) {
        transition compose.h0 < 8 && compose.j < compose.inst_asm_n[compose.h0] && compose.j < 8 && compose.ok {
            true -> m_init(compose)
            _ -> next_i(compose)
        }
    }
    machine m_init(compose: &mut Compose) {
        compose.m = 0;
        compose.found = false;
        transition { _ -> m_loop(compose) }
    }
    machine m_loop(compose: &mut Compose) {
        transition compose.m < compose.n_acp && compose.m < 32 && !compose.found {
            true -> cmp(compose)
            _ -> m_dec(compose)
        }
    }
    machine cmp(compose: &mut Compose) {
        compose.k = 0;
        compose.t64 = 1;
        transition { _ -> b_loop(compose) }
    }
    machine b_loop(compose: &mut Compose) {
        transition compose.k < 32 && compose.t64 == 1 {
            true -> b_idx(compose)
            _ -> b_dec(compose)
        }
    }
    machine b_idx(compose: &mut Compose) {
        compose.h1 = compose.i * 256 + compose.j * 32 + compose.k;
        compose.h2 = compose.m * 32 + compose.k;
        transition compose.h1 < 2048 && compose.h2 < 1024 {
            true -> b_do(compose)
            _ -> bad(compose)
        }
    }
    machine b_do(compose: &mut Compose) {
        transition compose.inst_asm[compose.h1] != compose.accepted[compose.h2] {
            true -> b_neq(compose)
            _ -> b_next(compose)
        }
    }
    machine b_neq(compose: &mut Compose) {
        compose.t64 = 0;
        transition { _ -> b_done(compose) }
    }
    machine b_next(compose: &mut Compose) {
        compose.k = compose.k + 1;
        transition { _ -> b_loop(compose) }
    }
    machine b_dec(compose: &mut Compose) {
        transition compose.k == 32 {
            true -> hit(compose)
            _ -> m_next(compose)
        }
    }
    machine b_done(compose: &mut Compose) {
        transition { _ -> m_next(compose) }
    }
    machine hit(compose: &mut Compose) {
        compose.found = true;
        transition { _ -> m_dec(compose) }
    }
    machine m_next(compose: &mut Compose) {
        compose.m = compose.m + 1;
        transition { _ -> m_loop(compose) }
    }
    machine m_dec(compose: &mut Compose) {
        transition compose.found {
            true -> next_j(compose)
            _ -> bad(compose)
        }
    }
    machine next_j(compose: &mut Compose) {
        compose.j = compose.j + 1;
        transition { _ -> j_loop(compose) }
    }
    machine next_i(compose: &mut Compose) {
        compose.i = compose.i + 1;
        transition { _ -> i_loop(compose) }
    }
    machine bad(compose: &mut Compose) {
        compose.ok = false;
        compose.errtag[0] = 99;
        compose.errtag[1] = 97;
        compose.errtag[2] = 88;
        compose.errtag[3] = 88;
        transition { _ -> done() }
    }
    machine done() {
    }
}

// ---- emit_all -------------------------------------------------------------
machine Compose::emit_all(compose: &mut Compose) {
    compose.out_len = 0;
    // PLAN_MAGIC = 0x4C505450 LE, schema 1
    compose.w32 = 1280332880;
    Compose::emit_u32(compose);
    compose.w32 = 1;
    Compose::emit_u32(compose);
    compose.src = 0;
    compose.h0 = 0;
    Compose::emit_ident(compose);
    compose.w32 = narrow_u64_to_u32_wrapping(compose.n_inst as u64);
    Compose::emit_u32(compose);
    compose.i = 0;
    transition { _ -> insts(compose) }
    machine insts(compose: &mut Compose) {
        transition compose.i < compose.n_inst && compose.i < 8 && compose.ok {
            true -> one(compose)
            _ -> binds(compose)
        }
    }
    machine one(compose: &mut Compose) {
        compose.cp = compose.i;
        Compose::emit_inst(compose);
        compose.i = compose.i + 1;
        transition { _ -> insts(compose) }
    }
    machine binds(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.n_bind as u64);
        Compose::emit_u32(compose);
        compose.i = 0;
        transition { _ -> binds_l(compose) }
    }
    machine binds_l(compose: &mut Compose) {
        transition compose.i < compose.n_bind && compose.i < 16 && compose.ok {
            true -> bone(compose)
            _ -> pols(compose)
        }
    }
    machine bone(compose: &mut Compose) {
        compose.cp = compose.i;
        Compose::emit_bind(compose);
        compose.i = compose.i + 1;
        transition { _ -> binds_l(compose) }
    }
    machine pols(compose: &mut Compose) {
        compose.w32 = narrow_u64_to_u32_wrapping(compose.n_pol as u64);
        Compose::emit_u32(compose);
        compose.i = 0;
        transition { _ -> pols_l(compose) }
    }
    machine pols_l(compose: &mut Compose) {
        transition compose.i < compose.n_pol && compose.i < 8 && compose.ok {
            true -> pone(compose)
            _ -> done()
        }
    }
    machine pone(compose: &mut Compose) {
        compose.cp = compose.i;
        Compose::emit_pol(compose);
        compose.i = compose.i + 1;
        transition { _ -> pols_l(compose) }
    }
    machine done() {
    }
}

// ---- publish --------------------------------------------------------------
// Requires every policy outcome satisfied before serializing — mirrors the
// reference compose_plan, which emits no artifact on violation.
machine Compose::publish(compose: &mut Compose, source: &BuildSource, output: &mut BuildOutput, log: &mut BuildLog, descriptor: i32) {
    compose.ok = true;
    compose.rq = 0;
    compose.mq = 0;
    compose.dq = 0;
    compose.bq = 0;
    compose.errtag[0] = 63;
    compose.errtag[1] = 63;
    compose.errtag[2] = 63;
    compose.errtag[3] = 63;
    let req_path: BuildPath = source.resolve("inputs/request.bin");
    let req_fd: i32 = source.open(req_path, 0);
    transition req_fd >= 0 {
        true -> read_req(compose, req_fd, source, output, log, descriptor)
        _ -> failed(compose, output)
    }

    machine read_req(compose: &mut Compose, req_fd: i32, source: &BuildSource, output: &mut BuildOutput, log: &mut BuildLog, descriptor: i32) {
        let count: i64 = source.read(req_fd, &mut compose.req, 8192);
        let closed: i32 = source.close(req_fd);
        transition count > 0 && count < 8192 {
            true -> store_req(compose, count, source, output, log, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine store_req(compose: &mut Compose, count: i64, source: &BuildSource, output: &mut BuildOutput, log: &mut BuildLog, descriptor: i32) {
        compose.req_n = narrow_i64_to_u64_wrapping(count) as u64 in Wrapping;
        let meta_path: BuildPath = source.resolve("inputs/components.bin");
        let meta_fd: i32 = source.open(meta_path, 0);
        transition meta_fd >= 0 {
            true -> read_meta(compose, meta_fd, source, output, log, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine read_meta(compose: &mut Compose, meta_fd: i32, source: &BuildSource, output: &mut BuildOutput, log: &mut BuildLog, descriptor: i32) {
        let count: i64 = source.read(meta_fd, &mut compose.meta, 8192);
        let closed: i32 = source.close(meta_fd);
        transition count > 0 && count < 8192 {
            true -> store_meta(compose, count, source, output, log, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine store_meta(compose: &mut Compose, count: i64, source: &BuildSource, output: &mut BuildOutput, log: &mut BuildLog, descriptor: i32) {
        compose.meta_n = narrow_i64_to_u64_wrapping(count) as u64 in Wrapping;
        let bind_path: BuildPath = source.resolve("inputs/bindings.bin");
        let bind_fd: i32 = source.open(bind_path, 0);
        transition bind_fd >= 0 {
            true -> read_bind(compose, bind_fd, source, output, log, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine read_bind(compose: &mut Compose, bind_fd: i32, source: &BuildSource, output: &mut BuildOutput, log: &mut BuildLog, descriptor: i32) {
        let count: i64 = source.read(bind_fd, &mut compose.bind, 8192);
        let closed: i32 = source.close(bind_fd);
        transition count > 0 && count < 8192 {
            true -> store_bind(compose, count, log, output, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine store_bind(compose: &mut Compose, count: i64, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.bind_n = narrow_i64_to_u64_wrapping(count) as u64 in Wrapping;
        // request_commitment = sha256(request bytes)
        compose.dig.msg_n = compose.req_n;
        compose.i = 0;
        transition { _ -> stage_req(compose, log, output, descriptor) }
    }
    machine stage_req(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        transition compose.i < compose.req_n && compose.i < 8192 {
            true -> prep_sr(compose, log, output, descriptor)
            _ -> hash_req(compose, log, output, descriptor)
        }
    }
    machine prep_sr(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.h0 = compose.i;
        transition compose.h0 < 8192 {
            true -> do_sr(compose, log, output, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine do_sr(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.dig.msg[compose.h0] = compose.req[compose.h0];
        compose.i = compose.i + 1;
        transition { _ -> stage_req(compose, log, output, descriptor) }
    }
    machine hash_req(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        digest::Sha256::digest(&mut compose.dig);
        compose.i = 0;
        transition { _ -> cp_commit(compose, log, output, descriptor) }
    }
    machine cp_commit(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        transition compose.i < 32 {
            true -> prep_cc(compose, log, output, descriptor)
            _ -> decoded(compose, log, output, descriptor)
        }
    }
    machine prep_cc(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.h0 = compose.i;
        transition compose.h0 < 32 {
            true -> do_cc(compose, log, output, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine do_cc(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.commit[compose.h0] = compose.dig.out32[compose.h0];
        compose.i = compose.i + 1;
        transition { _ -> cp_commit(compose, log, output, descriptor) }
    }
    machine decoded(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        Compose::decode_req(compose);
        transition compose.ok {
            true -> ph_meta(compose, log, output, descriptor)
            _ -> fail_req(compose, output)
        }
    }
    machine ph_meta(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("req-ok");
        Compose::decode_meta(compose);
        transition compose.ok {
            true -> ph_bind(compose, log, output, descriptor)
            _ -> fail_meta(compose, log, output)
        }
    }
    machine ph_bind(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("meta-ok");
        Compose::decode_bind(compose);
        transition compose.ok {
            true -> ph_asm(compose, log, output, descriptor)
            _ -> fail_bind(compose, log, output)
        }
    }
    machine ph_asm(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("bind-ok");
        Compose::check_asm(compose);
        transition compose.ok {
            true -> ph_eval(compose, log, output, descriptor)
            _ -> fail_asm(compose, log, output)
        }
    }
    machine ph_eval(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("asm-ok");
        Compose::eval_all(compose);
        transition compose.ok {
            true -> ph_sat(compose, log, output, descriptor)
            _ -> fail_eval(compose, log, output)
        }
    }
    machine ph_sat(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("eval-ok");
        transition { _ -> all_sat(compose, log, output, descriptor) }
    }
    machine fail_req(compose: &mut Compose, output: &mut BuildOutput) {
        compose.ok = false;
        transition { _ -> failed(compose, output) }
    }
    machine fail_meta(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput) {
        compose.ok = false;
        log.write_line(compose.errtag[0..4]);
        transition { _ -> failed(compose, output) }
    }
    machine fail_bind(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput) {
        compose.ok = false;
        log.write_line(compose.errtag[0..4]);
        transition { _ -> failed(compose, output) }
    }
    machine fail_asm(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput) {
        compose.ok = false;
        log.write_line(compose.errtag[0..4]);
        transition { _ -> failed(compose, output) }
    }
    machine fail_eval(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput) {
        compose.ok = false;
        log.write_line(compose.errtag[0..4]);
        transition { _ -> failed(compose, output) }
    }
    // composition fails (emits nothing) unless every policy is satisfied
    machine all_sat(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.i = 0;
        transition { _ -> sat_loop(compose, log, output, descriptor) }
    }
    machine sat_loop(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        transition compose.i < compose.n_pol && compose.i < 8 {
            true -> sat_chk(compose, log, output, descriptor)
            _ -> emit(compose, log, output, descriptor)
        }
    }
    machine sat_chk(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.h0 = compose.i;
        transition compose.h0 < 8 {
            true -> sat_do(compose, log, output, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine sat_do(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("sat-check");
        transition compose.pol_out[compose.h0] == 1 {
            true -> sat_next(compose, log, output, descriptor)
            _ -> unsat(compose, log, output, descriptor)
        }
    }
    machine unsat(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        log.write_line("unsat");
        transition { _ -> failed(compose, output) }
    }
    machine sat_next(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        compose.i = compose.i + 1;
        transition { _ -> sat_loop(compose, log, output, descriptor) }
    }
    machine emit(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        Compose::emit_all(compose);
        log.write_line("emitted");
        transition compose.ok && compose.out_len > 0 && compose.out_len <= 16384 {
            true -> flush(compose, log, output, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine flush(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        transition compose.out_len <= 16384 {
            true -> flush2(compose, log, output, descriptor)
            _ -> failed(compose, output)
        }
    }
    machine flush2(compose: &mut Compose, log: &mut BuildLog, output: &mut BuildOutput, descriptor: i32) {
        let written: i64 = output.write(descriptor, compose.out[0..compose.out_len]);
        log.write_line("composed");
    }
    machine failed(compose: &mut Compose, output: &mut BuildOutput) {
        compose.ok = false;
    }
}
