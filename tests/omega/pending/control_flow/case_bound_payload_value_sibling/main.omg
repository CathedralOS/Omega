// PENDING — pins a lowering-side residual-custody wall, not a check omission.
//
//   let m: Msg = ...;
//   transition m {
//       Msg::A { cmd } -> hop(cmd)
//       Msg::B      -> (Answer { n: 0 })   // expression arm
//   }
//
// The check side now mints the source state's cleanup plan: the `(expr)` arm
// is a non-transfer edge and the scrutinee local is retained to its exit
// drop. Lowering still has no channel for the residual on the arm's return
// edge: a local subject dies at `Unit return has an unaccounted local drop`
// (composed_control/state_graph/edges.rs), and a parameter subject reaches
// the verifier as `StructuralReturnAffineDiscardsMismatch` because the
// closed-sum consumption in `return_discards` assumes an edge-side subject
// disposal that `(expr)` arm edges never mint (`trivial_affine_discards`
// stays empty on the edge into the arm's private return block).
//
// Sibling of `pass/control_flow/case_bound_payload_state_argument` (owned
// parameter subject, all-named arms — admitted). Distinct from it: this
// dispatch mixes a named successor with a value successor. Promote to
// `pass/` when the Value-arm return edge accounts the dispatch subject's
// residual — expected path: the arm edge carries the subject disposal like
// the named case edges do, or `return_discards` emits it on the return.

use omega_language_std::console;
use omega::language::core::binding;

data Cmd {
    tag: u64 [0..=255];
}

data Msg {
    case A(cmd: Cmd);
    case B;
}

data Answer {
    n: u64 [0..=255];
}

machine Answer::zero() -> Answer {
    (Answer { n: 0 })
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let a: Answer = self.dispatch(7);
    self.console.exit_process(a.n as i32);
}

machine Main::dispatch(&mut self, tag: u64 [0..=255]) -> Answer {
    let m: Msg = Msg::A { cmd: Cmd { tag: tag } };
    transition m {
        Msg::A { cmd } -> hop(cmd)
        Msg::B -> (Answer::zero())
    }

    state hop(&mut self, cmd: Cmd) -> Answer {
        (Answer { n: cmd.tag })
    }
}
