// PENDING: a payload bound by a case arm cannot leave the arm as a state
// argument when the dispatched scrutinee is an owned PARAMETER.
//
//   machine M::dispatch(&mut self, m: Msg) {        // m: owned param
//       transition m {
//           Msg::A { cmd } -> hop(cmd)              // OMITTED
//           Msg::B      -> done()
//       }
//   }
//
//   let m: Msg = ...;  transition m { ... }         // m: local  -- CHECKS
//   (the identical body passes with a `let`-bound scrutinee)
//
// The omission leaf is `state graph: terminator: conditional successors:
// edge cleanup: no state plan` (state 0) -- the whole SOURCE state's
// cleanup plan is withheld, so every ordinary edge of the state reports the
// same guard.
//
// Mechanism (execution/terminal_cleanup.rs): `build_state_plan` calls
// `state_exit_result_locals` + `checked_whole_affine_discard_parameters`.
// Extracting `cmd` out of the dispatched `m` leaves a scrutinee residual
// whose StateExit drop neither classifier can attribute: for a param the
// residual is entry-claimed (excluded from `expected_discard_parameters`)
// yet still arrives as a StateExit AffineDrop, so the two rosters mismatch
// and the plan returns None; for a `let` scrutinee the same residual is
// first routed through `state_exit_result_locals`, which requires an
// Established{Statement{LocalData}} provenance -- a value established at a
// Transition statement fails that shape, or a sibling `(expr)` arm
// (TransitionTargetNode::Value) in the trailing-statement scan returns None.
// A sibling `(expr)` arm additionally has NO edge cleanup row at all:
// `build_state_plan` only mints rows for `Named` targets, so a param-scrutinee
// variant with no payload argument passes check and then dies in lowering at
// `StructuralReturnAffineDiscardsMismatch` -- the Value arm's return edge
// never learns the dispatch subject's discards.
//
// Distinct from ../composite_state_parameter: that wall is argument
// PROVENANCE (literal/field/call args omit at `parameter transfer`) for
// composite state arguments; this wall is case-bound PAYLOAD egress -- the
// argument's provenance is the arm's destructure of an owned scrutinee, and
// the failure is the source state's cleanup plan, not the argument's
// transfer.
//
// Promote to `pass/control_flow/` with an exit -- the `hop` state reports
// the tag so the promoted fixture exits with it.

use omega_language_std::console;
use omega::language::core::binding;

data Cmd {
    tag: u64 [0..=255];
}

data Msg {
    case A(cmd: Cmd);
    case B;
}

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    let m: Msg = Msg::A { cmd: Cmd { tag: 7 } };
    self.dispatch(m);
}

machine Main::dispatch(&mut self, m: Msg) reaches Console {
    transition m {
        Msg::A { cmd } -> hop(cmd)
        Msg::B -> done()
    }

    state hop(&mut self, cmd: Cmd) {
        self.console.exit_process(cmd.tag as i32);
    }

    state done(&mut self) {
        self.console.exit_process(0);
    }
}
