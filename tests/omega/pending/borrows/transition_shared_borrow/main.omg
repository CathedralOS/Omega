// PENDING pin — shared `&` transition-tail return. The
// `(EstablishReference, Transition)` + Shared arm landed this leg: --check
// passes (dead-code warning on the `_ =` discard). Run-tier wall:
// InvalidReferenceCustody 'reference result changes its mapped source
// type' in terminal-verifier references.rs — source_type/leaf_referent
// family. Triple-claimed: arch-self-mixed-cases CASE-FIELD-TYPE-STORE-
// SHAPES (exp 14:20Z), sibling SHARED-NAMED-REFERENCE-CATALOG,
// claude-ambient STRUCTURAL-CALL-OPERATION.
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
}

machine Main::first(&self) -> &u8 {
    transition {
        _ -> &self.buf[0]
    }
}

machine Main::main(&mut self) reaches Console {
    self.buf[0] = 7;
    _ = self.first();
    transition self.buf[0] == 7 { true -> done() _ -> bad() }

    state done(&mut self) {
        self.console.exit_process(0);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
