// PENDING pin — `borrowed.tag` member read through a recast `as &Desc`
// shared loan over byte storage. --check passes; the run tier now omits at
// 'record read carrier path changed its declared type': the member read
// resolves the captured place (`self.buf[0]`) and the canonical
// `[Field(buf), FixedIndex(0)]` prefix, but that path ends on the `u8`
// element — the scalar-read vocabulary has no segment that reinterprets
// byte-array storage as a record referee. The repair is a byte-carrier
// record-overlay arm (canonical reinterpret segment or block-carrier
// establishment), not a declaration-minting problem — adjacent to the
// BLOCK-WINDOW machinery.
use omega_language_std::console;
use omega::language::core::binding;

data Desc {
    tag: u32;
}

data Main {
    console: Binding<Console>;
    buf: [u8; 48];
}

machine Main::main(&mut self) reaches Console {
    let borrowed: &Desc = &self.buf[0] as &Desc;
    transition borrowed.tag == self.buf[0] as u32 { true -> done() _ -> bad() }

    state done(&mut self) {
        self.console.exit_process(0);
    }

    state bad(&mut self) {
        self.console.exit_process(1);
    }
}
