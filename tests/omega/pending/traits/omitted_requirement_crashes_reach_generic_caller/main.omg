// MUST be rejected; accepted today, and traps when run. `Step::apply` omits
// `crashes`, which on a bodyless requirement "defers to its published
// routes", the selected member's (wiki/spec/language/generics.md,
// "Requirements and conformance evidence"). `Trapping::apply` publishes
// `crashes Trap`, so `advance`, which writes `crashes none`, may crash through
// the call, and so may `advance<Trapping>(0)`. The checker treats the omitted
// clause as no route at all: `omega --check` accepts the program, and
// `omega run --both` reports native signal 4 and interpreter crash Trap
// (linux_x86_64 cloud container, at the commit that added this file).
//
// Twin: `fail/traits/crashes_none_requirement_member_crashes`, whose
// requirement writes `crashes none` and is rejected where `Trapping` satisfies
// it. Here the member is valid; what must be rejected is `advance`'s promise.
// Move to `fail/traits/` with its golden row when the checker rejects it.
// Expected: reject `advance`'s uncovered Trap route through `Selected::apply`
trait Step {
    machine apply(value: u32) -> u32;
}
Trapping satisfies Step {
    machine apply(value: u32) -> u32
    crashes Trap
    {
        transition value == 0 { true -> bad() false -> value }
        machine bad() -> u32 crashes Trap { crash Trap; }
    }
}
machine advance<Selected satisfies Step>(start: u32) -> u32
crashes none
{
    Selected::apply(start)
}
machine main() reaches none {
    let value: u32 = advance<Trapping>(0);
}
