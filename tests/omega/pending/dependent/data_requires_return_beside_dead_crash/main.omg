// MUST be rejected; accepted today. `corrupt` breaks `count <= len` with
// `target.count = 99`, then both arms of a complete dispatch return with the
// window still open. The trailing `crash Trap;` can never run, but any crash
// statement in a state turns off the end-of-state "return" window check
// (`domains_and_predicates.rs` `walk_state`, `has_explicit_crash`).
//
// Rule broken (wiki/spec/language/dependent_values.md, "Invariant
// windows"): the domain "must be proved again at the next consumption point",
// and "return" is one; "A crash may abandon an open window" covers only the
// crash outcome, not the returns beside it.
//
// Accepting run: omega-mac (Jarods-Mac-mini.local), compiler built at
// c118c914794 with `CARGO_PROFILE_DEV_OPT_LEVEL=1 mbx build -p omega`;
// `./target/debug/omega --check main.omg < /dev/null` exits 0 with no
// diagnostic. Not run natively.
//
// Twin: the same program without `crash Trap;` and `crashes Trap` is rejected
// on the same host and commit: "cannot complete return from machine `corrupt`
// state `entry`: this write left the `requires` facts of `target` (data
// `Tally`) unproved; restore them first". `expected.txt` holds that
// diagnostic.
//
// Move to `fail/dependent/` with its golden row when the checker rejects it.
data Tally
requires
    count <= len,
{
    len: u32;
    count: u32;
}
machine corrupt(target: &mut Tally, ready: bool) crashes Trap {
    target.count = 99;
    transition ready { true -> {} false -> {} }
    crash Trap;
}
machine main() {}
