data RewardItem {
    case None;
    case Gold;
}

data Main {
    out: RewardItem;
}

machine Main::main(&mut self) {
    let flag: bool = true;
    self.out = self.pick(flag);
}

machine Main::pick(&mut self, flag: bool) -> RewardItem {
    transition flag {
        true -> RewardItem::Gold
        false -> RewardItem::None
    }
    
}
