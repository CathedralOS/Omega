domain [u8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Main {
    console: Console;
    input: &[u8] in Utf8;
}

machine Main::main(&mut self) {
    self.input = "look";

    transition self.input {
        "quit" -> finished()
        "look" -> look()
        _ -> invalid()
    }

    state finished(&mut self) {
        self.console.exit_process(10);
    }

    state look(&mut self) {
        self.console.exit_process(11);
    }

    state invalid(&mut self) {
        self.console.exit_process(12);
    }
}
