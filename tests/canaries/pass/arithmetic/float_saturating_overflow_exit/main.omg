use omega::language::core::float_operations;

// RUN CANARY (exit 70), both native backends + interpreter.
// F5 (float brief §8): `Saturating` clamps MAGNITUDE OVERFLOW to
// +-MAX_FINITE and nothing else. Legs: 1e160 * 1e160 overflows f64 and
// clamps to MAX_FINITE (the backend all-integer guard: sign-cleared bits
// vs the Inf pattern classifies finite/Inf/NaN in one compare); a second
// square is IDEMPOTENT (MAX*MAX overflows -> MAX again); 5.0 / 0.0 keeps
// its +Inf (division by zero does NOT clamp -- 0/0 has no defensible
// clamp; wellness stays a Finite obligation).
// Nested f64/f32 products pin policy propagation in operand position.
// exits: 71 = overflow not clamped; 72 = re-clamp wrong; 73 = div-by-zero
// wrongly clamped; 74 = negative clamp wrong; 75/76 = nested f64/f32 wrong.
use omega::language::std::console;
data Main {
    console: Console;
    a: f64 in Saturating;
    n: f64 in Saturating;
    z: f64 in Saturating;
    r: f64 in Saturating;
    f: f32 in Saturating;
    fr: f32 in Saturating;
}
machine Main::main(&mut self) {
    self.a = 1.0e160;
    self.r = self.a * self.a; // 1e320 -> clamp to MAX_FINITE
    transition self.r == 1.7976931348623157e308 { true -> negative() _ -> bad() }
    state negative(&mut self) {
        self.n = 0.0 - self.a;
        self.r = self.n * self.a;
        transition self.r == -1.7976931348623157e308 { true -> nested() _ -> bad4() }
    }
    state nested(&mut self) {
        // If the inner multiplication loses its policy, Inf reaches the outer
        // add and remains Inf because a non-finite operand legalizes it.
        self.r = (self.a * self.a) + 1.0;
        transition self.r == 1.7976931348623157e308 { true -> nested32() _ -> bad5() }
    }
    state nested32(&mut self) {
        self.f = 1.0e20;
        self.fr = (self.f * self.f) + 1.0;
        transition self.fr == 3.4028235e38 { true -> reclamp() _ -> bad6() }
    }
    state reclamp(&mut self) {
        self.r = self.r * self.r; // MAX*MAX -> overflow -> MAX again
        transition self.r == 1.7976931348623157e308 { true -> div0() _ -> bad2() }
    }
    state div0(&mut self) {
        self.r = self.a / self.z; // finite/0.0 = +Inf, NOT clamped
        transition self.r > 1.7976931348623157e308 { true -> good() _ -> bad3() }
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self)  { self.console.exit_process(71); }
    state bad2(&mut self) { self.console.exit_process(72); }
    state bad3(&mut self) { self.console.exit_process(73); }
    state bad4(&mut self) { self.console.exit_process(74); }
    state bad5(&mut self) { self.console.exit_process(75); }
    state bad6(&mut self) { self.console.exit_process(76); }
}
