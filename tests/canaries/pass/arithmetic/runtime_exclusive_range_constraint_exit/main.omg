// RUN canary (exit 70). The `a..b` (exclusive) and `a..=b` (inclusive) range
// refinement syntaxes (replacing the removed `range<a, b>`): `x` is bounded to
// [0, 15] (exclusive `0..16`) and `y` to [0, 100] (inclusive `0..=100`), so the
// prover keeps `x + y` (worst case [0, 115]) EXACT with no overflow domain.
use omega::language::std::console;
data Main { console: Console; x: i32 [0..16]; y: i32 [0..=100]; }
machine Main::main(&mut self) {
    self.x = 5;
    self.y = 60;
    let z: i32 = self.x + self.y;
    transition z == 65 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
