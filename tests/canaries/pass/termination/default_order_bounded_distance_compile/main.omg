// A two-subject tuple has no canonical default. This canary selects
// Nat::BoundedDistance explicitly; the subjects bind in order to the view's
// (lower, upper) parameters.

data Main {}

machine Main::main(&mut self) -> u64 {
    transition {
        _ -> self.walk(4, 0)
    }
}

machine Main::walk(&mut self, limit: u64, index: u64)
terminates by (index, limit);
-> u64
{
    transition index < limit {
        true -> walk(limit, index + 1)
        false -> index
    }
}
