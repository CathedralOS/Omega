// Exercises the byte-view fact `[u8]::NonEmpty`. The domain membership is
// carried as a fact across a call: `main` requires it on `self.text`, and that
// membership satisfies `consume` without a builtin String type.

domain [u8]::NonEmpty
requires
    non_empty(self);

data Main {
    text: &[u8];
}

machine Main::consume(&self, text: &[u8])
requires
    text in NonEmpty
{
}

machine Main::main(&mut self)
requires
    self.text in NonEmpty
{
    self.consume(self.text);
}
