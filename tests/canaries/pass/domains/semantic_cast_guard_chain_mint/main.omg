// A dominating guard proves the callee's requirement, and that requirement in
// turn proves the domain predicate at the qualification site.
domain i64::Km
requires
    self >= 0;
machine qualify(raw: i64) -> i64
requires
    raw >= 0
{
    transition { _ -> (raw as i64 in Km) }
}
machine mint_guarded(sensed: i64) {
    transition sensed >= 0 { true -> take(qualify(sensed)) _ -> done() }
    state take(distance: i64) {}
    state done() {}
}
