data Password {
    length: i32;
    score: i32;
}

domain Password::Valid
requires
    self.length > 0;

data Main {
    password: Password;
}

machine Main::accept(length: i32)
requires
    length > 0
{
}

machine Main::main(&mut self)
requires
    self.password in Password::Valid
{
    self.accept(self.password.length);
}
