// F7 exact two-rounding realization for named multiply-then-add plans.
// For each format, (1 + ulp)^2 has a positive residual below one result ulp.
// Rounding the product before adding its rounded cancellation produces zero;
// a fused operation would preserve a positive residual.

use omega::language::core::float_operations;
use omega::language::std::console;

data Main {
    console: Console;
    result32: f32;
    result64: f64;
    maximum32: f32 in Saturating;
    two32: f32 in Saturating;
    zero32: f32 in Saturating;
    saturated32: f32 in Saturating;
}

machine Main::main(&mut self) {
    let next32: f32 = 1.00000011920928955078125;
    let cancel32: f32 = 0.0f32 - 1.0000002384185791015625;
    // Exercise MTA below another arithmetic root as well as in the direct
    // f64/Saturating writes below.
    self.result32 = F32::multiply_then_add(next32, next32, cancel32) + 0.0f32;

    let next64: f64 = 1.0000000000000002220446049250313080847263336181640625;
    let cancel64: f64 =
        0.0 - 1.000000000000000444089209850062616169452667236328125;
    self.result64 = F64::multiply_then_add(next64, next64, cancel64);

    self.maximum32 = 340282346638528859811704183484516925440.0;
    self.two32 = 2.0;
    self.zero32 = 0.0;
    self.saturated32 =
        F32::multiply_then_add(self.maximum32, self.two32, self.zero32);

    transition self.result32 == 0.0f32 {
        true -> check64()
        _ -> fail(71)
    }

    state check64(&mut self) {
        transition self.result64 == 0.0 {
            true -> check_saturating32()
            _ -> fail(72)
        }
    }

    state check_saturating32(&mut self) {
        transition self.saturated32 == self.maximum32 {
            true -> good()
            _ -> fail(73)
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state fail(&mut self, code: u64) { self.console.exit_process(code); }
}
