use omega::language::core::float_operations;

// PROVES the arm64 float-RETURN calling convention (render fire 6). A boundary
// method returning f64, bound to libm `sqrt`: the result comes back in `d0` and
// must be moved to x0 (`fmov x0,d0`) before the result store. To verify the
// STORED bits are correct without needing float `==` in a transition guard, the
// f64 result is round-tripped back through the (already proven) `round_nearest`
// float-ARG path: sqrt(16.0) -> 4.0 stored, read back into v0, rounded to 4 ->
// exit 4. A miscompiled float return (wrong bits in d0 or a missing fmov) stores
// garbage -> round_nearest yields something else -> exit 1.

use omega::language::std::console;

boundary trait Math {
    machine round_nearest(value: f64) -> i64;
    machine square_root(value: f64) -> f64;
}

data Main {
    console: Console;
    math: Math;
    input: f64;
    root: f64;
    n: i64;
}

machine Main::main(&mut self) {
    self.input = 16.0;
    self.root = self.math.square_root(self.input);
    self.n = self.math.round_nearest(self.root);
    transition self.n == 4 { true -> good() _ -> bad() }
    state good(&mut self) { self.console.exit_process(4); }
    state bad(&mut self)  { self.console.exit_process(1); }
}
