// Widening an inline narrow integer operand must extend correctly by SIGNEDNESS:
// an unsigned u8 byte > 127 ZERO-extends, a signed i8 < 0 SIGN-extends. The
// named conversion and subsequent policy qualification in operand position
// (`sum + (widen_u8_to_u32(nums[i]) as u32 in Wrapping)`) must first
// materialize the delivered call result, then feed the enclosing arithmetic.
// It also reaches the core conversion's checked body, whose narrow (1/2-byte)
// source must be movzx/movsx-extended. Before the underlying extension fix it
// was left un-extended (upper bits garbage), silently miscompiling any byte
// above 127. Before Cast(Call(..)) normalization, the enclosing addition
// consumed the call scratch result incorrectly and exited 71.
//
//  unsigned: [200,201,202,203] read as u32 sum to 806 (zero-extend);
//  signed:   i8 -5 read as i32 is -5 (sign-extend).
// Both correct -> exit 70.

use omega::language::std::console;
use omega::language::core::numeric_conversion;

data Main {
    console: Console;
    nums: [u8; 4];
    i: i32 in Trapping;
    v: u8 in Wrapping;
    sum: u32 in Wrapping;
    n8: i8 in Trapping;
    isum: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.i = 0;
    self.sum = 0;

    transition {
        _ -> fill()
    }

    state fill(&mut self) {
        transition self.i < 4 {
            true -> store()
            _ -> rewind()
        }
    }

    state store(&mut self) {
        let narrowed: u8 = narrow_i32_to_u8_wrapping(self.i as i32);
        self.v = (narrowed as u8 in Wrapping) + 200;
        self.nums[self.i] = self.v as u8;
        self.i = self.i + 1;
        transition {
            _ -> fill()
        }
    }

    state rewind(&mut self) {
        self.i = 0;
        transition {
            _ -> sum_loop()
        }
    }

    // Unsigned widen: each high byte must ZERO-extend.
    state sum_loop(&mut self) {
        transition self.i < 4 {
            true -> add()
            _ -> signed_part()
        }
    }

    state add(&mut self) {
        self.sum =
            self.sum
            + (widen_u8_to_u32(self.nums[self.i]) as u32 in Wrapping);
        self.i = self.i + 1;
        transition {
            _ -> sum_loop()
        }
    }

    // Signed widen: a negative i8 must SIGN-extend.
    state signed_part(&mut self) {
        self.n8 = 0 - 5;
        self.isum = 0;
        let widened: i32 = widen_i8_to_i32(self.n8 as i8);
        self.isum =
            self.isum + (widened as i32 in Trapping);
        transition self.sum == 806 {
            true -> check_signed()
            _ -> bad()
        }
    }

    state check_signed(&mut self) {
        transition self.isum == 0 - 5 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
