data Entry {
    value: u32;
}

data Main {
    entries: [Entry; 4];
}

machine Main::main(&mut self) -> i32 {
    transition {
        _ -> work()
    }

    state work(&mut self) {
        let entry_slice: &mut [Entry] = self.entries.as_mut_slice();
        entry_slice[0].value = 1;
        0
    }
}
