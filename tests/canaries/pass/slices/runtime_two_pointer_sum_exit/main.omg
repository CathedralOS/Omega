// TWO-POINTER traversal: `i` rises from 0, `j` falls from len-1, converging under
// the guard `i < j`. The decreasing pointer `j` proves `nums[j]` via its loop
// invariant (j < len). The increasing pointer `i` has NO direct upper bound -- it
// is bounded only RELATIVE to `j` by the guard `i < j`. Proving `nums[i]` chains
// the ordering with the bound: `i <= j` (from the `i < j` guard) and `j < len`
// give `i <= j < len`, so `i < len`. Both pointers are unsigned (`u64`), so the
// `0 <= i` / `0 <= j` halves are free by type.
//
//   nums = [10,20,30,40,50,60]; pairs (0,5)(1,4)(2,3) each sum 70; acc = 210.
//   Exits 70.

use omega::language::std::console;

data Main {
    console: Console;
    nums: [i32; 6] in Trapping;
    i: u64 in Wrapping;
    j: u64 in Wrapping;
    acc: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.nums[0] = 10;
    self.nums[1] = 20;
    self.nums[2] = 30;
    self.nums[3] = 40;
    self.nums[4] = 50;
    self.nums[5] = 60;
    self.i = 0;
    self.j = 5;
    self.acc = 0;

    transition {
        _ -> loop_()
    }

    state loop_(&mut self) {
        transition self.i < self.j {
            true -> body()
            _ -> done()
        }
    }

    state body(&mut self) {
        self.acc = self.acc + self.nums[self.i];   // proves via  i <= j < len
        self.acc = self.acc + self.nums[self.j];   // proves via  j < len (invariant)
        self.i = self.i + 1;
        self.j = self.j - 1;
        transition {
            _ -> loop_()
        }
    }

    state done(&mut self) {
        transition self.acc == 210 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
