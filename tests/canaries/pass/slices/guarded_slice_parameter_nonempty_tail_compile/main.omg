data Entry {
    value: i32;
}

data Main {
}

machine Main::main(&mut self) -> u64 {
    transition {
        _ -> 0
    }

    state choose(&mut self, entries: &[Entry]) -> u64 {
        transition entries.len > 0 {
            true -> length(entries[1..])
            false -> 0
        }
    }

    state length(&mut self, entries: &[Entry]) -> u64 {
        transition {
            _ -> entries.len
        }
    }
}
