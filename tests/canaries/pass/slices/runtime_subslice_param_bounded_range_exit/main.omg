// Bounded subslice of a runtime slice PARAMETER (`sub[1..4]` where `sub: &[Entry]`).
// Both bounds are literals but the BASE is a runtime fat descriptor, not a fixed
// array: the lowering must offset the source descriptor's pointer and write the
// literal length (the canonical FatDescriptorAbi::subslice shape), never resolve
// a static fixed-array place. Passing `sub[1..4]` of a 5-element view must yield
// a 3-element slice.

use platform::console;

data Entry { value: i32; }

data Main {
    console: Console;
    entries: [Entry; 5];
}

machine Main::main(&mut self) {
    let view: &[Entry] = self.entries.as_slice();
    transition {
        _ -> self.check(view)
    }
}

machine Main::check(&mut self, sub: &[Entry]) {
    transition sub.len > 3 {
        true -> self.verify(sub[1..4])
        false -> bad()
    }
    state bad(&mut self) { self.console.exit_process(71); }
}

machine Main::verify(&mut self, sub: &[Entry]) {
    transition sub.len == 3 {
        true -> good()
        false -> wrong()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state wrong(&mut self) { self.console.exit_process(72); }
}
