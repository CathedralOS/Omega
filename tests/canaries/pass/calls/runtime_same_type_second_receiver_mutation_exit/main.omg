// RUN CANARY (exit 70) -- the ORIGINAL same-type contained-receiver
// aliasing repro, PROMOTED from the fail fence 2026-07-10r when
// per-instance receiver dispatch landed: `self.b.increment()` used to
// mutate `self.a` (by-TYPE storage resolution picked the first Counter;
// memory: contained-machine-same-type-aliasing). The dispatch clone now
// runs on the RECEIVER's storage (BackendPlan::receiver_bases), so a x1 +
// b x1 leaves b.value == 1. Statement-position method calls dispatch, so
// this covers the common std-authoring shape; the INLINE value-call route
// stays fenced (pending/time/value_machine_receiver_field_postentry).
use omega::language::std::console;
data Counter { value: i32 in Wrapping; }
machine Counter::increment(&mut self) {
    self.value = self.value + 1;
    transition { _ -> done() }
    state done(&mut self) { }
}
data Main { console: Console; a: Counter; b: Counter; }
machine Main::main(&mut self) {
    self.a.increment();
    self.b.increment();
    transition self.b.value == 1 { true -> good() _ -> bad(71) }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self, code: i32) { self.console.exit_process(code); }
}
