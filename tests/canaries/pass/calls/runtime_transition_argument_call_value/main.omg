domain [u8]::Utf8
requires
    valid_utf8(self);
data NavigationChoice { case Invalid; case Move; }
data CellId { case Empty; }
data Navigation { choice: NavigationChoice; destination: CellId; }
data ConsoleLine { text: &[u8] in Utf8; }

data Main {
}

machine Main::main(&mut self, line: &ConsoleLine) -> Navigation {
    let choice: NavigationChoice = self.resolve_command(line);
    transition {
        choice == NavigationChoice::Invalid -> self.resolve_exit(line)
        _ -> self.navigation(choice, CellId::Empty)
    }
}

machine Main::resolve_command(&mut self, line: &ConsoleLine) -> NavigationChoice {
    transition {
        line.text == "quit" -> NavigationChoice::Invalid
        _ -> NavigationChoice::Move
    }
}

machine Main::resolve_exit(&mut self, line: &ConsoleLine) -> Navigation {
    self.navigation(NavigationChoice::Move, CellId::Empty)
}

machine Main::navigation(&mut self, choice: NavigationChoice, destination: CellId) -> Navigation {
    Navigation { choice: choice, destination: destination }
    
}