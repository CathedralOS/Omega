// Chapter 2: mutable-borrow examples use compound assignment
// (`self.health += amount;`), which lowers to an ordinary assignment with an
// additive read of the same place.
data Player {
    health: i32 in Wrapping;
}

machine Player::heal(&mut self, amount: i32 in Wrapping) {
    self.health += amount;
}

data Main {}

machine Main::main(&mut self) {}
