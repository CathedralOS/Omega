// The uefi_x64 target declaration (frontier registration; the compiler's
// name table pins x86_64 + PE32+): freestanding, so no host boundary
// packages -- services arrive via the entry's parameters.
target uefi_x64 {
}

machine build(builder: &mut Build) {
    builder.application("efi-two-provides-rows");
    builder.subsystem = Subsystem::EfiApplication;
    builder.freestanding = true;
}
