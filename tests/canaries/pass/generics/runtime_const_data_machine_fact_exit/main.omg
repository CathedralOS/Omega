// A direct effect-free `machine(self)` integer-domain fact is evaluated
// at build time for the concrete const-generic instance.
use omega::language::std::console;

machine is_positive(value: u64) -> bool {
    value > 0
}

machine is_at_most_eight(value: u64) -> bool {
    value <= 8
}

domain u64::AtMostEight
requires
    is_at_most_eight(self);
domain u64::BufferSize
requires
    is_positive(self);
    self in AtMostEight;
    !(self == 3)

data FixedBuffer<const N: u64>
where
    N in BufferSize,
{
    values: [u8; N];
}

data Main {
    console: Console;
    buffer: FixedBuffer<4>;
}

machine Main::main(&mut self) {
    self.buffer.values[0] = 66;
    self.console.exit_process(self.buffer.values[0] as i32 + 4);
}
