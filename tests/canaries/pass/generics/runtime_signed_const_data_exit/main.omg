// Signed const expressions retain their negative value through instance
// naming, domain-membership discharge, attached-machine specialization, and
// both runtimes.
use omega::language::std::console;

domain i8::Negative
requires
    self < 0;
data SignedValue<const N: i8>
where
    N in Negative,
{
    marker: i8;
}

machine SignedValue::value<const N: i8>(&self) -> i8 in Wrapping {
    N
}

data Main {
    console: Console;
    signed: SignedValue<-2 ^ 7>;
    shifted_left: SignedValue<-2 << 2>;
    shifted_right: SignedValue<-2 >> 1>;
}

machine Main::main(&mut self) {
    let value: i8 in Wrapping = self.signed.value();
    self.console.exit_process((value as i32) + 77);
}
