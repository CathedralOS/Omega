// FRAME-resident 2D arrays, both-runtime reads and binary writes
// (CopyRuntimeFrameBaseDoubleIndexedToRuntimeStorage and the canonical
// all-frame double-indexed CopyPlaces target/pair + WritePlaceConvert +
// WritePlaceInteger + WritePlaceBinary + WritePlaceAddress):
// local arrays in entry
// and PARAM states via LET consumers, the MACHINE-FIELD target face
// (`self.got = g2[a][b]` -- the tree route, which needs the aggregate slot
// kept for assignment-value consumers AND the selection-layer alias guard:
// an aggregate-literal alias must not substitute into an indexed collection
// position, the third fold layer), and a by-value param array through a
// value machine. An all-frame nested record array also writes a string
// descriptor through both runtime indices. Whole-Triple values also cross a
// frame-held pointee, direct storage in both directions, and pair copies across
// distinct local 2D arrays, with both all-frame and mixed machine/frame
// indices. All value-validated.
domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;
data Room { description: &[u8] in Utf8; }
data Label { text: [u8; 8] in Utf8; }
data Triple { first: i32; second: i32; third: i32; }
data Main { console: Console; got: i32; index: u64 [0..=1]; }
machine Main::pick(&self, m: [[i32; 3]; 2], i: u64 [0..=1], j: u64 [0..=2]) -> i32 {
    transition { _ -> (m[i][j]) }
}
machine Main::main(&mut self) {
    self.index = 0;
    transition { _ -> let_face(1, 2, 0, 1, 70) }
    state let_face(
        &mut self,
        i: u64 [0..=1],
        j: u64 [0..=2],
        source_i: u64 [0..=1],
        source_j: u64 [0..=2],
        wide: i64
    ) {
        let g: [[i32 in Wrapping; 3]; 2] = [[1, 2, 3], [4, 5, 6]];
        self.got = 5;
        g[i][j] = self.got;
        g[i][j] = wide as i32 in Wrapping;
        g[i][j] = 6;
        g[i][j] = g[i][j] + 1;
        let selected: &mut i32 in Wrapping = &mut g[i][j];
        selected = 8;
        let picked: i32 in Wrapping = g[i][j];
        let rooms: [[Room; 3]; 2] = [
            [Room { description: "a" }, Room { description: "b" }, Room { description: "c" }],
            [Room { description: "d" }, Room { description: "e" }, Room { description: "old" }]
        ];
        let suffix_room: Room;
        suffix_room.description = "meg";
        rooms[i][j].description = "o" + suffix_room.description + "a";
        let labels: [[Label; 3]; 2] = [
            [Label { text: "a" }, Label { text: "b" }, Label { text: "c" }],
            [Label { text: "d" }, Label { text: "e" }, Label { text: "old" }]
        ];
        let suffix: Label;
        suffix.text = "ga";
        labels[i][j].text = "o";
        labels[i][j].text = labels[i][j].text + "me";
        labels[i][j].text = labels[i][j].text + suffix.text;
        let triples: [[Triple; 3]; 2] = [
            [Triple { first: 1, second: 2, third: 3 }, Triple { first: 4, second: 5, third: 6 }, Triple { first: 7, second: 8, third: 9 }],
            [Triple { first: 11, second: 12, third: 13 }, Triple { first: 14, second: 15, third: 16 }, Triple { first: 17, second: 18, third: 19 }]
        ];
        let replacement: Triple = Triple { first: 10, second: 20, third: 30 };
        triples[i][j] = replacement;
        let replaced: Triple = triples[i][j];
        triples[i][j] = triples[source_i][source_j];
        let copied: Triple = triples[i][j];
        let source_triples: [[Triple; 3]; 2] = [
            [Triple { first: 1, second: 2, third: 3 }, Triple { first: 40, second: 50, third: 60 }, Triple { first: 7, second: 8, third: 9 }],
            [Triple { first: 11, second: 12, third: 13 }, Triple { first: 14, second: 15, third: 16 }, Triple { first: 17, second: 18, third: 19 }]
        ];
        let target_triples: [[Triple; 3]; 2] = [
            [Triple { first: 21, second: 22, third: 23 }, Triple { first: 24, second: 25, third: 26 }, Triple { first: 27, second: 28, third: 29 }],
            [Triple { first: 31, second: 32, third: 33 }, Triple { first: 34, second: 35, third: 36 }, Triple { first: 37, second: 38, third: 39 }]
        ];
        let through: &mut Triple = &mut target_triples[i][j];
        through = source_triples[source_i][source_j];
        let reverse: &mut Triple = &mut source_triples[i][j];
        reverse = Triple { first: 70, second: 80, third: 90 };
        target_triples[source_i][source_j] = reverse;
        let mixed_through: &mut Triple = &mut target_triples[i][j];
        mixed_through = source_triples[self.index][source_j];
        let mixed_reverse: &mut Triple = &mut source_triples[i][j];
        mixed_reverse = Triple { first: 100, second: 110, third: 120 };
        target_triples[self.index][source_j] = mixed_reverse;
        let mixed_direct: Triple = source_triples[self.index][source_j];
        target_triples[self.index][j] = mixed_direct;
        target_triples[self.index][j] = source_triples[source_i][self.index];
        transition picked == 8 && rooms[1][2].description == "omega" && labels[1][2].text == "omega" && replaced.first == 10 && replaced.second == 20 && replaced.third == 30 && copied.first == 4 && copied.second == 5 && copied.third == 6 && target_triples[1][2].first == 40 && target_triples[1][2].second == 50 && target_triples[1][2].third == 60 && target_triples[0][1].first == 100 && target_triples[0][1].second == 110 && target_triples[0][1].third == 120 && mixed_direct.first == 40 && mixed_direct.second == 50 && mixed_direct.third == 60 && target_triples[0][2].first == 1 && target_triples[0][2].second == 2 && target_triples[0][2].third == 3 {
            true -> machine_target()
            false -> no()
        }
    }
    state machine_target(&mut self) {
        transition { _ -> machine_target_go(0, 1) }
    }
    state machine_target_go(&mut self, a: u64 [0..=1], b: u64 [0..=2]) {
        let g2: [[i32; 3]; 2] = [[9, 8, 7], [6, 5, 4]];
        self.got = g2[a][b];
        transition self.got == 8 {
            true -> param_face()
            false -> no()
        }
    }
    state param_face(&mut self) {
        let m: [[i32; 3]; 2] = [[10, 20, 30], [40, 50, 60]];
        let pv: i32 = self.pick(m, 1, 0);
        transition pv == 40 {
            true -> yes()
            false -> no()
        }
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
