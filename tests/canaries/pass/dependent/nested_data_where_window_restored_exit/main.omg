// RUN CANARY (exit 70). Windows are tracked at the dependent-record root, not
// only on a machine's direct fields: self.map's two writes restore Map before
// the boundary call consumes Main.
use omega::language::std::console;
data Map
where
    start <= end,
{
    start: i32;
    end: i32;
}
data Main { console: Console; map: Map; }
machine Main::main(&mut self) {
    self.map.start = 10;
    self.map.end = 20;
    self.console.exit_process(70);
}
