use omega::language::core::float_operations;

// Compact Mandelbrot renderer (40x18) -- a per-pixel f64 escape-time renderer over
// a 1D carrier framebuffer, exercising floats, nested loops, runtime-indexed carrier
// byte writes, and write_line together. Self-checks by counting in-set (non-escaped)
// pixels against a known value, so the EXIT CODE verifies the render; the differential
// oracle additionally checks native==interpreter stdout. All correct -> exit 70.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: [u8] in Utf8);
}

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 40]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
data Main {
    console: Console;
    row: [u8; 40] in Utf8;
    palette: [u8; 8] in Utf8;
    x: i32 in Trapping;
    y: i32 in Trapping;
    cr: f64;
    ci: f64;
    zr: f64;
    zi: f64;
    zr2: f64;
    zi2: f64;
    mag: f64;
    k: i32 in Trapping;
    idx: i32 in Trapping;
    ch: u8 in Wrapping;
    inset: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.palette = " .:-=+*#";
    self.row = "........................................";
    self.y = 0;
    self.inset = 0;
    transition { _ -> row_loop() }

    state row_loop(&mut self) {
        transition self.y < 18 { true -> col_init() _ -> check() }
    }
    state col_init(&mut self) { self.x = 0; transition { _ -> col_loop() } }
    state col_loop(&mut self) {
        transition self.x >= 0 && self.x < 40 { true -> pixel_init() _ -> emit_row() }
    }
    state pixel_init(&mut self) {
        self.cr = (self.x as f64 / 40.0) * 3.5 - 2.5;
        self.ci = (self.y as f64 / 18.0) * 2.6 - 1.3;
        self.zr = 0.0;
        self.zi = 0.0;
        self.k = 0;
        transition { _ -> iter_loop() }
    }
    state iter_loop(&mut self) {
        transition self.k < 24 { true -> iter_test() _ -> pixel_done() }
    }
    state iter_test(&mut self) {
        self.zr2 = self.zr * self.zr;
        self.zi2 = self.zi * self.zi;
        self.mag = self.zr2 + self.zi2;
        transition self.mag > 4.0 { true -> pixel_done() _ -> iter_step() }
    }
    state iter_step(&mut self) {
        self.zi = 2.0 * self.zr * self.zi + self.ci;
        self.zr = self.zr2 - self.zi2 + self.cr;
        self.k = self.k + 1;
        transition { _ -> iter_loop() }
    }
    state pixel_done(&mut self) {
        self.idx = self.k * 7 / 24;
        transition self.k >= 24 { true -> mark_inset() _ -> store() }
    }
    state mark_inset(&mut self) {
        self.inset = self.inset + 1;
        transition { _ -> store() }
    }
    state store(&mut self) {
        transition self.idx >= 0 && self.idx < 8 && self.x >= 0 && self.x < 40 {
            true -> write_pixel()
            _ -> bad()
        }
    }
    state write_pixel(&mut self) {
        self.ch = self.palette[self.idx] as u8 in Wrapping;
        self.row[self.x] = self.ch as u8;
        self.x = self.x + 1;
        transition { _ -> col_loop() }
    }
    state emit_row(&mut self) {
        self.console.write_line(self.row);
        self.y = self.y + 1;
        transition { _ -> row_loop() }
    }
    state check(&mut self) {
        // 140 in-set pixels for this exact 40x18 grid / region / 24-iteration cap.
        // Deterministic (IEEE-754 f64), so native and interpreter agree.
        transition self.inset == 140 { true -> ok() _ -> bad() }
    }
    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
