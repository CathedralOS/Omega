// Companion to the UTF-8 boundary canary for the second byte-shape domain,
// established directly on the ordinary byte-view carrier.

domain [u8]::NoNul
requires
    no_nul(self);

boundary operator Text::validate_no_nul(text: &mut [u8]) -> ()
ensures
    text in NoNul;

data Main {
    text: &mut [u8];
}

machine Main::consume(&self, text: &[u8])
requires
    text in NoNul
{
}

machine Main::main(&mut self) {
    Text::validate_no_nul(self.text);
    self.consume(self.text);
}
