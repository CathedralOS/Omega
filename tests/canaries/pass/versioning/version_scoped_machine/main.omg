// Machines attach normally to separately declared historical and current era
// shapes. There is no version segment in the machine path.

data CounterV1 {
    counter: i32 in Wrapping;
}

data Counter {
    count: i32 in Wrapping;
    timestamp: i32 in Wrapping;
}

data Main {
}

machine CounterV1::increment(&mut self) {
    self.counter = self.counter + 1;
}

machine Counter::increment(&mut self) {
    self.count = self.count + 1;
}

machine Main::main(&mut self) {
}
