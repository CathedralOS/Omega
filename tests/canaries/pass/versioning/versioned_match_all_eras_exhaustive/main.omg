// Ordinary sum exhaustiveness covers every named era and the storage-only
// Invalid case. Adding an era breaks this match until it gains a route.

data CounterV1 { counter: i32; }
data CounterV2 { counter: i32; }
data Counter { count: i32; }

data CounterHistory {
    case Invalid;
    case V1(v1: CounterV1);
    case V2(v2: CounterV2);
    case Current(current: Counter);
}

data Main { raw: CounterHistory; }

machine Main::main(&mut self) {
    transition self.raw {
        CounterHistory::Invalid -> done()
        CounterHistory::V1 { v1 as _ } -> done()
        CounterHistory::V2 { v2 as _ } -> done()
        CounterHistory::Current { current as _ } -> done()
    }
    state done(&mut self) { }
}
