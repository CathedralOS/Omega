// MP6: the build-time interpreter consumes the same static machine-symbol
// specialization as ordinary code. The selected helper computes image
// metadata; it is not a runtime callable or a compiler-side config grammar.
target windows_x64 {
}

machine chosen_subsystem(value: u16) -> u16 {
    value
}

machine apply<T, machine F>(value: T) -> T
where machine F(value: T) -> T;
{
    F(value)
}

machine build(builder: &mut Build) {
    builder.application("static-machine-parameter-config-compile");
    let selected: u16 = apply<chosen_subsystem>(70);
    builder.subsystem = Subsystem::Unspecified { value: selected };
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
}
