// PROMOTED from tests/canaries/run/filesystem/wrapper_metadata_repro (2026-07-08:
// confirmed PASS on real macOS/aarch64 -- "PASS: metadata_path Ok with
// meta.len == 5"). Originally the REPRO for TASKS_FS.md blocker #2
// (metadata_path payload), FIXED in shared instruction selection (2026-07-06,
// from the Windows thread). The `meta.len == 0` symptom decomposed into TWO
// selection bugs, both visible in this
// canary's cross-compiled backend_report and both reproduced+fixed natively on
// windows_x64 with pure-language twins:
//  (2B) the decode arm's straight-line statements (`let len = ...` byte
//       assembly) were emitted ABOVE the entry's `stat` host call, so the
//       terminal copied a pre-stat ZII stat_buf — right tag, zero payload.
//       Fixed: runtime_dispatch.rs defers the straight-line expansions together
//       with the leaf. Twin: tests/canaries/run/value_call_entry_host_state_payload.
//  (2A) the one CAST-valued field (`mode: mode as u32`) had no write at all —
//       the leaf-path scalar cascade (branches/mutation.rs) lacked a convert
//       arm. Twin: tests/canaries/pass/calls/runtime_value_call_struct_payload_cast_
//       field_exit.
// The err arm's `kind: last_error()` nested value-call (blocker #3) is covered
// by the run twin's "no" leg and rides the same 2B fix.

use omega::language::std::filesystem;
use omega::language::std::filesystem_host;

data Main {
    fs: Filesystem;
    raw: FilesystemHost;
    mode: i32;
    fd: i32;
    n: i64;
    res: MetadataResult;
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.fd = self.raw.create("/tmp/omega_wrapper_metadata.txt", self.mode);
    self.n = self.raw.write(self.fd, "hello");
    self.n = self.raw.close(self.fd);

    self.res = self.fs.metadata_path("/tmp/omega_wrapper_metadata.txt");
    transition self.res {
        MetadataResult::Ok { meta } -> got(meta)
        MetadataResult::Error { kind } -> fail_err()
    }
    state got(&mut self, meta: Metadata) {
        transition meta.len == 5 { true -> good() _ -> fail_len() }
    }
    state good(&mut self)     { self.n = self.raw.write(1, "PASS: metadata_path Ok with meta.len == 5\n"); }
    state fail_err(&mut self) { self.n = self.raw.write(1, "FAIL: metadata_path not Ok\n"); }
    state fail_len(&mut self) { self.n = self.raw.write(1, "FAIL: metadata_path len != 5 (payload not delivered)\n"); }
}
