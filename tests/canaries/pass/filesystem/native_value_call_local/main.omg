// NATIVE value-call with a `let`-bound host call (step 14 layers 2+3). A
// VALUE-CALL to a same-data-type sub-machine forwards a slice LITERAL ("hello")
// and the callee writes it through a LOCAL-bound host call (`let w =
// self.fs.write(fd, bytes)`) — the ergonomic-wrapper shape. Before layers 2+3 a
// `let x = self.host.op(..)` was a `StatementNode::LocalData` that the host-call
// COLLECTION pass ignored (only Assignment + Call), so the call was never
// collected and got dropped in selection (file created, never written). Now
// `collect_local_result_host_lowering` collects it (synthesizing the local's
// place as arg[0]) and the runtime_dispatch LocalStorage branch emits it. Round-
// trips through the value-call and asserts the file holds the 5 bytes.
//
// NOTE: this is a SAME-data-type callee (Main::putv). The shipped ergonomic
// `Filesystem` wrapper is reached through a FIELD (self.fs.write_all, a different
// data type) whose inlined locals are not yet allocated frame slots under the
// caller's dispatch — the remaining through-field wrinkle (TASKS_FS.md step 14 /
// tests/canaries/run/filesystem/wrapper_write_all_through_field).

use omega::language::std::filesystem_host;

data Main {
    fs: FilesystemHost;
    mode: i32;
    fd: i32;
    n: i64;
    size: i64;
}

machine Main::main(&mut self) {
    self.mode = 420;
    self.fd = self.fs.create("/tmp/omega_vc_local.txt", self.mode);
    transition self.fd >= 0 { true -> drive() _ -> fail() }
    state drive(&mut self) {
        self.n = self.putv(self.fd, "hello");
        self.size = self.fs.seek(self.fd, 0, 2);
        self.n = self.fs.close(self.fd);
        self.n = self.fs.remove("/tmp/omega_vc_local.txt");
        transition self.size == 5 { true -> good() _ -> fail() }
    }
    state good(&mut self) { self.n = self.fs.write(1, "PASS: let-bound value-call host call wrote 5 bytes\n"); }
    state fail(&mut self) { self.n = self.fs.write(1, "FAIL: let-bound value-call host call\n"); }
}

machine Main::putv(&mut self, fd: i32, bytes: &[u8]) -> i64 {
    let w: i64 = self.fs.write(fd, bytes);
    transition w >= 0 { true -> done(w) _ -> done(w) }
    state done(&mut self, w: i64) -> i64 { w }
}
