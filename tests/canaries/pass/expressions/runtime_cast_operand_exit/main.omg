use omega::language::core::float_operations;

// A numeric `as` cast used as a binary OPERAND (`self.a + (self.b as f64)`), not as
// the whole assignment RHS. Casts assigned directly to a place already lowered via
// WriteRuntimeStorageConvert; in operand position the cast was dropped (the resolver
// tried to treat `(expr as T)` as a storage place and failed). A `RuntimeValueOperand
// ::Convert` variant now carries the cast: the encoder loads the source operand and
// converts it in place (cvtsi2sd / cvttsd2si / movsxd) before the binary op. Covers
// int->float, float->int, and integer widening; each result is guarded against the
// exact value so a dropped or wrong conversion exits non-70.

use omega::language::std::console;

data Main {
    console: Console;
    a: f64;
    b: i32 in Wrapping;
    x: i64 in Wrapping;
    rf: f64;
    ri: i32 in Trapping;
    rl: i64;
}

machine Main::main(&mut self) {
    self.a = 10.0;
    self.b = 4;
    self.x = 10;

    // int -> float operand
    self.rf = self.a + (self.b as f64); // 14.0
    transition self.rf == 14.0 {
        true -> check_float_to_int()
        false -> bad()
    }
    state check_float_to_int(&mut self) {
        // float -> int operand
        // F4: a float cast has no Wrapping reading -- convert Saturating,
        // then re-tag the INTEGER to Wrapping to meet `b`'s domain.
        self.ri = self.b + ((self.a as i32 in Saturating) as i32 in Wrapping); // 4 + 10 = 14
        transition self.ri == 14 {
            true -> check_int_widen()
            false -> bad()
        }
    }
    state check_int_widen(&mut self) {
        // integer widening operand
        self.rl = self.x + (self.b as i64 in Wrapping); // 10 + 4 = 14
        transition self.rl == 14 {
            true -> good()
            false -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
