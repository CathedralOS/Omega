// A recursively fixed array remains one compiler-sized element when its outer
// array is placed through one `At` per element. The eight-byte physical stride
// is distinct from each row's four-byte semantic width; the inner u16 stride
// remains compiler-derived inside each destination extent.
use omega::language::std::console;
use omega::language::core::layout;

data TiledNestedArray { entries: [FieldEntry; 64]; }

machine TiledNestedArray::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 12 },
    };
    self.entries[1] = FieldEntry {
        key: schema.fields[0].key,
        placement: FieldPlan::At { offset: 4 },
    };
    Plan {
        entries: self.entries,
        entry_count: 2,
        size_fixed: 20,
        size_is_dynamic: false,
        align: 2,
    }
}

data Samples { rows: [[u16; 2]; 2]; }
data TiledNestedArrayView { value: TiledNestedArray<Samples>; }

machine make_samples() -> Samples {
    Samples {
        rows: [[0x0201, 0x0403], [0x0605, 0x0807]],
    }
}

data Main {
    console: Console;
    bytes: [u8; 20];
    row: u64;
    column: u64;
    observed: u16;
}

machine Main::main(&mut self) {
    let view: &mut TiledNestedArrayView =
        &mut self.bytes[0] as &mut TiledNestedArrayView;
    self.row = 0;
    self.column = 0;
    view.value.rows[self.row][self.column] = 0x0201;
    self.column = 1;
    view.value.rows[self.row][self.column] = 0x0403;
    self.row = 1;
    self.column = 0;
    view.value.rows[self.row][self.column] = 0x0605;
    self.column = 1;
    view.value.rows[self.row][self.column] = 0x0807;
    self.observed = view.value.rows[self.row][self.column];
    transition self.bytes[4] == 1 && self.bytes[5] == 2
        && self.bytes[6] == 3 && self.bytes[7] == 4
        && self.bytes[8] == 0 && self.bytes[9] == 0
        && self.bytes[10] == 0 && self.bytes[11] == 0
        && self.bytes[12] == 5 && self.bytes[13] == 6
        && self.bytes[14] == 7 && self.bytes[15] == 8
        && self.bytes[16] == 0 && self.bytes[17] == 0
        && self.bytes[18] == 0 && self.bytes[19] == 0
        && self.observed == 0x0807 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
