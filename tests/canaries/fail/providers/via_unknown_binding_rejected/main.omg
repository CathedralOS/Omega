// The external-leaf supply is the closed, compiler-known Binding sum. A case
// outside that vocabulary is a guided error: each mechanism needs validated
// lowering and cannot be invented by a package.
boundary trait Mixed {
    machine via_syscall() reaches Mixed;
}

demo_target machine syscall_leaf() satisfies Mixed::via_syscall via Binding::Frobnicate(1);

data Main {}
machine Main::main(&mut self) {}
