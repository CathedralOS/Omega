// PRV4: an accepted axiom (bodyless BOUNDARY machine) carries no
// realization -- `via` on it refuses; its meaning is its ensures.
boundary trait Process {
    machine exit(code: i32);
}

boundary machine exit_axiom(code: i32) satisfies Process::exit via Binding::Syscall(60);

data Main { }
machine Main::main(&mut self) {
}
