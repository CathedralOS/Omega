// The self-forwarding admission is EXACT: the one extra leading parameter
// must be the requirement's OWN trait. A leading parameter of any other
// type keeps the strict positional match and refuses on parameter count --
// no silent forwarding of a non-capability lead. This fixture owns a minimal
// requirement so the standard Console adapter cannot mask the signature error
// with a duplicate-adapter diagnostic.
boundary trait TestConsole {
    machine write_line(text: &[u8])
    reaches
        TestConsole;
}

data Main {
    console: TestConsole;
}

data TestConsoleProvider {}

machine TestConsoleProvider::write_line_bad(code: i32, text: &[u8]) satisfies TestConsole::write_line
reaches
    TestConsole
{
    let x: i32 = code;
}

machine Main::main(&mut self) {
    self.console.write_line("Hi");
}
