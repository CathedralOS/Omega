library TestHost = "TestHost.dylib" calling_convention c {
    entry host_write(fd: i32, count: u64) -> i32
        symbol "_host_write"
        boundary omega_test_host_write
}

library "AnonymousHost.dylib" calling_convention c {
    entry host_tick() -> i32
        boundary host
}

data Main {}

machine Main::main(&mut self) {}
