// MR2 negative twin: the terminal tail call passes `n` UNCHANGED, so no
// measure decreases across the rewritten loop-back edge -- the machine
// would spin forever. The fall-through complement supplies positivity,
// never the decrease itself; `terminates by n` stays unproven and refuses.
// (Deleting the base-case exit refuses identically: nothing to refute.)
use omega::language::std::console;
data Main { console: Console; }
machine Main::countdown(&mut self, n: u64 [0..=100]) -> u64
terminates by n;
{
    transition n == 0 { true -> 7 }
    self.countdown(n)
}
machine Main::main(&mut self) {
    let s: u64 = self.countdown(4);
    transition s == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(70); }
    state no(&mut self)  { self.console.exit_process(71); }
}
