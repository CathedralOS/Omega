// UNMEASURED call-spelled self-recursion is REJECTED (measured-recursion
// ruling 2026-07-18, MR1): a recursive CALL spelling (`true ->
// self.countdown(remaining - 1)`) is legal ONLY on a measured machine
// (`terminates by ...;`, the decrease proven across the loop
// edge). This machine declares no measure, so the arm refuses and names
// both fixes: measure the machine, or spell unmeasured repetition as the
// bare loop `-> countdown(..)` (constant stack, may legally diverge).
// The measured twin RUNS: pass/calls/runtime_measured_tail_recursion_exit.
use omega::language::std::console;
data Main {
    console: Console;
}
machine Main::countdown(&mut self, remaining: u64) -> u64
{
    transition remaining > 0 {
        true -> self.countdown(remaining - 1)
        false -> 7
    }
}
machine Main::main(&mut self) {
    let value: u64 = self.countdown(2);
    transition value == 7 {
        true -> yes()
        false -> no()
    }
    state yes(&mut self) { self.console.exit_process(1); }
    state no(&mut self) { self.console.exit_process(2); }
}
