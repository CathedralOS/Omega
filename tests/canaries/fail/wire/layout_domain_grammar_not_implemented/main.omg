// LAYOUTS L5: the grammar parameter of OmegaLayout is not spellable yet --
// `Derived` is the default and the only implemented grammar; an explicit
// `Packed` names the honest gap.
use omega::language::std::console;

data CounterMessage {
    #0 counter: u32;
}

data Main {
    console: Console;
    view: &[u8] in OmegaLayout<CounterMessage, Packed>;
}

machine Main::main(&mut self) {
    self.console.exit_process(0);
}
