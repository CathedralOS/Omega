// FAIL CANARY. The zeroed health field does not satisfy health >= 1, so the
// attached data cannot be consumed before a write establishes the gate.
use omega::language::std::console;
data Main
where
    health >= 1,
{
    console: Console;
    health: i32;
}
machine Main::main(&mut self) {
    self.console.exit_process(self.health);
}
