// Step-false twin of proofs/proof_inductive_gauss_sum (ladder rung L7). The
// base case holds (n == 0 makes n*(n+3) vanish), but the inductive step does
// not: the instantiated hypothesis for (n - 1, acc + n) misses the goal by a
// constant, so the recursive arm's obligation is unprovable. Since every
// fact lies inside the engine's language and the decrease IS discharged
// (the hypothesis was available, just insufficient), the engine rejects
// rather than standing down. Pins the per-arm "cannot prove" diagnostic.
// Wrapping keeps it in the positive theorem's universal residue-ring domain.

data Main {
}

machine Main::main(&mut self) {
    let total: u64 in Wrapping = self.gauss_sum(4, 0);
}

machine Main::gauss_sum(&mut self, n: u64 in Wrapping, acc: u64 in Wrapping) -> u64 in Wrapping
terminates by n;
ensures
    result * 2 == acc * 2 + n * (n + 3)
{
    transition n > 0 {
        true -> gauss_sum(n - 1, acc + n)
        false -> acc
    }
}
