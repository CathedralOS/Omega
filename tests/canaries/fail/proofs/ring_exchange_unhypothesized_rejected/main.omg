// HYPOTHESIS-EXCHANGE negative twin: the quotient-congruence goal WITHOUT
// its requires hypothesis. The addend multisets differ (a.pos/a2.neg vs
// a2.pos/a.neg) and no equation licenses the exchange, so the ring tier
// stands down and the structural fence fires. (The hypothesized version
// proves in core int.omg's add_int_respects_eq.)
use omega::language::core::nat;
use omega::language::std::console;
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }

data IntPair2 {
    neg: Nat;
    pos: Nat;
}

machine add_int2(a: IntPair2, b: IntPair2) -> IntPair2 {
    transition { _ -> (IntPair2 { neg: add(a.neg, b.neg), pos: add(a.pos, b.pos) }) }
}

machine congruence_without_hypothesis(a: IntPair2, a2: IntPair2, b: IntPair2) -> IntPair2
ensures
    (add(add(a.pos, b.pos), add(a2.neg, b.neg))) == (add(add(a2.pos, b.pos), add(a.neg, b.neg)))
{
    transition { _ -> (add_int2(a, b)) }
}
