use omega::language::core::extent;

machine launch(
    image: Extent,
    initial_storage: Extent in Granted
) {
    transition {
        _ -> retain(image, initial_storage as Extent)
    }

    state retain(image: Extent, initial_storage: Extent) {
        transition {
            _ -> retain(image, initial_storage)
        }
    }
}
