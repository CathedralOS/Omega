// FAIL CANARY -- build.omg calls a custom boundary trait that is not one of
// the pinned FilesystemHost/Console staging services. Canonical service
// identity prevents a wrapper from laundering itself through a lowercase
// compatibility category.
data Subsystem { case Console; case Gui; case EfiApplication; case Unspecified(value: u16); }
data Build { subsystem: Subsystem; freestanding: bool; }

boundary trait BuildLog { machine write_line(text: &[u8]); }

data Logger {
    log: BuildLog;
}

machine Logger::build(&mut self, builder: &mut Build)
reaches
    Console
{
    self.log.write_line("configuring");
    builder.freestanding = false;
}
