// Machine conformances always bind one exact requirement. A bare trait name is
// retired rather than inferring a requirement from this machine's own name.
use omega::language::std::console;
data Peano { case Zero; case Succ(pred: Peano); }
trait RingOps {
    machine add(a: Self, b: Self) -> Self;
}
machine wrongname(a: Peano, b: Peano) -> Peano
satisfies RingOps
terminates by a;
{
    transition a {
        Peano::Zero -> (b)
        Peano::Succ { pred } -> Peano::Succ { pred: wrongname(pred, b) }
    }
}
data Main { console: Console; }
machine Main::main(&mut self) { self.console.exit_process(70); }
