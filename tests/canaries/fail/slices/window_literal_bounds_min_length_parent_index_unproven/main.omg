// Indexing past the derived exact window length: `items[1..3]` carries the
// exact length 2 regardless of the base's symbolic length, so `window[2]` is
// out of range.

data Main {
}

machine Main::main(&mut self, items: &[i32]) -> i32
requires
    4 <= items.len
{
    let window: &[i32] = items[1..3];
    window[2]
}
