// FAIL CANARY. Frozen decision 17, stage S2: mixed arithmetic domains are
// rejected. `a` is `Wrapping` and `b` is `Saturating`, so `self.a + self.b` mixes
// two different explicit domains -- illegal without an explicit `as` cast.

use omega::language::std::console;

data Main {
    console: Console;
    a: u8 in Wrapping;
    b: u8 in Saturating;
}

machine Main::main(&mut self) {
    self.a = 200;
    self.b = 100;
    let c: u8 in Wrapping = self.a + self.b;   // Wrapping + Saturating -> rejected
    transition c == 44 {
        true -> good()
        _ -> bad()
    }
    state good(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
