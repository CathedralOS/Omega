// FAIL canary (const-v0): initializers are LITERAL-ONLY -- scalars, negated
// scalars (folded by the parser), and struct/array literals of those. An
// arithmetic expression waits for the build-time-evaluation arc.
use omega::language::std::console;

data Limits { ceiling: i32; }

const Limits::CEILING: i32 = 60 + 10;

data Main { console: Console; }
machine Main::main(&mut self) {
    self.console.exit_process(0);
}
