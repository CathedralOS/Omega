// The runtime-index guarded increment's COLLECTION-stability twin: any write
// into the collection between the guard and the increment may alias the
// guarded element (index-blind), so the fact drops and the store rejects.
use omega::language::std::console;
data Main {
    console: Console;
    tallies: [i32 [0..=16]; 4];
    k: u64 [0..=3];
}
machine Main::main(&mut self) {
    self.k = 2;
    transition self.tallies[self.k] < 16 {
        true -> bump()
        false -> full()
    }
    state bump(&mut self) {
        self.tallies[0] = 5;
        self.tallies[self.k] = self.tallies[self.k] + 1;
        transition self.tallies[2] == 1 {
            true -> matched()
            false -> unmatched()
        }
    }
    state matched(&mut self) { self.console.exit_process(1); }
    state unmatched(&mut self) { self.console.exit_process(9); }
    state full(&mut self) { self.console.exit_process(8); }
}
