domain [u8]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
}

data Command {
    case Look;
    case Quit;
    case Invalid;
}

data Navigation {
    choice: Command;
    destination: i32;
}

data Parser {
}

machine Parser::resolve_navigation(&mut self) -> Navigation {
    let choice: Command = self.resolve_command();
    self.navigation(choice, 0)
}

machine Parser::resolve_command(&mut self) -> Command {
    Command::Invalid
}

machine Parser::navigation(&mut self, choice: Command, destination: i32) -> Navigation {
    Navigation { choice: choice, destination: destination }
    
}

data Main {
    console: Console;
    parser: Parser;
    navigation: Navigation;
    health: i32;
}

machine Main::main(&mut self) {
    self.health = 10;

    transition self.health == 0 {
        true -> dead()
        false -> prompt()
    }
    

    state prompt(&mut self) {
        self.navigation = self.parser.resolve_navigation();

        transition self.navigation.choice {
            Command::Look -> look()
            Command::Quit -> quit()
            Command::Invalid -> invalid()
        }
    }

    state dead(&mut self) {
        self.console.write_line("dead");
    }

    state look(&mut self) {
        self.console.write_line("look");
    }

    state quit(&mut self) {
        self.console.write_line("quit");
    }

    state invalid(&mut self) {
        self.console.write_line("invalid");
    }
}