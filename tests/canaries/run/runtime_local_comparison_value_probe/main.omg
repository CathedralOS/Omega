domain [u8]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Main {
    console: Console;
    number: i32;
    flag: bool;
    text: &[u8] in Utf8;
}

machine Main::main(&mut self) {
    self.number = 2;
    self.flag = false;
    self.text = "deep room";

    let number_ok: bool = self.number == 2;
    let flag_ok: bool = self.flag == false;
    let text_ok: bool = self.text == "deep room";

    transition number_ok {
        (true) -> check_flag(flag_ok, text_ok)
        _ -> bad_number()
    }

    state check_flag(&mut self, flag_ok: bool, text_ok: bool) {
        transition flag_ok {
            (true) -> check_text(text_ok)
            _ -> bad_flag()
        }
    }

    state check_text(&mut self, text_ok: bool) {
        transition text_ok {
            (true) -> good()
            _ -> bad_text()
        }
    }

    state good(&mut self) {
        self.console.exit_process(197);
    }

    state bad_number(&mut self) {
        self.console.exit_process(191);
    }

    state bad_flag(&mut self) {
        self.console.exit_process(192);
    }

    state bad_text(&mut self) {
        self.console.exit_process(193);
    }
}