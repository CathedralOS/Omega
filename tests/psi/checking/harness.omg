// Gate-owned black-box checking harness. The gate package's build root binds
// `CheckingHarness::main` as its own product entry; the product compiler
// closure never includes it. Lexing, parsing, name resolution and typing run
// exactly as in the product; their rejections exit without an observation,
// since the earlier gates own those phases' observations.

use omega_language_std::console;
use omega::language::core::binding;
use psi::lex::lexer;
use psi::parse::parser;
use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::checking::checker;
use psi::checks::checks;
use psi::typing::typer;

pub data CheckingHarness {
    console: Binding<Console>;
}

// A little-endian `u32` read from the gate's input, or the input ending
// inside it.
data HarnessWord [copy] {
    value: u64 in Trapping;
    complete: bool;
}

// The gate's input is the source set, framed like the request's subject
// tables (wiki/spec/build/compiler_request.md): a `u32` package count, then
// per package a `u32` toolchain flag (1 for the toolchain's core package,
// else 0) and its `u32`-framed name; a `u32` dependency edge count, then per
// edge its requester's package index, a `u32` scope tag (1 product, 2
// build), its `u32`-framed alias and its target's package index; then a
// `u32` unit count and per unit its package index, `u32`-framed module path
// (`a::b`) and `u32`-framed source. Each unit is lexed and parsed into the
// shared syntax tables in order, so its position is its `SourceId`; the
// whole set then resolves, types and checks. Malformed framing exits 253,
// and a set its provisions cannot hold 252, without an observation.
pub machine CheckingHarness::main(checking_harness: &mut CheckingHarness)
reaches Console
invokes Console;
crashes Trap
blocks;
{
    let mut sources: SourceSet;
    SourceSet::clear(&mut sources);
    let mut parser: Parser;
    Parser::initialize(&mut parser);
    let count: HarnessWord = block CheckingHarness::read_u32(checking_harness);
    transition count.complete {
        true -> packages(checking_harness, &mut sources, &mut parser, count.value)
        _ -> malformed(checking_harness)
    }

    state packages(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> package_row(checking_harness, sources, parser, remaining)
            _ -> dependencies(checking_harness, sources, parser)
        }
    }

    state package_row(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let toolchain: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        let mut name: ModulePath;
        ModulePath::clear(&mut name);
        let read: bool = block CheckingHarness::read_path(checking_harness, &mut name);
        transition toolchain.complete && toolchain.value < 2 && read {
            true -> add_package(checking_harness, sources, parser, remaining, toolchain.value == 1, &name)
            _ -> malformed(checking_harness)
        }
    }

    state add_package(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        toolchain: bool,
        name: &ModulePath
    ) {
        let added: bool = SourceSet::add_package(sources, name, toolchain);
        transition added {
            true -> packages(checking_harness, sources, parser, remaining - 1)
            _ -> source_full(checking_harness)
        }
    }

    state dependencies(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser) {
        let count: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        transition count.complete {
            true -> dependency(checking_harness, sources, parser, count.value)
            _ -> malformed(checking_harness)
        }
    }

    state dependency(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> dependency_row(checking_harness, sources, parser, remaining)
            _ -> units(checking_harness, sources, parser)
        }
    }

    state dependency_row(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let requester: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        let scope: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        let mut alias: ModulePath;
        ModulePath::clear(&mut alias);
        let read: bool = block CheckingHarness::read_path(checking_harness, &mut alias);
        let target: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        transition requester.complete && scope.complete && read && target.complete
            && (scope.value == 1 || scope.value == 2)
            && requester.value < sources.package_count && target.value < sources.package_count {
            true -> dependency_scope(checking_harness, sources, parser, remaining, requester.value, scope.value == 2, &alias, target.value)
            _ -> malformed(checking_harness)
        }
    }

    state dependency_scope(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        requester: u64 in Trapping,
        build: bool,
        alias: &ModulePath,
        target: u64 in Trapping
    ) {
        transition build {
            true -> add_dependency(checking_harness, sources, parser, remaining, requester, DependencyScope::Build, alias, target)
            _ -> add_dependency(checking_harness, sources, parser, remaining, requester, DependencyScope::Product, alias, target)
        }
    }

    state add_dependency(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        requester: u64 in Trapping,
        scope: DependencyScope,
        alias: &ModulePath,
        target: u64 in Trapping
    ) {
        let added: bool = SourceSet::add_dependency(sources, requester, scope, alias, target);
        transition added {
            true -> dependency(checking_harness, sources, parser, remaining - 1)
            _ -> source_full(checking_harness)
        }
    }

    state units(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser) {
        let count: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        transition count.complete {
            true -> unit(checking_harness, sources, parser, count.value)
            _ -> malformed(checking_harness)
        }
    }

    state unit(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> unit_row(checking_harness, sources, parser, remaining)
            _ -> prepare_resolve(checking_harness, sources, parser)
        }
    }

    state unit_row(checking_harness: &mut CheckingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let unit_package: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        let mut module_path: ModulePath;
        ModulePath::clear(&mut module_path);
        let read: bool = block CheckingHarness::read_path(checking_harness, &mut module_path);
        transition unit_package.complete && read && unit_package.value < sources.package_count {
            true -> source(checking_harness, sources, parser, remaining, unit_package.value, &module_path)
            _ -> malformed(checking_harness)
        }
    }

    state source(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath
    ) {
        let length: HarnessWord = block CheckingHarness::read_u32(checking_harness);
        let mut lexer: Lexer;
        Lexer::initialize(&mut lexer, sources.unit_count as u32 in Trapping);
        transition length.complete {
            true -> source_byte(checking_harness, sources, parser, remaining, unit_package, module_path, &mut lexer, length.value)
            _ -> malformed(checking_harness)
        }
    }

    state source_byte(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping
    ) {
        transition left > 0 {
            true -> source_read(checking_harness, sources, parser, remaining, unit_package, module_path, lexer, left)
            _ -> tokenize(checking_harness, sources, parser, remaining, unit_package, module_path, lexer)
        }
    }

    state source_read(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping
    ) {
        let input: ByteRead = block checking_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> source_store(checking_harness, sources, parser, remaining, unit_package, module_path, lexer, left, value)
            _ -> malformed(checking_harness)
        }
    }

    state source_store(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping,
        value: i32
    ) {
        Lexer::append_source_byte(lexer, value as u8);
        transition lexer.source.last_retained {
            true -> source_byte(checking_harness, sources, parser, remaining, unit_package, module_path, lexer, left - 1)
            _ -> source_full(checking_harness)
        }
    }

    state tokenize(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer
    ) {
        Lexer::tokenize(lexer);
        transition lexer.output.accepted {
            true -> parse(checking_harness, sources, parser, remaining, unit_package, module_path, lexer)
            _ -> lex_rejected(checking_harness)
        }
    }

    state parse(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &Lexer
    ) {
        Parser::parse(parser, lexer.source.id, lexer.source.length as u64 in Trapping, &lexer.output);
        transition parser.output.accepted {
            true -> add(checking_harness, sources, parser, remaining, unit_package, module_path, lexer)
            _ -> parse_rejected(checking_harness)
        }
    }

    state add(
        checking_harness: &mut CheckingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &Lexer
    ) {
        let added: bool = SourceSet::add(sources, &lexer.source, unit_package, module_path);
        transition added {
            true -> unit(checking_harness, sources, parser, remaining - 1)
            _ -> source_full(checking_harness)
        }
    }

    state prepare_resolve(checking_harness: &mut CheckingHarness, sources: &SourceSet, parser: &Parser) {
        let mut resolver: Resolver;
        Resolver::initialize(&mut resolver);
        transition { _ -> resolve(checking_harness, sources, parser, &mut resolver) }
    }

    state resolve(
        checking_harness: &mut CheckingHarness,
        sources: &SourceSet,
        parser: &Parser,
        resolver: &mut Resolver
    ) {
        Resolver::resolve(resolver, sources, &parser.output);
        transition resolver.output.accepted {
            true -> prepare_type(checking_harness, sources, parser, resolver)
            _ -> resolve_rejected(checking_harness)
        }
    }

    state prepare_type(checking_harness: &mut CheckingHarness, sources: &SourceSet, parser: &Parser, resolver: &mut Resolver) {
        let mut typer: Typer;
        transition { _ -> type_check(checking_harness, sources, parser, resolver, &mut typer) }
    }

    state type_check(
        checking_harness: &mut CheckingHarness,
        sources: &SourceSet,
        parser: &Parser,
        resolver: &mut Resolver,
        typer: &mut Typer
    ) {
        Typer::type_check(typer, sources, &parser.output, &resolver.output);
        transition typer.output.accepted {
            true -> prepare_check(checking_harness, parser, resolver, typer)
            _ -> type_rejected(checking_harness)
        }
    }

    state prepare_check(checking_harness: &mut CheckingHarness, parser: &Parser, resolver: &Resolver, typer: &Typer) {
        let mut checker: Checker;
        transition { _ -> check(checking_harness, parser, resolver, typer, &mut checker) }
    }

    state check(checking_harness: &mut CheckingHarness, parser: &Parser, resolver: &Resolver, typer: &Typer, checker: &mut Checker) {
        Checker::check(checker, &parser.output, &resolver.output, &typer.output);
        CheckingHarness::write_checking_observation(checking_harness, &checker.output);
        transition checker.output.accepted {
            true -> accepted(checking_harness)
            _ -> check_rejected(checking_harness)
        }
    }

    state accepted(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(0);
    }

    state check_rejected(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(247);
    }

    state type_rejected(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(249);
    }

    state resolve_rejected(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(248);
    }

    state parse_rejected(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(250);
    }

    state lex_rejected(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(251);
    }

    state source_full(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(252);
    }

    state malformed(checking_harness: &mut CheckingHarness) {
        checking_harness.console.exit_process(253);
    }
}

machine CheckingHarness::read_u32(checking_harness: &mut CheckingHarness) -> HarnessWord
reaches Console
crashes Trap
blocks;
{
    transition { _ -> next(checking_harness, 0, 0, 1) }

    state next(checking_harness: &mut CheckingHarness, read: u64 in Trapping, value: u64 in Trapping, scale: u64 in Trapping) -> HarnessWord {
        transition read < 4 {
            true -> byte(checking_harness, read, value, scale)
            _ -> word(value)
        }
    }

    state byte(checking_harness: &mut CheckingHarness, read: u64 in Trapping, value: u64 in Trapping, scale: u64 in Trapping) -> HarnessWord {
        let input: ByteRead = block checking_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value as byte } -> next(checking_harness, read + 1, value + (byte as u64 in Trapping) * scale, scale * 256)
            _ -> ended()
        }
    }

    state word(value: u64 in Trapping) -> HarnessWord {
        HarnessWord { value: value, complete: true }
    }

    state ended() -> HarnessWord {
        HarnessWord { value: 0, complete: false }
    }
}

// A `u32`-framed name read into `path`, or false when the input ends inside
// it or it exceeds the path's provision.
machine CheckingHarness::read_path(checking_harness: &mut CheckingHarness, path: &mut ModulePath) -> bool
reaches Console
crashes Trap
blocks;
{
    let length: HarnessWord = block CheckingHarness::read_u32(checking_harness);
    transition length.complete {
        true -> byte(checking_harness, path, length.value)
        _ -> failed()
    }

    state byte(checking_harness: &mut CheckingHarness, path: &mut ModulePath, left: u64 in Trapping) -> bool {
        transition left > 0 {
            true -> read(checking_harness, path, left)
            _ -> complete()
        }
    }

    state read(checking_harness: &mut CheckingHarness, path: &mut ModulePath, left: u64 in Trapping) -> bool {
        let input: ByteRead = block checking_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> store(checking_harness, path, left, value)
            _ -> failed()
        }
    }

    state store(checking_harness: &mut CheckingHarness, path: &mut ModulePath, left: u64 in Trapping, value: i32) -> bool {
        let kept: bool = ModulePath::append(path, value as u8);
        transition kept {
            true -> byte(checking_harness, path, left - 1)
            _ -> failed()
        }
    }

    state complete() -> bool {
        true
    }

    state failed() -> bool {
        false
    }
}


// Versioned canonical checking observation. Every scalar coordinate and
// count is little-endian u64. The stream begins with `OMGCHK1\0`, version 2,
// the acceptance byte, the rejection count and each rejection's diagnostic
// tag and source span in the order checking found them, then the machine
// count and each machine's crash routes as five bytes: declares Trap,
// declares Abort, infers, derives Trap, derives Abort. Tags are declaration
// ordinals. This is hosted development tooling, not an Omega ABI.
machine CheckingHarness::write_checking_observation(checking_harness: &mut CheckingHarness, output: &Checks)
reaches Console
crashes Trap
{
    CheckingHarness::write_byte(checking_harness, 79);
    CheckingHarness::write_byte(checking_harness, 77);
    CheckingHarness::write_byte(checking_harness, 71);
    CheckingHarness::write_byte(checking_harness, 67);
    CheckingHarness::write_byte(checking_harness, 72);
    CheckingHarness::write_byte(checking_harness, 75);
    CheckingHarness::write_byte(checking_harness, 49);
    CheckingHarness::write_byte(checking_harness, 0);
    CheckingHarness::write_u64(checking_harness, 2);
    let accepted: u8 = CheckingHarness::boolean_tag(output.accepted);
    CheckingHarness::write_byte(checking_harness, accepted);
    CheckingHarness::write_u64(checking_harness, output.diagnostic_count as u64 in Trapping);
    transition { _ -> rejection(checking_harness, output, 0) }

    state rejection(checking_harness: &mut CheckingHarness, output: &Checks, index: u64 in Trapping) {
        transition index < output.diagnostic_count {
            true -> diagnostic(checking_harness, output, index)
            _ -> machines(checking_harness, output)
        }
    }

    state diagnostic(checking_harness: &mut CheckingHarness, output: &Checks, index: u64 in Trapping) {
        let rejected: CheckDiagnostic = Checks::diagnostic(output, index);
        let tag: u8 = CheckingHarness::diagnostic_tag(rejected.code);
        CheckingHarness::write_byte(checking_harness, tag);
        CheckingHarness::write_source_span(checking_harness, rejected.source_span);
        transition { _ -> rejection(checking_harness, output, index + 1) }
    }

    state machines(checking_harness: &mut CheckingHarness, output: &Checks) {
        CheckingHarness::write_u64(checking_harness, output.machine_count as u64 in Trapping);
        transition { _ -> machine(checking_harness, output, 0) }
    }

    state machine(checking_harness: &mut CheckingHarness, output: &Checks, index: u64 in Trapping) {
        transition index < output.machine_count {
            true -> routes(checking_harness, output, index)
            _ -> done()
        }
    }

    state routes(checking_harness: &mut CheckingHarness, output: &Checks, index: u64 in Trapping) {
        let routes: CrashRoutes = Checks::routes(output, index);
        let declares_trap: u8 = CheckingHarness::boolean_tag(routes.declares_trap);
        let declares_abort: u8 = CheckingHarness::boolean_tag(routes.declares_abort);
        let inferred: u8 = CheckingHarness::boolean_tag(routes.inferred);
        let trap: u8 = CheckingHarness::boolean_tag(routes.trap);
        let abort: u8 = CheckingHarness::boolean_tag(routes.abort);
        CheckingHarness::write_byte(checking_harness, declares_trap);
        CheckingHarness::write_byte(checking_harness, declares_abort);
        CheckingHarness::write_byte(checking_harness, inferred);
        CheckingHarness::write_byte(checking_harness, trap);
        CheckingHarness::write_byte(checking_harness, abort);
        transition { _ -> machine(checking_harness, output, index + 1) }
    }

    state done() {}
}

machine CheckingHarness::boolean_tag(value: bool) -> u8 {
    transition value {
        true -> tag(1)
        _ -> tag(0)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine CheckingHarness::diagnostic_tag(value: CheckDiagnosticCode) -> u8 {
    transition value {
        CheckDiagnosticCode::None -> tag(0)
        CheckDiagnosticCode::CheckCapacityExceeded -> tag(1)
        CheckDiagnosticCode::UnsupportedFact -> tag(2)
        CheckDiagnosticCode::UnsupportedCheck -> tag(3)
        CheckDiagnosticCode::IndexOutOfBounds -> tag(4)
        CheckDiagnosticCode::ArithmeticOverflow -> tag(5)
        CheckDiagnosticCode::DivisorMayBeZero -> tag(6)
        CheckDiagnosticCode::ConversionOutOfRange -> tag(7)
        CheckDiagnosticCode::ShiftCountOutOfRange -> tag(8)
        CheckDiagnosticCode::RequirementUnproven -> tag(9)
        CheckDiagnosticCode::DomainUnproven -> tag(10)
        CheckDiagnosticCode::CrashNotDeclared -> tag(11)
        CheckDiagnosticCode::GuaranteeUnproven -> tag(12)
        CheckDiagnosticCode::RankUnproven -> tag(13)
        CheckDiagnosticCode::ProgressUnproven -> tag(14)
        CheckDiagnosticCode::UseAfterMove -> tag(15)
        CheckDiagnosticCode::MoveOutOfBorrow -> tag(16)
        CheckDiagnosticCode::LinearUnconsumed -> tag(17)
        CheckDiagnosticCode::LinearOverwritten -> tag(18)
        CheckDiagnosticCode::OverlappingArguments -> tag(19)
        CheckDiagnosticCode::LoanConflict -> tag(20)
        CheckDiagnosticCode::LoanEscapes -> tag(21)
        CheckDiagnosticCode::RepresentationUnproven -> tag(22)
        CheckDiagnosticCode::WriteOnlyObservation -> tag(23)
        CheckDiagnosticCode::RankRangeUnproven -> tag(24)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine CheckingHarness::write_source_span(checking_harness: &mut CheckingHarness, source_span: SourceSpan) reaches Console {
    CheckingHarness::write_u64(checking_harness, source_span.source.value as u64 in Trapping);
    CheckingHarness::write_u64(checking_harness, source_span.span.start);
    CheckingHarness::write_u64(checking_harness, source_span.span.end);
}

machine CheckingHarness::write_u64(checking_harness: &mut CheckingHarness, value: u64 in Trapping) reaches Console {
    CheckingHarness::write_byte(checking_harness, (value % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 256 % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 65536 % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 16777216 % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 4294967296 % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 1099511627776 % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 281474976710656 % 256) as u8);
    CheckingHarness::write_byte(checking_harness, (value / 72057594037927936 % 256) as u8);
}

machine CheckingHarness::write_byte(checking_harness: &mut CheckingHarness, value: u8) reaches Console {
    let mut output: u8 = value;
    checking_harness.console.write_byte(output as i32);
}
