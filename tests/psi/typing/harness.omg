// Gate-owned black-box typing harness. The gate package's build root binds
// `TypingHarness::main` as its own product entry; the product compiler
// closure never includes it. Lexing, parsing and name resolution run exactly
// as in the product; their rejections exit without an observation, since the
// parser and resolver gates own those phases' observations.

use omega_language_std::console;
use psi::integers::integers;
use psi::lex::lexer;
use psi::parse::parser;
use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::typer;

pub data TypingHarness {
}

// A little-endian `u32` read from the gate's input, or the input ending
// inside it.
data HarnessWord [copy] {
    value: u64 in Trapping;
    complete: bool;
}

// The gate's input is the source set, framed like the request's subject
// tables (wiki/spec/build/compiler_request.md): a `u32` package count, then
// per package a `u32` toolchain flag (1 for the toolchain's core package,
// else 0) and its `u32`-framed name; a `u32` dependency edge count, then per
// edge its requester's package index, a `u32` scope tag (1 product, 2
// build), its `u32`-framed alias and its target's package index; then a
// `u32` unit count and per unit its package index, `u32`-framed module path
// (`a::b`) and `u32`-framed source. Each unit is lexed and parsed into the
// shared syntax tables in order, so its position is its `SourceId`; the
// whole set then resolves and types. Malformed framing exits 253, and a set its
// provisions cannot hold 252, without an observation.
pub machine TypingHarness::main(typing_harness: &mut TypingHarness)
reaches Console
invokes Console;
crashes Trap
blocks;
{
    let mut sources: SourceSet;
    SourceSet::clear(&mut sources);
    let mut parser: Parser;
    Parser::initialize(&mut parser);
    let count: HarnessWord = block TypingHarness::read_u32(typing_harness);
    transition count.complete {
        true -> packages(typing_harness, &mut sources, &mut parser, count.value)
        _ -> malformed(typing_harness)
    }

    state packages(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> package_row(typing_harness, sources, parser, remaining)
            _ -> dependencies(typing_harness, sources, parser)
        }
    }

    state package_row(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let toolchain: HarnessWord = block TypingHarness::read_u32(typing_harness);
        let mut name: ModulePath;
        ModulePath::clear(&mut name);
        let read: bool = block TypingHarness::read_path(typing_harness, &mut name);
        transition toolchain.complete && toolchain.value < 2 && read {
            true -> add_package(typing_harness, sources, parser, remaining, toolchain.value == 1, &name)
            _ -> malformed(typing_harness)
        }
    }

    state add_package(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        toolchain: bool,
        name: &ModulePath
    ) {
        let added: bool = SourceSet::add_package(sources, name, toolchain);
        transition added {
            true -> packages(typing_harness, sources, parser, remaining - 1)
            _ -> source_full(typing_harness)
        }
    }

    state dependencies(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser) {
        let count: HarnessWord = block TypingHarness::read_u32(typing_harness);
        transition count.complete {
            true -> dependency(typing_harness, sources, parser, count.value)
            _ -> malformed(typing_harness)
        }
    }

    state dependency(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> dependency_row(typing_harness, sources, parser, remaining)
            _ -> units(typing_harness, sources, parser)
        }
    }

    state dependency_row(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let requester: HarnessWord = block TypingHarness::read_u32(typing_harness);
        let scope: HarnessWord = block TypingHarness::read_u32(typing_harness);
        let mut alias: ModulePath;
        ModulePath::clear(&mut alias);
        let read: bool = block TypingHarness::read_path(typing_harness, &mut alias);
        let target: HarnessWord = block TypingHarness::read_u32(typing_harness);
        transition requester.complete && scope.complete && read && target.complete
            && (scope.value == 1 || scope.value == 2)
            && requester.value < sources.package_count && target.value < sources.package_count {
            true -> dependency_scope(typing_harness, sources, parser, remaining, requester.value, scope.value == 2, &alias, target.value)
            _ -> malformed(typing_harness)
        }
    }

    state dependency_scope(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        requester: u64 in Trapping,
        build: bool,
        alias: &ModulePath,
        target: u64 in Trapping
    ) {
        transition build {
            true -> add_dependency(typing_harness, sources, parser, remaining, requester, DependencyScope::Build, alias, target)
            _ -> add_dependency(typing_harness, sources, parser, remaining, requester, DependencyScope::Product, alias, target)
        }
    }

    state add_dependency(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        requester: u64 in Trapping,
        scope: DependencyScope,
        alias: &ModulePath,
        target: u64 in Trapping
    ) {
        let added: bool = SourceSet::add_dependency(sources, requester, scope, alias, target);
        transition added {
            true -> dependency(typing_harness, sources, parser, remaining - 1)
            _ -> source_full(typing_harness)
        }
    }

    state units(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser) {
        let count: HarnessWord = block TypingHarness::read_u32(typing_harness);
        transition count.complete {
            true -> unit(typing_harness, sources, parser, count.value)
            _ -> malformed(typing_harness)
        }
    }

    state unit(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> unit_row(typing_harness, sources, parser, remaining)
            _ -> prepare_resolve(typing_harness, sources, parser)
        }
    }

    state unit_row(typing_harness: &mut TypingHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let unit_package: HarnessWord = block TypingHarness::read_u32(typing_harness);
        let mut module_path: ModulePath;
        ModulePath::clear(&mut module_path);
        let read: bool = block TypingHarness::read_path(typing_harness, &mut module_path);
        transition unit_package.complete && read && unit_package.value < sources.package_count {
            true -> source(typing_harness, sources, parser, remaining, unit_package.value, &module_path)
            _ -> malformed(typing_harness)
        }
    }

    state source(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath
    ) {
        let length: HarnessWord = block TypingHarness::read_u32(typing_harness);
        let mut lexer: Lexer;
        Lexer::initialize(&mut lexer, sources.unit_count as u32 in Trapping);
        transition length.complete {
            true -> source_byte(typing_harness, sources, parser, remaining, unit_package, module_path, &mut lexer, length.value)
            _ -> malformed(typing_harness)
        }
    }

    state source_byte(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping
    ) {
        transition left > 0 {
            true -> source_read(typing_harness, sources, parser, remaining, unit_package, module_path, lexer, left)
            _ -> tokenize(typing_harness, sources, parser, remaining, unit_package, module_path, lexer)
        }
    }

    state source_read(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping
    ) {
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Byte { value } -> source_store(typing_harness, sources, parser, remaining, unit_package, module_path, lexer, left, value)
            _ -> malformed(typing_harness)
        }
    }

    state source_store(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping,
        value: i32
    ) {
        Lexer::append_source_byte(lexer, value as u8);
        transition lexer.source.last_retained {
            true -> source_byte(typing_harness, sources, parser, remaining, unit_package, module_path, lexer, left - 1)
            _ -> source_full(typing_harness)
        }
    }

    state tokenize(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer
    ) {
        Lexer::tokenize(lexer);
        transition lexer.output.accepted {
            true -> parse(typing_harness, sources, parser, remaining, unit_package, module_path, lexer)
            _ -> lex_rejected(typing_harness)
        }
    }

    state parse(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &Lexer
    ) {
        Parser::parse(parser, lexer.source.id, lexer.source.length as u64 in Trapping, &lexer.output);
        transition parser.output.accepted {
            true -> add(typing_harness, sources, parser, remaining, unit_package, module_path, lexer)
            _ -> parse_rejected(typing_harness)
        }
    }

    state add(
        typing_harness: &mut TypingHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &Lexer
    ) {
        let added: bool = SourceSet::add(sources, &lexer.source, unit_package, module_path);
        transition added {
            true -> unit(typing_harness, sources, parser, remaining - 1)
            _ -> source_full(typing_harness)
        }
    }

    state prepare_resolve(typing_harness: &mut TypingHarness, sources: &SourceSet, parser: &Parser) {
        let mut resolver: Resolver;
        Resolver::initialize(&mut resolver);
        transition { _ -> resolve(typing_harness, sources, parser, &mut resolver) }
    }

    state resolve(
        typing_harness: &mut TypingHarness,
        sources: &SourceSet,
        parser: &Parser,
        resolver: &mut Resolver
    ) {
        Resolver::resolve(resolver, sources, &parser.output);
        transition resolver.output.accepted {
            true -> prepare_type(typing_harness, sources, parser, resolver)
            _ -> resolve_rejected(typing_harness)
        }
    }

    state prepare_type(typing_harness: &mut TypingHarness, sources: &SourceSet, parser: &Parser, resolver: &mut Resolver) {
        let mut typer: Typer;
        transition { _ -> type_check(typing_harness, sources, parser, resolver, &mut typer) }
    }

    state type_check(
        typing_harness: &mut TypingHarness,
        sources: &SourceSet,
        parser: &Parser,
        resolver: &mut Resolver,
        typer: &mut Typer
    ) {
        Typer::type_check(typer, sources, &parser.output, &resolver.output);
        TypingHarness::write_typing_observation(typing_harness, &typer.output, &parser.output);
        transition typer.output.accepted {
            true -> accepted(typing_harness)
            _ -> type_rejected(typing_harness)
        }
    }

    state accepted(typing_harness: &mut TypingHarness) {
        Console::exit_process(0);
    }

    state type_rejected(typing_harness: &mut TypingHarness) {
        Console::exit_process(249);
    }

    state resolve_rejected(typing_harness: &mut TypingHarness) {
        Console::exit_process(248);
    }

    state parse_rejected(typing_harness: &mut TypingHarness) {
        Console::exit_process(250);
    }

    state lex_rejected(typing_harness: &mut TypingHarness) {
        Console::exit_process(251);
    }

    state source_full(typing_harness: &mut TypingHarness) {
        Console::exit_process(252);
    }

    state malformed(typing_harness: &mut TypingHarness) {
        Console::exit_process(253);
    }
}

machine TypingHarness::read_u32(typing_harness: &mut TypingHarness) -> HarnessWord
reaches Console
crashes Trap
blocks;
{
    transition { _ -> next(typing_harness, 0, 0, 1) }

    state next(typing_harness: &mut TypingHarness, read: u64 in Trapping, value: u64 in Trapping, scale: u64 in Trapping) -> HarnessWord {
        transition read < 4 {
            true -> byte(typing_harness, read, value, scale)
            _ -> word(value)
        }
    }

    state byte(typing_harness: &mut TypingHarness, read: u64 in Trapping, value: u64 in Trapping, scale: u64 in Trapping) -> HarnessWord {
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Byte { value as byte } -> next(typing_harness, read + 1, value + (byte as u64 in Trapping) * scale, scale * 256)
            _ -> ended()
        }
    }

    state word(value: u64 in Trapping) -> HarnessWord {
        HarnessWord { value: value, complete: true }
    }

    state ended() -> HarnessWord {
        HarnessWord { value: 0, complete: false }
    }
}

// A `u32`-framed name read into `path`, or false when the input ends inside
// it or it exceeds the path's provision.
machine TypingHarness::read_path(typing_harness: &mut TypingHarness, path: &mut ModulePath) -> bool
reaches Console
crashes Trap
blocks;
{
    let length: HarnessWord = block TypingHarness::read_u32(typing_harness);
    transition length.complete {
        true -> byte(typing_harness, path, length.value)
        _ -> failed()
    }

    state byte(typing_harness: &mut TypingHarness, path: &mut ModulePath, left: u64 in Trapping) -> bool {
        transition left > 0 {
            true -> read(typing_harness, path, left)
            _ -> complete()
        }
    }

    state read(typing_harness: &mut TypingHarness, path: &mut ModulePath, left: u64 in Trapping) -> bool {
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Byte { value } -> store(typing_harness, path, left, value)
            _ -> failed()
        }
    }

    state store(typing_harness: &mut TypingHarness, path: &mut ModulePath, left: u64 in Trapping, value: i32) -> bool {
        let kept: bool = ModulePath::append(path, value as u8);
        transition kept {
            true -> byte(typing_harness, path, left - 1)
            _ -> failed()
        }
    }

    state complete() -> bool {
        true
    }

    state failed() -> bool {
        false
    }
}


// Versioned canonical typing observation. Every scalar coordinate and count
// is little-endian u64. The stream begins with `OMGTYP1\0`, version 1, the
// acceptance byte, the diagnostic tag and its source span; then the type
// table, one row per type (kind, builtin and domain tags, item, access tag,
// inner, length, first argument, argument count), and its argument run;
// then one row per expression (source span, type, selection tag and handle,
// adaptation tag, anonymous sign byte and magnitude); then each pattern
// field's binder type. Tags are declaration ordinals. This is hosted
// development tooling, not an Omega ABI.
machine TypingHarness::write_typing_observation(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees)
reaches Console
crashes Trap
{
    TypingHarness::write_byte(typing_harness, 79);
    TypingHarness::write_byte(typing_harness, 77);
    TypingHarness::write_byte(typing_harness, 71);
    TypingHarness::write_byte(typing_harness, 84);
    TypingHarness::write_byte(typing_harness, 89);
    TypingHarness::write_byte(typing_harness, 80);
    TypingHarness::write_byte(typing_harness, 49);
    TypingHarness::write_byte(typing_harness, 0);
    TypingHarness::write_u64(typing_harness, 1);
    TypingHarness::write_diagnostic(typing_harness, output);
    TypingHarness::write_u64(typing_harness, output.types.row_count as u64 in Trapping);
    transition { _ -> row(typing_harness, output, syntax, 0) }

    state row(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.types.row_count {
            true -> type_row(typing_harness, output, syntax, index)
            _ -> arguments(typing_harness, output, syntax)
        }
    }

    state type_row(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        TypingHarness::write_type_row(typing_harness, output, index);
        transition { _ -> row(typing_harness, output, syntax, index + 1) }
    }

    state arguments(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees) {
        TypingHarness::write_u64(typing_harness, output.types.argument_count as u64 in Trapping);
        transition { _ -> argument(typing_harness, output, syntax, 0) }
    }

    state argument(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.types.argument_count {
            true -> argument_row(typing_harness, output, syntax, index)
            _ -> expressions(typing_harness, output, syntax)
        }
    }

    state argument_row(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let argument_type: u64 in Trapping = TypeTable::argument(&output.types, index);
        TypingHarness::write_u64(typing_harness, argument_type);
        transition { _ -> argument(typing_harness, output, syntax, index + 1) }
    }

    state expressions(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees) {
        TypingHarness::write_u64(typing_harness, output.expression_count as u64 in Trapping);
        transition { _ -> expression(typing_harness, output, syntax, 0) }
    }

    state expression(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.expression_count {
            true -> expression_row(typing_harness, output, syntax, index)
            _ -> binders(typing_harness, output, syntax)
        }
    }

    state expression_row(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        TypingHarness::write_expression_span(typing_harness, syntax, index);
        TypingHarness::write_expression_row(typing_harness, output, index);
        transition { _ -> expression(typing_harness, output, syntax, index + 1) }
    }

    state binders(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees) {
        TypingHarness::write_u64(typing_harness, output.binder_count as u64 in Trapping);
        transition { _ -> binder(typing_harness, output, syntax, 0) }
    }

    state binder(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.binder_count {
            true -> binder_row(typing_harness, output, syntax, index)
            _ -> done()
        }
    }

    state binder_row(typing_harness: &mut TypingHarness, output: &Typing, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let binder_type: u64 in Trapping = Typing::binder_type(output, index);
        TypingHarness::write_u64(typing_harness, binder_type);
        transition { _ -> binder(typing_harness, output, syntax, index + 1) }
    }

    state done() {}
}

machine TypingHarness::write_diagnostic(typing_harness: &mut TypingHarness, output: &Typing)
reaches Console
{
    let code: TypeDiagnosticCode = output.diagnostic.code;
    let accepted: u8 = TypingHarness::boolean_tag(output.accepted);
    let diagnostic: u8 = TypingHarness::diagnostic_tag(code);
    TypingHarness::write_byte(typing_harness, accepted);
    TypingHarness::write_byte(typing_harness, diagnostic);
    TypingHarness::write_source_span(typing_harness, output.diagnostic.source_span);
}

machine TypingHarness::write_type_row(typing_harness: &mut TypingHarness, output: &Typing, index: u64 in Trapping)
reaches Console
crashes Trap
{
    let type_row: TypeRow = TypeTable::row(&output.types, index);
    let kind: u8 = TypingHarness::kind_tag(type_row.kind);
    let builtin: u8 = TypingHarness::builtin_tag(type_row.builtin);
    let domain: u8 = TypingHarness::domain_tag(type_row.domain);
    let access: u8 = TypingHarness::access_tag(type_row.access);
    TypingHarness::write_byte(typing_harness, kind);
    TypingHarness::write_byte(typing_harness, builtin);
    TypingHarness::write_byte(typing_harness, domain);
    TypingHarness::write_u64(typing_harness, type_row.domain_item);
    TypingHarness::write_u64(typing_harness, type_row.item);
    TypingHarness::write_byte(typing_harness, access);
    TypingHarness::write_u64(typing_harness, type_row.inner);
    TypingHarness::write_u64(typing_harness, type_row.length);
    TypingHarness::write_u64(typing_harness, type_row.first_argument);
    TypingHarness::write_u64(typing_harness, type_row.argument_count);
}

machine TypingHarness::write_expression_row(typing_harness: &mut TypingHarness, output: &Typing, index: u64 in Trapping)
reaches Console
crashes Trap
{
    let adaptation_value: Adaptation = Typing::adaptation(output, index);
    let adaptation: u8 = TypingHarness::adaptation_tag(adaptation_value);
    let value: ExactInteger = Typing::value(output, index);
    let negative: u8 = TypingHarness::boolean_tag(value.negative);
    let expression_type: u64 in Trapping = Typing::expression_type(output, index);
    let selection: Selection = Typing::selection(output, index);
    TypingHarness::write_u64(typing_harness, expression_type);
    TypingHarness::write_selection(typing_harness, selection);
    TypingHarness::write_byte(typing_harness, adaptation);
    TypingHarness::write_byte(typing_harness, negative);
    TypingHarness::write_u64(typing_harness, value.magnitude as u64 in Trapping);
}

// An expression's source span, from its scalar coordinates.
machine TypingHarness::write_expression_span(typing_harness: &mut TypingHarness, syntax: &SyntaxTrees, index: u64 in Trapping)
reaches Console
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, index);
    TypingHarness::write_u64(typing_harness, expression.source_span.source.value as u64 in Trapping);
    TypingHarness::write_u64(typing_harness, expression.source_span.span.start);
    TypingHarness::write_u64(typing_harness, expression.source_span.span.end);
}

// A selection: its tag (0 none, 1 machine, 2 state, 3 field, 4 length,
// 5 machine binder) and handle.
machine TypingHarness::write_selection(typing_harness: &mut TypingHarness, selection: Selection) reaches Console {
    transition selection {
        Selection::None -> write(typing_harness, 0, 0)
        Selection::Machine { handle } -> write(typing_harness, 1, handle)
        Selection::State { handle } -> write(typing_harness, 2, handle)
        Selection::Field { field } -> write(typing_harness, 3, field)
        Selection::Length -> write(typing_harness, 4, 0)
        Selection::Binder { parameter } -> write(typing_harness, 5, parameter)
    }

    state write(typing_harness: &mut TypingHarness, tag: u8, handle: u64 in Trapping) {
        TypingHarness::write_byte(typing_harness, tag);
        TypingHarness::write_u64(typing_harness, handle);
    }
}

machine TypingHarness::boolean_tag(value: bool) -> u8 {
    transition value {
        true -> tag(1)
        _ -> tag(0)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine TypingHarness::kind_tag(value: TypeKind) -> u8 {
    transition value {
        TypeKind::Absent -> tag(0)
        TypeKind::Builtin -> tag(1)
        TypeKind::Data -> tag(2)
        TypeKind::Reference -> tag(3)
        TypeKind::Array -> tag(4)
        TypeKind::Slice -> tag(5)
        TypeKind::GenericParameter -> tag(6)
        TypeKind::StaticInteger -> tag(7)
        TypeKind::Unit -> tag(8)
        TypeKind::AnonymousInteger -> tag(9)
        TypeKind::AnonymousFloat -> tag(10)
        TypeKind::AnonymousChoice -> tag(11)
        TypeKind::AnonymousArray -> tag(12)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine TypingHarness::builtin_tag(value: BuiltinType) -> u8 {
    transition value {
        BuiltinType::Bool -> tag(0)
        BuiltinType::I8 -> tag(1)
        BuiltinType::I16 -> tag(2)
        BuiltinType::I32 -> tag(3)
        BuiltinType::I64 -> tag(4)
        BuiltinType::U8 -> tag(5)
        BuiltinType::U16 -> tag(6)
        BuiltinType::U32 -> tag(7)
        BuiltinType::U64 -> tag(8)
        BuiltinType::Address -> tag(9)
        BuiltinType::F32 -> tag(10)
        BuiltinType::F64 -> tag(11)
        BuiltinType::Slice -> tag(12)
        BuiltinType::Result -> tag(13)
        BuiltinType::SyscallResult -> tag(14)
        BuiltinType::Terminal -> tag(15)
        BuiltinType::Never -> tag(16)
        BuiltinType::UInt -> tag(17)
        BuiltinType::Int -> tag(18)
        BuiltinType::AtomicBool -> tag(19)
        BuiltinType::AtomicU32 -> tag(20)
        BuiltinType::AtomicU64 -> tag(21)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine TypingHarness::domain_tag(value: DomainBinding) -> u8 {
    transition value {
        DomainBinding::Unqualified -> tag(0)
        DomainBinding::Wrapping -> tag(1)
        DomainBinding::Saturating -> tag(2)
        DomainBinding::Trapping -> tag(3)
        DomainBinding::Finite -> tag(4)
        DomainBinding::Declared -> tag(5)
        DomainBinding::Case -> tag(6)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine TypingHarness::access_tag(value: ReferenceAccess) -> u8 {
    transition value {
        ReferenceAccess::Shared -> tag(0)
        ReferenceAccess::Mutable -> tag(1)
        ReferenceAccess::WriteOnly -> tag(2)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine TypingHarness::adaptation_tag(value: Adaptation) -> u8 {
    transition value {
        Adaptation::None -> tag(0)
        Adaptation::Landed -> tag(1)
        Adaptation::SharedLend -> tag(2)
        Adaptation::Qualified -> tag(3)
        Adaptation::Read -> tag(4)
    }

    state tag(number: u8) -> u8 {
        number
    }
}

machine TypingHarness::diagnostic_tag(value: TypeDiagnosticCode) -> u8 {
    transition value {
        TypeDiagnosticCode::None -> tag(0)
        TypeDiagnosticCode::TypeCapacityExceeded -> tag(1)
        TypeDiagnosticCode::UnsupportedTypeForm -> tag(2)
        TypeDiagnosticCode::GenericArgumentCount -> tag(3)
        TypeDiagnosticCode::UnsupportedArrayLength -> tag(4)
        TypeDiagnosticCode::UnsupportedDomain -> tag(5)
        TypeDiagnosticCode::MismatchedTypes -> tag(6)
        TypeDiagnosticCode::LiteralOutOfRange -> tag(7)
        TypeDiagnosticCode::UnsupportedLiteral -> tag(8)
        TypeDiagnosticCode::AnonymousValueOutOfRange -> tag(9)
        TypeDiagnosticCode::AnonymousRemainder -> tag(10)
        TypeDiagnosticCode::UnknownField -> tag(11)
        TypeDiagnosticCode::ProjectionOfNonData -> tag(12)
        TypeDiagnosticCode::IndexOfNonCollection -> tag(13)
        TypeDiagnosticCode::NonIntegerIndex -> tag(14)
        TypeDiagnosticCode::OperandMismatch -> tag(15)
        TypeDiagnosticCode::NotBoolean -> tag(16)
        TypeDiagnosticCode::UnsupportedEquality -> tag(17)
        TypeDiagnosticCode::NoMatchingMachine -> tag(18)
        TypeDiagnosticCode::AmbiguousMachine -> tag(19)
        TypeDiagnosticCode::NotCallable -> tag(20)
        TypeDiagnosticCode::NotAValue -> tag(21)
        TypeDiagnosticCode::UnknownConstructionField -> tag(22)
        TypeDiagnosticCode::DuplicateConstructionField -> tag(23)
        TypeDiagnosticCode::NotConstructible -> tag(24)
        TypeDiagnosticCode::CaseOfOtherData -> tag(25)
        TypeDiagnosticCode::UnknownPatternField -> tag(26)
        TypeDiagnosticCode::InvalidCast -> tag(27)
        TypeDiagnosticCode::NotAPlace -> tag(28)
        TypeDiagnosticCode::TerminalResultMismatch -> tag(29)
        TypeDiagnosticCode::AnonymousFraction -> tag(30)
        TypeDiagnosticCode::UnsupportedExpression -> tag(31)
        TypeDiagnosticCode::TargetArgumentCount -> tag(32)
        TypeDiagnosticCode::UninferredGenericArgument -> tag(33)
        TypeDiagnosticCode::SatisfierMismatch -> tag(34)
        TypeDiagnosticCode::SilentDiscard -> tag(35)
        TypeDiagnosticCode::DiscardsNoCall -> tag(36)
        TypeDiagnosticCode::PropositionArgumentCount -> tag(37)
        TypeDiagnosticCode::UncoveredDispatch -> tag(38)
        TypeDiagnosticCode::ImmutablePlace -> tag(39)
        TypeDiagnosticCode::ImplicitAttenuation -> tag(40)
    }

    state tag(number: u8) -> u8 {
        number
    }
}
machine TypingHarness::write_source_span(typing_harness: &mut TypingHarness, source_span: SourceSpan) reaches Console {
    TypingHarness::write_u64(typing_harness, source_span.source.value as u64 in Trapping);
    TypingHarness::write_u64(typing_harness, source_span.span.start);
    TypingHarness::write_u64(typing_harness, source_span.span.end);
}

machine TypingHarness::write_u64(typing_harness: &mut TypingHarness, value: u64 in Trapping) reaches Console {
    TypingHarness::write_byte(typing_harness, (value % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 256 % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 65536 % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 16777216 % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 4294967296 % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 1099511627776 % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 281474976710656 % 256) as u8);
    TypingHarness::write_byte(typing_harness, (value / 72057594037927936 % 256) as u8);
}

machine TypingHarness::write_byte(typing_harness: &mut TypingHarness, value: u8) reaches Console {
    let mut output: u8 = value;
    Console::write_byte(output as i32);
}
