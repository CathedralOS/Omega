// Expected exit: 0.
// The product consumer admits a public slot only when a returned-borrow
// origin names the same reference parameter as each qualification
// precondition. An empty roster admits. A mismatched index does not.
use psi::Checks;
use psi::SlotOriginKind;
use psi::SlotReview;

data Main {}

machine main(main: &mut Main) crashes Trap {
    let mut checks: Checks;
    psi::clear_slot_records(&mut checks);
    let mut review: SlotReview;
    psi::prepare(&mut review);
    let empty: bool = psi::admits(&review, &checks);
    let qualified: bool = psi::push_slot_qualification(&mut checks, 0, 1);
    let originated: bool = psi::push_slot_origin(&mut checks, SlotOriginKind::Parameter, 0);
    let matched: bool = psi::admits(&review, &checks);
    let extra: bool = psi::push_slot_qualification(&mut checks, 1, 2);
    let mismatched: bool = psi::admits(&review, &checks);
    transition empty && qualified && originated && matched && extra && !mismatched {
        true -> done()
        _ -> bad()
    }

    machine done() {}

    machine bad() crashes Trap {
        crash Trap;
    }
}

machine entry_start() crashes Trap {
    let mut storage: Main;
    main(&mut storage);
}
