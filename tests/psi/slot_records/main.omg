// Expected exit: 0.
// The product consumer admits a public slot only when a returned-borrow
// origin names the same reference parameter as each qualification
// precondition. An empty roster admits. A mismatched index does not.
use psi::checks::checks;
use psi::checking::checker;
use psi::checking::slot_review;
use psi::checking::slots;

data Main {}

machine Main::main(main: &mut Main) crashes Trap {
    let mut checks: Checks;
    Checks::clear_slot_records(&mut checks);
    let mut review: SlotReview;
    SlotReview::prepare(&mut review);
    let empty: bool = SlotReview::admits(&review, &checks);
    let qualified: bool = Checks::push_slot_qualification(&mut checks, 0, 1);
    let originated: bool = Checks::push_slot_origin(&mut checks, SlotOriginKind::Parameter, 0);
    let matched: bool = SlotReview::admits(&review, &checks);
    let extra: bool = Checks::push_slot_qualification(&mut checks, 1, 2);
    let mismatched: bool = SlotReview::admits(&review, &checks);
    transition empty && qualified && originated && matched && extra && !mismatched {
        true -> done()
        _ -> bad()
    }

    machine done() {}

    machine bad() crashes Trap {
        crash Trap;
    }
}

machine entry_start() crashes Trap {
    let mut storage: Main;
    Main::main(&mut storage);
}
