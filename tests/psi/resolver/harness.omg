// Gate-owned black-box name-resolution harness. The gate package's build root
// binds `ResolverHarness::main` as its own product entry; the product compiler
// closure never includes it. Lexing and parsing run exactly as in the product;
// their rejections exit without an observation, since the parser gate owns
// those phases' observations.

use omega_language_std::console;
use omega::language::core::binding;
use psi::lex::lexer;
use psi::parse::parser;
use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;

pub data ResolverHarness {
    console: Binding<Console>;
}

// A little-endian `u32` read from the gate's input, or the input ending
// inside it.
data HarnessWord [copy] {
    value: u64 in Trapping;
    complete: bool;
}

// The gate's input is the source set, framed like the request's subject
// tables (wiki/spec/build/compiler_request.md): a `u32` package count, then
// per package a `u32` toolchain flag (1 for the toolchain's core package,
// else 0) and its `u32`-framed name; a `u32` dependency edge count, then per
// edge its requester's package index, a `u32` scope tag (1 product, 2
// build), its `u32`-framed alias and its target's package index; then a
// `u32` unit count and per unit its package index, `u32`-framed module path
// (`a::b`) and `u32`-framed source. Each unit is lexed and parsed into the
// shared syntax tables in order, so its position is its `SourceId`; the
// whole set then resolves. Malformed framing exits 253, and a set its
// provisions cannot hold 252, without an observation.
pub machine ResolverHarness::main(resolver_harness: &mut ResolverHarness)
reaches Console
invokes Console;
crashes Trap
blocks;
{
    let mut sources: SourceSet;
    SourceSet::clear(&mut sources);
    let mut parser: Parser;
    Parser::initialize(&mut parser);
    let count: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
    transition count.complete {
        true -> packages(resolver_harness, &mut sources, &mut parser, count.value)
        _ -> malformed(resolver_harness)
    }

    state packages(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> package_row(resolver_harness, sources, parser, remaining)
            _ -> dependencies(resolver_harness, sources, parser)
        }
    }

    state package_row(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let toolchain: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        let mut name: ModulePath;
        ModulePath::clear(&mut name);
        let read: bool = block ResolverHarness::read_path(resolver_harness, &mut name);
        transition toolchain.complete && toolchain.value < 2 && read {
            true -> add_package(resolver_harness, sources, parser, remaining, toolchain.value == 1, &name)
            _ -> malformed(resolver_harness)
        }
    }

    state add_package(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        toolchain: bool,
        name: &ModulePath
    ) {
        let added: bool = SourceSet::add_package(sources, name, toolchain);
        transition added {
            true -> packages(resolver_harness, sources, parser, remaining - 1)
            _ -> source_full(resolver_harness)
        }
    }

    state dependencies(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser) {
        let count: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        transition count.complete {
            true -> dependency(resolver_harness, sources, parser, count.value)
            _ -> malformed(resolver_harness)
        }
    }

    state dependency(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> dependency_row(resolver_harness, sources, parser, remaining)
            _ -> units(resolver_harness, sources, parser)
        }
    }

    state dependency_row(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let requester: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        let scope: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        let mut alias: ModulePath;
        ModulePath::clear(&mut alias);
        let read: bool = block ResolverHarness::read_path(resolver_harness, &mut alias);
        let target: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        transition requester.complete && scope.complete && read && target.complete
            && (scope.value == 1 || scope.value == 2)
            && requester.value < sources.package_count && target.value < sources.package_count {
            true -> dependency_scope(resolver_harness, sources, parser, remaining, requester.value, scope.value == 2, &alias, target.value)
            _ -> malformed(resolver_harness)
        }
    }

    state dependency_scope(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        requester: u64 in Trapping,
        build: bool,
        alias: &ModulePath,
        target: u64 in Trapping
    ) {
        transition build {
            true -> add_dependency(resolver_harness, sources, parser, remaining, requester, DependencyScope::Build, alias, target)
            _ -> add_dependency(resolver_harness, sources, parser, remaining, requester, DependencyScope::Product, alias, target)
        }
    }

    state add_dependency(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        requester: u64 in Trapping,
        scope: DependencyScope,
        alias: &ModulePath,
        target: u64 in Trapping
    ) {
        let added: bool = SourceSet::add_dependency(sources, requester, scope, alias, target);
        transition added {
            true -> dependency(resolver_harness, sources, parser, remaining - 1)
            _ -> source_full(resolver_harness)
        }
    }

    state units(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser) {
        let count: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        transition count.complete {
            true -> unit(resolver_harness, sources, parser, count.value)
            _ -> malformed(resolver_harness)
        }
    }

    state unit(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> unit_row(resolver_harness, sources, parser, remaining)
            _ -> prepare_resolve(resolver_harness, sources, parser)
        }
    }

    state unit_row(resolver_harness: &mut ResolverHarness, sources: &mut SourceSet, parser: &mut Parser, remaining: u64 in Trapping) {
        let unit_package: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        let mut module_path: ModulePath;
        ModulePath::clear(&mut module_path);
        let read: bool = block ResolverHarness::read_path(resolver_harness, &mut module_path);
        transition unit_package.complete && read && unit_package.value < sources.package_count {
            true -> source(resolver_harness, sources, parser, remaining, unit_package.value, &module_path)
            _ -> malformed(resolver_harness)
        }
    }

    state source(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath
    ) {
        let length: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
        let mut lexer: Lexer;
        Lexer::initialize(&mut lexer, sources.unit_count as u32 in Trapping);
        transition length.complete {
            true -> source_byte(resolver_harness, sources, parser, remaining, unit_package, module_path, &mut lexer, length.value)
            _ -> malformed(resolver_harness)
        }
    }

    state source_byte(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping
    ) {
        transition left > 0 {
            true -> source_read(resolver_harness, sources, parser, remaining, unit_package, module_path, lexer, left)
            _ -> tokenize(resolver_harness, sources, parser, remaining, unit_package, module_path, lexer)
        }
    }

    state source_read(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping
    ) {
        let input: ByteRead = block resolver_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> source_store(resolver_harness, sources, parser, remaining, unit_package, module_path, lexer, left, value)
            _ -> malformed(resolver_harness)
        }
    }

    state source_store(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer,
        left: u64 in Trapping,
        value: i32
    ) {
        Lexer::append_source_byte(lexer, value as u8);
        transition lexer.source.last_retained {
            true -> source_byte(resolver_harness, sources, parser, remaining, unit_package, module_path, lexer, left - 1)
            _ -> source_full(resolver_harness)
        }
    }

    state tokenize(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &mut Lexer
    ) {
        Lexer::tokenize(lexer);
        transition lexer.output.accepted {
            true -> parse(resolver_harness, sources, parser, remaining, unit_package, module_path, lexer)
            _ -> lex_rejected(resolver_harness)
        }
    }

    state parse(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &Lexer
    ) {
        Parser::parse(parser, lexer.source.id, lexer.source.length as u64 in Trapping, &lexer.output);
        transition parser.output.accepted {
            true -> add(resolver_harness, sources, parser, remaining, unit_package, module_path, lexer)
            _ -> parse_rejected(resolver_harness)
        }
    }

    state add(
        resolver_harness: &mut ResolverHarness,
        sources: &mut SourceSet,
        parser: &mut Parser,
        remaining: u64 in Trapping,
        unit_package: u64 in Trapping,
        module_path: &ModulePath,
        lexer: &Lexer
    ) {
        let added: bool = SourceSet::add(sources, &lexer.source, unit_package, module_path);
        transition added {
            true -> unit(resolver_harness, sources, parser, remaining - 1)
            _ -> source_full(resolver_harness)
        }
    }

    state prepare_resolve(resolver_harness: &mut ResolverHarness, sources: &SourceSet, parser: &Parser) {
        let mut resolver: Resolver;
        Resolver::initialize(&mut resolver);
        transition { _ -> resolve(resolver_harness, sources, parser, &mut resolver) }
    }

    state resolve(
        resolver_harness: &mut ResolverHarness,
        sources: &SourceSet,
        parser: &Parser,
        resolver: &mut Resolver
    ) {
        Resolver::resolve(resolver, sources, &parser.output);
        ResolverHarness::write_resolution_observation(resolver_harness, &resolver.output);
        transition resolver.output.accepted {
            true -> accepted(resolver_harness)
            _ -> resolve_rejected(resolver_harness)
        }
    }

    state accepted(resolver_harness: &mut ResolverHarness) {
        resolver_harness.console.exit_process(0);
    }

    state resolve_rejected(resolver_harness: &mut ResolverHarness) {
        resolver_harness.console.exit_process(249);
    }

    state parse_rejected(resolver_harness: &mut ResolverHarness) {
        resolver_harness.console.exit_process(250);
    }

    state lex_rejected(resolver_harness: &mut ResolverHarness) {
        resolver_harness.console.exit_process(251);
    }

    state source_full(resolver_harness: &mut ResolverHarness) {
        resolver_harness.console.exit_process(252);
    }

    state malformed(resolver_harness: &mut ResolverHarness) {
        resolver_harness.console.exit_process(253);
    }
}

machine ResolverHarness::read_u32(resolver_harness: &mut ResolverHarness) -> HarnessWord
reaches Console
crashes Trap
blocks;
{
    transition { _ -> next(resolver_harness, 0, 0, 1) }

    state next(resolver_harness: &mut ResolverHarness, read: u64 in Trapping, value: u64 in Trapping, scale: u64 in Trapping) -> HarnessWord {
        transition read < 4 {
            true -> byte(resolver_harness, read, value, scale)
            _ -> word(value)
        }
    }

    state byte(resolver_harness: &mut ResolverHarness, read: u64 in Trapping, value: u64 in Trapping, scale: u64 in Trapping) -> HarnessWord {
        let input: ByteRead = block resolver_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value as byte } -> next(resolver_harness, read + 1, value + (byte as u64 in Trapping) * scale, scale * 256)
            _ -> ended()
        }
    }

    state word(value: u64 in Trapping) -> HarnessWord {
        HarnessWord { value: value, complete: true }
    }

    state ended() -> HarnessWord {
        HarnessWord { value: 0, complete: false }
    }
}

// A `u32`-framed name read into `path`, or false when the input ends inside
// it or it exceeds the path's provision.
machine ResolverHarness::read_path(resolver_harness: &mut ResolverHarness, path: &mut ModulePath) -> bool
reaches Console
crashes Trap
blocks;
{
    let length: HarnessWord = block ResolverHarness::read_u32(resolver_harness);
    transition length.complete {
        true -> byte(resolver_harness, path, length.value)
        _ -> failed()
    }

    state byte(resolver_harness: &mut ResolverHarness, path: &mut ModulePath, left: u64 in Trapping) -> bool {
        transition left > 0 {
            true -> read(resolver_harness, path, left)
            _ -> complete()
        }
    }

    state read(resolver_harness: &mut ResolverHarness, path: &mut ModulePath, left: u64 in Trapping) -> bool {
        let input: ByteRead = block resolver_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> store(resolver_harness, path, left, value)
            _ -> failed()
        }
    }

    state store(resolver_harness: &mut ResolverHarness, path: &mut ModulePath, left: u64 in Trapping, value: i32) -> bool {
        let kept: bool = ModulePath::append(path, value as u8);
        transition kept {
            true -> byte(resolver_harness, path, left - 1)
            _ -> failed()
        }
    }

    state complete() -> bool {
        true
    }

    state failed() -> bool {
        false
    }
}

// Versioned canonical resolution observation. Every scalar coordinate and
// count is little-endian u64. The stream begins with `OMGRES1\0`, version 3,
// the acceptance byte, the diagnostic tag and its source span, then one row
// per type reference in syntax-table order: the binding tag, the bound
// handle (builtin ordinal, or data, generic-parameter, trait or conformance
// handle; zero when unresolved or a form), the domain tag and the declared
// domain's or case's handle (zero for any other domain). Then one row per expression:
// the value binding's tag and two handles; then one row per name path: the
// path binding's tag (0 unresolved, 1 machine, 2 domain) and handle; then
// one row per clause: 1 and the requirement machine's handle for a
// `satisfies` clause, else 0 and 0. This is hosted development tooling, not
// an Omega ABI.
machine ResolverHarness::write_resolution_observation(
    resolver_harness: &mut ResolverHarness,
    output: &NameResolution
) reaches Console
crashes Trap
{
    ResolverHarness::write_byte(resolver_harness, 79);
    ResolverHarness::write_byte(resolver_harness, 77);
    ResolverHarness::write_byte(resolver_harness, 71);
    ResolverHarness::write_byte(resolver_harness, 82);
    ResolverHarness::write_byte(resolver_harness, 69);
    ResolverHarness::write_byte(resolver_harness, 83);
    ResolverHarness::write_byte(resolver_harness, 49);
    ResolverHarness::write_byte(resolver_harness, 0);
    ResolverHarness::write_u64(resolver_harness, 3);
    transition output.accepted {
        true -> accepted_header(resolver_harness, output)
        _ -> rejected_header(resolver_harness, output)
    }

    state accepted_header(resolver_harness: &mut ResolverHarness, output: &NameResolution) {
        ResolverHarness::write_byte(resolver_harness, 1);
        transition { _ -> diagnostic(resolver_harness, output) }
    }

    state rejected_header(resolver_harness: &mut ResolverHarness, output: &NameResolution) {
        ResolverHarness::write_byte(resolver_harness, 0);
        transition { _ -> diagnostic(resolver_harness, output) }
    }

    state diagnostic(resolver_harness: &mut ResolverHarness, output: &NameResolution) {
        transition output.diagnostic.code {
            ResolveDiagnosticCode::None -> diagnostic_tag(resolver_harness, output, 0)
            ResolveDiagnosticCode::UnresolvedImport -> diagnostic_tag(resolver_harness, output, 1)
            ResolveDiagnosticCode::UndeclaredDependency -> diagnostic_tag(resolver_harness, output, 28)
            ResolveDiagnosticCode::ShadowsBuiltin -> diagnostic_tag(resolver_harness, output, 2)
            ResolveDiagnosticCode::DuplicateData -> diagnostic_tag(resolver_harness, output, 3)
            ResolveDiagnosticCode::DuplicateDataMember -> diagnostic_tag(resolver_harness, output, 4)
            ResolveDiagnosticCode::DuplicateCasePayloadField -> diagnostic_tag(resolver_harness, output, 5)
            ResolveDiagnosticCode::PayloadFieldCollidesWithCommonField -> diagnostic_tag(resolver_harness, output, 6)
            ResolveDiagnosticCode::UnknownDataType -> diagnostic_tag(resolver_harness, output, 7)
            ResolveDiagnosticCode::UnknownDomain -> diagnostic_tag(resolver_harness, output, 8)
            ResolveDiagnosticCode::DuplicateParameter -> diagnostic_tag(resolver_harness, output, 9)
            ResolveDiagnosticCode::DuplicateState -> diagnostic_tag(resolver_harness, output, 10)
            ResolveDiagnosticCode::DuplicateMachine -> diagnostic_tag(resolver_harness, output, 11)
            ResolveDiagnosticCode::DuplicateGenericParameter -> diagnostic_tag(resolver_harness, output, 12)
            ResolveDiagnosticCode::UnknownName -> diagnostic_tag(resolver_harness, output, 13)
            ResolveDiagnosticCode::AmbiguousName -> diagnostic_tag(resolver_harness, output, 14)
            ResolveDiagnosticCode::PartialStableIdentities -> diagnostic_tag(resolver_harness, output, 15)
            ResolveDiagnosticCode::DuplicateStableIdentity -> diagnostic_tag(resolver_harness, output, 16)
            ResolveDiagnosticCode::InvalidStableIdentity -> diagnostic_tag(resolver_harness, output, 17)
            ResolveDiagnosticCode::UnsupportedDeclaration -> diagnostic_tag(resolver_harness, output, 18)
            ResolveDiagnosticCode::UnsupportedOperatorToken -> diagnostic_tag(resolver_harness, output, 19)
            ResolveDiagnosticCode::UnsupportedMachineContract -> diagnostic_tag(resolver_harness, output, 20)
            ResolveDiagnosticCode::UnsupportedClause -> diagnostic_tag(resolver_harness, output, 21)
            ResolveDiagnosticCode::UnsupportedGenericParameter -> diagnostic_tag(resolver_harness, output, 22)
            ResolveDiagnosticCode::UnsupportedExpression -> diagnostic_tag(resolver_harness, output, 23)
            ResolveDiagnosticCode::DuplicateDeclaration -> diagnostic_tag(resolver_harness, output, 24)
            ResolveDiagnosticCode::NotAType -> diagnostic_tag(resolver_harness, output, 25)
            ResolveDiagnosticCode::NotATrait -> diagnostic_tag(resolver_harness, output, 26)
            ResolveDiagnosticCode::NotARequirement -> diagnostic_tag(resolver_harness, output, 27)
            ResolveDiagnosticCode::ForeignOperatorHome -> diagnostic_tag(resolver_harness, output, 29)
            ResolveDiagnosticCode::ProofOnlyApplication -> diagnostic_tag(resolver_harness, output, 30)
            ResolveDiagnosticCode::ContractNamesNoBinder -> diagnostic_tag(resolver_harness, output, 31)
            ResolveDiagnosticCode::DuplicateContract -> diagnostic_tag(resolver_harness, output, 32)
            ResolveDiagnosticCode::UnsupportedRankingView -> diagnostic_tag(resolver_harness, output, 33)
            ResolveDiagnosticCode::UndeclaredLifetime -> diagnostic_tag(resolver_harness, output, 34)
            ResolveDiagnosticCode::LifetimeArgumentCount -> diagnostic_tag(resolver_harness, output, 35)
        }
    }

    state diagnostic_tag(resolver_harness: &mut ResolverHarness, output: &NameResolution, tag: u8) {
        ResolverHarness::write_byte(resolver_harness, tag);
        ResolverHarness::write_source_span(resolver_harness, output.diagnostic.source_span);
        ResolverHarness::write_u64(resolver_harness, output.binding_count as u64 in Trapping);
        transition { _ -> binding(resolver_harness, output, 0) }
    }

    state binding(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        transition index < output.binding_count {
            true -> binding_row(resolver_harness, output, index)
            _ -> value_count(resolver_harness, output)
        }
    }

    // Value bindings: a tag (0 not a name, 1 unresolved, 2 local, 3
    // parameter, 4 pattern binder, 5 state, 6 machine, 7 data, 8 case, 9
    // ambiguous, 10 generic binder, 11 constant, 12 data field, 13 returned
    // value, 14 proposition) and two handles.
    state value_count(resolver_harness: &mut ResolverHarness, output: &NameResolution) {
        ResolverHarness::write_u64(resolver_harness, output.value_binding_count as u64 in Trapping);
        transition { _ -> value(resolver_harness, output, 0) }
    }

    state value(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        transition index < output.value_binding_count {
            true -> value_row(resolver_harness, output, index)
            _ -> path_count(resolver_harness, output)
        }
    }

    state path_count(resolver_harness: &mut ResolverHarness, output: &NameResolution) {
        ResolverHarness::write_u64(resolver_harness, output.path_binding_count as u64 in Trapping);
        transition { _ -> path(resolver_harness, output, 0) }
    }

    state path(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        transition index < output.path_binding_count {
            true -> path_row(resolver_harness, output, index)
            _ -> requirement_count(resolver_harness, output)
        }
    }

    state requirement_count(resolver_harness: &mut ResolverHarness, output: &NameResolution) {
        ResolverHarness::write_u64(resolver_harness, output.requirement_count as u64 in Trapping);
        transition { _ -> requirement(resolver_harness, output, 0) }
    }

    state requirement(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        transition index < output.requirement_count {
            true -> requirement_row(resolver_harness, output, index)
            _ -> done()
        }
    }

    state requirement_row(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        let binding: ValueBinding = NameResolution::requirement(output, index);
        transition binding {
            ValueBinding::Machine { handle } -> requirement_tag(resolver_harness, output, index, 1, handle)
            _ -> requirement_tag(resolver_harness, output, index, 0, 0)
        }
    }

    state requirement_tag(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping, tag: u8, handle: u64 in Trapping) {
        ResolverHarness::write_byte(resolver_harness, tag);
        ResolverHarness::write_u64(resolver_harness, handle);
        transition { _ -> requirement(resolver_harness, output, index + 1) }
    }

    state path_row(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        let path_binding: PathBinding = NameResolution::path_binding(output, index);
        transition path_binding {
            PathBinding::Unresolved -> path_tag(resolver_harness, output, index, 0, 0)
            PathBinding::Machine { handle } -> path_tag(resolver_harness, output, index, 1, handle)
            PathBinding::Domain { item } -> path_tag(resolver_harness, output, index, 2, item)
        }
    }

    state path_tag(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping, tag: u8, handle: u64 in Trapping) {
        ResolverHarness::write_byte(resolver_harness, tag);
        ResolverHarness::write_u64(resolver_harness, handle);
        transition { _ -> path(resolver_harness, output, index + 1) }
    }

    state value_row(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        let value_binding: ValueBinding = output.value_bindings[index];
        transition value_binding {
            ValueBinding::NotAName -> value_tag(resolver_harness, output, index, 0, 0, 0)
            ValueBinding::Unresolved -> value_tag(resolver_harness, output, index, 1, 0, 0)
            ValueBinding::Ambiguous -> value_tag(resolver_harness, output, index, 9, 0, 0)
            ValueBinding::Local { statement } -> value_tag(resolver_harness, output, index, 2, statement, 0)
            ValueBinding::Parameter { parameter } -> value_tag(resolver_harness, output, index, 3, parameter, 0)
            ValueBinding::PatternBinder { field } -> value_tag(resolver_harness, output, index, 4, field, 0)
            ValueBinding::State { handle } -> value_tag(resolver_harness, output, index, 5, handle, 0)
            ValueBinding::Machine { handle } -> value_tag(resolver_harness, output, index, 6, handle, 0)
            ValueBinding::Data { item } -> value_tag(resolver_harness, output, index, 7, item, 0)
            ValueBinding::DataCase { item, data_case } -> value_tag(resolver_harness, output, index, 8, item, data_case)
            ValueBinding::GenericParameter { parameter } -> value_tag(resolver_harness, output, index, 10, parameter, 0)
            ValueBinding::Constant { constant } -> value_tag(resolver_harness, output, index, 11, constant, 0)
            ValueBinding::Field { field } -> value_tag(resolver_harness, output, index, 12, field, 0)
            ValueBinding::ReturnedValue { machine } -> value_tag(resolver_harness, output, index, 13, machine, 0)
            ValueBinding::Proposition { proposition } -> value_tag(resolver_harness, output, index, 14, proposition, 0)
            ValueBinding::PayloadField { field } -> value_tag(resolver_harness, output, index, 15, field, 0)
            ValueBinding::DomainSubject { domain } -> value_tag(resolver_harness, output, index, 16, domain, 0)
            ValueBinding::BytePredicate { predicate } -> predicate_row(resolver_harness, output, index, predicate)
        }
    }

    state predicate_row(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping, predicate: BytePredicate) {
        let tag: u64 = ResolverHarness::byte_predicate_tag(predicate);
        let first: u64 in Trapping = tag as u64 in Trapping;
        transition { _ -> value_tag(resolver_harness, output, index, 17, first, 0) }
    }

    state value_tag(
        resolver_harness: &mut ResolverHarness,
        output: &NameResolution,
        index: u64 in Trapping,
        tag: u8,
        first: u64 in Trapping,
        second: u64 in Trapping
    ) {
        ResolverHarness::write_byte(resolver_harness, tag);
        ResolverHarness::write_u64(resolver_harness, first);
        ResolverHarness::write_u64(resolver_harness, second);
        transition { _ -> value(resolver_harness, output, index + 1) }
    }

    state binding_row(resolver_harness: &mut ResolverHarness, output: &NameResolution, index: u64 in Trapping) {
        let type_binding: TypeBinding = output.type_bindings[index];
        transition type_binding {
            TypeBinding::Unresolved -> type_row(resolver_harness, output, index, 0, 0)
            TypeBinding::Ambiguous -> type_row(resolver_harness, output, index, 8, 0)
            TypeBinding::Builtin { builtin } -> builtin_row(resolver_harness, output, index, builtin)
            TypeBinding::Data { item } -> type_row(resolver_harness, output, index, 2, item)
            TypeBinding::GenericParameter { parameter } -> type_row(resolver_harness, output, index, 3, parameter)
            TypeBinding::Reference -> type_row(resolver_harness, output, index, 4, 0)
            TypeBinding::Array -> type_row(resolver_harness, output, index, 5, 0)
            TypeBinding::Slice -> type_row(resolver_harness, output, index, 6, 0)
            TypeBinding::Literal -> type_row(resolver_harness, output, index, 7, 0)
            TypeBinding::Trait { item } -> type_row(resolver_harness, output, index, 9, item)
            TypeBinding::Conformance { item } -> type_row(resolver_harness, output, index, 10, item)
            TypeBinding::Machine { handle } -> type_row(resolver_harness, output, index, 11, handle)
        }
    }

    state builtin_row(
        resolver_harness: &mut ResolverHarness,
        output: &NameResolution,
        index: u64 in Trapping,
        builtin: BuiltinType
    ) {
        transition builtin {
            BuiltinType::Bool -> type_row(resolver_harness, output, index, 1, 0)
            BuiltinType::I8 -> type_row(resolver_harness, output, index, 1, 1)
            BuiltinType::I16 -> type_row(resolver_harness, output, index, 1, 2)
            BuiltinType::I32 -> type_row(resolver_harness, output, index, 1, 3)
            BuiltinType::I64 -> type_row(resolver_harness, output, index, 1, 4)
            BuiltinType::U8 -> type_row(resolver_harness, output, index, 1, 5)
            BuiltinType::U16 -> type_row(resolver_harness, output, index, 1, 6)
            BuiltinType::U32 -> type_row(resolver_harness, output, index, 1, 7)
            BuiltinType::U64 -> type_row(resolver_harness, output, index, 1, 8)
            BuiltinType::Address -> type_row(resolver_harness, output, index, 1, 9)
            BuiltinType::F32 -> type_row(resolver_harness, output, index, 1, 10)
            BuiltinType::F64 -> type_row(resolver_harness, output, index, 1, 11)
            BuiltinType::Slice -> type_row(resolver_harness, output, index, 1, 12)
            BuiltinType::Result -> type_row(resolver_harness, output, index, 1, 13)
            BuiltinType::SyscallResult -> type_row(resolver_harness, output, index, 1, 14)
            BuiltinType::Terminal -> type_row(resolver_harness, output, index, 1, 15)
            BuiltinType::Never -> type_row(resolver_harness, output, index, 1, 16)
            BuiltinType::UInt -> type_row(resolver_harness, output, index, 1, 17)
            BuiltinType::Int -> type_row(resolver_harness, output, index, 1, 18)
            BuiltinType::AtomicBool -> type_row(resolver_harness, output, index, 1, 19)
            BuiltinType::AtomicU32 -> type_row(resolver_harness, output, index, 1, 20)
            BuiltinType::AtomicU64 -> type_row(resolver_harness, output, index, 1, 21)
        }
    }

    state type_row(
        resolver_harness: &mut ResolverHarness,
        output: &NameResolution,
        index: u64 in Trapping,
        tag: u8,
        handle: u64 in Trapping
    ) {
        ResolverHarness::write_byte(resolver_harness, tag);
        ResolverHarness::write_u64(resolver_harness, handle);
        transition output.domain_bindings[index] {
            DomainBinding::Unqualified -> domain_row(resolver_harness, output, index, 0)
            DomainBinding::Wrapping -> domain_row(resolver_harness, output, index, 1)
            DomainBinding::Saturating -> domain_row(resolver_harness, output, index, 2)
            DomainBinding::Trapping -> domain_row(resolver_harness, output, index, 3)
            DomainBinding::Finite -> domain_row(resolver_harness, output, index, 4)
            DomainBinding::Declared -> domain_row(resolver_harness, output, index, 5)
            DomainBinding::Case -> domain_row(resolver_harness, output, index, 6)
        }
    }

    state domain_row(
        resolver_harness: &mut ResolverHarness,
        output: &NameResolution,
        index: u64 in Trapping,
        tag: u8
    ) {
        let item: u64 in Trapping = NameResolution::domain_item(output, index);
        ResolverHarness::write_byte(resolver_harness, tag);
        ResolverHarness::write_u64(resolver_harness, item);
        transition { _ -> binding(resolver_harness, output, index + 1) }
    }

    state done() {}
}

machine ResolverHarness::write_source_span(resolver_harness: &mut ResolverHarness, source_span: SourceSpan) reaches Console {
    ResolverHarness::write_u64(resolver_harness, source_span.source.value as u64 in Trapping);
    ResolverHarness::write_u64(resolver_harness, source_span.span.start);
    ResolverHarness::write_u64(resolver_harness, source_span.span.end);
}

machine ResolverHarness::write_u64(resolver_harness: &mut ResolverHarness, value: u64 in Trapping) reaches Console {
    ResolverHarness::write_byte(resolver_harness, (value % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 256 % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 65536 % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 16777216 % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 4294967296 % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 1099511627776 % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 281474976710656 % 256) as u8);
    ResolverHarness::write_byte(resolver_harness, (value / 72057594037927936 % 256) as u8);
}

machine ResolverHarness::write_byte(resolver_harness: &mut ResolverHarness, value: u8) reaches Console {
    let mut output: u8 = value;
    resolver_harness.console.write_byte(output as i32);
}

machine ResolverHarness::byte_predicate_tag(predicate: BytePredicate) -> u64 {
    transition predicate {
        BytePredicate::ValidUtf8 -> tag(1)
        BytePredicate::NoNul -> tag(2)
        BytePredicate::AsciiOnly -> tag(4)
        BytePredicate::NonEmpty -> tag(8)
    }

    state tag(value: u64) -> u64 {
        value
    }
}
