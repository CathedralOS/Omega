// Gate-owned black-box lexer/parser harness. The gate package's build root
// binds `ParserHarness::main` as its own product entry; the product compiler
// closure never includes it. The package lives outside `source/psi`: a package
// nested under another package's root is that package's source, its build
// output and lock included, so a nested gate could never hold a stable lock.

use omega_language_std::console;
use omega::language::core::binding;
use psi::lex::lexer;
use psi::parse::parser;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

pub data ParserHarness {
    console: Binding<Console>;
}

pub machine ParserHarness::main(parser_harness: &mut ParserHarness)
reaches Console
invokes Console;
crashes Trap
blocks;
{
    let mut lexer: Lexer;
    Lexer::initialize(&mut lexer, 1);
    transition { _ -> read(parser_harness, &mut lexer) }

    state read(parser_harness: &mut ParserHarness, lexer: &mut Lexer) {
        let input: ByteRead = block parser_harness.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> retain(parser_harness, lexer, value)
            _ -> tokenize(parser_harness, lexer)
        }
    }

    state retain(parser_harness: &mut ParserHarness, lexer: &mut Lexer, value: i32) {
        Lexer::append_source_byte(lexer, value as u8);
        transition lexer.source.last_retained {
            true -> read(parser_harness, lexer)
            _ -> source_full(parser_harness, lexer)
        }
    }

    state source_full(parser_harness: &mut ParserHarness, lexer: &mut Lexer) {
        // Read the rejection span before borrowing the lexer mutably for the call.
        let length: u64 = lexer.source.length;
        Lexer::reject(lexer, LexDiagnosticCode::SourceCapacityExceeded,
            length as u64 in Trapping,
            length as u64 in Trapping
        );
        parser_harness.console.exit_process(252);
    }

    state tokenize(parser_harness: &mut ParserHarness, lexer: &mut Lexer) {
        Lexer::tokenize(lexer);
        transition lexer.output.accepted {
            true -> prepare_parse(parser_harness, lexer)
            _ -> rejected(parser_harness)
        }
    }

    state prepare_parse(parser_harness: &mut ParserHarness, lexer: &Lexer) {
        let mut parser: Parser;
        Parser::initialize(&mut parser);
        transition { _ -> parse(parser_harness, lexer, &mut parser) }
    }

    state parse(parser_harness: &mut ParserHarness, lexer: &Lexer, parser: &mut Parser) {
        Parser::parse(parser, lexer.source.id, lexer.source.length as u64 in Trapping, &lexer.output);
        transition parser.output.accepted {
            true -> accepted(parser_harness, &parser.output)
            _ -> parse_rejected(parser_harness, &parser.output)
        }
    }

    state accepted(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_parse_observation(parser_harness, output);
        ParserHarness::write_machine_tables(parser_harness, output);
        ParserHarness::write_declaration_tables(parser_harness, output);
        parser_harness.console.exit_process(0);
    }

    state parse_rejected(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_parse_observation(parser_harness, output);
        ParserHarness::write_machine_tables(parser_harness, output);
        ParserHarness::write_declaration_tables(parser_harness, output);
        parser_harness.console.exit_process(250);
    }

    state rejected(parser_harness: &mut ParserHarness) {
        parser_harness.console.exit_process(251);
    }
}

// Versioned canonical structural parse observation. Every scalar coordinate
// and count is little-endian u64. The stream begins with `OMGPAR13`, version
// 13, acceptance and diagnostic fields, followed by ordered root, use-item,
// path-member, data-item, authored data-member, direct data-field, case-payload
// field, data-case, type-reference, and generic-parameter tables. Field and
// case rows carry their stable-identity flag and literal span.
// Type-reference rows append a qualified flag and the domain coordinates
// (zeros for bare named types), then the reference access tag (0 none,
// 1 shared, 2 mutable) and the referee handle (zero unless a reference). Data-item rows end with the item's
// generic-parameter base and count, its clause range and its boundary flag,
// and generic-parameter rows carry kind,
// name, optional type-reference handle, bounds, and span. This is hosted
// development tooling, not an Omega ABI.
machine ParserHarness::write_parse_observation(
    parser_harness: &mut ParserHarness,
    output: &SyntaxTrees
) reaches Console {
    ParserHarness::write_byte(parser_harness, 79);
    ParserHarness::write_byte(parser_harness, 77);
    ParserHarness::write_byte(parser_harness, 71);
    ParserHarness::write_byte(parser_harness, 80);
    ParserHarness::write_byte(parser_harness, 65);
    ParserHarness::write_byte(parser_harness, 82);
    ParserHarness::write_byte(parser_harness, 49);
    ParserHarness::write_byte(parser_harness, 51);
    ParserHarness::write_u64(parser_harness, 13);
    transition output.accepted {
        true -> parse_accepted_header(parser_harness, output)
        _ -> parse_rejected_header(parser_harness, output)
    }

    state parse_accepted_header(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_byte(parser_harness, 1);
        transition { _ -> parse_diagnostic_none(parser_harness, output) }
    }

    state parse_rejected_header(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_byte(parser_harness, 0);
        transition output.diagnostic.code {
            ParseDiagnosticCode::None -> parse_diagnostic_none(parser_harness, output)
            ParseDiagnosticCode::LexicalInputRejected -> parse_diagnostic(parser_harness, output, 1)
            ParseDiagnosticCode::UnsupportedRootItem -> parse_diagnostic(parser_harness, output, 2)
            ParseDiagnosticCode::ExpectedPathMember -> parse_diagnostic(parser_harness, output, 3)
            ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon -> parse_diagnostic(parser_harness, output, 4)
            ParseDiagnosticCode::RootCapacityExceeded -> parse_diagnostic(parser_harness, output, 5)
            ParseDiagnosticCode::UseCapacityExceeded -> parse_diagnostic(parser_harness, output, 6)
            ParseDiagnosticCode::PathMemberCapacityExceeded -> parse_diagnostic(parser_harness, output, 7)
            ParseDiagnosticCode::TokenInputCapacityExceeded -> parse_diagnostic(parser_harness, output, 8)
            ParseDiagnosticCode::ExpectedItemAfterPub -> parse_diagnostic(parser_harness, output, 9)
            ParseDiagnosticCode::ExpectedDataName -> parse_diagnostic(parser_harness, output, 10)
            ParseDiagnosticCode::ExpectedDataBody -> parse_diagnostic(parser_harness, output, 11)
            ParseDiagnosticCode::ExpectedDataFieldColon -> parse_diagnostic(parser_harness, output, 12)
            ParseDiagnosticCode::ExpectedDataFieldType -> parse_diagnostic(parser_harness, output, 13)
            ParseDiagnosticCode::ExpectedDataFieldEnd -> parse_diagnostic(parser_harness, output, 14)
            ParseDiagnosticCode::DataCapacityExceeded -> parse_diagnostic(parser_harness, output, 15)
            ParseDiagnosticCode::DataFieldCapacityExceeded -> parse_diagnostic(parser_harness, output, 16)
            ParseDiagnosticCode::TypeReferenceCapacityExceeded -> parse_diagnostic(parser_harness, output, 17)
            ParseDiagnosticCode::ExpectedDataProperty -> parse_diagnostic(parser_harness, output, 18)
            ParseDiagnosticCode::ExpectedDataPropertyEnd -> parse_diagnostic(parser_harness, output, 19)
            ParseDiagnosticCode::ExpectedDataCaseName -> parse_diagnostic(parser_harness, output, 20)
            ParseDiagnosticCode::ExpectedDataCaseEnd -> parse_diagnostic(parser_harness, output, 21)
            ParseDiagnosticCode::DataMemberCapacityExceeded -> parse_diagnostic(parser_harness, output, 22)
            ParseDiagnosticCode::DataCaseCapacityExceeded -> parse_diagnostic(parser_harness, output, 23)
            ParseDiagnosticCode::ExpectedDataCasePayloadField -> parse_diagnostic(parser_harness, output, 24)
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldColon -> parse_diagnostic(parser_harness, output, 25)
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldType -> parse_diagnostic(parser_harness, output, 26)
            ParseDiagnosticCode::ExpectedDataCasePayloadSeparatorOrEnd -> parse_diagnostic(parser_harness, output, 27)
            ParseDiagnosticCode::DataCasePayloadFieldCapacityExceeded -> parse_diagnostic(parser_harness, output, 28)
            ParseDiagnosticCode::DuplicateDataMultiplicity -> parse_diagnostic(parser_harness, output, 29)
            ParseDiagnosticCode::ConflictingDataMultiplicity -> parse_diagnostic(parser_harness, output, 30)
            ParseDiagnosticCode::ExpectedTypeQualifierDomain -> parse_diagnostic(parser_harness, output, 31)
            ParseDiagnosticCode::ExpectedGenericParameter -> parse_diagnostic(parser_harness, output, 32)
            ParseDiagnosticCode::ExpectedGenericParameterName -> parse_diagnostic(parser_harness, output, 33)
            ParseDiagnosticCode::ExpectedGenericParameterColon -> parse_diagnostic(parser_harness, output, 34)
            ParseDiagnosticCode::ExpectedGenericParameterType -> parse_diagnostic(parser_harness, output, 35)
            ParseDiagnosticCode::ExpectedGenericParameterEnd -> parse_diagnostic(parser_harness, output, 36)
            ParseDiagnosticCode::GenericParameterCapacityExceeded -> parse_diagnostic(parser_harness, output, 37)
            ParseDiagnosticCode::GenericLifetimeOrdering -> parse_diagnostic(parser_harness, output, 38)
            ParseDiagnosticCode::ExpectedLifetimeName -> parse_diagnostic(parser_harness, output, 194)
            ParseDiagnosticCode::ExpectedMeasureComponent -> parse_diagnostic(parser_harness, output, 195)
            ParseDiagnosticCode::MeasureNotPublic -> parse_diagnostic(parser_harness, output, 196)
            ParseDiagnosticCode::ExpectedMachineName -> parse_diagnostic(parser_harness, output, 40)
            ParseDiagnosticCode::ExpectedMachineParameterOrEnd -> parse_diagnostic(parser_harness, output, 41)
            ParseDiagnosticCode::ExpectedMachineParameter -> parse_diagnostic(parser_harness, output, 42)
            ParseDiagnosticCode::ExpectedMachineParameterColon -> parse_diagnostic(parser_harness, output, 43)
            ParseDiagnosticCode::ExpectedMachineParameterType -> parse_diagnostic(parser_harness, output, 44)
            ParseDiagnosticCode::ExpectedMachineParameterEnd -> parse_diagnostic(parser_harness, output, 45)
            ParseDiagnosticCode::ExpectedMachineReturnType -> parse_diagnostic(parser_harness, output, 46)
            ParseDiagnosticCode::ExpectedMachineBody -> parse_diagnostic(parser_harness, output, 47)
            ParseDiagnosticCode::ExpectedMachineBodyEnd -> parse_diagnostic(parser_harness, output, 48)
            ParseDiagnosticCode::ExpectedStateName -> parse_diagnostic(parser_harness, output, 49)
            ParseDiagnosticCode::ExpectedStateBody -> parse_diagnostic(parser_harness, output, 50)
            ParseDiagnosticCode::ExpectedStateBodyEnd -> parse_diagnostic(parser_harness, output, 51)
            ParseDiagnosticCode::MachineCapacityExceeded -> parse_diagnostic(parser_harness, output, 52)
            ParseDiagnosticCode::ParameterCapacityExceeded -> parse_diagnostic(parser_harness, output, 53)
            ParseDiagnosticCode::StateCapacityExceeded -> parse_diagnostic(parser_harness, output, 54)
            ParseDiagnosticCode::ExpectedOperand -> parse_diagnostic(parser_harness, output, 55)
            ParseDiagnosticCode::ExpectedExpressionPathMember -> parse_diagnostic(parser_harness, output, 56)
            ParseDiagnosticCode::ExpectedFieldName -> parse_diagnostic(parser_harness, output, 57)
            ParseDiagnosticCode::ExpectedGroupEnd -> parse_diagnostic(parser_harness, output, 58)
            ParseDiagnosticCode::ExpectedIndexEnd -> parse_diagnostic(parser_harness, output, 59)
            ParseDiagnosticCode::ExpectedCallArgument -> parse_diagnostic(parser_harness, output, 60)
            ParseDiagnosticCode::ExpectedCallArgumentEnd -> parse_diagnostic(parser_harness, output, 61)
            ParseDiagnosticCode::ExpectedCastType -> parse_diagnostic(parser_harness, output, 62)
            ParseDiagnosticCode::ExpectedStructLiteralFieldOrEnd -> parse_diagnostic(parser_harness, output, 63)
            ParseDiagnosticCode::ExpectedStructLiteralFieldColon -> parse_diagnostic(parser_harness, output, 64)
            ParseDiagnosticCode::ExpectedStructLiteralValue -> parse_diagnostic(parser_harness, output, 65)
            ParseDiagnosticCode::ExpectedStructLiteralFieldEnd -> parse_diagnostic(parser_harness, output, 66)
            ParseDiagnosticCode::ExpressionCapacityExceeded -> parse_diagnostic(parser_harness, output, 67)
            ParseDiagnosticCode::ExpressionNestingExceeded -> parse_diagnostic(parser_harness, output, 68)
            ParseDiagnosticCode::ArgumentCapacityExceeded -> parse_diagnostic(parser_harness, output, 69)
            ParseDiagnosticCode::ConstructFieldCapacityExceeded -> parse_diagnostic(parser_harness, output, 70)
            ParseDiagnosticCode::ExpectedLocalDataName -> parse_diagnostic(parser_harness, output, 71)
            ParseDiagnosticCode::ExpectedLocalDataColon -> parse_diagnostic(parser_harness, output, 72)
            ParseDiagnosticCode::ExpectedLocalDataType -> parse_diagnostic(parser_harness, output, 73)
            ParseDiagnosticCode::ExpectedLocalDataInitialValue -> parse_diagnostic(parser_harness, output, 74)
            ParseDiagnosticCode::ExpectedLocalDataEnd -> parse_diagnostic(parser_harness, output, 75)
            ParseDiagnosticCode::ExpectedAssignmentValue -> parse_diagnostic(parser_harness, output, 76)
            ParseDiagnosticCode::ExpectedAssignmentSemicolon -> parse_diagnostic(parser_harness, output, 77)
            ParseDiagnosticCode::ExpectedStatementEnd -> parse_diagnostic(parser_harness, output, 78)
            ParseDiagnosticCode::ExpectedCrashCause -> parse_diagnostic(parser_harness, output, 79)
            ParseDiagnosticCode::ExpectedCrashEnd -> parse_diagnostic(parser_harness, output, 80)
            ParseDiagnosticCode::StatementCapacityExceeded -> parse_diagnostic(parser_harness, output, 81)
            ParseDiagnosticCode::ExpectedTransitionSubject -> parse_diagnostic(parser_harness, output, 82)
            ParseDiagnosticCode::ExpectedTransitionArm -> parse_diagnostic(parser_harness, output, 83)
            ParseDiagnosticCode::ExpectedTransitionArrow -> parse_diagnostic(parser_harness, output, 84)
            ParseDiagnosticCode::ExpectedTransitionTarget -> parse_diagnostic(parser_harness, output, 85)
            ParseDiagnosticCode::ExpectedTransitionTargetOpen -> parse_diagnostic(parser_harness, output, 86)
            ParseDiagnosticCode::ExpectedTransitionTargetClose -> parse_diagnostic(parser_harness, output, 87)
            ParseDiagnosticCode::ExpectedPatternField -> parse_diagnostic(parser_harness, output, 88)
            ParseDiagnosticCode::ExpectedPatternFieldEnd -> parse_diagnostic(parser_harness, output, 89)
            ParseDiagnosticCode::ArmCapacityExceeded -> parse_diagnostic(parser_harness, output, 90)
            ParseDiagnosticCode::PatternFieldCapacityExceeded -> parse_diagnostic(parser_harness, output, 91)
            ParseDiagnosticCode::ExpectedReachService -> parse_diagnostic(parser_harness, output, 92)
            ParseDiagnosticCode::ExpectedInvokesBinding -> parse_diagnostic(parser_harness, output, 93)
            ParseDiagnosticCode::ExpectedClauseEnd -> parse_diagnostic(parser_harness, output, 94)
            ParseDiagnosticCode::ExpectedClauseFact -> parse_diagnostic(parser_harness, output, 95)
            ParseDiagnosticCode::ClauseCapacityExceeded -> parse_diagnostic(parser_harness, output, 96)
            ParseDiagnosticCode::ExpectedArrayElementType -> parse_diagnostic(parser_harness, output, 97)
            ParseDiagnosticCode::ExpectedArraySeparatorOrEnd -> parse_diagnostic(parser_harness, output, 98)
            ParseDiagnosticCode::ExpectedArrayLength -> parse_diagnostic(parser_harness, output, 99)
            ParseDiagnosticCode::ExpectedArrayEnd -> parse_diagnostic(parser_harness, output, 100)
            ParseDiagnosticCode::ExpectedStaticArgument -> parse_diagnostic(parser_harness, output, 101)
            ParseDiagnosticCode::ExpectedStaticArgumentEnd -> parse_diagnostic(parser_harness, output, 102)
            ParseDiagnosticCode::TypeNestingCapacityExceeded -> parse_diagnostic(parser_harness, output, 103)
            ParseDiagnosticCode::TypeArgumentCapacityExceeded -> parse_diagnostic(parser_harness, output, 104)
            ParseDiagnosticCode::ClauseNotAdmitted -> parse_diagnostic(parser_harness, output, 105)
            ParseDiagnosticCode::DuplicateCallAcknowledgement -> parse_diagnostic(parser_harness, output, 106)
            ParseDiagnosticCode::CallAcknowledgementOrder -> parse_diagnostic(parser_harness, output, 107)
            ParseDiagnosticCode::ExpectedStableIdentity -> parse_diagnostic(parser_harness, output, 108)
            ParseDiagnosticCode::ExpectedBoundaryDeclaration -> parse_diagnostic(parser_harness, output, 109)
            ParseDiagnosticCode::RetiredBoundaryRequirement -> parse_diagnostic(parser_harness, output, 110)
            ParseDiagnosticCode::RetiredOperatorDeclaration -> parse_diagnostic(parser_harness, output, 111)
            ParseDiagnosticCode::ExpectedTargetScopedMachine -> parse_diagnostic(parser_harness, output, 112)
            ParseDiagnosticCode::ExpectedBoundaryDataEnd -> parse_diagnostic(parser_harness, output, 113)
            ParseDiagnosticCode::ExpectedTraitName -> parse_diagnostic(parser_harness, output, 114)
            ParseDiagnosticCode::ExpectedTraitParent -> parse_diagnostic(parser_harness, output, 115)
            ParseDiagnosticCode::ExpectedTraitBody -> parse_diagnostic(parser_harness, output, 116)
            ParseDiagnosticCode::ExpectedTraitMember -> parse_diagnostic(parser_harness, output, 117)
            ParseDiagnosticCode::ExpectedTraitRequirementEnd -> parse_diagnostic(parser_harness, output, 118)
            ParseDiagnosticCode::TraitCapacityExceeded -> parse_diagnostic(parser_harness, output, 119)
            ParseDiagnosticCode::TraitParentCapacityExceeded -> parse_diagnostic(parser_harness, output, 120)
            ParseDiagnosticCode::ExpectedConformanceSatisfies -> parse_diagnostic(parser_harness, output, 121)
            ParseDiagnosticCode::ExpectedConformanceTrait -> parse_diagnostic(parser_harness, output, 122)
            ParseDiagnosticCode::ExpectedConformanceBody -> parse_diagnostic(parser_harness, output, 123)
            ParseDiagnosticCode::ExpectedConformanceMember -> parse_diagnostic(parser_harness, output, 124)
            ParseDiagnosticCode::ExpectedConformanceRowEquals -> parse_diagnostic(parser_harness, output, 125)
            ParseDiagnosticCode::ExpectedConformanceRowTarget -> parse_diagnostic(parser_harness, output, 126)
            ParseDiagnosticCode::ExpectedConformanceRowEnd -> parse_diagnostic(parser_harness, output, 127)
            ParseDiagnosticCode::ConformanceCapacityExceeded -> parse_diagnostic(parser_harness, output, 128)
            ParseDiagnosticCode::ConformanceRowCapacityExceeded -> parse_diagnostic(parser_harness, output, 129)
            ParseDiagnosticCode::ExpectedDomainCarrier -> parse_diagnostic(parser_harness, output, 130)
            ParseDiagnosticCode::ExpectedDomainSeparator -> parse_diagnostic(parser_harness, output, 131)
            ParseDiagnosticCode::ExpectedDomainName -> parse_diagnostic(parser_harness, output, 132)
            ParseDiagnosticCode::ExpectedDomainSubject -> parse_diagnostic(parser_harness, output, 133)
            ParseDiagnosticCode::ExpectedDomainSubjectEnd -> parse_diagnostic(parser_harness, output, 134)
            ParseDiagnosticCode::ExpectedDomainConstituent -> parse_diagnostic(parser_harness, output, 135)
            ParseDiagnosticCode::ExpectedEstablishedBy -> parse_diagnostic(parser_harness, output, 136)
            ParseDiagnosticCode::ExpectedDomainRoute -> parse_diagnostic(parser_harness, output, 137)
            ParseDiagnosticCode::ExpectedDomainEnd -> parse_diagnostic(parser_harness, output, 138)
            ParseDiagnosticCode::ExpectedDomainBodyEnd -> parse_diagnostic(parser_harness, output, 139)
            ParseDiagnosticCode::DomainCapacityExceeded -> parse_diagnostic(parser_harness, output, 140)
            ParseDiagnosticCode::NamePathCapacityExceeded -> parse_diagnostic(parser_harness, output, 141)
            ParseDiagnosticCode::ExpectedConstantName -> parse_diagnostic(parser_harness, output, 142)
            ParseDiagnosticCode::ExpectedConstantColon -> parse_diagnostic(parser_harness, output, 143)
            ParseDiagnosticCode::ExpectedConstantType -> parse_diagnostic(parser_harness, output, 144)
            ParseDiagnosticCode::ExpectedConstantEquals -> parse_diagnostic(parser_harness, output, 145)
            ParseDiagnosticCode::ExpectedConstantValue -> parse_diagnostic(parser_harness, output, 146)
            ParseDiagnosticCode::ExpectedConstantEnd -> parse_diagnostic(parser_harness, output, 147)
            ParseDiagnosticCode::ConstantCapacityExceeded -> parse_diagnostic(parser_harness, output, 148)
            ParseDiagnosticCode::ExpectedPropositionName -> parse_diagnostic(parser_harness, output, 149)
            ParseDiagnosticCode::ExpectedPropositionBody -> parse_diagnostic(parser_harness, output, 150)
            ParseDiagnosticCode::ExpectedPropositionEvidence -> parse_diagnostic(parser_harness, output, 151)
            ParseDiagnosticCode::ExpectedPropositionFact -> parse_diagnostic(parser_harness, output, 152)
            ParseDiagnosticCode::ExpectedPropositionEnd -> parse_diagnostic(parser_harness, output, 153)
            ParseDiagnosticCode::PropositionCapacityExceeded -> parse_diagnostic(parser_harness, output, 154)
            ParseDiagnosticCode::ExpectedConformanceMachineBody -> parse_diagnostic(parser_harness, output, 155)
            ParseDiagnosticCode::ExpectedSatisfiesTrait -> parse_diagnostic(parser_harness, output, 156)
            ParseDiagnosticCode::ExpectedSatisfiedRequirement -> parse_diagnostic(parser_harness, output, 157)
            ParseDiagnosticCode::ExpectedSatisfiesLabel -> parse_diagnostic(parser_harness, output, 158)
            ParseDiagnosticCode::ExpectedSatisfiesBinding -> parse_diagnostic(parser_harness, output, 159)
            ParseDiagnosticCode::ExpectedTerminationSubject -> parse_diagnostic(parser_harness, output, 160)
            ParseDiagnosticCode::ExpectedTerminationSubjectEnd -> parse_diagnostic(parser_harness, output, 161)
            ParseDiagnosticCode::ExpectedTerminationView -> parse_diagnostic(parser_harness, output, 162)
            ParseDiagnosticCode::UnknownOperatorToken -> parse_diagnostic(parser_harness, output, 163)
            ParseDiagnosticCode::OperatorTokenNotAdmitted -> parse_diagnostic(parser_harness, output, 164)
            ParseDiagnosticCode::ExpectedContractName -> parse_diagnostic(parser_harness, output, 165)
            ParseDiagnosticCode::ExpectedContractEnd -> parse_diagnostic(parser_harness, output, 166)
            ParseDiagnosticCode::ContractCapacityExceeded -> parse_diagnostic(parser_harness, output, 167)
            ParseDiagnosticCode::ExpectedMembershipDomain -> parse_diagnostic(parser_harness, output, 168)
            ParseDiagnosticCode::MixedDomainConnectives -> parse_diagnostic(parser_harness, output, 169)
            ParseDiagnosticCode::UnsupportedDomainArguments -> parse_diagnostic(parser_harness, output, 170)
            ParseDiagnosticCode::ExpectedMatchSubject -> parse_diagnostic(parser_harness, output, 171)
            ParseDiagnosticCode::ExpectedMatchArms -> parse_diagnostic(parser_harness, output, 172)
            ParseDiagnosticCode::ExpectedMatchPattern -> parse_diagnostic(parser_harness, output, 173)
            ParseDiagnosticCode::ExpectedMatchArrow -> parse_diagnostic(parser_harness, output, 174)
            ParseDiagnosticCode::ExpectedMatchValue -> parse_diagnostic(parser_harness, output, 175)
            ParseDiagnosticCode::EmptyMatch -> parse_diagnostic(parser_harness, output, 177)
            ParseDiagnosticCode::ExpectedPatternRename -> parse_diagnostic(parser_harness, output, 178)
            ParseDiagnosticCode::ExpectedEvidenceTrait -> parse_diagnostic(parser_harness, output, 179)
            ParseDiagnosticCode::RankedSubjectCapacityExceeded -> parse_diagnostic(parser_harness, output, 180)
            ParseDiagnosticCode::MatchArmCapacityExceeded -> parse_diagnostic(parser_harness, output, 181)
            ParseDiagnosticCode::ExpectedRefinementBase -> parse_diagnostic(parser_harness, output, 182)
            ParseDiagnosticCode::ExpectedRefinementRequirement -> parse_diagnostic(parser_harness, output, 183)
            ParseDiagnosticCode::ExpectedRefinementAxis -> parse_diagnostic(parser_harness, output, 184)
            ParseDiagnosticCode::ExpectedDefinitionName -> parse_diagnostic(parser_harness, output, 185)
            ParseDiagnosticCode::ExpectedDefinitionColon -> parse_diagnostic(parser_harness, output, 186)
            ParseDiagnosticCode::ExpectedDefinitionType -> parse_diagnostic(parser_harness, output, 187)
            ParseDiagnosticCode::ExpectedDefinitionTerm -> parse_diagnostic(parser_harness, output, 188)
            ParseDiagnosticCode::ExpectedDefinitionEnd -> parse_diagnostic(parser_harness, output, 189)
            ParseDiagnosticCode::DefinitionCapacityExceeded -> parse_diagnostic(parser_harness, output, 190)
            ParseDiagnosticCode::ExpectedRangeEnd -> parse_diagnostic(parser_harness, output, 191)
            ParseDiagnosticCode::ExpectedArrayElement -> parse_diagnostic(parser_harness, output, 192)
            ParseDiagnosticCode::ExpectedArrayElementEnd -> parse_diagnostic(parser_harness, output, 193)
        }
    }

    state parse_diagnostic_none(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_byte(parser_harness, 0);
        transition { _ -> parse_diagnostic_coordinates(parser_harness, output) }
    }

    state parse_diagnostic(parser_harness: &mut ParserHarness, output: &SyntaxTrees, tag: u8) {
        ParserHarness::write_byte(parser_harness, tag);
        transition { _ -> parse_diagnostic_coordinates(parser_harness, output) }
    }

    state parse_diagnostic_coordinates(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_source_span(parser_harness, output.diagnostic.source_span);
        ParserHarness::write_u64(parser_harness, output.root_count as u64 in Trapping);
        transition output.root_count > 0 {
            true -> parse_root(parser_harness, output, 0)
            _ -> parse_use_count(parser_harness, output)
        }
    }

    state parse_root(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 4095
    {
        let root: RootItem = output.roots[index];
        transition root.kind {
            RootItemKind::Use -> parse_root_tagged(parser_harness, output, root, index, 1)
            RootItemKind::Data -> parse_root_tagged(parser_harness, output, root, index, 2)
            RootItemKind::Machine -> parse_root_tagged(parser_harness, output, root, index, 3)
            RootItemKind::Trait -> parse_root_tagged(parser_harness, output, root, index, 4)
            RootItemKind::Conformance -> parse_root_tagged(parser_harness, output, root, index, 5)
            RootItemKind::Domain -> parse_root_tagged(parser_harness, output, root, index, 6)
            RootItemKind::Constant -> parse_root_tagged(parser_harness, output, root, index, 7)
            RootItemKind::Proposition -> parse_root_tagged(parser_harness, output, root, index, 8)
            RootItemKind::Definition -> parse_root_tagged(parser_harness, output, root, index, 9)
        }
    }

    state parse_root_tagged(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        root: RootItem,
        index: u64,
        tag: u8
    )
    requires index <= 4095
    {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, root.item_index);
        ParserHarness::write_source_span(parser_harness, root.source_span);
        let next: u64 = index + 1;
        transition next < output.root_count {
            true -> parse_root_bound(parser_harness, output, next)
            _ -> parse_use_count(parser_harness, output)
        }
    }

    state parse_root_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 4096 {
            true -> parse_root(parser_harness, output, next)
            _ -> parse_use_count(parser_harness, output)
        }
    }

    state parse_use_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.use_count as u64 in Trapping);
        transition output.use_count > 0 {
            true -> parse_use_item(parser_harness, output, 0)
            _ -> parse_member_count(parser_harness, output)
        }
    }

    state parse_use_item(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 1023
    {
        let item: UseItem = output.uses[index];
        ParserHarness::write_u64(parser_harness, item.first_member);
        ParserHarness::write_u64(parser_harness, item.member_count as u64 in Trapping);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        let next: u64 = index + 1;
        transition next < output.use_count {
            true -> parse_use_bound(parser_harness, output, next)
            _ -> parse_member_count(parser_harness, output)
        }
    }

    state parse_use_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 1024 {
            true -> parse_use_item(parser_harness, output, next)
            _ -> parse_member_count(parser_harness, output)
        }
    }

    state parse_member_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.member_count as u64 in Trapping);
        transition output.member_count > 0 {
            true -> parse_member(parser_harness, output, 0)
            _ -> parse_data_count(parser_harness, output)
        }
    }

    state parse_member(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 31999
    {
        let member: IdentifierSpan = output.members[index];
        ParserHarness::write_source_span(parser_harness, member.source_span);
        let next: u64 = index + 1;
        transition next < output.member_count {
            true -> parse_member_bound(parser_harness, output, next)
            _ -> parse_data_count(parser_harness, output)
        }
    }

    state parse_member_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 32000 {
            true -> parse_member(parser_harness, output, next)
            _ -> parse_data_count(parser_harness, output)
        }
    }

    state parse_data_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.data_count as u64 in Trapping);
        transition output.data_count > 0 {
            true -> parse_data_item(parser_harness, output, 0)
            _ -> parse_data_member_count(parser_harness, output)
        }
    }

    state parse_data_item(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 255
    {
        let item: DataItem = output.data_items[index];
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_member);
        ParserHarness::write_u64(parser_harness, item.member_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.first_field);
        ParserHarness::write_u64(parser_harness, item.field_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.first_case);
        ParserHarness::write_u64(parser_harness, item.case_count as u64 in Trapping);
        transition item.multiplicity {
            DataMultiplicity::Affine -> parse_data_multiplicity(parser_harness, output, item, index, 0)
            DataMultiplicity::Unrestricted -> parse_data_multiplicity(parser_harness, output, item, index, 1)
            DataMultiplicity::Linear -> parse_data_multiplicity(parser_harness, output, item, index, 2)
        }
    }

    state parse_data_multiplicity(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        item: DataItem,
        index: u64,
        multiplicity: u8
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, multiplicity);
        transition item.is_public {
            true -> parse_data_public(parser_harness, output, item, index)
            _ -> parse_data_private(parser_harness, output, item, index)
        }
    }

    state parse_data_public(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        item: DataItem,
        index: u64
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, 1);
        transition { _ -> parse_data_span(parser_harness, output, item, index) }
    }

    state parse_data_private(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        item: DataItem,
        index: u64
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, 0);
        transition { _ -> parse_data_span(parser_harness, output, item, index) }
    }

    state parse_data_span(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        item: DataItem,
        index: u64
    )
    requires index <= 255
    {
        ParserHarness::write_source_span(parser_harness, item.source_span);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.first_clause);
        ParserHarness::write_u64(parser_harness, item.clause_count);
        ParserHarness::write_flag(parser_harness, item.is_boundary);
        let next: u64 = index + 1;
        transition next < output.data_count {
            true -> parse_data_bound(parser_harness, output, next)
            _ -> parse_data_member_count(parser_harness, output)
        }
    }

    state parse_data_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 256 {
            true -> parse_data_item(parser_harness, output, next)
            _ -> parse_data_member_count(parser_harness, output)
        }
    }

    state parse_data_member_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.data_member_count as u64 in Trapping);
        transition output.data_member_count > 0 {
            true -> parse_data_member(parser_harness, output, 0)
            _ -> parse_field_count(parser_harness, output)
        }
    }

    state parse_data_member(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 2047
    {
        let member: DataMember = output.data_members[index];
        transition member.kind {
            DataMemberKind::Field -> parse_data_member_kind(parser_harness, output, member, index, 1)
            DataMemberKind::Case -> parse_data_member_kind(parser_harness, output, member, index, 2)
        }
    }

    state parse_data_member_kind(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        member: DataMember,
        index: u64,
        kind: u8
    )
    requires index <= 2047
    {
        ParserHarness::write_byte(parser_harness, kind);
        ParserHarness::write_u64(parser_harness, member.item_index);
        ParserHarness::write_source_span(parser_harness, member.source_span);
        let next: u64 = index + 1;
        transition next < output.data_member_count {
            true -> parse_data_member_bound(parser_harness, output, next)
            _ -> parse_field_count(parser_harness, output)
        }
    }

    state parse_data_member_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 2048 {
            true -> parse_data_member(parser_harness, output, next)
            _ -> parse_field_count(parser_harness, output)
        }
    }

    state parse_field_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.field_count as u64 in Trapping);
        transition output.field_count > 0 {
            true -> parse_field(parser_harness, output, 0)
            _ -> parse_payload_field_count(parser_harness, output)
        }
    }

    state parse_field(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 1023
    {
        let field: DataField = output.fields[index];
        ParserHarness::write_source_span(parser_harness, field.name.source_span);
        ParserHarness::write_flag(parser_harness, field.has_identity);
        ParserHarness::write_source_span(parser_harness, field.identity);
        ParserHarness::write_u64(parser_harness, field.type_reference);
        ParserHarness::write_source_span(parser_harness, field.source_span);
        let next: u64 = index + 1;
        transition next < output.field_count {
            true -> parse_field_bound(parser_harness, output, next)
            _ -> parse_payload_field_count(parser_harness, output)
        }
    }

    state parse_field_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 1024 {
            true -> parse_field(parser_harness, output, next)
            _ -> parse_payload_field_count(parser_harness, output)
        }
    }

    state parse_payload_field_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.payload_field_count as u64 in Trapping);
        transition output.payload_field_count > 0 {
            true -> parse_payload_field(parser_harness, output, 0)
            _ -> parse_case_count(parser_harness, output)
        }
    }

    state parse_payload_field(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 1023
    {
        let field: DataField = output.payload_fields[index];
        ParserHarness::write_source_span(parser_harness, field.name.source_span);
        ParserHarness::write_flag(parser_harness, field.has_identity);
        ParserHarness::write_source_span(parser_harness, field.identity);
        ParserHarness::write_u64(parser_harness, field.type_reference);
        ParserHarness::write_source_span(parser_harness, field.source_span);
        let next: u64 = index + 1;
        transition next < output.payload_field_count {
            true -> parse_payload_field_bound(parser_harness, output, next)
            _ -> parse_case_count(parser_harness, output)
        }
    }

    state parse_payload_field_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 1024 {
            true -> parse_payload_field(parser_harness, output, next)
            _ -> parse_case_count(parser_harness, output)
        }
    }

    state parse_case_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.case_count as u64 in Trapping);
        transition output.case_count > 0 {
            true -> parse_case(parser_harness, output, 0)
            _ -> parse_type_reference_count(parser_harness, output)
        }
    }

    state parse_case(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 1535
    {
        let data_case: DataCase = output.cases[index];
        ParserHarness::write_source_span(parser_harness, data_case.name.source_span);
        ParserHarness::write_flag(parser_harness, data_case.has_identity);
        ParserHarness::write_source_span(parser_harness, data_case.identity);
        ParserHarness::write_source_span(parser_harness, data_case.source_span);
        ParserHarness::write_u64(parser_harness, data_case.first_payload_field);
        ParserHarness::write_u64(parser_harness, data_case.payload_field_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, data_case.first_clause);
        ParserHarness::write_u64(parser_harness, data_case.clause_count);
        let next: u64 = index + 1;
        transition next < output.case_count {
            true -> parse_case_bound(parser_harness, output, next)
            _ -> parse_type_reference_count(parser_harness, output)
        }
    }

    state parse_case_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 1536 {
            true -> parse_case(parser_harness, output, next)
            _ -> parse_type_reference_count(parser_harness, output)
        }
    }

    state parse_type_reference_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.type_reference_count as u64 in Trapping);
        transition output.type_reference_count > 0 {
            true -> parse_type_reference(parser_harness, output, 0)
            _ -> parse_type_argument_count(parser_harness, output)
        }
    }

    // Every row writes its kind tag (1 named, 3 reference, 4 array, 5 slice,
    // 6 literal), its name and source spans, its domain flag and the whole
    // qualifier's span, owner path included (zero when unqualified), its access tag (zero unless a reference, then 1
    // shared or 2 mutable) and its inner, length, first-argument,
    // argument-count and first-row handles.
    state parse_type_reference(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 65535
    {
        let type_reference: TypeReference = output.type_references[index];
        transition type_reference.kind {
            TypeReferenceKind::Named -> parse_type_row(parser_harness, output, type_reference, index, 1, 0)
            TypeReferenceKind::Reference -> parse_reference_row(parser_harness, output, type_reference, index)
            TypeReferenceKind::Array -> parse_type_row(parser_harness, output, type_reference, index, 4, 0)
            TypeReferenceKind::Slice -> parse_type_row(parser_harness, output, type_reference, index, 5, 0)
            TypeReferenceKind::Literal -> parse_type_row(parser_harness, output, type_reference, index, 6, 0)
        }
    }

    state parse_reference_row(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64
    )
    requires index <= 65535
    {
        transition type_reference.access {
            ReferenceAccess::Shared -> parse_type_row(parser_harness, output, type_reference, index, 3, 1)
            ReferenceAccess::Mutable -> parse_type_row(parser_harness, output, type_reference, index, 3, 2)
            ReferenceAccess::WriteOnly -> parse_type_row(parser_harness, output, type_reference, index, 3, 3)
        }
    }

    state parse_type_row(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64,
        kind: u8,
        access: u8
    )
    requires index <= 65535
    {
        ParserHarness::write_byte(parser_harness, kind);
        ParserHarness::write_source_span(parser_harness, type_reference.name.source_span);
        ParserHarness::write_source_span(parser_harness, type_reference.source_span);
        transition type_reference.has_domain {
            true -> parse_type_domain(parser_harness, output, type_reference, index, access)
            _ -> parse_type_unqualified(parser_harness, output, type_reference, index, access)
        }
    }

    state parse_type_domain(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64,
        access: u8
    )
    requires index <= 65535
    {
        ParserHarness::write_byte(parser_harness, 1);
        let qualifier: SourceSpan = TypeReference::qualifier_span(type_reference);
        ParserHarness::write_source_span(parser_harness, qualifier);
        transition { _ -> parse_type_tail(parser_harness, output, type_reference, index, access) }
    }

    state parse_type_unqualified(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64,
        access: u8
    )
    requires index <= 65535
    {
        ParserHarness::write_byte(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        transition { _ -> parse_type_tail(parser_harness, output, type_reference, index, access) }
    }

    state parse_type_tail(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64,
        access: u8
    )
    requires index <= 65535
    {
        ParserHarness::write_byte(parser_harness, access);
        ParserHarness::write_u64(parser_harness, type_reference.inner);
        ParserHarness::write_u64(parser_harness, type_reference.length);
        ParserHarness::write_u64(parser_harness, type_reference.first_argument);
        ParserHarness::write_u64(parser_harness, type_reference.argument_count);
        ParserHarness::write_u64(parser_harness, type_reference.first_row);
        ParserHarness::write_byte(parser_harness, ParserHarness::flag(type_reference.has_lifetime));
        transition type_reference.has_lifetime {
            true -> parse_type_tag(parser_harness, output, type_reference, index)
            _ -> parse_type_untagged(parser_harness, output, type_reference, index)
        }
    }

    state parse_type_tag(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64
    )
    requires index <= 65535
    {
        ParserHarness::write_source_span(parser_harness, type_reference.lifetime.source_span);
        transition { _ -> parse_type_lifetime_counts(parser_harness, output, type_reference, index) }
    }

    // An untagged row reports a zero lifetime span, as an unqualified row
    // reports a zero domain span.
    state parse_type_untagged(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64
    )
    requires index <= 65535
    {
        ParserHarness::write_u64(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        transition { _ -> parse_type_lifetime_counts(parser_harness, output, type_reference, index) }
    }

    state parse_type_lifetime_counts(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        type_reference: TypeReference,
        index: u64
    )
    requires index <= 65535
    {
        ParserHarness::write_u64(parser_harness, type_reference.first_lifetime);
        ParserHarness::write_u64(parser_harness, type_reference.lifetime_count);
        let next: u64 = index + 1;
        transition next < output.type_reference_count {
            true -> parse_type_reference_bound(parser_harness, output, next)
            _ -> parse_type_argument_count(parser_harness, output)
        }
    }

    state parse_type_reference_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 65536 {
            true -> parse_type_reference(parser_harness, output, next)
            _ -> parse_type_argument_count(parser_harness, output)
        }
    }

    state parse_type_argument_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.type_argument_count as u64 in Trapping);
        transition { _ -> parse_type_argument(parser_harness, output, 0) }
    }

    state parse_type_argument(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64) {
        transition index < output.type_argument_count {
            true -> parse_type_argument_bound(parser_harness, output, index)
            _ -> parse_type_lifetime_count(parser_harness, output)
        }
    }

    state parse_type_argument_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64) {
        transition index < 1024 {
            true -> parse_type_argument_row(parser_harness, output, index)
            _ -> parse_type_lifetime_count(parser_harness, output)
        }
    }

    state parse_type_lifetime_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.type_lifetime_count as u64 in Trapping);
        transition { _ -> parse_type_lifetime(parser_harness, output, 0) }
    }

    state parse_type_lifetime(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64) {
        transition index < output.type_lifetime_count && index < 1024 {
            true -> parse_type_lifetime_row(parser_harness, output, index)
            _ -> parse_generic_count(parser_harness, output)
        }
    }

    state parse_type_lifetime_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 1023
    {
        let tag: IdentifierSpan = output.type_lifetimes[index];
        ParserHarness::write_source_span(parser_harness, tag.source_span);
        transition { _ -> parse_type_lifetime(parser_harness, output, index + 1) }
    }

    state parse_type_argument_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 1023
    {
        ParserHarness::write_u64(parser_harness, output.type_arguments[index] as u64 in Trapping);
        transition { _ -> parse_type_argument(parser_harness, output, index + 1) }
    }

    state parse_generic_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.generic_parameter_count as u64 in Trapping);
        transition output.generic_parameter_count > 0 {
            true -> parse_generic_parameter(parser_harness, output, 0)
            _ -> parse_done()
        }
    }

    state parse_generic_parameter(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64)
    requires index <= 255
    {
        let parameter: GenericParameter = output.generic_parameters[index];
        transition parameter.kind {
            GenericParameterKind::Lifetime -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 1)
            GenericParameterKind::Type -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 2)
            GenericParameterKind::Const -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 3)
            GenericParameterKind::Value -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 4)
            GenericParameterKind::Machine -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 5)
            GenericParameterKind::Proposition -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 6)
            GenericParameterKind::Evidence -> parse_generic_parameter_kind(parser_harness, output, parameter, index, 7)
        }
    }

    state parse_generic_parameter_kind(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        parameter: GenericParameter,
        index: u64,
        kind: u8
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, kind);
        transition { _ -> parse_generic_parameter_name(parser_harness, output, parameter, index) }
    }

    state parse_generic_parameter_name(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        parameter: GenericParameter,
        index: u64
    )
    requires index <= 255
    {
        ParserHarness::write_source_span(parser_harness, parameter.name.source_span);
        transition parameter.has_type_reference {
            true -> parse_generic_parameter_typed(parser_harness, output, parameter, index)
            _ -> parse_generic_parameter_untyped(parser_harness, output, parameter, index)
        }
    }

    state parse_generic_parameter_typed(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        parameter: GenericParameter,
        index: u64
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, 1);
        ParserHarness::write_u64(parser_harness, parameter.type_reference);
        transition { _ -> parse_generic_parameter_bounds(parser_harness, output, parameter, index) }
    }

    state parse_generic_parameter_untyped(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        parameter: GenericParameter,
        index: u64
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        transition { _ -> parse_generic_parameter_bounds(parser_harness, output, parameter, index) }
    }

    state parse_generic_parameter_bounds(parser_harness: &mut ParserHarness, output: &SyntaxTrees, parameter: GenericParameter,
        index: u64
    )
    requires index <= 255
    {
        transition parameter.bounds {
            DataMultiplicity::Affine -> parse_generic_parameter_bounded(parser_harness, output, parameter, index, 0)
            DataMultiplicity::Unrestricted -> parse_generic_parameter_bounded(parser_harness, output, parameter, index, 1)
            DataMultiplicity::Linear -> parse_generic_parameter_bounded(parser_harness, output, parameter, index, 2)
        }
    }

    state parse_generic_parameter_bounded(
        parser_harness: &mut ParserHarness, output: &SyntaxTrees,
        parameter: GenericParameter,
        index: u64,
        bounds: u8
    )
    requires index <= 255
    {
        ParserHarness::write_byte(parser_harness, bounds);
        ParserHarness::write_source_span(parser_harness, parameter.source_span);
        let next: u64 = index + 1;
        transition next < output.generic_parameter_count {
            true -> parse_generic_parameter_bound(parser_harness, output, next)
            _ -> parse_done()
        }
    }

    state parse_generic_parameter_bound(parser_harness: &mut ParserHarness, output: &SyntaxTrees, next: u64) {
        transition next < 256 {
            true -> parse_generic_parameter(parser_harness, output, next)
            _ -> parse_done()
        }
    }

    state parse_done() { }
}

// The machine, parameter and state tables follow the generic parameters.
// Machine rows carry the owner flag and span, the name, the generic-parameter
// range, the parameter range, the return-type flag and handle, the clause
// range, the entry statement range, the state range, the body flag, the
// expression range, the visibility flag, the span, the target flag and span,
// the boundary flag and the container tag (0 root, 1 trait, 2 conformance).
// Parameter rows carry the name,
// type-reference handle and span. State rows carry the name, parameter range,
// return-type flag and handle, statement range and span.
machine ParserHarness::write_machine_tables(parser_harness: &mut ParserHarness, output: &SyntaxTrees)
reaches Console
crashes Trap
{
    ParserHarness::write_u64(parser_harness, output.machine_count as u64 in Trapping);
    transition { _ -> machine_row(parser_harness, output, 0) }

    state machine_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.machine_count {
            true -> write_machine(parser_harness, output, index)
            _ -> parameter_count(parser_harness, output)
        }
    }

    state write_machine(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(output, index);
        ParserHarness::write_flag(parser_harness, item.has_owner);
        ParserHarness::write_source_span(parser_harness, item.owner.source_span);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count);
        ParserHarness::write_u64(parser_harness, item.first_parameter);
        ParserHarness::write_u64(parser_harness, item.parameter_count);
        ParserHarness::write_flag(parser_harness, item.has_return_type);
        ParserHarness::write_u64(parser_harness, item.return_type);
        ParserHarness::write_u64(parser_harness, item.first_clause);
        ParserHarness::write_u64(parser_harness, item.clause_count);
        ParserHarness::write_u64(parser_harness, item.first_statement);
        ParserHarness::write_u64(parser_harness, item.statement_count);
        ParserHarness::write_u64(parser_harness, item.first_state);
        ParserHarness::write_u64(parser_harness, item.state_count);
        ParserHarness::write_flag(parser_harness, item.has_body);
        ParserHarness::write_u64(parser_harness, item.first_expression);
        ParserHarness::write_u64(parser_harness, item.expression_count);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        ParserHarness::write_flag(parser_harness, item.has_target);
        ParserHarness::write_source_span(parser_harness, item.target.source_span);
        ParserHarness::write_flag(parser_harness, item.is_boundary);
        transition item.container {
            MachineContainer::Root -> machine_container(parser_harness, output, index, item, 0)
            MachineContainer::Trait -> machine_container(parser_harness, output, index, item, 1)
            MachineContainer::Conformance -> machine_container(parser_harness, output, index, item, 2)
            MachineContainer::Refinement -> machine_container(parser_harness, output, index, item, 3)
            MachineContainer::Measure -> machine_container(parser_harness, output, index, item, 4)
        }
    }

    state machine_container(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, tag: u8) {
        ParserHarness::write_byte(parser_harness, tag);
        transition item.operator {
            OperatorToken::None -> machine_token(parser_harness, output, index, item, 0)
            OperatorToken::Add -> machine_token(parser_harness, output, index, item, 1)
            OperatorToken::Subtract -> machine_token(parser_harness, output, index, item, 2)
            OperatorToken::Multiply -> machine_token(parser_harness, output, index, item, 3)
            OperatorToken::Divide -> machine_token(parser_harness, output, index, item, 4)
            OperatorToken::Modulo -> machine_token(parser_harness, output, index, item, 5)
            OperatorToken::Equal -> machine_token(parser_harness, output, index, item, 6)
            OperatorToken::NotEqual -> machine_token(parser_harness, output, index, item, 7)
            OperatorToken::Less -> machine_token(parser_harness, output, index, item, 8)
            OperatorToken::LessEqual -> machine_token(parser_harness, output, index, item, 9)
            OperatorToken::Greater -> machine_token(parser_harness, output, index, item, 10)
            OperatorToken::GreaterEqual -> machine_token(parser_harness, output, index, item, 11)
            OperatorToken::Index -> machine_token(parser_harness, output, index, item, 12)
            OperatorToken::Range -> machine_token(parser_harness, output, index, item, 13)
        }
    }

    state machine_token(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, tag: u8) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_source_span(parser_harness, item.token.source_span);
        ParserHarness::write_u64(parser_harness, item.first_contract);
        ParserHarness::write_u64(parser_harness, item.contract_count);
        ParserHarness::write_flag(parser_harness, item.every_requirement);
        ParserHarness::write_u64(parser_harness, item.first_component);
        ParserHarness::write_u64(parser_harness, item.component_count);
        transition { _ -> machine_row(parser_harness, output, index + 1) }
    }

    state parameter_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.parameter_count as u64 in Trapping);
        transition { _ -> parameter_row(parser_harness, output, 0) }
    }

    state parameter_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.parameter_count {
            true -> write_parameter(parser_harness, output, index)
            _ -> state_count(parser_harness, output)
        }
    }

    state write_parameter(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let parameter: Parameter = SyntaxTrees::parameter(output, index);
        ParserHarness::write_source_span(parser_harness, parameter.name.source_span);
        ParserHarness::write_u64(parser_harness, parameter.type_reference);
        ParserHarness::write_source_span(parser_harness, parameter.source_span);
        transition { _ -> parameter_row(parser_harness, output, index + 1) }
    }

    state state_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.state_count as u64 in Trapping);
        transition { _ -> state_row(parser_harness, output, 0) }
    }

    state state_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.state_count {
            true -> write_state(parser_harness, output, index)
            _ -> bodies(parser_harness, output)
        }
    }

    state bodies(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_body_tables(parser_harness, output);
    }

    state write_state(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: StateItem = SyntaxTrees::state_item(output, index);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_parameter);
        ParserHarness::write_u64(parser_harness, item.parameter_count);
        ParserHarness::write_flag(parser_harness, item.has_return_type);
        ParserHarness::write_u64(parser_harness, item.return_type);
        ParserHarness::write_u64(parser_harness, item.first_clause);
        ParserHarness::write_u64(parser_harness, item.clause_count);
        ParserHarness::write_u64(parser_harness, item.first_statement);
        ParserHarness::write_u64(parser_harness, item.statement_count);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        transition { _ -> state_row(parser_harness, output, index + 1) }
    }

    state done() {}
}


// Body tables follow the states: expressions (kind and operator tags, left,
// right, range first and count, flag, name span, type-reference handle,
// span; a Name's identifier is its name span and its range is zero, a Path's
// range covers its members and its name span is zero), call arguments (expression handles), construction fields (name,
// value handle, span), statements (kind tag, name, mutability, type handle,
// value flag and handle, assignment target, crash cause tag, arm range,
// span), transition arms (pattern kind tag, pattern handle, field range,
// target kind tag (1 call, 2 value, 3 unit), target handle, span), pattern
// fields (name, value flag and handle, span, rename flag and span, waived
// flag) and machine clauses (kind tag, member range, crash cause tag,
// expression handle, span, expression flag, argument range, label flag and
// span).
machine ParserHarness::write_body_tables(parser_harness: &mut ParserHarness, output: &SyntaxTrees)
reaches Console
crashes Trap
{
    ParserHarness::write_u64(parser_harness, output.expression_count as u64 in Trapping);
    transition { _ -> expression_row(parser_harness, output, 0) }

    state expression_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.expression_count {
            true -> write_expression(parser_harness, output, index)
            _ -> argument_count(parser_harness, output)
        }
    }

    state write_expression(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(output, index);
        transition expression.kind {
            ExpressionKind::Name -> expression_kind(parser_harness, output, index, expression, 1)
            ExpressionKind::Path -> expression_kind(parser_harness, output, index, expression, 2)
            ExpressionKind::Integer -> expression_kind(parser_harness, output, index, expression, 3)
            ExpressionKind::Boolean -> expression_kind(parser_harness, output, index, expression, 4)
            ExpressionKind::String -> expression_kind(parser_harness, output, index, expression, 5)
            ExpressionKind::Field -> expression_kind(parser_harness, output, index, expression, 6)
            ExpressionKind::Index -> expression_kind(parser_harness, output, index, expression, 7)
            ExpressionKind::Unary -> expression_kind(parser_harness, output, index, expression, 8)
            ExpressionKind::Binary -> expression_kind(parser_harness, output, index, expression, 9)
            ExpressionKind::Cast -> expression_kind(parser_harness, output, index, expression, 10)
            ExpressionKind::Call -> expression_kind(parser_harness, output, index, expression, 11)
            ExpressionKind::Construct -> expression_kind(parser_harness, output, index, expression, 12)
            ExpressionKind::Apply -> expression_kind(parser_harness, output, index, expression, 13)
            ExpressionKind::Float -> expression_kind(parser_harness, output, index, expression, 14)
            ExpressionKind::Membership -> expression_kind(parser_harness, output, index, expression, 15)
            ExpressionKind::Match -> expression_kind(parser_harness, output, index, expression, 16)
            ExpressionKind::Range -> expression_kind(parser_harness, output, index, expression, 17)
            ExpressionKind::Array -> expression_kind(parser_harness, output, index, expression, 18)
        }
    }

    state expression_kind(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        transition expression.operator {
            OperatorKind::None -> expression_operator(parser_harness, output, index, expression, 0)
            OperatorKind::Or -> expression_operator(parser_harness, output, index, expression, 1)
            OperatorKind::And -> expression_operator(parser_harness, output, index, expression, 2)
            OperatorKind::Equal -> expression_operator(parser_harness, output, index, expression, 3)
            OperatorKind::NotEqual -> expression_operator(parser_harness, output, index, expression, 4)
            OperatorKind::Less -> expression_operator(parser_harness, output, index, expression, 5)
            OperatorKind::LessEqual -> expression_operator(parser_harness, output, index, expression, 6)
            OperatorKind::Greater -> expression_operator(parser_harness, output, index, expression, 7)
            OperatorKind::GreaterEqual -> expression_operator(parser_harness, output, index, expression, 8)
            OperatorKind::BitOr -> expression_operator(parser_harness, output, index, expression, 9)
            OperatorKind::BitXor -> expression_operator(parser_harness, output, index, expression, 10)
            OperatorKind::BitAnd -> expression_operator(parser_harness, output, index, expression, 11)
            OperatorKind::ShiftLeft -> expression_operator(parser_harness, output, index, expression, 12)
            OperatorKind::ShiftRight -> expression_operator(parser_harness, output, index, expression, 13)
            OperatorKind::Add -> expression_operator(parser_harness, output, index, expression, 14)
            OperatorKind::Subtract -> expression_operator(parser_harness, output, index, expression, 15)
            OperatorKind::Multiply -> expression_operator(parser_harness, output, index, expression, 16)
            OperatorKind::Divide -> expression_operator(parser_harness, output, index, expression, 17)
            OperatorKind::Modulo -> expression_operator(parser_harness, output, index, expression, 18)
            OperatorKind::Not -> expression_operator(parser_harness, output, index, expression, 19)
            OperatorKind::Negate -> expression_operator(parser_harness, output, index, expression, 20)
            OperatorKind::BitNot -> expression_operator(parser_harness, output, index, expression, 21)
            OperatorKind::Borrow -> expression_operator(parser_harness, output, index, expression, 22)
            OperatorKind::BorrowMutable -> expression_operator(parser_harness, output, index, expression, 23)
            OperatorKind::Suspend -> expression_operator(parser_harness, output, index, expression, 24)
            OperatorKind::Block -> expression_operator(parser_harness, output, index, expression, 25)
            OperatorKind::SuspendBlock -> expression_operator(parser_harness, output, index, expression, 26)
            OperatorKind::BorrowWrite -> expression_operator(parser_harness, output, index, expression, 27)
        }
    }

    state expression_operator(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, expression.left);
        ParserHarness::write_u64(parser_harness, expression.right);
        ParserHarness::write_u64(parser_harness, expression.first);
        ParserHarness::write_u64(parser_harness, expression.count);
        ParserHarness::write_flag(parser_harness, expression.flag);
        ParserHarness::write_source_span(parser_harness, expression.name.source_span);
        ParserHarness::write_u64(parser_harness, expression.type_reference);
        ParserHarness::write_source_span(parser_harness, expression.source_span);
        transition { _ -> expression_row(parser_harness, output, index + 1) }
    }

    state argument_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.argument_count as u64 in Trapping);
        transition { _ -> argument_row(parser_harness, output, 0) }
    }

    state argument_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.argument_count {
            true -> write_argument(parser_harness, output, index)
            _ -> field_count(parser_harness, output)
        }
    }

    state write_argument(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let argument: u64 in Trapping = SyntaxTrees::argument(output, index);
        ParserHarness::write_u64(parser_harness, argument);
        transition { _ -> argument_row(parser_harness, output, index + 1) }
    }

    state field_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.construct_field_count as u64 in Trapping);
        transition { _ -> field_row(parser_harness, output, 0) }
    }

    state field_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.construct_field_count {
            true -> write_field(parser_harness, output, index)
            _ -> statement_count(parser_harness, output)
        }
    }

    state write_field(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let field: ConstructField = SyntaxTrees::construct_field(output, index);
        ParserHarness::write_source_span(parser_harness, field.name.source_span);
        ParserHarness::write_u64(parser_harness, field.value);
        ParserHarness::write_source_span(parser_harness, field.source_span);
        transition { _ -> field_row(parser_harness, output, index + 1) }
    }

    state statement_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.statement_count as u64 in Trapping);
        transition { _ -> statement_row(parser_harness, output, 0) }
    }

    state statement_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.statement_count {
            true -> write_statement(parser_harness, output, index)
            _ -> arm_count(parser_harness, output)
        }
    }

    state write_statement(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let statement: Statement = SyntaxTrees::statement(output, index);
        transition statement.kind {
            StatementKind::Let -> statement_kind(parser_harness, output, index, statement, 1)
            StatementKind::Assign -> statement_kind(parser_harness, output, index, statement, 2)
            StatementKind::Expression -> statement_kind(parser_harness, output, index, statement, 3)
            StatementKind::Tail -> statement_kind(parser_harness, output, index, statement, 4)
            StatementKind::Crash -> statement_kind(parser_harness, output, index, statement, 5)
            StatementKind::Transition -> statement_kind(parser_harness, output, index, statement, 6)
            StatementKind::Discard -> statement_kind(parser_harness, output, index, statement, 7)
        }
    }

    state statement_kind(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        statement: Statement,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_source_span(parser_harness, statement.name.source_span);
        ParserHarness::write_flag(parser_harness, statement.is_mutable);
        ParserHarness::write_u64(parser_harness, statement.type_reference);
        ParserHarness::write_flag(parser_harness, statement.has_value);
        ParserHarness::write_u64(parser_harness, statement.value);
        ParserHarness::write_u64(parser_harness, statement.target);
        transition statement.cause {
            CrashCause::Trap -> statement_cause(parser_harness, output, index, statement, 1)
            CrashCause::Abort -> statement_cause(parser_harness, output, index, statement, 2)
        }
    }

    state statement_cause(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        statement: Statement,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, statement.first_arm);
        ParserHarness::write_u64(parser_harness, statement.arm_count);
        ParserHarness::write_source_span(parser_harness, statement.source_span);
        transition { _ -> statement_row(parser_harness, output, index + 1) }
    }

    state arm_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.arm_count as u64 in Trapping);
        transition { _ -> arm_row(parser_harness, output, 0) }
    }

    state arm_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.arm_count {
            true -> write_arm(parser_harness, output, index)
            _ -> pattern_field_count(parser_harness, output)
        }
    }

    state write_arm(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let arm: TransitionArm = SyntaxTrees::arm(output, index);
        transition arm.kind {
            ArmPatternKind::Guard -> arm_kind(parser_harness, output, index, arm, 1)
            ArmPatternKind::Wildcard -> arm_kind(parser_harness, output, index, arm, 2)
            ArmPatternKind::Literal -> arm_kind(parser_harness, output, index, arm, 3)
            ArmPatternKind::Case -> arm_kind(parser_harness, output, index, arm, 4)
        }
    }

    state arm_kind(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        arm: TransitionArm,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, arm.pattern);
        ParserHarness::write_u64(parser_harness, arm.first_field);
        ParserHarness::write_u64(parser_harness, arm.field_count);
        transition arm.target_kind {
            ArmTargetKind::Call -> arm_target(parser_harness, output, index, arm, 1)
            ArmTargetKind::Value -> arm_target(parser_harness, output, index, arm, 2)
            ArmTargetKind::Unit -> arm_target(parser_harness, output, index, arm, 3)
        }
    }

    state arm_target(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        arm: TransitionArm,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, arm.target);
        ParserHarness::write_source_span(parser_harness, arm.source_span);
        transition { _ -> arm_row(parser_harness, output, index + 1) }
    }

    state pattern_field_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.pattern_field_count as u64 in Trapping);
        transition { _ -> pattern_field_row(parser_harness, output, 0) }
    }

    state pattern_field_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.pattern_field_count {
            true -> write_pattern_field(parser_harness, output, index)
            _ -> clause_count(parser_harness, output)
        }
    }

    state clause_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.clause_count as u64 in Trapping);
        transition { _ -> clause_row(parser_harness, output, 0) }
    }

    state clause_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.clause_count {
            true -> write_clause(parser_harness, output, index)
            _ -> done()
        }
    }

    state write_clause(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let clause: Clause = SyntaxTrees::clause(output, index);
        transition clause.kind {
            ClauseKind::Reaches -> clause_kind(parser_harness, output, index, clause, 1)
            ClauseKind::Invokes -> clause_kind(parser_harness, output, index, clause, 2)
            ClauseKind::Suspends -> clause_kind(parser_harness, output, index, clause, 3)
            ClauseKind::Blocks -> clause_kind(parser_harness, output, index, clause, 4)
            ClauseKind::Crashes -> clause_kind(parser_harness, output, index, clause, 5)
            ClauseKind::Requires -> clause_kind(parser_harness, output, index, clause, 6)
            ClauseKind::Ensures -> clause_kind(parser_harness, output, index, clause, 7)
            ClauseKind::Where -> clause_kind(parser_harness, output, index, clause, 8)
            ClauseKind::Satisfies -> clause_kind(parser_harness, output, index, clause, 9)
            ClauseKind::Terminates -> clause_kind(parser_harness, output, index, clause, 10)
        }
    }

    state clause_kind(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        clause: Clause,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, clause.first_member);
        ParserHarness::write_u64(parser_harness, clause.member_count);
        transition clause.cause {
            CrashCause::Trap -> clause_cause(parser_harness, output, index, clause, 1)
            CrashCause::Abort -> clause_cause(parser_harness, output, index, clause, 2)
        }
    }

    state clause_cause(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        clause: Clause,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, clause.expression);
        ParserHarness::write_source_span(parser_harness, clause.source_span);
        ParserHarness::write_flag(parser_harness, clause.has_expression);
        ParserHarness::write_u64(parser_harness, clause.first_argument);
        ParserHarness::write_u64(parser_harness, clause.argument_count);
        ParserHarness::write_flag(parser_harness, clause.has_label);
        ParserHarness::write_source_span(parser_harness, clause.label.source_span);
        transition { _ -> clause_row(parser_harness, output, index + 1) }
    }

    state write_pattern_field(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let field: PatternField = SyntaxTrees::pattern_field(output, index);
        ParserHarness::write_source_span(parser_harness, field.name.source_span);
        ParserHarness::write_flag(parser_harness, field.has_value);
        ParserHarness::write_u64(parser_harness, field.value);
        ParserHarness::write_source_span(parser_harness, field.source_span);
        ParserHarness::write_flag(parser_harness, field.has_rename);
        ParserHarness::write_source_span(parser_harness, field.rename.source_span);
        ParserHarness::write_flag(parser_harness, field.is_waived);
        transition { _ -> pattern_field_row(parser_harness, output, index + 1) }
    }

    state done() {}
}

// The declaration tables follow the clauses: name paths (member range,
// span), traits (name, generic range, parent range, machine range, boundary
// and visibility flags, span, contract range, refinement flag, base type
// handle), trait parents (type handles), conformances
// (name, generic range, trait type handle, machine range, row range,
// visibility flag, span), conformance rows (requirement and target path
// handles, span), domains (carrier type handle, name, index argument range,
// generic range, subject flag and span, clause range, route range, alias
// flag, constituent range, visibility flag, span), constants (owner flag and
// span, name, type handle, value handle, visibility flag, span) and
// propositions (name, generic range, parameter range, body tag 1 primitive,
// 2 evidence or 3 transparent, evidence type handle, fact handle, visibility
// flag, span), then contracts (kind tag 1 machine or 2 proposition, name,
// generic range, parameter range, return flag and handle, clause range,
// span), value-position match arms (pattern kind tag, pattern handle, value
// handle, span) and definitions (name, generic range, parameter range,
// result type handle, term flag and handle, boundary and visibility flags,
// span).
machine ParserHarness::write_declaration_tables(parser_harness: &mut ParserHarness, output: &SyntaxTrees)
reaches Console
crashes Trap
{
    ParserHarness::write_u64(parser_harness, output.name_path_count as u64 in Trapping);
    transition { _ -> path_row(parser_harness, output, 0) }

    state path_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.name_path_count {
            true -> write_path(parser_harness, output, index)
            _ -> trait_count(parser_harness, output)
        }
    }

    state write_path(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let path: NamePath = SyntaxTrees::name_path(output, index);
        ParserHarness::write_u64(parser_harness, path.first_member);
        ParserHarness::write_u64(parser_harness, path.member_count);
        ParserHarness::write_source_span(parser_harness, path.source_span);
        transition { _ -> path_row(parser_harness, output, index + 1) }
    }

    state trait_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.trait_count as u64 in Trapping);
        transition { _ -> trait_row(parser_harness, output, 0) }
    }

    state trait_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.trait_count {
            true -> write_trait(parser_harness, output, index)
            _ -> parent_count(parser_harness, output)
        }
    }

    state write_trait(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: TraitItem = SyntaxTrees::trait_item(output, index);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count);
        ParserHarness::write_u64(parser_harness, item.first_parent);
        ParserHarness::write_u64(parser_harness, item.parent_count);
        ParserHarness::write_u64(parser_harness, item.first_machine);
        ParserHarness::write_u64(parser_harness, item.machine_count);
        ParserHarness::write_flag(parser_harness, item.is_boundary);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        ParserHarness::write_u64(parser_harness, item.first_contract);
        ParserHarness::write_u64(parser_harness, item.contract_count);
        ParserHarness::write_flag(parser_harness, item.is_refinement);
        ParserHarness::write_u64(parser_harness, item.base);
        transition { _ -> trait_row(parser_harness, output, index + 1) }
    }

    state parent_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.trait_parent_count as u64 in Trapping);
        transition { _ -> parent_row(parser_harness, output, 0) }
    }

    state parent_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.trait_parent_count {
            true -> write_parent(parser_harness, output, index)
            _ -> conformance_count(parser_harness, output)
        }
    }

    state write_parent(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let parent: u64 in Trapping = SyntaxTrees::trait_parent(output, index);
        ParserHarness::write_u64(parser_harness, parent);
        transition { _ -> parent_row(parser_harness, output, index + 1) }
    }

    state conformance_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.conformance_count as u64 in Trapping);
        transition { _ -> conformance_row(parser_harness, output, 0) }
    }

    state conformance_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.conformance_count {
            true -> write_conformance(parser_harness, output, index)
            _ -> reference_row_count(parser_harness, output)
        }
    }

    state write_conformance(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConformanceItem = SyntaxTrees::conformance_item(output, index);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count);
        ParserHarness::write_u64(parser_harness, item.trait_type);
        ParserHarness::write_u64(parser_harness, item.first_machine);
        ParserHarness::write_u64(parser_harness, item.machine_count);
        ParserHarness::write_u64(parser_harness, item.first_row);
        ParserHarness::write_u64(parser_harness, item.row_count);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        transition { _ -> conformance_row(parser_harness, output, index + 1) }
    }

    state reference_row_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.conformance_row_count as u64 in Trapping);
        transition { _ -> reference_row(parser_harness, output, 0) }
    }

    state reference_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.conformance_row_count {
            true -> write_reference_row(parser_harness, output, index)
            _ -> domain_count(parser_harness, output)
        }
    }

    state write_reference_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let row: ConformanceRow = SyntaxTrees::conformance_row(output, index);
        ParserHarness::write_u64(parser_harness, row.requirement);
        ParserHarness::write_u64(parser_harness, row.target);
        ParserHarness::write_source_span(parser_harness, row.source_span);
        transition { _ -> reference_row(parser_harness, output, index + 1) }
    }

    state domain_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.domain_count as u64 in Trapping);
        transition { _ -> domain_row(parser_harness, output, 0) }
    }

    state domain_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.domain_count {
            true -> write_domain(parser_harness, output, index)
            _ -> constant_count(parser_harness, output)
        }
    }

    state write_domain(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(output, index);
        ParserHarness::write_u64(parser_harness, item.carrier);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_argument);
        ParserHarness::write_u64(parser_harness, item.argument_count);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count);
        ParserHarness::write_flag(parser_harness, item.has_subject);
        ParserHarness::write_source_span(parser_harness, item.subject.source_span);
        ParserHarness::write_u64(parser_harness, item.first_clause);
        ParserHarness::write_u64(parser_harness, item.clause_count);
        ParserHarness::write_u64(parser_harness, item.first_route);
        ParserHarness::write_u64(parser_harness, item.route_count);
        ParserHarness::write_flag(parser_harness, item.is_alias);
        ParserHarness::write_u64(parser_harness, item.first_constituent);
        ParserHarness::write_u64(parser_harness, item.constituent_count);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        transition { _ -> domain_row(parser_harness, output, index + 1) }
    }

    state constant_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.constant_count as u64 in Trapping);
        transition { _ -> constant_row(parser_harness, output, 0) }
    }

    state constant_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.constant_count {
            true -> write_constant(parser_harness, output, index)
            _ -> proposition_count(parser_harness, output)
        }
    }

    state write_constant(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConstantItem = SyntaxTrees::constant_item(output, index);
        ParserHarness::write_flag(parser_harness, item.has_owner);
        ParserHarness::write_source_span(parser_harness, item.owner.source_span);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.type_reference);
        ParserHarness::write_u64(parser_harness, item.value);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        transition { _ -> constant_row(parser_harness, output, index + 1) }
    }

    state proposition_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.proposition_count as u64 in Trapping);
        transition { _ -> proposition_row(parser_harness, output, 0) }
    }

    state proposition_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.proposition_count {
            true -> write_proposition(parser_harness, output, index)
            _ -> contract_count(parser_harness, output)
        }
    }

    state contract_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.contract_count as u64 in Trapping);
        transition { _ -> contract_row(parser_harness, output, 0) }
    }

    state contract_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.contract_count {
            true -> write_contract(parser_harness, output, index)
            _ -> match_arm_count(parser_harness, output)
        }
    }

    state write_contract(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let contract: Contract = SyntaxTrees::contract(output, index);
        transition contract.kind {
            ContractKind::Machine -> contract_kind(parser_harness, output, index, contract, 1)
            ContractKind::Proposition -> contract_kind(parser_harness, output, index, contract, 2)
        }
    }

    state contract_kind(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping, contract: Contract, tag: u8) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_source_span(parser_harness, contract.name.source_span);
        ParserHarness::write_u64(parser_harness, contract.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, contract.generic_parameter_count);
        ParserHarness::write_u64(parser_harness, contract.first_parameter);
        ParserHarness::write_u64(parser_harness, contract.parameter_count);
        ParserHarness::write_flag(parser_harness, contract.has_return_type);
        ParserHarness::write_u64(parser_harness, contract.return_type);
        ParserHarness::write_u64(parser_harness, contract.first_clause);
        ParserHarness::write_u64(parser_harness, contract.clause_count);
        ParserHarness::write_source_span(parser_harness, contract.source_span);
        transition { _ -> contract_row(parser_harness, output, index + 1) }
    }

    state match_arm_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.match_arm_count as u64 in Trapping);
        transition { _ -> match_arm_row(parser_harness, output, 0) }
    }

    state match_arm_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.match_arm_count {
            true -> write_match_arm(parser_harness, output, index)
            _ -> definition_count(parser_harness, output)
        }
    }

    state write_match_arm(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let arm: TransitionArm = SyntaxTrees::match_arm(output, index);
        transition arm.kind {
            ArmPatternKind::Guard -> match_arm_kind(parser_harness, output, index, arm, 1)
            ArmPatternKind::Wildcard -> match_arm_kind(parser_harness, output, index, arm, 2)
            ArmPatternKind::Literal -> match_arm_kind(parser_harness, output, index, arm, 3)
            ArmPatternKind::Case -> match_arm_kind(parser_harness, output, index, arm, 4)
        }
    }

    state match_arm_kind(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping, arm: TransitionArm, tag: u8) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, arm.pattern);
        ParserHarness::write_u64(parser_harness, arm.target);
        ParserHarness::write_source_span(parser_harness, arm.source_span);
        transition { _ -> match_arm_row(parser_harness, output, index + 1) }
    }

    state definition_count(parser_harness: &mut ParserHarness, output: &SyntaxTrees) {
        ParserHarness::write_u64(parser_harness, output.definition_count as u64 in Trapping);
        transition { _ -> definition_row(parser_harness, output, 0) }
    }

    state definition_row(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        transition index < output.definition_count {
            true -> write_definition(parser_harness, output, index)
            _ -> done()
        }
    }

    state write_definition(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: DefinitionItem = SyntaxTrees::definition_item(output, index);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count);
        ParserHarness::write_u64(parser_harness, item.first_parameter);
        ParserHarness::write_u64(parser_harness, item.parameter_count);
        ParserHarness::write_u64(parser_harness, item.result_type);
        ParserHarness::write_flag(parser_harness, item.has_term);
        ParserHarness::write_u64(parser_harness, item.term);
        ParserHarness::write_flag(parser_harness, item.is_boundary);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        transition { _ -> definition_row(parser_harness, output, index + 1) }
    }

    state write_proposition(parser_harness: &mut ParserHarness, output: &SyntaxTrees, index: u64 in Trapping) {
        let item: PropositionItem = SyntaxTrees::proposition_item(output, index);
        ParserHarness::write_source_span(parser_harness, item.name.source_span);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count);
        ParserHarness::write_u64(parser_harness, item.first_parameter);
        ParserHarness::write_u64(parser_harness, item.parameter_count);
        transition item.body {
            PropositionBody::Primitive -> proposition_body(parser_harness, output, index, item, 1)
            PropositionBody::Evidence -> proposition_body(parser_harness, output, index, item, 2)
            PropositionBody::Transparent -> proposition_body(parser_harness, output, index, item, 3)
        }
    }

    state proposition_body(
        parser_harness: &mut ParserHarness,
        output: &SyntaxTrees,
        index: u64 in Trapping,
        item: PropositionItem,
        tag: u8
    ) {
        ParserHarness::write_byte(parser_harness, tag);
        ParserHarness::write_u64(parser_harness, item.evidence);
        ParserHarness::write_u64(parser_harness, item.fact);
        ParserHarness::write_flag(parser_harness, item.is_public);
        ParserHarness::write_source_span(parser_harness, item.source_span);
        transition { _ -> proposition_row(parser_harness, output, index + 1) }
    }

    state done() {}
}

machine ParserHarness::write_flag(parser_harness: &mut ParserHarness, value: bool) reaches Console {
    transition value {
        true -> set(parser_harness)
        _ -> clear(parser_harness)
    }

    state set(parser_harness: &mut ParserHarness) {
        ParserHarness::write_byte(parser_harness, 1);
    }

    state clear(parser_harness: &mut ParserHarness) {
        ParserHarness::write_byte(parser_harness, 0);
    }
}

machine ParserHarness::write_source_span(parser_harness: &mut ParserHarness, source_span: SourceSpan) reaches Console {
    ParserHarness::write_u64(parser_harness, source_span.source.value as u64 in Trapping);
    ParserHarness::write_u64(parser_harness, source_span.span.start);
    ParserHarness::write_u64(parser_harness, source_span.span.end);
}

machine ParserHarness::write_u64(parser_harness: &mut ParserHarness, value: u64 in Trapping) reaches Console {
    ParserHarness::write_byte(parser_harness, (value % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 256 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 65536 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 16777216 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 4294967296 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 1099511627776 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 281474976710656 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 72057594037927936 % 256) as u8);
}

machine ParserHarness::write_byte(parser_harness: &mut ParserHarness, value: u8) reaches Console {
    let mut output: u8 = value;
    parser_harness.console.write_byte(output as i32);
}

// One byte for a flag.
machine ParserHarness::flag(value: bool) -> u8 {
    transition value {
        true -> one()
        _ -> zero()
    }

    state one() -> u8 {
        1
    }

    state zero() -> u8 {
        0
    }
}
