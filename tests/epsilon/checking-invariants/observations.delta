; Private checker-candidate codec, not a source-admission observation.
(def checking_invariant_u32 ((value Int)) Bytes
  (bytes_concat
    (bytes_concat (bytes_single (% value 256))
      (bytes_single (% (/ value 256) 256)))
    (bytes_concat (bytes_single (% (/ value 65536) 256))
      (bytes_single (% (/ value 16777216) 256)))))

(def checking_invariant_observe ((candidate EpsilonTypeFormationCandidate)) Bytes
  (match candidate
    (NoEpsilonTypeFormationCandidate (bytes_single 0))
    ((EpsilonTypeFormationCandidateAt reasonValue offset)
      (bytes_concat (bytes_single 1)
        (bytes_concat (bytes_single (epsilon_reject_reason_identity reasonValue))
          (checking_invariant_u32 offset))))
    ((EpsilonTypeFormationConflict offset)
      (bytes_concat (bytes_single 2) (checking_invariant_u32 offset)))))
