boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Cell { value: i32; }
data Main { console: Console; cells: [Cell; 2]; }

machine Main::main(&mut self) {
  self.cells[0].value = 65;
  let view: &[Cell] = self.cells.as_slice;
  assert view[0].value == 65;
  self.cells[0].value = 66;
  assert view[0].value == 66;
  assert view[1].value == 0;
  self.console.write_byte(view[0].value);
}
