boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; count: i32; }

machine Main::main(&mut self) {
  self.console.write_byte((self).echo(65));
  self.console.write_byte((self.echo)(66));
  self.console.write_byte((self.echo(67)));
  assert self.count == 3;
}

machine Main::echo(&mut self, value: i32) -> i32 {
  self.count = self.count + 1;
  return value;
}
