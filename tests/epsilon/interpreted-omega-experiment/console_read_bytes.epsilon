boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; }

machine Main::main(&mut self) {
  let first: i32 = self.console.read_byte();
  assert first == 0;
  self.console.write_byte(first);
  let second: i32 = self.read_next();
  transition 0 { 0 -> next(second) }
  state next(value: i32) {
    assert value == 128;
    self.console.write_byte(value);
    let third: i32 = self.read_next();
    assert third == 255;
    self.console.write_byte(third);
    assert self.console.read_byte() == -1;
    assert self.read_next() == -1;
    self.console.write_byte(65);
  }
}

machine Main::read_next(&mut self) -> i32 { return self.console.read_byte(); }
