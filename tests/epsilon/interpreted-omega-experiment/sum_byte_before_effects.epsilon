boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Token { case Item(marker: i32, byte: u8, position: i32); }
data Main { console: Console; cursor: i32; }

machine Main::main(&mut self) {
  self.console.write_byte(80);
  let token: Token = Token::Item(self.marker(), self.invalid_byte(), self.advance());
}
machine Main::marker(&mut self) -> i32 {
  self.console.write_byte(65);
  return 5;
}
machine Main::invalid_byte(&mut self) -> i32 {
  self.console.write_byte(66);
  return 256;
}
machine Main::advance(&mut self) -> i32 {
  self.cursor = self.cursor + 1;
  self.console.write_byte(67);
  return self.cursor;
}
