; Private development frame: u32 source length, exact source, sealed stdin.
; Splitting is authored Delta behavior, not a host parser or final edge envelope.
; Source uses a bounded view; balanced byte trees still carry sealed stdin.
(def epsilon_experiment_bytes_range ((input Bytes) (start Int) (end Int)) Bytes
  (if (eq start end)
    (bytes_empty)
    (if (eq (+ start 1) end)
      (bytes_single (bytes_get input start))
      (let middle Int (+ start (/ (- end start) 2))
        (bytes_concat
          (epsilon_experiment_bytes_range input start middle)
          (epsilon_experiment_bytes_range input middle end))))))

; Private tagged diagnostics, not the final evaluator observation envelope.
; Exit carries its full i32 bit pattern; offsets are bounded source coordinates.
(def epsilon_experiment_u32 ((value Int)) Bytes
  (bytes_concat
    (bytes_concat
      (bytes_single (% value 256))
      (bytes_single (% (/ value 256) 256)))
    (bytes_concat
      (bytes_single (% (/ value 65536) 256))
      (bytes_single (% (/ value 16777216) 256)))))

(def epsilon_experiment_observation ((source EpsilonSourceView) (input Bytes)) Bytes
  (match (epsilon_evaluate_entry_view source input)
    ((EpsilonEvaluatorSliceExit code output)
      (bytes_concat (bytes_single 0)
        (bytes_concat
          (epsilon_experiment_u32 (if (lt code 0) (+ code 4294967296) code))
          output)))
    ((EpsilonEvaluatorSliceTrap kind output)
      (bytes_concat (bytes_single 1)
        (bytes_concat (bytes_single kind) output)))
    ((EpsilonEvaluatorSliceRejected reasonValue errorOffset)
      (bytes_concat (bytes_single 2)
        (bytes_concat (bytes_single (epsilon_reject_reason_identity reasonValue))
          (epsilon_experiment_u32 errorOffset))))
    ((EpsilonEvaluatorSliceInternal errorOffset)
      (bytes_concat (bytes_single 3) (epsilon_experiment_u32 errorOffset)))))

(def main ((request Bytes)) Bytes
  (if (lt (bytes_length request) 4)
    (bytes_single 5)
    (let sourceLength Int
      (+ (+ (bytes_get request 0) (* (bytes_get request 1) 256))
         (+ (* (bytes_get request 2) 65536) (* (bytes_get request 3) 16777216)))
      (if (lt (- (bytes_length request) 4) sourceLength)
        (bytes_single 5)
        (match (epsilon_source_view request 4 sourceLength)
          (InvalidEpsilonSourceView (bytes_single 5))
          ((ValidEpsilonSourceView source)
            (epsilon_experiment_observation source
              (epsilon_experiment_bytes_range request (+ 4 sourceLength)
                (bytes_length request)))))))))
