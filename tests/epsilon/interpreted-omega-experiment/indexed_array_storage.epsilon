boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Cell { value: i32; children: [i32; 3]; }
data Main {
  console: Console;
  singleton: [i32; 1];
  odd: [i32; 5];
  empty: [i32; 5];
  distant: [i32; 2147483647];
  nested: [Cell; 5];
}

machine Main::main(&mut self) {
  assert self.singleton[0] == 0;
  self.singleton[0] = 65;
  self.singleton[0] = 66;
  assert self.singleton[0] == 66;

  self.odd[4] = 44;
  self.odd[0] = 40;
  self.odd[2] = 42;
  self.odd[4] = 45;
  assert self.odd[1] == 0;
  assert self.odd[3] == 0;
  assert self.odd[4] == 45;
  let snapshot: [i32; 5] = self.odd;
  let live: &[i32] = self.odd.as_slice;
  let frozen: &[i32] = copied(self.odd)[..];
  self.odd[2] = 52;
  assert snapshot[2] == 42;
  assert frozen[2] == 42;
  assert live[2] == 52;
  snapshot[0] = 50;
  assert self.odd[0] == 40;
  assert frozen[0] == 40;
  self.odd = self.empty;
  assert live[0] == 0;
  assert live[2] == 0;
  assert live[4] == 0;
  assert snapshot[0] == 50;
  assert frozen[4] == 45;

  self.distant[2147483646] = 71;
  self.distant[2147483645] = 72;
  self.distant[0] = 73;
  assert self.distant[2147483646] == 71;
  assert self.distant[2147483645] == 72;
  assert self.distant[2147483644] == 0;
  assert self.distant[1] == 0;
  assert self.distant[0] == 73;

  self.nested[4].children[2] = 81;
  self.nested[4].value = 82;
  self.nested[0].children[0] = 83;
  assert self.nested[4].children[2] == 81;
  assert self.nested[4].children[1] == 0;
  assert self.nested[4].value == 82;
  assert self.nested[0].children[0] == 83;
  assert self.nested[0].value == 0;
  assert self.nested[2].children[2] == 0;
  self.console.write_byte(65);
}

machine copied(value: [i32; 5]) -> [i32; 5] { return value; }
