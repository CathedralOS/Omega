boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; }

machine Main::main(&mut self) {
  let result: i32 = ordered(self.console.read_byte(), self.console.read_byte());
  assert result == 12;
  assert self.console.read_byte() == -1;
  self.console.write_byte(result + 53);
}

machine ordered(first: i32, second: i32) -> i32 { return first * 10 + second; }
