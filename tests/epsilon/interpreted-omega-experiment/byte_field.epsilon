boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main {
  console: Console;
  value: u8;
}

machine Main::main(&mut self) {
  assert self.value == 0;
  self.value = 128;
  assert self.value == 128;
  assert self.value > 0;
  self.value = self.value + 127;
  assert self.value == 255;
  let maximum: i32 = self.value;
  assert maximum + 1 == 256;
  self.value = 0;
  assert self.value == 0;
  self.value = 60 + 5;
  let output: i32 = self.value;
  self.console.write_byte(output);
}
