boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Cell { value: i32; }
data Choice { case Full(value: Cell); case Empty; }
data Main { console: Console; original: Cell; choice: Choice; }

machine Main::main(&mut self) {
  self.original.value = 64;
  self.choice = Choice::Full(self.original);
  let changed: Choice = rewrite(self.choice);
  assert read(self.choice) == 64;
  assert read(changed) == 65;
  self.console.write_byte(read(changed));
}
machine rewrite(input: Choice) -> Choice {
  transition input { Choice::Full{record} -> return change(record) Choice::Empty -> return input }
}
machine change(record: Cell) -> Choice { record.value = record.value + 1; return Choice::Full(record); }
machine read(input: Choice) -> i32 {
  transition input { Choice::Full{record} -> return record.value Choice::Empty -> return 0 }
}
