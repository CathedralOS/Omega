boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Choice { case Value(value: i32); case Empty; }
data Main { console: Console; count: i32; }

machine Main::main(&mut self) {
  transition self.choose() { Choice::Value{value} -> self.done(value) _ -> return }
}
machine Main::choose(&mut self) -> Choice {
  self.count = self.count + 1;
  self.console.write_byte(65);
  return Choice::Value(65);
}
machine Main::done(&mut self, value: i32) {
  assert self.count == 1;
  self.console.write_byte(value);
}
