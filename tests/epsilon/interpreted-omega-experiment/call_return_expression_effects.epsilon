boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; }

machine Main::main(&mut self) {
  let value: i32 = self.combine();
  assert value == 131;
  self.console.write_byte(67);
}

machine Main::combine(&mut self) -> i32 {
  return add(self.trace(65), self.trace(66));
}

machine Main::trace(&mut self, value: i32) -> i32 {
  self.console.write_byte(value);
  return value;
}

machine add(first: i32, second: i32) -> i32 { return first + second; }
