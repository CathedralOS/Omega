boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main {
  console: Console;
  first: AlphaTapeBuffer;
  second: AlphaTapeBuffer;
}

machine Main::main(&mut self) {
  self.first.initialize();
  self.second.initialize();
  assert self.first.payload_length() == 0;
  assert self.second.payload_length() == 0;
  assert self.first.bytes[0] == 0;
  assert self.second.bytes[0] == 0;
  self.first.write_reserved_word(1145258561);
  self.second.write_reserved_word(1212630597);
  assert self.first.payload_length() == 4;
  assert self.second.payload_length() == 4;
  self.first.write_reserved_word(-1);
  assert self.first.payload_length() == 8;
  assert self.second.payload_length() == 4;
  assert self.first.bytes[0] == 65;
  assert self.first.bytes[1] == 66;
  assert self.first.bytes[2] == 67;
  assert self.first.bytes[3] == 68;
  assert self.first.bytes[4] == 255;
  assert self.first.bytes[5] == 255;
  assert self.first.bytes[6] == 255;
  assert self.first.bytes[7] == 255;
  assert self.second.bytes[0] == 69;
  assert self.second.bytes[1] == 70;
  assert self.second.bytes[2] == 71;
  assert self.second.bytes[3] == 72;
  self.console.write_byte(self.first.bytes[0]);
  self.console.write_byte(self.first.bytes[1]);
  self.console.write_byte(self.first.bytes[2]);
  self.console.write_byte(self.first.bytes[3]);
  self.console.write_byte(self.second.bytes[0]);
  self.console.write_byte(self.second.bytes[1]);
  self.console.write_byte(self.second.bytes[2]);
  self.console.write_byte(self.second.bytes[3]);
  self.first.initialize();
  assert self.first.payload_length() == 0;
  assert self.second.payload_length() == 4;
  assert self.second.bytes[0] == 69;

  // Resolve a forward target, replay instruction boundaries, and seal.
  let label: i32 = self.first.new_label();
  assert label == 0;
  assert self.first.emit_jump_label(12, label) == 1;
  assert self.first.payload_length() == 9;
  assert self.first.fixup_count == 1;
  assert self.first.fixup_resolved[0] == 0;
  assert self.first.define_label(label) == 1;
  assert self.first.emit_ret() == 1;
  assert self.first.finalize() == 1;
  assert self.first.status == 0;
  assert self.first.finalized == 1;
  assert self.first.fixup_resolved[0] == 1;
  assert self.first.payload_length() == 10;
  assert self.first.decode_address(1) == 9;
  assert self.first.is_open() == 0;
  assert self.first.finalize() == 0;
  assert self.first.emit_ret() == 0;
  assert self.first.define_label(label) == 0;
  assert self.first.resolve_fixups() == 0;
  assert self.first.new_label() == -1;
  self.first.write_reserved_word(-1);
  assert self.first.status == 0;
  assert self.first.payload_length() == 10;

  // A registered but undefined label cannot produce a finalized payload.
  self.second.initialize();
  let missing: i32 = self.second.new_label();
  assert self.second.emit_jump_label(12, missing) == 1;
  assert self.second.emit_ret() == 1;
  assert self.second.finalize() == 0;
  assert self.second.status == 2;
  assert self.second.finalized == 0;
  assert self.second.failure_offset == 0;
  assert self.second.failure_requested == 1;
  assert self.second.fixup_resolved[0] == 0;
  assert self.second.payload_length() == 10;
  assert self.second.decode_address(1) == 0;

  // Direct forward targets use the selected 16-MiB payload provision.
  // These short unfinished buffers are not claimed to pass finalization.
  self.second.initialize();
  assert self.second.emit_jump(12, 1048572) == 1;
  assert self.second.decode_address(1) == 1048572;
  self.second.initialize();
  assert self.second.emit_jump(19, 16777211) == 1;
  assert self.second.decode_address(1) == 16777211;
  self.second.initialize();
  assert self.second.emit_rx(13, 255, 16777211) == 1;
  assert self.second.decode_address(2) == 16777211;
  self.second.initialize();
  assert self.second.emit_rrx(16, 254, 255, 16777211) == 1;
  assert self.second.decode_address(3) == 16777211;
  self.second.initialize();
  self.second.write_reserved_address(16777211);
  assert self.second.status == 0;
  assert self.second.payload_length() == 8;
  assert self.second.decode_address(0) == 16777211;
  assert self.second.bytes[0] == 251;
  assert self.second.bytes[1] == 255;
  assert self.second.bytes[2] == 255;
  assert self.second.bytes[3] == 0;
  assert self.second.bytes[7] == 0;

  // One-past-payload targets fail before any instruction bytes are appended.
  self.second.initialize();
  assert self.second.emit_jump(12, 16777212) == 0;
  assert self.second.status == 2;
  assert self.second.payload_length() == 0;
  self.second.initialize();
  assert self.second.emit_rx(14, 0, 16777212) == 0;
  assert self.second.status == 2;
  assert self.second.payload_length() == 0;
  self.second.initialize();
  assert self.second.emit_rrx(15, 0, 1, 16777212) == 0;
  assert self.second.status == 2;
  assert self.second.payload_length() == 0;
  self.second.initialize();
  self.second.write_reserved_address(16777212);
  assert self.second.status == 2;
  assert self.second.failure_requested == 16777212;
  assert self.second.payload_length() == 0;

  // Publish the actual small sealed payload for an independent byte oracle.
  self.console.write_byte(self.first.bytes[0]);
  self.console.write_byte(self.first.bytes[1]);
  self.console.write_byte(self.first.bytes[2]);
  self.console.write_byte(self.first.bytes[3]);
  self.console.write_byte(self.first.bytes[4]);
  self.console.write_byte(self.first.bytes[5]);
  self.console.write_byte(self.first.bytes[6]);
  self.console.write_byte(self.first.bytes[7]);
  self.console.write_byte(self.first.bytes[8]);
  self.console.write_byte(self.first.bytes[9]);
}
