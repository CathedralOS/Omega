boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; count: i32; }

machine Main::main(&mut self) {
  transition 0 { 0 -> swap(65, 66, 0) }
  state swap(first: i32, second: i32, step: i32) {
    transition step {
      0 -> swap(self.trace(second), self.trace(first), 1)
      _ -> done(first, second)
    }
  }
  state done(first: i32, second: i32) {
    assert first == 66;
    assert second == 65;
    assert self.count == 2;
    self.console.write_byte(67);
  }
}

machine Main::trace(&mut self, value: i32) -> i32 {
  self.count = self.count + 1;
  self.console.write_byte(value);
  return value;
}
