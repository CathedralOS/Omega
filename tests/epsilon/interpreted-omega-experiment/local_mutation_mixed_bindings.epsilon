boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; }

machine Main::main(&mut self) {
  transition 0 { 0 -> update(60) }
  state update(parameter: i32) {
    let local: i32 = 61;
    parameter = parameter + 5;
    assert local == 61;
    local = local + 5;
    assert parameter == 65;
    transition 0 { 0 -> done(parameter, local) }
  }
  state done(first: i32, second: i32) {
    assert first == 65;
    assert second == 66;
    self.console.write_byte(first);
    self.console.write_byte(second);
  }
}
