(def main ((source Bytes)) Bytes
  (match (epsilon_evaluate_entry_slice source)
    ((EpsilonEvaluatorSliceExit code output)
      (bytes_concat output (bytes_single code)))
    ((EpsilonEvaluatorSliceTrap kind output)
      (bytes_concat output (bytes_single (+ 128 kind))))
    ((EpsilonEvaluatorSliceRejected reasonValue errorOffset) (bytes_single 250))
    ((EpsilonEvaluatorSliceInternal errorOffset) (bytes_single 251))
    (EpsilonEvaluatorSliceUnsupported (bytes_single 252))))