; Report the exact span of the returned lexical case. The production entry
; also runs below, so an ordinary exit, trap or diagnostic stays observable.
(def test_lexer_case ((outcome EpsilonEvaluatorOutcome)) Bytes
  (match outcome
    ((EpsilonEvaluatorValue value place store output)
      (match value
        ((EpsilonRuntimeSumValue selected payloads)
          (match selected
            ((EpsilonResolvedSumCaseSyntax start end name parameters)
              (bytes_concat (epsilon_compiled_u32 start) (epsilon_compiled_u32 end)))))
        ((EpsilonRuntimeAggregate typeValue children) "")
        ((EpsilonRuntimeInteger integer) "")
        ((EpsilonRuntimeViewValue view) "")))
    ((EpsilonEvaluatorResultless store output) "")
    ((EpsilonEvaluatorExit code output) "")
    ((EpsilonEvaluatorTrap kind output) "")
    ((EpsilonEvaluatorInternal offset) "")))

(def test_lexer_entry ((mainType EpsilonType) (input Bytes)) Bytes
  (let receiver EpsilonRuntimePlace (EpsilonRuntimePlaceAt 1 NoEpsilonRuntimePath mainType)
    (let roots EpsilonRuntimeRoots (MoreEpsilonRuntimeRoots 1
      (epsilon_runtime_zero_value mainType) NoEpsilonRuntimeRoots)
      (let store EpsilonRuntimeStore (EpsilonRuntimeStoreState 2 roots (EpsilonRuntimeConsoleInputAt input 0))
        (bytes_concat (epsilon_compiled_entry input)
          (test_lexer_case (ep_owned_4_Main_selected_token receiver store "")))))))
