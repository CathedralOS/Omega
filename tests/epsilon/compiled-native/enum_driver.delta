; The adapter invokes emitted named cases; it assigns no semantic case tags.
(def ep_enum_test_value ((outcome EpsilonCompiledOutcome)) Int
  (match outcome
    ((EpsilonCompiledScalar value) value)
    (EpsilonCompiledResultless -98)
    ((EpsilonCompiledTrap kind) -96)
    ((EpsilonCompiledInternal offset) -95)))

(def ep_enum_test_byte ((value Int)) Bytes
  (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_is_whitespace value)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_is_identifier_start value)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_is_identifier_continue value)))
    (bytes_concat (bytes_single (+ 1 (ep_enum_test_value (ep_free_omega_hex_value value))))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_digit_in_base value EpCase_16_OmegaNumericBase_Binary)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_digit_in_base value EpCase_16_OmegaNumericBase_Octal)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_digit_in_base value EpCase_16_OmegaNumericBase_Decimal)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_omega_digit_in_base value EpCase_16_OmegaNumericBase_Hexadecimal)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_enum_forward EpCase_16_OmegaNumericBase_Binary value)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_enum_forward EpCase_16_OmegaNumericBase_Octal value)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_enum_forward EpCase_16_OmegaNumericBase_Decimal value)))
    (bytes_concat (bytes_single (ep_enum_test_value (ep_free_enum_forward EpCase_16_OmegaNumericBase_Hexadecimal value)))
    "")))))))))))))

(def ep_enum_test_loop ((source Bytes) (cursor Int) (output Bytes)) Bytes
  (if (eq cursor (bytes_length source)) output
    (ep_enum_test_loop source (+ cursor 1)
      (bytes_concat output (ep_enum_test_byte (bytes_get source cursor))))))

(def main ((source Bytes)) Bytes (ep_enum_test_loop source 0 ""))
