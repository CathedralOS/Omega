(def fill ((n Int)) Int (if n (let discarded Int (pair n 0) (fill (- n 1))) 1))

(def poison ((a Int)) Int (let ((p0 Int (pair 0 9))
         (p1 Int (pair 1 9))
         (p2 Int (pair 2 9))
         (p3 Int (pair 3 9))
         (p4 Int (pair 4 9))
         (p5 Int (pair 5 9))
         (p6 Int (pair 6 9))
         (p7 Int (pair 7 9))
         (p8 Int (pair 8 9))
         (p9 Int (pair 9 9))
         (p10 Int (pair 10 9))
         (p11 Int (pair 11 9))) (first p11)))

(def reuse ((branch Int) (saved Int)) Int
  (if branch (let done Int (fill 180) (first saved)) (let ((s0 Int (pair 0 4))
         (s1 Int (pair 1 4))
         (s2 Int (pair 2 4))
         (s3 Int (pair 3 4))
         (s4 Int (pair 4 4))
         (s5 Int (pair 5 4))
         (s6 Int (pair 6 4))
         (s7 Int (pair 7 4))
         (s8 Int (pair 8 4))
         (s9 Int (pair 9 4))
         (s10 Int (pair 10 4))
         (s11 Int (pair 11 4))) (second s11))))

(def main () Int (let ((saved Int (pair 42 0)) (a Int (poison 0)) (b Int (fill 250)))
  (reuse 1 saved)))
