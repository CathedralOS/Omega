boundary trait Console {
  machine exit_process(return_code: i32) -> never;
  machine write_byte(value: i32);
  machine read_byte() -> i32;
  machine write_line(text: &[u8]);
}

data Main { console: Console; }
machine Main::main(&mut self) {}

machine first() {
  transition 0 { _ -> next() }
  state next() { transition 0 { 0 -> return 1 -> return } }
  state last() { transition 1 { false -> return true -> return } }
}
machine second() { transition 0 { 00 -> return 001 -> return } }
