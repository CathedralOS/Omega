; The one remaining unsupported route is a nonfinal failing byte payload.
; A final byte failure is instead the settled ByteRange trap with its prefix.
(def invariant_constructors () Bytes
  (bytes_concat
    (invariant_observe
      (epsilon_evaluator_constructor_byte_range
        (MoreEpsilonExpressions (EpsilonTrueExpression 113 114) NoEpsilonExpressions)
        (invariant_output)))
    (invariant_observe
      (epsilon_evaluator_constructor_byte_range NoEpsilonExpressions (invariant_output)))))
