; Private helper observations, not a RunEpsilon envelope. All tested integers
; and offsets are nonnegative; four bytes preserve their exact tested values.
(def invariant_u32 ((value Int)) Bytes
  (bytes_concat
    (bytes_concat (bytes_single (% value 256))
      (bytes_single (% (/ value 256) 256)))
    (bytes_concat (bytes_single (% (/ value 65536) 256))
      (bytes_single (% (/ value 16777216) 256)))))

(def invariant_tagged_integer ((tag Int) (value Int) (output Bytes)) Bytes
  (bytes_concat (bytes_single tag) (bytes_concat (invariant_u32 value) output)))

(def invariant_observe ((outcome EpsilonEvaluatorOutcome)) Bytes
  (match outcome
    ((EpsilonEvaluatorValue value place store output)
      (match value
        ((EpsilonRuntimeInteger integer) (invariant_tagged_integer 0 integer output))
        ((EpsilonRuntimeAggregate typeValue children)
          (bytes_concat (bytes_single 7) output))
        ((EpsilonRuntimeSumValue owner caseValue payloads)
          (bytes_concat (bytes_single 7) output))
        ((EpsilonRuntimeViewValue view) (bytes_concat (bytes_single 7) output))))
    ((EpsilonEvaluatorTrap kind output)
      (bytes_concat (bytes_single 1) (bytes_concat (bytes_single kind) output)))
    ((EpsilonEvaluatorInternal offset)
      (invariant_tagged_integer 3 offset (bytes_empty)))
    ((EpsilonEvaluatorResultless store output) (bytes_concat (bytes_single 5) output))
    ((EpsilonEvaluatorExit code output) (invariant_tagged_integer 6 code output))))

(def invariant_observe_block ((outcome EpsilonEvaluatorBlockOutcome)) Bytes
  (match outcome
    ((EpsilonEvaluatorBlockInternal offset)
      (invariant_observe (EpsilonEvaluatorInternal offset)))
    ((EpsilonEvaluatorBlockFalloff bindings store output)
      (invariant_observe (EpsilonEvaluatorResultless store output)))
    ((EpsilonEvaluatorBlockReturn value store output)
      (invariant_observe (EpsilonEvaluatorValue value NoEpsilonRuntimePlace store output)))
    ((EpsilonEvaluatorBlockTrap kind output)
      (invariant_observe (EpsilonEvaluatorTrap kind output)))
    ((EpsilonEvaluatorBlockExit code output)
      (invariant_observe (EpsilonEvaluatorExit code output)))
    ((EpsilonEvaluatorBlockTransfer stateValue bindings store output)
      (bytes_concat (bytes_single 8) output))))
