input source/on-ramp/omega-bootstrap/compiler/OMEGA_BOOTSTRAP_SHA256.md
input source/on-ramp/omega-bootstrap/compiler/omega-bootstrap-sha256.alp
input source/on-ramp/omega-bootstrap/compiler/omega_bootstrap_bundle.py
input source/on-ramp/omega-bootstrap/compiler/omega_bootstrap_compilation.py
input source/on-ramp/omega-bootstrap/gates/two_unit_compilation_fixture.py
input source/on-ramp/omega-bootstrap/gates/fixtures/sha256-known-answer
