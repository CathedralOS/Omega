// Clamp a series of raw sensor readings into a valid band and sum the results.
// Each reading is clamped to [0, 60] via the standard idiom `max(lo, min(v, hi))`,
// which is why this sample exercises the `min` AND `max` builtins together (the
// first sample to use both). For readings [80, -5, 50, 200, 30] the clamped values
// are [60, 0, 50, 60, 30], summing to 200. Walks the slice with the shrinking-
// window recursion (`s[1..]`), reading `s[0]` under the `s.len > 0` guard so the
// index is discharged in the same transition. All arithmetic is `in Trapping`
// (the clamped sum, max 300, never overflows i32).
// Expected exit: 200.

use omega::language::std::console;

data Clamper {
    values: [i32 in Trapping; 5];
}

machine Clamper::clamp_sum(&mut self, s: &[i32 in Trapping], acc: i32 in Trapping) -> i32 in Trapping {
    transition s.len > 0 {
        true -> clamp_sum(s[1..], acc + max(0, min(s[0], 60)))
        false -> (acc)
    }
}

data Main {
    console: Console;
    clamper: Clamper;
}

machine Main::main(&mut self) {
    self.clamper.values[0] = 80;
    self.clamper.values[1] = -5;
    self.clamper.values[2] = 50;
    self.clamper.values[3] = 200;
    self.clamper.values[4] = 30;

    let s: &[i32 in Trapping] = self.clamper.values.as_slice();
    let total: i32 = self.clamper.clamp_sum(s, 0);
    self.console.exit_process(total);
}
