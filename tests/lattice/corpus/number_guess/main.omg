// Binary-search guessing game (scripted, no stdin).
//
// The secret number is 42. The game uses binary search over [1, 100] to
// find it. No user input: each guess is computed from the current [lo, hi]
// range via mid = (lo + hi) / 2. Guesses are unrolled since the number of
// steps (7) is known in advance.
//
// Binary search trace (target=42, range=[1,100]):
//   guess 1: mid=50  > 42 -> hi=49
//   guess 2: mid=25  < 42 -> lo=26
//   guess 3: mid=37  < 42 -> lo=38
//   guess 4: mid=43  > 42 -> hi=42
//   guess 5: mid=40  < 42 -> lo=41
//   guess 6: mid=41  < 42 -> lo=42
//   guess 7: mid=42 == 42 -> FOUND
//
// 7 guesses to find the number. Verification: guesses == 7 -> exit 70.
//
// Expected exit: 70.

use omega::language::std::console;

data Search [copy] {
    lo: i32 in Saturating;
    hi: i32 in Saturating;
    mid: i32 in Saturating;
    guesses: i32 in Saturating;
    found: i32 in Saturating;   // 1 when the target has been located
}

data Main {
    console: Console;
    search: Search;
}

// Perform one binary-search step: compute mid = (lo+hi)/2, compare to target.
// Updates lo or hi, increments guesses, sets found=1 if matched.
machine Main::step(&mut self, target: i32 in Saturating) {
    let mid: i32 in Saturating = (self.search.lo + self.search.hi) / 2;
    self.search.mid = mid;
    self.search.guesses = self.search.guesses + 1;
    transition mid == target {
        true -> found()
        _ -> not_found(mid, target)
    }

    state found(&mut self) {
        self.search.found = 1;
    }

    state not_found(&mut self, mid: i32 in Saturating, target: i32 in Saturating) {
        transition mid < target {
            true -> move_lo(mid)
            _ -> move_hi(mid)
        }
    }

    state move_lo(&mut self, mid: i32 in Saturating) {
        self.search.lo = mid + 1;
    }

    state move_hi(&mut self, mid: i32 in Saturating) {
        self.search.hi = mid - 1;
    }
}

machine Main::main(&mut self) {
    // Initialize search range [1, 100].
    self.search.lo = 1;
    self.search.hi = 100;

    // Secret number to find.
    let target: i32 in Saturating = 42;

    // Seven unrolled binary-search steps.
    self.step(target);   // guess 1: mid=50 > 42, hi=49
    self.step(target);   // guess 2: mid=25 < 42, lo=26
    self.step(target);   // guess 3: mid=37 < 42, lo=38
    self.step(target);   // guess 4: mid=43 > 42, hi=42
    self.step(target);   // guess 5: mid=40 < 42, lo=41
    self.step(target);   // guess 6: mid=41 < 42, lo=42
    self.step(target);   // guess 7: mid=42 == 42, found!

    // Verify found within 7 guesses.
    transition self.search.found == 1 {
        true -> check_guesses()
        _ -> not_found_error()
    }

    state check_guesses(&mut self) {
        // Exactly 7 guesses needed: 7 * 10 = 70.
        transition self.search.guesses == 7 {
            true -> good()
            _ -> bad_guesses()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state not_found_error(&mut self) {
        self.console.exit_process(71);
    }

    state bad_guesses(&mut self) {
        self.console.exit_process(72);
    }
}
