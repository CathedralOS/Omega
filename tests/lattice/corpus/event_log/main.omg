// Event log: case-payload events updating nested struct state across multiple
// sub-machine calls.
//
// Exercises: case-payload dispatch (3 variants with different payloads),
// nested struct field updates (self.log.stats.deposits etc.), multi-arm
// transitions mixed with equality guards, and accumulation across repeated
// machine calls.
//
// Data model:
//   Stats [copy] { deposits: i32 in Saturating; withdrawals: i32 in Saturating; balance: i32 in Saturating; }
//   Log   [copy] { stats: Stats; event_count: i32 in Saturating; }
//
// Event variants:
//   Deposit(amount: i32 in Saturating)    -- add to balance, increment deposits
//   Withdraw(amount: i32 in Saturating)   -- subtract from balance, increment withdrawals
//   Reset                   -- zero the balance, keep counts
//
// Scripted:
//   Deposit(100)  -> balance=100, deposits=1
//   Deposit(50)   -> balance=150, deposits=2
//   Withdraw(30)  -> balance=120, withdrawals=1
//   Deposit(20)   -> balance=140, deposits=3
//   Withdraw(70)  -> balance=70,  withdrawals=2
//
// Final: balance=70, deposits=3, withdrawals=2, event_count=5.
// total = balance + (deposits - withdrawals) * 0 + 0 = balance = 70.
// Exit 70 iff balance==70 AND deposits==3 AND withdrawals==2 AND event_count==5.
//
// Expected exit: 70.

use omega::language::std::console;

data Event {
    case Deposit(amount: i32 in Saturating);
    case Withdraw(amount: i32 in Saturating);
    case Reset;
}

data Stats [copy] {
    deposits: i32 in Saturating;
    withdrawals: i32 in Saturating;
    balance: i32 in Saturating;
}

data Log [copy] {
    stats: Stats;
    event_count: i32 in Saturating;
}

data Main {
    console: Console;
    log: Log;
}

machine Main::apply(&mut self, event: Event) {
    self.log.event_count = self.log.event_count + 1;
    transition event {
        Event::Deposit { amount } -> do_deposit(amount)
        Event::Withdraw { amount } -> do_withdraw(amount)
        Event::Reset -> do_reset()
        _ -> done()
    }

    state do_deposit(&mut self, amount: i32 in Saturating) {
        self.log.stats.balance = self.log.stats.balance + amount;
        self.log.stats.deposits = self.log.stats.deposits + 1;
    }

    state do_withdraw(&mut self, amount: i32 in Saturating) {
        self.log.stats.balance = self.log.stats.balance - amount;
        self.log.stats.withdrawals = self.log.stats.withdrawals + 1;
    }

    state do_reset(&mut self) {
        self.log.stats.balance = 0;
    }

    state done(&mut self) {}
}

machine Main::main(&mut self) {
    self.apply(Event::Deposit { amount: 100 });
    self.apply(Event::Deposit { amount: 50 });
    self.apply(Event::Withdraw { amount: 30 });
    self.apply(Event::Deposit { amount: 20 });
    self.apply(Event::Withdraw { amount: 70 });

    // Verify balance == 70.
    transition self.log.stats.balance == 70 {
        true -> check_deposits()
        _ -> bad_balance()
    }

    state bad_balance(&mut self) { self.console.exit_process(71); }

    state check_deposits(&mut self) {
        transition self.log.stats.deposits == 3 {
            true -> check_withdrawals()
            _ -> bad_deposits()
        }
    }

    state bad_deposits(&mut self) { self.console.exit_process(72); }

    state check_withdrawals(&mut self) {
        transition self.log.stats.withdrawals == 2 {
            true -> check_count()
            _ -> bad_withdrawals()
        }
    }

    state bad_withdrawals(&mut self) { self.console.exit_process(73); }

    state check_count(&mut self) {
        transition self.log.event_count == 5 {
            true -> good()
            _ -> bad_count()
        }
    }

    state bad_count(&mut self) { self.console.exit_process(74); }

    state good(&mut self) { self.console.exit_process(70); }
}
