// Area of a shape via a SUM TYPE (enum) with payloads -- the classic case for
// tagged unions. `Shape` has two payload-carrying variants, `Circle(radius)` and
// `Rectangle(width, height)`. A value is constructed (`Shape::Rectangle { width: 6,
// height: 7 }`), then matched in a transition: each arm binds that variant's payload
// fields and dispatches to a state that computes the area for that case (rectangle =
// w*h = 42; circle approximates pi as 3). Demonstrates enum construction, matching
// on a stored enum field, payload-field extraction, and per-variant computation.
// Expected exit: 42.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Shape {
    case Circle(radius: i32 in Trapping);
    case Rectangle(width: i32 in Trapping, height: i32 in Trapping);
}

data Main {
    console: Console;
    shape: Shape;
    area: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.shape = Shape::Rectangle { width: 6, height: 7 };

    transition self.shape {
        Shape::Circle { radius } -> circle(radius)
        Shape::Rectangle { width, height } -> rect(width, height)
    }

    state circle(&mut self, radius: i32 in Trapping) {
        self.area = radius * radius * 3;
        transition { _ -> emit() }
    }
    state rect(&mut self, width: i32 in Trapping, height: i32 in Trapping) {
        self.area = width * height;
        transition { _ -> emit() }
    }
    state emit(&mut self) {
        self.console.exit_process(self.area);
    }
}
