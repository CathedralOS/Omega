data EnemyKind {
    case Bat;
    case Spider;
    case Skeleton;
    case Cultist;
    case Hellhound;
    case PitFiend;
}

data EnemyTier {
    case Bat;
    case Spider;
    case Skeleton;
    case Cultist;
    case Hellhound;
    case PitFiend;
}

data Enemy {
    kind: EnemyKind;
    name: [u8; 24] in Utf8;
    max_health: i32 in Wrapping;
    health: i32 in Wrapping;
    attack: i32 in Wrapping;
    defense: i32 in Wrapping;
    xp_reward: u32 in Wrapping;
    depth: u32 in Wrapping;
}
