use commands::command_parser;
use dungeon::dungeon;
use platform::console;
use rooms::map;
use view::game_view;

data Game {
    console: Console;
    dungeon: Dungeon;
    parser: CommandParser;
    view: GameView;
    input: [u8; 256] in Utf8;
    output: [u8; 128] in Utf8;
}

machine Game::initialize(
    &mut self,
    seed: u64 in Wrapping
)
ensures
    self.input in Utf8,
    self.output in Utf8
{
    self.dungeon.initialize(seed);
    self.input = "";
    self.output = "";
}

machine Game::run_game_loop(&mut self) {
    self.view.render_title(&mut self.console);

    transition {
        _ -> enter_room()
    }


    state enter_room(&mut self) {
        self.dungeon.enter_room(self.dungeon.current_cell);
        self.output = "";
        self.view.render_room(
            self.dungeon.level,
            self.dungeon.current_cell,
            self.dungeon.treasure_taken,
            self.dungeon.gold_taken,
            self.dungeon.fountain_used,
            self.dungeon.enemy_defeated,
            &mut self.console,
            &mut self.output
        );
        self.view.render_commands(&mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state prompt(&mut self) {
        transition self.dungeon.player.health == 0 {
            true -> game_over()
            false -> read_command()
        }
    }

    state read_command(&mut self) {
        self.view.render_prompt(&mut self.console);
        self.console.read_line(&mut self.input);

        transition {
            self.input == "" -> finished()
            self.input == "quit" -> finished()
            self.input == "exit" -> finished()
            self.input == "look" -> look()
            self.input == "info" -> look()
            self.input == "paths" -> exits()
            self.input == "help" -> exits()
            self.input == "inventory" -> inventory()
            self.input == "inv" -> inventory()
            self.input == "char" -> character()
            self.input == "character" -> character()
            self.input == "stats" -> character()
            self.input == "use" -> use_event()
            self.input == "fight" -> fight()
            self.dungeon.current_cell == CellId::R00 && self.input == "north" -> move_r01()
            self.dungeon.current_cell == CellId::R01 && self.input == "south" -> move_r00()
            self.dungeon.current_cell == CellId::R01 && self.input == "north" -> move_r02()
            self.dungeon.current_cell == CellId::R01 && self.input == "east" -> move_r05()
            self.dungeon.current_cell == CellId::R02 && self.input == "south" -> move_r01()
            self.dungeon.current_cell == CellId::R02 && self.input == "north" -> move_r03()
            self.dungeon.current_cell == CellId::R02 && self.input == "west" -> move_r06()
            self.dungeon.current_cell == CellId::R03 && self.input == "south" -> move_r02()
            self.dungeon.current_cell == CellId::R03 && self.input == "north" -> move_r04()
            self.dungeon.current_cell == CellId::R03 && self.input == "east" -> move_r07()
            self.dungeon.current_cell == CellId::R04 && self.input == "south" -> move_r03()
            self.dungeon.current_cell == CellId::R05 && self.input == "west" -> move_r01()
            self.dungeon.current_cell == CellId::R06 && self.input == "east" -> move_r02()
            self.dungeon.current_cell == CellId::R07 && self.input == "west" -> move_r03()
            _ -> invalid_command()
        }
    }

    state look(&mut self) {
        self.view.render_look(
            self.dungeon.level,
            self.dungeon.current_cell,
            self.dungeon.treasure_taken,
            self.dungeon.gold_taken,
            self.dungeon.fountain_used,
            self.dungeon.enemy_defeated,
            &mut self.console,
            &mut self.output
        );

        transition {
            _ -> prompt()
        }
    }

    state exits(&mut self) {
        self.view.render_exits(
            self.dungeon.level,
            self.dungeon.current_cell,
            &mut self.console,
            &mut self.output
        );
        self.view.render_commands(&mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state inventory(&mut self) {
        self.view.render_inventory(self.dungeon.player, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state character(&mut self) {
        self.view.render_character(self.dungeon.player, &mut self.console, &mut self.output);

        transition {
            _ -> prompt()
        }
    }

    state use_event(&mut self) {
        self.dungeon
            .use_event(self.dungeon.current_cell, &mut self.output);
        self.view.render_line(self.output, &mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state fight(&mut self) {
        self.dungeon
            .fight(self.dungeon.current_cell, &mut self.output);
        self.view.render_line(self.output, &mut self.console);

        transition self.dungeon.player.health == 0 {
            true -> game_over()
            false -> prompt()
        }
    }

    state attempt_move(&mut self) {
        transition self.dungeon.can_travel_to(self.dungeon.navigation.destination) {
            true -> move_player()
            false -> blocked_by_enemy()
        }
    }

    state move_player(&mut self) {
        self.dungeon.move_to(self.dungeon.navigation.destination);

        transition {
            _ -> enter_room()
        }
    }

    state move_r00(&mut self) {
        self.dungeon.move_to(CellId::R00);

        transition {
            _ -> enter_room()
        }
    }

    state move_r01(&mut self) {
        self.dungeon.move_to(CellId::R01);

        transition {
            _ -> enter_room()
        }
    }

    state move_r02(&mut self) {
        self.dungeon.move_to(CellId::R02);

        transition {
            _ -> enter_room()
        }
    }

    state move_r03(&mut self) {
        self.dungeon.move_to(CellId::R03);

        transition {
            _ -> enter_room()
        }
    }

    state move_r04(&mut self) {
        self.dungeon.move_to(CellId::R04);

        transition {
            _ -> enter_room()
        }
    }

    state move_r05(&mut self) {
        self.dungeon.move_to(CellId::R05);

        transition {
            _ -> enter_room()
        }
    }

    state move_r06(&mut self) {
        self.dungeon.move_to(CellId::R06);

        transition {
            _ -> enter_room()
        }
    }

    state move_r07(&mut self) {
        self.dungeon.move_to(CellId::R07);

        transition {
            _ -> enter_room()
        }
    }

    state blocked_by_enemy(&mut self) {
        self.output = "[Blocked] A hostile presence bars the deeper path. Fight or fall back.";
        self.view.render_line(self.output, &mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state invalid_command(&mut self) {
        self.view.render_invalid_command(&mut self.console);

        transition {
            _ -> prompt()
        }
    }

    state game_over(&mut self) {
        self.dungeon.game_over();
        self.view.render_game_over(&mut self.console);

        transition {
            _ -> finished()
        }
    }

    state finished(&mut self) {
        self.console.exit_process(0);
    }
}
