// A counter saturating at a bound. Showcases `[copy]` type
// properties and saturating arithmetic over a dispatched self-write path
// driven by scalar arguments (the proven-good shape — case-payload commands
// threaded into a self-writing sub-machine are a known miscompile, see
// tests/omega/pending/calls/by_value_case_param_self_write_lost, so this sample
// uses scalar drives; vending_machine is the case-payload showcase).
// Expected exit: 70.

use omega::language::std::console;

data Counter [copy] {
    value: i32 in Saturating;
    bound: i32 in Saturating;
}

data Main {
    console: Console;
    counter: Counter;
}

machine Main::main(&mut self) {
    self.counter.bound = 100;

    self.add(40);
    self.add(40);
    self.add(40);   // 120, saturates to 100

    transition self.counter.value == 100 {
        true -> report(70)
        _ -> not_hundred()
    }
    state not_hundred(&mut self) {
        transition self.counter.value == 120 {
            true -> report(81)   // saturation didn't apply
            _ -> report(82)      // some other wrong value
        }
    }
    state report(&mut self, code: i32) {
        self.console.exit_process(code);
    }
}

// add saturates at the bound; the self-write happens in a dispatched substate
// reached via a scalar-argument call (probe-confirmed sound).
machine Main::add(&mut self, amount: i32 in Saturating) {
    let next: i32 in Saturating = self.counter.value + amount;
    transition next > self.counter.bound {
        true -> saturate()
        _ -> set_value(next)
    }
    state saturate(&mut self) {
        self.counter.value = self.counter.bound;
    }
    state set_value(&mut self, next: i32 in Saturating) {
        self.counter.value = next;
    }
}
