; echo - copy stdin to stdout until EOF. The simplest end-to-end test of the VM's
; byte I/O and control flow. read returns -1 at EOF.
        imm   r1, 0x0
loop:
        read  r0
        jlt   r0, r1, done      ; r0 < 0  =>  EOF
        write r0
        jmp   loop
done:
        imm   r0, 0x0
        halt  r0
