; factorial.beta - recursive factorial using the data-stack calling convention.
; rf = data stack pointer (grows down). arg in r0, result in r0.
; Proves real recursion with per-call frames - no fixed globals. factorial(5) = 120.
; See ../CALLING_CONVENTION.md.

        imm   rf, 0x100000      ; init data stack pointer (1 MiB; grows downward)
        imm   r0, 0x5             ; factorial(5)
        call  0x1f ; -> factorial:
        halt  r0                ; exit code = 120

0x1f: ; factorial:
        imm   r1, 0x2
        jlt   r0, r1, 0x6e ; n < 2  ->  return 1 -> fact_one:
        ; frame: one slot, save n across the recursive call
        imm   r1, 0x8
        sub   rf, r1
        store rf, r0           ; [dsp] = n
        imm   r1, 0x1
        sub   r0, r1            ; r0 = n - 1
        call  0x1f ; r0 = (n-1)! -> factorial:
        load  r1, rf           ; r1 = n  (reloaded from the frame)
        mul   r0, r1            ; r0 = n * (n-1)!
        imm   r1, 0x8
        add   rf, r1           ; pop the frame
        ret
0x6e: ; fact_one:
        imm   r0, 0x1
        ret
