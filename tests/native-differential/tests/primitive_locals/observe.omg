machine replace(value: &mut u64, replacement: u64, returned: u64) -> u64 {
    value = replacement;
    returned
}

machine observe(output: &mut u64, return_output: &mut u64, replacement: u64, returned: u64) {
    let mut scratch: u64 = 91;
    let result: u64 = replace(&mut scratch, replacement, returned);
    output = scratch;
    return_output = result;
}
