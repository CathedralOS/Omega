machine identity(value: u64) -> u64 { value }

data Limits {
    limit: u64;
    divisor: u64 [3..=5];
}

machine countdown(remaining: u64 [0..=5], limits: Limits, marker: u64)
terminates by remaining -> Nat::Descending in 0..(limits.limit % limits.divisor + 6);
-> u64 {
    transition remaining > 0 {
        true -> countdown(remaining - 1, limits, identity(remaining))
        false -> marker
    }
}
