machine identity(value: u64) -> u64 { value }

data Payload { first: u64; second: u64; }

machine countdown(remaining: u64 [0..=5], left: Payload, right: Payload, marker: u64)
terminates by remaining -> Nat::Descending in 0..6;
-> u64 {
    transition remaining > 0 {
        true -> countdown(remaining - 1, right, left, identity(remaining))
        false -> marker
    }
}
