// Expected exit: 0
// A callback may change the record; the following guard establishes the exact facts used by the borrowed call.
data Context<'input> { storage: @'input mutable [u8]; count: u64; valid: bool; }
machine plan<'input>(context: @mutable Context<'input>) {
    context.count = 3u64;
    context.valid = true;
}
public machine forward<'input, machine Plan>(storage: @'input mutable [u8], steps: u64, next: @mutable u64) -> u64
requires machine Plan(context: @mutable Context<'input>);
requires steps >= 0u64
{
    let mutable context: Context<'input> = Context { storage: storage, count: 0u64, valid: false };
    Plan(@mutable context);
    transition context.valid && context.count <= context.storage.length {
        true -> checked_remaining(@mutable context, steps, next),
        false -> 0u64
    }
    machine checked_remaining(context: @mutable Context<'input>, steps: u64, next: @mutable u64) -> u64
    requires context.count <= context.storage.length && steps > 0u64
    {
        let remaining: u64 = context.storage.length - context.count;
        let prior_step: u64 = steps - 1u64;
        $next = remaining;
        transition prior_step == 0u64 { true -> remaining, _ -> 0u64 }
    }
}
machine main() crashes Trap {
    let mutable storage: [u8; 4] = [11u8, 13u8, 17u8, 19u8];
    let mutable short: [u8; 2] = [23u8, 29u8];
    let mutable next: u64 = 31u64;
    let remaining: u64 = forward::<plan>(@mutable storage[..], 1u64, @mutable next);
    let fallback: u64 = forward::<plan>(@mutable storage[..], 2u64, @mutable next);
    let invalid_count: u64 = forward::<plan>(@mutable short[..], 1u64, @mutable next);
    transition remaining == 1u64 && fallback == 0u64 && invalid_count == 0u64 && next == 1u64
        && storage[0u64] == 11u8 && storage[1u64] == 13u8 && storage[2u64] == 17u8 && storage[3u64] == 19u8
        && short[0u64] == 23u8 && short[1u64] == 29u8 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
