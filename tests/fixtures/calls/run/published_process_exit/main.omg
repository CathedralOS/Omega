use {omega}/language/core/never.omg;
use {omega}/language/core/process_exit.omg;

// The public result carries non-return through an ordinary wrapper. Receiving
// it at u32 must create no value, while the terminal keeps the exact status.
public machine finish(status: i32) -> |never|::Never
reaches |process_exit|::ProcessExit
crashes none
terminates {
    |process_exit|::ProcessExit::exit_process(status);
}

machine entry_start() reaches |process_exit|::ProcessExit crashes none terminates {
    let unreachable_value: u32 = finish(0);
}
