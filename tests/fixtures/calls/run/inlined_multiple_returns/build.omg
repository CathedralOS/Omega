use main.omg as program;

machine build(plan: @mutable BuildPlan) {
    plan.product = BuildProduct::Application { name: "inlined_multiple_returns" };
    Build::bind(plan, linux_x86_64::ProgramEntry, |program|::start);
    Build::bind(plan, linux_arm64::ProgramEntry, |program|::start);
    Build::bind(plan, macos_arm64::ProgramEntry, |program|::start);
    Build::bind(plan, windows_x86_64::ProgramEntry, |program|::start);
    Build::bind(plan, windows_arm64::ProgramEntry, |program|::start);
}
