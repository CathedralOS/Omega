// Expected refusal: a parameter query selects a boundary requirement's declared formal
// The table follows a scalar argument. Reflection must retain its exact
// formal identity and distinguish it from the address field it will read.

use {omega}/language/core/reflect/reflect.omg;

data Table { padding: u64; invoke: address; }
boundary trait Query {
    machine invoke(seed: u64, table: @Table) -> u64 reaches none crashes none;
}
machine complete() { }
machine fail() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let parameter: |reflect|::ParameterInfo = |reflect|::parameter(Table::invoke);
    let field: |reflect|::FieldInfo = |reflect|::field(Table::invoke);
    transition parameter.declaration_position == 1u64 && field.declaration_position == 1u64 {
        true -> complete(),
        false -> fail()
    }
}
