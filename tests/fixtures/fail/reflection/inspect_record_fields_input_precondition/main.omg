// Intended rejection: `note` requires `field.declaration_position < 32u64`,
// which the callback binder of `reflect::inspect_record_fields` does not
// publish. Every call the inspection makes here would meet it (`Reading` has
// two fields), but a callback must satisfy the binder as published, not only
// the calls one record happens to need. The run twin
// `run/reflection/inspect_record_fields` differs only in this precondition.
use omega::language::core::reflect;
data Reading { value: u64; flag: bool; }
data Notes { last: u64; first_seen: bool; }
machine note<Kind>(notes: &mut Notes, field: &reflect::FieldInfo)
requires Kind == u64 || Kind == bool
requires field.declaration_position < 32u64
{
    notes.first_seen = notes.first_seen || field.declaration_position == 0u64;
    notes.last = field.declaration_position;
}
machine described() -> bool {
    let mut notes: Notes;
    notes.last = 7u64;
    notes.first_seen = false;
    reflect::inspect_record_fields<Reading, note>(&mut notes);
    notes.first_seen && notes.last == 1u64
}
machine main() crashes Trap {
    transition described() { true -> done() false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
