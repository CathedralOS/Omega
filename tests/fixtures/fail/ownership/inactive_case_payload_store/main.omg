data Item { value: u32; }
data Choice { case Left(item: Item); case Right; }
machine item(value: u32) -> Item { Item { value: value } }
machine consume(choice: Choice) { }
machine main() crashes Trap {
    let mut choice: Choice = Choice::Right {};
    choice.item = item(7);
    transition choice.item.value == 7 {
        true -> consume(choice)
        false -> bad()
    }
    machine bad() { crash Trap; }
}
