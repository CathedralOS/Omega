data Item { value: u32; }
machine replace(owner: &Item) {
    let replacement: Item = Item { value: 7 };
    owner = replacement;
}
machine consume(item: Item) { }
machine main() crashes Trap {
    let mut item: Item = Item { value: 3 };
    replace(&item);
    transition item.value == 7 {
        true -> consume(item)
        false -> bad()
    }
    machine bad() { crash Trap; }
}
