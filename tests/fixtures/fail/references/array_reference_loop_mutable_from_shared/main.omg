// Rejected: a shared input cannot supply the mutable shape requested by selected.
// Returning directly reads the separate input; looping selects an array element.
data Shape [copy] { value: u64; }
machine array_loop(shapes: &[Shape; 2], sibling: &[Shape; 2], index: u64,
    again: bool, initial: &Shape) -> u64
requires index < 2 {
    transition { _ -> selected(shapes, sibling, index, again, initial) }
    machine selected(shapes: &[Shape; 2], sibling: &[Shape; 2], index: u64,
        again: bool, shape: &mut Shape) -> u64
    requires index < 2 {
        transition { _ -> forwarded(shapes, sibling, index, again, shape) }
    }
    machine forwarded(shapes: &[Shape; 2], sibling: &[Shape; 2], index: u64,
        again: bool, shape: &Shape) -> u64
    requires index < 2 {
        transition again {
            true -> array_loop(shapes, sibling, index, false, &shapes[index])
            false -> shape.value
        }
    }
}
machine main() crashes Trap {
    let shapes: [Shape; 2] = [Shape { value: 17u64 }, Shape { value: 42u64 }];
    let sibling: [Shape; 2] = [Shape { value: 97u64 }, Shape { value: 99u64 }];
    let initial: Shape = Shape { value: 89u64 };
    let first: u64 = array_loop(&shapes, &sibling, 0u64, false, &initial);
    let second: u64 = array_loop(&shapes, &sibling, 1u64, false, &initial);
    let cycled_first: u64 = array_loop(&shapes, &sibling, 0u64, true, &initial);
    let cycled_second: u64 = array_loop(&shapes, &sibling, 1u64, true, &initial);
    transition first == 89u64 && second == 89u64
        && cycled_first == 17u64 && cycled_second == 42u64
        && shapes[0].value == 17u64 && shapes[1].value == 42u64
        && sibling[0].value == 97u64 && sibling[1].value == 99u64
        && initial.value == 89u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
