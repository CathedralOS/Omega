// The excluded module-owned left::Sink is invoked through a helper machine,
// so the selected composition reaches it below the entry.
use left;
use right;
use left::Sink;

data Main { }
machine Main::main(main: &mut Main)
reaches Sink
{
    relay();
}

machine relay()
reaches Sink
{
    Sink::emit("relayed");
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Sink
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
