// FAIL CANARY -- a build-dependency helper borrows the root Build and queries
// the owner's private `launch` through `builder.product.entry`. The query
// resolves under the helper occurrence's own package, never the caller's:
// passing Build lends operational capability, not visibility into the
// owner's product namespace, so the helper cannot enumerate it.
use support::configure;

machine build(builder: &mut Build) {
    Build::application(builder, "product_entry_query_foreign_helper_private_entry");
    let mut support_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "helper" });
    dependency::with_alias(&mut support_dependency, "support");
    let support_registration: DependencyRegistration = Build::build_dependency(builder, support_dependency);
    configure::configure(builder);
}
