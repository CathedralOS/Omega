machine build(builder: &mut Build) {
    Build::application(builder, "unjoined_executed_dependency");
    request_dependency(builder);
}

machine request_dependency(builder: &mut Build) {
    let mut selected_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "missing-source" });
    dependency::with_alias(&mut selected_dependency, "selected");
    let selected_registration: DependencyRegistration = Build::dependency(builder, selected_dependency);
}
