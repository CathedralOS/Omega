machine build(builder: &mut Build) {
    Build::application(builder, "installed_entry_contract");
    Build::bind(builder, linux_x86_64::ProgramEntry, launch);
    Build::bind(builder, linux_arm64::ProgramEntry, launch);
    Build::bind(builder, macos_arm64::ProgramEntry, launch);
    Build::bind(builder, windows_x86_64::ProgramEntry, other);
}
