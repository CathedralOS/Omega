// A nested machine receives a borrowed record and writes one runtime-selected
// element of it while a shared view of element 0 is still live. `at` may
// select element 0, so the write may change what the view reads: refused.
data Grid { cells: [u64; 4]; total: u64; at: u64; }

machine observe(value: &u64) -> u64 { value }

machine main() crashes Trap {
    let mut grid: Grid = Grid { cells: [0, 0, 0, 0], total: 9, at: 2 };
    block fill(&mut grid);
}

// `fill` only borrows the grid, so each nested machine reaches it through
// that borrow and writes the caller's storage.
machine fill(grid: &mut Grid) crashes Trap {
    transition grid.at < 4 {
        true -> block write(grid)
        _ -> bad()
    }

    machine write(grid: &mut Grid) {
        let view: &u64 = &grid.cells[0];
        grid.cells[grid.at] = 9;
        let seen: u64 = observe(view);
        transition grid.cells[2] == seen {
            true -> good()
            false -> bad()
        }
    }

    machine good() {}
    machine bad() { crash Trap; }
}
