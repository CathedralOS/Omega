// Excluding First and Second on the same stored sum permits reading Third.
// Expected exit: 0
data Choice [copy] {
    case First;
    case Second;
    case Third(amount: u64);
}

data Record [copy] {
    left: u64;
    choice: Choice;
    right: u64;
}

public machine evaluate(record: @Record) -> u64 {
    transition record.choice in Choice::First {
        true -> 11u64
        false -> (match record.choice in Choice::First {
            true -> 17u64
            false -> record.choice.amount
        })
    }
}

machine main() crashes Trap {
    let first: Record = Record { left: 31u64, choice: Choice::First, right: 53u64 };
    let second: Record = Record { left: 31u64, choice: Choice::Second, right: 53u64 };
    let third: Record = Record { left: 31u64, choice: Choice::Third { amount: 67u64 }, right: 53u64 };
    let a: u64 = evaluate(@first);
    let b: u64 = evaluate(@second);
    let c: u64 = evaluate(@third);
    transition a == 11u64 && b == 17u64 && c == 67u64 && third.left == 31u64 && third.right == 53u64 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
