// Rejected: the result would carry the child `Positive::Small` without its
// parent `Positive`.
domain i32::Positive
    requires self > 0;
domain i32::Positive::Small
    requires self < 100;

machine orphan(small: i32 in Positive::Small) -> i32 in Positive::Small {
    small as -Positive =Positive::Small
}

machine main() { }
