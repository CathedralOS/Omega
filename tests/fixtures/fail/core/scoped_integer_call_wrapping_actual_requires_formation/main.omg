// The selected Wrapping payload is zero. Widening that result cannot
// establish the callee's requirement that its input equals 256.
machine restricted(value: u16) -> u16
requires value == 256u16
ensures result == value { value }
machine caller(value: u8)
requires value == 255u8
requires restricted(((value as u8 in Wrapping) + (1u8 as u8 in Wrapping)) as u16)
    == restricted(((value as u8 in Wrapping) + (1u8 as u8 in Wrapping)) as u16) {}
machine main() {}
