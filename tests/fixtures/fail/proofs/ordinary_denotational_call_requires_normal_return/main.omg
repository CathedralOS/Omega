machine partial(value: f32) -> u8 in Saturating
crashes Trap {
    let discarded: u8 in Trapping = (255u8 as u8 in Trapping) + (1u8 as u8 in Trapping);
    0u8 as u8 in Saturating
}

machine harmless(value: f32) -> u8 in Saturating
requires partial(value) == partial(value)
ensures partial(value) == partial(value) {
    0u8 as u8 in Saturating
}

machine main() crashes Trap {
    let observed: u8 in Saturating = 0u8 as u8 in Saturating;
    transition observed == 0u8 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
