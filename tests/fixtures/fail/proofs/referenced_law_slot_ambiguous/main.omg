trait Operations<Value> {
    machine identity(value: Value) -> Value terminates;
    machine law(value: Value) ensures identity(value) == value;
}
machine first(value: u64) -> u64
satisfies Operations<u64>::identity
{ value }
machine second(value: u64) -> u64
satisfies Operations<u64>::identity
{ value }
machine witness(value: u64)
satisfies Operations<u64>::law
ensures first(value) == value
{}
machine main() {}
