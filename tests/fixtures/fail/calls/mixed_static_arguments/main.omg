// Expected exit: 0
machine keep<T, const Count: u64>(value: @T) -> u64
requires Count > 0u64
{ Count }
machine forward<T>(value: @T) -> u64 { keep<T, 0u64>(value) }
machine measure<T>(value: @T) -> u64 { 41u64 }
machine invoke<T, const Step: machine(value: @T) -> u64>(value: @T) -> u64 { Step(value) }
machine selected<T>(value: @T) -> u64 { invoke<T, measure<T>>(value) }
machine main() crashes Trap {
    let input: u32 = 17u32;
    let count: u64 = forward<u32>(@input);
    let answer: u64 = selected<u32>(@input);
    transition count == 3u64 && answer == 41u64 && input == 17u32 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
