use omega::language::core::Never;

public data Outcome<T, E> {
    case Ok(value: T);
    case Err(error: E);
}

public machine take_value(outcome: Outcome<u32, u32>) -> u32 {
    match outcome {
        Outcome::Ok { value } -> value
    }
}

public machine read_value(outcome: &Outcome<u32, u32>) -> u32 {
    match outcome {
        Outcome::Ok { value } -> value
    }
}

machine main() crashes Trap {
    let outcome: Outcome<u32, u32> = Outcome::Ok { value: 42u32 };
    let borrowed: u32 = read_value(&outcome);
    let owned: u32 = take_value(outcome);
    transition borrowed == 42u32 && owned == 42u32 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
