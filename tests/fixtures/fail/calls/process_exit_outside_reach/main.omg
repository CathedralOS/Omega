use omega::language::core::ProcessExit;
data Main { status: i32; }

machine require_success(status: i32) ensures status == 0 reaches ProcessExit {
    transition status == 0 {
        true -> {}
        false -> ProcessExit::exit_process(status)
    }
}

machine main(root: &mut Main) reaches none {
    require_success(root.status);
    ProcessExit::exit_process(0);
}

machine entry_start() reaches ProcessExit {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
