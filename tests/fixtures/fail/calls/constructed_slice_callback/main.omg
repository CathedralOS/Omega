// Expected exit: 0
// A callback keeps a slice's exact open element type through another generic application.
machine length<Element>(items: @mut [Element]) -> u64 { items.len }
machine apply<machine Read, Payload>(value: @Payload) -> u64
requires machine Read(value: @Payload) -> u64;
{ Read(value) }
public machine forward<Element>(items: @[Element]) -> u64 {
    apply<length<Element>>(items)
}
machine main() crashes Trap {
    let bytes: [u8; 3] = [17u8, 37u8, 91u8];
    let words: [u16; 2] = [257u16, 513u16];
    let first: u64 = forward<u8>(@bytes[..]);
    let second: u64 = forward<u16>(@words[..]);
    transition first == 3u64 && second == 2u64
        && bytes[0u64] == 17u8 && bytes[1u64] == 37u8 && bytes[2u64] == 91u8
        && words[0u64] == 257u16 && words[1u64] == 513u16 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
