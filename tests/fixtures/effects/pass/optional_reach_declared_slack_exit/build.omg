use main.omg as app;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "reach_declared_slack" };
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::audit_service::<|app|::Unused>(builder);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, macos_arm64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, windows_x86_64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, linux_x86_64);
    Build::select_provider::<|app|::Mark, |app|::MarkerMark>(builder, linux_arm64);
}
