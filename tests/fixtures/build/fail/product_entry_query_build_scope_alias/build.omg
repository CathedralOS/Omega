// FAIL CANARY -- `support` is supplied only as a Build library at invocation.
// Its helper declares `public machine launch()`, but a Build library grants no
// Product selection scope. Only the executed Product query uses the file alias,
// so the refusal occurs when Product lookup checks the dependency grant.

use {support}/setup/setup.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "product_entry_query_build_scope_alias" };
    let entry: ProductEntryRef = BuildDeclarations::entry(@builder.declarations, "|setup|::launch", "windows_x86_64::ProgramEntry");
    Build::bind(builder, windows_x86_64::ProgramEntry, entry);
}
