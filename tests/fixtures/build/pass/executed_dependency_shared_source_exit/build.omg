machine build(builder: @mutable Build) {
    Build::application(builder, "executed_dependency_shared_source_exit");
    select_dependency(builder);
    let mutable shared_dependency: DependencyDescription = dependency\from_source(Source::Path { location: "../executed_dependency_source_library" });
    dependency\with_alias(@mutable shared_dependency, "shared");
    let shared_registration: DependencyRegistration = Build::dependency(builder, shared_dependency);
    Build::bind(builder, windows_x86_64\ProgramEntry, main);
    Build::bind(builder, linux_x86_64\ProgramEntry, main);
    Build::bind(builder, linux_arm64\ProgramEntry, main);
    Build::bind(builder, macos_arm64\ProgramEntry, main);
}

machine select_dependency(builder: @mutable Build) {
    let mutable selected_dependency: DependencyDescription = dependency\from_source(Source::Path { location: "../executed_dependency_source_library" });
    dependency\with_alias(@mutable selected_dependency, "selected");
    let selected_registration: DependencyRegistration = Build::dependency(builder, selected_dependency);
}
