use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "executed_dependency_source_join_exit" };
    select_dependency(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}

machine select_dependency(builder: @mutable BuildPlan) {
    transition true {
        true -> selected_dependency(builder),
        false -> unselected_dependency(builder)
    }
}

machine selected_dependency(builder: @mutable BuildPlan) {
    let mutable selected_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../executed_dependency_source_library" });
    |dependency|::with_alias(@mutable selected_dependency, "selected");
    let selected_registration: DependencyRegistration = Build::dependency(builder, selected_dependency);
}

machine unselected_dependency(builder: @mutable BuildPlan) {
    let mutable absent_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../must_not_be_acquired" });
    |dependency|::with_alias(@mutable absent_dependency, "absent");
    let absent_registration: DependencyRegistration = Build::dependency(builder, absent_dependency);
}
