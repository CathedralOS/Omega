// Expected exit: 0. Equality observes both values once, in source order.
data Signal [copy] {
    case Ready;
    case Waiting;
    case Done;
    case Unused;
}
data Context [copy] { signal: Signal; calls: u32; }
data Message [copy] { case Empty; case Number(value: i32); }
MessageEquality satisfies Equatable<Message> {
    machine equals(left: &Message, right: &Message) -> bool { false }
}
data Key [copy] { case A; case B; }
machine == key_equal(left: Key, right: Key) -> bool { false }
machine same(left: Signal, right: Signal) -> bool { left == right }
machine different(left: Signal, right: Signal) -> bool { left != right }
machine borrowed(left: &Signal, right: &Signal) -> bool { left == right }
machine marked(context: &mut Context, next: Signal) -> Signal {
    context.calls = context.calls +% 1u32;
    context.signal = next;
    next
}
machine main() crashes Trap {
    // Atomic observation supplies a runtime selector, so the comparison
    // callees cannot all disappear through constant folding.
    let mut selector: AtomicBool;
    selector.store(true, NoOrdering);
    let ready: Signal = match selector.load(NoOrdering) {
        true -> Signal::Ready,
        false -> Signal::Waiting
    };
    let waiting: Signal = Signal::Waiting;
    let mut context: Context = Context { signal: ready, calls: 0u32 };
    let snapshot: bool = context.signal == marked(&mut context, waiting);
    let ordered: bool = marked(&mut context, ready) != marked(&mut context, Signal::Done);
    let computed: bool = (match true { true -> ready, false -> waiting }) == ready;
    let message: Message = Message::Number { value: 17 };
    let selected: bool = message == message;
    let selected_different: bool = message != message;
    let key: Key = Key::A;
    let operator_selected: bool = key == key;
    transition same(ready, ready) && same(waiting, waiting)
        && different(ready, waiting) && different(waiting, Signal::Done)
        && borrowed(&ready, &ready) && computed && snapshot == false && ordered
        && context.signal == Signal::Done && context.calls == 3u32
        && selected == false && selected_different && operator_selected == false {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
