// Expected exit: 0.
// The compiler checks the generic body once for every admitted type.
// relay proves its bound from forward's contract. Both take item by shared
// reference so the caller keeps ownership of the value. This program runs
// the same proof with u8 and bool. The fail twin promises an upper bound
// of 10 where this program promises 11.
machine forward<T>(item: @T, limit: u32) -> u32
requires limit <= 10
ensures result <= 10
crashes none
{
    limit
}
machine relay<T>(item: @T, limit: u32) -> u32
requires limit <= 10
ensures result <= 11
crashes none
{
    forward::<T>(item, limit) + 1
}
machine main() crashes Trap {
    let small_item: u8 = 3u8;
    let flag_item: bool = true;
    let small: u32 = relay::<u8>(@small_item, 4);
    let flagged: u32 = relay::<bool>(@flag_item, 9);
    transition small == 5 && flagged == 10 { true -> done(), false -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
