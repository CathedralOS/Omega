// Expected exit: 0. Reading an indexed borrow keeps its original array address.
machine read(value: @u8) -> u8 { value }
machine main() crashes Trap {
    let bytes: [u8; 3] = [17u8, 37u8, 91u8];
    let view: @[u8] = @bytes[..];
    let first: u8 = read(@view[0u64]);
    let middle: u8 = read(@view[1u64]);
    let last: u8 = read(@view[2u64]);
    transition first == 17u8 && middle == 37u8 && last == 91u8
        && bytes[0u64] == 17u8 && bytes[1u64] == 37u8 && bytes[2u64] == 91u8 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
