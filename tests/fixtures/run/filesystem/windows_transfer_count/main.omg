// The filesystem_receiver test stages the exact production count/completion
// helper beside this program. No OS handle or giant buffer is manufactured.
machine main() crashes Trap {
    let zero: u64 = windows_transfer_count(0, 0);
    let one: u64 = windows_transfer_count(1, 1);
    let below: u64 = windows_transfer_count(4294967294, 4294967294);
    let maximum: u64 = windows_transfer_count(4294967295, 4294967295);
    let above: u64 = windows_transfer_count(4294967296, 4294967296);
    let widest: u64 = windows_transfer_count(18446744073709551615, 18446744073709551615);
    let mut bytes: [u8; 5] = [11, 12, 13, 14, 15];
    let prefix: bool = mark_prefix(&mut bytes, 3);
    transition zero == 0 && one == 1 && below == 4294967294
        && maximum == 4294967295 && above == 4294967295 && widest == 4294967295
        && prefix && bytes[0] == 91 && bytes[1] == 12 && bytes[2] == 93
        && bytes[3] == 14 && bytes[4] == 15
        && windows_transfer_completion(-87, -5) == -87
        && windows_transfer_completion(7, -5) == -5
        && windows_transfer_completion(7, 0) == 7
        && windows_transfer_completion(0, 0) == 0
    { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}

machine mark_prefix(bytes: &mut [u8; 5], requested: u64) -> bool
requires requested <= bytes.len
{
    let count: u64 = windows_transfer_count(requested, bytes.len);
    transition count == 3 {
        true -> mark(&mut bytes[0..count])
        false -> false
    }
    machine mark(prefix: &mut [u8]) -> bool
    requires prefix.len == 3
    {
        let correct: bool = prefix[0] == 11 && prefix[1] == 12 && prefix[2] == 13;
        prefix[0] = 91;
        prefix[2] = 93;
        correct
    }
}
