// Expected exit: 0
data Main {
    buffer: [u8; 64];
    written: u64;
    read: u64;
    pause: [u8; 6];
}
data Decoded { room: u64; length: u64; first: i64; second: i64; depth: i64; }

public machine check_fields(main: @mut Main, decoded: Decoded) -> u64
requires true
{
        let bytes_ok: bool = main.buffer[0u64] == 0u8
            && main.buffer[1u64] == 0u8
            && main.buffer[2u64] == 3u8
            && main.buffer[3u64] == 0u8
            && main.buffer[4u64] == 172u8
            && main.buffer[5u64] == 2u8
            && main.buffer[6u64] == 1u8
            && main.buffer[7u64] == 3u8
            && main.buffer[8u64] == 172u8
            && main.buffer[9u64] == 2u8
            && main.buffer[10u64] == 3u8
            && main.buffer[11u64] == 2u8
            && main.buffer[12u64] == 127u8;
    let fields_ok: bool = decoded.room == 300u64
        && decoded.length == 2u64 && decoded.first == 150i64
        && decoded.second == 0i64 - 2i64 && decoded.depth == 0i64 - 64i64;
    transition bytes_ok && fields_ok {
        true -> block good(main)
        false -> block bad_fields(main)
    }

    machine good(main: @mut Main) -> u64 {
        main.pause[0u64] = 17u8;
        70u64
    }

    machine bad_fields(main: @mut Main) -> u64 {
        main.pause[0u64] = 29u8;
        72u64
    }
}

machine main() crashes Trap {
    let mut input: Main = Main {
        buffer: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
        written: 0u64, read: 0u64, pause: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8]
    };
    input.buffer[2u64] = 3u8;
    input.buffer[4u64] = 172u8;
    input.buffer[5u64] = 2u8;
    input.buffer[6u64] = 1u8;
    input.buffer[7u64] = 3u8;
    input.buffer[8u64] = 172u8;
    input.buffer[9u64] = 2u8;
    input.buffer[10u64] = 3u8;
    input.buffer[11u64] = 2u8;
    input.buffer[12u64] = 127u8;
    input.buffer[13u64] = 53u8;
    let matched: u64 = check_fields(@mut input, Decoded {
        room: 300u64, length: 2u64, first: 150i64, second: 0i64 - 2i64, depth: 0i64 - 64i64
    });
    let matched_marker: u8 = input.pause[0u64];
    input.buffer[12u64] = 126u8;
    let missed: u64 = check_fields(@mut input, Decoded {
        room: 300u64, length: 2u64, first: 150i64, second: 0i64 - 2i64, depth: 0i64 - 64i64
    });
    transition matched == 70u64 && matched_marker == 17u8 && missed == 72u64
        && input.pause[0u64] == 29u8 && input.buffer[13u64] == 53u8 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
