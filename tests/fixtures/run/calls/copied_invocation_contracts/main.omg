// Expected exit: 0
boundary trait Handler {}
boundary trait Other {}
boundary trait Registrar {
    machine execute(value: u32) -> u32 reaches none crashes none invokes Handler;
}
Runner satisfies Registrar {
    machine execute(value: u32) -> u32 reaches none crashes none { value }
}
machine relay<const Choice: u64>(value: u32) -> u32
reaches none crashes none invokes Handler
{
    Registrar::execute(value)
}
machine main() crashes Trap {
    let first: u32 = relay::<1>(19u32);
    let second: u32 = relay::<2>(23u32);
    transition first == 19u32 && second == 23u32 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
