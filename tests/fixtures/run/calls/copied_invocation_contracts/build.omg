machine build(builder: &mut Build) {
    Build::application(builder, "copied_invocation_contracts");
    Build::select_provider<Registrar, Runner>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<Registrar, Runner>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<Registrar, Runner>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<Registrar, Runner>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
