// Expected exit: 0
// Each copied loop body retains the selected record operation's exact parameter.
data Counter { before: u64; value: u64; after: u64; }
trait Operations { machine apply(counter: &mut Counter) reaches none; }
Selected satisfies Operations {
    machine apply(counter: &mut Counter) reaches none { counter.value = counter.value +% 1u64; }
}
machine dispatch<const Operation: Operations>(counter: &mut Counter) reaches none {
    first(counter, true)
    machine first(counter: &mut Counter, again: bool) reaches none {
        transition again { true -> second(counter, false) false -> done() }
    }
    machine second(counter: &mut Counter, again: bool) reaches none {
        Operation::apply(counter);
        first(counter, again)
    }
    machine done() reaches none {}
}
machine main() crashes Trap {
    let mut counter: Counter = Counter { before: 11u64, value: 41u64, after: 29u64 };
    dispatch<Selected>(&mut counter);
    dispatch<Selected>(&mut counter);
    transition counter.before == 11u64 && counter.value == 43u64 && counter.after == 29u64 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
