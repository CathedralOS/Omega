use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
use omega::language::core::AccessLifecycle;
use omega::language::core::NativeAccess;
machine build(builder: &mut Build) {
    let alloc_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/alloc" }));
    let standard: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../../../source/library/std" }));
    Build::application(builder, "bump_allocator_canary");
    Build::accept_boundary<MemorySupply>(builder);
    Build::accept_boundary<TestRoots>(builder);
    Build::accept_boundary<TestVacant>(builder);
    Build::accept_boundary<NativeAllocation::allocate>(builder);
    Build::accept_boundary<NativeAccess<WordPolicy, Word, WordStorage, TestMemory>>(builder);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, windows_x86_64);
    Build::select_provider<VacantContentTransfer, TestVacant>(builder, windows_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, windows_x86_64);
    Build::select_provider<AccessLifecycle<WordPolicy, Word>, NativeAccess<WordPolicy, Word, WordStorage, TestMemory>>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, linux_x86_64);
    Build::select_provider<VacantContentTransfer, TestVacant>(builder, linux_x86_64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, linux_x86_64);
    Build::select_provider<AccessLifecycle<WordPolicy, Word>, NativeAccess<WordPolicy, Word, WordStorage, TestMemory>>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, macos_arm64);
    Build::select_provider<VacantContentTransfer, TestVacant>(builder, macos_arm64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, macos_arm64);
    Build::select_provider<AccessLifecycle<WordPolicy, Word>, NativeAccess<WordPolicy, Word, WordStorage, TestMemory>>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider<ExtentRootProvider, TestRoots>(builder, linux_arm64);
    Build::select_provider<VacantContentTransfer, TestVacant>(builder, linux_arm64);
    Build::select_provider<ResourceProfileSupply<TestMemory>, MemorySupply>(builder, linux_arm64);
    Build::select_provider<AccessLifecycle<WordPolicy, Word>, NativeAccess<WordPolicy, Word, WordStorage, TestMemory>>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind<NativeAllocation::allocate>(builder, windows_x86_64, ForeignBinding::DllImport { import: DllImport::PeByName { library: "msvcrt.dll", export: "calloc" } });
    Build::bind<NativeAllocation::allocate>(builder, linux_x86_64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.2.5" } });
    Build::bind<NativeAllocation::allocate>(builder, linux_arm64, ForeignBinding::DllImport { import: DllImport::ElfVersioned { object: "libc.so.6", symbol: "calloc", version: "GLIBC_2.17" } });
    Build::bind<NativeAllocation::allocate>(builder, macos_arm64, ForeignBinding::DllImport { import: DllImport::MachODylibSymbol { install_name: "libSystem.B.dylib", symbol: "_calloc" } });
}
