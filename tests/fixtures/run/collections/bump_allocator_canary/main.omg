// Expected exit: 0
// Real allocator backing survives two coexisting residents, exhaustion,
// release, checked extent recomposition, full reset, and resident reuse.
use omega::language::core::Extent;
use omega::language::core::Extent::Vacant;
use omega::language::core::Extent::Resident;
use omega::language::core::VacantContentTransfer;
use omega::language::core::merge_vacant_extents;
