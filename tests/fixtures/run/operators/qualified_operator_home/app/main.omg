use measure::units;

machine main() crashes Trap {
    let distance_left: u32 in Distance = 2u32 as +Distance;
    let distance_right: u32 in Distance = 5u32 as +Distance;
    let distance: u32 in Distance = distance_left + distance_right;
    let span_left: u32 in Span = 3u32 as +Span;
    let span_right: u32 in Span = 8u32 as +Span;
    let span: u32 in Span = span_left + span_right;
    transition (distance as -Distance) == 7u32 && (span as -Span) == 21u32 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
