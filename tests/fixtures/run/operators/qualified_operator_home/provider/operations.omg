module operations;
use units;

machine raw_sum(left: u32, right: u32) -> u32 {
    (left +% right) +% 20u32
}

// The consumer imports units, never this declaring module.
public machine + Offset::add(left: u32 in Offset, right: u32 in Offset) -> u32 in Offset {
    raw_sum(left as -Offset, right as -Offset) as +Offset
}
