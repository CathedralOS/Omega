use units;

machine raw_sum(left: u32, right: u32) -> u32 {
    left +% right
}

// Association with Distance must not switch this body's lexical helper.
public machine + Distance::add(left: u32 in Distance, right: u32 in Distance) -> u32 in Distance {
    raw_sum(left as -Distance, right as -Distance) as +Distance
}
