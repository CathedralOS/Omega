public boundary trait Reading {
    machine read(value: f64) -> f64 reaches none crashes none;
}
SelectedReading satisfies Reading {
    machine read(value: f64) -> f64 { value + 1.0 }
}
machine main() crashes Trap {
    let value: f64 = Reading::read(41.0);
    transition value == 42.0 { true -> done() false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
