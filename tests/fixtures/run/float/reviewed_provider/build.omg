machine build(builder: &mut Build) {
    Build::application(builder, "reviewed_float_provider");
    Build::select_provider<Reading, SelectedReading>(builder, linux_x86_64);
    Build::select_provider<Reading, SelectedReading>(builder, linux_arm64);
    Build::select_provider<Reading, SelectedReading>(builder, macos_arm64);
    Build::select_provider<Reading, SelectedReading>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
