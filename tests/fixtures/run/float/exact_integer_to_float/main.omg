// Exact integer-to-float casts preserve the integer value.
// Expected exit: 0
machine wide(value: i32) -> f64
requires true {
    value as f64
}

machine single(value: i64) -> f32
requires value == 0i64 || value == 16777216i64
    || value == 1152921504606846976i64 || value == -1152921504606846976i64 {
    value as f32
}

machine unsigned(value: u64) -> f64
requires value == 0u64 || value == 9223372036854775808u64 {
    value as f64
}

machine main() crashes Trap {
    let single_zero: f32 = single(0i64);
    let unsigned_zero: f64 = unsigned(0u64);
    transition wide(42i32) == 42.0f64 && wide(-17i32) == -17.0f64
        && single(16777216i64) == 16777216.0f32
        && single(1152921504606846976i64) == 1152921504606846976.0f32
        && single(-1152921504606846976i64) == -1152921504606846976.0f32
        && unsigned(9223372036854775808u64) == 9223372036854775808.0f64
        && single_zero == 0.0f32 && 1.0f32 / single_zero > 0.0f32
        && unsigned_zero == 0.0f64 && 1.0f64 / unsigned_zero > 0.0f64 {
        true -> done()
        _ -> bad()
    }
    machine done() { }
    machine bad() { crash Trap; }
}
