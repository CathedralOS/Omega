// Expected exit: 0
boundary trait Service {
    machine tick() -> u64 reaches none crashes none;
}
Selected satisfies Service { machine tick() -> u64 reaches none crashes none { 29u64 } }
Unselected satisfies Service { machine tick() -> u64 reaches none crashes none { 37u64 } }
boundary trait NativeAllocation {
    machine allocate(count: u64, width: u64) -> addr
    reaches NativeAllocation requires count == 1
    ensures result == 0 || no_wrap(result, width) crashes none;
    machine other(count: u64, width: u64) -> addr
    reaches NativeAllocation requires count == 1
    ensures result == 0 || no_wrap(result, width) crashes none;
}
machine main() crashes Trap {
    let observed: u64 = Service::tick();
    // The process owns this small allocation until normal termination.
    let address: addr = NativeAllocation::allocate(1u64, 8u64);
    transition observed == 29u64 && address != 0 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
