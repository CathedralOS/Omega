// Expected exit: 0. Generic cases keep the selected payload and its ownership.
data Ticket [linear] { number: u64; }
data Outcome<T> { case Missing; case Present(item: T); }
machine present<T>(value: T) -> Outcome<T> {
    Outcome::Present { item: move value }
}
machine absent<T>() -> Outcome<T> { Outcome::Missing }
machine rebuild<T>(value: Outcome<T>) -> Outcome<T> {
    transition value {
        Outcome::Missing -> Outcome::Missing
        Outcome::Present { item } -> Outcome::Present { item: move item }
    }
}
machine observe<T>(value: @T) -> Outcome<T> { Outcome::Missing }
machine main() crashes Trap {
    let empty: Outcome<Ticket> = rebuild<Ticket>(absent<Ticket>());
    let full: Outcome<Ticket> = rebuild<Ticket>(present<Ticket>(Ticket { number: 29u64 }));
    transition empty {
        Outcome::Missing -> read(move full)
        Outcome::Present { item } -> unexpected(move item, move full)
    }
    machine read(value: Outcome<Ticket>) crashes Trap {
        transition value {
            Outcome::Present { item } -> check(move item)
            Outcome::Missing -> wrong()
        }
    }
    machine check(item: Ticket) crashes Trap {
        let { number } = move item;
        transition number == 29u64 { true -> done() false -> wrong() }
    }
    machine unexpected(item: Ticket, value: Outcome<Ticket>) crashes Trap { crash Trap; }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
