machine build(builder: &mut Build) {
    Build::application(builder, "stored_descriptor_boundary");
    Build::select_provider<Probe, CheckedProbe>(builder, macos_arm64);
    Build::select_provider<Probe, CheckedProbe>(builder, linux_arm64);
    Build::select_provider<Probe, CheckedProbe>(builder, linux_x86_64);
    Build::select_provider<Probe, CheckedProbe>(builder, windows_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
