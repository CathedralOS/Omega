// A returned element reference borrows only the array it was selected from,
// so the caller can still write the grid's separate `tag` field while the
// reference is live.
data Cell { x: i64; y: i64; }
data Grid { cells: [Cell; 4]; tag: i64; }
machine pick<'a>(grid: &'a mut Grid, index: u64) -> &'a mut i64 requires index < 4 {
    &mut grid.cells[index].x
}
machine main() crashes Trap {
    let mut grid: Grid = Grid {
        cells: [Cell { x: 1, y: 2 }, Cell { x: 3, y: 4 }, Cell { x: 5, y: 6 }, Cell { x: 7, y: 8 }],
        tag: 0,
    };
    let index: u64 = 1;
    let chosen: &mut i64 = pick(&mut grid, index);
    grid.tag = 9;
    chosen = 10;
    transition grid.cells[1].x == 10 && grid.tag == 9 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
