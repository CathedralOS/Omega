machine build(builder: @mut Build) {
    Build::application(builder, "boundary_ordinary_parent");
    Build::select_provider<Leaf, LocalLeaf>(builder, windows_x86_64);
    Build::select_provider<Leaf, LocalLeaf>(builder, linux_x86_64);
    Build::select_provider<Leaf, LocalLeaf>(builder, linux_arm64);
    Build::select_provider<Leaf, LocalLeaf>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
