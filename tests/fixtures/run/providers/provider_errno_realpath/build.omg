use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;

machine build(builder: &mut Build) {
    Build::application(builder, "provider_errno_realpath");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind<HostRealpath::resolve>(builder, linux_x86_64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "realpath", version: "GLIBC_2.3"
        } });
    Build::bind<HostErrno::slot>(builder, linux_x86_64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "__errno_location", version: "GLIBC_2.2.5"
        } });
    Build::bind<HostRealpath::resolve>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_realpath"
        } });
    Build::bind<HostErrno::slot>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "___error"
        } });
}
