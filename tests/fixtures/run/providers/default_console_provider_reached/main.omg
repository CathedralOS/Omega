use omega::language::core::ProcessExit;
use omega_language_std::Console;

// Expected exit: 0. Expected stdout: "K\n".
// The application's Build selects no provider. The standard library's Build
// supplies Console and its private byte provider for the selected target.
// ProcessExit is separate and requires its own admitted authority.
data Main { }
machine main(root: &mut Main) reaches ProcessExit + Console {
    Console::write_byte(75);
    Console::write_byte(10);
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit + Console {
    let mut entry_storage: Main;
    main(&mut entry_storage);
}
