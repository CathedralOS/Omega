// Expected exit: 0
// Slices keep the selected bytes, their exact length and the original backing.
machine first(bytes: &[u8]) -> u8 requires bytes.len > 0 { bytes[0] }
machine suffix<'a>(bytes: &'a [u8]) -> &'a [u8] requires bytes.len > 0 {
    bytes[1..]
}
machine main() crashes Trap {
    let bytes: &[u8] = "AXYZ";
    let middle: &[u8] = bytes[1..3];
    let tail: &[u8] = middle[1..];
    let returned: &[u8] = suffix(bytes);
    let empty: &[u8] = bytes[4..];
    transition first(middle) == 88 && tail[0] == 89
        && middle.len == 2 && tail.len == 1 && returned.len == 3
        && empty.len == 0 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
