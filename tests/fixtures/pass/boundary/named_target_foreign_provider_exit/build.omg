machine build(builder: &mut Build) {
    Build::application(builder, "named_target_foreign_provider_exit");
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, linux_arm64);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, linux_x86_64);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, macos_arm64);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, macos_x86_64);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, windows_x86_64);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, uefi_x86_64);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, cross_platform_cli);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, local_unchecked);
    Build::select_provider<ProcessProbe, ProcessProvider>(builder, alpha_bootstrap);
    Build::select_provider<TableProbe, TableProvider>(builder, linux_arm64);
    Build::select_provider<TableProbe, TableProvider>(builder, linux_x86_64);
    Build::select_provider<TableProbe, TableProvider>(builder, macos_arm64);
    Build::select_provider<TableProbe, TableProvider>(builder, macos_x86_64);
    Build::select_provider<TableProbe, TableProvider>(builder, windows_x86_64);
    Build::select_provider<TableProbe, TableProvider>(builder, uefi_x86_64);
    Build::select_provider<TableProbe, TableProvider>(builder, cross_platform_cli);
    Build::select_provider<TableProbe, TableProvider>(builder, local_unchecked);
    Build::select_provider<TableProbe, TableProvider>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
