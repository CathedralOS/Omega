// A qualified shared byte view retains its length through a boundary call.
// Expected exit: 0

machine four_bytes(input: &[u8]) -> bool { input.len == 4u64 }
domain [u8]::FourBytes requires four_bytes(&self[..]);

boundary trait ByteCount {
    machine length(input: &[u8] in FourBytes) -> u64 reaches none crashes none;
}

CountBytes satisfies ByteCount {
    machine length(input: &[u8] in FourBytes) -> u64 reaches none crashes none {
        (input as -FourBytes).len
    }
}

machine main() crashes Trap {
    let length: u64 = ByteCount::length("room" as +FourBytes);
    transition length == 4u64 {
        true -> done()
        false -> fail()
    }
    machine done() {}
    machine fail() { crash Trap; }
}
