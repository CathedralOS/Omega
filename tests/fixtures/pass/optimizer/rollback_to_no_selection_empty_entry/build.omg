// One selected rule on an empty entry, realized on every hosted target.
//
// The fixture's declared `rollback.txt` overlay names two rules but the
// build authors only `ControlFlowCleanup`: settlement subtracts the
// authored one, so the receipt records `requested` as a superset of
// `applied=[ControlFlowCleanup]` beside `module:same` -- the rule is
// rolled back but its rewrite was already inert on an empty `main`, and
// requesting a rule the build never authored is legal. The
// `rollback_control_flow_cleanup` pair carries the subtraction beside
// `module:differs` -- the contrast is the point.

machine build(builder: &mut Build) {
    Build::application(builder, "rollback_to_no_selection_empty_entry");
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::ControlFlowCleanup,
    );
}
