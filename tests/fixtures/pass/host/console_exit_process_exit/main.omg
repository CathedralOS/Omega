use omega::language::core::ProcessExit;
// One console line, then termination through `ProcessExit::exit_process` with
// status 70. `write_line` is checked std code over the `write_byte`
// intrinsic; `exit_process` ends the process, so nothing after it runs.
use omega_language_std::Console;

data Main { }

machine run(main: &mut Main)
reaches ProcessExit + Console
{
    Console::write_line("console-exit-process");
    ProcessExit::exit_process(70);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches ProcessExit + Console
{
    let mut entry_storage: Main;
    run(&mut entry_storage);
}
