use omega::language::core::ProcessExit;
use omega_language_std::Clock;

// `Clock::sleep` holds the caller's worker for the whole wait, so std declares
// it `blocks` and the call writes `block`. Its twin under
// `fail/effects/clock_sleep_unacknowledged` omits only that marker.
machine entry_start() reaches ProcessExit + Clock {
    block Clock::sleep(200);
    ProcessExit::exit_process(70);
}
