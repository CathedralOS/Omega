// A nested machine receives a borrowed record and writes one runtime-selected
// element of it while a shared view of a different field is still live. The
// write and the view name disjoint storage, so the program is accepted.
data Grid { cells: [u64; 4]; total: u64; }

machine observe(value: &u64) -> u64 { value }

machine fill(grid: &mut Grid, at: u64) -> u64 {
    transition { _ -> check(grid, at) }

    machine check(grid: &mut Grid, at: u64) -> u64 {
        transition at < 4 {
            true -> write(grid, at)
            _ -> 0
        }
    }

    machine write(grid: &mut Grid, at: u64) -> u64
    requires at < 4 {
        let view: &u64 = &grid.total;
        grid.cells[at] = 9;
        observe(view)
    }
}

machine main() crashes Trap {
    let mut grid: Grid = Grid { cells: [0, 0, 0, 0], total: 9 };
    let seen: u64 = fill(&mut grid, 2);
    transition seen == 9 && grid.cells[2] == 9 {
        true -> good()
        false -> bad()
    }
    machine good() {}
    machine bad() { crash Trap; }
}
