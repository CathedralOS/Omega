// A nested machine receives a borrowed record and writes one runtime-selected
// element of it while a shared view of a different field is still live. The
// write and the view name disjoint storage, so the program is accepted.
data Grid { cells: [u64; 4]; total: u64; at: u64; }

machine observe(value: &u64) -> u64 { value }

machine main() crashes Trap {
    let mut grid: Grid = Grid { cells: [0, 0, 0, 0], total: 9, at: 2 };
    transition {
        _ -> block guard(&mut grid)
    }

    machine guard(grid: &mut Grid) {
        transition grid.at < 4 {
            true -> block fill(grid)
            _ -> bad()
        }
    }

    machine fill(grid: &mut Grid) {
        let view: &u64 = &grid.total;
        grid.cells[grid.at] = 9;
        let seen: u64 = observe(view);
        transition grid.cells[2] == seen {
            true -> good()
            false -> bad()
        }
    }

    machine good() {}
    machine bad() { crash Trap; }
}
