// Ground contract predicates keep their layout observations portable until
// target closure. Direct, named and Boolean-composed queries use one proof
// route, including a call reached through another state. Expected exit: 0.
data Cell { code: u64; tag: u64; }
const BYTES: u64 = size_of<Cell>();

machine direct() requires size_of<Cell>() >= 8 {}
machine named() requires BYTES == 16 {}
machine casted() requires (BYTES as u64) == 16 {}
machine arithmetic() requires BYTES + 0 == 16 {}
machine composed() requires !(size_of<Cell>() < align_of<Cell>())
    && (BYTES == 16 || size_of<Cell>() == 0) {}

machine program() {
    direct();
    named();
    casted();
    arithmetic();
    transition { _ -> later() }
    machine later() { composed(); }
}
