// Source-produced helper custody qualification; no native entry is bound.
// The embedding test establishes exact backings and checks external effects.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::LayoutStorage;
use omega::language::core::LayoutTarget;
use omega::language::core::FixedLayout;
use omega::language::core::Exposure;
use omega::language::core::ExternalRead;
use omega::language::core::FieldAccess;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPolicy;
use omega::language::core::Issuance;
use omega::language::core::reflect::TypeSchema;
use omega::language::core::reflect::field;
use omega::language::core::access;
use omega::language::core::Accessor;
use omega::language::core::read;
use omega::language::core::write;

public data Registers {
    status: u32;
    transmit: u8;
}

// Geometry and access are separate selections: the layout places status at 0
// and transmit at 4, and the policy grants an external read of status and an
// external write of transmit, with no issuer restriction and no added reach.
public data RegisterStorage = LayoutStorage<Registers, RegisterLayout>;
public domain Registers::Placed
    access RegisterAccess;

public RegisterLayout satisfies FixedLayout<Registers> {
    public machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches none crashes none terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 4 } };
        LayoutPlan { entries: entries, entry_count: 2, size_fixed: 8, size_is_dynamic: false, align: 4 }
    }
}

public RegisterAccess satisfies AccessPolicy {
    machine plan(schema: TypeSchema) -> AccessPlan reaches none crashes none terminates {
        let mut plan: AccessPlan = access::new_plan(&schema, Issuance::Unrestricted);
        access::observe(&mut plan, field(Registers::status),
            FieldAccess::External { read: ExternalRead::Read, write: false, exposure: Exposure::Exported });
        access::observe(&mut plan, field(Registers::transmit),
            FieldAccess::External { read: ExternalRead::None, write: true, exposure: Exposure::Exported });
        plan
    }
}

// The host establishes the backing and binds these exact generated accessors.
// Delegation retains the original backing; neither wrapper stages contents.
machine observe(view: &RegisterStorage in Registers::Placed) -> u32 {
    read<Accessor<u32>, u32>(&view.status)
}

machine delegate(view: &RegisterStorage in Registers::Placed) -> u32 { observe(view) }

machine mutate(view: &mut RegisterStorage in Registers::Placed) -> u32 {
    write<Accessor<u8>, u8>(&mut view.transmit, 9u8);
    read<Accessor<u32>, u32>(&view.status)
}

machine delegate_mutable(view: &mut RegisterStorage in Registers::Placed) -> u32 { mutate(view) }

machine forward(view: &mut RegisterStorage in Registers::Placed) -> u32 { delegate_mutable(view) }

machine ordered(first: &RegisterStorage in Registers::Placed, second: &RegisterStorage in Registers::Placed) -> u64 {
    let first_status: u32 = observe(first);
    let second_status: u32 = observe(second);
    (first_status as u64) * 1000 + (second_status as u64)
}

machine reordered(left: &RegisterStorage in Registers::Placed, right: &RegisterStorage in Registers::Placed) -> u64 {
    ordered(right, left)
}

machine alias_entry(shared: &RegisterStorage in Registers::Placed, exclusive: &mut RegisterStorage in Registers::Placed) -> u64 {
    let first: u32 = observe(shared);
    let second: u32 = mutate(exclusive);
    (first as u64) + (second as u64)
}

public data Plain { value: u32; }

machine mixed(seed: u32, plain: &Plain, view: &mut RegisterStorage in Registers::Placed) -> u64 {
    let status: u32 = delegate_mutable(view);
    (seed as u64) + (plain.value as u64) + (status as u64)
}

machine ordinary_alias(view: &RegisterStorage in Registers::Placed, storage: &mut Plain) -> u32 {
    observe(view)
}

machine later(view: &mut RegisterStorage in Registers::Placed) -> u32 {
    transition { _ -> next(view) }
    machine next(view: &mut RegisterStorage in Registers::Placed) -> u32 {
        delegate_mutable(view)
    }
}

// Unit-returning helpers use the same structural telescope and occurrence.
machine write_only(view: &mut RegisterStorage in Registers::Placed) {
    write<Accessor<u8>, u8>(&mut view.transmit, 9u8);
}
machine unit_delegate(view: &mut RegisterStorage in Registers::Placed) -> u32 {
    write_only(view);
    observe(view)
}

// Initialized ordinary RAM lends its source through the explicit factory.
// Runtime acceptance is 41 with transmit changed to 9 in the same backing.
machine ram_borrow() -> u32 {
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(&mut registers);
    let observed: u32 = mutate(view);
    observed
}

machine ram_descriptor() -> u32 {
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let source: &mut Registers = &mut registers;
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(source);
    mutate(view)
}

public data SelectionCounter { count: u32; }
machine choose_register(counter: &mut SelectionCounter) -> u64
requires counter.count < 2
ensures counter.count <= 2
ensures result == 0
{
    counter.count = counter.count + 1;
    0
}

// The selector must execute once; the independent eventual runtime oracle is 4101.
machine ram_indexed() -> u64 {
    let mut registers: [Registers; 2] = [
        Registers { status: 41, transmit: 3 },
        Registers { status: 73, transmit: 5 }
    ];
    let mut counter: SelectionCounter = SelectionCounter { count: 0 };
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(&mut registers[choose_register(&mut counter)]);
    let observed: u32 = mutate(view);
    (observed as u64) * 100 + (counter.count as u64)
}

// Capture and retire initialized RAM without granting a scalar field operation.
// Frozen interpreter result: 41 from the original storage after retirement.
machine ram_capture_only() -> u32 {
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(&mut registers);
    registers.status
}

machine retain_ram(view: &mut RegisterStorage in Registers::Placed, counter: &mut SelectionCounter)
requires counter.count < 1
ensures counter.count <= 1
{
    counter.count = counter.count + 1;
}

machine return_ram<'a>(view: &'a mut RegisterStorage in Registers::Placed, counter: &mut SelectionCounter) -> &'a mut RegisterStorage in Registers::Placed
requires counter.count < 1
ensures counter.count <= 1
{
    counter.count = counter.count + 1;
    view
}

// Frozen results: 4101; the ordinary helper runs once and the RAM loan retires.
machine ram_capture_helper() -> u64 {
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let mut counter: SelectionCounter = SelectionCounter { count: 0 };
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(&mut registers);
    retain_ram(view, &mut counter);
    (registers.status as u64) * 100 + (counter.count as u64)
}

machine ram_capture_return() -> u64 {
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let mut counter: SelectionCounter = SelectionCounter { count: 0 };
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(&mut registers);
    let returned: &mut RegisterStorage in Registers::Placed = return_ram(view, &mut counter);
    (registers.status as u64) * 100 + (counter.count as u64)
}

// Frozen result4109 observes the original RAM after the write/read pair.
machine ram_original_backing() -> u64 {
    let mut registers: Registers = Registers { status: 41, transmit: 3 };
    let view: &mut RegisterStorage in Registers::Placed = access::view_mut<Registers, RegisterStorage in Registers::Placed>(&mut registers);
    let observed: u32 = mutate(view);
    (observed as u64) * 100 + (registers.transmit as u64)
}
