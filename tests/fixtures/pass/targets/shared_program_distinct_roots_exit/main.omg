// Both declarations belong to one portable program. Build selects distinct
// entries; the trapping sibling must neither replace nor poison the other.
machine normal() crashes Trap {
    let answer: i32 = 6 * 7;
    transition answer == 42 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}

machine trapping() crashes Trap {
    crash Trap;
}
