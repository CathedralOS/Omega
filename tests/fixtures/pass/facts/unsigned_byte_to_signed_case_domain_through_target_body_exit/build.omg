machine build(builder: &mut Build) {
    Build::application(builder, "unsigned_byte_to_signed_case_domain_target_body");
    Build::select_provider<ByteSource, HostedByteSource>(builder, windows_x86_64);
    Build::select_provider<ByteSource, HostedByteSource>(builder, linux_x86_64);
    Build::select_provider<ByteSource, HostedByteSource>(builder, linux_arm64);
    Build::select_provider<ByteSource, HostedByteSource>(builder, macos_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}
