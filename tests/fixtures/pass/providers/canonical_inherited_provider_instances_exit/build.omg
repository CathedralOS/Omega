machine build(builder: &mut Build) {
    Build::application(builder, "canonical_inherited_provider_instances_exit");
    Build::select_provider<Child, Selected>(builder, windows_x86_64);
    Build::select_provider<Child, Selected>(builder, linux_x86_64);
    Build::select_provider<Child, Selected>(builder, macos_arm64);
    Build::select_provider<Child, Selected>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
