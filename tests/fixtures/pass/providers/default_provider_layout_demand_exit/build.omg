machine build(builder: &mut Build) {
    Build::application(builder, "default_provider_layout_demand_exit");
    let kit: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path { location: "../../../packages/layout-default-kit" }));
    // Windows takes the valid provider; the other targets keep the kit's default.
    Build::select_provider<layout_default_kit::main::Measure, layout_default_kit::main::PairMeasure>(builder, windows_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
