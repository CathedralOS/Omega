// Unmeasured call-spelled tail recursion uses the qualified static declaration.
// The recursive transition remains a loop-back, not a growing call stack.
// Execute the result check as well as admitting the recursive body.
data Main {
}
machine Main::countdown(remaining: u64) -> u64
{
    transition remaining > 0 {
        true -> Main::countdown(remaining - 1)
        false -> 7
    }
}
machine Main::main() crashes Trap {
    let value: u64 = Main::countdown(2);
    transition value == 7 {
        true -> yes()
        false -> no()
    }
    machine yes() { }
    machine no() { crash Trap; }
}
