data Context { value: u64; }

machine write(context: &mut Context) { context.value = 43; }
machine read(context: &Context) -> u64 { context.value }

machine main(context: &mut Context) crashes Trap {
    let initial: u64 = context.value;
    write(context);
    let result: u64 = read(context);
    transition initial == 0 && result == 43 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Context;
    main(&mut entry_storage);
}
