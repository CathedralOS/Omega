public SlotCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.parameter_count == 1 && signature.has_result
            && signature.callback_binder_count <= 33 && signature.callback_demand_count <= 33 {
            true -> select(signature, signature.parameters[0], signature.result)
            _ -> reject()
        }
        machine select(signature: BoundarySignature, parameter: u64, result: u64) -> BoundaryPlanResult {
            transition parameter < 256 && result < 256 {
                true -> accept(signature, parameter, result)
                _ -> reject()
            }
        }
        machine accept(signature: BoundarySignature, parameter: u64, result: u64) -> BoundaryPlanResult
        requires parameter < 256 && result < 256 {
            let mut plan: BoundaryEntryPlan;
            plan.call.convention = CallingConvention::Aapcs64;
            plan.call.parameter_count = 1;
            plan.call.parameters[0].shape.class = AbiValueClass::Integer;
            plan.call.parameters[0].shape.byte_size = signature.shapes[parameter].byte_size;
            plan.call.parameters[0].shape.alignment = signature.shapes[parameter].alignment;
            plan.call.parameters[0].location_count = 1;
            plan.call.parameters[0].locations[0] = ValueLocation::Register { register: MachineRegister::Aarch64X { index: 0 }, value_byte_offset: 0, byte_size: 8 };
            plan.call.has_result = true;
            plan.call.result.shape.class = AbiValueClass::Integer;
            plan.call.result.shape.byte_size = signature.shapes[result].byte_size;
            plan.call.result.shape.alignment = signature.shapes[result].alignment;
            plan.call.result.location_count = 1;
            plan.call.result.locations[0] = ValueLocation::Register { register: MachineRegister::Aarch64X { index: 0 }, value_byte_offset: 0, byte_size: 8 };
            plan.call.callback_materialization_count = signature.callback_demand_count;
            // Match exact requirements and give each binder one destination.
            fill_materializations(&mut plan, &signature, 0, 33);
            plan.call.stack_alignment = 16;
            plan.call.entry_control = EntryControl::CallReturn;
            plan.state.initial_regime = MachineRegime::Aarch64A64 { exception_level: 0 };
            plan.state.permitted_transitive_use.general_registers = true;
            plan.state.permitted_transitive_use.vector_registers = true;
            plan.state.permitted_transitive_use.flags = true;
            plan.state.permitted_transitive_use.instruction_pointer = true;
            plan.state.permitted_transitive_use.stack_pointer = true;
            plan.state.stack = EntryStack::ProviderSelected;
            plan.state.preemption = Preemption::NotApplicable;
            BoundaryPlanResult::Accepted { plan: plan }
        }
        machine reject() -> BoundaryPlanResult {
            BoundaryPlanResult::Rejected { reason: CallingPolicyRejection { reason: "one parameter, one result, and at most 33 private destinations required" } }
        }
    }
}

machine fill_materializations(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature, index: u64, remaining: u64)
terminates by remaining
{
    transition index < 33 && remaining > 0 {
        true -> put(plan, signature, index, remaining)
        _ -> {}
    }
    machine put(plan: &mut BoundaryEntryPlan, signature: &BoundarySignature, index: u64, remaining: u64)
    requires index < 33 && remaining > 0 {
        plan.call.callback_materializations[index].binder = slot_binder(signature, index);
        plan.call.callback_materializations[index].destination = signature.callback_demands[index].destination;
        fill_materializations(plan, signature, index + 1, remaining - 1)
    }
}

// The roster has one variable contract. Its demand may occur anywhere: swap
// that binder with the fixed binder at its actual position, leaving all other
// matching positions alone. Native validation checks every resulting join.
machine slot_binder(signature: &BoundarySignature, index: u64) -> u64
requires index < 33 {
    transition {
        signature.callback_binders[index].requirement == signature.callback_demands[index].requirement -> signature.callback_binders[index].binder
        signature.callback_binders[1].requirement == signature.callback_demands[index].requirement -> signature.callback_binders[1].binder
        _ -> variable_position_binder(signature, 0, 33)
    }
}
machine variable_position_binder(signature: &BoundarySignature, index: u64, remaining: u64) -> u64
terminates by remaining
{
    transition index < 33 && remaining > 0 {
        true -> inspect(signature, index, remaining)
        _ -> signature.callback_binders[0].binder
    }
    machine inspect(signature: &BoundarySignature, index: u64, remaining: u64) -> u64
    requires index < 33 && remaining > 0 {
        transition signature.callback_demands[index].requirement == signature.callback_binders[1].requirement {
            true -> signature.callback_binders[index].binder
            _ -> variable_position_binder(signature, index + 1, remaining - 1)
        }
    }
}

