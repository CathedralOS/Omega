// Excluding left::Sink leaves the same-spelled right::Sink admitted: the
// exclusion selects one module's declaration, never every `Sink`.
use left;
use right;
use right::Sink;

data Main { }
machine Main::main(main: &mut Main)
reaches Sink
{
    relay();
}

machine relay()
reaches Sink
{
    Sink::emit("relayed");
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start()
reaches Sink
{
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
