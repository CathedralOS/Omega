machine build(builder: &mut Build) {
    Build::application(builder, "executed_git_source_join_exit");
    request_sources(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
}

machine request_sources(builder: &mut Build) {
    let mut selected_dependency: DependencyDescription = dependency::from_source(Source::Git {
        repository: "https://omega-source.invalid/executed-source.git",
        revision: "executed-build-fixture-v1",
        selection: PackageSelection::Root
    });
    dependency::with_alias(&mut selected_dependency, "selected");
    let selected_registration: DependencyRegistration = Build::dependency(builder, selected_dependency);
    let mut shared_dependency: DependencyDescription = dependency::from_source(Source::Git {
        repository: "https://omega-source.invalid/executed-source.git",
        revision: "executed-build-fixture-v1",
        selection: PackageSelection::Root
    });
    dependency::with_alias(&mut shared_dependency, "shared");
    let shared_registration: DependencyRegistration = Build::dependency(builder, shared_dependency);
}
