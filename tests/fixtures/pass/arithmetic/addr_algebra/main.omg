// The legal half of the `addr` algebra: `addr - count -> addr`
// offsets backward, `addr - addr -> u64` measures distance, and
// addresses order (`<`). The illegal half (addr + addr, addr *
// anything, shifts) rejects at compile — fail corpus territory.
data Main {
    marker: u64;
}
machine Main::main(main: &mut Main) {
    let a: addr = 4096;
    let b: addr = 4000;
    let back: addr = a - 16;
    let d: u64 = a - b;
    let o: bool = b < a;
    main.marker = d;
}
