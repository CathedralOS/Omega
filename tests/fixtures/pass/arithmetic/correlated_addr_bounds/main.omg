// Expected exit: 0
// An offset smaller than a granted capacity keeps its exact address fit.
machine advance(base: addr, capacity: u64, requested: u64) -> addr
requires embed(base) + embed(capacity) <= addr::Bound, requested < capacity
ensures embed(result) == embed(base) + embed(requested),
    embed(base) <= embed(result)
{
    let endpoint: addr = base + requested;
    endpoint
}
machine main() crashes Trap {
    let first: addr = advance(4096, 32u64, 17u64);
    let second: addr = advance(8192, 64u64, 25u64);
    transition first == 4113 && second == 8217 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
