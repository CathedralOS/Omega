// The returned sequence keeps a field computed at runtime. Psi runs this program.
// Native realization still needs backing that outlives the machine that builds it.
data Ticket { kind: u8; number: u32; }
machine issued(number: u32) -> [Ticket] { [Ticket { kind: 2u8, number: number }] }
machine counted(tickets: [Ticket]) -> u64 { tickets.len }
machine main() crashes Trap {
    let returned: [Ticket] = issued(11u32);
    let moved: u64 = counted(returned);
    transition moved == 1u64 { true -> done() false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
