// Public reach of one exact ordinary-package filesystem boundary.
use host_services::filesystem_host;

pub data Journal {
    files: FilesystemHost;
    written: i64;
}

pub machine Journal::append_line(&mut self, descriptor: i32, line: &[u8])
reaches FilesystemHost
invokes FilesystemHost;
{
    self.written = self.files.write(descriptor, line);
}
