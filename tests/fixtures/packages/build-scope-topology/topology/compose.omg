// The composition engine: reads the project's admitted inputs through the
// source facet, composes the canonical deployment plan per the topology
// reference contract, and serializes it to the caller's required output.
//
// Wire layout mirrors omega-rust/omega/packages/topology deployment_plan
// codec exactly: LE integers, u32 length prefixes, sorted rosters, and the
// v1 tag table. Every composition fact is reconstructed from the admitted
// description bytes and owner digests here — nothing is copied from a
// caller-written plan inventory.
//
// Input layout (owner-supplied, confined to inputs/):
//   request.bin     — the canonical TopologyRequest bytes.
//   components.bin  — {u32 n} + per-instance {u32 desc_len, desc bytes,
//                     profile[32]}, in request-roster order.
//   bindings.bin    — {u32 n} + {ii,is,ei,es u32 + transport[32]}, canonical.

module compose;

use digest;

pub data Compose {
    ok: bool;
    i: u64 in Wrapping;
    j: u64 in Wrapping;
    k: u64 in Wrapping;
    m: u64 in Wrapping;
    h0: u64 in Wrapping;
    h1: u64 in Wrapping;
    h2: u64 in Wrapping;
    h3: u64 in Wrapping;
    d0: u64 in Wrapping;
    d1: u64 in Wrapping;
    t64: u64 in Wrapping;
    acc: u64 in Wrapping;
    b8: u8;
    w8: u8;
    errtag: [u8; 8];
    w32: u32;
    cur: u64 in Wrapping;
    src: u64 in Wrapping;
    cp: u64 in Wrapping;
    cb: u64 in Wrapping;
    ja: u64 in Wrapping;
    jb: u64 in Wrapping;
    jc: u64 in Wrapping;
    jd: u64 in Wrapping;
    je: u64 in Wrapping;
    jf: u64 in Wrapping;
    jg: u64 in Wrapping;
    n_svc: u64 in Wrapping;
    n_prov: u64 in Wrapping;
    n_obl: u64 in Wrapping;
    dr_n: u64 in Wrapping;

    req: [u8; 8192];
    req_n: u64 in Wrapping;
    rq: u64 in Wrapping;
    meta: [u8; 8192];
    meta_n: u64 in Wrapping;
    mq: u64 in Wrapping;
    desc: [u8; 8192];
    desc_n: u64 in Wrapping;
    dq: u64 in Wrapping;
    bind: [u8; 8192];
    bind_n: u64 in Wrapping;
    bq: u64 in Wrapping;

    ident: [u8; 32];
    strbuf: [u8; 256];
    str_n: u64 in Wrapping;
    commit: [u8; 32];

    dig: digest::Sha256;
    digest32: [u8; 32];
    desc_id: [u8; 32];

    n_inst: u64 in Wrapping;
    n_pol: u64 in Wrapping;
    n_tr: u64 in Wrapping;
    n_acp: u64 in Wrapping;
    n_bind: u64 in Wrapping;
    n_meta: u64 in Wrapping;

    names: [u8; 1024];
    name_len: [u64 in Wrapping; 8];
    subjects: [u8; 256];
    transports: [u8; 256];
    accepted: [u8; 1024];
    verifier: [u8; 32];

    pol_tag: [u8; 8];
    pol_off: [u64 in Wrapping; 8];
    pol_len: [u64 in Wrapping; 8];
    pol_s: [u64 in Wrapping; 8];
    pol_t: [u64 in Wrapping; 8];
    pol_v: [u64 in Wrapping; 8];
    sel_mask: u64 in Wrapping;
    sel_n: u64 in Wrapping;
    name_idx: u64 in Wrapping;

    profiles: [u8; 256];
    closures: [u8; 256];
    inst_asm_n: [u64 in Wrapping; 8];
    inst_asm: [u8; 2048];
    imp_n: [u64 in Wrapping; 8];
    imp_slot: [u64 in Wrapping; 64];
    imp_contract: [u8; 2048];
    exp_n: [u64 in Wrapping; 8];
    exp_contract: [u8; 2048];
    ep_n: [u64 in Wrapping; 8];
    ep_slot: [u64 in Wrapping; 128];
    ep_dir: [u8; 128];
    ep_contract: [u8; 4096];

    b_ii: [u64 in Wrapping; 16];
    b_is: [u64 in Wrapping; 16];
    b_ei: [u64 in Wrapping; 16];
    b_es: [u64 in Wrapping; 16];
    b_tr: [u8; 512];
    prev_key: u64 in Wrapping;
    cur_key: u64 in Wrapping;

    adj: [u8; 64];
    visited: [u8; 8];
    queue: [u64 in Wrapping; 16];
    qh: u64 in Wrapping;
    qn: u64 in Wrapping;
    parent: [u64 in Wrapping; 8];
    has_parent: [u8; 8];
    excl_mask: u64 in Wrapping;
    src_mask: u64 in Wrapping;
    tgt_mask: u64 in Wrapping;
    reach: [u8; 8];
    path: [u64 in Wrapping; 8];
    path_n: u64 in Wrapping;
    found: bool;
    vtx: u64 in Wrapping;

    pol_out: [u8; 8];
    pol_kind: [u8; 8];
    pol_wit_n: [u64 in Wrapping; 8];
    pol_wit: [u8; 64];
    pol_reach_n: [u64 in Wrapping; 8];
    pol_reach: [u8; 64];

    out: [u8; 16384];
    out_len: u64 in Wrapping;
}

// ---- byte readers ---------------------------------------------------------

machine Compose::rd(&mut self) {
    transition self.cur == 0 && self.rq < 8192 && self.rq < self.req_n {
        true -> rd_req()
        _ -> rd_meta_g()
    }
    state rd_meta_g(&mut self) {
        transition self.cur == 1 && self.mq < 8192 && self.mq < self.meta_n {
            true -> rd_meta()
            _ -> rd_desc_g()
        }
    }
    state rd_desc_g(&mut self) {
        transition self.cur == 2 && self.dq < 8192 && self.dq < self.desc_n {
            true -> rd_desc()
            _ -> rd_bind_g()
        }
    }
    state rd_bind_g(&mut self) {
        transition self.cur == 3 && self.bq < 8192 && self.bq < self.bind_n {
            true -> rd_bind()
            _ -> rd_bad()
        }
    }
    state rd_req(&mut self) {
        self.b8 = self.req[self.rq];
        self.rq = self.rq + 1;
        transition { _ -> rd_done() }
    }
    state rd_meta(&mut self) {
        self.b8 = self.meta[self.mq];
        self.mq = self.mq + 1;
        transition { _ -> rd_done() }
    }
    state rd_desc(&mut self) {
        self.b8 = self.desc[self.dq];
        self.dq = self.dq + 1;
        transition { _ -> rd_done() }
    }
    state rd_bind(&mut self) {
        self.b8 = self.bind[self.bq];
        self.bq = self.bq + 1;
        transition { _ -> rd_done() }
    }
    state rd_bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 114;
        self.errtag[1] = 100;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> rd_done() }
    }
    state rd_done(&mut self) {
    }
}

machine Compose::ru32(&mut self) {
    self.acc = 0;
    self.rd();
    self.acc = self.acc + (self.b8 as u64 in Wrapping);
    self.rd();
    self.acc = self.acc + ((self.b8 as u64 in Wrapping) << 8);
    self.rd();
    self.acc = self.acc + ((self.b8 as u64 in Wrapping) << 16);
    self.rd();
    self.acc = self.acc + ((self.b8 as u64 in Wrapping) << 24);
    self.w32 = (self.acc as u32 in Wrapping) as u32;
    transition { _ -> done() }
    state done(&mut self) {
    }
}

machine Compose::skip(&mut self, n: u64 in Wrapping) {
    self.j = 0;
    transition { _ -> loop_s(n) }
    state loop_s(&mut self, n: u64 in Wrapping) {
        transition self.j < n && self.j < 8192 && self.ok {
            true -> step(n)
            _ -> done()
        }
    }
    state step(&mut self, n: u64 in Wrapping) {
        self.rd();
        self.j = self.j + 1;
        transition { _ -> loop_s(n) }
    }
    state done(&mut self) {
    }
}

machine Compose::rdident(&mut self) {
    self.j = 0;
    transition { _ -> loop_s() }
    state loop_s(&mut self) {
        transition self.j < 32 && self.ok {
            true -> prep()
            _ -> done()
        }
    }
    state prep(&mut self) {
        self.h0 = self.j;
        transition self.h0 < 32 {
            true -> apply()
            _ -> bad()
        }
    }
    state apply(&mut self) {
        self.rd();
        self.ident[self.h0] = self.b8;
        self.j = self.j + 1;
        transition { _ -> loop_s() }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 105;
        self.errtag[1] = 100;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

machine Compose::rdstr(&mut self) {
    self.ru32();
    self.t64 = self.w32 as u64 in Wrapping;
    transition self.t64 < 256 && self.ok {
        true -> init()
        _ -> bad()
    }
    state init(&mut self) {
        self.str_n = self.t64;
        self.j = 0;
        transition { _ -> loop_s() }
    }
    state loop_s(&mut self) {
        transition self.j < self.str_n && self.j < 256 && self.ok {
            true -> prep()
            _ -> done()
        }
    }
    state prep(&mut self) {
        self.h0 = self.j;
        transition self.h0 < 256 {
            true -> apply()
            _ -> bad()
        }
    }
    state apply(&mut self) {
        self.rd();
        self.strbuf[self.h0] = self.b8;
        self.j = self.j + 1;
        transition { _ -> loop_s() }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 115;
        self.errtag[1] = 116;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Resolve strbuf against the instance roster: sets name_idx or clears ok.
machine Compose::resolve_name(&mut self) {
    self.name_idx = 255;
    self.i = 0;
    transition { _ -> loop_s() }
    state loop_s(&mut self) {
        transition self.i < self.n_inst && self.i < 8 && self.name_idx == 255 {
            true -> check_len()
            _ -> done()
        }
    }
    state check_len(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 {
            true -> cmp_len()
            _ -> bad()
        }
    }
    state cmp_len(&mut self) {
        transition self.name_len[self.h0] == self.str_n {
            true -> start_cmp()
            _ -> next_i()
        }
    }
    state start_cmp(&mut self) {
        self.k = 0;
        self.found = true;
        transition { _ -> cmp_loop() }
    }
    state cmp_loop(&mut self) {
        transition self.k < self.str_n && self.k < 256 && self.found {
            true -> prep_cmp()
            _ -> after_cmp()
        }
    }
    state prep_cmp(&mut self) {
        self.h1 = self.i * 128 + self.k;
        self.h2 = self.k;
        transition self.h1 < 1024 && self.h2 < 256 {
            true -> do_cmp()
            _ -> bad()
        }
    }
    state do_cmp(&mut self) {
        transition self.names[self.h1] != self.strbuf[self.h2] {
            true -> not_eq()
            _ -> next_k()
        }
    }
    state not_eq(&mut self) {
        self.found = false;
        transition { _ -> next_k() }
    }
    state next_k(&mut self) {
        self.k = self.k + 1;
        transition { _ -> cmp_loop() }
    }
    state after_cmp(&mut self) {
        transition self.found {
            true -> got()
            _ -> next_i()
        }
    }
    state got(&mut self) {
        self.name_idx = self.i;
        transition { _ -> done() }
    }
    state next_i(&mut self) {
        self.i = self.i + 1;
        transition { _ -> loop_s() }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 114;
        self.errtag[1] = 110;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Read one selector (u32 count + names) into a bitmask on sel_mask.
// Members must resolve to roster instances; count bounded by roster size.
machine Compose::rd_selector(&mut self) {
    self.ru32();
    self.sel_n = self.w32 as u64 in Wrapping;
    self.sel_mask = 0;
    transition self.sel_n <= 8 && self.ok {
        true -> init()
        _ -> bad()
    }
    state init(&mut self) {
        self.j = 0;
        transition { _ -> loop_s() }
    }
    state loop_s(&mut self) {
        transition self.j < self.sel_n && self.j < 8 && self.ok {
            true -> one()
            _ -> done()
        }
    }
    state one(&mut self) {
        self.rdstr();
        self.resolve_name();
        transition self.name_idx < 8 && self.ok {
            true -> setbit()
            _ -> bad()
        }
    }
    state setbit(&mut self) {
        self.sel_mask = self.sel_mask | ((1 as u64 in Wrapping) << self.name_idx);
        self.j = self.j + 1;
        transition { _ -> loop_s() }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 114;
        self.errtag[1] = 115;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// ---- emitters -------------------------------------------------------------

machine Compose::emit_u8(&mut self) {
    transition self.out_len < 16384 {
        true -> apply()
        _ -> bad()
    }
    state apply(&mut self) {
        self.out[self.out_len] = self.w8;
        self.out_len = self.out_len + 1;
        transition { _ -> done() }
    }
    state bad(&mut self) {
        self.ok = false;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

machine Compose::emit_u32(&mut self) {
    self.acc = (self.w32 as u64 in Wrapping);
    self.w8 = (self.acc as u8 in Wrapping) as u8;
    self.emit_u8();
    self.w8 = ((self.acc >> 8) as u8 in Wrapping) as u8;
    self.emit_u8();
    self.w8 = ((self.acc >> 16) as u8 in Wrapping) as u8;
    self.emit_u8();
    self.w8 = ((self.acc >> 24) as u8 in Wrapping) as u8;
    self.emit_u8();
    transition { _ -> done() }
    state done(&mut self) {
    }
}

// Emit 32 bytes from a chosen field array: `self.h0` = byte base, `self.src`
// selects the array (0=commit 1=digest32 2=ep_contract 3=b_tr 4=inst_asm
// 5=profiles 6=closures 7=subjects 8=verifier 9=transports).
machine Compose::emit_ident(&mut self) {
    self.k = 0;
    transition { _ -> loop_s() }
    state loop_s(&mut self) {
        transition self.k < 32 && self.ok {
            true -> prep()
            _ -> done()
        }
    }
    state prep(&mut self) {
        self.h1 = self.h0 + self.k;
        self.h2 = self.k;
        transition self.h1 < 4096 && self.h2 < 32 && self.out_len < 16384 {
            true -> pick()
            _ -> bad()
        }
    }
    state pick(&mut self) {
        transition self.src == 0 {
            true -> from_commit()
            _ -> pick1()
        }
    }
    state pick1(&mut self) {
        transition self.src == 1 {
            true -> from_digest()
            _ -> pick2()
        }
    }
    state pick2(&mut self) {
        transition self.src == 2 {
            true -> from_ep()
            _ -> pick3()
        }
    }
    state pick3(&mut self) {
        transition self.src == 3 && self.h1 < 512 {
            true -> from_tr()
            _ -> pick4()
        }
    }
    state pick4(&mut self) {
        transition self.src == 4 && self.h1 < 2048 {
            true -> from_asm()
            _ -> pick5()
        }
    }
    state pick5(&mut self) {
        transition self.src == 5 && self.h1 < 256 {
            true -> from_profile()
            _ -> pick6()
        }
    }
    state pick6(&mut self) {
        transition self.src == 6 && self.h1 < 256 {
            true -> from_closure()
            _ -> pick7()
        }
    }
    state pick7(&mut self) {
        transition self.src == 7 && self.h1 < 256 {
            true -> from_subject()
            _ -> pick8()
        }
    }
    state pick8(&mut self) {
        transition self.src == 8 && self.h2 < 32 {
            true -> from_verifier()
            _ -> pick9()
        }
    }
    state pick9(&mut self) {
        transition self.src == 9 && self.h1 < 256 {
            true -> from_transports()
            _ -> bad()
        }
    }
    state from_commit(&mut self) {
        self.w8 = self.commit[self.h2];
        transition { _ -> put() }
    }
    state from_digest(&mut self) {
        self.w8 = self.digest32[self.h2];
        transition { _ -> put() }
    }
    state from_ep(&mut self) {
        self.w8 = self.ep_contract[self.h1];
        transition { _ -> put() }
    }
    state from_tr(&mut self) {
        self.w8 = self.b_tr[self.h1];
        transition { _ -> put() }
    }
    state from_asm(&mut self) {
        self.w8 = self.inst_asm[self.h1];
        transition { _ -> put() }
    }
    state from_profile(&mut self) {
        self.w8 = self.profiles[self.h1];
        transition { _ -> put() }
    }
    state from_closure(&mut self) {
        self.w8 = self.closures[self.h1];
        transition { _ -> put() }
    }
    state from_subject(&mut self) {
        self.w8 = self.subjects[self.h1];
        transition { _ -> put() }
    }
    state from_verifier(&mut self) {
        self.w8 = self.verifier[self.h2];
        transition { _ -> put() }
    }
    state from_transports(&mut self) {
        self.w8 = self.transports[self.h1];
        transition { _ -> put() }
    }
    state put(&mut self) {
        self.out[self.out_len] = self.w8;
        self.out_len = self.out_len + 1;
        self.k = self.k + 1;
        transition { _ -> loop_s() }
    }
    state bad(&mut self) {
        self.ok = false;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// ---- request decode -------------------------------------------------------
// Layout: magic u32 | ver u32 | n_inst u32 | {name,subject}x | n_pol u32 |
// {tag,3 selectors}x | verifier[32] | n_tr u32 | tr[32]x | n_acp u32 | asm[32]x

machine Compose::decode_req(&mut self) {
    self.rq = 0;
    self.cur = 0;
    self.ru32();
    transition self.w32 == 1280332881 && self.ok {
        true -> ver()
        _ -> bad()
    }
    state ver(&mut self) {
        self.ru32();
        transition self.w32 == 1 && self.ok {
            true -> insts()
            _ -> bad()
        }
    }
    state insts(&mut self) {
        self.ru32();
        self.n_inst = self.w32 as u64 in Wrapping;
        transition self.n_inst > 0 && self.n_inst <= 8 && self.ok {
            true -> inst_init()
            _ -> bad()
        }
    }
    state inst_init(&mut self) {
        self.i = 0;
        transition { _ -> inst_loop() }
    }
    state inst_loop(&mut self) {
        transition self.i < self.n_inst && self.i < 8 && self.ok {
            true -> inst_name()
            _ -> pols()
        }
    }
    state inst_name(&mut self) {
        self.rdstr();
        self.h0 = self.i;
        transition self.h0 < 8 && self.ok {
            true -> set_len()
            _ -> bad()
        }
    }
    state set_len(&mut self) {
        self.name_len[self.h0] = self.str_n;
        self.k = 0;
        transition { _ -> name_copy() }
    }
    state name_copy(&mut self) {
        transition self.k < self.str_n && self.k < 128 {
            true -> prep_nc()
            _ -> inst_subj()
        }
    }
    state prep_nc(&mut self) {
        self.h1 = self.i * 128 + self.k;
        self.h2 = self.k;
        transition self.h1 < 1024 && self.h2 < 256 {
            true -> do_nc()
            _ -> bad()
        }
    }
    state do_nc(&mut self) {
        self.names[self.h1] = self.strbuf[self.h2];
        self.k = self.k + 1;
        transition { _ -> name_copy() }
    }
    state inst_subj(&mut self) {
        self.rdident();
        self.k = 0;
        transition { _ -> subj_copy() }
    }
    state subj_copy(&mut self) {
        transition self.k < 32 {
            true -> prep_sc()
            _ -> inst_next()
        }
    }
    state prep_sc(&mut self) {
        self.h1 = self.i * 32 + self.k;
        self.h2 = self.k;
        transition self.h1 < 256 && self.h2 < 32 {
            true -> do_sc()
            _ -> bad()
        }
    }
    state do_sc(&mut self) {
        self.subjects[self.h1] = self.ident[self.h2];
        self.k = self.k + 1;
        transition { _ -> subj_copy() }
    }
    state inst_next(&mut self) {
        self.i = self.i + 1;
        transition { _ -> inst_loop() }
    }
    state pols(&mut self) {
        self.ru32();
        self.n_pol = self.w32 as u64 in Wrapping;
        transition self.n_pol <= 8 && self.ok {
            true -> pol_init()
            _ -> bad()
        }
    }
    state pol_init(&mut self) {
        self.cp = 0;
        transition { _ -> pol_loop() }
    }
    state pol_loop(&mut self) {
        transition self.cp < self.n_pol && self.cp < 8 && self.ok {
            true -> pol_off_set()
            _ -> verifier_r()
        }
    }
    state pol_off_set(&mut self) {
        self.pol_off[self.cp] = self.rq;
        transition { _ -> pol_tag_r() }
    }
    state pol_tag_r(&mut self) {
        self.rd();
        transition self.ok && self.cp < 8 {
            true -> pol_tag_set()
            _ -> bad()
        }
    }
    state pol_tag_set(&mut self) {
        self.pol_tag[self.cp] = self.b8;
        transition self.b8 == 1 || self.b8 == 2 {
            true -> pol_s_r()
            _ -> bad()
        }
    }
    state pol_s_r(&mut self) {
        self.rd_selector();
        transition self.ok {
            true -> pol_s_set()
            _ -> bad()
        }
    }
    state pol_s_set(&mut self) {
        transition self.sel_n > 0 && self.cp < 8 {
            true -> pol_s_ok()
            _ -> bad()
        }
    }
    state pol_s_ok(&mut self) {
        self.pol_s[self.cp] = self.sel_mask;
        transition { _ -> pol_t_r() }
    }
    state pol_t_r(&mut self) {
        self.rd_selector();
        transition self.ok {
            true -> pol_t_set()
            _ -> bad()
        }
    }
    state pol_t_set(&mut self) {
        transition self.sel_n > 0 && self.cp < 8 {
            true -> pol_t_ok()
            _ -> bad()
        }
    }
    state pol_t_ok(&mut self) {
        self.pol_t[self.cp] = self.sel_mask;
        transition { _ -> pol_v_r() }
    }
    state pol_v_r(&mut self) {
        self.rd_selector();
        transition self.ok && self.cp < 8 {
            true -> pol_v_set()
            _ -> bad()
        }
    }
    state pol_v_set(&mut self) {
        self.pol_v[self.cp] = self.sel_mask;
        transition self.cp < 8 {
            true -> pol_len_set()
            _ -> bad()
        }
    }
    state pol_len_set(&mut self) {
        self.pol_len[self.cp] = self.rq - self.pol_off[self.cp];
        transition self.cp < 8 {
            true -> pol_arity_ck()
            _ -> bad()
        }
    }
    state pol_arity_ck(&mut self) {
        transition (self.pol_tag[self.cp] == 1 && self.sel_n == 0) || (self.pol_tag[self.cp] == 2 && self.sel_n > 0) {
            true -> pol_disj_g()
            _ -> bad()
        }
    }
    state pol_disj_g(&mut self) {
        transition self.cp < 8 {
            true -> pol_disj()
            _ -> bad()
        }
    }
    state pol_disj(&mut self) {
        self.t64 = (self.pol_s[self.cp] & self.pol_t[self.cp]) | (self.pol_s[self.cp] & self.pol_v[self.cp]) | (self.pol_t[self.cp] & self.pol_v[self.cp]);
        transition self.t64 == 0 {
            true -> pol_next()
            _ -> bad()
        }
    }
    state pol_next(&mut self) {
        self.cp = self.cp + 1;
        transition { _ -> pol_loop() }
    }
    state verifier_r(&mut self) {
        self.rdident();
        self.k = 0;
        transition { _ -> ver_copy() }
    }
    state ver_copy(&mut self) {
        transition self.k < 32 {
            true -> prep_vc()
            _ -> transports_r()
        }
    }
    state prep_vc(&mut self) {
        self.h2 = self.k;
        transition self.h2 < 32 {
            true -> do_vc()
            _ -> bad()
        }
    }
    state do_vc(&mut self) {
        self.verifier[self.h2] = self.ident[self.h2];
        self.k = self.k + 1;
        transition { _ -> ver_copy() }
    }
    state transports_r(&mut self) {
        self.ru32();
        self.n_tr = self.w32 as u64 in Wrapping;
        transition self.n_tr > 0 && self.n_tr <= 8 && self.ok {
            true -> tr_init()
            _ -> bad()
        }
    }
    state tr_init(&mut self) {
        self.i = 0;
        transition { _ -> tr_loop() }
    }
    state tr_loop(&mut self) {
        transition self.i < self.n_tr && self.i < 8 && self.ok {
            true -> tr_one()
            _ -> acp_r()
        }
    }
    state tr_one(&mut self) {
        self.rdident();
        self.k = 0;
        transition { _ -> tr_copy() }
    }
    state tr_copy(&mut self) {
        transition self.k < 32 {
            true -> prep_tc()
            _ -> tr_next()
        }
    }
    state prep_tc(&mut self) {
        self.h1 = self.i * 32 + self.k;
        self.h2 = self.k;
        transition self.h1 < 256 && self.h2 < 32 {
            true -> do_tc()
            _ -> bad()
        }
    }
    state do_tc(&mut self) {
        self.transports[self.h1] = self.ident[self.h2];
        self.k = self.k + 1;
        transition { _ -> tr_copy() }
    }
    state tr_next(&mut self) {
        self.i = self.i + 1;
        transition { _ -> tr_loop() }
    }
    state acp_r(&mut self) {
        self.ru32();
        self.n_acp = self.w32 as u64 in Wrapping;
        transition self.n_acp <= 32 && self.ok {
            true -> acp_init()
            _ -> bad()
        }
    }
    state acp_init(&mut self) {
        self.i = 0;
        transition { _ -> acp_loop() }
    }
    state acp_loop(&mut self) {
        transition self.i < self.n_acp && self.i < 32 && self.ok {
            true -> acp_one()
            _ -> fin()
        }
    }
    state acp_one(&mut self) {
        self.rdident();
        self.k = 0;
        transition { _ -> acp_copy() }
    }
    state acp_copy(&mut self) {
        transition self.k < 32 {
            true -> prep_ac()
            _ -> acp_next()
        }
    }
    state prep_ac(&mut self) {
        self.h1 = self.i * 32 + self.k;
        self.h2 = self.k;
        transition self.h1 < 1024 && self.h2 < 32 {
            true -> do_ac()
            _ -> bad()
        }
    }
    state do_ac(&mut self) {
        self.accepted[self.h1] = self.ident[self.h2];
        self.k = self.k + 1;
        transition { _ -> acp_copy() }
    }
    state acp_next(&mut self) {
        self.i = self.i + 1;
        transition { _ -> acp_loop() }
    }
    state fin(&mut self) {
        transition self.rq == self.req_n && self.ok {
            true -> done()
            _ -> bad()
        }
    }
    state bad(&mut self) {
        self.ok = false;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// ---- description analysis -------------------------------------------------
// Skip `n` raw bytes inside `desc` (cur must be 2).
machine Compose::dskip(&mut self, n: u64 in Wrapping) {
    self.j = 0;
    transition { _ -> loop_s(n) }
    state loop_s(&mut self, n: u64 in Wrapping) {
        transition self.j < n && self.j < 8192 && self.dq < 8192 && self.dq < self.desc_n {
            true -> step(n)
            _ -> check(n)
        }
    }
    state step(&mut self, n: u64 in Wrapping) {
        self.rd();
        self.j = self.j + 1;
        transition { _ -> loop_s(n) }
    }
    state check(&mut self, n: u64 in Wrapping) {
        transition self.j == n {
            true -> done()
            _ -> bad()
        }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 100;
        self.errtag[1] = 115;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Skip one tagged-evidence group: u8 class/kind tag + identity string +
// u8 evidence tag (+32 digest when nonzero). Used for entries, outgoing,
// custody rows inside a description.
machine Compose::dskip_row(&mut self) {
    self.rd();
    transition self.ok {
        true -> str()
        _ -> bad()
    }
    state str(&mut self) {
        self.rdstr();
        transition self.ok {
            true -> ev()
            _ -> bad()
        }
    }
    state ev(&mut self) {
        self.rd();
        transition self.ok {
            true -> ev_g()
            _ -> bad()
        }
    }
    state ev_g(&mut self) {
        transition self.b8 == 0 {
            true -> done()
            _ -> ev_digest()
        }
    }
    state ev_digest(&mut self) {
        self.t64 = 32;
        self.dskip(self.t64);
        transition { _ -> done() }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 100;
        self.errtag[1] = 114;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Skip a roster of tagged-evidence rows: u32 n + dskip_row x n.
machine Compose::dskip_rows(&mut self) {
    self.ru32();
    self.t64 = self.w32 as u64 in Wrapping;
    transition self.t64 <= 64 && self.ok {
        true -> init()
        _ -> bad()
    }
    state init(&mut self) {
        self.dr_n = self.t64;
        self.jg = 0;
        transition { _ -> loop_s() }
    }
    state loop_s(&mut self) {
        transition self.jg < self.dr_n && self.jg < 64 && self.ok {
            true -> one()
            _ -> done()
        }
    }
    state one(&mut self) {
        self.dskip_row();
        self.jg = self.jg + 1;
        transition { _ -> loop_s() }
    }
    state bad(&mut self) {
        self.ok = false;
        self.errtag[0] = 100;
        self.errtag[1] = 82;
        self.errtag[2] = 88;
        self.errtag[3] = 88;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Parse the current `desc` buffer for instance `self.i`: imports (slot +
// contract), exports (identity strings -> contract digests), assumptions;
// every other section is skipped over. Ends with the endpoint merge.
machine Compose::analyze_desc(&mut self) {
    self.dq = 0;
    self.cur = 2;
    // magic[8] + schema u32 + frontier u8
    self.t64 = 13;
    self.dskip(self.t64);
    transition self.ok {
        true -> art()
        _ -> bad_01()
    }
    state art(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        self.dskip(self.t64);
        transition self.ok {
            true -> imps()
            _ -> bad_02()
        }
    }
    state imps(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        transition self.t64 <= 8 && self.ok {
            true -> imp_init()
            _ -> bad_03()
        }
    }
    state imp_init(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 {
            true -> imp_set_n()
            _ -> bad_04()
        }
    }
    state imp_set_n(&mut self) {
        self.imp_n[self.h0] = self.t64;
        self.ja = 0;
        transition { _ -> imp_loop() }
    }
    state imp_loop(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 && self.ok {
            true -> imp_g()
            _ -> bad_03b()
        }
    }
    state imp_g(&mut self) {
        transition self.ja < self.imp_n[self.h0] && self.ja < 8 && self.ok {
            true -> imp_slot_r()
            _ -> exps()
        }
    }
    state imp_slot_r(&mut self) {
        self.ru32();
        self.h1 = self.i * 8 + self.ja;
        transition self.ok && self.h1 < 64 {
            true -> imp_slot_w()
            _ -> bad_05()
        }
    }
    state imp_slot_w(&mut self) {
        self.imp_slot[self.h1] = self.w32 as u64 in Wrapping;
        transition { _ -> imp_str() }
    }
    state imp_str(&mut self) {
        self.rdstr();
        transition self.ok {
            true -> imp_c()
            _ -> bad_06()
        }
    }
    state imp_c(&mut self) {
        self.rdident();
        self.k = 0;
        transition { _ -> imp_c_loop() }
    }
    state imp_c_loop(&mut self) {
        transition self.k < 32 {
            true -> prep_ic()
            _ -> imp_next()
        }
    }
    state prep_ic(&mut self) {
        self.h2 = self.i * 256 + self.ja * 32 + self.k;
        self.h3 = self.k;
        transition self.h2 < 2048 && self.h3 < 32 {
            true -> do_ic()
            _ -> bad_07()
        }
    }
    state do_ic(&mut self) {
        self.imp_contract[self.h2] = self.ident[self.h3];
        self.k = self.k + 1;
        transition { _ -> imp_c_loop() }
    }
    state imp_next(&mut self) {
        self.ja = self.ja + 1;
        transition { _ -> imp_loop() }
    }
    state exps(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        transition self.t64 <= 8 && self.ok {
            true -> exp_init()
            _ -> bad_08()
        }
    }
    state exp_init(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 {
            true -> exp_set()
            _ -> bad_09()
        }
    }
    state exp_set(&mut self) {
        self.exp_n[self.h0] = self.t64;
        self.jb = 0;
        transition { _ -> exp_loop() }
    }
    state exp_loop(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 && self.ok {
            true -> exp_g()
            _ -> bad_08b()
        }
    }
    state exp_g(&mut self) {
        transition self.jb < self.exp_n[self.h0] && self.jb < 8 && self.ok {
            true -> exp_str()
            _ -> rest()
        }
    }
    state exp_str(&mut self) {
        self.rdstr();
        transition self.ok {
            true -> exp_hash()
            _ -> bad_10()
        }
    }
    // contract = sha256("omega-topology-export-contract-v1" || utf8 identity)
    state exp_hash(&mut self) {
        let domain: &[u8] = "omega-topology-export-contract-v1";
        self.dig.msg_n = 33 + self.str_n;
        self.k = 0;
        transition { _ -> exp_dom() }
    }
    state exp_dom(&mut self) {
        transition self.k < 33 {
            true -> prep_ed()
            _ -> exp_str_c()
        }
    }
    state prep_ed(&mut self) {
        self.h1 = self.k;
        transition self.h1 < 33 && self.h1 < 8192 {
            true -> do_ed()
            _ -> bad_11()
        }
    }
    state do_ed(&mut self) {
        let domain: &[u8] = "omega-topology-export-contract-v1";
        self.dig.msg[self.h1] = domain[self.h1];
        self.k = self.k + 1;
        transition { _ -> exp_dom() }
    }
    state exp_str_c(&mut self) {
        self.k = 0;
        transition { _ -> exp_sc_loop() }
    }
    state exp_sc_loop(&mut self) {
        transition self.k < self.str_n && self.k < 256 {
            true -> prep_es()
            _ -> exp_run()
        }
    }
    state prep_es(&mut self) {
        self.h1 = 33 + self.k;
        self.h2 = self.k;
        transition self.h1 < 8192 && self.h2 < 256 {
            true -> do_es()
            _ -> bad_12()
        }
    }
    state do_es(&mut self) {
        self.dig.msg[self.h1] = self.strbuf[self.h2];
        self.k = self.k + 1;
        transition { _ -> exp_sc_loop() }
    }
    state exp_run(&mut self) {
        self.dig.digest();
        self.k = 0;
        transition { _ -> exp_cp() }
    }
    state exp_cp(&mut self) {
        transition self.k < 32 {
            true -> prep_ec()
            _ -> exp_next()
        }
    }
    state prep_ec(&mut self) {
        self.h2 = self.i * 256 + self.jb * 32 + self.k;
        self.h3 = self.k;
        transition self.h2 < 2048 && self.h3 < 32 {
            true -> do_ec()
            _ -> bad_13()
        }
    }
    state do_ec(&mut self) {
        self.exp_contract[self.h2] = self.dig.out32[self.h3];
        self.k = self.k + 1;
        transition { _ -> exp_cp() }
    }
    state exp_next(&mut self) {
        self.jb = self.jb + 1;
        transition { _ -> exp_loop() }
    }
    // entries, outgoing, service_bounds, custody, providers, provider_closure,
    // obligations: all skipped.
    state rest(&mut self) {
        self.dskip_rows();
        transition self.ok {
            true -> rest2()
            _ -> bad_14()
        }
    }
    state rest2(&mut self) {
        self.dskip_rows();
        transition self.ok {
            true -> svc()
            _ -> bad_15()
        }
    }
    state svc(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        transition self.t64 <= 32 && self.ok {
            true -> svc_init()
            _ -> bad_16()
        }
    }
    state svc_init(&mut self) {
        self.n_svc = self.t64;
        self.jc = 0;
        transition { _ -> svc_loop() }
    }
    state svc_loop(&mut self) {
        transition self.jc < self.n_svc && self.jc < 32 && self.ok {
            true -> svc_str()
            _ -> cust()
        }
    }
    state svc_str(&mut self) {
        self.rdstr();
        transition self.ok {
            true -> svc_n()
            _ -> bad_17()
        }
    }
    state svc_n(&mut self) {
        self.ru32();
        self.t64 = (self.w32 as u64 in Wrapping) * 8;
        self.dskip(self.t64);
        self.jc = self.jc + 1;
        transition { _ -> svc_loop() }
    }
    state cust(&mut self) {
        self.dskip_rows();
        transition self.ok {
            true -> provs()
            _ -> bad_18()
        }
    }
    state provs(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        transition self.t64 <= 32 && self.ok {
            true -> prov_init()
            _ -> bad_19()
        }
    }
    state prov_init(&mut self) {
        self.n_prov = self.t64;
        self.jd = 0;
        transition { _ -> prov_loop() }
    }
    state prov_loop(&mut self) {
        transition self.jd < self.n_prov && self.jd < 32 && self.ok {
            true -> prov_head()
            _ -> prov_cl()
        }
    }
    state prov_head(&mut self) {
        self.t64 = 40;
        self.dskip(self.t64);
        transition self.ok {
            true -> prov_n()
            _ -> bad_20()
        }
    }
    state prov_n(&mut self) {
        self.ru32();
        self.d0 = self.w32 as u64 in Wrapping;
        self.m = 0;
        transition { _ -> prov_strs() }
    }
    state prov_strs(&mut self) {
        transition self.m < self.d0 && self.m < 32 && self.ok {
            true -> prov_one()
            _ -> prov_next()
        }
    }
    state prov_one(&mut self) {
        self.rdstr();
        self.m = self.m + 1;
        transition { _ -> prov_strs() }
    }
    state prov_next(&mut self) {
        self.jd = self.jd + 1;
        transition { _ -> prov_loop() }
    }
    state prov_cl(&mut self) {
        self.t64 = 32;
        self.dskip(self.t64);
        transition self.ok {
            true -> obls()
            _ -> bad_21()
        }
    }
    // obligations: u8 kind + identity string + detail[32]
    state obls(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        transition self.t64 <= 32 && self.ok {
            true -> obl_init()
            _ -> bad_22()
        }
    }
    state obl_init(&mut self) {
        self.n_obl = self.t64;
        self.je = 0;
        transition { _ -> obl_loop() }
    }
    state obl_loop(&mut self) {
        transition self.je < self.n_obl && self.je < 32 && self.ok {
            true -> obl_one()
            _ -> asms()
        }
    }
    state obl_one(&mut self) {
        self.rd();
        self.rdstr();
        self.rdstr();
        self.je = self.je + 1;
        transition { _ -> obl_loop() }
    }
    state asms(&mut self) {
        self.ru32();
        self.t64 = self.w32 as u64 in Wrapping;
        transition self.t64 <= 8 && self.ok {
            true -> asm_init()
            _ -> bad_23()
        }
    }
    state asm_init(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 {
            true -> asm_set()
            _ -> bad_24()
        }
    }
    state asm_set(&mut self) {
        self.inst_asm_n[self.h0] = self.t64;
        self.jf = 0;
        transition { _ -> asm_loop() }
    }
    state asm_loop(&mut self) {
        self.h0 = self.i;
        transition self.h0 < 8 && self.ok {
            true -> asm_g()
            _ -> bad_24b()
        }
    }
    state asm_g(&mut self) {
        transition self.jf < self.inst_asm_n[self.h0] && self.jf < 8 && self.ok {
            true -> asm_one()
            _ -> realiz()
        }
    }
    state asm_one(&mut self) {
        self.rdident();
        self.k = 0;
        transition { _ -> asm_cp() }
    }
    state asm_cp(&mut self) {
        transition self.k < 32 {
            true -> prep_asm()
            _ -> asm_next()
        }
    }
    state prep_asm(&mut self) {
        self.h2 = self.i * 256 + self.jf * 32 + self.k;
        self.h3 = self.k;
        transition self.h2 < 2048 && self.h3 < 32 {
            true -> do_asm()
            _ -> bad_25()
        }
    }
    state do_asm(&mut self) {
        self.inst_asm[self.h2] = self.ident[self.h3];
        self.k = self.k + 1;
        transition { _ -> asm_cp() }
    }
    state asm_next(&mut self) {
        self.jf = self.jf + 1;
        transition { _ -> asm_loop() }
    }
    // realization_identity: u8 tag (+32 when nonzero)
    state realiz(&mut self) {
        self.rd();
        transition self.ok {
            true -> realiz_g()
            _ -> bad_26()
        }
    }
    state realiz_g(&mut self) {
        transition self.b8 == 0 {
            true -> desc_end()
            _ -> realiz_32()
        }
    }
    state realiz_32(&mut self) {
        self.t64 = 32;
        self.dskip(self.t64);
        transition { _ -> desc_end() }
    }
    state desc_end(&mut self) {
        transition self.dq == self.desc_n && self.ok {
            true -> merge()
            _ -> bad_27()
        }
    }
    // Merge imports (slot asc, dir 0) and exports (index asc, dir 1) into the
    // canonical (slot, direction) endpoint table for instance i.
    state merge(&mut self) {
        self.j = 0;
        self.m = 0;
        self.k = 0;
        transition { _ -> merge_loop() }
    }
    state merge_loop(&mut self) {
        self.h1 = self.i;
        transition self.h1 < 8 {
            true -> merge_ck()
            _ -> bad_28()
        }
    }
    state merge_ck(&mut self) {
        transition (self.j < self.imp_n[self.h1] || self.m < self.exp_n[self.h1]) && self.k < 16 && self.ok {
            true -> merge_pick()
            _ -> merge_fin()
        }
    }
    state merge_pick(&mut self) {
        // keys: import j => slot*2 ; export m => m*2+1
        self.d1 = self.m * 2 + 1;
        transition self.j < self.imp_n[self.h1] {
            true -> key_imp()
            _ -> take_exp()
        }
    }
    state key_imp(&mut self) {
        self.h3 = self.i * 8 + self.j;
        transition self.h3 < 64 {
            true -> key_imp2()
            _ -> bad_29()
        }
    }
    state key_imp2(&mut self) {
        self.d0 = self.imp_slot[self.h3] * 2;
        transition self.d0 < self.d1 {
            true -> take_imp()
            _ -> take_exp()
        }
    }
    state take_imp(&mut self) {
        self.h2 = self.i * 16 + self.k;
        self.h3 = self.i * 8 + self.j;
        transition self.h2 < 128 && self.h3 < 64 {
            true -> ti_w()
            _ -> bad_30()
        }
    }
    state ti_w(&mut self) {
        self.ep_slot[self.h2] = self.imp_slot[self.h3];
        self.ep_dir[self.h2] = 0;
        self.t64 = 0;
        transition { _ -> ti_cp() }
    }
    state ti_cp(&mut self) {
        transition self.t64 < 32 {
            true -> ti_prep()
            _ -> ti_next()
        }
    }
    state ti_prep(&mut self) {
        self.d0 = self.h2 * 32 + self.t64;
        self.d1 = self.h3 * 32 + self.t64;
        transition self.d0 < 4096 && self.d1 < 2048 {
            true -> ti_do()
            _ -> bad_31()
        }
    }
    state ti_do(&mut self) {
        self.ep_contract[self.d0] = self.imp_contract[self.d1];
        self.t64 = self.t64 + 1;
        transition { _ -> ti_cp() }
    }
    state ti_next(&mut self) {
        self.j = self.j + 1;
        self.k = self.k + 1;
        transition { _ -> merge_loop() }
    }
    state take_exp(&mut self) {
        self.h2 = self.i * 16 + self.k;
        transition self.h2 < 128 && self.m < 8 {
            true -> te_w()
            _ -> bad_32()
        }
    }
    state te_w(&mut self) {
        self.ep_slot[self.h2] = self.m;
        self.ep_dir[self.h2] = 1;
        self.t64 = 0;
        transition { _ -> te_cp() }
    }
    state te_cp(&mut self) {
        transition self.t64 < 32 {
            true -> te_prep()
            _ -> te_next()
        }
    }
    state te_prep(&mut self) {
        self.d0 = self.h2 * 32 + self.t64;
        self.d1 = self.i * 256 + self.m * 32 + self.t64;
        transition self.d0 < 4096 && self.d1 < 2048 {
            true -> te_do()
            _ -> bad_33()
        }
    }
    state te_do(&mut self) {
        self.ep_contract[self.d0] = self.exp_contract[self.d1];
        self.t64 = self.t64 + 1;
        transition { _ -> te_cp() }
    }
    state te_next(&mut self) {
        self.m = self.m + 1;
        self.k = self.k + 1;
        transition { _ -> merge_loop() }
    }
    state merge_fin(&mut self) {
        self.ep_n[self.h1] = self.k;
        transition { _ -> done() }
    }
    state bad_03b(&mut self) {
        transition { _ -> bad() }
