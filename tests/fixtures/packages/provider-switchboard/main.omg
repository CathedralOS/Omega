// Checked provider-selection fixture; foreign-table bindings are not component dispatch.
pub boundary trait ClockHost {
    machine ticks() -> u64;
}

data MonotonicClock { }

machine MonotonicClock::ticks() -> u64
satisfies ClockHost::ticks
{
    transition { _ -> (1) }
}

pub data Switchboard {
    clock: ClockHost;
}

pub machine Switchboard::read_ticks(&mut self) -> u64
reaches ClockHost
invokes ClockHost;
{
    self.clock.ticks()
}
