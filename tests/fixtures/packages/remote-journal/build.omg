// package-manager fixture: no build-host reach; runtime API retains filesystem and network authority.
target windows_x86_64 { }
target linux_x86_64 { }
target linux_arm64 { }
target macos_arm64 { }

machine build(builder: &mut Build) {
    builder.package("remote-journal");
    builder.depend(Source::Path { location: "../host-services" });
}
