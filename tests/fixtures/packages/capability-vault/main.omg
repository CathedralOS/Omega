use omega::language::core::service;
// Capability acquisition/return fixture.
pub data SecretLease {
}

pub domain SecretLease::Held
established by SecretHost::open;

pub boundary trait SecretHost {
    machine open(name: &[u8]) -> SecretLease
    ensures
        result in SecretLease::Held
    reaches SecretHost;
}

pub data Vault {
    host: Service<SecretHost>;
}

pub machine Vault::open_secret(&mut self, name: &[u8]) -> SecretLease
reaches SecretHost
invokes SecretHost;
{
    self.host.open(name)
}
