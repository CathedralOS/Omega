use omega::language::core::service;
// Capability acquisition/return fixture.
pub boundary trait SecretLease {
    machine read_word() -> u64 reaches SecretLease;
}

pub boundary trait SecretHost {
    machine open(name: &[u8]) -> Service<SecretLease> reaches SecretHost;
}

pub data Vault {
    host: Service<SecretHost>;
}

pub machine Vault::open_secret(&mut self, name: &[u8]) -> Service<SecretLease>
reaches SecretHost
invokes SecretHost;
{
    self.host.open(name)
}
