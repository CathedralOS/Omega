// package-manager fixture root.
target windows_x86_64 { }
target linux_x86_64 { }
target linux_arm64 { }
target macos_arm64 { }

machine build(builder: &mut Build) {
    builder.package("graph-workbench");
    builder.depend(Source::Path {
        location: "../arithmetic-kernels"
    });
    builder.depend(Source::Path {
        location: "../file-journal"
    });
}
