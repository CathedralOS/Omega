machine build(builder: &mut Build) {
    Build::package(builder, package_name());
    let mut sibling_dependency: DependencyDescription = dependency::from_source(Source::Path { location: "../sibling" });
    dependency::with_alias(&mut sibling_dependency, "sibling");
    let sibling_registration: DependencyRegistration = Build::dependency(builder, sibling_dependency);
}
machine package_name() -> &[u8] { "workspace_selected" }
