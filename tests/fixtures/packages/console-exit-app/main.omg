// The reachable terminal leaves are the exact std Console output and exit
// requirements: `write_line` is checked std code over the `write_byte`
// intrinsic, and `exit_process` ends the process with status 70.
use omega::language::core::service;
use omega_language_std::console;

data Main { console: Service<Console>; }

machine Main::main(&mut self)
reaches Console
{
    self.console.write_line("console-exit-app");
    self.console.exit_process(70);
}
