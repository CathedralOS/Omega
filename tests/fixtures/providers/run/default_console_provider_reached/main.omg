use {omega}/language/core/process_exit.omg;
use {omega}/language/core/process_authority.omg;
use {system}/console.omg;

// Expected exit: 0. Expected stdout: "K\n".
// The application's Build selects no provider. The system package's Build
// supplies Console and its private byte provider for the selected target.
// ProcessExit is separate and requires its own admitted authority.
data Main { }
machine main(root: @mutable Main) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    |console|::Console::write_byte(75);
    |console|::Console::write_byte(10);
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
