public data Signal { word: AtomicU32; }

public boundary trait Clear {
    machine selected(first: @Signal, second: @Signal, choose: u32) reaches none crashes none;
}

public machine clear_selected(first: @Signal, second: @Signal, choose: u32) {
    transition choose == 7 {
        true -> clear(first),
        _ -> clear(second)
    }
    machine clear(signal: @Signal) { signal.word.store(0, Publish); }
}

public ChosenWord satisfies Clear {
    machine selected(first: @Signal, second: @Signal, choose: u32) {
        clear_selected(first, second, choose);
    }
}

machine clear_otherwise(first: @Signal, choose: u32) {
    transition choose != 7 {
        true -> clear(first),
        _ -> leave()
    }
    machine clear(signal: @Signal) { signal.word.store(0, Publish); }
    machine leave() {}
}

public AlwaysClearsFirst satisfies Clear {
    machine selected(first: @Signal, second: @Signal, choose: u32) {
        clear_selected(first, second, choose);
        clear_otherwise(first, choose);
    }
}
