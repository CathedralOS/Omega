use {signals}/main.omg as signals;

machine wait(signal: @|signals|::Signal) {
    let sampled: u32 = signal.word.load(Receive);
    transition sampled == 1 { true -> wait(signal), _ -> done() }
    machine done() {}
}

public machine work(choose: u32) reaches |signals|::Clear crashes none {
    let mutable left: |signals|::Signal;
    let mutable right: |signals|::Signal;
    left.word.store(1, Publish);
    |signals|::Clear::selected(@left, @right, choose);
    wait(@left);
}

machine main() reaches |signals|::Clear crashes none { work(7); }
