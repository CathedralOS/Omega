public data Signal { word: AtomicU32; sibling: AtomicU32; }
public boundary trait SignalUpdate {
   machine apply(first: @Signal, second: @Signal, unrelated: u32, input: u32) reaches none crashes none;
}
public machine write_pair(first: @Signal, second: @Signal, input: u32) {
   first.word.store(input, Publish);
   second.word.store(1, Publish);
}
public OrderedWrites satisfies SignalUpdate {
   machine apply(first: @Signal, second: @Signal, unrelated: u32, input: u32) { write_pair(first, second, input); }
}
public WrongField satisfies SignalUpdate {
   machine apply(first: @Signal, second: @Signal, unrelated: u32, input: u32) { first.sibling.store(0, Publish); }
}
public NoWrites satisfies SignalUpdate {
   machine apply(first: @Signal, second: @Signal, unrelated: u32, input: u32) {}
}
