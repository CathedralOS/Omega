use {signals}/main.omg as signals;

use {relay}/main.omg as relay;
machine main() reaches |relay|::Forward + |signals|::Publisher crashes Trap {
    let mutable signal: |signals|::Signal;
    signal.value.store(3, Publish);
    let observed: u32 = |relay|::Forward::publish(@signal, @signal);
    let retained: u32 = signal.value.load(Receive);
    transition observed == 0 { true -> confirm(retained), _ -> wrong() }
    machine confirm(value: u32) {
        transition value == 0 { true -> done(), _ -> wrong() }
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
