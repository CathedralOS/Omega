; Production capture reconstructs every visited call/let. The changed spelling
; $v3 -> $c100 changes byte extent while unary cache eligibility remains intact.
(def emission_test_rebuilt ((mode Int)) Int
  (let free Int (gamma_generated 'v' 3)
    (let original Int
      (if (eq mode 16)
        (gamma_first free)
        (let binder Int (gamma_generated 'z' 7)
          (gamma_let binder (gamma_first free)
            (gamma_pair binder (gamma_second free)))))
      (let captured Int (capture_expression original 100)
        (if (eq (capture_count captured) 1)
          (capture_body captured)
          (fail))))))
