# canonical scalar Functional Delta expansion
: frame 0x0 cell-get ;
: set_frame 0x0 cell-set ;
: next_frame 0x1 cell-get ;
: set_next_frame 0x1 cell-set ;
: y0 0x3d0 cell-get ;
: y1 0x3d1 cell-get ;
: y2 0x3d2 cell-get ;
: yt 0x0 0x1 assert-equal ;
: yok y2 ;
: ya 0x3d1 cell-set 0x3d0 cell-set y0 y1 + 0x3d2 cell-set y1 0x0 < branch yan yap ;
: yap y2 y0 < branch yt yok ;
: yan y0 y2 < branch yt yok ;
: ys 0x3d1 cell-set 0x3d0 cell-set y0 y1 - 0x3d2 cell-set y1 0x0 < branch ysn ysp ;
: ysp y0 y2 < branch yt yok ;
: ysn y2 y0 < branch yt yok ;
: ym 0x3d1 cell-set 0x3d0 cell-set y0 y1 * 0x3d2 cell-set y1 0x0 = branch yok ymneg ;
: ymneg y1 0xffffffffffffffff = branch ymminus ymcheck ;
: ymminus y0 0x8000000000000000 = branch yt ymcheck ;
: ymcheck y2 y1 / y0 = branch yok yt ;
: z0 0x3e0 cell-get ;
: z1 0x3e1 cell-get ;
: z2 0x3e2 cell-get ;
: zh 0x3f0 cell-get ;
: zt 0x0 0x1 assert-equal ;
: za 0x3e4 cell-set zh dup 0x3e4 cell-get + 0x3f0 cell-set ;
: ze 0x2 za dup 0x0 swap 0x0 + cell-set dup 0x0 swap 0x1 + cell-set ;
: zs dup 0x0 < branch zt zsu ;
: zsu dup 0x100 < branch zsa zt ;
: zsa 0x3e0 cell-set 0x3 za dup 0x1 swap 0x0 + cell-set dup 0x1 swap 0x1 + cell-set dup z0 swap 0x2 + cell-set ;
: zc 0x3e1 cell-set 0x3e0 cell-set z0 0x1 + cell-get z1 0x1 + cell-get + dup 0x0 < branch zt zca ;
: zca 0x3e2 cell-set 0x4 za dup 0x3 swap 0x0 + cell-set dup z2 swap 0x1 + cell-set dup z0 swap 0x2 + cell-set dup z1 swap 0x3 + cell-set ;
: zg 0x3e1 cell-set 0x3e0 cell-set z1 0x0 < branch zt zgu ;
: zgu z1 z0 0x1 + cell-get < branch zgl zt ;
: zgl z0 0x0 + cell-get 0x1 = branch zgs zgct ;
: zgs z0 0x2 + cell-get ;
: zgct z0 0x0 + cell-get 0x3 = branch zgc zt ;
: zgc z0 0x2 + cell-get 0x3e2 cell-set z1 z2 0x1 + cell-get < branch zgcl zgcr ;
: zgcl z2 0x3e0 cell-set jump zgl ;
: zgcr z1 z2 0x1 + cell-get - 0x3e1 cell-set z0 0x3 + cell-get 0x3e0 cell-set jump zgl ;
: f0001 frame next_frame set_frame frame 0x0 + cell-set frame drop t0001 frame dup set_next_frame 0x0 + cell-get set_frame ;
: t0001 frame 0x0000000000000001 + set_next_frame jump e0002 ;
: e0002 e0003 e0005 ya ;
: e0003 e0004 0x0000000000000001  + cell-get ;
: e0004 ze ;
: e0005 e0006 e000b zg ;
: e0006 e0007 e0009 zc ;
: e0007 e0008 zs ;
: e0008 0x0000000000000041 ;
: e0009 e000a zs ;
: e000a 0x0000000000000042 ;
: e000b 0x0000000000000001 ;
: main 0x0000000000000001 set_frame 0x0000000000000002 set_next_frame 0x0000000000100000 0x00000000000003f0 0x0000000000000000 + cell-set f0001 0x100 % 0x100 + 0x100 % output-byte ;
