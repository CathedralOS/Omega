# canonical scalar Functional Delta expansion
: frame 0x0 cell-get ;
: set_frame 0x0 cell-set ;
: next_frame 0x1 cell-get ;
: set_next_frame 0x1 cell-set ;
: y0 0x3d0 cell-get ;
: y1 0x3d1 cell-get ;
: y2 0x3d2 cell-get ;
: yt 0x0 0x1 assert-equal ;
: yok y2 ;
: ya 0x3d1 cell-set 0x3d0 cell-set y0 y1 + 0x3d2 cell-set y1 0x0 < branch yan yap ;
: yap y2 y0 < branch yt yok ;
: yan y0 y2 < branch yt yok ;
: ys 0x3d1 cell-set 0x3d0 cell-set y0 y1 - 0x3d2 cell-set y1 0x0 < branch ysn ysp ;
: ysp y0 y2 < branch yt yok ;
: ysn y2 y0 < branch yt yok ;
: ym 0x3d1 cell-set 0x3d0 cell-set y0 y1 * 0x3d2 cell-set y1 0x0 = branch yok ymneg ;
: ymneg y1 0xffffffffffffffff = branch ymminus ymcheck ;
: ymminus y0 0x8000000000000000 = branch yt ymcheck ;
: ymcheck y2 y1 / y0 = branch yok yt ;
: f0001 frame next_frame set_frame frame 0x0 + cell-set frame drop t0001 frame dup set_next_frame 0x0 + cell-get set_frame ;
: t0001 frame 0x0000000000000003 + set_next_frame frame 0x0000000000000002 + cell-set frame 0x0000000000000001 + cell-set jump e0004 ;
: e0004 e0005 branch e0008 e0009 ;
: e0005 e0006 e0007 = ;
: e0006 frame 0x0000000000000001 + cell-get ;
: e0007 0x0000000000000000 ;
: e0008 frame 0x0000000000000002 + cell-get ;
: e0009 e000a e000e jump t0001 ;
: e000a e000b e000c ys ;
: e000b frame 0x0000000000000001 + cell-get ;
: e000c 0x0000000000000001 ;
: e000e e000f e0010 ya ;
: e000f frame 0x0000000000000002 + cell-get ;
: e0010 frame 0x0000000000000001 + cell-get ;
: f0012 frame next_frame set_frame frame 0x0 + cell-set frame drop t0012 frame dup set_next_frame 0x0 + cell-get set_frame ;
: t0012 frame 0x0000000000000002 + set_next_frame jump e0014 ;
: e0014 e0015 frame 0x0000000000000001 + cell-set jump e0016 ;
: e0015 0x0000000000000005 ;
: e0016 e0017 e0019 jump t0001 ;
: e0017 frame 0x0000000000000001 + cell-get ;
: e0019 0x0000000000000000 ;
: main 0x0000000000000001 set_frame 0x0000000000000002 set_next_frame f0012 0x100 % 0x100 + 0x100 % output-byte ;
