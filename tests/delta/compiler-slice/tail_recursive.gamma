# canonical scalar Functional Delta expansion
: frame 0x0 cell-get ;
: set_frame 0x0 cell-set ;
: next_frame 0x1 cell-get ;
: set_next_frame 0x1 cell-set ;
: y0 0x3d0 cell-get ;
: y1 0x3d1 cell-get ;
: y2 0x3d2 cell-get ;
: yt 0x0 0x1 assert-equal ;
: yok y2 ;
: ya 0x3d1 cell-set 0x3d0 cell-set y0 y1 + 0x3d2 cell-set y1 0x0 < branch yan yap ;
: yap y2 y0 < branch yt yok ;
: yan y0 y2 < branch yt yok ;
: ys 0x3d1 cell-set 0x3d0 cell-set y0 y1 - 0x3d2 cell-set y1 0x0 < branch ysn ysp ;
: ysp y0 y2 < branch yt yok ;
: ysn y2 y0 < branch yt yok ;
: ym 0x3d1 cell-set 0x3d0 cell-set y0 y1 * 0x3d2 cell-set y1 0x0 = branch yok ymneg ;
: ymneg y1 0xffffffffffffffff = branch ymminus ymcheck ;
: ymminus y0 0x8000000000000000 = branch yt ymcheck ;
: ymcheck y2 y1 / y0 = branch yok yt ;
: f0001 frame next_frame set_frame frame 0x0 + cell-set frame drop t0001 frame dup set_next_frame 0x0 + cell-get set_frame ;
: t0001 frame 0x0000000000000002 + set_next_frame frame 0x0000000000000001 + cell-set jump e0003 ;
: e0003 e0004 branch e0007 e0008 ;
: e0004 e0005 e0006 = ;
: e0005 frame 0x0000000000000001 + cell-get ;
: e0006 0x0000000000000000 ;
: e0007 0x0000000000000001 ;
: e0008 e0009 jump t000d ;
: e0009 e000a e000b ys ;
: e000a frame 0x0000000000000001 + cell-get ;
: e000b 0x0000000000000001 ;
: f000d frame next_frame set_frame frame 0x0 + cell-set frame drop t000d frame dup set_next_frame 0x0 + cell-get set_frame ;
: t000d frame 0x0000000000000002 + set_next_frame frame 0x0000000000000001 + cell-set jump e000f ;
: e000f e0010 branch e0013 e0014 ;
: e0010 e0011 e0012 = ;
: e0011 frame 0x0000000000000001 + cell-get ;
: e0012 0x0000000000000000 ;
: e0013 0x0000000000000000 ;
: e0014 e0015 jump t0001 ;
: e0015 e0016 e0017 ys ;
: e0016 frame 0x0000000000000001 + cell-get ;
: e0017 0x0000000000000001 ;
: f0019 frame next_frame set_frame frame 0x0 + cell-set frame drop t0019 frame dup set_next_frame 0x0 + cell-get set_frame ;
: t0019 frame 0x0000000000000001 + set_next_frame jump e001a ;
: e001a e001b jump t0001 ;
: e001b 0x00000000000186a0 ;
: main 0x0000000000000001 set_frame 0x0000000000000002 set_next_frame f0019 0x100 % 0x100 + 0x100 % output-byte ;
