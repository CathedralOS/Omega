# canonical scalar Functional Delta expansion
: frame 0x0 cell-get ;
: set_frame 0x0 cell-set ;
: next_frame 0x1 cell-get ;
: set_next_frame 0x1 cell-set ;
: y0 0x3d0 cell-get ;
: y1 0x3d1 cell-get ;
: y2 0x3d2 cell-get ;
: yt 0x0 0x1 assert-equal ;
: yok y2 ;
: ya 0x3d1 cell-set 0x3d0 cell-set y0 y1 + 0x3d2 cell-set y1 0x0 < branch yan yap ;
: yap y2 y0 < branch yt yok ;
: yan y0 y2 < branch yt yok ;
: ys 0x3d1 cell-set 0x3d0 cell-set y0 y1 - 0x3d2 cell-set y1 0x0 < branch ysn ysp ;
: ysp y0 y2 < branch yt yok ;
: ysn y2 y0 < branch yt yok ;
: ym 0x3d1 cell-set 0x3d0 cell-set y0 y1 * 0x3d2 cell-set y1 0x0 = branch yok ymneg ;
: ymneg y1 0xffffffffffffffff = branch ymminus ymcheck ;
: ymminus y0 0x8000000000000000 = branch yt ymcheck ;
: ymcheck y2 y1 / y0 = branch yok yt ;
: f0005 frame next_frame set_frame frame 0x0 + cell-set frame drop t0005 frame dup set_next_frame 0x0 + cell-get set_frame ;
: t0005 frame 0x0000000000000003 + set_next_frame jump e0006 ;
: e0006 e0007 0x00000000000003f8 0x0000000000000000 + cell-set jump x0600 ;
: x0600 0x00000000000003f8 0x0000000000000000 + cell-get 0x0000000000000000 + cell-get 0x0000000000000001 = branch x0601 x0602 ;
: x0601 jump e000b ;
: x0602 0x00000000000003f8 0x0000000000000000 + cell-get 0x0000000000000001 + cell-get frame 0x0000000000000001 + cell-set jump e000f ;
: e0007 0x00000000000003f0 0x0000000000000000 + cell-get dup 0x0000000000000002 + 0x00000000000003f0 0x0000000000000000 + cell-set dup 0x0000000000000002 swap 0x0000000000000000 + cell-set dup e0008 swap 0x0000000000000001 + cell-set  ;
: e0008 0x0000000000000004 ;
: e000b 0x0000000000000000 ;
: e000f e0010 0x0000000000000401 0x0000000000000000 + cell-set jump x0f00 ;
: x0f00 0x0000000000000401 0x0000000000000000 + cell-get 0x0000000000000000 + cell-get 0x0000000000000001 = branch x0f01 x0f02 ;
: x0f01 jump e0014 ;
: x0f02 0x0000000000000401 0x0000000000000000 + cell-get 0x0000000000000001 + cell-get frame 0x0000000000000002 + cell-set jump e0018 ;
: e0010 0x00000000000003f0 0x0000000000000000 + cell-get dup 0x0000000000000002 + 0x00000000000003f0 0x0000000000000000 + cell-set dup 0x0000000000000002 swap 0x0000000000000000 + cell-set dup e0011 swap 0x0000000000000001 + cell-set  ;
: e0011 0x0000000000000005 ;
: e0014 frame 0x0000000000000001 + cell-get ;
: e0018 e0019 e001a ya ;
: e0019 frame 0x0000000000000001 + cell-get ;
: e001a frame 0x0000000000000002 + cell-get ;
: main 0x0000000000000001 set_frame 0x0000000000000002 set_next_frame 0x0000000000100000 0x00000000000003f0 0x0000000000000000 + cell-set f0005 0x100 % 0x100 + 0x100 % output-byte ;
