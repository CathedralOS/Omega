  clear_pending 0x4 to pending_kind
  expression_context_row to current_function
  expression_context_row row_aux0 to pending_aux0
  temp_one to pending_aux1 0x0 to saved_start 0x0 to saved_length
  add_row drop
  expression_context_row row_aux0 0x1 + expression_context_row 0x4 row_set
  expression_context_row row_owner to current_function
  jump p1_call_loop
;
: p1_call_done finish_consumed ;

: p1_ctor_call
