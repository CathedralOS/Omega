;
: validate_variable_kind scan_index row_kind 0xb = branch validate_variable_type validate_let_kind ;
: validate_let_kind scan_index row_kind 0xc = branch validate_let_type validate_if_kind ;
: validate_if_kind scan_index row_kind 0xd = branch validate_if_type validate_binary_kind ;
: validate_binary_kind scan_index row_kind 0x15 < branch validate_binary_type validate_call_kind ;
