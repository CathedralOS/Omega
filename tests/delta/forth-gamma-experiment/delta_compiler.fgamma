  need_token require_type temp_one 0x6 row_set
  0xc begin_list_expression temp_one expression_context_row 0x4 row_set
  p1_expression expression_context_row 0x5 row_set
  expression_context_row row_aux0 row_owner to current_scope
  p1_expression expression_context_row 0x6 row_set
  pop_scope
  finish_list dup to temp_one
  temp_one row_aux2 expression_type temp_one set_expression_type
;
: p1_add 0x1 to arithmetic_required 0xe jump p1_binary ;
: p1_sub 0x1 to arithmetic_required 0xf jump p1_binary ;
: p1_mul 0x1 to arithmetic_required 0x10 jump p1_binary ;
: p1_div 0x11 jump p1_binary ;
