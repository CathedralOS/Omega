# Downgraded Functional Delta-to-concatenative-Gamma compiler.
# This executable slice covers Int expressions, nominal data, constructors, and
# exhaustive match, and immutable Bytes; profiles and exact outcomes remain.
# Rows: kind start length owner aux0 aux1 aux2 aux3.

value cursor
value token_start
value token_length
value row_count
value current_function
value main_function
value variable_next
value scan_index
value compare_index
value lookup_owner
value saved_start
value saved_length
value pending_kind
value pending_aux0
value pending_aux1
value new_row
value temp_one
value temp_two
value number_index
value number_value
value number_negative
value expression_depth
value emit_index
value hex_value
value hex_divisor
value hex_count
value hex_digit
value current_scope
value scope_next
value pending_aux2
value pending_aux3
value seen_function
value constructor_tag_next
value current_type
value type_value
value heap_required
value arm_count
value pattern_ctor
value pattern_binders
value token_first
value arm_type
value match_row
value check_index
value binding_value
value temp_three
value expected_high
value bytes_required
value arithmetic_required
value tail_changed
: expression_context expression_depth 0x2 * 0x40 + ;
: expression_context_start expression_context cell-get ;
: expression_context_row expression_context 0x1 + cell-get ;
: match_saved_arm_count expression_depth 0xc0000 + cell-get ;
: set_match_saved_arm_count expression_depth 0xc0000 + cell-set ;
: match_saved_arm_type expression_depth 0xd0000 + cell-get ;
: set_match_saved_arm_type expression_depth 0xd0000 + cell-set ;
: match_saved_arm_row expression_depth 0xe0000 + cell-get ;
: set_match_saved_arm_row expression_depth 0xe0000 + cell-set ;
: match_saved_match_row expression_depth 0xf0000 + cell-get ;
: set_match_saved_match_row expression_depth 0xf0000 + cell-set ;

: advance cursor + to cursor ;
: next jump skip ;
: skip cursor input-length = branch no_token skip_byte ;
: no_token 0x0 ;
: skip_byte cursor input-get dup 0x3b = branch skip_comment skip_space_test ;
: skip_space_test dup 0x21 < branch skip_space token_begin ;
: skip_space drop 0x1 advance jump skip ;
: skip_comment drop 0x1 advance jump comment_loop ;
: comment_loop cursor input-length = branch no_token comment_byte ;
: comment_byte cursor input-get dup 0xa = branch comment_end comment_cr ;
: comment_cr 0xd = branch comment_end comment_advance ;
: comment_end 0x1 advance jump skip ;
: comment_advance 0x1 advance jump comment_loop ;
: token_begin
  cursor to token_start cursor input-get dup 0x28 = branch punctuation punctuation_close
;
: punctuation_close 0x29 = branch punctuation token_loop_begin ;
: punctuation drop 0x1 advance 0x1 to token_length 0x1 ;
: token_loop_begin drop jump token_loop ;
: token_loop cursor input-length = branch token_done token_body ;
: token_body cursor input-get dup 0x21 < branch token_done_drop token_semicolon ;
: token_semicolon dup 0x3b = branch token_done_drop token_open ;
: token_open dup 0x28 = branch token_done_drop token_close ;
: token_close 0x29 = branch token_done token_advance ;
: token_done_drop drop jump token_done ;
: token_advance 0x1 advance jump token_loop ;
: token_done cursor token_start - to token_length 0x1 ;
: need_token next 0x1 assert-equal ;

: token_exact to saved_length 0x0 to expected_high to saved_start
  token_length saved_length = branch exact_begin exact_false
;
: token_exact_long to saved_length to expected_high to saved_start
  token_length saved_length = branch exact_begin exact_false
;
: exact_begin 0x0 to compare_index jump exact_loop ;
: exact_loop compare_index token_length = branch exact_true exact_byte ;
: exact_byte compare_index 0x8 = branch exact_byte_high exact_byte_compare ;
: exact_byte_high expected_high to saved_start jump exact_byte_compare ;
: exact_byte_compare
  saved_start 0x100 % compare_index token_start + input-get =
  branch exact_next exact_false
;
: exact_next saved_start 0x100 / to saved_start
  compare_index 0x1 + to compare_index jump exact_loop
;
: exact_true 0x1 ;
: exact_false 0x0 ;

: is_open 0x28 0x1 token_exact ;
: is_close 0x29 0x1 token_exact ;
: is_def 0x666564 0x3 token_exact ;
: is_data 0x61746164 0x4 token_exact ;
: is_int 0x746e49 0x3 token_exact ;
: is_bytes 0x7365747942 0x5 token_exact ;
: is_if 0x6669 0x2 token_exact ;
: is_let 0x74656c 0x3 token_exact ;
: is_match 0x686374616d 0x5 token_exact ;
: is_bytes_empty 0x6d655f7365747962 0x797470 0xb token_exact_long ;
: is_bytes_single 0x69735f7365747962 0x656c676e 0xc token_exact_long ;
: is_bytes_length 0x656c5f7365747962 0x6874676e 0xc token_exact_long ;
: is_bytes_get 0x65675f7365747962 0x74 0x9 token_exact_long ;
: is_bytes_concat 0x6f635f7365747962 0x7461636e 0xc token_exact_long ;
: is_add 0x2b 0x1 token_exact ;
: is_sub 0x2d 0x1 token_exact ;
: is_mul 0x2a 0x1 token_exact ;
: is_div 0x2f 0x1 token_exact ;
: is_mod 0x25 0x1 token_exact ;
: is_eq 0x7165 0x2 token_exact ;
: is_lt 0x746c 0x2 token_exact ;
: is_main 0x6e69616d 0x4 token_exact ;
: expect_open need_token is_open 0x1 assert-equal ;
: expect_close need_token is_close 0x1 assert-equal ;
: expect_int need_token is_int 0x1 assert-equal ;

: token_first_byte token_start input-get ;
: token_is_upper token_first_byte dup to token_first
  token_first 0x41 < branch token_upper_false token_upper_high
;
: token_upper_high token_first 0x5b < branch token_upper_true token_upper_false ;
: token_upper_true 0x1 ;
: token_upper_false 0x0 ;
: token_is_lower_or_underscore token_first_byte dup to token_first
  token_first 0x5f = branch token_lower_true token_lower_range
;
: token_lower_range token_first 0x61 < branch token_lower_false token_lower_high ;
: token_lower_high token_first 0x7b < branch token_lower_true token_lower_false ;
: token_lower_true 0x1 ;
: token_lower_false 0x0 ;
: int_type 0x7000 ;
: bytes_type 0x7001 ;

: token_is_integer
  token_length 0x0 = branch integer_false integer_first
;
: integer_first token_start input-get dup 0x2d = branch integer_minus integer_digit ;
: integer_minus drop token_length 0x1 = branch integer_false integer_true ;
: integer_digit dup 0x30 < branch integer_false_drop integer_digit_high ;
: integer_digit_high 0x3a < branch integer_true integer_false ;
: integer_false_drop drop ;
: integer_false 0x0 ;
: integer_true 0x1 ;

: parse_integer
  0x0 to number_negative 0x0 to number_value 0x0 to number_index
  token_start input-get 0x2d = branch integer_mark_negative integer_loop
;
: integer_mark_negative 0x1 to number_negative 0x1 to number_index jump integer_loop ;
: integer_loop number_index token_length = branch integer_done integer_parse_digit ;
: integer_parse_digit
  number_index token_start + input-get dup 0x30 < branch bad integer_digit_upper
;
: integer_digit_upper dup 0x3a < branch integer_accumulate bad ;
: integer_accumulate 0x30 - number_value 0xa * + to number_value
  number_index 0x1 + to number_index jump integer_loop
;
: integer_done number_negative 0x1 = branch integer_negate integer_positive ;
: integer_negate 0x0 number_value - ;
: integer_positive number_value ;

: row_address 0x1 - 0x8 * 0x100 + ;
: row_get swap row_address + cell-get ;
: row_set swap row_address + cell-set ;
: row_kind 0x0 row_get ;
: row_owner 0x3 row_get ;
: row_aux0 0x4 row_get ;
: row_aux1 0x5 row_get ;
: row_aux2 0x6 row_get ;
: row_aux3 0x7 row_get ;
: tail_address 0x100000 + ;
: tail_flag tail_address cell-get ;
: set_tail_flag tail_address cell-set ;

: mark_tail dup tail_flag 0x0 = branch mark_tail_new mark_tail_known ;
: mark_tail_new 0x1 swap set_tail_flag 0x1 to tail_changed ;
: mark_tail_known drop ;

: mark_tails 0x1 to tail_changed jump tail_pass ;
: tail_pass tail_changed 0x0 = branch tail_done tail_pass_begin ;
: tail_pass_begin 0x0 to tail_changed 0x1 to scan_index jump tail_scan ;
: tail_scan row_count scan_index < branch tail_pass tail_scan_row ;
: tail_scan_row scan_index row_kind 0x1 = branch tail_function tail_marked_test ;
: tail_function scan_index row_aux1 mark_tail jump tail_scan_next ;
: tail_marked_test scan_index tail_flag 0x1 = branch tail_marked_kind tail_arm_test ;
: tail_marked_kind scan_index row_kind 0xc = branch tail_let tail_if_test ;
: tail_let scan_index row_aux2 mark_tail jump tail_scan_next ;
: tail_if_test scan_index row_kind 0xd = branch tail_if tail_scan_next ;
: tail_if
  scan_index row_aux1 mark_tail scan_index row_aux2 mark_tail
  jump tail_scan_next
;
: tail_arm_test scan_index row_kind 0x5 = branch tail_arm tail_scan_next ;
: tail_arm scan_index row_owner tail_flag 0x1 = branch tail_arm_mark tail_scan_next ;
: tail_arm_mark scan_index row_aux1 mark_tail jump tail_scan_next ;
: tail_scan_next scan_index 0x1 + to scan_index jump tail_scan ;
: tail_done ;

: begin_row row_count 0x1 + dup 0x10000 < branch begin_row_ready bad ;
: begin_row_ready dup to new_row to row_count ;
: clear_pending
  0x0 to pending_aux0 0x0 to pending_aux1
  0x0 to pending_aux2 0x0 to pending_aux3
;
: add_row
  begin_row
  pending_kind new_row 0x0 row_set
  saved_start new_row 0x1 row_set
  saved_length new_row 0x2 row_set
  current_function new_row 0x3 row_set
  pending_aux0 new_row 0x4 row_set
  pending_aux1 new_row 0x5 row_set
  pending_aux2 new_row 0x6 row_set
  pending_aux3 new_row 0x7 row_set
  new_row
;

: add_row_for_owner
  to temp_one
  current_function to temp_two
  temp_one to current_function
  add_row to temp_three
  temp_two to current_function
  temp_three
;

: scope_parent_address 0xa0000 + ;
: set_scope_parent scope_parent_address cell-set ;
: scope_parent scope_parent_address cell-get ;
: pending_binding_address 0x90000 + ;
: pending_binding_set swap pending_binding_address cell-set ;
: pending_binding_get pending_binding_address cell-get ;

: find_name to lookup_owner 0x1 to scan_index jump find_name_loop ;
: find_name_loop row_count scan_index < branch find_absent find_name_row ;
: find_name_row scan_index row_owner lookup_owner = branch find_name_length find_name_next ;
: find_name_length scan_index 0x2 row_get token_length = branch find_name_compare_begin find_name_next ;
: find_name_compare_begin 0x0 to compare_index jump find_name_compare ;
: find_name_compare compare_index token_length = branch find_present find_name_byte ;
: find_name_byte
  scan_index 0x1 row_get compare_index + input-get
  token_start compare_index + input-get = branch find_name_compare_next find_name_next
;
: find_name_compare_next compare_index 0x1 + to compare_index jump find_name_compare ;
: find_name_next scan_index 0x1 + to scan_index jump find_name_loop ;
: find_present scan_index 0x1 ;
: find_absent 0x0 0x0 ;
: require_absent find_name 0x0 assert-equal drop ;
: require_named find_name 0x1 assert-equal ;
: require_function 0x0 require_named dup row_kind 0x1 assert-equal ;
: find_variable_name
  to lookup_owner 0x1 to scan_index jump find_variable_name_loop
;
: find_variable_name_loop
  row_count scan_index < branch find_absent find_variable_name_row
;
: find_variable_name_row
  scan_index row_kind 0x2 = branch find_variable_name_owner find_variable_name_next
;
: find_variable_name_owner
  scan_index row_owner lookup_owner = branch find_variable_name_length find_variable_name_next
;
: find_variable_name_length
  scan_index 0x2 row_get token_length = branch find_variable_name_compare_begin find_variable_name_next
;
: find_variable_name_compare_begin 0x0 to compare_index jump find_variable_name_compare ;
: find_variable_name_compare
  compare_index token_length = branch find_present find_variable_name_byte
;
: find_variable_name_byte
  scan_index 0x1 row_get compare_index + input-get
  token_start compare_index + input-get = branch find_variable_name_compare_next find_variable_name_next
;
: find_variable_name_compare_next
  compare_index 0x1 + to compare_index jump find_variable_name_compare
;
: find_variable_name_next scan_index 0x1 + to scan_index jump find_variable_name_loop ;
: lookup_variable_scope
  to lookup_owner jump lookup_scope_loop
;
: lookup_scope_loop
  lookup_owner 0x0 = branch lookup_scope_absent lookup_scope_try
;
: lookup_scope_try
  lookup_owner find_variable_name
  branch lookup_scope_present lookup_scope_next
;
: lookup_scope_next drop lookup_owner scope_parent to lookup_owner jump lookup_scope_loop ;
: lookup_scope_present 0x1 ;
: lookup_scope_absent 0x0 0x0 ;
: require_variable
  current_scope lookup_variable_scope 0x1 assert-equal
  dup row_kind 0x2 assert-equal
;

: require_scope_absent
  to lookup_owner jump scope_absent_loop
;
: scope_absent_loop
  lookup_owner 0x0 = branch scope_absent_done scope_absent_try
;
: scope_absent_try
  lookup_owner find_variable_name branch bad scope_absent_next
;
: scope_absent_next drop lookup_owner scope_parent to lookup_owner jump scope_absent_loop ;
: scope_absent_done ;

: push_scope
  scope_next 0x1 + dup to scope_next
  current_scope over set_scope_parent
  to current_scope
;
: pop_scope current_scope scope_parent to current_scope ;

: find_kind
  to pending_kind 0x1 to scan_index jump find_kind_loop
;
: find_kind_loop row_count scan_index < branch find_kind_absent find_kind_row ;
: find_kind_row scan_index row_kind pending_kind = branch find_kind_length find_kind_next ;
: find_kind_length scan_index 0x2 row_get token_length = branch find_kind_compare_begin find_kind_next ;
: find_kind_compare_begin 0x0 to compare_index jump find_kind_compare ;
: find_kind_compare compare_index token_length = branch find_kind_present find_kind_byte ;
: find_kind_byte
  scan_index 0x1 row_get compare_index + input-get
  token_start compare_index + input-get = branch find_kind_compare_next find_kind_next
;
: find_kind_compare_next compare_index 0x1 + to compare_index jump find_kind_compare ;
: find_kind_next scan_index 0x1 + to scan_index jump find_kind_loop ;
: find_kind_present scan_index 0x1 ;
: find_kind_absent 0x0 0x0 ;

: require_type
  is_int branch require_type_int require_type_bytes_test
;
: require_type_int int_type ;
: require_type_bytes_test is_bytes branch require_type_bytes require_type_named ;
: require_type_bytes bytes_type ;
: require_type_named token_is_upper 0x1 assert-equal 0x6 find_kind 0x1 assert-equal
  dup row_kind 0x6 assert-equal
;

: require_constructor
  token_is_upper 0x1 assert-equal 0x7 find_kind 0x1 assert-equal
  dup row_kind 0x7 assert-equal
;

: add_type
  token_start to saved_start token_length to saved_length
  0x6 find_kind 0x0 assert-equal drop
  clear_pending 0x6 to pending_kind
  add_row
;

: add_constructor
  token_start to saved_start token_length to saved_length
  0x7 find_kind 0x0 assert-equal drop
  clear_pending 0x7 to pending_kind
  current_type to pending_aux0
  constructor_tag_next to pending_aux1
  constructor_tag_next 0x1 + to constructor_tag_next
  add_row
;

: add_constructor_field
  to temp_three to temp_two to temp_one
  clear_pending 0x8 to pending_kind
  temp_two to pending_aux0
  temp_three to pending_aux1
  0x0 to saved_start 0x0 to saved_length
  temp_one add_row_for_owner drop
;

: add_unresolved_constructor_field
  to temp_two to temp_one
  clear_pending 0x8 to pending_kind
  temp_two to pending_aux0 0x0 to pending_aux1
  token_start to saved_start token_length to saved_length
  temp_one add_row_for_owner drop
;

: add_match_arm
  clear_pending 0x5 to pending_kind
  pattern_ctor to pending_aux0
  0x0 to pending_aux1
  pattern_binders to pending_aux2
  0x0 to saved_start 0x0 to saved_length
  match_row add_row_for_owner
;

: add_arm_binding
  to temp_three to temp_two to temp_one
  clear_pending 0x9 to pending_kind
  temp_two to pending_aux0
  temp_three to pending_aux1
  0x0 to saved_start 0x0 to saved_length
  temp_one add_row_for_owner drop
;

: find_constructor_field_type
  to pending_aux0 to lookup_owner 0x1 to scan_index jump find_ctor_field_loop
;
: find_ctor_field_loop row_count scan_index < branch bad find_ctor_field_row ;
: find_ctor_field_row scan_index row_kind 0x8 = branch find_ctor_field_owner find_ctor_field_next ;
: find_ctor_field_owner scan_index row_owner lookup_owner = branch find_ctor_field_index find_ctor_field_next ;
: find_ctor_field_index scan_index row_aux0 pending_aux0 = branch find_ctor_field_found find_ctor_field_next ;
: find_ctor_field_next scan_index 0x1 + to scan_index jump find_ctor_field_loop ;
: find_ctor_field_found scan_index row_aux1 ;

: find_arm_binding
  to pending_aux0 to lookup_owner 0x1 to scan_index jump find_binding_loop
;
: find_binding_loop row_count scan_index < branch bad find_binding_row ;
: find_binding_row scan_index row_kind 0x9 = branch find_binding_owner find_binding_next ;
: find_binding_owner scan_index row_owner lookup_owner = branch find_binding_index find_binding_next ;
: find_binding_index scan_index row_aux0 pending_aux0 = branch find_binding_found find_binding_next ;
: find_binding_next scan_index 0x1 + to scan_index jump find_binding_loop ;
: find_binding_found scan_index row_aux1 ;

: add_function
  token_start to saved_start token_length to saved_length
  0x0 require_absent clear_pending 0x1 to pending_kind add_row
;
: add_variable
  token_start to saved_start token_length to saved_length
  current_scope require_scope_absent clear_pending
  0x2 to pending_kind variable_next to pending_aux0 type_value to pending_aux2
  current_scope add_row_for_owner
  variable_next 0x1 + to variable_next
;
: add_parameter add_variable dup emit_index swap 0x5 row_set ;
: add_expression add_row ;
: set_expression_type 0x7 row_set ;
: expression_type 0x7 row_get ;
: find_variable current_scope lookup_variable_scope ;

: enter_list
  expression_depth 0x1 + dup 0x60 < branch enter_list_ready bad
;
: enter_list_ready
  dup to expression_depth drop
  saved_start expression_context cell-set
;
: begin_list_expression
  clear_pending to pending_kind
  expression_context_start to saved_start 0x0 to saved_length
  add_expression dup expression_context 0x1 + cell-set drop
;
: finish_list
  expect_close expression_context_row
  expression_depth 0x1 - to expression_depth
;
: finish_consumed
  expression_context_row expression_depth 0x1 - to expression_depth
;

: initialize
  0x0 to cursor 0x0 to row_count 0x0 to current_function
  0x0 to main_function 0x0 to expression_depth
  0x0 to current_scope 0x10000 to scope_next
  0x0 to seen_function 0x1 to constructor_tag_next
  0x0 to current_type 0x0 to heap_required 0x0 to bytes_required
  0x0 to arithmetic_required
;
: parse_program initialize jump declaration_loop ;
: declaration_loop next 0x0 = branch declarations_done declaration ;
: declaration
  is_open 0x1 assert-equal need_token is_data branch data_declaration function_declaration
;
: data_declaration
  seen_function 0x0 assert-equal
  need_token add_type to current_type
  0x0 to arm_count jump data_constructor_loop
;
: data_constructor_loop
  need_token is_close branch data_done data_constructor
;
: data_constructor
  is_open 0x1 assert-equal
  need_token add_constructor to temp_one
  0x0 to emit_index
  jump data_field_loop
;
: data_field_loop
  need_token is_close branch data_constructor_done data_field
;
: data_field
  is_int branch data_field_int data_field_bytes_test
;
: data_field_int int_type jump data_field_known ;
: data_field_bytes_test is_bytes branch data_field_bytes data_field_named ;
: data_field_bytes bytes_type jump data_field_known ;
: data_field_known to type_value temp_one emit_index type_value add_constructor_field jump data_field_done ;
: data_field_named
  token_is_upper 0x1 assert-equal
  temp_one emit_index add_unresolved_constructor_field
  jump data_field_done
;
: data_field_done
  emit_index 0x1 + to emit_index
  jump data_field_loop
;
: data_constructor_done
  emit_index temp_one 0x6 row_set
  arm_count 0x1 + to arm_count
  jump data_constructor_loop
;
: data_done
  arm_count 0x0 = branch bad declaration_loop
;

: function_declaration
  is_def 0x1 assert-equal
  0x1 to seen_function
  need_token add_function to current_function
  current_function to current_scope
  0x0 current_scope set_scope_parent
  is_main branch mark_main parameters_begin
;
: mark_main current_function to main_function jump parameters_begin ;
: parameters_begin
  0x1 to variable_next 0x0 to emit_index expect_open jump parameter_loop
;
: parameter_loop need_token is_close branch parameters_done parameter ;
: parameter
  is_open 0x1 assert-equal need_token
  int_type to type_value add_parameter to temp_one
  need_token require_type to type_value
  type_value temp_one 0x6 row_set
  expect_close emit_index 0x1 + to emit_index jump parameter_loop
;
: parameters_done
  emit_index current_function 0x4 row_set
  need_token require_type current_function 0x7 row_set
  p1_expression current_function 0x5 row_set
  variable_next current_function 0x6 row_set
  expect_close
  0x0 to current_function 0x0 to current_scope
  jump declaration_loop
;
: declarations_done
  main_function 0x0 = branch bad validate_main
;
: validate_main main_function row_aux0 0x0 assert-equal
  main_function row_aux3 int_type assert-equal
;

: p1_expression
  need_token token_start to saved_start is_open branch p1_list_enter p1_atom
;
: p1_atom token_is_integer branch p1_literal p1_variable_or_constructor ;
: p1_literal
  parse_integer to temp_one clear_pending 0xa to pending_kind
  temp_one to pending_aux0 token_start to saved_start token_length to saved_length
  add_expression dup int_type swap set_expression_type
;
: p1_variable_or_constructor find_variable branch p1_variable p1_ctor_atom_miss ;
: p1_ctor_atom_miss drop jump p1_ctor_atom ;
: p1_variable
  to temp_one clear_pending 0xb to pending_kind
  temp_one to pending_aux0 token_start to saved_start token_length to saved_length
  add_expression dup temp_one 0x6 row_get swap set_expression_type
;
: p1_ctor_atom
  require_constructor to temp_one
  temp_one row_aux2 0x0 assert-equal
  0x1 to heap_required
  clear_pending 0x16 to pending_kind
  temp_one to pending_aux0 0x0 to pending_aux1
  token_start to saved_start token_length to saved_length
  add_expression dup temp_one row_aux0 swap set_expression_type
;
: p1_list_enter enter_list need_token jump p1_list ;
: p1_list
  is_if branch p1_if p1_let_test
;
: p1_let_test is_let branch p1_let p1_add_test ;
: p1_add_test is_add branch p1_add p1_sub_test ;
: p1_sub_test is_sub branch p1_sub p1_mul_test ;
: p1_mul_test is_mul branch p1_mul p1_div_test ;
: p1_div_test is_div branch p1_div p1_mod_test ;
: p1_mod_test is_mod branch p1_mod p1_eq_test ;
: p1_eq_test is_eq branch p1_eq p1_lt_test ;
: p1_lt_test is_lt branch p1_lt p1_match_test ;
: p1_match_test is_match branch p1_match p1_bytes_empty_test ;
: p1_bytes_empty_test is_bytes_empty branch p1_bytes_empty p1_bytes_single_test ;
: p1_bytes_single_test is_bytes_single branch p1_bytes_single p1_bytes_length_test ;
: p1_bytes_length_test is_bytes_length branch p1_bytes_length p1_bytes_get_test ;
