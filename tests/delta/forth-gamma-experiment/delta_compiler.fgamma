  temp_one row_aux0 expression_type to temp_two
  temp_two require_type_row
  temp_two int_type = branch bad validate_match_bytes_test
;
: validate_match_bytes_test temp_two bytes_type = branch bad validate_match_arms_begin ;
: validate_match_arms_begin
