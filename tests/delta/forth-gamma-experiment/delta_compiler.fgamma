;
: p1_ctor_argument_loop
  next 0x1 assert-equal is_close branch p1_ctor_done p1_ctor_argument
;
: p1_ctor_argument
  token_start to cursor p1_expression to temp_one
  clear_pending 0x4 to pending_kind
  expression_context_row to current_function
  expression_context_row row_aux1 to pending_aux0
  temp_one to pending_aux1 0x0 to saved_start 0x0 to saved_length
  add_row drop
