: validate_bytes_empty_test scan_index row_kind 0x18 = branch validate_bytes_empty_type validate_bytes_single_test ;
: validate_bytes_single_test scan_index row_kind 0x19 = branch validate_bytes_single_type validate_bytes_length_test ;
: validate_bytes_length_test scan_index row_kind 0x1a = branch validate_bytes_length_type validate_bytes_get_test ;
: validate_bytes_get_test scan_index row_kind 0x1b = branch validate_bytes_get_type validate_bytes_concat_test ;
: validate_bytes_concat_test scan_index row_kind 0x1c = branch validate_bytes_concat_type validate_expression_next ;
: validate_expression_next scan_index 0x1 - to scan_index jump validate_expression_loop ;
: validate_expression_done ;

: find_parameter
  to pending_aux0 to lookup_owner 0x1 to scan_index jump parameter_find_loop
;
: parameter_find_loop row_count scan_index < branch bad parameter_find_row ;
