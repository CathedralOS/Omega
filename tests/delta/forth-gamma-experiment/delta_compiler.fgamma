: find_match_arm_found scan_index ;

: emit_space text " " ;
: emit_end text " ;
" ;
: emit_colon_space text ":" emit_space ;
: emit_hex_digit hex_digit 0xa < branch emit_hex_decimal emit_hex_alpha ;
: emit_hex_decimal hex_digit 0x30 + output-byte jump emit_hex_next ;
: emit_hex_alpha hex_digit 0x57 + output-byte jump emit_hex_next ;
: emit_hex_next
  hex_value hex_divisor % to hex_value
  hex_divisor 0x10 / to hex_divisor
  hex_count 0x1 - to hex_count jump emit_hex_loop
;
: emit_hex_loop hex_count 0x0 = branch emit_hex_done emit_hex_body ;
: emit_hex_body hex_value hex_divisor / to hex_digit jump emit_hex_digit ;
: emit_hex_done ;
: emit_generated_name
  to hex_value output-byte 0x1000 to hex_divisor 0x4 to hex_count emit_hex_loop
;
: emit_f 0x66 swap emit_generated_name ;
: emit_e 0x65 swap emit_generated_name ;
: emit_x dup 0x10000 < branch emit_x_short emit_x_long ;
: emit_x_short 0x78 swap emit_generated_name ;
: emit_x_long
  to hex_value text "x"
  0x10000000 to hex_divisor 0x8 to hex_count emit_hex_loop
;
: emit_t 0x74 swap emit_generated_name ;
: emit_jump
  text "jump" emit_space
;
: emit_drop text "drop" emit_space ;
: emit_literal
  to hex_value text "0x"
  0x1000000000000000 to hex_divisor 0x10 to hex_count emit_hex_loop
;

: emit_prefix
  text "# canonical scalar Functional Delta expansion
: frame 0x0 cell-get ;
: set_frame 0x0 cell-set ;
: next_frame 0x1 cell-get ;
: set_next_frame 0x1 cell-set ;
"
;

# Emitted Bytes runtime. Values are descriptor pointers. Descriptors are
# immutable {kind, length, payload...} rows: 0 empty, 1 single, 3 concat. The
# Emitted source is literal below.
: emit_bytes_runtime
  text ": z0 0x3e0 cell-get ;
: z1 0x3e1 cell-get ;
: z2 0x3e2 cell-get ;
: zh 0x3f0 cell-get ;
: zt 0x0 0x1 assert-equal ;
: za 0x3e4 cell-set zh dup 0x3e4 cell-get + 0x3f0 cell-set ;
: ze 0x2 za dup 0x0 swap 0x0 + cell-set dup 0x0 swap 0x1 + cell-set ;
: zs dup 0x0 < branch zt zsu ;
: zsu dup 0x100 < branch zsa zt ;
: zsa 0x3e0 cell-set 0x3 za dup 0x1 swap 0x0 + cell-set dup 0x1 swap 0x1 + cell-set dup z0 swap 0x2 + cell-set ;
: zc 0x3e1 cell-set 0x3e0 cell-set z0 0x1 + cell-get z1 0x1 + cell-get + dup 0x0 < branch zt zca ;
: zca 0x3e2 cell-set 0x4 za dup 0x3 swap 0x0 + cell-set dup z2 swap 0x1 + cell-set dup z0 swap 0x2 + cell-set dup z1 swap 0x3 + cell-set ;
: zg 0x3e1 cell-set 0x3e0 cell-set z1 0x0 < branch zt zgu ;
: zgu z1 z0 0x1 + cell-get < branch zgl zt ;
