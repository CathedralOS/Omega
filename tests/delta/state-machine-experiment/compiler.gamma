;
: p2_skip_machine_result need_token need_token jump p2_machine_body ;
: p2_machine_body
  need_token is_end branch p2_machine_done p2_local
;
: p2_local is_local branch p2_skip_local p2_state ;
: p2_skip_local need_token need_token jump p2_machine_body ;
: p2_state is_state branch p2_emit_state p2_statement ;
: p2_emit_state
