  temp_one emit_store_r0 jump p2_machine_body
;
: emit_add_test is_add branch emit_add emit_sub_test ;
: emit_sub_test is_sub branch emit_sub emit_mul_test ;
: emit_mul_test is_mul branch emit_mul emit_div_test ;
: emit_div_test is_div branch emit_div emit_construct_test ;
: emit_add 0x0 set_member_count jump emit_binary ;
: emit_sub 0x1 set_member_count jump emit_binary ;
: emit_mul 0x2 set_member_count jump emit_binary ;
: emit_div 0x3 set_member_count jump emit_binary ;
: emit_binary
  require_word_variable set_temp_one require_word_variable set_temp_two
  require_word_variable set_temp_three
  temp_two emit_load_r0 drop temp_three emit_load_r1 drop
  member_count 0x0 = branch emit_binary_add emit_binary_sub_test
;
: emit_binary_add 0x1 0x0 alpha_add jump emit_binary_store ;
: emit_binary_sub_test member_count 0x1 = branch emit_binary_sub emit_binary_div ;
: emit_binary_sub 0x1 0x0 alpha_sub jump emit_binary_store ;
: emit_binary_div member_count 0x2 = branch emit_binary_mul emit_binary_divide ;
: emit_binary_mul 0x1 0x0 alpha_mul jump emit_binary_store ;
: emit_binary_divide 0x1 0x0 alpha_div jump emit_binary_store ;
: emit_binary_store temp_one emit_store_r0 jump p2_machine_body ;

: emit_construct_test is_construct branch emit_construct emit_field_set_test ;
: emit_construct
  require_variable set_temp_one require_sum set_temp_two temp_two require_case set_temp_three
  temp_one variable_type temp_two assert-equal
  temp_three symbol_owner temp_two assert-equal
  temp_three symbol_aux0 emit_constant_r0 temp_one emit_store_r0
  jump p2_machine_body
;

: emit_field_set_test is_field_set branch emit_field_set emit_field_get_test ;
: emit_field_get_test is_field_get branch emit_field_get emit_index_set_test ;
