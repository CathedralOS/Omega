  0x0 set_scan_index jump p2_skip_machine_parameters
;
: p2_skip_machine_parameters
  scan_index current_machine symbol_aux0 = branch p2_skip_machine_result p2_skip_machine_parameter
;
: p2_skip_machine_parameter
