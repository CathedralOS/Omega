: collect_switch_case
  temp_two require_owned_symbol dup 0x2 require_kind
  dup symbol_owner temp_two assert-equal
  dup symbol_aux0 switch_count assert-equal drop
  require_state symbol_aux0 switch_count 0x80 + cell-set
  switch_count 0x1 + set_switch_count jump collect_switch_targets
