  require_variable dup variable_type temp_two symbol_aux0 assert-equal emit_load_r0 drop
  temp_one variable_address temp_three 0x8 * + 0x1 alpha_imm 0x5 0x1 alpha_add
  0x0 0x1 alpha_store jump p2_machine_body
