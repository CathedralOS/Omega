  require_index
  switch_count variable_type temp_two symbol_aux0 assert-equal
  temp_one variable_address temp_three 0x8 * + 0x0 alpha_imm 0x5 0x0 alpha_add
  0x0 0x0 alpha_load switch_count emit_store_r0 jump p2_machine_body
;

: emit_call_test is_call branch emit_call emit_return_test ;
: emit_call
  require_variable set_temp_one require_machine set_temp_two
  temp_two symbol_aux3 temp_one variable_type assert-equal
  need_token parse_nat dup temp_two symbol_aux0 assert-equal set_member_count
  0x6 0x8 alpha_mov 0x6 0x9 alpha_mov
  temp_two symbol_aux1 0x1 alpha_imm 0x1 0x9 alpha_add
  0x8 0x1 alpha_imm 0x1 0x7 alpha_sub
  output-position 0x14 + 0x7 0x9 alpha_jlt 0x40 alpha_jmp
  0x5 0x8 alpha_store 0x0 set_call_index jump emit_call_argument
;
: emit_call_argument
  call_index member_count = branch emit_call_ready emit_one_call_argument
;
: emit_one_call_argument
  require_variable set_temp_three
  temp_two call_index find_parameter
  dup variable_type temp_three variable_type assert-equal
  temp_three emit_load_r0 drop emit_store_r0_at_r8
  call_index 0x1 + set_call_index jump emit_call_argument
