record AlphaItemRow item_kind AlphaKind item_a word item_b word item_c word item_i0 word item_i1 word item_i2 word item_i3 word item_i4 word item_i5 word item_i6 word item_i7 word end
record AlphaLabelRow label_target word label_defined word end
array Items AlphaItemRow 1048572
array Labels AlphaLabelRow 1048572

machine write_target target_value word target_result word
local target_divisor word
local target_count word
local target_one word
local target_zero word
state target_start
const target_divisor 256
const target_count 8
const target_one 1
const target_zero 0
goto target_loop
state target_loop
write target_value
div target_value target_value target_divisor
sub target_count target_count target_one
brzero target_count target_done target_loop
state target_done
return target_zero
end

