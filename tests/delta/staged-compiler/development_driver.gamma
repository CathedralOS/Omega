; Raw Delta frontend diagnostics, not the canonical DCREQ compiler entry.
; This unmarked transformer preserves the scalar emitter's final newline.
(def main () Int
  (let compilation Int (compile_admitted_source 0)
    (if (eq (first compilation) 0)
      (second compilation)
      (fail))))

; The development sealed input is raw Delta source followed by the bound
; support section; the same custody check covers both entries.
(def source_length () Int (- (input) (support_packed_extent)))

(def source_read ((index Int)) Int (read index))

(def compilation_profile () Int 0)
