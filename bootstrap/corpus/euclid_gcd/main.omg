// Greatest common divisor by Euclid's algorithm: repeatedly replace (a, b) with
// (b, a mod b) until b is 0; a is then the GCD. gcd(48, 36) = 12. Two-and-a-half
// millennia old and still the standard way to reduce a fraction. Showcases the
// modulo operator over a self-transition loop (the divisor b is a live runtime
// value, not a constant). The step's three-way swap goes through a `tmp` FIELD
// rather than a `let` local on purpose -- see euclid_gcd's note below.
//
// (A `let r = self.state.a % self.state.b; self.state.a = self.state.b;
// self.state.b = r;` form currently miscompiles: the let-local is inline-folded
// back to `a % b` at its use, after `a` was reassigned. A `tmp` field is read from
// its slot, so it is correct. The fold bug is filed separately.)
// Expected exit: 12.

use omega::language::std::console;

data Euclid [copy] {
    a: i32 in Trapping;
    b: i32 in Trapping;
    tmp: i32 in Trapping;
}

data Main {
    console: Console;
    state: Euclid;
}

machine Main::main(&mut self) {
    self.state.a = 48;
    self.state.b = 36;

    transition {
        _ -> step()
    }

    state step(&mut self) {
        transition self.state.b == 0 {
            true -> done()
            _ -> reduce()
        }
    }

    state reduce(&mut self) {
        self.state.tmp = self.state.a % self.state.b;
        self.state.a = self.state.b;
        self.state.b = self.state.tmp;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.exit_process(self.state.a);
    }
}
