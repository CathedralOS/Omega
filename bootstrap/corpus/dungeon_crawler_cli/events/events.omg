use enemies::enemies;
use rewards::rewards;

data RoomEventKind {
    case Nothing;
    case FountainOfLife;
    case Treasure;
    case GoldCache;
    case Enemy;
}

data RoomEventAction {
    case Quiet;
    case Fountain;
    case Reward;
    case Enemy;
}

data RoomEvent {
    kind: RoomEventKind;
    enemy: Enemy;
    reward: Reward;
    consumed: bool;
}
