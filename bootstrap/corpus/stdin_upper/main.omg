// stdin_upper: an input-taking FILTER — reads bytes until a '.' terminator,
// uppercases a..z, writes every byte through, exits with the byte count.
// Exercises input and dual-channel output TOGETHER: per input vector the gate
// proves the exit in the kernel AND pins the full stdout to the interpreter's
// printed pair (the render check). The '.'-terminator protocol (rather than
// EOF) keeps values non-negative, so the meaning route stays in user mode —
// ℤ-pair structural results are a future encoder extension.
//
// Expected exit: 0.
// INPUT-GRID:
//   "." -> 0
//   "a." -> 1
//   "hi." -> 2
//   "Mix." -> 3
//   "a z." -> 3

use omega::language::std::console;

data Main {
    console: Console;
    n: i32 in Wrapping;
}

machine Main::main(&mut self) {
    transition { _ -> rd() }

    state rd(&mut self) {
        let b: i32 in Wrapping = read_byte();
        transition b == 46 {
            true -> fin()
            _ -> wr(b)
        }
    }

    state wr(&mut self, b: i32 in Wrapping) {
        self.n = self.n + 1;
        transition b >= 97 && b <= 122 {
            true -> up(b)
            _ -> keep(b)
        }
    }

    state up(&mut self, b: i32 in Wrapping) {
        write_byte(b - 32);
        transition { _ -> rd() }
    }

    state keep(&mut self, b: i32 in Wrapping) {
        write_byte(b);
        transition { _ -> rd() }
    }

    state fin(&mut self) {
        self.console.exit_process(self.n);
    }
}
