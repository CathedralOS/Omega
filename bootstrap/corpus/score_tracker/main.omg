// Score tracker. Combines case-payload events, fixed arrays, scalar
// accumulation, [copy] property, and multi-arm case dispatch.
//
// Two players compete. Events: Score(player, points) adds to a player's
// total; Bonus(player) doubles their current score; Reset(player) zeroes it.
//
// Sequence:
//   Score(0, 30)   -> player[0] = 30
//   Score(1, 20)   -> player[1] = 20
//   Bonus(0)       -> player[0] = 60
//   Score(1, 10)   -> player[1] = 30
//   Reset(1)       -> player[1] = 0
//   Score(1, 10)   -> player[1] = 10
//
// Final: player[0]=60, player[1]=10, total=70. Exit 70.
//
// Expected exit: 70.

use omega::language::std::console;

// Events that change player scores.
data Event {
    case Score(player: i32 in Saturating, points: i32 in Saturating);
    case Bonus(player: i32 in Saturating);
    case Reset(player: i32 in Saturating);
}

data Tracker [copy] {
    total: i32 in Saturating;
}

data Main {
    console: Console;
    scores: [i32 in Saturating; 2];
    tracker: Tracker;
}

machine Main::main(&mut self) {
    self.apply(Event::Score { player: 0, points: 30 });
    self.apply(Event::Score { player: 1, points: 20 });
    self.apply(Event::Bonus { player: 0 });
    self.apply(Event::Score { player: 1, points: 10 });
    self.apply(Event::Reset { player: 1 });
    self.apply(Event::Score { player: 1, points: 10 });

    // player[0] = 60, player[1] = 10, total = 70
    self.tracker.total = self.scores[0] + self.scores[1];

    transition self.tracker.total == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

// Apply one event to the scores array.
machine Main::apply(&mut self, event: Event) {
    transition event {
        Event::Score { player, points } -> add_score(player, points)
        Event::Bonus { player } -> double_score(player)
        Event::Reset { player } -> reset_score(player)
        _ -> done()
    }

    state add_score(&mut self, player: i32 in Saturating, points: i32 in Saturating) {
        transition player == 0 {
            true -> add_p0(points)
            _ -> add_p1(points)
        }
    }

    state add_p0(&mut self, points: i32 in Saturating) {
        self.scores[0] = self.scores[0] + points;
    }

    state add_p1(&mut self, points: i32 in Saturating) {
        self.scores[1] = self.scores[1] + points;
    }

    state double_score(&mut self, player: i32 in Saturating) {
        transition player == 0 {
            true -> double_p0()
            _ -> double_p1()
        }
    }

    state double_p0(&mut self) {
        self.scores[0] = self.scores[0] * 2;
    }

    state double_p1(&mut self) {
        self.scores[1] = self.scores[1] * 2;
    }

    state reset_score(&mut self, player: i32 in Saturating) {
        transition player == 0 {
            true -> reset_p0()
            _ -> reset_p1()
        }
    }

    state reset_p0(&mut self) {
        self.scores[0] = 0;
    }

    state reset_p1(&mut self) {
        self.scores[1] = 0;
    }

    state done(&mut self) {
    }
}
