          (let ((c Int (if arity (e2 b 14 1 1) b))
                (d Int (if (eq arity 2) (e2 c 14 3 1) c)))
            (e2 (e_scalar_op d kind) 1 1 0)))))))

(def c_let ((xs Int)) Int
  (if (eq (p_length xs) 5)
    (let ((typecheck Int (c_check (eq (c_kind (c_nth xs 2)) 2) 0))
