; Shared Gamma compiler. The frontend consumes sealed source bytes. Lowering
; calls the selected target assembler. Each encoded field contributes its own
; width to label offsets. Publication follows validation of every body.
; Runtime values use a word/tag pair; source cannot forge a heap reference.

(def $application () Int 1)

(def c_a ((x Int)) Int (first x))
(def c_b ((x Int)) Int (first (second x)))
(def c_c ((x Int)) Int (first (second (second x))))
(def c_d ((x Int)) Int (second (second (second x))))
(def c_record ((a Int) (b Int) (c Int) (d Int)) Int
  (pair a (pair b (pair c d))))
(def c_max ((a Int) (b Int)) Int (if (lt a b) b a))
(def c_check ((ok Int) (value Int)) Int (if ok value (p_fail)))

; An AVL tree maps machine label identifiers to byte addresses. Empty trees
; have height zero; no condition ever inspects a pair as a scalar.
(def m_empty () Int (pair 0 0))
(def m_height ((t Int)) Int (first t))
(def m_key ((t Int)) Int (c_a (second t)))
(def m_value ((t Int)) Int (c_b (second t)))
(def m_left ((t Int)) Int (c_c (second t)))
(def m_right ((t Int)) Int (c_d (second t)))
(def m_node ((key Int) (value Int) (left Int) (right Int)) Int
  (pair (+ 1 (c_max (m_height left) (m_height right)))
    (c_record key value left right)))
(def m_rotate_left ((t Int)) Int
  (let r Int (m_right t)
    (m_node (m_key r) (m_value r)
      (m_node (m_key t) (m_value t) (m_left t) (m_left r)) (m_right r))))
(def m_rotate_right ((t Int)) Int
  (let l Int (m_left t)
    (m_node (m_key l) (m_value l) (m_left l)
      (m_node (m_key t) (m_value t) (m_right l) (m_right t)))))
(def m_balance ((t Int)) Int
  (let ((l Int (m_left t)) (r Int (m_right t)))
    (if (lt (+ 1 (m_height r)) (m_height l))
      (m_rotate_right
        (if (lt (m_height (m_left l)) (m_height (m_right l)))
          (m_node (m_key t) (m_value t) (m_rotate_left l) r) t))
      (if (lt (+ 1 (m_height l)) (m_height r))
        (m_rotate_left
          (if (lt (m_height (m_right r)) (m_height (m_left r)))
            (m_node (m_key t) (m_value t) l (m_rotate_right r)) t)) t))))
(def m_put ((t Int) (key Int) (value Int)) Int
  (if (m_height t)
    (if (eq key (m_key t)) (p_fail)
      (if (lt key (m_key t))
        (m_balance (m_node (m_key t) (m_value t)
          (m_put (m_left t) key value) (m_right t)))
        (m_balance (m_node (m_key t) (m_value t)
          (m_left t) (m_put (m_right t) key value)))))
    (m_node key value (m_empty) (m_empty))))
(def m_get ((t Int) (key Int)) Int
  (if (m_height t)
    (if (eq key (m_key t)) (m_value t)
      (if (lt key (m_key t)) (m_get (m_left t) key)
        (m_get (m_right t) key))) (p_fail)))

; State pairs the next label and local slot with the reversed fields.
(def s_next_label ((s Int)) Int (first (first s)))
(def s_slots ((s Int)) Int (second (first s)))
(def s_new ((s Int)) Int
  (pair (pair (+ 1 (s_next_label s)) (s_slots s)) (second s)))
(def s_local ((s Int) (slots Int)) Int
  (pair (pair (s_next_label s) slots) (second s)))

; A positive width declares a literal field. An address reference reserves
; eight bytes, and a label marks a position between fields. Zero ends the
; list. Only the target assembler and compiler can construct these records.
(def i_field ((s Int) (width Int) (value Int)) Int
  (pair (first s) (pair width (pair value (second s)))))
(def i_address ((s Int) (label Int)) Int (i_field s -1 label))
(def s_mark ((s Int) (label Int)) Int (i_field s -2 label))
(def i_width ((width Int)) Int (if (eq width -1) 8 width))

(def e_add ((s Int) (reg Int) (value Int)) Int
  (i_add (i_imm s 12 value) reg 12))
(def e_bound ((s Int) (reg Int) (end Int) (error Int)) Int
  (i_jlt (i_imm s 13 end) 13 reg error))
(def e_push ((s Int)) Int
  (let ((a Int (i_mov s 10 246))
        (b Int (e_add a 10 16))
        (c Int (e_bound b 10 134217728 2))
        (d Int (i_store c 246 0))
        (e Int (e_add d 246 8))
        (f Int (i_store e 246 1)))
    (e_add f 246 8)))
(def e_pop ((s Int) (value Int) (tag Int)) Int
  (let ((a Int (e_add s 246 -8))
        (b Int (i_load a tag 246))
        (c Int (e_add b 246 -8)))
    (i_load c value 246)))
(def e_slot ((s Int) (offset Int) (store Int)) Int
  (let ((a Int (e_add (i_mov s 10 247) 10 (* offset 16)))
        (b Int (if store (i_store a 10 0) (i_load a 0 10)))
        (c Int (e_add b 10 8)))
    (if store (i_store c 10 1) (i_load c 1 10))))

; Walk the reversed fields once. At a label, the byte count is its
; distance from the end of the code. Keep only emitting fields, in order.
(def i_layout ((fields Int) (size Int) (ordered Int) (labels Int)) Int
  (let width Int (first fields)
    (if width
      (let ((body Int (second fields)) (value Int (first body))
            (rest Int (second body)))
        (if (eq width -2)
          (i_layout rest size ordered (m_put labels value size))
          (i_layout rest (+ size (i_width width)) (pair fields ordered) labels)))
      (i_publish ordered size labels))))

; Publication follows validation and the capacity check. A label's absolute
; address is the code end minus its saved distance. Literals pass through.
(def i_output ((fields Int) (remaining Int) (labels Int) (end Int)) Int
  (if remaining
    (let ((field Int (first fields)) (width Int (first field))
          (value Int (first (second field))) (bytes Int (i_width width))
          (word Int (if (eq width -1) (- end (m_get labels value)) value))
          (emitted Int (i_word word bytes)))
      (i_output (second fields) (- remaining bytes) labels end))
    (pair 0 1)))
(def i_word ((word Int) (remaining Int)) Int
  (if remaining
    (let ((byte Int (% (+ (% word 256) 256) 256))
          (ignored Int (write byte)))
      (i_word (/ (- word byte) 256) (- remaining 1))) 0))

; Runtime entry seals input, executes main, then atomically publishes output.
(def e_header ((s Int) (mainid Int)) Int
  (let (
    (s0 Int (i_imm s 246 33554432))
    (s1 Int (i_imm s0 247 0))
    (s2 Int (i_imm s1 248 805306368))
    (s3 Int (i_imm s2 249 0))
    (s4 Int (i_imm s3 250 0))
    (s5 Int (i_imm s4 243 1))
    (s6 Int (s_mark s5 7))
    (s7 Int (i_read s6 0))
    (s8 Int (i_imm s7 1 -1))
    (s9 Int (i_jeq s8 0 1 8))
    (s10 Int (i_mov s9 10 249))
    (s11 Int (e_add s10 10 1))
    (s12 Int (e_bound s11 10 137363456 4))
    (s13 Int (i_mov s12 10 249))
    (s14 Int (e_add s13 10 268435456))
    (s15 Int (i_storeb s14 10 0))
    (s16 Int (e_add s15 249 1))
    (s17 Int (i_jmp s16 7))
    (s18 Int (s_mark s17 8))
    (s19 Int (i_call s18 mainid)))
    s19))
(def e_application ((s Int)) Int
  (let (
    (s0 Int (i_jz s 1 1))
    (s1 Int (i_mov s0 10 0))
    (s2 Int (i_load s1 15 10))
    (s3 Int (e_add s2 10 8))
    (s4 Int (i_load s3 1 10))
    (s5 Int (i_jnz s4 1 1))
    (s6 Int (e_add s5 10 8))
    (s7 Int (i_load s6 2 10))
    (s8 Int (e_add s7 10 8))
    (s9 Int (i_load s8 3 10))
    (s10 Int (i_jnz s9 3 1))
    (s11 Int (i_imm s10 4 0))
    (s12 Int (i_jlt s11 15 4 1))
    (s13 Int (i_imm s12 4 254))
    (s14 Int (i_jlt s13 4 15 1))
    (s15 Int (i_jz s14 2 9))
    (s16 Int (i_imm s15 4 1))
    (s17 Int (i_jeq s16 2 4 10))
    (s18 Int (i_jmp s17 1))
    (s19 Int (s_mark s18 9))
    (s20 Int (i_jz s19 15 1))
    (s21 Int (i_halt s20 15))
    (s22 Int (s_mark s21 10))
    (s23 Int (i_jz s22 15 11))
    (s24 Int (i_jz s23 250 1))
    (s25 Int (s_mark s24 11)))
    s25))
(def e_scalar ((s Int)) Int
  (let (
    (s0 Int (i_jnz s 1 1))
    (s1 Int (i_call s0 6))
    (s2 Int (i_imm s1 15 0)))
    s2))
(def e_finish ((s Int) (application Int)) Int
  (let (
    (s0 Int (i_imm s 8 0))
    (s1 Int (s_mark s0 12))
    (s2 Int (i_jeq s1 8 250 13))
    (s3 Int (i_mov s2 10 8))
    (s4 Int (e_add s3 10 536870912))
    (s5 Int (i_loadb s4 0 10))
    (s6 Int (i_write s5 0))
    (s7 Int (e_add s6 8 1))
    (s8 Int (i_jmp s7 12))
    (s9 Int (s_mark s8 13))
    (s10 Int (i_halt s9 15))
    (s11 Int (s_mark s10 6))
    (s12 Int (i_imm s11 4 0))
    (s13 Int (i_jlt s12 0 4 1))
    (s14 Int (i_imm s13 4 255))
    (s15 Int (i_jlt s14 4 0 1))
    (s16 Int (i_mov s15 10 250))
    (s17 Int (e_add s16 10 1))
    (s18 Int (e_bound s17 10 134217728 5))
    (s19 Int (i_mov s18 10 250))
    (s20 Int (e_add s19 10 536870912))
    (s21 Int (i_storeb s20 10 0))
    (s22 Int (e_add s21 250 1))
    (s23 Int (i_ret s22))
    (s24 Int (s_mark s23 1))
    (s25 Int (i_imm s24 0 (if application 249 2)))
    (s26 Int (i_halt s25 0))
    (s27 Int (s_mark s26 2))
    (s28 Int (i_imm s27 0 (if application 250 3)))
    (s29 Int (i_halt s28 0))
    (s30 Int (s_mark s29 3))
    (s31 Int (i_imm s30 0 (if application 252 3)))
    (s32 Int (i_halt s31 0))
    (s33 Int (s_mark s32 4))
    (s34 Int (i_imm s33 0 (if application 253 3)))
    (s35 Int (i_halt s34 0))
    (s36 Int (s_mark s35 5))
    (s37 Int (i_imm s36 0 (if application 254 3)))
    (s38 Int (i_halt s37 0)))
    s38))
(def e_runtime ((s Int) (application Int) (mainid Int)) Int
  (let h Int (e_header s mainid)
    (e_finish (if application (e_application h) (e_scalar h)) application)))

; Fixed syntax words are compared byte-for-byte; identifiers remain source spans.
(def c_kind ((node Int)) Int
  (if (eq (first node) 2)
    (let ((span Int (second node)) (at Int (first span))
          (size Int (- (second span) at)))
      (if
        (if (eq size 3)
          (* (eq (read (+ at 0)) 'd')
            (* (eq (read (+ at 1)) 'e')
              (eq (read (+ at 2)) 'f')))
          0)
        1
      (if
        (if (eq size 3)
          (* (eq (read (+ at 0)) 'I')
            (* (eq (read (+ at 1)) 'n')
              (eq (read (+ at 2)) 't')))
          0)
        2
      (if
        (if (eq size 4)
          (* (eq (read (+ at 0)) 'm')
            (* (eq (read (+ at 1)) 'a')
              (* (eq (read (+ at 2)) 'i')
                (eq (read (+ at 3)) 'n'))))
          0)
        3
      (if
        (if (eq size 12)
          (* (eq (read (+ at 0)) '$')
            (* (eq (read (+ at 1)) 'a')
              (* (eq (read (+ at 2)) 'p')
                (* (eq (read (+ at 3)) 'p')
                  (* (eq (read (+ at 4)) 'l')
                    (* (eq (read (+ at 5)) 'i')
                      (* (eq (read (+ at 6)) 'c')
                        (* (eq (read (+ at 7)) 'a')
                          (* (eq (read (+ at 8)) 't')
                            (* (eq (read (+ at 9)) 'i')
                              (* (eq (read (+ at 10)) 'o')
                                (eq (read (+ at 11)) 'n'))))))))))))
          0)
        4
      (if
        (if (eq size 2)
          (* (eq (read (+ at 0)) 'i')
            (eq (read (+ at 1)) 'f'))
          0)
        5
      (if
        (if (eq size 3)
          (* (eq (read (+ at 0)) 'l')
            (* (eq (read (+ at 1)) 'e')
              (eq (read (+ at 2)) 't')))
          0)
        6
      (if
        (if (eq size 1)
          (eq (read (+ at 0)) '+')
          0)
        7
      (if
        (if (eq size 1)
          (eq (read (+ at 0)) '-')
          0)
        8
      (if
        (if (eq size 1)
          (eq (read (+ at 0)) '*')
          0)
        9
      (if
        (if (eq size 1)
          (eq (read (+ at 0)) '/')
          0)
        10
      (if
        (if (eq size 1)
          (eq (read (+ at 0)) '%')
          0)
        11
      (if
        (if (eq size 2)
          (* (eq (read (+ at 0)) 'e')
            (eq (read (+ at 1)) 'q'))
          0)
        12
      (if
        (if (eq size 2)
          (* (eq (read (+ at 0)) 'l')
            (eq (read (+ at 1)) 't'))
          0)
        13
      (if
        (if (eq size 4)
          (* (eq (read (+ at 0)) 'p')
            (* (eq (read (+ at 1)) 'a')
              (* (eq (read (+ at 2)) 'i')
                (eq (read (+ at 3)) 'r'))))
          0)
        14
      (if
        (if (eq size 4)
          (* (eq (read (+ at 0)) 'r')
            (* (eq (read (+ at 1)) 'e')
              (* (eq (read (+ at 2)) 'a')
                (eq (read (+ at 3)) 'd'))))
          0)
        15
      (if
        (if (eq size 5)
          (* (eq (read (+ at 0)) 'w')
            (* (eq (read (+ at 1)) 'r')
              (* (eq (read (+ at 2)) 'i')
                (* (eq (read (+ at 3)) 't')
                  (eq (read (+ at 4)) 'e')))))
          0)
        16
      (if
        (if (eq size 5)
          (* (eq (read (+ at 0)) 'f')
            (* (eq (read (+ at 1)) 'i')
              (* (eq (read (+ at 2)) 'r')
                (* (eq (read (+ at 3)) 's')
                  (eq (read (+ at 4)) 't')))))
          0)
        17
      (if
        (if (eq size 6)
          (* (eq (read (+ at 0)) 's')
            (* (eq (read (+ at 1)) 'e')
              (* (eq (read (+ at 2)) 'c')
                (* (eq (read (+ at 3)) 'o')
                  (* (eq (read (+ at 4)) 'n')
                    (eq (read (+ at 5)) 'd'))))))
          0)
        18
      (if
        (if (eq size 5)
          (* (eq (read (+ at 0)) 'i')
            (* (eq (read (+ at 1)) 'n')
              (* (eq (read (+ at 2)) 'p')
                (* (eq (read (+ at 3)) 'u')
                  (eq (read (+ at 4)) 't')))))
          0)
        19
        0)))))))))))))))))))) 0))

(def c_list ((node Int)) Int
  (if (eq (first node) 3) (second node) (p_fail)))
(def c_nth ((xs Int) (n Int)) Int
  (if n (c_nth (p_tail xs) (- n 1)) (p_head xs)))
(def c_name ((node Int)) Int (c_check (eq (first node) 2) node))
(def c_env_find ((env Int) (name Int)) Int
  (if (p_length env)
    (let entry Int (p_head env)
      (if (p_name_eq (first entry) name) (pair 1 (second entry))
        (c_env_find (p_tail env) name))) (pair 0 0)))
(def c_env_get ((env Int) (name Int)) Int
  (let found Int (c_env_find env name)
    (if (first found) (second found) (p_fail))))
(def c_env_add ((env Int) (name Int) (slot Int)) Int
  (if (first (c_env_find env (c_name name))) (p_fail)
    (p_cons (pair name slot) env)))
(def c_params ((params Int) (slot Int) (env Int)) Int
  (if (p_length params)
    (let ((entry Int (c_list (p_head params)))
          (checked Int (c_check (eq (p_length entry) 2) entry))
          (name Int (c_name (p_head checked)))
          (type Int (c_check (eq (c_kind (c_nth checked 1)) 2) 0)))
      (c_params (p_tail params) (+ slot 1) (c_env_add env name slot))) env))
(def c_find ((functions Int) (name Int)) Int
  (if (p_length functions)
    (let entry Int (p_head functions)
      (if (p_name_eq (c_a entry) name) (pair 1 entry)
        (c_find (p_tail functions) name))) (pair 0 0)))
(def c_main_find ((functions Int)) Int
  (if (p_length functions)
    (let f Int (p_head functions)
      (if (eq (c_kind (c_a f)) 3)
        (c_check (eq (p_length (c_b f)) 0) (c_d f))
        (c_main_find (p_tail functions)))) (p_fail)))
(def c_application ((functions Int)) Int
  (if (p_length functions) (eq (c_kind (c_a (p_head functions))) 4) 0))
(def c_declarations ((roots Int) (id Int) (functions Int)) Int
  (if (p_length roots)
    (let ((root Int (c_list (p_head roots)))
          (checked Int (c_check (eq (p_length root) 5) root))
          (defcheck Int (c_check (eq (c_kind (p_head checked)) 1) 0))
          (name Int (c_name (c_nth checked 1)))
          (params Int (c_list (c_nth checked 2)))
          (typecheck Int (c_check (eq (c_kind (c_nth checked 3)) 2) 0))
          (body Int (c_nth checked 4))
          (paramcheck Int (c_params params 0 (p_empty)))
          (unique Int (c_check (eq (first (c_find functions name)) 0) 0))
          (marker Int (if (eq (c_kind name) 4)
            (c_check (* (eq id 100) (* (eq (p_length params) 0)
              (* (eq (first body) 1) (eq (second body) 1)))) 0) 0)))
      (c_declarations (p_tail roots) (+ id 1)
        (p_cons (c_record name params body id) functions)))
    (p_reverse functions)))

; Count lexical homes before the fixed-size prologue is emitted. Traversal is
; explicit, and later compilation validates every visited form before output.
(def c_append_work ((xs Int) (work Int)) Int
  (if (p_length xs)
    (c_append_work (p_tail xs) (p_cons (p_head xs) work)) work))
(def c_initializer_work ((bindings Int) (work Int)) Int
  (if (p_length bindings)
    (let binding Int (c_list (p_head bindings))
      (c_initializer_work (p_tail bindings)
        (p_cons (c_nth binding 2) work))) work))
(def c_local_count ((work Int) (total Int)) Int
  (if (p_length work)
    (let ((node Int (p_head work)) (rest Int (p_tail work)))
      (if (eq (first node) 3)
        (let ((xs Int (second node)) (kind Int (c_kind (p_head xs))))
          (if (eq kind 6)
            (let shape Int (c_let xs)
              (c_local_count
                (c_initializer_work (first shape) (p_cons (second shape) rest))
                (+ total (p_length (first shape)))))
            (c_local_count (c_append_work (p_tail xs) rest) total)))
        (c_local_count rest total))) total))

; Actions make expression traversal independent of the evaluator's call stack.
; Every action is a tagged record; environments persist across branch forks.
(def a_expr ((node Int) (env Int) (tail Int)) Int
  (pair 0 (c_record node env tail 0)))
(def a_simple ((tag Int) (a Int) (b Int) (c Int) (d Int)) Int
  (pair tag (c_record a b c d)))
(def a_args ((args Int) (env Int) (work Int)) Int
  (if (p_length args)
    (a_args (p_tail args) env (p_cons (a_expr (p_head args) env 0) work)) work))
(def c_arity ((kind Int)) Int
  (if (lt kind 15) 2 (if (eq kind 19) 0 1)))
(def c_is_primitive ((kind Int)) Int (* (lt 6 kind) (lt kind 20)))

; Argument values are on the evaluation stack before any caller binding moves.
(def e_move_args ((s Int) (words Int)) Int
  (if words
    (let ((a Int (i_load s 0 8)) (b Int (i_store a 9 0))
          (c Int (e_add b 8 8)) (d Int (e_add c 9 8)))
      (e_move_args d (- words 1))) s))
(def e_call ((s Int) (id Int) (argc Int) (tail Int) (parameters Int)) Int
  (if tail
    (let ((a Int (e_slot s parameters 0))
          (b Int (i_mov a 14 0)) (c Int (i_mov b 8 246))
          (d Int (e_add c 8 (* -16 argc))) (e Int (i_mov d 9 247))
          (f Int (e_move_args e (* 2 argc)))
          (g Int (i_mov f 246 9)) (h Int (i_mov g 247 14)))
      (i_jmp h id))
    (let ((a Int (e_add s 243 1)) (b Int (e_bound a 243 131072 2)))
      (e_push (i_call b id)))))

(def e_pair_fields ((s Int) (reg Int)) Int
  (if (lt reg 4)
    (e_pair_fields (e_add (i_store s 248 reg) 248 8) (+ reg 1)) s))
(def e_pair ((s Int)) Int
  (let ((a Int (e_add (i_mov s 10 248) 10 32))
        (b Int (e_bound a 10 137438953472 3))
        (c Int (i_mov b 4 248)) (d Int (e_pair_fields c 0))
        (e Int (i_mov d 0 4)))
    (i_imm e 1 1)))
(def e_project ((s Int) (kind Int)) Int
  (let ((a Int (i_jz s 1 1)) (b Int (i_mov a 10 0))
        (c Int (if (eq kind 18) (e_add b 10 16) b))
        (d Int (i_load c 0 10)) (e Int (e_add d 10 8)))
    (i_load e 1 10)))
(def e_divide ((s Int) (kind Int)) Int
  (let ((good Int (+ (s_next_label s) 1)) (after Int (+ good 1))
        (a Int (s_new (s_new s)))
        (b Int (i_jz a 2 1)) (c Int (i_imm b 4 -9223372036854775808))
        (d Int (i_jeq c 0 4 good)) (e Int (i_jmp d after))
        (f Int (s_mark e good)) (g Int (i_imm f 4 -1))
        (h Int (i_jeq g 2 4 1)) (i Int (s_mark h after)))
    (if (eq kind 10) (i_div i 0 2) (i_mod i 0 2))))
(def e_compare ((s Int) (kind Int)) Int
  (let ((yes Int (+ (s_next_label s) 1)) (done Int (+ yes 1))
        (a Int (s_new (s_new s)))
        (b Int (if (eq kind 12) (i_jeq a 0 2 yes) (i_jlt a 0 2 yes)))
        (c Int (i_imm b 0 0)) (d Int (i_jmp c done))
        (e Int (s_mark d yes)) (f Int (i_imm e 0 1)))
    (s_mark f done)))
(def e_read ((s Int)) Int
  (let ((good Int (+ (s_next_label s) 1)) (a Int (s_new s))
        (b Int (i_imm a 4 0)) (c Int (i_jlt b 0 4 1))
        (d Int (i_jlt c 0 249 good)) (e Int (i_jmp d 1))
        (f Int (s_mark e good)) (g Int (e_add f 0 268435456)))
    (i_loadb g 0 0)))
(def e_scalar_op ((s Int) (kind Int)) Int
  (if (lt kind 10)
    (if (eq kind 7) (i_add s 0 2)
      (if (eq kind 8) (i_sub s 0 2) (i_mul s 0 2)))
    (if (lt kind 12) (e_divide s kind)
      (if (lt kind 14) (e_compare s kind)
        (if (eq kind 15) (e_read s)
          (if (eq kind 16) (i_call s 6)
            (if (eq kind 19) (i_mov s 0 249) (p_fail))))))))
(def e_primitive ((s Int) (kind Int)) Int
  (let ((arity Int (c_arity kind))
        (a Int (if (eq arity 2) (e_pop s 2 3) s))
        (b Int (if arity (e_pop a 0 1) a)))
    (e_push
      (if (eq kind 14) (e_pair b)
        (if (+ (eq kind 17) (eq kind 18)) (e_project b kind)
          (let ((c Int (if arity (i_jnz b 1 1) b))
                (d Int (if (eq arity 2) (i_jnz c 3 1) c)))
            (i_imm (e_scalar_op d kind) 1 0)))))))

(def c_let ((xs Int)) Int
  (if (eq (p_length xs) 5)
    (let ((typecheck Int (c_check (eq (c_kind (c_nth xs 2)) 2) 0))
          (binding Int (pair 3
            (p_cons (c_nth xs 1) (p_cons (c_nth xs 2)
              (p_cons (c_nth xs 3) (p_empty)))))))
      (pair (p_cons binding (p_empty)) (c_nth xs 4)))
    (if (eq (p_length xs) 3)
      (pair (c_list (c_nth xs 1)) (c_nth xs 2)) (p_fail))))
(def c_if_work ((xs Int) (env Int) (tail Int) (other Int) (done Int) (work Int)) Int
  (let ((a Int (p_cons (a_simple 5 done 0 0 0) work))
        (b Int (p_cons (a_expr (c_nth xs 3) env tail) a))
        (c Int (p_cons (a_simple 4 done other 0 0) b))
        (d Int (p_cons (a_expr (c_nth xs 2) env tail) c))
        (e Int (p_cons (a_simple 3 other 0 0 0) d)))
    (p_cons (a_expr (c_nth xs 1) env 0) e)))

(def c_expr_action ((s Int) (work Int) (functions Int) (parameters Int) (payload Int)) Int
  (let ((node Int (c_a payload)) (env Int (c_b payload))
        (tail Int (c_c payload)) (tag Int (first node)))
    (if (eq tag 1)
      (c_loop (e_push (i_imm (i_imm s 0 (second node)) 1 0)) work functions parameters)
      (if (eq tag 2)
        (c_loop (e_push (e_slot s (c_env_get env node) 0)) work functions parameters)
        (let ((xs Int (c_list node)) (op Int (c_name (p_head xs)))
              (kind Int (c_kind op)) (args Int (p_tail xs)))
          (if (eq kind 5)
            (let ((checked Int (c_check (eq (p_length args) 3) 0))
                  (other Int (+ (s_next_label s) 1)) (done Int (+ other 1)))
              (c_loop (s_new (s_new s))
                (c_if_work xs env tail other done work) functions parameters))
            (if (eq kind 6)
              (let shape Int (c_let xs)
                (c_loop s (p_cons (a_simple 6 (first shape) (second shape) env tail) work)
                  functions parameters))
              (if (c_is_primitive kind)
                (let ((checked Int (c_check (eq (p_length args) (c_arity kind)) 0))
                      (finish Int (p_cons (a_simple 1 kind 0 0 0) work)))
                  (c_loop s (a_args (p_reverse args) env finish) functions parameters))
                (let ((found Int (c_find functions op))
                      (function Int (c_check (first found) (second found)))
                      (checked Int (c_check
                        (* (eq (p_length args) (p_length (c_b function)))
                          (eq (eq kind 4) 0)) 0))
                      (finish Int (p_cons
                        (a_simple 2 (c_d function) (p_length args) tail 0) work)))
                  (c_loop s (a_args (p_reverse args) env finish) functions parameters))))))))))

(def c_bind_action ((s Int) (work Int) (functions Int) (parameters Int) (payload Int)) Int
  (let ((bindings Int (c_a payload)) (body Int (c_b payload))
        (env Int (c_c payload)) (tail Int (c_d payload)))
    (if (p_length bindings)
      (let ((binding Int (c_list (p_head bindings)))
            (shapecheck Int (c_check (eq (p_length binding) 3) 0))
            (name Int (c_name (p_head binding)))
            (typecheck Int (c_check (eq (c_kind (c_nth binding 1)) 2) 0))
            (unique Int (c_check (eq (first (c_env_find env name)) 0) 0))
            (finish Int (a_simple 7 name (p_tail bindings) body (pair env tail))))
        (c_loop s (p_cons (a_expr (c_nth binding 2) env 0)
          (p_cons finish work)) functions parameters))
      (c_loop s (p_cons (a_expr body env tail) work) functions parameters))))

(def c_loop ((s Int) (work Int) (functions Int) (parameters Int)) Int
  (if (p_length work)
    (let ((action Int (p_head work)) (tag Int (first action))
          (payload Int (second action)) (rest Int (p_tail work)))
      (if (eq tag 0) (c_expr_action s rest functions parameters payload)
        (if (eq tag 1)
          (c_loop (e_primitive s (c_a payload)) rest functions parameters)
          (if (eq tag 2)
            (c_loop (e_call s (c_a payload) (c_b payload) (c_c payload) parameters)
              rest functions parameters)
            (if (eq tag 3)
              (let a Int (i_jnz (e_pop s 0 1) 1 1)
                (c_loop (i_jz a 0 (c_a payload)) rest functions parameters))
              (if (eq tag 4)
                (c_loop (s_mark (i_jmp s (c_a payload)) (c_b payload))
                  rest functions parameters)
                (if (eq tag 5)
                  (c_loop (s_mark s (c_a payload)) rest functions parameters)
                  (if (eq tag 6) (c_bind_action s rest functions parameters payload)
                    (if (eq tag 7)
                      (let ((slot Int (s_slots s))
                            (a Int (s_local (e_slot (e_pop s 0 1) slot 1) (+ slot 1)))
                            (context Int (c_d payload))
                            (env Int (c_env_add (first context) (c_a payload) slot))
                            (next Int (a_simple 6 (c_b payload) (c_c payload)
                              env (second context))))
                        (c_loop a (p_cons next rest) functions parameters))
                      (p_fail)))))))))) s))

(def e_prologue ((s Int) (id Int) (parameters Int) (locals Int)) Int
  (let ((a Int (s_local (s_mark s id) (+ parameters 1)))
        (b Int (i_mov a 0 247)) (c Int (i_imm b 1 0))
        (d Int (i_mov c 247 246)) (e Int (e_add d 247 (* -16 parameters)))
        (f Int (e_push e)) (g Int (e_add f 246 (* 16 locals))))
    (e_bound g 246 134217728 2)))
(def e_return ((s Int) (parameters Int)) Int
  (let ((a Int (e_pop s 0 1)) (b Int (i_mov a 6 0))
        (c Int (i_mov b 7 1)) (d Int (e_slot c parameters 0))
        (e Int (i_mov d 246 247)) (f Int (i_mov e 247 0))
        (g Int (i_mov f 0 6)) (h Int (i_mov g 1 7))
        (i Int (e_add h 243 -1)))
    (i_ret i)))
(def c_functions ((s Int) (remaining Int) (functions Int)) Int
  (if (p_length remaining)
    (let ((f Int (p_head remaining)) (parameters Int (p_length (c_b f)))
          (env Int (c_params (c_b f) 0 (p_empty)))
          (locals Int (c_local_count (p_cons (c_c f) (p_empty)) 0))
          (start Int (e_prologue s (c_d f) parameters locals))
          (body Int (c_loop start (p_cons (a_expr (c_c f) env 1) (p_empty))
            functions parameters))
          (checked Int (c_check (eq (s_slots body) (+ (+ parameters 1) locals)) body)))
      (c_functions (e_return checked parameters) (p_tail remaining) functions)) s))
(def main () Int
  (let ((roots Int (p_parse))
        (functions Int (c_declarations roots 100 (p_empty)))
        (entry Int (c_main_find functions))
        (start Int (pair (pair (+ 100 (p_length functions)) 0) (pair 0 0)))
        (runtime Int (e_runtime start (c_application functions) entry))
        (compiled Int (c_functions runtime functions functions)))
    (i_layout (second compiled) 0 0 (m_empty))))
