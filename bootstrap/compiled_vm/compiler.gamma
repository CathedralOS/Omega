(def c_if_work ((xs Int) (env Int) (tail Int) (other Int) (done Int) (work Int)) Int
  (let ((a Int (p_cons (a_simple 5 done 0 0 0) work))
        (b Int (p_cons (a_expr (c_nth xs 3) env tail) a))
        (c Int (p_cons (a_simple 4 done other 0 0) b))
        (d Int (p_cons (a_expr (c_nth xs 2) env tail) c))
        (e Int (p_cons (a_simple 3 other 0 0 0) d)))
    (p_cons (a_expr (c_nth xs 1) env 0) e)))

(def c_expr_action ((s Int) (work Int) (functions Int) (parameters Int) (payload Int)) Int
  (let ((node Int (c_a payload)) (env Int (c_b payload))
        (tail Int (c_c payload)) (tag Int (first node)))
    (if (eq tag 1)
      (c_loop (e_push (e2 (e2 s 1 0 (second node)) 1 1 0)) work functions parameters)
      (if (eq tag 2)
        (c_loop (e_push (e_slot s (c_env_get env node) 0)) work functions parameters)
        (let ((xs Int (c_list node)) (op Int (c_name (p_head xs)))
              (kind Int (c_kind op)) (args Int (p_tail xs)))
          (if (eq kind 5)
            (let ((checked Int (c_check (eq (p_length args) 3) 0))
                  (other Int (+ (c_a s) 1)) (done Int (+ other 1)))
              (c_loop (s_new (s_new s))
                (c_if_work xs env tail other done work) functions parameters))
            (if (eq kind 6)
              (let shape Int (c_let xs)
                (c_loop s (p_cons (a_simple 6 (first shape) (second shape) env tail) work)
                  functions parameters))
              (if (c_is_primitive kind)
                (let ((checked Int (c_check (eq (p_length args) (c_arity kind)) 0))
                      (finish Int (p_cons (a_simple 1 kind 0 0 0) work)))
                  (c_loop s (a_args (p_reverse args) env finish) functions parameters))
                (let ((found Int (c_find functions op))
                      (function Int (c_check (first found) (second found)))
                      (checked Int (c_check
                        (* (eq (p_length args) (p_length (c_b function)))
                          (eq (eq kind 4) 0)) 0))
                      (finish Int (p_cons
                        (a_simple 2 (c_d function) (p_length args) tail 0) work)))
                  (c_loop s (a_args (p_reverse args) env finish) functions parameters))))))))))

(def c_bind_action ((s Int) (work Int) (functions Int) (parameters Int) (payload Int)) Int
  (let ((bindings Int (c_a payload)) (body Int (c_b payload))
        (env Int (c_c payload)) (tail Int (c_d payload)))
    (if (p_length bindings)
      (let ((binding Int (c_list (p_head bindings)))
            (shapecheck Int (c_check (eq (p_length binding) 3) 0))
            (name Int (c_name (p_head binding)))
            (typecheck Int (c_check (eq (c_kind (c_nth binding 1)) 2) 0))
            (unique Int (c_check (eq (first (c_env_find env name)) 0) 0))
            (finish Int (a_simple 7 name (p_tail bindings) body (pair env tail))))
        (c_loop s (p_cons (a_expr (c_nth binding 2) env 0)
          (p_cons finish work)) functions parameters))
      (c_loop s (p_cons (a_expr body env tail) work) functions parameters))))

(def c_loop ((s Int) (work Int) (functions Int) (parameters Int)) Int
  (if (p_length work)
    (let ((action Int (p_head work)) (tag Int (first action))
          (payload Int (second action)) (rest Int (p_tail work)))
      (if (eq tag 0) (c_expr_action s rest functions parameters payload)
        (if (eq tag 1)
          (c_loop (e_primitive s (c_a payload)) rest functions parameters)
          (if (eq tag 2)
            (c_loop (e_call s (c_a payload) (c_b payload) (c_c payload) parameters)
              rest functions parameters)
            (if (eq tag 3)
              (let a Int (e2 (e_pop s 0 1) 14 1 1)
                (c_loop (e2 a 13 0 (c_a payload)) rest functions parameters))
              (if (eq tag 4)
                (c_loop (s_mark (e1 s 12 (c_a payload)) (c_b payload))
                  rest functions parameters)
                (if (eq tag 5)
                  (c_loop (s_mark s (c_a payload)) rest functions parameters)
                  (if (eq tag 6) (c_bind_action s rest functions parameters payload)
                    (if (eq tag 7)
                      (let ((slot Int (c_c s))
                            (a Int (s_local (e_slot (e_pop s 0 1) slot 1) (+ slot 1)))
                            (context Int (c_d payload))
                            (env Int (c_env_add (first context) (c_a payload) slot))
                            (next Int (a_simple 6 (c_b payload) (c_c payload)
                              env (second context))))
                        (c_loop a (p_cons next rest) functions parameters))
                      (p_fail)))))))))) s))

(def e_prologue ((s Int) (id Int) (parameters Int) (locals Int)) Int
  (let ((a Int (s_local (s_mark s id) (+ parameters 1)))
        (b Int (e2 a 2 0 247)) (c Int (e2 b 1 1 0))
        (d Int (e2 c 2 247 246)) (e Int (e_add d 247 (* -16 parameters)))
        (f Int (e_push e)) (g Int (e_add f 246 (* 16 locals))))
    (e_bound g 246 134217728 2)))
(def e_return ((s Int) (parameters Int)) Int
  (let ((a Int (e_pop s 0 1)) (b Int (e2 a 2 6 0))
        (c Int (e2 b 2 7 1)) (d Int (e_slot c parameters 0))
        (e Int (e2 d 2 246 247)) (f Int (e2 e 2 247 0))
        (g Int (e2 f 2 0 6)) (h Int (e2 g 2 1 7))
        (i Int (e_add h 243 -1)))
    (e0 i 20)))
(def c_functions ((s Int) (remaining Int) (functions Int)) Int
  (if (p_length remaining)
    (let ((f Int (p_head remaining)) (parameters Int (p_length (c_b f)))
          (env Int (c_params (c_b f) 0 (p_empty)))
          (locals Int (c_local_count (p_cons (c_c f) (p_empty)) 0))
          (start Int (e_prologue s (c_d f) parameters locals))
          (body Int (c_loop start (p_cons (a_expr (c_c f) env 1) (p_empty))
            functions parameters))
          (checked Int (c_check (eq (c_c body) (+ (+ parameters 1) locals)) body)))
      (c_functions (e_return checked parameters) (p_tail remaining) functions)) s))
(def main () Int
  (let ((roots Int (p_parse))
        (functions Int (c_declarations roots 100 (p_empty)))
        (entry Int (c_main_find functions))
        (start Int (c_record (+ 100 (p_length functions)) 0 0 (p_empty)))
        (runtime Int (e_runtime start (c_application functions) entry))
        (compiled Int (c_functions runtime functions functions))
        (capacity Int (c_check (lt (c_b compiled) 16777213) 0))
        (instructions Int (p_reverse (c_d compiled)))
        (labels Int (i_labels instructions 0 (m_empty))))
    (i_output instructions labels)))
