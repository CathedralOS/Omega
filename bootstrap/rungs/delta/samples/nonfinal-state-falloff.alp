// A terminal method state returns immediately even when a later state is
// declared lexically.  Native backends must agree with canonical Gamma here.
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    result: i32;
}

machine Main::choose(&mut self) {
    transition 1 < 2 { true -> success() false -> failure() }
    state success() { self.result = 42; }
    state failure() { self.result = 251; }
}

machine Main::main(&mut self) {
    self.choose();
    self.console.exit_process(self.result);
}
