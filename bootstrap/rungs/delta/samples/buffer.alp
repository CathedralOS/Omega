// Slice 8b: [u8;N] byte buffers (1-byte element addressing). Reads all of stdin
// into a byte buffer held in self, then writes it back reversed — so the buffer
// is demonstrably real (output != input). This is the storage shape the
// self-hosting compiler uses to hold its source text.
//   alpha buffer.alp rev.exe && printf 'abcde' | ./rev.exe   ->  edcba
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 4096];
    n: i32; // bytes read
    i: i32; // cursor
    c: i32; // current byte
}

machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> read() }

    state read() {
        self.c = read_byte();
        transition self.c < 0 {
            true  -> setup() // EOF
            false -> store()
        }
    }
    state store() {
        self.buf[self.n] = self.c;
        self.n = self.n + 1;
        transition 0 { _ -> read() }
    }
    state setup() {
        self.i = self.n - 1;
        transition 0 { _ -> write() }
    }
    state write() {
        transition self.i < 0 {
            true  -> done()
            false -> emit()
        }
    }
    state emit() {
        write_byte(self.buf[self.i]);
        self.i = self.i - 1;
        transition 0 { _ -> write() }
    }
    state done() {
        self.console.exit_process(0)
    }
}
