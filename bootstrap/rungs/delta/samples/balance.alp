// A bracket-balance checker for .alp source, written in delta — a structural
// validator (the kind a compiler runs before/while parsing). Reads stdin and exits
// 0 if every {, (, [ is matched by the right closer in the right order, else 1.
// Correctly ignores brackets inside // line comments and "..." string literals.
// Uses a typed stack: each opener pushes its EXPECTED closer; each closer must pop
// that exact byte.
//   printf 'machine f(){ a[0]=1; }' | balance ; echo $?   -> 0
//   printf 'f( ]'                    | balance ; echo $?   -> 1
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 512]; n: i32; pos: i32; c: i32;
    stk: [u8; 256]; sp: i32;
}
machine Main::main(&mut self) {
    self.n = 0; self.sp = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }

    state scan()  { self.pos = 0; transition 0 { _ -> loop() } }
    state loop()  { transition self.pos < self.n { true -> disp()  false -> done() } }
    state disp() {
        self.c = self.buf[self.pos];
        transition self.c == 47 { true -> maybecomm()  false -> notslash() }   // '/'
    }
    state maybecomm() { transition self.buf[self.pos + 1] == 47 { true -> skipcomm()  false -> adv() } }
    state notslash()  { transition self.c == 34 { true -> skipstr()  false -> brk() } }   // '"'
    // opener? push the matching closer.
    state brk()    { transition self.c == 123 { true -> pcb()  false -> b1() } }   // '{'
    state b1()     { transition self.c == 40  { true -> prp()  false -> b2() } }   // '('
    state b2()     { transition self.c == 91  { true -> psb()  false -> b3() } }   // '['
    state b3()     { transition self.c == 125 { true -> ecb()  false -> b4() } }   // '}'
    state b4()     { transition self.c == 41  { true -> erp()  false -> b5() } }   // ')'
    state b5()     { transition self.c == 93  { true -> esb()  false -> adv() } }  // ']'
    state pcb()    { self.stk[self.sp] = 125; self.sp = self.sp + 1; transition 0 { _ -> adv() } }
    state prp()    { self.stk[self.sp] = 41;  self.sp = self.sp + 1; transition 0 { _ -> adv() } }
    state psb()    { self.stk[self.sp] = 93;  self.sp = self.sp + 1; transition 0 { _ -> adv() } }
    // closer? must pop the matching expected closer.
    state ecb()    { transition self.sp == 0 { true -> bad()  false -> ecb2() } }
    state ecb2()   { self.sp = self.sp - 1; transition self.stk[self.sp] == 125 { true -> adv()  false -> bad() } }
    state erp()    { transition self.sp == 0 { true -> bad()  false -> erp2() } }
    state erp2()   { self.sp = self.sp - 1; transition self.stk[self.sp] == 41  { true -> adv()  false -> bad() } }
    state esb()    { transition self.sp == 0 { true -> bad()  false -> esb2() } }
    state esb2()   { self.sp = self.sp - 1; transition self.stk[self.sp] == 93  { true -> adv()  false -> bad() } }

    state adv()    { self.pos = self.pos + 1; transition 0 { _ -> loop() } }
    // skip a // comment to end of line
    state skipcomm() { transition self.pos < self.n { true -> sc2()  false -> done() } }
    state sc2()      { transition self.buf[self.pos] == 10 { true -> adv()  false -> sca() } }
    state sca()      { self.pos = self.pos + 1; transition 0 { _ -> skipcomm() } }
    // skip a "..." string (past the opening quote, to the closing quote)
    state skipstr()  { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state ss()       { transition self.pos < self.n { true -> ss2()  false -> done() } }
    state ss2()      { transition self.buf[self.pos] == 34 { true -> adv()  false -> ssa() } }
    state ssa()      { self.pos = self.pos + 1; transition 0 { _ -> ss() } }

    state done()   { transition self.sp == 0 { true -> ok()  false -> bad() } }
    state ok()     { self.console.exit_process(0) }
    state bad()    { self.console.exit_process(1) }
}
