// DELTA FEATURE: nested data field access (self.a.b) — the real Omega bounded_counter shape, where a
// machine owns a nested struct and reads/writes its fields directly. Nested data is INLINED in the parent
// layout, so self.counter.value resolves to a flat byte offset (offset(counter) + offset(value)); it reuses
// the existing scalar read (SelfField) and write (StoreSelfField) codegen — only the path resolver is new.
//   nested  ->  exit 42
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Counter {
    value: i32;
}

data Main {
    console: Console;
    counter: Counter;
}

machine Main::main(&mut self) {
    self.counter.value = 0;
    self.counter.value = self.counter.value + 21;   // nested read (RHS) + nested write (LHS)
    self.counter.value = self.counter.value + 21;
    transition self.counter.value == 42 {           // nested read in a transition subject
        true -> ok()
        false -> bad()
    }

    state ok() { self.console.exit_process(42) }
    state bad() { self.console.exit_process(7) }
}
