; NESTED BRANCHES: max(a, max(b, c)) via two if-diamonds — forks nest naturally ((k 9 .. (k 9 ..) ..)),
; capped at depth 8. The false path resumes MID-BLOCK after the guard statement.
proc main() {
    let a = read_byte()
    let b = read_byte()
    let c = read_byte()
    let r = a
    state s0 { to t1 when (a < b)  to done }
    state t1 { r = b  to t2 }
    state t2 { to t3 when (b < c)  to done }
    state t3 { r = c  to done }
    state done { return r }
}
