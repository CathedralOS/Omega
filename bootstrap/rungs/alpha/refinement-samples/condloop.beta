; CONDITIONAL DELTA: an if-diamond INSIDE a summarized loop body. The body run FORKS both paths to the
; header and merges post-states pointwise — a slot differing across paths becomes (cond b vT vF) — so the
; per-iteration delta is the conditional (k 9 [a<b] 2 1), loop-INVARIANT here, and the closed form is
; n · cond(a<b, 2, 1). A guard on the accumulator ITSELF (total < 3) refuses: its marker appears in the
; condition, the slot poisons, and the post-loop read refuses — on both engines (the alpha fast path defers
; to the marker path whenever a body run crosses any data branch, so short-horizon uniformity can't fool it).
proc main() {
    let n = read_byte()
    let a = read_byte()
    let b = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { to add when (a < b)  to skip }
    state add { total = (total + 2)  to next }
    state skip { total = (total + 1)  to next }
    state next { i = (i + 1)  to loop }
    state done { return total }
}
