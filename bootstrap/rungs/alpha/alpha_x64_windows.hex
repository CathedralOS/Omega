iat_gsh: .rva n_gsh 00 00 00 00
iat_rf:  .rva n_rf  00 00 00 00
iat_wf:  .rva n_wf  00 00 00 00
z8
n_gsh:
00 00 47 65 74 53 74 64 48 61 6E 64 6C 65 00 00
n_rf:
00 00 52 65 61 64 46 69 6C 65 00 00
n_wf:
00 00 57 72 69 74 65 46 69 6C 65 00
dllname:
6B 65 72 6E 65 6C 33 32 2E 64 6C 6C 00 00
.pad 0x1400

; ===================== .tape (RVA 0x4004000, file 0x1400) =====================
; The hole: 0x40000 (256 KiB) zero bytes. A built program is this exe with [4-byte LE
; length][tape bytes] memcpy'd in here at file offset 0x1400.
.pad 0x41400
