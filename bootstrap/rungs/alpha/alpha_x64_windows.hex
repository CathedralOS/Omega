C3

; --- getbyte: rax = next stdin byte, or -1 at EOF (self-aligning frame) ---
getbyte:
48 83 EC 28
48 B8 80 30 00 40 01 00 00 00   ; &stdin_h
48 8B 08
48 BA 90 30 00 40 01 00 00 00   ; &io_byte
41 B8 01 00 00 00
49 B9 98 30 00 40 01 00 00 00   ; &count
48 C7 44 24 20 00 00 00 00
FF 15 .rel32 iat_rf
48 B8 98 30 00 40 01 00 00 00   ; &count
48 8B 00
48 85 C0
74 .rel8 gb_eof
48 B8 90 30 00 40 01 00 00 00   ; &io_byte
0F B6 00
48 83 C4 28
C3
gb_eof:
48 C7 C0 FF FF FF FF            ; rax = -1
48 83 C4 28
C3

; --- putbyte: write al to stdout (self-aligning frame) ---
putbyte:
48 83 EC 28
48 BA 90 30 00 40 01 00 00 00   ; &io_byte
88 02                           ; mov [io_byte], al
48 B8 88 30 00 40 01 00 00 00   ; &stdout_h
48 8B 08
48 BA 90 30 00 40 01 00 00 00   ; &io_byte
41 B8 01 00 00 00
49 B9 98 30 00 40 01 00 00 00   ; &count
48 C7 44 24 20 00 00 00 00
FF 15 .rel32 iat_wf
48 83 C4 28
C3
.pad 0x1200

; ===================== .rdata (RVA 0x2000, file 0x1200) =====================
idt:
.rva ilt
00 00 00 00
00 00 00 00
.rva dllname
.rva iat
z20
