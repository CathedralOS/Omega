; ===========================================================================
; Hand-assembled Alpha tape VM — Windows x64 PE.  Every instruction byte is
; hand-authored; the historical forge resolved label arithmetic. The committed
; binary is audited directly against this listing.
;
; The VM carries the program INSIDE itself: a .tape section is a big hole of zeros
; (the "binary from god" + a memcpy'd program). On startup the VM copies the embedded
; tape into VM memory and runs it; stdin/stdout are then purely the program's own I/O.
; To "build" a program you copy this exe and memcpy the program's bytes into the hole
; (4-byte LE length, then the bytes), up to the hole's size.
; getbyte/putbyte are self-aligning native subroutines wrapping ReadFile/WriteFile.
;   rsi=pc ptr  rdi=mem base (0x140004000)  rbx=&vregs (0x140003000)  r12=sp
;   scratch (vregs page): stdin_h 3080, stdout_h 3088, io_byte 3090, count 3098.
;   Sections: .text 0x1000, .rdata 0x2000 (imports), .data 0x3000, .tape 0x4004000.
; ===========================================================================

; --- DOS header ---
4D 5A z58
40 00 00 00

; --- PE signature + COFF ---
50 45 00 00
64 86
04 00
00 00 00 00
00 00 00 00
00 00 00 00
F0 00
22 00

; --- Optional header (PE32+) ---
0B 02
00 00
00 10 00 00              ; SizeOfCode
00 02 00 00              ; SizeOfInitializedData (.rdata)
00 10 00 04              ; SizeOfUninitializedData (.data)
00 10 00 00              ; AddressOfEntryPoint
00 10 00 00              ; BaseOfCode
00 00 00 40 01 00 00 00  ; ImageBase
00 10 00 00
00 02 00 00
06 00 00 00
00 00 00 00
06 00 00 00
00 00 00 00
00 40 04 04              ; SizeOfImage = 0x4044000 (covers the .tape hole)
00 02 00 00              ; SizeOfHeaders
00 00 00 00
03 00
00 00
00 00 10 00 00 00 00 00
00 10 00 00 00 00 00 00
00 00 10 00 00 00 00 00
00 10 00 00 00 00 00 00
00 00 00 00
10 00 00 00
00 00 00 00 00 00 00 00          ; dir[0]
.rva idt 28 00 00 00             ; dir[1] import
z80
.rva iat 20 00 00 00             ; dir[12] IAT
z24

; --- section headers ---
2E 74 65 78 74 00 00 00
00 10 00 00
00 10 00 00
00 10 00 00
00 02 00 00
00 00 00 00 00 00 00 00
00 00 00 00
20 00 00 60
2E 72 64 61 74 61 00 00
00 02 00 00
00 20 00 00
00 02 00 00
00 12 00 00
00 00 00 00 00 00 00 00
00 00 00 00
40 00 00 40
2E 64 61 74 61 00 00 00
00 10 00 04
00 30 00 00
00 00 00 00
00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00
80 00 00 C0
2E 74 61 70 65 00 00 00          ; .tape — the embedded-program hole
00 00 04 00                      ; VirtualSize  0x40000 (256 KiB)
00 40 00 04                      ; VirtualAddress 0x4004000
00 00 04 00                      ; SizeOfRawData 0x40000
00 14 00 00                      ; PointerToRawData 0x1400
00 00 00 00 00 00 00 00
00 00 00 00
40 00 00 40                      ; initialized data, read
.pad 0x200

; ===================== .text (RVA 0x1000) =====================
48 83 EC 28                     ; sub rsp, 0x28
48 BB 00 30 00 40 01 00 00 00   ; mov rbx, &vregs
48 BF 00 40 00 40 01 00 00 00   ; mov rdi, mem base
49 BC 00 00 00 04 00 00 00 00   ; mov r12, sp (64MB)
; stdin_h / stdout_h
B9 F6 FF FF FF
FF 15 .rel32 iat_gsh
48 B9 80 30 00 40 01 00 00 00
48 89 01
B9 F5 FF FF FF
FF 15 .rel32 iat_gsh
48 B9 88 30 00 40 01 00 00 00
48 89 01
; --- loader: copy the embedded tape (the .tape hole) into VM memory ---
48 B8 00 40 00 44 01 00 00 00   ; rax = &.tape  (ImageBase + 0x4004000)
44 8B 30                        ; mov r14d, [rax]   (tape length, 4-byte LE)
48 83 C0 04                     ; add rax, 4        (rax -> first tape byte)
4D 31 FF                        ; xor r15, r15      (i = 0)
load_loop:
4D 85 F6                        ; test r14, r14
74 .rel8 load_done
0F B6 08                        ; movzx ecx, byte [rax]
48 89 FA                        ; mov rdx, rdi
4C 01 FA                        ; add rdx, r15
88 0A                           ; mov [rdx], cl
48 FF C0                        ; inc rax
49 FF C7                        ; inc r15
49 FF CE                        ; dec r14
EB .rel8 load_loop
load_done:
48 89 FE                        ; rsi = rdi (pc = 0)

; --- fetch + dispatch ---
next:
0F B6 06
48 FF C6
83 F8 00  0F 84 .rel32 h_halt
83 F8 01  0F 84 .rel32 h_imm
83 F8 02  0F 84 .rel32 h_mov
83 F8 03  0F 84 .rel32 h_add
83 F8 04  0F 84 .rel32 h_sub
83 F8 05  0F 84 .rel32 h_mul
83 F8 06  0F 84 .rel32 h_div
83 F8 07  0F 84 .rel32 h_mod
83 F8 08  0F 84 .rel32 h_loadb
83 F8 09  0F 84 .rel32 h_storeb
83 F8 0A  0F 84 .rel32 h_load
83 F8 0B  0F 84 .rel32 h_store
83 F8 0C  0F 84 .rel32 h_jmp
83 F8 0D  0F 84 .rel32 h_jz
83 F8 0E  0F 84 .rel32 h_jnz
83 F8 0F  0F 84 .rel32 h_jlt
83 F8 10  0F 84 .rel32 h_jeq
83 F8 11  0F 84 .rel32 h_read
83 F8 12  0F 84 .rel32 h_write
83 F8 13  0F 84 .rel32 h_call
83 F8 14  0F 84 .rel32 h_ret
0F 0B

