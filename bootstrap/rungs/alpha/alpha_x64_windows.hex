48 FF C6
0F B6 16
48 FF C6
48 8B 04 CB
48 3B 04 D3
0F 84 .rel32 do_jump
E9 .rel32 skip_addr
h_read:
48 FF C6                        ; inc rsi (consume rD; rD now at rsi-1)
E8 .rel32 getbyte               ; rax = byte or -1
0F B6 4E FF                     ; movzx ecx, byte [rsi-1]
48 89 04 CB
E9 .rel32 next
