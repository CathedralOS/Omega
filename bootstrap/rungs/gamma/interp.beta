; interp.beta — a Gamma REFERENCE INTERPRETER, written in Beta.  (stages 1+2)
;
; The lattice wants Gamma defined interpreter-first (rungs/gamma.md): "a gamma
; program means what a gamma reference interpreter written in beta does with it",
; with any compiler demoted to an acceleration checked against this. This is that
; interpreter — the meaning, not a compiler.
;
; Stage 1: the pure functional, FUEL-bounded core — integer values, top-level
; recursive functions, `if`, `let`, arithmetic and comparisons. Stage 2: the
; gamma-DEFINING features — algebraic data types (constructors) and pattern matching.
;
; Surface (prefix s-expressions; `;` comments; Uppercase head = constructor):
;   program := (def NAME (PARAM...) EXPR)*  EXPR        ; defs, then the goal expr
;   EXPR    := INT | VAR | (if E E E) | (let NAME E E)
;            | (+ E E) | (- E E) | (* E E) | (/ E E) | (% E E) | (eq E E) | (lt E E)
;            | (fn E...) | Con | (Con E...) | (match E (PAT E)...)
;   PAT     := var | Con | (Con var...)
; The final EXPR is evaluated; the integer value is the process exit code.
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is a set of `state` basic blocks linked
; by guarded `to … when …` transitions — no if/while. A proc falls into its first
; state and into the next unless it transitions or returns; a loop is a state that
; transitions back to itself.
;
; Memory:  2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  2097120 NFUNC
;          2097112 ENVN 2097104 FRAMEBASE   16777216 ARENA (~48 MB)   4194304 FUNCS   5242880 ENV
;          12582912 SMALL_INTS (-1..65535, one stable VINT each; ends just above 14 MB)
; AST/value nodes are 4 words [tag,f0,f1,f2] (32-byte stride). Func entries 3 words
; [name_off, paramlist, body]. Env entries 2 words [name_off, value]; -1 = unnamed arg.
;
; AST tags:   0 INT(v) 1 VAR(off) 2 PRIM(op,a,b) 3 IF(c,t,e) 4 LET(off,e,body)
;             5 CALL(foff,args) 6 CONS(head,tail) 7 CONAPP(con_off,args)
;             8 MATCH(scrut,arms) 9 PVAR(off) 10 PCON(con_off,varlist) 11 ARM(pat,body)
; value tags: 100 VINT(n)  101 VCON(con_off, value-arglist)
;             102 VCONS(con_off, head, tail) — compact internal form of `(Cons h t)`
;             103 VTAIL(function_off, evaluated-value-list) — evaluator-private trampoline request

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop {
        to body when (c >= 0)
        to done
    }
    state body {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n        ; LEN
        word[2097144] = 0        ; CUR
        word[2097128] = 16777216 ; APTR — arena base at 16 MB: ~48 MB of node space up to the VM's 64 MB.
                                 ;   (The old base 3145728 gave only 1 MB before FUNCS at 4194304; a big
                                 ;   eval — e.g. a whole certifier run — silently overflowed into the
                                 ;   function table and corrupted the result. There is no arena free/GC,
                                 ;   so capacity IS the ceiling. ENV at 5 MB has ~7 MB before SMALL_INTS.)
        word[2097120] = 0        ; NFUNC
        word[2097112] = 0        ; ENVN
        word[2097104] = 0        ; FRAMEBASE
    }
}

proc cbyte() {
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc skip_ws() {
    let go = 1
    state loop {
        to done when (go == 0)
        let c = cbyte()
        to sp when (is_space(c) == 1)
        to semi
    }
    state sp { adv()  to loop }
    state semi {
        to cmt when (c == ';')
        go = 0
        to loop
    }
    state cmt {
        to loop when (cbyte() == 10)     ; comment ends at newline -> outer loop
        to ceof when (cbyte() == 0)
        adv()
        to cmt
    }
    state ceof { return 0 }
    state done { return 0 }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_delim(c) {
    state c1 { to yes when (is_space(c) == 1)  to c2 }
    state c2 { to yes when (c == '(')  to c3 }
    state c3 { to yes when (c == ')')  to c4 }
    state c4 { to yes when (c == 0)    return 0 }
    state yes { return 1 }
}

proc is_op(c) {
    state c1 { to yes when (c == '+')  to c2 }
    state c2 { to yes when (c == '-')  to c3 }
    state c3 { to yes when (c == '*')  to c4 }
    state c4 { to yes when (c == '/')  to c5 }
    state c5 { to yes when (c == '%')  return 0 }
    state yes { return 1 }
}

proc skip_ident() {
    state loop {
        to body when (is_delim(cbyte()) == 0)
        return 0
    }
    state body { adv()  to loop }
}

proc parse_number() {
    let v = 0
    state loop {
        to body when (is_digit(cbyte()) == 1)
        return v
    }
    state body {
        v = v * 10 + (cbyte() - '0')
        adv()
        to loop
    }
}

proc alloc(tag, f0, f1, f2) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[p + 24] = f2
    word[2097128] = p + 32
    return p
}

; do the names at SRC offsets o1 and o2 (each ending at a delimiter) match?
proc name_eq(o1, o2) {
    let i = 0
    state loop {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        to end1 when (is_delim(c1) == 1)
        to end2 when (is_delim(c2) == 1)    ; c1 not delim but c2 is -> mismatch
        to diff when (c1 != c2)
        i = i + 1
        to loop
    }
    state end1 { return is_delim(c2) }       ; both delim here -> equal (1); else 0
    state end2 { return 0 }
    state diff { return 0 }
}

proc name_is2(off, a, b) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to yes when (is_delim(byte[2097152 + off + 2]) == 1)  return 0 }
    state yes { return 1 }
}

proc name_is3(off, a, b, c) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == c)  return 0 }
    state c4 { to yes when (is_delim(byte[2097152 + off + 3]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_match_kw(off) {          ; the 5-char keyword "match"
    state c1 { to c2 when (byte[2097152 + off] == 'm')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 't')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 'c')  return 0 }
    state c5 { to c6 when (byte[2097152 + off + 4] == 'h')  return 0 }
    state c6 { to yes when (is_delim(byte[2097152 + off + 5]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_cons_name(off) {         ; the 4-char constructor name "Cons"
    state c1 { to c2 when (byte[2097152 + off] == 'C')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'o')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 'n')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 's')  return 0 }
    state c5 { to yes when (is_delim(byte[2097152 + off + 4]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_upper(c) {               ; capitalized head => a constructor (ADT value)
    state c1 { to no when (c < 'A')  to c2 }
    state c2 { to no when (c > 'Z')  return 1 }
    state no { return 0 }
}

; ---- boxed values: VINT(100,n), VCON(101, con_off, arglist of value-ptrs),
;      VCONS(102, con_off, head, tail). VCONS is representation-only: matching
;      and printing remain exactly those of the ordinary two-argument `Cons` ADT. ----
proc mk_int(n) {
    ; Compiler/interpreter workloads repeatedly recreate loop indices, bytes,
    ; booleans, and bounded offsets. Intern that dense range outside the arena:
    ; it preserves the boxed-value ABI and exact integer semantics while keeping
    ; millions of short-lived VINTs from consuming the no-GC evaluation arena.
    state low { to allocated when (n < 0 - 1)  to high }
    state high { to allocated when (n > 65535)  to interned }
    state interned {
        let p = 12582912 + (n + 1) * 32
        word[p] = 100
        word[p + 8] = n
        word[p + 16] = 0
        word[p + 24] = 0
        return p
    }
    state allocated { return alloc(100, n, 0, 0) }
}

proc get_int(v) {                ; the integer of a VINT (0 for a constructor)
    state chk { to vint when (word[v] == 100)  return 0 }
    state vint { return word[v + 8] }
}

; ---- parser ----

proc parse_args() {              ; exprs until ')', as a CONS list
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let h = parse_expr()
        let t = parse_args()
        return alloc(6, h, t, 0)
    }
}

proc parse_params() {            ; param NAMES until ')', as a CONS of name-offsets
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let poff = word[2097144]
        skip_ident()
        let t = parse_params()
        return alloc(6, poff, t, 0)
    }
}

proc parse_expr() {
    skip_ws()
    let c = cbyte()
    state num { to do_num when (is_digit(c) == 1)  to lparen }
    state do_num { return alloc(0, parse_number(), 0, 0) }
    state lparen { to compound when (c == '(')  to atom }
    state compound {
        adv()
        skip_ws()
        let h = cbyte()
        to do_op when (is_op(h) == 1)
        to head
    }
    state do_op {
        adv()
        let a = parse_expr()
        let b = parse_expr()
        skip_ws()
        adv()
        return alloc(2, h, a, b)
    }
    state head {
        let hoff = word[2097144]
        skip_ident()
        to do_if when (name_is2(hoff, 'i', 'f') == 1)
        to k_let
    }
    state do_if {
        let c1 = parse_expr()
        let t1 = parse_expr()
        let e1 = parse_expr()
        skip_ws()
        adv()
        return alloc(3, c1, t1, e1)
    }
    state k_let { to do_let when (name_is3(hoff, 'l', 'e', 't') == 1)  to k_eq }
    state do_let {
        skip_ws()
        let noff = word[2097144]
        skip_ident()
        let e2 = parse_expr()
        let body = parse_expr()
        skip_ws()
        adv()
        return alloc(4, noff, e2, body)
    }
    state k_eq { to do_eq when (name_is2(hoff, 'e', 'q') == 1)  to k_lt }
    state do_eq {
        let a2 = parse_expr()
        let b2 = parse_expr()
        skip_ws()
        adv()
        return alloc(2, 'e', a2, b2)
    }
    state k_lt { to do_lt when (name_is2(hoff, 'l', 't') == 1)  to k_match }
    state do_lt {
        let a3 = parse_expr()
        let b3 = parse_expr()
        skip_ws()
        adv()
        return alloc(2, 'l', a3, b3)
    }
    state k_match { to do_match when (is_match_kw(hoff) == 1)  to k_con }
    state do_match {                         ; (match E (pat body)...)
        let scrut = parse_expr()
        let arms = parse_arms()
        skip_ws()
        adv()
        return alloc(8, scrut, arms, 0)
    }
    state k_con { to do_con when (is_upper(byte[2097152 + hoff]) == 1)  to do_call }
    state do_con {                           ; (Con args...) constructor
        let cargs = parse_args()
        skip_ws()
        adv()
        return alloc(7, hoff, cargs, 0)
    }
    state do_call {                          ; (fn args...) call
        let args = parse_args()
        skip_ws()
        adv()
        return alloc(5, hoff, args, 0)
    }
    state atom {
        let voff = word[2097144]
        skip_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        return alloc(1, voff, 0, 0)          ; variable
    }
    state nullcon { return alloc(7, voff, 0, 0) }   ; bare Uppercase => nullary constructor
}

proc parse_pvars() {             ; pattern variable NAMES until ')', a CONS of offsets
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let voff = word[2097144]
        skip_ident()
        let t = parse_pvars()
        return alloc(6, voff, t, 0)
    }
}

proc parse_pat() {               ; (Con v0 v1...) | var
    skip_ws()
    state chk { to pcon when (cbyte() == '(')  to atom }
    state pcon {
        adv()
        skip_ws()
        let coff = word[2097144]
        skip_ident()
        let vars = parse_pvars()
        skip_ws()
        adv()                    ; ')'
        return alloc(10, coff, vars, 0)      ; PCON
    }
    state atom {
        let voff = word[2097144]
        skip_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        return alloc(9, voff, 0, 0)          ; PVAR (binds anything)
    }
    state nullcon { return alloc(10, voff, 0, 0) }   ; nullary constructor pattern (Nil, Z)
}

proc parse_arms() {              ; (pat body) pairs until ')', a CONS of ARM nodes
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        adv()                    ; '('
        let pat = parse_pat()
        let body = parse_expr()
        skip_ws()
        adv()                    ; ')'
        let t = parse_arms()
        return alloc(6, alloc(11, pat, body, 0), t, 0)
    }
}

proc parse_def() {               ; (def NAME (PARAMS) BODY) -> add to the func table
    adv()                        ; '('
    skip_ws()
    skip_ident()                 ; "def"
    skip_ws()
    let noff = word[2097144]
    skip_ident()
    skip_ws()
    adv()                        ; '('
    let params = parse_params()
    skip_ws()
    adv()                        ; ')'
    let body = parse_expr()
    skip_ws()
    adv()                        ; ')'
    let i = word[2097120]
    word[4194304 + i * 24] = noff
    word[4194304 + i * 24 + 8] = params
    word[4194304 + i * 24 + 16] = body
    word[2097120] = i + 1
    return 0
}

proc is_def() {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let r = name_is3(word[2097144], 'd', 'e', 'f')
        word[2097144] = save
        return r
    }
}

proc func_lookup(noff) {
    let n = word[2097120]
    let i = 0
    state loop {
        to done when (i < n)
        return 0 - 1
    }
    state done {
        to hit when (name_eq(noff, word[4194304 + i * 24]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; ---- environment (named bindings; lookup is frame-local) ----

proc env_push(off, val) {
    let n = word[2097112]
    word[5242880 + n * 16] = off
    word[5242880 + n * 16 + 8] = val
    word[2097112] = n + 1
}

proc env_lookup(qoff) {
    let j = word[2097112] - 1
    let base = word[2097104]
    let result = 0
    state loop {
        to miss when (j < base)
        let boff = word[5242880 + j * 16]
        to named when (boff >= 0)
        to next
    }
    state named {
        to hit when (name_eq(qoff, boff) == 1)
        to next
    }
    state hit {
        result = word[5242880 + j * 16 + 8]
        to miss
    }
    state next { j = j - 1  to loop }
    state miss { return result }
}

; ---- evaluator (fuel-bounded) ----

proc eval_args(args, fuel) {         ; AST arg-CONS -> value-CONS (evaluated)
    state chk { to more when (args != 0)  return 0 }
    state more {
        let h = eval(word[args + 8], fuel)
        let t = eval_args(word[args + 16], fuel)
        return alloc(6, h, t, 0)
    }
}

; Evaluate call arguments left-to-right into a private list. Ordinary calls bind
; directly from their source argument spine; the value list is needed only when
; a tail call discards its caller frame before installing the callee frame.
proc eval_value_args(args, fuel) {
    state chk { to more when (args != 0)  return 0 }
    state more {
        let h = eval(word[args + 8], fuel)
        let t = eval_value_args(word[args + 16], fuel)
        return alloc(6, h, t, 0)
    }
}

proc bind_value_args(fi, values) {
    let p = word[4194304 + fi * 24 + 8]
    let a = values
    state loop {
        to body when (p != 0)
        return 0
    }
    state body {
        env_push(word[p + 8], word[a + 8])
        p = word[p + 16]
        a = word[a + 16]
        to loop
    }
}

; Select a match arm for tail evaluation. Successful pattern bindings deliberately
; stay in the current frame; eval_call discards the whole frame when the tail chain
; finishes or transfers to another function.
proc tail_match_body(scrut, arms, fuel) {
    let sv = eval(scrut, fuel)
    let arm = arms
    state loop {
        to body when (arm != 0)
        return 0
    }
    state body {
        let armnode = word[arm + 8]
        let savedepth = word[2097112]
        to matched when (try_match(word[armnode + 8], sv) == 1)
        word[2097112] = savedepth
        arm = word[arm + 16]
        to loop
    }
    state matched { return word[armnode + 16] }
}

; Reduce tail-position control iteratively. This is the evaluator's proper tail-call
; boundary: generated Gamma state machines and ordinary functional loops no longer
; consume one Beta/Alpha return frame per logical iteration.
proc eval_tail(expr, fuel) {
    state loop {
        to exhausted when (fuel <= 0)
        let tag = word[expr]
        to tail_let when (tag == 4)
        to tail_if when (tag == 3)
        to tail_call when (tag == 5)
        to tail_match when (tag == 8)
        return eval(expr, fuel)
    }
    state exhausted { return mk_int(0) }
    state tail_let {
        let lv = eval(word[expr + 16], fuel)
        env_push(word[expr + 8], lv)
        expr = word[expr + 24]
        to loop
    }
    state tail_if {
        to tail_then when (get_int(eval(word[expr + 8], fuel)) != 0)
        expr = word[expr + 24]
        to loop
    }
    state tail_then {
        expr = word[expr + 16]
        to loop
    }
    state tail_match {
        let chosen = tail_match_body(word[expr + 8], word[expr + 16], fuel)
        to tail_no_match when (chosen == 0)
        expr = chosen
        to loop
    }
    state tail_no_match { return mk_int(0) }
    state tail_call {
        let values = eval_value_args(word[expr + 16], fuel)
        return alloc(103, word[expr + 8], values, 0)
    }
}

proc eval_call(foff, args, fuel) {
    let base = word[2097112]         ; env depth before args
    let savebase = word[2097104]
    let values = eval_value_args(args, fuel)
    let fi = func_lookup(foff)
    state install {
        word[2097112] = base
        word[2097104] = base
        bind_value_args(fi, values)
        to body
    }
    state body {
        let r = eval_tail(word[4194304 + fi * 24 + 16], fuel - 1)
        to tail when (word[r] == 103)
        word[2097112] = base
        word[2097104] = savebase
        return r
    }
    state tail {
        foff = word[r + 8]
        values = word[r + 16]
        fi = func_lookup(foff)
        fuel = fuel - 1
        to install
    }
}

proc eval_conapp(con, args, fuel) {
    state cons_name {
        to cons_arity when (is_cons_name(con) == 1)
        to generic
    }
    state cons_arity {
        to generic when (args == 0)
        let rest = word[args + 16]
        to generic when (rest == 0)
        to generic when (word[rest + 16] != 0)
        to compact
    }
    state compact {
        ; Preserve source argument evaluation order while avoiding the two
        ; value-arglist nodes of the generic constructor representation.
        let h = eval(word[args + 8], fuel)
        let t = eval(word[rest + 8], fuel)
        return alloc(102, con, h, t)
    }
    state generic {
        return alloc(101, con, eval_args(args, fuel), 0)
    }
}

proc try_match_compact_cons(pat, val) {
    state namechk {
        to no when (name_eq(word[pat + 8], word[val + 8]) == 0)
        let pv = word[pat + 16]
        to done when (pv == 0)
        env_push(word[pv + 8], word[val + 16])
        pv = word[pv + 16]
        to done when (pv == 0)
        env_push(word[pv + 8], word[val + 24])
        to done
    }
    state no { return 0 }
    state done { return 1 }
}

; try to match pattern `pat` against value `val`; on success push its bindings.
proc try_match(pat, val) {
    state isvar { to pvar when (word[pat] == 9)  to iscon }
    state pvar {                     ; PVAR — binds anything to the whole value
        env_push(word[pat + 8], val)
        return 1
    }
    state iscon {
        to compact_cons when (word[val] == 102)
        to no when (word[val] != 101)        ; PCON needs a constructor value
        to namechk
    }
    state compact_cons { return try_match_compact_cons(pat, val) }
    state no { return 0 }
    state namechk {
        to no when (name_eq(word[pat + 8], word[val + 8]) == 0)   ; constructor must match
        to bind
    }
    state bind {
        let pv = word[pat + 16]      ; pattern var offsets
        let av = word[val + 16]      ; constructor arg values
        to bindloop
    }
    state bindloop {
        to bindbody when (pv != 0)
        return 1
    }
    state bindbody {
        env_push(word[pv + 8], word[av + 8])
        pv = word[pv + 16]
        av = word[av + 16]
        to bindloop
    }
}

proc eval_match(scrut, arms, fuel) {
    let sv = eval(scrut, fuel)
    let arm = arms
    let result = 0
    state loop {
        to body when (arm != 0)
        return result               ; no arm matched
    }
    state body {
        let armnode = word[arm + 8]
        let savedepth = word[2097112]
        to matched when (try_match(word[armnode + 8], sv) == 1)
        word[2097112] = savedepth
        arm = word[arm + 16]
        to loop
    }
    state matched {
        result = eval(word[armnode + 16], fuel)
        word[2097112] = savedepth
        return result
    }
}

proc eval(expr, fuel) {
    state fuelchk { to live when (fuel >= 1)  return 0 }   ; OutOfFuel sentinel
    state live {
        let tag = word[expr]
        to t_int when (tag == 0)
        to t1
    }
    state t_int { return mk_int(word[expr + 8]) }          ; INT literal -> VINT
    state t1 { to t_var when (tag == 1)  to t2 }
    state t_var { return env_lookup(word[expr + 8]) }      ; VAR -> value pointer
    state t2 { to t_prim when (tag == 2)  to t3 }
    state t_prim {                   ; PRIM op a b (on integers)
        let a = get_int(eval(word[expr + 16], fuel))
        let b = get_int(eval(word[expr + 24], fuel))
        let op = word[expr + 8]
        to p_add when (op == '+')
        to p1
    }
    state p_add { return mk_int(a + b) }
    state p1 { to p_sub when (op == '-')  to p2 }
    state p_sub { return mk_int(a - b) }
    state p2 { to p_mul when (op == '*')  to p3 }
    state p_mul { return mk_int(a * b) }
    state p3 { to p_div when (op == '/')  to p4 }
    state p_div { return mk_int(a / b) }
    state p4 { to p_mod when (op == '%')  to p5 }
    state p_mod { return mk_int(a % b) }
    state p5 { to p_eq when (op == 'e')  to p6 }
    state p_eq {
        to p_eq1 when (a == b)
        return mk_int(0)
    }
    state p_eq1 { return mk_int(1) }
    state p6 { to p_lt when (op == 'l')  return mk_int(0) }
    state p_lt {
        to p_lt1 when (a < b)
        return mk_int(0)
    }
    state p_lt1 { return mk_int(1) }
    state t3 { to t_if when (tag == 3)  to t4 }
    state t_if {                     ; IF c t e
        to if_then when (get_int(eval(word[expr + 8], fuel)) != 0)
        return eval(word[expr + 24], fuel)
    }
    state if_then { return eval(word[expr + 16], fuel) }
    state t4 { to t_let when (tag == 4)  to t5 }
    state t_let {                    ; LET off e body
        let v = eval(word[expr + 16], fuel)
        env_push(word[expr + 8], v)
        let r = eval(word[expr + 24], fuel)
        word[2097112] = word[2097112] - 1
        return r
    }
    state t5 { to t_call when (tag == 5)  to t7 }
    state t_call { return eval_call(word[expr + 8], word[expr + 16], fuel) }
    state t7 { to t_conapp when (tag == 7)  to t8 }
    state t_conapp { return eval_conapp(word[expr + 8], word[expr + 16], fuel) }
    state t8 { to t_match when (tag == 8)  return 0 }
    state t_match { return eval_match(word[expr + 8], word[expr + 16], fuel) }
}

; ---- print a value (so a program can return data, not just an int) ----

proc emit_dec(n) {
    state neg { to do_neg when (n < 0)  to big }
    state do_neg {
        write_byte('-')
        emit_dec(0 - n)
        return 0
    }
    state big {
        to rec when (n >= 10)
        to digit
    }
    state rec { emit_dec(n / 10)  to digit }
    state digit {
        write_byte(n % 10 + '0')
        return 0
    }
}

proc print_con_name(off) {           ; the constructor name lives at SRC[off]
    let i = 0
    state loop {
        to body when (is_delim(byte[2097152 + off + i]) == 0)
        return 0
    }
    state body {
        write_byte(byte[2097152 + off + i])
        i = i + 1
        to loop
    }
}

proc print_value(v) {
    state vint { to do_int when (word[v] == 100)  to vcons }
    state do_int { emit_dec(word[v + 8])  return 0 }
    state vcons { to compact_cons when (word[v] == 102)  to vcon }
    state compact_cons {
        write_byte('(')
        print_con_name(word[v + 8])
        write_byte(' ')
        print_value(word[v + 16])
        write_byte(' ')
        print_value(word[v + 24])
        write_byte(')')
        return 0
    }
    state vcon {
        let args = word[v + 16]      ; VCON con_off arglist
        to nullary when (args == 0)
        to applied
    }
    state nullary { print_con_name(word[v + 8])  return 0 }   ; just its name
    state applied {
        write_byte('(')
        print_con_name(word[v + 8])
        to argloop
    }
    state argloop {
        to argbody when (args != 0)
        write_byte(')')
        return 0
    }
    state argbody {
        write_byte(' ')
        print_value(word[args + 8])
        args = word[args + 16]
        to argloop
    }
}

proc main() {
    slurp()
    skip_ws()
    state defloop {
        to defbody when (is_def() == 1)
        to run
    }
    state defbody { parse_def()  skip_ws()  to defloop }
    state run {
        let result = eval(parse_expr(), 50000000)   ; fuel: an upper BOUND on calls, not a cost — programs
                                                    ; that terminate sooner are unaffected. 1M starved real
                                                    ; certifier runs (each list index is an O(i) nth chain).
        print_value(result)          ; render the value (int or constructor tree)
        write_byte(10)
        return get_int(result)       ; and deliver an int result as the exit code
    }
}
