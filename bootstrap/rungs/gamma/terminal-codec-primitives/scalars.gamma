; Exact terminal-codec scalar grammar above the raw byte cursor.

(def read_terminal_boolean ((bs Bytes)) RInt
  (match (read_u8 bs)
    (RIntBad RIntBad)
    ((RInt value rest)
      (if (eq value 0) (RInt 0 rest)
        (if (eq value 1) (RInt 1 rest) RIntBad)))))

(def read_optional_semantic_id ((bs Bytes)) ROptionalTerminalSemanticId
  (match (read_u8 bs)
    (RIntBad ROptionalTerminalSemanticIdBad)
    ((RInt tag rest)
      (if (eq tag 0) (ROptionalTerminalSemanticIdNone rest)
        (if (eq tag 1)
          (match (read_nonzero_u64 rest)
            (RU64Bad ROptionalTerminalSemanticIdBad)
            ((RU64 value tail)
              (ROptionalTerminalSemanticIdSome
                (TerminalSemanticId value) tail)))
          ROptionalTerminalSemanticIdBad)))))
