(def structural_leaf_carrier_negative_test () Int
  (if (match (read_terminal_byte_sequence_carrier (B 3 BNil))
        (RTerminalByteSequenceCarrierBad 1)
        ((RTerminalByteSequenceCarrier carrier rest) 0))
