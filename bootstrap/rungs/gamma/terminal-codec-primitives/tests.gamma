; Focused executable contract for reusable terminal scalar/type/value,
; structural-leaf, and canonical UTF-8 grammar fragments.

(def bytes_equal ((left Bytes) (right Bytes)) Int
  (match left
    (BNil (match right (BNil 1) ((B h t) 0)))
    ((B first rest)
      (match right
        (BNil 0)
        ((B other tail) (if (eq first other) (bytes_equal rest tail) 0))))))

(def rutf8_exact_empty ((result RUtf8) (want Bytes)) Int
  (match result
    (RUtf8Bad 0)
    ((RUtf8 got rest)
      (if (bytes_equal got want) (match rest (BNil 1) ((B h t) 0)) 0))))

(def rutf8_exact_one ((result RUtf8) (want Bytes) (tail Int)) Int
  (match result
    (RUtf8Bad 0)
    ((RUtf8 got rest)
      (if (bytes_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rutf8_bad ((result RUtf8)) Int
  (match result (RUtf8Bad 1) ((RUtf8 got rest) 0)))

(def rint_exact_one ((result RInt) (want Int) (tail Int)) Int
  (match result
    (RIntBad 0)
    ((RInt got rest)
      (if (eq got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def roptional_none_one ((result ROptionalTerminalSemanticId) (tail Int)) Int
  (match result
    (ROptionalTerminalSemanticIdBad 0)
    ((ROptionalTerminalSemanticIdSome value rest) 0)
    ((ROptionalTerminalSemanticIdNone rest)
      (match rest
        (BNil 0)
        ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0))))))

(def roptional_some_one
  ((result ROptionalTerminalSemanticId) (want TerminalSemanticId) (tail Int)) Int
  (match result
    (ROptionalTerminalSemanticIdBad 0)
    ((ROptionalTerminalSemanticIdNone rest) 0)
    ((ROptionalTerminalSemanticIdSome got rest)
      (if (terminal_semantic_id_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def roptional_bad ((result ROptionalTerminalSemanticId)) Int
  (match result
    (ROptionalTerminalSemanticIdBad 1)
    ((ROptionalTerminalSemanticIdNone rest) 0)
    ((ROptionalTerminalSemanticIdSome value rest) 0)))

(def rterminal_semantic_id_exact_one
  ((result RTerminalSemanticId) (want TerminalSemanticId) (tail Int)) Int
  (match result
    (RTerminalSemanticIdBad 0)
    ((RTerminalSemanticId got rest)
      (if (terminal_semantic_id_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rterminal_semantic_id_bad ((result RTerminalSemanticId)) Int
  (match result
    (RTerminalSemanticIdBad 1)
    ((RTerminalSemanticId got rest) 0)))

(def terminal_semantic_id_positive_test () Int
  (let low (TerminalSemanticId (U64 1 0))
    (let next (TerminalSemanticId (U64 2 0))
      (let high (TerminalSemanticId (U64 0 1))
        (let maximum (TerminalSemanticId (U64 4294967295 4294967295))
          (if (rterminal_semantic_id_exact_one
                (read_terminal_semantic_id
                  (B 1 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 (B 9 BNil))))))))))
                low 9)
            (if (rterminal_semantic_id_exact_one
                  (read_terminal_semantic_id
                    (repeated_codec_test_byte 255 8 (B 9 BNil)))
                  maximum 9)
              (if (terminal_semantic_id_equal low low)
                (if (eq (terminal_semantic_id_equal low next) 0)
                  (if (terminal_semantic_id_less low next)
                    (if (terminal_semantic_id_less next high)
                      (if (terminal_semantic_id_less high maximum)
                        (eq (terminal_semantic_id_less maximum high) 0)
                        0)
                      0)
                    0)
                  0)
                0)
              0)
            0))))))

(def terminal_semantic_id_negative_test () Int
  (if (rterminal_semantic_id_bad
        (read_terminal_semantic_id
          (repeated_codec_test_byte 0 8 BNil)))
    (if (rterminal_semantic_id_bad
          (read_terminal_semantic_id (B 1 (B 0 BNil))))
      1 0)
    0))

(def terminal_scalar_positive_test () Int
  (if (rint_exact_one (read_terminal_boolean (B 0 (B 9 BNil))) 0 9)
    (if (rint_exact_one (read_terminal_boolean (B 1 (B 9 BNil))) 1 9)
      (if (roptional_none_one
            (read_optional_semantic_id (B 0 (B 9 BNil))) 9)
        (roptional_some_one
          (read_optional_semantic_id
            (B 1 (B 255 (B 255 (B 255 (B 255
              (B 255 (B 255 (B 255 (B 255 (B 9 BNil)))))))))))
          (TerminalSemanticId (U64 4294967295 4294967295)) 9)
        0)
      0)
    0))

(def terminal_scalar_negative_test () Int
  (if (match (read_terminal_boolean (B 2 BNil))
        (RIntBad 1) ((RInt value rest) 0))
    (if (match (read_terminal_boolean BNil)
          (RIntBad 1) ((RInt value rest) 0))
      (if (roptional_bad (read_optional_semantic_id (B 2 BNil)))
        (if (roptional_bad
              (read_optional_semantic_id
                (B 1 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 BNil)))))))))))
          (if (roptional_bad
                (read_optional_semantic_id (B 1 (B 1 (B 0 BNil)))))
            1 0)
          0)
        0)
      0)
    0))

(def rterminal_scalar_type_exact_one
  ((result RTerminalScalarType) (want TerminalScalarType) (tail Int)) Int
  (match result
    (RTerminalScalarTypeBad 0)
    ((RTerminalScalarType got rest)
      (if (terminal_scalar_type_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rterminal_scalar_type_bad ((result RTerminalScalarType)) Int
  (match result
    (RTerminalScalarTypeBad 1)
    ((RTerminalScalarType got rest) 0)))

(def terminal_type_positive_test () Int
  (if (rterminal_scalar_type_exact_one
        (read_terminal_scalar_type (B 1 (B 9 BNil))) TerminalBoolean 9)
    (if (rterminal_scalar_type_exact_one
          (read_terminal_scalar_type
            (B 2 (B 1 (B 1 (B 0 (B 9 BNil))))))
          (TerminalInteger (TerminalFixedSigned 1)) 9)
      (if (rterminal_scalar_type_exact_one
            (read_terminal_scalar_type
              (B 2 (B 1 (B 128 (B 0 (B 9 BNil))))))
            (TerminalInteger (TerminalFixedSigned 128)) 9)
        (if (rterminal_scalar_type_exact_one
              (read_terminal_scalar_type
                (B 2 (B 2 (B 64 (B 0 (B 9 BNil))))))
              (TerminalInteger (TerminalFixedUnsigned 64)) 9)
          (rterminal_scalar_type_exact_one
            (read_terminal_scalar_type
              (B 2 (B 3 (B 128 (B 0 (B 9 BNil))))))
            (TerminalInteger (TerminalAddress 128)) 9)
          0)
        0)
      0)
    0))

(def terminal_type_negative_test () Int
  (if (rterminal_scalar_type_bad (read_terminal_scalar_type (B 0 BNil)))
    (if (rterminal_scalar_type_bad
          (read_terminal_scalar_type (B 2 (B 4 (B 8 (B 0 BNil))))))
      (if (rterminal_scalar_type_bad
            (read_terminal_scalar_type (B 2 (B 1 (B 0 (B 0 BNil))))))
        (if (rterminal_scalar_type_bad
              (read_terminal_scalar_type (B 2 (B 2 (B 129 (B 0 BNil))))))
          (if (rterminal_scalar_type_bad
                (read_terminal_scalar_type (B 2 (B 3 (B 0 (B 0 BNil))))))
            (if (rterminal_scalar_type_bad
                  (read_terminal_scalar_type (B 2 (B 1 BNil))))
              1 0)
            0)
          0)
        0)
      0)
    0))

(def repeated_codec_test_byte ((value Int) (count Int) (tail Bytes)) Bytes
  (if (eq count 0) tail
    (B value (repeated_codec_test_byte value (- count 1) tail))))

(def small_u32_codec_test_bytes ((value Int) (tail Bytes)) Bytes
  (B value (B 0 (B 0 (B 0 tail)))))

(def rterminal_integer_value_exact_one
  ((result RTerminalIntegerValue) (want TerminalIntegerValue) (tail Int)) Int
  (match result
    (RTerminalIntegerValueBad 0)
    ((RTerminalIntegerValue got rest)
      (if (terminal_integer_value_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rterminal_integer_value_bad ((result RTerminalIntegerValue)) Int
  (match result
    (RTerminalIntegerValueBad 1)
    ((RTerminalIntegerValue got rest) 0)))

(def terminal_integer_value_positive_test () Int
  (if (rterminal_integer_value_exact_one
        (read_terminal_integer_value
          (B 1 (repeated_codec_test_byte 255 16 (B 9 BNil))))
        (TerminalSignedValue
          (U128 4294967295 4294967295 4294967295 4294967295)) 9)
    (rterminal_integer_value_exact_one
      (read_terminal_integer_value
        (B 2
          (small_u32_codec_test_bytes 1
            (small_u32_codec_test_bytes 2
              (small_u32_codec_test_bytes 3
                (small_u32_codec_test_bytes 4 (B 9 BNil)))))))
      (TerminalUnsignedValue (U128 1 2 3 4)) 9)
    0))

(def terminal_integer_value_negative_test () Int
  (if (rterminal_integer_value_bad
        (read_terminal_integer_value
          (B 3 (repeated_codec_test_byte 0 16 BNil))))
    (if (rterminal_integer_value_bad
          (read_terminal_integer_value
            (B 1 (repeated_codec_test_byte 0 15 BNil))))
      1 0)
    0))

(def structural_leaf_test_u64
  ((low Int) (high Int) (tail Bytes)) Bytes
  (small_u32_codec_test_bytes low
    (small_u32_codec_test_bytes high tail)))

(def structural_leaf_test_field_one
  ((root-low Int) (root-high Int) (field-low Int) (field-high Int)
   (tail Bytes)) Bytes
  (structural_leaf_test_u64 root-low root-high
    (small_u32_codec_test_bytes 1
      (B 1
        (structural_leaf_test_u64 field-low field-high tail)))))

(def structural_leaf_test_index_one
  ((root-low Int) (root-high Int) (index-low Int) (index-high Int)
   (tail Bytes)) Bytes
  (structural_leaf_test_u64 root-low root-high
    (small_u32_codec_test_bytes 1
      (B 2
        (structural_leaf_test_u64 index-low index-high tail)))))

(def structural_leaf_test_case_field
  ((root-low Int) (root-high Int) (case-low Int) (case-high Int)
   (field-low Int) (field-high Int) (tail Bytes)) Bytes
  (structural_leaf_test_u64 root-low root-high
    (small_u32_codec_test_bytes 2
      (B 3
        (structural_leaf_test_u64 case-low case-high
          (B 1
            (structural_leaf_test_u64 field-low field-high tail)))))))

(def structural_leaf_test_index_max_low
  ((root-low Int) (root-high Int) (tail Bytes)) Bytes
  (structural_leaf_test_u64 root-low root-high
    (small_u32_codec_test_bytes 1
      (B 2
        (repeated_codec_test_byte 255 4
          (small_u32_codec_test_bytes 0 tail))))))

(def structural_leaf_test_mixed_max
  ((root-low Int) (root-high Int) (tail Bytes)) Bytes
  (structural_leaf_test_u64 root-low root-high
    (small_u32_codec_test_bytes 2
      (B 1
        (repeated_codec_test_byte 255 8
          (B 2 (repeated_codec_test_byte 255 8 tail)))))))

(def structural_leaf_expected_field_one
  ((root-low Int) (root-high Int) (field-low Int) (field-high Int))
  TerminalCanonicalStructuralField
  (TerminalCanonicalStructuralField
    (TerminalSemanticId (U64 root-low root-high))
    (TerminalStructuralPathCons
      (TerminalStructuralField
        (TerminalSemanticId (U64 field-low field-high)))
      TerminalStructuralPathNil)))

(def structural_leaf_expected_index_one
  ((root-low Int) (root-high Int) (index-low Int) (index-high Int))
  TerminalCanonicalStructuralField
  (TerminalCanonicalStructuralField
    (TerminalSemanticId (U64 root-low root-high))
    (TerminalStructuralPathCons
      (TerminalStructuralFixedIndex (U64 index-low index-high))
      TerminalStructuralPathNil)))

(def structural_leaf_expected_case_field
  ((root-low Int) (root-high Int) (case-low Int) (case-high Int)
   (field-low Int) (field-high Int)) TerminalCanonicalStructuralField
  (TerminalCanonicalStructuralField
    (TerminalSemanticId (U64 root-low root-high))
    (TerminalStructuralPathCons
      (TerminalStructuralCase
        (TerminalSemanticId (U64 case-low case-high)))
      (TerminalStructuralPathCons
        (TerminalStructuralField
          (TerminalSemanticId (U64 field-low field-high)))
        TerminalStructuralPathNil))))

(def structural_leaf_expected_mixed_max
  ((root-low Int) (root-high Int)) TerminalCanonicalStructuralField
  (TerminalCanonicalStructuralField
    (TerminalSemanticId (U64 root-low root-high))
    (TerminalStructuralPathCons
      (TerminalStructuralField
        (TerminalSemanticId (U64 4294967295 4294967295)))
      (TerminalStructuralPathCons
        (TerminalStructuralFixedIndex (U64 4294967295 4294967295))
        TerminalStructuralPathNil))))

(def structural_leaf_tail_one ((rest Bytes) (tail Int)) Int
  (match rest
    (BNil 0)
    ((B head remaining)
      (if (eq head tail)
        (match remaining (BNil 1) ((B next more) 0))
        0))))

(def structural_leaf_ieee_exact_one
  ((result RTerminalStructuralLeafProposition)
   (want-left TerminalCanonicalStructuralField)
   (want-right TerminalCanonicalStructuralField)
   (want-not-equal Int) (want-binary64 Int) (tail Int)) Int
  (match result
    (RTerminalStructuralLeafPropositionBad 0)
    ((RTerminalStructuralLeafProposition proposition rest)
      (match proposition
        ((TerminalByteSequenceEqual left right) 0)
        ((TerminalStructuralCaseMembership subject case-id) 0)
        ((TerminalIeeeFloatComparison kind format left right)
          (if (terminal_canonical_structural_field_equal left want-left)
            (if (terminal_canonical_structural_field_equal right want-right)
              (match kind
                (TerminalIeeeEqual
                  (if (eq want-not-equal 0)
                    (match format
                      (TerminalIeeeBinary32
                        (if (eq want-binary64 0)
                          (structural_leaf_tail_one rest tail) 0))
                      (TerminalIeeeBinary64 0))
                    0))
                (TerminalIeeeNotEqual
                  (if want-not-equal
                    (match format
                      (TerminalIeeeBinary32 0)
                      (TerminalIeeeBinary64
                        (if want-binary64
                          (structural_leaf_tail_one rest tail) 0)))
                    0)))
              0)
            0))))))

(def structural_leaf_bytes_exact_one
  ((result RTerminalStructuralLeafProposition)
   (want-left TerminalCanonicalStructuralField)
   (want-right TerminalCanonicalStructuralField) (tail Int)) Int
  (match result
    (RTerminalStructuralLeafPropositionBad 0)
    ((RTerminalStructuralLeafProposition proposition rest)
      (match proposition
        ((TerminalIeeeFloatComparison kind format left right) 0)
        ((TerminalStructuralCaseMembership subject case-id) 0)
        ((TerminalByteSequenceEqual left right)
          (if (terminal_canonical_structural_field_equal left want-left)
            (if (terminal_canonical_structural_field_equal right want-right)
              (structural_leaf_tail_one rest tail)
              0)
            0))))))

(def structural_leaf_case_exact_one
  ((result RTerminalStructuralLeafProposition)
   (want-subject TerminalCanonicalStructuralField)
   (want-case TerminalSemanticId) (tail Int)) Int
  (match result
    (RTerminalStructuralLeafPropositionBad 0)
    ((RTerminalStructuralLeafProposition proposition rest)
      (match proposition
        ((TerminalIeeeFloatComparison kind format left right) 0)
        ((TerminalByteSequenceEqual left right) 0)
        ((TerminalStructuralCaseMembership subject case-id)
          (if (terminal_canonical_structural_field_equal subject want-subject)
            (if (terminal_semantic_id_equal case-id want-case)
              (structural_leaf_tail_one rest tail)
              0)
            0))))))

(def structural_leaf_bad
  ((result RTerminalStructuralLeafProposition)) Int
  (match result
    (RTerminalStructuralLeafPropositionBad 1)
    ((RTerminalStructuralLeafProposition proposition rest) 0)))

(def structural_leaf_carrier_positive_test () Int
  (if (match (read_terminal_byte_sequence_carrier (B 1 (B 9 BNil)))
        (RTerminalByteSequenceCarrierBad 0)
        ((RTerminalByteSequenceCarrier carrier rest)
          (match carrier
            (TerminalBorrowedByteView (structural_leaf_tail_one rest 9))
            ((TerminalBoundedOwnedBytes capacity) 0))))
    (match
      (read_terminal_byte_sequence_carrier
        (B 2 (repeated_codec_test_byte 255 8 (B 9 BNil))))
      (RTerminalByteSequenceCarrierBad 0)
      ((RTerminalByteSequenceCarrier carrier rest)
        (match carrier
          (TerminalBorrowedByteView 0)
          ((TerminalBoundedOwnedBytes capacity)
            (if (u64_equal capacity (U64 4294967295 4294967295))
              (if (structural_leaf_tail_one rest 9)
                (match
                  (read_terminal_byte_sequence_carrier
                    (B 2 (structural_leaf_test_u64 0 0 (B 9 BNil))))
                  (RTerminalByteSequenceCarrierBad 0)
                  ((RTerminalByteSequenceCarrier zero-carrier zero-rest)
                    (match zero-carrier
                      (TerminalBorrowedByteView 0)
                      ((TerminalBoundedOwnedBytes zero-capacity)
                        (if (u64_equal zero-capacity (U64 0 0))
                          (structural_leaf_tail_one zero-rest 9)
                          0)))))
                0)
              0)))))
    0))

(def structural_leaf_path_order_test () Int
  (let short (structural_leaf_expected_field_one 1 0 1 0)
    (let long
      (TerminalCanonicalStructuralField
        (TerminalSemanticId (U64 1 0))
        (TerminalStructuralPathCons
          (TerminalStructuralField (TerminalSemanticId (U64 1 0)))
          (TerminalStructuralPathCons
            (TerminalStructuralFixedIndex (U64 0 0))
            TerminalStructuralPathNil)))
      (if (terminal_canonical_structural_field_less short long)
        (eq (terminal_canonical_structural_field_less long short) 0)
        0))))

(def structural_leaf_proposition_positive_test () Int
  (let mixed (structural_leaf_expected_mixed_max 1 0)
    (let case-field (structural_leaf_expected_case_field 0 1 2 0 3 0)
      (let index-one
        (structural_leaf_expected_index_one 1 0 4294967295 0)
        (let index-two (structural_leaf_expected_index_one 1 0 0 1)
          (let field-one (structural_leaf_expected_field_one 1 0 1 0)
            (let index-zero (structural_leaf_expected_index_one 1 0 0 0)
              (let root-subject
                (TerminalCanonicalStructuralField
                  (TerminalSemanticId (U64 1 0)) TerminalStructuralPathNil)
                (if (structural_leaf_ieee_exact_one
                    (read_terminal_structural_leaf_proposition
                        (B 11 (B 1 (B 1
                        (structural_leaf_test_mixed_max 1 0
                          (structural_leaf_test_case_field 0 1 2 0 3 0
                            (B 9 BNil)))))))
                    mixed case-field 0 0 9)
                (if (structural_leaf_ieee_exact_one
                      (read_terminal_structural_leaf_proposition
                        (B 11 (B 2 (B 2
                          (structural_leaf_test_index_max_low 1 0
                            (structural_leaf_test_index_one 1 0 0 1
                              (B 9 BNil)))))))
                      index-one index-two 1 1 9)
                  (if (structural_leaf_bytes_exact_one
                        (read_terminal_structural_leaf_proposition
                          (B 12
                            (structural_leaf_test_field_one 1 0 1 0
                              (structural_leaf_test_index_one 1 0 0 0
                                (B 9 BNil)))))
                        field-one index-zero 9)
                    (structural_leaf_case_exact_one
                      (read_terminal_structural_leaf_proposition
                        (B 13
                          (structural_leaf_test_u64 1 0
                            (small_u32_codec_test_bytes 0
                              (structural_leaf_test_u64 2 0 (B 9 BNil))))))
                      root-subject (TerminalSemanticId (U64 2 0)) 9)
                    0)
                  0)
                0)))))))))

