; Q7 canonical-semantic-ledger Gamma spike: closed data vocabulary.
;
; This is deliberately a bounded PSITERM v18 slice, not a second production
; format.  The shared canonical-bytes layer supplies Bytes/RInt/RBytes and its
; fixed-width primitives; decode.gamma consumes the real canonical bytes pinned by
; psi-terminal-codec/tests/ledger_spike.rs.  The closed types make every byte,
; operation row, premise scope, invalidation, and justification edge visible.

(data Ints (INil) (ICons Int Ints))
(data Decl (Decl Int TerminalScalarType))        ; bounded ID, exact decoded scalar type
(data Decls (DNil) (DCons Decl Decls))

(data Expr
  (Val Int)
  (Lit Int)
  (BoolLit Int)
  (BoolNot Expr)
  (BoolEq Expr Expr)
  (IntEq Expr Expr)
  (BitNot Expr)
  (WidenI8I16 Expr)
  (CastI16I8 Expr)
  (BitAnd Expr Expr)
  (BitOr Expr Expr)
  (BitXor Expr Expr)
  (WrapShl Expr Expr)
  (WrapShr Expr Expr)
  (ExactShl Expr Expr)
  (ExactShr Expr Expr)
  (Add Expr Expr)
  (Sub Expr Expr)
  (Mul Expr Expr)
  (TzDiv Expr Expr)
  (TzRem Expr Expr)
  (WrapAdd Expr Expr)
  (SatAdd Expr Expr)
  (WrapSub Expr Expr)
  (SatSub Expr Expr)
  (WrapMul Expr Expr)
  (SatMul Expr Expr)
  (WrapDiv Expr Expr)
  (WrapRem Expr Expr)
  (SatDiv Expr Expr)
  (SatRem Expr Expr)
  (Less Expr Expr)
  (LessEq Expr Expr))

(data Prop (Le Expr Expr))
(data Props (PNil) (PCons Prop Props))

(data OpKind
  (KIntConst TerminalIntegerValue)
  (KBoolConst Int)
  (KBoolNot Int)
  (KBoolEq Int Int)
  (KIntEq Int Int)
  (KLessEq Int Int)
  (KBitNot Int)
  (KWiden Int)
  (KExactCast Int Int)
  (KBitAnd Int Int)
  (KBitOr Int Int)
  (KBitXor Int Int)
  (KWrapShl Int Int)
  (KWrapShr Int Int)
  (KExactShl Int Int Int)
  (KExactShr Int Int Int)
  (KExactAdd Int Int Int)
  (KExactSub Int Int Int)
  (KExactMul Int Int Int)
  (KWrapAdd Int Int)
  (KSatAdd Int Int)
  (KWrapSub Int Int)
  (KSatSub Int Int)
  (KWrapMul Int Int)
  (KSatMul Int Int)
  (KExactDiv Int Int Int)
  (KExactRem Int Int Int)
  (KWrapDiv Int Int Int)
  (KWrapRem Int Int Int)
  (KSatDiv Int Int Int)
  (KSatRem Int Int Int)
  (KLess Int Int)
  (KCall Int Ints Ints))
(data Op (Op Int Decl OpKind))
(data Ops (ONil) (OCons Op Ops))

; Closed Q7 leaf-operation schema vocabulary.  Calls are deliberately absent:
; their coverage/substitution and control responsibilities are separate ledger
; algebra, not leaf denotation rows.
(data LeafKind
  (LIntConst)
  (LBoolConst)
  (LBoolNot)
  (LBoolEq)
  (LIntEq)
  (LLessEq)
  (LBitNot)
  (LWiden)
  (LExactCast)
  (LBitAnd)
  (LBitOr)
  (LBitXor)
  (LWrapShl)
  (LWrapShr)
  (LExactShl)
  (LExactShr)
  (LExactAdd)
  (LExactSub)
  (LExactMul)
  (LWrapAdd)
  (LSatAdd)
  (LWrapSub)
  (LSatSub)
  (LWrapMul)
  (LSatMul)
  (LExactDiv)
  (LExactRem)
  (LWrapDiv)
  (LWrapRem)
  (LSatDiv)
  (LSatRem)
  (LLess))
(data ResultShape (ResultI8) (ResultI16) (ResultBool))
(data OperandShape
  (IntegerLiteralPayload)
  (BooleanLiteralPayload)
  (UnaryBooleanOperand)
  (UnaryIntegerOperand)
  (WidenI8ToI16Operand)
  (CastI16ToI8Operand)
  (BinaryBooleanOperands)
  (BinaryIntegerOperands)
  (ShiftI8ByI16Operands))
(data Denotation
  (DIntConst)
  (DBoolConst)
  (DBoolNot)
  (DBoolEq)
  (DIntEq)
  (DLessEq)
  (DBitNot)
  (DWidenI8I16)
  (DCastI16I8)
  (DBitAnd)
  (DBitOr)
  (DBitXor)
  (DWrapShl)
  (DWrapShr)
  (DExactShl)
  (DExactShr)
  (DExactAdd)
  (DExactSub)
  (DExactMul)
  (DWrapAdd)
  (DSatAdd)
  (DWrapSub)
  (DSatSub)
  (DWrapMul)
  (DSatMul)
  (DExactDiv)
  (DExactRem)
  (DWrapDiv)
  (DWrapRem)
  (DSatDiv)
  (DSatRem)
  (DLess))
(data GoalShape
  (GoalNone)
  (GoalFitsI8)
  (GoalExactDiv)
  (GoalNonZero)
  (GoalCastI16ToI8)
  (GoalShiftCountI8)
  (GoalShiftLeftI8))
(data FactShape (FactEquation))
(data CrashShape (NeverCrashes) (CrashesUnlessGoal))
(data FuelShape (ConsumesOneFuel))
(data FrontierShape (KeepsLocalFrontier))
(data LeafSchema
  (LeafSchema LeafKind ResultShape OperandShape Denotation GoalShape FactShape
    CrashShape FuelShape FrontierShape))
(data LeafSchemas (LSNil) (LSCons LeafSchema LeafSchemas))
(data LeafView (LeafView LeafKind Int Int Int) (InvalidLeaf) (NotLeaf))
(data NarrowI8 (NarrowI8 Int) (NarrowI8Bad))
(data RLeafSchema
  (LeafSchemaFound LeafSchema)
  (LeafSchemaMissing)
  (LeafSchemaDuplicate))

; Calls are composition, not primitive denotation.  Their closed table keeps
; every independently checked axis visible instead of multiplying bespoke
; verifier functions for scalar, structural, and boundary permutations.
(data CallKind (CallScalar) (CallUnit) (CallBoundary))
(data CallTargetRule (ExactModuleMachine) (ExactBoundaryMachine))
(data CallResultRule
  (ScalarCalleeResult)
  (UnitCalleeResult)
  (BoundaryDeclaredResult))
(data CallArgumentRule
  (ScalarPositionalArguments)
  (StructuralPositionalArguments)
  (BoundaryStructuralArguments))
(data CallRequirementRule
  (EnumerateScalarRequires)
  (EnumerateStructuralRequires)
  (ValidateBoundaryRequirements))
(data CallTransferRule
  (NoStructuralTransfer)
  (ExactClaimTransfers)
  (ExactCompletionReceipts))
(data CallOutcomeRule
  (ImportScalarEnsures)
  (ImportStructuralEnsures)
  (BoundaryDeclaredCompletion))
(data CallCrashRule
  (ComposeScalarCrashRoutes)
  (ComposeStructuralCrashRoutes)
  (BoundaryHasNoCallRoutes))
(data CallEvidenceRule
  (SameUnitOrCertifiedScalarEvidence)
  (SameUnitOrCertifiedStructuralEvidence)
  (ExactBoundaryDeclarationEvidence))
(data CallFrontierRule
  (KeepsScalarFrontier)
  (TransfersStructuralFrontier)
  (SettlesBoundaryFrontier))
(data CallSchema
  (CallSchema CallKind CallTargetRule CallResultRule CallArgumentRule
    CallRequirementRule CallTransferRule CallOutcomeRule CallCrashRule
    CallEvidenceRule FuelShape CallFrontierRule))
(data CallSchemas (CSNil) (CSCons CallSchema CallSchemas))
(data RCallSchema
  (CallSchemaFound CallSchema)
  (CallSchemaMissing)
  (CallSchemaDuplicate))
(data CallCompositionView
  (CallCompositionView CallTargetRule CallResultRule CallArgumentRule
    CallRequirementRule CallTransferRule CallOutcomeRule CallCrashRule
    CallEvidenceRule FuelShape CallFrontierRule))
(data CallCompositionInput
  (CallCompositionInput CallKind CallCompositionView
    Int Int Int Int Int Int Int Int))
; The eight flags above are, in order: exact arity/binder types, pre/post state
; versions, moves/reborrows, complete requirement coverage, capture-free
; substitution, guarded outcome, crash-route composition, evidence lifetime.

(data Edge (Edge Int Int Ints))                 ; edge id, target block, arguments
(data Term (Jump Edge) (Cond Int Edge Edge) (Ret Int Int))
(data Block (Block Int Decls Ops Term))
(data Blocks (BLNil) (BLCons Block Blocks))
(data Contract (Contract Int Props))
(data Machine (Machine Int Decls Decl Int Blocks Contract))
(data Machines (MNil) (MCons Machine Machines))
(data Module (Module Int Int Machines))          ; vocabulary, entry machine

; Parser result types.  Gamma has no parametric types, so each result is
; explicit; that repetition is measured as part of the rung-feasibility spike.
(data RDecl (RDecl Decl Bytes) (RDeclBad))
(data RDecls (RDecls Decls Bytes) (RDeclsBad))
(data RInts (RInts Ints Bytes) (RIntsBad))
(data RExpr (RExpr Expr Bytes) (RExprBad))
(data RProp (RProp Prop Bytes) (RPropBad))
(data RProps (RProps Props Bytes) (RPropsBad))
(data RKind (RKind OpKind Bytes) (RKindBad))
(data ROp (ROp Op Bytes) (ROpBad))
(data ROps (ROps Ops Bytes) (ROpsBad))
(data REdge (REdge Edge Bytes) (REdgeBad))
(data RTerm (RTerm Term Bytes) (RTermBad))
(data RBlock (RBlock Block Bytes) (RBlockBad))
(data RBlocks (RBlocks Blocks Bytes) (RBlocksBad))
(data RContract (RContract Contract Bytes) (RContractBad))
(data RMachine (RMachine Machine Bytes) (RMachineBad))
(data RMachines (RMachines Machines Bytes) (RMachinesBad))
(data RModule (RModule Module) (RModuleBad))

; Canonical semantic-ledger rows.  Scope and invalidation are independent:
; rank prevents circular justification, while scope/dominance decide whether a
; premise is actually available.
(data Formula
  (SafetyFitsI8 Int Expr)
  (SafetyExactDiv Int Int Int)
  (SafetyNonZero Int Int)
  (SafetyCastI16ToI8 Int Int)
  (SafetyShiftCountI8 Int Int)
  (SafetyShiftLeftI8 Int Int Int)
  (ResultEq Int Expr)
  (StructuralFieldEq Int Int Int)
  (AffinePlaceEstablished Int Int)
  (PortWriteEffect Int Int Int)
  (BranchPremise Int Int)
  (EdgeArgument Int Int Int)
  (MergeEq Int Int)
  (AuthoredRequirement Int Int Prop)
  (CallRequirement Int Int Prop))
(data Origin
  (PrimitiveOrigin Int)
  (BranchOrigin Int Int)
  (EdgeOrigin Int)
  (MergeOrigin Int)
  (CallOrigin Int Int))
(data Scope
  (MachineScope Int)
  (BlockScope Int)
  (EdgeScope Int)
  (UntilBlock Int))
(data Row (Row Int Origin Formula Int Scope Ints))
(data Rows (LNil) (LCons Row Rows))
(data RLedger (RLedger Rows) (RLedgerBad))
(data Build (Built Rows Int Decls) (BuildBad))
(data ReqBuild (ReqBuilt Rows Int) (ReqBuildBad))
(data Calc (CalcOk Int) (CalcBad))
(data Metrics (Metrics Int Int Int))             ; rows, ledger bytes, certificate bytes

; Structural/effect leaf vocabulary remains separate from the scalar schema.
; These rows own exact place custody, affine-frontier transitions, and effects.
(data SEField (SEField Int Int Int Ints))       ; id, relevance, scalar type, identity
(data SEFields (SEFNil) (SEFCons SEField SEFields))
(data SEType (SEType Int Ints SEFields))        ; bounded record types only
(data SETypes (SETNil) (SETCons SEType SETypes))
(data SEService (SEService Int Ints Ints))      ; id, identity, parent ids
(data SEServices (SESNil) (SESCons SEService SEServices))
(data SEParameter (SEParameter Int Int Int Int Int Ints))
(data SEParameters (SEPNil) (SEPCons SEParameter SEParameters))
(data SEPlaceKind
  (SEParameterPlace Int Int)
  (SETrivialAffineLocal Int Int))
(data SEPlace (SEPlace Int SEPlaceKind))
(data SEPlaces (SEPlNil) (SEPlCons SEPlace SEPlaces))
(data SEResult (SEUnitResult) (SEScalarResult Decl))
(data SEOpKind
  (SEEstablish Int)
  (SEBooleanField Int Int)
  (SEPortWrite Int Int Int))
(data SEOp (SEOp Int SEResult SEOpKind))
(data SEOps (SEONil) (SEOCons SEOp SEOps))
(data SETerminator
  (SEReturnNominal Int Int Int Int Int)
  (SEReturnUnit Int Ints))
(data SEBlock (SEBlock Int Decls SEOps SETerminator))
(data SEBlocks (SEBNil) (SEBCons SEBlock SEBlocks))
(data SEMachine
  (SEMachine Int Int Decls SEParameters SEResult SEPlaces Ints Int SEBlocks Contract))
(data SEMachines (SEMNil) (SEMCons SEMachine SEMachines))
(data SEModule (SEModule Int Int SETypes SEServices SEMachines))
(data RSEField (RSEField SEField Bytes) (RSEFieldBad))
(data RSEFields (RSEFields SEFields Bytes) (RSEFieldsBad))
(data RSEType (RSEType SEType Bytes) (RSETypeBad))
(data RSETypes (RSETypes SETypes Bytes) (RSETypesBad))
(data RSEService (RSEService SEService Bytes) (RSEServiceBad))
(data RSEServices (RSEServices SEServices Bytes) (RSEServicesBad))
(data RSEParameter (RSEParameter SEParameter Bytes) (RSEParameterBad))
(data RSEParameters (RSEParameters SEParameters Bytes) (RSEParametersBad))
(data RSEPlace (RSEPlace SEPlace Bytes) (RSEPlaceBad))
(data RSEPlaces (RSEPlaces SEPlaces Bytes) (RSEPlacesBad))
(data RSEResult (RSEResult SEResult Bytes) (RSEResultBad))
(data RSEOpKind (RSEOpKind SEOpKind Bytes) (RSEOpKindBad))
(data RSEOp (RSEOp SEOp Bytes) (RSEOpBad))
(data RSEOps (RSEOps SEOps Bytes) (RSEOpsBad))
(data RSETerminator (RSETerminator SETerminator Bytes) (RSETerminatorBad))
(data RSEBlock (RSEBlock SEBlock Bytes) (RSEBlockBad))
(data RSEBlocks (RSEBlocks SEBlocks Bytes) (RSEBlocksBad))
(data RSEMachine (RSEMachine SEMachine Bytes) (RSEMachineBad))
(data RSEMachines (RSEMachines SEMachines Bytes) (RSEMachinesBad))
(data RSEModule (RSEModule SEModule) (RSEModuleBad))

; Canonical-byte call-composition fixture vocabulary.  It reuses the exact
; structural type/parameter/place declarations above, but keeps domains,
; boundary signatures, claims, and call operations in a separate module.
(data CCDomain (CCDomain Int Ints Int))          ; id, identity, carrier
(data CCDomains (CCDNil) (CCDCons CCDomain CCDomains))
(data CCRequirement (CCRequirement Int Int))     ; argument index, domain
(data CCRequirements (CCRNil) (CCRCons CCRequirement CCRequirements))
(data CCBoundaryResult
  (CCBoundaryUnit)
  (CCBoundaryScalar TerminalScalarType))
(data CCBoundary
  (CCBoundary Int Ints Int SEParameters CCBoundaryResult CCRequirements Ints))
(data CCBoundaries (CCBNil) (CCBCons CCBoundary CCBoundaries))
(data CCEntryClaim (CCEntryClaim Int Int))       ; claim, whole-place input
(data CCEntryClaims (CCENil) (CCECons CCEntryClaim CCEntryClaims))
(data CCArgument (CCArgument Int))               ; whole structural place
(data CCArguments (CCANil) (CCACons CCArgument CCArguments))
(data CCTransfer (CCTransfer Int Int))            ; claim, argument index
(data CCTransfers (CCTNil) (CCTCons CCTransfer CCTransfers))
(data CCOpKind
  (CCCallUnit Int CCArguments CCTransfers Ints)
  (CCBoundaryCall Int CCArguments CCTransfers Ints))
(data CCOp (CCOp Int SEResult CCOpKind))
(data CCOps (CCONil) (CCOCons CCOp CCOps))
(data CCBlock (CCBlock Int Decls CCOps SETerminator))
(data CCBlocks (CCBLNil) (CCBLCons CCBlock CCBlocks))
(data CCMachine
  (CCMachine Int Int Decls SEParameters SEResult SEPlaces CCEntryClaims Ints
    Int CCBlocks Contract))
(data CCMachines (CCMNil) (CCMCons CCMachine CCMachines))
(data CCModule
  (CCModule Int Int SETypes CCDomains SEServices CCBoundaries CCMachines))
(data RCCDomain (RCCDomain CCDomain Bytes) (RCCDomainBad))
(data RCCDomains (RCCDomains CCDomains Bytes) (RCCDomainsBad))
(data RCCRequirement
  (RCCRequirement CCRequirement Bytes)
  (RCCRequirementBad))
(data RCCRequirements
  (RCCRequirements CCRequirements Bytes)
  (RCCRequirementsBad))
(data RCCBoundary (RCCBoundary CCBoundary Bytes) (RCCBoundaryBad))
(data RCCBoundaries (RCCBoundaries CCBoundaries Bytes) (RCCBoundariesBad))
(data RCCEntryClaim (RCCEntryClaim CCEntryClaim Bytes) (RCCEntryClaimBad))
(data RCCEntryClaims (RCCEntryClaims CCEntryClaims Bytes) (RCCEntryClaimsBad))
(data RCCArgument (RCCArgument CCArgument Bytes) (RCCArgumentBad))
(data RCCArguments (RCCArguments CCArguments Bytes) (RCCArgumentsBad))
(data RCCTransfer (RCCTransfer CCTransfer Bytes) (RCCTransferBad))
(data RCCTransfers (RCCTransfers CCTransfers Bytes) (RCCTransfersBad))
(data RCCOpKind (RCCOpKind CCOpKind Bytes) (RCCOpKindBad))
(data RCCOp (RCCOp CCOp Bytes) (RCCOpBad))
(data RCCOps (RCCOps CCOps Bytes) (RCCOpsBad))
(data RCCBlock (RCCBlock CCBlock Bytes) (RCCBlockBad))
(data RCCBlocks (RCCBlocks CCBlocks Bytes) (RCCBlocksBad))
(data RCCMachine (RCCMachine CCMachine Bytes) (RCCMachineBad))
(data RCCMachines (RCCMachines CCMachines Bytes) (RCCMachinesBad))
(data RCCModule (RCCModule CCModule) (RCCModuleBad))
(data SEKind (SELBooleanField) (SELPortWrite) (SELEstablish))
(data SEResultRule (SEBooleanResult) (SEUnitSemanticResult))
(data SECustodyRule
  (SEExactLiveBooleanField)
  (SEExactPublishedService)
  (SEExactEmptyAffineLocal))
(data SEAction
  (SEReadBooleanField)
  (SEEmitPortWrite)
  (SEEstablishAffinePlace))
(data SEEffectRule (SENoExternalEffect) (SEPortWriteExternalEffect))
(data SEFrontierRule
  (SERequiresKeepsAffinePlace)
  (SEKeepsPlaceFrontier)
  (SEAddsAffinePlace))
(data SESchema
  (SESchema SEKind SEResultRule SECustodyRule SEAction SEEffectRule
    FuelShape SEFrontierRule))
(data SESchemas (SELSNil) (SELSCons SESchema SESchemas))
(data RSESchema
  (SESchemaFound SESchema)
  (SESchemaMissing)
  (SESchemaDuplicate))
