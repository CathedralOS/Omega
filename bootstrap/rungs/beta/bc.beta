; bc.beta — the Beta compiler, WRITTEN IN BETA.  *** SELF-HOSTING ***
;
; Reads Beta source on stdin, emits Alpha assembly on stdout — the same job as the
; Rust on-ramp (beta-rust), but written in Beta itself. It compiles its OWN
; source to a fixed point (selfhost.sh): bc(bc.beta) assembles to a compiler that
; reproduces bc(bc.beta) byte-for-byte. The persisted artifact is reconstructed
; by the exact Alpha-written cold-start compiler; Rust is absent from its lineage.
;
; Implements the whole Beta language (LANGUAGE.md): arithmetic; let/assign/vars;
; the six comparisons; CFG state/transition control flow (`state` basic blocks linked
; by guarded `to … when …` transitions — Beta has NO if/while); procedures,
; parameters, calls, recursion; byte[]/word[] memory; char literals; read_byte/
; write_byte intrinsics; string literals via emit("...").
;
; The control flow is itself CFG/Omega-shaped: every proc is a set of `state` basic
; blocks. So the self-hosting compiler is written in the same state-graph style it
; emits, and it dogfoods its own gen_state/gen_to by compiling itself.
;
; Single pass with one pre-scan: count_lets() scans a proc body once (skipping
; char/string literals, counting `let`s at any brace depth — including inside states)
; before codegen. Locals are at [fp - 8 - 8*slot], matching the on-ramp.
;
; Fixed memory (above the 1 MiB data stack):
;   2097152 SRC    source bytes        2097144 CUR    cursor (index into SRC)
;   SRC occupies [2097152, 3145728): exactly 1048576 bytes; exhaustion returns 253
;   2097136 LEN    source length       2097128 NLOC   declared local count
;   2097120 IDOFF  last ident offset    2097112 IDLEN  last ident length
;   2097104 LBL    label counter        2097096 CURPROC off  2097088 CURPROC len
;   2097080 EXPRDEPTH                   2097072 RESOURCE_FAIL (0 or exit 252)
;   2097064 BLOCKDEPTH
;   3145728 NAMEOFF[i] (word)          3153920 NAMELEN[i] (word)   ; i = slot

; ---------------- reading the source ----------------

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop { to body when (c >= 0)  to done }
    state body { to full when (n == 1048576)  byte[2097152 + n] = c  n = n + 1  c = read_byte()  to loop }
    state full { return 0 }
    state done {
        word[2097136] = n        ; LEN
        word[2097144] = 0        ; CUR
        word[2097128] = 0        ; NLOC
        word[2097104] = 0        ; LBL (label counter)
        word[2097080] = 0        ; EXPRDEPTH
        word[2097072] = 0        ; RESOURCE_FAIL
        word[2097064] = 0        ; BLOCKDEPTH
        return 1
    }
}

proc new_label() {
    let n = word[2097104]
    word[2097104] = n + 1
    return n
}

proc emit_lref(n) {          ; emit a label name _L<n>
    emit("_L")
    emit_dec(n)
}

proc cur() {
    return word[2097144]
}

proc cbyte() {               ; byte at cursor, or 0 past end
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

; ---------------- character classes ----------------

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_alpha(c) {
    state u { to yes when (c == '_')  to c1 }
    state c1 { to no when (c < 'A')  to c2 }
    state c2 { to yes when (c <= 'Z')  to c3 }
    state c3 { to no when (c < 'a')  to c4 }
    state c4 { to yes when (c <= 'z')  return 0 }
    state no { return 0 }
    state yes { return 1 }
}

proc is_alnum(c) {
    state chk { to yes when (is_alpha(c) == 1)  return is_digit(c) }
    state yes { return 1 }
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)  to c3 }
    state c3 { to yes when (c == 10)  to c4 }
    state c4 { to yes when (c == 13)  return 0 }
    state yes { return 1 }
}

; ---------------- tokenizer ----------------

proc skip_ws() {             ; spaces, newlines, and ;-to-end-of-line comments
    state loop { to loop when (skip_ws_step() == 1)  return 0 }
}

proc skip_ws_step() {        ; advance over one ws/comment run; 1 if it did, else 0
    let c = cbyte()
    state sp { to do_sp when (is_space(c) == 1)  to semi }
    state do_sp { adv()  return 1 }
    state semi { to do_semi when (c == ';')  return 0 }
    state do_semi { to cloop }
    state cloop {
        to cret when (cbyte() == 10)
        to ceof when (cbyte() == 0)
        adv()
        to cloop
    }
    state ceof { return 0 }
    state cret { return 1 }
}

proc read_ident() {          ; cursor at an alpha; record IDOFF/IDLEN, consume it
    word[2097120] = word[2097144]                  ; IDOFF = CUR
    state loop { to body when (is_alnum(cbyte()) == 1)  to done }
    state body { adv()  to loop }
    state done { word[2097112] = word[2097144] - word[2097120]  return 0 }   ; IDLEN
}

; does the last-read ident (IDOFF/IDLEN) equal a keyword?
proc id_char(k) {            ; k-th byte of the current ident
    return byte[2097152 + word[2097120] + k]
}

proc is_let() {
    state c0 { to c1 when (word[2097112] == 3)  return 0 }
    state c1 { to c2 when (id_char(0) == 'l')  return 0 }
    state c2 { to c3 when (id_char(1) == 'e')  return 0 }
    state c3 { to yes when (id_char(2) == 't')  return 0 }
    state yes { return 1 }
}

proc is_return() {
    state c0 { to c1 when (word[2097112] == 6)  return 0 }
    state c1 { to c2 when (id_char(0) == 'r')  return 0 }
    state c2 { to c3 when (id_char(1) == 'e')  return 0 }
    state c3 { to c4 when (id_char(2) == 't')  return 0 }
    state c4 { to c5 when (id_char(3) == 'u')  return 0 }
    state c5 { to c6 when (id_char(4) == 'r')  return 0 }
    state c6 { to yes when (id_char(5) == 'n')  return 0 }
    state yes { return 1 }
}

proc is_state() {            ; CFG basic block (Omega-style)
    state c0 { to c1 when (word[2097112] == 5)  return 0 }
    state c1 { to c2 when (id_char(0) == 's')  return 0 }
    state c2 { to c3 when (id_char(1) == 't')  return 0 }
    state c3 { to c4 when (id_char(2) == 'a')  return 0 }
    state c4 { to c5 when (id_char(3) == 't')  return 0 }
    state c5 { to yes when (id_char(4) == 'e')  return 0 }
    state yes { return 1 }
}

proc is_to() {               ; transition keyword
    state c0 { to c1 when (word[2097112] == 2)  return 0 }
    state c1 { to c2 when (id_char(0) == 't')  return 0 }
    state c2 { to yes when (id_char(1) == 'o')  return 0 }
    state yes { return 1 }
}

proc is_when() {             ; transition guard keyword
    state c0 { to c1 when (word[2097112] == 4)  return 0 }
    state c1 { to c2 when (id_char(0) == 'w')  return 0 }
    state c2 { to c3 when (id_char(1) == 'h')  return 0 }
    state c3 { to c4 when (id_char(2) == 'e')  return 0 }
    state c4 { to yes when (id_char(3) == 'n')  return 0 }
    state yes { return 1 }
}

proc is_byte() {
    state c0 { to c1 when (word[2097112] == 4)  return 0 }
    state c1 { to c2 when (id_char(0) == 'b')  return 0 }
    state c2 { to c3 when (id_char(1) == 'y')  return 0 }
    state c3 { to c4 when (id_char(2) == 't')  return 0 }
    state c4 { to yes when (id_char(3) == 'e')  return 0 }
    state yes { return 1 }
}

proc is_word() {
    state c0 { to c1 when (word[2097112] == 4)  return 0 }
    state c1 { to c2 when (id_char(0) == 'w')  return 0 }
    state c2 { to c3 when (id_char(1) == 'o')  return 0 }
    state c3 { to c4 when (id_char(2) == 'r')  return 0 }
    state c4 { to yes when (id_char(3) == 'd')  return 0 }
    state yes { return 1 }
}

proc is_read_byte() {        ; current ident == "read_byte" (9 chars)
    state c0 { to c1 when (word[2097112] == 9)  return 0 }
    state c1 { to c2 when (id_char(0) == 'r')  return 0 }
    state c2 { to c3 when (id_char(1) == 'e')  return 0 }
    state c3 { to c4 when (id_char(2) == 'a')  return 0 }
    state c4 { to c5 when (id_char(3) == 'd')  return 0 }
    state c5 { to c6 when (id_char(4) == '_')  return 0 }
    state c6 { to c7 when (id_char(5) == 'b')  return 0 }
    state c7 { to c8 when (id_char(6) == 'y')  return 0 }
    state c8 { to c9 when (id_char(7) == 't')  return 0 }
    state c9 { to yes when (id_char(8) == 'e')  return 0 }
    state yes { return 1 }
}

proc is_write_byte() {       ; current ident == "write_byte" (10 chars)
    state c0 { to c1 when (word[2097112] == 10)  return 0 }
    state c1 { to c2 when (id_char(0) == 'w')  return 0 }
    state c2 { to c3 when (id_char(1) == 'r')  return 0 }
    state c3 { to c4 when (id_char(2) == 'i')  return 0 }
    state c4 { to c5 when (id_char(3) == 't')  return 0 }
    state c5 { to c6 when (id_char(4) == 'e')  return 0 }
    state c6 { to c7 when (id_char(5) == '_')  return 0 }
    state c7 { to c8 when (id_char(6) == 'b')  return 0 }
    state c8 { to c9 when (id_char(7) == 'y')  return 0 }
    state c9 { to c10 when (id_char(8) == 't')  return 0 }
    state c10 { to yes when (id_char(9) == 'e')  return 0 }
    state yes { return 1 }
}

proc is_emit() {             ; current ident == "emit" (4 chars)
    state c0 { to c1 when (word[2097112] == 4)  return 0 }
    state c1 { to c2 when (id_char(0) == 'e')  return 0 }
    state c2 { to c3 when (id_char(1) == 'm')  return 0 }
    state c3 { to c4 when (id_char(2) == 'i')  return 0 }
    state c4 { to yes when (id_char(3) == 't')  return 0 }
    state yes { return 1 }
}

proc expect(ch) {            ; skip ws then consume ch if present
    skip_ws()
    state chk { to do_adv when (cbyte() == ch)  return 0 }
    state do_adv { adv()  return 0 }
}

proc gen_load(w) {           ; byte[addr] / word[addr] -> r0
    expect('[')
    gen_expr()
    expect(']')
    state chk { to byteld when (w == 1)  to wordld }
    state byteld { emit("loadb r0,r0\n")  return 0 }
    state wordld { emit("load r0,r0\n")  return 0 }
}

proc gen_store(w) {          ; byte[addr] = val / word[addr] = val
    expect('[')
    gen_expr()               ; addr
    expect(']')
    emit_push()              ; save addr
    expect('=')
    gen_expr()               ; val -> r0
    emit_pop_into(1)         ; r1 = addr
    state chk { to bytest when (w == 1)  to wordst }
    state bytest { emit("storeb r1,r0\n")  return 0 }
    state wordst { emit("store r1,r0\n")  return 0 }
}

; copy the string-literal body (cursor at opening ") verbatim into the db output.
proc emit_str_body() {
    adv()                    ; opening "
    let len = 0
    state loop { to body when (cbyte() != 34)  to done }
    state body {
        to eof when (cbyte() == 0)
        to esc when (cbyte() == 92)     ; backslash escape: copy '\' and the next char
        write_byte(cbyte())
        adv()
        len = len + 1
        to loop
    }
    state eof { return len }
    state esc {
        write_byte(92)
        adv()
        write_byte(cbyte())
        adv()
        len = len + 1
        to loop
    }
    state done { adv()  return len }   ; closing "
}

; emit("...") -> inline db data (jumped over) + a call to __write_str.
proc gen_emit() {
    expect('(')
    skip_ws()
    let slbl = new_label()
    let albl = new_label()
    emit("jmp ")
    emit_lref(albl)
    emit("\n")
    emit_lref(slbl)
    emit(":\n")
    emit("db \"")
    let len = emit_str_body()
    emit("\"\n")
    emit_lref(albl)
    emit(":\n")
    emit("imm r0,")
    emit_lref(slbl)
    emit("\n")
    emit("imm r1,")
    emit_dec(len)
    emit("\n")
    emit("call __write_str\n")
    expect(')')
    return 0
}

proc emit_write_str() {      ; leaf helper: r0=addr, r1=len; write len bytes from [addr]
    emit("__write_str:\n")
    emit("__ws_loop:\n")
    emit("imm r3,0\n")
    emit("jeq r1,r3,__ws_done\n")
    emit("loadb r2,r0\n")
    emit("write r2\n")
    emit("imm r3,1\n")
    emit("add r0,r3\n")
    emit("sub r1,r3\n")
    emit("jmp __ws_loop\n")
    emit("__ws_done:\n")
    emit("ret\n")
}

proc gen_read_byte() {       ; read_byte() -> read into r0 (-1 at EOF)
    expect('(')
    expect(')')
    emit("read r0\n")
    return 0
}

proc gen_write_byte() {      ; write_byte(x) -> write low byte of x
    expect('(')
    gen_expr()
    expect(')')
    emit("write r0\n")
    return 0
}

proc gen_call() {            ; f(args): callee name is in IDOFF/IDLEN, cursor at '('
    state rb { to do_rb when (is_read_byte() == 1)  to wb }
    state do_rb { gen_read_byte()  return 0 }
    state wb { to do_wb when (is_write_byte() == 1)  to em }
    state do_wb { gen_write_byte()  return 0 }
    state em { to do_em when (is_emit() == 1)  to normal }
    state do_em { gen_emit()  return 0 }
    state normal {
        let nameoff = word[2097120]    ; IDOFF — save before arg parsing clobbers it
        let namelen = word[2097112]    ; IDLEN
        expect('(')
        let nargs = 0
        skip_ws()
        to argloop
    }
    state argloop {
        to argbody when (cbyte() != ')')
        to argsdone
    }
    state argbody {
        to argroom when (nargs < 4)
        word[2097072] = 252
        return 0
    }
    state argroom {
        gen_expr()                 ; stage each arg onto the data stack, left to right
        to argfailed when (word[2097072] != 0)
        emit_push()
        nargs = nargs + 1
        skip_ws()
        to comma when (cbyte() == ',')
        to argloop
    }
    state argfailed { return 0 }
    state comma { adv()  skip_ws()  to argloop }
    state argsdone {
        adv()                          ; consume ')'
        let k = nargs                  ; unstage top..bottom into r(nargs-1)..r0
        to poploop
    }
    state poploop {
        to popbody when (k > 0)
        to emitcall
    }
    state popbody { k = k - 1  emit_pop_into(k)  to poploop }
    state emitcall {
        emit("call ")
        emit_ident_at(nameoff, namelen)
        emit("\n")
        return 0
    }
}

proc parse_number() {
    let v = 0
    state loop { to body when (is_digit(cbyte()) == 1)  return v }
    state body { v = v * 10 + (cbyte() - '0')  adv()  to loop }
}

; ---------------- symbol table (per-proc locals) ----------------

proc declare() {             ; declare a local named by IDOFF/IDLEN; return its slot
    let s = word[2097128]                          ; NLOC
    state room { to write when (s < 1024)  word[2097072] = 252  return 0 }
    state write {
    word[3145728 + s * 8] = word[2097120]          ; NAMEOFF[s] = IDOFF
    word[3153920 + s * 8] = word[2097112]          ; NAMELEN[s] = IDLEN
    word[2097128] = s + 1
    return s
    }
}

proc name_eq(i) {            ; does local i's name match the current IDOFF/IDLEN?
    state chk { to match when (word[3153920 + i * 8] == word[2097112])  return 0 }
    state match {
        let a = word[3145728 + i * 8]              ; local i name offset
        let b = word[2097120]                      ; IDOFF
        let len = word[2097112]
        let k = 0
        to loop
    }
    state loop { to body when (k < len)  return 1 }
    state body {
        to diff when (byte[2097152 + a + k] != byte[2097152 + b + k])
        k = k + 1
        to loop
    }
    state diff { return 0 }
}

proc lookup() {              ; slot of the current IDOFF/IDLEN (0 if unknown)
    let n = word[2097128]
    let i = 0
    state loop { to body when (i < n)  return 0 }
    state body {
        to hit when (name_eq(i) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

proc skip_char_lit() {       ; cursor at opening '; consume the whole 'x' / '\x'
    adv()                    ; opening '
    state bs { to do_bs when (cbyte() == 92)  to ch }
    state do_bs { adv()  to ch }
    state ch { adv()  adv()  return 0 }   ; the char + closing '
}

proc skip_str_lit() {        ; cursor at opening "; consume the whole "..."
    adv()                    ; opening "
    state loop { to body when (cbyte() != 34)  to done }
    state body {
        to eof when (cbyte() == 0)
        to esc when (cbyte() == 92)     ; backslash escape -> skip the next char too
        adv()
        to loop
    }
    state eof { return 0 }
    state esc { adv()  adv()  to loop }
    state done { adv()  return 0 }   ; closing "
}

; count `let` declarations in the body from the cursor to the matching `}`,
; leaving the cursor unmoved.
proc count_lets() {
    let start = word[2097144]
    let depth = 1
    let count = 0
    state loop { to body when (depth > 0)  to done }
    state body {
        skip_ws()
        let c = cbyte()
        to ceof when (c == 0)
        to cchar when (c == 39)         ; ' char literal — skip as a unit
        to cstr when (c == 34)          ; " string literal — skip as a unit
        to copen when (c == '{')
        to cclose when (c == '}')
        to calpha when (is_alpha(c) == 1)
        adv()
        to loop
    }
    state ceof { depth = 0  to loop }
    state cchar { skip_char_lit()  to loop }
    state cstr { skip_str_lit()  to loop }
    state copen { depth = depth + 1  adv()  to loop }
    state cclose { depth = depth - 1  adv()  to loop }
    state calpha {
        read_ident()
        to inc when (is_let() == 1)
        to loop
    }
    state inc { count = count + 1  to loop }
    state done { word[2097144] = start  return count }
}

; ---------------- emit decimal ----------------

proc emit_dec(n) {
    state big { to rec when (n >= 10)  to digit }
    state rec { emit_dec(n / 10)  to digit }
    state digit { write_byte(n % 10 + '0')  return 0 }
}

; ---------------- fixed asm fragments (compact) ----------------

proc emit_prelude() {            ; program entry: init sp/fp, call main, halt
    emit("; bc\n")
    emit("imm r15,1048576\n")
    emit("imm r14,1048576\n")
    emit("call main\n")
    emit("halt r0\n")
}

proc emit_proc_prologue(nslots) {
    ; scratch is r5, NOT r2 — args arrive live in r0..r3 and r2 (arg 3) must
    ; survive until stored to its slot below (else 3-arg calls corrupt arg 3).
    emit("imm r5,8\n")
    emit("sub r15,r5\n")
    emit("store r15,r14\n")
    emit("mov r14,r15\n")
    state chk { to slots when (nslots > 0)  return 0 }
    state slots {
        emit("imm r5,")
        emit_dec(nslots * 8)
        emit("\n")
        emit("sub r15,r5\n")
        return 0
    }
}

proc emit_param_store(k) {       ; store arg register r<k> into frame slot k
    emit("mov r5,r14\n")
    emit("imm r4,")
    emit_dec(8 + 8 * k)
    emit("\n")
    emit("sub r5,r4\n")
    emit("store r5,r")
    emit_dec(k)
    emit("\n")
}

proc emit_pop_into(k) {          ; pop the data stack top into r<k>
    emit("load r")
    emit_dec(k)
    emit(",r15\n")
    emit("imm r5,8\n")
    emit("add r15,r5\n")
}

proc emit_ident_at(off, len) {   ; write `len` source bytes starting at SRC[off]
    let k = 0
    state loop { to body when (k < len)  return 0 }
    state body { write_byte(byte[2097152 + off + k])  k = k + 1  to loop }
}

proc emit_epilogue() {
    emit("mov r15,r14\n")
    emit("load r14,r15\n")
    emit("imm r2,8\n")
    emit("add r15,r2\n")
    emit("ret\n")
}

proc emit_push() {
    emit("imm r2,8\n")
    emit("sub r15,r2\n")
    emit("store r15,r0\n")
}

proc emit_mnemonic(op) {
    state add { to do_add when (op == '+')  to sub }
    state do_add { emit("add")  return 0 }
    state sub { to do_sub when (op == '-')  to mul }
    state do_sub { emit("sub")  return 0 }
    state mul { to do_mul when (op == '*')  to div }
    state do_mul { emit("mul")  return 0 }
    state div { to do_div when (op == '/')  to mod }
    state do_div { emit("div")  return 0 }
    state mod { to do_mod when (op == '%')  return 0 }
    state do_mod { emit("mod")  return 0 }
}

proc emit_combine(op) {
    emit("mov r1,r0\n")
    emit("load r0,r15\n")
    emit("imm r5,8\n")
    emit("add r15,r5\n")
    emit_mnemonic(op)
    emit(" r0,r1\n")
}

proc emit_slot_addr(reg, slot) {   ; reg = &slot  (reg is 0 or 1)
    emit("mov r")
    emit_dec(reg)
    emit(",r14\n")
    emit("imm r2,")
    emit_dec(8 + 8 * slot)
    emit("\n")
    emit("sub r")
    emit_dec(reg)
    emit(",r2\n")
}

proc emit_load_slot(slot) {        ; r0 = local[slot]
    emit_slot_addr(0, slot)
    emit("load r0,r0\n")
}

proc emit_store_slot(slot) {       ; local[slot] = r0
    emit_slot_addr(1, slot)
    emit("store r1,r0\n")
}

; ---------------- character classes for operators ----------------

proc is_muldiv(c) {
    state s1 { to yes when (c == '*')  to s2 }
    state s2 { to yes when (c == '/')  to s3 }
    state s3 { to yes when (c == '%')  return 0 }
    state yes { return 1 }
}

proc is_addsub(c) {
    state s1 { to yes when (c == '+')  to s2 }
    state s2 { to yes when (c == '-')  return 0 }
    state yes { return 1 }
}

; ---------------- recursive-descent codegen ----------------

proc gen_factor() {
    skip_ws()
    let c = cbyte()
    state paren { to do_paren when (c == '(')  to alpha }
    state do_paren { adv()  gen_expr()  expect(')')  return 0 }
    state alpha { to do_alpha when (is_alpha(c) == 1)  to charlit }
    state do_alpha {
        read_ident()
        to byteld when (is_byte() == 1)             ; byte[addr]
        to wordchk
    }
    state byteld { gen_load(1)  return 0 }
    state wordchk { to wordld when (is_word() == 1)  to callchk }   ; word[addr]
    state wordld { gen_load(8)  return 0 }
    state callchk {
        skip_ws()
        to docall when (cbyte() == '(')             ; f(args)
        emit_load_slot(lookup())                    ; variable reference
        return 0
    }
    state docall { gen_call()  return 0 }
    state charlit { to do_char when (c == 39)  to number }
    state do_char {                                 ; char literal 'x' -> its byte value
        emit("imm r0,")
        emit_dec(parse_char())
        emit("\n")
        return 0
    }
    state number {
        let v = parse_number()
        emit("imm r0,")
        emit_dec(v)
        emit("\n")
        return 0
    }
}

proc parse_char() {                 ; cursor at opening '; return the byte value
    adv()                           ; opening '
    let v = cbyte()
    state esc { to do_esc when (v == 92)  to fin }     ; backslash escape
    state do_esc {
        adv()
        v = cbyte()
        to set_n when (v == 'n')
        to chk_t
    }
    state set_n { v = 10  to fin }
    state chk_t { to set_t when (v == 't')  to chk_r }
    state set_t { v = 9  to fin }
    state chk_r { to set_r when (v == 'r')  to chk_0 }
    state set_r { v = 13  to fin }
    state chk_0 { to set_0 when (v == '0')  to fin }   ; \\ and \' keep v = 92 / 39
    state set_0 { v = 0  to fin }
    state fin { adv()  adv()  return v }               ; the (escaped) char + closing '
}

proc gen_term() {
    gen_factor()
    skip_ws()
    state loop { to body when (is_muldiv(cbyte()) == 1)  return 0 }
    state body {
        let op = cbyte()
        adv()
        emit_push()
        gen_factor()
        emit_combine(op)
        skip_ws()
        to loop
    }
}

proc gen_sum() {
    gen_term()
    skip_ws()
    state loop { to body when (is_addsub(cbyte()) == 1)  return 0 }
    state body {
        let op = cbyte()
        adv()
        emit_push()
        gen_term()
        emit_combine(op)
        skip_ws()
        to loop
    }
}

; comparison operator at the cursor -> code 0..5 (consumed), or -1 if none.
;   0 '<'   1 '>'   2 '=='   3 '!='   4 '<='   5 '>='
proc cmp_op() {
    let c = cbyte()
    state lt { to do_lt when (c == '<')  to gt }
    state do_lt {
        adv()
        to lt_eq when (cbyte() == '=')
        return 0
    }
    state lt_eq { adv()  return 4 }
    state gt { to do_gt when (c == '>')  to bang }
    state do_gt {
        adv()
        to gt_eq when (cbyte() == '=')
        return 1
    }
    state gt_eq { adv()  return 5 }
    state bang { to do_bang when (c == '!')  to eq }
    state do_bang { adv()  adv()  return 3 }           ; '!='
    state eq { to do_eq when (c == '=')  return 0 - 1 }
    state do_eq {
        let i = word[2097144]
        to eq_eq when (byte[2097152 + i + 1] == '=')
        return 0 - 1
    }
    state eq_eq { adv()  adv()  return 2 }
}

; r0 = right operand; pop left into r0 (right into r1), branch-materialize 0/1.
proc emit_cmp(code) {
    emit("mov r1,r0\n")
    emit("load r0,r15\n")
    emit("imm r5,8\n")
    emit("add r15,r5\n")
    let set = new_label()
    let done = new_label()
    state c0 { to do_c0 when (code == 0)  to c1 }
    state do_c0 { emit("jlt r0,r1,")  to after }
    state c1 { to do_c1 when (code == 1)  to c2 }
    state do_c1 { emit("jlt r1,r0,")  to after }
    state c2 { to do_c2 when (code == 2)  to c3 }
    state do_c2 { emit("jeq r0,r1,")  to after }
    state c3 { to do_c3 when (code == 3)  to c4 }
    state do_c3 { emit("jeq r0,r1,")  to after }
    state c4 { to do_c4 when (code == 4)  to c5 }
    state do_c4 { emit("jlt r1,r0,")  to after }
    state c5 { to do_c5 when (code == 5)  to after }
    state do_c5 { emit("jlt r0,r1,")  to after }
    state after {
        emit_lref(set)
        emit("\n")
        to fall_lt when (code < 3)
        emit("imm r0,1\n")
        to jmp_done
    }
    state fall_lt { emit("imm r0,0\n")  to jmp_done }   ; fall-through value
    state jmp_done {
        emit("jmp ")
        emit_lref(done)
        emit("\n")
        emit_lref(set)
        emit(":\n")
        to set_lt when (code < 3)
        emit("imm r0,0\n")
        to fin
    }
    state set_lt { emit("imm r0,1\n")  to fin }         ; branch-taken value
    state fin {
        emit_lref(done)
        emit(":\n")
        return 0
    }
}

proc gen_expr() {
    let depth = word[2097080]
    state room { to enter when (depth < 64)  word[2097072] = 252  return 0 }
    state enter {
        word[2097080] = depth + 1
        to generate
    }
    state generate {
    gen_sum()
    skip_ws()
    let code = cmp_op()
        to do_cmp when (code >= 0)
        word[2097080] = word[2097080] - 1
        return 0
    }
    state do_cmp {
        emit_push()
        gen_sum()
        emit_cmp(code)
        word[2097080] = word[2097080] - 1
        return 0
    }
}

; ---------------- statements ----------------

proc gen_stmts() {               ; parse statements until '}', consume the '}'
    let depth = word[2097064]
    state room { to enter when (depth < 64)  word[2097072] = 252  return 0 }
    state enter {
        word[2097064] = depth + 1
        skip_ws()
        to loop
    }
    state loop {
        to exhausted when (word[2097072] != 0)
        to body when (cbyte() != '}')
        adv()
        word[2097064] = word[2097064] - 1
        return 0
    }
    state body {
        to eof when (cbyte() == 0)
        gen_stmt()
        skip_ws()
        to loop
    }
    state eof { word[2097064] = word[2097064] - 1  return 0 }
    state exhausted { word[2097064] = word[2097064] - 1  return 0 }
}

proc gen_block() {               ; { statements }
    expect('{')
    gen_stmts()
    return 0
}

; emit a CFG state label  <curproc>__<name>  (curproc saved at 2097096/2097088)
proc emit_state_label(noff, nlen) {
    emit_ident_at(word[2097096], word[2097088])
    emit("__")
    emit_ident_at(noff, nlen)
    return 0
}

proc gen_state() {           ; (state) NAME { stmts } — a basic block: a label + body
    skip_ws()
    read_ident()             ; the state name
    let noff = word[2097120]
    let nlen = word[2097112]
    emit_state_label(noff, nlen)
    emit(":\n")
    gen_block()              ; { stmts }
    return 0
}

proc gen_to() {              ; (to) NAME [when EXPR] — a transition (jmp / guarded jmp)
    skip_ws()
    read_ident()             ; target state name
    let noff = word[2097120]
    let nlen = word[2097112]
    skip_ws()
    let save = word[2097144] ; lookahead-with-restore: is the next token `when`?
    read_ident()
    state whenchk { to guarded when (is_when() == 1)  to plain }
    state guarded {
        gen_expr()           ; guard -> r0
        let skipl = new_label()
        emit("jz r0,")
        emit_lref(skipl)
        emit("\n")
        emit("jmp ")
        emit_state_label(noff, nlen)
        emit("\n")
        emit_lref(skipl)
        emit(":\n")
        return 0
    }
    state plain {
        word[2097144] = save ; not a guard — that ident belongs to the next statement
        emit("jmp ")
        emit_state_label(noff, nlen)
        emit("\n")
        return 0
    }
}

proc gen_stmt() {
    skip_ws()
    read_ident()                 ; let / return / if / while / state / to / an lvalue
    let slot = 0                 ; one declaration (Beta locals are function-scoped)
    state k_let { to do_let when (is_let() == 1)  to k_return }
    state do_let {
        skip_ws()
        read_ident()             ; the new local's name
        slot = declare()
        to letfailed when (word[2097072] != 0)
        expect('=')
        gen_expr()
        emit_store_slot(slot)
        return 0
    }
    state letfailed { return 0 }
    state k_return { to do_return when (is_return() == 1)  to k_state }
    state do_return { gen_expr()  emit_epilogue()  return 0 }
    state k_state { to do_state when (is_state() == 1)  to k_to }
    state do_state { gen_state()  return 0 }
    state k_to { to do_to when (is_to() == 1)  to k_byte }
    state do_to { gen_to()  return 0 }
    state k_byte { to do_byte when (is_byte() == 1)  to k_word }
    state do_byte { gen_store(1)  return 0 }     ; byte[addr] = val
    state k_word { to do_word when (is_word() == 1)  to assign }
    state do_word { gen_store(8)  return 0 }     ; word[addr] = val
    state assign {
        skip_ws()
        to docall when (cbyte() == '(')          ; call statement
        slot = lookup()                          ; assignment target
        expect('=')
        gen_expr()
        emit_store_slot(slot)
        return 0
    }
    state docall { gen_call()  return 0 }
}

proc parse_proc() {
    word[2097128] = 0            ; NLOC = 0 (locals are per-proc)
    skip_ws()
    read_ident()                 ; "proc"
    skip_ws()
    read_ident()                 ; the proc name
    let nameoff = word[2097120]  ; save it (param/let parsing clobbers IDOFF/IDLEN)
    let namelen = word[2097112]
    word[2097096] = nameoff      ; CURPROC name, for emitting <proc>__<state> labels
    word[2097088] = namelen
    expect('(')                  ; parameters -> slots 0..nparams-1
    skip_ws()
    state ploop {
        to pbody when (cbyte() != ')')
        to pdone
    }
    state pbody {
        to paramroom when (word[2097128] < 4)
        word[2097072] = 252
        return 0
    }
    state paramroom {
        read_ident()
        declare()
        to paramfailed when (word[2097072] != 0)
        skip_ws()
        to pcomma when (cbyte() == ',')
        to ploop
    }
    state paramfailed { return 0 }
    state pcomma { adv()  skip_ws()  to ploop }
    state pdone {
        adv()                    ; consume ')'
        let nparams = word[2097128]  ; NLOC after the params
        expect('{')
        let nslots = nparams + count_lets()
        to slotsready when (nslots <= 1024)
        word[2097072] = 252
        return 0
    }
    state slotsready {
        emit_ident_at(nameoff, namelen)
        emit(":\n")
        emit_proc_prologue(nslots)
        let k = 0
        to sloop
    }
    state sloop {
        to sbody when (k < nparams)
        to genbody
    }
    state sbody { emit_param_store(k)  k = k + 1  to sloop }
    state genbody {
        gen_stmts()              ; body (consumes the closing '}')
        emit_epilogue()          ; fall-through tear-down (matches on-ramp)
        return 0
    }
}

proc main() {
    let storage_ok = slurp()
    state storage { to ready when (storage_ok == 1)  return 253 }
    state ready {
        emit_prelude()
        emit_write_str()         ; the emit() helper (after halt; harmless if unused)
        skip_ws()
        to loop
    }
    state loop {
        to body when (cbyte() != 0)
        return 0
    }
    state body {
        parse_proc()
        to resource when (word[2097072] != 0)
        skip_ws()
        to loop
    }
    state resource { return word[2097072] }
}
