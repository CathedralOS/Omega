; bc-alpha.alpha — Alpha-written cold-start compiler for Beta Slices A-C.
;
; Accepted source:
;   proc IDENT(PARAMS) { STATEMENT* }
;   STATEMENT := 'let' IDENT '=' EXPR | IDENT '=' EXPR | 'return' EXPR
;              | 'state' IDENT '{' STATEMENT* '}'
;              | 'to' IDENT ('when' EXPR)?
;   EXPR := SUM (('<'|'>'|'=='|'!='|'<='|'>=') SUM)?
;   SUM := TERM (('+' | '-') TERM)*
;   TERM := FACTOR (('*' | '/' | '%') FACTOR)*
;   FACTOR := DECIMAL | CHAR | IDENT | IDENT(ARGS) | '(' EXPR ')'
;
; Whitespace and `;` line comments are accepted between tokens. Decimal
; literals are deliberately capped at nine digits in this first slice. Character
; literals accept printable bytes plus \n \t \r \0 \\ \'. The whole source is
; validated before any output is published.
;
; Globals (i64):
;   524288 LEN       524296 CUR       524304 ERROR     524312 EMIT
;   524320 NAMESTART 524328 NAMELEN   524336 EXPECT    524344 EXPECTLEN
;   524352 BOUNDARY  524360 EXPECTCHR 524368 NUMSTART  524376 NUMLEN
;   524384 STAGE     524392 DEPTH     524400 OUTLEN     524408 PROC_COUNT
;   524416 CALL_COUNT 524424 SLOT_COUNT 524432 CURPROCSTART
;   524440 CURPROCLEN 524448 CURPROCINDEX 524456 ARGCOUNT
;   524464 TMPSTART  524472 TMPLEN     524480 PROC_CURSOR
;   524488 TARGET_SLOT/scan flag      524496 SCAN
;   524504 CMPLEN    524536 LABEL_COUNT
;   524544 LABEL_A   524552 LABEL_B   524560 INVERT
;   524568 STATE_COUNT 524576 EDGE_COUNT 524584 ASSIGN_SLOT
;   524592 PROC_STATE_COUNT 524600 PROC_EDGE_COUNT
;   524608 STATE_CURSOR 524616 EDGE_CURSOR 524624 CALL_CURSOR
; Buffers:
;   1048576 SOURCE (1048576-byte checked compiler extent)
;   2097152 decimal output scratch
;   540000 PROC_TABLE (128 x 32: start, len, params, slots)
;   550000 CALL_TABLE (512 x 24: start, len, argc)
;   600000 SLOT_TABLE (64 x 16: start, len)
;   610000 NAME_STACK (64 x 24: start, len, argc)
;   620000 CMP_STACK (65 x 8: comparison opcode at depths 0..64)
;   630000 STATE_TABLE (512 x 24: start, len, proc index)
;   680000 EDGE_TABLE (512 x 24: start, len, proc index)

; ---------------- entry and checked slurp ----------------
        imm   r6, 0
read_source:
        read  r0
        imm   r1, 0
        jlt   r0, r1, source_done
        imm   r1, 1048576
        jeq   r6, r1, source_too_large
        imm   r2, 1048576
        add   r2, r6
        storeb r2, r0
        imm   r1, 1
        add   r6, r1
        jmp   read_source
source_done:
        imm   r0, 524288
        store r0, r6
        imm   r0, 524296
        imm   r1, 0
        store r0, r1
        imm   r0, 524304
        store r0, r1
        imm   r0, 524312
        store r0, r1
        imm   r0, 524392
        store r0, r1
        imm   r0, 524400
        store r0, r1
        imm   r0, 524408
        store r0, r1
        imm   r0, 524416
        store r0, r1
        imm   r0, 524568
        store r0, r1
        imm   r0, 524576
        store r0, r1
        call  parse_program
        imm   r0, 524304
        load  r0, r0
        jnz   r0, invalid_source

        ; The same parser runs again with publication enabled. The first pass
        ; proved that this pass cannot discover a source error after output.
        imm   r0, 524296
        imm   r1, 0
        store r0, r1
        imm   r0, 524312
        imm   r1, 1
        store r0, r1
        call  parse_program
        imm   r0, 524304
        load  r0, r0
        jnz   r0, internal_error
        imm   r0, 0
        halt  r0
source_too_large:
        imm   r0, 2
        halt  r0
invalid_source:
        halt  r0
internal_error:
        imm   r0, 3
        halt  r0

; ---------------- program ----------------
parse_program:
        imm   r0, 524384
        imm   r1, 10
        store r0, r1
        imm   r0, 524480
        imm   r1, 0
        store r0, r1
        imm   r0, 524536
        store r0, r1
        imm   r0, 524608
        store r0, r1
        imm   r0, 524616
        store r0, r1
        imm   r0, 524624
        store r0, r1
        imm   r0, out_program_prelude
        imm   r1, 50
        call  emit_fixed
pp_loop:
        call  skip_trivia
        imm   r0, 524296
        load  r1, r0
        imm   r0, 524288
        load  r2, r0
        jeq   r1, r2, pp_finish
        call  parse_proc
        call  error_value
        jnz   r0, pp_return
        jmp   pp_loop
pp_finish:
        imm   r0, 524312
        load  r0, r0
        jnz   r0, pp_check_publication
        call  validate_program
        ret
pp_check_publication:
        call  check_publication_tables
pp_return:
        ret

parse_proc:
        imm   r0, 524384
        imm   r1, 11
        store r0, r1
        imm   r0, kw_proc
        imm   r1, 4
        imm   r2, 1
        call  expect_literal
        call  error_value
        jnz   r0, ppr_return
        call  parse_identifier
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524320
        load  r1, r0
        imm   r0, 524432
        store r0, r1
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524440
        store r0, r1
        imm   r0, 40
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524424
        imm   r1, 0
        store r0, r1
        imm   r0, 524592
        store r0, r1
        imm   r0, 524600
        store r0, r1
        call  peek_token_char
        imm   r1, 41
        jeq   r0, r1, ppr_params_done
ppr_param_loop:
        call  parse_identifier
        call  error_value
        jnz   r0, ppr_return
        call  declare_name
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524424
        load  r0, r0
        imm   r1, 4
        jlt   r1, r0, ppr_error
        call  peek_token_char
        imm   r1, 44
        jeq   r0, r1, ppr_more_param
        jmp   ppr_params_done
ppr_more_param:
        call  consume_one
        jmp   ppr_param_loop
ppr_params_done:
        imm   r0, 41
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ppr_known_proc
        call  add_proc
        jmp   ppr_proc_ready
ppr_known_proc:
        call  select_proc
ppr_proc_ready:
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 123
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524312
        load  r0, r0
        jz    r0, ppr_body
        call  emit_proc_header
ppr_body:
        call  peek_token_char
        imm   r1, 125
        jeq   r0, r1, ppr_body_done
        call  parse_statement
        call  error_value
        jnz   r0, ppr_return
        jmp   ppr_body
ppr_body_done:
        imm   r0, 125
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ppr_check_slots
        call  finish_proc
        call  emit_proc_header
        jmp   ppr_epilogue
ppr_check_slots:
        call  check_proc_slots
        call  error_value
        jnz   r0, ppr_return
ppr_epilogue:
        imm   r0, out_epilogue
        imm   r1, 50
        call  emit_fixed
        imm   r0, 524480
        load  r1, r0
        imm   r2, 1
        add   r1, r2
        store r0, r1
ppr_return:
        ret
ppr_error:
        call  set_error
        ret

; ---------------- statements ----------------
parse_statement:
        imm   r0, 524384
        imm   r1, 15
        store r0, r1
        imm   r0, kw_return
        imm   r1, 6
        call  match_literal
        jnz   r0, ps_return_stmt
        imm   r0, kw_let
        imm   r1, 3
        call  match_literal
        jnz   r0, ps_let
        imm   r0, kw_state
        imm   r1, 5
        call  match_literal
        jnz   r0, ps_state
        imm   r0, kw_to
        imm   r1, 2
        call  match_literal
        jnz   r0, ps_to
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        call  lookup_name
        imm   r1, 524584
        store r1, r0
        call  error_value
        jnz   r0, ps_done
        imm   r0, 61
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524584
        load  r0, r0
        call  emit_store_slot
        ret
ps_let:
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524320
        load  r1, r0
        imm   r0, 524464
        store r0, r1
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524472
        store r0, r1
        imm   r0, 61
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524464
        load  r1, r0
        imm   r0, 524320
        store r0, r1
        imm   r0, 524472
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        call  declare_name
        imm   r1, 524488
        store r1, r0
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524488
        load  r0, r0
        call  emit_store_slot
        ret
ps_return_stmt:
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, out_epilogue
        imm   r1, 50
        call  emit_fixed
        ret
ps_state:
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ps_state_select
        call  add_state
        jmp   ps_state_checked
ps_state_select:
        call  select_state
ps_state_checked:
        call  error_value
        jnz   r0, ps_done
ps_state_emit:
        call  emit_state_label
        imm   r0, 123
        call  expect_char
        call  error_value
        jnz   r0, ps_done
ps_state_body:
        call  peek_token_char
        imm   r1, 125
        jeq   r0, r1, ps_state_done
        call  parse_statement
        call  error_value
        jnz   r0, ps_done
        jmp   ps_state_body
ps_state_done:
        imm   r0, 125
        call  expect_char
        ret
ps_to:
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524320
        load  r1, r0
        imm   r0, 524464
        store r0, r1
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524472
        store r0, r1
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ps_to_select
        call  add_edge
        jmp   ps_to_checked
ps_to_select:
        call  select_edge
ps_to_checked:
        call  error_value
        jnz   r0, ps_done
ps_to_guard:
        imm   r0, kw_when
        imm   r1, 4
        call  match_literal
        jnz   r0, ps_to_when
        call  restore_tmp_name
        call  emit_jump_target
        ret
ps_to_when:
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        call  restore_tmp_name
        call  emit_guarded_target
ps_done:
        ret

; ---------------- expression parser and Alpha lowering ----------------
parse_expr:
        call  parse_sum
        call  error_value
        jnz   r0, px_return
        call  peek_token_char
        imm   r1, 60
        jeq   r0, r1, px_lt
        imm   r1, 62
        jeq   r0, r1, px_gt
        imm   r1, 61
        jeq   r0, r1, px_eq
        imm   r1, 33
        jeq   r0, r1, px_ne
        ret
px_lt:
        call  consume_one
        call  peek_raw_char
        imm   r1, 61
        jeq   r0, r1, px_le
        imm   r6, 0
        jmp   px_right
px_le:
        call  consume_one
        imm   r6, 4
        jmp   px_right
px_gt:
        call  consume_one
        call  peek_raw_char
        imm   r1, 61
        jeq   r0, r1, px_ge
        imm   r6, 1
        jmp   px_right
px_ge:
        call  consume_one
        imm   r6, 5
        jmp   px_right
px_eq:
        call  consume_one
        imm   r0, 61
        call  expect_raw_char
        call  error_value
        jnz   r0, px_return
        imm   r6, 2
        jmp   px_right
px_ne:
        call  consume_one
        imm   r0, 61
        call  expect_raw_char
        call  error_value
        jnz   r0, px_return
        imm   r6, 3
px_right:
        mov   r7, r6
        imm   r0, 524392
        load  r6, r0
        imm   r0, 8
        mul   r0, r6
        imm   r1, 620000
        add   r0, r1
        store r0, r7
        call  emit_push
        call  parse_sum
        call  error_value
        jnz   r0, px_return
        call  emit_comparison
px_return:
        ret

parse_sum:
        call  parse_term
        call  error_value
        jnz   r0, pe_return
pe_loop:
        call  peek_token_char
        imm   r1, 43
        jeq   r0, r1, pe_add
        imm   r1, 45
        jeq   r0, r1, pe_sub
        ret
pe_add:
        call  consume_one
        call  emit_push
        call  parse_term
        call  error_value
        jnz   r0, pe_return
        imm   r0, out_pop_add
        imm   r1, 53
        call  emit_fixed
        jmp   pe_loop
pe_sub:
        call  consume_one
        call  emit_push
        call  parse_term
        call  error_value
        jnz   r0, pe_return
        imm   r0, out_pop_sub
        imm   r1, 53
        call  emit_fixed
        jmp   pe_loop
pe_return:
        ret

parse_term:
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
pt_loop:
        call  peek_token_char
        imm   r1, 42
        jeq   r0, r1, pt_mul
        imm   r1, 47
        jeq   r0, r1, pt_div
        imm   r1, 37
        jeq   r0, r1, pt_mod
        ret
pt_mul:
        call  consume_one
        call  emit_push
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
        imm   r0, out_pop_mul
        imm   r1, 53
        call  emit_fixed
        jmp   pt_loop
pt_div:
        call  consume_one
        call  emit_push
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
        imm   r0, out_pop_div
        imm   r1, 53
        call  emit_fixed
        jmp   pt_loop
pt_mod:
        call  consume_one
        call  emit_push
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
        imm   r0, out_pop_mod
        imm   r1, 53
        call  emit_fixed
        jmp   pt_loop
pt_return:
        ret

parse_factor:
        call  peek_token_char
        imm   r1, 40
        jeq   r0, r1, pf_paren
        imm   r1, 39
        jeq   r0, r1, pf_char
        imm   r1, 48
        jlt   r0, r1, pf_error
        imm   r1, 58
        jlt   r0, r1, pf_decimal
        call  is_ident_start
        imm   r1, 1
        jeq   r0, r1, pf_identifier
        jmp   pf_error
pf_paren:
        call  consume_one
        imm   r0, 524392
        load  r1, r0
        imm   r2, 64
        jeq   r1, r2, pf_error
        imm   r2, 1
        add   r1, r2
        store r0, r1
        call  parse_expr
        imm   r0, 524392
        load  r1, r0
        imm   r2, 1
        sub   r1, r2
        store r0, r1
        call  error_value
        jnz   r0, pf_return
        imm   r0, 41
        call  expect_char
        ret
pf_char:
        call  parse_character
        ret
pf_decimal:
        call  parse_decimal
        ret
pf_identifier:
        call  parse_identifier
        call  error_value
        jnz   r0, pf_return
        call  peek_token_char
        imm   r1, 40
        jeq   r0, r1, pf_call
        call  lookup_name
        imm   r1, 524488
        store r1, r0
        call  error_value
        jnz   r0, pf_return
        imm   r0, 524488
        load  r0, r0
        call  emit_load_slot
        ret
pf_call:
        call  push_call_name
        call  error_value
        jnz   r0, pf_return
        call  consume_one
        call  peek_token_char
        imm   r1, 41
        jeq   r0, r1, pf_call_done
pf_arg_loop:
        call  parse_expr
        call  error_value
        jnz   r0, pf_return
        call  emit_push
        call  increment_call_arg
        call  error_value
        jnz   r0, pf_return
        call  peek_token_char
        imm   r1, 44
        jeq   r0, r1, pf_more_arg
        jmp   pf_call_done
pf_more_arg:
        call  consume_one
        jmp   pf_arg_loop
pf_call_done:
        imm   r0, 41
        call  expect_char
        call  error_value
        jnz   r0, pf_return
        call  finish_call
        ret
pf_error:
        call  set_error
pf_return:
        ret

emit_push:
        imm   r0, out_push
        imm   r1, 34
        call  emit_fixed
        ret

; Input r0=slot. Emit a frame-slot load into r0.
emit_load_slot:
        mov   r7, r0
        imm   r0, out_load_slot_a
        imm   r1, 18
        call  emit_fixed
        imm   r0, 8
        imm   r1, 8
        mul   r1, r7
        add   r0, r1
        call  emit_unsigned
        imm   r0, out_load_slot_b
        imm   r1, 22
        call  emit_fixed
        ret

; Input r0=slot. The generated expression result remains in runtime r0.
emit_store_slot:
        mov   r7, r0
        imm   r0, out_store_slot_a
        imm   r1, 19
        call  emit_fixed
        imm   r0, 8
        imm   r1, 8
        mul   r1, r7
        add   r0, r1
        call  emit_unsigned
        imm   r0, out_store_slot_b
        imm   r1, 23
        call  emit_fixed
        ret

restore_tmp_name:
        imm   r0, 524464
        load  r1, r0
        imm   r0, 524320
        store r0, r1
        imm   r0, 524472
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        ret

; Emit `$S<procedure-index>$<NAME>`. `$` is impossible in a Beta identifier,
; so scoped state labels cannot collide with any user-authored label.
emit_scoped_ref:
        imm   r0, out_state_prefix
        imm   r1, 2
        call  emit_fixed
        imm   r0, 524448
        load  r0, r0
        call  emit_unsigned
        imm   r0, out_scope_sep
        imm   r1, 1
        call  emit_fixed
        imm   r0, 524320
        load  r0, r0
        imm   r1, 524328
        load  r1, r1
        call  emit_span
        ret

emit_state_label:
        call  emit_scoped_ref
        imm   r0, out_label_suffix
        imm   r1, 2
        call  emit_fixed
        ret

emit_jump_target:
        imm   r0, out_jump
        imm   r1, 4
        call  emit_fixed
        call  emit_scoped_ref
        imm   r0, out_newline
        imm   r1, 1
        call  emit_fixed
        ret

emit_guarded_target:
        imm   r0, 524536
        load  r6, r0
        imm   r0, 524544
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, out_guard_false
        imm   r1, 6
        call  emit_fixed
        imm   r0, 524544
        load  r0, r0
        call  emit_internal_ref
        imm   r0, out_newline
        imm   r1, 1
        call  emit_fixed
        call  emit_jump_target
        imm   r0, 524544
        load  r0, r0
        call  emit_internal_ref
        imm   r0, out_label_suffix
        imm   r1, 2
        call  emit_fixed
        ret

; Emit the reserved, Beta-unspellable Alpha label `$L<decimal>`.
emit_internal_ref:
        mov   r7, r0
        imm   r0, out_internal_prefix
        imm   r1, 2
        call  emit_fixed
        mov   r0, r7
        call  emit_unsigned
        ret

emit_comparison:
        imm   r0, out_cmp_pop
        imm   r1, 33
        call  emit_fixed
        imm   r0, 524536
        load  r6, r0
        imm   r0, 524544
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524552
        store r0, r6
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 524560
        imm   r1, 0
        store r0, r1
        imm   r0, 524392
        load  r6, r0
        imm   r0, 8
        mul   r0, r6
        imm   r1, 620000
        add   r0, r1
        load  r6, r0
        imm   r0, 0
        jeq   r6, r0, ecmp_lt
        imm   r0, 1
        jeq   r6, r0, ecmp_gt
        imm   r0, 2
        jeq   r6, r0, ecmp_eq
        imm   r0, 3
        jeq   r6, r0, ecmp_ne
        imm   r0, 4
        jeq   r6, r0, ecmp_le
        jmp   ecmp_ge
ecmp_lt:
        imm   r0, out_cmp_lt
        imm   r1, 10
        call  emit_fixed
        jmp   ecmp_branch_done
ecmp_gt:
        imm   r0, out_cmp_gt
        imm   r1, 10
        call  emit_fixed
        jmp   ecmp_branch_done
ecmp_eq:
        imm   r0, out_cmp_eq
        imm   r1, 10
        call  emit_fixed
        jmp   ecmp_branch_done
ecmp_ne:
        imm   r0, 524560
        imm   r1, 1
        store r0, r1
        imm   r0, out_cmp_eq
        imm   r1, 10
        call  emit_fixed
        jmp   ecmp_branch_done
ecmp_le:
        imm   r0, 524560
        imm   r1, 1
        store r0, r1
        imm   r0, out_cmp_gt
        imm   r1, 10
        call  emit_fixed
        jmp   ecmp_branch_done
ecmp_ge:
        imm   r0, 524560
        imm   r1, 1
        store r0, r1
        imm   r0, out_cmp_lt
        imm   r1, 10
        call  emit_fixed
ecmp_branch_done:
        imm   r0, 524544
        load  r0, r0
        call  emit_internal_ref
        imm   r0, out_newline
        imm   r1, 1
        call  emit_fixed
        imm   r0, 524560
        load  r0, r0
        jnz   r0, ecmp_inverted
        imm   r0, out_false_jump
        imm   r1, 13
        call  emit_fixed
        jmp   ecmp_fall_done
ecmp_inverted:
        imm   r0, out_true_jump
        imm   r1, 13
        call  emit_fixed
ecmp_fall_done:
        imm   r0, 524552
        load  r0, r0
        call  emit_internal_ref
        imm   r0, out_newline
        imm   r1, 1
        call  emit_fixed
        imm   r0, 524544
        load  r0, r0
        call  emit_internal_ref
        imm   r0, out_label_suffix
        imm   r1, 2
        call  emit_fixed
        imm   r0, 524560
        load  r0, r0
        jnz   r0, ecmp_hit_false
        imm   r0, out_imm_true
        imm   r1, 9
        call  emit_fixed
        jmp   ecmp_hit_done
ecmp_hit_false:
        imm   r0, out_imm_false
        imm   r1, 9
        call  emit_fixed
ecmp_hit_done:
        imm   r0, 524552
        load  r0, r0
        call  emit_internal_ref
        imm   r0, out_label_suffix
        imm   r1, 2
        call  emit_fixed
        ret

; ---------------- literals ----------------
parse_decimal:
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        imm   r7, 0
pd_loop:
        imm   r0, 524288
        load  r1, r0
        add   r1, r6
        add   r1, r7
        imm   r2, 1048576
        add   r2, r6
        add   r2, r7
        imm   r3, 524288
        load  r3, r3
        mov   r4, r6
        add   r4, r7
        jlt   r4, r3, pd_have
        jmp   pd_done
pd_have:
        loadb r5, r2
        imm   r0, 48
        jlt   r5, r0, pd_done
        imm   r0, 58
        jlt   r5, r0, pd_digit
        jmp   pd_done
pd_digit:
        imm   r0, 9
        jeq   r7, r0, pd_error
        imm   r0, 1
        add   r7, r0
        jmp   pd_loop
pd_done:
        imm   r0, 0
        jeq   r7, r0, pd_error
        imm   r0, 524296
        mov   r1, r6
        add   r1, r7
        store r0, r1
        imm   r0, 524368
        store r0, r6
        imm   r0, 524376
        store r0, r7
        imm   r0, out_imm_prefix
        imm   r1, 7
        call  emit_fixed
        imm   r0, 524368
        load  r0, r0
        imm   r1, 524376
        load  r1, r1
        call  emit_span
        ret
pd_error:
        call  set_error
        ret

parse_character:
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        imm   r0, 1
        add   r6, r0
        call  char_at_cursor
        mov   r7, r0
        call  error_value
        jnz   r0, pc_return
        imm   r1, 39
        jeq   r7, r1, pc_error
        imm   r1, 32
        jlt   r7, r1, pc_error
        imm   r1, 127
        jlt   r7, r1, pc_plain
        jmp   pc_error
pc_plain:
        imm   r1, 92
        jeq   r7, r1, pc_escape
        imm   r0, 1
        add   r6, r0
        jmp   pc_close
pc_escape:
        imm   r0, 1
        add   r6, r0
        call  char_at_cursor
        mov   r7, r0
        call  error_value
        jnz   r0, pc_return
        imm   r1, 110
        jeq   r7, r1, pc_newline
        imm   r1, 116
        jeq   r7, r1, pc_tab
        imm   r1, 114
        jeq   r7, r1, pc_cr
        imm   r1, 48
        jeq   r7, r1, pc_zero
        imm   r1, 92
        jeq   r7, r1, pc_escaped_ok
        imm   r1, 39
        jeq   r7, r1, pc_escaped_ok
        jmp   pc_error
pc_newline:
        imm   r7, 10
        jmp   pc_escaped_ok
pc_tab:
        imm   r7, 9
        jmp   pc_escaped_ok
pc_cr:
        imm   r7, 13
        jmp   pc_escaped_ok
pc_zero:
        imm   r7, 0
pc_escaped_ok:
        imm   r0, 1
        add   r6, r0
pc_close:
        call  char_at_cursor
        mov   r2, r0
        call  error_value
        jnz   r0, pc_return
        imm   r1, 39
        jeq   r2, r1, pc_closed
        jmp   pc_error
pc_closed:
        imm   r0, 1
        add   r6, r0
        imm   r0, 524296
        store r0, r6
        imm   r0, out_imm_prefix
        imm   r1, 7
        call  emit_fixed
        mov   r0, r7
        call  emit_unsigned
        ret
pc_error:
        call  set_error
pc_return:
        ret

; Input r6 is a source cursor. Return byte in r0 or set ERROR at EOF.
char_at_cursor:
        imm   r0, 524288
        load  r1, r0
        jlt   r6, r1, cac_have
        call  set_error
        imm   r0, 0
        ret
cac_have:
        imm   r0, 1048576
        add   r0, r6
        loadb r0, r0
        ret

; ---------------- bounded procedure, call, and local tables ----------------
load_current_proc_name:
        imm   r0, 524432
        load  r1, r0
        imm   r0, 524320
        store r0, r1
        imm   r0, 524440
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        ret

; r0 points at a record whose first two words are a source span. Compare it
; with NAMESTART/NAMELEN and return 1/0.
name_equals_record:
        mov   r5, r0
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524504
        store r0, r1
        imm   r2, 8
        add   r2, r5
        load  r2, r2
        jeq   r1, r2, ner_length_ok
        imm   r0, 0
        ret
ner_length_ok:
        imm   r6, 0
ner_loop:
        imm   r0, 524504
        load  r1, r0
        jlt   r6, r1, ner_byte
        imm   r0, 1
        ret
ner_byte:
        imm   r0, 524320
        load  r0, r0
        imm   r2, 1048576
        add   r0, r2
        add   r0, r6
        loadb r3, r0
        load  r0, r5
        add   r0, r2
        add   r0, r6
        loadb r4, r0
        jeq   r3, r4, ner_next
        imm   r0, 0
        ret
ner_next:
        imm   r0, 1
        add   r6, r0
        jmp   ner_loop

; Declare NAME in the current procedure. Return its zero-based frame slot.
declare_name:
        call  name_is_reserved
        jnz   r0, dn_error
        imm   r0, 524424
        load  r7, r0
        imm   r1, 64
        jeq   r7, r1, dn_error
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
dn_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, dn_compare
        jmp   dn_add
dn_compare:
        imm   r0, 16
        mul   r0, r6
        imm   r1, 600000
        add   r0, r1
        call  name_equals_record
        jnz   r0, dn_error
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   dn_scan
dn_add:
        imm   r0, 16
        mul   r0, r7
        imm   r1, 600000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r0, 524424
        imm   r1, 1
        add   r1, r7
        store r0, r1
        mov   r0, r7
        ret
dn_error:
        call  set_error
        ret

; Look up NAME in the current procedure. Return its frame slot.
lookup_name:
        imm   r0, 524424
        load  r7, r0
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ln_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, ln_compare
        call  set_error
        ret
ln_compare:
        imm   r0, 16
        mul   r0, r6
        imm   r1, 600000
        add   r0, r1
        call  name_equals_record
        jnz   r0, ln_found
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ln_scan
ln_found:
        imm   r0, 524496
        load  r0, r0
        ret

add_proc:
        call  load_current_proc_name
        call  name_is_reserved
        jnz   r0, ap_error
        imm   r0, 524408
        load  r7, r0
        imm   r1, 128
        jeq   r7, r1, ap_error
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ap_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, ap_compare
        jmp   ap_add
ap_compare:
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540000
        add   r0, r1
        call  name_equals_record
        jnz   r0, ap_error
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ap_scan
ap_add:
        imm   r0, 32
        mul   r0, r7
        imm   r1, 540000
        add   r0, r1
        imm   r1, 524432
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524440
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524424
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r2, 0
        store r0, r2
        imm   r0, 524448
        store r0, r7
        imm   r0, 524408
        imm   r1, 1
        add   r1, r7
        store r0, r1
        ret
ap_error:
        call  set_error
        ret

select_proc:
        call  load_current_proc_name
        imm   r0, 524480
        load  r6, r0
        imm   r0, 524408
        load  r7, r0
        jlt   r6, r7, sp_have
        jmp   sp_error
sp_have:
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540000
        add   r0, r1
        call  name_equals_record
        jz    r0, sp_error
        imm   r0, 524480
        load  r6, r0
        imm   r0, 524448
        store r0, r6
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540016
        add   r0, r1
        load  r1, r0
        imm   r0, 524424
        load  r2, r0
        jeq   r1, r2, sp_done
sp_error:
        call  set_error
sp_done:
        ret

finish_proc:
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540024
        add   r0, r1
        imm   r1, 524424
        load  r1, r1
        store r0, r1
        ret

emit_proc_header:
        imm   r0, 524432
        load  r0, r0
        imm   r1, 524440
        load  r1, r1
        call  emit_span
        imm   r0, out_proc_prologue
        imm   r1, 48
        call  emit_fixed
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540000
        mov   r7, r0
        add   r7, r1
        imm   r0, 24
        add   r0, r7
        load  r6, r0
        imm   r0, 0
        jeq   r6, r0, eph_params
        mov   r7, r6
        imm   r0, out_frame_a
        imm   r1, 7
        call  emit_fixed
        mov   r0, r7
        imm   r1, 8
        mul   r0, r1
        call  emit_unsigned
        imm   r0, out_frame_b
        imm   r1, 12
        call  emit_fixed
eph_params:
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540016
        add   r0, r1
        load  r6, r0
        imm   r0, 524456
        store r0, r6
        imm   r0, 0
        jeq   r6, r0, eph_done
        imm   r5, 0
eph_param_loop:
        imm   r0, 524456
        load  r6, r0
        jlt   r5, r6, eph_param
        ret
eph_param:
        imm   r0, out_param_a
        imm   r1, 18
        call  emit_fixed
        mov   r0, r5
        imm   r1, 8
        mul   r0, r1
        imm   r1, 8
        add   r0, r1
        call  emit_unsigned
        imm   r0, out_param_b
        imm   r1, 21
        call  emit_fixed
        mov   r0, r5
        call  emit_unsigned
        imm   r0, out_newline
        imm   r1, 1
        call  emit_fixed
        imm   r0, 1
        add   r5, r0
        jmp   eph_param_loop
eph_done:
        ret

check_proc_slots:
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540024
        add   r0, r1
        load  r1, r0
        imm   r0, 524424
        load  r2, r0
        jeq   r1, r2, cps_done
        call  set_error
cps_done:
        ret

; Save a possibly nested call name and its argument count at the expression
; depth. Parentheses and calls share the same checked depth budget.
push_call_name:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 64
        jeq   r6, r1, pcn_error
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r2, 0
        store r0, r2
        imm   r0, 524392
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
pcn_error:
        call  set_error
        ret

increment_call_arg:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610016
        add   r0, r1
        load  r2, r0
        imm   r1, 4
        jeq   r2, r1, ica_error
        imm   r1, 1
        add   r2, r1
        store r0, r2
        ret
ica_error:
        call  set_error
        ret

finish_call:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610000
        mov   r7, r0
        add   r7, r1
        imm   r0, 524312
        load  r0, r0
        jnz   r0, fc_select
        mov   r0, r7
        call  add_call
        jmp   fc_call_checked
fc_select:
        mov   r0, r7
        call  select_call
fc_call_checked:
        call  error_value
        jnz   r0, fc_return
fc_emit_args:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610000
        mov   r7, r0
        add   r7, r1
        imm   r0, 16
        add   r0, r7
        load  r6, r0
        imm   r0, 4
        jeq   r6, r0, fc_pop3
        imm   r0, 3
        jeq   r6, r0, fc_pop2
        imm   r0, 2
        jeq   r6, r0, fc_pop1
        imm   r0, 1
        jeq   r6, r0, fc_pop0
        jmp   fc_emit_call
fc_pop3:
        imm   r0, out_pop_r3
        imm   r1, 33
        call  emit_fixed
fc_pop2:
        imm   r0, out_pop_r2
        imm   r1, 33
        call  emit_fixed
fc_pop1:
        imm   r0, out_pop_r1
        imm   r1, 33
        call  emit_fixed
fc_pop0:
        imm   r0, out_pop_r0
        imm   r1, 33
        call  emit_fixed
fc_emit_call:
        imm   r0, out_call
        imm   r1, 5
        call  emit_fixed
        load  r0, r7
        imm   r1, 8
        add   r1, r7
        load  r1, r1
        call  emit_span
        imm   r0, out_newline
        imm   r1, 1
        call  emit_fixed
        imm   r0, 524392
        load  r1, r0
        imm   r2, 1
        sub   r1, r2
        store r0, r1
fc_return:
        ret

; r0 points at a NAME_STACK record.
add_call:
        mov   r5, r0
        imm   r0, 524416
        load  r6, r0
        imm   r1, 512
        jeq   r6, r1, ac_error
        imm   r0, 24
        mul   r0, r6
        imm   r1, 550000
        add   r0, r1
        load  r1, r5
        store r0, r1
        imm   r2, 8
        add   r0, r2
        mov   r1, r5
        add   r1, r2
        load  r1, r1
        store r0, r1
        add   r0, r2
        add   r5, r2
        add   r5, r2
        load  r1, r5
        store r0, r1
        imm   r0, 524416
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
ac_error:
        call  set_error
        ret

add_state:
        call  name_is_reserved
        jnz   r0, ast_error
        imm   r0, 524592
        load  r6, r0
        imm   r1, 64
        jeq   r6, r1, ast_error
        imm   r0, 524568
        load  r7, r0
        imm   r1, 512
        jeq   r7, r1, ast_error
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ast_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, ast_compare
        jmp   ast_add
ast_compare:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 630000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524448
        load  r2, r0
        jeq   r1, r2, ast_compare_name
        jmp   ast_next
ast_compare_name:
        mov   r0, r5
        call  name_equals_record
        jnz   r0, ast_error
ast_next:
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ast_scan
ast_add:
        imm   r0, 24
        mul   r0, r7
        imm   r1, 630000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524448
        load  r2, r1
        store r0, r2
        imm   r0, 524568
        imm   r1, 1
        add   r7, r1
        store r0, r7
        imm   r0, 524592
        load  r6, r0
        add   r6, r1
        store r0, r6
        ret
ast_error:
        call  set_error
        ret

add_edge:
        call  name_is_reserved
        jnz   r0, ae_error
        imm   r0, 524600
        load  r7, r0
        imm   r1, 64
        jeq   r7, r1, ae_error
        imm   r0, 524576
        load  r6, r0
        imm   r1, 512
        jeq   r6, r1, ae_error
        imm   r0, 24
        mul   r0, r6
        imm   r1, 680000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524448
        load  r2, r1
        store r0, r2
        imm   r0, 524576
        imm   r1, 1
        add   r6, r1
        store r0, r6
        imm   r0, 524600
        load  r7, r0
        add   r7, r1
        store r0, r7
        ret
ae_error:
        call  set_error
        ret

select_state:
        imm   r0, 524608
        load  r6, r0
        imm   r0, 524568
        load  r7, r0
        jlt   r6, r7, sst_have
        jmp   sst_error
sst_have:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 630000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524448
        load  r2, r0
        jeq   r1, r2, sst_name
        jmp   sst_error
sst_name:
        mov   r0, r5
        call  name_equals_record
        jz    r0, sst_error
        imm   r0, 524608
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
sst_error:
        call  set_error
        ret

select_edge:
        imm   r0, 524616
        load  r6, r0
        imm   r0, 524576
        load  r7, r0
        jlt   r6, r7, sed_have
        jmp   sed_error
sed_have:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 680000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524448
        load  r2, r0
        jeq   r1, r2, sed_name
        jmp   sed_error
sed_name:
        mov   r0, r5
        call  name_equals_record
        jz    r0, sed_error
        imm   r0, 524616
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
sed_error:
        call  set_error
        ret

; Input r0 points at the active NAME_STACK record.
select_call:
        mov   r5, r0
        load  r1, r5
        imm   r0, 524320
        store r0, r1
        imm   r0, 8
        add   r0, r5
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        imm   r0, 16
        add   r0, r5
        load  r1, r0
        imm   r0, 524456
        store r0, r1
        imm   r0, 524624
        load  r6, r0
        imm   r0, 524416
        load  r7, r0
        jlt   r6, r7, scl_have
        jmp   scl_error
scl_have:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 550000
        add   r0, r1
        mov   r5, r0
        call  name_equals_record
        jz    r0, scl_error
        imm   r0, 16
        add   r0, r5
        load  r1, r0
        imm   r0, 524456
        load  r2, r0
        jeq   r1, r2, scl_ok
        jmp   scl_error
scl_ok:
        imm   r0, 524624
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
scl_error:
        call  set_error
        ret

check_publication_tables:
        imm   r0, 524480
        load  r1, r0
        imm   r0, 524408
        load  r2, r0
        jeq   r1, r2, cpt_calls
        jmp   cpt_error
cpt_calls:
        imm   r0, 524624
        load  r1, r0
        imm   r0, 524416
        load  r2, r0
        jeq   r1, r2, cpt_states
        jmp   cpt_error
cpt_states:
        imm   r0, 524608
        load  r1, r0
        imm   r0, 524568
        load  r2, r0
        jeq   r1, r2, cpt_edges
        jmp   cpt_error
cpt_edges:
        imm   r0, 524616
        load  r1, r0
        imm   r0, 524576
        load  r2, r0
        jeq   r1, r2, cpt_done
cpt_error:
        call  set_error
cpt_done:
        ret

name_is_reserved:
        imm   r0, kw_proc
        imm   r1, 4
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_return
        imm   r1, 6
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_let
        imm   r1, 3
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_state
        imm   r1, 5
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_to
        imm   r1, 2
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_when
        imm   r1, 4
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_byte
        imm   r1, 4
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_word
        imm   r1, 4
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, kw_emit
        imm   r1, 4
        call  name_equals_literal
        jnz   r0, nir_yes
        imm   r0, 0
        ret
nir_yes:
        imm   r0, 1
        ret

validate_program:
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
        imm   r0, 524488
        store r0, r1
vp_main_loop:
        imm   r0, 524496
        load  r6, r0
        imm   r0, 524408
        load  r7, r0
        jlt   r6, r7, vp_main_check
        imm   r0, 524488
        load  r0, r0
        jz    r0, vp_error
        jmp   vp_calls_begin
vp_main_check:
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540000
        add   r0, r1
        mov   r5, r0
        load  r1, r5
        imm   r0, 524320
        store r0, r1
        imm   r0, 8
        add   r0, r5
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        imm   r0, kw_main
        imm   r1, 4
        call  name_equals_literal
        jz    r0, vp_main_next
        imm   r0, 524496
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540000
        mov   r5, r0
        add   r5, r1
        imm   r0, 16
        add   r0, r5
        load  r1, r0
        jnz   r1, vp_error
        imm   r0, 524488
        imm   r1, 1
        store r0, r1
vp_main_next:
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   vp_main_loop
vp_calls_begin:
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
vp_call_loop:
        imm   r0, 524496
        load  r6, r0
        imm   r0, 524416
        load  r7, r0
        jlt   r6, r7, vp_call_check
        jmp   ve_begin
vp_call_check:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 550000
        mov   r5, r0
        add   r5, r1
        load  r1, r5
        imm   r0, 524320
        store r0, r1
        imm   r0, 8
        add   r0, r5
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        imm   r0, 16
        add   r0, r5
        load  r1, r0
        imm   r0, 524456
        store r0, r1
        imm   r0, 524488
        imm   r1, 0
        store r0, r1
vp_target_loop:
        imm   r0, 524488
        load  r6, r0
        imm   r0, 524408
        load  r7, r0
        jlt   r6, r7, vp_target_check
        jmp   vp_error
vp_target_check:
        imm   r0, 32
        mul   r0, r6
        imm   r1, 540000
        add   r0, r1
        mov   r5, r0
        call  name_equals_record
        jz    r0, vp_target_next
        imm   r0, 16
        add   r0, r5
        load  r1, r0
        imm   r0, 524456
        load  r2, r0
        jeq   r1, r2, vp_call_valid
        jmp   vp_error
vp_target_next:
        imm   r0, 524488
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   vp_target_loop
vp_call_valid:
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   vp_call_loop
ve_begin:
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ve_loop:
        imm   r0, 524496
        load  r6, r0
        imm   r0, 524576
        load  r7, r0
        jlt   r6, r7, ve_check
        ret
ve_check:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 680000
        mov   r5, r0
        add   r5, r1
        load  r1, r5
        imm   r0, 524320
        store r0, r1
        imm   r0, 8
        add   r0, r5
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        imm   r0, 16
        add   r0, r5
        load  r1, r0
        imm   r0, 524456
        store r0, r1
        imm   r0, 524488
        imm   r1, 0
        store r0, r1
ve_state_loop:
        imm   r0, 524488
        load  r6, r0
        imm   r0, 524568
        load  r7, r0
        jlt   r6, r7, ve_state_check
        jmp   vp_error
ve_state_check:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 630000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524456
        load  r2, r0
        jeq   r1, r2, ve_state_name
        jmp   ve_state_next
ve_state_name:
        mov   r0, r5
        call  name_equals_record
        jnz   r0, ve_valid
ve_state_next:
        imm   r0, 524488
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ve_state_loop
ve_valid:
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ve_loop
vp_error:
        call  set_error
        ret

; ---------------- identifiers and token expectations ----------------
parse_identifier:
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        imm   r0, 524320
        store r0, r6
        call  source_char_at
        call  is_ident_start
        imm   r1, 1
        jeq   r0, r1, pi_started
        call  set_error
        ret
pi_started:
        imm   r7, 0
pi_loop:
        imm   r0, 524320
        load  r6, r0
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, pi_done
        call  is_ident_continue
        imm   r1, 1
        jeq   r0, r1, pi_more
        jmp   pi_done
pi_more:
        imm   r0, 64
        jeq   r7, r0, pi_error
        imm   r0, 1
        add   r7, r0
        jmp   pi_loop
pi_done:
        imm   r0, 524320
        load  r6, r0
        imm   r0, 524328
        store r0, r7
        imm   r0, 524296
        add   r6, r7
        store r0, r6
        ret
pi_error:
        call  set_error
        ret

; Inputs r0=fixed bytes and r1=length. Compare against NAMESTART/NAMELEN.
name_equals_literal:
        mov   r5, r0
        mov   r2, r1
        imm   r0, 524328
        load  r1, r0
        jeq   r1, r2, nel_compare
        imm   r0, 0
        ret
nel_compare:
        imm   r6, 0
nel_loop:
        jlt   r6, r2, nel_byte
        imm   r0, 1
        ret
nel_byte:
        imm   r0, 524320
        load  r0, r0
        imm   r1, 1048576
        add   r1, r0
        add   r1, r6
        loadb r3, r1
        mov   r1, r5
        add   r1, r6
        loadb r4, r1
        jeq   r3, r4, nel_next
        imm   r0, 0
        ret
nel_next:
        imm   r0, 1
        add   r6, r0
        jmp   nel_loop

; Inputs r0=literal address, r1=length. If it matches at the token cursor with
; an identifier boundary, consume it and return 1; otherwise return 0.
match_literal:
        imm   r3, 524336
        store r3, r0
        imm   r3, 524344
        store r3, r1
        call  skip_trivia
        imm   r3, 524296
        load  r6, r3
        imm   r7, 0
ml_loop:
        imm   r3, 524344
        load  r4, r3
        jlt   r7, r4, ml_compare
        jmp   ml_boundary
ml_compare:
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, ml_no
        mov   r5, r0
        imm   r3, 524336
        load  r3, r3
        add   r3, r7
        loadb r4, r3
        jeq   r5, r4, ml_next
        jmp   ml_no
ml_next:
        imm   r0, 1
        add   r7, r0
        jmp   ml_loop
ml_boundary:
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, ml_yes
        call  is_ident_continue
        imm   r1, 1
        jeq   r0, r1, ml_no
ml_yes:
        imm   r0, 524296
        load  r6, r0
        add   r6, r7
        store r0, r6
        imm   r0, 1
        ret
ml_no:
        imm   r0, 0
        ret

; Inputs r0=literal address, r1=length, r2=identifier-boundary flag.
expect_literal:
        imm   r3, 524336
        store r3, r0
        imm   r3, 524344
        store r3, r1
        imm   r3, 524352
        store r3, r2
        call  skip_trivia
        imm   r3, 524296
        load  r6, r3
        imm   r7, 0
el_loop:
        imm   r3, 524344
        load  r4, r3
        jlt   r7, r4, el_compare
        jmp   el_boundary
el_compare:
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, el_error
        mov   r5, r0
        imm   r3, 524336
        load  r3, r3
        add   r3, r7
        loadb r4, r3
        jeq   r5, r4, el_next
        jmp   el_error
el_next:
        imm   r0, 1
        add   r7, r0
        jmp   el_loop
el_boundary:
        imm   r3, 524352
        load  r3, r3
        imm   r4, 0
        jeq   r3, r4, el_commit
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, el_commit
        call  is_ident_continue
        imm   r1, 1
        jeq   r0, r1, el_error
el_commit:
        imm   r3, 524296
        load  r6, r3
        add   r6, r7
        imm   r0, 524296
        store r0, r6
        ret
el_error:
        call  set_error
        ret

expect_char:
        imm   r1, 524360
        store r1, r0
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, ec_error
        mov   r2, r0
        imm   r1, 524360
        load  r1, r1
        jeq   r2, r1, ec_ok
ec_error:
        call  set_error
        ret
ec_ok:
        imm   r0, 1
        add   r6, r0
        imm   r0, 524296
        store r0, r6
        ret

; ---------------- source cursor helpers ----------------
skip_trivia:
        imm   r0, 524296
        load  r6, r0
st_loop:
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, st_done
        mov   r7, r0
        imm   r1, 33
        jlt   r7, r1, st_advance
        imm   r1, 59
        jeq   r7, r1, st_comment
        jmp   st_done
st_advance:
        imm   r0, 1
        add   r6, r0
        jmp   st_loop
st_comment:
        imm   r0, 1
        add   r6, r0
st_comment_loop:
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, st_done
        imm   r1, 1
        add   r6, r1
        imm   r1, 10
        jeq   r0, r1, st_loop
        jmp   st_comment_loop
st_done:
        imm   r0, 524296
        store r0, r6
        ret

peek_token_char:
        call  skip_trivia
peek_raw_char:
        imm   r0, 524296
        load  r0, r0
        call  source_char_at_or_eof
        ret

; Input r0=required adjacent byte. Unlike expect_char, do not consume trivia.
expect_raw_char:
        imm   r1, 524360
        store r1, r0
        call  peek_raw_char
        mov   r2, r0
        imm   r1, 524360
        load  r1, r1
        jeq   r2, r1, erc_ok
        call  set_error
        ret
erc_ok:
        call  consume_one
        ret

consume_one:
        imm   r0, 524296
        load  r1, r0
        imm   r2, 1
        add   r1, r2
        store r0, r1
        ret

; r0=source offset; return byte or -1.
source_char_at_or_eof:
        mov   r6, r0
        imm   r1, 524288
        load  r1, r1
        jlt   r6, r1, scaoe_have
        imm   r0, 0
        imm   r1, 1
        sub   r0, r1
        ret
scaoe_have:
        imm   r0, 1048576
        add   r0, r6
        loadb r0, r0
        ret

; r6=source offset; return byte or set ERROR.
source_char_at:
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, sca_error
        ret
sca_error:
        call  set_error
        imm   r0, 0
        ret

is_ident_start:
        mov   r6, r0
        imm   r1, 95
        jeq   r6, r1, iis_yes
        imm   r1, 65
        jlt   r6, r1, iis_no
        imm   r1, 91
        jlt   r6, r1, iis_yes
        imm   r1, 97
        jlt   r6, r1, iis_no
        imm   r1, 123
        jlt   r6, r1, iis_yes
iis_no:
        imm   r0, 0
        ret
iis_yes:
        imm   r0, 1
        ret

is_ident_continue:
        mov   r6, r0
        call  is_ident_start
        imm   r1, 1
        jeq   r0, r1, iic_yes
        imm   r1, 48
        jlt   r6, r1, iic_no
        imm   r1, 58
        jlt   r6, r1, iic_yes
iic_no:
        imm   r0, 0
        ret
iic_yes:
        imm   r0, 1
        ret

; ---------------- output helpers ----------------
emit_fixed:
        imm   r2, 524312
        load  r2, r2
        imm   r3, 0
        jeq   r2, r3, ef_reserve
        imm   r6, 0
ef_loop:
        jlt   r6, r1, ef_byte
        ret
ef_byte:
        mov   r2, r0
        add   r2, r6
        loadb r3, r2
        write r3
        imm   r4, 1
        add   r6, r4
        jmp   ef_loop
ef_done:
        ret
ef_reserve:
        call  reserve_output
        ret

emit_span:
        imm   r2, 524312
        load  r2, r2
        imm   r3, 0
        jeq   r2, r3, es_reserve
        imm   r6, 0
es_loop:
        jlt   r6, r1, es_byte
        ret
es_byte:
        imm   r2, 1048576
        add   r2, r0
        add   r2, r6
        loadb r3, r2
        write r3
        imm   r4, 1
        add   r6, r4
        jmp   es_loop
es_done:
        ret
es_reserve:
        call  reserve_output
        ret

emit_unsigned:
        mov   r6, r0
        imm   r7, 0
        imm   r1, 0
        jeq   r6, r1, eu_zero
eu_digits:
        mov   r0, r6
        imm   r1, 10
        mod   r0, r1
        imm   r1, 48
        add   r0, r1
        imm   r2, 2097152
        add   r2, r7
        storeb r2, r0
        imm   r1, 10
        div   r6, r1
        imm   r1, 1
        add   r7, r1
        imm   r1, 0
        jeq   r6, r1, eu_write
        jmp   eu_digits
eu_zero:
        imm   r1, 524312
        load  r1, r1
        imm   r2, 0
        jeq   r1, r2, eu_reserve_one
        imm   r0, 48
        write r0
        ret
eu_write:
        imm   r1, 524312
        load  r1, r1
        imm   r2, 0
        jeq   r1, r2, eu_reserve_digits
eu_write_loop:
        imm   r1, 0
        jeq   r7, r1, eu_done
        imm   r1, 1
        sub   r7, r1
        imm   r2, 2097152
        add   r2, r7
        loadb r0, r2
        write r0
        jmp   eu_write_loop
eu_reserve_one:
        imm   r1, 1
        call  reserve_output
        ret
eu_reserve_digits:
        mov   r1, r7
        call  reserve_output
eu_done:
        ret

; Input r1=prospective byte count. Validation reserves against the Alpha
; assembler's 1 MiB source region before any output is published.
reserve_output:
        imm   r2, 1048576
        sub   r2, r1
        imm   r3, 524400
        load  r4, r3
        jlt   r2, r4, ro_error
        add   r4, r1
        store r3, r4
        ret
ro_error:
        call  set_error
        ret

set_error:
        imm   r0, 524304
        imm   r1, 524384
        load  r1, r1
        store r0, r1
        ret
error_value:
        imm   r0, 524304
        load  r0, r0
        ret

; ---------------- static output and keyword bytes ----------------
kw_proc:
        db "proc"
kw_return:
        db "return"
kw_let:
        db "let"
kw_state:
        db "state"
kw_to:
        db "to"
kw_when:
        db "when"
kw_byte:
        db "byte"
kw_word:
        db "word"
kw_emit:
        db "emit"
kw_main:
        db "main"
out_program_prelude:
        db "imm r15,1048576\nimm r14,1048576\ncall main\nhalt r0\n"
out_proc_prologue:
        db ":\nimm r5,8\nsub r15,r5\nstore r15,r14\nmov r14,r15\n"
out_frame_a:
        db "imm r5,"
out_frame_b:
        db "\nsub r15,r5\n"
out_param_a:
        db "mov r5,r14\nimm r4,"
out_param_b:
        db "\nsub r5,r4\nstore r5,r"
out_epilogue:
        db "\nmov r15,r14\nload r14,r15\nimm r2,8\nadd r15,r2\nret\n"
out_imm_prefix:
        db "imm r0,"
out_push:
        db "\nimm r1,8\nsub r15,r1\nstore r15,r0\n"
out_pop_add:
        db "\nload r1,r15\nimm r2,8\nadd r15,r2\nadd r1,r0\nmov r0,r1\n"
out_pop_sub:
        db "\nload r1,r15\nimm r2,8\nadd r15,r2\nsub r1,r0\nmov r0,r1\n"
out_pop_mul:
        db "\nload r1,r15\nimm r2,8\nadd r15,r2\nmul r1,r0\nmov r0,r1\n"
out_pop_div:
        db "\nload r1,r15\nimm r2,8\nadd r15,r2\ndiv r1,r0\nmov r0,r1\n"
out_pop_mod:
        db "\nload r1,r15\nimm r2,8\nadd r15,r2\nmod r1,r0\nmov r0,r1\n"
out_load_slot_a:
        db "mov r0,r14\nimm r1,"
out_load_slot_b:
        db "\nsub r0,r1\nload r0,r0\n"
out_store_slot_a:
        db "\nmov r1,r14\nimm r2,"
out_store_slot_b:
        db "\nsub r1,r2\nstore r1,r0\n"
out_pop_r3:
        db "\nload r3,r15\nimm r5,8\nadd r15,r5\n"
out_pop_r2:
        db "\nload r2,r15\nimm r5,8\nadd r15,r5\n"
out_pop_r1:
        db "\nload r1,r15\nimm r5,8\nadd r15,r5\n"
out_pop_r0:
        db "\nload r0,r15\nimm r5,8\nadd r15,r5\n"
out_call:
        db "call "
out_newline:
        db "\n"
out_internal_prefix:
        db "$L"
out_state_prefix:
        db "$S"
out_scope_sep:
        db "$"
out_label_suffix:
        db ":\n"
out_jump:
        db "jmp "
out_guard_false:
        db "jz r0,"
out_cmp_pop:
        db "\nload r1,r15\nimm r2,8\nadd r15,r2\n"
out_cmp_lt:
        db "jlt r1,r0,"
out_cmp_gt:
        db "jlt r0,r1,"
out_cmp_eq:
        db "jeq r1,r0,"
out_false_jump:
        db "imm r0,0\njmp "
out_true_jump:
        db "imm r0,1\njmp "
out_imm_false:
        db "imm r0,0\n"
out_imm_true:
        db "imm r0,1\n"
