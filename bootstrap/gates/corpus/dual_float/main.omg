// Dual float: f32 and f64 fields in the same data type.
//
// Exercises: a data struct with BOTH f32 and f64 fields, arithmetic on each,
// comparison guards, and a cross-width cast (f32 field -> f64 for comparison,
// then cast to i32 for the exit code).
//
// Data layout (tests that f32 and f64 can coexist in the same struct):
//   low: f32   -- 32-bit float
//   high: f64  -- 64-bit float
//   result: i32 -- integer result for the exit code check
//
// Computation:
//   low = 3.5    (f32)
//   high = 6.5   (f64)
//   sum_f32 = low + low = 7.0 (f32 arithmetic)
//   diff_f64 = high - 3.0 = 3.5 (f64 arithmetic)
//
//   We check:
//     sum_f32 > 6.9 && sum_f32 < 7.1   (f32 comparison)
//     diff_f64 > 3.4 && diff_f64 < 3.6 (f64 comparison)
//   Then compute result = 70 and exit.
//
// Expected exit: 70.

use omega::language::std::console;

data Floats [copy] {
    low: f32;
    high: f64;
    sum_f32: f32;
    diff_f64: f64;
    result: i32;
}

data Main {
    console: Console;
    f: Floats;
}

machine Main::main(&mut self) {
    // Assign the mixed-width float fields.
    self.f.low = 3.5;
    self.f.high = 6.5;

    // f32 arithmetic: low + low = 7.0
    self.f.sum_f32 = self.f.low + self.f.low;

    // f64 arithmetic: high - 3.0 = 3.5
    self.f.diff_f64 = self.f.high - 3.0;

    // Check sum_f32 is ~7.0.
    transition self.f.sum_f32 > 6.9 {
        true -> check_sum_upper()
        _ -> bad_sum_low()
    }

    state bad_sum_low(&mut self) { self.console.exit_process(71); }

    state check_sum_upper(&mut self) {
        transition self.f.sum_f32 < 7.1 {
            true -> check_diff_low()
            _ -> bad_sum_high()
        }
    }
    state bad_sum_high(&mut self) { self.console.exit_process(72); }

    // Check diff_f64 is ~3.5.
    state check_diff_low(&mut self) {
        transition self.f.diff_f64 > 3.4 {
            true -> check_diff_high()
            _ -> bad_diff_low()
        }
    }
    state bad_diff_low(&mut self) { self.console.exit_process(73); }

    state check_diff_high(&mut self) {
        transition self.f.diff_f64 < 3.6 {
            true -> store_result()
            _ -> bad_diff_high()
        }
    }
    state bad_diff_high(&mut self) { self.console.exit_process(74); }

    // All checks passed: encode exit 70.
    state store_result(&mut self) {
        self.f.result = 70;
        transition self.f.result == 70 {
            true -> good()
            _ -> bad_result()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad_result(&mut self) {
        self.console.exit_process(75);
    }
}
