use enemies::enemies;
use events::event_runtime;
use events::events;
use generation::dungeon_generator;
use inventory::items;
use combat::combat_round;
use player::player;
use player::player_state;
use rewards::rewards;
use rng::random;
use rng::random_state;
use rooms::map;
use rooms::room_lookup;
use rooms::rooms;

data Dungeon {
    generator: DungeonGenerator;
    events: EventRuntime;
    player_system: PlayerSystem;
    lookup: RoomLookup;
    rng: Random;

    current_cell: CellId;
    level: Level;
    navigation: Navigation;
    player: Player;
    random: RandomState;
    combat_round: CombatRound;
    mode: GameMode;
    treasure_taken: bool;
    gold_taken: bool;
    fountain_used: bool;
    enemy_defeated: bool;
}

machine Dungeon::enter_room(
    &mut self,
    cell: CellId
) {
    // Discovery is currently presentation-only for the generated sample. Avoid
    // dynamic room lookup here until slice-returned mutable references are solid.
}

machine Dungeon::use_event(
    &mut self,
    cell: CellId,
    line: &mut [u8; 128] in Utf8
)
ensures line in Utf8
{
    transition cell {
        CellId::R02 -> try_take_treasure(line)
        CellId::R04 -> try_use_fountain(line)
        CellId::R05 -> try_take_gold(line)
        _ -> no_usable_event(line)
    }

    state try_take_treasure(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        transition self.treasure_taken {
            false -> take_treasure(line)
            true -> no_usable_event(line)
        }
    }

    state take_treasure(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        self.player.inventory.gold = self.player.inventory.gold + 24;
        self.treasure_taken = true;
        line = "You take the treasure.";
    }

    state try_use_fountain(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        transition self.fountain_used {
            false -> use_fountain(line)
            true -> no_usable_event(line)
        }
    }

    state use_fountain(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        self.player.health = min(self.player.max_health, self.player.health + 12);
        self.fountain_used = true;
        line = "The fountain heals your wounds.";
    }

    state try_take_gold(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        transition self.gold_taken {
            false -> take_gold(line)
            true -> no_usable_event(line)
        }
    }

    state take_gold(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        self.player.inventory.gold = self.player.inventory.gold + 6;
        self.gold_taken = true;
        line = "You collect the loose gold.";
    }

    state no_usable_event(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        line = "There is nothing here to use.";
    }
}

machine Dungeon::fight(
    &mut self,
    cell: CellId,
    line: &mut [u8; 128] in Utf8
)
ensures line in Utf8
{
    transition cell {
        CellId::R03 -> try_defeat_enemy(line)
        _ -> no_enemy(line)
    }

    state try_defeat_enemy(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        transition self.enemy_defeated {
            false -> defeat_enemy(line)
            true -> no_enemy(line)
        }
    }

    state defeat_enemy(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        self.player.inventory.gold = self.player.inventory.gold + 6;
        self.player.xp = self.player.xp + 5;
        self.enemy_defeated = true;
        line = "The enemy collapses. You find a little gold.";
    }

    state no_enemy(
        &mut self,
        line: &mut [u8; 128] in Utf8
    ) {
        line = "There is no enemy here.";
    }
}

machine Dungeon::move(&mut self) {
    self.current_cell = self.navigation.destination;
}

machine Dungeon::move_to(
    &mut self,
    destination: CellId
) {
    self.current_cell = destination;
}

machine Dungeon::current_room_index(&mut self) -> u64 {
    self.room_index(self.current_cell)
}

machine Dungeon::can_travel_to(
    &mut self,
    destination: CellId
    ) -> bool {
    transition {
        destination == CellId::Empty -> false
        _ -> true
    }
}

machine Dungeon::evaluate_travel_block(
    &mut self,
    current_room: Room,
    destination_room: Room
) -> bool {
    transition {
        current_room.event.kind == RoomEventKind::Enemy && current_room.event.consumed == false -> self.gated_enemy_travel(current_room, destination_room)
        _ -> true
    }
}

machine Dungeon::gated_enemy_travel(
    &mut self,
    current_room: Room,
    destination_room: Room
) -> bool {
    transition {
        _ -> (destination_room.depth <= current_room.depth)
    }
}

machine Dungeon::game_over(&mut self) {
    self.mode = GameMode::GameOver;
}

machine Dungeon::initialize(
    &mut self,
    seed: u64 in Wrapping
) {
    self.player_system.create("Wanderer", &mut self.player);
    self.rng.seed(seed, &mut self.random);
    self.generator.generate(seed, &mut self.level);
    self.current_cell = self.level.start_cell;
    self.mode = GameMode::Exploring;
    self.treasure_taken = false;
    self.gold_taken = false;
    self.fountain_used = false;
    self.enemy_defeated = false;
}

machine Dungeon::room_index(
    &mut self,
    cell: CellId
    ) -> u64 {
    transition {
        cell == CellId::R00 -> 0
        cell == CellId::R01 -> 1
        cell == CellId::R02 -> 2
        cell == CellId::R03 -> 3
        cell == CellId::R04 -> 4
        cell == CellId::R05 -> 5
        cell == CellId::R06 -> 6
        cell == CellId::R07 -> 7
        cell == CellId::R08 -> 8
        cell == CellId::R09 -> 9
        cell == CellId::R10 -> 10
        cell == CellId::R11 -> 11
        cell == CellId::R12 -> 12
        cell == CellId::R13 -> 13
        cell == CellId::R14 -> 14
        _ -> 15
    }
}
