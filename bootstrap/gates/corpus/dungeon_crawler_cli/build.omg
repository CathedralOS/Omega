target cross_platform_cli {
    host: omega::host::standard {
        abi = target_default
        stdin = enabled
        stdout = enabled
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::standard
}

target macos_arm64 {
    host: omega::host::targets::darwin {
        abi = libSystem
        stdin = fd(0)
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::darwin
}

target linux_x64 {
    host: omega::host::targets::linux {
        abi = syscall
        stdin = fd(0)
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::linux
}

target linux_arm64 {
    host: omega::host::targets::linux {
        abi = syscall
        stdin = fd(0)
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::linux
}

target windows_x64 {
    host: omega::host::targets::windows {
        abi = win32
        stdin = standard_handle(stdin)
        stdout = standard_handle(stdout)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::windows
}

machine build(builder: &mut Build) {
    builder.application("dungeon-crawler-cli");
}
