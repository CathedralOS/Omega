// Parse a two-digit number out of its text form -- the core of reading numeric
// input. Each character byte is converted to its integer value with an explicit
// `as i32` cast (which zero-extends the u8 into an i32), then '0' (48) is subtracted
// to get the digit, and the digits are combined as `tens*10 + ones`. For "25" this
// yields 2*10 + 5 = 25. The arithmetic runs in a Trapping domain. (The `as i32` cast
// is required: a carrier byte is a u8, and widening to i32 is explicit.)
// Expected exit: 25.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 4]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    text: [u8; 4] in Utf8;
    tens: i32 in Trapping;
    ones: i32 in Trapping;
    value: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.text = "25";

    self.tens = self.text[0] as i32;
    self.tens = self.tens - 48;
    self.ones = self.text[1] as i32;
    self.ones = self.ones - 48;
    self.value = self.tens * 10 + self.ones;

    transition { _ -> done() }

    state done(&mut self) {
        self.console.exit_process(self.value);
    }
}
