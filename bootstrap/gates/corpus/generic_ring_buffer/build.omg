// Ring buffer sample build sketch. Needs only stdout + process.exit.

target cross_platform_cli {
    host: omega::host::standard {
        abi = target_default
        stdout = enabled
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::standard
}

target windows_x64 {
    host: omega::host::targets::windows {
        abi = win32
        stdout = standard_handle(stdout)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::windows
}

target linux_x64 {
    host: omega::host::targets::linux {
        abi = syscall
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::linux
}

machine build(builder: &mut Build) {
    builder.application("generic-ring-buffer");
}
