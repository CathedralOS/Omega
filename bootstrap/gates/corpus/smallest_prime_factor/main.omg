// Smallest prime factor by trial division. Walk d = 2, 3, 4, ... and return the
// first d that divides n; if d * d ever exceeds n with no divisor found, n is
// prime and is its own smallest factor. For n = 169 (= 13 * 13) the answer is 13:
// 2..12 leave a remainder, then 13 * 13 = 169 is not yet past n, and 169 % 13 == 0.
//
// The loop's two decisions both put ARITHMETIC directly in the transition guard:
// `d * d > n` (multiply) and `n % d == 0` (modulo). Modulo/division in a guard
// subject was wired in main 82822548 -- this sample exercises it in a real
// algorithm rather than a canary.
// Expected exit: 13.

use omega::language::std::console;

data Trial [copy] {
    n: i32;
    d: i32 in Trapping;
}

data Main {
    console: Console;
    trial: Trial;
}

machine Main::main(&mut self) {
    self.trial.n = 169;
    self.trial.d = 2;

    transition {
        _ -> probe()
    }

    // If d has passed sqrt(n) with no divisor found, n is prime.
    state probe(&mut self) {
        transition self.trial.d * self.trial.d > self.trial.n {
            true -> prime()
            _ -> test_divisor()
        }
    }

    // Does the current d divide n? (modulo in the guard subject)
    state test_divisor(&mut self) {
        transition self.trial.n % self.trial.d == 0 {
            true -> found()
            _ -> advance()
        }
    }

    state advance(&mut self) {
        self.trial.d = self.trial.d + 1;
        transition {
            _ -> probe()
        }
    }

    state found(&mut self) {
        self.console.exit_process(self.trial.d);
    }

    state prime(&mut self) {
        self.console.exit_process(self.trial.n);
    }
}
