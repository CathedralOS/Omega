// CLI MVP build sketch.
//
// Hello world needs only two host capabilities:
//
// - stdout.write_line: writes initialized UTF-8 bytes to process stdout.
// - process.exit: terminates the process with a target-specific exit code.
//
// Cross-platform providers map those contracts to OS calls:
//
// - Linux/macOS: write(1, bytes, len), then exit(code).
// - Windows: WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), bytes, len), then
//   ExitProcess(code).

target cross_platform_cli {
    host: omega::host::standard {
        abi = target_default
        stdout = enabled
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::standard
}

target linux_x64 {
    host: omega::host::targets::linux {
        abi = syscall
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::linux
}

target linux_arm64 {
    host: omega::host::targets::linux {
        abi = syscall
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::linux
}

target macos_arm64 {
    host: omega::host::targets::darwin {
        abi = libSystem
        stdout = fd(1)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::darwin
}

target windows_x64 {
    host: omega::host::targets::windows {
        abi = win32
        stdout = standard_handle(stdout)
        process = enabled
        filesystem = disabled
        threads = disabled
        clock = disabled
        random = disabled
    }

    boundary omega::host::contracts
    boundary omega::host::targets::windows
}

// A permissive development build should still be auditable.
target local_unchecked {
    host: omega::host::standard {
        abi = target_default
        stdout = enabled
        process = enabled
    }

    boundary omega::host::contracts
    boundary unchecked invariant_proofs
}

machine build(builder: &mut Build) {
    builder.application("cli-mvp");
}
