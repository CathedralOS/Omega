// Particle simulation. Tests f64 arithmetic end-to-end: position/velocity
// update over multiple steps, with a field-vs-local mix to stress all float
// codegen paths.
//
// Physics: position += velocity; velocity += acceleration each step.
// Initial state: position=0.0, velocity=1.0, acceleration=0.5
//
// Step-by-step:
//   Step 0 (init):       pos=0.0,  vel=1.0,  acc=0.5
//   Step 1: pos=0+1=1.0, vel=1+0.5=1.5
//   Step 2: pos=1+1.5=2.5, vel=1.5+0.5=2.0
//   Step 3: pos=2.5+2.0=4.5, vel=2.0+0.5=2.5
//   Step 4: pos=4.5+2.5=7.0, vel=2.5+0.5=3.0
//   Step 5: pos=7.0+3.0=10.0, vel=3.0+0.5=3.5
//
// After 5 steps position == 10.0. Assert via guard:
//   pos > 9.5 && pos < 10.5  =>  cast pos*2 to i32 => 20 => exit 70 (=20+50).
//
// Actually: final pos is exactly 10.0; cast to i32 is 10; exit 10+60 = 70.
//
// Expected exit: 70.

use omega::language::std::console;

data Particle [copy] {
    position: f64;
    velocity: f64;
    acceleration: f64;
}

data Main {
    console: Console;
    p: Particle;
}

machine Main::main(&mut self) {
    // Initialize.
    self.p.velocity = 1.0;
    self.p.acceleration = 0.5;

    // 5 simulation steps.
    self.step();
    self.step();
    self.step();
    self.step();
    self.step();

    // position should be exactly 10.0 after 5 steps.
    // Guard: 10.0 > 9.5 (true) and 10.0 < 10.5 (true) -> exit 70.
    transition self.p.position > 9.5 {
        true -> check_upper()
        _ -> bad()
    }

    state check_upper(&mut self) {
        transition self.p.position < 10.5 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}

// One Euler integration step: position += velocity; velocity += acceleration.
machine Main::step(&mut self) {
    self.p.position = self.p.position + self.p.velocity;
    self.p.velocity = self.p.velocity + self.p.acceleration;
}
