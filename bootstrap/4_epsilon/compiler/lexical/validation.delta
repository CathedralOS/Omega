
(def ascii_between ((c Int) (low Int) (high Int)) Int
  (if (lt c low) 0 (if (lt high c) 0 1)))

(def source_byte_allowed ((c Int)) Int
  (if (eq c 9) 1
    (if (eq c 10) 1
      (if (eq c 13) 1
        (ascii_between c 32 126)))))

(def is_space ((c Int)) Int
  (if (eq c 32) 1
    (if (eq c 9) 1
      (if (eq c 10) 1 (eq c 13)))))

(def is_digit ((c Int)) Int
  (ascii_between c 48 57))

(def is_upper ((c Int)) Int
  (ascii_between c 65 90))

(def is_lower ((c Int)) Int
  (ascii_between c 97 122))

(def is_ident_start ((c Int)) Int
  (if (is_upper c) 1
    (if (is_lower c) 1 (eq c 95))))

(def is_ident_continue ((c Int)) Int
  (if (is_ident_start c) 1 (is_digit c)))

(def is_hex_digit ((c Int)) Int
  (if (is_digit c) 1
    (if (ascii_between c 65 70) 1
      (ascii_between c 97 102))))

(def is_printable ((c Int)) Int
  (ascii_between c 32 126))

(def is_simple_escape ((c Int)) Int
  (if (eq c 110) 1
    (if (eq c 114) 1
      (if (eq c 116) 1
        (if (eq c 34) 1 (eq c 92))))))

(def next_is ((source EpsilonSourceView) (index Int) (length Int) (expected Int)) Int
  (if (lt (+ index 1) length)
    (eq (epsilon_source_byte source (+ index 1)) expected)
    0))

(def scan_identifier ((source EpsilonSourceView) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (if (is_ident_continue (epsilon_source_byte source index))
      (scan_identifier source (+ index 1) length)
      (scan_tokens source index length))))

(def scan_number ((source EpsilonSourceView) (start Int) (index Int) (length Int) (value Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (let c Int (epsilon_source_byte source index)
      (if (is_digit c)
        (let digit Int (- c 48)
          (if (lt value 214748364)
            (scan_number source start (+ index 1) length (+ (* value 10) digit))
            (if (eq value 214748364)
              (if (lt digit 9)
                (scan_number source start (+ index 1) length (+ (* value 10) digit))
                (LexicallyRejected IntegerLiteralOutOfRange start))
              (LexicallyRejected IntegerLiteralOutOfRange start))))
        (scan_tokens source index length)))))

(def scan_line_comment ((source EpsilonSourceView) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c Int (epsilon_source_byte source index)
      (if (eq c 10)
        (scan_tokens source index length)
        (if (eq c 13)
          (scan_tokens source index length)
          (scan_line_comment source (+ index 1) length))))))

(def scan_string_escape ((source EpsilonSourceView) (opening Int) (slash Int) (length Int)) EpsilonLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c Int (epsilon_source_byte source (+ slash 1))
      (if (is_simple_escape c)
        (scan_string source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (epsilon_source_byte source (+ slash 2)))
              (if (is_hex_digit (epsilon_source_byte source (+ slash 3)))
                (scan_string source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_string ((source EpsilonSourceView) (opening Int) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (LexicallyRejected UnterminatedString opening)
    (let c Int (epsilon_source_byte source index)
      (if (eq c 34)
        (scan_tokens source (+ index 1) length)
        (if (eq c 92)
          (scan_string_escape source opening index length)
          (if (is_printable c)
            (scan_string source opening (+ index 1) length)
            (LexicallyRejected UnterminatedString opening)))))))

(def finish_character ((source EpsilonSourceView) (opening Int) (close_index Int) (length Int)) EpsilonLexicalOutcome
  (if (lt close_index length)
    (if (eq (epsilon_source_byte source close_index) 39)
      (scan_tokens source (+ close_index 1) length)
      (LexicallyRejected InvalidCharacterLiteral opening))
    (LexicallyRejected InvalidCharacterLiteral opening)))

(def scan_character_escape ((source EpsilonSourceView) (opening Int) (slash Int) (length Int)) EpsilonLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c Int (epsilon_source_byte source (+ slash 1))
      (if (is_simple_escape c)
        (finish_character source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (epsilon_source_byte source (+ slash 2)))
              (if (is_hex_digit (epsilon_source_byte source (+ slash 3)))
                (finish_character source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_character ((source EpsilonSourceView) (opening Int) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (LexicallyRejected InvalidCharacterLiteral opening)
    (let c Int (epsilon_source_byte source index)
      (if (eq c 92)
        (scan_character_escape source opening index length)
        (if (eq c 39)
          (LexicallyRejected InvalidCharacterLiteral opening)
          (if (is_printable c)
            (finish_character source opening (+ index 1) length)
            (LexicallyRejected InvalidCharacterLiteral opening)))))))

(def is_plain_punctuation ((c Int)) Int
  (if (eq c 123) 1
    (if (eq c 125) 1
      (if (eq c 40) 1
        (if (eq c 41) 1
          (if (eq c 91) 1
            (if (eq c 93) 1
              (if (eq c 59) 1
                (if (eq c 44) 1
                  (if (eq c 43) 1
                    (if (eq c 42) 1
                      (if (eq c 37) 1 (eq c 94)))))))))))))

(def scan_operator ((source EpsilonSourceView) (index Int) (length Int) (c Int)) EpsilonLexicalOutcome
  (if (is_plain_punctuation c)
    (scan_tokens source (+ index 1) length)
    (if (eq c 58)
      (if (next_is source index length 58)
        (scan_tokens source (+ index 2) length)
        (scan_tokens source (+ index 1) length))
      (if (eq c 45)
        (if (next_is source index length 62)
          (scan_tokens source (+ index 2) length)
          (scan_tokens source (+ index 1) length))
        (if (eq c 38)
          (if (next_is source index length 38)
            (scan_tokens source (+ index 2) length)
            (scan_tokens source (+ index 1) length))
          (if (eq c 124)
            (if (next_is source index length 124)
              (scan_tokens source (+ index 2) length)
              (scan_tokens source (+ index 1) length))
            (if (eq c 61)
              (if (next_is source index length 61)
                (scan_tokens source (+ index 2) length)
                (scan_tokens source (+ index 1) length))
              (if (eq c 33)
                (if (next_is source index length 61)
                  (scan_tokens source (+ index 2) length)
                  (LexicallyRejected InvalidToken index))
                (if (eq c 60)
                  (if (next_is source index length 61)
                    (scan_tokens source (+ index 2) length)
                    (if (next_is source index length 60)
                      (scan_tokens source (+ index 2) length)
                      (scan_tokens source (+ index 1) length)))
                  (if (eq c 62)
                    (if (next_is source index length 61)
                      (scan_tokens source (+ index 2) length)
                      (if (next_is source index length 62)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length)))
                    (if (eq c 46)
                      (if (next_is source index length 46)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length))
                      (if (eq c 47)
                        (if (next_is source index length 47)
                          (scan_line_comment source (+ index 2) length)
                          (scan_tokens source (+ index 1) length))
                        (LexicallyRejected InvalidToken index)))))))))))))

(def scan_tokens ((source EpsilonSourceView) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c Int (epsilon_source_byte source index)
      (if (is_space c)
        (scan_tokens source (+ index 1) length)
        (if (is_ident_start c)
          (scan_identifier source (+ index 1) length)
          (if (is_digit c)
            (scan_number source index index length 0)
            (if (eq c 34)
              (scan_string source index (+ index 1) length)
              (if (eq c 39)
                (scan_character source index (+ index 1) length)
                (scan_operator source index length c)))))))))

(def check_source_bytes ((source EpsilonSourceView) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (scan_tokens source 0 length)
    (if (source_byte_allowed (epsilon_source_byte source index))
      (check_source_bytes source (+ index 1) length)
      (LexicallyRejected InvalidSourceByte index))))

(def check_lexical ((source EpsilonSourceView)) EpsilonLexicalOutcome
  (check_source_bytes source 0 (epsilon_source_length source)))
