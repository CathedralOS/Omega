
(def epsilon_evaluate_entry_slice ((source Bytes) (input Bytes))
  EpsilonEvaluatorSliceOutcome
  (epsilon_evaluate_entry_view (epsilon_source_whole source) input))

(def epsilon_evaluate_entry_view ((source EpsilonSourceView) (input Bytes))
  EpsilonEvaluatorSliceOutcome
  (match (epsilon_check_through_body_view source)
    ((EpsilonLocalResolutionRejected reasonValue errorOffset)
      (EpsilonEvaluatorSliceRejected reasonValue errorOffset))
    ((EpsilonLocalResolutionInternal errorOffset)
      (EpsilonEvaluatorSliceInternal errorOffset))
    ((EpsilonLocalResolutionAccepted resolved)
      (match resolved
        ((EpsilonLocallyResolvedProgramSyntax cataloged references fields
          callables control types candidate)
          (match cataloged
            ((EpsilonCatalogedProgramSyntax formed catalogState)
              (match formed
                ((EpsilonFormedProgramSyntax collected shapes valueEdges)
                  (match collected
                    ((EpsilonCollectedProgramSyntax program owners machines)
                      (match program
                        ((EpsilonSyntaxProgram start end declarations)
                          (epsilon_evaluate_entry_declarations source
                            declarations references fields callables control input))))))))))))))
