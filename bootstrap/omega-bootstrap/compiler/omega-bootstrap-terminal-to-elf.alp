// Delta-written O1 terminal-Psi -> Linux x86-64 ELF backend.
//
// Input is the vocabulary-27 O1 terminal-module shape emitted by
// omega-bootstrap-frontend.alp: zero to sixteen literal write_line calls followed by one
// nonnegative i32 exit_process call. The decoder mirrors that canonical schema,
// retains at most 1,024 aggregate literal bytes and every literal span, and
// rejects malformed, truncated, extended, or out-of-profile input before
// emitting any byte.
// Success emits one deterministic import-free ELF64 image and exits 0.
// Malformed input exits 251; table, literal, or image exhaustion exits 252.
boundary trait Console {
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; i: i32;
    word: i32; has_writes: i32; write_count: i32; write_index: i32;
    text_used: i32; text_start: i32; text_len: i32;
    exit0: i32; exit1: i32; exit2: i32; exit3: i32; text_size: i32;
    write_starts: [i32; 16]; write_lengths: [i32; 16];
    text: [u8; 1024];
}

machine Main::expect_byte(&mut self, expected: i32) {
    transition self.status == 0 { true -> read() false -> done() }
    state read() { self.c = read_byte(); transition self.c == expected { true -> done() false -> bad() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::expect_u16(&mut self, expected: i32) {
    self.expect_byte(expected & 255);
    self.expect_byte((expected >> 8) & 255);
}

machine Main::expect_u32(&mut self, expected: i32) {
    self.expect_byte(expected & 255);
    self.expect_byte((expected >> 8) & 255);
    self.expect_byte((expected >> 16) & 255);
    self.expect_byte((expected >> 24) & 255);
}

machine Main::read_small_u32(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> value() }
    state value() { self.word = self.c; self.expect_zeroes(3); transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_id(&mut self, expected: i32) {
    self.expect_u32(expected);
    self.expect_u32(0);
}

machine Main::expect_zeroes(&mut self, count: i32) {
    self.i = 0;
    transition self.status == 0 { true -> loop() false -> done() }
    state loop() { transition self.i < count { true -> byte() false -> done() } }
    state byte() { self.expect_byte(0); self.i = self.i + 1; transition self.status == 0 { true -> loop() false -> done() } }
    state done() { }
}

machine Main::expect_main_identity(&mut self) {
    self.expect_byte(110); self.expect_byte(97); self.expect_byte(109); self.expect_byte(101); self.expect_byte(100); self.expect_byte(40); self.expect_byte(110); self.expect_byte(97);
    self.expect_byte(109); self.expect_byte(101); self.expect_byte(40); self.expect_byte(77); self.expect_byte(97); self.expect_byte(105); self.expect_byte(110); self.expect_byte(41);
    self.expect_byte(41);
}

machine Main::expect_console_field(&mut self) {
    self.expect_byte(99); self.expect_byte(111); self.expect_byte(110); self.expect_byte(115); self.expect_byte(111); self.expect_byte(108); self.expect_byte(101);
}

machine Main::expect_console_type_identity(&mut self) {
    self.expect_byte(110); self.expect_byte(97); self.expect_byte(109); self.expect_byte(101); self.expect_byte(100); self.expect_byte(40); self.expect_byte(110); self.expect_byte(97);
    self.expect_byte(109); self.expect_byte(101); self.expect_byte(40); self.expect_byte(67); self.expect_byte(111); self.expect_byte(110); self.expect_byte(115); self.expect_byte(111);
    self.expect_byte(108); self.expect_byte(101); self.expect_byte(41); self.expect_byte(41);
}

machine Main::expect_bytes_type_identity(&mut self) {
    self.expect_byte(114); self.expect_byte(101); self.expect_byte(102); self.expect_byte(40); self.expect_byte(115); self.expect_byte(108); self.expect_byte(105); self.expect_byte(99);
    self.expect_byte(101); self.expect_byte(40); self.expect_byte(110); self.expect_byte(97); self.expect_byte(109); self.expect_byte(101); self.expect_byte(100); self.expect_byte(40);
    self.expect_byte(110); self.expect_byte(97); self.expect_byte(109); self.expect_byte(101); self.expect_byte(40); self.expect_byte(117); self.expect_byte(56); self.expect_byte(41);
    self.expect_byte(41); self.expect_byte(41); self.expect_byte(41);
}

machine Main::expect_console_service(&mut self) {
    self.expect_byte(67); self.expect_byte(111); self.expect_byte(110); self.expect_byte(115); self.expect_byte(111); self.expect_byte(108); self.expect_byte(101);
}

