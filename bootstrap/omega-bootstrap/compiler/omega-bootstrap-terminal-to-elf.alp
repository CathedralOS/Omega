    self.expect_byte(97); self.expect_byte(116); self.expect_byte(104); self.expect_byte(40); self.expect_byte(67); self.expect_byte(111); self.expect_byte(110); self.expect_byte(115);
    self.expect_byte(111); self.expect_byte(108); self.expect_byte(101); self.expect_byte(58); self.expect_byte(58); self.expect_byte(119); self.expect_byte(114); self.expect_byte(105);
    self.expect_byte(116); self.expect_byte(101); self.expect_byte(95); self.expect_byte(108); self.expect_byte(105); self.expect_byte(110); self.expect_byte(101); self.expect_byte(41);
