    state sum() { self.try_sum_layout(self.metadata_arena[16384 + self.i]); transition self.status == 0 { true -> sum_result() _ -> done() } }
    state sum_result() { transition self.copy_ok == 1 { true -> nominal_commit() _ -> next() } }
    state array() { self.type_id = self.metadata_arena[16384 + self.i]; transition self.metadata_arena[65536 + self.type_id] == 1 { true -> array_product() _ -> next() } }
    state array_product() { transition self.metadata_arena[24576 + self.i] == 0 { true -> array_zero() _ -> array_bound() } }
