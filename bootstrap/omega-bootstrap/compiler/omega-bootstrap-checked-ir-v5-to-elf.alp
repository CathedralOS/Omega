    state zero_sum_fields() { transition self.j < self.end { true -> zero_sum_field() _ -> zero_commit() } }
    state zero_sum_field() { self.type_id = self.payload_arena[8192 + self.j]; transition self.metadata_arena[98304 + self.type_id] == 1 { true -> zero_sum_field_value() _ -> zero_pending() } }
    state zero_sum_field_value() { transition self.metadata_arena[90112 + self.type_id] == 1 { true -> zero_sum_next() _ -> zero_false() } }
    state zero_sum_next() { self.j = self.j + 1; transition 0 { _ -> zero_sum_fields() } }
