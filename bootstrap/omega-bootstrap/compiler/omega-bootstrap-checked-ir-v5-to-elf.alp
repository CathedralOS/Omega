    state binding_align() { self.align_frame(self.metadata_arena[57344 + self.type_id]); transition self.status == 0 { true -> binding_size() _ -> done() } }
    state binding_size() { self.size = self.metadata_arena[49152 + self.type_id]; transition self.size == 0 { true -> binding_anchor() _ -> binding_bound() } }
    state binding_anchor() { self.size = 1; transition 0 { _ -> binding_bound() } }
