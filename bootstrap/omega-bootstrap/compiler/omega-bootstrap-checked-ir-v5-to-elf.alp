    state payload_restore() { self.offset = self.sum_arena[640 + self.case_arena[0 + self.case_arm_arena[4096 + arm]]] + self.payload_arena[12288 + self.value]; self.code_byte(73); self.code_byte(129); self.code_byte(235); self.code_u32(self.offset); self.code_byte(72); self.code_byte(141); self.code_byte(133); self.code_signed_u32(0 - self.case_binding_offset[self.k]); self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.const_height + 1) * 8)); transition 0 { _ -> stage_next() } }
    state stage_next() { self.const_height = self.const_height + 1; transition 0 { _ -> stage_loop() } }
    state commit_setup() { self.const_height = 0; transition 0 { _ -> commit_loop() } }
    state commit_loop() { transition self.const_height < self.case_arm_arena[16384 + arm] { true -> commit() _ -> jump() } }
    state commit() { self.value = self.metadata_arena[106496 + 63104 + self.metadata_arena[106496 + 42624 + self.case_arm_arena[8192 + arm]] + self.const_height]; self.type_id = self.value_arena[0 + self.value]; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> commit_scalar() _ -> commit_structural() } }
    state commit_scalar() { self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.const_height + 1) * 8)); self.range_check_eax(self.type_id); self.store_value_eax(self.value); transition 0 { _ -> commit_next() } }
    state commit_structural() { self.code_byte(72); self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.const_height + 1) * 8)); self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + self.value]); transition 0 { _ -> commit_next() } }
    state commit_next() { self.const_height = self.const_height + 1; transition 0 { _ -> commit_loop() } }
    state jump() { self.code_byte(233); self.code_rel32(self.metadata_arena[106496 + 52864 + self.case_arm_arena[8192 + arm]]); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::case_edge_size(&mut self, arm: i32) -> i32 {
    self.const_root_count = self.code_cursor; self.zero_ok = self.emitting; self.emitting = 0;
    self.emit_case_edge(arm);
    self.size = self.code_cursor - self.const_root_count; self.code_cursor = self.const_root_count; self.emitting = self.zero_ok;
    return self.size;
}

machine Main::emit_terminator(&mut self, block: i32) {
    transition self.metadata_arena[173696 + 0 + block] { 1 -> jump() 2 -> branch() 3 -> return_unit() 4 -> return_value() 5 -> dispatch_subject() _ -> bad() }
    state jump() { self.emit_edge(self.metadata_arena[173696 + 6144 + block], self.metadata_arena[173696 + 8192 + block], self.metadata_arena[173696 + 4096 + block]); transition 0 { _ -> done() } }
    state branch() { self.load_value_eax(self.metadata_arena[173696 + 2048 + block]); self.code_byte(133); self.code_byte(192); self.size = self.edge_size(self.metadata_arena[173696 + 6144 + block], self.metadata_arena[173696 + 8192 + block]); self.target = self.code_cursor + 6 + self.size; self.code_byte(15); self.code_byte(132); self.code_rel32(self.target); self.emit_edge(self.metadata_arena[173696 + 6144 + block], self.metadata_arena[173696 + 8192 + block], self.metadata_arena[173696 + 4096 + block]); self.emit_edge(self.metadata_arena[173696 + 12288 + block], self.metadata_arena[173696 + 14336 + block], self.metadata_arena[173696 + 10240 + block]); transition 0 { _ -> done() } }
    state return_unit() { self.code_byte(201); self.code_byte(195); transition 0 { _ -> done() } }
    state return_value() { self.load_value_eax(self.metadata_arena[173696 + 2048 + block]); self.range_check_eax(self.metadata_arena[106496 + 25472 + self.current_machine]); self.code_byte(201); self.code_byte(195); transition 0 { _ -> done() } }
    state dispatch_subject() { self.value = self.metadata_arena[173696 + 2048 + block]; transition self.metadata_arena[190080 + block] == 1 { true -> dispatch_value() _ -> dispatch_place() } }
    state dispatch_value() { self.code_byte(76); self.code_byte(139); self.code_byte(157); self.code_signed_u32(0 - self.value_arena[163840 + self.value]); self.type_id = self.value_arena[0 + self.value]; transition 0 { _ -> dispatch_tag() } }
    state dispatch_place() { self.code_byte(76); self.code_byte(139); self.code_byte(157); self.code_signed_u32(0 - self.value_arena[335872 + self.value]); self.type_id = self.value_arena[204800 + self.value]; transition 0 { _ -> dispatch_tag() } }
    state dispatch_tag() { self.owner_type = self.metadata_arena[16384 + self.type_id]; self.code_byte(65); self.code_byte(139); self.code_byte(3); self.code_byte(61); self.code_u32(self.sum_arena[256 + self.owner_type]); self.trap_jcc(131); self.const_id = 0; transition 0 { _ -> dispatch_arms() } }
    state dispatch_arms() { transition self.const_id < self.metadata_arena[194176 + block] { true -> dispatch_arm() _ -> bad() } }
    state dispatch_arm() { self.k = self.metadata_arena[192128 + block] + self.const_id; transition self.const_id + 1 == self.metadata_arena[194176 + block] { true -> dispatch_last() _ -> dispatch_compare() } }
    state dispatch_compare() { self.code_byte(61); self.code_u32(self.const_id); self.size = self.case_edge_size(self.k); self.target = self.code_cursor + 6 + self.size; self.code_byte(15); self.code_byte(133); self.code_rel32(self.target); self.k = self.metadata_arena[192128 + block] + self.const_id; self.emit_case_edge(self.k); self.const_id = self.const_id + 1; transition 0 { _ -> dispatch_arms() } }
    state dispatch_last() { self.k = self.metadata_arena[192128 + block] + self.const_id; self.emit_case_edge(self.k); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::emit_block(&mut self, block: i32) {
    self.current_machine = self.metadata_arena[106496 + 38528 + block]; self.frame_size = self.machine_frame_size[self.current_machine]; self.scratch_base = self.machine_scratch_base[self.current_machine];
    transition block == self.metadata_arena[106496 + 26112 + self.current_machine] { true -> prologue() _ -> operations_setup() }
    state prologue() { self.code_byte(85); self.code_byte(72); self.code_byte(137); self.code_byte(229); self.code_byte(72); self.code_byte(129); self.code_byte(236); self.code_u32(self.frame_size); self.code_byte(72); self.code_byte(137); self.code_byte(189); self.code_signed_u32(0 - 8); self.j = 0; transition 0 { _ -> parameters() } }
    state parameters() { transition self.j < self.metadata_arena[106496 + 25728 + self.current_machine] { true -> parameter() _ -> operations_setup() } }
    state parameter() { self.k = self.metadata_arena[106496 + 25600 + self.current_machine] + self.j; self.type_id = self.metadata_arena[106496 + 30336 + self.k]; self.value = self.metadata_arena[106496 + 34432 + self.k]; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> parameter_scalar() _ -> parameter_structural() } }
    state parameter_scalar() { self.code_byte(139); self.code_byte(134); self.code_signed_u32(self.j * 8); self.range_check_eax(self.type_id); self.store_value_eax(self.value); transition 0 { _ -> parameter_next() } }
    state parameter_structural() { self.code_byte(72); self.code_byte(139); self.code_byte(134); self.code_signed_u32(self.j * 8); self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + self.value]); transition 0 { _ -> parameter_next() } }
    state parameter_next() { self.j = self.j + 1; transition 0 { _ -> parameters() } }
    state operations_setup() { self.current_op = self.metadata_arena[106496 + 46720 + block]; self.end = self.current_op + self.metadata_arena[106496 + 48768 + block]; transition 0 { _ -> operations() } }
    state operations() { transition self.current_op < self.end { true -> operation() _ -> term() } }
    state operation() { self.i = self.current_op; self.emit_operation(self.current_op); self.current_op = self.i + 1; transition self.status == 0 { true -> operations() _ -> done() } }
    state term() { self.emit_terminator(block); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_text(&mut self) {
    self.code_cursor = 0;
    // lea rdi,[rip+BSS]; call root; movzx edi,al; exit_group; ud2
    self.code_byte(72); self.code_byte(141); self.code_byte(61);
    transition self.text_pass == 0 { true -> shim_dummy_bss() _ -> shim_bss() }
    state shim_dummy_bss() { self.code_u32(0); transition 0 { _ -> shim_call() } }
    state shim_bss() { self.code_rel32(self.rx_size + self.ro_size - 4096); transition 0 { _ -> shim_call() } }
    state shim_call() { self.code_byte(232); transition self.text_pass == 0 { true -> shim_dummy_call() _ -> shim_root_call() } }
    state shim_dummy_call() { self.code_u32(0); transition 0 { _ -> shim_tail() } }
    state shim_root_call() { self.code_rel32(self.root_offset); transition 0 { _ -> shim_tail() } }
    state shim_tail() { self.code_byte(15); self.code_byte(182); self.code_byte(248); self.code_byte(184); self.code_u32(231); self.code_byte(15); self.code_byte(5); self.code_byte(15); self.code_byte(11); self.trap_offset = self.code_cursor; self.code_byte(15); self.code_byte(11); self.current_machine = 0; transition 0 { _ -> machines() } }
    state machines() { transition self.current_machine < self.machine_count { true -> machine_reachable() _ -> done() } }
    state machine_reachable() { transition self.reachable[self.current_machine] == 1 { true -> machine_blocks() _ -> machine_next() } }
    state machine_blocks() { self.current_block = self.metadata_arena[106496 + 25856 + self.current_machine]; transition 0 { _ -> blocks() } }
    state blocks() { transition self.current_block < self.metadata_arena[106496 + 25856 + self.current_machine] + self.metadata_arena[106496 + 25984 + self.current_machine] { true -> block() _ -> machine_next() } }
    state block() { transition self.text_pass == 0 { true -> remember() _ -> emit() } }
    state remember() { self.metadata_arena[106496 + 52864 + self.current_block] = self.code_cursor; transition self.current_block == self.metadata_arena[106496 + 26112 + self.entry_id] { true -> remember_root() _ -> emit() } }
    state remember_root() { self.root_offset = self.code_cursor; transition 0 { _ -> emit() } }
    state emit() { self.emit_block(self.current_block); self.current_block = self.current_block + 1; transition self.status == 0 { true -> blocks() _ -> done() } }
    state machine_next() { self.current_machine = self.current_machine + 1; transition 0 { _ -> machines() } }
    state done() { }
}

machine Main::preflight_text(&mut self) {
    self.emitting = 0; self.pass = 0; self.text_pass = 0; self.emit_text();
    transition self.status == 0 { true -> text_cap() _ -> done() }
    state text_cap() { self.text_size = self.code_cursor; transition self.text_size <= 1048576 { true -> rx_add() _ -> exhausted() } }
    state rx_add() { transition self.text_size <= 2147483647 - 4096 { true -> rx_round() _ -> exhausted() } }
    state rx_round() { self.rx_size = 4096 + self.text_size; self.pad = (4096 - (self.rx_size % 4096)) % 4096; transition self.pad <= 2147483647 - self.rx_size { true -> rx_keep() _ -> exhausted() } }
    state rx_keep() { self.rx_size = self.rx_size + self.pad; self.pad = (4096 - (self.bss_size % 4096)) % 4096; transition self.bss_size == 0 { true -> bss_zero() _ -> bss_round() } }
    state bss_zero() { self.size = 4096; transition 0 { _ -> fixups() } }
    state bss_round() { transition self.pad <= 2147483647 - self.bss_size { true -> bss_keep() _ -> exhausted() } }
    state bss_keep() { self.size = self.bss_size + self.pad; transition 0 { _ -> fixups() } }
    state fixups() { self.bss_size = self.size; self.pass = 1; self.text_pass = 1; self.emit_text(); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.code_cursor == self.text_size { true -> elf_cap() _ -> bad() } }
    state elf_cap() { transition self.rx_size <= 1183744 - self.ro_size { true -> done() _ -> exhausted() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::output_zeroes(&mut self, count: i32) {
    self.j = 0;
    transition self.j < count { true -> byte() _ -> done() }
    state byte() { write_byte(0); self.j = self.j + 1; transition self.j < count { true -> byte() _ -> done() } }
    state done() { }
}

machine Main::output_constant_image(&mut self) {
    self.i = 0;
    transition self.i < self.const_image_size { true -> byte() _ -> padding() }
    state byte() { write_byte(self.constant_image[self.i]); self.i = self.i + 1; transition self.i < self.const_image_size { true -> byte() _ -> padding() } }
    state padding() { self.output_zeroes(self.ro_size - self.const_image_size); }
}

machine Main::publish_elf(&mut self) {
    // ELF header through the program-header count.
    write_byte(127); write_byte(69); write_byte(76); write_byte(70);
    write_byte(2); write_byte(1); write_byte(1); write_byte(0); self.output_zeroes(8);
    self.output_u16(2); self.output_u16(62); self.output_u32(1);
    self.output_u64(4198400); self.output_u64(64); self.output_u64(0); self.output_u32(0);
    self.output_u16(64); self.output_u16(56);
    transition self.const_count > 0 { true -> header_three() _ -> header_two() }
    state header_two() { self.output_u16(2); transition 0 { _ -> header_tail() } }
    state header_three() { self.output_u16(3); transition 0 { _ -> header_tail() } }
    state header_tail() { self.output_u16(0); self.output_u16(0); self.output_u16(0); transition 0 { _ -> rx() } }
    state rx() { self.output_u32(1); self.output_u32(5); self.output_u64(0); self.output_u64(4194304); self.output_u64(4194304); self.output_u64(self.rx_size); self.output_u64(self.rx_size); self.output_u64(4096); transition self.const_count > 0 { true -> ro() _ -> rw() } }
    state ro() { self.output_u32(1); self.output_u32(4); self.output_u64(self.rx_size); self.output_u64(4194304 + self.rx_size); self.output_u64(4194304 + self.rx_size); self.output_u64(self.ro_size); self.output_u64(self.ro_size); self.output_u64(4096); transition 0 { _ -> rw() } }
    state rw() { self.output_u32(1); self.output_u32(6); self.output_u64(self.rx_size + self.ro_size); self.output_u64(4194304 + self.rx_size + self.ro_size); self.output_u64(4194304 + self.rx_size + self.ro_size); self.output_u64(0); self.output_u64(self.bss_size); self.output_u64(4096); transition self.const_count > 0 { true -> pad_three() _ -> pad_two() } }
    state pad_two() { self.output_zeroes(3920); transition 0 { _ -> text() } }
    state pad_three() { self.output_zeroes(3864); transition 0 { _ -> text() } }
    state text() { self.emitting = 1; self.pass = 2; self.text_pass = 2; self.emit_text(); self.output_zeroes(self.rx_size - 4096 - self.text_size); transition self.const_count > 0 { true -> constants() _ -> done() } }
    state constants() { self.output_constant_image(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode(&mut self) {
    self.read_header(); transition self.status == 0 { true -> length() _ -> done() }
    state length() { self.check_encoded_length(); transition self.status == 0 { true -> types() _ -> done() } }
    state types() { self.parse_types(); transition self.status == 0 { true -> records() _ -> done() } }
    state records() { self.parse_records(); transition self.status == 0 { true -> fields() _ -> done() } }
    state fields() { self.parse_fields(); transition self.status == 0 { true -> sum_version() _ -> done() } }
    state sum_version() { transition self.schema_major >= 5 { true -> sums() _ -> machines() } }
    state sums() { self.parse_sums(); transition self.status == 0 { true -> cases() _ -> done() } }
    state cases() { self.parse_cases(); transition self.status == 0 { true -> case_payloads() _ -> done() } }
    state case_payloads() { self.parse_case_payloads(); transition self.status == 0 { true -> machines() _ -> done() } }
    state machines() { self.parse_machines(); transition self.status == 0 { true -> mparams() _ -> done() } }
    state mparams() { self.parse_mparams(); transition self.status == 0 { true -> blocks() _ -> done() } }
    state blocks() { self.parse_blocks(); transition self.status == 0 { true -> bparams() _ -> done() } }
    state bparams() { self.parse_bparams(); transition self.status == 0 { true -> constants() _ -> done() } }
    state constants() { self.parse_constants(); transition self.status == 0 { true -> constant_children() _ -> done() } }
    state constant_children() { self.parse_constant_children(); transition self.status == 0 { true -> operations() _ -> done() } }
    state operations() { self.parse_operations(); transition self.status == 0 { true -> operands() _ -> done() } }
    state operands() { self.parse_operands(); transition self.status == 0 { true -> terms() _ -> done() } }
    state terms() { self.parse_terminators(); transition self.status == 0 { true -> arm_version() _ -> done() } }
    state arm_version() { transition self.schema_major >= 5 { true -> case_arms() _ -> layouts() } }
    state case_arms() { self.parse_case_arms(); transition self.status == 0 { true -> case_arm_args() _ -> done() } }
    state case_arm_args() { self.parse_case_arm_args(); transition self.status == 0 { true -> layouts() _ -> done() } }
    state layouts() { self.resolve_layouts(); transition self.status == 0 { true -> constants_validate() _ -> done() } }
    state constants_validate() { self.validate_constants(); transition self.status == 0 { true -> ops_validate() _ -> done() } }
    state ops_validate() { self.validate_operations(); transition self.status == 0 { true -> constant_reach() _ -> done() } }
    state constant_reach() { self.validate_constant_reachability(); transition self.status == 0 { true -> constant_image() _ -> done() } }
    state constant_image() { self.build_constant_image(); transition self.status == 0 { true -> terms_validate() _ -> done() } }
    state terms_validate() { self.validate_terminators(); transition self.status == 0 { true -> calls_validate() _ -> done() } }
    state calls_validate() { self.validate_call_graph(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.decode();
    transition self.status == 0 { true -> root() _ -> finish() }
    state root() { transition self.flags == 1 { true -> frame() _ -> finish() } }
    state frame() { self.assign_frame(); transition self.status == 0 { true -> text() _ -> finish() } }
    state text() { self.preflight_text(); transition self.status == 0 { true -> publish() _ -> finish() } }
    state publish() { self.publish_elf(); transition 0 { _ -> finish() } }
    state finish() { self.console.exit_process(self.status); }
}
