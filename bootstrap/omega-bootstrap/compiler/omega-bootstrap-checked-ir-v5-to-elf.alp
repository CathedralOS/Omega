    state binding_next() { self.i = self.i + 1; transition 0 { _ -> bindings() } }
    state scratch_scan() { self.i = self.metadata_arena[106496 + 25856 + self.current_machine]; self.end = self.i + self.metadata_arena[106496 + 25984 + self.current_machine]; self.scratch_count = 0; transition 0 { _ -> scratch_loop() } }
    state scratch_loop() { transition self.i < self.end { true -> scratch0() _ -> call_scratch_setup() } }
