    state zero_false() { self.metadata_arena[90112 + self.i] = 0; self.metadata_arena[98304 + self.i] = 1; self.progress = self.progress + 1; transition 0 { _ -> zero_next() } }
    state zero_pending() { transition 0 { _ -> zero_next() } }
    state zero_next() { self.i = self.i + 1; transition 0 { _ -> zero_loop() } }
