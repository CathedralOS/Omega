    state align_four() { self.align = 4; transition 0 { _ -> final_pad() } }
    state final_pad() { self.found = (self.align - (self.size % self.align)) % self.align; transition self.found <= 2147483647 - self.size { true -> complete() _ -> bad() } }
    state complete() { self.size = self.size + self.found; self.copy_ok = 1; transition 0 { _ -> done() } }
    state pending() { transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::resolve_layouts(&mut self) {
    self.pass = 0;
    transition 0 { _ -> passes() }
    state passes() { self.progress = 0; self.expected = 0; self.i = 0; transition 0 { _ -> loop() } }
    state loop() { transition self.i < self.type_count { true -> unresolved() _ -> pass_done() } }
    state unresolved() { transition self.metadata_arena[65536 + self.i] == 0 { true -> count() _ -> next() } }
    state count() { self.expected = self.expected + 1; transition self.metadata_arena[0 + self.i] { 4 -> nominal() 5 -> array() 6 -> sum() _ -> bad() } }
    state nominal() { self.try_record_layout(self.metadata_arena[16384 + self.i]); transition self.status == 0 { true -> nominal_result() _ -> done() } }
    state nominal_result() { transition self.copy_ok == 1 { true -> nominal_commit() _ -> next() } }
