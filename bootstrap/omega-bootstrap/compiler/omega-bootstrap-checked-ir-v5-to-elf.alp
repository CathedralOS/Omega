    state scratch_case_keep() { self.scratch_count = self.case_arm_arena[16384 + self.j]; transition 0 { _ -> scratch_case_next() } }
    state scratch_case_next() { self.j = self.j + 1; transition 0 { _ -> scratch_cases() } }
    state scratch_next() { self.i = self.i + 1; transition 0 { _ -> scratch_loop() } }
