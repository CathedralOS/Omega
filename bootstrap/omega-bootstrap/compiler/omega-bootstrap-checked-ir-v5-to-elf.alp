    state array_bound() { transition self.metadata_arena[49152 + self.type_id] <= 2147483647 / self.metadata_arena[24576 + self.i] { true -> array_commit() _ -> bad() } }
    state array_commit() { self.metadata_arena[49152 + self.i] = self.metadata_arena[49152 + self.type_id] * self.metadata_arena[24576 + self.i]; self.metadata_arena[57344 + self.i] = self.metadata_arena[57344 + self.type_id]; self.metadata_arena[65536 + self.i] = 1; self.progress = self.progress + 1; transition 0 { _ -> next() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state pass_done() { transition self.expected == 0 { true -> copy_start() _ -> made_progress() } }
    state made_progress() { transition self.progress > 0 { true -> pass_advance() _ -> bad() } }
    state pass_advance() { self.pass = self.pass + 1; transition self.pass <= self.type_count { true -> passes() _ -> bad() } }
