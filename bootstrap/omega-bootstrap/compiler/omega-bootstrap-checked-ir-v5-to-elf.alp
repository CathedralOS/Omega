}

machine Main::validate_call_graph(&mut self) {
    self.i = 0; self.removed_count = 0;
    transition 0 { _ -> active_clear() }
    state active_clear() { transition self.i < self.machine_count { true -> active_one() _ -> pick_setup() } }
    state active_one() { self.active_machine[self.i] = 1; self.reachable[self.i] = 0; self.machine_live_stack[self.i] = 0; self.i = self.i + 1; transition 0 { _ -> active_clear() } }
    state pick_setup() { self.i = 0; self.found = 0 - 1; transition 0 { _ -> pick() } }
    state pick() { transition self.i < self.machine_count { true -> pick_active() _ -> picked() } }
    state pick_active() { transition self.active_machine[self.i] == 1 { true -> pick_zero() _ -> pick_next() } }
    state pick_zero() { transition self.indegree[self.i] == 0 { true -> pick_keep() _ -> pick_next() } }
    state pick_keep() { self.found = self.i; transition 0 { _ -> picked() } }
    state pick_next() { self.i = self.i + 1; transition 0 { _ -> pick() } }
    state picked() { transition self.found >= 0 { true -> remove() _ -> removal_done() } }
    state remove() { self.active_machine[self.found] = 0; self.topo_order[self.removed_count] = self.found; self.removed_count = self.removed_count + 1; self.j = 0; transition 0 { _ -> outgoing() } }
    state outgoing() { transition self.j < self.machine_count { true -> outgoing_edge() _ -> pick_setup() } }
    state outgoing_edge() { transition self.call_graph[self.found * 128 + self.j] == 1 { true -> outgoing_drop() _ -> outgoing_next() } }
    state outgoing_drop() { self.indegree[self.j] = self.indegree[self.j] - 1; transition self.indegree[self.j] >= 0 { true -> outgoing_next() _ -> bad() } }
    state outgoing_next() { self.j = self.j + 1; transition 0 { _ -> outgoing() } }
    state removal_done() { transition self.removed_count == self.machine_count { true -> library_check() _ -> bad() } }
    state library_check() { transition self.flags == 0 { true -> done() _ -> reach_setup() } }
    state reach_setup() { self.queue_head = 0; self.queue_tail = 1; self.machine_queue[0] = self.entry_id; self.reachable[self.entry_id] = 1; transition 0 { _ -> reach_queue() } }
    state reach_queue() { transition self.queue_head < self.queue_tail { true -> reach_pop() _ -> done() } }
    state reach_pop() { self.current_machine = self.machine_queue[self.queue_head]; self.queue_head = self.queue_head + 1; self.j = 0; transition 0 { _ -> reach_edges() } }
    state reach_edges() { transition self.j < self.machine_count { true -> reach_edge() _ -> reach_queue() } }
    state reach_edge() { transition self.call_graph[self.current_machine * 128 + self.j] == 1 { true -> reach_unseen() _ -> reach_next() } }
