machine Main::constant_key_after(&mut self, id: i32) -> i32 {
    transition id == 0 { true -> yes() _ -> height() }
    state height() { transition self.constant_arena[32768 + id] > self.constant_arena[32768 + id - 1] { true -> yes() _ -> height_equal() } }
    state height_equal() { transition self.constant_arena[32768 + id] == self.constant_arena[32768 + id - 1] { true -> type() _ -> no() } }
    state type() { transition self.constant_arena[0 + id] > self.constant_arena[0 + id - 1] { true -> yes() _ -> type_equal() } }
    state type_equal() { transition self.constant_arena[0 + id] == self.constant_arena[0 + id - 1] { true -> payload() _ -> no() } }
    state payload() { transition self.constant_arena[32768 + id] == 0 { true -> scalar() _ -> count() } }
    state scalar() { transition self.constant_arena[24576 + id] > self.constant_arena[24576 + id - 1] { true -> yes() _ -> no() } }
    state count() { transition self.constant_arena[16384 + id] > self.constant_arena[16384 + id - 1] { true -> yes() _ -> count_equal() } }
    state count_equal() { transition self.constant_arena[16384 + id] == self.constant_arena[16384 + id - 1] { true -> children_setup() _ -> no() } }
    state children_setup() { self.j = 0; transition 0 { _ -> children() } }
    state children() { transition self.j < self.constant_arena[16384 + id] { true -> child() _ -> no() } }
    state child() { self.value = self.constant_children[self.constant_arena[8192 + id] + self.j]; self.value2 = self.constant_children[self.constant_arena[8192 + id - 1] + self.j]; transition self.value > self.value2 { true -> yes() _ -> child_equal() } }
    state child_equal() { transition self.value == self.value2 { true -> child_next() _ -> no() } }
    state child_next() { self.j = self.j + 1; transition 0 { _ -> children() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::validate_constants(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.const_count { true -> classify() _ -> done() } }
    state classify() { self.type_id = self.constant_arena[0 + self.i]; self.constant_arena[40960 + self.i] = 0; self.constant_arena[49152 + self.i] = 0; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> scalar() _ -> structural_setup() } }
    state scalar() { self.constant_arena[32768 + self.i] = 0; transition 0 { _ -> ordered() } }
    state structural_setup() { self.j = 0; self.const_height = 1; transition 0 { _ -> children() } }
    state children() { transition self.j < self.constant_arena[16384 + self.i] { true -> child() _ -> height_keep() } }
    state child() { self.value = self.constant_children[self.constant_arena[8192 + self.i] + self.j]; self.found = self.valid_id(self.value, self.i); transition self.found == 1 { true -> child_type() _ -> bad() } }
    state child_type() { transition self.metadata_arena[0 + self.type_id] == 4 { true -> record_child_type() _ -> array_child_type() } }
    state record_child_type() { self.found = self.metadata_arena[16384 + self.type_id]; self.type2 = self.metadata_arena[106496 + 8832 + self.metadata_arena[106496 + 128 + self.found] + self.j]; transition self.constant_arena[0 + self.value] == self.type2 { true -> child_height() _ -> bad() } }
    state array_child_type() { self.type2 = self.metadata_arena[16384 + self.type_id]; transition self.constant_arena[0 + self.value] == self.type2 { true -> child_height() _ -> bad() } }
    state child_height() { self.value2 = self.constant_arena[32768 + self.value] + 1; transition self.value2 > self.const_height { true -> child_height_keep() _ -> child_next() } }
    state child_height_keep() { self.const_height = self.value2; transition 0 { _ -> child_next() } }
    state child_next() { self.j = self.j + 1; transition 0 { _ -> children() } }
    state height_keep() { self.constant_arena[32768 + self.i] = self.const_height; transition 0 { _ -> ordered() } }
    state ordered() { self.found = self.constant_key_after(self.i); transition self.found == 1 { true -> advance() _ -> bad() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::value_visible(&mut self, id: i32) -> i32 {
    self.found = self.valid_id(id, self.value_count);
    transition self.found == 1 { true -> machine_check() _ -> no() }
    state machine_check() { transition self.value_arena[40960 + id] == self.current_machine { true -> scope() _ -> no() } }
    state scope() { transition self.value_arena[81920 + id] < 0 { true -> yes() _ -> block_check() } }
    state block_check() { transition self.value_arena[81920 + id] == self.current_block { true -> definition() _ -> no() } }
    state definition() { transition self.value_arena[122880 + id] < self.current_op { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::place_visible(&mut self, id: i32, block: i32, before: i32) -> i32 {
    self.found = self.valid_id(id, self.place_count);
    transition self.found == 1 { true -> block_check() _ -> no() }
    state block_check() { transition self.value_arena[237568 + id] == block { true -> definition() _ -> no() } }
    state definition() { transition self.value_arena[270336 + id] < before { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::validate_operations(&mut self) {
    self.i = 0;
    transition 0 { _ -> clear_graph() }
    state clear_graph() { transition self.i < 16384 { true -> clear_edge() _ -> clear_indegree_setup() } }
    state clear_edge() { self.call_graph[self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_graph() } }
    state clear_indegree_setup() { self.i = 0; transition 0 { _ -> clear_indegree() } }
