machine Main::output_u16(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
}

machine Main::output_u32(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
    write_byte((value >> 16) & 255); write_byte((value >> 24) & 255);
}

machine Main::output_u64(&mut self, value: i32) { self.output_u32(value); self.output_u32(0); }

machine Main::code_byte(&mut self, value: i32) {
    transition self.emitting == 1 { true -> publish() _ -> count() }
    state publish() { write_byte(value); transition 0 { _ -> count() } }
    state count() { self.code_cursor = self.code_cursor + 1; }
}

machine Main::code_u32(&mut self, value: i32) {
    self.code_byte(value & 255); self.code_byte((value >> 8) & 255);
    self.code_byte((value >> 16) & 255); self.code_byte((value >> 24) & 255);
}

machine Main::code_signed_u32(&mut self, value: i32) {
    transition value >= 0 { true -> positive() _ -> negative() }
    state positive() { self.code_u32(value); transition 0 { _ -> done() } }
    state negative() { self.word = 0 - value - 1; self.code_byte(255 - (self.word & 255)); self.word = self.word / 256; self.code_byte(255 - (self.word & 255)); self.word = self.word / 256; self.code_byte(255 - (self.word & 255)); self.word = self.word / 256; self.code_byte(255 - (self.word & 255)); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::code_rel32(&mut self, target: i32) {
    self.displacement = target - (self.code_cursor + 4); self.code_signed_u32(self.displacement);
}

machine Main::load_value_eax(&mut self, id: i32) {
    self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + id]);
}

machine Main::store_value_eax(&mut self, id: i32) {
    self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + id]);
}

machine Main::load_place_rax(&mut self, id: i32) {
    self.code_byte(72); self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[335872 + id]);
}

machine Main::store_place_rax(&mut self, id: i32) {
    self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[335872 + id]);
}

machine Main::trap_jcc(&mut self, opcode: i32) {
    self.code_byte(15); self.code_byte(opcode); self.code_rel32(self.trap_offset);
}

machine Main::range_check_eax(&mut self, type: i32) {
    self.code_byte(61); self.code_u32(self.metadata_arena[32768 + type]); self.trap_jcc(130);
    self.code_byte(61); self.code_u32(self.metadata_arena[40960 + type]); self.trap_jcc(135);
}

machine Main::copy_leaf_to(&mut self, type: i32, source_offset: i32, destination_offset: i32) {
    transition self.metadata_arena[0 + type] == 2 { true -> wide() _ -> byte() }
    state byte() { self.code_byte(65); self.code_byte(15); self.code_byte(182); self.code_byte(131); self.code_u32(source_offset); self.code_byte(65); self.code_byte(136); self.code_byte(130); self.code_u32(destination_offset); transition 0 { _ -> done() } }
    state wide() { self.code_byte(65); self.code_byte(139); self.code_byte(131); self.code_u32(source_offset); self.code_byte(65); self.code_byte(137); self.code_byte(130); self.code_u32(destination_offset); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_copy_leaves(&mut self, type: i32, destination_base: i32) {
    self.walk_depth = 0; self.value_arena[368640 + 0] = type; self.value_arena[376832 + 0] = 0; self.value_arena[385024 + 0] = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.walk_depth >= 0 { true -> classify() _ -> done() } }
    state classify() { self.type_id = self.value_arena[368640 + self.walk_depth]; transition self.metadata_arena[0 + self.type_id] { 1 -> scalar() 2 -> scalar() 3 -> scalar() 4 -> record() 5 -> array() 6 -> sum() _ -> bad() } }
    state scalar() { self.copy_leaf_to(self.type_id, self.value_arena[376832 + self.walk_depth], destination_base + self.value_arena[376832 + self.walk_depth]); self.walk_depth = self.walk_depth - 1; transition 0 { _ -> loop() } }
    state record() { self.found = self.metadata_arena[16384 + self.type_id]; self.walk_limit = self.metadata_arena[106496 + 256 + self.found]; transition self.value_arena[385024 + self.walk_depth] < self.walk_limit { true -> record_child() _ -> pop() } }
    state record_child() { self.walk_index = self.metadata_arena[106496 + 128 + self.found] + self.value_arena[385024 + self.walk_depth]; self.value_arena[385024 + self.walk_depth] = self.value_arena[385024 + self.walk_depth] + 1; self.type2 = self.metadata_arena[106496 + 8832 + self.walk_index]; self.offset = self.value_arena[376832 + self.walk_depth] + self.metadata_arena[106496 + 17024 + self.walk_index]; transition 0 { _ -> push() } }
    state array() { self.walk_limit = self.metadata_arena[24576 + self.type_id]; transition self.value_arena[385024 + self.walk_depth] < self.walk_limit { true -> array_child() _ -> pop() } }
    state array_child() { self.walk_index = self.value_arena[385024 + self.walk_depth]; self.value_arena[385024 + self.walk_depth] = self.value_arena[385024 + self.walk_depth] + 1; self.type2 = self.metadata_arena[16384 + self.type_id]; self.offset = self.value_arena[376832 + self.walk_depth] + self.walk_index * self.metadata_arena[49152 + self.type2]; transition 0 { _ -> push() } }
    state sum() { self.offset = self.value_arena[376832 + self.walk_depth]; self.code_byte(73); self.code_byte(129); self.code_byte(195); self.code_u32(self.offset); self.emit_sum_copy(self.type_id, destination_base + self.offset); self.code_byte(73); self.code_byte(129); self.code_byte(235); self.code_u32(self.offset); self.walk_depth = self.walk_depth - 1; transition 0 { _ -> loop() } }
    state push() { transition self.walk_depth < 8191 { true -> pushed() _ -> exhausted() } }
    state pushed() { self.walk_depth = self.walk_depth + 1; self.value_arena[368640 + self.walk_depth] = self.type2; self.value_arena[376832 + self.walk_depth] = self.offset; self.value_arena[385024 + self.walk_depth] = 0; transition 0 { _ -> loop() } }
    state pop() { self.walk_depth = self.walk_depth - 1; transition 0 { _ -> loop() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::emit_case_payload(&mut self, case: i32, destination_base: i32) {
    self.pass = 0;
    transition 0 { _ -> fields() }
    state fields() { transition self.pass < self.case_arena[12288 + case] { true -> field() _ -> done() } }
    state field() { self.k = self.case_arena[8192 + case] + self.pass; self.type_id = self.payload_arena[8192 + self.k]; self.offset = self.sum_arena[640 + self.case_arena[0 + case]] + self.payload_arena[12288 + self.k]; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> scalar() _ -> structural_kind() } }
    state scalar() { self.copy_leaf_to(self.type_id, self.offset, destination_base + self.offset); transition 0 { _ -> next() } }
    state structural_kind() { transition self.metadata_arena[0 + self.type_id] == 6 { true -> sum() _ -> structural_adjust() } }
    state structural_adjust() { self.code_byte(73); self.code_byte(129); self.code_byte(195); self.code_u32(self.offset); self.emit_copy_leaves(self.type_id, destination_base + self.offset); self.offset = self.sum_arena[640 + self.case_arena[0 + case]] + self.payload_arena[12288 + self.k]; self.code_byte(73); self.code_byte(129); self.code_byte(235); self.code_u32(self.offset); transition 0 { _ -> next() } }
    state sum() { self.code_byte(73); self.code_byte(129); self.code_byte(195); self.code_u32(self.offset); self.emit_sum_copy(self.type_id, destination_base + self.offset); self.code_byte(73); self.code_byte(129); self.code_byte(235); self.code_u32(self.offset); transition 0 { _ -> next() } }
    state next() { self.pass = self.pass + 1; transition 0 { _ -> fields() } }
    state done() { }
