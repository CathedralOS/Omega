    state copy_pass() { self.progress = 0; self.expected = 0; self.i = 0; transition 0 { _ -> copy_loop() } }
    state copy_loop() { transition self.i < self.type_count { true -> copy_unresolved() _ -> copy_pass_done() } }
    state copy_unresolved() { transition self.metadata_arena[81920 + self.i] == 0 { true -> copy_count() _ -> copy_next() } }
    state copy_count() { self.expected = self.expected + 1; transition self.metadata_arena[0 + self.i] { 4 -> copy_nominal() 5 -> copy_array() 6 -> copy_sum() _ -> bad() } }
    state copy_nominal() { self.found = self.metadata_arena[16384 + self.i]; transition self.metadata_arena[106496 + 384 + self.found] == 1 { true -> copy_fields_start() _ -> copy_false() } }
    state copy_fields_start() { self.j = self.metadata_arena[106496 + 128 + self.found]; self.end = self.j + self.metadata_arena[106496 + 256 + self.found]; self.copy_ok = 1; transition 0 { _ -> copy_fields() } }
    state copy_fields() { transition self.j < self.end { true -> copy_field() _ -> copy_commit() } }
