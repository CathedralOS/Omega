    state object_opcode() { transition self.operation_arena[65536 + self.i] == 13 { true -> object_owner() _ -> object_case_opcode() } }
    state object_case_opcode() { transition self.operation_arena[65536 + self.i] == 14 { true -> object_owner() _ -> object_next() } }
