    state child() { self.type_id = self.payload_arena[8192 + self.j]; transition self.metadata_arena[65536 + self.type_id] == 1 { true -> child_align() _ -> pending() } }
    state child_align() { self.k = self.metadata_arena[57344 + self.type_id]; transition self.k > 0 { true -> field_pad() _ -> bad() } }
    state field_pad() { self.found = (self.k - (self.offset % self.k)) % self.k; transition self.found <= 2147483647 - self.offset { true -> field_padded() _ -> bad() } }
    state field_padded() { self.offset = self.offset + self.found; self.payload_arena[12288 + self.j] = self.offset; transition self.metadata_arena[49152 + self.type_id] <= 2147483647 - self.offset { true -> field_sized() _ -> bad() } }
    state field_sized() { self.offset = self.offset + self.metadata_arena[49152 + self.type_id]; transition self.k > self.pad { true -> field_align_keep() _ -> field_next() } }
    state field_align_keep() { self.pad = self.k; transition 0 { _ -> field_next() } }
    state field_next() { self.j = self.j + 1; transition 0 { _ -> fields() } }
    state case_pad() { self.found = (self.pad - (self.offset % self.pad)) % self.pad; transition self.found <= 2147483647 - self.offset { true -> case_keep() _ -> bad() } }
    state case_keep() { self.offset = self.offset + self.found; self.case_arena[16384 + self.current_block] = self.offset; self.case_arena[20480 + self.current_block] = self.pad; transition self.offset > self.size { true -> size_keep() _ -> align_check() } }
    state size_keep() { self.size = self.offset; transition 0 { _ -> align_check() } }
    state align_check() { transition self.pad > self.align { true -> align_keep() _ -> case_next() } }
    state align_keep() { self.align = self.pad; transition 0 { _ -> case_next() } }
    state case_next() { self.current_block = self.current_block + 1; transition 0 { _ -> cases() } }
