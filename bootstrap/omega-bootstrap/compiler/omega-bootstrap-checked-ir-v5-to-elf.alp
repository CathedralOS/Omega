    state object_align() { self.type_id = self.operation_arena[163840 + self.i]; self.align_frame(self.metadata_arena[57344 + self.type_id]); transition self.status == 0 { true -> object_size() _ -> done() } }
    state object_size() { self.size = self.metadata_arena[49152 + self.type_id]; transition self.size == 0 { true -> object_anchor() _ -> object_bound() } }
    state object_anchor() { self.size = 1; transition 0 { _ -> object_bound() } }
    state object_bound() { transition self.size <= 262144 - self.frame_cursor { true -> object_keep() _ -> exhausted() } }
    state object_keep() { self.frame_cursor = self.frame_cursor + self.size; self.operation_arena[421888 + self.operation_arena[131072 + self.i]] = self.frame_cursor; transition 0 { _ -> object_next() } }
    state object_next() { self.i = self.i + 1; transition 0 { _ -> objects() } }
    state bindings_setup() { self.i = 0; self.current_block = 0; transition 0 { _ -> bindings() } }
    state bindings() { transition self.i < self.case_arm_arg_count { true -> binding_owner_seek() _ -> scratch_scan() } }
    state binding_owner_seek() { transition self.current_block < self.case_arm_count { true -> binding_owner_end() _ -> bad() } }
    state binding_owner_end() { self.end = self.case_arm_arena[12288 + self.current_block] + self.case_arm_arena[16384 + self.current_block]; transition self.i < self.end { true -> binding_machine() _ -> binding_owner_next() } }
