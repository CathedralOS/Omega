    state call_scratch_blocks() { transition self.i < self.end { true -> call_scratch_block() _ -> scratch_align() } }
    state call_scratch_block() { self.j = self.metadata_arena[106496 + 46720 + self.i]; self.k = self.j + self.metadata_arena[106496 + 48768 + self.i]; transition 0 { _ -> call_scratch_ops() } }
    state call_scratch_ops() { transition self.j < self.k { true -> call_scratch_op() _ -> call_scratch_next_block() } }
    state call_scratch_op() { transition self.operation_arena[65536 + self.j] == 10 { true -> call_scratch_count() _ -> call_scratch_next_op() } }
    state call_scratch_count() { self.call_arg_count = self.operation_arena[229376 + self.j] - 1; transition self.call_arg_count > self.scratch_count { true -> call_scratch_keep() _ -> call_scratch_next_op() } }
    state call_scratch_keep() { self.scratch_count = self.call_arg_count; transition 0 { _ -> call_scratch_next_op() } }
    state call_scratch_next_op() { self.j = self.j + 1; transition 0 { _ -> call_scratch_ops() } }
    state call_scratch_next_block() { self.i = self.i + 1; transition 0 { _ -> call_scratch_blocks() } }
