    transition 0 { _ -> loop() }
    state loop() { transition self.j < self.end { true -> child() _ -> final_pad() } }
    state child() { self.type_id = self.metadata_arena[106496 + 8832 + self.j]; transition self.metadata_arena[65536 + self.type_id] == 1 { true -> child_align() _ -> pending() } }
    state child_align() { transition self.metadata_arena[57344 + self.type_id] > 0 { true -> pad() _ -> bad() } }
    state pad() { self.pad = (self.metadata_arena[57344 + self.type_id] - (self.offset % self.metadata_arena[57344 + self.type_id])) % self.metadata_arena[57344 + self.type_id]; transition self.pad <= 2147483647 - self.offset { true -> padded() _ -> bad() } }
    state padded() { self.offset = self.offset + self.pad; self.metadata_arena[106496 + 17024 + self.j] = self.offset; transition self.metadata_arena[49152 + self.type_id] <= 2147483647 - self.offset { true -> sized() _ -> bad() } }
    state sized() { self.offset = self.offset + self.metadata_arena[49152 + self.type_id]; transition self.metadata_arena[57344 + self.type_id] > self.align { true -> larger_align() _ -> next() } }
    state larger_align() { self.align = self.metadata_arena[57344 + self.type_id]; transition 0 { _ -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> loop() } }
    state final_pad() { self.pad = (self.align - (self.offset % self.align)) % self.align; transition self.pad <= 2147483647 - self.offset { true -> complete() _ -> bad() } }
    state complete() { self.size = self.offset + self.pad; self.copy_ok = 1; transition 0 { _ -> done() } }
    state pending() { transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::try_sum_layout(&mut self, sum: i32) {
    self.copy_ok = 0; self.size = 0; self.align = 1;
    self.current_block = self.sum_arena[128 + sum]; self.end = self.current_block + self.sum_arena[256 + sum];
    transition 0 { _ -> cases() }
