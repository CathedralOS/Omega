// Delta-written front end for the frozen Omega O0/O1 vertical canaries and the
// bounded, profile-neutral scalar in-module call/return conformance slice.
//
// Input is one canonical OMEGA_BOOTSTRAP_BUNDLE.md version-1 bundle. Every
// source unit is retained with its label and descriptor, validated independently,
// and decoded before publication. This bounded canary accepts exactly one
// nontrivial O1 source plus empty/trivia-only source units; it never concatenates
// units or permits tokens to cross a source boundary. The accepted program source
// is the complete O1 grammar, not a prefix. O1 extends O0's one write with zero
// through sixteen ordered literal write_line statements and retains their
// decoded bytes in one checked aggregate table. The parser retains the one
// final exit_process i32 literal in `exit_code`. Success exits with
//
//     (sum(all decoded text bytes) + exit_code) % 251
//
// so both operands remain observable after the accepted program streams its
// canonical terminal-Psi module to stdout.
// Scalar-call success exits 0 after streaming a proof-free vocabulary-28
// module. Exit 251 is malformed/out-of-profile input and 252 is checked
// local-storage exhaustion. O1 deliberately admits only ASCII identifiers, decimal
// unsuffixed nonnegative i32 literals, and cooked strings with the basic byte
// escapes handled below; the complete source is nevertheless UTF-8 validated.
// The scalar lane's unique zero-parameter, indegree-zero machine is a bounded
// conformance-adapter entry convention only. It is not Omega's authored,
// target-qualified target::ProgramEntry root binding.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
}

data Main {
    console: Console;
    status: i32; decoded: i32; c: i32; i: i32; j: i32; k: i32; n: i32; pos: i32;
    source_count: i32; entry: i32; source_id: i32;
    label_len: i32; content_len: i32; label_used: i32; source_used: i32;
    label_start: i32; source_start: i32; source_end: i32;
    prev_start: i32; prev_len: i32; unit_start: i32; unit_end: i32;
    program_count: i32; program_source_id: i32; program_start: i32; program_end: i32;
    trivia_ok: i32; comment_depth: i32; segment_len: i32;
    segment_first: i32; segment_second: i32; char_ok: i32;
    tok: i32; tok_start: i32; tok_len: i32; int_value: i32;
    int_min_magnitude: i32; retain_text: i32; profile: i32;
    text_len: i32; text_start: i32; text_used: i32; text_sum: i32;
    write_count: i32; emit_index: i32; exit_code: i32;
    match_base: i32; match_len: i32; match_ok: i32;
    b1: i32; b2: i32; b3: i32; digit: i32;
    machine_count: i32; param_used: i32; op_used: i32; arg_used: i32;
    current_machine: i32; root_machine: i32; root_count: i32;
    frame_count: i32; value_ref: i32; return_ref: i32;
    ident_start: i32; ident_len: i32; literal_value: i32;
    operation_next: i32; value_next: i32; visited_count: i32;
    candidate: i32; compare_result: i32; cmp_i: i32;
    terminal_size: i32; id_value: i32; scalar_emit_machine: i32;
    source: [u8; 2048];
    labels: [u8; 1024];
    // Four cells per source ID: label start/length, source start/length.
    descriptors: [i32; 64];
    text: [u8; 1024];
    text_starts: [i32; 16];
    text_lengths: [i32; 16];
    names: [u8; 96];

    // Bounded scalar-call retained IR. Names remain exact spans in `source`.
    machine_name_starts: [i32; 16]; machine_name_lengths: [i32; 16];
    machine_body_starts: [i32; 16]; machine_body_ends: [i32; 16];
    machine_param_starts: [i32; 16]; machine_param_counts: [i32; 16];
    machine_op_starts: [i32; 16]; machine_op_counts: [i32; 16];
    machine_return_refs: [i32; 16]; machine_result_ids: [i32; 16];
    machine_ids: [i32; 16]; machine_order: [i32; 16];
    machine_indegrees: [i32; 16]; machine_seen: [i32; 16];
    param_name_starts: [i32; 64]; param_name_lengths: [i32; 64];
    param_owners: [i32; 64]; param_value_ids: [i32; 64];
    op_kinds: [i32; 256]; op_owners: [i32; 256];
    op_literals: [i32; 256]; op_callees: [i32; 256];
    op_arg_starts: [i32; 256]; op_arg_counts: [i32; 256];
    op_result_ids: [i32; 256]; op_ids: [i32; 256];
    arg_refs: [i32; 1024]; call_graph: [i32; 256];
    frame_callees: [i32; 16]; frame_arg_counts: [i32; 16];
    frame_arg_refs: [i32; 64];
}

machine Main::read_u32(&mut self) {
    self.decoded = 0 - 1;
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> byte0() }
    state byte0() { self.decoded = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> byte1() } }
    state byte1() { self.decoded = self.decoded + self.c * 256; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> byte2() } }
    state byte2() { self.decoded = self.decoded + self.c * 65536; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> range() } }
    state range() { transition self.c < 128 { true -> byte3() false -> bad() } }
    state byte3() { self.decoded = self.decoded + self.c * 16777216; transition 0 { _ -> done() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::check_label_byte(&mut self) {
    self.char_ok = 0;
    transition self.c >= 65 { true -> upper() false -> digit0() }
    state upper() { transition self.c < 91 { true -> yes() false -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower() false -> digit0() } }
    state lower() { transition self.c < 123 { true -> yes() false -> digit0() } }
    state digit0() { transition self.c >= 48 { true -> digit1() false -> dot() } }
    state digit1() { transition self.c < 58 { true -> yes() false -> dot() } }
    state dot() { transition self.c == 46 { true -> yes() false -> under() } }
    state under() { transition self.c == 95 { true -> yes() false -> dash() } }
    state dash() { transition self.c == 45 { true -> yes() false -> slash() } }
    state slash() { transition self.c == 47 { true -> yes() false -> no() } }
    state yes() { self.char_ok = 1; }
    state no() { }
}

machine Main::finish_label_segment(&mut self) {
    transition self.segment_len > 0 { true -> dot1() false -> bad() }
    state dot1() { transition self.segment_len == 1 { true -> single() false -> dot2() } }
    state single() { transition self.segment_first == 46 { true -> bad() false -> good() } }
    state dot2() { transition self.segment_len == 2 { true -> double() false -> good() } }
    state double() { transition self.segment_first == 46 { true -> double2() false -> good() } }
    state double2() { transition self.segment_second == 46 { true -> bad() false -> good() } }
    state bad() { self.status = 251; }
    state good() { }
}

machine Main::read_label(&mut self) {
    self.i = 0;
    self.segment_len = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.label_len { true -> read() false -> finish() } }
    state read() { self.c = read_byte(); transition self.c < 0 { true -> bad() false -> classify() } }
    state classify() { self.check_label_byte(); transition self.char_ok == 1 { true -> slash_check() false -> bad() } }
    state slash_check() { transition self.c == 47 { true -> slash() false -> character() } }
    state slash() { self.finish_label_segment(); transition self.status == 0 { true -> store_slash() false -> done() } }
    state store_slash() { self.labels[self.label_start + self.i] = self.c; self.i = self.i + 1; self.segment_len = 0; transition 0 { _ -> loop() } }
    state character() { transition self.segment_len == 0 { true -> first() false -> second_check() } }
    state first() { self.segment_first = self.c; transition 0 { _ -> store() } }
    state second_check() { transition self.segment_len == 1 { true -> second() false -> store() } }
    state second() { self.segment_second = self.c; transition 0 { _ -> store() } }
    state store() { self.labels[self.label_start + self.i] = self.c; self.i = self.i + 1; self.segment_len = self.segment_len + 1; transition 0 { _ -> loop() } }
    state finish() { self.finish_label_segment(); transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_source(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.content_len { true -> read() false -> done() } }
    state read() { self.c = read_byte(); transition self.c < 0 { true -> bad() false -> store() } }
    state store() { self.source[self.source_start + self.i] = self.c; self.i = self.i + 1; transition 0 { _ -> loop() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::check_label_order(&mut self) {
    transition self.entry == 0 { true -> good() false -> setup() }
    state setup() {
        self.prev_start = self.descriptors[(self.entry - 1) * 4];
        self.prev_len = self.descriptors[(self.entry - 1) * 4 + 1];
        self.i = 0;
        transition 0 { _ -> loop() }
    }
    state loop() { transition self.i < self.prev_len { true -> current_bound() false -> prev_end() } }
    state current_bound() { transition self.i < self.label_len { true -> compare() false -> bad() } }
    state compare() { transition self.labels[self.label_start + self.i] == self.labels[self.prev_start + self.i] { true -> advance() false -> greater() } }
    state greater() { transition self.labels[self.label_start + self.i] > self.labels[self.prev_start + self.i] { true -> good() false -> bad() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state prev_end() { transition self.label_len > self.prev_len { true -> good() false -> bad() } }
    state bad() { self.status = 251; }
    state good() { }
}

machine Main::read_entry(&mut self) {
    self.read_u32();
    transition self.status == 0 { true -> label_value() false -> done() }
    state label_value() { self.label_len = self.decoded; transition self.label_len > 0 { true -> label_limit() false -> bad() } }
    state label_limit() { transition self.label_len < 65 { true -> label_capacity() false -> exhausted() } }
    state label_capacity() { transition self.label_len <= 1024 - self.label_used { true -> content_size() false -> exhausted() } }
    state content_size() { self.read_u32(); transition self.status == 0 { true -> content_value() false -> done() } }
    state content_value() { self.content_len = self.decoded; transition self.content_len <= 2048 - self.source_used { true -> retain() false -> exhausted() } }
    state retain() {
        self.label_start = self.label_used;
        self.source_start = self.source_used;
        self.descriptors[self.entry * 4] = self.label_start;
        self.descriptors[self.entry * 4 + 1] = self.label_len;
        self.descriptors[self.entry * 4 + 2] = self.source_start;
        self.descriptors[self.entry * 4 + 3] = self.content_len;
        self.read_label();
        transition self.status == 0 { true -> order() false -> done() }
    }
    state order() { self.check_label_order(); transition self.status == 0 { true -> content() false -> done() } }
    state content() { self.read_source(); transition self.status == 0 { true -> retained() false -> done() } }
    state retained() { self.label_used = self.label_used + self.label_len; self.source_used = self.source_used + self.content_len; transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode_bundle(&mut self) {
    self.c = read_byte(); transition self.c == 79 { true -> magic1() false -> bad() }
    state magic1() { self.c = read_byte(); transition self.c == 77 { true -> magic2() false -> bad() } }
    state magic2() { self.c = read_byte(); transition self.c == 71 { true -> magic3() false -> bad() } }
    state magic3() { self.c = read_byte(); transition self.c == 48 { true -> magic4() false -> bad() } }
    state magic4() { self.c = read_byte(); transition self.c == 66 { true -> magic5() false -> bad() } }
    state magic5() { self.c = read_byte(); transition self.c == 78 { true -> magic6() false -> bad() } }
    state magic6() { self.c = read_byte(); transition self.c == 68 { true -> magic7() false -> bad() } }
    state magic7() { self.c = read_byte(); transition self.c == 76 { true -> version() false -> bad() } }
    state version() { self.read_u32(); transition self.status == 0 { true -> version_value() false -> done() } }
    state version_value() { transition self.decoded == 1 { true -> count() false -> bad() } }
    state count() { self.read_u32(); transition self.status == 0 { true -> count_value() false -> done() } }
    state count_value() { self.source_count = self.decoded; transition self.source_count > 0 { true -> count_capacity() false -> bad() } }
    state count_capacity() { transition self.source_count < 17 { true -> entries_begin() false -> exhausted() } }
    state entries_begin() { self.entry = 0; self.label_used = 0; self.source_used = 0; transition 0 { _ -> entries() } }
    state entries() { transition self.entry < self.source_count { true -> entry_read() false -> eof() } }
    state entry_read() { self.read_entry(); transition self.status == 0 { true -> entry_next() false -> done() } }
    state entry_next() { self.entry = self.entry + 1; transition 0 { _ -> entries() } }
    state eof() { self.c = read_byte(); transition self.c < 0 { true -> done() false -> bad() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

// Validate one retained source unit as canonical UTF-8. `unit_start` and
// `unit_end` are exact descriptor bounds, so a sequence cannot continue in the
// next source unit.
machine Main::validate_utf8(&mut self) {
    self.i = self.unit_start;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.unit_end { true -> byte() false -> done() } }
    state byte() { self.c = self.source[self.i]; transition self.c < 128 { true -> ascii() false -> two_low() } }
    state ascii() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state two_low() { transition self.c >= 194 { true -> two_high() false -> bad() } }
    state two_high() { transition self.c < 224 { true -> need1() false -> three_low() } }
    state need1() { transition self.i + 1 < self.unit_end { true -> cont1() false -> bad() } }
    state cont1() { self.b1 = self.source[self.i + 1]; transition self.b1 >= 128 { true -> cont1_high() false -> bad() } }
    state cont1_high() { transition self.b1 < 192 { true -> advance2() false -> bad() } }
    state advance2() { self.i = self.i + 2; transition 0 { _ -> loop() } }
    state three_low() { transition self.c >= 224 { true -> three_high() false -> bad() } }
    state three_high() { transition self.c < 240 { true -> need2() false -> four_low() } }
    state need2() { transition self.i + 2 < self.unit_end { true -> load2() false -> bad() } }
    state load2() { self.b1 = self.source[self.i + 1]; self.b2 = self.source[self.i + 2]; transition self.b2 >= 128 { true -> cont2_high() false -> bad() } }
    state cont2_high() { transition self.b2 < 192 { true -> three_first_low() false -> bad() } }
    state three_first_low() { transition self.b1 >= 128 { true -> three_first_high() false -> bad() } }
    state three_first_high() { transition self.b1 < 192 { true -> e0() false -> bad() } }
    state e0() { transition self.c == 224 { true -> e0_bound() false -> ed() } }
    state e0_bound() { transition self.b1 >= 160 { true -> advance3() false -> bad() } }
    state ed() { transition self.c == 237 { true -> ed_bound() false -> advance3() } }
    state ed_bound() { transition self.b1 < 160 { true -> advance3() false -> bad() } }
    state advance3() { self.i = self.i + 3; transition 0 { _ -> loop() } }
    state four_low() { transition self.c >= 240 { true -> four_high() false -> bad() } }
    state four_high() { transition self.c < 245 { true -> need3() false -> bad() } }
    state need3() { transition self.i + 3 < self.unit_end { true -> load3() false -> bad() } }
    state load3() { self.b1 = self.source[self.i + 1]; self.b2 = self.source[self.i + 2]; self.b3 = self.source[self.i + 3]; transition self.b1 >= 128 { true -> four_b1_high() false -> bad() } }
    state four_b1_high() { transition self.b1 < 192 { true -> four_b2_low() false -> bad() } }
    state four_b2_low() { transition self.b2 >= 128 { true -> four_b2_high() false -> bad() } }
    state four_b2_high() { transition self.b2 < 192 { true -> four_b3_low() false -> bad() } }
    state four_b3_low() { transition self.b3 >= 128 { true -> four_b3_high() false -> bad() } }
    state four_b3_high() { transition self.b3 < 192 { true -> f0() false -> bad() } }
    state f0() { transition self.c == 240 { true -> f0_bound() false -> f4() } }
    state f0_bound() { transition self.b1 >= 144 { true -> advance4() false -> bad() } }
    state f4() { transition self.c == 244 { true -> f4_bound() false -> advance4() } }
    state f4_bound() { transition self.b1 < 144 { true -> advance4() false -> bad() } }
    state advance4() { self.i = self.i + 4; transition 0 { _ -> loop() } }
    state bad() { self.status = 251; }
    state done() { }
}

// Skip one nested block comment without crossing the caller's exact source-unit
// bound in `n`. The caller positions `pos` at the opening slash. Unterminated
// comments are malformed source, including when another unit begins with the
// bytes that would otherwise close the comment.
machine Main::skip_block_comment(&mut self) {
    self.pos = self.pos + 2; self.comment_depth = 1;
    transition 0 { _ -> loop() }
    state loop() { transition self.pos < self.n { true -> byte() false -> bad() } }
    state byte() { self.c = self.source[self.pos]; transition self.c == 47 { true -> open_bound() false -> close_first() } }
    state open_bound() { transition self.pos + 1 < self.n { true -> open_second() false -> advance() } }
    state open_second() { transition self.source[self.pos + 1] == 42 { true -> open() false -> advance() } }
    state open() { self.comment_depth = self.comment_depth + 1; self.pos = self.pos + 2; transition 0 { _ -> loop() } }
    state close_first() { transition self.c == 42 { true -> close_bound() false -> advance() } }
    state close_bound() { transition self.pos + 1 < self.n { true -> close_second() false -> advance() } }
    state close_second() { transition self.source[self.pos + 1] == 47 { true -> close() false -> advance() } }
    state close() { self.comment_depth = self.comment_depth - 1; self.pos = self.pos + 2; transition self.comment_depth == 0 { true -> done() false -> loop() } }
    state advance() { self.pos = self.pos + 1; transition 0 { _ -> loop() } }
    state bad() { self.status = 251; }
    state done() { }
}

// Decide whether one independently bounded unit contains only O1 whitespace,
// line comments, and nested block comments. This is deliberately not a package
// or module parser: it only separates auxiliary trivia from the one O1
// program-bearing unit.
machine Main::classify_trivia(&mut self) {
    self.i = self.unit_start; self.trivia_ok = 1;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.unit_end { true -> byte() false -> done() } }
    state byte() { self.c = self.source[self.i]; transition self.c == 32 { true -> advance() false -> lf() } }
    state lf() { transition self.c == 10 { true -> advance() false -> cr() } }
    state cr() { transition self.c == 13 { true -> advance() false -> tab() } }
    state tab() { transition self.c == 9 { true -> advance() false -> slash() } }
    state slash() { transition self.c == 47 { true -> slash_bound() false -> nontrivial() } }
    state slash_bound() { transition self.i + 1 < self.unit_end { true -> slash_second() false -> nontrivial() } }
    state slash_second() { transition self.source[self.i + 1] == 47 { true -> comment_begin() false -> block_second() } }
    state block_second() { transition self.source[self.i + 1] == 42 { true -> block_begin() false -> nontrivial() } }
    state block_begin() {
        self.pos = self.i; self.n = self.unit_end; self.skip_block_comment(); self.i = self.pos;
        transition self.status == 0 { true -> loop() false -> done() }
    }
    state comment_begin() { self.i = self.i + 2; transition 0 { _ -> comment() } }
    state comment() { transition self.i < self.unit_end { true -> comment_byte() false -> done() } }
    state comment_byte() { transition self.source[self.i] == 10 { true -> advance() false -> comment_advance() } }
    state comment_advance() { self.i = self.i + 1; transition 0 { _ -> comment() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state nontrivial() { self.trivia_ok = 0; }
    state done() { }
}

// Validate every source unit before choosing the one program-bearing unit.
// Source ID is the descriptor index; parser offsets remain absolute internally
// and label-local as `pos - source_start` for diagnostics.
machine Main::validate_sources(&mut self) {
    self.source_id = 0;
    transition 0 { _ -> utf8_loop() }
    state utf8_loop() { transition self.source_id < self.source_count { true -> utf8_load() false -> classify_begin() } }
    state utf8_load() {
        self.unit_start = self.descriptors[self.source_id * 4 + 2];
        self.unit_end = self.unit_start + self.descriptors[self.source_id * 4 + 3];
        self.validate_utf8();
        transition self.status == 0 { true -> utf8_next() false -> done() }
    }
    state utf8_next() { self.source_id = self.source_id + 1; transition 0 { _ -> utf8_loop() } }
    state classify_begin() { self.source_id = 0; self.program_count = 0; transition 0 { _ -> classify_loop() } }
    state classify_loop() { transition self.source_id < self.source_count { true -> classify_load() false -> require_program() } }
    state classify_load() {
        self.unit_start = self.descriptors[self.source_id * 4 + 2];
        self.unit_end = self.unit_start + self.descriptors[self.source_id * 4 + 3];
        self.classify_trivia();
        transition self.status == 0 { true -> classify_result() false -> done() }
    }
    state classify_result() { transition self.trivia_ok == 1 { true -> classify_next() false -> program() } }
    state program() { transition self.program_count == 0 { true -> save_program() false -> bad() } }
    state save_program() {
        self.program_count = 1;
        self.program_source_id = self.source_id;
        self.program_start = self.unit_start;
        self.program_end = self.unit_end;
        transition 0 { _ -> classify_next() }
    }
    state classify_next() { self.source_id = self.source_id + 1; transition 0 { _ -> classify_loop() } }
    state require_program() { transition self.program_count == 1 { true -> selected() false -> bad() } }
    state selected() {
        self.source_start = self.program_start;
        self.source_end = self.program_end;
        self.n = self.program_end;
        transition 0 { _ -> done() }
    }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::is_ident_start(&mut self) {
    self.char_ok = 0;
    transition self.c == 95 { true -> yes() false -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() false -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() false -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() false -> no() } }
    state lower1() { transition self.c < 123 { true -> yes() false -> no() } }
    state yes() { self.char_ok = 1; }
    state no() { }
}

machine Main::is_ident_continue(&mut self) {
    self.is_ident_start();
    transition self.char_ok == 1 { true -> done() false -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() false -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() false -> done() } }
    state yes() { self.char_ok = 1; }
    state done() { }
}

machine Main::hex_value(&mut self) {
    self.digit = 0 - 1;
    transition self.c >= 48 { true -> digit1() false -> upper0() }
    state digit1() { transition self.c < 58 { true -> digit() false -> upper0() } }
    state digit() { self.digit = self.c - 48; transition 0 { _ -> done() } }
    state upper0() { transition self.c >= 65 { true -> upper1() false -> lower0() } }
    state upper1() { transition self.c < 71 { true -> upper() false -> lower0() } }
    state upper() { self.digit = self.c - 55; transition 0 { _ -> done() } }
    state lower0() { transition self.c >= 97 { true -> lower1() false -> done() } }
    state lower1() { transition self.c < 103 { true -> lower() false -> done() } }
    state lower() { self.digit = self.c - 87; }
    state done() { }
}

machine Main::append_text(&mut self) {
    transition self.text_used < 1024 { true -> store() false -> exhausted() }
    state store() {
        self.text[self.text_used] = self.c;
        self.text_used = self.text_used + 1;
        self.text_len = self.text_len + 1;
        self.text_sum = (self.text_sum + self.c) % 251;
        transition 0 { _ -> done() }
    }
    state exhausted() { self.status = 252; }
    state done() { }
}

machine Main::scan_string(&mut self) {
    self.pos = self.pos + 1; self.text_start = self.text_used; self.text_len = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.pos < self.n { true -> byte() false -> eof() } }
    state byte() { self.c = self.source[self.pos]; transition self.c == 34 { true -> complete() false -> slash() } }
    state slash() { transition self.c == 92 { true -> escape_begin() false -> control() } }
    state control() { transition self.c >= 32 { true -> store() false -> bad() } }
    state store() { transition self.retain_text == 1 { true -> retain() false -> next() } }
    state retain() { self.append_text(); transition self.status == 0 { true -> next() false -> done() } }
    state next() { self.pos = self.pos + 1; transition 0 { _ -> loop() } }
    state escape_begin() { self.pos = self.pos + 1; transition self.pos < self.n { true -> escape_byte() false -> bad() } }
    state escape_byte() { self.c = self.source[self.pos]; transition self.c == 110 { true -> escape_n() false -> escape_r_check() } }
    state escape_n() { self.c = 10; transition 0 { _ -> escape_store() } }
    state escape_r_check() { transition self.c == 114 { true -> escape_r() false -> escape_t_check() } }
    state escape_r() { self.c = 13; transition 0 { _ -> escape_store() } }
    state escape_t_check() { transition self.c == 116 { true -> escape_t() false -> escape_0_check() } }
    state escape_t() { self.c = 9; transition 0 { _ -> escape_store() } }
    state escape_0_check() { transition self.c == 48 { true -> escape_0() false -> escape_quote_check() } }
    state escape_0() { self.c = 0; transition 0 { _ -> escape_store() } }
    state escape_quote_check() { transition self.c == 34 { true -> escape_store() false -> escape_slash_check() } }
    state escape_slash_check() { transition self.c == 92 { true -> escape_store() false -> escape_x_check() } }
    state escape_x_check() { transition self.c == 120 { true -> escape_x_bound() false -> bad() } }
    state escape_x_bound() { transition self.pos + 2 < self.n { true -> escape_x1() false -> bad() } }
    state escape_x1() { self.c = self.source[self.pos + 1]; self.hex_value(); transition self.digit >= 0 { true -> escape_x1_save() false -> bad() } }
    state escape_x1_save() { self.b1 = self.digit; self.c = self.source[self.pos + 2]; self.hex_value(); transition self.digit >= 0 { true -> escape_x2_save() false -> bad() } }
    state escape_x2_save() { self.c = self.b1 * 16 + self.digit; self.pos = self.pos + 2; transition 0 { _ -> escape_store() } }
    state escape_store() { transition self.retain_text == 1 { true -> escape_retain() false -> next() } }
    state escape_retain() { self.append_text(); transition self.status == 0 { true -> next() false -> done() } }
    state complete() { self.pos = self.pos + 1; self.tok = 258; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state eof() { self.status = 251; transition 0 { _ -> done() } }
    state bad() { self.status = 251; }
    state done() { }
}

// Token kinds: 0 EOF, 256 identifier, 257 integer, 258 cooked string; ASCII
// punctuation uses its byte value directly.
machine Main::next_token(&mut self) {
    self.tok = 0;
    self.tok_len = 0;
    self.int_min_magnitude = 0;
    transition self.status == 0 { true -> skip() false -> done() }
    state skip() { transition self.pos < self.n { true -> skip_byte() false -> eof() } }
    state skip_byte() { self.c = self.source[self.pos]; transition self.c == 32 { true -> skip_advance() false -> skip_lf() } }
    state skip_lf() { transition self.c == 10 { true -> skip_advance() false -> skip_cr() } }
    state skip_cr() { transition self.c == 13 { true -> skip_advance() false -> skip_tab() } }
    state skip_tab() { transition self.c == 9 { true -> skip_advance() false -> slash() } }
    state skip_advance() { self.pos = self.pos + 1; transition 0 { _ -> skip() } }
    state slash() { transition self.c == 47 { true -> slash_bound() false -> classify() } }
    state slash_bound() { transition self.pos + 1 < self.n { true -> slash_second() false -> classify() } }
    state slash_second() { transition self.source[self.pos + 1] == 47 { true -> comment_advance() false -> block_second() } }
    state block_second() { transition self.source[self.pos + 1] == 42 { true -> block_comment() false -> classify() } }
    state block_comment() { self.skip_block_comment(); transition self.status == 0 { true -> skip() false -> done() } }
    state comment_advance() { self.pos = self.pos + 2; transition 0 { _ -> comment() } }
    state comment() { transition self.pos < self.n { true -> comment_byte() false -> eof() } }
    state comment_byte() { transition self.source[self.pos] == 10 { true -> skip_advance() false -> comment_next() } }
    state comment_next() { self.pos = self.pos + 1; transition 0 { _ -> comment() } }
    state classify() {
        self.tok_start = self.pos;
        self.is_ident_start();
        transition self.char_ok == 1 { true -> ident_begin() false -> digit0() }
    }
    state ident_begin() { self.pos = self.pos + 1; transition 0 { _ -> ident_loop() } }
    state ident_loop() { transition self.pos < self.n { true -> ident_byte() false -> ident_done() } }
    state ident_byte() { self.c = self.source[self.pos]; self.is_ident_continue(); transition self.char_ok == 1 { true -> ident_next() false -> ident_done() } }
    state ident_next() { self.pos = self.pos + 1; transition 0 { _ -> ident_loop() } }
    state ident_done() { self.tok = 256; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state digit0() { transition self.c >= 48 { true -> digit1() false -> quote() } }
    state digit1() { transition self.c < 58 { true -> integer_begin() false -> quote() } }
    state integer_begin() { self.int_value = 0; transition 0 { _ -> integer_loop() } }
    state integer_loop() { transition self.pos < self.n { true -> integer_byte() false -> integer_done() } }
    state integer_byte() { self.c = self.source[self.pos]; transition self.c >= 48 { true -> integer_digit_high() false -> integer_done() } }
    state integer_digit_high() { transition self.c < 58 { true -> integer_bound() false -> integer_done() } }
    state integer_bound() { transition self.int_value < 214748364 { true -> integer_add() false -> integer_last_bound() } }
    state integer_last_bound() { transition self.int_value == 214748364 { true -> integer_last_digit() false -> integer_bad() } }
    state integer_last_digit() { transition self.c < 56 { true -> integer_add() false -> integer_min_check() } }
    state integer_min_check() { transition self.c == 56 { true -> integer_min() false -> integer_bad() } }
    state integer_min() {
        self.int_value = 0 - 1073741824 - 1073741824;
        self.int_min_magnitude = 1;
        self.pos = self.pos + 1;
        transition 0 { _ -> integer_min_tail() }
    }
    state integer_min_tail() { transition self.pos < self.n { true -> integer_min_byte() false -> integer_done() } }
    state integer_min_byte() { self.c = self.source[self.pos]; transition self.c >= 48 { true -> integer_min_digit_high() false -> integer_done() } }
    state integer_min_digit_high() { transition self.c < 58 { true -> integer_bad() false -> integer_done() } }
    state integer_bad() { self.status = 251; transition 0 { _ -> done() } }
    state integer_add() { self.digit = self.c - 48; self.int_value = self.int_value * 10 + self.digit; self.pos = self.pos + 1; transition 0 { _ -> integer_loop() } }
    state integer_done() { self.tok = 257; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state quote() { transition self.c == 34 { true -> string_call() false -> nul() } }
    state nul() { transition self.c == 0 { true -> invalid_byte() false -> punctuation() } }
    state invalid_byte() { self.status = 251; transition 0 { _ -> done() } }
    state string_call() { self.scan_string(); transition 0 { _ -> done() } }
    state punctuation() { self.tok = self.c; self.tok_len = 1; self.pos = self.pos + 1; transition 0 { _ -> done() } }
    state eof() { self.tok = 0; self.tok_start = self.pos; }
    state done() { }
}

machine Main::init_names(&mut self) {
    // useomegalanguagestdconsoledataMainConsolemachinemainmutselfwrite_lineexit_processreturni32
    self.names[0]=117; self.names[1]=115; self.names[2]=101;
    self.names[3]=111; self.names[4]=109; self.names[5]=101; self.names[6]=103; self.names[7]=97;
    self.names[8]=108; self.names[9]=97; self.names[10]=110; self.names[11]=103; self.names[12]=117; self.names[13]=97; self.names[14]=103; self.names[15]=101;
    self.names[16]=115; self.names[17]=116; self.names[18]=100;
    self.names[19]=99; self.names[20]=111; self.names[21]=110; self.names[22]=115; self.names[23]=111; self.names[24]=108; self.names[25]=101;
    self.names[26]=100; self.names[27]=97; self.names[28]=116; self.names[29]=97;
    self.names[30]=77; self.names[31]=97; self.names[32]=105; self.names[33]=110;
    self.names[34]=67; self.names[35]=111; self.names[36]=110; self.names[37]=115; self.names[38]=111; self.names[39]=108; self.names[40]=101;
    self.names[41]=109; self.names[42]=97; self.names[43]=99; self.names[44]=104; self.names[45]=105; self.names[46]=110; self.names[47]=101;
    self.names[48]=109; self.names[49]=97; self.names[50]=105; self.names[51]=110;
    self.names[52]=109; self.names[53]=117; self.names[54]=116;
    self.names[55]=115; self.names[56]=101; self.names[57]=108; self.names[58]=102;
    self.names[59]=119; self.names[60]=114; self.names[61]=105; self.names[62]=116; self.names[63]=101;
    self.names[64]=95; self.names[65]=108; self.names[66]=105; self.names[67]=110; self.names[68]=101;
    self.names[69]=101; self.names[70]=120; self.names[71]=105; self.names[72]=116; self.names[73]=95; self.names[74]=112;
    self.names[75]=114; self.names[76]=111; self.names[77]=99; self.names[78]=101; self.names[79]=115; self.names[80]=115;
    self.names[81]=114; self.names[82]=101; self.names[83]=116; self.names[84]=117; self.names[85]=114; self.names[86]=110;
    self.names[87]=105; self.names[88]=51; self.names[89]=50;
}

machine Main::match_name(&mut self, base: i32, count: i32) {
    self.match_ok = 0; self.match_base = base; self.match_len = count;
    transition self.tok == 256 { true -> length() false -> done() }
    state length() { transition self.tok_len == self.match_len { true -> setup() false -> done() } }
    state setup() { self.i = 0; transition 0 { _ -> loop() } }
    state loop() { transition self.i < self.match_len { true -> compare() false -> yes() } }
    state compare() { transition self.source[self.tok_start + self.i] == self.names[self.match_base + self.i] { true -> advance() false -> done() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::expect_name(&mut self, base: i32, count: i32) {
    transition self.status == 0 { true -> compare_name() false -> done() }
    state compare_name() { self.match_name(base, count); transition 0 { _ -> matched() } }
    state matched() {
    transition self.match_ok == 1 { true -> advance() false -> bad() }
    }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::expect_token(&mut self, expected: i32) {
    transition self.status == 0 { true -> compare_token() false -> done() }
    state compare_token() { transition self.tok == expected { true -> advance() false -> bad() } }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::parse_o1(&mut self) {
    self.retain_text = 1; self.pos = self.source_start; self.next_token();
    self.expect_name(0,3); self.expect_name(3,5); self.expect_token(58); self.expect_token(58);
    self.expect_name(8,8); self.expect_token(58); self.expect_token(58); self.expect_name(16,3);
    self.expect_token(58); self.expect_token(58); self.expect_name(19,7); self.expect_token(59);
    transition self.status == 0 { true -> data_decl() false -> done() }
    state data_decl() {
        self.expect_name(26,4); self.expect_name(30,4); self.expect_token(123);
        self.expect_name(19,7); self.expect_token(58); self.expect_name(34,7); self.expect_token(59); self.expect_token(125);
        transition self.status == 0 { true -> machine_decl() false -> done() }
    }
    state machine_decl() {
        self.expect_name(41,7); self.expect_name(30,4); self.expect_token(58); self.expect_token(58); self.expect_name(48,4);
        self.expect_token(40); self.expect_token(38); self.expect_name(52,3); self.expect_name(55,4); self.expect_token(41); self.expect_token(123);
        transition self.status == 0 { true -> body() false -> done() }
    }
    state body() {
        self.expect_name(55,4); self.expect_token(46); self.expect_name(19,7); self.expect_token(46);
        transition self.status == 0 { true -> operation() false -> done() }
    }
    state operation() { self.match_name(59,10); transition self.match_ok == 1 { true -> write_capacity() false -> exit_match() } }
    state write_capacity() { transition self.write_count < 16 { true -> write_call() false -> exhausted() } }
    state write_call() { self.expect_name(59,10); self.expect_token(40); transition self.status == 0 { true -> write_argument() false -> done() } }
    state write_argument() { transition self.tok == 258 { true -> save_text() false -> bad() } }
    state save_text() {
        self.text_starts[self.write_count] = self.text_start;
        self.text_lengths[self.write_count] = self.text_len;
        self.write_count = self.write_count + 1;
        self.next_token(); self.expect_token(41); self.expect_token(59);
        transition self.status == 0 { true -> body() false -> done() }
    }
    state exit_match() { self.match_name(69,12); transition self.match_ok == 1 { true -> exit_call() false -> bad() } }
    state exit_call() {
        self.expect_name(69,12); self.expect_token(40);
        transition self.status == 0 { true -> exit_argument() false -> done() }
    }
    state exit_argument() { transition self.tok == 257 { true -> exit_range() false -> bad() } }
    state exit_range() { transition self.int_min_magnitude == 0 { true -> save_exit() false -> bad() } }
    state save_exit() { self.exit_code = self.int_value; self.next_token(); self.expect_token(41); self.expect_token(59); self.expect_token(125); transition self.status == 0 { true -> exact_end() false -> done() } }
    state exact_end() { transition self.tok == 0 { true -> done() false -> bad() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

// Compare the saved arbitrary identifier span against one retained machine or
// parameter name. These helpers deliberately operate on source spans so the
// conformance slice does not acquire a second name arena.
machine Main::ident_matches_machine(&mut self, machine_index: i32) {
    self.match_ok = 0;
    transition self.ident_len == self.machine_name_lengths[machine_index] { true -> setup() false -> done() }
    state setup() { self.cmp_i = 0; transition 0 { _ -> loop() } }
    state loop() { transition self.cmp_i < self.ident_len { true -> compare() false -> yes() } }
    state compare() { transition self.source[self.ident_start + self.cmp_i] == self.source[self.machine_name_starts[machine_index] + self.cmp_i] { true -> advance() false -> done() } }
    state advance() { self.cmp_i = self.cmp_i + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::ident_matches_param(&mut self, param_index: i32) {
    self.match_ok = 0;
    transition self.ident_len == self.param_name_lengths[param_index] { true -> setup() false -> done() }
    state setup() { self.cmp_i = 0; transition 0 { _ -> loop() } }
    state loop() { transition self.cmp_i < self.ident_len { true -> compare() false -> yes() } }
    state compare() { transition self.source[self.ident_start + self.cmp_i] == self.source[self.param_name_starts[param_index] + self.cmp_i] { true -> advance() false -> done() } }
    state advance() { self.cmp_i = self.cmp_i + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::find_machine(&mut self) {
    self.candidate = 0 - 1; self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.machine_count { true -> compare() false -> done() } }
    state compare() { self.ident_matches_machine(self.i); transition self.match_ok == 1 { true -> found() false -> advance() } }
    state found() { self.candidate = self.i; transition 0 { _ -> done() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::find_current_param(&mut self) {
    self.candidate = 0 - 1;
    self.i = self.machine_param_starts[self.current_machine];
    self.j = self.i + self.machine_param_counts[self.current_machine];
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.j { true -> compare() false -> done() } }
    state compare() { self.ident_matches_param(self.i); transition self.match_ok == 1 { true -> found() false -> advance() } }
    state found() { self.candidate = self.i; transition 0 { _ -> done() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::compare_machine_names(&mut self, left: i32, right: i32) {
    self.compare_result = 0; self.cmp_i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.cmp_i < self.machine_name_lengths[left] { true -> right_bound() false -> left_end() } }
    state right_bound() { transition self.cmp_i < self.machine_name_lengths[right] { true -> compare() false -> greater() } }
    state compare() { transition self.source[self.machine_name_starts[left] + self.cmp_i] == self.source[self.machine_name_starts[right] + self.cmp_i] { true -> advance() false -> less_check() } }
    state less_check() { transition self.source[self.machine_name_starts[left] + self.cmp_i] < self.source[self.machine_name_starts[right] + self.cmp_i] { true -> less() false -> greater() } }
    state advance() { self.cmp_i = self.cmp_i + 1; transition 0 { _ -> loop() } }
    state left_end() { transition self.cmp_i < self.machine_name_lengths[right] { true -> less() false -> done() } }
    state less() { self.compare_result = 0 - 1; transition 0 { _ -> done() } }
    state greater() { self.compare_result = 1; transition 0 { _ -> done() } }
    state done() { }
}

// First pass: retain every signature and exact body span before resolving any
// body. Forward references therefore use the same table path as backward ones.
machine Main::collect_scalar_signatures(&mut self) {
    self.machine_count = 0; self.param_used = 0; self.retain_text = 0;
    self.pos = self.source_start; self.next_token();
    transition self.status == 0 { true -> declaration() false -> done() }
    state declaration() { transition self.tok == 0 { true -> require_program() false -> machine_word() } }
    state require_program() { transition self.machine_count > 0 { true -> done() false -> bad() } }
    state machine_word() { self.match_name(41,7); transition self.match_ok == 1 { true -> machine_capacity() false -> bad() } }
    state machine_capacity() { transition self.machine_count < 16 { true -> consume_machine() false -> exhausted() } }
    state consume_machine() { self.expect_name(41,7); transition self.status == 0 { true -> machine_name() false -> done() } }
    state machine_name() { transition self.tok == 256 { true -> save_machine_name() false -> bad() } }
    state save_machine_name() {
        self.ident_start = self.tok_start; self.ident_len = self.tok_len; self.i = 0;
        transition 0 { _ -> duplicate_machine_loop() }
    }
    state duplicate_machine_loop() { transition self.i < self.machine_count { true -> duplicate_machine_compare() false -> retain_machine() } }
    state duplicate_machine_compare() { self.ident_matches_machine(self.i); transition self.match_ok == 1 { true -> bad() false -> duplicate_machine_advance() } }
    state duplicate_machine_advance() { self.i = self.i + 1; transition 0 { _ -> duplicate_machine_loop() } }
    state retain_machine() {
        self.machine_name_starts[self.machine_count] = self.ident_start;
        self.machine_name_lengths[self.machine_count] = self.ident_len;
        self.machine_param_starts[self.machine_count] = self.param_used;
        self.machine_param_counts[self.machine_count] = 0;
        self.next_token(); self.expect_token(40);
        transition self.status == 0 { true -> parameter_or_end() false -> done() }
    }
    state parameter_or_end() { transition self.tok == 41 { true -> parameters_done() false -> parameter_name() } }
    state parameter_name() { transition self.tok == 256 { true -> save_parameter_name() false -> bad() } }
    state save_parameter_name() {
        self.ident_start = self.tok_start; self.ident_len = self.tok_len;
        self.i = self.machine_param_starts[self.machine_count];
        transition 0 { _ -> duplicate_parameter_loop() }
    }
    state duplicate_parameter_loop() { transition self.i < self.param_used { true -> duplicate_parameter_compare() false -> parameter_capacity() } }
    state duplicate_parameter_compare() { self.ident_matches_param(self.i); transition self.match_ok == 1 { true -> bad() false -> duplicate_parameter_advance() } }
    state duplicate_parameter_advance() { self.i = self.i + 1; transition 0 { _ -> duplicate_parameter_loop() } }
    state parameter_capacity() { transition self.machine_param_counts[self.machine_count] < 4 { true -> total_parameter_capacity() false -> exhausted() } }
    state total_parameter_capacity() { transition self.param_used < 64 { true -> retain_parameter() false -> exhausted() } }
    state retain_parameter() {
        self.param_name_starts[self.param_used] = self.ident_start;
        self.param_name_lengths[self.param_used] = self.ident_len;
        self.param_owners[self.param_used] = self.machine_count;
        self.param_used = self.param_used + 1;
        self.machine_param_counts[self.machine_count] = self.machine_param_counts[self.machine_count] + 1;
        self.next_token(); self.expect_token(58); self.expect_name(87,3);
        transition self.status == 0 { true -> parameter_separator() false -> done() }
    }
    state parameter_separator() { transition self.tok == 44 { true -> comma() false -> parameter_close() } }
    state comma() { self.expect_token(44); transition self.status == 0 { true -> parameter_name() false -> done() } }
    state parameter_close() { transition self.tok == 41 { true -> parameters_done() false -> bad() } }
    state parameters_done() {
        self.expect_token(41); self.expect_token(45); self.expect_token(62); self.expect_name(87,3); self.expect_token(123);
        transition self.status == 0 { true -> body_begin() false -> done() }
    }
    state body_begin() { self.machine_body_starts[self.machine_count] = self.tok_start; transition 0 { _ -> body_scan() } }
    state body_scan() { transition self.tok == 0 { true -> bad() false -> body_close_check() } }
    state body_close_check() { transition self.tok == 125 { true -> body_done() false -> nested_open_check() } }
    state nested_open_check() { transition self.tok == 123 { true -> bad() false -> body_advance() } }
    state body_advance() { self.next_token(); transition self.status == 0 { true -> body_scan() false -> done() } }
    state body_done() {
        self.machine_body_ends[self.machine_count] = self.tok_start;
        self.machine_count = self.machine_count + 1;
        self.next_token(); transition self.status == 0 { true -> declaration() false -> done() }
    }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::append_scalar_constant(&mut self) {
    transition self.machine_op_counts[self.current_machine] < 16 { true -> total_capacity() false -> exhausted() }
    state total_capacity() { transition self.op_used < 256 { true -> retain() false -> exhausted() } }
    state retain() {
        self.op_kinds[self.op_used] = 1;
        self.op_owners[self.op_used] = self.current_machine;
        self.op_literals[self.op_used] = self.literal_value;
        self.op_arg_starts[self.op_used] = self.arg_used;
        self.op_arg_counts[self.op_used] = 0;
        self.value_ref = 64 + self.op_used;
        self.op_used = self.op_used + 1;
        self.machine_op_counts[self.current_machine] = self.machine_op_counts[self.current_machine] + 1;
        transition 0 { _ -> done() }
    }
    state exhausted() { self.status = 252; }
    state done() { }
}

machine Main::append_scalar_call(&mut self) {
    self.candidate = self.frame_count - 1;
    self.i = self.frame_callees[self.candidate];
    transition self.frame_arg_counts[self.candidate] == self.machine_param_counts[self.i] { true -> machine_capacity() false -> bad() }
    state machine_capacity() { transition self.machine_op_counts[self.current_machine] < 16 { true -> total_capacity() false -> exhausted() } }
    state total_capacity() { transition self.op_used < 256 { true -> argument_capacity() false -> exhausted() } }
    state argument_capacity() { transition self.frame_arg_counts[self.candidate] <= 1024 - self.arg_used { true -> retain() false -> exhausted() } }
    state retain() {
        self.op_kinds[self.op_used] = 2;
        self.op_owners[self.op_used] = self.current_machine;
        self.op_callees[self.op_used] = self.i;
        self.op_arg_starts[self.op_used] = self.arg_used;
        self.op_arg_counts[self.op_used] = self.frame_arg_counts[self.candidate];
        self.call_graph[self.current_machine * 16 + self.i] = 1;
        self.j = 0;
        transition 0 { _ -> copy_arguments() }
    }
    state copy_arguments() { transition self.j < self.frame_arg_counts[self.candidate] { true -> copy_argument() false -> finish() } }
    state copy_argument() {
        self.arg_refs[self.arg_used] = self.frame_arg_refs[self.candidate * 4 + self.j];
        self.arg_used = self.arg_used + 1; self.j = self.j + 1;
        transition 0 { _ -> copy_arguments() }
    }
    state finish() {
        self.value_ref = 64 + self.op_used;
        self.op_used = self.op_used + 1;
        self.machine_op_counts[self.current_machine] = self.machine_op_counts[self.current_machine] + 1;
        self.frame_count = self.frame_count - 1;
        transition 0 { _ -> done() }
    }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

// Parse one body with an explicit expression-frame stack. Leaves produce a
// temporary value handle; closing a call appends its operation in postorder.
machine Main::parse_scalar_body(&mut self) {
    self.frame_count = 0;
    self.pos = self.machine_body_starts[self.current_machine]; self.next_token();
    self.expect_name(81,6);
    transition self.status == 0 { true -> value() false -> done() }
    state value() { transition self.tok == 45 { true -> negative_sign() false -> integer_check() } }
    state negative_sign() { self.next_token(); transition self.tok == 257 { true -> negative_integer() false -> bad() } }
    state negative_integer() { transition self.int_min_magnitude == 1 { true -> negative_min() false -> negative_regular() } }
    state negative_min() { self.literal_value = 0 - 1073741824 - 1073741824; transition 0 { _ -> negative_advance() } }
    state negative_regular() { self.literal_value = 0 - self.int_value; transition 0 { _ -> negative_advance() } }
    state negative_advance() { self.next_token(); self.append_scalar_constant(); transition self.status == 0 { true -> produced() false -> done() } }
    state integer_check() { transition self.tok == 257 { true -> positive_integer() false -> identifier_check() } }
    state positive_integer() { transition self.int_min_magnitude == 0 { true -> positive_retain() false -> bad() } }
    state positive_retain() { self.literal_value = self.int_value; self.next_token(); self.append_scalar_constant(); transition self.status == 0 { true -> produced() false -> done() } }
    state identifier_check() { transition self.tok == 256 { true -> identifier() false -> bad() } }
    state identifier() {
        self.ident_start = self.tok_start; self.ident_len = self.tok_len; self.next_token();
        transition self.tok == 40 { true -> call_lookup() false -> parameter_lookup() }
    }
    state parameter_lookup() { self.find_current_param(); transition self.candidate >= 0 { true -> parameter_found() false -> bad() } }
    state parameter_found() { self.value_ref = self.candidate; transition 0 { _ -> produced() } }
    state call_lookup() { self.find_machine(); transition self.candidate >= 0 { true -> call_depth() false -> bad() } }
    state call_depth() { transition self.frame_count < 16 { true -> call_push() false -> exhausted() } }
    state call_push() {
        self.frame_callees[self.frame_count] = self.candidate;
        self.frame_arg_counts[self.frame_count] = 0;
        self.frame_count = self.frame_count + 1;
        self.expect_token(40);
        transition self.status == 0 { true -> call_argument_or_close() false -> done() }
    }
    state call_argument_or_close() { transition self.tok == 41 { true -> call_close() false -> value() } }
    state produced() { transition self.frame_count == 0 { true -> returned_value() false -> retain_argument_capacity() } }
    state retain_argument_capacity() { self.candidate = self.frame_count - 1; transition self.frame_arg_counts[self.candidate] < 4 { true -> retain_argument() false -> exhausted() } }
    state retain_argument() {
        self.frame_arg_refs[self.candidate * 4 + self.frame_arg_counts[self.candidate]] = self.value_ref;
        self.frame_arg_counts[self.candidate] = self.frame_arg_counts[self.candidate] + 1;
        transition self.tok == 44 { true -> argument_comma() false -> argument_close_check() }
    }
    state argument_comma() { self.expect_token(44); transition self.status == 0 { true -> value() false -> done() } }
    state argument_close_check() { transition self.tok == 41 { true -> call_close() false -> bad() } }
    state call_close() { self.expect_token(41); self.append_scalar_call(); transition self.status == 0 { true -> produced() false -> done() } }
    state returned_value() {
        self.return_ref = self.value_ref;
        self.expect_token(59);
        transition self.status == 0 { true -> closing_token() false -> done() }
    }
    state closing_token() { transition self.tok == 125 { true -> closing_position() false -> bad() } }
    state closing_position() { transition self.tok_start == self.machine_body_ends[self.current_machine] { true -> close_body() false -> bad() } }
    state close_body() {
        self.expect_token(125);
        self.machine_return_refs[self.current_machine] = self.return_ref;
        transition 0 { _ -> done() }
    }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_scalar_bodies(&mut self) {
    self.op_used = 0; self.arg_used = 0; self.current_machine = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.current_machine < self.machine_count { true -> body() false -> done() } }
    state body() {
        self.machine_op_starts[self.current_machine] = self.op_used;
        self.machine_op_counts[self.current_machine] = 0;
        self.parse_scalar_body();
        transition self.status == 0 { true -> advance() false -> done() }
    }
    state advance() { self.current_machine = self.current_machine + 1; transition 0 { _ -> loop() } }
    state done() { }
}

// Select the conformance root and reject the complete graph if Kahn's walk
// cannot consume every retained machine.
machine Main::validate_scalar_graph(&mut self) {
    self.i = 0;
    transition 0 { _ -> initialize() }
    state initialize() { transition self.i < self.machine_count { true -> initialize_one() false -> count_edges_begin() } }
    state initialize_one() { self.machine_indegrees[self.i] = 0; self.machine_seen[self.i] = 0; self.i = self.i + 1; transition 0 { _ -> initialize() } }
    state count_edges_begin() { self.i = 0; transition 0 { _ -> count_edges() } }
    state count_edges() { transition self.i < self.machine_count * 16 { true -> edge_owner_bound() false -> roots_begin() } }
    state edge_owner_bound() { transition self.i / 16 < self.machine_count { true -> edge_present() false -> roots_begin() } }
    state edge_present() { transition self.call_graph[self.i] == 1 { true -> increment_indegree() false -> edge_advance() } }
    state increment_indegree() { self.j = self.i % 16; self.machine_indegrees[self.j] = self.machine_indegrees[self.j] + 1; transition 0 { _ -> edge_advance() } }
    state edge_advance() { self.i = self.i + 1; transition 0 { _ -> count_edges() } }
    state roots_begin() { self.root_count = 0; self.root_machine = 0 - 1; self.i = 0; transition 0 { _ -> roots() } }
    state roots() { transition self.i < self.machine_count { true -> root_check() false -> unique_root() } }
    state root_check() { transition self.machine_indegrees[self.i] == 0 { true -> root_found() false -> root_advance() } }
    state root_found() { self.root_count = self.root_count + 1; self.root_machine = self.i; transition 0 { _ -> root_advance() } }
    state root_advance() { self.i = self.i + 1; transition 0 { _ -> roots() } }
    state unique_root() { transition self.root_count == 1 { true -> root_parameters() false -> bad() } }
    state root_parameters() { transition self.machine_param_counts[self.root_machine] == 0 { true -> kahn_begin() false -> bad() } }
    state kahn_begin() { self.visited_count = 0; transition 0 { _ -> kahn_round() } }
    state kahn_round() { transition self.visited_count < self.machine_count { true -> find_zero_begin() false -> done() } }
    state find_zero_begin() { self.candidate = 0 - 1; self.i = 0; transition 0 { _ -> find_zero() } }
    state find_zero() { transition self.i < self.machine_count { true -> unseen() false -> zero_found_check() } }
    state unseen() { transition self.machine_seen[self.i] == 0 { true -> zero_indegree() false -> find_zero_advance() } }
    state zero_indegree() { transition self.machine_indegrees[self.i] == 0 { true -> remember_zero() false -> find_zero_advance() } }
    state remember_zero() { self.candidate = self.i; transition 0 { _ -> zero_found_check() } }
    state find_zero_advance() { self.i = self.i + 1; transition 0 { _ -> find_zero() } }
    state zero_found_check() { transition self.candidate >= 0 { true -> visit() false -> bad() } }
    state visit() { self.machine_seen[self.candidate] = 1; self.visited_count = self.visited_count + 1; self.j = 0; transition 0 { _ -> outgoing() } }
    state outgoing() { transition self.j < self.machine_count { true -> outgoing_present() false -> kahn_round() } }
    state outgoing_present() { transition self.call_graph[self.candidate * 16 + self.j] == 1 { true -> decrement() false -> outgoing_advance() } }
    state decrement() { self.machine_indegrees[self.j] = self.machine_indegrees[self.j] - 1; transition 0 { _ -> outgoing_advance() } }
    state outgoing_advance() { self.j = self.j + 1; transition 0 { _ -> outgoing() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::sort_scalar_machines(&mut self) {
    self.i = 0;
    transition 0 { _ -> initialize() }
    state initialize() { transition self.i < self.machine_count { true -> initialize_one() false -> insertion_begin() } }
    state initialize_one() { self.machine_order[self.i] = self.i; self.i = self.i + 1; transition 0 { _ -> initialize() } }
    state insertion_begin() { self.i = 1; transition 0 { _ -> insertion() } }
    state insertion() { transition self.i < self.machine_count { true -> take_candidate() false -> find_root_begin() } }
    state take_candidate() { self.candidate = self.machine_order[self.i]; self.j = self.i; transition 0 { _ -> shift_check() } }
    state shift_check() { transition self.j > 0 { true -> compare_previous() false -> place_candidate() } }
    state compare_previous() { self.compare_machine_names(self.candidate, self.machine_order[self.j - 1]); transition self.compare_result < 0 { true -> shift() false -> place_candidate() } }
    state shift() { self.machine_order[self.j] = self.machine_order[self.j - 1]; self.j = self.j - 1; transition 0 { _ -> shift_check() } }
    state place_candidate() { self.machine_order[self.j] = self.candidate; self.i = self.i + 1; transition 0 { _ -> insertion() } }
    state find_root_begin() { self.i = 0; transition 0 { _ -> find_root() } }
    state find_root() { transition self.machine_order[self.i] == self.root_machine { true -> move_root_begin() false -> find_root_advance() } }
    state find_root_advance() { self.i = self.i + 1; transition 0 { _ -> find_root() } }
    state move_root_begin() { self.j = self.i; transition 0 { _ -> move_root() } }
    state move_root() { transition self.j > 0 { true -> move_one() false -> install_root() } }
    state move_one() { self.machine_order[self.j] = self.machine_order[self.j - 1]; self.j = self.j - 1; transition 0 { _ -> move_root() } }
    state install_root() { self.machine_order[0] = self.root_machine; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::assign_scalar_ids(&mut self) {
    self.value_next = 1; self.operation_next = 1; self.i = 0;
    transition 0 { _ -> machines() }
    state machines() { transition self.i < self.machine_count { true -> machine_begin() false -> count_kinds_begin() } }
    state machine_begin() {
        self.current_machine = self.machine_order[self.i];
        self.machine_ids[self.current_machine] = self.i + 1;
        self.j = self.machine_param_starts[self.current_machine];
        self.k = self.j + self.machine_param_counts[self.current_machine];
        transition 0 { _ -> parameters() }
    }
    state parameters() { transition self.j < self.k { true -> parameter() false -> operations_begin() } }
    state parameter() { self.param_value_ids[self.j] = self.value_next; self.value_next = self.value_next + 1; self.j = self.j + 1; transition 0 { _ -> parameters() } }
    state operations_begin() { self.j = self.machine_op_starts[self.current_machine]; self.k = self.j + self.machine_op_counts[self.current_machine]; transition 0 { _ -> operations() } }
    state operations() { transition self.j < self.k { true -> operation() false -> result() } }
    state operation() {
        self.op_ids[self.j] = self.operation_next; self.operation_next = self.operation_next + 1;
        self.op_result_ids[self.j] = self.value_next; self.value_next = self.value_next + 1;
        self.j = self.j + 1; transition 0 { _ -> operations() }
    }
    state result() { self.machine_result_ids[self.current_machine] = self.value_next; self.value_next = self.value_next + 1; self.i = self.i + 1; transition 0 { _ -> machines() } }
    state count_kinds_begin() { self.i = 0; self.j = 0; transition 0 { _ -> count_kinds() } }
    state count_kinds() { transition self.i < self.op_used { true -> kind() false -> size() } }
    state kind() { transition self.op_kinds[self.i] == 1 { true -> constant() false -> call() } }
    state constant() { self.j = self.j + 1; self.i = self.i + 1; transition 0 { _ -> count_kinds() } }
    state call() { self.i = self.i + 1; transition 0 { _ -> count_kinds() } }
    state size() {
        self.terminal_size = 84 + 123 * self.machine_count + 12 * self.param_used
            + 39 * self.j + 42 * (self.op_used - self.j) + 8 * self.arg_used;
        transition self.terminal_size <= 21764 { true -> done() false -> exhausted() }
    }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

// Canonical terminal-Psi wire primitives. These intentionally stream through
// D0's ordinary write_byte boundary: the bootstrap producer does not retain a
// second, bridge-private artifact representation. All values admitted by O1
// fit i32; semantic IDs are emitted as zero-extended little-endian u64 values.
machine Main::emit_u16(&mut self, value: i32) {
    write_byte(value & 255);
    write_byte((value >> 8) & 255);
}

machine Main::emit_u32(&mut self, value: i32) {
    write_byte(value & 255);
    write_byte((value >> 8) & 255);
    write_byte((value >> 16) & 255);
    write_byte((value >> 24) & 255);
}

machine Main::emit_id(&mut self, value: i32) {
    self.emit_u32(value);
    self.emit_u32(0);
}

machine Main::emit_signed_i128(&mut self, value: i32) {
    self.emit_u32(value);
    transition value < 0 { true -> negative() false -> positive() }
    state negative() { self.c = 255; transition 0 { _ -> extension() } }
    state positive() { self.c = 0; transition 0 { _ -> extension() } }
    state extension() {
        write_byte(self.c); write_byte(self.c); write_byte(self.c); write_byte(self.c);
        write_byte(self.c); write_byte(self.c); write_byte(self.c); write_byte(self.c);
        write_byte(self.c); write_byte(self.c); write_byte(self.c); write_byte(self.c);
    }
}

machine Main::scalar_ref_id(&mut self, reference: i32) {
    transition reference < 64 { true -> parameter() false -> operation() }
    state parameter() { self.id_value = self.param_value_ids[reference]; transition 0 { _ -> done() } }
    state operation() { self.id_value = self.op_result_ids[reference - 64]; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_scalar_operation(&mut self) {
    self.emit_id(self.op_ids[self.j]); write_byte(1);
    self.emit_id(self.op_result_ids[self.j]); write_byte(2); write_byte(1); self.emit_u16(32);
    transition self.op_kinds[self.j] == 1 { true -> constant() false -> call() }
    state constant() {
        write_byte(1); write_byte(1); self.emit_signed_i128(self.op_literals[self.j]);
        transition 0 { _ -> done() }
    }
    state call() {
        write_byte(33); self.emit_id(self.machine_ids[self.op_callees[self.j]]);
        self.emit_u32(self.op_arg_counts[self.j]); self.k = 0;
        transition 0 { _ -> arguments() }
    }
    state arguments() { transition self.k < self.op_arg_counts[self.j] { true -> argument() false -> call_tail() } }
    state argument() {
        self.scalar_ref_id(self.arg_refs[self.op_arg_starts[self.j] + self.k]); self.emit_id(self.id_value);
        self.k = self.k + 1; transition 0 { _ -> arguments() }
    }
    state call_tail() { self.emit_u32(0); self.emit_u32(0); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_scalar_machine(&mut self) {
    self.current_machine = self.scalar_emit_machine;
    self.emit_id(self.machine_ids[self.current_machine]); write_byte(0);
    self.emit_u32(self.machine_param_counts[self.current_machine]);
    self.j = self.machine_param_starts[self.current_machine];
    self.k = self.j + self.machine_param_counts[self.current_machine];
    transition 0 { _ -> parameters() }
    state parameters() { transition self.j < self.k { true -> parameter() false -> machine_result() } }
    state parameter() { self.emit_id(self.param_value_ids[self.j]); write_byte(2); write_byte(1); self.emit_u16(32); self.j = self.j + 1; transition 0 { _ -> parameters() } }
    state machine_result() {
        // Empty structural parameters, followed by one scalar result.
        self.emit_u32(0); write_byte(1); self.emit_id(self.machine_result_ids[self.current_machine]); write_byte(2); write_byte(1); self.emit_u16(32);
        // Structural places, entry claims, service ceiling, and all content rows.
        self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
        self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
        self.emit_id(self.machine_ids[self.current_machine]); self.emit_u32(1);
        self.emit_id(self.machine_ids[self.current_machine]); self.emit_u32(0);
        self.emit_u32(self.machine_op_counts[self.current_machine]);
        self.j = self.machine_op_starts[self.current_machine];
        self.k = self.j + self.machine_op_counts[self.current_machine];
        transition 0 { _ -> operations() }
    }
    state operations() { transition self.j < self.k { true -> operation() false -> terminator() } }
    state operation() { self.b1 = self.k; self.emit_scalar_operation(); self.k = self.b1; self.j = self.j + 1; transition 0 { _ -> operations() } }
    state terminator() {
        write_byte(2); self.emit_id(self.machine_ids[self.current_machine]);
        self.scalar_ref_id(self.machine_return_refs[self.current_machine]); self.emit_id(self.id_value);
        self.emit_u32(0);
        self.emit_id(self.machine_ids[self.current_machine]);
        self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::emit_scalar_terminal_module(&mut self) {
    write_byte(80); write_byte(83); write_byte(73); write_byte(84);
    write_byte(69); write_byte(82); write_byte(77); write_byte(0);
    self.emit_u16(26); self.emit_u16(28); self.emit_id(1);
    // Fifteen empty top-level tables precede the machine table.
    self.emit_zeroes(60); self.emit_u32(self.machine_count);
    self.emit_index = 0;
    transition 0 { _ -> machines() }
    state machines() { transition self.emit_index < self.machine_count { true -> machine() false -> done() } }
    state machine() {
        self.scalar_emit_machine = self.machine_order[self.emit_index]; self.emit_scalar_machine();
        self.emit_index = self.emit_index + 1; transition 0 { _ -> machines() }
    }
    state done() { }
}

machine Main::emit_zeroes(&mut self, count: i32) {
    self.i = 0;
    transition count >= 0 { true -> loop() false -> bad() }
    state loop() { transition self.i < count { true -> byte() false -> done() } }
    state byte() { write_byte(0); self.i = self.i + 1; transition 0 { _ -> loop() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::emit_text_bytes(&mut self, start: i32, count: i32) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < count { true -> byte() false -> done() } }
    state byte() { write_byte(self.text[start + self.i]); self.i = self.i + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::emit_literal_places(&mut self) {
    self.emit_index = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.emit_index < self.write_count { true -> place() false -> done() } }
    state place() {
        self.emit_id(4 + self.emit_index);
        write_byte(4);
        self.emit_u32(self.emit_index);
        self.emit_id(2);
        self.emit_index = self.emit_index + 1;
        transition 0 { _ -> loop() }
    }
    state done() { }
}

machine Main::emit_literal_operations(&mut self) {
    self.emit_index = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.emit_index < self.write_count { true -> operation() false -> done() } }
    state operation() {
        self.emit_id(1 + self.emit_index);
        write_byte(0); write_byte(40);
        self.emit_id(4 + self.emit_index);
        self.emit_u32(self.text_lengths[self.emit_index]);
        self.emit_text_bytes(self.text_starts[self.emit_index], self.text_lengths[self.emit_index]);
        self.emit_index = self.emit_index + 1;
        transition 0 { _ -> loop() }
    }
    state done() { }
}

machine Main::emit_write_operations(&mut self) {
    self.emit_index = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.emit_index < self.write_count { true -> operation() false -> done() } }
    state operation() {
        self.emit_id(self.write_count + self.emit_index + 1);
        write_byte(0); write_byte(35); self.emit_id(2);
        self.emit_u32(0);
        self.emit_u32(1); self.emit_id(4 + self.emit_index); write_byte(2); self.emit_u32(0);
        self.emit_u32(0); self.emit_u32(0);
        self.emit_index = self.emit_index + 1;
        transition 0 { _ -> loop() }
    }
    state done() { }
}

