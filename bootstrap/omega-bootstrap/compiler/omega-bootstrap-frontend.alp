    write_byte(101); write_byte(40); write_byte(110); write_byte(97); write_byte(109); write_byte(101); write_byte(100); write_byte(40);
    write_byte(110); write_byte(97); write_byte(109); write_byte(101); write_byte(40); write_byte(117); write_byte(56); write_byte(41);
    write_byte(41); write_byte(41); write_byte(41);
}

machine Main::emit_console_service(&mut self) {
    write_byte(67); write_byte(111); write_byte(110); write_byte(115); write_byte(111); write_byte(108); write_byte(101);
