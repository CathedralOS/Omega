machine Main::emit_structural_type_count(&mut self) {
    transition self.write_count > 0 { true -> with_bytes() false -> main_only() }
    state with_bytes() { self.emit_u32(2); transition 0 { _ -> done() } }
    state main_only() { self.emit_u32(1); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_optional_bytes_type(&mut self) {
    transition self.write_count > 0 { true -> bytes_type() false -> done() }
    state bytes_type() {
        self.emit_id(2); self.emit_u32(22); self.emit_bytes_type_identity();
        write_byte(4); write_byte(1);
    }
    state done() { }
}

machine Main::emit_boundary_count(&mut self) {
    transition self.write_count > 0 { true -> with_write() false -> exit_only() }
    state with_write() { self.emit_u32(2); transition 0 { _ -> done() } }
    state exit_only() { self.emit_u32(1); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_optional_write_boundary(&mut self) {
    transition self.write_count > 0 { true -> write_boundary() false -> done() }
    state write_boundary() {
        self.emit_id(2); self.emit_u32(160); self.emit_write_boundary_identity();
        write_byte(0);
        self.emit_u32(0);
        self.emit_u32(1); self.emit_id(1); self.emit_u32(0); write_byte(0);
        self.emit_id(2); write_byte(1); write_byte(2); self.emit_u32(0);
        // No structural requirements, program-local roots, or content guarantees.
        write_byte(0); self.emit_u32(0);
        self.emit_u32(0); self.emit_u32(0); self.emit_u32(1); self.emit_id(1);
    }
    state done() { }
}

machine Main::emit_machine_places(&mut self) {
    transition self.write_count > 0 { true -> with_writes() false -> exit_only() }
    state with_writes() {
        self.emit_u32(2 + self.write_count);
        self.emit_id(2); write_byte(5); self.emit_id(1); self.emit_id(1); self.emit_id(1);
        self.emit_id(3); write_byte(5); self.emit_id(1); self.emit_id(1); self.emit_id(2);
        self.emit_literal_places();
        transition 0 { _ -> done() }
    }
    state exit_only() {
        self.emit_u32(1);
        self.emit_id(1); write_byte(5); self.emit_id(1); self.emit_id(1); self.emit_id(1);
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::emit_terminal_module(&mut self) {
    // Semantic envelope: PSITERM\\0, codec format 26, vocabulary 28, entry #1.
    write_byte(80); write_byte(83); write_byte(73); write_byte(84);
    write_byte(69); write_byte(82); write_byte(77); write_byte(0);
    self.emit_u16(26); self.emit_u16(28); self.emit_id(1);

    // Structural types: attached Main record, then borrowed byte sequence.
    self.emit_structural_type_count();
    self.emit_id(1); self.emit_u32(17); self.emit_main_identity();
    write_byte(1); self.emit_u32(1);
    self.emit_id(1); self.emit_u32(7); self.emit_console_field();
    write_byte(1); write_byte(3); self.emit_u32(20); self.emit_console_type_identity();
    self.emit_optional_bytes_type();

    // No structural domains. Console is the sole service and root reach.
    self.emit_u32(0);
    self.emit_u32(1); self.emit_id(1); self.emit_u32(7); self.emit_console_service(); self.emit_u32(0);
    self.emit_u32(1); self.emit_id(1);
    self.emit_u32(0);

    // Boundary #1: Console::exit_process(i32), published under Console.
    self.emit_boundary_count();
    self.emit_id(1); self.emit_u32(147); self.emit_exit_boundary_identity();
    write_byte(0);
    self.emit_u32(1); write_byte(2); write_byte(1); self.emit_u16(32);
    // No structural requirements, program-local roots, or content guarantees.
    self.emit_u32(0); write_byte(0); self.emit_u32(0);
    self.emit_u32(0); self.emit_u32(0); self.emit_u32(1); self.emit_id(1);

    // Boundary #2 exists only when a write is reachable from this closure.
    self.emit_optional_write_boundary();

    // Empty provider/proof metadata tables preceding the one machine table:
    // candidates, float projections/equalities, propositions/applications,
    // evidence terms/lanes, proof outputs, and closed conformances.
    self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
    self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
    self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
    self.emit_u32(1);

    // Main::main is attached to Main. One root per reachable boundary binds the
    // authored console field to exit and, when present, write_line.
    self.emit_id(1); write_byte(1); self.emit_id(1);
    self.emit_u32(0); self.emit_u32(0); write_byte(0);
    self.emit_machine_places();
    self.emit_u32(0);
    self.emit_u32(1); self.emit_id(1);
    self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
    self.emit_id(1); self.emit_u32(1);

    // Entry block: establish every literal in source order, invoke every
    // write_line in source order, then establish the one exit scalar and exit.
    self.emit_id(1); self.emit_u32(0); self.emit_u32(self.write_count * 2 + 2);
    self.emit_literal_operations();
    self.emit_write_operations();

    self.emit_id(self.write_count * 2 + 1); write_byte(1); self.emit_id(1);
    write_byte(2); write_byte(1); self.emit_u16(32);
    write_byte(1); write_byte(1); self.emit_u32(self.exit_code); self.emit_zeroes(12);

    self.emit_id(self.write_count * 2 + 2); write_byte(0); write_byte(35); self.emit_id(1);
    self.emit_u32(1); self.emit_id(1);
    self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);

    // Return Unit and the empty retained machine contract.
    write_byte(5); self.emit_id(1); self.emit_u32(0);
    self.emit_id(1); self.emit_u32(0); self.emit_u32(0); self.emit_u32(0);
}

machine Main::main(&mut self) {
    self.status = 0; self.n = 0; self.text_len = 0; self.text_start = 0;
    self.text_used = 0; self.text_sum = 0; self.write_count = 0; self.exit_code = 0;
    self.init_names();
    self.decode_bundle();
    transition self.status == 0 { true -> sources() false -> reject_decode() }
    state sources() { self.validate_sources(); transition self.status == 0 { true -> select_begin() false -> reject_sources() } }
    state select_begin() { self.profile = 0 - 1; self.retain_text = 0; self.pos = self.source_start; self.next_token(); transition self.status == 0 { true -> select_o1() false -> reject_parse() } }
    state select_o1() { self.match_name(0,3); transition self.match_ok == 1 { true -> select_o1_done() false -> select_scalar() } }
    state select_o1_done() { self.profile = 0; transition 0 { _ -> parse_dispatch() } }
    state select_scalar() { self.match_name(41,7); transition self.match_ok == 1 { true -> select_scalar_done() false -> reject_parse() } }
    state select_scalar_done() { self.profile = 1; transition 0 { _ -> parse_dispatch() } }
    state parse_dispatch() { transition self.profile { 0 -> parse_o1() 1 -> scalar_signatures() _ -> reject_parse() } }
    state parse_o1() { self.parse_o1(); transition self.status == 0 { true -> emit_o1() false -> reject_parse() } }
    state scalar_signatures() { self.collect_scalar_signatures(); transition self.status == 0 { true -> scalar_bodies() false -> reject_parse() } }
    state scalar_bodies() { self.parse_scalar_bodies(); transition self.status == 0 { true -> scalar_graph() false -> reject_parse() } }
    state scalar_graph() { self.validate_scalar_graph(); transition self.status == 0 { true -> scalar_order() false -> reject_parse() } }
    state scalar_order() { self.sort_scalar_machines(); self.assign_scalar_ids(); transition self.status == 0 { true -> emit_scalar() false -> reject_parse() } }
    state emit_o1() { self.emit_terminal_module(); transition self.status == 0 { true -> emitted_o1() false -> reject_parse() } }
    state emit_scalar() { self.emit_scalar_terminal_module(); transition self.status == 0 { true -> emitted_scalar() false -> reject_parse() } }
    state emitted_o1() { self.console.exit_process((self.text_sum + (self.exit_code % 251)) % 251); }
    state emitted_scalar() { self.console.exit_process(0); }
    state reject_decode() { self.console.exit_process(self.status); }
    state reject_sources() { self.console.exit_process(self.status); }
    state reject_parse() { self.console.exit_process(self.status); }
}
