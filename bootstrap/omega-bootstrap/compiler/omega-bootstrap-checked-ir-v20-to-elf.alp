machine Main::constant_key_after(&mut self, id: i32) -> i32 {
    transition id == 0 { true -> yes() _ -> height() }
    state height() { transition self.constant_arena[32768 + id] > self.constant_arena[32768 + id - 1] { true -> yes() _ -> height_equal() } }
    state height_equal() { transition self.constant_arena[32768 + id] == self.constant_arena[32768 + id - 1] { true -> type() _ -> no() } }
    state type() { transition self.constant_arena[0 + id] > self.constant_arena[0 + id - 1] { true -> yes() _ -> type_equal() } }
    state type_equal() { transition self.constant_arena[0 + id] == self.constant_arena[0 + id - 1] { true -> payload() _ -> no() } }
    state payload() { transition self.constant_arena[32768 + id] == 0 { true -> scalar() _ -> count() } }
    state scalar() { transition self.constant_arena[24576 + id] > self.constant_arena[24576 + id - 1] { true -> yes() _ -> no() } }
    state count() { transition self.constant_arena[16384 + id] > self.constant_arena[16384 + id - 1] { true -> yes() _ -> count_equal() } }
    state count_equal() { transition self.constant_arena[16384 + id] == self.constant_arena[16384 + id - 1] { true -> children_setup() _ -> no() } }
    state children_setup() { self.j = 0; transition 0 { _ -> children() } }
    state children() { transition self.j < self.constant_arena[16384 + id] { true -> child() _ -> no() } }
    state child() { self.value = self.constant_children[self.constant_arena[8192 + id] + self.j]; self.value2 = self.constant_children[self.constant_arena[8192 + id - 1] + self.j]; transition self.value > self.value2 { true -> yes() _ -> child_equal() } }
    state child_equal() { transition self.value == self.value2 { true -> child_next() _ -> no() } }
    state child_next() { self.j = self.j + 1; transition 0 { _ -> children() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::validate_constants(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.const_count { true -> classify() _ -> done() } }
    state classify() { self.type_id = self.constant_arena[0 + self.i]; self.constant_arena[40960 + self.i] = 0; self.constant_arena[49152 + self.i] = 0; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> scalar() _ -> reject_u64_constant() } }
    state reject_u64_constant() { transition self.metadata_arena[0 + self.type_id] == 8 { true -> bad() _ -> structural_setup() } }
    state scalar() { self.constant_arena[32768 + self.i] = 0; transition 0 { _ -> ordered() } }
    state structural_setup() { self.j = 0; self.const_height = 1; transition 0 { _ -> children() } }
    state children() { transition self.j < self.constant_arena[16384 + self.i] { true -> child() _ -> height_keep() } }
    state child() { self.value = self.constant_children[self.constant_arena[8192 + self.i] + self.j]; self.found = self.valid_id(self.value, self.i); transition self.found == 1 { true -> child_type() _ -> bad() } }
    state child_type() { transition self.metadata_arena[0 + self.type_id] == 4 { true -> record_child_type() _ -> array_child_check() } }
    state record_child_type() { self.found = self.metadata_arena[16384 + self.type_id]; self.type2 = self.metadata_arena[106496 + 8832 + self.metadata_arena[106496 + 128 + self.found] + self.j]; transition self.constant_arena[0 + self.value] == self.type2 { true -> child_not_view() _ -> bad() } }
    state array_child_check() { transition self.metadata_arena[0 + self.type_id] == 5 { true -> array_child_type() _ -> shared_child_type() } }
    state array_child_type() { self.type2 = self.metadata_arena[16384 + self.type_id]; transition self.constant_arena[0 + self.value] == self.type2 { true -> child_not_view() _ -> bad() } }
    state child_not_view() { transition self.metadata_arena[0 + self.type2] == 7 { true -> bad() _ -> child_height() } }
    state shared_child_type() { transition self.metadata_arena[0 + self.type_id] == 7 { true -> shared_child_exact() _ -> bad() } }
    state shared_child_exact() { self.type2 = self.metadata_arena[16384 + self.type_id]; transition self.constant_arena[0 + self.value] == self.type2 { true -> shared_child_scalar() _ -> bad() } }
    state shared_child_scalar() { transition self.constant_arena[16384 + self.value] == 0 { true -> child_height() _ -> bad() } }
    state child_height() { self.value2 = self.constant_arena[32768 + self.value] + 1; transition self.value2 > self.const_height { true -> child_height_keep() _ -> child_next() } }
    state child_height_keep() { self.const_height = self.value2; transition 0 { _ -> child_next() } }
