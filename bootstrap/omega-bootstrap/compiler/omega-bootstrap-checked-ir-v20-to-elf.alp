    state value_u64_keep() { self.frame_cursor = self.frame_cursor + 8; self.value_arena[163840 + self.i] = self.frame_cursor; transition 0 { _ -> value_next() } }
    state value_scalar() { self.align_frame(4); transition self.status == 0 { true -> value_scalar_slot() _ -> done() } }
    state value_scalar_slot() { transition self.frame_cursor <= 262144 - 4 { true -> value_scalar_keep() _ -> exhausted() } }
    state value_scalar_keep() { self.frame_cursor = self.frame_cursor + 4; self.value_arena[163840 + self.i] = self.frame_cursor; transition 0 { _ -> value_next() } }
    state value_structural() { self.align_frame(8); transition self.status == 0 { true -> value_structural_slot() _ -> done() } }
    state value_structural_slot() { transition self.frame_cursor <= 262144 - 8 { true -> value_structural_keep() _ -> exhausted() } }
