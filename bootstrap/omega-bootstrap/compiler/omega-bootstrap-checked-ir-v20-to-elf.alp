    state value_next() { self.i = self.i + 1; transition 0 { _ -> values() } }
    state places_setup() { self.i = 0; transition 0 { _ -> places() } }
    state places() { transition self.i < self.place_count { true -> place_owner() _ -> objects_setup() } }
    state place_owner() { transition self.metadata_arena[106496 + 38528 + self.value_arena[237568 + self.i]] == self.current_machine { true -> place_align() _ -> place_next() } }
    state place_align() { self.align_frame(8); transition self.status == 0 { true -> place_slot() _ -> done() } }
    state place_slot() { transition self.frame_cursor <= 262144 - 8 { true -> place_keep() _ -> exhausted() } }
    state place_keep() { self.frame_cursor = self.frame_cursor + 8; self.value_arena[335872 + self.i] = self.frame_cursor; transition 0 { _ -> place_next() } }
    state place_next() { self.i = self.i + 1; transition 0 { _ -> places() } }
    state objects_setup() { self.i = 0; transition 0 { _ -> objects() } }
    state objects() { transition self.i < self.op_count { true -> object_opcode() _ -> bindings_setup() } }
    state object_opcode() { transition self.operation_arena[65536 + self.i] == 13 { true -> object_owner() _ -> object_case_opcode() } }
    state object_case_opcode() { transition self.operation_arena[65536 + self.i] == 14 { true -> object_owner() _ -> object_static_opcode() } }
    state object_static_opcode() { transition self.operation_arena[65536 + self.i] == 22 { true -> object_owner() _ -> object_tail_opcode() } }
    state object_tail_opcode() { transition self.operation_arena[65536 + self.i] == 25 { true -> object_owner() _ -> object_next() } }
    state object_owner() { transition self.operation_arena[0 + self.i] == self.current_machine { true -> object_align() _ -> object_next() } }
    state object_align() { self.type_id = self.operation_arena[163840 + self.i]; self.align_frame(self.metadata_arena[57344 + self.type_id]); transition self.status == 0 { true -> object_size() _ -> done() } }
    state object_size() { self.size = self.metadata_arena[49152 + self.type_id]; transition self.size == 0 { true -> object_anchor() _ -> object_bound() } }
    state object_anchor() { self.size = 1; transition 0 { _ -> object_bound() } }
