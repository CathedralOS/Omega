    state header_three() { self.output_u16(3); transition 0 { _ -> header_tail() } }
    state header_tail() { self.output_u16(0); self.output_u16(0); self.output_u16(0); transition 0 { _ -> rx() } }
    state rx() { self.output_u32(1); self.output_u32(5); self.output_u64(0); self.output_u64(4194304); self.output_u64(4194304); self.output_u64(self.rx_size); self.output_u64(self.rx_size); self.output_u64(4096); transition self.const_count > 0 { true -> ro() _ -> rw() } }
    state ro() { self.output_u32(1); self.output_u32(4); self.output_u64(self.rx_size); self.output_u64(4194304 + self.rx_size); self.output_u64(4194304 + self.rx_size); self.output_u64(self.ro_size); self.output_u64(self.ro_size); self.output_u64(4096); transition 0 { _ -> rw() } }
    state rw() { self.output_u32(1); self.output_u32(6); self.output_u64(self.rx_size + self.ro_size); self.output_u64(4194304 + self.rx_size + self.ro_size); self.output_u64(4194304 + self.rx_size + self.ro_size); self.output_u64(0); self.output_u64(self.bss_size); self.output_u64(4096); transition self.const_count > 0 { true -> pad_three() _ -> pad_two() } }
    state pad_two() { self.output_zeroes(3920); transition 0 { _ -> text() } }
    state pad_three() { self.output_zeroes(3864); transition 0 { _ -> text() } }
    state text() { self.output_pad = self.rx_size - 4096 - self.text_size; self.emitting = 1; self.pass = 2; self.text_pass = 2; self.emit_text(); transition self.const_count > 0 { true -> constants() _ -> done() } }
    state constants() { self.output_constant_image(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode(&mut self) {
    self.read_header(); transition self.status == 0 { true -> length() _ -> done() }
    state length() { self.check_encoded_length(); transition self.status == 0 { true -> types() _ -> done() } }
    state types() { self.parse_types(); transition self.status == 0 { true -> slice_type() _ -> done() } }
    state slice_type() { self.validate_slice_type(); transition self.status == 0 { true -> records() _ -> done() } }
    state records() { self.parse_records(); transition self.status == 0 { true -> fields() _ -> done() } }
    state fields() { self.parse_fields(); transition self.status == 0 { true -> sum_version() _ -> done() } }
    state sum_version() { transition self.schema_major >= 5 { true -> sums() _ -> machines() } }
    state sums() { self.parse_sums(); transition self.status == 0 { true -> cases() _ -> done() } }
    state cases() { self.parse_cases(); transition self.status == 0 { true -> case_payloads() _ -> done() } }
    state case_payloads() { self.parse_case_payloads(); transition self.status == 0 { true -> machines() _ -> done() } }
    state machines() { self.parse_machines(); transition self.status == 0 { true -> mparams() _ -> done() } }
    state mparams() { self.parse_mparams(); transition self.status == 0 { true -> blocks() _ -> done() } }
    state blocks() { self.parse_blocks(); transition self.status == 0 { true -> bparams() _ -> done() } }
    state bparams() { self.parse_bparams(); transition self.status == 0 { true -> constants() _ -> done() } }
    state constants() { self.parse_constants(); transition self.status == 0 { true -> constant_children() _ -> done() } }
    state constant_children() { self.parse_constant_children(); transition self.status == 0 { true -> operations() _ -> done() } }
    state operations() { self.parse_operations(); transition self.status == 0 { true -> operands() _ -> done() } }
    state operands() { self.parse_operands(); transition self.status == 0 { true -> terms() _ -> done() } }
    state terms() { self.parse_terminators(); transition self.status == 0 { true -> arm_version() _ -> done() } }
    state arm_version() { transition self.schema_major >= 5 { true -> case_arms() _ -> layouts() } }
    state case_arms() { self.parse_case_arms(); transition self.status == 0 { true -> case_arm_args() _ -> done() } }
    state case_arm_args() { self.parse_case_arm_args(); transition self.status == 0 { true -> layouts() _ -> done() } }
    state layouts() { self.resolve_layouts(); transition self.status == 0 { true -> constants_validate() _ -> done() } }
    state constants_validate() { self.validate_constants(); transition self.status == 0 { true -> ops_validate() _ -> done() } }
    state ops_validate() { self.validate_operations(); transition self.status == 0 { true -> constant_reach() _ -> done() } }
    state constant_reach() { self.validate_constant_reachability(); transition self.status == 0 { true -> constant_image() _ -> done() } }
    state constant_image() { self.build_constant_image(); transition self.status == 0 { true -> terms_validate() _ -> done() } }
    state terms_validate() { self.validate_terminators(); transition self.status == 0 { true -> slice_control() _ -> done() } }
    state slice_control() { self.validate_slice_control(); transition self.status == 0 { true -> calls_validate() _ -> done() } }
    state calls_validate() { self.validate_call_graph(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.decode();
    transition self.status == 0 { true -> root() _ -> finish() }
    state root() { transition self.flags == 1 { true -> frame() _ -> finish() } }
    state frame() { self.assign_frame(); transition self.status == 0 { true -> text() _ -> finish() } }
    state text() { self.preflight_text(); transition self.status == 0 { true -> publish() _ -> finish() } }
    state publish() { self.publish_elf(); self.j = 0; transition self.j < self.output_pad { true -> publication_padding() _ -> finish() } }
    state publication_padding() { write_byte(0); self.j = self.j + 1; transition self.j < self.output_pad { true -> publication_padding() _ -> finish() } }
    state finish() { self.console.exit_process(self.status); }
}
