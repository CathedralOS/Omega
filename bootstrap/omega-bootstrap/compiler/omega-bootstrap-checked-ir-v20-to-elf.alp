machine Main::validate_constant_reachability(&mut self) {
    self.i = self.const_count - 1; self.const_root_count = 0;
    transition 0 { _ -> reverse() }
    state reverse() { transition self.i >= 0 { true -> root() _ -> verify_setup() } }
    state root() { transition self.constant_arena[40960 + self.i] == 1 { true -> root_mark() _ -> reachable() } }
    state root_mark() { self.constant_arena[49152 + self.i] = 1; self.const_root_count = self.const_root_count + 1; transition 0 { _ -> reachable() } }
    state reachable() { transition self.constant_arena[49152 + self.i] == 1 { true -> children_setup() _ -> reverse_next() } }
    state children_setup() { self.j = 0; transition 0 { _ -> children() } }
    state children() { transition self.j < self.constant_arena[16384 + self.i] { true -> child() _ -> reverse_next() } }
    state child() { self.value = self.constant_children[self.constant_arena[8192 + self.i] + self.j]; self.constant_arena[49152 + self.value] = 1; self.j = self.j + 1; transition 0 { _ -> children() } }
    state reverse_next() { self.i = self.i - 1; transition 0 { _ -> reverse() } }
    state verify_setup() { self.i = 0; transition 0 { _ -> verify() } }
    state verify() { transition self.i < self.const_count { true -> verify_one() _ -> roots_relation() } }
    state verify_one() { transition self.constant_arena[49152 + self.i] == 1 { true -> verify_kind() _ -> bad() } }
    state verify_kind() { transition self.metadata_arena[0 + self.constant_arena[0 + self.i]] == 7 { true -> verify_view_root() _ -> verify_next() } }
    state verify_view_root() { transition self.constant_arena[40960 + self.i] == 1 { true -> verify_next() _ -> bad() } }
    state verify_next() { self.i = self.i + 1; transition 0 { _ -> verify() } }
    state roots_relation() { transition self.const_count == 0 { true -> no_roots() _ -> has_roots() } }
    state no_roots() { transition self.const_root_count == 0 { true -> done() _ -> bad() } }
    state has_roots() { transition self.const_root_count > 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::store_constant_scalar(&mut self, node: i32, at: i32) {
    self.type_id = self.constant_arena[0 + node]; self.value = self.constant_arena[24576 + node];
    transition self.metadata_arena[0 + self.type_id] == 2 { true -> wide() _ -> byte() }
    state byte() { self.constant_image[at] = self.value & 255; transition 0 { _ -> done() } }
    state wide() { self.constant_image[at] = self.value & 255; self.constant_image[at + 1] = (self.value >> 8) & 255; self.constant_image[at + 2] = (self.value >> 16) & 255; self.constant_image[at + 3] = (self.value >> 24) & 255; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::materialize_constant(&mut self, root: i32, base: i32) {
    self.walk_depth = 0; self.value_arena[368640] = root; self.value_arena[376832] = base; self.value_arena[385024] = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.walk_depth >= 0 { true -> classify() _ -> done() } }
    state classify() { self.const_id = self.value_arena[368640 + self.walk_depth]; self.type_id = self.constant_arena[0 + self.const_id]; transition self.metadata_arena[0 + self.type_id] { 1 -> scalar() 2 -> scalar() 3 -> scalar() 4 -> record() 5 -> array() 7 -> shared_bytes() _ -> bad() } }
    state scalar() { self.store_constant_scalar(self.const_id, self.value_arena[376832 + self.walk_depth]); self.walk_depth = self.walk_depth - 1; transition 0 { _ -> loop() } }
    state record() { transition self.value_arena[385024 + self.walk_depth] < self.constant_arena[16384 + self.const_id] { true -> record_child() _ -> pop() } }
    state record_child() { self.j = self.value_arena[385024 + self.walk_depth]; self.value_arena[385024 + self.walk_depth] = self.j + 1; self.found = self.metadata_arena[16384 + self.type_id]; self.walk_index = self.metadata_arena[106496 + 128 + self.found] + self.j; self.value = self.constant_children[self.constant_arena[8192 + self.const_id] + self.j]; self.offset = self.value_arena[376832 + self.walk_depth] + self.metadata_arena[106496 + 17024 + self.walk_index]; transition 0 { _ -> push() } }
    state array() { transition self.value_arena[385024 + self.walk_depth] < self.constant_arena[16384 + self.const_id] { true -> array_child() _ -> pop() } }
    state array_child() { self.j = self.value_arena[385024 + self.walk_depth]; self.value_arena[385024 + self.walk_depth] = self.j + 1; self.value = self.constant_children[self.constant_arena[8192 + self.const_id] + self.j]; self.offset = self.value_arena[376832 + self.walk_depth] + self.j * self.metadata_arena[49152 + self.metadata_arena[16384 + self.type_id]]; transition 0 { _ -> push() } }
    state shared_bytes() { transition self.value_arena[385024 + self.walk_depth] < self.constant_arena[16384 + self.const_id] { true -> shared_child() _ -> pop() } }
    state shared_child() { self.j = self.value_arena[385024 + self.walk_depth]; self.value_arena[385024 + self.walk_depth] = self.j + 1; self.value = self.constant_children[self.constant_arena[8192 + self.const_id] + self.j]; self.offset = self.value_arena[376832 + self.walk_depth] + self.j; transition 0 { _ -> push() } }
    state push() { transition self.walk_depth < 8191 { true -> pushed() _ -> exhausted() } }
    state pushed() { self.walk_depth = self.walk_depth + 1; self.value_arena[368640 + self.walk_depth] = self.value; self.value_arena[376832 + self.walk_depth] = self.offset; self.value_arena[385024 + self.walk_depth] = 0; transition 0 { _ -> loop() } }
    state pop() { self.walk_depth = self.walk_depth - 1; transition 0 { _ -> loop() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::build_constant_image(&mut self) {
    self.i = 0; self.const_image_size = 0; self.ro_size = 0;
    transition 0 { _ -> roots() }
    state roots() { transition self.i < self.const_count { true -> root() _ -> round() } }
    state root() { transition self.constant_arena[40960 + self.i] == 1 { true -> align() _ -> root_next() } }
    state align() { self.type_id = self.constant_arena[0 + self.i]; transition self.metadata_arena[0 + self.type_id] == 7 { true -> shared_align() _ -> ordinary_align() } }
    state shared_align() { self.align = 1; transition 0 { _ -> align_compute() } }
    state ordinary_align() { self.align = self.metadata_arena[57344 + self.type_id]; transition 0 { _ -> align_compute() } }
    state align_compute() { self.pad = (self.align - (self.const_image_size % self.align)) % self.align; transition self.pad <= 131072 - self.const_image_size { true -> aligned() _ -> exhausted() } }
    state aligned() { self.const_image_size = self.const_image_size + self.pad; self.constant_arena[57344 + self.i] = self.const_image_size; transition self.metadata_arena[0 + self.type_id] == 7 { true -> shared_size() _ -> ordinary_size() } }
    state shared_size() { self.size = self.constant_arena[16384 + self.i]; transition self.size == 0 { true -> anchor() _ -> sized() } }
    state ordinary_size() { self.size = self.metadata_arena[49152 + self.type_id]; transition self.size == 0 { true -> anchor() _ -> sized() } }
    state anchor() { self.size = 1; transition 0 { _ -> sized() } }
    state sized() { transition self.size <= 131072 - self.const_image_size { true -> materialize() _ -> exhausted() } }
    state materialize() { self.materialize_constant(self.i, self.const_image_size); transition self.status == 0 { true -> advance() _ -> done() } }
    state advance() { self.const_image_size = self.const_image_size + self.size; transition 0 { _ -> root_next() } }
    state root_next() { self.i = self.i + 1; transition 0 { _ -> roots() } }
    state round() { transition self.const_image_size == 0 { true -> done() _ -> round_pad() } }
    state round_pad() { self.pad = (4096 - (self.const_image_size % 4096)) % 4096; transition self.pad <= 131072 - self.const_image_size { true -> round_keep() _ -> exhausted() } }
    state round_keep() { self.ro_size = self.const_image_size + self.pad; transition 0 { _ -> done() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_edge(&mut self, start: i32, count: i32, target: i32) {
    self.j = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j < count { true -> value() _ -> done() } }
    state value() { self.value = self.operand_at(start + self.j); self.found = self.value_visible(self.value); transition self.found == 1 { true -> type() _ -> bad() } }
    state type() { self.type_id = self.metadata_arena[106496 + 59008 + self.metadata_arena[106496 + 42624 + target] + self.j]; self.type2 = self.value_arena[0 + self.value]; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> scalar_type() _ -> scalar_u64() } }
    state scalar_u64() { transition self.metadata_arena[0 + self.type_id] == 8 { true -> scalar_type() _ -> structural_type() } }
    state scalar_type() { transition self.metadata_arena[0 + self.type2] == self.metadata_arena[0 + self.type_id] { true -> direct_constructor() _ -> bad() } }
    state structural_type() { transition self.type2 == self.type_id { true -> direct_constructor() _ -> bad() } }
    state direct_constructor() { self.k = self.value_arena[122880 + self.value]; transition self.k >= 0 { true -> direct_constructor_opcode() _ -> next() } }
    state direct_constructor_opcode() { transition self.operation_arena[65536 + self.k] == 13 { true -> bad() _ -> direct_case_constructor() } }
    state direct_case_constructor() { transition self.operation_arena[65536 + self.k] == 14 { true -> bad() _ -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::validate_case_arm(&mut self, arm: i32, expected_case: i32) {
    transition self.case_arm_arena[0 + arm] == self.i { true -> case_id() _ -> bad() }
    state case_id() { transition self.case_arm_arena[4096 + arm] == expected_case { true -> target_owner() _ -> bad() } }
    state target_owner() { self.target = self.case_arm_arena[8192 + arm]; transition self.metadata_arena[106496 + 38528 + self.target] == self.current_machine { true -> target_entry() _ -> bad() } }
    state target_entry() { transition self.target == self.metadata_arena[106496 + 26112 + self.current_machine] { true -> bad() _ -> target_arity() } }
    state target_arity() { transition self.case_arm_arena[16384 + arm] == self.metadata_arena[106496 + 44672 + self.target] { true -> args_setup() _ -> bad() } }
    state args_setup() { self.j = 0; self.copy_ok = 0; transition 0 { _ -> args() } }
    state args() { transition self.j < self.case_arm_arena[16384 + arm] { true -> argument() _ -> complete() } }
    state argument() { self.k = self.case_arm_arena[12288 + arm] + self.j; transition self.case_arm_arg_kind[self.k] { 1 -> ordinary() 2 -> payload() _ -> bad() } }
    state ordinary() { self.value = self.case_arm_arg_ref[self.k]; self.found = self.value_visible(self.value); transition self.found == 1 { true -> ordinary_constructor() _ -> bad() } }
    state ordinary_constructor() { self.found = self.value_arena[122880 + self.value]; transition self.found >= 0 { true -> ordinary_opcode() _ -> ordinary_type() } }
    state ordinary_opcode() { transition self.operation_arena[65536 + self.found] == 13 { true -> bad() _ -> ordinary_case_opcode() } }
    state ordinary_case_opcode() { transition self.operation_arena[65536 + self.found] == 14 { true -> bad() _ -> ordinary_type() } }
    state ordinary_type() { self.type2 = self.value_arena[0 + self.value]; transition 0 { _ -> parameter_type() } }
    state payload() { self.value = self.case_arm_arg_ref[self.k]; transition self.value >= self.case_arena[8192 + expected_case] { true -> payload_high() _ -> bad() } }
    state payload_high() { transition self.value < self.case_arena[8192 + expected_case] + self.case_arena[12288 + expected_case] { true -> payload_duplicate_setup() _ -> bad() } }
    state payload_duplicate_setup() { self.found = 0; transition 0 { _ -> payload_duplicates() } }
    state payload_duplicates() { transition self.found < self.j { true -> payload_duplicate() _ -> payload_keep() } }
    state payload_duplicate() { self.value2 = self.case_arm_arena[12288 + arm] + self.found; transition self.case_arm_arg_kind[self.value2] == 2 { true -> payload_duplicate_ref() _ -> payload_duplicate_next() } }
    state payload_duplicate_ref() { transition self.case_arm_arg_ref[self.value2] == self.value { true -> bad() _ -> payload_duplicate_next() } }
    state payload_duplicate_next() { self.found = self.found + 1; transition 0 { _ -> payload_duplicates() } }
    state payload_keep() { self.copy_ok = self.copy_ok + 1; self.type2 = self.payload_arena[8192 + self.value]; transition 0 { _ -> parameter_type() } }
    state parameter_type() { self.type_id = self.metadata_arena[106496 + 59008 + self.metadata_arena[106496 + 42624 + self.target] + self.j]; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> scalar_type() _ -> scalar_u64() } }
    state scalar_u64() { transition self.metadata_arena[0 + self.type_id] == 8 { true -> scalar_type() _ -> structural_type() } }
    state scalar_type() { transition self.metadata_arena[0 + self.type2] == self.metadata_arena[0 + self.type_id] { true -> next() _ -> bad() } }
    state structural_type() { transition self.type2 == self.type_id { true -> next() _ -> bad() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> args() } }
    state complete() { transition self.copy_ok == self.case_arena[12288 + expected_case] { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::validate_terminators(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.term_count { true -> classify() _ -> root_flag() } }
    state classify() { self.current_block = self.i; self.current_machine = self.metadata_arena[106496 + 38528 + self.i]; transition self.metadata_arena[173696 + 0 + self.i] { 1 -> jump() 2 -> branch() 3 -> return_unit() 4 -> return_value() 5 -> dispatch_subject_kind() _ -> bad() } }
    state jump() { self.current_op = self.metadata_arena[106496 + 46720 + self.i] + self.metadata_arena[106496 + 48768 + self.i]; self.validate_edge(self.metadata_arena[173696 + 6144 + self.i], self.metadata_arena[173696 + 8192 + self.i], self.metadata_arena[173696 + 4096 + self.i]); transition self.status == 0 { true -> advance() _ -> done() } }
    state branch() { self.value = self.metadata_arena[173696 + 2048 + self.i]; self.current_op = self.metadata_arena[106496 + 46720 + self.i] + self.metadata_arena[106496 + 48768 + self.i]; self.found = self.value_visible(self.value); transition self.found == 1 { true -> branch_bool() _ -> bad() } }
    state branch_bool() { transition self.value_arena[0 + self.value] == self.bool_type { true -> branch_edge0() _ -> bad() } }
    state branch_edge0() { self.validate_edge(self.metadata_arena[173696 + 6144 + self.i], self.metadata_arena[173696 + 8192 + self.i], self.metadata_arena[173696 + 4096 + self.i]); transition self.status == 0 { true -> branch_edge1() _ -> done() } }
    state branch_edge1() { self.validate_edge(self.metadata_arena[173696 + 12288 + self.i], self.metadata_arena[173696 + 14336 + self.i], self.metadata_arena[173696 + 10240 + self.i]); transition self.status == 0 { true -> advance() _ -> done() } }
    state return_unit() { transition self.metadata_arena[106496 + 25472 + self.current_machine] < 0 { true -> advance() _ -> bad() } }
    state return_value() { self.value = self.metadata_arena[173696 + 2048 + self.i]; self.current_op = self.metadata_arena[106496 + 46720 + self.i] + self.metadata_arena[106496 + 48768 + self.i]; self.found = self.value_visible(self.value); transition self.found == 1 { true -> return_type() _ -> bad() } }
    state return_type() { self.type_id = self.metadata_arena[106496 + 25472 + self.current_machine]; self.type2 = self.value_arena[0 + self.value]; transition self.metadata_arena[0 + self.type_id] == self.metadata_arena[0 + self.type2] { true -> return_scalar() _ -> bad() } }
    state return_scalar() { transition self.metadata_arena[0 + self.value_arena[0 + self.value]] <= 3 { true -> advance() _ -> return_u64() } }
    state return_u64() { transition self.metadata_arena[0 + self.value_arena[0 + self.value]] == 8 { true -> advance() _ -> bad() } }
    state dispatch_subject_kind() { self.value = self.metadata_arena[173696 + 2048 + self.i]; self.current_op = self.metadata_arena[106496 + 46720 + self.i] + self.metadata_arena[106496 + 48768 + self.i]; transition self.metadata_arena[190080 + self.i] { 1 -> dispatch_value() 2 -> dispatch_place() _ -> bad() } }
    state dispatch_value() { self.found = self.value_visible(self.value); transition self.found == 1 { true -> dispatch_value_type() _ -> bad() } }
    state dispatch_value_type() { self.type_id = self.value_arena[0 + self.value]; transition 0 { _ -> dispatch_sum_kind() } }
    state dispatch_place() { self.found = self.place_visible(self.value, self.current_block, self.current_op); transition self.found == 1 { true -> dispatch_place_type() _ -> bad() } }
    state dispatch_place_type() { self.type_id = self.value_arena[204800 + self.value]; transition 0 { _ -> dispatch_sum_kind() } }
    state dispatch_sum_kind() { transition self.metadata_arena[0 + self.type_id] == 6 { true -> dispatch_sum() _ -> bad() } }
    state dispatch_sum() { self.found = self.metadata_arena[16384 + self.type_id]; transition self.metadata_arena[194176 + self.i] == self.sum_arena[256 + self.found] { true -> dispatch_arms_setup() _ -> bad() } }
    state dispatch_arms_setup() { self.pass = 0; self.next = self.sum_arena[128 + self.found]; transition 0 { _ -> dispatch_arms() } }
    state dispatch_arms() { transition self.pass < self.metadata_arena[194176 + self.i] { true -> dispatch_arm() _ -> advance() } }
    state dispatch_arm() { self.k = self.metadata_arena[192128 + self.i] + self.pass; self.validate_case_arm(self.k, self.next + self.pass); transition self.status == 0 { true -> dispatch_arm_next() _ -> done() } }
    state dispatch_arm_next() { self.pass = self.pass + 1; transition 0 { _ -> dispatch_arms() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state root_flag() { transition self.flags == 0 { true -> done() _ -> root_range() } }
    state root_range() { self.found = self.valid_id(self.entry_id, self.machine_count); transition self.found == 1 { true -> root_params() _ -> bad() } }
    state root_params() { transition self.metadata_arena[106496 + 25728 + self.entry_id] == 0 { true -> root_result() _ -> bad() } }
    state root_result() { self.type_id = self.metadata_arena[106496 + 25472 + self.entry_id]; transition self.type_id >= 0 { true -> root_scalar() _ -> bad() } }
    state root_scalar() { transition self.metadata_arena[0 + self.type_id] <= 3 { true -> root_entry_params() _ -> bad() } }
    state root_entry_params() { transition self.metadata_arena[106496 + 44672 + self.metadata_arena[106496 + 26112 + self.entry_id]] == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::slice_block_shape(&mut self, block: i32) -> i32 {
    let start: i32 = self.metadata_arena[106496 + 46720 + block];
    let count: i32 = self.metadata_arena[106496 + 48768 + block];
    self.slice_passthrough = 0; self.copy_ok = 0; self.zero_ok = 0; self.slice_source = 0; self.slice_head_result_id = 0;
    transition 0 { _ -> scan() }
    state scan() { transition self.slice_passthrough < count { true -> scan_opcode() _ -> complete() } }
    state scan_opcode() { transition self.operation_arena[65536 + start + self.slice_passthrough] { 24 -> head_check() 25 -> tail_check() _ -> other() } }
    state head_check() { transition self.slice_head_result_id == 0 { true -> head() _ -> malformed() } }
    state head() { self.copy_ok = 1; self.slice_source = 1; transition 0 { _ -> scan_next() } }
    state tail_check() { transition self.slice_head_result_id == 0 { true -> tail() _ -> malformed() } }
    state tail() { self.zero_ok = 1; self.slice_source = 1; transition 0 { _ -> scan_next() } }
    state other() { transition self.slice_source == 0 { true -> other_keep() _ -> malformed() } }
    state other_keep() { self.slice_head_result_id = 1; transition 0 { _ -> scan_next() } }
    state scan_next() { self.slice_passthrough = self.slice_passthrough + 1; transition 0 { _ -> scan() } }
    state complete() { transition self.slice_source == 0 { true -> ordinary() _ -> complete_head() } }
    state complete_head() { transition self.copy_ok == 1 { true -> complete_tail() _ -> malformed() } }
    state complete_tail() { transition self.zero_ok == 1 { true -> selected() _ -> malformed() } }
    state selected() { return 1; }
    state ordinary() { return 0; }
    state malformed() { return 0 - 1; }
}

// CKIR15 keeps the generic edge emitter, but independently proves the richer
// recurrent relation before sizing any frame or instruction.  Shape, unique
// predecessor custody, and vector identity are separate passes so no one pass
// recognizes a complete fixture by census or block number.
machine Main::validate_slice15_shape(&mut self, block: i32) {
    self.slice_block = block;
    self.slice_param_count = self.metadata_arena[106496 + 44672 + block];
    transition self.slice_param_count >= 1 { true -> parameter_cap() _ -> bad() }
    state parameter_cap() { transition self.slice_param_count <= 6 { true -> leading_parameter() _ -> bad() } }
    state leading_parameter() { self.i = self.metadata_arena[106496 + 42624 + block]; self.slice_parameter = self.metadata_arena[106496 + 63104 + self.i]; transition self.value_arena[0 + self.slice_parameter] == self.slice_type { true -> operations_count() _ -> bad() } }
    state operations_count() { transition self.metadata_arena[106496 + 48768 + block] == 2 { true -> head_opcode() _ -> bad() } }
    state head_opcode() { self.i = self.metadata_arena[106496 + 46720 + block]; transition self.operation_arena[65536 + self.i] == 24 { true -> head_operand() _ -> bad() } }
    state head_operand() { self.value = self.operand_at(self.operation_arena[196608 + self.i]); transition self.value == self.slice_parameter { true -> head_result() _ -> bad() } }
    state head_result() { self.slice_head_result_id = self.operation_arena[131072 + self.i]; self.i = self.i + 1; transition self.operation_arena[65536 + self.i] == 25 { true -> tail_operand() _ -> bad() } }
    state tail_operand() { self.value = self.operand_at(self.operation_arena[196608 + self.i]); transition self.value == self.slice_parameter { true -> tail_result() _ -> bad() } }
    state tail_result() { self.slice_tail_result_id = self.operation_arena[131072 + self.i]; transition self.metadata_arena[173696 + block] == 1 { true -> jump_target() _ -> bad() } }
    state jump_target() { self.target = self.metadata_arena[173696 + 4096 + block]; transition self.block_flags[self.target] == 0 { true -> jump_owner() _ -> bad() } }
    state jump_owner() { transition self.metadata_arena[106496 + 38528 + self.target] == self.metadata_arena[106496 + 38528 + block] { true -> jump_count() _ -> bad() } }
    state jump_count() { transition self.metadata_arena[173696 + 8192 + block] == self.slice_param_count + 1 { true -> target_count() _ -> bad() } }
    state target_count() { transition self.metadata_arena[106496 + 44672 + self.target] == self.slice_param_count + 1 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::validate_slice15_predecessor(&mut self, block: i32) {
    self.slice_block = block; self.slice_predecessor = 0 - 1; self.k = 0; self.j = 0;
    transition 0 { _ -> terms() }
    state terms() { transition self.j < self.term_count { true -> term_kind() _ -> case_setup() } }
    state term_kind() { transition self.metadata_arena[173696 + self.j] { 1 -> jump() 2 -> branch_true() _ -> term_next() } }
    state jump() { transition self.metadata_arena[173696 + 4096 + self.j] == block { true -> bad() _ -> term_next() } }
    state branch_true() { transition self.metadata_arena[173696 + 4096 + self.j] == block { true -> predecessor_keep() _ -> branch_false() } }
    state predecessor_keep() { self.k = self.k + 1; self.slice_predecessor = self.j; transition 0 { _ -> branch_false() } }
    state branch_false() { transition self.metadata_arena[173696 + 10240 + self.j] == block { true -> bad() _ -> term_next() } }
    state term_next() { self.j = self.j + 1; transition 0 { _ -> terms() } }
    state case_setup() { self.j = 0; transition 0 { _ -> cases() } }
    state cases() { transition self.j < self.case_arm_count { true -> case_target() _ -> predecessor_exact() } }
    state case_target() { transition self.case_arm_arena[8192 + self.j] == block { true -> bad() _ -> case_next() } }
    state case_next() { self.j = self.j + 1; transition 0 { _ -> cases() } }
    state predecessor_exact() { transition self.k == 1 { true -> predecessor_authored() _ -> bad() } }
    state predecessor_authored() { transition self.block_flags[self.slice_predecessor] == 0 { true -> predecessor_owner() _ -> bad() } }
    state predecessor_owner() { transition self.metadata_arena[106496 + 38528 + self.slice_predecessor] == self.metadata_arena[106496 + 38528 + block] { true -> guard_value() _ -> bad() } }
    state guard_value() { self.value = self.metadata_arena[173696 + 2048 + self.slice_predecessor]; self.i = self.value_arena[122880 + self.value]; transition self.i >= 0 { true -> guard_opcode() _ -> bad() } }
    state guard_opcode() { transition self.operation_arena[65536 + self.i] == 23 { true -> guard_block() _ -> bad() } }
    state guard_block() { transition self.operation_arena[32768 + self.i] == self.slice_predecessor { true -> source_value() _ -> bad() } }
    state source_value() { self.slice_source = self.operand_at(self.operation_arena[196608 + self.i]); transition self.value_arena[122880 + self.slice_source] == 0 - 1 { true -> true_count() _ -> bad() } }
    state true_count() { transition self.metadata_arena[173696 + 8192 + self.slice_predecessor] == self.slice_param_count { true -> false_target() _ -> bad() } }
    state false_target() { self.target = self.metadata_arena[173696 + 10240 + self.slice_predecessor]; transition self.block_flags[self.target] == 0 { true -> false_owner() _ -> bad() } }
    state false_owner() { transition self.metadata_arena[106496 + 38528 + self.target] == self.metadata_arena[106496 + 38528 + block] { true -> false_count() _ -> bad() } }
    state false_count() { transition self.metadata_arena[173696 + 14336 + self.slice_predecessor] == self.slice_param_count - 1 { true -> false_target_count() _ -> bad() } }
    state false_target_count() { transition self.metadata_arena[106496 + 44672 + self.target] == self.slice_param_count - 1 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::validate_slice15_vectors(&mut self, block: i32) {
    self.slice_block = block; self.i = 0;
    transition 0 { _ -> incoming() }
    state incoming() { transition self.i < self.slice_param_count { true -> incoming_value() _ -> jump_setup() } }
    state incoming_value() { self.value = self.operand_at(self.metadata_arena[173696 + 6144 + self.slice_predecessor] + self.i); self.j = self.metadata_arena[106496 + 42624 + block] + self.i; self.value2 = self.metadata_arena[106496 + 63104 + self.j]; transition self.value_arena[0 + self.value] == self.value_arena[0 + self.value2] { true -> incoming_direct() _ -> bad() } }
    state incoming_direct() { transition self.value_arena[122880 + self.value] == 0 - 1 { true -> incoming_distinct_setup() _ -> bad() } }
    state incoming_distinct_setup() { self.j = 0; transition 0 { _ -> incoming_distinct() } }
    state incoming_distinct() { transition self.j < self.i { true -> incoming_compare() _ -> incoming_position() } }
    state incoming_compare() { self.value2 = self.operand_at(self.metadata_arena[173696 + 6144 + self.slice_predecessor] + self.j); transition self.value2 == self.value { true -> bad() _ -> incoming_distinct_next() } }
    state incoming_distinct_next() { self.j = self.j + 1; transition 0 { _ -> incoming_distinct() } }
    state incoming_position() { transition self.i == 0 { true -> incoming_view() _ -> incoming_pass() } }
    state incoming_view() { transition self.value == self.slice_source { true -> incoming_next() _ -> bad() } }
    state incoming_pass() { self.value2 = self.operand_at(self.metadata_arena[173696 + 12288 + self.slice_predecessor] + self.i - 1); transition self.value2 == self.value { true -> false_type() _ -> bad() } }
    state false_type() { self.j = self.metadata_arena[106496 + 42624 + self.metadata_arena[173696 + 10240 + self.slice_predecessor]] + self.i - 1; transition self.metadata_arena[106496 + 59008 + self.j] == self.value_arena[0 + self.value] { true -> incoming_next() _ -> bad() } }
    state incoming_next() { self.i = self.i + 1; transition 0 { _ -> incoming() } }
    state jump_setup() { self.i = 0; self.slice_vector_index = 1; self.slice_head_seen = 0; self.slice_tail_seen = 0; transition 0 { _ -> jump() } }
    state jump() { transition self.i < self.slice_param_count + 1 { true -> jump_value() _ -> jump_complete() } }
    state jump_value() { self.value = self.operand_at(self.metadata_arena[173696 + 6144 + block] + self.i); transition self.value == self.slice_head_result_id { true -> jump_head() _ -> jump_tail_check() } }
    state jump_head() { transition self.slice_head_seen == 0 { true -> jump_head_before_tail() _ -> bad() } }
    state jump_head_before_tail() { transition self.slice_tail_seen == 0 { true -> jump_head_keep() _ -> bad() } }
    state jump_head_keep() { self.slice_head_seen = 1; transition 0 { _ -> jump_type() } }
    state jump_tail_check() { transition self.value == self.slice_tail_result_id { true -> jump_tail() _ -> jump_pass() } }
    state jump_tail() { transition self.slice_head_seen == 1 { true -> jump_tail_once() _ -> bad() } }
    state jump_tail_once() { transition self.slice_tail_seen == 0 { true -> jump_tail_keep() _ -> bad() } }
    state jump_tail_keep() { self.slice_tail_seen = 1; transition 0 { _ -> jump_type() } }
    state jump_pass() { transition self.slice_vector_index < self.slice_param_count { true -> jump_expected_pass() _ -> bad() } }
    state jump_expected_pass() { self.j = self.metadata_arena[106496 + 42624 + block] + self.slice_vector_index; self.value2 = self.metadata_arena[106496 + 63104 + self.j]; transition self.value == self.value2 { true -> jump_pass_keep() _ -> bad() } }
    state jump_pass_keep() { self.slice_vector_index = self.slice_vector_index + 1; transition 0 { _ -> jump_type() } }
    state jump_type() { self.j = self.metadata_arena[106496 + 42624 + self.metadata_arena[173696 + 4096 + block]] + self.i; transition self.metadata_arena[106496 + 59008 + self.j] == self.value_arena[0 + self.value] { true -> jump_next() _ -> bad() } }
    state jump_next() { self.i = self.i + 1; transition 0 { _ -> jump() } }
    state jump_complete() { transition self.slice_vector_index == self.slice_param_count { true -> jump_head_complete() _ -> bad() } }
    state jump_head_complete() { transition self.slice_head_seen == 1 { true -> jump_tail_complete() _ -> bad() } }
    state jump_tail_complete() { transition self.slice_tail_seen == 1 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
