machine Main::validate_slice_control15(&mut self) {
    self.i = 0; self.slice_synthetic_count = 0; self.slice_passthrough = 0;
    self.slice_last_owner = 0 - 1; self.slice_seen_synthetic = 0;
    transition 0 { _ -> block_flags() }
    state block_flags() { transition self.i < self.block_count { true -> block_owner() _ -> counts() } }
    state block_owner() { self.current_machine = self.metadata_arena[106496 + 38528 + self.i]; transition self.current_machine == self.slice_last_owner { true -> block_flag() _ -> owner_reset() } }
    state owner_reset() { self.slice_last_owner = self.current_machine; self.slice_seen_synthetic = 0; transition 0 { _ -> block_flag() } }
    state block_flag() { transition self.block_flags[self.i] == 1 { true -> synthetic_count() _ -> authored_order() } }
    state authored_order() { transition self.slice_seen_synthetic == 0 { true -> block_next() _ -> bad() } }
    state synthetic_count() { self.slice_seen_synthetic = 1; self.slice_synthetic_count = self.slice_synthetic_count + 1; self.slice_param_count = self.metadata_arena[106496 + 44672 + self.i]; transition self.slice_param_count >= 1 { true -> synthetic_param_cap() _ -> bad() } }
    state synthetic_param_cap() { transition self.slice_param_count <= 6 { true -> synthetic_pass_count() _ -> bad() } }
    state synthetic_pass_count() { self.slice_passthrough = self.slice_passthrough + self.slice_param_count - 1; transition 0 { _ -> block_next() } }
    state block_next() { self.i = self.i + 1; transition 0 { _ -> block_flags() } }
    state counts() { transition self.slice_synthetic_count >= 2 { true -> pass_count() _ -> bad() } }
    state pass_count() { transition self.slice_passthrough > 0 { true -> head_count() _ -> bad() } }
    state head_count() { transition self.slice_head_count == self.slice_synthetic_count { true -> tail_count() _ -> bad() } }
    state tail_count() { transition self.slice_tail_count == self.slice_synthetic_count { true -> partial_setup() _ -> bad() } }
    state partial_setup() { self.i = 0; transition 0 { _ -> partials() } }
    state partials() { transition self.i < self.op_count { true -> partial_opcode() _ -> selected_setup() } }
    state partial_opcode() { transition self.operation_arena[65536 + self.i] { 24 -> partial_owner() 25 -> partial_owner() _ -> partial_next() } }
    state partial_owner() { self.current_block = self.operation_arena[32768 + self.i]; transition self.block_flags[self.current_block] == 1 { true -> partial_next() _ -> bad() } }
    state partial_next() { self.i = self.i + 1; transition 0 { _ -> partials() } }
    state selected_setup() { self.i = 0; self.slice_last_owner = 0 - 1; self.slice_last_predecessor = 0 - 1; transition 0 { _ -> selected() } }
    state selected() { transition self.i < self.block_count { true -> selected_flag() _ -> done() } }
    state selected_flag() { transition self.block_flags[self.i] == 1 { true -> selected_owner() _ -> authored_next() } }
    state authored_next() { self.i = self.i + 1; transition 0 { _ -> selected() } }
    state selected_owner() { self.current_machine = self.metadata_arena[106496 + 38528 + self.i]; transition self.current_machine == self.slice_last_owner { true -> selected_shape() _ -> selected_owner_reset() } }
    state selected_owner_reset() { self.slice_last_owner = self.current_machine; self.slice_last_predecessor = 0 - 1; transition 0 { _ -> selected_shape() } }
    state selected_shape() { self.validate_slice15_shape(self.i); transition self.status == 0 { true -> selected_predecessor() _ -> done() } }
    state selected_predecessor() { self.validate_slice15_predecessor(self.slice_block); transition self.status == 0 { true -> selected_order() _ -> done() } }
    state selected_order() { transition self.slice_predecessor > self.slice_last_predecessor { true -> selected_order_keep() _ -> bad() } }
    state selected_order_keep() { self.slice_last_predecessor = self.slice_predecessor; self.validate_slice15_vectors(self.slice_block); transition self.status == 0 { true -> selected_next() _ -> done() } }
    state selected_next() { self.i = self.slice_block + 1; transition 0 { _ -> selected() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::validate_slice_control(&mut self) {
    transition self.schema_major == 12 { true -> blocks_setup() _ -> optional14() }
    state optional14() { transition self.schema_major == 14 { true -> selected14() _ -> selected15() } }
    state selected15() { transition self.schema_major == 15 { true -> run15() _ -> selected16() } }
    state selected16() { transition self.schema_major == 16 { true -> optional16() _ -> done() } }
    state optional16() { transition self.slice_selected == 1 { true -> run15() _ -> done() } }
    state run15() { self.validate_slice_control15(); transition 0 { _ -> done() } }
    state selected14() { transition self.slice_selected == 1 { true -> blocks_setup() _ -> done() } }
    state blocks_setup() { self.i = 0; self.slice_tail_result_id = 0; self.slice_block = 0 - 1; transition 0 { _ -> blocks() } }
    state blocks() { transition self.i < self.block_count { true -> shape() _ -> block_exact() } }
    state shape() { self.found = self.slice_block_shape(self.i); transition self.found { 0 -> ordinary_flag() 1 -> synthetic_flag() _ -> bad() } }
    state ordinary_flag() { transition self.block_flags[self.i] == 0 { true -> block_next() _ -> bad() } }
    state synthetic_flag() { transition self.block_flags[self.i] == 1 { true -> synthetic_keep() _ -> bad() } }
    state synthetic_keep() { self.slice_tail_result_id = self.slice_tail_result_id + 1; self.slice_block = self.i; transition self.slice_tail_result_id <= 1 { true -> block_next() _ -> bad() } }
    state predecessor_setup() { self.j = 0; self.k = 0; self.slice_predecessor = 0 - 1; transition 0 { _ -> predecessors() } }
    state predecessors() { transition self.j < self.term_count { true -> predecessor_kind() _ -> case_predecessors_setup() } }
    state predecessor_kind() { transition self.metadata_arena[173696 + self.j] { 1 -> predecessor_jump() 2 -> predecessor_branch0() _ -> predecessor_next() } }
    state predecessor_jump() { transition self.metadata_arena[173696 + 4096 + self.j] == self.slice_block { true -> bad() _ -> predecessor_next() } }
    state predecessor_branch0() { transition self.metadata_arena[173696 + 4096 + self.j] == self.slice_block { true -> predecessor_keep() _ -> predecessor_branch1() } }
    state predecessor_keep() { self.k = self.k + 1; self.slice_predecessor = self.j; transition 0 { _ -> predecessor_branch1() } }
    state predecessor_branch1() { transition self.metadata_arena[173696 + 10240 + self.j] == self.slice_block { true -> bad() _ -> predecessor_next() } }
    state predecessor_next() { self.j = self.j + 1; transition 0 { _ -> predecessors() } }
    state case_predecessors_setup() { self.j = 0; transition 0 { _ -> case_predecessors() } }
    state case_predecessors() { transition self.j < self.case_arm_count { true -> case_predecessor() _ -> predecessor_exact() } }
    state case_predecessor() { transition self.case_arm_arena[8192 + self.j] == self.slice_block { true -> bad() _ -> case_predecessor_next() } }
    state case_predecessor_next() { self.j = self.j + 1; transition 0 { _ -> case_predecessors() } }
    state predecessor_exact() { transition self.k == 1 { true -> predecessor_guard() _ -> bad() } }
    state predecessor_guard() { self.value = self.metadata_arena[173696 + 2048 + self.slice_predecessor]; self.j = self.value_arena[122880 + self.value]; transition self.j >= 0 { true -> predecessor_guard_opcode() _ -> bad() } }
    state predecessor_guard_opcode() { transition self.operation_arena[65536 + self.j] == 23 { true -> predecessor_guard_owner() _ -> bad() } }
    state predecessor_guard_owner() { transition self.operation_arena[32768 + self.j] == self.slice_predecessor { true -> predecessor_source() _ -> bad() } }
    state predecessor_source() { self.slice_source = self.operand_at(self.operation_arena[196608 + self.j]); transition self.metadata_arena[173696 + 8192 + self.slice_predecessor] == 1 { true -> predecessor_argument() _ -> bad() } }
    state predecessor_argument() { self.value = self.operand_at(self.metadata_arena[173696 + 6144 + self.slice_predecessor]); transition self.value == self.slice_source { true -> predecessor_false_distinct() _ -> bad() } }
    state predecessor_false_distinct() { self.target = self.metadata_arena[173696 + 10240 + self.slice_predecessor]; transition self.target != self.slice_block { true -> predecessor_false_flag() _ -> bad() } }
    state predecessor_false_flag() { transition self.block_flags[self.target] == 0 { true -> synthetic_operations_setup() _ -> bad() } }
    state synthetic_operations_setup() { self.i = self.metadata_arena[106496 + 46720 + self.slice_block]; self.end = self.i + self.metadata_arena[106496 + 48768 + self.slice_block]; transition 0 { _ -> synthetic_operations() } }
    state synthetic_operations() { transition self.i < self.end { true -> synthetic_operand() _ -> jump_target() } }
    state synthetic_operand() { self.value = self.operand_at(self.operation_arena[196608 + self.i]); transition self.value == self.slice_parameter { true -> synthetic_operation_next() _ -> bad() } }
    state synthetic_operation_next() { self.i = self.i + 1; transition 0 { _ -> synthetic_operations() } }
    state jump_target() { self.target = self.metadata_arena[173696 + 4096 + self.slice_block]; transition self.block_flags[self.target] == 0 { true -> done() _ -> bad() } }
    state block_exact() { transition self.slice_tail_result_id == 1 { true -> parameter_count() _ -> bad() } }
    state parameter_count() { transition self.metadata_arena[106496 + 44672 + self.slice_block] == 1 { true -> parameter() _ -> bad() } }
    state parameter() { self.j = self.metadata_arena[106496 + 42624 + self.slice_block]; self.slice_parameter = self.metadata_arena[106496 + 63104 + self.j]; transition self.value_arena[0 + self.slice_parameter] == self.slice_type { true -> terminator() _ -> bad() } }
    state terminator() { transition self.metadata_arena[173696 + self.slice_block] == 1 { true -> predecessor_setup() _ -> bad() } }
    state block_next() { self.i = self.i + 1; transition 0 { _ -> blocks() } }
    state bad() { self.reject(); }
