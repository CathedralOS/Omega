    state self_mut() { self.value_arena[303104 + self.operation_arena[131072 + self.i]] = self.metadata_arena[106496 + 40576 + self.current_block] - 1; self.arithmetic_place[self.operation_arena[131072 + self.i]] = 1; transition 0 { _ -> advance() } }
    state field_place() { transition self.i == 134 { true -> field_profile_observation() _ -> field_result_kind() } }
    state field_profile_observation() { transition self.operation_arena[262144 + self.i] == 19 { true -> field_result_kind() _ -> bad() } }
