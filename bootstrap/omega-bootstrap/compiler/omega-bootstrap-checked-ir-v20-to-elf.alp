// Focused CKIR20 -> deterministic Linux x86-64 ELF for the full
// TokenStream::push pure-sum/record-array carrier.
// It accepts major 20 only. Runtime objects, active sum payloads, field
// offsets, record strides, frames, and binding snapshots are derived here; no
// producer offset, layout, or byte image is accepted.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(b: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; word: i32; bytes_read: i32; total_len: i32;
    schema_major: i32; flags: i32; entry_id: i32;
    wide_semantic_words: i32;
    type_count: i32; record_count: i32; field_count: i32;
    sum_count: i32; case_count: i32; case_payload_count: i32;
    machine_count: i32; mparam_count: i32; block_count: i32;
    bparam_count: i32; op_count: i32; operand_count: i32;
    term_count: i32; value_count: i32; place_count: i32;
    case_arm_count: i32; case_arm_arg_count: i32;
    const_count: i32; const_child_count: i32;
    const_image_size: i32; ro_size: i32; const_root_count: i32;
    const_id: i32; const_height: i32;
    i: i32; j: i32; k: i32; end: i32; next: i32; pass: i32; text_pass: i32;
    progress: i32; found: i32; expected: i32; current_machine: i32;
    current_block: i32; current_op: i32; next_value: i32; next_place: i32;
    sum_cursor: i32; sum_end: i32; sum_emission_depth: i32;
    operation_operand_end: i32; operand_cursor: i32;
    bool_type: i32; slice_type: i32; owner_type: i32; type_id: i32; type2: i32;
    size: i32; align: i32; offset: i32; pad: i32; copy_ok: i32;
    zero_ok: i32; frame_size: i32; frame_cursor: i32; scratch_base: i32;
    scratch_count: i32; text_size: i32; code_cursor: i32; trap_offset: i32;
    root_offset: i32; rx_size: i32; bss_size: i32; output_pad: i32; emitting: i32;
    queue_head: i32; queue_tail: i32; topo_count: i32; removed_count: i32;
    call_arg_count: i32; live_stack: i32;
    value: i32; value2: i32; place: i32; place2: i32; target: i32;
    displacement: i32; leaf_offset: i32; leaf_type: i32; emission_depth: i32;
    walk_depth: i32; walk_kind: i32; walk_index: i32; walk_limit: i32;
    slice_static_count: i32; slice_nonempty_count: i32;
    slice_head_count: i32; slice_tail_count: i32;
    slice_block: i32; slice_predecessor: i32; slice_source: i32;
    slice_parameter: i32; slice_head_result_id: i32; slice_tail_result_id: i32;
    slice_passthrough: i32; slice_selected: i32;
    slice_synthetic_count: i32; slice_param_count: i32;
    slice_head_seen: i32; slice_tail_seen: i32; slice_vector_index: i32;
    slice_last_owner: i32; slice_last_predecessor: i32;
    slice_seen_synthetic: i32;

    // Three fixed arenas keep related CKIR tables together. Delta needs no
    // general allocator here, and the compact ownership also prevents the
    // lower-rung meaning route from threading dozens of independent arrays
    // through every byte-read helper call.
    // Metadata owns type [0,106496), declaration [106496,173696), and
    // terminator [173696,190080) partitions.
    // CKIR5 appends terminator flags/arm spans at 190080 without moving any
    // inherited partition.
    metadata_arena: [i32; 196224];
    // CKIR rows/operands occupy [0,421888); CKIR4 uses the inherited spare
    // value-sized tail [421888,458752) for derived OBJ(value) displacements.
    operation_arena: [i32; 458752];
    value_arena: [i32; 401408];
    call_graph: [i32; 16384];
    block_flags: [i32; 2048];
    reachable: [i32; 128];
    indegree: [i32; 128];
    active_machine: [i32; 128];
    topo_order: [i32; 128];
    machine_queue: [i32; 128];
    machine_frame_size: [i32; 128];
    machine_scratch_base: [i32; 128];
    machine_live_stack: [i32; 128];
    // CKIR14 validation custody is intentionally separate from value/type
    // identity: only exact constants, total self/field loads, and earlier
    // selected arithmetic results may feed another selected arithmetic row.
    arithmetic_value: [i32; 36864];
    arithmetic_place: [i32; 32768];

    // CKIR3 constant nodes retain type/start/count/scalar/height/root/reach/image
    // partitions. Child IDs and derived image bytes are separate bounded arenas.
    constant_arena: [i32; 65536];
    constant_children: [i32; 16384];
    constant_image: [i32; 131072];

    // CKIR5 declaration metadata uses compact structure-of-arrays partitions:
    // sums 6*128, cases 6*4096, payload fields 5*4096, arms 6*4096.
    sum_arena: [i32; 768];
    case_arena: [i32; 24576];
    payload_arena: [i32; 20480];
    case_arm_arena: [i32; 24576];
    // Arm arguments retain kind and reference separately. Structural selected-
    // payload arguments receive a derived frame snapshot displacement here.
    case_arm_arg_kind: [i32; 94208];
    case_arm_arg_ref: [i32; 94208];
    case_binding_offset: [i32; 94208];
    emission_stack: [i32; 128];
    emission_cursor_stack: [i32; 128];
    sum_owner_stack: [i32; 128];
    sum_cursor_stack: [i32; 128];
    sum_end_stack: [i32; 128];
}

machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set() _ -> done() }
    state set() { self.status = 251; }
    state done() { }
}

machine Main::exhaust(&mut self) { self.status = 252; }

machine Main::read_raw(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() _ -> count() }
    state count() { transition self.bytes_read < 2522192 { true -> keep() _ -> exhausted() } }
    state keep() { self.bytes_read = self.bytes_read + 1; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_u8(&mut self) -> i32 { self.read_raw(); return self.c; }

machine Main::read_u16(&mut self) -> i32 {
    self.read_raw(); self.word = self.c;
    transition self.status == 0 { true -> high() _ -> done() }
    state high() { self.read_raw(); transition self.status == 0 { true -> combine() _ -> done() } }
    state combine() { self.word = self.word + self.c * 256; transition 0 { _ -> done() } }
    state done() { return self.word; }
}

// Structural CKIR words are either 0..INT_MAX or the exact NO_ID bit pattern.
machine Main::read_u32(&mut self) -> i32 {
    self.read_raw(); self.word = self.c;
    transition self.status == 0 { true -> b1() _ -> done() }
    state b1() { self.read_raw(); self.word = self.word + self.c * 256; transition self.status == 0 { true -> b2() _ -> done() } }
    state b2() { self.read_raw(); self.word = self.word + self.c * 65536; transition self.status == 0 { true -> b3() _ -> done() } }
    state b3() { self.read_raw(); transition self.status == 0 { true -> high() _ -> done() } }
    state high() { transition self.c < 128 { true -> combine() _ -> no_id_high() } }
    state combine() { self.word = self.word + self.c * 16777216; transition 0 { _ -> done() } }
    state no_id_high() { transition self.c == 255 { true -> no_id_low() _ -> bad() } }
    state no_id_low() { transition self.word == 16777215 { true -> no_id() _ -> bad() } }
    state no_id() { self.word = 0 - 1; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { return self.word; }
}

// CKIR14 scalar-position words admit every u32 bit pattern. Retain those bits
// in one signed cell; this decoder is never used for IDs, counts, offsets,
// ordinals, spans, roots, or NO_ID.
machine Main::read_scalar_u32(&mut self) -> i32 {
    self.read_raw(); self.word = self.c;
    transition self.status == 0 { true -> b1() _ -> done() }
    state b1() { self.read_raw(); self.word = self.word + self.c * 256; transition self.status == 0 { true -> b2() _ -> done() } }
    state b2() { self.read_raw(); self.word = self.word + self.c * 65536; transition self.status == 0 { true -> b3() _ -> done() } }
    state b3() { self.read_raw(); transition self.status == 0 { true -> high() _ -> done() } }
    state high() { transition self.c < 128 { true -> low_high() _ -> high_bit() } }
    state low_high() { self.word = self.word + self.c * 16777216; transition 0 { _ -> done() } }
    state high_bit() { self.word = self.word + (self.c - 128) * 16777216 - 2147483647 - 1; transition 0 { _ -> done() } }
    state done() { return self.word; }
}

// Unsigned comparison for semantic words retained in signed Delta cells.
machine Main::u32_le(&mut self, left: i32, right: i32) -> i32 {
    transition left < 0 { true -> left_high() _ -> left_low() }
    state left_high() { transition right < 0 { true -> same_sign() _ -> no() } }
    state left_low() { transition right < 0 { true -> yes() _ -> same_sign() } }
    state same_sign() { transition left <= right { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::is_full_u32_type(&mut self, type: i32) -> i32 {
    transition self.metadata_arena[0 + type] == 2 { true -> flags() _ -> no() }
    state flags() { transition self.metadata_arena[8192 + type] == 1 { true -> payload0() _ -> no() } }
    state payload0() { transition self.metadata_arena[16384 + type] == 0 { true -> payload1() _ -> no() } }
    state payload1() { transition self.metadata_arena[24576 + type] == 0 { true -> low() _ -> no() } }
    state low() { transition self.metadata_arena[32768 + type] == 0 { true -> high() _ -> no() } }
    state high() { transition self.metadata_arena[40960 + type] == 0 - 1 { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::expect_u8(&mut self, expected: i32) {
    self.word = self.read_u8();
    transition self.status == 0 { true -> compare() _ -> done() }
    state compare() { transition self.word == expected { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::expect_zero_u16(&mut self) {
    self.word = self.read_u16();
    transition self.status == 0 { true -> compare() _ -> done() }
    state compare() { transition self.word == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::valid_id(&mut self, value: i32, count: i32) -> i32 {
    transition value >= 0 { true -> high() _ -> no() }
    state high() { transition value < count { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::span_ok(&mut self, start: i32, count: i32, limit: i32) -> i32 {
    transition start >= 0 { true -> count_low() _ -> no() }
    state count_low() { transition count >= 0 { true -> start_bound() _ -> no() } }
    state start_bound() { transition start <= limit { true -> count_bound() _ -> no() } }
    state count_bound() { transition count <= limit - start { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::operand_at(&mut self, index: i32) -> i32 {
    transition index < 65536 { true -> low() _ -> high() }
    state low() { return self.operation_arena[327680 + index]; }
    state high() { return self.operation_arena[393216 + index - 65536]; }
}

machine Main::read_header(&mut self) {
    self.bytes_read = 0; self.status = 0;
    self.expect_u8(79); self.expect_u8(77); self.expect_u8(71); self.expect_u8(67);
    self.expect_u8(75); self.expect_u8(73); self.expect_u8(82); self.expect_u8(0);
    self.word = self.read_u16(); transition self.status == 0 { true -> major20() _ -> done() }
    state major20() { transition self.word == 20 { true -> keep_major() _ -> bad() } }
    state major4() { transition self.word == 4 { true -> keep_major() _ -> major5() } }
    state major5() { transition self.word == 5 { true -> keep_major() _ -> major6() } }
    state major6() { transition self.word == 6 { true -> keep_major() _ -> major7() } }
    state major7() { transition self.word == 7 { true -> keep_major() _ -> major8() } }
    state major8() { transition self.word == 8 { true -> keep_major() _ -> major9() } }
    state major9() { transition self.word == 9 { true -> keep_major() _ -> major10() } }
    state major10() { transition self.word == 10 { true -> keep_major() _ -> major11() } }
    state major11() { transition self.word == 11 { true -> keep_major() _ -> major12() } }
    state major12() { transition self.word == 12 { true -> keep_major() _ -> major14() } }
    state major14() { transition self.word == 14 { true -> keep_major() _ -> major15() } }
    state major15() { transition self.word == 15 { true -> keep_major() _ -> major16() } }
    state major16() { transition self.word == 16 { true -> keep_major() _ -> bad() } }
    state keep_major() { self.schema_major = self.word; self.wide_semantic_words = 1; transition 0 { _ -> minor_read() } }
    state keep_wide() { self.wide_semantic_words = 1; transition 0 { _ -> minor_read() } }
    state minor_read() { self.word = self.read_u16(); transition self.status == 0 { true -> minor() _ -> done() } }
    state minor() { transition self.word == 0 { true -> target_read() _ -> bad() } }
    state target_read() { self.word = self.read_u16(); transition self.status == 0 { true -> target() _ -> done() } }
    state target() { transition self.word == 1 { true -> flags_read() _ -> bad() } }
    state flags_read() { self.flags = self.read_u16(); transition self.status == 0 { true -> flags_check() _ -> done() } }
    state flags_check() { transition self.flags <= 1 { true -> entry_read() _ -> bad() } }
    state entry_read() { self.entry_id = self.read_u32(); transition self.status == 0 { true -> common0() _ -> done() } }
    state common0() { self.total_len = self.read_u32(); self.type_count = self.read_u32(); self.record_count = self.read_u32(); self.field_count = self.read_u32(); transition self.schema_major >= 5 { true -> sums() _ -> no_sums() } }
    state no_sums() { self.sum_count = 0; self.case_count = 0; self.case_payload_count = 0; self.case_arm_count = 0; self.case_arm_arg_count = 0; transition 0 { _ -> legacy1() } }
    state legacy1() { self.machine_count = self.read_u32(); self.mparam_count = self.read_u32(); self.block_count = self.read_u32(); self.bparam_count = self.read_u32(); self.op_count = self.read_u32(); self.operand_count = self.read_u32(); self.term_count = self.read_u32(); self.value_count = self.read_u32(); self.place_count = self.read_u32(); self.const_count = self.read_u32(); self.const_child_count = self.read_u32(); transition self.status == 0 { true -> ceilings() _ -> done() } }
    state sums() { self.sum_count = self.read_u32(); self.case_count = self.read_u32(); self.case_payload_count = self.read_u32(); transition 0 { _ -> common1() } }
    state common1() { self.machine_count = self.read_u32(); self.mparam_count = self.read_u32(); self.block_count = self.read_u32(); self.bparam_count = self.read_u32(); self.const_count = self.read_u32(); self.const_child_count = self.read_u32(); self.op_count = self.read_u32(); self.operand_count = self.read_u32(); self.term_count = self.read_u32(); transition 0 { _ -> arms() } }
    state arms() { self.case_arm_count = self.read_u32(); self.case_arm_arg_count = self.read_u32(); transition 0 { _ -> totals_tail() } }
    state totals_tail() { self.value_count = self.read_u32(); self.place_count = self.read_u32(); transition self.status == 0 { true -> ceilings() _ -> done() } }
    state ceilings() { transition self.total_len <= 2522192 { true -> type_cap() _ -> exhausted() } }
    state type_cap() { transition self.type_count <= 8192 { true -> record_cap() _ -> exhausted() } }
    state record_cap() { transition self.record_count <= 128 { true -> sum_cap() _ -> exhausted() } }
    state sum_cap() { transition self.sum_count <= 128 - self.record_count { true -> case_cap() _ -> exhausted() } }
    state case_cap() { transition self.case_count <= 4096 { true -> payload_cap() _ -> exhausted() } }
    state payload_cap() { transition self.case_payload_count <= 4096 { true -> field_cap() _ -> exhausted() } }
    state field_cap() { transition self.field_count <= 8192 - self.case_payload_count { true -> machine_cap() _ -> exhausted() } }
    state machine_cap() { transition self.machine_count <= 128 { true -> block_cap() _ -> exhausted() } }
    state block_cap() { transition self.block_count <= 2048 { true -> mp_cap() _ -> exhausted() } }
    state mp_cap() { transition self.mparam_count <= 896 { true -> bp_cap() _ -> exhausted() } }
    state bp_cap() { transition self.bparam_count <= 4096 { true -> combined_cap() _ -> exhausted() } }
    state combined_cap() { transition self.mparam_count <= 4096 - self.bparam_count { true -> op_cap() _ -> exhausted() } }
    state op_cap() { transition self.op_count <= 32768 { true -> operand_cap() _ -> exhausted() } }
    state operand_cap() { transition self.operand_count <= 94208 { true -> arm_cap() _ -> exhausted() } }
    state arm_cap() { transition self.case_arm_count <= 4096 { true -> arm_arg_cap() _ -> exhausted() } }
    state arm_arg_cap() { transition self.case_arm_arg_count <= 94208 - self.operand_count { true -> value_cap() _ -> exhausted() } }
    state value_cap() { transition self.value_count <= 36864 { true -> place_cap() _ -> exhausted() } }
    state place_cap() { transition self.place_count <= 32768 { true -> const_cap() _ -> exhausted() } }
    state const_cap() { transition self.const_count <= 8192 { true -> const_child_cap() _ -> exhausted() } }
    state const_child_cap() { transition self.const_child_count <= 16384 { true -> term_relation() _ -> exhausted() } }
    state term_relation() { transition self.term_count == self.block_count { true -> focused_constants() _ -> bad() } }
    state focused_constants() { transition self.const_count == 0 { true -> focused_children() _ -> bad() } }
    state focused_children() { transition self.const_child_count == 0 { true -> flag_relation() _ -> bad() } }
    state flag_relation() { transition self.flags == 1 { true -> entry_present() _ -> bad() } }
    state entry_present() { transition self.entry_id == 2 { true -> done() _ -> bad() } }
    state entry_absent() { transition self.entry_id == 0 - 1 { true -> done() _ -> bad() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::check_encoded_length(&mut self) {
    transition self.schema_major >= 5 { true -> header5() _ -> header4() }
    state header4() { self.expected = 80; transition 0 { _ -> types_check() } }
    state header5() { self.expected = 100; transition 0 { _ -> types_check() } }
    state types_check() { transition self.type_count <= (2147483647 - self.expected) / 24 { true -> types() _ -> bad() } }
    state types() { self.expected = self.expected + self.type_count * 24; transition self.record_count <= (2147483647 - self.expected) / 20 { true -> records() _ -> bad() } }
    state records() { self.expected = self.expected + self.record_count * 20; transition self.field_count <= (2147483647 - self.expected) / 16 { true -> fields() _ -> bad() } }
    state fields() { self.expected = self.expected + self.field_count * 16; transition self.schema_major >= 5 { true -> sum_check() _ -> machine_check() } }
    state sum_check() { transition self.sum_count <= (2147483647 - self.expected) / 20 { true -> sums() _ -> bad() } }
    state sums() { self.expected = self.expected + self.sum_count * 20; transition self.case_count <= (2147483647 - self.expected) / 20 { true -> cases() _ -> bad() } }
    state cases() { self.expected = self.expected + self.case_count * 20; transition self.case_payload_count <= (2147483647 - self.expected) / 16 { true -> payloads() _ -> bad() } }
    state payloads() { self.expected = self.expected + self.case_payload_count * 16; transition 0 { _ -> machine_check() } }
    state machine_check() { transition self.machine_count <= (2147483647 - self.expected) / 36 { true -> machines() _ -> bad() } }
    state machines() { self.expected = self.expected + self.machine_count * 36; transition self.mparam_count <= (2147483647 - self.expected) / 20 { true -> mparams() _ -> bad() } }
    state mparams() { self.expected = self.expected + self.mparam_count * 20; transition self.block_count <= (2147483647 - self.expected) / 32 { true -> blocks() _ -> bad() } }
    state blocks() { self.expected = self.expected + self.block_count * 32; transition self.bparam_count <= (2147483647 - self.expected) / 20 { true -> bparams() _ -> bad() } }
    state bparams() { self.expected = self.expected + self.bparam_count * 20; transition self.const_count <= (2147483647 - self.expected) / 24 { true -> constants() _ -> bad() } }
    state constants() { self.expected = self.expected + self.const_count * 24; transition self.const_child_count <= (2147483647 - self.expected) / 4 { true -> constant_children() _ -> bad() } }
    state constant_children() { self.expected = self.expected + self.const_child_count * 4; transition self.op_count <= (2147483647 - self.expected) / 40 { true -> ops() _ -> bad() } }
    state ops() { self.expected = self.expected + self.op_count * 40; transition self.operand_count <= (2147483647 - self.expected) / 4 { true -> operands() _ -> bad() } }
    state operands() { self.expected = self.expected + self.operand_count * 4; transition self.term_count <= (2147483647 - self.expected) / 44 { true -> terms() _ -> bad() } }
    state terms() { transition self.schema_major >= 5 { true -> terms5() _ -> terms4() } }
    state terms4() { self.expected = self.expected + self.term_count * 44; transition self.expected == self.total_len { true -> done() _ -> bad() } }
    state terms5() { self.expected = self.expected + self.term_count * 52; transition self.case_arm_count <= (2147483647 - self.expected) / 24 { true -> arms() _ -> bad() } }
    state arms() { self.expected = self.expected + self.case_arm_count * 24; transition self.case_arm_arg_count <= (2147483647 - self.expected) / 12 { true -> arm_args() _ -> bad() } }
    state arm_args() { self.expected = self.expected + self.case_arm_arg_count * 12; transition self.expected == self.total_len { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_types(&mut self) {
    self.i = 0; self.bool_type = 0 - 1; self.slice_type = 0 - 1; self.slice_selected = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.type_count { true -> row() _ -> done() } }
    state row() { self.word = self.read_u32(); transition self.status == 0 { true -> id() _ -> done() } }
    state id() { transition self.word == self.i { true -> kind() _ -> bad() } }
    state kind() { self.metadata_arena[0 + self.i] = self.read_u8(); self.metadata_arena[8192 + self.i] = self.read_u8(); self.expect_zero_u16(); transition self.schema_major == 20 { true -> maybe_u64_words() _ -> ordinary_payloads() } }
    state maybe_u64_words() { transition self.metadata_arena[0 + self.i] == 8 { true -> u64_words() _ -> ordinary_payloads() } }
    state u64_words() { self.metadata_arena[16384 + self.i] = self.read_scalar_u32(); self.metadata_arena[24576 + self.i] = self.read_scalar_u32(); self.metadata_arena[32768 + self.i] = self.read_scalar_u32(); self.metadata_arena[40960 + self.i] = self.read_scalar_u32(); transition self.status == 0 { true -> flag() _ -> done() } }
    state ordinary_payloads() { self.metadata_arena[16384 + self.i] = self.read_u32(); self.metadata_arena[24576 + self.i] = self.read_u32(); transition self.wide_semantic_words == 1 { true -> scalar_position() _ -> structural_words() } }
    state scalar_position() { transition self.metadata_arena[0 + self.i] <= 3 { true -> scalar_words() _ -> structural_words() } }
    state scalar_words() { self.metadata_arena[32768 + self.i] = self.read_scalar_u32(); self.metadata_arena[40960 + self.i] = self.read_scalar_u32(); transition self.status == 0 { true -> flag() _ -> done() } }
    state structural_words() { self.metadata_arena[32768 + self.i] = self.read_u32(); self.metadata_arena[40960 + self.i] = self.read_u32(); transition self.status == 0 { true -> flag() _ -> done() } }
