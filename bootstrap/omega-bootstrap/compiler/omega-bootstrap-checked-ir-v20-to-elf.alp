machine Main::case_payload_size(&mut self, case: i32, destination_base: i32) -> i32 {
    self.emission_stack[self.emission_depth] = self.emitting; self.emission_cursor_stack[self.emission_depth] = self.code_cursor; self.emission_depth = self.emission_depth + 1; self.emitting = 0;
    self.emit_case_payload(case, destination_base);
    self.emission_depth = self.emission_depth - 1; self.size = self.code_cursor - self.emission_cursor_stack[self.emission_depth]; self.code_cursor = self.emission_cursor_stack[self.emission_depth]; self.emitting = self.emission_stack[self.emission_depth];
    return self.size;
}

machine Main::emit_sum_copy(&mut self, type: i32, destination_base: i32) {
    self.sum_owner_stack[self.sum_emission_depth] = self.owner_type; self.sum_cursor_stack[self.sum_emission_depth] = self.sum_cursor; self.sum_end_stack[self.sum_emission_depth] = self.sum_end; self.sum_emission_depth = self.sum_emission_depth + 1;
