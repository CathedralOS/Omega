    state wide() { self.code_byte(65); self.code_byte(139); self.code_byte(131); self.code_u32(source_offset); self.code_byte(65); self.code_byte(137); self.code_byte(130); self.code_u32(destination_offset); transition 0 { _ -> done() } }
    state qword() { self.code_byte(73); self.code_byte(139); self.code_byte(131); self.code_u32(source_offset); self.code_byte(73); self.code_byte(137); self.code_byte(130); self.code_u32(destination_offset); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_copy_leaves(&mut self, type: i32, destination_base: i32) {
