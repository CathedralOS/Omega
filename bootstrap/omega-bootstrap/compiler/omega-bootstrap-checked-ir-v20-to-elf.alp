    transition 0 { _ -> cases() }
    state cases() { transition self.sum_cursor < self.sum_end { true -> compare() _ -> commit_tag() } }
    state compare() { self.size = self.case_payload_size(self.sum_cursor, destination_base); self.code_byte(129); self.code_byte(249); self.code_u32(self.case_arena[4096 + self.sum_cursor]); self.target = self.code_cursor + 6 + self.size + 5; self.code_byte(15); self.code_byte(133); self.code_rel32(self.target); self.emit_case_payload(self.sum_cursor, destination_base); self.code_byte(185); self.code_u32(self.sum_arena[256 + self.owner_type]); self.sum_cursor = self.sum_cursor + 1; transition 0 { _ -> cases() } }
    state commit_tag() { self.code_byte(65); self.code_byte(137); self.code_byte(146); self.code_u32(destination_base); transition 0 { _ -> restore() } }
    state restore() { self.sum_emission_depth = self.sum_emission_depth - 1; self.owner_type = self.sum_owner_stack[self.sum_emission_depth]; self.sum_cursor = self.sum_cursor_stack[self.sum_emission_depth]; self.sum_end = self.sum_end_stack[self.sum_emission_depth]; }
