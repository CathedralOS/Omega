machine Main::emit_case_payload(&mut self, case: i32, destination_base: i32) {
    self.pass = 0;
    transition 0 { _ -> fields() }
    state fields() { transition self.pass < self.case_arena[12288 + case] { true -> field() _ -> done() } }
    state field() { self.k = self.case_arena[8192 + case] + self.pass; self.type_id = self.payload_arena[8192 + self.k]; self.offset = self.sum_arena[640 + self.case_arena[0 + case]] + self.payload_arena[12288 + self.k]; transition self.metadata_arena[0 + self.type_id] <= 3 { true -> scalar() _ -> scalar_u64() } }
    state scalar_u64() { transition self.metadata_arena[0 + self.type_id] == 8 { true -> scalar() _ -> structural_kind() } }
    state scalar() { self.copy_leaf_to(self.type_id, self.offset, destination_base + self.offset); transition 0 { _ -> next() } }
    state structural_kind() { transition self.metadata_arena[0 + self.type_id] == 6 { true -> sum() _ -> structural_adjust() } }
