    state setup() { self.frame_cursor = 0; self.align_frame(8); transition self.status == 0 { true -> receiver() _ -> done() } }
    state receiver() { self.frame_cursor = self.frame_cursor + 8; self.i = 0; transition 0 { _ -> values() } }
    state values() { transition self.i < self.value_count { true -> value_owner() _ -> places_setup() } }
