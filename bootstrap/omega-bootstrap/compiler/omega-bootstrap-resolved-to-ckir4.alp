    state name_span() { self.source_span_valid(self.i32_backing2[436672 + self.i32_backing2[438208 + self.data_count + self.x]], self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> name_nonempty() _ -> bad() } }
