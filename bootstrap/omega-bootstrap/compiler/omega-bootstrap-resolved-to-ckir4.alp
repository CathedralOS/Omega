    state pub_sum_nominal_check() { transition self.j == 1 { true -> pub_sum_nominal() _ -> pub_sum_start_check() } }
    state pub_sum_nominal() { self.c = self.i32_backing1[205312 + self.data_count + self.i]; self.j = 2; transition 0 { _ -> pub_sum_word0() } }
    state pub_sum_start_check() { transition self.j == 2 { true -> pub_sum_start() _ -> pub_sum_count() } }
    state pub_sum_start() { self.c = self.i32_backing0[456 + self.data_count + self.i]; self.j = 3; transition 0 { _ -> pub_sum_word0() } }
    state pub_sum_count() { self.c = self.i32_backing0[584 + self.data_count + self.i]; self.j = 4; transition 0 { _ -> pub_sum_word0() } }
    state pub_sum_word0() { write_byte(self.c & 255); transition 0 { _ -> pub_sum_word1() } }
    state pub_sum_word1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_sum_word2() } }
    state pub_sum_word2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_sum_word3() } }
