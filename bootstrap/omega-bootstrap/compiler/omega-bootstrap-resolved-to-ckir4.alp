    state field_fact_mode() { transition self.i32_backing0[166472 + self.current_state] == 1 { true -> field_fact_load() _ -> lex() } }
    state field_fact_load() {
        self.ck3[28] = 1;
        self.ck3[29] = self.i32_backing0[182856 + self.current_state];
        self.ck3[30] = self.i32_backing0[199240 + self.current_state];
        self.ck3[31] = self.i32_backing0[215624 + self.current_state];
        transition 0 { _ -> lex() }
    }
    state lex() { self.next_token(); transition 0 { _ -> ready() } }
    state ready() {
    transition self.status == 0 { true -> loop() _ -> done() }
    }
    state loop() { transition self.tok == 0 { true -> finish() _ -> statement_limit() } }
    state statement_limit() { transition self.statement_count < 32 { true -> classify() _ -> exhausted() } }
    state classify() {
        self.token_word(27, 10);
        transition self.match_ok == 1 { true -> transition_statement() _ -> expression() }
    }
    state transition_statement() {
        self.statement_count = self.statement_count + 1; self.parse_transition();
        transition self.status == 0 { true -> transition_end() _ -> transition_fail() }
    }
    state transition_fail() { transition 0 { _ -> done() } }
    state transition_end() { transition self.tok == 0 { true -> transition_done() _ -> transition_tail() } }
    state transition_tail() { self.reject(); transition 0 { _ -> done() } }
    state transition_done() { self.body_terminated = 1; transition 0 { _ -> finish() } }
    state expression() {
        self.parse_expression();
        transition self.status == 0 { true -> assignment_check() _ -> done() }
    }
    state assignment_check() { transition self.tok == 61 { true -> assignment() _ -> unit_call_check() } }
    state unit_call_check() { transition self.expr_type == 0 - 4 { true -> unit_call_end() _ -> value_result() } }
    state unit_call_end() { self.expect_token(59); self.statement_count = self.statement_count + 1; transition self.status == 0 { true -> loop() _ -> done() } }
    state assignment() {
        self.assignment_type_id = self.expr_type; self.target_lvalue = self.expr_lvalue;
        self.target_mutable = self.expr_mutable;
        self.target_subject_kind = self.expr_subject_kind;
        self.target_subject_id = self.expr_subject_id;
        self.assignment_place_id = self.expr_place_id;
        transition self.target_lvalue == 1 { true -> assignment_mutable() _ -> bad() }
    }
    state assignment_mutable() { transition self.target_mutable == 1 { true -> assignment_rhs() _ -> bad() } }
    state assignment_rhs() {
        self.ck3[17] = 0 - 1; self.next_token();
        transition self.i32_backing0[363080 + self.assignment_type_id] == 5 { true -> assignment_array_literal_check() _ -> assignment_nominal_literal_check() }
    }
    state assignment_array_literal_check() { transition self.tok == 91 { true -> assignment_constant() _ -> assignment_expression() } }
    state assignment_nominal_literal_check() { transition self.i32_backing0[363080 + self.assignment_type_id] == 4 { true -> assignment_nominal_name() _ -> assignment_sum_literal_check() } }
    state assignment_sum_literal_check() { transition self.i32_backing0[363080 + self.assignment_type_id] == 6 { true -> assignment_sum_name() _ -> assignment_expression() } }
    state assignment_sum_name() { self.runtime_case_name(self.assignment_type_id); transition self.match_ok == 1 { true -> assignment_sum() _ -> assignment_expression() } }
    state assignment_sum() {
        self.ck3[32] = 0;
        self.parse_runtime_case(self.assignment_type_id, 2);
        transition self.status == 0 { true -> assignment_type() _ -> done() }
    }
    state assignment_nominal_name() { transition self.tok == 256 { true -> assignment_nominal_length() _ -> assignment_expression() } }
    state assignment_nominal_length() {
        transition self.tok_len == self.i32_backing0[200 + self.i32_backing0[461384 + self.assignment_type_id]] { true -> assignment_nominal_span() _ -> assignment_expression() }
    }
    state assignment_nominal_span() {
        self.spans_equal(self.tok_start, self.i32_backing0[72 + self.i32_backing0[461384 + self.assignment_type_id]], self.tok_len);
        transition self.match_ok == 1 { true -> assignment_record() _ -> assignment_expression() }
