    state declaration_kind() { transition self.i32_backing2[436928 + self.i32_backing2[438208 + self.data_count + self.i]] == 3 { true -> declaration_id() _ -> bad() } }
    state declaration_id() { transition self.i32_backing2[437952 + self.i32_backing2[438208 + self.data_count + self.i]] == self.i { true -> nominal() _ -> bad() } }
    state nominal() { self.read_witness_u32(self.table_pos + 8); self.i32_backing1[205312 + self.data_count + self.i] = self.decoded; transition self.decoded == self.w_record_count + self.i { true -> nominal_kind() _ -> bad() } }
    state nominal_kind() { transition self.i32_backing0[363080 + self.i32_backing1[205312 + self.data_count + self.i]] == 6 { true -> nominal_payload() _ -> bad() } }
    state nominal_payload() { transition self.i32_backing0[461384 + self.i32_backing1[205312 + self.data_count + self.i]] == self.i { true -> span() _ -> bad() } }
