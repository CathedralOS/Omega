    state pub_record_flags() { write_byte(self.i32_backing0[328 + self.i]); write_byte(0); write_byte(0); write_byte(0); self.i = self.i + 1; self.saved_tok = 0; transition 0 { _ -> pub_records() } }

    state pub_fields_begin() { self.i = 0; self.saved_tok = 0; transition 0 { _ -> pub_fields() } }
    state pub_fields() { transition self.i < self.field_count { true -> pub_field_select() _ -> pub_after_fields() } }
    state pub_field_select() { transition self.saved_tok == 0 { true -> pub_field_id() _ -> pub_field_owner_check() } }
    state pub_field_id() { self.c = self.i; self.saved_tok = 1; transition 0 { _ -> pub_field_word0() } }
    state pub_field_owner_check() { transition self.saved_tok == 1 { true -> pub_field_owner() _ -> pub_field_ordinal_check() } }
    state pub_field_owner() { self.c = self.i32_backing0[712 + self.i]; self.saved_tok = 2; transition 0 { _ -> pub_field_word0() } }
    state pub_field_ordinal_check() { transition self.saved_tok == 2 { true -> pub_field_ordinal() _ -> pub_field_type() } }
    state pub_field_ordinal() { self.c = self.i - self.i32_backing0[456 + self.i32_backing0[712 + self.i]]; self.saved_tok = 3; transition 0 { _ -> pub_field_word0() } }
    state pub_field_type() { self.c = self.i32_backing1[172544 + self.i32_backing0[25288 + self.i]]; self.saved_tok = 4; transition 0 { _ -> pub_field_word0() } }
    state pub_field_word0() { write_byte(self.c & 255); transition 0 { _ -> pub_field_word1() } }
    state pub_field_word1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_field_word2() } }
    state pub_field_word2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_field_word3() } }
    state pub_field_word3() { write_byte((self.c >> 24) & 255); transition self.saved_tok == 4 { true -> pub_field_next() _ -> pub_field_select() } }
    state pub_field_next() { self.i = self.i + 1; self.saved_tok = 0; transition 0 { _ -> pub_fields() } }

    state pub_after_fields() { transition self.ck3[39] >= 5 { true -> pub_sums_begin() _ -> pub_machines_begin() } }
    state pub_sums_begin() { self.i = 0; self.j = 0; transition 0 { _ -> pub_sums() } }
