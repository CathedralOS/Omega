        self.i32_backing2[385040 + self.synthetic_block] = 2;
        self.i32_backing2[393232 + self.synthetic_block * 7] = self.saved_value_id;
        self.i32_backing2[393232 + self.synthetic_block * 7 + 1] = self.expr_value_id;
        self.i32_backing2[387088 + self.synthetic_block] = 0 - 1;
        self.i32_backing2[391184 + self.synthetic_block] = 0;
        transition 0 { _ -> done() }
