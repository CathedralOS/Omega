machine Main::find_param_span(&mut self, start: i32, count: i32) {
    self.expr_subject_id = 0 - 1;
    transition self.current_state >= 0 { true -> state_begin() _ -> entry_begin() }
    state state_begin() {
        self.j = self.i32_backing0[84552 + self.current_state];
        self.k = self.j + self.i32_backing0[100936 + self.current_state];
        transition 0 { _ -> state_loop() }
    }
    state state_loop() { transition self.j < self.k { true -> state_length() _ -> entry_begin() } }
    state state_length() { transition count == self.i32_backing0[297544 + self.j] { true -> state_compare() _ -> state_next() } }
    state state_compare() {
        self.spans_equal(start, self.i32_backing0[264776 + self.j], count);
        transition self.match_ok == 1 { true -> found() _ -> state_next() }
    }
    state state_next() { self.j = self.j + 1; transition 0 { _ -> state_loop() } }
    state entry_begin() {
        self.j = self.i32_backing0[34120 + self.current_machine];
        self.k = self.j + self.i32_backing0[34248 + self.current_machine];
        transition 0 { _ -> entry_loop() }
    }
    state entry_loop() { transition self.j < self.k { true -> entry_length() _ -> done() } }
    state entry_length() { transition count == self.i32_backing0[297544 + self.j] { true -> entry_compare() _ -> entry_next() } }
    state entry_compare() {
        self.spans_equal(start, self.i32_backing0[264776 + self.j], count);
        transition self.match_ok == 1 { true -> found() _ -> entry_next() }
    }
    state entry_next() { self.j = self.j + 1; transition 0 { _ -> entry_loop() } }
    state found() { self.expr_subject_id = self.j; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::refine_expression_fact(&mut self) {
    transition self.ck3[18] > 0 { true -> interval_arm() _ -> inherited() }
    state interval_arm() { transition self.ck3[21] == 1 { true -> interval_kind() _ -> inherited() } }
    state interval_kind() { transition self.expr_subject_kind == self.ck3[23] { true -> interval_id() _ -> inherited() } }
    state interval_id() { transition self.expr_subject_id == self.ck3[24] { true -> interval_refine() _ -> inherited() } }
    state interval_refine() { transition self.expr_hi > self.ck3[25] { true -> interval_set() _ -> done() } }
    state interval_set() { self.expr_hi = self.ck3[25]; transition 0 { _ -> done() } }
    state inherited() { transition self.ck3[28] == 1 { true -> subject_kind() _ -> done() } }
    state subject_kind() { transition self.expr_subject_kind == self.ck3[29] { true -> subject_id() _ -> done() } }
    state subject_id() { transition self.expr_subject_id == self.ck3[30] { true -> refine() _ -> done() } }
    state refine() { transition self.expr_hi > self.ck3[31] { true -> set() _ -> done() } }
    state set() { self.expr_hi = self.ck3[31]; }
    state done() { }
}

machine Main::push_expression(&mut self) {
    transition self.expr_stack_used < 8 { true -> save() _ -> exhausted() }
    state save() {
        self.i32_backing0[0 + self.expr_stack_used] = self.expr_type;
        self.i32_backing0[8 + self.expr_stack_used] = self.expr_lo;
        self.i32_backing0[16 + self.expr_stack_used] = self.expr_hi;
        self.i32_backing0[24 + self.expr_stack_used] = self.expr_lvalue;
        self.i32_backing0[32 + self.expr_stack_used] = self.expr_mutable;
        self.i32_backing0[40 + self.expr_stack_used] = self.expr_subject_kind;
        self.i32_backing0[48 + self.expr_stack_used] = self.expr_subject_id;
        self.i32_backing0[56 + self.expr_stack_used] = self.expr_tree_depth;
        self.i32_backing0[64 + self.expr_stack_used] = self.expr_path_depth;
        self.i32_backing2[376832 + self.expr_stack_used] = self.expr_value_id;
        self.i32_backing2[376840 + self.expr_stack_used] = self.expr_place_id;
        self.i32_backing2[453248 + self.expr_stack_used] = self.expr_receiver_shape;
        self.i32_backing0[496288 + self.expr_stack_used] = self.ck3[45];
        self.expr_stack_used = self.expr_stack_used + 1;
        transition 0 { _ -> done() }
    }
    state exhausted() { self.status = 252; }
    state done() { }
}

machine Main::pop_left_expression(&mut self) {
    transition self.expr_stack_used > 0 { true -> load() _ -> bad() }
    state load() {
        self.expr_stack_used = self.expr_stack_used - 1;
        self.left_type = self.i32_backing0[0 + self.expr_stack_used];
        self.left_lo = self.i32_backing0[8 + self.expr_stack_used];
        self.left_hi = self.i32_backing0[16 + self.expr_stack_used];
        self.left_lvalue = self.i32_backing0[24 + self.expr_stack_used];
        self.left_mutable = self.i32_backing0[32 + self.expr_stack_used];
        self.left_subject_kind = self.i32_backing0[40 + self.expr_stack_used];
        self.left_subject_id = self.i32_backing0[48 + self.expr_stack_used];
        self.depth = self.i32_backing0[56 + self.expr_stack_used];
        self.path_depth = self.i32_backing0[64 + self.expr_stack_used];
        self.left_value_id = self.i32_backing2[376832 + self.expr_stack_used];
        self.left_place_id = self.i32_backing2[376840 + self.expr_stack_used];
        self.left_receiver_shape = self.i32_backing2[453248 + self.expr_stack_used];
        self.ck3[46] = self.i32_backing0[496288 + self.expr_stack_used];
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::types_same(&mut self, left: i32, right: i32) {
    self.match_ok = 0;
    transition left == right { true -> yes() _ -> special() }
    state special() { transition left < 0 { true -> done() _ -> right_valid() } }
    state right_valid() { transition right < 0 { true -> done() _ -> kind() } }
    state kind() { transition self.i32_backing0[363080 + left] == self.i32_backing0[363080 + right] { true -> kind_value() _ -> done() } }
    state kind_value() { transition self.i32_backing0[363080 + left] == 4 { true -> nominal() _ -> array() } }
    state nominal() { transition self.i32_backing0[461384 + left] == self.i32_backing0[461384 + right] { true -> yes() _ -> done() } }
    state array() { transition self.i32_backing0[363080 + left] == 5 { true -> array_length() _ -> yes() } }
    state array_length() { transition self.i32_backing1[32768 + left] == self.i32_backing1[32768 + right] { true -> array_element() _ -> done() } }
    state array_element() { self.types_same(self.i32_backing1[0 + left], self.i32_backing1[0 + right]); transition 0 { _ -> done() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::expression_assignable(&mut self, expected: i32, actual: i32) {
    self.match_ok = 0;
    transition actual == 0 - 2 { true -> integer_literal() _ -> bool_literal() }
    state integer_literal() { transition self.i32_backing0[363080 + expected] == 1 { true -> numeric_range() _ -> integer_u32() } }
    state integer_u32() { transition self.i32_backing0[363080 + expected] == 2 { true -> numeric_range() _ -> done() } }
    state bool_literal() { transition actual == 0 - 3 { true -> bool_expected() _ -> typed() } }
    state bool_expected() { transition self.i32_backing0[363080 + expected] == 3 { true -> yes() _ -> done() } }
    state typed() {
        self.types_same(expected, actual);
        transition self.match_ok == 1 { true -> typed_range() _ -> done() }
    }
    state typed_range() { transition self.i32_backing0[363080 + expected] == 1 { true -> numeric_range() _ -> typed_u32() } }
    state typed_u32() { transition self.i32_backing0[363080 + expected] == 2 { true -> numeric_range() _ -> yes() } }
    state numeric_range() { transition expected==self.ck3[50] { true -> full_u32() _ -> numeric_low() } }
    state full_u32() { transition self.ck3[39]==13 { true -> yes() _ -> numeric_low() } }
    state numeric_low() { transition self.expr_lo >= self.i32_backing1[98304 + expected] { true -> numeric_high() _ -> done() } }
    state numeric_high() { transition self.expr_hi <= self.i32_backing1[131072 + expected] { true -> yes() _ -> done() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

// OMGRSW4 carries no literal table. Reparse the exact bounded token into the
// inherited canonical CKIR constant DAG, then designate its kind-7 root only
// through StaticByteView.
machine Main::parse_static_byte_view(&mut self) {
    self.expr_type = self.ck3[60]; self.expr_lo = 0; self.expr_hi = 0;
    self.expr_lvalue = 0; self.expr_mutable = 0;
    self.expr_subject_kind = 0; self.expr_subject_id = 0 - 1;
    self.expr_value_id = 0 - 1; self.expr_place_id = 0 - 1;
    self.expr_receiver_shape = 0; self.expr_tree_depth = 1; self.expr_path_depth = 0;
    self.ck3[45] = 1;
    transition self.ck3[39] == 12 { true -> length() _ -> bad() }
    state length() { self.saved_tok_len = self.tok_len - 2; transition self.saved_tok_len <= 32 { true -> emit_check() _ -> exhausted() } }
    state emit_check() { transition self.bundle_mode == 1 { true -> children_begin() _ -> advance() } }
    state children_begin() { self.i = 0; transition 0 { _ -> children() } }
    state children() { transition self.i < self.saved_tok_len { true -> child() _ -> root() } }
    state child() {
        self.ck3[10] = self.i32_backing1[221824 + self.ck3[60]];
        self.ck3[12] = 0; self.ck3[8] = 0; self.ck3[5] = 0;
        self.saved_int_value = self.source[self.tok_start + 1 + self.i];
        self.intern_constant();
        transition self.status == 0 { true -> child_save() _ -> done() }
    }
    state child_save() { self.const_parse_children[self.i] = self.ck3[11]; self.i = self.i + 1; transition 0 { _ -> children() } }
    state root() {
        self.ck3[10] = self.ck3[60]; self.ck3[8] = self.saved_tok_len; self.ck3[5] = 0;
        self.saved_int_value = 0;
        transition self.saved_tok_len == 0 { true -> root_empty() _ -> root_nonempty() }
    }
    state root_empty() { self.ck3[12] = 0; transition 0 { _ -> root_intern() } }
    state root_nonempty() { self.ck3[12] = 1; transition 0 { _ -> root_intern() } }
    state root_intern() { self.intern_constant(); transition self.status == 0 { true -> operation() _ -> done() } }
    state operation() {
        self.record_operand_words = 0; self.record_operand0 = 0; self.record_operand1 = 0;
        self.record_immediate0 = self.ck3[11]; self.record_operation(22, 1, self.ck3[60]);
        transition self.status == 0 { true -> count() _ -> done() }
    }
    state count() { self.ck3[58] = self.ck3[58] + 1; transition 0 { _ -> advance() } }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_primary(&mut self) {
    self.expr_type = 0 - 1; self.expr_lo = 0; self.expr_hi = 0;
    self.expr_lvalue = 0; self.expr_mutable = 0;
    self.expr_subject_kind = 0; self.expr_subject_id = 0 - 1;
    self.expr_value_id = 0 - 1; self.expr_place_id = 0 - 1;
    self.expr_receiver_shape = 0;
    self.ck3[45] = 1;
    self.expr_tree_depth = 1; self.expr_path_depth = 0;
    transition self.tok == 257 { true -> integer() _ -> static_view_check() }
    state static_view_check() { transition self.tok == 258 { true -> static_view() _ -> identifier() } }
    state static_view() { self.parse_static_byte_view(); transition 0 { _ -> done() } }
    state integer() {
        self.expr_type = 0 - 2; self.expr_lo = self.int_value; self.expr_hi = self.int_value;
        self.next_token(); transition 0 { _ -> done() }
    }
    state identifier() { transition self.tok == 256 { true -> true_check() _ -> paren() } }
    state true_check() { self.token_word(37, 4); transition self.match_ok == 1 { true -> true_value() _ -> false_check() } }
    state true_value() { self.expr_type = 0 - 3; self.expr_lo = 1; self.expr_hi = 1; self.next_token(); transition 0 { _ -> done() } }
    state false_check() { self.token_word(41, 5); transition self.match_ok == 1 { true -> false_value() _ -> self_check() } }
    state false_value() { self.expr_type = 0 - 3; self.expr_lo = 0; self.expr_hi = 0; self.next_token(); transition 0 { _ -> done() } }
    state self_check() { self.token_word(18, 4); transition self.match_ok == 1 { true -> self_value() _ -> parameter() } }
    state self_value() {
        self.expr_type = self.i32_backing0[34632 + self.current_machine];
        self.expr_lvalue = 1; self.expr_mutable = self.current_receiver_mut;
        self.expr_subject_kind = 3; self.expr_subject_id = self.i32_backing0[33736 + self.current_machine];
        self.expr_receiver_shape = 1;
        self.next_token(); transition self.bundle_mode == 1 { true -> self_place() _ -> done() }
