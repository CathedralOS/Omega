    state selected_type() { transition self.left_type == self.ck3[50] { true -> selected_leaf() _ -> bounds() } }
    state selected_leaf() { transition self.left_lvalue == 1 { true -> selected_subject_field() _ -> bounds() } }
    state selected_subject_field() { transition self.left_subject_kind == 1 { true -> selected_pure() _ -> selected_subject_parameter() } }
    state selected_subject_parameter() { transition self.left_subject_kind == 2 { true -> selected_pure() _ -> bounds() } }
    state selected_pure() { transition self.ck3[46] == 1 { true -> selected_literal() _ -> bounds() } }
    state selected_literal() { transition self.expr_type == 0 - 2 { true -> selected_literal_leaf() _ -> bounds() } }
    state selected_literal_leaf() { transition self.expr_lvalue == 0 { true -> selected_mark() _ -> bounds() } }
    state selected_mark() { self.comparison_opcode = 1; transition 0 { _ -> bounds() } }
