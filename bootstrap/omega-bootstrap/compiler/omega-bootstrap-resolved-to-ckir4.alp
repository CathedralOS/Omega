machine Main::combine_add(&mut self) {
    self.comparison_opcode = 0;
    transition self.left_type == 0 - 2 { true -> left_literal() _ -> left_typed() }
    state left_literal() { transition self.expr_type == 0 - 2 { true -> choose_literal() _ -> right_numeric() } }
    state choose_literal() { self.target_type = 0 - 2; transition 0 { _ -> selected_version() } }
    state right_numeric() { transition self.expr_type >= 0 { true -> right_kind() _ -> bad() } }
    state right_kind() { transition self.i32_backing0[363080 + self.expr_type] == 1 { true -> choose_right() _ -> right_u32() } }
    state right_u32() { transition self.i32_backing0[363080 + self.expr_type] == 2 { true -> choose_right() _ -> bad() } }
    state choose_right() { self.target_type = self.expr_type; transition 0 { _ -> selected_version() } }
    state left_typed() { transition self.left_type >= 0 { true -> left_kind() _ -> bad() } }
    state left_kind() { transition self.i32_backing0[363080 + self.left_type] == 1 { true -> right_check() _ -> left_u32() } }
    state left_u32() { transition self.i32_backing0[363080 + self.left_type] == 2 { true -> right_check() _ -> bad() } }
    state right_check() { transition self.expr_type == 0 - 2 { true -> choose_left() _ -> typed_same() } }
    state typed_same() { self.types_same(self.left_type, self.expr_type); transition self.match_ok == 1 { true -> choose_left() _ -> bad() } }
    state choose_left() { self.target_type = self.left_type; transition 0 { _ -> selected_version() } }
