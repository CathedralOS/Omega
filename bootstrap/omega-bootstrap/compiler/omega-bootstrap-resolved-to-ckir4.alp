    // negative right endpoint from INT_MAX: lowermachine correctly traps that
    // arithmetic before the comparison can reject the malformed interval.
    state bounds() { transition self.left_lo >= 0 { true -> left_order() _ -> bad() } }
    state left_order() { transition self.left_lo <= self.left_hi { true -> right_low() _ -> bad() } }
    state right_low() { transition self.expr_lo >= 0 { true -> right_order() _ -> bad() } }
    state right_order() { transition self.expr_lo <= self.expr_hi { true -> sum_bound() _ -> bad() } }
    state sum_bound() { transition self.ck3[18] == 1 { true -> analysis_bound() _ -> selected_bound() } }
    state analysis_bound() { transition self.expr_hi <= 2147483647 - self.left_hi { true -> emit_check() _ -> analysis_wide() } }
    state analysis_wide() { self.comparison_opcode = 2; transition 0 { _ -> emit_check() } }
    state selected_bound() { transition self.comparison_opcode == 1 { true -> emit_check() _ -> sum_bound_final() } }
    state sum_bound_final() { transition self.expr_hi <= 2147483647 - self.left_hi { true -> emit_check() _ -> bad() } }
    state emit_check() { transition self.bundle_mode == 1 { true -> emit_type() _ -> sum() } }
    state emit_type() { transition self.target_type >= 0 { true -> emit_typed() _ -> emit_literal() } }
    state emit_typed() {
