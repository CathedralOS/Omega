    state pub_operation_head() { write_byte(self.i32_backing1[349184 + self.i]); write_byte(self.i32_backing1[381952 + self.i]); write_byte(0); write_byte(0); self.j = 4; transition 0 { _ -> pub_operation_select() } }
    state pub_operation_result_check() { transition self.j == 4 { true -> pub_operation_result() _ -> pub_operation_type_check() } }
    state pub_operation_result() { self.c = self.i32_backing1[414720 + self.i]; self.j = 5; transition 0 { _ -> pub_shared_word0() } }
    state pub_operation_type_check() { transition self.j == 5 { true -> pub_operation_type() _ -> pub_operation_start_check() } }
    state pub_operation_type() { self.c = self.i32_backing1[447488 + self.i]; self.j = 6; transition 0 { _ -> pub_shared_word0() } }
    state pub_operation_start_check() { transition self.j == 6 { true -> pub_operation_start() _ -> pub_operation_count_check() } }
    state pub_operation_start() { self.c = self.i32_backing1[480256 + self.i]; self.j = 7; transition 0 { _ -> pub_shared_word0() } }
    state pub_operation_count_check() { transition self.j == 7 { true -> pub_operation_count() _ -> pub_operation_imm0_check() } }
