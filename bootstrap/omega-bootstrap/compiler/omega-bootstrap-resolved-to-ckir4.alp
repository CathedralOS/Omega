}

machine Main::parse_constant(&mut self, expected: i32) {
    self.ck3[11] = 0 - 1;
    transition expected >= 0 { true -> kind() _ -> bad() }
    state kind() { transition self.i32_backing0[363080 + expected] < 4 { true -> scalar() _ -> nominal_check() } }
    state scalar() { self.parse_scalar_constant(expected); transition 0 { _ -> done() } }
    state nominal_check() { transition self.i32_backing0[363080 + expected] == 4 { true -> nominal() _ -> array_check() } }
    state nominal() { transition self.tok == 256 { true -> nominal_parse() _ -> bad() } }
    state nominal_parse() { self.parse_record_constant(expected); transition 0 { _ -> done() } }
    state array_check() { transition self.i32_backing0[363080 + expected] == 5 { true -> array() _ -> bad() } }
    state array() { transition self.tok == 91 { true -> array_parse() _ -> bad() } }
    state array_parse() { self.parse_array_constant(expected); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

// CKIR4 runtime record literals are deliberately contextual.  They are not a
// new general primary expression: only assignment and structural-call
// argument sites invoke this parser, and nested literals recur from a field
// whose exact expected type is already known.
machine Main::runtime_record_name(&mut self, expected: i32) {
    self.match_ok = 0;
    transition expected >= 0 { true -> kind() _ -> done() }
    state kind() { transition self.i32_backing0[363080 + expected] == 4 { true -> token() _ -> done() } }
    state token() { transition self.tok == 256 { true -> length() _ -> done() } }
    state length() {
        transition self.tok_len == self.i32_backing0[200 + self.i32_backing0[461384 + expected]] { true -> bytes() _ -> done() }
    }
    state bytes() {
        self.spans_equal(self.tok_start, self.i32_backing0[72 + self.i32_backing0[461384 + expected]], self.tok_len);
    }
    state done() { }
}

machine Main::runtime_case_name(&mut self, expected: i32) {
    self.match_ok = 0;
    transition expected >= 0 { true -> kind() _ -> done() }
    state kind() { transition self.i32_backing0[363080 + expected] == 6 { true -> token() _ -> done() } }
    state token() { transition self.tok == 256 { true -> length() _ -> done() } }
    state length() {
        transition self.tok_len == self.i32_backing0[200 + self.data_count + self.i32_backing0[461384 + expected]] { true -> bytes() _ -> done() }
    }
    state bytes() {
        self.spans_equal(self.tok_start, self.i32_backing0[72 + self.data_count + self.i32_backing0[461384 + expected]], self.tok_len);
    }
    state done() { }
}

// Runtime case construction is contextual like runtime-record construction:
// the destination/parameter/payload type supplies the exact sum. A first pass
// validates and records every named payload expression without publication; a
// declaration-order replay emits only active operands and opcode 14.
machine Main::parse_runtime_case(&mut self, expected: i32, context: i32) {
    transition self.ck3[32] < 8 { true -> name() _ -> exhausted() }
    state name() { self.runtime_case_name(expected); transition self.match_ok == 1 { true -> copy() _ -> bad() } }
    state copy() { self.type_is_copy(expected); transition self.match_ok == 1 { true -> reserve() _ -> bad() } }
    state reserve() {
        self.ck3[32] = self.ck3[32] + 1;
        self.i32_backing0[496264 + (self.ck3[32] - 1)] = self.bundle_mode;
        self.bundle_mode = 0; self.i = 0; transition 0 { _ -> clear_seen() }
    }
    state clear_seen() { transition self.i < 64 { true -> clear_one() _ -> separator0() } }
    state clear_one() {
        self.i32_backing0[495688 + (self.ck3[32] - 1) * 64 + self.i] = 0;
        self.i = self.i + 1; transition 0 { _ -> clear_seen() }
    }
    state separator0() { self.next_token(); self.expect_token(58); transition self.status == 0 { true -> separator1() _ -> done() } }
    state separator1() { self.expect_token(58); transition self.status == 0 { true -> case_name() _ -> done() } }
    state case_name() { transition self.tok == 256 { true -> case_find() _ -> bad() } }
    state case_find() {
        self.find_case_span(self.i32_backing0[461384 + expected], self.tok_start, self.tok_len);
        transition self.expr_subject_id >= 0 { true -> case_save() _ -> bad() }
    }
    state case_save() {
        self.i32_backing0[496304 + (self.ck3[32] - 1)] = self.expr_subject_id;
        self.i32_backing0[496312 + (self.ck3[32] - 1)] = self.i32_backing0[70216 + self.expr_subject_id];
        self.i32_backing0[496320 + (self.ck3[32] - 1)] = self.i32_backing0[86600 + self.expr_subject_id];
        self.i32_backing0[496288 + (self.ck3[32] - 1)] = 0;
        self.next_token();
        transition self.i32_backing0[496320 + (self.ck3[32] - 1)] == 0 { true -> payload_free() _ -> open() }
    }
    state payload_free() { transition self.tok == 123 { true -> bad() _ -> save_after() } }
    state open() { self.expect_token(123); transition self.status == 0 { true -> fields() _ -> done() } }
    state fields() { transition self.tok == 125 { true -> close() _ -> field_name() } }
    state field_name() { transition self.tok == 256 { true -> field_find() _ -> bad() } }
    state field_find() {
        self.find_case_payload_span(self.i32_backing0[496304 + (self.ck3[32] - 1)], self.tok_start, self.tok_len);
        transition self.expr_subject_id >= 0 { true -> field_save() _ -> bad() }
    }
    state field_save() {
        self.i32_backing0[496280 + (self.ck3[32] - 1)] = self.expr_subject_id;
        self.i32_backing0[496272 + (self.ck3[32] - 1)] = self.expr_subject_id - self.i32_backing0[496312 + (self.ck3[32] - 1)];
        transition self.i32_backing0[495688 + (self.ck3[32] - 1) * 64 + self.i32_backing0[496272 + (self.ck3[32] - 1)]] == 0 { true -> field_mark() _ -> bad() }
    }
    state field_mark() {
        self.i32_backing0[495688 + (self.ck3[32] - 1) * 64 + self.i32_backing0[496272 + (self.ck3[32] - 1)]] = 1;
        self.next_token(); self.expect_token(58);
        transition self.status == 0 { true -> field_span_start() _ -> done() }
    }
    state field_span_start() {
