machine Main::parse_runtime_scalar_field(&mut self, expected: i32) {
    // ck3[33]/[34] return whether this leaf is recursively constant and
    // whether it contained a fixed-array literal used only by assignment's
    // constant-classification pass.
    self.ck3[33] = 0; self.ck3[34] = 0;
    transition self.tok == 257 { true -> literal() _ -> identifier() }
    state literal() { self.ck3[33] = 1; self.parse_primary(); transition self.status == 0 { true -> assignable() _ -> done() } }
    state identifier() { transition self.tok == 256 { true -> true_check() _ -> bad() } }
    state true_check() { self.token_word(37, 4); transition self.match_ok == 1 { true -> boolean() _ -> false_check() } }
    state false_check() { self.token_word(41, 5); transition self.match_ok == 1 { true -> boolean() _ -> self_check() } }
    state boolean() { self.ck3[33] = 1; self.parse_primary(); transition self.status == 0 { true -> assignable() _ -> done() } }
    state self_check() { self.token_word(18, 4); transition self.match_ok == 1 { true -> self_path() _ -> parameter() } }
    state self_path() { self.parse_postfix(); transition self.status == 0 { true -> self_shape() _ -> done() } }
    state self_shape() { transition self.expr_subject_kind == 1 { true -> scalar_kind() _ -> bad() } }
    state parameter() { self.parse_primary(); transition self.status == 0 { true -> parameter_shape() _ -> done() } }
    state parameter_shape() { transition self.expr_subject_kind == 2 { true -> scalar_kind() _ -> bad() } }
    state scalar_kind() { transition self.expr_type >= 0 { true -> scalar_typed() _ -> bad() } }
    state scalar_typed() { transition self.i32_backing0[363080 + self.expr_type] < 4 { true -> assignable() _ -> bad() } }
    state assignable() {
        self.expression_assignable(expected, self.expr_type);
        transition self.match_ok == 1 { true -> encoded_check() _ -> bad() }
    }
    state encoded_check() { transition self.expr_type >= 0 { true -> encoded_low() _ -> emit_check() } }
    state encoded_low() {
        transition self.i32_backing1[98304 + self.expr_type] >= self.i32_backing1[98304 + expected] { true -> encoded_high() _ -> bad() }
    }
    state encoded_high() {
        transition self.i32_backing1[131072 + self.expr_type] <= self.i32_backing1[131072 + expected] { true -> emit_check() _ -> bad() }
    }
    state emit_check() { transition self.bundle_mode == 1 { true -> emit() _ -> done() } }
    state emit() { self.materialize_expression(self.i32_backing1[172544 + expected]); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_runtime_structural_field(&mut self, expected: i32, context: i32) {
    self.ck3[33] = 0; self.ck3[34] = 0;
    transition self.i32_backing0[363080 + expected] == 4 { true -> record_name() _ -> sum_check() }
