    state ordinal() { self.read_witness_u32(self.table_pos + 8); transition self.decoded == self.i - self.i32_backing0[34120 + self.x] { true -> type_id() _ -> bad() } }
    state type_id() { self.read_witness_u32(self.table_pos + 12); self.i32_backing0[330312 + self.i] = self.decoded; transition self.decoded < self.type_count { true -> name() _ -> bad() } }
    state name() { self.read_witness_u32(self.table_pos + 16); self.saved_pos = self.decoded; self.read_witness_u32(self.table_pos + 20); self.saved_tok_len = self.decoded; transition self.status == 0 { true -> span() _ -> done() } }
    state span() { self.source_span_valid(self.i32_backing2[438464 + self.x], self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> nonempty() _ -> bad() } }
    state nonempty() { transition self.saved_tok_len > 0 { true -> save() _ -> bad() } }
    state save() {
        self.i32_backing0[264776 + self.i] = self.i32_backing2[436576 + self.i32_backing2[438464 + self.x]] + self.saved_pos;
        self.i32_backing0[297544 + self.i] = self.saved_tok_len;
        self.i = self.i + 1; transition 0 { _ -> rows() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_blocks(&mut self) {
    self.i = 0; self.x = 0; self.y = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.w_block_count { true -> owner_seek() _ -> parameter_partition() } }
    state owner_seek() { transition self.i < self.i32_backing1[254592 + self.x] + self.i32_backing1[254720 + self.x] { true -> row() _ -> owner_next() } }
    state owner_next() { self.x = self.x + 1; transition self.x < self.machine_count { true -> owner_seek() _ -> bad() } }
