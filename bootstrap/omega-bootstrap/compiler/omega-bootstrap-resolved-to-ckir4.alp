machine Main::main(&mut self) {
    self.status = 0; self.ck3[45] = 0; self.init_words(); self.read_frame();
    transition self.status == 0 { true -> envelope() _ -> finish() }
    state envelope() { self.decode_envelope(); transition self.status == 0 { true -> witness_header() _ -> finish() } }
    state witness_header() { self.decode_witness_header(); transition self.status == 0 { true -> units() _ -> finish() } }
    state units() { self.load_units(); transition self.status == 0 { true -> declarations() _ -> finish() } }
    state declarations() { self.load_declarations(); transition self.status == 0 { true -> types() _ -> finish() } }
    state types() { self.load_types(); transition self.status == 0 { true -> records() _ -> finish() } }
    state records() { self.load_records(); transition self.status == 0 { true -> fields() _ -> finish() } }
    state fields() { self.load_fields(); transition self.status == 0 { true -> sums() _ -> finish() } }
    state sums() { self.load_sums(); transition self.status == 0 { true -> cases() _ -> finish() } }
    state cases() { self.load_cases(); transition self.status == 0 { true -> case_payloads() _ -> finish() } }
    state case_payloads() { self.load_case_payloads(); transition self.status == 0 { true -> machines() _ -> finish() } }
    state machines() { self.load_machines(); transition self.status == 0 { true -> machine_parameters() _ -> finish() } }
    state machine_parameters() { self.load_machine_parameters(); transition self.status == 0 { true -> blocks() _ -> finish() } }
    state blocks() { self.load_blocks(); transition self.status == 0 { true -> block_parameters() _ -> finish() } }
    state block_parameters() { self.load_block_parameters(); transition self.status == 0 { true -> imports() _ -> finish() } }
    state imports() { self.load_imports(); transition self.status == 0 { true -> bindings() _ -> finish() } }
    state bindings() { self.load_bindings(); transition self.status == 0 { true -> root() _ -> finish() } }
    state root() { self.validate_selected_root(); transition self.status == 0 { true -> layout() _ -> finish() } }
    state layout() { self.layout_all_data(); transition self.status == 0 { true -> copies() _ -> finish() } }
    state copies() { self.validate_copy_records(); transition self.status == 0 { true -> sum_copies() _ -> finish() } }
    state sum_copies() { self.validate_copy_sums(); transition self.status == 0 { true -> prepare() _ -> finish() } }
    state prepare() { self.prepare_ck_blocks(); transition self.status == 0 { true -> prepared() _ -> finish() } }
    state prepared() { self.validate_prepared_blocks(); transition self.status == 0 { true -> intervals() _ -> finish() } }
    state intervals() { self.compute_state_intervals(); transition self.status == 0 { true -> operations() _ -> finish() } }
    state operations() {
        self.bundle_mode = 1;
        self.op_count = 0; self.operand_count = 0; self.place_count = 0;
        self.value_count = self.param_count; self.field_receiver_count = 0;
        self.ck3[38] = 0; self.ck3[40] = 0; self.ck3[41] = 0;
        self.ck3[42] = 0; self.ck3[43] = 0; self.ck3[44] = 0;
        self.ck3[35] = 0; self.ck3[22] = 0; self.ck3[51] = 0;
        self.ck3[52] = 0; self.ck3[57] = 0; self.ck3[58] = 0; self.i = 0;
        transition 0 { _ -> operation_blocks() }
    }
    state operation_blocks() { transition self.i < self.block_count { true -> operation_block() _ -> bodies() } }
    state operation_block() {
        self.i32_backing1[279552 + self.i] = 0; self.i32_backing1[281600 + self.i] = 0;
        self.i32_backing2[376848 + self.i] = 0; self.i32_backing2[378896 + self.i] = 0 - 1;
        self.i32_backing2[380944 + self.i] = 0 - 1; self.i32_backing2[387088 + self.i] = 0 - 1;
        self.i32_backing2[385040 + self.i] = 0; self.i32_backing2[391184 + self.i] = 0;
        self.i32_backing0[176712 + 3 * self.i] = 0;
        self.i32_backing0[176713 + 3 * self.i] = 0;
        self.i32_backing0[176714 + 3 * self.i] = 0;
        self.i = self.i + 1; transition 0 { _ -> operation_blocks() }
    }
    state bodies() { self.check_all_bodies(); transition self.status == 0 { true -> synthetic_relation() _ -> finish() } }
    state synthetic_relation() { transition self.ck3[39] == 12 { true -> synthetic_emit() _ -> feature_relation() } }
    state synthetic_emit() { self.emit_synthetic_nonempty_block(); transition self.status == 0 { true -> static_view_required() _ -> finish() } }
    state static_view_required() { transition self.ck3[58] > 0 { true -> feature_relation() _ -> rejected() } }
    state feature_relation() { transition self.ck3[39] == 13 { true -> subtraction_scan_begin() _ -> trapping_add_relation() } }
    state subtraction_scan_begin() { self.i=0; transition 0 { _ -> subtraction_scan() } }
    state subtraction_scan() { transition self.i<self.op_count { true -> subtraction_row() _ -> rejected() } }
    state subtraction_row() { transition self.i32_backing1[349184+self.i]==26 { true -> constants() _ -> subtraction_next() } }
    state subtraction_next() { self.i=self.i+1; transition 0 { _ -> subtraction_scan() } }
    state trapping_add_relation() { transition self.ck3[39] == 11 { true -> trapping_add_required() _ -> integer_widen_relation() } }
    state trapping_add_required() { transition self.ck3[52] > 0 { true -> constants() _ -> rejected() } }
    state integer_widen_relation() { transition self.ck3[39] == 10 { true -> integer_widen_required() _ -> greater_relation() } }
    state integer_widen_required() { transition self.ck3[51] > 0 { true -> constants() _ -> rejected() } }
    state greater_relation() { transition self.ck3[39] == 9 { true -> greater_required() _ -> scalar_equal_relation() } }
    state greater_required() { transition self.ck3[22] > 0 { true -> constants() _ -> rejected() } }
    state scalar_equal_relation() { transition self.ck3[39] == 8 { true -> scalar_equal_required() _ -> logical_binary_relation() } }
    state scalar_equal_required() { transition self.ck3[35] > 0 { true -> constants() _ -> rejected() } }
    state logical_binary_relation() { transition self.ck3[39] == 7 { true -> logical_binary_required() _ -> logical_not_relation() } }
    state logical_binary_required() { transition self.ck3[42] > 0 { true -> constants() _ -> rejected() } }
    state logical_not_relation() { transition self.ck3[39] == 6 { true -> feature_required() _ -> constants() } }
    state feature_required() { transition self.ck3[38] > 0 { true -> constants() _ -> rejected() } }
    state rejected() { self.reject(); transition 0 { _ -> finish() } }
    state constants() { self.canonicalize_constants(); transition self.status == 0 { true -> publication() _ -> finish() } }
    state publication() { self.publish_ckir(); transition 0 { _ -> finish() } }
    state finish() { self.console.exit_process(self.status); }
}
