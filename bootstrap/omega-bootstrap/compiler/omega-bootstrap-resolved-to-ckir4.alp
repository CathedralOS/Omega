}

machine Main::check_all_bodies(&mut self) {
    self.scan_index = 0;
    transition 0 { _ -> machines() }
    state machines() { transition self.scan_index < self.machine_count { true -> entry() _ -> complete() } }
    state entry() {
        self.current_machine = self.scan_index; self.current_state = 0 - 1;
        self.current_receiver_mut = self.i32_backing0[34504 + self.current_machine];
        self.current_result_type = self.i32_backing0[34376 + self.current_machine];
        self.current_block = self.i32_backing1[254848 + self.current_machine];
        self.i32_backing0[176713 + 3 * self.current_block] = self.ck3[40];
        self.i32_backing1[279552 + self.current_block] = self.op_count;
        self.check_body(self.i32_backing0[34760 + self.current_machine], self.i32_backing0[35016 + self.current_machine]);
        transition self.status == 0 { true -> states_begin() _ -> entry_fail() }
    }
    state entry_fail() { transition 0 { _ -> done() } }
    state states_begin() {
        self.body_state_index = self.i32_backing0[35144 + self.current_machine];
        self.body_state_end = self.body_state_index + self.i32_backing0[35272 + self.current_machine];
        transition 0 { _ -> states() }
    }
    state states() { transition self.body_state_index < self.body_state_end { true -> body_row() _ -> next_owner() } }
    state body_row() {
        self.current_state = self.body_state_index;
        self.current_receiver_mut = self.i32_backing0[117320 + self.current_state];
        self.current_result_type = self.i32_backing0[34376 + self.current_machine];
        self.current_block = self.i32_backing1[254976 + self.current_state];
        self.i32_backing0[176713 + 3 * self.current_block] = self.ck3[40];
        self.i32_backing1[279552 + self.current_block] = self.op_count;
        self.check_body(self.i32_backing0[133704 + self.current_state], self.i32_backing0[150088 + self.current_state]);
        transition self.status == 0 { true -> next_body_row() _ -> body_fail() }
    }
    state body_fail() { transition 0 { _ -> done() } }
    state next_body_row() { self.body_state_index = self.body_state_index + 1; transition 0 { _ -> states() } }
    state next_owner() { self.scan_index = self.scan_index + 1; transition 0 { _ -> machines() } }
    state complete() { self.limit = self.n; self.x = 0; transition 0 { _ -> graph_choose_begin() } }
    state graph_choose_begin() { self.i = 0; self.y = 0 - 1; transition 0 { _ -> graph_choose() } }
    state graph_choose() { transition self.i < self.machine_count { true -> graph_choose_one() _ -> graph_choose_done() } }
    state graph_choose_one() { transition self.call_processed[self.i] == 0 { true -> graph_choose_indegree() _ -> graph_choose_next() } }
    state graph_choose_indegree() { transition self.call_indegree[self.i] == 0 { true -> graph_choose_save() _ -> graph_choose_next() } }
    state graph_choose_save() { self.y = self.i; transition 0 { _ -> graph_choose_done() } }
    state graph_choose_next() { self.i = self.i + 1; transition 0 { _ -> graph_choose() } }
    state graph_choose_done() { transition self.y >= 0 { true -> graph_consume() _ -> graph_all_processed() } }
    state graph_consume() { self.call_processed[self.y] = 1; self.x = self.x + 1; self.j = 0; transition 0 { _ -> graph_outgoing() } }
    state graph_outgoing() { transition self.j < self.machine_count { true -> graph_outgoing_one() _ -> graph_choose_begin() } }
    state graph_outgoing_one() { transition self.call_edges[self.y * 128 + self.j] == 1 { true -> graph_decrement() _ -> graph_outgoing_next() } }
    state graph_decrement() { self.call_indegree[self.j] = self.call_indegree[self.j] - 1; transition self.call_indegree[self.j] >= 0 { true -> graph_outgoing_next() _ -> bad() } }
    state graph_outgoing_next() { self.j = self.j + 1; transition 0 { _ -> graph_outgoing() } }
    state graph_all_processed() { transition self.x == self.machine_count { true -> graph_bindings_begin() _ -> bad() } }
    state graph_bindings_begin() { self.i = 0; transition 0 { _ -> graph_bindings() } }
    state graph_bindings() { transition self.i < self.w_binding_count { true -> graph_binding_role() _ -> graph_relation() } }
    state graph_binding_role() { self.table_pos = self.w_bindings + self.i * 28; transition self.witness[self.table_pos + 8] == 3 { true -> graph_binding_used() _ -> graph_binding_next() } }
    state graph_binding_used() { transition self.call_binding_consumed[self.i] == 1 { true -> graph_binding_next() _ -> bad() } }
    state graph_binding_next() { self.i = self.i + 1; transition 0 { _ -> graph_bindings() } }
    state graph_relation() { transition self.resolution_version == 1 { true -> graph_relation_v1() _ -> graph_relation_non1() } }
    state graph_relation_non1() { transition self.resolution_version == 2 { true -> graph_relation_v2() _ -> done() } }
    state graph_relation_v1() { transition self.field_receiver_count == 0 { true -> done() _ -> bad() } }
    state graph_relation_v2() { transition self.field_receiver_count > 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::analyze_interval_bodies(&mut self) {
    self.scan_index = 0;
    transition 0 { _ -> machines() }
    state machines() { transition self.scan_index < self.machine_count { true -> entry_needed() _ -> done() } }
    state entry_needed() { transition self.i32_backing0[35272 + self.scan_index] > 0 { true -> entry() _ -> next_owner() } }
    state entry() {
        self.current_machine = self.scan_index; self.current_state = 0 - 1;
        self.ck3[20] = 1;
        self.current_receiver_mut = self.i32_backing0[34504 + self.current_machine];
        self.current_result_type = self.i32_backing0[34376 + self.current_machine];
        self.current_block = self.i32_backing1[254848 + self.current_machine];
        self.check_body(self.i32_backing0[34760 + self.current_machine], self.i32_backing0[35016 + self.current_machine]);
        transition self.status == 0 { true -> states_begin() _ -> done() }
    }
    state states_begin() {
        self.body_state_index = self.i32_backing0[35144 + self.current_machine];
        self.body_state_end = self.body_state_index + self.i32_backing0[35272 + self.current_machine];
        transition 0 { _ -> states() }
    }
    state states() { transition self.body_state_index < self.body_state_end { true -> body_row() _ -> next_owner() } }
    state body_row() {
        self.current_state = self.body_state_index;
        self.ck3[20] = self.interval_reachable[self.current_state];
        self.current_receiver_mut = self.i32_backing0[117320 + self.current_state];
        self.current_result_type = self.i32_backing0[34376 + self.current_machine];
        self.current_block = self.i32_backing1[254976 + self.current_state];
        self.check_body(self.i32_backing0[133704 + self.current_state], self.i32_backing0[150088 + self.current_state]);
        transition self.status == 0 { true -> next_body_row() _ -> done() }
    }
    state next_body_row() { self.body_state_index = self.body_state_index + 1; transition 0 { _ -> states() } }
    state next_owner() { self.scan_index = self.scan_index + 1; transition 0 { _ -> machines() } }
    state done() { }
}

machine Main::compute_state_intervals(&mut self) {
    self.i = 0;
    transition 0 { _ -> clear_states() }
    state clear_states() { transition self.i < self.state_count { true -> clear_state() _ -> clear_params_begin() } }
    state clear_state() { self.interval_reachable[self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_states() } }
    state clear_params_begin() { self.i = self.machine_parameter_count; transition 0 { _ -> clear_params() } }
    state clear_params() { transition self.i < self.param_count { true -> clear_param() _ -> pass_begin() } }
    state clear_param() { self.interval_pending[self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_params() } }
    state pass_begin() {
        self.ck3[19] = 0; self.bundle_mode = 0; self.ck3[18] = 1;
        self.i = 0; transition 0 { _ -> pass_field_facts() }
    }
    // Field facts are recomputed per complete source-order pass. A mode=0
    // join is absorbing within that pass, but an assignment in a target body
    // must not erase its predecessor fact before the next replay.
    state pass_field_facts() { transition self.i < self.state_count { true -> pass_field_fact() _ -> pass_analyze() } }
    state pass_field_fact() { self.i32_backing0[166472 + self.i] = 0 - 1; self.i = self.i + 1; transition 0 { _ -> pass_field_facts() } }
    state pass_analyze() {
        self.analyze_interval_bodies();
        transition self.status == 0 { true -> pass_changed() _ -> done() }
    }
    state pass_changed() { transition self.ck3[19] == 1 { true -> pass_begin() _ -> finish() } }
    // Persist the complete predecessor join from the final analysis pass.
    // check_body copies it into body-local scratch so assignments affect only
    // subsequent statements, not the state's entry fact for later replay.
    state finish() { self.ck3[18] = 2; self.bundle_mode = 1; }
    state done() { }
}


// One publication machine is deliberate: the current Delta-written
// lowermachine has exactly 64 call-name rows. All capacity and relation checks
// still complete before pub_magic performs the first write.
machine Main::publish_ckir(&mut self) {
    self.term_operand_count = 0; self.i = 0;
    transition 0 { _ -> pre_terms() }
    state pre_terms() { transition self.i < self.block_count { true -> pre_kind() _ -> pre_length() } }
    state pre_kind() { transition self.i32_backing2[376848 + self.i] > 0 { true -> pre_arg0() _ -> pre_bad() } }
    state pre_arg0() {
        self.i32_backing2[382992 + self.i] = self.operand_count + self.term_operand_count;
        transition self.i32_backing2[385040 + self.i] <= 94208 - self.operand_count - self.term_operand_count { true -> pre_add0() _ -> pre_exhausted() }
    }
    state pre_add0() {
        self.term_operand_count = self.term_operand_count + self.i32_backing2[385040 + self.i];
        self.i32_backing2[389136 + self.i] = self.operand_count + self.term_operand_count;
        transition self.i32_backing2[391184 + self.i] <= 94208 - self.operand_count - self.term_operand_count { true -> pre_add1() _ -> pre_exhausted() }
    }
    state pre_add1() {
        self.term_operand_count = self.term_operand_count + self.i32_backing2[391184 + self.i];
        self.i = self.i + 1; transition 0 { _ -> pre_terms() }
    }
    state pre_length() {
        self.final_operand_count = self.operand_count + self.term_operand_count;
        transition self.final_operand_count <= 94208 - self.ck3[41] { true -> pre_length_version() _ -> pre_exhausted() }
    }
    state pre_length_version() { transition self.ck3[39] >= 5 { true -> pre_length_compute_v5() _ -> pre_length_compute() } }
    state pre_length_compute() {
        self.ck_length = 80 + 24 * self.ck_type_count + 20 * self.data_count
            + 16 * self.field_count + 36 * self.machine_count
            + 20 * self.machine_parameter_count + 32 * self.block_count
            + 20 * self.block_parameter_count + 24 * self.ck3[2]
            + 4 * self.ck3[3] + 40 * self.op_count
            + 4 * self.final_operand_count + 44 * self.block_count;
        transition self.ck_length <= 2522192 { true -> pub_magic() _ -> pre_exhausted() }
    }
    state pre_length_compute_v5() {
        self.ck_length = 100 + 24 * self.ck_type_count + 20 * self.data_count
            + 16 * self.field_count + 20 * self.sum_count + 20 * self.case_count
            + 16 * self.case_payload_count + 36 * self.machine_count
            + 20 * self.machine_parameter_count + 32 * self.block_count
            + 20 * self.block_parameter_count + 24 * self.ck3[2]
            + 4 * self.ck3[3] + 40 * self.op_count
            + 4 * self.final_operand_count + 52 * self.block_count
            + 24 * self.ck3[40] + 12 * self.ck3[41];
        transition self.ck_length <= 2522192 { true -> pub_magic() _ -> pre_exhausted() }
    }
    state pre_bad() { self.reject(); transition 0 { _ -> pub_done() } }
    state pre_exhausted() { self.status = 252; transition 0 { _ -> pub_done() } }

    state pub_magic() {
        write_byte(79); write_byte(77); write_byte(71); write_byte(67);
        write_byte(75); write_byte(73); write_byte(82); write_byte(0);
        transition self.ck3[39] == 13 { true -> pub_magic_v13() _ -> pub_magic_v12_check() }
    }
    state pub_magic_v12_check() { transition self.ck3[39] == 12 { true -> pub_magic_v12() _ -> pub_magic_v11_check() } }
    state pub_magic_v11_check() { transition self.ck3[39] == 11 { true -> pub_magic_v11() _ -> pub_magic_v10_check() } }
    state pub_magic_v10_check() { transition self.ck3[39] == 10 { true -> pub_magic_v10() _ -> pub_magic_v9_check() } }
    state pub_magic_v9_check() { transition self.ck3[39] == 9 { true -> pub_magic_v9() _ -> pub_magic_v8_check() } }
    state pub_magic_v8_check() { transition self.ck3[39] == 8 { true -> pub_magic_v8() _ -> pub_magic_v7_check() } }
    state pub_magic_v7_check() { transition self.ck3[39] == 7 { true -> pub_magic_v7() _ -> pub_magic_v6_check() } }
    state pub_magic_v6_check() { transition self.ck3[39] == 6 { true -> pub_magic_v6() _ -> pub_magic_v5_check() } }
    state pub_magic_v5_check() { transition self.ck3[39] == 5 { true -> pub_magic_v5() _ -> pub_magic_v4() } }
    state pub_magic_v4() { write_byte(4); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v5() { write_byte(5); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v6() { write_byte(6); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v7() { write_byte(7); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v8() { write_byte(8); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v9() { write_byte(9); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v10() { write_byte(10); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v11() { write_byte(11); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v12() { write_byte(12); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_magic_v13() { write_byte(13); write_byte(0); write_byte(0); write_byte(0); transition 0 { _ -> pub_target() } }
    state pub_target() {
        write_byte(1); write_byte(0);
        transition self.conformance_entry >= 0 { true -> pub_flags_entry() _ -> pub_flags_library() }
    }
    state pub_flags_entry() {
        write_byte(1); write_byte(0);
        self.c = self.conformance_entry; transition 0 { _ -> pub_header_entry0() }
    }
    state pub_header_entry0() { write_byte(self.c & 255); transition 0 { _ -> pub_header_entry1() } }
    state pub_header_entry1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_header_entry2() } }
    state pub_header_entry2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_header_entry3() } }
    state pub_header_entry3() { write_byte((self.c >> 24) & 255); transition 0 { _ -> pub_header_tail_begin() } }
    state pub_flags_library() {
        write_byte(0); write_byte(0); write_byte(255); write_byte(255);
        write_byte(255); write_byte(255); transition 0 { _ -> pub_header_tail_begin() }
    }
    state pub_header_tail_begin() { self.i = 0; transition 0 { _ -> pub_header_tail() } }
    state pub_header_tail() { transition self.ck3[39] >= 5 { true -> pub_header_tail_v5() _ -> pub_header_tail_v4() } }
    state pub_header_tail_v4() { transition self.i < 15 { true -> pub_header_select() _ -> pub_types_begin() } }
    state pub_header_tail_v5() { transition self.i < 20 { true -> pub_header_select_v5() _ -> pub_types_begin() } }
    state pub_header_select() {
        transition self.i == 0 { true -> pub_header_length() _ -> pub_header_type_check() }
    }
    state pub_header_length() { self.c = self.ck_length; transition 0 { _ -> pub_header_word0() } }
    state pub_header_type_check() { transition self.i == 1 { true -> pub_header_type() _ -> pub_header_record_check() } }
    state pub_header_type() { self.c = self.ck_type_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_record_check() { transition self.i == 2 { true -> pub_header_record() _ -> pub_header_field_check() } }
    state pub_header_record() { self.c = self.data_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_field_check() { transition self.i == 3 { true -> pub_header_field() _ -> pub_header_machine_check() } }
    state pub_header_field() { self.c = self.field_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_machine_check() { transition self.i == 4 { true -> pub_header_machine() _ -> pub_header_mparam_check() } }
    state pub_header_machine() { self.c = self.machine_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_mparam_check() { transition self.i == 5 { true -> pub_header_mparam() _ -> pub_header_block_check() } }
    state pub_header_mparam() { self.c = self.machine_parameter_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_block_check() { transition self.i == 6 { true -> pub_header_block() _ -> pub_header_bparam_check() } }
    state pub_header_block() { self.c = self.block_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_bparam_check() { transition self.i == 7 { true -> pub_header_bparam() _ -> pub_header_op_check() } }
    state pub_header_bparam() { self.c = self.block_parameter_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_op_check() { transition self.i == 8 { true -> pub_header_op() _ -> pub_header_operand_check() } }
    state pub_header_op() { self.c = self.op_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_operand_check() { transition self.i == 9 { true -> pub_header_operand() _ -> pub_header_term_check() } }
    state pub_header_operand() { self.c = self.final_operand_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_term_check() { transition self.i == 10 { true -> pub_header_term() _ -> pub_header_value_check() } }
    state pub_header_term() { self.c = self.block_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_value_check() { transition self.i == 11 { true -> pub_header_value() _ -> pub_header_place_check() } }
    state pub_header_value() { self.c = self.value_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_place_check() { transition self.i == 12 { true -> pub_header_place() _ -> pub_header_const_check() } }
    state pub_header_place() { self.c = self.place_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_const_check() { transition self.i == 13 { true -> pub_header_const() _ -> pub_header_child() } }
    state pub_header_const() { self.c = self.ck3[2]; transition 0 { _ -> pub_header_word0() } }
    state pub_header_child() { self.c = self.ck3[3]; transition 0 { _ -> pub_header_word0() } }
    state pub_header_select_v5() { transition self.i == 0 { true -> pub_header_length() _ -> pub_header_v5_type_check() } }
    state pub_header_v5_type_check() { transition self.i == 1 { true -> pub_header_type() _ -> pub_header_v5_record_check() } }
    state pub_header_v5_record_check() { transition self.i == 2 { true -> pub_header_record() _ -> pub_header_v5_field_check() } }
    state pub_header_v5_field_check() { transition self.i == 3 { true -> pub_header_field() _ -> pub_header_v5_sum_check() } }
    state pub_header_v5_sum_check() { transition self.i == 4 { true -> pub_header_v5_sum() _ -> pub_header_v5_case_check() } }
    state pub_header_v5_sum() { self.c = self.sum_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_v5_case_check() { transition self.i == 5 { true -> pub_header_v5_case() _ -> pub_header_v5_payload_check() } }
    state pub_header_v5_case() { self.c = self.case_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_v5_payload_check() { transition self.i == 6 { true -> pub_header_v5_payload() _ -> pub_header_v5_machine_check() } }
    state pub_header_v5_payload() { self.c = self.case_payload_count; transition 0 { _ -> pub_header_word0() } }
    state pub_header_v5_machine_check() { transition self.i == 7 { true -> pub_header_machine() _ -> pub_header_v5_mparam_check() } }
    state pub_header_v5_mparam_check() { transition self.i == 8 { true -> pub_header_mparam() _ -> pub_header_v5_block_check() } }
    state pub_header_v5_block_check() { transition self.i == 9 { true -> pub_header_block() _ -> pub_header_v5_bparam_check() } }
    state pub_header_v5_bparam_check() { transition self.i == 10 { true -> pub_header_bparam() _ -> pub_header_v5_const_check() } }
    state pub_header_v5_const_check() { transition self.i == 11 { true -> pub_header_const() _ -> pub_header_v5_child_check() } }
    state pub_header_v5_child_check() { transition self.i == 12 { true -> pub_header_child() _ -> pub_header_v5_op_check() } }
    state pub_header_v5_op_check() { transition self.i == 13 { true -> pub_header_op() _ -> pub_header_v5_operand_check() } }
    state pub_header_v5_operand_check() { transition self.i == 14 { true -> pub_header_operand() _ -> pub_header_v5_term_check() } }
    state pub_header_v5_term_check() { transition self.i == 15 { true -> pub_header_term() _ -> pub_header_v5_arm_check() } }
    state pub_header_v5_arm_check() { transition self.i == 16 { true -> pub_header_v5_arm() _ -> pub_header_v5_arm_arg_check() } }
    state pub_header_v5_arm() { self.c = self.ck3[40]; transition 0 { _ -> pub_header_word0() } }
    state pub_header_v5_arm_arg_check() { transition self.i == 17 { true -> pub_header_v5_arm_arg() _ -> pub_header_v5_value_check() } }
    state pub_header_v5_arm_arg() { self.c = self.ck3[41]; transition 0 { _ -> pub_header_word0() } }
    state pub_header_v5_value_check() { transition self.i == 18 { true -> pub_header_value() _ -> pub_header_place() } }
    state pub_header_word0() { write_byte(self.c & 255); transition 0 { _ -> pub_header_word1() } }
    state pub_header_word1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_header_word2() } }
    state pub_header_word2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_header_word3() } }
    state pub_header_word3() { write_byte((self.c >> 24) & 255); self.i = self.i + 1; transition 0 { _ -> pub_header_tail() } }

    state pub_types_begin() { self.i = 0; transition 0 { _ -> pub_types() } }
    state pub_types() { transition self.i < self.ck_type_count { true -> pub_type_id() _ -> pub_records_begin() } }
    state pub_type_id() { self.c = self.i; self.saved_tok = 1; transition 0 { _ -> pub_type_word0() } }
    state pub_type_word0() { write_byte(self.c & 255); transition 0 { _ -> pub_type_word1() } }
    state pub_type_word1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_type_word2() } }
    state pub_type_word2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_type_word3() } }
    state pub_type_word3() { write_byte((self.c >> 24) & 255); transition self.saved_tok { 1 -> pub_type_head() 2 -> pub_type_payload1() 3 -> pub_type_lo() 4 -> pub_type_hi() _ -> pub_type_next() } }
    state pub_type_head() { write_byte(self.i32_backing1[205440 + self.i]); write_byte(self.i32_backing1[213632 + self.i]); write_byte(0); write_byte(0); self.c = self.i32_backing1[221824 + self.i]; self.saved_tok = 2; transition 0 { _ -> pub_type_word0() } }
    state pub_type_payload1() { self.c = self.i32_backing1[230016 + self.i]; self.saved_tok = 3; transition 0 { _ -> pub_type_word0() } }
    state pub_type_lo() { self.c = self.i32_backing1[238208 + self.i]; self.saved_tok = 4; transition 0 { _ -> pub_type_word0() } }
    state pub_type_hi() { self.c = self.i32_backing1[246400 + self.i]; self.saved_tok = 5; transition 0 { _ -> pub_type_word0() } }
    state pub_type_next() { self.i = self.i + 1; transition 0 { _ -> pub_types() } }

    state pub_records_begin() { self.i = 0; self.saved_tok = 0; transition 0 { _ -> pub_records() } }
    state pub_records() { transition self.i < self.data_count { true -> pub_record_word() _ -> pub_fields_begin() } }
