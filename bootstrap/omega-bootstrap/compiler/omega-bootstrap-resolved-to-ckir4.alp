    state pub_record_id() { self.c = self.i; self.saved_tok = 1; transition 0 { _ -> pub_record_word0() } }
    state pub_record_nominal_check() { transition self.saved_tok == 1 { true -> pub_record_nominal() _ -> pub_record_start_check() } }
    state pub_record_nominal() { self.c = self.i32_backing1[205312 + self.i]; self.saved_tok = 2; transition 0 { _ -> pub_record_word0() } }
