    }
    state finish() { transition self.current_result_type < 0 { true -> unit_finish() _ -> result_complete() } }
    state unit_finish() { transition self.bundle_mode == 1 { true -> unit_terminated() _ -> done() } }
    state unit_terminated() { transition self.body_terminated == 1 { true -> done() _ -> unit_emit() } }
    state unit_emit() {
        self.i32_backing2[376848 + self.current_block] = 3;
        self.i32_backing2[378896 + self.current_block] = 0 - 1;
        self.i32_backing2[380944 + self.current_block] = 0 - 1;
        self.i32_backing2[387088 + self.current_block] = 0 - 1;
        self.i32_backing2[385040 + self.current_block] = 0;
        self.i32_backing2[391184 + self.current_block] = 0;
