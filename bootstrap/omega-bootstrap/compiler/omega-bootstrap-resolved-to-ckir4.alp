machine Main::load_block_parameters(&mut self) {
    self.i = 0; self.param_count = self.machine_parameter_count + self.w_block_parameter_count;
    transition self.param_count <= 4096 { true -> rows() _ -> over() }
    state rows() { transition self.i < self.w_block_parameter_count { true -> row() _ -> done() } }
    state row() { self.table_pos = self.w_block_parameters + self.i * 24; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> owner() _ -> bad() } }
    state owner() { self.read_witness_u32(self.table_pos + 4); self.x = self.decoded; transition self.x < self.w_block_count { true -> owner_named() _ -> bad() } }
    state owner_named() { transition self.i32_backing2[440960 + self.x] > 0 { true -> owner_span() _ -> bad() } }
    state owner_span() { transition self.i >= self.i32_backing2[449152 + self.x] { true -> owner_span_end() _ -> bad() } }
    state owner_span_end() { transition self.i - self.i32_backing2[449152 + self.x] < self.i32_backing2[451200 + self.x] { true -> ordinal() _ -> bad() } }
    state ordinal() { self.read_witness_u32(self.table_pos + 8); transition self.decoded == self.i - self.i32_backing2[449152 + self.x] { true -> type_id() _ -> bad() } }
    state type_id() { self.read_witness_u32(self.table_pos + 12); self.y = self.machine_parameter_count + self.i; self.i32_backing0[330312 + self.y] = self.decoded; transition self.decoded < self.type_count { true -> name() _ -> bad() } }
    state name() { self.read_witness_u32(self.table_pos + 16); self.saved_pos = self.decoded; self.read_witness_u32(self.table_pos + 20); self.saved_tok_len = self.decoded; transition self.status == 0 { true -> span() _ -> done() } }
    state span() { self.source_span_valid(self.i32_backing2[438464 + self.i32_backing2[438912 + self.x]], self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> nonempty() _ -> bad() } }
    state nonempty() { transition self.saved_tok_len > 0 { true -> save() _ -> bad() } }
    state save() {
        let state_id: i32 = self.x - self.i32_backing2[438912 + self.x] - 1;
        self.i32_backing0[232008 + self.y] = 1000 + state_id;
        self.i32_backing0[264776 + self.y] = self.i32_backing2[436576 + self.i32_backing2[438464 + self.i32_backing2[438912 + self.x]]] + self.saved_pos;
        self.i32_backing0[297544 + self.y] = self.saved_tok_len;
        self.i = self.i + 1; transition 0 { _ -> rows() }
    }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_imports(&mut self) {
    self.i = 0; self.x = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.w_import_count { true -> source_seek() _ -> done() } }
    state source_seek() { transition self.i < self.i32_backing2[436608 + self.x] + self.i32_backing2[436624 + self.x] { true -> row() _ -> source_next() } }
