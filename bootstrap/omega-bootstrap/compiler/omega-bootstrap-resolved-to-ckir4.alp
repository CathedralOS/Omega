machine Main::intern_constant(&mut self) {
    self.ck3[11] = 0 - 1; self.i = 0;
    transition 0 { _ -> scan() }
    state scan() { transition self.i < self.ck3[0] { true -> type_match() _ -> capacity() } }
    state type_match() { transition self.temp_const_types[self.i] == self.ck3[10] { true -> height_match() _ -> next() } }
    state height_match() { transition self.temp_const_heights[self.i] == self.ck3[12] { true -> count_match() _ -> next() } }
    state count_match() { transition self.temp_const_counts[self.i] == self.ck3[8] { true -> scalar_match() _ -> next() } }
    state scalar_match() { transition self.temp_const_scalars[self.i] == self.saved_int_value { true -> children_begin() _ -> next() } }
    state children_begin() { self.j = 0; transition 0 { _ -> children() } }
    state children() { transition self.j < self.ck3[8] { true -> child_match() _ -> found() } }
    state child_match() {
        transition self.temp_const_children[self.temp_const_starts[self.i] + self.j] == self.const_parse_children[self.ck3[5] + self.j] { true -> child_next() _ -> next() }
    }
    state child_next() { self.j = self.j + 1; transition 0 { _ -> children() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> scan() } }
    state found() { self.ck3[11] = self.i; transition 0 { _ -> done() } }
    state capacity() { transition self.ck3[0] < 8192 { true -> child_capacity() _ -> exhausted() } }
    state child_capacity() { transition self.ck3[8] <= 16384 - self.ck3[1] { true -> store() _ -> exhausted() } }
    state store() {
        self.ck3[11] = self.ck3[0];
        self.temp_const_types[self.ck3[0]] = self.ck3[10];
        self.temp_const_heights[self.ck3[0]] = self.ck3[12];
        self.temp_const_starts[self.ck3[0]] = self.ck3[1];
        self.temp_const_counts[self.ck3[0]] = self.ck3[8];
        self.temp_const_scalars[self.ck3[0]] = self.saved_int_value;
        self.j = 0; transition 0 { _ -> copy() }
    }
    state copy() { transition self.j < self.ck3[8] { true -> copy_one() _ -> stored() } }
    state copy_one() {
        self.temp_const_children[self.ck3[1] + self.j] = self.const_parse_children[self.ck3[5] + self.j];
        self.j = self.j + 1; transition 0 { _ -> copy() }
    }
    state stored() {
        self.ck3[1] = self.ck3[1] + self.ck3[8];
        self.ck3[0] = self.ck3[0] + 1;
        transition 0 { _ -> done() }
    }
    state exhausted() { self.exhaust(); }
    state done() { }
}

machine Main::parse_scalar_constant(&mut self, expected: i32) {
    self.ck3[11] = 0 - 1;
    transition self.i32_backing0[363080 + expected] == 3 { true -> boolean() _ -> integer() }
    state integer() { transition self.tok == 257 { true -> integer_range() _ -> bad() } }
    state integer_range() {
        transition self.int_value >= self.i32_backing1[98304 + expected] { true -> integer_high() _ -> bad() }
    }
    state integer_high() {
        transition self.int_value <= self.i32_backing1[131072 + expected] { true -> integer_intern() _ -> bad() }
    }
    state integer_intern() {
        self.ck3[10] = self.i32_backing1[172544 + expected]; self.ck3[12] = 0;
        self.ck3[8] = 0; self.ck3[5] = self.ck3[4];
        self.saved_int_value = self.int_value; self.intern_constant();
        transition self.status == 0 { true -> advance() _ -> done() }
    }
    state boolean() { transition self.tok == 256 { true -> true_check() _ -> bad() } }
    state true_check() { self.token_word(37, 4); transition self.match_ok == 1 { true -> true_value() _ -> false_check() } }
    state true_value() { self.int_value = 1; transition 0 { _ -> boolean_intern() } }
    state false_check() { self.token_word(41, 5); transition self.match_ok == 1 { true -> false_value() _ -> bad() } }
    state false_value() { self.int_value = 0; transition 0 { _ -> boolean_intern() } }
    state boolean_intern() {
        self.ck3[10] = self.i32_backing1[172544 + expected]; self.ck3[12] = 0;
        self.ck3[8] = 0; self.ck3[5] = self.ck3[4];
        self.saved_int_value = self.int_value; self.intern_constant();
        transition self.status == 0 { true -> advance() _ -> done() }
    }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

