    state row() { self.table_pos = self.w_imports + self.i * 48; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> source_id() _ -> bad() } }
