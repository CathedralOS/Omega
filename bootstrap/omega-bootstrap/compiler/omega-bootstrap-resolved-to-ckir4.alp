    state closed_pair() { transition self.arm_true == 1 { true -> closed_false() _ -> bad() } }
    state closed_false() { transition self.arm_false == 1 { true -> closed_emit_check() _ -> bad() } }
    state closed_emit_check() { transition self.bundle_mode == 1 { true -> closed_emit() _ -> done() } }
    state closed_emit() { self.finalize_transition_term(); transition 0 { _ -> done() } }
