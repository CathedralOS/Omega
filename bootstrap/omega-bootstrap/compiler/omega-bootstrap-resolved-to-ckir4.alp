    state pub_term_operands() { transition self.i < self.block_count { true -> pub_term_arg0() _ -> pub_terminators_begin() } }
    state pub_term_arg0() { transition self.j < self.i32_backing2[385040 + self.i] { true -> pub_term_arg0_word() _ -> pub_term_arg1() } }
    state pub_term_arg0_word() { self.c = self.i32_backing2[393232 + self.i * 7 + self.j]; self.k = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_term_arg1() { transition self.j - self.i32_backing2[385040 + self.i] < self.i32_backing2[391184 + self.i] { true -> pub_term_arg1_word() _ -> pub_term_next() } }
