    //   [376840..376848) stack_place_ids (8)
    //   [376848..378896) terminator_kinds (2048)
    //   [378896..380944) terminator_values (2048)
    //   [380944..382992) terminator_target0 (2048)
    //   [382992..385040) terminator_arg0_starts (2048)
    //   [385040..387088) terminator_arg0_counts (2048)
    //   [387088..389136) terminator_target1 (2048)
    //   [389136..391184) terminator_arg1_starts (2048)
    //   [391184..393232) terminator_arg1_counts (2048)
    //   [393232..407568) terminator_arg0_values (14336)
    //   [407568..421904) terminator_arg1_values (14336)
    //   [421904..436240) terminator_wild_values (14336)
    //   [436240..436256) package_source_starts (16)
    //   [436256..436272) package_source_counts (16)
    //   [436272..436288) source_owners (16)
    //   [436288..436304) source_bundle_ids (16)
    //   [436304..436320) source_modules (16)
    //   [436320..436352) alias_requesters (32)
    //   [436352..436384) alias_strings (32)
    //   [436384..436416) alias_targets (32)
    //   [436416..436480) string_starts (64)
    //   [436480..436544) string_lengths (64)
    //   [436544..436560) bundle_content_starts (16)
    //   [436560..436576) bundle_content_lengths (16)
    //   [436576..436592) source_starts (16)
    //   [436592..436608) source_lengths (16)
    //   [436608..436624) unit_import_starts (16)
    //   [436624..436640) unit_import_counts (16)
    //   [436640..436656) unit_decl_starts (16)
    //   [436656..436672) unit_decl_counts (16)
    //   [436672..436928) declaration_sources (256)
    //   [436928..437184) declaration_kinds (256)
    //   [437184..437440) declaration_visibility (256)
    //   [437440..437696) declaration_name_starts (256)
    //   [437696..437952) declaration_name_lengths (256)
    //   [437952..438208) declaration_kind_ids (256)
    //   [438208..438336) record_declarations (128)
    //   [438336..438464) machine_declarations (128)
    //   [438464..438592) machine_sources (128)
    //   [438592..438720) machine_owner_binding_seen (128)
    //   [438720..438784) import_sources (64)
    //   [438784..438848) import_target_kinds (64)
    //   [438848..438912) import_declarations (64)
    //   [438912..440960) witness_block_owners (2048)
    //   [440960..443008) witness_block_ordinals (2048)
    //   [443008..445056) witness_block_access (2048)
    //   [445056..447104) witness_block_body_starts (2048)
    //   [447104..449152) witness_block_body_ends (2048)
    //   [449152..451200) witness_block_param_starts (2048)
    //   [451200..453248) witness_block_param_counts (2048)
    //   [453248..453256) stack_receiver_shapes (8)
    words: [u8; 67];




























    // Type rows: kind 1=u8, 2=u32, 3=bool, 4=nominal, 5=fixed array.
    // Nominal rows resolve after all roots are known.






    // Bundle-only conservative declaration-order layouts. State 0 is unresolved
    // and 2 complete. A fixed-point pass rejects a no-progress by-value cycle
    // semantically rather than manufacturing a layout or reporting exhaustion.



    layout_size: i32; layout_alignment: i32; layout_padding: i32;

    // Canonical CKIR1 type interning and semantic-row mappings.
    ck_type_count: i32;




    ck_kind: i32; ck_flags: i32; ck_payload0: i32; ck_payload1: i32;
    ck_lo: i32; ck_hi: i32; ck_type_id: i32;
    ck_bool_type: i32; ck_u32_full_type: i32;

    // CKIR1 block identities. Existing parameter rows are already partitioned:
    // machine parameters are collected before state parameters.
    machine_parameter_count: i32; block_parameter_count: i32;
    block_count: i32; current_block: i32; conformance_entry: i32;
    synthetic_block: i32;
    ck_block_parameter_cursor: i32;






    // Stackless CKIR1 operations and the flat operand vector.
    op_count: i32; operand_count: i32; value_count: i32; place_count: i32;





    record_operand_words: i32; record_operand0: i32;
    record_operand1: i32; record_immediate0: i32;
    call_operands: [i32; 8];
    call_edges: [u8; 16384];
    call_binding_consumed: [u8; 4096];
    call_indegree: [i32; 128];
    call_processed: [u8; 128];
    call_callee_stack: [i32; 8];
    call_receiver_stack: [i32; 8];
    // Slots 0..7 are the inherited per-call argument cursors. Slots 8..15
    // record whether that call has already admitted one potentially trapping
    // argument; slots 16..23 retain its CKIR11 selected-add counter origin.
    call_arg_cursors: [i32; 24];
    call_argument_stack: [i32; 64];
    call_depth: i32;
    call_binding_id: i32; call_callee: i32; call_arg_index: i32;
    record_operand_index: i32;
    call_expected_count: i32; call_saved_start: i32; call_saved_len: i32;
    call_source: i32; call_relative: i32; call_parameter: i32;
    call_value: i32; call_result_type: i32; call_edge_index: i32;



    expr_value_id: i32; expr_place_id: i32;
    left_value_id: i32; left_place_id: i32;
    right_value_id: i32; right_place_id: i32;
    assignment_place_id: i32; saved_value_id: i32;


    // One terminator row per block, plus temporary arm custody while parsing.




    transition_value_id: i32; transition_arm_kind: i32;
    transition_target0: i32; transition_target1: i32;
    transition_arg0_count: i32; transition_arg1_count: i32;
    transition_wild_target: i32; transition_arg_wild_count: i32;

    final_operand_count: i32; term_operand_count: i32;
    ck_length: i32;
    // Exact OMGLOW4 and consumed OMGCOMP framing.
    frame_total: i32; comp_n: i32; witness_n: i32; total_length: i32;
    x: i32; y: i32; table_pos: i32; table_end: i32;
    package_count: i32; source_count: i32; alias_count: i32; string_count: i32;
    bundle_length: i32; string_table_length: i32; aggregate_source_bytes: i32;
    root_package: i32; root_source: i32; root_owner_string: i32; root_machine_string: i32;
    package_table: i32; source_table: i32; alias_table: i32; string_table: i32; bundle_start: i32;









    // OMGRSW1/2/3/4 header and shared table offsets.
    w_unit_count: i32; w_import_count: i32; w_binding_count: i32;
    w_declaration_count: i32; w_record_count: i32; w_field_count: i32;
    resolution_version: i32; field_receiver_count: i32;
    w_machine_count: i32; w_machine_parameter_count: i32;
    w_block_count: i32; w_block_parameter_count: i32;
    witness_selected: i32;
    w_units: i32; w_imports: i32; w_bindings: i32; w_declarations: i32;
    w_types: i32; w_records: i32; w_fields: i32; w_machines: i32;
    w_machine_parameters: i32; w_blocks: i32; w_block_parameters: i32;

    // CKIR4 semantic constants. Discovery-order nodes use temp_*; canonical
    // nodes use const_*. Children are old IDs in temp_children and canonical
    // IDs in const_children. parse_children is per-root scratch.
    temp_const_types: [i32; 8192];
    temp_const_heights: [i32; 8192];
    temp_const_starts: [i32; 8192];
    temp_const_counts: [i32; 8192];
    temp_const_scalars: [i32; 8192];
    temp_const_children: [i32; 16384];
    const_types: [i32; 8192];
    const_heights: [i32; 8192];
    const_starts: [i32; 8192];
    const_counts: [i32; 8192];
    const_scalars: [i32; 8192];
    const_children: [i32; 16384];
    const_old_to_new: [i32; 8192];
    const_selected: [u8; 8192];
    const_parse_children: [i32; 16384];
    const_parse_bases: [i32; 8];
    const_parse_counts: [i32; 8];
    const_parse_fields: [i32; 8];
    const_parse_ordinals: [i32; 8];
    const_record_seen: [u8; 512];
    // CKIR4 scalar scratch is indexed to keep the standard lowermachine's
    // 256-field metadata table within its inherited bound.
    ck3: [i32; 64];

    // State-edge scalar interval fixed point. State parameter IDs occupy the
    // inherited global parameter table; only those IDs are updated here.
    interval_los: [i32; 32768];
    interval_his: [i32; 32768];
    interval_reachable: [u8; 16384];
    interval_pending: [u8; 32768];












}

machine Main::init_words(&mut self) {
    // datacopymachinemutselfstatetransitiontruefalseu8u32boolinTrapping
    self.words[0]=100; self.words[1]=97; self.words[2]=116; self.words[3]=97;
    self.words[4]=99; self.words[5]=111; self.words[6]=112; self.words[7]=121;
    self.words[8]=109; self.words[9]=97; self.words[10]=99; self.words[11]=104;
    self.words[12]=105; self.words[13]=110; self.words[14]=101;
    self.words[15]=109; self.words[16]=117; self.words[17]=116;
    self.words[18]=115; self.words[19]=101; self.words[20]=108; self.words[21]=102;
    self.words[22]=115; self.words[23]=116; self.words[24]=97; self.words[25]=116; self.words[26]=101;
    self.words[27]=116; self.words[28]=114; self.words[29]=97; self.words[30]=110; self.words[31]=115;
    self.words[32]=105; self.words[33]=116; self.words[34]=105; self.words[35]=111; self.words[36]=110;
    self.words[37]=116; self.words[38]=114; self.words[39]=117; self.words[40]=101;
    self.words[41]=102; self.words[42]=97; self.words[43]=108; self.words[44]=115; self.words[45]=101;
    self.words[46]=117; self.words[47]=56;
    self.words[48]=117; self.words[49]=51; self.words[50]=50;
    self.words[51]=98; self.words[52]=111; self.words[53]=111; self.words[54]=108;
    self.words[55]=105; self.words[56]=110;
    self.words[57]=84; self.words[58]=114; self.words[59]=97; self.words[60]=112;
    self.words[61]=112; self.words[62]=105; self.words[63]=110; self.words[64]=103;
    self.words[65]=97; self.words[66]=115;
}

machine Main::is_ident_start(&mut self) {
    self.char_ok = 0;
    transition self.c == 95 { true -> yes() _ -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() _ -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() _ -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() _ -> done() } }
    state lower1() { transition self.c < 123 { true -> yes() _ -> done() } }
    state yes() { self.char_ok = 1; }
    state done() { }
}

machine Main::is_ident_continue(&mut self) {
    self.is_ident_start();
    transition self.char_ok == 1 { true -> done() _ -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() _ -> done() } }
    state yes() { self.char_ok = 1; }
    state done() { }
}

machine Main::skip_block_comment(&mut self) {
    self.pos = self.pos + 2; self.comment_depth = 1;
    transition 0 { _ -> loop() }
    state loop() { transition self.pos < self.limit { true -> byte() _ -> bad() } }
    state byte() { self.c = self.source[self.pos]; transition self.c == 47 { true -> open_bound() _ -> close_first() } }
    state open_bound() { transition self.pos + 1 < self.limit { true -> open_second() _ -> advance() } }
    state open_second() { transition self.source[self.pos + 1] == 42 { true -> open() _ -> advance() } }
    state open() { self.comment_depth = self.comment_depth + 1; self.pos = self.pos + 2; transition 0 { _ -> loop() } }
    state close_first() { transition self.c == 42 { true -> close_bound() _ -> advance() } }
    state close_bound() { transition self.pos + 1 < self.limit { true -> close_second() _ -> advance() } }
    state close_second() { transition self.source[self.pos + 1] == 47 { true -> close() _ -> advance() } }
    state close() {
        self.comment_depth = self.comment_depth - 1; self.pos = self.pos + 2;
        transition self.comment_depth == 0 { true -> done() _ -> loop() }
    }
    state advance() { self.pos = self.pos + 1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); }
    state done() { }
}

// Token kinds: 0 EOF, 256 identifier, 257 nonnegative integer, 258 bounded
// plain-ASCII byte literal. Punctuation is
// represented by its ASCII byte. Multi-byte operators are checked as sequences.
machine Main::next_token(&mut self) {
    self.tok = 0; self.tok_len = 0;
    transition self.status == 0 { true -> skip() _ -> done() }
    state skip() { transition self.pos < self.limit { true -> skip_byte() _ -> eof() } }
    state skip_byte() { self.c = self.source[self.pos]; transition self.c == 32 { true -> skip_advance() _ -> lf() } }
    state lf() { transition self.c == 10 { true -> skip_advance() _ -> cr() } }
    state cr() { transition self.c == 13 { true -> skip_advance() _ -> tab() } }
    state tab() { transition self.c == 9 { true -> skip_advance() _ -> slash() } }
    state skip_advance() { self.pos = self.pos + 1; transition 0 { _ -> skip() } }
    state slash() { transition self.c == 47 { true -> slash_bound() _ -> classify() } }
    state slash_bound() { transition self.pos + 1 < self.limit { true -> slash_second() _ -> classify() } }
    state slash_second() { transition self.source[self.pos + 1] == 47 { true -> line_begin() _ -> block_second() } }
    state block_second() { transition self.source[self.pos + 1] == 42 { true -> block() _ -> classify() } }
    state block() { self.skip_block_comment(); transition self.status == 0 { true -> skip() _ -> done() } }
    state line_begin() { self.pos = self.pos + 2; transition 0 { _ -> line() } }
    state line() { transition self.pos < self.limit { true -> line_byte() _ -> eof() } }
    state line_byte() { transition self.source[self.pos] == 10 { true -> skip_advance() _ -> line_next() } }
    state line_next() { self.pos = self.pos + 1; transition 0 { _ -> line() } }
    state classify() {
        self.tok_start = self.pos; self.is_ident_start();
        transition self.char_ok == 1 { true -> ident_begin() _ -> quote() }
    }
    state quote() { transition self.c == 34 { true -> string_begin() _ -> digit0() } }
    state string_begin() { self.pos = self.pos + 1; transition 0 { _ -> string_loop() } }
    state string_loop() { transition self.pos < self.limit { true -> string_byte() _ -> bad() } }
    state string_byte() { self.c = self.source[self.pos]; transition self.c == 34 { true -> string_close() _ -> string_ascii_low() } }
    state string_ascii_low() { transition self.c >= 32 { true -> string_ascii_high() _ -> bad() } }
    state string_ascii_high() { transition self.c <= 126 { true -> string_backslash() _ -> bad() } }
    state string_backslash() { transition self.c == 92 { true -> bad() _ -> string_capacity() } }
    state string_capacity() { transition self.pos - self.tok_start <= 32 { true -> string_next() _ -> exhausted() } }
    state string_next() { self.pos = self.pos + 1; transition 0 { _ -> string_loop() } }
    state string_close() { self.pos = self.pos + 1; self.tok = 258; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state ident_begin() { self.pos = self.pos + 1; transition 0 { _ -> ident_loop() } }
    state ident_loop() { transition self.pos < self.limit { true -> ident_byte() _ -> ident_done() } }
    state ident_byte() {
        self.c = self.source[self.pos]; self.is_ident_continue();
        transition self.char_ok == 1 { true -> ident_capacity() _ -> ident_done() }
    }
    state ident_capacity() { transition self.pos - self.tok_start < 64 { true -> ident_next() _ -> exhausted() } }
    state ident_next() { self.pos = self.pos + 1; transition 0 { _ -> ident_loop() } }
    state ident_done() { self.tok = 256; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> ascii() } }
    state digit1() { transition self.c < 58 { true -> integer_begin() _ -> ascii() } }
    // Parse complete u32 decimal payloads with two base-65536 limbs.  ck3[59]
    // was previously unused and is now tokenizer-local high-limb scratch.
    state integer_begin() { self.int_value = 0; self.ck3[59] = 0; transition 0 { _ -> integer_loop() } }
    state integer_loop() { transition self.pos < self.limit { true -> integer_byte() _ -> integer_done() } }
    state integer_byte() { self.c = self.source[self.pos]; transition self.c >= 48 { true -> integer_high() _ -> integer_done() } }
    state integer_high() { transition self.c < 58 { true -> integer_low_limb() _ -> integer_done() } }
    state integer_low_limb() { self.match_ok=self.int_value*10+self.c-48; self.int_value=self.match_ok%65536; self.match_ok=self.match_ok/65536; transition 0 { _ -> integer_high_limb() } }
    state integer_high_limb() { self.match_ok=self.ck3[59]*10+self.match_ok; transition self.match_ok<=65535 { true -> integer_add() _ -> bad() } }
    state integer_add() { self.ck3[59]=self.match_ok; self.pos=self.pos+1; transition 0 { _ -> integer_loop() } }
    state integer_done() { transition self.ck3[59]<32768 { true -> integer_pack_low() _ -> integer_pack_high() } }
    state integer_pack_low() { self.int_value=self.int_value+self.ck3[59]*65536; transition 0 { _ -> integer_token() } }
    state integer_pack_high() { self.int_value=self.int_value+(self.ck3[59]-32768)*65536-2147483647-1; transition 0 { _ -> integer_token() } }
    state integer_token() { self.tok = 257; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state ascii() { transition self.c < 128 { true -> punctuation() _ -> bad() } }
    state punctuation() { self.tok = self.c; self.tok_len = 1; self.pos = self.pos + 1; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; }
    state bad() { self.reject(); }
    state eof() { self.tok = 0; self.tok_start = self.pos; }
    state done() { }
}

machine Main::token_word(&mut self, base: i32, count: i32) {
    self.match_ok = 0; self.i = 0;
    transition self.tok == 256 { true -> length() _ -> done() }
    state length() { transition self.tok_len == count { true -> loop() _ -> done() } }
    state loop() { transition self.i < count { true -> byte() _ -> yes() } }
    state byte() { transition self.source[self.tok_start + self.i] == self.words[base + self.i] { true -> next() _ -> done() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::spans_equal(&mut self, left: i32, right: i32, count: i32) {
    // ck3[49] is call-local scratch. Callers frequently use i as their dense
    // row cursor; clobbering it made the second case/payload name comparison
    // skip or loop over the wrong row.
    self.match_ok = 0; self.ck3[49] = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.ck3[49] < count { true -> byte() _ -> yes() } }
    state byte() { transition self.source[left + self.ck3[49]] == self.source[right + self.ck3[49]] { true -> next() _ -> done() } }
    state next() { self.ck3[49] = self.ck3[49] + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::expect_token(&mut self, expected: i32) {
    transition self.tok == expected { true -> advance() _ -> bad() }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::expect_word(&mut self, base: i32, count: i32) {
    self.token_word(base, count);
    transition self.match_ok == 1 { true -> advance() _ -> bad() }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

// Failure status is monotonic. A caller may discover that a nested lexer or
// table operation exhausted declared backing and then take its ordinary local
// failure edge; that edge must not downgrade 252 to unsupported status 251.
machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set() _ -> done() }
    state set() { self.status = 251; }
    state done() { }
}

machine Main::exhaust(&mut self) {
    transition self.status == 0 { true -> set() _ -> done() }
    state set() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_header_u32(&mut self, at: i32) {
    self.decoded = 0 - 1;
    transition at <= 28 { true -> signed() _ -> bad() }
    state signed() { transition self.frame_header[at + 3] < 128 { true -> decode() _ -> bad() } }
    state decode() {
        self.decoded = self.frame_header[at]
            + self.frame_header[at + 1] * 256
            + self.frame_header[at + 2] * 65536
            + self.frame_header[at + 3] * 16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_source_u32(&mut self, at: i32) {
    self.decoded = 0 - 1;
    transition at >= 0 { true -> room() _ -> bad() }
    state room() { transition at <= self.comp_n - 4 { true -> signed() _ -> bad() } }
    state signed() { transition self.source[at + 3] < 128 { true -> decode() _ -> bad() } }
    state decode() {
        self.decoded = self.source[at]
            + self.source[at + 1] * 256
            + self.source[at + 2] * 65536
            + self.source[at + 3] * 16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_witness_u32(&mut self, at: i32) {
    self.decoded = 0 - 1;
    transition at >= 0 { true -> room() _ -> bad() }
    state room() { transition at <= self.witness_n - 4 { true -> signed() _ -> bad() } }
    state signed() { transition self.witness[at + 3] < 128 { true -> decode() _ -> absent3() } }
    state absent3() { transition self.witness[at + 3] == 255 { true -> absent2() _ -> bad() } }
    state absent2() { transition self.witness[at + 2] == 255 { true -> absent1() _ -> bad() } }
    state absent1() { transition self.witness[at + 1] == 255 { true -> absent0() _ -> bad() } }
    state absent0() { transition self.witness[at] == 255 { true -> absent() _ -> bad() } }
    state absent() { self.decoded = 0 - 1; transition 0 { _ -> done() } }
    state decode() {
        self.decoded = self.witness[at]
            + self.witness[at + 1] * 256
            + self.witness[at + 2] * 65536
            + self.witness[at + 3] * 16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

// Semantic scalar words may use every u32 bit pattern.  The signed i32 cell
// retains that pattern exactly; callers use this decoder only in scalar
// endpoint positions and never confuse a high scalar with structural NO_ID.
machine Main::read_witness_scalar_u32(&mut self, at: i32) {
    self.decoded = 0 - 1;
    transition at >= 0 { true -> room() _ -> bad() }
    state room() { transition at <= self.witness_n - 4 { true -> low() _ -> bad() } }
    state low() { self.decoded = self.witness[at] + self.witness[at+1]*256 + self.witness[at+2]*65536; transition self.witness[at+3] < 128 { true -> low_high() _ -> high() } }
    state low_high() { self.decoded = self.decoded + self.witness[at+3]*16777216; transition 0 { _ -> done() } }
    state high() { self.decoded = self.decoded + (self.witness[at+3]-128)*16777216-2147483647-1; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_frame(&mut self) {
    self.i = 0;
    transition 0 { _ -> header() }
    state header() { transition self.i < 32 { true -> header_byte() _ -> fixed() } }
    state header_byte() {
        self.c = read_byte();
        transition self.c >= 0 { true -> header_store() _ -> bad() }
    }
    state header_store() {
        self.frame_header[self.i] = self.c; self.i = self.i + 1;
        transition 0 { _ -> header() }
    }
    state fixed() {
        transition self.frame_header[0] == 79 { true -> fixed1() _ -> bad() }
    }
    state fixed1() { transition self.frame_header[1] == 77 { true -> fixed2() _ -> bad() } }
    state fixed2() { transition self.frame_header[2] == 71 { true -> fixed3() _ -> bad() } }
    state fixed3() { transition self.frame_header[3] == 76 { true -> fixed4() _ -> bad() } }
    state fixed4() { transition self.frame_header[4] == 79 { true -> fixed5() _ -> bad() } }
    state fixed5() { transition self.frame_header[5] == 87 { true -> fixed6() _ -> bad() } }
    state fixed6() { transition self.frame_header[6] == 52 { true -> relation1() _ -> relation2_check() } }
    state relation1() { self.resolution_version = 1; self.ck3[39] = 4; transition 0 { _ -> fixed7() } }
    state relation2_check() { transition self.frame_header[6] == 53 { true -> relation2() _ -> relation3_check() } }
    state relation2() { self.resolution_version = 2; self.ck3[39] = 4; transition 0 { _ -> fixed7() } }
    state relation3_check() { transition self.frame_header[6] == 54 { true -> relation3() _ -> relation4_check() } }
    state relation3() { self.resolution_version = 3; self.ck3[39] = 5; transition 0 { _ -> fixed7() } }
    state relation4_check() { transition self.frame_header[6] == 55 { true -> relation4() _ -> relation5_check() } }
    state relation4() { self.resolution_version = 0; self.ck3[39] = 6; transition 0 { _ -> fixed7() } }
    state relation5_check() { transition self.frame_header[6] == 56 { true -> relation5() _ -> relation6_check() } }
    state relation5() { self.resolution_version = 0; self.ck3[39] = 7; transition 0 { _ -> fixed7() } }
    state relation6_check() { transition self.frame_header[6] == 57 { true -> relation6() _ -> relation7_check() } }
    state relation6() { self.resolution_version = 0; self.ck3[39] = 8; transition 0 { _ -> fixed7() } }
    state relation7_check() { transition self.frame_header[6] == 65 { true -> relation7() _ -> relation8_check() } }
    state relation7() { self.resolution_version = 0; self.ck3[39] = 9; transition 0 { _ -> fixed7() } }
    state relation8_check() { transition self.frame_header[6] == 66 { true -> relation8() _ -> relation9_check() } }
    state relation8() { self.resolution_version = 0; self.ck3[39] = 10; transition 0 { _ -> fixed7() } }
    state relation9_check() { transition self.frame_header[6] == 67 { true -> relation9() _ -> relation10_check() } }
    state relation9() { self.resolution_version = 0; self.ck3[39] = 11; transition 0 { _ -> fixed7() } }
    state relation10_check() { transition self.frame_header[6] == 68 { true -> relation10() _ -> relation11_check() } }
    state relation10() { self.resolution_version = 0; self.ck3[39] = 12; transition 0 { _ -> fixed7() } }
    state relation11_check() { transition self.frame_header[6] == 69 { true -> relation11() _ -> bad() } }
    state relation11() { self.resolution_version = 0; self.ck3[39] = 13; transition 0 { _ -> fixed7() } }
    state fixed7() { transition self.frame_header[7] == 0 { true -> version() _ -> bad() } }
    state version() { transition self.ck3[39] == 13 { true -> version14() _ -> version13_check() } }
    state version13_check() { transition self.ck3[39] == 12 { true -> version13() _ -> version12_check() } }
    state version12_check() { transition self.ck3[39] == 11 { true -> version12() _ -> version11_check() } }
    state version11_check() { transition self.ck3[39] == 10 { true -> version11() _ -> version10_check() } }
    state version10_check() { transition self.ck3[39] == 9 { true -> version10() _ -> version_digit() } }
    state version_digit() { transition self.frame_header[8] + 48 == self.frame_header[6] { true -> version1() _ -> bad() } }
    state version10() { transition self.frame_header[8] == 10 { true -> version1() _ -> bad() } }
    state version11() { transition self.frame_header[8] == 11 { true -> version1() _ -> bad() } }
    state version12() { transition self.frame_header[8] == 12 { true -> version1() _ -> bad() } }
    state version13() { transition self.frame_header[8] == 13 { true -> version1() _ -> bad() } }
    state version14() { transition self.frame_header[8] == 14 { true -> version1() _ -> bad() } }
    state version1() { transition self.frame_header[9] == 0 { true -> version2() _ -> bad() } }
    state version2() { transition self.frame_header[10] == 0 { true -> version3() _ -> bad() } }
    state version3() { transition self.frame_header[11] == 0 { true -> fixed_fields() _ -> bad() } }
    state fixed_fields() {
        transition self.frame_header[12] == 0 { true -> flags1() _ -> bad() }
    }
    state flags1() { transition self.frame_header[13] == 0 { true -> header_size0() _ -> bad() } }
    state header_size0() { transition self.frame_header[14] == 32 { true -> header_size1() _ -> bad() } }
    state header_size1() { transition self.frame_header[15] == 0 { true -> lengths() _ -> bad() } }
    state lengths() {
        self.read_header_u32(16); self.frame_total = self.decoded;
        self.read_header_u32(20); self.comp_n = self.decoded;
        self.read_header_u32(24); self.witness_n = self.decoded;
        self.read_header_u32(28);
        transition self.status == 0 { true -> relation_selector() _ -> done() }
    }
    state relation_selector() { transition self.ck3[39] >= 6 { true -> selected_relation_low() _ -> reserved() } }
    state selected_relation_low() { transition self.decoded >= 1 { true -> selected_relation_high() _ -> bad() } }
    state selected_relation_high() { transition self.decoded <= 5 { true -> selected_relation_exact() _ -> bad() } }
    state selected_relation_exact() { transition self.ck3[39] == 13 { true -> selected_relation_v5() _ -> selected_relation_v4_check() } }
    state selected_relation_v5() { transition self.decoded == 5 { true -> selected_relation() _ -> bad() } }
    state selected_relation_v4_check() { transition self.ck3[39] == 12 { true -> selected_relation_v4() _ -> selected_relation_old() } }
    state selected_relation_v4() { transition self.decoded == 4 { true -> selected_relation() _ -> bad() } }
    state selected_relation_old() { transition self.decoded <= 3 { true -> selected_relation() _ -> bad() } }
    state selected_relation() { self.resolution_version = self.decoded; transition 0 { _ -> comp_limit() } }
    state reserved() { transition self.decoded == 0 { true -> comp_limit() _ -> bad() } }
    state comp_limit() { transition self.comp_n <= 267280 { true -> witness_limit() _ -> over() } }
    state witness_limit() { transition self.witness_n <= 524288 { true -> length_room() _ -> over() } }
    state length_room() { transition self.comp_n <= 791600 - 32 - self.witness_n { true -> length_exact() _ -> bad() } }
    state length_exact() { transition self.frame_total == 32 + self.comp_n + self.witness_n { true -> comp_begin() _ -> bad() } }
    state comp_begin() { self.i = 0; transition 0 { _ -> comp() } }
    state comp() { transition self.i < self.comp_n { true -> comp_byte() _ -> witness_begin() } }
    state comp_byte() { self.c = read_byte(); transition self.c >= 0 { true -> comp_store() _ -> bad() } }
    state comp_store() { self.source[self.i] = self.c; self.i = self.i + 1; transition 0 { _ -> comp() } }
    state witness_begin() { self.i = 0; transition 0 { _ -> witness_bytes() } }
    state witness_bytes() { transition self.i < self.witness_n { true -> witness_byte() _ -> eof_probe() } }
    state witness_byte() { self.c = read_byte(); transition self.c >= 0 { true -> witness_store() _ -> bad() } }
    state witness_store() { self.witness[self.i] = self.c; self.i = self.i + 1; transition 0 { _ -> witness_bytes() } }
    state eof_probe() { self.c = read_byte(); transition self.c < 0 { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode_envelope(&mut self) {
    transition self.comp_n >= 64 { true -> magic() _ -> bad() }
    state magic() {
        transition self.source[0]==79 { true -> magic1() _ -> bad() }
    }
    state magic1() { transition self.source[1]==77 { true -> magic2() _ -> bad() } }
    state magic2() { transition self.source[2]==71 { true -> magic3() _ -> bad() } }
    state magic3() { transition self.source[3]==67 { true -> magic4() _ -> bad() } }
    state magic4() { transition self.source[4]==79 { true -> magic5() _ -> bad() } }
    state magic5() { transition self.source[5]==77 { true -> magic6() _ -> bad() } }
    state magic6() { transition self.source[6]==80 { true -> magic7() _ -> bad() } }
    state magic7() { transition self.source[7]==0 { true -> fixed() _ -> bad() } }
    state fixed() { transition self.source[8]==1 { true -> fixed1() _ -> bad() } }
    state fixed1() { transition self.source[9]==0 { true -> fixed2() _ -> bad() } }
    state fixed2() { transition self.source[10]==0 { true -> fixed3() _ -> bad() } }
    state fixed3() { transition self.source[11]==0 { true -> fixed4() _ -> bad() } }
    state fixed4() { transition self.source[12]==1 { true -> fixed5() _ -> bad() } }
    state fixed5() { transition self.source[13]==0 { true -> fixed6() _ -> bad() } }
    state fixed6() { transition self.source[14]==0 { true -> fixed7() _ -> bad() } }
    state fixed7() { transition self.source[15]==0 { true -> header() _ -> bad() } }
    state header() {
        self.read_source_u32(16); self.total_length=self.decoded;
        self.read_source_u32(20); self.bundle_length=self.decoded;
        self.read_source_u32(24); self.string_table_length=self.decoded;
        self.read_source_u32(28); self.string_count=self.decoded;
        self.read_source_u32(32); self.package_count=self.decoded;
        self.read_source_u32(36); self.source_count=self.decoded;
        self.read_source_u32(40); self.alias_count=self.decoded;
        self.read_source_u32(44); self.root_package=self.decoded;
        self.read_source_u32(48); self.root_source=self.decoded;
        self.read_source_u32(52); self.root_owner_string=self.decoded;
        self.read_source_u32(56); self.root_machine_string=self.decoded;
        transition self.status==0 { true -> reserved() _ -> done() }
    }
    state reserved() { self.read_source_u32(60); transition self.status==0 { true -> limits() _ -> done() } }
    state limits() { transition self.decoded==0 { true -> count0() _ -> bad() } }
    state count0() { transition self.package_count>=1 { true -> count1() _ -> bad() } }
    state count1() { transition self.package_count<=16 { true -> count2() _ -> over() } }
    state count2() { transition self.source_count>=1 { true -> count3() _ -> bad() } }
    state count3() { transition self.source_count<=16 { true -> count4() _ -> over() } }
    state count4() { transition self.alias_count<=32 { true -> count5() _ -> over() } }
    state count5() { transition self.string_count<=64 { true -> lengths() _ -> over() } }
    state lengths() { transition self.total_length==self.comp_n { true -> length_limits() _ -> bad() } }
    state length_limits() { transition self.total_length<=267280 { true -> offsets() _ -> over() } }
    state offsets() {
        self.package_table=64; self.source_table=64+self.package_count*48;
        self.alias_table=self.source_table+self.source_count*20;
        self.string_table=self.alias_table+self.alias_count*16;
        transition self.string_table_length<=self.total_length-self.string_table { true -> bundle_at() _ -> bad() }
    }
    state bundle_at() { self.bundle_start=self.string_table+self.string_table_length; transition self.bundle_length==self.total_length-self.bundle_start { true -> root_ranges() _ -> bad() } }
    state root_ranges() { transition self.root_package<self.package_count { true -> root_source_range() _ -> bad() } }
    state root_source_range() { transition self.root_source<self.source_count { true -> root_owner_range() _ -> bad() } }
    state root_owner_range() { transition self.root_owner_string<self.string_count { true -> root_machine_range() _ -> bad() } }
    state root_machine_range() { transition self.root_machine_string<self.string_count { true -> packages() _ -> bad() } }
    state packages() { self.i=0; self.x=0; transition 0 { _ -> package_loop() } }
    state package_loop() { transition self.i<self.package_count { true -> package_row() _ -> package_partition() } }
    state package_row() {
        self.pos=self.package_table+self.i*48; self.read_source_u32(self.pos);
        transition self.status==0 { true -> package_dense() _ -> done() }
    }
    state package_dense() { transition self.decoded==self.i { true -> package_span() _ -> bad() } }
    state package_span() {
        self.read_source_u32(self.pos+36); self.i32_backing2[436240 + self.i]=self.decoded;
        self.read_source_u32(self.pos+40); self.i32_backing2[436256 + self.i]=self.decoded;
        self.read_source_u32(self.pos+44); transition self.status==0 { true -> package_span_valid() _ -> done() }
    }
    state package_span_valid() { transition self.decoded==0 { true -> package_start() _ -> bad() } }
    state package_start() { transition self.i32_backing2[436240 + self.i]==self.x { true -> package_nonempty() _ -> bad() } }
    state package_nonempty() { transition self.i32_backing2[436256 + self.i]>=1 { true -> package_room() _ -> bad() } }
    state package_room() { transition self.i32_backing2[436256 + self.i]<=self.source_count-self.x { true -> package_next() _ -> bad() } }
    state package_next() { self.x=self.x+self.i32_backing2[436256 + self.i]; self.i=self.i+1; transition 0 { _ -> package_loop() } }
    state package_partition() { transition self.x==self.source_count { true -> sources() _ -> bad() } }
    state sources() { self.i=0; self.x=0; transition 0 { _ -> source_loop() } }
    state source_loop() { transition self.i<self.source_count { true -> source_owner_seek() _ -> aliases() } }
    state source_owner_seek() { transition self.i<self.i32_backing2[436240 + self.x]+self.i32_backing2[436256 + self.x] { true -> source_row() _ -> source_owner_next() } }
    state source_owner_next() { self.x=self.x+1; transition self.x<self.package_count { true -> source_owner_seek() _ -> bad() } }
    state source_row() { self.pos=self.source_table+self.i*20; self.read_source_u32(self.pos); transition self.status==0 { true -> source_dense() _ -> done() } }
    state source_dense() { transition self.decoded==self.i { true -> source_fields() _ -> bad() } }
    state source_fields() {
        self.read_source_u32(self.pos+4); self.i32_backing2[436272 + self.i]=self.decoded;
        self.read_source_u32(self.pos+8); self.i32_backing2[436288 + self.i]=self.decoded;
        self.read_source_u32(self.pos+12); self.i32_backing2[436304 + self.i]=self.decoded;
        self.read_source_u32(self.pos+16); transition self.status==0 { true -> source_valid() _ -> done() }
    }
    state source_valid() { transition self.i32_backing2[436272 + self.i]==self.x { true -> source_bundle_range() _ -> bad() } }
    state source_bundle_range() { transition self.i32_backing2[436288 + self.i]<self.source_count { true -> source_module_range() _ -> bad() } }
    state source_module_range() { transition self.i32_backing2[436304 + self.i]<self.string_count { true -> source_flags() _ -> bad() } }
    state source_flags() { transition self.decoded==0 { true -> source_next() _ -> bad() } }
    state source_next() { self.i=self.i+1; transition 0 { _ -> source_loop() } }
    state aliases() { self.i=0; transition 0 { _ -> alias_loop() } }
    state alias_loop() { transition self.i<self.alias_count { true -> alias_row() _ -> strings() } }
    state alias_row() {
        self.pos=self.alias_table+self.i*16;
        self.read_source_u32(self.pos); self.i32_backing2[436320 + self.i]=self.decoded;
        self.read_source_u32(self.pos+4); self.i32_backing2[436352 + self.i]=self.decoded;
        self.read_source_u32(self.pos+8); self.i32_backing2[436384 + self.i]=self.decoded;
        self.read_source_u32(self.pos+12); transition self.status==0 { true -> alias_valid() _ -> done() }
    }
    state alias_valid() { transition self.decoded==0 { true -> alias_ranges() _ -> bad() } }
    state alias_ranges() { transition self.i32_backing2[436320 + self.i]<self.package_count { true -> alias_string_range() _ -> bad() } }
    state alias_string_range() { transition self.i32_backing2[436352 + self.i]<self.string_count { true -> alias_target_range() _ -> bad() } }
    state alias_target_range() { transition self.i32_backing2[436384 + self.i]<self.package_count { true -> alias_next() _ -> bad() } }
    state alias_next() { self.i=self.i+1; transition 0 { _ -> alias_loop() } }
    state strings() { self.i=0; self.pos=self.string_table; transition 0 { _ -> string_loop() } }
    state string_loop() { transition self.i<self.string_count { true -> string_len() _ -> string_end() } }
    state string_len() { self.read_source_u32(self.pos); transition self.status==0 { true -> string_room() _ -> done() } }
    state string_room() { transition self.decoded<=self.bundle_start-self.pos-4 { true -> string_save() _ -> bad() } }
    state string_save() { self.i32_backing2[436416 + self.i]=self.pos+4; self.i32_backing2[436480 + self.i]=self.decoded; self.pos=self.pos+4+self.decoded; self.i=self.i+1; transition 0 { _ -> string_loop() } }
    state string_end() { transition self.pos==self.bundle_start { true -> bundle_header() _ -> bad() } }
    state bundle_header() { transition self.bundle_length>=16 { true -> bundle_magic() _ -> bad() } }
    state bundle_magic() { transition self.source[self.bundle_start]==79 { true -> bm1() _ -> bad() } }
    state bm1() { transition self.source[self.bundle_start+1]==77 { true -> bm2() _ -> bad() } }
    state bm2() { transition self.source[self.bundle_start+2]==71 { true -> bm3() _ -> bad() } }
    state bm3() { transition self.source[self.bundle_start+3]==48 { true -> bm4() _ -> bad() } }
    state bm4() { transition self.source[self.bundle_start+4]==66 { true -> bm5() _ -> bad() } }
    state bm5() { transition self.source[self.bundle_start+5]==78 { true -> bm6() _ -> bad() } }
    state bm6() { transition self.source[self.bundle_start+6]==68 { true -> bm7() _ -> bad() } }
    state bm7() { transition self.source[self.bundle_start+7]==76 { true -> bv0() _ -> bad() } }
    state bv0() { transition self.source[self.bundle_start+8]==1 { true -> bv1() _ -> bad() } }
    state bv1() { transition self.source[self.bundle_start+9]==0 { true -> bv2() _ -> bad() } }
    state bv2() { transition self.source[self.bundle_start+10]==0 { true -> bv3() _ -> bad() } }
    state bv3() { transition self.source[self.bundle_start+11]==0 { true -> bundle_count_read() _ -> bad() } }
    state bundle_count_read() { self.read_source_u32(self.bundle_start+12); transition self.status==0 { true -> bundle_count_valid() _ -> done() } }
    state bundle_count_valid() { transition self.decoded==self.source_count { true -> bundle_entries() _ -> bad() } }
    state bundle_entries() { self.i=0; self.pos=self.bundle_start+16; self.aggregate_source_bytes=0; transition 0 { _ -> bundle_loop() } }
    state bundle_loop() { transition self.i<self.source_count { true -> bundle_lengths() _ -> bundle_end() } }
    state bundle_lengths() {
        self.read_source_u32(self.pos); self.x=self.decoded; self.read_source_u32(self.pos+4); self.y=self.decoded;
        transition self.status==0 { true -> bundle_room0() _ -> done() }
    }
    state bundle_room0() { transition self.x<=self.total_length-self.pos-8 { true -> bundle_room1() _ -> bad() } }
    state bundle_room1() { transition self.y<=self.total_length-self.pos-8-self.x { true -> bundle_unit_limit() _ -> bad() } }
    state bundle_unit_limit() { transition self.y<=131072 { true -> bundle_aggregate_limit() _ -> over() } }
    state bundle_aggregate_limit() { transition self.y<=262144-self.aggregate_source_bytes { true -> bundle_aggregate_add() _ -> over() } }
    state bundle_aggregate_add() { self.aggregate_source_bytes=self.aggregate_source_bytes+self.y; transition 0 { _ -> bundle_save() } }
    state bundle_save() { self.i32_backing2[436544 + self.i]=self.pos+8+self.x; self.i32_backing2[436560 + self.i]=self.y; self.pos=self.pos+8+self.x+self.y; self.i=self.i+1; transition 0 { _ -> bundle_loop() } }
    state bundle_end() { transition self.pos==self.total_length { true -> map_sources() _ -> bad() } }
    state map_sources() { self.i=0; transition 0 { _ -> map_loop() } }
    state map_loop() { transition self.i<self.source_count { true -> map_one() _ -> root_owner() } }
    state map_one() { self.x=self.i32_backing2[436288 + self.i]; self.i32_backing2[436576 + self.i]=self.i32_backing2[436544 + self.x]; self.i32_backing2[436592 + self.i]=self.i32_backing2[436560 + self.x]; self.i=self.i+1; transition 0 { _ -> map_loop() } }
    state root_owner() { transition self.i32_backing2[436272 + self.root_source]==self.root_package { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::source_span_valid(&mut self, unit: i32, start: i32, count: i32) {
    self.match_ok = 0;
    transition unit >= 0 { true -> unit_high() _ -> done() }
    state unit_high() { transition unit < self.source_count { true -> start_nonnegative() _ -> done() } }
    state start_nonnegative() { transition start >= 0 { true -> start_bound() _ -> done() } }
    state start_bound() { transition start <= self.i32_backing2[436592 + unit] { true -> count_nonnegative() _ -> done() } }
    state count_nonnegative() { transition count >= 0 { true -> count_bound() _ -> done() } }
    state count_bound() { transition count <= self.i32_backing2[436592 + unit] - start { true -> yes() _ -> done() } }
    state yes() { self.match_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::source_span_equals_string(&mut self, start: i32, count: i32, string_id: i32) {
    self.match_ok = 0;
    transition string_id >= 0 { true -> string_high() _ -> done() }
    state string_high() { transition string_id < self.string_count { true -> length() _ -> done() } }
    state length() { transition count == self.i32_backing2[436480 + string_id] { true -> bytes_begin() _ -> done() } }
    state bytes_begin() { self.scan_index = 0; transition 0 { _ -> bytes() } }
    state bytes() { transition self.scan_index < count { true -> byte() _ -> yes() } }
    state byte() {
        transition self.source[start + self.scan_index] == self.source[self.i32_backing2[436416 + string_id] + self.scan_index] { true -> next() _ -> done() }
    }
    state next() { self.scan_index = self.scan_index + 1; transition 0 { _ -> bytes() } }
    state yes() { self.match_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode_witness_header(&mut self) {
    transition self.resolution_version >= 3 { true -> size3() _ -> size12() }
    state size3() { transition self.witness_n >= 84 { true -> magic0() _ -> bad() } }
    state size12() { transition self.witness_n >= 72 { true -> magic0() _ -> bad() } }
    state magic0() { transition self.witness[0] == 79 { true -> magic1() _ -> bad() } }
    state magic1() { transition self.witness[1] == 77 { true -> magic2() _ -> bad() } }
    state magic2() { transition self.witness[2] == 71 { true -> magic3() _ -> bad() } }
    state magic3() { transition self.witness[3] == 82 { true -> magic4() _ -> bad() } }
    state magic4() { transition self.witness[4] == 83 { true -> magic5() _ -> bad() } }
    state magic5() { transition self.witness[5] == 87 { true -> magic6() _ -> bad() } }
    state magic6() { transition self.witness[6] == 48 + self.resolution_version { true -> magic7() _ -> bad() } }
    state magic7() { transition self.witness[7] == 0 { true -> fixed0() _ -> bad() } }
    state fixed0() { transition self.witness[8] == self.resolution_version { true -> fixed1() _ -> bad() } }
    state fixed1() { transition self.witness[9] == 0 { true -> fixed2() _ -> bad() } }
    state fixed2() { transition self.witness[10] == 0 { true -> fixed3() _ -> bad() } }
    state fixed3() { transition self.witness[11] == 0 { true -> fixed4() _ -> bad() } }
    state fixed4() { transition self.witness[12] == 0 { true -> fixed5() _ -> bad() } }
    state fixed5() { transition self.witness[13] == 0 { true -> fixed6() _ -> bad() } }
    state fixed6() { transition self.resolution_version >= 3 { true -> fixed6_v3() _ -> fixed6_v12() } }
    state fixed6_v3() { transition self.witness[14] == 84 { true -> fixed7() _ -> bad() } }
    state fixed6_v12() { transition self.witness[14] == 72 { true -> fixed7() _ -> bad() } }
    state fixed7() { transition self.witness[15] == 0 { true -> length() _ -> bad() } }
    state length() { self.read_witness_u32(16); transition self.status == 0 { true -> length_exact() _ -> done() } }
    state length_exact() { transition self.decoded == self.witness_n { true -> counts() _ -> bad() } }
    state counts() {
        self.read_witness_u32(20); self.w_unit_count = self.decoded;
        self.read_witness_u32(24); self.w_import_count = self.decoded;
        self.read_witness_u32(28); self.w_binding_count = self.decoded;
        self.read_witness_u32(32); self.w_declaration_count = self.decoded;
        self.read_witness_u32(36); self.type_count = self.decoded;
        self.read_witness_u32(40); self.w_record_count = self.decoded;
        self.read_witness_u32(44); self.w_field_count = self.decoded;
        self.read_witness_u32(48); self.w_machine_count = self.decoded;
        self.read_witness_u32(52); self.w_machine_parameter_count = self.decoded;
        self.read_witness_u32(56); self.w_block_count = self.decoded;
        self.read_witness_u32(60); self.w_block_parameter_count = self.decoded;
        transition self.status == 0 { true -> version_counts() _ -> done() }
    }
    state version_counts() { transition self.resolution_version >= 3 { true -> counts3() _ -> counts12() } }
    state counts12() {
        self.ck3[42] = 0; self.ck3[43] = 0; self.ck3[44] = 0;
        self.read_witness_u32(64); self.witness_selected = self.decoded;
        self.read_witness_u32(68); transition self.status == 0 { true -> reserved() _ -> done() }
    }
    state counts3() {
        self.read_witness_u32(64); self.ck3[42] = self.decoded;
        self.read_witness_u32(68); self.ck3[43] = self.decoded;
        self.read_witness_u32(72); self.ck3[44] = self.decoded;
        self.read_witness_u32(76); self.witness_selected = self.decoded;
        self.read_witness_u32(80); transition self.status == 0 { true -> reserved() _ -> done() }
    }
    state reserved() { transition self.decoded == 0 { true -> ceilings0() _ -> bad() } }
    state ceilings0() { transition self.w_unit_count <= 16 { true -> ceilings1() _ -> over() } }
    state ceilings1() { transition self.w_import_count <= 64 { true -> ceilings2() _ -> over() } }
    state ceilings2() { transition self.w_binding_count <= 4096 { true -> ceilings3() _ -> over() } }
    state ceilings3() { transition self.w_declaration_count <= 256 { true -> ceilings4() _ -> over() } }
    state ceilings4() { transition self.type_count <= 2048 { true -> ceilings5() _ -> over() } }
    state ceilings5() { transition self.w_record_count <= 128 { true -> ceilings5_sum() _ -> over() } }
    state ceilings5_sum() { transition self.ck3[42] <= 128 - self.w_record_count { true -> ceilings5_cases() _ -> over() } }
    state ceilings5_cases() { transition self.ck3[43] <= 4096 { true -> ceilings5_payloads() _ -> over() } }
    state ceilings5_payloads() { transition self.ck3[44] <= 4096 { true -> ceilings5_raw_types() _ -> over() } }
    state ceilings5_raw_types() { transition self.ck3[44] <= 8192 - self.w_field_count { true -> ceilings6() _ -> over() } }
    state ceilings6() { transition self.w_field_count <= 4096 { true -> ceilings7() _ -> over() } }
    state ceilings7() { transition self.w_machine_count <= 128 { true -> ceilings8() _ -> over() } }
    state ceilings8() { transition self.w_machine_parameter_count <= 2048 { true -> ceilings9() _ -> over() } }
    state ceilings9() { transition self.w_block_count <= 2048 { true -> ceilings10() _ -> over() } }
    state ceilings10() { transition self.w_block_parameter_count <= 4096 { true -> relations() _ -> over() } }
    state relations() { transition self.w_unit_count == self.source_count { true -> version_relation() _ -> bad() } }
    state version_relation() { transition self.resolution_version == 3 { true -> version3_nonempty() _ -> version4_check() } }
    state version4_check() { transition self.resolution_version >= 4 { true -> declaration_sum() _ -> version12_empty() } }
    state version3_nonempty() { transition self.ck3[42] >= 1 { true -> declaration_sum() _ -> bad() } }
    state version12_empty() { transition self.ck3[42] == 0 { true -> declaration_sum() _ -> bad() } }
    state declaration_sum() { transition self.w_declaration_count == self.w_record_count + self.ck3[42] + self.w_machine_count { true -> offsets_header() _ -> bad() } }
    state offsets_header() { transition self.resolution_version >= 3 { true -> offsets3() _ -> offsets12() } }
    state offsets3() { self.w_units = 84; transition 0 { _ -> offsets() } }
    state offsets12() { self.w_units = 72; transition 0 { _ -> offsets() } }
    state offsets() {
        self.w_imports = self.w_units + self.w_unit_count * 36;
        self.w_bindings = self.w_imports + self.w_import_count * 48;
        self.w_declarations = self.w_bindings + self.w_binding_count * 28;
        self.w_types = self.w_declarations + self.w_declaration_count * 28;
        self.w_records = self.w_types + self.type_count * 24;
        self.w_fields = self.w_records + self.w_record_count * 24;
        self.ck3[46] = self.w_fields + self.w_field_count * 24;
        self.ck3[47] = self.ck3[46] + self.ck3[42] * 24;
        self.ck3[48] = self.ck3[47] + self.ck3[43] * 28;
        self.w_machines = self.ck3[48] + self.ck3[44] * 24;
        self.w_machine_parameters = self.w_machines + self.w_machine_count * 40;
        self.w_blocks = self.w_machine_parameters + self.w_machine_parameter_count * 24;
        self.w_block_parameters = self.w_blocks + self.w_block_count * 40;
        transition self.w_block_parameters <= self.witness_n { true -> exact() _ -> bad() }
    }
    state exact() { transition self.w_block_parameter_count * 24 == self.witness_n - self.w_block_parameters { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_units(&mut self) {
    self.i = 0; self.x = 0; self.y = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.w_unit_count { true -> row() _ -> partitions() } }
    state row() { self.table_pos = self.w_units + self.i * 36; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> owner() _ -> bad() } }
    state owner() { self.read_witness_u32(self.table_pos + 4); transition self.decoded == self.i32_backing2[436272 + self.i] { true -> module() _ -> bad() } }
    state module() { self.read_witness_u32(self.table_pos + 8); transition self.decoded == self.i32_backing2[436304 + self.i] { true -> authored_start() _ -> bad() } }
    state authored_start() { self.read_witness_u32(self.table_pos + 12); self.saved_pos = self.decoded; self.read_witness_u32(self.table_pos + 16); self.saved_tok_len = self.decoded; transition self.status == 0 { true -> authored_kind() _ -> done() } }
    state authored_kind() { transition self.saved_pos < 0 { true -> authored_absent() _ -> authored_span() } }
    state authored_absent() { transition self.saved_tok_len == 0 { true -> import_span() _ -> bad() } }
    state authored_span() { self.source_span_valid(self.i, self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> authored_equal() _ -> bad() } }
    state authored_equal() { self.source_span_equals_string(self.i32_backing2[436576 + self.i] + self.saved_pos, self.saved_tok_len, self.i32_backing2[436304 + self.i]); transition self.match_ok == 1 { true -> import_span() _ -> bad() } }
    state import_span() {
        self.read_witness_u32(self.table_pos + 20); self.i32_backing2[436608 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 24); self.i32_backing2[436624 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 28); self.i32_backing2[436640 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 32); self.i32_backing2[436656 + self.i] = self.decoded;
        transition self.status == 0 { true -> partition_start() _ -> done() }
    }
    state partition_start() { transition self.i32_backing2[436608 + self.i] == self.x { true -> import_room() _ -> bad() } }
    state import_room() { transition self.i32_backing2[436624 + self.i] <= self.w_import_count - self.x { true -> decl_start() _ -> bad() } }
    state decl_start() { transition self.i32_backing2[436640 + self.i] == self.y { true -> decl_room() _ -> bad() } }
    state decl_room() { transition self.i32_backing2[436656 + self.i] <= self.w_declaration_count - self.y { true -> next() _ -> bad() } }
    state next() { self.x = self.x + self.i32_backing2[436624 + self.i]; self.y = self.y + self.i32_backing2[436656 + self.i]; self.i = self.i + 1; transition 0 { _ -> rows() } }
    state partitions() { transition self.x == self.w_import_count { true -> declaration_partition() _ -> bad() } }
    state declaration_partition() { transition self.y == self.w_declaration_count { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_declarations(&mut self) {
    self.i = 0; self.x = 0; self.y = 0; self.k = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.w_declaration_count { true -> row() _ -> done() } }
    state row() { self.table_pos = self.w_declarations + self.i * 28; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> head() _ -> bad() } }
    state head() {
        self.i32_backing2[436928 + self.i] = self.witness[self.table_pos + 4];
        self.i32_backing2[437184 + self.i] = self.witness[self.table_pos + 5];
        transition self.witness[self.table_pos + 6] == 0 { true -> reserved1() _ -> bad() }
    }
    state reserved1() { transition self.witness[self.table_pos + 7] == 0 { true -> kind() _ -> bad() } }
    state kind() { transition self.i32_backing2[436928 + self.i] == 1 { true -> visibility() _ -> machine_kind() } }
    state machine_kind() { transition self.i32_backing2[436928 + self.i] == 2 { true -> visibility() _ -> sum_kind() } }
    state sum_kind() { transition self.i32_backing2[436928 + self.i] == 3 { true -> visibility() _ -> bad() } }
    state visibility() { transition self.i32_backing2[437184 + self.i] <= 1 { true -> fields() _ -> bad() } }
    state fields() {
        self.read_witness_u32(self.table_pos + 8); self.i32_backing2[436672 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 12); self.saved_tok = self.decoded;
        self.read_witness_u32(self.table_pos + 16); self.saved_pos = self.decoded;
        self.read_witness_u32(self.table_pos + 20); self.saved_tok_len = self.decoded;
        self.read_witness_u32(self.table_pos + 24); self.i32_backing2[437952 + self.i] = self.decoded;
        transition self.status == 0 { true -> source_range() _ -> done() }
    }
    state source_range() { transition self.i32_backing2[436672 + self.i] < self.source_count { true -> source_group() _ -> bad() } }
    state source_group() { transition self.i >= self.i32_backing2[436640 + self.i32_backing2[436672 + self.i]] { true -> source_group_end() _ -> bad() } }
    state source_group_end() { transition self.i - self.i32_backing2[436640 + self.i32_backing2[436672 + self.i]] < self.i32_backing2[436656 + self.i32_backing2[436672 + self.i]] { true -> ordinal() _ -> bad() } }
    state ordinal() { transition self.saved_tok == self.i - self.i32_backing2[436640 + self.i32_backing2[436672 + self.i]] { true -> span() _ -> bad() } }
    state span() { self.source_span_valid(self.i32_backing2[436672 + self.i], self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> span_nonempty() _ -> bad() } }
    state span_nonempty() { transition self.saved_tok_len > 0 { true -> save_span() _ -> bad() } }
    state save_span() {
        self.i32_backing2[437440 + self.i] = self.i32_backing2[436576 + self.i32_backing2[436672 + self.i]] + self.saved_pos;
        self.i32_backing2[437696 + self.i] = self.saved_tok_len;
        transition self.i32_backing2[436928 + self.i] == 1 { true -> record_id() _ -> nonrecord_id() }
    }
    state nonrecord_id() { transition self.i32_backing2[436928 + self.i] == 2 { true -> machine_id() _ -> sum_id() } }
    state record_id() { transition self.i32_backing2[437952 + self.i] == self.x { true -> record_next() _ -> bad() } }
    state record_next() { self.x = self.x + 1; transition 0 { _ -> next() } }
    state machine_id() { transition self.i32_backing2[437952 + self.i] == self.y { true -> machine_next() _ -> bad() } }
    state machine_next() { self.y = self.y + 1; transition 0 { _ -> next() } }
    state sum_id() { transition self.i32_backing2[437952 + self.i] == self.k { true -> sum_next() _ -> bad() } }
    state sum_next() { self.k = self.k + 1; transition 0 { _ -> next() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> rows() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::type_row_unique(&mut self, type_id: i32) {
    self.match_ok = 1; self.j = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.j < type_id { true -> kind() _ -> done() } }
    state kind() { transition self.i32_backing0[363080 + self.j] == self.i32_backing0[363080 + type_id] { true -> flags() _ -> next() } }
    state flags() { transition self.i32_backing1[65536 + self.j] == self.i32_backing1[65536 + type_id] { true -> payload0() _ -> next() } }
    state payload0() { transition self.i32_backing1[221824 + self.j] == self.i32_backing1[221824 + type_id] { true -> payload1() _ -> next() } }
    state payload1() { transition self.i32_backing1[230016 + self.j] == self.i32_backing1[230016 + type_id] { true -> low() _ -> next() } }
    state low() { transition self.i32_backing1[98304 + self.j] == self.i32_backing1[98304 + type_id] { true -> high() _ -> next() } }
    state high() { transition self.i32_backing1[131072 + self.j] == self.i32_backing1[131072 + type_id] { true -> duplicate() _ -> next() } }
    state duplicate() { self.match_ok = 0; transition 0 { _ -> done() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> rows() } }
    state done() { }
}

machine Main::load_types(&mut self) {
    self.i = 0; self.ck_type_count = self.type_count; self.x = 0; self.ck3[60] = 0 - 1;
    transition self.type_count >= self.w_record_count + self.ck3[42] + 2 { true -> rows() _ -> bad() }
    state rows() { transition self.i < self.type_count { true -> row() _ -> canonical_bool() } }
    state row() { self.table_pos = self.w_types + self.i * 24; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> head() _ -> bad() } }
    state head() {
        self.i32_backing0[363080 + self.i] = self.witness[self.table_pos + 4];
        self.i32_backing1[65536 + self.i] = self.witness[self.table_pos + 5];
        transition self.witness[self.table_pos + 6] == 0 { true -> reserved1() _ -> bad() }
    }
    state reserved1() { transition self.witness[self.table_pos + 7] == 0 { true -> words() _ -> bad() } }
    state words() {
        self.read_witness_u32(self.table_pos + 8); self.i32_backing1[221824 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 12); self.i32_backing1[230016 + self.i] = self.decoded;
        transition self.resolution_version==5 { true -> scalar_words_v5() _ -> scalar_words_legacy() }
    }
    state scalar_words_legacy() {
        self.read_witness_u32(self.table_pos + 16); self.i32_backing1[98304 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 20); self.i32_backing1[131072 + self.i] = self.decoded;
        transition self.status == 0 { true -> kind1() _ -> done() }
    }
    state scalar_words_v5() {
        self.read_witness_scalar_u32(self.table_pos + 16); self.i32_backing1[98304 + self.i] = self.decoded;
        self.read_witness_scalar_u32(self.table_pos + 20); self.i32_backing1[131072 + self.i] = self.decoded;
        transition self.status == 0 { true -> kind1() _ -> done() }
    }
    state kind1() { transition self.i32_backing0[363080 + self.i] == 1 { true -> scalar_flags() _ -> kind2() } }
    state kind2() { transition self.i32_backing0[363080 + self.i] == 2 { true -> scalar_flags() _ -> kind3() } }
    state kind3() { transition self.i32_backing0[363080 + self.i] == 3 { true -> bool_row() _ -> kind4() } }
    state kind4() { transition self.i32_backing0[363080 + self.i] == 4 { true -> nominal_row() _ -> kind5() } }
    state kind5() { transition self.i32_backing0[363080 + self.i] == 5 { true -> array_row() _ -> kind6() } }
    state kind6() { transition self.i32_backing0[363080 + self.i] == 6 { true -> sum_nominal_row() _ -> kind7() } }
    state kind7() { transition self.i32_backing0[363080 + self.i] == 7 { true -> slice_row() _ -> bad() } }
    state scalar_flags() { transition self.i32_backing1[65536 + self.i] <= 1 { true -> scalar_payload0() _ -> bad() } }
    state scalar_payload0() { transition self.i32_backing1[221824 + self.i] == 0 { true -> scalar_payload1() _ -> bad() } }
    state scalar_payload1() { transition self.i32_backing1[230016 + self.i] == 0 { true -> scalar_range() _ -> bad() } }
    state scalar_range() { transition self.i32_backing1[131072 + self.i] < 0 { true -> scalar_full_range() _ -> scalar_legacy_range() } }
    state scalar_full_range() { transition self.resolution_version==5 { true -> scalar_full_kind() _ -> bad() } }
    state scalar_full_kind() { transition self.i32_backing0[363080+self.i]==2 { true -> scalar_full_max() _ -> bad() } }
    state scalar_full_max() { transition self.i32_backing1[131072 + self.i]==0-1 { true -> scalar_full_low() _ -> bad() } }
    state scalar_full_low() { transition self.i32_backing1[98304 + self.i]==0 { true -> scalar_kind_bound() _ -> bad() } }
    state scalar_legacy_range() { transition self.i32_backing1[98304 + self.i] <= self.i32_backing1[131072 + self.i] { true -> scalar_kind_bound() _ -> bad() } }
    state scalar_kind_bound() { transition self.i32_backing0[363080 + self.i] == 1 { true -> u8_bound() _ -> save() } }
    state u8_bound() { transition self.i32_backing1[131072 + self.i] <= 255 { true -> save() _ -> bad() } }
    state bool_row() { transition self.i32_backing1[65536 + self.i] == 0 { true -> bool_payload0() _ -> bad() } }
    state bool_payload0() { transition self.i32_backing1[221824 + self.i] == 0 { true -> bool_payload1() _ -> bad() } }
    state bool_payload1() { transition self.i32_backing1[230016 + self.i] == 0 { true -> bool_range0() _ -> bad() } }
    state bool_range0() { transition self.i32_backing1[98304 + self.i] == 0 { true -> bool_range1() _ -> bad() } }
    state bool_range1() { transition self.i32_backing1[131072 + self.i] == 1 { true -> save() _ -> bad() } }
    state nominal_row() { transition self.i32_backing1[65536 + self.i] == 0 { true -> nominal_payload() _ -> bad() } }
    state nominal_payload() { transition self.i32_backing1[221824 + self.i] < self.w_record_count { true -> nominal_payload1() _ -> bad() } }
    state nominal_payload1() { transition self.i32_backing1[230016 + self.i] == 0 { true -> nominal_range0() _ -> bad() } }
    state nominal_range0() { transition self.i32_backing1[98304 + self.i] == 0 { true -> nominal_range1() _ -> bad() } }
    state nominal_range1() { transition self.i32_backing1[131072 + self.i] == 0 { true -> nominal_prefix() _ -> bad() } }
    state nominal_prefix() { transition self.i < self.w_record_count { true -> nominal_identity() _ -> bad() } }
    state nominal_identity() { transition self.i32_backing1[221824 + self.i] == self.i { true -> save() _ -> bad() } }
    state sum_nominal_row() { transition self.i32_backing1[65536 + self.i] == 0 { true -> sum_nominal_payload() _ -> bad() } }
    state sum_nominal_payload() { transition self.i32_backing1[221824 + self.i] < self.ck3[42] { true -> sum_nominal_payload1() _ -> bad() } }
    state sum_nominal_payload1() { transition self.i32_backing1[230016 + self.i] == 0 { true -> sum_nominal_range0() _ -> bad() } }
    state sum_nominal_range0() { transition self.i32_backing1[98304 + self.i] == 0 { true -> sum_nominal_range1() _ -> bad() } }
    state sum_nominal_range1() { transition self.i32_backing1[131072 + self.i] == 0 { true -> sum_nominal_prefix() _ -> bad() } }
    state sum_nominal_prefix() { transition self.i >= self.w_record_count { true -> sum_nominal_prefix_high() _ -> bad() } }
    state sum_nominal_prefix_high() { transition self.i < self.w_record_count + self.ck3[42] { true -> sum_nominal_identity() _ -> bad() } }
    state sum_nominal_identity() { transition self.i32_backing1[221824 + self.i] == self.i - self.w_record_count { true -> save() _ -> bad() } }
    state array_row() { transition self.i32_backing1[65536 + self.i] <= 1 { true -> array_element() _ -> bad() } }
    state array_element() { transition self.i32_backing1[221824 + self.i] < self.i { true -> array_element_not_slice() _ -> bad() } }
    state array_element_not_slice() { transition self.i32_backing0[363080 + self.i32_backing1[221824 + self.i]] == 7 { true -> bad() _ -> array_length() } }
    state array_length() { transition self.i32_backing1[230016 + self.i] <= 65536 { true -> array_range0() _ -> over() } }
    state array_range0() { transition self.i32_backing1[98304 + self.i] == 0 { true -> array_range1() _ -> bad() } }
    state array_range1() { transition self.i32_backing1[131072 + self.i] == 0 { true -> save() _ -> bad() } }
    state slice_row() { transition self.resolution_version == 4 { true -> slice_flags() _ -> bad() } }
    state slice_flags() { transition self.i32_backing1[65536 + self.i] == 0 { true -> slice_payload_range() _ -> bad() } }
    state slice_payload_range() { transition self.i32_backing1[221824 + self.i] < self.i { true -> slice_element_kind() _ -> bad() } }
    state slice_element_kind() { transition self.i32_backing0[363080 + self.i32_backing1[221824 + self.i]] == 1 { true -> slice_element_flags() _ -> bad() } }
    state slice_element_flags() { transition self.i32_backing1[65536 + self.i32_backing1[221824 + self.i]] == 0 { true -> slice_element_payload0() _ -> bad() } }
    state slice_element_payload0() { transition self.i32_backing1[221824 + self.i32_backing1[221824 + self.i]] == 0 { true -> slice_element_payload1() _ -> bad() } }
    state slice_element_payload1() { transition self.i32_backing1[230016 + self.i32_backing1[221824 + self.i]] == 0 { true -> slice_element_low() _ -> bad() } }
    state slice_element_low() { transition self.i32_backing1[98304 + self.i32_backing1[221824 + self.i]] == 0 { true -> slice_element_high() _ -> bad() } }
    state slice_element_high() { transition self.i32_backing1[131072 + self.i32_backing1[221824 + self.i]] == 255 { true -> slice_payload1() _ -> bad() } }
    state slice_payload1() { transition self.i32_backing1[230016 + self.i] == 0 { true -> slice_low() _ -> bad() } }
    state slice_low() { transition self.i32_backing1[98304 + self.i] == 0 { true -> slice_high() _ -> bad() } }
    state slice_high() { transition self.i32_backing1[131072 + self.i] == 0 { true -> slice_unique() _ -> bad() } }
    state slice_unique() { transition self.ck3[60] < 0 { true -> slice_save() _ -> bad() } }
    state slice_save() { self.ck3[60] = self.i; transition 0 { _ -> save() } }
    state save() {
        self.i32_backing0[461384 + self.i] = self.i32_backing1[221824 + self.i];
        self.i32_backing1[0 + self.i] = self.i32_backing1[221824 + self.i];
        self.i32_backing1[32768 + self.i] = self.i32_backing1[230016 + self.i];
        self.i32_backing1[205440 + self.i] = self.i32_backing0[363080 + self.i]; self.i32_backing1[213632 + self.i] = self.i32_backing1[65536 + self.i];
        self.i32_backing1[238208 + self.i] = self.i32_backing1[98304 + self.i]; self.i32_backing1[246400 + self.i] = self.i32_backing1[131072 + self.i];
        self.i32_backing1[172544 + self.i] = self.i;
        self.type_row_unique(self.i); transition self.match_ok == 1 { true -> next() _ -> bad() }
    }
    state next() { self.i = self.i + 1; transition 0 { _ -> rows() } }
    state canonical_bool() { self.ck_bool_type = self.w_record_count + self.ck3[42]; transition self.i32_backing0[363080 + self.ck_bool_type] == 3 { true -> canonical_u32() _ -> bad() } }
    state canonical_u32() { self.ck_u32_full_type = self.w_record_count + self.ck3[42] + 1; transition self.i32_backing0[363080 + self.ck_u32_full_type] == 2 { true -> u32_low() _ -> bad() } }
    state u32_low() { transition self.i32_backing1[98304 + self.ck_u32_full_type] == 0 { true -> u32_high() _ -> bad() } }
    state u32_high() { transition self.resolution_version==5 { true -> u32_high_v5() _ -> u32_high_legacy() } }
    state u32_high_v5() { transition self.i32_backing1[131072 + self.ck_u32_full_type] == 0-1 { true -> trapping_begin() _ -> bad() } }
    state u32_high_legacy() { transition self.i32_backing1[131072 + self.ck_u32_full_type] == 2147483647 { true -> trapping_begin() _ -> bad() } }
    state trapping_begin() { transition self.resolution_version >= 4 { true -> slice_optional() _ -> trapping_setup() } }
    state slice_optional() { transition self.resolution_version==4 { true -> slice_required() _ -> trapping_setup() } }
    state slice_required() { transition self.ck3[60] >= 0 { true -> trapping_setup() _ -> bad() } }
    state trapping_setup() { self.ck3[50] = 0 - 1; self.i = 0; transition 0 { _ -> trapping_rows() } }
    state trapping_rows() { transition self.i < self.type_count { true -> trapping_kind() _ -> done() } }
    state trapping_kind() { transition self.i32_backing0[363080 + self.i] == 2 { true -> trapping_flag() _ -> trapping_next() } }
    state trapping_flag() { transition self.i32_backing1[65536 + self.i] == 1 { true -> trapping_payload0() _ -> trapping_next() } }
    state trapping_payload0() { transition self.i32_backing1[221824 + self.i] == 0 { true -> trapping_payload1() _ -> trapping_next() } }
    state trapping_payload1() { transition self.i32_backing1[230016 + self.i] == 0 { true -> trapping_low() _ -> trapping_next() } }
    state trapping_low() { transition self.i32_backing1[98304 + self.i] == 0 { true -> trapping_high() _ -> trapping_next() } }
    state trapping_high() { transition self.resolution_version==5 { true -> trapping_high_v5() _ -> trapping_high_legacy() } }
    state trapping_high_v5() { transition self.i32_backing1[131072 + self.i] == 0-1 { true -> trapping_found() _ -> trapping_next() } }
    state trapping_high_legacy() { transition self.i32_backing1[131072 + self.i] == 2147483647 { true -> trapping_found() _ -> trapping_next() } }
    state trapping_found() { self.ck3[50] = self.i; transition 0 { _ -> done() } }
    state trapping_next() { self.i = self.i + 1; transition 0 { _ -> trapping_rows() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_records(&mut self) {
    self.data_count = self.w_record_count; self.i = 0; self.x = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.data_count { true -> row() _ -> partition() } }
    state row() { self.table_pos = self.w_records + self.i * 24; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> declaration() _ -> bad() } }
    state declaration() { self.read_witness_u32(self.table_pos + 4); self.i32_backing2[438208 + self.i] = self.decoded; transition self.decoded < self.w_declaration_count { true -> declaration_kind() _ -> bad() } }
    state declaration_kind() { transition self.i32_backing2[436928 + self.i32_backing2[438208 + self.i]] == 1 { true -> declaration_id() _ -> bad() } }
    state declaration_id() { transition self.i32_backing2[437952 + self.i32_backing2[438208 + self.i]] == self.i { true -> nominal() _ -> bad() } }
    state nominal() { self.read_witness_u32(self.table_pos + 8); self.i32_backing1[205312 + self.i] = self.decoded; transition self.decoded == self.i { true -> nominal_kind() _ -> bad() } }
    state nominal_kind() { transition self.i32_backing0[363080 + self.i] == 4 { true -> nominal_payload() _ -> bad() } }
    state nominal_payload() { transition self.i32_backing0[461384 + self.i] == self.i { true -> span() _ -> bad() } }
    state span() {
        self.read_witness_u32(self.table_pos + 12); self.i32_backing0[456 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 16); self.i32_backing0[584 + self.i] = self.decoded;
        transition self.status == 0 { true -> span_start() _ -> done() }
    }
    state span_start() { transition self.i32_backing0[456 + self.i] == self.x { true -> span_room() _ -> bad() } }
    state span_room() { transition self.i32_backing0[584 + self.i] <= self.w_field_count - self.x { true -> flags() _ -> bad() } }
    state flags() { self.i32_backing0[328 + self.i] = self.witness[self.table_pos + 20]; transition self.i32_backing0[328 + self.i] <= 1 { true -> reserved0() _ -> bad() } }
    state reserved0() { transition self.witness[self.table_pos + 21] == 0 { true -> reserved1() _ -> bad() } }
    state reserved1() { transition self.witness[self.table_pos + 22] == 0 { true -> reserved2() _ -> bad() } }
    state reserved2() { transition self.witness[self.table_pos + 23] == 0 { true -> names() _ -> bad() } }
    state names() {
        self.i32_backing0[72 + self.i] = self.i32_backing2[437440 + self.i32_backing2[438208 + self.i]];
        self.i32_backing0[200 + self.i] = self.i32_backing2[437696 + self.i32_backing2[438208 + self.i]];
        self.i32_backing1[163840 + self.i] = 0;
        self.x = self.x + self.i32_backing0[584 + self.i]; self.i = self.i + 1;
        transition 0 { _ -> rows() }
    }
    state partition() { transition self.x == self.w_field_count { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_fields(&mut self) {
    self.field_count = self.w_field_count; self.i = 0; self.x = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.field_count { true -> owner_seek() _ -> done() } }
    state owner_seek() { transition self.i < self.i32_backing0[456 + self.x] + self.i32_backing0[584 + self.x] { true -> row() _ -> owner_next() } }
    state owner_next() { self.x = self.x + 1; transition self.x < self.data_count { true -> owner_seek() _ -> bad() } }
    state row() { self.table_pos = self.w_fields + self.i * 24; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> owner() _ -> bad() } }
    state owner() { self.read_witness_u32(self.table_pos + 4); self.i32_backing0[712 + self.i] = self.decoded; transition self.decoded == self.x { true -> ordinal() _ -> bad() } }
    state ordinal() { self.read_witness_u32(self.table_pos + 8); transition self.decoded == self.i - self.i32_backing0[456 + self.x] { true -> type_id() _ -> bad() } }
    state type_id() { self.read_witness_u32(self.table_pos + 12); self.i32_backing0[25288 + self.i] = self.decoded; transition self.decoded < self.type_count { true -> type_not_slice() _ -> bad() } }
    state type_not_slice() { transition self.i32_backing0[363080 + self.i32_backing0[25288 + self.i]] == 7 { true -> bad() _ -> name() } }
    state name() { self.read_witness_u32(self.table_pos + 16); self.saved_pos = self.decoded; self.read_witness_u32(self.table_pos + 20); self.saved_tok_len = self.decoded; transition self.status == 0 { true -> span() _ -> done() } }
    state span() {
        self.source_span_valid(self.i32_backing2[436672 + self.i32_backing2[438208 + self.x]], self.saved_pos, self.saved_tok_len);
        transition self.match_ok == 1 { true -> nonempty() _ -> bad() }
    }
    state nonempty() { transition self.saved_tok_len > 0 { true -> save() _ -> bad() } }
    state save() {
        self.i32_backing0[8904 + self.i] = self.i32_backing2[436576 + self.i32_backing2[436672 + self.i32_backing2[438208 + self.x]]] + self.saved_pos;
        self.i32_backing0[17096 + self.i] = self.saved_tok_len;
        self.i = self.i + 1; transition 0 { _ -> rows() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_sums(&mut self) {
    self.sum_count = self.ck3[42]; self.i = 0; self.x = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.sum_count { true -> row() _ -> partition() } }
