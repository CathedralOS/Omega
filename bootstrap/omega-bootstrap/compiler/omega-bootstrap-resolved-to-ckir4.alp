    //   [65536..98304) type_trapping (32768)
    //   [98304..131072) type_range_los (32768)
    //   [131072..163840) type_range_his (32768)
    //   [163840..163968) data_layout_states (128)
    //   [163968..164096) data_zero_states (128)
    //   [164096..164224) data_layout_sizes (128)
    //   [164224..164352) data_layout_alignments (128)
    //   [164352..172544) field_layout_offsets (8192)
    //   [172544..205312) old_type_ck_ids (32768)
    //   [205312..205440) data_nominal_ck_types (128)
    //   [205440..213632) ck_type_kinds (8192)
    //   [213632..221824) ck_type_flags (8192)
    //   [221824..230016) ck_type_payload0 (8192)
    //   [230016..238208) ck_type_payload1 (8192)
    //   [238208..246400) ck_type_los (8192)
    //   [246400..254592) ck_type_his (8192)
    //   [254592..254720) machine_block_starts (128)
    //   [254720..254848) machine_block_counts (128)
    //   [254848..254976) machine_entry_blocks (128)
    //   [254976..271360) state_block_ids (16384)
    //   [271360..273408) block_owner_machines (2048)
    //   [273408..275456) block_receiver_access (2048)
    //   [275456..277504) block_param_starts (2048)
    //   [277504..279552) block_param_counts (2048)
    //   [279552..281600) block_op_starts (2048)
    //   [281600..283648) block_op_counts (2048)
    //   [283648..316416) op_owner_machines (32768)
    //   [316416..349184) op_owner_blocks (32768)
    //   [349184..381952) op_codes (32768)
    //   [381952..414720) op_result_kinds (32768)
    //   [414720..447488) op_result_ids (32768)
    //   [447488..480256) op_result_types (32768)
    //   [480256..513024) op_operand_starts (32768)
    // backing 2: 453256 / 524288 cells
