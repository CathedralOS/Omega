    state plus() { self.comparison_opcode=8; self.push_expression(); transition self.status == 0 { true -> right() _ -> done() } }
    state subtract() { self.comparison_opcode=26; self.push_expression(); transition self.status == 0 { true -> right() _ -> done() } }
    state right() { self.next_token(); self.parse_integer_widen(); transition self.status == 0 { true -> restore() _ -> done() } }
    state restore() { self.saved_pos = self.expr_tree_depth; self.pop_left_expression(); transition self.comparison_opcode==26 { true -> subtract_combine() _ -> combine_plus() } }
    state combine_plus() { self.combine_add(); transition self.status==0 { true -> loop() _ -> done() } }
    state subtract_combine() { self.combine_subtract(); transition self.status==0 { true -> loop() _ -> done() } }
    state done() { }
