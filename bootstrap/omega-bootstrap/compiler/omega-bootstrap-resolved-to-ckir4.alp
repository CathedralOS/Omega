// The selected V13 surface is deliberately exact: a named shared-byte state
// parameter guarded by `.len > 0`, with authored true arguments `[0]` and
// `[1..]` from that same parameter. Syntax is validated here without emitting
// either partial operation in the predecessor block.
machine Main::parse_slice_nonempty_transition(&mut self) {
    self.arm_true = 0; self.arm_false = 0; self.ck3[62] = 0 - 1; self.ck3[63] = 0 - 1;
