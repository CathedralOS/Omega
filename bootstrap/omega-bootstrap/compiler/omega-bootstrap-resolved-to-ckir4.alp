    //   [495688..496200) runtime_field_seen (8 * 64)
    //   [496200..496208) runtime_all_constant (8)
    //   [496208..496216) runtime_array_literal (8)
    //   [496216..496224) runtime_after_pos (8)
    //   [496224..496232) runtime_after_tok (8)
    //   [496232..496240) runtime_after_tok_start (8)
    //   [496240..496248) runtime_after_tok_len (8)
