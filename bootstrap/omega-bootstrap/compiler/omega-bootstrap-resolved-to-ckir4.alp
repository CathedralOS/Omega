machine Main::load_machines(&mut self) {
    self.machine_count = self.w_machine_count; self.machine_parameter_count = self.w_machine_parameter_count;
    self.i = 0; self.x = 0; self.y = 0; self.state_count = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.machine_count { true -> row() _ -> partitions() } }
    state row() { self.table_pos = self.w_machines + self.i * 40; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> declaration() _ -> bad() } }
    state declaration() { self.read_witness_u32(self.table_pos + 4); self.i32_backing2[438336 + self.i] = self.decoded; transition self.decoded < self.w_declaration_count { true -> declaration_kind() _ -> bad() } }
    state declaration_kind() { transition self.i32_backing2[436928 + self.i32_backing2[438336 + self.i]] == 2 { true -> declaration_id() _ -> bad() } }
    state declaration_id() { transition self.i32_backing2[437952 + self.i32_backing2[438336 + self.i]] == self.i { true -> owner() _ -> bad() } }
    state owner() { self.read_witness_u32(self.table_pos + 8); self.i32_backing0[33736 + self.i] = self.decoded; transition self.decoded < self.data_count { true -> access() _ -> bad() } }
    state access() { self.i32_backing0[34504 + self.i] = self.witness[self.table_pos + 12] - 1; transition self.i32_backing0[34504 + self.i] >= 0 { true -> access_high() _ -> bad() } }
    state access_high() { transition self.i32_backing0[34504 + self.i] <= 1 { true -> flags() _ -> bad() } }
    state flags() { transition self.witness[self.table_pos + 13] == 0 { true -> reserved0() _ -> bad() } }
    state reserved0() { transition self.witness[self.table_pos + 14] == 0 { true -> reserved1() _ -> bad() } }
    state reserved1() { transition self.witness[self.table_pos + 15] == 0 { true -> result() _ -> bad() } }
    state result() { self.read_witness_u32(self.table_pos + 16); self.i32_backing0[34376 + self.i] = self.decoded; transition self.decoded < 0 { true -> spans() _ -> result_range() } }
    state result_range() { transition self.i32_backing0[34376 + self.i] < self.type_count { true -> result_scalar() _ -> bad() } }
    state result_scalar() { transition self.i32_backing0[363080 + self.i32_backing0[34376 + self.i]] < 4 { true -> spans() _ -> bad() } }
    state spans() {
        self.read_witness_u32(self.table_pos + 20); self.i32_backing0[34120 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 24); self.i32_backing0[34248 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 28); self.i32_backing1[254592 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 32); self.i32_backing1[254720 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 36); self.i32_backing1[254848 + self.i] = self.decoded;
        transition self.status == 0 { true -> param_start() _ -> done() }
    }
    state param_start() { transition self.i32_backing0[34120 + self.i] == self.x { true -> param_count() _ -> bad() } }
    state param_count() { transition self.i32_backing0[34248 + self.i] <= 7 { true -> param_room() _ -> bad() } }
    state param_room() { transition self.i32_backing0[34248 + self.i] <= self.w_machine_parameter_count - self.x { true -> block_start() _ -> bad() } }
    state block_start() { transition self.i32_backing1[254592 + self.i] == self.y { true -> block_nonempty() _ -> bad() } }
    state block_nonempty() { transition self.i32_backing1[254720 + self.i] >= 1 { true -> block_per_machine() _ -> bad() } }
    state block_per_machine() { transition self.i32_backing1[254720 + self.i] <= 128 { true -> block_room() _ -> over() } }
    state block_room() { transition self.i32_backing1[254720 + self.i] <= self.w_block_count - self.y { true -> entry() _ -> bad() } }
    state entry() { transition self.i32_backing1[254848 + self.i] == self.i32_backing1[254592 + self.i] { true -> save() _ -> bad() } }
    state save() {
        self.i32_backing2[438464 + self.i] = self.i32_backing2[436672 + self.i32_backing2[438336 + self.i]];
        self.i32_backing0[34632 + self.i] = self.i32_backing1[205312 + self.i32_backing0[33736 + self.i]];
        self.i32_backing0[35144 + self.i] = self.state_count;
        self.i32_backing0[35272 + self.i] = self.i32_backing1[254720 + self.i] - 1;
        self.state_count = self.state_count + self.i32_backing0[35272 + self.i];
