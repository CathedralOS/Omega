    state pub_terminator_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_terminator_machine_check() { transition self.j == 1 { true -> pub_terminator_machine() _ -> pub_terminator_block_check() } }
    state pub_terminator_machine() { self.c = self.i32_backing1[271360 + self.i]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_terminator_block_check() { transition self.j == 2 { true -> pub_terminator_block() _ -> pub_terminator_head_check() } }
    state pub_terminator_block() { self.c = self.i; self.j = 3; transition 0 { _ -> pub_shared_word0() } }
    state pub_terminator_head_check() { transition self.j == 3 { true -> pub_terminator_head() _ -> pub_terminator_value_check() } }
    state pub_terminator_head() { write_byte(self.i32_backing2[376848 + self.i]); transition self.ck3[39] >= 5 { true -> pub_terminator_head_v5() _ -> pub_terminator_head_v4() } }
    state pub_terminator_head_v4() { write_byte(0); write_byte(0); write_byte(0); self.j = 4; transition 0 { _ -> pub_terminator_select() } }
