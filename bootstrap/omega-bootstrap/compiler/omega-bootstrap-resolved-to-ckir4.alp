    state param_count_row() { transition self.i32_backing1[277504 + self.i] == self.i32_backing2[451200 + self.i] { true -> next() _ -> bad() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> rows() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_copy_records(&mut self) {
