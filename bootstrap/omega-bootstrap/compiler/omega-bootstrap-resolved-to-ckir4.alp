    state ordinal() { self.read_witness_u32(self.table_pos + 8); transition self.decoded == self.i - self.i32_backing2[436608 + self.x] { true -> path() _ -> bad() } }
    state path() { self.read_witness_u32(self.table_pos + 12); self.saved_pos = self.decoded; self.read_witness_u32(self.table_pos + 16); self.saved_tok_len = self.decoded; transition self.status == 0 { true -> path_span() _ -> done() } }
    state path_span() { self.source_span_valid(self.x, self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> path_nonempty() _ -> bad() } }
    state path_nonempty() { transition self.saved_tok_len > 0 { true -> head() _ -> bad() } }
    state head() { self.y = self.witness[self.table_pos + 20]; self.i32_backing2[438784 + self.i] = self.witness[self.table_pos + 21]; transition self.witness[self.table_pos + 22] == 0 { true -> reserved1() _ -> bad() } }
    state reserved1() { transition self.witness[self.table_pos + 23] == 0 { true -> words() _ -> bad() } }
    state words() {
        self.read_witness_u32(self.table_pos + 24); self.saved_tok = self.decoded;
        self.read_witness_u32(self.table_pos + 28); self.current_data = self.decoded;
        self.read_witness_u32(self.table_pos + 32); self.current_state = self.decoded;
        self.read_witness_u32(self.table_pos + 36); self.i32_backing2[438848 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 40); self.saved_pos = self.decoded;
        self.read_witness_u32(self.table_pos + 44); self.saved_tok_len = self.decoded;
        transition self.status == 0 { true -> ranges() _ -> done() }
    }
    state ranges() { transition self.current_data < self.package_count { true -> module_range() _ -> bad() } }
    state module_range() { transition self.current_state < self.string_count { true -> declaration_range() _ -> bad() } }
    state declaration_range() { transition self.i32_backing2[438848 + self.i] < self.w_declaration_count { true -> kind() _ -> bad() } }
    state kind() { transition self.i32_backing2[438784 + self.i] == self.i32_backing2[436928 + self.i32_backing2[438848 + self.i]] { true -> kind_value() _ -> bad() } }
    state kind_value() { transition self.i32_backing2[438784 + self.i] == 1 { true -> target_owner() _ -> machine_kind() } }
    state machine_kind() { transition self.i32_backing2[438784 + self.i] == 2 { true -> target_owner() _ -> sum_kind() } }
    state sum_kind() { transition self.i32_backing2[438784 + self.i] == 3 { true -> target_owner() _ -> bad() } }
    state target_owner() { transition self.i32_backing2[436272 + self.i32_backing2[436672 + self.i32_backing2[438848 + self.i]]] == self.current_data { true -> target_module() _ -> bad() } }
    state target_module() { transition self.i32_backing2[436304 + self.i32_backing2[436672 + self.i32_backing2[438848 + self.i]]] == self.current_state { true -> visibility() _ -> bad() } }
    state visibility() { transition self.current_data == self.i32_backing2[436272 + self.x] { true -> origin() _ -> public_required() } }
    state public_required() { transition self.i32_backing2[437184 + self.i32_backing2[438848 + self.i]] == 1 { true -> origin() _ -> bad() } }
    state origin() { transition self.y == 0 { true -> same_package() _ -> alias_origin() } }
    state same_package() { transition self.saved_tok < 0 { true -> same_owner() _ -> bad() } }
    state same_owner() { transition self.current_data == self.i32_backing2[436272 + self.x] { true -> local_span() _ -> bad() } }
    state alias_origin() { transition self.y == 1 { true -> alias_range() _ -> bad() } }
    state alias_range() { transition self.saved_tok >= 0 { true -> alias_high() _ -> bad() } }
    state alias_high() { transition self.saved_tok < self.alias_count { true -> alias_requester() _ -> bad() } }
    state alias_requester() { transition self.i32_backing2[436320 + self.saved_tok] == self.i32_backing2[436272 + self.x] { true -> alias_target() _ -> bad() } }
    state alias_target() { transition self.i32_backing2[436384 + self.saved_tok] == self.current_data { true -> local_span() _ -> bad() } }
    state local_span() { self.source_span_valid(self.x, self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> local_nonempty() _ -> bad() } }
    state local_nonempty() { transition self.saved_tok_len > 0 { true -> next() _ -> bad() } }
