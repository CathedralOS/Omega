machine Main::type_is_copy(&mut self, type_id: i32) {
    self.match_ok = 1;
    transition self.i32_backing0[363080 + type_id] == 4 { true -> nominal() _ -> sum_check() }
    state nominal() { transition self.i32_backing0[328 + self.i32_backing0[461384 + type_id]] == 1 { true -> done() _ -> no() } }
    state sum_check() { transition self.i32_backing0[363080 + type_id] == 6 { true -> sum() _ -> array() } }
    state sum() { transition self.i32_backing0[328 + self.data_count + self.i32_backing0[461384 + type_id]] == 1 { true -> done() _ -> no() } }
    state array() { transition self.i32_backing0[363080 + type_id] == 5 { true -> array_element() _ -> done() } }
    state array_element() { self.type_is_copy(self.i32_backing1[0 + type_id]); transition self.match_ok == 1 { true -> done() _ -> no() } }
    state no() { self.match_ok = 0; }
    state done() { }
}

machine Main::layout_type(&mut self, type_id: i32) {
    self.layout_size = 0; self.layout_alignment = 1; self.match_ok = 1;
    transition self.i32_backing0[363080 + type_id] == 1 { true -> byte_scalar() _ -> u32_check() }
    state byte_scalar() { self.layout_size = 1; transition 0 { _ -> done() } }
    state u32_check() { transition self.i32_backing0[363080 + type_id] == 2 { true -> u32_scalar() _ -> bool_check() } }
    state u32_scalar() { self.layout_size = 4; self.layout_alignment = 4; transition 0 { _ -> done() } }
    state bool_check() { transition self.i32_backing0[363080 + type_id] == 3 { true -> byte_scalar() _ -> nominal_check() } }
    state nominal_check() { transition self.i32_backing0[363080 + type_id] == 4 { true -> nominal_ready() _ -> sum_check() } }
    state nominal_ready() {
        transition self.i32_backing1[163840 + self.i32_backing0[461384 + type_id]] == 2 { true -> nominal_result() _ -> unavailable() }
    }
    state nominal_result() {
        self.layout_size = self.i32_backing1[164096 + self.i32_backing0[461384 + type_id]];
        self.layout_alignment = self.i32_backing1[164224 + self.i32_backing0[461384 + type_id]];
        transition 0 { _ -> done() }
    }
    state sum_check() { transition self.i32_backing0[363080 + type_id] == 6 { true -> sum_ready() _ -> array_check() } }
    state sum_ready() { transition self.i32_backing1[163840 + self.data_count + self.i32_backing0[461384 + type_id]] == 2 { true -> sum_result() _ -> unavailable() } }
    state sum_result() {
        self.layout_size = self.i32_backing1[164096 + self.data_count + self.i32_backing0[461384 + type_id]];
        self.layout_alignment = self.i32_backing1[164224 + self.data_count + self.i32_backing0[461384 + type_id]];
        transition 0 { _ -> done() }
    }
    state array_check() { transition self.i32_backing0[363080 + type_id] == 5 { true -> array() _ -> slice_check() } }
    state slice_check() { transition self.i32_backing0[363080 + type_id] == 7 { true -> slice() _ -> bad() } }
    state slice() { self.layout_size = 16; self.layout_alignment = 8; transition 0 { _ -> done() } }
    state array() {
        self.layout_type(self.i32_backing1[0 + type_id]);
        transition self.status == 0 { true -> array_ready() _ -> done() }
    }
    state array_ready() { transition self.match_ok == 1 { true -> array_count() _ -> done() } }
    state array_count() { transition self.i32_backing1[32768 + type_id] == 0 { true -> array_zero() _ -> array_bound() } }
    state array_zero() { self.layout_size = 0; transition 0 { _ -> done() } }
    state array_bound() {
        transition self.layout_size <= 131072 / self.i32_backing1[32768 + type_id] { true -> array_size() _ -> exhausted() }
    }
    state array_size() {
        self.layout_size = self.layout_size * self.i32_backing1[32768 + type_id];
        transition 0 { _ -> done() }
    }
    state unavailable() { self.match_ok = 0; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::layout_data_value(&mut self, data_id: i32) {
    self.depth = 0; self.path_depth = 1;
    self.saved_pos = self.i32_backing0[456 + data_id];
    self.saved_tok = self.saved_pos + self.i32_backing0[584 + data_id];
    self.match_ok = 1;
    transition 0 { _ -> fields() }
    state fields() { transition self.saved_pos < self.saved_tok { true -> field_type() _ -> finish_padding() } }
    state field_type() {
        self.layout_type(self.i32_backing0[25288 + self.saved_pos]);
        transition self.status == 0 { true -> field_ready() _ -> done() }
    }
    state field_ready() { transition self.match_ok == 1 { true -> field_alignment() _ -> done() } }
    state field_alignment() {
        transition self.layout_alignment > self.path_depth { true -> maximum() _ -> padding() }
    }
    state maximum() { self.path_depth = self.layout_alignment; transition 0 { _ -> padding() } }
    state padding() {
        self.layout_padding = (self.layout_alignment - self.depth % self.layout_alignment) % self.layout_alignment;
        transition self.depth <= 131072 - self.layout_padding { true -> aligned() _ -> exhausted() }
    }
    state aligned() {
        self.depth = self.depth + self.layout_padding;
        self.i32_backing1[164352 + self.saved_pos] = self.depth;
        transition self.layout_size <= 131072 - self.depth { true -> placed() _ -> exhausted() }
    }
    state placed() {
        self.depth = self.depth + self.layout_size; self.saved_pos = self.saved_pos + 1;
        transition 0 { _ -> fields() }
    }
    state finish_padding() {
        self.layout_padding = (self.path_depth - self.depth % self.path_depth) % self.path_depth;
        transition self.depth <= 131072 - self.layout_padding { true -> finish() _ -> exhausted() }
    }
    state finish() {
        self.i32_backing1[164096 + data_id] = self.depth + self.layout_padding;
        self.i32_backing1[164224 + data_id] = self.path_depth;
        self.i32_backing1[163840 + data_id] = 2;
        transition 0 { _ -> done() }
    }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::layout_sum_value(&mut self, sum_id: i32) {
    // depth/path_depth retain the maximum case payload size/alignment. Each
    // case owns a declaration-order layout beginning at a case-local zero.
    self.depth = 0; self.path_depth = 1;
    self.saved_pos = self.i32_backing0[456 + self.data_count + sum_id];
    self.saved_tok_len = self.saved_pos + self.i32_backing0[584 + self.data_count + sum_id];
    self.match_ok = 1;
    transition 0 { _ -> cases() }
    state cases() { transition self.saved_pos < self.saved_tok_len { true -> case_begin() _ -> payload_base() } }
    state case_begin() {
        self.k = 0; self.saved_tok_start = 1;
        self.x = self.i32_backing0[70216 + self.saved_pos];
        self.y = self.x + self.i32_backing0[86600 + self.saved_pos];
        transition 0 { _ -> payloads() }
    }
    state payloads() { transition self.x < self.y { true -> payload_type() _ -> case_finish_padding() } }
    state payload_type() { self.layout_type(self.i32_backing0[17096 + self.field_count + self.x]); transition self.status == 0 { true -> payload_ready() _ -> done() } }
    state payload_ready() { transition self.match_ok == 1 { true -> payload_alignment() _ -> done() } }
    state payload_alignment() { transition self.layout_alignment > self.saved_tok_start { true -> payload_maximum() _ -> payload_padding() } }
    state payload_maximum() { self.saved_tok_start = self.layout_alignment; transition 0 { _ -> payload_padding() } }
    state payload_padding() {
        self.layout_padding = (self.layout_alignment - self.k % self.layout_alignment) % self.layout_alignment;
        transition self.k <= 131072 - self.layout_padding { true -> payload_aligned() _ -> exhausted() }
    }
    state payload_aligned() {
        self.k = self.k + self.layout_padding; self.i32_backing0[365128 + self.x] = self.k;
        transition self.layout_size <= 131072 - self.k { true -> payload_placed() _ -> exhausted() }
    }
    state payload_placed() { self.k = self.k + self.layout_size; self.x = self.x + 1; transition 0 { _ -> payloads() } }
    state case_finish_padding() {
        self.layout_padding = (self.saved_tok_start - self.k % self.saved_tok_start) % self.saved_tok_start;
        transition self.k <= 131072 - self.layout_padding { true -> case_finish() _ -> exhausted() }
    }
    state case_finish() {
        self.i32_backing0[135752 + self.saved_pos] = self.k + self.layout_padding;
        self.i32_backing0[152136 + self.saved_pos] = self.saved_tok_start;
        transition self.i32_backing0[135752 + self.saved_pos] > self.depth { true -> case_size_max() _ -> case_align_check() }
    }
    state case_size_max() { self.depth = self.i32_backing0[135752 + self.saved_pos]; transition 0 { _ -> case_align_check() } }
    state case_align_check() { transition self.saved_tok_start > self.path_depth { true -> case_align_max() _ -> case_next() } }
    state case_align_max() { self.path_depth = self.saved_tok_start; transition 0 { _ -> case_next() } }
    state case_next() { self.saved_pos = self.saved_pos + 1; transition 0 { _ -> cases() } }
    state payload_base() {
        self.layout_padding = (self.path_depth - 4 % self.path_depth) % self.path_depth;
        self.i32_backing0[463432 + sum_id] = 4 + self.layout_padding;
        transition self.depth <= 131072 - self.i32_backing0[463432 + sum_id] { true -> total_unrounded() _ -> exhausted() }
    }
    state total_unrounded() { self.k = self.i32_backing0[463432 + sum_id] + self.depth; transition self.path_depth > 4 { true -> total_alignment_payload() _ -> total_alignment_tag() } }
    state total_alignment_payload() { self.saved_tok_start = self.path_depth; transition 0 { _ -> total_padding() } }
    state total_alignment_tag() { self.saved_tok_start = 4; transition 0 { _ -> total_padding() } }
    state total_padding() { self.layout_padding = (self.saved_tok_start - self.k % self.saved_tok_start) % self.saved_tok_start; transition self.k <= 131072 - self.layout_padding { true -> finish() _ -> exhausted() } }
    state finish() {
        self.i32_backing1[164096 + self.data_count + sum_id] = self.k + self.layout_padding;
        self.i32_backing1[164224 + self.data_count + sum_id] = self.saved_tok_start;
        self.i32_backing1[163840 + self.data_count + sum_id] = 2; transition 0 { _ -> done() }
    }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::layout_all_data(&mut self) {
    self.scan_end = self.data_count + self.sum_count; self.scan_index = 0; self.k = 0;
    transition 0 { _ -> pass() }
    state pass() { transition self.scan_index < self.data_count + self.sum_count { true -> kind() _ -> pass_done() } }
    state kind() { transition self.scan_index < self.data_count { true -> unresolved() _ -> sum_unresolved() } }
    state unresolved() {
        transition self.i32_backing1[163840 + self.scan_index] == 2 { true -> already() _ -> attempt() }
    }
    state sum_unresolved() { self.x = self.scan_index - self.data_count; transition self.i32_backing1[163840 + self.data_count + self.x] == 2 { true -> already() _ -> sum_attempt() } }
    state already() { self.scan_index = self.scan_index + 1; transition 0 { _ -> pass() } }
    state attempt() {
        self.layout_data_value(self.scan_index);
        transition self.status == 0 { true -> attempt_ready() _ -> done() }
    }
    state sum_attempt() { self.layout_sum_value(self.x); transition self.status == 0 { true -> attempt_ready() _ -> done() } }
    state attempt_ready() { transition self.match_ok == 1 { true -> resolved() _ -> unresolved_next() } }
    state resolved() {
        self.scan_end = self.scan_end - 1; self.k = self.k + 1;
        self.scan_index = self.scan_index + 1; transition 0 { _ -> pass() }
    }
    state unresolved_next() { self.scan_index = self.scan_index + 1; transition 0 { _ -> pass() } }
    state pass_done() { transition self.scan_end == 0 { true -> done() _ -> progress() } }
    state progress() { transition self.k > 0 { true -> next_pass() _ -> recursive() } }
    state next_pass() { self.scan_index = 0; self.k = 0; transition 0 { _ -> pass() } }
    state recursive() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::zero_type_state(&mut self, type_id: i32) {
    // match_ok: 0 unresolved, 1 invalid at zero, 2 valid at zero.
    transition self.i32_backing0[363080 + type_id] < 4 { true -> scalar() _ -> record_check() }
    state scalar() { transition self.i32_backing1[98304 + type_id] == 0 { true -> yes() _ -> no() } }
    state record_check() { transition self.i32_backing0[363080 + type_id] == 4 { true -> record() _ -> sum_check() } }
    state record() { self.match_ok = self.i32_backing1[163968 + self.i32_backing0[461384 + type_id]]; transition 0 { _ -> done() } }
    state sum_check() { transition self.i32_backing0[363080 + type_id] == 6 { true -> sum() _ -> array_check() } }
    state sum() { self.match_ok = self.i32_backing1[163968 + self.data_count + self.i32_backing0[461384 + type_id]]; transition 0 { _ -> done() } }
    state array_check() { transition self.i32_backing0[363080 + type_id] == 5 { true -> array() _ -> no() } }
    state array() { self.zero_type_state(self.i32_backing1[0 + type_id]); transition 0 { _ -> done() } }
    state yes() { self.match_ok = 2; transition 0 { _ -> done() } }
    state no() { self.match_ok = 1; }
    state done() { }
}

machine Main::zero_type_valid(&mut self, type_id: i32) {
    // Layout already rejected by-value cycles. Resolve records and first-case
    // payloads together so sum zero-establishment composes without recursion
    // through unresolved nominal declarations.
    self.i = 0;
    transition 0 { _ -> clear_records() }
    state clear_records() { transition self.i < self.data_count { true -> clear_record() _ -> clear_sums_begin() } }
    state clear_record() { self.i32_backing1[163968 + self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_records() } }
    state clear_sums_begin() { self.i = 0; transition 0 { _ -> clear_sums() } }
    state clear_sums() { transition self.i < self.sum_count { true -> clear_sum() _ -> pass_begin() } }
    state clear_sum() { self.i32_backing1[163968 + self.data_count + self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_sums() } }
    state pass_begin() { self.i = 0; self.scan_end = 0; self.scan_index = 0; transition 0 { _ -> records() } }
    state records() { transition self.i < self.data_count { true -> record_unresolved_check() _ -> sums_begin() } }
    state record_unresolved_check() { transition self.i32_backing1[163968 + self.i] == 0 { true -> fields_begin() _ -> record_next() } }
    state fields_begin() { self.j = self.i32_backing0[456 + self.i]; self.k = self.j + self.i32_backing0[584 + self.i]; transition 0 { _ -> fields() } }
    state fields() { transition self.j < self.k { true -> field_state() _ -> record_valid() } }
    state field_state() { self.zero_type_state(self.i32_backing0[25288 + self.j]); transition self.match_ok == 2 { true -> field_next() _ -> field_not_valid() } }
    state field_not_valid() { transition self.match_ok == 1 { true -> record_invalid() _ -> record_unresolved() } }
    state field_next() { self.j = self.j + 1; transition 0 { _ -> fields() } }
    state record_valid() { self.i32_backing1[163968 + self.i] = 2; self.scan_index = self.scan_index + 1; transition 0 { _ -> record_next() } }
    state record_invalid() { self.i32_backing1[163968 + self.i] = 1; self.scan_index = self.scan_index + 1; transition 0 { _ -> record_next() } }
    state record_unresolved() { self.scan_end = self.scan_end + 1; transition 0 { _ -> record_next() } }
    state record_next() { self.i = self.i + 1; transition 0 { _ -> records() } }
    state sums_begin() { self.i = 0; transition 0 { _ -> sums() } }
    state sums() { transition self.i < self.sum_count { true -> sum_unresolved_check() _ -> pass_done() } }
    state sum_unresolved_check() { transition self.i32_backing1[163968 + self.data_count + self.i] == 0 { true -> first_case() _ -> sum_next() } }
    state first_case() { self.j = self.i32_backing0[456 + self.data_count + self.i]; self.k = self.i32_backing0[70216 + self.j]; self.y = self.k + self.i32_backing0[86600 + self.j]; transition 0 { _ -> first_payloads() } }
    state first_payloads() { transition self.k < self.y { true -> first_payload_state() _ -> sum_valid() } }
    state first_payload_state() { self.zero_type_state(self.i32_backing0[17096 + self.field_count + self.k]); transition self.match_ok == 2 { true -> first_payload_next() _ -> first_payload_not_valid() } }
    state first_payload_not_valid() { transition self.match_ok == 1 { true -> sum_invalid() _ -> sum_unresolved() } }
    state first_payload_next() { self.k = self.k + 1; transition 0 { _ -> first_payloads() } }
    state sum_valid() { self.i32_backing1[163968 + self.data_count + self.i] = 2; self.scan_index = self.scan_index + 1; transition 0 { _ -> sum_next() } }
    state sum_invalid() { self.i32_backing1[163968 + self.data_count + self.i] = 1; self.scan_index = self.scan_index + 1; transition 0 { _ -> sum_next() } }
    state sum_unresolved() { self.scan_end = self.scan_end + 1; transition 0 { _ -> sum_next() } }
    state sum_next() { self.i = self.i + 1; transition 0 { _ -> sums() } }
    state pass_done() { transition self.scan_end == 0 { true -> result() _ -> pass_progress() } }
    state pass_progress() { transition self.scan_index > 0 { true -> pass_begin() _ -> no() } }
    state result() { self.zero_type_state(type_id); transition self.match_ok == 2 { true -> yes() _ -> no() } }
    state yes() { self.match_ok = 1; transition 0 { _ -> done() } }
    state no() { self.match_ok = 0; }
    state done() { }
}

machine Main::prepare_ck_blocks(&mut self) {
    self.block_count = 0; self.block_parameter_count = self.param_count - self.machine_parameter_count;
    self.ck_block_parameter_cursor = 0; self.i = 0;
    self.synthetic_block = 0 - 1;
    transition self.ck3[39] == 12 { true -> selected_machine_count() _ -> block_capacity() }
    state selected_machine_count() { transition self.machine_count == 1 { true -> selected_machine_block_capacity() _ -> bad() } }
    state selected_machine_block_capacity() { transition self.w_block_count < 128 { true -> selected_block_capacity() _ -> exhausted() } }
    state selected_block_capacity() { transition self.machine_count + self.state_count < 2048 { true -> selected_parameter_capacity() _ -> exhausted() } }
    state selected_parameter_capacity() { transition self.param_count < 4096 { true -> selected_setup() _ -> exhausted() } }
    state selected_setup() {
        self.synthetic_block = self.w_block_count;
        self.ck3[61] = self.param_count;
        self.i32_backing0[330312 + self.param_count] = self.ck3[60];
        self.param_count = self.param_count + 1;
        self.block_parameter_count = self.block_parameter_count + 1;
        transition 0 { _ -> block_capacity() }
    }
    state block_capacity() { transition self.machine_count + self.state_count <= 2048 { true -> machine_parameter_capacity() _ -> exhausted() } }
    state machine_parameter_capacity() { transition self.machine_parameter_count <= 896 { true -> parameter_capacity() _ -> exhausted() } }
    state parameter_capacity() { transition self.param_count <= 4096 { true -> machines() _ -> exhausted() } }
    state machines() { transition self.i < self.machine_count { true -> machine_begin() _ -> parameters() } }
    state machine_begin() {
        self.i32_backing1[254592 + self.i] = self.block_count;
        self.i32_backing1[254848 + self.i] = self.block_count;
        self.i32_backing1[254720 + self.i] = self.i32_backing0[35272 + self.i] + 1;
        self.i32_backing1[271360 + self.block_count] = self.i;
        self.i32_backing1[273408 + self.block_count] = self.i32_backing0[34504 + self.i] + 1;
        self.i32_backing1[275456 + self.block_count] = self.ck_block_parameter_cursor;
        self.i32_backing1[277504 + self.block_count] = 0;
        self.block_count = self.block_count + 1;
        self.j = self.i32_backing0[35144 + self.i];
        self.k = self.j + self.i32_backing0[35272 + self.i];
        transition 0 { _ -> states() }
    }
    state states() { transition self.j < self.k { true -> state_one() _ -> synthetic_check() } }
    state state_one() {
        self.i32_backing1[254976 + self.j] = self.block_count;
        self.i32_backing1[271360 + self.block_count] = self.i;
        self.i32_backing1[273408 + self.block_count] = self.i32_backing0[117320 + self.j] + 1;
        self.i32_backing1[275456 + self.block_count] = self.ck_block_parameter_cursor;
        self.i32_backing1[277504 + self.block_count] = self.i32_backing0[100936 + self.j];
        self.ck_block_parameter_cursor = self.ck_block_parameter_cursor + self.i32_backing0[100936 + self.j];
        self.block_count = self.block_count + 1; self.j = self.j + 1;
        transition 0 { _ -> states() }
    }
    state synthetic_check() { transition self.ck3[39] == 12 { true -> synthetic_one() _ -> machine_next() } }
    state synthetic_one() {
        self.i32_backing1[254720 + self.i] = self.i32_backing1[254720 + self.i] + 1;
        self.i32_backing1[271360 + self.block_count] = self.i;
        self.i32_backing1[273408 + self.block_count] = self.i32_backing0[34504 + self.i] + 1;
        self.i32_backing1[275456 + self.block_count] = self.ck_block_parameter_cursor;
        self.i32_backing1[277504 + self.block_count] = 1;
        self.ck_block_parameter_cursor = self.ck_block_parameter_cursor + 1;
        self.block_count = self.block_count + 1;
        transition 0 { _ -> machine_next() }
    }
    state machine_next() { self.i = self.i + 1; transition 0 { _ -> machines() } }
    state parameters() {
        self.value_count = self.param_count; self.i = 0;
        transition 0 { _ -> parameter_types() }
    }
    state parameter_types() { transition self.i < self.param_count { true -> parameter_one() _ -> roots_begin() } }
    state parameter_one() {
        self.i32_backing2[229376 + self.i] = self.i32_backing1[172544 + self.i32_backing0[330312 + self.i]];
        self.i32_backing2[270336 + self.i] = 0 - 1; self.i = self.i + 1;
        transition 0 { _ -> parameter_types() }
    }
    state roots_begin() { self.conformance_entry = self.witness_selected; transition 0 { _ -> root_owner() } }
    state root_owner() {
        let owner: i32 = self.i32_backing0[33736 + self.conformance_entry];
        let nominal: i32 = self.i32_backing0[34632 + self.conformance_entry];
        self.zero_type_valid(nominal);
        transition self.match_ok == 1 { true -> done() _ -> bad() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::record_operation(
    &mut self,
    opcode: i32,
    result_kind: i32,
    result_type: i32
) {
    self.expr_value_id = 0 - 1; self.expr_place_id = 0 - 1;
    transition self.op_count < 32768 { true -> operand_capacity() _ -> exhausted() }
    state operand_capacity() { transition self.record_operand_words <= 94208 - self.operand_count { true -> store() _ -> exhausted() } }
    state store() {
        let operation: i32 = self.op_count;
        self.i32_backing1[283648 + operation] = self.current_machine;
        self.i32_backing1[316416 + operation] = self.current_block;
        self.i32_backing1[349184 + operation] = opcode; self.i32_backing1[381952 + operation] = result_kind;
        self.i32_backing1[447488 + operation] = result_type;
        self.i32_backing1[480256 + operation] = self.operand_count;
        self.i32_backing2[0 + operation] = self.record_operand_words;
        self.i32_backing2[32768 + operation] = self.record_immediate0; self.i32_backing2[65536 + operation] = 0;
        self.record_operand_index = 0;
        transition self.record_operand_words > 0 { true -> operands(operation) _ -> result(operation) }
    }
    state operands(operation: i32) { transition self.record_operand_index == 0 { true -> operand_first(operation) _ -> operand_second_check(operation) } }
    state operand_first(operation: i32) { self.i32_backing2[98304 + self.operand_count] = self.record_operand0; transition 0 { _ -> operand_stored(operation) } }
    state operand_second_check(operation: i32) { transition self.record_operand_index == 1 { true -> operand_second(operation) _ -> operand_call(operation) } }
    state operand_second(operation: i32) { self.i32_backing2[98304 + self.operand_count] = self.record_operand1; transition 0 { _ -> operand_stored(operation) } }
    state operand_call(operation: i32) { self.i32_backing2[98304 + self.operand_count] = self.call_operands[self.record_operand_index]; transition 0 { _ -> operand_stored(operation) } }
    state operand_stored(operation: i32) { self.operand_count = self.operand_count + 1; self.record_operand_index = self.record_operand_index + 1; transition self.record_operand_index < self.record_operand_words { true -> operands(operation) _ -> result(operation) } }
    state result(operation: i32) { transition result_kind == 0 { true -> no_result(operation) _ -> value_check(operation) } }
    state no_result(operation: i32) {
        self.i32_backing1[414720 + operation] = 0 - 1; self.i32_backing1[447488 + operation] = 0 - 1;
        transition 0 { _ -> complete() }
    }
    state value_check(operation: i32) { transition result_kind == 1 { true -> value_capacity(operation) _ -> place_capacity(operation) } }
    state value_capacity(operation: i32) { transition self.value_count < 36864 { true -> value(operation) _ -> exhausted() } }
    state value(operation: i32) {
        self.expr_value_id = self.value_count; self.i32_backing1[414720 + operation] = self.value_count;
        self.i32_backing2[229376 + self.value_count] = result_type; self.i32_backing2[270336 + self.value_count] = self.current_block;
        self.value_count = self.value_count + 1; transition 0 { _ -> complete() }
    }
    state place_capacity(operation: i32) { transition self.place_count < 32768 { true -> place(operation) _ -> exhausted() } }
    state place(operation: i32) {
        self.expr_place_id = self.place_count; self.i32_backing1[414720 + operation] = self.place_count;
        self.i32_backing2[311296 + self.place_count] = result_type; self.i32_backing2[344064 + self.place_count] = self.current_block;
        self.place_count = self.place_count + 1; transition 0 { _ -> complete() }
    }
    state complete() {
        self.op_count = self.op_count + 1;
        self.i32_backing1[281600 + self.current_block] = self.i32_backing1[281600 + self.current_block] + 1;
        transition 0 { _ -> done() }
    }
    state exhausted() { self.status = 252; }
    state done() { }
}

machine Main::materialize_expression(&mut self, result_type: i32) {
    transition self.expr_value_id >= 0 { true -> done() _ -> place_check() }
    state place_check() { transition self.expr_place_id >= 0 { true -> load() _ -> literal() } }
    state load() {
        let place: i32 = self.expr_place_id;
        self.record_operand_words = 1; self.record_operand0 = place;
        self.record_operand1 = 0; self.record_immediate0 = 0;
        self.record_operation(5, 1, self.i32_backing2[311296 + place]);
        transition 0 { _ -> done() }
    }
    state literal() {
        self.record_operand_words = 0; self.record_operand0 = 0;
        self.record_operand1 = 0; self.record_immediate0 = self.expr_lo;
        self.record_operation(1, 1, result_type);
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::record_binary_expression(&mut self, opcode: i32, operand_old_type: i32, result_type: i32) {
    self.right_value_id = self.expr_value_id; self.right_place_id = self.expr_place_id;
    self.right_lo = self.expr_lo; self.right_hi = self.expr_hi;
    transition operand_old_type >= 0 { true -> right_typed() _ -> right_literal() }
    state right_typed() { self.materialize_expression(self.i32_backing1[172544 + operand_old_type]); transition 0 { _ -> right_save() } }
    state right_literal() { transition operand_old_type == 0 - 3 { true -> right_bool() _ -> right_numeric() } }
    state right_bool() { self.materialize_expression(self.ck_bool_type); transition 0 { _ -> right_save() } }
    state right_numeric() { self.materialize_expression(self.ck_u32_full_type); transition 0 { _ -> right_save() } }
    state right_save() {
        self.right_value_id = self.expr_value_id;
        self.expr_value_id = self.left_value_id; self.expr_place_id = self.left_place_id;
        self.expr_lo = self.left_lo; self.expr_hi = self.left_hi;
        transition operand_old_type >= 0 { true -> left_typed() _ -> left_literal() }
    }
    state left_typed() { self.materialize_expression(self.i32_backing1[172544 + operand_old_type]); transition 0 { _ -> emit() } }
    state left_literal() { transition operand_old_type == 0 - 3 { true -> left_bool() _ -> left_numeric() } }
    state left_bool() { self.materialize_expression(self.ck_bool_type); transition 0 { _ -> emit() } }
    state left_numeric() { self.materialize_expression(self.ck_u32_full_type); transition 0 { _ -> emit() } }
    state emit() {
        self.left_value_id = self.expr_value_id;
        self.record_operand_words = 2; self.record_operand0 = self.left_value_id;
        self.record_operand1 = self.right_value_id; self.record_immediate0 = 0;
        self.record_operation(opcode, 1, result_type);
        transition 0 { _ -> restore() }
    }
    state restore() { self.expr_lo = self.right_lo; self.expr_hi = self.right_hi; }
}

// The selected CKIR7 logical relation has exact canonical Boolean operands on
// both sides.  Unlike numeric binary materialization, literal operands must
// therefore use the Boolean type rather than the inherited u32 literal type.
machine Main::record_logical_expression(&mut self, opcode: i32) {
    self.right_value_id = self.expr_value_id; self.right_place_id = self.expr_place_id;
    self.right_lo = self.expr_lo; self.right_hi = self.expr_hi;
    self.materialize_expression(self.ck_bool_type);
    transition self.status == 0 { true -> right_save() _ -> done() }
    state right_save() {
        self.right_value_id = self.expr_value_id;
        self.expr_value_id = self.left_value_id; self.expr_place_id = self.left_place_id;
        self.expr_lo = self.left_lo; self.expr_hi = self.left_hi;
        transition 0 { _ -> left() }
    }
    state left() { self.materialize_expression(self.ck_bool_type); transition self.status == 0 { true -> emit() _ -> done() } }
    state emit() {
        self.left_value_id = self.expr_value_id;
        self.record_operand_words = 2; self.record_operand0 = self.left_value_id;
        self.record_operand1 = self.right_value_id; self.record_immediate0 = 0;
        self.record_operation(opcode, 1, self.ck_bool_type);
        transition 0 { _ -> restore() }
    }
    state restore() { self.expr_lo = self.right_lo; self.expr_hi = self.right_hi; }
    state done() { }
}

machine Main::find_state_span(&mut self, owner: i32, start: i32, count: i32) {
    self.current_state = 0 - 1; self.j = self.i32_backing0[35144 + owner];
    self.k = self.j + self.i32_backing0[35272 + owner];
    transition 0 { _ -> loop() }
    state loop() { transition self.j < self.k { true -> length() _ -> done() } }
    state length() { transition count == self.i32_backing0[68168 + self.j] { true -> compare() _ -> next() } }
    state compare() {
        self.spans_equal(start, self.i32_backing0[51784 + self.j], count);
        transition self.match_ok == 1 { true -> found() _ -> next() }
    }
    state found() { self.current_state = self.j; transition 0 { _ -> done() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::find_field_span(&mut self, owner: i32, start: i32, count: i32) {
