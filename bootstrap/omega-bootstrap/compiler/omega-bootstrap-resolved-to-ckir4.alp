    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_transition(&mut self) {
    self.next_token();
    transition self.tok == 123 { true -> guardless() _ -> guarded() }
    state guardless() { self.parse_guardless_transition(); transition 0 { _ -> done() } }
    state guarded() { self.parse_expression(); transition self.status == 0 { true -> sum_version() _ -> done() } }
    state sum_version() { transition self.resolution_version >= 3 { true -> sum_type() _ -> guard_type() } }
    state sum_type() { transition self.expr_type >= 0 { true -> sum_kind() _ -> guard_type() } }
    state sum_kind() { transition self.i32_backing0[363080 + self.expr_type] == 6 { true -> sum_dispatch() _ -> guard_type() } }
    state sum_dispatch() { self.parse_case_dispatch(); transition 0 { _ -> done() } }
    state guard_type() { transition self.expr_type == 0 - 3 { true -> guard_save() _ -> guard_typed() } }
    state guard_typed() { transition self.expr_type >= 0 { true -> guard_kind() _ -> bad() } }
    state guard_kind() { transition self.i32_backing0[363080 + self.expr_type] == 3 { true -> guard_save() _ -> bad() } }
    state guard_save() {
        self.transition_fact_valid = self.guard_fact_valid;
        self.transition_fact_kind = self.guard_fact_kind;
        self.transition_fact_id = self.guard_fact_id;
        self.transition_fact_hi = self.guard_fact_hi;
        transition self.bundle_mode == 1 { true -> guard_materialize() _ -> guard_open() }
    }
    state guard_materialize() {
        transition self.expr_type == 0 - 3 { true -> guard_literal() _ -> guard_typed_value() }
    }
    state guard_literal() { self.materialize_expression(self.ck_bool_type); transition 0 { _ -> guard_value() } }
    state guard_typed_value() { self.materialize_expression(self.i32_backing1[172544 + self.expr_type]); transition 0 { _ -> guard_value() } }
    state guard_value() {
        self.transition_value_id = self.expr_value_id;
        transition self.status == 0 { true -> guard_open() _ -> done() }
    }
    state guard_open() {
        self.expect_token(123);
        self.arm_true = 0; self.arm_false = 0; self.arm_wild = 0;
        self.transition_target0 = 0 - 1; self.transition_target1 = 0 - 1;
        self.transition_wild_target = 0 - 1;
        self.transition_arg0_count = 0; self.transition_arg1_count = 0;
        self.transition_arg_wild_count = 0;
        transition self.status == 0 { true -> selected_slice_check() _ -> done() }
    }
    state selected_slice_check() { transition self.ck3[53] == 1 { true -> selected_slice() _ -> arms() } }
    state selected_slice() { self.parse_slice_nonempty_transition(); transition 0 { _ -> done() } }
    state arms() { transition self.tok == 125 { true -> close() _ -> arm_label() } }
    state arm_label() { transition self.tok == 256 { true -> arm_true_check() _ -> bad() } }
    state arm_true_check() { self.token_word(37, 4); transition self.match_ok == 1 { true -> true_arm() _ -> arm_false_check() } }
    state true_arm() { transition self.arm_true == 0 { true -> true_save() _ -> bad() } }
    state true_save() {
        self.arm_true = 1; self.arm_fact = self.transition_fact_valid; self.transition_arm_kind = 1;
        self.ck3[21] = self.transition_fact_valid;
        self.ck3[23] = self.transition_fact_kind;
        self.ck3[24] = self.transition_fact_id;
        self.ck3[25] = self.transition_fact_hi;
