    }
    state found() { self.expr_subject_id = self.j; transition 0 { _ -> done() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::find_case_span(&mut self, owner: i32, start: i32, count: i32) {
    self.expr_subject_id = 0 - 1;
    self.i = self.i32_backing0[456 + self.data_count + owner];
    self.j = self.i + self.i32_backing0[584 + self.data_count + owner];
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.j { true -> length() _ -> done() } }
    state length() { transition self.i32_backing0[119368 + self.i] == count { true -> bytes() _ -> next() } }
    state bytes() { self.spans_equal(start, self.i32_backing0[102984 + self.i], count); transition self.match_ok == 1 { true -> found() _ -> next() } }
    state found() { self.expr_subject_id = self.i; transition 0 { _ -> done() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> rows() } }
    state done() { }
}

machine Main::find_case_payload_span(&mut self, owner: i32, start: i32, count: i32) {
    self.expr_subject_id = 0 - 1;
