    state duplicate_loop() { transition self.j < self.i { true -> duplicate_length() _ -> next() } }
    state duplicate_length() { transition self.i32_backing0[119368 + self.j] == self.i32_backing0[119368 + self.i] { true -> duplicate_bytes() _ -> duplicate_next() } }
    state duplicate_bytes() { self.spans_equal(self.i32_backing0[102984 + self.j], self.i32_backing0[102984 + self.i], self.i32_backing0[119368 + self.i]); transition self.match_ok == 1 { true -> bad() _ -> duplicate_next() } }
    state duplicate_next() { self.j = self.j + 1; transition 0 { _ -> duplicate_loop() } }
    state next() { self.y = self.y + self.i32_backing0[86600 + self.i]; self.i = self.i + 1; transition 0 { _ -> rows() } }
