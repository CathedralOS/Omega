machine Main::parse_record_constant(&mut self, expected: i32) {
    self.spans_equal(self.tok_start, self.i32_backing0[72 + self.i32_backing0[461384 + expected]], self.tok_len);
    transition self.match_ok == 1 { true -> name_length() _ -> bad() }
