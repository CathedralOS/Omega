    state new_feature_count() { transition self.comparison_opcode >= 19 { true -> count_new() _ -> compare() } }
    state count_new() { self.ck3[22] = self.ck3[22] + 1; transition 0 { _ -> compare() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

// CKIR8 admits only intrinsic same-carrier scalar value equality.  This is a
// distinct equality layer above ordering comparisons and below Boolean &&.
// Both operands must already be pure and nontrapping; general Equatable
// dispatch, sums, records, inequality, and cross-carrier comparison remain
// outside this private relation.
machine Main::combine_scalar_equal(&mut self) {
    transition self.ck3[46] == 1 { true -> right_pure() _ -> bad() }
    state right_pure() { transition self.ck3[45] == 1 { true -> left_literal_numeric() _ -> bad() } }
    state left_literal_numeric() { transition self.left_type == 0 - 2 { true -> left_numeric() _ -> left_literal_bool() } }
    state left_numeric() { self.comparison_opcode = 0; transition 0 { _ -> right() } }
    state left_literal_bool() { transition self.left_type == 0 - 3 { true -> left_bool() _ -> left_typed() } }
    state left_bool() { self.comparison_opcode = 3; transition 0 { _ -> right() } }
    state left_typed() { transition self.left_type >= 0 { true -> left_kind() _ -> bad() } }
    state left_kind() { self.comparison_opcode = self.i32_backing0[363080 + self.left_type]; transition self.comparison_opcode { 1 -> right() 2 -> right() 3 -> right() _ -> bad() } }
    state right() { transition self.expr_type == 0 - 2 { true -> right_numeric_literal() _ -> right_bool_literal_check() } }
    state right_numeric_literal() { transition self.comparison_opcode == 3 { true -> bad() _ -> choose_left() } }
    state right_bool_literal_check() { transition self.expr_type == 0 - 3 { true -> right_bool_literal() _ -> right_typed_check() } }
    state right_bool_literal() { transition self.comparison_opcode == 3 { true -> choose_left() _ -> bad() } }
    state right_typed_check() { transition self.expr_type >= 0 { true -> right_kind() _ -> bad() } }
    state right_kind() {
        self.k = self.i32_backing0[363080 + self.expr_type];
        transition self.comparison_opcode == 0 { true -> right_numeric_kind() _ -> right_same_kind() }
    }
    state right_numeric_kind() { transition self.k == 1 { true -> choose_right() _ -> right_numeric_u32() } }
    state right_numeric_u32() { transition self.k == 2 { true -> choose_right() _ -> bad() } }
    state right_same_kind() { transition self.k == self.comparison_opcode { true -> choose_left() _ -> bad() } }
    state choose_left() { transition self.left_type >= 0 { true -> target_left() _ -> choose_right_literal() } }
    state target_left() { self.target_type = self.left_type; transition 0 { _ -> emit_check() } }
    state choose_right_literal() { transition self.expr_type >= 0 { true -> choose_right() _ -> choose_literal_kind() } }
    state choose_right() { self.target_type = self.expr_type; transition 0 { _ -> emit_check() } }
    state choose_literal_kind() { transition self.comparison_opcode == 3 { true -> target_bool_literal() _ -> target_numeric_literal() } }
    state target_bool_literal() { self.target_type = 0 - 3; transition 0 { _ -> emit_check() } }
    state target_numeric_literal() { self.target_type = 0 - 1; transition 0 { _ -> emit_check() } }
    state emit_check() { transition self.bundle_mode == 1 { true -> emit() _ -> result() } }
    state emit() {
        self.record_binary_expression(18, self.target_type, self.ck_bool_type);
        transition self.status == 0 { true -> result() _ -> done() }
    }
    state result() {
        self.ck3[35] = self.ck3[35] + 1;
        self.expr_type = 0 - 3; self.expr_lo = 0; self.expr_hi = 1;
        self.expr_lvalue = 0; self.expr_mutable = 0;
        self.expr_subject_kind = 0; self.expr_subject_id = 0 - 1;
        self.expr_receiver_shape = 0; self.expr_path_depth = 0;
        self.ck3[45] = 1; self.guard_fact_valid = 0;
        self.expr_tree_depth = self.depth;
        transition self.saved_pos > self.expr_tree_depth { true -> right_depth() _ -> depth_add() }
    }
    state right_depth() { self.expr_tree_depth = self.saved_pos; transition 0 { _ -> depth_add() } }
    state depth_add() { self.expr_tree_depth = self.expr_tree_depth + 1; transition self.expr_tree_depth <= 8 { true -> done() _ -> exhausted() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_equality(&mut self) {
    self.parse_comparison();
    transition self.status == 0 { true -> loop() _ -> done() }
    state loop() { transition self.tok == 61 { true -> adjacent() _ -> done() } }
    // A single '=' belongs to assignment. Fixed operator punctuation is
    // adjacent, so inspect the raw next byte without consuming assignment.
    state adjacent() { transition self.pos < self.limit { true -> second() _ -> done() } }
    state second() { transition self.source[self.pos] == 61 { true -> version() _ -> done() } }
    state version() { transition self.ck3[39] >= 8 { true -> left() _ -> bad() } }
    state left() { self.push_expression(); transition self.status == 0 { true -> consume_first() _ -> done() } }
    state consume_first() { self.next_token(); self.expect_token(61); transition self.status == 0 { true -> right() _ -> done() } }
    state right() { self.parse_comparison(); transition self.status == 0 { true -> restore() _ -> done() } }
    state restore() { self.saved_pos = self.expr_tree_depth; self.pop_left_expression(); self.combine_scalar_equal(); transition self.status == 0 { true -> loop() _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

// CKIR7/8 admit eager Boolean truth functions only for source operands already
// proved pure and nontrapping.  Under that boundary, eager evaluation has the
// same observation as Omega's source-ordered short-circuit decision tree.
machine Main::combine_logical(&mut self, opcode: i32) {
    transition self.ck3[46] == 1 { true -> right_pure() _ -> bad() }
    state right_pure() { transition self.ck3[45] == 1 { true -> left_literal() _ -> bad() } }
    state left_literal() { transition self.left_type == 0 - 3 { true -> right_literal() _ -> left_typed() } }
    state left_typed() { transition self.left_type >= 0 { true -> left_kind() _ -> bad() } }
    state left_kind() { transition self.i32_backing0[363080 + self.left_type] == 3 { true -> right_literal() _ -> bad() } }
    state right_literal() { transition self.expr_type == 0 - 3 { true -> emit_check() _ -> right_typed() } }
    state right_typed() { transition self.expr_type >= 0 { true -> right_kind() _ -> bad() } }
    state right_kind() { transition self.i32_backing0[363080 + self.expr_type] == 3 { true -> emit_check() _ -> bad() } }
    state emit_check() { transition self.bundle_mode == 1 { true -> emit() _ -> result() } }
    state emit() { self.record_logical_expression(opcode); transition self.status == 0 { true -> result() _ -> done() } }
    state result() {
        self.ck3[42] = self.ck3[42] + 1;
        transition opcode == 16 { true -> count_and() _ -> count_or() }
    }
    state count_and() { self.ck3[43] = self.ck3[43] + 1; transition 0 { _ -> boolean() } }
    state count_or() { self.ck3[44] = self.ck3[44] + 1; transition 0 { _ -> boolean() } }
    state boolean() {
        self.expr_type = 0 - 3; self.expr_lo = 0; self.expr_hi = 1;
        self.expr_lvalue = 0; self.expr_mutable = 0;
        self.expr_subject_kind = 0; self.expr_subject_id = 0 - 1;
        self.expr_receiver_shape = 0; self.expr_path_depth = 0;
        self.ck3[45] = 1; self.guard_fact_valid = 0;
        self.expr_tree_depth = self.depth;
        transition self.saved_pos > self.expr_tree_depth { true -> right_depth() _ -> depth_add() }
    }
    state right_depth() { self.expr_tree_depth = self.saved_pos; transition 0 { _ -> depth_add() } }
    state depth_add() { self.expr_tree_depth = self.expr_tree_depth + 1; transition self.expr_tree_depth <= 8 { true -> done() _ -> exhausted() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_logical_and(&mut self) {
    self.parse_equality();
    transition self.status == 0 { true -> loop() _ -> done() }
    state loop() { transition self.tok == 38 { true -> version() _ -> done() } }
    state version() { transition self.ck3[39] >= 7 { true -> left() _ -> bad() } }
    state left() { self.push_expression(); transition self.status == 0 { true -> second() _ -> done() } }
    state second() { self.next_token(); self.expect_token(38); transition self.status == 0 { true -> right() _ -> done() } }
    state right() { self.parse_equality(); transition self.status == 0 { true -> restore() _ -> done() } }
    state restore() { self.saved_pos = self.expr_tree_depth; self.pop_left_expression(); self.combine_logical(16); transition self.status == 0 { true -> loop() _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_logical_or(&mut self) {
    self.parse_logical_and();
    transition self.status == 0 { true -> loop() _ -> done() }
    state loop() { transition self.tok == 124 { true -> version() _ -> done() } }
    state version() { transition self.ck3[39] >= 7 { true -> left() _ -> bad() } }
    state left() { self.push_expression(); transition self.status == 0 { true -> second() _ -> done() } }
    state second() { self.next_token(); self.expect_token(124); transition self.status == 0 { true -> right() _ -> done() } }
    state right() { self.parse_logical_and(); transition self.status == 0 { true -> restore() _ -> done() } }
    state restore() { self.saved_pos = self.expr_tree_depth; self.pop_left_expression(); self.combine_logical(17); transition self.status == 0 { true -> loop() _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_expression(&mut self) {
    self.guard_fact_valid = 0; self.ck3[53] = 0;
    self.parse_logical_or();
}

machine Main::merge_state_fact(&mut self, target: i32, has_fact: i32) {
    // The fixed-point lane transports block-parameter intervals. Keep the
    // predecessor join for named receiver fields, which is a separate fact
    // domain required by guarded array accesses such as length < capacity.
    transition has_fact == 1 { true -> field_fact() _ -> inherited() }
    state field_fact() { transition self.transition_fact_kind == 1 { true -> inherited() _ -> without_fact() } }
    state without_fact() { self.arm_fact = 0; transition 0 { _ -> inherited() } }
    state inherited() { transition self.i32_backing0[166472 + target] < 0 { true -> first() _ -> existing() } }
    state first() { transition self.arm_fact == 1 { true -> first_fact() _ -> clear() } }
    state first_fact() {
        self.i32_backing0[166472 + target] = 1;
        self.i32_backing0[182856 + target] = self.transition_fact_kind;
        self.i32_backing0[199240 + target] = self.transition_fact_id;
        self.i32_backing0[215624 + target] = self.transition_fact_hi;
        transition 0 { _ -> done() }
    }
    state existing() { transition self.i32_backing0[166472 + target] == 1 { true -> existing_fact() _ -> done() } }
    state existing_fact() { transition self.arm_fact == 1 { true -> same_kind() _ -> clear() } }
    state same_kind() { transition self.i32_backing0[182856 + target] == self.transition_fact_kind { true -> same_id() _ -> clear() } }
    state same_id() { transition self.i32_backing0[199240 + target] == self.transition_fact_id { true -> weaker() _ -> clear() } }
    state weaker() { transition self.transition_fact_hi > self.i32_backing0[215624 + target] { true -> set_weaker() _ -> done() } }
    state set_weaker() { self.i32_backing0[215624 + target] = self.transition_fact_hi; transition 0 { _ -> done() } }
    state clear() { self.i32_backing0[166472 + target] = 0; }
    state done() { }
}

machine Main::transfer_interval_argument(&mut self, target: i32) {
    transition self.ck3[18] == 1 { true -> reachable() _ -> done() }
    state reachable() { transition self.ck3[20] == 1 { true -> parameter() _ -> done() } }
    state parameter() { self.i = self.i32_backing0[84552 + target] + self.arg_index; transition 0 { _ -> clamp_lo() } }
    state clamp_lo() {
        transition self.ck3[26] < self.i32_backing1[98304 + self.i32_backing0[330312 + self.i]] { true -> set_lo() _ -> clamp_hi() }
    }
    state set_lo() { self.ck3[26] = self.i32_backing1[98304 + self.i32_backing0[330312 + self.i]]; transition 0 { _ -> clamp_hi() } }
    state clamp_hi() {
        transition self.ck3[27] > self.i32_backing1[131072 + self.i32_backing0[330312 + self.i]] { true -> set_hi() _ -> nonempty() }
    }
    state set_hi() { self.ck3[27] = self.i32_backing1[131072 + self.i32_backing0[330312 + self.i]]; transition 0 { _ -> nonempty() } }
    state nonempty() { transition self.ck3[26] <= self.ck3[27] { true -> target_reachable() _ -> done() } }
    state target_reachable() { self.interval_reachable[target] = 1; transition self.interval_pending[self.i] == 0 { true -> first() _ -> hull_lo() } }
    state first() {
        self.interval_pending[self.i] = 1;
        self.interval_los[self.i] = self.ck3[26];
        self.interval_his[self.i] = self.ck3[27];
        self.ck3[19] = 1; transition 0 { _ -> done() }
    }
    state hull_lo() { transition self.ck3[26] < self.interval_los[self.i] { true -> set_hull_lo() _ -> hull_hi() } }
    state set_hull_lo() { self.interval_los[self.i] = self.ck3[26]; self.ck3[19] = 1; transition 0 { _ -> hull_hi() } }
    state hull_hi() { transition self.ck3[27] > self.interval_his[self.i] { true -> set_hull_hi() _ -> done() } }
    state set_hull_hi() { self.interval_his[self.i] = self.ck3[27]; self.ck3[19] = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::transfer_interval_target(&mut self, target: i32) {
    transition self.ck3[18] == 1 { true -> source() _ -> done() }
    state source() { transition self.ck3[20] == 1 { true -> target_check() _ -> done() } }
    state target_check() { transition self.interval_reachable[target] == 0 { true -> target_set() _ -> done() } }
    state target_set() { self.interval_reachable[target] = 1; self.ck3[19] = 1; }
    state done() { }
}

machine Main::parse_transition_arguments(&mut self, target: i32) {
    self.arg_index = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.tok == 41 { true -> close() _ -> expected() } }
    state expected() { transition self.arg_index < self.i32_backing0[100936 + target] { true -> expression() _ -> bad() } }
    state expression() {
        self.parse_expression();
        transition self.status == 0 { true -> type() _ -> done() }
    }
    state type() {
        self.ck3[26] = self.expr_lo; self.ck3[27] = self.expr_hi;
        transition self.ck3[18] == 1 { true -> interval_type() _ -> final_type() }
    }
    state interval_type() {
        self.types_same(self.i32_backing0[330312 + self.i32_backing0[84552 + target] + self.arg_index], self.expr_type);
        transition self.match_ok == 1 { true -> interval_transfer() _ -> interval_literal_check() }
    }
    state interval_literal_check() { transition self.expr_type == 0 - 2 { true -> interval_transfer() _ -> bad() } }
    state interval_transfer() { self.transfer_interval_argument(target); transition 0 { _ -> argument_emit_check() } }
    state final_type() {
        self.expression_assignable(self.i32_backing0[330312 + self.i32_backing0[84552 + target] + self.arg_index], self.expr_type);
        transition self.match_ok == 1 { true -> argument_emit_check() _ -> bad() }
    }
    state argument_emit_check() { transition self.bundle_mode == 1 { true -> argument_kind() _ -> argument_done() } }
    state argument_kind() {
        let expected_type: i32 = self.i32_backing0[330312 + self.i32_backing0[84552 + target] + self.arg_index];
        transition self.i32_backing0[363080 + expected_type] < 4 { true -> argument_materialize(expected_type) _ -> argument_structural() }
    }
    state argument_materialize(expected_type: i32) {
        self.materialize_expression(self.i32_backing1[172544 + expected_type]);
        transition self.status == 0 { true -> argument_store() _ -> done() }
    }
    state argument_structural() { transition self.expr_value_id >= 0 { true -> argument_store() _ -> bad() } }
    state argument_store() { transition self.transition_arm_kind == 1 { true -> argument_true() _ -> argument_false_check() } }
    state argument_true() {
        self.i32_backing2[393232 + self.current_block * 7 + self.arg_index] = self.expr_value_id;
        transition 0 { _ -> argument_done() }
    }
    state argument_false_check() { transition self.transition_arm_kind == 2 { true -> argument_false() _ -> argument_wild() } }
    state argument_false() {
        self.i32_backing2[407568 + self.current_block * 7 + self.arg_index] = self.expr_value_id;
        transition 0 { _ -> argument_done() }
    }
    state argument_wild() {
        self.i32_backing2[421904 + self.current_block * 7 + self.arg_index] = self.expr_value_id;
        transition 0 { _ -> argument_done() }
    }
    state argument_done() {
        self.arg_index = self.arg_index + 1;
        transition self.tok == 44 { true -> comma() _ -> close_check() }
    }
    state comma() { self.next_token(); transition 0 { _ -> loop() } }
    state close_check() { transition self.tok == 41 { true -> close() _ -> bad() } }
    state close() { transition self.arg_index == self.i32_backing0[100936 + target] { true -> close_advance() _ -> bad() } }
    state close_advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::finalize_transition_term(&mut self) {
    transition self.transition_target0 >= 0 { true -> target1() _ -> target0_wild() }
    state target0_wild() {
        self.transition_target0 = self.transition_wild_target;
        self.transition_arg0_count = self.transition_arg_wild_count;
        self.i = 0; transition 0 { _ -> copy0() }
    }
    state copy0() { transition self.i < self.transition_arg0_count { true -> copy0_one() _ -> target1() } }
    state copy0_one() {
        self.i32_backing2[393232 + self.current_block * 7 + self.i] =
            self.i32_backing2[421904 + self.current_block * 7 + self.i];
        self.i = self.i + 1; transition 0 { _ -> copy0() }
    }
    state target1() { transition self.transition_target1 >= 0 { true -> emit() _ -> target1_wild() } }
    state target1_wild() {
        self.transition_target1 = self.transition_wild_target;
        self.transition_arg1_count = self.transition_arg_wild_count;
        self.i = 0; transition 0 { _ -> copy1() }
    }
    state copy1() { transition self.i < self.transition_arg1_count { true -> copy1_one() _ -> emit() } }
    state copy1_one() {
        self.i32_backing2[407568 + self.current_block * 7 + self.i] =
            self.i32_backing2[421904 + self.current_block * 7 + self.i];
        self.i = self.i + 1; transition 0 { _ -> copy1() }
    }
    state emit() {
        self.i32_backing2[376848 + self.current_block] = 2;
        self.i32_backing2[378896 + self.current_block] = self.transition_value_id;
        self.i32_backing2[380944 + self.current_block] = self.transition_target0;
        self.i32_backing2[385040 + self.current_block] = self.transition_arg0_count;
        self.i32_backing2[387088 + self.current_block] = self.transition_target1;
        self.i32_backing2[391184 + self.current_block] = self.transition_arg1_count;
    }
}

machine Main::finalize_jump_term(&mut self) {
    self.i32_backing2[376848 + self.current_block] = 1;
    self.i32_backing2[378896 + self.current_block] = 0 - 1;
    self.i32_backing2[380944 + self.current_block] = self.transition_wild_target;
    self.i32_backing2[385040 + self.current_block] = self.transition_arg_wild_count;
    self.i32_backing2[387088 + self.current_block] = 0 - 1;
    self.i32_backing2[391184 + self.current_block] = 0;
    self.i = 0;
    transition 0 { _ -> copy() }
    state copy() { transition self.i < self.transition_arg_wild_count { true -> copy_one() _ -> done() } }
    state copy_one() {
        self.i32_backing2[393232 + self.current_block * 7 + self.i] =
            self.i32_backing2[421904 + self.current_block * 7 + self.i];
        self.i = self.i + 1; transition 0 { _ -> copy() }
    }
    state done() { }
}

machine Main::parse_guardless_transition(&mut self) {
    self.ck3[21] = 0;
    self.expect_token(123);
    transition self.status == 0 { true -> wildcard() _ -> done() }
    state wildcard() { transition self.tok == 256 { true -> wildcard_shape() _ -> bad() } }
    state wildcard_shape() { transition self.tok_len == 1 { true -> wildcard_byte() _ -> bad() } }
    state wildcard_byte() { transition self.source[self.tok_start] == 95 { true -> wildcard_save() _ -> bad() } }
    state wildcard_save() { self.transition_arm_kind = 3; self.next_token(); transition 0 { _ -> arrow() } }
    state arrow() { self.expect_token(45); transition self.status == 0 { true -> arrow_head() _ -> done() } }
    state arrow_head() { self.expect_token(62); transition self.status == 0 { true -> target_name() _ -> done() } }
    state target_name() { transition self.tok == 256 { true -> target_find() _ -> bad() } }
    state target_find() {
        self.source_state = self.current_state;
        self.find_state_span(self.current_machine, self.tok_start, self.tok_len);
        self.target_state = self.current_state; self.current_state = self.source_state;
        transition self.target_state >= 0 { true -> target_open() _ -> bad() }
    }
    state target_open() { self.next_token(); self.expect_token(40); transition self.status == 0 { true -> arguments() _ -> done() } }
    state arguments() { self.parse_transition_arguments(self.target_state); transition self.status == 0 { true -> close() _ -> done() } }
    state close() { self.expect_token(125); transition self.status == 0 { true -> custody() _ -> done() } }
    state custody() {
        self.transition_wild_target = self.i32_backing1[254976 + self.target_state];
        self.transition_arg_wild_count = self.arg_index;
        self.transfer_interval_target(self.target_state);
        transition 0 { _ -> fact() }
    }
    state fact() { self.arm_fact = 0; self.merge_state_fact(self.target_state, 0); transition self.bundle_mode == 1 { true -> emit() _ -> done() } }
    state emit() { self.finalize_jump_term(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::set_case_arm_argument(&mut self, index: i32, encoded: i32) {
    transition index < 28672 { true -> column0() _ -> column1_check() }
    state column0() { self.i32_backing0[236104 + index] = encoded; transition 0 { _ -> done() } }
    state column1_check() { transition index < 57344 { true -> column1() _ -> column2_check() } }
    state column1() { self.i32_backing0[268872 + index - 28672] = encoded; transition 0 { _ -> done() } }
    state column2_check() { transition index < 86016 { true -> column2() _ -> column3() } }
    state column2() { self.i32_backing0[301640 + index - 57344] = encoded; transition 0 { _ -> done() } }
    state column3() { self.i32_backing0[334408 + index - 86016] = encoded; transition 0 { _ -> done() } }
    state done() { }
}

// A case edge admits either an ordinary visible value or one direct selected
// payload binding. Payload identifiers take precedence over outer parameters,
// and every selected payload must cross the edge exactly once.
machine Main::parse_case_transition_arguments(&mut self, target: i32) {
    self.arg_index = 0; self.i = 0;
    transition 0 { _ -> clear_payloads() }
    state clear_payloads() { transition self.i < self.i32_backing0[86600 + self.arm_true] { true -> clear_payload() _ -> loop() } }
    state clear_payload() { self.i32_backing0[495688 + self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_payloads() } }
    state loop() { transition self.tok == 41 { true -> close() _ -> expected() } }
