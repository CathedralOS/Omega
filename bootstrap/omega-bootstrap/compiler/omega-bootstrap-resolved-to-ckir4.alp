        self.const_parse_bases[self.ck3[7]] = self.ck3[4];
        self.const_parse_counts[self.ck3[7]] = 0;
        self.ck3[4] = self.ck3[4] + self.i32_backing0[584 + self.i32_backing0[461384 + expected]];
        self.i = 0; transition 0 { _ -> clear_seen() }
    }
    state clear_seen() { transition self.i < self.i32_backing0[584 + self.i32_backing0[461384 + expected]] { true -> clear_one() _ -> open() } }
    state clear_one() { self.const_record_seen[self.ck3[7] * 64 + self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_seen() } }
    state open() {
        self.ck3[6] = self.ck3[6] + 1;
        self.next_token(); self.expect_token(123);
        transition self.status == 0 { true -> fields() _ -> done() }
    }
    state fields() { transition self.tok == 125 { true -> close() _ -> field_name() } }
    state field_name() { transition self.tok == 256 { true -> field_find() _ -> bad() } }
    state field_find() {
        self.find_field_span(self.i32_backing0[461384 + expected], self.tok_start, self.tok_len);
        transition self.expr_subject_id >= 0 { true -> field_ordinal() _ -> bad() }
    }
    state field_ordinal() {
        self.j = self.expr_subject_id - self.i32_backing0[456 + self.i32_backing0[461384 + expected]];
        transition self.const_record_seen[(self.ck3[6] - 1) * 64 + self.j] == 0 { true -> field_mark() _ -> bad() }
    }
    state field_mark() {
        self.const_record_seen[(self.ck3[6] - 1) * 64 + self.j] = 1;
        self.const_parse_fields[self.ck3[6] - 1] = self.expr_subject_id;
        self.const_parse_ordinals[self.ck3[6] - 1] = self.j;
        self.next_token(); self.expect_token(58);
        transition self.status == 0 { true -> field_value() _ -> done() }
    }
    state field_value() {
        self.parse_constant(self.i32_backing0[25288 + self.const_parse_fields[self.ck3[6] - 1]]);
        transition self.status == 0 { true -> field_store() _ -> done() }
    }
    state field_store() {
        self.ck3[7] = self.ck3[6] - 1;
        self.const_parse_children[self.const_parse_bases[self.ck3[7]] + self.const_parse_ordinals[self.ck3[7]]] = self.ck3[11];
        self.const_parse_counts[self.ck3[7]] = self.const_parse_counts[self.ck3[7]] + 1;
        transition self.tok == 44 { true -> comma() _ -> close_check() }
    }
    state comma() { self.next_token(); transition self.tok == 125 { true -> bad() _ -> fields() } }
    state close_check() { transition self.tok == 125 { true -> close() _ -> bad() } }
    state close() {
        self.ck3[7] = self.ck3[6] - 1;
        transition self.const_parse_counts[self.ck3[7]] == self.i32_backing0[584 + self.i32_backing0[461384 + expected]] { true -> source_limit() _ -> bad() }
    }
    state source_limit() { transition self.i32_backing0[584 + self.i32_backing0[461384 + expected]] <= 4 { true -> height_begin() _ -> exhausted() } }
    state height_begin() { self.i = 0; self.ck3[12] = 0; transition 0 { _ -> height() } }
    state height() { transition self.i < self.i32_backing0[584 + self.i32_backing0[461384 + expected]] { true -> height_one() _ -> intern() } }
    state height_one() {
        self.j = self.temp_const_heights[self.const_parse_children[self.const_parse_bases[self.ck3[7]] + self.i]] + 1;
        transition self.j > self.ck3[12] { true -> height_set() _ -> height_next() }
    }
    state height_set() { self.ck3[12] = self.j; transition 0 { _ -> height_next() } }
    state height_next() { self.i = self.i + 1; transition 0 { _ -> height() } }
    state intern() {
