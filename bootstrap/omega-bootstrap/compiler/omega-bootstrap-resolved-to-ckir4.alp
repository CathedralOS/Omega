        self.i32_backing2[376848 + self.current_block] = 4;
        self.i32_backing2[378896 + self.current_block] = self.expr_value_id;
        self.i32_backing2[380944 + self.current_block] = 0 - 1;
        self.i32_backing2[387088 + self.current_block] = 0 - 1;
        self.i32_backing2[385040 + self.current_block] = 0;
        self.i32_backing2[391184 + self.current_block] = 0;
        transition 0 { _ -> result_end() }
    }
    state result_end() {
        self.statement_count = self.statement_count + 1; self.body_value = 1;
