    state partitions() { transition self.x == self.w_machine_parameter_count { true -> block_partition() _ -> bad() } }
    state block_partition() { transition self.y == self.w_block_count { true -> state_relation() _ -> bad() } }
    state state_relation() { transition self.state_count == self.w_block_count - self.machine_count { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::load_machine_parameters(&mut self) {
    self.i = 0; self.x = 0;
    transition 0 { _ -> rows() }
    state rows() { transition self.i < self.machine_parameter_count { true -> owner_seek() _ -> done() } }
    state owner_seek() { transition self.i < self.i32_backing0[34120 + self.x] + self.i32_backing0[34248 + self.x] { true -> row() _ -> owner_next() } }
    state owner_next() { self.x = self.x + 1; transition self.x < self.machine_count { true -> owner_seek() _ -> bad() } }
    state row() { self.table_pos = self.w_machine_parameters + self.i * 24; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> owner() _ -> bad() } }
