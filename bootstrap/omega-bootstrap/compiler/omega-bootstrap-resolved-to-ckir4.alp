    state true_check() { self.token_word(37, 4); transition self.match_ok == 1 { true -> true_arm() _ -> false_check() } }
    state true_arm() { transition self.arm_true == 0 { true -> true_save() _ -> bad() } }
    state true_save() { self.arm_true = 1; self.transition_arm_kind = 1; self.next_token(); transition 0 { _ -> arrow() } }
    state false_check() { self.token_word(41, 5); transition self.match_ok == 1 { true -> false_arm() _ -> bad() } }
    state false_arm() { transition self.arm_false == 0 { true -> false_save() _ -> bad() } }
    state false_save() { self.arm_false = 1; self.transition_arm_kind = 2; self.next_token(); transition 0 { _ -> arrow() } }
    state arrow() { self.expect_token(45); transition self.status == 0 { true -> arrow_head() _ -> done() } }
    state arrow_head() { self.expect_token(62); transition self.status == 0 { true -> target_name() _ -> done() } }
    state target_name() { transition self.tok == 256 { true -> target_find() _ -> bad() } }
    state target_find() {
        self.source_state = self.current_state;
        self.find_state_span(self.current_machine, self.tok_start, self.tok_len);
        self.target_state = self.current_state; self.current_state = self.source_state;
        transition self.target_state >= 0 { true -> target_open() _ -> bad() }
    }
    state target_open() { self.next_token(); self.expect_token(40); transition self.status == 0 { true -> target_shape() _ -> done() } }
    state target_shape() { transition self.transition_arm_kind == 1 { true -> true_target_count() _ -> false_target_count() } }
    state true_target_count() { transition self.i32_backing0[100936 + self.target_state] == 2 { true -> true_target_head() _ -> bad() } }
    state true_target_head() { self.i = self.i32_backing0[84552 + self.target_state]; transition self.i32_backing0[330312 + self.i] == self.i32_backing1[221824 + self.ck3[60]] { true -> true_target_tail() _ -> bad() } }
    state true_target_tail() { transition self.i32_backing0[330312 + self.i + 1] == self.ck3[60] { true -> head_name() _ -> bad() } }
    state head_name() { transition self.tok == 256 { true -> head_find() _ -> bad() } }
    state head_find() { self.find_param_span(self.tok_start, self.tok_len); transition self.expr_subject_id == self.ck3[55] { true -> head_open() _ -> bad() } }
    state head_open() { self.next_token(); self.expect_token(91); transition self.status == 0 { true -> head_zero() _ -> done() } }
    state head_zero() { transition self.tok == 257 { true -> head_zero_value() _ -> bad() } }
    state head_zero_value() { transition self.int_value == 0 { true -> head_close() _ -> bad() } }
    state head_close() { self.next_token(); self.expect_token(93); transition self.status == 0 { true -> head_comma() _ -> done() } }
    state head_comma() { self.expect_token(44); transition self.status == 0 { true -> tail_name() _ -> done() } }
    state tail_name() { transition self.tok == 256 { true -> tail_find() _ -> bad() } }
    state tail_find() { self.find_param_span(self.tok_start, self.tok_len); transition self.expr_subject_id == self.ck3[55] { true -> tail_open() _ -> bad() } }
    state tail_open() { self.next_token(); self.expect_token(91); transition self.status == 0 { true -> tail_one() _ -> done() } }
    state tail_one() { transition self.tok == 257 { true -> tail_one_value() _ -> bad() } }
    state tail_one_value() { transition self.int_value == 1 { true -> tail_dot0() _ -> bad() } }
    state tail_dot0() { self.next_token(); self.expect_token(46); transition self.status == 0 { true -> tail_dot1() _ -> done() } }
    state tail_dot1() { self.expect_token(46); transition self.status == 0 { true -> tail_close() _ -> done() } }
    state tail_close() { self.expect_token(93); transition self.status == 0 { true -> true_call_close() _ -> done() } }
