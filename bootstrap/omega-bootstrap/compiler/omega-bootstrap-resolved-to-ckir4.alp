    state dense() { transition self.decoded == self.i { true -> owner() _ -> bad() } }
    state owner() { self.read_witness_u32(self.table_pos + 4); self.i32_backing2[438912 + self.i] = self.decoded; transition self.decoded == self.x { true -> ordinal() _ -> bad() } }
    state ordinal() { self.read_witness_u32(self.table_pos + 8); self.i32_backing2[440960 + self.i] = self.decoded; transition self.decoded == self.i - self.i32_backing1[254592 + self.x] { true -> access() _ -> bad() } }
    state access() { self.i32_backing2[443008 + self.i] = self.witness[self.table_pos + 12]; transition self.i32_backing2[443008 + self.i] >= 1 { true -> access_high() _ -> bad() } }
    state access_high() { transition self.i32_backing2[443008 + self.i] <= self.i32_backing0[34504 + self.x] + 1 { true -> flags() _ -> bad() } }
    state flags() { transition self.witness[self.table_pos + 13] == 0 { true -> reserved0() _ -> bad() } }
    state reserved0() { transition self.witness[self.table_pos + 14] == 0 { true -> reserved1() _ -> bad() } }
    state reserved1() { transition self.witness[self.table_pos + 15] == 0 { true -> body() _ -> bad() } }
    state body() {
        self.read_witness_u32(self.table_pos + 16); self.saved_pos = self.decoded;
        self.read_witness_u32(self.table_pos + 20); self.saved_tok = self.decoded;
        transition self.status == 0 { true -> body_order() _ -> done() }
    }
    state body_order() { transition self.saved_pos <= self.saved_tok { true -> body_span() _ -> bad() } }
    state body_span() { self.source_span_valid(self.i32_backing2[438464 + self.x], self.saved_pos, self.saved_tok - self.saved_pos); transition self.match_ok == 1 { true -> state_name() _ -> bad() } }
    state state_name() {
        self.i32_backing2[445056 + self.i] = self.i32_backing2[436576 + self.i32_backing2[438464 + self.x]] + self.saved_pos;
        self.i32_backing2[447104 + self.i] = self.i32_backing2[436576 + self.i32_backing2[438464 + self.x]] + self.saved_tok;
        self.read_witness_u32(self.table_pos + 24); self.saved_pos = self.decoded;
        self.read_witness_u32(self.table_pos + 28); self.saved_tok_len = self.decoded;
        self.read_witness_u32(self.table_pos + 32); self.i32_backing2[449152 + self.i] = self.decoded;
        self.read_witness_u32(self.table_pos + 36); self.i32_backing2[451200 + self.i] = self.decoded;
        transition self.status == 0 { true -> param_start() _ -> done() }
    }
    state param_start() { transition self.i32_backing2[449152 + self.i] == self.y { true -> param_room() _ -> bad() } }
    state param_room() { transition self.i32_backing2[451200 + self.i] <= self.w_block_parameter_count - self.y { true -> entry_check() _ -> bad() } }
    state entry_check() { transition self.i32_backing2[440960 + self.i] == 0 { true -> entry_name() _ -> named_span() } }
    state entry_name() { transition self.saved_pos < 0 { true -> entry_name_len() _ -> bad() } }
    state entry_name_len() { transition self.saved_tok_len == 0 { true -> entry_params() _ -> bad() } }
    state entry_params() { transition self.i32_backing2[451200 + self.i] == 0 { true -> save_entry() _ -> bad() } }
    state save_entry() {
