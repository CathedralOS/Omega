    state bytes() { self.spans_equal(start, self.i32_backing0[25288 + self.field_count + self.i], count); transition self.match_ok == 1 { true -> found() _ -> next() } }
    state found() { self.expr_subject_id = self.i; transition 0 { _ -> done() } }
