    state pub_sum_flags() { write_byte(self.i32_backing0[328 + self.data_count + self.i]); write_byte(0); write_byte(0); write_byte(0); self.i = self.i + 1; self.j = 0; transition 0 { _ -> pub_sums() } }

    state pub_cases_begin() { self.i = 0; self.j = 0; transition 0 { _ -> pub_cases() } }
    state pub_cases() { transition self.i < self.case_count { true -> pub_case_select() _ -> pub_case_payloads_begin() } }
    state pub_case_select() { transition self.j == 0 { true -> pub_case_id() _ -> pub_case_owner_check() } }
    state pub_case_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_case_word0() } }
    state pub_case_owner_check() { transition self.j == 1 { true -> pub_case_owner() _ -> pub_case_ordinal_check() } }
    state pub_case_owner() { self.c = self.i32_backing0[37448 + self.i]; self.j = 2; transition 0 { _ -> pub_case_word0() } }
    state pub_case_ordinal_check() { transition self.j == 2 { true -> pub_case_ordinal() _ -> pub_case_start_check() } }
    state pub_case_ordinal() { self.c = self.i32_backing0[53832 + self.i]; self.j = 3; transition 0 { _ -> pub_case_word0() } }
    state pub_case_start_check() { transition self.j == 3 { true -> pub_case_start() _ -> pub_case_count() } }
    state pub_case_start() { self.c = self.i32_backing0[70216 + self.i]; self.j = 4; transition 0 { _ -> pub_case_word0() } }
    state pub_case_count() { self.c = self.i32_backing0[86600 + self.i]; self.j = 5; transition 0 { _ -> pub_case_word0() } }
    state pub_case_word0() { write_byte(self.c & 255); transition 0 { _ -> pub_case_word1() } }
    state pub_case_word1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_case_word2() } }
    state pub_case_word2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_case_word3() } }
    state pub_case_word3() { write_byte((self.c >> 24) & 255); transition self.j == 5 { true -> pub_case_next() _ -> pub_case_select() } }
    state pub_case_next() { self.i = self.i + 1; self.j = 0; transition 0 { _ -> pub_cases() } }

    state pub_case_payloads_begin() { self.i = 0; self.j = 0; transition 0 { _ -> pub_case_payloads() } }
    state pub_case_payloads() { transition self.i < self.case_payload_count { true -> pub_case_payload_select() _ -> pub_machines_begin() } }
    state pub_case_payload_select() { transition self.j == 0 { true -> pub_case_payload_id() _ -> pub_case_payload_owner_check() } }
    state pub_case_payload_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_case_payload_word0() } }
    state pub_case_payload_owner_check() { transition self.j == 1 { true -> pub_case_payload_owner() _ -> pub_case_payload_ordinal_check() } }
    state pub_case_payload_owner() { self.c = self.i32_backing0[712 + self.field_count + self.i]; self.j = 2; transition 0 { _ -> pub_case_payload_word0() } }
    state pub_case_payload_ordinal_check() { transition self.j == 2 { true -> pub_case_payload_ordinal() _ -> pub_case_payload_type() } }
    state pub_case_payload_ordinal() { self.c = self.i32_backing0[8904 + self.field_count + self.i]; self.j = 3; transition 0 { _ -> pub_case_payload_word0() } }
    state pub_case_payload_type() { self.c = self.i32_backing1[172544 + self.i32_backing0[17096 + self.field_count + self.i]]; self.j = 4; transition 0 { _ -> pub_case_payload_word0() } }
    state pub_case_payload_word0() { write_byte(self.c & 255); transition 0 { _ -> pub_case_payload_word1() } }
    state pub_case_payload_word1() { write_byte((self.c >> 8) & 255); transition 0 { _ -> pub_case_payload_word2() } }
    state pub_case_payload_word2() { write_byte((self.c >> 16) & 255); transition 0 { _ -> pub_case_payload_word3() } }
    state pub_case_payload_word3() { write_byte((self.c >> 24) & 255); transition self.j == 4 { true -> pub_case_payload_next() _ -> pub_case_payload_select() } }
    state pub_case_payload_next() { self.i = self.i + 1; self.j = 0; transition 0 { _ -> pub_case_payloads() } }

    // Remaining fixed-row tables share one word-at-a-time encoder. pub_table:
    // 1 machines, 2 machine params, 3 blocks, 4 block params,
    // 5 constant nodes, 6 constant children, 7 operations,
    // 8 operation operands, 9 terminator operands, 10 terminators.
    state pub_machines_begin() { self.saved_tok_start = 1; self.i = 0; self.j = 0; self.k = 0; transition 0 { _ -> pub_rows() } }
    state pub_rows() { transition self.saved_tok_start == 1 { true -> pub_machine_rows() _ -> pub_param_table_check() } }
    state pub_machine_rows() { transition self.i < self.machine_count { true -> pub_machine_select() _ -> pub_machine_params_begin() } }
    state pub_machine_select() { transition self.j == 0 { true -> pub_machine_id() _ -> pub_machine_owner_check() } }
    state pub_machine_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_owner_check() { transition self.j == 1 { true -> pub_machine_owner() _ -> pub_machine_head_check() } }
    state pub_machine_owner() { self.c = self.i32_backing0[33736 + self.i]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_head_check() { transition self.j == 2 { true -> pub_machine_head() _ -> pub_machine_result_check() } }
    state pub_machine_head() { write_byte(self.i32_backing0[34504 + self.i] + 1); write_byte(0); write_byte(0); write_byte(0); self.j = 3; transition 0 { _ -> pub_machine_select() } }
    state pub_machine_result_check() { transition self.j == 3 { true -> pub_machine_result() _ -> pub_machine_mstart_check() } }
    state pub_machine_result() { transition self.i32_backing0[34376 + self.i] >= 0 { true -> pub_machine_result_value() _ -> pub_machine_result_unit() } }
    state pub_machine_result_value() { self.c = self.i32_backing1[172544 + self.i32_backing0[34376 + self.i]]; self.j = 4; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_result_unit() { self.c = 0 - 1; self.j = 4; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_mstart_check() { transition self.j == 4 { true -> pub_machine_mstart() _ -> pub_machine_mcount_check() } }
    state pub_machine_mstart() { self.c = self.i32_backing0[34120 + self.i]; self.j = 5; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_mcount_check() { transition self.j == 5 { true -> pub_machine_mcount() _ -> pub_machine_bstart_check() } }
    state pub_machine_mcount() { self.c = self.i32_backing0[34248 + self.i]; self.j = 6; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_bstart_check() { transition self.j == 6 { true -> pub_machine_bstart() _ -> pub_machine_bcount_check() } }
    state pub_machine_bstart() { self.c = self.i32_backing1[254592 + self.i]; self.j = 7; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_bcount_check() { transition self.j == 7 { true -> pub_machine_bcount() _ -> pub_machine_entry() } }
    state pub_machine_bcount() { self.c = self.i32_backing1[254720 + self.i]; self.j = 8; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_entry() { self.c = self.i32_backing1[254848 + self.i]; self.j = 9; transition 0 { _ -> pub_shared_word0() } }

    state pub_machine_params_begin() { self.saved_tok_start = 2; self.i = 0; self.j = 0; self.k = 0; transition 0 { _ -> pub_rows() } }
    state pub_param_table_check() { transition self.saved_tok_start == 2 { true -> pub_machine_param_rows() _ -> pub_block_table_check() } }
    state pub_machine_param_rows() { transition self.i < self.machine_parameter_count { true -> pub_machine_param_select() _ -> pub_blocks_begin() } }
    state pub_machine_param_select() { transition self.j == 0 { true -> pub_machine_param_id() _ -> pub_machine_param_owner_check() } }
    state pub_machine_param_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_param_owner_check() { transition self.j == 1 { true -> pub_machine_param_owner() _ -> pub_machine_param_ordinal_check() } }
    state pub_machine_param_owner() { self.c = self.i32_backing0[232008 + self.i]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_param_ordinal_check() { transition self.j == 2 { true -> pub_machine_param_ordinal() _ -> pub_machine_param_type_check() } }
    state pub_machine_param_ordinal() { self.c = self.i - self.i32_backing0[34120 + self.i32_backing0[232008 + self.i]]; self.j = 3; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_param_type_check() { transition self.j == 3 { true -> pub_machine_param_type() _ -> pub_machine_param_value() } }
    state pub_machine_param_type() { self.c = self.i32_backing1[172544 + self.i32_backing0[330312 + self.i]]; self.j = 4; transition 0 { _ -> pub_shared_word0() } }
    state pub_machine_param_value() { self.c = self.i; self.j = 5; transition 0 { _ -> pub_shared_word0() } }

    state pub_blocks_begin() { self.saved_tok_start = 3; self.i = 0; self.j = 0; transition 0 { _ -> pub_rows() } }
    state pub_block_table_check() { transition self.saved_tok_start == 3 { true -> pub_block_rows() _ -> pub_bparam_table_check() } }
    state pub_block_rows() { transition self.i < self.block_count { true -> pub_block_select() _ -> pub_block_params_begin() } }
    state pub_block_select() { transition self.j == 0 { true -> pub_block_id() _ -> pub_block_owner_check() } }
    state pub_block_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_owner_check() { transition self.j == 1 { true -> pub_block_owner() _ -> pub_block_head_check() } }
    state pub_block_owner() { self.c = self.i32_backing1[271360 + self.i]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_head_check() { transition self.j == 2 { true -> pub_block_head() _ -> pub_block_pstart_check() } }
    state pub_block_head() { write_byte(self.i32_backing1[273408 + self.i]); transition self.i == self.synthetic_block { true -> pub_block_synthetic() _ -> pub_block_authored() } }
    state pub_block_synthetic() { write_byte(1); write_byte(0); write_byte(0); self.j = 3; transition 0 { _ -> pub_block_select() } }
    state pub_block_authored() { write_byte(0); write_byte(0); write_byte(0); self.j = 3; transition 0 { _ -> pub_block_select() } }
    state pub_block_pstart_check() { transition self.j == 3 { true -> pub_block_pstart() _ -> pub_block_pcount_check() } }
    state pub_block_pstart() { self.c = self.i32_backing1[275456 + self.i]; self.j = 4; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_pcount_check() { transition self.j == 4 { true -> pub_block_pcount() _ -> pub_block_ostart_check() } }
    state pub_block_pcount() { self.c = self.i32_backing1[277504 + self.i]; self.j = 5; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_ostart_check() { transition self.j == 5 { true -> pub_block_ostart() _ -> pub_block_ocount_check() } }
    state pub_block_ostart() { self.c = self.i32_backing1[279552 + self.i]; self.j = 6; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_ocount_check() { transition self.j == 6 { true -> pub_block_ocount() _ -> pub_block_term() } }
    state pub_block_ocount() { self.c = self.i32_backing1[281600 + self.i]; self.j = 7; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_term() { self.c = self.i; self.j = 8; transition 0 { _ -> pub_shared_word0() } }

    state pub_block_params_begin() { self.saved_tok_start = 4; self.i = 0; self.j = 0; transition 0 { _ -> pub_rows() } }
    state pub_bparam_table_check() { transition self.saved_tok_start == 4 { true -> pub_block_param_rows() _ -> pub_const_table_check() } }
    state pub_block_param_rows() { transition self.i < self.block_parameter_count { true -> pub_block_param_select() _ -> pub_constants_begin() } }
    state pub_block_param_select() { transition self.j == 0 { true -> pub_block_param_id() _ -> pub_block_param_owner_check() } }
    state pub_block_param_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_param_owner_check() { transition self.j == 1 { true -> pub_block_param_owner() _ -> pub_block_param_ordinal_check() } }
    state pub_block_param_owner() { transition self.i == self.w_block_parameter_count { true -> pub_block_param_owner_synthetic() _ -> pub_block_param_owner_authored() } }
    state pub_block_param_owner_synthetic() { self.c = self.synthetic_block; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_param_owner_authored() { let powner: i32 = self.machine_parameter_count + self.i; self.c = self.i32_backing1[254976 + self.i32_backing0[232008 + powner] - 1000]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_param_ordinal_check() { transition self.j == 2 { true -> pub_block_param_ordinal() _ -> pub_block_param_type_check() } }
    state pub_block_param_ordinal() { transition self.i == self.w_block_parameter_count { true -> pub_block_param_ordinal_synthetic() _ -> pub_block_param_ordinal_authored() } }
    state pub_block_param_ordinal_synthetic() { self.c = 0; self.j = 3; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_param_ordinal_authored() { let pordinal: i32 = self.machine_parameter_count + self.i; let stateordinal: i32 = self.i32_backing0[232008 + pordinal] - 1000; self.c = pordinal - self.i32_backing0[84552 + stateordinal]; self.j = 3; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_param_type_check() { transition self.j == 3 { true -> pub_block_param_type() _ -> pub_block_param_value() } }
    state pub_block_param_type() { let ptype: i32 = self.machine_parameter_count + self.i; self.c = self.i32_backing1[172544 + self.i32_backing0[330312 + ptype]]; self.j = 4; transition 0 { _ -> pub_shared_word0() } }
    state pub_block_param_value() { self.c = self.machine_parameter_count + self.i; self.j = 5; transition 0 { _ -> pub_shared_word0() } }

    state pub_constants_begin() { self.saved_tok_start = 5; self.i = 0; self.j = 0; transition 0 { _ -> pub_rows() } }
    state pub_const_table_check() { transition self.saved_tok_start == 5 { true -> pub_constant_rows() _ -> pub_child_table_check() } }
    state pub_constant_rows() { transition self.i < self.ck3[2] { true -> pub_constant_select() _ -> pub_children_begin() } }
    state pub_constant_select() { transition self.j == 0 { true -> pub_constant_id() _ -> pub_constant_type_check() } }
    state pub_constant_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_constant_type_check() { transition self.j == 1 { true -> pub_constant_type() _ -> pub_constant_start_check() } }
    state pub_constant_type() { self.c = self.const_types[self.i]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
    state pub_constant_start_check() { transition self.j == 2 { true -> pub_constant_start() _ -> pub_constant_count_check() } }
    state pub_constant_start() { self.c = self.const_starts[self.i]; self.j = 3; transition 0 { _ -> pub_shared_word0() } }
    state pub_constant_count_check() { transition self.j == 3 { true -> pub_constant_count() _ -> pub_constant_scalar_check() } }
    state pub_constant_count() { self.c = self.const_counts[self.i]; self.j = 4; transition 0 { _ -> pub_shared_word0() } }
    state pub_constant_scalar_check() { transition self.j == 4 { true -> pub_constant_scalar() _ -> pub_constant_reserved() } }
    state pub_constant_scalar() { self.c = self.const_scalars[self.i]; self.j = 5; transition 0 { _ -> pub_shared_word0() } }
    state pub_constant_reserved() { self.c = 0; self.j = 6; transition 0 { _ -> pub_shared_word0() } }

    state pub_children_begin() { self.saved_tok_start = 6; self.i = 0; self.j = 0; transition 0 { _ -> pub_rows() } }
    state pub_child_table_check() { transition self.saved_tok_start == 6 { true -> pub_constant_children() _ -> pub_op_table_check() } }
    state pub_constant_children() { transition self.i < self.ck3[3] { true -> pub_constant_child() _ -> pub_operations_begin() } }
    state pub_constant_child() { self.c = self.const_children[self.i]; self.j = 1; transition 0 { _ -> pub_shared_word0() } }

    state pub_operations_begin() { self.saved_tok_start = 7; self.i = 0; self.j = 0; transition 0 { _ -> pub_rows() } }
    state pub_op_table_check() { transition self.saved_tok_start == 7 { true -> pub_operation_rows() _ -> pub_operand_table_check() } }
    state pub_operation_rows() { transition self.i < self.op_count { true -> pub_operation_select() _ -> pub_operands_begin() } }
    state pub_operation_select() { transition self.j == 0 { true -> pub_operation_id() _ -> pub_operation_machine_check() } }
    state pub_operation_id() { self.c = self.i; self.j = 1; transition 0 { _ -> pub_shared_word0() } }
    state pub_operation_machine_check() { transition self.j == 1 { true -> pub_operation_machine() _ -> pub_operation_block_check() } }
    state pub_operation_machine() { self.c = self.i32_backing1[283648 + self.i]; self.j = 2; transition 0 { _ -> pub_shared_word0() } }
