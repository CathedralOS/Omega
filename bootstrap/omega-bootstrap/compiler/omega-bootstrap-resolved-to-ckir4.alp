machine Main::load_bindings(&mut self) {
    self.i = 0; self.x = 0 - 1; self.y = 0 - 1; self.k = 0 - 1;
    transition 0 { _ -> clear_machines() }
    state clear_machines() { transition self.i < self.machine_count { true -> clear_one() _ -> rows_begin() } }
    state clear_one() { self.i32_backing2[438592 + self.i] = 0; self.i = self.i + 1; transition 0 { _ -> clear_machines() } }
    state rows_begin() { self.i = 0; transition 0 { _ -> rows() } }
    state rows() { transition self.i < self.w_binding_count { true -> row() _ -> owners_begin() } }
    state row() { self.table_pos = self.w_bindings + self.i * 28; self.read_witness_u32(self.table_pos); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { transition self.decoded == self.i { true -> source_id() _ -> bad() } }
    state source_id() { self.read_witness_u32(self.table_pos + 4); self.current_state = self.decoded; transition self.current_state < self.source_count { true -> head() _ -> bad() } }
    state head() { self.current_receiver_mut = self.witness[self.table_pos + 8]; self.current_result_type = self.witness[self.table_pos + 9]; transition self.witness[self.table_pos + 10] == 0 { true -> reserved1() _ -> bad() } }
    state reserved1() { transition self.witness[self.table_pos + 11] == 0 { true -> words() _ -> bad() } }
    state words() {
        self.read_witness_u32(self.table_pos + 12); self.saved_pos = self.decoded;
        self.read_witness_u32(self.table_pos + 16); self.saved_tok_len = self.decoded;
        self.read_witness_u32(self.table_pos + 20); self.current_data = self.decoded;
        self.read_witness_u32(self.table_pos + 24); self.saved_tok = self.decoded;
        transition self.status == 0 { true -> span() _ -> done() }
    }
    state span() { self.source_span_valid(self.current_state, self.saved_pos, self.saved_tok_len); transition self.match_ok == 1 { true -> nonempty() _ -> bad() } }
    state nonempty() { transition self.saved_tok_len > 0 { true -> declaration_range() _ -> bad() } }
    state declaration_range() { transition self.current_data < self.w_declaration_count { true -> role() _ -> bad() } }
    state role() { transition self.current_receiver_mut == 1 { true -> role1_kind() _ -> role2() } }
    state role1_kind() { transition self.current_result_type == 1 { true -> role1_declaration() _ -> bad() } }
    state role1_declaration() { transition self.i32_backing2[436928 + self.current_data] == 1 { true -> import_link() _ -> role1_sum() } }
    state role1_sum() { transition self.i32_backing2[436928 + self.current_data] == 3 { true -> import_link() _ -> bad() } }
    state role2() { transition self.current_receiver_mut == 2 { true -> role2_kind() _ -> role3() } }
    state role2_kind() { transition self.current_result_type == 1 { true -> role2_declaration() _ -> bad() } }
    state role2_declaration() { transition self.i32_backing2[436928 + self.current_data] == 1 { true -> import_link() _ -> bad() } }
    state role3() { transition self.current_receiver_mut == 3 { true -> role3_kind() _ -> bad() } }
    state role3_kind() { transition self.current_result_type == 2 { true -> role3_declaration() _ -> bad() } }
    state role3_declaration() { transition self.i32_backing2[436928 + self.current_data] == 2 { true -> import_link() _ -> bad() } }
    state import_link() { transition self.saved_tok < 0 { true -> ordering() _ -> import_range() } }
    state import_range() { transition self.saved_tok < self.w_import_count { true -> import_source() _ -> bad() } }
    state import_source() { transition self.i32_backing2[438720 + self.saved_tok] == self.current_state { true -> import_declaration() _ -> bad() } }
    state import_declaration() { transition self.i32_backing2[438848 + self.saved_tok] == self.current_data { true -> import_kind() _ -> bad() } }
    state import_kind() { transition self.i32_backing2[438784 + self.saved_tok] == self.i32_backing2[436928 + self.current_data] { true -> ordering() _ -> bad() } }
    state ordering() { transition self.i == 0 { true -> owner_scan() _ -> source_order() } }
    state source_order() { transition self.current_state > self.x { true -> owner_scan() _ -> source_equal() } }
    state source_equal() { transition self.current_state == self.x { true -> start_order() _ -> bad() } }
    state start_order() { transition self.saved_pos > self.y { true -> owner_scan() _ -> start_equal() } }
    state start_equal() { transition self.saved_pos == self.y { true -> role_order() _ -> bad() } }
    state role_order() { transition self.current_receiver_mut > self.k { true -> owner_scan() _ -> bad() } }
    state owner_scan() { self.j = 0; transition self.current_receiver_mut == 2 { true -> owner_machines() _ -> save_order() } }
    state owner_machines() { transition self.j < self.machine_count { true -> owner_match_source() _ -> save_order() } }
    state owner_match_source() { transition self.i32_backing2[438464 + self.j] == self.current_state { true -> owner_match_declaration() _ -> owner_next() } }
    state owner_match_declaration() { transition self.i32_backing2[438208 + self.i32_backing0[33736 + self.j]] == self.current_data { true -> owner_found() _ -> owner_next() } }
    state owner_found() { self.i32_backing2[438592 + self.j] = 1; transition 0 { _ -> owner_next() } }
    state owner_next() { self.j = self.j + 1; transition 0 { _ -> owner_machines() } }
    state save_order() { self.x = self.current_state; self.y = self.saved_pos; self.k = self.current_receiver_mut; self.i = self.i + 1; transition 0 { _ -> rows() } }
    state owners_begin() { self.i = 0; transition 0 { _ -> owners() } }
    state owners() { transition self.i < self.machine_count { true -> owner_seen() _ -> done() } }
    state owner_seen() { transition self.i32_backing2[438592 + self.i] == 1 { true -> owners_next() _ -> bad() } }
    state owners_next() { self.i = self.i + 1; transition 0 { _ -> owners() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_selected_root(&mut self) {
    transition self.witness_selected >= 0 { true -> selected_range() _ -> bad() }
    state selected_range() { transition self.witness_selected < self.machine_count { true -> source() _ -> bad() } }
    state source() { transition self.i32_backing2[438464 + self.witness_selected] == self.root_source { true -> package() _ -> bad() } }
    state package() { transition self.i32_backing2[436272 + self.root_source] == self.root_package { true -> machine_name() _ -> bad() } }
    state machine_name() {
        let declaration: i32 = self.i32_backing2[438336 + self.witness_selected];
        self.source_span_equals_string(self.i32_backing2[437440 + declaration], self.i32_backing2[437696 + declaration], self.root_machine_string);
        transition self.match_ok == 1 { true -> owner_name() _ -> bad() }
    }
    state owner_name() {
        let record: i32 = self.i32_backing0[33736 + self.witness_selected];
        let owner_declaration: i32 = self.i32_backing2[438208 + record];
        self.source_span_equals_string(self.i32_backing2[437440 + owner_declaration], self.i32_backing2[437696 + owner_declaration], self.root_owner_string);
        transition self.match_ok == 1 { true -> params() _ -> bad() }
    }
    state params() { transition self.i32_backing0[34248 + self.witness_selected] == 0 { true -> result() _ -> bad() } }
    state result() { transition self.i32_backing0[34376 + self.witness_selected] >= 0 { true -> scalar() _ -> bad() } }
    state scalar() { transition self.i32_backing0[363080 + self.i32_backing0[34376 + self.witness_selected]] < 4 { true -> entry_params() _ -> bad() } }
    state entry_params() { transition self.i32_backing2[451200 + self.i32_backing1[254848 + self.witness_selected]] == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_prepared_blocks(&mut self) {
    transition self.conformance_entry == self.witness_selected { true -> counts() _ -> bad() }
    state counts() { transition self.ck3[39] == 12 { true -> selected_counts() _ -> inherited_counts() } }
    state selected_counts() { transition self.block_count == self.w_block_count + 1 { true -> selected_parameter_count() _ -> bad() } }
