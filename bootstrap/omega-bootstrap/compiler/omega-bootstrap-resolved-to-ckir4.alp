machine Main::constant_key_less(&mut self, candidate: i32, incumbent: i32) {
    self.match_ok = 0;
    transition self.temp_const_heights[candidate] < self.temp_const_heights[incumbent] { true -> yes() _ -> height_equal() }
    state height_equal() { transition self.temp_const_heights[candidate] == self.temp_const_heights[incumbent] { true -> type_less() _ -> done() } }
    state type_less() { transition self.temp_const_types[candidate] < self.temp_const_types[incumbent] { true -> yes() _ -> type_equal() } }
    state type_equal() { transition self.temp_const_types[candidate] == self.temp_const_types[incumbent] { true -> kind() _ -> done() } }
    state kind() { transition self.i32_backing1[205440 + self.temp_const_types[candidate]] < 4 { true -> scalar() _ -> count_less() } }
    state scalar() { transition self.temp_const_scalars[candidate] < self.temp_const_scalars[incumbent] { true -> yes() _ -> done() } }
    state count_less() { transition self.temp_const_counts[candidate] < self.temp_const_counts[incumbent] { true -> yes() _ -> count_equal() } }
    state count_equal() { transition self.temp_const_counts[candidate] == self.temp_const_counts[incumbent] { true -> children_begin() _ -> done() } }
    state children_begin() { self.j = 0; transition 0 { _ -> children() } }
    state children() { transition self.j < self.temp_const_counts[candidate] { true -> child() _ -> done() } }
    state child() {
        transition self.const_old_to_new[self.temp_const_children[self.temp_const_starts[candidate] + self.j]] < self.const_old_to_new[self.temp_const_children[self.temp_const_starts[incumbent] + self.j]] { true -> yes() _ -> child_equal() }
    }
    state child_equal() { transition self.const_old_to_new[self.temp_const_children[self.temp_const_starts[candidate] + self.j]] == self.const_old_to_new[self.temp_const_children[self.temp_const_starts[incumbent] + self.j]] { true -> child_next() _ -> done() } }
    state child_next() { self.j = self.j + 1; transition 0 { _ -> children() } }
    state yes() { self.match_ok = 1; }
    state done() { }
}

machine Main::canonicalize_constants(&mut self) {
    self.ck3[2] = 0; self.ck3[3] = 0; self.i = 0;
    transition 0 { _ -> clear() }
    state clear() { transition self.i < self.ck3[0] { true -> clear_one() _ -> select_begin() } }
    state clear_one() { self.const_selected[self.i] = 0; self.const_old_to_new[self.i] = 0 - 1; self.i = self.i + 1; transition 0 { _ -> clear() } }
    state select_begin() { transition self.ck3[2] < self.ck3[0] { true -> select_scan_begin() _ -> rewrite_begin() } }
    state select_scan_begin() { self.ck3[14] = 0 - 1; self.i = 0; transition 0 { _ -> select_scan() } }
    state select_scan() { transition self.i < self.ck3[0] { true -> select_unused() _ -> selected_check() } }
    state select_unused() { transition self.const_selected[self.i] == 0 { true -> select_first() _ -> select_next() } }
    state select_first() { transition self.ck3[14] < 0 { true -> select_save() _ -> select_compare() } }
    state select_compare() {
        self.constant_key_less(self.i, self.ck3[14]);
        transition self.match_ok == 1 { true -> select_save() _ -> select_next() }
    }
    state select_save() { self.ck3[14] = self.i; transition 0 { _ -> select_next() } }
    state select_next() { self.i = self.i + 1; transition 0 { _ -> select_scan() } }
    state selected_check() { transition self.ck3[14] >= 0 { true -> selected_store() _ -> bad() } }
    state selected_store() {
        self.const_selected[self.ck3[14]] = 1;
        self.const_old_to_new[self.ck3[14]] = self.ck3[2];
        self.const_types[self.ck3[2]] = self.temp_const_types[self.ck3[14]];
        self.const_heights[self.ck3[2]] = self.temp_const_heights[self.ck3[14]];
        self.const_starts[self.ck3[2]] = self.ck3[3];
        self.const_counts[self.ck3[2]] = self.temp_const_counts[self.ck3[14]];
        self.const_scalars[self.ck3[2]] = self.temp_const_scalars[self.ck3[14]];
        self.j = 0; transition 0 { _ -> selected_children() }
    }
    state selected_children() { transition self.j < self.temp_const_counts[self.ck3[14]] { true -> selected_child() _ -> selected_done() } }
    state selected_child() {
        transition self.const_old_to_new[self.temp_const_children[self.temp_const_starts[self.ck3[14]] + self.j]] >= 0 { true -> selected_child_store() _ -> bad() }
    }
    state selected_child_store() {
        self.const_children[self.ck3[3] + self.j] = self.const_old_to_new[self.temp_const_children[self.temp_const_starts[self.ck3[14]] + self.j]];
        self.j = self.j + 1; transition 0 { _ -> selected_children() }
    }
    state selected_done() {
        self.ck3[3] = self.ck3[3] + self.temp_const_counts[self.ck3[14]];
        self.ck3[2] = self.ck3[2] + 1; transition 0 { _ -> select_begin() }
    }
    state rewrite_begin() { self.i = 0; transition 0 { _ -> rewrite() } }
    state rewrite() { transition self.i < self.op_count { true -> rewrite_kind() _ -> done() } }
    state rewrite_kind() { transition self.i32_backing1[349184 + self.i] == 11 { true -> rewrite_root() _ -> rewrite_static_check() } }
    state rewrite_static_check() { transition self.i32_backing1[349184 + self.i] == 22 { true -> rewrite_root() _ -> rewrite_next() } }
    state rewrite_root() {
        self.j = self.i32_backing2[32768 + self.i];
        transition self.j >= 0 { true -> rewrite_range() _ -> bad() }
    }
    state rewrite_range() { transition self.j < self.ck3[0] { true -> rewrite_store() _ -> bad() } }
    state rewrite_store() { self.i32_backing2[32768 + self.i] = self.const_old_to_new[self.j]; transition 0 { _ -> rewrite_next() } }
    state rewrite_next() { self.i = self.i + 1; transition 0 { _ -> rewrite() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::check_body(&mut self, start: i32, end: i32) {
    self.limit = end; self.pos = start; self.statement_count = 0;
    self.body_terminated = 0; self.body_value = 0; self.expr_stack_used = 0;
    self.ck3[28] = 0;
