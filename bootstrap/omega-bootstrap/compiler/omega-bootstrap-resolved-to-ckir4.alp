    state parameter() { self.parse_primary(); transition self.status == 0 { true -> parameter_shape() _ -> done() } }
    state parameter_shape() { transition self.expr_subject_kind == 2 { true -> exact() _ -> bad() } }
    state exact() { self.types_same(expected, self.expr_type); transition self.match_ok == 1 { true -> value_check() _ -> bad() } }
    state value_check() { transition self.bundle_mode == 1 { true -> value_present() _ -> done() } }
    state value_present() { transition self.expr_value_id >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
