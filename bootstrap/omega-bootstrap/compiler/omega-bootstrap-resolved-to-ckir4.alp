// Delta-written shared OMGLOW4/5/6/7/8/9/A/B/C/D/E resolved-source lowerer. This component
// consumes exact OMGCOMP plus the paired canonical OMGRSW1/2/3/4/5, validates only the framing and
// relations it uses, reparses body spans through witness identities, recomputes
// copy/layout/zero properties, and emits paired CKIR schema-major 4 through 12 only after
// complete preflight.  The selected root is projected from OMGRSW1 and typed
// attached calls consume exact role-3 bindings; this file does no name lookup.
// It performs no package/name resolution, receipt/digest, ELF, or assurance work.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; n: i32; limit: i32; pos: i32;
    tok: i32; tok_start: i32; tok_len: i32; int_value: i32;
    char_ok: i32; comment_depth: i32; match_ok: i32;
    i: i32; j: i32; k: i32; scan_index: i32; scan_end: i32;
    depth: i32; path_depth: i32;
    saved_pos: i32; saved_tok: i32; saved_tok_start: i32;
    saved_tok_len: i32; saved_int_value: i32;

    root_count: i32; data_count: i32; field_count: i32;
    sum_count: i32; case_count: i32; case_payload_count: i32;
    machine_count: i32; state_count: i32; param_count: i32;
    type_count: i32; current_data: i32; current_machine: i32;
    current_state: i32; current_param_start: i32;
    current_param_count: i32; current_result_type: i32;
    current_receiver_mut: i32; statement_count: i32;
    seen_state: i32; body_terminated: i32; body_value: i32;
    body_state_index: i32; body_state_end: i32;
    source_state: i32; target_state: i32;
    arm_true: i32; arm_false: i32; arm_wild: i32; arm_fact: i32;
    arg_index: i32; transition_fact_valid: i32;
    transition_fact_kind: i32; transition_fact_id: i32; transition_fact_hi: i32;

    // Expression result scratch.
    expr_type: i32; expr_lo: i32; expr_hi: i32;
    expr_lvalue: i32; expr_mutable: i32; expr_subject_kind: i32;
    expr_subject_id: i32; expr_is_array: i32; expr_array_len: i32;
    left_type: i32; left_lo: i32; left_hi: i32;
    right_lo: i32; right_hi: i32;
    left_lvalue: i32; left_mutable: i32; left_subject_kind: i32;
    left_subject_id: i32; left_is_array: i32; left_array_len: i32;
    guard_fact_valid: i32; guard_fact_kind: i32;
    guard_fact_id: i32; guard_fact_hi: i32;
    comparison_opcode: i32;

    expr_tree_depth: i32; expr_path_depth: i32; expr_stack_used: i32;
    expr_receiver_shape: i32; left_receiver_shape: i32;




    target_type: i32; target_lvalue: i32; target_mutable: i32;
    target_subject_kind: i32; target_subject_id: i32;
    assignment_type_id: i32; assignment_rhs_start: i32;

    // Dual raw-unit / canonical one-unit bundle input custody. The extra byte
    // distinguishes exact maximum input from declared input-buffer exhaustion.
    bundle_mode: i32; input_n: i32; decoded: i32;
    label_start: i32; label_len: i32; label_segment_start: i32;
    label_segment_len: i32; content_start: i32; content_len: i32;
    // OMGLOW4/5/6/7/8/9/A/B/C/D keep their two components in separate bounded arrays.
    frame_header: [u8; 32];
    witness: [u8; 524288];
    source: [u8; 267280];
    i32_backing0: [i32; 496800];
    i32_backing1: [i32; 513024];
    i32_backing2: [i32; 453256];

    // Logical i32 table partitions (half-open backing ranges).
    // backing 0: 496800 / 524288 cells
