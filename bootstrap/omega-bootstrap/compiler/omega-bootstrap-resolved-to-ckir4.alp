    state arm_false_check() { self.token_word(41, 5); transition self.match_ok == 1 { true -> false_arm() _ -> wild_check() } }
    state false_arm() { transition self.arm_false == 0 { true -> false_save() _ -> bad() } }
    state false_save() { self.arm_false = 1; self.arm_fact = 0; self.transition_arm_kind = 2; self.ck3[21] = 0; self.next_token(); transition 0 { _ -> arrow() } }
    state wild_check() { transition self.tok_len == 1 { true -> wild_byte() _ -> bad() } }
    state wild_byte() { transition self.source[self.tok_start] == 95 { true -> wild_arm() _ -> bad() } }
    state wild_arm() { transition self.arm_wild == 0 { true -> wild_save() _ -> bad() } }
    state wild_save() { self.arm_wild = 1; self.arm_fact = 0; self.transition_arm_kind = 3; self.ck3[21] = 0; self.next_token(); transition 0 { _ -> arrow() } }
    state arrow() { self.expect_token(45); transition self.status == 0 { true -> arrow_head() _ -> done() } }
    state arrow_head() { self.expect_token(62); transition self.status == 0 { true -> target_name() _ -> done() } }
    state target_name() { transition self.tok == 256 { true -> target_find() _ -> bad() } }
    state target_find() {
        self.source_state = self.current_state;
        self.find_state_span(self.current_machine, self.tok_start, self.tok_len);
        self.target_state = self.current_state; self.current_state = self.source_state;
        transition self.target_state >= 0 { true -> target_open() _ -> bad() }
    }
    state target_open() { self.next_token(); self.expect_token(40); transition self.status == 0 { true -> arguments() _ -> done() } }
    state arguments() {
        self.parse_transition_arguments(self.target_state);
        transition self.status == 0 { true -> arm_custody() _ -> done() }
    }
    state arm_custody() { transition self.transition_arm_kind == 1 { true -> arm_true_custody() _ -> arm_false_custody_check() } }
    state arm_true_custody() {
        self.transition_target0 = self.i32_backing1[254976 + self.target_state];
        self.transition_arg0_count = self.arg_index; self.transfer_interval_target(self.target_state); transition 0 { _ -> fact() }
    }
    state arm_false_custody_check() { transition self.transition_arm_kind == 2 { true -> arm_false_custody() _ -> arm_wild_custody() } }
    state arm_false_custody() {
        self.transition_target1 = self.i32_backing1[254976 + self.target_state];
        self.transition_arg1_count = self.arg_index; self.transfer_interval_target(self.target_state); transition 0 { _ -> fact() }
    }
    state arm_wild_custody() {
