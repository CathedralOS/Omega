        self.ck3[4] = 0; self.ck3[6] = 0;
        self.parse_constant(self.assignment_type_id);
        self.ck3[17] = self.ck3[11];
        transition self.status == 0 { true -> assignment_constant_copy() _ -> done() }
    }
    state assignment_constant_copy() {
        self.type_is_copy(self.assignment_type_id);
        transition self.match_ok == 1 { true -> assignment_constant_emit_check() _ -> bad() }
    }
    state assignment_constant_emit_check() { transition self.bundle_mode == 1 { true -> assignment_constant_emit() _ -> assignment_end() } }
    state assignment_constant_emit() {
        self.record_operand_words = 1; self.record_operand0 = self.assignment_place_id;
        self.record_operand1 = 0; self.record_immediate0 = self.ck3[17];
        self.record_operation(11, 0, 0 - 1);
        transition self.status == 0 { true -> assignment_end() _ -> done() }
    }
    state assignment_expression() {
        self.parse_expression();
        transition self.status == 0 { true -> assignment_type() _ -> done() }
    }
    state assignment_type() {
        self.expression_assignable(self.assignment_type_id, self.expr_type);
        transition self.match_ok == 1 { true -> assignment_copy() _ -> bad() }
    }
    state assignment_copy() { transition self.i32_backing0[363080 + self.assignment_type_id] == 4 { true -> assignment_nominal_copy() _ -> assignment_sum_copy_check() } }
    state assignment_sum_copy_check() { transition self.i32_backing0[363080 + self.assignment_type_id] == 6 { true -> assignment_nominal_copy() _ -> assignment_array_copy() } }
    state assignment_nominal_copy() {
        self.type_is_copy(self.assignment_type_id);
        transition self.match_ok == 1 { true -> assignment_copy_emit_check() _ -> bad() }
    }
    state assignment_array_copy() { transition self.i32_backing0[363080 + self.assignment_type_id] == 5 { true -> assignment_array_check() _ -> assignment_scalar_emit_check() } }
    state assignment_array_check() {
        self.type_is_copy(self.assignment_type_id);
        transition self.match_ok == 1 { true -> assignment_copy_emit_check() _ -> bad() }
    }
    state assignment_scalar_emit_check() { transition self.bundle_mode == 1 { true -> assignment_scalar_materialize() _ -> assignment_end() } }
    state assignment_scalar_materialize() {
        self.materialize_expression(self.i32_backing1[172544 + self.assignment_type_id]);
        transition self.status == 0 { true -> assignment_scalar_emit() _ -> done() }
    }
    state assignment_scalar_emit() {
        self.record_operand_words = 2; self.record_operand0 = self.assignment_place_id;
        self.record_operand1 = self.expr_value_id; self.record_immediate0 = 0;
        self.record_operation(6, 0, 0 - 1);
        transition self.status == 0 { true -> assignment_end() _ -> done() }
    }
    state assignment_copy_emit_check() { transition self.bundle_mode == 1 { true -> assignment_copy_source() _ -> assignment_end() } }
    state assignment_copy_source() { transition self.expr_place_id >= 0 { true -> assignment_copy_place() _ -> assignment_copy_value_check() } }
    state assignment_copy_place() {
        self.record_operand_words = 2; self.record_operand0 = self.assignment_place_id;
        self.record_operand1 = self.expr_place_id; self.record_immediate0 = 2;
        self.record_operation(7, 0, 0 - 1);
        transition self.status == 0 { true -> assignment_end() _ -> done() }
    }
    state assignment_copy_value_check() { transition self.expr_value_id >= 0 { true -> assignment_copy_value() _ -> bad() } }
    state assignment_copy_value() {
        self.record_operand_words = 2; self.record_operand0 = self.assignment_place_id;
        self.record_operand1 = self.expr_value_id; self.record_immediate0 = 1;
        self.record_operation(7, 0, 0 - 1);
        transition self.status == 0 { true -> assignment_end() _ -> done() }
    }
    state assignment_end() {
        self.expect_token(59); self.statement_count = self.statement_count + 1;
        self.invalidate_assigned_fact();
        transition self.status == 0 { true -> loop() _ -> done() }
    }
    state value_result() { transition self.current_result_type >= 0 { true -> result_type() _ -> bad() } }
    state result_type() {
        self.expression_assignable(self.current_result_type, self.expr_type);
        transition self.match_ok == 1 { true -> result_emit_check() _ -> bad() }
    }
    state result_emit_check() { transition self.bundle_mode == 1 { true -> result_materialize() _ -> result_end() } }
    state result_materialize() {
        self.materialize_expression(self.i32_backing1[172544 + self.current_result_type]);
