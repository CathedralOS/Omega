}

machine Main::main(&mut self) {
    self.status=0; self.import_count=0; self.binding_count=0; self.declaration_count=0;
    self.record_count=0; self.field_count=0; self.sum_count=0; self.case_count=0; self.payload_count=0;
    self.machine_count=0; self.machine_parameter_count=0;
    self.block_count=0; self.block_parameter_count=0; self.raw_type_count=0; self.literal_seen=0;
    self.boundary_trait_count=0; self.requirement_count=0; self.requirement_parameter_count=0;
    self.reach_count=0; self.realization_count=0; self.realization_parameter_count=0; self.requirement_call_count=0;
    self.resolution_version=1;
    self.init_words(); self.slurp(); transition self.status==0 { true -> envelope() _ -> finish() }
    state envelope() { self.decode_envelope(); transition self.status==0 { true -> sources() _ -> finish() } }
    state sources() { self.parse_sources(); transition self.status==0 { true -> literal_check() _ -> finish() } }
    state literal_check() { transition self.literal_seen==1 { true -> literal_version() _ -> imports() } }
    state literal_version() { transition self.resolution_version>=4 { true -> imports() _ -> literal_bad() } }
    state literal_bad() { self.reject(); transition 0 { _ -> finish() } }
    state imports() { self.resolve_imports(); transition self.status==0 { true -> bindings() _ -> finish() } }
    state bindings() { self.resolve_bindings(); transition self.status==0 { true -> provider_profile() _ -> finish() } }
    state provider_profile() { self.validate_v6_provider_profile(); transition self.status==0 { true -> types() _ -> finish() } }
    state types() { self.build_canonical_types(); transition self.status==0 { true -> sum_semantics() _ -> finish() } }
    state sum_semantics() { self.validate_sum_graph_and_copy(); transition self.status==0 { true -> root() _ -> finish() } }
    state root() { self.select_root(); transition self.status==0 { true -> preflight() _ -> finish() } }
    state preflight() { self.preflight_witness(); transition self.status==0 { true -> publish() _ -> finish() } }
    state publish() { self.publish_witness(); transition 0 { _ -> finish() } }
    state finish() { self.console.exit_process(self.status); }
}
