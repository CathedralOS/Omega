machine Main::parameter_name_exists(&mut self, kind: i32, start: i32, count: i32) {
    self.match_ok=0; self.i=self.current_parameter_start; self.j=self.i+self.current_parameter_count;
    transition kind==1 { true -> machine_loop() _ -> block_loop() }
    state machine_loop() { transition self.i<self.j { true -> machine_length() _ -> done() } }
    state machine_length() { transition self.tables[69536+self.i]==count { true -> machine_bytes() _ -> machine_next() } }
    state machine_bytes() { self.spans_equal(self.tables[336+self.current_source]+self.tables[67488+self.i],start,count); transition self.match_ok==1 { true -> done() _ -> machine_next() } }
    state machine_next() { self.i=self.i+1; transition 0 { _ -> machine_loop() } }
    state block_loop() { transition self.i<self.j { true -> block_length() _ -> done() } }
    state block_length() { transition self.tables[110496+self.i]==count { true -> block_bytes() _ -> block_next() } }
    state block_bytes() { self.spans_equal(self.tables[336+self.current_source]+self.tables[106400+self.i],start,count); transition self.match_ok==1 { true -> done() _ -> block_next() } }
    state block_next() { self.i=self.i+1; transition 0 { _ -> block_loop() } }
    state done() { }
}

machine Main::parse_parameter_list(&mut self, kind: i32, owner: i32) {
    self.current_parameter_count=0;
    transition kind==1 { true -> machine_start() _ -> block_start() }
    state machine_start() { self.current_parameter_start=self.machine_parameter_count; transition 0 { _ -> receiver() } }
    state block_start() { self.current_parameter_start=self.block_parameter_count; transition 0 { _ -> receiver() } }
    state receiver() { transition self.tok==38 { true -> amp() _ -> bad() } }
    state amp() { self.next_token(); self.token_word(27,3); transition self.match_ok==1 { true -> mutable() _ -> shared() } }
    state mutable() { self.current_receiver_access=2; self.next_token(); transition 0 { _ -> self_word() } }
    state shared() { self.current_receiver_access=1; transition 0 { _ -> self_word() } }
    state self_word() { self.expect_word(30,4); transition self.status==0 { true -> tail() _ -> done() } }
    state tail() { transition self.tok==44 { true -> comma() _ -> close() } }
    state comma() { self.next_token(); transition self.current_parameter_count<7 { true -> name() _ -> over() } }
    state name() { transition self.tok==256 { true -> unique() _ -> bad() } }
    state unique() { self.parameter_name_start=self.tok_start; self.parameter_name_len=self.tok_len; self.parameter_name_exists(kind,self.parameter_name_start,self.parameter_name_len); transition self.match_ok==0 { true -> capacity_kind() _ -> bad() } }
    state capacity_kind() { transition kind==1 { true -> machine_capacity() _ -> block_capacity() } }
    state machine_capacity() { transition self.machine_parameter_count<2048 { true -> syntax() _ -> over() } }
    state block_capacity() { transition self.block_parameter_count<4096 { true -> syntax() _ -> over() } }
    state syntax() { self.next_token(); self.expect_token(58); transition self.status==0 { true -> type() _ -> done() } }
    state type() { self.parse_type(); transition self.status==0 { true -> store_kind() _ -> done() } }
    state store_kind() { transition kind==1 { true -> store_machine() _ -> store_block() } }
    state store_machine() {
        self.x=self.machine_parameter_count;
        self.tables[59296+self.x]=owner; self.tables[61344+self.x]=self.current_parameter_count;
        self.tables[63392+self.x]=self.raw_type_result;
        self.tables[67488+self.x]=self.parameter_name_start-self.tables[336+self.current_source];
        self.tables[69536+self.x]=self.parameter_name_len;
        self.machine_parameter_count=self.machine_parameter_count+1;
        transition self.tables[114592+self.raw_type_result]==7 { true -> version_four() _ -> stored() }
    }
    state store_block() {
        self.x=self.block_parameter_count;
        self.tables[90016+self.x]=owner; self.tables[94112+self.x]=self.current_parameter_count;
        self.tables[98208+self.x]=self.raw_type_result;
        self.tables[106400+self.x]=self.parameter_name_start-self.tables[336+self.current_source];
        self.tables[110496+self.x]=self.parameter_name_len;
        self.block_parameter_count=self.block_parameter_count+1;
        transition self.tables[114592+self.raw_type_result]==7 { true -> version_four() _ -> stored() }
    }
    state version_four() { transition self.resolution_version==5 { true -> stored() _ -> version_four_save() } }
    state version_four_save() { self.resolution_version=4; transition 0 { _ -> stored() } }
    state stored() { self.current_parameter_count=self.current_parameter_count+1; transition 0 { _ -> tail() } }
    state close() { self.expect_token(41); transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::skip_balanced_body(&mut self) {
    self.depth=1; self.saved_start=0-1;
    transition 0 { _ -> loop() }
    state loop() { transition self.tok==0 { true -> bad() _ -> self_check() } }
    state self_check() { self.token_word(30,4); transition self.match_ok==1 { true -> self_reference() _ -> open() } }
    state self_reference() { self.scan_self_call(); transition self.status==0 { true -> loop() _ -> done() } }
    state open() { transition self.tok==123 { true -> open_add() _ -> close() } }
    state open_add() { self.depth=self.depth+1; self.next_token(); transition 0 { _ -> loop() } }
    state close() { transition self.tok==125 { true -> close_sub() _ -> advance() } }
    state close_sub() { self.depth=self.depth-1; transition self.depth==0 { true -> complete() _ -> close_advance() } }
    state close_advance() { self.next_token(); transition 0 { _ -> loop() } }
    state advance() { self.next_token(); transition self.status==0 { true -> loop() _ -> done() } }
    state complete() { self.saved_start=self.tok_start; self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_requirement_call_arguments(&mut self) {
    self.expect_token(40); transition self.status==0 { true -> literal() _ -> done() }
    state literal() { transition self.tok==257 { true -> literal_value() _ -> bad() } }
    state literal_value() { transition (self.int_high==0)*(self.int_value==70) { true -> literal_next() _ -> bad() } }
    state literal_next() { self.next_token(); self.expect_token(41); transition self.status==0 { true -> semicolon() _ -> done() } }
    state semicolon() { self.expect_token(59); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::scan_self_call(&mut self) {
    // The caller has already matched the builtin receiver token.  Consume only
    // enough lookahead to distinguish `self.name(` and the one admitted field
    // receiver `self.field.name(` from all other field/path access.  The exact
    // role-3 reference span remains the authored machine-name token.
    self.next_token(); transition self.status==0 { true -> dot() _ -> done() }
    state dot() { transition self.tok==46 { true -> name_begin() _ -> done() } }
    state name_begin() { self.next_token(); transition self.tok==256 { true -> name_save() _ -> done() } }
