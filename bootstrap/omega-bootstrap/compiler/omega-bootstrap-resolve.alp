    }
    state provider_rows_check() { transition self.resolution_version==6 { true -> trait_row() _ -> done() } }
    state trait_row() {
        self.emit_u32(0); self.emit_u32(self.tables[262700]); self.emit_u32(self.tables[262701]);
        self.emit_u32(self.tables[262702]); self.emit_u32(self.tables[262703]);
        write_byte(self.tables[262704]); write_byte(0); write_byte(0); write_byte(0);
        transition 0 { _ -> requirement_row() }
    }
    state requirement_row() {
        self.emit_u32(0); self.emit_u32(self.tables[262705]); self.emit_u32(self.tables[262706]);
        self.emit_u32(self.tables[262707]); self.emit_u32(self.tables[262708]); self.emit_u32(self.tables[262709]);
        self.emit_u32(self.tables[262710]); self.emit_u32(self.tables[262711]);
        self.emit_u32(self.tables[262712]); self.emit_u32(self.tables[262713]);
