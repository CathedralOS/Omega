    state field_type_kind() { transition self.tables[114592+self.raw_type_result]==7 { true -> bad() _ -> field_type_save() } }
    state field_type_save() { self.tables[41504+self.field_count]=self.raw_type_result; self.field_count=self.field_count+1; self.tables[33056+self.current_record]=self.tables[33056+self.current_record]+1; self.expect_token(59); transition self.status==0 { true -> record_fields() _ -> done() } }
