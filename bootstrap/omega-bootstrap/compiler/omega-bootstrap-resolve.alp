machine Main::find_data_identity(&mut self, source: i32, start: i32, count: i32) {
    self.result_id=0-1; self.found_count=0; self.i=0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i<self.declaration_count { true -> kind() _ -> done() } }
    state kind() { transition self.tables[31008+self.i]==1 { true -> package() _ -> sum_kind() } }
    state sum_kind() { transition self.tables[31008+self.i]==3 { true -> package() _ -> trait_kind() } }
    state trait_kind() { transition self.tables[31008+self.i]==4 { true -> package() _ -> next() } }
    state package() { self.x=self.tables[31520+self.i]; transition self.tables[32+self.x]==self.tables[32+source] { true -> module() _ -> next() } }
    state module() { transition self.tables[64+self.x]==self.tables[64+source] { true -> length() _ -> next() } }
    state length() { transition self.tables[32288+self.i]==count { true -> bytes() _ -> next() } }
    state bytes() { self.spans_equal(self.tables[336+self.x]+self.tables[32032+self.i],start,count); transition self.match_ok==1 { true -> found() _ -> next() } }
    state found() { self.result_id=self.i; self.found_count=self.found_count+1; transition 0 { _ -> next() } }
    state next() { self.i=self.i+1; transition 0 { _ -> loop() } }
    state done() { }
}

