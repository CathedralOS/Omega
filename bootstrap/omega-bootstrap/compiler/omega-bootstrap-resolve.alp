    self.words[149]=114; self.words[150]=101; self.words[151]=116; self.words[152]=117; self.words[153]=114; self.words[154]=110; self.words[155]=95; self.words[156]=99; self.words[157]=111; self.words[158]=100; self.words[159]=101;
