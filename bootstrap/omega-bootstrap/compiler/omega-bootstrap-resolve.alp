        self.emit_u32(self.tables[65440+self.i]); self.emit_u32(self.tables[67488+self.i]); self.emit_u32(self.tables[69536+self.i]);
        self.i=self.i+1; transition 0 { _ -> machine_params() }
    }
    state blocks_begin() { self.i=0; transition 0 { _ -> blocks() } }
    state blocks() { transition self.i<self.block_count { true -> block() _ -> block_params_begin() } }
    state block() {
        self.emit_u32(self.i); self.emit_u32(self.tables[71584+self.i]); self.emit_u32(self.tables[73632+self.i]);
        write_byte(self.tables[75680+self.i]); write_byte(0); write_byte(0); write_byte(0);
        self.emit_u32(self.tables[77728+self.i]); self.emit_u32(self.tables[79776+self.i]);
        self.emit_u32(self.tables[81824+self.i]); self.emit_u32(self.tables[83872+self.i]);
        self.emit_u32(self.tables[85920+self.i]); self.emit_u32(self.tables[87968+self.i]);
