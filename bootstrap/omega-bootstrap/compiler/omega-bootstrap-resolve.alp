        self.emit_u32(self.tables[262726]); self.emit_u32(self.tables[262727]); self.emit_u32(self.tables[262728]);
        self.emit_u32(self.tables[262729]); self.emit_u32(self.tables[262730]); self.emit_u32(self.tables[262731]);
        self.emit_u32(self.tables[262732]); self.emit_u32(self.tables[262733]); self.emit_u32(self.tables[262734]);
        transition 0 { _ -> realization_parameter_row() }
