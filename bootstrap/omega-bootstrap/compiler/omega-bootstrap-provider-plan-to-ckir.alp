    self.emit_operation_head(8,0,4); self.emit_operation_shape(1,1,28); self.emit3(2,9,0); self.emit_u32(10); self.emit_u32(0);
    self.emit_operation_head(9,0,5); self.emit_operation_shape(30,1,29); self.emit3(4,9,1); self.emit_u32(0); self.emit_u32(0);
    self.emit_operation_head(10,0,5); self.emit_operation_shape(29,0,0-1); self.emit3(0-1,10,2); self.emit_u32(0); self.emit_u32(0);
    self.emit_operation_head(11,1,7); self.emit_operation_shape(1,1,30); self.emit3(1,12,0); self.emit_u32(0); self.emit_u32(0);
    self.emit_operation_head(12,1,7); self.emit_operation_shape(28,0,0-1); self.emit3(0-1,12,3); self.emit_u32(0); self.emit_u32(0);
