    self.emit_operation_head(14,2,8); self.emit_operation_shape(28,0,0-1); self.emit3(0-1,15,3); self.emit_u32(0); self.emit_u32(0);
}

machine Main::publish_operands(&mut self) {
    self.emit_u32(1); self.emit_u32(8); self.emit_u32(8); self.emit_u32(11); self.emit_u32(10); self.emit_u32(24); self.emit_u32(12); self.emit_u32(15); self.emit_u32(15); self.emit_u32(20); self.emit_u32(19); self.emit_u32(29);
    self.emit_u32(3); self.emit_u32(4); self.emit_u32(30); self.emit_u32(5); self.emit_u32(6); self.emit_u32(31);
    self.emit_u32(0); self.emit_u32(1); self.emit_u32(2); self.emit_u32(0); self.emit_u32(2); self.emit_u32(7); self.emit_u32(22); self.emit_u32(23); self.emit_u32(9); self.emit_u32(10); self.emit_u32(12); self.emit_u32(13); self.emit_u32(10); self.emit_u32(13); self.emit_u32(14); self.emit_u32(26); self.emit_u32(27); self.emit_u32(16); self.emit_u32(17); self.emit_u32(28);
}

machine Main::emit_term_head(&mut self, id: i32, owner: i32, kind: i32) { self.emit3(id,owner,id); write_byte(kind); write_byte(0); self.emit_u16(0); }
machine Main::emit_term_tail(&mut self) { self.emit_u32(0); self.emit_u32(0); }

machine Main::publish_terminators(&mut self) {
    self.emit_term_head(0,0,2); self.emit3(21,1,18); self.emit3(3,4,21); self.emit_u32(2); self.emit_term_tail();
    self.emit_term_head(1,0,1); self.emit3(0-1,2,23); self.emit3(4,0-1,27); self.emit_u32(0); self.emit_term_tail();
    self.emit_term_head(2,0,2); self.emit3(25,3,27); self.emit3(3,4,30); self.emit_u32(2); self.emit_term_tail();
    self.emit_term_head(3,0,1); self.emit3(0-1,2,32); self.emit3(4,0-1,36); self.emit_u32(0); self.emit_term_tail();
    self.emit_term_head(4,0,2); self.emit3(18,5,36); self.emit3(2,6,38); self.emit_u32(0); self.emit_term_tail();
    self.emit_term_head(5,0,1); self.emit3(0-1,6,38); self.emit3(0,0-1,38); self.emit_u32(0); self.emit_term_tail();
    self.emit_term_head(6,0,3); self.emit3(0-1,0-1,38); self.emit3(0,0-1,38); self.emit_u32(0); self.emit_term_tail();
    self.emit_term_head(7,1,3); self.emit3(0-1,0-1,38); self.emit3(0,0-1,38); self.emit_u32(0); self.emit_term_tail();
    self.emit_term_head(8,2,3); self.emit3(0-1,0-1,38); self.emit3(0,0-1,38); self.emit_u32(0); self.emit_term_tail();
}

machine Main::publish_relation(&mut self) {
    self.emit3(0,0,0); self.emit3(0,1,0);
    self.emit3(0,0,0); self.emit3(1,1,0); self.emit3(2,2,0);
    self.emit3(0,0,1); self.emit_u32(1); self.emit_u32(1);
    self.emit3(0,0,4); self.emit3(4,4,0); self.emit3(4,0-1,2);
}

machine Main::publish(&mut self) {
    self.publish_header(); self.publish_types(); self.publish_machines();
    self.publish_machine_params(); self.publish_blocks(); self.publish_block_params();
    self.publish_operations(); self.publish_operands(); self.publish_terminators();
    self.publish_relation();
}

machine Main::main(&mut self) {
    self.status=0; self.slurp();
    transition self.status == 0 { true -> outer() _ -> done() }
    state outer() { self.validate_outer(); transition self.status == 0 { true -> compilation() _ -> done() } }
    state compilation() { self.validate_compilation(); transition self.status == 0 { true -> bundle() _ -> done() } }
    state bundle() { self.decode_bundle(); transition self.status == 0 { true -> witness_header() _ -> done() } }
    state witness_header() { self.validate_witness_header(); transition self.status == 0 { true -> units() _ -> done() } }
    state units() { self.validate_units(); transition self.status == 0 { true -> relation() _ -> done() } }
    state relation() { self.validate_selected_relation(); transition self.status == 0 { true -> relation_rows() _ -> done() } }
    state relation_rows() { self.validate_relation_rows(); transition self.status == 0 { true -> plan_rows() _ -> done() } }
    state plan_rows() { self.validate_plan_rows(); transition self.status == 0 { true -> cast0() _ -> done() } }
    state cast0() { self.validate_cast_call(0); transition self.status == 0 { true -> cast1() _ -> done() } }
    state cast1() { self.validate_cast_call(1); transition self.status == 0 { true -> emit() _ -> done() } }
    state emit() { self.publish(); transition 0 { _ -> done() } }
    state done() { self.console.exit_process(self.status); }
}
