machine Main::emit_operation_head(&mut self, id: i32, owner: i32, block: i32) { self.emit3(id,owner,block); }
machine Main::emit_operation_shape(&mut self, opcode: i32, result_kind: i32, result: i32) { write_byte(opcode); write_byte(result_kind); self.emit_u16(0); self.emit_u32(result); }

machine Main::publish_operations(&mut self) {
    self.emit_operation_head(0,0,0); self.emit_operation_shape(23,1,21); self.emit3(1,0,1); self.emit_u32(0); self.emit_u32(0);
