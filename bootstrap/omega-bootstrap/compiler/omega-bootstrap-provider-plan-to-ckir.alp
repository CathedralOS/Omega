    self.emit_operation_head(2,0,1); self.emit_operation_shape(25,1,23); self.emit3(3,2,1); self.emit_u32(0); self.emit_u32(0);
    self.emit_operation_head(3,0,2); self.emit_operation_shape(30,1,24); self.emit3(4,3,1); self.emit_u32(0); self.emit_u32(0);
