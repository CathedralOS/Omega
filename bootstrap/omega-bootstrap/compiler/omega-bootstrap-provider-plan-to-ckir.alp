machine Main::publish_block_params(&mut self) {
    self.emit3(0,1,0); self.emit_u32(5); self.emit_u32(7); self.emit3(1,1,1); self.emit_u32(3); self.emit_u32(8); self.emit3(2,1,2); self.emit_u32(1); self.emit_u32(9);
    self.emit3(3,2,0); self.emit_u32(5); self.emit_u32(10); self.emit3(4,2,1); self.emit_u32(2); self.emit_u32(11); self.emit3(5,2,2); self.emit_u32(3); self.emit_u32(12); self.emit3(6,2,3); self.emit_u32(1); self.emit_u32(13);
