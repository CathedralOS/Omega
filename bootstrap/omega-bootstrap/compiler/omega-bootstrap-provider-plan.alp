machine Main::map_source_contents(&mut self) {
    self.i=0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.source_count { true -> copy() _ -> done() } }
    state copy() {
        self.j=self.source_bundles[self.i];
        self.source_content_starts[self.i]=self.bundle_content_starts[self.j];
        self.source_content_lengths[self.i]=self.bundle_content_lengths[self.j];
        self.i=self.i+1; transition 0 { _ -> loop() }
    }
    state done() { }
}

machine Main::validate_provider_graph(&mut self) {
    transition self.package_count == 2 { true -> sources() _ -> bad() }
    state sources() { transition self.source_count == 4 { true -> aliases() _ -> bad() } }
    state aliases() { transition self.alias_count == 1 { true -> build_distinct() _ -> bad() } }
    state build_distinct() { transition self.build_source == self.root_source { true -> bad() _ -> build_owner() } }
    state build_owner() { transition self.source_owners[self.build_source] == self.root_package { true -> root_owner() _ -> bad() } }
    state root_owner() { transition self.source_owners[self.root_source] == self.root_package { true -> alias_requester() _ -> bad() } }
    state alias_requester() { transition self.alias_requesters[0] == self.root_package { true -> alias_other() _ -> bad() } }
    state alias_other() { self.x=1-self.root_package; transition self.alias_targets[0] == self.x { true -> count_begin() _ -> bad() } }
    state count_begin() { self.i=0; self.count=0; self.expected=0; transition 0 { _ -> count_loop() } }
    state count_loop() { transition self.i < self.source_count { true -> owner() _ -> owner_counts() } }
    state owner() { transition self.source_owners[self.i] == self.root_package { true -> root_count() _ -> other_owner() } }
    state root_count() { self.count=self.count+1; self.i=self.i+1; transition 0 { _ -> count_loop() } }
    state other_owner() { transition self.source_owners[self.i] == self.x { true -> other_count() _ -> bad() } }
    state other_count() { self.expected=self.expected+1; self.i=self.i+1; transition 0 { _ -> count_loop() } }
    state owner_counts() { transition self.count == 2 { true -> other_count_exact() _ -> bad() } }
    state other_count_exact() { transition self.expected == 2 { true -> root_modules() _ -> bad() } }
    state root_modules() { transition self.source_modules[self.build_source] == self.source_modules[self.root_source] { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_identifier_start(&mut self) {
    self.match_ok=0;
    transition self.c == 95 { true -> yes() _ -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() _ -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() _ -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() _ -> done() } }
    state lower1() { transition self.c < 123 { true -> yes() _ -> done() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_identifier_continue(&mut self) {
    self.is_identifier_start();
    transition self.match_ok == 1 { true -> done() _ -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() _ -> done() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::skip_source_block_comment(&mut self) {
    self.pos=self.pos+2; self.depth=1;
    transition 0 { _ -> loop() }
    state loop() { transition self.pos < self.token_limit { true -> byte() _ -> bad() } }
    state byte() { self.c=self.input[self.pos]; transition self.c == 47 { true -> open_room() _ -> close0() } }
    state open_room() { transition self.pos + 1 < self.token_limit { true -> open1() _ -> advance() } }
    state open1() { transition self.input[self.pos+1] == 42 { true -> open() _ -> advance() } }
    state open() { self.depth=self.depth+1; self.pos=self.pos+2; transition 0 { _ -> loop() } }
    state close0() { transition self.c == 42 { true -> close_room() _ -> advance() } }
    state close_room() { transition self.pos + 1 < self.token_limit { true -> close1() _ -> advance() } }
    state close1() { transition self.input[self.pos+1] == 47 { true -> close() _ -> advance() } }
    state close() { self.depth=self.depth-1; self.pos=self.pos+2; transition self.depth == 0 { true -> done() _ -> loop() } }
    state advance() { self.pos=self.pos+1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

// Token kinds are EOF 0, word/number 256, quoted string contents 258, and
// single-byte ASCII punctuation. Operators remain grammar punctuation.
machine Main::next_source_token(&mut self) {
    self.tok=0; self.tok_len=0;
    transition self.status == 0 { true -> skip() _ -> done() }
    state skip() { transition self.pos < self.token_limit { true -> skip_byte() _ -> eof() } }
    state skip_byte() { self.c=self.input[self.pos]; transition self.c == 32 { true -> skip_one() _ -> lf() } }
    state lf() { transition self.c == 10 { true -> skip_one() _ -> cr() } }
    state cr() { transition self.c == 13 { true -> skip_one() _ -> tab() } }
    state tab() { transition self.c == 9 { true -> skip_one() _ -> slash() } }
    state skip_one() { self.pos=self.pos+1; transition 0 { _ -> skip() } }
    state slash() { transition self.c == 47 { true -> slash_room() _ -> classify() } }
    state slash_room() { transition self.pos + 1 < self.token_limit { true -> slash_second() _ -> classify() } }
    state slash_second() { transition self.input[self.pos+1] == 47 { true -> line_begin() _ -> block_second() } }
    state block_second() { transition self.input[self.pos+1] == 42 { true -> block() _ -> classify() } }
    state block() { self.skip_source_block_comment(); transition self.status == 0 { true -> skip() _ -> done() } }
    state line_begin() { self.pos=self.pos+2; transition 0 { _ -> line() } }
    state line() { transition self.pos < self.token_limit { true -> line_byte() _ -> eof() } }
    state line_byte() { transition self.input[self.pos] == 10 { true -> skip_one() _ -> line_next() } }
    state line_next() { self.pos=self.pos+1; transition 0 { _ -> line() } }
    state classify() { self.tok_start=self.pos; transition self.c == 34 { true -> string_begin() _ -> ident_test() } }
    state ident_test() { self.is_identifier_start(); transition self.match_ok == 1 { true -> word_begin() _ -> digit0() } }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> ascii() } }
    state digit1() { transition self.c < 58 { true -> word_begin() _ -> ascii() } }
    state word_begin() { self.pos=self.pos+1; transition 0 { _ -> word_loop() } }
    state word_loop() { transition self.pos < self.token_limit { true -> word_byte() _ -> word_done() } }
    state word_byte() { self.c=self.input[self.pos]; self.is_identifier_continue(); transition self.match_ok == 1 { true -> word_capacity() _ -> word_done() } }
    state word_capacity() { transition self.pos - self.tok_start < 64 { true -> word_next() _ -> exhausted() } }
    state word_next() { self.pos=self.pos+1; transition 0 { _ -> word_loop() } }
    state word_done() { self.tok=256; self.tok_len=self.pos-self.tok_start; transition 0 { _ -> done() } }
    state string_begin() { self.pos=self.pos+1; self.tok_start=self.pos; transition 0 { _ -> string_loop() } }
    state string_loop() { transition self.pos < self.token_limit { true -> string_byte() _ -> bad() } }
    state string_byte() { self.c=self.input[self.pos]; transition self.c == 34 { true -> string_done() _ -> string_escape() } }
    state string_escape() { transition self.c == 92 { true -> bad() _ -> string_ascii() } }
    state string_ascii() { transition self.c < 128 { true -> string_capacity() _ -> bad() } }
    state string_capacity() { transition self.pos - self.tok_start < 32 { true -> string_next() _ -> exhausted() } }
    state string_next() { self.pos=self.pos+1; transition 0 { _ -> string_loop() } }
    state string_done() { self.tok=258; self.tok_len=self.pos-self.tok_start; self.pos=self.pos+1; transition 0 { _ -> done() } }
    state ascii() { transition self.c < 128 { true -> punctuation() _ -> bad() } }
    state punctuation() { self.tok=self.c; self.tok_len=1; self.pos=self.pos+1; transition 0 { _ -> done() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state eof() { self.tok=0; self.tok_start=self.pos; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::token_word(&mut self, base: i32, count: i32) {
    self.match_ok=0; self.scan_index=0;
    transition self.tok == 256 { true -> length() _ -> done() }
    state length() { transition self.tok_len == count { true -> loop() _ -> done() } }
    state loop() { transition self.scan_index < count { true -> byte() _ -> yes() } }
    state byte() { transition self.input[self.tok_start+self.scan_index] == self.words[base+self.scan_index] { true -> advance() _ -> done() } }
    state advance() { self.scan_index=self.scan_index+1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::token_string(&mut self, base: i32, count: i32) {
    self.match_ok=0; self.scan_index=0;
    transition self.tok == 258 { true -> length() _ -> done() }
    state length() { transition self.tok_len == count { true -> loop() _ -> done() } }
    state loop() { transition self.scan_index < count { true -> byte() _ -> yes() } }
    state byte() { transition self.input[self.tok_start+self.scan_index] == self.words[base+self.scan_index] { true -> advance() _ -> done() } }
    state advance() { self.scan_index=self.scan_index+1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_source_token(&mut self, expected_token: i32) {
    transition self.tok == expected_token { true -> advance() _ -> bad() }
    state advance() { self.next_source_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_source_word(&mut self, base: i32, count: i32) {
    self.token_word(base,count);
    transition self.match_ok == 1 { true -> advance() _ -> bad() }
    state advance() { self.next_source_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

// A production program is selected only after its enclosing declaration or
// semantic node has been structurally identified. Punctuation is stored as
// its token byte; a word is 256 + vocabulary_base * 128 + vocabulary_length.
// Programs never cross a declaration boundary and contain no source ordinals.
machine Main::expect_production(&mut self, production_start: i32, production_count: i32) {
    self.production_cursor=production_start;
    self.production_end=production_start+production_count;
    transition 0 { _ -> loop() }
    state loop() { transition self.production_cursor < self.production_end { true -> one() _ -> done() } }
    state one() {
        self.production_code=self.productions[self.production_cursor];
        transition self.production_code < 0 { true -> action() _ -> string_test() }
    }
    state string_test() { transition self.production_code >= 100000 { true -> string() _ -> punctuation_test() } }
    state punctuation_test() { transition self.production_code < 256 { true -> punctuation() _ -> word() } }
    state punctuation() { transition self.tok == self.production_code { true -> advance() _ -> bad() } }
    state word() {
        self.production_base=self.production_code-256;
        self.production_length=self.production_base%128;
        self.production_base=self.production_base/128;
        self.token_word(self.production_base,self.production_length);
        transition self.match_ok == 1 { true -> advance() _ -> bad() }
    }
    state string() {
        self.production_base=self.production_code-100000;
        self.production_length=self.production_base%128;
        self.production_base=self.production_base/128;
        self.token_string(self.production_base,self.production_length);
        transition self.match_ok == 1 { true -> advance() _ -> bad() }
    }
    state action() {
        self.production_code=0-self.production_code-1;
        self.action_slot=self.production_code%96;
        self.action_kind=self.production_code/96;
        transition self.action_kind == 0 { true -> capture_token() _ -> action_start_test() }
    }
    state capture_token() {
        self.spans[self.action_slot*2]=self.tok_start-self.source_base;
        self.spans[self.action_slot*2+1]=self.tok_len;
        transition 0 { _ -> action_next() }
    }
    state action_start_test() { transition self.action_kind == 1 { true -> capture_start() _ -> capture_end() } }
    state capture_start() {
        self.spans[self.action_slot*2]=self.tok_start-self.source_base;
        transition 0 { _ -> action_next() }
    }
    state capture_end() {
        self.spans[self.action_slot*2+1]=self.tok_start+self.tok_len-self.source_base-self.spans[self.action_slot*2];
        transition 0 { _ -> action_next() }
    }
    state action_next() { self.production_cursor=self.production_cursor+1; transition 0 { _ -> loop() } }
    state advance() {
        self.production_cursor=self.production_cursor+1;
        self.next_source_token(); transition 0 { _ -> loop() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::match_word_choices(&mut self, production_start: i32, production_count: i32) {
    self.current_identity=0-1; self.choice_start=production_start;
    self.choice_cursor=production_start; self.choice_end=production_start+production_count;
    transition 0 { _ -> loop() }
    state loop() { transition self.choice_cursor < self.choice_end { true -> one() _ -> done() } }
    state one() {
        self.production_code=self.productions[self.choice_cursor]-256;
        self.production_length=self.production_code%128;
        self.production_base=self.production_code/128;
        self.token_word(self.production_base,self.production_length);
        transition self.match_ok == 1 { true -> found() _ -> next() }
    }
    state found() { self.current_identity=self.choice_cursor-self.choice_start; transition 0 { _ -> done() } }
    state next() { self.choice_cursor=self.choice_cursor+1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::save_declaration_name(&mut self, identity: i32) {
    transition self.declaration_seen[identity] == 0 { true -> save() _ -> bad() }
    state save() {
        self.declaration_seen[identity]=1; self.declaration_sources[identity]=self.current_source;
        self.declaration_name_starts[identity]=self.tok_start-self.source_base;
        self.declaration_name_lengths[identity]=self.tok_len; transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_byte_read_data(&mut self) {
    self.save_declaration_name(0); self.next_source_token(); self.expect_production(764,22);
    self.declaration_body_starts[0]=self.spans[86];
    self.declaration_body_lengths[0]=self.spans[87];
}

machine Main::parse_provider_data(&mut self) {
    self.save_declaration_name(2); self.next_source_token(); self.expect_production(786,4);
    self.declaration_body_starts[2]=self.spans[88];
    self.declaration_body_lengths[2]=self.spans[89];
}

machine Main::parse_main_data(&mut self) {
    self.save_declaration_name(11); self.next_source_token(); self.expect_production(790,8);
    self.declaration_body_starts[11]=self.spans[90];
    self.declaration_body_lengths[11]=self.spans[91];
}

machine Main::parse_data_declaration(&mut self) {
    self.next_source_token(); transition self.tok == 256 { true -> byte_read() _ -> bad() }
    state byte_read() { self.token_word(7,8); transition self.match_ok == 1 { true -> byte_read_source() _ -> provider() } }
    state byte_read_source() { transition self.source_owners[self.current_source] == self.root_package { true -> bad() _ -> byte_read_public() } }
    state byte_read_public() { transition self.current_visibility == 1 { true -> byte_read_parse() _ -> bad() } }
    state byte_read_parse() { self.console_source=self.current_source; self.parse_byte_read_data(); transition 0 { _ -> done() } }
    state provider() { self.token_word(159,21); transition self.match_ok == 1 { true -> provider_source() _ -> main_data() } }
    state provider_source() { transition self.source_owners[self.current_source] == self.root_package { true -> bad() _ -> provider_private() } }
    state provider_private() { transition self.current_visibility == 0 { true -> provider_parse() _ -> bad() } }
    state provider_parse() { self.parse_provider_data(); transition 0 { _ -> done() } }
    state main_data() { self.token_word(439,4); transition self.match_ok == 1 { true -> main_source() _ -> bad() } }
    state main_source() { transition self.current_source == self.root_source { true -> main_private() _ -> bad() } }
    state main_private() { transition self.current_visibility == 0 { true -> main_parse() _ -> bad() } }
    state main_parse() { self.parse_main_data(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_shared_u8_type(&mut self) {
    self.expect_production(24,4);
}

machine Main::parse_mutable_u8_type(&mut self) {
    self.expect_production(28,5);
}




machine Main::parse_console_trait(&mut self) {
    transition self.current_visibility == 1 { true -> source_kind() _ -> bad() }
    state source_kind() { transition self.source_owners[self.current_source] == self.root_package { true -> bad() _ -> prefix() } }
    state prefix() { self.expect_production(38,2); transition self.status == 0 { true -> name() _ -> done() } }
    state name() { self.token_word(51,7); transition self.match_ok == 1 { true -> parse() _ -> bad() } }
    state parse() {
        self.save_declaration_name(1); self.next_source_token(); self.expect_production(798,91);
        self.declaration_body_starts[1]=self.spans[92];
        self.declaration_body_lengths[1]=self.spans[93]; self.i=0;
        transition self.status == 0 { true -> captures() _ -> done() }
    }
    state captures() { transition self.i < 6 { true -> capture() _ -> done() } }
    state capture() {
        self.requirement_seen[self.i]=1;
        self.requirement_name_starts[self.i]=self.spans[(20+self.i)*2];
        self.requirement_name_lengths[self.i]=self.spans[(20+self.i)*2+1];
        self.requirement_param_starts[self.i]=self.spans[(26+self.i)*2];
        self.requirement_param_lengths[self.i]=self.spans[(26+self.i)*2+1];
        self.requirement_reach_starts[self.i]=self.spans[(32+self.i)*2];
        self.requirement_reach_lengths[self.i]=self.spans[(32+self.i)*2+1];
        self.i=self.i+1; transition 0 { _ -> captures() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::match_target_identity(&mut self) {
    self.match_word_choices(338,4);
}


machine Main::parse_target_candidate(&mut self) {
    transition self.source_owners[self.current_source] == self.root_package { true -> bad() _ -> source_identity() }
    state source_identity() { transition self.target_count == 0 { true -> source_first() _ -> source_same() } }
    state source_first() { self.target_source=self.current_source; transition 0 { _ -> prefix() } }
    state source_same() { transition self.current_source == self.target_source { true -> prefix() _ -> bad() } }
    state prefix() { self.expect_production(47,5); transition self.status == 0 { true -> identity() _ -> done() } }
    state identity() { self.match_target_identity(); transition self.current_identity >= 0 { true -> unique() _ -> bad() } }
    state unique() { transition self.target_seen[self.current_identity] == 0 { true -> save() _ -> bad() } }
    state save() {
        self.target_seen[self.current_identity]=1;
        self.target_ordinals[self.current_identity]=self.target_count;
        self.target_count=self.target_count+1; self.y=self.current_identity;
        self.save_declaration_name(6+self.y); self.next_source_token();
        transition self.y == 0 { true -> read_line() _ -> read_byte_test() }
    }
    state read_line() { self.expect_production(889,21); transition 0 { _ -> capture() } }
    state read_byte_test() { transition self.y == 1 { true -> read_byte_case() _ -> write_byte_test() } }
    state read_byte_case() { self.expect_production(910,16); transition 0 { _ -> capture() } }
    state write_byte_test() { transition self.y == 2 { true -> write_byte_case() _ -> exit_case() } }
    state write_byte_case() { self.expect_production(926,17); transition 0 { _ -> capture() } }
    state exit_case() { self.expect_production(943,17); transition 0 { _ -> capture() } }
    state capture() {
        self.target_param_starts[self.y]=self.spans[(39+self.y)*2];
        self.target_param_lengths[self.y]=self.spans[(39+self.y)*2+1];
        transition self.status == 0 { true -> done() _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_build_machine(&mut self) {
    transition self.current_source == self.build_source { true -> private() _ -> bad() }
    state private() { transition self.current_visibility == 0 { true -> parse() _ -> bad() } }
    state parse() {
        self.save_declaration_name(10); self.next_source_token();
        self.expect_production(344,31);
        self.application_start=self.spans[0]; self.application_length=self.spans[1];
        self.selection_start=self.spans[2]; self.selection_length=self.spans[3];
        transition self.status == 0 { true -> done() _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}



machine Main::parse_app_main_machine(&mut self) {
    transition self.current_source == self.root_source { true -> private() _ -> bad() }
    state private() { transition self.current_visibility == 0 { true -> parse() _ -> bad() } }
    state parse() {
        self.save_declaration_name(12); self.next_source_token();
        self.expect_production(375,100); self.i=2;
        transition self.status == 0 { true -> calls() _ -> done() }
    }
    state calls() { transition self.i < 6 { true -> call() _ -> done() } }
    state call() {
        self.requirement_call_starts[self.i]=self.spans[(self.i+2)*2];
        self.requirement_call_lengths[self.i]=self.spans[(self.i+2)*2+1];
        self.i=self.i+1; transition 0 { _ -> calls() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_app_use(&mut self) {
    transition self.current_source == self.root_source { true -> unique() _ -> bad() }
    state unique() { transition self.app_use_seen == 0 { true -> path() _ -> bad() } }
    state path() { self.app_use_seen=1; self.expect_production(142,9); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}





machine Main::parse_console_write_bytes_helper(&mut self) {
    transition self.source_owners[self.current_source] == self.root_package { true -> bad() _ -> private() }
    state private() { transition self.current_visibility == 0 { true -> parse() _ -> bad() } }
    state parse() {
        self.console_source=self.current_source; self.save_declaration_name(3);
        self.next_source_token(); self.expect_production(475,217);
        self.declaration_body_starts[3]=self.spans[16];
        self.declaration_body_lengths[3]=self.spans[17];
        self.requirement_call_starts[0]=self.spans[4];
        self.requirement_call_lengths[0]=self.spans[5];
        self.requirement_call_starts[1]=self.spans[6];
        self.requirement_call_lengths[1]=self.spans[7];
        transition self.status == 0 { true -> done() _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::match_adapter_identity(&mut self) {
    self.match_word_choices(342,2);
}

machine Main::parse_checked_adapter(&mut self) {
    transition self.source_owners[self.current_source] == self.root_package { true -> bad() _ -> owner() }
    state owner() { self.expect_production(305,3); transition self.status == 0 { true -> identity() _ -> done() } }
    state identity() { self.match_adapter_identity(); transition self.current_identity >= 0 { true -> unique() _ -> bad() } }
    state unique() { transition self.adapter_seen[self.current_identity] == 0 { true -> save() _ -> bad() } }
    state save() {
        self.y=self.current_identity; self.adapter_seen[self.y]=1;
        self.adapter_ordinals[self.y]=self.adapter_count; self.adapter_by_ordinal[self.adapter_count]=self.y; self.adapter_count=self.adapter_count+1;
        self.save_declaration_name(4+self.y); self.next_source_token();
        transition self.y == 0 { true -> parse_write() _ -> parse_write_line() }
    }
    state parse_write() { self.expect_production(692,36); self.x=9; transition 0 { _ -> capture() } }
    state parse_write_line() { self.expect_production(728,36); self.x=13; transition 0 { _ -> capture() } }
    state capture() {
        self.adapter_console_starts[self.y]=self.spans[self.x*2];
        self.adapter_console_lengths[self.y]=self.spans[self.x*2+1];
        self.adapter_text_starts[self.y]=self.spans[(self.x+1)*2];
        self.adapter_text_lengths[self.y]=self.spans[(self.x+1)*2+1];
        self.adapter_call_starts[self.y]=self.spans[(self.x+2)*2];
        self.adapter_call_lengths[self.y]=self.spans[(self.x+2)*2+1];
        self.declaration_body_starts[4+self.y]=self.spans[(self.x+3)*2];
        self.declaration_body_lengths[4+self.y]=self.spans[(self.x+3)*2+1];
        transition self.status == 0 { true -> done() _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_machine_declaration(&mut self) {
    self.next_source_token(); transition self.tok == 256 { true -> build_check() _ -> bad() }
    state build_check() { self.token_word(355,5); transition self.match_ok == 1 { true -> build() _ -> helper_check() } }
    state build() { self.parse_build_machine(); transition 0 { _ -> done() } }
    state helper_check() { self.token_word(180,19); transition self.match_ok == 1 { true -> helper() _ -> provider_check() } }
    state helper() { self.parse_console_write_bytes_helper(); transition 0 { _ -> done() } }
    state provider_check() { self.token_word(159,21); transition self.match_ok == 1 { true -> provider() _ -> main_check() } }
    state provider() { self.parse_checked_adapter(); transition 0 { _ -> done() } }
    state main_check() { self.token_word(439,4); transition self.match_ok == 1 { true -> main_owner() _ -> bad() } }
    state main_owner() { self.next_source_token(); self.expect_production(330,2); transition self.status == 0 { true -> main_name() _ -> done() } }
    state main_name() { self.token_word(443,4); transition self.match_ok == 1 { true -> main() _ -> bad() } }
    state main() { self.parse_app_main_machine(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_semantic_source(&mut self) {
    self.source_base=self.source_content_starts[self.current_source]; self.pos=self.source_base;
    self.token_limit=self.source_base+self.source_content_lengths[self.current_source];
    self.current_visibility=0; self.next_source_token();
    transition self.status == 0 { true -> loop() _ -> done() }
    state loop() { transition self.tok == 0 { true -> done() _ -> visibility() } }
    state visibility() { self.current_visibility=0; self.token_word(0,3); transition self.match_ok == 1 { true -> public() _ -> use_check() } }
    state public() { self.current_visibility=1; self.next_source_token(); transition 0 { _ -> use_check() } }
    state use_check() { self.token_word(427,3); transition self.match_ok == 1 { true -> use_private() _ -> boundary_check() } }
    state use_private() { transition self.current_visibility == 0 { true -> use() _ -> bad() } }
    state use() { self.parse_app_use(); transition self.status == 0 { true -> loop() _ -> done() } }
    state boundary_check() { self.token_word(38,8); transition self.match_ok == 1 { true -> parse_boundary_decl() _ -> data_check() } }
    state parse_boundary_decl() { self.parse_console_trait(); transition self.status == 0 { true -> loop() _ -> done() } }
    state data_check() { self.token_word(3,4); transition self.match_ok == 1 { true -> data() _ -> machine_check() } }
    state data() { self.parse_data_declaration(); transition self.status == 0 { true -> loop() _ -> done() } }
    state machine_check() { self.token_word(58,7); transition self.match_ok == 1 { true -> parse_machine_decl() _ -> target_check() } }
    state parse_machine_decl() { self.parse_machine_declaration(); transition self.status == 0 { true -> loop() _ -> done() } }
    state target_check() { self.token_word(319,9); transition self.match_ok == 1 { true -> target_private() _ -> bad() } }
    state target_private() { transition self.current_visibility == 0 { true -> target() _ -> bad() } }
    state target() { self.parse_target_candidate(); transition self.status == 0 { true -> loop() _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_all_semantic_sources(&mut self) {
    self.current_source=0; self.console_source=0-1; self.target_source=0-1;
    transition 0 { _ -> loop() }
    state loop() { transition self.current_source < self.source_count { true -> one() _ -> done() } }
    state one() { self.parse_semantic_source(); transition self.status == 0 { true -> advance() _ -> done() } }
    state advance() { self.current_source=self.current_source+1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::validate_semantic_closure(&mut self) {
    self.i=0; transition 0 { _ -> seen() }
    state seen() { transition self.i < 25 { true -> seen_kind0() _ -> counts() } }
    state seen_kind0() { transition self.i < 13 { true -> declaration_seen() _ -> seen_kind1() } }
    state declaration_seen() { self.x=self.declaration_seen[self.i]; transition 0 { _ -> seen_value() } }
    state seen_kind1() { transition self.i < 19 { true -> requirement_seen() _ -> seen_kind2() } }
    state requirement_seen() { self.x=self.requirement_seen[self.i-13]; transition 0 { _ -> seen_value() } }
    state seen_kind2() { transition self.i < 21 { true -> adapter_seen() _ -> target_seen() } }
    state adapter_seen() { self.x=self.adapter_seen[self.i-19]; transition 0 { _ -> seen_value() } }
    state target_seen() { self.x=self.target_seen[self.i-21]; transition 0 { _ -> seen_value() } }
    state seen_value() { transition self.x == 1 { true -> seen_next() _ -> bad() } }
    state seen_next() { self.i=self.i+1; transition 0 { _ -> seen() } }
    state counts() { transition self.adapter_count == 2 { true -> target_count() _ -> bad() } }
    state target_count() { transition self.target_count == 4 { true -> use_seen() _ -> bad() } }
    state use_seen() { transition self.app_use_seen == 1 { true -> sources_begin() _ -> bad() } }
    state sources_begin() { self.i=0; transition 0 { _ -> sources() } }
    state sources() { transition self.i < 13 { true -> source_kind0() _ -> portable_owner() } }
    state source_kind0() { self.x=self.root_source; transition self.i < 6 { true -> source_portable() _ -> source_kind1() } }
    state source_portable() { self.x=self.console_source; transition 0 { _ -> source_value() } }
    state source_kind1() { transition self.i < 10 { true -> source_target() _ -> source_kind2() } }
    state source_target() { self.x=self.target_source; transition 0 { _ -> source_value() } }
    state source_kind2() { transition self.i == 10 { true -> source_build() _ -> source_value() } }
    state source_build() { self.x=self.build_source; transition 0 { _ -> source_value() } }
    state source_value() { transition self.declaration_sources[self.i] == self.x { true -> source_next() _ -> bad() } }
    state source_next() { self.i=self.i+1; transition 0 { _ -> sources() } }
    state portable_owner() { transition self.source_owners[self.console_source] == self.root_package { true -> bad() _ -> target_owner() } }
    state target_owner() { transition self.source_owners[self.target_source] == self.source_owners[self.console_source] { true -> module() _ -> bad() } }
    state module() { transition self.source_modules[self.target_source] == self.source_modules[self.console_source] { true -> distinct_sources() _ -> bad() } }
    state distinct_sources() { transition self.target_source == self.console_source { true -> bad() _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_u32(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
    write_byte((value >> 16) & 255); write_byte((value >> 24) & 255);
}








