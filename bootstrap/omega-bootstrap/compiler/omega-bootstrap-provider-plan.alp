machine Main::publish_witness(&mut self) {
    self.i=0; transition 0 { _ -> clear() }
    state clear() { transition self.i < 572 { true -> clear_one() _ -> fill_header() } }
    state clear_one() { self.publication[self.i]=0; self.i=self.i+1; transition 0 { _ -> clear() } }
    state fill_header() { self.fill_publication(); transition 0 { _ -> magic() } }
    state magic() {
        write_byte(79); write_byte(77); write_byte(71); write_byte(82);
        write_byte(83); write_byte(87); write_byte(57); write_byte(0);
        write_byte(9); write_byte(0); write_byte(0); write_byte(0);
        write_byte(0); write_byte(0); write_byte(144); write_byte(0);
        self.i=0; transition 0 { _ -> words() }
    }
    state words() { transition self.i < 572 { true -> word() _ -> done() } }
    state word() { self.emit_u32(self.publication[self.i]); self.i=self.i+1; transition 0 { _ -> words() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.status = 0;
    self.slurp();
    transition self.status == 0 { true -> header() _ -> done() }
    state header() { self.check_header(); transition self.status == 0 { true -> packages() _ -> done() } }
    state packages() { self.check_packages(); transition self.status == 0 { true -> sources() _ -> done() } }
    state sources() { self.check_sources(); transition self.status == 0 { true -> aliases() _ -> done() } }
    state aliases() { self.check_alias_rows(); transition self.status == 0 { true -> strings() _ -> done() } }
    state strings() { self.check_strings(); transition self.status == 0 { true -> roles() _ -> done() } }
    state roles() { self.check_string_roles(); transition self.status == 0 { true -> graph() _ -> done() } }
    state graph() { self.check_alias_order_graph(); transition self.status == 0 { true -> bundle() _ -> done() } }
    state bundle() { self.check_bundle(); transition self.status == 0 { true -> source_order() _ -> done() } }
    state source_order() { self.check_source_label_order(); transition self.status == 0 { true -> map_contents() _ -> done() } }
    state map_contents() { self.map_source_contents(); self.validate_provider_graph(); self.init_words(); self.init_productions(); transition self.status == 0 { true -> semantic_sources() _ -> done() } }
    state semantic_sources() { self.parse_all_semantic_sources(); transition self.status == 0 { true -> semantic_closure() _ -> done() } }
    state semantic_closure() { self.validate_semantic_closure(); transition self.status == 0 { true -> publish() _ -> done() } }
    state publish() { self.publish_witness(); transition 0 { _ -> done() } }
    state done() { self.console.exit_process(self.status); }
}
