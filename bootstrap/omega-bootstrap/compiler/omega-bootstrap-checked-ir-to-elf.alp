    state claim() { transition self.metadata_arena[106496 + 384 + self.i] == 1 { true -> claim_type() _ -> claim_next() } }
    state claim_type() { transition self.metadata_arena[73728 + self.metadata_arena[106496 + 0 + self.i]] == 1 { true -> claim_next() _ -> bad() } }
    state claim_next() { self.i = self.i + 1; transition 0 { _ -> claims_loop() } }
