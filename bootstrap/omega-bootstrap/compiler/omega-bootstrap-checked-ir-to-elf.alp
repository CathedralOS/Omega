    state less_result() { transition self.operation_arena[163840 + self.i] == self.bool_type { true -> advance() _ -> bad() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::validate_edge(&mut self, start: i32, count: i32, target: i32) {
    self.j = 0;
