    state candidate_loop() { transition self.i < self.machine_count { true -> candidate_params() _ -> candidate_relation() } }
    state candidate_params() { transition self.metadata_arena[106496 + 25728 + self.i] == 0 { true -> candidate_result() _ -> candidate_next() } }
    state candidate_result() { transition self.metadata_arena[106496 + 25472 + self.i] >= 0 { true -> candidate_scalar() _ -> candidate_next() } }
    state candidate_scalar() { transition self.metadata_arena[0 + self.metadata_arena[106496 + 25472 + self.i]] <= 3 { true -> candidate_add() _ -> candidate_next() } }
    state candidate_add() { self.candidate_count = self.candidate_count + 1; self.found = self.i; transition self.candidate_count <= 1 { true -> candidate_next() _ -> bad() } }
    state candidate_next() { self.i = self.i + 1; transition 0 { _ -> candidate_loop() } }
    state candidate_relation() { transition self.candidate_count == 0 { true -> candidate_absent() _ -> candidate_present() } }
    state candidate_absent() { transition self.flags == 0 { true -> done() _ -> bad() } }
    state candidate_present() { transition self.flags == 1 { true -> candidate_id() _ -> bad() } }
    state candidate_id() { transition self.entry_id == self.found { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::align_frame(&mut self, amount: i32) {
    self.pad = (amount - (self.frame_cursor % amount)) % amount;
    transition self.pad <= 262144 - self.frame_cursor { true -> keep() _ -> exhausted() }
    state keep() { self.frame_cursor = self.frame_cursor + self.pad; transition 0 { _ -> done() } }
    state exhausted() { self.exhaust(); }
    state done() { }
}

machine Main::assign_frame(&mut self) {
    self.current_machine = self.entry_id;
    self.owner_type = self.metadata_arena[106496 + 0 + self.metadata_arena[106496 + 25216 + self.entry_id]];
    transition self.metadata_arena[90112 + self.owner_type] == 1 { true -> data_cap() _ -> bad() }
