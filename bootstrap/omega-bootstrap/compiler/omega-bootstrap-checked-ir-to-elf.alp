    state value_structural() { self.align_frame(8); transition self.status == 0 { true -> value_structural_slot() _ -> done() } }
    state value_structural_slot() { transition self.frame_cursor <= 262144 - 8 { true -> value_structural_keep() _ -> exhausted() } }
    state value_structural_keep() { self.frame_cursor = self.frame_cursor + 8; self.value_arena[163840 + self.i] = self.frame_cursor; transition 0 { _ -> value_next() } }
    state value_next() { self.i = self.i + 1; transition 0 { _ -> values() } }
    state places_setup() { self.i = 0; transition 0 { _ -> places() } }
    state places() { transition self.i < self.place_count { true -> place_owner() _ -> scratch_scan() } }
    state place_owner() { transition self.metadata_arena[106496 + 38528 + self.value_arena[237568 + self.i]] == self.entry_id { true -> place_align() _ -> place_next() } }
