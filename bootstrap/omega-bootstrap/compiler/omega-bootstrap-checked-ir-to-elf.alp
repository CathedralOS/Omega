    state scratch_loop() { transition self.i < self.end { true -> scratch0() _ -> scratch_align() } }
    state scratch0() { transition self.metadata_arena[173696 + 8192 + self.i] > self.scratch_count { true -> scratch0_keep() _ -> scratch1() } }
    state scratch0_keep() { self.scratch_count = self.metadata_arena[173696 + 8192 + self.i]; transition 0 { _ -> scratch1() } }
    state scratch1() { transition self.metadata_arena[173696 + 14336 + self.i] > self.scratch_count { true -> scratch1_keep() _ -> scratch_next() } }
    state scratch1_keep() { self.scratch_count = self.metadata_arena[173696 + 14336 + self.i]; transition 0 { _ -> scratch_next() } }
    state scratch_next() { self.i = self.i + 1; transition 0 { _ -> scratch_loop() } }
    state scratch_align() { self.align_frame(8); transition self.status == 0 { true -> scratch_bound() _ -> done() } }
    state scratch_bound() { transition self.scratch_count <= (262144 - self.frame_cursor) / 8 { true -> scratch_keep() _ -> exhausted() } }
