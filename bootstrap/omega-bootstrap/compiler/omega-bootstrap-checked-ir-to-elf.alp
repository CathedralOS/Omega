// CKIR1 -> deterministic Linux x86-64 ELF. The complete wire and lowering
// contract is OMEGA_BOOTSTRAP_CHECKED_IR.md. Decode, semantic validation,
// layout, frame assignment, and code/fixup sizing all finish before stdout.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(b: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; word: i32; bytes_read: i32; total_len: i32;
    flags: i32; entry_id: i32; has_entry: i32;
    type_count: i32; record_count: i32; field_count: i32;
    machine_count: i32; mparam_count: i32; block_count: i32;
    bparam_count: i32; op_count: i32; operand_count: i32;
    term_count: i32; value_count: i32; place_count: i32;
    i: i32; j: i32; k: i32; end: i32; next: i32; pass: i32;
    progress: i32; found: i32; expected: i32; current_machine: i32;
    current_block: i32; current_op: i32; next_value: i32; next_place: i32;
    operation_operand_end: i32; operand_cursor: i32; candidate_count: i32;
    bool_type: i32; owner_type: i32; type_id: i32; type2: i32;
    size: i32; align: i32; offset: i32; pad: i32; copy_ok: i32;
    zero_ok: i32; frame_size: i32; frame_cursor: i32; scratch_base: i32;
    scratch_count: i32; text_size: i32; code_cursor: i32; trap_offset: i32;
    root_offset: i32; rx_size: i32; bss_size: i32; emitting: i32;
    value: i32; value2: i32; place: i32; place2: i32; target: i32;
    displacement: i32; leaf_offset: i32; leaf_type: i32;
    walk_depth: i32; walk_kind: i32; walk_index: i32; walk_limit: i32;

    // Three fixed arenas keep related CKIR tables together. Delta needs no
    // general allocator here, and the compact ownership also prevents the
    // lower-rung meaning route from threading dozens of independent arrays
    // through every byte-read helper call.
    // Metadata owns type [0,106496), declaration [106496,173696), and
    // terminator [173696,190080) partitions.
    metadata_arena: [i32; 190080];
    operation_arena: [i32; 458752];
    value_arena: [i32; 401408];
}

machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set() _ -> done() }
    state set() { self.status = 251; }
    state done() { }
}

machine Main::exhaust(&mut self) { self.status = 252; }

machine Main::read_raw(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() _ -> count() }
    state count() { transition self.bytes_read < 4194304 { true -> keep() _ -> exhausted() } }
    state keep() { self.bytes_read = self.bytes_read + 1; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_u8(&mut self) -> i32 { self.read_raw(); return self.c; }

machine Main::read_u16(&mut self) -> i32 {
    self.read_raw(); self.word = self.c;
    transition self.status == 0 { true -> high() _ -> done() }
    state high() { self.read_raw(); transition self.status == 0 { true -> combine() _ -> done() } }
    state combine() { self.word = self.word + self.c * 256; transition 0 { _ -> done() } }
    state done() { return self.word; }
}

// CKIR words are either 0..INT_MAX or the exact NO_ID bit pattern.
machine Main::read_u32(&mut self) -> i32 {
    self.read_raw(); self.word = self.c;
    transition self.status == 0 { true -> b1() _ -> done() }
    state b1() { self.read_raw(); self.word = self.word + self.c * 256; transition self.status == 0 { true -> b2() _ -> done() } }
    state b2() { self.read_raw(); self.word = self.word + self.c * 65536; transition self.status == 0 { true -> b3() _ -> done() } }
    state b3() { self.read_raw(); transition self.status == 0 { true -> high() _ -> done() } }
    state high() { transition self.c < 128 { true -> combine() _ -> no_id_high() } }
    state combine() { self.word = self.word + self.c * 16777216; transition 0 { _ -> done() } }
    state no_id_high() { transition self.c == 255 { true -> no_id_low() _ -> bad() } }
    state no_id_low() { transition self.word == 16777215 { true -> no_id() _ -> bad() } }
    state no_id() { self.word = 0 - 1; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { return self.word; }
}

machine Main::expect_u8(&mut self, expected: i32) {
    self.word = self.read_u8();
    transition self.status == 0 { true -> compare() _ -> done() }
    state compare() { transition self.word == expected { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::expect_zero_u16(&mut self) {
    self.word = self.read_u16();
    transition self.status == 0 { true -> compare() _ -> done() }
    state compare() { transition self.word == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::valid_id(&mut self, value: i32, count: i32) -> i32 {
    transition value >= 0 { true -> high() _ -> no() }
    state high() { transition value < count { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::span_ok(&mut self, start: i32, count: i32, limit: i32) -> i32 {
    transition start >= 0 { true -> count_low() _ -> no() }
    state count_low() { transition count >= 0 { true -> start_bound() _ -> no() } }
    state start_bound() { transition start <= limit { true -> count_bound() _ -> no() } }
    state count_bound() { transition count <= limit - start { true -> yes() _ -> no() } }
    state yes() { return 1; }
    state no() { return 0; }
}

machine Main::operand_at(&mut self, index: i32) -> i32 {
    transition index < 65536 { true -> low() _ -> high() }
    state low() { return self.operation_arena[327680 + index]; }
    state high() { return self.operation_arena[393216 + index - 65536]; }
}

machine Main::read_header(&mut self) {
    self.bytes_read = 0; self.status = 0;
    self.expect_u8(79); self.expect_u8(77); self.expect_u8(71); self.expect_u8(67);
    self.expect_u8(75); self.expect_u8(73); self.expect_u8(82); self.expect_u8(0);
    self.word = self.read_u16(); transition self.status == 0 { true -> major() _ -> done() }
    state major() { transition self.word == 1 { true -> minor_read() _ -> bad() } }
    state minor_read() { self.word = self.read_u16(); transition self.status == 0 { true -> minor() _ -> done() } }
    state minor() { transition self.word == 0 { true -> target_read() _ -> bad() } }
    state target_read() { self.word = self.read_u16(); transition self.status == 0 { true -> target() _ -> done() } }
    state target() { transition self.word == 1 { true -> flags_read() _ -> bad() } }
    state flags_read() { self.flags = self.read_u16(); transition self.status == 0 { true -> flags_check() _ -> done() } }
    state flags_check() { transition self.flags <= 1 { true -> entry_read() _ -> bad() } }
    state entry_read() { self.entry_id = self.read_u32(); transition self.status == 0 { true -> total() _ -> done() } }
    state total() { self.total_len = self.read_u32(); self.type_count = self.read_u32(); self.record_count = self.read_u32(); self.field_count = self.read_u32(); self.machine_count = self.read_u32(); self.mparam_count = self.read_u32(); self.block_count = self.read_u32(); self.bparam_count = self.read_u32(); self.op_count = self.read_u32(); self.operand_count = self.read_u32(); self.term_count = self.read_u32(); self.value_count = self.read_u32(); self.place_count = self.read_u32(); transition self.status == 0 { true -> ceilings() _ -> done() } }
    state ceilings() { transition self.total_len <= 4194304 { true -> type_cap() _ -> exhausted() } }
    state type_cap() { transition self.type_count <= 8192 { true -> record_cap() _ -> exhausted() } }
    state record_cap() { transition self.record_count <= 128 { true -> field_cap() _ -> exhausted() } }
    state field_cap() { transition self.field_count <= 8192 { true -> machine_cap() _ -> exhausted() } }
    state machine_cap() { transition self.machine_count <= 128 { true -> block_cap() _ -> exhausted() } }
    state block_cap() { transition self.block_count <= 2048 { true -> mp_cap() _ -> exhausted() } }
    state mp_cap() { transition self.mparam_count <= 4096 { true -> bp_cap() _ -> exhausted() } }
    state bp_cap() { transition self.bparam_count <= 4096 { true -> combined_cap() _ -> exhausted() } }
    state combined_cap() { transition self.mparam_count <= 4096 - self.bparam_count { true -> op_cap() _ -> exhausted() } }
    state op_cap() { transition self.op_count <= 32768 { true -> operand_cap() _ -> exhausted() } }
    state operand_cap() { transition self.operand_count <= 131072 { true -> value_cap() _ -> exhausted() } }
    state value_cap() { transition self.value_count <= 40960 { true -> place_cap() _ -> exhausted() } }
    state place_cap() { transition self.place_count <= 32768 { true -> term_relation() _ -> exhausted() } }
    state term_relation() { transition self.term_count == self.block_count { true -> flag_relation() _ -> bad() } }
    state flag_relation() { transition self.flags == 1 { true -> entry_present() _ -> entry_absent() } }
    state entry_present() { transition self.entry_id >= 0 { true -> done() _ -> bad() } }
    state entry_absent() { transition self.entry_id == 0 - 1 { true -> done() _ -> bad() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::check_encoded_length(&mut self) {
    self.expected = 72;
    transition self.type_count <= (2147483647 - self.expected) / 24 { true -> types() _ -> bad() }
    state types() { self.expected = self.expected + self.type_count * 24; transition self.record_count <= (2147483647 - self.expected) / 20 { true -> records() _ -> bad() } }
    state records() { self.expected = self.expected + self.record_count * 20; transition self.field_count <= (2147483647 - self.expected) / 16 { true -> fields() _ -> bad() } }
    state fields() { self.expected = self.expected + self.field_count * 16; transition self.machine_count <= (2147483647 - self.expected) / 36 { true -> machines() _ -> bad() } }
    state machines() { self.expected = self.expected + self.machine_count * 36; transition self.mparam_count <= (2147483647 - self.expected) / 20 { true -> mparams() _ -> bad() } }
    state mparams() { self.expected = self.expected + self.mparam_count * 20; transition self.block_count <= (2147483647 - self.expected) / 32 { true -> blocks() _ -> bad() } }
    state blocks() { self.expected = self.expected + self.block_count * 32; transition self.bparam_count <= (2147483647 - self.expected) / 20 { true -> bparams() _ -> bad() } }
    state bparams() { self.expected = self.expected + self.bparam_count * 20; transition self.op_count <= (2147483647 - self.expected) / 40 { true -> ops() _ -> bad() } }
    state ops() { self.expected = self.expected + self.op_count * 40; transition self.operand_count <= (2147483647 - self.expected) / 4 { true -> operands() _ -> bad() } }
    state operands() { self.expected = self.expected + self.operand_count * 4; transition self.term_count <= (2147483647 - self.expected) / 44 { true -> terms() _ -> bad() } }
    state terms() { self.expected = self.expected + self.term_count * 44; transition self.expected == self.total_len { true -> done() _ -> bad() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_types(&mut self) {
    self.i = 0; self.bool_type = 0 - 1;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.type_count { true -> row() _ -> done() } }
    state row() { self.word = self.read_u32(); transition self.status == 0 { true -> id() _ -> done() } }
    state id() { transition self.word == self.i { true -> kind() _ -> bad() } }
    state kind() { self.metadata_arena[0 + self.i] = self.read_u8(); self.metadata_arena[8192 + self.i] = self.read_u8(); self.expect_zero_u16(); self.metadata_arena[16384 + self.i] = self.read_u32(); self.metadata_arena[24576 + self.i] = self.read_u32(); self.metadata_arena[32768 + self.i] = self.read_u32(); self.metadata_arena[40960 + self.i] = self.read_u32(); transition self.status == 0 { true -> flag() _ -> done() } }
    state flag() { transition self.metadata_arena[8192 + self.i] <= 1 { true -> classify() _ -> bad() } }
    state classify() { transition self.metadata_arena[0 + self.i] { 1 -> scalar8() 2 -> scalar32() 3 -> boolean() 4 -> nominal() 5 -> array() _ -> bad() } }
    state scalar8() { transition self.metadata_arena[16384 + self.i] == 0 { true -> scalar8_p1() _ -> bad() } }
    state scalar8_p1() { transition self.metadata_arena[24576 + self.i] == 0 { true -> scalar8_range() _ -> bad() } }
    state scalar8_range() { transition self.metadata_arena[32768 + self.i] <= self.metadata_arena[40960 + self.i] { true -> scalar8_high() _ -> bad() } }
    state scalar8_high() { transition self.metadata_arena[40960 + self.i] <= 255 { true -> scalar8_layout() _ -> bad() } }
    state scalar8_layout() { self.metadata_arena[49152 + self.i] = 1; self.metadata_arena[57344 + self.i] = 1; self.metadata_arena[65536 + self.i] = 1; self.metadata_arena[73728 + self.i] = 1; self.metadata_arena[81920 + self.i] = 1; transition self.metadata_arena[32768 + self.i] == 0 { true -> scalar_zero() _ -> scalar_nozero() } }
    state scalar32() { transition self.metadata_arena[16384 + self.i] == 0 { true -> scalar32_p1() _ -> bad() } }
    state scalar32_p1() { transition self.metadata_arena[24576 + self.i] == 0 { true -> scalar32_range() _ -> bad() } }
    state scalar32_range() { transition self.metadata_arena[32768 + self.i] <= self.metadata_arena[40960 + self.i] { true -> scalar32_layout() _ -> bad() } }
    state scalar32_layout() { self.metadata_arena[49152 + self.i] = 4; self.metadata_arena[57344 + self.i] = 4; self.metadata_arena[65536 + self.i] = 1; self.metadata_arena[73728 + self.i] = 1; self.metadata_arena[81920 + self.i] = 1; transition self.metadata_arena[32768 + self.i] == 0 { true -> scalar_zero() _ -> scalar_nozero() } }
    state boolean() { transition self.metadata_arena[8192 + self.i] == 0 { true -> bool_payload0() _ -> bad() } }
    state bool_payload0() { transition self.metadata_arena[16384 + self.i] == 0 { true -> bool_payload1() _ -> bad() } }
    state bool_payload1() { transition self.metadata_arena[24576 + self.i] == 0 { true -> bool_range() _ -> bad() } }
    state bool_range() { transition self.metadata_arena[32768 + self.i] == 0 { true -> bool_high() _ -> bad() } }
    state bool_high() { transition self.metadata_arena[40960 + self.i] == 1 { true -> bool_unique() _ -> bad() } }
    state bool_unique() { transition self.bool_type < 0 { true -> bool_layout() _ -> bad() } }
    state bool_layout() { self.bool_type = self.i; self.metadata_arena[49152 + self.i] = 1; self.metadata_arena[57344 + self.i] = 1; self.metadata_arena[65536 + self.i] = 1; self.metadata_arena[73728 + self.i] = 1; self.metadata_arena[81920 + self.i] = 1; transition 0 { _ -> scalar_zero() } }
    state scalar_zero() { self.metadata_arena[90112 + self.i] = 1; self.metadata_arena[98304 + self.i] = 1; transition 0 { _ -> intern() } }
    state scalar_nozero() { self.metadata_arena[90112 + self.i] = 0; self.metadata_arena[98304 + self.i] = 1; transition 0 { _ -> intern() } }
    state nominal() { transition self.metadata_arena[8192 + self.i] == 0 { true -> nominal_p1() _ -> bad() } }
    state nominal_p1() { transition self.metadata_arena[24576 + self.i] == 0 { true -> nominal_range0() _ -> bad() } }
    state nominal_range0() { transition self.metadata_arena[32768 + self.i] == 0 { true -> nominal_range1() _ -> bad() } }
    state nominal_range1() { transition self.metadata_arena[40960 + self.i] == 0 { true -> nominal_record() _ -> bad() } }
    state nominal_record() { self.found = self.valid_id(self.metadata_arena[16384 + self.i], self.record_count); transition self.found == 1 { true -> intern() _ -> bad() } }
    state array() { transition self.metadata_arena[32768 + self.i] == 0 { true -> array_range1() _ -> bad() } }
    state array_range1() { transition self.metadata_arena[40960 + self.i] == 0 { true -> array_type() _ -> bad() } }
    state array_type() { self.found = self.valid_id(self.metadata_arena[16384 + self.i], self.type_count); transition self.found == 1 { true -> array_len() _ -> bad() } }
    state array_len() { transition self.metadata_arena[24576 + self.i] <= 65536 { true -> intern() _ -> exhausted() } }
    state intern() { self.j = 0; transition 0 { _ -> intern_loop() } }
    state intern_loop() { transition self.j < self.i { true -> intern_compare() _ -> advance() } }
    state intern_compare() { transition self.metadata_arena[0 + self.j] == self.metadata_arena[0 + self.i] { true -> intern_flags() _ -> intern_next() } }
    state intern_flags() { transition self.metadata_arena[8192 + self.j] == self.metadata_arena[8192 + self.i] { true -> intern_p0() _ -> intern_next() } }
    state intern_p0() { transition self.metadata_arena[16384 + self.j] == self.metadata_arena[16384 + self.i] { true -> intern_p1() _ -> intern_next() } }
    state intern_p1() { transition self.metadata_arena[24576 + self.j] == self.metadata_arena[24576 + self.i] { true -> intern_lo() _ -> intern_next() } }
    state intern_lo() { transition self.metadata_arena[32768 + self.j] == self.metadata_arena[32768 + self.i] { true -> intern_hi() _ -> intern_next() } }
    state intern_hi() { transition self.metadata_arena[40960 + self.j] == self.metadata_arena[40960 + self.i] { true -> bad() _ -> intern_next() } }
    state intern_next() { self.j = self.j + 1; transition 0 { _ -> intern_loop() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_records(&mut self) {
    self.i = 0; self.next = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.record_count { true -> row() _ -> partition() } }
    state row() { self.word = self.read_u32(); transition self.status == 0 { true -> id() _ -> done() } }
    state id() { transition self.word == self.i { true -> values() _ -> bad() } }
    state values() { self.metadata_arena[106496 + 0 + self.i] = self.read_u32(); self.metadata_arena[106496 + 128 + self.i] = self.read_u32(); self.metadata_arena[106496 + 256 + self.i] = self.read_u32(); self.metadata_arena[106496 + 384 + self.i] = self.read_u8(); self.expect_u8(0); self.expect_u8(0); self.expect_u8(0); transition self.status == 0 { true -> nominal_id() _ -> done() } }
    state nominal_id() { self.found = self.valid_id(self.metadata_arena[106496 + 0 + self.i], self.type_count); transition self.found == 1 { true -> nominal_kind() _ -> bad() } }
    state nominal_kind() { transition self.metadata_arena[0 + self.metadata_arena[106496 + 0 + self.i]] == 4 { true -> nominal_back() _ -> bad() } }
    state nominal_back() { transition self.metadata_arena[16384 + self.metadata_arena[106496 + 0 + self.i]] == self.i { true -> nominal_unique() _ -> bad() } }
    state nominal_unique() { transition self.metadata_arena[106496 + 512 + self.i] == 0 { true -> nominal_mark() _ -> bad() } }
    state nominal_mark() { self.metadata_arena[106496 + 512 + self.i] = 1; transition self.metadata_arena[106496 + 384 + self.i] <= 1 { true -> field_cap() _ -> bad() } }
    state field_cap() { transition self.metadata_arena[106496 + 256 + self.i] <= 64 { true -> start() _ -> bad() } }
    state start() { transition self.metadata_arena[106496 + 128 + self.i] == self.next { true -> span() _ -> bad() } }
    state span() { self.found = self.span_ok(self.metadata_arena[106496 + 128 + self.i], self.metadata_arena[106496 + 256 + self.i], self.field_count); transition self.found == 1 { true -> consume() _ -> bad() } }
    state consume() { self.next = self.next + self.metadata_arena[106496 + 256 + self.i]; self.i = self.i + 1; transition 0 { _ -> loop() } }
    state partition() { transition self.next == self.field_count { true -> nominal_coverage() _ -> bad() } }
    state nominal_coverage() { self.i = 0; transition 0 { _ -> nominal_loop() } }
    state nominal_loop() { transition self.i < self.type_count { true -> nominal_type() _ -> done() } }
    state nominal_type() { transition self.metadata_arena[0 + self.i] == 4 { true -> nominal_seen() _ -> nominal_next() } }
    state nominal_seen() { transition self.metadata_arena[106496 + 512 + self.metadata_arena[16384 + self.i]] == 1 { true -> nominal_next() _ -> bad() } }
    state nominal_next() { self.i = self.i + 1; transition 0 { _ -> nominal_loop() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_fields(&mut self) {
    self.i = 0; self.current_machine = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.field_count { true -> owner_seek() _ -> done() } }
    state owner_seek() { transition self.current_machine < self.record_count { true -> owner_end() _ -> bad() } }
    state owner_end() { self.end = self.metadata_arena[106496 + 128 + self.current_machine] + self.metadata_arena[106496 + 256 + self.current_machine]; transition self.i < self.end { true -> row() _ -> owner_next() } }
    state owner_next() { self.current_machine = self.current_machine + 1; transition 0 { _ -> owner_seek() } }
    state row() { self.word = self.read_u32(); transition self.status == 0 { true -> id() _ -> done() } }
    state id() { transition self.word == self.i { true -> values() _ -> bad() } }
    state values() { self.metadata_arena[106496 + 640 + self.i] = self.read_u32(); self.k = self.read_u32(); self.metadata_arena[106496 + 8832 + self.i] = self.read_u32(); transition self.status == 0 { true -> owner() _ -> done() } }
    state owner() { transition self.metadata_arena[106496 + 640 + self.i] == self.current_machine { true -> ordinal() _ -> bad() } }
    state ordinal() { transition self.k == self.i - self.metadata_arena[106496 + 128 + self.current_machine] { true -> type() _ -> bad() } }
    state type() { self.found = self.valid_id(self.metadata_arena[106496 + 8832 + self.i], self.type_count); transition self.found == 1 { true -> advance() _ -> bad() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::parse_machines(&mut self) {
    self.i = 0; self.next = 0; self.expected = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < self.machine_count { true -> row() _ -> partitions() } }
    state row() { self.word = self.read_u32(); transition self.status == 0 { true -> id() _ -> done() } }
    state id() { transition self.word == self.i { true -> values() _ -> bad() } }
    state values() { self.metadata_arena[106496 + 25216 + self.i] = self.read_u32(); self.metadata_arena[106496 + 25344 + self.i] = self.read_u8(); self.expect_u8(0); self.expect_zero_u16(); self.metadata_arena[106496 + 25472 + self.i] = self.read_u32(); self.metadata_arena[106496 + 25600 + self.i] = self.read_u32(); self.metadata_arena[106496 + 25728 + self.i] = self.read_u32(); self.metadata_arena[106496 + 25856 + self.i] = self.read_u32(); self.metadata_arena[106496 + 25984 + self.i] = self.read_u32(); self.metadata_arena[106496 + 26112 + self.i] = self.read_u32(); transition self.status == 0 { true -> owner() _ -> done() } }
    state owner() { self.found = self.valid_id(self.metadata_arena[106496 + 25216 + self.i], self.record_count); transition self.found == 1 { true -> access() _ -> bad() } }
    state access() { transition self.metadata_arena[106496 + 25344 + self.i] == 1 { true -> result() _ -> access_mut() } }
