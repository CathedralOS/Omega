machine Main::edge_size(&mut self, start: i32, count: i32) -> i32 {
    self.j = 0; self.size = 5;
    transition 0 { _ -> loop() }
    state loop() { transition self.j < count { true -> value() _ -> done() } }
    state value() { self.value = self.operand_at(start + self.j); transition self.metadata_arena[0 + self.value_arena[0 + self.value]] <= 3 { true -> scalar() _ -> structural() } }
    state scalar() { self.size = self.size + 46; transition 0 { _ -> next() } }
    state structural() { self.size = self.size + 28; transition 0 { _ -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> loop() } }
    state done() { return self.size; }
}

machine Main::emit_edge(&mut self, start: i32, count: i32, target: i32) {
    self.j = 0;
    transition 0 { _ -> stage_loop() }
    state stage_loop() { transition self.j < count { true -> stage() _ -> commit_setup() } }
    state stage() { self.value = self.operand_at(start + self.j); transition self.metadata_arena[0 + self.value_arena[0 + self.value]] <= 3 { true -> stage_scalar() _ -> stage_structural() } }
    state stage_scalar() { self.load_value_eax(self.value); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.j + 1) * 8)); transition 0 { _ -> stage_next() } }
    state stage_structural() { self.code_byte(72); self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + self.value]); self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.j + 1) * 8)); transition 0 { _ -> stage_next() } }
    state stage_next() { self.j = self.j + 1; transition 0 { _ -> stage_loop() } }
    state commit_setup() { self.j = 0; transition 0 { _ -> commit_loop() } }
    state commit_loop() { transition self.j < count { true -> commit() _ -> jump() } }
    state commit() { self.value = self.metadata_arena[106496 + 63104 + self.metadata_arena[106496 + 42624 + target] + self.j]; transition self.metadata_arena[0 + self.value_arena[0 + self.value]] <= 3 { true -> commit_scalar() _ -> commit_structural() } }
    state commit_scalar() { self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.j + 1) * 8)); self.range_check_eax(self.value_arena[0 + self.value]); self.store_value_eax(self.value); transition 0 { _ -> commit_next() } }
    state commit_structural() { self.code_byte(72); self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - (self.scratch_base + (self.j + 1) * 8)); self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + self.value]); transition 0 { _ -> commit_next() } }
    state commit_next() { self.j = self.j + 1; transition 0 { _ -> commit_loop() } }
    state jump() { self.code_byte(233); self.code_rel32(self.metadata_arena[106496 + 52864 + target]); }
}

machine Main::emit_terminator(&mut self, block: i32) {
    transition self.metadata_arena[173696 + 0 + block] { 1 -> jump() 2 -> branch() 3 -> return_unit() 4 -> return_value() _ -> bad() }
    state jump() { self.emit_edge(self.metadata_arena[173696 + 6144 + block], self.metadata_arena[173696 + 8192 + block], self.metadata_arena[173696 + 4096 + block]); transition 0 { _ -> done() } }
    state branch() { self.load_value_eax(self.metadata_arena[173696 + 2048 + block]); self.code_byte(133); self.code_byte(192); self.size = self.edge_size(self.metadata_arena[173696 + 6144 + block], self.metadata_arena[173696 + 8192 + block]); self.target = self.code_cursor + 6 + self.size; self.code_byte(15); self.code_byte(132); self.code_rel32(self.target); self.emit_edge(self.metadata_arena[173696 + 6144 + block], self.metadata_arena[173696 + 8192 + block], self.metadata_arena[173696 + 4096 + block]); self.emit_edge(self.metadata_arena[173696 + 12288 + block], self.metadata_arena[173696 + 14336 + block], self.metadata_arena[173696 + 10240 + block]); transition 0 { _ -> done() } }
    state return_unit() { self.code_byte(201); self.code_byte(195); transition 0 { _ -> done() } }
    state return_value() { self.load_value_eax(self.metadata_arena[173696 + 2048 + block]); self.range_check_eax(self.metadata_arena[106496 + 25472 + self.entry_id]); self.code_byte(201); self.code_byte(195); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::emit_block(&mut self, block: i32) {
    transition block == self.metadata_arena[106496 + 26112 + self.entry_id] { true -> prologue() _ -> operations_setup() }
    state prologue() { self.code_byte(85); self.code_byte(72); self.code_byte(137); self.code_byte(229); self.code_byte(72); self.code_byte(129); self.code_byte(236); self.code_u32(self.frame_size); self.code_byte(72); self.code_byte(137); self.code_byte(189); self.code_signed_u32(0 - 8); transition 0 { _ -> operations_setup() } }
    state operations_setup() { self.current_op = self.metadata_arena[106496 + 46720 + block]; self.end = self.current_op + self.metadata_arena[106496 + 48768 + block]; transition 0 { _ -> operations() } }
    state operations() { transition self.current_op < self.end { true -> operation() _ -> term() } }
    state operation() { self.i = self.current_op; self.emit_operation(self.current_op); self.current_op = self.i + 1; transition self.status == 0 { true -> operations() _ -> done() } }
    state term() { self.emit_terminator(block); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_text(&mut self) {
    self.code_cursor = 0;
    // lea rdi,[rip+BSS]; call root; movzx edi,al; exit_group; ud2
    self.code_byte(72); self.code_byte(141); self.code_byte(61);
    transition self.pass == 0 { true -> shim_dummy_bss() _ -> shim_bss() }
    state shim_dummy_bss() { self.code_u32(0); transition 0 { _ -> shim_call() } }
    state shim_bss() { self.code_rel32(self.rx_size - 4096); transition 0 { _ -> shim_call() } }
    state shim_call() { self.code_byte(232); transition self.pass == 0 { true -> shim_dummy_call() _ -> shim_root_call() } }
    state shim_dummy_call() { self.code_u32(0); transition 0 { _ -> shim_tail() } }
    state shim_root_call() { self.code_rel32(self.root_offset); transition 0 { _ -> shim_tail() } }
    state shim_tail() { self.code_byte(15); self.code_byte(182); self.code_byte(248); self.code_byte(184); self.code_u32(231); self.code_byte(15); self.code_byte(5); self.code_byte(15); self.code_byte(11); self.trap_offset = self.code_cursor; self.code_byte(15); self.code_byte(11); self.current_block = self.metadata_arena[106496 + 25856 + self.entry_id]; transition 0 { _ -> blocks() } }
    state blocks() { transition self.current_block < self.metadata_arena[106496 + 25856 + self.entry_id] + self.metadata_arena[106496 + 25984 + self.entry_id] { true -> block() _ -> done() } }
    state block() { transition self.pass == 0 { true -> remember() _ -> emit() } }
    state remember() { self.metadata_arena[106496 + 52864 + self.current_block] = self.code_cursor; transition self.current_block == self.metadata_arena[106496 + 26112 + self.entry_id] { true -> remember_root() _ -> emit() } }
    state remember_root() { self.root_offset = self.code_cursor; transition 0 { _ -> emit() } }
    state emit() { self.emit_block(self.current_block); self.current_block = self.current_block + 1; transition self.status == 0 { true -> blocks() _ -> done() } }
    state done() { }
}

machine Main::preflight_text(&mut self) {
    self.emitting = 0; self.pass = 0; self.emit_text();
    transition self.status == 0 { true -> text_cap() _ -> done() }
    state text_cap() { self.text_size = self.code_cursor; transition self.text_size <= 1048576 { true -> rx_add() _ -> exhausted() } }
    state rx_add() { transition self.text_size <= 2147483647 - 4096 { true -> rx_round() _ -> exhausted() } }
    state rx_round() { self.rx_size = 4096 + self.text_size; self.pad = (4096 - (self.rx_size % 4096)) % 4096; transition self.pad <= 2147483647 - self.rx_size { true -> rx_keep() _ -> exhausted() } }
    state rx_keep() { self.rx_size = self.rx_size + self.pad; self.pad = (4096 - (self.bss_size % 4096)) % 4096; transition self.bss_size == 0 { true -> bss_zero() _ -> bss_round() } }
    state bss_zero() { self.size = 4096; transition 0 { _ -> fixups() } }
    state bss_round() { transition self.pad <= 2147483647 - self.bss_size { true -> bss_keep() _ -> exhausted() } }
    state bss_keep() { self.size = self.bss_size + self.pad; transition 0 { _ -> fixups() } }
    state fixups() { self.bss_size = self.size; self.pass = 1; self.emit_text(); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.code_cursor == self.text_size { true -> done() _ -> bad() } }
    state exhausted() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); }
    state done() { }
}

machine Main::output_zeroes(&mut self, count: i32) {
    self.j = 0;
    transition self.j < count { true -> byte() _ -> done() }
    state byte() { write_byte(0); self.j = self.j + 1; transition self.j < count { true -> byte() _ -> done() } }
    state done() { }
}

machine Main::publish_elf(&mut self) {
    // ELF header.
    write_byte(127); write_byte(69); write_byte(76); write_byte(70);
    write_byte(2); write_byte(1); write_byte(1); write_byte(0); self.output_zeroes(8);
    self.output_u16(2); self.output_u16(62); self.output_u32(1);
    self.output_u64(4198400); self.output_u64(64); self.output_u64(0); self.output_u32(0);
    self.output_u16(64); self.output_u16(56); self.output_u16(2);
    self.output_u16(0); self.output_u16(0); self.output_u16(0);
    // RX PT_LOAD.
    self.output_u32(1); self.output_u32(5); self.output_u64(0);
    self.output_u64(4194304); self.output_u64(4194304);
    self.output_u64(self.rx_size); self.output_u64(self.rx_size); self.output_u64(4096);
    // RW zero-fill PT_LOAD.
    self.output_u32(1); self.output_u32(6); self.output_u64(self.rx_size);
    self.output_u64(4194304 + self.rx_size); self.output_u64(4194304 + self.rx_size);
    self.output_u64(0); self.output_u64(self.bss_size); self.output_u64(4096);
    self.output_zeroes(3920);
    self.emitting = 1; self.pass = 2; self.emit_text();
    self.output_zeroes(self.rx_size - 4096 - self.text_size);
}

machine Main::decode(&mut self) {
    self.read_header(); transition self.status == 0 { true -> length() _ -> done() }
    state length() { self.check_encoded_length(); transition self.status == 0 { true -> types() _ -> done() } }
    state types() { self.parse_types(); transition self.status == 0 { true -> records() _ -> done() } }
    state records() { self.parse_records(); transition self.status == 0 { true -> fields() _ -> done() } }
    state fields() { self.parse_fields(); transition self.status == 0 { true -> machines() _ -> done() } }
    state machines() { self.parse_machines(); transition self.status == 0 { true -> mparams() _ -> done() } }
    state mparams() { self.parse_mparams(); transition self.status == 0 { true -> blocks() _ -> done() } }
    state blocks() { self.parse_blocks(); transition self.status == 0 { true -> bparams() _ -> done() } }
    state bparams() { self.parse_bparams(); transition self.status == 0 { true -> operations() _ -> done() } }
    state operations() { self.parse_operations(); transition self.status == 0 { true -> operands() _ -> done() } }
    state operands() { self.parse_operands(); transition self.status == 0 { true -> terms() _ -> done() } }
    state terms() { self.parse_terminators(); transition self.status == 0 { true -> layouts() _ -> done() } }
    state layouts() { self.resolve_layouts(); transition self.status == 0 { true -> ops_validate() _ -> done() } }
    state ops_validate() { self.validate_operations(); transition self.status == 0 { true -> terms_validate() _ -> done() } }
    state terms_validate() { self.validate_terminators(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.decode();
    transition self.status == 0 { true -> root() _ -> finish() }
    state root() { transition self.flags == 1 { true -> frame() _ -> finish() } }
    state frame() { self.assign_frame(); transition self.status == 0 { true -> text() _ -> finish() } }
    state text() { self.preflight_text(); transition self.status == 0 { true -> publish() _ -> finish() } }
    state publish() { self.publish_elf(); transition 0 { _ -> finish() } }
    state finish() { self.console.exit_process(self.status); }
}
