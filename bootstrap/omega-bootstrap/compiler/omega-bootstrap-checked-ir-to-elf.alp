machine Main::output_u16(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
}

machine Main::output_u32(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
    write_byte((value >> 16) & 255); write_byte((value >> 24) & 255);
}

machine Main::output_u64(&mut self, value: i32) { self.output_u32(value); self.output_u32(0); }

machine Main::code_byte(&mut self, value: i32) {
    transition self.emitting == 1 { true -> publish() _ -> count() }
    state publish() { write_byte(value); transition 0 { _ -> count() } }
    state count() { self.code_cursor = self.code_cursor + 1; }
}

machine Main::code_u32(&mut self, value: i32) {
    self.code_byte(value & 255); self.code_byte((value >> 8) & 255);
    self.code_byte((value >> 16) & 255); self.code_byte((value >> 24) & 255);
}

machine Main::code_signed_u32(&mut self, value: i32) {
    transition value >= 0 { true -> positive() _ -> negative() }
    state positive() { self.code_u32(value); transition 0 { _ -> done() } }
    state negative() { self.word = 0 - value - 1; self.code_byte(255 - (self.word & 255)); self.word = self.word / 256; self.code_byte(255 - (self.word & 255)); self.word = self.word / 256; self.code_byte(255 - (self.word & 255)); self.word = self.word / 256; self.code_byte(255 - (self.word & 255)); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::code_rel32(&mut self, target: i32) {
    self.displacement = target - (self.code_cursor + 4); self.code_signed_u32(self.displacement);
}

machine Main::load_value_eax(&mut self, id: i32) {
    self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + id]);
}

machine Main::store_value_eax(&mut self, id: i32) {
    self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[163840 + id]);
}

machine Main::load_place_rax(&mut self, id: i32) {
    self.code_byte(72); self.code_byte(139); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[335872 + id]);
}

machine Main::store_place_rax(&mut self, id: i32) {
    self.code_byte(72); self.code_byte(137); self.code_byte(133); self.code_signed_u32(0 - self.value_arena[335872 + id]);
}

machine Main::trap_jcc(&mut self, opcode: i32) {
    self.code_byte(15); self.code_byte(opcode); self.code_rel32(self.trap_offset);
}

machine Main::range_check_eax(&mut self, type: i32) {
    self.code_byte(61); self.code_u32(self.metadata_arena[32768 + type]); self.trap_jcc(130);
    self.code_byte(61); self.code_u32(self.metadata_arena[40960 + type]); self.trap_jcc(135);
}

machine Main::copy_leaf(&mut self, type: i32, offset: i32) {
    transition self.metadata_arena[0 + type] == 2 { true -> wide() _ -> byte() }
    state byte() { self.code_byte(65); self.code_byte(15); self.code_byte(182); self.code_byte(131); self.code_u32(offset); self.code_byte(65); self.code_byte(136); self.code_byte(130); self.code_u32(offset); transition 0 { _ -> done() } }
    state wide() { self.code_byte(65); self.code_byte(139); self.code_byte(131); self.code_u32(offset); self.code_byte(65); self.code_byte(137); self.code_byte(130); self.code_u32(offset); transition 0 { _ -> done() } }
    state done() { }
}

