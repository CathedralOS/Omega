// Focused OMGLOWL21 (OMGCOMP1 + OMGRSWC12) -> CKIR20 lowerer.  The selected
// semantic witness is validated and paired to its source spans before any
// checked-IR byte is published.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
}
data Main {
    console: Console;
    status: i32; c: i32; n: i32; i: i32; j: i32; x: i32; y: i32;
    decoded: i32; total: i32; comp_n: i32; witness_n: i32;
    comp: i32; witness: i32; bundle: i32; bundle_length: i32;
    string_length: i32; source_start: i32; source_length: i32;
    buffer_n: i32; at: i32; row: i32; start: i32; count: i32; word: i32;
    match_ok: i32; char_ok: i32;
    input: [u8; 274833];
    publication: [i32; 3422];
}

machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status=251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::exhaust(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status=252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::slurp(&mut self) {
    self.n=0; transition 0 { _ -> read_next() }
    state read_next() { self.c=read_byte(); transition self.c < 0 { true -> done() _ -> room() } }
    state room() { transition self.n < 274833 { true -> store() _ -> over() } }
    state store() { self.input[self.n]=self.c; self.n=self.n+1; transition self.n > 274832 { true -> over() _ -> read_next() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_u32(&mut self, position: i32) {
    self.decoded=0-1;
    transition position >= 0 { true -> room() _ -> bad() }
    state room() { transition position <= self.n-4 { true -> signed() _ -> bad() } }
    state signed() { transition self.input[position+3] < 128 { true -> value() _ -> bad() } }
    state value() {
        self.decoded=self.input[position]+self.input[position+1]*256
            +self.input[position+2]*65536+self.input[position+3]*16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_u32(&mut self, position: i32, value: i32) {
    self.read_u32(position); transition self.status == 0 { true -> equal() _ -> done() }
    state equal() { transition self.decoded == value { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_byte(&mut self, position: i32, value: i32) {
    transition position >= 0 { true -> room() _ -> bad() }
    state room() { transition position < self.n { true -> equal() _ -> bad() } }
    state equal() { transition self.input[position] == value { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_no_id(&mut self, position: i32) {
    self.expect_byte(position,255); self.expect_byte(position+1,255);
    self.expect_byte(position+2,255); self.expect_byte(position+3,255);
}

machine Main::validate_outer(&mut self) {
    transition self.n >= 32 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(0,79); self.expect_byte(1,77); self.expect_byte(2,71);
        self.expect_byte(3,76); self.expect_byte(4,79); self.expect_byte(5,87);
        self.expect_byte(6,75); self.expect_byte(7,0);
        transition self.status == 0 { true -> fixed() _ -> done() }
    }
    state fixed() {
        self.expect_byte(8,21); self.expect_byte(9,0); self.expect_byte(10,0);
        self.expect_byte(11,0); self.expect_byte(12,0); self.expect_byte(13,0);
        self.expect_byte(14,32); self.expect_byte(15,0); self.expect_u32(28,12);
        transition self.status == 0 { true -> lengths() _ -> done() }
    }
    state lengths() {
        self.read_u32(16); self.total=self.decoded;
        self.read_u32(20); self.comp_n=self.decoded;
        self.read_u32(24); self.witness_n=self.decoded;
        transition self.status == 0 { true -> comp_limit() _ -> done() }
    }
    state comp_limit() { transition self.comp_n <= 267280 { true -> witness_exact() _ -> over() } }
    state witness_exact() { transition self.witness_n == 7520 { true -> exact_sum() _ -> bad() } }
    state exact_sum() { transition self.total == 32+self.comp_n+self.witness_n { true -> exact_input() _ -> bad() } }
    state exact_input() { transition self.total == self.n { true -> save() _ -> bad() } }
    state save() { self.comp=32; self.witness=32+self.comp_n; transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_compilation(&mut self) {
    transition self.comp_n >= 154 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(self.comp,79); self.expect_byte(self.comp+1,77); self.expect_byte(self.comp+2,71);
        self.expect_byte(self.comp+3,67); self.expect_byte(self.comp+4,79); self.expect_byte(self.comp+5,77);
        self.expect_byte(self.comp+6,80); self.expect_byte(self.comp+7,0);
        self.expect_byte(self.comp+8,1); self.expect_byte(self.comp+9,0);
        self.expect_byte(self.comp+10,0); self.expect_byte(self.comp+11,0);
        self.expect_byte(self.comp+12,1); self.expect_byte(self.comp+13,0);
        self.expect_byte(self.comp+14,0); self.expect_byte(self.comp+15,0);
        self.expect_u32(self.comp+16,self.comp_n);
        transition self.status == 0 { true -> header() _ -> done() }
    }
    state header() {
        self.read_u32(self.comp+20); self.bundle_length=self.decoded;
        self.read_u32(self.comp+24); self.string_length=self.decoded;
        self.expect_u32(self.comp+32,1); self.expect_u32(self.comp+36,1);
        self.expect_u32(self.comp+40,0); self.expect_u32(self.comp+44,0);
        self.expect_u32(self.comp+48,0); self.expect_u32(self.comp+60,0);
        transition self.status == 0 { true -> fixed_rows() _ -> done() }
    }
    state fixed_rows() {
        self.expect_u32(self.comp+64,0); self.expect_u32(self.comp+100,0);
        self.expect_u32(self.comp+104,1); self.expect_u32(self.comp+108,0);
        self.expect_u32(self.comp+112,0); self.expect_u32(self.comp+116,0);
        self.expect_u32(self.comp+120,0); self.read_u32(self.comp+124); self.x=self.decoded;
        self.expect_u32(self.comp+128,0);
        transition self.status == 0 { true -> string_range() _ -> done() }
    }
    state string_range() { self.read_u32(self.comp+28); transition self.x < self.decoded { true -> bundle_offset() _ -> bad() } }
    state bundle_offset() { self.bundle=self.comp+132+self.string_length; transition self.bundle <= self.comp+self.comp_n { true -> bundle_extent() _ -> bad() } }
    state bundle_extent() { transition self.bundle_length == self.comp+self.comp_n-self.bundle { true -> bundle_header() _ -> bad() } }
    state bundle_header() {
        self.expect_byte(self.bundle,79); self.expect_byte(self.bundle+1,77); self.expect_byte(self.bundle+2,71);
        self.expect_byte(self.bundle+3,48); self.expect_byte(self.bundle+4,66); self.expect_byte(self.bundle+5,78);
        self.expect_byte(self.bundle+6,68); self.expect_byte(self.bundle+7,76);
        self.expect_u32(self.bundle+8,1); self.expect_u32(self.bundle+12,1);
        self.read_u32(self.bundle+16); self.x=self.decoded;
        self.read_u32(self.bundle+20); self.source_length=self.decoded;
        transition self.status == 0 { true -> source_limit() _ -> done() }
    }
    state source_limit() { transition self.source_length <= 131072 { true -> source_extent() _ -> over() } }
    state source_extent() { self.source_start=self.bundle+24+self.x; transition self.source_length == self.comp+self.comp_n-self.source_start { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::span_bounds(&mut self, relative: i32, length: i32) {
    self.match_ok=0;
    transition relative >= 0 { true -> length_nonnegative() _ -> done() }
    state length_nonnegative() { transition length >= 0 { true -> room() _ -> done() } }
    state room() { transition relative <= self.source_length-length { true -> yes() _ -> done() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_start(&mut self) {
    self.char_ok=0; transition self.c == 95 { true -> yes() _ -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() _ -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() _ -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() _ -> done() } }
    state lower1() { transition self.c < 123 { true -> yes() _ -> done() } }
    state yes() { self.char_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_continue(&mut self) {
    self.is_ident_start(); transition self.char_ok == 1 { true -> done() _ -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() _ -> done() } }
    state yes() { self.char_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_identifier_span(&mut self, relative: i32, length: i32) {
    self.span_bounds(relative,length); transition self.match_ok == 1 { true -> nonempty() _ -> bad() }
    state nonempty() { transition length >= 1 { true -> ceiling() _ -> bad() } }
    state ceiling() { transition length <= 64 { true -> first() _ -> over() } }
    state first() { self.c=self.input[self.source_start+relative]; self.is_ident_start(); transition self.char_ok == 1 { true -> rest_begin() _ -> bad() } }
    state rest_begin() { self.i=1; transition 0 { _ -> rest() } }
    state rest() { transition self.i < length { true -> byte() _ -> done() } }
    state byte() { self.c=self.input[self.source_start+relative+self.i]; self.is_ident_continue(); transition self.char_ok == 1 { true -> advance() _ -> bad() } }
    state advance() { self.i=self.i+1; transition 0 { _ -> rest() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_body_span(&mut self, relative: i32, length: i32) {
    self.span_bounds(relative,length); transition self.match_ok == 1 { true -> minimum() _ -> bad() }
    state minimum() { transition length >= 2 { true -> open() _ -> bad() } }
    state open() { transition self.input[self.source_start+relative] == 123 { true -> close() _ -> bad() } }
    state close() { transition self.input[self.source_start+relative+length-1] == 125 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::source_spans_equal(&mut self, left: i32, right: i32, length: i32) {
    self.match_ok=0; self.i=0; transition 0 { _ -> loop() }
    state loop() { transition self.i < length { true -> byte() _ -> yes() } }
    state byte() { transition self.input[self.source_start+left+self.i] == self.input[self.source_start+right+self.i] { true -> advance() _ -> done() } }
    state advance() { self.i=self.i+1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_v12_dense(&mut self, start: i32, rows: i32, width: i32) {
    self.row=0; transition 0 { _ -> loop() }
    state loop() { transition self.row < rows { true -> one() _ -> done() } }
    state one() { self.expect_u32(self.witness+start+self.row*width,self.row); self.row=self.row+1; transition self.status == 0 { true -> loop() _ -> done() } }
    state done() { }
}

machine Main::validate_v12_named_rows(&mut self) {
    self.row=0; self.start=916; self.count=8; self.x=20; transition 0 { _ -> loop() }
    state loop() { transition self.row < self.count { true -> one() _ -> next_table() } }
    state one() { self.at=self.witness+self.start+self.row*self.y; self.read_u32(self.at+self.x); self.j=self.decoded; self.read_u32(self.at+self.x+4); self.validate_identifier_span(self.j,self.decoded); self.row=self.row+1; transition self.status == 0 { true -> loop() _ -> done() } }
    state next_table() { transition self.start == 916 { true -> fields() _ -> sums_check() } }
    state fields() { self.row=0; self.start=1172; self.count=29; self.x=16; self.y=24; transition 0 { _ -> loop() } }
    state sums_check() { transition self.start == 1172 { true -> sums() _ -> cases_check() } }
    state sums() { self.row=0; self.start=1868; self.count=5; self.x=20; self.y=32; transition 0 { _ -> loop() } }
    state cases_check() { transition self.start == 1868 { true -> cases() _ -> payloads_check() } }
    state cases() { self.row=0; self.start=2028; self.count=105; self.x=20; self.y=28; transition 0 { _ -> loop() } }
    state payloads_check() { transition self.start == 2028 { true -> payloads() _ -> params_check() } }
    state payloads() { self.row=0; self.start=4968; self.count=8; self.x=16; self.y=24; transition 0 { _ -> loop() } }
    state params_check() { transition self.start == 4968 { true -> params() _ -> done() } }
    state params() { self.row=0; self.start=5328; self.count=11; self.x=16; self.y=24; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::validate_v12_machines_blocks_calls(&mut self) {
    self.row=0; transition 0 { _ -> machines() }
    state machines() { transition self.row < 3 { true -> machine_one() _ -> blocks_begin() } }
    state machine_one() { self.at=self.witness+5160+self.row*56; self.read_u32(self.at+32); self.x=self.decoded; self.read_u32(self.at+36); self.y=self.decoded; self.validate_identifier_span(self.x,self.y); self.read_u32(self.at+40); self.x=self.decoded; self.read_u32(self.at+44); self.y=self.decoded; self.validate_body_span(self.x,self.y); self.row=self.row+1; transition self.status == 0 { true -> machines() _ -> done() } }
    state blocks_begin() { self.row=0; transition 0 { _ -> blocks() } }
    state blocks() { transition self.row < 14 { true -> block_one() _ -> calls_begin() } }
    state block_one() { self.at=self.witness+5592+self.row*40; self.read_u32(self.at+28); self.y=self.decoded; transition self.y > 0 { true -> block_named() _ -> block_next() } }
    state block_named() { self.read_u32(self.at+24); self.x=self.decoded; self.validate_identifier_span(self.x,self.y); self.read_u32(self.at+32); self.x=self.decoded; self.read_u32(self.at+36); self.y=self.decoded; self.validate_body_span(self.x,self.y); transition self.status == 0 { true -> block_next() _ -> done() } }
    state block_next() { self.row=self.row+1; transition 0 { _ -> blocks() } }
    state calls_begin() { self.row=0; transition 0 { _ -> calls() } }
    state calls() { transition self.row < 2 { true -> call_one() _ -> done() } }
    state call_one() { self.at=self.witness+6416+self.row*36; self.expect_u32(self.at+12,self.row); self.read_u32(self.at+20); self.start=self.decoded; self.read_u32(self.at+24); self.count=self.decoded; self.span_bounds(self.start,self.count); transition self.match_ok == 1 { true -> target() _ -> bad() } }
    state target() { self.at=self.witness+5160+self.row*56; self.read_u32(self.at+32); self.x=self.decoded; self.read_u32(self.at+36); self.y=self.decoded; transition self.count >= self.y { true -> compare() _ -> bad() } }
    state compare() { self.source_spans_equal(self.start,self.x,self.y); transition self.match_ok == 1 { true -> call_next() _ -> bad() } }
    state call_next() { self.row=self.row+1; transition 0 { _ -> calls() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_v12_facts(&mut self) {
    self.row=0; transition 0 { _ -> record_flags() }
    state record_flags() { transition self.row < 8 { true -> record_flag() _ -> sum_flags_begin() } }
    state record_flag() { self.x=0; transition self.row < 6 { true -> copied_record() _ -> record_fixed() } }
    state copied_record() { self.x=1; transition 0 { _ -> record_fixed() } }
    state record_fixed() { self.expect_u32(self.witness+916+self.row*32+28,self.x); self.row=self.row+1; transition self.status == 0 { true -> record_flags() _ -> done() } }
    state sum_flags_begin() { self.row=0; transition 0 { _ -> sum_flags() } }
    state sum_flags() { transition self.row < 5 { true -> sum_flag() _ -> token_payloads() } }
    state sum_flag() { self.expect_u32(self.witness+1868+self.row*32+28,1); self.row=self.row+1; transition self.status == 0 { true -> sum_flags() _ -> done() } }
    state token_payloads() { self.expect_u32(self.witness+2028+77*28+12,0); self.expect_u32(self.witness+2028+77*28+16,3); self.expect_u32(self.witness+2028+78*28+12,3); self.expect_u32(self.witness+2028+78*28+16,3); self.expect_u32(self.witness+2028+80*28+12,6); self.expect_u32(self.witness+2028+80*28+16,1); self.expect_u32(self.witness+2028+81*28+12,7); self.expect_u32(self.witness+2028+81*28+16,1); transition self.status == 0 { true -> stores_begin() _ -> done() } }
    state stores_begin() { self.row=0; transition 0 { _ -> stores() } }
    state stores() { transition self.row < 15 { true -> store_one() _ -> args() } }
    state store_one() { self.at=self.witness+6488+self.row*40; self.expect_u32(self.at+4,0); self.expect_u32(self.at+8,1); self.expect_u32(self.at+36,22); self.x=21; transition self.row < 6 { true -> token_owner() _ -> store_owner() } }
    state token_owner() { self.x=20; transition 0 { _ -> store_owner() } }
    state store_owner() { self.expect_u32(self.at+12,self.x); self.row=self.row+1; transition self.status == 0 { true -> stores() _ -> done() } }
    state args() { self.at=self.witness+7168; self.expect_u32(self.at+12,0); self.expect_u32(self.at+16,1); self.expect_u32(self.at+20,4); self.at=self.witness+7168+32; self.expect_u32(self.at+12,11); self.expect_u32(self.at+16,2); self.expect_u32(self.at+20,78); self.expect_u32(self.at+24,5); self.at=self.witness+7168+6*32; self.expect_u32(self.at+12,13); self.expect_u32(self.at+20,70); self.at=self.witness+7168+10*32; self.expect_u32(self.at+4,1); self.expect_u32(self.at+8,0); self.expect_u32(self.at+12,16); self.expect_u32(self.at+20,0); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_v12(&mut self) {
    transition self.witness_n == 7520 { true -> magic() _ -> bad() }
    state magic() { self.expect_byte(self.witness,79); self.expect_byte(self.witness+1,77); self.expect_byte(self.witness+2,71); self.expect_byte(self.witness+3,82); self.expect_byte(self.witness+4,83); self.expect_byte(self.witness+5,87); self.expect_byte(self.witness+6,67); self.expect_byte(self.witness+7,0); self.expect_byte(self.witness+8,12); self.expect_byte(self.witness+9,0); self.expect_byte(self.witness+10,0); self.expect_byte(self.witness+11,0); self.expect_byte(self.witness+12,0); self.expect_byte(self.witness+13,0); self.expect_byte(self.witness+14,192); self.expect_byte(self.witness+15,0); transition self.status == 0 { true -> header0() _ -> done() } }
    state header0() { self.expect_u32(self.witness+16,7520); self.expect_u32(self.witness+20,self.comp_n); self.expect_u32(self.witness+24,1); self.expect_u32(self.witness+28,22); self.expect_u32(self.witness+32,8); self.expect_u32(self.witness+36,29); self.expect_u32(self.witness+40,5); self.expect_u32(self.witness+44,105); self.expect_u32(self.witness+48,8); transition self.status == 0 { true -> header1() _ -> done() } }
    state header1() { self.expect_u32(self.witness+52,3); self.expect_u32(self.witness+56,11); self.expect_u32(self.witness+60,14); self.expect_u32(self.witness+64,11); self.expect_u32(self.witness+68,2); self.expect_u32(self.witness+72,15); self.expect_u32(self.witness+76,20); self.expect_u32(self.witness+80,11); self.expect_u32(self.witness+84,2); transition self.status == 0 { true -> header2() _ -> done() } }
    state header2() { self.expect_u32(self.witness+88,0); self.expect_u32(self.witness+92,1); self.expect_u32(self.witness+96,2); self.expect_u32(self.witness+100,3); self.expect_u32(self.witness+104,4); self.expect_u32(self.witness+108,5); self.expect_u32(self.witness+112,6); self.expect_u32(self.witness+116,7); self.expect_u32(self.witness+120,0); self.expect_u32(self.witness+124,1); self.expect_u32(self.witness+128,2); self.expect_u32(self.witness+132,3); self.expect_u32(self.witness+136,4); transition self.status == 0 { true -> header3() _ -> done() } }
    state header3() { self.expect_u32(self.witness+140,78); self.expect_u32(self.witness+144,0); self.expect_u32(self.witness+148,1); self.expect_u32(self.witness+152,16384); self.expect_u32(self.witness+156,65536); self.expect_u32(self.witness+160,1); self.expect_u32(self.witness+164,1638456); self.expect_u32(self.witness+168,0); self.expect_u32(self.witness+172,2097152); self.expect_u32(self.witness+176,0); self.expect_u32(self.witness+180,0); self.expect_u32(self.witness+184,0); self.expect_u32(self.witness+188,0); self.expect_u32(self.witness+192,0); self.expect_u32(self.witness+204,self.source_length); transition self.status == 0 { true -> dense() _ -> done() } }
    state dense() { self.validate_v12_dense(212,22,32); self.validate_v12_dense(916,8,32); self.validate_v12_dense(1172,29,24); self.validate_v12_dense(1868,5,32); self.validate_v12_dense(2028,105,28); self.validate_v12_dense(4968,8,24); self.validate_v12_dense(5160,3,56); self.validate_v12_dense(5328,11,24); self.validate_v12_dense(5592,14,40); self.validate_v12_dense(6152,11,24); self.validate_v12_dense(6416,2,36); self.validate_v12_dense(6488,15,40); self.validate_v12_dense(7168,11,32); transition self.status == 0 { true -> facts() _ -> done() } }
    state facts() { self.validate_v12_facts(); transition self.status == 0 { true -> names() _ -> done() } }
