use omega::language::std::console;
data Counter {
    value: i32;
}
data Main {
    console: Console;
    counter: Counter;
}
machine Counter::bump(&mut self, by: i32) {
    self.value = self.value + by;
}
machine Counter::get(&mut self) -> i32 {
    return self.value * 2;
}
machine Main::main(&mut self) {
    self.counter.bump(10);
    self.counter.bump(11);
    let x: i32 = self.counter.get();
    self.console.exit_process(x + self.counter.value);
}
// Expected exit: 63.  (bump 10+11 -> value 21; get() -> 42; 42 + 21 = 63)
// Exercises CROSS-DATA METHOD CALLS: Counter::bump / Counter::get own `data Counter`, whose single
// instance in Main is `counter` — so the methods' `self.value` and Main's `self.counter.value`
// unify to one threaded slot (single-instance monomorphization by receiver path).
