data Token [copy] {
    case Empty;
    case Value(value: u8);
}

data OrderedGate {}

data SumProducer {
    pad: u8;
    current: Token;
    gate: OrderedGate;
}

machine OrderedGate::check(&self) -> u8 {
    transition 70 > 69 && 70 >= 70 && 70 == 70 {
        true -> passed()
        false -> failed()
    }

    state passed(&self) { 70 }
    state failed(&self) { 0 }
}

machine SumProducer::run(&mut self) -> u8 {
    self.pad = self.gate.check();
    self.current = Token::Value { value: self.pad };
    transition self.current {
        Token::Empty -> empty()
        Token::Value { value } -> selected(value)
    }

    state empty(&mut self) { 0 }
    state selected(&mut self, value: u8) { value }
}
