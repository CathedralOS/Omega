// General constant-aggregate positive: names and dimensions intentionally do
// not mirror the generated Unicode tables.

data TinyRange [copy] {
    last: u32 in Trapping;
    first: u32 in Trapping;
}

data TinyBand [copy] {
    marker: u8;
    ranges: [TinyRange; 3] in Trapping;
}

data TinyCatalog [copy] {
    fallback: TinyRange;
    bands: [TinyBand; 2] in Trapping;
}

data AggregateProbe {
    original: TinyCatalog;
    duplicate: TinyCatalog;
}

machine AggregateProbe::run(&mut self) -> u8 {
    self.original = TinyCatalog {
        bands: [
            TinyBand {
                ranges: [
                    TinyRange { first: 3, last: 5 },
                    TinyRange { first: 8, last: 13 },
                    TinyRange { first: 21, last: 34 }
                ],
                marker: 9
            },
            TinyBand {
                ranges: [
                    TinyRange { first: 35, last: 40 },
                    TinyRange { first: 41, last: 55 },
                    TinyRange { first: 56, last: 70 }
                ],
                marker: 11
            }
        ],
        fallback: TinyRange { first: 0, last: 0 }
    };
    self.duplicate = self.original;
    self.original.bands[1].ranges[2].last = 69;
    transition self.duplicate.bands[0].ranges[0].first <= 3 {
        true -> first_low()
        _ -> fail()
    }

    state first_low(&mut self) {
        transition 3 <= self.duplicate.bands[0].ranges[0].first {
            true -> copied_last_high()
            _ -> fail()
        }
    }

    state copied_last_high(&mut self) {
        transition self.duplicate.bands[1].ranges[2].last <= 70 {
            true -> copied_last_low()
            _ -> fail()
        }
    }

    state copied_last_low(&mut self) {
        transition 70 <= self.duplicate.bands[1].ranges[2].last {
            true -> source_changed_high()
            _ -> fail()
        }
    }

    state source_changed_high(&mut self) {
        transition self.original.bands[1].ranges[2].last <= 69 {
            true -> source_changed_low()
            _ -> fail()
        }
    }

    state source_changed_low(&mut self) {
        transition 69 <= self.original.bands[1].ranges[2].last {
            true -> pass()
            _ -> fail()
        }
    }

    state pass(&mut self) {
        self.duplicate.bands[1].ranges[2].last
    }

    state fail(&mut self) { 71 }
}
