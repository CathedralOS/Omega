// `mapped` and `source` are distinct state-parameter identities. The interval
// proven for `source` must transfer by target-parameter ordinal to `mapped`;
// retaining the predecessor parameter identity makes the indexed load unsafe.
// The consumer deliberately precedes its predecessor in declaration order.

data StaleIdentityProbe {
    values: [u8; 1] in Trapping;
}

machine StaleIdentityProbe::run(&mut self) -> u8 {
    self.values = [70];
    transition { _ -> predecessor(0) }

    state consumer(&mut self, mapped: u32 in Trapping) {
        self.values[mapped]
    }

    state predecessor(&mut self, source: u32 in Trapping) {
        transition source < 1 {
            true -> consumer(source)
            _ -> fail()
        }
    }

    state fail(&mut self) { 71 }
}
