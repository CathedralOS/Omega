data ByteProducer {}
machine ByteProducer::run(&mut self) -> u8 {
    transition { _ -> inspect("F") }
    state inspect(&mut self, view: &[u8]) {
        transition view.len > 0 {
            true -> present(view[0], view[1..])
            false -> empty()
        }
    }
    state present(&mut self, head: u8, tail: &[u8]) { head }
    state empty(&mut self) { 70 }
}
