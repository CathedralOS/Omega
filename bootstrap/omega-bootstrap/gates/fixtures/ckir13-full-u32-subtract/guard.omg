data SubProducer {
    cursor: u32 in Trapping;
    floor: u32 in Trapping;
}

machine SubProducer::run(&mut self) -> u8 {
    self.cursor = 70;
    self.floor = 1;
    transition self.cursor - 1 < 70 {
        true -> passed()
        false -> failed()
    }

    state passed(&mut self) { 70 }
    state failed(&mut self) { 0 }
}
