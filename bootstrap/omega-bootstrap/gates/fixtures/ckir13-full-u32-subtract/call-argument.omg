data Gate {}

machine Gate::keep(&self, prefix: u8, value: u32 in Trapping, suffix: u8) -> u32 in Trapping {
    value
}

data SubProducer {
    gate: Gate;
    cursor: u32 in Trapping;
    floor: u32 in Trapping;
}

machine SubProducer::run(&mut self) -> u8 {
    self.cursor = 70;
    self.floor = 1;
    self.cursor = self.gate.keep(7, self.cursor - self.floor, 9);
    transition self.cursor == 69 {
        true -> passed()
        false -> failed()
    }

    state passed(&mut self) { 70 }
    state failed(&mut self) { 0 }
}
