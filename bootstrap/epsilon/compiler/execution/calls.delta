
; Checked callable identity selects one route. Receiver selection and ordinary
; value argument binding remain separate operations with explicit effect order.
(def epsilon_evaluate_call ((context EpsilonEvaluatorInvocation)
  (expressionValue EpsilonExpression) (base EpsilonExpression)
  (arguments EpsilonExpressionList) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (match context
    ((EpsilonEvaluatorInvocationContext source machineValue references
      receiver blockFloor)
      (match (epsilon_runtime_find_callable_reference_normalized expressionValue
        references)
        (NoEpsilonResolvedCallableReference
          (EpsilonEvaluatorInternal (epsilon_expression_start expressionValue)))
        ((OneEpsilonResolvedCallableReference callable)
          (match callable
            ((EpsilonResolvedUnqualifiedMachineCallable targetMachine)
              (epsilon_evaluate_machine_call context targetMachine
                NoEpsilonRuntimePlace arguments bindings store output))
            ((EpsilonResolvedDataMachineCallable owner targetMachine)
              (epsilon_evaluate_receiver_call context callable base arguments
                bindings store output))
            ((EpsilonResolvedBoundaryMachineCallable owner memberValue)
              (epsilon_evaluate_receiver_call context callable base arguments
                bindings store output))
            ((EpsilonResolvedConstructorCallable owner caseValue)
              (EpsilonEvaluatorInternal (epsilon_expression_start expressionValue)))))))))
