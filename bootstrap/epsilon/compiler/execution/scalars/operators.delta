
(def epsilon_evaluator_i32_outcome ((value Int)) EpsilonEvaluatorScalarOutcome
  (if (lt value -2147483648)
    (EpsilonEvaluatorScalarTrapped 1)
    (if (lt 2147483647 value)
      (EpsilonEvaluatorScalarTrapped 1)
      (EpsilonEvaluatorScalarValue value))))

(def epsilon_evaluator_unsigned_i32 ((value Int)) Int
  (if (lt value 0) (+ value 4294967296) value))

(def epsilon_evaluator_signed_i32 ((value Int)) Int
  (if (lt 2147483647 value) (- value 4294967296) value))

(def epsilon_evaluator_bit_digit ((left Int) (right Int) (kind Int)) Int
  (if (eq kind 1)
    (if (eq left 1) right 0)
    (if (eq kind 2)
      (if (eq left 1) 1 right)
      (if (eq left right) 0 1))))

(def epsilon_evaluator_bitwise_unsigned ((left Int) (right Int) (kind Int)
  (remaining Int) (place Int) (result Int)) Int
  (if (eq remaining 0)
    result
    (epsilon_evaluator_bitwise_unsigned (/ left 2) (/ right 2) kind
      (- remaining 1) (* place 2)
      (+ result
        (* place (epsilon_evaluator_bit_digit (% left 2) (% right 2) kind))))))

(def epsilon_evaluator_bitwise ((left Int) (right Int) (kind Int)) Int
  (epsilon_evaluator_signed_i32
    (epsilon_evaluator_bitwise_unsigned
      (epsilon_evaluator_unsigned_i32 left)
      (epsilon_evaluator_unsigned_i32 right) kind 32 1 0)))

(def epsilon_evaluator_shift_power ((count Int) (value Int)) Int
  (if (eq count 0)
    value
    (epsilon_evaluator_shift_power (- count 1) (* value 2))))

(def epsilon_evaluator_shift_right_one ((value Int)) Int
  (if (lt value 0)
    (let quotient Int (/ value 2)
      (if (eq (% value 2) 0) quotient (- quotient 1)))
    (/ value 2)))

(def epsilon_evaluator_shift_right ((value Int) (count Int)) Int
  (if (eq count 0)
    value
    (epsilon_evaluator_shift_right
      (epsilon_evaluator_shift_right_one value) (- count 1))))

(def epsilon_evaluate_core_binary_values ((operator EpsilonBinaryOperator)
  (left Int) (right Int)) EpsilonEvaluatorScalarOutcome
  (match operator
    (EpsilonEqual (EpsilonEvaluatorScalarValue (eq left right)))
    (EpsilonNotEqual (EpsilonEvaluatorScalarValue (if (eq left right) 0 1)))
    (EpsilonLess (EpsilonEvaluatorScalarValue (lt left right)))
    (EpsilonLessEqual
      (EpsilonEvaluatorScalarValue (if (lt right left) 0 1)))
    (EpsilonGreater (EpsilonEvaluatorScalarValue (lt right left)))
    (EpsilonGreaterEqual
      (EpsilonEvaluatorScalarValue (if (lt left right) 0 1)))
    (EpsilonAdd (epsilon_evaluator_i32_outcome (+ left right)))
    (EpsilonSubtract (epsilon_evaluator_i32_outcome (- left right)))
    (EpsilonMultiply (epsilon_evaluator_i32_outcome (* left right)))
    ; Logical operations must pass through the short-circuit dispatcher.
    (EpsilonLogicalOr EpsilonEvaluatorScalarInternal)
    (EpsilonLogicalAnd EpsilonEvaluatorScalarInternal)
    (EpsilonBitOr
      (EpsilonEvaluatorScalarValue (epsilon_evaluator_bitwise left right 2)))
    (EpsilonBitXor
      (EpsilonEvaluatorScalarValue (epsilon_evaluator_bitwise left right 3)))
    (EpsilonBitAnd
      (EpsilonEvaluatorScalarValue (epsilon_evaluator_bitwise left right 1)))
    (EpsilonShiftLeft
      (if (if (lt right 0) 1 (lt 31 right))
        (EpsilonEvaluatorScalarTrapped 4)
        (EpsilonEvaluatorScalarValue
          (epsilon_evaluator_signed_i32
            (% (* (epsilon_evaluator_unsigned_i32 left)
                 (epsilon_evaluator_shift_power right 1))
              4294967296)))))
    (EpsilonShiftRight
      (if (if (lt right 0) 1 (lt 31 right))
        (EpsilonEvaluatorScalarTrapped 4)
        (EpsilonEvaluatorScalarValue
          (epsilon_evaluator_shift_right left right))))
    (EpsilonDivide
      (if (eq right 0)
        (EpsilonEvaluatorScalarTrapped 2)
        (if (if (eq left -2147483648) (eq right -1) 0)
          (EpsilonEvaluatorScalarTrapped 3)
          (EpsilonEvaluatorScalarValue (/ left right)))))
    (EpsilonRemainder
      (if (eq right 0)
        (EpsilonEvaluatorScalarTrapped 2)
        (if (if (eq left -2147483648) (eq right -1) 0)
          (EpsilonEvaluatorScalarTrapped 3)
          (EpsilonEvaluatorScalarValue (% left right)))))))
