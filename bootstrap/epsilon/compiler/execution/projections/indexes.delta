
(def epsilon_evaluator_index_value ((baseValue EpsilonRuntimeValue)
  (basePlace EpsilonRuntimeOptionalPlace) (index Int)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (match baseValue
    ((EpsilonRuntimeInteger scalar) (EpsilonEvaluatorInternal 0))
    ((EpsilonRuntimeAggregate typeValue children)
      (match typeValue
        ((EpsilonArrayType start end element lengthValue)
          (if (if (lt index 0) 1
                (if (lt index (epsilon_integer_literal_value lengthValue)) 0 1))
            (EpsilonEvaluatorTrap 6 output)
            (epsilon_evaluator_project_value baseValue basePlace
              (EpsilonRuntimeIndex index) element store output)))
        ((EpsilonI32Type start end) (EpsilonEvaluatorInternal start))
        ((EpsilonU8Type start end) (EpsilonEvaluatorInternal start))
        ((EpsilonNeverType start end) (EpsilonEvaluatorInternal start))
        ((EpsilonNamedType start end name) (EpsilonEvaluatorInternal start))
        ((EpsilonViewType start end element) EpsilonEvaluatorUnsupported)))))

; Index effects may change the selected array. Its identity and length were
; established by the base; the element is read from the post-index store.
(def epsilon_evaluate_index_operand ((context EpsilonEvaluatorInvocation)
  (baseValue EpsilonRuntimeValue) (basePlace EpsilonRuntimeOptionalPlace)
  (indexValue EpsilonExpression) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (let outcome EpsilonEvaluatorOutcome
    (epsilon_evaluate_expression context indexValue bindings store output)
    (match outcome
      ((EpsilonEvaluatorValue value place nextStore nextOutput)
        (match value
          ((EpsilonRuntimeInteger index)
            (epsilon_evaluator_index_value baseValue basePlace index
              nextStore nextOutput))
          ((EpsilonRuntimeAggregate typeValue children)
            (EpsilonEvaluatorInternal (epsilon_expression_start indexValue)))))
      ((EpsilonEvaluatorResultless nextStore nextOutput)
        (EpsilonEvaluatorInternal (epsilon_expression_start indexValue)))
      ((EpsilonEvaluatorExit code nextOutput) outcome)
      ((EpsilonEvaluatorTrap kind nextOutput) outcome)
      ((EpsilonEvaluatorInternal offset) outcome)
      (EpsilonEvaluatorUnsupported outcome))))

(def epsilon_evaluate_index ((context EpsilonEvaluatorInvocation)
  (base EpsilonExpression) (indexValue EpsilonExpression)
  (bindings EpsilonEvaluatorBindings) (store EpsilonRuntimeStore)
  (output Bytes)) EpsilonEvaluatorOutcome
  (let outcome EpsilonEvaluatorOutcome
    (epsilon_evaluate_expression context base bindings store output)
    (match outcome
      ((EpsilonEvaluatorValue value place nextStore nextOutput)
        (epsilon_evaluate_index_operand context value place indexValue bindings
          nextStore nextOutput))
      ((EpsilonEvaluatorResultless nextStore nextOutput)
        (EpsilonEvaluatorInternal (epsilon_expression_start base)))
      ((EpsilonEvaluatorExit code nextOutput) outcome)
      ((EpsilonEvaluatorTrap kind nextOutput) outcome)
      ((EpsilonEvaluatorInternal offset) outcome)
      (EpsilonEvaluatorUnsupported outcome))))
