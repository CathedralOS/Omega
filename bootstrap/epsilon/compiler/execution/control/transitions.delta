
(def epsilon_evaluate_control_call ((context EpsilonEvaluatorInvocation)
  (expressionValue EpsilonExpression) (arguments EpsilonExpressionList)
  (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match context
    ((EpsilonEvaluatorInvocationContext source machineValue references
      receiver blockRootFloor)
      (match (epsilon_runtime_find_state_application expressionValue references)
        (NoEpsilonStateApplicationReference
          (match (epsilon_evaluate_expression context expressionValue bindings
            store output)
            ((EpsilonEvaluatorValue value place nextStore nextOutput)
              (EpsilonEvaluatorBlockInternal
                (epsilon_expression_start expressionValue)))
            ((EpsilonEvaluatorResultless nextStore nextOutput)
              (EpsilonEvaluatorBlockFalloff bindings nextStore nextOutput))
            ((EpsilonEvaluatorExit code nextOutput)
              (EpsilonEvaluatorBlockExit code nextOutput))
            ((EpsilonEvaluatorTrap kind nextOutput)
              (EpsilonEvaluatorBlockTrap kind nextOutput))
            ((EpsilonEvaluatorInternal offset)
              (EpsilonEvaluatorBlockInternal offset))
            (EpsilonEvaluatorUnsupported EpsilonEvaluatorBlockUnsupported)))
        ((OneEpsilonStateApplicationReference targetMachine stateValue progress)
          (match progress
            (EpsilonStateApplicationResolved
              (EpsilonEvaluatorBlockInternal
                (epsilon_expression_start expressionValue)))
            (EpsilonStateApplicationComplete
              (epsilon_evaluate_state_application context targetMachine
                stateValue arguments bindings store output))))))))

(def epsilon_evaluate_control_expression ((context EpsilonEvaluatorInvocation)
  (expressionValue EpsilonExpression) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match (epsilon_call_head_core expressionValue)
    ((EpsilonCallExpression start end base arguments)
      (epsilon_evaluate_control_call context
        (epsilon_call_head_core expressionValue) arguments bindings store output))
    ; Checking admits only call-shaped control targets. These cores contradict
    ; that premise; report the core coordinate without executing any child.
    ((EpsilonIntegerExpression start end literal) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonCharacterExpression start end literal) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonStringExpression start end literal) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonTrueExpression start end) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonFalseExpression start end) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonNameExpression start end name) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonQualifiedExpression start end owner name arguments)
      (EpsilonEvaluatorBlockInternal start))
    ((EpsilonGroupedExpression start end inner) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonFieldExpression start end base field) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonIndexExpression start end base indexValue) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonSliceExpression start end base low high) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonNegateExpression start end operand) (EpsilonEvaluatorBlockInternal start))
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) (EpsilonEvaluatorBlockInternal start))))

(def epsilon_evaluate_return ((context EpsilonEvaluatorInvocation)
  (expressionValue EpsilonOptionalExpression)
  (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match expressionValue
    (NoEpsilonExpression (EpsilonEvaluatorBlockFalloff bindings store output))
    ((SomeEpsilonExpression expression)
      (let outcome EpsilonEvaluatorOutcome
        (epsilon_evaluate_expression context expression bindings store output)
        (match outcome
          ((EpsilonEvaluatorValue value place nextStore nextOutput)
            (EpsilonEvaluatorBlockReturn value nextStore nextOutput))
          ((EpsilonEvaluatorResultless nextStore nextOutput)
            (epsilon_evaluator_stopped_block outcome
              (epsilon_expression_start expression)))
          ((EpsilonEvaluatorExit code nextOutput)
            (EpsilonEvaluatorBlockExit code nextOutput))
          ((EpsilonEvaluatorTrap kind nextOutput)
            (EpsilonEvaluatorBlockTrap kind nextOutput))
          ((EpsilonEvaluatorInternal offset)
            (EpsilonEvaluatorBlockInternal offset))
          (EpsilonEvaluatorUnsupported EpsilonEvaluatorBlockUnsupported))))))

(def epsilon_evaluate_continuation ((context EpsilonEvaluatorInvocation)
  (continuation EpsilonContinuation) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match continuation
    ((EpsilonExpressionContinuation start end expressionValue)
      (epsilon_evaluate_control_expression context expressionValue bindings store
        output))
    ((EpsilonReturnContinuation start end expressionValue)
      (epsilon_evaluate_return context expressionValue bindings store output))))

(def epsilon_evaluate_scalar_arms ((context EpsilonEvaluatorInvocation)
  (arms EpsilonArmList) (subject Int) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match arms
    (NoEpsilonArms (EpsilonEvaluatorBlockTrap 9 output))
    ((MoreEpsilonArms item rest)
      (match item
        ((EpsilonArmSyntax start end patternValue continuation)
          (match context
            ((EpsilonEvaluatorInvocationContext source machineValue references
              receiver blockRootFloor)
              (match (epsilon_runtime_find_complete_transition_pattern
                patternValue references)
                (NoEpsilonTransitionPatternKind
                  (EpsilonEvaluatorBlockInternal start))
                ((OneEpsilonTransitionPatternKind kind)
                  (match kind
                    ((EpsilonScalarPatternSelector selector)
                      (if (eq subject selector)
                        (epsilon_evaluate_continuation context continuation
                          bindings store output)
                        (epsilon_evaluate_scalar_arms context rest subject
                          bindings store output)))
                    (EpsilonTransitionWildcard
                      (epsilon_evaluate_continuation context continuation
                        bindings store output))
                    ((EpsilonSumCasePattern owner caseValue)
                      (EpsilonEvaluatorBlockInternal start))))))))))))

(def epsilon_evaluate_terminal ((context EpsilonEvaluatorInvocation)
  (terminalValue EpsilonTerminal) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match terminalValue
    ((EpsilonReturnTerminal start end expressionValue)
      (epsilon_evaluate_return context expressionValue bindings store output))
    ((EpsilonTransitionTerminal start end expressionValue arms)
      (match context
        ((EpsilonEvaluatorInvocationContext source machineValue references
          receiver blockRootFloor)
          (match (epsilon_runtime_find_transition_subject terminalValue references)
            (NoEpsilonTransitionSubjectReference
              (EpsilonEvaluatorBlockInternal start))
            ((OneEpsilonTransitionSubjectReference kind)
              (match kind
                ((EpsilonSumTransitionSubject owner)
                  (epsilon_evaluate_sum_transition context expressionValue arms owner
                    bindings store output))
                (EpsilonScalarTransitionSubject
                  (match (epsilon_evaluate_expression context expressionValue
                    bindings store output)
                    (EpsilonEvaluatorUnsupported EpsilonEvaluatorBlockUnsupported)
                    ((EpsilonEvaluatorInternal offset)
                      (EpsilonEvaluatorBlockInternal offset))
                    ((EpsilonEvaluatorExit code nextOutput)
                      (EpsilonEvaluatorBlockExit code nextOutput))
                    ((EpsilonEvaluatorTrap trapKind nextOutput)
                      (EpsilonEvaluatorBlockTrap trapKind nextOutput))
                    ((EpsilonEvaluatorResultless nextStore nextOutput)
                      (EpsilonEvaluatorBlockInternal start))
                    ((EpsilonEvaluatorValue value place nextStore nextOutput)
                      (match value
                        ((EpsilonRuntimeInteger scalar)
                          (epsilon_evaluate_scalar_arms context arms scalar bindings
                            nextStore nextOutput))
                        ((EpsilonRuntimeAggregate typeValue children)
                          (EpsilonEvaluatorBlockInternal start))
                        ((EpsilonRuntimeSumValue owner caseValue payload)
                          (EpsilonEvaluatorBlockInternal start))
                        ((EpsilonRuntimeViewValue view)
                          (EpsilonEvaluatorBlockInternal start))))))))))))))
