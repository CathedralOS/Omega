
(def epsilon_evaluate_state_application ((context EpsilonEvaluatorInvocation)
  (targetMachine EpsilonDeclaration) (stateValue EpsilonState)
  (arguments EpsilonExpressionList) (locals EpsilonEvaluatorLocalValueList)
  (fields EpsilonEvaluatorFieldValueList) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match context
    ((EpsilonEvaluatorInvocationContext source machineValue references
      fieldReferences callables control)
      (if (eq (epsilon_declaration_end machineValue)
              (epsilon_declaration_end targetMachine))
        (match machineValue
          ((EpsilonBoundaryDeclaration start end name members)
            (EpsilonEvaluatorBlockInternal start))
          ((EpsilonDataDeclaration start end name members)
            (EpsilonEvaluatorBlockInternal start))
          ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
            (match stateValue
              ((EpsilonStateSyntax stateStart stateEnd stateName parameters stateBody)
                (match (epsilon_evaluate_arguments context parameters arguments
                  locals fields output
                  (epsilon_evaluator_preserve_machine_parameters
                    (epsilon_machine_input_parameters inputs) locals))
                  ((EpsilonEvaluatorArgumentsStopped outcome)
                    (epsilon_evaluator_stopped_block outcome stateStart))
                  ((EpsilonEvaluatorArgumentsBound bound nextFields nextOutput)
                    (EpsilonEvaluatorBlockTransfer stateValue bound nextFields
                      nextOutput)))))))
        (EpsilonEvaluatorBlockInternal
          (epsilon_declaration_end targetMachine))))))
