
; State transfers reuse one invocation. Ordinary calls create their own local
; environment and return values/effects to the caller that owns its continuation.
(def epsilon_evaluator_resume ((context EpsilonEvaluatorInvocation)
  (outcome EpsilonEvaluatorBlockOutcome)) EpsilonEvaluatorOutcome
  (match outcome
    ((EpsilonEvaluatorBlockFalloff bindings store output)
      (EpsilonEvaluatorResultless store output))
    ((EpsilonEvaluatorBlockReturn value store output)
      (EpsilonEvaluatorValue value NoEpsilonRuntimePlace store output))
    ((EpsilonEvaluatorBlockTransfer stateValue bindings store output)
      (match stateValue
        ((EpsilonStateSyntax start end name parameters bodyValue)
          (match bodyValue
            ((EpsilonStateBodySyntax bodyStart bodyEnd statements terminalValue)
              (epsilon_evaluator_resume context
                (epsilon_evaluate_block context statements terminalValue bindings
                  store output)))))))
    ((EpsilonEvaluatorBlockExit code output) (EpsilonEvaluatorExit code output))
    ((EpsilonEvaluatorBlockTrap kind output) (EpsilonEvaluatorTrap kind output))
    ((EpsilonEvaluatorBlockInternal offset) (EpsilonEvaluatorInternal offset))
    (EpsilonEvaluatorBlockUnsupported EpsilonEvaluatorUnsupported)))

(def epsilon_evaluate_invocation ((context EpsilonEvaluatorInvocation)
  (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (match context
    ((EpsilonEvaluatorInvocationContext source machineValue references
      receiver blockRootFloor)
      (match machineValue
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (match bodyValue
            ((EpsilonMachineBodySyntax bodyStart bodyEnd statements
              terminalValue states)
              (epsilon_evaluator_resume context
                (epsilon_evaluate_block context statements terminalValue bindings
                  store output)))))
        ((EpsilonBoundaryDeclaration start end name machines)
          (EpsilonEvaluatorInternal start))
        ((EpsilonDataDeclaration start end name members)
          (EpsilonEvaluatorInternal start))))))

; This is the only adapter that maps ordinary completion to process exit.
; Calling Main::main recursively goes through epsilon_evaluate_machine_call.
(def epsilon_evaluator_finish_entry ((outcome EpsilonEvaluatorOutcome))
  EpsilonEvaluatorSliceOutcome
  (match outcome
    ((EpsilonEvaluatorResultless store output) (EpsilonEvaluatorSliceExit 0 output))
    ((EpsilonEvaluatorValue value place store output) (EpsilonEvaluatorSliceInternal 0))
    ((EpsilonEvaluatorExit code output) (EpsilonEvaluatorSliceExit code output))
    ((EpsilonEvaluatorTrap kind output) (EpsilonEvaluatorSliceTrap kind output))
    ((EpsilonEvaluatorInternal offset) (EpsilonEvaluatorSliceInternal offset))
    (EpsilonEvaluatorUnsupported EpsilonEvaluatorSliceUnsupported)))

(def epsilon_evaluator_start_entry ((source Bytes) (machineValue EpsilonDeclaration)
  (references EpsilonResolvedLocalReferenceList)
  (fieldReferences EpsilonResolvedFieldReferenceList)
  (callables EpsilonResolvedCallableReferenceList)
  (control EpsilonControlReferenceLedger) (owner EpsilonName) (input Bytes))
  EpsilonEvaluatorSliceOutcome
  (let typeValue EpsilonType
    (EpsilonNamedType (epsilon_name_start owner) (epsilon_name_end owner) owner)
    (match (epsilon_runtime_allocate (epsilon_runtime_zero_value typeValue)
      (EpsilonRuntimeStoreState 1 NoEpsilonRuntimeRoots
        (EpsilonRuntimeConsoleInputAt input 0)))
      ((EpsilonRuntimeAllocated identifier store)
        (epsilon_evaluator_finish_entry
          (epsilon_evaluate_invocation
            (EpsilonEvaluatorInvocationContext source machineValue
              (epsilon_runtime_index_references (bytes_length source)
                references fieldReferences callables control)
              (SomeEpsilonRuntimePlace
                (EpsilonRuntimePlaceAt identifier NoEpsilonRuntimePath typeValue))
              (epsilon_runtime_next_identifier store))
            NoEpsilonEvaluatorBindings store (bytes_empty)))))))

(def epsilon_evaluate_entry_declarations ((source Bytes)
  (declarations EpsilonDeclarationList)
  (references EpsilonResolvedLocalReferenceList)
  (fieldReferences EpsilonResolvedFieldReferenceList)
  (callables EpsilonResolvedCallableReferenceList)
  (control EpsilonControlReferenceLedger) (input Bytes)) EpsilonEvaluatorSliceOutcome
  (match declarations
    (NoEpsilonDeclarations (EpsilonEvaluatorSliceInternal 0))
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_evaluate_entry_declarations source rest references
            fieldReferences callables control input))
        ((EpsilonDataDeclaration start end name members)
          (epsilon_evaluate_entry_declarations source rest references
            fieldReferences callables control input))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (if (epsilon_qualified_name_is_main_entry source name)
            (match name
              ((EpsilonUnqualifiedName nameStart nameEnd machineName)
                (EpsilonEvaluatorSliceInternal nameStart))
              ((EpsilonQualifiedNameSyntax nameStart nameEnd owner machineName)
                (epsilon_evaluator_start_entry source item references
                  fieldReferences callables control owner input)))
            (epsilon_evaluate_entry_declarations source rest references
              fieldReferences callables control input)))))))
