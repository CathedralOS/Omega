
; The statement coordinator threads exact bindings, current store, and output.
(def epsilon_evaluate_statements ((context EpsilonEvaluatorInvocation)
  (statements EpsilonStatementList) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorBlockOutcome
  (match statements
    (NoEpsilonStatements (EpsilonEvaluatorBlockFalloff bindings store output))
    ((MoreEpsilonStatements item rest)
      (let outcome EpsilonEvaluatorBlockOutcome
        (epsilon_evaluate_one_statement context item bindings store output)
        (match outcome
          ((EpsilonEvaluatorBlockFalloff nextBindings nextStore nextOutput)
            (epsilon_evaluate_statements context rest nextBindings nextStore nextOutput))
          ((EpsilonEvaluatorBlockTransfer stateValue nextBindings nextStore nextOutput) outcome)
          ((EpsilonEvaluatorBlockReturn value nextStore nextOutput) outcome)
          ((EpsilonEvaluatorBlockExit code nextOutput) outcome)
          ((EpsilonEvaluatorBlockTrap kind nextOutput) outcome)
          ((EpsilonEvaluatorBlockInternal offset) outcome))))))

(def epsilon_evaluate_one_statement ((context EpsilonEvaluatorInvocation)
  (statementValue EpsilonStatement) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorBlockOutcome
  (match statementValue
    ((EpsilonPostfixStatement start end expressionValue)
      (match (epsilon_evaluate_expression context expressionValue bindings store output)
        ((EpsilonEvaluatorValue value place nextStore nextOutput)
          (EpsilonEvaluatorBlockFalloff bindings nextStore nextOutput))
        ((EpsilonEvaluatorResultless nextStore nextOutput)
          (EpsilonEvaluatorBlockFalloff bindings nextStore nextOutput))
        ((EpsilonEvaluatorExit code nextOutput) (EpsilonEvaluatorBlockExit code nextOutput))
        ((EpsilonEvaluatorTrap kind nextOutput) (EpsilonEvaluatorBlockTrap kind nextOutput))
        ((EpsilonEvaluatorInternal offset) (EpsilonEvaluatorBlockInternal offset))))
    ((EpsilonLetStatement start end name typeValue initializer)
      (match (epsilon_evaluate_expression context initializer bindings store output)
        ((EpsilonEvaluatorValue value place nextStore nextOutput)
          (match (epsilon_runtime_allocate value nextStore)
            ((EpsilonRuntimeAllocated identifier finalStore)
              (EpsilonEvaluatorBlockFalloff
                (MoreEpsilonEvaluatorBindings
                  (EpsilonEvaluatorLetBinding statementValue identifier) bindings)
                finalStore nextOutput))))
        ((EpsilonEvaluatorResultless nextStore nextOutput)
          (EpsilonEvaluatorBlockInternal (epsilon_expression_start initializer)))
        ((EpsilonEvaluatorExit code nextOutput) (EpsilonEvaluatorBlockExit code nextOutput))
        ((EpsilonEvaluatorTrap kind nextOutput) (EpsilonEvaluatorBlockTrap kind nextOutput))
        ((EpsilonEvaluatorInternal offset) (EpsilonEvaluatorBlockInternal offset))))
    ((EpsilonAssignmentStatement start end placeValue assignedValue)
      (epsilon_evaluate_assignment context placeValue assignedValue bindings store output))
    ((EpsilonAssertStatement start end expressionValue)
      (match (epsilon_evaluate_expression context expressionValue bindings store output)
        ((EpsilonEvaluatorValue value place nextStore nextOutput)
          (match value
            ((EpsilonRuntimeInteger scalar)
              (if (eq scalar 0)
                (EpsilonEvaluatorBlockTrap 8 nextOutput)
                (if (eq scalar 1)
                  (EpsilonEvaluatorBlockFalloff bindings nextStore nextOutput)
                  (EpsilonEvaluatorBlockTrap 7 nextOutput))))
            ((EpsilonRuntimeAggregate typeValue children)
              (EpsilonEvaluatorBlockInternal start))
            ((EpsilonRuntimeSumValue owner caseValue payloads)
              (EpsilonEvaluatorBlockInternal start))
            ((EpsilonRuntimeViewValue view)
              (EpsilonEvaluatorBlockInternal start))))
        ((EpsilonEvaluatorResultless nextStore nextOutput)
          (EpsilonEvaluatorBlockInternal (epsilon_expression_start expressionValue)))
        ((EpsilonEvaluatorExit code nextOutput) (EpsilonEvaluatorBlockExit code nextOutput))
        ((EpsilonEvaluatorTrap kind nextOutput) (EpsilonEvaluatorBlockTrap kind nextOutput))
        ((EpsilonEvaluatorInternal offset) (EpsilonEvaluatorBlockInternal offset))))))

; Selecting the place evaluates the entire LHS exactly once. Its effects and
; bounds checks precede the RHS; the write uses the store after both operands.
(def epsilon_evaluate_assignment ((context EpsilonEvaluatorInvocation)
  (placeValue EpsilonExpression) (assignedValue EpsilonExpression)
  (bindings EpsilonEvaluatorBindings) (store EpsilonRuntimeStore) (output Bytes))
  EpsilonEvaluatorBlockOutcome
  (match (epsilon_evaluate_expression context placeValue bindings store output)
    ((EpsilonEvaluatorValue oldValue place nextStore nextOutput)
      (match place
        (NoEpsilonRuntimePlace
          (EpsilonEvaluatorBlockInternal (epsilon_expression_start placeValue)))
        ((SomeEpsilonRuntimePlace target)
          (epsilon_evaluate_assignment_value context target assignedValue bindings
            nextStore nextOutput (epsilon_expression_start placeValue)))))
    ((EpsilonEvaluatorResultless nextStore nextOutput)
      (EpsilonEvaluatorBlockInternal (epsilon_expression_start placeValue)))
    ((EpsilonEvaluatorExit code nextOutput) (EpsilonEvaluatorBlockExit code nextOutput))
    ((EpsilonEvaluatorTrap kind nextOutput) (EpsilonEvaluatorBlockTrap kind nextOutput))
    ((EpsilonEvaluatorInternal offset) (EpsilonEvaluatorBlockInternal offset))))

(def epsilon_evaluate_assignment_value ((context EpsilonEvaluatorInvocation)
  (target EpsilonRuntimePlace) (assignedValue EpsilonExpression)
  (bindings EpsilonEvaluatorBindings) (store EpsilonRuntimeStore) (output Bytes)
  (placeOffset Int)) EpsilonEvaluatorBlockOutcome
  (match (epsilon_evaluate_expression context assignedValue bindings store output)
    ((EpsilonEvaluatorValue value place nextStore nextOutput)
      (match (epsilon_runtime_write target value nextStore)
        ((EpsilonRuntimeStoreUpdated finalStore)
          (EpsilonEvaluatorBlockFalloff bindings finalStore nextOutput))
        ((EpsilonRuntimeStoreTrapped kind)
          (EpsilonEvaluatorBlockTrap kind nextOutput))
        (EpsilonRuntimeStoreInternal (EpsilonEvaluatorBlockInternal placeOffset))))
    ((EpsilonEvaluatorResultless nextStore nextOutput)
      (EpsilonEvaluatorBlockInternal (epsilon_expression_start assignedValue)))
    ((EpsilonEvaluatorExit code nextOutput) (EpsilonEvaluatorBlockExit code nextOutput))
    ((EpsilonEvaluatorTrap kind nextOutput) (EpsilonEvaluatorBlockTrap kind nextOutput))
    ((EpsilonEvaluatorInternal offset) (EpsilonEvaluatorBlockInternal offset))))
