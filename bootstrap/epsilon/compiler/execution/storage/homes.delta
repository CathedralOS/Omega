
; Root identifiers distinguish recursive invocations and same-type instances.
; Roots remain newest-first; writes preserve order and release never reuses IDs.
(def epsilon_runtime_next_identifier ((store EpsilonRuntimeStore)) Int
  (match store
    ((EpsilonRuntimeStoreState nextIdentifier roots input) nextIdentifier)))

(def epsilon_runtime_allocate ((value EpsilonRuntimeValue)
  (store EpsilonRuntimeStore)) EpsilonRuntimeAllocation
  (match store
    ((EpsilonRuntimeStoreState nextIdentifier roots input)
      (EpsilonRuntimeAllocated nextIdentifier
        (EpsilonRuntimeStoreState (+ nextIdentifier 1)
          (MoreEpsilonRuntimeRoots nextIdentifier value roots) input)))))

(def epsilon_runtime_release_roots ((floor Int) (roots EpsilonRuntimeRoots))
  EpsilonRuntimeRoots
  (match roots
    (NoEpsilonRuntimeRoots NoEpsilonRuntimeRoots)
    ((MoreEpsilonRuntimeRoots identifier value rest)
      (if (lt identifier floor)
        roots
        (epsilon_runtime_release_roots floor rest)))))

(def epsilon_runtime_release_since ((floor Int) (store EpsilonRuntimeStore))
  EpsilonRuntimeStore
  (match store
    ((EpsilonRuntimeStoreState nextIdentifier roots input)
      (EpsilonRuntimeStoreState nextIdentifier
        (epsilon_runtime_release_roots floor roots) input))))

(def epsilon_runtime_find_root ((identifier Int) (roots EpsilonRuntimeRoots))
  EpsilonRuntimeValueLookup
  (match roots
    (NoEpsilonRuntimeRoots NoEpsilonRuntimeValue)
    ((MoreEpsilonRuntimeRoots current value rest)
      (if (eq identifier current)
        (SomeEpsilonRuntimeValue value)
        (epsilon_runtime_find_root identifier rest)))))

(def epsilon_runtime_reverse_roots ((input EpsilonRuntimeRoots)
  (output EpsilonRuntimeRoots)) EpsilonRuntimeRoots
  (match input
    (NoEpsilonRuntimeRoots output)
    ((MoreEpsilonRuntimeRoots identifier value rest)
      (epsilon_runtime_reverse_roots rest
        (MoreEpsilonRuntimeRoots identifier value output)))))

; The public write first proves this root exists. Rebuild only its prefix.
(def epsilon_runtime_replace_root ((identifier Int) (value EpsilonRuntimeValue)
  (roots EpsilonRuntimeRoots) (prefix EpsilonRuntimeRoots)) EpsilonRuntimeRoots
  (match roots
    (NoEpsilonRuntimeRoots
      (epsilon_runtime_reverse_roots prefix NoEpsilonRuntimeRoots))
    ((MoreEpsilonRuntimeRoots current previous rest)
      (if (eq identifier current)
        (epsilon_runtime_reverse_roots prefix
          (MoreEpsilonRuntimeRoots current value rest))
        (epsilon_runtime_replace_root identifier value rest
          (MoreEpsilonRuntimeRoots current previous prefix))))))

(def epsilon_runtime_read ((place EpsilonRuntimePlace)
  (store EpsilonRuntimeStore)) EpsilonRuntimeValueLookup
  (match place
    ((EpsilonRuntimePlaceAt identifier path leafType)
      (match store
        ((EpsilonRuntimeStoreState nextIdentifier roots input)
          (match (epsilon_runtime_find_root identifier roots)
            (NoEpsilonRuntimeValue NoEpsilonRuntimeValue)
            ((SomeEpsilonRuntimeValue value)
              (epsilon_runtime_read_path value path))))))))

(def epsilon_runtime_write_root ((identifier Int) (path EpsilonRuntimePath)
  (value EpsilonRuntimeValue) (store EpsilonRuntimeStore))
  EpsilonRuntimeStoreOutcome
  (match store
    ((EpsilonRuntimeStoreState nextIdentifier roots input)
      (match (epsilon_runtime_find_root identifier roots)
        (NoEpsilonRuntimeValue EpsilonRuntimeStoreInternal)
        ((SomeEpsilonRuntimeValue previous)
          (match (epsilon_runtime_replace_path previous path value
            NoEpsilonRuntimeParents)
            (NoEpsilonRuntimeValue EpsilonRuntimeStoreInternal)
            ((SomeEpsilonRuntimeValue updated)
              (EpsilonRuntimeStoreUpdated
                (EpsilonRuntimeStoreState nextIdentifier
                  (epsilon_runtime_replace_root identifier updated roots
                    NoEpsilonRuntimeRoots) input)))))))))

(def epsilon_runtime_write ((place EpsilonRuntimePlace)
  (value EpsilonRuntimeValue) (store EpsilonRuntimeStore))
  EpsilonRuntimeStoreOutcome
  (match (epsilon_runtime_read place store)
    (NoEpsilonRuntimeValue EpsilonRuntimeStoreInternal)
    ((SomeEpsilonRuntimeValue previous)
      (match place
        ((EpsilonRuntimePlaceAt identifier path leafType)
          (let status Int (epsilon_runtime_store_status leafType value)
            (if (eq status 0)
              (epsilon_runtime_write_root identifier path value store)
              (if (eq status 5)
                (EpsilonRuntimeStoreTrapped 5)
                EpsilonRuntimeStoreInternal))))))))
