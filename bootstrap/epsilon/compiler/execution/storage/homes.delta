
(def epsilon_evaluator_field_identity_equal ((leftOwner EpsilonDeclaration)
  (leftMember EpsilonDataMember) (rightOwner EpsilonDeclaration)
  (rightMember EpsilonDataMember)) Int
  (if (epsilon_data_declarations_same_identity leftOwner rightOwner)
    (if (eq (epsilon_data_member_start leftMember)
            (epsilon_data_member_start rightMember))
      (eq (epsilon_data_member_end leftMember)
        (epsilon_data_member_end rightMember))
      0)
    0))

(def epsilon_evaluate_field_home ((owner EpsilonDeclaration)
  (memberValue EpsilonDataMember) (fields EpsilonEvaluatorFieldValueList)) Int
  (match fields
    (NoEpsilonEvaluatorFieldValues 0)
    ((MoreEpsilonEvaluatorFieldValues item rest)
      (match item
        ((EpsilonEvaluatorScalarFieldValue storedOwner storedMember value)
          (if (epsilon_evaluator_field_identity_equal owner memberValue
            storedOwner storedMember)
            value
            (epsilon_evaluate_field_home owner memberValue rest)))
        ((EpsilonEvaluatorArrayElementValue storedOwner storedMember index value)
          (epsilon_evaluate_field_home owner memberValue rest))))))

(def epsilon_evaluator_set_field_home ((owner EpsilonDeclaration)
  (memberValue EpsilonDataMember) (value Int)
  (fields EpsilonEvaluatorFieldValueList)) EpsilonEvaluatorFieldValueList
  (match fields
    (NoEpsilonEvaluatorFieldValues
      (MoreEpsilonEvaluatorFieldValues
        (EpsilonEvaluatorScalarFieldValue owner memberValue value)
        NoEpsilonEvaluatorFieldValues))
    ((MoreEpsilonEvaluatorFieldValues item rest)
      (match item
        ((EpsilonEvaluatorScalarFieldValue storedOwner storedMember storedValue)
          (if (epsilon_evaluator_field_identity_equal owner memberValue
            storedOwner storedMember)
            (MoreEpsilonEvaluatorFieldValues
              (EpsilonEvaluatorScalarFieldValue owner memberValue value) rest)
            (MoreEpsilonEvaluatorFieldValues item
              (epsilon_evaluator_set_field_home owner memberValue value
                rest))))
        ((EpsilonEvaluatorArrayElementValue storedOwner storedMember index
          storedValue)
          (MoreEpsilonEvaluatorFieldValues item
            (epsilon_evaluator_set_field_home owner memberValue value rest)))))))

(def epsilon_evaluate_array_home ((owner EpsilonDeclaration)
  (memberValue EpsilonDataMember) (index Int)
  (fields EpsilonEvaluatorFieldValueList)) Int
  (match fields
    (NoEpsilonEvaluatorFieldValues 0)
    ((MoreEpsilonEvaluatorFieldValues item rest)
      (match item
        ((EpsilonEvaluatorScalarFieldValue storedOwner storedMember value)
          (epsilon_evaluate_array_home owner memberValue index rest))
        ((EpsilonEvaluatorArrayElementValue storedOwner storedMember storedIndex
          value)
          (if (epsilon_evaluator_field_identity_equal owner memberValue
            storedOwner storedMember)
            (if (eq index storedIndex)
              value
              (epsilon_evaluate_array_home owner memberValue index rest))
            (epsilon_evaluate_array_home owner memberValue index rest)))))))

(def epsilon_evaluator_set_array_home ((owner EpsilonDeclaration)
  (memberValue EpsilonDataMember) (index Int) (value Int)
  (fields EpsilonEvaluatorFieldValueList)) EpsilonEvaluatorFieldValueList
  (match fields
    (NoEpsilonEvaluatorFieldValues
      (MoreEpsilonEvaluatorFieldValues
        (EpsilonEvaluatorArrayElementValue owner memberValue index value)
        NoEpsilonEvaluatorFieldValues))
    ((MoreEpsilonEvaluatorFieldValues item rest)
      (match item
        ((EpsilonEvaluatorScalarFieldValue storedOwner storedMember storedValue)
          (MoreEpsilonEvaluatorFieldValues item
            (epsilon_evaluator_set_array_home owner memberValue index value
              rest)))
        ((EpsilonEvaluatorArrayElementValue storedOwner storedMember storedIndex
          storedValue)
          (if (epsilon_evaluator_field_identity_equal owner memberValue
            storedOwner storedMember)
            (if (eq index storedIndex)
              (MoreEpsilonEvaluatorFieldValues
                (EpsilonEvaluatorArrayElementValue owner memberValue index value)
                rest)
              (MoreEpsilonEvaluatorFieldValues item
                (epsilon_evaluator_set_array_home owner memberValue index value
                  rest)))
            (MoreEpsilonEvaluatorFieldValues item
              (epsilon_evaluator_set_array_home owner memberValue index value
                rest))))))))
