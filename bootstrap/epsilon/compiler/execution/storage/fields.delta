
(def epsilon_evaluator_field_identity_equal ((leftOwner EpsilonDeclaration)
  (leftMember EpsilonDataMember) (rightOwner EpsilonDeclaration)
  (rightMember EpsilonDataMember)) Int
  (if (epsilon_data_declarations_same_identity leftOwner rightOwner)
    (if (eq (epsilon_data_member_start leftMember)
            (epsilon_data_member_start rightMember))
      (eq (epsilon_data_member_end leftMember)
        (epsilon_data_member_end rightMember))
      0)
    0))

(def epsilon_runtime_projections_equal ((left EpsilonRuntimeProjection)
  (right EpsilonRuntimeProjection)) Int
  (match left
    ((EpsilonRuntimeField owner memberValue)
      (match right
        ((EpsilonRuntimeField otherOwner otherMember)
          (epsilon_evaluator_field_identity_equal owner memberValue
            otherOwner otherMember))
        ((EpsilonRuntimeIndex index) 0)))
    ((EpsilonRuntimeIndex index)
      (match right
        ((EpsilonRuntimeField owner memberValue) 0)
        ((EpsilonRuntimeIndex otherIndex) (eq index otherIndex))))))

; The checked field ledger supplies owner/member custody. No source spelling
; lookup occurs here, and sum cases are not record-field projections.
(def epsilon_runtime_field_default ((memberValue EpsilonDataMember))
  EpsilonRuntimeValueLookup
  (match memberValue
    ((EpsilonFieldMember start end name typeValue)
      (SomeEpsilonRuntimeValue (epsilon_runtime_zero_value typeValue)))
    ((EpsilonCaseMember start end name payload) NoEpsilonRuntimeValue)))

(def epsilon_runtime_projection_default ((typeValue EpsilonType)
  (projection EpsilonRuntimeProjection)) EpsilonRuntimeValueLookup
  (match projection
    ((EpsilonRuntimeField owner memberValue)
      (match typeValue
        ((EpsilonNamedType start end name)
          (epsilon_runtime_field_default memberValue))
        ((EpsilonI32Type start end) NoEpsilonRuntimeValue)
        ((EpsilonU8Type start end) NoEpsilonRuntimeValue)
        ((EpsilonNeverType start end) NoEpsilonRuntimeValue)
        ((EpsilonArrayType start end element lengthValue) NoEpsilonRuntimeValue)
        ((EpsilonViewType start end element) NoEpsilonRuntimeValue)))
    ((EpsilonRuntimeIndex index)
      (epsilon_runtime_index_default typeValue index))))

(def epsilon_runtime_find_child ((projection EpsilonRuntimeProjection)
  (children EpsilonRuntimeChildren)) EpsilonRuntimeValueLookup
  (match children
    (NoEpsilonRuntimeChildren NoEpsilonRuntimeValue)
    ((MoreEpsilonRuntimeChildren current value rest)
      (if (epsilon_runtime_projections_equal projection current)
        (SomeEpsilonRuntimeValue value)
        (epsilon_runtime_find_child projection rest)))))

(def epsilon_runtime_project ((value EpsilonRuntimeValue)
  (projection EpsilonRuntimeProjection)) EpsilonRuntimeValueLookup
  (match value
    ((EpsilonRuntimeInteger integer) NoEpsilonRuntimeValue)
    ((EpsilonRuntimeAggregate typeValue children)
      (match (epsilon_runtime_projection_default typeValue projection)
        (NoEpsilonRuntimeValue NoEpsilonRuntimeValue)
        ((SomeEpsilonRuntimeValue defaultValue)
          (match (epsilon_runtime_find_child projection children)
            (NoEpsilonRuntimeValue (SomeEpsilonRuntimeValue defaultValue))
            ((SomeEpsilonRuntimeValue storedValue)
              (SomeEpsilonRuntimeValue storedValue))))))))

(def epsilon_runtime_reverse_children ((input EpsilonRuntimeChildren)
  (output EpsilonRuntimeChildren)) EpsilonRuntimeChildren
  (match input
    (NoEpsilonRuntimeChildren output)
    ((MoreEpsilonRuntimeChildren projection value rest)
      (epsilon_runtime_reverse_children rest
        (MoreEpsilonRuntimeChildren projection value output)))))

(def epsilon_runtime_replace_child ((projection EpsilonRuntimeProjection)
  (value EpsilonRuntimeValue) (children EpsilonRuntimeChildren)
  (prefix EpsilonRuntimeChildren)) EpsilonRuntimeChildren
  (match children
    (NoEpsilonRuntimeChildren
      (epsilon_runtime_reverse_children prefix
        (MoreEpsilonRuntimeChildren projection value NoEpsilonRuntimeChildren)))
    ((MoreEpsilonRuntimeChildren current previous rest)
      (if (epsilon_runtime_projections_equal projection current)
        (epsilon_runtime_reverse_children prefix
          (MoreEpsilonRuntimeChildren current value rest))
        (epsilon_runtime_replace_child projection value rest
          (MoreEpsilonRuntimeChildren current previous prefix))))))

(def epsilon_runtime_with_child ((parent EpsilonRuntimeValue)
  (projection EpsilonRuntimeProjection) (value EpsilonRuntimeValue))
  EpsilonRuntimeValueLookup
  (match parent
    ((EpsilonRuntimeInteger integer) NoEpsilonRuntimeValue)
    ((EpsilonRuntimeAggregate typeValue children)
      (match (epsilon_runtime_projection_default typeValue projection)
        (NoEpsilonRuntimeValue NoEpsilonRuntimeValue)
        ((SomeEpsilonRuntimeValue defaultValue)
          (SomeEpsilonRuntimeValue
            (EpsilonRuntimeAggregate typeValue
              (epsilon_runtime_replace_child projection value children
                NoEpsilonRuntimeChildren))))))))
