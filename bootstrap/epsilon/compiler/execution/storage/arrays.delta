
; Bounds are checked before access in expression evaluation. Pure projection
; also refuses an impossible index without manufacturing a default child.
(def epsilon_runtime_index_default ((typeValue EpsilonType) (index Int))
  EpsilonRuntimeValueLookup
  (match typeValue
    ((EpsilonArrayType start end element lengthValue)
      (if (lt index 0)
        NoEpsilonRuntimeValue
        (if (lt index (epsilon_integer_literal_value lengthValue))
          (SomeEpsilonRuntimeValue (epsilon_runtime_zero_value element))
          NoEpsilonRuntimeValue)))
    ((EpsilonI32Type start end) NoEpsilonRuntimeValue)
    ((EpsilonU8Type start end) NoEpsilonRuntimeValue)
    ((EpsilonNeverType start end) NoEpsilonRuntimeValue)
    ((EpsilonNamedType start end name) NoEpsilonRuntimeValue)
    ((EpsilonViewType start end element) NoEpsilonRuntimeValue)))
