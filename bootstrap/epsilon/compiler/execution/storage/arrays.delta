
(def epsilon_evaluate_array_store ((context EpsilonEvaluatorInvocation)
  (owner EpsilonDeclaration) (memberValue EpsilonDataMember)
  (element EpsilonType) (index Int) (assignedValue EpsilonExpression)
  (locals EpsilonEvaluatorLocalValueList)
  (fields EpsilonEvaluatorFieldValueList) (output Bytes)) EpsilonEvaluatorOutcome
  (let outcome EpsilonEvaluatorOutcome
    (epsilon_evaluate_expression context assignedValue locals fields output)
    (match outcome
      ((EpsilonEvaluatorValue value nextFields nextOutput)
        (match (epsilon_evaluator_check_scalar_store element value)
          (EpsilonEvaluatorScalarUnsupported EpsilonEvaluatorUnsupported)
          ((EpsilonEvaluatorScalarTrapped kind)
            (EpsilonEvaluatorTrap kind nextOutput))
          ((EpsilonEvaluatorScalarValue storedValue)
            (EpsilonEvaluatorResultless
              (epsilon_evaluator_set_array_home owner memberValue index
                storedValue nextFields) nextOutput))))
      ((EpsilonEvaluatorResultless nextFields nextOutput)
        (EpsilonEvaluatorInternal (epsilon_expression_start assignedValue)))
      ((EpsilonEvaluatorExit code nextOutput) outcome)
      ((EpsilonEvaluatorTrap kind nextOutput) outcome)
      ((EpsilonEvaluatorInternal offset) outcome)
      (EpsilonEvaluatorUnsupported outcome))))

(def epsilon_evaluate_array_index ((context EpsilonEvaluatorInvocation)
  (owner EpsilonDeclaration) (memberValue EpsilonDataMember)
  (element EpsilonType) (lengthValue EpsilonIntegerLiteral)
  (indexValue EpsilonExpression) (assignedValue EpsilonOptionalExpression)
  (locals EpsilonEvaluatorLocalValueList)
  (fields EpsilonEvaluatorFieldValueList) (output Bytes)) EpsilonEvaluatorOutcome
  (let outcome EpsilonEvaluatorOutcome
    (epsilon_evaluate_expression context indexValue locals fields output)
    (match outcome
      ((EpsilonEvaluatorValue index nextFields nextOutput)
        (if (if (lt index 0) 1
              (if (lt index (epsilon_integer_literal_value lengthValue)) 0 1))
          (EpsilonEvaluatorTrap 6 nextOutput)
          (match assignedValue
            (NoEpsilonExpression
              (EpsilonEvaluatorValue
                (epsilon_evaluate_array_home owner memberValue index nextFields)
                nextFields nextOutput))
            ((SomeEpsilonExpression assigned)
              (epsilon_evaluate_array_store context owner memberValue element
                index assigned locals nextFields nextOutput)))))
      ((EpsilonEvaluatorResultless nextFields nextOutput)
        (EpsilonEvaluatorInternal (epsilon_expression_start indexValue)))
      ((EpsilonEvaluatorExit code nextOutput) outcome)
      ((EpsilonEvaluatorTrap kind nextOutput) outcome)
      ((EpsilonEvaluatorInternal offset) outcome)
      (EpsilonEvaluatorUnsupported outcome))))

; Resolve the fixed receiver home before running the index. A successful index
; carries its effects into the read or RHS; bounds failure never runs the RHS.
(def epsilon_evaluate_array_access ((context EpsilonEvaluatorInvocation)
  (base EpsilonExpression) (indexValue EpsilonExpression)
  (assignedValue EpsilonOptionalExpression)
  (locals EpsilonEvaluatorLocalValueList)
  (fields EpsilonEvaluatorFieldValueList) (output Bytes)) EpsilonEvaluatorOutcome
  (match context
    ((EpsilonEvaluatorInvocationContext source machineValue references
      fieldReferences callables control)
      (match base
        ((EpsilonFieldExpression start end receiver member)
          (if (epsilon_evaluator_expression_is_receiver receiver references)
            (match (epsilon_find_resolved_field_reference base fieldReferences)
              (NoEpsilonResolvedFieldReference (EpsilonEvaluatorInternal start))
              ((OneEpsilonResolvedFieldReference owner memberValue)
                (match memberValue
                  ((EpsilonFieldMember fieldStart fieldEnd fieldName typeValue)
                    (match typeValue
                      ((EpsilonArrayType typeStart typeEnd element lengthValue)
                        (if (epsilon_evaluator_scalar_storage_kind element)
                          (epsilon_evaluate_array_index context owner memberValue
                            element lengthValue indexValue assignedValue locals
                            fields output)
                          EpsilonEvaluatorUnsupported))
                      ((EpsilonI32Type typeStart typeEnd) EpsilonEvaluatorUnsupported)
                      ((EpsilonU8Type typeStart typeEnd) EpsilonEvaluatorUnsupported)
                      ((EpsilonNeverType typeStart typeEnd) EpsilonEvaluatorUnsupported)
                      ((EpsilonNamedType typeStart typeEnd name) EpsilonEvaluatorUnsupported)
                      ((EpsilonViewType typeStart typeEnd element) EpsilonEvaluatorUnsupported)))
                  ((EpsilonCaseMember caseStart caseEnd caseName payload)
                    EpsilonEvaluatorUnsupported))))
            EpsilonEvaluatorUnsupported))
        ((EpsilonGroupedExpression start end inner)
          (epsilon_evaluate_array_access context inner indexValue assignedValue
            locals fields output))
        ((EpsilonIntegerExpression start end literal) EpsilonEvaluatorUnsupported)
        ((EpsilonCharacterExpression start end literal) EpsilonEvaluatorUnsupported)
        ((EpsilonStringExpression start end literal) EpsilonEvaluatorUnsupported)
        ((EpsilonTrueExpression start end) EpsilonEvaluatorUnsupported)
        ((EpsilonFalseExpression start end) EpsilonEvaluatorUnsupported)
        ((EpsilonNameExpression start end name) EpsilonEvaluatorUnsupported)
        ((EpsilonQualifiedExpression start end owner name arguments)
          EpsilonEvaluatorUnsupported)
        ((EpsilonCallExpression start end callBase arguments)
          EpsilonEvaluatorUnsupported)
        ((EpsilonIndexExpression start end indexBase nestedIndex)
          EpsilonEvaluatorUnsupported)
        ((EpsilonSliceExpression start end sliceBase low high)
          EpsilonEvaluatorUnsupported)
        ((EpsilonNegateExpression start end operand) EpsilonEvaluatorUnsupported)
        ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
          left right) EpsilonEvaluatorUnsupported)))))

(def epsilon_evaluate_array_element ((context EpsilonEvaluatorInvocation)
  (base EpsilonExpression) (indexValue EpsilonExpression)
  (locals EpsilonEvaluatorLocalValueList)
  (fields EpsilonEvaluatorFieldValueList) (output Bytes)) EpsilonEvaluatorOutcome
  (epsilon_evaluate_array_access context base indexValue NoEpsilonExpression
    locals fields output))

(def epsilon_evaluate_array_assignment ((context EpsilonEvaluatorInvocation)
  (base EpsilonExpression) (indexValue EpsilonExpression)
  (assignedValue EpsilonExpression) (locals EpsilonEvaluatorLocalValueList)
  (fields EpsilonEvaluatorFieldValueList) (output Bytes)) EpsilonEvaluatorOutcome
  (epsilon_evaluate_array_access context base indexValue
    (SomeEpsilonExpression assignedValue) locals fields output))
