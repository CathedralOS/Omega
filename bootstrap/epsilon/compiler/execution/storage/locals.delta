
(def epsilon_evaluator_statements_same_identity ((left EpsilonStatement)
  (right EpsilonStatement)) Int
  (if (eq (epsilon_statement_start left) (epsilon_statement_start right))
    (eq (epsilon_statement_end left) (epsilon_statement_end right))
    0))

(def epsilon_evaluator_parameters_same_identity ((left EpsilonParameter)
  (right EpsilonParameter)) Int
  (if (eq (epsilon_parameter_start left) (epsilon_parameter_start right))
    (eq (epsilon_parameter_end left) (epsilon_parameter_end right))
    0))

(def epsilon_evaluator_find_let_binding ((target EpsilonStatement)
  (bindings EpsilonEvaluatorBindings)) EpsilonEvaluatorBindingLookup
  (match bindings
    (NoEpsilonEvaluatorBindings NoEpsilonEvaluatorBinding)
    ((MoreEpsilonEvaluatorBindings item rest)
      (match item
        ((EpsilonEvaluatorLetBinding statementValue identifier)
          (if (epsilon_evaluator_statements_same_identity target statementValue)
            (SomeEpsilonEvaluatorBinding identifier)
            (epsilon_evaluator_find_let_binding target rest)))
        ((EpsilonEvaluatorParameterBinding parameterValue identifier)
          (epsilon_evaluator_find_let_binding target rest))))))

(def epsilon_evaluator_find_parameter_binding ((target EpsilonParameter)
  (bindings EpsilonEvaluatorBindings)) EpsilonEvaluatorBindingLookup
  (match bindings
    (NoEpsilonEvaluatorBindings NoEpsilonEvaluatorBinding)
    ((MoreEpsilonEvaluatorBindings item rest)
      (match item
        ((EpsilonEvaluatorLetBinding statementValue identifier)
          (epsilon_evaluator_find_parameter_binding target rest))
        ((EpsilonEvaluatorParameterBinding parameterValue identifier)
          (if (epsilon_evaluator_parameters_same_identity target parameterValue)
            (SomeEpsilonEvaluatorBinding identifier)
            (epsilon_evaluator_find_parameter_binding target rest)))))))

; A view binding owns a private descriptor home, but D37 exposes no authored
; place for that immutable value. Its backing place remains inside the view.
(def epsilon_evaluator_read_place ((place EpsilonRuntimePlace)
  (store EpsilonRuntimeStore) (output Bytes) (offset Int)) EpsilonEvaluatorOutcome
  (match (epsilon_runtime_read place store)
    (NoEpsilonRuntimeValue (EpsilonEvaluatorInternal offset))
    ((SomeEpsilonRuntimeValue value)
      (match value
        ((EpsilonRuntimeViewValue view)
          (EpsilonEvaluatorValue value NoEpsilonRuntimePlace store output))
        ((EpsilonRuntimeInteger integer)
          (EpsilonEvaluatorValue value (SomeEpsilonRuntimePlace place) store output))
        ((EpsilonRuntimeAggregate typeValue children)
          (EpsilonEvaluatorValue value (SomeEpsilonRuntimePlace place) store output))))))

(def epsilon_evaluator_read_binding ((binding EpsilonEvaluatorBindingLookup)
  (typeValue EpsilonType) (store EpsilonRuntimeStore) (output Bytes)
  (offset Int)) EpsilonEvaluatorOutcome
  (match binding
    (NoEpsilonEvaluatorBinding (EpsilonEvaluatorInternal offset))
    ((SomeEpsilonEvaluatorBinding identifier)
      (epsilon_evaluator_read_place
        (EpsilonRuntimePlaceAt identifier NoEpsilonRuntimePath typeValue)
        store output offset))))

(def epsilon_evaluate_resolved_local ((context EpsilonEvaluatorInvocation)
  (expressionValue EpsilonExpression) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (match context
    ((EpsilonEvaluatorInvocationContext source machineValue references
      fieldReferences callables control receiver blockRootFloor)
      (match (epsilon_find_resolved_local_reference expressionValue references)
        (NoEpsilonResolvedLocalReference
          (EpsilonEvaluatorInternal (epsilon_expression_start expressionValue)))
        ((OneEpsilonResolvedLocalReference bindingValue)
          (match bindingValue
            ((EpsilonLetLocal name typeValue statementValue)
              (epsilon_evaluator_read_binding
                (epsilon_evaluator_find_let_binding statementValue bindings)
                typeValue store output (epsilon_expression_start expressionValue)))
            ((EpsilonReceiverLocal name typeValue)
              (match receiver
                (NoEpsilonRuntimePlace
                  (EpsilonEvaluatorInternal (epsilon_expression_start expressionValue)))
                ((SomeEpsilonRuntimePlace place)
                  (epsilon_evaluator_read_place place store output
                    (epsilon_expression_start expressionValue)))))
            ((EpsilonMachineParameterLocal parameterValue)
              (match parameterValue
                ((EpsilonParameterSyntax start end name typeValue)
                  (epsilon_evaluator_read_binding
                    (epsilon_evaluator_find_parameter_binding parameterValue bindings)
                    typeValue store output (epsilon_expression_start expressionValue)))))
            ((EpsilonStateParameterLocal parameterValue)
              (match parameterValue
                ((EpsilonParameterSyntax start end name typeValue)
                  (epsilon_evaluator_read_binding
                    (epsilon_evaluator_find_parameter_binding parameterValue bindings)
                    typeValue store output (epsilon_expression_start expressionValue)))))
            ((EpsilonTransitionBinderLocal patternValue name)
              EpsilonEvaluatorUnsupported)))))))

(def epsilon_evaluator_is_machine_parameter ((target EpsilonParameter)
  (parameters EpsilonParameterList)) Int
  (match parameters
    (NoEpsilonParameters 0)
    ((MoreEpsilonParameters item rest)
      (if (epsilon_evaluator_parameters_same_identity target item)
        1
        (epsilon_evaluator_is_machine_parameter target rest)))))

; Keep the invocation's exact parameter roots, not copies of their old values.
; State-local roots are released separately after all argument snapshots exist.
(def epsilon_evaluator_preserve_machine_parameters
  ((parameters EpsilonParameterList) (bindings EpsilonEvaluatorBindings))
  EpsilonEvaluatorBindings
  (match bindings
    (NoEpsilonEvaluatorBindings NoEpsilonEvaluatorBindings)
    ((MoreEpsilonEvaluatorBindings item rest)
      (match item
        ((EpsilonEvaluatorLetBinding statementValue identifier)
          (epsilon_evaluator_preserve_machine_parameters parameters rest))
        ((EpsilonEvaluatorParameterBinding parameterValue identifier)
          (if (epsilon_evaluator_is_machine_parameter parameterValue parameters)
            (MoreEpsilonEvaluatorBindings item
              (epsilon_evaluator_preserve_machine_parameters parameters rest))
            (epsilon_evaluator_preserve_machine_parameters parameters rest)))))))
