
; Expressions retain a place only while it remains a projection of live storage.
; Calls and scalar operations return snapshots without assignable identity.
(def epsilon_evaluate_expression ((context EpsilonEvaluatorInvocation)
  (expressionValue EpsilonExpression) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (match expressionValue
    ((EpsilonNegateExpression start end operand)
      (epsilon_evaluate_negation context operand bindings store output))
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd left right)
      (epsilon_evaluate_binary context operator left right bindings store output))
    ((EpsilonGroupedExpression start end inner)
      (epsilon_evaluate_expression context inner bindings store output))
    ((EpsilonIntegerExpression start end literal)
      (epsilon_evaluator_integer (epsilon_integer_literal_value literal) store output))
    ((EpsilonCharacterExpression start end literal)
      (match literal
        ((EpsilonCharacterSpan literalStart literalEnd value)
          (epsilon_evaluator_integer value store output))))
    ((EpsilonTrueExpression start end) (epsilon_evaluator_integer 1 store output))
    ((EpsilonFalseExpression start end) (epsilon_evaluator_integer 0 store output))
    ((EpsilonNameExpression start end name)
      (epsilon_evaluate_resolved_local context expressionValue bindings store output))
    ((EpsilonStringExpression start end literal)
      (epsilon_evaluate_string context literal store output))
    ((EpsilonQualifiedExpression start end owner name arguments)
      EpsilonEvaluatorUnsupported)
    ((EpsilonFieldExpression start end base field)
      (epsilon_evaluate_field context expressionValue base field bindings store output))
    ((EpsilonCallExpression start end base arguments)
      (epsilon_evaluate_call context expressionValue base arguments bindings store output))
    ((EpsilonIndexExpression start end base indexValue)
      (epsilon_evaluate_index context base indexValue bindings store output))
    ((EpsilonSliceExpression start end base low high)
      (epsilon_evaluate_slice context base low high bindings store output))))
