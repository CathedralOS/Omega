
; Checked Console identity selects the operation. Argument effects finish before
; the byte/line/exit effect; reads advance the one sealed input cursor.
(def epsilon_evaluate_console_effect ((context EpsilonEvaluatorInvocation)
  (kind Int) (arguments EpsilonExpressionList) (bindings EpsilonEvaluatorBindings)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (if (eq kind 3)
    (match arguments
      (NoEpsilonExpressions (epsilon_evaluator_read_input store output))
      ((MoreEpsilonExpressions item rest)
        (EpsilonEvaluatorInternal (epsilon_expression_start item))))
    (match arguments
      (NoEpsilonExpressions (EpsilonEvaluatorInternal 0))
      ((MoreEpsilonExpressions item rest)
        (match rest
          (NoEpsilonExpressions
            (let outcome EpsilonEvaluatorOutcome
              (epsilon_evaluate_expression context item bindings store output)
              (match outcome
                ((EpsilonEvaluatorValue value place nextStore nextOutput)
                  (epsilon_evaluator_console_value kind value nextStore nextOutput))
                ((EpsilonEvaluatorResultless nextStore nextOutput)
                  (EpsilonEvaluatorInternal (epsilon_expression_start item)))
                ((EpsilonEvaluatorExit code nextOutput) outcome)
                ((EpsilonEvaluatorTrap trapKind nextOutput) outcome)
                ((EpsilonEvaluatorInternal offset) outcome)
                (EpsilonEvaluatorUnsupported outcome))))
          ((MoreEpsilonExpressions nextItem nextRest)
            (EpsilonEvaluatorInternal (epsilon_expression_start nextItem))))))))
