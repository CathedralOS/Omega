
; Staging outcome for the executable evaluator frontier. Unsupported is not an
; Epsilon observation and cannot be published by the final evaluator.
(data EpsilonEvaluatorSliceOutcome
  (EpsilonEvaluatorSliceExit Int Bytes)
  (EpsilonEvaluatorSliceTrap Int Bytes)
  (EpsilonEvaluatorSliceRejected EpsilonRejectReason Int)
  (EpsilonEvaluatorSliceInternal Int)
  (EpsilonEvaluatorSliceUnsupported))

(data EpsilonEvaluatorScalar
  (NoEpsilonEvaluatorScalar)
  (OneEpsilonEvaluatorScalar Int))

(data EpsilonEvaluatorScalarOutcome
  (EpsilonEvaluatorScalarUnsupported)
  (EpsilonEvaluatorScalarValue Int)
  (EpsilonEvaluatorScalarTrapped Int))

(data EpsilonEvaluatorLocalValue
  (EpsilonEvaluatorLetValue EpsilonStatement Int)
  (EpsilonEvaluatorParameterValue EpsilonParameter Int))

(data EpsilonEvaluatorLocalValueList
  (NoEpsilonEvaluatorLocalValues)
  (MoreEpsilonEvaluatorLocalValues EpsilonEvaluatorLocalValue
    EpsilonEvaluatorLocalValueList))

(data EpsilonEvaluatorLocalAssignmentOutcome
  (EpsilonEvaluatorLocalAssignmentUnsupported)
  (EpsilonEvaluatorLocalAssignmentMissing)
  (EpsilonEvaluatorLocalAssignmentUpdated EpsilonEvaluatorLocalValueList))

(data EpsilonEvaluatorFieldValue
  (EpsilonEvaluatorScalarFieldValue EpsilonDeclaration EpsilonDataMember Int)
  (EpsilonEvaluatorArrayElementValue EpsilonDeclaration EpsilonDataMember Int Int))

(data EpsilonEvaluatorFieldValueList
  (NoEpsilonEvaluatorFieldValues)
  (MoreEpsilonEvaluatorFieldValues EpsilonEvaluatorFieldValue
    EpsilonEvaluatorFieldValueList))

(data EpsilonEvaluatorAssignmentOutcome
  (EpsilonEvaluatorAssignmentUnsupported)
  (EpsilonEvaluatorAssignmentTrapped Int)
  (EpsilonEvaluatorAssignmentUpdated EpsilonEvaluatorFieldValueList))

; Expressions and ordinary invocations return their committed effects together.
; Only the outer entry adapter turns a resultless return into process exit.
(data EpsilonEvaluatorOutcome
  (EpsilonEvaluatorValue Int EpsilonEvaluatorFieldValueList Bytes)
  (EpsilonEvaluatorResultless EpsilonEvaluatorFieldValueList Bytes)
  (EpsilonEvaluatorExit Int Bytes)
  (EpsilonEvaluatorTrap Int Bytes)
  (EpsilonEvaluatorInternal Int)
  (EpsilonEvaluatorUnsupported))

; Checked invocation identity stays fixed across its entry and state blocks.
(data EpsilonEvaluatorInvocation
  (EpsilonEvaluatorInvocationContext Bytes EpsilonDeclaration
    EpsilonResolvedLocalReferenceList EpsilonResolvedFieldReferenceList
    EpsilonResolvedCallableReferenceList EpsilonControlReferenceLedger))

(data EpsilonEvaluatorBlockOutcome
  (EpsilonEvaluatorBlockFalloff EpsilonEvaluatorLocalValueList
    EpsilonEvaluatorFieldValueList Bytes)
  (EpsilonEvaluatorBlockReturn Int EpsilonEvaluatorFieldValueList Bytes)
  (EpsilonEvaluatorBlockTransfer EpsilonState EpsilonEvaluatorLocalValueList
    EpsilonEvaluatorFieldValueList Bytes)
  (EpsilonEvaluatorBlockExit Int Bytes)
  (EpsilonEvaluatorBlockTrap Int Bytes)
  (EpsilonEvaluatorBlockInternal Int)
  (EpsilonEvaluatorBlockUnsupported))

(data EpsilonEvaluatorArgumentsOutcome
  (EpsilonEvaluatorArgumentsBound EpsilonEvaluatorLocalValueList
    EpsilonEvaluatorFieldValueList Bytes)
  (EpsilonEvaluatorArgumentsStopped EpsilonEvaluatorOutcome))
