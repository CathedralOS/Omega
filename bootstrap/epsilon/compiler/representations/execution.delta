
; Staging outcomes never turn unsupported execution into an Epsilon observation.
(data EpsilonEvaluatorSliceOutcome
  (EpsilonEvaluatorSliceExit Int Bytes)
  (EpsilonEvaluatorSliceTrap Int Bytes)
  (EpsilonEvaluatorSliceRejected EpsilonRejectReason Int)
  (EpsilonEvaluatorSliceInternal Int)
  (EpsilonEvaluatorSliceUnsupported))

; Pure arithmetic results are separate from effect-threaded expression results.
(data EpsilonEvaluatorScalarOutcome
  (EpsilonEvaluatorScalarUnsupported)
  (EpsilonEvaluatorScalarValue Int)
  (EpsilonEvaluatorScalarTrapped Int))

; Aggregate snapshots share immutable children. Unwritten children are typed
; zero defaults, not eagerly allocated storage for the entire declared array.
(data EpsilonRuntimeValue
  (EpsilonRuntimeInteger Int)
  (EpsilonRuntimeAggregate EpsilonType EpsilonRuntimeChildren)
  (EpsilonRuntimeSumValue EpsilonDeclaration EpsilonResolvedSumCase EpsilonRuntimePayloads)
  (EpsilonRuntimeViewValue EpsilonRuntimeView))

; Case identity belongs to its checked nominal owner. Payload positions follow
; declaration order and contain independent immutable value snapshots.
(data EpsilonRuntimePayloads
  (NoEpsilonRuntimePayloads)
  (MoreEpsilonRuntimePayloads EpsilonRuntimeValue EpsilonRuntimePayloads))

; Views retain their ultimate backing, never another view variable's home.
; Ordinary non-place array values already own immutable snapshots; slicing one
; shares that snapshot. The place-only .as_slice route never uses that case.
(data EpsilonRuntimeViewBacking
  (EpsilonRuntimeLiteralBacking Bytes)
  (EpsilonRuntimePlaceBacking EpsilonRuntimePlace)
  (EpsilonRuntimeSnapshotBacking EpsilonRuntimeValue))

(data EpsilonRuntimeView
  (EpsilonRuntimeViewAt EpsilonRuntimeViewBacking EpsilonType Int Int))

(data EpsilonRuntimeProjection
  (EpsilonRuntimeField EpsilonDeclaration EpsilonDataMember)
  (EpsilonRuntimeIndex Int))

(data EpsilonRuntimeChildren
  (NoEpsilonRuntimeChildren)
  (MoreEpsilonRuntimeChildren EpsilonRuntimeProjection EpsilonRuntimeValue
    EpsilonRuntimeChildren))

(data EpsilonRuntimePath
  (NoEpsilonRuntimePath)
  (MoreEpsilonRuntimePath EpsilonRuntimeProjection EpsilonRuntimePath))

(data EpsilonRuntimePlace
  (EpsilonRuntimePlaceAt Int EpsilonRuntimePath EpsilonType))

(data EpsilonRuntimeOptionalPlace
  (NoEpsilonRuntimePlace)
  (SomeEpsilonRuntimePlace EpsilonRuntimePlace))

(data EpsilonRuntimeValueLookup
  (NoEpsilonRuntimeValue)
  (SomeEpsilonRuntimeValue EpsilonRuntimeValue))

; A declaration identifies a slot's syntax, never its recursive runtime instance.
(data EpsilonRuntimeRoots
  (NoEpsilonRuntimeRoots)
  (MoreEpsilonRuntimeRoots Int EpsilonRuntimeValue EpsilonRuntimeRoots))

; The one sealed Console owns one input position across every invocation.
; Output stays in the observation prefix rather than a mutable program root.
(data EpsilonRuntimeConsoleInput
  (EpsilonRuntimeConsoleInputAt Bytes Int))

(data EpsilonRuntimeStore
  (EpsilonRuntimeStoreState Int EpsilonRuntimeRoots EpsilonRuntimeConsoleInput))

(data EpsilonRuntimeAllocation
  (EpsilonRuntimeAllocated Int EpsilonRuntimeStore))

(data EpsilonRuntimeStoreOutcome
  (EpsilonRuntimeStoreUpdated EpsilonRuntimeStore)
  (EpsilonRuntimeStoreTrapped Int)
  (EpsilonRuntimeStoreInternal))

(data EpsilonEvaluatorBinding
  (EpsilonEvaluatorLetBinding EpsilonStatement Int)
  (EpsilonEvaluatorParameterBinding EpsilonParameter Int)
  (EpsilonEvaluatorPatternBinding EpsilonPattern EpsilonName EpsilonType Int))

(data EpsilonEvaluatorBindings
  (NoEpsilonEvaluatorBindings)
  (MoreEpsilonEvaluatorBindings EpsilonEvaluatorBinding EpsilonEvaluatorBindings))

(data EpsilonEvaluatorBindingLookup
  (NoEpsilonEvaluatorBinding)
  (SomeEpsilonEvaluatorBinding Int))

(data EpsilonEvaluatorBoundParameters
  (EpsilonEvaluatorParametersBound EpsilonEvaluatorBindings EpsilonRuntimeStore))

; Values may carry a place while evaluating projections. Copies and returns
; retain only their immutable value; a receiver call retains the selected place.
(data EpsilonEvaluatorOutcome
  (EpsilonEvaluatorValue EpsilonRuntimeValue EpsilonRuntimeOptionalPlace
    EpsilonRuntimeStore Bytes)
  (EpsilonEvaluatorResultless EpsilonRuntimeStore Bytes)
  (EpsilonEvaluatorExit Int Bytes)
  (EpsilonEvaluatorTrap Int Bytes)
  (EpsilonEvaluatorInternal Int)
  (EpsilonEvaluatorUnsupported))

; Runtime buckets retain original checked rows in their own typed ledgers.
; Indexing narrows lookup, never replaces exact expression identity or order.
(data EpsilonRuntimeReference
  (EpsilonRuntimeLocalReference EpsilonResolvedLocalReference)
  (EpsilonRuntimeFieldReference EpsilonResolvedFieldReference)
  (EpsilonRuntimeCallableReference EpsilonResolvedCallableReference)
  (EpsilonRuntimeStateReference EpsilonStateApplicationReference)
  (EpsilonRuntimeSubjectReference EpsilonTransitionSubjectReference)
  (EpsilonRuntimePatternReference EpsilonTransitionPatternReference))

(data EpsilonRuntimeControlBucket
  (EpsilonRuntimeControlBucketAt EpsilonStateApplicationReferenceList
    EpsilonTransitionSubjectReferenceList EpsilonTransitionPatternReferenceList))

(data EpsilonRuntimeReferenceBucket
  (EpsilonRuntimeReferenceBucketAt EpsilonResolvedLocalReferenceList
    EpsilonResolvedFieldReferenceList EpsilonResolvedCallableReferenceList
    EpsilonRuntimeControlBucket))

(data EpsilonRuntimeReferenceTree
  (EmptyEpsilonRuntimeReferenceTree)
  (BranchEpsilonRuntimeReferenceTree
    Int EpsilonRuntimeReferenceTree EpsilonRuntimeReferenceTree)
  (LeafEpsilonRuntimeReferenceTree EpsilonRuntimeReferenceBucket))

(data EpsilonRuntimeReferences
  (IndexedEpsilonRuntimeReferences Int EpsilonRuntimeReferenceTree)
  (LinearEpsilonRuntimeReferences EpsilonRuntimeReferenceBucket))

(data EpsilonRuntimeReferenceInsertion
  (InsertedEpsilonRuntimeReference EpsilonRuntimeReferenceTree)
  (InvalidEpsilonRuntimeReferenceInsertion))

; The block-root floor is fixed after machine-parameter homes are installed.
(data EpsilonEvaluatorInvocation
  (EpsilonEvaluatorInvocationContext Bytes EpsilonDeclaration
    EpsilonRuntimeReferences EpsilonRuntimeOptionalPlace Int))

(data EpsilonEvaluatorBlockOutcome
  (EpsilonEvaluatorBlockFalloff EpsilonEvaluatorBindings EpsilonRuntimeStore Bytes)
  (EpsilonEvaluatorBlockReturn EpsilonRuntimeValue EpsilonRuntimeStore Bytes)
  (EpsilonEvaluatorBlockTransfer EpsilonState EpsilonEvaluatorBindings
    EpsilonRuntimeStore Bytes)
  (EpsilonEvaluatorBlockExit Int Bytes)
  (EpsilonEvaluatorBlockTrap Int Bytes)
  (EpsilonEvaluatorBlockInternal Int)
  (EpsilonEvaluatorBlockUnsupported))

; Each argument captures a snapshot before the next argument's effects.
(data EpsilonEvaluatorArgumentValues
  (NoEpsilonEvaluatorArgumentValues)
  (MoreEpsilonEvaluatorArgumentValues EpsilonParameter EpsilonRuntimeValue
    EpsilonEvaluatorArgumentValues))

(data EpsilonEvaluatorArgumentsOutcome
  (EpsilonEvaluatorArgumentsEvaluated EpsilonEvaluatorArgumentValues
    EpsilonRuntimeStore Bytes)
  (EpsilonEvaluatorArgumentsStopped EpsilonEvaluatorOutcome))
