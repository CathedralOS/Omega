(def epsilon_console_is_byte ((value Int)) Int
  (if (lt value 0) 0 (lt value 256)))

; A checked byte view contains only integers in 0..255. Missing and noninteger
; elements yield -1 so the caller rejects all three invariant failures together.
(def epsilon_console_view_scalar ((item EpsilonRuntimeValueLookup)) Int
  (match item
    (NoEpsilonRuntimeValue -1)
    ((SomeEpsilonRuntimeValue value)
      (match value
        ((EpsilonRuntimeInteger byte) byte)
        ((EpsilonRuntimeAggregate typeValue children) -1)
        ((EpsilonRuntimeSumValue caseValue payloads) -1)
        ((EpsilonRuntimeViewValue nestedView) -1)))))

(def epsilon_evaluator_write_view ((view EpsilonRuntimeView) (index Int)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (if (lt index (epsilon_runtime_view_length view))
    (let byte Int (epsilon_console_view_scalar (epsilon_runtime_view_read view index store))
      (if (epsilon_console_is_byte byte)
        (epsilon_evaluator_write_view view (+ index 1) store
          (bytes_concat output (bytes_single byte)))
        (EpsilonEvaluatorInternal 0)))
    (EpsilonEvaluatorResultless store (bytes_concat output "\n"))))

(def epsilon_evaluator_console_value ((kind Int) (value EpsilonRuntimeValue)
  (store EpsilonRuntimeStore) (output Bytes)) EpsilonEvaluatorOutcome
  (match value
    ((EpsilonRuntimeInteger scalar)
      (if (eq kind 1)
        (EpsilonEvaluatorExit scalar output)
        (if (eq kind 2)
          (if (epsilon_console_is_byte scalar)
            (EpsilonEvaluatorResultless store (bytes_concat output (bytes_single scalar)))
            (EpsilonEvaluatorTrap 5 output))
          (EpsilonEvaluatorInternal 0))))
    ((EpsilonRuntimeViewValue view)
      (if (eq kind 4)
        (epsilon_evaluator_write_view view 0 store output)
        (EpsilonEvaluatorInternal 0)))
    ((EpsilonRuntimeAggregate typeValue children) (EpsilonEvaluatorInternal 0))
    ((EpsilonRuntimeSumValue caseValue payloads) (EpsilonEvaluatorInternal 0))))
