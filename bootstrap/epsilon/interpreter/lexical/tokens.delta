
; ---- allocation-free syntax-token rescan -------------------------------
;
; After LexicallyValid, the parser keeps a
; source cursor, skips trivia to the next start (or source extent at EOF), and
; rescans code, end, or literal value as needed. No token fact enters the
; immutable Delta heap and no coordinate is packed into a narrower integer.

(def epsilon_span_is_1 ((source EpsilonSourceView) (start Int) (end Int) (a Int)) Int
  (if (eq (- end start) 1) (eq (epsilon_source_byte source start) a) 0))

(def epsilon_span_is_2 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int)) Int
  (if (eq (- end start) 2)
    (if (eq (epsilon_source_byte source start) a) (eq (epsilon_source_byte source (+ start 1)) b) 0)
    0))

(def epsilon_span_is_3 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int)) Int
  (if (eq (- end start) 3)
    (if (epsilon_span_is_2 source start (+ start 2) a b) (eq (epsilon_source_byte source (+ start 2)) c) 0)
    0))

(def epsilon_span_is_4 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int)) Int
  (if (eq (- end start) 4)
    (if (epsilon_span_is_3 source start (+ start 3) a b c) (eq (epsilon_source_byte source (+ start 3)) d) 0)
    0))

(def epsilon_span_is_5 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int)) Int
  (if (eq (- end start) 5)
    (if (epsilon_span_is_4 source start (+ start 4) a b c d) (eq (epsilon_source_byte source (+ start 4)) e) 0)
    0))

(def epsilon_span_is_6 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int)) Int
  (if (eq (- end start) 6)
    (if (epsilon_span_is_5 source start (+ start 5) a b c d e) (eq (epsilon_source_byte source (+ start 5)) f) 0)
    0))

(def epsilon_span_is_7 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int)) Int
  (if (eq (- end start) 7)
    (if (epsilon_span_is_6 source start (+ start 6) a b c d e f) (eq (epsilon_source_byte source (+ start 6)) g) 0)
    0))

(def epsilon_span_is_8 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) Int
  (if (eq (- end start) 8)
    (if (epsilon_span_is_7 source start (+ start 7) a b c d e f g) (eq (epsilon_source_byte source (+ start 7)) h) 0)
    0))

(def epsilon_span_is_10 ((source EpsilonSourceView) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int) (i Int) (j Int)) Int
  (if (eq (- end start) 10)
    (if (epsilon_span_is_8 source start (+ start 8) a b c d e f g h)
      (if (eq (epsilon_source_byte source (+ start 8)) i) (eq (epsilon_source_byte source (+ start 9)) j) 0)
      0)
    0))

; Delta constructs byte literals at runtime. Build this list once per admitted
; source view so rescanning identifiers can compare the same spellings.
; Shorter words come first. Lookup stops when the next word is too long.
(def epsilon_keywords ((sourceLength Int)) EpsilonKeywordList
  (if (lt sourceLength 2) NoEpsilonKeywords
    (EpsilonKeyword "u8" 25
    (EpsilonKeyword "let" 17
    (EpsilonKeyword "mut" 23
    (EpsilonKeyword "i32" 24
    (EpsilonKeyword "data" 12
    (EpsilonKeyword "case" 13
    (EpsilonKeyword "true" 20
    (EpsilonKeyword "self" 22
    (EpsilonKeyword "trait" 11
    (EpsilonKeyword "state" 15
    (EpsilonKeyword "false" 21
    (EpsilonKeyword "never" 26
    (EpsilonKeyword "return" 18
    (EpsilonKeyword "assert" 19
    (EpsilonKeyword "machine" 14
    (EpsilonKeyword "boundary" 10
    (EpsilonKeyword "transition" 16
      NoEpsilonKeywords)))))))))))))))))))

(def epsilon_keyword_matches
  ((source EpsilonSourceView) (start Int) (word Bytes) (index Int) (length Int)) Int
  (if (eq index length) 1
    (if (eq (epsilon_source_byte source (+ start index)) (bytes_get word index))
      (epsilon_keyword_matches source start word (+ index 1) length) 0)))

(def epsilon_find_keyword
  ((source EpsilonSourceView) (start Int) (length Int) (words EpsilonKeywordList)) Int
  (match words
    (NoEpsilonKeywords 1)
    ((EpsilonKeyword word code rest)
      (let wordLength Int (bytes_length word)
        (if (lt length wordLength) 1
          (if (if (eq length wordLength)
                (epsilon_keyword_matches source start word 0 length) 0)
            code
            (epsilon_find_keyword source start length rest)))))))

(def epsilon_keyword_code ((source EpsilonSourceView) (start Int) (end Int)) Int
  (let length Int (- end start)
    (if (lt length 2) 1
      (if (lt 10 length) 1
        (epsilon_find_keyword source start length (epsilon_source_keywords source))))))

(def epsilon_skip_comment ((source EpsilonSourceView) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (let commentByte Int (epsilon_source_byte source index)
      (if (eq commentByte '\n')
        (epsilon_token_start source index)
        (if (eq commentByte '\r')
          (epsilon_token_start source index)
          (epsilon_skip_comment source (+ index 1) length))))))

(def epsilon_token_start ((source EpsilonSourceView) (index Int)) Int
  (let length Int (epsilon_source_length source)
    (if (eq index length)
      length
      (let startByte Int (epsilon_source_byte source index)
        (if (is_space startByte)
          (epsilon_token_start source (+ index 1))
          (if (epsilon_starts_comment source index length startByte)
            (epsilon_skip_comment source (+ index 2) length)
            index))))))

(def epsilon_identifier_end ((source EpsilonSourceView) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_ident_continue (epsilon_source_byte source index))
      (epsilon_identifier_end source (+ index 1) length)
      index)))

(def epsilon_number_end ((source EpsilonSourceView) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_digit (epsilon_source_byte source index))
      (epsilon_number_end source (+ index 1) length)
      index)))

(def epsilon_string_end ((source EpsilonSourceView) (index Int)) Int
  (let stringByte Int (epsilon_source_byte source index)
    (if (eq stringByte '"')
      (+ index 1)
      (if (eq stringByte '\\')
        (if (eq (epsilon_source_byte source (+ index 1)) 'x')
          (epsilon_string_end source (+ index 4))
          (epsilon_string_end source (+ index 2)))
        (epsilon_string_end source (+ index 1))))))

(def epsilon_character_end ((source EpsilonSourceView) (start Int)) Int
  (if (eq (epsilon_source_byte source (+ start 1)) '\\')
    (if (eq (epsilon_source_byte source (+ start 2)) 'x') (+ start 6) (+ start 4))
    (+ start 3)))

; Validation and the parser both choose a two-byte symbol before a single
; byte. Zero means that the spelling has no token code.
(def epsilon_single_operator_code ((c Int)) Int
  (if (eq c '&') 40
  (if (eq c '=') 41
  (if (eq c '|') 47
  (if (eq c '^') 48
  (if (eq c '<') 51
  (if (eq c '>') 53
  (if (eq c '+') 57
  (if (eq c '-') 58
  (if (eq c '*') 59
  (if (eq c '/') 60
  (if (eq c '%') 61
    0))))))))))))

(def epsilon_single_symbol_code ((c Int)) Int
  (if (eq c '{') 30
  (if (eq c '}') 31
  (if (eq c '(') 32
  (if (eq c ')') 33
  (if (eq c '[') 34
  (if (eq c ']') 35
  (if (eq c ';') 36
  (if (eq c ':') 37
  (if (eq c ',') 38
  (if (eq c '.') 39
    (epsilon_single_operator_code c))))))))))))

(def epsilon_two_byte_symbol_code ((leftByte Int) (rightByte Int)) Int
  (if (eq rightByte '=')
    (if (eq leftByte '=') 49
    (if (eq leftByte '!') 50
    (if (eq leftByte '<') 52
    (if (eq leftByte '>') 54 0))))
    (if (eq leftByte rightByte)
      (if (eq leftByte ':') 43
      (if (eq leftByte '.') 44
      (if (eq leftByte '|') 45
      (if (eq leftByte '&') 46
      (if (eq leftByte '<') 55
      (if (eq leftByte '>') 56 0))))))
      (if (eq leftByte '-') (if (eq rightByte '>') 42 0) 0))))

(def epsilon_two_byte_symbol_at ((source EpsilonSourceView) (start Int) (length Int) (c Int)) Int
  (if (lt (+ start 1) length)
    (epsilon_two_byte_symbol_code c (epsilon_source_byte source (+ start 1))) 0))

(def epsilon_token_end ((source EpsilonSourceView) (start Int)) Int
  (let length Int (epsilon_source_length source)
    (if (eq start length)
      length
      (let tokenByte Int (epsilon_source_byte source start)
        (if (is_ident_start tokenByte)
          (epsilon_identifier_end source (+ start 1) length)
          (if (is_digit tokenByte)
            (epsilon_number_end source (+ start 1) length)
            (if (eq tokenByte '"')
              (epsilon_string_end source (+ start 1))
              (if (eq tokenByte '\'')
                (epsilon_character_end source start)
                (if (epsilon_two_byte_symbol_at source start length tokenByte)
                  (+ start 2) (+ start 1))))))))))

(def epsilon_operator_code ((source EpsilonSourceView) (start Int) (length Int) (c Int)) Int
  (let code Int (epsilon_two_byte_symbol_at source start length c)
    (if code code (epsilon_single_symbol_code c))))

(def epsilon_token_code ((source EpsilonSourceView) (start Int)) Int
  (let length Int (epsilon_source_length source)
    (if (eq start length)
      0
      (let tokenByte Int (epsilon_source_byte source start)
        (if (is_ident_start tokenByte)
          (epsilon_keyword_code source start (epsilon_identifier_end source (+ start 1) length))
          (if (is_digit tokenByte) 2
            (if (eq tokenByte '\'') 3
              (if (eq tokenByte '"') 4
                (epsilon_operator_code source start length tokenByte)))))))))

(def epsilon_hex_value ((c Int)) Int
  (if (is_digit c) (- c '0')
    (if (ascii_between c 'A' 'F') (+ (- c 'A') 10) (+ (- c 'a') 10))))

(def epsilon_escape_value ((c Int)) Int
  (if (eq c 'n') '\n' (if (eq c 'r') '\r' (if (eq c 't') '\t' c))))

(def epsilon_character_value ((source EpsilonSourceView) (opening Int)) Int
  (let characterByte Int (epsilon_source_byte source (+ opening 1))
    (if (eq characterByte '\\')
      (let escapeByte Int (epsilon_source_byte source (+ opening 2))
        (if (eq escapeByte 'x')
          (+ (* (epsilon_hex_value (epsilon_source_byte source (+ opening 3))) 16)
             (epsilon_hex_value (epsilon_source_byte source (+ opening 4))))
          (epsilon_escape_value escapeByte)))
      characterByte)))

(def epsilon_number_value ((source EpsilonSourceView) (index Int) (end Int) (value Int)) Int
  (if (eq index end)
    value
    (epsilon_number_value source (+ index 1) end
      (+ (* value 10) (- (epsilon_source_byte source index) 48)))))

(def epsilon_token_value ((source EpsilonSourceView) (start Int)) Int
  (let length Int (epsilon_source_length source)
    (if (eq start length)
      0
      (let tokenByte Int (epsilon_source_byte source start)
        (if (is_digit tokenByte)
          (epsilon_number_value source start (epsilon_number_end source (+ start 1) length) 0)
          (if (eq tokenByte '\'') (epsilon_character_value source start) 0))))))
