; Canonical entry appended to the Epsilon interpreter closure. The complete
; wire contract lives in interpreter/EVALUATOR_ENTRY.md.
;
; EEREQ has an 8-byte identity, u32 profile and lengths (source, stdin),
; then the 32-byte interpreter-closure SHA-256, source bytes and stdin.
; The checker returns the first failing coordinate before running the guest.
; Exit, Trap and Reject start with tags 0, 1 and 2. A 40-byte EEOUT refusal
; starts with 255 and carries outcome, space, reserved, code and three u64s.

(def epsilon_edge_request_identity () Bytes
  (bytes_concat "EEREQ" (bytes_concat (bytes_single 1) (epsilon_edge_u16 0))))

(def epsilon_edge_refusal_identity () Bytes
  (bytes_concat (bytes_concat (bytes_single 255) "EEOUT")
    (bytes_concat (bytes_single 1) (bytes_single 0))))

; SHA-256 of the packed epsilon_compiler.delta.sources closure.
(def epsilon_edge_closure_sha256 () Bytes
  "c5392b0a71cbe58de5090fb888b379fa5cb3b4b598ba38d6f1a568e326ffa0ff")

(def epsilon_edge_digest_byte ((hex Bytes) (index Int)) Int
  (let first Int (* 2 index)
    (+ (* 16 (epsilon_hex_value (bytes_get hex first)))
       (epsilon_hex_value (bytes_get hex (+ first 1))))))

; Integer fields on the wire are little-endian.
(def epsilon_edge_u16 ((value Int)) Bytes
  (bytes_concat (bytes_single (% value 256)) (bytes_single (% (/ value 256) 256))))

(def epsilon_edge_u32 ((value Int)) Bytes
  (bytes_concat (epsilon_edge_u16 (% value 65536)) (epsilon_edge_u16 (/ value 65536))))

(def epsilon_edge_u64 ((value Int)) Bytes
  (bytes_concat
    (epsilon_edge_u32 (% value 4294967296))
    (epsilon_edge_u32 (/ value 4294967296))))

(def epsilon_edge_u32_at ((request Bytes) (offset Int)) Int
  (+ (+ (bytes_get request offset)
        (* (bytes_get request (+ offset 1)) 256))
     (+ (* (bytes_get request (+ offset 2)) 65536)
        (* (bytes_get request (+ offset 3)) 16777216))))

(def epsilon_edge_refusal ((outcome Int) (space Int) (code Int)
  (coordinate Int) (limit Int) (requested Int)) Bytes
  (let tags Bytes (bytes_concat (bytes_single outcome) (bytes_single space))
    (bytes_concat
      (bytes_concat (epsilon_edge_refusal_identity) (bytes_concat tags (epsilon_edge_u16 0)))
      (bytes_concat
        (bytes_concat (epsilon_edge_u32 code) (epsilon_edge_u64 coordinate))
        (bytes_concat (epsilon_edge_u64 limit) (epsilon_edge_u64 requested))))))

(def epsilon_edge_request_refusal ((code Int) (coordinate Int)) Bytes
  (epsilon_edge_refusal 1 1 code coordinate 0 0))

(def epsilon_edge_extent_refusal ((coordinate Int) (limit Int) (requested Int)) Bytes
  (epsilon_edge_refusal 1 1 6 coordinate limit requested))

; Admission stages: each returns the final publication (a canonical
; observation or an EEOUT frame); a failed stage never reaches evaluation.
(def epsilon_edge_check_identity ((request Bytes) (identity Bytes) (index Int) (extent Int)) Bytes
  (if (eq index (bytes_length identity))
    (epsilon_edge_check_profile request extent)
    (if (eq (bytes_get request index) (bytes_get identity index))
      (epsilon_edge_check_identity request identity (+ index 1) extent)
      (epsilon_edge_request_refusal 2 index))))

(def epsilon_edge_check_profile ((request Bytes) (extent Int)) Bytes
  (if (eq (epsilon_edge_u32_at request 8) 1)
    (epsilon_edge_check_lengths request extent)
    (epsilon_edge_request_refusal 3 8)))

(def epsilon_edge_check_lengths ((request Bytes) (extent Int)) Bytes
  (if (lt 127 (bytes_get request 15))
    (epsilon_edge_request_refusal 4 15)
    (if (lt 127 (bytes_get request 19))
      (epsilon_edge_request_refusal 4 19)
      (epsilon_edge_check_artifact request (epsilon_edge_closure_sha256) 0 extent))))

(def epsilon_edge_check_artifact ((request Bytes) (hex Bytes) (index Int) (extent Int)) Bytes
  (if (eq index 32)
    (epsilon_edge_check_extents request extent)
    (if (eq (bytes_get request (+ 20 index)) (epsilon_edge_digest_byte hex index))
      (epsilon_edge_check_artifact request hex (+ index 1) extent)
      (epsilon_edge_request_refusal 5 (+ 20 index)))))

(def epsilon_edge_check_extents ((request Bytes) (extent Int)) Bytes
  (let payloadLength Int (- extent 52)
    (let sourceLength Int (epsilon_edge_u32_at request 12)
      (if (lt payloadLength sourceLength)
        (epsilon_edge_extent_refusal 12 payloadLength sourceLength)
        (let remaining Int (- payloadLength sourceLength)
          (let stdinLength Int (epsilon_edge_u32_at request 16)
            (if (lt remaining stdinLength)
              (epsilon_edge_extent_refusal 16 remaining stdinLength)
              (if (eq remaining stdinLength)
                (epsilon_edge_run request sourceLength)
                (epsilon_edge_request_refusal 7 (+ 52 (+ sourceLength stdinLength)))))))))))

; The evaluator itself: checking plus execution through the entry evaluator,
; serialized into the canonical observation or an internal EEOUT frame.
; Exact-end admission makes stdin the final suffix. Its cursor can only
; advance toward EOF, so the header and source stay outside Console input.
(def epsilon_edge_run ((request Bytes) (sourceLength Int)) Bytes
  (match (epsilon_source_view request 52 sourceLength)
    (InvalidEpsilonSourceView
      (epsilon_edge_request_refusal 6 12))
    ((ValidEpsilonSourceView source)
      (match (epsilon_evaluate_entry_view source
               (EpsilonRuntimeConsoleInputAt request (+ 52 sourceLength)))
        ((EpsilonEvaluatorSliceExit code output)
          (bytes_concat (bytes_single 0)
            (bytes_concat
              (epsilon_edge_u32 (if (lt code 0) (+ code 4294967296) code))
              output)))
        ((EpsilonEvaluatorSliceTrap kind output)
          (bytes_concat (bytes_single 1)
            (bytes_concat (bytes_single kind) output)))
        ((EpsilonEvaluatorSliceRejected reasonValue errorOffset)
          (bytes_concat (bytes_single 2)
            (bytes_concat
              (bytes_single (epsilon_reject_reason_identity reasonValue))
              (epsilon_edge_u32 errorOffset))))
        ((EpsilonEvaluatorSliceInternal errorOffset)
          (epsilon_edge_refusal 3 2 1 errorOffset 0 0))))))

(def main ((request Bytes)) Bytes
  (let extent Int (bytes_length request)
    (if (lt extent 52)
      (epsilon_edge_request_refusal 1 extent)
      (epsilon_edge_check_identity request (epsilon_edge_request_identity) 0 extent))))
