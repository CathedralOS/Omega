# Precise cache profile for the expensive Rust-free OMGLOWE-to-CKIR13 meaning
# gate. Keep it separate from the native/self producer and backend profile so
# fixture-only meaning changes do not rerun those independent gates.
script bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir13-meaning.sh

input Cargo.toml
input Cargo.lock
input bootstrap/onramps/delta-rust
input bootstrap/omega-bootstrap/compiler/OMEGA_BOOTSTRAP_RESOLUTION_V5.md
input bootstrap/omega-bootstrap/compiler/OMEGA_BOOTSTRAP_LOWERING_V14.md
input bootstrap/omega-bootstrap/compiler/OMEGA_BOOTSTRAP_CHECKED_IR_V13.md
input bootstrap/omega-bootstrap/compiler/omega-bootstrap-resolve.alp
input bootstrap/omega-bootstrap/compiler/omega-bootstrap-resolved-to-ckir4.alp
input bootstrap/omega-bootstrap/compiler/omega_bootstrap_bundle.py
input bootstrap/omega-bootstrap/compiler/omega_bootstrap_compilation.py
input bootstrap/omega-bootstrap/meaning/omega2gamma.beta
input bootstrap/omega-bootstrap/meaning/decode-gamma-output.py
input bootstrap/omega-bootstrap/gates/delta-ckir4-meaning-runner.py
input bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir13-fixture.py
input bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir13-meaning-fixture.py
input bootstrap/omega-bootstrap/gates/checked_ir_v2_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v3_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v4_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v5_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v13_reference.py
input bootstrap/omega-bootstrap/gates/fixtures/ckir13-full-u32-subtract
