script bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir11.sh
script bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir11-meaning.sh
script bootstrap/omega-bootstrap/gates/delta-checked-ir-v11-backend.sh

