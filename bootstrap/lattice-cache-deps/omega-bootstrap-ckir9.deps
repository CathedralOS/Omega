# Precise cache profile for the CKIR9 ordered-comparison producer, meaning,
# independent-reference, and backend gates. The producer deliberately reruns
# the inherited CKIR5--8 slices, so their exact fixtures remain dependencies.
script bootstrap/omega-bootstrap/gates/delta-checked-ir-v9-reference.sh
script bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir9.sh
script bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir9-meaning.sh
script bootstrap/omega-bootstrap/gates/delta-checked-ir-v9-backend.sh

input bootstrap/onramps/delta-rust

input bootstrap/omega-bootstrap/compiler/omega-bootstrap-resolve.alp
input bootstrap/omega-bootstrap/compiler/omega-bootstrap-resolved-to-ckir4.alp
input bootstrap/omega-bootstrap/compiler/omega-bootstrap-checked-ir-v5-to-elf.alp
input bootstrap/omega-bootstrap/compiler/omega_bootstrap_bundle.py
input bootstrap/omega-bootstrap/compiler/omega_bootstrap_compilation.py

input bootstrap/omega-bootstrap/meaning/omega2gamma.beta
input bootstrap/omega-bootstrap/meaning/decode-gamma-output.py

input bootstrap/omega-bootstrap/gates/checked_ir_v2_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v3_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v4_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v5_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v6_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v7_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v8_reference.py
input bootstrap/omega-bootstrap/gates/checked_ir_v9_reference.py
input bootstrap/omega-bootstrap/gates/checked_elf_v2_reference.py
input bootstrap/omega-bootstrap/gates/checked_elf_v3_reference.py
input bootstrap/omega-bootstrap/gates/checked_elf_v4_reference.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v5-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v5-backend-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v6-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v6-backend-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v7-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v7-backend-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v8-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v8-backend-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v9-fixture.py
input bootstrap/omega-bootstrap/gates/delta-checked-ir-v9-backend-fixture.py
input bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir4-fixture.py
input bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir4-frame.py
input bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir4-meaning.sh
input bootstrap/omega-bootstrap/gates/delta-resolved-to-ckir5-fixture.py
input bootstrap/omega-bootstrap/gates/delta-ckir4-meaning-runner.py
input bootstrap/omega-bootstrap/gates/resolution_handoff_reference.py
input bootstrap/omega-bootstrap/gates/resolved_to_ckir_mutations.py

input bootstrap/omega-bootstrap/gates/fixtures/ckir5-payload-sums
input bootstrap/omega-bootstrap/gates/fixtures/ckir6-logical-not
input bootstrap/omega-bootstrap/gates/fixtures/ckir7-logical-binary
input bootstrap/omega-bootstrap/gates/fixtures/ckir8-scalar-equality
input bootstrap/omega-bootstrap/gates/fixtures/ckir9-ordered-comparison
input compiler/psi/source/source.omg
