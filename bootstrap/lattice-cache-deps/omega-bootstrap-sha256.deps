# Precise cache profile for the bounded Delta SHA-256 producer.  The Gamma
# known-answer leg is intentionally expensive, so unrelated bridge edits must
# not replay it.  Rung compiler/interpreter inputs remain covered by CORE.
script bootstrap/omega-bootstrap/gates/delta-sha256.sh
script bootstrap/omega-bootstrap/gates/delta-sha256-meaning.sh

input bootstrap/onramps/delta-rust
input bootstrap/omega-bootstrap/compiler/OMEGA_BOOTSTRAP_COMPILATION.md
input bootstrap/omega-bootstrap/compiler/OMEGA_BOOTSTRAP_SHA256.md
input bootstrap/omega-bootstrap/compiler/omega-bootstrap-sha256.alp
input bootstrap/omega-bootstrap/compiler/omega_bootstrap_bundle.py
input bootstrap/omega-bootstrap/compiler/omega_bootstrap_compilation.py
input bootstrap/omega-bootstrap/gates/two_unit_compilation_fixture.py
input bootstrap/omega-bootstrap/gates/fixtures/sha256-known-answer
input bootstrap/omega-bootstrap/meaning/decode-gamma-output.py
