// Canonical outcome side of the standalone Omega compiler request
// (wiki/spec/build/compiler_request.md). This member owns the embedded
// OCOUT V1 table projections and the failure-frame encoder. A Complete
// result publishes the unwrapped artifact and never produces a frame here;
// every failure publishes exactly one closed frame. The frame is 40 bytes,
// extended to 48 only when the coordinate space is canonical Omega source.
//
// Each halt tag owns an independent outcome-code table: Reject codes name
// request/source refusals, Incomplete codes are the scalar-resource table,
// and InternalFailure codes name named invariant violations. The assigned
// entries are embedded here as projections; producers record an outcome
// tuple and the eventual request adapter publishes exactly one encoded
// frame. encode refuses every unassigned or noncanonical tuple, so a
// producer whose code inventory is still incomplete cannot emit a frame
// the contract does not define.

// Scalar-resource wire codes: parser capacities 3..11 use coordinate space 4
// (canonical source), the request-extent provisions 1..2 use space 1 (OCREQ
// request), and the Alpha tape capacities 12..14 use space 2 (emitted
// artifact). Returns -1 for an unassigned code.
machine omega_compiler_resource_space(code: i32) -> i32 {
    transition code {
        1 -> return 1
        2 -> return 1
        3 -> return 4
        4 -> return 4
        5 -> return 4
        6 -> return 4
        7 -> return 4
        8 -> return 4
        9 -> return 4
        10 -> return 4
        11 -> return 4
        12 -> return 2
        13 -> return 2
        14 -> return 2
        25 -> return 0
        26 -> return 1
        _ -> return -1
    }
}

// Selected scalar-resource limits. Every limit is strictly below INT32_MAX;
// 0 marks an unassigned code.
machine omega_compiler_resource_limit(code: i32) -> i32 {
    transition code {
        1 -> return 67108864
        2 -> return 1048576
        3 -> return 4096
        4 -> return 4096
        5 -> return 16384
        6 -> return 16384
        7 -> return 16384
        8 -> return 128
        9 -> return 128
        10 -> return 16384
        11 -> return 16384
        12 -> return 16777212
        13 -> return 1864134
        14 -> return 16777212
        25 -> return 0
        26 -> return 65536
        _ -> return 0
    }
}

// The parser's private resource enum projects onto wire codes 3..11;
// OmegaParserResource::None and any unassigned case project to 0.
machine omega_parser_resource_code(resource: OmegaParserResource) -> i32 {
    transition resource {
        OmegaParserResource::Roots -> return 3
        OmegaParserResource::States -> return 4
        OmegaParserResource::PathMembers -> return 5
        OmegaParserResource::DataMembers -> return 6
        OmegaParserResource::TypeNodes -> return 7
        OmegaParserResource::TypeDepth -> return 8
        OmegaParserResource::ExpressionDepth -> return 9
        OmegaParserResource::Statements -> return 10
        OmegaParserResource::Expressions -> return 11
        _ -> return 0
    }
}

// Assigned Reject codes project to their fixed coordinate space; -1 marks an
// unassigned code. Code 1 is malformed_request (OCREQ request offset), codes
// 2..9 are the lexical refusals, code 10 duplicate_name and code 12
// integer_literal_out_of_range anchor in canonical source, and code 11
// missing_entry carries no coordinate. The syntax and remaining checking
// inventory stays unassigned until the contract names it.
machine omega_reject_code_space(code: i32) -> i32 {
    transition code {
        1 -> return 1
        2 -> return 4
        3 -> return 4
        4 -> return 4
        5 -> return 4
        6 -> return 4
        7 -> return 4
        8 -> return 4
        9 -> return 4
        10 -> return 4
        11 -> return 0
        12 -> return 4
        _ -> return -1
    }
}

// The scanner's retained OmegaLexDiagnosticCode projects onto Reject codes
// 2..9 in the contract's order. The projection returns 0 for a case the
// contract has not assigned; 0 is not a publishable Reject code, so an
// unassigned lexical diagnostic cannot produce a frame.
machine omega_lexical_reject_code(code: OmegaLexDiagnosticCode) -> i32 {
    transition code {
        OmegaLexDiagnosticCode::InvalidUtf8 -> return 2
        OmegaLexDiagnosticCode::OutsideLexicalProfile -> return 3
        OmegaLexDiagnosticCode::UnterminatedBlockComment -> return 4
        OmegaLexDiagnosticCode::UnterminatedStringLiteral -> return 5
        OmegaLexDiagnosticCode::UnterminatedStringEscape -> return 6
        OmegaLexDiagnosticCode::UnsupportedEscape -> return 7
        OmegaLexDiagnosticCode::UnterminatedHexEscape -> return 8
        OmegaLexDiagnosticCode::InvalidHexEscapeDigit -> return 9
        _ -> return 0
    }
}

// Assigned InternalFailure codes project to their fixed coordinate space;
// -1 marks an unassigned code. Code 1 is invariant_violation (internal row).
machine omega_internal_code_space(code: i32) -> i32 {
    transition code {
        1 -> return 3
        _ -> return -1
    }
}

// min(exact nonnegative sum, INT32_MAX): the publication normalization for a
// requested amount that combines two retained extents, with the
// pre-operation check the bounded-arithmetic rule requires. Negative inputs
// are a producer defect and return -1 rather than a publishable amount.
machine omega_saturating_i32_sum(left: i32, right: i32) -> i32 {
    transition (left >= 0) && (right >= 0) {
        true -> bounded()
        _ -> return -1
    }

    state bounded() {
        transition left <= 2147483647 - right {
            true -> return left + right
            _ -> return 2147483647
        }
    }
}

// Phase-1 declared-extent provisions on a completely framed request, checked
// before either section is interpreted: the first scalar resources are the
// fixed header's own section extents. Returns the Incomplete resource code
// to publish, 0 when both declared extents fit, and -1 when no frame
// completed admission.
machine OmegaRequestEnvelope::extent_resource(&mut self) -> i32 {
    transition self.complete {
        1 -> check_subject()
        _ -> return -1
    }

    state check_subject() {
        transition self.subject_end - self.subject_start <=
            omega_compiler_resource_limit(1) {
            true -> check_invocation()
            _ -> return 1
        }
    }

    state check_invocation() {
        transition self.invocation_end - self.invocation_start <=
            omega_compiler_resource_limit(2) {
            true -> return 0
            _ -> return 2
        }
    }
}

data OmegaOutcomeFrame {
    // bytes 40..47 carry the space-4 canonical-source tail only; shorter
    // frames never expose them.
    bytes: [u8; 48];
    length: i32;
    encoded: i32;
}

machine OmegaOutcomeFrame::write_u32(&mut self, offset: i32, value: i32) {
    self.bytes[offset] = value & 255;
    self.bytes[offset + 1] = (value >> 8) & 255;
    self.bytes[offset + 2] = (value >> 16) & 255;
    self.bytes[offset + 3] = (value >> 24) & 255;
    return;
}

machine OmegaOutcomeFrame::write_u64(&mut self, offset: i32, value: i32) {
    self.write_u32(offset, value);
    self.write_u32(offset + 4, 0);
    return;
}

// Canonical OCOUT V1 constructor. Returns 1 with exactly `length` bytes
// owned by the frame, or 0 with nothing publishable. Validation mirrors the
// contract: only failure tags produce frames, every published code is an
// assigned table entry paired with its fixed coordinate space, resource
// outcomes carry the table's selected limit, non-resource outcomes carry
// zero scalar fields, space 0 pairs with a zero coordinate, and only space 4
// carries canonical package/source-unit ordinals. Public quantities are
// nonnegative i32 values, so their physical u64 high words are zero.
machine OmegaOutcomeFrame::encode(
    &mut self,
    tag: i32,
    space: i32,
    code: i32,
    coordinate: i32,
    package_ordinal: i32,
    unit_ordinal: i32,
    limit: i32,
    requested: i32
) -> i32 {
    // A refused call leaves no publishable frame; resetting before any check
    // keeps a prior success from leaking through a later refusal.
    self.encoded = 0;
    self.length = 0;
    transition (tag >= 1) && (tag <= 3) {
        true -> check_space()
        _ -> return 0
    }

    state check_space() {
        transition (space >= 0) && (space <= 4) {
            true -> dispatch_code()
            _ -> return 0
        }
    }

    state dispatch_code() {
        transition tag {
            1 -> reject_code()
            2 -> resource_code()
            _ -> internal_code()
        }
    }

    state reject_code() {
        transition omega_reject_code_space(code) == space {
            true -> check_coordinate()
            _ -> return 0
        }
    }

    state resource_code() {
        transition omega_compiler_resource_space(code) == space {
            true -> check_resource_limit()
            _ -> return 0
        }
    }

    state check_resource_limit() {
        transition limit == omega_compiler_resource_limit(code) {
            true -> check_coordinate()
            _ -> return 0
        }
    }

    state internal_code() {
        transition omega_internal_code_space(code) == space {
            true -> check_coordinate()
            _ -> return 0
        }
    }

    state check_coordinate() {
        transition coordinate >= 0 {
            true -> check_none_coordinate()
            _ -> return 0
        }
    }

    state check_none_coordinate() {
        transition (space == 0) && (coordinate != 0) {
            true -> return 0
            _ -> check_scalars()
        }
    }

    state check_scalars() {
        transition (tag != 2) && ((limit != 0) || (requested != 0)) {
            true -> return 0
            _ -> check_amounts()
        }
    }

    state check_amounts() {
        transition (limit >= 0) && (requested >= 0) {
            true -> check_ordinals()
            _ -> return 0
        }
    }

    state check_ordinals() {
        transition (package_ordinal >= 0) && (unit_ordinal >= 0) {
            true -> check_tail()
            _ -> return 0
        }
    }

    state check_tail() {
        transition (space != 4) && ((package_ordinal != 0) ||
            (unit_ordinal != 0)) {
            true -> return 0
            _ -> write_identity()
        }
    }

    state write_identity() {
        self.bytes[0] = 255;
        self.bytes[1] = 79;
        self.bytes[2] = 67;
        self.bytes[3] = 79;
        self.bytes[4] = 85;
        self.bytes[5] = 84;
        self.bytes[6] = 1;
        self.bytes[7] = 0;
        self.bytes[8] = tag;
        self.bytes[9] = space;
        self.bytes[10] = 0;
        self.bytes[11] = 0;
        self.write_u32(12, code);
        self.write_u64(16, coordinate);
        self.write_u64(24, limit);
        self.write_u64(32, requested);
        transition space {
            4 -> write_tail()
            _ -> finish(40)
        }
    }

    state write_tail() {
        self.write_u32(40, package_ordinal);
        self.write_u32(44, unit_ordinal);
        transition true { true -> finish(48) }
    }

    state finish(count: i32) {
        self.length = count;
        self.encoded = 1;
        return 1;
    }
}
