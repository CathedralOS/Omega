    state type_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBracket -> begin_type_array()
            OmegaPunctuationKind::Ampersand -> type_reference_or_recast()
            OmegaPunctuationKind::LeftParen -> begin_unit_type()
            OmegaPunctuationKind::Hash -> incomplete_root()
            _ -> type_missing_failure(
