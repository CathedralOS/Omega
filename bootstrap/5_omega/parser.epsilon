            OmegaExpressionConsumer::TransitionTargetArgument ->
                retain_transition_target_argument_path()
            OmegaExpressionConsumer::TransitionPatternFieldValue ->
                retain_path_expression()
            _ -> incomplete_root()
        }
    }

    state retain_right_parenthesis_terminated_path() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> retain_call_argument_path()
            OmegaExpressionConsumer::AssignmentValue ->
                retain_assignment_value_path()
            OmegaExpressionConsumer::LocalDataInitialValue ->
                retain_local_data_initial_value_path()
            OmegaExpressionConsumer::TransitionSubject ->
                retain_transition_subject_path()
            OmegaExpressionConsumer::TransitionTargetArgument ->
