    state begin_struct_literal_from_path() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::StructFieldValue -> incomplete_root()
            OmegaExpressionConsumer::IndexedIndex -> incomplete_root()
            _ -> check_struct_literal_type_path()
