    state push_indexed_expression_frame(continuation: i32) {
        transition self.indexed_expression_frame_count < 128 {
            true -> push_indexed_expression_frame_bounded(continuation)
            _ -> resource_failure(
                OmegaParserResource::ExpressionDepth,
                128,
                self.indexed_expression_frame_count + 1
            )
