                self.member_count + 1
            )
        }
    }

    state begin_reaches_clause_bounded() {
        self.machine_clause_start = self.scan.token_start;
        self.machine_clause_first_member = self.member_count;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(72) }
    }

    state reach_service_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_reach_service()
            _ -> incomplete_root()
        }
    }

    state retain_reach_service() {
        self.members[self.member_count].start = self.scan.token_start;
        self.members[self.member_count].end = self.scan.token_end;
        self.member_count = self.member_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(73) }
    }

    state reach_tail_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> reach_tail_punctuation()
            OmegaTokenKind::Identifier -> reach_tail_identifier()
            _ -> incomplete_root()
        }
    }

    state reach_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> retain_reaches_clause(0)
            OmegaPunctuationKind::Semicolon -> retain_reaches_clause(1)
            OmegaPunctuationKind::Comma -> next_reach_service()
            OmegaPunctuationKind::Plus -> next_reach_service()
            _ -> incomplete_root()
        }
    }

    state reach_tail_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "reaches"
        ) {
            1 -> retain_reaches_clause(2)
            _ -> incomplete_root()
        }
    }

    state next_reach_service() {
        transition self.member_count < 16384 {
            true -> next_reach_service_bounded()
            _ -> resource_failure(
                OmegaParserResource::PathMembers,
                16384,
                self.member_count + 1
            )
        }
    }

    state next_reach_service_bounded() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(72) }
    }

    state retain_reaches_clause(continuation: i32) {
        self.machine_clauses[self.machine_clause_count].kind =
            OmegaMachineClauseKind::Reaches;
        self.machine_clauses[self.machine_clause_count].first_member =
            self.machine_clause_first_member;
        self.machine_clauses[self.machine_clause_count].member_count =
            self.member_count - self.machine_clause_first_member;
        self.machine_clauses[self.machine_clause_count].first_view_member = 0;
        self.machine_clauses[self.machine_clause_count].view_member_count = 0;
        self.machine_clauses[self.machine_clause_count].by_keyword.start = 0;
        self.machine_clauses[self.machine_clause_count].by_keyword.end = 0;
        self.machine_clauses[self.machine_clause_count].arrow.start = 0;
        self.machine_clauses[self.machine_clause_count].arrow.end = 0;
        self.machine_clauses[
            self.machine_clause_count
        ].has_external_binding = 0;
        self.machine_clauses[
            self.machine_clause_count
        ].external_binding_kind = OmegaExternalBindingKind::CompilerIntrinsic;
        self.machine_clauses[self.machine_clause_count].via_keyword.start = 0;
        self.machine_clauses[self.machine_clause_count].via_keyword.end = 0;
        self.machine_clauses[self.machine_clause_count].binding_root.start = 0;
        self.machine_clauses[self.machine_clause_count].binding_root.end = 0;
        self.machine_clauses[self.machine_clause_count].binding_case.start = 0;
        self.machine_clauses[self.machine_clause_count].binding_case.end = 0;
        self.machine_clauses[self.machine_clause_count].start =
            self.machine_clause_start;
        self.machine_clauses[self.machine_clause_count].end =
            self.members[self.member_count - 1].end;
        self.machine_clause_count = self.machine_clause_count + 1;
        transition continuation {
            0 -> enter_current_state_body()
            1 -> continue_machine_clauses_after_semicolon()
            _ -> begin_reaches_clause()
        }
    }

    state continue_machine_clauses_after_semicolon() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(71) }
    }

    state machine_header_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> enter_current_state_body()
            OmegaPunctuationKind::Arrow -> begin_machine_return_type()
            OmegaPunctuationKind::Semicolon -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_machine_return_type() {
        self.type_consumer = OmegaTypeConsumer::MachineReturn;
        transition true { true -> begin_type() }
    }

    state enter_machine_body() {
        self.state_is_explicit = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> resume_state_body() }
    }

    state enter_current_state_body() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> resume_state_body() }
    }

    state resume_state_body() {
        transition self.state_is_explicit {
            1 -> scan_semantic(66)
            _ -> scan_semantic(30)
        }
    }

    state state_body_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> state_body_punctuation()
            OmegaTokenKind::Identifier -> begin_named_statement_path()
            OmegaTokenKind::Integer -> begin_integer_expression_statement()
            OmegaTokenKind::StringLiteral -> begin_string_expression_statement()
            OmegaTokenKind::Keyword -> state_body_keyword()
            _ -> incomplete_root()
        }
    }

    state state_body_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> incomplete_root()
            OmegaKeywordKind::SelfValue -> begin_self_statement_path()
            OmegaKeywordKind::True -> begin_boolean_expression_statement(1)
            OmegaKeywordKind::False -> begin_boolean_expression_statement(0)
            OmegaKeywordKind::Let -> begin_local_data_statement()
            OmegaKeywordKind::If -> incomplete_root()
            OmegaKeywordKind::Transition -> begin_transition()
            OmegaKeywordKind::Match -> incomplete_root()
            OmegaKeywordKind::State -> begin_nested_state()
            _ -> begin_named_statement_path()
        }
    }

    state state_body_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBrace -> finish_current_state()
            _ -> incomplete_root()
        }
    }

    state begin_local_data_statement() {
        self.state_has_body_syntax = 1;
        self.local_data_start = self.scan.token_start;
        self.local_data_is_mutable = 0;
        self.local_data_has_initial_value = 0;
        self.local_data_initial_value = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(76) }
    }

    state local_data_name_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> local_data_name_identifier()
            OmegaTokenKind::Keyword -> local_data_name_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedLocalDataName,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state local_data_name_identifier() {
        self.local_data_name_start = self.scan.token_start;
        self.local_data_name_end = self.scan.token_end;
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "mut"
        ) {
            1 -> retain_possible_local_data_mut()
            _ -> retain_local_data_name()
        }
    }

    state local_data_name_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedLocalDataName,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedLocalDataName,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_local_data_name()
        }
    }

    state retain_possible_local_data_mut() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(77) }
    }

    state local_data_name_after_mut_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_mutable_local_data_name()
            OmegaTokenKind::Keyword -> local_data_name_after_mut_keyword()
            _ -> local_data_colon_token()
        }
    }

    state local_data_name_after_mut_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> local_data_colon_token()
            OmegaKeywordKind::SelfValue -> local_data_colon_token()
            _ -> retain_mutable_local_data_name()
        }
    }

    state retain_mutable_local_data_name() {
        self.local_data_is_mutable = 1;
        transition true { true -> retain_local_data_name() }
    }

    state retain_local_data_name() {
        self.local_data_name_start = self.scan.token_start;
        self.local_data_name_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(78) }
    }

    state local_data_colon_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> local_data_colon_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedLocalDataColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state local_data_colon_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Colon -> begin_local_data_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedLocalDataColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_local_data_type() {
        self.type_consumer = OmegaTypeConsumer::LocalData;
        transition true { true -> begin_type() }
    }

    state begin_integer_expression_statement() {
        self.state_has_body_syntax = 1;
        self.expression_consumer = OmegaExpressionConsumer::ExpressionStatement;
        transition true { true -> check_integer_expression() }
    }

    state begin_string_expression_statement() {
        self.state_has_body_syntax = 1;
        self.expression_consumer = OmegaExpressionConsumer::ExpressionStatement;
        transition true { true -> retain_string_expression() }
    }

    state begin_boolean_expression_statement(value: i32) {
        self.state_has_body_syntax = 1;
        self.expression_consumer = OmegaExpressionConsumer::ExpressionStatement;
        transition true { true -> retain_boolean_expression(value) }
    }

    state finish_current_state() {
        transition self.state_is_explicit {
            1 -> retain_explicit_state_for_machine_members()
            _ -> retain_implicit_state_for_machine()
        }
    }

    state begin_nested_state() {
        transition self.state_is_explicit {
            1 -> incomplete_root()
            _ -> begin_explicit_state_after_implicit_check()
        }
    }

    state begin_explicit_state_after_implicit_check() {
        transition (self.machine_parameter_count > self.state_first_parameter) ||
            (self.state_has_return_type == 1) ||
            (self.state_has_body_syntax == 1) ||
            (self.statement_count > self.state_first_statement) {
            true -> retain_implicit_state_for_explicit_state()
            _ -> begin_explicit_state()
        }
    }

    state begin_explicit_state() {
        self.state_is_explicit = 1;
        self.state_first_parameter = self.machine_parameter_count;
        self.state_first_statement = self.statement_count;
        self.state_has_body_syntax = 0;
        self.state_has_return_type = 0;
        self.state_return_type = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(58) }
    }

    state explicit_state_name_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_explicit_state_name()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateName,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_explicit_state_name() {
        self.state_name_start = self.scan.token_start;
        self.state_name_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(59) }
    }

    state explicit_state_header_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> explicit_state_header_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state explicit_state_header_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftParen -> begin_machine_parameters()
            OmegaPunctuationKind::LeftBrace -> enter_current_state_body()
            OmegaPunctuationKind::Arrow -> begin_machine_return_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_member_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> machine_member_punctuation()
            OmegaTokenKind::Keyword -> machine_member_keyword()
            _ -> incomplete_root()
        }
    }

    state machine_member_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::State -> begin_explicit_state()
            _ -> incomplete_root()
        }
    }

    state machine_member_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBrace -> retain_machine()
            _ -> incomplete_root()
        }
    }

    state begin_transition() {
        self.state_has_body_syntax = 1;
        self.transition_has_subject = 1;
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(60) }
    }

    state transition_subject_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> transition_subject_punctuation()
            OmegaTokenKind::Identifier -> begin_named_transition_subject()
            OmegaTokenKind::Integer -> begin_integer_transition_subject()
            OmegaTokenKind::Keyword -> transition_subject_keyword()
            _ -> incomplete_root()
        }
    }

    state transition_subject_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> begin_subjectless_transition()
            OmegaPunctuationKind::LeftParen -> begin_expression_group()
            OmegaPunctuationKind::Exclamation ->
                begin_unary_expression(OmegaUnaryOperatorKind::LogicalNot)
            OmegaPunctuationKind::Tilde ->
                begin_unary_expression(OmegaUnaryOperatorKind::BitwiseNot)
            OmegaPunctuationKind::Minus ->
                begin_unary_expression(OmegaUnaryOperatorKind::Negate)
            _ -> incomplete_root()
        }
    }

    state begin_subjectless_transition() {
        self.transition_has_subject = 0;
        self.transition_subject_expression = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(61) }
    }

    state transition_subject_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfValue -> begin_self_transition_subject()
            OmegaKeywordKind::True -> begin_boolean_transition_subject(1)
            OmegaKeywordKind::False -> begin_boolean_transition_subject(0)
            _ -> incomplete_root()
        }
    }

    state begin_integer_transition_subject() {
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        transition true { true -> check_integer_expression() }
    }

    state begin_boolean_transition_subject(value: i32) {
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        transition true { true -> retain_boolean_expression(value) }
    }

    state begin_named_transition_subject() {
        self.argument_starts_at_self = 0;
        self.argument_name_member_count = 1;
        self.argument_path_kind = OmegaPathExpressionKind::Name;
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        transition true { true -> begin_path_expression() }
    }

    state begin_self_transition_subject() {
        self.argument_starts_at_self = 1;
        self.argument_name_member_count = 0;
        self.argument_path_kind = OmegaPathExpressionKind::SelfValue;
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        transition true { true -> begin_path_expression() }
    }

    state retain_transition_subject_handle() {
        self.expression_result = self.expression_count;
        self.expression_result_start =
            self.members[self.argument_first_path_member].start;
        self.expression_end = self.members[
            self.argument_first_path_member + self.argument_path_member_count - 1
        ].end;
        self.expression_count = self.expression_count + 1;
        transition true { true -> finish_framed_primary() }
    }

    state begin_unary_expression(operator: OmegaUnaryOperatorKind) {
        transition self.expression_prefix_count < 128 {
            true -> begin_unary_expression_bounded(operator)
            _ -> resource_failure(
                OmegaParserResource::ExpressionDepth,
                128,
                self.expression_prefix_count + 1
            )
        }
    }

    state begin_unary_expression_bounded(operator: OmegaUnaryOperatorKind) {
        self.expression_prefix_operators[self.expression_prefix_count] =
            operator;
        self.expression_prefix_operator_starts[self.expression_prefix_count] =
            self.scan.token_start;
        self.expression_prefix_operator_ends[self.expression_prefix_count] =
            self.scan.token_end;
        self.expression_prefix_count = self.expression_prefix_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_next_framed_operand() }
    }

    state finish_framed_primary() {
        transition self.expression_group_count > 0 {
            true -> finish_group_framed_primary()
            _ -> finish_root_framed_primary()
        }
    }

    state finish_group_framed_primary() {
        transition self.expression_prefix_count >
            self.expression_group_prefix_bases[
                self.expression_group_count - 1
            ] {
            true -> retain_unary_expression()
            _ -> retain_framed_expression_operand()
        }
    }

    state finish_root_framed_primary() {
        transition self.expression_prefix_count > 0 {
            true -> retain_unary_expression()
            _ -> retain_framed_expression_operand()
        }
    }

    state retain_unary_expression() {
        transition (self.expression_count < 16384) &&
            (self.unary_expression_count < 16384) {
            true -> retain_unary_expression_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_unary_expression_bounded() {
        self.unary_expressions[self.unary_expression_count].operator =
            self.expression_prefix_operators[self.expression_prefix_count - 1];
        self.unary_expressions[self.unary_expression_count].operator_start =
            self.expression_prefix_operator_starts[
                self.expression_prefix_count - 1
            ];
        self.unary_expressions[self.unary_expression_count].operator_end =
            self.expression_prefix_operator_ends[
                self.expression_prefix_count - 1
            ];
        self.unary_expressions[self.unary_expression_count].operand =
            self.expression_result;
        self.expressions[self.expression_count].kind = OmegaExpressionKind::Unary;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 =
            self.unary_expression_count;
        self.expressions[self.expression_count].payload1 = 0;
        self.expressions[self.expression_count].payload2 = 0;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.expression_result = self.expression_count;
        self.expression_result_start = self.expression_prefix_operator_starts[
            self.expression_prefix_count - 1
        ];
        self.expression_prefix_count = self.expression_prefix_count - 1;
        self.unary_expression_count = self.unary_expression_count + 1;
        self.expression_count = self.expression_count + 1;
        transition true { true -> finish_framed_primary() }
    }

    state retain_framed_expression_operand() {
        transition self.expression_frame_value_count < 128 {
            true -> retain_framed_expression_operand_bounded()
            _ -> resource_failure(
                OmegaParserResource::ExpressionDepth,
                128,
                self.expression_frame_value_count + 1
            )
        }
    }

    state retain_framed_expression_operand_bounded() {
        self.expression_frame_values[self.expression_frame_value_count] =
            self.expression_result;
        self.expression_frame_value_starts[self.expression_frame_value_count] =
            self.expression_result_start;
        self.expression_frame_value_ends[self.expression_frame_value_count] =
            self.expression_end;
        self.expression_frame_value_count = self.expression_frame_value_count + 1;
        transition true { true -> framed_expression_tail() }
    }

    state framed_expression_tail() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> framed_expression_tail_punctuation()
            OmegaTokenKind::Identifier -> framed_expression_tail_identifier()
            _ -> incomplete_root()
        }
    }

    state framed_expression_tail_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "in"
        ) {
            1 -> select_expression_membership()
            _ -> incomplete_root()
        }
    }

    state framed_expression_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> finish_left_brace_expression()
            OmegaPunctuationKind::Plus -> select_expression_add()
            OmegaPunctuationKind::Minus -> select_expression_subtract()
            OmegaPunctuationKind::Asterisk -> select_expression_multiply()
            OmegaPunctuationKind::Slash -> select_expression_divide()
            OmegaPunctuationKind::Percent -> select_expression_modulo()
            OmegaPunctuationKind::LessLess -> select_expression_shift_left()
            OmegaPunctuationKind::GreaterGreater -> select_expression_shift_right()
            OmegaPunctuationKind::Ampersand -> select_expression_bitwise_and()
            OmegaPunctuationKind::Pipe -> select_expression_bitwise_or()
            OmegaPunctuationKind::Caret -> select_expression_bitwise_xor()
            OmegaPunctuationKind::Semicolon -> finish_semicolon_expression()
            OmegaPunctuationKind::Comma -> finish_comma_expression()
            OmegaPunctuationKind::RightParen -> expression_right_parenthesis()
            OmegaPunctuationKind::EqualEqual -> select_expression_equal()
            OmegaPunctuationKind::ExclamationEqual -> select_expression_not_equal()
            OmegaPunctuationKind::Less -> select_expression_less()
            OmegaPunctuationKind::LessEqual -> select_expression_less_equal()
            OmegaPunctuationKind::Greater -> select_expression_greater()
            OmegaPunctuationKind::GreaterEqual ->
                select_expression_greater_equal()
            OmegaPunctuationKind::AndAnd -> select_expression_and()
            OmegaPunctuationKind::PipePipe -> select_expression_or()
            _ -> incomplete_root()
        }
    }

    state finish_left_brace_expression() {
        transition self.expression_group_count {
            0 -> finish_root_left_brace_expression()
            _ -> incomplete_root()
        }
    }

    state finish_root_left_brace_expression() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::TransitionSubject ->
                finish_framed_expression()
            _ -> incomplete_root()
        }
    }

    state finish_semicolon_expression() {
        transition self.expression_group_count {
            0 -> finish_root_semicolon_expression()
            _ -> incomplete_root()
        }
    }

    state finish_root_semicolon_expression() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::AssignmentValue ->
                finish_framed_expression()
            OmegaExpressionConsumer::LocalDataInitialValue ->
                finish_framed_expression()
            _ -> incomplete_root()
        }
    }

    state finish_comma_expression() {
        transition self.expression_group_count {
            0 -> finish_root_comma_expression()
            _ -> incomplete_root()
        }
    }

    state finish_root_comma_expression() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> finish_framed_expression()
            _ -> incomplete_root()
        }
    }

    state expression_right_parenthesis() {
        transition self.expression_group_count > 0 {
            true -> finish_group_expression()
            _ -> finish_outer_right_parenthesis_expression()
        }
    }

    state finish_outer_right_parenthesis_expression() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> finish_framed_expression()
            _ -> incomplete_root()
        }
    }

    state select_expression_membership() {
        self.expression_pending_precedence = 4;
        self.expression_pending_operator_start = self.scan.token_start;
        self.expression_pending_operator_end = self.scan.token_end;
        transition true { true -> reduce_expression_for_membership() }
