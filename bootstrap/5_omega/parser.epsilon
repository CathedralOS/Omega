    state type_reference_relaxed_or_type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "relaxed"
        ) {
            1 -> type_missing_failure(
                self.scan.token_start,
                self.scan.token_end
