    state retain_call_expression_path() {
        self.call_is_expression = 1;
        self.call_result_consumer = self.expression_consumer;
        self.call_first_path_member = self.argument_first_path_member;
        self.call_path_member_count = self.argument_path_member_count;
        self.call_starts_at_self = self.argument_starts_at_self;
        self.call_name_member_count = self.argument_name_member_count;
        self.call_start = self.members[self.argument_first_path_member].start;
