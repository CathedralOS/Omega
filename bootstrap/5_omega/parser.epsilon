            OmegaExpressionConsumer::LocalDataInitialValue ->
                check_call_expression_outer_frame()
            _ -> incomplete_root()
        }
    }

    state check_call_expression_outer_frame() {
        transition (self.expression_frame_value_count == 0) &&
            (self.expression_frame_operator_count == 0) &&
            (self.expression_group_count == 0) &&
            (self.expression_prefix_count == 0) {
            true -> retain_call_expression_path()
