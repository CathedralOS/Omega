    state retain_path_indexed_base() {
        self.indexed_result_consumer = self.expression_consumer;
        self.indexed_start =
            self.members[self.argument_first_path_member].start;
        self.indexed_is_value = 1;
        self.indexed_index_is_range_start = 0;
        self.indexed_range_has_start = 0;
        self.indexed_range_has_end = 0;
        self.indexed_range_end_inclusive = 0;
        self.indexed_range_parsing_end = 0;
        self.expression_consumer = OmegaExpressionConsumer::IndexedBase;
        transition true { true -> retain_path_expression() }
