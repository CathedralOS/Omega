            OmegaTypeConsumer::MachineReturn -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineReturnType,
                start,
                end
            )
            OmegaTypeConsumer::LocalData -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedLocalDataType,
                start,
                end
            )
            OmegaTypeConsumer::Cast -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCastType,
                start,
                end
            )
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldType,
                start,
                end
            )
        }
    }

    state type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "dyn"
        ) {
            1 -> incomplete_root()
            _ -> retain_type_name()
        }
    }

    state type_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> retain_type_self()
            OmegaKeywordKind::SelfValue -> incomplete_root()
            _ -> retain_type_name()
