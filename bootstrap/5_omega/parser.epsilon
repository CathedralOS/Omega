    state retain_type_self() {
        self.type_base_kind = OmegaTypeBaseKind::SelfType;
        self.type_end = self.scan.token_end;
        self.type_allows_range = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(14) }
