            OmegaExpressionConsumer::LocalDataInitialValue ->
                retain_path_expression_bounded()
            OmegaExpressionConsumer::CastValue ->
                retain_path_expression_bounded()
            OmegaExpressionConsumer::IndexedBase ->
                retain_path_expression_bounded()
            OmegaExpressionConsumer::IndexedIndex ->
                retain_path_expression_bounded()
            OmegaExpressionConsumer::TransitionPatternFieldValue ->
