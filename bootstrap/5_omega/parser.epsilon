    state type_reference_write_or_type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "write"
        ) {
            1 -> retain_type_reference_write_only()
            _ -> type_reference_relaxed_or_type_identifier()
        }
