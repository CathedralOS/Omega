            _ -> begin_type_reference()
        }
    }

    state type_reference_cast_depth() {
        transition self.type_array_depth == 0 {
            true -> incomplete_root()
            _ -> begin_type_reference()
        }
    }

    state begin_unit_type() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(40) }
    }

    state unit_type_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> unit_type_end_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state unit_type_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> retain_unit_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
