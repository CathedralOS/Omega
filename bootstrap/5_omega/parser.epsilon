        self.expressions[self.expression_count].payload0 = self.struct_literal_count;
        self.expressions[self.expression_count].payload1 = 0;
        self.expressions[self.expression_count].payload2 = 0;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
