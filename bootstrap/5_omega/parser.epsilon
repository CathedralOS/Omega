    }

    state array_unit_type_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> retain_array_unit_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
