            _ -> incomplete_root()
        }
    }

    state retain_index_range_start_path_bounded() {
        self.indexed_index_is_range_start = 1;
        transition true { true -> retain_path_expression() }
    }

    state path_expression_less() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::LocalDataInitialValue ->
                begin_call_expression_from_path()
            OmegaExpressionConsumer::TransitionSubject ->
                retain_framed_operator_path()
            OmegaExpressionConsumer::AssignmentValue ->
                retain_framed_operator_path()
            OmegaExpressionConsumer::CallArgument ->
                retain_framed_operator_path()
            _ -> incomplete_root()
        }
    }

    state begin_call_expression_from_path() {
