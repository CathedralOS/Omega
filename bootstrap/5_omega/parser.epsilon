            OmegaExpressionConsumer::ExpressionStatement ->
                retain_path_expression()
            OmegaExpressionConsumer::TransitionPatternFieldValue ->
                retain_path_expression()
            _ -> incomplete_root()
        }
    }

    state path_expression_left_brace() {
        transition self.expression_consumer {
