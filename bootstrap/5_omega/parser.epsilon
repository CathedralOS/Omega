    state push_indexed_expression_frame_bounded(continuation: i32) {
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].base_expression = self.indexed_base_expression;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].index_expression = self.indexed_index_expression;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].result_consumer = self.indexed_result_consumer;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].start = self.indexed_start;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].is_value = self.indexed_is_value;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].index_is_range_start = self.indexed_index_is_range_start;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_has_start = self.indexed_range_has_start;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_start_expression = self.indexed_range_start_expression;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_has_end = self.indexed_range_has_end;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_end_expression = self.indexed_range_end_expression;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_end_inclusive = self.indexed_range_end_inclusive;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_parsing_end = self.indexed_range_parsing_end;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_operator_start = self.indexed_range_operator_start;
        self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_operator_end = self.indexed_range_operator_end;
        self.indexed_expression_frame_count =
            self.indexed_expression_frame_count + 1;
        transition continuation {
            0 -> retain_path_indexed_base()
            _ -> begin_completed_indexed_value()
