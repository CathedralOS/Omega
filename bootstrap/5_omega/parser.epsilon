
// Canonical parser invocation for one immutable source view. The invocation
// performs the whole-view lexical judgment once, then streams that exact view
// through bounded scanner stages. State purposes select parser-local grammar
// positions; no purpose or preflight fact escapes this invocation.
//
// The retained syntax currently owns ordinary `use path::member;`, basic
// `[pub] data` roots, and `[pub]`/target-scoped machine roots with source-ordered
// states, state parameters, optional immediate return types, and bodies
// containing neutral path calls, simple assignments, or restricted transition
// blocks. Exact non-generic satisfies bindings and nonempty reach ceilings are
// retained on the same machine row. Data fields,
// parameters, and returns share named/Self/Unit, outer-reference with optional
// lifetime, domain-qualified, range-refined, and nested fixed-array/slice type
// syntax; parameters additionally retain their canonical
// simple modifiers, binding references, and receivers.
// Rich valid syntax stops as Incomplete rather than becoming a false Omega
// rejection. Later grammar slices extend this machine.
machine OmegaParser::parse_view(
    &mut self,
    source: &[u8]
) {
    self.root_count = 0;
    self.member_count = 0;
    self.use_count = 0;
    self.data_count = 0;
    self.machine_count = 0;
    self.machine_state_count = 0;
    self.machine_parameter_count = 0;
    self.machine_clause_count = 0;
    self.statement_count = 0;
    self.call_statement_count = 0;
    self.call_expression_count = 0;
    self.cast_expression_count = 0;
    self.assignment_statement_count = 0;
    self.local_data_statement_count = 0;
    self.transition_statement_count = 0;
    self.transition_pattern_field_count = 0;
    self.static_machine_argument_count = 0;
    self.expression_count = 0;
    self.binary_expression_count = 0;
    self.unary_expression_count = 0;
    self.indexed_expression_count = 0;
    self.range_expression_count = 0;
    self.call_argument_count = 0;
    self.struct_literal_count = 0;
    self.struct_literal_field_count = 0;
    self.data_member_count = 0;
    self.data_field_count = 0;
    self.data_payload_field_count = 0;
    self.data_case_count = 0;
    self.type_reference_count = 0;
    self.type_constraint_count = 0;
    self.cursor = 0;
    self.item_start = 0;
    self.first_member = 0;
    self.path_destination = OmegaPathDestination::Use;
    self.data_name_start = 0;
    self.data_name_end = 0;
    self.data_first_member = 0;
    self.data_first_field = 0;
    self.data_first_case = 0;
    self.data_is_public = 0;
    self.data_multiplicity = OmegaDataMultiplicity::Affine;
    self.type_subject_start = 0;
    self.type_subject_name_start = 0;
    self.type_subject_name_end = 0;
    self.type_consumer = OmegaTypeConsumer::DirectDataField;
    self.type_name_start = 0;
    self.type_name_end = 0;
    self.type_end = 0;
    self.type_constraint_mode = 0;
    self.type_domain_name_start = 0;
    self.type_domain_name_end = 0;
    self.type_range_minimum_start = 0;
    self.type_range_minimum_end = 0;
    self.type_range_maximum_start = 0;
    self.type_range_maximum_end = 0;
    self.type_root = 0;
    self.type_allows_range = 0;
    self.type_array_frame_count = 0;
    self.type_array_depth = 0;
    self.type_required_nodes = 0;
    self.type_array_emit_index = 0;
    self.case_start = 0;
    self.case_keyword_end = 0;
    self.case_name_start = 0;
    self.case_name_end = 0;
    self.case_body_end = 0;
    self.case_first_payload_field = 0;
    self.machine_first_state = 0;
    self.machine_first_clause = 0;
    self.state_first_parameter = 0;
    self.machine_parameter_has_more = 0;
    self.machine_path_member_count = 0;
    self.machine_is_public = 0;
    self.machine_has_target = 0;
    self.machine_target_start = 0;
    self.machine_target_end = 0;
    self.state_has_return_type = 0;
    self.state_return_type = 0;
    self.state_first_statement = 0;
    self.state_has_body_syntax = 0;
    self.state_is_explicit = 0;
    self.state_name_start = 0;
    self.state_name_end = 0;
    self.machine_clause_first_member = 0;
    self.machine_clause_first_view_member = 0;
    self.machine_clause_subject_member_count = 0;
    self.machine_clause_start = 0;
    self.machine_is_bodyless = 0;
    self.machine_parameter_is_const = 0;
    self.machine_parameter_is_leading_mutable = 0;
    self.machine_parameter_is_mutable = 0;
    self.machine_parameter_is_self = 0;
    self.machine_parameter_has_binding_reference = 0;
    self.machine_parameter_binding_access = OmegaReferenceAccess::Shared;
    self.type_base_kind = OmegaTypeBaseKind::Named;
    self.type_has_reference = 0;
    self.type_reference_access = OmegaReferenceAccess::Shared;
    self.type_reference_is_exclusive = 0;
    self.type_reference_has_lifetime = 0;
    self.type_reference_lifetime_start = 0;
    self.type_reference_lifetime_end = 0;
    self.statement_start = 0;
    self.statement_first_path_member = 0;
    self.statement_path_member_count = 0;
    self.statement_starts_at_self = 0;
    self.call_first_machine_argument = 0;
    self.call_first_argument = 0;
    self.call_is_expression = 0;
    self.call_result_consumer = OmegaExpressionConsumer::CallArgument;
    self.call_first_path_member = 0;
    self.call_path_member_count = 0;
    self.call_starts_at_self = 0;
    self.call_name_member_count = 0;
    self.call_start = 0;
    self.call_has_receiver = 0;
    self.call_receiver_expression = 0;
    self.static_argument_first_path_member = 0;
    self.static_argument_path_member_count = 0;
    self.static_argument_start = 0;
    self.argument_first_path_member = 0;
    self.argument_path_member_count = 0;
    self.argument_starts_at_self = 0;
    self.argument_name_member_count = 0;
    self.argument_path_kind = OmegaPathExpressionKind::Name;
    self.expression_consumer = OmegaExpressionConsumer::CallArgument;
    self.expression_result = 0;
    self.expression_result_start = 0;
    self.expression_end = 0;
    self.assignment_target_expression = 0;
    self.assignment_target_name_member_count = 0;
    self.assignment_target_path_kind = OmegaPathExpressionKind::Name;
    self.assignment_value_expression = 0;
    self.indexed_base_expression = 0;
    self.indexed_index_expression = 0;
    self.indexed_result_consumer = OmegaExpressionConsumer::LocalDataInitialValue;
    self.indexed_start = 0;
    self.indexed_is_value = 0;
    self.indexed_index_is_range_start = 0;
    self.indexed_range_has_start = 0;
    self.indexed_range_start_expression = 0;
    self.indexed_range_has_end = 0;
    self.indexed_range_end_expression = 0;
    self.indexed_range_end_inclusive = 0;
    self.indexed_range_parsing_end = 0;
    self.indexed_range_operator_start = 0;
    self.indexed_range_operator_end = 0;
    self.local_data_start = 0;
    self.local_data_name_start = 0;
    self.local_data_name_end = 0;
    self.local_data_is_mutable = 0;
    self.local_data_type_reference = 0;
    self.local_data_has_initial_value = 0;
    self.local_data_initial_value = 0;
    self.local_data_end = 0;
    self.cast_value_expression = 0;
    self.cast_result_consumer = OmegaExpressionConsumer::AssignmentValue;
    self.cast_start = 0;
    self.cast_type_reference = 0;
    self.cast_has_domain = 0;
    self.cast_domain_start = 0;
    self.cast_domain_end = 0;
    self.cast_end = 0;
    self.struct_literal_consumer = OmegaExpressionConsumer::CallArgument;
    self.struct_literal_first_type_member = 0;
    self.struct_literal_type_member_count = 0;
    self.struct_literal_first_field = 0;
    self.struct_literal_start = 0;
    self.struct_field_name_start = 0;
    self.struct_field_name_end = 0;
    self.struct_field_value = 0;
    self.struct_field_value_end = 0;
    self.transition_has_subject = 0;
    self.transition_subject_expression = 0;
    self.transition_guard_kind = OmegaTransitionGuardKind::Always;
    self.transition_guard_boolean = 0;
    self.transition_guard_start = 0;
    self.transition_guard_end = 0;
    self.transition_guard_first_path_member = 0;
    self.transition_guard_path_member_count = 0;
    self.transition_guard_first_pattern_field = 0;
    self.transition_guard_pattern_field_count = 0;
    self.transition_guard_has_rest = 0;
    self.transition_pattern_member_start = 0;
    self.transition_pattern_member_end = 0;
    self.transition_pattern_member = 0;
    self.transition_pattern_value_expression = 0;
    self.transition_arrow_start = 0;
    self.transition_arrow_end = 0;
    self.transition_target_start = 0;
    self.transition_target_end = 0;
    self.transition_first_argument = 0;
    self.expression_frame_value_count = 0;
    self.expression_frame_operator_count = 0;
    self.expression_group_count = 0;
    self.expression_prefix_count = 0;
    self.indexed_expression_frame_count = 0;
    self.expression_pending_operator = OmegaBinaryOperatorKind::Add;
    self.expression_pending_precedence = 0;
    self.expression_pending_operator_start = 0;
    self.expression_pending_operator_end = 0;
    self.membership_domain_active = 0;
    self.status = OmegaParserStatus::Parsing;
    self.diagnostic_code = OmegaParseDiagnosticCode::None;
    self.diagnostic_start = 0;
    self.diagnostic_end = 0;
    self.incomplete_start = 0;
    self.incomplete_end = 0;
    self.resource = OmegaParserResource::None;
    self.resource_limit = 0;
    self.resource_requested = 0;
    self.scan.validate_lexical(source);
    transition self.scan.accepted {
        1 -> scan_semantic(0)
        _ -> lexical_failure()
    }

    state lexical_failure() {
        transition self.scan.internal_failure {
            1 -> internal_failure()
            _ -> lexical_rejection()
        }
    }

    state lexical_rejection() {
        self.status = OmegaParserStatus::LexicalFailure;
        self.diagnostic_start = self.scan.diagnostic_start;
        self.diagnostic_end = self.scan.diagnostic_end;
    }

    // scan_preflighted_stage is public only because D17 has no private machine
    // visibility. Here it is authorized solely by validate_lexical above and
    // the same invocation-local source parameter.
    state scan_semantic(purpose: i32) {
        self.scan.scan_preflighted_stage(source, self.cursor);
        transition self.scan.accepted {
            1 -> scanned(purpose)
            _ -> internal_failure()
        }
    }

    state scanned(purpose: i32) {
        transition self.scan.has_token {
            1 -> token_progress(purpose)
            _ -> end_progress(purpose)
        }
    }

    state token_progress(purpose: i32) {
        transition (self.scan.token_start == self.cursor) &&
            (self.scan.token_end > self.cursor) &&
            (self.scan.token_end <= source.len) &&
            (self.scan.next_cursor > self.cursor) &&
            (self.scan.next_cursor <= source.len) {
            true -> token_advance_shape(purpose)
            _ -> internal_failure()
        }
    }

    state token_advance_shape(purpose: i32) {
        transition self.scan.token_end == self.scan.next_cursor {
            true -> trivia(purpose)
            _ -> line_comment_advance(purpose)
        }
    }

    // A line comment excludes its terminating LF from the token span but owns
    // that byte's advance. No other scanner token may hide a span/advance gap.
    state line_comment_advance(purpose: i32) {
        transition self.scan.token_kind {
            OmegaTokenKind::LineComment -> line_comment_extent(purpose)
            _ -> internal_failure()
        }
    }

    state line_comment_extent(purpose: i32) {
        transition (self.scan.token_end < source.len) &&
            (self.scan.next_cursor == self.scan.token_end + 1) {
            true -> line_comment_newline(purpose)
            _ -> internal_failure()
        }
    }

    state line_comment_newline(purpose: i32) {
        transition source[self.scan.token_end] {
            10 -> trivia(purpose)
            _ -> internal_failure()
        }
    }

    state end_progress(purpose: i32) {
        transition self.cursor == source.len {
            true -> end_of_view(purpose)
            _ -> internal_failure()
        }
    }

    state trivia(purpose: i32) {
        transition self.scan.token_kind {
            OmegaTokenKind::Whitespace -> advance_trivia(purpose)
            OmegaTokenKind::LineComment -> advance_trivia(purpose)
            OmegaTokenKind::BlockComment -> advance_trivia(purpose)
            _ -> semantic_token(purpose)
        }
    }

    state advance_trivia(purpose: i32) {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(purpose) }
    }

    state semantic_token(purpose: i32) {
        transition purpose {
            0 -> root_token()
            1 -> member_token()
            2 -> path_tail_token()
            3 -> public_root_token()
            4 -> data_name_token()
            5 -> data_body_token()
            6 -> data_property_token()
            7 -> data_property_end_token()
            8 -> data_body_after_property_token()
            9 -> data_member_token()
            10 -> case_marker_tail_token()
            11 -> case_end_token(1)
            12 -> field_colon_token()
            13 -> type_token()
            14 -> type_end_token()
            15 -> case_payload_token()
            16 -> case_end_token(0)
            17 -> type_domain_token()
            18 -> type_domain_end_token()
            19 -> type_range_minimum_token()
            20 -> type_range_operator_token()
            21 -> type_range_maximum_token()
            22 -> type_range_close_token()
            23 -> type_constraint_end_token()
            24 -> array_element_token()
            25 -> array_semicolon_token()
            26 -> array_length_token()
            27 -> array_end_token()
            28 -> machine_parameter_or_end_token()
            29 -> machine_header_end_token()
            30 -> state_body_token()
            31 -> machine_parameter_token()
            32 -> machine_parameter_colon_token()
            33 -> machine_parameter_after_const_token()
            34 -> machine_parameter_core_token()
            35 -> machine_binding_access_or_name_token()
            36 -> machine_binding_name_token()
            37 -> type_reference_access_or_type_token()
            38 -> target_machine_token()
            39 -> type_reference_lifetime_token()
            40 -> unit_type_end_token()
            41 -> array_unit_type_end_token()
            42 -> statement_path_tail_token()
            43 -> statement_path_member_token()
            44 -> call_argument_or_end_token()
            45 -> path_expression_tail_token()
            46 -> path_expression_member_token()
            47 -> call_semicolon_token()
            48 -> assignment_value_token()
            50 -> call_static_argument_token()
            51 -> call_static_argument_tail_token()
            52 -> call_static_argument_member_token()
            53 -> static_call_open_token()
            54 -> primary_expression_end_token()
            55 -> struct_literal_field_or_end_token()
            56 -> struct_literal_field_colon_token()
            57 -> struct_literal_field_value_token()
            58 -> explicit_state_name_token()
            59 -> explicit_state_header_token()
            60 -> transition_subject_token()
            61 -> transition_arm_token()
            62 -> transition_arrow_token()
            63 -> transition_target_token()
            64 -> transition_target_open_token()
            65 -> transition_target_argument_or_end_token()
            66 -> state_body_token()
            67 -> machine_member_token()
            68 -> satisfies_trait_token()
            69 -> satisfies_separator_token()
            70 -> satisfies_requirement_token()
            71 -> machine_clause_continuation_token()
            72 -> reach_service_token()
            73 -> reach_tail_token()
            74 -> indexed_index_token()
            75 -> indexed_expression_tail_token()
            76 -> local_data_name_token()
            77 -> local_data_name_after_mut_token()
            78 -> local_data_colon_token()
            79 -> local_data_initial_value_token()
            80 -> additive_call_argument_token()
            81 -> cast_domain_token()
            82 -> cast_end_token()
            83 -> transition_guard_path_tail_token()
            84 -> transition_guard_path_member_token()
            85 -> transition_destructure_field_or_end_token()
            86 -> transition_destructure_field_end_token()
            87 -> transition_destructure_rest_end_token()
            88 -> transition_pattern_field_value_token()
            89 -> external_binding_root_token()
            90 -> external_binding_separator_token()
            91 -> external_binding_case_token()
            92 -> external_leaf_end_token()
            93 -> termination_by_token()
            94 -> termination_subject_token()
            95 -> termination_subject_tail_token()
            96 -> termination_subject_member_token()
            97 -> termination_view_token()
            98 -> termination_view_tail_token()
            99 -> termination_view_member_token()
            100 -> indexed_range_end_token()
            101 -> membership_domain_token()
            102 -> membership_domain_tail_token()
            _ -> internal_failure()
        }
    }

    state end_of_view(purpose: i32) {
        transition purpose {
            0 -> complete()
            1 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathMember,
                source.len,
                source.len
            )
            2 -> path_end_at_view_end()
            3 -> incomplete_at_end()
            4 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataName,
                source.len,
                source.len
            )
            5 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                source.len,
                source.len
            )
            6 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataProperty,
                source.len,
                source.len
            )
            7 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPropertyEnd,
                source.len,
                source.len
            )
            8 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                source.len,
                source.len
            )
            9 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataMemberOrEnd,
                source.len,
                source.len
            )
            10 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseName,
                source.len,
                source.len
            )
            11 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                source.len,
                source.len
            )
            12 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldColon,
                source.len,
                source.len
            )
            13 -> type_missing_at_view_end()
            14 -> type_end_at_view_end()
            15 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPayloadFieldOrEnd,
                source.len,
                source.len
            )
            16 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                source.len,
                source.len
            )
            17 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeDomain,
                source.len,
                source.len
            )
            18 -> type_end_at_view_end()
            19 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeBound,
                source.len,
                source.len
            )
            20 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeOperator,
                source.len,
                source.len
            )
            21 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeBound,
                source.len,
                source.len
            )
            22 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeEnd,
                source.len,
                source.len
            )
            23 -> type_end_at_view_end()
            24 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayElementType,
                source.len,
                source.len
            )
            25 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArraySeparatorOrEnd,
                source.len,
                source.len
            )
            26 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayLength,
                source.len,
                source.len
            )
            27 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayEnd,
                source.len,
                source.len
            )
            28 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterOrEnd,
                source.len,
                source.len
            )
            29 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                source.len,
                source.len
            )
            30 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBodyEnd,
                source.len,
                source.len
            )
            31 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            32 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterColon,
                source.len,
                source.len
            )
            33 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            34 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            35 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            36 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            37 -> type_missing_at_view_end()
            38 -> incomplete_at_end()
            39 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedReferenceLifetime,
                source.len,
                source.len
            )
            40 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                source.len,
                source.len
            )
            41 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                source.len,
                source.len
            )
            42 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallPathTail,
                source.len,
                source.len
            )
            43 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedExpressionPathMember,
                source.len,
                source.len
            )
            44 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallArgument,
                source.len,
                source.len
            )
            45 -> path_expression_end_at_view_end()
            46 -> path_expression_member_end_at_view_end()
            47 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallSemicolon,
                source.len,
                source.len
            )
            48 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedAssignmentValue,
                source.len,
                source.len
            )
            50 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                source.len,
                source.len
            )
            51 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgumentEnd,
                source.len,
                source.len
            )
            52 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                source.len,
                source.len
            )
            53 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticCallOpen,
                source.len,
                source.len
            )
            54 -> primary_expression_end_at_view_end()
            55 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralFieldOrEnd,
                source.len,
                source.len
            )
            56 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralFieldColon,
                source.len,
                source.len
            )
            57 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralValue,
                source.len,
                source.len
            )
            58 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateName,
                source.len,
                source.len
            )
            59 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                source.len,
                source.len
            )
            60 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionSubject,
                source.len,
                source.len
            )
            61 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionArm,
                source.len,
                source.len
            )
            62 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionArrow,
                source.len,
                source.len
            )
            63 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionTarget,
                source.len,
                source.len
            )
            64 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionTargetOpen,
                source.len,
                source.len
            )
            65 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionTargetClose,
                source.len,
                source.len
            )
            66 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                source.len,
                source.len
            )
            67 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBodyEnd,
                source.len,
                source.len
            )
            68 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedSatisfiesTrait,
                source.len,
                source.len
            )
            69 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedSatisfiesRequirement,
                source.len,
                source.len
            )
            70 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedSatisfiesRequirement,
                source.len,
                source.len
            )
            71 -> syntax_failure(
