    state field_colon_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> field_colon_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state field_colon_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Colon -> begin_type()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldColon,
                self.scan.token_start,
                self.scan.token_end
