        self.indexed_range_end_expression = 0;
        self.indexed_range_parsing_end = 0;
        self.indexed_range_operator_start = self.scan.token_start;
        self.indexed_range_operator_end = self.scan.token_end;
        transition self.scan.punctuation {
            OmegaPunctuationKind::DotDot -> begin_exclusive_index_range()
            OmegaPunctuationKind::DotDotEqual -> begin_inclusive_index_range()
            _ -> internal_failure()
        }
    }

    state begin_exclusive_index_range() {
        self.indexed_range_end_inclusive = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(100) }
    }

    state begin_inclusive_index_range() {
        self.indexed_range_end_inclusive = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(100) }
    }

    state indexed_range_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> indexed_range_end_punctuation()
            OmegaTokenKind::Identifier -> begin_index_range_named_end()
            OmegaTokenKind::Integer -> begin_index_range_integer_end()
            OmegaTokenKind::Keyword -> indexed_range_end_keyword()
            _ -> incomplete_root()
        }
    }

    state indexed_range_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBracket -> retain_absent_index_range_end()
            _ -> incomplete_root()
        }
    }

    state indexed_range_end_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfValue -> begin_index_range_self_end()
            _ -> incomplete_root()
        }
    }

    state begin_index_range_named_end() {
        self.indexed_range_parsing_end = 1;
        transition true { true -> begin_named_index() }
    }

    state begin_index_range_integer_end() {
        self.indexed_range_parsing_end = 1;
        transition true { true -> begin_integer_index() }
    }

    state begin_index_range_self_end() {
        self.indexed_range_parsing_end = 1;
        transition true { true -> begin_self_index() }
    }

    state retain_absent_index_range_end() {
        transition self.indexed_range_end_inclusive {
            1 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedIndexedRangeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_index_range()
        }
    }

    state retain_index_range() {
        transition (self.expression_count < 16384) &&
            (self.range_expression_count < 16384) {
            true -> retain_index_range_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_index_range_bounded() {
        self.range_expressions[self.range_expression_count].has_start =
            self.indexed_range_has_start;
        self.range_expressions[self.range_expression_count].start =
            self.indexed_range_start_expression;
        self.range_expressions[self.range_expression_count].has_end =
            self.indexed_range_has_end;
        self.range_expressions[self.range_expression_count].end =
            self.indexed_range_end_expression;
        self.range_expressions[self.range_expression_count].end_inclusive =
            self.indexed_range_end_inclusive;
        self.range_expressions[self.range_expression_count].operator_start =
            self.indexed_range_operator_start;
        self.range_expressions[self.range_expression_count].operator_end =
            self.indexed_range_operator_end;
        self.expression_result = self.expression_count;
        self.expression_result_start = self.indexed_range_operator_start;
        self.expression_end = self.indexed_range_operator_end;
        self.expressions[self.expression_count].kind = OmegaExpressionKind::Range;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 =
            self.range_expression_count;
        self.expressions[self.expression_count].payload1 = 0;
        self.expressions[self.expression_count].payload2 = 0;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.range_expression_count = self.range_expression_count + 1;
        self.expression_count = self.expression_count + 1;
        self.indexed_index_expression = self.expression_result;
        transition true { true -> retain_indexed_expression_capacity() }
    }

    state retain_indexed_expression() {
        self.indexed_expressions[self.indexed_expression_count].base =
            self.indexed_base_expression;
        self.indexed_expressions[self.indexed_expression_count].index =
            self.indexed_index_expression;
        self.indexed_expressions[self.indexed_expression_count].start =
            self.indexed_start;
        self.indexed_expressions[self.indexed_expression_count].end =
            self.scan.token_end;
        self.expression_result = self.expression_count;
        self.expression_result_start = self.indexed_start;
        self.expression_end = self.scan.token_end;
        self.expressions[self.expression_count].kind =
            OmegaExpressionKind::Indexed;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 =
            self.indexed_expression_count;
        self.expressions[self.expression_count].payload1 = 0;
        self.expressions[self.expression_count].payload2 = 0;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.indexed_expression_count = self.indexed_expression_count + 1;
        self.expression_count = self.expression_count + 1;
        self.cursor = self.scan.next_cursor;
        transition self.indexed_is_value {
            1 -> resume_indexed_value()
            _ -> scan_semantic(75)
        }
    }

    state resume_indexed_value() {
        transition self.indexed_expression_frame_count {
            0 -> resume_outermost_indexed_value()
            _ -> resume_nested_indexed_value()
        }
    }

    state resume_outermost_indexed_value() {
        self.expression_consumer = self.indexed_result_consumer;
        transition true { true -> scan_semantic(54) }
    }

    state resume_nested_indexed_value() {
        self.indexed_expression_frame_count =
            self.indexed_expression_frame_count - 1;
        self.indexed_base_expression = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].base_expression;
        self.indexed_index_expression = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].index_expression;
        self.indexed_result_consumer = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].result_consumer;
        self.indexed_start = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].start;
        self.indexed_is_value = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].is_value;
        self.indexed_index_is_range_start = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].index_is_range_start;
        self.indexed_range_has_start = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_has_start;
        self.indexed_range_start_expression = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_start_expression;
        self.indexed_range_has_end = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_has_end;
        self.indexed_range_end_expression = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_end_expression;
        self.indexed_range_end_inclusive = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_end_inclusive;
        self.indexed_range_parsing_end = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_parsing_end;
        self.indexed_range_operator_start = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_operator_start;
        self.indexed_range_operator_end = self.indexed_expression_frames[
            self.indexed_expression_frame_count
        ].range_operator_end;
        self.expression_consumer = OmegaExpressionConsumer::IndexedIndex;
        transition true { true -> scan_semantic(54) }
    }

    state indexed_expression_tail_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> indexed_expression_tail_punctuation()
            _ -> incomplete_root()
        }
    }

    state indexed_expression_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBracket -> begin_postfix_indexed_expression()
            OmegaPunctuationKind::Equal -> begin_indexed_assignment_value()
            OmegaPunctuationKind::RightBrace -> retain_expression_statement()
            _ -> incomplete_root()
        }
    }

    state begin_postfix_indexed_expression() {
        self.indexed_base_expression = self.expression_result;
        self.indexed_start = self.expression_result_start;
        self.indexed_index_is_range_start = 0;
        self.indexed_range_has_start = 0;
        self.indexed_range_start_expression = 0;
        self.indexed_range_has_end = 0;
        self.indexed_range_end_expression = 0;
        self.indexed_range_end_inclusive = 0;
        self.indexed_range_parsing_end = 0;
        self.expression_consumer = OmegaExpressionConsumer::IndexedIndex;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(74) }
    }

    state begin_indexed_assignment_value() {
        self.assignment_target_expression = self.expression_result;
        self.expression_consumer = OmegaExpressionConsumer::AssignmentValue;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(48) }
    }

    state retain_expression_statement() {
        transition self.statement_count < 16384 {
            true -> retain_expression_statement_bounded()
            _ -> resource_failure(
                OmegaParserResource::Statements,
                16384,
                self.statement_count + 1
            )
        }
    }

    state retain_expression_statement_bounded() {
        self.statements[self.statement_count].kind =
            OmegaStatementKind::Expression;
        self.statements[self.statement_count].item_index = self.expression_result;
        self.statement_count = self.statement_count + 1;
        transition true { true -> finish_current_state() }
    }

    state begin_call_static_arguments() {
        transition (self.call_starts_at_self == 0) ||
            (self.call_path_member_count > 1) {
            true -> scan_first_call_static_argument()
            _ -> incomplete_root()
        }
    }

    state scan_first_call_static_argument() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(50) }
    }

    state call_static_argument_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> begin_call_static_argument()
            OmegaTokenKind::Keyword -> call_static_argument_keyword()
            _ -> incomplete_root()
        }
    }

    state call_static_argument_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> incomplete_root()
            OmegaKeywordKind::SelfValue -> incomplete_root()
            _ -> begin_call_static_argument()
        }
    }

    state begin_call_static_argument() {
        self.static_argument_first_path_member = self.member_count;
        self.static_argument_path_member_count = 0;
        self.static_argument_start = self.scan.token_start;
        transition true { true -> retain_call_static_argument_member() }
    }

    state retain_call_static_argument_member() {
        transition self.member_count < 16384 {
            true -> retain_call_static_argument_member_bounded()
            _ -> resource_failure(
                OmegaParserResource::PathMembers,
                16384,
                self.member_count + 1
            )
        }
    }

    state retain_call_static_argument_member_bounded() {
        self.members[self.member_count].start = self.scan.token_start;
        self.members[self.member_count].end = self.scan.token_end;
        self.member_count = self.member_count + 1;
        self.static_argument_path_member_count =
            self.static_argument_path_member_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(51) }
    }

    state call_static_argument_tail_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> call_static_argument_tail_punctuation()
            _ -> incomplete_root()
        }
    }

    state call_static_argument_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::ColonColon -> next_call_static_argument_member()
            OmegaPunctuationKind::Comma -> retain_call_static_argument()
            OmegaPunctuationKind::Greater -> retain_call_static_argument()
            _ -> incomplete_root()
        }
    }

    state next_call_static_argument_member() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(52) }
    }

    state call_static_argument_member_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_call_static_argument_member()
            OmegaTokenKind::Keyword -> call_static_argument_member_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state call_static_argument_member_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_call_static_argument_member()
        }
    }

    state retain_call_static_argument() {
        transition true { true -> retain_call_static_argument_bounded() }
    }

    state retain_call_static_argument_bounded() {
        self.static_machine_arguments[self.static_machine_argument_count].kind =
            OmegaStaticMachineArgumentKind::Path;
        self.static_machine_arguments[
            self.static_machine_argument_count
        ].first_path_member = self.static_argument_first_path_member;
        self.static_machine_arguments[
            self.static_machine_argument_count
        ].path_member_count = self.static_argument_path_member_count;
        self.static_machine_arguments[self.static_machine_argument_count].start =
            self.static_argument_start;
        self.static_machine_arguments[self.static_machine_argument_count].end =
            self.members[self.member_count - 1].end;
        self.static_machine_arguments[self.static_machine_argument_count].payload0 = 0;
        self.static_machine_arguments[self.static_machine_argument_count].payload1 = 0;
        self.static_machine_argument_count =
            self.static_machine_argument_count + 1;
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> next_call_static_argument()
            OmegaPunctuationKind::Greater -> finish_call_static_arguments()
            _ -> internal_failure()
        }
    }

    state next_call_static_argument() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(50) }
    }

    state finish_call_static_arguments() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(53) }
    }

    state static_call_open_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> static_call_open_punctuation()
            _ -> incomplete_root()
        }
    }

    state static_call_open_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftParen -> begin_call_arguments()
            _ -> incomplete_root()
        }
    }

    state call_target_available() {
        transition (self.call_starts_at_self == 0) ||
            (self.call_path_member_count > 1) {
            true -> begin_call_arguments()
            _ -> incomplete_root()
        }
    }

    state next_statement_path_member() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(43) }
    }

    state statement_path_member_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_statement_path_member()
            OmegaTokenKind::Keyword -> statement_path_member_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedExpressionPathMember,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state statement_path_member_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedExpressionPathMember,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedExpressionPathMember,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_statement_path_member()
        }
    }

    state begin_call_arguments() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(44) }
    }

    state call_argument_or_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> call_argument_or_end_punctuation()
            OmegaTokenKind::Identifier -> begin_named_call_argument()
            OmegaTokenKind::Integer -> begin_call_integer_argument()
            OmegaTokenKind::StringLiteral -> begin_call_string_argument()
            OmegaTokenKind::Keyword -> call_argument_or_end_keyword()
            _ -> incomplete_root()
        }
    }

    state call_argument_or_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> finish_call_arguments()
            OmegaPunctuationKind::LeftParen -> begin_first_grouped_call_argument()
            OmegaPunctuationKind::Exclamation ->
                begin_first_unary_call_argument(OmegaUnaryOperatorKind::LogicalNot)
            OmegaPunctuationKind::Tilde ->
                begin_first_unary_call_argument(OmegaUnaryOperatorKind::BitwiseNot)
            OmegaPunctuationKind::Minus ->
                begin_first_unary_call_argument(OmegaUnaryOperatorKind::Negate)
            _ -> incomplete_root()
        }
    }

    state begin_first_grouped_call_argument() {
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> begin_expression_group() }
    }

    state begin_first_unary_call_argument(operator: OmegaUnaryOperatorKind) {
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> begin_unary_expression(operator) }
    }

    state call_argument_or_end_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> incomplete_root()
            OmegaKeywordKind::SelfValue -> begin_self_call_argument()
            OmegaKeywordKind::True -> begin_call_true_argument()
            OmegaKeywordKind::False -> begin_call_false_argument()
            _ -> begin_named_call_argument()
        }
    }

    state begin_call_true_argument() {
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> retain_boolean_expression(1) }
    }

    state begin_call_false_argument() {
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> retain_boolean_expression(0) }
    }

    state begin_call_integer_argument() {
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> check_integer_expression() }
    }

    state begin_call_string_argument() {
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> retain_string_expression() }
    }

    state begin_named_call_argument() {
        self.argument_starts_at_self = 0;
        self.argument_name_member_count = 1;
        self.argument_path_kind = OmegaPathExpressionKind::Name;
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> begin_path_expression() }
    }

    state begin_self_call_argument() {
        self.argument_starts_at_self = 1;
        self.argument_name_member_count = 0;
        self.argument_path_kind = OmegaPathExpressionKind::SelfValue;
        self.expression_consumer = OmegaExpressionConsumer::CallArgument;
        self.expression_frame_value_count = 0;
        self.expression_frame_operator_count = 0;
        self.expression_group_count = 0;
        self.expression_prefix_count = 0;
        transition true { true -> begin_path_expression() }
    }

    state begin_path_expression() {
        self.argument_first_path_member = self.member_count;
        self.argument_path_member_count = 0;
        transition true { true -> retain_path_expression_member() }
    }

    state retain_path_expression_member() {
        transition self.member_count < 16384 {
            true -> retain_path_expression_member_bounded()
            _ -> resource_failure(
                OmegaParserResource::PathMembers,
                16384,
                self.member_count + 1
            )
        }
    }

    state retain_path_expression_member_bounded() {
        self.members[self.member_count].start = self.scan.token_start;
        self.members[self.member_count].end = self.scan.token_end;
        self.member_count = self.member_count + 1;
        self.argument_path_member_count = self.argument_path_member_count + 1;
        self.cursor = self.scan.next_cursor;
        transition self.membership_domain_active {
            1 -> scan_semantic(102)
            _ -> scan_semantic(45)
        }
    }

    state path_expression_tail_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> path_expression_tail_punctuation()
            OmegaTokenKind::Identifier -> path_expression_tail_identifier()
            OmegaTokenKind::Keyword -> path_expression_tail_keyword()
            _ -> incomplete_root()
        }
    }

    state path_expression_tail_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "in"
        ) {
            1 -> retain_framed_operator_path()
            _ -> incomplete_root()
        }
    }

    state path_expression_tail_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::As -> begin_path_cast()
            _ -> incomplete_root()
        }
    }

    state begin_path_cast() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::AssignmentValue -> retain_path_cast_value()
            OmegaExpressionConsumer::LocalDataInitialValue -> retain_path_cast_value()
            OmegaExpressionConsumer::CallArgument -> retain_path_cast_value()
            OmegaExpressionConsumer::TransitionTargetArgument ->
                retain_path_cast_value()
            _ -> incomplete_root()
        }
    }

    state retain_path_cast_value() {
        self.cast_result_consumer = self.expression_consumer;
        self.cast_start = self.members[self.argument_first_path_member].start;
        self.cast_has_domain = 0;
        self.cast_domain_start = 0;
        self.cast_domain_end = 0;
        self.expression_consumer = OmegaExpressionConsumer::CastValue;
        transition true { true -> retain_path_expression() }
    }

    state path_expression_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Dot -> path_expression_member_access()
            OmegaPunctuationKind::ColonColon -> path_expression_name_qualification()
            OmegaPunctuationKind::LeftBrace -> path_expression_left_brace()
            OmegaPunctuationKind::Comma -> retain_comma_terminated_path()
            OmegaPunctuationKind::RightParen ->
                retain_right_parenthesis_terminated_path()
            OmegaPunctuationKind::RightBrace ->
                retain_right_brace_terminated_path()
            OmegaPunctuationKind::RightBracket ->
                retain_index_path()
            OmegaPunctuationKind::LeftParen -> begin_call_expression_from_path()
            OmegaPunctuationKind::LeftBracket -> begin_path_indexed_expression()
            OmegaPunctuationKind::DotDot -> retain_index_range_start_path()
            OmegaPunctuationKind::DotDotEqual -> retain_index_range_start_path()
            OmegaPunctuationKind::Semicolon -> retain_additive_value_path()
            OmegaPunctuationKind::Plus -> retain_framed_operator_path()
            OmegaPunctuationKind::Minus -> retain_framed_operator_path()
            OmegaPunctuationKind::Asterisk -> retain_framed_operator_path()
            OmegaPunctuationKind::Slash -> retain_framed_operator_path()
            OmegaPunctuationKind::Percent -> retain_framed_operator_path()
            OmegaPunctuationKind::LessLess -> retain_framed_operator_path()
            OmegaPunctuationKind::GreaterGreater -> retain_framed_operator_path()
            OmegaPunctuationKind::Ampersand -> retain_framed_operator_path()
            OmegaPunctuationKind::Pipe -> retain_framed_operator_path()
            OmegaPunctuationKind::Caret -> retain_framed_operator_path()
            OmegaPunctuationKind::EqualEqual -> retain_framed_operator_path()
            OmegaPunctuationKind::ExclamationEqual ->
                retain_framed_operator_path()
            OmegaPunctuationKind::Less -> path_expression_less()
            OmegaPunctuationKind::LessEqual -> retain_framed_operator_path()
            OmegaPunctuationKind::Greater -> retain_framed_operator_path()
            OmegaPunctuationKind::GreaterEqual -> retain_framed_operator_path()
            OmegaPunctuationKind::AndAnd -> retain_framed_operator_path()
            OmegaPunctuationKind::PipePipe -> retain_framed_operator_path()
            _ -> incomplete_root()
        }
    }

    state begin_path_indexed_expression() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument ->
                retain_path_indexed_base()
            OmegaExpressionConsumer::AssignmentValue ->
                retain_path_indexed_base()
            OmegaExpressionConsumer::TransitionSubject ->
                retain_path_indexed_base()
            OmegaExpressionConsumer::LocalDataInitialValue ->
                retain_path_indexed_base()
            OmegaExpressionConsumer::TransitionTargetArgument ->
                retain_path_indexed_base()
            OmegaExpressionConsumer::IndexedIndex ->
                push_indexed_expression_frame(0)
            _ -> incomplete_root()
