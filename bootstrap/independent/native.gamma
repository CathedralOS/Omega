; Direct Linux x86-64 assembler for the Gamma compiler.
; r14 owns 256 word registers on the process stack; r15 owns the anonymous
; 128-GiB Gamma memory reservation. Scratch host registers never hold language
; values across instructions. Native calls use the separately bounded stack.
; Byte constants below are little-endian x86 instructions, not an Alpha VM.

; Each register access has a three-byte opcode followed by a four-byte
; displacement (reg * 8) into r14's register slots.
(def n_register ((s Int) (opcode Int) (reg Int)) Int
  (i_field s 7 (+ opcode (* 16777216 (* reg 8)))))
(def n_load_a ((s Int) (reg Int)) Int (n_register s 8817481 reg)) ; 49 8b 86
(def n_load_b ((s Int) (reg Int)) Int (n_register s 10390345 reg)) ; 49 8b 9e
(def n_store ((s Int) (reg Int)) Int (n_register s 8816969 reg)) ; 49 89 86

; x86 adds the signed displacement to the address after its four-byte field.
; The target's suffix and the bytes following the field share the same code end.
; The entire emitted image fits in 128 MiB, inside signed rel32 reach.
(def i_target_width () Int 4)
(def i_target_value ((size Int) (following Int) (suffix Int)) Int (- following suffix))
(def i_jmp ((s Int) (label Int)) Int (i_address (i_field s 1 233) label)) ; e9 rel32
(def i_call ((s Int) (label Int)) Int (i_address (i_field s 1 232) label)) ; e8 rel32
(def i_ret ((s Int)) Int (i_field s 1 195)) ; c3

; read(0,rsp,1); EOF yields -1; OS read failure exits3.
(def i_read ((s Int) (reg Int)) Int
  (let (
    (v0 Int (i_field s 8 18388690070366094152)) ; 48 83 ec 08 31 c0 31 ff
    (v1 Int (i_field v0 8 7430637896)) ; 48 89 e6 ba 01 00 00 00
    (v2 Int (i_field v1 8 13766512028741534991)) ; 0f 05 48 85 c0 79 0c bf
    (v3 Int (i_field v2 8 66760971649027)) ; 03 00 00 00 b8 3c 00 00
    (v4 Int (i_field v3 8 14359939090542300928)) ; 00 0f 05 48 85 c0 48 c7
    (v5 Int (i_field v4 8 1082118453336211392)) ; c0 ff ff ff ff 74 04 0f
    (v6 Int (i_field v5 7 2467867943765174)) ; b6 04 24 48 83 c4 08
  ) (n_store v6 reg)))

; write(1,rsp,1); short/error write exits3. Gamma publication was validated before flush.
(def i_write ((s Int) (reg Int)) Int
  (let (
    (loaded Int (n_load_a s reg))
    (v0 Int (i_field loaded 8 13268735384452105032)) ; 48 83 ec 08 88 04 24 b8
    (v1 Int (i_field v0 8 1919850381313)) ; 01 00 00 00 bf 01 00 00
    (v2 Int (i_field v1 8 1902243301376)) ; 00 48 89 e6 ba 01 00 00
    (v3 Int (i_field v2 8 8359235626109046528)) ; 00 0f 05 48 83 f8 01 74
    (v4 Int (i_field v3 8 4375247037990682380)) ; 0c bf 03 00 00 00 b8 3c
    (v5 Int (i_field v4 8 14160240839946665984)) ; 00 00 00 0f 05 48 83 c4
    (v6 Int (i_field v5 1 8)) ; 08
  ) v6))

; mov rdi,rax; mov eax,60; syscall
(def i_halt ((s Int) (reg Int)) Int
  (i_field (i_field (n_load_a s reg) 8 260798122312) 2 1295))

(def i_imm ((s Int) (reg Int) (value Int)) Int
  (n_store (i_field (i_field s 2 47176) 8 value) reg)) ; 48 b8 imm64
(def i_mov ((s Int) (dst Int) (src Int)) Int
  (n_store (n_load_a s src) dst))

; Arithmetic operates on rax and rbx, then writes the result to a's slot.
(def n_operands ((s Int) (a Int) (b Int)) Int
  (n_load_b (n_load_a s a) b))
(def i_add ((s Int) (a Int) (b Int)) Int
  (n_store (i_field (n_operands s a b) 3 14156104) a)) ; 48 01 d8
(def i_sub ((s Int) (a Int) (b Int)) Int
  (n_store (i_field (n_operands s a b) 3 14166344) a)) ; 48 29 d8
(def i_mul ((s Int) (a Int) (b Int)) Int
  (n_store (i_field (n_operands s a b) 4 3283029832) a)) ; 48 0f af c3

; cqo; idiv rbx. Shared lowering has already checked both traps.
(def n_divide ((s Int) (a Int) (b Int)) Int
  (i_field (n_operands s a b) 5 1082185521480)) ; 48 99 48 f7 fb
(def i_div ((s Int) (a Int) (b Int)) Int (n_store (n_divide s a b) a))
(def i_mod ((s Int) (a Int) (b Int)) Int
  (n_store (i_field (n_divide s a b) 3 13666632) a)) ; 48 89 d0

; r15 owns flat memory. rbx holds its offset, rax the transferred value.
(def i_loadb ((s Int) (dst Int) (addr Int)) Int
  (n_store (i_field (n_load_b s addr) 5 133223026497) dst)) ; 41 0f b6 04 1f
(def i_load ((s Int) (dst Int) (addr Int)) Int
  (n_store (i_field (n_load_b s addr) 4 520391497) dst)) ; 49 8b 04 1f
(def i_storeb ((s Int) (addr Int) (src Int)) Int
  (i_field (n_load_a (n_load_b s addr) src) 4 520390721)) ; 41 88 04 1f
(def i_store ((s Int) (addr Int) (src Int)) Int
  (i_field (n_load_a (n_load_b s addr) src) 4 520390985)) ; 49 89 04 1f

; Branch directly on the flags from test rax,rax or cmp rax,rbx.
(def n_test_zero ((s Int) (reg Int)) Int
  (i_field (n_load_a s reg) 3 12617032)) ; 48 85 c0
(def n_compare ((s Int) (a Int) (b Int)) Int
  (i_field (n_operands s a b) 3 14170440)) ; 48 39 d8
(def i_jz ((s Int) (reg Int) (label Int)) Int
  (i_address (i_field (n_test_zero s reg) 2 33807) label)) ; 0f 84 rel32
(def i_jnz ((s Int) (reg Int) (label Int)) Int
  (i_address (i_field (n_test_zero s reg) 2 34063) label)) ; 0f 85 rel32
(def i_jlt ((s Int) (a Int) (b Int) (label Int)) Int
  (i_address (i_field (n_compare s a b) 2 35855) label)) ; 0f 8c rel32
(def i_jeq ((s Int) (a Int) (b Int) (label Int)) Int
  (i_address (i_field (n_compare s a b) 2 33807) label)) ; 0f 84 rel32

; Reserve/zero register slots; mmap 128 GiB; fail with status3 on mmap error.
(def n_start () Int
  (let (
    (v0 Int (i_word 5260204399143977288 8)) ; 48 81 ec 00 08 00 00 49
    (v1 Int (i_word 282272770156169 8)) ; 89 e6 31 c0 b9 00 01 00
    (v2 Int (i_word 13306809736395048960 8)) ; 00 48 89 e7 f3 48 ab b8
    (v3 Int (i_word 13711489651447955465 8)) ; 09 00 00 00 31 ff 48 be
    (v4 Int (i_word 137438953472 8)) ; 00 00 00 00 20 00 00 00
    (v5 Int (i_word 2502384011213538234 8)) ; ba 03 00 00 00 41 ba 22
    (v6 Int (i_word 18446674560888602688 8)) ; 40 00 00 49 c7 c0 ff ff
    (v7 Int (i_word 5189571502403878911 8)) ; ff ff 45 31 c9 0f 05 48
    (v8 Int (i_word 13262664396488835389 8)) ; 3d 01 f0 ff ff 72 0e b8
    (v9 Int (i_word 4375466429214883843 8)) ; 03 00 00 00 89 c7 b8 3c
    (v10 Int (i_word 14378103571432341504 8)) ; 00 00 00 0f 05 49 89 c7
  ) 0))

; ELF64 ET_EXEC, one read/execute PT_LOAD; entry0x400080. No host linker/loader interpreter.
(def n_header ((size Int)) Int
  (let (
    (v0 Int (i_word 282584257676671 8)) ; 7f 45 4c 46 02 01 01 00
    (v1 Int (i_word 0 8)) ; 00 00 00 00 00 00 00 00
    (v2 Int (i_word 4299030530 8)) ; 02 00 3e 00 01 00 00 00
    (v3 Int (i_word 4194432 8)) ; 80 00 40 00 00 00 00 00
    (v4 Int (i_word 64 8)) ; 40 00 00 00 00 00 00 00
    (v5 Int (i_word 0 8)) ; 00 00 00 00 00 00 00 00
    (v6 Int (i_word 15762873573703680 8)) ; 00 00 00 00 40 00 38 00
    (v7 Int (i_word 1 8)) ; 01 00 00 00 00 00 00 00
    (v8 Int (i_word 21474836481 8)) ; 01 00 00 00 05 00 00 00
    (v9 Int (i_word 0 8)) ; 00 00 00 00 00 00 00 00
    (v10 Int (i_word 4194304 8)) ; 00 00 40 00 00 00 00 00
    (v11 Int (i_word 4194304 8)) ; 00 00 40 00 00 00 00 00
    (v12 Int (i_word (+ size 216) 8))
    (v13 Int (i_word (+ size 216) 8))
    (v14 Int (i_word 4096 8)) ; 00 10 00 00 00 00 00 00
    (v15 Int (i_word 0 8)) ; 00 00 00 00 00 00 00 00
  ) 0))

; Buffered publication owns 128 MiB, including header and startup.
(def i_limit () Int 134217513)

(def i_publish ((fields Int) (size Int) (labels Int)) Int
  (if (lt size (i_limit))
    (let ((header Int (n_header size)) (startup Int (n_start)))
      (i_output fields size labels size))
    (pair 254 0)))
