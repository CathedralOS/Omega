; This compiler stage consumes the existing complete Epsilon checking judgment.
; Its one outcome distinguishes invalid source, valid unsupported lowering and
; contradictions. No partial function text is published on any failure.
(def epsilon_delta_append ((left EpsilonDeltaCompilation)
  (right EpsilonDeltaCompilation)) EpsilonDeltaCompilation
  (match left
    ((EpsilonDeltaCompiled firstText)
      (match right
        ((EpsilonDeltaCompiled secondText)
          (EpsilonDeltaCompiled (bytes_concat firstText secondText)))
        ((EpsilonDeltaRejected reason offset) right)
        ((EpsilonDeltaUnsupported offset) right)
        ((EpsilonDeltaInternal offset) right)))
    ((EpsilonDeltaRejected reason offset) left)
    ((EpsilonDeltaUnsupported offset) left)
    ((EpsilonDeltaInternal offset) left)))

(def epsilon_delta_compile ((source Bytes)) EpsilonDeltaCompilation
  (let view EpsilonSourceView (epsilon_source_whole source)
    (match (epsilon_check_through_body_view view)
      ((EpsilonLocalResolutionRejected reason offset)
        (EpsilonDeltaRejected reason offset))
      ((EpsilonLocalResolutionInternal offset) (EpsilonDeltaInternal offset))
      ((EpsilonLocalResolutionAccepted resolved)
        (match resolved
          ((EpsilonLocallyResolvedProgramSyntax cataloged locals fields callables
            control types candidate)
            (match cataloged
              ((EpsilonCatalogedProgramSyntax formed catalogState)
                (match formed
                  ((EpsilonFormedProgramSyntax collected shapes edges)
                    (match collected
                      ((EpsilonCollectedProgramSyntax program owners machines)
                        (match program
                          ((EpsilonSyntaxProgram start end declarations)
                            (epsilon_delta_declarations view declarations locals
                              fields callables control)))))))))))))))

(def epsilon_delta_declarations
  ((source EpsilonSourceView) (declarations EpsilonDeclarationList)
   (locals EpsilonResolvedLocalReferenceList)
   (fields EpsilonResolvedFieldReferenceList)
   (callables EpsilonResolvedCallableReferenceList)
   (control EpsilonControlReferenceLedger)) EpsilonDeltaCompilation
  (match declarations
    (NoEpsilonDeclarations (EpsilonDeltaCompiled ""))
    ((MoreEpsilonDeclarations declaration rest)
      (match (epsilon_delta_declaration
        (EpsilonDeltaContextAt source locals fields callables control declaration)
        declaration)
        ((EpsilonDeltaCompiled text)
          (epsilon_delta_append (EpsilonDeltaCompiled text)
            (epsilon_delta_declarations source rest locals fields callables control)))
        ((EpsilonDeltaRejected reason offset) (EpsilonDeltaRejected reason offset))
        ((EpsilonDeltaUnsupported offset) (EpsilonDeltaUnsupported offset))
        ((EpsilonDeltaInternal offset) (EpsilonDeltaInternal offset))))))

; Data/boundary declarations have no authored executable body. Their resolved
; identities remain in the checked context; uses materialize runtime metadata.
; Every machine body, including an unreachable one, must lower successfully.
(def epsilon_delta_declaration ((context EpsilonDeltaContext)
  (declaration EpsilonDeclaration)) EpsilonDeltaCompilation
  (match declaration
    ((EpsilonBoundaryDeclaration start end name members) (EpsilonDeltaCompiled ""))
    ((EpsilonDataDeclaration start end name members) (EpsilonDeltaCompiled ""))
    ((EpsilonMachineDeclaration start end name inputs returnType body)
      (epsilon_delta_machine context name inputs body))))
