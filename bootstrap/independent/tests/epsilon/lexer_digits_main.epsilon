data Flag { case Clear; case Set; }
data OtherBase { case Binary; case Octal; case Decimal; case Hexadecimal; }
data Main { console: Console; scanner: OmegaLexScan; bases: [OmegaNumericBase; 2]; flag: Flag; other: OtherBase; }

machine pair_flags(left: Flag, right: Flag) -> i32 {
    transition left { Flag::Clear -> read_right() Flag::Set -> return 9 }
    state read_right() {
        transition right { Flag::Clear -> return 0 Flag::Set -> return 1 }
    }
}
machine local_digit(bases: [OmegaNumericBase; 2], digits: &[u8]) -> i32 {
    bases[0] = OmegaNumericBase::Octal;
    return omega_digit_in_base(digits[0], bases[0]);
}

machine Main::flip(&mut self) -> Flag {
    self.flag = Flag::Set;
    return self.flag;
}
machine Main::main(&mut self) {
    assert pair_flags(self.flag, self.flip()) == 1;
    assert pair_flags(self.flag, Flag::Clear) == 9;
    let copy: [OmegaNumericBase; 2] = self.bases;
    assert local_digit(copy, "7") == 1;
    assert omega_digit_in_base(49, copy[0]) == 1;
    assert omega_digit_in_base(50, copy[0]) == 0;
    self.scanner.consume_digits("10_2", 0);
    assert self.scanner.predicate_result == 1;
    assert self.scanner.next_cursor == 3;
    self.scanner.numeric_base = OmegaNumericBase::Octal;
    self.scanner.consume_digits("7_8", 0);
    assert self.scanner.next_cursor == 2;
    self.scanner.numeric_base = OmegaNumericBase::Decimal;
    self.scanner.consume_digits("9a", 0);
    assert self.scanner.next_cursor == 1;
    self.scanner.numeric_base = OmegaNumericBase::Hexadecimal;
    self.scanner.consume_digits("Ff_g", 0);
    assert self.scanner.next_cursor == 3;
    self.scanner.scan_number("1e+9", 0);
    assert self.scanner.has_token == 1;
    assert self.scanner.token_end == 4;
    assert self.scanner.numeric_has_exponent == 1;
    assert self.scanner.numeric_empty_exponent == 0;
    self.scanner.scan_number("0xFe", 0);
    assert self.scanner.token_end == 4;
    assert self.scanner.numeric_has_exponent == 0;
    self.scanner.scan_number("12e+", 0);
    assert self.scanner.token_end == 4;
    assert self.scanner.numeric_empty_exponent == 1;
    self.console.exit_process(42);
}
machine Main::probe(&mut self, supplied: OmegaNumericBase) -> i32 {
    transition supplied {
        OmegaNumericBase::Decimal -> return 1
        _ -> return omega_digit_in_base(50, supplied)
    }
}
