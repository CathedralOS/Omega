machine Main::main(&mut self) {
    let view: &[u8] = "test bytes";
    transition true { true -> next(view, 0) }
    state next(view: &[u8], index: i32) {
        transition index < view.len {
            true -> emit(view, index)
            _ -> self.console.exit_process(42)
        }
    }
    state emit(view: &[u8], index: i32) {
        self.console.write_byte(view[index]);
        transition true { true -> next(view, index + 1) }
    }
}
