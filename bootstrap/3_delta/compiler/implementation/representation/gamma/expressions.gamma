; Nodes retain kind, expanded height, serialization summaries, and payload.
; Summaries are computed once before a node can be reused. No pair-reference
; provenance is inspected; reconstruction refreshes the summaries.
(def gamma_node ((kind Int) (height Int) (payload Int)) Int
  (let extent Int (emission_node_extent kind payload)
    (let unary_word Int (emission_unary_word kind payload)
      (pair kind (pair height (pair (pair extent unary_word) payload))))))

(def gamma_kind ((node Int)) Int (first node))
(def gamma_height ((node Int)) Int (first (second node)))
(def gamma_extent ((node Int)) Int (first (first (second (second node)))))
(def gamma_unary_word ((node Int)) Int (second (first (second (second node)))))
(def gamma_payload ((node Int)) Int (second (second (second node))))

(def gamma_maximum ((left Int) (right Int)) Int
  (if (lt left right) right left))

(def gamma_arguments_height ((count Int) (nodes Int) (height Int)) Int
  (if (eq count 0)
    height
    (gamma_arguments_height (- count 1) (second nodes)
      (gamma_maximum height (gamma_height (first nodes))))))

; Call payload = (pair head (pair argument-count arguments)).
(def gamma_call ((head Int) (count Int) (arguments Int)) Int
  (gamma_node 7 (+ 1 (gamma_arguments_height count arguments 0))
    (pair head (pair count arguments))))

; Let payload = (pair binder (pair initializer body)). Binding and reference
; atoms share their explicit source or generated-name identity, not a spelling.
(def gamma_let ((binder Int) (initializer Int) (body Int)) Int
  (gamma_node 8 (+ 1 (gamma_maximum (gamma_height initializer) (gamma_height body)))
    (pair binder (pair initializer body))))
