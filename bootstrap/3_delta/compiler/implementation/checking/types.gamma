; Body checking consumes retained nodes after every declaration has resolved.
; Only a complete judgment advances to entry schema and emission.
(def check_program_types ((program Int) (globals Int)) Int
  (check_program_nodes (first program) (second program) globals))

(def check_program_nodes ((count Int) (forms Int) (globals Int)) Int
  (if (eq count 0)
    (compiler_complete 0)
    (let form Int (first forms)
      (let head Int (syntax_child form 0)
        (if (token_data (syntax_start head) (syntax_after head))
          (check_program_nodes (- count 1) (second forms) globals)
          (let checked Int (check_definition_type form globals)
            (if (eq (first checked) 0)
              (check_program_nodes (- count 1) (second forms) globals)
              checked)))))))

(def check_definition_type ((form Int) (globals Int)) Int
  (let name Int (syntax_child form 1)
    (let metadata Int
      (require_function_metadata (syntax_start name) (syntax_after name) globals)
      (let body Int (syntax_child form 4)
        (if (eq (function_metadata_owner metadata) (+ (syntax_start form) 1))
          (if (eq (function_metadata_body_start metadata) (syntax_start body))
            (let checked Int
              (typing_visit body (function_metadata_parameter_locals metadata)
                0 0 globals)
              (if (eq (first checked) 0)
                (if (eq (second checked) (function_metadata_result_type metadata))
                  (compiler_complete 0)
                  (typing_reject 15 body))
                checked))
            (fail))
          (fail))))))
