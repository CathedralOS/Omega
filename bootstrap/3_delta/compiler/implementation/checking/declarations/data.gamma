; Existing checker and emitter callers consume this scalar custody lookup.
; Missing retained constructor rows are not an authored declaration-type error.
(def require_constructor_metadata
  ((name Int) (name_end Int) (globals Int)) Int
  (let found Int
    (name_trie_find_option (global_constructors globals) name_end name)
    (if (first found) (second found) (fail))))

(def resolve_collected_data
  ((form Int) (globals Int) (resolved_constructor_rows Int)) Int
  (let name Int (syntax_child form 1)
    (let found Int
      (name_trie_find_option (global_types globals)
        (syntax_after name) (syntax_start name))
      (if (first found)
        (let metadata Int (second found)
          (if (eq (type_metadata_owner metadata) (+ (syntax_start form) 1))
            (if (eq (type_metadata_constructor_count metadata)
                    (- (syntax_count form) 2))
              (resolve_collected_constructors
                (- (syntax_count form) 2)
                (syntax_drop_children (syntax_children form) 2)
                metadata globals 1 resolved_constructor_rows)
              (fail))
            (fail)))
        (fail)))))

(def resolve_constructor_fields
  ((remaining Int) (fields Int) (type_rows Int) (reversed_types Int)) Int
  (if (eq remaining 0)
    (compiler_complete reversed_types)
    (let resolved Int (resolve_declaration_type (first fields) type_rows)
      (if (eq (first resolved) 0)
        (resolve_constructor_fields
          (- remaining 1) (second fields) type_rows
          (parameter_types_prepend (second resolved) reversed_types))
        resolved))))

; Owner, tag, payload count, and name boundary are retained custody assertions.
; Constructors and their payload annotations resolve in declaration order.
(def resolve_collected_constructors
  ((remaining Int) (constructors Int) (type_metadata Int)
   (globals Int) (tag Int) (resolved_constructor_rows Int)) Int
  (if (eq remaining 0)
    (compiler_complete resolved_constructor_rows)
    (let constructor Int (first constructors)
      (let name Int (syntax_child constructor 0)
        (let metadata Int
          (require_constructor_metadata
            (syntax_start name) (syntax_after name) globals)
          (if (eq (constructor_metadata_owner metadata)
                  (type_metadata_owner type_metadata))
            (if (eq (constructor_metadata_tag metadata) tag)
              (if (eq (constructor_metadata_declaration_end metadata)
                      (syntax_after name))
                (if (eq (constructor_metadata_arity metadata)
                        (- (syntax_count constructor) 1))
                  (if (eq (constructor_metadata_arity metadata) 0)
                    ; The checked raw row already has the final empty type spine.
                    (resolve_collected_constructors
                      (- remaining 1) (second constructors)
                      type_metadata globals (+ tag 1) resolved_constructor_rows)
                    (let checked Int
                      (resolve_constructor_fields
                        (- (syntax_count constructor) 1)
                        (syntax_drop_children (syntax_children constructor) 1)
                        (global_types globals) (empty_parameter_types))
                      (if (eq (first checked) 0)
                        (let field_types Int
                          (reverse_parameter_types (second checked)
                            (constructor_metadata_arity metadata)
                            (empty_parameter_types))
                          (let resolved Int
                            (pair type_metadata
                              (pair tag
                                (pair (constructor_metadata_arity metadata)
                                  (pair (syntax_after name) field_types))))
                            (resolve_collected_constructors
                              (- remaining 1) (second constructors)
                              type_metadata globals (+ tag 1)
                              (identity_cursor_replace
                                (identity_cursor_seek resolved_constructor_rows
                                  (syntax_start name) (syntax_after name))
                                (syntax_after name) resolved))))
                        checked)))
                  (fail))
                (fail))
              (fail))
            (fail)))))))
