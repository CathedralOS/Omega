; State retains next hygienic identity, helper count, and reversed definitions.
(def normalization_state ((next_identity Int) (count Int) (helpers Int)) Int
  (pair next_identity (pair count helpers)))

(def normalization_extract
  ((node Int) (depth Int) (frames Int) (state Int)) Int
  (let name Int (gamma_generated 104 (first state))
    (let helpers Int (second state)
      (normalization_visit node (normalization_height_limit) (+ depth 1)
        (normalization_frame 4 name frames)
        (normalization_state (+ (first state) 1)
          (first helpers) (second helpers))))))

; Split descendants before capture so each helper rewrites only its own body.
; Nested helpers are closed definitions; their call arguments still name the
; original surrounding bindings and are captured normally by this helper.
(def normalization_helper_done
  ((body Int) (name Int) (depth Int) (frames Int) (state Int)) Int
  (let captured Int (capture_expression body (first state))
    (let helpers Int (second state)
      (let definition Int
        (gamma_definition name (capture_count captured)
          (capture_parameters captured) (capture_body captured))
        (normalization_resume
          (gamma_call name (capture_count captured) (capture_arguments captured))
          depth frames
          (normalization_state (capture_next_identity captured) (+ (first helpers) 1)
            (pair definition (second helpers))))))))
