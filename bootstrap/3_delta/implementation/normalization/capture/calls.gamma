; Function and primitive heads never enter lexical capture. Arguments retain
; left-to-right discovery order; the last argument needs no continuation.
(def capture_call_arguments
  ((remaining Int) (arguments Int) (bound_count Int) (bound Int)
   (count Int) (captures Int) (depth Int) (frames Int)) Int
  (if (eq remaining 0)
    (capture_resume count captures depth frames)
    (if (eq remaining 1)
      (capture_visit (first arguments) bound_count bound count captures depth frames)
      (capture_visit (first arguments) bound_count bound count captures (+ depth 1)
        (capture_frame 1
          (pair (- remaining 1) (pair (second arguments) (pair bound_count bound)))
          frames)))))

(def capture_argument_done
  ((payload Int) (count Int) (captures Int) (depth Int) (frames Int)) Int
  (let arguments_and_scope Int (second payload)
    (let scope Int (second arguments_and_scope)
      (capture_call_arguments (first payload) (first arguments_and_scope)
        (first scope) (second scope) count captures depth frames))))
