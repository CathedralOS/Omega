; Collect references, fragment-owned binders, and completed helper batches.
; Binding identity lets finish subtract owned binders once for the whole body.
(def capture_expression ((node Int)) Int
  (let empty Int (pair 0 0)
    (capture_visit node (pair empty (pair empty empty)) 0 0)))

; Kind 1 continues ordinary call arguments; kind 2 enters a let body.
(def capture_frame ((kind Int) (payload Int) (previous Int)) Int
  (pair kind (pair payload previous)))

(def capture_visit ((node Int) (state Int) (depth Int) (frames Int)) Int
  (let kind Int (gamma_kind node)
    (if (eq kind 7)
      (capture_call node state depth frames)
      (if (eq kind 8)
        (capture_let node state depth frames)
        (if (if (eq kind 2) 1 (eq kind 4))
          (capture_resume
            (pair (capture_prepend node (first state)) (second state)) depth frames)
          (capture_resume state depth frames))))))

(def capture_resume ((state Int) (depth Int) (frames Int)) Int
  (if (eq depth 0)
    (capture_finish state)
    (let retained Int (second frames)
      (let payload Int (first retained)
        (if (eq (first frames) 1)
          (capture_call_arguments (first payload) (second payload)
            state (- depth 1) (second retained))
          (if (eq (first frames) 2)
            (capture_visit payload state (- depth 1) (second retained))
            (fail)))))))
