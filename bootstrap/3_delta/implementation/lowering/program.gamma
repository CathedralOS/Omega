; Complete static custody enters this pure phase. Every definition is planned
; before publication; emission later consumes this exact expanded Gamma program.
(def lower_program ((program Int) (globals Int)) Int
  (lowering_definitions (first program) (second program) globals 0 0))

(def lowering_definitions
  ((remaining Int) (forms Int) (globals Int) (count Int) (reversed Int)) Int
  (if (eq remaining 0)
    (compiler_complete
      (gamma_program count (syntax_reverse_nodes count reversed 0)))
    (let node Int (first forms)
      (let head Int (syntax_child node 0)
        (if (token_data (syntax_start head) (syntax_after head))
          ; Grammar places all data before functions. During this prefix,
          ; count is zero or the one already-installed shared projection body.
          (let install Int
            (if (eq count 0)
              (lowering_wide_constructor (- (syntax_count node) 2)
                (second (second (syntax_children node))))
              0)
            (lowering_definitions (- remaining 1) (second forms) globals
              (+ count install)
              (if install (pair (lowering_projection_definition) reversed) reversed)))
          (let definition Int (lowering_definition node globals)
            (lowering_definitions (- remaining 1) (second forms) globals
              (+ count 1) (pair definition reversed))))))))

(def lowering_wide_constructor ((remaining Int) (constructors Int)) Int
  (if (eq remaining 0)
    0
    (if (lt (lowering_inline_projection_width) (- (syntax_count (first constructors)) 1))
      1
      (lowering_wide_constructor (- remaining 1) (second constructors)))))

(def lowering_definition ((node Int) (globals Int)) Int
  (let parameters Int (syntax_child node 2)
    (let bindings Int
      (lowering_parameters (syntax_count parameters) (syntax_children parameters)
        (empty_name_trie) 0)
      (let body Int (lowering_visit (syntax_child node 4) (first bindings) 0 0 globals)
        (gamma_definition (gamma_function (syntax_child node 1)) (syntax_count parameters)
          (syntax_reverse_nodes (syntax_count parameters) (second bindings) 0) body)))))

; Only parameters retain a declaration-order spine; local scope needs the trie.
(def lowering_parameters
  ((count Int) (parameters Int) (locals Int) (reversed Int)) Int
  (if (eq count 0)
    (pair locals reversed)
    (let binding Int (gamma_binding (syntax_child (first parameters) 0))
      (lowering_parameters (- count 1) (second parameters)
        (lowering_bind locals binding) (pair binding reversed)))))
