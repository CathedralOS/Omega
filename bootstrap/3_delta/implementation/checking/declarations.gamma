; Resolve retained declarations in authored order after the complete census.
; Typed builders retain the census tries and replace only changed payloads.
; Only complete typed globals advance to body checking and profile validation.
(def resolve_collected_declarations
  ((program Int) (collected_globals Int)) Int
  (resolve_declaration_nodes (first program) (second program)
    collected_globals
    (identity_cursor 0 0 (global_functions collected_globals) 0)
    (identity_cursor 0 0 (global_constructors collected_globals) 0)))

(def resolve_declaration_nodes
  ((remaining Int) (forms Int) (collected_globals Int)
   (resolved_function_rows Int) (resolved_constructor_rows Int)) Int
  (if (eq remaining 0)
    (compiler_complete
      (pair (global_types collected_globals)
        (pair (identity_cursor_finish resolved_constructor_rows)
          (identity_cursor_finish resolved_function_rows))))
    (let form Int (first forms)
      (let head Int (syntax_child form 0)
        (if (token_data (syntax_start head) (syntax_after head))
          (let checked Int
            (resolve_collected_data form collected_globals resolved_constructor_rows)
            (if (eq (first checked) 0)
              (resolve_declaration_nodes (- remaining 1) (second forms)
                collected_globals resolved_function_rows (second checked))
              checked))
          (if (token_def (syntax_start head) (syntax_after head))
            (let name Int (syntax_child form 1)
              (let resolved Int (resolve_collected_function form collected_globals)
                (if (eq (first resolved) 0)
                  (resolve_declaration_nodes (- remaining 1) (second forms)
                    collected_globals
                    (identity_cursor_replace
                      (identity_cursor_seek resolved_function_rows
                        (syntax_start name) (syntax_after name))
                      (syntax_after name) (second resolved))
                    resolved_constructor_rows)
                  resolved)))
            (fail)))))))
