; Count and pending spine travel as separate machine arguments.
; A pending batch is (pair role (pair depth (pair remaining (pair nodes rest)))).
; Nodes reuse the parser-owned ordered spine; no copied reverse child list.
; Callers provision each complete frame group before any of these pairs exist.
(def grammar_pending
  ((role Int) (depth Int) (remaining Int) (nodes Int) (rest Int)) Int
  (pair role (pair depth (pair remaining (pair nodes rest)))))

(def grammar_run ((count Int) (work Int) (used Int)) Int
  (if (eq count 0)
    (compiler_complete used)
    (let context Int (second work)
      (let batch Int (second context)
        (let children Int (second batch)
          (grammar_sequence (first work) (first batch) (first children)
            (first context) (- count 1) (second children) used))))))

; Only an actually pending sibling sequence gets a frame. The current child
; enters its role directly, and popping a batch allocates no replacement work.
(def grammar_sequence
  ((role Int) (remaining Int) (nodes Int) (depth Int)
   (count Int) (work Int) (used Int)) Int
  (if (eq remaining 0)
    (grammar_run count work used)
    (if (eq remaining 1)
      (grammar_check_role role (first nodes) depth count work used)
      (let requested Int (syntax_storage_requested used 4)
        (if (syntax_storage_fits requested)
          (grammar_check_role role (first nodes) depth (+ count 1)
            (grammar_pending role depth (- remaining 1) (second nodes) work)
            requested)
          (syntax_storage_refusal (syntax_start (first nodes)) requested))))))

(def grammar_reject ((node Int)) Int
  (compiler_source_rejection 4 (syntax_start node)))

(def grammar_child_at ((children Int) (index Int)) Int
  (if (eq index 0)
    (first children)
    (grammar_child_at (second children) (- index 1))))

; Shape probes return -1 on success, otherwise an exact source coordinate.
; This is private control data, not a compiler outcome or a resource bound.
(def grammar_exact_count ((node Int) (expected Int)) Int
  (let count Int (syntax_count node)
    (if (lt count 0)
      (syntax_start node)
      (if (lt count expected)
        (- (syntax_after node) 1)
        (if (eq count expected)
          -1
          (syntax_start (grammar_child_at (syntax_children node) expected)))))))

(def grammar_minimum_count ((node Int) (minimum Int)) Int
  (let count Int (syntax_count node)
    (if (lt count 0)
      (syntax_start node)
      (if (lt count minimum) (- (syntax_after node) 1) -1))))

(def grammar_atom_role_error ((role Int) (node Int)) Int
  (if (eq (syntax_count node) -1)
    (let start Int (syntax_start node)
      (let after Int (syntax_after node)
        (let valid Int
          (if (eq role 2)
            (value_name_valid start after)
            (if (eq role 3)
              (upper_name_valid start after)
              (field_type_shape_valid start after)))
          (if valid -1 start))))
    (syntax_start node)))

(def grammar_atom_role
  ((role Int) (node Int) (count Int) (work Int) (used Int)) Int
  (let error Int (grammar_atom_role_error role node)
    (if (eq error -1)
      (grammar_run count work used)
      (compiler_source_rejection 4 error))))
