; Bound support-member custody. Every sealed compiler input ends with the
; exact packed bytes of bootstrap/3_delta/support/support.gamma.sources:
; the byte-rope runtime, the ConformanceBytesV1 runtime, and the generated
; main adapter, concatenated in manifest order. The table below binds each
; member's extent, frame offset, and byte sum so that only the audited
; closure selects program meaning; no host path or filename is consulted.
; Admission proves the section is present; compile_admitted_source checks
; each member's contents before any Delta source observation.

; Support-member indexes match the manifest's packed order.
(def support_member_count () Int 3)

(def support_packed_extent () Int 2998)

(def support_member_extent ((member Int)) Int
  (if (eq member 0)
    1464
    (if (eq member 1)
      1071
      463)))

(def support_member_offset ((member Int)) Int
  (if (eq member 0)
    0
    (if (eq member 1)
      1464
      2535)))

; Byte sums accumulate (h * 257 + byte) with wrapping 64-bit words, seeded
; at zero over each member's exact extent.
(def support_member_sum ((member Int)) Int
  (if (eq member 0)
    2838127974949508143
    (if (eq member 1)
      12190257483807601720
      17850154272413477696)))

; The support section occupies the sealed input's final packed extent.
; Coordinates in space 5 are absolute sealed-input offsets like space 4.
(def support_frame_start () Int
  (- (input) (support_packed_extent)))

; DCOUT space 5 (support section): code 1 reports an input that ends
; before the bound frame is complete; code 2 reports a member whose byte
; sum disagrees with the bound table at the member's absolute offset.
(def support_section_incomplete () Int
  (compiler_failure 1 5 1 (input) 0 0))

(def support_member_failure ((coordinate Int)) Int
  (compiler_failure 1 5 2 coordinate 0 0))

(def support_sum_region ((index Int) (remaining Int) (hash Int)) Int
  (if (eq remaining 0)
    hash
    (support_sum_region (+ index 1) (- remaining 1)
      (+ (* hash 257) (read index)))))

(def support_check_member ((member Int)) Int
  (let ((start Int (+ (support_frame_start) (support_member_offset member)))
        (extent Int (support_member_extent member)))
    (if (eq (support_sum_region start extent 0) (support_member_sum member))
      (pair 0 0)
      (support_member_failure start))))

(def support_check_members ((member Int)) Int
  (if (eq member (support_member_count))
    (pair 0 0)
    (let result Int (support_check_member member)
      (if (eq (first result) 0)
        (support_check_members (+ member 1))
        result))))

; Returns (pair 0 0) when the sealed input ends with every bound member,
; or the owned compiler failure. Emission entries call this before any
; Delta-source phase; diagnostic entries that never publish may omit it.
(def validate_support_members () Int
  (if (lt (input) (support_packed_extent))
    (support_section_incomplete)
    (support_check_members 0)))

; Publication copies member bytes verbatim from the sealed input; counting
; advances by the same bound extent without evaluating the copy. The two
; passes therefore agree exactly and every support byte is counted before
; publication alongside every generated byte.
(def emit_support_bytes ((index Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let effect Int (write (read index))
      (emit_support_bytes (+ index 1) (- remaining 1)))))

(def emit_support_member ((member Int) (publish Int) (written Int)) Int
  (let extent Int (support_member_extent member)
    (if publish
      (let effect Int
        (emit_support_bytes
          (+ (support_frame_start) (support_member_offset member)) extent)
        (+ written extent))
      (emit_advance written extent))))
