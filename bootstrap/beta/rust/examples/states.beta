; CFG / Omega-style control flow: states + guarded transitions, no if/while.
; sumto(n) = n + (n-1) + ... + 1, expressed as a 3-state machine.
proc sumto(n) {
    state entry {
        let acc = 0
        let i = n
        to loop
    }
    state loop {
        to done when (i == 0)
        acc = acc + i
        i = i - 1
        to loop
    }
    state done {
        return acc
    }
}
proc main() {
    return sumto(10)
}
