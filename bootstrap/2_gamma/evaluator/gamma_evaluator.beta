        store r8c r86
        mov r0 r8c
        imm r1 0x8
        add r0 r1
        store r0 r87
        imm r0 0x6e69616d
        imm r1 0x4
        call 0x4a6 ; -> token_equals:
        jz r0 0xb12 ; -> census_parameters:
