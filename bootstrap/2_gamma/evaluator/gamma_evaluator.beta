; Direct Beta evaluator for the typed scalar/effect Gamma bootstrap profile.
; Request: u32 little-endian source length, source bytes, sealed input bytes.
; Scalar main appends its low byte and completes with status zero. A pair main
; is the generic application result `(pair status publish)`: both fields are
; scalar, status is 0..254, and publish is zero or one.
;
; Persistent registers:
; r80 request end, r81 source start, r82 source end, r83 input start,
; r84 input length, r85 cursor, r86 token start, r87 token length,
; r88 function count, r89 environment count, r8a value-stack pointer,
; r8b main function row, r8c active environment base,
; r8d function-frame pointer, r8e call-context depth.
; r90 zero, r91 one, r92 request base, r93 request limit,
; r94 function table, r95 environment table, r96 value-stack base,
; r97 value-stack end, r98 tail-request flag, r99 tail function,
; r9a tail argument base, r9b tail argument count,
; ra0 immutable-pair heap cursor, ra1 immutable-pair heap limit,
; ra2 result kind (zero scalar, one pair),
; rb0 buffered-output count, rb1 buffered-output limit.
; rb2 is one only for a validated source whose first function is $application.
; Low registers are caller-clobbered scratch.

0x0: ; main:
        imm r90 0x0
        imm r91 0x1
        imm r92 0x100000
        imm r93 0x1100000
        imm r94 0x4000000
        imm r95 0x1300000
        imm r96 0x1500000
        imm r97 0x1d00000
        imm ra0 0x10000000
        imm ra1 0x70000000
        mov rb0 r90
        imm rb1 0xfffffc
        mov r0 r92
0x74: ; read_loop:
        jeq r0 r93 0x9b ; -> read_full:
        read r1
        jlt r1 r90 0xb1 ; -> read_done:
        storeb r0 r1
        add r0 r91
        jmp 0x74 ; -> read_loop:
0x9b: ; read_full:
        read r1
        jlt r1 r90 0xb1 ; -> read_done:
        jmp 0x1e08 ; -> request_extent_failure:
0xb1: ; read_done:
        mov r80 r0
        mov r1 r92
        imm r2 0x4
        add r1 r2
        jlt r80 r1 0x19e6 ; -> invalid:
        mov r0 r92
        call 0x1b0 ; -> read_u32:
        mov r81 r92
        imm r1 0x4
        add r81 r1
        mov r82 r81
        add r82 r0
        jlt r82 r81 0x19e6 ; -> invalid:
        jlt r80 r82 0x19e6 ; -> invalid:
        mov r83 r82
        mov r84 r80
        sub r84 r83
        call 0x1fc ; -> validate_source:
        call 0xa29 ; -> census:
        mov r89 r90
        mov r8c r90
        mov r8a r96
        mov r8e r90
        call 0x1c87 ; -> validate_and_classify_program:
        mov r89 r90
        mov r8c r90
        mov r8a r96
        imm r8d 0x1e00000
        mov r8e r90
        mov r0 r8b
        mov r1 r8a
        mov r2 r90
        call 0xfa9 ; -> enter_function:
        jmp 0x1a16 ; -> finish_main:
        imm r0 0x0
        imm r0 0x0
        imm r0 0x0
        imm r0 0x0
        imm r0 0x0
        mov r0 r0
        halt r0

0x19f: ; write_output:
        jmp 0x1b3b ; -> buffer_output:
        dw 0x0

; r0 points to four little-endian bytes; returns u32 in r0.
0x1b0: ; read_u32:
        loadb r1 r0
        mov r2 r0
        add r2 r91
        loadb r3 r2
        imm r4 0x100
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x10000
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x1000000
        mul r3 r4
        add r1 r3
        mov r0 r1
        ret

0x1fc: ; validate_source:
        mov r0 r81
0x1ff: ; validate_source_loop:
        jlt r0 r82 0x20b ; -> validate_source_byte:
        ret
0x20b: ; validate_source_byte:
        loadb r1 r0
        imm r2 0x9
        jeq r1 r2 0x280 ; -> validate_source_next:
        imm r2 0xa
        jeq r1 r2 0x280 ; -> validate_source_next:
        imm r2 0xd
        jeq r1 r2 0x280 ; -> validate_source_next:
        imm r2 0x20
        jlt r1 r2 0x19e6 ; -> invalid:
        imm r2 0x7f
        jlt r1 r2 0x280 ; -> validate_source_next:
        jmp 0x19e6 ; -> invalid:
0x280: ; validate_source_next:
        add r0 r91
        jmp 0x1ff ; -> validate_source_loop:

; Tokenizer. Returns r0=1 with r86/r87, or r0=0 at source end.
0x28c: ; next_token:
        mov r0 r85
0x28f: ; next_skip:
        jlt r0 r82 0x2a1 ; -> next_have:
        mov r85 r0
        mov r0 r90
        ret
0x2a1: ; next_have:
        loadb r1 r0
        imm r2 0x21
        jlt r1 r2 0x2d7 ; -> next_advance:
        imm r2 0x3b
        jeq r1 r2 0x2e3 ; -> next_comment:
        jmp 0x333 ; -> next_begin:
0x2d7: ; next_advance:
        add r0 r91
        jmp 0x28f ; -> next_skip:
0x2e3: ; next_comment:
        add r0 r91
0x2e6: ; next_comment_loop:
        jlt r0 r82 0x2fa ; -> next_comment_byte:
        jmp 0x28f ; -> next_skip:
0x2fa: ; next_comment_byte:
        loadb r1 r0
        add r0 r91
        imm r2 0xa
        jeq r1 r2 0x28f ; -> next_skip:
        imm r2 0xd
        jeq r1 r2 0x28f ; -> next_skip:
        jmp 0x2e6 ; -> next_comment_loop:
0x333: ; next_begin:
        mov r86 r0
        imm r2 0x27
        jeq r1 r2 0x3f8 ; -> next_character:
        imm r2 0x28
        jeq r1 r2 0x3ec ; -> next_punctuation:
        imm r2 0x29
        jeq r1 r2 0x3ec ; -> next_punctuation:
0x375: ; next_body:
        jlt r0 r82 0x389 ; -> next_body_byte:
        jmp 0x485 ; -> next_done:
0x389: ; next_body_byte:
        loadb r1 r0
        imm r2 0x21
        jlt r1 r2 0x485 ; -> next_done:
        imm r2 0x3b
        jeq r1 r2 0x485 ; -> next_done:
        imm r2 0x28
        jeq r1 r2 0x485 ; -> next_done:
        imm r2 0x29
        jeq r1 r2 0x485 ; -> next_done:
        add r0 r91
        jmp 0x375 ; -> next_body:
0x3ec: ; next_punctuation:
        add r0 r91
        jmp 0x485 ; -> next_done:
0x3f8: ; next_character:
        add r0 r91
        jlt r0 r82 0x40f ; -> next_character_byte:
        jmp 0x19e6 ; -> invalid:
0x40f: ; next_character_byte:
        loadb r1 r0
        imm r2 0x5c
        jeq r1 r2 0x433 ; -> next_character_escape:
        add r0 r91
        jmp 0x44d ; -> next_character_close:
0x433: ; next_character_escape:
        add r0 r91
        jlt r0 r82 0x44a ; -> next_character_escape_byte:
        jmp 0x19e6 ; -> invalid:
0x44a: ; next_character_escape_byte:
        add r0 r91
0x44d: ; next_character_close:
        jlt r0 r82 0x461 ; -> next_character_close_byte:
        jmp 0x19e6 ; -> invalid:
0x461: ; next_character_close_byte:
        loadb r1 r0
        imm r2 0x27
        jeq r1 r2 0x482 ; -> next_character_done:
        jmp 0x19e6 ; -> invalid:
0x482: ; next_character_done:
        add r0 r91
0x485: ; next_done:
        mov r87 r0
        sub r87 r86
        mov r85 r0
        mov r0 r91
        ret

0x492: ; need_token:
        call 0x28c ; -> next_token:
        jz r0 0x19e6 ; -> invalid:
        ret

; r0 packed ASCII, r1 length. Return r0=0/1 against current token.
0x4a6: ; token_equals:
        jeq r87 r1 0x4b5 ; -> token_equals_begin:
        mov r0 r90
        ret
0x4b5: ; token_equals_begin:
        mov r2 r90
        mov r3 r0
0x4bb: ; token_equals_loop:
        jeq r2 r1 0x4fd ; -> token_equals_true:
        mov r4 r86
        add r4 r2
        loadb r5 r4
        imm r6 0x100
        mov r7 r3
        mod r7 r6
        jeq r5 r7 0x4ee ; -> token_equals_next:
        mov r0 r90
        ret
0x4ee: ; token_equals_next:
        div r3 r6
        add r2 r91
        jmp 0x4bb ; -> token_equals_loop:
0x4fd: ; token_equals_true:
        mov r0 r91
        ret

; Classify the current list head through the explicit table below. Zero is call.
0x501: ; classify_list_head:
        imm r8 0x1b87 ; -> list_head_table:
0x50b: ; classify_list_head_loop:
        load r0 r8
        imm r1 0x8
        add r8 r1
        load r3 r8
        jz r3 0x572 ; -> classify_list_head_call:
        mov r1 r3
        imm r4 0x100
        mod r1 r4
        call 0x4a6 ; -> token_equals:
        jnz r0 0x561 ; -> classify_list_head_found:
        imm r1 0x8
        add r8 r1
        jmp 0x50b ; -> classify_list_head_loop:
0x561: ; classify_list_head_found:
        load r0 r8
        imm r1 0x100
        div r0 r1
        ret
0x572: ; classify_list_head_call:
        mov r0 r90
        ret

0x576: ; is_open:
        imm r0 0x28
        imm r1 0x1
        call 0x4a6 ; -> token_equals:
        ret
0x594: ; is_close:
        imm r0 0x29
        imm r1 0x1
        call 0x4a6 ; -> token_equals:
        ret
0x5b2: ; expect_open:
        call 0x492 ; -> need_token:
        call 0x576 ; -> is_open:
        jz r0 0x19e6 ; -> invalid:
        ret
0x5cf: ; expect_close:
        call 0x492 ; -> need_token:
        call 0x594 ; -> is_close:
        jz r0 0x19e6 ; -> invalid:
        ret
0x5ec: ; expect_int:
        call 0x492 ; -> need_token:
        imm r0 0x746e49
        imm r1 0x3
        call 0x4a6 ; -> token_equals:
        jz r0 0x19e6 ; -> invalid:
        ret

; Parse current decimal token. Return value r0 and success flag r1.
0x61d: ; parse_integer:
        jz r87 0x6f8 ; -> parse_integer_fail:
        mov r2 r90
        mov r3 r90
        mov r4 r90
        loadb r5 r86
        imm r6 0x27
        jeq r5 r6 0x6ff ; -> parse_character:
        imm r6 0x2d
        jeq r5 r6 0x666 ; -> parse_integer_minus:
        jmp 0x677 ; -> parse_integer_loop:
0x666: ; parse_integer_minus:
        mov r4 r91
        add r2 r91
        jeq r2 r87 0x6f8 ; -> parse_integer_fail:
0x677: ; parse_integer_loop:
        jeq r2 r87 0x6dd ; -> parse_integer_done:
        mov r5 r86
        add r5 r2
        loadb r5 r5
        imm r6 0x30
        jlt r5 r6 0x6f8 ; -> parse_integer_fail:
        imm r7 0x3a
        jlt r5 r7 0x6be ; -> parse_integer_digit:
        jmp 0x6f8 ; -> parse_integer_fail:
0x6be: ; parse_integer_digit:
        sub r5 r6
        imm r6 0xa
        mul r3 r6
        add r3 r5
        add r2 r91
        jmp 0x677 ; -> parse_integer_loop:
0x6dd: ; parse_integer_done:
        jz r4 0x6f1 ; -> parse_integer_positive:
        mov r0 r90
        sub r0 r3
        mov r1 r91
        ret
0x6f1: ; parse_integer_positive:
        mov r0 r3
        mov r1 r91
        ret
0x6f8: ; parse_integer_fail:
        mov r0 r90
        mov r1 r90
        ret

; Tokenization has established 'X' or one closed escape: \n or \s.
0x6ff: ; parse_character:
        imm r2 0x3
        jeq r87 r2 0x732 ; -> parse_character_simple:
        imm r2 0x4
        jeq r87 r2 0x754 ; -> parse_character_escape:
        jmp 0x7bb ; -> parse_character_fail:
0x732: ; parse_character_simple:
        mov r0 r86
        add r0 r91
        loadb r0 r0
        imm r2 0x27
        jeq r0 r2 0x7bb ; -> parse_character_fail:
        mov r1 r91
        ret
0x754: ; parse_character_escape:
        mov r2 r86
        imm r4 0x2
        add r2 r4
        loadb r2 r2
        imm r3 0x6e
        jeq r2 r3 0x79a ; -> parse_character_newline:
        imm r3 0x73
        jeq r2 r3 0x7ad ; -> parse_character_space:
        jmp 0x7bb ; -> parse_character_fail:
0x79a: ; parse_character_newline:
        imm r0 0xa
        jmp 0x7b7 ; -> parse_character_true:
0x7ad: ; parse_character_space:
        imm r0 0x20
0x7b7: ; parse_character_true:
        mov r1 r91
        ret
0x7bb: ; parse_character_fail:
        mov r0 r90
        mov r1 r90
        ret

; Value stack stores (word, kind) evaluator intermediates and call arguments.
0x7c2: ; push_value:
        mov r1 r8a
        imm r2 0x10
        add r1 r2
        jlt r97 r1 0x1dab ; -> stack_failure:
        store r8a r0
        imm r1 0x8
        add r8a r1
        store r8a ra2
        add r8a r1
        ret
0x7f4: ; pop_value:
        jeq r8a r96 0x1a0a ; -> internal:
        imm r1 0x10
        sub r8a r1
        load r0 r8a
        imm r1 0x8
        add r1 r8a
        load ra2 r1
        ret

0x820: ; require_scalar:
        jnz ra2 0x19f2 ; -> authored_trap:
        ret

0x82b: ; require_pair:
        jeq ra2 r91 0x83f ; -> require_pair_done:
        jmp 0x19f2 ; -> authored_trap:
0x83f: ; require_pair_done:
        ret

; Function row is five words: name start/length, params start, body start, arity.
0x840: ; function_row:
        imm r1 0x28
        mul r0 r1
        add r0 r94
        ret

; r3 is a row beginning with name start/length. Match the current token.
0x851: ; row_matches_token:
        mov r4 r3
        imm r5 0x8
        add r4 r5
        load r4 r4
        jeq r4 r87 0x873 ; -> row_matches_token_begin:
        mov r0 r90
        ret
0x873: ; row_matches_token_begin:
        load r4 r3
        mov r5 r90
0x879: ; row_matches_token_loop:
