        imm r0 0x20
        mul r0 r2
        add r0 r95
        mov r3 r0
        call 0x851 ; -> row_matches_token:
        jnz r0 0x939 ; -> find_environment_present:
        jmp 0x8fc ; -> find_environment_loop:
0x939: ; find_environment_present:
