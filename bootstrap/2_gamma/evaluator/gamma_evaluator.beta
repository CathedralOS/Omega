        add r6 r5
        loadb r6 r6
        mov r7 r86
        add r7 r5
        loadb r7 r7
        jeq r6 r7 0x8a5 ; -> row_matches_token_next:
        mov r0 r90
        ret
0x8a5: ; row_matches_token_next:
        add r5 r91
        jmp 0x879 ; -> row_matches_token_loop:
0x8b1: ; row_matches_token_true:
