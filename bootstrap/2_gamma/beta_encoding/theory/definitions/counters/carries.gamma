; Functions 28..35 carry into positions 7..0 of eight low-first Byte arguments.
; Every definition is mode 0; its only carry call names the previous function.
; Rows 1..8 bind all bytes; 9 tests the selected byte, 10 increments it,
; 11 constructs that candidate Word, and 12 wraps it in WordValue.
(def beta_counter_carry_definitions ((position Int)) Int
  (if (lt position 0) 0
    (let definition Int (beta_counter_carry_definition position)
      (beta_counter_carry_definitions (- position 1)))))

(def beta_counter_carry_definition ((position Int)) Int
  (let highest Int (eq position 7)
    (let length Int (beta_theory_word (if highest 79 91))
      (let signature Int (beta_theory_fields3 7 8 1)
        (let sorts Int (beta_theory_repeated_word 1 7)
          (let mode Int (beta_theory_fields3 0 0 1)
            (let clause Int (beta_theory_fields3
              (if highest 65 77) 0 (if highest 14 15))
              (let variables Int (beta_theory_variables 0 8)
                (beta_counter_carry_body position highest)))))))))

(def beta_counter_carry_body ((position Int) (highest Int)) Int
  (let maximum Int (beta_unary_template 2 26 (+ position 1))
    (let increment Int (beta_unary_template 2 25 (+ position 1))
      (let word Int (beta_counter_word_template 1 277 position 10)
        (let value Int (beta_unary_template 1 281 11)
          (let fallback Int
            (if highest (beta_constant_template 280)
              (let zero Int (beta_constant_template 1)
                (beta_counter_word_template 2 (- 34 position) position 13)))
            (let choice Int (beta_theory_fields3 6 2 27)
              (let arguments Int (beta_theory_fields3 3 9 12)
                (let selected Int (beta_theory_word (if highest 13 14))
                  (beta_theory_word (if highest 14 15)))))))))))
