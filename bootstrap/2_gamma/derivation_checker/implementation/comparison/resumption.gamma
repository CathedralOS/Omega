(def comparison_resume ((context Int) (depth Int) (frames Int)
  (memo Int) (used Int) (coordinate Int)) Int
  (if (lt used (comparison_limit))
    (comparison_resume_charged context depth frames memo (+ used 1) coordinate)
    (comparison_exhausted coordinate used)))

(def comparison_resume_charged ((context Int) (depth Int) (frames Int)
  (memo Int) (used Int) (coordinate Int)) Int
  (if (eq depth 0)
    (comparison_finish 1 context memo used)
    (let remaining Int (comparison_pending_remaining frames)
      (if (eq remaining 0)
        (comparison_resume context (- depth 1) (comparison_pending_rest frames)
          (comparison_memo_insert memo 0 (comparison_memo_extent context)
            (comparison_pending_key frames) context) used coordinate)
        (let left Int (comparison_pending_left frames)
          (let right Int (comparison_pending_right frames)
            (comparison_visit context (layout_word left) (layout_word right) depth
              (comparison_pending (comparison_pending_key frames)
                (+ left 4) (+ right 4) (- remaining 1) (comparison_pending_rest frames))
              memo used coordinate)))))))
