; refinement-subtyping VC: widening a bounded-integer range.
;   a<=x & x<b & a'<=a & b<=b' -> a'<=x & x<b'  (a value in [a,b) lies in any wider [a',b'))
; le-trans gives a'<=x, lt-le-trans gives x<b'. The obligation Omega emits to coerce {x: a<=x<b} <: {x: a'<=x<b'}.
(def 0 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 1 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 2 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 3 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 x4) x2)) (-> (ex x5 (= (+ x2 x5) x3)) (ex x6 (= (+ x1 x6) x3))))))) (gen x7 (gen x8 (gen x9 (lam h10 (ex x11 (= (+ x7 x11) x8)) (lam h12 (ex x13 (= (+ x8 x13) x9)) (unpack h10 (gen x14 (lam h15 (= (+ x7 x14) x8) (unpack h12 (gen x16 (lam h17 (= (+ x8 x16) x9) (wit x18 (= (+ x7 x18) x9) (+ x14 x16) (app (app (inst (inst (inst (use 2) (+ x7 (+ x14 x16))) (+ (+ x7 x14) x16)) x9) (app (inst (inst (use 1) (+ (+ x7 x14) x16)) (+ x7 (+ x14 x16))) (inst (inst (inst (use 0) x14) x16) x7))) (app (app (inst (inst (inst (use 2) (+ (+ x7 x14) x16)) (+ x8 x16)) x9) (eqelim x19 (= (+ (+ x7 x14) x16) (+ x19 x16)) h15 (refl (+ (+ x7 x14) x16)))) h17)))))))))))))))
(def 4 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 5 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 6 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 7 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 (s x4)) x2)) (-> (ex x5 (= (+ x2 x5) x3)) (ex x6 (= (+ x1 (s x6)) x3))))))) (gen x7 (gen x8 (gen x9 (lam h10 (ex x11 (= (+ x7 (s x11)) x8)) (lam h12 (ex x13 (= (+ x8 x13) x9)) (unpack h10 (gen x14 (lam h15 (= (+ x7 (s x14)) x8) (unpack h12 (gen x16 (lam h17 (= (+ x8 x16) x9) (wit x18 (= (+ x7 (s x18)) x9) (+ x14 x16) (app (app (inst (inst (inst (use 6) (+ x7 (+ (s x14) x16))) (+ (+ x7 (s x14)) x16)) x9) (app (inst (inst (use 5) (+ (+ x7 (s x14)) x16)) (+ x7 (+ (s x14) x16))) (inst (inst (inst (use 4) (s x14)) x16) x7))) (app (app (inst (inst (inst (use 6) (+ (+ x7 (s x14)) x16)) (+ x8 x16)) x9) (eqelim x19 (= (+ (+ x7 (s x14)) x16) (+ x19 x16)) h15 (refl (+ (+ x7 (s x14)) x16)))) h17)))))))))))))))
(all x1 (all x2 (all x3 (all x4 (all x5 (-> (ex x6 (= (+ x1 x6) x2)) (-> (ex x7 (= (+ x2 (s x7)) x3)) (-> (ex x8 (= (+ x4 x8) x1)) (-> (ex x9 (= (+ x3 x9) x5)) (& (ex x10 (= (+ x4 x10) x2)) (ex x11 (= (+ x2 (s x11)) x5))))))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (gen x5 (lam h6 (ex x7 (= (+ x1 x7) x2)) (lam h8 (ex x9 (= (+ x2 (s x9)) x3)) (lam h10 (ex x11 (= (+ x4 x11) x1)) (lam h12 (ex x13 (= (+ x3 x13) x5)) (pair (app (app (inst (inst (inst (use 3) x4) x1) x2) h10) h6) (app (app (inst (inst (inst (use 7) x2) x3) x5) h8) h12)))))))))))
