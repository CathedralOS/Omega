; TERMINATION measure-decrease for `decreases s -> Slice::Length` machines: the tail-recursive
; call strictly shrinks the slice. For a nonempty slice s = cons(h, t), the recursion is on the
; tail t (= s[1..]), and len(t) < len(cons h t) -- the Slice::Length measure drops by exactly 1,
; which is what makes the recursion well-founded (terminating).
;
; `<` is the Peano existential a < b := ex k. a + s(k) = b. The built-in len reduces
; len(cons h t) => s(len t), so the goal is `ex k. len t + s(k) = s(len t)`, witness k = z:
;   len t + s(z) = s(len t + z)   [add-succ-right]
;              = s(len t)         [add-zero-right under cong-s]
(def 0 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 1 (all x1 (= (+ x1 z) x1)) (natind x1 (= (+ x1 z) x1) (refl z) (gen x2 (lam h3 (= (+ x2 z) x2) (eqelim x4 (= (s (+ x2 z)) (s x4)) h3 (refl (s (+ x2 z))))))))
(def 2 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 3 (all x1 (all x2 (-> (= x1 x2) (= (s x1) (s x2))))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= (s x3) (s x6)) h5 (refl (s x3)))))))
(all h (all t (ex k (= (+ (len t) (s k)) (len (cons h t))))))
(gen h (gen t (wit k (= (+ (len t) (s k)) (len (cons h t))) z (app (app (inst (inst (inst (use 0) (+ (len t) (s z))) (s (+ (len t) z))) (s (len t))) (inst (inst (use 2) (len t)) z)) (app (inst (inst (use 3) (+ (len t) z)) (len t)) (inst (use 1) (len t)))))))
