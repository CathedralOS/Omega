; member-to-front: a list member can be permuted to the head -- forall p L. Mem(p,L) -> exists L'. Perm(cons p L', L).
; By LIST induction on L (NOT on the Perm derivation -- Perm is intro-only, so it is only ever constructed,
; never eliminated; this is why uniqueness needs no permutation eliminator). nil: Mem(p,nil) is absurd.
; cons h t: invert Mem (memcons) into p=h or Mem(p,t). If p=h, take L'=t and rewrite Perm(cons h t, cons h t)
; (perm-refl) by p=h. If Mem(p,t), the IH gives Perm(cons p t', t); take L'=cons h t' and compose
;   permswap p h t' : Perm(cons p (cons h t'), cons h (cons p t'))   with
;   permskip h (IH) : Perm(cons h (cons p t'), cons h t)             via permtrans.
; The key rearrangement step the FTA-uniqueness induction turns on (see FTA-UNIQUENESS.md).
(def 0 (all L (rel 779 L L))
  (listind L (rel 779 L L) (permnil) (gen h (gen t (lam ih (rel 779 t t) (permskip h ih))))))
(def 1 (all a (all b (-> (= a b) (= b a))))
  (gen a (gen b (lam h (= a b) (eqelim w (= w a) h (refl a))))))
(all p (all L (-> (rel 777 p L) (ex Lp (rel 779 (cons p Lp) L)))))
(gen p (listind L (-> (rel 777 p L) (ex Lp (rel 779 (cons p Lp) L)))
  (lam hm (rel 777 p nil) (absurd (ex Lp (rel 779 (cons p Lp) nil)) (memnil hm)))
  (gen h (gen t (lam ih (-> (rel 777 p t) (ex Lp (rel 779 (cons p Lp) t)))
    (lam hm (rel 777 p (cons h t))
      (case (memcons hm)
        (lam he (= p h)
          (wit Lp (rel 779 (cons p Lp) (cons h t)) t
            (eqelim w (rel 779 (cons w t) (cons h t)) (app (inst (inst (use 1) p) h) he) (inst (use 0) (cons h t)))))
        (lam hmt (rel 777 p t)
          (unpack (app ih hmt) (gen tp (lam hp (rel 779 (cons p tp) t)
            (wit Lp (rel 779 (cons p Lp) (cons h t)) (cons h tp)
              (permtrans (permswap p h tp) (permskip h hp))))))))))))))
