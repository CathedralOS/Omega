; le-antisym.elab — the decidable order `le` is ANTISYMMETRIC:  ∀a b. a≤b -> b≤a -> a=b (x≤y is le(x,y)=True).
; The FOURTH and last order-relation property: with le-refl (le-max-bound), le-trans, le-total, `le` is now a
; fully characterized DECIDABLE TOTAL ORDER. `le` = built-in-nat Bool (True=(s z)) over user-nat elements. Proof:
; double induction; a=0,b=0 -> 0=0; whenever one side is 0 and the other s.. one hypothesis is false (le(s _,0)
; reduces to z=(s z)) -> (absurd (disj h)); the all-successor case peels one s off each le and applies the IH
; (a1=b1), lifted to s a1 = s b1 by congruence.
(data 2 0 0 0) (data 3 1 1 0)
(fun 25 2 (s z)) (fun 25 3 (f 26 (y 0) (v 0)))          ; le(0,n)=True ; le(s m,n)=lehelp(n,m)
(fun 26 2 z) (fun 26 3 (f 25 (y 0) (v 0)))              ; lehelp(0,m)=False ; lehelp(s n,m)=le(m,n)

(all a (all b (-> (= (f 25 a b) (s z)) (-> (= (f 25 b a) (s z)) (= a b)))))
(rec 2 3 a (all b (-> (= (f 25 a b) (s z)) (-> (= (f 25 b a) (s z)) (= a b)))) (rec 2 3 b (-> (= (f 25 (k 2) b) (s z)) (-> (= (f 25 b (k 2)) (s z)) (= (k 2) b))) (lam h1 (= (f 25 (k 2) (k 2)) (s z)) (lam h2 (= (f 25 (k 2) (k 2)) (s z)) (refl (k 2)))) (gen b1 (lam ihb (-> (= (f 25 (k 2) b1) (s z)) (-> (= (f 25 b1 (k 2)) (s z)) (= (k 2) b1))) (lam h1 (= (f 25 (k 2) (k 3 b1)) (s z)) (lam h2 (= (f 25 (k 3 b1) (k 2)) (s z)) (absurd (= (k 2) (k 3 b1)) (disj h2))))))) (gen a1 (lam iha (all b (-> (= (f 25 a1 b) (s z)) (-> (= (f 25 b a1) (s z)) (= a1 b)))) (rec 2 3 b (-> (= (f 25 (k 3 a1) b) (s z)) (-> (= (f 25 b (k 3 a1)) (s z)) (= (k 3 a1) b))) (lam h1 (= (f 25 (k 3 a1) (k 2)) (s z)) (lam h2 (= (f 25 (k 2) (k 3 a1)) (s z)) (absurd (= (k 3 a1) (k 2)) (disj h1)))) (gen b1 (lam ihb (-> (= (f 25 (k 3 a1) b1) (s z)) (-> (= (f 25 b1 (k 3 a1)) (s z)) (= (k 3 a1) b1))) (lam h1 (= (f 25 (k 3 a1) (k 3 b1)) (s z)) (lam h2 (= (f 25 (k 3 b1) (k 3 a1)) (s z)) (eqelim x (= (k 3 a1) (k 3 x)) (app (app (inst iha b1) h1) h2) (refl (k 3 a1)))))))))))
