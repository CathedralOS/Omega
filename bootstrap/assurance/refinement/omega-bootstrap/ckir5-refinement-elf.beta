; Lower-rooted exact CKIR5..10 -> limited Linux x86-64 ELF checker.
; Concatenate after the shared OMGRFN7/8 R5 envelope and CKIR structure checker
; with both earlier main procedures removed.
;
; The preceding structure checker owns raw CKIR validation and independently
; derived constant image state. This suffix assigns the selected frame, sizes and
; reconstructs every canonical instruction, reconstructs all ELF program
; headers and all padding, compares exact envelope ELF bytes and EOF, and binds
; the low-eight-bit exit observation.  It emits no bytes.
;
; Globals: output cursor 525240, text cursor 525248, compare mode 525256,
; RX size 525264, trap offset 525272, frame size 525280, scratch base 525288,
; current machine 525296. Reachability/call graph/frame/live reconstruction
; occupies the private region beginning at 10800000. Block offsets start at
; 11000000, value slots at 11100000, and place slots at 11400000; all are
; disjoint from the CKIR5 evaluator's bounded call-frame region and the
; responsibility-5 constant reconstruction arenas at and above 13,000,000.

proc elf_align(value, alignment) {
    return ((value + alignment - 1) / alignment) * alignment
}

; Reconstruct only the value/place ownership and type tables consumed by frame
; assignment and emission. Complete operation semantics are the sibling R5
; structure conjunct's responsibility.
proc elf_assign_operation_types() {
    let op=0  let owner=0  let block=0  let kind=0  let result=0  let type_id=0
    let start=0  let count=0  let next_operand=0  let opcode=0  let logical_not_count=0 let logical_binary_count=0 let scalar_equal_count=0 let integer_widen_count=0
    state begin { ckir_initialize_value_scopes()  to operations }
    state operations { to one when (op < ckir_count(9))  to finish }
    state one {
        owner=ckir_op_word(op,4)  block=ckir_op_word(op,8)
        opcode=ckir_op_byte(op,12)
        kind=ckir_op_byte(op,13)  result=ckir_op_word(op,16)
        type_id=ckir_op_word(op,20)  start=ckir_op_word(op,24)  count=ckir_op_word(op,28)
        to bad when (owner >= ckir_count(3))
        to bad when (block >= ckir_count(5))
        to bad when (ckir_block_word(block,4) != owner)
        to bad when (start != next_operand)
        to bad when (ckir_span_ok(start,count,ckir_count(10)) == 0)
        to bad when (opcode < 1)
        to bad when (opcode > 21)
        to schema5_opcode when (ckir_schema() == 5)
        to schema6_opcode when (ckir_schema() == 6)
        to schema7_opcode when (ckir_schema() == 7)
        to schema8_opcode when (ckir_schema() == 8)
        to schema9_opcode when (ckir_schema() == 9)
        to result_kind
    }
    state schema5_opcode { to bad when (opcode >= 15)  to result_kind }
    state schema6_opcode { to bad when (opcode > 15)  to result_kind }
    state schema7_opcode { to bad when (opcode > 17)  to result_kind }
    state schema8_opcode { to bad when (opcode > 18)  to result_kind }
    state schema9_opcode { to bad when (opcode > 20)  to result_kind }
    state result_kind {
        next_operand=next_operand+count
        to no_result when (kind == 0)
        to value when (kind == 1)
        to place when (kind == 2)
        to bad
    }
    state no_result { to bad when (result != 4294967295)  to operation_ready }
    state value {
        to bad when (result != word[525208])
        to bad when (result >= ckir_count(12))
        to bad when (type_id >= ckir_count(0))
        word[6400000+result*8]=type_id  word[6700000+result*8]=owner
        word[7000000+result*8]=block  word[7300000+result*8]=op
        word[525208]=result+1  to operation_ready
    }
    state place {
        to bad when (result != word[525216])
        to bad when (result >= ckir_count(13))
        to bad when (type_id >= ckir_count(0))
        word[7600000+result*8]=type_id  word[8200000+result*8]=block
        word[8500000+result*8]=op  word[525216]=result+1  to operation_ready
    }
    state operation_ready { to logical_not when (opcode == 15) to logical_binary when (opcode == 16) to logical_binary when (opcode == 17) to scalar_equal when (opcode == 18) to integer_widen when (opcode == 21) to next }
    state logical_not {
        to bad when (kind != 1)
        to bad when (count != 1)
        to bad when (ckir_op_word(op,32) != 0)
        to bad when (ckir_op_word(op,36) != 0)
        to bad when (ckir_type_byte(type_id,4) != 3)
        to bad when (ckir_value_visible(ckir_operand(start),owner,block,op) == 0)
        to bad when (ckir_value_type(ckir_operand(start)) != type_id)
        logical_not_count=logical_not_count+1
        to next
    }
    state logical_binary {
        to bad when (kind != 1)
        to bad when (count != 2)
        to bad when (ckir_op_word(op,32) != 0)
        to bad when (ckir_op_word(op,36) != 0)
        to bad when (ckir_type_byte(type_id,4) != 3)
        to bad when (ckir_value_visible(ckir_operand(start),owner,block,op) == 0)
        to bad when (ckir_value_visible(ckir_operand(start+1),owner,block,op) == 0)
        to bad when (ckir_value_type(ckir_operand(start)) != type_id)
        to bad when (ckir_value_type(ckir_operand(start+1)) != type_id)
        logical_binary_count=logical_binary_count+1
        to next
    }
    state scalar_equal {
        to bad when (kind != 1)
        to bad when (count != 2)
        to bad when (ckir_op_word(op,32) != 0)
        to bad when (ckir_op_word(op,36) != 0)
        to bad when (ckir_type_byte(type_id,4) != 3)
        to bad when (ckir_value_visible(ckir_operand(start),owner,block,op) == 0)
        to bad when (ckir_value_visible(ckir_operand(start+1),owner,block,op) == 0)
        to bad when (ckir_value_type(ckir_operand(start)) != ckir_value_type(ckir_operand(start+1)))
        to bad when (ckir_type_byte(ckir_value_type(ckir_operand(start)),4) < 1)
        to bad when (ckir_type_byte(ckir_value_type(ckir_operand(start)),4) > 3)
        scalar_equal_count=scalar_equal_count+1
        to next
    }
    state integer_widen {
        to bad when (kind!=1) to bad when (count!=1)
        to bad when (ckir_op_word(op,32)!=0) to bad when (ckir_op_word(op,36)!=0)
        to bad when (ckir_value_visible(ckir_operand(start),owner,block,op)==0)
        integer_widen_count=integer_widen_count+1 to next
    }
    state next { op=op+1  to operations }
    state finish {
        to bad when (next_operand != ckir_count(10))
        to bad when (word[525208] != ckir_count(12))
        to bad when (word[525216] != ckir_count(13))
        to logical_not_required when (ckir_schema() == 6)
        to logical_binary_required when (ckir_schema() == 7)
        to scalar_equal_required when (ckir_schema() == 8)
        to integer_widen_required when (ckir_schema() == 10)
        return 0
    }
    state logical_not_required { to bad when (logical_not_count == 0)  return 0 }
    state logical_binary_required { to bad when (logical_binary_count == 0) return 0 }
    state scalar_equal_required { to bad when (scalar_equal_count == 0) return 0 }
    state integer_widen_required { to bad when (integer_widen_count == 0) return 0 }
    state bad { return 251 }
}

proc elf_expect_byte(value) {
    let cursor = word[525240]
    state bounds { to bad when (cursor >= word[524352])  to compare }
    state compare { to bad when (refinement_elf_byte(cursor) != value)  word[525240] = cursor + 1  return 0 }
    state bad { return 251 }
}

proc elf_expect_u16(value) {
    state first { to bad when (elf_expect_byte(value % 256) != 0)  to second }
    state second { to bad when (elf_expect_byte((value / 256) % 256) != 0)  return 0 }
    state bad { return 251 }
}

proc elf_expect_u32(value) {
    state b0 { to bad when (elf_expect_byte(value % 256) != 0)  to b1 }
    state b1 { to bad when (elf_expect_byte((value / 256) % 256) != 0)  to b2 }
    state b2 { to bad when (elf_expect_byte((value / 65536) % 256) != 0)  to b3 }
    state b3 { to bad when (elf_expect_byte((value / 16777216) % 256) != 0)  return 0 }
    state bad { return 251 }
}

proc elf_expect_u64(low, high) {
    state low { to bad when (elf_expect_u32(low) != 0)  to high }
    state high { to bad when (elf_expect_u32(high) != 0)  return 0 }
    state bad { return 251 }
}

proc elf_code_byte(value) {
    let cursor = word[525248]
    state limit { to exhausted when (cursor >= 1048576)  to compare }
    state compare { to advance when (word[525256] == 0)  to exact }
    state exact { to bad when (elf_expect_byte(value) != 0)  to advance }
    state advance { word[525248] = cursor + 1  return 0 }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc elf_code2(a, b) {
    let status = elf_code_byte(a)
    state a { to done when (status != 0)  status = elf_code_byte(b)  to done }
    state done { return status }
}

proc elf_code3(a, b, c) {
    let status = elf_code_byte(a)
    state a { to done when (status != 0)  status = elf_code_byte(b)  to b }
    state b { to done when (status != 0)  status = elf_code_byte(c)  to done }
    state done { return status }
}

proc elf_code4(a, b, c, d) {
    let status = elf_code_byte(a)
    state a { to done when (status != 0)  status = elf_code_byte(b)  to b }
    state b { to done when (status != 0)  status = elf_code_byte(c)  to c }
    state c { to done when (status != 0)  status = elf_code_byte(d)  to done }
    state done { return status }
}

proc elf_code_u32(value) {
    let status = elf_code_byte(value % 256)
    state b0 { to done when (status != 0)  status = elf_code_byte((value / 256) % 256)  to b1 }
    state b1 { to done when (status != 0)  status = elf_code_byte((value / 65536) % 256)  to b2 }
    state b2 { to done when (status != 0)  status = elf_code_byte((value / 16777216) % 256)  to done }
    state done { return status }
}

proc elf_code_s32(value) {
    state negative { to positive when (value >= 0)  return elf_code_u32(value + 4294967296) }
    state positive { return elf_code_u32(value) }
}

proc elf_code_rel32(target) {
    return elf_code_s32(target - (word[525248] + 4))
}

proc elf_value_slot(value_id) { return word[11100000 + value_id * 8] }
proc elf_place_slot(place_id) { return word[11400000 + place_id * 8] }

proc elf_load_value(value_id) {
    let status = elf_code2(139, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_value_slot(value_id))  to done }
    state done { return status }
}

proc elf_store_value(value_id) {
    let status = elf_code2(137, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_value_slot(value_id))  to done }
    state done { return status }
}

proc elf_load_place(place_id) {
    let status = elf_code3(72, 139, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_place_slot(place_id))  to done }
    state done { return status }
}

proc elf_store_place(place_id) {
    let status = elf_code3(72, 137, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_place_slot(place_id))  to done }
    state done { return status }
}

proc elf_trap_jump(opcode) {
    let status = elf_code2(15, opcode)
    state code { to done when (status != 0)  status = elf_code_rel32(word[525272])  to done }
    state done { return status }
}

proc elf_range_check(type_id) {
    let status = elf_code_byte(61)
    state low_opcode { to done when (status != 0)  status = elf_code_u32(ckir_type_word(type_id, 16))  to low }
    state low { to done when (status != 0)  status = elf_trap_jump(130)  to high_opcode }
    state high_opcode { to done when (status != 0)  status = elf_code_byte(61)  to high }
    state high { to done when (status != 0)  status = elf_code_u32(ckir_type_word(type_id, 20))  to high_jump }
    state high_jump { to done when (status != 0)  status = elf_trap_jump(135)  to done }
    state done { return status }
}

proc elf_reconstruct_calls() {
    let entry = word[525000]
    let machines = ckir_count(3)
    let i = 0  let j = 0  let op = 0  let caller = 0  let callee = 0
    let head = 0  let tail = 0  let produced = 0
    state clear_machines { to clear_machine when (i < machines)  i=0  to clear_blocks }
    state clear_machine {
        byte[10800000+i]=0  word[10830000+i*8]=0  byte[10831100+i]=0
        word[10834000+i*8]=0  i=i+1  to clear_machines
    }
    state clear_blocks { to clear_block when (i < ckir_count(5))  i=0  to clear_graph }
    state clear_block { word[11000000+i*8]=0  i=i+1  to clear_blocks }
    state clear_graph { to clear_edge when (i < machines*machines)  op=0  to scan }
    state clear_edge { byte[10810000+i]=0  i=i+1  to clear_graph }
    state scan { to scan_one when (op < ckir_count(9))  to topo_setup }
    state scan_one { to scan_next when (ckir_op_byte(op,12) != 10)  caller=ckir_op_word(op,4)  callee=ckir_op_word(op,32)  to bad when (caller >= machines)  to bad when (callee >= machines)  i=caller*machines+callee  to edge }
    state edge { to scan_next when (byte[10810000+i] == 1)  byte[10810000+i]=1  word[10830000+callee*8]=word[10830000+callee*8]+1  to scan_next }
    state scan_next { op=op+1  to scan }
    state topo_setup { produced=0  to topo }
    state topo { to cycle_check when (produced == machines)  i=0  to topo_find }
    state topo_find { to cycle when (i == machines)  to topo_next when (byte[10831100+i] == 1)  to topo_next when (word[10830000+i*8] != 0)  caller=i  byte[10831100+i]=1  word[10832000+produced*8]=i  produced=produced+1  j=0  to topo_drop }
    state topo_next { i=i+1  to topo_find }
    state topo_drop { to topo when (j == machines)  i=caller*machines+j  to topo_edge }
    state topo_edge { to topo_drop_next when (byte[10810000+i] == 0)  word[10830000+j*8]=word[10830000+j*8]-1  to topo_drop_next }
    state topo_drop_next { j=j+1  to topo_drop }
    state cycle_check { to reach_setup }
    state reach_setup { byte[10800000+entry]=1  word[10836000]=entry  head=0  tail=1  to reach }
    state reach { to done when (head == tail)  caller=word[10836000+head*8]  head=head+1  j=0  to reach_edges }
    state reach_edges { to reach when (j == machines)  i=caller*machines+j  to reach_edge }
    state reach_edge { to reach_next when (byte[10810000+i] == 0)  to reach_next when (byte[10800000+j] == 1)  byte[10800000+j]=1  word[10836000+tail*8]=j  tail=tail+1  to reach_next }
    state reach_next { j=j+1  to reach_edges }
    state cycle { return 251 }
    state bad { return 251 }
    state done { return 0 }
}

proc elf_assign_frames() {
    let machines=ckir_count(3)  let machine=0  let cursor=0  let i=0
    let width=0  let block=0  let block_end=0  let scratch=0  let op=0
    let caller=0  let callee=0  let live=0  let j=0
    let arm=0  let arm_end=0  let arg=0  let arg_end=0  let target=0
    state machines { to machine_one when (machine < machines)  i=0  to live_seed }
    state machine_one { to machine_next when (byte[10800000+machine] == 0)  cursor=8  i=0  to values }
    state values { to value_one when (i < word[525208])  i=0  to places }
    state value_one { to value_next when (ckir_value_machine(i) != machine)  width=4  to value_structural when (ckir_type_byte(ckir_value_type(i),4) > 3)  to value_slot }
    state value_structural { width=8  to value_slot }
    state value_slot { cursor=elf_align(cursor,width)+width  to exhausted when (cursor > 262144)  word[11100000+i*8]=cursor  to value_next }
    state value_next { i=i+1  to values }
    state places { to place_one when (i < word[525216])  i=0  to objects }
    state place_one { to place_next when (ckir_block_word(ckir_place_block(i),4) != machine)  cursor=elf_align(cursor,8)+8  to exhausted when (cursor > 262144)  word[11400000+i*8]=cursor  to place_next }
    state place_next { i=i+1  to places }
    state objects { to object_one when (i < ckir_count(9))  arm=0  to bindings }
    state object_one { to object_kind when (ckir_op_byte(i,12) == 13)  to object_kind when (ckir_op_byte(i,12) == 14)  to object_next }
    state object_kind { to object_next when (ckir_op_word(i,4) != machine)  width=ckir_op_word(i,20)  cursor=elf_align(cursor,word[6100000+width*8])  to object_size }
    state object_size { op=word[6000000+width*8]  to object_anchor when (op == 0)  to object_bound }
    state object_anchor { op=1  to object_bound }
    state object_bound { to exhausted when (op > 262144-cursor)  cursor=cursor+op  word[13900000+ckir_op_word(i,16)*8]=cursor  to object_next }
    state object_next { i=i+1  to objects }
    state bindings { to binding_arm when (arm < ckir_arm_count())  block=ckir_machine_word(machine,24)  block_end=block+ckir_machine_word(machine,28)  scratch=0  to scratch_blocks }
    state binding_arm {
        target=ckir_arm_word(arm,12)
        to binding_next when (ckir_block_word(target,4) != machine)
        arg=ckir_arm_word(arm,16)
        arg_end=arg+ckir_arm_word(arm,20)
        to binding_args
    }
    state binding_args { to binding_one when (arg < arg_end)  to binding_next }
    state binding_one { to binding_arg_next when (ckir_arm_arg_byte(arg,4) != 2)  width=ckir_payload_word(ckir_arm_arg_word(arg,8),12)  to binding_structural when (ckir_type_byte(width,4) > 3)  to binding_arg_next }
    state binding_structural { cursor=elf_align(cursor,word[6100000+width*8])  op=word[6000000+width*8]  to binding_anchor when (op == 0)  to binding_bound }
    state binding_anchor { op=1  to binding_bound }
    state binding_bound { to exhausted when (op > 262144-cursor)  cursor=cursor+op  word[14300000+arg*8]=cursor  to binding_arg_next }
    state binding_arg_next { arg=arg+1  to binding_args }
    state binding_next { arm=arm+1  to bindings }
    state scratch_blocks { to call_scan when (block == block_end)  to scratch_term }
    state scratch_term { to scratch_keep1 when (scratch >= ckir_term_word(block,28))  scratch=ckir_term_word(block,28)  to scratch_keep1 }
    state scratch_keep1 { to scratch_arms when (scratch >= ckir_term_word(block,40))  scratch=ckir_term_word(block,40)  to scratch_arms }
    state scratch_arms { arm=ckir_term_word(block,44)  arm_end=arm+ckir_term_word(block,48)  to scratch_arm_loop }
    state scratch_arm_loop { to scratch_arm when (arm < arm_end)  to scratch_next }
    state scratch_arm { to scratch_arm_next when (scratch >= ckir_arm_word(arm,20))  scratch=ckir_arm_word(arm,20)  to scratch_arm_next }
    state scratch_arm_next { arm=arm+1  to scratch_arm_loop }
    state scratch_next { block=block+1  to scratch_blocks }
    state call_scan { op=0  to calls }
    state calls { to frame_finish when (op == ckir_count(9))  to call_one when (ckir_op_word(op,4) == machine)  to call_next }
    state call_one { to call_next when (ckir_op_byte(op,12) != 10)  to call_next when (scratch >= ckir_op_word(op,28)-1)  scratch=ckir_op_word(op,28)-1  to call_next }
    state call_next { op=op+1  to calls }
    state frame_finish { cursor=elf_align(cursor,8)  word[10803000+machine*8]=cursor  to scratch_bound when (scratch <= (262144-cursor)/8)  to exhausted }
    state scratch_bound { cursor=elf_align(cursor+scratch*8,16)  to exhausted when (cursor > 262144)  word[10800000+1024+machine*8]=cursor  to machine_next }
    state machine_next { machine=machine+1  to machines }
    state live_seed { to exhausted when (word[10800000+1024+word[525000]*8] > 262128)  word[10834000+word[525000]*8]=word[10800000+1024+word[525000]*8]+16  to live_order }
    state live_order { to finish when (i == machines)  caller=word[10832000+i*8]  j=0  to live_edges }
    state live_edges { to live_next when (j == machines)  to live_edge when (byte[10810000+caller*machines+j] == 1)  to live_edge_next }
    state live_edge { to live_edge_next when (byte[10800000+caller] == 0)  callee=j  live=word[10834000+caller*8]+word[10800000+1024+callee*8]+16  to exhausted when (live > 262144)  to live_keep when (live > word[10834000+callee*8])  to live_edge_next }
    state live_keep { word[10834000+callee*8]=live  to live_edge_next }
    state live_edge_next { j=j+1  to live_edges }
    state live_next { i=i+1  to live_order }
    state finish { return 0 }
    state exhausted { return 252 }
}

proc elf_emit_case_payload(case_id, destination_base) {
    let field=ckir_case_word(case_id,12)
    let end=field+ckir_case_word(case_id,16)
    let type_id=0  let offset=0  let status=0
    state fields { to field_one when (field < end)  return 0 }
    state field_one {
        type_id=ckir_payload_word(field,12)
        offset=word[14100000+ckir_case_word(case_id,4)*8]+word[14000000+field*8]
        to scalar when (ckir_type_byte(type_id,4) < 4)
        status=elf_code3(73,129,195) to done when (status != 0)
        status=elf_code_u32(offset) to done when (status != 0)
        to nested_sum when (ckir_type_byte(type_id,4) == 6)
        status=elf_emit_copy_leaves(type_id,0,destination_base+offset) to restore
    }
    state nested_sum { status=elf_emit_sum_copy(type_id,destination_base+offset)  to restore }
    state restore {
        to done when (status != 0)
        status=elf_code3(73,129,235) to done when (status != 0)
        status=elf_code_u32(offset) to next
    }
    state scalar { status=elf_emit_copy_leaves(type_id,offset,destination_base+offset)  to next }
    state next { to done when (status != 0)  field=field+1  to fields }
    state done { return status }
}

proc elf_case_payload_size(case_id, destination_base) {
    let cursor=word[525248]  let mode=word[525256]  let status=0  let size=0
    state setup { word[525256]=0  status=elf_emit_case_payload(case_id,destination_base)  size=word[525248]-cursor  word[525248]=cursor  word[525256]=mode  to done }
    state done { to failed when (status != 0)  return size }
    state failed { return 4294967295 }
}

proc elf_emit_sum_copy(type_id, destination_base) {
    let owner=ckir_type_word(type_id,8)
    let case_id=ckir_sum_word(owner,8)
    let end=case_id+ckir_sum_word(owner,12)
    let case_count=ckir_sum_word(owner,12)
    let size=0  let target=0  let status=0
    state tag {
        status=elf_code3(65,139,11) to done when (status != 0)
        status=elf_code2(137,202) to done when (status != 0)
        status=elf_code2(137,200) to done when (status != 0)
        status=elf_code_byte(61) to done when (status != 0)
        status=elf_code_u32(case_count) to done when (status != 0)
        status=elf_trap_jump(131) to cases
    }
    state cases { to compare when (case_id < end)  to commit }
    state compare {
        size=elf_case_payload_size(case_id,destination_base)
        to exhausted when (size == 4294967295)
        status=elf_code2(129,249) to done when (status != 0)
        status=elf_code_u32(ckir_case_word(case_id,8)) to done when (status != 0)
        target=word[525248]+6+size+5
        status=elf_code2(15,133) to done when (status != 0)
        status=elf_code_rel32(target) to done when (status != 0)
        status=elf_emit_case_payload(case_id,destination_base) to done when (status != 0)
        status=elf_code_byte(185) to done when (status != 0)
        status=elf_code_u32(case_count) to done when (status != 0)
        case_id=case_id+1 to cases
    }
    state commit {
        status=elf_code3(65,137,146) to done when (status != 0)
        status=elf_code_u32(destination_base) to done
    }
    state exhausted { return 252 }
    state done { return status }
}

proc elf_emit_copy_leaves(type_id, source_base, destination_base) {
    let kind = ckir_type_byte(type_id, 4)
    let record = 0
    let field = 0
    let end = 0
    let element = 0
    let index = 0
    let length = 0
    let stride = 0
    let status = 0
    state kind { to scalar when (kind < 4)  to array when (kind == 5)  to sum when (kind == 6)  to record }
    state scalar {
        to scalar_word when (kind == 2)
        status = elf_code4(65, 15, 182, 131)
        to done when (status != 0)
        status = elf_code_u32(source_base)
        to done when (status != 0)
        status = elf_code3(65, 136, 130)
        to done when (status != 0)
        status = elf_code_u32(destination_base)
        to done
    }
    state scalar_word {
        status = elf_code3(65, 139, 131)
        to done when (status != 0)
        status = elf_code_u32(source_base)
        to done when (status != 0)
        status = elf_code3(65, 137, 130)
        to done when (status != 0)
        status = elf_code_u32(destination_base)
        to done
    }
    state record {
        record = ckir_type_word(type_id, 8)
        field = ckir_record_word(record, 8)
        end = field + ckir_record_word(record, 12)
        to fields
    }
    state fields { to field_one when (field < end)  return 0 }
    state field_one {
        status = elf_emit_copy_leaves(ckir_field_word(field, 12), source_base + word[6200000 + field * 8], destination_base + word[6200000 + field * 8])
        to done when (status != 0)
        field = field + 1
        to fields
    }
    state array {
        element = ckir_type_word(type_id, 8)
        length = ckir_type_word(type_id, 12)
        stride = word[6000000 + element * 8]
        to elements
    }
    state elements { to element_one when (index < length)  return 0 }
    state element_one {
        status = elf_emit_copy_leaves(element, source_base + index * stride, destination_base + index * stride)
        to done when (status != 0)
        index = index + 1
        to elements
    }
    state sum {
        status=elf_code3(73,129,195)
        to done when (status != 0)
        status=elf_code_u32(source_base)
        to done when (status != 0)
        status=elf_emit_sum_copy(type_id,destination_base)
        to done when (status != 0)
        status=elf_code3(73,129,235)
        to done when (status != 0)
        status=elf_code_u32(source_base)
        to done
    }
    state done { return status }
}

proc elf_emit_ordered(result,start,condition) {
    let a=ckir_operand(start) let b=ckir_operand(start+1) let status=elf_load_value(a)
    state left { to done when (status!=0) status=elf_code2(59,133) to done when (status!=0) status=elf_code_s32(0-elf_value_slot(b)) to done when (status!=0) status=elf_code4(15,condition,192,15) to done when (status!=0) status=elf_code2(182,192) to done when (status!=0) status=elf_store_value(result) to done }
    state done { return status }
}

proc elf_emit_operation(operation) {
    let opcode = ckir_op_byte(operation, 12)
    let result = ckir_op_word(operation, 16)
    let result_type = ckir_op_word(operation, 20)
    let start = ckir_op_word(operation, 24)
    let imm0 = ckir_op_word(operation, 32)
    let a = 0
    let b = 0
    let type_id = 0
    let argument_count = 0
    let ordinal = 0
    let displacement = 0
    let status = 0
    state dispatch {
        to constant when (opcode == 1)
        to self_place when (opcode == 2)
        to field_place when (opcode == 3)
        to index_place when (opcode == 4)
        to load when (opcode == 5)
        to store when (opcode == 6)
        to copy when (opcode == 7)
        to add when (opcode == 8)
        to less when (opcode == 9)
        to call when (opcode == 10)
        to copy_constant when (opcode == 11)
        to constructor when (opcode == 13)
        to case_constructor when (opcode == 14)
        to logical_not when (opcode == 15)
        to logical_and when (opcode == 16)
        to logical_or when (opcode == 17)
        to scalar_equal when (opcode == 18)
        to greater when (opcode == 19)
        to greater_equal when (opcode == 20)
        to integer_widen when (opcode == 21)
        to less_equal
    }
    state constant {
        status = elf_code_byte(184)
        to done when (status != 0)
        status = elf_code_u32(imm0)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state integer_widen {
        a=ckir_operand(start)
        status=elf_load_value(a) to done when (status!=0)
        status=elf_code3(15,182,192) to done when (status!=0)
        status=elf_store_value(result) to done
    }
    state self_place {
        status = elf_code3(72, 139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - 8)
        to done when (status != 0)
        status = elf_store_place(result)
        to done
    }
    state field_place {
        a = ckir_operand(start)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code2(72, 5)
        to done when (status != 0)
        status = elf_code_u32(word[6200000 + imm0 * 8])
        to done when (status != 0)
        status = elf_store_place(result)
        to done
    }
    state index_place {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        type_id = ckir_place_type(a)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_load_value(b)
        to done when (status != 0)
        status = elf_code4(137, 193, 129, 249)
        to done when (status != 0)
        status = elf_code_u32(ckir_type_word(type_id, 12))
        to done when (status != 0)
        status = elf_trap_jump(131)
        to done when (status != 0)
        status = elf_code3(72, 105, 201)
        to done when (status != 0)
        status = elf_code_u32(word[6000000 + ckir_type_word(type_id, 8) * 8])
        to done when (status != 0)
        status = elf_code3(73, 1, 202)
        to done when (status != 0)
        status = elf_code3(76, 137, 208)
        to done when (status != 0)
        status = elf_store_place(result)
        to done
    }
    state load {
        a = ckir_operand(start)
        status = elf_load_place(a)
        to done when (status != 0)
        to load_word when (ckir_type_byte(result_type, 4) == 2)
        status = elf_code3(15, 182, 0)
        to load_store
    }
    state load_word { status = elf_code2(139, 0)  to load_store }
    state load_store {
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state store {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        type_id = ckir_place_type(a)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_load_value(b)
        to done when (status != 0)
        status = elf_range_check(type_id)
        to done when (status != 0)
        to store_word when (ckir_type_byte(type_id, 4) == 2)
        status = elf_code3(65, 136, 2)
        to done
    }
    state store_word { status = elf_code3(65, 137, 2)  to done }
    state copy {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_code3(76, 139, 157)
        to done when (status != 0)
        to copy_value when (imm0 == 1)
        status = elf_code_s32(0 - elf_place_slot(b))
        type_id = ckir_place_type(b)
        to copy_leaves
    }
    state copy_value {
        status = elf_code_s32(0 - elf_value_slot(b))
        type_id = ckir_value_type(b)
        to copy_leaves
    }
    state copy_leaves {
        to done when (status != 0)
        to copy_sum when (ckir_type_byte(type_id,4) == 6)
        status = elf_emit_copy_leaves(type_id, 0, 0)
        to done
    }
    state copy_sum { status=elf_emit_sum_copy(type_id,0)  to done }
    state copy_constant {
        a = ckir_operand(start)
        type_id = ckir_place_type(a)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_code3(72, 141, 53)
        to done when (status != 0)
        status = elf_code_rel32(word[525264] - 4096 + word[13400000 + imm0 * 8])
        to done when (status != 0)
        status = elf_code3(76, 137, 215)
        to done when (status != 0)
        status = elf_code_byte(185)
        to done when (status != 0)
        status = elf_code_u32(word[6000000 + type_id * 8])
        to done when (status != 0)
        status = elf_code2(243, 164)
        to done
    }
    state add {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_value(a)
        to done when (status != 0)
        status = elf_code2(3, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(b))
        to done when (status != 0)
        status = elf_trap_jump(130)
        to done when (status != 0)
        status = elf_range_check(result_type)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state less {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_value(a)
        to done when (status != 0)
        status = elf_code2(59, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(b))
        to done when (status != 0)
        status = elf_code4(15, 146, 192, 15)
        to done when (status != 0)
        status = elf_code2(182, 192)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state less_equal {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_value(a)
        to done when (status != 0)
        status = elf_code2(59, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(b))
        to done when (status != 0)
        status = elf_code4(15, 150, 192, 15)
        to done when (status != 0)
        status = elf_code2(182, 192)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state logical_not {
        a = ckir_operand(start)
        status = elf_load_value(a)
        to done when (status != 0)
        status = elf_code3(131, 240, 1)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state logical_and { a=ckir_operand(start) b=ckir_operand(start+1) status=elf_load_value(a) to done when (status!=0) status=elf_code2(35,133) to done when (status!=0) status=elf_code_s32(0-elf_value_slot(b)) to done when (status!=0) status=elf_store_value(result) to done }
    state logical_or { a=ckir_operand(start) b=ckir_operand(start+1) status=elf_load_value(a) to done when (status!=0) status=elf_code2(11,133) to done when (status!=0) status=elf_code_s32(0-elf_value_slot(b)) to done when (status!=0) status=elf_store_value(result) to done }
    state scalar_equal { a=ckir_operand(start) b=ckir_operand(start+1) status=elf_load_value(a) to done when (status!=0) status=elf_code2(59,133) to done when (status!=0) status=elf_code_s32(0-elf_value_slot(b)) to done when (status!=0) status=elf_code4(15,148,192,15) to done when (status!=0) status=elf_code2(182,192) to done when (status!=0) status=elf_store_value(result) to done }
    state greater { status=elf_emit_ordered(result,start,151) to done }
    state greater_equal { status=elf_emit_ordered(result,start,147) to done }
    state call { argument_count=ckir_op_word(operation,28)-1  ordinal=0  to call_arguments }
    state call_arguments { to call_receiver when (ordinal == argument_count)  b=ckir_operand(start+1+ordinal)  displacement=0-(word[525288]+(argument_count-ordinal)*8)  to call_structural when (ckir_type_byte(ckir_value_type(b),4) > 3)  status=elf_load_value(b)  to done when (status != 0)  status=elf_code2(137,133)  to call_store }
    state call_structural { status=elf_code3(72,139,133)  to done when (status != 0)  status=elf_code_s32(0-elf_value_slot(b))  to done when (status != 0)  status=elf_code3(72,137,133)  to done when (status != 0)  to call_store }
    state call_store { status=elf_code_s32(displacement)  to done when (status != 0)  ordinal=ordinal+1  to call_arguments }
    state call_receiver { a=ckir_operand(start)  status=elf_load_place(a)  to done when (status != 0)  status=elf_code3(72,137,199)  to done when (status != 0)  to call_no_arguments when (argument_count == 0)  status=elf_code3(72,141,181)  to done when (status != 0)  status=elf_code_s32(0-(word[525288]+argument_count*8))  to call_target }
    state call_no_arguments { status=elf_code2(49,246)  to done when (status != 0)  to call_target }
    state call_target { displacement=ckir_machine_word(imm0,32)  status=elf_code_byte(232)  to done when (status != 0)  to call_sizing when (word[525256] == 0)  to call_known }
    state call_sizing { to call_forward when (displacement > ckir_op_word(operation,8))  to call_known }
    state call_known { status=elf_code_rel32(word[11000000+displacement*8])  to call_after }
    state call_forward { status=elf_code_rel32(0)  to call_after }
    state call_after { to done when (status != 0)  to call_result when (ckir_op_byte(operation,13) == 1)  to done }
    state call_result { status=elf_store_value(result)  to done }
    state constructor {
        type_id=ckir_type_word(result_type,8)
        status=elf_code3(76,141,149)
        to done when (status != 0)
        status=elf_code_s32(0-word[13900000+result*8])
        ordinal=0
        to constructor_fields
    }
    state constructor_fields { to constructor_field when (ordinal < ckir_op_word(operation,28))  to constructor_publish }
    state constructor_field {
        imm0=ckir_record_word(type_id,8)+ordinal
        a=ckir_operand(start+ordinal)
        b=ckir_field_word(imm0,12)
        displacement=word[6200000+imm0*8]
        to constructor_structural when (ckir_type_byte(b,4) > 3)
        status=elf_load_value(a)
        to done when (status != 0)
        status=elf_range_check(b)
        to done when (status != 0)
        to constructor_scalar_word when (ckir_type_byte(b,4) == 2)
        status=elf_code3(65,136,130)
        to constructor_scalar_offset
    }
    state constructor_scalar_word { status=elf_code3(65,137,130)  to constructor_scalar_offset }
    state constructor_scalar_offset { to done when (status != 0)  status=elf_code_u32(displacement)  to constructor_next }
    state constructor_structural {
        status=elf_code3(76,139,157)
        to done when (status != 0)
        status=elf_code_s32(0-elf_value_slot(a))
        to done when (status != 0)
        status=elf_emit_copy_leaves(b,0,displacement)
        to constructor_next
    }
    state constructor_next { to done when (status != 0)  ordinal=ordinal+1  to constructor_fields }
    state constructor_publish {
        status=elf_code3(76,137,149)
        to done when (status != 0)
        status=elf_code_s32(0-elf_value_slot(result))
        to done
    }
    state case_constructor {
        type_id=ckir_case_word(imm0,4)
        status=elf_code3(76,141,149)
        to done when (status != 0)
        status=elf_code_s32(0-word[13900000+result*8])
        to done when (status != 0)
        status=elf_code3(65,199,2)
        to done when (status != 0)
        status=elf_code_u32(ckir_case_word(imm0,8))
        ordinal=0
        to case_constructor_fields
    }
    state case_constructor_fields { to case_constructor_field when (ordinal < ckir_case_word(imm0,16))  to constructor_publish }
    state case_constructor_field {
        b=ckir_case_word(imm0,12)+ordinal
        a=ckir_operand(start+ordinal)
        type_id=ckir_payload_word(b,12)
        displacement=word[14100000+ckir_case_word(imm0,4)*8]+word[14000000+b*8]
        to case_constructor_structural when (ckir_type_byte(type_id,4) > 3)
        status=elf_load_value(a) to done when (status != 0)
        status=elf_range_check(type_id) to done when (status != 0)
        to case_constructor_word when (ckir_type_byte(type_id,4) == 2)
        status=elf_code3(65,136,130) to case_constructor_offset
    }
    state case_constructor_word { status=elf_code3(65,137,130)  to case_constructor_offset }
    state case_constructor_offset { to done when (status != 0)  status=elf_code_u32(displacement)  to case_constructor_next }
    state case_constructor_structural {
        status=elf_code3(76,139,157) to done when (status != 0)
        status=elf_code_s32(0-elf_value_slot(a)) to done when (status != 0)
        to case_constructor_sum when (ckir_type_byte(type_id,4) == 6)
        status=elf_emit_copy_leaves(type_id,0,displacement) to case_constructor_next
    }
    state case_constructor_sum { status=elf_emit_sum_copy(type_id,displacement)  to case_constructor_next }
    state case_constructor_next { to done when (status != 0)  ordinal=ordinal+1  to case_constructor_fields }
    state done { return status }
}

proc elf_edge_size(start, count) {
    let i = 0
    let value_id = 0
    let size = 5
    state loop { to one when (i < count)  return size }
    state one {
        value_id = ckir_operand(start + i)
        to structural when (ckir_type_byte(ckir_value_type(value_id), 4) > 3)
        size = size + 46
        to next
    }
    state structural { size = size + 28  to next }
    state next { i = i + 1  to loop }
}

proc elf_emit_edge(target, start, count) {
    let i = 0
    let value_id = 0
    let parameter = 0
    let scratch = 0
    let status = 0
    state stage { to stage_one when (i < count)  i = 0  to commit }
    state stage_one {
        value_id = ckir_operand(start + i)
        scratch = word[525288] + (i + 1) * 8
        to stage_classify
    }
    state stage_classify {
        to stage_structural when (ckir_type_byte(ckir_value_type(value_id), 4) > 3)
        status = elf_load_value(value_id)
        to done when (status != 0)
        status = elf_code2(137, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to stage_next
    }
    state stage_structural {
        status = elf_code3(72, 139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(value_id))
        to done when (status != 0)
        status = elf_code3(72, 137, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to stage_next
    }
    state stage_next { to done when (status != 0)  i = i + 1  to stage }
    state commit { to commit_one when (i < count)  to jump }
    state commit_one {
        parameter = ckir_block_word(target, 12) + i
        value_id = ckir_bparam_word(parameter, 16)
        scratch = word[525288] + (i + 1) * 8
        to commit_structural when (ckir_type_byte(ckir_value_type(value_id), 4) > 3)
        status = elf_code2(139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to done when (status != 0)
        status = elf_range_check(ckir_value_type(value_id))
        to done when (status != 0)
        status = elf_store_value(value_id)
        to commit_next
    }
    state commit_structural {
        status = elf_code3(72, 139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to done when (status != 0)
        status = elf_code3(72, 137, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(value_id))
        to commit_next
    }
    state commit_next { to done when (status != 0)  i = i + 1  to commit }
    state jump {
        status = elf_code_byte(233)
        to done when (status != 0)
        to jump_sizing when (word[525256] == 0)
        to jump_known
    }
    state jump_sizing {
        to jump_forward when (target > word[525320])
        to jump_known
    }
    state jump_known {
        status = elf_code_rel32(word[11000000 + target * 8])
        to done
    }
    state jump_forward { status=elf_code_rel32(0)  to done }
    state done { return status }
}

proc elf_emit_case_edge(arm) {
    let i=0  let arg=0  let kind=0  let reference=0  let type_id=0
    let value_id=0  let parameter=0  let scratch=0  let offset=0  let status=0
    let target=ckir_arm_word(arm,12)
    let start=ckir_arm_word(arm,16)
    let count=ckir_arm_word(arm,20)
    state stage { to stage_one when (i < count)  i=0  to commit }
    state stage_one {
        arg=start+i  kind=ckir_arm_arg_byte(arg,4)  reference=ckir_arm_arg_word(arg,8)
        scratch=word[525288]+(i+1)*8
        to ordinary when (kind == 1)
        type_id=ckir_payload_word(reference,12)
        offset=word[14100000+ckir_case_word(ckir_arm_word(arm,8),4)*8]+word[14000000+reference*8]
        to payload_structural when (ckir_type_byte(type_id,4) > 3)
        to payload_wide when (ckir_type_byte(type_id,4) == 2)
        status=elf_code4(65,15,182,131) to payload_offset
    }
    state payload_wide { status=elf_code3(65,139,131)  to payload_offset }
    state payload_offset { to done when (status != 0)  status=elf_code_u32(offset)  to done when (status != 0)  status=elf_code2(137,133)  to stage_store }
    state payload_structural {
        status=elf_code3(73,129,195) to done when (status != 0)
        status=elf_code_u32(offset) to done when (status != 0)
        status=elf_code3(76,141,149) to done when (status != 0)
        status=elf_code_s32(0-word[14300000+arg*8]) to done when (status != 0)
        to payload_sum when (ckir_type_byte(type_id,4) == 6)
        status=elf_emit_copy_leaves(type_id,0,0) to done when (status != 0)
        to payload_restore
    }
    state payload_sum {
        status=elf_emit_sum_copy(type_id,0) to done when (status != 0)
        to payload_restore
    }
    state payload_restore {
        status=elf_code3(73,129,235) to done when (status != 0)
        status=elf_code_u32(offset) to done when (status != 0)
        status=elf_code3(72,141,133) to done when (status != 0)
        status=elf_code_s32(0-word[14300000+arg*8]) to done when (status != 0)
        status=elf_code3(72,137,133) to stage_store
    }
    state ordinary {
        value_id=reference  type_id=ckir_value_type(value_id)
        to ordinary_structural when (ckir_type_byte(type_id,4) > 3)
        status=elf_load_value(value_id) to done when (status != 0)
        status=elf_code2(137,133) to stage_store
    }
    state ordinary_structural {
        status=elf_code3(72,139,133) to done when (status != 0)
        status=elf_code_s32(0-elf_value_slot(value_id)) to done when (status != 0)
        status=elf_code3(72,137,133) to stage_store
    }
    state stage_store { to done when (status != 0)  status=elf_code_s32(0-scratch)  to stage_next }
    state stage_next { to done when (status != 0)  i=i+1  to stage }
    state commit { to commit_one when (i < count)  to jump }
    state commit_one {
        parameter=ckir_block_word(target,12)+i
        value_id=ckir_bparam_word(parameter,16)
        type_id=ckir_value_type(value_id)
        scratch=word[525288]+(i+1)*8
        to commit_structural when (ckir_type_byte(type_id,4) > 3)
        status=elf_code2(139,133) to done when (status != 0)
        status=elf_code_s32(0-scratch) to done when (status != 0)
        status=elf_range_check(type_id) to done when (status != 0)
        status=elf_store_value(value_id) to commit_next
    }
    state commit_structural {
        status=elf_code3(72,139,133) to done when (status != 0)
        status=elf_code_s32(0-scratch) to done when (status != 0)
        status=elf_code3(72,137,133) to done when (status != 0)
        status=elf_code_s32(0-elf_value_slot(value_id)) to commit_next
    }
    state commit_next { to done when (status != 0)  i=i+1  to commit }
    state jump { status=elf_code_byte(233) to done when (status != 0)  to jump_sizing when (word[525256] == 0)  to jump_known }
    state jump_sizing { to jump_forward when (target > word[525320])  to jump_known }
    state jump_known { status=elf_code_rel32(word[11000000+target*8]) to done }
    state jump_forward { status=elf_code_rel32(0)  to done }
    state done { return status }
}

proc elf_case_edge_size(arm) {
    let cursor=word[525248]  let mode=word[525256]  let status=0  let size=0
    state setup { word[525256]=0  status=elf_emit_case_edge(arm)  size=word[525248]-cursor  word[525248]=cursor  word[525256]=mode  to done }
    state done { to failed when (status != 0)  return size }
    state failed { return 4294967295 }
}

proc elf_emit_terminator(block) {
    let kind = ckir_term_byte(block, 12)
    let status = 0
    let skip = 0
    let subject=0  let type_id=0  let owner=0  let ordinal=0
    let arm=0  let arm_end=0
    state dispatch {
        to jump when (kind == 1)
        to branch when (kind == 2)
        to unit when (kind == 3)
        to case_dispatch when (kind == 5)
        to value_return
    }
    state jump {
        status = elf_emit_edge(ckir_term_word(block, 20), ckir_term_word(block, 24), ckir_term_word(block, 28))
        to done
    }
    state branch {
        status = elf_load_value(ckir_term_word(block, 16))
        to done when (status != 0)
        status = elf_code4(133, 192, 15, 132)
        to done when (status != 0)
        skip = word[525248] + 4 + elf_edge_size(ckir_term_word(block, 24), ckir_term_word(block, 28))
        status = elf_code_rel32(skip)
        to done when (status != 0)
        status = elf_emit_edge(ckir_term_word(block, 20), ckir_term_word(block, 24), ckir_term_word(block, 28))
        to done when (status != 0)
        status = elf_emit_edge(ckir_term_word(block, 32), ckir_term_word(block, 36), ckir_term_word(block, 40))
        to done
    }
    state unit { status = elf_code2(201, 195)  to done }
    state value_return {
        status = elf_load_value(ckir_term_word(block, 16))
        to done when (status != 0)
        status = elf_range_check(ckir_machine_word(word[525296], 12))
        to done when (status != 0)
        status = elf_code2(201, 195)
        to done
    }
    state case_dispatch {
        subject=ckir_term_word(block,16)
        to case_value when (ckir_term_byte(block,13) == 1)
        status=elf_code3(76,139,157) to done when (status != 0)
        status=elf_code_s32(0-elf_place_slot(subject))
        type_id=ckir_place_type(subject)
        to case_tag
    }
    state case_value {
        status=elf_code3(76,139,157) to done when (status != 0)
        status=elf_code_s32(0-elf_value_slot(subject))
        type_id=ckir_value_type(subject)
        to case_tag
    }
    state case_tag {
        to done when (status != 0)
        owner=ckir_type_word(type_id,8)
        status=elf_code3(65,139,3) to done when (status != 0)
        status=elf_code_byte(61) to done when (status != 0)
        status=elf_code_u32(ckir_sum_word(owner,12)) to done when (status != 0)
        status=elf_trap_jump(131) to done when (status != 0)
        arm=ckir_term_word(block,44)  arm_end=arm+ckir_term_word(block,48)  ordinal=0
        to case_arms
    }
    state case_arms { to case_arm when (arm < arm_end)  to bad }
    state case_arm { to case_last when (arm+1 == arm_end)  skip=elf_case_edge_size(arm)  to exhausted when (skip == 4294967295)  status=elf_code_byte(61) to done when (status != 0)  status=elf_code_u32(ordinal) to done when (status != 0)  skip=word[525248]+6+skip  status=elf_code2(15,133) to done when (status != 0)  status=elf_code_rel32(skip) to done when (status != 0)  status=elf_emit_case_edge(arm) to done when (status != 0)  arm=arm+1  ordinal=ordinal+1  to case_arms }
    state case_last { status=elf_emit_case_edge(arm)  to done }
    state exhausted { return 252 }
    state bad { return 251 }
    state done { return status }
}

proc elf_emit_block(block) {
    let operation = ckir_block_word(block, 20)
    let end = operation + ckir_block_word(block, 24)
    let parameter = 0
    let parameter_end = 0
    let ordinal = 0
    let value = 0
    let type_id = 0
    let status = 0
    state setup {
        word[525320]=block
        word[525296]=ckir_block_word(block,4)
        word[525280]=word[10800000+1024+word[525296]*8]
        word[525288]=word[10803000+word[525296]*8]
        to operations when (block != ckir_machine_word(word[525296], 32))
        status = elf_code4(85, 72, 137, 229)
        to done when (status != 0)
        status = elf_code3(72, 129, 236)
        to done when (status != 0)
        status = elf_code_u32(word[525280])
        to done when (status != 0)
        status = elf_code3(72, 137, 189)
        to done when (status != 0)
        status = elf_code_s32(0 - 8)
        to done when (status != 0)
        parameter=ckir_machine_word(word[525296],16)
        parameter_end=parameter+ckir_machine_word(word[525296],20)
        ordinal=0
        to parameters
    }
    state parameters { to operations when (parameter == parameter_end)  value=ckir_mparam_word(parameter,16)  type_id=ckir_mparam_word(parameter,12)  to parameter_structural when (ckir_type_byte(type_id,4) > 3)  status=elf_code2(139,134)  to done when (status != 0)  status=elf_code_s32(ordinal*8)  to done when (status != 0)  status=elf_range_check(type_id)  to done when (status != 0)  status=elf_store_value(value)  to parameter_next }
    state parameter_structural { status=elf_code3(72,139,134)  to done when (status != 0)  status=elf_code_s32(ordinal*8)  to done when (status != 0)  status=elf_code3(72,137,133)  to done when (status != 0)  status=elf_code_s32(0-elf_value_slot(value))  to parameter_next }
    state parameter_next { to done when (status != 0)  parameter=parameter+1  ordinal=ordinal+1  to parameters }
    state operations { to operation_one when (operation < end)  to terminator }
    state operation_one {
        status = elf_emit_operation(operation)
        to done when (status != 0)
        operation = operation + 1
        to operations
    }
    state terminator { status = elf_emit_terminator(block)  to done }
    state done { return status }
}

proc elf_emit_text() {
    let entry = word[525000]
    let machine = 0
    let block = 0
    let end = 0
    let status = 0
    state shim {
        status = elf_code3(72, 141, 61)
        to done when (status != 0)
        status = elf_code_rel32(word[525264] + word[525312] - 4096)
        to done when (status != 0)
        status = elf_code_byte(232)
        to done when (status != 0)
        status = elf_code_rel32(word[11000000 + ckir_machine_word(entry, 32) * 8])
        to done when (status != 0)
        status = elf_code4(15, 182, 248, 184)
        to done when (status != 0)
        status = elf_code_u32(231)
        to done when (status != 0)
        status = elf_code4(15, 5, 15, 11)
        to done when (status != 0)
        word[525272] = word[525248]
        status = elf_code2(15, 11)
        to done when (status != 0)
        machine=0
        to machines
    }
    state machines { to done_success when (machine == ckir_count(3))  to machine_next when (byte[10800000+machine] == 0)  block=ckir_machine_word(machine,24)  end=block+ckir_machine_word(machine,28)  to blocks }
    state blocks { to block_one when (block < end)  machine=machine+1  to machines }
    state block_one {
        to record when (word[525256] == 0)
        to bad when (word[11000000 + block * 8] != word[525248])
        to emit
    }
    state record { word[11000000 + block * 8] = word[525248]  to emit }
    state emit {
        status = elf_emit_block(block)
        to done when (status != 0)
        block = block + 1
        to blocks
    }
    state machine_next { machine=machine+1  to machines }
    state done_success { return 0 }
    state bad { return 251 }
    state done { return status }
}

proc elf_expect_header(rx_size, ro_size, bss_size) {
    let i = 0
    let status = 0
    state ident {
        status = elf_expect_byte(127)
        to done when (status != 0)
        status = elf_expect_byte('E')
        to done when (status != 0)
        status = elf_expect_byte('L')
        to done when (status != 0)
        status = elf_expect_byte('F')
        to done when (status != 0)
        status = elf_expect_byte(2)
        to done when (status != 0)
        status = elf_expect_byte(1)
        to done when (status != 0)
        status = elf_expect_byte(1)
        to done when (status != 0)
        i = 7
        to ident_zero
    }
    state ident_zero { to elf_header when (i == 16)  status = elf_expect_byte(0)  to done when (status != 0)  i = i + 1  to ident_zero }
    state elf_header {
        status = elf_expect_u16(2) to done when (status != 0)
        status = elf_expect_u16(62) to done when (status != 0)
        status = elf_expect_u32(1) to done when (status != 0)
        status = elf_expect_u64(4198400, 0) to done when (status != 0)
        status = elf_expect_u64(64, 0) to done when (status != 0)
        status = elf_expect_u64(0, 0) to done when (status != 0)
        status = elf_expect_u32(0) to done when (status != 0)
        status = elf_expect_u16(64) to done when (status != 0)
        status = elf_expect_u16(56) to done when (status != 0)
        to three when (ro_size > 0)
        status = elf_expect_u16(2) to header_tail
    }
    state three { status = elf_expect_u16(3) to header_tail }
    state header_tail {
        to done when (status != 0)
        status = elf_expect_u16(0) to done when (status != 0)
        status = elf_expect_u16(0) to done when (status != 0)
        status = elf_expect_u16(0) to done when (status != 0)
        to rx
    }
    state rx {
        status = elf_expect_u32(1) to done when (status != 0)
        status = elf_expect_u32(5) to done when (status != 0)
        status = elf_expect_u64(0, 0) to done when (status != 0)
        status = elf_expect_u64(4194304, 0) to done when (status != 0)
        status = elf_expect_u64(4194304, 0) to done when (status != 0)
        status = elf_expect_u64(rx_size, 0) to done when (status != 0)
        status = elf_expect_u64(rx_size, 0) to done when (status != 0)
        status = elf_expect_u64(4096, 0) to done when (status != 0)
        to ro when (ro_size > 0)
        to rw
    }
    state ro {
        status = elf_expect_u32(1) to done when (status != 0)
        status = elf_expect_u32(4) to done when (status != 0)
        status = elf_expect_u64(rx_size, 0) to done when (status != 0)
        status = elf_expect_u64(4194304 + rx_size, 0) to done when (status != 0)
        status = elf_expect_u64(4194304 + rx_size, 0) to done when (status != 0)
        status = elf_expect_u64(ro_size, 0) to done when (status != 0)
        status = elf_expect_u64(ro_size, 0) to done when (status != 0)
        status = elf_expect_u64(4096, 0) to done when (status != 0)
        to rw
    }
    state rw {
        status = elf_expect_u32(1) to done when (status != 0)
        status = elf_expect_u32(6) to done when (status != 0)
        status = elf_expect_u64(rx_size + ro_size, 0) to done when (status != 0)
        status = elf_expect_u64(4194304 + rx_size + ro_size, 0) to done when (status != 0)
        status = elf_expect_u64(4194304 + rx_size + ro_size, 0) to done when (status != 0)
        status = elf_expect_u64(0, 0) to done when (status != 0)
        status = elf_expect_u64(bss_size, 0) to done when (status != 0)
        status = elf_expect_u64(4096, 0)
        to done
    }
    state done { return status }
}

proc elf_expect_zero_until(limit) {
    state loop { to done when (word[525240] >= limit)  to one }
    state one { to bad when (elf_expect_byte(0) != 0)  to loop }
    state done { return 0 }
    state bad { return 251 }
}

proc elf_expect_constant_image() {
    let i = 0
    state bytes { to done when (i >= word[525304])  to bad when (elf_expect_byte(byte[13700000 + i]) != 0) i = i + 1 to bytes }
    state done { return 0 }
    state bad { return 251 }
}

proc ckir5_refinement_elf_check() {
    let entry = word[525000]
    let status = 0
    let text_size = 0
    let rx_size = 0
    let ro_size = word[525312]
    let owner_type = 0
    let owner_size = 0
    let bss_size = 0
    let header_size = 176
    state library { to entry when (entry != 4294967295)  to library_checks }
    state library_checks {
        to bad when (word[524352] != 0)
        to bad when (word[524368] != 4294967295)
        return 0
    }
    state entry {
        status = elf_reconstruct_calls()
        to done when (status != 0)
        status = elf_assign_frames()
        to done when (status != 0)
        word[525256] = 0
        word[525248] = 0
        word[525264] = 0
        status = elf_emit_text()
        to done when (status != 0)
        text_size = word[525248]
        rx_size = elf_align(4096 + text_size, 4096)
        word[525264] = rx_size
        to exhausted when (ro_size > 1183744)
        to exhausted when (rx_size > 1183744 - ro_size)
        to bad when (word[524352] != rx_size + ro_size)
        owner_type = ckir_record_word(ckir_machine_word(entry, 4), 4)
        owner_size = word[6000000 + owner_type * 8]
        bss_size = elf_align(owner_size, 4096)
        to bss_nonzero when (owner_size == 0)
        to header_setup
    }
    state bss_nonzero { bss_size = 4096  to header_setup }
    state header_setup { to header_three when (ro_size > 0)  to header }
    state header_three { header_size = 232  to header }
    state header {
        word[525240] = 0
        status = elf_expect_header(rx_size, ro_size, bss_size)
        to done when (status != 0)
        to bad when (word[525240] != header_size)
        status = elf_expect_zero_until(4096)
        to done when (status != 0)
        word[525256] = 1
        word[525248] = 0
        status = elf_emit_text()
        to done when (status != 0)
        to bad when (word[525248] != text_size)
        status = elf_expect_zero_until(rx_size)
        to done when (status != 0)
        to finish when (ro_size == 0)
        status = elf_expect_constant_image()
        to done when (status != 0)
        status = elf_expect_zero_until(rx_size + ro_size)
        to done when (status != 0)
        to finish
    }
    state finish {
        to bad when (word[525240] != word[524352])
        ; The sibling CKIR/result executable independently owns the full result
        ; and therefore its low-byte projection. This executable owns only the
        ; complete CKIR-to-artifact relation and shares no evaluator state.
        return 0
    }
    state exhausted { return 252 }
    state bad { return 251 }
    state done { return status }
}

proc main() {
    let status = omgrfn5_component_read()
    state envelope { to done when (status != 0)  to artifact }
    state artifact { status = ckir5_refinement_structure_check()  to done when (status != 0)  to elf }
    state elf { status = ckir5_refinement_elf_check()  to done }
    state done { return status }
}
