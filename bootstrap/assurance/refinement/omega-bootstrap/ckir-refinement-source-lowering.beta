proc src_reconstruct_lowering_check() {
    let status=0
    let i=0
    state find_types { src_low_gset(11,4294967295)  src_low_gset(12,4294967295)  to scan }
    state scan { to type_one when (i < word[10000144])  to missing }
    state type_one { to bool when (src_ck_type(i,0) == 3)  to u32 when (src_ck_type(i,0) == 2)  i=i+1  to scan }
    state bool { to next when (src_ck_type(i,4) != 0)  to next when (src_ck_type(i,5) != 1)  src_low_gset(11,i)  to next }
    state u32 { to next when (src_ck_type(i,4) != 0)  to next when (src_ck_type(i,5) != 2147483647)  src_low_gset(12,i)  to next }
    state next { i=i+1  to scan }
    state missing { to bad when (src_low_g(11) >= word[10000144])  to bad when (src_low_g(12) >= word[10000144])  to lower }
    state lower { status=src_low_all_bodies()  to done }
    state bad { status=src_reject() }
    state done { return status }
}

proc src_refinement_lowering_check() {
    let status=src_reconstruct_lowering_check()
    state reconstruct { to done when (status != 0)  status=src_lower_compare_final()  to done }
    state done { return status }
}

proc main() {
    let status=refinement_envelope_read()
    state envelope { to done when (status != 0)  to bundle }
    state bundle { status=refinement_source_decode_bundle()  to done when (status != 0)  to tables }
    state tables { status=src_reconstruct_tables_check()  to done when (status != 0)  to lowering }
    state lowering { status=src_reconstruct_lowering_check()  to done when (status != 0)  to decode }
    state decode { status=src_low_decode_validated_ckir()  to done when (status != 0)  to compare_types }
    state compare_types { status=src_compare_types_records()  to done when (status != 0)  to compare_machines }
    state compare_machines { status=src_compare_machines_blocks()  to done when (status != 0)  to compare_lowering }
    state compare_lowering { status=src_lower_compare_final()  to done }
    state done { return status }
}
