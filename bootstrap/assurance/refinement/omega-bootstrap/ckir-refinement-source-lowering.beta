    state index_bound { to bad when (index_high >= src_type(base_type,5))  to index_left when (src_low_g(30) >= index_tree)  src_low_gset(30,index_tree)  to index_left }
    state index_left { src_low_gset(20,src_type(base_type,4))  src_low_gset(21,src_type(src_type(base_type,4),7))  src_low_gset(22,src_type(src_type(base_type,4),8))  src_low_gset(23,base_lvalue)  src_low_gset(24,base_mutable)  src_low_gset(25,0)  src_low_gset(26,4294967295)  src_low_gset(29,src_low_g(29)+1)  src_low_gset(30,src_low_g(30)+1)  to exhausted when (src_low_g(30) > 8)  to index_emit }
    state index_emit { src_low_gset(50,base_place)  src_low_gset(51,index_value)  src_low_gset(52,0)  to done when (src_low_emit(4,2,src_type(src_type(base_type,4),9),2) != 0)  to loop }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
