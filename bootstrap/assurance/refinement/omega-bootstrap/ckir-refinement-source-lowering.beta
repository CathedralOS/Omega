    state literal_emit { to done when (src_low_binary(8,4294967295,src_low_g(12),4294967294) != 0)  to loop }
    state typed_emit { to done when (src_low_binary(8,target,src_type(target,9),target) != 0)  to loop }
    state bad { src_reject()  to done }
    state done { return word[10000000] }
}

proc src_low_expression() {
    let left_type=0
    let right_type=0
    let target=0
    state init { src_low_gset(41,0)  to add }
