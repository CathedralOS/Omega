    state member_refine { to member_emit when (src_low_g(5) == 4294967295)  to member_emit when (word[19600000+src_low_g(5)*32] != 1)  to member_emit when (word[19600008+src_low_g(5)*32] != 1)  to member_emit when (word[19600016+src_low_g(5)*32] != field)  to member_emit when (src_low_g(22) <= word[19600024+src_low_g(5)*32])  src_low_gset(22,word[19600024+src_low_g(5)*32])  to member_emit }
    state member_emit { src_low_gset(50,base_place)  src_low_gset(51,0)  src_low_gset(52,field)  to done when (src_low_emit(3,2,src_type(src_field(field,3),9),1) != 0)  src_next()  to loop }
    state index { to exhausted when (src_low_g(29) >= 8)  base_type=src_low_g(20)  base_place=src_low_g(28)  base_lvalue=src_low_g(23)  base_mutable=src_low_g(24)  to index_type }
    state index_type { to bad when (base_type >= word[10000048])  to bad when (src_type(base_type,0) != 5)  to index_push }
    state index_push { to done when (src_low_push_expr() != 0)  src_next()  to index_parse }
    state index_parse { to done when (src_low_expression() != 0)  to index_close }
    state index_close { to done when (src_expect_token(93) != 0)  to index_numeric }
    state index_numeric { to index_materialize when (src_low_g(20) == 4294967294)  to bad when (src_low_g(20) >= word[10000048])  to index_kind }
    state index_kind { to index_materialize when (src_type(src_low_g(20),0) == 1)  to index_materialize when (src_type(src_low_g(20),0) == 2)  to bad }
    state index_materialize { to index_literal when (src_low_g(20) == 4294967294)  to index_typed }
    state index_literal { to done when (src_low_materialize(src_low_g(12)) != 0)  to index_save }
    state index_typed { to done when (src_low_materialize(src_type(src_low_g(20),9)) != 0)  to index_save }
