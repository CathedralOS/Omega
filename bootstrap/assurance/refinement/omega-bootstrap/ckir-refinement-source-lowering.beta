; Independent source-body -> canonical CKIR1 operation/terminator reconstruction.
; Concatenate after the envelope, source-input, and source-tables fragments with
; their main procedures removed.  All source bodies are reparsed
; into disjoint memory.  No CKIR operation, operand, block-body, terminator,
; value-count, or place-count word is read until src_lower_compare_final.
;
; Status 251 is a relation/syntax failure and 252 is a published source/CKIR
; ceiling.  This layer reconstructs lowering, not the selected source result.
; The gate runs the full artifact checker as a disjoint first conjunct.  This
; suffix decodes only the already-validated CKIR table locations so the composed
; source checker remains below Beta's 128-procedure ceiling.

proc ckir_u32(at) { return refinement_ckir_byte(at)+refinement_ckir_byte(at+1)*256+refinement_ckir_byte(at+2)*65536+refinement_ckir_byte(at+3)*16777216 }
proc ckir_row_word(table,id,stride,off) { return ckir_u32(word[525112+table*8]+id*stride+off) }
proc ckir_row_byte(table,id,stride,off) { return refinement_ckir_byte(word[525112+table*8]+id*stride+off) }
proc ckir_bparam_word(id,off) { return ckir_row_word(6,id,20,off) }
proc ckir_operand(id) { return ckir_u32(word[525112+8*8]+id*4) }

proc src_low_decode_validated_ckir() {
    let i=0
    state entry { word[525000]=ckir_u32(16)  to counts }
    state counts { to count_one when (i < 12)  to bases }
    state count_one { word[525016+i*8]=ckir_u32(24+i*4)  i=i+1  to counts }
    state bases {
        word[525112]=72
        word[525120]=word[525112]+word[525016+0*8]*24
        word[525128]=word[525120]+word[525016+1*8]*20
        word[525136]=word[525128]+word[525016+2*8]*16
        word[525144]=word[525136]+word[525016+3*8]*36
        word[525152]=word[525144]+word[525016+4*8]*20
        word[525160]=word[525152]+word[525016+5*8]*32
        word[525168]=word[525160]+word[525016+6*8]*20
        word[525176]=word[525168]+word[525016+7*8]*40
        word[525184]=word[525176]+word[525016+8*8]*4
        return 0
    }
}

proc src_lower_op(id, field) { return word[15000000 + id * 72 + field * 8] }
proc src_low_op_set(id, field, value) { word[15000000 + id * 72 + field * 8]=value  return value }
proc src_lower_operand(id) { return word[17400000 + id * 8] }
proc src_low_operand_set(id, value) { word[17400000 + id * 8]=value  return value }
proc src_low_block(id, field) { return word[18200000 + id * 24 + field * 8] }
proc src_low_block_set(id, field, value) { word[18200000 + id * 24 + field * 8]=value  return value }
proc src_lower_term(id, field) { return word[18300000 + id * 160 + field * 8] }
proc src_low_term_set(id, field, value) { word[18300000 + id * 160 + field * 8]=value  return value }
proc src_low_stack(id, field) { return word[18700000 + id * 88 + field * 8] }
proc src_low_stack_set(id, field, value) { word[18700000 + id * 88 + field * 8]=value  return value }

; Lowering globals at 18800000:
; 0 op count, 1 operand count, 2 value count, 3 place count,
; 4 current machine, 5 current state/NO_ID, 6 current block,
; 7 current receiver mutable, 8 current result old type/NO_ID,
; 9 expression stack depth, 10 statement count, 11 bool CK type,
; 12 full-u32 CK type, 13 current terminator set.
; Expression at fields 20..30: old type, low, high, lvalue, mutable,
; subject kind, subject id, value id, place id, path depth, tree depth.
proc src_low_g(field) { return word[18800000 + field * 8] }
proc src_low_gset(field, value) { word[18800000 + field * 8]=value  return value }

; Stable derived-row API for the separate source-result evaluator.  Value/place
; type arrays are at 18900000 and 19300000; state fact rows occupy 19600000.
proc src_lower_value_type(id) { return word[18900000+id*8] }
proc src_lower_place_type(id) { return word[19300000+id*8] }

proc src_low_expr_save(slot) {
    let i=0
    state loop { to one when (i < 11)  return 0 }
    state one { src_low_stack_set(slot,i,src_low_g(20+i))  i=i+1  to loop }
}

proc src_low_expr_load(slot) {
    let i=0
    state loop { to one when (i < 11)  return 0 }
    state one { src_low_gset(20+i,src_low_stack(slot,i))  i=i+1  to loop }
}

proc src_low_push_expr() {
    let depth=src_low_g(9)
    state capacity { to exhausted when (depth >= 8)  src_low_expr_save(depth)  src_low_gset(9,depth+1)  return 0 }
    state exhausted { return src_exhaust() }
}

; Save the current (right) expression in slot 8 and restore the pushed left.
proc src_low_pop_left() {
    let depth=src_low_g(9)
    state depth { to bad when (depth == 0)  src_low_expr_save(8)  depth=depth-1  src_low_gset(9,depth)  src_low_expr_load(depth)  return 0 }
    state bad { return src_reject() }
}

proc src_low_find_field(owner, start, count) {
    let i=src_record(owner,3)
    let end=i+src_record(owner,4)
    state loop { to one when (i < end)  return 4294967295 }
    state one { to next when (src_field(i,2) != count)  to found when (src_spans_equal(start,src_field(i,1),count) == 1)  to next }
    state next { i=i+1  to loop }
    state found { return i }
}

proc src_low_find_param(start, count) {
    let i=0
    let end=0
    let state_id=src_low_g(5)
    let machine=src_low_g(4)
    state state_check { to machine_begin when (state_id == 4294967295)  i=src_state(state_id,3)  end=i+src_state(state_id,4)  to state_loop }
    state state_loop { to state_one when (i < end)  to machine_begin }
    state state_one { to state_next when (src_param(i,2) != count)  to found when (src_spans_equal(start,src_param(i,1),count) == 1)  to state_next }
    state state_next { i=i+1  to state_loop }
    state machine_begin { i=src_machine(machine,5)  end=i+src_machine(machine,6)  to machine_loop }
    state machine_loop { to machine_one when (i < end)  return 4294967295 }
    state machine_one { to machine_next when (src_param(i,2) != count)  to found when (src_spans_equal(start,src_param(i,1),count) == 1)  to machine_next }
    state machine_next { i=i+1  to machine_loop }
    state found { return i }
}

proc src_low_find_state(machine, start, count) {
    let i=src_machine(machine,12)
    let end=i+src_machine(machine,13)
    state loop { to one when (i < end)  return 4294967295 }
    state one { to next when (src_state(i,2) != count)  to found when (src_spans_equal(start,src_state(i,1),count) == 1)  to next }
    state next { i=i+1  to loop }
    state found { return i }
}

proc src_low_types_same(left, right) {
    let kind=0
    state exact { to yes when (left == right)  to no when (left >= word[10000048])  to no when (right >= word[10000048])  kind=src_type(left,0)  to no when (kind != src_type(right,0))  to nominal when (kind == 4)  to array when (kind == 5)  to yes }
    state nominal { to no when (src_type(left,3) != src_type(right,3))  to yes }
    state array { to no when (src_type(left,5) != src_type(right,5))  return src_low_types_same(src_type(left,4),src_type(right,4)) }
    state yes { return 1 }
    state no { return 0 }
}

proc src_low_scalar_assignable(expected, actual) {
    state literal_int { to int_expected when (actual == 4294967294)  to literal_bool }
    state int_expected { to no when (src_type(expected,0) > 2)  to range }
    state literal_bool { to bool_expected when (actual == 4294967293)  to typed }
    state bool_expected { to no when (src_type(expected,0) != 3)  to yes }
    state typed { to no when (src_low_types_same(expected,actual) == 0)  to range when (src_type(expected,0) < 3)  to yes }
    state range { to no when (src_low_g(21) < src_type(expected,7))  to no when (src_low_g(22) > src_type(expected,8))  to yes }
    state yes { return 1 }
    state no { return 0 }
}

; Call arity stays within Beta's four-argument ceiling.  Operand payload is
; staged in globals 50..52 before entry.
proc src_low_emit(opcode, result_kind, result_type, operand_count) {
    let op=src_low_g(0)
    let operands=src_low_g(1)
    let result=4294967295
    state capacity { to exhausted when (op >= 32768)  to operand_capacity }
    state operand_capacity { to exhausted when (operand_count > 94208-operands)  to result }
    state result { to no_result when (result_kind == 0)  to value when (result_kind == 1)  to place }
    state value { to exhausted when (src_low_g(2) >= 36864)  result=src_low_g(2)  word[18900000+result*8]=result_type  src_low_gset(2,result+1)  src_low_gset(27,result)  src_low_gset(28,4294967295)  to store }
    state place { to exhausted when (src_low_g(3) >= 32768)  result=src_low_g(3)  word[19300000+result*8]=result_type  src_low_gset(3,result+1)  src_low_gset(27,4294967295)  src_low_gset(28,result)  to store }
    state no_result { result=4294967295  result_type=4294967295  src_low_gset(27,4294967295)  src_low_gset(28,4294967295)  to store }
    state store {
        src_low_op_set(op,0,src_low_g(4))  src_low_op_set(op,1,src_low_g(6))
        src_low_op_set(op,2,opcode)  src_low_op_set(op,3,result_kind)
        src_low_op_set(op,4,result)  src_low_op_set(op,5,result_type)
        src_low_op_set(op,6,operands)  src_low_op_set(op,7,operand_count)
        src_low_op_set(op,8,src_low_g(52))  to operand0_check
    }
    state operand0_check { to finish when (operand_count == 0)  src_low_operand_set(operands,src_low_g(50))  operands=operands+1  to operand1_check }
    state operand1_check { to finish when (operand_count == 1)  src_low_operand_set(operands,src_low_g(51))  operands=operands+1  to finish }
    state finish { src_low_gset(0,op+1)  src_low_gset(1,operands)  src_low_block_set(src_low_g(6),1,src_low_block(src_low_g(6),1)+1)  return 0 }
    state exhausted { return src_exhaust() }
}

proc src_low_materialize(result_type) {
    state value { to done when (src_low_g(27) != 4294967295)  to place }
    state place { to literal when (src_low_g(28) == 4294967295)  src_low_gset(50,src_low_g(28))  src_low_gset(51,0)  src_low_gset(52,0)  return src_low_emit(5,1,src_type(src_low_g(20),9),1) }
    state literal { src_low_gset(50,0)  src_low_gset(51,0)  src_low_gset(52,src_low_g(21))  return src_low_emit(1,1,result_type,0) }
    state done { return 0 }
}

proc src_low_primary() {
    let id=0
    state init {
        src_low_gset(20,4294967295)  src_low_gset(21,0)  src_low_gset(22,0)
        src_low_gset(23,0)  src_low_gset(24,0)  src_low_gset(25,0)
        src_low_gset(26,4294967295)  src_low_gset(27,4294967295)
