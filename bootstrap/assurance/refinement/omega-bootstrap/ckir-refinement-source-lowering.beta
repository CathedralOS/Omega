    state false_value { src_low_gset(20,4294967293)  src_low_gset(21,0)  src_low_gset(22,0)  src_next()  return word[10000000] }
    state self_value {
        id=src_machine(src_low_g(4),9)  src_low_gset(20,id)
        src_low_gset(23,1)  src_low_gset(24,src_low_g(7))
        src_low_gset(25,3)  src_low_gset(26,src_machine(src_low_g(4),2))
        src_next()  to self_emit
    }
    state self_emit { src_low_gset(50,0)  src_low_gset(51,0)  src_low_gset(52,0)  return src_low_emit(2,2,src_type(id,9),0) }
    state parameter { id=src_low_find_param(word[524424],word[524432])  to bad when (id == 4294967295)  src_low_gset(20,src_param(id,3))  src_low_gset(21,src_type(src_param(id,3),7))  src_low_gset(22,src_type(src_param(id,3),8))  src_low_gset(23,1)  src_low_gset(25,2)  src_low_gset(26,id)  src_low_gset(27,id)  to parameter_refine }
    state parameter_refine { to parameter_advance when (src_low_g(5) == 4294967295)  to parameter_advance when (word[19600000+src_low_g(5)*32] != 1)  to parameter_advance when (word[19600008+src_low_g(5)*32] != 2)  to parameter_advance when (word[19600016+src_low_g(5)*32] != id)  to parameter_advance when (src_low_g(22) <= word[19600024+src_low_g(5)*32])  src_low_gset(22,word[19600024+src_low_g(5)*32])  to parameter_advance }
    state parameter_advance { src_next()  return word[10000000] }
    state paren { to bad when (word[524416] != 40)  src_next()  to parse }
    state parse { to done when (src_low_expression() != 0)  to close }
    state close { to done when (src_expect_token(41) != 0)  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_low_postfix() {
    let base_type=0
    let base_place=0
    let base_lvalue=0
    let base_mutable=0
    let field=0
    let index_value=0
    let index_high=0
    let index_tree=0
