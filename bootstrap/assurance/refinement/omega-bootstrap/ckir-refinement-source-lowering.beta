; The right expression is in slot 8 and the active expression is the left.
proc src_low_binary(opcode, operand_type, result_type, result_old_type) {
    let left_value=0
    let right_value=0
    let left_type=src_low_g(20)
    let left_low=src_low_g(21)
    let left_high=src_low_g(22)
    let right_low=src_low_stack(8,1)
    let right_high=src_low_stack(8,2)
    let left_tree=src_low_g(30)
    let right_tree=src_low_stack(8,10)
    let material_type=0
    state right_restore { src_low_expr_save(9)  src_low_expr_load(8)  to right_type }
    state right_type { material_type=src_low_g(12)  to right_typed when (operand_type != 4294967295)  to right_materialize }
    state right_typed { material_type=src_type(operand_type,9)  to right_materialize }
    state right_materialize { to done when (src_low_materialize(material_type) != 0)  right_value=src_low_g(27)  src_low_expr_load(9)  to left_materialize }
    state left_materialize { to done when (src_low_materialize(material_type) != 0)  left_value=src_low_g(27)  to emit }
    state emit { src_low_gset(50,left_value)  src_low_gset(51,right_value)  src_low_gset(52,0)  to done when (src_low_emit(opcode,1,result_type,2) != 0)  src_low_gset(20,result_old_type)  src_low_gset(21,left_low+right_low)  src_low_gset(22,left_high+right_high)  src_low_gset(23,0)  src_low_gset(24,0)  src_low_gset(25,0)  src_low_gset(26,4294967295)  src_low_gset(29,0)  src_low_gset(30,left_tree)  to tree_right when (right_tree > left_tree)  to tree_add }
    state tree_right { src_low_gset(30,right_tree)  to tree_add }
    state tree_add { src_low_gset(30,src_low_g(30)+1)  to exhausted when (src_low_g(30) > 8)  to done }
    state exhausted { src_exhaust()  to done }
    state done { return word[10000000] }
}

proc src_low_add() {
    let left_type=0
    let right_type=0
    let target=0
