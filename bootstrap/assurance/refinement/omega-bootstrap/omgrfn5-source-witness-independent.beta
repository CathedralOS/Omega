        to bad when (omgrfn4_r2_tkind(source_id,t)!=256)
        omgrfn4_r2_find_record(source_id,t) rid=word[879132]
        to bad when (rid==4294967295)
        word[879100]=100+rid word[879108]=source_id word[879116]=t
        omgrfn4_r2_next(source_id) return 0
    }
    state u32 { word[879100]=202 omgrfn4_r2_next(source_id) to u32_constraint }
    state u32_constraint {
        t=omgrfn4_r2_cur(source_id)
        to trapping when (omgrfn4_r2_is_word(source_id,t,9)==1)
        to range_open when (omgrfn4_r2_tkind(source_id,t)==91)
        return 0
    }
    state trapping { omgrfn4_r2_next(source_id) to bad when (omgrfn4_r2_expect_word(source_id,10)!=0) word[879100]=203 return 0 }
    state range_open { omgrfn4_r2_next(source_id) t=omgrfn4_r2_cur(source_id) to range_low }
    state range_low { to bad when (omgrfn4_r2_number(source_id,t)!=0) to bad when (word[879000]!=0) omgrfn4_r2_next(source_id) to dot1 }
    state dot1 { to bad when (omgrfn4_r2_expect_kind(source_id,46)!=0) to dot2 }
    state dot2 { to bad when (omgrfn4_r2_expect_kind(source_id,46)!=0) to equal }
    state equal { to bad when (omgrfn4_r2_expect_kind(source_id,61)!=0) t=omgrfn4_r2_cur(source_id) to range_high }
    state range_high { to bad when (omgrfn4_r2_number(source_id,t)!=0) high=word[879000] omgrfn4_r2_next(source_id) to close_range }
    state close_range { to bad when (omgrfn4_r2_expect_kind(source_id,93)!=0) to bad when (high!=65536) word[879100]=204 return 0 }
    state array { omgrfn4_r2_next(source_id) t=omgrfn4_r2_cur(source_id) to array_u8 }
    state array_u8 { to bad when (omgrfn4_r2_is_word(source_id,t,7)==0) omgrfn4_r2_next(source_id) to semi }
    state semi { to bad when (omgrfn4_r2_expect_kind(source_id,59)!=0) t=omgrfn4_r2_cur(source_id) to count }
    state count { to bad when (omgrfn4_r2_number(source_id,t)!=0) to bad when (word[879000]!=65536) omgrfn4_r2_next(source_id) to array_close }
    state array_close { to bad when (omgrfn4_r2_expect_kind(source_id,93)!=0) to array_in }
    state array_in { to bad when (omgrfn4_r2_expect_word(source_id,9)!=0) to array_trap }
    state array_trap { to bad when (omgrfn4_r2_expect_word(source_id,10)!=0) word[879100]=205 return 0 }
    state bad { return omgrfn4_l2_reject() }
}

