proc omgrfn2_l2_emit_records_fields() {
    let rid = 0 let source = 0 let dep = word[700024]
    state records { to find_record when (rid < 2)  rid = 0  to fields }
    state find_record { source = 0  to find_record_loop }
    state find_record_loop { to record_row when (omgrfn2_l2_fact(source,41) == rid)  source = source + 1  to find_record_loop }
    state record_row { omgrfn2_l2_put_u32(rid) omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,40)) omgrfn2_l2_put_u32(rid) omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,42)) omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,16)) omgrfn2_l2_put_byte(omgrfn2_l2_fact(source,7)) omgrfn2_l2_put_byte(0) omgrfn2_l2_put_byte(0) omgrfn2_l2_put_byte(0) rid = rid + 1 to records }
    state fields { to find_field_owner when (rid < 2)  return 0 }
    state find_field_owner { source = 0  to find_field_loop }
    state find_field_loop { to field0 when (omgrfn2_l2_fact(source,41) == rid)  source = source + 1  to find_field_loop }
    state field0 { omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,42)) omgrfn2_l2_put_u32(rid) omgrfn2_l2_put_u32(0) to dep_type0 when (source == dep) to root_type0 }
    state dep_type0 { omgrfn2_l2_put_u32(4) to field0_name }
    state root_type0 { omgrfn2_l2_put_u32(omgrfn2_l2_fact(dep,41)) to field0_name }
    state field0_name { omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,8)) omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,9)) to field1 when (omgrfn2_l2_fact(source,16) == 2) rid = rid + 1 to fields }
    state field1 { omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,42)+1) omgrfn2_l2_put_u32(rid) omgrfn2_l2_put_u32(1) omgrfn2_l2_put_u32(4) omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,12)) omgrfn2_l2_put_u32(omgrfn2_l2_fact(source,13)) rid = rid + 1 to fields }
}

proc omgrfn2_l2_emit_machine_block() {
    let root = word[700032]
    omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(omgrfn2_l2_fact(root,43)) omgrfn2_l2_put_u32(omgrfn2_l2_fact(root,41))
    omgrfn2_l2_put_byte(2) omgrfn2_l2_put_byte(0) omgrfn2_l2_put_u16(0)
    omgrfn2_l2_put_u32(4) omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(1) omgrfn2_l2_put_u32(0)
    ; Empty machine-parameter table, followed directly by one block row.
    omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(0)
    omgrfn2_l2_put_byte(2) omgrfn2_l2_put_byte(0) omgrfn2_l2_put_u16(0)
    omgrfn2_l2_put_u32(omgrfn2_l2_fact(root,32)) omgrfn2_l2_put_u32(omgrfn2_l2_fact(root,33))
    omgrfn2_l2_put_u32(4294967295) omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(0) omgrfn2_l2_put_u32(0)
    return 0
}

proc omgrfn2_l2_build_expected() {
    word[700048] = 0
    omgrfn2_l2_emit_header()
    omgrfn2_l2_emit_units()
    omgrfn2_l2_emit_import()
    omgrfn2_l2_emit_bindings()
    omgrfn2_l2_emit_declarations()
    omgrfn2_l2_emit_types()
    omgrfn2_l2_emit_records_fields()
    omgrfn2_l2_emit_machine_block()
    state length { to bad when (word[700048] != 652)  return 0 }
    state bad { return omgrfn2_l2_reject() }
}

proc omgrfn2_l2_compare_expected() {
    let i = 0
    state length { to bad when (word[500048] != word[700048])  to loop }
    state loop { to one when (i < word[700048])  return 0 }
    state one { to bad when (omgrfn2_l2_witness_byte(i) != byte[900000+i])  i = i + 1  to loop }
    state bad { return omgrfn2_l2_reject() }
}

proc omgrfn2_l2_check() {
    let status = 0 let source = 0 let dep_count = 0 let root_count = 0
    word[700000] = 0
    status = omgrfn2_l2_read_frame()
    state framed { to done when (status != 0)  status = omgrfn2_l2_decode_compilation()  to done when (status != 0)  status = omgrfn2_l2_decode_witness()  to done when (status != 0)  to fixture_shape }
    state fixture_shape { to bad when (word[500320] != 2)  to bad when (word[500312] != 2)  omgrfn2_l2_init_words()  to tokenize }
    state tokenize { to tokenize_one when (source < 2)  source = 0  to classify }
    state tokenize_one { status = omgrfn2_l2_tokenize_source(source)  to done when (status != 0)  status = omgrfn2_l2_parse_source(source)  to done when (status != 0)  source = source + 1  to tokenize }
    state classify { to classify_one when (source < 2)  to exact_roles }
    state classify_one { to dep when (omgrfn2_l2_fact(source,3) == 1)  to root when (omgrfn2_l2_fact(source,3) == 2)  to bad }
    state dep { dep_count = dep_count + 1  word[700024] = source  source = source + 1  to classify }
    state root { root_count = root_count + 1  word[700032] = source  source = source + 1  to classify }
    state exact_roles { to bad when (dep_count != 1)  to bad when (root_count != 1)  status = omgrfn2_l2_resolve_join()  to done when (status != 0)  omgrfn2_l2_assign_ids()  omgrfn2_l2_build_expected()  to done when (word[700000] != 0)  omgrfn2_l2_compare_expected()  to done }
    state bad { status = omgrfn2_l2_reject()  to done }
    state done { return word[700000] }
}
