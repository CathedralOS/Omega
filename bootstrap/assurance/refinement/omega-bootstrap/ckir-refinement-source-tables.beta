; Independent source declaration/signature/layout reconstruction for CKIR1.
; Concatenate after the envelope, source-input, and artifact fragments with
; their main procedures removed.  This checker parses names rather than
; recognizing fixture bytes and independently recreates the canonical CKIR1
; declaration tables.  Operation and terminator correspondence is a later
; source-body layer.
;
; Memory above 10 MiB is disjoint from the envelope and CKIR checker.

proc src_record(id, field) { return word[10100000 + id * 72 + field * 8] }
proc src_record_set(id, field, value) { word[10100000 + id * 72 + field * 8] = value  return value }
proc src_field(id, field) { return word[10200000 + id * 40 + field * 8] }
proc src_field_set(id, field, value) { word[10200000 + id * 40 + field * 8] = value  return value }
proc src_machine(id, field) { return word[10600000 + id * 128 + field * 8] }
proc src_machine_set(id, field, value) { word[10600000 + id * 128 + field * 8] = value  return value }
proc src_state(id, field) { return word[10700000 + id * 72 + field * 8] }
proc src_state_set(id, field, value) { word[10700000 + id * 72 + field * 8] = value  return value }
proc src_param(id, field) { return word[10900000 + id * 32 + field * 8] }
proc src_param_set(id, field, value) { word[10900000 + id * 32 + field * 8] = value  return value }
proc src_type(id, field) { return word[11100000 + id * 104 + field * 8] }
proc src_type_set(id, field, value) { word[11100000 + id * 104 + field * 8] = value  return value }
proc src_ck_type(id, field) { return word[14600000 + id * 48 + field * 8] }
proc src_ck_type_set(id, field, value) { word[14600000 + id * 48 + field * 8] = value  return value }

proc src_reject() {
    state set { to done when (word[10000000] != 0)  word[10000000] = 251 }
    state done { return word[10000000] }
}

proc src_exhaust() { word[10000000] = 252  return 252 }

proc src_init_words() {
    ; datacopymachinemutselfstatetransitiontruefalseu8u32boolinTrapping
    byte[10001000]=100  byte[10001001]=97  byte[10001002]=116  byte[10001003]=97
    byte[10001004]=99  byte[10001005]=111  byte[10001006]=112  byte[10001007]=121
    byte[10001008]=109  byte[10001009]=97  byte[10001010]=99  byte[10001011]=104
    byte[10001012]=105  byte[10001013]=110  byte[10001014]=101
    byte[10001015]=109  byte[10001016]=117  byte[10001017]=116
    byte[10001018]=115  byte[10001019]=101  byte[10001020]=108  byte[10001021]=102
    byte[10001022]=115  byte[10001023]=116  byte[10001024]=97  byte[10001025]=116  byte[10001026]=101
    byte[10001027]=116  byte[10001028]=114  byte[10001029]=97  byte[10001030]=110  byte[10001031]=115
    byte[10001032]=105  byte[10001033]=116  byte[10001034]=105  byte[10001035]=111  byte[10001036]=110
    byte[10001037]=116  byte[10001038]=114  byte[10001039]=117  byte[10001040]=101
    byte[10001041]=102  byte[10001042]=97  byte[10001043]=108  byte[10001044]=115  byte[10001045]=101
    byte[10001046]=117  byte[10001047]=56
    byte[10001048]=117  byte[10001049]=51  byte[10001050]=50
    byte[10001051]=98  byte[10001052]=111  byte[10001053]=111  byte[10001054]=108
    byte[10001055]=105  byte[10001056]=110
    byte[10001057]=84  byte[10001058]=114  byte[10001059]=97  byte[10001060]=112
    byte[10001061]=112  byte[10001062]=105  byte[10001063]=110  byte[10001064]=103
    return 0
}

proc src_token_word(base, count) {
    let i = 0
    state token { to no when (word[524416] != 256)  to length }
    state length { to no when (word[524432] != count)  to loop }
    state loop { to one when (i < count)  return 1 }
    state one { to no when (refinement_source_byte(word[524424] + i) != byte[10001000 + base + i])  i = i + 1  to loop }
    state no { return 0 }
}

proc src_spans_equal(left, right, count) {
    let i = 0
    state loop { to one when (i < count)  return 1 }
    state one { to no when (refinement_source_byte(left + i) != refinement_source_byte(right + i))  i = i + 1  to loop }
    state no { return 0 }
}

proc src_next() {
    let status = refinement_source_next_token()
    state status_check { to failed when (status != 0)  to limit }
    state limit {
        to eof when (word[524424] >= word[10000128])
        return 0
    }
    state eof { word[524416] = 0  word[524424] = word[10000128]  word[524432] = 0  return 0 }
    state failed { word[10000000] = status  return status }
}

proc src_expect_token(expected) {
    state check { to bad when (word[524416] != expected)  src_next()  return word[10000000] }
    state bad { return src_reject() }
}

proc src_expect_word(base, count) {
    state check { to bad when (src_token_word(base, count) == 0)  src_next()  return word[10000000] }
    state bad { return src_reject() }
}

proc src_find_data(start, count) {
    let i = 0
    state loop { to one when (i < word[10000016])  return 4294967295 }
    state one { to next when (src_record(i, 1) != count)  to compare }
    state compare { to found when (src_spans_equal(start, src_record(i, 0), count) == 1)  to next }
    state found { return i }
    state next { i = i + 1  to loop }
}

proc src_data_name_exists(start, count) {
    state check { to no when (src_find_data(start, count) == 4294967295)  return 1 }
    state no { return 0 }
}

proc src_field_name_exists(owner, start, count) {
    let i = src_record(owner, 3)
    let end = i + src_record(owner, 4)
    state loop { to one when (i < end)  return 0 }
    state one { to next when (src_field(i, 2) != count)  to compare }
    state compare { to yes when (src_spans_equal(start, src_field(i, 1), count) == 1)  to next }
    state yes { return 1 }
    state next { i = i + 1  to loop }
}

proc src_machine_name_exists(owner_start, name_start, name_count) {
    let i = 0
    let owner_count = word[10000208]
    state loop { to one when (i < word[10000032])  return 0 }
    state one { to next when (src_machine(i, 1) != owner_count)  to owner_compare }
    state owner_compare { to next when (src_spans_equal(owner_start, src_machine(i, 0), owner_count) == 0)  to name_length }
    state name_length { to next when (src_machine(i, 4) != name_count)  to name_compare }
    state name_compare { to yes when (src_spans_equal(name_start, src_machine(i, 3), name_count) == 1)  to next }
    state yes { return 1 }
    state next { i = i + 1  to loop }
}

proc src_state_name_exists(machine, start, count) {
    let i = src_machine(machine, 12)
    let end = i + src_machine(machine, 13)
    state loop { to one when (i < end)  return 0 }
    state one { to next when (src_state(i, 2) != count)  to compare }
    state compare { to yes when (src_spans_equal(start, src_state(i, 1), count) == 1)  to next }
    state yes { return 1 }
    state next { i = i + 1  to loop }
}

proc src_param_name_exists(start, count) {
    let i = word[10000104]
    let end = i + word[10000112]
    state loop { to one when (i < end)  return 0 }
    state one { to next when (src_param(i, 2) != count)  to compare }
    state compare { to yes when (src_spans_equal(start, src_param(i, 1), count) == 1)  to next }
    state yes { return 1 }
    state next { i = i + 1  to loop }
}

proc src_allocate_type() {
    let id = word[10000048]
    state capacity { to exhausted when (id >= 32768)  to save }
    state save {
        word[10000048] = id + 1
        src_type_set(id, 0, 0)  src_type_set(id, 1, 0)  src_type_set(id, 2, 0)
        src_type_set(id, 3, 4294967295)  src_type_set(id, 4, 4294967295)
        src_type_set(id, 5, 0)  src_type_set(id, 6, 0)
        src_type_set(id, 7, 0)  src_type_set(id, 8, 0)
        src_type_set(id, 9, 4294967295)  src_type_set(id, 10, 0)
        src_type_set(id, 11, 0)  src_type_set(id, 12, 0)
        word[10000096] = id
        return 0
    }
    state exhausted { return src_exhaust() }
}

proc src_parse_base_type() {
    let id = 0
    state allocate { to done when (src_allocate_type() != 0)  id = word[10000096]  to token }
    state token { to bad when (word[524416] != 256)  to u8_check }
    state u8_check { to u8_type when (src_token_word(46, 2) == 1)  to u32_check }
    state u8_type { src_type_set(id, 0, 1)  src_type_set(id, 8, 255)  src_next()  to done }
    state u32_check { to u32_type when (src_token_word(48, 3) == 1)  to bool_check }
    state u32_type { src_type_set(id, 0, 2)  src_type_set(id, 8, 2147483647)  src_next()  to done }
    state bool_check { to bool_type when (src_token_word(51, 4) == 1)  to nominal }
    state bool_type { src_type_set(id, 0, 3)  src_type_set(id, 8, 1)  src_next()  to done }
    state nominal {
        src_type_set(id, 0, 4)  src_type_set(id, 1, word[524424])
        src_type_set(id, 2, word[524432])  src_next()  to done
    }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_parse_type_constraints() {
    let id = word[10000096]
    state in_check { to range_check when (src_token_word(55, 2) == 0)  src_next()  to trapping }
    state trapping { to done when (src_expect_word(57, 8) != 0)  to trapping_kind }
    state trapping_kind { to bad when (src_type(id,0) == 3)  to bad when (src_type(id,0) == 4)  src_type_set(id,6,1)  to range_check }
    state range_check { to done when (word[524416] != 91)  to range_kind }
    state range_kind { to done when (src_type(id, 0) == 5)  to range_base }
    state range_base { to bad when (src_type(id, 0) != 2)  src_next()  to low_token }
    state low_token { to bad when (word[524416] != 257)  src_type_set(id, 7, word[524432])  src_next()  to dot0 }
    state dot0 { to done when (src_expect_token(46) != 0)  to dot1 }
    state dot1 { to done when (src_expect_token(46) != 0)  to equal }
    state equal { to done when (src_expect_token(61) != 0)  to high_token }
    state high_token { to bad when (word[524416] != 257)  src_type_set(id, 8, word[524432])  src_next()  to close }
    state close { to done when (src_expect_token(93) != 0)  to order }
    state order { to bad when (src_type(id, 7) > src_type(id, 8))  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_parse_type() {
    let element = 0
    let id = 0
    state start { to array when (word[524416] == 91)  to scalar }
    state scalar { to done when (src_parse_base_type() != 0)  src_parse_type_constraints()  to done }
    state array { src_next()  to element_parse }
    state element_parse { to done when (src_parse_base_type() != 0)  element = word[10000096]  to allocate }
    state allocate { to done when (src_allocate_type() != 0)  id = word[10000096]  src_type_set(id, 0, 5)  src_type_set(id, 4, element)  to semicolon }
    state semicolon { to done when (src_expect_token(59) != 0)  to length_token }
    state length_token { to bad when (word[524416] != 257)  to length_bound }
    state length_bound { to exhausted when (word[524432] > 65536)  src_type_set(id, 5, word[524432])  src_next()  to close }
    state close { to done when (src_expect_token(93) != 0)  src_parse_type_constraints()  to done }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_parse_parameters(owner) {
    let start = word[10000040]
    let name_start = 0
    let name_count = 0
    state init {
        word[10000104] = start  word[10000112] = 0  word[10000120] = 0
        to amp
    }
    state amp { to bad when (word[524416] != 38)  src_next()  to mut_check }
    state mut_check { to self_check when (src_token_word(15, 3) == 0)  word[10000120] = 1  src_next()  to self_check }
    state self_check { to done when (src_expect_word(18, 4) != 0)  to tail }
    state tail { to close when (word[524416] != 44)  src_next()  to count }
    state count { to exhausted when (word[10000112] >= 7)  to name }
    state name { to bad when (word[524416] != 256)  name_start = word[524424]  name_count = word[524432]  to unique }
    state unique { to bad when (src_param_name_exists(name_start, name_count) == 1)  to capacity }
    state capacity { to exhausted when (word[10000040] >= 4096)  to save }
    state save {
        src_param_set(word[10000040], 0, owner)  src_param_set(word[10000040], 1, name_start)
        src_param_set(word[10000040], 2, name_count)  src_next()  to colon
    }
    state colon { to done when (src_expect_token(58) != 0)  to type }
    state type { to done when (src_parse_type() != 0)  src_param_set(word[10000040], 3, word[10000096])  to advance }
    state advance { word[10000040] = word[10000040] + 1  word[10000112] = word[10000112] + 1  to tail }
    state close { src_expect_token(41)  to done }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_skip_body() {
    let depth = 1
    state loop { to bad when (word[524416] == 0)  to open }
    state open { to add when (word[524416] == 123)  to close }
    state add { depth = depth + 1  src_next()  to loop }
    state close { to advance when (word[524416] != 125)  depth = depth - 1  to complete when (depth == 0)  src_next()  to loop }
    state advance { src_next()  to done when (word[10000000] != 0)  to loop }
    state complete { word[10000200] = word[524424]  src_next()  return 0 }
    state bad { return src_reject() }
    state done { return word[10000000] }
}

proc src_collect_data() {
    let id = 0
    let name_start = 0
    let name_count = 0
    state begin { src_next()  to name }
    state name { to bad when (word[524416] != 256)  name_start = word[524424]  name_count = word[524432]  to unique }
    state unique { to bad when (src_data_name_exists(name_start, name_count) == 1)  to capacity }
    state capacity { to exhausted when (word[10000016] >= 128)  id = word[10000016]  to save }
    state save {
        src_record_set(id, 0, name_start)  src_record_set(id, 1, name_count)
        src_record_set(id, 2, 0)  src_record_set(id, 3, word[10000024])
        src_record_set(id, 4, 0)  word[10000016] = id + 1  word[10000072] = id
        src_next()  to copy_check
    }
    state copy_check { to body_open when (word[524416] != 91)  src_next()  to copy_word }
    state copy_word { to done when (src_expect_word(4, 4) != 0)  to copy_close }
    state copy_close { to done when (src_expect_token(93) != 0)  src_record_set(id, 2, 1)  to body_open }
    state body_open { to done when (src_expect_token(123) != 0)  to fields }
    state fields { to complete when (word[524416] == 125)  to field_limit }
    state field_limit { to exhausted when (src_record(id, 4) >= 64)  to field_capacity }
    state field_capacity { to exhausted when (word[10000024] >= 8192)  to field_name }
    state field_name { to bad when (word[524416] != 256)  name_start = word[524424]  name_count = word[524432]  to field_unique }
    state field_unique { to bad when (src_field_name_exists(id, name_start, name_count) == 1)  to field_save }
    state field_save {
        src_field_set(word[10000024], 0, id)  src_field_set(word[10000024], 1, name_start)
        src_field_set(word[10000024], 2, name_count)  src_next()  to field_colon
    }
    state field_colon { to done when (src_expect_token(58) != 0)  to field_type }
    state field_type { to done when (src_parse_type() != 0)  src_field_set(word[10000024], 3, word[10000096])  to field_end }
    state field_end { word[10000024] = word[10000024] + 1  src_record_set(id, 4, src_record(id, 4) + 1)  to semicolon }
    state semicolon { to done when (src_expect_token(59) != 0)  to fields }
    state complete { src_next()  to done }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_collect_machine() {
    let id = 0
    let owner_start = 0
    let owner_count = 0
    let name_start = 0
    let name_count = 0
    state begin { src_next()  to owner }
    state owner { to bad when (word[524416] != 256)  owner_start = word[524424]  owner_count = word[524432]  word[10000208] = owner_count  src_next()  to colon0 }
    state colon0 { to done when (src_expect_token(58) != 0)  to colon1 }
    state colon1 { to done when (src_expect_token(58) != 0)  to name }
    state name { to bad when (word[524416] != 256)  name_start = word[524424]  name_count = word[524432]  to unique }
    state unique { to bad when (src_machine_name_exists(owner_start, name_start, name_count) == 1)  to capacity }
    state capacity { to exhausted when (word[10000032] >= 128)  id = word[10000032]  to self_type }
    state self_type { to done when (src_allocate_type() != 0)  src_type_set(word[10000096], 0, 4)  src_type_set(word[10000096], 1, owner_start)  src_type_set(word[10000096], 2, owner_count)  to save }
    state save {
        src_machine_set(id, 0, owner_start)  src_machine_set(id, 1, owner_count)
        src_machine_set(id, 2, 4294967295)  src_machine_set(id, 3, name_start)
        src_machine_set(id, 4, name_count)  src_machine_set(id, 7, 4294967295)
        src_machine_set(id, 9, word[10000096])  src_machine_set(id, 12, word[10000040])
        src_machine_set(id, 13, 0)  word[10000032] = id + 1  word[10000080] = id
        src_next()  to open
    }
    state open { to done when (src_expect_token(40) != 0)  to params }
    state params { to done when (src_parse_parameters(id) != 0)  src_machine_set(id, 5, word[10000104])  src_machine_set(id, 6, word[10000112])  src_machine_set(id, 8, word[10000120])  to result_check }
    state result_check { to body_open when (word[524416] != 45)  src_next()  to arrow }
    state arrow { to done when (src_expect_token(62) != 0)  to result }
    state result { to done when (src_parse_type() != 0)  src_machine_set(id, 7, word[10000096])  to body_open }
    state body_open { to done when (src_expect_token(123) != 0)  src_machine_set(id, 10, word[524424])  to body }
    state body { to done when (src_skip_body() != 0)  src_machine_set(id, 11, word[10000200])  to done }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_collect_roots() {
    state init {
        word[10000008]=0  word[10000016]=0  word[10000024]=0  word[10000032]=0
        word[10000040]=0  word[10000048]=0  word[10000056]=0
        word[524408]=0  word[10000128]=word[524400]  src_next()  to loop
    }
    state loop { to done when (word[524416] == 0)  to capacity }
    state capacity { to exhausted when (word[10000008] >= 128)  to data_check }
    state data_check { to data when (src_token_word(0, 4) == 1)  to machine_check }
    state data { word[10000008]=word[10000008]+1  src_collect_data()  to done when (word[10000000] != 0)  to loop }
    state machine_check { to bad when (src_token_word(8, 7) == 0)  word[10000008]=word[10000008]+1  src_collect_machine()  to done when (word[10000000] != 0)  to loop }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { word[10000064] = word[10000040]  return word[10000000] }
}

proc src_collect_one_state() {
    let id = 0
    let machine = word[10000080]
    let name_start = 0
    let name_count = 0
    state begin { src_next()  to name }
    state name { to bad when (word[524416] != 256)  name_start=word[524424]  name_count=word[524432]  to unique }
    state unique { to bad when (src_state_name_exists(machine, name_start, name_count) == 1)  to per_machine }
    state per_machine { to exhausted when (src_machine(machine, 13) >= 127)  to total }
    state total { to exhausted when (word[10000056] + word[10000032] >= 2048)  id=word[10000056]  to save }
    state save {
        src_state_set(id,0,machine)  src_state_set(id,1,name_start)  src_state_set(id,2,name_count)
        word[10000056]=id+1  src_machine_set(machine,13,src_machine(machine,13)+1)
        word[10000088]=id  src_next()  to open
    }
    state open { to done when (src_expect_token(40) != 0)  to params }
    state params { to done when (src_parse_parameters(1000+id) != 0)  src_state_set(id,3,word[10000104])  src_state_set(id,4,word[10000112])  src_state_set(id,5,word[10000120])  to access }
    state access { to bad when (src_state(id,5) > src_machine(machine,8))  to body_open }
    state body_open { to done when (src_expect_token(123) != 0)  src_state_set(id,6,word[524424])  to body }
    state body { to done when (src_skip_body() != 0)  src_state_set(id,7,word[10000200])  to done }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_collect_machine_states(machine) {
    let depth = 0
    let seen = 0
    state init {
        word[10000080]=machine  word[10000128]=src_machine(machine,11)
        word[524408]=src_machine(machine,10)  src_next()  to loop
    }
    state loop { to finish when (word[524416] == 0)  to top }
    state top { to brace when (depth != 0)  to state_check }
    state state_check { to state_begin when (src_token_word(22,5) == 1)  to entry_token }
    state state_begin { to collect when (seen == 1)  src_machine_set(machine,14,word[524424])  seen=1  to collect }
    state collect { src_collect_one_state()  to done when (word[10000000] != 0)  to loop }
    state entry_token { to bad when (seen == 1)  to brace }
    state brace { to open when (word[524416] == 123)  to close }
    state open { depth=depth+1  src_next()  to loop }
    state close { to advance when (word[524416] != 125)  to close_check }
    state close_check { to bad when (depth < 1)  depth=depth-1  src_next()  to loop }
    state advance { src_next()  to done when (word[10000000] != 0)  to loop }
    state finish { to bad when (depth != 0)  to no_states when (seen == 0)  to done }
    state no_states { src_machine_set(machine,14,src_machine(machine,11))  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_collect_all_states() {
    let i = 0
    state loop { to one when (i < word[10000032])  return 0 }
    state one { word[10000080]=i  src_machine_set(i,12,word[10000056])  src_collect_machine_states(i)  to done when (word[10000000] != 0)  i=i+1  to loop }
    state done { return word[10000000] }
}

proc src_type_copyable(type_id) {
    let kind = src_type(type_id,0)
    let record = 0
    let i = 0
    let end = 0
    state kind { to yes when (kind < 4)  to nominal when (kind == 4)  to array }
    state array { return src_type_copyable(src_type(type_id,4)) }
    state nominal { record=src_type(type_id,3)  to no when (src_record(record,2) == 0)  i=src_record(record,3)  end=i+src_record(record,4)  to fields }
    state fields { to field when (i < end)  to yes }
    state field { to no when (src_type_copyable(src_field(i,3)) == 0)  i=i+1  to fields }
    state yes { return 1 }
    state no { return 0 }
}

proc src_resolve_types() {
    let i = 0
    let id = 0
    state types { to one when (i < word[10000048])  i=0  to machines }
    state one { to next when (src_type(i,0) != 4)  id=src_find_data(src_type(i,1),src_type(i,2))  to bad when (id == 4294967295)  src_type_set(i,3,id)  to next }
    state next { i=i+1  to types }
    state machines { to machine_one when (i < word[10000032])  return 0 }
    state machine_one { id=src_find_data(src_machine(i,0),src_machine(i,1))  to bad when (id == 4294967295)  src_machine_set(i,2,id)  i=i+1  to machines }
    state bad { return src_reject() }
}

proc src_validate_copies() {
    let i=0
    let field=0
    let end=0
    state records { to one when (i < word[10000016])  return 0 }
    state one { to next when (src_record(i,2) == 0)  field=src_record(i,3)  end=field+src_record(i,4)  to fields }
    state fields { to field_one when (field < end)  to next }
    state field_one { to bad when (src_type_copyable(src_field(field,3)) == 0)  field=field+1  to fields }
    state next { i=i+1  to records }
    state bad { return src_reject() }
}

proc src_align(value, alignment) { return ((value + alignment - 1) / alignment) * alignment }

proc src_layout_record(record) {
    let field=0
    let end=0
    let size=0
    let alignment=1
    let child_size=0
    let child_align=0
    state cached { to done when (src_record(record,7) == 2)  to recursive when (src_record(record,7) == 1)  src_record_set(record,7,1)  field=src_record(record,3)  end=field+src_record(record,4)  to fields }
    state fields { to field_one when (field < end)  size=src_align(size,alignment)  to exhausted when (size > 131072)  to save }
    state field_one { to bad when (src_layout_type(src_field(field,3)) != 0)  child_size=src_type(src_field(field,3),11)  child_align=src_type(src_field(field,3),12)  size=src_align(size,child_align)  src_field_set(field,4,size)  to add }
    state add { to exhausted when (size > 131072)  to exhausted when (child_size > 131072-size)  size=size+child_size  to keep when (alignment >= child_align)  alignment=child_align  to next }
    state keep { to next }
    state next { field=field+1  to fields }
    state save { src_record_set(record,5,size)  src_record_set(record,6,alignment)  src_record_set(record,7,2)  return 0 }
    state done { return 0 }
    state recursive { return src_reject() }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
}

proc src_layout_type(type_id) {
    let kind = src_type(type_id,0)
    let record = 0
    let size = 0
    let alignment = 1
    let child_size = 0
    let child_align = 0
    state cached { to done when (src_type(type_id,10) == 2)  to recursive when (src_type(type_id,10) == 1)  src_type_set(type_id,10,1)  to kind_check }
    state kind_check { to byte_scalar when (kind == 1)  to word_scalar when (kind == 2)  to byte_scalar when (kind == 3)  to nominal when (kind == 4)  to array }
    state byte_scalar { size=1  alignment=1  to save }
    state word_scalar { size=4  alignment=4  to save }
    state array { to bad when (src_layout_type(src_type(type_id,4)) != 0)  child_size=src_type(src_type(type_id,4),11)  child_align=src_type(src_type(type_id,4),12)  to array_bound }
    state array_bound { to array_save when (src_type(type_id,5) == 0)  to exhausted when (child_size > 131072 / src_type(type_id,5))  to array_save }
    state array_save { size=child_size*src_type(type_id,5)  alignment=child_align  to save }
    state nominal { record=src_type(type_id,3)  to bad when (src_layout_record(record) != 0)  size=src_record(record,5)  alignment=src_record(record,6)  to save }
    state save { src_type_set(type_id,11,size)  src_type_set(type_id,12,alignment)  src_type_set(type_id,10,2)  return 0 }
    state done { return 0 }
    state recursive { return src_reject() }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
}

proc src_layout_all() {
    let i = 0
    state records { to record_one when (i < word[10000016])  i=0  to loop }
    state record_one { to done when (src_layout_record(i) != 0)  i=i+1  to records }
    state loop { to one when (i < word[10000048])  return 0 }
    state one { to done when (src_layout_type(i) != 0)  i=i+1  to loop }
    state done { return word[10000000] }
}

proc src_ck_intern(kind, flags, payload0, payload1) {
    let i = 0
    let low = word[10000216]
    let high = word[10000224]
    state scan { to one when (i < word[10000144])  to capacity }
    state one { to next when (src_ck_type(i,0) != kind)  to next when (src_ck_type(i,1) != flags)  to next when (src_ck_type(i,2) != payload0)  to next when (src_ck_type(i,3) != payload1)  to next when (src_ck_type(i,4) != low)  to next when (src_ck_type(i,5) != high)  word[10000152]=i  return 0 }
    state next { i=i+1  to scan }
    state capacity { to exhausted when (word[10000144] >= 8192)  i=word[10000144]  to save }
    state save { src_ck_type_set(i,0,kind)  src_ck_type_set(i,1,flags)  src_ck_type_set(i,2,payload0)  src_ck_type_set(i,3,payload1)  src_ck_type_set(i,4,low)  src_ck_type_set(i,5,high)  word[10000144]=i+1  word[10000152]=i  return 0 }
    state exhausted { return src_exhaust() }
}

proc src_canonicalize_type(old) {
    let kind = src_type(old,0)
    let payload0 = 0
    let payload1 = 0
    state existing { to done when (src_type(old,9) != 4294967295)  to values }
    state values { word[10000216]=src_type(old,7)  word[10000224]=src_type(old,8)  to nominal when (kind == 4)  to array when (kind == 5)  to intern }
    state nominal { payload0=src_record(src_type(old,3),8)  word[10000216]=0  word[10000224]=0  to intern }
    state array { to bad when (src_type(src_type(old,4),9) == 4294967295)  payload0=src_type(src_type(old,4),9)  payload1=src_type(old,5)  word[10000216]=0  word[10000224]=0  to intern }
    state intern { to done when (src_ck_intern(kind,src_type(old,6),payload0,payload1) != 0)  src_type_set(old,9,word[10000152])  to done }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_prepare_ck_types() {
    let i = 0
    let waiting = 0
    let progress = 0
    state init { word[10000144]=0  to records }
    state records { to record_one when (i < word[10000016])  i=0  to bool_type }
    state record_one { word[10000216]=0  word[10000224]=0  to done when (src_ck_intern(4,0,i,0) != 0)  src_record_set(i,8,word[10000152])  i=i+1  to records }
    state bool_type { word[10000216]=0  word[10000224]=1  to done when (src_ck_intern(3,0,0,0) != 0)  to u32_type }
    state u32_type { word[10000216]=0  word[10000224]=2147483647  to done when (src_ck_intern(2,0,0,0) != 0)  i=0  to nonarrays }
    state nonarrays { to nonarray_one when (i < word[10000048])  i=0  waiting=0  progress=0  to arrays }
    state nonarray_one { to nonarray_next when (src_type(i,0) == 5)  to done when (src_canonicalize_type(i) != 0)  to nonarray_next }
    state nonarray_next { i=i+1  to nonarrays }
    state arrays { to array_one when (i < word[10000048])  to arrays_done }
    state array_one { to array_next when (src_type(i,0) != 5)  to array_next when (src_type(i,9) != 4294967295)  to wait when (src_type(src_type(i,4),9) == 4294967295)  to done when (src_canonicalize_type(i) != 0)  progress=progress+1  to array_next }
    state wait { waiting=waiting+1  to array_next }
    state array_next { i=i+1  to arrays }
    state arrays_done { to done when (waiting == 0)  to bad when (progress == 0)  i=0  waiting=0  progress=0  to arrays }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc src_compare_types_records() {
    let i = 0
    let id = 0
    state counts { to bad when (word[10000144] != ckir_count(0))  to records_count }
    state records_count { to bad when (word[10000016] != ckir_count(1))  to fields_count }
    state fields_count { to bad when (word[10000024] != ckir_count(2))  to types }
    state types { to type_one when (i < word[10000144])  i=0  to records }
    state type_one { to bad when (ckir_type_byte(i,4) != src_ck_type(i,0))  to bad when (ckir_type_byte(i,5) != src_ck_type(i,1))  to bad when (ckir_type_word(i,8) != src_ck_type(i,2))  to bad when (ckir_type_word(i,12) != src_ck_type(i,3))  to bad when (ckir_type_word(i,16) != src_ck_type(i,4))  to bad when (ckir_type_word(i,20) != src_ck_type(i,5))  i=i+1  to types }
    state records { to record_one when (i < word[10000016])  i=0  to fields }
    state record_one { to bad when (ckir_record_word(i,4) != src_record(i,8))  to record_start }
    state record_start { to bad when (ckir_record_word(i,8) != src_record(i,3))  to record_count }
    state record_count { to bad when (ckir_record_word(i,12) != src_record(i,4))  to record_flags }
    state record_flags { to bad when (ckir_record_byte(i,16) != src_record(i,2))  to layout_record }
    state layout_record { id=src_record(i,8)  to bad when (word[6000000+id*8] != src_record(i,5))  to bad when (word[6100000+id*8] != src_record(i,6))  i=i+1  to records }
    state fields { to field_one when (i < word[10000024])  return 0 }
    state field_one { to bad when (ckir_field_word(i,4) != src_field(i,0))  to bad when (ckir_field_word(i,8) != i-src_record(src_field(i,0),3))  id=src_type(src_field(i,3),9)  to bad when (ckir_field_word(i,12) != id)  to bad when (word[6200000+i*8] != src_field(i,4))  i=i+1  to fields }
    state bad { return src_reject() }
}

proc src_zero_type(type_id) {
    let kind=src_type(type_id,0)
    let record=0
    let i=0
    let end=0
    state kind_check { to scalar when (kind < 4)  to nominal when (kind == 4)  to array }
    state scalar { to no when (src_type(type_id,7) != 0)  return 1 }
    state array { return src_zero_type(src_type(type_id,4)) }
    state nominal { record=src_type(type_id,3)  i=src_record(record,3)  end=i+src_record(record,4)  to fields }
    state fields { to field when (i < end)  return 1 }
    state field { to no when (src_zero_type(src_field(i,3)) == 0)  i=i+1  to fields }
    state no { return 0 }
}

; Derive every block/parameter partition and the private conformance root from
; source alone.  No CKIR word is read until the two compare procedures below.
proc src_prepare_machines_blocks() {
    let i=0
    let j=0
    let id=0
    let block=0
    let root=4294967295
    state counts { word[10000160]=word[10000032]+word[10000056]  word[10000168]=word[10000040]-word[10000064]  to machines }
    state machines { to machine_one when (i < word[10000032])  i=0  to state_blocks }
    state machine_one { src_machine_set(i,15,block)  block=block+src_machine(i,13)+1  to root_check }
    state root_check { to machine_next when (src_machine(i,6) != 0)  to machine_next when (src_machine(i,7) == 4294967295)  to machine_next when (src_type(src_machine(i,7),0) > 3)  to bad when (root != 4294967295)  to machine_zero }
    state machine_zero { to bad when (src_zero_type(src_machine(i,9)) == 0)  root=i  to machine_next }
    state machine_next { i=i+1  to machines }
    state state_blocks { to state_machine when (i < word[10000032])  word[10000232]=root  return 0 }
    state state_machine { block=src_machine(i,15)+1  j=0  to states }
    state states { to state_one when (j < src_machine(i,13))  i=i+1  to state_blocks }
    state state_one { id=src_machine(i,12)+j  src_state_set(id,8,block)  block=block+1  j=j+1  to states }
    state bad { return src_reject() }
}

proc src_compare_machines_blocks() {
    let i=0
    let j=0
    let id=0
    let block=0
    let bparam=0
    let source_param=0
    let result=0
    state counts { to bad when (word[10000032] != ckir_count(3))  to mparam_count }
    state mparam_count { to bad when (word[10000064] != ckir_count(4))  to block_count }
    state block_count { to bad when (word[10000160] != ckir_count(5))  to bparam_count }
    state bparam_count { to bad when (word[10000168] != ckir_count(6))  to machines }
    state machines { to machine_one when (i < word[10000032])  i=0  block=0  bparam=0  to blocks }
    state machine_one { result=4294967295  to result_value when (src_machine(i,7) != 4294967295)  to machine_compare }
    state result_value { result=src_type(src_machine(i,7),9)  to machine_compare }
    state machine_compare { to bad when (ckir_machine_word(i,4) != src_machine(i,2))  to bad when (ckir_machine_byte(i,8) != src_machine(i,8)+1)  to bad when (ckir_machine_word(i,12) != result)  to bad when (ckir_machine_word(i,16) != src_machine(i,5))  to bad when (ckir_machine_word(i,20) != src_machine(i,6))  to mparams }
    state mparams { j=0  to mparam_loop }
    state mparam_loop { to mparam_one when (j < src_machine(i,6))  to machine_blocks }
    state mparam_one { source_param=src_machine(i,5)+j  to bad when (ckir_mparam_word(source_param,4) != i)  to bad when (ckir_mparam_word(source_param,8) != j)  to bad when (ckir_mparam_word(source_param,12) != src_type(src_param(source_param,3),9))  to bad when (ckir_mparam_word(source_param,16) != source_param)  j=j+1  to mparam_loop }
    state machine_blocks { block=src_machine(i,15)  to bad when (ckir_machine_word(i,24) != block)  to bad when (ckir_machine_word(i,28) != src_machine(i,13)+1)  to bad when (ckir_machine_word(i,32) != block)  to machine_next }
    state machine_next { i=i+1  to machines }
    state blocks { to block_machine when (i < word[10000032])  to root_compare }
    state block_machine { block=src_machine(i,15)  to bad when (ckir_block_word(block,4) != i)  to bad when (ckir_block_byte(block,8) != src_machine(i,8)+1)  to bad when (ckir_block_word(block,12) != bparam)  to bad when (ckir_block_word(block,16) != 0)  j=0  block=block+1  to state_blocks }
    state state_blocks { to state_block when (j < src_machine(i,13))  i=i+1  to blocks }
    state state_block { id=src_machine(i,12)+j  to bad when (src_state(id,8) != block)  to bad when (ckir_block_word(block,4) != i)  to bad when (ckir_block_byte(block,8) != src_state(id,5)+1)  to bad when (ckir_block_word(block,12) != bparam)  to bad when (ckir_block_word(block,16) != src_state(id,4))  source_param=src_state(id,3)  to state_params }
    state state_params { to state_param when (source_param < src_state(id,3)+src_state(id,4))  bparam=bparam+src_state(id,4)  block=block+1  j=j+1  to state_blocks }
    state state_param { to bad when (ckir_bparam_word(bparam+source_param-src_state(id,3),4) != block)  to bad when (ckir_bparam_word(bparam+source_param-src_state(id,3),8) != source_param-src_state(id,3))  to bad when (ckir_bparam_word(bparam+source_param-src_state(id,3),12) != src_type(src_param(source_param,3),9))  to bad when (ckir_bparam_word(bparam+source_param-src_state(id,3),16) != word[10000064]+bparam+source_param-src_state(id,3))  source_param=source_param+1  to state_params }
    state root_compare { to bad when (word[525000] != word[10000232])  return 0 }
    state bad { return src_reject() }
}

proc src_reconstruct_tables_check() {
    let status=0
    state lex_reset { word[524408]=0  word[524440]=0  word[10000128]=word[524400]  status=refinement_source_lex_all()  to done when (status != 0)  to init }
    state init { word[10000000]=0  src_init_words()  to roots }
    state roots { status=src_collect_roots()  to done when (status != 0)  to states }
    state states { status=src_collect_all_states()  to done when (status != 0)  to resolve_states }
    state resolve_states { status=src_resolve_types()  to done when (status != 0)  to layout }
    state layout { status=src_layout_all()  to done when (status != 0)  to copies }
    state copies { status=src_validate_copies()  to done when (status != 0)  to canonical }
    state canonical { status=src_prepare_ck_types()  to done when (status != 0)  to prepare_blocks }
    state prepare_blocks { status=src_prepare_machines_blocks()  to done }
    state done { return status }
}

proc src_refinement_tables_check() {
    let status=src_reconstruct_tables_check()
    state reconstruct { to done when (status != 0)  to compare_types }
    state compare_types { status=src_compare_types_records()  to done when (status != 0)  to compare_machines }
    state compare_machines { status=src_compare_machines_blocks()  to done }
    state done { return status }
}

proc main() {
    let status=refinement_envelope_read()
    state envelope { to done when (status != 0)  to bundle }
    state bundle { status=refinement_source_decode_bundle()  to done when (status != 0)  to artifact }
    state artifact { status=ckir_refinement_artifact_check()  to done when (status != 0)  to source }
    state source { status=src_refinement_tables_check()  to done }
    state done { return status }
}
