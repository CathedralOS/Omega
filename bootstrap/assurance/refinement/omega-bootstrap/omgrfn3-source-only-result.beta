; OMGRFN3 layer-4 physically artifact-free source evaluator.
;
; The gate composes this after an envelope with CKIR/ELF readers physically
; absent, the source/witness model, the CKIR-independent source lowering
; procedures, the call-aware parser/emitter prefix from
; omgrfn3-resolved-body-lowering.beta, and the CKIR-independent scalar/layout
; helpers from ckir-refinement-source-result.beta.  Calls execute in distinct
; value/place/block frames while all frames share the selected owner's memory.
; This evidence checker publishes a 16-frame evaluation-storage bound; a
; deeper otherwise-well-formed DAG returns 252, as permitted by OMGRFN3.

; Logical layouts are bounded to 131072 bytes and padding is unobservable.
; Snapshotting the complete layout before commit is overlap-safe and is
; equivalent to the recursive field/array copy for every observable byte.
proc v3_eval_copy(type_id,destination,source) {
    let size=src_eval_type_size(type_id)
    let i=0
    state bound { to exhausted when (size > 131072)  to snapshot }
    state snapshot { to snapshot_one when (i < size)  i=0  to commit }
    state snapshot_one { byte[21800000+i]=byte[20000000+source+i]  i=i+1  to snapshot }
    state commit { to commit_one when (i < size)  return 0 }
    state commit_one { byte[20000000+destination+i]=byte[21800000+i]  i=i+1  to commit }
    state exhausted { return src_exhaust() }
}

proc v3_eval_edge(depth,block,argument_field,count) {
    let state_id=src_eval_state_for_block(block)
    let value_base=20200000+depth*294912
    let i=0
    let parameter=0
    let value=0
    state target { to bad when (state_id == 4294967295)  to stage }
    state stage { to stage_one when (i < count)  i=0  to commit }
    state stage_one { value=src_lower_term(word[21701000+depth*8],argument_field+i)  word[21702000+i*8]=word[value_base+value*8]  i=i+1  to stage }
    state commit { to commit_one when (i < count)  return 0 }
    state commit_one { parameter=src_state(state_id,3)+i  word[value_base+parameter*8]=word[21702000+i*8]  i=i+1  to commit }
    state bad { return 251 }
}

proc v3_eval_machine(machine,depth) {
    let value_base=20200000+depth*294912
    let place_base=21000000+depth*262144
    let block=0
    let op=0
    let op_end=0
    let opcode=0
    let result=0
    let result_type=0
    let start=0
    let a=0
    let b=0
    let value=0
    let address=0
    let base_type=0
    let field=0
    let target=0
    let count=0
    let clear=0
    let callee=0
    let parameter=0
    let i=0
    state depth_check { to exhausted when (depth >= 16)  to clear_visited }
    state clear_visited { to clear_visit_one when (clear < word[10000160])  block=src_machine(machine,15)  to block_begin }
    state clear_visit_one { word[21600000+(depth*2048+clear)*8]=0  clear=clear+1  to clear_visited }
    state block_begin { to trap when (word[21600000+(depth*2048+block)*8] != 0)  word[21600000+(depth*2048+block)*8]=1  op=src_low_block(block,0)  op_end=op+src_low_block(block,1)  to operations }
    state operations { to operation when (op < op_end)  to terminator }
    state operation {
        opcode=src_lower_op(op,2)  result=src_lower_op(op,4)
        result_type=src_lower_op(op,5)  start=src_lower_op(op,6)
        to dispatch
    }
    state dispatch {
        to constant when (opcode == 1)  to self_place when (opcode == 2)
        to field_place when (opcode == 3)  to index_place when (opcode == 4)
        to load when (opcode == 5)  to store when (opcode == 6)
        to copy when (opcode == 7)  to add when (opcode == 8)
        to less when (opcode == 9)  to call when (opcode == 10)
        to trap
    }
    state constant { word[value_base+result*8]=src_lower_op(op,8)  to op_next }
    state self_place { word[place_base+result*8]=0  to op_next }
    state field_place { a=src_lower_operand(start)  field=src_lower_op(op,8)  word[place_base+result*8]=word[place_base+a*8]+src_field(field,4)  to op_next }
    state index_place { a=src_lower_operand(start)  b=src_lower_operand(start+1)  value=word[value_base+b*8]  base_type=src_lower_place_type(a)  to trap when (value >= src_ck_type(base_type,3))  word[place_base+result*8]=word[place_base+a*8]+value*src_eval_type_size(src_ck_type(base_type,2))  to op_next }
    state load { a=src_lower_operand(start)  address=word[place_base+a*8]  word[value_base+result*8]=src_eval_load(result_type,address)  to op_next }
    state store { a=src_lower_operand(start)  b=src_lower_operand(start+1)  address=word[place_base+a*8]  value=word[value_base+b*8]  to trap when (src_eval_store(src_lower_place_type(a),address,value) != 0)  to op_next }
    state copy { a=src_lower_operand(start)  b=src_lower_operand(start+1)  address=word[place_base+a*8]  to copy_value when (src_lower_op(op,8) == 1)  value=word[place_base+b*8]  to copy_ready }
    state copy_value { value=word[value_base+b*8]  to copy_ready }
    state copy_ready { to trap when (v3_eval_copy(src_lower_place_type(a),address,value) != 0)  to op_next }
    state add { a=src_lower_operand(start)  b=src_lower_operand(start+1)  value=word[value_base+a*8]+word[value_base+b*8]  to byte_overflow when (src_ck_type(result_type,0) == 1)  to word_overflow }
    state byte_overflow { to trap when (value > 255)  to add_range }
    state word_overflow { to trap when (value > 4294967295)  to add_range }
    state add_range { to trap when (value < src_ck_type(result_type,4))  to trap when (value > src_ck_type(result_type,5))  word[value_base+result*8]=value  to op_next }
    state less { a=src_lower_operand(start)  b=src_lower_operand(start+1)  value=0  to less_true when (word[value_base+a*8] < word[value_base+b*8])  word[value_base+result*8]=0  to op_next }
    state less_true { word[value_base+result*8]=1  to op_next }
    state call { callee=src_lower_op(op,8)  a=src_lower_operand(start)  count=src_lower_op(op,7)-1  i=0  to call_args }
    state call_args { to call_arg when (i < count)  to call_run }
    state call_arg { parameter=src_machine(callee,5)+i  value=word[value_base+src_lower_operand(start+1+i)*8]  word[value_base+294912+parameter*8]=value  i=i+1  to call_args }
    state call_run { value=v3_eval_machine(callee,depth+1)  to call_failed when (value != 0)  to call_unit when (src_machine(callee,7) == 4294967295)  value=word[21700000+(depth+1)*8]  word[value_base+result*8]=value  to op_next }
    state call_failed { to exhausted when (value == 252)  to trap }
    state call_unit { to op_next }
    state op_next { op=op+1  to operations }
    state terminator { word[21701000+depth*8]=block  opcode=src_lower_term(block,0)  to jump when (opcode == 1)  to branch when (opcode == 2)  to trap when (opcode == 3)  to return_value }
    state jump { target=src_lower_term(block,2)  count=src_lower_term(block,3)  to edge0 }
    state branch { value=word[value_base+src_lower_term(block,1)*8]  to branch_true when (value != 0)  target=src_lower_term(block,4)  count=src_lower_term(block,5)  to edge1 }
    state branch_true { target=src_lower_term(block,2)  count=src_lower_term(block,3)  to edge0 }
    state edge0 { to trap when (v3_eval_edge(depth,target,6,count) != 0)  block=target  to block_begin }
    state edge1 { to trap when (v3_eval_edge(depth,target,13,count) != 0)  block=target  to block_begin }
    state return_value { to return_unit when (src_machine(machine,7) == 4294967295)  value=word[value_base+src_lower_term(block,1)*8]  word[21700000+depth*8]=value  return 0 }
    state return_unit { word[21700000+depth*8]=4294967295  return 0 }
    state exhausted { return src_exhaust() }
    state trap { return src_reject() }
}

proc v3_source_result_check() {
    let root=word[10000232]
    let clear=0
    let owner_size=0
    let value=0
    state library { to entry when (root != 4294967295)  return 0 }
    state entry { owner_size=src_record(src_machine(root,2),5)  to clear_owner }
    state clear_owner { to clear_one when (clear < owner_size)  to run }
    state clear_one { byte[20000000+clear]=0  clear=clear+1  to clear_owner }
    state run { to done when (v3_eval_machine(root,0) != 0)  value=word[21700000]  to bad when (value != word[524360])  to bad when (value%256 != word[524368])  return 0 }
    state bad { return src_reject() }
    state done { return word[530800] }
}

proc main() {
    let status=omgrfn3_component_read()
    state frame { to done when (status != 0)  status=l4_model_prepare()  to done when (status != 0)  src_init_words()  v3_call_begin()  to lowering }
    state lowering { status=src_reconstruct_lowering_check()  to done when (status != 0)  status=v3_call_finish()  to done when (status != 0)  to result }
    state result { status=v3_source_result_check()  to done }
    state done { return status }
}
