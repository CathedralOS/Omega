; Bounded OMGRFN7/8/9/10/11 responsibility-5 component framing.
;
; This decoder deliberately treats OMGCOMP and the selected OMGRSW as opaque. It reads
; enough of the exact version-7/8/9/10/11 frame locally to make CKIR5/6/7/8/9 and ELF
; accesses safe,
; then projects those component offsets and claims into the stable private
; interface consumed by the shared CKIR artifact and ELF checkers. It performs no
; source, resolution, witness, or
; lowering checks.
;
; Raw frame bytes: byte[1048576 .. 5546119], maximum 4,497,544 bytes.
; Only CKIR and ELF component readers are exposed after a successful read.
; There is deliberately no source-body or witness-byte adapter in this
; responsibility-5 envelope. In particular, OMGRSW witness identity is
; responsibility 3's premise, not an artifact-checker premise. Word 524376
; retains the exact outer version so the CKIR checker can enforce 7/5, 8/6,
; 9/7, and 10/8
; without inspecting the opaque witness.
; Existing checker interface (word addresses):
;   524288 frame length; 524296 status; 524304 flags
;   524328 CKIR offset; 524336 CKIR length
;   524344 ELF offset;  524352 ELF length
;   524360 claimed result; 524368 claimed exit projection

proc omgrfn5_component_byte(index) { return byte[1048576 + index] }

proc omgrfn5_component_u32(at) {
    return omgrfn5_component_byte(at)
        + omgrfn5_component_byte(at + 1) * 256
        + omgrfn5_component_byte(at + 2) * 65536
        + omgrfn5_component_byte(at + 3) * 16777216
}

proc omgrfn5_component_read() {
    let n = 0
    let overflow = 0
    let c = read_byte()
    let flags = 0
    let omgcomp_length = 0
    let witness_length = 0
    let ckir_length = 0
    let elf_length = 0
    let result = 0
    let exit_projection = 0
    let ckir_offset = 0
    let elf_offset = 0
    state loop { to body when (c >= 0)  to finish }
    state body {
        to exhausted_byte when (n >= 4497544)
        byte[1048576 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state exhausted_byte {
        overflow = 1
        c = read_byte()
        to loop
    }
    state finish {
        word[524288] = n
        word[524296] = 0
        word[524376] = 0
        to exhausted when (overflow == 1)
        to magic0 when (n >= 40)
        to malformed
    }
    state magic0 { to magic1 when (omgrfn5_component_byte(0) == 'O')  to malformed }
    state magic1 { to magic2 when (omgrfn5_component_byte(1) == 'M')  to malformed }
    state magic2 { to magic3 when (omgrfn5_component_byte(2) == 'G')  to malformed }
    state magic3 { to magic4 when (omgrfn5_component_byte(3) == 'R')  to malformed }
    state magic4 { to magic5 when (omgrfn5_component_byte(4) == 'F')  to malformed }
    state magic5 { to magic6 when (omgrfn5_component_byte(5) == 'N')  to malformed }
    state magic6 {
        to version7_magic when (omgrfn5_component_byte(6) == '7')
        to version8_magic when (omgrfn5_component_byte(6) == '8')
        to version9_magic when (omgrfn5_component_byte(6) == '9')
        to version10_magic when (omgrfn5_component_byte(6) == 'A')
        to version11_magic when (omgrfn5_component_byte(6) == 'B')
        to malformed
    }
    state version7_magic { word[524376] = 7  to magic7 }
    state version8_magic { word[524376] = 8  to magic7 }
    state version9_magic { word[524376] = 9  to magic7 }
    state version10_magic { word[524376] = 10  to magic7 }
    state version11_magic { word[524376] = 11  to magic7 }
    state magic7 { to version when (omgrfn5_component_byte(7) == 0)  to malformed }
    state version { to fields when (omgrfn5_component_u32(8) == word[524376])  to malformed }
    state fields {
        flags = omgrfn5_component_u32(12)
        omgcomp_length = omgrfn5_component_u32(16)
        witness_length = omgrfn5_component_u32(20)
        ckir_length = omgrfn5_component_u32(24)
        elf_length = omgrfn5_component_u32(28)
        result = omgrfn5_component_u32(32)
        exit_projection = omgrfn5_component_u32(36)
        to malformed when (flags > 1)
        to malformed when (omgcomp_length < 1)
        to malformed when (witness_length < 1)
        to malformed when (ckir_length < 1)
        to exhausted when (omgcomp_length > 267280)
        to exhausted when (witness_length > 524288)
        to exhausted when (ckir_length > 2522192)
        to exhausted when (elf_length > 1183744)
        ckir_offset = 40 + omgcomp_length + witness_length
        elf_offset = ckir_offset + ckir_length
        to malformed when (n != elf_offset + elf_length)
        word[524304] = flags
        word[524328] = ckir_offset
        word[524336] = ckir_length
        word[524344] = elf_offset
        word[524352] = elf_length
        word[524360] = result
        word[524368] = exit_projection
        to library when (flags == 0)
        to entry
    }
    state library {
        to malformed when (elf_length != 0)
        to malformed when (result != 4294967295)
        to malformed when (exit_projection != 4294967295)
        return 0
    }
    state entry {
        to malformed when (elf_length < 1)
        to malformed when (exit_projection > 255)
        to malformed when (exit_projection != (result % 256))
        return 0
    }
    state exhausted { word[524296] = 252  return 252 }
    state malformed { word[524296] = 251  return 251 }
}

proc omgrfn5_component_ckir_byte(index) {
    return byte[1048576 + word[524328] + index]
}

proc omgrfn5_component_elf_byte(index) {
    return byte[1048576 + word[524344] + index]
}

; Stable private adapters used by the complete CKIR5/6/7 and ELF checkers.
proc refinement_ckir_byte(index) { return omgrfn5_component_ckir_byte(index) }
proc refinement_elf_byte(index) { return omgrfn5_component_elf_byte(index) }
