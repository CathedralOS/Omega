; OMGRFN3 layer-4 additions for resolved source bodies -> CKIR2.
;
; The focused gate composes this fragment after the frozen OMGRFN2 body model
; (with only its component-reader prefix mechanically renamed) and the
; CKIR-independent procedures from ckir-refinement-source-lowering.beta.
; OMGRFN2 remains frozen.  This fragment replaces only the emitter and postfix
; parser, joins every authored self call to an exact role-3 witness row, checks
; the complete call DAG, and compares the independently reconstructed rows to
; CKIR schema major 2.

; Call state uses disjoint persisted-Beta words:
;   19700000 binding-consumed[4096]
;   19750000 call-edge[128*128]
;   19900000 callee[8], 19900100 receiver[8], 19900200 argc[8]
;   19901000 argument-value[8*8]
;   19990000 binding lookup result
;   20100000 staged emitter operands 2..7

proc v3_call_begin() {
    let i=0
    state bindings { to binding when (i < l4_count(2))  i=0  to edges }
    state binding { word[19700000+i*8]=0  i=i+1  to bindings }
    state edges { to edge when (i < 16384)  src_low_gset(60,0)  return 0 }
    state edge { word[19750000+i*8]=0  i=i+1  to edges }
}

; Locate, validate, and uniquely select the exact role-3 row for one authored
; callee-name token.  The returned value is written to word[19990000].
proc v3_call_binding(source,start,count) {
    let i=0
    let row=0
    let role=0
    let kind=0
    let declaration=0
    let target=0
    let matches=0
    state rows { to row_one when (i < l4_count(2))  to unique }
    state row_one {
        row=l4_base(2)+i*28  role=l4_wbyte(row+8)  kind=l4_wbyte(row+9)
        to next when (role != 3)
        to bad when (l4_wu32(row) != i)
        to bad when (kind != 2)
        to bad when (l4_wbyte(row+10) != 0)
        to bad when (l4_wbyte(row+11) != 0)
        to bad when (l4_wu32(row+4) >= l4_count(0))
        to bad when (l4_wu32(row+16) < 1)
        to bad when (l4_source_span_ok(l4_wu32(row+4),l4_wu32(row+12),l4_wu32(row+16)) == 0)
        declaration=l4_wu32(row+20)
        to bad when (declaration >= l4_count(3))
        to bad when (l4_row_byte(3,declaration,28,4) != 2)
        target=l4_row(3,declaration,28,24)
        to bad when (target >= l4_count(7))
        to bad when (l4_wu32(row+24) != 4294967295)
        to next when (l4_wu32(row+4) != source)
        to next when (l4_wu32(row+12) != start)
        to next when (l4_wu32(row+16) != count)
        to bad when (word[19700000+i*8] != 0)
        word[19700000+i*8]=1  word[19990000]=target  matches=matches+1
        to next
    }
    state next { i=i+1  to rows }
    state unique { to bad when (matches != 1)  return 0 }
    state bad { return src_reject() }
}

proc v3_call_finish() {
    let i=0
    let j=0
    let row=0
    let processed=0
    let found=0
    state consumed { to consumed_one when (i < l4_count(2))  i=0  to indegree_clear }
    state consumed_one { row=l4_base(2)+i*28  to consumed_next when (l4_wbyte(row+8) != 3)  to bad when (word[19700000+i*8] != 1)  to consumed_next }
    state consumed_next { i=i+1  to consumed }
    state indegree_clear { to indegree_one when (i < l4_count(7))  i=0  to indegree_rows }
    state indegree_one { word[19992000+i*8]=0  word[19993024+i*8]=0  i=i+1  to indegree_clear }
    state indegree_rows { to edge_row when (i < l4_count(7))  processed=0  to topo }
    state edge_row { j=0  to edge_columns }
    state edge_columns { to edge_one when (j < l4_count(7))  i=i+1  to indegree_rows }
    state edge_one { to edge_next when (word[19750000+(i*128+j)*8] == 0)  word[19992000+j*8]=word[19992000+j*8]+1  to edge_next }
    state edge_next { j=j+1  to edge_columns }
    state topo { to done when (processed == l4_count(7))  found=0  i=0  to topo_scan }
    state topo_scan { to topo_one when (i < l4_count(7))  to bad when (found == 0)  to topo }
    state topo_one { to topo_next when (word[19993024+i*8] != 0)  to topo_next when (word[19992000+i*8] != 0)  word[19993024+i*8]=1  processed=processed+1  found=1  j=0  to topo_edges }
    state topo_edges { to topo_edge when (j < l4_count(7))  to topo }
    state topo_edge { to topo_edge_next when (word[19750000+(i*128+j)*8] == 0)  to bad when (word[19992000+j*8] == 0)  word[19992000+j*8]=word[19992000+j*8]-1  to topo_edge_next }
    state topo_edge_next { j=j+1  to topo_edges }
    state topo_next { i=i+1  to topo_scan }
    state done { return 0 }
    state bad { return src_reject() }
}

; CKIR2 arithmetic is trapping.  A typed scalar expression therefore remains
; assignable to its exact type even when its conservative abstract interval
; reaches beyond that type's range; runtime evaluation checks the actual Add.
; Untyped literals still require a complete range proof before materializing.
proc src_low_scalar_assignable(expected,actual) {
    state literal_int { to int_expected when (actual == 4294967294)  to literal_bool }
    state int_expected { to no when (src_type(expected,0) > 2)  to range }
    state literal_bool { to bool_expected when (actual == 4294967293)  to typed }
    state bool_expected { to no when (src_type(expected,0) != 3)  to yes }
    state typed { to no when (src_low_types_same(expected,actual) == 0)  to yes }
    state range { to no when (src_low_g(21) < src_type(expected,7))  to no when (src_low_g(22) > src_type(expected,8))  to yes }
    state yes { return 1 }
    state no { return 0 }
}

; Replacement for the CKIR1 two-operand emitter.  Receiver is always staged
; first, explicit call arguments follow in source order, and immediate 1 is
; fixed at zero by the common row comparison.
proc src_low_emit(opcode,result_kind,result_type,operand_count) {
    let op=src_low_g(0)
    let operands=src_low_g(1)
    let result=4294967295
    let i=0
    let value=0
    state capacity { to exhausted when (op >= 32768)  to operand_capacity }
    state operand_capacity { to exhausted when (operand_count > 94208-operands)  to result }
    state result { to no_result when (result_kind == 0)  to value_result when (result_kind == 1)  to place_result }
    state value_result { to exhausted when (src_low_g(2) >= 36864)  result=src_low_g(2)  word[18900000+result*8]=result_type  src_low_gset(2,result+1)  src_low_gset(27,result)  src_low_gset(28,4294967295)  to store }
    state place_result { to exhausted when (src_low_g(3) >= 32768)  result=src_low_g(3)  word[19300000+result*8]=result_type  src_low_gset(3,result+1)  src_low_gset(27,4294967295)  src_low_gset(28,result)  to store }
    state no_result { result=4294967295  result_type=4294967295  src_low_gset(27,4294967295)  src_low_gset(28,4294967295)  to store }
    state store {
        src_low_op_set(op,0,src_low_g(4))  src_low_op_set(op,1,src_low_g(6))
        src_low_op_set(op,2,opcode)  src_low_op_set(op,3,result_kind)
        src_low_op_set(op,4,result)  src_low_op_set(op,5,result_type)
        src_low_op_set(op,6,operands)  src_low_op_set(op,7,operand_count)
        src_low_op_set(op,8,src_low_g(52))  i=0  to operand_loop
    }
    state operand_loop { to operand_one when (i < operand_count)  to finish }
    state operand_one { to operand_zero when (i == 0)  to operand_second when (i == 1)  value=word[20100000+(i-2)*8]  to operand_store }
    state operand_zero { value=src_low_g(50)  to operand_store }
    state operand_second { value=src_low_g(51)  to operand_store }
    state operand_store { src_low_operand_set(operands+i,value)  i=i+1  to operand_loop }
    state finish { src_low_gset(0,op+1)  src_low_gset(1,operands+operand_count)  src_low_block_set(src_low_g(6),1,src_low_block(src_low_g(6),1)+1)  return 0 }
    state exhausted { return src_exhaust() }
}

; Replacement postfix parser.  Ordinary field/index behavior is retained;
; self.name(...) additionally joins the exact role-3 declaration and lowers
; its receiver before arguments, arguments left-to-right, then opcode 10.
proc src_low_postfix() {
    let base_type=0
    let base_place=0
    let base_lvalue=0
    let base_mutable=0
    let field=0
    let name_start=0
    let name_count=0
    let target=0
    let depth=0
    let slot=0
    let parameter=0
    let index_value=0
    let index_high=0
    let index_tree=0
    let i=0
    state primary { to done when (src_low_primary() != 0)  to loop }
    state loop { to member when (word[524416] == 46)  to index when (word[524416] == 91)  return 0 }
    state member { to exhausted when (src_low_g(29) >= 8)  base_type=src_low_g(20)  base_place=src_low_g(28)  base_mutable=src_low_g(24)  src_next()  to member_name }
    state member_name { to bad when (word[524416] != 256)  name_start=word[524424]  name_count=word[524432]  src_next()  to call when (word[524416] == 40)  to member_type }
    state member_type { to bad when (base_type >= word[10000048])  to bad when (src_type(base_type,0) != 4)  field=src_low_find_field(src_type(base_type,3),name_start,name_count)  to bad when (field == 4294967295)  to member_place }
    state member_place { to bad when (base_place == 4294967295)  src_low_gset(20,src_field(field,3))  src_low_gset(21,src_type(src_field(field,3),7))  src_low_gset(22,src_type(src_field(field,3),8))  src_low_gset(23,1)  src_low_gset(24,base_mutable)  src_low_gset(25,1)  src_low_gset(26,field)  src_low_gset(29,src_low_g(29)+1)  src_low_gset(30,src_low_g(30)+1)  to exhausted when (src_low_g(30) > 8)  to member_refine }
    state member_refine { to member_emit when (src_low_g(5) == 4294967295)  to member_emit when (word[19600000+src_low_g(5)*32] != 1)  to member_emit when (word[19600008+src_low_g(5)*32] != 1)  to member_emit when (word[19600016+src_low_g(5)*32] != field)  to member_emit when (src_low_g(22) <= word[19600024+src_low_g(5)*32])  src_low_gset(22,word[19600024+src_low_g(5)*32])  to member_emit }
    state member_emit { src_low_gset(50,base_place)  src_low_gset(51,0)  src_low_gset(52,field)  to done when (src_low_emit(3,2,src_type(src_field(field,3),9),1) != 0)  to loop }

    state call { to bad when (base_type >= word[10000048])  to bad when (src_type(base_type,0) != 4)  to bad when (base_place == 4294967295)  to binding }
    state binding { to done when (v3_call_binding(src_machine(src_low_g(4),16),name_start,name_count) != 0)  target=word[19990000]  to owner }
    state owner { to bad when (src_type(base_type,3) != src_machine(target,2))  to access }
    state access { to access_mutable when (src_machine(target,8) == 1)  to access_ready }
    state access_mutable { to bad when (base_mutable == 0)  to access_ready }
    state access_ready { depth=src_low_g(60)  to exhausted when (depth >= 8)  to call_push }
    state call_push { word[19900000+depth*8]=target  word[19900100+depth*8]=base_place  word[19900200+depth*8]=0  src_low_gset(60,depth+1)  src_next()  to call_args }
    state call_args { depth=src_low_g(60)-1  target=word[19900000+depth*8]  i=word[19900200+depth*8]  to call_arg when (i < src_machine(target,6))  to call_close }
    state call_arg { to bad when (word[524416] == 41)  to done when (src_low_expression() != 0)  depth=src_low_g(60)-1  target=word[19900000+depth*8]  i=word[19900200+depth*8]  parameter=src_machine(target,5)+i  to arg_type }
    state arg_type { to bad when (src_low_scalar_assignable(src_param(parameter,3),src_low_g(20)) == 0)  to done when (src_low_materialize(src_type(src_param(parameter,3),9)) != 0)  word[19901000+(depth*8+i)*8]=src_low_g(27)  i=i+1  word[19900200+depth*8]=i  to arg_comma when (i < src_machine(target,6))  to call_close }
    state arg_comma { to bad when (word[524416] != 44)  src_next()  to call_args }
    state call_close { to bad when (word[524416] != 41)  src_next()  depth=src_low_g(60)-1  target=word[19900000+depth*8]  i=word[19900200+depth*8]  to bad when (i != src_machine(target,6))  to call_stage }
    state call_stage { src_low_gset(50,word[19900100+depth*8])  i=0  to call_stage_args }
    state call_stage_args { to call_stage_one when (i < word[19900200+depth*8])  src_low_gset(52,target)  to call_emit }
    state call_stage_one { to stage_first when (i == 0)  word[20100000+(i-1)*8]=word[19901000+(depth*8+i)*8]  to stage_next }
    state stage_first { src_low_gset(51,word[19901000+(depth*8+i)*8])  to stage_next }
    state stage_next { i=i+1  to call_stage_args }
    state call_emit { to call_unit when (src_machine(target,7) == 4294967295)  to call_value }
    state call_unit { to done when (src_low_emit(10,0,4294967295,1+word[19900200+depth*8]) != 0)  src_low_gset(20,4294967292)  to call_edge }
    state call_value { to done when (src_low_emit(10,1,src_type(src_machine(target,7),9),1+word[19900200+depth*8]) != 0)  src_low_gset(20,src_machine(target,7))  src_low_gset(21,src_type(src_machine(target,7),7))  src_low_gset(22,src_type(src_machine(target,7),8))  to call_edge }
    state call_edge { word[19750000+(src_low_g(4)*128+target)*8]=1  src_low_gset(23,0)  src_low_gset(24,0)  src_low_gset(25,0)  src_low_gset(26,4294967295)  src_low_gset(29,0)  src_low_gset(30,src_low_g(30)+1)  src_low_gset(60,depth)  to exhausted when (src_low_g(30) > 8)  to loop }

    state index { to exhausted when (src_low_g(29) >= 8)  base_type=src_low_g(20)  base_place=src_low_g(28)  base_lvalue=src_low_g(23)  base_mutable=src_low_g(24)  to index_type }
    state index_type { to bad when (base_type >= word[10000048])  to bad when (src_type(base_type,0) != 5)  to index_push }
    state index_push { to done when (src_low_push_expr() != 0)  src_next()  to index_parse }
    state index_parse { to done when (src_low_expression() != 0)  to index_close }
    state index_close { to done when (src_expect_token(93) != 0)  to index_numeric }
    state index_numeric { to index_materialize when (src_low_g(20) == 4294967294)  to bad when (src_low_g(20) >= word[10000048])  to index_kind }
    state index_kind { to index_materialize when (src_type(src_low_g(20),0) == 1)  to index_materialize when (src_type(src_low_g(20),0) == 2)  to bad }
    state index_materialize { to index_literal when (src_low_g(20) == 4294967294)  to index_typed }
    state index_literal { to done when (src_low_materialize(src_low_g(12)) != 0)  to index_save }
    state index_typed { to done when (src_low_materialize(src_type(src_low_g(20),9)) != 0)  to index_save }
    state index_save { index_value=src_low_g(27)  index_high=src_low_g(22)  index_tree=src_low_g(30)  to done when (src_low_pop_left() != 0)  to index_bound }
    state index_bound { to bad when (index_high >= src_type(base_type,5))  to index_left when (src_low_g(30) >= index_tree)  src_low_gset(30,index_tree)  to index_left }
    state index_left { src_low_gset(20,src_type(base_type,4))  src_low_gset(21,src_type(src_type(base_type,4),7))  src_low_gset(22,src_type(src_type(base_type,4),8))  src_low_gset(23,base_lvalue)  src_low_gset(24,base_mutable)  src_low_gset(25,0)  src_low_gset(26,4294967295)  src_low_gset(29,src_low_g(29)+1)  src_low_gset(30,src_low_g(30)+1)  to exhausted when (src_low_g(30) > 8)  to index_emit }
    state index_emit { src_low_gset(50,base_place)  src_low_gset(51,index_value)  src_low_gset(52,0)  to done when (src_low_emit(4,2,src_type(src_type(base_type,4),9),2) != 0)  to loop }
    state exhausted { src_exhaust()  to done }
    state bad { src_reject()  to done }
    state done { return word[10000000] }
}

proc v3_ckir_header_check() {
    let n=word[524336]
    let i=0
    let cursor=72
    let count=0
    let ceiling=0
    let size=0
    state length { to bad when (n < 72)  to magic0 }
    state magic0 { to bad when (refinement_ckir_byte(0) != 'O')  to magic1 }
    state magic1 { to bad when (refinement_ckir_byte(1) != 'M')  to magic2 }
    state magic2 { to bad when (refinement_ckir_byte(2) != 'G')  to magic3 }
    state magic3 { to bad when (refinement_ckir_byte(3) != 'C')  to magic4 }
    state magic4 { to bad when (refinement_ckir_byte(4) != 'K')  to magic5 }
    state magic5 { to bad when (refinement_ckir_byte(5) != 'I')  to magic6 }
    state magic6 { to bad when (refinement_ckir_byte(6) != 'R')  to magic7 }
    state magic7 { to bad when (refinement_ckir_byte(7) != 0)  to schema }
    state schema {
        to bad when (refinement_ckir_byte(8) != 2)
        to bad when (refinement_ckir_byte(9) != 0)
        to bad when (refinement_ckir_byte(10) != 0)
        to bad when (refinement_ckir_byte(11) != 0)
        to bad when (refinement_ckir_byte(12) != 1)
        to bad when (refinement_ckir_byte(13) != 0)
        to bad when (refinement_ckir_byte(14) != 1)
        to bad when (refinement_ckir_byte(15) != 0)
        word[525000]=ckir_u32(16)
        to bad when (word[525000] != word[10000232])
        to counts
    }
    state counts { to one when (i < 12)  to exact }
    state one {
        count=ckir_u32(24+i*4)  word[525016+i*8]=count
        to type when (i == 0)  to record when (i == 1)
        to field when (i == 2)  to machine when (i == 3)
        to mparam when (i == 4)  to block when (i == 5)
        to bparam when (i == 6)  to operation when (i == 7)
        to operand when (i == 8)  to terminator when (i == 9)
        to value when (i == 10)  to place
    }
    state type { ceiling=8192  size=24  to bounded }
    state record { ceiling=128  size=20  to bounded }
    state field { ceiling=8192  size=16  to bounded }
    state machine { ceiling=128  size=36  to bounded }
    state mparam { ceiling=896  size=20  to bounded }
    state block { ceiling=2048  size=32  to bounded }
    state bparam { ceiling=4096  size=20  to bounded }
    state operation { ceiling=32768  size=40  to bounded }
    state operand { ceiling=94208  size=4  to bounded }
    state terminator { ceiling=2048  size=44  to bounded }
    state value { ceiling=36864  size=0  to bounded }
    state place { ceiling=32768  size=0  to bounded }
    state bounded { to exhausted when (count > ceiling)  to derived when (i >= 10)  word[525112+i*8]=cursor  cursor=cursor+count*size  to next }
    state derived { to next }
    state next { i=i+1  to counts }
    state exact { to bad when (ckir_u32(20) != n)  to bad when (cursor != n)  to exhausted when (word[525016+4*8]+word[525016+6*8] > 4096)  return 0 }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
}

proc main() {
    let status=omgrfn3_component_read()
    state frame { to done when (status != 0)  status=l4_model_prepare()  to done when (status != 0)  src_init_words()  v3_call_begin()  to ckir }
    state ckir { status=v3_ckir_header_check()  to done when (status != 0)  to lowering }
    state lowering { status=src_reconstruct_lowering_check()  to done when (status != 0)  status=v3_call_finish()  to done when (status != 0)  status=src_lower_compare_final()  to done }
    state done { return status }
}
