proc omgrfn3_l2_check() {
    let status=0 let source=0
    word[700000]=0
    status=omgrfn3_l2_read_frame()
    state framed { to done when (status!=0) status=omgrfn3_l2_decode_compilation() to compiled }
    state compiled { to done when (status!=0) omgrfn3_l2_init_words() to tokenize }
    state tokenize { to tokenize_one when (source<2) status=omgrfn3_l2_parse_sources() to parsed }
    state tokenize_one { status=omgrfn3_l2_tokenize(source) to done when (status!=0) source=source+1 to tokenize }
    state parsed { to done when (status!=0) status=omgrfn3_l2_relations() to related }
    state related { to done when (status!=0) status=omgrfn3_l2_build_expected() to built }
    state built { to done when (status!=0) status=omgrfn3_l2_compare_expected() to done }
    state done { return word[700000] }
}
