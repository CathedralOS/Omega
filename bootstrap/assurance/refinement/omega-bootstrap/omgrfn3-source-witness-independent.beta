proc omgrfn3_l2_parse_sources() {
    let status=0
    status=omgrfn3_l2_parse_module(0)
    state source0_module { to done when (status!=0) status=omgrfn3_l2_parse_data(0) to source0_data }
    state source0_data { to done when (status!=0) status=omgrfn3_l2_parse_machine(0,0,0) to source0_machine0 }
    state source0_machine0 { to done when (status!=0) status=omgrfn3_l2_parse_machine(0,1,1) to source0_machine1 }
    state source0_machine1 { to done when (status!=0) to bad when (omgrfn3_l2_current(0)!=word[710000]) status=omgrfn3_l2_parse_module(1) to source1_module }
    state source1_module { to done when (status!=0) status=omgrfn3_l2_parse_machine(1,2,2) to source1_machine0 }
    state source1_machine0 { to done when (status!=0) status=omgrfn3_l2_parse_machine(1,3,3) to source1_machine1 }
    state source1_machine1 { to done when (status!=0) to bad when (omgrfn3_l2_current(1)!=word[710008]) return 0 }
    state bad { return omgrfn3_l2_reject() }
    state done { return word[700000] }
}

; The caller first checks both lengths and places that exact length in
; word[700056].  Four arguments keep this persisted-Beta checker within the
; rung's frozen call-arity ceiling.
proc omgrfn3_l2_span_equal(a_source,a_start,b_source,b_start) {
    let i=0
    state loop { to one when (i<word[700056]) return 1 }
    state one { to no when (omgrfn3_l2_source_byte(a_source,a_start+i)!=omgrfn3_l2_source_byte(b_source,b_start+i)) i=i+1 to loop }
    state no { return 0 }
}

proc omgrfn3_l2_source_string_equal(source_id,start,length,string_id) {
    let i=0
    state length { to no when (length!=word[602176+string_id*8]) to loop }
    state loop { to one when (i<length) return 1 }
    state one { to no when (omgrfn3_l2_source_byte(source_id,start+i)!=omgrfn3_l2_omgcomp_byte(word[601664+string_id*8]+i)) i=i+1 to loop }
    state no { return 0 }
}

proc omgrfn3_l2_machine_name_equal(left,right) {
    state length { to no when (omgrfn3_l2_machine(4,left)!=omgrfn3_l2_machine(4,right)) word[700056]=omgrfn3_l2_machine(4,left) return omgrfn3_l2_span_equal(omgrfn3_l2_machine(0,left),omgrfn3_l2_machine(3,left),omgrfn3_l2_machine(0,right),omgrfn3_l2_machine(3,right)) }
    state no { return 0 }
}

proc omgrfn3_l2_relations() {
    let i=0 let j=0
    state manifest_module0 { to bad when (omgrfn3_l2_source_string_equal(0,word[840000],word[840008],word[600640])==0) to manifest_module1 }
    state manifest_module1 { to bad when (omgrfn3_l2_source_string_equal(1,word[840064],word[840072],word[600648])==0) to modules_same }
    state modules_same { to bad when (word[840008]!=word[840072]) word[700056]=word[840008] to bad when (omgrfn3_l2_span_equal(0,word[840000],1,word[840064])==0) to placement_same }
    state placement_same { to bad when (word[600640]!=word[600648]) to owners }
    state owners { to owner_one when (i<4) i=0 to names_outer }
    state owner_one { to bad when (omgrfn3_l2_machine(2,i)!=word[852008]) word[700056]=word[852008] to bad when (omgrfn3_l2_span_equal(omgrfn3_l2_machine(0,i),omgrfn3_l2_machine(1,i),0,word[852000])==0) i=i+1 to owners }
    state names_outer { to names_inner when (i<4) to calls }
    state names_inner { j=i+1 to names_loop }
    state names_loop { to names_compare when (j<4) i=i+1 to names_outer }
    state names_compare { to bad when (omgrfn3_l2_machine_name_equal(i,j)==1) j=j+1 to names_loop }
    state calls {
        to bad when (omgrfn3_l2_machine(12,0)!=omgrfn3_l2_machine(4,1)) word[700056]=omgrfn3_l2_machine(12,0)
        to bad when (omgrfn3_l2_span_equal(0,omgrfn3_l2_machine(11,0),0,omgrfn3_l2_machine(3,1))==0)
        to bad when (omgrfn3_l2_machine(12,1)!=omgrfn3_l2_machine(4,2)) word[700056]=omgrfn3_l2_machine(12,1)
        to bad when (omgrfn3_l2_span_equal(0,omgrfn3_l2_machine(11,1),1,omgrfn3_l2_machine(3,2))==0)
        to params
    }
    state params {
        to bad when (omgrfn3_l2_machine(8,1)!=omgrfn3_l2_machine(14,1)) word[700056]=omgrfn3_l2_machine(8,1)
        to bad when (omgrfn3_l2_span_equal(0,omgrfn3_l2_machine(7,1),0,omgrfn3_l2_machine(13,1))==0)
        to bad when (omgrfn3_l2_machine(8,2)!=omgrfn3_l2_machine(14,2)) word[700056]=omgrfn3_l2_machine(8,2)
        to bad when (omgrfn3_l2_span_equal(1,omgrfn3_l2_machine(7,2),1,omgrfn3_l2_machine(13,2))==0)
        to root_package
    }
    state root_package { to bad when (word[500336]!=0) to root_source }
    state root_source { to bad when (word[500344]!=0) to root_owner }
    state root_owner { to bad when (omgrfn3_l2_source_string_equal(0,word[852000],word[852008],word[500352])==0) to root_machine }
    state root_machine { to bad when (omgrfn3_l2_source_string_equal(0,omgrfn3_l2_machine(3,0),omgrfn3_l2_machine(4,0),word[500360])==0) return 0 }
    state bad { return omgrfn3_l2_reject() }
}

proc omgrfn3_l2_put_byte(value) { byte[900000+word[700048]]=value word[700048]=word[700048]+1 return value }
proc omgrfn3_l2_put_u16(value) { omgrfn3_l2_put_byte(value%256) omgrfn3_l2_put_byte((value/256)%256) return value }
proc omgrfn3_l2_put_u32(value) { omgrfn3_l2_put_byte(value%256) omgrfn3_l2_put_byte((value/256)%256) omgrfn3_l2_put_byte((value/65536)%256) omgrfn3_l2_put_byte((value/16777216)%256) return value }

proc omgrfn3_l2_emit_header_units() {
    omgrfn3_l2_put_byte('O') omgrfn3_l2_put_byte('M') omgrfn3_l2_put_byte('G') omgrfn3_l2_put_byte('R')
    omgrfn3_l2_put_byte('S') omgrfn3_l2_put_byte('W') omgrfn3_l2_put_byte('1') omgrfn3_l2_put_byte(0)
