; OMGRFN3 layer 2: independent source -> OMGRSW1 reconstruction for the
; first exact-root attached-call fixture.  This checker is intentionally a
; separate persisted-Beta executable.  It does not import resolver output as
; authority and never reads CKIR2 or ELF bytes.
;
; The admitted slice has two sources in one package and logical module, one
; empty record, four same-owner machines, two scalar parameters, and the exact
; finite call shape root -> local -> cross plus one unreachable decoy.  Names
; and source offsets are derived from independently tokenized source; no
; fixture identifier is embedded here.  The uniquely reconstructed OMGRSW1 is
; compared byte-for-byte, covering every role-2/role-3 row and every unchanged
; unit/declaration/type/record/machine/parameter/block relation.

proc omgrfn3_l2_frame_byte(index) { return byte[1048576 + index] }
proc omgrfn3_l2_omgcomp_byte(index) { return omgrfn3_l2_frame_byte(word[500024] + index) }
proc omgrfn3_l2_source_start(source_id) { return word[607040 + source_id * 8] }
proc omgrfn3_l2_source_length(source_id) { return word[607168 + source_id * 8] }
proc omgrfn3_l2_source_byte(source_id,index) { return omgrfn3_l2_omgcomp_byte(omgrfn3_l2_source_start(source_id)+index) }

proc omgrfn3_l2_reject() {
    state set { to done when (word[700000] != 0)  word[700000] = 251 }
    state done { return word[700000] }
}

proc omgrfn3_l2_exhaust() { word[700000] = 252 return 252 }

proc omgrfn3_l2_frame_u32(at) {
    return omgrfn3_l2_frame_byte(at)+omgrfn3_l2_frame_byte(at+1)*256
        +omgrfn3_l2_frame_byte(at+2)*65536+omgrfn3_l2_frame_byte(at+3)*16777216
}

proc omgrfn3_l2_read_frame() {
    let n=0 let overflow=0 let c=read_byte()
    state read { to one when (c>=0) to header }
    state one { to over when (n>=4104320) byte[1048576+n]=c n=n+1 c=read_byte() to read }
    state over { overflow=1 c=read_byte() to read }
    state header { to exhausted when (overflow==1) to bad when (n<40) to magic }
    state magic {
        to bad when (omgrfn3_l2_frame_byte(0)!='O') to bad when (omgrfn3_l2_frame_byte(1)!='M')
        to bad when (omgrfn3_l2_frame_byte(2)!='G') to bad when (omgrfn3_l2_frame_byte(3)!='R')
        to bad when (omgrfn3_l2_frame_byte(4)!='F') to bad when (omgrfn3_l2_frame_byte(5)!='N')
        to bad when (omgrfn3_l2_frame_byte(6)!='3') to bad when (omgrfn3_l2_frame_byte(7)!=0)
        to bad when (omgrfn3_l2_frame_u32(8)!=3)
        word[500016]=omgrfn3_l2_frame_u32(12) word[500032]=omgrfn3_l2_frame_u32(16)
        word[500048]=omgrfn3_l2_frame_u32(20) word[500064]=omgrfn3_l2_frame_u32(24)
        word[500080]=omgrfn3_l2_frame_u32(28) word[500088]=omgrfn3_l2_frame_u32(32)
        word[500096]=omgrfn3_l2_frame_u32(36)
        to bad when (word[500016]>1) to bad when (word[500032]<1)
        to bad when (word[500048]<1) to bad when (word[500064]<1)
        to exhausted when (word[500032]>267280) to exhausted when (word[500048]>524288)
        to exhausted when (word[500064]>2260040) to exhausted when (word[500080]>1052672)
        word[500024]=40
        to bad when (word[500032]>n-word[500024])
        word[500040]=word[500024]+word[500032]
        to bad when (word[500048]>n-word[500040])
        word[500056]=word[500040]+word[500048]
        to bad when (word[500064]>n-word[500056])
        word[500072]=word[500056]+word[500064]
        to bad when (word[500080]!=n-word[500072])
        to library when (word[500016]==0) to entry
    }
    state library { to bad when (word[500080]!=0) to bad when (word[500088]!=4294967295) to bad when (word[500096]!=4294967295) return 0 }
    state entry { to bad when (word[500080]<1) to bad when (word[500096]>255) to bad when (word[500096]!=word[500088]%256) return 0 }
    state exhausted { return omgrfn3_l2_exhaust() }
    state bad { return omgrfn3_l2_reject() }
}

proc omgrfn3_l2_comp_u32(at) {
    return omgrfn3_l2_omgcomp_byte(at)+omgrfn3_l2_omgcomp_byte(at+1)*256
        +omgrfn3_l2_omgcomp_byte(at+2)*65536+omgrfn3_l2_omgcomp_byte(at+3)*16777216
}

proc omgrfn3_l2_decode_compilation() {
    let n=word[500032] let at=0 let i=0 let owner=0 let bundle=0 let module=0
    let label_length=0 let content_length=0
    state size { to bad when (n<64) to magic }
    state magic {
        to bad when (omgrfn3_l2_omgcomp_byte(0)!='O') to bad when (omgrfn3_l2_omgcomp_byte(1)!='M')
        to bad when (omgrfn3_l2_omgcomp_byte(2)!='G') to bad when (omgrfn3_l2_omgcomp_byte(3)!='C')
        to bad when (omgrfn3_l2_omgcomp_byte(4)!='O') to bad when (omgrfn3_l2_omgcomp_byte(5)!='M')
        to bad when (omgrfn3_l2_omgcomp_byte(6)!='P') to bad when (omgrfn3_l2_omgcomp_byte(7)!=0)
        to bad when (omgrfn3_l2_omgcomp_byte(8)!=1) to bad when (omgrfn3_l2_omgcomp_byte(9)!=0)
        to bad when (omgrfn3_l2_omgcomp_byte(10)!=0) to bad when (omgrfn3_l2_omgcomp_byte(11)!=0)
        to bad when (omgrfn3_l2_omgcomp_byte(12)!=1) to bad when (omgrfn3_l2_omgcomp_byte(13)!=0)
        to bad when (omgrfn3_l2_omgcomp_byte(14)!=0) to bad when (omgrfn3_l2_omgcomp_byte(15)!=0)
        to header
    }
    state header {
        word[500280]=omgrfn3_l2_comp_u32(16) word[500288]=omgrfn3_l2_comp_u32(20)
        word[500296]=omgrfn3_l2_comp_u32(24) word[500304]=omgrfn3_l2_comp_u32(28)
        word[500312]=omgrfn3_l2_comp_u32(32) word[500320]=omgrfn3_l2_comp_u32(36)
        word[500328]=omgrfn3_l2_comp_u32(40) word[500336]=omgrfn3_l2_comp_u32(44)
        word[500344]=omgrfn3_l2_comp_u32(48) word[500352]=omgrfn3_l2_comp_u32(52)
        word[500360]=omgrfn3_l2_comp_u32(56)
        to bad when (word[500280]!=n) to bad when (word[500312]!=1)
        to bad when (word[500320]!=2) to bad when (word[500328]!=0)
        to bad when (word[500304]<1) to exhausted when (word[500304]>64)
        to exhausted when (word[500288]>263312)
        to bad when (word[500336]!=0) to bad when (word[500344]!=0)
        to bad when (word[500352]>=word[500304]) to bad when (word[500360]>=word[500304])
        ; One package row, two source rows, no aliases.
        word[500368]=64 word[500376]=112 word[500384]=152 word[500392]=152
        word[500400]=word[500392]+word[500296]
        to bad when (word[500400]>n) to bad when (word[500288]!=n-word[500400])
        ; Package row: dense zero, exact source partition, reserved zero.
        to bad when (omgrfn3_l2_comp_u32(64)!=0) to bad when (omgrfn3_l2_comp_u32(100)!=0)
        to bad when (omgrfn3_l2_comp_u32(104)!=2) to bad when (omgrfn3_l2_comp_u32(108)!=0)
        i=0 to sources
    }
    state sources { to source_row when (i<2) i=0 at=word[500392] to strings }
    state source_row {
        at=112+i*20
        to bad when (omgrfn3_l2_comp_u32(at)!=i)
        owner=omgrfn3_l2_comp_u32(at+4) bundle=omgrfn3_l2_comp_u32(at+8) module=omgrfn3_l2_comp_u32(at+12)
        to bad when (owner!=0) to bad when (bundle>=2) to bad when (module>=word[500304])
        to bad when (omgrfn3_l2_comp_u32(at+16)!=0)
        word[600384+i*8]=owner word[600512+i*8]=bundle word[600640+i*8]=module
        i=i+1 to sources
    }
    state strings { to string_row when (i<word[500304]) to bad when (at!=word[500400]) i=0 at=word[500400] to bundle_magic }
    state string_row {
        to bad when (at>word[500400]-4) content_length=omgrfn3_l2_comp_u32(at)
        to bad when (content_length>word[500400]-at-4)
        word[601664+i*8]=at+4 word[602176+i*8]=content_length
        at=at+4+content_length i=i+1 to strings
    }
    state bundle_magic {
        to bad when (word[500288]<16)
        to bad when (omgrfn3_l2_omgcomp_byte(at)!='O') to bad when (omgrfn3_l2_omgcomp_byte(at+1)!='M')
        to bad when (omgrfn3_l2_omgcomp_byte(at+2)!='G') to bad when (omgrfn3_l2_omgcomp_byte(at+3)!='0')
        to bad when (omgrfn3_l2_omgcomp_byte(at+4)!='B') to bad when (omgrfn3_l2_omgcomp_byte(at+5)!='N')
        to bad when (omgrfn3_l2_omgcomp_byte(at+6)!='D') to bad when (omgrfn3_l2_omgcomp_byte(at+7)!='L')
        to bad when (omgrfn3_l2_comp_u32(at+8)!=1) to bad when (omgrfn3_l2_comp_u32(at+12)!=2)
        at=at+16 i=0 to bundle_rows
    }
    state bundle_rows { to bundle_row when (i<2) to bad when (at!=n) i=0 to source_extents }
    state bundle_row {
        to bad when (at>n-8) label_length=omgrfn3_l2_comp_u32(at) content_length=omgrfn3_l2_comp_u32(at+4)
        to exhausted when (label_length>64) to exhausted when (content_length>131072)
        to bad when (label_length<1) to bad when (label_length>n-at-8)
        to bad when (content_length>n-at-8-label_length)
        word[607296+i*8]=at+8+label_length word[607424+i*8]=content_length
        at=at+8+label_length+content_length i=i+1 to bundle_rows
    }
    state source_extents { to source_extent when (i<2) return 0 }
    state source_extent {
        bundle=word[600512+i*8]
        word[607040+i*8]=word[607296+bundle*8] word[607168+i*8]=word[607424+bundle*8]
        i=i+1 to source_extents
    }
    state exhausted { return omgrfn3_l2_exhaust() }
    state bad { return omgrfn3_l2_reject() }
}

proc omgrfn3_l2_witness_byte(index) { return omgrfn3_l2_frame_byte(word[500040]+index) }

proc omgrfn3_l2_token_slot(source_id,token_id) { return source_id*256+token_id }
proc omgrfn3_l2_token_start(source_id,token_id) { return word[720000+omgrfn3_l2_token_slot(source_id,token_id)*8] }
proc omgrfn3_l2_token_length(source_id,token_id) { return word[760000+omgrfn3_l2_token_slot(source_id,token_id)*8] }
proc omgrfn3_l2_token_kind(source_id,token_id) { return word[800000+omgrfn3_l2_token_slot(source_id,token_id)*8] }
proc omgrfn3_l2_current(source_id) { return word[710128+source_id*8] }
proc omgrfn3_l2_advance(source_id) { word[710128+source_id*8]=word[710128+source_id*8]+1 return word[710128+source_id*8] }
proc omgrfn3_l2_machine(field,machine_id) { return word[850000+machine_id*128+field*8] }
proc omgrfn3_l2_machine_set(field,machine_id,value) { word[850000+machine_id*128+field*8]=value return value }

proc omgrfn3_l2_ident_start(c) {
    state underscore { to yes when (c=='_') to upper0 }
    state upper0 { to upper1 when (c>='A') to lower0 }
    state upper1 { to yes when (c<='Z') to lower0 }
    state lower0 { to lower1 when (c>='a') return 0 }
    state lower1 { to yes when (c<='z') return 0 }
    state yes { return 1 }
}

proc omgrfn3_l2_ident_continue(c) {
    state ident { to yes when (omgrfn3_l2_ident_start(c)==1) to digit0 }
    state digit0 { to digit1 when (c>='0') return 0 }
    state digit1 { to yes when (c<='9') return 0 }
    state yes { return 1 }
}

proc omgrfn3_l2_tokenize(source_id) {
    let p=0 let n=omgrfn3_l2_source_length(source_id) let count=0 let start=0 let c=0 let depth=0
    state skip { to classify when (p<n) to finish }
    state classify {
        c=omgrfn3_l2_source_byte(source_id,p)
        to whitespace when (c==' ') to whitespace when (c==9) to whitespace when (c==10) to whitespace when (c==13)
        to slash when (c=='/') to capacity
    }
    state whitespace { p=p+1 to skip }
    state slash {
        to capacity when (p+1>=n)
        to line_begin when (omgrfn3_l2_source_byte(source_id,p+1)=='/')
        to block_begin when (omgrfn3_l2_source_byte(source_id,p+1)=='*')
        to capacity
    }
    state line_begin { p=p+2 to line }
    state line { to finish when (p>=n) to line_byte }
    state line_byte { to whitespace when (omgrfn3_l2_source_byte(source_id,p)==10) p=p+1 to line }
    state block_begin { depth=1 p=p+2 to block }
    state block { to bad when (p>=n) to block_slash }
    state block_slash { to block_star when (omgrfn3_l2_source_byte(source_id,p)!='/') to block_open_room }
    state block_open_room { to block_advance when (p+1>=n) to block_open }
    state block_open { to block_advance when (omgrfn3_l2_source_byte(source_id,p+1)!='*') depth=depth+1 p=p+2 to block }
    state block_star { to block_advance when (omgrfn3_l2_source_byte(source_id,p)!='*') to block_close_room }
    state block_close_room { to block_advance when (p+1>=n) to block_close }
    state block_close { to block_advance when (omgrfn3_l2_source_byte(source_id,p+1)!='/') depth=depth-1 p=p+2 to skip when (depth==0) to block }
    state block_advance { p=p+1 to block }
    state capacity { to exhausted when (count>=256) start=p to ident when (omgrfn3_l2_ident_start(c)==1) to number0 }
    state ident { p=p+1 to ident_loop }
    state ident_loop {
        to save_ident when (p>=n) c=omgrfn3_l2_source_byte(source_id,p)
        to save_ident when (omgrfn3_l2_ident_continue(c)==0) to exhausted when (p-start>=64)
        p=p+1 to ident_loop
    }
    state save_ident {
        word[720000+omgrfn3_l2_token_slot(source_id,count)*8]=start
        word[760000+omgrfn3_l2_token_slot(source_id,count)*8]=p-start
        word[800000+omgrfn3_l2_token_slot(source_id,count)*8]=256 count=count+1 to skip
    }
    state number0 { to punctuation when (c<'0') to punctuation when (c>'9') p=p+1 to number }
    state number { to save_number when (p>=n) c=omgrfn3_l2_source_byte(source_id,p) to save_number when (c<'0') to save_number when (c>'9') p=p+1 to number }
    state save_number {
        word[720000+omgrfn3_l2_token_slot(source_id,count)*8]=start
        word[760000+omgrfn3_l2_token_slot(source_id,count)*8]=p-start
        word[800000+omgrfn3_l2_token_slot(source_id,count)*8]=257 count=count+1 to skip
    }
    state punctuation {
        to bad when (c>=128) to bad when (c==34)
        word[720000+omgrfn3_l2_token_slot(source_id,count)*8]=p
        word[760000+omgrfn3_l2_token_slot(source_id,count)*8]=1
        word[800000+omgrfn3_l2_token_slot(source_id,count)*8]=c count=count+1 p=p+1 to skip
    }
    state finish { word[710000+source_id*8]=count word[710128+source_id*8]=0 return 0 }
    state exhausted { return omgrfn3_l2_exhaust() }
    state bad { return omgrfn3_l2_reject() }
}

; Keyword codes: 0 module, 1 data, 2 machine, 3 mut, 4 self, 5 u8.
proc omgrfn3_l2_init_words() {
    ; moduledatamachinemutselfu8
    byte[704000]=109 byte[704001]=111 byte[704002]=100 byte[704003]=117 byte[704004]=108 byte[704005]=101
    byte[704006]=100 byte[704007]=97 byte[704008]=116 byte[704009]=97
    byte[704010]=109 byte[704011]=97 byte[704012]=99 byte[704013]=104 byte[704014]=105 byte[704015]=110 byte[704016]=101
    byte[704017]=109 byte[704018]=117 byte[704019]=116
    byte[704020]=115 byte[704021]=101 byte[704022]=108 byte[704023]=102
    byte[704024]=117 byte[704025]=56
    return 0
}

proc omgrfn3_l2_word_start(code) {
    state c0 { to x0 when (code==0) to c1 } state x0 { return 0 }
    state c1 { to x1 when (code==1) to c2 } state x1 { return 6 }
    state c2 { to x2 when (code==2) to c3 } state x2 { return 10 }
    state c3 { to x3 when (code==3) to c4 } state x3 { return 17 }
    state c4 { to x4 when (code==4) return 24 } state x4 { return 20 }
}

proc omgrfn3_l2_word_length(code) {
    state c0 { to x0 when (code==0) to c1 } state x0 { return 6 }
    state c1 { to x1 when (code==1) to c2 } state x1 { return 4 }
    state c2 { to x2 when (code==2) to c3 } state x2 { return 7 }
    state c3 { to x3 when (code==3) to c4 } state x3 { return 3 }
    state c4 { to x4 when (code==4) return 2 } state x4 { return 4 }
}

proc omgrfn3_l2_token_is_word(source_id,token_id,code) {
    let i=0 let n=omgrfn3_l2_word_length(code) let at=omgrfn3_l2_word_start(code)
    state kind { to no when (omgrfn3_l2_token_kind(source_id,token_id)!=256) to length }
    state length { to no when (omgrfn3_l2_token_length(source_id,token_id)!=n) to loop }
    state loop { to one when (i<n) return 1 }
    state one { to no when (omgrfn3_l2_source_byte(source_id,omgrfn3_l2_token_start(source_id,token_id)+i)!=byte[704000+at+i]) i=i+1 to loop }
    state no { return 0 }
}

proc omgrfn3_l2_expect_kind(source_id,kind) {
    let token=omgrfn3_l2_current(source_id)
    state room { to bad when (token>=word[710000+source_id*8]) to check }
    state check { to bad when (omgrfn3_l2_token_kind(source_id,token)!=kind) omgrfn3_l2_advance(source_id) return 0 }
    state bad { return omgrfn3_l2_reject() }
}

proc omgrfn3_l2_expect_word(source_id,code) {
    let token=omgrfn3_l2_current(source_id)
    state room { to bad when (token>=word[710000+source_id*8]) to check }
    state check { to bad when (omgrfn3_l2_token_is_word(source_id,token,code)==0) omgrfn3_l2_advance(source_id) return 0 }
    state bad { return omgrfn3_l2_reject() }
}

proc omgrfn3_l2_parse_module(source_id) {
    let token=0
    state keyword { to done when (omgrfn3_l2_expect_word(source_id,0)!=0) token=omgrfn3_l2_current(source_id) to ident }
    state ident { to done when (omgrfn3_l2_expect_kind(source_id,256)!=0) word[840000+source_id*64]=omgrfn3_l2_token_start(source_id,token) word[840008+source_id*64]=omgrfn3_l2_token_length(source_id,token) to semi }
    state semi { to done when (omgrfn3_l2_expect_kind(source_id,59)!=0) return 0 }
    state done { return word[700000] }
}

proc omgrfn3_l2_parse_data(source_id) {
    let token=0
    state keyword { to done when (omgrfn3_l2_expect_word(source_id,1)!=0) token=omgrfn3_l2_current(source_id) to ident }
    state ident { to done when (omgrfn3_l2_expect_kind(source_id,256)!=0) word[852000]=omgrfn3_l2_token_start(source_id,token) word[852008]=omgrfn3_l2_token_length(source_id,token) to open }
    state open { to done when (omgrfn3_l2_expect_kind(source_id,123)!=0) to close }
    state close { to done when (omgrfn3_l2_expect_kind(source_id,125)!=0) return 0 }
    state done { return word[700000] }
}

proc omgrfn3_l2_parse_machine(source_id,machine_id,form) {
    let token=0 let body=0
    state keyword { to done when (omgrfn3_l2_expect_word(source_id,2)!=0) omgrfn3_l2_machine_set(0,machine_id,source_id) token=omgrfn3_l2_current(source_id) to owner }
    state owner { to done when (omgrfn3_l2_expect_kind(source_id,256)!=0) omgrfn3_l2_machine_set(1,machine_id,omgrfn3_l2_token_start(source_id,token)) omgrfn3_l2_machine_set(2,machine_id,omgrfn3_l2_token_length(source_id,token)) to colon0 }
    state colon0 { to done when (omgrfn3_l2_expect_kind(source_id,58)!=0) to colon1 }
    state colon1 { to done when (omgrfn3_l2_expect_kind(source_id,58)!=0) token=omgrfn3_l2_current(source_id) to name }
    state name { to done when (omgrfn3_l2_expect_kind(source_id,256)!=0) omgrfn3_l2_machine_set(3,machine_id,omgrfn3_l2_token_start(source_id,token)) omgrfn3_l2_machine_set(4,machine_id,omgrfn3_l2_token_length(source_id,token)) to paren }
    state paren { to done when (omgrfn3_l2_expect_kind(source_id,40)!=0) to amp }
    state amp { to done when (omgrfn3_l2_expect_kind(source_id,38)!=0) to shared when (form==3) to mutable }
    state shared { to done when (omgrfn3_l2_expect_word(source_id,4)!=0) omgrfn3_l2_machine_set(5,machine_id,1) to parameters }
    state mutable { to done when (omgrfn3_l2_expect_word(source_id,3)!=0) to mutable_self }
    state mutable_self { to done when (omgrfn3_l2_expect_word(source_id,4)!=0) omgrfn3_l2_machine_set(5,machine_id,2) to parameters }
    state parameters { to parameter when (form==1) to parameter when (form==2) omgrfn3_l2_machine_set(6,machine_id,0) to close_paren }
    state parameter { to done when (omgrfn3_l2_expect_kind(source_id,44)!=0) token=omgrfn3_l2_current(source_id) to parameter_name }
    state parameter_name { to done when (omgrfn3_l2_expect_kind(source_id,256)!=0) omgrfn3_l2_machine_set(6,machine_id,1) omgrfn3_l2_machine_set(7,machine_id,omgrfn3_l2_token_start(source_id,token)) omgrfn3_l2_machine_set(8,machine_id,omgrfn3_l2_token_length(source_id,token)) to parameter_colon }
    state parameter_colon { to done when (omgrfn3_l2_expect_kind(source_id,58)!=0) to parameter_type }
