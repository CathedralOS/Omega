    state call_name { to done when (omgrfn3_l2_expect_kind(source_id,256)!=0) omgrfn3_l2_machine_set(11,machine_id,omgrfn3_l2_token_start(source_id,token)) omgrfn3_l2_machine_set(12,machine_id,omgrfn3_l2_token_length(source_id,token)) to call_open }
