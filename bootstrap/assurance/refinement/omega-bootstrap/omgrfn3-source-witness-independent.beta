    state bad { return omgrfn3_l2_reject() }
}

proc omgrfn3_l2_compare_expected() {
    let i=0
    state length { to bad when (word[500048]!=word[700048]) to loop }
    state loop { to one when (i<word[700048]) return 0 }
    state one { to bad when (omgrfn3_l2_witness_byte(i)!=byte[900000+i]) i=i+1 to loop }
    state bad { return omgrfn3_l2_reject() }
