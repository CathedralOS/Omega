    state body_room { to bad when (body>=word[710000+source_id*8]) omgrfn3_l2_machine_set(9,machine_id,omgrfn3_l2_token_start(source_id,body)) to body_form }
    state body_form { to call when (form==0) to call when (form==1) to arithmetic when (form==2) to literal }
