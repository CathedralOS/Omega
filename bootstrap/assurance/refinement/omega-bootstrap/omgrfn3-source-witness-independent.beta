    omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(word[600640])
    omgrfn3_l2_put_u32(word[840000]) omgrfn3_l2_put_u32(word[840008])
    omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(3)
    omgrfn3_l2_put_u32(1) omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(word[600648])
    omgrfn3_l2_put_u32(word[840064]) omgrfn3_l2_put_u32(word[840072])
    omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(3) omgrfn3_l2_put_u32(2)
    return 0
}

proc omgrfn3_l2_emit_binding(id) {
