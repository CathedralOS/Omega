    state first_source { word[853016]=id word[853024]=omgrfn3_l2_machine(3,id-1) word[853032]=omgrfn3_l2_machine(4,id-1) word[853040]=id-1 return 0 }
    state second_source { word[853016]=id-3 word[853024]=omgrfn3_l2_machine(3,id-1) word[853032]=omgrfn3_l2_machine(4,id-1) word[853040]=id-1 return 0 }
}

proc omgrfn3_l2_emit_declaration(id) {
