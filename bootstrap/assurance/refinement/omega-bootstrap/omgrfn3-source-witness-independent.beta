    state b0 { source=0 role=2 start=omgrfn3_l2_machine(1,0) length=omgrfn3_l2_machine(2,0) declaration=0 to emit }
    state b1 { source=0 role=3 target=2 start=omgrfn3_l2_machine(11,0) length=omgrfn3_l2_machine(12,0) declaration=2 to emit }
    state b2 { source=0 role=2 start=omgrfn3_l2_machine(1,1) length=omgrfn3_l2_machine(2,1) declaration=0 to emit }
    state b3 { source=0 role=3 target=2 start=omgrfn3_l2_machine(11,1) length=omgrfn3_l2_machine(12,1) declaration=3 to emit }
    state b4 { source=1 role=2 start=omgrfn3_l2_machine(1,2) length=omgrfn3_l2_machine(2,2) declaration=0 to emit }
    state b5 { source=1 role=2 start=omgrfn3_l2_machine(1,3) length=omgrfn3_l2_machine(2,3) declaration=0 to emit }
    state emit {
    omgrfn3_l2_put_u32(id) omgrfn3_l2_put_u32(source)
    omgrfn3_l2_put_byte(role) omgrfn3_l2_put_byte(target) omgrfn3_l2_put_u16(0)
    omgrfn3_l2_put_u32(start) omgrfn3_l2_put_u32(length)
    omgrfn3_l2_put_u32(declaration) omgrfn3_l2_put_u32(4294967295)
    return 0
    }
