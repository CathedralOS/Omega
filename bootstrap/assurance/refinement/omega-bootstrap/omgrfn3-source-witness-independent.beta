    omgrfn3_l2_put_u32(5) omgrfn3_l2_put_u32(4) omgrfn3_l2_put_u32(1)
    omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(4) omgrfn3_l2_put_u32(2)
    omgrfn3_l2_put_u32(4) omgrfn3_l2_put_u32(0)
    omgrfn3_l2_put_u32(0) omgrfn3_l2_put_u32(0)
