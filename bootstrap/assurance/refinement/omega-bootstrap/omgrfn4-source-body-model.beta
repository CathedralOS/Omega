; OMGRFN4 responsibility-4 source-body model.
;
; This compact loader preserves the frozen model's safety invariants at every
; witness index consumed by R4: dense rows, bounded references, exact owner
; partitions, source spans, and exact field/parameter/block partitions.  R3
; owns canonical table equality; these checks make adversarial same-frame bytes
; total before R4 uses them as memory indices.  No CKIR or ELF byte is read.

proc v4_model_load() {
    let i=0 let row=0 let kind=0 let target=0 let source=0 let owner=0
    let start=0 let count=0 let blocks=0 let block_count=0 let cursor=0
    let block_cursor=0 let state_id=0 let ordinal=0
    state declarations { to declaration when (i<l4_count(3)) i=0 to types }
    state declaration {
        row=l4_base(3)+i*28 kind=l4_wbyte(row+4) source=l4_wu32(row+8)
        start=l4_wu32(row+16) count=l4_wu32(row+20) target=l4_wu32(row+24)
        to bad when (l4_wu32(row)!=i) to bad when (kind<1) to bad when (kind>2)
        to bad when (source>=l4_count(0)) to bad when (count<1)
        to bad when (l4_source_span_ok(source,start,count)==0)
        to record_decl when (kind==1) to machine_decl
    }
    state record_decl {
        to bad when (target>=l4_count(5)) word[534512+target*8]=source
        src_record_set(target,0,l4_named_span(source,start)) src_record_set(target,1,count)
        i=i+1 to declarations
    }
    state machine_decl { to bad when (target>=l4_count(7)) word[535512+target*8]=source i=i+1 to declarations }
    state types { to type when (i<l4_count(4)) i=0 cursor=0 to records }
    state type {
        row=l4_base(4)+i*24 kind=l4_wbyte(row+4) target=l4_wu32(row+8) count=l4_wu32(row+12)
        to bad when (l4_wu32(row)!=i) to bad when (kind<1) to bad when (kind>5)
        to nominal_type when (kind==4) to array_type when (kind==5) to save_type
    }
    state nominal_type { to bad when (target>=l4_count(5)) to save_type }
    state array_type { to bad when (target>=l4_count(4)) to bad when (count>65536) to save_type }
    state save_type {
        src_ck_type_set(i,0,kind) src_ck_type_set(i,1,l4_wbyte(row+5))
        src_ck_type_set(i,2,target) src_ck_type_set(i,3,count)
        src_ck_type_set(i,4,l4_wu32(row+16)) src_ck_type_set(i,5,l4_wu32(row+20))
        src_type_set(i,0,kind) src_type_set(i,3,target) src_type_set(i,4,target)
        src_type_set(i,5,count) src_type_set(i,6,l4_wbyte(row+5))
        src_type_set(i,7,l4_wu32(row+16)) src_type_set(i,8,l4_wu32(row+20))
        src_type_set(i,9,i) src_type_set(i,10,0) src_type_set(i,11,0) src_type_set(i,12,0)
        i=i+1 to types
    }
    state records { to record when (i<l4_count(5)) i=0 to record_exact }
    state record {
        row=l4_base(5)+i*24 target=l4_wu32(row+8) start=l4_wu32(row+12) count=l4_wu32(row+16)
        to bad when (l4_wu32(row)!=i) to bad when (target>=l4_count(4))
        to bad when (src_type(target,0)!=4) to bad when (src_type(target,3)!=i)
        to bad when (start!=cursor) to bad when (count>l4_count(6)-cursor) to bad when (count>64)
        src_record_set(i,2,l4_wbyte(row+20)) src_record_set(i,3,start)
        src_record_set(i,4,count) src_record_set(i,7,0) src_record_set(i,8,target)
        cursor=cursor+count i=i+1 to records
    }
    state record_exact { to bad when (cursor!=l4_count(6)) i=0 to fields }
    state fields { to field when (i<l4_count(6)) i=0 cursor=0 block_cursor=0 to machines }
    state field {
        row=l4_base(6)+i*24 owner=l4_wu32(row+4) ordinal=l4_wu32(row+8)
        target=l4_wu32(row+12) start=l4_wu32(row+16) count=l4_wu32(row+20)
        to bad when (l4_wu32(row)!=i) to bad when (owner>=l4_count(5))
        to bad when (i<src_record(owner,3)) to bad when (i>=src_record(owner,3)+src_record(owner,4))
        to bad when (ordinal!=i-src_record(owner,3)) to bad when (target>=l4_count(4))
        source=word[534512+owner*8] to bad when (count<1)
        to bad when (l4_source_span_ok(source,start,count)==0)
        src_field_set(i,0,owner) src_field_set(i,1,l4_named_span(source,start))
        src_field_set(i,2,count) src_field_set(i,3,target) i=i+1 to fields
    }
    state machines { to machine when (i<l4_count(7)) i=0 to machine_exact }
    state machine {
        row=l4_base(7)+i*40 owner=l4_wu32(row+8) start=l4_wu32(row+20)
        count=l4_wu32(row+24) blocks=l4_wu32(row+28) block_count=l4_wu32(row+32)
        target=l4_wu32(row+16) to bad when (l4_wu32(row)!=i)
        to bad when (owner>=l4_count(5)) to result_ok when (target==4294967295)
        to bad when (target>=l4_count(4))
    }
    state result_ok {
        to bad when (start!=cursor) to bad when (count>l4_count(8)-cursor)
        to bad when (blocks!=block_cursor) to bad when (block_count<1)
        to bad when (block_count>l4_count(9)-blocks)
        src_machine_set(i,2,owner) src_machine_set(i,5,start) src_machine_set(i,6,count)
        src_machine_set(i,7,target) src_machine_set(i,8,l4_wbyte(row+12)-1)
        src_machine_set(i,9,src_record(owner,8)) src_machine_set(i,12,blocks-i)
        src_machine_set(i,13,block_count-1) src_machine_set(i,15,blocks)
        src_machine_set(i,16,word[535512+i*8]) cursor=cursor+count
        block_cursor=block_cursor+block_count i=i+1 to machines
    }
    state machine_exact { to bad when (cursor!=l4_count(8)) to bad when (block_cursor!=l4_count(9)) i=0 to mparams }
    state mparams { to mparam when (i<l4_count(8)) i=0 cursor=0 to blocks_loop }
    state mparam {
        row=l4_base(8)+i*24 owner=l4_wu32(row+4) ordinal=l4_wu32(row+8)
        target=l4_wu32(row+12) start=l4_wu32(row+16) count=l4_wu32(row+20)
        to bad when (l4_wu32(row)!=i) to bad when (owner>=l4_count(7))
        to bad when (i<src_machine(owner,5)) to bad when (i>=src_machine(owner,5)+src_machine(owner,6))
        to bad when (ordinal!=i-src_machine(owner,5)) to bad when (target>=l4_count(4))
        source=src_machine(owner,16) to bad when (count<1)
        to bad when (l4_source_span_ok(source,start,count)==0)
        src_param_set(i,1,l4_named_span(source,start)) src_param_set(i,2,count)
        src_param_set(i,3,target) i=i+1 to mparams
    }
    state blocks_loop { to block when (i<l4_count(9)) i=0 to block_exact }
    state block {
        row=l4_base(9)+i*40 owner=l4_wu32(row+4) ordinal=l4_wu32(row+8)
        start=l4_wu32(row+16) count=l4_wu32(row+20)
        to bad when (l4_wu32(row)!=i) to bad when (owner>=l4_count(7))
        to bad when (i<src_machine(owner,15))
        to bad when (i>=src_machine(owner,15)+src_machine(owner,13)+1)
        to bad when (ordinal!=i-src_machine(owner,15))
        source=src_machine(owner,16) to bad when (count<start)
        to bad when (l4_source_span_ok(source,start,count-start)==0)
        to bad when (l4_wu32(row+32)!=cursor)
        to bad when (l4_wu32(row+36)>l4_count(10)-cursor)
        to entry_block when (ordinal==0) to named_block
    }
    state entry_block {
        src_machine_set(owner,10,start) src_machine_set(owner,14,count) to block_next
    }
    state named_block {
        to bad when (l4_wu32(row+28)<1)
        to bad when (l4_source_span_ok(source,l4_wu32(row+24),l4_wu32(row+28))==0)
        state_id=i-owner-1 src_state_set(state_id,1,l4_named_span(source,l4_wu32(row+24)))
        src_state_set(state_id,2,l4_wu32(row+28)) src_state_set(state_id,3,l4_count(8)+cursor)
        src_state_set(state_id,4,l4_wu32(row+36)) src_state_set(state_id,5,l4_wbyte(row+12)-1)
        src_state_set(state_id,6,start) src_state_set(state_id,7,count)
        src_state_set(state_id,8,i) src_state_set(state_id,9,source) to block_next
    }
    state block_next { cursor=cursor+l4_wu32(row+36) i=i+1 to blocks_loop }
    state block_exact { to bad when (cursor!=l4_count(10)) i=0 to bparams }
    state bparams { to bparam when (i<l4_count(10)) to finish }
    state bparam {
        row=l4_base(10)+i*24 owner=l4_wu32(row+4) ordinal=l4_wu32(row+8)
        target=l4_wu32(row+12) start=l4_wu32(row+16) count=l4_wu32(row+20)
        to bad when (l4_wu32(row)!=i) to bad when (owner>=l4_count(9))
        to bad when (i<l4_row(9,owner,40,32))
        to bad when (i>=l4_row(9,owner,40,32)+l4_row(9,owner,40,36))
        to bad when (ordinal!=i-l4_row(9,owner,40,32)) to bad when (target>=l4_count(4))
        target=l4_row(9,owner,40,4) to bad when (target>=l4_count(7))
        source=src_machine(target,16) to bad when (count<1)
        to bad when (l4_source_span_ok(source,start,count)==0)
        src_param_set(l4_count(8)+i,1,l4_named_span(source,start))
        src_param_set(l4_count(8)+i,2,count) src_param_set(l4_count(8)+i,3,l4_wu32(row+12))
        i=i+1 to bparams
    }
    state finish {
        word[10000016]=l4_count(5) word[10000024]=l4_count(6)
        word[10000032]=l4_count(7) word[10000040]=l4_count(8)+l4_count(10)
        word[10000048]=l4_count(4) word[10000056]=l4_count(9)-l4_count(7)
        word[10000064]=l4_count(8) word[10000144]=l4_count(4)
        word[10000160]=l4_count(9) word[10000168]=l4_count(10)
        target=l4_wu32(64) to library when (word[524304]==0)
        to bad when (target>=l4_count(7)) word[10000232]=target return 0
    }
    state library { to bad when (target!=4294967295) word[10000232]=target return 0 }
    state bad { return l4_reject() }
}

proc v4_model_prepare() {
    let status=0
    word[530800]=0 word[10000000]=0 status=l4_decode_sources()
    state sources { to done when (status!=0) status=l4_decode_witness() to witness }
    state witness { to done when (status!=0) status=v4_model_load() to loaded }
    state loaded { to done when (status!=0) status=src_layout_all() to done }
    state done { return status }
}
