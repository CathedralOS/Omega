; Lower-rooted CKIR5/6/7 decoder, complete relation checker, and constant-image
; reconstructor. Selected-result evaluation is the independent result suffix.
; Concatenate after omgrfn7-component-envelope-r5.beta. This program deliberately
; does not import or execute either Delta CKIR producer/backend.
;
; Status 0 means the exact raw CKIR is canonical. Malformed relations return
; 251; published CKIR/image ceilings return 252. No stdout is produced.
;
; Globals at 525000:
; entry,total, fourteen counts/bases, and reconstructed operation state.
; Reconstruction arrays begin at 6000000 and remain disjoint from the envelope's
; OMGRFN7 raw-byte region [1048576,5546120).
; Schema-5 call-graph scratch occupies 10500000..10603000. Constant graph and
; image scratch occupies 13000000..13831072. Both are below Alpha's 64 MiB
; memory ceiling and disjoint from evaluator and ELF reconstruction regions.

proc ckir_u32(at) {
    return refinement_ckir_byte(at)
        + refinement_ckir_byte(at + 1) * 256
        + refinement_ckir_byte(at + 2) * 65536
        + refinement_ckir_byte(at + 3) * 16777216
}

proc ckir_u16(at) {
    return refinement_ckir_byte(at) + refinement_ckir_byte(at + 1) * 256
}

proc ckir_span_ok(start, count, length) {
    state start { to no when (start > length)  to count }
    state count { to no when (count > length - start)  return 1 }
    state no { return 0 }
}

proc ckir_entry() { state live { to saved when(word[60900000]!=0) return word[525000] } state saved { return word[60900400] } }
proc ckir_schema() { return word[524384] }
proc ckir_count(index) { state live { to saved when(word[60900000]!=0) return word[525016+index*8] } state saved { return word[60900100+index*8] } }
proc ckir_base(index) { state live { to saved when(word[60900000]!=0) return word[525400+index*8] } state saved { return word[60900300+index*8] } }

proc ckir_type_word(type_id, offset) { return ckir_u32(ckir_base(0) + type_id * 24 + offset) }
proc ckir_type_byte(type_id, offset) { return refinement_ckir_byte(ckir_base(0) + type_id * 24 + offset) }
proc ckir_record_word(record_id, offset) { return ckir_u32(ckir_base(1) + record_id * 20 + offset) }
proc ckir_record_byte(record_id, offset) { return refinement_ckir_byte(ckir_base(1) + record_id * 20 + offset) }
proc ckir_field_word(field_id, offset) { return ckir_u32(ckir_base(2) + field_id * 16 + offset) }
proc ckir_machine_word(machine_id, offset) { return ckir_u32(ckir_base(3) + machine_id * 36 + offset) }
proc ckir_machine_byte(machine_id, offset) { return refinement_ckir_byte(ckir_base(3) + machine_id * 36 + offset) }
proc ckir_mparam_word(param_id, offset) { return ckir_u32(ckir_base(4) + param_id * 20 + offset) }
proc ckir_block_word(block_id, offset) { return ckir_u32(ckir_base(5) + block_id * 32 + offset) }
proc ckir_block_byte(block_id, offset) { return refinement_ckir_byte(ckir_base(5) + block_id * 32 + offset) }
proc ckir_bparam_word(param_id, offset) { return ckir_u32(ckir_base(6) + param_id * 20 + offset) }
proc ckir_const_word(node_id, offset) { return ckir_u32(ckir_base(7) + node_id * 24 + offset) }
proc ckir_child(index) { return ckir_u32(ckir_base(8) + index * 4) }
proc ckir_op_word(op_id, offset) { return ckir_u32(ckir_base(9) + op_id * 40 + offset) }
proc ckir_op_byte(op_id, offset) { return refinement_ckir_byte(ckir_base(9) + op_id * 40 + offset) }
proc ckir_operand(index) { return ckir_u32(ckir_base(10) + index * 4) }
proc ckir_term_word(term_id, offset) { return ckir_u32(ckir_base(11) + term_id * 52 + offset) }
proc ckir_term_byte(term_id, offset) { return refinement_ckir_byte(ckir_base(11) + term_id * 52 + offset) }

; The inherited 0..13 count/base indices remain a private checker ABI. CKIR5's
; five new declaration/control tables use dedicated cells so the frozen CKIR4
; validation suffixes do not need a table-index renumbering.
proc ckir_sum_count() { return word[14200000] }
proc ckir_case_count() { return word[14200008] }
proc ckir_payload_count() { return word[14200016] }
proc ckir_arm_count() { return word[14200024] }
proc ckir_arm_arg_count() { return word[14200032] }
proc ckir_sum_base() { return word[14200100] }
proc ckir_case_base() { return word[14200108] }
proc ckir_payload_base() { return word[14200116] }
proc ckir_arm_base() { return word[14200124] }
proc ckir_arm_arg_base() { return word[14200132] }
proc ckir_sum_word(id, offset) { return ckir_u32(ckir_sum_base() + id * 20 + offset) }
proc ckir_sum_byte(id, offset) { return refinement_ckir_byte(ckir_sum_base() + id * 20 + offset) }
proc ckir_case_word(id, offset) { return ckir_u32(ckir_case_base() + id * 20 + offset) }
proc ckir_payload_word(id, offset) { return ckir_u32(ckir_payload_base() + id * 16 + offset) }
proc ckir_arm_word(id, offset) { return ckir_u32(ckir_arm_base() + id * 24 + offset) }
proc ckir_arm_byte(id, offset) { return refinement_ckir_byte(ckir_arm_base() + id * 24 + offset) }
proc ckir_arm_arg_word(id, offset) { return ckir_u32(ckir_arm_arg_base() + id * 12 + offset) }
proc ckir_arm_arg_byte(id, offset) { return refinement_ckir_byte(ckir_arm_arg_base() + id * 12 + offset) }

proc ckir_align(value, alignment) {
    return ((value + alignment - 1) / alignment) * alignment
}

proc ckir_decode_header() {
    let n = word[524336]
    let i = 0
    let cursor = 100
    let count = 0
    let ceiling = 0
    let size = 0
    state size { to bad when (n < 100)  to magic0 }
    state magic0 { to bad when (refinement_ckir_byte(0) != 'O')  to magic1 }
    state magic1 { to bad when (refinement_ckir_byte(1) != 'M')  to magic2 }
    state magic2 { to bad when (refinement_ckir_byte(2) != 'G')  to magic3 }
    state magic3 { to bad when (refinement_ckir_byte(3) != 'C')  to magic4 }
    state magic4 { to bad when (refinement_ckir_byte(4) != 'K')  to magic5 }
    state magic5 { to bad when (refinement_ckir_byte(5) != 'I')  to magic6 }
    state magic6 { to bad when (refinement_ckir_byte(6) != 'R')  to magic7 }
    state magic7 { to bad when (refinement_ckir_byte(7) != 0)  to schema }
    state schema {
        word[524384] = ckir_u16(8)
        to schema5 when (ckir_schema() == 5)
        to schema6 when (ckir_schema() == 6)
        to schema7 when (ckir_schema() == 7)
        to bad
    }
    state schema5 { to bad when (word[524376] != 7)  to schema_shared }
    state schema6 { to bad when (word[524376] != 8)  to schema_shared }
    state schema7 { to bad when (word[524376] != 9)  to schema_shared }
    state schema_shared {
        to bad when (ckir_u16(10) != 0)
        to bad when (ckir_u16(12) != 1)
        to bad when (ckir_u16(14) > 1)
        word[525000] = ckir_u32(16)
        word[60900000]=0
        word[525008] = ckir_u32(20)
        to bad when (word[525008] > 2147483647)
        to exhausted when (n > 2522192)
        to flag_present when (ckir_u16(14) == 1)
        to flag_absent
    }
    state flag_present { to bad when (ckir_entry() == 4294967295)  to counts }
    state flag_absent { to bad when (ckir_entry() != 4294967295)  to counts }
    state counts {
        ; Preserve the frozen CKIR4 checker count order while mapping the CKIR5
        ; physical header/table order explicitly.
        i = 0
        to count_loop
    }
    state count_loop { to count_one when (i < 14)  to combined }
    state count_one {
        to count_value when (i == 12)
        to count_place when (i == 13)
        to count_const when (i == 7)
        to count_child when (i == 8)
        to count_op when (i == 9)
        to count_operand when (i == 10)
        to count_term when (i == 11)
        to count_type when (i == 0)
        to count_record when (i == 1)
        to count_field when (i == 2)
        to count_machine when (i == 3)
        to count_mparam when (i == 4)
        to count_block when (i == 5)
        to count_bparam when (i == 6)
        count = 0
        to count_ready
    }
    state count_type { count = ckir_u32(24)  to count_ready }
    state count_record { count = ckir_u32(28)  to count_ready }
    state count_field { count = ckir_u32(32)  to count_ready }
    state count_machine { count = ckir_u32(48)  to count_ready }
    state count_mparam { count = ckir_u32(52)  to count_ready }
    state count_block { count = ckir_u32(56)  to count_ready }
    state count_bparam { count = ckir_u32(60)  to count_ready }
    state count_const { count = ckir_u32(64)  to count_ready }
    state count_child { count = ckir_u32(68)  to count_ready }
    state count_op { count = ckir_u32(72)  to count_ready }
    state count_operand { count = ckir_u32(76)  to count_ready }
    state count_term { count = ckir_u32(80)  to count_ready }
    state count_value { count = ckir_u32(92)  to count_ready }
    state count_place { count = ckir_u32(96)  to count_ready }
    state count_ready {
        word[525016 + i * 8] = count
        to bad when (count > 2147483647)
        to ceiling_type when (i == 0)
        to ceiling_record when (i == 1)
        to ceiling_field when (i == 2)
        to ceiling_machine when (i == 3)
        to ceiling_mparam when (i == 4)
        to ceiling_block when (i == 5)
        to ceiling_bparam when (i == 6)
        to ceiling_const when (i == 7)
        to ceiling_child when (i == 8)
        to ceiling_op when (i == 9)
        to ceiling_operand when (i == 10)
        to ceiling_term when (i == 11)
        to ceiling_value when (i == 12)
        to ceiling_place
    }
    state ceiling_type { ceiling = 8192  size = 24  to count_check }
    state ceiling_record { ceiling = 128  size = 20  to count_check }
    state ceiling_field { ceiling = 8192  size = 16  to count_check }
    state ceiling_machine { ceiling = 128  size = 36  to count_check }
    state ceiling_mparam { ceiling = 896  size = 20  to count_check }
    state ceiling_block { ceiling = 2048  size = 32  to count_check }
    state ceiling_bparam { ceiling = 4096  size = 20  to count_check }
    state ceiling_const { ceiling = 8192  size = 24  to count_check }
    state ceiling_child { ceiling = 16384  size = 4  to count_check }
    state ceiling_op { ceiling = 32768  size = 40  to count_check }
    state ceiling_operand { ceiling = 94208  size = 4  to count_check }
    state ceiling_term { ceiling = 2048  size = 52  to count_check }
    state ceiling_value { ceiling = 36864  size = 0  to count_check }
    state ceiling_place { ceiling = 32768  size = 0  to count_check }
    state count_check {
        to exhausted when (count > ceiling)
        to insert_sums when (i == 3)
        to insert_arms when (i == 12)
        to derived_only when (i >= 12)
        word[525400 + i * 8] = cursor
        cursor = cursor + count * size
        to count_next
    }
    state insert_sums {
        word[14200000] = ckir_u32(36)
        word[14200008] = ckir_u32(40)
        word[14200016] = ckir_u32(44)
        to exhausted when (word[14200000] > 128 - ckir_count(1))
        to exhausted when (word[14200008] > 4096)
        to exhausted when (word[14200016] > 4096)
        to exhausted when (ckir_count(2) > 8192 - word[14200016])
        word[14200100] = cursor
        cursor = cursor + word[14200000] * 20
        word[14200108] = cursor
        cursor = cursor + word[14200008] * 20
        word[14200116] = cursor
        cursor = cursor + word[14200016] * 16
        word[525400 + i * 8] = cursor
        cursor = cursor + count * size
        to count_next
    }
    state insert_arms {
        word[14200024] = ckir_u32(84)
        word[14200032] = ckir_u32(88)
        to exhausted when (word[14200024] > 4096)
        to exhausted when (word[14200032] > 94208 - ckir_count(10))
        word[14200124] = cursor
        cursor = cursor + word[14200024] * 24
        word[14200132] = cursor
        cursor = cursor + word[14200032] * 12
        to derived_only
    }
    state derived_only { to count_next }
    state count_next { i = i + 1  to count_loop }
    state combined {
        to exhausted when (ckir_count(4) + ckir_count(6) > 4096)
        to bad when (word[525008] != n)
        to bad when (cursor != n)
        return 0
    }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir_layout_type(type_id) {
    let kind = 0
    let payload0 = 0
    let payload1 = 0
    let size = 0
    let alignment = 1
    let record = 0
    let field = 0
    let end = 0
    let fsize = 0
    let falign = 0
    let case_id = 0
    let case_end = 0
    let payload_end = 0
    let case_size = 0
    let payload_size = 0
    let payload_align = 1
    state bounds { to bad when (type_id >= ckir_count(0))  to cached }
    state cached { to done when (byte[6300000 + type_id] == 2)  to recursive }
    state recursive { to bad when (byte[6300000 + type_id] == 1)  to begin }
    state begin {
        byte[6300000 + type_id] = 1
        kind = ckir_type_byte(type_id, 4)
        payload0 = ckir_type_word(type_id, 8)
        payload1 = ckir_type_word(type_id, 12)
        to byte_scalar when (kind == 1)
        to word_scalar when (kind == 2)
        to byte_scalar when (kind == 3)
        to nominal when (kind == 4)
        to array when (kind == 5)
        to sum_begin
    }
    state byte_scalar { size = 1  alignment = 1  to save }
    state word_scalar { size = 4  alignment = 4  to save }
    state array {
        to bad when (ckir_layout_type(payload0) != 0)
        fsize = word[6000000 + payload0 * 8]
        falign = word[6100000 + payload0 * 8]
        to array_nonzero when (payload1 > 0)
        to array_sized
    }
    state array_nonzero {
        to bad when (fsize > 2147483647 / payload1)
        to array_sized
    }
    state array_sized {
        size = fsize * payload1
        alignment = falign
        to save
    }
    state nominal {
        record = payload0
        field = ckir_record_word(record, 8)
        end = field + ckir_record_word(record, 12)
        size = 0
        alignment = 1
        to field_loop
    }
    state field_loop { to field_one when (field < end)  to nominal_finish }
    state field_one {
        payload0 = ckir_field_word(field, 12)
        to bad when (ckir_layout_type(payload0) != 0)
        fsize = word[6000000 + payload0 * 8]
        falign = word[6100000 + payload0 * 8]
        size = ckir_align(size, falign)
        word[6200000 + field * 8] = size
        to bad when (size > 2147483647 - fsize)
        size = size + fsize
        to keep_alignment when (alignment >= falign)
        alignment = falign
        to field_next
    }
    state keep_alignment { to field_next }
    state field_next { field = field + 1  to field_loop }
    state nominal_finish { size = ckir_align(size, alignment)  to save }
    state sum_begin {
        record = payload0
        case_id = ckir_sum_word(record, 8)
        case_end = case_id + ckir_sum_word(record, 12)
        payload_size = 0
        payload_align = 1
        to sum_cases
    }
    state sum_cases { to sum_case when (case_id < case_end)  to sum_finish }
    state sum_case {
        field = ckir_case_word(case_id, 12)
        payload_end = field + ckir_case_word(case_id, 16)
        case_size = 0
        to sum_fields
    }
    state sum_fields { to sum_field when (field < payload_end)  to sum_case_finish }
    state sum_field {
        payload0 = ckir_payload_word(field, 12)
        to bad when (ckir_layout_type(payload0) != 0)
        fsize = word[6000000 + payload0 * 8]
        falign = word[6100000 + payload0 * 8]
        case_size = ckir_align(case_size, falign)
        word[14000000 + field * 8] = case_size
        to bad when (case_size > 2147483647 - fsize)
        case_size = case_size + fsize
        to sum_keep_align when (payload_align >= falign)
        payload_align = falign
        to sum_field_next
    }
    state sum_keep_align { to sum_field_next }
    state sum_field_next { field = field + 1  to sum_fields }
    state sum_case_finish {
        case_size = ckir_align(case_size, payload_align)
        to sum_case_next when (payload_size >= case_size)
        payload_size = case_size
        to sum_case_next
    }
    state sum_case_next { case_id = case_id + 1  to sum_cases }
    state sum_finish {
        size = ckir_align(4, payload_align)
        word[14100000 + record * 8] = size
        to bad when (size > 2147483647 - payload_size)
        size = size + payload_size
        alignment = payload_align
        to sum_align_ready when (alignment >= 4)
        alignment = 4
        to sum_align_ready
    }
    state sum_align_ready { size = ckir_align(size, alignment)  to save }
    state save {
        to bad when (size > 2147483647)
        word[6000000 + type_id * 8] = size
        word[6100000 + type_id * 8] = alignment
        byte[6300000 + type_id] = 2
        return 0
    }
    state done { return 0 }
    state bad { return 251 }
}

proc ckir_copyable(type_id) {
    let kind = ckir_type_byte(type_id, 4)
    let child = 0
    let record = 0
    let field = 0
    let end = 0
    state cached { to yes when (byte[6320000 + type_id] == 2)  to no when (byte[6320000 + type_id] == 1)  to calculate }
    state calculate {
        to yes_save when (kind < 4)
        to array when (kind == 5)
        to sum when (kind == 6)
        record = ckir_type_word(type_id, 8)
        to no_save when (ckir_record_byte(record, 16) != 1)
        field = ckir_record_word(record, 8)
        end = field + ckir_record_word(record, 12)
        to fields
    }
    state array { child = ckir_type_word(type_id, 8)  to yes_save when (ckir_copyable(child) == 1)  to no_save }
    state sum {
        record = ckir_type_word(type_id, 8)
        to no_save when (ckir_sum_byte(record, 16) != 1)
        field = ckir_sum_word(record, 8)
        end = field + ckir_sum_word(record, 12)
        to sum_cases
    }
    state sum_cases { to sum_case when (field < end)  to yes_save }
    state sum_case {
        child = ckir_case_word(field, 12)
        record = child + ckir_case_word(field, 16)
        to sum_fields
    }
    state sum_fields { to sum_field when (child < record)  field = field + 1  to sum_cases }
    state sum_field { to no_save when (ckir_copyable(ckir_payload_word(child, 12)) == 0) child = child + 1 to sum_fields }
    state fields { to field_one when (field < end)  to yes_save }
    state field_one { child = ckir_field_word(field, 12)  to no_save when (ckir_copyable(child) == 0)  field = field + 1  to fields }
    state yes_save { byte[6320000 + type_id] = 2  return 1 }
    state no_save { byte[6320000 + type_id] = 1  return 0 }
    state yes { return 1 }
    state no { return 0 }
}

proc ckir_validate_sums() {
    let i = 0
    let j = 0
    let case_next = 0
    let payload_next = 0
    let nominal = 0
    let start = 0
    let count = 0
    let case_id = 0
    let pstart = 0
    let pcount = 0
    state sums { to sum_one when (i < ckir_sum_count())  i = 0  to cases_done }
    state sum_one {
        to bad when (ckir_sum_word(i, 0) != i)
        nominal = ckir_sum_word(i, 4)
        start = ckir_sum_word(i, 8)
        count = ckir_sum_word(i, 12)
        to bad when (nominal != ckir_count(1) + i)
        to bad when (ckir_type_byte(nominal, 4) != 6)
        to bad when (ckir_type_word(nominal, 8) != i)
        to bad when (start != case_next)
        to bad when (count < 1)
        to exhausted when (count > 64)
        to bad when (ckir_span_ok(start, count, ckir_case_count()) == 0)
        to bad when (ckir_sum_byte(i, 16) > 1)
        to bad when (ckir_sum_byte(i, 17) != 0)
        to bad when (ckir_sum_byte(i, 18) != 0)
        to bad when (ckir_sum_byte(i, 19) != 0)
        j = 0
        to sum_cases
    }
    state sum_cases { to sum_case when (j < count)  to sum_next }
    state sum_case {
        case_id = start + j
        to bad when (ckir_case_word(case_id, 0) != case_id)
        to bad when (ckir_case_word(case_id, 4) != i)
        to bad when (ckir_case_word(case_id, 8) != j)
        pstart = ckir_case_word(case_id, 12)
        pcount = ckir_case_word(case_id, 16)
        to bad when (pstart != payload_next)
        to exhausted when (pcount > 4)
        to bad when (ckir_span_ok(pstart, pcount, ckir_payload_count()) == 0)
        case_next = case_next + 1
        to payload_begin
    }
    state payload_begin { nominal = 0  to payloads }
    state payloads { to payload_one when (nominal < pcount)  payload_next = payload_next + pcount  j = j + 1  to sum_cases }
    state payload_one {
        to bad when (ckir_payload_word(pstart + nominal, 0) != pstart + nominal)
        to bad when (ckir_payload_word(pstart + nominal, 4) != case_id)
        to bad when (ckir_payload_word(pstart + nominal, 8) != nominal)
        to bad when (ckir_payload_word(pstart + nominal, 12) >= ckir_count(0))
        nominal = nominal + 1
        to payloads
    }
    state sum_next { case_next = case_next + 0  i = i + 1  to sums }
    state cases_done {
        to bad when (case_next != ckir_case_count())
        to bad when (payload_next != ckir_payload_count())
        return 0
    }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir_validate_types_records() {
    let i = 0
    let j = 0
    let kind = 0
    let flags = 0
    let payload0 = 0
    let payload1 = 0
    let low = 0
    let high = 0
    let field_next = 0
    let field = 0
    let field_count = 0
    let nominal_count = 0
    let sum_nominal_count = 0
    state types { to type_one when (i < ckir_count(0))  to records_begin }
    state type_one {
        to bad when (ckir_type_word(i, 0) != i)
        kind = ckir_type_byte(i, 4)
        flags = ckir_type_byte(i, 5)
        payload0 = ckir_type_word(i, 8)
        payload1 = ckir_type_word(i, 12)
        low = ckir_type_word(i, 16)
        high = ckir_type_word(i, 20)
        to bad when (kind < 1)
        to bad when (kind > 6)
        to bad when (flags > 1)
        to bad when (ckir_u16(ckir_base(0) + i * 24 + 6) != 0)
        to scalar when (kind < 4)
        to nominal when (kind == 4)
        to array when (kind == 5)
        to sum_nominal
    }
    state scalar {
        to bad when (payload0 != 0)
        to bad when (payload1 != 0)
        to bad when (low > high)
        to byte_bounds when (kind == 1)
        to word_bounds when (kind == 2)
        to bool when (kind == 3)
        to intern_begin
    }
    state byte_bounds { to bad when (high > 255)  to intern_begin }
    state word_bounds { to bad when (high > 2147483647)  to intern_begin }
    state bool {
        to bad when (flags != 0)
        to bad when (low != 0)
        to bad when (high != 1)
        to intern_begin
    }
    state nominal {
        to bad when (flags != 0)
        to bad when (payload0 >= ckir_count(1))
        to bad when (payload1 != 0)
        to bad when (low != 0)
        to bad when (high != 0)
        nominal_count = nominal_count + 1
        to intern_begin
    }
    state sum_nominal {
        to bad when (flags != 0)
        to bad when (payload0 >= ckir_sum_count())
        to bad when (payload1 != 0)
        to bad when (low != 0)
        to bad when (high != 0)
        sum_nominal_count = sum_nominal_count + 1
        to intern_begin
    }
    state array {
        to bad when (payload0 >= ckir_count(0))
        to exhausted when (payload1 > 65536)
        to bad when (low != 0)
        to bad when (high != 0)
        to intern_begin
    }
    state intern_begin { j = 0  to intern_loop }
    state intern_loop { to intern_one when (j < i)  to type_next }
    state intern_one {
        to intern_next when (ckir_type_byte(j, 4) != kind)
        to intern_next when (ckir_type_byte(j, 5) != flags)
        to intern_next when (ckir_type_word(j, 8) != payload0)
        to intern_next when (ckir_type_word(j, 12) != payload1)
        to intern_next when (ckir_type_word(j, 16) != low)
        to intern_next when (ckir_type_word(j, 20) != high)
        to bad
    }
    state intern_next { j = j + 1  to intern_loop }
    state type_next { i = i + 1  to types }
    state records_begin {
        to bad when (nominal_count != ckir_count(1))
        to bad when (sum_nominal_count != ckir_sum_count())
        i = 0
        field_next = 0
        to records
    }
    state records { to record_one when (i < ckir_count(1))  to records_done }
    state record_one {
        to bad when (ckir_record_word(i, 0) != i)
        payload0 = ckir_record_word(i, 4)
        field = ckir_record_word(i, 8)
        field_count = ckir_record_word(i, 12)
        to bad when (payload0 >= ckir_count(0))
        to bad when (ckir_type_byte(payload0, 4) != 4)
        to bad when (ckir_type_word(payload0, 8) != i)
        to bad when (payload0 != i)
        to bad when (field != field_next)
        to bad when (field_count > 64)
        to bad when (ckir_span_ok(field, field_count, ckir_count(2)) == 0)
        to bad when (ckir_record_byte(i, 16) > 1)
        to bad when (ckir_record_byte(i, 17) != 0)
        to bad when (ckir_record_byte(i, 18) != 0)
        to bad when (ckir_record_byte(i, 19) != 0)
        j = 0
        to fields
    }
    state fields { to field_one when (j < field_count)  to record_finish }
    state field_one {
        to bad when (ckir_field_word(field + j, 0) != field + j)
        to bad when (ckir_field_word(field + j, 4) != i)
        to bad when (ckir_field_word(field + j, 8) != j)
        to bad when (ckir_field_word(field + j, 12) >= ckir_count(0))
        j = j + 1
        to fields
    }
    state record_finish { field_next = field_next + field_count  i = i + 1  to records }
    state records_done {
        to bad when (field_next != ckir_count(2))
        to bad when (ckir_validate_sums() != 0)
        i = 0
        to layouts
    }
    state layouts { to layout_one when (i < ckir_count(0))  to copy_records }
    state layout_one { to bad when (ckir_layout_type(i) != 0)  i = i + 1  to layouts }
    state copy_records { i = 0  to copy_loop }
    state copy_loop { to copy_one when (i < ckir_count(1))  i = 0  to copy_sums }
    state copy_one {
        to copy_next when (ckir_record_byte(i, 16) == 0)
        to bad when (ckir_copyable(ckir_record_word(i, 4)) == 0)
        to copy_next
    }
    state copy_next { i = i + 1  to copy_loop }
    state copy_sums { to copy_sum when (i < ckir_sum_count())  return 0 }
    state copy_sum {
        to copy_sum_next when (ckir_sum_byte(i, 16) == 0)
        to bad when (ckir_copyable(ckir_sum_word(i, 4)) == 0)
        to copy_sum_next
    }
    state copy_sum_next { i = i + 1  to copy_sums }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir_validate_machines_blocks() {
    let i = 0
    let j = 0
    let owner = 0
    let access = 0
    let result = 0
    let start = 0
    let count = 0
    let next_mparam = 0
    let next_block = 0
    let next_bparam = 0
    let next_op = 0
    let type_id = 0
    state machines { to machine_one when (i < ckir_count(3))  to machines_done }
    state machine_one {
        to bad when (ckir_machine_word(i, 0) != i)
        owner = ckir_machine_word(i, 4)
        access = ckir_machine_byte(i, 8)
        result = ckir_machine_word(i, 12)
        start = ckir_machine_word(i, 16)
        count = ckir_machine_word(i, 20)
        to bad when (owner >= ckir_count(1))
        to bad when (access < 1)
        to bad when (access > 2)
        to bad when (ckir_machine_byte(i, 9) != 0)
        to bad when (ckir_u16(ckir_base(3) + i * 36 + 10) != 0)
        to result_present when (result != 4294967295)
        to params
    }
    state result_present {
        to bad when (result >= ckir_count(0))
        to bad when (ckir_type_byte(result, 4) > 3)
        to params
    }
    state params {
        to bad when (start != next_mparam)
        to bad when (count > 7)
        to bad when (ckir_span_ok(start, count, ckir_count(4)) == 0)
        j = 0
        to mparams
    }
    state mparams { to mparam_one when (j < count)  to blocks }
    state mparam_one {
        type_id = ckir_mparam_word(start + j, 12)
        to bad when (ckir_mparam_word(start + j, 0) != start + j)
        to bad when (ckir_mparam_word(start + j, 4) != i)
        to bad when (ckir_mparam_word(start + j, 8) != j)
        to bad when (type_id >= ckir_count(0))
        to bad when (ckir_mparam_word(start + j, 16) != start + j)
        to structural_mparam when (ckir_type_byte(type_id, 4) > 3)
        to mparam_next
    }
    state structural_mparam { to bad when (ckir_copyable(type_id) == 0)  to mparam_next }
    state mparam_next { j = j + 1  to mparams }
    state blocks {
        next_mparam = next_mparam + count
        start = ckir_machine_word(i, 24)
        count = ckir_machine_word(i, 28)
        to bad when (start != next_block)
        to bad when (count < 1)
        to bad when (count > 128)
        to bad when (ckir_span_ok(start, count, ckir_count(5)) == 0)
        to bad when (ckir_machine_word(i, 32) != start)
        next_block = next_block + count
        i = i + 1
        to machines
    }
    state machines_done {
        to bad when (next_mparam != ckir_count(4))
        to bad when (next_block != ckir_count(5))
        i = 0
        to block_loop
    }
    state block_loop { to block_one when (i < ckir_count(5))  to blocks_done }
    state block_one {
        to bad when (ckir_block_word(i, 0) != i)
        owner = ckir_block_word(i, 4)
        access = ckir_block_byte(i, 8)
        start = ckir_block_word(i, 12)
        count = ckir_block_word(i, 16)
        to bad when (owner >= ckir_count(3))
        to bad when (access < 1)
        to bad when (access > 2)
        to bad when (access > ckir_machine_byte(owner, 8))
        to bad when (ckir_block_byte(i, 9) != 0)
        to bad when (ckir_u16(ckir_base(5) + i * 32 + 10) != 0)
        to bad when (i < ckir_machine_word(owner, 24))
        to bad when (i >= ckir_machine_word(owner, 24) + ckir_machine_word(owner, 28))
        to bad when (start != next_bparam)
        to bad when (count > 7)
        to bad when (ckir_span_ok(start, count, ckir_count(6)) == 0)
        to entry_block when (i == ckir_machine_word(owner, 32))
        to bparams_begin
    }
    state entry_block {
        to bad when (access != ckir_machine_byte(owner, 8))
        to bad when (count != 0)
        to bparams_begin
    }
    state bparams_begin { j = 0  to bparams }
    state bparams { to bparam_one when (j < count)  to block_ops }
    state bparam_one {
        type_id = ckir_bparam_word(start + j, 12)
        to bad when (ckir_bparam_word(start + j, 0) != start + j)
        to bad when (ckir_bparam_word(start + j, 4) != i)
        to bad when (ckir_bparam_word(start + j, 8) != j)
        to bad when (type_id >= ckir_count(0))
        to bad when (ckir_bparam_word(start + j, 16) != ckir_count(4) + start + j)
        to structural_bparam when (ckir_type_byte(type_id, 4) > 3)
        to bparam_next
    }
    state structural_bparam { to bad when (ckir_copyable(type_id) == 0)  to bparam_next }
    state bparam_next { j = j + 1  to bparams }
    state block_ops {
        next_bparam = next_bparam + count
        start = ckir_block_word(i, 20)
        count = ckir_block_word(i, 24)
        to bad when (start != next_op)
        to bad when (ckir_span_ok(start, count, ckir_count(9)) == 0)
        to bad when (ckir_block_word(i, 28) != i)
        next_op = next_op + count
        i = i + 1
        to block_loop
    }
    state blocks_done {
        to bad when (next_bparam != ckir_count(6))
        to bad when (next_op != ckir_count(9))
        return 0
    }
    state bad { return 251 }
}

; CKIR3 typed constant DAG storage:
; type/start/count/scalar/height/image-offset at 13000000..13465536,
; root/reachable bytes at 13350000/13360000, child IDs at 13500000,
; and independently derived image bytes at 13700000.
proc ckir_constant_key_after(id) {
    let j = 0
    let left = 0
    let right = 0
    state first { to yes when (id == 0)  to height }
    state height { to yes when (word[13280000 + id * 8] > word[13280000 + (id - 1) * 8])  to height_equal }
    state height_equal { to no when (word[13280000 + id * 8] != word[13280000 + (id - 1) * 8])  to type }
    state type { to yes when (word[13000000 + id * 8] > word[13000000 + (id - 1) * 8])  to type_equal }
    state type_equal { to no when (word[13000000 + id * 8] != word[13000000 + (id - 1) * 8])  to payload }
    state payload { to scalar when (word[13280000 + id * 8] == 0)  to count }
    state scalar { to yes when (word[13210000 + id * 8] > word[13210000 + (id - 1) * 8])  to no }
    state count { to yes when (word[13140000 + id * 8] > word[13140000 + (id - 1) * 8])  to count_equal }
    state count_equal { to no when (word[13140000 + id * 8] != word[13140000 + (id - 1) * 8])  to children }
    state children { to no when (j >= word[13140000 + id * 8]) left=word[13500000+(word[13070000+id*8]+j)*8] right=word[13500000+(word[13070000+(id-1)*8]+j)*8] to child_greater when (left>right) to no when (left<right) j=j+1 to children }
    state child_greater { return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc ckir_validate_constants() {
    let i = 0
    let j = 0
    let next = 0
    let type_id = 0
    let kind = 0
    let child = 0
    let expected_type = 0
    let height = 0
    let candidate = 0
    let record = 0
    let field = 0
    state rows { to row when (i < ckir_count(7))  i=0 to child_decode }
    state row {
        to bad when (ckir_const_word(i,0) != i)
        type_id = ckir_const_word(i,4)
        to bad when (type_id >= ckir_count(0))
        word[13000000+i*8]=type_id
        word[13070000+i*8]=ckir_const_word(i,8)
        word[13140000+i*8]=ckir_const_word(i,12)
        word[13210000+i*8]=ckir_const_word(i,16)
        to bad when (ckir_const_word(i,20) != 0)
        to bad when (word[13070000+i*8] != next)
        to bad when (ckir_span_ok(word[13070000+i*8],word[13140000+i*8],ckir_count(8)) == 0)
        kind = ckir_type_byte(type_id,4)
        to scalar when (kind < 4)
        to record when (kind == 4)
        to array when (kind == 5)
        to bad
    }
    state scalar {
        to bad when (word[13140000+i*8] != 0)
        to bad when (word[13210000+i*8] < ckir_type_word(type_id,16))
        to bad when (word[13210000+i*8] > ckir_type_word(type_id,20))
        to retain
    }
    state record {
        record = ckir_type_word(type_id,8)
        to bad when (word[13210000+i*8] != 0)
        to bad when (word[13140000+i*8] != ckir_record_word(record,12))
        to exhausted when (word[13140000+i*8] > 4)
        to retain
    }
    state array {
        to bad when (word[13210000+i*8] != 0)
        to bad when (word[13140000+i*8] != ckir_type_word(type_id,12))
        to exhausted when (word[13140000+i*8] > 1024)
        to retain
    }
    state retain {
        byte[13350000+i]=0 byte[13360000+i]=0
        next=next+word[13140000+i*8] i=i+1 to rows
    }
    state child_decode { to child_one when (i < ckir_count(8))  to partition }
    state child_one { word[13500000+i*8]=ckir_child(i) i=i+1 to child_decode }
    state partition { to bad when (next != ckir_count(8)) i=0 to validate }
    state validate { to validate_one when (i < ckir_count(7))  return 0 }
    state validate_one {
        type_id=word[13000000+i*8] kind=ckir_type_byte(type_id,4)
        to scalar_height when (kind < 4)
        height=1 j=0 to children
    }
    state scalar_height { word[13280000+i*8]=0 to ordered }
    state children { to height_done when (j >= word[13140000+i*8]) child=word[13500000+(word[13070000+i*8]+j)*8] to bad when (child >= i) to record_child when (kind==4) expected_type=ckir_type_word(type_id,8) to child_type }
    state record_child { record=ckir_type_word(type_id,8) field=ckir_record_word(record,8)+j expected_type=ckir_field_word(field,12) to child_type }
    state child_type { to bad when (word[13000000+child*8] != expected_type) candidate=word[13280000+child*8]+1 to keep_height when (candidate>height) to child_next }
    state keep_height { height=candidate to child_next }
    state child_next { j=j+1 to children }
    state height_done { word[13280000+i*8]=height to ordered }
    state ordered { to bad when (ckir_constant_key_after(i)==0) i=i+1 to validate }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir_validate_constant_reachability() {
    let i = ckir_count(7)
    let j = 0
    let child = 0
    let roots = 0
    state reverse_next { i=i-1 to reverse }
    state reverse { to verify_begin when (i < 0)  to root when (byte[13350000+i]==1)  to propagate }
    state root { byte[13360000+i]=1 roots=roots+1 to propagate }
    state propagate { to reverse_next when (byte[13360000+i]==0) j=0 to children }
    state children { to reverse_next when (j>=word[13140000+i*8]) child=word[13500000+(word[13070000+i*8]+j)*8] byte[13360000+child]=1 j=j+1 to children }
    state verify_begin { i=0 to verify }
    state verify { to roots_relation when (i>=ckir_count(7)) to bad when (byte[13360000+i]==0) i=i+1 to verify }
    state roots_relation { to no_constants when (ckir_count(7)==0) to bad when (roots==0) return 0 }
    state no_constants { to bad when (roots!=0) return 0 }
    state bad { return 251 }
}

proc ckir_constant_store(node,at) {
    let type_id=word[13000000+node*8]
    let value=word[13210000+node*8]
    state wide { to byte_value when (ckir_type_byte(type_id,4)!=2) byte[13700000+at]=value%256 byte[13700000+at+1]=(value/256)%256 byte[13700000+at+2]=(value/65536)%256 byte[13700000+at+3]=(value/16777216)%256 return 0 }
    state byte_value { byte[13700000+at]=value%256 return 0 }
}

proc ckir_materialize_constant(node,base) {
    let type_id=word[13000000+node*8]
    let kind=ckir_type_byte(type_id,4)
    let j=0
    let child=0
    let record=0
    let field=0
    let offset=0
    state scalar { to compound when (kind>3) return ckir_constant_store(node,base) }
    state compound { to array when (kind==5) record=ckir_type_word(type_id,8) to record_children }
    state record_children { to done when (j>=word[13140000+node*8]) field=ckir_record_word(record,8)+j child=word[13500000+(word[13070000+node*8]+j)*8] offset=word[6200000+field*8] to materialize }
    state array { to done when (j>=word[13140000+node*8]) child=word[13500000+(word[13070000+node*8]+j)*8] offset=j*word[6000000+ckir_type_word(type_id,8)*8] to materialize }
    state materialize { to bad when (ckir_materialize_constant(child,base+offset)!=0) j=j+1 to compound }
    state done { return 0 }
    state bad { return 251 }
}

proc ckir_build_constant_image() {
    let i=0
    let cursor=0
    let alignment=0
    let padding=0
    let size=0
    let clear=0
    state clear_loop { to roots when (clear>=131072) byte[13700000+clear]=0 clear=clear+1 to clear_loop }
    state roots { to round when (i>=ckir_count(7)) to root when (byte[13350000+i]==1) i=i+1 to roots }
    state root {
        alignment=word[6100000+word[13000000+i*8]*8]
        padding=(alignment-(cursor%alignment))%alignment
        to exhausted when (padding>131072-cursor)
        cursor=cursor+padding word[13400000+i*8]=cursor
        size=word[6000000+word[13000000+i*8]*8]
        to anchor when (size==0) to sized
    }
    state anchor { size=1 to sized }
    state sized { to exhausted when (size>131072-cursor) to bad when (ckir_materialize_constant(i,cursor)!=0) cursor=cursor+size i=i+1 to roots }
    state round { word[525304]=cursor to no_image when (cursor==0) padding=(4096-(cursor%4096))%4096 to exhausted when (padding>131072-cursor) word[525312]=cursor+padding return 0 }
    state no_image { word[525312]=0 return 0 }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir_value_type(value_id) { return word[6400000 + value_id * 8] }
proc ckir_value_machine(value_id) { return word[6700000 + value_id * 8] }
proc ckir_value_block(value_id) { return word[7000000 + value_id * 8] }
proc ckir_value_operation(value_id) { return word[7300000 + value_id * 8] }
proc ckir_place_type(place_id) { return word[7600000 + place_id * 8] }
proc ckir_place_mutable(place_id) { return byte[7900000 + place_id] }
proc ckir_place_block(place_id) { return word[8200000 + place_id * 8] }
proc ckir_place_operation(place_id) { return word[8500000 + place_id * 8] }

proc ckir_value_visible(value_id, machine, block, operation) {
    state bounds { to no when (value_id >= word[525208])  to machine }
    state machine { to no when (ckir_value_machine(value_id) != machine)  to block }
    state block {
        to yes when (ckir_value_block(value_id) == 4294967295)
        to no when (ckir_value_block(value_id) != block)
        to yes when (ckir_value_operation(value_id) == 4294967295)
        to no when (ckir_value_operation(value_id) >= operation)
        to yes
    }
    state yes { return 1 }
    state no { return 0 }
}

proc ckir_place_visible(place_id, block, operation) {
    state bounds { to no when (place_id >= word[525216])  to owner }
    state owner { to no when (ckir_place_block(place_id) != block)  to order }
    state order { to no when (ckir_place_operation(place_id) >= operation)  return 1 }
    state no { return 0 }
}

proc ckir_carrier_same(left_type, right_type) {
    state bounds { to no when (left_type >= ckir_count(0))  to bounds2 }
    state bounds2 { to no when (right_type >= ckir_count(0))  to compare }
    state compare { to no when (ckir_type_byte(left_type, 4) != ckir_type_byte(right_type, 4))  return 1 }
    state no { return 0 }
}

proc ckir_initialize_value_scopes() {
    let i = 0
    let type_id = 0
    let owner = 0
    state mparams { to mparam when (i < ckir_count(4))  to bparams_begin }
    state mparam {
        type_id = ckir_mparam_word(i, 12)
        word[6400000 + i * 8] = type_id
        word[6700000 + i * 8] = ckir_mparam_word(i, 4)
        word[7000000 + i * 8] = 4294967295
        word[7300000 + i * 8] = 4294967295
        i = i + 1
        to mparams
    }
    state bparams_begin { i = 0  to bparams }
    state bparams { to bparam when (i < ckir_count(6))  to done }
    state bparam {
        type_id = ckir_bparam_word(i, 12)
        owner = ckir_bparam_word(i, 4)
        word[6400000 + (ckir_count(4) + i) * 8] = type_id
        word[6700000 + (ckir_count(4) + i) * 8] = ckir_block_word(owner, 4)
        word[7000000 + (ckir_count(4) + i) * 8] = owner
        word[7300000 + (ckir_count(4) + i) * 8] = 4294967295
        i = i + 1
        to bparams
    }
    state done {
        word[525208] = ckir_count(4) + ckir_count(6)
        word[525216] = 0
        return 0
    }
}

; Schema 3 admits a bounded whole-machine call graph.  Edges are deduplicated
; in a 128x128 byte matrix so repeated calls do not inflate indegree.
proc ckir_initialize_call_graph() {
    let i = 0
    let total = 16384
    state edges { to edge_one when (i < total)  i = 0  to machines }
    state edge_one { byte[10500000 + i] = 0  i = i + 1  to edges }
    state machines { to machine_one when (i < ckir_count(3))  return 0 }
    state machine_one {
        word[10600000 + i * 8] = 0
        byte[10602000 + i] = 0
        i = i + 1
        to machines
    }
}

proc ckir_record_call_edge(caller,callee) {
    let at = caller * 128 + callee
    state duplicate { to done when (byte[10500000 + at] != 0)  to add }
    state add {
        byte[10500000 + at] = 1
        word[10600000 + callee * 8] = word[10600000 + callee * 8] + 1
        to done
    }
    state done { return 0 }
}

; Deterministic Kahn elimination checks the complete graph, including machines
; unreachable from the selected root.
proc ckir_validate_call_graph() {
    let removed = 0 let scan = 0 let chosen = 4294967295 let callee = 0
    state complete { to scan_begin when (removed < ckir_count(3))  return 0 }
    state scan_begin { scan = 0 chosen = 4294967295 to scan_loop }
    state scan_loop { to scan_one when (scan < ckir_count(3))  to selected }
    state scan_one {
        to scan_next when (byte[10602000 + scan] != 0)
        to scan_next when (word[10600000 + scan * 8] != 0)
        chosen = scan
        to selected
    }
    state scan_next { scan = scan + 1  to scan_loop }
    state selected { to bad when (chosen == 4294967295) byte[10602000 + chosen] = 1 removed = removed + 1 callee = 0 to outgoing }
    state outgoing { to outgoing_one when (callee < ckir_count(3)) to complete }
    state outgoing_one { to outgoing_next when (byte[10500000 + chosen * 128 + callee] == 0) word[10600000 + callee * 8] = word[10600000 + callee * 8] - 1 to outgoing_next }
    state outgoing_next { callee = callee + 1 to outgoing }
    state bad { return 251 }
}

proc ckir_validate_operations() {
    let i = 0
    let opcode = 0
    let result_kind = 0
    let result_id = 0
    let result_type = 0
    let owner = 0
    let block = 0
    let operand_start = 0
    let operand_count = 0
    let a = 0
    let b = 0
    let base_type = 0
    let source_type = 0
    let expected_kind = 0
    let next_operand = 0
    let callee = 0
    let parameter = 0
    let argument = 0
    let j = 0
    let logical_not_count = 0
    let logical_binary_count = 0
    state begin { ckir_initialize_value_scopes() ckir_initialize_call_graph() to loop }
    state loop { to one when (i < ckir_count(9))  to finish }
    state one {
        to bad when (ckir_op_word(i, 0) != i)
        owner = ckir_op_word(i, 4)
        block = ckir_op_word(i, 8)
        opcode = ckir_op_byte(i, 12)
        result_kind = ckir_op_byte(i, 13)
        result_id = ckir_op_word(i, 16)
        result_type = ckir_op_word(i, 20)
        operand_start = ckir_op_word(i, 24)
        operand_count = ckir_op_word(i, 28)
        to bad when (block >= ckir_count(5))
        to bad when (owner != ckir_block_word(block, 4))
        to bad when (i < ckir_block_word(block, 20))
        to bad when (i >= ckir_block_word(block, 20) + ckir_block_word(block, 24))
        to bad when (ckir_u16(ckir_base(9) + i * 40 + 14) != 0)
        to bad when (operand_start != next_operand)
        to bad when (ckir_span_ok(operand_start, operand_count, ckir_count(10)) == 0)
        to bad when (opcode < 1)
        to bad when (opcode > 17)
        to schema5_opcode when (ckir_schema() == 5)
        to schema6_opcode when (ckir_schema() == 6)
        to opcode_ready
    }
    state schema5_opcode { to bad when (opcode >= 15)  to opcode_ready }
    state schema6_opcode { to bad when (opcode > 15)  to opcode_ready }
    state opcode_ready {
        expected_kind = 1
        to call_kind when (opcode == 10)
        to none_kind when (opcode == 6)
        to none_kind when (opcode == 7)
        to none_kind when (opcode == 11)
        to place_kind when (opcode == 2)
        to place_kind when (opcode == 3)
        to place_kind when (opcode == 4)
        to kind_ready
    }
    state call_kind {
        callee = ckir_op_word(i, 32)
        to bad when (callee >= ckir_count(3))
        to call_unit_kind when (ckir_machine_word(callee, 12) == 4294967295)
        expected_kind = 1
        to kind_ready
    }
    state call_unit_kind { expected_kind = 0 to kind_ready }
    state none_kind { expected_kind = 0  to kind_ready }
    state place_kind { expected_kind = 2  to kind_ready }
    state kind_ready {
        to bad when (result_kind != expected_kind)
        to no_result when (result_kind == 0)
        to value_result when (result_kind == 1)
        to place_result
    }
    state no_result {
        to bad when (result_id != 4294967295)
        to bad when (result_type != 4294967295)
        to arity
    }
    state value_result {
        to bad when (result_id != word[525208])
        to bad when (result_type >= ckir_count(0))
        word[6400000 + result_id * 8] = result_type
        word[6700000 + result_id * 8] = owner
        word[7000000 + result_id * 8] = block
        word[7300000 + result_id * 8] = i
        word[525208] = word[525208] + 1
        to arity
    }
    state place_result {
        to bad when (result_id != word[525216])
        to bad when (result_type >= ckir_count(0))
        word[7600000 + result_id * 8] = result_type
        byte[7900000 + result_id] = 0
        word[8200000 + result_id * 8] = block
        word[8500000 + result_id * 8] = i
        word[525216] = word[525216] + 1
        to arity
    }
    state arity {
        to arity_constructor when (opcode == 14)
        to arity_constructor when (opcode == 13)
        to arity_call when (opcode == 10)
        to arity1 when (opcode == 11)
        to arity1 when (opcode == 15)
        to arity0 when (opcode == 1)
        to arity0 when (opcode == 2)
        to arity1 when (opcode == 3)
        to arity2 when (opcode == 4)
        to arity1 when (opcode == 5)
        to arity2 when (opcode == 6)
        to arity2 when (opcode == 7)
        to arity2
    }
    state arity_call {
        to bad when (operand_count != 1 + ckir_machine_word(callee, 20))
        to bad when (operand_count < 1)
        to bad when (operand_count > 8)
        a = ckir_operand(operand_start)
        to dispatch
    }
    state arity_constructor {
        to dispatch
    }
    state arity0 { to bad when (operand_count != 0)  to dispatch }
    state arity1 { to bad when (operand_count != 1)  a = ckir_operand(operand_start)  to dispatch }
    state arity2 { to bad when (operand_count != 2)  a = ckir_operand(operand_start)  b = ckir_operand(operand_start + 1)  to dispatch }
    state dispatch {
        to op_const when (opcode == 1)
        to op_self when (opcode == 2)
        to op_field when (opcode == 3)
        to op_index when (opcode == 4)
        to op_load when (opcode == 5)
        to op_store when (opcode == 6)
        to op_copy when (opcode == 7)
        to op_add when (opcode == 8)
        to op_call when (opcode == 10)
        to op_copy_const when (opcode == 11)
        to op_constructor when (opcode == 13)
        to op_case_constructor when (opcode == 14)
        to op_logical_not when (opcode == 15)
        to op_logical_binary when (opcode == 16)
        to op_logical_binary when (opcode == 17)
        to op_less
    }
    state immediates_zero {
        to bad when (ckir_op_word(i, 32) != 0)
        to bad when (ckir_op_word(i, 36) != 0)
        to op_next
    }
    state op_const {
        to bad when (ckir_op_word(i, 36) != 0)
        to bad when (ckir_type_byte(result_type, 4) > 3)
        to bad when (ckir_op_word(i, 32) < ckir_type_word(result_type, 16))
        to bad when (ckir_op_word(i, 32) > ckir_type_word(result_type, 20))
        to op_next
    }
    state op_self {
        to bad when (ckir_op_word(i, 32) != 0)
        to bad when (ckir_op_word(i, 36) != 0)
        to bad when (result_type != ckir_record_word(ckir_machine_word(owner, 4), 4))
        to bad when (ckir_type_byte(result_type, 4) != 4)
        to self_mutable when (ckir_block_byte(block, 8) == 2)
        to op_next
    }
    state self_mutable { byte[7900000 + result_id] = 1  to op_next }
    state op_field {
        to bad when (ckir_op_word(i, 32) >= ckir_count(2))
        to bad when (ckir_op_word(i, 36) != 0)
        to bad when (ckir_place_visible(a, block, i) == 0)
        base_type = ckir_record_word(ckir_field_word(ckir_op_word(i, 32), 4), 4)
        to bad when (ckir_place_type(a) != base_type)
        to bad when (result_type != ckir_field_word(ckir_op_word(i, 32), 12))
        byte[7900000 + result_id] = ckir_place_mutable(a)
        to op_next
    }
    state op_index {
        to bad when (ckir_op_word(i, 32) != 0)
        to bad when (ckir_op_word(i, 36) != 0)
        to bad when (ckir_place_visible(a, block, i) == 0)
        to bad when (ckir_value_visible(b, owner, block, i) == 0)
        base_type = ckir_place_type(a)
        to bad when (ckir_type_byte(base_type, 4) != 5)
        to bad when (result_type != ckir_type_word(base_type, 8))
        source_type = ckir_value_type(b)
        to bad when (ckir_type_byte(source_type, 4) < 1)
        to bad when (ckir_type_byte(source_type, 4) > 2)
        byte[7900000 + result_id] = ckir_place_mutable(a)
        to op_next
    }
    state op_load {
        to bad when (ckir_place_visible(a, block, i) == 0)
        to bad when (result_type != ckir_place_type(a))
        to bad when (ckir_type_byte(result_type, 4) > 3)
        to immediates_zero
    }
    state op_logical_not {
        to bad when (ckir_value_visible(a, owner, block, i) == 0)
        source_type = ckir_value_type(a)
        to bad when (source_type != result_type)
        to bad when (ckir_type_byte(result_type, 4) != 3)
        logical_not_count = logical_not_count + 1
        to immediates_zero
    }
    state op_logical_binary {
        to bad when (ckir_value_visible(a, owner, block, i) == 0)
        to bad when (ckir_value_visible(b, owner, block, i) == 0)
        source_type = ckir_value_type(a)
        to bad when (source_type != result_type)
        to bad when (ckir_value_type(b) != result_type)
        to bad when (ckir_type_byte(result_type, 4) != 3)
        logical_binary_count = logical_binary_count + 1
        to immediates_zero
    }
    state op_store {
        to bad when (ckir_place_visible(a, block, i) == 0)
        to bad when (ckir_value_visible(b, owner, block, i) == 0)
        to bad when (ckir_place_mutable(a) == 0)
        to bad when (ckir_carrier_same(ckir_place_type(a), ckir_value_type(b)) == 0)
        to bad when (ckir_type_byte(ckir_place_type(a), 4) > 3)
        to immediates_zero
    }
    state op_copy {
        to bad when (ckir_place_visible(a, block, i) == 0)
        to bad when (ckir_place_mutable(a) == 0)
        to bad when (ckir_op_word(i, 36) != 0)
        to copy_value when (ckir_op_word(i, 32) == 1)
        to copy_place when (ckir_op_word(i, 32) == 2)
        to bad
    }
    state copy_value {
        to bad when (ckir_value_visible(b, owner, block, i) == 0)
        source_type = ckir_value_type(b)
        to copy_type
    }
    state copy_place {
        to bad when (ckir_place_visible(b, block, i) == 0)
        source_type = ckir_place_type(b)
        to copy_type
    }
    state copy_type {
        to bad when (source_type != ckir_place_type(a))
        to bad when (ckir_type_byte(source_type, 4) < 4)
        to bad when (ckir_copyable(source_type) == 0)
        to op_next
    }
    state op_copy_const {
        to bad when (ckir_place_visible(a, block, i) == 0)
        to bad when (ckir_place_mutable(a) == 0)
        to bad when (ckir_op_word(i, 32) >= ckir_count(7))
        to bad when (ckir_op_word(i, 36) != 0)
        source_type = word[13000000 + ckir_op_word(i, 32) * 8]
        to bad when (ckir_type_byte(source_type, 4) < 4)
        to bad when (source_type != ckir_place_type(a))
        to bad when (ckir_copyable(source_type) == 0)
        byte[13350000 + ckir_op_word(i, 32)] = 1
        to op_next
    }
    state op_add {
        to bad when (ckir_value_visible(a, owner, block, i) == 0)
        to bad when (ckir_value_visible(b, owner, block, i) == 0)
        to bad when (ckir_carrier_same(ckir_value_type(a), ckir_value_type(b)) == 0)
        to bad when (ckir_carrier_same(ckir_value_type(a), result_type) == 0)
        to bad when (ckir_type_byte(result_type, 4) < 1)
        to bad when (ckir_type_byte(result_type, 4) > 2)
        to immediates_zero
    }
    state op_less {
        to bad when (ckir_value_visible(a, owner, block, i) == 0)
        to bad when (ckir_value_visible(b, owner, block, i) == 0)
        to bad when (ckir_carrier_same(ckir_value_type(a), ckir_value_type(b)) == 0)
        to bad when (ckir_type_byte(ckir_value_type(a), 4) < 1)
        to bad when (ckir_type_byte(ckir_value_type(a), 4) > 2)
        to bad when (ckir_type_byte(result_type, 4) != 3)
        to immediates_zero
    }
    state op_call {
        to bad when (ckir_op_word(i, 36) != 0)
        to bad when (ckir_place_visible(a, block, i) == 0)
        base_type = ckir_record_word(ckir_machine_word(callee, 4), 4)
        to bad when (ckir_place_type(a) != base_type)
        to call_receiver_ready when (ckir_machine_byte(callee, 8) == 1)
        to bad when (ckir_place_mutable(a) == 0)
        to call_receiver_ready
    }
    state op_constructor {
        to bad when (result_kind != 1)
        to bad when (ckir_type_byte(result_type, 4) != 4)
        base_type = ckir_type_word(result_type, 8)
        to bad when (operand_count != ckir_record_word(base_type, 12))
        to bad when (ckir_record_byte(base_type, 16) != 1)
        to bad when (ckir_copyable(result_type) == 0)
        to bad when (ckir_op_word(i, 32) != 0)
        to bad when (ckir_op_word(i, 36) != 0)
        j = 0
        to constructor_fields
    }
    state constructor_fields {
        to constructor_field when (j < operand_count)
        to exhausted when (operand_count > 4)
        to op_next
    }
    state constructor_field {
        argument = ckir_operand(operand_start + j)
        parameter = ckir_record_word(base_type, 8) + j
        to bad when (ckir_value_visible(argument, owner, block, i) == 0)
        source_type = ckir_value_type(argument)
        expected_kind = ckir_field_word(parameter, 12)
        to constructor_structural when (ckir_type_byte(expected_kind, 4) > 3)
        to bad when (ckir_type_byte(source_type, 4) != ckir_type_byte(expected_kind, 4))
        to bad when (ckir_type_word(source_type, 16) < ckir_type_word(expected_kind, 16))
        to bad when (ckir_type_word(source_type, 20) > ckir_type_word(expected_kind, 20))
        to constructor_next
    }
    state constructor_structural {
        to bad when (source_type != expected_kind)
        to constructor_next
    }
    state constructor_next { j = j + 1  to constructor_fields }
    state op_case_constructor {
        to bad when (result_kind != 1)
        to bad when (ckir_type_byte(result_type, 4) != 6)
        base_type = ckir_type_word(result_type, 8)
        parameter = ckir_op_word(i, 32)
        to bad when (parameter >= ckir_case_count())
        to bad when (ckir_case_word(parameter, 4) != base_type)
        to bad when (operand_count != ckir_case_word(parameter, 16))
        to exhausted when (operand_count > 4)
        to bad when (ckir_sum_byte(base_type, 16) != 1)
        to bad when (ckir_copyable(result_type) == 0)
        to bad when (ckir_op_word(i, 36) != 0)
        j = 0
        to case_constructor_fields
    }
    state case_constructor_fields { to case_constructor_field when (j < operand_count)  to op_next }
    state case_constructor_field {
        argument = ckir_operand(operand_start + j)
        parameter = ckir_case_word(ckir_op_word(i, 32), 12) + j
        to bad when (ckir_value_visible(argument, owner, block, i) == 0)
        source_type = ckir_value_type(argument)
        expected_kind = ckir_payload_word(parameter, 12)
        to case_constructor_structural when (ckir_type_byte(expected_kind, 4) > 3)
        to bad when (ckir_type_byte(source_type, 4) != ckir_type_byte(expected_kind, 4))
        to bad when (ckir_type_word(source_type, 16) < ckir_type_word(expected_kind, 16))
        to bad when (ckir_type_word(source_type, 20) > ckir_type_word(expected_kind, 20))
        to case_constructor_next
    }
    state case_constructor_structural { to bad when (source_type != expected_kind)  to case_constructor_next }
    state case_constructor_next { j = j + 1  to case_constructor_fields }
    state call_receiver_ready {
        j = 0
        to call_arguments
    }
    state call_arguments { to call_argument when (j < ckir_machine_word(callee, 20)) to call_result }
    state call_argument {
        argument = ckir_operand(operand_start + 1 + j)
        parameter = ckir_machine_word(callee, 16) + j
        to bad when (ckir_value_visible(argument, owner, block, i) == 0)
        to bad when (ckir_value_type(argument) != ckir_mparam_word(parameter, 12))
        j = j + 1
        to call_arguments
    }
    state call_result {
        to call_unit_result when (ckir_machine_word(callee, 12) == 4294967295)
        to bad when (result_type != ckir_machine_word(callee, 12))
        to bad when (ckir_type_byte(result_type, 4) > 3)
        ckir_record_call_edge(owner, callee)
        to op_next
    }
    state call_unit_result {
        ; Result shape was already checked from the callee signature.
        ckir_record_call_edge(owner, callee)
        to op_next
    }
    state op_next { next_operand = next_operand + operand_count  i = i + 1  to loop }
    state finish {
        word[525224] = next_operand
        to bad when (word[525208] != ckir_count(12))
        to bad when (word[525216] != ckir_count(13))
        to logical_not_required when (ckir_schema() == 6)
        to logical_binary_required when (ckir_schema() == 7)
        return 0
    }
    state logical_not_required { to bad when (logical_not_count == 0)  return 0 }
    state logical_binary_required { to bad when (logical_binary_count == 0)  return 0 }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir_validate_edge(block, target, start, count) {
    let i = 0
    let argument = 0
    let parameter = 0
    let atype = 0
    let ptype = 0
    let producer = 0
    let owner = ckir_block_word(block, 4)
    let block_end = ckir_block_word(block, 20) + ckir_block_word(block, 24)
    state absent {
        to present when (target != 4294967295)
        to bad when (count != 0)
        return 0
    }
    state present {
        to bad when (target >= ckir_count(5))
        to bad when (ckir_block_word(target, 4) != owner)
        to bad when (target == ckir_machine_word(owner, 32))
        to bad when (count != ckir_block_word(target, 16))
        to bad when (ckir_span_ok(start, count, ckir_count(10)) == 0)
        to loop
    }
    state loop { to one when (i < count)  return 0 }
    state one {
        argument = ckir_operand(start + i)
        parameter = ckir_block_word(target, 12) + i
        to bad when (ckir_value_visible(argument, owner, block, block_end) == 0)
        atype = ckir_value_type(argument)
        ptype = ckir_bparam_word(parameter, 12)
        to structural when (ckir_type_byte(ptype, 4) > 3)
        to bad when (ckir_carrier_same(atype, ptype) == 0)
        to next
    }
    state structural { to bad when (atype != ptype)  to direct_constructor }
    state direct_constructor {
        producer = ckir_value_operation(argument)
        to next when (producer == 4294967295)
        to bad when (ckir_op_byte(producer, 12) == 13)
        to bad when (ckir_op_byte(producer, 12) == 14)
        to next
    }
    state next { i = i + 1  to loop }
    state bad { return 251 }
}

proc ckir_zero_establishes(type_id) {
    let kind = ckir_type_byte(type_id, 4)
    let record = 0
    let field = 0
    let end = 0
    state scalar {
        to compound when (kind > 3)
        to no when (ckir_type_word(type_id, 16) > 0)
        return 1
    }
    state compound {
        to array when (kind == 5)
        record = ckir_type_word(type_id, 8)
        field = ckir_record_word(record, 8)
        end = field + ckir_record_word(record, 12)
        to fields
    }
    state array { return ckir_zero_establishes(ckir_type_word(type_id, 8)) }
    state fields { to field_one when (field < end)  return 1 }
    state field_one { to no when (ckir_zero_establishes(ckir_field_word(field, 12)) == 0)  field = field + 1  to fields }
    state no { return 0 }
}

proc ckir_validate_case_edge(block, arm, case_id) {
    let i = 0 let argument = 0 let parameter = 0 let type_id = 0 let expected = 0
    let kind = 0 let ref = 0 let producer = 0
    let target = ckir_arm_word(arm, 12)
    let start = ckir_arm_word(arm, 16)
    let count = ckir_arm_word(arm, 20)
    let owner = ckir_block_word(block, 4)
    let block_end = ckir_block_word(block, 20) + ckir_block_word(block, 24)
    state begin {
        to bad when (target >= ckir_count(5))
        to bad when (ckir_block_word(target, 4) != owner)
        to bad when (target == ckir_machine_word(owner, 32))
        to bad when (count != ckir_block_word(target, 16))
        to bad when (ckir_span_ok(start, count, ckir_arm_arg_count()) == 0)
        to args
    }
    state args { to arg when (i < count) return 0 }
    state arg {
        argument = start + i
        to bad when (ckir_arm_arg_word(argument, 0) != argument)
        kind = ckir_arm_arg_byte(argument, 4)
        to bad when (ckir_arm_arg_byte(argument, 5) != 0)
        to bad when (ckir_arm_arg_byte(argument, 6) != 0)
        to bad when (ckir_arm_arg_byte(argument, 7) != 0)
        ref = ckir_arm_arg_word(argument, 8)
        parameter = ckir_block_word(target, 12) + i
        expected = ckir_bparam_word(parameter, 12)
        to ordinary when (kind == 1)
        to payload when (kind == 2)
        to bad
    }
    state ordinary {
        to bad when (ckir_value_visible(ref, owner, block, block_end) == 0)
        type_id = ckir_value_type(ref)
        to structural when (ckir_type_byte(expected, 4) > 3)
        to bad when (ckir_carrier_same(type_id, expected) == 0)
        to next
    }
    state structural {
        to bad when (type_id != expected)
        producer = ckir_value_operation(ref)
        to next when (producer == 4294967295)
        to bad when (ckir_op_byte(producer, 12) == 13)
        to bad when (ckir_op_byte(producer, 12) == 14)
        to next
    }
    state payload {
        to bad when (ref < ckir_case_word(case_id, 12))
        to bad when (ref >= ckir_case_word(case_id, 12) + ckir_case_word(case_id, 16))
        type_id = ckir_payload_word(ref, 12)
        to payload_structural when (ckir_type_byte(expected, 4) > 3)
        to bad when (ckir_carrier_same(type_id, expected) == 0)
        to next
    }
    state payload_structural { to bad when (type_id != expected)  to next }
    state next { i = i + 1  to args }
    state bad { return 251 }
}

proc ckir_validate_terminators_root() {
    let i = 0 let j = 0 let owner = 0 let block = 0 let kind = 0 let flags = 0
    let value = 0 let target0 = 0 let start0 = 0 let count0 = 0
    let target1 = 0 let start1 = 0 let count1 = 0 let block_end = 0
    let result_type = 0 let subject_type = 0 let sum_id = 0 let case_id = 0
    let next_operand = word[525224] let next_arm = 0 let next_arg = 0
    let arm_start = 0 let arm_count = 0 let entry = ckir_entry()
    state relation { to bad when (ckir_count(11) != ckir_count(5))  to terms }
    state terms { to term_one when (i < ckir_count(11))  to operands_done }
    state term_one {
        to bad when (ckir_term_word(i, 0) != i)
        owner = ckir_term_word(i, 4) block = ckir_term_word(i, 8)
        kind = ckir_term_byte(i, 12) flags = ckir_term_byte(i, 13)
        value = ckir_term_word(i, 16) target0 = ckir_term_word(i, 20)
        start0 = ckir_term_word(i, 24) count0 = ckir_term_word(i, 28)
        target1 = ckir_term_word(i, 32) start1 = ckir_term_word(i, 36)
        count1 = ckir_term_word(i, 40) arm_start = ckir_term_word(i, 44)
        arm_count = ckir_term_word(i, 48)
        to bad when (block != i) to bad when (block >= ckir_count(5))
        to bad when (owner != ckir_block_word(block, 4))
        to bad when (ckir_u16(ckir_base(11) + i * 52 + 14) != 0)
        to bad when (kind < 1) to bad when (kind > 5)
        to bad when (start0 != next_operand) next_operand = next_operand + count0
        to bad when (start1 != next_operand) next_operand = next_operand + count1
        to bad when (arm_start != next_arm)
        block_end = ckir_block_word(block, 20) + ckir_block_word(block, 24)
        result_type = ckir_machine_word(owner, 12)
        to case_dispatch when (kind == 5)
        to bad when (flags != 0) to bad when (arm_count != 0)
        to bad when (ckir_validate_edge(block, target0, start0, count0) != 0)
        to bad when (ckir_validate_edge(block, target1, start1, count1) != 0)
        to jump when (kind == 1) to branch when (kind == 2)
        to unit when (kind == 3) to value_return
    }
    state jump { to bad when (value != 4294967295) to bad when (target0 == 4294967295) to bad when (target1 != 4294967295) to term_next }
    state branch { to bad when (target0 == 4294967295) to bad when (target1 == 4294967295) to bad when (ckir_value_visible(value,owner,block,block_end)==0) to bad when (ckir_type_byte(ckir_value_type(value),4)!=3) to term_next }
    state unit { to bad when (value != 4294967295) to bad when (target0 != 4294967295) to bad when (target1 != 4294967295) to bad when (result_type != 4294967295) to term_next }
    state value_return { to bad when (target0 != 4294967295) to bad when (target1 != 4294967295) to bad when (result_type == 4294967295) to bad when (ckir_value_visible(value,owner,block,block_end)==0) to bad when (ckir_carrier_same(ckir_value_type(value),result_type)==0) to term_next }
    state case_dispatch {
        to bad when (flags < 1) to bad when (flags > 2)
        to bad when (target0 != 4294967295) to bad when (target1 != 4294967295)
        to bad when (count0 != 0) to bad when (count1 != 0)
        to case_value when (flags == 1) to case_place
    }
    state case_value { to bad when (ckir_value_visible(value,owner,block,block_end)==0) subject_type=ckir_value_type(value) to case_subject }
    state case_place { to bad when (ckir_place_visible(value,block,block_end)==0) subject_type=ckir_place_type(value) to case_subject }
    state case_subject {
        to bad when (ckir_type_byte(subject_type,4) != 6)
        sum_id = ckir_type_word(subject_type,8)
        to bad when (arm_count != ckir_sum_word(sum_id,12))
        to exhausted when (arm_count > 64)
        to bad when (ckir_span_ok(arm_start,arm_count,ckir_arm_count())==0)
        j=0 to arms
    }
    state arms { to arm when (j<arm_count) next_arm=next_arm+arm_count to term_next }
    state arm {
        case_id=ckir_sum_word(sum_id,8)+j
        to bad when (ckir_arm_word(arm_start+j,0)!=arm_start+j)
        to bad when (ckir_arm_word(arm_start+j,4)!=i)
        to bad when (ckir_arm_word(arm_start+j,8)!=case_id)
        to bad when (ckir_arm_word(arm_start+j,16)!=next_arg)
        to bad when (ckir_validate_case_edge(block,arm_start+j,case_id)!=0)
        next_arg=next_arg+ckir_arm_word(arm_start+j,20)
        j=j+1 to arms
    }
    state term_next { i=i+1 to terms }
    state operands_done {
        to bad when (next_operand != ckir_count(10))
        to bad when (next_arm != ckir_arm_count())
        to bad when (next_arg != ckir_arm_arg_count())
        to bad when (ckir_validate_call_graph()!=0)
        to absent when (entry==4294967295) to entry_bounds
    }
    state absent { to flags_done }
    state entry_bounds { to bad when (entry>=ckir_count(3)) to entry_checks }
    state entry_checks {
        to bad when (ckir_machine_word(entry,20)!=0)
        result_type=ckir_machine_word(entry,12)
        to bad when (result_type==4294967295) to bad when (ckir_type_byte(result_type,4)>3)
        result_type=ckir_record_word(ckir_machine_word(entry,4),4)
        to exhausted when (word[6000000+result_type*8]>131072)
        to bad when (ckir_zero_establishes(result_type)==0) to flags_done
    }
    state flags_done { to entry_flag when (entry!=4294967295) to bad when (word[524304]!=0) return 0 }
    state entry_flag { to bad when (word[524304]!=1) return 0 }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc ckir5_preserve_tables() {
    let i=0
    state counts { to count when(i<14) i=0 to bases }
    state count { word[60900100+i*8]=word[525016+i*8] i=i+1 to counts }
    state bases { to base when(i<12) to done }
    state base { word[60900300+i*8]=word[525400+i*8] i=i+1 to bases }
    state done { word[60900400]=word[525000] word[60900000]=1 return 0 }
}

proc ckir5_refinement_structure_check() {
    let status = ckir_decode_header()
    state header { to done when (status != 0)  to types }
    state types { status = ckir_validate_types_records()  to done when (status != 0)  to structure }
    state structure { status = ckir_validate_machines_blocks()  to done when (status != 0)  to constants }
    state constants { status = ckir_validate_constants()  to done when (status != 0)  to operations }
    state operations { status = ckir_validate_operations()  to done when (status != 0)  to reachability }
    state reachability { status = ckir_validate_constant_reachability() to done when (status != 0) to image }
    state image { status = ckir_build_constant_image() to done when (status != 0) to terminators }
    state terminators { status = ckir_validate_terminators_root() to done when(status!=0) ckir5_preserve_tables() to done }
    state done { return status }
}

proc main() {
    let status = omgrfn5_component_read()
    state envelope { to done when (status != 0)  status = ckir5_refinement_structure_check() to done }
    state done { return status }
}
