; Shared OMGRFN5/OMGRFN6 responsibility 4: independent source-body lowering
; and source meaning.
;
; This fragment is composed with the frozen source/witness model.  It reparses
; runtime named-record literals from exact source, binds authored names, saves
; leaf spans, and replays them in declaration order.  The first pass owns
; complete semantic validity; only after it succeeds is the four-field resource
; tooth selected.  CKIR and ELF are not consulted by the source evaluator.
;
; Private scratch:
;   word[20200000 + depth*512 + ordinal*8] field starts
;   word[20210000 + depth*512 + ordinal*8] field ends
;   word[20220000 + depth*512 + ordinal*8] field seen
;   word[20300000 + value*8] constructor-result provenance
;   word[43500000 + value*8] source-evaluator object offset
;   word[20500032] direct field-receiver call count

; Responsibility-local component adapters.  The shared R5 envelope exposes
; raw framed bytes and validated extents but intentionally does not assign
; OMGCOMP/OMGRSW1/OMGRSW2 ownership.
proc omgrfn5_component_omgcomp_byte(index) { return byte[1048576+40+index] }
proc omgrfn5_component_witness_byte(index) { return byte[1048576+40+omgrfn5_component_u32(16)+index] }

proc v5_token_equal_named(named_start,named_count) {
    state length { to no when (word[524416]!=256) to no when (word[524432]!=named_count) }
    return src_spans_equal(named_start,word[524424],named_count)
    state no { return 0 }
}

proc v5_ckir_header_check() {
    let n=word[524336] let i=0 let cursor=80 let count=0 let ceiling=0 let size=0
    state length { to bad when (n<80) to magic0 }
    state magic0 { to bad when (refinement_ckir_byte(0)!='O') to magic1 }
    state magic1 { to bad when (refinement_ckir_byte(1)!='M') to magic2 }
    state magic2 { to bad when (refinement_ckir_byte(2)!='G') to magic3 }
    state magic3 { to bad when (refinement_ckir_byte(3)!='C') to magic4 }
    state magic4 { to bad when (refinement_ckir_byte(4)!='K') to magic5 }
    state magic5 { to bad when (refinement_ckir_byte(5)!='I') to magic6 }
    state magic6 { to bad when (refinement_ckir_byte(6)!='R') to magic7 }
    state magic7 { to bad when (refinement_ckir_byte(7)!=0) to fixed }
    state fixed {
        to bad when (refinement_ckir_byte(8)!=4) to bad when (refinement_ckir_byte(9)!=0)
        to bad when (refinement_ckir_byte(10)!=0) to bad when (refinement_ckir_byte(11)!=0)
        to bad when (refinement_ckir_byte(12)!=1) to bad when (refinement_ckir_byte(13)!=0)
        to bad when (refinement_ckir_byte(14)>1) to bad when (refinement_ckir_byte(15)!=0)
        word[525000]=ckir_u32(16) to counts
    }
    state counts { to one when (i<14) to exact }
    state one {
        to bad when (refinement_ckir_byte(27+i*4)!=0)
        count=ckir_u32(24+i*4) word[525016+i*8]=count
        to constants when (i==12) to children when (i==13)
        to type when (i==0) to record when (i==1) to field when (i==2)
        to machine when (i==3) to mparam when (i==4) to block when (i==5)
        to bparam when (i==6) to operation when (i==7) to operand when (i==8)
        to terminator when (i==9) to value when (i==10) to place
    }
    state type { ceiling=8192 size=24 to bounded }
    state record { ceiling=128 size=20 to bounded }
    state field { ceiling=8192 size=16 to bounded }
    state machine { ceiling=128 size=36 to bounded }
    state mparam { ceiling=896 size=20 to bounded }
    state block { ceiling=2048 size=32 to bounded }
    state bparam { ceiling=4096 size=20 to bounded }
    state operation { ceiling=32768 size=40 to save }
    state operand { ceiling=94208 size=4 to save }
    state terminator { ceiling=2048 size=44 to save }
    state value { ceiling=36864 size=0 to derived }
    state place { ceiling=32768 size=0 to derived }
    state constants { word[526000]=cursor ceiling=8192 size=24 to bounded }
    state children { word[526008]=cursor ceiling=16384 size=4 to bounded }
    state bounded { to exhausted when (count>ceiling) word[525112+i*8]=cursor cursor=cursor+count*size i=i+1 to counts }
    state save { to exhausted when (count>ceiling) word[525240+i*8]=count word[525248+i*8]=size i=i+1 to counts }
    state derived { to exhausted when (count>ceiling) i=i+1 to counts }
    state exact {
        word[525112+7*8]=cursor cursor=cursor+word[525240+7*8]*40
        word[525112+8*8]=cursor cursor=cursor+word[525240+8*8]*4
        word[525112+9*8]=cursor cursor=cursor+word[525240+9*8]*44
        to bad when (ckir_u32(20)!=n) to bad when (cursor!=n)
        to exhausted when (word[525016+4*8]+word[525016+6*8]>4096) return 0
    }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
}

proc v5_ckir_size(table) {
    state choose { to type when (table==0) to record when (table==1) to field when (table==2) to machine when (table==3) to mparam when (table==4) to block when (table==5) to bparam when (table==6) to operation when (table==7) to operand when (table==8) to term when (table==9) to constant when (table==12) return 4 }
    state type { return 24 } state record { return 20 } state field { return 16 }
    state machine { return 36 } state mparam { return 20 } state block { return 32 }
    state bparam { return 20 } state operation { return 40 } state operand { return 4 }
    state term { return 44 } state constant { return 24 }
}

proc v5_ckir_ceiling(table) {
    state choose { to type when (table==0) to record when (table==1) to field when (table==2) to machine when (table==3) to mparam when (table==4) to block when (table==5) to bparam when (table==6) to operation when (table==7) to operand when (table==8) to term when (table==9) to value when (table==10) to place when (table==11) to constant when (table==12) return 16384 }
    state type { return 8192 } state record { return 128 } state field { return 8192 }
    state machine { return 128 } state mparam { return 896 } state block { return 2048 }
    state bparam { return 4096 } state operation { return 32768 } state operand { return 94208 }
    state term { return 2048 } state value { return 36864 } state place { return 32768 }
    state constant { return 8192 }
}

proc v5_ckir_header_check_compact() {
    let n=word[524336] let i=0 let cursor=80 let count=0 let table=0
    state prelude { to bad when (n<80) to bad when (refinement_ckir_byte(0)!='O') to bad when (refinement_ckir_byte(1)!='M') to bad when (refinement_ckir_byte(2)!='G') to bad when (refinement_ckir_byte(3)!='C') to bad when (refinement_ckir_byte(4)!='K') to bad when (refinement_ckir_byte(5)!='I') to bad when (refinement_ckir_byte(6)!='R') to bad when (refinement_ckir_byte(7)!=0) to bad when (refinement_ckir_byte(8)!=4) to bad when (refinement_ckir_byte(9)!=0) to bad when (refinement_ckir_byte(10)!=0) to bad when (refinement_ckir_byte(11)!=0) to bad when (refinement_ckir_byte(12)!=1) to bad when (refinement_ckir_byte(13)!=0) to bad when (refinement_ckir_byte(14)>1) to bad when (refinement_ckir_byte(15)!=0) word[525000]=ckir_u32(16) to counts }
    state counts { to one when (i<14) table=0 to prefix }
    state one { to bad when (refinement_ckir_byte(27+i*4)!=0) count=ckir_u32(24+i*4) to exhausted when (count>v5_ckir_ceiling(i)) word[525016+i*8]=count i=i+1 to counts }
    state prefix { to prefix_one when (table<7) table=12 to constants }
    state prefix_one { word[525112+table*8]=cursor cursor=cursor+word[525016+table*8]*v5_ckir_size(table) table=table+1 to prefix }
    state constants { word[526000]=cursor cursor=cursor+word[525016+12*8]*24 word[526008]=cursor cursor=cursor+word[525016+13*8]*4 table=7 to suffix }
    state suffix { to suffix_one when (table<10) to exact }
    state suffix_one { word[525112+table*8]=cursor cursor=cursor+word[525016+table*8]*v5_ckir_size(table) table=table+1 to suffix }
    state exact { to bad when (ckir_u32(20)!=n) to bad when (cursor!=n) to exhausted when (word[525016+4*8]+word[525016+6*8]>4096) return 0 }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
}

; Responsibility 3 owns CKIR intrinsic/header canonicity.  R4 repeats only the
; local extent preflight needed to make its body-table reads total; composition
; requires both conclusions over the same immutable frame.
proc v5_ckir_body_extents() {
    let i=0 let cursor=80
    state counts { to one when (i<14) to caps }
    state one { word[525016+i*8]=ckir_u32(24+i*4) i=i+1 to counts }
    state caps {
        to exhausted when (word[525016]>8192) to exhausted when (word[525024]>128)
        to exhausted when (word[525032]>8192) to exhausted when (word[525040]>128)
        to exhausted when (word[525048]>896) to exhausted when (word[525056]>2048)
        to caps1
    }
    state caps1 {
        to exhausted when (word[525064]>4096) to exhausted when (word[525072]>32768)
        to exhausted when (word[525080]>94208) to exhausted when (word[525088]>2048)
        to exhausted when (word[525096]>36864) to exhausted when (word[525104]>32768)
        to caps2
    }
    state caps2 {
        to exhausted when (word[525112]>8192) to exhausted when (word[525120]>16384)
        to exhausted when (word[525048]+word[525064]>4096)
        word[525200]=word[525112] word[525208]=word[525120] to bases
    }
    state bases {
        word[525112]=cursor cursor=cursor+word[525016]*24
        word[525120]=cursor cursor=cursor+word[525024]*20
        word[525128]=cursor cursor=cursor+word[525032]*16
        word[525136]=cursor cursor=cursor+word[525040]*36
        to bases1
    }
    state bases1 {
        word[525144]=cursor cursor=cursor+word[525048]*20
        word[525152]=cursor cursor=cursor+word[525056]*32
        word[525160]=cursor cursor=cursor+word[525064]*20
        word[526000]=cursor cursor=cursor+word[525200]*24
        to bases2
    }
    state bases2 {
        word[526008]=cursor cursor=cursor+word[525208]*4
        word[525168]=cursor cursor=cursor+word[525072]*40
        word[525176]=cursor cursor=cursor+word[525080]*4
        word[525184]=cursor cursor=cursor+word[525088]*44
        to bad when (cursor>word[524336]) return 0
    }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
}

; The lowering conjunct consumes the already-local-preflighted premise from the
; sibling R4 extent executable and derives only the table bases it uses.
proc v5_ckir_body_bases() {
    let i=0 let cursor=80
    state counts { to one when (i<14) to save }
    state one { word[525016+i*8]=ckir_u32(24+i*4) i=i+1 to counts }
    state save { word[525200]=word[525112] word[525208]=word[525120] to bases }
    state bases { word[525112]=cursor cursor=cursor+word[525016]*24 word[525120]=cursor cursor=cursor+word[525024]*20 word[525128]=cursor cursor=cursor+word[525032]*16 word[525136]=cursor cursor=cursor+word[525040]*36 to bases1 }
    state bases1 { word[525144]=cursor cursor=cursor+word[525048]*20 word[525152]=cursor cursor=cursor+word[525056]*32 word[525160]=cursor cursor=cursor+word[525064]*20 word[526000]=cursor cursor=cursor+word[525200]*24 to bases2 }
    state bases2 { word[526008]=cursor cursor=cursor+word[525208]*4 word[525168]=cursor cursor=cursor+word[525072]*40 word[525176]=cursor cursor=cursor+word[525080]*4 word[525184]=cursor return 0 }
}

proc omgrfn5_r4_extent_check() {
    let status=omgrfn5_component_read()
    state frame { to done when (status!=0) status=v5_ckir_body_extents() to done }
    state done { return status }
}

; Operand words 2 and 3 use the inherited call staging area.  This preserves
; the frozen operation representation while admitting constructor arity four.
proc src_low_emit(opcode,result_kind,result_type,operand_count) {
    let op=src_low_g(0) let operands=src_low_g(1) let result=4294967295
    let i=0 let value=0
    state capacity { to exhausted when (op>=32768) to operand_capacity }
    state operand_capacity { to exhausted when (operand_count>94208-operands) to result }
    state result { to no_result when (result_kind==0) to value_result when (result_kind==1) to place_result }
    state value_result { to exhausted when (src_low_g(2)>=36864) result=src_low_g(2) word[18900000+result*8]=result_type src_low_gset(2,result+1) src_low_gset(27,result) src_low_gset(28,4294967295) to store }
    state place_result { to exhausted when (src_low_g(3)>=32768) result=src_low_g(3) word[19300000+result*8]=result_type src_low_gset(3,result+1) src_low_gset(27,4294967295) src_low_gset(28,result) to store }
    state no_result { result=4294967295 result_type=4294967295 src_low_gset(27,4294967295) src_low_gset(28,4294967295) to store }
    state store {
        src_low_op_set(op,0,src_low_g(4)) src_low_op_set(op,1,src_low_g(6))
        src_low_op_set(op,2,opcode) src_low_op_set(op,3,result_kind)
        src_low_op_set(op,4,result) src_low_op_set(op,5,result_type)
        src_low_op_set(op,6,operands) src_low_op_set(op,7,operand_count)
        src_low_op_set(op,8,src_low_g(52)) i=0 to operand_loop
    }
    state operand_loop { to operand_one when (i<operand_count) to finish }
    state operand_one { to first when (i==0) to second when (i==1) value=word[20100000+(i-2)*8] to operand_store }
    state first { value=src_low_g(50) to operand_store }
    state second { value=src_low_g(51) to operand_store }
    state operand_store { src_low_operand_set(operands+i,value) i=i+1 to operand_loop }
    state finish { src_low_gset(0,op+1) src_low_gset(1,operands+operand_count) src_low_block_set(src_low_g(6),1,src_low_block(src_low_g(6),1)+1) return 0 }
    state exhausted { return src_exhaust() }
}

; Parse a self-only named-field place.  Indexing, calls, arithmetic, casts, and
; every other potentially trapping/effectful suffix remain outside this path.
proc v5_scalar_self_path(expected,mode) {
    let base_type=0 let base_place=0 let field=0
    state choose { to validate when (mode==0) to self_primary }
    state validate { base_type=src_machine(src_low_g(4),9) src_next() to validate_suffix }
    state validate_suffix { to validate_done when (word[524416]!=46) src_next() to validate_name }
    state validate_name { to bad when (word[524416]!=256) to bad when (base_type>=word[10000048]) to bad when (src_type(base_type,0)!=4) field=src_low_find_field(src_type(base_type,3),word[524424],word[524432]) to bad when (field==4294967295) base_type=src_field(field,3) src_next() to validate_suffix }
    state validate_done { to bad when (src_type(base_type,0)>3) to bad when (src_low_scalar_assignable(expected,base_type)==0) return 0 }
    state self_primary { to done when (src_low_primary()!=0) to suffix }
    state suffix { to materialize when (word[524416]!=46) base_type=src_low_g(20) base_place=src_low_g(28) src_next() to name }
    state name { to bad when (word[524416]!=256) to bad when (base_type>=word[10000048]) to bad when (src_type(base_type,0)!=4) field=src_low_find_field(src_type(base_type,3),word[524424],word[524432]) to bad when (field==4294967295) to bad when (base_place==4294967295) src_low_gset(20,src_field(field,3)) src_low_gset(21,src_type(src_field(field,3),7)) src_low_gset(22,src_type(src_field(field,3),8)) src_low_gset(23,1) src_low_gset(24,0) src_low_gset(25,1) src_low_gset(26,field) src_low_gset(50,base_place) src_low_gset(51,0) src_low_gset(52,field) to done when (src_low_emit(3,2,src_type(src_field(field,3),9),1)!=0) src_next() to suffix }
    state materialize { to bad when (src_type(src_low_g(20),0)>3) to bad when (src_low_scalar_assignable(expected,src_low_g(20))==0) return src_low_materialize(src_type(expected,9)) }
    state bad { return src_reject() }
    state done { return word[10000000] }
}

proc v5_runtime_name(expected) {
    state typed { to no when (expected>=word[10000048]) to no when (src_type(expected,0)!=4) to no when (word[524416]!=256) }
    return v5_token_equal_named(src_record(src_type(expected,3),0),src_record(src_type(expected,3),1))
    state no { return 0 }
}

; Returns all-constant/contains-array in globals 62/63.  Mode zero validates
; authored syntax; mode one emits a declaration-order field value.
proc v5_parse_field(expected,mode) {
    state kind { to scalar when (src_type(expected,0)<4) to structural }
    state scalar { to literal when (word[524416]==257) to boolean when (word[524416]==256) to bad }
    state literal { src_low_primary() to bad when (src_low_scalar_assignable(expected,src_low_g(20))==0) src_low_gset(62,1) src_low_gset(63,0) to done when (mode==0) to done when (src_low_materialize(src_type(expected,9))!=0) return 0 }
    state boolean { to true_value when (src_token_word(37,4)==1) to false_value when (src_token_word(41,5)==1) to self_value when (src_token_word(18,4)==1) to parameter }
    state true_value { src_low_primary() to bad when (src_low_scalar_assignable(expected,src_low_g(20))==0) src_low_gset(62,1) src_low_gset(63,0) to done when (mode==0) to done when (src_low_materialize(src_type(expected,9))!=0) return 0 }
    state false_value { to true_value }
    state self_value { to self_parse }
    state self_parse { to done when (v5_scalar_self_path(expected,mode)!=0) src_low_gset(62,0) src_low_gset(63,0) return 0 }
    state parameter { to done when (src_low_primary()!=0) to bad when (src_low_g(25)!=2) to bad when (src_type(src_low_g(20),0)>3) to bad when (src_low_scalar_assignable(expected,src_low_g(20))==0) to done when (mode==0) to done when (src_low_materialize(src_type(expected,9))!=0) src_low_gset(62,0) src_low_gset(63,0) return 0 }
    state structural { to nested when (v5_runtime_name(expected)==1) to array when (src_type(expected,0)==5) to structural_parameter }
    state nested { to done when (v5_parse_record(expected,mode)!=0) return 0 }
    state array { to bad when (word[524416]!=91) to bad when (mode!=0) to done when (v4_skip_constant(expected)!=0) src_low_gset(62,1) src_low_gset(63,1) return 0 }
    state structural_parameter { to done when (src_low_primary()!=0) to bad when (src_low_g(25)!=2) to bad when (src_low_types_same(expected,src_low_g(20))==0) to bad when (src_low_g(27)==4294967295) src_low_gset(62,0) src_low_gset(63,0) return 0 }
    state bad { return src_reject() }
    state done { return word[10000000] }
}

proc v5_parse_record(expected,mode) {
    let depth=src_low_g(61) let record=0 let count=0 let field=0 let ordinal=0
    let i=0 let all_constant=1 let any_array=0 let start=0 let end=0
    let save_op=src_low_g(0) let save_operands=src_low_g(1) let save_values=src_low_g(2)
    let save_places=src_low_g(3) let save_block_ops=src_low_block(src_low_g(6),1)
    state depth_check { to exhausted when (depth>=8) to bad when (v5_runtime_name(expected)==0) record=src_type(expected,3) to bad when (src_type_copyable(expected)==0) count=src_record(record,4) i=0 to clear }
    state clear { to clear_one when (i<count) src_next() to bad when (word[524416]!=123) src_next() to fields }
    state clear_one { word[20220000+depth*512+i*8]=0 i=i+1 to clear }
    state fields { to close when (word[524416]==125) to bad when (word[524416]!=256) field=src_low_find_field(record,word[524424],word[524432]) to bad when (field==4294967295) ordinal=field-src_record(record,3) to bad when (word[20220000+depth*512+ordinal*8]!=0) word[20220000+depth*512+ordinal*8]=1 src_next() to colon }
    state colon { to bad when (word[524416]!=58) src_next() start=word[524424] src_low_gset(61,depth+1) to parse }
    state parse { to done when (v5_parse_field(src_field(field,3),0)!=0) src_low_gset(61,depth) end=word[524424] word[20200000+depth*512+ordinal*8]=start word[20210000+depth*512+ordinal*8]=end to nonconstant when (src_low_g(62)==0) to array_mark when (src_low_g(63)==1) to separator }
    state nonconstant { all_constant=0 to array_mark when (src_low_g(63)==1) to separator }
    state array_mark { any_array=1 to separator }
    state separator { to comma when (word[524416]==44) to fields when (word[524416]==125) to bad }
    state comma { src_next() to bad when (word[524416]==125) to fields }
    state close { i=0 to coverage }
    state coverage { to missing when (i<count) src_next() to semantic_ready }
    state missing { to bad when (word[20220000+depth*512+i*8]==0) i=i+1 to coverage }
    state semantic_ready {
        src_low_gset(0,save_op) src_low_gset(1,save_operands) src_low_gset(2,save_values)
        src_low_gset(3,save_places) src_low_block_set(src_low_g(6),1,save_block_ops)
        word[20230000+depth*64]=word[10000128] word[20230008+depth*64]=word[524424]
        to exhausted when (count>4)
        to constant_return when (mode==0) to replay_guard
    }
    state constant_return { src_low_gset(62,all_constant) src_low_gset(63,any_array) src_low_gset(61,depth) return 0 }
    ; Mode one is a value context.  Even an all-literal record must be a
    ; runtime constructor there: CKIR3 constants are not source-addressable
    ; call arguments.  Mode zero above retains constant classification for an
    ; aggregate assignment destination.
    state replay_guard { to bad when (any_array==1) i=0 to replay }
    state replay { to emit when (i>=count) word[10000128]=word[20210000+depth*512+i*8] word[524408]=word[20200000+depth*512+i*8] src_next() src_low_gset(61,depth+1) to replay_one }
    state replay_one { to done when (v5_parse_field(src_field(src_record(record,3)+i,3),1)!=0) src_low_gset(61,depth) to bad when (word[524416]!=0) word[20400000+depth*32+i*8]=src_low_g(27) i=i+1 to replay }
    state emit { src_low_gset(50,0) src_low_gset(51,0) src_low_gset(52,0) to stage when (count>0) to emit_op }
    state stage { src_low_gset(50,word[20400000+depth*32]) to stage1 when (count>1) to emit_op }
    state stage1 { src_low_gset(51,word[20400008+depth*32]) i=2 to stage_more }
    state stage_more { to stage_one when (i<count) to emit_op }
    state stage_one { word[20100000+(i-2)*8]=word[20400000+depth*32+i*8] i=i+1 to stage_more }
    state emit_op { to done when (src_low_emit(13,1,src_type(expected,9),count)!=0) word[20300000+src_low_g(27)*8]=1 word[10000128]=word[20230000+depth*64] word[524408]=word[20230008+depth*64] src_next() src_low_gset(20,expected) src_low_gset(62,0) src_low_gset(63,0) return 0 }
    state exhausted { return src_exhaust() }
    state bad { return src_reject() }
    state done { return word[10000000] }
}

; CKIR2 call lowering with one additional structural-argument entry: a named
; record literal is parsed against the exact parameter type before staging.
