    state scalar { to bad when (v4s_store(child,address+src_field(field,4),word[value_base+operand*8])!=0) i=i+1 to fields }
    state structural { to bad when (v4s_copy(child,address+src_field(field,4),word[value_base+operand*8])!=0) i=i+1 to fields }
