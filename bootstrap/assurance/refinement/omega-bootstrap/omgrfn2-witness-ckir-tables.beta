; OMGRFN2 layer 3: independent OMGRSW1 -> CKIR1 table/layout refinement.
;
; This persisted-Beta checker reads one exact OMGRFN2 frame.  It treats
; OMGCOMP source bytes, body operations, terminators, the claimed result, and
; ELF bytes as opaque.  It validates enough framing and every consumed extent
; locally, validates the complete OMGRSW1 declaration/type/layout/signature
; carrier, validates the CKIR1 table envelope, and compares only the type,
; record, field, machine, machine-parameter, block, block-parameter, and root
; relations owned by layer 3.  It publishes no bytes.
;
; Stable component API for later independently composed layers:
;   l3_frame_byte(i), l3_witness_byte(i), l3_ckir_byte(i)
;   word[500024/500032] OMGCOMP offset/length
;   word[500040/500048] OMGRSW1 offset/length
;   word[500056/500064] CKIR offset/length
;   word[500072/500080] ELF offset/length
;   word[500016] frame flags, word[500008] monotonic status
; Witness globals at 510000: eleven counts at stride 8, selected at 510088,
; then eleven row bases at 510096..510176.  CKIR globals at 511000: entry,
; twelve counts at 511008..511096, then ten encoded row bases at
; 511104..511176.  These globals are valid only after their header checker.
;
; Raw frame bytes occupy byte[1048576..5152895].  Private decoded tables begin
; at 6000000 and do not overlap the raw frame.

proc l3_frame_byte(index) { return byte[1048576 + index] }
proc l3_witness_byte(index) { return l3_frame_byte(word[500040] + index) }
proc l3_ckir_byte(index) { return l3_frame_byte(word[500056] + index) }

proc l3_reject() {
    state set { to done when (word[500008] != 0)  word[500008] = 251 }
    state done { return word[500008] }
}

proc l3_exhaust() {
    state set { to done when (word[500008] != 0)  word[500008] = 252 }
    state done { return word[500008] }
}

proc l3_frame_u32(at) {
    return l3_frame_byte(at)
        + l3_frame_byte(at + 1) * 256
        + l3_frame_byte(at + 2) * 65536
        + l3_frame_byte(at + 3) * 16777216
}

proc l3_read_frame() {
    let n = 0
    let overflow = 0
    let c = read_byte()
    state loop { to body when (c >= 0)  to finish }
    state body {
        to exhausted_byte when (n >= 4104320)
        byte[1048576 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state exhausted_byte { overflow = 1  c = read_byte()  to loop }
    state finish {
        word[500000] = n  word[500008] = 0
        to over when (overflow == 1)
        to size when (n >= 40)
        to bad
    }
    state size {
        to bad when (l3_frame_byte(0) != 'O')
        to magic1
    }
    state magic1 { to bad when (l3_frame_byte(1) != 'M')  to magic2 }
    state magic2 { to bad when (l3_frame_byte(2) != 'G')  to magic3 }
    state magic3 { to bad when (l3_frame_byte(3) != 'R')  to magic4 }
    state magic4 { to bad when (l3_frame_byte(4) != 'F')  to magic5 }
    state magic5 { to bad when (l3_frame_byte(5) != 'N')  to magic6 }
    state magic6 { to bad when (l3_frame_byte(6) != '2')  to magic7 }
    state magic7 { to bad when (l3_frame_byte(7) != 0)  to version_bytes }
    state version_bytes {
        to bad when (l3_frame_byte(8) != 2)
        to bad when (l3_frame_byte(9) != 0)
        to bad when (l3_frame_byte(10) != 0)
        to bad when (l3_frame_byte(11) != 0)
        to flag_bytes
    }
    state flag_bytes {
        to bad when (l3_frame_byte(13) != 0)
        to bad when (l3_frame_byte(14) != 0)
        to bad when (l3_frame_byte(15) != 0)
        word[500016] = l3_frame_byte(12)
        to bad when (word[500016] > 1)
        to length_high
    }
    state length_high {
        to bad when (l3_frame_byte(19) >= 128)
        to bad when (l3_frame_byte(23) >= 128)
        to bad when (l3_frame_byte(27) >= 128)
        to bad when (l3_frame_byte(31) >= 128)
        to lengths
    }
    state lengths {
        word[500032] = l3_frame_u32(16)
        word[500048] = l3_frame_u32(20)
        word[500064] = l3_frame_u32(24)
        word[500080] = l3_frame_u32(28)
        to bad when (word[500032] < 1)
        to bad when (word[500048] < 1)
        to bad when (word[500064] < 1)
        to comp_limit
    }
    state comp_limit { to over when (word[500032] > 267280)  to witness_limit }
    state witness_limit { to over when (word[500048] > 524288)  to ckir_limit }
    state ckir_limit { to over when (word[500064] > 2260040)  to elf_limit }
    state elf_limit { to over when (word[500080] > 1052672)  to offsets }
    state offsets {
        word[500024] = 40
        word[500040] = word[500024] + word[500032]
        word[500056] = word[500040] + word[500048]
        word[500072] = word[500056] + word[500064]
        to exact
    }
    state exact {
        to bad when (n != word[500072] + word[500080])
        to library when (word[500016] == 0)
        to entry
    }
    state library { to bad when (word[500080] != 0)  return 0 }
    state entry { to bad when (word[500080] < 1)  return 0 }
    state over { return l3_exhaust() }
    state bad { return l3_reject() }
}

; Both component decoders admit only signed-D0 u32 values and the explicitly
; permitted NO_ID word.  Header/table extents are established before use.
proc l3_w_u32(at) {
    let b3 = l3_witness_byte(at + 3)
    state signed {
        to value when (b3 < 128)
        to absent3 when (b3 == 255)
        to bad
    }
    state absent3 { to absent2 when (l3_witness_byte(at + 2) == 255)  to bad }
    state absent2 { to absent1 when (l3_witness_byte(at + 1) == 255)  to bad }
    state absent1 { to absent when (l3_witness_byte(at) == 255)  to bad }
    state absent { return 0 - 1 }
    state value {
        return l3_witness_byte(at) + l3_witness_byte(at + 1) * 256
            + l3_witness_byte(at + 2) * 65536 + b3 * 16777216
    }
    state bad { l3_reject()  return 0 - 1 }
}

proc l3_c_u32(at) {
    let b3 = l3_ckir_byte(at + 3)
    state signed {
        to value when (b3 < 128)
        to absent3 when (b3 == 255)
        to bad
    }
    state absent3 { to absent2 when (l3_ckir_byte(at + 2) == 255)  to bad }
    state absent2 { to absent1 when (l3_ckir_byte(at + 1) == 255)  to bad }
    state absent1 { to absent when (l3_ckir_byte(at) == 255)  to bad }
    state absent { return 0 - 1 }
    state value {
        return l3_ckir_byte(at) + l3_ckir_byte(at + 1) * 256
            + l3_ckir_byte(at + 2) * 65536 + b3 * 16777216
    }
    state bad { l3_reject()  return 0 - 1 }
}

proc l3_witness_header() {
    let p = 0
    state size { to magic0 when (word[500048] >= 72)  to bad }
    state magic0 { to magic1 when (l3_witness_byte(0) == 'O')  to bad }
    state magic1 { to magic2 when (l3_witness_byte(1) == 'M')  to bad }
    state magic2 { to magic3 when (l3_witness_byte(2) == 'G')  to bad }
    state magic3 { to magic4 when (l3_witness_byte(3) == 'R')  to bad }
    state magic4 { to magic5 when (l3_witness_byte(4) == 'S')  to bad }
    state magic5 { to magic6 when (l3_witness_byte(5) == 'W')  to bad }
    state magic6 { to magic7 when (l3_witness_byte(6) == '1')  to bad }
    state magic7 { to fixed when (l3_witness_byte(7) == 0)  to bad }
    state fixed {
        to bad when (l3_witness_byte(8) != 1)
        to bad when (l3_witness_byte(9) != 0)
        to bad when (l3_witness_byte(10) != 0)
        to bad when (l3_witness_byte(11) != 0)
        to bad when (l3_witness_byte(12) != 0)
        to bad when (l3_witness_byte(13) != 0)
        to bad when (l3_witness_byte(14) != 72)
        to bad when (l3_witness_byte(15) != 0)
        to length
    }
    state length { to bad when (l3_w_u32(16) != word[500048])  to counts }
    state counts {
        word[510000]=l3_w_u32(20)  word[510008]=l3_w_u32(24)
        word[510016]=l3_w_u32(28)  word[510024]=l3_w_u32(32)
        word[510032]=l3_w_u32(36)  word[510040]=l3_w_u32(40)
        word[510048]=l3_w_u32(44)  word[510056]=l3_w_u32(48)
        word[510064]=l3_w_u32(52)  word[510072]=l3_w_u32(56)
        word[510080]=l3_w_u32(60)  word[510088]=l3_w_u32(64)
        to bad when (l3_w_u32(68) != 0)
        to done when (word[500008] != 0)
        to ceilings0
    }
    state ceilings0 { to bad when (word[510000] < 0)  to over when (word[510000] > 16)  to ceilings1 }
    state ceilings1 { to bad when (word[510008] < 0)  to over when (word[510008] > 64)  to ceilings2 }
    state ceilings2 { to bad when (word[510016] < 0)  to over when (word[510016] > 4096)  to ceilings3 }
    state ceilings3 { to bad when (word[510024] < 0)  to over when (word[510024] > 256)  to ceilings4 }
    state ceilings4 { to bad when (word[510032] < 0)  to over when (word[510032] > 2048)  to ceilings5 }
    state ceilings5 { to bad when (word[510040] < 0)  to over when (word[510040] > 128)  to ceilings6 }
    state ceilings6 { to bad when (word[510048] < 0)  to over when (word[510048] > 4096)  to ceilings7 }
    state ceilings7 { to bad when (word[510056] < 0)  to over when (word[510056] > 128)  to ceilings8 }
    state ceilings8 { to bad when (word[510064] < 0)  to over when (word[510064] > 2048)  to ceilings9 }
    state ceilings9 { to bad when (word[510072] < 0)  to over when (word[510072] > 2048)  to ceilings10 }
    state ceilings10 { to bad when (word[510080] < 0)  to over when (word[510080] > 4096)  to relation }
    state relation { to bad when (word[510024] != word[510040] + word[510056])  to offsets }
    state offsets {
        word[510096]=72
        word[510104]=word[510096]+word[510000]*36
        word[510112]=word[510104]+word[510008]*48
        word[510120]=word[510112]+word[510016]*28
        word[510128]=word[510120]+word[510024]*28
        word[510136]=word[510128]+word[510032]*24
        word[510144]=word[510136]+word[510040]*24
        word[510152]=word[510144]+word[510048]*24
        word[510160]=word[510152]+word[510056]*40
        word[510168]=word[510160]+word[510064]*24
        word[510176]=word[510168]+word[510072]*40
        p=word[510176]+word[510080]*24
        to bad when (p != word[500048])
        return 0
    }
    state over { return l3_exhaust() }
    state bad { return l3_reject() }
    state done { return word[500008] }
}

proc l3_ckir_header() {
    let end = 0
    state size { to magic0 when (word[500064] >= 72)  to bad }
    state magic0 { to magic1 when (l3_ckir_byte(0) == 'O')  to bad }
    state magic1 { to magic2 when (l3_ckir_byte(1) == 'M')  to bad }
    state magic2 { to magic3 when (l3_ckir_byte(2) == 'G')  to bad }
    state magic3 { to magic4 when (l3_ckir_byte(3) == 'C')  to bad }
    state magic4 { to magic5 when (l3_ckir_byte(4) == 'K')  to bad }
    state magic5 { to magic6 when (l3_ckir_byte(5) == 'I')  to bad }
    state magic6 { to magic7 when (l3_ckir_byte(6) == 'R')  to bad }
    state magic7 { to fixed when (l3_ckir_byte(7) == 0)  to bad }
    state fixed {
        to bad when (l3_ckir_byte(8) != 1)
        to bad when (l3_ckir_byte(9) != 0)
        to bad when (l3_ckir_byte(10) != 0)
        to bad when (l3_ckir_byte(11) != 0)
        to bad when (l3_ckir_byte(12) != 1)
        to bad when (l3_ckir_byte(13) != 0)
        to bad when (l3_ckir_byte(15) != 0)
        to bad when (l3_ckir_byte(14) > 1)
        to words
    }
    state words {
        word[511000]=l3_c_u32(16)
        to bad when (l3_c_u32(20) != word[500064])
        word[511008]=l3_c_u32(24)  word[511016]=l3_c_u32(28)
        word[511024]=l3_c_u32(32)  word[511032]=l3_c_u32(36)
        word[511040]=l3_c_u32(40)  word[511048]=l3_c_u32(44)
        word[511056]=l3_c_u32(48)  word[511064]=l3_c_u32(52)
        word[511072]=l3_c_u32(56)  word[511080]=l3_c_u32(60)
        word[511088]=l3_c_u32(64)  word[511096]=l3_c_u32(68)
        to done when (word[500008] != 0)
        to ceilings0
    }
    state ceilings0 { to bad when (word[511008] < 0)  to over when (word[511008] > 8192)  to ceilings1 }
    state ceilings1 { to bad when (word[511016] < 0)  to over when (word[511016] > 128)  to ceilings2 }
    state ceilings2 { to bad when (word[511024] < 0)  to over when (word[511024] > 8192)  to ceilings3 }
    state ceilings3 { to bad when (word[511032] < 0)  to over when (word[511032] > 128)  to ceilings4 }
    state ceilings4 { to bad when (word[511040] < 0)  to over when (word[511040] > 896)  to ceilings5 }
    state ceilings5 { to bad when (word[511048] < 0)  to over when (word[511048] > 2048)  to ceilings6 }
    state ceilings6 { to bad when (word[511056] < 0)  to over when (word[511056] > 4096)  to ceilings7 }
    state ceilings7 { to bad when (word[511064] < 0)  to over when (word[511064] > 32768)  to ceilings8 }
    state ceilings8 { to bad when (word[511072] < 0)  to over when (word[511072] > 94208)  to ceilings9 }
    state ceilings9 { to bad when (word[511080] < 0)  to over when (word[511080] > 2048)  to ceilings10 }
    state ceilings10 { to bad when (word[511088] < 0)  to over when (word[511088] > 36864)  to ceilings11 }
    state ceilings11 { to bad when (word[511096] < 0)  to over when (word[511096] > 32768)  to relations }
    state relations {
        to bad when (word[511080] != word[511048])
        to over when (word[511040] + word[511056] > 4096)
        to offsets
    }
    state offsets {
        word[511104]=72
        word[511112]=word[511104]+word[511008]*24
        word[511120]=word[511112]+word[511016]*20
        word[511128]=word[511120]+word[511024]*16
        word[511136]=word[511128]+word[511032]*36
        word[511144]=word[511136]+word[511040]*20
        word[511152]=word[511144]+word[511048]*32
        word[511160]=word[511152]+word[511056]*20
        word[511168]=word[511160]+word[511064]*40
        word[511176]=word[511168]+word[511072]*4
        end=word[511176]+word[511080]*44
        to bad when (end != word[500064])
        return 0
    }
    state over { return l3_exhaust() }
    state bad { return l3_reject() }
    state done { return word[500008] }
}

; Decoded private columns.  Accessors use large disjoint byte addresses and
; word stride, keeping every later relation independent of wire offsets.
proc l3_type(id, column) { return word[6000000 + column * 16384 + id * 8] }
proc l3_type_set(id, column, value) { word[6000000 + column * 16384 + id * 8]=value  return value }
proc l3_record(id, column) { return word[6200000 + column * 1024 + id * 8] }
proc l3_record_set(id, column, value) { word[6200000 + column * 1024 + id * 8]=value  return value }
proc l3_field(id, column) { return word[6300000 + column * 32768 + id * 8] }
proc l3_field_set(id, column, value) { word[6300000 + column * 32768 + id * 8]=value  return value }
proc l3_machine(id, column) { return word[6500000 + column * 1024 + id * 8] }
proc l3_machine_set(id, column, value) { word[6500000 + column * 1024 + id * 8]=value  return value }
proc l3_mparam(id, column) { return word[6600000 + column * 16384 + id * 8] }
proc l3_mparam_set(id, column, value) { word[6600000 + column * 16384 + id * 8]=value  return value }
proc l3_block(id, column) { return word[6800000 + column * 16384 + id * 8] }
proc l3_block_set(id, column, value) { word[6800000 + column * 16384 + id * 8]=value  return value }
proc l3_bparam(id, column) { return word[7000000 + column * 32768 + id * 8] }
proc l3_bparam_set(id, column, value) { word[7000000 + column * 32768 + id * 8]=value  return value }

proc l3_load_declarations() {
    let i=0  let records=0  let machines=0  let p=0
    state loop { to row when (i < word[510024])  to counts }
    state row {
        p=word[510120]+i*28
        to bad when (l3_w_u32(p) != i)
        word[7200000+i*8]=l3_witness_byte(p+4)
        to bad when (word[7200000+i*8] < 1)
        to bad when (word[7200000+i*8] > 2)
        to bad when (l3_witness_byte(p+5) > 1)
        to bad when (l3_witness_byte(p+6) != 0)
        to bad when (l3_witness_byte(p+7) != 0)
        to bad when (l3_w_u32(p+8) < 0)
        to bad when (l3_w_u32(p+12) < 0)
        to bad when (l3_w_u32(p+16) < 0)
        to bad when (l3_w_u32(p+20) < 1)
        to record when (word[7200000+i*8] == 1)
        to machine
    }
    state record { to bad when (l3_w_u32(word[510120]+i*28+24) != records)  records=records+1  to next }
    state machine { to bad when (l3_w_u32(word[510120]+i*28+24) != machines)  machines=machines+1  to next }
    state next { i=i+1  to loop }
    state counts {
        to bad when (records != word[510040])
        to bad when (machines != word[510056])
        return 0
    }
    state bad { return l3_reject() }
}

proc l3_type_unique(id) {
    let j=0
    state loop { to one when (j < id)  return 1 }
    state one { to next when (l3_type(j,0) != l3_type(id,0))  to flags }
    state flags { to next when (l3_type(j,1) != l3_type(id,1))  to p0 }
    state p0 { to next when (l3_type(j,2) != l3_type(id,2))  to p1 }
    state p1 { to next when (l3_type(j,3) != l3_type(id,3))  to low }
    state low { to next when (l3_type(j,4) != l3_type(id,4))  to high }
    state high { to duplicate when (l3_type(j,5) == l3_type(id,5))  to next }
    state next { j=j+1  to loop }
    state duplicate { return 0 }
}

proc l3_load_types() {
    let i=0  let p=0
    state minimum { to bad when (word[510032] < word[510040]+2)  to loop }
    state loop { to row when (i < word[510032])  to canonical_bool }
    state row {
        p=word[510128]+i*24
        to bad when (l3_w_u32(p) != i)
        l3_type_set(i,0,l3_witness_byte(p+4))
        l3_type_set(i,1,l3_witness_byte(p+5))
        to bad when (l3_witness_byte(p+6) != 0)
        to bad when (l3_witness_byte(p+7) != 0)
        l3_type_set(i,2,l3_w_u32(p+8))  l3_type_set(i,3,l3_w_u32(p+12))
        l3_type_set(i,4,l3_w_u32(p+16)) l3_type_set(i,5,l3_w_u32(p+20))
        to done when (word[500008] != 0)
        to scalar when (l3_type(i,0) == 1)
        to scalar when (l3_type(i,0) == 2)
        to bool when (l3_type(i,0) == 3)
        to nominal when (l3_type(i,0) == 4)
        to array when (l3_type(i,0) == 5)
        to bad
    }
    state scalar {
        to bad when (l3_type(i,1) > 1)
        to bad when (l3_type(i,2) != 0)
        to bad when (l3_type(i,3) != 0)
        to bad when (l3_type(i,4) < 0)
        to bad when (l3_type(i,4) > l3_type(i,5))
        to u8_bound when (l3_type(i,0) == 1)
        to unique
    }
    state u8_bound { to bad when (l3_type(i,5) > 255)  to unique }
    state bool {
        to bad when (l3_type(i,1) != 0)
        to bad when (l3_type(i,2) != 0)
        to bad when (l3_type(i,3) != 0)
        to bad when (l3_type(i,4) != 0)
        to bad when (l3_type(i,5) != 1)
        to unique
    }
    state nominal {
        to bad when (l3_type(i,1) != 0)
        to bad when (l3_type(i,2) < 0)
        to bad when (l3_type(i,2) >= word[510040])
        to bad when (l3_type(i,3) != 0)
        to bad when (l3_type(i,4) != 0)
        to bad when (l3_type(i,5) != 0)
        to bad when (i >= word[510040])
        to bad when (l3_type(i,2) != i)
        to unique
    }
    state array {
        to bad when (l3_type(i,1) > 1)
        to bad when (l3_type(i,2) < 0)
        to bad when (l3_type(i,2) >= i)
        to bad when (l3_type(i,3) < 0)
        to over when (l3_type(i,3) > 65536)
        to bad when (l3_type(i,4) != 0)
        to bad when (l3_type(i,5) != 0)
        to unique
    }
    state unique { to bad when (l3_type_unique(i) == 0)  i=i+1  to loop }
    state canonical_bool {
        i=word[510040]
        to bad when (l3_type(i,0) != 3)
        i=i+1
        to bad when (l3_type(i,0) != 2)
        to bad when (l3_type(i,1) != 0)
        to bad when (l3_type(i,4) != 0)
        to bad when (l3_type(i,5) != 2147483647)
        return 0
    }
    state over { return l3_exhaust() }
    state bad { return l3_reject() }
    state done { return word[500008] }
}

proc l3_load_records_fields() {
    let i=0  let next_field=0  let owner=0  let value=0  let p=0
    state records { to record when (i < word[510040])  to fields_begin }
    state record {
        p=word[510136]+i*24
        to bad when (l3_w_u32(p) != i)
        l3_record_set(i,0,l3_w_u32(p+4))
        to bad when (l3_record(i,0) < 0)
        to bad when (l3_record(i,0) >= word[510024])
        to bad when (word[7200000+l3_record(i,0)*8] != 1)
        to bad when (l3_w_u32(word[510120]+l3_record(i,0)*28+24) != i)
        l3_record_set(i,1,l3_w_u32(p+8))
        to bad when (l3_record(i,1) != i)
        l3_record_set(i,2,l3_w_u32(p+12))  l3_record_set(i,3,l3_w_u32(p+16))
        to bad when (l3_record(i,2) != next_field)
        to bad when (l3_record(i,3) < 0)
        to over when (l3_record(i,3) > 64)
        to bad when (l3_record(i,3) > word[510048]-next_field)
        l3_record_set(i,4,l3_witness_byte(p+20))
        to bad when (l3_record(i,4) > 1)
        to bad when (l3_witness_byte(p+21) != 0)
        to bad when (l3_witness_byte(p+22) != 0)
        to bad when (l3_witness_byte(p+23) != 0)
        next_field=next_field+l3_record(i,3)  i=i+1  to records
    }
    state fields_begin { to bad when (next_field != word[510048])  i=0  owner=0  to fields }
    state fields { to owner_seek when (i < word[510048])  return 0 }
    state owner_seek { to field when (i < l3_record(owner,2)+l3_record(owner,3))  owner=owner+1  to bad when (owner >= word[510040])  to owner_seek }
    state field {
        p=word[510144]+i*24
        value=l3_w_u32(p)
        to bad when (value != i)
        l3_field_set(i,0,l3_w_u32(p+4))  to bad when (l3_field(i,0) != owner)
        l3_field_set(i,1,l3_w_u32(p+8))  to bad when (l3_field(i,1) != i-l3_record(owner,2))
        l3_field_set(i,2,l3_w_u32(p+12))
        to bad when (l3_field(i,2) < 0)
        to bad when (l3_field(i,2) >= word[510032])
        to bad when (l3_w_u32(p+16) < 0)
        to bad when (l3_w_u32(p+20) < 1)
        i=i+1  to fields
    }
    state over { return l3_exhaust() }
    state bad { return l3_reject() }
}

proc l3_load_machines() {
    let i=0  let next_param=0  let next_block=0  let p=0
    state loop { to row when (i < word[510056])  to partitions }
    state row {
        p=word[510152]+i*40
        to bad when (l3_w_u32(p) != i)
        l3_machine_set(i,0,l3_w_u32(p+4))
        to bad when (l3_machine(i,0) < 0)
        to bad when (l3_machine(i,0) >= word[510024])
        to bad when (word[7200000+l3_machine(i,0)*8] != 2)
        to bad when (l3_w_u32(word[510120]+l3_machine(i,0)*28+24) != i)
        l3_machine_set(i,1,l3_w_u32(p+8))
        to bad when (l3_machine(i,1) < 0)
        to bad when (l3_machine(i,1) >= word[510040])
        l3_machine_set(i,2,l3_witness_byte(p+12))
        to bad when (l3_machine(i,2) < 1)
        to bad when (l3_machine(i,2) > 2)
        to bad when (l3_witness_byte(p+13) != 0)
        to bad when (l3_witness_byte(p+14) != 0)
        to bad when (l3_witness_byte(p+15) != 0)
        l3_machine_set(i,3,l3_w_u32(p+16))
        to result when (l3_machine(i,3) >= 0)
        to spans
    }
    state result { to bad when (l3_machine(i,3) >= word[510032])  to bad when (l3_type(l3_machine(i,3),0) > 3)  to spans }
    state spans {
        p=word[510152]+i*40
        l3_machine_set(i,4,l3_w_u32(p+20))  l3_machine_set(i,5,l3_w_u32(p+24))
        l3_machine_set(i,6,l3_w_u32(p+28))  l3_machine_set(i,7,l3_w_u32(p+32))
        l3_machine_set(i,8,l3_w_u32(p+36))
        to bad when (l3_machine(i,4) != next_param)
        to bad when (l3_machine(i,5) < 0)
        to bad when (l3_machine(i,5) > 7)
        to bad when (l3_machine(i,5) > word[510064]-next_param)
        to bad when (l3_machine(i,6) != next_block)
        to bad when (l3_machine(i,7) < 1)
        to over when (l3_machine(i,7) > 128)
        to bad when (l3_machine(i,7) > word[510072]-next_block)
        to bad when (l3_machine(i,8) != next_block)
        next_param=next_param+l3_machine(i,5)
        next_block=next_block+l3_machine(i,7)
        i=i+1  to loop
    }
    state partitions {
        to bad when (next_param != word[510064])
        to bad when (next_block != word[510072])
        return 0
    }
    state over { return l3_exhaust() }
    state bad { return l3_reject() }
}

proc l3_load_parameters_blocks() {
    let i=0  let owner=0  let next_param=0  let p=0
    state mparams { to mowner when (i < word[510064])  i=0  owner=0  to blocks }
    state mowner { to mparam when (i < l3_machine(owner,4)+l3_machine(owner,5))  owner=owner+1  to bad when (owner >= word[510056])  to mowner }
    state mparam {
        p=word[510160]+i*24
        to bad when (l3_w_u32(p) != i)
        l3_mparam_set(i,0,l3_w_u32(p+4))  to bad when (l3_mparam(i,0) != owner)
        l3_mparam_set(i,1,l3_w_u32(p+8))  to bad when (l3_mparam(i,1) != i-l3_machine(owner,4))
        l3_mparam_set(i,2,l3_w_u32(p+12))
        to bad when (l3_mparam(i,2) < 0)
        to bad when (l3_mparam(i,2) >= word[510032])
        to bad when (l3_w_u32(p+16) < 0)
        to bad when (l3_w_u32(p+20) < 1)
        i=i+1  to mparams
    }
    state blocks { to bowner when (i < word[510072])  i=0  owner=0  to bparams }
    state bowner { to block when (i < l3_machine(owner,6)+l3_machine(owner,7))  owner=owner+1  to bad when (owner >= word[510056])  to bowner }
    state block {
        p=word[510168]+i*40
        to bad when (l3_w_u32(p) != i)
        l3_block_set(i,0,l3_w_u32(p+4))  to bad when (l3_block(i,0) != owner)
        l3_block_set(i,1,l3_w_u32(p+8))  to bad when (l3_block(i,1) != i-l3_machine(owner,6))
        l3_block_set(i,2,l3_witness_byte(p+12))
        to bad when (l3_block(i,2) < 1)
        to bad when (l3_block(i,2) > l3_machine(owner,2))
        to bad when (l3_witness_byte(p+13) != 0)
        to bad when (l3_witness_byte(p+14) != 0)
        to bad when (l3_witness_byte(p+15) != 0)
        to bad when (l3_w_u32(p+16) < 0)
        to bad when (l3_w_u32(p+20) < l3_w_u32(p+16))
        l3_block_set(i,3,l3_w_u32(p+24))  l3_block_set(i,4,l3_w_u32(p+28))
        l3_block_set(i,5,l3_w_u32(p+32))  l3_block_set(i,6,l3_w_u32(p+36))
        to bad when (l3_block(i,5) != next_param)
        to bad when (l3_block(i,6) < 0)
        to bad when (l3_block(i,6) > 7)
        to bad when (l3_block(i,6) > word[510080]-next_param)
        to entry when (l3_block(i,1) == 0)
        to named
    }
    state entry {
        to bad when (l3_block(i,2) != l3_machine(owner,2))
        to bad when (l3_block(i,3) != 0-1)
        to bad when (l3_block(i,4) != 0)
        to bad when (l3_block(i,6) != 0)
        to block_next
    }
    state named { to bad when (l3_block(i,3) < 0)  to bad when (l3_block(i,4) < 1)  to block_next }
    state block_next { next_param=next_param+l3_block(i,6)  i=i+1  to blocks }
    state bparams { to bad when (next_param != word[510080])  to bparam when (i < word[510080])  return 0 }
    state bparam {
        p=word[510176]+i*24
        to bad when (l3_w_u32(p) != i)
        l3_bparam_set(i,0,l3_w_u32(p+4))
        to bad when (l3_bparam(i,0) < 0)
        to bad when (l3_bparam(i,0) >= word[510072])
        to bad when (l3_block(l3_bparam(i,0),1) == 0)
        to bad when (i < l3_block(l3_bparam(i,0),5))
        to bad when (i >= l3_block(l3_bparam(i,0),5)+l3_block(l3_bparam(i,0),6))
        l3_bparam_set(i,1,l3_w_u32(p+8))
        to bad when (l3_bparam(i,1) != i-l3_block(l3_bparam(i,0),5))
        l3_bparam_set(i,2,l3_w_u32(p+12))
        to bad when (l3_bparam(i,2) < 0)
        to bad when (l3_bparam(i,2) >= word[510032])
        to bad when (l3_w_u32(p+16) < 0)
        to bad when (l3_w_u32(p+20) < 1)
        i=i+1  to bparams
    }
    state bad { return l3_reject() }
}

proc l3_compare_types() {
    let i=0  let p=0
    state loop { to row when (i < word[510032])  return 0 }
    state row {
        p=word[511104]+i*24
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_ckir_byte(p+4) != l3_type(i,0))
        to bad when (l3_ckir_byte(p+5) != l3_type(i,1))
        to bad when (l3_ckir_byte(p+6) != 0)
        to bad when (l3_ckir_byte(p+7) != 0)
        to bad when (l3_c_u32(p+8) != l3_type(i,2))
        to bad when (l3_c_u32(p+12) != l3_type(i,3))
        to bad when (l3_c_u32(p+16) != l3_type(i,4))
        to bad when (l3_c_u32(p+20) != l3_type(i,5))
        i=i+1  to loop
    }
    state bad { return l3_reject() }
}

proc l3_compare_records_fields() {
    let i=0  let p=0
    state records { to record when (i < word[510040])  i=0  to fields }
    state record {
        p=word[511112]+i*20
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_c_u32(p+4) != l3_record(i,1))
        to bad when (l3_c_u32(p+8) != l3_record(i,2))
        to bad when (l3_c_u32(p+12) != l3_record(i,3))
        to bad when (l3_ckir_byte(p+16) != l3_record(i,4))
        to bad when (l3_ckir_byte(p+17) != 0)
        to bad when (l3_ckir_byte(p+18) != 0)
        to bad when (l3_ckir_byte(p+19) != 0)
        i=i+1  to records
    }
    state fields { to field when (i < word[510048])  return 0 }
    state field {
        p=word[511120]+i*16
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_c_u32(p+4) != l3_field(i,0))
        to bad when (l3_c_u32(p+8) != l3_field(i,1))
        to bad when (l3_c_u32(p+12) != l3_field(i,2))
        i=i+1  to fields
    }
    state bad { return l3_reject() }
}

proc l3_compare_machines_parameters() {
    let i=0  let p=0
    state machines { to machine when (i < word[510056])  i=0  to mparams }
    state machine {
        p=word[511128]+i*36
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_c_u32(p+4) != l3_machine(i,1))
        to bad when (l3_ckir_byte(p+8) != l3_machine(i,2))
        to bad when (l3_ckir_byte(p+9) != 0)
        to bad when (l3_ckir_byte(p+10) != 0)
        to bad when (l3_ckir_byte(p+11) != 0)
        to bad when (l3_c_u32(p+12) != l3_machine(i,3))
        to bad when (l3_c_u32(p+16) != l3_machine(i,4))
        to bad when (l3_c_u32(p+20) != l3_machine(i,5))
        to bad when (l3_c_u32(p+24) != l3_machine(i,6))
        to bad when (l3_c_u32(p+28) != l3_machine(i,7))
        to bad when (l3_c_u32(p+32) != l3_machine(i,8))
        i=i+1  to machines
    }
    state mparams { to mparam when (i < word[510064])  return 0 }
    state mparam {
        p=word[511136]+i*20
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_c_u32(p+4) != l3_mparam(i,0))
        to bad when (l3_c_u32(p+8) != l3_mparam(i,1))
        to bad when (l3_c_u32(p+12) != l3_mparam(i,2))
        to bad when (l3_c_u32(p+16) != i)
        i=i+1  to mparams
    }
    state bad { return l3_reject() }
}

proc l3_compare_blocks_parameters() {
    let i=0  let p=0
    state blocks { to block when (i < word[510072])  i=0  to bparams }
    state block {
        p=word[511144]+i*32
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_c_u32(p+4) != l3_block(i,0))
        to bad when (l3_ckir_byte(p+8) != l3_block(i,2))
        to bad when (l3_ckir_byte(p+9) != 0)
        to bad when (l3_ckir_byte(p+10) != 0)
        to bad when (l3_ckir_byte(p+11) != 0)
        to bad when (l3_c_u32(p+12) != l3_block(i,5))
        to bad when (l3_c_u32(p+16) != l3_block(i,6))
        ; p+20 operation span and p+28 terminator belong to layer 4.
        i=i+1  to blocks
    }
    state bparams { to bparam when (i < word[510080])  return 0 }
    state bparam {
        p=word[511152]+i*20
        to bad when (l3_c_u32(p) != i)
        to bad when (l3_c_u32(p+4) != l3_bparam(i,0))
        to bad when (l3_c_u32(p+8) != l3_bparam(i,1))
        to bad when (l3_c_u32(p+12) != l3_bparam(i,2))
        to bad when (l3_c_u32(p+16) != word[510064]+i)
        i=i+1  to bparams
    }
    state bad { return l3_reject() }
}

; Reconstruct the canonical interning schedule from authored type-reference
; table order.  Parsing allocates nested array elements before their outer row;
; non-arrays are interned over the complete encounter stream first, followed by
; arrays whose elements are already interned.
proc l3_mark_nonarray_tree(type_id) {
    state array { to scalar when (l3_type(type_id,0) != 5)  l3_mark_nonarray_tree(l3_type(type_id,2))  return word[500008] }
    state scalar { to done when (word[7300000+type_id*8] == 1)  to expected }
    state expected { to bad when (type_id != word[500200])  word[7300000+type_id*8]=1  word[500200]=word[500200]+1  return 0 }
    state bad { return l3_reject() }
    state done { return 0 }
}

proc l3_mark_array_tree(type_id) {
    state kind { to done when (l3_type(type_id,0) != 5)  to element }
    state element { l3_mark_array_tree(l3_type(type_id,2))  to done when (word[500008] != 0)  to seen }
    state seen { to done when (word[7300000+type_id*8] == 1)  to ready }
    state ready { to pending when (word[7300000+l3_type(type_id,2)*8] == 0)  to expected }
    state expected { to bad when (type_id != word[500200])  word[7300000+type_id*8]=1  word[500200]=word[500200]+1  word[500216]=1  return 0 }
    state pending { word[500208]=word[500208]+1  return 0 }
    state bad { return l3_reject() }
    state done { return word[500008] }
}

proc l3_visit_references(mode) {
    let i=0
    state fields { to field when (i < word[510048])  i=0  to mparams }
    state field { to nonarray_field when (mode == 0)  l3_mark_array_tree(l3_field(i,2))  to field_next }
    state nonarray_field { l3_mark_nonarray_tree(l3_field(i,2))  to field_next }
    state field_next { to done when (word[500008] != 0)  i=i+1  to fields }
    state mparams { to mparam when (i < word[510064])  i=0  to results }
    state mparam { to nonarray_mparam when (mode == 0)  l3_mark_array_tree(l3_mparam(i,2))  to mparam_next }
    state nonarray_mparam { l3_mark_nonarray_tree(l3_mparam(i,2))  to mparam_next }
    state mparam_next { to done when (word[500008] != 0)  i=i+1  to mparams }
    state results { to result when (i < word[510056])  i=0  to bparams }
    state result { to result_next when (l3_machine(i,3) < 0)  to nonarray_result when (mode == 0)  l3_mark_array_tree(l3_machine(i,3))  to result_next }
    state nonarray_result { l3_mark_nonarray_tree(l3_machine(i,3))  to result_next }
    state result_next { to done when (word[500008] != 0)  i=i+1  to results }
    state bparams { to bparam when (i < word[510080])  return 0 }
    state bparam { to nonarray_bparam when (mode == 0)  l3_mark_array_tree(l3_bparam(i,2))  to bparam_next }
    state nonarray_bparam { l3_mark_nonarray_tree(l3_bparam(i,2))  to bparam_next }
    state bparam_next { to done when (word[500008] != 0)  i=i+1  to bparams }
    state done { return word[500008] }
}

proc l3_validate_type_interning() {
    let i=0
    state seed { word[500200]=word[510040]+2  to seed_loop }
    state seed_loop { to seed_one when (i < word[500200])  to nonarrays }
    state seed_one { word[7300000+i*8]=1  i=i+1  to seed_loop }
    state nonarrays { l3_visit_references(0)  to done when (word[500008] != 0)  to arrays }
    state arrays { word[500208]=0  word[500216]=0  l3_visit_references(1)  to done when (word[500008] != 0)  to pass }
    state pass { to complete when (word[500208] == 0)  to bad when (word[500216] == 0)  to arrays }
    state complete { to bad when (word[500200] != word[510032])  return 0 }
    state bad { return l3_reject() }
    state done { return word[500008] }
}

proc l3_layout_type(type_id) {
    let count=0  let size=0  let align=1
    state kind1 { to byte_scalar when (l3_type(type_id,0) == 1)  to kind2 }
    state kind2 { to u32_scalar when (l3_type(type_id,0) == 2)  to kind3 }
    state kind3 { to byte_scalar when (l3_type(type_id,0) == 3)  to kind4 }
    state kind4 { to nominal when (l3_type(type_id,0) == 4)  to array }
    state byte_scalar { word[500224]=1  word[500232]=1  return 0 }
    state u32_scalar { word[500224]=4  word[500232]=4  return 0 }
    state nominal { l3_layout_record(l3_type(type_id,2))  return word[500008] }
    state array {
        count=l3_type(type_id,3)
        l3_layout_type(l3_type(type_id,2))
        to done when (word[500008] != 0)
        size=word[500224]  align=word[500232]
        size=size+((align-size%align)%align)
        to zero when (count == 0)
        to over when (size > 131072/count)
        word[500224]=size*count  word[500232]=align
        return 0
    }
    state zero { word[500224]=0  word[500232]=align  return 0 }
    state over { return l3_exhaust() }
    state done { return word[500008] }
}

proc l3_layout_record(record_id) {
    let i=0  let end=0  let size=0  let align=1  let field_align=1  let padding=0
    state ready { to cached when (l3_record(record_id,5) == 2)  to cycle when (l3_record(record_id,5) == 1)  l3_record_set(record_id,5,1)  i=l3_record(record_id,2)  end=i+l3_record(record_id,3)  to fields }
    state fields { to field when (i < end)  to finish_padding }
    state field { l3_layout_type(l3_field(i,2))  to done when (word[500008] != 0)  field_align=word[500232]  to maximum }
    state maximum { to padding_state when (field_align <= align)  align=field_align  to padding_state }
    state padding_state { padding=(field_align-size%field_align)%field_align  to over when (size > 131072-padding)  size=size+padding  l3_field_set(i,3,size)  to place }
    state place { to over when (word[500224] > 131072-size)  size=size+word[500224]  i=i+1  to fields }
    state finish_padding { padding=(align-size%align)%align  to over when (size > 131072-padding)  size=size+padding  l3_record_set(record_id,5,2)  l3_record_set(record_id,6,size)  l3_record_set(record_id,7,align)  to cached }
    state cached { word[500224]=l3_record(record_id,6)  word[500232]=l3_record(record_id,7)  return 0 }
    state cycle { return l3_reject() }
    state over { return l3_exhaust() }
    state done { return word[500008] }
}

proc l3_validate_layouts() {
    let i=0
    state loop { to one when (i < word[510040])  return 0 }
    state one { l3_layout_record(i)  to done when (word[500008] != 0)  i=i+1  to loop }
    state done { return word[500008] }
}

proc l3_type_copyable(type_id) {
    state nominal { to array when (l3_type(type_id,0) != 4)  return l3_record(l3_type(type_id,2),4) }
    state array { to yes when (l3_type(type_id,0) != 5)  return l3_type_copyable(l3_type(type_id,2)) }
    state yes { return 1 }
}

proc l3_validate_copyability() {
    let i=0  let j=0  let end=0
    state records { to marked when (i < word[510040])  i=0  to mparams }
    state marked { to next when (l3_record(i,4) == 0)  j=l3_record(i,2)  end=j+l3_record(i,3)  to fields }
    state fields { to field when (j < end)  to next }
    state field { to bad when (l3_type_copyable(l3_field(j,2)) == 0)  j=j+1  to fields }
    state next { i=i+1  to records }
    state mparams { to mparam when (i < word[510064])  i=0  to bparams }
    state mparam { to mparam_next when (l3_type(l3_mparam(i,2),0) <= 3)  to bad when (l3_type_copyable(l3_mparam(i,2)) == 0)  to mparam_next }
    state mparam_next { i=i+1  to mparams }
    state bparams { to bparam when (i < word[510080])  return 0 }
    state bparam { to bparam_next when (l3_type(l3_bparam(i,2),0) <= 3)  to bad when (l3_type_copyable(l3_bparam(i,2)) == 0)  to bparam_next }
    state bparam_next { i=i+1  to bparams }
    state bad { return l3_reject() }
}

proc l3_validate_root() {
    let candidates=0  let candidate=0-1  let i=0
    state counts {
        to bad when (word[511008] != word[510032])
        to bad when (word[511016] != word[510040])
        to bad when (word[511024] != word[510048])
        to bad when (word[511032] != word[510056])
        to bad when (word[511040] != word[510064])
        to bad when (word[511048] != word[510072])
        to bad when (word[511056] != word[510080])
        to candidates_loop
    }
    state candidates_loop { to candidate_params when (i < word[510056])  to flag }
    state candidate_params { to candidate_next when (l3_machine(i,5) != 0)  to candidate_result }
    state candidate_result { to candidate_next when (l3_machine(i,3) < 0)  to candidate_scalar }
    state candidate_scalar { to candidate_next when (l3_type(l3_machine(i,3),0) > 3)  candidates=candidates+1  candidate=i  to candidate_next }
    state candidate_next { i=i+1  to candidates_loop }
    state flag { to library when (word[500016] == 0)  to entry }
    state library {
        to bad when (candidates != 0)
        to bad when (word[510088] != 0-1)
        to bad when (l3_ckir_byte(14) != 0)
        to bad when (word[511000] != 0-1)
        return 0
    }
    state entry {
        to bad when (candidates != 1)
        to bad when (word[510088] != candidate)
        to bad when (l3_ckir_byte(14) != 1)
        to bad when (word[511000] != candidate)
        to bad when (l3_block(l3_machine(candidate,8),6) != 0)
        return 0
    }
    state bad { return l3_reject() }
}

proc omgrfn2_layer3_check() {
    l3_read_frame()
    state frame { to done when (word[500008] != 0)  l3_witness_header()  to witness }
    state witness { to done when (word[500008] != 0)  l3_ckir_header()  to ckir }
    state ckir { to done when (word[500008] != 0)  l3_load_declarations()  to declarations }
    state declarations { to done when (word[500008] != 0)  l3_load_types()  to types }
    state types { to done when (word[500008] != 0)  l3_load_records_fields()  to records }
    state records { to done when (word[500008] != 0)  l3_load_machines()  to machines }
    state machines { to done when (word[500008] != 0)  l3_load_parameters_blocks()  to parameters }
    state parameters { to done when (word[500008] != 0)  l3_validate_type_interning()  to interning }
    state interning { to done when (word[500008] != 0)  l3_validate_layouts()  to layouts }
    state layouts { to done when (word[500008] != 0)  l3_validate_copyability()  to copies }
    state copies { to done when (word[500008] != 0)  l3_validate_root()  to root }
    state root { to done when (word[500008] != 0)  l3_compare_types()  to types_join }
    state types_join { to done when (word[500008] != 0)  l3_compare_records_fields()  to records_join }
    state records_join { to done when (word[500008] != 0)  l3_compare_machines_parameters()  to machines_join }
    state machines_join { to done when (word[500008] != 0)  l3_compare_blocks_parameters()  to done }
    state done { return word[500008] }
}

proc main() { return omgrfn2_layer3_check() }
