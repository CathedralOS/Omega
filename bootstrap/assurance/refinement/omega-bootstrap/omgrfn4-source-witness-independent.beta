; OMGRFN4 responsibility 2: independent source -> OMGRSW1 reconstruction for
; the CKIR3 Unicode-table compilation.  CKIR3, ELF, and results remain opaque.
; The checker lexes both exact source extents, derives declarations, fields,
; signatures, state/body spans, and every self-call target, then compares the
; complete canonical OMGRSW1.  It does not execute or trust the Delta resolver.

proc omgrfn4_l2_frame_byte(index) { return byte[1048576 + index] }
proc omgrfn4_l2_omgcomp_byte(index) { return omgrfn4_l2_frame_byte(word[500024] + index) }
proc omgrfn4_l2_source_start(source_id) { return word[607040 + source_id * 8] }
proc omgrfn4_l2_source_length(source_id) { return word[607168 + source_id * 8] }
proc omgrfn4_l2_source_byte(source_id,index) { return omgrfn4_l2_omgcomp_byte(omgrfn4_l2_source_start(source_id)+index) }

proc omgrfn4_l2_reject() {
    state set { to done when (word[700000] != 0)  word[700000] = 251 }
    state done { return word[700000] }
}

proc omgrfn4_l2_exhaust() { word[700000] = 252 return 252 }

proc omgrfn4_l2_frame_u32(at) {
    return omgrfn4_l2_frame_byte(at)+omgrfn4_l2_frame_byte(at+1)*256
        +omgrfn4_l2_frame_byte(at+2)*65536+omgrfn4_l2_frame_byte(at+3)*16777216
}

proc omgrfn4_l2_read_frame() {
    let n=0 let overflow=0 let c=read_byte()
    state read { to one when (c>=0) to header }
    state one { to over when (n>=4497544) byte[1048576+n]=c n=n+1 c=read_byte() to read }
    state over { overflow=1 c=read_byte() to read }
    state header { to exhausted when (overflow==1) to bad when (n<40) to magic }
    state magic {
        to bad when (omgrfn4_l2_frame_byte(0)!='O') to bad when (omgrfn4_l2_frame_byte(1)!='M')
        to bad when (omgrfn4_l2_frame_byte(2)!='G') to bad when (omgrfn4_l2_frame_byte(3)!='R')
        to bad when (omgrfn4_l2_frame_byte(4)!='F') to bad when (omgrfn4_l2_frame_byte(5)!='N')
        to bad when (omgrfn4_l2_frame_byte(6)!='4') to bad when (omgrfn4_l2_frame_byte(7)!=0)
        to bad when (omgrfn4_l2_frame_u32(8)!=4)
        word[500016]=omgrfn4_l2_frame_u32(12) word[500032]=omgrfn4_l2_frame_u32(16)
        word[500048]=omgrfn4_l2_frame_u32(20) word[500064]=omgrfn4_l2_frame_u32(24)
        word[500080]=omgrfn4_l2_frame_u32(28) word[500088]=omgrfn4_l2_frame_u32(32)
        word[500096]=omgrfn4_l2_frame_u32(36)
        to bad when (word[500016]>1) to bad when (word[500032]<1)
        to bad when (word[500048]<1) to bad when (word[500064]<1)
        to exhausted when (word[500032]>267280) to exhausted when (word[500048]>524288)
        to exhausted when (word[500064]>2522192) to exhausted when (word[500080]>1183744)
        word[500024]=40
        to bad when (word[500032]>n-word[500024])
        word[500040]=word[500024]+word[500032]
        to bad when (word[500048]>n-word[500040])
        word[500056]=word[500040]+word[500048]
        to bad when (word[500064]>n-word[500056])
        word[500072]=word[500056]+word[500064]
        to bad when (word[500080]!=n-word[500072])
        to library when (word[500016]==0) to entry
    }
    state library { to bad when (word[500080]!=0) to bad when (word[500088]!=4294967295) to bad when (word[500096]!=4294967295) return 0 }
    state entry { to bad when (word[500080]<1) to bad when (word[500096]>255) to bad when (word[500096]!=word[500088]%256) return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn4_l2_comp_u32(at) {
    return omgrfn4_l2_omgcomp_byte(at)+omgrfn4_l2_omgcomp_byte(at+1)*256
        +omgrfn4_l2_omgcomp_byte(at+2)*65536+omgrfn4_l2_omgcomp_byte(at+3)*16777216
}

proc omgrfn4_l2_decode_compilation() {
    let n=word[500032] let at=0 let i=0 let owner=0 let bundle=0 let module=0
    let label_length=0 let content_length=0
    state size { to bad when (n<64) to magic }
    state magic {
        to bad when (omgrfn4_l2_omgcomp_byte(0)!='O') to bad when (omgrfn4_l2_omgcomp_byte(1)!='M')
        to bad when (omgrfn4_l2_omgcomp_byte(2)!='G') to bad when (omgrfn4_l2_omgcomp_byte(3)!='C')
        to bad when (omgrfn4_l2_omgcomp_byte(4)!='O') to bad when (omgrfn4_l2_omgcomp_byte(5)!='M')
        to bad when (omgrfn4_l2_omgcomp_byte(6)!='P') to bad when (omgrfn4_l2_omgcomp_byte(7)!=0)
        to bad when (omgrfn4_l2_omgcomp_byte(8)!=1) to bad when (omgrfn4_l2_omgcomp_byte(9)!=0)
        to bad when (omgrfn4_l2_omgcomp_byte(10)!=0) to bad when (omgrfn4_l2_omgcomp_byte(11)!=0)
        to bad when (omgrfn4_l2_omgcomp_byte(12)!=1) to bad when (omgrfn4_l2_omgcomp_byte(13)!=0)
        to bad when (omgrfn4_l2_omgcomp_byte(14)!=0) to bad when (omgrfn4_l2_omgcomp_byte(15)!=0)
        to header
    }
    state header {
        word[500280]=omgrfn4_l2_comp_u32(16) word[500288]=omgrfn4_l2_comp_u32(20)
        word[500296]=omgrfn4_l2_comp_u32(24) word[500304]=omgrfn4_l2_comp_u32(28)
        word[500312]=omgrfn4_l2_comp_u32(32) word[500320]=omgrfn4_l2_comp_u32(36)
        word[500328]=omgrfn4_l2_comp_u32(40) word[500336]=omgrfn4_l2_comp_u32(44)
        word[500344]=omgrfn4_l2_comp_u32(48) word[500352]=omgrfn4_l2_comp_u32(52)
        word[500360]=omgrfn4_l2_comp_u32(56)
        to bad when (word[500280]!=n) to bad when (word[500312]!=1)
        to bad when (word[500320]!=2) to bad when (word[500328]!=0)
        to bad when (word[500304]<1) to exhausted when (word[500304]>64)
        to exhausted when (word[500288]>263312)
        to bad when (word[500336]!=0) to bad when (word[500344]!=1)
        to bad when (word[500352]>=word[500304]) to bad when (word[500360]>=word[500304])
        ; Focused carrier: one package, two source rows, no aliases.
        word[500368]=64 word[500376]=112 word[500384]=152 word[500392]=152
        word[500400]=word[500392]+word[500296]
        to bad when (word[500400]>n) to bad when (word[500288]!=n-word[500400])
        ; Package row: dense zero, exact source partition, reserved zero.
        to bad when (omgrfn4_l2_comp_u32(64)!=0) to bad when (omgrfn4_l2_comp_u32(100)!=0)
        to bad when (omgrfn4_l2_comp_u32(104)!=2) to bad when (omgrfn4_l2_comp_u32(108)!=0)
        i=0 to sources
    }
    state sources { to source_row when (i<2) i=0 at=word[500392] to strings }
    state source_row {
        at=112+i*20
        to bad when (omgrfn4_l2_comp_u32(at)!=i)
        owner=omgrfn4_l2_comp_u32(at+4) bundle=omgrfn4_l2_comp_u32(at+8) module=omgrfn4_l2_comp_u32(at+12)
        to bad when (owner!=0) to bad when (bundle>=2) to bad when (module>=word[500304])
        to bad when (omgrfn4_l2_comp_u32(at+16)!=0)
        word[600384+i*8]=owner word[600512+i*8]=bundle word[600640+i*8]=module
        i=i+1 to sources
    }
    state strings { to string_row when (i<word[500304]) to bad when (at!=word[500400]) i=0 at=word[500400] to bundle_magic }
    state string_row {
        to bad when (at>word[500400]-4) content_length=omgrfn4_l2_comp_u32(at)
        to bad when (content_length>word[500400]-at-4)
        word[601664+i*8]=at+4 word[602176+i*8]=content_length
        at=at+4+content_length i=i+1 to strings
    }
    state bundle_magic {
        to bad when (word[500288]<16)
        to bad when (omgrfn4_l2_omgcomp_byte(at)!='O') to bad when (omgrfn4_l2_omgcomp_byte(at+1)!='M')
        to bad when (omgrfn4_l2_omgcomp_byte(at+2)!='G') to bad when (omgrfn4_l2_omgcomp_byte(at+3)!='0')
        to bad when (omgrfn4_l2_omgcomp_byte(at+4)!='B') to bad when (omgrfn4_l2_omgcomp_byte(at+5)!='N')
        to bad when (omgrfn4_l2_omgcomp_byte(at+6)!='D') to bad when (omgrfn4_l2_omgcomp_byte(at+7)!='L')
        to bad when (omgrfn4_l2_comp_u32(at+8)!=1) to bad when (omgrfn4_l2_comp_u32(at+12)!=2)
        at=at+16 i=0 to bundle_rows
    }
    state bundle_rows { to bundle_row when (i<2) to bad when (at!=n) i=0 to source_extents }
    state bundle_row {
        to bad when (at>n-8) label_length=omgrfn4_l2_comp_u32(at) content_length=omgrfn4_l2_comp_u32(at+4)
        to exhausted when (label_length>64) to exhausted when (content_length>131072)
        to bad when (label_length<1) to bad when (label_length>n-at-8)
        to bad when (content_length>n-at-8-label_length)
        word[607296+i*8]=at+8+label_length word[607424+i*8]=content_length
        at=at+8+label_length+content_length i=i+1 to bundle_rows
    }
    state source_extents { to source_extent when (i<2) return 0 }
    state source_extent {
        bundle=word[600512+i*8]
        word[607040+i*8]=word[607296+bundle*8] word[607168+i*8]=word[607424+bundle*8]
        i=i+1 to source_extents
    }
    state exhausted { return omgrfn4_l2_exhaust() }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn4_l2_witness_byte(index) { return omgrfn4_l2_frame_byte(word[500040]+index) }

; Shared byte comparison/serialization primitives for the V4 R2 model.
proc omgrfn4_l2_span_equal(a_source,a_start,b_source,b_start) {
    let i=0
    state loop { to one when (i<word[700056]) return 1 }
    state one { to no when (omgrfn4_l2_source_byte(a_source,a_start+i)!=omgrfn4_l2_source_byte(b_source,b_start+i)) i=i+1 to loop }
    state no { return 0 }
}

proc omgrfn4_l2_put_byte(value) { byte[900000+word[700048]]=value word[700048]=word[700048]+1 return value }
proc omgrfn4_l2_put_u16(value) { omgrfn4_l2_put_byte(value%256) omgrfn4_l2_put_byte((value/256)%256) return value }
proc omgrfn4_l2_put_u32(value) { omgrfn4_l2_put_byte(value%256) omgrfn4_l2_put_byte((value/256)%256) omgrfn4_l2_put_byte((value/65536)%256) omgrfn4_l2_put_byte((value/16777216)%256) return value }

proc omgrfn4_l2_compare_expected() {
    let i=0
    state length { to bad when (word[500048]!=word[700048]) to loop }
    state loop { to one when (i<word[700048]) return 0 }
    state one { to bad when (omgrfn4_l2_witness_byte(i)!=byte[900000+i]) i=i+1 to loop }
    state bad { return omgrfn4_l2_reject() }
}

; --- V4 Unicode/general constant-aggregate resolution model -----------------

proc omgrfn4_r2_slot(source_id,token_id) { return source_id*18000+token_id }
proc omgrfn4_r2_tstart(source_id,token_id) { return word[6000000+omgrfn4_r2_slot(source_id,token_id)*8] }
proc omgrfn4_r2_tlen(source_id,token_id) { return word[6290000+omgrfn4_r2_slot(source_id,token_id)*8] }
proc omgrfn4_r2_tkind(source_id,token_id) { return word[6580000+omgrfn4_r2_slot(source_id,token_id)*8] }
proc omgrfn4_r2_cur(source_id) { return word[880016+source_id*8] }
proc omgrfn4_r2_next(source_id) { word[880016+source_id*8]=word[880016+source_id*8]+1 return word[880016+source_id*8] }

proc omgrfn4_r2_ident_start(c) {
    state underscore { to yes when (c=='_') to upper0 }
    state upper0 { to upper1 when (c>='A') to lower0 }
    state upper1 { to yes when (c<='Z') to lower0 }
    state lower0 { to lower1 when (c>='a') return 0 }
    state lower1 { to yes when (c<='z') return 0 }
    state yes { return 1 }
}

proc omgrfn4_r2_ident_continue(c) {
    state ident { to yes when (omgrfn4_r2_ident_start(c)==1) to digit0 }
    state digit0 { to digit1 when (c>='0') return 0 }
    state digit1 { to yes when (c<='9') return 0 }
    state yes { return 1 }
}

proc omgrfn4_r2_tokenize(source_id) {
    let p=0 let n=omgrfn4_l2_source_length(source_id) let count=0 let start=0 let c=0 let depth=0
    state skip { to classify when (p<n) to finish }
    state classify {
        c=omgrfn4_l2_source_byte(source_id,p)
        to whitespace when (c==' ') to whitespace when (c==9) to whitespace when (c==10) to whitespace when (c==13)
        to slash when (c=='/') to capacity
    }
    state whitespace { p=p+1 to skip }
    state slash { to capacity when (p+1>=n) to line_begin when (omgrfn4_l2_source_byte(source_id,p+1)=='/') to block_begin when (omgrfn4_l2_source_byte(source_id,p+1)=='*') to capacity }
    state line_begin { p=p+2 to line }
    state line { to finish when (p>=n) to whitespace when (omgrfn4_l2_source_byte(source_id,p)==10) p=p+1 to line }
    state block_begin { depth=1 p=p+2 to block }
    state block { to bad when (p>=n) to block_slash }
    state block_slash { to block_star when (omgrfn4_l2_source_byte(source_id,p)!='/') to block_open_room }
    state block_open_room { to block_advance when (p+1>=n) to block_open }
    state block_open { to block_advance when (omgrfn4_l2_source_byte(source_id,p+1)!='*') depth=depth+1 p=p+2 to block }
    state block_star { to block_advance when (omgrfn4_l2_source_byte(source_id,p)!='*') to block_close_room }
    state block_close_room { to block_advance when (p+1>=n) to block_close }
    state block_close { to block_advance when (omgrfn4_l2_source_byte(source_id,p+1)!='/') depth=depth-1 p=p+2 to skip when (depth==0) to block }
    state block_advance { p=p+1 to block }
    state capacity { to exhausted when (count>=18000) start=p to ident when (omgrfn4_r2_ident_start(c)==1) to number0 }
    state ident { p=p+1 to ident_loop }
    state ident_loop { to save_ident when (p>=n) c=omgrfn4_l2_source_byte(source_id,p) to save_ident when (omgrfn4_r2_ident_continue(c)==0) to exhausted when (p-start>=64) p=p+1 to ident_loop }
    state save_ident { word[6000000+omgrfn4_r2_slot(source_id,count)*8]=start word[6290000+omgrfn4_r2_slot(source_id,count)*8]=p-start word[6580000+omgrfn4_r2_slot(source_id,count)*8]=256 count=count+1 to skip }
    state number0 { to punctuation when (c<'0') to punctuation when (c>'9') p=p+1 to number }
    state number { to save_number when (p>=n) c=omgrfn4_l2_source_byte(source_id,p) to save_number when (c<'0') to save_number when (c>'9') p=p+1 to number }
    state save_number { word[6000000+omgrfn4_r2_slot(source_id,count)*8]=start word[6290000+omgrfn4_r2_slot(source_id,count)*8]=p-start word[6580000+omgrfn4_r2_slot(source_id,count)*8]=257 count=count+1 to skip }
    state punctuation { to bad when (c>=128) to bad when (c==34) word[6000000+omgrfn4_r2_slot(source_id,count)*8]=p word[6290000+omgrfn4_r2_slot(source_id,count)*8]=1 word[6580000+omgrfn4_r2_slot(source_id,count)*8]=c count=count+1 p=p+1 to skip }
    state finish { word[880000+source_id*8]=count word[880016+source_id*8]=0 return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
    state bad { return omgrfn4_l2_reject() }
}

; Keyword codes: data,machine,state,copy,mut,self,bool,u8,u32,in,Trapping,pub.
proc omgrfn4_r2_init_words() {
    ; datamachinestatecopymutselfboolu8u32inTrappingpub
    byte[870000]=100 byte[870001]=97 byte[870002]=116 byte[870003]=97
    byte[870004]=109 byte[870005]=97 byte[870006]=99 byte[870007]=104 byte[870008]=105 byte[870009]=110 byte[870010]=101
    byte[870011]=115 byte[870012]=116 byte[870013]=97 byte[870014]=116 byte[870015]=101
    byte[870016]=99 byte[870017]=111 byte[870018]=112 byte[870019]=121
    byte[870020]=109 byte[870021]=117 byte[870022]=116
    byte[870023]=115 byte[870024]=101 byte[870025]=108 byte[870026]=102
    byte[870027]=98 byte[870028]=111 byte[870029]=111 byte[870030]=108
    byte[870031]=117 byte[870032]=56 byte[870033]=117 byte[870034]=51 byte[870035]=50
    byte[870036]=105 byte[870037]=110
    byte[870038]=84 byte[870039]=114 byte[870040]=97 byte[870041]=112 byte[870042]=112 byte[870043]=105 byte[870044]=110 byte[870045]=103
    byte[870046]=112 byte[870047]=117 byte[870048]=98 return 0
}

proc omgrfn4_r2_word_start(code) {
    state c0 { to x0 when (code==0) to c1 } state x0 { return 0 }
    state c1 { to x1 when (code==1) to c2 } state x1 { return 4 }
    state c2 { to x2 when (code==2) to c3 } state x2 { return 11 }
    state c3 { to x3 when (code==3) to c4 } state x3 { return 16 }
    state c4 { to x4 when (code==4) to c5 } state x4 { return 20 }
    state c5 { to x5 when (code==5) to c6 } state x5 { return 23 }
    state c6 { to x6 when (code==6) to c7 } state x6 { return 27 }
    state c7 { to x7 when (code==7) to c8 } state x7 { return 31 }
    state c8 { to x8 when (code==8) to c9 } state x8 { return 33 }
    state c9 { to x9 when (code==9) to c10 } state x9 { return 36 }
    state c10 { to x10 when (code==10) return 46 } state x10 { return 38 }
}

proc omgrfn4_r2_word_len(code) {
    state c0 { to x0 when (code==0) to c1 } state x0 { return 4 }
    state c1 { to x1 when (code==1) to c2 } state x1 { return 7 }
    state c2 { to x2 when (code==2) to c3 } state x2 { return 5 }
    state c3 { to x3 when (code==3) to c4 } state x3 { return 4 }
    state c4 { to x4 when (code==4) to c5 } state x4 { return 3 }
    state c5 { to x5 when (code==5) to c6 } state x5 { return 4 }
    state c6 { to x6 when (code==6) to c7 } state x6 { return 4 }
    state c7 { to x7 when (code==7) to c8 } state x7 { return 2 }
    state c8 { to x8 when (code==8) to c9 } state x8 { return 3 }
    state c9 { to x9 when (code==9) to c10 } state x9 { return 2 }
    state c10 { to x10 when (code==10) return 3 } state x10 { return 8 }
}

proc omgrfn4_r2_is_word(source_id,token_id,code) {
    let i=0 let n=omgrfn4_r2_word_len(code) let at=omgrfn4_r2_word_start(code)
    state kind { to no when (omgrfn4_r2_tkind(source_id,token_id)!=256) to length }
    state length { to no when (omgrfn4_r2_tlen(source_id,token_id)!=n) to loop }
    state loop { to one when (i<n) return 1 }
    state one { to no when (omgrfn4_l2_source_byte(source_id,omgrfn4_r2_tstart(source_id,token_id)+i)!=byte[870000+at+i]) i=i+1 to loop }
    state no { return 0 }
}

proc omgrfn4_r2_expect_kind(source_id,kind) {
    let t=omgrfn4_r2_cur(source_id)
    state room { to bad when (t>=word[880000+source_id*8]) to check }
    state check { to bad when (omgrfn4_r2_tkind(source_id,t)!=kind) omgrfn4_r2_next(source_id) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn4_r2_expect_word(source_id,code) {
    let t=omgrfn4_r2_cur(source_id)
    state room { to bad when (t>=word[880000+source_id*8]) to check }
    state check { to bad when (omgrfn4_r2_is_word(source_id,t,code)==0) omgrfn4_r2_next(source_id) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn4_r2_token_equal(as,at,bs,bt) {
    let i=0 let n=omgrfn4_r2_tlen(as,at)
    state length { to no when (n!=omgrfn4_r2_tlen(bs,bt)) to loop }
    state loop { to one when (i<n) return 1 }
    state one { to no when (omgrfn4_l2_source_byte(as,omgrfn4_r2_tstart(as,at)+i)!=omgrfn4_l2_source_byte(bs,omgrfn4_r2_tstart(bs,bt)+i)) i=i+1 to loop }
    state no { return 0 }
}

proc omgrfn4_r2_number(source_id,token_id) {
    let i=0 let value=0 let c=0
    state kind { to bad when (omgrfn4_r2_tkind(source_id,token_id)!=257) to loop }
    state loop { to one when (i<omgrfn4_r2_tlen(source_id,token_id)) word[879000]=value return 0 }
    state one { c=omgrfn4_l2_source_byte(source_id,omgrfn4_r2_tstart(source_id,token_id)+i) to bad when (value>214748364) value=value*10+c-'0' to bad when (value>2147483647) i=i+1 to loop }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn4_r2_find_record(source_id,token_id) {
    let i=0 let rs=0 let rt=0
    state loop { to one when (i<word[879008]) word[879132]=4294967295 return 0 }
    state one { rs=word[881000+i*64] rt=word[881008+i*64] to found when (omgrfn4_r2_token_equal(source_id,token_id,rs,rt)==1) i=i+1 to loop }
    state found { word[879132]=i return 0 }
}

proc omgrfn4_r2_parse_type(source_id) {
    let t=omgrfn4_r2_cur(source_id) let nominal=0
    word[879100]=0 word[879108]=0 word[879116]=0 word[879124]=0
