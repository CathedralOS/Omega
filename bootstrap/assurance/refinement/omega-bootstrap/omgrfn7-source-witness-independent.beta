; Shared OMGRFN7/OMGRFN8/OMGRFN9 responsibility 2 source-resolution model.
;
; OMGRFN7 retains its exact pure-sum -> OMGRSW3 proposition. OMGRFN8 accepts
; the least OMGRSW1/2/3 identity selected by the exact source: sums select 3,
; otherwise a direct field-receiver call selects 2, and otherwise 1. Authored
; logical negation is required by OMGRFN8 but creates no resolution identity
; and therefore never affects that selection.
;
; This adapter is compiled with the frozen OMGRFN4 responsibility-2 source
; model.  It reuses only propositionally unchanged OMGCOMP decoding, lexical
; primitives, span comparison, and bounded scratch conventions.  It does not
; call the OMGRFN4 frame reader or its fixture-specific resolution conclusion.
; CKIR, ELF, and claimed result bytes remain opaque after exact framing.

proc omgrfn5_r2_u32(at) { return omgrfn4_l2_frame_u32(at) }

proc omgrfn5_r2_read_frame() {
    let n=0 let overflow=0 let c=read_byte() let cursor=0
    state read { to one when (c>=0) to header }
    state one { to over when (n>=4497544) byte[1048576+n]=c n=n+1 c=read_byte() to read }
    state over { overflow=1 c=read_byte() to read }
    state header { to exhausted when (overflow==1) to bad when (n<40) to magic }
    state magic {
        to bad when (omgrfn4_l2_frame_byte(0)!='O') to bad when (omgrfn4_l2_frame_byte(1)!='M')
        to bad when (omgrfn4_l2_frame_byte(2)!='G') to bad when (omgrfn4_l2_frame_byte(3)!='R')
        to bad when (omgrfn4_l2_frame_byte(4)!='F') to bad when (omgrfn4_l2_frame_byte(5)!='N')
        to bad when (omgrfn4_l2_frame_byte(7)!=0)
        to v7 when (omgrfn4_l2_frame_byte(6)=='7')
        to v8 when (omgrfn4_l2_frame_byte(6)=='8')
        to v9 when (omgrfn4_l2_frame_byte(6)=='9') to bad
    }
    state v7 { to bad when (omgrfn5_r2_u32(8)!=7) word[879088]=7 to components }
    state v8 { to bad when (omgrfn5_r2_u32(8)!=8) word[879088]=8 to components }
    state v9 { to bad when (omgrfn5_r2_u32(8)!=9) word[879088]=9 to components }
    state components {
        word[500016]=omgrfn5_r2_u32(12) word[500032]=omgrfn5_r2_u32(16)
        word[500048]=omgrfn5_r2_u32(20) word[500064]=omgrfn5_r2_u32(24)
        word[500080]=omgrfn5_r2_u32(28) word[500088]=omgrfn5_r2_u32(32)
        word[500096]=omgrfn5_r2_u32(36)
        to bad when (word[500016]>1) to bad when (word[500032]<1)
        to bad when (word[500048]<1) to bad when (word[500064]<1)
        to exhausted when (word[500032]>267280) to exhausted when (word[500048]>524288)
        to exhausted when (word[500064]>2522192) to exhausted when (word[500080]>1183744)
        cursor=40 word[500024]=cursor
        to bad when (word[500032]>n-cursor) cursor=cursor+word[500032] word[500040]=cursor
        to bad when (word[500048]>n-cursor) cursor=cursor+word[500048] word[500056]=cursor
        to bad when (word[500064]>n-cursor) cursor=cursor+word[500064] word[500072]=cursor
        to bad when (word[500080]!=n-cursor) to library when (word[500016]==0) to entry
    }
    state library { to bad when (word[500080]!=0) to bad when (word[500088]!=4294967295) to bad when (word[500096]!=4294967295) return 0 }
    state entry { to bad when (word[500080]<1) to bad when (word[500096]>255) to bad when (word[500096]!=word[500088]%256) return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
    state bad { return omgrfn4_l2_reject() }
}

; Raw focused type codes.  Canonical OMGRSW1 IDs are assigned only after all
; nominal records have been reconstructed, matching the resolver's nominal,
; bool, full-u32, non-array, then array canonicalization order.
;   100+record: nominal record; 300+sum: nominal sum; 200: bool; 201: u8;
;   202: full u32. This focused V7 owner rejects the unused inherited type
;   spellings rather than guessing new source meaning.
proc omgrfn5_r2_type_id(raw) {
    state nominal0 { to nominal1 when (raw>=100) to bad }
    state nominal1 { to nominal when (raw<100+word[879008]) to sum0 }
    state nominal { return raw-100 }
    state sum0 { to sum1 when (raw>=300) to bool }
    state sum1 { to sum when (raw<300+word[879344]) to bool }
    state sum { return word[879008]+raw-300 }
    state bool { to x4 when (raw==200) to u8 } state x4 { return word[879008]+word[879344] }
    state u8 { to x7 when (raw==201) to full } state x7 { return word[879008]+word[879344]+2 }
    state full { to x5 when (raw==202) to bad } state x5 { return word[879008]+word[879344]+1 }
    state bad { return 4294967295 }
}

proc omgrfn7_r2_is_case(source_id,token_id) {
    state kind { to no when (omgrfn4_r2_tkind(source_id,token_id)!=256) to length }
    state length { to no when (omgrfn4_r2_tlen(source_id,token_id)!=4) to c0 }
    state c0 { to no when (omgrfn4_l2_source_byte(source_id,omgrfn4_r2_tstart(source_id,token_id))!='c') to c1 }
    state c1 { to no when (omgrfn4_l2_source_byte(source_id,omgrfn4_r2_tstart(source_id,token_id)+1)!='a') to c2 }
    state c2 { to no when (omgrfn4_l2_source_byte(source_id,omgrfn4_r2_tstart(source_id,token_id)+2)!='s') to c3 }
    state c3 { to no when (omgrfn4_l2_source_byte(source_id,omgrfn4_r2_tstart(source_id,token_id)+3)!='e') return 1 }
    state no { return 0 }
}

proc omgrfn7_r2_find_sum(source_id,token_id) {
    let i=0
    state loop { to one when (i<word[879344]) word[879132]=4294967295 return 0 }
    state one { to found when (omgrfn4_r2_token_equal(source_id,token_id,word[910000+i*64],word[910008+i*64])==1) i=i+1 to loop }
    state found { word[879132]=i return 0 }
}

proc omgrfn5_r2_parse_type(source_id) {
    let t=omgrfn4_r2_cur(source_id) let rid=0 let high=0
    word[879100]=4294967295 word[879108]=0 word[879116]=0 word[879124]=0
    state room { to bad when (t>=word[880000+source_id*8]) to bad when (omgrfn4_r2_tkind(source_id,t)==91) to scalar }
    state scalar {
        to bool when (omgrfn4_r2_is_word(source_id,t,6)==1)
        to u8 when (omgrfn4_r2_is_word(source_id,t,7)==1)
        to u32 when (omgrfn4_r2_is_word(source_id,t,8)==1)
        to nominal
    }
    state bool { word[879100]=200 omgrfn4_r2_next(source_id) return 0 }
    state u8 { word[879100]=201 omgrfn4_r2_next(source_id) return 0 }
    state nominal {
        to bad when (omgrfn4_r2_tkind(source_id,t)!=256)
        omgrfn4_r2_find_record(source_id,t) rid=word[879132]
        to record when (rid!=4294967295)
        omgrfn7_r2_find_sum(source_id,t) rid=word[879132]
        to bad when (rid==4294967295)
        word[879100]=300+rid word[879108]=source_id word[879116]=t
        omgrfn4_r2_next(source_id) return 0
    }
    state record { word[879100]=100+rid word[879108]=source_id word[879116]=t omgrfn4_r2_next(source_id) return 0 }
    state u32 { word[879100]=202 omgrfn4_r2_next(source_id) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn5_r2_parse_data(source_id) {
    let rid=word[879008] let sid=word[879344] let name=0 let fid=0 let cid=0 let pid=0 let at=0 let flags=0
    state cap { to v7_cap when (word[879088]>=7) to exhausted when (rid>=16) to keyword }
    state v7_cap { to exhausted when (rid+sid>=128) to keyword }
    state keyword { to bad when (omgrfn4_r2_expect_word(source_id,0)!=0) name=omgrfn4_r2_cur(source_id) to name }
    state name { to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0) to copy_open when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==91) to open }
    state copy_open { omgrfn4_r2_next(source_id) to bad when (omgrfn4_r2_expect_word(source_id,3)!=0) to copy_close }
    state copy_close { to bad when (omgrfn4_r2_expect_kind(source_id,93)!=0) flags=1 to open }
    state open { to bad when (omgrfn4_r2_expect_kind(source_id,123)!=0) to sum when (word[879088]>=7) to record }
    state sum { to sum_start when (omgrfn7_r2_is_case(source_id,omgrfn4_r2_cur(source_id))==1) to record }
    state record { word[881000+rid*64]=source_id word[881008+rid*64]=name word[881032+rid*64]=word[879016] word[881048+rid*64]=flags word[879008]=rid+1 omgrfn4_r2_add_decl(1,source_id,name,rid) word[881016+rid*64]=word[879176] to fields }
    state fields { to bad when (word[700000]!=0) to close when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==125) to field_cap }
    state field_cap { to exhausted when (word[879016]>=128) fid=word[879016] at=882000+fid*64 word[at]=rid word[at+8]=word[881040+rid*64] name=omgrfn4_r2_cur(source_id) to field_name }
    state field_name { to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0) word[at+32]=omgrfn4_r2_tstart(source_id,name) word[at+40]=omgrfn4_r2_tlen(source_id,name) to colon }
    state colon { to bad when (omgrfn4_r2_expect_kind(source_id,58)!=0) to field_type }
    state field_type { to bad when (omgrfn5_r2_parse_type(source_id)!=0) word[at+16]=word[879100] word[at+24]=word[879124] word[at+48]=word[879108] word[at+56]=word[879116] to semi }
    state semi { to bad when (omgrfn4_r2_expect_kind(source_id,59)!=0) word[879016]=fid+1 word[881040+rid*64]=word[881040+rid*64]+1 to fields }
    state close { omgrfn4_r2_next(source_id) return 0 }
    state sum_start {
        to exhausted when (sid>=128)
        word[910000+sid*64]=source_id word[910008+sid*64]=name
        word[910032+sid*64]=word[879352] word[910048+sid*64]=flags
        word[879344]=sid+1 omgrfn4_r2_add_decl(3,source_id,name,sid)
        word[910016+sid*64]=word[879176] to cases
    }
    state cases { to sum_close when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==125) to case_keyword }
    state case_keyword { to bad when (omgrfn7_r2_is_case(source_id,omgrfn4_r2_cur(source_id))==0) omgrfn4_r2_next(source_id) cid=word[879352] to case_cap }
    state case_cap { to exhausted when (cid>=4096) at=920000+cid*64 name=omgrfn4_r2_cur(source_id) to case_name }
    state case_name {
        to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0)
        word[at]=sid word[at+8]=word[910040+sid*64]
        word[at+16]=word[879360] word[at+32]=source_id
        word[at+40]=omgrfn4_r2_tstart(source_id,name) word[at+48]=omgrfn4_r2_tlen(source_id,name)
        word[879352]=cid+1 word[910040+sid*64]=word[910040+sid*64]+1
        to payload_open when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==40) to case_semi
    }
    state payload_open { omgrfn4_r2_next(source_id) to payload_close when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==41) to payload }
    state payload { pid=word[879360] to payload_cap }
    state payload_cap { to exhausted when (pid>=4096) at=1200000+pid*64 name=omgrfn4_r2_cur(source_id) to payload_name }
    state payload_name {
        to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0)
        word[at]=cid word[at+8]=word[920024+cid*64]
        word[at+24]=source_id word[at+32]=omgrfn4_r2_tstart(source_id,name) word[at+40]=omgrfn4_r2_tlen(source_id,name)
        to payload_colon
    }
    state payload_colon { to bad when (omgrfn4_r2_expect_kind(source_id,58)!=0) to payload_type }
    state payload_type {
        to bad when (omgrfn5_r2_parse_type(source_id)!=0)
        word[at+16]=word[879100] word[at+48]=word[879108] word[at+56]=word[879116]
        word[879360]=pid+1 word[920024+cid*64]=word[920024+cid*64]+1
        to payload_comma when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==44) to payload_close
    }
    state payload_comma { omgrfn4_r2_next(source_id) to payload }
    state payload_close { to bad when (omgrfn4_r2_expect_kind(source_id,41)!=0) to case_semi }
    state case_semi {
        to bad when (omgrfn4_r2_expect_kind(source_id,59)!=0)
        to payload_over when (word[920024+cid*64]>4)
        to cases
    }
    state payload_over { word[879368]=1 to cases }
    state sum_close {
        to bad when (word[910040+sid*64]<1)
        to cases_over when (word[910040+sid*64]>64)
        omgrfn4_r2_next(source_id) return 0
    }
    state cases_over { word[879368]=1 omgrfn4_r2_next(source_id) return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn5_r2_add_block(machine_id,ordinal,name_token,source_id) {
    let id=word[879040] let at=0
    state cap { to exhausted when (id>=128) at=888000+id*96 to save }
    state save {
        word[at]=machine_id word[at+8]=ordinal word[at+16]=word[879328]
        word[at+40]=4294967295 word[at+48]=0 word[at+56]=word[879048] word[at+64]=0
        to named when (name_token!=4294967295) word[879040]=id+1 word[879320]=id return 0
    }
    state named { word[at+40]=omgrfn4_r2_tstart(source_id,name_token) word[at+48]=omgrfn4_r2_tlen(source_id,name_token) word[879040]=id+1 word[879320]=id return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
}

proc omgrfn5_r2_parse_parameter(source_id,owner,ordinal,kind) {
    let id=0 let name=omgrfn4_r2_cur(source_id) let at=0 let type_at=0
    state select { to machine when (kind==1) to block }
    state machine { id=word[879032] to machine_cap }
    state machine_cap { to exhausted when (id>=128) at=886000+id*48 to name }
    state block { id=word[879048] to block_cap }
    state block_cap { to exhausted when (id>=128) at=893000+id*48 to name }
    state name { to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0) word[at]=owner word[at+8]=ordinal word[at+24]=omgrfn4_r2_tstart(source_id,name) word[at+32]=omgrfn4_r2_tlen(source_id,name) to colon }
    state colon { to bad when (omgrfn4_r2_expect_kind(source_id,58)!=0) to type }
    state type { to bad when (omgrfn5_r2_parse_type(source_id)!=0) word[at+16]=word[879100] to machine_done when (kind==1) type_at=907048+id*16 word[type_at]=word[879108] word[type_at+8]=word[879116] word[879048]=id+1 return 0 }
    state machine_done { type_at=905000+id*16 word[type_at]=word[879108] word[type_at+8]=word[879116] word[879032]=id+1 return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn5_r2_receiver(source_id) {
    state amp { to bad when (omgrfn4_r2_expect_kind(source_id,38)!=0) to maybe_mut }
    state maybe_mut { to shared when (omgrfn4_r2_is_word(source_id,omgrfn4_r2_cur(source_id),4)==0) omgrfn4_r2_next(source_id) word[879328]=2 to self }
    state shared { word[879328]=1 to self }
    state self { to bad when (omgrfn4_r2_expect_word(source_id,5)!=0) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

; V5 preserves the frozen self.machine scanner. V6 recognizes dotted calls
; only when their complete receiver is self or one direct named field of self.
; The field token is retained privately so resolution can derive its nominal
; owner; OMGRSW2 keeps the unchanged role-3 row shape and spans only the final
; machine-name token.
proc omgrfn5_r2_add_call(source_id,name_token,machine_id,field_token) {
    let id=word[879064] let at=0
    state cap { to exhausted when (id>=128) at=894000+id*48 to save }
    state save { word[at]=source_id word[at+8]=omgrfn4_r2_tstart(source_id,name_token) word[at+16]=omgrfn4_r2_tlen(source_id,name_token) word[at+24]=machine_id word[at+32]=4294967295 word[at+40]=field_token word[879064]=id+1 to field when (field_token!=4294967295) return 0 }
    state field { word[879336]=word[879336]+1 return 0 }
    state exhausted { return omgrfn4_l2_exhaust() }
}

proc omgrfn5_r2_scan_block(source_id,machine_id,block_id,allow_state) {
    let depth=0 let t=0 let count=word[880000+source_id*8]
    state loop { t=omgrfn4_r2_cur(source_id) to bad when (t>=count) to state_end when (allow_state==1) to close_check }
    state state_end { to close_check when (depth!=0) to found_state when (omgrfn4_r2_is_word(source_id,t,2)==1) to close_check }
    state close_check { to call_check when (depth!=0) to close when (omgrfn4_r2_tkind(source_id,t)==125) to call_check }
    state call_check { to v6 }
    ; Inspect the callee token. Any dotted call outside the two exact
    ; receiver grammars fails closed instead of disappearing from resolution.
    state v6 { to punctuation when (omgrfn4_r2_tkind(source_id,t)!=256) to punctuation when (t+1>=count) to punctuation when (omgrfn4_r2_tkind(source_id,t+1)!=40) to punctuation when (t<2) to punctuation when (omgrfn4_r2_tkind(source_id,t-1)!=46) to direct when (omgrfn4_r2_is_word(source_id,t-2,5)==1) to field_room }
    state direct { omgrfn5_r2_add_call(source_id,t,machine_id,4294967295) to punctuation }
    state field_room { to bad when (t<4) to bad when (omgrfn4_r2_tkind(source_id,t-3)!=46) to bad when (omgrfn4_r2_tkind(source_id,t-2)!=256) to bad when (omgrfn4_r2_is_word(source_id,t-4,5)==0) omgrfn5_r2_add_call(source_id,t,machine_id,t-2) to punctuation }
    state punctuation { to open when (omgrfn4_r2_tkind(source_id,t)==123) to nested_close when (omgrfn4_r2_tkind(source_id,t)==125) omgrfn4_r2_next(source_id) to loop }
    state open { depth=depth+1 omgrfn4_r2_next(source_id) to loop }
    state nested_close { depth=depth-1 omgrfn4_r2_next(source_id) to loop }
    state found_state { word[888032+block_id*96]=omgrfn4_r2_tstart(source_id,t) word[879300]=1 return 0 }
    state close { word[888032+block_id*96]=omgrfn4_r2_tstart(source_id,t) word[879300]=0 omgrfn4_r2_next(source_id) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn5_r2_parse_state(source_id,machine_id,ordinal) {
    let name=0 let bid=0 let at=0
    state keyword { to bad when (omgrfn4_r2_expect_word(source_id,2)!=0) name=omgrfn4_r2_cur(source_id) to name }
    state name { to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0) to paren }
    state paren { to bad when (omgrfn4_r2_expect_kind(source_id,40)!=0) to receiver }
    state receiver { to bad when (omgrfn5_r2_receiver(source_id)!=0) omgrfn5_r2_add_block(machine_id,ordinal,name,source_id) bid=word[879320] at=888000+bid*96 to params }
    state params { to close when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==41) to comma }
    state comma { to bad when (omgrfn4_r2_expect_kind(source_id,44)!=0) to param }
    state param { omgrfn5_r2_parse_parameter(source_id,bid,word[at+64],2) to bad when (word[700000]!=0) word[at+64]=word[at+64]+1 to params }
    state close { omgrfn4_r2_next(source_id) to open }
    state open { to bad when (omgrfn4_r2_expect_kind(source_id,123)!=0) word[at+24]=omgrfn4_r2_tstart(source_id,omgrfn4_r2_cur(source_id)) omgrfn5_r2_scan_block(source_id,machine_id,bid,0) return word[700000] }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn5_r2_parse_machine(source_id) {
    let mid=word[879024] let owner=0 let name=0 let at=0 let ordinal=0 let bid=0
    state cap { to exhausted when (mid>=16) at=884000+mid*128 to keyword }
    state keyword { to bad when (omgrfn4_r2_expect_word(source_id,1)!=0) owner=omgrfn4_r2_cur(source_id) to owner }
    state owner { to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0) to colon0 }
    state colon0 { to bad when (omgrfn4_r2_expect_kind(source_id,58)!=0) to colon1 }
    state colon1 { to bad when (omgrfn4_r2_expect_kind(source_id,58)!=0) name=omgrfn4_r2_cur(source_id) to name }
    state name {
        to bad when (omgrfn4_r2_expect_kind(source_id,256)!=0)
        word[at]=source_id word[at+8]=owner word[at+16]=source_id word[at+24]=name
        word[at+40]=4294967295 word[at+48]=word[879032] word[at+56]=0 word[at+64]=word[879040]
        word[879024]=mid+1 omgrfn4_r2_add_decl(2,source_id,name,mid) word[at+80]=word[879176]
        omgrfn4_r2_find_record(source_id,owner) to owner_record
    }
    state owner_record { to bad when (word[879132]==4294967295) word[at+88]=word[879132] to paren }
    state paren { to bad when (omgrfn4_r2_expect_kind(source_id,40)!=0) to receiver }
    state receiver { to bad when (omgrfn5_r2_receiver(source_id)!=0) word[at+32]=word[879328] to params }
    state params { to close when (omgrfn4_r2_tkind(source_id,omgrfn4_r2_cur(source_id))==41) to comma }
    state comma { to bad when (omgrfn4_r2_expect_kind(source_id,44)!=0) to param }
