; Focused future-OMGRFN4-R4 source-only evaluator boundary witness.
;
; This is not the complete R4 source lowering proof.  It independently parses
; and evaluates the genuine one-unit source/witness family used to isolate the
; source evaluator's two published work bounds: 16 active machine frames and
; 65,536 dynamic block entries.  CKIR3 and ELF accessors are physically absent.
;
; Fresh memory map, statically disjoint from the frozen V3 evaluator:
;   word[29000000..29100000)       status, extents, parser/evaluator state
;   byte[30000000..34497543]       raw OMGRFN4 frame (4,497,544 max)
;   word[36000000..36012288)       parsed machines (128 * 96 bytes)
;   word[36200000..36210240)       parsed blocks (128 * 80 bytes)
;   word[36300000..36300032)       loop block-parameter scratch
;   byte[37000000..37524287]       independently rebuilt OMGRSW1

proc v4b_frame_byte(index) { return byte[30000000+index] }
proc v4b_comp_byte(index) { return v4b_frame_byte(word[29000024]+index) }
proc v4b_witness_byte(index) { return v4b_frame_byte(word[29000040]+index) }
proc v4b_source_byte(index) { return v4b_comp_byte(word[29001040]+index) }

proc v4b_reject() {
    state set { to done when (word[29000008]!=0) word[29000008]=251 }
    state done { return word[29000008] }
}
proc v4b_exhaust() { word[29000008]=252 return 252 }

proc v4b_frame_u32(at) {
    return v4b_frame_byte(at)+v4b_frame_byte(at+1)*256
        +v4b_frame_byte(at+2)*65536+v4b_frame_byte(at+3)*16777216
}

proc v4b_read_frame() {
    let n=0 let overflow=0 let c=read_byte()
    state read { to one when (c>=0) to header }
    state one { to over when (n>=4497544) byte[30000000+n]=c n=n+1 c=read_byte() to read }
    state over { overflow=1 c=read_byte() to read }
    state header { to exhausted when (overflow==1) to bad when (n<40) to magic }
    state magic {
        to bad when (v4b_frame_byte(0)!='O') to bad when (v4b_frame_byte(1)!='M')
        to bad when (v4b_frame_byte(2)!='G') to bad when (v4b_frame_byte(3)!='R')
        to bad when (v4b_frame_byte(4)!='F') to bad when (v4b_frame_byte(5)!='N')
        to bad when (v4b_frame_byte(6)!='4') to bad when (v4b_frame_byte(7)!=0)
        to bad when (v4b_frame_u32(8)!=4)
        word[29000016]=v4b_frame_u32(12) word[29000032]=v4b_frame_u32(16)
        word[29000048]=v4b_frame_u32(20) word[29000056]=v4b_frame_u32(24)
        word[29000064]=v4b_frame_u32(28) word[29000072]=v4b_frame_u32(32)
        word[29000080]=v4b_frame_u32(36)
        to bad when (word[29000016]!=1) to bad when (word[29000032]<1) to bad when (word[29000048]<1)
        to exhausted when (word[29000032]>267280) to exhausted when (word[29000048]>524288)
        to exhausted when (word[29000056]>2522192) to exhausted when (word[29000064]>1183744)
        word[29000024]=40 to bad when (word[29000032]>n-40)
        word[29000040]=40+word[29000032] to bad when (word[29000048]>n-word[29000040])
        word[29000088]=word[29000040]+word[29000048] to bad when (word[29000056]>n-word[29000088])
        word[29000096]=word[29000088]+word[29000056] to bad when (word[29000064]!=n-word[29000096])
        to bad when (word[29000064]<1) to bad when (word[29000080]>255)
        to bad when (word[29000080]!=word[29000072]%256) return 0
    }
    state exhausted { return v4b_exhaust() }
    state bad { return v4b_reject() }
}

proc v4b_comp_u32(at) {
    return v4b_comp_byte(at)+v4b_comp_byte(at+1)*256
        +v4b_comp_byte(at+2)*65536+v4b_comp_byte(at+3)*16777216
}

proc v4b_decode_compilation() {
    let n=word[29000032] let at=0 let i=0 let string_bytes=0 let bundle=0 let label=0 let content=0
    state size { to bad when (n<132) to magic }
    state magic {
        to bad when (v4b_comp_byte(0)!='O') to bad when (v4b_comp_byte(1)!='M')
        to bad when (v4b_comp_byte(2)!='G') to bad when (v4b_comp_byte(3)!='C')
        to bad when (v4b_comp_byte(4)!='O') to bad when (v4b_comp_byte(5)!='M')
        to bad when (v4b_comp_byte(6)!='P') to bad when (v4b_comp_byte(7)!=0)
        to bad when (v4b_comp_u32(16)!=n) to bad when (v4b_comp_u32(32)!=1)
        to bad when (v4b_comp_u32(36)!=1) to bad when (v4b_comp_u32(40)!=0)
        to bad when (v4b_comp_u32(44)!=0) to bad when (v4b_comp_u32(48)!=0)
        to bad when (v4b_comp_u32(60)!=0)
        word[29001000]=v4b_comp_u32(20) string_bytes=v4b_comp_u32(24) word[29001008]=v4b_comp_u32(28)
        word[29001016]=v4b_comp_u32(52) word[29001024]=v4b_comp_u32(56)
        to bad when (word[29001008]<1) to exhausted when (word[29001008]>64)
        ; One package row and one source row, no aliases.
        to bad when (v4b_comp_u32(64)!=0) to bad when (v4b_comp_u32(100)!=0)
        to bad when (v4b_comp_u32(104)!=1) to bad when (v4b_comp_u32(108)!=0)
        to bad when (v4b_comp_u32(112)!=0) to bad when (v4b_comp_u32(116)!=0)
        to bad when (v4b_comp_u32(120)!=0) to bad when (v4b_comp_u32(128)!=0)
        word[29001032]=v4b_comp_u32(124) at=132 i=0 to strings
    }
    state strings { to string_row when (i<word[29001008]) bundle=at to bundle_extent }
    state string_row { to bad when (at>n-4) content=v4b_comp_u32(at) to bad when (content>n-at-4) word[29002000+i*16]=at+4 word[29002008+i*16]=content at=at+4+content i=i+1 to strings }
    state bundle_extent { to bad when (at!=132+string_bytes) to bad when (word[29001000]!=n-at) to bad when (word[29001000]<24) to bundle_magic }
    state bundle_magic {
        to bad when (v4b_comp_byte(bundle)!='O') to bad when (v4b_comp_byte(bundle+1)!='M')
        to bad when (v4b_comp_byte(bundle+2)!='G') to bad when (v4b_comp_byte(bundle+3)!='0')
        to bad when (v4b_comp_byte(bundle+4)!='B') to bad when (v4b_comp_byte(bundle+5)!='N')
        to bad when (v4b_comp_byte(bundle+6)!='D') to bad when (v4b_comp_byte(bundle+7)!='L')
        to bad when (v4b_comp_u32(bundle+8)!=1) to bad when (v4b_comp_u32(bundle+12)!=1)
        at=bundle+16 to row
    }
    state row { label=v4b_comp_u32(at) content=v4b_comp_u32(at+4) to exhausted when (label>64) to exhausted when (content>131072) to bad when (label<1) to bad when (label>n-at-8) to bad when (content!=n-at-8-label) word[29001040]=at+8+label word[29001048]=content return 0 }
    state exhausted { return v4b_exhaust() }
    state bad { return v4b_reject() }
}

proc v4b_wit_u32(at) {
    return v4b_witness_byte(at)+v4b_witness_byte(at+1)*256
        +v4b_witness_byte(at+2)*65536+v4b_witness_byte(at+3)*16777216
}

proc v4b_decode_witness() {
    let i=0 let at=72 let size=0
    state fixed {
        to bad when (word[29000048]<72)
        to bad when (v4b_witness_byte(0)!='O') to bad when (v4b_witness_byte(1)!='M')
        to bad when (v4b_witness_byte(2)!='G') to bad when (v4b_witness_byte(3)!='R')
        to bad when (v4b_witness_byte(4)!='S') to bad when (v4b_witness_byte(5)!='W')
        to bad when (v4b_witness_byte(6)!='1') to bad when (v4b_witness_byte(7)!=0)
        to bad when (v4b_witness_byte(8)!=1) to bad when (v4b_witness_byte(9)!=0)
        to bad when (v4b_witness_byte(14)!=72) to bad when (v4b_witness_byte(15)!=0)
        to bad when (v4b_wit_u32(16)!=word[29000048])
        i=0 to counts
    }
    state counts { to count_one when (i<11) to selected }
    state count_one { word[29003000+i*8]=v4b_wit_u32(20+i*4) i=i+1 to counts }
    state selected { to bad when (v4b_wit_u32(64)!=0) to bad when (v4b_wit_u32(68)!=0) to exact }
    state exact {
        size=72+word[29003000]*36+word[29003008]*48+word[29003016]*28+word[29003024]*28
            +word[29003032]*24+word[29003040]*24+word[29003048]*24+word[29003056]*40
            +word[29003064]*24+word[29003072]*40+word[29003080]*24
        to bad when (size!=word[29000048])
        word[29003100]=72
        word[29003108]=word[29003100]+word[29003000]*36
        word[29003116]=word[29003108]+word[29003008]*48
        word[29003124]=word[29003116]+word[29003016]*28
        word[29003132]=word[29003124]+word[29003024]*28
        word[29003140]=word[29003132]+word[29003032]*24
        word[29003148]=word[29003140]+word[29003040]*24
        word[29003156]=word[29003148]+word[29003048]*24
        word[29003164]=word[29003156]+word[29003056]*40
        word[29003172]=word[29003164]+word[29003064]*24
        word[29003180]=word[29003172]+word[29003072]*40 return 0
    }
    state bad { return v4b_reject() }
}

proc v4b_ident_start(c) {
    state us { to yes when (c=='_') to upper0 }
    state upper0 { to upper1 when (c>='A') to lower0 }
    state upper1 { to yes when (c<='Z') to lower0 }
    state lower0 { to lower1 when (c>='a') return 0 }
    state lower1 { to yes when (c<='z') return 0 }
    state yes { return 1 }
}
proc v4b_ident_continue(c) {
    state ident { to yes when (v4b_ident_start(c)==1) to digit0 }
    state digit0 { to digit1 when (c>='0') return 0 }
    state digit1 { to yes when (c<='9') return 0 }
    state yes { return 1 }
}

proc v4b_lex_next() {
    let p=word[29004000] let n=word[29001048] let c=0 let start=0
    state skip { to eof when (p>=n) c=v4b_source_byte(p) to whitespace when (c==' ') to whitespace when (c==9) to whitespace when (c==10) to whitespace when (c==13) start=p to ident when (v4b_ident_start(c)==1) to digit0 when (c>='0') to punctuation }
    state whitespace { p=p+1 to skip }
    state digit0 { to number when (c<='9') to punctuation }
    state ident { p=p+1 to ident_loop }
    state ident_loop { to save_ident when (p>=n) c=v4b_source_byte(p) to save_ident when (v4b_ident_continue(c)==0) p=p+1 to ident_loop }
    state save_ident { word[29004008]=256 word[29004016]=start word[29004024]=p-start word[29004000]=p return 0 }
    state number { p=p+1 to number_loop }
    state number_loop { to save_number when (p>=n) c=v4b_source_byte(p) to save_number when (c<'0') to save_number when (c>'9') p=p+1 to number_loop }
    state save_number { word[29004008]=257 word[29004016]=start word[29004024]=p-start word[29004000]=p return 0 }
    state punctuation { to bad when (c>=128) word[29004008]=c word[29004016]=p word[29004024]=1 word[29004000]=p+1 return 0 }
    state eof { word[29004008]=4294967295 word[29004016]=n word[29004024]=0 return 0 }
    state bad { return v4b_reject() }
}

; Keyword codes: module,data,machine,mut,self,u32,transition,state,true,in,Trapping.
proc v4b_init_words() {
    ; moduledatamachinemutselfu32transitionstatetrue
    byte[35900000]=109 byte[35900001]=111 byte[35900002]=100 byte[35900003]=117 byte[35900004]=108 byte[35900005]=101
    byte[35900006]=100 byte[35900007]=97 byte[35900008]=116 byte[35900009]=97
    byte[35900010]=109 byte[35900011]=97 byte[35900012]=99 byte[35900013]=104 byte[35900014]=105 byte[35900015]=110 byte[35900016]=101
    byte[35900017]=109 byte[35900018]=117 byte[35900019]=116
    byte[35900020]=115 byte[35900021]=101 byte[35900022]=108 byte[35900023]=102
    byte[35900024]=117 byte[35900025]=51 byte[35900026]=50
    byte[35900027]=116 byte[35900028]=114 byte[35900029]=97 byte[35900030]=110 byte[35900031]=115 byte[35900032]=105 byte[35900033]=116 byte[35900034]=105 byte[35900035]=111 byte[35900036]=110
    byte[35900037]=115 byte[35900038]=116 byte[35900039]=97 byte[35900040]=116 byte[35900041]=101
    byte[35900042]=116 byte[35900043]=114 byte[35900044]=117 byte[35900045]=101
    byte[35900046]=105 byte[35900047]=110
    byte[35900048]=84 byte[35900049]=114 byte[35900050]=97 byte[35900051]=112 byte[35900052]=112 byte[35900053]=105 byte[35900054]=110 byte[35900055]=103 return 0
}

proc v4b_word_start(code) {
    state c0 { to x0 when (code==0) to c1 } state x0 { return 0 }
    state c1 { to x1 when (code==1) to c2 } state x1 { return 6 }
    state c2 { to x2 when (code==2) to c3 } state x2 { return 10 }
    state c3 { to x3 when (code==3) to c4 } state x3 { return 17 }
    state c4 { to x4 when (code==4) to c5 } state x4 { return 20 }
    state c5 { to x5 when (code==5) to c6 } state x5 { return 24 }
    state c6 { to x6 when (code==6) to c7 } state x6 { return 27 }
    state c7 { to x7 when (code==7) to c8 } state x7 { return 37 }
    state c8 { to x8 when (code==8) to c9 } state x8 { return 42 }
    state c9 { to x9 when (code==9) return 48 } state x9 { return 46 }
}
proc v4b_word_len(code) {
    state c0 { to x0 when (code==0) to c1 } state x0 { return 6 }
    state c1 { to x1 when (code==1) to c2 } state x1 { return 4 }
    state c2 { to x2 when (code==2) to c3 } state x2 { return 7 }
    state c3 { to x3 when (code==3) to c4 } state x3 { return 3 }
    state c4 { to x4 when (code==4) to c5 } state x4 { return 4 }
    state c5 { to x5 when (code==5) to c6 } state x5 { return 3 }
    state c6 { to x6 when (code==6) to c7 } state x6 { return 10 }
    state c7 { to x7 when (code==7) to c8 } state x7 { return 5 }
    state c8 { to x8 when (code==8) to c9 } state x8 { return 4 }
    state c9 { to x9 when (code==9) return 8 } state x9 { return 2 }
}

proc v4b_is_word(code) {
    let i=0 let n=v4b_word_len(code) let at=v4b_word_start(code)
    state kind { to no when (word[29004008]!=256) to length }
    state length { to no when (word[29004024]!=n) to loop }
    state loop { to one when (i<n) return 1 }
    state one { to no when (v4b_source_byte(word[29004016]+i)!=byte[35900000+at+i]) i=i+1 to loop }
    state no { return 0 }
}

proc v4b_expect_kind(kind) {
    state check { to bad when (word[29004008]!=kind) v4b_lex_next() return 0 }
    state bad { return v4b_reject() }
}
proc v4b_expect_word(code) {
    state check { to bad when (v4b_is_word(code)==0) v4b_lex_next() return 0 }
    state bad { return v4b_reject() }
}

proc v4b_span_equal(a_start,a_length,b_start,b_length) {
    let i=0
    state length { to no when (a_length!=b_length) to loop }
    state loop { to one when (i<a_length) return 1 }
    state one { to no when (v4b_source_byte(a_start+i)!=v4b_source_byte(b_start+i)) i=i+1 to loop }
    state no { return 0 }
}
proc v4b_span_string(start,length,string_id) {
    let i=0
    state length { to no when (length!=word[29002008+string_id*16]) to loop }
    state loop { to one when (i<length) return 1 }
    state one { to no when (v4b_source_byte(start+i)!=v4b_comp_byte(word[29002000+string_id*16]+i)) i=i+1 to loop }
    state no { return 0 }
}
proc v4b_number() {
    let i=0 let value=0 let c=0
    state kind { to bad when (word[29004008]!=257) to loop }
    state loop { to one when (i<word[29004024]) word[29004032]=value v4b_lex_next() return 0 }
    state one { c=v4b_source_byte(word[29004016]+i) to bad when (value>214748364) value=value*10+c-'0' to bad when (value>2147483647) i=i+1 to loop }
    state bad { return v4b_reject() }
}

proc v4b_add_block(machine,ordinal,name_start,name_length) {
    let id=word[29005008] let at=0
    state cap { to exhausted when (id>=128) at=36200000+id*80 to save }
    state save { word[at]=machine word[at+8]=ordinal word[at+32]=name_start word[at+40]=name_length word[at+48]=word[29005016] word[at+56]=0 word[29005008]=id+1 word[29005080]=id return 0 }
    state exhausted { return v4b_exhaust() }
}

proc v4b_parse_loop(machine,entry_block) {
    let block=0 let start=0 let length=0
    state transition { to bad when (v4b_expect_word(6)!=0) to entry_open }
    state entry_open { to bad when (v4b_expect_kind(123)!=0) to wildcard }
    state wildcard { to bad when (v4b_expect_kind(256)!=0) to dash }
    state dash { to bad when (v4b_expect_kind(45)!=0) to arrow }
    state arrow { to bad when (v4b_expect_kind(62)!=0) start=word[29004016] length=word[29004024] to target }
    state target { to bad when (v4b_expect_kind(256)!=0) word[29005200]=start word[29005208]=length to target_open }
    state target_open { to bad when (v4b_expect_kind(40)!=0) to zero }
    state zero { to bad when (v4b_number()!=0) to bad when (word[29004032]!=0) to target_close }
    state target_close { to bad when (v4b_expect_kind(41)!=0) to entry_close }
    state entry_close { to bad when (v4b_expect_kind(125)!=0) word[36200024+entry_block*80]=word[29004016] to state_keyword }
    state state_keyword { to bad when (v4b_expect_word(7)!=0) start=word[29004016] length=word[29004024] to state_name }
    state state_name { to bad when (v4b_expect_kind(256)!=0) to bad when (v4b_span_equal(start,length,word[29005200],word[29005208])==0) word[29005216]=start word[29005224]=length v4b_add_block(machine,1,start,length) block=word[29005080] to state_paren }
    state state_paren { to bad when (v4b_expect_kind(40)!=0) to amp }
    state amp { to bad when (v4b_expect_kind(38)!=0) to mut }
    state mut { to bad when (v4b_expect_word(3)!=0) to self }
    state self { to bad when (v4b_expect_word(4)!=0) to comma }
    state comma { to bad when (v4b_expect_kind(44)!=0) start=word[29004016] length=word[29004024] to param }
    state param { to bad when (v4b_expect_kind(256)!=0) word[29005232]=start word[29005240]=length to colon }
    state colon { to bad when (v4b_expect_kind(58)!=0) to u32 }
    state u32 { to bad when (v4b_expect_word(5)!=0) to in }
    state in { to bad when (v4b_expect_word(9)!=0) to trapping }
    state trapping { to bad when (v4b_expect_word(10)!=0) to state_close_paren }
    state state_close_paren { to bad when (v4b_expect_kind(41)!=0) to state_open }
    state state_open { to bad when (v4b_expect_kind(123)!=0) word[36200016+block*80]=word[29004016] word[36300000]=block word[36300008]=0 word[36300016]=word[29005232] word[36300024]=word[29005240] word[29005016]=1 word[36200056+block*80]=1 to body_transition }
    state body_transition { to bad when (v4b_expect_word(6)!=0) to bad when (v4b_span_equal(word[29004016],word[29004024],word[29005232],word[29005240])==0) to index }
    state index { to bad when (v4b_expect_kind(256)!=0) to less }
    state less { to bad when (v4b_expect_kind(60)!=0) to bound }
    state bound { to bad when (v4b_number()!=0) word[29005032]=word[29004032] to transition_open }
    state transition_open { to bad when (v4b_expect_kind(123)!=0) to true }
    state true { to bad when (v4b_expect_word(8)!=0) to true_dash }
    state true_dash { to bad when (v4b_expect_kind(45)!=0) to true_arrow }
    state true_arrow { to bad when (v4b_expect_kind(62)!=0) to bad when (v4b_span_equal(word[29004016],word[29004024],word[29005216],word[29005224])==0) to true_target }
    state true_target { to bad when (v4b_expect_kind(256)!=0) to true_open }
    state true_open { to bad when (v4b_expect_kind(40)!=0) to bad when (v4b_span_equal(word[29004016],word[29004024],word[29005232],word[29005240])==0) to true_index }
    state true_index { to bad when (v4b_expect_kind(256)!=0) to plus }
    state plus { to bad when (v4b_expect_kind(43)!=0) to one }
    state one { to bad when (v4b_number()!=0) to bad when (word[29004032]!=1) to true_close }
    state true_close { to bad when (v4b_expect_kind(41)!=0) to false_arm }
    state false_arm { to bad when (v4b_expect_kind(256)!=0) to false_dash }
    state false_dash { to bad when (v4b_expect_kind(45)!=0) to false_arrow }
    state false_arrow { to bad when (v4b_expect_kind(62)!=0) start=word[29004016] length=word[29004024] to false_target }
    state false_target { to bad when (v4b_expect_kind(256)!=0) word[29005248]=start word[29005256]=length to false_open }
    state false_open { to bad when (v4b_expect_kind(40)!=0) to false_close }
    state false_close { to bad when (v4b_expect_kind(41)!=0) to transition_close }
    state transition_close { to bad when (v4b_expect_kind(125)!=0) to state_body_close }
    state state_body_close { word[36200024+block*80]=word[29004016] to bad when (v4b_expect_kind(125)!=0) to pass_keyword }
    state pass_keyword { to bad when (v4b_expect_word(7)!=0) start=word[29004016] length=word[29004024] to pass_name }
    state pass_name { to bad when (v4b_expect_kind(256)!=0) to bad when (v4b_span_equal(start,length,word[29005248],word[29005256])==0) v4b_add_block(machine,2,start,length) block=word[29005080] to pass_paren }
    state pass_paren { to bad when (v4b_expect_kind(40)!=0) to pass_amp }
    state pass_amp { to bad when (v4b_expect_kind(38)!=0) to pass_mut }
    state pass_mut { to bad when (v4b_expect_word(3)!=0) to pass_self }
    state pass_self { to bad when (v4b_expect_word(4)!=0) to pass_close_paren }
    state pass_close_paren { to bad when (v4b_expect_kind(41)!=0) to pass_open }
    state pass_open { to bad when (v4b_expect_kind(123)!=0) word[36200016+block*80]=word[29004016] to pass_value }
    state pass_value { to bad when (v4b_number()!=0) to bad when (word[29004032]!=70) word[29005040]=70 word[36200024+block*80]=word[29004016] to pass_close }
    state pass_close { to bad when (v4b_expect_kind(125)!=0) to machine_close }
    state machine_close { to bad when (v4b_expect_kind(125)!=0) return 0 }
    state bad { return v4b_reject() }
}

proc v4b_parse_machine() {
    let id=word[29005000] let at=0 let owner_start=0 let owner_length=0 let name_start=0 let name_length=0 let block=0
    state cap { to exhausted when (id>=128) at=36000000+id*96 to keyword }
    state keyword { to bad when (v4b_expect_word(2)!=0) owner_start=word[29004016] owner_length=word[29004024] to owner }
    state owner { to bad when (v4b_expect_kind(256)!=0) to bad when (v4b_span_equal(owner_start,owner_length,word[29005116],word[29005124])==0) to colon0 }
    state colon0 { to bad when (v4b_expect_kind(58)!=0) to colon1 }
    state colon1 { to bad when (v4b_expect_kind(58)!=0) name_start=word[29004016] name_length=word[29004024] to name }
    state name { to bad when (v4b_expect_kind(256)!=0) word[at]=owner_start word[at+8]=owner_length word[at+16]=name_start word[at+24]=name_length word[at+32]=4294967295 word[at+40]=0 word[at+48]=4294967295 word[at+56]=4294967295 word[at+64]=word[29005008] to paren }
    state paren { to bad when (v4b_expect_kind(40)!=0) to amp }
    state amp { to bad when (v4b_expect_kind(38)!=0) to mut }
    state mut { to bad when (v4b_expect_word(3)!=0) to self }
    state self { to bad when (v4b_expect_word(4)!=0) to close_paren }
    state close_paren { to bad when (v4b_expect_kind(41)!=0) to dash }
    state dash { to bad when (v4b_expect_kind(45)!=0) to arrow }
    state arrow { to bad when (v4b_expect_kind(62)!=0) to result }
    state result { to bad when (v4b_expect_word(5)!=0) to open }
    state open { to bad when (v4b_expect_kind(123)!=0) v4b_add_block(id,0,4294967295,0) block=word[29005080] word[36200016+block*80]=word[29004016] to body }
    state body { to call when (v4b_is_word(4)==1) to loop when (v4b_is_word(6)==1) to literal when (word[29004008]==257) to bad }
    state call { v4b_expect_word(4) to bad when (word[29000008]!=0) to dot }
    state dot { to bad when (v4b_expect_kind(46)!=0) word[at+32]=word[29004016] word[at+40]=word[29004024] to call_name }
    state call_name { to bad when (v4b_expect_kind(256)!=0) to call_open }
    state call_open { to bad when (v4b_expect_kind(40)!=0) to call_close }
    state call_close { to bad when (v4b_expect_kind(41)!=0) word[36200024+block*80]=word[29004016] to close }
    state literal { v4b_number() to bad when (word[29000008]!=0) word[at+56]=word[29004032] word[36200024+block*80]=word[29004016] to close }
    state close { to bad when (v4b_expect_kind(125)!=0) word[at+72]=1 word[29005000]=id+1 return 0 }
    state loop { to bad when (id!=0) word[29005024]=2 v4b_parse_loop(id,block) to bad when (word[29000008]!=0) word[at+56]=70 word[at+72]=3 word[29005000]=1 return 0 }
    state exhausted { return v4b_exhaust() }
    state bad { return v4b_reject() }
}

proc v4b_parse_source() {
    let start=0 let length=0
    word[29004000]=0 word[29005000]=0 word[29005008]=0 word[29005016]=0 word[29005024]=1
    v4b_init_words() v4b_lex_next()
    state module { to bad when (v4b_expect_word(0)!=0) start=word[29004016] length=word[29004024] to module_name }
    state module_name { to bad when (v4b_expect_kind(256)!=0) word[29005100]=start word[29005108]=length to bad when (v4b_span_string(start,length,word[29001032])==0) to module_semi }
    state module_semi { to bad when (v4b_expect_kind(59)!=0) to data }
    state data { to bad when (v4b_expect_word(1)!=0) start=word[29004016] length=word[29004024] to data_name }
    state data_name { to bad when (v4b_expect_kind(256)!=0) word[29005116]=start word[29005124]=length to data_open }
    state data_open { to bad when (v4b_expect_kind(123)!=0) to data_close }
    state data_close { to bad when (v4b_expect_kind(125)!=0) to machines }
    state machines { to done when (word[29004008]==4294967295) to bad when (v4b_is_word(2)==0) v4b_parse_machine() to bad when (word[29000008]!=0) to machines }
    state done { to bad when (word[29005000]<1) to bad when (v4b_span_string(word[36000000],word[36000008],word[29001016])==0) to bad when (v4b_span_string(word[36000016],word[36000024],word[29001024])==0) return 0 }
    state bad { return v4b_reject() }
}

proc v4b_resolve_calls() {
    let i=0 let j=0 let found=0 let at=0
    state mode { to loop when (word[29005024]==2) to chain }
    state chain { to one when (i<word[29005000]) return 0 }
    state one { at=36000000+i*96 to terminal when (word[at+32]==4294967295) found=0 j=0 to search }
    state search { to candidate when (j<word[29005000]) to bad when (found!=1) to bad when (word[at+48]!=i+1) i=i+1 to chain }
    state candidate { to next when (v4b_span_equal(word[at+32],word[at+40],word[36000016+j*96],word[36000024+j*96])==0) found=found+1 word[at+48]=j to next }
    state next { j=j+1 to search }
    state terminal { to bad when (i+1!=word[29005000]) to bad when (word[at+56]!=70) i=i+1 to chain }
    state loop { to bad when (word[29005000]!=1) to bad when (word[29005008]!=3) to bad when (word[29005016]!=1) return 0 }
    state bad { return v4b_reject() }
}

proc v4b_put_byte(value) { byte[37000000+word[29006000]]=value word[29006000]=word[29006000]+1 return value }
proc v4b_put_u16(value) { v4b_put_byte(value%256) v4b_put_byte((value/256)%256) return value }
proc v4b_put_u32(value) { v4b_put_byte(value%256) v4b_put_byte((value/256)%256) v4b_put_byte((value/65536)%256) v4b_put_byte((value/16777216)%256) return value }

proc v4b_emit_header_unit() {
    let machines=word[29005000] let bindings=0 let types=3 let bparams=0 let length=0
    bindings=machines*2-1
    state mode { to loop when (word[29005024]==2) to counts }
    state loop { bindings=1 types=4 bparams=1 to counts }
    state counts {
        length=72+36+bindings*28+(machines+1)*28+types*24+24+machines*40+word[29005008]*40+bparams*24
        word[29006008]=bindings word[29006016]=types word[29006024]=length
        v4b_put_byte('O') v4b_put_byte('M') v4b_put_byte('G') v4b_put_byte('R') v4b_put_byte('S') v4b_put_byte('W') v4b_put_byte('1') v4b_put_byte(0)
        v4b_put_u16(1) v4b_put_u16(0) v4b_put_u16(0) v4b_put_u16(72) v4b_put_u32(length)
        v4b_put_u32(1) v4b_put_u32(0) v4b_put_u32(bindings) v4b_put_u32(machines+1)
        v4b_put_u32(types) v4b_put_u32(1) v4b_put_u32(0) v4b_put_u32(machines)
        v4b_put_u32(0) v4b_put_u32(word[29005008]) v4b_put_u32(bparams) v4b_put_u32(0) v4b_put_u32(0)
        ; One unit, no imports, all declarations.
        v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(word[29001032])
        v4b_put_u32(word[29005100]) v4b_put_u32(word[29005108])
        v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(machines+1) return 0
    }
}

proc v4b_emit_bindings() {
    let i=0 let id=0 let at=0 let target=0
    state machines { to machine when (i<word[29005000]) return 0 }
    state machine { at=36000000+i*96 v4b_put_u32(id) v4b_put_u32(0) v4b_put_byte(2) v4b_put_byte(1) v4b_put_u16(0) v4b_put_u32(word[at]) v4b_put_u32(word[at+8]) v4b_put_u32(0) v4b_put_u32(4294967295) id=id+1 to call_check }
    state call_check { to next when (word[at+32]==4294967295) target=word[at+48] v4b_put_u32(id) v4b_put_u32(0) v4b_put_byte(3) v4b_put_byte(2) v4b_put_u16(0) v4b_put_u32(word[at+32]) v4b_put_u32(word[at+40]) v4b_put_u32(1+target) v4b_put_u32(4294967295) id=id+1 to next }
    state next { i=i+1 to machines }
}

proc v4b_emit_declarations_types() {
    let i=0 let at=0
    ; Record declaration then machines in authored order.
    v4b_put_u32(0) v4b_put_byte(1) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(0) v4b_put_u32(0)
    v4b_put_u32(word[29005116]) v4b_put_u32(word[29005124]) v4b_put_u32(0)
    state declarations { to declaration when (i<word[29005000]) i=0 to types }
    state declaration { at=36000000+i*96 v4b_put_u32(i+1) v4b_put_byte(2) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(0) v4b_put_u32(i+1) v4b_put_u32(word[at+16]) v4b_put_u32(word[at+24]) v4b_put_u32(i) i=i+1 to declarations }
    state types {
        ; Nominal Probe, canonical bool, canonical full u32.
        v4b_put_u32(0) v4b_put_byte(4) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0)
        v4b_put_u32(1) v4b_put_byte(3) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(1)
        v4b_put_u32(2) v4b_put_byte(2) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(2147483647)
        to trap_type when (word[29005024]==2) to record
    }
    state trap_type { v4b_put_u32(3) v4b_put_byte(2) v4b_put_byte(1) v4b_put_u16(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(2147483647) to record }
    state record { v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(0) v4b_put_byte(0) v4b_put_byte(0) v4b_put_byte(0) v4b_put_byte(0) return 0 }
}

proc v4b_emit_machines_blocks() {
    let i=0 let at=0
    state machines { to machine when (i<word[29005000]) i=0 to blocks }
    state machine { at=36000000+i*96 v4b_put_u32(i) v4b_put_u32(i+1) v4b_put_u32(0) v4b_put_byte(2) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(2) v4b_put_u32(0) v4b_put_u32(0) v4b_put_u32(word[at+64]) v4b_put_u32(word[at+72]) v4b_put_u32(word[at+64]) i=i+1 to machines }
    state blocks { to block when (i<word[29005008]) to bparam }
    state block { at=36200000+i*80 v4b_put_u32(i) v4b_put_u32(word[at]) v4b_put_u32(word[at+8]) v4b_put_byte(2) v4b_put_byte(0) v4b_put_u16(0) v4b_put_u32(word[at+16]) v4b_put_u32(word[at+24]) v4b_put_u32(word[at+32]) v4b_put_u32(word[at+40]) v4b_put_u32(word[at+48]) v4b_put_u32(word[at+56]) i=i+1 to blocks }
    state bparam { to done when (word[29005024]!=2) v4b_put_u32(0) v4b_put_u32(word[36300000]) v4b_put_u32(0) v4b_put_u32(3) v4b_put_u32(word[36300016]) v4b_put_u32(word[36300024]) to done }
    state done { return 0 }
}

proc v4b_compare_witness() {
    let i=0
    state length { to bad when (word[29006000]!=word[29000048]) to loop }
    state loop { to one when (i<word[29006000]) return 0 }
    state one { to bad when (byte[37000000+i]!=v4b_witness_byte(i)) i=i+1 to loop }
    state bad { return v4b_reject() }
}

proc v4b_rebuild_witness() {
    word[29006000]=0 v4b_emit_header_unit() v4b_emit_bindings() v4b_emit_declarations_types() v4b_emit_machines_blocks()
    return v4b_compare_witness()
}

; Incremented immediately before every dynamic block body.  An already-full
; counter means this is the 65,537th attempted entry and selects exhaustion.
proc v4b_enter_block() {
    state bound { to exhausted when (word[29007008]>=65536) word[29007008]=word[29007008]+1 return 0 }
    state exhausted { return v4b_exhaust() }
}

; `depth` is zero-based before entry: root depth zero counts as active frame 1.
proc v4b_eval_chain(machine,depth) {
    let at=36000000+machine*96 let status=0
    state depth { to exhausted when (depth>=16) status=v4b_enter_block() to entered }
    state entered { to done when (status!=0) to terminal when (word[at+32]==4294967295) status=v4b_eval_chain(word[at+48],depth+1) to done }
    state terminal { word[29007016]=word[at+56] return 0 }
    state exhausted { return v4b_exhaust() }
    state done { return status }
}

proc v4b_eval_loop() {
    let index=0 let status=0
    ; Selected machine entry body.
    status=v4b_enter_block()
    state root { to done when (status!=0) to loop_entry }
    state loop_entry { status=v4b_enter_block() to done when (status!=0) to test }
    state test { to pass when (index>=word[29005032]) index=index+1 to loop_entry }
    state pass { status=v4b_enter_block() to done when (status!=0) word[29007016]=70 return 0 }
    state done { return status }
}

proc v4b_evaluate() {
    let status=0
    word[29007008]=0 word[29007016]=4294967295
    state mode { to loop when (word[29005024]==2) status=v4b_eval_chain(0,0) to result }
    state loop { status=v4b_eval_loop() to result }
    state result { to done when (status!=0) to bad when (word[29007016]!=word[29000072]) to bad when (word[29007016]%256!=word[29000080]) return 0 }
    state bad { return v4b_reject() }
    state done { return status }
}

proc main() {
    let status=0
    word[29000008]=0
    status=v4b_read_frame()
    state frame { to done when (status!=0) status=v4b_decode_compilation() to compilation }
    state compilation { to done when (status!=0) status=v4b_decode_witness() to witness }
    state witness { to done when (status!=0) status=v4b_parse_source() to source }
    state source { to done when (status!=0) status=v4b_resolve_calls() to resolved }
    state resolved { to done when (status!=0) status=v4b_rebuild_witness() to rebuilt }
    state rebuilt { to done when (status!=0) status=v4b_evaluate() to done }
    state done { return status }
}
