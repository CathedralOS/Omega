; OMGRFN4 responsibility-4 source aggregate -> constant graph/root binding.
; Compose with the locally safe source/witness model and the constant parsing
; procedures from omgrfn4-resolved-body-lowering.beta. This executable owns
; the proposition deliberately opaque in omgrfn4-operation-lowering.beta:
; every aggregate assignment, in exact machine/block/statement order, selects
; its independently source-derived canonical node in the corresponding
; opcode-11 row. It reads no ELF/result claim and publishes no bytes.

; Root correspondence needs names, aggregate types, and body spans, but never
; layouts or parameters.  Its tailored loader range-checks each index it uses;
; the operation companion runs the full partition loader.
proc v4_root_model_load() {
    let i=0 let row=0 let kind=0 let target=0 let source=0 let owner=0
    let start=0 let count=0 let cursor=0 let blocks=0 let block_count=0 let state_id=0
    state declarations { to declaration when (i<l4_count(3)) i=0 to types }
    state declaration {
        row=l4_base(3)+i*28 kind=l4_wbyte(row+4) source=l4_wu32(row+8)
        start=l4_wu32(row+16) count=l4_wu32(row+20) target=l4_wu32(row+24)
        to bad when (l4_wu32(row)!=i) to bad when (source>=l4_count(0))
        to bad when (count<1) to bad when (l4_source_span_ok(source,start,count)==0)
        to record_decl when (kind==1) to machine_decl when (kind==2) to bad
    }
    state record_decl { to bad when (target>=l4_count(5)) word[534512+target*8]=source src_record_set(target,0,l4_named_span(source,start)) src_record_set(target,1,count) i=i+1 to declarations }
    state machine_decl { to bad when (target>=l4_count(7)) word[535512+target*8]=source i=i+1 to declarations }
    state types { to type when (i<l4_count(4)) i=0 cursor=0 to records }
    state type {
        row=l4_base(4)+i*24 kind=l4_wbyte(row+4) target=l4_wu32(row+8) count=l4_wu32(row+12)
        to bad when (l4_wu32(row)!=i) to bad when (kind<1) to bad when (kind>5)
        to nominal when (kind==4) to array when (kind==5) to save_type
    }
    state nominal { to bad when (target>=l4_count(5)) to save_type }
    state array { to bad when (target>=l4_count(4)) to save_type }
    state save_type {
        src_type_set(i,0,kind) src_type_set(i,3,target) src_type_set(i,4,target)
        src_type_set(i,5,count) src_type_set(i,7,l4_wu32(row+16)) src_type_set(i,8,l4_wu32(row+20))
        i=i+1 to types
    }
    state records { to record when (i<l4_count(5)) i=0 to record_exact }
    state record {
        row=l4_base(5)+i*24 target=l4_wu32(row+8) start=l4_wu32(row+12) count=l4_wu32(row+16)
        to bad when (l4_wu32(row)!=i) to bad when (target>=l4_count(4))
        to bad when (src_type(target,0)!=4) to bad when (src_type(target,3)!=i)
        to bad when (start!=cursor) to bad when (count>l4_count(6)-cursor) to bad when (count>64)
        src_record_set(i,3,start) src_record_set(i,4,count) src_record_set(i,8,target)
        cursor=cursor+count i=i+1 to records
    }
    state record_exact { to bad when (cursor!=l4_count(6)) i=0 to fields }
    state fields { to field when (i<l4_count(6)) i=0 cursor=0 to machines }
    state field {
        row=l4_base(6)+i*24 owner=l4_wu32(row+4) target=l4_wu32(row+12)
        start=l4_wu32(row+16) count=l4_wu32(row+20)
        to bad when (owner>=l4_count(5)) to bad when (target>=l4_count(4))
        to bad when (i<src_record(owner,3)) to bad when (i>=src_record(owner,3)+src_record(owner,4))
        source=word[534512+owner*8] to bad when (count<1)
        to bad when (l4_source_span_ok(source,start,count)==0)
        src_field_set(i,1,l4_named_span(source,start)) src_field_set(i,2,count) src_field_set(i,3,target)
        i=i+1 to fields
    }
    state machines { to machine when (i<l4_count(7)) i=0 to blocks_loop }
    state machine {
        row=l4_base(7)+i*40 owner=l4_wu32(row+8) blocks=l4_wu32(row+28) block_count=l4_wu32(row+32)
        to bad when (owner>=l4_count(5)) to bad when (blocks>l4_count(9))
        to bad when (block_count<1) to bad when (block_count>l4_count(9)-blocks)
        src_machine_set(i,9,src_record(owner,8)) src_machine_set(i,12,blocks-i)
        src_machine_set(i,13,block_count-1) src_machine_set(i,15,blocks)
        src_machine_set(i,16,word[535512+i*8]) i=i+1 to machines
    }
    state blocks_loop { to block when (i<l4_count(9)) i=0 to finish }
    state block {
        row=l4_base(9)+i*40 owner=l4_wu32(row+4) start=l4_wu32(row+16) count=l4_wu32(row+20)
        to bad when (owner>=l4_count(7)) to bad when (i<src_machine(owner,15))
        to bad when (i>=src_machine(owner,15)+src_machine(owner,13)+1)
        source=src_machine(owner,16) to bad when (count<start)
        to bad when (l4_source_span_ok(source,start,count-start)==0)
        to entry when (l4_wu32(row+8)==0)
        state_id=i-owner-1 src_state_set(state_id,6,start) src_state_set(state_id,7,count)
        src_state_set(state_id,8,i) to next
    }
    state entry { src_machine_set(owner,10,start) src_machine_set(owner,14,count) to next }
    state next { i=i+1 to blocks_loop }
    state finish { word[10000032]=l4_count(7) return 0 }
    state bad { return l4_reject() }
}

proc v4_root_model_prepare() {
    let status=0
    word[530800]=0 word[10000000]=0 status=l4_decode_sources()
    state source { to done when (status!=0) status=l4_decode_witness() to witness }
    state witness { to done when (status!=0) status=v4_root_model_load() to done }
    state done { return status }
}

proc v4_root_find_field(record) {
    let i=src_record(record,3) let end=i+src_record(record,4)
    state fields { to one when (i<end) return 4294967295 }
    state one { to next when (v4_token_equal_named(src_field(i,1),src_field(i,2))==0) return i }
    state next { i=i+1 to fields }
}

proc v4_root_bind(raw,machine,block) {
    let op=word[23900100] let p=0
    state scan { to one when (op<word[525016+7*8]) to bad }
    state one { p=word[525112+7*8]+op*40 to found when (refinement_ckir_byte(p+12)==11) op=op+1 to scan }
    state found {
        to bad when (ckir_u32(p+4)!=machine) to bad when (ckir_u32(p+8)!=block)
        to bad when (ckir_u32(p+32)!=v4_raw(raw,5))
        word[23900100]=op+1 word[23900108]=word[23900108]+1 return 0
    }
    state bad { return src_reject() }
}

proc v4_root_scan_self(machine,block) {
    let type_id=src_machine(machine,9) let field=0 let index=0 let raw=0
    state self { src_next() to suffix }
    state suffix { to member when (word[524416]==46) to index_open when (word[524416]==91) to assignment when (word[524416]==61) return 0 }
    state member { src_next() to done when (word[524416]!=256) to done when (src_type(type_id,0)!=4) field=v4_root_find_field(src_type(type_id,3)) to done when (field==4294967295) type_id=src_field(field,3) src_next() to suffix }
    state index_open { to done when (src_type(type_id,0)!=5) src_next() to done when (word[524416]!=257) src_next() to done when (word[524416]!=93) type_id=src_type(type_id,4) src_next() to suffix }
    state assignment { to done when (src_type(type_id,0)<4) src_next() to array when (word[524416]==91) to nominal }
    state nominal { to done when (src_type(type_id,0)!=4) to done when (v4_token_equal_named(src_record(src_type(type_id,3),0),src_record(src_type(type_id,3),1))==0) to parse }
    state array { to done when (src_type(type_id,0)!=5) to parse }
    state parse { to done when (v4_parse_constant(type_id,0)!=0) raw=word[23900000] return v4_root_bind(raw,machine,block) }
    state done { return word[10000000] }
}

proc v4_root_scan_body(machine,block,start,end) {
    word[18800000+4*8]=machine word[10000128]=end word[524408]=start
    src_next()
    state loop { to done when (word[524416]==0) to self when (src_token_word(18,4)==1) src_next() to loop }
    state self { to done when (v4_root_scan_self(machine,block)!=0) to loop }
    state done { return word[10000000] }
}

proc v4_root_scan_all() {
    let machine=0 let state_id=0 let end_state=0 let block=0 let status=0
    state machines { to one when (machine<word[10000032]) to remaining }
    state one { block=src_machine(machine,15) status=v4_root_scan_body(machine,block,src_machine(machine,10),src_machine(machine,14)) to done when (status!=0) state_id=src_machine(machine,12) end_state=state_id+src_machine(machine,13) to states }
    state states { to state_one when (state_id<end_state) machine=machine+1 to machines }
    state state_one { block=src_state(state_id,8) status=v4_root_scan_body(machine,block,src_state(state_id,6),src_state(state_id,7)) to done when (status!=0) state_id=state_id+1 to states }
    state remaining { block=word[23900100] to remaining_scan }
    state remaining_scan { to remaining_one when (block<word[525016+7*8]) return v4_constants_complete() }
    state remaining_one { to bad when (refinement_ckir_byte(word[525112+7*8]+block*40+12)==11) block=block+1 to remaining_scan }
    state bad { return src_reject() }
    state done { return status }
}

proc omgrfn4_r4_constant_root_check() {
    let status=omgrfn4_component_read() let i=0
    state frame { to done when (status!=0) status=v4_root_model_prepare() to done when (status!=0) src_init_words() status=v4_ckir_header_check() to ckir }
    state ckir { to done when (status!=0) word[23900008]=0 word[23900016]=0 word[23900100]=0 word[23900108]=0 to clear }
    state clear { to one when (i<word[525200]) status=v4_root_scan_all() to done }
    state one { word[25000000+i*8]=0 i=i+1 to clear }
    state done { return status }
}

proc main() { return omgrfn4_r4_constant_root_check() }
