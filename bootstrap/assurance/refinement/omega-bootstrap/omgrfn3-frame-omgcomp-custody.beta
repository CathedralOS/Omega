; OMGRFN3 layer 1: exact version-3 framing and complete OMGCOMP custody.
; This checker treats OMGRSW1, CKIR, ELF, and claimed results as untrusted
; opaque frame components. It performs no resolution, lowering, or artifact
; checks and publishes no bytes.
;
; Raw frame bytes: byte[1048576 .. 5152895], maximum 4,104,320 bytes.
; Frame globals:
;   500000 frame length; 500008 status; 500016 flags
;   500024/500032 OMGCOMP offset/length
;   500040/500048 OMGRSW1 offset/length
;   500056/500064 CKIR offset/length
;   500072/500080 ELF offset/length
;   500088 claimed result; 500096 claimed exit projection
; OMGCOMP scalar scratch starts at 500128; bounded structural tables occupy
; 600000..607039. On success, source-ID-order content starts and lengths,
; relative to the exact OMGCOMP component, occupy 607040 and 607168 (stride 8,
; 16 rows). Bundle-ID-order temporary extents occupy 607296 and 607424.

proc omgrfn3_byte(index) { return byte[1048576 + index] }
proc omgrfn3_omgcomp_byte(index) { return omgrfn3_byte(word[500024] + index) }
proc omgrfn3_source_content_start(source_id) { return word[607040 + source_id * 8] }
proc omgrfn3_source_content_length(source_id) { return word[607168 + source_id * 8] }

proc omgrfn3_u32(at) {
    return omgrfn3_byte(at)
        + omgrfn3_byte(at + 1) * 256
        + omgrfn3_byte(at + 2) * 65536
        + omgrfn3_byte(at + 3) * 16777216
}

proc omgrfn3_read() {
    let n = 0
    let overflow = 0
    let c = read_byte()
    state loop {
        to body when (c >= 0)
        to finish
    }
    state body {
        to exhausted when (n >= 4104320)
        byte[1048576 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state exhausted {
        overflow = 1
        c = read_byte()
        to loop
    }
    state finish {
        word[500000] = n
        word[500008] = 0
        to too_large when (overflow == 1)
        to header when (n >= 40)
        to malformed
    }
    state too_large { word[500008] = 252  return 252 }
    state header {
        to malformed when (omgrfn3_byte(0) != 'O')
        to magic1
    }
    state magic1 { to malformed when (omgrfn3_byte(1) != 'M')  to magic2 }
    state magic2 { to malformed when (omgrfn3_byte(2) != 'G')  to magic3 }
    state magic3 { to malformed when (omgrfn3_byte(3) != 'R')  to magic4 }
    state magic4 { to malformed when (omgrfn3_byte(4) != 'F')  to magic5 }
    state magic5 { to malformed when (omgrfn3_byte(5) != 'N')  to magic6 }
    state magic6 { to malformed when (omgrfn3_byte(6) != '3')  to magic7 }
    state magic7 { to malformed when (omgrfn3_byte(7) != 0)  to version }
    state version { to malformed when (omgrfn3_u32(8) != 3)  to fields }
    state fields {
        let flags = omgrfn3_u32(12)
        let omgcomp_length = omgrfn3_u32(16)
        let witness_length = omgrfn3_u32(20)
        let ckir_length = omgrfn3_u32(24)
        let elf_length = omgrfn3_u32(28)
        let result = omgrfn3_u32(32)
        let exit_projection = omgrfn3_u32(36)
        word[500016] = flags
        word[500024] = 40
        word[500032] = omgcomp_length
        word[500040] = 40 + omgcomp_length
        word[500048] = witness_length
        word[500056] = 40 + omgcomp_length + witness_length
        word[500064] = ckir_length
        word[500072] = 40 + omgcomp_length + witness_length + ckir_length
        word[500080] = elf_length
        word[500088] = result
        word[500096] = exit_projection
        to malformed when (flags > 1)
        to malformed when (omgcomp_length < 1)
        to malformed when (witness_length < 1)
        to malformed when (ckir_length < 1)
        to exhausted_size when (omgcomp_length > 267280)
        to exhausted_size when (witness_length > 524288)
        to exhausted_size when (ckir_length > 2260040)
        to exhausted_size when (elf_length > 1052672)
        to malformed when (n != 40 + omgcomp_length + witness_length + ckir_length + elf_length)
        to library when (flags == 0)
        to entry
    }
    state library {
        to malformed when (word[500080] != 0)
        to malformed when (word[500088] != 4294967295)
        to malformed when (word[500096] != 4294967295)
        return 0
    }
    state entry {
        to malformed when (word[500080] < 1)
        to malformed when (word[500096] > 255)
        to malformed when (word[500096] != (word[500088] % 256))
        return 0
    }
    state exhausted_size { word[500008] = 252  return 252 }
    state malformed { word[500008] = 251  return 251 }
}

; Complete structural OMGCOMP custody helpers, adapted independently into
; persisted Beta from the production transport contract. Raw OMGCOMP bytes are
; exposed only through omgrfn3_omgcomp_byte.

proc omgcomp_reject() {
    to set when (word[500128] == 0)  to done
    state set { word[500128] = 251   to done }
    state done { }
}

proc omgcomp_exhaust() {
    to set when (word[500128] == 0)  to done
    state set { word[500128] = 252   to done }
    state done { }
}

proc omgcomp_read_u32(at) {
    word[500160] = 0 - 1
    to upper when (at >= 0)  to bad
    state upper { to signed when (at <= word[500144] - 4)  to bad }
    state signed { to value when (omgrfn3_omgcomp_byte(at + 3) < 128)  to bad }
    state value {
        word[500160] = omgrfn3_omgcomp_byte(at)
            + omgrfn3_omgcomp_byte(at + 1) * 256
            + omgrfn3_omgcomp_byte(at + 2) * 65536
            + omgrfn3_omgcomp_byte(at + 3) * 16777216
        to done
    }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_lex_compare() {
    word[500240] = 0   word[500208] = 0
    to loop
    state loop { to right when (word[500208] < word[500256])  to left_end }
    state right { to byte when (word[500208] < word[500272])  to greater }
    state byte { to less when (omgrfn3_omgcomp_byte(word[500248] + word[500208]) < omgrfn3_omgcomp_byte(word[500264] + word[500208]))  to byte_equal }
    state byte_equal { to advance when (omgrfn3_omgcomp_byte(word[500248] + word[500208]) == omgrfn3_omgcomp_byte(word[500264] + word[500208]))  to greater }
    state advance { word[500208] = word[500208] + 1   to loop }
    state left_end { to less when (word[500208] < word[500272])  to done }
    state less { word[500240] = 0 - 1   to done }
    state greater { word[500240] = 1   to done }
    state done { }
}

proc omgcomp_check_header() {
    to magic0 when (word[500144] >= 64)  to bad
    state magic0 { to magic1 when (omgrfn3_omgcomp_byte(0) == 79)  to bad }
    state magic1 { to magic2 when (omgrfn3_omgcomp_byte(1) == 77)  to bad }
    state magic2 { to magic3 when (omgrfn3_omgcomp_byte(2) == 71)  to bad }
    state magic3 { to magic4 when (omgrfn3_omgcomp_byte(3) == 67)  to bad }
    state magic4 { to magic5 when (omgrfn3_omgcomp_byte(4) == 79)  to bad }
    state magic5 { to magic6 when (omgrfn3_omgcomp_byte(5) == 77)  to bad }
    state magic6 { to magic7 when (omgrfn3_omgcomp_byte(6) == 80)  to bad }
    state magic7 { to fixed0 when (omgrfn3_omgcomp_byte(7) == 0)  to bad }
    state fixed0 { to fixed1 when (omgrfn3_omgcomp_byte(8) == 1)  to bad }
    state fixed1 { to fixed2 when (omgrfn3_omgcomp_byte(9) == 0)  to bad }
    state fixed2 { to fixed3 when (omgrfn3_omgcomp_byte(10) == 0)  to bad }
    state fixed3 { to fixed4 when (omgrfn3_omgcomp_byte(11) == 0)  to bad }
    state fixed4 { to fixed5 when (omgrfn3_omgcomp_byte(12) == 1)  to bad }
    state fixed5 { to fixed6 when (omgrfn3_omgcomp_byte(13) == 0)  to bad }
    state fixed6 { to fixed7 when (omgrfn3_omgcomp_byte(14) == 0)  to bad }
    state fixed7 { to reserved when (omgrfn3_omgcomp_byte(15) == 0)  to bad }
    state reserved { omgcomp_read_u32(60)   to reserved_value when (word[500128] == 0)  to done }
    state reserved_value { to lengths when (word[500160] == 0)  to bad }
    state lengths { omgcomp_read_u32(16)   word[500280] = word[500160]   omgcomp_read_u32(20)   word[500288] = word[500160]   omgcomp_read_u32(24)   word[500296] = word[500160]   to counts when (word[500128] == 0)  to done }
    state counts { omgcomp_read_u32(28)   word[500304] = word[500160]   omgcomp_read_u32(32)   word[500312] = word[500160]   omgcomp_read_u32(36)   word[500320] = word[500160]   omgcomp_read_u32(40)   word[500328] = word[500160]   to roots when (word[500128] == 0)  to done }
    state roots { omgcomp_read_u32(44)   word[500336] = word[500160]   omgcomp_read_u32(48)   word[500344] = word[500160]   omgcomp_read_u32(52)   word[500352] = word[500160]   omgcomp_read_u32(56)   word[500360] = word[500160]   to minimum_package when (word[500128] == 0)  to done }
    state minimum_package { to package_limit when (word[500312] >= 1)  to bad }
    state package_limit { to minimum_source when (word[500312] <= 16)  to exhausted }
    state minimum_source { to source_limit when (word[500320] >= 1)  to bad }
    state source_limit { to alias_limit when (word[500320] <= 16)  to exhausted }
    state alias_limit { to string_limit when (word[500328] <= 32)  to exhausted }
    state string_limit { to bundle_limit when (word[500304] <= 64)  to exhausted }
    state bundle_limit { to total_limit when (word[500288] <= 263312)  to exhausted }
    state total_limit { to actual_length when (word[500280] <= 267280)  to exhausted }
    state actual_length { to string_extent_room when (word[500280] == word[500144])  to bad }
    state string_extent_room {
        word[500392] = 64 + word[500312] * 48
            + word[500320] * 20 + word[500328] * 16
        to extents when (word[500296] <= word[500280] - word[500392])  to bad
    }
    state extents {
        word[500368] = 64
        word[500376] = word[500368] + word[500312] * 48
        word[500384] = word[500376] + word[500320] * 20
        word[500400] = word[500392] + word[500296]
        word[500232] = word[500400] + word[500288]
        to root_ranges when (word[500232] == word[500280])  to bad
    }
    state root_ranges { to root_source_range when (word[500336] < word[500312])  to bad }
    state root_source_range { to root_owner_range when (word[500344] < word[500320])  to bad }
    state root_owner_range { to root_machine_range when (word[500352] < word[500304])  to bad }
    state root_machine_range { to done when (word[500360] < word[500304])  to bad }
    state exhausted { omgcomp_exhaust()   to done }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_check_packages() {
    word[500168] = 0   word[500232] = 0
    to loop
    state loop { to row when (word[500168] < word[500312])  to partition }
    state row { word[500152] = word[500368] + word[500168] * 48   omgcomp_read_u32(word[500152])   to dense when (word[500128] == 0)  to done }
    state dense { to key when (word[500160] == word[500168])  to bad }
    state key { word[600000 + (word[500168]) * 8] = word[500152] + 4   word[500176] = 0   word[500216] = 0   to key_loop }
    state key_loop { to key_byte when (word[500176] < 32)  to key_nonzero }
    state key_byte { to key_advance when (omgrfn3_omgcomp_byte(word[500152] + 4 + word[500176]) == 0)  to key_mark }
    state key_mark { word[500216] = 1   to key_advance }
    state key_advance { word[500176] = word[500176] + 1   to key_loop }
    state key_nonzero { to key_order when (word[500216] == 1)  to bad }
    state key_order { to compare_key when (word[500168] > 0)  to span }
    state compare_key { word[500248] = word[600000 + (word[500168] - 1) * 8]   word[500256] = 32   word[500264] = word[600000 + (word[500168]) * 8]   word[500272] = 32   omgcomp_lex_compare()   to span when (word[500240] < 0)  to bad }
    state span { omgcomp_read_u32(word[500152] + 36)   word[600128 + (word[500168]) * 8] = word[500160]   omgcomp_read_u32(word[500152] + 40)   word[600256 + (word[500168]) * 8] = word[500160]   omgcomp_read_u32(word[500152] + 44)   to reserved when (word[500128] == 0)  to done }
    state reserved { to span_start when (word[500160] == 0)  to bad }
    state span_start { to span_nonempty when (word[600128 + (word[500168]) * 8] == word[500232])  to bad }
    state span_nonempty { to span_room when (word[600256 + (word[500168]) * 8] >= 1)  to bad }
    state span_room { to advance when (word[600256 + (word[500168]) * 8] <= word[500320] - word[500232])  to bad }
    state advance { word[500232] = word[500232] + word[600256 + (word[500168]) * 8]   word[500168] = word[500168] + 1   to loop }
    state partition { to done when (word[500232] == word[500320])  to bad }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_check_sources() {
    word[500168] = 0   word[500456] = 0
    to loop
    state loop { to owner_seek when (word[500168] < word[500320])  to permutation }
    state owner_seek { to row when (word[500168] < word[600128 + (word[500456]) * 8] + word[600256 + (word[500456]) * 8])  to next_package }
    state next_package { word[500456] = word[500456] + 1   to owner_seek when (word[500456] < word[500312])  to bad }
    state row { word[500152] = word[500376] + word[500168] * 20   omgcomp_read_u32(word[500152])   to dense when (word[500128] == 0)  to done }
    state dense { to owner when (word[500160] == word[500168])  to bad }
    state owner { omgcomp_read_u32(word[500152] + 4)   word[600384 + (word[500168]) * 8] = word[500160]   to owner_exact when (word[500128] == 0)  to done }
    state owner_exact { to bundle when (word[600384 + (word[500168]) * 8] == word[500456])  to bad }
    state bundle { omgcomp_read_u32(word[500152] + 8)   word[600512 + (word[500168]) * 8] = word[500160]   to bundle_range when (word[500128] == 0)  to done }
    state bundle_range { to bundle_unique when (word[600512 + (word[500168]) * 8] < word[500320])  to bad }
    state bundle_unique { to bundle_mark when (word[600768 + (word[600512 + (word[500168]) * 8]) * 8] == 0)  to bad }
    state bundle_mark { word[600768 + (word[600512 + (word[500168]) * 8]) * 8] = 1   omgcomp_read_u32(word[500152] + 12)   word[600640 + (word[500168]) * 8] = word[500160]   to module_range when (word[500128] == 0)  to done }
    state module_range { to flags when (word[600640 + (word[500168]) * 8] < word[500304])  to bad }
    state flags { omgcomp_read_u32(word[500152] + 16)   to flags_value when (word[500128] == 0)  to done }
    state flags_value { to advance when (word[500160] == 0)  to bad }
    state advance { word[500168] = word[500168] + 1   to loop }
    state permutation { word[500168] = 0   to permutation_loop }
    state permutation_loop { to permutation_value when (word[500168] < word[500320])  to root_owner }
    state permutation_value { to permutation_advance when (word[600768 + (word[500168]) * 8] == 1)  to bad }
    state permutation_advance { word[500168] = word[500168] + 1   to permutation_loop }
    state root_owner { to done when (word[600384 + (word[500344]) * 8] == word[500336])  to bad }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_check_alias_rows() {
    word[500168] = 0
    to loop
    state loop { to row when (word[500168] < word[500328])  to done }
    state row { word[500152] = word[500384] + word[500168] * 16   omgcomp_read_u32(word[500152])   word[600896 + (word[500168]) * 8] = word[500160]   omgcomp_read_u32(word[500152] + 4)   word[601152 + (word[500168]) * 8] = word[500160]   omgcomp_read_u32(word[500152] + 8)   word[601408 + (word[500168]) * 8] = word[500160]   to reserved when (word[500128] == 0)  to done }
    state reserved { omgcomp_read_u32(word[500152] + 12)   to ranges0 when (word[500128] == 0)  to done }
    state ranges0 { to ranges1 when (word[500160] == 0)  to bad }
    state ranges1 { to ranges2 when (word[600896 + (word[500168]) * 8] < word[500312])  to bad }
    state ranges2 { to ranges3 when (word[601152 + (word[500168]) * 8] < word[500304])  to bad }
    state ranges3 { to no_self when (word[601408 + (word[500168]) * 8] < word[500312])  to bad }
    state no_self { to bad when (word[600896 + (word[500168]) * 8] == word[601408 + (word[500168]) * 8])  to advance }
    state advance { word[500168] = word[500168] + 1   to loop }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_check_strings() {
    word[500168] = 0   word[500152] = word[500392]   word[500224] = word[500400]
    word[500408] = 0
    to loop
    state loop { to length_room when (word[500168] < word[500304])  to exact_end }
    state length_room { to length when (word[500152] <= word[500224] - 4)  to bad }
    state length { omgcomp_read_u32(word[500152])   word[500216] = word[500160]   to payload_room when (word[500128] == 0)  to done }
    state payload_room { to save when (word[500216] <= word[500224] - word[500152] - 4)  to bad }
    state save { word[601664 + (word[500168]) * 8] = word[500152] + 4   word[602176 + (word[500168]) * 8] = word[500216]   word[500408] = word[500408] + word[500216]   word[500176] = 0   to ascii_loop }
    state ascii_loop { to ascii_byte when (word[500176] < word[500216])  to order }
    state ascii_byte { to ascii_advance when (omgrfn3_omgcomp_byte(word[601664 + (word[500168]) * 8] + word[500176]) < 128)  to bad }
    state ascii_advance { word[500176] = word[500176] + 1   to ascii_loop }
    state order { to compare when (word[500168] > 0)  to advance }
    state compare { word[500248] = word[601664 + (word[500168] - 1) * 8]   word[500256] = word[602176 + (word[500168] - 1) * 8]   word[500264] = word[601664 + (word[500168]) * 8]   word[500272] = word[602176 + (word[500168]) * 8]   omgcomp_lex_compare()   to advance when (word[500240] < 0)  to bad }
    state advance { word[500152] = word[601664 + (word[500168]) * 8] + word[602176 + (word[500168]) * 8]   word[500168] = word[500168] + 1   to loop }
    state exact_end { to payload_limit when (word[500152] == word[500224])  to bad }
    state payload_limit { to mark_sources when (word[500408] <= 2048)  to exhausted }
    state mark_sources { word[500168] = 0   to mark_sources_loop }
    state mark_sources_loop { to mark_source when (word[500168] < word[500320])  to mark_aliases }
    state mark_source { word[500192] = word[600640 + (word[500168]) * 8]   word[602688 + (word[500192]) * 8] = 1   word[603200 + (word[500192]) * 8] = 1   word[500168] = word[500168] + 1   to mark_sources_loop }
    state mark_aliases { word[500168] = 0   to mark_aliases_loop }
    state mark_aliases_loop { to mark_alias when (word[500168] < word[500328])  to mark_roots }
    state mark_alias { word[500192] = word[601152 + (word[500168]) * 8]   word[602688 + (word[500192]) * 8] = 1   word[603712 + (word[500192]) * 8] = 1   word[500168] = word[500168] + 1   to mark_aliases_loop }
    state mark_roots { word[602688 + (word[500352]) * 8] = 1   word[604224 + (word[500352]) * 8] = 1   word[602688 + (word[500360]) * 8] = 1   word[604224 + (word[500360]) * 8] = 1   word[500168] = 0   to used_loop }
    state used_loop { to used_value when (word[500168] < word[500304])  to done }
    state used_value { to used_advance when (word[602688 + (word[500168]) * 8] == 1)  to bad }
    state used_advance { word[500168] = word[500168] + 1   to used_loop }
    state exhausted { omgcomp_exhaust()   to done }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_validate_identifier() {
    word[500240] = 0
    to length when (word[500256] > 0)  to done
    state length { to first_upper0 when (word[500256] <= 64)  to exhausted }
    state first_upper0 { word[500136] = omgrfn3_omgcomp_byte(word[500248])   to first_upper1 when (word[500136] >= 65)  to first_lower0 }
    state first_upper1 { to rest_begin when (word[500136] < 91)  to first_lower0 }
    state first_lower0 { to first_lower1 when (word[500136] >= 97)  to first_under }
    state first_lower1 { to rest_begin when (word[500136] < 123)  to first_under }
    state first_under { to rest_begin when (word[500136] == 95)  to done }
    state rest_begin { word[500208] = 1   to rest_loop }
    state rest_loop { to rest_byte when (word[500208] < word[500256])  to yes }
    state rest_byte { word[500136] = omgrfn3_omgcomp_byte(word[500248] + word[500208])   to rest_upper when (word[500136] >= 65)  to rest_lower0 }
    state rest_upper { to rest_advance when (word[500136] < 91)  to rest_lower0 }
    state rest_lower0 { to rest_lower when (word[500136] >= 97)  to rest_digit0 }
    state rest_lower { to rest_advance when (word[500136] < 123)  to rest_digit0 }
    state rest_digit0 { to rest_digit when (word[500136] >= 48)  to rest_under }
    state rest_digit { to rest_advance when (word[500136] < 58)  to rest_under }
    state rest_under { to rest_advance when (word[500136] == 95)  to done }
    state rest_advance { word[500208] = word[500208] + 1   to rest_loop }
    state yes { word[500240] = 1   to done }
    state exhausted { omgcomp_exhaust()   to done }
    state done { }
}

proc omgcomp_validate_path() {
    word[500240] = 0   word[500432] = 0   word[500440] = 1   word[500176] = 0
    to loop when (word[500256] > 0)  to yes
    state loop { to colon0 when (word[500176] < word[500256])  to final_segment }
    state colon0 { to colon1_room when (omgrfn3_omgcomp_byte(word[500248] + word[500176]) == 58)  to advance }
    state colon1_room { to colon1 when (word[500176] + 1 < word[500256])  to done }
    state colon1 { to segment when (omgrfn3_omgcomp_byte(word[500248] + word[500176] + 1) == 58)  to done }
    state segment { word[500448] = word[500176] - word[500432]   to segment_check when (word[500448] > 0)  to done }
    state segment_check { word[500264] = word[500248]   word[500272] = word[500256]   word[500248] = word[500248] + word[500432]   word[500256] = word[500448]   omgcomp_validate_identifier()   to segment_valid when (word[500128] == 0)  to restore_fail }
    state segment_valid { to segment_accept when (word[500240] == 1)  to restore_fail }
    state restore_fail { word[500248] = word[500264]   word[500256] = word[500272]   to done }
    state segment_accept { word[500248] = word[500264]   word[500256] = word[500272]   word[500440] = word[500440] + 1   to segment_advance when (word[500440] <= 8)  to exhausted }
    state segment_advance { word[500176] = word[500176] + 2   word[500432] = word[500176]   to loop }
    state advance { word[500176] = word[500176] + 1   to loop }
    state final_segment { word[500448] = word[500256] - word[500432]   to final_check when (word[500448] > 0)  to done }
    state final_check { word[500264] = word[500248]   word[500272] = word[500256]   word[500248] = word[500248] + word[500432]   word[500256] = word[500448]   omgcomp_validate_identifier()   to final_valid when (word[500128] == 0)  to restore_fail }
    state final_valid { word[500248] = word[500264]   word[500256] = word[500272]   to yes when (word[500240] == 1)  to done }
    state yes { word[500240] = 1   to done }
    state exhausted { omgcomp_exhaust()   to done }
    state done { }
}

proc omgcomp_validate_alias() {
    word[500240] = 0
    to length when (word[500256] > 0)  to done
    state length { to first when (word[500256] <= 64)  to exhausted }
    state first { word[500136] = omgrfn3_omgcomp_byte(word[500248])   to first_hi when (word[500136] >= 97)  to done }
    state first_hi { to rest_begin when (word[500136] < 123)  to done }
    state rest_begin { word[500208] = 1   word[500192] = 0   to rest_loop }
    state rest_loop { to byte when (word[500208] < word[500256])  to trailing }
    state byte { word[500136] = omgrfn3_omgcomp_byte(word[500248] + word[500208])   to lower when (word[500136] >= 97)  to digit0 }
    state lower { to ordinary when (word[500136] < 123)  to digit0 }
    state digit0 { to digit when (word[500136] >= 48)  to under }
    state digit { to ordinary when (word[500136] < 58)  to under }
    state under { to consecutive when (word[500136] == 95)  to done }
    state consecutive { to done when (word[500192] == 1)  to mark_under }
    state mark_under { word[500192] = 1   word[500208] = word[500208] + 1   to rest_loop }
    state ordinary { word[500192] = 0   word[500208] = word[500208] + 1   to rest_loop }
    state trailing { to yes when (word[500192] == 0)  to done }
    state yes { word[500240] = 1   to done }
    state exhausted { omgcomp_exhaust()   to done }
    state done { }
}

proc omgcomp_check_string_roles() {
    word[500168] = 0
    to loop
    state loop { to module when (word[500168] < word[500304])  to done }
    state module { to module_check when (word[603200 + (word[500168]) * 8] == 1)  to alias }
    state module_check { word[500248] = word[601664 + (word[500168]) * 8]   word[500256] = word[602176 + (word[500168]) * 8]   omgcomp_validate_path()   to module_valid when (word[500128] == 0)  to done }
    state module_valid { to alias when (word[500240] == 1)  to bad }
    state alias { to alias_check when (word[603712 + (word[500168]) * 8] == 1)  to identifier }
    state alias_check { word[500248] = word[601664 + (word[500168]) * 8]   word[500256] = word[602176 + (word[500168]) * 8]   omgcomp_validate_alias()   to alias_valid when (word[500128] == 0)  to done }
    state alias_valid { to identifier when (word[500240] == 1)  to bad }
    state identifier { to identifier_check when (word[604224 + (word[500168]) * 8] == 1)  to advance }
    state identifier_check { word[500248] = word[601664 + (word[500168]) * 8]   word[500256] = word[602176 + (word[500168]) * 8]   omgcomp_validate_identifier()   to identifier_valid when (word[500128] == 0)  to done }
    state identifier_valid { to advance when (word[500240] == 1)  to bad }
    state advance { word[500168] = word[500168] + 1   to loop }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_check_alias_order_graph() {
    word[500168] = 0
    to rows
    state rows { to order when (word[500168] < word[500328])  to closure_k }
    state order { to requester_order when (word[500168] > 0)  to mark }
    state requester_order { to mark when (word[600896 + (word[500168] - 1) * 8] < word[600896 + (word[500168]) * 8])  to requester_equal }
    state requester_equal { to alias_compare when (word[600896 + (word[500168] - 1) * 8] == word[600896 + (word[500168]) * 8])  to bad }
    state alias_compare { word[500248] = word[601664 + (word[601152 + (word[500168] - 1) * 8]) * 8]   word[500256] = word[602176 + (word[601152 + (word[500168] - 1) * 8]) * 8]   word[500264] = word[601664 + (word[601152 + (word[500168]) * 8]) * 8]   word[500272] = word[602176 + (word[601152 + (word[500168]) * 8]) * 8]   omgcomp_lex_compare()   to mark when (word[500240] < 0)  to bad }
    state mark { word[500192] = word[600896 + (word[500168]) * 8] * 16 + word[601408 + (word[500168]) * 8]   word[604992 + (word[500192]) * 8] = 1   word[500168] = word[500168] + 1   to rows }
    state closure_k { word[500184] = 0   to k_loop }
    state k_loop { to closure_i when (word[500184] < word[500312])  to cycles }
    state closure_i { word[500168] = 0   to i_loop }
    state i_loop { to through when (word[500168] < word[500312])  to k_advance }
    state through { to closure_j when (word[604992 + (word[500168] * 16 + word[500184]) * 8] == 1)  to i_advance }
    state closure_j { word[500176] = 0   to j_loop }
    state j_loop { to edge when (word[500176] < word[500312])  to i_advance }
    state edge { to edge_mark when (word[604992 + (word[500184] * 16 + word[500176]) * 8] == 1)  to j_advance }
    state edge_mark { word[604992 + (word[500168] * 16 + word[500176]) * 8] = 1   to j_advance }
    state j_advance { word[500176] = word[500176] + 1   to j_loop }
    state i_advance { word[500168] = word[500168] + 1   to i_loop }
    state k_advance { word[500184] = word[500184] + 1   to k_loop }
    state cycles { word[500168] = 0   to cycle_loop }
    state cycle_loop { to cycle_value when (word[500168] < word[500312])  to reach }
    state cycle_value { to cycle_advance when (word[604992 + (word[500168] * 16 + word[500168]) * 8] == 0)  to bad }
    state cycle_advance { word[500168] = word[500168] + 1   to cycle_loop }
    state reach { word[500168] = 0   to reach_loop }
    state reach_loop { to reach_value when (word[500168] < word[500312])  to done }
    state reach_value { to reach_advance when (word[500168] == word[500336])  to reachable }
    state reachable { to reach_advance when (word[604992 + (word[500336] * 16 + word[500168]) * 8] == 1)  to bad }
    state reach_advance { word[500168] = word[500168] + 1   to reach_loop }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_validate_bundle_label() {
    word[500240] = 0   word[500208] = 0   word[500432] = 0
    to first when (word[500256] > 0)  to done
    state first { to done when (omgrfn3_omgcomp_byte(word[500248]) == 47)  to loop }
    state loop { to byte when (word[500208] < word[500256])  to final_segment }
    state byte { word[500136] = omgrfn3_omgcomp_byte(word[500248] + word[500208])   to slash when (word[500136] == 47)  to allowed_upper0 }
    state slash { word[500448] = word[500208] - word[500432]   to dot_one_check when (word[500448] > 0)  to done }
    state dot_one_check { to dot_one when (word[500448] == 1)  to dot_two_check }
    state dot_one { to done when (omgrfn3_omgcomp_byte(word[500248] + word[500432]) == 46)  to slash_accept }
    state dot_two_check { to dot_two_first when (word[500448] == 2)  to slash_accept }
    state dot_two_first { to dot_two_second when (omgrfn3_omgcomp_byte(word[500248] + word[500432]) == 46)  to slash_accept }
    state dot_two_second { to done when (omgrfn3_omgcomp_byte(word[500248] + word[500432] + 1) == 46)  to slash_accept }
    state slash_accept { word[500432] = word[500208] + 1   word[500208] = word[500208] + 1   to loop }
    state allowed_upper0 { to allowed_upper1 when (word[500136] >= 65)  to allowed_lower0 }
    state allowed_upper1 { to advance when (word[500136] < 91)  to allowed_lower0 }
    state allowed_lower0 { to allowed_lower1 when (word[500136] >= 97)  to allowed_digit0 }
    state allowed_lower1 { to advance when (word[500136] < 123)  to allowed_digit0 }
    state allowed_digit0 { to allowed_digit1 when (word[500136] >= 48)  to allowed_dot }
    state allowed_digit1 { to advance when (word[500136] < 58)  to allowed_dot }
    state allowed_dot { to advance when (word[500136] == 46)  to allowed_under }
    state allowed_under { to advance when (word[500136] == 95)  to allowed_hyphen }
    state allowed_hyphen { to advance when (word[500136] == 45)  to done }
    state advance { word[500208] = word[500208] + 1   to loop }
    state final_segment { word[500448] = word[500256] - word[500432]   to final_dot_one_check when (word[500448] > 0)  to done }
    state final_dot_one_check { to final_dot_one when (word[500448] == 1)  to final_dot_two_check }
    state final_dot_one { to done when (omgrfn3_omgcomp_byte(word[500248] + word[500432]) == 46)  to yes }
    state final_dot_two_check { to final_dot_two_first when (word[500448] == 2)  to yes }
    state final_dot_two_first { to final_dot_two_second when (omgrfn3_omgcomp_byte(word[500248] + word[500432]) == 46)  to yes }
    state final_dot_two_second { to done when (omgrfn3_omgcomp_byte(word[500248] + word[500432] + 1) == 46)  to yes }
    state yes { word[500240] = 1   to done }
    state done { }
}

proc omgcomp_check_bundle() {
    word[500152] = word[500400]   word[500416] = 0
    word[500424] = 0
    to magic0 when (word[500288] >= 16)  to bad
    state magic0 { to magic1 when (omgrfn3_omgcomp_byte(word[500152]) == 79)  to bad }
    state magic1 { to magic2 when (omgrfn3_omgcomp_byte(word[500152] + 1) == 77)  to bad }
    state magic2 { to magic3 when (omgrfn3_omgcomp_byte(word[500152] + 2) == 71)  to bad }
    state magic3 { to magic4 when (omgrfn3_omgcomp_byte(word[500152] + 3) == 48)  to bad }
    state magic4 { to magic5 when (omgrfn3_omgcomp_byte(word[500152] + 4) == 66)  to bad }
    state magic5 { to magic6 when (omgrfn3_omgcomp_byte(word[500152] + 5) == 78)  to bad }
    state magic6 { to magic7 when (omgrfn3_omgcomp_byte(word[500152] + 6) == 68)  to bad }
    state magic7 { to version0 when (omgrfn3_omgcomp_byte(word[500152] + 7) == 76)  to bad }
    state version0 { to version1 when (omgrfn3_omgcomp_byte(word[500152] + 8) == 1)  to bad }
    state version1 { to version2 when (omgrfn3_omgcomp_byte(word[500152] + 9) == 0)  to bad }
    state version2 { to version3 when (omgrfn3_omgcomp_byte(word[500152] + 10) == 0)  to bad }
    state version3 { to bundle_count when (omgrfn3_omgcomp_byte(word[500152] + 11) == 0)  to bad }
    state bundle_count { omgcomp_read_u32(word[500152] + 12)   to bundle_count_value when (word[500128] == 0)  to done }
    state bundle_count_value { to entries when (word[500160] == word[500320])  to bad }
    state entries { word[500152] = word[500152] + 16   word[500168] = 0   to entry_loop }
    state entry_loop { to label_length_room when (word[500168] < word[500320])  to exact_end }
    state label_length_room { to label_length when (word[500152] <= word[500280] - 8)  to bad }
    state label_length { omgcomp_read_u32(word[500152])   word[500216] = word[500160]   omgcomp_read_u32(word[500152] + 4)   word[500200] = word[500160]   to label_min when (word[500128] == 0)  to done }
    state label_min { to label_limit when (word[500216] >= 1)  to bad }
    state label_limit { to label_room when (word[500216] <= 64)  to exhausted }
    state label_room { to content_room_pre when (word[500216] <= word[500280] - word[500152] - 8)  to bad }
    state content_room_pre { to label_save when (word[500200] <= word[500280] - word[500152] - 8 - word[500216])  to bad }
    state label_save { word[604736 + (word[500168]) * 8] = word[500152] + 8   word[604864 + (word[500168]) * 8] = word[500216]   word[500416] = word[500416] + word[500216]   word[500248] = word[500152] + 8   word[500256] = word[500216]   omgcomp_validate_bundle_label()   to label_order when (word[500240] == 1)  to bad_or_done }
    state bad_or_done { to bad when (word[500128] == 0)  to done }
    state label_order { to label_compare when (word[500168] > 0)  to content_limit }
    state label_compare { word[500248] = word[604736 + (word[500168] - 1) * 8]   word[500256] = word[604864 + (word[500168] - 1) * 8]   word[500264] = word[604736 + (word[500168]) * 8]   word[500272] = word[604864 + (word[500168]) * 8]   omgcomp_lex_compare()   to content_limit when (word[500240] < 0)  to bad }
    state content_limit { to content_accept when (word[500200] <= 131072)  to exhausted }
    state content_accept { word[607296 + (word[500168]) * 8] = word[604736 + (word[500168]) * 8] + word[604864 + (word[500168]) * 8]   word[607424 + (word[500168]) * 8] = word[500200]   word[500424] = word[500424] + word[500200]   word[500152] = word[607296 + (word[500168]) * 8] + word[500200]   word[500168] = word[500168] + 1   to entry_loop }
    state exact_end { to aggregate_labels when (word[500152] == word[500280])  to bad }
    state aggregate_labels { to aggregate_content when (word[500416] <= 1024)  to exhausted }
    state aggregate_content { to done when (word[500424] <= 262144)  to exhausted }
    state exhausted { omgcomp_exhaust()   to done }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_check_source_label_order() {
    word[500168] = 0   word[500456] = 0
    to loop
    state loop { to package_first when (word[500168] < word[500320])  to done }
    state package_first { to advance when (word[500168] == word[600128 + (word[500456]) * 8])  to compare }
    state compare { word[500248] = word[604736 + (word[600512 + (word[500168] - 1) * 8]) * 8]   word[500256] = word[604864 + (word[600512 + (word[500168] - 1) * 8]) * 8]   word[500264] = word[604736 + (word[600512 + (word[500168]) * 8]) * 8]   word[500272] = word[604864 + (word[600512 + (word[500168]) * 8]) * 8]   omgcomp_lex_compare()   to advance when (word[500240] < 0)  to bad }
    state advance { word[500168] = word[500168] + 1   to package_end when (word[500168] < word[500320])  to loop }
    state package_end { to next_package when (word[500168] == word[600128 + (word[500456]) * 8] + word[600256 + (word[500456]) * 8])  to loop }
    state next_package { word[500456] = word[500456] + 1   to loop }
    state bad { omgcomp_reject()   to done }
    state done { }
}

proc omgcomp_finalize_source_extents() {
    let source_id = 0
    let bundle_id = 0
    state loop {
        to save when (source_id < word[500320])
        to done
    }
    state save {
        bundle_id = word[600512 + source_id * 8]
        word[607040 + source_id * 8] = word[607296 + bundle_id * 8]
        word[607168 + source_id * 8] = word[607424 + bundle_id * 8]
        source_id = source_id + 1
        to loop
    }
    state done { }
}

proc omgrfn3_layer1_check() {
    word[500008] = 0
    omgrfn3_read()
    to omgcomp_start when (word[500008] == 0)
    to done
    state omgcomp_start {
        word[500128] = 0
        word[500144] = word[500032]
        omgcomp_check_header()
        to packages when (word[500128] == 0)
        to omgcomp_failed
    }
    state packages { omgcomp_check_packages()   to sources when (word[500128] == 0)  to omgcomp_failed }
    state sources { omgcomp_check_sources()   to aliases when (word[500128] == 0)  to omgcomp_failed }
    state aliases { omgcomp_check_alias_rows()   to strings when (word[500128] == 0)  to omgcomp_failed }
    state strings { omgcomp_check_strings()   to roles when (word[500128] == 0)  to omgcomp_failed }
    state roles { omgcomp_check_string_roles()   to graph when (word[500128] == 0)  to omgcomp_failed }
    state graph { omgcomp_check_alias_order_graph()   to bundle when (word[500128] == 0)  to omgcomp_failed }
    state bundle { omgcomp_check_bundle()   to source_order when (word[500128] == 0)  to omgcomp_failed }
    state source_order { omgcomp_check_source_label_order()   to extents when (word[500128] == 0)  to omgcomp_failed }
    state extents { omgcomp_finalize_source_extents()   to done }
    state omgcomp_failed { word[500008] = word[500128]   to done }
    state done { return word[500008] }
}
