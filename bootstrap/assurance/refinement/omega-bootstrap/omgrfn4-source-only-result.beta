; OMGRFN4 responsibility-4 physically artifact-free source result.
;
; The focused gate composes this after the version-4 frame reader truncated
; before its CKIR accessor, the independently reconstructed source/witness
; model, the CKIR-independent source-lowering helpers, and the role-3 call
; parser/emitter prefix.  Aggregate literals are retained as a private raw DAG;
; opcode 11 carries a raw-node ID and installs that tree directly into owner
; memory.  No CKIR or ELF accessor is present in the persisted executable.
;
; Private disjoint memory map:
;   word[28000000 .. 29572864) raw nodes (32768 * 48 bytes)
;   word[30000000 .. 30524288) raw child IDs (65536 * 8 bytes)
;   word[30600000 .. 30601024) record parse scratch (8 * 128 bytes)
;   word[30700000 .. 30765536) array parse scratch (8 * 8192 bytes)
;   byte[32000000 .. 32131072) selected-owner storage
;   word[33000000 .. 37718592) value frames (16 * 294912 bytes)
;   word[38000000 .. 42194304) place frames (16 * 262144 bytes)
;   word[43000000 .. 43032768) edge staging (4096 * 8 bytes)
;   word[43100000 .. 43100128) frame results
;   word[43101000 .. 43101128) frame current blocks
;   byte[43200000 .. 43331072) overlap-safe copy snapshot
;   word[43400000] dynamic block-entry count
;
; The published source evaluator bounds are 16 active machine frames and
; 65,536 dynamic block entries.  Attempting the adjacent value returns 252.

; Source meaning resolves each authored self call directly against the
; independently reconstructed source machine table.  The sibling lowering
; proposition owns the distinct source-to-role-3-row join and static call
; graph; this companion owns the runtime call target and its 16-frame
; observation.
proc v3_call_binding(source,start,count) {
    let i=0 let row=0 let target=0 let owner=src_machine(src_low_g(4),2)
    state rows { to one when (i<l4_count(3)) to bad }
    state one { row=l4_base(3)+i*28 to next when (l4_wbyte(row+4)!=2) to next when (l4_wu32(row+20)!=count) to next when (src_spans_equal(l4_named_span(source,start),l4_named_span(l4_wu32(row+8),l4_wu32(row+16)),count)==0) target=l4_wu32(row+24) to next when (src_machine(target,2)!=owner) word[19990000]=target return 0 }
    state next { i=i+1 to rows }
    state bad { return src_reject() }
}

