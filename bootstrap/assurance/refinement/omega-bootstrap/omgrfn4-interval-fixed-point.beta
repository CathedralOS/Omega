; OMGRFN4 responsibility-4 state-interval least fixed point and replay.
;
; Compose with the source model and CKIR-independent expression parser.  Pass
; mode (23400008 == 1) suppresses only final Add/index proof obligations while
; it monotonically discovers reachable states and convex parameter intervals.
; Replay mode (2) reparses every body in canonical machine/block order with
; those final intervals and restores the obligations.  CKIR/ELF/result bytes
; are semantically opaque.
;
; word[23000000 + state*8] reachable
; word[23100000 + param*8] interval present
; word[23200000 + param*8] low
; word[23300000 + param*8] high
; word[23400000] changed; word[23400008] mode
; word[23400016..40] active arm kind/fact

proc v4_interval_source_reachable() {
    state impossible { to impossible_check when (word[23400016]==1) to entry }
    state impossible_check { to no when (word[23400056]==1) to entry }
    state entry { to yes when (src_low_g(5)==4294967295) }
    return word[23000000+src_low_g(5)*8]
    state yes { return 1 }
    state no { return 0 }
}

proc v4_interval_transfer(target,param,low,high) {
    let declared=src_param(param,3)
    state active { to done when (v4_interval_source_reachable()==0) }
    state clamp_low { to clamp_high when (low>=src_type(declared,7)) low=src_type(declared,7) }
    state clamp_high { to nonempty when (high<=src_type(declared,8)) high=src_type(declared,8) }
    state nonempty { to done when (low>high) to reach }
    state reach { to present when (word[23000000+target*8]==1) word[23000000+target*8]=1 word[23400000]=1 to present }
    state present { to first when (word[23100000+param*8]==0) to low_hull }
    state first { word[23100000+param*8]=1 word[23200000+param*8]=low word[23300000+param*8]=high word[23400000]=1 return 0 }
    state low_hull { to set_low when (low<word[23200000+param*8]) to high_hull }
    state set_low { word[23200000+param*8]=low word[23400000]=1 to high_hull }
    state high_hull { to set_high when (high>word[23300000+param*8]) to done }
    state set_high { word[23300000+param*8]=high word[23400000]=1 to done }
    state done { return 0 }
}

proc v4_interval_reach_target(target) {
    state active { to done when (v4_interval_source_reachable()==0) }
    state reach { to done when (word[23000000+target*8]==1) word[23000000+target*8]=1 word[23400000]=1 }
    state done { return 0 }
}

proc src_low_parse_arguments(target,arm_field) {
    let i=0 let param=src_state(target,3) let count=src_state(target,4) let expected=0
    let low=0 let high=0
    state empty { to close when (word[524416]==41) to loop }
    state loop { to bad when (i>=count) expected=src_param(param+i,3) to expression }
    state expression { to done when (src_low_expression()!=0) low=src_low_g(21) high=src_low_g(22) to assignable }
    state assignable { to structural when (src_type(expected,0)>=4) to scalar }
    state scalar { to analysis when (word[23400008]==1) to bad when (src_low_scalar_assignable(expected,src_low_g(20))==0) to materialize }
    state analysis { to integer_literal when (src_low_g(20)==4294967294) to boolean_literal when (src_low_g(20)==4294967293) to typed_analysis }
    state integer_literal { to bad when (src_type(expected,0)>2) to transfer }
    state boolean_literal { to bad when (src_type(expected,0)!=3) to transfer }
    state typed_analysis { to bad when (src_low_types_same(expected,src_low_g(20))==0) to transfer }
    state transfer { v4_interval_transfer(target,param+i,low,high) to done when (word[10000000]!=0) src_low_gset(27,0) to store }
    state materialize { to done when (src_low_materialize(src_type(expected,9))!=0) to store }
    state structural { to bad when (src_low_types_same(expected,src_low_g(20))==0) to bad when (src_low_g(27)==4294967295) to store }
    state store { src_low_term_set(src_low_g(6),arm_field+i,src_low_g(27)) i=i+1 to comma when (word[524416]==44) to close }
    state comma { src_next() to loop }
    state close { to bad when (word[524416]!=41) to bad when (i!=count) v4_interval_reach_target(target) src_next() src_low_gset(40,i) return 0 }
    state bad { src_reject() }
    state done { return word[10000000] }
}

proc v4_guardless_transition() {
    let target=0 let block=0 let count=0
    word[23400016]=3 word[23400024]=0
    state open { src_next() to bad when (word[524416]!=256) to wildcard }
    state wildcard { to bad when (word[524432]!=1) to bad when (refinement_source_byte(word[524424])!='_') src_next() to dash }
    state dash { to bad when (src_expect_token(45)!=0) to arrow }
    state arrow { to bad when (src_expect_token(62)!=0) to name }
    state name { to bad when (word[524416]!=256) target=src_low_find_state(src_low_g(4),word[524424],word[524432]) to bad when (target==4294967295) block=src_state(target,8) src_next() to paren }
    state paren { to bad when (src_expect_token(40)!=0) to args }
    state args { to bad when (src_low_parse_arguments(target,6)!=0) count=src_low_g(40) to close }
    state close { to bad when (word[524416]!=125) src_next() src_low_term_set(src_low_g(6),0,1) src_low_term_set(src_low_g(6),2,block) src_low_term_set(src_low_g(6),3,count) src_low_gset(13,1) return 0 }
    state bad { return src_reject() }
}

proc src_low_transition() {
    src_next()
    state choose { to guardless when (word[524416]==123) return v4_guarded_transition_after_keyword() }
    state guardless { return v4_guardless_transition() }
}

proc v4_interval_all_bodies() {
    let machine=0 let state_id=0 let end_state=0 let block=0 let i=0
    state init { v3_call_begin() src_low_gset(0,0) src_low_gset(1,0) src_low_gset(2,word[10000040]) src_low_gset(3,0) to parameter_types }
    state parameter_types { to parameter_one when (i<word[10000040]) i=0 to machines }
    state parameter_one { word[18900000+i*8]=src_type(src_param(i,3),9) i=i+1 to parameter_types }
    state machines { to machine_one when (machine<word[10000032]) return 0 }
    state machine_one { to stateless_check when (word[23400008]==1) to machine_setup }
    state stateless_check { to machine_next when (src_machine(machine,13)==0) to machine_setup }
    state machine_setup { src_low_gset(4,machine) src_low_gset(5,4294967295) src_low_gset(7,src_machine(machine,8)) src_low_gset(8,src_machine(machine,7)) block=src_machine(machine,15) src_low_gset(6,block) word[23400016]=0 to entry }
    state entry { to done when (src_low_body(src_machine(machine,10),src_machine(machine,14))!=0) state_id=src_machine(machine,12) end_state=state_id+src_machine(machine,13) to states }
    state states { to state_one when (state_id<end_state) to machine_next }
    state machine_next { machine=machine+1 to machines }
    state state_one { src_low_gset(5,state_id) src_low_gset(7,src_state(state_id,5)) block=src_state(state_id,8) src_low_gset(6,block) word[23400016]=0 to state_body }
    state state_body { to done when (src_low_body(src_state(state_id,6),src_state(state_id,7))!=0) state_id=state_id+1 to states }
    state done { return word[10000000] }
}

proc v4_interval_compute_replay() {
    let i=0 let status=0
    state clear_states { to clear_state when (i<word[10000056]) i=word[10000064] to clear_params }
    state clear_state { word[23000000+i*8]=0 word[19600000+i*32]=4294967295 i=i+1 to clear_states }
    state clear_params { to clear_param when (i<word[10000040]) to pass }
    state clear_param { word[23100000+i*8]=0 i=i+1 to clear_params }
    state pass { word[23400000]=0 word[23400008]=1 status=v4_interval_all_bodies() to done when (status!=0) to changed }
    state changed { to pass when (word[23400000]==1) word[23400008]=2 status=v4_interval_all_bodies() to done }
    state done { return status }
}

proc v4_interval_overlap_selftest() {
    let state_id=0 let param=0 let type_id=0 let high=0
    state states { to one when (state_id<word[10000056]) return 0 }
    state one { to next when (src_state(state_id,4)==0) param=src_state(state_id,3) type_id=src_param(param,3) to next when (src_type(type_id,0)>2) high=src_type(type_id,8) to run }
    state next { state_id=state_id+1 to states }
    state run {
        src_low_gset(5,4294967295) word[23000000+state_id*8]=0 word[23100000+param*8]=0
        v4_interval_transfer(state_id,param,high,high+1)
        to bad when (word[23000000+state_id*8]!=1) to bad when (word[23100000+param*8]!=1)
        to bad when (word[23200000+param*8]!=high) to bad when (word[23300000+param*8]!=high)
        word[23000000+state_id*8]=0 word[23100000+param*8]=0
        v4_interval_transfer(state_id,param,high+1,high+2)
        to bad when (word[23000000+state_id*8]!=0) to bad when (word[23100000+param*8]!=0)
        word[23400016]=1 word[23400056]=1
        v4_interval_reach_target(state_id) v4_interval_transfer(state_id,param,high,high)
        to bad when (word[23000000+state_id*8]!=0) to bad when (word[23100000+param*8]!=0)
        word[23400016]=0 word[23400056]=0
        return 0
    }
    state bad { return src_reject() }
}

proc omgrfn4_r4_interval_check() {
    let status=omgrfn4_component_read() let i=0
    state frame { to done when (status!=0) status=v4_model_prepare() to done when (status!=0) status=v4_interval_overlap_selftest() to done when (status!=0) src_init_words() v3_call_begin() to types }
    state types { src_low_gset(11,4294967295) src_low_gset(12,4294967295) to scan }
    state scan { to one when (i<word[10000144]) to ready }
    state one { to next when (src_ck_type(i,1)!=0) to bool when (src_ck_type(i,0)==3) to u32 when (src_ck_type(i,0)==2) to next }
    state bool { to next when (src_ck_type(i,4)!=0) to next when (src_ck_type(i,5)!=1) src_low_gset(11,i) to next }
    state u32 { to next when (src_ck_type(i,4)!=0) to next when (src_ck_type(i,5)!=2147483647) src_low_gset(12,i) to next }
    state next { i=i+1 to scan }
    state ready { to bad when (src_low_g(11)>=word[10000144]) to bad when (src_low_g(12)>=word[10000144]) status=v4_interval_compute_replay() to done }
    state bad { status=src_reject() }
    state done { return status }
}

proc main() { return omgrfn4_r4_interval_check() }
