}

proc r47_call_join() {
    let call=0 let cursor=0 let op=0 let target=0
    state calls { to one when (call<word[879064]) r47_next_opcode(10,cursor) to bad when (word[951000]!=4294967295) return 0 }
    state one { target=word[894032+call*48] to bad when (target==4294967295) r47_next_opcode(10,cursor) op=word[951000] to bad when (op==4294967295) to bad when (r47_row_word(12,op,32)!=target) cursor=word[951008] call=call+1 to calls }
    state bad { return omgrfn4_l2_reject() }
}

proc r47_transition_sum(machine,source,token) {
    let name=token+1 let i=0 let field=0 let owner=word[884088+machine*128]
