; OMGRFN7 responsibility 4a: independent source-body -> carried CKIR5 join.
;
; Compose this persisted fragment with omgrfn4-source-witness-independent.beta
; and omgrfn7-source-witness-independent.beta, then append a main that calls
; omgrfn7_r4_lowering_check.  It consumes neither ELF nor the claimed result.
; R2/R3 own complete witness and CKIR intrinsic canonicity; this conjunct
; independently reparses exact source bodies and joins their scalar literals,
; case constructors, structural copies/calls, and exhaustive CaseDispatch
; payload bindings to the carried CKIR5 tables.

proc r47_ckir_byte(index) { return omgrfn4_l2_frame_byte(word[500056]+index) }

proc r47_wbyte(index) { return omgrfn4_l2_frame_byte(word[500040]+index) }

proc r47_wu32(at) {
    return r47_wbyte(at)+r47_wbyte(at+1)*256+r47_wbyte(at+2)*65536+r47_wbyte(at+3)*16777216
}

proc r47_decl_source(declaration) { return r47_wu32(word[954224]+declaration*28+8) }
proc r47_decl_name_start(declaration) { return r47_wu32(word[954224]+declaration*28+16) }
proc r47_decl_name_length(declaration) { return r47_wu32(word[954224]+declaration*28+20) }

proc r47_machine_for_decl(declaration) {
    let i=0
    state machines { to one when (i<word[879024]) return 4294967295 }
    state one { to found when (word[884080+i*128]==declaration) i=i+1 to machines }
    state found { return i }
}

; Decode only the OMGRSW3 projections required by body lowering. R2 owns the
; complete source/witness relation and every row guard; this executable still
; performs exact identity/extent checks before consuming that premise.
proc r47_witness_prepare() {
    let n=word[500048] let i=0 let cursor=84 let count=0 let row=0 let at=0 let decl=0 let source=0 let role=0 let target=0
    state size { to bad when (n<84) to magic }
    state magic {
        to bad when (r47_wbyte(0)!='O') to bad when (r47_wbyte(1)!='M')
        to bad when (r47_wbyte(2)!='G') to bad when (r47_wbyte(3)!='R')
        to bad when (r47_wbyte(4)!='S') to bad when (r47_wbyte(5)!='W')
        to bad when (r47_wbyte(6)!='3') to bad when (r47_wbyte(7)!=0)
        to bad when (r47_wbyte(8)!=3) to bad when (r47_wbyte(9)!=0)
        to bad when (r47_wbyte(10)!=0) to bad when (r47_wbyte(11)!=0)
        to bad when (r47_wbyte(12)!=0) to bad when (r47_wbyte(13)!=0)
        to bad when (r47_wbyte(14)!=84) to bad when (r47_wbyte(15)!=0)
        to bad when (r47_wu32(16)!=n) to counts
    }
    state counts { to count_one when (i<15) i=0 to bases }
    state count_one { word[954000+i*8]=r47_wu32(20+i*4) i=i+1 to counts }
    state bases { word[954200]=cursor cursor=cursor+word[954000]*36 word[954208]=cursor cursor=cursor+word[954008]*48 word[954216]=cursor cursor=cursor+word[954016]*28 word[954224]=cursor cursor=cursor+word[954024]*28 to bases2 }
    state bases2 { word[954232]=cursor cursor=cursor+word[954032]*24 word[954240]=cursor cursor=cursor+word[954040]*24 word[954248]=cursor cursor=cursor+word[954048]*24 word[954256]=cursor cursor=cursor+word[954088]*24 to bases3 }
    state bases3 { word[954264]=cursor cursor=cursor+word[954096]*28 word[954272]=cursor cursor=cursor+word[954104]*24 word[954280]=cursor cursor=cursor+word[954056]*40 word[954288]=cursor cursor=cursor+word[954064]*24 to bases4 }
    state bases4 { word[954296]=cursor cursor=cursor+word[954072]*40 word[954304]=cursor cursor=cursor+word[954080]*24 to bad when (cursor!=n) to bad when (word[954000]!=word[500320]) to bad when (r47_wu32(80)!=0) word[879008]=word[954040] word[879016]=word[954048] word[879024]=word[954056] word[879032]=word[954064] word[879040]=word[954072] word[879048]=word[954080] word[879344]=word[954088] word[879352]=word[954096] word[879360]=word[954104] i=0 to records }
    state records { to record when (i<word[879008]) i=0 to fields }
    state record { at=word[954240]+i*24 decl=r47_wu32(at+4) word[881000+i*64]=r47_decl_source(decl) word[881008+i*64]=r47_decl_name_start(decl) word[881016+i*64]=r47_decl_name_length(decl) word[881032+i*64]=r47_wu32(at+12) word[881040+i*64]=r47_wu32(at+16) i=i+1 to records }
    state fields { to field when (i<word[879016]) i=0 to sums }
    state field { at=word[954248]+i*24 word[882000+i*64]=r47_wu32(at+4) word[882008+i*64]=r47_wu32(at+8) word[882016+i*64]=r47_wu32(at+12) word[882032+i*64]=r47_wu32(at+16) word[882040+i*64]=r47_wu32(at+20) i=i+1 to fields }
    state sums { to sum when (i<word[879344]) i=0 to cases }
    state sum { at=word[954256]+i*24 decl=r47_wu32(at+4) word[910000+i*64]=r47_decl_source(decl) word[910008+i*64]=r47_decl_name_start(decl) word[910016+i*64]=r47_decl_name_length(decl) word[910032+i*64]=r47_wu32(at+12) word[910040+i*64]=r47_wu32(at+16) i=i+1 to sums }
    state cases { to case when (i<word[879352]) i=0 to payloads }
    state case { at=word[954264]+i*28 target=r47_wu32(at+4) word[920000+i*64]=target word[920008+i*64]=r47_wu32(at+8) word[920016+i*64]=r47_wu32(at+12) word[920024+i*64]=r47_wu32(at+16) word[920032+i*64]=word[910000+target*64] word[920040+i*64]=r47_wu32(at+20) word[920048+i*64]=r47_wu32(at+24) i=i+1 to cases }
    state payloads { to payload when (i<word[879360]) i=0 to machines }
    state payload { at=word[954272]+i*24 target=r47_wu32(at+4) word[1200000+i*64]=target word[1200008+i*64]=r47_wu32(at+8) word[1200016+i*64]=r47_wu32(at+12) word[1200024+i*64]=word[920032+target*64] word[1200032+i*64]=r47_wu32(at+16) word[1200040+i*64]=r47_wu32(at+20) i=i+1 to payloads }
    state machines { to machine when (i<word[879024]) i=0 to mparams }
    state machine { at=word[954280]+i*40 decl=r47_wu32(at+4) word[884000+i*128]=r47_decl_source(decl) word[884008+i*128]=r47_decl_name_start(decl) word[884016+i*128]=r47_decl_name_length(decl) word[884080+i*128]=decl word[884088+i*128]=r47_wu32(at+8) i=i+1 to machines }
    state mparams { to mparam when (i<word[879032]) i=0 to blocks }
    state mparam { at=word[954288]+i*24 target=r47_wu32(at+4) word[886000+i*48]=target word[886008+i*48]=r47_wu32(at+8) word[886016+i*48]=r47_wu32(at+12) word[886024+i*48]=r47_wu32(at+16) word[886032+i*48]=r47_wu32(at+20) i=i+1 to mparams }
    state blocks { to block when (i<word[879040]) i=0 to bparams }
    state block { at=word[954296]+i*40 target=r47_wu32(at+4) word[888000+i*96]=target word[888008+i*96]=r47_wu32(at+8) word[888024+i*96]=r47_wu32(at+16) word[888032+i*96]=r47_wu32(at+20) word[888040+i*96]=r47_wu32(at+24) word[888048+i*96]=r47_wu32(at+28) i=i+1 to blocks }
    state bparams { to bparam when (i<word[879048]) word[879064]=0 i=0 to bindings }
    state bparam { i=i+1 to bparams }
    state bindings { to binding when (i<word[954016]) return 0 }
    state binding { at=word[954216]+i*28 role=r47_wbyte(at+8) to binding_next when (role!=3) row=word[879064] source=r47_wu32(at+4) word[894000+row*48]=source word[894008+row*48]=r47_wu32(at+12) word[894016+row*48]=r47_wu32(at+16) target=r47_machine_for_decl(r47_wu32(at+20)) to bad when (target==4294967295) word[894032+row*48]=target word[879064]=row+1 to binding_next }
    state binding_next { i=i+1 to bindings }
    state bad { return omgrfn4_l2_reject() }
}

proc r47_ckir_u32(at) {
    return r47_ckir_byte(at)+r47_ckir_byte(at+1)*256
        +r47_ckir_byte(at+2)*65536+r47_ckir_byte(at+3)*16777216
}

proc r47_table_size(table) {
    state choose { to t24 when (table==0) to t20 when (table==1) to t16 when (table==2) to t20 when (table==3) to t20 when (table==4) to t16 when (table==5) to t36 when (table==6) to t20 when (table==7) to t32 when (table==8) to t20 when (table==9) to t24 when (table==10) to t4 when (table==11) to t40 when (table==12) to t4 when (table==13) to t52 when (table==14) to t24 when (table==15) return 12 }
    state t4 { return 4 } state t12 { return 12 } state t16 { return 16 }
    state t20 { return 20 } state t24 { return 24 } state t32 { return 32 }
    state t36 { return 36 } state t40 { return 40 } state t52 { return 52 }
}

proc r47_row_word(table,row,offset) {
    return r47_ckir_u32(word[950200+table*8]+row*r47_table_size(table)+offset)
}

proc r47_ckir_prepare() {
    let n=word[500064] let i=0 let cursor=100 let count=0
    state size { to bad when (n<100) to magic }
    state magic {
        to bad when (r47_ckir_byte(0)!='O') to bad when (r47_ckir_byte(1)!='M')
        to bad when (r47_ckir_byte(2)!='G') to bad when (r47_ckir_byte(3)!='C')
        to bad when (r47_ckir_byte(4)!='K') to bad when (r47_ckir_byte(5)!='I')
        to bad when (r47_ckir_byte(6)!='R') to bad when (r47_ckir_byte(7)!=0)
        to bad when (r47_ckir_byte(8)!=word[879088]-2) to bad when (r47_ckir_byte(9)!=0)
        to bad when (r47_ckir_byte(10)!=0) to bad when (r47_ckir_byte(11)!=0)
        to bad when (r47_ckir_byte(12)!=1) to bad when (r47_ckir_byte(13)!=0)
        to bad when (r47_ckir_byte(15)!=0) to counts
    }
    state counts { to one when (i<19) i=0 to bases }
    state one { count=r47_ckir_u32(24+i*4) word[950000+i*8]=count i=i+1 to counts }
    state bases { to base when (i<17) to exact }
    state base { word[950200+i*8]=cursor cursor=cursor+word[950000+i*8]*r47_table_size(i) i=i+1 to bases }
    state exact {
        to bad when (r47_ckir_u32(20)!=n) to bad when (cursor!=n)
        to bad when (word[950000]!=word[879008]+word[879344]+3)
        to bad when (word[950008]!=word[879008])
        to bad when (word[950016]!=word[879016])
        to bad when (word[950024]!=word[879344])
        to bad when (word[950032]!=word[879352])
        to bad when (word[950040]!=word[879360])
        to bad when (word[950048]!=word[879024])
        to bad when (word[950056]!=word[879032])
        to bad when (word[950064]!=word[879040])
        to bad when (word[950072]!=word[879048]) return 0
    }
    state bad { return omgrfn4_l2_reject() }
}

proc r47_prepare_source() {
    let status=0 let source=0
    word[700000]=0 word[879008]=0 word[879016]=0 word[879024]=0 word[879032]=0
    word[879040]=0 word[879048]=0 word[879064]=0 word[879344]=0 word[879352]=0 word[879360]=0
    status=omgrfn5_r2_read_frame()
    state framed { to done when (status!=0) status=omgrfn4_l2_decode_compilation() to compiled }
    state compiled { to done when (status!=0) status=r47_witness_prepare() to witnessed }
    state witnessed { to done when (status!=0) omgrfn4_r2_init_words() source=0 to tokenize }
    state tokenize { to tokenize_one when (source<word[500320]) source=0 to parse }
    state tokenize_one { status=omgrfn4_r2_tokenize(source) to done when (status!=0) source=source+1 to tokenize }
    state parse { to bad when (word[879344]<1) to done }
    state bad { status=omgrfn4_l2_reject() to done }
    state done { return word[700000] }
}

proc r47_is_true(source,token) {
    let at=omgrfn4_r2_tstart(source,token)
    state length { to no when (omgrfn4_r2_tlen(source,token)!=4) to chars }
    state chars { to no when (omgrfn4_l2_source_byte(source,at)!='t') to no when (omgrfn4_l2_source_byte(source,at+1)!='r') to no when (omgrfn4_l2_source_byte(source,at+2)!='u') to no when (omgrfn4_l2_source_byte(source,at+3)!='e') return 1 }
    state no { return 0 }
}

proc r47_is_false(source,token) {
    let at=omgrfn4_r2_tstart(source,token)
    state length { to no when (omgrfn4_r2_tlen(source,token)!=5) to chars }
    state chars { to no when (omgrfn4_l2_source_byte(source,at)!='f') to no when (omgrfn4_l2_source_byte(source,at+1)!='a') to no when (omgrfn4_l2_source_byte(source,at+2)!='l') to no when (omgrfn4_l2_source_byte(source,at+3)!='s') to no when (omgrfn4_l2_source_byte(source,at+4)!='e') return 1 }
    state no { return 0 }
}

proc r47_is_transition(source,token) {
    let at=omgrfn4_r2_tstart(source,token)
    state shape { to no when (omgrfn4_r2_tlen(source,token)!=10) }
    to no when (omgrfn4_l2_source_byte(source,at)!='t')
    to no when (omgrfn4_l2_source_byte(source,at+1)!='r')
    to no when (omgrfn4_l2_source_byte(source,at+2)!='a')
    to no when (omgrfn4_l2_source_byte(source,at+3)!='n')
    to no when (omgrfn4_l2_source_byte(source,at+4)!='s')
    to no when (omgrfn4_l2_source_byte(source,at+5)!='i')
    to no when (omgrfn4_l2_source_byte(source,at+6)!='t')
    to no when (omgrfn4_l2_source_byte(source,at+7)!='i')
    to no when (omgrfn4_l2_source_byte(source,at+8)!='o')
    to no when (omgrfn4_l2_source_byte(source,at+9)!='n') return 1
    state no { return 0 }
}

; The caller supplies span length in word[955000] to retain the four-argument
; persisted-Beta call ceiling.
proc r47_token_span_equal(source,token,span_source,span_start) {
    let i=0
    state length { to no when (omgrfn4_r2_tlen(source,token)!=word[955000]) to loop }
    state loop { to one when (i<word[955000]) return 1 }
    state one { to no when (omgrfn4_l2_source_byte(source,omgrfn4_r2_tstart(source,token)+i)!=omgrfn4_l2_source_byte(span_source,span_start+i)) i=i+1 to loop }
    state no { return 0 }
}

proc r47_next_opcode(opcode,start) {
    state loop { to one when (start<word[950096]) word[951000]=4294967295 return 0 }
    state one { to found when (r47_ckir_byte(word[950296]+start*40+12)==opcode) start=start+1 to loop }
    state found { word[951000]=start word[951008]=start+1 return 0 }
}

; V9 logical-subject literals are owned in postorder by the logical join.  The
; inherited lexical literal join must therefore skip opcode-1 rows in blocks
; marked as logical while retaining exact custody of every other literal.
proc r49_next_nonlogical_literal(start) {
    let block=0
    state loop { to one when (start<word[950096]) word[951000]=4294967295 return 0 }
    state one { to next when (r47_ckir_byte(word[950296]+start*40+12)!=1) to found when (word[879088]!=9) block=r47_row_word(12,start,8) to next when (word[956900+block*8]==1) to found }
    state next { start=start+1 to loop }
    state found { word[951000]=start word[951008]=start+1 return 0 }
}

proc r47_block_token_start(source,block) {
    let token=0 let byte_start=word[888024+block*96]
    state loop { to one when (token<word[880000+source*8]) return token }
    state one { to found when (omgrfn4_r2_tstart(source,token)>=byte_start) token=token+1 to loop }
    state found { return token }
}

proc r47_literal_join() {
    let block=0 let machine=0 let source=0 let token=0 let end=0 let value=0 let cursor=0 let logical=0
    state blocks { to block_one when (block<word[879040]) r49_next_nonlogical_literal(cursor) to bad when (word[951000]!=4294967295) return 0 }
    state block_one { word[956900+block*8]=0 machine=word[888000+block*96] source=word[884000+machine*128] token=r47_block_token_start(source,block) end=word[888032+block*96] to tokens }
    state tokens { to token_one when (token<word[880000+source*8]) block=block+1 to blocks }
    state token_one { to block_done when (omgrfn4_r2_tstart(source,token)>=end) to transition_token when (word[879088]==9) to ordinary_token }
    state transition_token { to logical_start when (r47_is_transition(source,token)==1) to logical_token when (logical==1) to ordinary_token }
    state logical_start { to logical_yes when (r49_transition_has_logical(source,token)==1) to ordinary_token }
    state logical_yes { logical=1 word[956900+block*8]=1 token=token+1 to tokens }
    state logical_token { to logical_done when (omgrfn4_r2_tkind(source,token)==123) token=token+1 to tokens }
    state logical_done { logical=0 token=token+1 to tokens }
    state ordinary_token { to number when (omgrfn4_r2_tkind(source,token)==257) to true_token when (r47_is_true(source,token)==1) to false_token when (r47_is_false(source,token)==1) token=token+1 to tokens }
    state true_token { to label when (token+1<word[880000+source*8]) to true_value }
    state false_token { to label when (token+1<word[880000+source*8]) to false_value }
    state label { to label_arrow when (omgrfn4_r2_tkind(source,token+1)==45) to bool_value }
    state label_arrow { to skip_label when (token+2<word[880000+source*8]) to bool_value }
    state skip_label { to skip when (omgrfn4_r2_tkind(source,token+2)==62) to bool_value }
    state bool_value { to true_value when (r47_is_true(source,token)==1) to false_value }
    state skip { token=token+1 to tokens }
    state block_done { block=block+1 to blocks }
    state number { omgrfn4_r2_number(source,token) to bad when (word[700000]!=0) value=word[879000] to compare }
    state true_value { value=1 to compare }
    state false_value { value=0 to compare }
    state compare { r49_next_nonlogical_literal(cursor) to bad when (word[951000]==4294967295) to bad when (r47_row_word(12,word[951000],32)!=value) cursor=word[951008] token=token+1 to tokens }
    state bad { return omgrfn4_l2_reject() }
}

proc r47_find_case(sum,source,token) {
    let i=word[910032+sum*64] let end=i+word[910040+sum*64]
    state cases { to one when (i<end) return 4294967295 }
    state one { word[955000]=word[920048+i*64] to found when (r47_token_span_equal(source,token,word[920032+i*64],word[920040+i*64])==1) i=i+1 to cases }
    state found { return i }
}

proc r47_find_sum(source,token) {
    let i=0
    state sums { to one when (i<word[879344]) return 4294967295 }
    state one { word[955000]=word[910016+i*64] to found when (r47_token_span_equal(source,token,word[910000+i*64],word[910008+i*64])==1) i=i+1 to sums }
    state found { return i }
}

; Return one in word[951016], the exact case in word[951024], and the first
; token after the constructor in word[951032]. Named payloads are checked once
; each against declaration spans; arm patterns are excluded by punctuation.
proc r47_constructor(source,token) {
    let sum=0 let case=0 let p=0 let end=0 let payload=0 let seen=0 let depth=0 let named=0 let i=0
    word[951016]=0 word[951024]=4294967295 word[951032]=token+1
    state shape { to done when (token+3>=word[880000+source*8]) to done when (omgrfn4_r2_tkind(source,token)!=256) to done when (omgrfn4_r2_tkind(source,token+1)!=58) to done when (omgrfn4_r2_tkind(source,token+2)!=58) sum=r47_find_sum(source,token) to done when (sum==4294967295) case=r47_find_case(sum,source,token+3) to done when (case==4294967295) payload=word[920024+case*64] p=token+4 to empty when (payload==0) to open }
    state empty { to empty_yes when (omgrfn4_r2_tkind(source,p)==59) to empty_yes when (omgrfn4_r2_tkind(source,p)==44) to empty_yes when (omgrfn4_r2_tkind(source,p)==41) to done }
    state empty_yes { word[951016]=1 word[951024]=case word[951032]=p to done }
    state open { to done when (omgrfn4_r2_tkind(source,p)!=123) depth=1 p=p+1 to entries }
    state entries { to entry when (p<word[880000+source*8]) to done }
    state entry { to nested when (omgrfn4_r2_tkind(source,p)==123) to close when (omgrfn4_r2_tkind(source,p)==125) to name when (depth==1) p=p+1 to entries }
    state nested { depth=depth+1 p=p+1 to entries }
    state close { depth=depth-1 p=p+1 to finish when (depth==0) to entries }
    state name { to advance when (omgrfn4_r2_tkind(source,p)!=256) to advance when (p+1>=word[880000+source*8]) to advance when (omgrfn4_r2_tkind(source,p+1)!=58) i=word[920016+case*64] end=i+payload to find }
    state find { to find_one when (i<end) to done }
    state find_one { word[955000]=word[1200040+i*64] to found when (r47_token_span_equal(source,p,word[1200024+i*64],word[1200032+i*64])==1) i=i+1 to find }
    state found { to done when (word[952000+i*8]==token+1) word[952000+i*8]=token+1 seen=seen+1 p=p+2 to entries }
    state advance { p=p+1 to entries }
    state finish { to done when (seen!=payload) word[951016]=1 word[951024]=case word[951032]=p to done }
    state done { return 0 }
}

proc r47_constructor_join() {
    let block=0 let machine=0 let source=0 let token=0 let end=0 let cursor=0 let copies=0 let i=0
    state clear { to clear_one when (i<4096) to blocks }
    state clear_one { word[952000+i*8]=0 i=i+1 to clear }
    state blocks { to block_one when (block<word[879040]) r47_next_opcode(14,cursor) to bad when (word[951000]!=4294967295) i=0 to copy_count }
    state block_one { machine=word[888000+block*96] source=word[884000+machine*128] token=r47_block_token_start(source,block) end=word[888032+block*96] to tokens }
    state tokens { to token_one when (token<word[880000+source*8]) block=block+1 to blocks }
    state token_one { to block_done when (omgrfn4_r2_tstart(source,token)>=end) r47_constructor(source,token) to next when (word[951016]==0) r47_next_opcode(14,cursor) to bad when (word[951000]==4294967295) to bad when (r47_row_word(12,word[951000],32)!=word[951024]) to bad when (r47_row_word(12,word[951000],28)!=word[920024+word[951024]*64]) cursor=word[951008] to assignment when (omgrfn4_r2_tkind(source,word[951032])==59) to constructor_next }
