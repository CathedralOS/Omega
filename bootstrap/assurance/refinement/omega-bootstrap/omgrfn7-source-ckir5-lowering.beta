    state fields { to field_one when (i<field) return 4294967295 }
    state field_one { word[955000]=word[882040+i*64] to field_found when (r47_token_span_equal(source,name,word[881000+owner*64],word[882032+i*64])==1) i=i+1 to fields }
    state field_found { to bad when (word[882016+i*64]<word[879008]) return word[882016+i*64]-word[879008] }
    state parameter { i=0 to params }
    state params { to param_one when (i<word[879032]) return 4294967295 }
    state param_one { to param_found when (word[886000+i*48]==machine) to param_next }
    state param_next { i=i+1 to params }
    state param_found { word[955000]=word[886032+i*48] to param_next when (r47_token_span_equal(source,name,word[884000+machine*128],word[886024+i*48])==0) to bad when (word[886016+i*48]<word[879008]) return word[886016+i*48]-word[879008] }
    state bad { return 4294967295 }
}

proc r47_find_block(machine,source,token) {
    let i=0
    state blocks { to one when (i<word[879040]) return 4294967295 }
    state one { to next when (word[888000+i*96]!=machine) to next when (word[888048+i*96]==0) word[955000]=word[888048+i*96] to found when (r47_token_span_equal(source,token,source,word[888040+i*96])==1) to next }
    state next { i=i+1 to blocks }
    state found { return i }
}

; R3 owns exact arm-row intrinsic validity. This body join independently binds
; each authored exhaustive case name and payload-pattern arity to the carried
; declaration-order arm identity, while making parameter/place subject choice
; observable in the terminator flags.
proc r47_transition_one(block,machine,source,token) {
    let sum=r47_transition_sum(machine,source,token) let flag=1 let open=token+2
    let term=block let arm_start=0 let arm_count=0 let p=0 let case=0 let seen=0 let payload=0 let i=0 let target_id=0
    state subject { to bad when (sum>=word[879344]) to self when (omgrfn4_r2_is_word(source,token+1,5)==1) to header }
    state self { flag=2 open=token+4 to header }
    state header { to bad when (omgrfn4_r2_tkind(source,open)!=123) to bad when (r47_ckir_byte(word[950312]+term*52+12)!=5) to bad when (r47_ckir_byte(word[950312]+term*52+13)!=flag) arm_start=r47_row_word(14,term,44) arm_count=r47_row_word(14,term,48) to bad when (arm_count!=word[910040+sum*64]) p=open+1 to arms }
    state arms { to finish when (omgrfn4_r2_tkind(source,p)==125) to bad when (p+3>=word[880000+source*8]) to bad when (r47_find_sum(source,p)!=sum) case=r47_find_case(sum,source,p+3) to bad when (case==4294967295) to bad when (word[953000+case*8]==block+1) word[953000+case*8]=block+1 seen=seen+1 payload=word[920024+case*64] p=p+4 i=0 to pattern }
    state pattern { to pattern_open when (payload>0) to arrow }
    state pattern_open { to bad when (omgrfn4_r2_tkind(source,p)!=123) p=p+1 to binds }
    state binds { to bind when (i<payload) to bind_close }
    state bind { word[955000]=word[1200040+(word[920016+case*64]+i)*64] to bad when (r47_token_span_equal(source,p,word[1200024+(word[920016+case*64]+i)*64],word[1200032+(word[920016+case*64]+i)*64])==0) p=p+1 i=i+1 to comma when (i<payload) to binds }
    state comma { to bad when (omgrfn4_r2_tkind(source,p)!=44) p=p+1 to binds }
    state bind_close { to bad when (omgrfn4_r2_tkind(source,p)!=125) p=p+1 to arrow }
    state arrow { to bad when (omgrfn4_r2_tkind(source,p)!=45) to bad when (omgrfn4_r2_tkind(source,p+1)!=62) p=p+2 to target }
    state target { to bad when (omgrfn4_r2_tkind(source,p)!=256) target_id=r47_find_block(machine,source,p) to bad when (target_id==4294967295) to bad when (r47_row_word(15,arm_start+word[920008+case*64],12)!=target_id) p=p+1 to bad when (omgrfn4_r2_tkind(source,p)!=40) p=p+1 i=0 to args }
    state args { to arg when (i<payload) to args_close }
    state arg { word[955000]=word[1200040+(word[920016+case*64]+i)*64] to bad when (r47_token_span_equal(source,p,word[1200024+(word[920016+case*64]+i)*64],word[1200032+(word[920016+case*64]+i)*64])==0) p=p+1 i=i+1 to arg_comma when (i<payload) to args }
    state arg_comma { to bad when (omgrfn4_r2_tkind(source,p)!=44) p=p+1 to args }
    state args_close { to bad when (omgrfn4_r2_tkind(source,p)!=41) i=arm_start+word[920008+case*64] to bad when (r47_row_word(15,i,8)!=case) to bad when (r47_row_word(15,i,20)!=payload) p=p+1 to arm_next }
    state arm_next { to payload_args when (payload>0) to arms }
    state payload_args { i=0 to payload_arg }
    state payload_arg { to arms when (i>=payload) to bad when (r47_ckir_byte(word[950328]+(r47_row_word(15,arm_start+word[920008+case*64],16)+i)*12+4)!=2) to bad when (r47_row_word(16,r47_row_word(15,arm_start+word[920008+case*64],16)+i,8)!=word[920016+case*64]+i) i=i+1 to payload_arg }
    state finish { to bad when (seen!=arm_count) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc r47_transition_join() {
    let block=0 let machine=0 let source=0 let token=0 let end=0 let place_seen=0 let value_seen=0 let status=0 let i=0
    state clear { to clear_one when (i<4096) to blocks }
    state clear_one { word[953000+i*8]=0 i=i+1 to clear }
    state blocks { to one when (block<word[879040]) to exact }
    state one { machine=word[888000+block*96] source=word[884000+machine*128] token=r47_block_token_start(source,block) end=word[888032+block*96] to tokens }
    state tokens { to token_one when (token<word[880000+source*8]) block=block+1 to blocks }
    state token_one { to block_done when (omgrfn4_r2_tstart(source,token)>=end) to transition_kind when (r47_is_transition(source,token)==1) token=token+1 to tokens }
    state transition_kind { to skip_logical when (r49_transition_has_logical(source,token)==1) to transition }
    state skip_logical { token=token+1 to tokens }
    state transition { status=r47_transition_one(block,machine,source,token) to done when (status!=0) to place when (r47_ckir_byte(word[950312]+block*52+13)==2) value_seen=1 token=token+1 to tokens }
    state place { place_seen=1 token=token+1 to tokens }
    state block_done { block=block+1 to blocks }
    state exact { to bad when (value_seen!=1) to bad when (place_seen!=1) return 0 }
    state bad { return omgrfn4_l2_reject() }
    state done { return status }
}

; A scalar Boolean transition is reconstructed by the logical-expression join
; below rather than by the inherited sum-transition join.  Scan only the
; authored subject, stopping at the transition-arm opening brace.
proc r49_transition_has_logical(source,token) {
    let count=word[880000+source*8]
    state next { token=token+1 to loop }
    state loop { to no when (token>=count) to no when (omgrfn4_r2_tkind(source,token)==123) to yes when (omgrfn4_r2_tkind(source,token)==33) to amp when (omgrfn4_r2_tkind(source,token)==38) to bar when (omgrfn4_r2_tkind(source,token)==124) token=token+1 to loop }
    state amp { to yes when (token+1<count) to no }
    state bar { to yes when (token+1<count) to no }
    state yes { return 1 }
    state no { return 0 }
}

; Exact authored-prefix-to-opcode join for V8.  R3/R5 own the intrinsic row
; envelope and value visibility; this owner proves that every authored `!` in
; an exact body produces one distinct opcode-15 row, with no folding.  One
; adjacent source pair must correspond to the inner-result/outer-operand chain.
proc r48_logical_join() {
    let block=0 let machine=0 let source=0 let token=0 let end=0
    let bangs=0 let adjacent=0 let op=0 let op_count=0 let first=0 let second=0
    state blocks { to block_one when (block<word[879040]) to operations }
    state block_one {
        machine=word[888000+block*96] source=word[884000+machine*128]
        token=r47_block_token_start(source,block) end=word[888032+block*96]
        to tokens
    }
    state tokens { to token_one when (token<word[880000+source*8]) block=block+1 to blocks }
    state token_one {
        to block_done when (omgrfn4_r2_tstart(source,token)>=end)
        to bang when (omgrfn4_r2_tkind(source,token)==33)
        token=token+1 to tokens
    }
    state bang {
        bangs=bangs+1
        to adjacent_bang when (token+1<word[880000+source*8])
        token=token+1 to tokens
    }
    state adjacent_bang {
        to adjacent_yes when (omgrfn4_r2_tkind(source,token+1)==33)
        token=token+1 to tokens
    }
    state adjacent_yes { adjacent=1 token=token+1 to tokens }
    state block_done { block=block+1 to blocks }
    state operations { to operation when (op<word[950096]) to exact }
    state operation {
        to logical when (r47_ckir_byte(word[950296]+op*40+12)==15)
        op=op+1 to operations
    }
    state logical {
        to remember_first when (op_count==0)
        to remember_second when (op_count==1)
        op_count=op_count+1 op=op+1 to operations
    }
    state remember_first { first=op op_count=op_count+1 op=op+1 to operations }
    state remember_second { second=op op_count=op_count+1 op=op+1 to operations }
    state exact {
        to bad when (bangs<2)
        to bad when (bangs!=op_count)
        to bad when (adjacent!=1)
        to bad when (second!=first+1)
        to bad when (r47_row_word(13,r47_row_word(12,second,24),0)!=r47_row_word(12,first,16))
        return 0
    }
    state bad { return omgrfn4_l2_reject() }
}

; OMGRFN9 source-to-CKIR logical-binary join.  The expected opcode stream is
; independently rebuilt from exact paired punctuation.  `&&` rows are emitted
; as their tighter-precedence segments are completed; a pending `||` row is
; emitted only after the following `&&` segment, which also makes left
; association observable.  Comparing the complete filtered stream prohibits
; folding, operator swaps, and order/precedence substitutions.
proc r49_emit_logical_primary(source,start,end) {
    let token=start let bangs=0
    state primary { to primary_one when (token<end) to bangs_out }
    state primary_one { to bang when (omgrfn4_r2_tkind(source,token)==33) to true_value when (r47_is_true(source,token)==1) to false_value when (r47_is_false(source,token)==1) token=token+1 to primary }
    state bang { bangs=bangs+1 token=token+1 to primary }
    state true_value { word[956000+word[956800]*8]=101 word[956800]=word[956800]+1 token=token+1 to primary }
    state false_value { word[956000+word[956800]*8]=100 word[956800]=word[956800]+1 token=token+1 to primary }
    state bangs_out { to bang_out when (bangs>0) return 0 }
    state bang_out { word[956000+word[956800]*8]=15 word[956800]=word[956800]+1 bangs=bangs-1 to bangs_out }
}

; The producer materializes the first binary at a precedence level by visiting
; its right operand, then its initial left operand, then the operation.  Each
; subsequent left-associated suffix visits only its new right operand before
; the operation.  Rebuild that exact order without importing producer state.
proc r49_emit_logical_and(source,start,end) {
    let operator=start let next=0 let right_end=0 let status=0
    state first { to first_one when (operator<end) status=r49_emit_logical_primary(source,start,end) to bad when (status!=0) return 0 }
    state first_one { to first_found when (omgrfn4_r2_tkind(source,operator)==38) operator=operator+1 to first }
    state first_found { to bad when (operator+1>=end) to bad when (omgrfn4_r2_tkind(source,operator+1)!=38) next=operator+2 to find_next }
    state find_next { right_end=next to find_one }
    state find_one { to emit_first when (right_end>=end) to emit_first when (omgrfn4_r2_tkind(source,right_end)==38) right_end=right_end+1 to find_one }
    state emit_first { status=r49_emit_logical_primary(source,next,right_end) to bad when (status!=0) status=r49_emit_logical_primary(source,start,operator) to bad when (status!=0) word[956000+word[956800]*8]=16 word[956800]=word[956800]+1 to suffix }
    state suffix { to suffix_operator when (right_end<end) return 0 }
    state suffix_operator { to bad when (right_end+1>=end) to bad when (omgrfn4_r2_tkind(source,right_end+1)!=38) next=right_end+2 to find_suffix }
    state find_suffix { right_end=next to find_suffix_one }
    state find_suffix_one { to emit_suffix when (right_end>=end) to emit_suffix when (omgrfn4_r2_tkind(source,right_end)==38) right_end=right_end+1 to find_suffix_one }
    state emit_suffix { status=r49_emit_logical_primary(source,next,right_end) to bad when (status!=0) word[956000+word[956800]*8]=16 word[956800]=word[956800]+1 to suffix }
    state bad { return omgrfn4_l2_reject() }
}

proc r49_emit_logical_expression(source,start,end) {
    let operator=start let next=0 let right_end=0 let status=0
    state first { to first_one when (operator<end) status=r49_emit_logical_and(source,start,end) to bad when (status!=0) return 0 }
    state first_one { to first_found when (omgrfn4_r2_tkind(source,operator)==124) operator=operator+1 to first }
    state first_found { to bad when (operator+1>=end) to bad when (omgrfn4_r2_tkind(source,operator+1)!=124) next=operator+2 to find_next }
    state find_next { right_end=next to find_one }
    state find_one { to emit_first when (right_end>=end) to emit_first when (omgrfn4_r2_tkind(source,right_end)==124) right_end=right_end+1 to find_one }
    state emit_first { status=r49_emit_logical_and(source,next,right_end) to bad when (status!=0) status=r49_emit_logical_and(source,start,operator) to bad when (status!=0) word[956000+word[956800]*8]=17 word[956800]=word[956800]+1 to suffix }
    state suffix { to suffix_operator when (right_end<end) return 0 }
    state suffix_operator { to bad when (right_end+1>=end) to bad when (omgrfn4_r2_tkind(source,right_end+1)!=124) next=right_end+2 to find_suffix }
    state find_suffix { right_end=next to find_suffix_one }
    state find_suffix_one { to emit_suffix when (right_end>=end) to emit_suffix when (omgrfn4_r2_tkind(source,right_end)==124) right_end=right_end+1 to find_suffix_one }
    state emit_suffix { status=r49_emit_logical_and(source,next,right_end) to bad when (status!=0) word[956000+word[956800]*8]=17 word[956800]=word[956800]+1 to suffix }
    state bad { return omgrfn4_l2_reject() }
}

proc r49_logical_operation_code(op) {
    let kind=r47_ckir_byte(word[950296]+op*40+12) let type_id=0
    state choose { to direct when (kind==15) to direct when (kind==16) to direct when (kind==17) to literal when (kind==1) return 0 }
    state direct { return kind }
    state literal { type_id=r47_row_word(12,op,20) to no when (type_id>=word[950000]) to no when (r47_ckir_byte(word[950200]+type_id*24+4)!=3) to no when (r47_row_word(12,op,32)>1) return 100+r47_row_word(12,op,32) }
    state no { return 0 }
}

proc r49_logical_binary_join() {
    let block=0 let machine=0 let source=0 let token=0 let end=0 let expression=0
    let op=0 let actual=0 let code=0 let status=0 let total=0
    state blocks { to block_one when (block<word[879040]) to exact }
    state block_one { machine=word[888000+block*96] source=word[884000+machine*128] token=r47_block_token_start(source,block) end=word[888032+block*96] expression=0 word[956800]=0 to tokens }
    state tokens { to token_one when (token<word[880000+source*8]) to compare }
    state token_one { to compare when (omgrfn4_r2_tstart(source,token)>=end) to transition when (r47_is_transition(source,token)==1) token=token+1 to tokens }
    state transition { to next when (r49_transition_has_logical(source,token)==0) expression=token+1 to seek_open }
    state seek_open { to bad when (token>=word[880000+source*8]) to emit when (omgrfn4_r2_tkind(source,token)==123) token=token+1 to seek_open }
    state emit { status=r49_emit_logical_expression(source,expression,token) to bad when (status!=0) total=total+1 token=token+1 to tokens }
    state next { token=token+1 to tokens }
    state compare { to compare_one when (op<word[950096]) to compared }
    state compare_one { to compare_next when (r47_row_word(12,op,8)!=block) code=r49_logical_operation_code(op) to compare_next when (code==0) to empty_expected when (word[956800]==0) to bad when (actual>=word[956800]) to bad when (word[956000+actual*8]!=code) actual=actual+1 to compare_next }
    state empty_expected { to bad when (code==16) to bad when (code==17) to compare_next }
    state compare_next { op=op+1 to compare }
    state compared { to bad when (actual!=word[956800]) block=block+1 op=0 actual=0 to blocks }
    state exact { to bad when (total<1) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc omgrfn7_r4_lowering_check() {
    let status=r47_prepare_source()
    state source { to done when (status!=0) to bad when (word[879088]!=7) status=r47_ckir_prepare() to literals }
    state literals { to done when (status!=0) status=r47_literal_join() to constructors }
    state constructors { to done when (status!=0) status=r47_constructor_join() to calls }
    state calls { to done when (status!=0) status=r47_call_join() to transitions }
    state transitions { to done when (status!=0) status=r47_transition_join() to done }
    state bad { return omgrfn4_l2_reject() }
    state done { return status }
}

proc omgrfn8_r4_lowering_check() {
    let status=r47_prepare_source()
    state source { to done when (status!=0) to bad when (word[879088]!=8) status=r47_ckir_prepare() to literals }
    state literals { to done when (status!=0) status=r47_literal_join() to constructors }
    state constructors { to done when (status!=0) status=r47_constructor_join() to calls }
    state calls { to done when (status!=0) status=r47_call_join() to transitions }
    state transitions { to done when (status!=0) status=r47_transition_join() to logical }
    state logical { to done when (status!=0) status=r48_logical_join() to done }
    state bad { return omgrfn4_l2_reject() }
    state done { return status }
}

proc omgrfn9_r4_lowering_check() {
    let status=r47_prepare_source()
    state source { to done when (status!=0) to bad when (word[879088]!=9) status=r47_ckir_prepare() to literals }
    state literals { to done when (status!=0) status=r47_literal_join() to constructors }
    state constructors { to done when (status!=0) status=r47_constructor_join() to calls }
    state calls { to done when (status!=0) status=r47_call_join() to transitions }
    state transitions { to done when (status!=0) status=r47_transition_join() to logical }
    state logical { to done when (status!=0) status=r49_logical_binary_join() to done }
    state bad { return omgrfn4_l2_reject() }
    state done { return status }
}
