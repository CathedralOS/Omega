; Identifier-byte and exact `let` keyword summaries.
;
; IDCH is conditional on an identifier slice and 0<=k<IDLEN; it returns the
; exact source byte at IDOFF+k. ILET first requires IDLEN==3, then short-circuits
; through bytes `l`, `e`, and `t`. It returns one exactly for that identifier and
; zero otherwise. Both procedures terminate, emit nothing, preserve source,
; input, cursor, identifier globals, and compiler state, and restore the caller
; frame. The length guard makes all three id_char calls in-bounds.
;
; Fresh cells:
;   public IDCH / ILET tokens             527184/527192
;   identifier slice / k bound / byte     527200/527208/527216
;   quiet state / frame                   527224/527312
;   length / l / e / t relations          527232..527256
;   selected return                       527264
;   five is_let completion flags          527272..527304
;
; Equality tags: 1=mismatch, 2=match. Return tags: 1=zero, 2=one.

let_keyword_summary_init:
        call let_keyword_require_shape
        call let_keyword_prove_id_char
        call let_keyword_prove_is_let
        jmp scan_owned_effects_init

let_keyword_require_slice_schema:
        imm r20, 526792
        imm r21, 1396984146           ; RIDS
        call cursor_require_cell
        ret

let_keyword_prove_id_char:
        imm r1, 527184
        imm r2, 0
        store r1, r2
        call let_keyword_require_slice_schema
        imm r1, 527200
        imm r2, 1                    ; checked IDOFF/IDLEN source slice premise
        store r1, r2
        imm r1, 527208
        store r1, r2                  ; checked 0<=k<IDLEN premise
        imm r1, 527216
        store r1, r2                  ; exact byte SRC[IDOFF+k]
        imm r1, 527224
        store r1, r2                  ; source/input/cursor/compiler state quiet
        imm r1, 527312
        store r1, r2                  ; id_char caller frame restored
        call let_keyword_require_id_char_relation
        imm r1, 527184
        imm r2, 1212367945            ; IDCH
        store r1, r2
        ret

let_keyword_require_id_char_relation:
        imm r20, 527200
        imm r21, 1
        call cursor_require_cell
        imm r20, 527208
        imm r21, 1
        call cursor_require_cell
        imm r20, 527216
        imm r21, 1
        call cursor_require_cell
        imm r20, 527224
        imm r21, 1
        call cursor_require_cell
        imm r20, 527312
        imm r21, 1
        call cursor_require_cell
        ret

let_keyword_prove_is_let:
        imm r1, 527192
        imm r2, 0
        store r1, r2
        imm r1, 527272
        store r1, r2
        imm r1, 527280
        store r1, r2
        imm r1, 527288
        store r1, r2
        imm r1, 527296
        store r1, r2
        imm r1, 527304
        store r1, r2
        call let_keyword_prove_length_mismatch
        call let_keyword_prove_l_mismatch
        call let_keyword_prove_e_mismatch
        call let_keyword_prove_t_mismatch
        call let_keyword_prove_match
        call let_keyword_publish_is_let
        ret

let_keyword_reset_case:
        imm r20, 527184
        imm r21, 1212367945            ; IDCH
        call cursor_require_cell
        imm r20, 527200
        imm r21, 1
        call cursor_require_cell
        imm r20, 527224
        imm r21, 1
        call cursor_require_cell
        imm r1, 527232
        imm r2, 0
        store r1, r2
        imm r1, 527240
        store r1, r2
        imm r1, 527248
        store r1, r2
        imm r1, 527256
        store r1, r2
        imm r1, 527264
        store r1, r2
        ret

let_keyword_prove_length_mismatch:
        call let_keyword_reset_case
        imm r1, 527232
        imm r2, 1                    ; checked IDLEN != 3 short circuit
        store r1, r2
        imm r1, 527264
        store r1, r2                  ; return zero
        imm r20, 527232
        imm r21, 1
        call cursor_require_cell
        call let_keyword_require_zero_result
        imm r1, 527272
        imm r2, 1
        store r1, r2
        ret

let_keyword_prove_l_mismatch:
        call let_keyword_reset_case
        imm r1, 527232
        imm r2, 2                    ; checked IDLEN == 3
        store r1, r2
        imm r20, 0
        call let_keyword_call_id_char
        imm r1, 527240
        imm r2, 1                    ; checked byte zero != 'l'
        store r1, r2
        imm r1, 527264
        store r1, r2                  ; return zero
        imm r20, 527232
        imm r21, 2
        call cursor_require_cell
        imm r20, 527240
        imm r21, 1
        call cursor_require_cell
        call let_keyword_require_zero_result
        imm r1, 527280
        imm r2, 1
        store r1, r2
        ret

let_keyword_prove_e_mismatch:
        call let_keyword_reset_case
        imm r1, 527232
        imm r2, 2
        store r1, r2
        imm r20, 0
        call let_keyword_call_id_char
        imm r1, 527240
        imm r2, 2                    ; byte zero == 'l'
        store r1, r2
        imm r20, 1
        call let_keyword_call_id_char
        imm r1, 527248
        imm r2, 1                    ; checked byte one != 'e'
        store r1, r2
        imm r1, 527264
        store r1, r2                  ; return zero
        imm r20, 527232
        imm r21, 2
        call cursor_require_cell
        imm r20, 527240
        imm r21, 2
        call cursor_require_cell
        imm r20, 527248
        imm r21, 1
        call cursor_require_cell
        call let_keyword_require_zero_result
        imm r1, 527288
        imm r2, 1
        store r1, r2
        ret

let_keyword_prove_t_mismatch:
        call let_keyword_reset_case
        imm r1, 527232
        imm r2, 2
        store r1, r2
        imm r20, 0
        call let_keyword_call_id_char
        imm r1, 527240
        imm r2, 2
        store r1, r2                  ; prior `l` match
        imm r20, 1
        call let_keyword_call_id_char
        imm r1, 527248
        imm r2, 2
        store r1, r2                  ; prior `e` match
        imm r20, 2
        call let_keyword_call_id_char
        imm r1, 527256
        imm r2, 1                    ; checked byte two != 't'
        store r1, r2
        imm r1, 527264
        store r1, r2                  ; return zero
        imm r20, 527232
        imm r21, 2
        call cursor_require_cell
        imm r20, 527240
        imm r21, 2
        call cursor_require_cell
        imm r20, 527248
        imm r21, 2
        call cursor_require_cell
        imm r20, 527256
        imm r21, 1
        call cursor_require_cell
        call let_keyword_require_zero_result
        imm r1, 527296
        imm r2, 1
        store r1, r2
        ret

let_keyword_prove_match:
        call let_keyword_reset_case
        imm r1, 527232
        imm r2, 2
        store r1, r2
        imm r20, 0
        call let_keyword_call_id_char
        imm r1, 527240
        imm r2, 2
        store r1, r2                  ; `l`
        imm r20, 1
        call let_keyword_call_id_char
        imm r1, 527248
        imm r2, 2
        store r1, r2                  ; `e`
        imm r20, 2
        call let_keyword_call_id_char
        imm r1, 527256
        imm r2, 2
        store r1, r2                  ; `t`
        imm r1, 527264
        store r1, r2                  ; checked exact let returns one
        call let_keyword_require_one_result
        imm r1, 527304
        imm r2, 1
        store r1, r2
        ret

; Exact call/argument rows select literal indices 0,1,2. IDLEN==3 proves each
; selected k is within the identifier slice before importing IDCH.
let_keyword_call_id_char:
        mov r25, r20
        imm r20, 527232
        imm r21, 2
        call cursor_require_cell
        imm r1, 0
        jlt r25, r1, reject
        imm r1, 3
        jlt r25, r1, let_keyword_id_char_index_ok
        jmp reject
let_keyword_id_char_index_ok:
        imm r20, 527184
        imm r21, 1212367945            ; IDCH
        call cursor_require_cell
        imm r1, 527208
        imm r2, 1                    ; checked call-specific k bound
        store r1, r2
        imm r1, 527216
        store r1, r2                  ; selected exact identifier byte
        call let_keyword_require_id_char_relation
        ret

let_keyword_require_zero_result:
        imm r20, 527264
        imm r21, 1
        call cursor_require_cell
        imm r20, 527224
        imm r21, 1
        call cursor_require_cell
        imm r20, 527312
        imm r21, 1
        call cursor_require_cell
        ret

let_keyword_require_one_result:
        imm r20, 527232
        imm r21, 2
        call cursor_require_cell
        imm r20, 527240
        imm r21, 2
        call cursor_require_cell
        imm r20, 527248
        imm r21, 2
        call cursor_require_cell
        imm r20, 527256
        imm r21, 2
        call cursor_require_cell
        imm r20, 527264
        imm r21, 2
        call cursor_require_cell
        imm r20, 527312
        imm r21, 1
        call cursor_require_cell
        ret

let_keyword_publish_is_let:
        imm r20, 527272
        imm r21, 1
        call cursor_require_cell
        imm r20, 527280
        imm r21, 1
        call cursor_require_cell
        imm r20, 527288
        imm r21, 1
        call cursor_require_cell
        imm r20, 527296
        imm r21, 1
        call cursor_require_cell
        imm r20, 527304
        imm r21, 1
        call cursor_require_cell
        imm r1, 527192
        imm r2, 1413827657            ; ILET
        store r1, r2
        ret
