; Exact lower proposition schemas used by the complete p68 relation.
;
; Rows at 607000+32*i contain id, external cell, tag, and owner class.  They
; introduce hypotheses only.  The gate must discharge the publications over
; the same immutable bundle before applying PPRC.

parse_proc_antecedent_init:
        imm r20, 606000
        imm r21, 1481789520             ; PPRX
        call exact_require_cell

        imm r10, 1
        imm r11, 526216
        imm r12, 1398231888             ; SWSQ
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 2
        imm r11, 526792
        imm r12, 1396984146             ; RIDS
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 3
        imm r11, 526960
        imm r12, 1397774405             ; EXPS
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 4
        imm r11, 527064
        imm r12, 1397506884             ; DCLS
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 5
        imm r11, 527728
        imm r12, 1129206867             ; CNTS
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 6
        imm r11, 527928
        imm r12, 1347178320             ; PLOP
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 7
        imm r11, 528072
        imm r12, 1346584912             ; PCAP
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 8
        imm r11, 528664
        imm r12, 1398294096             ; PFXS
        imm r13, 1
        call parse_proc_store_antecedent
        imm r10, 9
        imm r11, 546228
        imm r12, 1279611475             ; SREL
        imm r13, 2
        call parse_proc_store_antecedent
        imm r10, 10
        imm r11, 560440
        imm r12, 1146045008             ; PBOD
        imm r13, 3
        call parse_proc_store_antecedent
        imm r10, 11
        imm r11, 632024
        imm r12, 1296388676             ; DREM, remaining-let rank theorem
        imm r13, 4
        call parse_proc_store_antecedent

        call parse_proc_require_antecedents
        call parse_proc_introduce_remaining_let_hypothesis
        imm r1, 606008
        imm r2, 1312903248             ; PPAN
        store r1, r2
        jmp parse_proc_shape_init

; r10=id,r11=external publication cell,r12=tag,r13=owner class.
parse_proc_store_antecedent:
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 32
        mul r20, r1
        imm r1, 607000
        add r20, r1
        store r20, r10
        imm r1, 8
        add r20, r1
        store r20, r11
        add r20, r1
        store r20, r12
        add r20, r1
        store r20, r13
        ret

parse_proc_require_antecedents:
        imm r10, 1
parse_proc_require_antecedent_loop:
        imm r1, 12
        jlt r10, r1, parse_proc_require_antecedent_row
        ret
parse_proc_require_antecedent_row:
        call parse_proc_select_antecedent
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 32
        mul r20, r1
        imm r1, 607000
        add r20, r1
        mov r21, r10
        call exact_require_cell
        imm r1, 8
        add r20, r1
        mov r21, r11
        call exact_require_cell
        add r20, r1
        mov r21, r12
        call exact_require_cell
        add r20, r1
        mov r21, r13
        call exact_require_cell
        imm r1, 1
        add r10, r1
        jmp parse_proc_require_antecedent_loop

parse_proc_select_antecedent:
        imm r1, 1
        jeq r10, r1, parse_proc_ant_swsq
        imm r1, 2
        jeq r10, r1, parse_proc_ant_rids
        imm r1, 3
        jeq r10, r1, parse_proc_ant_exps
        imm r1, 4
        jeq r10, r1, parse_proc_ant_dcls
        imm r1, 5
        jeq r10, r1, parse_proc_ant_cnts
        imm r1, 6
        jeq r10, r1, parse_proc_ant_plop
        imm r1, 7
        jeq r10, r1, parse_proc_ant_pcap
        imm r1, 8
        jeq r10, r1, parse_proc_ant_pfxs
        imm r1, 9
        jeq r10, r1, parse_proc_ant_srel
        imm r1, 10
        jeq r10, r1, parse_proc_ant_pbod
        imm r1, 11
        jeq r10, r1, parse_proc_ant_drem
        jmp reject
parse_proc_ant_swsq:
        imm r11, 526216
        imm r12, 1398231888
        imm r13, 1
        ret
parse_proc_ant_rids:
        imm r11, 526792
        imm r12, 1396984146
        imm r13, 1
        ret
parse_proc_ant_exps:
        imm r11, 526960
        imm r12, 1397774405
        imm r13, 1
        ret
parse_proc_ant_dcls:
        imm r11, 527064
        imm r12, 1397506884
        imm r13, 1
        ret
parse_proc_ant_cnts:
        imm r11, 527728
        imm r12, 1129206867
        imm r13, 1
        ret
parse_proc_ant_plop:
        imm r11, 527928
        imm r12, 1347178320
        imm r13, 1
        ret
parse_proc_ant_pcap:
        imm r11, 528072
        imm r12, 1346584912
        imm r13, 1
        ret
parse_proc_ant_pfxs:
        imm r11, 528664
        imm r12, 1398294096
        imm r13, 1
        ret
parse_proc_ant_srel:
        imm r11, 546228
        imm r12, 1279611475
        imm r13, 2
        ret
parse_proc_ant_pbod:
        imm r11, 560440
        imm r12, 1146045008
        imm r13, 3
        ret
parse_proc_ant_drem:
        imm r11, 632024
        imm r12, 1296388676
        imm r13, 4
        ret

; DREM is introduced only as a hypothesis of the complete PPRC implication.
; A separate owner proves it from CNTS/PCAP/SREL over the identical bundle.
parse_proc_introduce_remaining_let_hypothesis:
        imm r20, 607336               ; DREM row tag
        imm r21, 1296388676
        call exact_require_cell
        imm r1, 606040
        imm r2, 1296388676             ; local hypothetical DREM marker
        store r1, r2
        ret
