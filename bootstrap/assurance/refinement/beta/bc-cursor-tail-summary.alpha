; Bounded cursor-tail adapters for Checker E.
;
; Existing ADVE/SWSQ/EXPS deliberately describe ordinary CUR<=LEN calls.
; emit_str_body has two honest ways to reach LEN+1: its blind opening advance
; when entered at LEN, and the second advance of a trailing backslash.  These
; three consequences recheck the exact bodies and publish only the needed
; bounded extensions:
;
;   ADVX: 0<=CUR<=LEN<=CAP  -> CUR'=CUR+1<=LEN+1
;   SWSX: CUR=LEN+1         -> skip_ws returns zero, CUR unchanged
;   EXPX: CUR=LEN+1,ch=41   -> expect returns zero, CUR unchanged
;
; They do not widen the ordinary public summaries or admit arbitrary high-bit
; cursor words.  Work cells are 534888..<535144.

cursor_tail_summary_init:
        call cursor_tail_require_root
        call cursor_tail_prove_advx
        call cursor_tail_prove_swsx
        call cursor_tail_prove_expx
        jmp label_counter_summary_init

cursor_tail_require_root:
        imm r20, 534800
        imm r21, 1163022164             ; EROOT
        call exact_require_cell
        imm r20, 525744
        imm r21, 1                     ; successful source segment
        call exact_require_cell
        ret

cursor_tail_prove_advx:
        imm r1, 534808
        imm r2, 0
        store r1, r2
        imm r20, 525968
        imm r21, 1094992965             ; ADVE
        call exact_require_cell
        call cursor_require_adv_shape
        call cursor_tail_require_root
        imm r1, 534888
        imm r2, 1                     ; 0<=CUR<=LEN<=CAP
        store r1, r2
        imm r1, 534896
        store r1, r2                  ; exact CUR+1<=LEN+1<=CAP+1
        imm r1, 534904
        store r1, r2                  ; only CUR changes; frame restored
        imm r1, 534912
        store r1, r2                  ; exact +1 body/return composition
        call cursor_tail_require_advx_work
        imm r1, 534808
        imm r2, 1094994008             ; ADVX
        store r1, r2
        ret

cursor_tail_require_advx_work:
        imm r20, 534888
        imm r21, 1
        call exact_require_cell
        imm r20, 534896
        call exact_require_cell
        imm r20, 534904
        call exact_require_cell
        imm r20, 534912
        call exact_require_cell
        ret

cursor_tail_prove_swsx:
        imm r1, 534816
        imm r2, 0
        store r1, r2
        imm r20, 526216
        imm r21, 1398231888             ; SWSQ exact ordinary theorem/shape
        call exact_require_cell
        imm r20, 525960
        imm r21, 1128421445             ; CBLE includes nonnegative miss
        call exact_require_cell
        imm r20, 525976
        imm r21, 1397769539             ; SPCE
        call exact_require_cell
        call skip_step_require_shape
        call skip_require_shape
        imm r1, 534920
        imm r2, 1                     ; selected CUR=LEN+1
        store r1, r2
        imm r1, 534928
        store r1, r2                  ; cbyte miss returns zero
        imm r1, 534936
        store r1, r2                  ; is_space(0)=0 and zero!=';'
        imm r1, 534944
        store r1, r2                  ; skip_ws_step returns zero
        imm r1, 534952
        store r1, r2                  ; outer loop takes its exit
        imm r1, 534960
        store r1, r2                  ; CUR/trace/state quiet; frame restored
        call cursor_tail_require_swsx_work
        imm r1, 534816
        imm r2, 1398231896             ; SWSX
        store r1, r2
        ret

cursor_tail_require_swsx_work:
        imm r20, 534920
        imm r21, 1
        call exact_require_cell
        imm r20, 534928
        call exact_require_cell
        imm r20, 534936
        call exact_require_cell
        imm r20, 534944
        call exact_require_cell
        imm r20, 534952
        call exact_require_cell
        imm r20, 534960
        call exact_require_cell
        ret

cursor_tail_prove_expx:
        imm r1, 534824
        imm r2, 0
        store r1, r2
        imm r20, 526960
        imm r21, 1397774405             ; EXPS exact ordinary theorem/shape
        call exact_require_cell
        imm r20, 534816
        imm r21, 1398231896             ; SWSX
        call exact_require_cell
        call expect_require_shape
        imm r1, 534968
        imm r2, 1                     ; selected CUR=LEN+1
        store r1, r2
        imm r1, 534976
        store r1, r2                  ; exact nonzero delimiter 41
        imm r1, 534984
        store r1, r2                  ; skip_ws preserves overshot cursor
        imm r1, 534992
        store r1, r2                  ; cbyte miss is exact zero
        imm r1, 535000
        store r1, r2                  ; zero != 41 mismatch
        imm r1, 535008
        store r1, r2                  ; no adv call executes
        imm r1, 535016
        store r1, r2                  ; result zero/CUR quiet/frame restored
        call cursor_tail_require_expx_work
        imm r1, 534824
        imm r2, 1481660485             ; EXPX
        store r1, r2
        ret

cursor_tail_require_expx_work:
        imm r20, 534968
        imm r21, 1
        call exact_require_cell
        imm r20, 534976
        call exact_require_cell
        imm r20, 534984
        call exact_require_cell
        imm r20, 534992
        call exact_require_cell
        imm r20, 535000
        call exact_require_cell
        imm r20, 535008
        call exact_require_cell
        imm r20, 535016
        call exact_require_cell
        ret
