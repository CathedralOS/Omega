; Lower-rooted structural verifier for an Alpha tape supplied on stdin.
;
; Starting at byte zero, walk the statically reachable control-flow graph. Every
; reachable instruction must be completely encoded inside the tape; every direct
; branch/call target and fallthrough must start an instruction; and no two
; reachable instructions may overlap. It then reconstructs procedure regions
; from direct-call entries and checks static call/return discipline: only the
; root halts, callees return, call continuations stay in their caller, and no
; non-call edge crosses a procedure boundary. Unreachable bytes are permitted
; because Alpha programs use jump-skipped inline data.
;
; Exit 0: structurally valid. Exit 1: malformed. Exit 253: input exceeds the
; committed 256 KiB tape-hole payload (262,140 bytes after its length prefix).
;
; Memory map (all within Alpha's fixed 64 MiB):
;   globals     524288 .. 524343
;   source     1048576 .. 1310715  (262140 bytes)
;   coverage   1310720 .. 1572859  (0 unseen, 1 instruction start, 2 operand)
;   queued     1572864 .. 1835003  (one byte per possible instruction start)
;   worklist   1835008 .. 3932127  (262140 word entries)
;   call entry 3932160 .. 4194299  (one byte per possible procedure entry)
;   owner      4194304 .. 4456443  (procedure-region id at instruction starts)
;   inst len   4456448 .. 4718587  (encoded length at instruction starts)
;   terminals  4718592 .. 4718847  (one byte per procedure-region id)

; Globals: LEN HEAD TAIL PC OP NEXT ILEN

        ; Read and retain the complete candidate tape before checking it.
        imm   r0, 1048576       ; destination
        imm   r1, 0             ; length
read_loop:
        read  r2
        imm   r3, 0
        jlt   r2, r3, read_done
        imm   r3, 262140
        jlt   r1, r3, read_store
        imm   r0, 253
        halt  r0
read_store:
        storeb r0, r2
        imm   r3, 1
        add   r0, r3
        add   r1, r3
        jmp   read_loop

read_done:
        imm   r3, 524288
        store r3, r1            ; LEN
        imm   r4, 1
        jlt   r1, r4, reject    ; an empty tape has no entry instruction

        ; Queue entry pc zero.
        imm   r3, 1572864
        imm   r4, 1
        storeb r3, r4
        imm   r3, 1835008
        imm   r4, 0
        store r3, r4
        imm   r3, 524296
        store r3, r4            ; HEAD = 0
        imm   r3, 524304
        imm   r4, 1
        store r3, r4            ; TAIL = 1

work_loop:
        imm   r3, 524296
        load  r1, r3            ; head
        imm   r3, 524304
        load  r2, r3            ; tail
        jlt   r1, r2, work_item
        jmp   verify_partition_init

work_item:
        ; pc = worklist[head++]
        mov   r4, r1
        imm   r5, 8
        mul   r4, r5
        imm   r5, 1835008
        add   r4, r5
        load  r6, r4
        imm   r4, 1
        add   r1, r4
        imm   r3, 524296
        store r3, r1

        ; Queue insertion already checked this, but pin the invariant locally.
        imm   r7, 0
        jlt   r6, r7, reject
        imm   r3, 524288
        load  r8, r3
        jlt   r6, r8, pc_in_range
        jmp   reject
pc_in_range:
        imm   r3, 1310720
        add   r3, r6
        loadb r9, r3
        imm   r10, 0
        jeq   r9, r10, pc_uncovered
        jmp   reject
pc_uncovered:
        imm   r3, 1048576
        add   r3, r6
        loadb r7, r3            ; opcode
        imm   r10, 21
        jlt   r7, r10, opcode_known
        jmp   reject

opcode_known:
        ; Derive the exact encoded instruction length from the closed opcode set.
        imm   r10, 1
        jlt   r7, r10, len_2    ; halt
        imm   r10, 2
        jlt   r7, r10, len_10   ; imm
        imm   r10, 12
        jlt   r7, r10, len_3    ; mov through store
        imm   r10, 13
        jlt   r7, r10, len_9    ; jmp
        imm   r10, 15
        jlt   r7, r10, len_10   ; jz, jnz
        imm   r10, 17
        jlt   r7, r10, len_11   ; jlt, jeq
        imm   r10, 19
        jlt   r7, r10, len_2    ; read, write
        imm   r10, 20
        jlt   r7, r10, len_9    ; call
        imm   r11, 1            ; ret
        jmp   length_ready
len_2:
        imm   r11, 2
        jmp   length_ready
len_3:
        imm   r11, 3
        jmp   length_ready
len_9:
        imm   r11, 9
        jmp   length_ready
len_10:
        imm   r11, 10
        jmp   length_ready
len_11:
        imm   r11, 11

length_ready:
        ; Freeze the current item across enqueue calls.
        imm   r3, 524312
        store r3, r6            ; PC
        imm   r3, 524320
        store r3, r7            ; OP
        imm   r3, 524336
        store r3, r11           ; ILEN
        imm   r3, 4456448
        add   r3, r6
        storeb r3, r11
        mov   r12, r6
        add   r12, r11          ; exclusive instruction end / fallthrough
        imm   r3, 524328
        store r3, r12           ; NEXT
        imm   r3, 524288
        load  r8, r3
        jlt   r8, r12, reject   ; complete instruction must fit

        ; Claim every byte. A previously queued interior target is an overlap
        ; even if it has not yet been processed.
        imm   r13, 0
cover_loop:
        jlt   r13, r11, cover_byte
        jmp   dispatch
cover_byte:
        mov   r14, r6
        add   r14, r13
        imm   r3, 1310720
        add   r3, r14
        loadb r9, r3
        imm   r10, 0
        jeq   r9, r10, cover_empty
        jmp   reject
cover_empty:
        jeq   r13, r10, cover_start
        imm   r4, 1572864
        add   r4, r14
        loadb r5, r4
        jeq   r5, r10, cover_operand
        jmp   reject
cover_operand:
        imm   r5, 2
        storeb r3, r5
        jmp   cover_next
cover_start:
        imm   r5, 1
        storeb r3, r5
cover_next:
        imm   r5, 1
        add   r13, r5
        jmp   cover_loop

dispatch:
        imm   r3, 524320
        load  r7, r3
        imm   r10, 0
        jeq   r7, r10, work_loop    ; halt
        imm   r10, 20
        jeq   r7, r10, work_loop    ; ret; call fallthroughs cover return sites
        imm   r10, 12
        jeq   r7, r10, direct_jmp
        imm   r10, 13
        jeq   r7, r10, conditional_2
        imm   r10, 14
        jeq   r7, r10, conditional_2
        imm   r10, 15
        jeq   r7, r10, conditional_3
        imm   r10, 16
        jeq   r7, r10, conditional_3
        imm   r10, 19
        jeq   r7, r10, direct_call
        jmp   enqueue_fallthrough

direct_jmp:
        imm   r13, 1
        jmp   load_direct_target
conditional_2:
        imm   r13, 2
        jmp   load_conditional_target
conditional_3:
        imm   r13, 3
        jmp   load_conditional_target
direct_call:
        imm   r13, 1
        jmp   load_call_target

load_call_target:
        imm   r3, 524312
        load  r6, r3
        imm   r3, 1048576
        add   r3, r6
        add   r3, r13
        load  r0, r3
        imm   r1, 0
        jeq   r0, r1, reject     ; entry zero is the unique root, never a callee
        call  enqueue            ; range/framing admission precedes table access
        imm   r3, 3932160
        add   r3, r0
        imm   r1, 1
        storeb r3, r1
        jmp   enqueue_fallthrough

load_conditional_target:
        imm   r3, 524312
        load  r6, r3
        imm   r3, 1048576
        add   r3, r6
        add   r3, r13
        load  r0, r3
        call  enqueue
enqueue_fallthrough:
        imm   r3, 524328
        load  r0, r3
        call  enqueue
        jmp   work_loop

load_direct_target:
        imm   r3, 524312
        load  r6, r3
        imm   r3, 1048576
        add   r3, r6
        add   r3, r13
        load  r0, r3
        call  enqueue
        jmp   work_loop

; Partition all reachable instruction starts into monotonically ordered
; procedure regions. Region zero is the entry root; each distinct direct-call
; target starts the next region. This is valid for the exact bc artifact and is
; checked rather than assumed below: every non-call edge must remain in its
; region, only region zero may halt, and every other region must contain a ret.
verify_partition_init:
        imm   r0, 0
        imm   r3, 524352
        store r3, r0            ; scan pc
        imm   r0, 1
        imm   r3, 524344
        store r3, r0            ; region count, including root

verify_partition_loop:
        imm   r3, 524352
        load  r6, r3
        imm   r3, 524288
        load  r8, r3
        jlt   r6, r8, verify_partition_pc
        jmp   verify_terminals_init

verify_partition_pc:
        imm   r0, 0
        jeq   r6, r0, verify_partition_coverage
        imm   r3, 3932160
        add   r3, r6
        loadb r0, r3
        imm   r1, 0
        jeq   r0, r1, verify_partition_coverage
        imm   r3, 524344
        load  r0, r3
        imm   r1, 255
        jlt   r0, r1, verify_partition_new_region
        jmp   reject
verify_partition_new_region:
        imm   r1, 1
        add   r0, r1
        store r3, r0

verify_partition_coverage:
        imm   r3, 1310720
        add   r3, r6
        loadb r0, r3
        imm   r1, 1
        jeq   r0, r1, verify_partition_start
        jmp   verify_partition_next

verify_partition_start:
        imm   r3, 524344
        load  r5, r3
        imm   r1, 1
        sub   r5, r1            ; current zero-based region id
        imm   r3, 4194304
        add   r3, r6
        storeb r3, r5

        imm   r3, 1048576
        add   r3, r6
        loadb r7, r3
        imm   r1, 0
        jeq   r7, r1, verify_root_halt
        imm   r1, 20
        jeq   r7, r1, verify_callee_ret
        jmp   verify_partition_next

verify_root_halt:
        imm   r1, 0
        jeq   r5, r1, verify_mark_terminal
        jmp   reject
verify_callee_ret:
        imm   r1, 0
        jeq   r5, r1, reject
verify_mark_terminal:
        imm   r3, 4718592
        add   r3, r5
        imm   r1, 1
        storeb r3, r1

verify_partition_next:
        imm   r1, 1
        add   r6, r1
        imm   r3, 524352
        store r3, r6
        jmp   verify_partition_loop

verify_terminals_init:
        imm   r6, 0
verify_terminals_loop:
        imm   r3, 524344
        load  r8, r3
        jlt   r6, r8, verify_terminal
        jmp   verify_edges_init
verify_terminal:
        imm   r3, 4718592
        add   r3, r6
        loadb r0, r3
        imm   r1, 1
        jeq   r0, r1, verify_terminal_next
        jmp   reject
verify_terminal_next:
        imm   r1, 1
        add   r6, r1
        jmp   verify_terminals_loop

verify_edges_init:
        imm   r0, 0
        imm   r3, 524352
        store r3, r0

verify_edges_loop:
        imm   r3, 524352
        load  r6, r3
        imm   r3, 524288
        load  r8, r3
        jlt   r6, r8, verify_edges_pc
        imm   r0, 0
        halt  r0

verify_edges_pc:
        imm   r3, 1310720
        add   r3, r6
        loadb r0, r3
        imm   r1, 1
        jeq   r0, r1, verify_edge_start
        jmp   verify_edges_next

verify_edge_start:
        imm   r3, 4194304
        add   r3, r6
        loadb r5, r3            ; source procedure-region id
        imm   r3, 1048576
        add   r3, r6
        loadb r7, r3            ; opcode
        imm   r3, 4456448
        add   r3, r6
        loadb r11, r3
        mov   r12, r6
        add   r12, r11          ; fallthrough / call return pc

        imm   r1, 0
        jeq   r7, r1, verify_edges_next  ; halt
        imm   r1, 20
        jeq   r7, r1, verify_edges_next  ; ret
        imm   r1, 12
        jeq   r7, r1, verify_edge_direct
        imm   r1, 13
        jeq   r7, r1, verify_edge_conditional_2
        imm   r1, 14
        jeq   r7, r1, verify_edge_conditional_2
        imm   r1, 15
        jeq   r7, r1, verify_edge_conditional_3
        imm   r1, 16
        jeq   r7, r1, verify_edge_conditional_3
        imm   r1, 19
        jeq   r7, r1, verify_edge_call
        mov   r0, r12
        mov   r1, r5
        call  require_owner
        jmp   verify_edges_next

verify_edge_direct:
        imm   r3, 1048576
        add   r3, r6
        imm   r1, 1
        add   r3, r1
        load  r0, r3
        mov   r1, r5
        call  require_owner
        jmp   verify_edges_next

verify_edge_conditional_2:
        imm   r4, 2
        jmp   verify_edge_conditional
verify_edge_conditional_3:
        imm   r4, 3
verify_edge_conditional:
        imm   r3, 1048576
        add   r3, r6
        add   r3, r4
        load  r0, r3
        mov   r1, r5
        call  require_owner
        mov   r0, r12
        mov   r1, r5
        call  require_owner
        jmp   verify_edges_next

verify_edge_call:
        imm   r3, 1048576
        add   r3, r6
        imm   r1, 1
        add   r3, r1
        load  r0, r3
        imm   r3, 3932160
        add   r3, r0
        loadb r2, r3
        imm   r1, 1
        jeq   r2, r1, verify_call_return
        jmp   reject
verify_call_return:
        mov   r0, r12
        mov   r1, r5
        call  require_owner
        jmp   verify_edges_next

verify_edges_next:
        imm   r3, 524352
        load  r6, r3
        imm   r1, 1
        add   r6, r1
        store r3, r6
        jmp   verify_edges_loop

; require_owner(r0 target pc, r1 expected region id)
require_owner:
        imm   r3, 4194304
        add   r3, r0
        loadb r2, r3
        jeq   r2, r1, require_owner_ok
        jmp   reject
require_owner_ok:
        ret

; enqueue(r0): require a target in [0,LEN), and add each pc at most once.
enqueue:
        imm   r1, 0
        jlt   r0, r1, reject
        imm   r3, 524288
        load  r2, r3
        jlt   r0, r2, enqueue_in_range
        jmp   reject
enqueue_in_range:
        imm   r3, 1572864
        add   r3, r0
        loadb r4, r3
        imm   r5, 0
        jeq   r4, r5, enqueue_new
        ret
enqueue_new:
        imm   r4, 1
        storeb r3, r4
        imm   r3, 524304
        load  r5, r3            ; tail
        imm   r6, 262140
        jlt   r5, r6, enqueue_room
        jmp   reject
enqueue_room:
        mov   r7, r5
        imm   r8, 8
        mul   r7, r8
        imm   r8, 1835008
        add   r7, r8
        store r7, r0
        imm   r7, 1
        add   r5, r7
        store r3, r5
        ret

reject:
        imm   r0, 1
        halt  r0
