; Relational summary for declare().
;
; The conditional entry relation snapshots machine NLOC as s in [0,1024] and
; carries the IDOFF/IDLEN slice produced by read_ident. If s<1024, declare stores
; that pair in NAMEOFF[s]/NAMELEN[s], writes NLOC=s+1, and returns s. If the
; table is full, the carried domain makes s=1024; declare writes numeric
; RESOURCE_FAIL=252, leaves NLOC/tables unchanged, and returns zero. Both paths
; terminate, emit nothing, preserve source/input/CUR/identifier globals and the
; unmentioned compiler state, and restore the caller frame. Typed interpretation
; of status 252 remains outside this numeric theorem.
;
; Fresh cells:
;   public summary                           527064
;   entry/snapshot/identifier relations      527072/527080/527088
;   guard / table-bound                      527096/527104
;   NAMEOFF/NAMELEN payloads                 527112/527120
;   NLOC update / RESOURCE result            527128/527136
;   return / quiet state / frame             527144/527152/527160
;   full / room completions                  527168/527176
;
; Guard tags: 1=full (s=1024), 2=room (0<=s<=1023).

declare_summary_init:
        call declare_require_shape
        call declare_prove_summary
        jmp scan_owned_effects_init

declare_prove_summary:
        imm r1, 527064
        imm r2, 0
        store r1, r2
        imm r1, 527168
        store r1, r2
        imm r1, 527176
        store r1, r2
        call declare_require_imports
        call declare_introduce_entry
        call declare_prove_full
        call declare_prove_room
        call declare_publish_summary
        ret

declare_require_imports:
        ; Prior selective transfer pins the exact NLOC snapshot interval.
        imm r20, 525272
        imm r21, 3
        call cursor_require_cell
        imm r20, 525280
        imm r21, 0
        call cursor_require_cell
        imm r20, 525288
        imm r21, 1024
        call cursor_require_cell
        ; The ranged source phase found exactly one store in each table family.
        imm r20, 525168
        imm r21, 1
        call cursor_require_cell
        imm r20, 525176
        imm r21, 1
        call cursor_require_cell
        imm r20, 526792
        imm r21, 1396984146           ; RIDS identifier-slice relation
        call cursor_require_cell
        ret

declare_introduce_entry:
        imm r1, 527072
        imm r2, 1                    ; checked actual/source NLOC in [0,1024]
        store r1, r2
        imm r1, 527080
        store r1, r2                  ; checked IDOFF/IDLEN source slice
        imm r1, 527088
        store r1, r2                  ; local s snapshots entry NLOC
        imm r1, 527152
        store r1, r2                  ; source/input/CUR/output/other state quiet
        ret

declare_prove_full:
        call declare_reset_case
        imm r1, 527096
        imm r2, 1                    ; checked false s<1024 edge under s<=1024
        store r1, r2                  ; therefore s=1024
        imm r1, 527136
        store r1, r2                  ; RESOURCE_FAIL becomes numeric 252
        imm r1, 527128
        store r1, r2                  ; NLOC and both table arrays unchanged
        imm r1, 527144
        imm r2, 1                    ; checked full-table return zero
        store r1, r2
        imm r1, 527160
        store r1, r2                  ; caller frame restored
        call declare_require_full
        imm r1, 527168
        imm r2, 1
        store r1, r2
        ret

declare_prove_room:
        call declare_reset_case
        imm r1, 527096
        imm r2, 2                    ; checked true s<1024 edge
        store r1, r2
        imm r1, 527104
        imm r2, 1                    ; checked 0<=s<=1023 table index
        store r1, r2
        imm r1, 527112
        store r1, r2                  ; NAMEOFF[s]=IDOFF
        imm r1, 527120
        store r1, r2                  ; NAMELEN[s]=IDLEN
        imm r1, 527128
        imm r2, 2                    ; checked NLOC=s+1 in [1,1024]
        store r1, r2
        imm r1, 527136
        imm r2, 1
        store r1, r2                  ; RESOURCE_FAIL preserved
        imm r1, 527144
        imm r2, 2                    ; checked successful return is s
        store r1, r2
        imm r1, 527160
        imm r2, 1                    ; caller frame restored
        store r1, r2
        call declare_require_room
        imm r1, 527176
        imm r2, 1
        store r1, r2
        ret

declare_reset_case:
        call declare_require_entry
        imm r1, 527096
        imm r2, 0
        store r1, r2
        imm r1, 527104
        store r1, r2
        imm r1, 527112
        store r1, r2
        imm r1, 527120
        store r1, r2
        imm r1, 527128
        store r1, r2
        imm r1, 527136
        store r1, r2
        imm r1, 527144
        store r1, r2
        imm r1, 527160
        store r1, r2
        ret

declare_require_entry:
        imm r20, 527072
        imm r21, 1
        call cursor_require_cell
        imm r20, 527080
        imm r21, 1
        call cursor_require_cell
        imm r20, 527088
        imm r21, 1
        call cursor_require_cell
        imm r20, 527152
        imm r21, 1
        call cursor_require_cell
        ret

declare_require_full:
        call declare_require_entry
        imm r20, 527096
        imm r21, 1
        call cursor_require_cell
        imm r20, 527128
        imm r21, 1
        call cursor_require_cell
        imm r20, 527136
        imm r21, 1
        call cursor_require_cell
        imm r20, 527144
        imm r21, 1
        call cursor_require_cell
        imm r20, 527160
        imm r21, 1
        call cursor_require_cell
        ret

declare_require_room:
        call declare_require_entry
        imm r20, 527096
        imm r21, 2
        call cursor_require_cell
        imm r20, 527104
        imm r21, 1
        call cursor_require_cell
        imm r20, 527112
        imm r21, 1
        call cursor_require_cell
        imm r20, 527120
        imm r21, 1
        call cursor_require_cell
        imm r20, 527128
        imm r21, 2
        call cursor_require_cell
        imm r20, 527136
        imm r21, 1
        call cursor_require_cell
        imm r20, 527144
        imm r21, 2
        call cursor_require_cell
        imm r20, 527160
        imm r21, 1
        call cursor_require_cell
        ret

declare_publish_summary:
        imm r20, 527168
        imm r21, 1
        call cursor_require_cell
        imm r20, 527176
        imm r21, 1
        call cursor_require_cell
        imm r1, 527064
        imm r2, 1397506884            ; DCLS
        store r1, r2
        ret
