; Exact subject joins used by DREM.
;
; This phase binds the pre-scan and codegen observations to the same procedure
; body cursor and to p67's actual let branch.  It does not assert any external
; theorem conclusion; DRAN records those conclusions as implication premises.

declaration_budget_shape_init:
        imm r20, 632008
        imm r21, 1312903748             ; DRAN
        call exact_require_cell
        call declaration_budget_require_parse_shape
        call declaration_budget_require_let_shape
        call declaration_budget_record_occurrence_custody
        call declaration_budget_require_occurrence_custody
        imm r1, 632016
        imm r2, 1213420100             ; DRSH
        store r1, r2
        jmp declaration_budget_rules_init

declaration_budget_require_parse_shape:
        ; parse_proc.pdone owns the one count_lets call; slotsready/genbody are
        ; in the same procedure and retain the restored body cursor.
        imm r20, 344
        imm r21, 50015
        call exact_require_block_pc
        imm r20, 345
        imm r21, 50400
        call exact_require_block_pc
        imm r20, 348
        imm r21, 50945
        call exact_require_block_pc
        imm r20, 3145728
        imm r21, 344
        imm r22, 68
        call transfer_require_cell
        imm r20, 3145728
        imm r21, 348
        imm r22, 68
        call transfer_require_cell
        ; Exact count_lets event 594 at PC50142, one ambient staged nparams.
        imm r20, 594
        imm r21, 344
        imm r22, 50142                 ; exact count_lets call PC
        imm r23, 0
        imm r24, 1
        imm r25, 27433
        imm r26, 50151
        call summary_require_call_site
        ret

declaration_budget_require_let_shape:
        ; p67 do_let is block324. Its ordered calls are SWSQ, RIDS, DCLS, then
        ; (only on room) EXPS/GEXP/ESTS.  DREM depends on the first three.
        imm r20, 324
        imm r21, 47393
        call exact_require_block_pc
        imm r20, 3145728
        imm r21, 324
        imm r22, 67
        call transfer_require_cell
        imm r20, 544
        imm r21, 324
        imm r22, 47393
        imm r23, 0
        imm r24, 0
        imm r25, 4277
        imm r26, 47402
        call summary_require_call_site
        imm r20, 545
        imm r21, 324
        imm r22, 47402
        imm r23, 0
        imm r24, 0
        imm r25, 5217
        imm r26, 47411
        call summary_require_call_site
        imm r20, 546
        imm r21, 324
        imm r22, 47411
        imm r23, 0
        imm r24, 0
        imm r25, 24145
        imm r26, 47420
        call summary_require_call_site
        ; Exact resource guard from do_let to letfailed.
        imm r20, 262
        imm r21, 324
        imm r22, 1
        imm r23, 325
        imm r24, 47537
        call exact_require_transition
        ret

declaration_budget_record_occurrence_custody:
        ; Constructor1: CNTS count is the cardinality of its ordered, distinct
        ; exact-let occurrences. Constructor2: PCAP retains the restored body
        ; cursor and nslots=nparams+count. Constructor3: PFXS passes that same
        ; cursor to PBOD/SREL. Constructor4: STBR recognizes a declaration only
        ; after consuming the corresponding maximal `let` identifier.
        imm r10, 1
        imm r11, 1129206867             ; CNTS schema
        imm r12, 527904                 ; exact-let clause
        imm r13, 1                      ; ordered distinct occurrence
        call declaration_budget_store_custody
        imm r10, 2
        imm r11, 1346584912             ; PCAP schema
        imm r12, 528128                 ; exact nslots identity
        imm r13, 1                      ; cursor restored
        call declaration_budget_store_custody
        imm r10, 3
        imm r11, 1398294096             ; PFXS schema
        imm r12, 50945                  ; genbody PC
        imm r13, 1                      ; same body cursor
        call declaration_budget_store_custody
        imm r10, 4
        imm r11, 1380078675             ; STBR schema
        imm r12, 547256                 ; declaration name follows exact let
        imm r13, 1                      ; one occurrence consumed
        call declaration_budget_store_custody
        imm r1, 634192
        imm r2, 4
        store r1, r2
        ret

; Four 40-byte rows at634000: id, schema, support, custody, completion.
declaration_budget_store_custody:
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 40
        mul r20, r1
        imm r1, 634000
        add r20, r1
        store r20, r10
        imm r1, 8
        add r20, r1
        store r20, r11
        add r20, r1
        store r20, r12
        add r20, r1
        store r20, r13
        add r20, r1
        imm r2, 1
        store r20, r2
        ret

declaration_budget_require_occurrence_custody:
        imm r10, 1
declaration_budget_require_custody_loop:
        imm r1, 5
        jlt r10, r1, declaration_budget_require_custody_row
        imm r20, 634192
        imm r21, 4
        call exact_require_cell
        ret
declaration_budget_require_custody_row:
        call declaration_budget_select_custody
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 40
        mul r20, r1
        imm r1, 634000
        add r20, r1
        mov r21, r10
        call exact_require_cell
        imm r1, 8
        add r20, r1
        mov r21, r11
        call exact_require_cell
        add r20, r1
        mov r21, r12
        call exact_require_cell
        add r20, r1
        mov r21, r13
        call exact_require_cell
        add r20, r1
        imm r21, 1
        call exact_require_cell
        imm r1, 1
        add r10, r1
        jmp declaration_budget_require_custody_loop

declaration_budget_select_custody:
        imm r1, 1
        jeq r10, r1, declaration_budget_custody_cnts
        imm r1, 2
        jeq r10, r1, declaration_budget_custody_pcap
        imm r1, 3
        jeq r10, r1, declaration_budget_custody_pfxs
        imm r1, 4
        jeq r10, r1, declaration_budget_custody_stbr
        jmp reject
declaration_budget_custody_cnts:
        imm r11, 1129206867
        imm r12, 527904
        imm r13, 1
        ret
declaration_budget_custody_pcap:
        imm r11, 1346584912
        imm r12, 528128
        imm r13, 1
        ret
declaration_budget_custody_pfxs:
        imm r11, 1398294096
        imm r12, 50945
        imm r13, 1
        ret
declaration_budget_custody_stbr:
        imm r11, 1380078675
        imm r12, 547256
        imm r13, 1
        ret
