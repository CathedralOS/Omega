; Exhaustive raw-load address-family closure for exact bc.beta.
;
; The grammar-directed phase independently classified all 61 load address
; expressions while parsing them in their real expression contexts.  This
; phase scans all 95 raw-memory rows, admits no unclassified load, and closes
; the complete fixed-global family by checking the exact adjacent Alpha
; `imm r0,address; load r0,r0` pair.  The remaining five SRC-byte and two
; name-table loads are kept as explicit classes for later relational span/index
; summaries; this phase deliberately does not claim their dynamic bounds.

raw_load_family_init:
        imm r10, 0                     ; memory row
        imm r11, 0                     ; fixed-global loads
        imm r12, 0                     ; indexed SRC loads
        imm r13, 0                     ; indexed name-table loads
raw_load_family_loop:
        imm r1, 101
        jlt r10, r1, raw_load_family_row
        jmp raw_load_family_counts
raw_load_family_row:
        mov r19, r10
        imm r1, 8
        mul r19, r1
        imm r1, 7610368
        add r1, r19
        load r18, r1                   ; memory kind
        imm r1, 16924672
        add r1, r19
        load r17, r1                   ; source-derived address class
        imm r1, 1
        jeq r18, r1, raw_load_family_load
        imm r1, 2
        jeq r18, r1, raw_load_family_store
        jmp reject
raw_load_family_store:
        ; The fresh load-class table must remain empty for every store row.
        imm r1, 0
        jeq r17, r1, raw_load_family_next
        jmp reject
raw_load_family_load:
        imm r1, 1
        jeq r17, r1, raw_load_family_fixed
        imm r1, 2
        jeq r17, r1, raw_load_family_src
        imm r1, 3
        jeq r17, r1, raw_load_family_name
        jmp reject

raw_load_family_fixed:
        imm r1, 7618560
        add r1, r19
        load r18, r1
        imm r1, 8
        jeq r18, r1, raw_load_family_fixed_address
        jmp reject
raw_load_family_fixed_address:
        imm r1, 16926720
        add r1, r19
        load r17, r1
        imm r1, 2097064
        jlt r17, r1, reject
        imm r1, 2097145
        jlt r17, r1, raw_load_family_fixed_aligned
        jmp reject
raw_load_family_fixed_aligned:
        mov r0, r17
        imm r1, 8
        mod r0, r1
        imm r1, 0
        jeq r0, r1, raw_load_family_fixed_pc
        jmp reject
raw_load_family_fixed_pc:
        imm r1, 7626752
        add r1, r19
        load r16, r1                   ; checked raw-load opcode pc
        imm r1, 10
        jlt r16, r1, reject
        sub r16, r1                    ; exact address immediate begins here
        mov r20, r16
        imm r21, 1                     ; imm
        call require_tape_byte
        mov r20, r16
        imm r1, 1
        add r20, r1
        imm r21, 0                     ; r0
        call require_tape_byte
        mov r20, r16
        imm r1, 2
        add r20, r1
        mov r21, r17
        call require_tape_word
        mov r20, r16
        imm r1, 10
        add r20, r1
        imm r21, 10                    ; load
        call require_tape_byte
        mov r20, r16
        imm r1, 11
        add r20, r1
        imm r21, 0                     ; dst r0
        call require_tape_byte
        mov r20, r16
        imm r1, 12
        add r20, r1
        imm r21, 0                     ; address r0
        call require_tape_byte
        imm r1, 1
        add r11, r1
        jmp raw_load_family_next

raw_load_family_src:
        imm r1, 7618560
        add r1, r19
        load r18, r1
        imm r1, 1
        jeq r18, r1, raw_load_family_src_count
        jmp reject
raw_load_family_src_count:
        imm r1, 1
        add r12, r1
        jmp raw_load_family_next

raw_load_family_name:
        imm r1, 7618560
        add r1, r19
        load r18, r1
        imm r1, 8
        jeq r18, r1, raw_load_family_name_count
        jmp reject
raw_load_family_name_count:
        imm r1, 1
        add r13, r1
raw_load_family_next:
        imm r1, 1
        add r10, r1
        jmp raw_load_family_loop

raw_load_family_counts:
        imm r1, 58
        jeq r11, r1, raw_load_family_src_total
        jmp reject
raw_load_family_src_total:
        imm r1, 5
        jeq r12, r1, raw_load_family_name_total
        jmp reject
raw_load_family_name_total:
        imm r1, 2
        jeq r13, r1, call_bounds_resolve_specials
        jmp reject
