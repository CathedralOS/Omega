        imm r24, 33094
        call transfer_require_local
        imm r20, 137
        imm r21, 228
        imm r22, 1
        imm r23, 0
        imm r24, 33297
        call transfer_require_local

        ; emit_combine(op).
        imm r20, 138
        imm r21, 230
        imm r22, 1
        imm r23, 0
        imm r24, 33786
        call transfer_require_local

        ; emit_slot_addr(reg,slot): reg, slot, reg in lowering order.
        imm r20, 139
        imm r21, 231
        imm r22, 1
        imm r23, 0
        imm r24, 34024
        call transfer_require_local
        imm r20, 140
        imm r21, 231
        imm r22, 1
        imm r23, 1
        imm r24, 34224
        call transfer_require_local
        imm r20, 141
        imm r21, 231
        imm r22, 1
        imm r23, 0
        imm r24, 34410
        call transfer_require_local

        ; emit_load_slot / emit_store_slot.
        imm r20, 142
        imm r21, 232
        imm r22, 1
        imm r23, 0
        imm r24, 34609
        call transfer_require_local
        imm r20, 143
        imm r21, 233
        imm r22, 1
        imm r23, 0
        imm r24, 34831
        call transfer_require_local
        ret

