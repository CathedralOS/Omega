; Exact data/table and decoded-region shape for procedures30,44,47..52.
;
; All eight procedures have no raw-memory source rows.  This module pins every
; local read, literal/comparison/arithmetic primitive, and stack push, then
; exhausts the corresponding source tables.  Per-procedure decoded scans and
; a second three-region partition establish exact calls/returns/stores while
; rejecting direct input/output, halt, division, and remainder opcodes.

bounded_emitters_require_data_shape:
        call bounded_emitters_require_locals
        call bounded_emitters_require_primitives
        call bounded_emitters_require_pushes
        call bounded_emitters_require_source_censuses
        call bounded_emitters_require_decoded_censuses
        ret

bounded_emitters_require_locals:
        ; emit_pop_into(k).
        imm r20, 125
        imm r21, 213
        imm r22, 1
        imm r23, 0
        imm r24, 31246
        call transfer_require_local

        ; emit_mnemonic(op), one reload at each comparison state.
        imm r20, 133
        imm r21, 220
        imm r22, 1
        imm r23, 0
        imm r24, 32485
        call transfer_require_local
        imm r20, 134
        imm r21, 222
        imm r22, 1
        imm r23, 0
        imm r24, 32688
        call transfer_require_local
        imm r20, 135
        imm r21, 224
        imm r22, 1
        imm r23, 0
        imm r24, 32891
        call transfer_require_local
        imm r20, 136
