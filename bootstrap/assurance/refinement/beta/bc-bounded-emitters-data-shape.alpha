        imm r24, 1
        call exact_quiet_scan_region
        imm r20, 32434
        imm r21, 33541
        imm r22, 5
        imm r23, 7                   ; emit_mnemonic returns
        imm r24, 7
        call exact_quiet_scan_region
        imm r20, 33541
        imm r21, 33911
        imm r22, 6
        imm r23, 1
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 33911
        imm r21, 34532
        imm r22, 9                   ; emit_slot_addr calls
        imm r23, 1
        imm r24, 8                   ; emit_slot_addr stores
        call exact_quiet_scan_region
        imm r20, 34532
        imm r21, 34754
        imm r22, 2
        imm r23, 1
        imm r24, 4
        call exact_quiet_scan_region
        imm r20, 34754
        imm r21, 34977
        imm r22, 2
        imm r23, 1
        imm r24, 4
        call exact_quiet_scan_region

        ; Independent disjoint-region partition: 3+5+27 calls,
        ; 2+1+12 returns, and 3+3+27 stores = exact family 35/15/33.
        imm r20, 21226
        imm r21, 21443
        imm r22, 3
        imm r23, 2
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 31151
        imm r21, 31465
        imm r22, 5
        imm r23, 1
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 32248
        imm r21, 34977
        imm r22, 27
        imm r23, 12
        imm r24, 27
        call exact_quiet_scan_region
        ret
