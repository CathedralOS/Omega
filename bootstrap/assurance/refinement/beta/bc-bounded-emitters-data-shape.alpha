; effect census: inclusive block interval followed by half-open local, memory,
; transition, and event row intervals.
bounded_emitters_effect_census:
        call exact_require_effect_census
        ret

; expression census: inclusive block interval followed by half-open primitive,
; binary-push, argument-push, and empty store-push intervals.
bounded_emitters_expr_census:
        call summary_require_expr_census
        ret

