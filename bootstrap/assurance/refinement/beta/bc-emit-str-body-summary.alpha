; Total exact Scan theorem for emit_str_body().
;
; For every successful source segment and 0<=entry CUR=i<=LEN, the procedure
; blindly advances to k=i+1 and evaluates the recursive relation fixed in the
; cases module:
;
;   quote:     (epsilon, 0, k+1)
;   zero:      (epsilon, 0, k)
;   ordinary:  ([byte] || child-trace, 1+child-len, child-cursor)
;   escape:    ([92,next] || child-trace, 1+child-len, child-cursor)
;
; The result components above are suffixes relative to an arbitrary carried
; prior trace/len.  The natural rank LEN+1-k proves termination universally:
; ordinary decreases it by one and escape by two.  The result is bounded by
; the entry rank and hence LEN; final CUR<=LEN+1.  The exact trailing escape
; emits [92,0], counts one, and exits at LEN+1.  No opening/closing validation,
; minus invented error, or resource outcome is added.
;
; Public STRB is at 534848. Summary work is 536208..<536680.

emit_str_body_summary_init:
        call emit_str_body_require_shape
        call emit_str_body_cases_init
        call emit_str_body_prove_summary
        jmp gen_emit_summary_init

emit_str_body_prove_summary:
        imm r1, 534848
        imm r2, 0
        store r1, r2
        call emit_str_body_summary_clear
        call emit_str_body_summary_require_imports
        call emit_str_body_summary_introduce_entry
        call emit_str_body_summary_prove_rank_zero
        call emit_str_body_summary_prove_positive_rank
        call emit_str_body_summary_close_induction
        call emit_str_body_summary_prove_terminal_contract
        call emit_str_body_summary_publish
        ret

emit_str_body_summary_clear:
        imm r10, 536208
emit_str_body_summary_clear_loop:
        imm r1, 536680
        jlt r10, r1, emit_str_body_summary_clear_cell
        ret
emit_str_body_summary_clear_cell:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp emit_str_body_summary_clear_loop

emit_str_body_summary_require_imports:
        imm r20, 534800
        imm r21, 1163022164           ; EROOT
        call exact_require_cell
        imm r20, 525960
        imm r21, 1128421445           ; CBLE
        call exact_require_cell
        imm r20, 534808
        imm r21, 1094994008           ; ADVX
        call exact_require_cell
        imm r20, 535656
        imm r21, 1213416019           ; SBSH
        call exact_require_cell
        imm r20, 535664
        imm r21, 1094926931           ; SBCA
        call exact_require_cell
        ret

emit_str_body_summary_introduce_entry:
        call emit_str_body_summary_require_imports
        imm r20, 535672
        imm r21, 1                    ; arbitrary 0<=i<=LEN
        call exact_require_cell
        imm r20, 535680
        imm r21, 1                    ; exact blind opening adv
        call exact_require_cell
        imm r20, 535688
        imm r21, 1                    ; k=i+1<=LEN+1
        call exact_require_cell
        imm r20, 535696
        imm r21, 1                    ; universal loop invariant
        call exact_require_cell
        imm r20, 535704
        imm r21, 1                    ; rank LEN+1-k
        call exact_require_cell
        imm r1, 536208
        imm r2, 1                    ; exact entry tuple and arbitrary trace
        store r1, r2
        imm r1, 536216
        store r1, r2                  ; initial rank=LEN-i<=LEN
        imm r1, 536384
        store r1, r2                  ; no opening-quote premise introduced
        imm r1, 536360
        store r1, r2                  ; carried source/input/global quietness
        call emit_str_body_summary_require_entry
        ret

; Rank zero means k=LEN+1. CBLE therefore returns logical-miss zero and the
; exact zero clause exits immediately with empty suffix, result zero, and k
; preserved. This is also the child reached by a trailing backslash.
emit_str_body_summary_prove_rank_zero:
        call emit_str_body_summary_require_entry
        imm r20, 535744
        imm r21, 1                    ; exhaustive zero outcome available
        call exact_require_cell
        imm r20, 535888
        imm r21, 3                    ; NUL/LEN/LEN+1 zero origins complete
        call exact_require_cell
        imm r1, 536224
        imm r2, 1                    ; selected rank=0 => k=LEN+1
        store r1, r2
        imm r1, 536248
        store r1, r2                  ; exact zero terminal joined
        imm r1, 536464
        store r1, r2                  ; arbitrary prior trace unchanged
        imm r1, 536472
        store r1, r2                  ; suffix logical len zero
        imm r1, 536480
        store r1, r2                  ; final CUR exact k=LEN+1
        imm r1, 536488
        store r1, r2                  ; result is accumulated/zero suffix
        imm r1, 536408
        store r1, r2                  ; base completion
        call emit_str_body_summary_require_base
        ret

; Introduce an arbitrary positive rank, exhaust the already-proved byte
; partition, and close each recursive outcome only through a strictly smaller
; child rank. This is the induction step schema, not a finite set of probes.
emit_str_body_summary_prove_positive_rank:
        call emit_str_body_summary_require_entry
        imm r20, 535720
        imm r21, 1                    ; exhaustive disjoint byte partition
        call exact_require_cell
        imm r20, 535728
        imm r21, 256
        call exact_require_cell
        imm r1, 536232
        imm r2, 1                    ; arbitrary rank r>0
        store r1, r2
        call emit_str_body_summary_join_quote
        call emit_str_body_summary_join_zero
        call emit_str_body_summary_join_ordinary
        call emit_str_body_summary_join_escape
        call emit_str_body_summary_require_positive_joins
        imm r1, 536296
        imm r2, 1                    ; all byte/miss outcomes joined
        store r1, r2
        ret

emit_str_body_summary_join_quote:
        imm r20, 535736
        imm r21, 1
        call exact_require_cell
        imm r1, 536240
        imm r2, 1                    ; empty trace/len, cursor successor
        store r1, r2
        call emit_str_body_summary_require_quote_join
        imm r1, 536416
        imm r2, 1
        store r1, r2
        ret

emit_str_body_summary_join_zero:
        imm r20, 535744
        imm r21, 1
        call exact_require_cell
        imm r20, 535888
        imm r21, 3
        call exact_require_cell
        imm r1, 536248
        imm r2, 1                    ; zero unconsumed, empty trace/len
        store r1, r2
        call emit_str_body_summary_require_zero_join
        imm r1, 536424
        imm r2, 1
        store r1, r2
        ret

emit_str_body_summary_join_ordinary:
        imm r20, 535752
        imm r21, 1
        call exact_require_cell
        imm r1, 536256
        imm r2, 1                    ; induction hypothesis at Scan(k+1)
        store r1, r2
        imm r1, 536264
        store r1, r2                  ; [byte]||child, len=1+child
        call emit_str_body_summary_require_ordinary_join
        imm r1, 536432
        imm r2, 1
        store r1, r2
        ret

emit_str_body_summary_join_escape:
        imm r20, 535760
        imm r21, 1
        call exact_require_cell
        imm r20, 535768
        imm r21, 1                    ; all 256 next bytes copied
        call exact_require_cell
        imm r20, 535784
        imm r21, 1                    ; escaped NUL copied, not terminal
        call exact_require_cell
        imm r1, 536272
        imm r2, 1                    ; backslash in range entails r>=2
        store r1, r2
        imm r1, 536280
        store r1, r2                  ; induction hypothesis Scan(k+2)
        imm r1, 536288
        store r1, r2                  ; [92,next]||child, len=1+child
        imm r1, 536376
        store r1, r2                  ; escaped-zero continuation retained
        call emit_str_body_summary_require_escape_join
        imm r1, 536440
        imm r2, 1
        store r1, r2
        ret

emit_str_body_summary_require_quote_join:
        imm r20, 535736
        imm r21, 1
        call exact_require_cell
        imm r20, 536240
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_require_zero_join:
        imm r20, 535744
        imm r21, 1
        call exact_require_cell
        imm r20, 535888
        imm r21, 3
        call exact_require_cell
        imm r20, 536248
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_require_ordinary_join:
        imm r20, 535752
        imm r21, 1
        call exact_require_cell
        imm r20, 536256
        imm r21, 1
        call exact_require_cell
        imm r20, 536264
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_require_escape_join:
        imm r20, 535760
        imm r21, 1
        call exact_require_cell
        imm r20, 535768
        imm r21, 1
        call exact_require_cell
        imm r20, 535784
        imm r21, 1
        call exact_require_cell
        imm r20, 536272
        imm r21, 1
        call exact_require_cell
        imm r20, 536280
        imm r21, 1
        call exact_require_cell
        imm r20, 536288
        imm r21, 1
        call exact_require_cell
        imm r20, 536376
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_close_induction:
        call emit_str_body_summary_require_base
        imm r20, 536296
        imm r21, 1
        call exact_require_cell
        call emit_str_body_summary_require_positive_joins
        ; Ordinary and escape successors retain the invariant while strictly
        ; decreasing a natural rank. Capture-avoiding renaming closes Scan for
        ; every k<=LEN+1 and every prior trace, not merely the checked bytes.
        imm r1, 536304
        imm r2, 1                    ; successor tuple renamed to arbitrary k
        store r1, r2
        imm r1, 536312
        store r1, r2                  ; well-founded total termination
        imm r1, 536400
        imm r2, 1313423955            ; SBIN universal induction
        store r1, r2
        call emit_str_body_summary_require_induction
        ret

emit_str_body_summary_prove_terminal_contract:
        call emit_str_body_summary_require_induction
        imm r20, 535792
        imm r21, 1                    ; exact [92,0] tail case
        call exact_require_cell
        imm r20, 536040
        imm r21, 1                    ; exact LEN+1 cursor
        call exact_require_cell
        imm r1, 536320
        imm r2, 2                    ; prior trace || exact Scan trace
        store r1, r2
        imm r1, 536328
        imm r2, 2                    ; exact logical length, <=entry rank<=LEN
        store r1, r2
        imm r1, 536336
        imm r2, 2                    ; final CUR<=LEN+1, exact branch value
        store r1, r2
        imm r1, 536344
        imm r2, 2                    ; returned word equals logical length
        store r1, r2
        imm r1, 536352
        imm r2, 1                    ; explicit return restores caller frame
        store r1, r2
        imm r1, 536360
        store r1, r2                  ; source/input/other globals preserved
        imm r1, 536368
        store r1, r2                  ; trailing escape retained in theorem
        imm r1, 536376
        store r1, r2                  ; escaped NUL continuation retained
        imm r1, 536384
        store r1, r2                  ; opening byte remains unchecked
        imm r1, 536392
        store r1, r2                  ; no resource status or trap outcome
        imm r1, 536448
        store r1, r2                  ; terminal-contract completion
        imm r1, 536456
        store r1, r2                  ; final provenance completion
        call emit_str_body_summary_require_terminal
        ret

emit_str_body_summary_require_entry:
        imm r20, 536208
        imm r21, 1
        call exact_require_cell
        imm r20, 536216
        imm r21, 1
        call exact_require_cell
        imm r20, 536384
        imm r21, 1
        call exact_require_cell
        imm r20, 536360
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_require_base:
        imm r20, 536224
        imm r21, 1
        call exact_require_cell
        imm r20, 536248
        imm r21, 1
        call exact_require_cell
        imm r20, 536464
        imm r21, 1
        call exact_require_cell
        imm r20, 536472
        imm r21, 1
        call exact_require_cell
        imm r20, 536480
        imm r21, 1
        call exact_require_cell
        imm r20, 536488
        imm r21, 1
        call exact_require_cell
        imm r20, 536408
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_require_positive_joins:
        imm r20, 536232
        imm r21, 1
        call exact_require_cell
        imm r20, 536240
        imm r21, 1
        call exact_require_cell
        imm r20, 536248
        imm r21, 1
        call exact_require_cell
        imm r20, 536256
        imm r21, 1
        call exact_require_cell
        imm r20, 536264
        imm r21, 1
        call exact_require_cell
        imm r20, 536272
        imm r21, 1
        call exact_require_cell
        imm r20, 536280
        imm r21, 1
        call exact_require_cell
        imm r20, 536288
        imm r21, 1
        call exact_require_cell
        imm r20, 536416
        imm r21, 1
        call exact_require_cell
        imm r20, 536424
        imm r21, 1
        call exact_require_cell
        imm r20, 536432
        imm r21, 1
        call exact_require_cell
        imm r20, 536440
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_require_induction:
        imm r20, 536304
        imm r21, 1
        call exact_require_cell
        imm r20, 536312
        imm r21, 1
        call exact_require_cell
        imm r20, 536400
        imm r21, 1313423955           ; SBIN
        call exact_require_cell
        ret

emit_str_body_summary_require_terminal:
        imm r20, 536320
        imm r21, 2
        call exact_require_cell
        imm r20, 536328
        imm r21, 2
        call exact_require_cell
        imm r20, 536336
        imm r21, 2
        call exact_require_cell
        imm r20, 536344
        imm r21, 2
        call exact_require_cell
        imm r20, 536352
        imm r21, 1
        call exact_require_cell
        imm r20, 536360
        imm r21, 1
        call exact_require_cell
        imm r20, 536368
        imm r21, 1
        call exact_require_cell
        imm r20, 536376
        imm r21, 1
        call exact_require_cell
        imm r20, 536384
        imm r21, 1
        call exact_require_cell
        imm r20, 536392
        imm r21, 1
        call exact_require_cell
        imm r20, 536448
        imm r21, 1
        call exact_require_cell
        imm r20, 536456
        imm r21, 1
        call exact_require_cell
        ret

emit_str_body_summary_publish:
        call emit_str_body_summary_require_imports
        call emit_str_body_summary_require_entry
        call emit_str_body_summary_require_base
        imm r20, 536296
        imm r21, 1
        call exact_require_cell
        call emit_str_body_summary_require_positive_joins
        call emit_str_body_summary_require_induction
        call emit_str_body_summary_require_terminal
        imm r1, 534848
        imm r2, 1112691795            ; STRB
        store r1, r2
        ; Self-consume publication so later phases cannot inherit a write-only
        ; token detached from any finalizer above.
        imm r20, 534848
        imm r21, 1112691795
        call exact_require_cell
        ret
