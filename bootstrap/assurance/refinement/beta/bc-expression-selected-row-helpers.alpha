; Minimal selected-row joiners for the lower-rooted expression checker.
;
; These definitions are copied semantically unchanged from
; bc-ranged-store-transfer.alpha.  This module has no initialization edge,
; publishes no theorem token, and owns no table construction; it only rejoins
; already checked cells by exact row.

; Require one checked table cell: base r20, row r21, expected r22.
transfer_require_cell:
        imm r1, 8
        mul r21, r1
        add r20, r21
        load r2, r20
        jeq r2, r22, transfer_require_cell_ok
        jmp reject
transfer_require_cell_ok:
        ret

; local row/block/kind/slot/pc in r20..r24.
transfer_require_local:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r20, 7168000
        mov r21, r25
        mov r22, r26
        call transfer_require_cell
        imm r20, 7176192
        mov r21, r25
        mov r22, r27
        call transfer_require_cell
        imm r20, 7184384
        mov r21, r25
        mov r22, r28
        call transfer_require_cell
        imm r20, 7192576
        mov r21, r25
        mov r22, r29
        call transfer_require_cell
        ret

; memory row/block/kind/width/pc in r20..r24.
transfer_require_memory:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r20, 7602176
        mov r21, r25
        mov r22, r26
        call transfer_require_cell
        imm r20, 7610368
        mov r21, r25
        mov r22, r27
        call transfer_require_cell
        imm r20, 7618560
        mov r21, r25
        mov r22, r28
        call transfer_require_cell
        imm r20, 7626752
        mov r21, r25
        mov r22, r29
        call transfer_require_cell
        ret

; primitive row/block/kind/value-or-opcode/pc in r20..r24.
transfer_require_primitive:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r20, 8388608
        mov r21, r25
        mov r22, r26
        call transfer_require_cell
        imm r20, 8396800
        mov r21, r25
        mov r22, r27
        call transfer_require_cell
        imm r20, 8404992
        mov r21, r25
        mov r22, r28
        call transfer_require_cell
        imm r20, 8413184
        mov r21, r25
        mov r22, r29
        call transfer_require_cell
        ret

; push row/block/kind/pc in r20..r23.
transfer_require_push:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        imm r20, 9437184
        mov r21, r25
        mov r22, r26
        call transfer_require_cell
        imm r20, 9445376
        mov r21, r25
        mov r22, r27
        call transfer_require_cell
        imm r20, 9453568
        mov r21, r25
        mov r22, r28
        call transfer_require_cell
        ret
