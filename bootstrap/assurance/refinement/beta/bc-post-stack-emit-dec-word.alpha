; Checker-D continuation after the shared absolute stack-potential theorem.
; The full-Word emit_dec summary consumes this token before claiming shape or
; signed meaning, so it cannot inherit bounded DECS or another checker's cells.
bc_post_stack_potential:
        imm r1, 531840
        imm r2, 1464094803             ; SPDW
        store r1, r2
        jmp emit_dec_word_summary_init
