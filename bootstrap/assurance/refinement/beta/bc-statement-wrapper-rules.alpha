; Conditional wrapper rules for gen_block (p63) and gen_state (p65).
;
; The rules are functorial in the p62 Return-or-Diverge relation.  They do not
; assert that p62 terminates and they never erase a finite or infinite output
; prefix produced by a divergent child.  R is the coinductive resumption
;   Ret(state) | Tau(R) | Put(byte,R).
; A completed call/return machine path contributes Tau; stdout contributes Put.

statement_wrapper_rules_init:
        call statement_wrapper_require_imports
        call statement_wrapper_reset
        call statement_wrapper_prove_block
        call statement_wrapper_prove_state
        call statement_wrapper_require_cases
        call statement_wrapper_publish
        jmp statement_gfp_rules_init

statement_wrapper_require_imports:
        imm r20, 546156
        imm r21, 1414414675             ; SANT conditional antecedent schema
        call exact_require_cell
        imm r20, 546108
        imm r21, 1480936513             ; ALEX cursor/lexical package
        call exact_require_cell
        imm r20, 546132
        imm r21, 1279413313             ; ALBL label-emitter package
        call exact_require_cell
        imm r20, 546140
        imm r21, 1347962177             ; AEXP expression package
        call exact_require_cell
        imm r20, 546148
        imm r21, 1346917185             ; ASHP exact statement shape
        call exact_require_cell
        imm r20, 546180
        imm r21, 1112298323             ; SSLB emit_state_label
        call exact_require_cell
        imm r20, 546196
        imm r21, 1380078675             ; STBR finite p67 branch relation
        call exact_require_cell
        ret

statement_wrapper_reset:
        imm r10, 546800
statement_wrapper_reset_loop:
        imm r1, 546992
        jlt r10, r1, statement_wrapper_reset_one
        ret
statement_wrapper_reset_one:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp statement_wrapper_reset_loop

; p63 is EXPS('{') followed by the p62 child.  Its own epilogue is silent.
; Both possible child observations are lifted; Div is not collapsed to Ret.
statement_wrapper_prove_block:
        imm r1, 546800
        imm r2, 123
        store r1, r2                  ; exact opening delimiter premise
        imm r1, 546808
        imm r2, 1
        store r1, r2                  ; EXPS completes before child activation
        imm r1, 546816
        store r1, r2                  ; Ret child -> Ret0, exact child state
        imm r1, 546824
        store r1, r2                  ; Div child -> Div, child prefix retained
        imm r1, 546832
        store r1, r2                  ; no wrapper output after child
        imm r1, 546840
        store r1, r2                  ; completed child edge is a Tau guard
        ret

; p65 performs its finite prefix, then delegates to p63.  The saved name slice
; is used even though read_ident changes the current ID globals.  The trace is
; exactly current-procedure bytes, "__", state-name bytes, ":\n", then the
; block trace.  On Div the p65/p63 frames remain live, as the machine does.
statement_wrapper_prove_state:
        imm r1, 546848
        imm r2, 1
        store r1, r2                  ; SWSQ then RIDS, in that order
        imm r1, 546856
        store r1, r2                  ; noff/nlen snapshot before emit calls
        imm r1, 546864
        store r1, r2                  ; SSLB consumes the saved state slice
        imm r1, 546872
        imm r2, 2
        store r1, r2                  ; exact suffix bytes ':' then newline
        imm r1, 546880
        imm r2, 1
        store r1, r2                  ; p63 activated after finite prefix
        imm r1, 546888
        store r1, r2                  ; Ret child -> Ret0, frames restored
        imm r1, 546896
        store r1, r2                  ; Div child -> Div, frames remain live
        imm r1, 546904
        store r1, r2                  ; finite/infinite child prefix retained
        imm r1, 546912
        store r1, r2                  ; no productivity premise introduced
        ret

statement_wrapper_require_cases:
        imm r20, 546800
        imm r21, 123
        call exact_require_cell
        imm r10, 546808
statement_wrapper_require_block_loop:
        imm r1, 546848
        jlt r10, r1, statement_wrapper_require_one
        jmp statement_wrapper_require_state
statement_wrapper_require_one:
        mov r20, r10
        imm r21, 1
        call exact_require_cell
        imm r1, 8
        add r10, r1
        jmp statement_wrapper_require_block_loop
statement_wrapper_require_state:
        imm r10, 546848
statement_wrapper_require_state_loop:
        imm r1, 546920
        jlt r10, r1, statement_wrapper_require_one_state
        ret
statement_wrapper_require_one_state:
        mov r20, r10
        imm r1, 546872
        jeq r10, r1, statement_wrapper_require_state_suffix
        imm r21, 1
        jmp statement_wrapper_require_state_cell
statement_wrapper_require_state_suffix:
        imm r21, 2
statement_wrapper_require_state_cell:
        call exact_require_cell
        imm r1, 8
        add r10, r1
        jmp statement_wrapper_require_state_loop

statement_wrapper_publish:
        imm r1, 546204
        imm r2, 1347573587             ; SWRP conditional p63/p65 functor
        store r1, r2
        imm r20, 546204
        imm r21, 1347573587
        call exact_require_cell
        ret
