; Root-reachable main.ready composition through fixed output and whitespace.
;
; The root/slurp bridge publishes the successful cutpoint at PC51226.  Three
; exact zero-argument calls then compose already-proved procedure summaries:
;
;   51226 emit_prelude   -> 51235, append 55 bytes
;   51235 emit_write_str -> 51244, append 132 bytes
;   51244 skip_ws        -> 51253, append nothing and normalize CUR
;   51253 jmp main.loop  -> 51262
;
; Hence main.loop is reached with the exact ordered 187-byte compiler prefix,
; the successful slurp source segment and external input position unchanged,
; CUR at the first nontrivia byte/logical end/in-range NUL, and the active main
; frame restored across every callee. Scratch registers and reclaimed callee
; frame bytes remain outside preservation.
;
; Fresh cells:
;   imported ready/halt clauses       526440/526448
;   next pc / output length/order     526456/526464/526472
;   cursor / frame / source relation  526480/526488/526504
;   public main.loop theorem          526496
;   completed call count              526512

main_ready_summary_init:
        call main_ready_require_shape
        call main_ready_prove_composition
        jmp scan_owned_effects_init

main_ready_require_shape:
        ; ready and loop are adjacent blocks of main, procedure 69.
        imm r20, 351
        imm r21, 51226
        call slurp_summary_require_block_pc
        imm r20, 352
        imm r21, 51262
        call slurp_summary_require_block_pc
        imm r20, 3145728
        imm r21, 351
        imm r22, 69
        call transfer_require_cell
        imm r20, 3145728
        imm r21, 352
        imm r22, 69
        call transfer_require_cell

        imm r20, 287
        imm r21, 351
        imm r22, 0
        imm r23, 352
        imm r24, 51253
        call slurp_summary_require_transition

        imm r20, 605
        imm r21, 351
        imm r22, 1
        imm r23, 51226
        call slurp_summary_require_event
        imm r20, 606
        imm r21, 351
        imm r22, 1
        imm r23, 51235
        call slurp_summary_require_event
        imm r20, 607
        imm r21, 351
        imm r22, 1
        imm r23, 51244
        call slurp_summary_require_event

        imm r20, 605
        imm r21, 0
        call skip_require_event_arity
        imm r20, 606
        imm r21, 0
        call skip_require_event_arity
        imm r20, 607
        imm r21, 0
        call skip_require_event_arity
        imm r20, 605
        imm r21, 0
        call main_ready_require_ambient_height
        imm r20, 606
        imm r21, 0
        call main_ready_require_ambient_height
        imm r20, 607
        imm r21, 0
        call main_ready_require_ambient_height

        imm r20, 51226
        imm r21, 29619
        imm r22, 51235               ; checked first continuation
        call main_slurp_require_call
        imm r20, 51235
        imm r21, 20599
        imm r22, 51244
        call main_slurp_require_call
        imm r20, 51244
        imm r21, 4277
        imm r22, 51253
        call main_slurp_require_call

        ; No hidden source actions occur in ready: exactly three calls, one
        ; plain transition, and no locals or raw-memory expressions.
        imm r20, 51226
        imm r21, 51262
        imm r22, 3
        imm r23, 0
        call skip_scan_call_region
        imm r20, 351
        imm r21, 351
        imm r22, 0
        imm r23, 0
        imm r24, 0
        imm r25, 0
        imm r26, 287
        imm r27, 288
        imm r28, 605
        imm r29, 608                 ; checked exclusive ready event row
        call cursor_require_effect_census
        ret

main_ready_prove_composition:
        imm r1, 526496
        imm r2, 0
        store r1, r2
        imm r1, 526512
        store r1, r2
        call main_ready_import_cutpoint
        call main_ready_call_prelude
        call main_ready_call_write_str
        call main_ready_call_skip_ws
        call main_ready_take_loop_jump
        call main_ready_require_final
        imm r1, 526496
        imm r2, 1297238352            ; MLRP
        store r1, r2
        ret

; The ready clause is published only after the prior bridge rechecked slurp's
; success clause, local/equality flow, empty output, cursor zero, and frame.
main_ready_import_cutpoint:
        imm r20, 526440               ; checked imported ready clause
        imm r21, 1
        call cursor_require_cell
        imm r1, 526456
        imm r2, 51226
        store r1, r2
        imm r1, 526464
        imm r2, 0                     ; epsilon output
        store r1, r2
        imm r1, 526472
        store r1, r2                  ; empty ordered prefix
        imm r1, 526480
        imm r2, 1                     ; CUR=0 under successful segment
        store r1, r2
        imm r1, 526488
        store r1, r2                  ; active main frame/call-cut valid
        imm r1, 526504
        store r1, r2                  ; input/SRC/LEN relation preserved
        ret

main_ready_call_prelude:
        imm r20, 51226
        call main_ready_require_pc
        imm r20, 525944
        imm r21, 1279607365            ; EMIP
        call cursor_require_cell
        call main_ready_require_relations
        imm r1, 526464
        imm r2, 55                    ; checked first output length
        store r1, r2
        imm r1, 526472
        imm r2, 1                     ; exact emit_prelude byte sequence
        store r1, r2
        imm r1, 526456
        imm r2, 51235
        store r1, r2
        call main_ready_increment_calls
        ret

main_ready_call_write_str:
        imm r20, 51235
        call main_ready_require_pc
        imm r20, 525952               ; checked second theorem import
        imm r21, 1465008983            ; WSTW
        call cursor_require_cell
        call main_ready_require_relations
        imm r20, 526472
        imm r21, 1
        call cursor_require_cell
        imm r1, 526464
        load r2, r1
        imm r3, 132
        add r2, r3
        imm r3, 187                   ; checked composed prefix length
        jeq r2, r3, main_ready_store_prefix
        jmp reject
main_ready_store_prefix:
        store r1, r2
        imm r1, 526472
        imm r2, 2                     ; prelude ++ write_str exact sequence
        store r1, r2
        imm r1, 526456
        imm r2, 51244
        store r1, r2
        call main_ready_increment_calls
        ret

main_ready_call_skip_ws:
        imm r20, 51244
        call main_ready_require_pc
        imm r20, 526216
        imm r21, 1398231888            ; SWSQ
        call cursor_require_cell
        call main_ready_require_relations
        imm r20, 526464
        imm r21, 187
        call cursor_require_cell
        imm r20, 526472
        imm r21, 2                     ; checked skip emits epsilon
        call cursor_require_cell
        imm r1, 526480
        imm r2, 2                     ; whitespace-normalized CUR
        store r1, r2
        imm r1, 526456
        imm r2, 51253
        store r1, r2
        call main_ready_increment_calls
        ret

main_ready_take_loop_jump:
        imm r20, 51253
        call main_ready_require_pc
        imm r20, 526512
        imm r21, 3
        call cursor_require_cell
        imm r1, 526456
        imm r2, 51262                 ; checked ready->loop target
        store r1, r2
        ret

main_ready_require_final:
        imm r20, 526456
        imm r21, 51262
        call cursor_require_cell
        imm r20, 526464
        imm r21, 187
        call cursor_require_cell
        imm r20, 526472
        imm r21, 2
        call cursor_require_cell
        imm r20, 526480
        imm r21, 2
        call cursor_require_cell
        call main_ready_require_relations
        ret

main_ready_require_relations:
        imm r20, 526488
        imm r21, 1
        call cursor_require_cell
        imm r20, 526504
        imm r21, 1
        call cursor_require_cell
        ret

main_ready_require_pc:
        imm r1, 526456
        load r2, r1
        jeq r2, r20, cursor_require_ok
        jmp reject

main_ready_increment_calls:
        imm r1, 526512
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

main_ready_require_ambient_height:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 10035200
        add r1, r2
        load r2, r1
        jeq r2, r21, cursor_require_ok
        jmp reject
