        imm r23, 3
        imm r24, 2023
        call transfer_require_primitive
        imm r20, 38
        imm r21, 11
        imm r22, 1
        imm r23, 1
        imm r24, 2013
        call transfer_require_primitive
        imm r20, 7
        imm r21, 11
        imm r22, 1
        imm r23, 1997
        call transfer_require_push
        imm r20, 378
        imm r21, 11
        imm r22, 3
        imm r23, 1968
        call transfer_require_push
        imm r20, 2064
        imm r21, 2083
        call slurp_summary_require_epilogue
        imm r20, 1939
        imm r21, 2084
        imm r22, 1
        call cursor_scan_quiet_region
        imm r20, 11
        imm r21, 11
        imm r22, 0
        imm r23, 0                    ; no local rows
        imm r24, 14
        imm r25, 16
        imm r26, 0
        imm r27, 0                    ; no source transitions
        imm r28, 0
        imm r29, 0                    ; no explicit source events
        call cursor_require_effect_census
        ret

cursor_prove_adv:
        imm r1, 525968
        imm r2, 0
        store r1, r2
        call cursor_require_success_segment
        call cursor_introduce_domain
        imm r1, 526032
        imm r2, 1                    ; 0<=CUR<LEN<=CAP
        store r1, r2
        imm r1, 526040
        imm r2, 1                    ; selected old CUR
        store r1, r2
        imm r1, 526048
        imm r2, 1                    ; checked CUR increment delta
        store r1, r2
        call cursor_adv_store_successor
        imm r20, 526040
        imm r21, 2                    ; checked CUR successor
        call cursor_require_cell
        imm r1, 526056
        imm r2, 1
        store r1, r2
        imm r20, 526056
        imm r21, 1
        call cursor_require_cell
        imm r1, 525968
        imm r2, 1094992965            ; ADVE
        store r1, r2
        ret

cursor_adv_store_successor:
        call cursor_require_domain
        imm r20, 526032
        imm r21, 1
        call cursor_require_cell
        imm r20, 526040
        imm r21, 1
        call cursor_require_cell
        imm r20, 526048
        imm r21, 1
        call cursor_require_cell
        ; Exact wrapping addition is nonwrapping under CUR<LEN<=CAP; the sole
        ; raw store writes CUR+1<=LEN back to fixed address 2097144.
        imm r1, 526040
        imm r2, 2                    ; selected CUR successor
        store r1, r2
        ret

