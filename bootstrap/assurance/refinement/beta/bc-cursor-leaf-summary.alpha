; Selected relational summaries for cbyte, adv, and is_space.
;
; Shared cursor premise: LEN=L with 0<=L<=1048576, SRC[0:L] equal to the
; successful slurp segment, and CUR=i a nonnegative signed word below 2^63.
;
;   cbyte:   i<L  -> zext8(SRC[i]); i>=L -> 0, with no global/I/O mutation
;   adv:      under i<L, store CUR=i+1<=L
;   is_space: return 1 iff c is one of {32,9,10,13}, else zero
;
; An in-range NUL therefore makes cbyte return zero without being physical EOF.
; The signed/nonnegative cursor premise prevents a high-bit index from taking
; cbyte's signed `< LEN` hit edge.  These are reusable conditional clauses; the
; following skip_ws_step phase supplies their selected call-site premises.
; Scratch registers and reclaimed private-frame bytes are outside preservation.
;
; Fresh cells:
;   public cbyte/adv/space tokens      525960/525968/525976
;   cbyte relation/local/value        525984/525992/526000/526008
;   cbyte hit/miss clauses            526016/526024
;   adv relation/value/delta/clause   526032/526040/526048/526056
;   space case/completion flags       526064/526072..526104
;   space result / comparison flags   526112/526120..526144
;   cursor-domain / source-segment    526152/526160
;
; cbyte relation: 1=CUR<LEN, 2=LEN<=CUR. Selected value kinds:
; 1=SRC[CUR], 2=zero. Space cases: 1=32,2=9,3=10,4=13,5=other.

cursor_leaf_summary_init:
        call cursor_require_cbyte_shape
        call cursor_prove_cbyte
        call cursor_require_adv_shape
        call cursor_prove_adv
        call cursor_require_space_shape
        call cursor_prove_space
        jmp scan_owned_effects_init

; ---- cbyte -------------------------------------------------------------

cursor_require_cbyte_shape:
        imm r20, 7151616
        imm r21, 4
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 4
        imm r22, 1
        call transfer_require_cell
        imm r20, 8
        imm r21, 1609
        call slurp_summary_require_block_pc
        imm r20, 9
        imm r21, 1673
        call slurp_summary_require_block_pc
        imm r20, 10
        imm r21, 1829
        call slurp_summary_require_block_pc
        imm r20, 11
        imm r21, 1939
        call slurp_summary_require_block_pc
        imm r20, 8
        imm r21, 10
        imm r22, 4
        call cursor_require_proc_blocks

        imm r20, 4
        imm r21, 9
        imm r22, 1
        imm r23, 10
        imm r24, 1780
        call slurp_summary_require_transition

        imm r20, 14
        imm r21, 8
        imm r22, 2
        imm r23, 0
        imm r24, 1654
        call transfer_require_local
        imm r20, 15
        imm r21, 9
        imm r22, 1
        imm r23, 0
        imm r24, 1673
        call transfer_require_local
        imm r20, 16
        imm r21, 10
        imm r22, 1
        imm r23, 0
        imm r24, 1855
        call transfer_require_local

        imm r20, 11
        imm r21, 8
        imm r22, 1
        imm r23, 8
        imm r24, 1651
        call transfer_require_memory
        imm r20, 12
        imm r21, 9
        imm r22, 1
        imm r23, 8
        imm r24, 1718
        call transfer_require_memory
        imm r20, 13
        imm r21, 10
        imm r22, 1
        imm r23, 1
        imm r24, 1896
        call transfer_require_memory

        imm r20, 29
        imm r21, 8
        imm r22, 1
        imm r23, 2097144
        imm r24, 1641
        call transfer_require_primitive
        imm r20, 30
        imm r21, 9
        imm r22, 3
        imm r23, 8
        imm r24, 1721
        call transfer_require_primitive
        imm r20, 31
        imm r21, 9
        imm r22, 1
        imm r23, 2097136
        imm r24, 1708
        call transfer_require_primitive
        imm r20, 32
        imm r21, 9
        imm r22, 1
        imm r23, 0
        imm r24, 1799
        call transfer_require_primitive
        imm r20, 33
        imm r21, 10
        imm r22, 1
        imm r23, 2097152
        imm r24, 1829
        call transfer_require_primitive
        imm r20, 34
        imm r21, 10
        imm r22, 2
        imm r23, 3
        imm r24, 1874
        call transfer_require_primitive
        imm r20, 5
        imm r21, 9
        imm r22, 1
        imm r23, 1692
        call transfer_require_push
        imm r20, 6
        imm r21, 10
        imm r22, 1
        imm r23, 1839
        call transfer_require_push

        imm r20, 8
        imm r21, 9
        imm r22, 5
        imm r23, 1828
        call slurp_summary_require_event
        imm r20, 9
        imm r21, 10
        imm r22, 5
        imm r23, 1918
        call slurp_summary_require_event
        imm r20, 1809
        imm r21, 1828
        call slurp_summary_require_epilogue
        imm r20, 1899
        imm r21, 1918
        call slurp_summary_require_epilogue
        imm r20, 1919
        imm r21, 1938
        call slurp_summary_require_epilogue
        imm r20, 1609
        imm r21, 1939
        imm r22, 3
        call cursor_scan_quiet_region
        imm r20, 8
        imm r21, 10
        imm r22, 14
        imm r23, 17                   ; checked exclusive local row
        imm r24, 11
        imm r25, 14
        imm r26, 4
        imm r27, 5
        imm r28, 8
        imm r29, 10
        call cursor_require_effect_census
        ret

cursor_prove_cbyte:
        imm r1, 525960
        imm r2, 0
        store r1, r2
        imm r1, 526016
        store r1, r2
        imm r1, 526024
        store r1, r2

        ; Import the exact successful slurp segment, then introduce the shared
        ; conditional cursor premise used by both partitions.  Later callers
        ; must carry this domain token while adv changes CUR.
        call cursor_require_success_segment
        call cursor_introduce_domain

        ; Hit partition: 0<=CUR<LEN<=CAP. Exact CUR load/store-to-local,
        ; comparison, SRC+local address, and byte load derive SRC[CUR].
        imm r1, 525984
        imm r2, 1                    ; checked hit relation CUR<LEN
        store r1, r2
        call cursor_cbyte_load_cur
        call cursor_cbyte_take_hit
        call cursor_cbyte_load_source
        imm r20, 1
        imm r21, 1
        call cursor_cbyte_require_value
        imm r1, 526016
        imm r2, 1
        store r1, r2

        ; Miss partition includes CUR=LEN and every larger nonnegative signed
        ; cursor. The false edge returns literal zero and never executes row13.
        imm r1, 525984
        imm r2, 2                    ; checked miss relation LEN<=CUR
        store r1, r2
        call cursor_cbyte_load_cur
        call cursor_cbyte_take_miss
        imm r20, 2
        imm r21, 0
        call cursor_cbyte_set_value
        imm r1, 526024
        imm r2, 1
        store r1, r2

        imm r20, 526016
        imm r21, 1
        call cursor_require_cell
        imm r20, 526024
        imm r21, 1
        call cursor_require_cell
        imm r1, 525960
        imm r2, 1128421445            ; CBLE
        store r1, r2
        ret

cursor_cbyte_load_cur:
        imm r1, 525992
        imm r2, 1                    ; local i derives current CUR
        store r1, r2
        ret

cursor_cbyte_take_hit:
        call cursor_require_domain
        imm r20, 525984
        imm r21, 1
        call cursor_require_cell
        imm r20, 525992
        imm r21, 1
        call cursor_require_cell
        ret

cursor_cbyte_take_miss:
        call cursor_require_domain
        imm r20, 525984
        imm r21, 2
        call cursor_require_cell
        imm r20, 525992
        imm r21, 1
        call cursor_require_cell
        ret

cursor_cbyte_load_source:
        call cursor_require_segment
        imm r20, 525984
        imm r21, 1
        call cursor_require_cell
        imm r20, 525992
        imm r21, 1                    ; checked SRC index from local i
        call cursor_require_cell
        ; CUR<LEN<=CAP proves SRC+CUR in [2097152,3145728), nonwrapping and
        ; disjoint from stack/global regions. The successful slurp token gives
        ; exact byte provenance, including the possibility that the byte is 0.
        imm r20, 1
        imm r21, 1
        jmp cursor_cbyte_set_value

cursor_cbyte_set_value:
        imm r1, 526000
        store r1, r20
        imm r1, 526008
        store r1, r21
        ret

cursor_cbyte_require_value:
        imm r1, 526000
        load r2, r1
        jeq r2, r20, cursor_cbyte_value_payload
        jmp reject
cursor_cbyte_value_payload:
        imm r1, 526008
        load r2, r1
        jeq r2, r21, cursor_require_ok
        jmp reject

