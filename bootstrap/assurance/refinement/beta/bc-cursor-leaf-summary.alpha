cursor_prove_space:
        imm r1, 525976
        imm r2, 0
        store r1, r2
        imm r10, 1
cursor_space_case_loop:
        imm r1, 6
        jlt r10, r1, cursor_space_case
        imm r10, 1
cursor_space_flags_loop:
        imm r1, 6
        jlt r10, r1, cursor_space_flag
        imm r1, 525976
        imm r2, 1397769539            ; SPAC
        store r1, r2
        ret
cursor_space_case:
        imm r1, 526064
        store r1, r10
        mov r20, r10
        call cursor_space_set_comparison_pattern
        mov r20, r10
        call cursor_space_run_case
        mov r2, r10
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526072
        add r1, r2
        imm r2, 1
        store r1, r2
        imm r1, 1
        add r10, r1
        jmp cursor_space_case_loop
cursor_space_flag:
        mov r2, r10
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526072
        add r1, r2
        load r3, r1
        imm r1, 1
        jeq r3, r1, cursor_space_flag_next
        jmp reject
cursor_space_flag_next:
        imm r1, 1
        add r10, r1
        jmp cursor_space_flags_loop

cursor_space_run_case:
        ; Parameter-store custody makes all four local loads the same c.
        imm r1, 1
        jeq r20, r1, cursor_space_case_32
        imm r1, 2
        jeq r20, r1, cursor_space_case_9
        imm r1, 3
        jeq r20, r1, cursor_space_case_10
        imm r1, 4
        jeq r20, r1, cursor_space_case_13
        imm r1, 5
        jeq r20, r1, cursor_space_case_other
        jmp reject
cursor_space_case_32:
        imm r20, 1
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1
        jmp cursor_space_set_result
cursor_space_case_9:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1
        jmp cursor_space_set_result
cursor_space_case_10:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 3
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1
        jmp cursor_space_set_result
cursor_space_case_13:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 3
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 4
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1                    ; checked CR is whitespace
        jmp cursor_space_set_result
cursor_space_case_other:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 3
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 4
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2                    ; checked other-result kind
        imm r21, 0                    ; all other words, including zero
        jmp cursor_space_set_result

; The five mutually exclusive partitions of four equalities are encoded as
; 1000, 0100, 0010, 0001, and 0000.  Because all four checked local loads use
; parameter slot zero, these are exactly c=32, c=9, c=10, c=13, and other.
cursor_space_set_comparison_pattern:
        mov r25, r20
        imm r11, 1
cursor_space_clear_comparisons:
        imm r1, 5
        jlt r11, r1, cursor_space_clear_comparison
        imm r1, 5
        jeq r25, r1, cursor_require_ok
        mov r20, r25
        imm r21, 1
        jmp cursor_space_store_comparison
cursor_space_clear_comparison:
        mov r20, r11
        imm r21, 0
        call cursor_space_store_comparison
        imm r1, 1
        add r11, r1
        jmp cursor_space_clear_comparisons

cursor_space_store_comparison:
        mov r2, r20
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526120
        add r1, r2
        store r1, r21
        ret

cursor_space_require_comparison:
        mov r2, r20
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526120
        add r1, r2
        load r2, r1
        jeq r2, r21, cursor_require_ok
        jmp reject

cursor_space_set_result:
        imm r1, 526112
        store r1, r20                 ; 1=one,2=zero
        imm r1, 526064
        load r2, r1
        imm r3, 5
        jeq r2, r3, cursor_space_expect_zero
        imm r3, 1
        jeq r20, r3, cursor_space_expect_one_payload
        jmp reject
cursor_space_expect_one_payload:
        imm r3, 1
        jeq r21, r3, cursor_require_ok
        jmp reject
cursor_space_expect_zero:
        imm r3, 2
        jeq r20, r3, cursor_space_expect_zero_payload
        jmp reject
cursor_space_expect_zero_payload:
        imm r3, 0
        jeq r21, r3, cursor_require_ok
        jmp reject

; The successful slurp theorem supplies LEN=L in [0,CAP] and exact
; SRC[0:L]=input[0:L].  The leaf clauses are conditional on a caller-carried
; nonnegative signed CUR; relation 1 further selects CUR<LEN and relation 2
; selects LEN<=CUR.  Keeping these two premises distinct prevents a checked
; source address from being manufactured from the numeric range alone.
cursor_require_success_segment:
        imm r20, 525744
        imm r21, 1
        call cursor_require_cell
        imm r1, 526160
        imm r2, 1
        store r1, r2
        ret

cursor_introduce_domain:
        call cursor_require_segment
        imm r1, 526152
        imm r2, 1                    ; checked 0<=CUR<2^63, LEN<=CAP
        store r1, r2
        ret

cursor_require_domain:
        imm r20, 526152
        imm r21, 1
        jmp cursor_require_cell

cursor_require_segment:
        imm r20, 526160
        imm r21, 1
        jmp cursor_require_cell

; ---- Shared exact closure ---------------------------------------------

; Exhaust all 242 local, 95 raw-memory, 291 transition, and 613 source-event
; rows for blocks [r20,r21]. Rows belonging to the selected blocks must be
; exactly the already-rejoined contiguous intervals [r22,r23), [r24,r25),
; [r26,r27), and [r28,r29). Together with the global frame/store custody
; phases and decoded quiet-region scan, this closes both CFG and footprint:
; cbyte has one private local store and reads only; adv writes only CUR;
; is_space has parameter-local loads and no raw-memory action.
cursor_require_effect_census:
        mov r30, r20                  ; first block
        mov r31, r21                  ; last block
        mov r32, r22                  ; first local row
        mov r33, r23                  ; exclusive local row
        mov r34, r24                  ; first memory row
        mov r35, r25                  ; exclusive memory row
        mov r36, r26                  ; first transition row
        mov r37, r27                  ; exclusive transition row
        mov r38, r28                  ; first event row
        mov r39, r29                  ; exclusive event row
        imm r10, 0
        imm r11, 0
cursor_effect_local_loop:
        imm r1, 242
        jlt r10, r1, cursor_effect_local_row
        mov r2, r33
        sub r2, r32
        jeq r11, r2, cursor_effect_memory_init
        jmp reject
cursor_effect_local_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7168000
        add r1, r2
        load r3, r1
        jlt r3, r30, cursor_effect_local_next
        jlt r31, r3, cursor_effect_local_next
        jlt r10, r32, reject
        jlt r10, r33, cursor_effect_local_match
        jmp reject
cursor_effect_local_match:
        imm r1, 1
        add r11, r1
cursor_effect_local_next:
        imm r1, 1
        add r10, r1
        jmp cursor_effect_local_loop

cursor_effect_memory_init:
        imm r10, 0
        imm r11, 0
cursor_effect_memory_loop:
        imm r1, 95
        jlt r10, r1, cursor_effect_memory_row
        mov r2, r35
        sub r2, r34
        jeq r11, r2, cursor_effect_transition_init
        jmp reject
cursor_effect_memory_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7602176
        add r1, r2
        load r3, r1
        jlt r3, r30, cursor_effect_memory_next
        jlt r31, r3, cursor_effect_memory_next
        jlt r10, r34, reject
        jlt r10, r35, cursor_effect_memory_match
        jmp reject
cursor_effect_memory_match:
        imm r1, 1
        add r11, r1
cursor_effect_memory_next:
        imm r1, 1
        add r10, r1
        jmp cursor_effect_memory_loop

cursor_effect_transition_init:
        imm r10, 0
        imm r11, 0
cursor_effect_transition_loop:
        imm r1, 291
        jlt r10, r1, cursor_effect_transition_row
        mov r2, r37
        sub r2, r36
        jeq r11, r2, cursor_effect_event_init
        jmp reject
cursor_effect_transition_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 3215360
        add r1, r2
        load r3, r1
        jlt r3, r30, cursor_effect_transition_next
        jlt r31, r3, cursor_effect_transition_next
        jlt r10, r36, reject
        jlt r10, r37, cursor_effect_transition_match
        jmp reject
cursor_effect_transition_match:
        imm r1, 1
        add r11, r1
cursor_effect_transition_next:
        imm r1, 1
        add r10, r1
        jmp cursor_effect_transition_loop

cursor_effect_event_init:
        imm r10, 0
        imm r11, 0
cursor_effect_event_loop:
        imm r1, 613
        jlt r10, r1, cursor_effect_event_row
        mov r2, r39
        sub r2, r38
        jeq r11, r2, cursor_require_ok
        jmp reject
cursor_effect_event_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7077888
        add r1, r2
        load r3, r1
        jlt r3, r30, cursor_effect_event_next
        jlt r31, r3, cursor_effect_event_next
        jlt r10, r38, reject
        jlt r10, r39, cursor_effect_event_match
        jmp reject
cursor_effect_event_match:
        imm r1, 1
        add r11, r1
cursor_effect_event_next:
        imm r1, 1
        add r10, r1
        jmp cursor_effect_event_loop

; Blocks [r20,r21] inclusive must all belong to procedure r22, and no other
; parsed block may do so.
cursor_require_proc_blocks:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        imm r10, 0
        imm r11, 0
cursor_proc_block_loop:
        imm r1, 355
        jlt r10, r1, cursor_proc_block_row
        mov r2, r26
        sub r2, r25
        imm r1, 1
        add r2, r1
        jeq r11, r2, cursor_require_ok
        jmp reject
cursor_proc_block_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 3145728
        add r1, r2
        load r3, r1
        jeq r3, r27, cursor_proc_block_match
        jmp cursor_proc_block_next
cursor_proc_block_match:
        jlt r10, r25, reject
        jlt r26, r10, reject
        imm r1, 1
        add r11, r1
cursor_proc_block_next:
        imm r1, 1
        add r10, r1
        jmp cursor_proc_block_loop

; Region [r20,r21) has exactly r22 returns and no direct input/output, nested
; call, halt, division, or remainder. Stack/local/raw accesses were already
; partitioned by prior phases and the selected rows above.
cursor_scan_quiet_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        imm r28, 0
cursor_quiet_loop:
        jlt r25, r26, cursor_quiet_pc
        jeq r28, r27, cursor_require_ok
        jmp reject
cursor_quiet_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, cursor_quiet_start
        jmp cursor_quiet_next
cursor_quiet_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 20
        jeq r2, r3, cursor_quiet_ret
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        imm r3, 19
        jeq r2, r3, reject
        jmp cursor_quiet_next
cursor_quiet_ret:
        imm r1, 1
        add r28, r1
cursor_quiet_next:
        imm r1, 1
        add r25, r1
        jmp cursor_quiet_loop

cursor_require_cell:
        load r2, r20
        jeq r2, r21, cursor_require_ok
        jmp reject
cursor_require_ok:
        ret
