        imm r23, 8
        imm r24, 2061
        call transfer_require_memory
        imm r20, 15
        imm r21, 11
        imm r22, 1
        imm r23, 8
        imm r24, 1994
        call transfer_require_memory
        imm r20, 35
        imm r21, 11
        imm r22, 1
        imm r23, 2097144
        imm r24, 1958
        call transfer_require_primitive
        imm r20, 36
        imm r21, 11
        imm r22, 1
        imm r23, 2097144
        imm r24, 1984
        call transfer_require_primitive
