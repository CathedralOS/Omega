; Checker F starts after the source-derived call-bound tables have been checked.
; It deliberately does not mint the absolute-stack theorem owned by the full
; historical checker.  The expression theorem is conditional on its exact
; checked frames and BCS9 depth contexts and composes independently with that
; already separate whole-artifact stack proposition.
;
; Fresh expression-family cells begin at 540000.  EROOT is reused only as the
; private prerequisite-chain root expected by the label-emitter modules.

stack_register_custody_init:
        imm r1, 540000
        imm r2, 1414677848             ; XPRX
        store r1, r2
        imm r1, 534800
        imm r2, 1163022164             ; EROOT
        store r1, r2
        jmp write_str_summary_init
