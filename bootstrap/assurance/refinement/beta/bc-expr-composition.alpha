; Syntax-directed expression/staging composition for the whole-bc checker.
;
; This phase reparses the exact Beta source after all flat BCT8 site tables have
; been independently built and validated.  It consumes those tables in lexical
; source order while checking the emitted Alpha pieces in recursive lowering
; order.  Thus the untrusted location witness cannot permute otherwise identical
; block-local pieces across a binary expression, call argument, memory address,
; assignment, guarded transition, or return.
;
; The phase also interprets every exact push/pop boundary symbolically.  Each
; complete statement expression begins and ends at relative data-stack height
; zero; the exact bc.beta source reaches a maximum of two live temporary words.
; This is a parametric expression-stack result, not the absolute B_bc1 bound:
; active procedure frames and input-dependent recursive call depth remain open.

; Private globals occupy 524800..524952.  A bounded five-word parser save stack
; begins at 9961472, beyond all preceding source/witness/owner tables.  The
; later call-bound phase reuses two values reconstructed here: the relative
; temporary height at each effect event is stored at 10035200, and each
; procedure's local temporary high-water mark is stored at 10043392.

composition_scan_init:
        imm r0, 0
        imm r1, 524304
        store r1, r0                    ; source cursor
        imm r1, 524800
        store r1, r0                    ; current source block
        imm r1, 524808
        store r1, r0                    ; parsed procedure count
        imm r1, 524816
        store r1, r0                    ; parsed block count
        imm r1, 524824
        store r1, r0                    ; next primitive
        imm r1, 524832
        store r1, r0                    ; next local access
        imm r1, 524840
        store r1, r0                    ; next memory site
        imm r1, 524848
        store r1, r0                    ; next effect event
        imm r1, 524856
        store r1, r0                    ; next transition
        imm r1, 524864
        store r1, r0                    ; next binary push (full index)
        imm r1, 524872
        imm r2, 235
        store r1, r2                    ; next argument push (full index)
        imm r1, 524880
        imm r2, 369
        store r1, r2                    ; next store-address push (full index)
        imm r1, 524888
        store r1, r0                    ; current expression end pc
        imm r1, 524896
        store r1, r0                    ; current expression has a piece
        imm r1, 524904
        store r1, r0                    ; parser save-stack top
        imm r1, 524912
        store r1, r0                    ; relative temporary words live
        imm r1, 524920
        store r1, r0                    ; maximum temporary words live
        imm r1, 525080
        store r1, r0                    ; fixed-global raw-store addresses
        imm r1, 525088
        store r1, r0                    ; guarded ranged raw-store addresses
        jmp composition_program_loop

composition_program_loop:
        call skip_trivia
        call current_byte
        imm r1, 0
        jlt r0, r1, composition_program_done
        call read_ident
        call ident_is_proc
        imm r1, 1
        jeq r0, r1, composition_proc_name
        jmp reject
composition_proc_name:
        call composition_require_ident
        imm r20, 40                     ; (
        call composition_expect_char
        call composition_parse_parameter_list
        imm r20, 123                    ; {
        call composition_expect_char

        imm r1, 524816
        load r2, r1
        imm r3, 355
        jlt r2, r3, composition_proc_block_room
        jmp reject
composition_proc_block_room:
        imm r1, 524800
        store r1, r2                    ; entry block
        imm r3, 1
        add r2, r3
        imm r1, 524816
        store r1, r2
        imm r1, 524808
        load r2, r1
        add r2, r3
        store r1, r2
        call composition_parse_body
        jmp composition_program_loop

; Parse identifiers separated by commas through the closing ')'.
composition_parse_parameter_list:
        call skip_trivia
        call current_byte
        imm r1, 41
        jeq r0, r1, composition_parameter_done
        call composition_require_ident
        call skip_trivia
        call current_byte
        imm r1, 44
        jeq r0, r1, composition_parameter_comma
        imm r1, 41
        jeq r0, r1, composition_parameter_done
        jmp reject
composition_parameter_comma:
        call advance_one
        jmp composition_parse_parameter_list
composition_parameter_done:
        call advance_one
        ret

; Parse statements until and consume the current body's closing '}'.
composition_parse_body:
composition_body_loop:
        call skip_trivia
        call current_byte
        imm r1, 125
        jeq r0, r1, composition_body_done
        imm r1, 0
        jlt r0, r1, reject
        call composition_parse_statement
        jmp composition_body_loop
composition_body_done:
        call advance_one
        ret

composition_parse_statement:
        call read_ident
        call ident_is_state
        imm r1, 1
        jeq r0, r1, composition_stmt_state
        call ident_is_let
        imm r1, 1
        jeq r0, r1, composition_stmt_let
        call ident_is_return
        imm r1, 1
        jeq r0, r1, composition_stmt_return
        call ident_is_to
        imm r1, 1
        jeq r0, r1, composition_stmt_to
        call ident_is_emit
        imm r1, 1
        jeq r0, r1, composition_stmt_emit

        ; byte/word is a memory statement only when followed by '['.
        imm r1, 524304
        load r2, r1
        imm r1, 524928
        store r1, r2                    ; cursor after leading identifier
        call skip_trivia
        call current_byte
        imm r1, 91
        jeq r0, r1, composition_stmt_maybe_memory
        imm r1, 40
        jeq r0, r1, composition_stmt_call
        jmp composition_stmt_assign

composition_stmt_maybe_memory:
        call ident_is_byte
        imm r1, 1
        jeq r0, r1, composition_stmt_memory_byte
        call ident_is_word
        imm r1, 1
        jeq r0, r1, composition_stmt_memory_word
        jmp reject
composition_stmt_memory_byte:
        imm r7, 1
        jmp composition_stmt_memory
composition_stmt_memory_word:
        imm r7, 8
composition_stmt_memory:
        imm r6, 2                       ; source memory store
        call composition_take_memory
        mov r20, r0                     ; save site index
        imm r21, 3                       ; store-address push kind
        call composition_take_push
        mov r21, r0                     ; save push index
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        imm r20, 91
        call composition_expect_char
        call composition_save_peek
        call composition_validate_store_address
        call composition_expr_begin
        call composition_parse_expr
        imm r20, 93
        call composition_expect_char
        call composition_save_peek
        mov r20, r21                    ; store-address push index
        call composition_compose_push
        call composition_stack_push
        imm r20, 61
        call composition_expect_char
        call composition_parse_expr
        call composition_save_pop
        ; The memory opcode follows one exact 16-byte pop macro.
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7626752
        add r1, r2
        load r20, r1                    ; memory opcode pc
        imm r21, 16
        imm r22, 3
        call composition_compose_gap_piece
        call composition_stack_pop
        call composition_expr_finish
        ret

composition_stmt_state:
        call composition_require_ident
        imm r20, 123
        call composition_expect_char
        imm r1, 524816
        load r2, r1
        imm r3, 355
        jlt r2, r3, composition_state_block_room
        jmp reject
composition_state_block_room:
        imm r1, 524800
        store r1, r2
        imm r3, 1
        add r2, r3
        imm r1, 524816
        store r1, r2
        call composition_parse_body
        ret

composition_stmt_let:
        call composition_require_ident
        imm r6, 2
        call composition_take_access
        mov r20, r0
        imm r21, 0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        imm r20, 61
        call composition_expect_char
        call composition_expr_begin
        call composition_parse_expr
        call composition_save_pop
        call composition_compose_access
        call composition_expr_finish
        ret

composition_stmt_assign:
        ; Restore trivia-free parsing to the byte after the target identifier.
        imm r1, 524928
        load r2, r1
        imm r1, 524304
        store r1, r2
        imm r6, 2
        call composition_take_access
        mov r20, r0
        imm r21, 0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        imm r20, 61
        call composition_expect_char
        call composition_expr_begin
        call composition_parse_expr
        call composition_save_pop
        call composition_compose_access
        call composition_expr_finish
        ret

composition_stmt_call:
        imm r1, 524928
        load r2, r1
        imm r1, 524304
        store r1, r2
        call composition_expr_begin
        call composition_parse_call_after_ident
        call composition_expr_finish
        ret

composition_stmt_return:
        imm r6, 5
        call composition_take_event
        mov r20, r0
        imm r21, 0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        call composition_expr_begin
        call composition_parse_expr
        call composition_save_pop
        ; The event pc is the final ret; the canonical epilogue starts 19 bytes
        ; before it and consumes the expression result from r0 without changing
        ; the relative temporary height.
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7135232
        add r1, r2
        load r20, r1
        imm r21, 19
        imm r22, 1
        call composition_compose_gap_piece
        call composition_expr_finish
        ret

composition_stmt_to:
        imm r6, 0                       ; unguarded until `when` is seen
        call composition_take_transition
        mov r20, r0
        imm r21, 0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        call composition_require_ident ; target state
        call skip_trivia
        call current_byte
        mov r20, r0
        call is_ident_start
        imm r1, 1
        jeq r0, r1, composition_to_maybe_when
composition_to_unguarded:
        call composition_save_pop
        mov r2, r20
        call composition_require_transition_guard
        ret
composition_to_maybe_when:
        ; `to S` ends before any non-`when` identifier-leading statement. Save
        ; and restore that next statement's start when the identifier differs.
        imm r1, 524304
        load r2, r1
        imm r1, 524952
        store r1, r2
        call read_ident
        call ident_is_when
        imm r1, 1
        jeq r0, r1, composition_to_guarded
        imm r1, 524952
        load r2, r1
        imm r1, 524304
        store r1, r2
        jmp composition_to_unguarded
composition_to_guarded:
        call composition_save_pop
        mov r2, r20                     ; transition index
        imm r6, 1
        call composition_require_transition_guard
        mov r20, r2
        imm r21, 0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        call composition_expr_begin
        call composition_parse_expr
        call composition_save_pop
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 3239936
        add r1, r2
        load r20, r1
        imm r21, 0
        imm r22, 19
        call composition_compose_gap_piece
        call composition_expr_finish
        ret

composition_stmt_emit:
        imm r6, 4
        call composition_take_event
        imm r20, 40
        call composition_expect_char
        call composition_skip_string
        imm r20, 41
        call composition_expect_char
        ret

; Parse expression precedence exactly as Beta: one optional comparison over
; left-associative add/sub and mul/div/mod terms.
composition_parse_expr:
        call composition_parse_add
composition_comparison_loop:
        call skip_trivia
        call current_byte
        imm r1, 60
        jeq r0, r1, composition_cmp_lt
        imm r1, 62
        jeq r0, r1, composition_cmp_gt
        imm r1, 61
        jeq r0, r1, composition_cmp_eq
        imm r1, 33
        jeq r0, r1, composition_cmp_ne
        ret
composition_cmp_lt:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, composition_cmp_le
        imm r7, 8
        jmp composition_cmp_take
composition_cmp_le:
        call advance_one
        imm r7, 12
        jmp composition_cmp_take
composition_cmp_gt:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, composition_cmp_ge
        imm r7, 9
        jmp composition_cmp_take
composition_cmp_ge:
        call advance_one
        imm r7, 13
        jmp composition_cmp_take
composition_cmp_eq:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, composition_cmp_eq_pair
        jmp reject
composition_cmp_eq_pair:
        call advance_one
        imm r7, 10
        jmp composition_cmp_take
composition_cmp_ne:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, composition_cmp_ne_pair
        jmp reject
composition_cmp_ne_pair:
        call advance_one
        imm r7, 11
composition_cmp_take:
        imm r6, 3
        call composition_take_primitive
        mov r20, r0
        imm r21, 1
        call composition_take_push
        mov r21, r0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        mov r20, r21
        call composition_compose_push
        call composition_stack_push
        call composition_parse_add
        call composition_save_pop
        call composition_compose_primitive
        call composition_stack_pop
        ; The frozen Beta surface admits at most one comparison per expression.
        ret

composition_parse_add:
        call composition_parse_term
composition_add_loop:
        call skip_trivia
        call current_byte
        imm r1, 43
        jeq r0, r1, composition_add_op
        imm r1, 45
        jeq r0, r1, composition_sub_op
        ret
composition_add_op:
        imm r7, 3
        jmp composition_arithmetic_take
composition_sub_op:
        imm r7, 4
composition_arithmetic_take:
        call advance_one
        imm r6, 2
        call composition_take_primitive
        mov r20, r0
        imm r21, 1
        call composition_take_push
        mov r21, r0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        mov r20, r21
        call composition_compose_push
        call composition_stack_push
        call composition_parse_term
        call composition_save_pop
        call composition_compose_primitive
        call composition_stack_pop
        jmp composition_add_loop

composition_parse_term:
        call composition_parse_factor
composition_term_loop:
        call skip_trivia
        call current_byte
        imm r1, 42
        jeq r0, r1, composition_mul_op
        imm r1, 47
        jeq r0, r1, composition_div_op
        imm r1, 37
        jeq r0, r1, composition_mod_op
        ret
composition_mul_op:
        imm r7, 5
        jmp composition_term_take
composition_div_op:
        imm r7, 6
        jmp composition_term_take
composition_mod_op:
        imm r7, 7
composition_term_take:
        call advance_one
        imm r6, 2
        call composition_take_primitive
        mov r20, r0
        imm r21, 1
        call composition_take_push
        mov r21, r0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        mov r20, r21
        call composition_compose_push
        call composition_stack_push
        call composition_parse_factor
        call composition_save_pop
        call composition_compose_primitive
        call composition_stack_pop
        jmp composition_term_loop

composition_parse_factor:
        call skip_trivia
        call current_byte
        imm r1, 40
        jeq r0, r1, composition_factor_paren
        imm r1, 39
        jeq r0, r1, composition_factor_char
        imm r1, 48
        jlt r0, r1, composition_factor_ident_check
        imm r1, 58
        jlt r0, r1, composition_factor_decimal
composition_factor_ident_check:
        mov r20, r0
        call is_ident_start
        imm r1, 1
        jeq r0, r1, composition_factor_ident
        jmp reject
composition_factor_paren:
        call advance_one
        call composition_parse_expr
        imm r20, 41
        call composition_expect_char
        ret
composition_factor_char:
        call composition_skip_char
        imm r6, 1
        imm r7, 0                       ; value already source-bound lexically
        call composition_take_primitive_kind
        mov r20, r0
        call composition_compose_primitive
        ret
composition_factor_decimal:
        call composition_skip_decimal
        imm r6, 1
        imm r7, 0
        call composition_take_primitive_kind
        mov r20, r0
        call composition_compose_primitive
        ret
composition_factor_ident:
        call read_ident
        imm r1, 524304
        load r2, r1
        imm r1, 524928
        store r1, r2
        call skip_trivia
        call current_byte
        imm r1, 91
        jeq r0, r1, composition_factor_maybe_memory
        imm r1, 40
        jeq r0, r1, composition_factor_call
        imm r1, 524928
        load r2, r1
        imm r1, 524304
        store r1, r2
        imm r6, 1
        call composition_take_access
        mov r20, r0
        call composition_compose_access
        ret
composition_factor_maybe_memory:
        call ident_is_byte
        imm r1, 1
        jeq r0, r1, composition_factor_memory_byte
        call ident_is_word
        imm r1, 1
        jeq r0, r1, composition_factor_memory_word
        jmp reject
composition_factor_memory_byte:
        imm r7, 1
        jmp composition_factor_memory
composition_factor_memory_word:
        imm r7, 8
composition_factor_memory:
        imm r6, 1
        call composition_take_memory
        mov r20, r0
        imm r21, 0
        imm r22, 0
        imm r23, 0
        imm r24, 0
        call composition_save_push
        imm r20, 91
        call composition_expect_char
        call composition_parse_expr
        imm r20, 93
        call composition_expect_char
        call composition_save_pop
        call composition_compose_memory
        ret
composition_factor_call:
        imm r1, 524928
        load r2, r1
        imm r1, 524304
        store r1, r2
        jmp composition_parse_call_after_ident

; The current identifier names a call and the cursor is immediately after it.
composition_parse_call_after_ident:
        call ident_is_read_byte
        imm r1, 1
        jeq r0, r1, composition_call_read_kind
        call ident_is_write_byte
        imm r1, 1
        jeq r0, r1, composition_call_write_kind
        call ident_is_emit
        imm r1, 1
        jeq r0, r1, composition_call_emit_kind
        imm r6, 1
        jmp composition_call_take
composition_call_read_kind:
        imm r6, 2
        jmp composition_call_take
composition_call_write_kind:
        imm r6, 3
        jmp composition_call_take
composition_call_emit_kind:
        imm r6, 4
composition_call_take:
        call composition_take_event
        mov r20, r0                     ; event index
        mov r2, r0
        imm r1, 8
        mul r2, r1
        imm r1, 7143424
        add r1, r2
        load r22, r1                    ; arity
        mov r21, r6                     ; kind
        imm r23, 0
        imm r1, 1
        jeq r21, r1, composition_call_reserve_args
        jmp composition_call_record
composition_call_reserve_args:
        imm r1, 524872
        load r23, r1                    ; category base/full index
        mov r2, r23
        add r2, r22
        imm r3, 369
        jlt r3, r2, reject
        store r1, r2
composition_call_record:
        ; Preserve the stack height before this call begins evaluating/staging
        ; its own arguments.  For an ordinary call this is the exact temporary
        ; height still live across the eventual Alpha call instruction.
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 10035200
        add r2, r1
        imm r1, 524912
        load r3, r1
        store r2, r3
        imm r24, 0                      ; parsed argument count
        call composition_save_push
        imm r20, 40
        call composition_expect_char
composition_call_arg_loop:
        call skip_trivia
        call current_byte
        imm r1, 41
        jeq r0, r1, composition_call_args_done
        call composition_parse_expr
        call composition_save_peek
        imm r1, 1
        jeq r21, r1, composition_call_push_arg
        jmp composition_call_count_arg
composition_call_push_arg:
        mov r20, r23
        add r20, r24
        call composition_compose_push
        call composition_stack_push
composition_call_count_arg:
        call composition_save_increment_top_arg
        call skip_trivia
        call current_byte
        imm r1, 44
        jeq r0, r1, composition_call_comma
        imm r1, 41
        jeq r0, r1, composition_call_args_done
        jmp reject
composition_call_comma:
        call advance_one
        jmp composition_call_arg_loop
composition_call_args_done:
        call advance_one
        call composition_save_pop
        jeq r24, r22, composition_call_arity_ok
        jmp reject
composition_call_arity_ok:
        imm r1, 1
        jeq r21, r1, composition_call_ordinary
        imm r1, 2
        jeq r21, r1, composition_call_read
        imm r1, 3
        jeq r21, r1, composition_call_write
        ; emit is statement-only in the exact bc source.
        jmp reject
composition_call_ordinary:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7135232
        add r1, r2
        load r20, r1
        mov r21, r22
        imm r1, 16
        mul r21, r1                     ; contiguous unstage gap
        imm r22, 9
        call composition_compose_gap_piece
composition_call_pop_loop:
        imm r1, 0
        jeq r24, r1, composition_call_done
        call composition_stack_pop
        imm r1, 1
        sub r24, r1
        jmp composition_call_pop_loop
composition_call_read:
        imm r1, 0
        jeq r22, r1, composition_call_read_pc
        jmp reject
composition_call_read_pc:
        call composition_compose_event_two
        ret
composition_call_write:
        imm r1, 1
        jeq r22, r1, composition_call_write_pc
        jmp reject
composition_call_write_pc:
        call composition_compose_event_two
        ret
composition_call_done:
        ret

composition_compose_event_two:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7135232
        add r1, r2
        load r20, r1
        imm r21, 2
        call composition_compose_piece
        ret

; ---- Table consumption --------------------------------------------------

; Expected kind r6 and exact primitive value/opcode r7; return index r0.
composition_take_primitive:
        imm r1, 524824
        load r0, r1
        imm r2, 816
        jlt r0, r2, composition_take_primitive_row
        jmp reject
composition_take_primitive_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 8396800
        add r3, r2
        load r4, r3
        jeq r4, r6, composition_take_primitive_value
        jmp reject
composition_take_primitive_value:
        imm r3, 8404992
        add r3, r2
        load r4, r3
        jeq r4, r7, composition_take_primitive_block
        jmp reject
composition_take_primitive_kind:
        imm r1, 524824
        load r0, r1
        imm r2, 816
        jlt r0, r2, composition_take_primitive_kind_row
        jmp reject
composition_take_primitive_kind_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 8396800
        add r3, r2
        load r4, r3
        jeq r4, r6, composition_take_primitive_block
        jmp reject
composition_take_primitive_block:
        imm r3, 8388608
        add r3, r2
        load r4, r3
        call composition_require_current_block
        imm r1, 524824
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Expected access kind r6; return index r0.
composition_take_access:
        imm r1, 524832
        load r0, r1
        imm r2, 242
        jlt r0, r2, composition_take_access_row
        jmp reject
composition_take_access_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 7176192
        add r3, r2
        load r4, r3
        jeq r4, r6, composition_take_access_block
        jmp reject
composition_take_access_block:
        imm r3, 7168000
        add r3, r2
        load r4, r3
        call composition_require_current_block
        imm r1, 524832
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Expected memory kind r6 and width r7; return index r0.
composition_take_memory:
        imm r1, 524840
        load r0, r1
        imm r2, 95
        jlt r0, r2, composition_take_memory_row
        jmp reject
composition_take_memory_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 7610368
        add r3, r2
        load r4, r3
        jeq r4, r6, composition_take_memory_width
        jmp reject
composition_take_memory_width:
        imm r3, 7618560
        add r3, r2
        load r4, r3
        jeq r4, r7, composition_take_memory_block
        jmp reject
composition_take_memory_block:
        imm r3, 7602176
        add r3, r2
        load r4, r3
        call composition_require_current_block
        imm r1, 524840
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Expected effect kind r6; return index r0.
composition_take_event:
        imm r1, 524848
        load r0, r1
        imm r2, 613
        jlt r0, r2, composition_take_event_row
        jmp reject
composition_take_event_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 7086080
        add r3, r2
        load r4, r3
        jeq r4, r6, composition_take_event_block
        jmp reject
composition_take_event_block:
        imm r3, 7077888
        add r3, r2
        load r4, r3
        call composition_require_current_block
        imm r1, 524848
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; r6 is 0/1 guarded expectation; return transition index r0.  Guard metadata
; is checked after the optional `when` has been parsed.
composition_take_transition:
        imm r1, 524856
        load r0, r1
        imm r2, 291
        jlt r0, r2, composition_take_transition_row
        jmp reject
composition_take_transition_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 3215360
        add r3, r2
        load r4, r3
        call composition_require_current_block
        imm r1, 524856
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Transition index r2, expected guarded bit r6.
composition_require_transition_guard:
        mov r3, r2
        imm r1, 8
        mul r3, r1
        imm r1, 3227648
        add r1, r3
        load r4, r1
        jeq r4, r6, composition_transition_guard_ok
        jmp reject
composition_transition_guard_ok:
        ret

; Expected push kind r21; return full push index r0.  Category counters already
; choose the correct section of the category-grouped BCT8 push table.
composition_take_push:
        imm r1, 1
        jeq r21, r1, composition_take_binary_push
        imm r1, 3
        jeq r21, r1, composition_take_store_push
        jmp reject
composition_take_binary_push:
        imm r1, 524864
        jmp composition_take_push_counter
composition_take_store_push:
        imm r1, 524880
composition_take_push_counter:
        mov r5, r1                     ; preserve selected category counter
        load r0, r1
        imm r2, 403
        jlt r0, r2, composition_take_push_row
        jmp reject
composition_take_push_row:
        mov r2, r0
        imm r3, 8
        mul r2, r3
        imm r3, 9445376
        add r3, r2
        load r4, r3
        jeq r4, r21, composition_take_push_block
        jmp reject
composition_take_push_block:
        imm r3, 9437184
        add r3, r2
        load r4, r3
        call composition_require_current_block
        load r2, r5
        imm r3, 1
        add r2, r3
        store r5, r2
        ret

composition_require_current_block:
        imm r1, 524800
        load r2, r1
        jeq r4, r2, composition_current_block_ok
        jmp reject
composition_current_block_ok:
        ret

; ---- Piece composition and symbolic temporary height --------------------

composition_expr_begin:
        imm r0, 0
        imm r1, 524896
        store r1, r0
        imm r1, 524912
        store r1, r0
        ret

composition_expr_finish:
        imm r1, 524896
        load r2, r1
        imm r3, 1
        jeq r2, r3, composition_finish_balanced
        jmp reject
composition_finish_balanced:
        imm r1, 524912
        load r2, r1
        imm r3, 0
        jeq r2, r3, composition_finish_ok
        jmp reject
composition_finish_ok:
        ret

; Piece begins at r20 and has r21 bytes.
composition_compose_piece:
        imm r1, 524896
        load r2, r1
        imm r3, 0
        jeq r2, r3, composition_piece_first
        imm r1, 524888
        load r2, r1
        jeq r2, r20, composition_piece_advance
        jmp reject
composition_piece_first:
        imm r2, 1
        imm r1, 524896
        store r1, r2
composition_piece_advance:
        add r20, r21
        imm r1, 524888
        store r1, r20
        ret

; Piece opcode at r20 is preceded by r21 bytes already validated elsewhere;
; the opcode itself has r22 bytes.  This binds call pops, store pops, and return
; epilogues without duplicating their byte validators.
composition_compose_gap_piece:
        imm r1, 524896
        load r2, r1
        imm r3, 0
        jeq r2, r3, composition_gap_zero_prefix
        imm r1, 524888
        load r2, r1
        add r2, r21
        jeq r2, r20, composition_gap_advance
        jmp reject
composition_gap_zero_prefix:
        imm r1, 0
        jeq r21, r1, composition_gap_first
        jmp reject
composition_gap_first:
        imm r2, 1
        imm r1, 524896
        store r1, r2
composition_gap_advance:
        add r20, r22
        imm r1, 524888
        store r1, r20
        ret

composition_compose_primitive:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 8413184
        add r1, r2
        load r20, r1
        imm r1, 8396800
        add r1, r2
        load r3, r1
        imm r1, 1
        jeq r3, r1, composition_primitive_literal_len
        imm r1, 2
        jeq r3, r1, composition_primitive_arithmetic_len
        imm r1, 3
        jeq r3, r1, composition_primitive_comparison_len
        jmp reject
composition_primitive_literal_len:
        imm r21, 10
        jmp composition_compose_piece
composition_primitive_arithmetic_len:
        imm r21, 22
        jmp composition_compose_piece
composition_primitive_comparison_len:
        imm r21, 59
        jmp composition_compose_piece

composition_compose_access:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7192576
        add r1, r2
        load r20, r1
        imm r21, 19
        jmp composition_compose_piece

composition_compose_memory:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7626752
        add r1, r2
        load r20, r1
        imm r21, 3
        jmp composition_compose_piece

composition_compose_push:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 9453568
        add r1, r2
        load r20, r1
        imm r21, 16
        jmp composition_compose_piece

composition_stack_push:
        imm r1, 524912
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        imm r1, 524920
        load r3, r1
        jlt r3, r2, composition_stack_new_peak
        jmp composition_stack_proc_peak
composition_stack_new_peak:
        store r1, r2
composition_stack_proc_peak:
        ; parsed-procedure count is incremented before its body is composed.
        imm r1, 524808
        load r3, r1
        imm r4, 1
        sub r3, r4
        imm r4, 8
        mul r3, r4
        imm r4, 10043392
        add r3, r4
        load r4, r3
        jlt r4, r2, composition_stack_proc_new_peak
        ret
composition_stack_proc_new_peak:
        store r3, r2
        ret
composition_stack_pop:
        imm r1, 524912
        load r2, r1
        imm r3, 0
        jlt r3, r2, composition_stack_pop_ok
        jmp reject
composition_stack_pop_ok:
        imm r3, 1
        sub r2, r3
        store r1, r2
        ret

; ---- Bounded parser save stack ------------------------------------------

composition_save_push:
        imm r1, 524904
        load r2, r1
        imm r3, 256
        jlt r2, r3, composition_save_room
        jmp reject
composition_save_room:
        mov r3, r2
        imm r4, 40
        mul r3, r4
        imm r4, 9961472
        add r3, r4
        store r3, r20
        imm r4, 8
        add r3, r4
        store r3, r21
        add r3, r4
        store r3, r22
        add r3, r4
        store r3, r23
        add r3, r4
        store r3, r24
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

composition_save_peek:
        imm r1, 524904
        load r2, r1
        imm r3, 0
        jlt r3, r2, composition_save_peek_ok
        jmp reject
composition_save_peek_ok:
        imm r3, 1
        sub r2, r3
        mov r3, r2
        imm r4, 40
        mul r3, r4
        imm r4, 9961472
        add r3, r4
        load r20, r3
        imm r4, 8
        add r3, r4
        load r21, r3
        add r3, r4
        load r22, r3
        add r3, r4
        load r23, r3
        add r3, r4
        load r24, r3
        ret

composition_save_pop:
        call composition_save_peek
        imm r1, 524904
        load r2, r1
        imm r3, 1
        sub r2, r3
        store r1, r2
        ret

composition_save_increment_top_arg:
        imm r1, 524904
        load r2, r1
        imm r3, 0
        jlt r3, r2, composition_save_increment_ok
        jmp reject
composition_save_increment_ok:
        imm r3, 1
        sub r2, r3
        imm r3, 40
        mul r2, r3
        imm r3, 9961504             ; base + fourth word (arg count)
        add r2, r3
        load r3, r2
        imm r4, 1
        add r3, r4
        store r2, r3
        ret

; ---- Lexical helpers ----------------------------------------------------

composition_expect_char:
        call skip_trivia
        call current_byte
        jeq r0, r20, composition_expect_char_ok
        jmp reject
composition_expect_char_ok:
        call advance_one
        ret

composition_require_ident:
        call skip_trivia
        call current_byte
        mov r20, r0
        call is_ident_start
        imm r1, 1
        jeq r0, r1, composition_require_ident_ok
        jmp reject
composition_require_ident_ok:
        call read_ident
        ret

composition_skip_decimal:
composition_decimal_loop:
        call current_byte
        imm r1, 48
        jlt r0, r1, composition_decimal_done
        imm r1, 58
        jlt r0, r1, composition_decimal_advance
composition_decimal_done:
        ret
composition_decimal_advance:
        call advance_one
        jmp composition_decimal_loop

; Classify the exact source address of store site r20 without consuming it for
; the ordinary expression composer.  Exact bc.beta has 31 fixed compiler-global
; word stores and three guarded ranged stores: the source byte capture plus the
; paired local-name tables.  The latter spellings are pinned here; their
; induction/guard schemas remain a blockwise abstract-interpretation obligation.
composition_validate_store_address:
        imm r1, 524304
        load r2, r1
        imm r1, 525096
        store r1, r2
        imm r1, 0
        jeq r20, r1, composition_store_source_range
        imm r1, 39
        jeq r20, r1, composition_store_nameoff_range
        imm r1, 41
        jeq r20, r1, composition_store_namelen_range
        call composition_store_parse_fixed
        imm r1, 525080
        jmp composition_store_increment
composition_store_source_range:
        imm r20, composition_store_source_literal
        imm r21, 11
        call composition_store_require_literal
        jmp composition_store_ranged_count
composition_store_nameoff_range:
        imm r20, composition_store_nameoff_literal
        imm r21, 15
        call composition_store_require_literal
        jmp composition_store_ranged_count
composition_store_namelen_range:
        imm r20, composition_store_namelen_literal
        imm r21, 15
        call composition_store_require_literal
composition_store_ranged_count:
        imm r1, 525088
composition_store_increment:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        imm r1, 525096
        load r2, r1
        imm r1, 524304
        store r1, r2
        ret

composition_store_parse_fixed:
        call skip_trivia
        imm r8, 0
        imm r9, 0
composition_store_fixed_digit_loop:
        call current_byte
        imm r1, 48
        jlt r0, r1, composition_store_fixed_digits_done
        imm r1, 58
        jlt r0, r1, composition_store_fixed_digit
composition_store_fixed_digits_done:
        imm r1, 1
        jeq r9, r1, composition_store_fixed_range
        jmp reject
composition_store_fixed_digit:
        imm r1, 10
        mul r8, r1
        imm r1, 48
        sub r0, r1
        add r8, r0
        imm r9, 1
        call advance_one
        jmp composition_store_fixed_digit_loop
composition_store_fixed_range:
        imm r1, 2097064
        jlt r8, r1, reject
        imm r1, 2097145
        jlt r8, r1, composition_store_fixed_aligned
        jmp reject
composition_store_fixed_aligned:
        mov r0, r8
        imm r1, 8
        mod r0, r1
        imm r1, 0
        jeq r0, r1, composition_store_fixed_close
        jmp reject
composition_store_fixed_close:
        call skip_trivia
        call current_byte
        imm r1, 93
        jeq r0, r1, composition_store_fixed_done
        jmp reject
composition_store_fixed_done:
        ret

; Current source cursor must begin with checker-tape literal r20/r21 and be
; followed only by trivia and the closing address bracket.  Cursor is restored.
composition_store_require_literal:
        imm r1, 524304
        load r25, r1
        imm r22, 0
composition_store_literal_loop:
        jlt r22, r21, composition_store_literal_byte
        mov r23, r25
        add r23, r21
        imm r1, 524304
        store r1, r23
        call skip_trivia
        call current_byte
        imm r1, 93
        jeq r0, r1, composition_store_literal_done
        jmp reject
composition_store_literal_byte:
        imm r1, 1048576
        add r1, r25
        add r1, r22
        loadb r2, r1
        mov r1, r20
        add r1, r22
        loadb r3, r1
        jeq r2, r3, composition_store_literal_next
        jmp reject
composition_store_literal_next:
        imm r1, 1
        add r22, r1
        jmp composition_store_literal_loop
composition_store_literal_done:
        imm r1, 524304
        store r1, r25
        ret

composition_skip_char:
        call advance_one                 ; opening quote
        call current_byte
        imm r1, 92
        jeq r0, r1, composition_char_escape
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        jmp composition_char_close
composition_char_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
composition_char_close:
        call current_byte
        imm r1, 39
        jeq r0, r1, composition_char_done
        jmp reject
composition_char_done:
        call advance_one
        ret

composition_skip_string:
        call skip_trivia
        call current_byte
        imm r1, 34
        jeq r0, r1, composition_string_open
        jmp reject
composition_string_open:
        call advance_one
composition_string_loop:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 34
        jeq r0, r1, composition_string_done
        imm r1, 92
        jeq r0, r1, composition_string_escape
        call advance_one
        jmp composition_string_loop
composition_string_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        jmp composition_string_loop
composition_string_done:
        call advance_one
        ret

composition_program_done:
        ; Every independently reconstructed source component must have been
        ; consumed exactly once by the grammar-directed traversal.
        imm r1, 524808
        load r2, r1
        imm r3, 70
        jeq r2, r3, composition_count_blocks
        jmp reject
composition_count_blocks:
        imm r1, 524816
        load r2, r1
        imm r3, 355
        jeq r2, r3, composition_count_primitives
        jmp reject
composition_count_primitives:
        imm r1, 524824
        load r2, r1
        imm r3, 816
        jeq r2, r3, composition_count_accesses
        jmp reject
composition_count_accesses:
        imm r1, 524832
        load r2, r1
        imm r3, 242
        jeq r2, r3, composition_count_memory
        jmp reject
composition_count_memory:
        imm r1, 524840
        load r2, r1
        imm r3, 95
        jeq r2, r3, composition_count_events
        jmp reject
composition_count_events:
        imm r1, 524848
        load r2, r1
        imm r3, 613
        jeq r2, r3, composition_count_transitions
        jmp reject
composition_count_transitions:
        imm r1, 524856
        load r2, r1
        imm r3, 291
        jeq r2, r3, composition_count_binary_pushes
        jmp reject
composition_count_binary_pushes:
        imm r1, 524864
        load r2, r1
        imm r3, 235
        jeq r2, r3, composition_count_argument_pushes
        jmp reject
composition_count_argument_pushes:
        imm r1, 524872
        load r2, r1
        imm r3, 369
        jeq r2, r3, composition_count_store_pushes
        jmp reject
composition_count_store_pushes:
        imm r1, 524880
        load r2, r1
        imm r3, 403
        jeq r2, r3, composition_count_save_stack
        jmp reject
composition_count_save_stack:
        imm r1, 524904
        load r2, r1
        imm r3, 0
        jeq r2, r3, composition_count_peak
        jmp reject
composition_count_peak:
        imm r1, 524920
        load r2, r1
        imm r3, 2
        jeq r2, r3, composition_count_fixed_stores
        jmp reject
composition_count_fixed_stores:
        imm r1, 525080
        load r2, r1
        imm r3, 31
        jeq r2, r3, composition_count_ranged_stores
        jmp reject
composition_count_ranged_stores:
        imm r1, 525088
        load r2, r1
        imm r3, 3
        jeq r2, r3, call_bounds_resolve_specials
        jmp reject

composition_store_source_literal:
        db "2097152 + n"
composition_store_nameoff_literal:
        db "3145728 + s * 8"
composition_store_namelen_literal:
        db "3153920 + s * 8"
