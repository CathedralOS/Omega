        imm r24, 0
        imm r25, 1939               ; unchecked tail adv two
        imm r26, 38464              ; checked second tail continuation
        call summary_require_call_site
        imm r20, 420
        imm r21, 266
        imm r22, 5
        imm r23, 38502              ; explicit return v
        call slurp_summary_require_event
        imm r20, 38483
        imm r21, 38502
        call slurp_summary_require_epilogue
        imm r20, 38503
        imm r21, 38522
        call slurp_summary_require_epilogue
        ret

