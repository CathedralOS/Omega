parse_char_require_censuses:
        imm r20, 256
        imm r21, 266
        imm r22, 155
        imm r23, 167                 ; exclusive local row
        imm r24, 55
        imm r25, 55                  ; no raw-memory rows
        imm r26, 197
        imm r27, 211                 ; exclusive transition row
        imm r28, 414
        imm r29, 421                 ; exclusive event row
        call cursor_require_effect_census
        imm r20, 256
        imm r21, 266
        imm r22, 608
        imm r23, 622                 ; exclusive primitive row
        imm r24, 178
        imm r25, 183                 ; exclusive binary-push row
        imm r26, 335                 ; exact empty argument-push start
        imm r27, 335                 ; exact empty argument-push interval
        imm r28, 387
        imm r29, 387                 ; exact empty store-address interval
        call summary_require_expr_census
        imm r20, 37528
        imm r21, 38523
        imm r22, 6                   ; four adv plus two cbyte calls
        imm r23, 2                   ; parse_char explicit and synthetic return
        imm r24, 12                  ; prologue/local/binary stores
        call parse_char_scan_region
        ret

; Exact decoded census for [r20,r21), rejecting direct I/O, halt, byte memory,
; division, and remainder. r22/r23/r24 are call/ret/store totals.
parse_char_scan_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r10, 0
        imm r11, 0
        imm r12, 0
parse_char_scan_loop:
        jlt r25, r26, parse_char_scan_pc
        jeq r10, r27, parse_char_scan_rets
        jmp reject
parse_char_scan_rets:
        jeq r11, r28, parse_char_scan_stores
        jmp reject
parse_char_scan_stores:
        jeq r12, r29, parse_char_scan_done
        jmp reject
parse_char_scan_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, parse_char_scan_start
        jmp parse_char_scan_next
parse_char_scan_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, parse_char_scan_call
        imm r3, 20
        jeq r2, r3, parse_char_scan_ret
        imm r3, 11
        jeq r2, r3, parse_char_scan_store
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 8
        jeq r2, r3, reject
        imm r3, 9
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        jmp parse_char_scan_next
parse_char_scan_call:
        imm r1, 1
        add r10, r1
        jmp parse_char_scan_next
parse_char_scan_ret:
        imm r1, 1
        add r11, r1
        jmp parse_char_scan_next
parse_char_scan_store:
        imm r1, 1
        add r12, r1
parse_char_scan_next:
        imm r1, 1
        add r25, r1
        jmp parse_char_scan_loop
parse_char_scan_done:
        ret
