        imm r23, 266
        imm r24, 37927
        call slurp_summary_require_transition
        imm r20, 202
        imm r21, 260
        imm r22, 1
        imm r23, 261
        imm r24, 38040              ; escaped t
        call slurp_summary_require_transition
        imm r20, 203
        imm r21, 260
        imm r22, 0
        imm r23, 262
        imm r24, 38059
        call slurp_summary_require_transition
        imm r20, 204
        imm r21, 261
        imm r22, 0
        imm r23, 266
        imm r24, 38097
        call slurp_summary_require_transition
        imm r20, 205
        imm r21, 262
        imm r22, 1
        imm r23, 263
        imm r24, 38210              ; escaped r
        call slurp_summary_require_transition
        imm r20, 206
        imm r21, 262
        imm r22, 0
        imm r23, 264
        imm r24, 38229
        call slurp_summary_require_transition
        imm r20, 207
        imm r21, 263
        imm r22, 0
        imm r23, 266
        imm r24, 38267
        call slurp_summary_require_transition
        imm r20, 208
        imm r21, 264
        imm r22, 1
        imm r23, 265
        imm r24, 38380              ; escaped zero
        call slurp_summary_require_transition
        imm r20, 209
        imm r21, 264
        imm r22, 0
        imm r23, 266
        imm r24, 38399              ; unrecognized escape
        call slurp_summary_require_transition
        imm r20, 210
        imm r21, 265
        imm r22, 0
        imm r23, 266
        imm r24, 38437
        call slurp_summary_require_transition
