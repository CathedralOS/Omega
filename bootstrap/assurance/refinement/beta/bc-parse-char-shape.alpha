; Exact source/artifact shape for parse_char() procedure56.
;
; Owns the eleven blocks, complete finite escape partition, six cursor calls,
; explicit/synthetic returns, one local slot, exact comparisons/constants,
; binary pushes, and exhaustive decoded/table censuses. The adjacent meaning
; module owns ordinary/escape values and deliberately malformed tail behavior.

parse_char_require_shape:
        imm r20, 7151616
        imm r21, 56
        imm r22, 0                    ; no parameters
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 56
        imm r22, 1                    ; local v
        call transfer_require_cell
        imm r20, 56
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, parse_char_shape_blocks
        jmp reject

parse_char_shape_blocks:
        imm r20, 256
        imm r21, 37528
        call slurp_summary_require_block_pc
        imm r20, 257
        imm r21, 37597
        call slurp_summary_require_block_pc
        imm r20, 258
        imm r21, 37729
        call slurp_summary_require_block_pc
        imm r20, 259
        imm r21, 37898
        call slurp_summary_require_block_pc
        imm r20, 260
        imm r21, 37936
        call slurp_summary_require_block_pc
        imm r20, 261
        imm r21, 38068
        call slurp_summary_require_block_pc
        imm r20, 262
        imm r21, 38106
        call slurp_summary_require_block_pc
        imm r20, 263
        imm r21, 38238
        call slurp_summary_require_block_pc
        imm r20, 264
        imm r21, 38276
        call slurp_summary_require_block_pc
        imm r20, 265
        imm r21, 38408
        call slurp_summary_require_block_pc
        imm r20, 266
        imm r21, 38446
        call slurp_summary_require_block_pc
        imm r20, 256
        imm r21, 266
        imm r22, 56
        call cursor_require_proc_blocks
        call parse_char_require_transitions
        call parse_char_require_events
        call parse_char_require_locals
        call parse_char_require_primitives
        call parse_char_require_pushes
        call parse_char_require_censuses
        ret

parse_char_require_transitions:
        imm r20, 197
        imm r21, 257
        imm r22, 1
        imm r23, 258
        imm r24, 37701              ; first byte is backslash
        call slurp_summary_require_transition
        imm r20, 198
        imm r21, 257
        imm r22, 0
        imm r23, 266
        imm r24, 37720              ; ordinary/default byte
        call slurp_summary_require_transition
        imm r20, 199
        imm r21, 258
        imm r22, 1
        imm r23, 259
        imm r24, 37870              ; escaped n
        call slurp_summary_require_transition
        imm r20, 200
        imm r21, 258
        imm r22, 0
        imm r23, 260
        imm r24, 37889
        call slurp_summary_require_transition
        imm r20, 201
        imm r21, 259
