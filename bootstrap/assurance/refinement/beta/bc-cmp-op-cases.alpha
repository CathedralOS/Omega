; Finite byte partitions for cmp_op(). Path/cursor composition is separate.

cmp_op_sweep_first_bytes:
        imm r10, 0
        imm r11, 0                   ; '<'
        imm r12, 0                   ; '>'
        imm r13, 0                   ; '!'
        imm r16, 0                   ; '='
        imm r17, 0                   ; complement
cmp_op_first_loop:
        imm r1, 256
        jlt r10, r1, cmp_op_first_row
        jeq r10, r1, cmp_op_first_finish
        jmp reject
cmp_op_first_row:
        call cmp_op_eval_first_source
        call cmp_op_eval_first_spec
        imm r20, 529992
        imm r21, 530000
        call classifier_require_equal_cells
        imm r1, 529992
        load r2, r1
        imm r1, 1
        jeq r2, r1, cmp_op_count_lt
        imm r1, 2
        jeq r2, r1, cmp_op_count_gt
        imm r1, 3
        jeq r2, r1, cmp_op_count_bang
        imm r1, 4
        jeq r2, r1, cmp_op_count_eq
        imm r1, 1
        add r17, r1
        jmp cmp_op_first_next
cmp_op_count_lt:
        imm r1, 1
        add r11, r1
        jmp cmp_op_first_next
cmp_op_count_gt:
        imm r1, 1
        add r12, r1
        jmp cmp_op_first_next
cmp_op_count_bang:
        imm r1, 1
        add r13, r1
        jmp cmp_op_first_next
cmp_op_count_eq:
        imm r1, 1
        add r16, r1
cmp_op_first_next:
        imm r1, 1
        add r10, r1
        jmp cmp_op_first_loop
cmp_op_first_finish:
        imm r1, 1
        jeq r11, r1, cmp_op_first_count_gt
        jmp reject
cmp_op_first_count_gt:
        jeq r12, r1, cmp_op_first_count_bang
        jmp reject
cmp_op_first_count_bang:
        jeq r13, r1, cmp_op_first_count_eq
        jmp reject
cmp_op_first_count_eq:
        jeq r16, r1, cmp_op_first_count_other
        jmp reject
cmp_op_first_count_other:
        imm r1, 252
        jeq r17, r1, cmp_op_first_publish
        jmp reject
cmp_op_first_publish:
        imm r1, 530008
        imm r2, 1                    ; complete first-byte partition
        store r1, r2
        imm r1, 530016
        store r1, r11
        imm r1, 530024
        store r1, r12
        imm r1, 530032
        store r1, r13
        imm r1, 530040
        store r1, r16
        imm r1, 530048
        store r1, r17
        ret

; Source order is <,>,!,=. Branch tags are 1..4; zero is complement.
cmp_op_eval_first_source:
        mov r2, r10
        imm r1, 60                   ; source '<' discriminator
        jeq r2, r1, cmp_op_first_source_lt
        imm r1, 62                   ; source '>' discriminator
        jeq r2, r1, cmp_op_first_source_gt
        imm r1, 33                   ; source '!' discriminator
        jeq r2, r1, cmp_op_first_source_bang
        imm r1, 61                   ; source '=' discriminator
        jeq r2, r1, cmp_op_first_source_eq
        imm r2, 0
        jmp cmp_op_first_source_store
cmp_op_first_source_lt:
        imm r2, 1
        jmp cmp_op_first_source_store
cmp_op_first_source_gt:
        imm r2, 2
        jmp cmp_op_first_source_store
cmp_op_first_source_bang:
        imm r2, 3
        jmp cmp_op_first_source_store
cmp_op_first_source_eq:
        imm r2, 4
cmp_op_first_source_store:
        imm r1, 529992
        store r1, r2
        ret

; Independent specification order is =,!,>,<.
cmp_op_eval_first_spec:
        mov r2, r10
        imm r1, 61
        jeq r2, r1, cmp_op_first_spec_eq
        imm r1, 33
        jeq r2, r1, cmp_op_first_spec_bang
        imm r1, 62
        jeq r2, r1, cmp_op_first_spec_gt
        imm r1, 60
        jeq r2, r1, cmp_op_first_spec_lt
        imm r2, 0
        jmp cmp_op_first_spec_store
cmp_op_first_spec_lt:
        imm r2, 1
        jmp cmp_op_first_spec_store
cmp_op_first_spec_gt:
        imm r2, 2
        jmp cmp_op_first_spec_store
cmp_op_first_spec_bang:
        imm r2, 3
        jmp cmp_op_first_spec_store
cmp_op_first_spec_eq:
        imm r2, 4
cmp_op_first_spec_store:
        imm r1, 530000
        store r1, r2
        ret

cmp_op_sweep_lookahead:
        imm r10, 0
        imm r11, 0                   ; equals
        imm r12, 0                   ; complement
cmp_op_lookahead_loop:
        imm r1, 256
        jlt r10, r1, cmp_op_lookahead_row
        jeq r10, r1, cmp_op_lookahead_finish
        jmp reject
cmp_op_lookahead_row:
        imm r2, 0
        imm r1, 61                   ; source lookahead '='
        jeq r10, r1, cmp_op_lookahead_source_yes
        jmp cmp_op_lookahead_source_store
cmp_op_lookahead_source_yes:
        imm r2, 1
cmp_op_lookahead_source_store:
        imm r1, 530064
        store r1, r2
        imm r2, 0
        imm r1, 61                   ; independent singleton lower bound
        jlt r10, r1, cmp_op_lookahead_spec_store
        jlt r1, r10, cmp_op_lookahead_spec_store
        imm r2, 1
cmp_op_lookahead_spec_store:
        imm r1, 530072
        store r1, r2
        imm r20, 530064
        imm r21, 530072
        call classifier_require_equal_cells
        imm r1, 530064
        load r2, r1
        imm r1, 1
        jeq r2, r1, cmp_op_lookahead_count_yes
        imm r1, 1
        add r12, r1
        jmp cmp_op_lookahead_next
cmp_op_lookahead_count_yes:
        imm r1, 1
        add r11, r1
cmp_op_lookahead_next:
        imm r1, 1
        add r10, r1
        jmp cmp_op_lookahead_loop
cmp_op_lookahead_finish:
        imm r1, 1
        jeq r11, r1, cmp_op_lookahead_count_no
        jmp reject
cmp_op_lookahead_count_no:
        imm r1, 255
        jeq r12, r1, cmp_op_lookahead_publish
        jmp reject
cmp_op_lookahead_publish:
        imm r1, 530080
        imm r2, 1                    ; complete lookahead partition
        store r1, r2
        imm r1, 530088
        store r1, r11
        imm r1, 530096
        store r1, r12
        ret
