; Expression-only bounded tail adapters. parse_char may honestly finish at
; LEN+2 because its final two adv calls do not require a closing quote. CBLE's
; exact miss branch already covers every larger nonnegative cursor; rejoining
; that branch with the exact skip_ws/expect bodies proves the only extensions
; this SCC needs without widening their ordinary public contracts.

expression_tail_rules_init:
        imm r20, 540016
        imm r21, 1364349016             ; XPRQ
        call exact_require_cell
        imm r20, 525960
        imm r21, 1128421445             ; CBLE
        call exact_require_cell
        imm r20, 526216
        imm r21, 1398231888             ; SWSQ exact body/ordinary theorem
        call exact_require_cell
        imm r20, 526960
        imm r21, 1397774405             ; EXPS exact body/ordinary theorem
        call exact_require_cell
        imm r20, 529144
        imm r21, 1297436240             ; PNUM exact body/ordinary theorem
        call exact_require_cell
        imm r20, 529952
        imm r21, 1347374403             ; CMOP exact body/ordinary theorem
        call exact_require_cell
        call skip_step_require_shape
        call skip_require_shape
        call expect_require_shape

        ; Exhaust bounded tail delta d=0,1,2. For every case LEN<=CUR gives
        ; cbyte zero; zero is neither whitespace nor ';', so skip returns zero
        ; unchanged. Every nonzero expression delimiter mismatches and expect
        ; performs no adv. All three procedures remain quiet and restore frame.
        imm r10, 0
        imm r11, 0
expression_tail_delta_loop:
        imm r1, 3
        jlt r10, r1, expression_tail_delta_case
        imm r1, 3
        jeq r11, r1, expression_tail_publish
        jmp reject
expression_tail_delta_case:
        imm r1, 541176
        store r1, r10                  ; selected CUR=LEN+d
        imm r1, 541184
        imm r2, 1
        store r1, r2                   ; CBLE miss returns zero
        imm r1, 541192
        store r1, r2                   ; skip step returns zero
        imm r1, 541200
        store r1, r2                   ; outer skip exits, CUR unchanged
        imm r1, 541208
        store r1, r2                   ; delimiter!=0 mismatch
        imm r1, 541216
        store r1, r2                   ; expect no-adv, CUR unchanged
        imm r1, 541224
        store r1, r2                   ; trace/state quiet, frame restored
        imm r1, 541240
        store r1, r2                   ; parse_number sees non-digit zero
        imm r1, 541248
        store r1, r2                   ; returns Word0 without advancing
        imm r1, 541256
        store r1, r2                   ; cmp_op selects all-ones complement
        imm r1, 541264
        store r1, r2                   ; cmp_op leaves CUR unchanged
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp expression_tail_delta_loop
expression_tail_publish:
        imm r1, 541232
        imm r2, 3
        store r1, r2
        imm r20, 541232
        imm r21, 3
        call exact_require_cell
        imm r1, 540024
        imm r2, 1279347796             ; XTAL
        store r1, r2
        jmp expression_leaf_rules_init
