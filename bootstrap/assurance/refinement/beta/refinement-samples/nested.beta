; NESTED LOOP (inner bound CONCRETE): the outer loop is data-dependent (i < n, symbolic trip) while the
; inner loop runs a fixed 3 iterations — so ONE placeholder run of the outer body UNROLLS the inner loop
; concretely, leaving the additive spine ((total + a) + a) + a whose delta peels to (a + a) + a. Closed form
; n * ((a+a)+a) = 3na. First nesting slice; a symbolic inner bound still refuses (a later slice).
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = 0
    state outer { to obody when (i < n)  to done }
    state obody { let j = 0  to inner }
    state inner { to ibody when (j < 3)  to onext }
    state ibody { total = (total + a)  j = (j + 1)  to inner }
    state onext { i = (i + 1)  to outer }
    state done { return total }
}
