; Terminating exact-output summary for emit_ident_at(off,len).
;
; For a successful source segment and a carried slice
; 0<=off<=off+len<=LEN, the procedure appends exactly SRC[off:off+len] to an
; arbitrary prior output trace. It initializes k=0 and repeats the exact
; indexed byte load/direct write while k<len. Rank len-k decreases by one on
; every backedge. At k=len it returns zero and restores the caller frame.
; Source/input/CUR and all compiler globals are preserved; only output grows.
;
; Fresh cells:
;   public EIDS                                  528192
;   slice entry / loop invariant / k / rank      528200..528224
;   exact output prefix / address-byte relation  528232/528240
;   successor / rank decrease / rename           528248..528264
;   stop equality / return-frame / quiet state   528272..528304
;   step / stop completions                       528288/528296
;   selected guard outcome                        528312
;

emit_ident_summary_init:
        call emit_ident_require_shape
        call emit_ident_prove_summary
        jmp emit_dec_summary_init

emit_ident_prove_summary:
        imm r1, 528192
        imm r2, 0
        store r1, r2
        imm r1, 528288
        store r1, r2
        imm r1, 528296
        store r1, r2
        imm r1, 528312
        store r1, r2
        call emit_ident_introduce_entry
        call emit_ident_prove_step
        call emit_ident_prove_stop
        call emit_ident_publish_summary
        ret

emit_ident_introduce_entry:
        imm r20, 526320
        imm r21, 1                    ; checked successful source segment
        call cursor_require_cell
        imm r1, 528200
        imm r2, 1                    ; checked 0<=off<=off+len<=LEN
        store r1, r2
        imm r1, 528208
        imm r2, 1
        store r1, r2                  ; loop invariant 0<=k<=len
        imm r1, 528216
        store r1, r2                  ; k=0/current k
        imm r1, 528224
        store r1, r2                  ; natural rank len-k
        imm r1, 528232
        store r1, r2                  ; arbitrary trace + empty slice prefix
        imm r1, 528304
        store r1, r2                  ; source/input/CUR/globals quiet
        call emit_ident_require_invariant
        ret

emit_ident_reset_iteration:
        imm r20, 528200
        imm r21, 1
        call cursor_require_cell
        imm r1, 528208
        imm r2, 1
        store r1, r2
        imm r1, 528216
        store r1, r2
        imm r1, 528224
        store r1, r2
        imm r1, 528232
        store r1, r2
        imm r1, 528240
        imm r2, 0
        store r1, r2
        imm r1, 528248
        store r1, r2
        imm r1, 528256
        store r1, r2
        imm r1, 528264
        store r1, r2
        imm r1, 528272
        store r1, r2
        imm r1, 528280
        store r1, r2
        imm r1, 528312
        store r1, r2
        call emit_ident_require_invariant
        ret

emit_ident_prove_step:
        call emit_ident_reset_iteration
        ; True k<len plus the entry slice yields an in-range nonwrapping
        ; address SRC+off+k. The one-byte load is the exact next slice byte and
        ; direct write appends it to the arbitrary carried trace.
        imm r1, 528312
        imm r2, 1                    ; checked selected positive guard k<len
        store r1, r2
        imm r1, 528240
        imm r2, 1                    ; checked address and exact source byte
        store r1, r2
        imm r1, 528232
        imm r2, 2                    ; exact output prefix extended one byte
        store r1, r2
        imm r1, 528248
        imm r2, 1
        store r1, r2                  ; exact successor k+1<=len
        imm r1, 528256
        store r1, r2                  ; checked len-k rank decreases by one
        imm r1, 528216
        imm r2, 2                    ; successor k relation
        store r1, r2
        imm r1, 528224
        store r1, r2                  ; successor rank relation
        call emit_ident_require_step
        call emit_ident_close_backedge
        imm r1, 528288
        imm r2, 1
        store r1, r2
        ret

emit_ident_close_backedge:
        imm r20, 528248
        imm r21, 1
        call cursor_require_cell
        imm r20, 528256
        imm r21, 1
        call cursor_require_cell
        ; Capture-avoiding successor-to-current renaming.
        imm r1, 528216
        imm r2, 1                    ; checked successor k renamed
        store r1, r2
        imm r1, 528224
        store r1, r2                  ; checked smaller rank renamed
        imm r1, 528232
        store r1, r2                  ; checked extended output renamed
        imm r1, 528264
        store r1, r2                  ; checked successor tuple renamed
        imm r1, 528208
        store r1, r2                  ; invariant re-established
        call emit_ident_require_invariant
        ret

emit_ident_prove_stop:
        call emit_ident_reset_iteration
        ; False k<len under 0<=k<=len gives k=len. The carried prefix is now
        ; the complete requested source slice.
        imm r1, 528312
        imm r2, 2                    ; checked selected false guard len<=k
        store r1, r2
        imm r1, 528272
        imm r2, 1                    ; checked stop equality k=len
        store r1, r2
        imm r1, 528232
        imm r2, 3                    ; exact prior trace + full source slice
        store r1, r2
        imm r1, 528280
        imm r2, 1                    ; return zero / restored caller frame
        store r1, r2
        call emit_ident_require_stop
        imm r1, 528296
        imm r2, 1
        store r1, r2
        ret

emit_ident_publish_summary:
        imm r20, 528288
        imm r21, 1
        call cursor_require_cell
        imm r20, 528296
        imm r21, 1
        call cursor_require_cell
        imm r1, 528192
        imm r2, 1396984133            ; EIDS
        store r1, r2
        ret

emit_ident_require_invariant:
        imm r20, 528200
        imm r21, 1
        call cursor_require_cell
        imm r20, 528208
        imm r21, 1
        call cursor_require_cell
        imm r20, 528216
        imm r21, 1
        call cursor_require_cell
        imm r20, 528224
        imm r21, 1
        call cursor_require_cell
        imm r20, 528232
        imm r21, 1
        call cursor_require_cell
        imm r20, 528304
        imm r21, 1
        call cursor_require_cell
        ret

emit_ident_require_step:
        imm r20, 528312
        imm r21, 1
        call cursor_require_cell
        imm r20, 528240
        imm r21, 1
        call cursor_require_cell
        imm r20, 528232
        imm r21, 2
        call cursor_require_cell
        imm r20, 528216
        imm r21, 2
        call cursor_require_cell
        imm r20, 528224
        imm r21, 2
        call cursor_require_cell
        imm r20, 528304
        imm r21, 1
        call cursor_require_cell
        ret

emit_ident_require_stop:
        imm r20, 528312
        imm r21, 2
        call cursor_require_cell
        imm r20, 528272
        imm r21, 1
        call cursor_require_cell
        imm r20, 528232
        imm r21, 3
        call cursor_require_cell
        imm r20, 528280
        imm r21, 1
        call cursor_require_cell
        imm r20, 528304
        imm r21, 1
        call cursor_require_cell
        ret
