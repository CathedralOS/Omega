; Independently count every fixed store to the four protected globals.  The
; earlier address-class phase proves that fixed-address cells are meaningful
; and that all 95 memory rows are classified exactly once.
counter_count_protected_writers:
        imm r10, 0                     ; memory row
        imm r11, 0                     ; NLOC
        imm r12, 0                     ; EXPRDEPTH
        imm r13, 0                     ; BLOCKDEPTH
        imm r14, 0                     ; RESOURCE
counter_writer_loop:
        imm r1, 95
        jlt r10, r1, counter_writer_row
        jmp counter_writer_counts
counter_writer_row:
        mov r15, r10
        imm r1, 8
        mul r15, r1
        imm r1, 7610368
        add r1, r15
        load r2, r1
        imm r3, 2
        jeq r2, r3, counter_writer_class
        jmp counter_writer_next
counter_writer_class:
        imm r1, 10616832
        add r1, r15
        load r2, r1
        imm r3, 1
        jeq r2, r3, counter_writer_address
        jmp counter_writer_next
counter_writer_address:
        imm r1, 10618880
        add r1, r15
        load r2, r1
        imm r3, 2097128
        jeq r2, r3, counter_writer_nloc
        imm r3, 2097080
        jeq r2, r3, counter_writer_expr
        imm r3, 2097064
        jeq r2, r3, counter_writer_block
        imm r3, 2097072
        jeq r2, r3, counter_writer_resource
        jmp counter_writer_next
counter_writer_nloc:
        imm r1, 1
        add r11, r1
        jmp counter_writer_next
counter_writer_expr:
        imm r1, 1
        add r12, r1
        jmp counter_writer_next
counter_writer_block:
        imm r1, 1
        add r13, r1
        jmp counter_writer_next
counter_writer_resource:
        imm r1, 1
        add r14, r1
counter_writer_next:
        imm r1, 1
        add r10, r1
        jmp counter_writer_loop
counter_writer_counts:
        imm r1, 3
        jeq r11, r1, counter_writer_expr_count
        jmp reject
counter_writer_expr_count:
        imm r1, 4
        jeq r12, r1, counter_writer_block_count
        jmp reject
counter_writer_block_count:
        imm r1, 5
        jeq r13, r1, counter_writer_resource_count
        jmp reject
counter_writer_resource_count:
        imm r1, 7
        jeq r14, r1, counter_writer_counts_ok
        jmp reject
counter_writer_counts_ok:
        ret

; Executable interval algebra for the selected machine expressions.  Registers
; r20/r21 are an inclusive nonnegative interval.  All exact machine operators
; and constants used below were rejoined above.
counter_check_value_domain:
        ; Both reset chains write exactly zero.
        imm r20, 0
        imm r21, 0
        call counter_require_zero
        call counter_require_zero

        ; Actual NLOC is closed by the two zero roots and declare's checked
        ; snapshot/guard/s+1 chain in bc-ranged-store-transfer.alpha.
        imm r20, 0
        imm r21, 1023
        call counter_add_one
        imm r22, 1
        imm r23, 1024
        call counter_require_interval

counter_expr_guard_refine:
        ; ED is [0,64] at entry; the exact signed ED<64 true edge is [0,63].
        imm r20, 0
        imm r21, 63
        call counter_add_one
        imm r22, 1
        imm r23, 64
        call counter_require_interval
        call counter_sub_one
        imm r22, 0
        imm r23, 63
        call counter_require_interval
        ; The rejected depth-65 probe snapshots 64 and does not write ED.
        imm r20, 64
        imm r21, 64
        imm r22, 64
        imm r23, 64
        call counter_require_interval

counter_block_guard_refine:
        ; BD uses the same admitted range and all three exact exits subtract one.
        imm r20, 0
        imm r21, 63
        call counter_add_one
        imm r22, 1
        imm r23, 64
        call counter_require_interval
counter_block_exit_step:
        imm r1, 1
        sub r20, r1
        sub r21, r1
        imm r22, 0
        imm r23, 63
        call counter_require_interval
        ; Recheck the other two exit chains against the same selected rule.
        imm r20, 1
        imm r21, 64
        call counter_sub_one
        imm r22, 0
        imm r23, 63
        call counter_require_interval
        imm r20, 1
        imm r21, 64
        call counter_sub_one
        imm r22, 0
        imm r23, 63
        call counter_require_interval

        ; Exhaustive RESOURCE writers are the zero root or literal 252.
        imm r20, 0
        imm r21, 0
        call counter_require_resource_value
        imm r20, 252
        imm r21, 252
        call counter_require_resource_value
        ret

counter_add_one:
        imm r1, 1
        add r20, r1
        add r21, r1
        ret
counter_sub_one:
        imm r1, 1
        sub r20, r1
        sub r21, r1
        ret

counter_require_zero:
        imm r22, 0
        imm r23, 0
        jmp counter_require_interval

counter_require_resource_value:
        imm r1, 0
        jeq r20, r1, counter_resource_zero
        imm r1, 252
        jeq r20, r1, counter_resource_252
        jmp reject
counter_resource_zero:
        imm r1, 0
        jeq r21, r1, counter_resource_ok
        jmp reject
counter_resource_252:
        imm r1, 252
        jeq r21, r1, counter_resource_ok
        jmp reject
counter_resource_ok:
        ret

counter_require_interval:
        jeq r20, r22, counter_interval_hi
        jmp reject
counter_interval_hi:
        jeq r21, r23, counter_interval_ok
        jmp reject
counter_interval_ok:
        ret

; ---------------------------------------------------------------------------
; Exact bridge between machine counter depth and the 64 BCS9 phase rows.
;
; BCS9 phase tables are depth-major with 70 procedure cells per row.  Earlier
; call-bounds code has already validated every potential equation and the rule
; which sends a recursive child from row remaining to row remaining-1.  Here we
; independently give that index its selected machine meaning:
;
;   row remaining: D = 64 - remaining
;   remaining > 0 child: (remaining-1, D+1)
;   remaining = 0 child: checked rejected probe at snapshot D=64
;   root: D=0, accepted +1, select row remaining=63 (D=1)

counter_check_context_bridge:
        imm r10, 0
counter_context_build_loop:
        imm r1, 64
        jlt r10, r1, counter_context_build_row
        jmp counter_context_root
counter_context_build_row:
        mov r20, r10                   ; remaining
        imm r21, 64
        sub r21, r10                   ; live D
        mov r12, r10
        imm r1, 16
        mul r12, r1
        imm r1, 16662528
        add r1, r12
        store r1, r20
        imm r2, 8
        add r1, r2
        store r1, r21

        ; Touch the exact already-validated BCS9 cutpoint cells in this row.
        ; gen_expr is proc61 and gen_stmts is proc62.
        mov r12, r10
        imm r1, 70
        mul r12, r1
        imm r1, 61
        add r12, r1
        imm r1, 8
        mul r12, r1
        imm r1, 10051584
        add r1, r12
        load r6, r1                    ; expr explicit potential
        imm r1, 10087424
        add r1, r12
        load r7, r1                    ; expr hidden potential
        imm r1, 23
        jlt r1, r6, counter_context_expr_hidden
        jmp reject
counter_context_expr_hidden:
        imm r1, 0
        jlt r1, r7, counter_context_block_cell
        jmp reject
counter_context_block_cell:
        ; Move from proc61 to adjacent proc62 in the same row.
        imm r1, 8
        add r12, r1
        imm r1, 10123264
        add r1, r12
        load r8, r1                    ; block explicit potential
        imm r1, 10159104
        add r1, r12
        load r9, r1                    ; block hidden potential
        imm r1, 15
        jlt r1, r8, counter_context_block_hidden
        jmp reject
counter_context_block_hidden:
        imm r1, 0
        jlt r1, r9, counter_context_child_kind
        jmp reject

counter_context_child_kind:
        imm r1, 0
        jeq r10, r1, counter_context_probe
        ; The child row is already present because rows are built ascending.
        mov r22, r10
        imm r1, 1
        sub r22, r1                    ; child remaining
        mov r23, r21
        add r23, r1                    ; child D
        mov r12, r22
        imm r1, 16
        mul r12, r1
        imm r1, 16662528
        add r1, r12
        load r2, r1
        jeq r2, r22, counter_context_child_depth
        jmp reject
counter_context_child_depth:
        imm r2, 8
        add r1, r2
        load r2, r1
        jeq r2, r23, counter_context_child_formula
        jmp reject
counter_context_child_formula:
        imm r2, 64
        sub r2, r22
        jeq r2, r23, counter_context_next
        jmp reject

counter_context_probe:
        ; Row zero is the admitted activation at D=64.  A recursive child now
        ; selects the separately charged rejected probe, whose checked proc ids
        ; are retained by bc-call-bounds.alpha.
        imm r1, 64
        jeq r21, r1, counter_context_expr_probe_proc
        jmp reject
counter_context_expr_probe_proc:
        imm r1, 524960
        load r2, r1
        imm r3, 61
        jeq r2, r3, counter_context_block_probe_proc
        jmp reject
counter_context_block_probe_proc:
        imm r1, 524968
        load r2, r1
        imm r3, 62
        jeq r2, r3, counter_context_next
        jmp reject

counter_context_next:
        imm r1, 1
        add r10, r1
        jmp counter_context_build_loop

counter_context_root:
        ; Machine root starts at zero.  Its accepted +1 selects BCS9 row63,
        ; which the bridge must identify with live depth one for both counters.
        imm r20, 0
        imm r21, 0
        call counter_add_one
        imm r1, 1
        jeq r20, r1, counter_context_root_hi
        jmp reject
counter_context_root_hi:
        jeq r21, r1, counter_context_root_row
        jmp reject
counter_context_root_row:
        imm r12, 63
        imm r1, 16
        mul r12, r1
        imm r1, 16662528
        add r1, r12
        load r2, r1
        imm r3, 63
        jeq r2, r3, counter_context_root_depth
        jmp reject
counter_context_root_depth:
        imm r3, 8
        add r1, r3
        load r2, r1
        imm r3, 1
        jeq r2, r3, counter_context_done
        jmp reject
counter_context_done:
        ret
