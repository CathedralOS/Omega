; Selected machine-value premises for bc's bounded recursion counters.
;
; The preceding phases already parse the exact source, own every local/raw-
; memory/primitive/push macro, compose each expression in lowering order, prove
; the source-side counter schemas, and transfer the three ranged store operands.
; This phase has no producer witness.  It rejoins the exact machine rows for:
;
;   EXPRDEPTH  2097080: zero root, snapshot, <64 guard, +1, two -1 exits
;   BLOCKDEPTH 2097064: zero root, snapshot, <64 guard, +1, three -1 exits
;   RESOURCE   2097072: zero root and all six writes of 252
;
; It then executes the small interval algebra used by those selected chains and
; exhaustively recounts all fixed writers to NLOC, EXPRDEPTH, BLOCKDEPTH, and
; RESOURCE.  A fresh 64-row bridge binds BCS9's `remaining` phase index to the
; live machine depth D=64-remaining, including recursive-child, rejected-probe,
; and root-entry selections.  This closes a value-transfer premise only.  It
; does not establish reachability, carry saved frames through arbitrary calls,
; or make BCT9's root stack potential unconditional.
;
; Context bridge rows [remaining,live-depth], 16 bytes each: 16662528.

counter_transfer_init:
        call counter_require_selected_rows
        call counter_count_protected_writers
        call counter_check_value_domain
        call counter_check_context_bridge
        jmp stack_potential_lift_init

; Compact wrappers around the responsibility-specific row joiners supplied by
; bc-ranged-store-transfer.alpha.  Callers provide row/block/value/pc.
counter_require_local_load:
        imm r22, 1
        jmp counter_require_local_common
counter_require_local_store:
        imm r22, 2
counter_require_local_common:
        ; r20 row, r21 block, r22 kind, r23 slot, r24 pc
        call transfer_require_local
        ret

counter_require_memory_load:
        imm r22, 1
        jmp counter_require_memory_common
counter_require_memory_store:
        imm r22, 2
counter_require_memory_common:
        imm r23, 8
        ; r20 row, r21 block, r22 kind, r23 width, r24 pc
        call transfer_require_memory
        ret

counter_require_literal:
        imm r22, 1
        ; r20 row, r21 block, r22 literal kind, r23 value, r24 pc
        call transfer_require_primitive
        ret
counter_require_arithmetic:
        imm r22, 2
        ; r23 is the Alpha arithmetic opcode selected by the source.
        call transfer_require_primitive
        ret
counter_require_comparison:
        imm r22, 3
        ; r23 is the normalized comparison code selected by the source.
        call transfer_require_primitive
        ret

counter_require_binary_push:
        imm r22, 1
        ; r20 row, r21 block, r22 kind, r23 pc
        call transfer_require_push
        ret
counter_require_store_push:
        imm r22, 3
        call transfer_require_push
        ret

counter_require_selected_rows:
        ; slurp zero roots: EXPRDEPTH and BLOCKDEPTH.
        imm r20, 5
        imm r21, 4
        imm r24, 968
        call counter_require_memory_store
        imm r20, 17
        imm r21, 4
        imm r23, 2097080
        imm r24, 916
        call counter_require_literal
        imm r20, 18
