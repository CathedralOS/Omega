        imm r20, 394
        imm r21, 311
        imm r23, 44717
        call counter_require_store_push

        imm r20, 70
        imm r21, 313
        imm r24, 45086
        call counter_require_memory_store
        imm r20, 71
        imm r21, 313
        imm r24, 45019
        call counter_require_memory_load
        imm r20, 715
