; Conditional whole-artifact explicit-frame summary for exact bc.
;
; Earlier phases have already validated every constituent macro and built the
; decoded instruction-start map.  This phase first rejoins those facts into an
; exhaustive store-family map:
;
;   70 saved-fp stores, 403 expression pushes, 73 local stores,
;   34 raw stores, and 27 parameter stores = all 607 artifact stores.
;
; It then computes a call-cut decoded-CFG fixed point for each of the 70 source
; procedures.  Relative to symbolic aligned entry r15=S/r14=F, the state is
; exact relative depth, current/caller fp kind, and a preserved saved-fp token.
; Calls are checked source event sites and are treated as conditional identity
; summaries.  Thus this phase proves each procedure restores its entry pair if
; every reached callee does; it does not prove that recursion is bounded or that
; the root establishes an absolute B_bc1 address.  The later potential lift must
; discharge those assumptions.
;
; Maps indexed by tape PC:
;   store family 13516800, visited 13778944, depth 14041088,
;   fp kind 16138240, saved-fp token 16400384.

frame_summary_init:
        call fs_store_union_init
        jmp fs_proc_scan_init

; ---------------------------------------------------------------------------
; Exhaustive store-family union.

fs_store_union_init:
        imm r0, 0
        imm r1, 525360
        store r1, r0                    ; total owners
        imm r1, 525368
        store r1, r0                    ; saved fp
        imm r1, 525376
        store r1, r0                    ; pushes
        imm r1, 525384
        store r1, r0                    ; locals
        imm r1, 525392
        store r1, r0                    ; raw stores
        imm r1, 525400
        store r1, r0                    ; parameters
        imm r1, 525408
        store r1, r0                    ; decoded stores
        imm r10, 0
fs_store_clear_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, fs_store_clear_byte
        jmp fs_store_clear_done
fs_store_clear_byte:
        imm r1, 13516800
        add r1, r10
        storeb r1, r0
        imm r1, 1
        add r10, r1
        jmp fs_store_clear_loop
fs_store_clear_done:
        imm r10, 0
fs_store_saved_loop:
        imm r1, 359
        jlt r10, r1, fs_store_saved_block
        jmp fs_store_push_init
fs_store_saved_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, fs_store_saved_entry
        jmp fs_store_saved_next
fs_store_saved_entry:
        imm r1, 3235840
        add r1, r12
        load r20, r1
        imm r1, 13
        add r20, r1
        imm r21, 1
        call fs_store_mark
fs_store_saved_next:
        imm r1, 1
        add r10, r1
        jmp fs_store_saved_loop

fs_store_push_init:
        imm r10, 0
fs_store_push_loop:
        imm r1, 407
        jlt r10, r1, fs_store_push_row
        jmp fs_store_local_init
fs_store_push_row:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 9453568
        add r1, r12
        load r20, r1
        imm r1, 13
        add r20, r1
        imm r21, 2
        call fs_store_mark
        imm r1, 1
        add r10, r1
        jmp fs_store_push_loop

fs_store_local_init:
        imm r10, 0
fs_store_local_loop:
        imm r1, 244
        jlt r10, r1, fs_store_local_row
        jmp fs_store_raw_init
fs_store_local_row:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7176192
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, fs_store_local_mark
        jmp fs_store_local_next
fs_store_local_mark:
        imm r1, 7192576
        add r1, r12
        load r20, r1
        imm r1, 16
        add r20, r1
        imm r21, 3
        call fs_store_mark
fs_store_local_next:
        imm r1, 1
        add r10, r1
        jmp fs_store_local_loop

fs_store_raw_init:
        imm r10, 0
fs_store_raw_loop:
        imm r1, 101
        jlt r10, r1, fs_store_raw_row
        jmp fs_store_param_init
fs_store_raw_row:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7610368
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, fs_store_raw_mark
        jmp fs_store_raw_next
fs_store_raw_mark:
        imm r1, 7626752
        add r1, r12
        load r20, r1
        imm r21, 4
        call fs_store_mark
fs_store_raw_next:
        imm r1, 1
        add r10, r1
        jmp fs_store_raw_loop

; Derive the parameter-store cursor from the exact checked prologue layout.
fs_store_param_init:
        imm r10, 0
fs_store_param_block_loop:
        imm r1, 359
        jlt r10, r1, fs_store_param_block
        jmp fs_store_counts
fs_store_param_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, fs_store_param_entry
        jmp fs_store_param_next_block
fs_store_param_entry:
        imm r1, 3145728
        add r1, r12
        load r13, r1                    ; source proc
        mov r2, r13
        imm r1, 8
        mul r2, r1
        imm r1, 7151616
        add r1, r2
        load r11, r1                   ; parameter count
        imm r1, 7159808
        add r1, r2
        load r9, r1                    ; total slots
        imm r1, 3235840
        add r1, r12
        load r6, r1                    ; entry pc
        imm r1, 19
        add r6, r1
        imm r1, 0
        jeq r9, r1, fs_store_param_cursor_ready
        imm r1, 13
        add r6, r1
fs_store_param_cursor_ready:
        imm r7, 0
fs_store_param_loop:
        jlt r7, r11, fs_store_param_mark
        jmp fs_store_param_next_block
fs_store_param_mark:
        mov r20, r6
        imm r1, 16
        add r20, r1
        imm r21, 5
        call fs_store_mark
        imm r1, 19
        add r6, r1
        imm r1, 1
        add r7, r1
        jmp fs_store_param_loop
fs_store_param_next_block:
        imm r1, 1
        add r10, r1
        jmp fs_store_param_block_loop

; Mark pc r20 with family r21 exactly once and count its family.
fs_store_mark:
        imm r1, 524296
        load r2, r1
        jlt r20, r2, fs_store_mark_covered
        jmp reject
fs_store_mark_covered:
        imm r1, 4194304
        add r1, r20
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, fs_store_mark_opcode
        jmp reject
fs_store_mark_opcode:
        imm r1, 2097152
        add r1, r20
        loadb r2, r1
        imm r3, 9
        jeq r2, r3, fs_store_mark_unique
        imm r3, 11
        jeq r2, r3, fs_store_mark_unique
        jmp reject
fs_store_mark_unique:
        imm r1, 13516800
        add r1, r20
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, fs_store_mark_now
        jmp reject
fs_store_mark_now:
        storeb r1, r21
        imm r1, 525360
        call fs_increment
        imm r1, 1
        jeq r21, r1, fs_store_count_saved
        imm r1, 2
        jeq r21, r1, fs_store_count_push
        imm r1, 3
        jeq r21, r1, fs_store_count_local
        imm r1, 4
        jeq r21, r1, fs_store_count_raw
        imm r1, 5
        jeq r21, r1, fs_store_count_param
        jmp reject
fs_store_count_saved:
        imm r1, 525368
        call fs_increment
        ret
fs_store_count_push:
        imm r1, 525376
        call fs_increment
        ret
fs_store_count_local:
        imm r1, 525384
        call fs_increment
        ret
fs_store_count_raw:
        imm r1, 525392
        call fs_increment
        ret
fs_store_count_param:
        imm r1, 525400
        call fs_increment
        ret

; Used only by the focused gate's omitted-owner diagnostic.
fs_store_skip_mark:
        ret

; Diagnostic helper: omit exactly the first source procedure's saved-fp store.
fs_store_skip_first_saved:
        imm r1, 96
        jeq r20, r1, fs_store_skip_mark
        jmp fs_store_mark

fs_increment:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

fs_store_counts:
        imm r1, 525360
        load r2, r1
        imm r3, 615
        jeq r2, r3, fs_store_saved_count
        jmp reject
fs_store_saved_count:
        imm r1, 525368
        load r2, r1
        imm r3, 71
        jeq r2, r3, fs_store_push_count
        jmp reject
fs_store_push_count:
        imm r1, 525376
        load r2, r1
        imm r3, 407
        jeq r2, r3, fs_store_local_count
        jmp reject
fs_store_local_count:
        imm r1, 525384
        load r2, r1
        imm r3, 74
        jeq r2, r3, fs_store_raw_count
        jmp reject
fs_store_raw_count:
        imm r1, 525392
        load r2, r1
        imm r3, 36
        jeq r2, r3, fs_store_param_count
        jmp reject
fs_store_param_count:
        imm r1, 525400
        load r2, r1
        imm r3, 27
        jeq r2, r3, fs_store_scan_init
        jmp reject

; Independently require the map to equal exactly all decoded store starts.
fs_store_scan_init:
        imm r10, 0
fs_store_scan_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, fs_store_scan_pc
        imm r1, 525408
        load r2, r1
        imm r3, 615
        jeq r2, r3, fs_store_union_done
        jmp reject
fs_store_scan_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, fs_store_scan_start
        jmp fs_store_scan_next
fs_store_scan_start:
        imm r1, 2097152
        add r1, r10
        loadb r2, r1
        imm r3, 9
        jeq r2, r3, fs_store_scan_require_owner
        imm r3, 11
        jeq r2, r3, fs_store_scan_require_owner
        imm r1, 13516800
        add r1, r10
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, fs_store_scan_next
        jmp reject
fs_store_scan_require_owner:
        imm r1, 13516800
        add r1, r10
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, reject
        imm r1, 525408
        call fs_increment
fs_store_scan_next:
        imm r1, 1
        add r10, r1
        jmp fs_store_scan_loop
fs_store_union_done:
        ret

; ---------------------------------------------------------------------------
; Per-procedure call-cut frame summaries.

fs_proc_scan_init:
        imm r10, 0
fs_proc_scan_loop:
        imm r1, 359
        jlt r10, r1, fs_proc_scan_block
        jmp fs_proc_done
fs_proc_scan_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, fs_proc_prepare
        jmp fs_proc_skip_block
fs_proc_prepare:
        imm r1, 525416
        store r1, r10                   ; preserve outer block index
        imm r1, 3145728
        add r1, r12
        load r13, r1                    ; source proc
        imm r1, 525296
        store r1, r13
        imm r1, 3235840
        add r1, r12
        load r20, r1                    ; region start
        imm r1, 525304
        store r1, r20
        mov r11, r10
        imm r1, 1
        add r11, r1
fs_proc_find_end:
        imm r1, 359
        jlt r11, r1, fs_proc_find_end_block
        imm r1, 524296
        load r21, r1
        jmp fs_proc_end_ready
fs_proc_find_end_block:
        mov r12, r11
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, fs_proc_end_entry
        imm r1, 1
        add r11, r1
        jmp fs_proc_find_end
fs_proc_end_entry:
        imm r1, 3235840
        add r1, r12
        load r21, r1
fs_proc_end_ready:
        imm r1, 525312
        store r1, r21

        mov r2, r13
        imm r1, 8
        mul r2, r1
        imm r1, 7159808
        add r1, r2
        load r3, r1                    ; slots
        imm r1, 1
        add r3, r1
        imm r1, 8
        mul r3, r1
        imm r1, 525328
        store r1, r3                   ; frame bytes
        imm r1, 10043392
        add r1, r2
        load r4, r1                    ; checked relative peak words
fs_proc_expected_peak:
        imm r1, 8
        mul r4, r1
        add r4, r3
        imm r1, 525336
        store r1, r4                   ; exact local high-water bytes
        imm r0, 0
        imm r1, 525344
        store r1, r0                   ; observed max
        imm r1, 525352
        store r1, r0                   ; reachable ret count

        imm r21, 0                     ; depth S-r15
        imm r22, 0                     ; caller F
        imm r23, 0                     ; no saved token
        call fs_state_add
        call fs_fixedpoint
        imm r1, 525352
        load r2, r1
        imm r3, 0
        jlt r3, r2, fs_proc_peak_check
        jmp reject
fs_proc_peak_check:
        imm r1, 525344
        load r2, r1
        imm r1, 525336
        load r3, r1
        jeq r2, r3, fs_proc_next_entry
        jmp reject
fs_proc_next_entry:
        imm r1, 525416
        load r10, r1
fs_proc_skip_block:
        imm r1, 1
        add r10, r1
        jmp fs_proc_scan_loop
fs_proc_done:
        jmp ranged_transfer_init

fs_fixedpoint:
fs_fixedpoint_again:
        imm r0, 0
        imm r1, 525320
        store r1, r0
        imm r1, 525304
        load r10, r1
fs_scan_loop:
        imm r1, 525312
        load r2, r1
        jlt r10, r2, fs_scan_pc
        imm r1, 525320
        load r2, r1
        imm r3, 1
        jeq r2, r3, fs_fixedpoint_again
        ret
fs_scan_pc:
        mov r27, r10
        imm r1, 13778944
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, fs_interpret
fs_scan_next:
        mov r10, r27
        imm r1, 1
        add r10, r1
        jmp fs_scan_loop

fs_interpret:
        mov r12, r27
        imm r1, 8
        mul r12, r1
        imm r1, 14041088
        add r1, r12
        load r24, r1                   ; depth
        imm r1, 16138240
        add r1, r27
        loadb r25, r1                  ; fp kind
        imm r1, 16400384
        add r1, r27
        loadb r26, r1                  ; saved token
        call fs_observe_depth
        imm r1, 2097152
        add r1, r27
        loadb r28, r1
        imm r1, 21
        jlt r28, r1, fs_opcode
        jmp reject
fs_opcode:
        imm r1, 0
        jeq r28, r1, reject
        imm r1, 1
        jeq r28, r1, fs_imm
        imm r1, 2
        jeq r28, r1, fs_mov
        imm r1, 3
        jeq r28, r1, fs_add
        imm r1, 4
        jeq r28, r1, fs_sub
        imm r1, 8
        jlt r28, r1, fs_rr
        imm r1, 8
        jeq r28, r1, fs_loadb
        imm r1, 9
        jeq r28, r1, fs_store
        imm r1, 10
        jeq r28, r1, fs_load
        imm r1, 11
        jeq r28, r1, fs_store
        imm r1, 12
        jeq r28, r1, fs_jmp
        imm r1, 15
        jlt r28, r1, fs_cond10
        imm r1, 17
        jlt r28, r1, fs_cond11
        imm r1, 17
        jeq r28, r1, fs_read
        imm r1, 18
        jeq r28, r1, fs_next2
        imm r1, 19
        jeq r28, r1, fs_call
        jmp fs_ret

fs_imm:
        call fs_load_dest
        imm r1, 14
        jeq r0, r1, reject
        imm r1, 15
        jeq r0, r1, reject
        jmp fs_next10
fs_read:
        call fs_load_dest
        imm r1, 14
        jeq r0, r1, reject
        imm r1, 15
        jeq r0, r1, reject
        jmp fs_next2
fs_rr:
        call fs_load_dest
        imm r1, 14
        jeq r0, r1, reject
        imm r1, 15
        jeq r0, r1, reject
        jmp fs_next3

fs_mov:
        call fs_load_operands
        imm r1, 14
        jeq r0, r1, fs_set_fp
        imm r1, 15
        jeq r0, r1, fs_set_sp_from_fp
        jmp fs_next3
fs_set_fp:
        imm r1, 15
        jeq r2, r1, fs_set_fp_depth
        jmp reject
fs_set_fp_depth:
        imm r1, 8
        jeq r24, r1, fs_set_fp_saved
        jmp reject
fs_set_fp_saved:
        imm r1, 1
        jeq r26, r1, fs_set_fp_now
        jmp reject
fs_set_fp_now:
        imm r25, 1
        jmp fs_next3
fs_set_sp_from_fp:
        imm r1, 14
        jeq r2, r1, fs_set_sp_kind
        jmp reject
fs_set_sp_kind:
        imm r1, 1
        jeq r25, r1, fs_set_sp_now
        jmp reject
fs_set_sp_now:
        imm r24, 8
        jmp fs_next3

fs_add:
        call fs_load_operands
        imm r1, 14
        jeq r0, r1, reject
        imm r1, 15
        jeq r0, r1, fs_pop
        jmp fs_next3
fs_pop:
        mov r20, r27
        mov r21, r2
        call fs_require_setup
        mov r3, r0
        jlt r24, r3, reject
        sub r24, r3
        jmp fs_next3

fs_sub:
        call fs_load_operands
        imm r1, 14
        jeq r0, r1, reject
        imm r1, 15
        jeq r0, r1, fs_push
        jmp fs_next3
fs_push:
        mov r20, r27
        mov r21, r2
        call fs_require_setup
        add r24, r0
        imm r1, 525336
        load r2, r1
        jlt r2, r24, reject
        jmp fs_next3

fs_loadb:
        call fs_load_operands
        imm r1, 14
        jeq r0, r1, reject
        imm r1, 15
        jeq r0, r1, reject
        imm r1, 15
        jeq r2, r1, fs_stack_data_access
        jmp fs_next3
fs_load:
        call fs_load_operands
        imm r1, 14
        jeq r0, r1, fs_restore_fp
        imm r1, 15
        jeq r0, r1, reject
        imm r1, 15
        jeq r2, r1, fs_stack_data_access
        jmp fs_next3
fs_restore_fp:
        imm r1, 15
        jeq r2, r1, fs_restore_depth
        jmp reject
fs_restore_depth:
        imm r1, 8
        jeq r24, r1, fs_restore_saved
        jmp reject
fs_restore_saved:
        imm r1, 1
        jeq r26, r1, fs_restore_now
        jmp reject
fs_restore_now:
        imm r25, 0
        jmp fs_next3
fs_stack_data_access:
        imm r1, 16
        jlt r24, r1, reject
        jmp fs_next3

fs_store:
        call fs_load_operands
        imm r1, 13516800
        add r1, r27
        loadb r3, r1                   ; exhaustive family
        imm r1, 1
        jeq r3, r1, fs_save_fp
        imm r1, 2
        jeq r3, r1, fs_store_push
        imm r1, 3
        jeq r3, r1, fs_store_frame
        imm r1, 4
        jeq r3, r1, fs_store_raw
        imm r1, 5
        jeq r3, r1, fs_store_frame
        jmp reject
fs_save_fp:
        imm r1, 11
        jeq r28, r1, fs_save_fp_address
        jmp reject
fs_save_fp_address:
        imm r1, 15
        jeq r0, r1, fs_save_fp_value
        jmp reject
fs_save_fp_value:
        imm r1, 14
        jeq r2, r1, fs_save_fp_state
        jmp reject
fs_save_fp_state:
        imm r1, 8
        jeq r24, r1, fs_save_fp_caller
        jmp reject
fs_save_fp_caller:
        imm r1, 0
        jeq r25, r1, fs_save_fp_absent
        jmp reject
fs_save_fp_absent:
        jeq r26, r1, fs_save_fp_now
        jmp reject
fs_save_fp_now:
        imm r26, 1
        jmp fs_next3
fs_store_push:
        imm r1, 11
        jeq r28, r1, fs_store_push_address
        jmp reject
fs_store_push_address:
        imm r1, 15
        jeq r0, r1, fs_store_push_depth
        jmp reject
fs_store_push_depth:
        imm r1, 16
        jlt r24, r1, reject
        jmp fs_next3
fs_store_frame:
        imm r1, 1
        jeq r25, r1, fs_next3
        jmp reject
fs_store_raw:
        jmp fs_next3

fs_call:
        imm r1, 1
        jeq r25, r1, fs_call_saved
        jmp reject
fs_call_saved:
        jeq r26, r1, fs_call_site_init
        jmp reject
fs_call_site_init:
        imm r11, 0
        imm r12, 0                     ; matches
fs_call_site_loop:
        imm r1, 617
        jlt r11, r1, fs_call_site_row
        imm r1, 1
        jeq r12, r1, fs_call_next
        jmp reject
fs_call_site_row:
        mov r4, r11
        imm r1, 8
        mul r4, r1
        imm r1, 7086080
        add r1, r4
        load r5, r1
        imm r1, 1
        jeq r5, r1, fs_call_site_kind
        imm r1, 4
        jeq r5, r1, fs_call_site_kind
        jmp fs_call_site_next
fs_call_site_kind:
        imm r1, 7135232
        add r1, r4
        load r5, r1
        jeq r5, r27, fs_call_site_proc
        jmp fs_call_site_next
fs_call_site_proc:
        imm r1, 7077888
        add r1, r4
        load r5, r1                    ; source block
        imm r1, 8
        mul r5, r1
        imm r1, 3145728
        add r1, r5
        load r5, r1                    ; source proc
        imm r1, 525296
        load r6, r1
        jeq r5, r6, fs_call_site_depth
        jmp reject
fs_call_site_depth:
        imm r1, 10035200
        add r1, r4
        load r5, r1                    ; ambient words
        imm r1, 8
        mul r5, r1
        imm r1, 525328
        load r6, r1
        add r5, r6
        jeq r24, r5, fs_call_site_match
        jmp reject
fs_call_site_match:
        imm r1, 1
        add r12, r1
fs_call_site_next:
        imm r1, 1
        add r11, r1
        jmp fs_call_site_loop
fs_call_next:
        imm r1, 9
        jmp fs_fallthrough

fs_jmp:
        mov r20, r27
        imm r1, 1
        add r20, r1
        call fs_load_tape_word
        mov r20, r0
        call fs_reject_stack_target
        mov r20, r0
        call fs_propagate
        jmp fs_scan_next
fs_cond10:
        mov r20, r27
        imm r1, 2
        add r20, r1
        call fs_load_tape_word
        mov r20, r0
        call fs_reject_stack_target
        mov r20, r0
        call fs_propagate
        mov r20, r27
        imm r1, 10
        add r20, r1
        call fs_propagate
        jmp fs_scan_next
fs_cond11:
        mov r20, r27
        imm r1, 3
        add r20, r1
        call fs_load_tape_word
        mov r20, r0
        call fs_reject_stack_target
        mov r20, r0
        call fs_propagate
        mov r20, r27
        imm r1, 11
        add r20, r1
        call fs_propagate
        jmp fs_scan_next

fs_ret:
        imm r1, 0
        jeq r24, r1, fs_ret_fp
        jmp reject
fs_ret_fp:
        jeq r25, r1, fs_ret_saved
        jmp reject
fs_ret_saved:
        imm r1, 1
        jeq r26, r1, fs_ret_count
        jmp reject
fs_ret_count:
        imm r1, 525352
        call fs_increment
        jmp fs_scan_next

fs_next2:
        imm r1, 2
        jmp fs_fallthrough
fs_next3:
        imm r1, 3
        jmp fs_fallthrough
fs_next10:
        imm r1, 10
fs_fallthrough:
        mov r20, r27
        add r20, r1
        call fs_propagate
        jmp fs_scan_next

fs_observe_depth:
        imm r1, 525344
        load r2, r1
        jlt r2, r24, fs_observe_update
        ret
fs_observe_update:
        store r1, r24
        ret

fs_load_dest:
        imm r1, 2097153
        add r1, r27
        loadb r0, r1
        ret
fs_load_operands:
        call fs_load_dest
        imm r1, 2097154
        add r1, r27
        loadb r2, r1
        ret

; Require immediately preceding imm r21,k, returning positive aligned k.
fs_require_setup:
        mov r4, r20
        imm r1, 10
        jlt r4, r1, reject
        sub r4, r1
        imm r1, 2097152
        add r1, r4
        loadb r3, r1
        imm r5, 1
        jeq r3, r5, fs_setup_reg
        jmp reject
fs_setup_reg:
        imm r3, 1
        add r1, r3
        loadb r5, r1
        jeq r5, r21, fs_setup_value
        jmp reject
fs_setup_value:
        add r1, r3
        load r0, r1
        imm r1, 0
        jlt r1, r0, fs_setup_aligned
        jmp reject
fs_setup_aligned:
        mov r3, r0
        imm r1, 8
        mod r3, r1
        imm r1, 0
        jeq r3, r1, fs_setup_ok
        jmp reject
fs_setup_ok:
        ret

fs_load_tape_word:
        imm r1, 2097152
        add r1, r20
        load r0, r1
        ret

; A direct branch may not enter the middle of a stack-effect macro.
fs_reject_stack_target:
        mov r6, r20
        imm r1, 10354688
        add r1, r6
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, fs_stack_target_ok
        jmp reject
fs_stack_target_ok:
        mov r0, r6
        ret

fs_propagate:
        mov r21, r24
        mov r22, r25
        mov r23, r26
        call fs_state_add
        ret

; Exact state join at decoded pc r20 inside the current procedure region.
fs_state_add:
        imm r1, 525304
        load r2, r1
        jlt r20, r2, reject
        imm r1, 525312
        load r2, r1
        jlt r20, r2, fs_state_decoded
        jmp reject
fs_state_decoded:
        imm r1, 4194304
        add r1, r20
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, fs_state_seen
        jmp reject
fs_state_seen:
        imm r1, 13778944
        add r1, r20
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, fs_state_new
        imm r3, 1
        jeq r2, r3, fs_state_merge
        jmp reject
fs_state_new:
        imm r2, 1
        storeb r1, r2
        mov r12, r20
        imm r1, 8
        mul r12, r1
        imm r1, 14041088
        add r1, r12
        store r1, r21
        imm r1, 16138240
        add r1, r20
        storeb r1, r22
        imm r1, 16400384
        add r1, r20
        storeb r1, r23
        imm r1, 525320
        store r1, r2
        ret
fs_state_merge:
        mov r12, r20
        imm r1, 8
        mul r12, r1
        imm r1, 14041088
        add r1, r12
        load r2, r1
        jeq r2, r21, fs_state_merge_fp
        jmp reject
fs_state_merge_fp:
        imm r1, 16138240
        add r1, r20
        loadb r2, r1
        jeq r2, r22, fs_state_merge_saved
        jmp reject
fs_state_merge_saved:
        imm r1, 16400384
        add r1, r20
        loadb r2, r1
        jeq r2, r23, fs_state_merge_ok
        jmp reject
fs_state_merge_ok:
        ret
