; Exact source/artifact shape for is_muldiv(c) and is_addsub(c), procedures
; 53..54.  This module owns only blocks/edges, returns, parameter loads,
; equality/literal primitives, binary pushes, frames, and decoded quiet regions.

operator_classifier_require_shape:
        imm r20, 53
        call operator_classifier_require_proc_frame
        imm r20, 54
        call operator_classifier_require_proc_frame

        imm r20, 234
        imm r21, 34977
        call exact_require_block_pc
        imm r20, 235
        imm r21, 35028
        call exact_require_block_pc
        imm r20, 236
        imm r21, 35160
        call exact_require_block_pc
        imm r20, 237
        imm r21, 35292
        call exact_require_block_pc
        imm r20, 238
        imm r21, 35445
        call exact_require_block_pc
        imm r20, 234
        imm r21, 238
        imm r22, 53
        call exact_require_proc_blocks

        imm r20, 239
        imm r21, 35495
        call exact_require_block_pc
        imm r20, 240
        imm r21, 35546
        call exact_require_block_pc
        imm r20, 241
        imm r21, 35678
        call exact_require_block_pc
        imm r20, 242
        imm r21, 35831
        call exact_require_block_pc
        imm r20, 239
        imm r21, 242
        imm r22, 54
        call exact_require_proc_blocks

        call operator_classifier_require_transitions
        call operator_classifier_require_events
        call operator_classifier_require_locals
        call operator_classifier_require_primitives
        call operator_classifier_require_pushes
        call operator_classifier_require_censuses
        ret

operator_classifier_require_proc_frame:
        mov r30, r20
        imm r20, 7151616
        mov r21, r30
        imm r22, 1                    ; one parameter
        call transfer_require_cell
        imm r20, 7159808
        mov r21, r30
        imm r22, 1                    ; one total frame slot
        call transfer_require_cell
        mov r20, r30
        call call_bounds_frame_bytes
        imm r1, 16                    ; saved fp plus parameter slot
        jeq r0, r1, exact_shape_ok
        jmp reject

operator_classifier_require_transitions:
        ; is_muldiv: star, slash, percent, complement.
        imm r20, 178
        imm r21, 235
        imm r22, 1
        imm r23, 238
        imm r24, 35132                ; checked star-true guard
        call exact_require_transition
        imm r20, 179
        imm r21, 235
        imm r22, 0
        imm r23, 236
        imm r24, 35151
        call exact_require_transition
        imm r20, 180
        imm r21, 236
        imm r22, 1
        imm r23, 238
        imm r24, 35264
        call exact_require_transition
        imm r20, 181
        imm r21, 236
        imm r22, 0
        imm r23, 237
        imm r24, 35283
        call exact_require_transition
        imm r20, 182
        imm r21, 237
        imm r22, 1
        imm r23, 238
        imm r24, 35396                ; checked percent-true guard
        call exact_require_transition

        ; is_addsub: plus, minus, complement.
        imm r20, 183
        imm r21, 240
        imm r22, 1
        imm r23, 242
        imm r24, 35650                ; checked plus-true guard
        call exact_require_transition
        imm r20, 184
        imm r21, 240
        imm r22, 0
        imm r23, 241
        imm r24, 35669
        call exact_require_transition
        imm r20, 185
        imm r21, 241
        imm r22, 1
        imm r23, 242
        imm r24, 35782                ; checked minus-true guard
        call exact_require_transition
        ret

operator_classifier_require_events:
        imm r20, 379
        imm r21, 237
        imm r22, 5
        imm r23, 35444                ; is_muldiv false return
        call exact_require_event
        imm r20, 380
        imm r21, 238
        imm r22, 5
        imm r23, 35474                ; is_muldiv true return
