        imm r22, 144
        imm r23, 149                 ; checked exclusive local row
        imm r24, 55
        imm r25, 55                  ; no raw-memory rows
        imm r26, 178
        imm r27, 186                 ; checked exclusive transition row
        imm r28, 379
