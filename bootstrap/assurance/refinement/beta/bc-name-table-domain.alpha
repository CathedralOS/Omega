; Shared bounded name-table/query-name domain for conditional lexical leaves.
;
; NPFX(n): 0<=n<=1024 and every q<n carries exact NAMEOFF/NAMELEN payloads
; (off_q,len_q) selecting SRC[off_q:off_q+len_q], with off_q<=LEN and
; len_q<=LEN-off_q. QNAME(b,l) is the same valid-slice relation for the current
; IDOFF/IDLEN. Empty slices and duplicate names are admitted. This module does
; not establish NPFX from a dynamic root; it checks the bounded address family
; and publishes a reusable conditional descriptor.
;
; Fresh cells after the stable common-prefix token at 531840:
;   public NTDM / prefix / query / selected i   531848..531872
;   table address/payload/query slice           531880..531896
;   source address/byte relation                531904/531912
;   address sweep count/nonalias/source bound   531920..531936
;   quiet-state premise                         531944
; Reset endpoint / next fresh cell: 531952.

name_table_domain_init:
        imm r20, 531840
        imm r21, 1481003091           ; stable SPFX common-prefix contract
        call exact_require_cell
        call name_table_domain_reset
        call name_table_require_load_classes
        call name_table_prove_address_sweep
        call name_table_introduce_relations
        call name_table_publish
        jmp name_eq_summary_init

name_table_domain_reset:
        imm r10, 531848
name_table_domain_reset_loop:
        imm r1, 531952
        jlt r10, r1, name_table_domain_reset_cell
        ret
name_table_domain_reset_cell:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp name_table_domain_reset_loop

; Consume the grammar-derived dynamic load families. Rows44/46 are the only
; name-table loads; rows49/50 are this procedure's two SRC-byte loads.
name_table_require_load_classes:
        imm r20, 44                  ; exact NAMELEN table load row
        imm r21, 3
        call name_table_require_load_class
        imm r20, 46
        imm r21, 3
        call name_table_require_load_class
        imm r20, 49
        imm r21, 2
        call name_table_require_load_class
        imm r20, 50
        imm r21, 2
        call name_table_require_load_class
        ret

name_table_require_load_class:
        imm r1, 8
        mul r20, r1
        imm r1, 16924672
        add r1, r20
        load r2, r1
        jeq r2, r21, name_table_domain_ok
        jmp reject

; Exhaust all 1024 aligned slots in both arrays. The endpoint arithmetic also
; proves word extents remain inside their disjoint 8192-byte regions.
name_table_prove_address_sweep:
        imm r10, 0
name_table_address_loop:
        imm r1, 1024
        jlt r10, r1, name_table_address_row
        jeq r10, r1, name_table_address_done
        jmp reject
name_table_address_row:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        mov r12, r11
        imm r1, 3145728
        add r12, r1                  ; NAMEOFF[q]
        imm r2, 3153920
        jlt r12, r2, name_table_nameoff_extent
        jmp reject
name_table_nameoff_extent:
        mov r13, r12
        imm r1, 7
        add r13, r1
        imm r2, 3153920              ; exact NAMEOFF exclusive extent
        jlt r13, r2, name_table_namelen_address
        jmp reject
name_table_namelen_address:
        mov r14, r11
        imm r1, 3153920
        add r14, r1                  ; NAMELEN[q]
        imm r2, 3162112
        jlt r14, r2, name_table_namelen_extent
        jmp reject
name_table_namelen_extent:
        mov r16, r14
        imm r1, 7
        add r16, r1
        imm r2, 3162112
        jlt r16, r2, name_table_arrays_ordered
        jmp reject
name_table_arrays_ordered:
        jlt r13, r14, name_table_address_next
        jmp reject
name_table_address_next:
        imm r1, 1
        add r10, r1
        jmp name_table_address_loop
name_table_address_done:
        imm r1, 531920
        store r1, r10                 ; persistent exact completion count1024
        imm r1, 531928
        imm r2, 1
        store r1, r2                  ; aligned/disjoint table extents
        ret

; Introduce the explicit conditional theorem parameters. They are never
; relabelled as globally established runtime facts: later callers must supply
; and preserve NPFX/QNAME. Selected i satisfies 0<=i<n, hence i<=1023.
name_table_introduce_relations:
        imm r1, 531856
        imm r2, 1
        store r1, r2                  ; conditional NPFX(n), 0<=n<=1024
        imm r1, 531864
        store r1, r2                  ; conditional QNAME(b,l)
        imm r1, 531872
        store r1, r2                  ; selected 0<=i<n
        imm r1, 531880
        store r1, r2                  ; exact two table addresses for i
        imm r1, 531888
        store r1, r2                  ; exact table payload/source slice
        imm r1, 531896
        store r1, r2                  ; exact current query source slice
        imm r1, 531904
        store r1, r2                  ; off+k/b+k nonwrapping when k<len
        imm r1, 531912
        store r1, r2                  ; zero-extended exact source bytes
        imm r1, 531936
        store r1, r2                  ; both slices remain within SRC capacity
        imm r1, 531944
        store r1, r2                  ; conditional name-domain state quiet
        ret

name_table_require_relations:
        imm r20, 531856
        imm r21, 1
        call exact_require_cell
        imm r20, 531864
        imm r21, 1
        call exact_require_cell
        imm r20, 531872
        imm r21, 1
        call exact_require_cell
        imm r20, 531880
        imm r21, 1
        call exact_require_cell
        imm r20, 531888
        imm r21, 1
        call exact_require_cell
        imm r20, 531896
        imm r21, 1
        call exact_require_cell
        imm r20, 531904
        imm r21, 1
        call exact_require_cell
        imm r20, 531912
        imm r21, 1
        call exact_require_cell
        imm r20, 531920
        imm r21, 1024
        call exact_require_cell
        imm r20, 531928
        imm r21, 1
        call exact_require_cell
        imm r20, 531936
        imm r21, 1
        call exact_require_cell
        imm r20, 531944
        imm r21, 1
        call exact_require_cell
        ret

name_table_publish:
        call name_table_require_relations
        imm r1, 531848
        imm r2, 1296323662            ; NTDM
        store r1, r2
        ret
name_table_domain_ok:
        ret
