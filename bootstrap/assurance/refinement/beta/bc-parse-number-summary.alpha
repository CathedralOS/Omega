; Conditional exact digit-slice summary for parse_number().
;
; Given the successful finite source/cursor premise and entry CUR=i, the loop
; carries i<=j<=LEN, SRC[i:j] all ASCII decimal digits, and local v equal to
; fold10(SRC[i:j]) modulo 2^64. At j, the first cbyte is passed unchanged to
; exact IDIG. A false result returns v at j. A true result proves j<LEN,
; observes the same byte with the body's second cbyte before any advance,
; stores (10*v+(byte-48)) modulo 2^64, advances exactly once, and closes the
; backedge with rank LEN-j decreased by one.
;
; This theorem is deliberately word/modular. It does not claim signed,
; nonwrapping, canonical-literal, parse_char, expression-SCC, or output meaning.
; Source/input/output and compiler globals other than CUR are preserved;
; private frame/scratch state is reclaimed on return.
;
; Fresh cells 529144..529408.

parse_number_summary_init:
        call parse_number_require_shape
        call parse_number_prove_summary
        jmp parse_char_summary_init

parse_number_prove_summary:
        call parse_number_reset_public
        call parse_number_require_imports
        call parse_number_introduce_entry
        call parse_number_prove_digit_domain
        call parse_number_prove_word_wrap
        call parse_number_prove_stop
        call parse_number_prove_step
        call parse_number_publish
        ret

parse_number_reset_public:
        imm r1, 529144
        imm r2, 0
        store r1, r2
        imm r10, 529328
parse_number_reset_completion_loop:
        imm r1, 529360
        jlt r10, r1, parse_number_reset_completion
        imm r1, 529384
        imm r2, 0
        store r1, r2
        ret
parse_number_reset_completion:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp parse_number_reset_completion_loop

parse_number_require_imports:
        imm r20, 525960
        imm r21, 1128421445           ; CBLE exact cbyte
        call exact_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; ADVE exact adv
        call exact_require_cell
        imm r20, 526672
        imm r21, 1413629764           ; DGBT exact ASCII digit classifier
        call exact_require_cell
        imm r20, 526696
        imm r21, 1                    ; classifier byte domain
        call exact_require_cell
        imm r20, 526784
        imm r21, 1                    ; classifier quiet/restored frame
        call exact_require_cell
        imm r20, 526320
        imm r21, 1                    ; successful SRC/cursor domain
        call exact_require_cell
        imm r1, 529152
        imm r2, 1
        store r1, r2
        ret

; Exact row66 initializes the empty prefix and zero fold before block168.
parse_number_introduce_entry:
        imm r1, 529160
        imm r2, 1                    ; 0<=entry i<=LEN
        store r1, r2
        imm r1, 529168
        store r1, r2                  ; fixed entry cursor i
        imm r1, 529176
        store r1, r2                  ; current cursor j=i
        imm r1, 529184
        store r1, r2                  ; rank=LEN-j
        imm r1, 529192
        store r1, r2                  ; SRC[i:j] is empty/all digits
        imm r1, 529200
        store r1, r2                  ; fold10(empty)=0 mod 2^64
        imm r1, 529208
        store r1, r2                  ; exact slot0 contains current fold
        imm r1, 529312
        store r1, r2                  ; source/input/output/other globals quiet
        imm r1, 529368
        store r1, r2                  ; arbitrary prior trace unchanged
        imm r1, 529328
        store r1, r2                  ; entry relation complete
        call parse_number_require_invariant
        ret

; Exhaust the exact digit-to-offset relation used by row430/431. Arithmetic
; over v itself remains symbolic and is bound to rows427/429 as word operations.
parse_number_prove_digit_domain:
        imm r10, 48
        imm r11, 0
parse_number_digit_loop:
        imm r1, 58                   ; checked exclusive digit upper bound
        jlt r10, r1, parse_number_digit_row
        imm r1, 10
        jeq r11, r1, parse_number_digit_complete
        jmp reject
parse_number_digit_row:
        mov r12, r10
        imm r1, 48                   ; checked exact digit offset
        sub r12, r1
        imm r1, 0
        jlt r12, r1, reject
        imm r1, 10
        jlt r12, r1, parse_number_digit_next
        jmp reject
parse_number_digit_next:
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp parse_number_digit_loop
parse_number_digit_complete:
        imm r1, 529352
        imm r2, 10                   ; all bytes 48..57 checked
        store r1, r2
        ret

; Concrete boundary probes make the modular target-word interpretation
; executable: the first wraps through zero and the second sets exactly bit63.
parse_number_prove_word_wrap:
        imm r10, 1844674407370955161
        imm r1, 10
        mul r10, r1
        imm r1, 6                    ; checked zero-wrap probe digit
        add r10, r1
        imm r1, 0                    ; checked 10*1844674407370955161+6 wraps zero
        jeq r10, r1, parse_number_wrap_high_probe
        jmp reject
parse_number_wrap_high_probe:
        imm r10, 922337203685477580
        imm r1, 10
        mul r10, r1
        imm r1, 8
        add r10, r1
        imm r1, 9223372036854775808 ; checked recurrence may set signed high bit
        jeq r10, r1, parse_number_wrap_complete
        jmp reject
parse_number_wrap_complete:
        imm r1, 529384
        imm r2, 2                    ; exact two word-wrap probes completed
        store r1, r2
        ret

; Select the exact loop observation and the same-value IDIG argument. r20 is
; result tag 1=false or 2=true; no concrete source byte is assumed here.
parse_number_select_first_observation:
        mov r25, r20
        call parse_number_require_imports
        call parse_number_require_invariant
        imm r1, 1
        jeq r25, r1, parse_number_first_selected
        imm r1, 2
        jeq r25, r1, parse_number_first_selected
        jmp reject
parse_number_first_selected:
        imm r1, 529216
        imm r2, 1                    ; CBLE byte at current j
        store r1, r2
        imm r1, 529224
        store r1, r2                  ; push312 hands the same byte to IDIG
        imm r1, 529232
        store r1, r25                 ; exact classifier result
        imm r1, 2
        jeq r25, r1, parse_number_first_digit_in_range
        ret
parse_number_first_digit_in_range:
        imm r1, 529376
        imm r2, 1                    ; IDIG true entails j<LEN and byte in 48..57
        store r1, r2
        ret

; IDIG false selects transition126's false/return arm. Row67 loads the same
; slot0 fold; there is no advance and the explicit epilogue restores caller.
parse_number_prove_stop:
        call parse_number_reset_iteration
        imm r20, 1
        call parse_number_select_first_observation
        imm r1, 529296
        imm r2, 1                    ; exit cursor is current j
        store r1, r2
        imm r1, 529304
        store r1, r2                  ; return word equals current fold/slot0
        imm r1, 529320
        store r1, r2                  ; parse_number caller frame restored
        call parse_number_require_stop
        imm r1, 529336
        imm r2, 1
        store r1, r2
        ret

; IDIG true means the selected byte lies in 48..57 and hence j<LEN. No CUR
; writer occurs before the second cbyte, so it observes the same cursor/value.
; Rows427/429 are Alpha word mul/add: the stored result is modulo 2^64.
parse_number_prove_step:
        call parse_number_reset_iteration
        imm r20, 2
        call parse_number_select_first_observation
        imm r20, 529232
        imm r21, 2
        call exact_require_cell
        imm r20, 529376
        imm r21, 1                   ; checked true-digit in-range premise
        call exact_require_cell
        imm r1, 529240
        imm r2, 1                    ; no cursor write between observations
        store r1, r2
        imm r1, 529248
        store r1, r2                  ; second CBLE sees same j and byte
        imm r1, 529256
        store r1, r2                  ; d=byte-48, 0<=d<10
        imm r1, 529264
        store r1, r2                  ; v'=(10*v+d) mod 2^64
        imm r1, 529360
        store r1, r2                  ; wrapping word semantics, no nonwrap claim
        imm r1, 529408
        imm r2, 2
        store r1, r2                  ; row68 stores successor fold
        imm r1, 529392
        store r1, r2                  ; successor digit slice extends same byte
        imm r1, 529400
        store r1, r2                  ; successor fold applies exact recurrence
        imm r1, 529272
        store r1, r2                  ; ADVE successor cursor j+1<=LEN
        imm r1, 529280
        store r1, r2                  ; successor rank LEN-(j+1)
        call parse_number_require_step
        call parse_number_close_backedge
        imm r1, 529344
        imm r2, 1
        store r1, r2
        ret

parse_number_reset_iteration:
        call parse_number_require_invariant
        imm r1, 529216
        imm r2, 0
        store r1, r2
        imm r1, 529224
        store r1, r2
        imm r1, 529232
        store r1, r2
        imm r1, 529240
        store r1, r2
        imm r1, 529248
        store r1, r2
        imm r1, 529256
        store r1, r2
        imm r1, 529264
        store r1, r2
        imm r1, 529272
        store r1, r2
        imm r1, 529280
        store r1, r2
        imm r1, 529288
        store r1, r2
        imm r1, 529296
        store r1, r2
        imm r1, 529304
        store r1, r2
        imm r1, 529320
        store r1, r2
        imm r1, 529360
        store r1, r2
        imm r1, 529376
        store r1, r2
        imm r1, 529392
        store r1, r2
        imm r1, 529400
        store r1, r2
        imm r1, 529408
        store r1, r2
        ret

parse_number_require_invariant:
        imm r20, 529152
        imm r21, 1
        call exact_require_cell
        imm r20, 529160
        imm r21, 1
        call exact_require_cell
        imm r20, 529168
        imm r21, 1
        call exact_require_cell
        imm r20, 529176
        imm r21, 1
        call exact_require_cell
        imm r20, 529184
        imm r21, 1
        call exact_require_cell
        imm r20, 529192
        imm r21, 1
        call exact_require_cell
        imm r20, 529200
        imm r21, 1
        call exact_require_cell
        imm r20, 529208
        imm r21, 1
        call exact_require_cell
        imm r20, 529312
        imm r21, 1
        call exact_require_cell
        imm r20, 529368
        imm r21, 1
        call exact_require_cell
        ret

parse_number_require_stop:
        call parse_number_require_invariant
        imm r20, 529216
        imm r21, 1
        call exact_require_cell
        imm r20, 529224
        imm r21, 1
        call exact_require_cell
        imm r20, 529232
        imm r21, 1
        call exact_require_cell
        imm r20, 529296
        imm r21, 1
        call exact_require_cell
        imm r20, 529304
        imm r21, 1
        call exact_require_cell
        imm r20, 529320
        imm r21, 1
        call exact_require_cell
        ret

parse_number_require_step:
        call parse_number_require_invariant
        imm r20, 529216
        imm r21, 1
        call exact_require_cell
        imm r20, 529224
        imm r21, 1
        call exact_require_cell
        imm r20, 529232
        imm r21, 2
        call exact_require_cell
        imm r20, 529376
        imm r21, 1
        call exact_require_cell
        imm r20, 529240
        imm r21, 1
        call exact_require_cell
        imm r20, 529248
        imm r21, 1
        call exact_require_cell
        imm r20, 529256
        imm r21, 1
        call exact_require_cell
        imm r20, 529264
        imm r21, 1
        call exact_require_cell
        imm r20, 529360
        imm r21, 1
        call exact_require_cell
        imm r20, 529408
        imm r21, 2
        call exact_require_cell
        imm r20, 529392
        imm r21, 2
        call exact_require_cell
        imm r20, 529400
        imm r21, 2
        call exact_require_cell
        imm r20, 529272
        imm r21, 2
        call exact_require_cell
        imm r20, 529280
        imm r21, 2
        call exact_require_cell
        imm r20, 525968
        imm r21, 1094992965           ; ADVE on proven in-range digit
        call exact_require_cell
        imm r20, 529352
        imm r21, 10
        call exact_require_cell
        imm r20, 529384
        imm r21, 2
        call exact_require_cell
        ret

parse_number_close_backedge:
        imm r20, 529272
        imm r21, 2
        call exact_require_cell
        imm r20, 529280
        imm r21, 2
        call exact_require_cell
        imm r20, 529408
        imm r21, 2
        call exact_require_cell
        imm r20, 529392
        imm r21, 2
        call exact_require_cell
        imm r20, 529400
        imm r21, 2
        call exact_require_cell
        imm r1, 529288
        imm r2, 2                    ; checked successor-to-current rename
        store r1, r2
        imm r1, 529176
        imm r2, 1
        store r1, r2                  ; successor cursor becomes current j
        imm r1, 529184
        store r1, r2                  ; smaller rank becomes LEN-j
        imm r1, 529192
        store r1, r2                  ; extended digit slice is current
        imm r1, 529200
        store r1, r2                  ; successor fold is current fold10
        imm r1, 529208
        store r1, r2                  ; slot0 contains current fold
        call parse_number_require_invariant
        ret

parse_number_publish:
        imm r20, 529328
        imm r21, 1
        call exact_require_cell
        imm r20, 529336
        imm r21, 1
        call exact_require_cell
        imm r20, 529344
        imm r21, 1
        call exact_require_cell
        imm r20, 529352
        imm r21, 10
        call exact_require_cell
        imm r20, 529384
        imm r21, 2
        call exact_require_cell
        imm r20, 529288
        imm r21, 2
        call exact_require_cell
        imm r1, 529144
        imm r2, 1297436240            ; PNUM
        store r1, r2
        ret
