; Full-Word case certificate for emit_cmp(code).
;
; Eight disjoint rows cover exact codes0..5, the remaining nonnegative signed
; interval 6..INT64_MAX, and the negative signed interval
; INT64_MIN..-1. Operator tags are 0=none, 1="jlt r0,r1,",
; 2="jlt r1,r0,", 3="jeq r0,r1,".  lt3 is the source's signed code<3.
;
; Cells537704..<538112. Row base537728, stride48:
;   lo, hi, operator, lt3, valid-six, checked-completion.

emit_cmp_cases_init:
        call emit_cmp_cases_reset
        call emit_cmp_cases_build
        call emit_cmp_cases_check_partition
        call emit_cmp_cases_publish
        ret

emit_cmp_cases_reset:
        imm r1, 537704
        imm r2, 0
emit_cmp_cases_reset_loop:
        imm r3, 538112
        jlt r1, r3, emit_cmp_cases_reset_cell
        ret
emit_cmp_cases_reset_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp emit_cmp_cases_reset_loop

; r20=row, r21=lo, r22=hi, r23=operator, r24=lt3, r25=valid-six.
emit_cmp_cases_store_row:
        mov r30, r20
        imm r1, 48
        mul r30, r1
        imm r1, 537728
        add r30, r1
        store r30, r21
        imm r1, 8
        add r30, r1
        store r30, r22
        add r30, r1
        store r30, r23
        add r30, r1
        store r30, r24
        add r30, r1
        store r30, r25
        ret

emit_cmp_cases_build:
        imm r20, 0
        imm r21, 0
        imm r22, 0
        imm r23, 1                    ; jlt r0,r1,
        imm r24, 1                    ; signed code<3
        imm r25, 1
        call emit_cmp_cases_store_row
        imm r20, 1
        imm r21, 1
        imm r22, 1
        imm r23, 2                    ; jlt r1,r0,
        imm r24, 1
        imm r25, 1
        call emit_cmp_cases_store_row
        imm r20, 2
        imm r21, 2
        imm r22, 2
        imm r23, 3                    ; jeq r0,r1,
        imm r24, 1
        imm r25, 1
        call emit_cmp_cases_store_row
        imm r20, 3
        imm r21, 3
        imm r22, 3
        imm r23, 3                    ; same jeq, inverted materialization
        imm r24, 0
        imm r25, 1
        call emit_cmp_cases_store_row
        imm r20, 4
        imm r21, 4
        imm r22, 4
        imm r23, 2
        imm r24, 0
        imm r25, 1
        call emit_cmp_cases_store_row
        imm r20, 5
        imm r21, 5
        imm r22, 5
        imm r23, 1
        imm r24, 0
        imm r25, 1
        call emit_cmp_cases_store_row

        ; All remaining signed nonnegative words take no operator state.
        imm r20, 6
        imm r21, 6
        imm r22, 9223372036854775807
        imm r23, 0
        imm r24, 0
        imm r25, 0
        call emit_cmp_cases_store_row
        ; High-bit Words are signed negative, hence satisfy signed code<3.
        imm r20, 7
        imm r21, 9223372036854775807
        imm r1, 1
        add r21, r1                  ; INT64_MIN
        imm r22, 0
        sub r22, r1                  ; WORD_MAX / signed -1
        imm r23, 0
        imm r24, 1
        imm r25, 0
        call emit_cmp_cases_store_row
        ret

; Consume the descriptor independently in an order unlike its construction.
emit_cmp_cases_check_partition:
        imm r20, 7
        imm r21, 9223372036854775807
        imm r1, 1
        add r21, r1                  ; INT64_MIN
        imm r22, 0
        sub r22, r1                  ; WORD_MAX / signed -1
        imm r23, 0
        imm r24, 1
        imm r25, 0
        call emit_cmp_cases_require_and_complete
        imm r20, 6
        imm r21, 6
        imm r22, 9223372036854775807
        imm r23, 0
        imm r24, 0
        imm r25, 0
        call emit_cmp_cases_require_and_complete
        imm r20, 5
        imm r21, 5
        imm r22, 5
        imm r23, 1
        imm r24, 0
        imm r25, 1
        call emit_cmp_cases_require_and_complete
        imm r20, 4
        imm r21, 4
        imm r22, 4
        imm r23, 2
        imm r24, 0
        imm r25, 1
        call emit_cmp_cases_require_and_complete
        imm r20, 3
        imm r21, 3
        imm r22, 3
        imm r23, 3
        imm r24, 0
        imm r25, 1
        call emit_cmp_cases_require_and_complete
        imm r20, 2
        imm r21, 2
        imm r22, 2
        imm r23, 3
        imm r24, 1
        imm r25, 1
        call emit_cmp_cases_require_and_complete
        imm r20, 1
        imm r21, 1
        imm r22, 1
        imm r23, 2
        imm r24, 1
        imm r25, 1
        call emit_cmp_cases_require_and_complete
        imm r20, 0
        imm r21, 0
        imm r22, 0
        imm r23, 1
        imm r24, 1
        imm r25, 1
        call emit_cmp_cases_require_and_complete
        call emit_cmp_cases_check_signed_boundaries
        ret

emit_cmp_cases_require_and_complete:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        imm r1, 48
        mul r30, r1
        imm r1, 537728
        add r30, r1
        load r2, r30
        jeq r2, r31, emit_cmp_cases_row_hi
        jmp reject
emit_cmp_cases_row_hi:
        imm r1, 8
        add r30, r1
        load r2, r30
        jeq r2, r32, emit_cmp_cases_row_operator
        jmp reject
emit_cmp_cases_row_operator:
        add r30, r1
        load r2, r30
        jeq r2, r33, emit_cmp_cases_row_lt3
        jmp reject
emit_cmp_cases_row_lt3:
        add r30, r1
        load r2, r30
        jeq r2, r34, emit_cmp_cases_row_valid
        jmp reject
emit_cmp_cases_row_valid:
        add r30, r1
        load r2, r30
        jeq r2, r35, emit_cmp_cases_row_complete
        jmp reject
emit_cmp_cases_row_complete:
        add r30, r1
        imm r2, 1
        store r30, r2
        ret

; Check the only wrap boundary plus both signed code<3 boundaries.  The exact
; interval descriptors then cover every Word without an unsigned comparison.
emit_cmp_cases_check_signed_boundaries:
        imm r1, 9223372036854775807
        imm r2, 1
        add r1, r2
        imm r3, 9223372036854775807
        add r3, r2                   ; INT64_MIN
        jeq r1, r3, emit_cmp_cases_check_word_wrap
        jmp reject
emit_cmp_cases_check_word_wrap:
        imm r1, 0
        sub r1, r2                   ; WORD_MAX / signed -1
        add r1, r2
        imm r3, 0
        jeq r1, r3, emit_cmp_cases_check_negative
        jmp reject
emit_cmp_cases_check_negative:
        imm r1, 9223372036854775807
        add r1, r2                   ; INT64_MIN
        imm r2, 3
        jlt r1, r2, emit_cmp_cases_check_minus_one
        jmp reject
emit_cmp_cases_check_minus_one:
        imm r1, 0
        imm r4, 1
        sub r1, r4                   ; signed -1
        jlt r1, r2, emit_cmp_cases_check_two
        jmp reject
emit_cmp_cases_check_two:
        imm r1, 2
        jlt r1, r2, emit_cmp_cases_check_three
        jmp reject
emit_cmp_cases_check_three:
        imm r1, 3
        jlt r1, r2, reject
        imm r1, 9223372036854775807
        jlt r1, r2, reject
        ret

emit_cmp_cases_require_all:
        imm r10, 0
emit_cmp_cases_require_all_loop:
        imm r1, 8
        jlt r10, r1, emit_cmp_cases_require_one
        ret
emit_cmp_cases_require_one:
        mov r20, r10
        imm r1, 48
        mul r20, r1
        imm r1, 537768              ; row completion offset40
        add r20, r1
        imm r21, 1
        call exact_require_cell
        imm r1, 1
        add r10, r1
        jmp emit_cmp_cases_require_all_loop

emit_cmp_cases_publish:
        call emit_cmp_cases_require_all
        imm r1, 537712
        imm r2, 1                    ; exhaustive disjoint signed partition
        store r1, r2
        imm r1, 537720
        imm r2, 8
        store r1, r2
        imm r1, 537704
        imm r2, 1129333573           ; ECPC
        store r1, r2
        imm r20, 537704
        imm r21, 1129333573
        call exact_require_cell
        ret
