; BCT7 effect-site extension for bc-block-control.alpha.
;
; This fragment is concatenated with the common checker before assembly.  It
; reuses that process's exact source scan, block table, tape bytes, and decoded
; instruction-start coverage.  The untrusted witness contributes locations
; only.  Event tables begin at 7077888; the one-byte effect owner map begins at
; 6815744, immediately after the common checker's bounded CFG worklist.

; The current identifier is a call-like event iff trivia is followed by `(`.
maybe_call_event:
        imm r1, 524304
        load r2, r1
        imm r1, 524520
        store r1, r2                    ; cursor after identifier
        call skip_trivia
        call current_byte
        imm r1, 40
        jeq r0, r1, classify_call_event
        jmp restore_noncall_cursor
classify_call_event:
        call ident_is_read_byte
        imm r1, 1
        jeq r0, r1, add_read_event
        call ident_is_write_byte
        imm r1, 1
        jeq r0, r1, add_write_event
        call ident_is_emit
        imm r1, 1
        jeq r0, r1, add_emit_event
        imm r4, 1
        call add_effect_event
        jmp restore_event_cursor
add_read_event:
        imm r4, 2
        call add_effect_event
        jmp restore_event_cursor
add_write_event:
        imm r4, 3
        call add_effect_event
        jmp restore_event_cursor
add_emit_event:
        imm r4, 4
        call add_effect_event
restore_event_cursor:
        imm r1, 524520
        load r2, r1
        imm r1, 524304
        store r1, r2
        jmp scan_loop
restore_noncall_cursor:
        imm r1, 524520
        load r2, r1
        imm r1, 524304
        store r1, r2
        jmp maybe_local_access

; Append the source event described by kind r4 and current IOFF/ILEN.
add_effect_event:
        imm r1, 524456
        load r2, r1
        imm r3, 1024
        jlt r2, r3, effect_event_room
        jmp reject
effect_event_room:
        imm r1, 524528
        store r1, r2                    ; current event index
        mov r5, r2
        imm r6, 8
        mul r5, r6
        imm r6, 524352
        load r7, r6
        imm r6, 7077888
        add r6, r5
        store r6, r7                    ; source block index
        imm r6, 7086080
        add r6, r5
        store r6, r4                    ; event kind
        imm r6, 524360
        load r7, r6
        imm r6, 7094272
        add r6, r5
        store r6, r7                    ; source name offset
        imm r6, 524368
        load r7, r6
        imm r6, 7102464
        add r6, r5
        store r6, r7                    ; source name length
        imm r7, 0
        imm r6, 7110656
        add r6, r5
        store r6, r7                    ; literal source offset
        imm r6, 7118848
        add r6, r5
        store r6, r7                    ; literal encoded length
        imm r6, 7127040
        add r6, r5
        store r6, r7                    ; literal decoded length
        imm r6, 7143424
        add r6, r5
        store r6, r7                    ; ordinary/intrinsic call arity

        imm r6, 1
        add r2, r6
        imm r1, 524456
        store r1, r2
        imm r1, 1
        jeq r4, r1, count_source_call
        imm r1, 2
        jeq r4, r1, count_source_read
        imm r1, 3
        jeq r4, r1, count_source_write
        imm r1, 4
        jeq r4, r1, count_source_emit
        imm r1, 5
        jeq r4, r1, count_source_return
        jmp reject
count_source_call:
        call record_call_arity
        call count_ordinary_call_arity
        imm r1, 524464
        jmp increment_source_kind
count_source_read:
        call record_call_arity
        imm r1, 524472
        jmp increment_source_kind
count_source_write:
        call record_call_arity
        imm r1, 524480
        jmp increment_source_kind
count_source_return:
        imm r1, 524496
        jmp increment_source_kind
count_source_emit:
        imm r1, 524488
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        call record_emit_literal
        ret
increment_source_kind:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Record the exact quoted payload for the current emit event without consuming
; it from the outer lexical scan.  Escapes count as one decoded byte.
record_emit_literal:
        imm r1, 524304
        load r2, r1
        imm r1, 524536
        store r1, r2
        call skip_trivia
        call current_byte
        imm r1, 40
        jeq r0, r1, emit_literal_open_paren
        jmp reject
emit_literal_open_paren:
        call advance_one
        call skip_trivia
        call current_byte
        imm r1, 34
        jeq r0, r1, emit_literal_open_quote
        jmp reject
emit_literal_open_quote:
        call advance_one
        imm r1, 524304
        load r2, r1
        imm r1, 524528
        load r3, r1
        imm r4, 8
        mul r3, r4
        imm r4, 7110656
        add r4, r3
        store r4, r2                    ; first encoded payload byte
        imm r8, 0                       ; decoded byte count
emit_literal_scan:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 34
        jeq r0, r1, emit_literal_close_quote
        imm r1, 92
        jeq r0, r1, emit_literal_escape
        call advance_one
        imm r1, 1
        add r8, r1
        jmp emit_literal_scan
emit_literal_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        imm r1, 1
        add r8, r1
        jmp emit_literal_scan
emit_literal_close_quote:
        imm r1, 524304
        load r2, r1
        imm r1, 524528
        load r3, r1
        imm r4, 8
        mul r3, r4
        imm r4, 7110656
        add r4, r3
        load r5, r4
        sub r2, r5
        imm r4, 7118848
        add r4, r3
        store r4, r2                    ; encoded payload length
        imm r4, 7127040
        add r4, r3
        store r4, r8                    ; decoded payload length
        imm r1, 524504
        load r2, r1
        add r2, r8
        store r1, r2
        call advance_one
        call skip_trivia
        call current_byte
        imm r1, 41
        jeq r0, r1, emit_literal_restore
        jmp reject
emit_literal_restore:
        imm r1, 524536
        load r2, r1
        imm r1, 524304
        store r1, r2
        ret

; Read the canonical source-order event locations after the BCT7 control sites.
; Before the common decoder's secondary phase, add each compiler-synthesized
; fallthrough epilogue as a root.  Many are semantically unreachable because a
; source block returns first, but they are still effectful bytes in the exact
; persisted artifact and therefore must enter the one global framing.
enqueue_fallthrough_roots_init:
        imm r10, 0
enqueue_fallthrough_roots_loop:
        imm r1, 355
        jlt r10, r1, enqueue_fallthrough_candidate
        jmp cfg_work_loop
enqueue_fallthrough_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, enqueue_next_proc_init
        jmp enqueue_fallthrough_next
enqueue_next_proc_init:
        mov r11, r10
        imm r1, 1
        add r11, r1
enqueue_next_proc_loop:
        imm r1, 355
        jlt r11, r1, enqueue_next_proc_candidate
        imm r1, 524296
        load r7, r1
        jmp enqueue_fallthrough_end
enqueue_next_proc_candidate:
        mov r13, r11
        imm r1, 8
        mul r13, r1
        imm r1, 3178496
        add r1, r13
        load r2, r1
        imm r3, 0
        jeq r2, r3, enqueue_next_proc_found
        imm r1, 1
        add r11, r1
        jmp enqueue_next_proc_loop
enqueue_next_proc_found:
        imm r1, 3235840
        add r1, r13
        load r7, r1
enqueue_fallthrough_end:
        imm r1, 20
        jlt r7, r1, reject
        mov r0, r7
        sub r0, r1
        call cfg_enqueue
enqueue_fallthrough_next:
        imm r1, 1
        add r10, r1
        jmp enqueue_fallthrough_roots_loop

read_effect_pcs_init:
        imm r10, 0
read_effect_pc:
        imm r1, 612
        jlt r10, r1, read_effect_pc_one
        jmp read_local_access_pcs_init
read_effect_pc_one:
        call read_u32
        mov r14, r0
        imm r1, 524296
        load r2, r1
        jlt r14, r2, effect_pc_covered
        jmp reject
effect_pc_covered:
        imm r1, 4194304
        add r1, r14
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, effect_pc_block_range
        jmp reject
effect_pc_block_range:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7077888
        add r1, r12
        load r4, r1                     ; source block index
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r6, r1                     ; block start
        jlt r14, r6, reject
        imm r1, 1
        add r4, r1
        imm r1, 355
        jlt r4, r1, effect_pc_next_block
        imm r1, 524296
        load r7, r1
        jmp effect_pc_end_ready
effect_pc_next_block:
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r7, r1
effect_pc_end_ready:
        jlt r14, r7, effect_pc_store
        jmp reject
effect_pc_store:
        imm r1, 7135232
        add r1, r12
        store r1, r14
        imm r1, 1
        add r10, r1
        jmp read_effect_pc

read_helper_pc:
        call read_u32
        imm r1, 524512
        store r1, r0
        imm r1, 524296
        load r2, r1
        jlt r0, r2, helper_pc_covered
        jmp reject
helper_pc_covered:
        imm r1, 4194304
        add r1, r0
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, require_effect_eof
        jmp reject
require_effect_eof:
        read r0
        imm r1, 0
        jlt r0, r1, validate_prelude
        jmp reject

; The only non-source call/halt is the exact 31-byte root prelude.
validate_prelude:
        imm r1, 524512
        load r2, r1
        imm r3, 31
        jeq r2, r3, prelude_imm_sp
        jmp reject
prelude_imm_sp:
        imm r1, 2097152
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, prelude_imm_sp_reg
        jmp reject
prelude_imm_sp_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 15
        jeq r2, r3, prelude_imm_sp_value
        jmp reject
prelude_imm_sp_value:
        imm r2, 1
        add r1, r2
        load r2, r1
        imm r3, 1048576
        jeq r2, r3, prelude_imm_fp
        jmp reject
prelude_imm_fp:
        imm r1, 2097162
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, prelude_imm_fp_reg
        jmp reject
prelude_imm_fp_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 14
        jeq r2, r3, prelude_imm_fp_value
        jmp reject
prelude_imm_fp_value:
        imm r2, 1
        add r1, r2
        load r2, r1
        imm r3, 1048576
        jeq r2, r3, prelude_main_target
        jmp reject
prelude_main_target:
        call find_main_pc
        mov r8, r0
        imm r1, 2097172
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, prelude_main_operand
        jmp reject
prelude_main_operand:
        imm r2, 1
        add r1, r2
        load r2, r1
        jeq r2, r8, prelude_halt
        jmp reject
prelude_halt:
        imm r1, 2097181
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, prelude_halt_reg
        jmp reject
prelude_halt_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, prelude_own_call
        jmp reject
prelude_own_call:
        imm r0, 20
        call mark_effect_owner
        imm r0, 29
        call mark_effect_owner
        jmp validate_emit_helper

; Exact 52-byte __write_str leaf.  This is a local output macro: if reached
; with the checked literal pointer/length, it emits those bytes in order.
validate_emit_helper:
        imm r1, 524512
        load r6, r1                     ; helper pc
        imm r1, 2097152
        add r1, r6                      ; tape pointer at helper
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, helper_imm_zero_reg
        jmp reject
helper_imm_zero_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, helper_imm_zero_value
        jmp reject
helper_imm_zero_value:
        imm r2, 1
        add r1, r2
        load r2, r1
        imm r3, 0
        jeq r2, r3, helper_jeq
        jmp reject
helper_jeq:
        imm r1, 2097162
        add r1, r6
        loadb r2, r1
        imm r3, 16
        jeq r2, r3, helper_jeq_regs
        jmp reject
helper_jeq_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, helper_jeq_reg3
        jmp reject
helper_jeq_reg3:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, helper_jeq_target
        jmp reject
helper_jeq_target:
        imm r2, 1
        add r1, r2
        load r2, r1
        mov r3, r6
        imm r4, 51
        add r3, r4
        jeq r2, r3, helper_loadb
        jmp reject
helper_loadb:
        imm r1, 2097173
        add r1, r6
        loadb r2, r1
        imm r3, 8
        jeq r2, r3, helper_loadb_regs
        jmp reject
helper_loadb_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 2
        jeq r2, r3, helper_loadb_reg0
        jmp reject
helper_loadb_reg0:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, helper_write
        jmp reject
helper_write:
        imm r1, 2097176
        add r1, r6
        loadb r2, r1
        imm r3, 18
        jeq r2, r3, helper_write_reg
        jmp reject
helper_write_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 2
        jeq r2, r3, helper_imm_one
        jmp reject
helper_imm_one:
        imm r1, 2097178
        add r1, r6
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, helper_imm_one_reg
        jmp reject
helper_imm_one_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, helper_imm_one_value
        jmp reject
helper_imm_one_value:
        imm r2, 1
        add r1, r2
        load r2, r1
        imm r3, 1
        jeq r2, r3, helper_add
        jmp reject
helper_add:
        imm r1, 2097188
        add r1, r6
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, helper_add_regs
        jmp reject
helper_add_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, helper_add_reg3
        jmp reject
helper_add_reg3:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, helper_sub
        jmp reject
helper_sub:
        imm r1, 2097191
        add r1, r6
        loadb r2, r1
        imm r3, 4
        jeq r2, r3, helper_sub_regs
        jmp reject
helper_sub_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, helper_sub_reg3
        jmp reject
helper_sub_reg3:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, helper_jmp
        jmp reject
helper_jmp:
        imm r1, 2097194
        add r1, r6
        loadb r2, r1
        imm r3, 12
        jeq r2, r3, helper_jmp_target
        jmp reject
helper_jmp_target:
        imm r2, 1
        add r1, r2
        load r2, r1
        jeq r2, r6, helper_ret
        jmp reject
helper_ret:
        imm r1, 2097203
        add r1, r6
        loadb r2, r1
        imm r3, 20
        jeq r2, r3, helper_own_effects
        jmp reject
helper_own_effects:
        mov r0, r6
        imm r1, 24
        add r0, r1
        call mark_effect_owner
        mov r0, r6
        imm r1, 51
        add r0, r1
        call mark_effect_owner
        jmp validate_frame_shapes_init

; Every source procedure has one compiler-synthesized final epilogue.  Entry
; blocks are kind zero; the next entry starts the next procedure region.
validate_fallthrough_init:
        imm r10, 0
validate_fallthrough_loop:
        imm r1, 355
        jlt r10, r1, validate_fallthrough_candidate
        jmp validate_events_init
validate_fallthrough_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, find_next_proc_init
        jmp validate_fallthrough_next
find_next_proc_init:
        mov r11, r10
        imm r1, 1
        add r11, r1
find_next_proc:
        imm r1, 355
        jlt r11, r1, find_next_proc_candidate
        imm r1, 524296
        load r7, r1
        jmp fallthrough_end_ready
find_next_proc_candidate:
        mov r13, r11
        imm r1, 8
        mul r13, r1
        imm r1, 3178496
        add r1, r13
        load r2, r1
        imm r3, 0
        jeq r2, r3, next_proc_found
        imm r1, 1
        add r11, r1
        jmp find_next_proc
next_proc_found:
        imm r1, 3235840
        add r1, r13
        load r7, r1
fallthrough_end_ready:
        imm r1, 1
        sub r7, r1
        mov r14, r7
        call check_epilogue_at_ret
        mov r0, r14
        call mark_effect_owner
validate_fallthrough_next:
        imm r1, 1
        add r10, r1
        jmp validate_fallthrough_loop

validate_events_init:
        imm r10, 0
validate_event_loop:
        imm r1, 612
        jlt r10, r1, validate_event_one
        jmp validate_local_accesses_init
validate_event_one:
        imm r1, 524544
        store r1, r10                    ; preserve source event index across lookup
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7135232
        add r1, r12
        load r14, r1                    ; suggested effect pc
        imm r1, 7086080
        add r1, r12
        load r2, r1                     ; source event kind
        imm r3, 1
        jeq r2, r3, validate_source_call
        imm r3, 2
        jeq r2, r3, validate_source_read
        imm r3, 3
        jeq r2, r3, validate_source_write
        imm r3, 4
        jeq r2, r3, validate_source_emit
        imm r3, 5
        jeq r2, r3, validate_source_return
        jmp reject

validate_source_call:
        call check_call_unstage
        imm r1, 524544
        load r10, r1
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7094272
        add r1, r12
        load r20, r1
        imm r1, 7102464
        add r1, r12
        load r21, r1
        call resolve_proc_pc
        mov r8, r0
        call check_resolved_call_arity
        imm r1, 2097152
        add r1, r14
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, validate_source_call_target
        jmp reject
validate_source_call_target:
        imm r2, 1
        add r1, r2
        load r2, r1
        jeq r2, r8, validate_event_owned
        jmp reject

validate_source_read:
        imm r1, 2097152
        add r1, r14
        loadb r2, r1
        imm r3, 17
        jeq r2, r3, validate_source_read_reg
        jmp reject
validate_source_read_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, validate_event_owned
        jmp reject

validate_source_write:
        imm r1, 2097152
        add r1, r14
        loadb r2, r1
        imm r3, 18
        jeq r2, r3, validate_source_write_reg
        jmp reject
validate_source_write_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, validate_event_owned
        jmp reject

validate_source_return:
        call check_epilogue_at_ret
        jmp validate_event_owned

validate_source_emit:
        call check_emit_at_call
validate_event_owned:
        mov r0, r14
        call mark_effect_owner
        imm r1, 524544
        load r10, r1
        imm r1, 1
        add r10, r1
        jmp validate_event_loop

; r14 names a ret instruction ending an exact 20-byte bc epilogue.
check_epilogue_at_ret:
        imm r1, 19
        jlt r14, r1, reject
        mov r6, r14
        imm r1, 19
        sub r6, r1
        imm r1, 2097152
        add r1, r6
        loadb r2, r1
        imm r3, 2
        jeq r2, r3, epilogue_mov_regs
        jmp reject
epilogue_mov_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 15
        jeq r2, r3, epilogue_mov_fp
        jmp reject
epilogue_mov_fp:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 14
        jeq r2, r3, epilogue_load
        jmp reject
epilogue_load:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 10
        jeq r2, r3, epilogue_load_regs
        jmp reject
epilogue_load_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 14
        jeq r2, r3, epilogue_load_sp
        jmp reject
epilogue_load_sp:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 15
        jeq r2, r3, epilogue_imm
        jmp reject
epilogue_imm:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, epilogue_imm_reg
        jmp reject
epilogue_imm_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 2
        jeq r2, r3, epilogue_imm_value
        jmp reject
epilogue_imm_value:
        imm r2, 1
        add r1, r2
        load r2, r1
        imm r3, 8
        jeq r2, r3, epilogue_add
        jmp reject
epilogue_add:
        imm r2, 8
        add r1, r2
        loadb r2, r1
        imm r3, 3
        jeq r2, r3, epilogue_add_regs
        jmp reject
epilogue_add_regs:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 15
        jeq r2, r3, epilogue_add_r2
        jmp reject
epilogue_add_r2:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 2
        jeq r2, r3, epilogue_ret
        jmp reject
epilogue_ret:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 20
        jeq r2, r3, epilogue_ok
        jmp reject
epilogue_ok:
        ret

; Validate exact `jmp literal; db ...; imm r0,addr; imm r1,len; call helper`
; and compare every decoded source literal byte to the jump-skipped tape bytes.
check_emit_at_call:
        imm r1, 20
        jlt r14, r1, reject
        imm r1, 2097152
        add r1, r14
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, emit_call_target
        jmp reject
emit_call_target:
        imm r2, 1
        add r1, r2
        load r2, r1
        imm r3, 524512
        load r3, r3
        jeq r2, r3, emit_len_imm
        jmp reject
emit_len_imm:
        mov r6, r14
        imm r1, 10
        sub r6, r1                     ; imm r1,len pc
        imm r1, 2097152
        add r1, r6
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, emit_len_reg
        jmp reject
emit_len_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, emit_len_value
        jmp reject
emit_len_value:
        imm r2, 1
        add r1, r2
        load r8, r1                     ; artifact literal length
        mov r12, r10
        imm r2, 8
        mul r12, r2
        imm r2, 7127040
        add r2, r12
        load r3, r2
        jeq r8, r3, emit_addr_imm
        jmp reject
emit_addr_imm:
        mov r6, r14
        imm r1, 20
        sub r6, r1                     ; imm r0,address pc / after literal
        imm r1, 2097152
        add r1, r6
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, emit_addr_reg
        jmp reject
emit_addr_reg:
        imm r2, 1
        add r1, r2
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, emit_addr_value
        jmp reject
emit_addr_value:
        imm r2, 1
        add r1, r2
        load r9, r1                     ; literal tape address
        mov r2, r9
        add r2, r8
        jeq r2, r6, emit_literal_jump
        jmp reject
emit_literal_jump:
        imm r1, 9
        jlt r9, r1, reject
        mov r7, r9
        sub r7, r1                     ; jump pc
        imm r1, 2097152
        add r1, r7
        loadb r2, r1
        imm r3, 12
        jeq r2, r3, emit_literal_jump_target
        jmp reject
emit_literal_jump_target:
        imm r2, 1
        add r1, r2
        load r2, r1
        jeq r2, r6, emit_compare_init
        jmp reject
emit_compare_init:
        imm r1, 7110656
        add r1, r12
        load r20, r1                    ; encoded source offset
        imm r1, 7118848
        add r1, r12
        load r21, r1                    ; encoded source length
        imm r22, 0                      ; encoded cursor
        imm r23, 0                      ; decoded/tape cursor
emit_compare_loop:
        jlt r22, r21, emit_compare_source_byte
        jeq r23, r8, emit_compare_done
        jmp reject
emit_compare_source_byte:
        imm r1, 1048576
        add r1, r20
        add r1, r22
        loadb r24, r1
        imm r1, 92
        jeq r24, r1, emit_compare_escape
        jmp emit_compare_tape
emit_compare_escape:
        imm r1, 1
        add r22, r1
        jlt r22, r21, emit_compare_escape_byte
        jmp reject
emit_compare_escape_byte:
        imm r1, 1048576
        add r1, r20
        add r1, r22
        loadb r24, r1
        imm r1, 110
        jeq r24, r1, emit_escape_n
        imm r1, 116
        jeq r24, r1, emit_escape_t
        imm r1, 114
        jeq r24, r1, emit_escape_r
        imm r1, 48
        jeq r24, r1, emit_escape_zero
        imm r1, 92
        jeq r24, r1, emit_escape_backslash
        imm r1, 39
        jeq r24, r1, emit_escape_quote_single
        imm r1, 34
        jeq r24, r1, emit_escape_quote_double
        jmp reject
emit_escape_n:
        imm r24, 10
        jmp emit_compare_tape
emit_escape_t:
        imm r24, 9
        jmp emit_compare_tape
emit_escape_r:
        imm r24, 13
        jmp emit_compare_tape
emit_escape_zero:
        imm r24, 0
        jmp emit_compare_tape
emit_escape_backslash:
        imm r24, 92
        jmp emit_compare_tape
emit_escape_quote_single:
        imm r24, 39
        jmp emit_compare_tape
emit_escape_quote_double:
        imm r24, 34
emit_compare_tape:
        imm r1, 2097152
        add r1, r9
        add r1, r23
        loadb r25, r1
        jeq r24, r25, emit_compare_next
        jmp reject
emit_compare_next:
        imm r1, 1
        add r22, r1
        add r23, r1
        jmp emit_compare_loop
emit_compare_done:
        ; The address immediate is compiler-generated by emit lowering, not a
        ; Beta expression literal. Reserve it for the exhaustive BCT7 scan.
        mov r0, r6
        call mark_expr_synthetic_literal
        ret

; Mark one artifact effect instruction as owned, rejecting aliases.
mark_effect_owner:
        imm r1, 6815744
        add r1, r0
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, mark_effect_owner_now
        jmp reject
mark_effect_owner_now:
        imm r2, 1
        storeb r1, r2
        ret

; Require exact ownership of every decoded effect opcode.  Inline emit data is
; coverage zero and is deliberately checked by the emit macro above instead.
scan_owned_effects_init:
        imm r10, 0                     ; tape pc
        imm r11, 0                     ; halt
        imm r12, 0                     ; read
        imm r13, 0                     ; write
        imm r14, 0                     ; call
        imm r15, 0                     ; ret
scan_owned_effects_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, scan_owned_effects_pc
        jmp scan_owned_effects_counts
scan_owned_effects_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, scan_owned_effects_opcode
        jmp scan_owned_effects_next
scan_owned_effects_opcode:
        imm r1, 2097152
        add r1, r10
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, scan_owned_halt
        imm r3, 17
        jeq r2, r3, scan_owned_read
        imm r3, 18
        jeq r2, r3, scan_owned_write
        imm r3, 19
        jeq r2, r3, scan_owned_call
        imm r3, 20
        jeq r2, r3, scan_owned_ret
        jmp scan_owned_effects_next
scan_owned_halt:
        imm r1, 1
        add r11, r1
        jmp require_current_owner
scan_owned_read:
        imm r1, 1
        add r12, r1
        jmp require_current_owner
scan_owned_write:
        imm r1, 1
        add r13, r1
        jmp require_current_owner
scan_owned_call:
        imm r1, 1
        add r14, r1
        jmp require_current_owner
scan_owned_ret:
        imm r1, 1
        add r15, r1
require_current_owner:
        imm r1, 6815744
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, scan_owned_effects_next
        jmp reject
scan_owned_effects_next:
        imm r1, 1
        add r10, r1
        jmp scan_owned_effects_loop
scan_owned_effects_counts:
        imm r1, 1
        jeq r11, r1, scan_owned_read_count
        jmp reject
scan_owned_read_count:
        imm r1, 2
        jeq r12, r1, scan_owned_write_count
        jmp reject
scan_owned_write_count:
        imm r1, 6
        jeq r13, r1, scan_owned_call_count
        jmp reject
scan_owned_call_count:
        imm r1, 423
        jeq r14, r1, scan_owned_ret_count
        jmp reject
scan_owned_ret_count:
        imm r1, 254
        jeq r15, r1, accept
        jmp reject

; Resolve source name r20/r21 to the unique procedure-entry block pc.
resolve_proc_pc:
        imm r10, 0
resolve_proc_loop:
        imm r1, 355
        jlt r10, r1, resolve_proc_candidate
        jmp reject
resolve_proc_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, resolve_proc_name
        jmp resolve_proc_next
resolve_proc_name:
        imm r1, 3149824
        add r1, r12
        load r22, r1
        imm r1, 3153920
        add r1, r12
        load r23, r1
        call names_equal
        imm r1, 1
        jeq r0, r1, resolve_proc_found
resolve_proc_next:
        imm r1, 1
        add r10, r1
        jmp resolve_proc_loop
resolve_proc_found:
        imm r1, 3145728
        add r1, r12
        load r2, r1
        imm r1, 524600
        store r1, r2                    ; resolved source callee procedure index
        imm r1, 3235840
        add r1, r12
        load r0, r1
        ret

; Locate the source procedure literally named `main`.
find_main_pc:
        imm r10, 0
find_main_loop:
        imm r1, 355
        jlt r10, r1, find_main_candidate
        jmp reject
find_main_candidate:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, find_main_name
        jmp find_main_next
find_main_name:
        imm r1, 3149824
        add r1, r12
        load r20, r1
        imm r1, 3153920
        add r1, r12
        load r21, r1
        imm r22, 4
        imm r23, literal_main
        call source_name_equals_literal
        imm r1, 1
        jeq r0, r1, find_main_found
find_main_next:
        imm r1, 1
        add r10, r1
        jmp find_main_loop
find_main_found:
        imm r1, 3235840
        add r1, r12
        load r0, r1
        ret

; Source name r20/r21 versus checker-tape literal r23 of length r22.
source_name_equals_literal:
        jeq r21, r22, source_literal_init
        imm r0, 0
        ret
source_literal_init:
        imm r24, 0
source_literal_loop:
        jlt r24, r21, source_literal_byte
        imm r0, 1
        ret
source_literal_byte:
        imm r1, 1048576
        add r1, r20
        add r1, r24
        loadb r2, r1
        mov r1, r23
        add r1, r24
        loadb r3, r1
        jeq r2, r3, source_literal_next
        imm r0, 0
        ret
source_literal_next:
        imm r1, 1
        add r24, r1
        jmp source_literal_loop

ident_is_return:
        imm r20, 6
        imm r21, literal_return
        jmp current_ident_equals_literal
ident_is_read_byte:
        imm r20, 9
        imm r21, literal_read_byte
        jmp current_ident_equals_literal
ident_is_write_byte:
        imm r20, 10
        imm r21, literal_write_byte
        jmp current_ident_equals_literal
ident_is_emit:
        imm r20, 4
        imm r21, literal_emit

; Compare current IOFF/ILEN against checker-tape literal r21, length r20.
current_ident_equals_literal:
        imm r1, 524368
        load r2, r1
        jeq r2, r20, current_literal_init
        imm r0, 0
        ret
current_literal_init:
        imm r1, 524360
        load r2, r1
        imm r22, 0
current_literal_loop:
        jlt r22, r20, current_literal_byte
        imm r0, 1
        ret
current_literal_byte:
        imm r1, 1048576
        add r1, r2
        add r1, r22
        loadb r3, r1
        mov r1, r21
        add r1, r22
        loadb r4, r1
        jeq r3, r4, current_literal_next
        imm r0, 0
        ret
current_literal_next:
        imm r1, 1
        add r22, r1
        jmp current_literal_loop

; Unreachable checker constants.
literal_return:
        db "return"
literal_read_byte:
        db "read_byte"
literal_write_byte:
        db "write_byte"
literal_emit:
        db "emit"
literal_main:
        db "main"
