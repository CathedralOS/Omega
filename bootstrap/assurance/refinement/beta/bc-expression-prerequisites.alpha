; Lower-rooted prerequisite join for the expression SCC.
;
; This orchestration calls the existing modular theorem bodies directly so it
; can compose them after Checker E without following their terminal checker-A/B
; continuations.  Name-query and bounded-emitter modules intentionally reuse
; private cells 531880..<532376 in their original independent checkers.  Here
; LOOK is consumed and exported to fresh cell 540008 before the bounded family
; resets that private range.  The final XPRQ token is therefore an ordered
; consequence of both complete proofs rather than a copied unchecked marker.

expression_prerequisites_init:
        call expression_require_label_family
        call expression_prove_lexical_prerequisites
        call expression_prove_literal_prerequisites
        call expression_prove_name_prerequisites
        call expression_export_lookup
        call expression_prove_bounded_emitters
        call expression_publish_prerequisites
        jmp expression_semantic_rules_init

expression_require_label_family:
        imm r20, 540000
        imm r21, 1414677848             ; XPRX
        call exact_require_cell
        imm r20, 534880
        imm r21, 1263547717             ; E5PK
        call exact_require_cell
        ret

expression_prove_lexical_prerequisites:
        call classifier_require_shape
        call classifier_prove_byte_domain
        call read_ident_require_shape
        call read_ident_prove_summary
        call emit_ident_require_shape
        call emit_ident_prove_summary
        call expression_id_char_require_shape
        call expression_id_char_prove_summary
        call fixed_keyword_require_shape
        call fixed_keyword_prove_byte_cases
        call fixed_keyword_prove_summary
        ret

expression_prove_literal_prerequisites:
        call literal_skip_prove_extended_adv
        call parse_number_require_shape
        call parse_number_prove_summary
        call parse_char_require_shape
        call parse_char_prove_summary
        call operator_classifier_require_shape
        call operator_classifier_prove_summary
        call cmp_op_require_shape
        call cmp_op_prove_summary
        ret

expression_prove_name_prerequisites:
        ; SPNE is a checker-private conditional name-domain root, not a dynamic
        ; claim that main has already populated the table.
        imm r1, 531840
        imm r2, 1162760275             ; SPNE
        store r1, r2
        imm r20, 531840
        imm r21, 1162760275
        call exact_require_cell
        call name_table_domain_reset
        call name_table_require_load_classes
        call name_table_prove_address_sweep
        call name_table_introduce_relations
        call name_table_publish

        call name_eq_require_shape
        call name_eq_require_data_shape
        call name_eq_require_imports
        call name_eq_summary_reset
        call name_eq_introduce_entry
        call name_eq_prove_length_mismatch
        call name_eq_introduce_equal_length
        call name_eq_prove_byte_mismatch
        call name_eq_prove_equal_step
        call name_eq_prove_full_match
        call name_eq_publish

        imm r1, 532136
        imm r2, 1112887120             ; LUPB
        store r1, r2
        call lookup_require_shape
        call lookup_require_data_shape
        call lookup_require_imports
        call lookup_summary_reset
        call lookup_introduce_entry
        call lookup_prove_hit_zero
        call lookup_prove_hit_positive
        call lookup_prove_miss_step
        call lookup_prove_exhausted
        call lookup_publish
        ret

expression_export_lookup:
        imm r20, 531848
        imm r21, 1296323662             ; NTDM
        call exact_require_cell
        imm r20, 531952
        imm r21, 1397839182             ; NEQS
        call exact_require_cell
        imm r20, 532144
        imm r21, 1263488844             ; LOOK
        call exact_require_cell
        imm r1, 540008
        imm r2, 1263488844             ; exported LOOK
        store r1, r2
        ret

expression_prove_bounded_emitters:
        ; Rebuild bounded DECS after full-Word DECW.  The two theorems use
        ; disjoint cells and express deliberately different source behavior.
        call emit_dec_require_shape
        call emit_dec_prove_summary
        imm r20, 528320
        imm r21, 1396917572             ; DECS
        call exact_require_cell
        imm r1, 531872
        imm r2, 1161966148             ; D2BE
        store r1, r2

        call bounded_emitters_require_shape
        call bounded_emitters_reset_public
        call bounded_emitters_require_imports
        call bounded_emitters_sweep_domains
        call bounded_prove_gen_read_byte
        call bounded_prove_emit_pop_into
        call bounded_prove_emit_push
        call bounded_prove_emit_mnemonic
        call bounded_prove_emit_combine
        call bounded_prove_emit_slot_addr
        call bounded_prove_emit_load_slot
        call bounded_prove_emit_store_slot
        call bounded_emitters_publish_family
        ret

expression_publish_prerequisites:
        imm r20, 540008
        imm r21, 1263488844             ; exported LOOK
        call exact_require_cell
        imm r20, 526680
        imm r21, 1413631041             ; ALBT
        call exact_require_cell
        imm r20, 526792
        imm r21, 1396984146             ; RIDS
        call exact_require_cell
        imm r20, 528192
        imm r21, 1396984133             ; EIDS
        call exact_require_cell
        imm r20, 529144
        imm r21, 1297436240             ; PNUM
        call exact_require_cell
        imm r20, 529416
        imm r21, 1380467536             ; PCHR
        call exact_require_cell
        imm r20, 529816
        imm r21, 1280658767             ; OMUL
        call exact_require_cell
        imm r20, 529824
        imm r21, 1145323855             ; OADD
        call exact_require_cell
        imm r20, 529952
        imm r21, 1347374403             ; CMOP
        call exact_require_cell
        imm r20, 530456
        imm r21, 1398231878             ; FKWS
        call exact_require_cell
        imm r20, 532120
        imm r21, 1397572930             ; BEMS
        call exact_require_cell
        imm r20, 532560
        imm r21, 1464026436             ; DECW
        call exact_require_cell
        imm r20, 534856
        imm r21, 1397572935             ; GEMS
        call exact_require_cell
        imm r20, 534864
        imm r21, 1347240773             ; ECMP
        call exact_require_cell
        imm r1, 540016
        imm r2, 1364349016             ; XPRQ
        store r1, r2
        imm r20, 540016
        imm r21, 1364349016
        call exact_require_cell
        ret
