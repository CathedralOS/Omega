; Raw byte/word memory-site custody for the whole-bc BCT5 checker.
;
; Source sites are classified by matching brackets without consuming their
; address/value expressions from the outer scan. Metadata starts at 7602176;
; canonical witness PCs start at 7626752; its owner map starts at 7634944,
; beyond the local-access owner map's full 262,140-byte extent.

ident_is_byte:
        imm r20, 4
        imm r21, literal_byte
        jmp current_ident_equals_literal
ident_is_word:
        imm r20, 4
        imm r21, literal_word
        jmp current_ident_equals_literal

literal_byte:
        db "byte"
literal_word:
        db "word"

; Current cursor follows byte/word and r7 is width 1/8.
record_memory_site:
        imm r1, 524304
        load r2, r1
        imm r1, 524688
        store r1, r2
        call skip_trivia
        call current_byte
        imm r1, 91
        jeq r0, r1, memory_bracket_open
        ; Exact byte/word identifiers not used as memory forms are not sites.
        jmp restore_memory_cursor_without_site
memory_bracket_open:
        call advance_one
        imm r8, 1                       ; bracket depth
memory_bracket_scan:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 34
        jeq r0, r1, memory_bracket_string
        imm r1, 39
        jeq r0, r1, memory_bracket_char
        imm r1, 59
        jeq r0, r1, memory_bracket_comment
        imm r1, 91
        jeq r0, r1, memory_bracket_nested
        imm r1, 93
        jeq r0, r1, memory_bracket_close
        call advance_one
        jmp memory_bracket_scan
memory_bracket_nested:
        imm r1, 1
        add r8, r1
        call advance_one
        jmp memory_bracket_scan
memory_bracket_close:
        imm r1, 1
        sub r8, r1
        call advance_one
        imm r2, 0
        jeq r8, r2, classify_memory_site
        jmp memory_bracket_scan
classify_memory_site:
        call skip_trivia
        call current_byte
        imm r1, 61
        jeq r0, r1, memory_maybe_store
        imm r6, 1
        call add_memory_site
        jmp restore_memory_cursor
memory_maybe_store:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, memory_comparison_load
        imm r6, 2
        call add_memory_site
        jmp restore_memory_cursor
memory_comparison_load:
        imm r6, 1
        call add_memory_site
restore_memory_cursor:
        imm r1, 524688
        load r2, r1
        imm r1, 524304
        store r1, r2
        ret
restore_memory_cursor_without_site:
        imm r1, 524688
        load r2, r1
        imm r1, 524304
        store r1, r2
        ret

memory_bracket_string:
        call advance_one
memory_bracket_string_loop:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 92
        jeq r0, r1, memory_bracket_string_escape
        imm r1, 34
        jeq r0, r1, memory_bracket_string_end
        call advance_one
        jmp memory_bracket_string_loop
memory_bracket_string_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        jmp memory_bracket_string_loop
memory_bracket_string_end:
        call advance_one
        jmp memory_bracket_scan
memory_bracket_char:
        call advance_one
        call current_byte
        imm r1, 92
        jeq r0, r1, memory_bracket_char_escape
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
        jmp memory_bracket_char_close
memory_bracket_char_escape:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        call advance_one
memory_bracket_char_close:
        call current_byte
        imm r1, 39
        jeq r0, r1, memory_bracket_char_end
        jmp reject
memory_bracket_char_end:
        call advance_one
        jmp memory_bracket_scan
memory_bracket_comment:
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 10
        jeq r0, r1, memory_bracket_scan
        call advance_one
        jmp memory_bracket_comment

add_memory_site:
        imm r1, 524648
        load r2, r1
        imm r3, 256
        jlt r2, r3, add_memory_site_room
        jmp reject
add_memory_site_room:
        mov r4, r2
        imm r5, 8
        mul r4, r5
        imm r5, 524352
        load r9, r5
        imm r5, 7602176
        add r5, r4
        store r5, r9                    ; source block
        imm r5, 7610368
        add r5, r4
        store r5, r6                    ; load/store kind
        imm r5, 7618560
        add r5, r4
        store r5, r7                    ; byte width
        imm r3, 1
        add r2, r3
        imm r1, 524648
        store r1, r2
        imm r1, 1
        jeq r6, r1, count_memory_site_load
        imm r1, 2
        jeq r6, r1, count_memory_site_store
        jmp reject
count_memory_site_load:
        imm r1, 524656
        jmp increment_memory_kind
count_memory_site_store:
        imm r1, 524664
increment_memory_kind:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        imm r1, 1
        jeq r7, r1, count_memory_site_byte
        imm r1, 8
        jeq r7, r1, count_memory_site_word
        jmp reject
count_memory_site_byte:
        imm r1, 524672
        jmp increment_memory_width
count_memory_site_word:
        imm r1, 524680
increment_memory_width:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

read_memory_site_pcs_init:
        imm r10, 0
read_memory_site_pc:
        imm r1, 95
        jlt r10, r1, read_memory_site_pc_one
        jmp read_expr_primitive_pcs_init
read_memory_site_pc_one:
        call read_u32
        mov r14, r0
        imm r1, 524296
        load r2, r1
        jlt r14, r2, memory_site_pc_covered
        jmp reject
memory_site_pc_covered:
        imm r1, 4194304
        add r1, r14
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, memory_site_pc_block
        jmp reject
memory_site_pc_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7602176
        add r1, r12
        load r4, r1
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r6, r1
        jlt r14, r6, reject
        imm r1, 1
        add r4, r1
        imm r1, 355
        jlt r4, r1, memory_site_pc_next_block
        imm r1, 524296
        load r7, r1
        jmp memory_site_pc_end_ready
memory_site_pc_next_block:
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r7, r1
memory_site_pc_end_ready:
        jlt r14, r7, memory_site_pc_store
        jmp reject
memory_site_pc_store:
        imm r1, 7626752
        add r1, r12
        store r1, r14
        imm r1, 1
        add r10, r1
        jmp read_memory_site_pc

validate_memory_sites_init:
        imm r10, 0
validate_memory_site_loop:
        imm r1, 95
        jlt r10, r1, validate_memory_site_one
        jmp validate_expr_primitives_init
validate_memory_site_one:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7626752
        add r1, r12
        load r14, r1
        imm r1, 7634944
        add r1, r14
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, own_memory_site
        jmp reject
own_memory_site:
        imm r2, 1
        storeb r1, r2
        imm r1, 7610368
        add r1, r12
        load r8, r1
        imm r1, 7618560
        add r1, r12
        load r9, r1
        imm r1, 1
        jeq r8, r1, validate_memory_load
        imm r1, 2
        jeq r8, r1, validate_memory_store
        jmp reject

validate_memory_load:
        imm r1, 1
        jeq r9, r1, validate_memory_load_byte
        imm r1, 8
        jeq r9, r1, validate_memory_load_word
        jmp reject
validate_memory_load_byte:
        imm r21, 8
        jmp validate_memory_load_opcode
validate_memory_load_word:
        imm r21, 10
validate_memory_load_opcode:
        mov r20, r14
        call require_tape_byte
        mov r20, r14
        imm r1, 1
        add r20, r1
        imm r21, 0
        call require_tape_byte
        mov r20, r14
        imm r1, 2
        add r20, r1
        imm r21, 0
        call require_tape_byte
        jmp validate_memory_site_next

validate_memory_store:
        imm r1, 16
        jlt r14, r1, reject
        mov r6, r14
        sub r6, r1
        ; exact pop of the evaluated address into r1
        mov r20, r6
        imm r21, 10
        call require_tape_byte
        mov r20, r6
        imm r1, 1
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r6
        imm r1, 2
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r6
        imm r1, 3
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r6
        imm r1, 4
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r6
        imm r1, 5
        add r20, r1
        imm r21, 8
        call require_tape_word
        mov r20, r6
        imm r1, 13
        add r20, r1
        imm r21, 3
        call require_tape_byte
        mov r20, r6
        imm r1, 14
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r6
        imm r1, 15
        add r20, r1
        imm r21, 5
        call require_tape_byte
        imm r1, 1
        jeq r9, r1, validate_memory_store_byte
        imm r1, 8
        jeq r9, r1, validate_memory_store_word
        jmp reject
validate_memory_store_byte:
        imm r21, 9
        jmp validate_memory_store_opcode
validate_memory_store_word:
        imm r21, 11
validate_memory_store_opcode:
        mov r20, r14
        call require_tape_byte
        mov r20, r14
        imm r1, 1
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r14
        imm r1, 2
        add r20, r1
        imm r21, 0
        call require_tape_byte

validate_memory_site_next:
        imm r1, 1
        add r10, r1
        jmp validate_memory_site_loop
