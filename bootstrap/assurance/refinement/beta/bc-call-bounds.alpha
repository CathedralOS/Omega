; Source-derived dynamic call/data-stack certificate for exact bc.beta.
;
; This BCT9 phase runs in the same Alpha process as the complete BCT8 source,
; artifact, frame, effect, and expression-composition checks.  Its producer
; supplies only finite summary potentials.  This checker reconstructs every
; caller/callee edge, frame weight, call-site temporary height, local temporary
; peak, and emit-helper call independently, then checks the potential equations
; itself.  The two counter-guarded recursive phases are unrolled for all 64
; admitted activations; depth zero explicitly charges the rejected 65th callee
; prologue.  emit_dec's signed-positive /10 rank is checked separately.
;
; Potential tables contain u32 byte/return bounds in depth-major, proc-minor
; order.  A summary includes the current procedure's explicit frame and its
; incoming hidden return address.

call_bounds_read_init:
        call read_u32
        imm r1, 961758018              ; little-endian BCS9
        jeq r0, r1, call_bounds_read_expr_explicit
        jmp reject
call_bounds_read_expr_explicit:
        imm r20, 10051584
        imm r21, 4544                  ; 64 * 71
        call call_bounds_read_table
        imm r20, 10087936
        imm r21, 4544
        call call_bounds_read_table
        imm r20, 10124288
        imm r21, 4544
        call call_bounds_read_table
        imm r20, 10160640
        imm r21, 4544
        call call_bounds_read_table
        imm r20, 10196992
        imm r21, 71
        call call_bounds_read_table
        imm r20, 10197560
        imm r21, 71
        call call_bounds_read_table
        read r0
        imm r1, 0
        jlt r0, r1, validate_prelude
        jmp reject

; Read r21 little-endian u32 cells into word table r20.
call_bounds_read_table:
        imm r10, 0
call_bounds_read_table_loop:
        jlt r10, r21, call_bounds_read_table_cell
        ret
call_bounds_read_table_cell:
        call read_u32
        mov r2, r10
        imm r3, 8
        mul r2, r3
        add r2, r20
        store r2, r0
        imm r3, 1
        add r10, r3
        jmp call_bounds_read_table_loop

call_bounds_resolve_specials:
        imm r20, call_bounds_literal_gen_expr
        imm r21, 8
        call call_bounds_find_proc
        imm r1, 524960
        store r1, r0
        imm r20, call_bounds_literal_gen_stmts
        imm r21, 9
        call call_bounds_find_proc
        imm r1, 524968
        store r1, r0
        imm r20, call_bounds_literal_emit_dec
        imm r21, 8
        call call_bounds_find_proc
        imm r1, 524976
        store r1, r0
        imm r20, literal_main
        imm r21, 4
        call call_bounds_find_proc
        imm r1, 524984
        store r1, r0
        call call_bounds_validate_special_frames
        call call_bounds_require_rank_schemas
        jmp call_bounds_build_edges_init

; Find the unique procedure-entry block whose source name equals r20/r21.
call_bounds_find_proc:
        mov r25, r20
        mov r26, r21
        imm r27, 0                     ; matches
        imm r28, 0                     ; result
        imm r10, 0
call_bounds_find_proc_loop:
        imm r1, 359
        jlt r10, r1, call_bounds_find_proc_block
        imm r1, 1
        jeq r27, r1, call_bounds_find_proc_done
        jmp reject
call_bounds_find_proc_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 3178496
        add r1, r12
        load r2, r1
        imm r3, 0
        jeq r2, r3, call_bounds_find_proc_name
        jmp call_bounds_find_proc_next
call_bounds_find_proc_name:
        imm r1, 3149824
        add r1, r12
        load r20, r1
        imm r1, 3153920
        add r1, r12
        load r21, r1
        mov r22, r26
        mov r23, r25
        call source_name_equals_literal
        imm r1, 1
        jeq r0, r1, call_bounds_find_proc_match
        jmp call_bounds_find_proc_next
call_bounds_find_proc_match:
        add r27, r1
        imm r1, 3145728
        add r1, r12
        load r28, r1
call_bounds_find_proc_next:
        imm r1, 1
        add r10, r1
        jmp call_bounds_find_proc_loop
call_bounds_find_proc_done:
        mov r0, r28
        ret

call_bounds_validate_special_frames:
        imm r1, 524960
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 24
        jeq r0, r1, call_bounds_frame_stmts
        jmp reject
call_bounds_frame_stmts:
        imm r1, 524968
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, call_bounds_frame_emit_dec
        jmp reject
call_bounds_frame_emit_dec:
        imm r1, 524976
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, call_bounds_special_frames_done
        jmp reject
call_bounds_special_frames_done:
        ; The grammar traversal independently measured these exact local peaks.
        imm r1, 524960
        load r20, r1
        imm r21, 2
        call call_bounds_require_proc_peak
        imm r1, 524968
        load r20, r1
        imm r21, 2
        call call_bounds_require_proc_peak
        imm r1, 524976
        load r20, r1
        imm r21, 1
        call call_bounds_require_proc_peak
        ret

call_bounds_require_proc_peak:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 10043392
        add r1, r2
        load r2, r1
        jeq r2, r21, call_bounds_require_proc_peak_ok
        jmp reject
call_bounds_require_proc_peak_ok:
        ret

; Procedure r20 -> exact checked prologue bytes, including saved fp.
call_bounds_frame_bytes:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7159808
        add r1, r2
        load r0, r1
        imm r1, 1
        add r0, r1
        imm r1, 8
        mul r0, r1
        ret

; The exact function bodies are frozen ranking schemas.  Their component
; loads/stores/comparisons/divisions/calls are already bound to the decoded
; artifact by the preceding phases; matching the full source slices closes the
; local induction used by this finite call-bound certificate.
call_bounds_require_rank_schemas:
        imm r20, call_bounds_schema_emit_dec
        imm r21, 171
        call call_bounds_require_source_once
        imm r20, call_bounds_schema_gen_expr
        imm r21, 523
        call call_bounds_require_source_once
        imm r20, call_bounds_schema_gen_stmts
        imm r21, 702
        call call_bounds_require_source_once
        ret

; Require embedded literal r20/r21 to occur exactly once in the source blob.
call_bounds_require_source_once:
        mov r25, r20
        mov r26, r21
        imm r27, 0
        imm r10, 0
call_bounds_source_once_loop:
        imm r1, 524288
        load r2, r1
        mov r3, r10
        add r3, r26
        jlt r2, r3, call_bounds_source_once_done
        imm r11, 0
call_bounds_source_once_compare:
        jlt r11, r26, call_bounds_source_once_byte
        imm r1, 1
        add r27, r1
        jmp call_bounds_source_once_next
call_bounds_source_once_byte:
        imm r1, 1048576
        add r1, r10
        add r1, r11
        loadb r2, r1
        mov r1, r25
        add r1, r11
        loadb r3, r1
        jeq r2, r3, call_bounds_source_once_byte_next
        jmp call_bounds_source_once_next
call_bounds_source_once_byte_next:
        imm r1, 1
        add r11, r1
        jmp call_bounds_source_once_compare
call_bounds_source_once_next:
        imm r1, 1
        add r10, r1
        jmp call_bounds_source_once_loop
call_bounds_source_once_done:
        imm r1, 1
        jeq r27, r1, call_bounds_source_once_ok
        jmp reject
call_bounds_source_once_ok:
        ret

; Reconstruct compact ordinary-call edges and per-procedure emit-helper flags.
call_bounds_build_edges_init:
        imm r0, 0
        imm r1, 525008
        store r1, r0
        imm r10, 0
call_bounds_build_edges_loop:
        imm r1, 617
        jlt r10, r1, call_bounds_build_event
        imm r1, 525008
        load r2, r1
        imm r3, 311
        jeq r2, r3, call_bounds_validate_emit_dec_edges
        jmp reject
call_bounds_build_event:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7086080
        add r1, r2
        load r3, r1
        imm r1, 1
        jeq r3, r1, call_bounds_build_ordinary
        imm r1, 4
        jeq r3, r1, call_bounds_mark_emit
        jmp call_bounds_build_event_next
call_bounds_mark_emit:
        imm r1, 7077888
        add r1, r2
        load r3, r1                    ; block
        imm r1, 8
        mul r3, r1
        imm r1, 3145728
        add r1, r3
        load r4, r1                    ; proc
        imm r1, 8
        mul r4, r1
        imm r1, 10248192
        add r1, r4
        imm r3, 1
        store r1, r3
        jmp call_bounds_build_event_next
call_bounds_build_ordinary:
        imm r1, 525000
        store r1, r10
        ; Caller from the event's source block.
        imm r1, 7077888
        add r1, r2
        load r3, r1
        imm r1, 8
        mul r3, r1
        imm r1, 3145728
        add r1, r3
        load r7, r1
        ; Resolve the exact callee source name.
        imm r1, 7094272
        add r1, r2
        load r20, r1
        imm r1, 7102464
        add r1, r2
        load r21, r1
        call resolve_proc_pc
        imm r1, 524600
        load r8, r1
        imm r1, 525008
        load r9, r1
        mov r2, r9
        imm r1, 8
        mul r2, r1
        imm r1, 10223616
        add r1, r2
        store r1, r7
        imm r1, 10231808
        add r1, r2
        store r1, r8
        imm r1, 525000
        load r10, r1
        mov r3, r10
        imm r1, 8
        mul r3, r1
        imm r1, 10035200
        add r1, r3
        load r4, r1
        imm r1, 2
        jlt r1, r4, reject             ; global grammar peak is two words
        imm r1, 10240000
        add r1, r2
        store r1, r4
        imm r1, 1
        add r9, r1
        imm r1, 525008
        store r1, r9
call_bounds_build_event_next:
        imm r1, 1
        add r10, r1
        jmp call_bounds_build_edges_loop

; emit_dec has exactly one ordinary edge, to itself, with no temp live at call.
call_bounds_validate_emit_dec_edges:
        imm r10, 0
        imm r11, 0
call_bounds_emit_dec_edge_loop:
        imm r1, 311
        jlt r10, r1, call_bounds_emit_dec_edge
        imm r1, 1
        jeq r11, r1, call_bounds_flags_init
        jmp reject
call_bounds_emit_dec_edge:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 10223616
        add r1, r2
        load r3, r1
        imm r1, 524976
        load r4, r1
        jeq r3, r4, call_bounds_emit_dec_caller
        jmp call_bounds_emit_dec_edge_next
call_bounds_emit_dec_caller:
        imm r1, 10231808
        add r1, r2
        load r3, r1
        jeq r3, r4, call_bounds_emit_dec_ambient
        jmp reject
call_bounds_emit_dec_ambient:
        imm r1, 10240000
        add r1, r2
        load r3, r1
        imm r1, 0
        jeq r3, r1, call_bounds_emit_dec_count
        jmp reject
call_bounds_emit_dec_count:
        imm r1, 1
        add r11, r1
call_bounds_emit_dec_edge_next:
        imm r1, 1
        add r10, r1
        jmp call_bounds_emit_dec_edge_loop

; Compute the three stopped-call reachability closures.  Expression stops at
; gen_expr/emit_dec and rejects a path into gen_stmts.  Block stops at
; gen_stmts/gen_expr/emit_dec.  Root stops at all three summaries.
call_bounds_flags_init:
        imm r1, 524960
        load r2, r1
        imm r20, 10248752              ; expression flags
        call call_bounds_set_flag
        imm r1, 524968
        load r2, r1
        imm r20, 10249320              ; block flags
        call call_bounds_set_flag
        imm r1, 524984
        load r2, r1
        imm r20, 10249888              ; root flags
        call call_bounds_set_flag
        imm r10, 0
call_bounds_flags_pass:
        imm r1, 71
        jlt r10, r1, call_bounds_flags_edges_init
        jmp call_bounds_check_expr_init
call_bounds_flags_edges_init:
        imm r11, 0
call_bounds_flags_edge_loop:
        imm r1, 311
        jlt r11, r1, call_bounds_flags_edge
        imm r1, 1
        add r10, r1
        jmp call_bounds_flags_pass
call_bounds_flags_edge:
        mov r2, r11
        imm r1, 8
        mul r2, r1
        imm r1, 10223616
        add r1, r2
        load r7, r1                    ; caller
        imm r1, 10231808
        add r1, r2
        load r8, r1                    ; callee
        imm r20, 10248752
        call call_bounds_propagate_expr
        imm r20, 10249320
        call call_bounds_propagate_stopped
        imm r20, 10249888
        call call_bounds_propagate_stopped
        imm r1, 1
        add r11, r1
        jmp call_bounds_flags_edge_loop

call_bounds_set_flag:
        mov r3, r2
        imm r1, 8
        mul r3, r1
        add r3, r20
        imm r1, 1
        store r3, r1
        ret

call_bounds_propagate_expr:
        mov r3, r7
        imm r1, 8
        mul r3, r1
        add r3, r20
        load r4, r3
        imm r1, 1
        jeq r4, r1, call_bounds_expr_caller_live
        ret
call_bounds_expr_caller_live:
        imm r1, 524968
        load r4, r1
        jeq r8, r4, reject
        imm r1, 524960
        load r4, r1
        jeq r8, r4, call_bounds_propagate_done
        imm r1, 524976
        load r4, r1
        jeq r8, r4, call_bounds_propagate_done
        mov r2, r8
        call call_bounds_set_flag
call_bounds_propagate_done:
        ret

call_bounds_propagate_stopped:
        mov r3, r7
        imm r1, 8
        mul r3, r1
        add r3, r20
        load r4, r3
        imm r1, 1
        jeq r4, r1, call_bounds_stopped_caller_live
        ret
call_bounds_stopped_caller_live:
        imm r1, 524960
        load r4, r1
        jeq r8, r4, call_bounds_propagate_done
        imm r1, 524968
        load r4, r1
        jeq r8, r4, call_bounds_propagate_done
        imm r1, 524976
        load r4, r1
        jeq r8, r4, call_bounds_propagate_done
        mov r2, r8
        call call_bounds_set_flag
        ret

; Check all expression depth rows, then block rows, then the root row.
call_bounds_check_expr_init:
        imm r0, 1
        imm r1, 525032
        store r1, r0                    ; phase
        imm r0, 0
        imm r1, 525016
        store r1, r0                    ; depth
call_bounds_check_expr_depth:
        imm r1, 525016
        load r2, r1
        imm r3, 64
        jlt r2, r3, call_bounds_check_phase_proc_init
        jmp call_bounds_check_block_init
call_bounds_check_block_init:
        imm r0, 2
        imm r1, 525032
        store r1, r0
        imm r0, 0
        imm r1, 525016
        store r1, r0
call_bounds_check_block_depth:
        imm r1, 525016
        load r2, r1
        imm r3, 64
        jlt r2, r3, call_bounds_check_phase_proc_init
        jmp call_bounds_check_root_init
call_bounds_check_root_init:
        imm r0, 3
        imm r1, 525032
        store r1, r0
        imm r0, 0
        imm r1, 525016
        store r1, r0
        jmp call_bounds_check_phase_proc_init

call_bounds_check_phase_proc_init:
        imm r0, 0
        imm r1, 525024
        store r1, r0
call_bounds_check_phase_proc_loop:
        imm r1, 525024
        load r2, r1
        imm r3, 71
        jlt r2, r3, call_bounds_check_phase_proc
        jmp call_bounds_check_phase_row_done
call_bounds_check_phase_proc:
        ; Select phase flag and supplied pair.
        imm r1, 525032
        load r20, r1
        imm r1, 525016
        load r21, r1
        imm r1, 525024
        load r22, r1
        call call_bounds_load_pair
        imm r1, 525056
        store r1, r0                    ; supplied explicit
        imm r1, 525064
        store r1, r7                    ; supplied hidden
        imm r1, 525032
        load r2, r1
        imm r3, 1
        jeq r2, r3, call_bounds_flag_expr
        imm r3, 2
        jeq r2, r3, call_bounds_flag_block
        imm r4, 10249888
        jmp call_bounds_flag_load
call_bounds_flag_expr:
        imm r4, 10248752
        jmp call_bounds_flag_load
call_bounds_flag_block:
        imm r4, 10249320
call_bounds_flag_load:
        imm r1, 525024
        load r2, r1
        imm r3, 8
        mul r2, r3
        add r2, r4
        load r3, r2
        imm r4, 1
        jeq r3, r4, call_bounds_check_live_proc
        ; Unreachable phase cells must be canonical zeroes.
        imm r1, 525056
        load r2, r1
        imm r3, 0
        jeq r2, r3, call_bounds_unreachable_hidden
        jmp reject
call_bounds_unreachable_hidden:
        imm r1, 525064
        load r2, r1
        jeq r2, r3, call_bounds_check_phase_proc_next
        jmp reject

call_bounds_check_live_proc:
        imm r1, 525024
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 525072
        store r1, r0                    ; frame bytes
        ; Start explicit descendant demand at this procedure's local peak.
        imm r1, 525024
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r1, 10043392
        add r1, r2
        load r3, r1
        imm r4, 8
        mul r3, r4
        imm r1, 525040
        store r1, r3
        ; An emit macro contributes one leaf hidden call and no explicit frame.
        imm r1, 10248192
        add r1, r2
        load r3, r1
        imm r1, 525048
        store r1, r3
        imm r10, 0
call_bounds_check_edges_loop:
        imm r1, 311
        jlt r10, r1, call_bounds_check_edge
        jmp call_bounds_check_expected
call_bounds_check_edge:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 10223616
        add r1, r2
        load r3, r1
        imm r1, 525024
        load r4, r1
        jeq r3, r4, call_bounds_check_matching_edge
        jmp call_bounds_check_edge_next
call_bounds_check_matching_edge:
        imm r1, 10231808
        add r1, r2
        load r22, r1                  ; callee
        imm r1, 10240000
        add r1, r2
        load r23, r1                  ; ambient words
        call call_bounds_child_pair
        ; r0/r7 are child's explicit/hidden summary.
        imm r1, 8
        mul r23, r1
        add r0, r23
        imm r1, 525040
        load r2, r1
        jlt r2, r0, call_bounds_update_child_explicit
        jmp call_bounds_compare_child_hidden
call_bounds_update_child_explicit:
        store r1, r0
call_bounds_compare_child_hidden:
        imm r1, 525048
        load r2, r1
        jlt r2, r7, call_bounds_update_child_hidden
        jmp call_bounds_check_edge_next
call_bounds_update_child_hidden:
        store r1, r7
call_bounds_check_edge_next:
        imm r1, 1
        add r10, r1
        jmp call_bounds_check_edges_loop

call_bounds_check_expected:
        imm r1, 525040
        load r2, r1
        imm r1, 525072
        load r3, r1
        add r2, r3                    ; current explicit frame
        imm r1, 525056
        load r4, r1
        jeq r2, r4, call_bounds_check_expected_hidden
        jmp reject
call_bounds_check_expected_hidden:
        imm r1, 525048
        load r2, r1
        imm r3, 1
        add r2, r3                    ; current incoming return
        imm r1, 525064
        load r4, r1
        jeq r2, r4, call_bounds_check_phase_proc_next
        jmp reject
call_bounds_check_phase_proc_next:
        imm r1, 525024
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        jmp call_bounds_check_phase_proc_loop

call_bounds_check_phase_row_done:
        imm r1, 525032
        load r2, r1
        imm r3, 3
        jeq r2, r3, call_bounds_check_profile
        imm r1, 525016
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        imm r1, 525032
        load r2, r1
        imm r3, 1
        jeq r2, r3, call_bounds_check_expr_depth
        jmp call_bounds_check_block_depth

; Return the child summary for callee r22 under the current phase/depth.
call_bounds_child_pair:
        imm r1, 524976
        load r2, r1
        jeq r22, r2, call_bounds_child_emit_dec
        imm r1, 524960
        load r2, r1
        jeq r22, r2, call_bounds_child_gen_expr
        imm r1, 524968
        load r2, r1
        jeq r22, r2, call_bounds_child_gen_stmts
        ; Ordinary same-phase child; closure must contain it.
        imm r1, 525032
        load r20, r1
        imm r1, 525016
        load r21, r1
        jmp call_bounds_load_pair
call_bounds_child_emit_dec:
        ; Nineteen signed-positive /10 activations, plus the independently
        ; reconstructed local peak in the deepest activation.
        imm r1, 524976
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 19
        mul r0, r1
        imm r1, 524976
        load r2, r1
        imm r3, 8
        mul r2, r3
        imm r3, 10043392
        add r3, r2
        load r2, r3
        imm r3, 8
        mul r2, r3
        add r0, r2
        imm r7, 19
        ret
call_bounds_child_gen_expr:
        imm r1, 525032
        load r2, r1
        imm r3, 1
        jeq r2, r3, call_bounds_child_expr_recursive
        imm r20, 1
        imm r21, 63
        jmp call_bounds_load_pair
call_bounds_child_expr_recursive:
        imm r1, 525016
        load r21, r1
        imm r2, 0
        jeq r21, r2, call_bounds_child_expr_probe
        imm r2, 1
        sub r21, r2
        imm r20, 1
        jmp call_bounds_load_pair
call_bounds_child_expr_probe:
        ; The rejected callee has allocated its 24-byte frame and the compiled
        ; `depth < 64` guard itself has one live comparison operand.
        imm r1, 524960
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 8
        add r0, r1
        imm r7, 1
        ret
call_bounds_child_gen_stmts:
        imm r1, 525032
        load r2, r1
        imm r3, 1
        jeq r2, r3, reject
        imm r3, 2
        jeq r2, r3, call_bounds_child_stmts_recursive
        imm r20, 2
        imm r21, 63
        jmp call_bounds_load_pair
call_bounds_child_stmts_recursive:
        imm r1, 525016
        load r21, r1
        imm r2, 0
        jeq r21, r2, call_bounds_child_stmts_probe
        imm r2, 1
        sub r21, r2
        imm r20, 2
        jmp call_bounds_load_pair
call_bounds_child_stmts_probe:
        ; Likewise: 16-byte frame plus the guard's one temporary word.
        imm r1, 524968
        load r20, r1
        call call_bounds_frame_bytes
        imm r1, 8
        add r0, r1
        imm r7, 1
        ret

; phase r20 (1 expr, 2 block, 3 root), depth r21, proc r22 -> r0/r7.
call_bounds_load_pair:
        mov r2, r22
        imm r1, 3
        jeq r20, r1, call_bounds_pair_root
        mov r3, r21
        imm r1, 71
        mul r3, r1
        add r2, r3
        imm r1, 8
        mul r2, r1
        imm r1, 1
        jeq r20, r1, call_bounds_pair_expr
        imm r3, 10124288
        imm r4, 10160640
        jmp call_bounds_pair_load
call_bounds_pair_expr:
        imm r3, 10051584
        imm r4, 10087936
        jmp call_bounds_pair_load
call_bounds_pair_root:
        imm r1, 8
        mul r2, r1
        imm r3, 10196992
        imm r4, 10197560
call_bounds_pair_load:
        add r3, r2
        load r0, r3
        add r4, r2
        load r7, r4
        ret

call_bounds_check_profile:
        imm r1, 524984
        load r22, r1
        imm r20, 3
        imm r21, 0
        call call_bounds_load_pair
        ; Explicit stack starts at 1 MiB and has 512 KiB reserved below it.
        imm r1, 524289
        jlt r0, r1, call_bounds_hidden_profile
        jmp reject
call_bounds_hidden_profile:
        imm r1, 8193
        jlt r7, r1, call_bounds_done
        jmp reject
call_bounds_done:
        jmp stack_register_custody_init

call_bounds_literal_gen_expr:
        db "gen_expr"
call_bounds_literal_gen_stmts:
        db "gen_stmts"
call_bounds_literal_emit_dec:
        db "emit_dec"

call_bounds_schema_emit_dec:
        db "proc emit_dec(n) {\n"
        db "    state big { to rec when (n >= 10)  to digit }\n"
        db "    state rec { emit_dec(n / 10)  to digit }\n"
        db "    state digit { write_byte(n % 10 + '0')  return 0 }\n"
        db "}\n"
call_bounds_schema_gen_expr:
        db "proc gen_expr() {\n"
        db "    let depth = word[2097080]\n"
        db "    state room { to enter when (depth < 64)  word[2097072] = 252  return 0 }\n"
        db "    state enter {\n"
        db "        word[2097080] = depth + 1\n"
        db "        to generate\n"
        db "    }\n"
        db "    state generate {\n"
        db "    gen_sum()\n"
        db "    skip_ws()\n"
        db "    let code = cmp_op()\n"
        db "        to do_cmp when (code >= 0)\n"
        db "        word[2097080] = word[2097080] - 1\n"
        db "        return 0\n"
        db "    }\n"
        db "    state do_cmp {\n"
        db "        emit_push()\n"
        db "        gen_sum()\n"
        db "        emit_cmp(code)\n"
        db "        word[2097080] = word[2097080] - 1\n"
        db "        return 0\n"
        db "    }\n"
        db "}\n"
call_bounds_schema_gen_stmts:
        db "proc gen_stmts() {               ; parse statements until '}', consume the '}'\n"
        db "    let depth = word[2097064]\n"
        db "    state room { to enter when (depth < 64)  word[2097072] = 252  return 0 }\n"
        db "    state enter {\n"
        db "        word[2097064] = depth + 1\n"
        db "        skip_ws()\n"
        db "        to loop\n"
        db "    }\n"
        db "    state loop {\n"
        db "        to exhausted when (word[2097072] != 0)\n"
        db "        to body when (cbyte() != '}')\n"
        db "        adv()\n"
        db "        word[2097064] = word[2097064] - 1\n"
        db "        return 0\n"
        db "    }\n"
        db "    state body {\n"
        db "        to eof when (cbyte() == 0)\n"
        db "        gen_item()\n"
        db "        skip_ws()\n"
        db "        to loop\n"
        db "    }\n"
        db "    state eof { word[2097064] = word[2097064] - 1  return 0 }\n"
        db "    state exhausted { word[2097064] = word[2097064] - 1  return 0 }\n"
        db "}\n"
